      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[sum:sessions_approved:qk]&quot;' value='Credit Granted' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[sum:sessions_kyc:qk]&quot;' value='KYC Uploaded' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[sum:sessions_proceeded:qk]&quot;' value='Credit Proceeded' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[sum:sessions_selected:qk]&quot;' value='Credit Selected' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[sum:sessions_simulated:qk]&quot;' value='Credit Simulated' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[sum:sessions_use_confirmed:qk]&quot;' value='Credit Use Confirmed' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[usr:Calculation_1369938756794679296:qk]&quot;' value='MCVR3' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[usr:MCR3 (copia)_1328280460425355264:qk]&quot;' value='MCVR1' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[usr:MCR3 (copia)_1328280460473057281:qk]&quot;' value='MCVR4' />
          <alias key='&quot;[federated.0k9ccn01ju31o8154d6o60swdj6f].[usr:MCR3 (copia)_1369938756799750145:qk]&quot;' value='MCVR2' />
        </aliases>
      </column>
      <column caption='CVR RUTs' datatype='real' name='[CVR Sessions (copia)_7175360174719168512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ruts_approved])/SUM([ruts_simulated])' />
      </column>
      <column caption='Adoption Rate' datatype='real' name='[Calculation_1024850436023693312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_approved])/SUM([offers])' />
      </column>
      <column caption='Tipo de fecha' datatype='date' datatype-customized='true' name='[Calculation_1024850436027019267]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parámetro 5] = &quot;Diario&quot; THEN&#13;&#10;    DATE([eventDate])&#13;&#10;ELSE&#13;&#10;    DATETRUNC(&apos;month&apos;,DATE([eventDate]))&#13;&#10;END)' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1328280460501762050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3]&#13;&#10;    WHEN &quot;client_segment&quot; THEN [client_segment]&#13;&#10;    WHEN &quot;country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;partner_aging&quot; THEN [partner_aging]&#13;&#10;    WHEN &quot;vertical&quot; THEN [vertical]&#13;&#10;    WHEN &quot;is_key_account&quot; THEN STR([is_key_account])&#13;&#10;    WHEN &quot;Source&quot; THEN [traffic_source]&#13;&#10;    WHEN &quot;Legacy Segment&quot; THEN [legacy_segment]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Argentina&quot;' value='AR' />
          <alias key='&quot;Chile&quot;' value='CL' />
          <alias key='&quot;Ecuador&quot;' value='EC' />
          <alias key='&quot;f&quot;' value='Flase' />
          <alias key='&quot;Perú&quot;' value='PE' />
          <alias key='&quot;República Dominicana&quot;' value='RD' />
          <alias key='&quot;t&quot;' value='True' />
        </aliases>
      </column>
      <column caption='Segmented Metric' datatype='real' name='[Calculation_1328280460506152963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 4]&#13;&#10;    WHEN &quot;sessions_simulated&quot; THEN sum([sessions_simulated])&#13;&#10;    WHEN &quot;sessions_selected&quot; THEN sum([sessions_selected])&#13;&#10;    WHEN &quot;sessions_proceeded&quot; THEN sum([sessions_proceeded])&#13;&#10;    WHEN &quot;Sessions_use_confirmed&quot; THEN sum([sessions_use_confirmed])&#13;&#10;    WHEN &quot;sessions_approved&quot; THEN sum([sessions_approved])&#13;&#10;    WHEN &quot;offers&quot; THEN sum([offers])&#13;&#10;    WHEN &quot;KYC&quot; THEN sum([sessions_kyc])&#13;&#10;    WHEN &quot;mCVR1&quot; THEN [MCR3 (copia)_1328280460425355264]*100&#13;&#10;    WHEN &quot;mCVR2&quot; THEN [MCR3 (copia)_1369938756799750145]*100&#13;&#10;    WHEN &quot;mCVR3&quot; THEN [Calculation_1369938756794679296]*100&#13;&#10;    WHEN &quot;mCVR4&quot; THEN [MCR3 (copia)_1328280460473057281]*100&#13;&#10;    WHEN &quot;CVR Sessions&quot; THEN [MCR4 (copia)_1584985639566249984]*100&#13;&#10;    WHEN &quot;ruts_approved&quot; THEN SUM([ruts_approved])&#13;&#10;    WHEN &quot;Adoption Rate&quot; THEN [Calculation_1024850436023693312]*100&#13;&#10;    WHEN &quot;Banner Seen&quot; THEN SUM([sessions_banner_seen])&#13;&#10;    WHEN &quot;Banner Clicked&quot; THEN SUM([sessions_banner_clicked])&#13;&#10;    WHEN &quot;Email Send&quot; THEN SUM([email_send])&#13;&#10;    WHEN &quot;Email Open&quot; THEN SUM([email_open])&#13;&#10;    WHEN &quot;Email Click&quot; THEN SUM([email_click])&#13;&#10;    WHEN &quot;Email OR&quot; THEN [Ruts_Email_Open_Rate (copia)_1688005438942101505]*100&#13;&#10;    WHEN &quot;Email CR&quot; THEN [Email_Open_Rate (copia)_1688005438943563778]*100&#13;&#10;    WHEN &quot;Banner CTR&quot; THEN [Calculation_1688005438944952323]*100&#13;&#10;    WHEN &quot;First Step Interaction Sessions&quot; THEN sum([sessions_interacted_first_step])&#13;&#10;    WHEN &quot;Amount Switched Sessions&quot; THEN sum([amount_switched])&#13;&#10;    WHEN &quot;Installment Selected Sessions&quot; THEN sum([installment_selected])&#13;&#10;    WHEN &quot;CVR ruts&quot; THEN [CVR Sessions (copia)_7175360174719168512]*100&#13;&#10;END' />
      </column>
      <column caption='MCR3' datatype='real' name='[Calculation_1369938756794679296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [country_name] WHEN &quot;Perú&quot; THEN [sessions_kyc] ELSE [sessions_use_confirmed] END)/SUM([sessions_proceeded])' />
      </column>
      <column caption='Error Margin' datatype='string' name='[Calculation_1584985639567609857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;5%&quot;' />
      </column>
      <column caption='Ruts_Email_Open_Rate' datatype='real' name='[Calculation_1688005438940614656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rut_email_open])/SUM([rut_email_send])' />
      </column>
      <column caption='Banner CTR' datatype='real' name='[Calculation_1688005438944952323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_banner_clicked])/SUM([sessions_banner_seen])' />
      </column>
      <column caption='Last date' datatype='date' name='[Calculation_1788210550473097216]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([eventDate])' />
      </column>
      <column caption='Ruts Email Openrate' datatype='real' name='[Calculation_1812417378952708100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rut_email_open])/Sum([rut_email_send])' />
      </column>
      <column caption='Rut Email Clickrate' datatype='real' name='[Calculation_1812417378952892421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([rut_email_click])/sum([rut_email_open])' />
      </column>
      <column caption='RUT Banner CTR' datatype='real' name='[Calculation_1812417378953551878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ruts_banner_clicked])/SUM([ruts_banner_seen])' />
      </column>
      <column caption='Open Rate Total' datatype='real' name='[Calculation_1812417378953932807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([email_open])/sum([email_send])' />
      </column>
      <column caption='Click Rate Total' datatype='real' name='[Calculation_1812417378954076168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([email_click])/sum([email_open])' />
      </column>
      <column caption='Banner ctr sessions' datatype='real' name='[Calculation_1812417378957860873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions_banner_clicked])/sum([sessions_banner_seen])' />
      </column>
      <column caption='Comm Metric' datatype='real' name='[Calculation_7175360174719905793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 8]&#13;&#10;    WHEN &quot;Banner Seen&quot; THEN SUM([sessions_banner_seen])&#13;&#10;    WHEN &quot;Banner Clicked&quot; THEN SUM([sessions_banner_clicked])&#13;&#10;    WHEN &quot;email_send_totals&quot; THEN SUM([email_send])&#13;&#10;    WHEN &quot;email_open_totals&quot; THEN SUM([email_open])&#13;&#10;    WHEN &quot;email_click_totals&quot; THEN SUM([email_click])&#13;&#10;    WHEN &quot;Ruts enviado&quot; THEN SUM([rut_email_send])&#13;&#10;    WHEN &quot;Ruts abierto&quot; THEN SUM([rut_email_open])&#13;&#10;    WHEN &quot;Ruts clicked&quot; THEN SUM([rut_email_click])&#13;&#10;    WHEN &quot;Email Open Rate&quot; THEN [Calculation_1812417378953932807]*100&#13;&#10;    WHEN &quot;Email Click Rate&quot; THEN [Calculation_1812417378954076168]*100&#13;&#10;    WHEN &quot;Open Rate Ruts&quot; THEN [Calculation_1812417378952708100]*100&#13;&#10;    WHEN &quot;Click Rate Ruts&quot; THEN [Calculation_1812417378952892421]*100&#13;&#10;    WHEN &quot;Rut Banner CTR&quot; THEN [Calculation_1812417378953551878]*100&#13;&#10;    WHEN &quot;Ruts simulated&quot; THEN sum([ruts_simulated])&#13;&#10;    WHEN &quot;Banner CTR Sessions&quot; THEN [Calculation_1812417378957860873]*100&#13;&#10;END' />
      </column>
      <column caption='Email_Click_Rate' datatype='real' name='[Email_Open_Rate (copia)_1688005438943563778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([email_click])/SUM([email_open])' />
      </column>
      <column caption='MCR1' datatype='real' name='[MCR3 (copia)_1328280460425355264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_selected])/SUM([sessions_simulated])' />
      </column>
      <column caption='MCR4' datatype='real' name='[MCR3 (copia)_1328280460473057281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_approved])/SUM([sessions_use_confirmed])' />
