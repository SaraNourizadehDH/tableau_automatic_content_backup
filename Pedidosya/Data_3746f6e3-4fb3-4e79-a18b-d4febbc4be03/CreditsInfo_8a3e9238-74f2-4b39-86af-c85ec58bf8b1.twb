  COALESCE(CASE WHEN months_at_peya <<= 12 THEN '0-12' WHEN months_at_peya <<= 36 THEN '13-36' WHEN months_at_peya <<= 42 THEN '37-42' WHEN months_at_peya >> 42 THEN '+42' END,hc.partner_aging) AS partner_aging,
  COALESCE(cr.vertical,hc.vertical) AS vertical,
  COALESCE(cr.is_ka,hc.is_ka) is_key_account,
  "Offer Count",
