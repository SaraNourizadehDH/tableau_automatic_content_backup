  cr.tax_id_number,

FROM `peya-datamarts-pro.dm_fintech.credits_analytical_segmentation` cr
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
  ON REPLACE(LTRIM(REPLACE(cr.tax_id_number , '0', ' ')),' ', '0')  = REPLACE(LTRIM(REPLACE(dp.billingInfo.rut , '0', ' ')),' ', '0') 
LEFT JOIN `peya-datamarts-pro.dm_fintech.partner_credits_segmentation_new` hc
    ON REPLACE(LTRIM(REPLACE(cr.tax_id_number , '0', ' ')),' ', '0') = REPLACE(LTRIM(REPLACE(hc.taxidnumber , '0', ' ')),' ', '0')
    AND DATE_TRUNC(DATE(cr.offer_date),MONTH) >>= hc.fecha
    AND DATE_TRUNC(DATE(cr.offer_date),MONTH) << hc.next_fecha
)
,business AS (
SELECT
    DISTINCT
    DATE_TRUNC(DATE(cr.offerDate),MONTH) fecha,
    --DATE_TRUNC(DATE(cr.requestDate),MONTH) fecha_solicitud,
    dc.country_code AS country_name,
    cr.loanid_offer loanid,
    cr.tax_id_number AS taxidnumber,
    cr.client_segment,
    cr.legacy_segment,
    cr.partner_aging,
    cr.vertical,
    cu.id AS credit_id,
    cu.offer_id AS credit_offer_id,
    cr.is_key_account AS is_ka,
    cr.paymenttype,
    CASE WHEN cu.endDate >> CURRENT_DATE THEN TRUE ELSE FALSE END is_active_credit,
    ou.annualNominalRate,
    ou.preapprovedcapital approvedcapital,
    ou.preapprovedcapital/dce.rate_eu approvedcapital_eu,
    IFNULL(cu.requestedCapital,0) requestedcapital,
    IFNULL(cu.requestedCapital,0)/dce.rate_eu requestedCapital_eu,

  FROM ofertas cr
  LEFT JOIN offers_backend_new ou 
    ON cr.loanid_offer = CAST(ou.id AS STRING)
  LEFT JOIN credits_backend_new cu 
    ON ou.id = cu.offer_id
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
   ON REPLACE(LTRIM(REPLACE(cr.tax_Id_Number , '0', ' ')),' ', '0')  = REPLACE(LTRIM(REPLACE(dp.billingInfo.rut , '0', ' ')),' ', '0') 
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
    ON cr.country_name = dc.country_name
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce
    ON dc.currency_id = dce.currency_id
    AND DATE_TRUNC(DATE(cr.offerDate),MONTH) = dce.currency_exchange_date
  WHERE TRUE
    --AND cr.country_name IN ("Argentina","Ecuador","Chile","República Dominicana","Perú") 
    AND DATE(cr.offerDate) >>= "2023-01-01"

)
SELECT
  fecha eventDate,
  country_name,
  client_segment,
  legacy_segment,
  IFNULL(partner_aging,"0-12") partner_aging,
  IFNULL(vertical,"Restaurant") vertical,
  IFNULL(is_ka,FALSE) is_key_account,
  "VP" traffic_source,
  paymenttype,
  COUNT(DISTINCT loanid) AS offers,
  COUNT(DISTINCT credit_id) AS credits,
  COUNT(DISTINCT CASE WHEN is_active_credit THEN loanid END) active_credits,
  SUM(COALESCE(approvedcapital_eu,0)) approved_capital_eu,
  SUM(COALESCE(requestedCapital_eu,0)) requested_capital_eu,
  SUM(COALESCE(approvedcapital,0)) approved_capital_lc,
  SUM(COALESCE(requestedCapital,0)) requested_capital_lc,
FROM business
GROUP BY 1,2,3,4,5,6,7,8,9]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
