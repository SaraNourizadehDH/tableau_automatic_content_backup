    <worksheet name='Riders Funnel'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='10'>&lt;</run>
            <run bold='true' fontalignment='1' fontsize='10'>[Parameters].[Parámetro 9]</run>
            <run bold='true' fontalignment='1' fontsize='10'>&gt; Timeline</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Riders Funnel' name='federated.11kqn5n0ccxt210zohbdz1js7q73' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Rider Metrica' datatype='string' name='[Parámetro 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Credits Granted&quot;'>
              <calculation class='tableau' formula='&quot;Credits Granted&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11kqn5n0ccxt210zohbdz1js7q73'>
            <column caption='Deposit Failed Rate' datatype='real' name='[Calculation_1390486411512152064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [status]&#13;&#10;    WHEN &quot;DEPOSIT_FAIL&quot; THEN [granted]&#13;&#10;    ELSE 0&#13;&#10;END) / SUM([granted])' />
            </column>
            <column caption='Adoption Rate %' datatype='real' name='[Calculation_955044619748302848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([granted])/SUM([offer_count])' />
            </column>
            <column caption='mcvr1' datatype='real' name='[Calculation_955044619751677953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([proceeded])/SUM([simulated])' />
            </column>
            <column caption='Metrica Riders' datatype='real' name='[Calculation_955044619752185858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 9] &#13;&#10;    WHEN &quot;Credits Granted&quot; THEN SUM([granted])&#13;&#10;    WHEN &quot;Offers&quot; THEN SUM([offer_count])&#13;&#10;    WHEN &quot;Sessions Simulated&quot; THEN SUM([simulated])&#13;&#10;    WHEN &quot;Sessions Proceeded&quot; THEN SUM([proceeded])&#13;&#10;    WHEN &quot;Adoption Rate %&quot; THEN [Calculation_955044619748302848]*100&#13;&#10;    WHEN &quot;mcvr1&quot; THEN [Calculation_955044619751677953]*100&#13;&#10;    WHEN &quot;CVR&quot; THEN [Calculation_955044619752706051]*100&#13;&#10;    WHEN &quot;Deposit Failed Rate %&quot; THEN [Calculation_1390486411512152064]*100&#13;&#10;    WHEN &quot;Regretted Rate %&quot; THEN [Deposit Failed Rate (copia)_1390486411513958401]*100&#13;&#10;END' />
            </column>
            <column caption='CVR Riders Sessions' datatype='real' name='[Calculation_955044619752706051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([granted])/SUM([simulated])' />
            </column>
            <column caption='Regretted Rate' datatype='real' name='[Deposit Failed Rate (copia)_1390486411513958401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [status]&#13;&#10;    WHEN &quot;REGRETTED&quot; THEN [granted]&#13;&#10;    ELSE 0&#13;&#10;END) / SUM([granted])' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[granted]' role='measure' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_month]' derivation='None' name='[none:date_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[product_type]' derivation='None' name='[none:product_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[offer_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[proceeded]' role='measure' type='quantitative' />
            <column datatype='string' name='[product_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[simulated]' role='measure' type='quantitative' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[date_month]' derivation='Month-Trunc' name='[tmn:date_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_955044619752185858]' derivation='User' name='[usr:Calculation_955044619752185858:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.11kqn5n0ccxt210zohbdz1js7q73].[none:country_name:nk]</column>
            <column>[federated.11kqn5n0ccxt210zohbdz1js7q73].[none:date_month:qk]</column>
