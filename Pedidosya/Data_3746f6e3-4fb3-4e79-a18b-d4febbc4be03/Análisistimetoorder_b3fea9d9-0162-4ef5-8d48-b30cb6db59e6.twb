            <column caption='Avg time home secs' datatype='real' name='[Avg time list secs (copia)_1076078862434660357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_time_home_secs])/SUM([qty_session_home])' />
