  COUNT(DISTINCT CASE WHEN joker_offered THEN session_sk END) AS joker_offered,
  --PERCENT_RANK() OVER(ORDER BY sum(sessions.time_to_order) desc) AS Percent_Rank_TimeDay
   
FROM base_table AS sessions
-- LEFT JOIN `peya-bi-tools-pro.il_growth.agg_user_lifecycle` user 
