      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_171C63B446984ADDBE05F4B2C53692AF'>
            <properties context=''>
              <relation connection='bigquery.0jy9v271r6laqb1etagpc0xxucvb' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dates AS (

    SELECT
        DATE("2023-01-01") AS from_date
        , CURRENT_DATE() AS to_date

),

credits AS (

SELECT 
    currency_code
    , country_name
    , partition_date
    , COUNT(DISTINCT cre_id) AS active_credits
    , SUM(debt_balance_amt) AS debt_balance_amt_lc
    , COUNT(DISTINCT CASE WHEN debt_balance_defaulted_amt >> 0 THEN cre_id END) AS defaulted_and_active_credits
    , SUM(debt_balance_defaulted_amt) AS debt_balance_defaulted_amt
    , SUM(days_past_due) AS sum_days_past_due_for_avg
FROM `peya-datamarts-pro.dm_fintech.partner_credits_portfolio_monthly`, dates 
WHERE partition_date BETWEEN from_date AND to_date
GROUP BY 1,2,3

),

first_credits AS (

SELECT
  clientid clientId,
  MIN(requestDate) first_credit

FROM `peya-data-origins-pro.cl_financial_services.credits`

WHERE is_deleted != TRUE

GROUP BY 1

),

main AS (
SELECT
  global_entity_id,
  LAST_DAY(DATE(startTime)) partition_date,
  node_id,
  Abandoned,
  CASE
    WHEN LOWER(node_id) LIKE "finance|credits|notaccredited|%" THEN "No acreditación de fondos" -- 2.1 en árbol
    WHEN LOWER(node_id) LIKE "finance|credits|instalmentsexpiration|%" THEN "Vencimiento de cuotas" -- 3.1 en árbol
    WHEN LOWER(node_id) LIKE "finance|credits|instalmentspayments|%" THEN "Pago cuotas" -- 3.3 en árbol
    WHEN LOWER(node_id) LIKE "finance|credits|paymentsissues|%" THEN "Cuota no se puede cobrar" -- 3.4 en árbol
    WHEN LOWER(node_id) LIKE "finance|credits|banktransferissues|%" THEN "Transferencia no reflejada" -- 4.1 en árbol
    ELSE "Others"
  END nodo,
  COUNT(DISTINCT caseid) cases
  

FROM `peya-data-origins-pro.cl_gcc_service.hc_events` hc, dates


LEFT JOIN `peya-data-origins-pro.cl_salesforce.livechat_transcript` AS ct
  ON chat_id = ct.ALAN_identifier

LEFT JOIN `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts` AS ict
  ON ct.CaseId=ict.case_id

LEFT JOIN `peya-data-origins-pro.cl_financial_services.clients` c
  ON ict.partner_id = c.partnerid

LEFT JOIN first_credits fc
  ON c.id = fc.clientId


WHERE TRUE
  AND hc.created_date BETWEEN from_date AND to_date
  AND DATE(CreatedDate) BETWEEN from_date AND to_date
  AND (LOWER(node_id) LIKE "%%finance|credits%%" AND LOWER(node_id) LIKE "%|chat")
  --AND UPPER(global_entity_id) LIKE "%AR%"
  AND (c.is_deleted != TRUE OR c.is_deleted IS NULL)
  AND first_credit IS NOT NULL
  AND DATE(first_credit) <<= DATE(startTime)


GROUP BY 1,2,3,4,5
    
)

SELECT 
    c.*,
    SUM(CASE WHEN nodo = "No acreditación de fondos" THEN cases END) AS cases_2_1,
    SUM(CASE WHEN nodo = "Vencimiento de cuotas" THEN cases END) AS cases_3_1,
    SUM(CASE WHEN nodo = "Pago cuotas" THEN cases END) AS cases_3_3,
    SUM(CASE WHEN nodo = "Cuota no se puede cobrar" THEN cases END) AS cases_3_4,
    SUM(CASE WHEN nodo = "Transferencia no reflejada" THEN cases END) AS cases_4_1,
    SUM(cases) AS total_cases,
    SAFE_DIVIDE(SUM(cases) , active_credits) AS ratio
FROM credits c
    LEFT JOIN main m
        ON m.partition_date = c.partition_date
        AND RIGHT(global_entity_id, 2) = c.currency_code
WHERE nodo != "Others"
GROUP BY 1,2,3,4,5,6,7,8]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
