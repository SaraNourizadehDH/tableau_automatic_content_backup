      <aliases enabled='yes' />
      <column caption='No acreditación de fondos' datatype='real' default-format='p0.00%' name='[Calculation_1536571942677344257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_2_1]) /  SUM([total_cases])' />
      </column>
      <column caption='Ratio' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1536571942723342342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(SUM([total_cases]) / SUM([active_credits]))' />
      </column>
      <column caption='other rate' datatype='integer' default-format='N' name='[Calculation_1536571942727041031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_cases])-SUM([cases_2_1]+[cases_3_1]+[cases_3_3]+[cases_3_4]+[cases_4_1]))' />
      </column>
      <column caption='Avg default days' datatype='real' name='[Calculation_1536571942743887880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_days_past_due_for_avg]) / SUM([defaulted_and_active_credits])' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_3_1]) / TOTAL(SUM([cases_3_1]))'>
          <table-calc ordering-field='[federated.1jakakx0o5vydf1gnwr4z0rsi1f0].[country_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_3_3]) / TOTAL(SUM([cases_3_3]))'>
