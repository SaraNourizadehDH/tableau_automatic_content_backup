      <column datatype='real' default-format='p0.00%' name='[Cálculo3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_3_4]) / TOTAL(SUM([cases_3_4]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo4]' role='measure' type='quantitative'>
