      <_.fcp.ObjectModelTableType.true...column caption='Consulta SQL personalizada' datatype='table' name='[__tableau_internal_object_id__].[_171C63B446984ADDBE05F4B2C53692AF]' role='measure' type='quantitative' />
      <column datatype='integer' name='[active_credits]' role='measure' type='quantitative' />
      <column caption='Vencimiento de cuotas' datatype='real' default-format='p0.00%' name='[cases 2.1 rate (copia)_1536571942677499906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_3_1]) /  SUM([total_cases])' />
      </column>
      <column caption='Pago cuota' datatype='real' default-format='p0.00%' name='[cases 3.1 rate (copia)_1536571942677565443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_3_3]) /  SUM([total_cases])' />
      </column>
      <column caption='Cuota no se puede cobrar' datatype='real' default-format='p0.00%' name='[cases 3.3 rate (copia)_1536571942677639172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_3_4]) /  SUM([total_cases])' />
      </column>
      <column caption='Transferencia no reflejada' datatype='real' default-format='p0.00%' name='[cases 3.4 rate (copia)_1536571942677688325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cases_4_1]) /  SUM([total_cases])' />
      </column>
      <column datatype='integer' name='[cases_4_1]' role='measure' type='quantitative' />
      <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='real' default-format='p0.00%' name='[ratio]' role='measure' type='quantitative' />
