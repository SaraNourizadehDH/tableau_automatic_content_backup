      <column caption='Owner' datatype='string' name='[Calculation_1305199504802721792]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [level_1] &#13;&#10;    WHEN &quot;CRM-RMO-Central&quot; THEN &quot;Marketing&quot;&#13;&#10;    WHEN &quot;CRM-RMA-Central&quot; THEN &quot;Marketing&quot;&#13;&#10;    WHEN &quot;RAF&quot; THEN &quot;Marketing&quot;&#13;&#10;    WHEN &quot;PLUS&quot; THEN &quot;Marketing&quot;&#13;&#10;    WHEN &quot;Others-Marketing&quot; THEN &quot;Marketing&quot;&#13;&#10;    WHEN &quot;Others-Central&quot; THEN &quot;Marketing&quot;&#13;&#10;    WHEN &quot;SORRY&quot; THEN &quot;Refunds and Comps&quot;&#13;&#10;    WHEN &quot;Corporate&quot; THEN &quot;Corporate and Partnerships&quot;&#13;&#10;    WHEN &quot;Partnerships&quot; THEN &quot;Corporate and Partnerships&quot;&#13;&#10;    WHEN &quot;HR-ModoAlmuerzo&quot; THEN &quot;Human Resources&quot;&#13;&#10;    WHEN &quot;HR-Centro de costos&quot; THEN &quot;Human Resources&quot;&#13;&#10;    WHEN &quot;HR-Other&quot; THEN &quot;Human Resources&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg spend EUasd' datatype='real' default-format='c&quot;€ &quot;#,##0.00;-&quot;€ &quot;#,##0.00' name='[Calculation_269371589935665152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([spend_eu]) / COUNTD([order_id])' />
