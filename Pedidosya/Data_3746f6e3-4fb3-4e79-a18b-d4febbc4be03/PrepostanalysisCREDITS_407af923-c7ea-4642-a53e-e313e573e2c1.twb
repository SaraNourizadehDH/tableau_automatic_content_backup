            <column caption='Segmento' datatype='string' name='[Calculation_1621014440630693892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1621014440631926790] &lt;= -0.50 THEN &quot;Caida muy fuerte&quot;&#13;&#10;ELSEIF [Calculation_1621014440631926790] &gt; -0.50 AND [Calculation_1621014440631926790] &lt;= -0.25 THEN &quot;Caida fuerte&quot;&#13;&#10;ELSEIF [Calculation_1621014440631926790] &gt; -0.25 AND [Calculation_1621014440631926790] &lt;= -0.10 THEN &quot;Caida moderada&quot;&#13;&#10;ELSEIF [Calculation_1621014440631926790] &gt; -0.10 AND [Calculation_1621014440631926790] &lt;= 0.10 THEN &quot;Moderados&quot;&#13;&#10;ELSEIF [Calculation_1621014440631926790] &gt; 0.10 AND [Calculation_1621014440631926790] &lt;= 0.25 THEN &quot;Subida moderada&quot;&#13;&#10;ELSEIF [Calculation_1621014440631926790] &gt; 0.25 AND [Calculation_1621014440631926790] &lt;= 0.50 THEN &quot;Subida fuerte&quot;&#13;&#10;ELSEIF [Calculation_1621014440631926790] &gt; 0.50 THEN &quot;Subida muy fuerte&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
            </column>
            <column caption='Delta' datatype='real' default-format='p0.00%' name='[Calculation_1621014440631926790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ABS((IFNULL([Calculation_1664924538105696256],0)/IFNULL([Post income (copia)_1664924538106040322],0.01))-1) &gt; 1 THEN 1&#13;&#10;       ELSE (IFNULL([Calculation_1664924538105696256],0)/IFNULL([Post income (copia)_1664924538106040322],0.01))-1 END' />
            </column>
            <column aggregation='Attribute' caption='country_ids' datatype='integer' name='[Calculation_1621014440635899913]' role='measure' type='quantitative'>
