      <aliases enabled='yes' />
      <column caption='Weekly post orders' datatype='real' name='[Calculation_1621014440642056203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[post_orders] / 12' />
      </column>
      <column caption='Weekly pre orders' datatype='real' name='[Calculation_1621014440642093068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pre_orders] / 12' />
      </column>
      <column caption='Delta' datatype='real' default-format='p0.00%' name='[Calculation_1621014440642166797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([post_orders]/[pre_orders])-1' />
      </column>
      <column caption='Segmento' datatype='string' name='[Calculation_1621014440642240527]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pre_orders] &gt;= [post_orders] THEN &quot;Bajó&quot;&#13;&#10;ELSEIF [pre_orders] &lt; [post_orders] THEN &quot;Subió&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Month' datatype='integer' name='[Calculation_1621014440642301968]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MONTH([createdAt])' />
      </column>
      <column caption='Share' datatype='real' default-format='p0%' name='[Calculation_1621014440642396177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])&#13;&#10;/&#13;&#10;MAX([Calculation_1621014440642469906])' />
      </column>
      <column caption='country_ids' datatype='integer' name='[Calculation_1621014440642469906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_name], [Calculation_1621014440642301968], YEAR([createdAt]) : COUNTD([id])}' />
      </column>
      <column caption='Signo' datatype='string' name='[Calculation_1621014440642551827]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1621014440642240527] = &quot;Bajó&quot; THEN &quot;▽&quot; &#13;&#10;ELSEIF [Calculation_1621014440642240527] = &quot;Subió&quot; THEN &quot;Δ&quot;&#13;&#10;END' />
      </column>
