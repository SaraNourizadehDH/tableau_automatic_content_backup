      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;República Oriental de Uruguay&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_46CCAB9E4042491EACF0B3F0D6CCBA2B'>
            <properties context=''>
              <relation connection='bigquery.1ral66c03agypd1agzuor0fu86xb' name='Consulta SQL personalizada' type='text'>WITH orders AS (&#13;
&#13;
    SELECT &#13;
        DATE_ADD(to_date, INTERVAL 1 DAY) AS week&#13;
        , rut&#13;
        , currency_code&#13;
        , net_income_amount&#13;
    FROM `peya-datamarts-pro.dm_fintech.rut_net_income_weekly`&#13;
    --WHERE currency_code = &quot;ARS&quot;&#13;
&#13;
)&#13;
&#13;
    SELECT &#13;
        currency_code&#13;
        , p.taxIdNumber&#13;
        , o.rut&#13;
        , c.createdAt&#13;
        , DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 7 DAY) billing_week&#13;
        , c.id &#13;
        , SUM(CASE WHEN week BETWEEN DATE_SUB(DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 7 DAY), INTERVAL 11 WEEK) AND DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 7 DAY) THEN net_income_amount END) AS pre_orders&#13;
        , COUNT(DISTINCT CASE WHEN week BETWEEN DATE_SUB(DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 7 DAY), INTERVAL 11 WEEK) AND DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 7 DAY) THEN week END) AS pre_weeks&#13;
        , SUM(DISTINCT CASE WHEN week BETWEEN DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 14 DAY) AND DATE_ADD(DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 7 DAY), INTERVAL 12 WEEK) THEN net_income_amount END) AS post_orders&#13;
        , COUNT(DISTINCT CASE WHEN week BETWEEN DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 14 DAY) AND DATE_ADD(DATE_ADD(DATE_TRUNC(DATE(c.createdAt), ISOWEEK), INTERVAL 7 DAY), INTERVAL 12 WEEK) THEN week END) AS post_weeks&#13;
    FROM `peya-data-origins-pro.cl_financial_services.credits` c&#13;
        LEFT JOIN `peya-data-origins-pro.cl_financial_services.clients` p&#13;
            ON p.id = c.clientId&#13;
        LEFT JOIN orders o&#13;
            ON p.taxIdNumber = o.rut&#13;
    WHERE c.is_deleted IS FALSE&#13;
        AND DATE(c.createdAt) BETWEEN &quot;2023-01-01&quot; AND &quot;2023-12-31&quot;&#13;
        --AND o.rut IS NULL&#13;
    GROUP BY 1,2,3,4,5,6</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
