      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='comentarios' id='_2FC294D6DFB04FD1A408C5B3DB940480'>
            <properties context=''>
              <relation connection='bigquery.19gi3e11m08k8g1c4hvqn01rm4x6' name='Consulta SQL personalizada' type='text'>WITH &#13;
dates AS (&#13;
  SELECT &#13;
    DATE(&apos;2023-05-01&apos;)   AS start_date,&#13;
    CURRENT_DATE()   AS end_date&#13;
)&#13;
&#13;
SELECT &#13;
  survey.resourceId,&#13;
  LOWER(responses_unnest.textResponse) AS comment,&#13;
  wordcloud.comment_flat,&#13;
  lemma.token,&#13;
  lemma.lema_string,&#13;
  CASE WHEN lemma.lema_string IS NULL THEN wordcloud.comment_flat ELSE lemma.lema_string END AS comentario&#13;
FROM `peya-data-origins-pro.cl_feedback.feedback_survey` AS survey&#13;
  , UNNEST(responses) AS responses_unnest&#13;
INNER JOIN `peya-markets.automated_tables_reports.prueba_wordcloud_v2` AS wordcloud&#13;
  ON survey.resourceId = wordcloud.resourceId&#13;
LEFT JOIN `peya-markets.automated_tables_reports.easy_to_order_toker_lemma` AS lemma&#13;
  ON wordcloud.comment_flat = lemma.token&#13;
WHERE surveyId = &apos;1c45d0d2-4fa2-41dc-a94b-9f6309457408&apos;&#13;
  AND DATE(createdAt) BETWEEN (SELECT start_date FROM dates) AND (SELECT end_date FROM dates)&#13;
  AND responses_unnest.textResponse is not null&#13;
  AND comment_flat NOT IN (&#13;
    select * from `peya-markets.user_guillermo_gadea.stop_words`&#13;
  )&#13;
GROUP BY 1,2,3,4,5,6</relation>
            </properties>
            <properties context='extract'>
              <relation name='_2FC294D6DFB04FD1A408C5B3DB940480' table='[Extract].[_2FC294D6DFB04FD1A408C5B3DB940480]' type='table' />
            </properties>
          </object>
          <object caption='easy_to_order_survey' id='easy_to_order_survey_0C162A94408A4D0083F2F3A158523F5D'>
            <properties context=''>
