      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_AFE2C384B340486EB83727591BD1690A'>
            <properties context=''>
              <relation connection='bigquery.18p2ckm0eico7q1a69n3g1vd4b92' name='Consulta SQL personalizada' type='text'>SELECT &#13;
  transaction_bool,&#13;
  platform,&#13;
  country_name,&#13;
  CASE WHEN time_home_secs IS NOT NULL THEN &apos;Home&apos; &#13;
    WHEN time_list_secs IS NOT NULL THEN &apos;List&apos; &#13;
    WHEN time_menu_secs IS NOT NULL THEN &apos;Menu&apos; &#13;
    WHEN time_checkout_secs IS NOT NULL THEN &apos;Checkout&apos; &#13;
  END as Funnel,&#13;
  SUM(search_use) AS search_use,&#13;
  SUM(time_home_secs) AS avg_time_home,&#13;
  SUM(time_list_secs) AS avg_time_list,&#13;
  SUM(time_menu_secs) AS avg_time_menu,&#13;
  SUM(time_checkout_secs) AS avg_time_checkout,&#13;
  COUNT(DISTINCT session_sk) AS sessions,&#13;
  SUM(session_with_transaction) AS sessions_with_tr&#13;
FROM `peya-markets.automated_tables_reports.sessions_time_to_order`&#13;
GROUP BY 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
