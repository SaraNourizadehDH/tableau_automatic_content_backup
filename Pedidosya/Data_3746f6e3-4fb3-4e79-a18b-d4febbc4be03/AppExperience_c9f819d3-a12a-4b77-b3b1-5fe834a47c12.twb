      <table>
        <view>
          <datasources>
            <datasource caption='easy_to_order_survey' name='federated.0e3u76h1aa7s8018fcmwr1d0v3ty' />
          </datasources>
          <datasource-dependencies datasource='federated.0e3u76h1aa7s8018fcmwr1d0v3ty'>
            <column caption='Vertical (copia)' datatype='string' name='[Business Type (copia)_1456351564806189071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[business_type_name]' />
            </column>
            <column caption='País' datatype='string' name='[Calculation_1134344190706843648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [pais]&#13;&#10;WHEN  &apos;AP_PA&apos; THEN &apos;Panamá&apos;&#13;&#10;WHEN  &apos;PY_AR&apos; THEN &apos;Argentina&apos;&#13;&#10;WHEN  &apos;PY_BO&apos; THEN &apos;Bolivia&apos;&#13;&#10;WHEN  &apos;PY_CL&apos; THEN &apos;Chile&apos;&#13;&#10;WHEN  &apos;PY_CR&apos;  THEN &apos;Costa Rica&apos;&#13;&#10;WHEN  &apos;PY_DO&apos; THEN &apos;República Dominicana&apos;&#13;&#10;WHEN  &apos;PY_EC&apos; THEN &apos;Ecuador&apos;&#13;&#10;WHEN  &apos;PY_GT&apos; THEN &apos;Guatemala&apos;&#13;&#10;WHEN  &apos;PY_HN&apos; THEN &apos;Honduras&apos;&#13;&#10;WHEN  &apos;PY_NI&apos; THEN &apos;Nicaragua&apos;&#13;&#10;WHEN  &apos;PY_PE&apos; THEN &apos;Perú&apos;&#13;&#10;WHEN  &apos;PY_PY&apos; THEN &apos;Paraguay&apos;&#13;&#10;WHEN  &apos;PY_SV&apos; THEN &apos;El Salvador&apos;&#13;&#10;WHEN  &apos;PY_UY&apos; THEN &apos;Uruguay&apos;&#13;&#10;WHEN  &apos;PY_VE&apos; THEN &apos;Venezuela&apos;&#13;&#10;END' />
            </column>
            <column caption='Color 1' datatype='string' name='[Calculation_1361494498615959552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Puntaje (copia)_644014781984067584] = 1&#13;&#10;THEN &apos;Muy difícil&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Color 2' datatype='string' name='[Color 1 (copia)_1361494498617470979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Puntaje (copia)_644014781984067584] = 2&#13;&#10;THEN &apos;2&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Color 3' datatype='string' name='[Color 1 y 2 (copia)_1361494498616295425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Puntaje (copia)_644014781984067584] = 3&#13;&#10;THEN &apos;3&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Color 4' datatype='string' name='[Color 3 (copia)_1361494498616348674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Puntaje (copia)_644014781984067584] = 4&#13;&#10;THEN &apos;4&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Color 5' datatype='string' name='[Color 3 (copia)_1361494498617704452]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Puntaje (copia)_644014781984067584] = 5&#13;&#10;THEN &apos;Muy fácil&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Valoración (grupo)' datatype='string' name='[Puntaje (copia) (grupo)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Puntaje (copia)_644014781984067584]' new-bin='true'>
                <bin default-name='true' value='&quot;1 y 2&quot;'>
                  <value>1</value>
                  <value>2</value>
                </bin>
                <bin default-name='true' value='&quot;4 y 5&quot;'>
                  <value>4</value>
                  <value>5</value>
                </bin>
              </calculation>
            </column>
            <column aggregation='CountD' caption='Valoración (copia)' datatype='integer' datatype-customized='true' name='[Puntaje (copia)_644014781984067584]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[answer]' />
              <aliases>
                <alias key='1' value='Muy difícil' />
                <alias key='5' value='Muy fácil' />
              </aliases>
            </column>
            <column aggregation='CountD' caption='Valoración' datatype='integer' datatype-customized='true' name='[answer]' role='measure' type='quantitative'>
              <aliases>
                <alias key='1' value='Muy difícil' />
                <alias key='5' value='Muy fácil' />
              </aliases>
            </column>
