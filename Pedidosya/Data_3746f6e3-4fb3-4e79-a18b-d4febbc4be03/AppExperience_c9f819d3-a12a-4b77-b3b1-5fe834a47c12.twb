      <column caption='Word Cloud' datatype='boolean' name='[Calculation_1031605827393970177]' role='measure' type='nominal'>
        <calculation class='tableau' formula='COUNT([comment_flat]) &gt;= [Parameters].[Parámetro 1]' />
