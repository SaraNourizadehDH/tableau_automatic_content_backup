          <calculation column='[Calculation_874824247948738563]' formula='IF     LOWER([component]) = &apos;swimlane&apos;       then count_clicked_unique_SL&#13;&#10;&#13;&#10;ELSEIF LOWER([component]) = &apos;past_orders&apos;    then count_clicked_unique_PO&#13;&#10;&#13;&#10;ELSEIF LOWER([component]) = &apos;banner&apos;         then count_clicked_unique_BAN&#13;&#10;&#13;&#10;ELSEIF LOWER([component]) = &apos;brand_shortcut&apos; then count_clicked_unique_BS&#13;&#10;&#13;&#10;//ELSEIF LOWER([Component]) = &apos;entry_points&apos;   then count_clicked_unique_entry_points  Aca no porque abro por EP &#13;&#10;&#13;&#10;ELSEIF LOWER([component]) = &apos;bottom_nav&apos;     then count_clicked_unique_bottom_nav &#13;&#10;&#13;&#10;ELSE   [count_clicked]&#13;&#10;END' />
