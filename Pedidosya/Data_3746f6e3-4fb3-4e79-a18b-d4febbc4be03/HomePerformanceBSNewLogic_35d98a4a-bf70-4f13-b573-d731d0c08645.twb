  <column aggregation='Sum' caption='count_shown_completo' datatype='integer' default-type='quantitative' name='[Calculation_455145053097029637]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='IF     LOWER([component]) = &apos;highlight_descuentos_fugaces&apos; AND  LOWER([jokerType]) = &apos;fugaces&apos; THEN  count_shown_joker_fugaces&\#13;&\#10;&\#13;&\#10;ELSEIF LOWER([component]) = &apos;swimlane&apos;     &\#9;&\#9;&\#9;&\#9;&\#9;&\#9;&\#9; then count_shown_unique_SL&\#13;&\#10;&\#13;&\#10;ELSEIF LOWER([component]) = &apos;past_orders&apos;    &\#9;&\#9;&\#9;&\#9;&\#9;&\#9;&\#9; then count_shown_unique_PO&\#13;&\#10;&\#13;&\#10;ELSEIF LOWER([component]) = &apos;banner&apos;         &\#9;&\#9;&\#9;&\#9;&\#9;                 then count_shown_unique_BAN&\#13;&\#10;&\#13;&\#10;ELSEIF LOWER([component]) = &apos;brand_shortcut&apos; &\#9;&\#9;&\#9;&\#9;&\#9;&\#9;&\#9; then count_shown_unique_BS&\#13;&\#10;&\#13;&\#10;// ELSEIF LOWER([Component]) = &apos;entry_points&apos;   &\#9;&\#9;&\#9;&\#9;&\#9;&\#9; then count_shown_unique_entry_points Aca no porque abro por EP &\#13;&\#10;&\#13;&\#10;ELSEIF LOWER([component]) = &apos;bottom_nav&apos;    &\#9;&\#9;&\#9;&\#9;&\#9;&\#9;&\#9; then count_shown_unique_bottom_nav &\#13;&\#10;&\#9;&\#9;&\#13;&\#10;ELSE   [count_shown] &\#13;&\#10;END' />
  </column>
  <column aggregation='Count' caption='Component Upper' datatype='string' default-type='nominal' name='[Calculation_455145053103427590]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='UPPER([component])' />
  </column>
  <column aggregation='User' caption='CVR Home Component' datatype='real' default-type='quantitative' name='[Calculation_721983329987100672]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM([num_attrib_transactions]) &\#13;&\#10;/ &\#13;&\#10;SUM([sessions_component_level])' />
  </column>
  <column aggregation='User' caption='Component CVR' datatype='real' default-type='quantitative' name='[Calculation_721983329987162113]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM([num_attrib_transactions]) / SUM([sum_last_clicked])' />
  </column>
  <column aggregation='User' caption='CTR Comp' datatype='real' default-type='quantitative' name='[Calculation_721983329987276802]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
