    <worksheet name='CTR'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#680000' fontsize='12'>&lt;Sheet Name&gt; |</run>
            <run bold='true' fontcolor='#680000'>Æ </run>
            <run fontcolor='#680000' fontsize='10'>Obtained as the ratio of total &apos;clicked&apos; events to total &apos;shown&apos; events for each component</run>
          </formatted-text>
        </title>
