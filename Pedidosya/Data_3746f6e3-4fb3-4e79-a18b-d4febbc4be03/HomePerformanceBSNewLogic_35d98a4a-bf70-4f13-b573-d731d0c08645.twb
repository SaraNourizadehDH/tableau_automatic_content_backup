      <table>
        <view>
          <datasources>
            <datasource caption='home_attribution_model BS NEW LOGIC' name='sqlproxy.161pisq07avlgx17s14wt01e14wp' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.161pisq07avlgx17s14wt01e14wp'>
            <column aggregation='User' caption='CTR Component' datatype='real' default-type='quantitative' layered='true' name='[CVR (copy)_736760803016536064]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([Calculation_691865512978554881]) &#13;&#10;/ &#13;&#10;sum([Calculation_455145053096136707])' />
            </column>
            <column aggregation='Count' caption='Component  ' datatype='string' default-type='nominal' layered='true' name='[Calculation_1047086923798315009]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF UPPER([component]) IN (&#13;&#10;                &apos;BUTCHERS&apos;&#13;&#10;                ,&apos;CHOCOLATES&apos;&#9;&#13;&#10;                ,&apos;COFFEE&apos;&#9;&#13;&#10;                ,&apos;COURIER&apos;&#9;&#13;&#10;                ,&apos;DESSERTS&apos;&#9;&#13;&#10;                ,&apos;DMART&apos;&#9;&#13;&#10;                ,&apos;DRINKS&apos;&#9;&#13;&#10;                ,&apos;GAS&apos;&#9;&#13;&#10;                ,&apos;GROCERIES&apos;&#9;&#13;&#10;                ,&apos;ICECREAM&apos;&#9;&#13;&#10;                ,&apos;KIOSKS&apos;&#9;&#13;&#10;                ,&apos;PETS&apos;&#9;&#13;&#10;                ,&apos;PHARMACY&apos;&#13;&#10;                ,&apos;PICKUP&apos;&#9;&#13;&#10;                ,&apos;RESTAURANT&apos;&#13;&#10;                )&#13;&#10;&#13;&#10;THEN &apos;entry_points&apos;&#13;&#10;&#13;&#10;ELSE [component] &#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='count_shown_completo' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_455145053096136707]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='IF     LOWER([Calculation_1047086923798315009]) = &apos;highlight_descuentos_fugaces&apos; AND  LOWER([jokerType]) = &apos;fugaces&apos; THEN  count_shown_joker_fugaces&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;swimlane&apos;     &#9;&#9;&#9;&#9;&#9;&#9;&#9; then count_shown_unique_SL&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;past_orders&apos;    &#9;&#9;&#9;&#9;&#9;&#9;&#9; then count_shown_unique_PO&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;banner&apos;         &#9;&#9;&#9;&#9;&#9;                 then count_shown_unique_BAN&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;brand_shortcut&apos; &#9;&#9;&#9;&#9;&#9;&#9;&#9; then count_shown_unique_BS&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;entry_points&apos;   &#9;&#9;&#9;&#9;&#9;&#9;&#9; then count_shown_unique_entry_points&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;bottom_nav&apos;    &#9;&#9;&#9;&#9;&#9;&#9;&#9; then count_shown_unique_bottom_nav &#13;&#10;&#9;&#9;&#13;&#10;ELSE   [count_shown] &#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Count Clicked Component' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_691865512978554881]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='IF     LOWER([Calculation_1047086923798315009]) = &apos;swimlane&apos;       then count_clicked_unique_SL&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;past_orders&apos;    then count_clicked_unique_PO&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;banner&apos;         then count_clicked_unique_BAN&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;brand_shortcut&apos; then count_clicked_unique_BS&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;entry_points&apos;   then count_clicked_unique_entry_points&#13;&#10;&#13;&#10;ELSEIF LOWER([Calculation_1047086923798315009]) = &apos;bottom_nav&apos;     then count_clicked_unique_bottom_nav &#13;&#10;&#13;&#10;ELSE   [count_clicked] &#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='Component Original' datatype='string' default-type='nominal' layered='true' name='[component]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
