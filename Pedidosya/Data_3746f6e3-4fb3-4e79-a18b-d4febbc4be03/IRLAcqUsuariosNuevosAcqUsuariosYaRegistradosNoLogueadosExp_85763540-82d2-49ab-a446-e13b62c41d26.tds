    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0s6tcms0cy4ip914zl8nb06vydo7' name='Consulta SQL personalizada' type='text'>#DECLARE start_date DATE DEFAULT         &apos;2023-08-01&apos;;													&#13;
#DECLARE experimento_inicio DATE DEFAULT &apos;2023-09-04&apos;;													&#13;
#DECLARE experimento_fin    DATE DEFAULT &apos;2023-09-21&apos;;		&#13;
&#13;
with clients_con_user as &#13;
(&#13;
              SELECT DISTINCT	user_id,													&#13;
                              client_id													&#13;
              FROM `peya-bi-tools-pro.il_sessions.fact_perseus_sessions` AS ps													&#13;
              WHERE partition_date BETWEEN &apos;2023-08-01&apos; AND &apos;2023-09-21&apos;	-- antes y durante el experimento 											&#13;
              AND user_id IS NOT NULL		-- que tenga user en algun momento antes o durante experimento (o sea registrado antes o durante experimento)&#13;
)&#13;
&#13;
,cant_clients_por_user as&#13;
(&#13;
        SELECT	user_id,													&#13;
                COUNT(DISTINCT client_id) AS qty_client_id													&#13;
												&#13;
        FROM clients_con_user			-- antes y durante el experimento 											&#13;
        GROUP BY 1	&#13;
)&#13;
&#13;
&#13;
,gente_no_logueada_experimento_unico_client_id as &#13;
(&#13;
SELECT DISTINCT			 c.abTestingVariation		&#13;
                    ,c.client_id		&#13;
                    ,a.user_id								&#13;
							      ,c.has_home_screen_loaded														&#13;
												&#13;
                    -- ,CASE WHEN obc.order_id IS NOT NULL THEN 1 ELSE 0 END AS is_acquisition&#13;
                    -- ,CASE WHEN obc.dh_uuid is not null then 1 else 0 end as is_acquisition_2 													&#13;
&#13;
FROM cant_clients_por_user AS a	                                     -- antes y durante el experimento gente que tiene usuario (registrada y no se si compró)&#13;
&#13;
LEFT JOIN `peya-bi-tools-pro.il_sessions.fact_perseus_sessions` AS b -- antes y durante el experimento &#13;
  ON  (a.user_id = b.user_id  -- es lo unico que tiene, client id en la de cant clients por user no tengo &#13;
      AND b.partition_date BETWEEN &apos;2023-08-01&apos; AND &apos;2023-09-21&apos;)											&#13;
&#13;
LEFT JOIN `peya-growth-and-onboarding.automated_tables_reports.irl_analysis_ios` AS c --  durante el experimento &#13;
  ON  (b.client_id	= c.client_id)												&#13;
&#13;
/*&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_peya_orders_by_customers` AS obc -- despues del experimento haya sido acquisition &#13;
  ON  (a.user_id = CAST(obc.user_id AS STRING) -- con el user id de antes y durante el experimento (o sea que estaba registrado antes o durante experimento)&#13;
      AND DATE(obc.registered_date) BETWEEN &apos;2023-09-04&apos; AND &apos;2023-09-21&apos; -- durante experimento &#13;
      AND obc.nro_order_confirmed = 1)	-- que haya sido acquisition durante del experimento (O SEA SE REGISTRÓ ANTES Y DURANTE, Y FUE ACQ DURANTE) &#13;
*/&#13;
&#13;
WHERE a.qty_client_id = 1     -- que el user tenga solo un client id antes y durante el experimento									&#13;
  AND c.client_id IS NOT NULL	-- que el client id no sea null 	             durante el experimento	(para tener la gente sólo del experimento)									&#13;
  AND c.user_id IS NULL			  -- que el user id sea null                     durante el experimento =&gt;&gt; QUE NO ESTÉ LOGUEADO EN EL EXPERIMENTO &#13;
ORDER BY 1,2	&#13;
)&#13;
&#13;
&#13;
&#13;
select DISTINCT			 a.abTestingVariation		&#13;
                    ,a.client_id		&#13;
                    ,a.user_id								&#13;
							      ,a.has_home_screen_loaded	&#13;
&#13;
                    ,CASE WHEN obc.order_id IS NOT NULL THEN 1 ELSE 0 END AS is_acquisition&#13;
                    ,CASE WHEN obc.dh_uuid  IS NOT NULL then 1 else 0 end as is_acquisition_2	&#13;
&#13;
from gente_no_logueada_experimento_unico_client_id a&#13;
&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_peya_orders_by_customers` AS obc -- en el experimento &#13;
  ON  (a.user_id = CAST(obc.user_id AS STRING) -- con el user id de antes y durante el experimento (o sea que estaba registrado antes o durante experimento)&#13;
      AND DATE(obc.registered_date) BETWEEN &apos;2023-09-04&apos; AND &apos;2023-09-21&apos; &#13;
      AND obc.nro_order_confirmed = 1)	-- que haya sido acquisition durante del experimento (O SEA SE REGISTRÓ ANTES O DURANTE, Y FUE ACQ DURANTE)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0s6tcms0cy4ip914zl8nb06vydo7' name='Consulta SQL personalizada' type='text'>#DECLARE start_date DATE DEFAULT         &apos;2023-08-01&apos;;													&#13;
