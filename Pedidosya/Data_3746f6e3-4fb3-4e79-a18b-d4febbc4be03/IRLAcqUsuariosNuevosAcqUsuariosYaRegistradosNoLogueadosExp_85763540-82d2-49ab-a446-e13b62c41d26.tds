&#13;
FROM cant_clients_por_user AS a	                                     -- antes y durante el experimento gente que tiene usuario (registrada y no se si compró)&#13;
&#13;
LEFT JOIN `peya-bi-tools-pro.il_sessions.fact_perseus_sessions` AS b -- antes y durante el experimento &#13;
  ON  (a.user_id = b.user_id  -- es lo unico que tiene, client id en la de cant clients por user no tengo &#13;
