&#13;
/*&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_peya_orders_by_customers` AS obc -- despues del experimento haya sido acquisition &#13;
  ON  (a.user_id = CAST(obc.user_id AS STRING) -- con el user id de antes y durante el experimento (o sea que estaba registrado antes o durante experimento)&#13;
      AND DATE(obc.registered_date) BETWEEN &apos;2023-09-04&apos; AND &apos;2023-09-21&apos; -- durante experimento &#13;
      AND obc.nro_order_confirmed = 1)	-- que haya sido acquisition durante del experimento (O SEA SE REGISTRÓ ANTES Y DURANTE, Y FUE ACQ DURANTE) &#13;
*/&#13;
&#13;
WHERE a.qty_client_id = 1     -- que el user tenga solo un client id antes y durante el experimento									&#13;
  AND c.client_id IS NOT NULL	-- que el client id no sea null 	             durante el experimento	(para tener la gente sólo del experimento)									&#13;
  AND c.user_id IS NULL			  -- que el user id sea null                     durante el experimento =&gt;&gt; QUE NO ESTÉ LOGUEADO EN EL EXPERIMENTO &#13;
ORDER BY 1,2	&#13;
)&#13;
&#13;
&#13;
&#13;
select DISTINCT			 a.abTestingVariation		&#13;
                    ,a.client_id		&#13;
                    ,a.user_id								&#13;
							      ,a.has_home_screen_loaded	&#13;
&#13;
                    ,CASE WHEN obc.order_id IS NOT NULL THEN 1 ELSE 0 END AS is_acquisition&#13;
                    ,CASE WHEN obc.dh_uuid  IS NOT NULL then 1 else 0 end as is_acquisition_2	&#13;
&#13;
from gente_no_logueada_experimento_unico_client_id a&#13;
&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_peya_orders_by_customers` AS obc -- en el experimento &#13;
  ON  (a.user_id = CAST(obc.user_id AS STRING) -- con el user id de antes y durante el experimento (o sea que estaba registrado antes o durante experimento)&#13;
      AND DATE(obc.registered_date) BETWEEN &apos;2023-09-04&apos; AND &apos;2023-09-21&apos; &#13;
      AND obc.nro_order_confirmed = 1)	-- que haya sido acquisition durante del experimento (O SEA SE REGISTRÓ ANTES O DURANTE, Y FUE ACQ DURANTE)</relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
