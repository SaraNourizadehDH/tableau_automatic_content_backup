      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Dominican Republic&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_715188C77AF84F4086F63B4E7234CE48'>
            <properties context=''>
              <relation connection='bigquery.1d4pnpu1jtozp01ddwvqd0ob6l3m' name='Custom SQL Query' type='text'>SELECT&#13;
&#13;
  month_date,&#13;
  country_id,&#13;
  country_name,&#13;
  city_id,&#13;
  city_name,&#13;
&#13;
  /* OVERALL */&#13;
  SAFE_DIVIDE(SUM(order_opportunity_num), SUM(order_opportunity_den)) AS order_opportunity_percent,&#13;
  SUM(acquisitions) AS acquisitions,&#13;
  SUM(active_customers) AS active_customers,&#13;
  SUM(active_partners_food) AS active_partners_food,&#13;
  SUM(active_partners_ls) AS active_partners_ls,&#13;
  SUM(active_riders) AS active_riders,&#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM(Delivery_Time), 60) , SUM(Delivery_Time_Base)) AS avg_delivery_time,&#13;
  --SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(PLUS_ORDERS)) AS cofunded_orders_share_plus,&#13;
  SUM(confirmed_orders) AS confirmed_orders,&#13;
  SAFE_DIVIDE(SUM(total_cost),SUM(confirmed_orders)) AS cpo,&#13;
  SAFE_DIVIDE(SUM(orders_total_sessions),SUM(sessions_total)) AS CVR,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders) , IF(month_date = DATE_TRUNC(CURRENT_DATE,MONTH),EXTRACT(DAY FROM CURRENT_DATE()) , EXTRACT(DAY FROM LAST_DAY(DATE(month_date))))) AS avg_daily_orders,&#13;
  SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(confirmed_orders + Non_Confirmed_Orders)) AS fail_rate,&#13;
  SAFE_DIVIDE(SUM(flgpo_non_courier), SUM(confirmed_orders_non_courier)) AS flgpo_non_courier,&#13;
  SAFE_DIVIDE(SUM(active_partners_ka_food),SUM(active_partners_food)) AS partners_food_ka_share,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders),SUM(active_customers)) AS frequency,&#13;
  SUM(confirmed_gmv_vendor_non_courier) AS gmv_gross_non_courier,&#13;
  SAFE_DIVIDE(SUM(gpo_non_courier), SUM(confirmed_orders_non_courier)) AS gpo_non_courier,&#13;
  SAFE_DIVIDE(SUM(active_partners_ls_aaa), SUM(active_partners_ls)) AS active_partners_ls_aaa_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(incentivized_orders) , SUM(confirmed_orders)) AS orders_w_incentives_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(active_partners_food_w_pickup),SUM(active_partners_food)) as pu_active_partners_food_share,&#13;
  &#13;
  SUM(partners_new) AS partners_new,&#13;
  SUM(qty_customers_first_order_groceries) AS new_qc_customers,&#13;
&#13;
  SAFE_DIVIDE((SUM(nps_promoters)-SUM(nps_detractor)),SUM(nps_detractor+nps_passive+nps_promoters) )AS relational_nps,&#13;
  SAFE_DIVIDE(SUM (open_time_food),SUM(open_time_food_den)) as open_time_food,  &#13;
  SAFE_DIVIDE(SUM (open_time_non_food),SUM(open_time_non_food_den)) as open_time_non_food,  &#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM (open_time_food),SUM(open_time_food_den)),SAFE_DIVIDE(SUM (open_time_non_food),SUM(open_time_non_food_den))) open_time_food_vs_non_food,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM (confirmed_orders_dmart),SUM(confirmed_orders)) as order_dmart_share,  &#13;
  SAFE_DIVIDE(SUM (confirmed_orders_ls),SUM(confirmed_orders)) as order_ls_share,  &#13;
&#13;
  --SUM(NET_USERS) AS net_users_plus, &#13;
  --SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_order_share, &#13;
  SAFE_DIVIDE(SUM(confirmed_orders_food_pickup),SUM(confirmed_orders_food)) AS pu_orders_share_food,&#13;
  SUM(active_partners_QC) AS active_partners_QC,&#13;
  SUM(confirmed_orders_QC) AS orders_qc,&#13;
  --SAFE_DIVIDE(SUM(retention_overall_m1) , SUM(Active_Customers_Overall_M1)) AS retention_m1,&#13;
  SAFE_DIVIDE(SUM(qty_orders_sessions), SUM(total_orders_logistic_seamless)) AS session_rate_overall,&#13;
  SUM(sessions_total) as sessions,&#13;
  SAFE_DIVIDE(SUM(takein_non_courier), SUM(confirmed_orders_non_courier)) AS takein_non_courier,&#13;
&#13;
  /* PLUS */&#13;
  -- SAFE_DIVIDE(SUM(TOTAL_ACTIVE_PARTERNS_PLUS),SUM(TOTAL_PARTNERS)) AS plus_partners_coverage, &#13;
  -- SUM(ADOPTION) AS plus_adoption, &#13;
  -- SAFE_DIVIDE(SUM(ADOPTION),SUM(ACTIVE_USERS)) AS plus_adoption_percent, &#13;
  -- SUM(CHURN) as plus_churn, &#13;
  -- SAFE_DIVIDE(SUM(CHURN),SUM(SUBSCRIBED)) AS plus_churn_percent, &#13;
  -- SAFE_DIVIDE(SUM(CHURN_USER),SUM(SUBSCRIBED)) AS plus_churn_by_user_percent, &#13;
  -- SAFE_DIVIDE(SUM(CHURN_NOT_BB),SUM(SUBSCRIBED)) AS plus_churn_not_billable_percent, &#13;
  -- SAFE_DIVIDE(SUM(COBERTURA_DF), SUM(DISCOUNT_AMOUNT_EUR_LISTING_DF)) as df_paid_by_partner_percent,&#13;
  -- 0 AS flgpo_delta_vs_non_plus,&#13;
  -- 0 AS flgpo_plus,&#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(PLUS_USERS)) AS plus_frequency, &#13;
  -- SAFE_DIVIDE(&#13;
  --   (SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(PLUS_USERS))),&#13;
  --   (SAFE_DIVIDE(SUM(ORDERS - PLUS_ORDERS), SUM(ACTIVE_USERS-PLUS_USERS)))&#13;
  -- )-1 AS plus_frequency_gap, &#13;
  -- SUM(NET_USERS) AS plus_net_users, &#13;
  -- SAFE_DIVIDE(SUM(NET_USERS),SUM(ACTIVE_USERS)) AS plus_net_users_percent, &#13;
  -- SAFE_DIVIDE(SUM(COBERTURA_ORDENES),SUM(ORDERS)) AS order_coverage,&#13;
  -- SUM(PLUS_ORDERS) AS plus_orders, &#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_orders_share, &#13;
  -- SAFE_DIVIDE(SUM(PROD_SUBS_ORDERS),SUM(PLUS_ORDERS_FOOD))  AS orders_plus_food_deals_penetration, &#13;
  -- SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(COFUNDABLE_ORDERS)) AS plus_paying_orders, &#13;
  -- SAFE_DIVIDE(SUM(PS_PLUS_PARTNER_AMOUNT), SUM(PS_PLUS_AMOUNT)) as vfd_over_discount_amount_plus, &#13;
&#13;
  /* CHOICE */&#13;
  -- SAFE_DIVIDE(SUM(activation_m0),SUM(activation_bases_online)) AS activation_rate,&#13;
  -- SAFE_DIVIDE(SUM(activation_m0_field),SUM(activation_bases_online_field)) activation_rate_field,&#13;
  -- SAFE_DIVIDE(SUM(activation_m0_ssu),SUM(activation_bases_online_ssu)) activation_rate_ssu,&#13;
&#13;
  SAFE_DIVIDE(SUM(active_partners_food),SUM(qty_active_partners)) AS active_partners_food_share,&#13;
  SAFE_DIVIDE(SUM(active_partners_ls),SUM(qty_active_partners)) AS active_partners_ls_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(ads_partners) , SUM(active_partners_tr_food)) AS  ads_part_penetration_percent,&#13;
  SAFE_DIVIDE(SUM(ads_eur),SUM(gmv_eur)) AS ads_over_gmv_percent,&#13;
&#13;
  SAFE_DIVIDE(SUM(total_commission_food_existing) , SUM(gfv_vendor_food_existing)) AS  commission_rate_food_existing,&#13;
  SAFE_DIVIDE(SUM(total_commission_food_new) , SUM(gfv_vendor_food_new)) AS  commission_rate_food_new,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls_existing) , SUM(gfv_vendor_ls_existing)) AS  commission_rate_ls_existing,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls_new) , SUM(gfv_vendor_ls_new)) AS  commission_rate_ls_new,&#13;
  SAFE_DIVIDE(SUM(total_commission) , SUM(gfv_vendor)) AS  commission_rate_overall,&#13;
&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_ka_food), SUM(confirmed_orders_food)) AS key_account_food_orders_percent,&#13;
  SAFE_DIVIDE(SUM(Partners_0_30_Orders_Food) , SUM(Partners_0_30_Orders_Food +Partners_0_Orders_Food+Partners_Plus30_Orders_Food)) AS low_orders_partners_food_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR1),SUM(sessions_home)) AS mCVR1,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR2),SUM(sessions_shop_list)) AS mCVR2,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR3),SUM(sessions_shop_details)) AS mCVR3,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR4),SUM(sessions_checkout)) AS mCVR4,&#13;
&#13;
&#13;
  SUM(partners_new_active_food) AS partners_new_active_food,&#13;
  SAFE_DIVIDE(SUM(partners_new_food), SUM(partners_new_non_food)) AS new_partners_food_vs_non_food,&#13;
&#13;
  -- SAFE_DIVIDE((SUM(Nps_Partners_Existing_Ao_Promoter) - SUM(Nps_Partners_Existing_Ao_Detractor)) , (SUM(Nps_Partners_Existing_Ao_Detractor) + SUM(Nps_Partners_Existing_Ao_Passive) + SUM(Nps_Partners_Existing_Ao_Promoter)) )* 100 AS nps_partners_existing,&#13;
&#13;
  -- SUM(gmv_preferent_eu_num)/ SUM(gmv_preferent_eu_den) AS gmv_preferent_eu_share,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_Total) , SUM(Seller_Head_Count_Total)) as productivity_overall,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_Field) , SUM(Seller_Head_Count_Field)) AS productivity_field,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_SSU) , SUM(Seller_Head_Count_SSU)) AS productivity_ssu,&#13;
  SAFE_DIVIDE(SUM(gmv_founded_partners_food) , SUM(confirmed_gmv_vendor_food)) AS vfd_over_gmv_percent,&#13;
&#13;
  SUM(partners_win_back_food) AS win_back_partners_food,&#13;
  SAFE_DIVIDE(SUM(Partners_0_Orders_Food) , SUM(Partners_0_30_Orders_Food +Partners_0_Orders_Food+Partners_Plus30_Orders_Food)) AS zombies_partners_food_share,&#13;
&#13;
  /* Q-commerce */&#13;
  SAFE_DIVIDE(SUM(active_customers_dmart), SUM(active_customers)) AS active_customers_share_dmart,&#13;
  SAFE_DIVIDE(SUM(active_customers_ls), SUM(active_customers)) AS active_customers_share_ls,&#13;
  SAFE_DIVIDE(SUM(active_customers_qc), SUM(active_customers)) AS active_customers_share_qc,&#13;
  --SUM(active_customers) AS active_customers,&#13;
  SUM(active_customers_dmart) AS active_customers_dmart,&#13;
  SUM(active_customers_ls) AS active_customers_ls,&#13;
  SUM(active_customers_qc) as active_customers_qc,&#13;
  SUM(active_partners_QC) AS active_partner_QC,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_dmart) , SUM(confirmed_orders_dmart)) AS  afv_vendor_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_aaa),SUM(confirmed_orders_aaa))AS basket_size_aaa,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_dmart),SUM(confirmed_orders_dmart))AS basket_size_dmars,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_non_aaa),SUM(confirmed_orders_non_aaa))AS basket_size_non_aaa,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_qc),SUM(confirmed_orders_qc))AS basket_size_qc,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM(active_customers_qc),SUM(active_customers)) as customer_penetration_qc,&#13;
&#13;
  SAFE_DIVIDE(SUM(unique_orders_qc),SUM(sessions_qc))AS cvr3_qc,&#13;
  SAFE_DIVIDE(SUM(unique_orders_aaa),SUM(Sessions_aaa))AS cvr3_aaa,&#13;
  SAFE_DIVIDE(SUM(unique_orders_dmart),SUM(Sessions_dmart))AS cvr3_dmart,&#13;
  SAFE_DIVIDE(SUM(unique_orders_non_aaa),SUM(Sessions_non_aaa))AS cvr3_non_aaa,&#13;
&#13;
  SUM(confirmed_orders_dmart) AS confirmed_orders_dmarts,&#13;
  --SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(confirmed_orders + Non_Confirmed_Orders)) AS fail_rate,&#13;
&#13;
  SAFE_DIVIDE((SUM(non_confirmed_orders_dmart) + SUM(non_confirmed_orders_ls)) ,(SUM(total_orders_dmart) + SUM(total_orders_ls))) as fail_rate_qc,&#13;
  SAFE_DIVIDE(SUM(qty_non_confirmed_orders_aaa) , SUM(total_orders_aaa)) as fail_rate_aaa,&#13;
&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_cash_ls) , SUM(total_orders_ls)) as fail_rate_cash_ls,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_online_pay_ls) , SUM(total_orders_ls)) as fail_rate_online_pay_ls,&#13;
  SAFE_DIVIDE(SUM(qty_non_confirmed_orders_non_aaa) , SUM(total_orders_non_aaa)) as fail_rate_non_aaa,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_dmart) , SUM(total_orders_dmart)) as fail_rate_dmart,&#13;
&#13;
  SUM(qty_customers_first_order_groceries) AS qty_customers_first_order_groceries,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_qc),SUM(active_customers_qc)) AS frequency_qc,&#13;
&#13;
  SUM(confirmed_gmv_vendor_aaa) as gmv_aaa,&#13;
  SUM(gmv_vendor_dmarts) as gmv_dmart,&#13;
  SUM(confirmed_gmv_vendor_ls) as gmv_ls,&#13;
  SUM(confirmed_gmv_vendor_non_aaa) as gmv_non_aaa,&#13;
  SUM(Confirmed_Gmv_vendor_Qc) AS gmv_qc,&#13;
&#13;
  SAFE_DIVIDE(SUM(gmv_vendor_dmarts),SUM(confirmed_gmv_vendor_non_courier)) AS gmv_vendor_dmarts_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(gpo_qc), SUM(confirmed_orders_qc)) as gpo_qc,&#13;
  SAFE_DIVIDE(SUM(gpo_aaa),SUM(confirmed_orders_aaa)) AS gpo_aaa,&#13;
  SAFE_DIVIDE(SUM(gpo_dmart), SUM(confirmed_orders_dmart)) as gpo_dmart,&#13;
  SAFE_DIVIDE(SUM(gpo_non_aaa),SUM(confirmed_orders_non_aaa)) AS gpo_non_aaa,&#13;
&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_qc) , SUM(confirmed_orders_qc)) as inaccuracy_qc,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_aaa) , SUM(confirmed_orders_aaa)) as inaccuracy_aaa,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_non_aaa) , SUM(confirmed_orders_non_aaa)) as inaccuracy_non_aaa,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_dmart) , SUM(confirmed_orders_dmart)) as inaccuracy_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_ls), SUM(total_orders_ls)) AS fail_rate_vendor_ls,&#13;
&#13;
  SUM(confirmed_orders_ls) AS confirmed_orders_ls,&#13;
  --SAFE_DIVIDE(SUM (confirmed_orders_dmart),SUM(confirmed_orders)) as order_dmart_share,  &#13;
  --SAFE_DIVIDE(SUM (confirmed_orders_ls),SUM(confirmed_orders)) as order_ls_share,  &#13;
  SAFE_DIVIDE(SUM (confirmed_orders_QC),SUM(confirmed_orders)) as order_qc_share,&#13;
  SUM(confirmed_orders_QC) as confirmed_orders_QC,&#13;
  SUM(qty_trials) AS trials,&#13;
&#13;
  /* Other commitments  */&#13;
  SUM(confirmed_orders_courier_b2c) AS confirmed_orders_courier_b2c,&#13;
  SUM(confirmed_orders_courier_c2c) AS confirmed_orders_courier_c2c,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_courier), SUM(confirmed_orders)) AS confirmed_orders_courier_share,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_food_pickup),SUM(confirmed_orders_food)) AS pickup_orders_share_food,&#13;
  SUM(confirmed_orders_food_pickup) AS confirmed_orders_pickup,&#13;
  --SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(PLUS_ORDERS)) AS cofunded_orders_share_plus,&#13;
  --SUM(NET_USERS) AS plus_net_users, &#13;
  --SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_orders_share,&#13;
  --SUM(PLUS_ORDERS) AS plus_orders, &#13;
  --SAFE_DIVIDE(SUM(TOTAL_ACTIVE_PARTERNS_PLUS),SUM(TOTAL_PARTNERS)) AS plus_partners_coverage,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_qc), SUM(total_orders_qc)) AS fail_rate_vendor_qc,&#13;
  --SAFE_DIVIDE(SUM(active_partners_food_w_pickup),SUM(active_partners_food)) as pu_active_partners_food_share,&#13;
&#13;
  /* OPS */&#13;
&#13;
  SAFE_DIVIDE(SUM(cant_orders_with_delivery_time_45),SUM(completed_orders)) AS orders_with_delivery_time_45_share,&#13;
  SAFE_DIVIDE(SUM(cant_orders_with_delivery_time_60),SUM(completed_orders)) AS orders_with_delivery_time_60_share,&#13;
  --SAFE_DIVIDE(SAFE_DIVIDE(SUM(Delivery_Time), 60) , SUM(Delivery_Time_Base)) AS Avg_Delivery_Time,&#13;
  -- SAFE_DIVIDE(SUM(num_contacts_created), SUM(total_orders)) AS contact_rate_user,&#13;
  --SAFE_DIVIDE(SUM(total_cost),SUM(confirmed_orders)) AS cpo,&#13;
  -- SAFE_DIVIDE(SUM(sat_ssf), SUM(resp_ssf)) AS csat_overall_hc_and_ac,&#13;
  SAFE_DIVIDE(SUM(trx_CVR3), SUM(sessions_shop_details)) AS CVR3,&#13;
  SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(total_orders)) AS fail_rate_overall,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_cash_food), SUM(total_orders_food)) AS fail_rate_cash_food,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_online_pay_food), SUM(total_orders_food)) AS fail_rate_online_payment_food,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_food), SUM(total_orders_food)) AS fail_rate_vendor_food,&#13;
  --SAFE_DIVIDE((SUM(Nps_Partners_Existing_Ao_Promoter) - SUM(Nps_Partners_Existing_Ao_Detractor)) , (SUM(Nps_Partners_Existing_Ao_Detractor) + SUM(Nps_Partners_Existing_Ao_Passive) + SUM(Nps_Partners_Existing_Ao_Promoter)) )* 100 AS nps_partners_existing,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_online_payment), SUM(confirmed_orders)) AS online_payment_share,&#13;
  SAFE_DIVIDE(SUM (open_time),SUM(open_time_den)) as open_time,  &#13;
  --SAFE_DIVIDE(SUM(order_opportunity_num), SUM(order_opportunity_den)) AS order_opportunity_percent,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_peya_fail), SUM(total_orders)) AS fail_rate_peya_owner,&#13;
  -- SAFE_DIVIDE(SUM(resolution_rate_num),SUM(resolution_rate_den)) AS resolution_rate,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_rider_fail), SUM(total_orders)) AS fail_rate_rider_owner,&#13;
  SAFE_DIVIDE(SUM(Confirmed_Orders_1_Payment_No_Contact_Not_Delayed), SUM(total_orders_logistic_seamless)) AS Seamless_orders_percent,&#13;
  SAFE_DIVIDE(SUM(orders_total_sessions), SUM(total_orders)) AS session_rate_ops,&#13;
  SAFE_DIVIDE(SUM(stacked_deliveries), SUM(completed_orders)) AS stacking_percent,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_user_fail), SUM(total_orders)) AS fail_rate_user_owner,&#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM(completed_orders), SUM(sum_actual_evaluated_working_hours)),3600) AS utr,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor), SUM(total_orders)) AS fail_rate_online_vendor,&#13;
  SAFE_DIVIDE(SUM(VL_10_numerator), SUM(VL_10_denominator)) AS vendor_late_10,&#13;
  SAFE_DIVIDE(SUM(order_late_10), SUM(order_late_base)) AS order_late_10,&#13;
&#13;
&#13;
  /* Ensure Clear Leadership */&#13;
&#13;
  SAFE_DIVIDE(SUM(incentivized_orders) , SUM(confirmed_orders)) AS incentivized_orders_share,&#13;
  SAFE_DIVIDE(SUM(incentivized_acquisitions) , SUM(acquisitions)) AS incentivized_acquisitions_share,&#13;
&#13;
  /* Profitability */&#13;
&#13;
  SUM(amount_w_df_incentive) AS amount_w_df_incentives,&#13;
  SUM(amount_crm_incentives) AS orders_crm_incentives,&#13;
  SUM(df_listing)/SUM(confirmed_orders_listing) AS delivery_fee_incentives,&#13;
&#13;
  ((SUM(CASE WHEN 1 = 1 THEN df_food_Listing END) / SUM(CASE WHEN 1 = 1 THEN confirmed_orders_food_listing END)) / &#13;
    (SUM(CASE WHEN 1 = 1 THEN GFV_gross_food_listing END) / SUM(CASE WHEN 1 = 1 THEN confirmed_orders_food_listing END)))&#13;
    +&#13;
    (SUM(CASE WHEN 1 = 1 THEN sf_food_Listing END) / SUM(CASE WHEN 1 = 1 THEN GFV_gross_food_listing END)) AS food_uc_over_afv,&#13;
&#13;
  SUM(amount_with_free_delivery_peya_funded) AS amount_with_free_df_peya_funded,&#13;
  SUM(amount_promotional_delivery_fee_peya_funded) AS amount_promotional_df_peya_funded,&#13;
  SAFE_DIVIDE(SUM(orders_with_free_delivery_peya_funded) , SUM(total_orders_non_courier)) AS share_orders_free_df_peya_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_promotional_delivery_fee_peya_funded) , SUM(total_orders_non_courier)) AS share_orders_promotional_df_peya_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_vendor_funded) , SUM(total_orders_non_courier)) AS share_orders_df_incentives_vendor_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_w_df_incentive) , SUM(total_orders_non_courier)) AS share_orders_w_df_incentives,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_dmart) , SUM(confirmed_orders_logistics_dmart)) AS  delivery_cpo_dmart,&#13;
  --SAFE_DIVIDE(SUM(gfv_vendor_dmart) , SUM(confirmed_orders_dmart)) AS  afv_vendor_dmart,&#13;
  SAFE_DIVIDE(SUM(total_commission_dmart) , SUM(gfv_vendor_dmart)) AS  commission_rate_dmart,&#13;
  --SAFE_DIVIDE(SUM(gpo_dmart),SUM(confirmed_orders_dmart)) AS gpo_dmart,&#13;
  SAFE_DIVIDE(SUM(flgpo_dmart),SUM(confirmed_orders_dmart)) AS flgpo_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_food) , SUM(confirmed_orders_logistics_food)) AS  delivery_cpo_food,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_food) , SUM(confirmed_orders_food)) AS  afv_vendor_food,&#13;
  SAFE_DIVIDE(SUM(total_commission_food) , SUM(gfv_vendor_food)) AS  commission_rate_food,&#13;
  SAFE_DIVIDE(SUM(gpo_food),SUM(confirmed_orders_food)) AS gpo_food,&#13;
  SAFE_DIVIDE(SUM(flgpo_food),SUM(confirmed_orders_food)) AS flgpo_food,&#13;
  SAFE_DIVIDE(SUM(takein_food),SUM(confirmed_orders_food)) AS takein_food,&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_ls) , SUM(confirmed_orders_logistics_ls)) AS  delivery_cpo_ls,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_ls) , SUM(confirmed_orders_ls)) AS  afv_vendor_ls,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls) , SUM(gfv_vendor_ls)) AS  commission_rate_ls,&#13;
  SAFE_DIVIDE(SUM(gpo_ls),SUM(confirmed_orders_ls)) AS gpo_ls,&#13;
  SAFE_DIVIDE(SUM(flgpo_ls),SUM(confirmed_orders_ls)) AS flgpo_ls,&#13;
  SAFE_DIVIDE(SUM(takein_ls),SUM(confirmed_orders_ls)) AS takein_ls,&#13;
  &#13;
FROM `peya-markets.automated_tables_reports.data_monthly_360_by_city`&#13;
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='data 360 daily by city' inline='true' name='federated.0yv7hi11cralx41efut6g0jhtyr1 (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1d4pnpu1jtozp01ddwvqd0ob6l3m (copy)'>
            <connection CATALOG='peya-markets' EXECCATALOG='peya-markets' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-markets' schema='automated_tables_reports' server-oauth='' username='miguel.florencio@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1d4pnpu1jtozp01ddwvqd0ob6l3m (copy)' name='Custom SQL Query' type='text'>SELECT&#13;
&#13;
  day_date,&#13;
  country_id,&#13;
  country_name,&#13;
  city_name,&#13;
&#13;
  /* OVERALL */&#13;
  SAFE_DIVIDE(SUM(order_opportunity_num), SUM(order_opportunity_den)) AS order_opportunity_percent,&#13;
  SUM(acquisitions) AS acquisitions,&#13;
  SUM(active_customers) AS active_customers,&#13;
  SUM(active_partners_food) AS active_partners_food,&#13;
  SUM(active_partners_ls) AS active_partners_ls,&#13;
  SUM(active_riders) AS active_riders,&#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM(Delivery_Time), 60) , SUM(Delivery_Time_Base)) AS avg_delivery_time,&#13;
  -- SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(PLUS_ORDERS)) AS cofunded_orders_share_plus,&#13;
  SUM(confirmed_orders) AS confirmed_orders,&#13;
  SAFE_DIVIDE(SUM(total_cost),SUM(confirmed_orders)) AS cpo,&#13;
  SAFE_DIVIDE(SUM(orders_total_sessions),SUM(sessions_total)) AS CVR,&#13;
  -- SAFE_DIVIDE(SUM(confirmed_orders) , IF(month_date = DATE_TRUNC(CURRENT_DATE,MONTH),EXTRACT(DAY FROM CURRENT_DATE()) , EXTRACT(DAY FROM LAST_DAY(DATE(month_date))))) AS avg_daily_orders,&#13;
  SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(confirmed_orders + Non_Confirmed_Orders)) AS fail_rate,&#13;
  SAFE_DIVIDE(SUM(flgpo_non_courier), SUM(confirmed_orders_non_courier)) AS flgpo_non_courier,&#13;
  SAFE_DIVIDE(SUM(active_partners_ka_food),SUM(active_partners_food)) AS partners_food_ka_share,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders),SUM(active_customers)) AS frequency,&#13;
  SUM(confirmed_gmv_vendor_non_courier) AS gmv_gross_non_courier,&#13;
  SAFE_DIVIDE(SUM(gpo_non_courier), SUM(confirmed_orders_non_courier)) AS gpo_non_courier,&#13;
  SAFE_DIVIDE(SUM(active_partners_ls_aaa), SUM(active_partners_ls)) AS active_partners_ls_aaa_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(incentivized_orders) , SUM(confirmed_orders)) AS orders_w_incentives_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(active_partners_food_w_pickup),SUM(active_partners_food)) as pu_active_partners_food_share,&#13;
  &#13;
  SUM(partners_new) AS partners_new,&#13;
  SUM(qty_customers_first_order_groceries) AS new_qc_customers,&#13;
&#13;
  SAFE_DIVIDE((SUM(nps_promoters)-SUM(nps_detractor)),SUM(nps_detractor+nps_passive+nps_promoters) )AS relational_nps,&#13;
  SAFE_DIVIDE(SUM (open_time_food),SUM(open_time_food_den)) as open_time_food,  &#13;
  SAFE_DIVIDE(SUM (open_time_non_food),SUM(open_time_non_food_den)) as open_time_non_food,  &#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM (open_time_food),SUM(open_time_food_den)),SAFE_DIVIDE(SUM (open_time_non_food),SUM(open_time_non_food_den))) open_time_food_vs_non_food,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM (confirmed_orders_dmart),SUM(confirmed_orders)) as order_dmart_share,  &#13;
  SAFE_DIVIDE(SUM (confirmed_orders_ls),SUM(confirmed_orders)) as order_ls_share,  &#13;
&#13;
  -- SUM(NET_USERS) AS net_users_plus, &#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_order_share, &#13;
  SAFE_DIVIDE(SUM(confirmed_orders_food_pickup),SUM(confirmed_orders_food)) AS pu_orders_share_food,&#13;
  SUM(active_partners_QC) AS active_partners_QC,&#13;
  SUM(confirmed_orders_QC) AS orders_qc,&#13;
  -- SAFE_DIVIDE(SUM(retention_overall_m1) , SUM(Active_Customers_Overall_M1)) AS retention_m1,&#13;
  -- SAFE_DIVIDE(SUM(qty_orders_sessions), SUM(total_orders_logistic_seamless)) AS session_rate_overall,&#13;
  SUM(sessions_total) as sessions,&#13;
  SAFE_DIVIDE(SUM(takein_non_courier), SUM(confirmed_orders_non_courier)) AS takein_non_courier,&#13;
&#13;
  /* PLUS */&#13;
  -- SAFE_DIVIDE(SUM(TOTAL_ACTIVE_PARTERNS_PLUS),SUM(TOTAL_PARTNERS)) AS plus_partners_coverage, &#13;
  -- SUM(ADOPTION) AS plus_adoption, &#13;
  -- SAFE_DIVIDE(SUM(ADOPTION),SUM(ACTIVE_USERS)) AS plus_adoption_percent, &#13;
  -- SUM(CHURN) as plus_churn, &#13;
  -- SAFE_DIVIDE(SUM(CHURN),SUM(SUBSCRIBED)) AS plus_churn_percent, &#13;
  -- SAFE_DIVIDE(SUM(CHURN_USER),SUM(SUBSCRIBED)) AS plus_churn_by_user_percent, &#13;
  -- SAFE_DIVIDE(SUM(CHURN_NOT_BB),SUM(SUBSCRIBED)) AS plus_churn_not_billable_percent, &#13;
  -- SAFE_DIVIDE(SUM(COBERTURA_DF), SUM(DISCOUNT_AMOUNT_EUR_LISTING_DF)) as df_paid_by_partner_percent,&#13;
  -- 0 AS flgpo_delta_vs_non_plus,&#13;
  -- 0 AS flgpo_plus,&#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(PLUS_USERS)) AS plus_frequency, &#13;
  -- SAFE_DIVIDE(&#13;
  --   (SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(PLUS_USERS))),&#13;
  --   (SAFE_DIVIDE(SUM(ORDERS - PLUS_ORDERS), SUM(ACTIVE_USERS-PLUS_USERS)))&#13;
  -- )-1 AS plus_frequency_gap, &#13;
  -- SUM(NET_USERS) AS plus_net_users, &#13;
  -- SAFE_DIVIDE(SUM(NET_USERS),SUM(ACTIVE_USERS)) AS plus_net_users_percent, &#13;
  -- SAFE_DIVIDE(SUM(COBERTURA_ORDENES),SUM(ORDERS)) AS order_coverage,&#13;
  -- SUM(PLUS_ORDERS) AS plus_orders, &#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_orders_share, &#13;
  -- SAFE_DIVIDE(SUM(PROD_SUBS_ORDERS),SUM(PLUS_ORDERS_FOOD))  AS orders_plus_food_deals_penetration, &#13;
  -- SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(COFUNDABLE_ORDERS)) AS plus_paying_orders, &#13;
  -- SAFE_DIVIDE(SUM(PS_PLUS_PARTNER_AMOUNT), SUM(PS_PLUS_AMOUNT)) as vfd_over_discount_amount_plus, &#13;
&#13;
  /* CHOICE */&#13;
  -- SAFE_DIVIDE(SUM(activation_m0),SUM(activation_bases_online)) AS activation_rate,&#13;
  -- SAFE_DIVIDE(SUM(activation_m0_field),SUM(activation_bases_online_field)) activation_rate_field,&#13;
  -- SAFE_DIVIDE(SUM(activation_m0_ssu),SUM(activation_bases_online_ssu)) activation_rate_ssu,&#13;
&#13;
  SAFE_DIVIDE(SUM(active_partners_food),SUM(qty_active_partners)) AS active_partners_food_share,&#13;
  SAFE_DIVIDE(SUM(active_partners_ls),SUM(qty_active_partners)) AS active_partners_ls_share,&#13;
&#13;
  -- SAFE_DIVIDE(SUM(ads_partners) , SUM(active_partners_tr_food)) AS  ads_part_penetration_percent,&#13;
  -- SAFE_DIVIDE(SUM(ads_eur),SUM(gmv_eur)) AS ads_over_gmv_percent,&#13;
&#13;
  SAFE_DIVIDE(SUM(total_commission_food_existing) , SUM(gfv_vendor_food_existing)) AS  commission_rate_food_existing,&#13;
  SAFE_DIVIDE(SUM(total_commission_food_new) , SUM(gfv_vendor_food_new)) AS  commission_rate_food_new,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls_existing) , SUM(gfv_vendor_ls_existing)) AS  commission_rate_ls_existing,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls_new) , SUM(gfv_vendor_ls_new)) AS  commission_rate_ls_new,&#13;
  SAFE_DIVIDE(SUM(total_commission) , SUM(gfv_vendor)) AS  commission_rate_overall,&#13;
&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_ka_food), SUM(confirmed_orders_food)) AS key_account_food_orders_percent,&#13;
  -- SAFE_DIVIDE(SUM(Partners_0_30_Orders_Food) , SUM(Partners_0_30_Orders_Food +Partners_0_Orders_Food+Partners_Plus30_Orders_Food)) AS low_orders_partners_food_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR1),SUM(sessions_home)) AS mCVR1,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR2),SUM(sessions_shop_list)) AS mCVR2,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR3),SUM(sessions_shop_details)) AS mCVR3,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR4),SUM(sessions_checkout)) AS mCVR4,&#13;
&#13;
&#13;
  SUM(partners_new_active_food) AS partners_new_active_food,&#13;
  SAFE_DIVIDE(SUM(partners_new_food), SUM(partners_new_non_food)) AS new_partners_food_vs_non_food,&#13;
&#13;
  SAFE_DIVIDE((SUM(Nps_Partners_Existing_Ao_Promoter) - SUM(Nps_Partners_Existing_Ao_Detractor)) , (SUM(Nps_Partners_Existing_Ao_Detractor) + SUM(Nps_Partners_Existing_Ao_Passive) + SUM(Nps_Partners_Existing_Ao_Promoter)) )* 100 AS nps_partners_existing,&#13;
&#13;
  -- SUM(gmv_preferent_eu_num)/ SUM(gmv_preferent_eu_den) AS gmv_preferent_eu_share,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_Total) , SUM(Seller_Head_Count_Total)) as productivity_overall,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_Field) , SUM(Seller_Head_Count_Field)) AS productivity_field,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_SSU) , SUM(Seller_Head_Count_SSU)) AS productivity_ssu,&#13;
  SAFE_DIVIDE(SUM(gmv_founded_partners_food) , SUM(confirmed_gmv_vendor_food)) AS vfd_over_gmv_percent,&#13;
&#13;
  SUM(partners_win_back_food) AS win_back_partners_food,&#13;
  -- SAFE_DIVIDE(SUM(Partners_0_Orders_Food) , SUM(Partners_0_30_Orders_Food +Partners_0_Orders_Food+Partners_Plus30_Orders_Food)) AS zombies_partners_food_share,&#13;
&#13;
  /* Q-commerce */&#13;
  SAFE_DIVIDE(SUM(active_customers_dmart), SUM(active_customers)) AS active_customers_share_dmart,&#13;
  SAFE_DIVIDE(SUM(active_customers_ls), SUM(active_customers)) AS active_customers_share_ls,&#13;
  SAFE_DIVIDE(SUM(active_customers_qc), SUM(active_customers)) AS active_customers_share_qc,&#13;
  --SUM(active_customers) AS active_customers,&#13;
  SUM(active_customers_dmart) AS active_customers_dmart,&#13;
  SUM(active_customers_ls) AS active_customers_ls,&#13;
  SUM(active_customers_qc) as active_customers_qc,&#13;
  SUM(active_partners_QC) AS active_partner_QC,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_dmart) , SUM(confirmed_orders_dmart)) AS  afv_vendor_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_aaa),SUM(confirmed_orders_aaa))AS basket_size_aaa,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_dmart),SUM(confirmed_orders_dmart))AS basket_size_dmars,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_non_aaa),SUM(confirmed_orders_non_aaa))AS basket_size_non_aaa,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_qc),SUM(confirmed_orders_qc))AS basket_size_qc,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM(active_customers_qc),SUM(active_customers)) as customer_penetration_qc,&#13;
&#13;
  SAFE_DIVIDE(SUM(unique_orders_qc),SUM(sessions_qc))AS cvr3_qc,&#13;
  SAFE_DIVIDE(SUM(unique_orders_aaa),SUM(Sessions_aaa))AS cvr3_aaa,&#13;
  SAFE_DIVIDE(SUM(unique_orders_dmart),SUM(Sessions_dmart))AS cvr3_dmart,&#13;
  SAFE_DIVIDE(SUM(unique_orders_non_aaa),SUM(Sessions_non_aaa))AS cvr3_non_aaa,&#13;
&#13;
  SUM(confirmed_orders_dmart) AS confirmed_orders_dmarts,&#13;
  --SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(confirmed_orders + Non_Confirmed_Orders)) AS fail_rate,&#13;
&#13;
  SAFE_DIVIDE((SUM(non_confirmed_orders_dmart) + SUM(non_confirmed_orders_ls)) ,(SUM(total_orders_dmart) + SUM(total_orders_ls))) as fail_rate_qc,&#13;
  SAFE_DIVIDE(SUM(qty_non_confirmed_orders_aaa) , SUM(total_orders_aaa)) as fail_rate_aaa,&#13;
&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_cash_ls) , SUM(total_orders_ls)) as fail_rate_cash_ls,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_online_pay_ls) , SUM(total_orders_ls)) as fail_rate_online_pay_ls,&#13;
  SAFE_DIVIDE(SUM(qty_non_confirmed_orders_non_aaa) , SUM(total_orders_non_aaa)) as fail_rate_non_aaa,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_dmart) , SUM(total_orders_dmart)) as fail_rate_dmart,&#13;
&#13;
  SUM(qty_customers_first_order_groceries) AS qty_customers_first_order_groceries,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_qc),SUM(active_customers_qc)) AS frequency_qc,&#13;
&#13;
  SUM(confirmed_gmv_vendor_aaa) as gmv_aaa,&#13;
  SUM(gmv_vendor_dmarts) as gmv_dmart,&#13;
  SUM(confirmed_gmv_vendor_ls) as gmv_ls,&#13;
  SUM(confirmed_gmv_vendor_non_aaa) as gmv_non_aaa,&#13;
  SUM(Confirmed_Gmv_vendor_Qc) AS gmv_qc,&#13;
&#13;
  SAFE_DIVIDE(SUM(gmv_vendor_dmarts),SUM(confirmed_gmv_vendor_non_courier)) AS gmv_vendor_dmarts_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(gpo_qc), SUM(confirmed_orders_qc)) as gpo_qc,&#13;
  SAFE_DIVIDE(SUM(gpo_aaa),SUM(confirmed_orders_aaa)) AS gpo_aaa,&#13;
  SAFE_DIVIDE(SUM(gpo_dmart), SUM(confirmed_orders_dmart)) as gpo_dmart,&#13;
  SAFE_DIVIDE(SUM(gpo_non_aaa),SUM(confirmed_orders_non_aaa)) AS gpo_non_aaa,&#13;
&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_qc) , SUM(confirmed_orders_qc)) as inaccuracy_qc,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_aaa) , SUM(confirmed_orders_aaa)) as inaccuracy_aaa,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_non_aaa) , SUM(confirmed_orders_non_aaa)) as inaccuracy_non_aaa,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_dmart) , SUM(confirmed_orders_dmart)) as inaccuracy_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_ls), SUM(total_orders_ls)) AS fail_rate_vendor_ls,&#13;
&#13;
  SUM(confirmed_orders_ls) AS confirmed_orders_ls,&#13;
  --SAFE_DIVIDE(SUM (confirmed_orders_dmart),SUM(confirmed_orders)) as order_dmart_share,  &#13;
  --SAFE_DIVIDE(SUM (confirmed_orders_ls),SUM(confirmed_orders)) as order_ls_share,  &#13;
  SAFE_DIVIDE(SUM (confirmed_orders_QC),SUM(confirmed_orders)) as order_qc_share,&#13;
  SUM(confirmed_orders_QC) as confirmed_orders_QC,&#13;
  -- SUM(qty_trials) AS trials,&#13;
&#13;
  /* Other commitments  */&#13;
  SUM(confirmed_orders_courier_b2c) AS confirmed_orders_courier_b2c,&#13;
  SUM(confirmed_orders_courier_c2c) AS confirmed_orders_courier_c2c,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_courier), SUM(confirmed_orders)) AS confirmed_orders_courier_share,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_food_pickup),SUM(confirmed_orders_food)) AS pickup_orders_share_food,&#13;
  SUM(confirmed_orders_food_pickup) AS confirmed_orders_pickup,&#13;
  --SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(PLUS_ORDERS)) AS cofunded_orders_share_plus,&#13;
  --SUM(NET_USERS) AS plus_net_users, &#13;
  --SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_orders_share,&#13;
  --SUM(PLUS_ORDERS) AS plus_orders, &#13;
  --SAFE_DIVIDE(SUM(TOTAL_ACTIVE_PARTERNS_PLUS),SUM(TOTAL_PARTNERS)) AS plus_partners_coverage,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_qc), SUM(total_orders_qc)) AS fail_rate_vendor_qc,&#13;
  --SAFE_DIVIDE(SUM(active_partners_food_w_pickup),SUM(active_partners_food)) as pu_active_partners_food_share,&#13;
&#13;
  /* OPS */&#13;
&#13;
  SAFE_DIVIDE(SUM(cant_orders_with_delivery_time_45),SUM(completed_orders)) AS orders_with_delivery_time_45_share,&#13;
  SAFE_DIVIDE(SUM(cant_orders_with_delivery_time_60),SUM(completed_orders)) AS orders_with_delivery_time_60_share,&#13;
  --SAFE_DIVIDE(SAFE_DIVIDE(SUM(Delivery_Time), 60) , SUM(Delivery_Time_Base)) AS Avg_Delivery_Time,&#13;
  -- SAFE_DIVIDE(SUM(num_contacts_created), SUM(total_orders)) AS contact_rate_user,&#13;
  --SAFE_DIVIDE(SUM(total_cost),SUM(confirmed_orders)) AS cpo,&#13;
  -- SAFE_DIVIDE(SUM(sat_ssf), SUM(resp_ssf)) AS csat_overall_hc_and_ac,&#13;
  SAFE_DIVIDE(SUM(trx_CVR3), SUM(sessions_shop_details)) AS CVR3,&#13;
  SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(total_orders)) AS fail_rate_overall,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_cash_food), SUM(total_orders_food)) AS fail_rate_cash_food,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_online_pay_food), SUM(total_orders_food)) AS fail_rate_online_payment_food,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_food), SUM(total_orders_food)) AS fail_rate_vendor_food,&#13;
  --SAFE_DIVIDE((SUM(Nps_Partners_Existing_Ao_Promoter) - SUM(Nps_Partners_Existing_Ao_Detractor)) , (SUM(Nps_Partners_Existing_Ao_Detractor) + SUM(Nps_Partners_Existing_Ao_Passive) + SUM(Nps_Partners_Existing_Ao_Promoter)) )* 100 AS nps_partners_existing,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_online_payment), SUM(confirmed_orders)) AS online_payment_share,&#13;
  SAFE_DIVIDE(SUM (open_time),SUM(open_time_den)) as open_time,  &#13;
  --SAFE_DIVIDE(SUM(order_opportunity_num), SUM(order_opportunity_den)) AS order_opportunity_percent,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_peya_fail), SUM(total_orders)) AS fail_rate_peya_owner,&#13;
  -- SAFE_DIVIDE(SUM(resolution_rate_num),SUM(resolution_rate_den)) AS resolution_rate,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_rider_fail), SUM(total_orders)) AS fail_rate_rider_owner,&#13;
  SAFE_DIVIDE(SUM(Confirmed_Orders_1_Payment_No_Contact_Not_Delayed), SUM(total_orders_logistic_seamless)) AS Seamless_orders_percent,&#13;
  SAFE_DIVIDE(SUM(orders_total_sessions), SUM(total_orders)) AS session_rate_ops,&#13;
  SAFE_DIVIDE(SUM(stacked_deliveries), SUM(completed_orders)) AS stacking_percent,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_user_fail), SUM(total_orders)) AS fail_rate_user_owner,&#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM(completed_orders), SUM(sum_actual_evaluated_working_hours)),3600) AS utr,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor), SUM(total_orders)) AS fail_rate_online_vendor,&#13;
  SAFE_DIVIDE(SUM(VL_10_numerator), SUM(VL_10_denominator)) AS vendor_late_10,&#13;
  SAFE_DIVIDE(SUM(order_late_10), SUM(order_late_base)) AS order_late_10,&#13;
&#13;
&#13;
  /* Ensure Clear Leadership */&#13;
&#13;
  SAFE_DIVIDE(SUM(incentivized_orders) , SUM(confirmed_orders)) AS incentivized_orders_share,&#13;
  SAFE_DIVIDE(SUM(incentivized_acquisitions) , SUM(acquisitions)) AS incentivized_acquisitions_share,&#13;
&#13;
  /* Profitability */&#13;
&#13;
  SUM(amount_w_df_incentive) AS amount_w_df_incentives,&#13;
  SUM(amount_crm_incentives) AS orders_crm_incentives,&#13;
  SUM(df_listing)/SUM(confirmed_orders_listing) AS delivery_fee_incentives,&#13;
&#13;
  ((SUM(CASE WHEN 1 = 1 THEN df_food_Listing END) / SUM(CASE WHEN 1 = 1 THEN confirmed_orders_food_listing END)) / &#13;
    (SUM(CASE WHEN 1 = 1 THEN GFV_gross_food_listing END) / SUM(CASE WHEN 1 = 1 THEN confirmed_orders_food_listing END)))&#13;
    +&#13;
    (SUM(CASE WHEN 1 = 1 THEN sf_food_Listing END) / SUM(CASE WHEN 1 = 1 THEN GFV_gross_food_listing END)) AS food_uc_over_afv,&#13;
&#13;
  SUM(amount_with_free_delivery_peya_funded) AS amount_with_free_df_peya_funded,&#13;
  SUM(amount_promotional_delivery_fee_peya_funded) AS amount_promotional_df_peya_funded,&#13;
  SAFE_DIVIDE(SUM(orders_with_free_delivery_peya_funded) , SUM(total_orders_non_courier)) AS share_orders_free_df_peya_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_promotional_delivery_fee_peya_funded) , SUM(total_orders_non_courier)) AS share_orders_promotional_df_peya_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_vendor_funded) , SUM(total_orders_non_courier)) AS share_orders_df_incentives_vendor_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_w_df_incentive) , SUM(total_orders_non_courier)) AS share_orders_w_df_incentives,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_dmart) , SUM(confirmed_orders_logistics_dmart)) AS  delivery_cpo_dmart,&#13;
  --SAFE_DIVIDE(SUM(gfv_vendor_dmart) , SUM(confirmed_orders_dmart)) AS  afv_vendor_dmart,&#13;
  SAFE_DIVIDE(SUM(total_commission_dmart) , SUM(gfv_vendor_dmart)) AS  commission_rate_dmart,&#13;
  --SAFE_DIVIDE(SUM(gpo_dmart),SUM(confirmed_orders_dmart)) AS gpo_dmart,&#13;
  SAFE_DIVIDE(SUM(flgpo_dmart),SUM(confirmed_orders_dmart)) AS flgpo_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_food) , SUM(confirmed_orders_logistics_food)) AS  delivery_cpo_food,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_food) , SUM(confirmed_orders_food)) AS  afv_vendor_food,&#13;
  SAFE_DIVIDE(SUM(total_commission_food) , SUM(gfv_vendor_food)) AS  commission_rate_food,&#13;
  SAFE_DIVIDE(SUM(gpo_food),SUM(confirmed_orders_food)) AS gpo_food,&#13;
  SAFE_DIVIDE(SUM(flgpo_food),SUM(confirmed_orders_food)) AS flgpo_food,&#13;
  SAFE_DIVIDE(SUM(takein_food),SUM(confirmed_orders_food)) AS takein_food,&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_ls) , SUM(confirmed_orders_logistics_ls)) AS  delivery_cpo_ls,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_ls) , SUM(confirmed_orders_ls)) AS  afv_vendor_ls,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls) , SUM(gfv_vendor_ls)) AS  commission_rate_ls,&#13;
  SAFE_DIVIDE(SUM(gpo_ls),SUM(confirmed_orders_ls)) AS gpo_ls,&#13;
  SAFE_DIVIDE(SUM(flgpo_ls),SUM(confirmed_orders_ls)) AS flgpo_ls,&#13;
  SAFE_DIVIDE(SUM(takein_ls),SUM(confirmed_orders_ls)) AS takein_ls,&#13;
  &#13;
FROM `peya-markets.automated_tables_reports.data_daily_360_by_city`&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1d4pnpu1jtozp01ddwvqd0ob6l3m (copy)' name='Custom SQL Query' type='text'>SELECT&#13;
&#13;
  day_date,&#13;
  country_id,&#13;
  country_name,&#13;
  city_name,&#13;
&#13;
  /* OVERALL */&#13;
  SAFE_DIVIDE(SUM(order_opportunity_num), SUM(order_opportunity_den)) AS order_opportunity_percent,&#13;
  SUM(acquisitions) AS acquisitions,&#13;
  SUM(active_customers) AS active_customers,&#13;
  SUM(active_partners_food) AS active_partners_food,&#13;
  SUM(active_partners_ls) AS active_partners_ls,&#13;
  SUM(active_riders) AS active_riders,&#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM(Delivery_Time), 60) , SUM(Delivery_Time_Base)) AS avg_delivery_time,&#13;
  -- SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(PLUS_ORDERS)) AS cofunded_orders_share_plus,&#13;
  SUM(confirmed_orders) AS confirmed_orders,&#13;
  SAFE_DIVIDE(SUM(total_cost),SUM(confirmed_orders)) AS cpo,&#13;
  SAFE_DIVIDE(SUM(orders_total_sessions),SUM(sessions_total)) AS CVR,&#13;
  -- SAFE_DIVIDE(SUM(confirmed_orders) , IF(month_date = DATE_TRUNC(CURRENT_DATE,MONTH),EXTRACT(DAY FROM CURRENT_DATE()) , EXTRACT(DAY FROM LAST_DAY(DATE(month_date))))) AS avg_daily_orders,&#13;
  SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(confirmed_orders + Non_Confirmed_Orders)) AS fail_rate,&#13;
  SAFE_DIVIDE(SUM(flgpo_non_courier), SUM(confirmed_orders_non_courier)) AS flgpo_non_courier,&#13;
  SAFE_DIVIDE(SUM(active_partners_ka_food),SUM(active_partners_food)) AS partners_food_ka_share,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders),SUM(active_customers)) AS frequency,&#13;
  SUM(confirmed_gmv_vendor_non_courier) AS gmv_gross_non_courier,&#13;
  SAFE_DIVIDE(SUM(gpo_non_courier), SUM(confirmed_orders_non_courier)) AS gpo_non_courier,&#13;
  SAFE_DIVIDE(SUM(active_partners_ls_aaa), SUM(active_partners_ls)) AS active_partners_ls_aaa_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(incentivized_orders) , SUM(confirmed_orders)) AS orders_w_incentives_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(active_partners_food_w_pickup),SUM(active_partners_food)) as pu_active_partners_food_share,&#13;
  &#13;
  SUM(partners_new) AS partners_new,&#13;
  SUM(qty_customers_first_order_groceries) AS new_qc_customers,&#13;
&#13;
  SAFE_DIVIDE((SUM(nps_promoters)-SUM(nps_detractor)),SUM(nps_detractor+nps_passive+nps_promoters) )AS relational_nps,&#13;
  SAFE_DIVIDE(SUM (open_time_food),SUM(open_time_food_den)) as open_time_food,  &#13;
  SAFE_DIVIDE(SUM (open_time_non_food),SUM(open_time_non_food_den)) as open_time_non_food,  &#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM (open_time_food),SUM(open_time_food_den)),SAFE_DIVIDE(SUM (open_time_non_food),SUM(open_time_non_food_den))) open_time_food_vs_non_food,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM (confirmed_orders_dmart),SUM(confirmed_orders)) as order_dmart_share,  &#13;
  SAFE_DIVIDE(SUM (confirmed_orders_ls),SUM(confirmed_orders)) as order_ls_share,  &#13;
&#13;
  -- SUM(NET_USERS) AS net_users_plus, &#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_order_share, &#13;
  SAFE_DIVIDE(SUM(confirmed_orders_food_pickup),SUM(confirmed_orders_food)) AS pu_orders_share_food,&#13;
  SUM(active_partners_QC) AS active_partners_QC,&#13;
  SUM(confirmed_orders_QC) AS orders_qc,&#13;
  -- SAFE_DIVIDE(SUM(retention_overall_m1) , SUM(Active_Customers_Overall_M1)) AS retention_m1,&#13;
  -- SAFE_DIVIDE(SUM(qty_orders_sessions), SUM(total_orders_logistic_seamless)) AS session_rate_overall,&#13;
  SUM(sessions_total) as sessions,&#13;
  SAFE_DIVIDE(SUM(takein_non_courier), SUM(confirmed_orders_non_courier)) AS takein_non_courier,&#13;
&#13;
  /* PLUS */&#13;
  -- SAFE_DIVIDE(SUM(TOTAL_ACTIVE_PARTERNS_PLUS),SUM(TOTAL_PARTNERS)) AS plus_partners_coverage, &#13;
  -- SUM(ADOPTION) AS plus_adoption, &#13;
  -- SAFE_DIVIDE(SUM(ADOPTION),SUM(ACTIVE_USERS)) AS plus_adoption_percent, &#13;
  -- SUM(CHURN) as plus_churn, &#13;
  -- SAFE_DIVIDE(SUM(CHURN),SUM(SUBSCRIBED)) AS plus_churn_percent, &#13;
  -- SAFE_DIVIDE(SUM(CHURN_USER),SUM(SUBSCRIBED)) AS plus_churn_by_user_percent, &#13;
  -- SAFE_DIVIDE(SUM(CHURN_NOT_BB),SUM(SUBSCRIBED)) AS plus_churn_not_billable_percent, &#13;
  -- SAFE_DIVIDE(SUM(COBERTURA_DF), SUM(DISCOUNT_AMOUNT_EUR_LISTING_DF)) as df_paid_by_partner_percent,&#13;
  -- 0 AS flgpo_delta_vs_non_plus,&#13;
  -- 0 AS flgpo_plus,&#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(PLUS_USERS)) AS plus_frequency, &#13;
  -- SAFE_DIVIDE(&#13;
  --   (SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(PLUS_USERS))),&#13;
  --   (SAFE_DIVIDE(SUM(ORDERS - PLUS_ORDERS), SUM(ACTIVE_USERS-PLUS_USERS)))&#13;
  -- )-1 AS plus_frequency_gap, &#13;
  -- SUM(NET_USERS) AS plus_net_users, &#13;
  -- SAFE_DIVIDE(SUM(NET_USERS),SUM(ACTIVE_USERS)) AS plus_net_users_percent, &#13;
  -- SAFE_DIVIDE(SUM(COBERTURA_ORDENES),SUM(ORDERS)) AS order_coverage,&#13;
  -- SUM(PLUS_ORDERS) AS plus_orders, &#13;
  -- SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_orders_share, &#13;
  -- SAFE_DIVIDE(SUM(PROD_SUBS_ORDERS),SUM(PLUS_ORDERS_FOOD))  AS orders_plus_food_deals_penetration, &#13;
  -- SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(COFUNDABLE_ORDERS)) AS plus_paying_orders, &#13;
  -- SAFE_DIVIDE(SUM(PS_PLUS_PARTNER_AMOUNT), SUM(PS_PLUS_AMOUNT)) as vfd_over_discount_amount_plus, &#13;
&#13;
  /* CHOICE */&#13;
  -- SAFE_DIVIDE(SUM(activation_m0),SUM(activation_bases_online)) AS activation_rate,&#13;
  -- SAFE_DIVIDE(SUM(activation_m0_field),SUM(activation_bases_online_field)) activation_rate_field,&#13;
  -- SAFE_DIVIDE(SUM(activation_m0_ssu),SUM(activation_bases_online_ssu)) activation_rate_ssu,&#13;
&#13;
  SAFE_DIVIDE(SUM(active_partners_food),SUM(qty_active_partners)) AS active_partners_food_share,&#13;
  SAFE_DIVIDE(SUM(active_partners_ls),SUM(qty_active_partners)) AS active_partners_ls_share,&#13;
&#13;
  -- SAFE_DIVIDE(SUM(ads_partners) , SUM(active_partners_tr_food)) AS  ads_part_penetration_percent,&#13;
  -- SAFE_DIVIDE(SUM(ads_eur),SUM(gmv_eur)) AS ads_over_gmv_percent,&#13;
&#13;
  SAFE_DIVIDE(SUM(total_commission_food_existing) , SUM(gfv_vendor_food_existing)) AS  commission_rate_food_existing,&#13;
  SAFE_DIVIDE(SUM(total_commission_food_new) , SUM(gfv_vendor_food_new)) AS  commission_rate_food_new,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls_existing) , SUM(gfv_vendor_ls_existing)) AS  commission_rate_ls_existing,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls_new) , SUM(gfv_vendor_ls_new)) AS  commission_rate_ls_new,&#13;
  SAFE_DIVIDE(SUM(total_commission) , SUM(gfv_vendor)) AS  commission_rate_overall,&#13;
&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_ka_food), SUM(confirmed_orders_food)) AS key_account_food_orders_percent,&#13;
  -- SAFE_DIVIDE(SUM(Partners_0_30_Orders_Food) , SUM(Partners_0_30_Orders_Food +Partners_0_Orders_Food+Partners_Plus30_Orders_Food)) AS low_orders_partners_food_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR1),SUM(sessions_home)) AS mCVR1,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR2),SUM(sessions_shop_list)) AS mCVR2,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR3),SUM(sessions_shop_details)) AS mCVR3,&#13;
  SAFE_DIVIDE(SUM(sessions_mCVR4),SUM(sessions_checkout)) AS mCVR4,&#13;
&#13;
&#13;
  SUM(partners_new_active_food) AS partners_new_active_food,&#13;
  SAFE_DIVIDE(SUM(partners_new_food), SUM(partners_new_non_food)) AS new_partners_food_vs_non_food,&#13;
&#13;
  SAFE_DIVIDE((SUM(Nps_Partners_Existing_Ao_Promoter) - SUM(Nps_Partners_Existing_Ao_Detractor)) , (SUM(Nps_Partners_Existing_Ao_Detractor) + SUM(Nps_Partners_Existing_Ao_Passive) + SUM(Nps_Partners_Existing_Ao_Promoter)) )* 100 AS nps_partners_existing,&#13;
&#13;
  -- SUM(gmv_preferent_eu_num)/ SUM(gmv_preferent_eu_den) AS gmv_preferent_eu_share,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_Total) , SUM(Seller_Head_Count_Total)) as productivity_overall,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_Field) , SUM(Seller_Head_Count_Field)) AS productivity_field,&#13;
  -- SAFE_DIVIDE(SUM(Food_Acquisitions_SSU) , SUM(Seller_Head_Count_SSU)) AS productivity_ssu,&#13;
  SAFE_DIVIDE(SUM(gmv_founded_partners_food) , SUM(confirmed_gmv_vendor_food)) AS vfd_over_gmv_percent,&#13;
&#13;
  SUM(partners_win_back_food) AS win_back_partners_food,&#13;
  -- SAFE_DIVIDE(SUM(Partners_0_Orders_Food) , SUM(Partners_0_30_Orders_Food +Partners_0_Orders_Food+Partners_Plus30_Orders_Food)) AS zombies_partners_food_share,&#13;
&#13;
  /* Q-commerce */&#13;
  SAFE_DIVIDE(SUM(active_customers_dmart), SUM(active_customers)) AS active_customers_share_dmart,&#13;
  SAFE_DIVIDE(SUM(active_customers_ls), SUM(active_customers)) AS active_customers_share_ls,&#13;
  SAFE_DIVIDE(SUM(active_customers_qc), SUM(active_customers)) AS active_customers_share_qc,&#13;
  --SUM(active_customers) AS active_customers,&#13;
  SUM(active_customers_dmart) AS active_customers_dmart,&#13;
  SUM(active_customers_ls) AS active_customers_ls,&#13;
  SUM(active_customers_qc) as active_customers_qc,&#13;
  SUM(active_partners_QC) AS active_partner_QC,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_dmart) , SUM(confirmed_orders_dmart)) AS  afv_vendor_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_aaa),SUM(confirmed_orders_aaa))AS basket_size_aaa,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_dmart),SUM(confirmed_orders_dmart))AS basket_size_dmars,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_non_aaa),SUM(confirmed_orders_non_aaa))AS basket_size_non_aaa,&#13;
  SAFE_DIVIDE(SUM(qty_ordered_products_qc),SUM(confirmed_orders_qc))AS basket_size_qc,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM(active_customers_qc),SUM(active_customers)) as customer_penetration_qc,&#13;
&#13;
  SAFE_DIVIDE(SUM(unique_orders_qc),SUM(sessions_qc))AS cvr3_qc,&#13;
  SAFE_DIVIDE(SUM(unique_orders_aaa),SUM(Sessions_aaa))AS cvr3_aaa,&#13;
  SAFE_DIVIDE(SUM(unique_orders_dmart),SUM(Sessions_dmart))AS cvr3_dmart,&#13;
  SAFE_DIVIDE(SUM(unique_orders_non_aaa),SUM(Sessions_non_aaa))AS cvr3_non_aaa,&#13;
&#13;
  SUM(confirmed_orders_dmart) AS confirmed_orders_dmarts,&#13;
  --SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(confirmed_orders + Non_Confirmed_Orders)) AS fail_rate,&#13;
&#13;
  SAFE_DIVIDE((SUM(non_confirmed_orders_dmart) + SUM(non_confirmed_orders_ls)) ,(SUM(total_orders_dmart) + SUM(total_orders_ls))) as fail_rate_qc,&#13;
  SAFE_DIVIDE(SUM(qty_non_confirmed_orders_aaa) , SUM(total_orders_aaa)) as fail_rate_aaa,&#13;
&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_cash_ls) , SUM(total_orders_ls)) as fail_rate_cash_ls,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_online_pay_ls) , SUM(total_orders_ls)) as fail_rate_online_pay_ls,&#13;
  SAFE_DIVIDE(SUM(qty_non_confirmed_orders_non_aaa) , SUM(total_orders_non_aaa)) as fail_rate_non_aaa,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_dmart) , SUM(total_orders_dmart)) as fail_rate_dmart,&#13;
&#13;
  SUM(qty_customers_first_order_groceries) AS qty_customers_first_order_groceries,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_qc),SUM(active_customers_qc)) AS frequency_qc,&#13;
&#13;
  SUM(confirmed_gmv_vendor_aaa) as gmv_aaa,&#13;
  SUM(gmv_vendor_dmarts) as gmv_dmart,&#13;
  SUM(confirmed_gmv_vendor_ls) as gmv_ls,&#13;
  SUM(confirmed_gmv_vendor_non_aaa) as gmv_non_aaa,&#13;
  SUM(Confirmed_Gmv_vendor_Qc) AS gmv_qc,&#13;
&#13;
  SAFE_DIVIDE(SUM(gmv_vendor_dmarts),SUM(confirmed_gmv_vendor_non_courier)) AS gmv_vendor_dmarts_share,&#13;
&#13;
  SAFE_DIVIDE(SUM(gpo_qc), SUM(confirmed_orders_qc)) as gpo_qc,&#13;
  SAFE_DIVIDE(SUM(gpo_aaa),SUM(confirmed_orders_aaa)) AS gpo_aaa,&#13;
  SAFE_DIVIDE(SUM(gpo_dmart), SUM(confirmed_orders_dmart)) as gpo_dmart,&#13;
  SAFE_DIVIDE(SUM(gpo_non_aaa),SUM(confirmed_orders_non_aaa)) AS gpo_non_aaa,&#13;
&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_qc) , SUM(confirmed_orders_qc)) as inaccuracy_qc,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_aaa) , SUM(confirmed_orders_aaa)) as inaccuracy_aaa,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_non_aaa) , SUM(confirmed_orders_non_aaa)) as inaccuracy_non_aaa,&#13;
  SAFE_DIVIDE(SUM(inaccuracy_orders_dmart) , SUM(confirmed_orders_dmart)) as inaccuracy_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_ls), SUM(total_orders_ls)) AS fail_rate_vendor_ls,&#13;
&#13;
  SUM(confirmed_orders_ls) AS confirmed_orders_ls,&#13;
  --SAFE_DIVIDE(SUM (confirmed_orders_dmart),SUM(confirmed_orders)) as order_dmart_share,  &#13;
  --SAFE_DIVIDE(SUM (confirmed_orders_ls),SUM(confirmed_orders)) as order_ls_share,  &#13;
  SAFE_DIVIDE(SUM (confirmed_orders_QC),SUM(confirmed_orders)) as order_qc_share,&#13;
  SUM(confirmed_orders_QC) as confirmed_orders_QC,&#13;
  -- SUM(qty_trials) AS trials,&#13;
&#13;
  /* Other commitments  */&#13;
  SUM(confirmed_orders_courier_b2c) AS confirmed_orders_courier_b2c,&#13;
  SUM(confirmed_orders_courier_c2c) AS confirmed_orders_courier_c2c,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_courier), SUM(confirmed_orders)) AS confirmed_orders_courier_share,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_food_pickup),SUM(confirmed_orders_food)) AS pickup_orders_share_food,&#13;
  SUM(confirmed_orders_food_pickup) AS confirmed_orders_pickup,&#13;
  --SAFE_DIVIDE(SUM(COFUNDED_ORDERS),SUM(PLUS_ORDERS)) AS cofunded_orders_share_plus,&#13;
  --SUM(NET_USERS) AS plus_net_users, &#13;
  --SAFE_DIVIDE(SUM(PLUS_ORDERS), SUM(ORDERS)) AS plus_orders_share,&#13;
  --SUM(PLUS_ORDERS) AS plus_orders, &#13;
  --SAFE_DIVIDE(SUM(TOTAL_ACTIVE_PARTERNS_PLUS),SUM(TOTAL_PARTNERS)) AS plus_partners_coverage,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_qc), SUM(total_orders_qc)) AS fail_rate_vendor_qc,&#13;
  --SAFE_DIVIDE(SUM(active_partners_food_w_pickup),SUM(active_partners_food)) as pu_active_partners_food_share,&#13;
&#13;
  /* OPS */&#13;
&#13;
  SAFE_DIVIDE(SUM(cant_orders_with_delivery_time_45),SUM(completed_orders)) AS orders_with_delivery_time_45_share,&#13;
  SAFE_DIVIDE(SUM(cant_orders_with_delivery_time_60),SUM(completed_orders)) AS orders_with_delivery_time_60_share,&#13;
  --SAFE_DIVIDE(SAFE_DIVIDE(SUM(Delivery_Time), 60) , SUM(Delivery_Time_Base)) AS Avg_Delivery_Time,&#13;
  -- SAFE_DIVIDE(SUM(num_contacts_created), SUM(total_orders)) AS contact_rate_user,&#13;
  --SAFE_DIVIDE(SUM(total_cost),SUM(confirmed_orders)) AS cpo,&#13;
  -- SAFE_DIVIDE(SUM(sat_ssf), SUM(resp_ssf)) AS csat_overall_hc_and_ac,&#13;
  SAFE_DIVIDE(SUM(trx_CVR3), SUM(sessions_shop_details)) AS CVR3,&#13;
  SAFE_DIVIDE(SUM(Non_Confirmed_Orders), SUM(total_orders)) AS fail_rate_overall,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_cash_food), SUM(total_orders_food)) AS fail_rate_cash_food,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_online_pay_food), SUM(total_orders_food)) AS fail_rate_online_payment_food,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor_food), SUM(total_orders_food)) AS fail_rate_vendor_food,&#13;
  --SAFE_DIVIDE((SUM(Nps_Partners_Existing_Ao_Promoter) - SUM(Nps_Partners_Existing_Ao_Detractor)) , (SUM(Nps_Partners_Existing_Ao_Detractor) + SUM(Nps_Partners_Existing_Ao_Passive) + SUM(Nps_Partners_Existing_Ao_Promoter)) )* 100 AS nps_partners_existing,&#13;
  SAFE_DIVIDE(SUM(confirmed_orders_online_payment), SUM(confirmed_orders)) AS online_payment_share,&#13;
  SAFE_DIVIDE(SUM (open_time),SUM(open_time_den)) as open_time,  &#13;
  --SAFE_DIVIDE(SUM(order_opportunity_num), SUM(order_opportunity_den)) AS order_opportunity_percent,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_peya_fail), SUM(total_orders)) AS fail_rate_peya_owner,&#13;
  -- SAFE_DIVIDE(SUM(resolution_rate_num),SUM(resolution_rate_den)) AS resolution_rate,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_rider_fail), SUM(total_orders)) AS fail_rate_rider_owner,&#13;
  SAFE_DIVIDE(SUM(Confirmed_Orders_1_Payment_No_Contact_Not_Delayed), SUM(total_orders_logistic_seamless)) AS Seamless_orders_percent,&#13;
  SAFE_DIVIDE(SUM(orders_total_sessions), SUM(total_orders)) AS session_rate_ops,&#13;
  SAFE_DIVIDE(SUM(stacked_deliveries), SUM(completed_orders)) AS stacking_percent,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_user_fail), SUM(total_orders)) AS fail_rate_user_owner,&#13;
  SAFE_DIVIDE(SAFE_DIVIDE(SUM(completed_orders), SUM(sum_actual_evaluated_working_hours)),3600) AS utr,&#13;
  SAFE_DIVIDE(SUM(non_confirmed_orders_vendor), SUM(total_orders)) AS fail_rate_online_vendor,&#13;
  SAFE_DIVIDE(SUM(VL_10_numerator), SUM(VL_10_denominator)) AS vendor_late_10,&#13;
  SAFE_DIVIDE(SUM(order_late_10), SUM(order_late_base)) AS order_late_10,&#13;
&#13;
&#13;
  /* Ensure Clear Leadership */&#13;
&#13;
  SAFE_DIVIDE(SUM(incentivized_orders) , SUM(confirmed_orders)) AS incentivized_orders_share,&#13;
  SAFE_DIVIDE(SUM(incentivized_acquisitions) , SUM(acquisitions)) AS incentivized_acquisitions_share,&#13;
&#13;
  /* Profitability */&#13;
&#13;
  SUM(amount_w_df_incentive) AS amount_w_df_incentives,&#13;
  SUM(amount_crm_incentives) AS orders_crm_incentives,&#13;
  SUM(df_listing)/SUM(confirmed_orders_listing) AS delivery_fee_incentives,&#13;
&#13;
  ((SUM(CASE WHEN 1 = 1 THEN df_food_Listing END) / SUM(CASE WHEN 1 = 1 THEN confirmed_orders_food_listing END)) / &#13;
    (SUM(CASE WHEN 1 = 1 THEN GFV_gross_food_listing END) / SUM(CASE WHEN 1 = 1 THEN confirmed_orders_food_listing END)))&#13;
    +&#13;
    (SUM(CASE WHEN 1 = 1 THEN sf_food_Listing END) / SUM(CASE WHEN 1 = 1 THEN GFV_gross_food_listing END)) AS food_uc_over_afv,&#13;
&#13;
  SUM(amount_with_free_delivery_peya_funded) AS amount_with_free_df_peya_funded,&#13;
  SUM(amount_promotional_delivery_fee_peya_funded) AS amount_promotional_df_peya_funded,&#13;
  SAFE_DIVIDE(SUM(orders_with_free_delivery_peya_funded) , SUM(total_orders_non_courier)) AS share_orders_free_df_peya_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_promotional_delivery_fee_peya_funded) , SUM(total_orders_non_courier)) AS share_orders_promotional_df_peya_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_vendor_funded) , SUM(total_orders_non_courier)) AS share_orders_df_incentives_vendor_funded ,&#13;
  SAFE_DIVIDE(SUM(orders_w_df_incentive) , SUM(total_orders_non_courier)) AS share_orders_w_df_incentives,&#13;
&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_dmart) , SUM(confirmed_orders_logistics_dmart)) AS  delivery_cpo_dmart,&#13;
  --SAFE_DIVIDE(SUM(gfv_vendor_dmart) , SUM(confirmed_orders_dmart)) AS  afv_vendor_dmart,&#13;
  SAFE_DIVIDE(SUM(total_commission_dmart) , SUM(gfv_vendor_dmart)) AS  commission_rate_dmart,&#13;
  --SAFE_DIVIDE(SUM(gpo_dmart),SUM(confirmed_orders_dmart)) AS gpo_dmart,&#13;
  SAFE_DIVIDE(SUM(flgpo_dmart),SUM(confirmed_orders_dmart)) AS flgpo_dmart,&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_food) , SUM(confirmed_orders_logistics_food)) AS  delivery_cpo_food,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_food) , SUM(confirmed_orders_food)) AS  afv_vendor_food,&#13;
  SAFE_DIVIDE(SUM(total_commission_food) , SUM(gfv_vendor_food)) AS  commission_rate_food,&#13;
  SAFE_DIVIDE(SUM(gpo_food),SUM(confirmed_orders_food)) AS gpo_food,&#13;
  SAFE_DIVIDE(SUM(flgpo_food),SUM(confirmed_orders_food)) AS flgpo_food,&#13;
  SAFE_DIVIDE(SUM(takein_food),SUM(confirmed_orders_food)) AS takein_food,&#13;
&#13;
  SAFE_DIVIDE(SUM(semivariable_delivery_cpo_ls) , SUM(confirmed_orders_logistics_ls)) AS  delivery_cpo_ls,&#13;
  SAFE_DIVIDE(SUM(gfv_vendor_ls) , SUM(confirmed_orders_ls)) AS  afv_vendor_ls,&#13;
  SAFE_DIVIDE(SUM(total_commission_ls) , SUM(gfv_vendor_ls)) AS  commission_rate_ls,&#13;
  SAFE_DIVIDE(SUM(gpo_ls),SUM(confirmed_orders_ls)) AS gpo_ls,&#13;
  SAFE_DIVIDE(SUM(flgpo_ls),SUM(confirmed_orders_ls)) AS flgpo_ls,&#13;
  SAFE_DIVIDE(SUM(takein_ls),SUM(confirmed_orders_ls)) AS takein_ls,&#13;
  &#13;
FROM `peya-markets.automated_tables_reports.data_daily_360_by_city`&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
