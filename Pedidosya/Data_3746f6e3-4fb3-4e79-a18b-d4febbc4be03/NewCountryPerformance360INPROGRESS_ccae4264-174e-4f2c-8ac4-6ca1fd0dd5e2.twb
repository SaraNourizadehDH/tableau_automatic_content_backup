      <column datatype='real' default-format='p0.00%' name='[CVR3]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.00%' name='[CVR]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([avg_delivery_time])) - LOOKUP(ZN(SUM([avg_delivery_time])), -1)) / ABS(LOOKUP(ZN(SUM([avg_delivery_time])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Text OVERALL' datatype='integer' name='[Calculation_1946962467803996167]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Group Overall' datatype='string' name='[Calculation_461900466147241985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Overall&quot;' />
      </column>
      <column caption='Group Filter' datatype='boolean' name='[Calculation_461900466151235587]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;Overall&quot; THEN&#13;&#10;&#13;&#10;    [Group Overall (copy)_461900466148794370] = NULL &#13;&#10;&#13;&#10;WHEN &quot;Choice&quot; THEN &#13;&#10;     &#13;&#10;    [Calculation_461900466147241985] = NULL&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Latest Month' datatype='date' name='[Calculation_461900466162270212]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED :MAX([month_date])}' />
      </column>
      <column aggregation='Sum' caption='Is Last Month' datatype='integer' name='[Calculation_461900466162683909]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF&#13;&#10; DATETRUNC(&apos;month&apos;,[month_date]) = [Calculation_461900466162270212]&#13;&#10;THEN 1 ELSE 0 END' />
