            <column aggregation='Sum' caption='Is Last Month' datatype='integer' name='[Calculation_461900466162683909]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF&#13;&#10; DATETRUNC(&apos;month&apos;,[month_date]) = [Calculation_461900466162270212]&#13;&#10;THEN 1 ELSE 0 END' />
