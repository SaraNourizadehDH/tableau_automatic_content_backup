      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data 360 monthly' name='federated.14hglk303np3tt11wotoh1ea6wer' />
          </datasources>
          <datasource-dependencies datasource='federated.14hglk303np3tt11wotoh1ea6wer'>
            <column datatype='real' default-format='p0.00%' name='[CVR3]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[CVR]' role='measure' type='quantitative' />
            <column caption='Text OVERALL' datatype='integer' name='[Calculation_1946962467803996167]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_461900466162270212]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([month_date])}' />
            </column>
            <column aggregation='Sum' caption='Is Last Month' datatype='integer' name='[Calculation_461900466162683909]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF&#13;&#10; DATETRUNC(&apos;month&apos;,[month_date]) = [Calculation_461900466162270212]&#13;&#10;THEN 1 ELSE 0 END' />
            </column>
            <column aggregation='Sum' caption='Is Last Month or Is Last Month -1' datatype='integer' name='[Calculation_461900466166542344]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_461900466162683909] = 1 OR [Is Last Month (copy)_461900466164944902] = 1&#13;&#10;THEN 1&#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='LAST' datatype='integer' name='[Calculation_461900466167607305]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Is Last Month -1' datatype='integer' name='[Is Last Month (copy)_461900466164944902]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF&#13;&#10; DATETRUNC(&apos;month&apos;,[month_date]) = DATEADD(&apos;month&apos;,-1,[Calculation_461900466162270212])&#13;&#10;THEN 1 ELSE 0 END' />
            </column>
            <column datatype='real' default-format='p0.00%' name='[Seamless_orders_percent]' role='measure' type='quantitative' />
            <column caption='Text CHOICE' datatype='integer' name='[Text OVERALL (copia)_1946962468070522889]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Text Q-COMMERCE' datatype='integer' name='[Text OVERALL (copia)_1946962468070572042]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Text SEAMLESS' datatype='integer' name='[Text Q-COMMERCE (copia)_1608348071134150660]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Text OTHER COMMITMENTS' datatype='integer' name='[Text Q-COMMERCE (copia)_1608348071134433288]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Text ENSURE CLEAR LEADERSHIP' datatype='integer' name='[Text SEAMLESS (copia)_1608348071134212101]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Text PLUS' datatype='integer' name='[Text SEAMLESS (copia)_1608348071134285830]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Text PROFITABILITY' datatype='integer' name='[Text SEAMLESS (copia)_1608348071134367751]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[activation_rate]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[activation_rate_field]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[activation_rate_ssu]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_customers_dmart]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_customers_ls]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_customers_qc]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[active_customers_share_dmart]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[active_customers_share_ls]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[active_customers_share_qc]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_partners_QC]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_partners_food]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[active_partners_food_share]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_partners_ls]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[active_partners_ls_share]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_riders]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[ads_over_gmv_percent]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[ads_part_penetration_percent]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[afv_vendor_dmart]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[afv_vendor_food]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[afv_vendor_ls]' role='measure' type='quantitative' />
            <column datatype='real' name='[amount_promotional_df_peya_funded]' role='measure' type='quantitative' />
            <column datatype='real' name='[amount_w_df_incentives]' role='measure' type='quantitative' />
            <column datatype='real' name='[amount_with_free_df_peya_funded]' role='measure' type='quantitative' />
            <column datatype='real' name='[avg_daily_orders]' role='measure' type='quantitative' />
