    <worksheet name='Last Week change'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Last Week change</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='os_dashboard_main_query' name='federated.0soqar71an7jxb12z015y1ykdvze' />
          </datasources>
          <datasource-dependencies datasource='federated.0soqar71an7jxb12z015y1ykdvze'>
            <column caption='Share OD' datatype='real' name='[Calculation_1097189473521733632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_888897988988420105])/sum([orders])' />
            </column>
            <column caption='Date Week' datatype='datetime' name='[Calculation_1619888505614188544]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[date],&quot;monday&quot;)' />
            </column>
            <column caption='Not Running Week' datatype='boolean' name='[Calculation_1619888505614368769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1619888505614188544] &lt; datetrunc(&apos;week&apos;,TODAY(),&apos;monday&apos;)' />
            </column>
            <column caption='delivery_exceded_35_2' datatype='string' name='[Calculation_1731915568896290819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_exceded_35] = 1 THEN &apos;delivery_exceded_35&apos; ELSE &apos;not_exceded&apos; END' />
            </column>
            <column caption='% commitCandidates' datatype='real' default-format='p0.0%' name='[Calculation_1731915568933953550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [commited_candidate] WHEN &apos;commit_candidate&apos; THEN [orders] END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='% commited' datatype='real' default-format='p0.0%' name='[Calculation_1731915568935018511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [commited] WHEN &apos;commited&apos; THEN [orders] END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='OD related SR' datatype='real' name='[Calculation_1770477632016654336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([related_sessions])/sum([Calculation_888897988988420105])' />
            </column>
            <column caption='OS use %' datatype='real' default-format='p0.0%' name='[Calculation_580401415506595840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [os_used] WHEN &apos;os_used&apos; THEN [orders] END)/SUM([orders])' />
            </column>
            <column caption='SR' datatype='real' name='[Calculation_888897988945944576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])/SUM([orders])' />
            </column>
            <column caption='CR' datatype='real' name='[Calculation_888897988967350273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([cases])+sum(chats))/sum([orders])' />
            </column>
            <column caption='Last' datatype='integer' name='[Calculation_888897988986888199]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='Last ()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='OD Orders' datatype='integer' name='[Calculation_888897988988420105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [withLogistics] = true Then [orders] else 0 END' />
            </column>
            <column datatype='string' name='[Countries]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[country]' new-bin='true'>
                <bin default-name='false' value='&quot;panamá&quot;'>
                  <value>&quot;panam��&quot;</value>
                  <value>&quot;panamá&quot;</value>
