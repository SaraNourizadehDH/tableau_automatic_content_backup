    <worksheet name='Metrics by date'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Metrics by Date</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='os_dashboard_main_query' name='federated.0soqar71an7jxb12z015y1ykdvze' />
          </datasources>
          <datasource-dependencies datasource='federated.0soqar71an7jxb12z015y1ykdvze'>
            <column caption='%eta_change' datatype='real' default-format='p0.0%' name='[%late (copia)_1023443068242690049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [eta_change] WHEN &apos;has_eta_change&apos; THEN ([orders]) END)/SUM([orders])' />
            </column>
            <column caption='%on time' datatype='real' default-format='p0.0%' name='[%late (copia)_1731915568909836295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [dts_delivery] WHEN &apos;2.on time&apos; THEN ([orders]) END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='%before' datatype='real' default-format='p0.0%' name='[%on time (copia)_1731915568910245896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [dts_delivery] WHEN &apos;1.before&apos; THEN ([orders]) END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='Share OD' datatype='real' name='[Calculation_1097189473521733632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_888897988988420105])/sum([orders])' />
            </column>
            <column caption='% Stacking' datatype='real' default-format='p0%' name='[Calculation_1731915568559501314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(CASE [stacking] WHEN &apos;stacked&apos; THEN [orders] end)/sum([orders])' />
            </column>
            <column caption='delivery_exceded_35_2' datatype='string' name='[Calculation_1731915568896290819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_exceded_35] = 1 THEN &apos;delivery_exceded_35&apos; ELSE &apos;not_exceded&apos; END' />
            </column>
            <column caption='% orders with DT &gt; 35 min' datatype='real' default-format='p0.0%' name='[Calculation_1731915568897470468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Calculation_1731915568896290819] WHEN &apos;delivery_exceded_35&apos; THEN [orders] END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='%late' datatype='real' default-format='p0.0%' name='[Calculation_1731915568900489222]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [dts_delivery] WHEN &apos;3.late&apos; THEN ([orders]) END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='avg Delivery Time' datatype='real' name='[Calculation_1731915568911134729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time (Consulta SQL personalizada1)])/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='avg Time to Confirm' datatype='real' name='[Calculation_1731915568911503370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([created_to_confirmed])/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='avg Time to RiderAtVendor' datatype='real' name='[Calculation_1731915568911851531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_to_RiderAtVendor])/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='avg Time to PickUp' datatype='real' name='[Calculation_1731915568912166924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([RiderAtVendor_to_Pickup])/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='avg Time to Dropoff' datatype='real' name='[Calculation_1731915568912592909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Pickup_to_Dropoff])/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='% commitCandidates' datatype='real' default-format='p0.0%' name='[Calculation_1731915568933953550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [commited_candidate] WHEN &apos;commit_candidate&apos; THEN [orders] END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='% commited' datatype='real' default-format='p0.0%' name='[Calculation_1731915568935018511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [commited] WHEN &apos;commited&apos; THEN [orders] END)/SUM(CASE [withLogistics] WHEN true THEN [orders] END)' />
            </column>
            <column caption='OD related SR' datatype='real' name='[Calculation_1770477632016654336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([related_sessions])/sum([Calculation_888897988988420105])' />
            </column>
            <column caption='OS use %' datatype='real' default-format='p0.0%' name='[Calculation_580401415506595840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [os_used] WHEN &apos;os_used&apos; THEN [orders] END)/SUM([orders])' />
            </column>
            <column caption='FR' datatype='real' default-format='p0.0%' name='[Calculation_713820588340477952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM(CASE [state] WHEN &apos;CONFIRMED&apos; THEN [orders] END)/SUM([orders]))' />
            </column>
            <column caption='SR' datatype='real' name='[Calculation_888897988945944576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])/SUM([orders])' />
            </column>
            <column caption='CR' datatype='real' name='[Calculation_888897988967350273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([cases])+sum(chats))/sum([orders])' />
            </column>
            <column caption='OD Orders' datatype='integer' name='[Calculation_888897988988420105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [withLogistics] = true Then [orders] else 0 END' />
            </column>
