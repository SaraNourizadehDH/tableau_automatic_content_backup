    <worksheet name='Stacked contribution to SR'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Contribution to SR &#10;</run>
            <run>*All non-confirmed orders were excluded to avoid bias of orders rejected before they could be stacked. </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='os_dashboard_main_query' name='federated.0soqar71an7jxb12z015y1ykdvze' />
          </datasources>
          <datasource-dependencies datasource='federated.0soqar71an7jxb12z015y1ykdvze'>
            <column caption='Date Week' datatype='datetime' name='[Calculation_1619888505614188544]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[date],&quot;monday&quot;)' />
            </column>
            <column caption='Not Running Week' datatype='boolean' name='[Calculation_1619888505614368769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1619888505614188544] &lt; datetrunc(&apos;week&apos;,TODAY(),&apos;monday&apos;)' />
            </column>
            <column caption='Sessions stacked' datatype='integer' name='[Calculation_883831459495870464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(case [stacking] when &quot;stacked&quot; then [sessions] END)' />
            </column>
            <column caption='Sessions not stacked' datatype='integer' name='[Calculation_883831459496112129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(case [stacking] when &quot;not stacked&quot; then [sessions] END)+&#13;&#10;sum(case [stacking] when null  then [sessions] END)' />
            </column>
            <column caption='SR not stacked' datatype='real' name='[Calculation_883831459496443906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_883831459496112129]/sum([Calculation_888897988988420105])' />
            </column>
            <column caption='SR stacked' datatype='real' name='[Calculation_883831459496710148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_883831459495870464]/sum([Calculation_888897988988420105])' />
            </column>
            <column caption='OD Orders' datatype='integer' name='[Calculation_888897988988420105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [withLogistics] = true Then [orders] else 0 END' />
            </column>
