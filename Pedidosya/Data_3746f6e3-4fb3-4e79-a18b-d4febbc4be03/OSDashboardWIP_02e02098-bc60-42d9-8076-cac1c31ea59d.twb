            </column>
            <column caption='delivered use %' datatype='real' default-format='p0.0%' name='[OS use % (copia)_1731915568502415360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [delivered_seen] WHEN &apos;delivered_seen&apos; THEN [orders] END)/SUM([orders])' />
            </column>
            <column caption='OS use % (after confirmed)' datatype='real' default-format='p0.0%' name='[OS use % (copia)_1731915568502845441]' role='measure' type='quantitative'>
