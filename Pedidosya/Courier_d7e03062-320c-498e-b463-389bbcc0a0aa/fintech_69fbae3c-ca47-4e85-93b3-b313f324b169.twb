      <aliases enabled='yes' />
      <column caption='Category1' datatype='string' hidden='true' name='[CATEGORY]' role='dimension' type='nominal' />
      <column caption='paf_afv_gross' datatype='real' name='[Calculation_1267481861992321024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_amount]+[discount_paid_by_company]-[shipping_amount_no_discount]+[shipping_amount])/COUNTD([order_id (bo_bi_mkt_payment_method_vs_afv_and_user_frequency)])' />
      </column>
      <column caption='paf_frequency' datatype='real' name='[Calculation_1267481862250504195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_id (bo_bi_mkt_payment_method_vs_afv_and_user_frequency)])/COUNTD([user_id (bo_bi_mkt_payment_method_vs_afv_and_user_frequency)])' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_1482528764390969346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_id (bo_bi_mkt_payment_method_vs_afv_and_user_frequency)])/countd([user_id (bo_bi_mkt_payment_method_vs_afv_and_user_frequency)])' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1482528764392534019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GMV_US])/sum([payments])' />
      </column>
      <column caption='AFV USD' datatype='real' name='[Calculation_1482528764411232260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GMV_US])/sum([payments])' />
      </column>
      <column caption='total_orders' datatype='integer' name='[Calculation_283726813682323457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id (bo_bi_vw_overall_payment_share)])' />
      </column>
