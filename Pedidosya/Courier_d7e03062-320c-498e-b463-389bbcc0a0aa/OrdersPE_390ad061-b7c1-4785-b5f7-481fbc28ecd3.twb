          <datasource-dependencies datasource='federated.0gs6twm1lso2o31bd7d791v8w1fv'>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Inaccuracy Orders' datatype='integer' name='[Calculation_109634567348035588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;IF [delivery_type] != &quot;Vendor Delivery&quot; AND [order_status] = &apos;CONFIRMED&apos; THEN [count_orders_inaccuracy] END&#10;)' />
            </column>
            <column caption='Inaccuracy Issue' datatype='string' name='[Calculation_191684483697725440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [missing_item_orders] = 1 THEN &apos;Missing Item&apos;&#10;ELSEIF [food_quality_orders] = 1 THEN &apos;Food Quality&apos;&#10;ELSEIF [wrong_item_orders] = 1 THEN &apos;Wrong Item&apos;&#10;ELSEIF [wrong_order_orders] = 1 THEN &apos;Wrong Order&apos;&#10;END' />
            </column>
            <column caption='Inaccuracy Share' datatype='real' default-format='p0.00%' name='[Calculation_242420346151583748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;week&apos;, [fecha]), [Brand]: [Calculation_109634567348035588] } / &#10;&#10;{ FIXED DATETRUNC(&apos;week&apos;, [fecha]) , [type_business] : [Calculation_109634567348035588] }' />
            </column>
            <column caption='% Inaccuracy' datatype='real' default-format='p0.00%' name='[Calculation_821273676913717248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_109634567348035588] / &#10;sum(&#10;IF [delivery_type] != &quot;Vendor Delivery&quot; THEN [confirmed_orders] END&#10;)' />
            </column>
            <column datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_orders_inaccuracy]' role='measure' type='quantitative' />
            <column datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column datatype='date' default-format='*yy-mm-dd' name='[fecha]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[food_quality_orders]' role='measure' type='quantitative' />
