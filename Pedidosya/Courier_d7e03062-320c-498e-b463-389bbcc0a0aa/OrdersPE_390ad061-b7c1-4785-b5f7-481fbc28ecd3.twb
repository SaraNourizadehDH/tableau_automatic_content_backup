      <aliases enabled='yes' />
      <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
      <column caption='% Subsidized' datatype='real' default-format='p0.00%' name='[Calculation_109634567323279361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([subsidized_orders]) / sum([confirmed_orders])' />
      </column>
      <column caption='Inaccuracy Orders' datatype='integer' name='[Calculation_109634567348035588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;IF [delivery_type] != &quot;Vendor Delivery&quot; AND [order_status] = &apos;CONFIRMED&apos; THEN [count_orders_inaccuracy] END&#10;)' />
      </column>
      <column caption='Inaccuracy Issue' datatype='string' name='[Calculation_191684483697725440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [missing_item_orders] = 1 THEN &apos;Missing Item&apos;&#10;ELSEIF [food_quality_orders] = 1 THEN &apos;Food Quality&apos;&#10;ELSEIF [wrong_item_orders] = 1 THEN &apos;Wrong Item&apos;&#10;ELSEIF [wrong_order_orders] = 1 THEN &apos;Wrong Order&apos;&#10;END' />
      </column>
      <column caption='Inaccuracy Share' datatype='real' default-format='p0.00%' name='[Calculation_242420346151583748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;week&apos;, [fecha]), [Brand]: [Calculation_109634567348035588] } / &#10;&#10;{ FIXED DATETRUNC(&apos;week&apos;, [fecha]) , [type_business] : [Calculation_109634567348035588] }' />
      </column>
      <column caption='week_date' datatype='datetime' name='[Calculation_242420346152534022]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [fecha])' />
      </column>
      <column caption='FR' datatype='real' default-format='p0.00%' name='[Calculation_293578466092527616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rejected]) / [Calculation_293578466092748802]' />
      </column>
      <column caption='VFR' datatype='real' default-format='p0.00%' name='[Calculation_293578466092703745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rejected_by_partner]) / [Calculation_293578466092748802]' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_293578466092748802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Frecuencia' datatype='real' name='[Calculation_462393040497053696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders]) / COUNTD([user_id])' />
      </column>
      <column caption='% Devolución' datatype='real' default-format='p0.00%' name='[Calculation_5326210269951275008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_amountlocal_innacuracy]) / SUM([total_amount])' />
      </column>
      <column caption='% Inaccuracy' datatype='real' default-format='p0.00%' name='[Calculation_821273676913717248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_109634567348035588] / &#10;sum(&#10;IF [delivery_type] != &quot;Vendor Delivery&quot; THEN [confirmed_orders] END&#10;)' />
      </column>
      <column caption='Inacc Orders Lines' datatype='integer' name='[Calculation_821273676925743105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN( LOOKUP(SUM([count_orders_inaccuracy]),0))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Inacc Orders Dots' datatype='integer' name='[Calculation_821273676926218242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MAX( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;OR &#10;&#10;ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MIN( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;THEN ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Inacc Top / Bottom' datatype='string' name='[Calculation_821273676929785860]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MAX( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;THEN &apos;Top&apos;&#10;&#10;ELSEIF &#10;&#10;ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MIN( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;THEN &apos;Bottom&apos;&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
