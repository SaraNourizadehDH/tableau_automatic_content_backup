      <object-graph>
        <objects>
          <object caption='mkt_promos' id='_0D29CE92FE2944A1A3EF5773B561AEA1'>
            <properties context=''>
              <relation connection='bigquery.0t4jppi1ejobtf15x6llr1cx8oz3' name='Custom SQL Query2' type='text'>SELECT partner_id, registered_date , &#10;SUM(sub.qty_ordenes) as subsidized_orders,&#10;SUM(CASE WHEN paid_by_peya &gt;&gt; 0 THEN 0 ELSE sub.qty_ordenes END) as orders_sub_only_partner,&#10;SUM(CASE WHEN paid_by_peya &gt;&gt; 0 THEN sub.qty_ordenes END) as orders_sub_peya,&#10;SUM(sub.paid_by_peya) as paid_by_peya,&#10;SUM(sub.paid_by_others) as paid_by_others,&#10;FROM `peya-peru.automated_tables_reports.Subsidios_Foods_Peru` sub&#10;WHERE registered_date &gt;&gt;= DATE_ADD( DATE_TRUNC( CURRENT_DATE(),MONTH), INTERVAL -&lt;[Parameters].[Parameter 1]&gt; MONTH)&#10;GROUP BY 1,2</relation>
            </properties>
          </object>
          <object caption='dim_partner_date' id='_17F1F033944847D9BFD1D8C342F5E8F4'>
            <properties context=''>
              <relation connection='bigquery.0t4jppi1ejobtf15x6llr1cx8oz3' name='Custom SQL Query4' type='text'>SELECT DISTINCT partner_id, fecha FROM `peya-peru.automated_tables_reports.dim_partner_pe`&#10;CROSS JOIN (SELECT&#10;fecha,&#10;&#10;FROM unnest(generate_date_array(&#10;  &#10;  DATE_ADD( DATE_TRUNC( CURRENT_DATE(),MONTH), INTERVAL -&lt;[Parameters].[Parameter 1]&gt; MONTH)&#10;  &#10;  &#10;  , DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY)&#10;  &#10;  )) as fecha)&#10;ORDER BY 2 ASC</relation>
            </properties>
          </object>
          <object caption='dim_date' id='_3149B0FCDE294169A39C9A2FC4F4EE25'>
            <properties context=''>
              <relation connection='bigquery.0t4jppi1ejobtf15x6llr1cx8oz3' name='Custom SQL Query3' type='text'>SELECT&#10;fecha,&#10;&#10;FROM unnest(generate_date_array(&#10;  &#10;  DATE_ADD( DATE_TRUNC( CURRENT_DATE(),MONTH), INTERVAL -&lt;[Parameters].[Parameter 1]&gt; MONTH)&#10;&#10;  &#10;  , DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY)&#10;  &#10;  )) as fecha</relation>
            </properties>
          </object>
          <object caption='Orders' id='_6A1E7AA23BC0476CAEE421591FCCD870'>
            <properties context=''>
              <relation connection='bigquery.0t4jppi1ejobtf15x6llr1cx8oz3' name='Custom SQL Query' type='text'>SELECT &#10;*&#10;FROM `peya-peru.automated_tables_reports.OrdersPE` &#10;WHERE created_date &gt;&gt;= DATE_ADD( DATE_TRUNC( CURRENT_DATE(),MONTH), INTERVAL -&lt;[Parameters].[Parameter 1]&gt; MONTH)</relation>
            </properties>
          </object>
          <object caption='dim_partner_pe' id='_92298807CBF04B6A8D33123B5A9403A7'>
            <properties context=''>
              <relation connection='bigquery.0t4jppi1ejobtf15x6llr1cx8oz3' name='Custom SQL Query1' type='text'>SELECT * FROM `peya-peru.automated_tables_reports.dim_partner_pe`</relation>
            </properties>
          </object>
        </objects>
