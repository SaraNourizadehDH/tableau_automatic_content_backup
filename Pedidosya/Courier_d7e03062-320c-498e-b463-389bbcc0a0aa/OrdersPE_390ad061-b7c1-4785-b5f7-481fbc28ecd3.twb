            </column>
            <column caption='Inacc Orders Dots' datatype='integer' name='[Calculation_821273676926218242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MAX( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;OR &#10;&#10;ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MIN( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;THEN ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Inacc Top / Bottom' datatype='string' name='[Calculation_821273676929785860]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MAX( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;THEN &apos;Top&apos;&#10;&#10;ELSEIF &#10;&#10;ZN(LOOKUP(SUM([count_orders_inaccuracy]),0))&#10;&#10;= WINDOW_MIN( ZN(LOOKUP(SUM([count_orders_inaccuracy]),0)) )&#10;&#10;THEN &apos;Bottom&apos;&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
