        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1vdcmn80ryq5dx1g32dg90345zz8' name='Consulta SQL personalizada' type='text'>SELECT DISTINCT&#13;
    Partner_id,&#13;
    Country_name,&#13;
    Partner_name, &#13;
    Salesforce_id,&#13;
    Vertical, &#13;
    Seller,&#13;
    CASE WHEN Key_Account_Sub_Category IS NULL THEN &apos;Long Tail&apos; ELSE Key_Account_Sub_Category END AS Segmentacion,&#13;
    AccountSource,&#13;
    Seller_Channel,&#13;
    Self_Setup,&#13;
    Vendor_Grade,&#13;
    Winbacks,&#13;
    Acquisition_Date,-- Usar esta fecha para todo lo que implica fechas dentro del tablero&#13;
    FDO_or_AcqDate,&#13;
    DATE_DIFF(CURRENT_DATE(),DATE(FDO_or_AcqDate),DAY) AS Days_Online,&#13;
    DATE_DIFF(CURRENT_DATE(),DATE(Acquisition_Date),DAY) AS Days_From_Acquisition,&#13;
    Exceptions,&#13;
    Framework_Compliance_Day_1_H2,&#13;
    Framework_Compliance_Day_7_H2,&#13;
    Framework_Compliance_Day_15_H2,&#13;
       --Products&#13;
    Products_framework_H2,&#13;
    Total_products_Day1,&#13;
    Total_products_Day7,&#13;
    Total_products_Day15,&#13;
       --Photos&#13;
    Photos_framework_H2,&#13;
    Total_images_Day1,&#13;
    Percentage_images_Day1,&#13;
    Total_images_Day7,&#13;
    Percentage_images_Day7,&#13;
    Total_images_Day15,&#13;
    Percentage_images_Day15,&#13;
       --Discounts&#13;
    Always_On_Day_1,&#13;
    Always_On_Day_7,&#13;
    Always_On_Day_15,&#13;
      --Descriptions&#13;
    Descriptions_framework_H2,&#13;
    Total_description_Day1,&#13;
    Percentage_descriptions_Day1&#13;
    Total_description_Day7,&#13;
    Percentage_descriptions_Day7,&#13;
    Total_description_Day15,&#13;
    Percentage_descriptions_Day15,&#13;
     --Real Hours&#13;
    Real_Open_Time_F1d,&#13;
    Real_Open_Time_F7d,&#13;
    Real_Open_Time_F15d,&#13;
     --Orders&#13;
    Confirmed_orders_F1D,&#13;
    Confirmed_orders_F7D,&#13;
    Confirmed_orders_F15D&#13;
&#13;
  FROM  `peya-food-and-groceries.automated_tables_reports.Clasificacion_Adquisiciones_Cloned` &#13;
  WHERE Vertical = &apos;Food&apos;&#13;
  --AND Seller = &apos;ALEXANDER TAPIA&apos;--test&#13;
  --AND Acquisition_Date BETWEEN &apos;2024-05-01&apos; AND CURRENT_DATE()-- test&#13;
  --AND Salesforce_ID = &apos;HA2598&apos;-- testing when FDO_or_AcqDate = Acquisition_Date&#13;
  --AND Salesforce_ID = &apos;HA2YNI&apos;-- testing when FDO_or_AcqDate != Acquisition_Date</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
