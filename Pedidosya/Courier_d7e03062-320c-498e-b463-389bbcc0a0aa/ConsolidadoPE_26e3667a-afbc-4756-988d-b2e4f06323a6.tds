  <aliases enabled='yes' />
  <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
  <column caption='Top Brands' datatype='string' name='[Calculation_1087056423232716800]' role='measure' type='nominal'>
    <calculation class='tableau' formula='IF RANK_UNIQUE([Calculation_202873151882051586]) &lt;= [Parameters].[start_date (copy)] THEN &apos;Top Brands&apos; ELSE &apos;Otros&apos; END'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='Confirmed' datatype='integer' name='[Calculation_145170781958103040]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([confirmed_orders])' />
  </column>
  <column caption='Total Orders Completadas VLNN' datatype='integer' name='[Calculation_145170781958819841]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( &#10;&#10;IF order_status = &quot;CONFIRMED&quot; &#10;AND is_completed_VL_NN =1 THEN total_orders &#10;ELSE NULL END&#10;)' />
  </column>
  <column caption='Vendor Late (%)' datatype='real' default-format='p0.00%' name='[Calculation_145170781959036930]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL(&#10;&#10;SUM(vlorders) / [Calculation_145170781958819841],&#10;&#10;0)' />
  </column>
  <column caption='VL Orders' datatype='integer' name='[Calculation_145170781959368707]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([vlorders])' />
  </column>
  <column caption='Orders_completadas_stacked_si' datatype='integer' name='[Calculation_145170781959553028]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF &#10;    order_status=&apos;CONFIRMED&apos; AND is_completed=1 &#10;    AND is_stacked = 1&#10;    THEN total_orders&#10;    ELSE 0&#10;  END )' />
  </column>
  <column caption='Stacking (%)' datatype='real' default-format='p0.00%' name='[Calculation_145170781959827461]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL([Calculation_145170781959553028]/ [Calculation_145170781959974919],0)' />
  </column>
  <column caption='Total Orders Completadas' datatype='integer' name='[Calculation_145170781959974919]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([orders_completadas])' />
  </column>
  <column caption='Estimated Preptime (EPT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_145170781960200200]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(if &#10;    order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN estimated_prep_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_202873151881437184]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([rejected]) / SUM([total_orders])' />
  </column>
  <column caption='Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_202873151881650177]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([rejected_by_partner]) / SUM([total_orders])' />
  </column>
  <column caption='Total Orders' datatype='integer' name='[Calculation_202873151882051586]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([total_orders])' />
  </column>
  <column caption='VLOrders_Stacked_si' datatype='integer' name='[Calculation_560768586189590528]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF is_stacked = 1 THEN vlorders ELSE 0 END)' />
  </column>
  <column caption='VLOrders_Stacked_no' datatype='integer' name='[Calculation_560768586189799426]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF is_stacked = 0 THEN vlorders ELSE 0 END)' />
  </column>
  <column caption='Orders Completadas Stacked Si' datatype='integer' name='[Calculation_560768586189987843]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos; AND is_completed=1 AND is_stacked = 1&#10;    THEN total_orders&#10;    ELSE 0&#10;  END )' />
  </column>
  <column caption='Orders Completadas Stacked No' datatype='integer' name='[Calculation_560768586190061572]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos; AND is_completed=1 AND is_stacked = 0&#10;    THEN total_orders&#10;    ELSE 0&#10;  END )' />
  </column>
  <column caption='VL Stacked No (%)' datatype='real' default-format='p0.00%' name='[Calculation_560768586190348293]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL([Calculation_560768586189799426]/[Calculation_560768586190061572],0)' />
  </column>
  <column caption='VL Stacked Si (%)' datatype='real' default-format='p0.00%' name='[Calculation_560768586190471174]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL([Calculation_560768586189590528]/ [Calculation_560768586189987843],0)' />
  </column>
  <column caption='Hold Back Time (HBT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_560768586192429063]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN hold_back_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='To Vendor Time (TVT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_560768586192642056]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN to_vendor_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='At Vendor Time (AVT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_560768586192793609]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN at_vendor_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='To Customer Time (TCT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_560768586192900106]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN to_customer_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='To Dispatch Time (TDT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_560768586193633291]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN to_dispatch_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Accepting Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_560768586193752076]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN rider_acceppting_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Pre Orders (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319762489344]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='Sum( if is_pre_order = 1 AND order_status = &apos;CONFIRMED&apos; then  total_orders else null end)/ SUM(confirmed_orders)' />
  </column>
  <column caption='Confirmed Plus (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319762624513]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF is_plus = 1 THEN confirmed_orders ELSE null END ) / sum(confirmed_orders)' />
  </column>
  <column caption='Rejected' datatype='integer' name='[Calculation_674836319762735106]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([rejected])' />
  </column>
  <column caption='Rejected By Partner' datatype='integer' name='[Calculation_674836319762829315]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([rejected_by_partner])' />
  </column>
  <column caption='Assign Time' datatype='real' name='[Calculation_674836319763599364]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN dispatching_time+ to_dispatch_time+rider_reaction_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Promise Delivery Time (PDT)' datatype='real' name='[Calculation_674836319763898375]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF  order_status=&apos;CONFIRMED&apos;AND is_completed=1 AND is_pre_order = 0&#10;    THEN timing_promised_delivery_time&#10;    ELSE 0&#10;  END )/SUM(IF order_status=&apos;CONFIRMED&apos; AND is_completed=1 AND  is_pre_order = 0&#10;    THEN total_orders&#10;    ELSE 0&#10;  END )' />
  </column>
  <column caption='RL10' datatype='real' default-format='p0.00%' name='[Calculation_674836319764070409]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(if order_status=&apos;CONFIRMED&apos; AND is_completed=1&#10;    THEN rider_late_orders&#10;    ELSE 0&#10;  END ) / [Calculation_145170781959974919]' />
  </column>
  <column caption='RL5' datatype='real' default-format='p0.00%' name='[Calculation_674836319764221964]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF order_status=&apos;CONFIRMED&apos; AND is_completed=1&#10;    THEN rider_late5_orders&#10;    ELSE 0&#10;  END ) / [Calculation_145170781959974919]' />
  </column>
  <column caption='Order Late (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319764451341]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL(SUM(orderlate10_orders) / SUM(orders_completadas),0)' />
  </column>
  <column caption='Seamless (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319764611086]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ifnull(sum( IF delivery_type = &quot;Own Delivery&quot; THEN seamless_order ELSE NULL END )/&#10;sum( IF delivery_type = &quot;Own Delivery&quot; THEN total_orders ELSE NULL END),0)' />
  </column>
  <column caption='Contact Rate (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319764824079]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IFNULL(sum(contact_rate)/sum(total_orders),0)' />
  </column>
  <column caption='Orders Inaccuracy' datatype='integer' name='[Calculation_674836319765041168]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF&#10;     order_status=&apos;CONFIRMED&apos; AND with_logistics = 1 THEN count_orders_inaccuracy&#10;    ELSE 0&#10;    END)' />
  </column>
  <column caption='Confirmed Inaccuracy' datatype='integer' name='[Calculation_674836319765229585]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF  order_status=&apos;CONFIRMED&apos; AND with_logistics = 1 THEN total_orders&#10;    ELSE 0&#10;    END)' />
  </column>
  <column caption='Inexactitud (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319765360658]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_674836319765041168]/ [Calculation_674836319765229585]' />
  </column>
  <column caption='Missing Item' datatype='integer' name='[Calculation_674836319765594131]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(&#10;    IF order_status=&apos;CONFIRMED&apos;AND with_logistics = 1 THEN missing_item_orders&#10;    ELSE 0&#10;    END)' />
  </column>
  <column caption='Missing Item (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319765762068]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_674836319765594131] / [Calculation_674836319765229585]' />
  </column>
  <column caption='Food Quality' datatype='integer' name='[Calculation_674836319765970965]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(if order_status=&apos;CONFIRMED&apos;AND with_logistics = 1 THEN food_quality_orders&#10;    ELSE 0&#10;    END)' />
  </column>
  <column caption='Food Quality (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319766024214]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_674836319765970965] / [Calculation_674836319765229585]' />
  </column>
  <column caption='Wrong Item' datatype='integer' name='[Calculation_674836319766204439]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(&#10;IF &#10;     order_status=&apos;CONFIRMED&apos;AND with_logistics = 1 THEN wrong_item_orders&#10;    ELSE 0&#10;    END)' />
  </column>
  <column caption='Wrong Item (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319766290457]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_674836319766204439] / [Calculation_674836319765229585]' />
  </column>
  <column caption='Wrong Order' datatype='integer' name='[Calculation_674836319766417434]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(&#10;If &#10;    order_status=&apos;CONFIRMED&apos;AND with_logistics = 1 THEN wrong_order_orders&#10;    ELSE 0&#10;    END)' />
  </column>
  <column caption='Wrong Order (%)' datatype='real' default-format='p0.00%' name='[Calculation_674836319766532124]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_674836319766417434] / [Calculation_674836319765229585]' />
  </column>
  <column caption='DO GDIST' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_674836319766646813]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( &#10;    IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN dropoff_distance_google&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Acceptance Rate % (AR)' datatype='real' default-format='p0.00%' name='[Calculation_674836319766802463]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum(transitions_accepted)/SUM(transitions_notifieds)' />
  </column>
  <column caption='AVT Cleaned' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_719379734539210752]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF  &#10;     order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN at_vendor_time_cleaned&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Actual Delivery Time (ADT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_719379734539431937]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF order_status=&apos;CONFIRMED&apos;AND is_completed=1 AND is_pre_order = 0&#10;    THEN actual_delivery_time&#10;    ELSE 0&#10;  END )&#10;/ &#10;SUM( IF order_status=&apos;CONFIRMED&apos; AND is_completed=1 AND is_pre_order = 0&#10;    THEN total_orders&#10;    ELSE 0&#10;  END )' />
  </column>
  <column caption='Pick Up Distance (UP)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_96194137167826944]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN pickup_distance_manhattan&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Dispatching Time (DSP T)' datatype='real' name='[Calculation_96194137168113665]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN dispatching_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Rider Late' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_96194137168375810]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN rider_late&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Updated Preptime (UPT)' datatype='real' name='[Calculation_96194137168551939]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN updated_prep_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='Assumed Prep Time (APT)' datatype='real' name='[Calculation_96194137168695300]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN assumed_actual_preparation_time&#10;    ELSE 0&#10;  END )/sum(assumedOrders)' />
  </column>
  <column caption='At Customer Time (ACT)' datatype='real' name='[Calculation_96194137168908293]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM( IF order_status=&apos;CONFIRMED&apos;AND is_completed=1&#10;    THEN at_customer_time&#10;    ELSE 0&#10;  END )/ [Calculation_145170781959974919]' />
  </column>
  <column caption='OrdenesCompletadasEAHC' datatype='integer' name='[Calculation_96194137169285126]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF order_status=&apos;CONFIRMED&apos; AND is_completed=1 AND is_eahc = 1&#10;    THEN total_orders&#10;    ELSE 0&#10;  END )' />
  </column>
  <column caption='EAHC (%)' datatype='real' name='[Calculation_96194137169362951]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_96194137169285126]/ [Calculation_145170781959974919]' />
  </column>
