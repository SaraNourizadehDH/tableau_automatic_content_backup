      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_91A4FDB3C91540168209BAD2A4372DE9'>
            <properties context=''>
              <relation connection='bigquery.1fa42po0gu1ll31fe43zl1qcq1av' name='partner_survey_scoring' type='text'>WITH &#13;
partner_scoring AS &#13;
(&#13;
    SELECT &#13;
     entityID AS partner_id&#13;
    ,ROUND(CAST(MAX(case when r.key = &apos;rating&apos; then r.value else null end) AS DECIMAL),1) as rating &#13;
    ,MAX(case when r.key = &apos;rating_calculation&apos; then r.value else null end) as rating_calculation&#13;
    ,CAST(MAX(case when r.key = &apos;score_count&apos; then r.value else null end) AS INT64) as score_count&#13;
&#13;
    FROM `peya-delivery-and-support.automated_tables_reports.partner_survey_scoring` &#13;
    JOIN UNNEST(rating) r &#13;
    GROUP BY 1&#13;
)&#13;
&#13;
&#13;
select &#13;
 r2.partner_id&#13;
,r2.partner_name&#13;
,business_type.business_type_name as business_name&#13;
,country.country_name&#13;
,city.name as city_name&#13;
,franchise.franchise_name	&#13;
&#13;
,rating &#13;
,rating_calculation&#13;
,score_count&#13;
&#13;
from partner_scoring r1 &#13;
join `peya-bi-tools-pro.il_core.dim_partner` r2 ON r1.partner_id = r2.partner_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
