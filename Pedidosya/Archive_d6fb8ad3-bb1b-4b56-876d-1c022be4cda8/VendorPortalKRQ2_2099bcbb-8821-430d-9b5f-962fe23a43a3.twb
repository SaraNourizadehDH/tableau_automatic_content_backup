    <worksheet name='Partes con eventos en menu'>
      <table>
        <view>
          <datasources>
            <datasource caption='Eventos por plugin' name='federated.00cslcy0kru7rl1gjfm0z1v2a2w6' />
            <datasource caption='nivel partner id qc&amp;food' name='federated.166io4d1na5wq81e1ude61supizx' />
          </datasources>
          <datasource-dependencies datasource='federated.00cslcy0kru7rl1gjfm0z1v2a2w6'>
            <column caption='Partner con eventos' datatype='integer' name='[Calculation_1547268002887323648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD(iif([plugin_portal]!= &apos;Nulo&apos; ,[partner_id],NULL))' />
            </column>
            <column caption='Share de partners con eventos' datatype='real' name='[Calculation_1547268002887454721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1547268002887323648]/[federated.166io4d1na5wq81e1ude61supizx].[Calculation_1258756153600741376])*100' />
            </column>
            <column caption='Promedio de eventos  por partner  con eventos' datatype='real' name='[Calculation_1987776315233865729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([event_action])/CountD(iif([plugin_portal]!= &apos;Nulo&apos; ,[partner_id],NULL))' />
            </column>
            <column caption='Active Month' datatype='date' name='[active_month]' role='dimension' type='ordinal' />
            <column-instance column='[partner_id]' derivation='CountD' name='[ctd:partner_id:qk]' pivot='key' type='quantitative' />
            <column caption='Event Action' datatype='string' name='[event_action]' role='dimension' type='nominal' />
            <column-instance column='[event_action]' derivation='None' name='[none:event_action:nk]' pivot='key' type='nominal' />
            <column-instance column='[plugin_portal]' derivation='None' name='[none:plugin_portal:nk]' pivot='key' type='nominal' />
            <column caption='Partner Id' datatype='integer' name='[partner_id]' role='dimension' type='ordinal' />
            <column caption='Plugin Portal' datatype='string' name='[plugin_portal]' role='dimension' type='nominal' />
            <column-instance column='[active_month]' derivation='Month-Trunc' name='[tmn:active_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1547268002887454721]' derivation='User' name='[usr:Calculation_1547268002887454721:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1987776315233865729]' derivation='User' name='[usr:Calculation_1987776315233865729:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.166io4d1na5wq81e1ude61supizx'>
            <column caption='Partners con visitas' datatype='integer' name='[Calculation_1258756153600741376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IIF([active_partners_with_sessions_low_band]=1,[partner_id],NULL))' />
