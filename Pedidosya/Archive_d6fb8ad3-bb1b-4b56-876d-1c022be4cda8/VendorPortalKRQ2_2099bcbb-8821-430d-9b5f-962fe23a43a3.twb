      <column caption='Adoption (copia 2)' datatype='real' name='[Adoption (copia 2)_1454662731261984768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Partners con visitas (copia)_1454662731262074881]/count([partner_id]))*100' />
      </column>
      <column caption='VFR_v2' datatype='real' name='[Calculation_1153484463069503488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([non_confirmed_orders])/sum([total_orders]))*100' />
      </column>
      <column caption='Partners con visitas' datatype='integer' name='[Calculation_1258756153600741376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IIF([active_partners_with_sessions_low_band]=1,[partner_id],NULL))' />
