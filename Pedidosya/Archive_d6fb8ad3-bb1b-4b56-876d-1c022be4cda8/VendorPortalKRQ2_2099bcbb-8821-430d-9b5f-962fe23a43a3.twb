    <worksheet name='Variacion Adoption Mercad'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='nivel partner id qc&amp;food' name='federated.166io4d1na5wq81e1ude61supizx' />
            <datasource caption='Consulta_SQL_personalizada (user_tomas_mir) (5)' name='federated.1jn9m0c0gnx2va1gwmtux15ic64c' />
          </datasources>
          <datasource-dependencies datasource='federated.166io4d1na5wq81e1ude61supizx'>
            <column datatype='string' name='[AM]' role='dimension' type='nominal' />
            <column caption='Partners con visitas' datatype='integer' name='[Calculation_1258756153600741376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IIF([active_partners_with_sessions_low_band]=1,[partner_id],NULL))' />
            </column>
            <column caption='Adoption' datatype='real' name='[Calculation_1258756153602297857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1258756153600741376]/count([partner_id]))*100' />
            </column>
            <column datatype='string' name='[Status]' role='dimension' type='nominal' />
            <column datatype='date' name='[active_month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[active_partners_with_sessions_low_band]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[is_ka]' role='dimension' type='nominal' />
            <column-instance column='[AM]' derivation='None' name='[none:AM:nk]' pivot='key' type='nominal' />
