      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_EF007DE2D80548D4A6EE21E705FF44A1'>
            <properties context=''>
              <relation connection='bigquery.0ifv0bu199givp184lq921ohadqt' name='Consulta SQL personalizada' type='text'>WITH sessions_by_month_and_country_total AS (&#13;
  SELECT&#13;
    DATE_TRUNC(DATE(session_date), MONTH) session_month,&#13;
    vp.session_country,&#13;
    Case &#13;
  when o.business_type_id =1 then &apos;Food&apos;&#13;
  when o.business_type_id =7 then &apos;Food&apos;&#13;
  else &apos;QC&apos;&#13;
  end vertical,&#13;
    COUNT(DISTINCT vp.vendor_id) partners_with_sessions,&#13;
    COUNT(DISTINCT CASE WHEN o.restaurant_id IS NOT NULL THEN vp.vendor_id END) active_partners_with_sessions&#13;
  FROM `peya-data-origins-pro.cl_vendor_portal.vp_vendor_sessions` vp&#13;
&#13;
  LEFT JOIN (&#13;
   &#13;
    SELECT&#13;
      DATE_TRUNC(registered_date, MONTH) active_month,&#13;
      CASE country.country_name&#13;
        WHEN &apos;República Dominicana&apos; THEN &apos;Dominican Republic&apos;&#13;
        WHEN &apos;Panamá&apos; THEN &apos;Panama&apos;&#13;
        WHEN &apos;Perú&apos; THEN &apos;Peru&apos;&#13;
        ELSE country.country_name&#13;
      END country_name,&#13;
      business_type_id,&#13;
      restaurant.id restaurant_id&#13;
    FROM `peya-bi-tools-pro.il_core.fact_orders`&#13;
    WHERE registered_date &gt;&gt;= &apos;2022-05-01&apos;&#13;
      AND business_type_id not IN (9,11)&#13;
      and restaurant.name not LIKE &apos;%PedidosYa%&apos;&#13;
    and restaurant.name not LIKE &apos;%Pedidosya%&apos;&#13;
      and UPPER(order_status) = &apos;CONFIRMED&apos;&#13;
  ) o ON o.active_month = DATE_TRUNC(DATE(session_date), MONTH)&#13;
     AND LOWER(o.country_name) = LOWER(vp.session_country)&#13;
     AND o.restaurant_id = SAFE_CAST(vendor_id AS INT64)&#13;
&#13;
  WHERE DATE(vp.session_date) &gt;&gt;= &apos;2022-05-01&apos;&#13;
    AND vp.session_country IN (&apos;Argentina&apos;,&apos;Bolivia&apos;,&apos;Chile&apos;,&apos;Costa Rica&apos;,&apos;Ecuador&apos;,&apos;El Salvador&apos;,&apos;Guatemala&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;,&apos;Panama&apos;,&apos;Paraguay&apos;,&apos;Peru&apos;,&apos;Dominican Republic&apos;,&apos;Uruguay&apos;,&apos;Venezuela&apos;)&#13;
  GROUP BY 1,2,3&#13;
  ORDER BY 1 DESC, 2&#13;
),&#13;
sessions_by_month_and_country AS (&#13;
  SELECT&#13;
    DATE_TRUNC(DATE(session_date), MONTH) session_month,&#13;
    page_visits.page_name,&#13;
    vp.session_country,&#13;
     Case &#13;
  when o.business_type_id =1 then &apos;Food&apos;&#13;
  when o.business_type_id =7 then &apos;Food&apos;&#13;
  else &apos;QC&apos;&#13;
  end vertical_2,&#13;
    COUNT(DISTINCT vp.vendor_id) partners_with_sessions,&#13;
    COUNT(DISTINCT CASE WHEN o.restaurant_id IS NOT NULL THEN vp.vendor_id END) active_partners_with_sessions&#13;
  FROM `peya-data-origins-pro.cl_vendor_portal.vp_vendor_sessions` vp,&#13;
  UNNEST(vp.page_visits) page_visits&#13;
&#13;
  LEFT JOIN (&#13;
    SELECT&#13;
      DATE_TRUNC(registered_date, MONTH) active_month,&#13;
      CASE country.country_name&#13;
        WHEN &apos;República Dominicana&apos; THEN &apos;Dominican Republic&apos;&#13;
        WHEN &apos;Panamá&apos; THEN &apos;Panama&apos;&#13;
        WHEN &apos;Perú&apos; THEN &apos;Peru&apos;&#13;
        ELSE country.country_name&#13;
      END country_name,&#13;
      business_type_id,&#13;
      restaurant.id restaurant_id&#13;
    FROM `peya-bi-tools-pro.il_core.fact_orders`&#13;
    WHERE registered_date &gt;&gt;= &apos;2022-05-01&apos;&#13;
      AND business_type_id not IN (9,11)&#13;
      and restaurant.name not LIKE &apos;%PedidosYa%&apos;&#13;
    and restaurant.name not LIKE &apos;%Pedidosya%&apos;&#13;
      and UPPER(order_status) = &apos;CONFIRMED&apos;&#13;
  ) o ON o.active_month = DATE_TRUNC(DATE(session_date), MONTH)&#13;
     AND LOWER(o.country_name) = LOWER(vp.session_country)&#13;
     AND o.restaurant_id = SAFE_CAST(vendor_id AS INT64)&#13;
&#13;
  WHERE DATE(vp.session_date) &gt;&gt;= &apos;2022-05-01&apos;&#13;
    AND vp.session_country IN (&apos;Argentina&apos;,&apos;Bolivia&apos;,&apos;Chile&apos;,&apos;Costa Rica&apos;,&apos;Ecuador&apos;,&apos;El Salvador&apos;,&apos;Guatemala&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;,&apos;Panama&apos;,&apos;Paraguay&apos;,&apos;Peru&apos;,&apos;Dominican Republic&apos;,&apos;Uruguay&apos;,&apos;Venezuela&apos;)&#13;
  GROUP BY 1,2,3,4&#13;
  ORDER BY 1 DESC, 2&#13;
)&#13;
&#13;
SELECT&#13;
  s.session_month,&#13;
  a.session_country,&#13;
  s.vertical_2,&#13;
  a.vertical,&#13;
  s.page_name,&#13;
  SUM(s.active_partners_with_sessions) active_partners_with_sessions,&#13;
  SUM(a.active_partners_with_sessions) active_partners_total_with_sessions,&#13;
  ROUND(100.0 * SAFE_DIVIDE(SUM(s.active_partners_with_sessions), SUM(a.active_partners_with_sessions)), 1) KPI_adoption&#13;
FROM sessions_by_month_and_country s&#13;
&#13;
LEFT JOIN sessions_by_month_and_country_total a &#13;
       ON a.session_month = s.session_month&#13;
      AND LOWER(a.session_country) = LOWER(s.session_country)&#13;
where s.vertical_2=a.vertical&#13;
GROUP BY 1,2,3,4,5&#13;
ORDER BY 1 DESC, 2, 3</relation>
            </properties>
