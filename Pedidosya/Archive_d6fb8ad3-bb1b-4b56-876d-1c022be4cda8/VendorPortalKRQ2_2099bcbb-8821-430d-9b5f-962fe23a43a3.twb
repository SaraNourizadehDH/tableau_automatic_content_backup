              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='nivel partner id qc&amp;food' inline='true' name='federated.166io4d1na5wq81e1ude61supizx' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.01u7js60t32l4z15k0iub1qk6asv'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_tomas_mir' server-oauth='' username='jose.amondarain@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.01u7js60t32l4z15k0iub1qk6asv' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dates AS (
  SELECT
    DATE('2022-05-01') start_date,
    CURRENT_DATE before_date
),
active_partners_food AS (
  SELECT DISTINCT
    DATE_TRUNC(registered_date, MONTH) date_month,
    country_id,
    restaurant.id partner_id,
    COUNT(DISTINCT restaurant.id) active_partners
  FROM `peya-bi-tools-pro.il_core.fact_orders`

  WHERE registered_date >>= (SELECT start_date FROM dates)
    AND registered_date << (SELECT before_date FROM dates)
    AND order_status = 'CONFIRMED'
    AND business_type_id not IN (9,11)
      and restaurant.name not LIKE '%PedidosYa%'
    and restaurant.name not LIKE '%Pedidosya%'
  Group by 1,2,3
),
orders_by_partner AS (
  SELECT
    DATE_TRUNC(registered_date, MONTH) date_month,
    country_id,
    restaurant.id partner_id,
    COUNT(DISTINCT order_id) total_orders,
    COUNT(DISTINCT CASE WHEN order_status = 'CONFIRMED' THEN order_id END) confirmed_orders,
    COUNT(DISTINCT CASE WHEN order_status != 'CONFIRMED' THEN order_id END) non_confirmed_orders,
    COUNT(DISTINCT CASE WHEN order_status != 'CONFIRMED' AND fail_rate_owner = 'Restaurant' THEN order_id END) non_confirmed_orders_vendor
  FROM `peya-bi-tools-pro.il_core.fact_orders`

  WHERE registered_date >>= (SELECT start_date FROM dates)
    AND registered_date << (SELECT before_date FROM dates)
    AND business_type_id not IN (9,11)
      and restaurant.name not LIKE '%PedidosYa%'
    and restaurant.name not LIKE '%Pedidosya%'

  GROUP BY 1,2,3
),
sessions_by_partner AS (
  SELECT
    DATE_TRUNC(DATE(vp.session_date), MONTH) date_month,
    dc.country_id,
    SAFE_CAST(vp.vendor_id AS INT64) partner_id,
    COUNT(DISTINCT vp.vendor_id) partners_with_sessions,
    
    COUNT(DISTINCT vp.session_id) qty_sesiones
  FROM `peya-data-origins-pro.cl_vendor_portal.vp_vendor_sessions` vp

  LEFT JOIN (
    SELECT
      CASE 
        WHEN country_name = 'República Dominicana' THEN 'Dominican Republic'
        WHEN country_name = 'Panamá' THEN 'Panama'
        WHEN country_name = 'Perú' THEN 'Peru'
        ELSE country_name
      END country_name,
      country_id
    FROM `peya-bi-tools-pro.il_core.dim_country`
  ) dc ON dc.country_name = vp.session_country

  WHERE DATE(vp.session_date) >>= (SELECT start_date FROM dates)
    AND DATE(vp.session_date) << (SELECT before_date FROM dates)
    AND vp.session_country IN ('Argentina','Bolivia','Chile','Costa Rica','Ecuador','El Salvador','Guatemala','Honduras','Nicaragua','Panama','Paraguay','Peru','Dominican Republic','Uruguay','Venezuela')
  GROUP BY 1,2,3
),
partner_data AS (
  SELECT 
    * 
  FROM (
    SELECT 
      *, 
      ROW_NUMBER() OVER (PARTITION BY date_month, country_id, partner_id ORDER BY yyyymmdd DESC) row_num 
    FROM (
      SELECT DISTINCT
        DATE_TRUNC(DATE(hp.full_date), MONTH) date_month,
        hp.yyyymmdd,
        hp.country_id,
        hp.restaurant_id partner_id,
        online.first_date_online first_date_online,
        CASE 
          WHEN DATE_DIFF(DATE_TRUNC(DATE(hp.full_date), MONTH), online.first_date_online, day) << 31 THEN 'New Partner'
          WHEN DATE_DIFF(DATE_TRUNC(DATE(hp.full_date), MONTH), online.first_date_online, day) >>= 31 THEN 'Existing' 
         
        END status,
        account_owner,
        is_important_account is_ka,
        business_name,
        reception_system_name,
        salesforce_id
      FROM `peya-bi-tools-pro.il_core.dim_historical_partners` hp

      LEFT JOIN (
       
        SELECT
          restaurant_id partner_id,
          MAX(first_date_online) first_date_online
        FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dp
        WHERE DATE(yyyymmdd) >>= (SELECT start_date FROM dates)
          AND DATE(yyyymmdd) << CURRENT_DATE
        GROUP BY 1
      ) online ON online.partner_id = hp.restaurant_id

      WHERE DATE(yyyymmdd) >>= (SELECT start_date FROM dates)
        AND DATE(yyyymmdd) << (SELECT before_date FROM dates)
    )
  ) WHERE row_num = 1
),
salesforce_data AS (
  SELECT 
    * 
  FROM (
    SELECT 
      *, 
      ROW_NUMBER() OVER (PARTITION BY partner_id ORDER BY last_activity_date DESC) row_num
    FROM (
      SELECT
        
        dp.partner_id partner_id,
        account_source,
        city.name nombre_ciudad,
        key_vip_account is_ka,
        CASE long_tail_segmentation
          WHEN 'A1' THEN 'A'
          WHEN 'A2' THEN 'A'
          WHEN 'B1' THEN 'B'
          WHEN 'B2' THEN 'B'
          WHEN 'C1'THEN 'C'
          WHEN 'C2'THEN 'C'
          WHEN 'C3'THEN 'C'
          WHEN 'D1'THEN 'D'
          WHEN 'D2'THEN 'D'
          WHEN 'D3'THEN 'D'
          ELSE long_tail_segmentation
        END long_tail_segmentation_fixed,
        key_account_sub_category,
        CASE key_account_sub_category
        WHEN 'Global KA' THEN 'Key Account'
          WHEN 'Large Chain' THEN 'Key Account'
          WHEN 'Local Hero' THEN 'Key Account'
          WHEN 'National KA' THEN 'Key Account'
          ELSE "Long tail"
          end is_ka_v2,
        last_activity_date
      FROM `peya-bi-tools-pro.il_salesforce.dim_salesforce_account` sf
      LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
       ON dp.salesforce_id = sf.account_grid

    )
  ) WHERE row_num = 1
), cases as (
  SELECT 
 DATE_TRUNC(Fecha, MONTH) date_month,
partner_id
, IfNULL(SUM(Chats),0) 
    + IFNULL(SUM(Casos),0)
    + IFNULL(SUM(Casos_offline),0)
    + IFNULL(SUM(Llamadas),0)
    - IFNULL(SUM(Escalados),0) AS Contactos
 FROM `peya-delivery-and-support.automated_tables_reports.contacts_by_partners` 
 
 WHERE Fecha >>= (SELECT start_date FROM dates)
 AND Fecha << (SELECT before_date FROM dates)
 

 GROUP BY 1,2
)

SELECT
  ap.date_month active_month,
  dc.country_name country_name,
  ap.partner_id partner_id,


  dp.partner_name nombre_rest,
  pd.status Status,
  pd.account_owner AM,
  COALESCE(sf.is_ka, pd.is_ka) AS is_ka,
  pd.business_name vertical,
Case 
  when pd.business_name ='Coffee' then 'Food'
  when pd.business_name ='Restaurant'then 'Food'
  else 'QC'
  end vertical_2,
  pd.reception_system_name sist_recep,
  pd.first_date_online,


  
  sf.long_tail_segmentation_fixed lt_seg,
  sf.key_account_sub_category ka_seg,
  sf.is_ka_v2 is_ka_v2,
  sf.account_source,
  sf.nombre_ciudad ciudad,

  obp.total_orders,
  obp.confirmed_orders,
  
  obp.non_confirmed_orders_vendor non_confirmed_orders,


  sbp.qty_sesiones,
  CASE 
    WHEN sbp.qty_sesiones IS NULL THEN 'No tiene sesiones'
    WHEN sbp.qty_sesiones = 1 THEN 'Una sesión'
    WHEN sbp.qty_sesiones >> 1 AND sbp.qty_sesiones << 3 THEN 'Entre 2 y 3'
    WHEN sbp.qty_sesiones >>= 3 AND sbp.qty_sesiones << 5 THEN 'Entre 3 y 5'
    WHEN sbp.qty_sesiones >>= 5 AND sbp.qty_sesiones << 10 THEN 'Entre 5 y 10'
    ELSE 'Más de 10'
  END cant_sesiones,
  CASE WHEN sbp.partner_id IS NOT NULL THEN 1 END active_partners_with_sessions_low_band,
  CASE WHEN sbp.partner_id IS NOT NULL THEN 1 END partners_with_sessions,
  hi.partners_with_sessions active_partners_high_band,
  If(hi.partners_with_sessions is null,0,1) high_band_sessions, 
  ca.Contactos,
   mp.menu_id,
  case
  when mp.partnerID is not null then 'Si'
  else 'No'
  end menu_compartido

FROM active_partners_food ap

LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc
       ON dc.country_id = ap.country_id

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
       ON dp.partner_id = ap.partner_id

LEFT JOIN orders_by_partner obp
       ON obp.date_month = ap.date_month
      AND obp.country_id = ap.country_id
      AND obp.partner_id = ap.partner_id

LEFT JOIN sessions_by_partner sbp
       ON sbp.date_month = ap.date_month
      AND sbp.country_id = ap.country_id
      AND sbp.partner_id = ap.partner_id

LEFT JOIN partner_data pd
       ON pd.date_month = ap.date_month
      AND pd.country_id = ap.country_id
      AND pd.partner_id = ap.partner_id

LEFT JOIN salesforce_data sf
       ON sf.partner_id = ap.partner_id

LEFT JOIN cases ca
       ON ca.partner_id = ap.partner_id
       and ca.date_month = ap.date_month
left join `peya-delivery-and-support.automated_tables_reports.partners_con_mp_vp` mp
on mp.partnerID=ap.partner_id


Left join `peya-delivery-and-support.automated_tables_reports.high_band_vp` hi
 ON hi.date_month = ap.date_month
 and hi.partner_id=ap.partner_id

where pd.status IS NOT NULL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.01u7js60t32l4z15k0iub1qk6asv' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dates AS (
  SELECT
    DATE('2022-05-01') start_date,
    CURRENT_DATE before_date
),
active_partners_food AS (
  SELECT DISTINCT
    DATE_TRUNC(registered_date, MONTH) date_month,
    country_id,
    restaurant.id partner_id,
    COUNT(DISTINCT restaurant.id) active_partners
  FROM `peya-bi-tools-pro.il_core.fact_orders`

  WHERE registered_date >>= (SELECT start_date FROM dates)
    AND registered_date << (SELECT before_date FROM dates)
    AND order_status = 'CONFIRMED'
    AND business_type_id not IN (9,11)
      and restaurant.name not LIKE '%PedidosYa%'
    and restaurant.name not LIKE '%Pedidosya%'
  Group by 1,2,3
),
orders_by_partner AS (
  SELECT
    DATE_TRUNC(registered_date, MONTH) date_month,
    country_id,
    restaurant.id partner_id,
    COUNT(DISTINCT order_id) total_orders,
    COUNT(DISTINCT CASE WHEN order_status = 'CONFIRMED' THEN order_id END) confirmed_orders,
    COUNT(DISTINCT CASE WHEN order_status != 'CONFIRMED' THEN order_id END) non_confirmed_orders,
    COUNT(DISTINCT CASE WHEN order_status != 'CONFIRMED' AND fail_rate_owner = 'Restaurant' THEN order_id END) non_confirmed_orders_vendor
  FROM `peya-bi-tools-pro.il_core.fact_orders`

  WHERE registered_date >>= (SELECT start_date FROM dates)
    AND registered_date << (SELECT before_date FROM dates)
    AND business_type_id not IN (9,11)
      and restaurant.name not LIKE '%PedidosYa%'
    and restaurant.name not LIKE '%Pedidosya%'

  GROUP BY 1,2,3
),
sessions_by_partner AS (
  SELECT
    DATE_TRUNC(DATE(vp.session_date), MONTH) date_month,
    dc.country_id,
    SAFE_CAST(vp.vendor_id AS INT64) partner_id,
    COUNT(DISTINCT vp.vendor_id) partners_with_sessions,
    
    COUNT(DISTINCT vp.session_id) qty_sesiones
  FROM `peya-data-origins-pro.cl_vendor_portal.vp_vendor_sessions` vp

  LEFT JOIN (
    SELECT
      CASE 
        WHEN country_name = 'República Dominicana' THEN 'Dominican Republic'
        WHEN country_name = 'Panamá' THEN 'Panama'
        WHEN country_name = 'Perú' THEN 'Peru'
        ELSE country_name
      END country_name,
      country_id
    FROM `peya-bi-tools-pro.il_core.dim_country`
  ) dc ON dc.country_name = vp.session_country

  WHERE DATE(vp.session_date) >>= (SELECT start_date FROM dates)
    AND DATE(vp.session_date) << (SELECT before_date FROM dates)
    AND vp.session_country IN ('Argentina','Bolivia','Chile','Costa Rica','Ecuador','El Salvador','Guatemala','Honduras','Nicaragua','Panama','Paraguay','Peru','Dominican Republic','Uruguay','Venezuela')
  GROUP BY 1,2,3
),
partner_data AS (
  SELECT 
    * 
  FROM (
    SELECT 
      *, 
      ROW_NUMBER() OVER (PARTITION BY date_month, country_id, partner_id ORDER BY yyyymmdd DESC) row_num 
    FROM (
      SELECT DISTINCT
        DATE_TRUNC(DATE(hp.full_date), MONTH) date_month,
        hp.yyyymmdd,
        hp.country_id,
        hp.restaurant_id partner_id,
        online.first_date_online first_date_online,
        CASE 
          WHEN DATE_DIFF(DATE_TRUNC(DATE(hp.full_date), MONTH), online.first_date_online, day) << 31 THEN 'New Partner'
          WHEN DATE_DIFF(DATE_TRUNC(DATE(hp.full_date), MONTH), online.first_date_online, day) >>= 31 THEN 'Existing' 
         
        END status,
        account_owner,
        is_important_account is_ka,
        business_name,
        reception_system_name,
        salesforce_id
      FROM `peya-bi-tools-pro.il_core.dim_historical_partners` hp

      LEFT JOIN (
       
        SELECT
          restaurant_id partner_id,
          MAX(first_date_online) first_date_online
        FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dp
        WHERE DATE(yyyymmdd) >>= (SELECT start_date FROM dates)
          AND DATE(yyyymmdd) << CURRENT_DATE
        GROUP BY 1
      ) online ON online.partner_id = hp.restaurant_id

      WHERE DATE(yyyymmdd) >>= (SELECT start_date FROM dates)
        AND DATE(yyyymmdd) << (SELECT before_date FROM dates)
    )
  ) WHERE row_num = 1
),
salesforce_data AS (
  SELECT 
    * 
  FROM (
    SELECT 
      *, 
      ROW_NUMBER() OVER (PARTITION BY partner_id ORDER BY last_activity_date DESC) row_num
    FROM (
      SELECT
        
        dp.partner_id partner_id,
        account_source,
        city.name nombre_ciudad,
        key_vip_account is_ka,
        CASE long_tail_segmentation
          WHEN 'A1' THEN 'A'
          WHEN 'A2' THEN 'A'
          WHEN 'B1' THEN 'B'
          WHEN 'B2' THEN 'B'
          WHEN 'C1'THEN 'C'
          WHEN 'C2'THEN 'C'
          WHEN 'C3'THEN 'C'
          WHEN 'D1'THEN 'D'
          WHEN 'D2'THEN 'D'
          WHEN 'D3'THEN 'D'
          ELSE long_tail_segmentation
        END long_tail_segmentation_fixed,
        key_account_sub_category,
        CASE key_account_sub_category
        WHEN 'Global KA' THEN 'Key Account'
          WHEN 'Large Chain' THEN 'Key Account'
          WHEN 'Local Hero' THEN 'Key Account'
          WHEN 'National KA' THEN 'Key Account'
          ELSE "Long tail"
          end is_ka_v2,
        last_activity_date
      FROM `peya-bi-tools-pro.il_salesforce.dim_salesforce_account` sf
      LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
       ON dp.salesforce_id = sf.account_grid

    )
  ) WHERE row_num = 1
), cases as (
  SELECT 
 DATE_TRUNC(Fecha, MONTH) date_month,
partner_id
, IfNULL(SUM(Chats),0) 
    + IFNULL(SUM(Casos),0)
    + IFNULL(SUM(Casos_offline),0)
    + IFNULL(SUM(Llamadas),0)
    - IFNULL(SUM(Escalados),0) AS Contactos
 FROM `peya-delivery-and-support.automated_tables_reports.contacts_by_partners` 
 
 WHERE Fecha >>= (SELECT start_date FROM dates)
 AND Fecha << (SELECT before_date FROM dates)
 

 GROUP BY 1,2
)

SELECT
  ap.date_month active_month,
  dc.country_name country_name,
  ap.partner_id partner_id,


  dp.partner_name nombre_rest,
  pd.status Status,
  pd.account_owner AM,
  COALESCE(sf.is_ka, pd.is_ka) AS is_ka,
  pd.business_name vertical,
Case 
  when pd.business_name ='Coffee' then 'Food'
  when pd.business_name ='Restaurant'then 'Food'
  else 'QC'
  end vertical_2,
  pd.reception_system_name sist_recep,
  pd.first_date_online,


  
  sf.long_tail_segmentation_fixed lt_seg,
  sf.key_account_sub_category ka_seg,
  sf.is_ka_v2 is_ka_v2,
  sf.account_source,
  sf.nombre_ciudad ciudad,

  obp.total_orders,
  obp.confirmed_orders,
  
  obp.non_confirmed_orders_vendor non_confirmed_orders,


  sbp.qty_sesiones,
  CASE 
    WHEN sbp.qty_sesiones IS NULL THEN 'No tiene sesiones'
    WHEN sbp.qty_sesiones = 1 THEN 'Una sesión'
    WHEN sbp.qty_sesiones >> 1 AND sbp.qty_sesiones << 3 THEN 'Entre 2 y 3'
    WHEN sbp.qty_sesiones >>= 3 AND sbp.qty_sesiones << 5 THEN 'Entre 3 y 5'
    WHEN sbp.qty_sesiones >>= 5 AND sbp.qty_sesiones << 10 THEN 'Entre 5 y 10'
    ELSE 'Más de 10'
  END cant_sesiones,
  CASE WHEN sbp.partner_id IS NOT NULL THEN 1 END active_partners_with_sessions_low_band,
  CASE WHEN sbp.partner_id IS NOT NULL THEN 1 END partners_with_sessions,
  hi.partners_with_sessions active_partners_high_band,
  If(hi.partners_with_sessions is null,0,1) high_band_sessions, 
  ca.Contactos,
   mp.menu_id,
  case
  when mp.partnerID is not null then 'Si'
  else 'No'
  end menu_compartido

FROM active_partners_food ap

LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc
       ON dc.country_id = ap.country_id

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
       ON dp.partner_id = ap.partner_id

LEFT JOIN orders_by_partner obp
       ON obp.date_month = ap.date_month
      AND obp.country_id = ap.country_id
      AND obp.partner_id = ap.partner_id

LEFT JOIN sessions_by_partner sbp
       ON sbp.date_month = ap.date_month
      AND sbp.country_id = ap.country_id
      AND sbp.partner_id = ap.partner_id

LEFT JOIN partner_data pd
       ON pd.date_month = ap.date_month
      AND pd.country_id = ap.country_id
      AND pd.partner_id = ap.partner_id

LEFT JOIN salesforce_data sf
       ON sf.partner_id = ap.partner_id

LEFT JOIN cases ca
       ON ca.partner_id = ap.partner_id
       and ca.date_month = ap.date_month
left join `peya-delivery-and-support.automated_tables_reports.partners_con_mp_vp` mp
on mp.partnerID=ap.partner_id


Left join `peya-delivery-and-support.automated_tables_reports.high_band_vp` hi
 ON hi.date_month = ap.date_month
 and hi.partner_id=ap.partner_id

where pd.status IS NOT NULL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
