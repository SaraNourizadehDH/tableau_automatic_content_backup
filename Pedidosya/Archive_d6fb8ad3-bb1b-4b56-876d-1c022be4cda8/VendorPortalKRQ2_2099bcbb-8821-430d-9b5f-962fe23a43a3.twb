            <column-instance column='[active_month]' derivation='Month-Trunc' name='[tmn:active_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1547268002887323648]' derivation='User' name='[usr:Calculation_1547268002887323648:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1547268002887454721]' derivation='User' name='[usr:Calculation_1547268002887454721:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1987776315233865729]' derivation='User' name='[usr:Calculation_1987776315233865729:qk]' pivot='key' type='quantitative' />
