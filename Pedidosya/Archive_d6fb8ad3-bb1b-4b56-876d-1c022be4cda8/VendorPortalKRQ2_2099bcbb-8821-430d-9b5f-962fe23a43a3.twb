        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vwnfsd0lwvwgl14dtqus1fwwgkc' name='Consulta SQL personalizada' type='text'>with users as(&#13;
  SELECT&#13;
  vp.country as country,&#13;
  v.role as rol,&#13;
  vp.email as email,&#13;
    case &#13;
  when REGEXP_CONTAINS(LOWER(vp.email), r&apos;@pedidosya.com&apos;) then &apos;PeYa&apos;&#13;
  else &apos;Partner&apos;&#13;
  end mail,&#13;
  vp.user_id as user_id,&#13;
  SAFE_CAST(v.vendor_id AS INT64) partner_id,&#13;
  vp.phone_number as phone,&#13;
  vp.updated_at as last_update,&#13;
  date(vp.updated_at) dia,&#13;
  DATE_TRUNC((vp.updated_at), MONTH) last_session_month,&#13;
FROM `peya-data-origins-pro.cl_vendor_portal.vp_users` vp&#13;
LEFT JOIN UNNEST(vendors) v&#13;
&#13;
WHERE v.vendor_id IS NOT NULL&#13;
and vp.country in (&apos;AR&apos;,&apos;CL&apos;,&apos;NI&apos;,&apos;HN&apos;,&apos;PA&apos;,&apos;PE&apos;,&apos;CR&apos;,&apos;SV&apos;,&apos;UY&apos;,&apos;PY&apos;,&apos;EC&apos;,&apos;GT&apos;,&apos;BO&apos;,&apos;VE&apos;,&apos;DO&apos;)&#13;
and vp.is_deleted = false&#13;
&#13;
GROUP BY 1,2,3,4,5,6,7,8&#13;
),salesforce_data AS (&#13;
  SELECT &#13;
    * &#13;
  FROM (&#13;
    SELECT &#13;
      *, &#13;
      ROW_NUMBER() OVER (PARTITION BY partner_id ORDER BY last_activity_date DESC) row_num&#13;
    FROM (&#13;
      SELECT&#13;
        &#13;
        dp.partner_id partner_id,&#13;
        account_source,&#13;
        city.name nombre_ciudad,&#13;
        account_status status,&#13;
        key_vip_account is_ka,&#13;
        CASE long_tail_segmentation&#13;
          WHEN &apos;A1&apos; THEN &apos;A&apos;&#13;
          WHEN &apos;A2&apos; THEN &apos;A&apos;&#13;
          WHEN &apos;B1&apos; THEN &apos;B&apos;&#13;
          WHEN &apos;B2&apos; THEN &apos;B&apos;&#13;
          WHEN &apos;C1&apos;THEN &apos;C&apos;&#13;
          WHEN &apos;C2&apos;THEN &apos;C&apos;&#13;
          WHEN &apos;C3&apos;THEN &apos;C&apos;&#13;
          WHEN &apos;D1&apos;THEN &apos;D&apos;&#13;
          WHEN &apos;D2&apos;THEN &apos;D&apos;&#13;
          WHEN &apos;D3&apos;THEN &apos;D&apos;&#13;
          ELSE long_tail_segmentation&#13;
        END long_tail_segmentation_fixed,&#13;
        key_account_sub_category,&#13;
        CASE key_account_sub_category&#13;
        WHEN &apos;Global KA&apos; THEN &apos;Key Account&apos;&#13;
          WHEN &apos;Large Chain&apos; THEN &apos;Key Account&apos;&#13;
          WHEN &apos;Local Hero&apos; THEN &apos;Key Account&apos;&#13;
          WHEN &apos;National KA&apos; THEN &apos;Key Account&apos;&#13;
          ELSE &quot;Long tail&quot;&#13;
          end is_ka_v2,&#13;
        last_activity_date&#13;
      FROM `peya-bi-tools-pro.il_salesforce.dim_salesforce_account` sf&#13;
      LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp&#13;
       ON dp.salesforce_id = sf.account_grid&#13;
&#13;
    )&#13;
  ) WHERE row_num = 1&#13;
)&#13;
SELECT&#13;
us.country as country,&#13;
  us.rol as rol,&#13;
  us.email as email,&#13;
   us.mail,&#13;
  us.user_id as user_id,&#13;
  us.partner_id as partner_id,&#13;
  us.phone as phone,&#13;
  us.last_update as last_update,&#13;
  us.last_session_month,&#13;
  us.dia,&#13;
  sf.status&#13;
from users us&#13;
left join salesforce_data sf on&#13;
sf.partner_id=us.partner_id&#13;
and sf.status =&apos;Active&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
