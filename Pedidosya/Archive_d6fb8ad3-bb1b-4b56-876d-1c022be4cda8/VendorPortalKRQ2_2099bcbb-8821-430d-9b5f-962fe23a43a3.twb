      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_4F4D16D8FB7643B2BBF6E54511E8A32E'>
            <properties context=''>
              <relation connection='bigquery.0vwnfsd0lwvwgl14dtqus1fwwgkc' name='Consulta SQL personalizada' type='text'>with users as(&#13;
  SELECT&#13;
  vp.country as country,&#13;
  v.role as rol,&#13;
  vp.email as email,&#13;
    case &#13;
  when REGEXP_CONTAINS(LOWER(vp.email), r&apos;@pedidosya.com&apos;) then &apos;PeYa&apos;&#13;
  else &apos;Partner&apos;&#13;
  end mail,&#13;
  vp.user_id as user_id,&#13;
  SAFE_CAST(v.vendor_id AS INT64) partner_id,&#13;
  vp.phone_number as phone,&#13;
  vp.updated_at as last_update,&#13;
  date(vp.updated_at) dia,&#13;
  DATE_TRUNC((vp.updated_at), MONTH) last_session_month,&#13;
FROM `peya-data-origins-pro.cl_vendor_portal.vp_users` vp&#13;
LEFT JOIN UNNEST(vendors) v&#13;
&#13;
WHERE v.vendor_id IS NOT NULL&#13;
and vp.country in (&apos;AR&apos;,&apos;CL&apos;,&apos;NI&apos;,&apos;HN&apos;,&apos;PA&apos;,&apos;PE&apos;,&apos;CR&apos;,&apos;SV&apos;,&apos;UY&apos;,&apos;PY&apos;,&apos;EC&apos;,&apos;GT&apos;,&apos;BO&apos;,&apos;VE&apos;,&apos;DO&apos;)&#13;
and vp.is_deleted = false&#13;
&#13;
GROUP BY 1,2,3,4,5,6,7,8&#13;
),salesforce_data AS (&#13;
  SELECT &#13;
    * &#13;
  FROM (&#13;
    SELECT &#13;
      *, &#13;
      ROW_NUMBER() OVER (PARTITION BY partner_id ORDER BY last_activity_date DESC) row_num&#13;
    FROM (&#13;
      SELECT&#13;
        &#13;
        dp.partner_id partner_id,&#13;
        account_source,&#13;
        city.name nombre_ciudad,&#13;
        account_status status,&#13;
        key_vip_account is_ka,&#13;
        CASE long_tail_segmentation&#13;
          WHEN &apos;A1&apos; THEN &apos;A&apos;&#13;
          WHEN &apos;A2&apos; THEN &apos;A&apos;&#13;
          WHEN &apos;B1&apos; THEN &apos;B&apos;&#13;
          WHEN &apos;B2&apos; THEN &apos;B&apos;&#13;
          WHEN &apos;C1&apos;THEN &apos;C&apos;&#13;
          WHEN &apos;C2&apos;THEN &apos;C&apos;&#13;
          WHEN &apos;C3&apos;THEN &apos;C&apos;&#13;
          WHEN &apos;D1&apos;THEN &apos;D&apos;&#13;
          WHEN &apos;D2&apos;THEN &apos;D&apos;&#13;
          WHEN &apos;D3&apos;THEN &apos;D&apos;&#13;
          ELSE long_tail_segmentation&#13;
        END long_tail_segmentation_fixed,&#13;
        key_account_sub_category,&#13;
        CASE key_account_sub_category&#13;
        WHEN &apos;Global KA&apos; THEN &apos;Key Account&apos;&#13;
          WHEN &apos;Large Chain&apos; THEN &apos;Key Account&apos;&#13;
          WHEN &apos;Local Hero&apos; THEN &apos;Key Account&apos;&#13;
          WHEN &apos;National KA&apos; THEN &apos;Key Account&apos;&#13;
          ELSE &quot;Long tail&quot;&#13;
          end is_ka_v2,&#13;
        last_activity_date&#13;
      FROM `peya-bi-tools-pro.il_salesforce.dim_salesforce_account` sf&#13;
      LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp&#13;
       ON dp.salesforce_id = sf.account_grid&#13;
&#13;
    )&#13;
  ) WHERE row_num = 1&#13;
)&#13;
SELECT&#13;
us.country as country,&#13;
  us.rol as rol,&#13;
  us.email as email,&#13;
   us.mail,&#13;
  us.user_id as user_id,&#13;
  us.partner_id as partner_id,&#13;
  us.phone as phone,&#13;
  us.last_update as last_update,&#13;
  us.last_session_month,&#13;
  us.dia,&#13;
  sf.status&#13;
from users us&#13;
left join salesforce_data sf on&#13;
sf.partner_id=us.partner_id&#13;
and sf.status =&apos;Active&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Consulta_SQL_personalizada (user_tomas_mir) (5)' inline='true' name='federated.1jn9m0c0gnx2va1gwmtux15ic64c' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1qyxiq60ga3uu415y3jw61pvcuhh'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_tomas_mir' server='' server-oauth='' username='jose.amondarain@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1qyxiq60ga3uu415y3jw61pvcuhh' name='Consulta_SQL_personalizada' type='text'>WITH active_partners_by_month_and_country AS (&#13;
  SELECT&#13;
    DATE_TRUNC(registered_date, MONTH) active_month,&#13;
    CASE country.country_name&#13;
      WHEN &apos;República Dominicana&apos; THEN &apos;Dominican Republic&apos;&#13;
      WHEN &apos;Panamá&apos; THEN &apos;Panama&apos;&#13;
      WHEN &apos;Perú&apos; THEN &apos;Peru&apos;&#13;
      ELSE country.country_name&#13;
    END country_name,&#13;
    COUNT(DISTINCT restaurant.id) active_partners&#13;
  FROM `peya-bi-tools-pro.il_core.fact_orders`&#13;
  WHERE registered_date &gt;&gt;= &apos;2022-05-01&apos;&#13;
    AND business_type_id IN (1,7)&#13;
    and UPPER(order_status) = &apos;CONFIRMED&apos;&#13;
  GROUP BY 1,2&#13;
),&#13;
sessions_by_month_and_country AS (&#13;
  SELECT&#13;
    DATE_TRUNC(DATE(session_date), MONTH) session_month,&#13;
    vp.session_country,&#13;
    COUNT(DISTINCT vp.vendor_id) partners_with_sessions,&#13;
    COUNT(DISTINCT CASE WHEN o.restaurant_id IS NOT NULL THEN vp.vendor_id END) active_partners_with_sessions&#13;
  FROM `peya-data-origins-pro.cl_vendor_portal.vp_vendor_sessions` vp&#13;
&#13;
  LEFT JOIN (&#13;
&#13;
    SELECT&#13;
      DATE_TRUNC(registered_date, MONTH) active_month,&#13;
      CASE country.country_name&#13;
        WHEN &apos;República Dominicana&apos; THEN &apos;Dominican Republic&apos;&#13;
        WHEN &apos;Panamá&apos; THEN &apos;Panama&apos;&#13;
        WHEN &apos;Perú&apos; THEN &apos;Peru&apos;&#13;
        ELSE country.country_name&#13;
      END country_name,&#13;
      restaurant.id restaurant_id&#13;
    FROM `peya-bi-tools-pro.il_core.fact_orders`&#13;
    WHERE registered_date &gt;&gt;= &apos;2022-05-01&apos;&#13;
      AND business_type_id IN (1,7)&#13;
      and UPPER(order_status) = &apos;CONFIRMED&apos;&#13;
  ) o ON o.active_month = DATE_TRUNC(DATE(session_date), MONTH)&#13;
     AND LOWER(o.country_name) = LOWER(vp.session_country)&#13;
     AND o.restaurant_id = SAFE_CAST(vendor_id AS INT64)&#13;
&#13;
  WHERE DATE(vp.session_date) &gt;&gt;= &apos;2022-05-01&apos;&#13;
    AND vp.session_country IN (&apos;Argentina&apos;,&apos;Bolivia&apos;,&apos;Chile&apos;,&apos;Costa Rica&apos;,&apos;Ecuador&apos;,&apos;El Salvador&apos;,&apos;Guatemala&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;,&apos;Panama&apos;,&apos;Paraguay&apos;,&apos;Peru&apos;,&apos;Dominican Republic&apos;,&apos;Uruguay&apos;,&apos;Venezuela&apos;)&#13;
  GROUP BY 1,2&#13;
  ORDER BY 1 DESC, 2&#13;
)&#13;
SELECT&#13;
  s.session_month,&#13;
  a.country_name,&#13;
  SUM(s.active_partners_with_sessions) active_partners_with_sessions,&#13;
  SUM(a.active_partners) active_partners,&#13;
  ROUND(100.0 * SAFE_DIVIDE(SUM(s.active_partners_with_sessions), SUM(a.active_partners)), 1) KPI_adoption&#13;
FROM sessions_by_month_and_country s&#13;
&#13;
LEFT JOIN active_partners_by_month_and_country a &#13;
       ON a.active_month = s.session_month&#13;
      AND LOWER(a.country_name) = LOWER(s.session_country)&#13;
&#13;
GROUP BY 1,2&#13;
ORDER BY 1 DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
