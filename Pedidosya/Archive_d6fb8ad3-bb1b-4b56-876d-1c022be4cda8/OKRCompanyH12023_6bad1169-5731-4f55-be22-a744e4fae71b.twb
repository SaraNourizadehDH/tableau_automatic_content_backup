          </datasources>
          <datasource-dependencies datasource='federated.10k10x30mfqcpd1a9aqcr1er322v'>
            <column caption='Accelerate our path to profitability (copy)' datatype='integer' name='[Accelerate our path to profitability (copy)_418553346872279042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column datatype='integer' name='[Acquisitions]' role='measure' type='quantitative' />
            <column datatype='real' name='[AdjustedEbitda]' role='measure' type='quantitative' />
            <column caption='CVRs' datatype='real' name='[Calculation_1474928927067185152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([session_with_order])/sum([sessions])' />
            </column>
            <column caption='Frecuencys' datatype='real' name='[Calculation_1474928927067447297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_orders])/sum([MAU])' />
            </column>
            <column caption='Active Partner (FOOD + LS)' datatype='integer' name='[Calculation_1474928927073480707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[food_partner] + [local_store_partner]' />
            </column>
            <column caption='Non-Food Order Share' datatype='real' name='[Calculation_1474928927076511749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_orders]-[food_order])/sum([qty_orders])' />
            </column>
            <column caption='NPS AO' datatype='real' name='[Calculation_1474928927096918023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([nps_promoter_num])/sum([nps_den])' />
            </column>
            <column caption='Delivery_time_avg' datatype='real' name='[Calculation_1474928927097176072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time_min])/sum([orders_completed_delivery_time])' />
            </column>
            <column caption='FailRate' datatype='real' name='[Calculation_1474928927097462793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_not_confirmed])/sum([Orders])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1474928927097630730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([utr_order_completed])/sum([utr_working_hour])' />
            </column>
            <column caption='ncr_gmvgross' datatype='real' name='[Calculation_1474928927097958411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ncr])/sum([GMV_Gross_eu])' />
            </column>
            <column caption='cr_gmv_gross' datatype='real' name='[Calculation_1474928927098142732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cr_eu])/sum([GMV_Gross_eu])' />
            </column>
            <column caption='Seamless Share' datatype='real' name='[Calculation_1474928927098396685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_1_payment_no_contact_not_delayed])/sum([total_orders_logistic_seamless])' />
            </column>
            <column caption='Food_discount_gmv' datatype='real' name='[Calculation_1474928927098687502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([food_discount_paid_others])/sum([food_gmv_gross])' />
            </column>
            <column caption='LocalStore_discount_gmvgross' datatype='real' name='[Calculation_1474928927098843151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([local_store_discount_paid_others])/sum([local_store_gmv_gross])' />
            </column>
            <column caption='Discount_gmvgross' datatype='real' name='[Calculation_1474928927099162640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([discount_paid_others])/sum([GMV_Gross_eu])' />
            </column>
            <column caption='Partners_noOrders_share' datatype='real' name='[Calculation_1474928927100882962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([partners_0])/sum([qty_partner_on])' />
            </column>
            <column caption='Partners_30_share' datatype='real' name='[Calculation_1474928927101059091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([partners_30])/sum([qty_partner_on])' />
            </column>
            <column caption='OD_share' datatype='real' name='[Calculation_1474928927101407252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_logistic_orders])/sum([Orders])' />
            </column>
            <column caption='Partners_80' datatype='real' name='[Calculation_1474928927101800469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_partners_paretto])/sum([qty_partner_on])' />
            </column>
            <column caption='AFVGrosseu' datatype='real' name='[Calculation_1474928927103479830]' role='measure' type='quantitative'>
