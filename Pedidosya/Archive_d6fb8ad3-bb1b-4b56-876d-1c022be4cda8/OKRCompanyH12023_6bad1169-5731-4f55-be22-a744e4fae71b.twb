            <column caption='Choice: Ensure having the major assortment' datatype='integer' name='[Make PEYA affordable for everyone (copia)_1030198478519427074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
