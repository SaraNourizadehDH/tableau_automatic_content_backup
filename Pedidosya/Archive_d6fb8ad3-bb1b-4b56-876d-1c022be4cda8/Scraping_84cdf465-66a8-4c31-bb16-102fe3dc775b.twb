    <datasource caption='Rappi_vs_peya_completa' inline='true' name='federated.0q2jmzf0vbstlr18bbzyh0g2w2mo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0um4q0j14nihji181by090srw1t8'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='user_federico_ramos' server-oauth='' username='guillermo.gadea@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0um4q0j14nihji181by090srw1t8' name='Custom_SQL_Query' type='text'>SELECT&#13;
	DISTINCT &#13;
	co.country_id&#13;
	,co.country_name &#13;
	,c.city_id &#13;
	,c.city_name &#13;
	,rpp.partner_id as peya_partner_id&#13;
	,rpp.ratio product_ratio&#13;
	,rp.partner_id as rappi_partner_id&#13;
	,rp.partner_name peya_partner_name&#13;
	,rp.partner_name rappi_partner_name&#13;
	,rap.product_id rappi_product_id&#13;
	,rap.product_name rappi_product_name&#13;
	,prod.product_id peya_product_id&#13;
	,prod.product_name peya_product_name&#13;
	,(rap.product_price) rappi_price&#13;
	,(prod.product_price) peya_price&#13;
	,(rap.product_price/exch.rate_eu) rappi_price_euros&#13;
	,(prod.product_price/exch.rate_eu) peya_price_euros&#13;
FROM `peya-data-origins-pro.cl_scraping.rappi_product_peya` rpp&#13;
INNER JOIN `peya-data-origins-pro.cl_scraping.rappi_partner` rp on rp.partner_id = rpp.partner_id &#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_partner` p on rpp.partner_id = p.partner_id&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_city` c on c.city_id = p.city_id &#13;
INNER JOIN `peya-data-origins-pro.cl_scraping.rappi_product` rap on rap.product_id  = CAST(rpp.rappi_product_id AS INT64) and rap.store_id = rp.store_id&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_product` prod on prod.product_id = rpp.peya_product_id &#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` co on co.country_id = rp.country_id and co.active &#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` exch ON exch.currency_id = co.currency_id AND DATE_TRUNC(DATE(rap.date_created),MONTH) = exch.currency_exchange_date&#13;
WHERE  prod.is_deleted= False</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0um4q0j14nihji181by090srw1t8' name='Custom_SQL_Query' type='text'>SELECT&#13;
