      <aliases enabled='yes' />
      <column caption='Cities to show' datatype='boolean' name='[Calculation_1296192332807434242]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Drive Addresses' datatype='string' name='[Calculation_1646628636952092679]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Drive Addresses&apos;' />
      </column>
      <column caption='Is in Peya' datatype='boolean' name='[Calculation_685954527933976576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hash]=[competitors_hash] THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='True Peya' datatype='integer' name='[Calculation_685954528040644611]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(IF [hash]=[competitors_hash] THEN ([hash]) END)' />
      </column>
      <column caption='% FalsePeya' datatype='real' name='[Calculation_685954528042426372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (ZN(([Calculation_685954528040644611]) / SUM([Fixed Partner Name (copy 2)_1296192333201915950])))' />
      </column>
      <column caption='# False Peya' datatype='integer' name='[Calculation_685954528051666949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Fixed Partner Name (copy 2)_1296192333201915950]) - COUNTD(IF [hash]=[competitors_hash] THEN ([hash]) END)' />
      </column>
      <column caption='Index' datatype='boolean' name='[Calculation_685954530107658246]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 2]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Blank' datatype='string' name='[Calculation_685954530164518921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
        <aliases>
          <alias key='&quot;&quot;' value='Data up to:' />
        </aliases>
      </column>
      <column caption='Fixed Partner Name (copy 2)' datatype='integer' name='[Fixed Partner Name (copy 2)_1296192333201915950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({ FIXED [country_name],[site],[city_name],[hash]: SUM({ FIXED [country_name],[site], [hash],[city_name]: COUNTD([hash])})})' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom_SQL_Query' datatype='table' name='[__tableau_internal_object_id__].[_8B0F0D4DE6CB40DBA2AF813E699E5B83]' role='measure' type='quantitative' />
      <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Total Partners *' datatype='integer' name='[hash (copy)_1646628635588415489]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([hash])' />
      </column>
      <column caption='Data up to' datatype='datetime' default-format='*dd/mm/yy' name='[last_updated (copy)_685954530155364360]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[date_created_sc]' />
      </column>
      <column aggregation='Avg' datatype='real' name='[lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
      <column datatype='string' name='[name]' role='dimension' type='nominal' />
      <column datatype='string' name='[site]' role='dimension' type='nominal' />
      <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
      <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
      <column-instance column='[site]' derivation='None' name='[none:site:nk]' pivot='key' type='nominal' />
      <group caption='Action (1st Time Date competitor (Months),Country Name,Citiy Name,Site)' hidden='true' name='[Action (1st Time Date competitor (Months),Country Name,Citiy Name,Site)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[1st Time Date competitor (Months)]' />
          <groupfilter function='level-members' level='[none:country_name:nk]' />
          <groupfilter function='level-members' level='[city_name]' />
          <groupfilter function='level-members' level='[site]' />
        </groupfilter>
      </group>
      <group caption='Action (1st Time Date competitor (Months),Country Name,Partner Name,Site)' hidden='true' name='[Action (1st Time Date competitor (Months),Country Name,Partner Name,Site)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[1st Time Date competitor (Months)]' />
          <groupfilter function='level-members' level='[none:country_name:nk]' />
          <groupfilter function='level-members' level='[name]' />
          <groupfilter function='level-members' level='[site]' />
        </groupfilter>
      </group>
      <group caption='Action (1st Time Date competitor (Months),Country Name,Site)' hidden='true' name='[Action (1st Time Date competitor (Months),Country Name,Site)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
