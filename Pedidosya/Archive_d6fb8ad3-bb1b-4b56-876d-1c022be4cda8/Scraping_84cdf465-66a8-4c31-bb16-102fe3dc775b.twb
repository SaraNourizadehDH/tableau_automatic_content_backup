        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1kv63jo1gwnneh11ik84q1s86cl9' name='Custom_SQL_Query' type='text'>SELECT &#13;
    sc.hash&#13;
    ,sc.date_created as date_created_sc&#13;
    ,sc.country_id  as country_id_sc&#13;
    ,sc.main_cuisine&#13;
    ,sc.rating&#13;
    ,sc.name&#13;
    ,sc.site,sc.url&#13;
    ,sca.date_created as date_created_sca&#13;
    ,sa.country_name&#13;
    ,sa.enabled as enabled_sa&#13;
    ,sa.area_id&#13;
    ,sa.address&#13;
    ,sa.area_name&#13;
    ,sa.city_name&#13;
    ,sa.lat&#13;
    ,sa.lng&#13;
    ,scp.competitors_hash&#13;
    ,scp.partner_id&#13;
    ,p.salesforce_id grid&#13;
FROM `peya-data-origins-pro.cl_scraping.competitor` sc&#13;
INNER JOIN `peya-data-origins-pro.cl_scraping.competitor_address` sca ON sca.competitor_hash = sc.hash&#13;
INNER JOIN `peya-data-origins-pro.cl_scraping.address` sa ON sa.hash = sca.address_hash&#13;
LEFT JOIN `peya-data-origins-pro.cl_scraping.competitors_partners` scp ON sc.hash = scp.competitors_hash&#13;
LEFT JOIN (SELECT p.salesforce_id, p.partner_id&#13;
		   FROM `peya-bi-tools-pro.il_core.dim_partner` p) p ON p.partner_id = scp.partner_id &#13;
WHERE DATE(sca.date_created)&gt;&gt;= DATE(DATE_ADD(DATE_TRUNC(CURRENT_DATE(),WEEK),INTERVAL -4 WEEK))</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1kv63jo1gwnneh11ik84q1s86cl9' name='Custom_SQL_Query' type='text'>SELECT &#13;
    sc.hash&#13;
    ,sc.date_created as date_created_sc&#13;
    ,sc.country_id  as country_id_sc&#13;
    ,sc.main_cuisine&#13;
    ,sc.rating&#13;
    ,sc.name&#13;
    ,sc.site,sc.url&#13;
    ,sca.date_created as date_created_sca&#13;
    ,sa.country_name&#13;
    ,sa.enabled as enabled_sa&#13;
    ,sa.area_id&#13;
    ,sa.address&#13;
    ,sa.area_name&#13;
    ,sa.city_name&#13;
    ,sa.lat&#13;
    ,sa.lng&#13;
    ,scp.competitors_hash&#13;
    ,scp.partner_id&#13;
    ,p.salesforce_id grid&#13;
FROM `peya-data-origins-pro.cl_scraping.competitor` sc&#13;
INNER JOIN `peya-data-origins-pro.cl_scraping.competitor_address` sca ON sca.competitor_hash = sc.hash&#13;
INNER JOIN `peya-data-origins-pro.cl_scraping.address` sa ON sa.hash = sca.address_hash&#13;
LEFT JOIN `peya-data-origins-pro.cl_scraping.competitors_partners` scp ON sc.hash = scp.competitors_hash&#13;
LEFT JOIN (SELECT p.salesforce_id, p.partner_id&#13;
		   FROM `peya-bi-tools-pro.il_core.dim_partner` p) p ON p.partner_id = scp.partner_id &#13;
WHERE DATE(sca.date_created)&gt;&gt;= DATE(DATE_ADD(DATE_TRUNC(CURRENT_DATE(),WEEK),INTERVAL -4 WEEK))</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
