AVG(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then percentage_orders_with_vendor_late_greater_or_equal_10_minutes
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then percentage_orders_with_vendor_late_greater_or_equal_10_minutes else null end) as avg_VL_post,
MAX(median_VL_post) AS median_VL_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then orders_late
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then orders_late else 0 end) as orders_late_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then orders_total_for_VL
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then orders_total_for_VL else 0 end) as orders_total_for_VL_post,
AVG(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then Rating_partner
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then Rating_partner else null end) as avg_rating_partners_post,
MAX(median_partner_rating_post) AS median_rating_partner_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then total_NCR_categories
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then total_NCR_categories else 0 end) as total_NCR_categories_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then amount_NCR
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then amount_NCR else 0 end) as amount_NCR_post,
AVG(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then avg_nps_score
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then avg_nps_score else null end) as avg_nps_score_post,
MAX(median_nps_post) AS median_nps_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then nps_partners_promoter
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then nps_partners_promoter else 0 end) as total_nps_promoter_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then nps_partners_pasive
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then nps_partners_pasive else 0 end) as total_nps_partners_pasive_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then nps_partners_detractor
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then nps_partners_detractor else 0 end) as total_nps_partners_detractor_post,
FROM base_kpis bkpi
LEFT JOIN quartiles_prev qpr 
ON bkpi.month_offer = qpr.month_offer
AND bkpi.with_credit = qpr.with_credit
AND bkpi.has_post_credits = qpr.has_post_credits
AND bkpi.country = qpr.country
AND bkpi.term = qpr.term
LEFT JOIN quartiles_post qpo 
ON bkpi.month_offer = qpo.month_offer
AND bkpi.with_credit = qpo.with_credit
AND bkpi.has_post_credits = qpo.has_post_credits
AND bkpi.country = qpo.country
AND bkpi.term = qpo.term
WHERE bkpi.month_offer IN (SELECT DISTINCT(request_month) FROM credit_request)
GROUP BY 1,2,3,4,5]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
