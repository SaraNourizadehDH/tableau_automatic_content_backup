WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) and (GMV >>= (q1_GMV_post-1.5*(q3_GMV_post-q1_GMV_post))) and (GMV <<= (q3_GMV_post+1.5*(q3_GMV_post-q1_GMV_post))) and GMV >> 0 then GMV
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) and (GMV >>= (q1_GMV_post-1.5*(q3_GMV_post-q1_GMV_post))) and (GMV <<= (q3_GMV_post+1.5*(q3_GMV_post-q1_GMV_post))) and GMV >> 0 then GMV end) as GMV_qty_post_ib,
