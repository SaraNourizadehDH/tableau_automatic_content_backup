    <worksheet name='Variations'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (user_santiago_castillo)' name='federated.00h3ruu1lo9dd210hppgr1t9gvq2' />
          </datasources>
          <datasource-dependencies datasource='federated.00h3ruu1lo9dd210hppgr1t9gvq2'>
            <column caption='Delta Conf Orders' datatype='real' name='[Calculation_1449033233837318144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([confirmed_orders_post_ib])/SUM([confirmed_orders_qty_post_ib])-SUM([confirmed_orders_prev_ib])/SUM([confirmed_orders_qty_prev_ib]))/(SUM([confirmed_orders_prev_ib])/SUM([confirmed_orders_qty_prev_ib]))' />
            </column>
            <column caption='WITH CREDIT' datatype='boolean' name='[Calculation_1449033233838338049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [has_post_credits]=false AND [with_credit]=false then false &#13;&#10;ELSEIF [has_post_credits]=false AND [with_credit]=true then true&#13;&#10;END' />
            </column>
            <column caption='Delta Zombie Rate' datatype='real' name='[Calculation_1449033233886736392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_churned_ruts])/SUM([qty_offers])' />
            </column>
            <column caption='Period Filter' datatype='string' name='[Calculation_1519964935803383808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month_offer] &gt; DATEADD(&apos;month&apos;,-4,DATETRUNC(&apos;month&apos;,TODAY())) then &apos;Hide&apos; else &apos;Show&apos; end' />
            </column>
            <column caption='Delta NPS' datatype='real' name='[Delta Amount NCR (copia)_1449033233884315655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([avg_nps_score_post])-SUM([avg_nps_score_prev]))' />
            </column>
            <column caption='Delta Conf GMV' datatype='real' name='[Delta Conf Orders (copia)_1449033233839771650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GMV_post_ib])/SUM([GMV_qty_post_ib])-SUM([GMV_prev_ib])/SUM([GMV_qty_prev_ib]))/(SUM([GMV_prev_ib])/SUM([GMV_qty_prev_ib]))' />
            </column>
            <column caption='Delta VFR' datatype='real' name='[Delta Conf Orders (copia)_1449033233850466307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([median_VFR_post])-SUM([median_VFR_prev])&#13;&#10;)*100' />
            </column>
            <column caption='Delta VL' datatype='real' name='[Delta VFR (copia)_1449033233852801028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([median_VL_post])-SUM([median_VL_prev]))*100' />
            </column>
            <column caption='Delta Amount NCR' datatype='real' name='[Delta VFR (copia)_1449033233883762694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([amount_NCR_post])-SUM([amount_NCR_prev]))/SUM([amount_NCR_prev])' />
            </column>
            <column caption='Delta Rating' datatype='real' name='[Delta VL (copia)_1449033233883025413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([median_rating_partner_post])-SUM([median_partner_rating_prev]))' />
            </column>
            <column caption='Delta Activity Time' datatype='real' name='[Delta VL (copia)_1449033233887727625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([median_activity_time_post])-SUM([median_activity_time_prev]))*100' />
            </column>
            <column datatype='real' name='[GMV_post_ib]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV_prev_ib]' role='measure' type='quantitative' />
