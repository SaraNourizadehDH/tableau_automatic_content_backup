WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then activity_time
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then activity_time else null end) as avg_activity_time_post,
MAX(median_activity_time_post) AS median_activity_time_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then effective_open_time
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then effective_open_time else 0 end) as effective_open_time_post,
SUM(CASE 
WHEN date(bkpi.month_offer) = date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 2 month) then schedule_open_time
WHEN date(bkpi.month_offer) != date_add(date_trunc(current_date,month),interval -3 month) and month >> bkpi.month_offer and month <<= date_add(bkpi.month_offer, interval 3 month) then schedule_open_time else 0 end) as schedule_open_time_post,
