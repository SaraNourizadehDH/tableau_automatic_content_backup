    <worksheet name='Metrics sensibility by batch'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Metric sensibility &amp; batch evolution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.1ff3jgj1wm8as41br7sni1oy5zo5' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acceptance rate&quot;'>
              <calculation class='tableau' formula='&quot;Acceptance rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ff3jgj1wm8as41br7sni1oy5zo5'>
            <column caption='TOTAL(AVG([Acceptance rate]))' datatype='real' name='[Calculation_2314850264833871888]' role='measure' type='quantitative' user:unnamed='Metrics sensibility by batch (3)'>
              <calculation class='tableau' formula='TOTAL(AVG([acceptance_rate]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_2314850264923025425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Acceptance rate&apos; THEN [acceptance_rate]*100&#13;&#10;    WHEN &apos;No shows %&apos; THEN ([no_show_shifts]/[total_shifts])*100&#13;&#10;    WHEN &apos;No shows shifts&apos; THEN [no_show_shifts]&#13;&#10;    WHEN &apos;Actual hours&apos; THEN [actual_hours]&#13;&#10;    WHEN &apos;Planned hours&apos; THEN [planned_hours]&#13;&#10;    WHEN &apos;Actual vs planned hours&apos; THEN ([actual_hours] / [planned_hours])*100&#13;&#10;    WHEN &apos;Special hours %&apos; THEN ([planned_special_hours] / [planned_hours])*100&#13;&#10;    WHEN &apos;Special hours&apos; THEN [planned_special_hours]&#13;&#10;END' />
            </column>
            <column caption='KPI logo' datatype='string' name='[KPI (copia)_2314850264926982163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Acceptance rate&apos; THEN &apos;%&apos;&#13;&#10;    WHEN &apos;No shows %&apos; THEN &apos;%&apos;&#13;&#10;    WHEN &apos;No shows shifts&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;Actual hours&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;Planned hours&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;Actual vs planned hours&apos; THEN &apos;%&apos;&#13;&#10;    WHEN &apos;Special hours %&apos; THEN &apos;%&apos;&#13;&#10;    WHEN &apos;Special hours&apos; THEN &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Acceptance rate' datatype='real' name='[acceptance_rate]' role='measure' type='quantitative' />
            <column caption='Actual hours' datatype='real' name='[actual_hours]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='N+1 week batch' datatype='integer' name='[analyzed_batch]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2314850264923025425]' derivation='Avg' name='[avg:Calculation_2314850264923025425:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[city_id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_2314850264923025425]' derivation='Avg' name='[diff:avg:Calculation_2314850264923025425:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column caption='No show shifts' datatype='real' name='[no_show_shifts]' role='measure' type='quantitative' />
            <column-instance column='[KPI (copia)_2314850264926982163]' derivation='None' name='[none:KPI (copia)_2314850264926982163:nk]' pivot='key' type='nominal' />
            <column-instance column='[analyzed_batch]' derivation='None' name='[none:analyzed_batch:ok]' pivot='key' type='ordinal' />
            <column-instance column='[city_id]' derivation='None' name='[none:city_id:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[previous_batch]' derivation='None' name='[none:previous_batch:ok]' pivot='key' type='ordinal' />
            <column-instance column='[previous_week]' derivation='None' name='[none:previous_week:nk]' pivot='key' type='nominal' />
            <column caption='Planned hours' datatype='real' name='[planned_hours]' role='measure' type='quantitative' />
            <column caption='Planned special hours' datatype='real' name='[planned_special_hours]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='N week batch' datatype='integer' name='[previous_batch]' role='dimension' type='ordinal' />
