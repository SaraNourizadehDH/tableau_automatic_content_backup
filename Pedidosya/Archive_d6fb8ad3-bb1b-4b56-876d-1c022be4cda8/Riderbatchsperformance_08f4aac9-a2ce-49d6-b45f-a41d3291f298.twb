        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.05r2oqc0ptgvk212sni6k0f2pxl5'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='automated_tables_reports' server-oauth='' username='bruno.marchese@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
