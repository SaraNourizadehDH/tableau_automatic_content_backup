      <aliases enabled='yes' />
      <column caption='planned vs actual hours' datatype='real' default-format='p0.00%' name='[Calculation_2314850263936958464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_hours]) / SUM([planned_hours])' />
      </column>
      <column caption='No shows %' datatype='real' name='[Calculation_2314850264723763204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_show_shifts])/SUM([total_shifts])' />
      </column>
      <column aggregation='Sum' caption='batch variation' datatype='integer' name='[Calculation_2314850264732487685]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[previous_batch]-[analyzed_batch]' />
      </column>
      <column caption='Variación de batches' datatype='string' name='[Calculation_2314850264732688390]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_batch]-[Calculation_2314850264732487685] = 7 THEN &quot;Inactive&quot;&#13;&#10;ELSEIF [Calculation_2314850264732487685] &gt; 0 THEN &quot;Mejoró&quot;&#13;&#10;ELSEIF[Calculation_2314850264732487685] = 0 THEN  &quot;Se mantuvo&quot;&#13;&#10;ELSEIF[Calculation_2314850264732487685] &lt; 0 THEN  &quot;Empeoró&quot; END' />
      </column>
      <column caption='Sankey arm size' datatype='real' name='[Calculation_2314850264823984136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([rider_id])/TOTAL(COUNT([rider_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='riders' datatype='integer' name='[Calculation_2314850264827416589]' role='measure' type='quantitative'>
