        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.05r2oqc0ptgvk212sni6k0f2pxl5' name='Consulta SQL personalizada' type='text'><![CDATA[WITH datos AS (
    SELECT
        DATE("2022-12-12") AS start_date,
        CURRENT_DATE() AS end_date,

),

slots AS (

    SELECT
        country_code,
        FORMAT_DATE("%G-%V", DATE(created_date_local)) as week_year,
        MIN(created_date_local) AS created_date_local,
        ROUND(SUM(open_slots_size) / 4, 2) AS open_slots_hours,
        ROUND(SUM(open_slots_assigned) / 4, 2) AS assigned_hours
    FROM `peya-data-origins-pro.cl_hurrier.staffing_kpi`, datos
    WHERE created_date_local BETWEEN start_date AND end_date
    -- HAY CASOS NULL
        AND open_slots_size IS NOT NULL
    GROUP BY 1,2
    ORDER BY 1,4,3,created_date_local

),

rider_acceptance AS (

    SELECT 
        t.rider_id
        , o.city.city_id
        , FORMAT_DATE("%G-%V", DATE(created_date_local)) as week_year
        , SUM(t.transition_notified) AS transition_notified
        , SUM(t.transition_accepted) AS transition_accepted
        , COUNT(DISTINCT CASE WHEN order_cancelled = 0 THEN peya_order_id END) AS orders
    FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` o, datos
        LEFT JOIN UNNEST(o.deliveries) d
        LEFT JOIN UNNEST(d.transitions) t
    WHERE created_date_local BETWEEN start_date AND end_date
    GROUP BY 1,2,3


),

rider_shifts AS (

    SELECT
        a1.rider_id,
        a1.shift_state,
        FORMAT_DATE("%G-%V", DATE(a1.shift_start_at)) as week_year,
        a1.shift_id,
        TIMESTAMP(a1.shift_start_at) as inicio,
        TIMESTAMP(a1.shift_end_at) as fin,
        ROUND((a1.actual_working_time / 3600),4) as actual_hours,
        ROUND((planned_shift_duration / 3600),4) AS planned_hours
    FROM `peya-data-origins-pro.cl_hurrier.shifts` as a1, datos
        left join unnest(evaluations) as eva
    WHERE
        -- shift_state<<>>"NO_SHOW"
        shift_state<<>>"CANCELLED"
        and date(shift_start_at,timezone) BETWEEN start_date AND end_date
        -- AND (login_difference,3600) >>2

),

rider_hours AS (

    SELECT
        s.rider_id
        , city_id
        , s.week_year
        , transition_notified
        , transition_accepted
        , orders
        , ROUND(SUM(CASE WHEN shift_state = 'EVALUATED' THEN actual_hours END),4) AS actual_hours
        , ROUND(SUM(planned_hours),4) AS planned_hours
        , SAFE_DIVIDE( SUM(CASE WHEN shift_state = 'EVALUATED' THEN actual_hours END) , SUM(planned_hours) ) AS planned_vs_actual_hours
        , ROUND(SUM(CASE WHEN (TIME(inicio) >>= '19:00:00' OR TIME(inicio) << '00:30:00') THEN planned_hours END),4) AS planned_special_hours
        , ROUND(COUNT(CASE WHEN shift_state = 'NO_SHOW' THEN shift_id END),4) AS no_show
        , ROUND(COUNT(shift_id),4) AS total_shifts
    FROM rider_shifts s
        LEFT JOIN rider_acceptance a
            ON s.rider_id = a.rider_id
            AND s.week_year = a.week_year
    GROUP BY 1,2,3,4,5,6

),

batch AS (

    SELECT 
        COALESCE(h.city_id,r.city_id) AS city_id,
        country_code,
        --b.active_from,
        --b.active_until,
        FORMAT_DATE("%G-%V", DATE(b.active_from)) as week_year_from,
        FORMAT_DATE("%G-%V", DATE(b.active_until)) as week_year_until,
        b.number AS batch,
        DATE_DIFF(DATE_TRUNC(b.active_until, DAY), DATE_TRUNC(b.active_from, DAY), DAY) AS dif_days,
        b.rider_id,
        transition_notified,
        transition_accepted,
        orders,
        actual_hours,
        planned_hours,
        planned_vs_actual_hours,
        planned_special_hours,
        no_show,
        total_shifts
    FROM `peya-bi-tools-pro.il_logistics.dim_rider_batches` b
        INNER JOIN (
                    SELECT DISTINCT rider_id, city_id, country_code, c.status
                    FROM `peya-data-origins-pro.cl_hurrier.riders` r
                        LEFT JOIN UNNEST(r.contracts) c
                    WHERE c.status = "VALID"
        ) r
            ON r.rider_id = b.rider_id
        LEFT JOIN rider_hours h
            ON h.rider_id = b.rider_id
            AND h.week_year = FORMAT_DATE("%G-%V", DATE(b.active_from))
    -- HAY CASOS NULL
    WHERE b.number IS NOT NULL
    -- HABRIA QUE VER DE FILTRAR POR CANTIDAD DE DIAS QUE DURA EL BATCH
        AND DATE_DIFF(DATE_TRUNC(b.active_until, DAY), DATE_TRUNC(b.active_from, DAY), DAY) <<= 7
        AND DATE_DIFF(DATE_TRUNC(b.active_until, DAY), DATE_TRUNC(b.active_from, DAY), DAY) >>= 4
    ORDER BY batch


)

SELECT DISTINCT
    *
FROM (
    SELECT DISTINCT
        b.country_code,
        city_id,
        rider_id,
        s.week_year AS previous_week,
        LEAD(week_year) OVER (PARTITION BY rider_id ORDER BY week_year ASC) AS analyzed_week,
        batch AS previous_batch,
        LEAD(batch) OVER (PARTITION BY rider_id ORDER BY week_year ASC) AS analyzed_batch,
        CASE WHEN LEAD(batch) OVER (PARTITION BY rider_id ORDER BY week_year ASC) = 7 AND batch != 7 THEN 1 ELSE 0 END AS churned_rider,
        SAFE_DIVIDE(transition_accepted, transition_notified) AS acceptance_rate,
        orders,
        actual_hours,
        planned_hours,
        planned_vs_actual_hours,
        planned_special_hours,
        no_show AS no_show_shifts,
        total_shifts,
    FROM slots s
        LEFT JOIN batch b
            ON b.country_code = s.country_code
    WHERE s.week_year >>= b.week_year_from
        AND s.week_year << week_year_until
        
    -- NO ESTABAN INACTIVOS
    ORDER BY rider_id, week_year)
WHERE analyzed_week IS NOT NULL
ORDER BY rider_id, previous_week]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.05r2oqc0ptgvk212sni6k0f2pxl5' name='Consulta SQL personalizada' type='text'><![CDATA[WITH datos AS (
