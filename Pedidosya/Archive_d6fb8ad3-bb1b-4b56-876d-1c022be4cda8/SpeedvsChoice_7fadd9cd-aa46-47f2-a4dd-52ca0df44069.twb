    <worksheet name='CVR total'>
      <table>
        <view>
          <datasources>
            <datasource caption='CVR_city_area (user_felipe_aguayo)' name='federated.1u6l9pm01iy7ce1cq8izz0ezbfvi' />
          </datasources>
          <datasource-dependencies datasource='federated.1u6l9pm01iy7ce1cq8izz0ezbfvi'>
            <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_1342635677804150784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cvr_num])/sum([cvr_den])' />
            </column>
            <column caption='Month (copy)' datatype='string' name='[Month (copy)_552816895028408325]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [partition_date], &apos;monday&apos;)' />
            </column>
            <column caption='Year' datatype='integer' name='[Quarter (copy) (copy)_552816895028518919]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='(DATEPARt(&apos;iso-year&apos;, [partition_date]))' />
            </column>
            <column caption='Quarter (copy)' datatype='string' name='[Quarter (copy)_552816895028375556]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Q&apos; + str(DATEPARt(&apos;quarter&apos;, [partition_date]))' />
            </column>
            <column caption='Speed vs Choice (week)' datatype='string' name='[Speed vs Choice (week) (copy)_552816895011287043]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [partition_date] &lt; date(&quot;2022-04-18&quot;) then &apos;1-Pre Cambios&apos;&#13;&#10;ELSEIF [partition_date] &lt; date(&quot;2022-05-09&quot;) then &apos;2-Post Cambios Regiones&apos;&#13;&#10;else &apos;3-Post Cambios RM&apos;&#13;&#10;END' />
            </column>
            <column caption='Week (copy)' datatype='string' name='[Week (copy)_552816895028477958]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;W&apos;+str(DATEPARt(&apos;iso-week&apos;, [partition_date]))' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
