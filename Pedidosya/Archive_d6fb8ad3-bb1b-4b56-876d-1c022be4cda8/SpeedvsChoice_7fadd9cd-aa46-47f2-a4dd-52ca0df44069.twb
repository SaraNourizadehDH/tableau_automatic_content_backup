      <aliases enabled='yes' />
      <column caption='CVR2' datatype='real' default-format='p0.0%' name='[CVR (copy)_1342635677804232705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cvr2_num])/sum([cvr2_den])' />
      </column>
      <column caption='CVR3' datatype='real' default-format='p0.0%' name='[CVR2 (copy)_1342635677804285954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cvr3_num])/sum([cvr3_den])' />
      </column>
      <column caption='mCVR1' datatype='real' name='[CVR3 (copy)_1342635677804359683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([mcvr1_num])/sum([mcvr1_den])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_1342635677804150784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cvr_num])/sum([cvr_den])' />
      </column>
      <column caption='Speed vs Choice (day)' datatype='string' name='[Calculation_1342635677815255047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [partition_date] &lt; date(&quot;2022-04-19&quot;) then &apos;Pre Cambios&apos;&#13;&#10;ELSEIF [partition_date] &lt; date(&quot;2022-05-06&quot;) then &apos;Post Cambios Regiones&apos;&#13;&#10;else &apos;Post Cambios RM&apos;&#13;&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_1342635677815930889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [partition_date], &apos;monday&apos;)' />
      </column>
      <column caption='complete week filter' datatype='boolean' name='[Calculation_226868872346800128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[partition_date]&lt;= DATETRUNC(&apos;week&apos;, TODAY(), &apos;sunday&apos;)' />
      </column>
      <column caption='Avg Week Orders' datatype='real' name='[Calculation_552816894987689984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ include DATEPART(&apos;iso-week&apos;, [partition_date]): sum(if [partition_date]&lt;= DATETRUNC(&apos;week&apos;, TODAY(), &apos;sunday&apos;) then [confirmed_orders] else null end)})' />
      </column>
      <column caption='Week' datatype='string' name='[Month (copy)_1342635677816102922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;W&apos;+str(DATEPARt(&apos;iso-week&apos;, [partition_date]))' />
      </column>
      <column caption='Quarter' datatype='string' name='[Month (copy)_1342635677816229899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Q&apos; + str(DATEPARt(&apos;quarter&apos;, [partition_date]))' />
      </column>
      <column caption='Month (copy)' datatype='string' name='[Month (copy)_552816895028408325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [partition_date], &apos;monday&apos;)' />
      </column>
      <column caption='Year' datatype='integer' name='[Quarter (copy) (copy)_552816895028518919]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='(DATEPARt(&apos;iso-year&apos;, [partition_date]))' />
      </column>
      <column caption='Quarter (copy)' datatype='string' name='[Quarter (copy)_552816895028375556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Q&apos; + str(DATEPARt(&apos;quarter&apos;, [partition_date]))' />
      </column>
      <column caption='Speed vs Choice Pre|Post' datatype='string' name='[Speed vs Choice (day) (copy)_552816894993330177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [city_name]&#13;&#10;when &apos;Santiago&apos; then&#13;&#10;    IF [partition_date] &gt;= date(&quot;2022-05-09&quot;) then &apos;Post Cambios&apos; &#13;&#10;    else &apos;Pre Cambios&apos;&#13;&#10;    end&#13;&#10;else&#13;&#10;    if [partition_date] &gt;= date(&quot;2022-04-18&quot;) then &apos;Post Cambios&apos;&#13;&#10;    else &apos;Pre Cambios&apos;&#13;&#10;    end&#13;&#10;END' />
      </column>
      <column caption='Speed vs Choice (week)' datatype='string' name='[Speed vs Choice (week) (copy)_552816895011287043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [partition_date] &lt; date(&quot;2022-04-18&quot;) then &apos;1-Pre Cambios&apos;&#13;&#10;ELSEIF [partition_date] &lt; date(&quot;2022-05-09&quot;) then &apos;2-Post Cambios Regiones&apos;&#13;&#10;else &apos;3-Post Cambios RM&apos;&#13;&#10;END' />
      </column>
      <column caption='Week (copy)' datatype='string' name='[Week (copy)_552816895028477958]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;W&apos;+str(DATEPARt(&apos;iso-week&apos;, [partition_date]))' />
      </column>
