            <column caption='Aumento DrT' datatype='string' name='[Calculation_1235675175788634114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(str([Aumento]), &apos;Sin Cambio&apos;)' />
            </column>
            <column caption='Partner Speed vs Choice' datatype='boolean' name='[Calculation_1607785094537138178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IFNULL([Seleccionado], 0))=1' />
            </column>
            <column caption='Actual DT (avg)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1607785094548963336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_delivery_time_to_calc])/sum([confirmed_orders])/60' />
            </column>
            <column caption='AVT-c' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1607785094549282825]' role='measure' type='quantitative'>
