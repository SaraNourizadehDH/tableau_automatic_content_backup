          <datasource-dependencies datasource='federated.0xq8l6014dx06k111vcyh0rrnrfm'>
            <column caption='%VFR' datatype='real' default-format='p0.00%' name='[%FR (copy)_1607785094548168710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_rejected_orders])/sum([total_orders])' />
            </column>
            <column datatype='integer' name='[Aumento]' role='measure' type='quantitative' />
