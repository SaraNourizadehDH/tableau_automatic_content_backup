            <column caption='Aumento DrT' datatype='string' name='[Calculation_1235675175788634114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(str([Aumento]), &apos;Sin Cambio&apos;)' />
            </column>
            <column caption='Partner Speed vs Choice' datatype='boolean' name='[Calculation_1607785094537138178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IFNULL([Seleccionado], 0))=1' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1607785094562762764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([nps_promoter_orders])-sum([nps_detractor_orders]))/sum([nps_total_answers])*100&#13;&#10;&#13;&#10;//(total promoters - total detractors) / Total Answers *100' />
            </column>
            <column caption='Cambio SvC (Rg) (week)' datatype='string' name='[Cambio SvC (copy)_118500993837359104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_placed_date]&gt;=date(&apos;2022-04-18&apos;) then &apos;Post Cambios&apos; else &apos;Pre Cambios&apos; end' />
            </column>
