      <aliases enabled='yes' />
      <column caption='% Aumento' datatype='real' name='[% aumento]' role='measure' type='quantitative' />
      <column caption='%VFR' datatype='real' default-format='p0.00%' name='[%FR (copy)_1607785094548168710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_rejected_orders])/sum([total_orders])' />
      </column>
      <column caption='%VL (sinStacking)' datatype='real' default-format='p0.0%' name='[%VL (copy)_1607785094536953857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_num_no_stack])/sum([vendor_late_den_no_stack])' />
      </column>
      <column caption='Account Owner1' datatype='string' name='[Account Owner]' role='dimension' type='nominal' />
      <column caption='Aumento DrT (RM)' datatype='string' name='[Aumento DrT (copy)_1593429876567523328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(str([Aumento (RM)]), &apos;Sin Cambio&apos;)' />
      </column>
      <column caption='Cvr 3 (Rm)' datatype='string' name='[CVR 3 (RM)]' role='dimension' type='nominal' />
      <column caption='Cvr 3' datatype='real' name='[CVR 3]' role='measure' type='quantitative' />
      <column caption='CVR3 - Partner' datatype='real' default-format='p0.0%' name='[Calculation_1078049188402294784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cvr3_p_num])/sum([cvr3_p_den])' />
      </column>
      <column caption='Tooltip (i)' datatype='string' name='[Calculation_118500993882935297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;i&quot;' />
      </column>
      <column caption='Aumento DrT' datatype='string' name='[Calculation_1235675175788634114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(str([Aumento]), &apos;Sin Cambio&apos;)' />
      </column>
      <column caption='Dropoff Distance' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_141019001241399296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dropoff_d_to_calc])/sum([dropoff_d_den])/1000' />
      </column>
      <column caption='Zona Foco' datatype='boolean' name='[Calculation_1436085365113536512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [zone_name]&#13;&#10;when &apos;Lo barnechea&apos; then true&#13;&#10;when &apos;Padre hurtado&apos; then true&#13;&#10;when &apos;Peñalolen&apos; then true&#13;&#10;when &apos;Puente alto&apos; then true&#13;&#10;when &apos;Quilicura-huechuraba&apos; then true&#13;&#10;when &apos;Quinta normal&apos; then true&#13;&#10;when &apos;Recoleta independencia&apos; then true&#13;&#10;when &apos;San bernardo&apos; then true&#13;&#10;when &apos;San miguel&apos; then true&#13;&#10;ELSE false&#13;&#10;end' />
      </column>
      <column caption='%VL' datatype='real' default-format='p0.0%' name='[Calculation_1607785094536867840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_num])/sum([vendor_late_den])' />
      </column>
      <column caption='Partner Speed vs Choice' datatype='boolean' name='[Calculation_1607785094537138178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(IFNULL([Seleccionado], 0))=1' />
      </column>
      <column caption='Conf. Orders' datatype='integer' name='[Calculation_1607785094541287427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders])' />
      </column>
      <column caption='%Stacking' datatype='real' default-format='p0.0%' name='[Calculation_1607785094547185668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stacked_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='%FR' datatype='real' default-format='p0.00%' name='[Calculation_1607785094548049925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rejected_orders])/sum([total_orders])' />
      </column>
      <column caption='%RL &gt;10' datatype='real' default-format='p0.0%' name='[Calculation_1607785094548701191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_late_num])/sum([rider_late_den])' />
      </column>
      <column caption='Actual DT (avg)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1607785094548963336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([actual_delivery_time_to_calc])/sum([confirmed_orders])/60' />
      </column>
      <column caption='AVT-c' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1607785094549282825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([at_vendor_time_cleaned_to_calc])/sum([confirmed_orders])/60' />
      </column>
      <column caption='%OpenTime' datatype='real' default-format='p0.0%' name='[Calculation_1607785094558621707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-sum(if [closed_time_min]&gt;=[open_time_min] then 0 ELSE [closed_time_min] end)/SUM(if [closed_time_min]&gt;=[open_time_min] then 0 ELSE [open_time_min] end)' />
      </column>
      <column caption='NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1607785094562762764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([nps_promoter_orders])-sum([nps_detractor_orders]))/sum([nps_total_answers])*100&#13;&#10;&#13;&#10;//(total promoters - total detractors) / Total Answers *100' />
      </column>
      <column caption='AVG CPO' datatype='real' default-format='C13322%' name='[Calculation_394909426280550400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpo_to_calc])/sum([cpo_den])' />
      </column>
      <column caption='Cambio SvC (Rg) (dia)' datatype='string' name='[Calculation_915075177622581249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_placed_date]&gt;=date(&apos;2022-04-19&apos;) then &apos;Post&apos; else &apos;Pre&apos; end' />
      </column>
      <column caption='%VL (conStacking)' datatype='real' default-format='p0.0%' name='[Calculation_915075177627009027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_num_stack])/sum([vendor_late_den_stack])' />
      </column>
      <column caption='Semanas Post' datatype='string' name='[Cambio SvC (copy) (copy)_118500993902682114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_placed_date]&gt;=date(&apos;2022-04-18&apos;) then str(DATEDIFF(&apos;iso-week&apos;,date(&apos;2022-04-18&apos;),[order_placed_date]))&#13;&#10;else &apos;Pre Cambios&apos; end' />
      </column>
      <column caption='Cambio SvC (RM) (week)' datatype='string' name='[Cambio SvC (copy) (copy)_1593429876568100867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_placed_date]&gt;=date(&apos;2022-05-09&apos;) then &apos;Post Cambios&apos; else &apos;Pre Cambios&apos; end' />
      </column>
      <column caption='Cambio SvC (Rg) (week)' datatype='string' name='[Cambio SvC (copy)_118500993837359104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_placed_date]&gt;=date(&apos;2022-04-18&apos;) then &apos;Post Cambios&apos; else &apos;Pre Cambios&apos; end' />
      </column>
      <column caption='Cambio SvC (RM) (dia)' datatype='string' name='[Cambio SvC (dia) (copy)_1593429876568100866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_placed_date]&gt;=date(&apos;2022-05-06&apos;) then &apos;Post&apos; else &apos;Pre&apos; end' />
