      <column caption='Tag previous week' datatype='string' name='[Tag last week (copy)_1060316301771227137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL({fixed [partner_id]:max(if ISNULL([Tag Aux (copy)_1060316301771038720]) or ISNULL([week]) then 0 else [Tag Aux (copy)_1060316301771038720] end)}) &#13;&#10;then &quot;No Tag&quot;  &#13;&#10;elseif {fixed [partner_id]:max(if ISNULL([Tag Aux (copy)_1060316301771038720]) or ISNULL([week]) then 0 else [Tag Aux (copy)_1060316301771038720] end)}&gt;0 then &quot;RS+&quot; &#13;&#10;+ str({fixed [partner_id]:max(if ISNULL([Tag Aux (copy)_1060316301771038720]) or ISNULL([week]) then 0 else [Tag Aux (copy)_1060316301771038720] end)}) &#13;&#10;elseif {fixed [partner_id]:max(if ISNULL([Tag Aux (copy)_1060316301771038720]) or ISNULL([week]) then 0 else [Tag Aux (copy)_1060316301771038720] end)}=0 then &quot;RS-&quot; &#13;&#10;+ str({fixed [partner_id]:max(if ISNULL([Tag Aux (copy)_1060316301771038720]) or ISNULL([week]) then 0 else [Tag Aux (copy)_1060316301771038720] end)}) &#13;&#10;else &quot;RS&quot; + str({fixed [partner_id]:max(if ISNULL([Tag Aux (copy)_1060316301771038720]) or ISNULL([week]) then 0 else [Tag Aux (copy)_1060316301771038720] end)}) &#13;&#10; end&#13;&#10;&#13;&#10;//{fixed [Partner Id]:max(if ISNULL([Tag Aux]) or ISNULL([Week1]) then 0 else [Tag Aux] end)}' />
      </column>
      <column caption='VFR Others' datatype='real' name='[VFR Global (copy)_187743856576356357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([N_vfr])-sum([N_closed])-sum([N_item])&#13;&#10;-sum([N_noresp])-sum([N_toobusy])-sum([N_unreach]))/sum([total_orders])' />
