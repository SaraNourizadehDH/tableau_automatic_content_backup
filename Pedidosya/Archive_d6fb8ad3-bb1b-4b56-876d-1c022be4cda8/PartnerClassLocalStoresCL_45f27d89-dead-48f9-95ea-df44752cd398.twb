      <column caption='Partner Id1' datatype='integer' name='[Partner Id]' role='dimension' type='ordinal' />
      <column caption='Partner Name1' datatype='string' name='[Partner Name]' role='dimension' type='nominal' />
      <column caption='Performance last week1' datatype='string' name='[Performance last week]' role='dimension' type='nominal' />
