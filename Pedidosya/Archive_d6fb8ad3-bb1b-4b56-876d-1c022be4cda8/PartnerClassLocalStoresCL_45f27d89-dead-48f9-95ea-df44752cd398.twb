      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0fphjzk1rshaug12kdn710bdor6j].[usr:Fail Rate City (copy)_222083803459588096:qk]&quot;' value='Fail Rate' />
          <alias key='&quot;[federated.0fphjzk1rshaug12kdn710bdor6j].[usr:Fail Rate Global (copy)_222083803461935105:qk]&quot;' value='VFR' />
          <alias key='&quot;[federated.0fphjzk1rshaug12kdn710bdor6j].[usr:VFR Global (copy)_187743856604897286:qk]&quot;' value='PFR' />
        </aliases>
      </column>
      <column caption='VFR minimo' datatype='string' name='[Calculation_1032168789516619777]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if {fixed [partner_id]:min([N_vfr])} =0 then &quot;No&quot; else &quot;Si&quot; END' />
      </column>
      <column caption='data-up-to' datatype='string' name='[Calculation_1032168789521534978]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Data up to: &quot; &#13;&#10;+STR(datename(&quot;month&quot;,max([last_order_at_date])))&#13;&#10;+&quot; &quot;&#13;&#10;+STR(datename(&quot;day&quot;,max([last_order_at_date])))&#13;&#10;+&quot;, &quot;&#13;&#10;+STR(datename(&quot;year&quot;,max([last_order_at_date])))' />
      </column>
      <column caption='Tag RS' datatype='string' name='[Calculation_1039205673880842240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [semana]=[iso_week] then&#13;&#10;&quot;RS&quot; + SPLIT(SPLIT([tag],&quot;-RSLS&quot;,2),&quot;-W&quot;,1)&#13;&#10;else null&#13;&#10;end' />
      </column>
      <column caption='Exclude in RS' datatype='string' name='[Calculation_1039205673881444353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([Excluir]) then &quot;No&quot; else &quot;Yes&quot;  end' />
      </column>
      <column caption='last driving time change (min)' datatype='real' name='[Calculation_1039205673883365378]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//necesario tener filtrado week1 = semana de aplicación + null &#13;&#10; {fixed [partner_id]:&#13;&#10;//max(if ISNULL([Tag Aux]) or ISNULL([Week1]) then 0 else [Tag Aux] end)}&#13;&#10;sum(if ISNULL([Tag RS (copy)_1039205673884884995]) then 0 else [Tag RS (copy)_1039205673884884995] end)}' />
      </column>
      <column caption='Tag last week' datatype='string' name='[Calculation_1039205673886310405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([Calculation_1039205673883365378]) then &quot;No Tag&quot;  &#13;&#10;elseif [Calculation_1039205673883365378]&gt;0 then &quot;RS+&quot; + str([Calculation_1039205673883365378]) &#13;&#10;elseif str([Calculation_1039205673883365378])=&quot;0&quot; then &quot;RS-&quot; + str([Calculation_1039205673883365378]) &#13;&#10;else &quot;RS&quot; + str([Calculation_1039205673883365378]) &#13;&#10; end' />
      </column>
      <column caption='count partners' datatype='integer' name='[Calculation_1212312786734579712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([partner_id])' />
      </column>
      <column caption='Categoría FR' datatype='string' name='[Calculation_1297599683456589825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_286823041648087041]=1 then &quot;bajo&quot;&#13;&#10;elseif [Calculation_286823041648087041]=2 then &quot;bajo&quot;&#13;&#10;elseif [Calculation_286823041648087041]=3 then &quot;alto&quot;&#13;&#10;elseif [Calculation_286823041648087041]=4 then &quot;alto&quot;&#13;&#10;else NULL &#13;&#10;end' />
      </column>
      <column caption='Volumen órdenes' datatype='string' name='[Calculation_1297599683457261570]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [quartile_orders]=1 then &quot;bajo&quot;&#13;&#10;elseif [quartile_orders]=2 then &quot;bajo&quot;&#13;&#10;elseif [quartile_orders]=3 then &quot;alto&quot;&#13;&#10;elseif [quartile_orders]=4 then &quot;alto&quot;&#13;&#10;else NULL &#13;&#10;end' />
      </column>
      <column aggregation='Sum' caption='week corrected' datatype='integer' name='[Calculation_1385701372044525570]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[semana]+1' />
      </column>
      <column caption='VFR Unreachable' datatype='real' name='[Calculation_187743856574836736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([N_unreach])/sum([total_orders])' />
      </column>
      <column caption='partners week/city' datatype='integer' name='[Calculation_286823041646411776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed[semana],[ciudad]:max([ranking_FR])}' />
      </column>
      <column caption='Quartile FR' datatype='integer' name='[Calculation_286823041648087041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ranking_FR]&lt;= 0.25*[Calculation_286823041646411776] &#13;&#10;then 1&#13;&#10;elseif ([ranking_FR]&gt; 0.25*[Calculation_286823041646411776] &#13;&#10;and [ranking_FR]&lt;= 0.5*[Calculation_286823041646411776]) then 2&#13;&#10;elseif ([ranking_FR]&gt;0.5*[Calculation_286823041646411776] &#13;&#10;and [ranking_FR]&lt;= 0.75*[Calculation_286823041646411776]) then 3&#13;&#10;else 4&#13;&#10;end' />
      </column>
      <column caption='Progress' datatype='string' name='[Calculation_286823041663475717]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[VFR Closed Parameter]=&quot;VFR&quot; then (&#13;&#10;    if [slope_vendor_fail_rate]&gt; 0 then &quot;Worsening&quot; &#13;&#10;    elseif [slope_vendor_fail_rate]&lt;0 then &quot;Improving&quot; &#13;&#10;    else &quot;Constant&quot;&#13;&#10;    end )&#13;&#10;else (&#13;&#10;    if [slope_fail_rate]&gt; 0 then &quot;Worsening&quot; &#13;&#10;    elseif [slope_fail_rate]&lt;0 then &quot;Improving&quot; &#13;&#10;    else &quot;Constant&quot;&#13;&#10;    end&#13;&#10;)&#13;&#10;end' />
      </column>
      <column caption='semanas' datatype='integer' name='[Calculation_286823041664229382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([periodo])' />
      </column>
      <column caption='last_qVFR' datatype='integer' name='[Calculation_350717873138102272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [partner_id]:max(if [periodo]=5 then [quartile_VFR] end)}' />
      </column>
      <column caption='slope' datatype='real' name='[Calculation_350717873359335425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[VFR Closed Parameter]=&quot;VFR&quot; then [slope_vendor_fail_rate]&#13;&#10;ELSE [slope_fail_rate]&#13;&#10;end' />
      </column>
      <column caption='rownum' datatype='integer' name='[Calculation_471189170894602240]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fail Rate City' datatype='real' name='[Calculation_570549824500461568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fix Confirmed (copy)_570549824502816771]/{fixed [ciudad]:sum([total_orders])}' />
      </column>
      <column caption='Performance last week' datatype='string' name='[Calculation_570549824501411841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//performance last week&#13;&#10;if [Parameters].[VFR Closed Parameter]=&quot;VFR&quot; then (&#13;&#10;if [Calculation_350717873138102272]=4 then &quot;1-Worst&quot; &#13;&#10;elseif [Calculation_350717873138102272]=3 then &quot;2-Bad&quot; &#13;&#10;elseif [Calculation_350717873138102272]=2 then &quot;3-Good&quot; &#13;&#10;elseif [Calculation_350717873138102272]=1 then &quot;4-Best&quot;&#13;&#10;else &quot;0-No category&quot; &#13;&#10;end&#13;&#10;)&#13;&#10;else (&#13;&#10;    if [last_qVFR (copy)_774900663303700480]=4 then &quot;1-Worst&quot; &#13;&#10;    elseif [last_qVFR (copy)_774900663303700480]=3 then &quot;2-Bad&quot; &#13;&#10;    elseif [last_qVFR (copy)_774900663303700480]=2 then &quot;3-Good&quot; &#13;&#10;    elseif [last_qVFR (copy)_774900663303700480]=1 then &quot;4-Best&quot;&#13;&#10;    else &quot;0-No category&quot; &#13;&#10;    end&#13;&#10;)&#13;&#10;end&#13;&#10;&#13;&#10;//antiguo&#13;&#10;//if {fixed[Partner Id]:avg([quartile_FR])}=4 then &quot;1-Worst&quot; &#13;&#10;//elseif {fixed[Partner Id]:avg([quartile_FR])}=1 then &quot;4-Best&quot;&#13;&#10;//elseif {fixed[Partner Id]:avg([quartile_FR])}&gt;=3 and {fixed[Partner Id]:avg([quartile_FR])}&lt;4 then &quot;2-Bad&quot;&#13;&#10;//elseif [Progress]=&quot;Worsening&quot; and {fixed[Partner Id]:avg([quartile_FR])}&gt;=2.5 then &quot;2-Bad&quot;&#13;&#10;//elseif {fixed[Partner Id]:avg([quartile_FR])}&lt;=2 and {fixed[Partner Id]:avg([quartile_FR])}&gt;1 then &quot;3-Good&quot;&#13;&#10;//elseif [Progress]=&quot;Improving&quot; and {fixed[Partner Id]:avg([quartile_FR])}&lt;2.5 then &quot;3-Good&quot;&#13;&#10;//else &quot;0-No category&quot; &#13;&#10;//end' />
      </column>
      <column caption='Confirmed City' datatype='integer' name='[Calculation_570549824502628354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [ciudad]: sum([confirmed])}' />
      </column>
      <column caption='partners' datatype='integer' name='[Calculation_774900663353565188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([partner_id])' />
      </column>
      <column caption='ids radio smart' datatype='integer' name='[Calculation_86975827290607620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTd([Partner Id])' />
      </column>
      <column caption='Radio Smart' datatype='string' name='[Calculation_86975827296968709]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//tag desde BQ table&#13;&#10;//if ISNULL([Tag])=FALSE and left([Tag],10)&lt;&gt;&quot;OPS-RSLS-0&quot; and&#13;&#10;if ISNULL([tag])=FALSE and [iso_week]=[semana] &#13;&#10;then &quot;Dentro de RS&quot;&#13;&#10;else &quot;Fuera de RS&quot;&#13;&#10;end' />
      </column>
      <column caption='Size group' datatype='string' name='[Calculation_91479413207326725]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if  &#13;&#10;{fixed [partner_id],[business_type_name],[ciudad]:avg([rank_orders_period])}/{fixed [partner_id],[business_type_name], [ciudad]:avg([total_partners_period])}&gt;0.3 &#13;&#10;then &quot;Small&quot; else &quot;Big&quot;&#13;&#10;end' />
      </column>
      <column caption='Fail Rate Global' datatype='real' name='[Fail Rate City (copy)_222083803459588096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rejected])/sum([total_orders])' />
      </column>
      <column caption='VFR City' datatype='real' name='[Fail Rate City (copy)_86975827344478214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [ciudad]: sum([N_vfr])}/{fixed [ciudad]:sum([total_orders])}' />
      </column>
      <column caption='VFR Global' datatype='real' name='[Fail Rate Global (copy)_222083803461935105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([N_vfr])/sum([total_orders])' />
      </column>
      <column caption='Weeks with data' datatype='integer' name='[N_datos]' role='measure' type='quantitative' />
      <column caption='N pfr' datatype='integer' name='[N_pfr]' role='measure' type='quantitative' />
