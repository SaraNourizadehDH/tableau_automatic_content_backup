    <datasource caption='Consulta SQL personalizada' inline='true' name='federated.02a3s2c0s2e5bc17yncoh13thn74' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.175qdq517ibsn910cyg2517v19nd'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='user_diego_menjoulou' server-oauth='' username='adriano.barsanti@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.175qdq517ibsn910cyg2517v19nd' name='Consulta SQL personalizada' type='text'><![CDATA[WITH users_with_orders AS (
  SELECT
  user.id AS user_id,
  country.country_name,
  DATE_TRUNC(registered_date, month) AS month,
  COUNT(DISTINCT(order_id)) AS qty_orders
  FROM `peya-bi-tools-pro.il_core.fact_orders`
  WHERE registered_date >>= '2022-01-01'
    AND order_status = 'CONFIRMED'
    AND user.id NOT IN (SELECT user_id FROM `peya-datamarts-pro.dm_fraud.fraudulent_users`)
  GROUP BY 1,2,3
)

, active_cards AS (
  SELECT
  user_id,
  DATE_TRUNC(date_created, month) AS month_registered,
  CONCAT(bin,suffix) AS card_id,
  expiration,
  is_deleted,
  DATE_TRUNC(last_used, month) AS last_used_month
  FROM `peya-data-origins-pro.cl_payments.user_credit_card`
)

, user_detail AS(
  SELECT
  month,
  uwo.user_id,
  country_name,
  qty_orders,
  count (DISTINCT(CASE WHEN is_deleted = TRUE AND DATE(last_used_month) >>= month THEN card_id
    WHEN is_deleted = FALSE THEN card_id
    END )) AS qty_active_cards
  FROM users_with_orders uwo
  LEFT JOIN active_cards ac
    ON uwo.user_id = ac.user_id
      AND ac.expiration >>= CAST(uwo.month AS string)
      AND DATE(ac.month_registered) <<= uwo.month
  GROUP BY 1,2,3,4
)

SELECT
month,
country_name as country,
COUNT(DISTINCT(user_id)) AS users_with_orders,
COUNT(DISTINCT(CASE WHEN qty_active_cards >> 0 THEN user_id END)) AS users_with_cards,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 0 THEN user_id END)) AS cards_0,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 1 THEN user_id END)) AS cards_1,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 2 THEN user_id END)) AS cards_2,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 3 THEN user_id END)) AS cards_3,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 4 THEN user_id END)) AS cards_4,
COUNT(DISTINCT(CASE WHEN qty_active_cards >>= 5 THEN user_id END)) AS cards_5_or_more
FROM user_detail
GROUP BY 1,2
ORDER BY 2,1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.175qdq517ibsn910cyg2517v19nd' name='Consulta SQL personalizada' type='text'><![CDATA[WITH users_with_orders AS (
  SELECT
  user.id AS user_id,
  country.country_name,
  DATE_TRUNC(registered_date, month) AS month,
  COUNT(DISTINCT(order_id)) AS qty_orders
  FROM `peya-bi-tools-pro.il_core.fact_orders`
  WHERE registered_date >>= '2022-01-01'
    AND order_status = 'CONFIRMED'
    AND user.id NOT IN (SELECT user_id FROM `peya-datamarts-pro.dm_fraud.fraudulent_users`)
  GROUP BY 1,2,3
)

, active_cards AS (
  SELECT
  user_id,
  DATE_TRUNC(date_created, month) AS month_registered,
  CONCAT(bin,suffix) AS card_id,
  expiration,
  is_deleted,
  DATE_TRUNC(last_used, month) AS last_used_month
  FROM `peya-data-origins-pro.cl_payments.user_credit_card`
)

, user_detail AS(
  SELECT
  month,
  uwo.user_id,
  country_name,
  qty_orders,
  count (DISTINCT(CASE WHEN is_deleted = TRUE AND DATE(last_used_month) >>= month THEN card_id
    WHEN is_deleted = FALSE THEN card_id
    END )) AS qty_active_cards
  FROM users_with_orders uwo
  LEFT JOIN active_cards ac
    ON uwo.user_id = ac.user_id
      AND ac.expiration >>= CAST(uwo.month AS string)
      AND DATE(ac.month_registered) <<= uwo.month
  GROUP BY 1,2,3,4
)

SELECT
month,
country_name as country,
COUNT(DISTINCT(user_id)) AS users_with_orders,
COUNT(DISTINCT(CASE WHEN qty_active_cards >> 0 THEN user_id END)) AS users_with_cards,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 0 THEN user_id END)) AS cards_0,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 1 THEN user_id END)) AS cards_1,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 2 THEN user_id END)) AS cards_2,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 3 THEN user_id END)) AS cards_3,
COUNT(DISTINCT(CASE WHEN qty_active_cards = 4 THEN user_id END)) AS cards_4,
COUNT(DISTINCT(CASE WHEN qty_active_cards >>= 5 THEN user_id END)) AS cards_5_or_more
FROM user_detail
GROUP BY 1,2
ORDER BY 2,1]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
