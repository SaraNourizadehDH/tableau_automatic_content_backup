      <aliases enabled='yes' />
      <column caption='Categoría' datatype='string' name='[Calculation_564075872635592704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([product],&quot;Pila&quot;) THEN &quot;Pilas&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Gatorade&quot;) OR CONTAINS([product],&quot;Isotónica&quot;) OR CONTAINS([product],&quot;Powerade&quot;)) THEN &quot;Bebidas Isotónicas&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Red Bull&quot;) OR CONTAINS([product],&quot;Monster&quot;) OR CONTAINS([product],&quot;Energética&quot;)) THEN &quot;Bebidas Energéticas&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Lucky Strike&quot;) OR CONTAINS([product],&quot;Cigarr&quot;) OR CONTAINS([product],&quot;Cajetilla&quot;)) THEN &quot;Cigarros&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Galleta&quot;) OR CONTAINS([product],&quot;Toddy&quot;) OR CONTAINS([product],&quot;Oblea&quot;)) THEN &quot;Galletas&quot;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Hielo&quot;) THEN &quot;Hielo&quot;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Chicle&quot;) THEN &quot;Chicle&quot;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Café&quot;) THEN &quot;Café&quot;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Helado&quot;) THEN &quot;Helado&quot;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Hamburguesas&quot;) THEN &quot;Hamburguesas&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Cerveza&quot;) OR CONTAINS([product],&quot;Six Pack&quot;) OR CONTAINS([product],&quot;Becker&quot;)) THEN &quot;Cerveza&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Combo&quot;) OR CONTAINS([product],&quot;Hotdog&quot;) OR CONTAINS([product],&quot;Hot Dog&quot;) OR CONTAINS([product],&quot;Mechada&quot;) OR CONTAINS([product],&quot;Hamburguesa Classic&quot;) OR CONTAINS([product],&quot;Pizza +&quot;) OR CONTAINS([product],&quot;Empanada&quot;) OR CONTAINS([product],&quot;Chaparrita&quot;)) THEN &quot;Comida para llevar&quot;&#13;&#10;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Yoghurt&quot;) THEN &quot;Yoghurt&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Gomitas&quot;) OR CONTAINS([product],&quot;Ambrosoli&quot;)) THEN &quot;Gomitas&quot;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Pan&quot;) THEN &quot;Pan&quot; &#13;&#10;ELSEIF  CONTAINS([product],&quot;Carbón&quot;) THEN &quot;Carbón&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Sandwich&quot;) OR CONTAINS([product],&quot;Miga&quot;))  THEN &quot;Sandwich&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Cinnamon&quot;) OR CONTAINS([product],&quot;Muffin&quot;) OR CONTAINS([product],&quot;Medialuna&quot;) OR CONTAINS([product],&quot;Queque&quot;) OR CONTAINS([product],&quot;Donut&quot;)OR CONTAINS([product],&quot;Pie Limon&quot;)OR CONTAINS([product],&quot;Strudell&quot;)OR CONTAINS([product],&quot;Suspiro&quot;)OR CONTAINS([product],&quot;Rejilla&quot;)OR CONTAINS([product],&quot;Bizcocho&quot;)) THEN &quot;Pastelería&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Twix&quot;) OR CONTAINS([product],&quot;Starburst&quot;) OR CONTAINS([product],&quot;Skittles&quot;) OR CONTAINS([product],&quot;Gansito&quot;) OR CONTAINS([product],&quot;Marinela&quot;) OR CONTAINS([product],&quot;Nutrabien&quot;) OR CONTAINS([product],&quot;Alfajor&quot;) OR CONTAINS([product],&quot;Brownie&quot;) OR CONTAINS([product],&quot;Brauni&quot;)OR CONTAINS([product],&quot;Dos en Uno&quot;)) THEN &quot;Snacks Dulces&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Salchich&quot;) OR CONTAINS([product],&quot;Salame&quot;) OR CONTAINS([product],&quot;Longa&quot;) OR CONTAINS([product],&quot;Tocino&quot;)) THEN &quot;Embutidos&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Agua Mineral&quot;) OR CONTAINS([product],&quot;Agua&quot;) OR CONTAINS([product],&quot;Cachantun&quot;)) THEN &quot;Agua Mineral&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Néctar&quot;) OR CONTAINS([product],&quot;Jugo&quot;) OR CONTAINS([product],&quot;Nectar&quot;) OR CONTAINS([product],&quot;Watt&quot;))  THEN &quot;Jugo&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Ramitas&quot;) OR CONTAINS([product],&quot;Maní&quot;) OR CONTAINS([product],&quot;Marco Polo&quot;) OR CONTAINS([product],&quot;Evercrisp&quot;) OR CONTAINS([product],&quot;Lays&quot;) OR CONTAINS([product],&quot;Doritos&quot;) OR CONTAINS([product],&quot;Pringles&quot;) OR CONTAINS([product],&quot;Tika&quot;) OR CONTAINS([product],&quot;Detodito&quot;)) THEN &quot;Snacks Salados&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Chocolate&quot;) OR CONTAINS([product],&quot;Ferrero&quot;) OR CONTAINS([product],&quot;Costa Rama&quot;) OR CONTAINS([product],&quot;Huevitos&quot;)OR CONTAINS([product],&quot;Costa Rolls&quot;) OR CONTAINS([product],&quot;Bombon&quot;)) THEN &quot;Chocolate&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Bebida&quot;) OR CONTAINS([product],&quot;Gaseosa&quot;)OR CONTAINS([product],&quot;Sprite&quot;) OR CONTAINS([product],&quot;Coca Cola&quot;) OR CONTAINS([product],&quot;Coca-Cola&quot;)) THEN &quot;Bebida&quot; &#13;&#10;ELSEIF  CONTAINS([product],&quot;Queso&quot;) THEN &quot;Queso&quot;&#13;&#10;ELSEIF  CONTAINS([product],&quot;Leche&quot;) THEN &quot;Leche&quot;&#13;&#10;ELSEIF  (CONTAINS([product],&quot;Jamón&quot;) OR CONTAINS([product],&quot;Jamon&quot;)) THEN &quot;Jamón&quot;&#13;&#10;END' />
      </column>
