            <connection CATALOG='peya-markets' EXECCATALOG='peya-markets' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-markets' schema='automated_tables_reports' server-oauth='' username='guillermo.gadea@pedidosya.com' workgroup-auth-mode='prompt' />
