      <aliases enabled='yes' />
      <column caption='Vendor Fail Rate Current' datatype='real' default-format='p0.0%' name='[Calculation_1136877454894026752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [qty_orders_current]&gt;0&#13;&#10;THEN ROUND([qty_orders_owner_current]*1 / [qty_orders_current],4)&#13;&#10;END' />
      </column>
      <column caption='Is Zombie' datatype='boolean' name='[Calculation_1337006163331936256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ([qty_orders_current_confirmed]=0 OR  [qty_orders_current_confirmed]=NULL)&#13;&#10;AND  [restaurant_state_id]=1&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
