          </metadata-record>
          <metadata-record class='column'>
            <remote-name>registered_date</remote-name>
            <remote-type>7</remote-type>
            <local-name>[registered_date]</local-name>
            <parent-name>[Consulta SQL personalizada]</parent-name>
            <remote-alias>registered_date</remote-alias>
            <local-type>date</local-type>
