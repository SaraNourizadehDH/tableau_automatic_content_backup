      <column caption='#Chats comparisonPeriod' datatype='integer' name='[#Cases comparisonPeriod (copia)_929148907777073160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    [Calculation_929148907764584451] = &quot;Comparison Period&quot;&#13;&#10;THEN&#13;&#10;    [orders_with_chats]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
