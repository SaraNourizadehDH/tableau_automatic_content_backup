            <column alias='Months' caption='datePart' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Days' />
                <alias key='&quot;month&quot;' value='Months' />
                <alias key='&quot;week&quot;' value='Weeks' />
              </aliases>
            </column>
            <column caption='Headers Dimension' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reason Level 3&quot;'>
              <calculation class='tableau' formula='&quot;Reason Level 3&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qi1y8518zfizx198as4a0zer1rv'>
            <column caption='#Chats comparisonPeriod' datatype='integer' name='[#Cases comparisonPeriod (copia)_929148907777073160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [Calculation_929148907764584451] = &quot;Comparison Period&quot;&#13;&#10;THEN&#13;&#10;    [orders_with_chats]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='#Chats currentPeriod' datatype='integer' name='[#Cases currentPeriod (copia)_929148907776704517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [Calculation_929148907763970050] = &quot;Current Period&quot;&#13;&#10;THEN&#13;&#10;    [orders_with_chats]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='#Cases comparisonPeriod' datatype='integer' name='[#Cases currentPeriod (copia)_929148907776942087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [Calculation_929148907764584451] = &quot;Comparison Period&quot;&#13;&#10;THEN&#13;&#10;    [orders_with_cases]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='#Orders comparisonPeriod' datatype='integer' name='[#Chats comparisonPeriod (copia)_929148907779063820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [Calculation_929148907764584451] = &quot;Comparison Period&quot;&#13;&#10;THEN&#13;&#10;    [orders]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='#Orders currentPeriod' datatype='integer' name='[#Chats currentPeriod (copia)_929148907778969611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [Calculation_929148907763970050] = &quot;Current Period&quot;&#13;&#10;THEN&#13;&#10;    [orders]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='CaseRate' datatype='real' default-format='p0.0%' name='[CR (copia)_929148907781894165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_cases])/SUM([orders])' />
            </column>
            <column caption='ChatRate' datatype='real' default-format='p0.0%' name='[CR (copia)_929148907782062102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_chats])/SUM([orders])' />
            </column>
            <column caption='CaseRate comparisonPeriod' datatype='real' default-format='p0.0%' name='[CR comparisonPeriod (copia)_929148907781185554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([#Cases currentPeriod (copia)_929148907776942087])/SUM([#Chats comparisonPeriod (copia)_929148907779063820])' />
            </column>
            <column caption='CR comparisonPeriod' datatype='real' default-format='p0.0%' name='[CR currentPeriod (copia)_929148907780755472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([#Cases currentPeriod (copia)_929148907776942087])+SUM([#Cases comparisonPeriod (copia)_929148907777073160]))/SUM([#Chats comparisonPeriod (copia)_929148907779063820])' />
            </column>
            <column caption='CaseRate currentPeriod' datatype='real' default-format='p0.0%' name='[CR currentPeriod (copia)_929148907780968465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_929148907776516100])/SUM([#Chats currentPeriod (copia)_929148907778969611])' />
            </column>
            <column caption='maxDate measure' datatype='date' default-format='*d/m/yyyy' name='[Calculation_929148907762577409]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([date])}' />
            </column>
            <column caption='currentPeriod' datatype='string' name='[Calculation_929148907763970050]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC([Parameters].[Parámetro 1],[date]) = DATETRUNC([Parameters].[Parámetro 1],[Calculation_929148907762577409]) &#13;&#10;THEN &apos;Current Period&apos;&#13;&#10;END' />
            </column>
            <column caption='comparisonPeriod' datatype='string' name='[Calculation_929148907764584451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC([Parameters].[Parámetro 1],[date])=DATEADD([Parameters].[Parámetro 1],-1,DATETRUNC([Parameters].[Parámetro 1],[Calculation_929148907762577409]))&#13;&#10;THEN &apos;Comparison Period&apos;&#13;&#10;END' />
            </column>
            <column caption='#Cases currentPeriod' datatype='integer' name='[Calculation_929148907776516100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    [Calculation_929148907763970050] = &quot;Current Period&quot;&#13;&#10;THEN&#13;&#10;    [orders_with_cases]&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
            </column>
            <column caption='Contat Rate' datatype='real' default-format='p0.0%' name='[Calculation_929148907780210702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_with_cases])+SUM([orders_with_chats]))/SUM([orders])' />
            </column>
            <column caption='CR currentPeriod' datatype='real' default-format='p0.0%' name='[Calculation_929148907780571151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_929148907776516100])+SUM([#Cases currentPeriod (copia)_929148907776704517]))/SUM([#Chats currentPeriod (copia)_929148907778969611])' />
            </column>
            <column caption='Headers Measure' datatype='string' name='[Calculation_929148908044120090]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    &#13;&#10;    WHEN &quot;Total&quot; THEN &quot;Total&quot;&#13;&#10;    WHEN &quot;Franchise&quot; THEN [franchise_name]&#13;&#10;    WHEN &quot;Restaurant Name&quot; THEN [restaurant_name]&#13;&#10;    WHEN &quot;Delivery Type&quot; THEN [deliveryType]&#13;&#10;    WHEN &quot;Business Type&quot; THEN [Calculation_929148908047847451]&#13;&#10;    WHEN &quot;Vertical&quot; THEN [vertical]&#13;&#10;    WHEN &quot;Main Cuisine&quot; THEN &quot;PROGRAMAR!!&quot;&#13;&#10;    WHEN &quot;Order State&quot; THEN [state]&#13;&#10;    WHEN &quot;Payment Method&quot; THEN [paymentMethod]&#13;&#10;    WHEN &quot;Reason Level 1&quot; THEN [reason_level_1]&#13;&#10;    WHEN &quot;Reason Level 2&quot; THEN [reason_level_2]&#13;&#10;    WHEN &quot;Reason Level 3&quot; THEN [reason_level_3]&#13;&#10;&#13;&#10;    ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Business Type' datatype='string' name='[Calculation_929148908047847451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    [vertical] = &quot;RESTAURANT&quot; OR [vertical] = &quot;COFFEE&quot;&#13;&#10;THEN &#13;&#10;    &quot;Food&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Quick Commerce&quot;&#13;&#10;END' />
            </column>
