            <column alias='month' caption='Period' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
              <aliases>
                <alias key='&quot;accum&quot;' value='accum to' />
                <alias key='&quot;monthly&quot;' value='month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z07vkn1k2a2i012qheor1ktlnaa'>
            <column caption='Actual_month' datatype='boolean' name='[Actual_month_y (copia)_1081989861835644931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;monthly&quot; then &#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] &gt;= MONTH([registered_date_month])&#13;&#10;&#13;&#10;END' />
