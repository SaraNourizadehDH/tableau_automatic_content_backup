    <worksheet name='Orders'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0z07vkn1k2a2i012qheor1ktlnaa' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='apr' caption='Month' datatype='integer' name='[Parámetro 1]' param-domain-type='list' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <aliases>
                <alias key='1' value='jan' />
                <alias key='2' value='feb' />
                <alias key='3' value='mar' />
                <alias key='4' value='apr' />
                <alias key='5' value='may' />
                <alias key='6' value='jun' />
                <alias key='7' value='jul' />
                <alias key='8' value='aug' />
                <alias key='9' value='sep' />
                <alias key='10' value='oct' />
                <alias key='11' value='nov' />
                <alias key='12' value='dec' />
              </aliases>
            </column>
            <column alias='month' caption='Period' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
              <aliases>
                <alias key='&quot;accum&quot;' value='accum to' />
                <alias key='&quot;monthly&quot;' value='month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z07vkn1k2a2i012qheor1ktlnaa'>
            <column caption='Actual_year' datatype='boolean' name='[Actual_month (copia)_1022598643432964113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year({ FIXED :MAX([registered_date_month])}) = year([registered_date_month])' />
            </column>
            <column caption='[confirmed_orders_qc]/1000' datatype='real' name='[Calculation_1022598643468337231]' role='measure' type='quantitative' user:unnamed='Orders'>
              <calculation class='tableau' formula='[Calculation_1081989861820411904]/1000' />
            </column>
            <column caption='confirmed_orders_qc' datatype='integer' name='[Calculation_1081989861820411904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_dmart])+SUM([confirmed_orders_ls])' />
            </column>
            <column caption='Actual_month_y' datatype='boolean' name='[Calculation_1081989861831188481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;monthly&quot; then &#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;AND [Actual_month (copia)_1022598643432964113] = true&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] &gt;= MONTH([registered_date_month])&#13;&#10;AND [Actual_month (copia)_1022598643432964113] = true&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[confirmed_orders_dmart]' role='measure' type='quantitative' />
            <column datatype='integer' name='[confirmed_orders_ls]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1081989861831188481]' derivation='None' name='[none:Calculation_1081989861831188481:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[registered_date_month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1022598643468337231]' derivation='User' name='[usr:Calculation_1022598643468337231:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0z07vkn1k2a2i012qheor1ktlnaa].[none:Calculation_1081989861831188481:nk]'>
            <groupfilter function='member' level='[none:Calculation_1081989861831188481:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
