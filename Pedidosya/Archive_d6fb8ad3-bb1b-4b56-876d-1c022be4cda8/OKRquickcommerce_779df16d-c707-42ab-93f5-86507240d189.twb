              <calculation class='tableau' formula='SUM([shippin_amount_no_discount_dmart_eur])/&#13;&#10;sum([confirmed_orders_dmart])' />
            </column>
            <column caption='Avg DF ls' datatype='real' name='[Avg DF dmart (copia)_1041457467354959881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shippin_amount_no_discount_ls_eur])/&#13;&#10;sum([confirmed_orders_ls])' />
            </column>
            <column caption='Avg SF dmart' datatype='real' name='[Avg SF (copia)_1041457467355680779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_total_amount_dmart])&#13;&#10;/&#13;&#10;sum([confirmed_orders_dmart])' />
            </column>
            <column caption='Avg SF ls' datatype='real' name='[Avg SF dmart (copia)_1041457467355762700]' role='measure' type='quantitative'>
