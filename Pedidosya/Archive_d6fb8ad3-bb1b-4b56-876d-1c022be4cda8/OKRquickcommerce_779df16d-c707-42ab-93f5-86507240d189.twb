    <worksheet name='Ops_NPS_ls/dmart'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0z07vkn1k2a2i012qheor1ktlnaa' />
          </datasources>
          <datasource-dependencies datasource='federated.0z07vkn1k2a2i012qheor1ktlnaa'>
            <column caption='Fail Rate' datatype='real' name='[Calculation_1041457467362078745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders])&#13;&#10;/&#13;&#10;(&#13;&#10;[Calculation_1081989861820411904] + sum([non_confirmed_orders]))' />
            </column>
            <column caption='avg Delivery time' datatype='real' name='[Calculation_1041457467363090460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_delivery_time_dmart])+SUM([total_delivery_time_ls]))&#13;&#10;/[Calculation_1081989861820411904]' />
            </column>
            <column caption='NPS' datatype='real' name='[Calculation_1041457467363659807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cant_response_promoters])&#13;&#10;-&#13;&#10;SUM([cant_response_detractors])) * 100/SUM([cant_responses])' />
            </column>
            <column caption='&apos;Ops&apos;' datatype='string' name='[Calculation_1057783015294226438]' role='dimension' type='nominal' user:unnamed='Ops_resume'>
              <calculation class='tableau' formula='&apos;Ops&apos;' />
            </column>
            <column caption='confirmed_orders_qc' datatype='integer' name='[Calculation_1081989861820411904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_dmart])+SUM([confirmed_orders_ls])' />
            </column>
            <column caption='Fail Rate ls' datatype='real' name='[Fail Rate (copia)_1041457467362242586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_ls])&#13;&#10;/&#13;&#10;(&#13;&#10;sum([confirmed_orders_ls]) + sum([non_confirmed_orders_ls]))' />
            </column>
            <column caption='Fail Rate dmart' datatype='real' name='[Fail Rate ls (copia)_1041457467362471963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_dmart])&#13;&#10;/&#13;&#10;(&#13;&#10;sum([confirmed_orders_dmart]) + sum([non_confirmed_orders_dmart]))' />
            </column>
            <column caption='NPS dmart' datatype='real' name='[NPS (copia)_1041457467364212768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cant_response_promoters_dmart])&#13;&#10;-&#13;&#10;SUM([cant_response_detractors_dmart])) * 100/SUM([cant_responses_dmart])' />
            </column>
            <column caption='NPS ls' datatype='real' name='[NPS dmart (copia)_1041457467364302881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cant_response_promoters_ls])&#13;&#10;-&#13;&#10;SUM([cant_response_detractors_ls])) * 100/SUM([cant_responses_ls])' />
            </column>
            <column caption='avg Delivery time dmart' datatype='real' name='[avg Delivery time (copia)_1041457467363254301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_time_dmart])/sum([confirmed_orders_dmart])' />
            </column>
            <column caption='avg Delivery time ls' datatype='real' name='[avg Delivery time dmart (copia)_1041457467363340318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_time_ls])/sum([confirmed_orders_ls])' />
            </column>
