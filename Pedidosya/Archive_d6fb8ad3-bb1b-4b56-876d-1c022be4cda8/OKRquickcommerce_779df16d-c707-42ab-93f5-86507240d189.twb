            <column caption='Sem_delivery_time_ls' datatype='string' name='[Sem_fail_rate_qc (copia)_1087900837454274671]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN(([avg Delivery time dmart (copia)_1041457467363340318])) - LOOKUP(ZN(([avg Delivery time dmart (copia)_1041457467363340318])), -1)) /&#13;&#10; ABS(LOOKUP(ZN(([avg Delivery time dmart (copia)_1041457467363340318])), -1)) &gt; 0 THEN &quot;1&quot; ELSE &quot;0&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='avg Delivery time ls' datatype='real' name='[avg Delivery time dmart (copia)_1041457467363340318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_time_ls])/sum([confirmed_orders_ls])' />
