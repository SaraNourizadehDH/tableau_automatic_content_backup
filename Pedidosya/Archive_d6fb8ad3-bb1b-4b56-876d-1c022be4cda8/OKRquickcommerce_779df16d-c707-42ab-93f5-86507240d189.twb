            </column>
            <column caption='Share gmv dmarts (%)' datatype='real' name='[% GMV ls (copia)_1087900837382561852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_dmart_euro])&#13;&#10;/&#13;&#10;sum([total_gmv_euro])' />
            </column>
            <column caption='Actual_year' datatype='boolean' name='[Actual_month (copia)_1022598643432964113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year({ FIXED :MAX([registered_date_month])}) = year([registered_date_month])' />
            </column>
            <column caption='Month_MoM' datatype='boolean' name='[Calculation_1022598643530559571]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Actual_month (copia)_1022598643432964113] = TRUE&#13;&#10;THEN&#13;&#10;&#13;&#10;(&#13;&#10;IF [Parameters].[Parámetro 1] = 1 THEN&#13;&#10;12 =  MONTH([registered_date_month])     OR &#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;ELSE&#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month]) OR &#13;&#10;[Parameters].[Parámetro 1]-1 = MONTH([registered_date_month])&#13;&#10;END&#13;&#10;)&#13;&#10;ELSE&#13;&#10;IF [Parameters].[Parámetro 1] = 1 THEN&#13;&#10;12 =  MONTH([registered_date_month])     OR &#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='confirmed_orders_qc' datatype='integer' name='[Calculation_1081989861820411904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_dmart])+SUM([confirmed_orders_ls])' />
            </column>
            <column caption='gmv_qc_euro' datatype='real' name='[Calculation_1081989861843992588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_dmart_euro])+&#13;&#10;SUM([gmv_local_stores_euro])' />
            </column>
