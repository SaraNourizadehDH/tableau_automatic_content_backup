            <column caption='Sem_penetration ls' datatype='string' name='[Sem_penetration (copia)_1120270460074090525]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN(([penetration_dmart (copia)_1120270460034404367])) - LOOKUP(ZN(([penetration_dmart (copia)_1120270460034404367])), -1)) /&#13;&#10; ABS(LOOKUP(ZN(([penetration_dmart (copia)_1120270460034404367])), -1)) &gt; 0 THEN &quot;1&quot; ELSE &quot;0&quot; END'>
                <table-calc ordering-type='Rows' />
