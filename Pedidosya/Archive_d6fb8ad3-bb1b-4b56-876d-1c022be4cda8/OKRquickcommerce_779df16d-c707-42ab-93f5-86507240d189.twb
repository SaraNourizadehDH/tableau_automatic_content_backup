              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;monthly&quot; then &#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] &gt;= MONTH([registered_date_month])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Sem_NewCustomer' datatype='string' name='[Calculation_1087900837314691075]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if (ZN(SUM([cant_new_customer_qc])) - LOOKUP(ZN(SUM([cant_new_customer_qc])), -1)) /&#13;&#10; ABS(LOOKUP(ZN(SUM([cant_new_customer_qc])), -1)) &gt; 0 then &quot;1&quot; else &quot;0&quot; END'>
