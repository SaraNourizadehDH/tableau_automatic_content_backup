              <calculation class='tableau' formula='([avg DF + avg SF qc (copia)_1120270460039884820]) / ([AFV (copia)_1041457467327975426])' />
            </column>
            <column caption='(avg DF + avg SF)/ ( AFV) ls' datatype='real' name='[(avg DF + avg SF)/ ( AFV) qc (copia)_1120270460040335383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([avg DF + avg SF dmart (copia)_1120270460039938069]) / ([AFV Dmart (copia)_1041457467329327107])' />
            </column>
            <column caption='AFV Dmart' datatype='real' name='[AFV (copia)_1041457467327975426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_amount_dmart_EURO])/sum([confirmed_orders_dmart])' />
            </column>
            <column caption='AFV LS' datatype='real' name='[AFV Dmart (copia)_1041457467329327107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_amount_local_stores_EURO])/sum([confirmed_orders_ls])' />
            </column>
