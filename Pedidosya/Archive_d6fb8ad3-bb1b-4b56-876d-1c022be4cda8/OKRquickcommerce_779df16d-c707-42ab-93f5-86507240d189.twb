              <calculation class='tableau' formula='IF (ZN(sum([gmv_dmart_euro])) - LOOKUP(ZN(sum([gmv_dmart_euro])), -1)) &#13;&#10;/ ABS(LOOKUP(ZN(sum([gmv_dmart_euro])), -1)) &gt; 0 THEN &quot;1&quot; ELSE &quot;0&quot; END'>
