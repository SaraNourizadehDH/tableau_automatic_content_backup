            </column>
            <column caption='Frequency_ls' datatype='real' name='[Frequency_QC (copia)_1120270460077703203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_ls])/&#13;&#10;sum([active_customers_ls])' />
