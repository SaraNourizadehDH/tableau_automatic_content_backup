    <worksheet name='zombie_partners_ls_kpi'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='8'>Var % MoM:</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0z07vkn1k2a2i012qheor1ktlnaa' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='apr' caption='Month' datatype='integer' name='[Parámetro 1]' param-domain-type='list' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <aliases>
                <alias key='1' value='jan' />
                <alias key='2' value='feb' />
                <alias key='3' value='mar' />
                <alias key='4' value='apr' />
                <alias key='5' value='may' />
                <alias key='6' value='jun' />
                <alias key='7' value='jul' />
                <alias key='8' value='aug' />
                <alias key='9' value='sep' />
                <alias key='10' value='oct' />
                <alias key='11' value='nov' />
                <alias key='12' value='dec' />
              </aliases>
            </column>
            <column alias='month' caption='Period' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
              <aliases>
                <alias key='&quot;accum&quot;' value='accum to' />
                <alias key='&quot;monthly&quot;' value='month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z07vkn1k2a2i012qheor1ktlnaa'>
            <column caption='Actual_month' datatype='boolean' name='[Actual_month_y (copia)_1081989861835644931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;monthly&quot; then &#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] &gt;= MONTH([registered_date_month])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='SUM(0)' datatype='integer' name='[Calculation_1087900837316632582]' role='measure' type='quantitative' user:unnamed='Orders_kpi'>
              <calculation class='tableau' formula='SUM(0)' />
            </column>
            <column caption='index_str' datatype='string' datatype-customized='true' name='[Calculation_1087900837336371212]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(INDEX())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sem_zombies_partner' datatype='string' name='[Sem_Activecustomers (copia)_1087900837441744993]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN(sum([qty_ls_zombies])) - LOOKUP(ZN(sum([qty_ls_zombies])), -1)) /&#13;&#10; ABS(LOOKUP(ZN(sum([qty_ls_zombies])), -1)) &gt; 0 THEN &quot;1&quot; ELSE &quot;0&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
