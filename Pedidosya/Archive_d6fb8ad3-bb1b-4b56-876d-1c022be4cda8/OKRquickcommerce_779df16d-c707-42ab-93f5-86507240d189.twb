              </aliases>
            </column>
            <column alias='month' caption='Period' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
              <aliases>
                <alias key='&quot;accum&quot;' value='accum to' />
                <alias key='&quot;monthly&quot;' value='month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z07vkn1k2a2i012qheor1ktlnaa'>
            <column caption='Actual_month' datatype='boolean' name='[Actual_month_y (copia)_1081989861835644931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;monthly&quot; then &#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;[Parameters].[Parámetro 1] &gt;= MONTH([registered_date_month])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='index_str' datatype='string' datatype-customized='true' name='[Calculation_1087900837336371212]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(INDEX())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='sum(0)' datatype='integer' name='[Calculation_1087900837361930275]' role='measure' type='quantitative' user:unnamed='Kpi Abs'>
              <calculation class='tableau' formula='sum(0)' />
            </column>
            <column caption='sum(1-1)' datatype='integer' name='[Calculation_1087900837362724906]' role='measure' type='quantitative' user:unnamed='Kpi Abs'>
              <calculation class='tableau' formula='sum(1-1)' />
            </column>
            <column caption='&quot;Dmart&quot;' datatype='string' name='[Calculation_1120270460085596203]' role='dimension' type='nominal' user:unnamed='Kpi_active_qc_partners_dmart'>
              <calculation class='tableau' formula='&quot;Dmart&quot;' />
            </column>
            <column caption='Sem_ActiveDmarts' datatype='string' name='[Sem_ActiveQC (copia)_1087900837421650001]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN(sum([active_dmarts])) - LOOKUP(ZN(sum([active_dmarts])), -1)) /&#13;&#10; ABS(LOOKUP(ZN(sum([active_dmarts])), -1)) &gt; 0 THEN &quot;1&quot; ELSE &quot;0&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[active_dmarts]' role='measure' type='quantitative' />
