            <column caption='&quot;Dmart&quot;' datatype='string' name='[Calculation_1087900837496791175]' role='dimension' type='nominal' user:unnamed='Kpi detail_dmart_adf'>
              <calculation class='tableau' formula='&quot;Dmart&quot;' />
            </column>
            <column caption='Sem_avg_df ls' datatype='string' name='[Sem_avg_df (copia)_1087900837487358080]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN(([Avg DF dmart (copia)_1041457467354959881])) - LOOKUP(ZN(([Avg DF dmart (copia)_1041457467354959881])), -1)) /&#13;&#10; ABS(LOOKUP(ZN(([Avg DF dmart (copia)_1041457467354959881])), -1)) &gt; 0 THEN &quot;1&quot; ELSE &quot;0&quot; END'>
