    <worksheet name='Financials_resume_var_month'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0z07vkn1k2a2i012qheor1ktlnaa' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='apr' caption='Month' datatype='integer' name='[Parámetro 1]' param-domain-type='list' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <aliases>
                <alias key='1' value='jan' />
                <alias key='2' value='feb' />
                <alias key='3' value='mar' />
                <alias key='4' value='apr' />
                <alias key='5' value='may' />
                <alias key='6' value='jun' />
                <alias key='7' value='jul' />
                <alias key='8' value='aug' />
                <alias key='9' value='sep' />
                <alias key='10' value='oct' />
                <alias key='11' value='nov' />
                <alias key='12' value='dec' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z07vkn1k2a2i012qheor1ktlnaa'>
            <column caption='(avg DF + avg SF)/ ( AFV) dmart' datatype='real' name='[(avg DF + avg SF)/ ( AFV) qc (copia) (copia)_1120270460040343576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([avg DF + avg SF qc (copia)_1120270460039884820]) / ([AFV (copia)_1041457467327975426])' />
            </column>
            <column caption='(avg DF + avg SF)/ ( AFV) ls' datatype='real' name='[(avg DF + avg SF)/ ( AFV) qc (copia)_1120270460040335383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([avg DF + avg SF dmart (copia)_1120270460039938069]) / ([AFV Dmart (copia)_1041457467329327107])' />
            </column>
            <column caption='AFV Dmart' datatype='real' name='[AFV (copia)_1041457467327975426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_amount_dmart_EURO])/sum([confirmed_orders_dmart])' />
            </column>
            <column caption='AFV LS' datatype='real' name='[AFV Dmart (copia)_1041457467329327107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_amount_local_stores_EURO])/sum([confirmed_orders_ls])' />
            </column>
            <column caption='Actual_year' datatype='boolean' name='[Actual_month (copia)_1022598643432964113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year({ FIXED :MAX([registered_date_month])}) = year([registered_date_month])' />
            </column>
            <column caption='Avg DF dmart' datatype='real' name='[Avg DF (copia)_1041457467351941128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shippin_amount_no_discount_dmart_eur])/&#13;&#10;sum([confirmed_orders_dmart])' />
            </column>
            <column caption='Avg DF ls' datatype='real' name='[Avg DF dmart (copia)_1041457467354959881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shippin_amount_no_discount_ls_eur])/&#13;&#10;sum([confirmed_orders_ls])' />
            </column>
            <column caption='Avg SF dmart' datatype='real' name='[Avg SF (copia)_1041457467355680779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_total_amount_dmart])&#13;&#10;/&#13;&#10;sum([confirmed_orders_dmart])' />
            </column>
            <column caption='Avg SF ls' datatype='real' name='[Avg SF dmart (copia)_1041457467355762700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_total_amount_ls])&#13;&#10;/&#13;&#10;sum([confirmed_orders_ls])' />
            </column>
            <column caption='Month_MoM' datatype='boolean' name='[Calculation_1022598643530559571]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Actual_month (copia)_1022598643432964113] = TRUE&#13;&#10;THEN&#13;&#10;&#13;&#10;(&#13;&#10;IF [Parameters].[Parámetro 1] = 1 THEN&#13;&#10;12 =  MONTH([registered_date_month])     OR &#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;ELSE&#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month]) OR &#13;&#10;[Parameters].[Parámetro 1]-1 = MONTH([registered_date_month])&#13;&#10;END&#13;&#10;)&#13;&#10;ELSE&#13;&#10;IF [Parameters].[Parámetro 1] = 1 THEN&#13;&#10;12 =  MONTH([registered_date_month])     OR &#13;&#10;[Parameters].[Parámetro 1] = MONTH([registered_date_month])&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_1041457467327680513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_550565115329929216])/([Calculation_1081989861820411904])' />
            </column>
            <column caption='Avg DF' datatype='real' name='[Calculation_1041457467350478855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shippin_amount_no_discount_eur])/&#13;&#10;[Calculation_1081989861820411904]' />
            </column>
            <column caption='Avg SF' datatype='real' name='[Calculation_1041457467355570186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_total_amount])&#13;&#10;/&#13;&#10;[Calculation_1081989861820411904]' />
            </column>
            <column caption='confirmed_orders_qc' datatype='integer' name='[Calculation_1081989861820411904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_dmart])+SUM([confirmed_orders_ls])' />
            </column>
            <column caption='index_str' datatype='string' datatype-customized='true' name='[Calculation_1087900837336371212]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(INDEX())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='&apos;Financials&apos;' datatype='string' name='[Calculation_1120270460035293200]' role='dimension' type='nominal' user:unnamed='Financials_resume'>
              <calculation class='tableau' formula='&apos;Financials&apos;' />
            </column>
            <column caption='avg DF + avg SF qc' datatype='real' name='[Calculation_1120270460039688211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1041457467350478855])+&#13;&#10;([Calculation_1041457467355570186])' />
            </column>
            <column caption='(avg DF + avg SF)/ ( AFV) qc' datatype='real' name='[Calculation_1120270460040097814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1120270460039688211]) / ([Calculation_1041457467327680513])' />
