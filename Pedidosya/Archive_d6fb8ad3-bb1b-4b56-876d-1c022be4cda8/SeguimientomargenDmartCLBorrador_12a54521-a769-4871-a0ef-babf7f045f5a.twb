      <column caption='Costos y merma' datatype='real' name='[Calculation_1816639555561295883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([costos])-sum([adjustment_value_lc])' />
      </column>
      <column caption='Medida' datatype='real' name='[Campo (copia)_1586955969938436106]' role='measure' type='ordinal'>
