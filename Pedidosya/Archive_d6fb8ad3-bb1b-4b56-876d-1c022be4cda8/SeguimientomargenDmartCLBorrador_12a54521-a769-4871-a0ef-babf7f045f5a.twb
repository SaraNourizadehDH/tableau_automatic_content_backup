    <worksheet name='Calculos Fixed'>
      <table>
        <view>
          <datasources>
            <datasource caption='seguimiento_margen_tableau (user_camilo_zelada)' name='federated.00f4jn51tr7x5f0zw419s0u560wa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Date Parameter' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
              </aliases>
            </column>
            <column caption='Agrupado por' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Store Name&quot;'>
              <calculation class='tableau' formula='&quot;Store Name&quot;' />
              <aliases>
                <alias key='&quot;Campaign (Partnership agrupado)&quot;' value='Campaign (Campañas agrupadas)' />
              </aliases>
            </column>
            <column caption='Medida' datatype='string' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Margen ponderado&quot;'>
              <calculation class='tableau' formula='&quot;Margen ponderado&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00f4jn51tr7x5f0zw419s0u560wa'>
            <column caption='Slowmover/Zeromover' datatype='string' name='[Calculation_1554586300228530176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([type_sm]),&quot;No SM/ZM&quot;,[type_sm])' />
            </column>
            <column caption='Status SKU' datatype='string' name='[Calculation_1554586300228976641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([sku_supplier_status]=&quot;ACTIVE&quot;,&quot;ACTIVE&quot;,&quot;DISABLED&quot;)' />
            </column>
            <column caption='venta con descuento' datatype='real' name='[Calculation_1586955969932386304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([venta])-sum([descuentos])' />
            </column>
            <column caption='Fecha' datatype='date' name='[Calculation_1586955969933496321]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATETRUNC([Parameters].[Parámetro 1], [order_date]))' />
            </column>
            <column caption='Margen' datatype='real' name='[Calculation_1586955969933893634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum(costos)/[Calculation_1586955969932386304])' />
            </column>
            <column caption='fixed venta con descuento' datatype='real' name='[Calculation_1586955969934696451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1586955969935396869],[Calculation_1586955969933496321]:[Calculation_1586955969932386304]}' />
            </column>
            <column caption='Campo' datatype='string' name='[Calculation_1586955969935396869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parámetro 2]&#13;&#10;when &quot;L1&quot; then [l1]&#13;&#10;when &quot;L2&quot; then [l2]&#13;&#10;when &quot;Campaign&quot; then [campaign]&#13;&#10;when &quot;Store Name&quot; then [store_name]&#13;&#10;when &quot;Product Name&quot; then [product_name]&#13;&#10;when &quot;Campaign (Partnership agrupado)&quot; then [Calculation_1586955969972293643]&#13;&#10;when &quot;Marca generica&quot; then [marca_generica]&#13;&#10;when &quot;Proveedor generico&quot; then [proveedor_generico]&#13;&#10;when &quot;Specialty&quot; then [specialty]&#13;&#10;when &quot;Almacenamiento&quot; then [almacenamiento]&#13;&#10;when &quot;Grupo&quot; then [grupo]&#13;&#10;when &quot;Seccion&quot; then [seccion]&#13;&#10;end' />
            </column>
            <column caption='Fixed venta con descuento total' datatype='real' name='[Calculation_1586955969936830470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1586955969933496321]:[Calculation_1586955969932386304]}' />
            </column>
            <column caption='Peso venta' datatype='real' name='[Calculation_1586955969937272839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1586955969934696451]/[Calculation_1586955969936830470]' />
            </column>
            <column caption='Margen ponderado' datatype='real' name='[Calculation_1586955969937367048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1586955969933893634]*sum([Calculation_1586955969937272839])' />
            </column>
            <column caption='Campaña2' datatype='string' name='[Calculation_1586955969972293643]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if STARTSWITH([campaign],&apos;PS&apos;) then &apos;Campañas Partnership&apos;&#13;&#10;ELSEIF STARTSWITH([campaign],&apos;SUPERWEEK&apos;) then &apos;Superweek&apos;&#13;&#10;ELSEIF STARTSWITH([campaign],&apos;TRONCAL&apos;) then &apos;Troncal&apos;&#13;&#10;ELSEIF STARTSWITH([campaign],&apos;SMZM&apos;) then &apos;Slowmover/Zeromover&apos;&#13;&#10;ELSEIF CONTAINS([campaign],&apos;ZEROMOVERS&apos;) then &apos;Slowmover/Zeromover&apos;&#13;&#10;ELSEIF CONTAINS([campaign],&apos;FRESH DAYS&apos;) then &apos;Fresh days&apos;&#13;&#10;ELSEIF CONTAINS([campaign],&apos;MERMA&apos;) then &apos;Merma&apos;&#13;&#10;ELSEIF CONTAINS([campaign],&apos;APT&apos;) then &apos;APT&apos;&#13;&#10;else [campaign] END' />
            </column>
            <column caption='Medida' datatype='real' name='[Campo (copia)_1586955969938436106]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parámetro 3]&#13;&#10;when &quot;Margen&quot; then [Calculation_1586955969933893634]&#13;&#10;when &quot;Peso&quot; then sum([Calculation_1586955969937272839])&#13;&#10;when &quot;Margen ponderado&quot; then [Calculation_1586955969937367048]&#13;&#10;end' />
            </column>
            <column datatype='string' name='[almacenamiento]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Sin informacion' />
              </aliases>
            </column>
