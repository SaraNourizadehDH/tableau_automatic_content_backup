    <worksheet name='Margen con merma'>
      <table>
        <view>
          <datasources>
            <datasource caption='seguimiento_margen_tableau (user_camilo_zelada)' name='federated.00f4jn51tr7x5f0zw419s0u560wa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Agrupado por sin campaña' datatype='string' name='[Agrupado por (copia)_1816639555223298051]' param-domain-type='list' role='measure' type='nominal' value='&quot;Store Name&quot;'>
              <calculation class='tableau' formula='&quot;Store Name&quot;' />
            </column>
            <column alias='Month' caption='Date Parameter' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00f4jn51tr7x5f0zw419s0u560wa'>
            <column caption='Slowmover/Zeromover' datatype='string' name='[Calculation_1554586300228530176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([type_sm]),&quot;No SM/ZM&quot;,[type_sm])' />
            </column>
            <column caption='Status SKU' datatype='string' name='[Calculation_1554586300228976641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([sku_supplier_status]=&quot;ACTIVE&quot;,&quot;ACTIVE&quot;,&quot;DISABLED&quot;)' />
            </column>
            <column caption='Tiendas con producto activo' datatype='integer' name='[Calculation_1554586300231970820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([Calculation_1554586300228976641]=&quot;ACTIVE&quot;,[warehouse_id],null))' />
            </column>
            <column caption='Tiendas con Slowmovers' datatype='integer' name='[Calculation_1554586300233371653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([Calculation_1554586300228530176]=&apos;SM&apos;,[warehouse_id],null))' />
            </column>
            <column caption='venta con descuento' datatype='real' name='[Calculation_1586955969932386304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([venta])-sum([descuentos])' />
            </column>
            <column caption='Fecha' datatype='date' name='[Calculation_1586955969933496321]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATETRUNC([Parameters].[Parámetro 1], [order_date]))' />
            </column>
            <column caption='Margen' datatype='real' name='[Calculation_1586955969933893634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum(costos)/[Calculation_1586955969932386304])' />
            </column>
            <column caption='Shrinkage' datatype='real' name='[Calculation_1816639555221405696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([adjustment_value_lc])/[Calculation_1586955969932386304]' />
            </column>
            <column caption='Campo sin campaña' datatype='string' name='[Campo (copia)_1816639555223375876]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Agrupado por (copia)_1816639555223298051]&#13;&#10;when &quot;L1&quot; then [l1]&#13;&#10;when &quot;L2&quot; then [l2]&#13;&#10;when &quot;Campaign&quot; then [campaign]&#13;&#10;when &quot;Store Name&quot; then [store_name]&#13;&#10;when &quot;Product Name&quot; then [product_name]&#13;&#10;when &quot;Marca generica&quot; then [marca_generica]&#13;&#10;when &quot;Proveedor generico&quot; then [proveedor_generico]&#13;&#10;when &quot;Specialty&quot; then [specialty]&#13;&#10;when &quot;Almacenamiento&quot; then [almacenamiento]&#13;&#10;when &quot;Slowmover/Zeromover&quot; then [Calculation_1554586300228530176]&#13;&#10;when &quot;Status SKU&quot; then [Calculation_1554586300228976641]&#13;&#10;end' />
            </column>
            <column caption='Fixed MERMA sin campaña ' datatype='real' name='[Fixed MERMA sin campaña (copia)_1369657293532409865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Campo (copia)_1816639555223375876],[Calculation_1586955969933496321]:sum([adjustment_value_lc])}' />
            </column>
            <column caption='Fixed venta con descuento total sin campaña' datatype='real' name='[Fixed venta con descuento total (copia)_1816639555228004362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1586955969933496321]:[Calculation_1586955969932386304]}' />
            </column>
            <column caption='Fixed MERMA sin campaña TOTAL' datatype='real' name='[Fixed venta con descuento total sin campaña (copia)_1369657293530447875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1586955969933496321]:sum([adjustment_value_lc])}' />
            </column>
            <column caption='Margen teórico' datatype='real' name='[Margen (copia)_1369657293529915393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum([costos])/sum([venta]))' />
            </column>
            <column caption='Margen con merma' datatype='real' name='[Margen (copia)_1816639555224154121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-((sum([costos])-sum([adjustment_value_lc]))/([Calculation_1586955969932386304]))' />
            </column>
            <column caption='Margen merma ponderado sin campaña' datatype='real' name='[Margen ponderado (copia)_1816639555223969800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Margen (copia)_1816639555224154121]*sum([Peso venta (copia)_1816639555223822343])' />
            </column>
            <column caption='Peso venta sin campaña' datatype='real' name='[Peso venta (copia)_1816639555223822343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fixed venta con descuento (copia)_1816639555223605253]/[Fixed venta con descuento total (copia)_1816639555228004362]' />
            </column>
            <column caption='Peso MERMA sin campaña' datatype='real' name='[Peso venta sin campaña (copia)_1369657293530968070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Fixed MERMA sin campaña (copia)_1369657293532409865]/[Fixed venta con descuento total sin campaña (copia)_1369657293530447875]' />
            </column>
            <column caption='Tiendas con Zeromovers' datatype='integer' name='[Tiendas Slowmovers (copia)_1554586300233695238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([Calculation_1554586300228530176]=&apos;ZM&apos;,[warehouse_id],null))' />
            </column>
            <column datatype='real' name='[adjustment_value_lc]' role='measure' type='quantitative' />
            <column datatype='string' name='[almacenamiento]' role='dimension' type='nominal'>
