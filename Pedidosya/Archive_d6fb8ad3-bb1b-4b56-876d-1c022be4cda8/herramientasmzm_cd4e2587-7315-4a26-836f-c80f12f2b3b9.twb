      <column caption='Categoria Nielsen' datatype='string' name='[CATEGORIA (data_nielsen_herramienta_smzm2)]' role='dimension' type='nominal' />
      <column caption='L1' datatype='string' name='[Calculation_1272548401334108171]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parámetro 2]=&apos;PeYa&apos; then [seccion]&#13;&#10;ELSEif [Parameters].[Parámetro 2]=&apos;Nielsen&apos; then [CATEGORIA (data_nielsen_herramienta_smzm2)]&#13;&#10;END' />
      </column>
      <column caption='Considerar Marcas Propias campo' datatype='string' name='[Calculation_1272548401336369166]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [MARCA]=&apos;CONTROLLED LABEL&apos; then &quot;Marca propia&quot;&#13;&#10;ELSE &quot;Otras marcas&quot; end' />
      </column>
      <column caption='index' datatype='string' name='[Calculation_1272548401338187791]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ifnull([Coalesce name (copia)_1272548402328010770],&quot;A&quot;)+&#13;&#10;ifnull([Calculation_1272548402327638033],&quot;A&quot;)+&#13;&#10;ifnull([sku],&quot;A&quot;)+&#13;&#10;ifnull([grupo],&quot;A&quot;)+&#13;&#10;ifnull([seccion],&quot;A&quot;)+&#13;&#10;ifnull([categoria],&quot;A&quot;)+&#13;&#10;ifnull([CATEGORIA (data_nielsen_herramienta_smzm2)],&quot;A&quot;)+&#13;&#10;ifnull([SEGMENTO],&quot;A&quot;)+&#13;&#10;ifnull([SUBSEGMENTO],&quot;A&quot;)+&#13;&#10;ifnull([TAMANO],&quot;A&quot;)+&#13;&#10;ifnull([FABRICANTE],&quot;A&quot;)+&#13;&#10;ifnull([MARCA],&quot;A&quot;)+&#13;&#10;ifnull(str(ifnull([rown_total (data_nielsen_herramienta_smzm2)],[rown_total])),&quot;A&quot;)' />
      </column>
      <column caption='Nombre cruce' datatype='string' name='[Calculation_1272548402327638033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([product_name],[ITEM])' />
      </column>
      <column caption='index2' datatype='integer' name='[Calculation_1272548402331848723]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='agrupacion dmart campo' datatype='string' name='[Calculation_1272548402357719068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parámetro 3]=&apos;Total&apos; then &quot;Total&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 3]=&apos;Seccion&apos; then [seccion]&#13;&#10;ELSEIF [Parameters].[Parámetro 3]=&apos;Categoria&apos; then [seccion]+[categoria]&#13;&#10;ELSEIF [Parameters].[Parámetro 3]=&apos;Subcategoria&apos; then [seccion]+[categoria]+[subcategoria]&#13;&#10;END' />
      </column>
      <column caption='Venta Dmart' datatype='real' name='[Calculation_1272548402359578656]' role='measure' type='quantitative'>
