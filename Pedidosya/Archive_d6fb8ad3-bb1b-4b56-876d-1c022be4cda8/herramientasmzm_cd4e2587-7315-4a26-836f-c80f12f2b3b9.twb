              <calculation class='tableau' formula='&quot;Categoria&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cftaee1qeul5v103h9b10uny4lj'>
            <column caption='Categoria Nielsen' datatype='string' name='[CATEGORIA (data_nielsen_herramienta_smzm2)]' role='dimension' type='nominal' />
            <column caption='Considerar Marcas Propias campo' datatype='string' name='[Calculation_1272548401336369166]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [MARCA]=&apos;CONTROLLED LABEL&apos; then &quot;Marca propia&quot;&#13;&#10;ELSE &quot;Otras marcas&quot; end' />
            </column>
            <column caption='index' datatype='string' name='[Calculation_1272548401338187791]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([Coalesce name (copia)_1272548402328010770],&quot;A&quot;)+&#13;&#10;ifnull([Calculation_1272548402327638033],&quot;A&quot;)+&#13;&#10;ifnull([sku],&quot;A&quot;)+&#13;&#10;ifnull([grupo],&quot;A&quot;)+&#13;&#10;ifnull([seccion],&quot;A&quot;)+&#13;&#10;ifnull([categoria],&quot;A&quot;)+&#13;&#10;ifnull([CATEGORIA (data_nielsen_herramienta_smzm2)],&quot;A&quot;)+&#13;&#10;ifnull([SEGMENTO],&quot;A&quot;)+&#13;&#10;ifnull([SUBSEGMENTO],&quot;A&quot;)+&#13;&#10;ifnull([TAMANO],&quot;A&quot;)+&#13;&#10;ifnull([FABRICANTE],&quot;A&quot;)+&#13;&#10;ifnull([MARCA],&quot;A&quot;)+&#13;&#10;ifnull(str(ifnull([rown_total (data_nielsen_herramienta_smzm2)],[rown_total])),&quot;A&quot;)' />
            </column>
            <column caption='Nombre cruce' datatype='string' name='[Calculation_1272548402327638033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([product_name],[ITEM])' />
            </column>
            <column caption='agrupacion dmart campo' datatype='string' name='[Calculation_1272548402357719068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parámetro 3]=&apos;Total&apos; then &quot;Total&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 3]=&apos;Seccion&apos; then [seccion]&#13;&#10;ELSEIF [Parameters].[Parámetro 3]=&apos;Categoria&apos; then [seccion]+[categoria]&#13;&#10;ELSEIF [Parameters].[Parámetro 3]=&apos;Subcategoria&apos; then [seccion]+[categoria]+[subcategoria]&#13;&#10;END' />
            </column>
            <column caption='Venta Dmart' datatype='real' name='[Calculation_1272548402359578656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parámetro 1]=&quot;28 días&quot; then  [units_30]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&quot;56 días&quot; then  [units_60]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&quot;84 días&quot; then  [units_90]&#13;&#10;end' />
            </column>
            <column caption='Relevancia dmart' datatype='string' name='[Calculation_1272548402359783457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Calculation_1272548402359578656]=0 OR  ISNULL([Calculation_1272548402359578656]) then &quot;No hay data&quot;&#13;&#10;ELSEIF  [venta]&gt;={ FIXED [Calculation_1272548402357719068]:PERCENTILE([Calculation_1272548402359578656],0.75)} then &quot;Muy relevante&quot;&#13;&#10;ELSEIF  [venta]&gt;={ FIXED [Calculation_1272548402357719068]:PERCENTILE([Calculation_1272548402359578656],0.5)} then &quot;Relevante&quot;&#13;&#10;ELSEIF  [venta]&gt;={ FIXED [Calculation_1272548402357719068]:PERCENTILE([Calculation_1272548402359578656],0.25)} then &quot;Poco relevante&quot;&#13;&#10;ELSEIF  [venta]&gt;={ FIXED [Calculation_1272548402357719068]:PERCENTILE([Calculation_1272548402359578656],0)} then &quot;Muy poco relevante&quot;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Cruce Peya/Nielsen' datatype='string' name='[Calculation_1272548402364067875]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [ean]=[EAN (data_nielsen_herramienta_smzm2)] and isnull([MARCA])=false then   &quot;Existe en Dmart y Nielsen&quot;&#13;&#10;ELSEIF  ISNULL([ean]) and IFNULL([EAN (data_nielsen_herramienta_smzm2)],&quot;A&quot;)!=&quot;A&quot; then  &quot;Existe Nielsen y no Dmart&quot;&#13;&#10;ELSEIF  ISNULL([EAN (data_nielsen_herramienta_smzm2)]) and IFNULL([ean],&quot;A&quot;)!=&quot;A&quot; then  &quot;Existe Dmart y no Nielsen&quot;&#13;&#10;END' />
            </column>
            <column caption='EAN cruce' datatype='string' name='[Coalesce name (copia)_1272548402328010770]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([ean],[EAN (data_nielsen_herramienta_smzm2)])' />
