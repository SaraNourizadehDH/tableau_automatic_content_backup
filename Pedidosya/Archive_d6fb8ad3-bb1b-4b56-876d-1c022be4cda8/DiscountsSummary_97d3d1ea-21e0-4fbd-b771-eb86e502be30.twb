            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_C22240152F6B4D32988CD37D865DA367]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>country_name</remote-name>
            <remote-type>130</remote-type>
            <local-name>[country_name]</local-name>
            <parent-name>[Consulta SQL personalizada]</parent-name>
            <remote-alias>country_name</remote-alias>
            <local-type>string</local-type>
