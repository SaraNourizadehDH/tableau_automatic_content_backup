      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_C22240152F6B4D32988CD37D865DA367'>
            <properties context=''>
              <relation connection='bigquery.0z4p6ui03bkbm8155lx0q1foujow' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dates AS ( 
	SELECT 
		date_add(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -6 MONTH) AS start_date,
		date(CURRENT_DATE) AS before_date 
),

combos_food_ontology AS (
    SELECT DISTINCT o.order_id as order_id, 
    'COMBO' as discount_type_fixed
      from `peya-bi-tools-pro.il_core.fact_orders` o
      left join unnest (o.details) ode 
      join (SELECT * FROM 
                          ( SELECT po.*, 
                          ( SELECT STRING_AGG(type, " & ")  FROM (SELECT * FROM UNNEST(components) ORDER BY type )) as s 
                          FROM `peya-data-origins-pro.cl_food_ontology.product_ontology` po 
                          WHERE po.is_combo IS TRUE 
                          AND ARRAY_LENGTH(po.components)>>1) WHERE s != "Main Dish & Side Dish") po on ode.product.product_id = po.product_id and po.is_combo 
      where o.registered_date >>= (SELECT start_date FROM dates)
     AND o.registered_date << (SELECT before_date FROM dates)                  
  ),

combos_nv AS (SELECT  
orders.order_id,
'COMBO' as discount_type_fixed
FROM `peya-bi-tools-pro.il_core.fact_orders` as orders, unnest(details) as order_detail
WHERE (REGEXP_CONTAINS(order_detail.integration_code, "^C(-[0-9]((?i)x)(([0-9]{7,14})|((?i)hielo)))*$"))
AND LENGTH(order_detail.integration_code) >> 8 
AND DATE(orders.registered_date) >>=(SELECT start_date FROM dates)
AND DATE(orders.registered_date) << (SELECT before_date FROM dates)
AND restaurant.businessType NOT IN ("RESTAURANT","COFFEE","Coffee","Courier","Courier Business","Flowers","Bills")),

promo AS (SELECT o.order_id,
'PROMO' as discount_type_fixed
FROM `peya-bi-tools-pro.il_core.fact_orders` o,
UNNEST(o.details) od

INNER JOIN `peya-markets.automated_tables_reports.dim_partner_active_products_history` p
ON CAST(p.product_id AS INT64) = od.product.product_id
AND (p.promo_discount_text = 1 or p.promo_not_subsidized = 1)

WHERE o.registered_date >>= (SELECT start_date FROM dates)
AND o.registered_date << (SELECT before_date FROM dates)  
AND o.order_status = 'CONFIRMED'
AND o.order_id NOT IN (SELECT order_id FROM combos_food_ontology)
AND o.order_id NOT IN (SELECT order_id FROM combos_nv)
),

order_without_discounts AS (
	SELECT 
		DISTINCT o.order_id,
		'WITHOUT_DISCOUNT' discount_type_fixed		
	FROM `peya-bi-tools-pro.il_core.fact_orders` o,
	UNNEST(discounts) d 
		
	WHERE o.registered_date >>= (SELECT start_date FROM dates)
	  AND o.registered_date << (SELECT before_date FROM dates)
	  AND o.order_status = 'CONFIRMED'
	  AND d.order_id IS NULL
      AND o.order_id NOT IN (SELECT order_id FROM combos_food_ontology)
	  AND o.order_id NOT IN (SELECT order_id FROM combos_nv)
	  and o.order_id NOT IN (SELECT order_id FROM promo)
),
    
order_discounts AS (
	WITH aux_order_discounts AS (
		SELECT * FROM combos_food_ontology
		UNION ALL 
		SELECT * FROM combos_nv
		UNION ALL 
	    SELECT * FROM promo  
        UNION ALL 
		SELECT * FROM order_without_discounts
        	)
	SELECT
		order_id,
		ARRAY_TO_STRING(ARRAY_AGG(DISTINCT discount_type_fixed IGNORE NULLS ORDER BY discount_type_fixed)," + ") AS discounts_per_order,
		count(distinct discount_type_fixed) as qty_discounts
	FROM aux_order_discounts
    group by 1
), 
order_data AS (
	SELECT 
		o.order_id,
		o.registered_date,
		o.country.country_name,
		o.business_type.business_type_name
	FROM `peya-bi-tools-pro.il_core.fact_orders` o

	INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
	        ON cd.country_id = o.country.country_id
	       AND cd.active
		   AND cd.country_id != 6
	
	WHERE o.registered_date >>= (SELECT start_date FROM dates)
	  AND o.registered_date << (SELECT before_date FROM dates)
	  AND o.order_status = 'CONFIRMED'
)
SELECT 
	DATE_TRUNC(od.registered_date, month) as month,
	od.country_name,
	od.business_type_name,
	odi.discounts_per_order,
    COUNT(DISTINCT odi.order_id) as qty_confirmed_orders
FROM order_discounts odi

INNER JOIN order_data od 
	    ON od.order_id = odi.order_id
        group by 1,2,3,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
