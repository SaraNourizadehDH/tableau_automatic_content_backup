      <aliases enabled='yes' />
      <column caption='Combo/Promo' datatype='string' name='[Calculation_3214866462439628800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discounts_per_order] = &apos;COMBO&apos; THEN &apos;Only Combo&apos;&#10;ELSEIF [discounts_per_order] = &apos;PROMO&apos; THEN &apos;Only Promo&apos;&#10;ELSEIF CONTAINS([discounts_per_order], &apos;PROMO&apos;) AND CONTAINS([discounts_per_order], &apos;COMBO&apos;) THEN &apos;Combo &amp; Promo&apos;&#10;ELSE &apos;other&apos;&#10;END' />
      </column>
      <column caption='Confirmed orders promo/combo' datatype='integer' name='[Calculation_3214866462440665091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [discounts_per_order] &lt;&gt; &apos;WITHOUT_DISCOUNT&apos; THEN [qty_confirmed_orders] ELSE 0 END' />
      </column>
      <column caption='Share promo/combo' datatype='real' default-format='p0.00%' name='[Calculation_3214866462440796164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3214866462440665091])/SUM([Calculation_3214866462442774533])' />
      </column>
      <column caption='Total orders' datatype='integer' name='[Calculation_3214866462442774533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name], [business_type_name], [month] : SUM([qty_confirmed_orders])}' />
      </column>
