      <column aggregation='Attribute' caption='Total Revenue Euro (discounts fixed)' datatype='real' name='[GMV Gross Euro (discounts fixed) (copy)_1077626958370361344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [discounts_in_order] : SUM([commission_amount_wo_subsidies_euro]) + SUM([credit_card_revenue_euro]) + SUM([delivery_fee_revenue_euro])}' />
