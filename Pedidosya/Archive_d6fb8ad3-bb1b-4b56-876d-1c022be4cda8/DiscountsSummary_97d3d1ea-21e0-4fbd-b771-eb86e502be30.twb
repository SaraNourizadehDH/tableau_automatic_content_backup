    <datasource caption='discounts_amounts (BQ)' inline='true' name='federated.0wm2tk41hn40wf13qeqrg09iqtt8' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04dq26c1k67vie1gj60f911vitd5'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='user_rodrigo_pizzano' server-oauth='' username='julian.zubieta@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04dq26c1k67vie1gj60f911vitd5' name='Custom SQL Query1' type='text'><![CDATA[WITH dates AS ( 
	SELECT 
		DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -6 MONTH) start_date,
		DATE(CURRENT_DATE) before_date 
),
subsidized_company AS (
	SELECT 
			order_id,
		SUM(discount_amount) discount_amount
	FROM `peya-markets.automated_tables_reports.affordable_orders`
		WHERE paid_by IN ('COMPANY')
	  AND discount_type IN ('SUBSIDIZED')
      AND order_id not in (SELECT order_id_to_be_excluded FROM `peya-markets.automated_tables_reports.dim_order_problems` )
	GROUP BY 1
)
SELECT
	DATE_TRUNC(o.registered_date, MONTH) full_date,
	UPPER(o.country.country_name) country_name,
	UPPER(o.business_type.business_type_name) business_type_name,

    SUM( o.total_amount + o.shipping_amount + COALESCE(o.discount_paid_by_company,0))               gmv_gross,
	SUM((o.total_amount + o.shipping_amount + COALESCE(o.discount_paid_by_company,0)) / ce.rate_us) gmv_gross_usd,
    SUM((o.total_amount + o.shipping_amount + COALESCE(o.discount_paid_by_company,0)) / ce.rate_eu) gmv_gross_euro,

    SUM( o.commission_amount - COALESCE(sub_com.discount_amount,0))               commission_amount_wo_subsidies,
    SUM((o.commission_amount - COALESCE(sub_com.discount_amount,0)) / ce.rate_us) commission_amount_wo_subsidies_usd,
    SUM((o.commission_amount - COALESCE(sub_com.discount_amount,0)) / ce.rate_eu) commission_amount_wo_subsidies_euro,

    SUM(o.delivery_fee_revenue)              delivery_fee_revenue,
    SUM(o.delivery_fee_revenue / ce.rate_us) delivery_fee_revenue_usd,
    SUM(o.delivery_fee_revenue / ce.rate_eu) delivery_fee_revenue_euro,

	SUM(IF(o.is_online_payment = 1,  (COALESCE(o.credit_card_commission,0)/100)*(COALESCE(o.total_amount,0) + COALESCE(o.shipping_amount,0)),0)) 			   credit_card_revenue,
	SUM(IF(o.is_online_payment = 1, ((COALESCE(o.credit_card_commission,0)/100)*(COALESCE(o.total_amount,0) + COALESCE(o.shipping_amount,0))) / ce.rate_us,0)) credit_card_revenue_usd,
	SUM(IF(o.is_online_payment = 1, ((COALESCE(o.credit_card_commission,0)/100)*(COALESCE(o.total_amount,0) + COALESCE(o.shipping_amount,0))) / ce.rate_us,0)) credit_card_revenue_euro
FROM `peya-bi-tools-pro.il_core.fact_orders` o

INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
		ON dc.country_id = o.country_id
	   AND dc.active

LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce 
	   ON ce.currency_id = dc.currency_id 
	  AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)

LEFT JOIN subsidized_company sub_com 
       ON sub_com.order_id = o.order_id

WHERE o.registered_date >>= (SELECT start_date FROM dates)
  AND o.registered_date << (SELECT before_date FROM dates)
  AND o.order_status IN ('CONFIRMED')
  AND o.country.country_name IS NOT NULL
GROUP BY 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.04dq26c1k67vie1gj60f911vitd5' name='Custom SQL Query' type='text'><![CDATA[WITH dates AS ( 
	SELECT 
		DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -6 MONTH) start_date,
		DATE(CURRENT_DATE) before_date 
),

discounts_per_order AS (
	SELECT * FROM `peya-markets.automated_tables_reports.affordable_orders`

)

SELECT
	DATE_TRUNC(o.registered_date, MONTH) full_date,
	UPPER(o.country.country_name) country_name,
	UPPER(o.business_type.business_type_name) business_type_name,
	COALESCE(dpo.paid_by,'NO_DISCOUNT') paid_by,
	COALESCE(dpo.discount_type, 'NO_DISCOUNT') discounts_in_order,
	ROUND(SUM(dpo.discount_amount),0) discount_amount,
	ROUND(SUM(dpo.discount_amount / ce.rate_us),0) discount_amount_usd,
	ROUND(SUM(dpo.discount_amount / ce.rate_eu),0) discount_amount_euro
FROM `peya-bi-tools-pro.il_core.fact_orders` o

LEFT JOIN discounts_per_order dpo 
	   ON dpo.order_id = o.order_id 

INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
		ON dc.country_id = o.country_id
	   AND dc.active

LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce 
	   ON ce.currency_id = dc.currency_id 
	  AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)

WHERE o.registered_date >>= (SELECT start_date FROM dates)
  AND o.registered_date << (SELECT before_date FROM dates)
  AND o.order_status IN ('CONFIRMED')
  AND o.country.country_name IS NOT NULL
  and o.order_id not in (SELECT order_id_to_be_excluded FROM `peya-markets.automated_tables_reports.dim_order_problems` )
GROUP BY 1,2,3,4,5]]></relation>
