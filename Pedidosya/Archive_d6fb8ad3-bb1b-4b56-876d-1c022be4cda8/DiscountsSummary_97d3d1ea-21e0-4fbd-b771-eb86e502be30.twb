      <aliases enabled='yes' />
      <column caption='% Discount Amount 2' datatype='real' default-format='p0.0%' name='[% Discount Amount (copia)_71776132519936002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount_euro])/sum([Calculation_132011775154065409])' />
      </column>
      <column caption='% Discount Amount 3' datatype='real' default-format='p0.0%' name='[% Discount Amount 2 (copia)_71776132522496003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount_euro])/sum([Total discount amount euro (copia)_71776132522553348])' />
      </column>
      <column caption='% Paid by Partner' datatype='real' name='[% Paid by Company (copy)_942941206472454159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([paid_by]=&apos;RESTAURANT&apos;,[discount_amount_euro],0))/SUM([discount_amount_euro])' />
      </column>
      <column caption='% discounts over Total Revenue' datatype='real' name='[% discounts over GMV Gross (copy)_1077626958373302273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount_euro]) / SUM([GMV Gross Euro (discounts fixed) (copy)_1077626958370361344])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0wm2tk41hn40wf13qeqrg09iqtt8].[sum:discount_amount_euro:qk]&quot;' value='Euro' />
          <alias key='&quot;[federated.0wm2tk41hn40wf13qeqrg09iqtt8].[sum:discount_amount_usd:qk]&quot;' value='USD' />
          <alias key='&quot;[federated.0wm2tk41hn40wf13qeqrg09iqtt8].[sum:discount_amount:qk]&quot;' value='Local Currency' />
        </aliases>
      </column>
      <column aggregation='Attribute' caption='Total discount amount euro' datatype='real' name='[Calculation_132011775154065409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE  [discounts_in_order] : SUM([discount_amount_euro]) }' />
      </column>
      <column caption='% Discount Amount' datatype='real' default-format='p0.0%' name='[Calculation_132011775154225154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([discount_amount_euro])/sum([Calculation_132011775154065409]))*100' />
      </column>
      <column caption='Proxy' datatype='boolean' name='[Calculation_1809039695815675904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;ProxyON&quot; then [Discount Type Set 2]&#13;&#10;WHEN &quot;ProxyOFF&quot; then [Discount Type Set]&#13;&#10;END' />
      </column>
      <column caption='% by discount type' datatype='real' name='[Calculation_275282556010147840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount_euro]) / SUM({EXCLUDE [discounts_in_order] : SUM([discount_amount_euro])})' />
      </column>
      <column caption='discount_amount_by_currency_parameter' datatype='real' name='[Calculation_275282556014297090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Local Currency&apos; THEN zn([discount_amount])&#10;    WHEN &apos;Euro&apos; THEN ZN([discount_amount_euro])&#10;    WHEN &apos;USD&apos; THEN ZN([discount_amount_usd])&#10;END' />
      </column>
      <column caption='Percent of Discount Amount' datatype='real' default-format='p0.0%' name='[Calculation_275282556021669893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([discount_amount_euro]) / SUM([Calculation_132011775154065409])' />
      </column>
      <column caption='Value or Percent' datatype='string' name='[Calculation_275282556022267910]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF      [Parameters].[Parameter 3] = 1 THEN REGEXP_REPLACE(STR(SUM([Calculation_275282556014297090])),&quot;(\d)(?=(\d{3})+$)&quot;,&quot;$0,&quot;)&#10;ELSEIF  [Parameters].[Parameter 3] = 2 THEN LEFT(STR([Calculation_132011775154225154]),4) + &apos;%&apos;&#10;END' />
      </column>
      <column caption='dynamic_date' datatype='date' name='[Calculation_942941206169309189]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&#13;&#10;  CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[full_date])      &#13;&#10;    WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[full_date])&#13;&#10;    WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[full_date])&#13;&#10;  END&#13;&#10;)' />
      </column>
      <column caption='update' datatype='date' name='[Calculation_942941206173343752]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([full_date])}' />
      </column>
      <column caption='% Paid by Company' datatype='real' name='[Calculation_942941206449954827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([paid_by]=&apos;COMPANY&apos;,[discount_amount_euro],0))/SUM([discount_amount_euro])' />
      </column>
      <column caption='Total Paid by Company' datatype='real' name='[Calculation_942941206452129804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([paid_by]=&apos;COMPANY&apos;,[discount_amount_euro],0))' />
      </column>
      <column caption='color_boolean' datatype='integer' name='[Calculation_942941206458490893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (ZN([Calculation_942941206449954827]) - LOOKUP(ZN([Calculation_942941206449954827]), -1)) / ABS(LOOKUP(ZN([Calculation_942941206449954827]), -1)) &lt; 0 THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Paid by Partner' datatype='real' name='[Calculation_942941206467309582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([paid_by]=&apos;RESTAURANT&apos;,[discount_amount_euro],0))' />
      </column>
      <column caption='% discounts over GMV Gross' datatype='real' name='[Calculation_95490394370834432]' role='measure' type='quantitative'>
