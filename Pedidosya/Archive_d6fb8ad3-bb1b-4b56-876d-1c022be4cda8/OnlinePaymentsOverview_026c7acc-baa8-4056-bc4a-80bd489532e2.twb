    <worksheet name='Payment Type'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#666666'>Payments by Type &amp; Operation Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Partners &amp; Orders' name='federated.046045w0juzhyf1h4bhqr18d3abo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Selection' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Currency Selection' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.046045w0juzhyf1h4bhqr18d3abo'>
            <column caption='Total Confirmed Payments' datatype='integer' name='[Calculation_739434795715981343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([payments])' />
            </column>
            <column caption='Donations Confirmed Amount' datatype='real' name='[Confirmed Donations (copia)_2655997918187134978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2] &#13;&#10;    WHEN &quot;Local&quot; THEN SUM(IF [payment_type] = &quot;DONATIONS&quot; THEN [payment_amount_lc] END)&#13;&#10;    WHEN &quot;Euro&quot; THEN SUM(IF [payment_type] = &quot;DONATIONS&quot; THEN [payment_amount_eur] END)&#13;&#10;    WHEN &quot;US&quot; THEN SUM(IF [payment_type] = &quot;DONATIONS&quot; THEN [payment_amount_us] END)&#13;&#10;END' />
            </column>
            <column caption='Confirmed Delivery Fees' datatype='integer' name='[Confirmed Donations (copia)_739434795725864997]' role='measure' type='quantitative'>
