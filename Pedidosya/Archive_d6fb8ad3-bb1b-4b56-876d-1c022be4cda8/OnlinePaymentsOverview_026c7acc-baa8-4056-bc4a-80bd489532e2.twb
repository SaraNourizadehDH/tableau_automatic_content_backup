          </datasource-dependencies>
          <datasource-dependencies datasource='federated.046045w0juzhyf1h4bhqr18d3abo'>
            <column caption='Partners Active' datatype='integer' name='[Confirmed GMV OP (copia)_739434795485315088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;    WHEN &quot;Day&quot; THEN SUM({FIXED [country_name],[registered_date],[initiative] : MAX([partners_active_daily])})&#13;&#10;    WHEN &quot;Week&quot; THEN SUM({FIXED [country_name],[registered_week],[initiative] : MAX([partners_active_weekly])})&#13;&#10;    WHEN &quot;Month&quot; THEN SUM({FIXED [country_name],[registered_month],[initiative] : MAX([partners_active_monthly])})&#13;&#10;END' />
            </column>
            <column caption='Partners Online' datatype='integer' name='[Partners Active (copia)_739434795486494737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;    WHEN &quot;Day&quot; THEN SUM({FIXED [country_name],[registered_date],[initiative] : MAX([partners_online_daily])})&#13;&#10;    WHEN &quot;Week&quot; THEN SUM({FIXED [country_name],[registered_week],[initiative] : MAX([partners_online_weekly])})&#13;&#10;    WHEN &quot;Month&quot; THEN SUM({FIXED [country_name],[registered_month],[initiative] : MAX([partners_online_monthy])})&#13;&#10;END' />
            </column>
            <column caption='Total Partners' datatype='integer' name='[Partners Active (copia)_739434795486662674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3] &#13;&#10;    WHEN &quot;Online&quot; THEN [Partners Active (copia)_739434795486494737]&#13;&#10;    WHEN &quot;Active&quot; THEN [Confirmed GMV OP (copia)_739434795485315088]&#13;&#10;END' />
            </column>
            <column caption='Partners Online w OP' datatype='integer' name='[Partners Online (copia)_739434795489718292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;    WHEN &quot;Day&quot; THEN SUM({FIXED [country_name],[registered_date],[initiative] : MAX([partners_online_op_daily])})&#13;&#10;    WHEN &quot;Week&quot; THEN SUM({FIXED [country_name],[registered_week],[initiative] : MAX([partners_online_op_weekly])})&#13;&#10;    WHEN &quot;Month&quot; THEN SUM({FIXED [country_name],[registered_month],[initiative] : MAX([partners_online_op_monthy])})&#13;&#10;END' />
            </column>
            <column caption='Partners Active w OP' datatype='integer' name='[Partners Online w OP (copia)_739434795489910805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;    WHEN &quot;Day&quot; THEN SUM({FIXED [country_name],[registered_date],[initiative] : MAX([partners_active_op_daily])})&#13;&#10;    WHEN &quot;Week&quot; THEN SUM({FIXED [country_name],[registered_week],[initiative] : MAX([partners_active_op_weekly])})&#13;&#10;    WHEN &quot;Month&quot; THEN SUM({FIXED [country_name],[registered_month],[initiative] : MAX([partners_active_op_monthy])})&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='date' default-format='*dd/mm/yyyy' name='[Total Confirmed GMV (copia)_739434794667679757]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;    WHEN &quot;Month&quot; THEN [registered_month]&#13;&#10;    WHEN &quot;Week&quot; THEN [registered_week]&#13;&#10;    WHEN &quot;Day&quot; THEN [registered_date]&#13;&#10;END' />
            </column>
            <column caption='Partners with Online Payment' datatype='integer' name='[Total Partners (copia)_739434795490492439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3] &#13;&#10;    WHEN &quot;Online&quot; THEN [Partners Online (copia)_739434795489718292]&#13;&#10;    WHEN &quot;Active&quot; THEN [Partners Online w OP (copia)_739434795489910805]&#13;&#10;END' />
            </column>
            <column caption='% Partners with OP' datatype='real' default-format='p0.00%' name='[Total Partners (copia)_739434795490758680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Partners (copia)_739434795490492439]/[Partners Active (copia)_739434795486662674]' />
