          <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;    WHEN &quot;Month&quot; THEN [registered_month]&#13;&#10;    WHEN &quot;Week&quot; THEN [registered_week]&#13;&#10;    WHEN &quot;Day&quot; THEN [registered_date]&#13;&#10;END' />
