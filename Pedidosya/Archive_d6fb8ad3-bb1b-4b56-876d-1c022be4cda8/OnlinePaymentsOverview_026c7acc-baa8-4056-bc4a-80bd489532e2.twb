      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/OnlinePaymentsOverview/PaymentsbyGateway?rev=' id='PaymentsbyGateway' path='/t/Pedidosya/workbooks/OnlinePaymentsOverview' revision='' site='Pedidosya' />
      <style />
      <size maxheight='1300' maxwidth='1366' minheight='1300' minwidth='1366' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Partners &amp; Orders' name='federated.046045w0juzhyf1h4bhqr18d3abo' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Selection' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
          <calculation class='tableau' formula='&quot;Month&quot;' />
          <members>
            <member value='&quot;Month&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Day&quot;' />
          </members>
        </column>
        <column caption='Currency Selection' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
          <calculation class='tableau' formula='&quot;Euro&quot;' />
          <members>
            <member value='&quot;Euro&quot;' />
            <member value='&quot;US&quot;' />
            <member value='&quot;Local&quot;' />
          </members>
        </column>
        <column caption='Partner Status' datatype='string' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Online&quot;'>
          <calculation class='tableau' formula='&quot;Online&quot;' />
          <members>
            <member value='&quot;Online&quot;' />
            <member value='&quot;Active&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.046045w0juzhyf1h4bhqr18d3abo'>
