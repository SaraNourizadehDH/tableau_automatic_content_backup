    <worksheet name='Order Late RS'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Radios Smart v2 (user_felipe_aguayo)' name='federated.1tyf84e12gjgiv186psqs13o2do4' />
          </datasources>
          <datasource-dependencies datasource='federated.1tyf84e12gjgiv186psqs13o2do4'>
            <column caption='%OL' datatype='real' default-format='p0.0%' name='[Calculation_909164226484641795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_late_num])/SUM([order_late_den])' />
            </column>
            <column caption='Area Food' datatype='string' name='[Calculation_909164226505338891]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [area_peya]&#13;&#10;when &apos;KA&apos; then &apos;Food&apos;&#13;&#10;when &apos;After Sales&apos; then &apos;Food&apos;&#13;&#10;when &apos;Concepts&apos; then &apos;Food&apos;&#13;&#10;ELSE &apos;Non Food&apos;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Radio]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='1' value='+1' />
                <alias key='2' value='+2' />
                <alias key='3' value='+3' />
              </aliases>
            </column>
            <column caption='Area Peya' datatype='string' name='[area_peya]' role='dimension' type='nominal' />
            <column caption='city name (Ciudades)' datatype='string' name='[city_name (Ciudades)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
