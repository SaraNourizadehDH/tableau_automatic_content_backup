      <aliases enabled='yes' />
      <column caption='EPT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1185291178436800512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([estim_prep_time_to_calc])/sum([confirmed_orders])/60' />
      </column>
      <column caption='Last 4 Week' datatype='boolean' name='[Calculation_88101718404161536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;iso-week&apos;, [week], DATEADD(&apos;week&apos;, - 5, today())) &lt; 0 and &#13;&#10;&#13;&#10;[week] &lt; DATEtrunc(&apos;iso-week&apos;, today())' />
      </column>
      <column caption='%VL sin Stacking' datatype='real' name='[Calculation_88101718418620419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vl_num_nstacking])/sum([vl_den_nstacking])' />
      </column>
      <column caption='Cuartil VL sin Stacking' datatype='integer' name='[Calculation_88101718418903044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [p_vl_ns] &lt;= 0.25 then 1&#13;&#10;ELSEIF [p_vl_ns] &lt;= 0.5 then 2&#13;&#10;ELSEIF [p_vl_ns] &lt;= 0.75 then 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
