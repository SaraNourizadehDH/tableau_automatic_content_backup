, pc_calc as (
    select
    *
    ,percent_rank() over (partition by week, city_area_calc , area_peya_calc, is_logistic, grupo_sql order by vl_ns asc) as p_vl_ns
    ,percent_rank() over (partition by week, city_area_calc , area_peya_calc, is_logistic, grupo_sql order by vfr asc) as p_vfr
