            <column caption='Order Late Den' datatype='integer' name='[order_late_den]' role='measure' type='quantitative' />
            <column caption='Order Late Num' datatype='integer' name='[order_late_num]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_909164226484641795]' derivation='User' name='[usr:Calculation_909164226484641795:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[week]' role='dimension' type='ordinal' />
