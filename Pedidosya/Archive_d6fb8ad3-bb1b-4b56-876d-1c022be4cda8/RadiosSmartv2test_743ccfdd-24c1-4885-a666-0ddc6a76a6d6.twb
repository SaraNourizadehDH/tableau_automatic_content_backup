      <aliases enabled='yes' />
      <column caption='%VFR' datatype='real' default-format='p0.00%' name='[%FR (copy)_909164226490269706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_rejected_orders])/sum([total_orders])' />
      </column>
      <column datatype='integer' hidden='true' name='[C-1]' role='measure' type='quantitative' />
      <column datatype='integer' hidden='true' name='[C-2]' role='measure' type='quantitative' />
      <column datatype='integer' hidden='true' name='[C-3]' role='measure' type='quantitative' />
      <column datatype='integer' hidden='true' name='[C-4]' role='measure' type='quantitative' />
      <column datatype='integer' hidden='true' name='[CSV]' role='measure' type='quantitative' />
      <column caption='Categoría RS' datatype='string' name='[Calculation_723390741832712192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([Radio]) then &apos;Sin Cambio&apos; else &apos;Radio Smart&apos; end' />
      </column>
      <column caption='%VL' datatype='real' default-format='p0.0%' name='[Calculation_909164226484297728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_num])/sum([vendor_late_den])' />
      </column>
      <column caption='%VL sin Stacking' datatype='real' default-format='p0.0%' name='[Calculation_909164226484396033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_num_no_stack])/sum([vendor_late_den_no_stack])' />
      </column>
      <column caption='%Stacking' datatype='real' default-format='p0.0%' name='[Calculation_909164226484506626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stacked_orders])/SUM([confirmed_orders])' />
      </column>
      <column caption='%OL' datatype='real' default-format='p0.0%' name='[Calculation_909164226484641795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_late_num])/SUM([order_late_den])' />
      </column>
      <column caption='%RL' datatype='real' default-format='p0.0%' name='[Calculation_909164226484744196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_late_num])/SUM([rider_late_den])' />
      </column>
      <column caption='Actual DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_909164226484862981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([actual_delivery_time_to_calc])/sum([confirmed_orders])/60' />
      </column>
      <column caption='Time to Customer' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_909164226485018630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([time_to_customer_to_calc])/sum([confirmed_orders])/60' />
      </column>
      <column caption='%Open Time' datatype='real' default-format='p0.0%' name='[Calculation_909164226485211143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-sum([closed_time_min])/SUM([open_time_min])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_909164226485338120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ FIXED [city_name], [order_placed_date]: avg([cvr_num])})&#13;&#10;/sum({ FIXED [city_name], [order_placed_date]: avg([cvr_den])})' />
      </column>
      <column caption='%FR' datatype='real' default-format='p0.00%' name='[Calculation_909164226490195977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rejected_orders])/sum([total_orders])' />
      </column>
      <column caption='Area Food' datatype='string' name='[Calculation_909164226505338891]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [area_peya]&#13;&#10;when &apos;KA&apos; then &apos;Food&apos;&#13;&#10;when &apos;After Sales&apos; then &apos;Food&apos;&#13;&#10;when &apos;Concepts&apos; then &apos;Food&apos;&#13;&#10;ELSE &apos;Non Food&apos;&#13;&#10;END' />
      </column>
      <column caption='EPT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_909164226532679692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([estimated_prep_time_to_calc])/sum([confirmed_orders])/60' />
      </column>
      <column caption='City vs Zona' datatype='string' name='[Calculation_909164226595057677]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([city_name (Ciudades)], &apos;Resto zona &apos;+[Zona])' />
      </column>
