    <worksheet name='Customers BR'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column caption='Acquisitions Last Month Retained' datatype='integer' name='[Acquisitions Last Month Not Retained (copia)_373798769790349320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user]=True and [month_number]=1,[users],null))' />
            </column>
            <column caption='Active Users Last Month no ACQ' datatype='integer' name='[Active Users Last Month (copia)_373798770461982898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([active_user_LM] and [month_number]&gt;1 ,users,null))' />
            </column>
            <column caption='Active Users Last Month' datatype='integer' name='[Active Users This Month (copia)_373798769790099462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([active_user_LM] ,users,null))' />
            </column>
            <column caption='Acquisitions Last Month Not Retained' datatype='integer' name='[Calculation_373798769788653569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user]=False and [month_number]=1,[users],null))' />
            </column>
            <column caption='Acquisitions Last Month' datatype='integer' name='[Calculation_373798769789472772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=1,users,null))' />
            </column>
            <column caption='% Acquisitions M1 Last Month' datatype='real' name='[Calculation_373798769790418953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Acquisitions Last Month Not Retained (copia)_373798769790349320]/[Calculation_373798769789472772]' />
            </column>
            <column caption='No Return Active Customers Last Month' datatype='integer' name='[Calculation_373798769790697482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([active_user_LM] and [active_user]=False and [month_number]&gt;1,[users],null))' />
            </column>
            <column caption='% No Return Active Customers Last Month' datatype='real' name='[Calculation_373798769791025163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769790697482]/[Active Users Last Month (copia)_373798770461982898]' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[Calculation_373798769791348748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0,[users],null))' />
            </column>
            <column caption='% Desirable Acquisitions' datatype='real' name='[Calculation_373798769791492109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([month_number]=0 and [desirable],[users],null))/[Calculation_373798769791348748]' />
            </column>
            <column caption='Reactivations' datatype='integer' name='[Calculation_373798769791946766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF((ISNULL([active_user_LM]) or [active_user_LM]=False) and [active_user] and [month_number]&gt;1,users,null))' />
            </column>
            <column caption='Healthy Reactivations' datatype='integer' name='[Calculation_373798769792102415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([healthy]=&apos;Healthy&apos; and (ISNULL([active_user_LM]) or [active_user_LM]=False) and [active_user] and [month_number]&gt;1,users,null))' />
            </column>
            <column caption='%Healthy Reactivations' datatype='real' name='[Calculation_373798769792839696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769792102415]/[Calculation_373798769791946766]' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Filtro Month last 12' datatype='boolean' name='[Filtro ACQ Month last 12 (copia)_373798770447827120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Month]&gt;=DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,TODAY())) ,True,False)' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Active User' datatype='boolean' name='[active_user]' role='dimension' type='nominal' />
            <column caption='active user LM' datatype='boolean' name='[active_user_LM]' role='dimension' type='nominal' />
            <column caption='Desirable' datatype='boolean' name='[desirable]' role='dimension' type='nominal' />
            <column caption='Healthy' datatype='string' name='[healthy]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='ordinal' />
            <column-instance column='[Month]' derivation='MY' name='[my:Month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Filtro ACQ Month last 12 (copia)_373798770447827120]' derivation='None' name='[none:Filtro ACQ Month last 12 (copia)_373798770447827120:nk]' pivot='key' type='nominal' />
            <column caption='Users' datatype='integer' name='[users]' role='measure' type='quantitative' />
            <column-instance column='[Active Users This Month (copia)_373798769790099462]' derivation='User' name='[usr:Active Users This Month (copia)_373798769790099462:qk]' pivot='key' type='quantitative' />
