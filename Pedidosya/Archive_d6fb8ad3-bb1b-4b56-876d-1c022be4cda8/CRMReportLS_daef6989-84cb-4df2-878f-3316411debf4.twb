    <worksheet name='Economics BR'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Economics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column caption='CPO Rider' datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column caption='AOV' datatype='real' name='[Calculation_373798769798287387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV])/sum([Orders_TM])' />
            </column>
            <column caption='Commission Revenue Per Order' datatype='real' name='[Calculation_373798769798684700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Commission_Revenue])/sum([Orders_TM])' />
            </column>
            <column caption='% Commission Rate' datatype='real' name='[Calculation_373798769798914077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769798684700]/[Calculation_373798769798287387]' />
            </column>
            <column caption='Delivery Fee Per Order' datatype='real' name='[Calculation_373798769799131166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([DF_Revenue])/sum([Orders_TM])' />
            </column>
            <column caption='%DF Over AOV' datatype='real' name='[Calculation_373798769799352351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769799131166]/[Calculation_373798769798287387]' />
            </column>
            <column caption='Basket Incentives' datatype='real' name='[Calculation_373798769799962656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([BI])*-1' />
            </column>
            <column caption='Basket Incentives Per Order' datatype='real' name='[Calculation_373798769800220705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769799962656]/sum([Orders_TM])' />
            </column>
            <column caption='% Basket Incentives Over AOV' datatype='real' name='[Calculation_373798769800380450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769800220705]/[Calculation_373798769798287387]' />
            </column>
            <column caption='Net Revenue Per Order' datatype='real' name='[Calculation_373798769800650787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769798684700]+[Calculation_373798769799131166]+[Calculation_373798769800220705]' />
            </column>
            <column caption='%Net Revenue Over AOV' datatype='real' name='[Calculation_373798769800835108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769800650787]/[Calculation_373798769798287387]' />
            </column>
            <column caption='Rider CPO' datatype='real' name='[Calculation_373798769800941605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([CPO_Rider])*-1)/sum([Orders_TM])' />
            </column>
            <column caption='%Rider CPO Over AOV' datatype='real' name='[Calculation_373798769801068582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769800941605]/[Calculation_373798769798287387]' />
            </column>
            <column caption='Other CPO' datatype='real' name='[Calculation_373798769801154599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([extra_cpo])*-1)/sum([Orders_TM])' />
            </column>
            <column caption='%Other CPO Over AOV' datatype='real' name='[Calculation_373798769801244712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769801154599]/[Calculation_373798769798287387]' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_373798769801383977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769800650787]+[Calculation_373798769800941605]+[Calculation_373798769801154599]' />
            </column>
            <column caption='FLGP Total' datatype='real' name='[Calculation_373798769802739755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769801383977]*sum([Orders_TM])' />
            </column>
            <column caption='FLGPO Over AOV' datatype='real' name='[Calculation_373798770456567985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769801383977]/[Calculation_373798769798287387]' />
            </column>
            <column caption='Commission Revenue' datatype='real' name='[Commission_Revenue]' role='measure' type='quantitative' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='DF Revenue' datatype='real' name='[DF_Revenue]' role='measure' type='quantitative' />
