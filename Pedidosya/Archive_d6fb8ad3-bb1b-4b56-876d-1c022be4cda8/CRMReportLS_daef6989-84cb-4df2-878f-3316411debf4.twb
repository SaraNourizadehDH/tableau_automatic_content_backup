        <calculation class='tableau' formula='sum(IIF([active_user_LM] and [active_user]=False and [month_number]&gt;1,[users],null))' />
      </column>
      <column caption='% No Return Active Customers Last Month' datatype='real' name='[Calculation_373798769791025163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769790697482]/[Active Users Last Month (copia)_373798770461982898]' />
      </column>
      <column caption='Acquisitions' datatype='integer' name='[Calculation_373798769791348748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([month_number]=0,[users],null))' />
      </column>
      <column caption='% Desirable Acquisitions' datatype='real' name='[Calculation_373798769791492109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IIF([month_number]=0 and [desirable],[users],null))/[Calculation_373798769791348748]' />
      </column>
      <column caption='Reactivations' datatype='integer' name='[Calculation_373798769791946766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IIF((ISNULL([active_user_LM]) or [active_user_LM]=False) and [active_user] and [month_number]&gt;1,users,null))' />
      </column>
      <column caption='Healthy Reactivations' datatype='integer' name='[Calculation_373798769792102415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IIF([healthy]=&apos;Healthy&apos; and (ISNULL([active_user_LM]) or [active_user_LM]=False) and [active_user] and [month_number]&gt;1,users,null))' />
      </column>
      <column caption='%Healthy Reactivations' datatype='real' name='[Calculation_373798769792839696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769792102415]/[Calculation_373798769791946766]' />
      </column>
      <column caption='New Users This Month' datatype='integer' name='[Calculation_373798769795481620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif(([funnel]=&quot;New&quot; and [active_user]) or ([month_number]=0 and [active_user]),[users],null))' />
      </column>
      <column caption='% Onboarded Users This Month' datatype='real' name='[Calculation_373798769795805206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[New Users (copia)_373798769795620885]/[Calculation_373798769788264448]' />
      </column>
      <column caption='Healthy Active Users This Month' datatype='integer' name='[Calculation_373798769796247576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(iif([healthy]=&apos;Healthy&apos; and [active_user],users,null))' />
      </column>
      <column caption='% Healthy Over Onboarded Users This Month' datatype='real' name='[Calculation_373798769796378649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([healthy]=&quot;Healthy&quot; and [funnel]=&quot;Onboarded&quot; and [active_user] and [month_number]&gt;0,[users],null))/[New Users (copia)_373798769795620885]' />
      </column>
      <column caption='Frequency This Month' datatype='real' name='[Calculation_373798769797226522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Orders_TM])/[Calculation_373798769788264448]' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_373798769798287387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GMV])/sum([Orders_TM])' />
      </column>
      <column caption='Commission Revenue Per Order' datatype='real' name='[Calculation_373798769798684700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Commission_Revenue])/sum([Orders_TM])' />
      </column>
      <column caption='% Commission Rate' datatype='real' name='[Calculation_373798769798914077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769798684700]/[Calculation_373798769798287387]' />
      </column>
      <column caption='Delivery Fee Per Order' datatype='real' name='[Calculation_373798769799131166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([DF_Revenue])/sum([Orders_TM])' />
      </column>
      <column caption='%DF Over AOV' datatype='real' name='[Calculation_373798769799352351]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769799131166]/[Calculation_373798769798287387]' />
      </column>
      <column caption='Basket Incentives' datatype='real' name='[Calculation_373798769799962656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([BI])*-1' />
      </column>
      <column caption='Basket Incentives Per Order' datatype='real' name='[Calculation_373798769800220705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769799962656]/sum([Orders_TM])' />
      </column>
      <column caption='% Basket Incentives Over AOV' datatype='real' name='[Calculation_373798769800380450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769800220705]/[Calculation_373798769798287387]' />
      </column>
      <column caption='Net Revenue Per Order' datatype='real' name='[Calculation_373798769800650787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769798684700]+[Calculation_373798769799131166]+[Calculation_373798769800220705]' />
      </column>
      <column caption='%Net Revenue Over AOV' datatype='real' name='[Calculation_373798769800835108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769800650787]/[Calculation_373798769798287387]' />
      </column>
      <column caption='Rider CPO' datatype='real' name='[Calculation_373798769800941605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([CPO_Rider])*-1)/sum([Orders_TM])' />
      </column>
      <column caption='%Rider CPO Over AOV' datatype='real' name='[Calculation_373798769801068582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769800941605]/[Calculation_373798769798287387]' />
      </column>
      <column caption='Other CPO' datatype='real' name='[Calculation_373798769801154599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([extra_cpo])*-1)/sum([Orders_TM])' />
      </column>
      <column caption='%Other CPO Over AOV' datatype='real' name='[Calculation_373798769801244712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769801154599]/[Calculation_373798769798287387]' />
      </column>
      <column caption='FLGPO' datatype='real' name='[Calculation_373798769801383977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769800650787]+[Calculation_373798769800941605]+[Calculation_373798769801154599]' />
      </column>
      <column caption='FLGP Total' datatype='real' name='[Calculation_373798769802739755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769801383977]*sum([Orders_TM])' />
      </column>
      <column caption='Desirable Acquisitions' datatype='integer' name='[Calculation_373798769805512748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([month_number]=0 and [desirable],users,null))' />
      </column>
      <column caption='%ADR' datatype='real' name='[Calculation_373798769808039981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([BI])/sum([total_amount])' />
      </column>
      <column caption='FLGP' datatype='real' name='[Calculation_373798769809989678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Total_Revenue])-sum([BI])-sum([CPO_Rider])-sum([extra_cpo])' />
      </column>
      <column caption='FLGPU M0' datatype='real' name='[Calculation_373798769810407471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[FLGP (copia)_373798770470469819]/[Calculation_373798769791348748]' />
