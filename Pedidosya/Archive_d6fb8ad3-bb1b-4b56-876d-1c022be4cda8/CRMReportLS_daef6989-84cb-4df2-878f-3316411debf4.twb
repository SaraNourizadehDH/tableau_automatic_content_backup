    <worksheet name='Occasional HGRC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'> Occasional Customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column caption='CPO Rider' datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column caption='Active Onboarded Customers' datatype='integer' name='[Calculation_373798770153590846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user] and [funnel]=&apos;Onboarded&apos;, [users],null))' />
            </column>
            <column caption='Occasional as % Of Total Onboarded' datatype='real' name='[Calculation_373798770420420731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770421473404]/[Calculation_373798770153590846]' />
            </column>
            <column caption='Occasional Active Customers' datatype='integer' name='[Calculation_373798770421473404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;) and active_user&#13;&#10;,users,null))' />
            </column>
            <column caption='% Occassional Active Healthy' datatype='real' name='[Calculation_373798770422247551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Occasional Active Customers (copia)_373798770422153342]/[Calculation_373798770421473404]' />
            </column>
            <column caption='Basket Incentive per Order Occasional' datatype='real' name='[Calculation_373798770422849667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Occasional Active Customers Orders (copia)_373798770422792322]/[Occasional Active Customers (copia)_373798770422661249]' />
            </column>
            <column caption='Frequency Occassional Customers' datatype='real' name='[Calculation_373798770422997124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Occasional Active Customers (copia)_373798770422661249]/[Calculation_373798770421473404]' />
            </column>
            <column caption='Active no ACQ LM Onboarded Occasional' datatype='integer' name='[Calculation_373798770432675974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user_LM] and [funnel_LM]=&apos;Onboarded&apos; and [intermittency_type_LM] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;),users,null))' />
            </column>
            <column caption='No Return Occasional Customers' datatype='integer' name='[Calculation_373798770433196167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user]=False and [active_user_LM] and [intermittency_type_LM] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;) and [funnel_LM]=&apos;Onboarded&apos;,[users],null))' />
            </column>
            <column caption='% No Return Occassional from LM' datatype='real' name='[Calculation_373798770433515656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770433196167]/[Calculation_373798770432675974]' />
            </column>
            <column caption='GMV Gross Onboarded Occasional' datatype='real' name='[Calculation_373798770435641481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [intermittency_type] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;),[GMV]+[peya_discounts],null))' />
            </column>
            <column caption='AOV Gross Occasional' datatype='real' name='[Calculation_373798770435891338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770435641481]/[Occasional Active Customers (copia)_373798770422661249]' />
            </column>
            <column caption='Unprofitable orders occassional' datatype='integer' name='[Calculation_373798770436100235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;),[unprofitable_orders_tm],null))' />
            </column>
            <column caption='% Of Unprofitable Orders Occasional' datatype='real' name='[Calculation_373798770436288652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770436100235]/[Occasional Active Customers (copia)_373798770422661249]' />
            </column>
            <column caption='FLGP Occasional' datatype='real' name='[Calculation_373798770436726925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [intermittency_type] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;),[Total_Revenue]-[BI]-[CPO_Rider]-[extra_cpo],null))' />
            </column>
            <column caption='FLGPO Occasional' datatype='real' name='[Calculation_373798770436927630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770436726925]/[Occasional Active Customers (copia)_373798770422661249]' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Filtro Month last 12' datatype='boolean' name='[Filtro ACQ Month last 12 (copia)_373798770447827120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Month]&gt;=DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,TODAY())) ,True,False)' />
            </column>
            <column datatype='real' name='[GMV]' role='measure' type='quantitative' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Occasional Active Customers Healthy' datatype='integer' name='[Occasional Active Customers (copia)_373798770422153342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [healthy]=&apos;Healthy&apos; and [intermittency_type] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;) and active_user&#13;&#10;,users,null))' />
            </column>
            <column caption='Occasional Active Customers Orders' datatype='integer' name='[Occasional Active Customers (copia)_373798770422661249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;) and active_user&#13;&#10;,[Orders_TM],null))' />
            </column>
            <column caption='Occasional Active Customers BI' datatype='real' name='[Occasional Active Customers Orders (copia)_373798770422792322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;Over 30D&apos;,&apos;No Calculable&apos;) and active_user&#13;&#10;,[BI],null))' />
            </column>
            <column caption='Orders TM' datatype='integer' name='[Orders_TM]' role='measure' type='quantitative' />
            <column caption='Total Revenue' datatype='real' name='[Total_Revenue]' role='measure' type='quantitative' />
            <column caption='Active User' datatype='boolean' name='[active_user]' role='dimension' type='nominal' />
