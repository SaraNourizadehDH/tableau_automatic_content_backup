    <worksheet name='Tooltip BR 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column caption='Tooltip BR1' datatype='string' name='[Calculation_1378101493824561152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Active Users Last Month: Usuarios activos en el mes anterior al indicado en la tabla.&#13;&#10;&#13;&#10;Acquisitions Last Month Not Retained: Adquisiciones que no fueron retenidas desde el mes pasado al indicado en la tabla.&#13;&#10;&#13;&#10;% Acquisitions M1 Last Month: % de adquisiciones del mes pasado que fueron retenidas en este mes.&#13;&#10;&#13;&#10;No Return Active Customers Last Month: Usuarios activos del mes pasado, que no fueron adquisiciones y que no han comprado en este mes.&#13;&#10;&#13;&#10;% No Return Active Customers Last Month: % de usuarios activos del mes pasado, que no fueron adquisiciones y que no han comprado en este mes.&#13;&#10;&#13;&#10;Acquisitions: Adquisiciones del mes.&#13;&#10;&#13;&#10;% Desirable Acquisitions: % de adquisiciones deseables del mes. Adquisición deseable = Primera orden sin voucher o ADR&lt;30% y AOV Percentile &gt; 25%.&#13;&#10;&#13;&#10;Reactivations: Usuarios inactivos del mes pasado que volvieron a comprar este mes .&#13;&#10;&#13;&#10;% Healthy Reactivations: % de reactivaciones “sanas” del mes pasado. Healthy= Usuarios con ADR &lt;30 y AOV Percentile&gt; 30%.&#13;&#10;&#13;&#10;Active Users This Month: Usuarios activos del mes.&quot;' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1378101493824561152]' derivation='None' name='[none:Calculation_1378101493824561152:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1mi2sfy02vx1n813yvwlj014iyf6].[none:Country:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='height' field='[federated.1mi2sfy02vx1n813yvwlj014iyf6].[none:Calculation_1378101493824561152:nk]' value='52' />
          </style-rule>
          <style-rule element='label'>
            <format attr='display' field='[federated.1mi2sfy02vx1n813yvwlj014iyf6].[none:Calculation_1378101493824561152:nk]' value='false' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='band-color' scope='rows' value='#00000000' />
            <format attr='band-color' scope='cols' value='#00000000' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#00000000' />
            <format attr='band-size' scope='rows' value='1' />
            <format attr='band-size' scope='cols' value='1' />
          </style-rule>
          <style-rule element='dropline'>
            <format attr='stroke-size' value='0' />
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='refline'>
            <format attr='stroke-size' value='0' />
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='stroke-size' value='0' />
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='stroke-size' scope='rows' value='0' />
            <format attr='line-visibility' scope='rows' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>AOV:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Average Order Value (GMV/Orders).</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Commission Revenue Per Order:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Commission Revenue / Orders.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% Commission Rate:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> % de comisión.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Delivery Fee Per Order:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Delivery Fee Revenue / Orders.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% DF Over AOV:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Delivery fee revenue per order / AOV.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Basket Incentives:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Descuentos en ordenes.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Basket incentives per order: </run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Basket incentives / Orders.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Net Revenue Per Order:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Commission Revenue per Order + Delivery Fee Revenue per Order - Basket Incentives Per Order.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% Net Revenue Over AOV:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Net Revenue Per Order / AOV.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Rider CPO:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Rider Cost Per Order.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% Rider CPO Over AOV :</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Rider Cost Per Order / AOV.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Other CPO:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Otros costos de la orden aparte del costo por rider. Se asume que el costo de riders por orden representa el 72% del costo total de la orden.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% Other CPO Over AOV</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>: Other CPO / AOV.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>FLGPO:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Net Revenue per Order - Rider CPO - Other CPO.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>FLGPO:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> FLGPO Over AOV: FLGPO / AOV.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>FLGP Total:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> FLGPO * Orders. </run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='1' />
                <format attr='has-stroke' value='false' />
                <format attr='mark-color' value='#c0c0c0' />
                <format attr='mark-transparency' value='24' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minheight' value='-1' />
                <format attr='maxheight' value='-1' />
              </style-rule>
              <style-rule element='trendline'>
                <format attr='stroke-size' value='0' />
                <format attr='line-visibility' value='off' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.1mi2sfy02vx1n813yvwlj014iyf6].[none:Calculation_1378101493824561152:nk]</rows>
        <cols />
      </table>
