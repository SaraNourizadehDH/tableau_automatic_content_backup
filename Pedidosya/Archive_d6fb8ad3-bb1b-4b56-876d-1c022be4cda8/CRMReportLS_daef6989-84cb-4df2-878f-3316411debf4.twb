            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Filtro Month last 12' datatype='boolean' name='[Filtro ACQ Month last 12 (copia)_373798770447827120]' role='dimension' type='nominal'>
