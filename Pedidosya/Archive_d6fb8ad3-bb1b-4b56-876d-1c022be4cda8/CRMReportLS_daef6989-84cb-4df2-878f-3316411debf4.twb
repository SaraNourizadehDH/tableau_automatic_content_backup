            <format attr='stroke-size' scope='rows' value='0' />
            <format attr='line-visibility' scope='rows' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Onboarded Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios que ya alcanzaron su orden numero 5 y que no están en su mes de adquisición.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Onboarded Healthy Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios que ya alcanzaron su orden numero 5,que no están en su mes de adquisición y que son considerados Healthy.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Healthy:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'><![CDATA[ Usuarios con un ADR<30% y AOV Percentile>30%]]></run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Unealthy by AOV:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'><![CDATA[ Usuarios no healthy por contar con un AOV Percentile<30%]]></run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Unealthy by ADR:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios no healthy por contar con un ADR&gt;30%</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Unealthy by Both:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'><![CDATA[ Usuarios no healthy por tener un ADR>30% y AOV Percentile<30%]]></run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Active Onboarded Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios activos que ya alcanzaron su orden numero 5 y que no están en su mes de adquisicion.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Healthy onboarded Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> % de usuarios onboarded que son “healthy”.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Basket incentives Onboarded Users:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Descuentos en ordenes a usuarios onboarded.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% BI:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> % de los descuentos otorgados a este tipo de usuarios.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Frequency :</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Frecuencia de compra del tipo de usuario.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% Onboarded Customers No Return From LM:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> % de usuarios de cada tipo que estuvieron activos en el mes anterior y que no volvieron a comprar durante este mes</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>AOV Gross:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Average Order Value Gross (GMV + Descuentos Peya)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>BI per Order:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Descuentos por orden</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>ADR:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> % promedio de descuento (Descuento pagados por PeYa/Total pagado por el cliente, sin contar delivery fee, después de aplicar descuentos)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% Unprofitable Orders: </run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>% de ordenes donde la suma de RIder CPO y Other CPO son mayores al Net Revenue</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>FLGPO:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Net Revenue per Order - Rider CPO - Other CPO </run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='1' />
                <format attr='has-stroke' value='false' />
                <format attr='mark-color' value='#c0c0c0' />
