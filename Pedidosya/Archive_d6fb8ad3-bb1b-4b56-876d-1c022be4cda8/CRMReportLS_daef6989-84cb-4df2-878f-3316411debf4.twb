    <worksheet name='Heavy HGRC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Heavy Customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column caption='% No Return Heavy from LM' datatype='real' name='[% No Return Stable from LM  (copia)_373798770440642719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[No Return  Stable Customers (copia)_373798770440642728]/[Active no ACQ LM Onboarded Stable (copia)_373798770440642723]' />
            </column>
            <column caption='% Of Unprofitable Orders Heavy' datatype='real' name='[% Of Unprofitable Orders Stable (copia)_373798770440642721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unprofitable orders stable (copia)_373798770440642734]/[Stable Active Customers Orders (copia)_373798770440642732]' />
            </column>
            <column caption='% Heavy Active Healthy' datatype='real' name='[% Stable Active Healthy (copia)_373798770440642720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Stable Active Customers Healthy (copia)_373798770440642731]/[Stable Active  Customers (copia)_373798770440642729]' />
            </column>
            <column caption='AOV Gross Heavy' datatype='real' name='[AOV Gross Stable (copia)_373798770440642722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Gross Onboarded Stable (copia)_373798770440642727]/[Stable Active Customers Orders (copia)_373798770440642732]' />
            </column>
            <column caption='Active no ACQ LM Onboarded Heavy' datatype='integer' name='[Active no ACQ LM Onboarded Stable (copia)_373798770440642723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user_LM] and [funnel_LM]=&apos;Onboarded&apos; and [intermittency_type_LM] in (&apos;6D&apos;),users,null))' />
            </column>
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column caption='Basket Incentive per Order Heavy' datatype='real' name='[Basket Incentive per Order Occasional (copia)_1476054780462411777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Stable Active Customers BI  (copia)_373798770440642730]/[Stable Active Customers Orders (copia)_373798770440642732]' />
            </column>
            <column caption='CPO Rider' datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column caption='Active Onboarded Customers' datatype='integer' name='[Calculation_373798770153590846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user] and [funnel]=&apos;Onboarded&apos;, [users],null))' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='FLGP Heavy' datatype='real' name='[FLGP Stable (copia)_373798770440642724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [intermittency_type] in (&apos;6D&apos;),[Total_Revenue]-[BI]-[CPO_Rider]-[extra_cpo],null))' />
            </column>
            <column caption='FLGPO Heavy' datatype='real' name='[FLGPO Stable (copia)_373798770440642725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[FLGP Stable (copia)_373798770440642724]/[Stable Active Customers Orders (copia)_373798770440642732]' />
            </column>
            <column caption='Filtro Month last 12' datatype='boolean' name='[Filtro ACQ Month last 12 (copia)_373798770447827120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Month]&gt;=DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,TODAY())) ,True,False)' />
            </column>
            <column caption='Frequency Heavy Customers' datatype='real' name='[Frequency Stable Customers (copia)_373798770440642726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Stable Active Customers Orders (copia)_373798770440642732]/[Stable Active  Customers (copia)_373798770440642729]' />
            </column>
            <column caption='GMV Gross Onboarded Heavy' datatype='real' name='[GMV Gross Onboarded Stable (copia)_373798770440642727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [intermittency_type] in (&apos;6D&apos;),[GMV]+[peya_discounts],null))' />
            </column>
            <column datatype='real' name='[GMV]' role='measure' type='quantitative' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='No Return  Heavy Customers' datatype='integer' name='[No Return  Stable Customers (copia)_373798770440642728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user]=False and [active_user_LM] and [intermittency_type_LM] in (&apos;6D&apos;) and [funnel_LM]=&apos;Onboarded&apos;,[users],null))' />
            </column>
            <column caption='Orders TM' datatype='integer' name='[Orders_TM]' role='measure' type='quantitative' />
            <column caption='Heavy Active  Customers' datatype='integer' name='[Stable Active  Customers (copia)_373798770440642729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;6D&apos;) and active_user&#13;&#10;,users,null))' />
            </column>
            <column caption='Heavy Active Customers BI' datatype='real' name='[Stable Active Customers BI  (copia)_373798770440642730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;6D&apos;) and active_user&#13;&#10;,[BI],null))' />
            </column>
            <column caption='Heavy Active Customers Healthy' datatype='integer' name='[Stable Active Customers Healthy (copia)_373798770440642731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [healthy]=&apos;Healthy&apos; and [intermittency_type] in (&apos;6D&apos;) and active_user&#13;&#10;,users,null))' />
            </column>
            <column caption='Heavy Active Customers Orders ' datatype='integer' name='[Stable Active Customers Orders (copia)_373798770440642732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;6D&apos;) and active_user&#13;&#10;,[Orders_TM],null))' />
            </column>
            <column caption='Heavy as % Of Total Onboarded' datatype='real' name='[Stable as % Of Total Onboarded (copia)_373798770440642733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Stable Active  Customers (copia)_373798770440642729]/[Calculation_373798770153590846]' />
            </column>
            <column caption='Total Revenue' datatype='real' name='[Total_Revenue]' role='measure' type='quantitative' />
            <column caption='Unprofitable orders heavy' datatype='integer' name='[Unprofitable orders stable (copia)_373798770440642734]' role='measure' type='quantitative'>
