    <worksheet name='Seguimiento ACQ HGRC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Acquisitions M0</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column caption='Acq BI' datatype='real' name='[Acq_BI]' role='measure' type='quantitative' />
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column caption='CPO Rider' datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column caption='Acquisitions' datatype='integer' name='[Calculation_373798769791348748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0,[users],null))' />
            </column>
            <column caption='% Desirable Acquisitions' datatype='real' name='[Calculation_373798769791492109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([month_number]=0 and [desirable],[users],null))/[Calculation_373798769791348748]' />
            </column>
            <column caption='Desirable Acquisitions' datatype='integer' name='[Calculation_373798769805512748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0 and [desirable],users,null))' />
            </column>
            <column caption='FLGPU M0' datatype='real' name='[Calculation_373798769810407471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[FLGP (copia)_373798770470469819]/[Calculation_373798769791348748]' />
            </column>
            <column caption='Filtro ACQ Month last 12' datatype='boolean' name='[Calculation_373798770446385327]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([month_first_order]&gt;=DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,TODAY()))&#13;&#10;and [month_first_order]&lt;DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;and [month_first_order]&lt;DATEADD(&apos;month&apos;,-[month_number],DATETRUNC(&apos;month&apos;,TODAY())),True,False)' />
            </column>
            <column caption='Orders M0' datatype='integer' name='[Calculation_373798770467872947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0,[Orders_TM],null))' />
            </column>
            <column caption='Frequency Acquisitions' datatype='real' name='[Calculation_373798770468032692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770467872947]/[Calculation_373798769791348748]' />
            </column>
            <column caption='GMV Gross M0' datatype='real' name='[Calculation_373798770468946101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0,[GMV]+[peya_discounts],null))' />
            </column>
            <column caption='AOV Gross M0' datatype='real' name='[Calculation_373798770469081270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770468946101]/[Calculation_373798770467872947]' />
            </column>
            <column caption='BI M0' datatype='real' name='[Calculation_373798770469859511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0,[BI],null))' />
            </column>
            <column caption='Total amount m0' datatype='real' name='[Calculation_373798770470060216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0,[total_amount],null))' />
            </column>
            <column caption='ADR M0' datatype='real' name='[Calculation_373798770470154425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798770469859511]/[Calculation_373798770470060216]' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='FLGP  M0' datatype='real' name='[FLGP (copia)_373798770470469819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([month_number]=0,[Total_Revenue]-[BI]-[CPO_Rider]-[extra_cpo],null))' />
            </column>
            <column datatype='real' name='[GMV]' role='measure' type='quantitative' />
            <column caption='Orders TM' datatype='integer' name='[Orders_TM]' role='measure' type='quantitative' />
            <column caption='Total Revenue' datatype='real' name='[Total_Revenue]' role='measure' type='quantitative' />
            <column caption='Desirable' datatype='boolean' name='[desirable]' role='dimension' type='nominal' />
            <column caption='Extra Cpo' datatype='real' name='[extra_cpo]' role='measure' type='quantitative' />
            <column caption='Month First Order' datatype='date' name='[month_first_order]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='ordinal' />
            <column-instance column='[month_first_order]' derivation='MY' name='[my:month_first_order:ok]' pivot='key' type='ordinal' />
