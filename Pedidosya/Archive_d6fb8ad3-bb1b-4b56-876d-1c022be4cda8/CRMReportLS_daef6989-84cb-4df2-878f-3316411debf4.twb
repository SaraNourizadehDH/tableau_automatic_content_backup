      <column caption='Tooltip BR1' datatype='string' name='[Calculation_1378101493824561152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Active Users Last Month: Usuarios activos en el mes anterior al indicado en la tabla.&#13;&#10;&#13;&#10;Acquisitions Last Month Not Retained: Adquisiciones que no fueron retenidas desde el mes pasado al indicado en la tabla.&#13;&#10;&#13;&#10;% Acquisitions M1 Last Month: % de adquisiciones del mes pasado que fueron retenidas en este mes.&#13;&#10;&#13;&#10;No Return Active Customers Last Month: Usuarios activos del mes pasado, que no fueron adquisiciones y que no han comprado en este mes.&#13;&#10;&#13;&#10;% No Return Active Customers Last Month: % de usuarios activos del mes pasado, que no fueron adquisiciones y que no han comprado en este mes.&#13;&#10;&#13;&#10;Acquisitions: Adquisiciones del mes.&#13;&#10;&#13;&#10;% Desirable Acquisitions: % de adquisiciones deseables del mes. Adquisición deseable = Primera orden sin voucher o ADR&lt;30% y AOV Percentile &gt; 25%.&#13;&#10;&#13;&#10;Reactivations: Usuarios inactivos del mes pasado que volvieron a comprar este mes .&#13;&#10;&#13;&#10;% Healthy Reactivations: % de reactivaciones “sanas” del mes pasado. Healthy= Usuarios con ADR &lt;30 y AOV Percentile&gt; 30%.&#13;&#10;&#13;&#10;Active Users This Month: Usuarios activos del mes.&quot;' />
      </column>
      <column caption='Total Users' datatype='integer' name='[Calculation_1539668151381966848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([users])' />
      </column>
      <column caption='% Active Users This Month' datatype='real' name='[Calculation_1539668151382007809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_373798769788264448]/[Calculation_1539668151381966848]' />
      </column>
      <column caption='Active Users This Month' datatype='integer' name='[Calculation_373798769788264448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IIF([active_user],users,null))' />
      </column>
      <column caption='Acquisitions Last Month Not Retained' datatype='integer' name='[Calculation_373798769788653569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([active_user]=False and [month_number]=1,[users],null))' />
      </column>
      <column caption='Acquisitions Last Month' datatype='integer' name='[Calculation_373798769789472772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([month_number]=1,users,null))' />
      </column>
      <column caption='% Acquisitions M1 Last Month' datatype='real' name='[Calculation_373798769790418953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Acquisitions Last Month Not Retained (copia)_373798769790349320]/[Calculation_373798769789472772]' />
      </column>
