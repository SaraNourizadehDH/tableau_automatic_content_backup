            <mark class='Circle' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Occasional Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios Onboarded con intermitencia de compra mayor a 30 días.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Stable Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios Onboarded con intermitencia de compra menor a 30 días y mayor a 6 días.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Heavy Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios Onboarded con intermitencia de compra igual o menor a 6 días.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Active Customers:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Usuarios activos.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Basket Incentive per Order:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Total descuentos / Ordenes</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Frequency: </run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Frecuencia de compra</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% No Return From LM: </run>
                <run fontcolor='#000000' fontname='Benton Sans Book'>Usuarios activos del mes pasado que no han comprado en este mes.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>AOV Gross:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Average Order Value Gross (GMV + Descuentos Peya)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>% Unprofitable Orders:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> % de ordenes donde la suma de RIder CPO y Other CPO son mayores al Net Revenue</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>FLGPO:</run>
                <run fontcolor='#000000' fontname='Benton Sans Book'> Net Revenue per Order - Rider CPO - Other CPO </run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
