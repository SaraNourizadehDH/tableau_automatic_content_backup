          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column caption='%BI Onboarded Unhealthy' datatype='real' name='[%BI Onboarded Healthy (copia)_373798770154750018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [active_user] and [healthy]!=&apos;Healthy&apos;,[BI],null))/[Calculation_373798770154168384]' />
            </column>
            <column caption='%BI Onboarded Unhealthy by ADR' datatype='real' name='[%BI Onboarded Unhealthy (copia)_373798770155085891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [active_user] and [healthy]=&apos;ADR&apos;,[BI],null))/[Calculation_373798770154168384]' />
            </column>
            <column caption='%BI Onboarded Unhealthy by AOV' datatype='real' name='[%BI Onboarded Unhealthy by ADR (copia)_373798770155155524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [active_user] and [healthy]=&apos;Percentile&apos;,[BI],null))/[Calculation_373798770154168384]' />
            </column>
            <column caption='%BI Onboarded Unhealthy by Both' datatype='real' name='[%BI Onboarded Unhealthy by AOV (copia)_373798770155200581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [active_user] and [healthy]=&apos;Both&apos;,[BI],null))/[Calculation_373798770154168384]' />
            </column>
            <column caption='%Unprofitable Orders Onboarded Healthy' datatype='real' name='[%Unprofitable Orders Onboarded (copia)_373798770187935859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unprofitable Orders Onboarded (copia)_373798770187681904]/[Orders Usuarios Onboarded (copia)_373798770184056923]' />
            </column>
            <column caption='%Unprofitable Orders Onboarded Unhealthy' datatype='real' name='[%Unprofitable Orders Onboarded Healthy (copia)_373798770187997300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unprofitable Orders Onboarded Healthy (copia)_373798770187747441]/[Orders Usuarios Onboarded Healthy (copia)_373798770184114268]' />
            </column>
            <column caption='ADR Onboarded Unhealthy' datatype='real' name='[ADR Onboarded Healthy (copia)_373798770187186286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Basket Incentives Onboarded Users Healthy (copia)_373798770185183333]/[Total amount Onboarded Healthy (copia)_373798770186948715]' />
            </column>
            <column caption='AOV Gross Onboarded Healthy' datatype='real' name='[AOV Gross Onboarded (copia)_373798770184372320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Gross Onboarded (copia)_373798770184179805]/[Orders Usuarios Onboarded (copia)_373798770184056923]' />
            </column>
            <column caption='AOV Gross Onboarded Unhealthy' datatype='real' name='[AOV Gross Onboarded Healthy (copia)_373798770184429665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Gross Onboarded Healthy (copia)_373798770184241246]/[Orders Usuarios Onboarded Healthy (copia)_373798770184114268]' />
            </column>
            <column caption='Active Onboarded Unhealthy Orders' datatype='integer' name='[Active Onboarded Healthy customers (copia)_373798770156597322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [active_user] and [healthy]!=&apos;Healthy&apos;,[Orders_TM],null))' />
            </column>
            <column caption='BI per Order Onboarded Healthy' datatype='real' name='[BI per Order Onboarded (copia)_373798770184851555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Basket Incentives Onboarded Users (copia)_373798770185125988]/[Orders Usuarios Onboarded (copia)_373798770184056923]' />
            </column>
            <column caption='BI per Order Onboarded Unhealthy' datatype='real' name='[BI per Order Onboarded Healthy (copia)_373798770185347175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Basket Incentives Onboarded Users Healthy (copia)_373798770185183333]/[Orders Usuarios Onboarded Healthy (copia)_373798770184114268]' />
            </column>
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column caption='Basket Incentives Onboarded Users Healthy' datatype='real' name='[Basket Incentives Onboarded Users (copia)_373798770185125988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [active_user] and [healthy]=&apos;Healthy&apos;,[BI],null))' />
            </column>
            <column caption='Basket Incentives Onboarded Users Unhealthy' datatype='real' name='[Basket Incentives Onboarded Users Healthy (copia)_373798770185183333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [active_user] and [healthy]!=&apos;Healthy&apos;,[BI],null))' />
            </column>
            <column caption='CPO Rider' datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column caption='Active Onboarded Customers' datatype='integer' name='[Calculation_373798770153590846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user] and [funnel]=&apos;Onboarded&apos;, [users],null))' />
            </column>
            <column caption='% Healthy Onboarded Customers' datatype='real' name='[Calculation_373798770153754687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user] and [funnel]=&apos;Onboarded&apos; and [healthy]=&apos;Healthy&apos;,[users],null))/[Calculation_373798770153590846]' />
