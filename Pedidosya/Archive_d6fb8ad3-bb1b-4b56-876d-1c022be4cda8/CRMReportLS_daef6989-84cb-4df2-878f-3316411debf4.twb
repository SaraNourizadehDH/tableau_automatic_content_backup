            <column caption='% Active Users This Month' datatype='real' name='[Calculation_1539668151382007809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769788264448]/[Calculation_1539668151381966848]' />
            </column>
            <column caption='Active Users This Month' datatype='integer' name='[Calculation_373798769788264448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([active_user],users,null))' />
            </column>
            <column caption='New Users This Month' datatype='integer' name='[Calculation_373798769795481620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(([funnel]=&quot;New&quot; and [active_user]) or ([month_number]=0 and [active_user]),[users],null))' />
            </column>
            <column caption='% Onboarded Users This Month' datatype='real' name='[Calculation_373798769795805206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[New Users (copia)_373798769795620885]/[Calculation_373798769788264448]' />
