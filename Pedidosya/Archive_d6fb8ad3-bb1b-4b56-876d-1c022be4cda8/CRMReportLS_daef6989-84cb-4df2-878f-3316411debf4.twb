    <worksheet name='Stable HGRC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Stable Customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column caption='% No Return Stable from LM ' datatype='real' name='[% No Return Occassional from LM (copia)_373798770440175774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[No Return Occasional Customers (copia)_373798770437374098]/[Active no ACQ LM Onboarded Occasional (copia)_373798770437374097]' />
            </column>
            <column caption='% Stable Active Healthy' datatype='real' name='[% Occassional Active Healthy (copia)_373798770439278748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Occasional Active Customers Healthy (copia)_373798770437374104]/[Occasional Active Customers (copia)_373798770437374096]' />
            </column>
            <column caption='% Of Unprofitable Orders Stable' datatype='real' name='[% Of Unprofitable Orders Occasional (copia)_373798770437374101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unprofitable orders occassional (copia)_373798770438783131]/[Occasional Active Customers Orders (copia)_373798770437374105]' />
            </column>
            <column caption='AOV Gross Stable' datatype='real' name='[AOV Gross Occasional (copia)_373798770437374100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Gross Onboarded Occasional (copia)_373798770437374099]/[Occasional Active Customers Orders (copia)_373798770437374105]' />
            </column>
            <column caption='Active no ACQ LM Onboarded Stable' datatype='integer' name='[Active no ACQ LM Onboarded Occasional (copia)_373798770437374097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user_LM] and [funnel_LM]=&apos;Onboarded&apos; and [intermittency_type_LM] in (&apos;30D&apos;),users,null))' />
            </column>
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column caption='Basket Incentive per Order Stable' datatype='real' name='[Basket Incentive per Order Heavy (copia)_1476054780462518274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Occasional Active Customers BI (copia)_373798770437374106]/[Occasional Active Customers Orders (copia)_373798770437374105]' />
            </column>
            <column caption='CPO Rider' datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column caption='Active Onboarded Customers' datatype='integer' name='[Calculation_373798770153590846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user] and [funnel]=&apos;Onboarded&apos;, [users],null))' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='FLGP Stable' datatype='real' name='[FLGP Occasional (copia)_373798770437374102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [intermittency_type] in (&apos;30D&apos;),[Total_Revenue]-[BI]-[CPO_Rider]-[extra_cpo],null))' />
            </column>
            <column caption='FLGPO Stable' datatype='real' name='[FLGPO Occasional (copia)_373798770437374103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[FLGP Occasional (copia)_373798770437374102]/[Occasional Active Customers Orders (copia)_373798770437374105]' />
            </column>
            <column caption='Filtro Month last 12' datatype='boolean' name='[Filtro ACQ Month last 12 (copia)_373798770447827120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Month]&gt;=DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,TODAY())) ,True,False)' />
            </column>
            <column caption='Frequency Stable Customers' datatype='real' name='[Frequency Occassional Customers (copia)_373798770439504029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Occasional Active Customers Orders (copia)_373798770437374105]/[Occasional Active Customers (copia)_373798770437374096]' />
            </column>
            <column caption='GMV Gross Onboarded Stable' datatype='real' name='[GMV Gross Onboarded Occasional (copia)_373798770437374099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos; and [intermittency_type] in (&apos;30D&apos;),[GMV]+[peya_discounts],null))' />
            </column>
            <column datatype='real' name='[GMV]' role='measure' type='quantitative' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='No Return  Stable Customers' datatype='integer' name='[No Return Occasional Customers (copia)_373798770437374098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([active_user]=False and [active_user_LM] and [intermittency_type_LM] in (&apos;30D&apos;) and [funnel_LM]=&apos;Onboarded&apos;,[users],null))' />
            </column>
            <column caption='Stable Active  Customers' datatype='integer' name='[Occasional Active Customers (copia)_373798770437374096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;30D&apos;) and active_user&#13;&#10;,users,null))' />
            </column>
            <column caption='Stable Active Customers BI ' datatype='real' name='[Occasional Active Customers BI (copia)_373798770437374106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;30D&apos;) and active_user&#13;&#10;,[BI],null))' />
            </column>
            <column caption='Stable Active Customers Healthy' datatype='integer' name='[Occasional Active Customers Healthy (copia)_373798770437374104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [healthy]=&apos;Healthy&apos; and [intermittency_type] in (&apos;30D&apos;) and active_user&#13;&#10;,users,null))' />
            </column>
            <column caption='Stable Active Customers Orders' datatype='integer' name='[Occasional Active Customers Orders (copia)_373798770437374105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;30D&apos;) and active_user&#13;&#10;,[Orders_TM],null))' />
            </column>
            <column caption='Stable as % Of Total Onboarded' datatype='real' name='[Occasional as % Of Total Onboarded (copia)_373798770437374095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Occasional Active Customers (copia)_373798770437374096]/[Calculation_373798770153590846]' />
            </column>
            <column caption='Orders TM' datatype='integer' name='[Orders_TM]' role='measure' type='quantitative' />
            <column caption='Total Revenue' datatype='real' name='[Total_Revenue]' role='measure' type='quantitative' />
            <column caption='Unprofitable orders stable' datatype='integer' name='[Unprofitable orders occassional (copia)_373798770438783131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif(funnel=&apos;Onboarded&apos; and [intermittency_type] in (&apos;30D&apos;),[unprofitable_orders_tm],null))' />
            </column>
            <column caption='Active User' datatype='boolean' name='[active_user]' role='dimension' type='nominal' />
            <column caption='active user LM' datatype='boolean' name='[active_user_LM]' role='dimension' type='nominal' />
            <column caption='Extra Cpo' datatype='real' name='[extra_cpo]' role='measure' type='quantitative' />
            <column caption='Funnel' datatype='string' name='[funnel]' role='dimension' type='nominal' />
            <column caption='funnel LM' datatype='string' name='[funnel_LM]' role='dimension' type='nominal' />
            <column caption='Healthy' datatype='string' name='[healthy]' role='dimension' type='nominal' />
            <column caption='Intermittency Type' datatype='string' name='[intermittency_type]' role='dimension' type='nominal' />
            <column caption='intermittency type LM' datatype='string' name='[intermittency_type_LM]' role='dimension' type='nominal' />
            <column-instance column='[Month]' derivation='MY' name='[my:Month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Filtro ACQ Month last 12 (copia)_373798770447827120]' derivation='None' name='[none:Filtro ACQ Month last 12 (copia)_373798770447827120:nk]' pivot='key' type='nominal' />
            <column caption='Peya Discounts' datatype='real' name='[peya_discounts]' role='measure' type='quantitative' />
            <column caption='Unprofitable Orders Tm' datatype='integer' name='[unprofitable_orders_tm]' role='measure' type='quantitative' />
            <column caption='Users' datatype='integer' name='[users]' role='measure' type='quantitative' />
            <column-instance column='[% No Return Occassional from LM (copia)_373798770440175774]' derivation='User' name='[usr:% No Return Occassional from LM (copia)_373798770440175774:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Occassional Active Healthy (copia)_373798770439278748]' derivation='User' name='[usr:% Occassional Active Healthy (copia)_373798770439278748:qk]' pivot='key' type='quantitative' />
