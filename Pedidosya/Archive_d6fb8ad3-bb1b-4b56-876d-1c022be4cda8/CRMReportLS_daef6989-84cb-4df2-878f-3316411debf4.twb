    <worksheet name='Seguimiento ACQ Month HGRC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Acquisitions M&lt;</run>
            <run bold='true'>[federated.1mi2sfy02vx1n813yvwlj014iyf6].[none:month_number:ok]</run>
            <run bold='true'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CRM_ANALISIS_LS_TABLEAU_TABLE (user_camilo_zelada)' name='federated.1mi2sfy02vx1n813yvwlj014iyf6' />
          </datasources>
          <datasource-dependencies datasource='federated.1mi2sfy02vx1n813yvwlj014iyf6'>
            <column caption='AOV Gross' datatype='real' name='[AOV (copia)_1476054780460687360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV]+[peya_discounts])/sum([Orders_TM])' />
            </column>
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column caption='CPO Rider' datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column caption='Active Users This Month' datatype='integer' name='[Calculation_373798769788264448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IIF([active_user],users,null))' />
            </column>
            <column caption='Frequency This Month' datatype='real' name='[Calculation_373798769797226522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Orders_TM])/[Calculation_373798769788264448]' />
            </column>
            <column caption='%ADR' datatype='real' name='[Calculation_373798769808039981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([BI])/sum([total_amount])' />
            </column>
            <column caption='FLGP' datatype='real' name='[Calculation_373798769809989678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Total_Revenue])-sum([BI])-sum([CPO_Rider])-sum([extra_cpo])' />
            </column>
            <column caption='Acquisitions M0' datatype='integer' name='[Calculation_373798769814261808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_number],[month_first_order]:sum([users])}' />
            </column>
            <column caption='% Active Users Over M0' datatype='real' name='[Calculation_373798769815318577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769788264448]/sum([Calculation_373798769814261808])' />
            </column>
            <column caption='Onboarded Acquisitions' datatype='integer' name='[Calculation_373798769815695410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([funnel]=&apos;Onboarded&apos;,[users],null))' />
            </column>
            <column caption='% Reach Order 5' datatype='real' name='[Calculation_373798769815957555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373798769815695410]/sum([Calculation_373798769814261808])' />
            </column>
            <column caption='%Healthy since M0' datatype='real' name='[Calculation_373798769817505844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Healthy Active Users This Month (copia)_373798769827577909]/sum([Calculation_373798769814261808])' />
            </column>
            <column caption='FLGPU Acum' datatype='real' name='[Calculation_373798770085871677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([flgp_acum])/sum([Calculation_373798769814261808])' />
            </column>
            <column caption='Filtro ACQ Month last 12' datatype='boolean' name='[Calculation_373798770446385327]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([month_first_order]&gt;=DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,TODAY()))&#13;&#10;and [month_first_order]&lt;DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;and [month_first_order]&lt;DATEADD(&apos;month&apos;,-[month_number],DATETRUNC(&apos;month&apos;,TODAY())),True,False)' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[GMV]' role='measure' type='quantitative' />
            <column caption='Healthy Users' datatype='integer' name='[Healthy Active Users This Month (copia)_373798769827577909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(iif([healthy]=&apos;Healthy&apos; and funnel=&apos;Onboarded&apos;,users,null))' />
            </column>
