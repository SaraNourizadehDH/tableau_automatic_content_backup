            <column caption='Last Period' datatype='datetime' name='[Calculation_51791463105196037]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI (copia)]&#13;&#10;WHEN &apos;day&apos; THEN [Calculation_1080301010619351040]&#13;&#10;WHEN &apos;week&apos; THEN [Latest Month (copia)_51791463098171394]&#13;&#10;ELSE  [Latest Month (copia)_51791463104241668]&#13;&#10;END' />
            </column>
            <column caption='Is Last Period' datatype='integer' name='[Calculation_51791463106342918]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF(&#13;&#10;CASE [Parameters].[KPI (copia)]&#13;&#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;,[week_date])&#13;&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;,[week_date])&#13;&#10;ELSE DATETRUNC(&apos;month&apos;,[week_date])&#13;&#10;END) &#13;&#10;= [Calculation_51791463105196037] THEN 1 ELSE 0 END' />
            </column>
