            </column>
            <column caption='0_orders_conf_last_week' datatype='integer' name='[Calculation_1080301010619502593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_51791463106342918] = 1 THEN [confirmed_orders] END' />
            </column>
            <column caption='(ZN([Avg Delivery Time]) - LOOKUP(ZN([Avg Delivery Time]), -1...' datatype='real' name='[Calculation_1131529436139986953]' role='measure' type='quantitative' user:unnamed='G.ORD2 (8)'>
              <calculation class='tableau' formula='(ZN([Calculation_1769351749853433891]) - LOOKUP(ZN([Calculation_1769351749853433891]), -1)) / ABS(LOOKUP(ZN([Calculation_1769351749853433891]), -1))'>
                <table-calc ordering-type='Rows' />
