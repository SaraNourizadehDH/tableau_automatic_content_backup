              <calculation class='tableau' formula='{ FIXED :MAX([week_date])}' />
            </column>
            <column caption='0_orders_conf_last_week' datatype='integer' name='[Calculation_1080301010619502593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_51791463106342918] = 1 THEN [confirmed_orders] END' />
            </column>
            <column caption='(ZN([CVR]) - LOOKUP(ZN([CVR]), -1)) / ABS(LOOKUP(ZN([CVR]), -1))' datatype='real' name='[Calculation_1131529436176048145]' role='measure' type='quantitative' user:unnamed='G.ORD2 (14)'>
              <calculation class='tableau' formula='(ZN([Calculation_1769351749483495426]) - LOOKUP(ZN([Calculation_1769351749483495426]), -1)) / ABS(LOOKUP(ZN([Calculation_1769351749483495426]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
