            <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_1769351749483495426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_total_sessions])/sum([sessions_total])' />
            </column>
