            <column caption='(ZN([Activity Rate Weekly]) - LOOKUP(ZN([Activity Rate Weekly...' datatype='real' name='[Calculation_1131529436173565968]' role='measure' type='quantitative' user:unnamed='G.ORD2 (13)'>
              <calculation class='tableau' formula='(ZN([Activity Rate (copia)_1131529436172759055]) - LOOKUP(ZN([Activity Rate (copia)_1131529436172759055]), -1)) / ABS(LOOKUP(ZN([Activity Rate (copia)_1131529436172759055]), -1))'>
