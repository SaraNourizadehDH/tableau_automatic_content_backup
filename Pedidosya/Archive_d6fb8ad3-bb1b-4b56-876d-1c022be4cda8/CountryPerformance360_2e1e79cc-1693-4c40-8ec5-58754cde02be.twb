              <calculation class='tableau' formula='IF [Calculation_51791463106342918] = 1 THEN [confirmed_orders] END' />
            </column>
            <column caption='(ZN([Fail Rate]) - LOOKUP(ZN([Fail Rate]), -1)) / ABS(LOOKUP(...' datatype='real' name='[Calculation_1131529436138864648]' role='measure' type='quantitative' user:unnamed='G.ORD2 (7)'>
              <calculation class='tableau' formula='(ZN([Calculation_1769351749484785667]) - LOOKUP(ZN([Calculation_1769351749484785667]), -1)) / ABS(LOOKUP(ZN([Calculation_1769351749484785667]), -1))'>
