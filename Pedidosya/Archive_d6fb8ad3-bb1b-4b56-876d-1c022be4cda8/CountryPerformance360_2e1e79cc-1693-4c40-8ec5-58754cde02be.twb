    <worksheet name='G.NPS1'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Country Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='main tabla' name='federated.13korkf1rc0hlt17seu591u1bnff' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='View' datatype='string' name='[KPI (copia)]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13korkf1rc0hlt17seu591u1bnff'>
            <column caption='Latest Day' datatype='datetime' name='[Calculation_1080301010619351040]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([week_date])}' />
            </column>
            <column caption='0_orders_conf_last_week' datatype='integer' name='[Calculation_1080301010619502593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_51791463106342918] = 1 THEN [confirmed_orders] END' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1769351749853290530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoter])-SUM([nps_ao_detractor]))/SUM([nps_ao_detractor]+[nps_ao_pasive]+[nps_ao_promoter]))*100' />
            </column>
            <column caption='Last Period' datatype='datetime' name='[Calculation_51791463105196037]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI (copia)]&#13;&#10;WHEN &apos;day&apos; THEN [Calculation_1080301010619351040]&#13;&#10;WHEN &apos;week&apos; THEN [Latest Month (copia)_51791463098171394]&#13;&#10;ELSE  [Latest Month (copia)_51791463104241668]&#13;&#10;END' />
            </column>
            <column caption='Is Last Period' datatype='integer' name='[Calculation_51791463106342918]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF(&#13;&#10;CASE [Parameters].[KPI (copia)]&#13;&#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;,[week_date])&#13;&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;,[week_date])&#13;&#10;ELSE DATETRUNC(&apos;month&apos;,[week_date])&#13;&#10;END) &#13;&#10;= [Calculation_51791463105196037] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Country Zone' datatype='string' name='[Country Name (grupo)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[country_name]' new-bin='true'>
                <bin default-name='true' value='&quot;Argentina&quot;'>
                  <value>&quot;Argentina&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Latam - North&quot;'>
                  <value>&quot;Costa Rica&quot;</value>
                  <value>&quot;Ecuador&quot;</value>
                  <value>&quot;El Salvador&quot;</value>
                  <value>&quot;Guatemala&quot;</value>
                  <value>&quot;Honduras&quot;</value>
                  <value>&quot;Nicaragua&quot;</value>
                  <value>&quot;Panamá&quot;</value>
                  <value>&quot;República Dominicana&quot;</value>
                  <value>&quot;Venezuela&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Latam - South&quot;'>
                  <value>&quot;Bolivia&quot;</value>
                  <value>&quot;Chile&quot;</value>
                  <value>&quot;Paraguay&quot;</value>
                  <value>&quot;Perú&quot;</value>
                  <value>&quot;Uruguay&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Date View Week' datatype='datetime' default-format='*dd-mmm-yy' name='[Date View (copia)_1226105028005535753]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[week_date])' />
            </column>
            <column caption='Is Last Week' datatype='integer' name='[Is Last Period (copia)_1226105027952836608]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;,[week_date]) = [Latest Month (copia)_51791463098171394] &#13;&#10;THEN 1 &#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Latest Day (copia) (copia)_51791463084875777]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_1080301010619351040]))' />
            </column>
            <column caption='Latest Week' datatype='date' name='[Latest Day (copia)_51791463084859392]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_1080301010619351040]))' />
            </column>
            <column caption='Last Complete Week' datatype='date' default-format='*d/m/yyyy' name='[Latest Month (copia)_51791463098171394]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISOWEEKDAY([Calculation_1080301010619351040])=7&#13;&#10;THEN [Latest Day (copia)_51791463084859392]&#13;&#10;ELSE [Latest Day (copia)_51791463084859392]-7&#13;&#10;END' />
            </column>
            <column caption='Last Complete Month' datatype='datetime' name='[Latest Month (copia)_51791463104241668]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([Calculation_1080301010619351040])&lt;&gt;MONTH([Calculation_1080301010619351040]+1)&#13;&#10;THEN [Latest Day (copia) (copia)_51791463084875777]&#13;&#10;ELSE DATEADD(&apos;month&apos;,-1,[Latest Day (copia) (copia)_51791463084875777])&#13;&#10;END' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
