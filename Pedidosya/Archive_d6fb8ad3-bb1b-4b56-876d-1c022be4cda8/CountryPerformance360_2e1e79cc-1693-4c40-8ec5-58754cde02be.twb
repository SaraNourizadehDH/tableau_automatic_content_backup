            <column caption='Sum Actual Evaluated Working Hours' datatype='real' name='[sum_actual_evaluated_working_hours]' role='measure' type='quantitative' />
            <column-instance column='[Date View (copia)_1226105028005535753]' derivation='Day-Trunc' name='[tdy:Date View (copia)_1226105028005535753:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1769351749853675556]' derivation='User' name='[usr:Calculation_1769351749853675556:qk]' pivot='key' type='quantitative' />
            <column caption='Week Date' datatype='datetime' name='[week_date]' role='dimension' type='ordinal' />
