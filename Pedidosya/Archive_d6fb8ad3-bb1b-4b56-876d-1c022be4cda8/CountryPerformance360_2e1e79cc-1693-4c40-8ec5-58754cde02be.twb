            </column>
            <column caption='(ZN([Avg Delivery Time Dmart]) - LOOKUP(ZN([Avg Delivery Time...' datatype='real' name='[Calculation_1131529436191461398]' role='measure' type='quantitative' user:unnamed='G.ORD2 (19)'>
              <calculation class='tableau' formula='(ZN([Avg Delivery Time (copia)_1702642187062738953]) - LOOKUP(ZN([Avg Delivery Time (copia)_1702642187062738953]), -1)) / ABS(LOOKUP(ZN([Avg Delivery Time (copia)_1702642187062738953]), -1))'>
