            </column>
            <column caption='Is Previous Week -4' datatype='integer' name='[Is Previous Week (copia)_1131529436112396289]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#13;&#10; DATETRUNC(&apos;week&apos;,[week_date])= DATEADD(&apos;week&apos;,-4,[Latest Month (copia)_51791463098171394])&#13;&#10;THEN 1 &#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Latest Day (copia) (copia)_51791463084875777]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_1080301010619351040]))' />
