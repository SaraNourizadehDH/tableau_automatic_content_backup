          <filter class='categorical' column='[federated.13korkf1rc0hlt17seu591u1bnff].[usr:Calculation_1769351749493538820:ok]'>
            <groupfilter function='member' level='[usr:Calculation_1769351749493538820:ok]' member='0' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
