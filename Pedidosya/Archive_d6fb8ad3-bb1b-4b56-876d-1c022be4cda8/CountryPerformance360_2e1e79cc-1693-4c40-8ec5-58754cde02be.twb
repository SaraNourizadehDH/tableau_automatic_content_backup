          </datasources>
          <datasource-dependencies datasource='federated.13korkf1rc0hlt17seu591u1bnff'>
            <column caption='Latest Day' datatype='datetime' name='[Calculation_1080301010619351040]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([week_date])}' />
            </column>
            <column caption='(ZN(SUM([sessions_total])) - LOOKUP(ZN(SUM([sessions_total]))...' datatype='real' name='[Calculation_1131529436177829906]' role='measure' type='quantitative' user:unnamed='G.ORD2 (15)'>
              <calculation class='tableau' formula='(ZN(SUM([sessions_total])) - LOOKUP(ZN(SUM([sessions_total])), -1)) / ABS(LOOKUP(ZN(SUM([sessions_total])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='LAST' datatype='integer' name='[Calculation_1769351749493538820]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
