            <column>[federated.13korkf1rc0hlt17seu591u1bnff].[Country Name (grupo)]</column>
            <column>[federated.13korkf1rc0hlt17seu591u1bnff].[none:Is Last Period -5 (copia)_1226105027957514242:ok]</column>
          </slices>
          <aggregation value='true' />
