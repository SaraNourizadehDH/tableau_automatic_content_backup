          <datasource-dependencies datasource='federated.0uhw13k0v1qdd4140xfhe0t5nd3c'>
            <column caption='Size' datatype='string' name='[Calculation_1090434065098653696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [percentile_orders]&gt;= 0.9 AND [confirmedOrders] &gt;= 25&#13;&#10;THEN &quot;Big&quot;&#13;&#10;ELSEIF [percentile_orders] &gt;= 0.6 AND [confirmedOrders] &gt;= 25&#13;&#10;    THEN &quot;Medium&quot;&#13;&#10;    ELSEIF [percentile_orders] &lt; 0.6 AND [confirmedOrders] &gt;= 25&#13;&#10;        THEN &quot;Small&quot;&#13;&#10;        ELSEIF [confirmedOrders] &lt; 25&#13;&#10;            THEN &quot;Too Small&quot;&#13;&#10;            ELSE &quot;Error&quot;&#13;&#10;END' />
            </column>
            <column caption='qPartners' datatype='integer' name='[Calculation_1090434065099935745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([restaurant_id])' />
            </column>
            <column caption='qOrders' datatype='integer' name='[Calculation_1090434065100681218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmedOrders])' />
            </column>
            <column caption='isSelectedCountry' datatype='string' name='[Calculation_1090434065103036419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] = [Parameters].[Parameter 1]&#13;&#10;THEN [country_name]&#13;&#10;ELSE NULL&#13;&#10;END' />
