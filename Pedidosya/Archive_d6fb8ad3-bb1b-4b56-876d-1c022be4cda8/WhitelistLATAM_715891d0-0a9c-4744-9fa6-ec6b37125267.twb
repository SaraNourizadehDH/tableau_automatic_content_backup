    <dashboard name='Whitelist'>
      <repository-location id='Whitelist' path='/t/Pedidosya/workbooks/WhitelistLATAM' revision='' site='Pedidosya' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='font-size' value='10' />
          <format attr='color' value='#666666' />
          <format attr='background-color' value='#00000000' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-size' value='10' />
          <format attr='font-weight' value='bold' />
          <format attr='color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1300' minheight='2000' minwidth='1300' preset-index='2' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='LATAM_partner_whitelist (group_customer_strategy)' name='federated.0uhw13k0v1qdd4140xfhe0t5nd3c' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Country' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Argentina&quot;'>
          <calculation class='tableau' formula='&quot;Argentina&quot;' />
          <members>
            <member value='&quot;Argentina&quot;' />
            <member value='&quot;Bolivia&quot;' />
            <member value='&quot;Chile&quot;' />
            <member value='&quot;Costa Rica&quot;' />
            <member value='&quot;Ecuador&quot;' />
            <member value='&quot;El Salvador&quot;' />
            <member value='&quot;Guatemala&quot;' />
            <member value='&quot;Honduras&quot;' />
            <member value='&quot;Nicaragua&quot;' />
            <member value='&quot;Panamá&quot;' />
            <member value='&quot;Paraguay&quot;' />
            <member value='&quot;Perú&quot;' />
            <member value='&quot;República Dominicana&quot;' />
            <member value='&quot;Uruguay&quot;' />
            <member value='&quot;Venezuela&quot;' />
          </members>
        </column>
        <column caption='Logistics Slicer' datatype='string' folder-name='Slicers' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Active&quot;'>
          <calculation class='tableau' formula='&quot;Active&quot;' />
          <aliases>
            <alias key='&quot;Inactive&quot;' value='Inactive' />
          </aliases>
          <members>
            <member value='&quot;Active&quot;' />
            <member alias='Inactive' value='&quot;Inactive&quot;' />
          </members>
        </column>
        <column caption='Size Slicer' datatype='string' folder-name='Slicers' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Active&quot;'>
          <calculation class='tableau' formula='&quot;Active&quot;' />
          <members>
            <member value='&quot;Active&quot;' />
            <member value='&quot;Inactive&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0uhw13k0v1qdd4140xfhe0t5nd3c'>
        <column caption='Verdict' datatype='string' name='[Calculation_1090434065123033101]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF &#13;&#10;    (IF ISNULL([VL]) THEN [VFR] ELSE [VL] END) //si el partner no tiene VL, que tome el VFR unicamente como medida de discrimicación&#13;&#10;    &lt;=&#13;&#10;    [Calculation_1090434065110306828]&#13;&#10;THEN&#13;&#10;    &quot;Good&quot;&#13;&#10;ELSE   &#13;&#10;    &quot;Bad&quot;&#13;&#10;END' />
        </column>
        <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Franchise' datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1090434065123033101]' derivation='None' name='[none:Calculation_1090434065123033101:nk]' pivot='key' type='nominal' />
        <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[franchise_name]' derivation='None' name='[none:franchise_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[restaurant_name]' derivation='None' name='[none:restaurant_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[with_logistics]' derivation='None' name='[none:with_logistics:nk]' pivot='key' type='nominal' />
        <column caption='Name' datatype='string' name='[restaurant_name]' role='dimension' type='nominal' />
        <column caption='Logistic Type' datatype='string' name='[with_logistics]' role='dimension' type='nominal' />
      </datasource-dependencies>
