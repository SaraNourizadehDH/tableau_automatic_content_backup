          <named-connection caption='BigQuery' name='bigquery.18xpdj914bkq441f8q944181vg41'>
            <connection CATALOG='peya-peru' EXECCATALOG='peya-peru' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-peru' schema='automated_tables_reports' server-oauth='server-custom' username='franco.yrivarren@pedidosya.com' workgroup-auth-mode='prompt' />
