        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18xpdj914bkq441f8q944181vg41' name='Consulta SQL personalizada' type='text'><![CDATA[WITH recieved_orders AS (
SELECT * from `peya-peru.automated_tables_reports.RETURN_TRIP_HISTORICO`)
,

transitions as (
        SELECT
        SAFE_CAST(ov.order_code AS INT64) as order_id,
        date(DATETIME(ov.created_at,ov.timezone)) as created_date,
        DATETIME(ov.created_at,ov.timezone) as created_date_time,
        DATETIME(t.created_at,ov.timezone)as hora_transition,
        rider.vendor.location as vendor_location
        , t.rider_id as rider_id_transition
        , t.state as transition_state
        , t.geo_point
        , LAG(t.state) over (partition by order_code order by t.created_at asc) as last_state,
        LAG(t.geo_point) over (partition by order_code order by t.created_at asc) as last_state_geo_point
        , datetime_diff(t.created_at,ov.created_at,minute) as time_to_cancel
        FROM `peya-data-origins-pro.cl_hurrier.orders_v2` ov
        LEFT JOIN UNNEST (ov.rider.deliveries) d --on d.is_primary
        LEFT JOIN UNNEST (d.transitions) t
        WHERE 1=1
        and UPPER(ov.entity.id)='PY_PE'
       and ov.order_code is not null
        and  ov.created_date  >>= '2025-05-01' -1
        -- and order_code = "1572946804"
        order by 1,2,3,4
)
,
transitions_cancelled_completed as (
  select
  transitions.*,
  row_number() over (partition by order_id order by hora_transition desc) as ranking
  from transitions
  where 1=1
  and transition_state IN ('cancelled','completed')
  QUALIFY row_number() over (partition by order_id order by hora_transition desc) = 1
  order by order_id)

,
total_orders AS (
SELECT DISTINCT  
UPPER(country.country_code) AS country,  
city.city_name AS city,
zone.zone_name as zone,  
created_date_local AS date, 
extract(hour from timestamp(op.created_at)) as hora,
extract(isoweek from created_date_local  ) as Week,
extract(month from  created_date_local) as month,
EXTRACT(DAYOFWEEK FROM date_sub(created_date_local, INTERVAL 1 DAY)) AS day_of_week,
d.rider_id,  
peya_order_id AS order_id,  
o.vendor.vertical_type AS vertical,
peya_partner_id as vendor_id,
o.vendor.name AS vendor_name, 
 vr.brand as brand,
o.order_status,
o.cancellation.reason as cancellation_reason,  
d.delivery_id AS delivery_id,  
d.delivery_status,
op.total_amount,  
TIMESTAMP_DIFF(PARSE_TIMESTAMP('%F %H:%M:%S', op.created_at_cancel), TIMESTAMP(op.rider_near_customer_at), MINUTE) AS time_to_cancel,
ROUND(order_value / 100, 2) AS purchase,  
CASE WHEN d.is_returning THEN 'Yes' ELSE 'No' END AS return_trip,  
CASE WHEN d.auto_transition.dropoff IS TRUE THEN 'outside' ELSE 'inside' END AS outside_dropoff_geozone,
CASE WHEN TIMESTAMP_DIFF(PARSE_TIMESTAMP('%F %H:%M:%S', op.created_at_cancel), TIMESTAMP(op.rider_near_customer_at), MINUTE) >> 10 THEN 'time_ok' ELSE 'time_fraud' END AS time_status,
FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` AS o  
LEFT JOIN UNNEST(o.deliveries) AS d
LEFT JOIN `peya-peru.automated_tables_reports.OrdersPE` op ON o.peya_order_id = op.order_id 
left join `peya-delivery-and-support.automated_tables_reports.verticales` vr on  o.peya_partner_id = vr.id 
WHERE created_date_local >>= '2025-05-01'
and created_date_local << current_date()
AND o.country.country_code='pe'
and o.order_status = 'cancelled'
and d.is_returning is true
and o.created_date_local >>= '2025-05-01'
and o.created_date_local << current_date()
)

SELECT t.*,
CASE WHEN r.order_id IS NOT NULL THEN 'Arriola' ELSE 'Store' END AS recieved_at,
tc.geo_point,
tc.vendor_location,
ROUND(ST_DISTANCE(geo_point,vendor_location) / 1000, 2) AS distancia_en_km
FROM total_orders t
LEFT JOIN recieved_orders r ON t.order_id = r.order_id
LEFT JOIN transitions_cancelled_completed tc ON t.order_id = tc.order_id
--where t.order_id IN (1572946804,1623782701,1621838634)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
