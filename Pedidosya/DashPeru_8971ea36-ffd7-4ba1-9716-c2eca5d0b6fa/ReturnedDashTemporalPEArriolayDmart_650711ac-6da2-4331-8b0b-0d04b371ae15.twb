    <worksheet name='Share Return Trip Status'>
      <table>
        <view>
          <datasources>
            <datasource caption='Devoluciones_dash_pe_final (automated_tables_reports)' name='federated.1bytno41lurz7k1bzahyw0uk8ac3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Seleccionar Métrica' datatype='string' name='[City Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;Número de Órdenes&quot;'>
              <calculation class='tableau' formula='&quot;Número de Órdenes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bytno41lurz7k1bzahyw0uk8ac3'>
            <column caption='Total Cancelled Orders' datatype='real' name='[Calculation_1331939613594259456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1471551202399637511]' />
            </column>
            <column caption='Total Orders to be Returned' datatype='real' name='[Calculation_1331939613594435585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[City Parámetro] = &apos;Número de Órdenes&apos; THEN &#13;&#10;    COUNTD(IF [lugar_devolucion] IN (&apos;Arriola&apos;,&apos;Dmart&apos;) THEN [order_id] ELSE NULL END)&#13;&#10;ELSEIF [Parameters].[City Parámetro] = &apos;Valor de Órdenes&apos; THEN &#13;&#10;    SUM(IF [lugar_devolucion] IN (&apos;Arriola&apos;,&apos;Dmart&apos;) THEN [final_order_value] ELSE NULL END)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Total Returned Orders' datatype='real' name='[Calculation_1331939613596737538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[City Parámetro] = &apos;Número de Órdenes&apos; THEN &#13;&#10;    COUNTD(IF [is_Vendor_dev_arriola] AND [is_recibido] = &apos;Recibido&apos; THEN [order_id] END)&#13;&#10;ELSEIF [Parameters].[City Parámetro] = &apos;Valor de Órdenes&apos; THEN &#13;&#10;    SUM(IF [is_Vendor_dev_arriola] AND [is_recibido] = &apos;Recibido&apos; THEN [final_order_value] END)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='% To be vs Total Cancelled' datatype='real' default-format='p0.00%' name='[Calculation_1331939613597372419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1331939613594435585]/[Calculation_1331939613594259456]' />
            </column>
            <column caption='% Returned vs To be ' datatype='real' default-format='p0.00%' name='[Calculation_1331939613597552644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1331939613596737538]/[Calculation_1331939613594435585]' />
            </column>
            <column aggregation='Sum' caption='Year' datatype='integer' name='[Calculation_1471551202333769728]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([date])' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_1471551202333900801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [date])' />
            </column>
            <column aggregation='Sum' caption='Week' datatype='integer' name='[Calculation_1471551202334121987]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='WEEK([date])' />
            </column>
            <column aggregation='Sum' caption='TRIMESTRE' datatype='integer' name='[Calculation_1471551202335666182]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;quarter&apos;, [date])' />
            </column>
            <column caption='Numero o Value Order' datatype='real' name='[Calculation_1471551202399637511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[City Parámetro] = &apos;Número de Órdenes&apos; THEN COUNTD([order_id])&#13;&#10;ELSEIF [Parameters].[City Parámetro] = &apos;Valor de Órdenes&apos; THEN SUM([final_order_value])&#13;&#10;END' />
            </column>
            <column caption='Rango Order Value' datatype='string' name='[Calculation_1471551202410442760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [final_order_value] &lt;= 10 THEN &apos;01. S/0.00 a S/10.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 20 THEN &apos;02. S/10.00 a S/20.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 30 THEN &apos;03. S/20.00 a S/30.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 40 THEN &apos;04. S/30.00 a S/40.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 50 THEN &apos;05. S/40.00 a S/50.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 60 THEN &apos;06. S/50.00 a S/60.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 70 THEN &apos;07. S/60.00 a S/70.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 80 THEN &apos;08. S/70.00 a S/80.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 90 THEN &apos;09. S/80.00 a S/90.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 100 THEN &apos;10. S/90.00 a S/100.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 110 THEN &apos;11. S/100.00 a S/110.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 120 THEN &apos;12. S/110.00 a S/120.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 130 THEN &apos;13. S/120.00 a S/130.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 140 THEN &apos;14. S/130.00 a S/140.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 150 THEN &apos;15. S/140.00 a S/150.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 160 THEN &apos;16. S/150.00 a S/160.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 170 THEN &apos;17. S/160.00 a S/170.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 180 THEN &apos;18. S/170.00 a S/180.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 190 THEN &apos;19. S/180.00 a S/190.00&apos;&#13;&#10;ELSEIF [final_order_value] &lt;= 200 THEN &apos;20. S/190.00 a S/200.00&apos;&#13;&#10;ELSE &apos;21. S/200.00 a más&apos;&#13;&#10;END' />
            </column>
            <column caption='Total Return Trip' datatype='real' name='[Calculation_509751208735170560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[City Parámetro] = &apos;Número de Órdenes&apos; THEN &#13;&#10;    COUNTD(IF [is_returning]  THEN [order_id] END)&#13;&#10;ELSEIF [Parameters].[City Parámetro] = &apos;Valor de Órdenes&apos; THEN &#13;&#10;    SUM(IF [is_returning] THEN [final_order_value] END)&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END' />
            </column>
