        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0fn5yjs165se101b5mw9y1kykt51' name='Consulta SQL personalizada' type='text'>SELECT d1.* except ( tipe_dev),&#13;
case when d2.tag is null and brand = &quot;PedidosYa Market&quot; then &quot;Dmart&quot; &#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and is_returning = true then &quot;Tienda&quot;&#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and is_returning = false then &quot;Arriola&quot;&#13;
else d2.tag end as lugar_devolucion,&#13;
case &#13;
when d2.tag is null and brand = &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;Recibido&quot; then &quot;Recibido_dmart&quot; &#13;
when d2.tag is null and brand = &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;No devuelto&quot; then &quot;No_devuelto_dmart&quot; &#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;Recibido&quot; then &quot;Recibido_arriola&quot; &#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;No devuelto&quot; and is_returning = true then &quot;Recibido_tienda&quot;&#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;No devuelto&quot; and is_returning = false then &quot;No_Devuelto_Arriola&quot;&#13;
else &quot;recibido_dmart&quot; end tipe_dev,&#13;
case &#13;
when d2.tag is null and brand = &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;Recibido&quot; then &quot;Recibido&quot; &#13;
when d2.tag is null and brand = &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;No devuelto&quot; then &quot;No_devuelto&quot; &#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;Recibido&quot; then &quot;Recibido&quot; &#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;No devuelto&quot; and is_returning = true then &quot;Recibido&quot;&#13;
when d2.tag is null and brand != &quot;PedidosYa Market&quot; and  d1.tipe_dev = &quot;No devuelto&quot; and is_returning = false then &quot;No_devuelto&quot;&#13;
else &quot;Recibido&quot; end is_recibido,&#13;
&#13;
FROM `peya-peru.automated_tables_reports.Devoluciones_dash_pe_final` d1&#13;
LEFT JOIN `peya-peru.automated_tables_reports.DEVOLUCIONES_DMART_HISTORICO` d2 on d1.order_id = d2.order_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
