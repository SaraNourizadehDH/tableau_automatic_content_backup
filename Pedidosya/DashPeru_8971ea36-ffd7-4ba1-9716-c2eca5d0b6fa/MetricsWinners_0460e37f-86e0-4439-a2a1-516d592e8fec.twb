      <aliases enabled='yes' />
      <column caption='AR' datatype='real' default-format='p0.00%' name='[Calculation_1348265144561602560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(aceptaciones)/sum(notificaciones)' />
      </column>
      <column caption='CPH' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1348265144562302977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(total_payments)/ sum(rider_hours)' />
      </column>
      <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1348265144562372610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(total_payments)/ sum(orders_bo)' />
      </column>
      <column caption='DO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1348265144562487299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(do_distance)/SUM(orders_dh))/1000' />
      </column>
      <column caption='DT' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1348265144562561028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(actual_delivery_time)/sum(orders_dh)' />
      </column>
      <column caption='NS' datatype='real' default-format='p0.00%' name='[Calculation_1348265144562642949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(no_show_time_total)/ (sum(rider_hours)+sum(no_show_time_total))' />
      </column>
      <column caption='PU' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1348265144562737158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(pu_distance)/SUM(orders_dh))/1000' />
      </column>
      <column caption='UR' datatype='real' default-format='p0.00%' name='[Calculation_1348265144562806791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ( SUM(picked_ups)/sum(aceptaciones))' />
      </column>
      <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1348265144562892808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(orders_dh)/sum(rider_hours)' />
      </column>
      <column caption='riders' datatype='integer' name='[Calculation_1406530465022664705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_id])' />
      </column>
      <column caption='DOW' datatype='string' name='[Calculation_554224235264843776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATEPART(&apos;weekday&apos;, [created_date])&#13;&#10;    WHEN 2 THEN &quot;Lunes&quot;&#13;&#10;    WHEN 3 THEN &quot;Martes&quot;&#13;&#10;    WHEN 4 THEN &quot;Miércoles&quot;&#13;&#10;    WHEN 5 THEN &quot;Jueves&quot;&#13;&#10;    WHEN 6 THEN &quot;Viernes&quot;&#13;&#10;    WHEN 7 THEN &quot;Sábado&quot;&#13;&#10;    WHEN 1 THEN &quot;Domingo&quot;&#13;&#10;END' />
      </column>
      <column caption='riders_winners' datatype='integer' name='[Calculation_933933978848690176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( CASE tag_winner WHEN &quot;winner_quest&quot; then rider_id else null end)' />
      </column>
      <column caption='ISOWEEK' datatype='integer' name='[Calculation_933933978850594817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ISOWEEK([created_date] )' />
      </column>
