    <worksheet name='KPI'>
      <layout-options>
        <title>
          <formatted-text>
            <run>KPI Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders Data' name='federated.1eyzs8p0iizp39133e4ka1e5hv7t' />
            <datasource caption='Sessions Data' name='federated.0sejtf80zpo25b14zkzqy04i03o9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPIs Orders' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Max Promise&quot;'>
              <calculation class='tableau' formula='&quot;Avg Max Promise&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sejtf80zpo25b14zkzqy04i03o9'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eyzs8p0iizp39133e4ka1e5hv7t'>
            <column caption='% Late Orders' datatype='real' default-format='p0.0%' name='[% Early Orders  (copy) (copy)_3484519533450440712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [withLogistics]  and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end)' />
            </column>
            <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% Early Orders  (copy)_3484519533450424327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [withLogistics] and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end)' />
            </column>
            <column caption='HC SR (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_1493224812406673408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [withLogistics] then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end)&#10;/ [Calculation_783837457399910400]' />
            </column>
            <column caption='Is Today' datatype='boolean' name='[Calculation_1493224812409417729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
            </column>
            <column caption='KPI Orders' datatype='real' default-format='p0.00%' name='[Calculation_1493224812853923897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;Session Rate&quot; then [Calculation_3484519533445013507]&#10;elseif  [Parameters].[Parameter 1] = &quot;Session Rate (PDT)&quot; then [Calculation_1493224812406673408]&#10;elseif [Parameters].[Parameter 1] = &quot;Fail Rate&quot; then [Calculation_3484519533447671812]&#10;elseif [Parameters].[Parameter 1] = &quot;Fail Rate (PDT)&quot; then [Calculation_3484519533448581125]&#10;elseif  [Parameters].[Parameter 1] = &quot;% Late Orders&quot; then [% Early Orders  (copy) (copy)_3484519533450440712]&#10;elseif [Parameters].[Parameter 1] = &quot;% Early Orders&quot; then [Calculation_3484519533449973766]&#10;elseif [Parameters].[Parameter 1] = &quot;% On Time Orders&quot; then [% Early Orders  (copy)_3484519533450424327]&#10;elseif [Parameters].[Parameter 1] = &quot;Avg Max Promise&quot; then [Calculation_3484519533443764224] &#10;elseif [Parameters].[Parameter 1] = &quot;Avg Min Promise&quot; then [Calculation_2345742107359870977]&#10;elseif [Parameters].[Parameter 1] = &quot;Delivery Time&quot; then [Calculation_1493224813829341250]&#10;end' />
            </column>
            <column caption='Delivery Time' datatype='real' name='[Calculation_1493224813829341250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [withLogistics] and [order_state] = &quot;confirmed&quot; then [sum_delivery_time] else 0 end)&#10;/&#10;SUM(if [withLogistics] and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)' />
