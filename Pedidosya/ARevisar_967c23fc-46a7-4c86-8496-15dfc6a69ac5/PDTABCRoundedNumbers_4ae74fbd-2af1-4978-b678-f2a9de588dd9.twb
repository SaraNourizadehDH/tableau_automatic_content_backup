            <column caption='V2 %dif SR (PDT Related)' datatype='real' default-format='p0.00%' name='[V1 %dif SR (PDT Related) (copy)_40532405939965966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [variant] = &quot;Variation2&quot; then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [variant] = &quot;Control&quot; then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
            </column>
            <column caption='V2 %dif Session Rate' datatype='real' default-format='p0.00%' name='[V1 %dif Session Rate (copy)_40532405939855373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [variant] = &quot;Variation2&quot; then [helpcenter_sessions] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [variant] = &quot;Control&quot; then [helpcenter_sessions] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
            </column>
            <column caption='V2 Delta KPI Orders' datatype='real' default-format='p0.00%' name='[V1 Delta KPI Orders (copy)_40532405981990959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &quot;Percentage Points&quot; then &#10;    if [Parameters].[Parameter 1] = &quot;Session Rate&quot; then [V1 p.p. Session Rate (copy)_40532405943926805]/100&#10;    elseif  [Parameters].[Parameter 1] = &quot;Session Rate (PDT)&quot; then [V1 p.p. SR (PDT Related) (copy)_40532405944074262]/100&#10;    elseif [Parameters].[Parameter 1] = &quot;Fail Rate&quot; then [V1 p.p. Fail rate  (copy)_40532405943296016]/100&#10;    elseif [Parameters].[Parameter 1] = &quot;Fail Rate (PDT)&quot; then [V1 p.p. FR (PDT Related) (copy)_40532405943406609]/100&#10;    elseif  [Parameters].[Parameter 1] = &quot;% Late Orders&quot; then [V1 p.p. Late Orders (copy)_40532405943664659]/100&#10;    elseif [Parameters].[Parameter 1] = &quot;% Early Orders&quot; then [V1 p.p. dif Early Orders (copy)_40532405934682112]/100&#10;    elseif [Parameters].[Parameter 1] = &quot;% On Time Orders&quot; then [V1 p.p. On Time Orders (copy)_40532405943799828]/100&#10;    elseif [Parameters].[Parameter 1] = &quot;Avg Max Promise&quot; then [dif Avg Max Promise (copy)_40532405936250882] /100&#10;    end&#10;elseif [Parameters].[Parameter 2] = &quot;Percent Change&quot; then &#10;    if [Parameters].[Parameter 1] = &quot;Session Rate&quot; then [V1 %dif Session Rate (copy)_40532405939855373]&#10;    elseif  [Parameters].[Parameter 1] = &quot;Session Rate (PDT)&quot; then [V1 %dif SR (PDT Related) (copy)_40532405939965966]&#10;    elseif [Parameters].[Parameter 1] = &quot;Fail Rate&quot; then [V1 %dif Fail Rate (copy)_40532405939298314]&#10;    elseif [Parameters].[Parameter 1] = &quot;Fail Rate (PDT)&quot; then [V1 %dif FR (PDT Related) (copy)_40532405939499019]&#10;    elseif  [Parameters].[Parameter 1] = &quot;% Late Orders&quot; then [V1 % dif Late Orders (copy)_40532405938302982]&#10;    elseif [Parameters].[Parameter 1] = &quot;% Early Orders&quot; then [V1 % dif Early Orders (copy)_40532405937885188]&#10;    elseif [Parameters].[Parameter 1] = &quot;% On Time Orders&quot; then [V1 % dif On Time Orders (copy)_40532405938102277]&#10;    elseif [Parameters].[Parameter 1] = &quot;Avg Max Promise&quot; then [V1 %dif Avg Max Promise (copy)_40532405938954248] &#10;    end&#10;end' />
            </column>
            <column caption='V2 p.p. FR (PDT Related)' datatype='real' default-format='p0.00%' name='[V1 p.p. FR (PDT Related) (copy)_40532405943406609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation2&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V2 p.p. Fail rate' datatype='real' default-format='p0.00%' name='[V1 p.p. Fail rate  (copy)_40532405943296016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation2&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V2 p.p. Late Orders' datatype='real' default-format='p0.0%' name='[V1 p.p. Late Orders (copy)_40532405943664659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Variation2&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V2 p.p. On Time Orders' datatype='real' default-format='p0.0%' name='[V1 p.p. On Time Orders (copy)_40532405943799828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Variation2&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
