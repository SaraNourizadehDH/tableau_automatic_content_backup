          <datasource-dependencies datasource='Parameters'>
            <column caption='KPIs Orders' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Max Promise&quot;'>
              <calculation class='tableau' formula='&quot;Avg Max Promise&quot;' />
            </column>
            <column caption='Difference Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentage Points&quot;'>
              <calculation class='tableau' formula='&quot;Percentage Points&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sejtf80zpo25b14zkzqy04i03o9'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eyzs8p0iizp39133e4ka1e5hv7t'>
            <column caption='Is Today' datatype='boolean' name='[Calculation_1493224812409417729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
            </column>
            <column caption='Order State vs PDT' datatype='string' name='[Calculation_3484519533444169730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pdt_performance] = &quot;Late &lt;= 10&quot; or [pdt_performance] = &quot;Late &gt; 10&quot; then &quot;Late&quot; else [pdt_performance] end' />
            </column>
            <column caption='V2 % dif Early Orders' datatype='real' default-format='p0%' name='[V1 % dif Early Orders (copy)_40532405937885188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;Early&quot; and [variant] = &quot;Variation2&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [Calculation_3484519533444169730] = &quot;Early&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
            </column>
            <column caption='V2 % dif Late Orders' datatype='real' default-format='p0%' name='[V1 % dif Late Orders (copy)_40532405938302982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Variation2&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
            </column>
            <column caption='V2 % dif On Time Orders' datatype='real' default-format='p0%' name='[V1 % dif On Time Orders (copy)_40532405938102277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Variation2&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
            </column>
            <column caption='V2 %dif Avg Max Promise' datatype='real' default-format='p0.0%' name='[V1 %dif Avg Max Promise (copy)_40532405938954248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [sum_max_minutes] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [sum_max_minutes] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
            </column>
            <column caption='V2 %dif FR (PDT Related)' datatype='real' default-format='p0.00%' name='[V1 %dif FR (PDT Related) (copy)_40532405939499019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
            </column>
            <column caption='V2 %dif Fail Rate' datatype='real' default-format='p0.00%' name='[V1 %dif Fail Rate (copy)_40532405939298314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))-1' />
