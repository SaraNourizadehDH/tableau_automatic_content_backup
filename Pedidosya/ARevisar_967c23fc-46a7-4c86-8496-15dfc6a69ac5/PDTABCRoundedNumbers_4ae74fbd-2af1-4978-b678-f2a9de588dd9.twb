      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>p.p. Dif Var1</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders Data' name='federated.1eyzs8p0iizp39133e4ka1e5hv7t' />
            <datasource caption='Sessions Data' name='federated.0sejtf80zpo25b14zkzqy04i03o9' />
          </datasources>
          <datasource-dependencies datasource='federated.0sejtf80zpo25b14zkzqy04i03o9'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eyzs8p0iizp39133e4ka1e5hv7t'>
            <column caption='Is Today' datatype='boolean' name='[Calculation_1493224812409417729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
            </column>
            <column caption='V1 p.p. Fail rate ' datatype='real' default-format='p0.00%' name='[Calculation_1493224812766322703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V1 p.p. FR (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_1493224812767027217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V1 p.p. Session Rate' datatype='real' default-format='p0.00%' name='[Calculation_1493224812767539220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [variant] = &quot;Variation1&quot; then [helpcenter_sessions] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [variant] = &quot;Control&quot; then [helpcenter_sessions] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V1 p.p. SR (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_1493224812767817749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [variant] = &quot;Variation1&quot; then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [variant] = &quot;Control&quot; then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V1 p.p. Contact Rate' datatype='real' name='[Calculation_40532405952884763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [variant] = &quot;Variation1&quot; and [withLogistics] then [contacts] else 0 end) &#13;&#10;/&#13;&#10;SUM(if [variant] = &quot;Variation1&quot; and [withLogistics] then [orders] else 0 end))*100&#13;&#10;-&#13;&#10;(SUM(if [variant] = &quot;Control&quot; and [withLogistics] then [contacts] else 0 end) &#13;&#10;/&#13;&#10;SUM(if [variant] = &quot;Control&quot; and [withLogistics] then [orders] else 0 end))*100' />
            </column>
