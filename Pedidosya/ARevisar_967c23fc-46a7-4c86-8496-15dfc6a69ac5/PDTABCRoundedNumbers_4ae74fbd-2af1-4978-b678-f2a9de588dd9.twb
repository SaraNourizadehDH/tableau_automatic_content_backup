      <aliases enabled='yes' />
      <column caption='% Late Orders' datatype='real' default-format='p0.0%' name='[% Early Orders  (copy) (copy)_3484519533450440712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [withLogistics]  and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end)' />
      </column>
      <column caption='V1 p.p. Early Orders' datatype='real' default-format='p0.0%' name='[% Early Orders  (copy)_1493224812836720669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;Early&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;Early&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% Early Orders  (copy)_3484519533450424327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [withLogistics] and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end)' />
      </column>
      <column caption='V1 p.p. Late &gt; 5&apos; Orders' datatype='real' default-format='p0.0%' name='[% Late &gt; 5&apos; Orders (copy)_1493224812836720668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [pdt_performance] = &quot;Late &gt; 5&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [pdt_performance] = &quot;Late &gt; 5&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='V1 p.p. Late Orders' datatype='real' default-format='p0.0%' name='[% Late Orders (copy)_1493224812836720666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='% Late &gt; 10&apos; Orders' datatype='real' default-format='p0.0%' name='[% Late Orders (copy)_3484519533450579977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [pdt_performance] = &quot;Late &gt; 10&quot; and [withLogistics] and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end)' />
      </column>
      <column caption='V1 p.p. On Time Orders' datatype='real' default-format='p0.0%' name='[% On Time Orders (copy)_1493224812836720667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='HC SR (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_1493224812406673408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [withLogistics] then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end)&#10;/ [Calculation_783837457399910400]' />
      </column>
      <column caption='Is Today' datatype='boolean' name='[Calculation_1493224812409417729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
      </column>
      <column caption='NPS AO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1493224812741337097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [nps_group] = &quot;Promoter&quot; then [nps_responses] else 0 end) &#10;-&#10;SUM(if [nps_group] = &quot;Detractor&quot; then [nps_responses] else 0 end) )&#10;/&#10;SUM([nps_responses])*100' />
      </column>
      <column caption='NPS Responses' datatype='integer' name='[Calculation_1493224812741853195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nps_responses])' />
      </column>
      <column caption='V1 p.p. Fail rate ' datatype='real' default-format='p0.00%' name='[Calculation_1493224812766322703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='V1 p.p. FR (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_1493224812767027217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; &#10;           and [fail_rate_pdt_related] = &quot;PDT Related&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='V1 p.p. Session Rate' datatype='real' default-format='p0.00%' name='[Calculation_1493224812767539220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [variant] = &quot;Variation1&quot; then [helpcenter_sessions] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [variant] = &quot;Control&quot; then [helpcenter_sessions] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='V1 p.p. SR (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_1493224812767817749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [variant] = &quot;Variation1&quot; then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [variant] = &quot;Control&quot; then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
      </column>
      <column caption='V1 %dif Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1493224812773232662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Variation1&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end) &#10;/&#10;SUM(if [variant] = &quot;Control&quot; then [orders] else 0 end))-1' />
      </column>
      <column caption='KPI Orders' datatype='real' default-format='p0.00%' name='[Calculation_1493224812853923897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;Session Rate&quot; then [Calculation_3484519533445013507]&#10;elseif  [Parameters].[Parameter 1] = &quot;Session Rate (PDT)&quot; then [Calculation_1493224812406673408]&#10;elseif [Parameters].[Parameter 1] = &quot;Fail Rate&quot; then [Calculation_3484519533447671812]&#10;elseif [Parameters].[Parameter 1] = &quot;Fail Rate (PDT)&quot; then [Calculation_3484519533448581125]&#10;elseif  [Parameters].[Parameter 1] = &quot;% Late Orders&quot; then [% Early Orders  (copy) (copy)_3484519533450440712]&#10;elseif [Parameters].[Parameter 1] = &quot;% Early Orders&quot; then [Calculation_3484519533449973766]&#10;elseif [Parameters].[Parameter 1] = &quot;% On Time Orders&quot; then [% Early Orders  (copy)_3484519533450424327]&#10;elseif [Parameters].[Parameter 1] = &quot;Avg Max Promise&quot; then [Calculation_3484519533443764224] &#10;elseif [Parameters].[Parameter 1] = &quot;Avg Min Promise&quot; then [Calculation_2345742107359870977]&#10;elseif [Parameters].[Parameter 1] = &quot;Delivery Time&quot; then [Calculation_1493224813829341250]&#10;end' />
      </column>
      <column caption='Avg TES promise' datatype='real' name='[Calculation_1493224813819785280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [order_state] = &quot;confirmed&quot; then [sum_tes_pdt] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; then [orders] else 0 end)' />
      </column>
      <column caption='Delivery Time' datatype='real' name='[Calculation_1493224813829341250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [withLogistics] and [order_state] = &quot;confirmed&quot; then [sum_delivery_time] else 0 end)&#10;/&#10;SUM(if [withLogistics] and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)' />
      </column>
      <column caption='V1 dif Avg TES Promise' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1756474287268577280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [sum_tes_pdt] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))&#10;-&#10;(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [sum_tes_pdt] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))' />
