      <table>
        <view>
          <datasources>
            <datasource caption='Orders Data' name='federated.1eyzs8p0iizp39133e4ka1e5hv7t' />
            <datasource caption='Sessions Data' name='federated.0sejtf80zpo25b14zkzqy04i03o9' />
          </datasources>
          <datasource-dependencies datasource='federated.0sejtf80zpo25b14zkzqy04i03o9'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eyzs8p0iizp39133e4ka1e5hv7t'>
            <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% Early Orders  (copy)_3484519533450424327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [withLogistics] and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end)' />
            </column>
            <column caption='Is Today' datatype='boolean' name='[Calculation_1493224812409417729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1493224812741337097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [nps_group] = &quot;Promoter&quot; then [nps_responses] else 0 end) &#10;-&#10;SUM(if [nps_group] = &quot;Detractor&quot; then [nps_responses] else 0 end) )&#10;/&#10;SUM([nps_responses])*100' />
            </column>
            <column caption='Order State vs PDT' datatype='string' name='[Calculation_3484519533444169730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pdt_performance] = &quot;Late &lt;= 10&quot; or [pdt_performance] = &quot;Late &gt; 10&quot; then &quot;Late&quot; else [pdt_performance] end' />
            </column>
            <column caption='% Early Orders ' datatype='real' default-format='p0.0%' name='[Calculation_3484519533449973766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_3484519533444169730] = &quot;Early&quot; and [withLogistics] and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end)' />
            </column>
            <column caption='OD Orders' datatype='integer' name='[Calculation_783837457399910400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [withLogistics] then [orders] else 0 end)' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.00%' name='[Calculation_783837457403072513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_783837457399910400] / SUM([orders])' />
            </column>
            <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1493224812409417729]' derivation='None' name='[none:Calculation_1493224812409417729:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_type]' derivation='None' name='[none:business_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date (copia)_1411034090470805504]' derivation='None' name='[none:order_date (copia)_1411034090470805504:ok]' pivot='key' type='ordinal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[user_segment]' derivation='None' name='[none:user_segment:nk]' pivot='key' type='nominal' />
