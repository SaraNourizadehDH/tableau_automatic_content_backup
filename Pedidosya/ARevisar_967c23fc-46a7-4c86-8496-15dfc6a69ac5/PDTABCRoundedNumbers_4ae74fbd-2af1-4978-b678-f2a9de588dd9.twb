      <filter class='categorical' column='[none:session_platform:nk]' filter-group='2'>
        <groupfilter function='level-members' level='[none:session_platform:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[none:variant:nk]' filter-group='2'>
        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[none:variant:nk]' member='%null%' />
          <groupfilter from='&quot;Control&quot;' function='range' level='[none:variant:nk]' to='&quot;Variation2&quot;' />
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_302A1DEE115247D19144F7B5E585E0C5'>
            <properties context=''>
              <relation connection='bigquery.0elf477148kjeq1apns881kwooup' name='Custom SQL Query' type='text'><![CDATA[WITH aux AS
 (
 SELECT 
    sessionId AS perseus_session_id
    , time
    , userId
    , DATE(time) session_date
    , MAX(CASE WHEN d.key = 'flag_result' THEN d.value ELSE NULL END) variant
    , MAX(CASE WHEN d.key = 'perseus_client_id' THEN d.value ELSE NULL END) perseus_client_id
    FROM `peya-data-origins-pro.cl_core.dataregisterapi` 
    ,UNNEST(data) d
  WHERE DATE(time) >>= "2021-12-12"
  AND source = "DTS-dynamic-range-formula"
  AND d.key = 'flag_result'
  AND sessionId <<>> '0' 
  AND userId <<>> -1
  GROUP BY 1,2,3
),

last_hit AS 
(
SELECT DISTINCT 
    userId
    , session_date
    , MAX(time) max_time 
    FROM aux GROUP BY 1,2
),
ingestor as
(
SELECT DISTINCT s1.userId userId, s1.variant, s1.session_date ingestor_date
  FROM aux s1 
  INNER JOIN last_hit s2 ON s1.userId = s2.userId AND s1.time = s2.max_time
)

, sessions AS
 (
    SELECT 
        concat(fullvisitor_id, CAST(visit_id AS STRING), cast(date_ga as string), platform) as ga_session_id
        , case when user_id is null or user_id in ('not_yet','0') then 'no user' else 'user' end as has_user
        , user_id
        , date_ga as session_date
        , session_start_timestamp
        , lower(iso_code_2) country
        , platform as session_platform
        , is_transaction
        , extract (hour from datetime(s.session_start_timestamp, timezone)) session_hour_start
        , mcvr2
        , mcvr3
        , mcvr4
        , time_start_home
        , time_start_list
        , time_start_menu
        , time_start_cart
        , time_start_checkout
        , visit_type
   
        FROM `peya-data-origins-pro.cl_sessions.ga_sessions` s
        LEFT JOIN `peya-data-origins-pro.cl_core.country_details` c on c.country_name_en = s.country
        WHERE partition_date >>= "2021-12-12"
        AND LOWER(platform) not like '%courier%'
        and lower(iso_code_2) in ("cl","pe","pa","uy","do","bo")
        and datetime(s.session_start_timestamp) >>= datetime(2021,12,13,22,00,00)
)
, shoplist AS (
    SELECT 
          date(date) as date
        , concat(fullVisitorId, CAST(visitId AS STRING), cast(date(date) as string), platform) as ga_session_id
        , min(hitTimestamp) as loaded_timestamp
        FROM  `peya-data-origins-pro.cl_sessions.Pedidosya_ga_hits` h
        WHERE DATE(date)  >>= "2021-12-12"
        AND eventAction IN ('shop_list.updated', 'shop_list.loaded')
        GROUP BY 1,2
)
    
, segments AS
(
    SELECT
     user_id
    ,date(date) as date
    ,segment as user_segment

    FROM `peya-growth-and-onboarding.automated_tables_reports.user_segments`
    WHERE date >>= "2021-12-12"
)
    
SELECT 
session_date
, variant
, country
, user_segment
, session_platform
, visit_type
, session_hour_start
    , COUNT(DISTINCT s.ga_session_id) AS sessions
    , COUNT(DISTINCT CASE WHEN is_transaction = 1 THEN s.ga_session_id ELSE NULL END) AS sessions_with_transaction
    , COUNT(DISTINCT CASE WHEN mcvr2 >>= 1 THEN s.ga_session_id ELSE NULL END) AS mcvr2
    , COUNT(DISTINCT CASE WHEN mcvr3 >>= 1 THEN s.ga_session_id ELSE NULL END) AS mcvr3
    , COUNT(DISTINCT CASE WHEN mcvr4 >>= 1 THEN s.ga_session_id ELSE NULL END) AS mcvr4
    , COUNT(DISTINCT CASE WHEN mcvr2 IN (0,1) THEN s.ga_session_id ELSE NULL END) mcvr2_sessions
    , COUNT(DISTINCT CASE WHEN mcvr3 IN (0,1) THEN s.ga_session_id ELSE NULL END) mcvr3_sessions
    , COUNT(DISTINCT CASE WHEN mcvr4 IN (0,1) THEN s.ga_session_id ELSE NULL END) mcvr4_sessions
    , COUNT(DISTINCT CASE WHEN is_transaction = 1 AND time_start_home IS NOT NULL      THEN s.ga_session_id ELSE NULL END) CVR1
    , COUNT(DISTINCT CASE WHEN is_transaction = 1 AND sl.ga_session_id IS NOT NULL     THEN s.ga_session_id ELSE NULL END) CVR2
    , COUNT(DISTINCT CASE WHEN is_transaction = 1 AND time_start_menu IS NOT NULL      THEN s.ga_session_id ELSE NULL END) CVR3
    , COUNT(DISTINCT CASE WHEN is_transaction = 1 AND time_start_checkout IS NOT NULL  THEN s.ga_session_id ELSE NULL END) CVR4
    , COUNT(DISTINCT CASE WHEN time_start_home IS NOT NULL      THEN s.ga_session_id ELSE NULL END) CVR1_sessions
    , COUNT(DISTINCT CASE WHEN sl.ga_session_id IS NOT NULL     THEN s.ga_session_id ELSE NULL END) CVR2_sessions
    , COUNT(DISTINCT CASE WHEN time_start_menu IS NOT NULL      THEN s.ga_session_id ELSE NULL END) CVR3_sessions
    , COUNT(DISTINCT CASE WHEN time_start_checkout IS NOT NULL  THEN s.ga_session_id ELSE NULL END) CVR4_sessions
    FROM sessions s
    LEFT JOIN ingestor i 
        on safe_cast(s.user_id as int64)  = i.userId and i.ingestor_date = date(s.session_start_timestamp)
    LEFT JOIN segments us 
        ON s.user_id = CAST(us.user_id as string) 
        AND date(s.session_date) = us.date
    LEFT JOIN shoplist sl 
        ON s.ga_session_id = sl.ga_session_id 
    GROUP BY 1,2,3,4,5,6,7]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
