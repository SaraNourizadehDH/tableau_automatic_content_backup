    <worksheet name='Ctrlp.p. V1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>p.p. Dif Var1</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders Data' name='federated.1eyzs8p0iizp39133e4ka1e5hv7t' />
            <datasource caption='Sessions Data' name='federated.0sejtf80zpo25b14zkzqy04i03o9' />
          </datasources>
          <datasource-dependencies datasource='federated.0sejtf80zpo25b14zkzqy04i03o9'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eyzs8p0iizp39133e4ka1e5hv7t'>
            <column caption='V1 p.p. Early Orders' datatype='real' default-format='p0.0%' name='[% Early Orders  (copy)_1493224812836720669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;Early&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;Early&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V1 p.p. Late &gt; 5&apos; Orders' datatype='real' default-format='p0.0%' name='[% Late &gt; 5&apos; Orders (copy)_1493224812836720668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [pdt_performance] = &quot;Late &gt; 5&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [pdt_performance] = &quot;Late &gt; 5&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V1 p.p. Late Orders' datatype='real' default-format='p0.0%' name='[% Late Orders (copy)_1493224812836720666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;Late&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='V1 p.p. On Time Orders' datatype='real' default-format='p0.0%' name='[% On Time Orders (copy)_1493224812836720667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Variation1&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))*100&#10;-&#10;(SUM(if [Calculation_3484519533444169730] = &quot;On Time&quot; and [variant] = &quot;Control&quot; and [order_state] = &quot;confirmed&quot; then [orders] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))*100' />
            </column>
            <column caption='Is Today' datatype='boolean' name='[Calculation_1493224812409417729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
            </column>
            <column caption='V1 dif Avg TES Promise' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1756474287268577280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [sum_tes_pdt] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))&#10;-&#10;(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [sum_tes_pdt] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))' />
            </column>
            <column caption='Order State vs PDT' datatype='string' name='[Calculation_3484519533444169730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pdt_performance] = &quot;Late &lt;= 10&quot; or [pdt_performance] = &quot;Late &gt; 10&quot; then &quot;Late&quot; else [pdt_performance] end' />
            </column>
            <column caption='V1 dif Avg Max Promise' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Promise range (copy)_1493224812839206946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [sum_max_minutes] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))&#10;-&#10;(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [sum_max_minutes] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))' />
            </column>
