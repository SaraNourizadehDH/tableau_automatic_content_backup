              <calculation class='tableau' formula='(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [sum_tes_pdt] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation1&quot; then [orders] else 0 end))&#10;/&#10;(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [sum_tes_pdt] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end)) - 1' />
