    <worksheet name='FV'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#4e79a7' fontsize='14'>Order KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders Data' name='federated.1eyzs8p0iizp39133e4ka1e5hv7t' />
            <datasource caption='Sessions Data' name='federated.0sejtf80zpo25b14zkzqy04i03o9' />
          </datasources>
          <datasource-dependencies datasource='federated.0sejtf80zpo25b14zkzqy04i03o9'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[user_segment]' derivation='None' name='[none:user_segment:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[user_segment]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eyzs8p0iizp39133e4ka1e5hv7t'>
            <column caption='HC SR (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_1493224812406673408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [withLogistics] then [hc_sessions_checkstatus] + [hc_sessions_lateorder] + [hc_sessions_restprep] else 0 end)&#10;/ [Calculation_783837457399910400]' />
            </column>
            <column caption='Is Today' datatype='boolean' name='[Calculation_1493224812409417729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
            </column>
            <column caption='HC Session Rate' datatype='real' default-format='p0.00%' name='[Calculation_3484519533445013507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [withLogistics] then [helpcenter_sessions] else 0 end) / [Calculation_783837457399910400]' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_3484519533447671812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [order_state] &lt;&gt; &quot;confirmed&quot; and [withLogistics] then [orders] else 0 end) &#10;/[Calculation_783837457399910400]' />
            </column>
            <column caption='Fail Rate (PDT Related)' datatype='real' default-format='p0.00%' name='[Calculation_3484519533448581125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;if [order_state] &lt;&gt; &quot;confirmed&quot; and [fail_rate_pdt_related] = &quot;PDT Related&quot; and [withLogistics] then&#10;    [orders] else 0 end&#10;)  &#10;/ [Calculation_783837457399910400]' />
            </column>
            <column caption='Contact Rate' datatype='real' default-format='p0.0%' name='[Calculation_3484519533455712274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [withLogistics] then [contacts] else 0 end)/[Calculation_783837457399910400]' />
            </column>
            <column caption='OD Orders' datatype='integer' name='[Calculation_783837457399910400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [withLogistics] then [orders] else 0 end)' />
            </column>
            <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
