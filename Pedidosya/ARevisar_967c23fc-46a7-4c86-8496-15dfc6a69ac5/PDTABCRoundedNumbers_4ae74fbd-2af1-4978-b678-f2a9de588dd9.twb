              <calculation class='tableau' formula='(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [sum_max_minutes] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Variation2&quot; then [orders] else 0 end))&#10;-&#10;(SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [sum_max_minutes] else 0 end)&#10;/&#10;SUM(if [order_state] = &quot;confirmed&quot; and [variant] = &quot;Control&quot; then [orders] else 0 end))' />
