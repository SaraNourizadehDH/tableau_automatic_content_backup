      <datasource-dependencies datasource='Parameters'>
        <column caption='KPIs Sessions' datatype='string' name='[KPIs Orders (copy)_4466867211357622272]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR&quot;'>
          <calculation class='tableau' formula='&quot;CVR&quot;' />
        </column>
