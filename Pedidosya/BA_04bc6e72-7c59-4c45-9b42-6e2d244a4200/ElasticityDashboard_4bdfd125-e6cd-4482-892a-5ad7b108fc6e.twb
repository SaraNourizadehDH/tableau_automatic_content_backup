          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Variation' datatype='string' name='[pctch_df Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variation1&quot;'>
              <calculation class='tableau' formula='&quot;Variation1&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xyjy2t0cptc0b1eqsfmq1biz3uz'>
            <column caption='Scaled CM1' datatype='real' default-format='c&quot;$ &quot;#,##0;-&quot;$ &quot;#,##0' name='[Calculation_1060597778314371072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1552897505951735823]*[Total_Orders (Sheet11)]' />
            </column>
            <column caption='Cost per Incremental Order' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Calculation_1352205856746496000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1552897505936998409]- SUM(IF  [variant] = &apos;Control&apos; THEN [Calculation_1060597778314371072]END))/ABS([Calculation_1552897505937760267]-sum([Total_Orders (Sheet11)]))' />
            </column>
            <column caption='Delta CM1' datatype='real' default-format='p0.00%' name='[Calculation_1552897505932017670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[pctch_df Parameter] = &apos;Variation1&apos; THEN SUM(IF [variant]= &apos;Variation1&apos; THEN [pctch_cm] END)&#13;&#10;ELSEIF [Parameters].[pctch_df Parameter] = &apos;Variation2&apos; THEN SUM(IF [variant]= &apos;Variation2&apos; THEN [pctch_cm] END)&#13;&#10;ELSEIF [Parameters].[pctch_df Parameter] = &apos;Variation3&apos; THEN SUM(IF [variant]= &apos;Variation3&apos; THEN [pctch_cm] END)&#13;&#10;ELSEIF [Parameters].[pctch_df Parameter] = &apos;Variation4&apos; THEN SUM(IF [variant]= &apos;Variation4&apos; THEN [pctch_cm] END) END' />
            </column>
            <column caption='Delta Orders' datatype='real' default-format='p0.00%' name='[Calculation_1552897505932374023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[pctch_df Parameter] = &apos;Variation1&apos; THEN SUM(IF [variant]= &apos;Variation1&apos; THEN [pctch_orders] END)&#13;&#10;ELSEIF [Parameters].[pctch_df Parameter] = &apos;Variation2&apos; THEN SUM(IF [variant]= &apos;Variation2&apos; THEN [pctch_orders] END)&#13;&#10;ELSEIF [Parameters].[pctch_df Parameter] = &apos;Variation3&apos; THEN SUM(IF [variant]= &apos;Variation3&apos; THEN [pctch_orders] END)&#13;&#10;ELSEIF [Parameters].[pctch_df Parameter] = &apos;Variation4&apos; THEN SUM(IF [variant]= &apos;Variation4&apos; THEN [pctch_orders] END) END' />
            </column>
            <column caption='Implementation CM1' datatype='real' default-format='c&quot;$ &quot;#,##0;-&quot;$ &quot;#,##0' name='[Calculation_1552897505936998409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [variant] = &apos;Control&apos; THEN [Calculation_1060597778314371072] END)*(1+[Calculation_1552897505932017670])' />
            </column>
            <column caption='Implementation Orders' datatype='real' name='[Calculation_1552897505937760267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1552897505940848654]*(1+[Calculation_1552897505932374023])' />
            </column>
            <column caption='Orders b4' datatype='integer' name='[Calculation_1552897505940848654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [variant (Sheet11)] = &apos;b4_test&apos; THEN [Total_Orders (Sheet11)] END)' />
            </column>
            <column caption='CM1 per Order' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Calculation_1552897505951735823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total_CM1]/[Total_Orders]' />
            </column>
            <column caption='Total CM1' datatype='real' default-format='c&quot;$ &quot;#,##0;-&quot;$ &quot;#,##0' name='[Total_CM1]' role='measure' type='quantitative' />
            <column caption='Total Orders (Sheet11)' datatype='integer' name='[Total_Orders (Sheet11)]' role='measure' type='quantitative' />
            <column caption='Total Orders' datatype='integer' name='[Total_Orders]' role='measure' type='quantitative' />
            <column-instance column='[test_name]' derivation='None' name='[none:test_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[treatment (Sheet11)]' derivation='None' name='[none:treatment (Sheet11):nk]' pivot='key' type='nominal' />
            <column-instance column='[treatment]' derivation='None' name='[none:treatment:nk]' pivot='key' type='nominal' />
            <column-instance column='[variant (Sheet11)]' derivation='None' name='[none:variant (Sheet11):nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_price_scheme_type (Sheet11)]' derivation='None' name='[none:vendor_price_scheme_type (Sheet11):nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_price_scheme_type]' derivation='None' name='[none:vendor_price_scheme_type:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[pctch_cm]' role='measure' type='quantitative' />
            <column datatype='real' name='[pctch_orders]' role='measure' type='quantitative' />
            <column caption='Test Name' datatype='string' name='[test_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[treatment (Sheet11)]' role='dimension' type='nominal' />
            <column caption='Treatment' datatype='string' name='[treatment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1352205856746496000]' derivation='User' name='[usr:Calculation_1352205856746496000:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[variant (Sheet11)]' role='dimension' type='nominal' />
