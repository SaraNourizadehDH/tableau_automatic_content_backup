          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Success type' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gateway SCCR&quot;'>
              <calculation class='tableau' formula='&quot;Gateway SCCR&quot;' />
            </column>
            <column alias='Exclude Ins. Funds' caption='Ins funds type' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Exclude insufficient funds&quot;'>
              <calculation class='tableau' formula='&quot;Exclude insufficient funds&quot;' />
              <aliases>
                <alias key='&quot;Exclude insufficient funds&quot;' value='Exclude Ins. Funds' />
                <alias key='&quot;Include insufficient funds&quot;' value='Include Ins. Funds' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ha3dbj1m3ik4o1bsl5ww1ums29c'>
            <column caption='Initiative' datatype='string' name='[initiative]' role='dimension' type='nominal' />
            <column-instance column='[initiative]' derivation='None' name='[none:initiative:nk]' pivot='key' type='nominal' />
            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:qk]' pivot='key' type='quantitative' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bxj1hr0xzzc4s13tpsyz19h6yvo'>
            <column caption='Accr' datatype='real' name='[Calculation_1074108533926191104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1898267280947785732])/SUM([Calculation_1898267280945385474])' />
            </column>
            <column caption='Date view agg' datatype='datetime' name='[Calculation_1074108533927084033]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[registered_date]) &#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;,[registered_date]) &#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;,[registered_date]) &#13;&#10;END' />
            </column>
            <column caption='Sccr single attempt' datatype='real' name='[Calculation_1336443212435673088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [payment_attempts]=1 THEN [Calculation_1898267280947785732] ELSE 0 END)&#13;&#10;/ SUM([Calculation_1898267280945385474])' />
            </column>
            <column caption='Total Quantity by parameters' datatype='integer' name='[Calculation_1898267280945385474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&quot;Include insufficient funds&quot;&#13;&#10;    THEN (IF [Parameters].[Parameter 5]=&quot;Payment SCCR&quot; THEN [total_quantity] ELSE [gateway_quantity] END)&#13;&#10;    ELSE (IF [Parameters].[Parameter 5]=&quot;Payment SCCR&quot; THEN&#13;&#10;        (IF [reason]=&quot;INSUFFICIENT_FUNDS&quot; THEN NULL ELSE [total_quantity] END)&#13;&#10;        ELSE (IF [reason]=&quot;INSUFFICIENT_FUNDS&quot; THEN NULL ELSE [gateway_quantity] END) END)&#13;&#10;END' />
            </column>
            <column caption='Quantity by parameters' datatype='integer' name='[Calculation_1898267280947785732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&quot;Include insufficient funds&quot;&#13;&#10;    THEN [quantity]&#13;&#10;    ELSE (IF [reason]=&quot;INSUFFICIENT_FUNDS&quot; THEN NULL ELSE [quantity] END) END' />
            </column>
            <column caption='Sccr multi attempt' datatype='real' name='[Sccr first attempt (copy)_1336443212439764995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [payment_attempts]&gt;1 AND [payment_method]=[last_payment_method]&#13;&#10;    THEN [Calculation_1898267280947785732] ELSE 0 END)&#13;&#10;/ SUM([Calculation_1898267280945385474])' />
            </column>
            <column caption='Sccr recovery' datatype='real' name='[Sccr first attempt (copy)_1336443212454801413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [payment_attempts]&gt;1 AND [payment_method]!=[last_payment_method]&#13;&#10;    THEN [Calculation_1898267280947785732] ELSE 0 END)&#13;&#10;/ SUM([Calculation_1898267280945385474])' />
