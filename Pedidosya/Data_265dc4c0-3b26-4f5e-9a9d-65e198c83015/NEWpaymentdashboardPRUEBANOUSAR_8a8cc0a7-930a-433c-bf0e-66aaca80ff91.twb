          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Success type' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gateway SCCR&quot;'>
              <calculation class='tableau' formula='&quot;Gateway SCCR&quot;' />
            </column>
            <column alias='Exclude Ins. Funds' caption='Ins funds type' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Exclude insufficient funds&quot;'>
              <calculation class='tableau' formula='&quot;Exclude insufficient funds&quot;' />
              <aliases>
                <alias key='&quot;Exclude insufficient funds&quot;' value='Exclude Ins. Funds' />
                <alias key='&quot;Include insufficient funds&quot;' value='Include Ins. Funds' />
