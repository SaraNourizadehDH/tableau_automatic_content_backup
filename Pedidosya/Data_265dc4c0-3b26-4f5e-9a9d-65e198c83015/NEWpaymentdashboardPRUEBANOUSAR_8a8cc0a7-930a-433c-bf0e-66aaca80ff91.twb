    <worksheet name='heatmap'>
      <table>
        <view>
          <datasources>
            <datasource caption='All payments' name='federated.0ha3dbj1m3ik4o1bsl5ww1ums29c' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Heatmap var 2 sel' datatype='string' name='[Heatmap variable 1 (copy)_1068760497296924674]' param-domain-type='list' role='measure' type='nominal' value='&quot;Card Type&quot;'>
              <calculation class='tableau' formula='&quot;Card Type&quot;' />
            </column>
            <column caption='Heatmap var 1 sel' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Card Operation Type&quot;'>
              <calculation class='tableau' formula='&quot;Card Operation Type&quot;' />
            </column>
            <column caption='Success type' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gateway SCCR&quot;'>
              <calculation class='tableau' formula='&quot;Gateway SCCR&quot;' />
            </column>
            <column alias='Exclude Ins. Funds' caption='Ins funds type' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Exclude insufficient funds&quot;'>
              <calculation class='tableau' formula='&quot;Exclude insufficient funds&quot;' />
              <aliases>
                <alias key='&quot;Exclude insufficient funds&quot;' value='Exclude Ins. Funds' />
                <alias key='&quot;Include insufficient funds&quot;' value='Include Ins. Funds' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ha3dbj1m3ik4o1bsl5ww1ums29c'>
            <column caption='Heatmap var 1' datatype='string' name='[Calculation_1068760497287270400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &quot;Initiative&quot; THEN [initiative]    &#13;&#10;    WHEN &quot;Payment type&quot; THEN [payment_type]&#13;&#10;    WHEN &quot;Country&quot; THEN [country]&#13;&#10;    WHEN &quot;Card Operation Type&quot; THEN [card_operation_type]&#13;&#10;    WHEN &quot;Card Type&quot; THEN [card_type]&#13;&#10;    WHEN &quot;Card Issuer&quot; THEN [card_issuer]&#13;&#10;    WHEN &quot;Provider&quot; THEN [provider]&#13;&#10;    WHEN &quot;Card Status&quot; THEN [card_status]&#13;&#10;    WHEN &quot;Card Acquirer&quot; THEN [card_acquirer]&#13;&#10;    WHEN &quot;Card Gateway&quot; THEN [card_gateway]&#13;&#10;END' />
            </column>
            <column caption='Total Quantity by parameters' datatype='integer' name='[Calculation_1429892919355015170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6]=&quot;Include insufficient funds&quot;&#13;&#10;    THEN (IF [Parameters].[Parameter 5]=&quot;Payment SCCR&quot; THEN [total_quantity] ELSE [gateway_quantity] END)&#13;&#10;    ELSE (IF [Parameters].[Parameter 5]=&quot;Payment SCCR&quot; THEN&#13;&#10;        (IF [reason]=&quot;INSUFFICIENT_FUNDS&quot; THEN NULL ELSE [total_quantity] END)&#13;&#10;        ELSE (IF [reason]=&quot;INSUFFICIENT_FUNDS&quot; THEN NULL ELSE [gateway_quantity] END) END)&#13;&#10;END' />
            </column>
            <column caption='Heatmap var 2' datatype='string' name='[Heatmap var 1 (copy)_1068760497296424961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Heatmap variable 1 (copy)_1068760497296924674]&#13;&#10;    WHEN &quot;Initiative&quot; THEN [initiative]    &#13;&#10;    WHEN &quot;Payment type&quot; THEN [payment_type]&#13;&#10;    WHEN &quot;Country&quot; THEN [country]&#13;&#10;    WHEN &quot;Card Operation Type&quot; THEN [card_operation_type]&#13;&#10;    WHEN &quot;Card Type&quot; THEN [card_type]&#13;&#10;    WHEN &quot;Card Issuer&quot; THEN [card_issuer]&#13;&#10;    WHEN &quot;Provider&quot; THEN [provider]&#13;&#10;    WHEN &quot;Card Status&quot; THEN [card_status]&#13;&#10;    WHEN &quot;Card Acquirer&quot; THEN [card_acquirer]&#13;&#10;    WHEN &quot;Card Gateway&quot; THEN [card_gateway]&#13;&#10;END' />
            </column>
            <column caption='Sccr by parameters' datatype='real' name='[Sccr global (copy)_1429892919346966528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([quantity])/SUM([Calculation_1429892919355015170])' />
            </column>
