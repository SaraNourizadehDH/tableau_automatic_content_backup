      <aliases enabled='yes' />
      <column caption='% country AP orders' datatype='real' default-format='p0.00%' name='[% country OP orders (copia)_5486510313666998289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_AP_orders]) / TOTAL(SUM([confirmed_AP_orders]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='% total AP orders' datatype='real' default-format='p0.00%' name='[% total OP orders (copia)_5486510313666740240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_AP_orders]) / TOTAL(SUM([confirmed_AP_orders]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='% country OP orders' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_OP_orders]) / TOTAL(SUM([confirmed_OP_orders]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='% total OP orders' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_OP_orders]) / TOTAL(SUM([confirmed_OP_orders]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='OP country rank' datatype='integer' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([confirmed_OP_orders]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='OP total rank' datatype='integer' name='[Calculation5]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([confirmed_OP_orders]))'>
          <table-calc ordering-type='Field'>
            <order field='[federated.1rawo7d1b6ln2s10ss9yl1vm7yju].[country]' />
            <order field='[federated.1rawo7d1b6ln2s10ss9yl1vm7yju].[Calculation_1217660792587812869]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='SPOP' datatype='real' default-format='p0.0%' name='[Calculation_1217660792342351872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([OP_partners_online])/sum([total_partners_online])' />
      </column>
      <column caption='City' datatype='string' name='[Calculation_1217660792587812869]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [country]=&apos;Bolivia&apos; and [city]=&apos;Montevideo&apos; THEN &apos;Unknown&apos; ELSE [city] END' />
      </column>
      <column caption='Cálculo1' datatype='integer' name='[Calculation_1852105375525437441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([confirmed_OP_orders]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Hide' datatype='string' name='[Calculation_539024625266569225]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF LAST()=0 THEN &apos;Hide&apos; ELSE &apos;Show&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_539024625865715723]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)_539024625865244682]&#13;&#10;WHEN &apos;Month&apos; THEN [month]&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[month])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[month],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[month])) ELSE DATETRUNC(&quot;year&quot;,[month]) END)&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[month])&#13;&#10;END' />
      </column>
      <column caption='AP country rank' datatype='integer' name='[OP country rank (copia)_5486510313668186134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([confirmed_AP_orders]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='Partners with OP' datatype='integer' name='[OP_partners_online]' role='measure' type='quantitative' />
      <column caption='SOAP' datatype='real' default-format='p0.0%' name='[SOOP (copia)_5486510313654554639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_AP_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='SOOP' datatype='real' default-format='p0.0%' name='[SPOP (copy)_1217660792345460737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_OP_orders])/sum([confirmed_orders])' />
      </column>
