    <datasource caption='BQ - Orders' inline='true' name='federated.04hrs2z15ygd3r10g8nbq1mldfdd' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1ehby6s1y80m2w1dheio21ja7hs6'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='user_santiago_castillo' server-oauth='' username='martin.di@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
