      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_15A6DB6DED2349E9B43C55A322A7D289'>
            <properties context=''>
              <relation connection='bigquery.0l1smbe0zjqix614gwkfn0fvf1fu' name='Consulta_SQL_personalizada' type='text'>SELECT&#13;
  P.full_date AS month,&#13;
  ct.country_name AS country,&#13;
  cs.name AS city,&#13;
  P.has_online_payment,&#13;
  P.is_important_account,&#13;
  P.accepts_vouchers,&#13;
  bt.name AS vertical,&#13;
  P.is_logistic,&#13;
  COUNT(DISTINCT CASE WHEN P.is_online = TRUE THEN P.restaurant_id ELSE NULL END) AS total_partners_online,&#13;
  COUNT(DISTINCT CASE WHEN P.is_online = TRUE AND P.has_online_payment = TRUE THEN P.restaurant_id ELSE NULL END) AS OP_partners_online,&#13;
  COUNT(DISTINCT CASE WHEN O.order_status = &apos;CONFIRMED&apos; THEN O.order_id ELSE NULL END) AS confirmed_orders,&#13;
  COUNT(DISTINCT CASE WHEN O.order_status = &apos;CONFIRMED&apos; AND O.paymentMethod.online = TRUE THEN O.order_id ELSE NULL END) AS confirmed_OP_orders,&#13;
  COUNT(DISTINCT case when O.order_status = &apos;CONFIRMED&apos; AND (O.paymentMethod.online = true or (O.type in(&apos;CASH&apos;) and O.amount = 0) or (O.type in(&apos;THIRD_PARTY_OFFLINE&apos;) and O.amount = 0)) then O.order_id ELSE NULL END) as confirmed_AP_orders &#13;
FROM&#13;
  `peya-bi-tools-pro.il_core.fact_partners_monthly` P&#13;
LEFT JOIN&#13;
  `peya-data-origins-pro.cl_core.country` ct ON ct.country_id = P.country_id&#13;
JOIN&#13;
  `peya-data-origins-pro.cl_core.country_details` co ON co.country_id = P.country_id&#13;
LEFT JOIN&#13;
  `peya-data-origins-pro.cl_core.city` cs ON cs.id = P.city_id&#13;
LEFT JOIN&#13;
  `peya-data-origins-pro.cl_core.business_type` bt ON bt.id = P.business_type&#13;
LEFT JOIN&#13;
(SELECT &#13;
  O.registered_date,&#13;
  O.registered_date_id,&#13;
  O.order_id,&#13;
  O.restaurant.id as restaurant_id,&#13;
  O.order_status,&#13;
  O.paymentMethod,&#13;
  f.type,&#13;
  f.amount&#13;
FROM&#13;
  `peya-bi-tools-pro.il_core.fact_orders` O, unnest (fundings) f&#13;
  WHERE DATE(O.registered_date) &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -12 MONTH)) O ON O.restaurant_id = P.restaurant_id&#13;
  AND SUBSTR(CAST(O.registered_date_id AS STRING),1,6) = SUBSTR(CAST(P.date_id AS STRING),1,6)&#13;
&#13;
WHERE&#13;
  DATE(P.full_date) &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -12 MONTH)&#13;
  AND co.active=TRUE&#13;
GROUP BY&#13;
  P.full_date,&#13;
  ct.country_name,&#13;
  cs.name,&#13;
  P.has_online_payment,&#13;
  P.is_important_account,&#13;
  P.accepts_vouchers,&#13;
  bt.name,&#13;
  P.is_logistic</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
