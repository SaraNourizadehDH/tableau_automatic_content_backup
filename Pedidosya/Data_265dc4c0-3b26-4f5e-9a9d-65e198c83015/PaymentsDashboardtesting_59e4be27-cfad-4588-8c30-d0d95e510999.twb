              <calculation class='tableau' formula='SUM(CASE [is_op] WHEN TRUE THEN [total_orders] END)/SUM([total_orders])' />
            </column>
            <column caption='Fecha' datatype='datetime' default-format='*d/m/yy' name='[Calculation_714946483163217931]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN [fecha]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&quot;week&quot;,[fecha])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&quot;month&quot;,[fecha])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[fecha])&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[fecha])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[fecha],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[fecha])) ELSE DATETRUNC(&quot;year&quot;,[fecha]) END)&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column datatype='string' name='[Platform]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[platform]' new-bin='true'>
                <bin default-name='false' value='&quot;Android&quot;'>
                  <value>&quot;ANDROID&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;IOS&quot;'>
                  <value>&quot;IPHONE&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Others&quot;'>
                  <value>&quot;COURIER&quot;</value>
                  <value>&quot;COURIER_API&quot;</value>
                  <value>&quot;IPAD&quot;</value>
                  <value>&quot;WIDGET&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Web Desktop&quot;'>
                  <value>&quot;WEB&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Web Mobile&quot;'>
                  <value>&quot;WEB_MOBILE&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='total_orders_online' datatype='integer' name='[SOOP (copy)_714946483132321793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_op] WHEN TRUE THEN [total_orders] END' />
