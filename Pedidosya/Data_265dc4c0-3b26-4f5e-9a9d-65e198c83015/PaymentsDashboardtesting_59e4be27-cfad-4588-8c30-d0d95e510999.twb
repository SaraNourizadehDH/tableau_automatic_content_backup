                        , t.with_logistics&#13;
                        , SUM(t.total_gmv)/AVG(CAST(X.rate_eu AS NUMERIC)) as gmv_eur&#13;
                        , SUM(t.total_orders) as total_orders&#13;
                        , SUM(t.voucher_orders) as voucher_orders         &#13;
                    FROM (&#13;
