      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_EBF071A91B524F44B51FA7DADAFD7A24'>
            <properties context=''>
              <relation connection='bigquery.1w76rx41238j8w15dfn251t1kdey' name='Consulta_SQL_personalizada' type='text'>SELECT  t.month&#13;
        , t.country&#13;
        , t.user_platform&#13;
        , t.op_only as op_only_last_6mo&#13;
        , t.cash_only as cash_only_last_6mo&#13;
        , CASE WHEN t.confirmed_orders = confirmed_OP_orders THEN &apos;user_OP_only&apos;&#13;
                WHEN t.confirmed_orders = confirmed_Offline_orders THEN  &apos;user_cash_only&apos;&#13;
                ELSE &apos;user_mixed&apos; end as user_pm_type  &#13;
        , CASE WHEN t.confirmed_orders = confirmed_AP_orders THEN &apos;user_AP_only&apos;&#13;
                WHEN (t.confirmed_orders = confirmed_Offline_orders AND confirmed_Offline_orders != confirmed_AP_orders) THEN  &apos;user_cash_only&apos;&#13;
                ELSE &apos;user_mixed&apos; end as user_apm_type  &#13;
        , COUNT(DISTINCT t.user_id) as active_users&#13;
        , SUM(t.confirmed_orders) as confirmed_orders&#13;
        , SUM(t.confirmed_OP_orders) as confirmed_OP_orders&#13;
        , SUM(t.confirmed_AP_orders) as confirmed_AP_orders&#13;
        , SUM (t.confirmed_Offline_orders) as confirmed_Offline_orders&#13;
        , SUM(t.total_orders) as total_orders&#13;
        , SUM(t.total_OP_orders) as total_OP_orders&#13;
        , SUM(t.total_AP_orders) as total_AP_orders        &#13;
        FROM&#13;
                      ( SELECT &#13;
                      DATE_TRUNC(DATE(O.registered_date), MONTH) as month&#13;
                      , ct.country_name as country&#13;
                      , U.platform  as user_platform&#13;
                      , U.user_id as user_id&#13;
                      , k.op_only&#13;
                      , k.cash_only&#13;
                      , COUNT(DISTINCT CASE WHEN O.order_status = &apos;CONFIRMED&apos; THEN O.order_id ELSE NULL END) as confirmed_orders&#13;
                      , COUNT(DISTINCT CASE WHEN O.order_status = &apos;CONFIRMED&apos; AND O.paymentMethod.online = TRUE THEN O.order_id ELSE NULL END) as confirmed_OP_orders&#13;
                      , COUNT(DISTINCT CASE WHEN O.order_status = &apos;CONFIRMED&apos; AND O.paymentMethod.online = FALSE THEN O.order_id ELSE NULL END) as confirmed_Offline_orders&#13;
                      , COUNT(DISTINCT case when O.order_status = &apos;CONFIRMED&apos; AND (O.paymentMethod.online = true or (f.type in(&apos;CASH&apos;) and f.amount = 0) or (f.type in(&apos;THIRD_PARTY_OFFLINE&apos;) and f.amount = 0)) then O.order_id ELSE NULL END) as confirmed_AP_orders &#13;
                      , COUNT(DISTINCT O.order_id) as total_orders&#13;
                      , COUNT(DISTINCT CASE WHEN O.paymentMethod.online = TRUE THEN O.order_id ELSE NULL END) as total_OP_orders&#13;
                      , COUNT(DISTINCT case when (O.paymentMethod.online = true or (f.type in(&apos;CASH&apos;) and f.amount = 0) or (f.type in(&apos;THIRD_PARTY_OFFLINE&apos;) and f.amount = 0)) then O.order_id ELSE NULL END) as total_AP_orders &#13;
                      FROM `peya-bi-tools-pro.il_core.fact_orders` AS O, unnest (fundings) f&#13;
                        LEFT JOIN `peya-bi-tools-pro.il_core.dim_user` U ON U.user_id=O.user.id and U.user_type = &apos;WEB_USER&apos;&#13;
                        LEFT JOIN `peya-data-origins-pro.cl_core.user_stats` k ON O.user.id=k.user_id&#13;
                        LEFT JOIN `peya-data-origins-pro.cl_core.country` ct ON ct.country_id = O.country_id  &#13;
                        LEFT JOIN `peya-data-origins-pro.cl_core.country_details` AS co on co.country_id = O.country_id                      &#13;
                        WHERE DATE(O.registered_date) &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -13 MONTH) &#13;
                        AND co.active&#13;
                        GROUP BY 1,2,3,4,5,6&#13;
                      ) as t                     &#13;
                      WHERE month &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -12 MONTH)&#13;
                      GROUP BY 1,2,3,4,5,6,7</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
