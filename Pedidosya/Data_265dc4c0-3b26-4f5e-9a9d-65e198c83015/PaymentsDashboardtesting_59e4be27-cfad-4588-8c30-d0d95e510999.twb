    <dashboard name='Partners coverage (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>[WIP] Payments Dashboard  </run>
            <run bold='true' fontcolor='#666666'>|</run>
            <run bold='true' fontsize='14'>Æ  </run>
            <run bold='true' fontcolor='#666666' fontsize='14'>Partners coverage</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/PaymentsDashboard_testing/Partnerscoverage2?rev=' id='186223' path='/t/Pedidosya/workbooks/PaymentsDashboard_testing' revision='' site='Pedidosya' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='font-size' value='9' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-size' value='9' />
        </style-rule>
      </style>
      <size maxheight='1468' maxwidth='1300' minheight='1468' minwidth='1300' preset-index='0' sizing-mode='fixed' />
      <datasources>
        <datasource caption='BQ - Partners' name='federated.1rawo7d1b6ln2s10ss9yl1vm7yju' />
      </datasources>
      <datasource-dependencies datasource='federated.1rawo7d1b6ln2s10ss9yl1vm7yju'>
        <column caption='OP country rank' datatype='integer' name='[Calculation3]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='RANK(SUM([confirmed_OP_orders]))'>
            <table-calc ordering-type='ColumnInPane' />
          </calculation>
        </column>
        <column caption='OP total rank' datatype='integer' name='[Calculation5]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='RANK(SUM([confirmed_OP_orders]))'>
            <table-calc ordering-type='Field'>
              <order field='[federated.1rawo7d1b6ln2s10ss9yl1vm7yju].[country]' />
              <order field='[federated.1rawo7d1b6ln2s10ss9yl1vm7yju].[Calculation_1217660792587812869]' />
            </table-calc>
          </calculation>
        </column>
        <column caption='City' datatype='string' name='[Calculation_1217660792587812869]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
          <calculation class='tableau' formula='IF [country]=&apos;Bolivia&apos; and [city]=&apos;Montevideo&apos; THEN &apos;Unknown&apos; ELSE [city] END' />
        </column>
        <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column datatype='boolean' name='[is_important_account]' role='dimension' type='nominal'>
          <aliases>
            <alias key='false' value='Regular' />
            <alias key='true' value='Important' />
          </aliases>
        </column>
        <column datatype='boolean' name='[is_logistic]' role='dimension' type='nominal'>
          <aliases>
            <alias key='false' value='Vendor Delivery' />
            <alias key='true' value='Own Delivery' />
