      <column caption='CBK GMV Rate' datatype='real' default-format='p0.0%' name='[CBK Order Rate (copy)_539024625945141264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_gmv_cbk_eur])/sum([sum_gmv_eur])' />
