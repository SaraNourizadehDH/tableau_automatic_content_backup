    <dashboard name='Success Rate Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>[WIP] Payments Dashboard  </run>
            <run bold='true' fontcolor='#666666'>|</run>
            <run bold='true' fontsize='14'>Æ  </run>
            <run bold='true' fontcolor='#666666' fontsize='14'>Acceptance Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/PaymentsDashboard_testing/SuccessRateDistribution?rev=' id='186217' path='/t/Pedidosya/workbooks/PaymentsDashboard_testing' revision='' site='Pedidosya' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='font-size' value='8' />
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-size' value='8' />
          <format attr='text-align' value='center' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1300' minheight='1000' minwidth='1300' preset-index='0' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='op_acr_daily' name='sqlproxy.1eaa3q00b9uanm18tgsly1uduaca' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
          <calculation class='tableau' formula='&quot;Day&quot;' />
          <members>
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
            <member value='&quot;Quarter&quot;' />
            <member value='&quot;Year&quot;' />
            <member value='&quot;Half&quot;' />
          </members>
        </column>
        <column caption='Rate type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Business&quot;'>
          <calculation class='tableau' formula='&quot;Business&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Business&quot;' />
            <member value='&quot;Gateway&quot;' />
            <member value='&quot;AF intern&quot;' />
            <member value='&quot;AF extern&quot;' />
            <member value='&quot;Internal Block&quot;' />
            <member value='&quot;Tech&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='sqlproxy.1eaa3q00b9uanm18tgsly1uduaca'>
        <column caption='Date' datatype='datetime' name='[Calculation_754352972887744513]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN [fecha]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&quot;week&quot;,[fecha])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&quot;month&quot;,[fecha])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[fecha])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[fecha],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[fecha])) ELSE DATETRUNC(&quot;year&quot;,[fecha]) END)&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[fecha])&#13;&#10;END' />
        </column>
        <column caption='Is New Card' datatype='string' name='[Card_Flag (grupo)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[Card_Flag]' new-bin='true'>
            <bin default-name='false' value='&quot;No Info&quot;'>
              <value>&quot;N/A&quot;</value>
              <value>&quot;NA&quot;</value>
            </bin>
          </calculation>
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Card_Flag]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column caption='Issuer' datatype='string' name='[Date (copy)_539024625219981313]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Date (copy)_539024625203798016]&#13;&#10;WHEN &apos;No info&apos; THEN &apos;No info&apos;&#13;&#10;WHEN &apos;&apos; THEN &apos;No info&apos;&#13;&#10;ELSE [Date (copy)_539024625203798016]&#13;&#10;END' />
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[acquirer]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[card_operation_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
