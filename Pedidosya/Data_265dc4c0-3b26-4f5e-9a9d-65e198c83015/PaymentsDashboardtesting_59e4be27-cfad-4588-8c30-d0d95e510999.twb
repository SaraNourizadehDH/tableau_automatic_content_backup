      <aliases enabled='yes' />
      <column caption='OP conf orders %' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SOOP (copy)_714946483132321793]) / TOTAL(SUM([SOOP (copy)_714946483132321793]))'>
          <table-calc ordering-type='CellInPane' />
        </calculation>
      </column>
      <column caption='Global OP' datatype='real' default-format='p0.0%' name='[Calculation_714946483129348096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [is_op] WHEN TRUE THEN [total_orders] END)/SUM([total_orders])' />
      </column>
      <column caption='Vouchers (OP)' datatype='real' default-format='p0.0%' name='[Calculation_714946483153371143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders_online (copy)_714946483132706818])/SUM([voucher_orders])' />
      </column>
      <column caption='Voucher share (OP)' datatype='real' default-format='p0.0%' name='[Calculation_714946483154894856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders_online (copy)_714946483132706818])/SUM([SOOP (copy)_714946483132321793])' />
      </column>
      <column caption='Fecha' datatype='datetime' default-format='*d/m/yy' name='[Calculation_714946483163217931]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN [fecha]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&quot;week&quot;,[fecha])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&quot;month&quot;,[fecha])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[fecha])&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[fecha])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[fecha],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[fecha])) ELSE DATETRUNC(&quot;year&quot;,[fecha]) END)&#13;&#10;END' />
      </column>
      <column caption='AOV' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[Calculation_714946483228307468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_eur])/sum([total_orders])' />
      </column>
      <column caption='Global AP' datatype='real' default-format='p0.0%' name='[Global AP (copia)_5486510313032249344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [is_ap] WHEN TRUE THEN [total_orders] END)/SUM([total_orders])' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='AP conf orders %' datatype='real' default-format='p0.00%' name='[OP conf orders % (copia)_5486510313032441857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders_online (copia)_5486510313033662468]) / TOTAL(SUM([total_orders_online (copia)_5486510313033662468]))'>
          <table-calc ordering-type='CellInPane' />
        </calculation>
      </column>
      <column datatype='string' name='[Platform]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[platform]' new-bin='true'>
          <bin default-name='false' value='&quot;Android&quot;'>
            <value>&quot;ANDROID&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;IOS&quot;'>
            <value>&quot;IPHONE&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Others&quot;'>
            <value>&quot;COURIER&quot;</value>
            <value>&quot;COURIER_API&quot;</value>
            <value>&quot;IPAD&quot;</value>
            <value>&quot;WIDGET&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Web Desktop&quot;'>
            <value>&quot;WEB&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Web Mobile&quot;'>
            <value>&quot;WEB_MOBILE&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='total_orders_online' datatype='integer' name='[SOOP (copy)_714946483132321793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_op] WHEN TRUE THEN [total_orders] END' />
      </column>
      <column caption='Voucher share (AP)' datatype='real' default-format='p0.0%' name='[Voucher share (OP) (copia)_5486510313034084357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_voucher_orders_online (copia)_5486510313033535491])/SUM([total_orders_online (copia)_5486510313033662468])' />
      </column>
      <column caption='Vouchers (AP)' datatype='real' default-format='p0.0%' name='[Vouchers (OP) (copia)_5486510313394769933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_voucher_orders_online (copia)_5486510313033535491])/SUM([voucher_orders])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Consulta_SQL_personalizada' datatype='table' name='[__tableau_internal_object_id__].[_56751E66841442298EDE6ED9263437BF]' role='measure' type='quantitative' />
      <column caption='total_voucher_orders_online' datatype='integer' name='[confirmed_orders_online (copy)_714946483132706818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_op] WHEN TRUE THEN [voucher_orders] END' />
      </column>
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
