    <worksheet name='SOOP_voucher (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Voucher orders share</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BQ - Orders' name='federated.04hrs2z15ygd3r10g8nbq1mldfdd' />
            <datasource caption='CBK - Acknowledge date' name='federated.09nv4vu0pmpxdk1a7kmf9136gpav' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04hrs2z15ygd3r10g8nbq1mldfdd'>
            <column caption='Voucher share (OP)' datatype='real' default-format='p0.0%' name='[Calculation_714946483154894856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_online (copy)_714946483132706818])/SUM([SOOP (copy)_714946483132321793])' />
            </column>
            <column caption='Fecha' datatype='datetime' default-format='*d/m/yy' name='[Calculation_714946483163217931]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN [fecha]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&quot;week&quot;,[fecha])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&quot;month&quot;,[fecha])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[fecha])&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[fecha])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[fecha],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[fecha])) ELSE DATETRUNC(&quot;year&quot;,[fecha]) END)&#13;&#10;END' />
            </column>
            <column caption='total_orders_online' datatype='integer' name='[SOOP (copy)_714946483132321793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_op] WHEN TRUE THEN [total_orders] END' />
            </column>
            <column caption='total_voucher_orders_online' datatype='integer' name='[confirmed_orders_online (copy)_714946483132706818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_op] WHEN TRUE THEN [voucher_orders] END' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[fecha]' role='dimension' type='ordinal' />
            <column caption='User payment type' datatype='boolean' name='[first_op]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No Info' />
                <alias key='false' value='Recurrent' />
                <alias key='true' value='First OP' />
              </aliases>
            </column>
            <column caption='PM - OP' datatype='boolean' name='[is_op]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Offline' />
                <alias key='true' value='OP' />
              </aliases>
            </column>
            <column-instance column='[Calculation_714946483163217931]' derivation='Max' name='[max:Calculation_714946483163217931:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[first_op]' derivation='None' name='[none:first_op:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_op]' derivation='None' name='[none:is_op:nk]' pivot='key' type='nominal' />
            <column-instance column='[SOOP (copy)_714946483132321793]' derivation='Sum' name='[sum:SOOP (copy)_714946483132321793:qk]' pivot='key' type='quantitative' />
            <column-instance column='[confirmed_orders_online (copy)_714946483132706818]' derivation='Sum' name='[sum:confirmed_orders_online (copy)_714946483132706818:qk]' pivot='key' type='quantitative' />
            <column-instance column='[voucher_orders]' derivation='Sum' name='[sum:voucher_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_714946483163217931]' derivation='Day-Trunc' name='[tdy:Calculation_714946483163217931:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_714946483163217931]' derivation='Day-Trunc' name='[tdy:Calculation_714946483163217931:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_714946483154894856]' derivation='User' name='[usr:Calculation_714946483154894856:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[voucher_orders]' role='measure' type='quantitative' />
            <column caption='Delivery Type' datatype='string' name='[with_logistics (grupo)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[with_logistics]' new-bin='true'>
                <bin default-name='false' value='&quot;Own Delivery&quot;'>
                  <value>&quot;t&quot;</value>
                  <value>&quot;true&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Vendor Delivery&quot;'>
                  <value>%null%</value>
                  <value>&quot;f&quot;</value>
                  <value>&quot;false&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' datatype-customized='true' name='[with_logistics]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09nv4vu0pmpxdk1a7kmf9136gpav'>
