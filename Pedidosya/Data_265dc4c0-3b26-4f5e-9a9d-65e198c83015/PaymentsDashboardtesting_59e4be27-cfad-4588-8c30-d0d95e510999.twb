            <column caption='Business SccR' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Global AcR (copia)_1615947895287836676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acc_business])/SUM([total_business])' />
