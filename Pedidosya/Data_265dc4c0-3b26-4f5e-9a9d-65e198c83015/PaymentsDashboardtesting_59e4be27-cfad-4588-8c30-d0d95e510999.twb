              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (2) (copy)_539024625938800654]&#13;&#10;WHEN &apos;Week&apos; THEN [order_date_week]&#13;&#10;WHEN &apos;Month&apos; THEN [order_date_month]&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[order_date_month])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[order_date_month],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[order_date_month])) ELSE DATETRUNC(&quot;year&quot;,[order_date_month]) END)&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[order_date_month])&#13;&#10;END' />
