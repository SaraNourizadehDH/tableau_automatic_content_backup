    <worksheet name='SOAP_platform'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>SOAP by Platform</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BQ - Orders' name='federated.04hrs2z15ygd3r10g8nbq1mldfdd' />
            <datasource caption='CBK - Acknowledge date' name='federated.09nv4vu0pmpxdk1a7kmf9136gpav' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04hrs2z15ygd3r10g8nbq1mldfdd'>
            <column caption='Fecha' datatype='datetime' default-format='*d/m/yy' name='[Calculation_714946483163217931]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN [fecha]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&quot;week&quot;,[fecha])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&quot;month&quot;,[fecha])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[fecha])&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[fecha])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[fecha],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[fecha])) ELSE DATETRUNC(&quot;year&quot;,[fecha]) END)&#13;&#10;END' />
            </column>
            <column caption='Global AP' datatype='real' default-format='p0.0%' name='[Global AP (copia)_5486510313032249344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [is_ap] WHEN TRUE THEN [total_orders] END)/SUM([total_orders])' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column datatype='string' name='[Platform]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[platform]' new-bin='true'>
                <bin default-name='false' value='&quot;Android&quot;'>
                  <value>&quot;ANDROID&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;IOS&quot;'>
                  <value>&quot;IPHONE&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Others&quot;'>
                  <value>&quot;COURIER&quot;</value>
                  <value>&quot;COURIER_API&quot;</value>
                  <value>&quot;IPAD&quot;</value>
                  <value>&quot;WIDGET&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Web Desktop&quot;'>
                  <value>&quot;WEB&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Web Mobile&quot;'>
                  <value>&quot;WEB_MOBILE&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[fecha]' role='dimension' type='ordinal' />
            <column caption='PM - AP' datatype='boolean' name='[is_ap]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Out App' />
                <alias key='true' value='In App' />
              </aliases>
            </column>
            <column-instance column='[Calculation_714946483163217931]' derivation='Max' name='[max:Calculation_714946483163217931:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Sum' name='[sum:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders_online (copia)_5486510313033662468]' derivation='Sum' name='[sum:total_orders_online (copia)_5486510313033662468:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_714946483163217931]' derivation='Day-Trunc' name='[tdy:Calculation_714946483163217931:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_714946483163217931]' derivation='Day-Trunc' name='[tdy:Calculation_714946483163217931:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column caption='total_orders_app' datatype='integer' name='[total_orders_online (copia)_5486510313033662468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_ap] WHEN TRUE THEN [total_orders] END' />
            </column>
            <column-instance column='[Global AP (copia)_5486510313032249344]' derivation='User' name='[usr:Global AP (copia)_5486510313032249344:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vertical]' role='dimension' type='nominal' />
          </datasource-dependencies>
