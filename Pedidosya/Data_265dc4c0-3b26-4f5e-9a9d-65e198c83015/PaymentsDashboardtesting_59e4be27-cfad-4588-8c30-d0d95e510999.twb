          <datasource-dependencies datasource='federated.09nv4vu0pmpxdk1a7kmf9136gpav'>
            <column caption='Date' datatype='datetime' datatype-customized='true' name='[Calculation_539024625938436109]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (2) (copy)_539024625938800654]&#13;&#10;WHEN &apos;Week&apos; THEN [order_date_week]&#13;&#10;WHEN &apos;Month&apos; THEN [order_date_month]&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[order_date_month])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[order_date_month],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[order_date_month])) ELSE DATETRUNC(&quot;year&quot;,[order_date_month]) END)&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[order_date_month])&#13;&#10;END' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_539024625938436109]' derivation='None' name='[none:Calculation_539024625938436109:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date_month]' role='dimension' type='ordinal' />
            <column datatype='date' name='[order_date_week]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xy23ip1f1xpim18uln471q17kkx'>
            <column caption='Payment user type (6 mo)' datatype='string' name='[Calculation_1721219531242356737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [cash_only_last_6mo] = false and [op_only_last_6mo] = false THEN &quot;Mixed&quot;&#13;&#10;&#13;&#10;ELSEIF [op_only_last_6mo] = true THEN &apos;OP only&apos;&#13;&#10;&#13;&#10;ELSEIF [cash_only_last_6mo] = true THEN &apos;Offline only&apos;&#13;&#10;&#13;&#10;ELSE &quot;No info&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_539024625246838786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders])/sum([active_users])' />
            </column>
            <column caption='Frequency (OP)' datatype='real' name='[Calculation_539024625247113220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_OP_orders])/sum([Calculation_539024625247256581])' />
