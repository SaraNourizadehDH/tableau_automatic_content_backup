      <aliases enabled='yes' />
      <column caption='Active AP users' datatype='integer' name='[Active OP users (copia)_5486510313749553176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [user_apm_type] = (&quot;user_mixed&quot;) or [user_apm_type] = (&quot;user_AP_only&quot;) then [active_users] end' />
      </column>
      <column caption='SOOP' datatype='real' default-format='p0.0%' name='[Calculation_1672805834955116548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_OP_orders])/SUM([total_orders])' />
      </column>
      <column caption='Payment user type (6 mo)' datatype='string' name='[Calculation_1721219531242356737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [cash_only_last_6mo] = false and [op_only_last_6mo] = false THEN &quot;Mixed&quot;&#13;&#10;&#13;&#10;ELSEIF [op_only_last_6mo] = true THEN &apos;OP only&apos;&#13;&#10;&#13;&#10;ELSEIF [cash_only_last_6mo] = true THEN &apos;Offline only&apos;&#13;&#10;&#13;&#10;ELSE &quot;No info&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_539024625246838786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders])/sum([active_users])' />
      </column>
      <column caption='Frequency (OP)' datatype='real' name='[Calculation_539024625247113220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_OP_orders])/sum([Calculation_539024625247256581])' />
      </column>
      <column caption='Active OP users' datatype='integer' name='[Calculation_539024625247256581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [user_pm_type] = (&quot;user_mixed&quot;) or [user_pm_type] = (&quot;user_OP_only&quot;) then [active_users] end' />
      </column>
      <column caption='Hide' datatype='string' name='[Calculation_539024625250861063]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF Last()=0 Then &quot;Hide&quot; Else &quot;Show&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_539024625869676556]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)_539024625865244682]&#13;&#10;WHEN &apos;Month&apos; THEN [month]&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[month])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[month],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[month])) ELSE DATETRUNC(&quot;year&quot;,[month]) END)&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[month])&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='categorical-bin' column='[country]' new-bin='true' />
      </column>
      <column caption='Frequency (AP) ' datatype='real' name='[Frequency (OP) (copia)_5486510313749942297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_AP_orders])/sum([Active OP users (copia)_5486510313749553176])' />
      </column>
      <column caption='SOAP' datatype='real' default-format='p0.0%' name='[SOOP (copia)_5486510313741918231]' role='measure' type='quantitative'>
