                                LEFT JOIN `peya-data-origins-pro.cl_core.country` ct ON ct.country_id = C.country_id &#13;
                                LEFT JOIN `peya-data-origins-pro.cl_core.country_details` co on co.country_id = C.country_id   &#13;
