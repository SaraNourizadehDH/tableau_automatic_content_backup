            <column caption='Global SccR' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Gateway (copy)_1401463952707174400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acc_global])/SUM([total_global])' />
            </column>
            <column caption='Gateway (Rej)' datatype='real' datatype-customized='true' name='[Gateway (copy)_295267291858038796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gateway])-SUM([acc_gateway])' />
