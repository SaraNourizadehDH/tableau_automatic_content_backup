          <datasource-dependencies datasource='sqlproxy.1eaa3q00b9uanm18tgsly1uduaca'>
            <column caption='AF extern (Rej)' datatype='real' datatype-customized='true' name='[AF intern (Rej) (copy)_295267291858747406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_af_ext])-SUM([acc_af_ext])' />
            </column>
            <column caption='Gateway' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Acceptance Rate (copy)_348466061730488321]' role='measure' type='quantitative'>
