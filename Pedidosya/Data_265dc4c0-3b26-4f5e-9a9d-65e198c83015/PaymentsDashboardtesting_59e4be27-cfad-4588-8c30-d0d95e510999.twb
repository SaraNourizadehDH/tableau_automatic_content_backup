      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_4E9D8077BFB34B2CA4BAECC4D22C08C5'>
            <properties context=''>
              <relation connection='bigquery.093tyix0deihwo1dac0fv11fqcng' name='Consulta_SQL_personalizada' type='text'>SELECT&#13;
                        P.order_date_month as order_date_month&#13;
                        , date(P.order_date_week) as order_date_week&#13;
                        , P.country                        &#13;
                        , sum(P.total_op) as sum_op&#13;
                        , sum(P.total_gmv_eur) as sum_gmv_eur                        &#13;
                        , sum(CBK.total_cbk) as sum_cbk&#13;
                        , sum(CBK.total_cbk_gmv_eur) as sum_gmv_cbk_eur&#13;
                        FROM (&#13;
                                SELECT&#13;
                                date_trunc(DATE(P.date_created), MONTH) as order_date_month&#13;
                                , date_trunc(DATE(P.date_created),ISOWEEK) as order_date_week&#13;
                                , co.country_name as country                              &#13;
                               , COUNT(DISTINCT CASE WHEN P.payment_state IN (&apos;ACCEPTED&apos;,&apos;REFUNDED&apos;,&apos;PARTIAL_REFUNDED&apos;,&apos;CHARGEBACK&apos;,&apos;CANCELLED&apos;) THEN P.payment_id ELSE NULL END) as total_op&#13;
                                , SUM(CASE WHEN P.payment_state IN (&apos;ACCEPTED&apos;,&apos;REFUNDED&apos;,&apos;PARTIAL_REFUNDED&apos;,&apos;CHARGEBACK&apos;,&apos;CANCELLED&apos;) THEN P.payment_amount ELSE 0 END)/AVG(CAST(X.rate_eu AS NUMERIC)) as total_gmv_eur&#13;
                                FROM `peya-bi-tools-pro.il_payments.fact_payments_transaction` P&#13;
                                    LEFT JOIN `peya-data-origins-pro.cl_core.country` ct ON ct.country_id = P.country_id &#13;
                                    LEFT JOIN `peya-data-origins-pro.cl_core.country_details` co on co.country_id = P.country_id&#13;
                                    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` X&#13;
                                    ON CAST(X.currency_id AS INT64) = ct.currency_id &#13;
                                    and X.date_id =cast(cast(FORMAT_DATE(&quot;%Y%m%d&quot;, DATE_TRUNC(DATE(P.date_created),MONTH)) as INT64) as INT64)                  &#13;
                                WHERE DATE(P.date_created) &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -12 MONTH)&#13;
                                AND co.active = TRUE &#13;
                                GROUP BY 1,2,3&#13;
                                ) as P&#13;
                        LEFT JOIN (&#13;
                                SELECT&#13;
                                date_trunc(DATE(C.order_date),MONTH) as order_date_month&#13;
                                , date_trunc(DATE(C.order_date),ISOWEEK) as order_date_week&#13;
                                , co.country_name as country&#13;
                                , SUM(C.payment_amount) as total_gmv&#13;
                                , SUM(C.payment_amount)/AVG(CAST(X.rate_eu AS NUMERIC)) as total_cbk_gmv_eur&#13;
                                , COUNT (DISTINCT C.hash) as total_cbk&#13;
                                FROM `peya-bi-tools-pro.il_payments.fact_chargeback_details` C&#13;
                                LEFT JOIN `peya-data-origins-pro.cl_core.country` ct ON ct.country_id = C.country_id &#13;
                                LEFT JOIN `peya-data-origins-pro.cl_core.country_details` co on co.country_id = C.country_id   &#13;
                                LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` X&#13;
                                    ON CAST(X.currency_id AS INT64) = ct.currency_id &#13;
                                    AND X.date_id = cast(FORMAT_DATE(&quot;%Y%m%d&quot;, DATE_TRUNC(DATE(order_date),MONTH)) as INT64)&#13;
                                WHERE DATE(C.order_date) &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -12 MONTH)&#13;
                                GROUP BY 1,2,3&#13;
                                ) as CBK    &#13;
                        ON P.order_date_month = CBK.order_date_month&#13;
                        AND P.order_date_week = CBK.order_date_week&#13;
                        AND P.country = CBK.country&#13;
                        GROUP BY 1,2,3&#13;
                        ORDER BY 1,2,3 asc</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
