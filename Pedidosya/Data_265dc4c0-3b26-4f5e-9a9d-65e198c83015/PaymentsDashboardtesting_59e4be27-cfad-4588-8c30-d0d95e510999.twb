      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity (2)' datatype='string' name='[Date Granularity (copy)_539024625865244682]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
