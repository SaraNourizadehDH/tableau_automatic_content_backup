    <worksheet name='Partners - AP (8)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>SPOP vs SOAP by Top cities</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>The table list the top 10 cities in terms of OP orders by country.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BQ - Partners' name='federated.1rawo7d1b6ln2s10ss9yl1vm7yju' />
            <datasource caption='CBK - Acknowledge date' name='federated.09nv4vu0pmpxdk1a7kmf9136gpav' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity (3)' datatype='string' name='[Date Granularity (2) (copy)_539024625938800654]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09nv4vu0pmpxdk1a7kmf9136gpav'>
            <column caption='Date' datatype='datetime' datatype-customized='true' name='[Calculation_539024625938436109]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (2) (copy)_539024625938800654]&#13;&#10;WHEN &apos;Week&apos; THEN [order_date_week]&#13;&#10;WHEN &apos;Month&apos; THEN [order_date_month]&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[order_date_month])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[order_date_month],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[order_date_month])) ELSE DATETRUNC(&quot;year&quot;,[order_date_month]) END)&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[order_date_month])&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_539024625938436109]' derivation='None' name='[none:Calculation_539024625938436109:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_date_month]' role='dimension' type='ordinal' />
            <column datatype='date' name='[order_date_week]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rawo7d1b6ln2s10ss9yl1vm7yju'>
            <column caption='OP total rank' datatype='integer' name='[Calculation5]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([confirmed_OP_orders]))'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1rawo7d1b6ln2s10ss9yl1vm7yju].[country]' />
                  <order field='[federated.1rawo7d1b6ln2s10ss9yl1vm7yju].[Calculation_1217660792587812869]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='SPOP' datatype='real' default-format='p0.0%' name='[Calculation_1217660792342351872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([OP_partners_online])/sum([total_partners_online])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_1217660792587812869]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [country]=&apos;Bolivia&apos; and [city]=&apos;Montevideo&apos; THEN &apos;Unknown&apos; ELSE [city] END' />
            </column>
            <column caption='AP country rank' datatype='integer' name='[OP country rank (copia)_5486510313668186134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([confirmed_AP_orders]))'>
                <table-calc ordering-type='ColumnInPane' />
              </calculation>
            </column>
            <column caption='Partners with OP' datatype='integer' name='[OP_partners_online]' role='measure' type='quantitative' />
            <column caption='SOAP' datatype='real' default-format='p0.0%' name='[SOOP (copia)_5486510313654554639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_AP_orders])/sum([confirmed_orders])' />
            </column>
            <column caption='SOOP' datatype='real' default-format='p0.0%' name='[SPOP (copy)_1217660792345460737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_OP_orders])/sum([confirmed_orders])' />
            </column>
            <column caption='City Legacy' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
