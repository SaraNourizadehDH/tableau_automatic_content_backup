          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Rate type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Business&quot;'>
              <calculation class='tableau' formula='&quot;Business&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1eaa3q00b9uanm18tgsly1uduaca'>
            <column caption='AF extern (Rej)' datatype='real' datatype-customized='true' name='[AF intern (Rej) (copy)_295267291858747406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_af_ext])-SUM([acc_af_ext])' />
            </column>
            <column caption='Gateway' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Acceptance Rate (copy)_348466061730488321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acc_gateway])/SUM([total_gateway])' />
            </column>
            <column caption='AF intern' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Acceptance Rate (gateway) (copy)_348466061731745794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acc_af_int])/SUM([total_af_int])' />
            </column>
            <column caption='AF extern' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Acceptance Rate (gateway) (copy)_348466061755101190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acc_af_ext])/SUM([total_af_ext])' />
            </column>
            <column caption='AcR' datatype='real' default-format='p0.0%' name='[Calculation_295267291842183168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;&#13;&#10;[Parameters].[Parameter 2]=&quot;Gateway&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[Acceptance Rate (copy)_348466061730488321]&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;[Parameters].[Parameter 2]=&quot;AF intern&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[Acceptance Rate (gateway) (copy)_348466061731745794]&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;[Parameters].[Parameter 2]=&quot;AF extern&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[Acceptance Rate (gateway) (copy)_348466061755101190]&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;[Parameters].[Parameter 2]=&quot;Global&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[Gateway (copy)_1401463952707174400]&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;[Parameters].[Parameter 2]=&quot;Business&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[Global AcR (copia)_1615947895287836676]&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;[Parameters].[Parameter 2]=&quot;Internal Block&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[Tech (copia)_1615947895263510529]&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;&#13;&#10;[Parameters].[Parameter 2]=&quot;Tech&quot;&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;[Gateway (copia)_1615947895263215616]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='datetime' name='[Calculation_754352972887744513]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN [fecha]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&quot;week&quot;,[fecha])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&quot;month&quot;,[fecha])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&quot;quarter&quot;,[fecha])&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,[fecha],&apos;Monday&apos;) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[fecha])) ELSE DATETRUNC(&quot;year&quot;,[fecha]) END)&#13;&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&quot;year&quot;,[fecha])&#13;&#10;END' />
            </column>
            <column caption='Is New Card' datatype='string' name='[Card_Flag (grupo)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Card_Flag]' new-bin='true'>
                <bin default-name='false' value='&quot;No Info&quot;'>
                  <value>&quot;N/A&quot;</value>
                  <value>&quot;NA&quot;</value>
                </bin>
              </calculation>
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Card_Flag]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='Issuer_clean' datatype='string' name='[Date (copy)_539024625203798016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([issuer], &apos;No info&apos;)' />
            </column>
            <column caption='Issuer' datatype='string' name='[Date (copy)_539024625219981313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Date (copy)_539024625203798016]&#13;&#10;WHEN &apos;No info&apos; THEN &apos;No info&apos;&#13;&#10;WHEN &apos;&apos; THEN &apos;No info&apos;&#13;&#10;ELSE [Date (copy)_539024625203798016]&#13;&#10;END' />
            </column>
            <column caption='Business (Rej)' datatype='real' datatype-customized='true' name='[Gateway (Rej) (copia)_1615947895289511941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_business])-SUM([acc_business])' />
            </column>
            <column caption='AF intern (Rej)' datatype='real' datatype-customized='true' name='[Gateway (Rej) (copy)_295267291858530317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_af_int])-sum([acc_af_int])' />
            </column>
            <column caption='Tech' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Gateway (copia)_1615947895263215616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acc_tech])/SUM([total_tech])' />
