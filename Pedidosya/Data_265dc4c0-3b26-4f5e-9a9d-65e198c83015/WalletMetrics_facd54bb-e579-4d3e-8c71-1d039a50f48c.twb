      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_60B685AB4ECA494082A9F1CB5C8F1652'>
            <properties context=''>
              <relation connection='bigquery.02984hy0t0gfir16gj1ak0e2t2xn' name='Consulta_SQL_personalizada' type='text'>select 	  dc.country_name as Country&#13;
        , fo.city.city_name as City&#13;
        , oft.name as order_funding_type_name &#13;
        , fo.application as Plattform&#13;
        , DATE(fo.registered_date) as Order_Creation_Date&#13;
&#13;
        , count(distinct fo.order_id) AS Confirmed_Orders&#13;
        , count(distinct case when fof.type in (25,35) then fo.order_id end ) as Confirmed_Orders_Wallet&#13;
        , count(distinct case when fof.type in (25,35) and fo.is_acquisition = 1 then fo.order_id end) as Confirmed_Acquisitions_Wallet&#13;
        , sum(case when fof.type in (25,35) then fof.amount end) as Confirmed_Amount_Wallet&#13;
        , sum(case when fof.type in (25,35) then fof.amount end / dce.rate_us) as Confirmed_Amount_Wallet_USD       &#13;
        , max(fo.audi_load_date) audi_load_date &#13;
		&#13;
from `peya-bi-tools-pro.il_core.fact_orders` fo&#13;
&#13;
inner join  `peya-bi-tools-pro.il_core.fact_order_funding` fof &#13;
	on (fo.order_id=fof.order_id) &#13;
		&#13;
inner join `peya-bi-tools-pro.il_core.dim_country` dc&#13;
	on (fo.country_id = dc.country_id&#13;
		and dc.active )&#13;
&#13;
inner join `peya-bi-tools-pro.il_core.dim_currency_exchange` dce&#13;
      on  (dc.currency_id  = dce.currency_id  &#13;
           and DATE_TRUNC(DATE(fo.registered_date), MONTH) = DATE(dce.currency_exchange_date) )  &#13;
&#13;
inner join `peya-data-origins-pro.cl_core.order_funding_type` oft&#13;
  on (fof.type = oft.id) &#13;
  &#13;
where fo.order_status = &apos;CONFIRMED&apos; &#13;
      and DATE(fo.registered_date ) &gt;&gt;=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)  &#13;
      &#13;
group by 1,2,3,4,5</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
