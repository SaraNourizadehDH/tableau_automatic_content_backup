      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_CB8187995ADB4B6DB1D52D2B7B097CDE'>
            <properties context=''>
              <relation connection='bigquery.0lv1c331bk0si61exs8zy0vwkgay' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH campaign_usage AS (

    SELECT 
        d.topupId
        , d.amount
    FROM `peya-bi-tools-pro.il_wallet.fact_wallet_attributions` a
        LEFT JOIN UNNEST(a.attributionDetails) d
    WHERE DATE(a.order_registered_date) >>=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
        AND a.order_status = "CONFIRMED"
        AND a.operation = 'Purchase'
        AND a.operation <<>> 'Refund'

)

SELECT 
    dc.country_name
    , d.source
    , d.campaignCode
    , c.total_topups_amount
    , c.total_topups_amount_USD
    , c.campaign_used_amount
    , c.campaign_used_amount_USD
    , DATE(a.order_registered_date) AS order_date
    , a.order_id
    , o.total_amount + o.shipping_amount AS gmv
    , o.is_acquisition
    , ((o.total_amount + o.shipping_amount) / dce.rate_us) AS gmv_USD
    , a.user_id
    , a.amount AS total_topups_order_amount 
    , a.amount / dce.rate_us AS total_topups_order_amount_USD
    , d.amount AS topup_amount
    , d.amount / dce.rate_us AS topup_amount_USD
FROM `peya-bi-tools-pro.il_wallet.fact_wallet_attributions` a
    LEFT JOIN UNNEST(a.attributionDetails) d
    LEFT JOIN `peya-bi-tools-pro.il_wallet.fact_wallet_topups` t
        ON t.topupId = d.topupId
    LEFT JOIN (
                SELECT
                    t.campaignCode
                    , SUM(t.amount) AS total_topups_amount
                    , SUM(t.amount / dce.rate_us) AS total_topups_amount_USD
                    , SUM(u.amount) AS campaign_used_amount 
                    , SUM(u.amount / dce.rate_us) AS campaign_used_amount_USD
                FROM `peya-bi-tools-pro.il_wallet.fact_wallet_topups` t
                    LEFT JOIN campaign_usage u 
                        ON u.topupId = t.topupId
                    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc
                        ON t.country = dc.country_code
                        AND dc.active
                    INNER JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce
                        ON dc.currency_id  = dce.currency_id  
                        AND DATE_TRUNC(DATE(t.topupDate), MONTH) = DATE(dce.currency_exchange_date)  
                GROUP BY 1
                ) c
        ON c.campaignCode = d.campaignCode
    LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` o
        ON o.order_id = a.order_id
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc
	    ON a.country = dc.country_code
		AND dc.active
    INNER JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce
        ON dc.currency_id  = dce.currency_id  
        AND DATE_TRUNC(DATE(a.order_registered_date), MONTH) = DATE(dce.currency_exchange_date)  
WHERE DATE(a.order_registered_date) >>=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    AND DATE(o.registered_date) >>=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    AND a.order_status = "CONFIRMED"
    AND a.operation = 'Purchase'
	AND a.operation <<>> 'Refund']]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource inline='true' name='Query Dashboard Wallet BQ (copia local)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.02984hy0t0gfir16gj1ak0e2t2xn'>
            <connection CATALOG='peya-growth-and-onboarding' EXECCATALOG='peya-growth-and-onboarding' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-growth-and-onboarding' schema='user_guido_oliveri' server='' server-oauth='' username='bruno.marchese@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02984hy0t0gfir16gj1ak0e2t2xn' name='Consulta_SQL_personalizada' type='text'>select 	  dc.country_name as Country&#13;
        , fo.city.city_name as City&#13;
        , oft.name as order_funding_type_name &#13;
        , fo.application as Plattform&#13;
        , DATE(fo.registered_date) as Order_Creation_Date&#13;
&#13;
        , count(distinct fo.order_id) AS Confirmed_Orders&#13;
        , count(distinct case when fof.type in (25,35) then fo.order_id end ) as Confirmed_Orders_Wallet&#13;
        , count(distinct case when fof.type in (25,35) and fo.is_acquisition = 1 then fo.order_id end) as Confirmed_Acquisitions_Wallet&#13;
        , sum(case when fof.type in (25,35) then fof.amount end) as Confirmed_Amount_Wallet&#13;
        , sum(case when fof.type in (25,35) then fof.amount end / dce.rate_us) as Confirmed_Amount_Wallet_USD       &#13;
        , max(fo.audi_load_date) audi_load_date &#13;
		&#13;
from `peya-bi-tools-pro.il_core.fact_orders` fo&#13;
&#13;
inner join  `peya-bi-tools-pro.il_core.fact_order_funding` fof &#13;
	on (fo.order_id=fof.order_id) &#13;
		&#13;
inner join `peya-bi-tools-pro.il_core.dim_country` dc&#13;
	on (fo.country_id = dc.country_id&#13;
		and dc.active )&#13;
&#13;
inner join `peya-bi-tools-pro.il_core.dim_currency_exchange` dce&#13;
      on  (dc.currency_id  = dce.currency_id  &#13;
           and DATE_TRUNC(DATE(fo.registered_date), MONTH) = DATE(dce.currency_exchange_date) )  &#13;
&#13;
inner join `peya-data-origins-pro.cl_core.order_funding_type` oft&#13;
  on (fof.type = oft.id) &#13;
  &#13;
where fo.order_status = &apos;CONFIRMED&apos; &#13;
      and DATE(fo.registered_date ) &gt;&gt;=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)  &#13;
      &#13;
group by 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.02984hy0t0gfir16gj1ak0e2t2xn' name='Consulta_SQL_personalizada' type='text'>select 	  dc.country_name as Country&#13;
        , fo.city.city_name as City&#13;
        , oft.name as order_funding_type_name &#13;
        , fo.application as Plattform&#13;
        , DATE(fo.registered_date) as Order_Creation_Date&#13;
&#13;
        , count(distinct fo.order_id) AS Confirmed_Orders&#13;
        , count(distinct case when fof.type in (25,35) then fo.order_id end ) as Confirmed_Orders_Wallet&#13;
        , count(distinct case when fof.type in (25,35) and fo.is_acquisition = 1 then fo.order_id end) as Confirmed_Acquisitions_Wallet&#13;
        , sum(case when fof.type in (25,35) then fof.amount end) as Confirmed_Amount_Wallet&#13;
        , sum(case when fof.type in (25,35) then fof.amount end / dce.rate_us) as Confirmed_Amount_Wallet_USD       &#13;
        , max(fo.audi_load_date) audi_load_date &#13;
		&#13;
from `peya-bi-tools-pro.il_core.fact_orders` fo&#13;
&#13;
inner join  `peya-bi-tools-pro.il_core.fact_order_funding` fof &#13;
	on (fo.order_id=fof.order_id) &#13;
		&#13;
inner join `peya-bi-tools-pro.il_core.dim_country` dc&#13;
	on (fo.country_id = dc.country_id&#13;
		and dc.active )&#13;
&#13;
inner join `peya-bi-tools-pro.il_core.dim_currency_exchange` dce&#13;
      on  (dc.currency_id  = dce.currency_id  &#13;
           and DATE_TRUNC(DATE(fo.registered_date), MONTH) = DATE(dce.currency_exchange_date) )  &#13;
&#13;
inner join `peya-data-origins-pro.cl_core.order_funding_type` oft&#13;
  on (fof.type = oft.id) &#13;
  &#13;
where fo.order_status = &apos;CONFIRMED&apos; &#13;
      and DATE(fo.registered_date ) &gt;&gt;=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)  &#13;
      &#13;
group by 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
