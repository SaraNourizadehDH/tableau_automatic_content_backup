              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Daily&quot; then DATETRUNC(&quot;day&quot;, [order_date])&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Weekly&quot; then DATETRUNC(&quot;week&quot;, [order_date], &quot;monday&quot;) &#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Monthly&quot; then DATETRUNC(&quot;month&quot;, [order_date], &quot;monday&quot;)&#13;&#10;ELSE [order_date] END' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[Calculation_1193453909275611136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
