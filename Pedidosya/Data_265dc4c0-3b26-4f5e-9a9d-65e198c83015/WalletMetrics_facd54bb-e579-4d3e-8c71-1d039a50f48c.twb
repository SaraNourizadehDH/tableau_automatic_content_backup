    <worksheet name='GMV y Topups usage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>GMV &amp; Topups Usage</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name='Query Campaign BQ  (copia local)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Query Campaign BQ  (copia local)'>
            <column caption='Confirmed GMV' datatype='real' default-format='c&quot;US$&quot;#,##0.00;-&quot;US$&quot;#,##0.00' name='[Active Users (copia)_1193453909276938242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [order_id] : MAX([gmv_USD])})' />
