      <column caption='Users Plus App ' datatype='integer' name='[Users App (copia)_576179318470189062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;         and [is_user_plus]=1  &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
