  <worksheets>
    <worksheet name='Detalle Por Partner'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tahoma' fontsize='10'>Indicadores por Partner</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_kpis_comercial ' name='federated.08dro761jxzi0t113zdnr02uysmo' />
          </datasources>
          <datasource-dependencies datasource='federated.08dro761jxzi0t113zdnr02uysmo'>
            <column caption='% VFD sin ajuste' datatype='real' default-format='p0.00%' name='[Calculation_1146729083490934786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sponsorship_amount])-SUM([subsidio_liquido]))/SUM([gfv_vendor])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_136233913571450881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='% VFR' datatype='real' name='[Calculation_931963674450956288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rejected_partner])/SUM([total_orders])' />
            </column>
            <column caption='% OT' datatype='real' name='[Calculation_931963674472759298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([closed_times])/SUM( [schedule_times]))' />
            </column>
            <column caption='Negocio1' datatype='string' name='[Negocio]' role='dimension' type='nominal' />
            <column caption='Account Owner' datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column caption='Area Name' datatype='string' name='[area_name]' role='dimension' type='nominal' />
            <column caption='Business Name' datatype='string' name='[business_name]' role='dimension' type='nominal' />
            <column caption='Closed Times' datatype='integer' name='[closed_times]' role='measure' type='quantitative' />
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
