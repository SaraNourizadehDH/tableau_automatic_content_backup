      <column caption='Subsidio Total' datatype='real' name='[Calculation_1146729083430809600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[monto_subsidiado]*[qty_sold_discount]' />
      </column>
      <column caption='VFD' datatype='real' name='[Calculation_1146729083431100417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sponsorship_amount])-SUM([Calculation_1146729083430809600])' />
      </column>
      <column caption='% VFD sin ajuste' datatype='real' default-format='p0.00%' name='[Calculation_1146729083490934786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sponsorship_amount])-SUM([subsidio_liquido]))/SUM([gfv_vendor])' />
      </column>
      <column caption='Mes Penetration' datatype='datetime' name='[Calculation_117656572505100289]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [registered_date])' />
      </column>
      <column caption='% Orders' datatype='real' name='[Calculation_1265230050026135552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders]) / SUM({FIXED [date] : SUM([Calculation_1590615124179173377])})' />
      </column>
      <column caption='Real Sponsorship Amount' datatype='real' name='[Calculation_1349109599868067840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(   [sponsorship_amount])' />
