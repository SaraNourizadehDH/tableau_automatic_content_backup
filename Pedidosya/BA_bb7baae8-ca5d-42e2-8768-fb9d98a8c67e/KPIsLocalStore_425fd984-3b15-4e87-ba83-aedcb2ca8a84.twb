      <column caption='schedule Hours' datatype='integer' name='[Open Hours (copia)_710724360811196421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DIV((SUM([schedule_times])),60)' />
      </column>
      <column caption='Orders Plus App ' datatype='integer' name='[Orders App (copia)_576179318470291463]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           and [is_user_plus]=1&#13;&#10;        THEN [order_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Pentration Plus Orders' datatype='real' default-format='p0.00%' name='[Pentration Orders (copia)_576179318470389768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;CONFIRMED&quot; and [is_user_plus]=1 THEN [order_id] END)/&#13;&#10;SUM([Orders App (copia)_576179318470291463])' />
      </column>
      <column caption='Pentration Orders' datatype='real' default-format='p0.00%' name='[Pentration business (copia)_576179318469795845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;CONFIRMED&quot; THEN [order_id] END)/&#13;&#10;SUM([Users App (copia)_576179318469656580])' />
      </column>
      <column caption='User Plus Pentration ' datatype='real' default-format='p0.00%' name='[Pentration business (copia)_576179318470782985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;CONFIRMED&quot; and [is_user_plus]=1 THEN [id] END)/&#13;&#10;SUM([Users App (copia)_576179318470189062])' />
