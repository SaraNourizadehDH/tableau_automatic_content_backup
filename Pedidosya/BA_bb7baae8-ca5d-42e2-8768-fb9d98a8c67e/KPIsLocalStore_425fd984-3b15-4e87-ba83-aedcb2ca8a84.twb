              <calculation class='tableau' formula='[Calculation_1590615124229025795]&#13;&#10;/sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Market&quot;, &quot;Drinks&quot;, &quot;Shop&quot;, &quot;Pets&quot;, &quot;Pharmacy&quot;) &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
