    <worksheet name='Gráfico Penetración'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tahoma' fontsize='11'>Penetración Active Users</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_kpis_comercial ' name='federated.08dro761jxzi0t113zdnr02uysmo' />
          </datasources>
          <datasource-dependencies datasource='federated.08dro761jxzi0t113zdnr02uysmo'>
            <column caption='Mes Penetration' datatype='datetime' name='[Calculation_117656572505100289]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [registered_date])' />
            </column>
            <column caption='Active Users Total' datatype='integer' name='[Calculation_1590615124229025795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;CONFIRMED&quot; THEN [id] END)' />
            </column>
            <column caption='% Active Users' datatype='real' name='[Calculation_1590615124248698886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1590615124229025795]&#13;&#10;/sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Market&quot;, &quot;Drinks&quot;, &quot;Shop&quot;, &quot;Pets&quot;, &quot;Pharmacy&quot;) &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
            </column>
            <column caption='Business Name (Qc Penetration)' datatype='string' name='[business_name (qc_penetration)]' role='dimension' type='nominal' />
            <column caption='User Id' datatype='integer' name='[id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_117656572505100289]' derivation='Month' name='[mn:Calculation_117656572505100289:ok]' pivot='key' type='ordinal' />
            <column-instance column='[business_name (qc_penetration)]' derivation='None' name='[none:business_name (qc_penetration):nk]' pivot='key' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1590615124248698886]' derivation='User' name='[usr:Calculation_1590615124248698886:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_117656572505100289]' derivation='Year' name='[yr:Calculation_117656572505100289:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.08dro761jxzi0t113zdnr02uysmo].[none:business_name (qc_penetration):nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:business_name (qc_penetration):nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:business_name (qc_penetration):nk]' member='%null%' />
                <groupfilter function='member' level='[none:business_name (qc_penetration):nk]' member='&quot;Courier&quot;' />
                <groupfilter function='member' level='[none:business_name (qc_penetration):nk]' member='&quot;Courier Business&quot;' />
                <groupfilter function='member' level='[none:business_name (qc_penetration):nk]' member='&quot;Restaurant&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.08dro761jxzi0t113zdnr02uysmo].[none:business_name (qc_penetration):nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
