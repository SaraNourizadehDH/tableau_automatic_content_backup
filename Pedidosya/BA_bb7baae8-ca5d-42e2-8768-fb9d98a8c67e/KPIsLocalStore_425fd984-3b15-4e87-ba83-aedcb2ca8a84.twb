      <column caption='% Active Users' datatype='real' name='[Calculation_1590615124248698886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1590615124229025795]&#13;&#10;/sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Market&quot;, &quot;Drinks&quot;, &quot;Shop&quot;, &quot;Pets&quot;, &quot;Pharmacy&quot;) &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
      </column>
      <column caption='YoY Ordenes' datatype='real' name='[Calculation_1631710476497256448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([confirmed_orders])) - LOOKUP(ZN(SUM([confirmed_orders])), -12)) / ABS(LOOKUP(ZN(SUM([confirmed_orders])), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Other business' datatype='integer' name='[Calculation_2061241320360427520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND( [business_name (qc_penetration)] IN ( &quot;Shop&quot;, &quot;Pets&quot;,&quot;Market&quot;) &#13;&#10;          and (IF [business_name]=&quot;Market&quot; then [category_name] else [business_name] end) IN (&quot;Chocolaterías&quot;,&quot;Supermercados&quot;,&quot;Frutas y Verduras&quot;,&quot;Carnes y Pescados&quot;,&quot;Minimarkets&quot;,&quot;Shop&quot;,&quot;Pets&quot;))&#13;&#10;            and [account_owner] &lt;&gt; (&quot;Javier Sáez&quot;)&#13;&#10;and [account_owner] &lt;&gt; (&quot;Jorge Díaz&quot;)&#13;&#10;       and [franchise_name]&lt;&gt;(&quot;Market PedidosYa&quot;) &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
      </column>
      <column caption='Orders Other Business' datatype='integer' name='[Calculation_2061241320360542209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND( [business_name (qc_penetration)] IN ( &quot;Shop&quot;, &quot;Pets&quot;,&quot;Market&quot;) &#13;&#10;          and (IF [business_name]=&quot;Market&quot; then [category_name] else [business_name] end) IN (&quot;Chocolaterías&quot;,&quot;Supermercados&quot;,&quot;Frutas y Verduras&quot;,&quot;Carnes y Pescados&quot;,&quot;Minimarkets&quot;,&quot;Shop&quot;,&quot;Pets&quot;))&#13;&#10;            and [account_owner] &lt;&gt; (&quot;Javier Sáez&quot;)&#13;&#10;and [account_owner] &lt;&gt; (&quot;Jorge Díaz&quot;)&#13;&#10;       and [franchise_name]&lt;&gt;(&quot;Market PedidosYa&quot;) &#13;&#10;        THEN [order_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_233905731444903937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_gfv])/SUM([confirmed_orders])' />
      </column>
      <column caption='OPR' datatype='real' name='[Calculation_233905731445235714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders])/COUNTD([partner_id])' />
      </column>
      <column caption='month' datatype='datetime' name='[Calculation_233905731552194567]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[date])' />
      </column>
      <column caption='MoM' datatype='real' name='[Calculation_233905731552706568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([confirmed_orders]) - LOOKUP(SUM([confirmed_orders]), -1)) / LOOKUP(SUM([confirmed_orders]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Zona ' datatype='string' name='[Calculation_2735092390519599104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [City_name] &#13;&#10;WHEN &quot;Santiago&quot; THEN [area_name]&#13;&#10;ELSE [City_name] END' />
      </column>
      <column caption='Zona Chile' datatype='string' name='[Calculation_2735092390545907713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case   [City_name]&#13;&#10;when in (&apos;Quillota&apos;,&apos;Villa Alemana&apos;,&apos;Valparaíso&apos;,&apos;Viña del Mar&apos;,&apos;Quilpué&apos;,&apos;Los Andes&apos;) then &apos;5ta&apos;&#13;&#10;when  in (&apos;Antofagasta&apos;,&apos;La Serena&apos;,&apos;Calama&apos;,&apos;Arica&apos;,&apos;Copiapó&apos;,&apos;Iquique&apos;,&apos;Coquimbo&apos;,&apos;Ovalle&apos;) then &apos;Norte&apos;&#13;&#10;when  in (&apos;Santiago&apos;,&apos;Colina&apos;,&apos;Melipilla&apos;,&apos;Peñaflor&apos;,&apos;Talagante&apos;) then &apos;RM&apos;&#13;&#10;when  in (&apos;Valdivia&apos;,&apos;Temuco&apos;,&apos;Rancagua&apos;,&apos;Puerto Montt&apos;,&apos;Curicó&apos;,&apos;Los Ángeles&apos;,&apos;Gran Concepción&apos;,&apos;Osorno&apos;,&apos;Puerto Varas&apos;,&apos;Talca&apos;,&apos;Punta Arenas&apos;,&apos;Chillán&apos;) then &apos;Sur&apos; else &quot;Otros&quot; end' />
      </column>
      <column caption='Users App' datatype='integer' name='[Calculation_576179318468288513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Pentration business' datatype='real' default-format='p0.00%' name='[Calculation_576179318469124099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;CONFIRMED&quot; THEN [id] END)/&#13;&#10;SUM([Calculation_576179318468288513])' />
      </column>
      <column caption='Cálculo1' datatype='real' default-format='p0.00%' name='[Calculation_710724360515788802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_active]=true then [partner_id] else null end)/COUNTD(if [status]=&quot;ON_LINE&quot; THEN [partner_id] ELSE NULL END)' />
      </column>
      <column caption='Tiene Dmart?' datatype='string' name='[Calculation_710724360777826308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [area_name]&#13;&#10;when  in  (&apos;Arica&apos;,&apos;Copiapó&apos;,&apos;Linares&apos;,&apos;Los Andes&apos;,&apos;Ovalle&apos;,&apos;Placilla&apos;,&apos;Puerto Varas&apos;,&#13;&#10;&apos;Punta Arenas&apos;,&apos;San Antonio&apos;,&apos;San Felipe&apos;,&apos;Melipilla&apos;,&apos;Padre Hurtado&apos;) then  &quot;Wo Dmart&quot; else  &quot;With Dmart&quot; end' />
      </column>
      <column caption='zombie %' datatype='real' default-format='p0.00%' name='[Calculation_710724360850227206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(COUNTD(IF  [is_active]=TRUE then [partner_id] else null end )/&#13;&#10;COUNTD(IF  [status]=&quot;ON_LINE&quot; then [partner_id] else null end ))' />
      </column>
      <column caption='% VFR' datatype='real' name='[Calculation_931963674450956288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rejected_partner])/SUM([total_orders])' />
      </column>
      <column caption='Open Hours' datatype='integer' name='[Calculation_931963674472181761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DIV((SUM([schedule_times])-SUM([closed_times])),60)' />
      </column>
      <column caption='% OT' datatype='real' name='[Calculation_931963674472759298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SUM([closed_times])/SUM( [schedule_times]))' />
      </column>
      <column caption='Active Partners' datatype='integer' name='[Calculation_931963674478444548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF  [is_active] = true THEN [partner_id] ELSE NULL END)' />
      </column>
      <column caption='Horas x Partner' datatype='real' name='[Calculation_931963674481070085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_931963674472181761]/[Calculation_931963674478444548])/COUNTD([date])' />
      </column>
      <column caption='City name' datatype='string' name='[City_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Negocio (qc penetration)' datatype='string' name='[Negocio (qc_penetration)]' role='dimension' type='nominal' />
