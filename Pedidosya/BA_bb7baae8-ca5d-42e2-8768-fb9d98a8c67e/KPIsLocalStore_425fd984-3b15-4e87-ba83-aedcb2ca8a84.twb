      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/KPIsLocalStore/PenetracinCategories?rev=' id='PenetracinCategories' path='/t/Pedidosya/workbooks/KPIsLocalStore' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='qc_kpis_comercial ' name='federated.08dro761jxzi0t113zdnr02uysmo' />
          </datasources>
          <datasource-dependencies datasource='federated.08dro761jxzi0t113zdnr02uysmo'>
            <column caption='% Active Users Zonas Drinks' datatype='real' default-format='p0.00%' name='[% Active Users (copia)_764767560171892736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Drinks&quot;) &#13;&#10;         and (if [City_name]=&quot;Santiago&quot; then [area_name] else [City_name] end ) in (&apos;Gran Concepción&apos;,&#13;&#10;&apos;Maipú&apos;,&#13;&#10;&apos;Talca&apos;,&#13;&#10;&apos;Chillán&apos;,&#13;&#10;&apos;La Florida&apos;,&#13;&#10;&apos;Los Ángeles&apos;,&#13;&#10;&apos;Curicó&apos;,&#13;&#10;&apos;La Reina&apos;)&#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})&#13;&#10;/sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Market&quot;, &quot;Drinks&quot;, &quot;Shop&quot;, &quot;Pets&quot;, &quot;Pharmacy&quot;) &#13;&#10;         and (if [City_name]=&quot;Santiago&quot; then [area_name] else [City_name] end ) in (&apos;Gran Concepción&apos;,&#13;&#10;&apos;Maipú&apos;,&#13;&#10;&apos;Talca&apos;,&#13;&#10;&apos;Chillán&apos;,&#13;&#10;&apos;La Florida&apos;,&#13;&#10;&apos;Los Ángeles&apos;,&#13;&#10;&apos;Curicó&apos;,&#13;&#10;&apos;La Reina&apos;)&#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
            </column>
            <column caption='% Active Users Zonas Sin Dmart' datatype='real' default-format='p0.00%' name='[% Active Users Zonas Drinks (copia)_385902246828687360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [account_owner]=&quot;Tamara Meza&quot;&#13;&#10;         and ( [area_name]  in (&apos;Arica&apos;,&apos;Copiapó&apos;,&apos;Linares&apos;,&apos;Los Andes&apos;,&apos;Ovalle&apos;,&apos;Placilla&apos;,&apos;Puerto Varas&apos;,&#13;&#10;&apos;Punta Arenas&apos;,&apos;San Antonio&apos;,&apos;San Felipe&apos;,&apos;Melipilla&apos;,&apos;Padre Hurtado&apos;))&#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;/sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Market&quot;, &quot;Drinks&quot;, &quot;Shop&quot;, &quot;Pets&quot;, &quot;Pharmacy&quot;) &#13;&#10;         and ( [area_name]  in (&apos;Arica&apos;,&apos;Copiapó&apos;,&apos;Linares&apos;,&apos;Los Andes&apos;,&apos;Ovalle&apos;,&apos;Placilla&apos;,&apos;Puerto Varas&apos;,&#13;&#10;&apos;Punta Arenas&apos;,&apos;San Antonio&apos;,&apos;San Felipe&apos;,&apos;Melipilla&apos;,&apos;Padre Hurtado&apos;))&#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
            </column>
            <column caption='% Active Users Other Business' datatype='real' default-format='p0.00%' name='[% Active Users Zonas Sin Dmart (copia)_385902246849286146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND( [business_name (qc_penetration)] IN ( &quot;Shop&quot;, &quot;Pets&quot;,&quot;Market&quot;) &#13;&#10;          and (IF [business_name]=&quot;Market&quot; then [category_name] else [business_name] end) IN (&quot;Chocolaterías&quot;,&quot;Supermercados&quot;,&quot;Frutas y Verduras&quot;,&quot;Carnes y Pescados&quot;,&quot;Minimarkets&quot;,&quot;Shop&quot;,&quot;Pets&quot;))&#13;&#10;            and [account_owner] &lt;&gt; (&quot;Javier Sáez&quot;)&#13;&#10;and [account_owner] &lt;&gt; (&quot;Jorge Díaz&quot;)&#13;&#10;       and [franchise_name]&lt;&gt;(&quot;Market PedidosYa&quot;) &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})&#13;&#10;&#13;&#10;/sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Market&quot;, &quot;Drinks&quot;, &quot;Shop&quot;, &quot;Pets&quot;, &quot;Pharmacy&quot;) &#13;&#10;         &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
            </column>
            <column caption='Mes Penetration' datatype='datetime' name='[Calculation_117656572505100289]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [registered_date])' />
            </column>
            <column caption='% Orders' datatype='real' name='[Calculation_1265230050026135552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders]) / SUM({FIXED [date] : SUM([Calculation_1590615124179173377])})' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_136233913571450881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='%VFD' datatype='real' name='[Calculation_151996523236589568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sponsorship_amount])-SUM([subsidio_liquido]))/SUM([gfv_vendor])' />
            </column>
            <column caption='Orders QC' datatype='integer' name='[Calculation_1590615124179173377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [business_name] IN (&apos;Market&apos;, &apos;Drinks&apos;, &apos;Pharmacy&apos;, &apos;Pets&apos;, &apos;Shop&apos;) THEN [confirmed_orders]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Active Users Total' datatype='integer' name='[Calculation_1590615124229025795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;CONFIRMED&quot; THEN [id] END)' />
            </column>
            <column caption='% Active Users' datatype='real' name='[Calculation_1590615124248698886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1590615124229025795]&#13;&#10;/sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND [business_name (qc_penetration)] IN (&quot;Market&quot;, &quot;Drinks&quot;, &quot;Shop&quot;, &quot;Pets&quot;, &quot;Pharmacy&quot;) &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
            </column>
            <column caption='User Other business' datatype='integer' name='[Calculation_2061241320360427520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND( [business_name (qc_penetration)] IN ( &quot;Shop&quot;, &quot;Pets&quot;,&quot;Market&quot;) &#13;&#10;          and (IF [business_name]=&quot;Market&quot; then [category_name] else [business_name] end) IN (&quot;Chocolaterías&quot;,&quot;Supermercados&quot;,&quot;Frutas y Verduras&quot;,&quot;Carnes y Pescados&quot;,&quot;Minimarkets&quot;,&quot;Shop&quot;,&quot;Pets&quot;))&#13;&#10;            and [account_owner] &lt;&gt; (&quot;Javier Sáez&quot;)&#13;&#10;and [account_owner] &lt;&gt; (&quot;Jorge Díaz&quot;)&#13;&#10;       and [franchise_name]&lt;&gt;(&quot;Market PedidosYa&quot;) &#13;&#10;        THEN [id] &#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
            </column>
            <column caption='Orders Other Business' datatype='integer' name='[Calculation_2061241320360542209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;{ FIXED [Calculation_117656572505100289] : &#13;&#10;    COUNTD(&#13;&#10;        IF [order_status] = &quot;CONFIRMED&quot; &#13;&#10;           AND( [business_name (qc_penetration)] IN ( &quot;Shop&quot;, &quot;Pets&quot;,&quot;Market&quot;) &#13;&#10;          and (IF [business_name]=&quot;Market&quot; then [category_name] else [business_name] end) IN (&quot;Chocolaterías&quot;,&quot;Supermercados&quot;,&quot;Frutas y Verduras&quot;,&quot;Carnes y Pescados&quot;,&quot;Minimarkets&quot;,&quot;Shop&quot;,&quot;Pets&quot;))&#13;&#10;            and [account_owner] &lt;&gt; (&quot;Javier Sáez&quot;)&#13;&#10;and [account_owner] &lt;&gt; (&quot;Jorge Díaz&quot;)&#13;&#10;       and [franchise_name]&lt;&gt;(&quot;Market PedidosYa&quot;) &#13;&#10;        THEN [order_id]&#13;&#10;        END&#13;&#10;    )&#13;&#10;})' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_233905731444903937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_gfv])/SUM([confirmed_orders])' />
            </column>
            <column caption='Zona ' datatype='string' name='[Calculation_2735092390519599104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [City_name] &#13;&#10;WHEN &quot;Santiago&quot; THEN [area_name]&#13;&#10;ELSE [City_name] END' />
            </column>
            <column caption='Cálculo1' datatype='real' default-format='p0.00%' name='[Calculation_710724360515788802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_active]=true then [partner_id] else null end)/COUNTD(if [status]=&quot;ON_LINE&quot; THEN [partner_id] ELSE NULL END)' />
            </column>
            <column caption='% VFR' datatype='real' name='[Calculation_931963674450956288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rejected_partner])/SUM([total_orders])' />
            </column>
            <column caption='Open Hours' datatype='integer' name='[Calculation_931963674472181761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DIV((SUM([schedule_times])-SUM([closed_times])),60)' />
            </column>
            <column caption='Active Partners' datatype='integer' name='[Calculation_931963674478444548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF  [is_active] = true THEN [partner_id] ELSE NULL END)' />
            </column>
            <column caption='Horas x Partner' datatype='real' name='[Calculation_931963674481070085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_931963674472181761]/[Calculation_931963674478444548])/COUNTD([date])' />
            </column>
