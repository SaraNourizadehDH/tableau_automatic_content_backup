      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/KPIsLocalStore/YoYXZona?rev=' id='YoYXZona' path='/t/Pedidosya/workbooks/KPIsLocalStore' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='qc_kpis_comercial ' name='federated.08dro761jxzi0t113zdnr02uysmo' />
          </datasources>
          <datasource-dependencies datasource='federated.08dro761jxzi0t113zdnr02uysmo'>
            <column caption='YoY Ordenes' datatype='real' name='[Calculation_1631710476497256448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([confirmed_orders])) - LOOKUP(ZN(SUM([confirmed_orders])), -12)) / ABS(LOOKUP(ZN(SUM([confirmed_orders])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='month' datatype='datetime' name='[Calculation_233905731552194567]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[date])' />
            </column>
            <column caption='Zona Chile' datatype='string' name='[Calculation_2735092390545907713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case   [City_name]&#13;&#10;when in (&apos;Quillota&apos;,&apos;Villa Alemana&apos;,&apos;Valparaíso&apos;,&apos;Viña del Mar&apos;,&apos;Quilpué&apos;,&apos;Los Andes&apos;) then &apos;5ta&apos;&#13;&#10;when  in (&apos;Antofagasta&apos;,&apos;La Serena&apos;,&apos;Calama&apos;,&apos;Arica&apos;,&apos;Copiapó&apos;,&apos;Iquique&apos;,&apos;Coquimbo&apos;,&apos;Ovalle&apos;) then &apos;Norte&apos;&#13;&#10;when  in (&apos;Santiago&apos;,&apos;Colina&apos;,&apos;Melipilla&apos;,&apos;Peñaflor&apos;,&apos;Talagante&apos;) then &apos;RM&apos;&#13;&#10;when  in (&apos;Valdivia&apos;,&apos;Temuco&apos;,&apos;Rancagua&apos;,&apos;Puerto Montt&apos;,&apos;Curicó&apos;,&apos;Los Ángeles&apos;,&apos;Gran Concepción&apos;,&apos;Osorno&apos;,&apos;Puerto Varas&apos;,&apos;Talca&apos;,&apos;Punta Arenas&apos;,&apos;Chillán&apos;) then &apos;Sur&apos; else &quot;Otros&quot; end' />
            </column>
            <column caption='City name' datatype='string' name='[City_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Business Name' datatype='string' name='[business_name]' role='dimension' type='nominal' />
            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_233905731552194567]' derivation='Month' name='[mn:Calculation_233905731552194567:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2735092390545907713]' derivation='None' name='[none:Calculation_2735092390545907713:nk]' pivot='key' type='nominal' />
            <column-instance column='[City_name]' derivation='None' name='[none:City_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_name]' derivation='None' name='[none:business_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[confirmed_orders]' derivation='Sum' name='[sum:confirmed_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:ok]' pivot='key' type='ordinal' />
