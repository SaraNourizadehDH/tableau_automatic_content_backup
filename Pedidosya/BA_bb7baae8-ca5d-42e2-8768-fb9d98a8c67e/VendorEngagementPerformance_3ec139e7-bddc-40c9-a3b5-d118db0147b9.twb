      </column>
      <column datatype='real' name='[CONFIRMED_ORDERS_L3M]' role='measure' type='quantitative' />
      <column caption='VFR L3M' datatype='real' name='[Calculation_1126462920657084416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[NON_CONFIRMED_ORDERS_L3M]/[TOTAL_ORDERS_L3M]' />
      </column>
      <column caption='Cae_General_Level' datatype='integer' name='[Calculation_1275363182012805123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DIFF_General_level] &lt; 0  THEN 1 ELSE 0 END' />
      </column>
      <column caption='Sube_General_Level' datatype='integer' name='[Calculation_1275363182013251588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DIFF_General_level] &gt; 0  THEN 1 ELSE 0 END' />
      </column>
      <column caption='Mantiene_General_Level' datatype='integer' name='[Calculation_1275363182013341701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DIFF_General_level] = 0  THEN 1 ELSE 0 END' />
      </column>
      <column caption='Conversion General Level' datatype='real' name='[Calculation_1275363182019178502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1275363182013251588])-SUM([Calculation_1275363182012805123]))/COUNTD([partner_id])' />
      </column>
      <column caption='Cae_Orders_Level' datatype='integer' name='[Calculation_1275363182027517959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DIFF_Orders_level] &lt; 0  THEN 1 ELSE 0 END' />
      </column>
      <column caption='Sube_Orders_Level' datatype='integer' name='[Calculation_1275363182027653128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DIFF_Orders_level] &gt; 0  THEN 1 ELSE 0 END' />
      </column>
      <column caption='Mantiene_Orders_Level' datatype='integer' name='[Calculation_1275363182027743241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DIFF_Orders_level] = 0  THEN 1 ELSE 0 END' />
      </column>
      <column caption='Conversion Order Level' datatype='real' name='[Calculation_1275363182027853834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1275363182027653128])-SUM([Calculation_1275363182027517959]))/COUNTD([partner_id])' />
      </column>
      <column caption='Cambio de nivel General' datatype='string' name='[Calculation_1293377519148146688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [general_level_ant] &gt; [General_level] THEN &quot;Baja&quot;&#13;&#10;ELSEIF [general_level_ant] &lt; [General_level] THEN &quot;Sube&quot;&#13;&#10;ELSE &quot;Se mantiene&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Baja&quot;' value='Bajó' />
          <alias key='&quot;Se mantiene&quot;' value='Se mantuvo' />
          <alias key='&quot;Sube&quot;' value='Subió' />
        </aliases>
      </column>
      <column caption='Socios que suben general' datatype='integer' name='[Calculation_1293377519148642305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1293377519148146688] = &quot;Sube&quot; THEN [partner_id] END)' />
      </column>
      <column caption='Socios totales' datatype='integer' name='[Calculation_1293377519148793858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id])' />
      </column>
      <column caption='Socios que bajan general' datatype='integer' name='[Calculation_1293377519149252611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1293377519148146688] = &quot;Baja&quot; THEN [partner_id] END)' />
      </column>
      <column caption='# Partners vs LM' datatype='integer' name='[Calculation_336644139552833536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD([partner_id])) - LOOKUP(ZN(COUNTD([partner_id])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Partners vs LM' datatype='real' name='[Calculation_336644139577622535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(COUNTD([partner_id])) / LOOKUP(ZN(COUNTD([partner_id])), -1))-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
