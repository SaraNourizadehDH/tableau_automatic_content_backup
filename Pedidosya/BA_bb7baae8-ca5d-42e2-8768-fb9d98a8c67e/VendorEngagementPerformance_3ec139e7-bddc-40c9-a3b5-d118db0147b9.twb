      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.06ckmdg1glhwr31e5uwlt06j1qxe' />
          </datasources>
          <datasource-dependencies datasource='federated.06ckmdg1glhwr31e5uwlt06j1qxe'>
            <column caption='VFR L3M' datatype='real' name='[Calculation_1126462920657084416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NON_CONFIRMED_ORDERS_L3M]/[TOTAL_ORDERS_L3M]' />
            </column>
            <column caption='Sube_VFR_Level' datatype='integer' name='[Calculation_674414107746291716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_VFR_level] &gt; 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Cae_VFR_Level' datatype='integer' name='[Calculation_674414107746463749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_VFR_level] &lt; 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Mantiene_VFR_Level' datatype='integer' name='[Calculation_674414107746553862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_VFR_level] = 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Conversion VFR Level' datatype='real' name='[Calculation_674414107746607111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_674414107746291716])-SUM([Calculation_674414107746463749]))/COUNTD([partner_id])' />
            </column>
            <column caption='Zombies y Low Orders' datatype='string' name='[Calculation_674414107815428111]' role='dimension' type='nominal'>
