        <calculation class='tableau' formula='if [confirmed_orders]= 0 then &apos;Zombies&apos; &#13;&#10;ELSEIF ISNULL([confirmed_orders]) then &apos;Zombies&apos; &#13;&#10;ELSEif [confirmed_orders]&lt; 30 then &apos;Low orders&apos; &#13;&#10;ELSEIF  [confirmed_orders]&gt;= 30 then &apos;over 30&apos;&#13;&#10;else &apos;check&apos; END' />
