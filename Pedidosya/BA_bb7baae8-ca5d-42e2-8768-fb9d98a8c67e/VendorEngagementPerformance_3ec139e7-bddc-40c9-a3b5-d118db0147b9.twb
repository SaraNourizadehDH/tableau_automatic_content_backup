          </datasources>
          <datasource-dependencies datasource='federated.06ckmdg1glhwr31e5uwlt06j1qxe'>
            <column caption='Cae_General_Level' datatype='integer' name='[Calculation_1275363182012805123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_General_level] &lt; 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Sube_General_Level' datatype='integer' name='[Calculation_1275363182013251588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_General_level] &gt; 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Mantiene_General_Level' datatype='integer' name='[Calculation_1275363182013341701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_General_level] = 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Conversion General Level' datatype='real' name='[Calculation_1275363182019178502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1275363182013251588])-SUM([Calculation_1275363182012805123]))/COUNTD([partner_id])' />
            </column>
            <column caption='# Partners vs LM' datatype='integer' name='[Calculation_336644139552833536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(COUNTD([partner_id])) - LOOKUP(ZN(COUNTD([partner_id])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Partners vs LM' datatype='real' name='[Calculation_336644139577622535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(COUNTD([partner_id])) / LOOKUP(ZN(COUNTD([partner_id])), -1))-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Zombies y Low Orders' datatype='string' name='[Calculation_674414107815428111]' role='dimension' type='nominal'>
