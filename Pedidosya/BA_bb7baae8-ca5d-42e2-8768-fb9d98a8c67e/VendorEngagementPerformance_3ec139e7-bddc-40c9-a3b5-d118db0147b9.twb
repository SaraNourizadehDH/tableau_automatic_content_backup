            </column>
            <column aggregation='Sum' datatype='integer' name='[Content_levels]' role='dimension' type='ordinal' />
            <column datatype='real' name='[DIFF_AVG_VFR_L3M]' role='measure' type='quantitative' />
            <column datatype='integer' name='[DIFF_VFR_level]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[General_level]' role='dimension' type='ordinal' />
            <column datatype='real' name='[NON_CONFIRMED_ORDERS_L3M]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[Orders_levels]' role='dimension' type='ordinal' />
