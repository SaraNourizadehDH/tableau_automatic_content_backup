    <worksheet name='Conv General Level - By Segment'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Semibold' fontsize='14'>General Level Conversion  - by Segment</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.06ckmdg1glhwr31e5uwlt06j1qxe' />
          </datasources>
          <datasource-dependencies datasource='federated.06ckmdg1glhwr31e5uwlt06j1qxe'>
            <column caption='Cae_General_Level' datatype='integer' name='[Calculation_1275363182012805123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_General_level] &lt; 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Sube_General_Level' datatype='integer' name='[Calculation_1275363182013251588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_General_level] &gt; 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Mantiene_General_Level' datatype='integer' name='[Calculation_1275363182013341701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [DIFF_General_level] = 0  THEN 1 ELSE 0 END' />
            </column>
            <column caption='Conversion General Level' datatype='real' name='[Calculation_1275363182019178502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1275363182013251588])-SUM([Calculation_1275363182012805123]))/COUNTD([partner_id])' />
            </column>
            <column caption='Zombies y Low Orders' datatype='string' name='[Calculation_674414107815428111]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [confirmed_orders]= 0 then &apos;Zombies&apos; &#13;&#10;ELSEIF ISNULL([confirmed_orders]) then &apos;Zombies&apos; &#13;&#10;ELSEif [confirmed_orders]&lt; 30 then &apos;Low orders&apos; &#13;&#10;ELSEIF  [confirmed_orders]&gt;= 30 then &apos;over 30&apos;&#13;&#10;else &apos;check&apos; END' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Content_levels]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[DIFF_General_level]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[General_level]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[Orders_levels]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[Rating_levels]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[VFR_levels]' role='dimension' type='ordinal' />
            <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[partner_id]' derivation='CountD' name='[ctd:partner_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[reward_month]' derivation='MY' name='[my:reward_month:ok]' pivot='key' type='ordinal' />
