          <object caption='Pipeline_Detailed' id='Pipeline_Detailed_2FF0D4A9269A45B48420C7B922A69050'>
            <properties context=''>
              <relation connection='bigquery.1pm7ti31jrfj131fhywkz1yoatxg' name='Consulta SQL personalizada1' type='text'>WITH latam_summary AS (&#13;
  SELECT &#13;
    &apos;LATAM&apos; AS Country,&#13;
    Fecha,&#13;
    Is_Food_Or_LS,&#13;
    Source,&#13;
    SUM(NewOnline) AS TotalNewOnline,&#13;
    SUM(Onboarding) AS TotalOnboarding,&#13;
    SUM(OnboardingFailed) AS TotalOnboardingFailed,&#13;
    SUM(DeliveryPending) AS TotalDeliveryPending,&#13;
    SUM(EditorialQueue) AS TotalEditorialQueue,&#13;
    SUM(QualityCheckRequest) AS TotalQualityCheckRequest,&#13;
    SUM(PleaseCheck) AS TotalPleaseCheck,&#13;
    SUM(FeedbackReceived) AS TotalFeedbackReceived,&#13;
    SUM(QuoteSent) AS TotalQuoteSent,&#13;
    SUM(Open) AS TotalOpen,&#13;
    SUM(NewOpportunity) AS TotalNewOpportunity,&#13;
    SUM(ReassignedOpportunity) AS TotalReassignedOpportunity&#13;
  FROM &#13;
    `peya-delivery-and-support.automated_tables_reports.Pipeline_Detailed`&#13;
  WHERE &#13;
    Country != &apos;LATAM&apos; -- Exclude individual countries&#13;
  GROUP BY &#13;
    Fecha, Is_Food_Or_LS, Source&#13;
)&#13;
&#13;
-- Retrieve individual country data&#13;
SELECT &#13;
  Country,&#13;
  Fecha,&#13;
  Is_Food_Or_LS,&#13;
  Source,&#13;
  NewOnline,&#13;
  Onboarding,&#13;
  OnboardingFailed,&#13;
  DeliveryPending,&#13;
  EditorialQueue,&#13;
  QualityCheckRequest,&#13;
  PleaseCheck,&#13;
  FeedbackReceived,&#13;
  QuoteSent,&#13;
  Open,&#13;
  NewOpportunity,&#13;
  ReassignedOpportunity&#13;
FROM &#13;
  `peya-delivery-and-support.automated_tables_reports.Pipeline_Detailed`&#13;
&#13;
-- Union with the summarized &quot;latam&quot; rows&#13;
UNION ALL&#13;
&#13;
-- Retrieve summarized data for &quot;latam&quot; - Food and SSU&#13;
SELECT &#13;
  ls.Country,&#13;
  ls.Fecha,&#13;
  &apos;Food&apos; AS Is_Food_Or_LS,&#13;
  &apos;SSU&apos; AS Source,&#13;
  IFNULL(ls.TotalNewOnline, 0) AS NewOnline,&#13;
  IFNULL(ls.TotalOnboarding, 0) AS Onboarding,&#13;
  IFNULL(ls.TotalOnboardingFailed, 0) AS OnboardingFailed,&#13;
  IFNULL(ls.TotalDeliveryPending, 0) AS DeliveryPending,&#13;
  IFNULL(ls.TotalEditorialQueue, 0) AS EditorialQueue,&#13;
  IFNULL(ls.TotalQualityCheckRequest, 0) AS QualityCheckRequest,&#13;
  IFNULL(ls.TotalPleaseCheck, 0) AS PleaseCheck,&#13;
  IFNULL(ls.TotalFeedbackReceived, 0) AS FeedbackReceived,&#13;
  IFNULL(ls.TotalQuoteSent, 0) AS QuoteSent,&#13;
  IFNULL(ls.TotalOpen, 0) AS Open,&#13;
  IFNULL(ls.TotalNewOpportunity, 0) AS NewOpportunity,&#13;
  IFNULL(ls.TotalReassignedOpportunity, 0) AS ReassignedOpportunity&#13;
FROM &#13;
  latam_summary ls&#13;
WHERE &#13;
  ls.Is_Food_Or_LS = &apos;Food&apos; AND ls.Source = &apos;SSU&apos;&#13;
&#13;
-- Union with the summarized &quot;latam&quot; rows - Food and Field&#13;
UNION ALL&#13;
&#13;
SELECT &#13;
  ls.Country,&#13;
  ls.Fecha,&#13;
  &apos;Food&apos; AS Is_Food_Or_LS,&#13;
  &apos;Field&apos; AS Source,&#13;
  IFNULL(ls.TotalNewOnline, 0) AS NewOnline,&#13;
  IFNULL(ls.TotalOnboarding, 0) AS Onboarding,&#13;
  IFNULL(ls.TotalOnboardingFailed, 0) AS OnboardingFailed,&#13;
  IFNULL(ls.TotalDeliveryPending, 0) AS DeliveryPending,&#13;
  IFNULL(ls.TotalEditorialQueue, 0) AS EditorialQueue,&#13;
  IFNULL(ls.TotalQualityCheckRequest, 0) AS QualityCheckRequest,&#13;
  IFNULL(ls.TotalPleaseCheck, 0) AS PleaseCheck,&#13;
  IFNULL(ls.TotalFeedbackReceived, 0) AS FeedbackReceived,&#13;
  IFNULL(ls.TotalQuoteSent, 0) AS QuoteSent,&#13;
  IFNULL(ls.TotalOpen, 0) AS Open,&#13;
  IFNULL(ls.TotalNewOpportunity, 0) AS NewOpportunity,&#13;
  IFNULL(ls.TotalReassignedOpportunity, 0) AS ReassignedOpportunity&#13;
FROM &#13;
  latam_summary ls&#13;
WHERE &#13;
  ls.Is_Food_Or_LS = &apos;Food&apos; AND ls.Source = &apos;Field&apos;&#13;
&#13;
-- Union with the summarized &quot;latam&quot; rows - Local Stores and SSU&#13;
UNION ALL&#13;
&#13;
SELECT &#13;
  ls.Country,&#13;
  ls.Fecha,&#13;
  &apos;Local Stores&apos; AS Is_Food_Or_LS,&#13;
  &apos;SSU&apos; AS Source,&#13;
  IFNULL(ls.TotalNewOnline, 0) AS NewOnline,&#13;
  IFNULL(ls.TotalOnboarding, 0) AS Onboarding,&#13;
  IFNULL(ls.TotalOnboardingFailed, 0) AS OnboardingFailed,&#13;
  IFNULL(ls.TotalDeliveryPending, 0) AS DeliveryPending,&#13;
  IFNULL(ls.TotalEditorialQueue, 0) AS EditorialQueue,&#13;
  IFNULL(ls.TotalQualityCheckRequest, 0) AS QualityCheckRequest,&#13;
  IFNULL(ls.TotalPleaseCheck, 0) AS PleaseCheck,&#13;
  IFNULL(ls.TotalFeedbackReceived, 0) AS FeedbackReceived,&#13;
  IFNULL(ls.TotalQuoteSent, 0) AS QuoteSent,&#13;
  IFNULL(ls.TotalOpen, 0) AS Open,&#13;
  IFNULL(ls.TotalNewOpportunity, 0) AS NewOpportunity,&#13;
  IFNULL(ls.TotalReassignedOpportunity, 0) AS ReassignedOpportunity&#13;
FROM &#13;
  latam_summary ls&#13;
WHERE &#13;
  ls.Is_Food_Or_LS = &apos;Local Stores&apos; AND ls.Source = &apos;SSU&apos;&#13;
&#13;
-- Union with the summarized &quot;latam&quot; rows - Local Stores and Field&#13;
UNION ALL&#13;
&#13;
SELECT &#13;
  ls.Country,&#13;
  ls.Fecha,&#13;
  &apos;Local Stores&apos; AS Is_Food_Or_LS,&#13;
  &apos;Field&apos; AS Source,&#13;
  IFNULL(ls.TotalNewOnline, 0) AS NewOnline,&#13;
  IFNULL(ls.TotalOnboarding, 0) AS Onboarding,&#13;
  IFNULL(ls.TotalOnboardingFailed, 0) AS OnboardingFailed,&#13;
  IFNULL(ls.TotalDeliveryPending, 0) AS DeliveryPending,&#13;
  IFNULL(ls.TotalEditorialQueue, 0) AS EditorialQueue,&#13;
  IFNULL(ls.TotalQualityCheckRequest, 0) AS QualityCheckRequest,&#13;
  IFNULL(ls.TotalPleaseCheck, 0) AS PleaseCheck,&#13;
  IFNULL(ls.TotalFeedbackReceived, 0) AS FeedbackReceived,&#13;
  IFNULL(ls.TotalQuoteSent, 0) AS QuoteSent,&#13;
  IFNULL(ls.TotalOpen, 0) AS Open,&#13;
  IFNULL(ls.TotalNewOpportunity, 0) AS NewOpportunity,&#13;
  IFNULL(ls.TotalReassignedOpportunity, 0) AS ReassignedOpportunity&#13;
FROM &#13;
  latam_summary ls&#13;
WHERE &#13;
  ls.Is_Food_Or_LS = &apos;Local Stores&apos; AND ls.Source = &apos;Field&apos;</relation>
