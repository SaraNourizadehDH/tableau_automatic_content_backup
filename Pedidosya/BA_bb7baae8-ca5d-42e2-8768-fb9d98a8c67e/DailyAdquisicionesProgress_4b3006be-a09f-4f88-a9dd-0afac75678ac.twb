                  </zone-style>
                </zone>
                <zone fixed-size='1059' forceUpdate='true' h='9279' id='41' type-v2='text' w='62696' x='781' y='17889'>
                  <formatted-text>
                    <run fontalignment='0' italic='true'>Este tablero fue creado para el </run>
                    <run bold='true' fontalignment='0' italic='true'>seguimiento diario </run>
                    <run fontalignment='0' italic='true'>de sellers contratados,  adquisiciones, y productividad; y su comparación con los targets vigentes. A continuación se plasman algunas definiciones: </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='9279' id='23' type-v2='text' w='3125' x='96094' y='17889'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='55469' id='44' type-v2='text' w='98438' x='781' y='27168'>
                  <formatted-text>
                    <run bold='true' fontalignment='0' fontcolor='#ba0003' fontsize='9'>Sellers target: </run>
                    <run fontalignment='0' fontsize='9'>cantidad de FTEs acordadas en instancias de planificación (Budget y Best Estimates).</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0' fontcolor='#ba0003' fontsize='9'>New Online target:</run>
                    <run fontalignment='0' fontsize='9'> cantidad de cuentas (closed won) a adquirir acordadas en instancias de planificación (Budget y Best Estimates).</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0' fontcolor='#ba0003' fontsize='9'>Productividad target:</run>
                    <run fontalignment='0' fontsize='9'> cantidad de cuentas new online target divido sellers target.   </run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='0' fontcolor='#ba0003' fontsize='9'>Sellers actual:</run>
                    <run fontalignment='0' fontsize='9'> cantidad de FTEs contratados a la fecha de acuerdo a nómina Workday.</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0' fontcolor='#ba0003' fontsize='9'>New Online actual:</run>
                    <run fontalignment='0' fontsize='9'> cantidad de cuentas closed won en mes corriente (food y local stores; no incluye courier, concept, ni kitchen). </run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run bold='true' fontalignment='0' fontcolor='#ba0003' fontsize='9'>Productividad actual:</run>
                    <run bold='true' fontalignment='0' fontsize='9'>Æ </run>
                    <run fontalignment='0' fontsize='9'>cantidad de cuentas new online actual dividido sellers actual contratados.</run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='0' fontcolor='#ba0003' fontsize='9'>Daily Acquisitions Pipeline:</run>
                    <run fontalignment='0' fontsize='9'> cantidad de cuentas en los diferentes estados de Salesforce desde New Opportunity hasta Closed Won.</run>
                    <run fontalignment='0'>Æ&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{0A3D2F52-ED1D-45B7-9AC8-6E28F8640E63}' />
    </dashboard>
