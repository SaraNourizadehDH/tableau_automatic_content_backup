            </column>
            <column caption='HC Target hibridos food' datatype='real' name='[HC Target hibridos local store (copia)_1352768796656963590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;) * 0.95' />
