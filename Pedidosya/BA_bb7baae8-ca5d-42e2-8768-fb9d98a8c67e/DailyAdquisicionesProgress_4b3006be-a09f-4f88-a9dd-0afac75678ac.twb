            </column>
            <column caption='Total New Online' datatype='integer' name='[Calculation_272749306052423689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([NewOnline])' />
            </column>
            <column caption='Target Field Acquisitions Food' datatype='integer' name='[Calculation_272749306055176202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(  &#13;&#10;    IF [kpi] =&apos;FIELD ACQUISITIONS&apos;&#13;&#10;    AND [business_target]= &apos;FOOD&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
