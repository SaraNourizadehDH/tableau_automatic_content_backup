            <column caption='HC Target hibridos local store' datatype='real' name='[Calculation_1352768796652675074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;) * 0.05' />
            </column>
            <column caption='Target Productividad LOCAL' datatype='real' name='[Calculation_2363263960640876560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Target Acquisitions Food  (copia)_2363263960579776518]  / [Cantidad Sellers Local Stores (copia)_2363263960613875727]' />
            </column>
            <column caption='Target Total Sellers' datatype='real' name='[Calculation_272749306048483334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[HC Target SSU Food (copia)_1352768796657188872]+&#13;&#10;[HC Target Field Local Store (copia)_1352768796656787461]+&#13;&#10;[HC Target hibridos local store (copia)_1352768796656963590]+ &#13;&#10;[HC Target SSU local store (copia)_1352768796657094663]+&#13;&#10;[HC hibridos local store (copia)_1352768796655968259]+&#13;&#10;[Calculation_1352768796652675074]+&#13;&#10;[HC Field local store (copia)_1352768796656271364]' />
            </column>
            <column caption='Cantidad Sellers' datatype='real' name='[Calculation_272749306049327111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Cantidad Sellers (copia)_1666331915840229382] + [Cantidad Sellers Food (copia)_1666331915840565255]' />
            </column>
            <column caption='Total New Online' datatype='integer' name='[Calculation_272749306052423689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([NewOnline])' />
            </column>
            <column caption='Target Field Acquisitions Food' datatype='integer' name='[Calculation_272749306055176202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(  &#13;&#10;    IF [kpi] =&apos;FIELD ACQUISITIONS&apos;&#13;&#10;    AND [business_target]= &apos;FOOD&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Target Total Adquisitions' datatype='integer' name='[Calculation_272749306056675340]' role='measure' type='quantitative'>
