            <column caption='% Cumplimiento Productividad LOCAL' datatype='real' default-format='p0%' name='[% Cumplimiento Productividad FOOD (copia)_2363263960641544209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Food Productividad  (copia)_2363263960641925138] / [Calculation_2363263960640876560]' />
            </column>
            <column caption='Target SSU Acquisitions Food' datatype='integer' name='[Budget SSU Adquisitions (copia)_272749306056306699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10; &#13;&#10;    IF [kpi] =&apos;SSU ACQUISITIONS&apos;&#13;&#10;    AND [business_target] = &apos;FOOD&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
