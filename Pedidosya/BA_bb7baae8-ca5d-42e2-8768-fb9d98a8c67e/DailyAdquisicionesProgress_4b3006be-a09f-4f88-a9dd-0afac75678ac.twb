    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glosario'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/DailyAdquisicionesProgress/Glosario?rev=' id='Glosario' path='/t/Pedidosya/workbooks/DailyAdquisicionesProgress' revision='' site='Pedidosya' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#00000000' />
        </style-rule>
        <style-rule element='dash-title'>
          <format attr='color' value='#000000' />
          <format attr='font-size' value='14' />
