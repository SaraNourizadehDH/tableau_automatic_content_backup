      <table>
        <view>
          <datasources>
            <datasource caption='Newsletter_Planning (automated_tables_reports)' name='federated.1ptovyw16nfaex17ej5kf01gweo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1ptovyw16nfaex17ej5kf01gweo1'>
            <column caption='HC Target hibridos local store' datatype='real' name='[Calculation_1352768796652675074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;) * 0.05' />
            </column>
            <column caption='Target Total Sellers' datatype='real' name='[Calculation_272749306048483334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[HC Target SSU Food (copia)_1352768796657188872]+&#13;&#10;[HC Target Field Local Store (copia)_1352768796656787461]+&#13;&#10;[HC Target hibridos local store (copia)_1352768796656963590]+ &#13;&#10;[HC Target SSU local store (copia)_1352768796657094663]+&#13;&#10;[HC hibridos local store (copia)_1352768796655968259]+&#13;&#10;[Calculation_1352768796652675074]+&#13;&#10;[HC Field local store (copia)_1352768796656271364]' />
            </column>
            <column caption='Cantidad Sellers' datatype='real' name='[Calculation_272749306049327111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Cantidad Sellers (copia)_1666331915840229382] + [Cantidad Sellers Food (copia)_1666331915840565255]' />
            </column>
            <column caption='Cumplimiento de Cantidad Sellers' datatype='real' name='[Calculation_272749306049978376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_272749306049327111] - [Calculation_272749306048483334]' />
            </column>
            <column caption='Cantidad Sellers Food' datatype='real' name='[Cantidad Sellers (copia)_1666331915840229382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [full_legal_name]:AVG([hc_food]) })' />
            </column>
            <column caption='Cantidad Sellers Local Stores' datatype='real' name='[Cantidad Sellers Food (copia)_1666331915840565255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [full_legal_name]:AVG([hc_local_stores]) })' />
            </column>
            <column caption='HC Target SSU local store' datatype='integer' name='[HC Field local store (copia)_1352768796656271364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;LOCAL STORES&apos;&#13;&#10;AND  [kpi]= &apos;SSU SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='HC Target Field Food' datatype='integer' name='[HC Target Field Local Store (copia)_1352768796656787461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;FOOD&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='HC Target ( HIBRIDO - SSU ) Food ' datatype='integer' name='[HC Target SSU Food (copia)_1352768796657188872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;SSU SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='HC Target SSU Food' datatype='integer' name='[HC Target SSU local store (copia)_1352768796657094663]' role='measure' type='quantitative'>
