        <view>
          <datasources>
            <datasource caption='Newsletter_Planning (automated_tables_reports)' name='federated.1ptovyw16nfaex17ej5kf01gweo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1ptovyw16nfaex17ej5kf01gweo1'>
            <column caption='HC Target hibridos local store' datatype='real' name='[Calculation_1352768796652675074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;) * 0.05' />
            </column>
            <column caption='Cantidad Sellers Local Stores' datatype='real' name='[Cantidad Sellers Food (copia)_1666331915840565255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [full_legal_name]:AVG([hc_local_stores]) })' />
            </column>
            <column caption='Cantidad Sellers Local Stores Target' datatype='real' name='[Cantidad Sellers Local Stores (copia)_2363263960613875727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1352768796652675074] + [HC hibridos local store (copia)_1352768796655968259]+ [HC Field local store (copia)_1352768796656271364]' />
            </column>
            <column caption='Cumplimiento HC Local' datatype='real' name='[Cumplimiento HC Food (copia)_2363263960586719241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Cantidad Sellers Food (copia)_1666331915840565255] - [Cantidad Sellers Local Stores (copia)_2363263960613875727]' />
            </column>
            <column caption='HC Target SSU local store' datatype='integer' name='[HC Field local store (copia)_1352768796656271364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;LOCAL STORES&apos;&#13;&#10;AND  [kpi]= &apos;SSU SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='HC Target Field Local Store' datatype='integer' name='[HC hibridos local store (copia)_1352768796655968259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;LOCAL STORES&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
