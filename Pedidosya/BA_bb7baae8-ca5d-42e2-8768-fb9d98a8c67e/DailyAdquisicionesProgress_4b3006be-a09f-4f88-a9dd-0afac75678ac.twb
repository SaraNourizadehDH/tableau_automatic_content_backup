FROM `peya-delivery-and-support.automated_tables_reports`.`Newsletter_Planning` `Newsletter_Planning`</relation>
            </properties>
            <properties context='extract'>
              <relation name='Newsletter_Planning_126B15323D604E1A807D743A4FCE0E65' table='[Extract].[Newsletter_Planning_126B15323D604E1A807D743A4FCE0E65]' type='table' />
