      </column>
      <column caption='Food New Online' datatype='integer' name='[Calculation_2363263960576606210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(  &#13;&#10;    IF [Is_Food_Or_LS] = &apos;Food&apos;&#13;&#10;    THEN [NewOnline]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Cantidad Sellers Target FOOD' datatype='real' name='[Calculation_2363263960612995086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[HC Target SSU Food (copia)_1352768796657188872] + &#13;&#10;[HC Target Field Local Store (copia)_1352768796656787461]+&#13;&#10;[HC Target SSU local store (copia)_1352768796657094663] + &#13;&#10;[HC Target hibridos local store (copia)_1352768796656963590]' />
