      <column caption='Target Field Sellers' datatype='integer' name='[Budget SSU (copia)_272749306048073733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [kpi] =  &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Target SSU Acquisitions Food' datatype='integer' name='[Budget SSU Adquisitions (copia)_272749306056306699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#13;&#10; &#13;&#10;    IF [kpi] =&apos;SSU ACQUISITIONS&apos;&#13;&#10;    AND [business_target] = &apos;FOOD&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='HC Target hibridos local store' datatype='real' name='[Calculation_1352768796652675074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;) * 0.05' />
      </column>
      <column caption='Total Onboarding' datatype='integer' name='[Calculation_1412722965689507840]' role='measure' type='quantitative'>
