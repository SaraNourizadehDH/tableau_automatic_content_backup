    <worksheet name='Productividad Food'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Sheet Name</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Newsletter_Planning (automated_tables_reports)' name='federated.1ptovyw16nfaex17ej5kf01gweo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1ptovyw16nfaex17ej5kf01gweo1'>
            <column caption='% Cumplimiento Productividad FOOD' datatype='real' default-format='p0%' name='[% Cumplimiento Productividad (copia)_2363263960589946892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Productividad (copia)_2363263960589668363] / [Target Productividad  (copia)_2363263960587952138]' />
            </column>
            <column caption='Target SSU Acquisitions Food' datatype='integer' name='[Budget SSU Adquisitions (copia)_272749306056306699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10; &#13;&#10;    IF [kpi] =&apos;SSU ACQUISITIONS&apos;&#13;&#10;    AND [business_target] = &apos;FOOD&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Target Acquisitions Food ' datatype='integer' name='[Calculation_2363263960575787009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Budget SSU Adquisitions (copia)_272749306056306699] + &#13;&#10;[Calculation_272749306055176202]' />
            </column>
            <column caption='Food New Online' datatype='integer' name='[Calculation_2363263960576606210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(  &#13;&#10;    IF [Is_Food_Or_LS] = &apos;Food&apos;&#13;&#10;    THEN [NewOnline]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Cantidad Sellers Target FOOD' datatype='real' name='[Calculation_2363263960612995086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[HC Target SSU Food (copia)_1352768796657188872] + &#13;&#10;[HC Target Field Local Store (copia)_1352768796656787461]+&#13;&#10;[HC Target SSU local store (copia)_1352768796657094663] + &#13;&#10;[HC Target hibridos local store (copia)_1352768796656963590]' />
            </column>
            <column caption='Target Field Acquisitions Food' datatype='integer' name='[Calculation_272749306055176202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(  &#13;&#10;    IF [kpi] =&apos;FIELD ACQUISITIONS&apos;&#13;&#10;    AND [business_target]= &apos;FOOD&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Cantidad Sellers Food' datatype='real' name='[Cantidad Sellers (copia)_1666331915840229382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [full_legal_name]:AVG([hc_food]) })' />
            </column>
            <column datatype='date' name='[Fecha]' role='dimension' type='ordinal' />
            <column caption='HC Target Field Food' datatype='integer' name='[HC Target Field Local Store (copia)_1352768796656787461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;FOOD&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='HC Target ( HIBRIDO - SSU ) Food ' datatype='integer' name='[HC Target SSU Food (copia)_1352768796657188872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;SSU SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='HC Target SSU Food' datatype='integer' name='[HC Target SSU local store (copia)_1352768796657094663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;FOOD&apos;&#13;&#10;AND  [kpi]= &apos;SSU SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='HC Target hibridos food' datatype='real' name='[HC Target hibridos local store (copia)_1352768796656963590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;&#13;&#10;    IF [business_target] =  &apos;HIBRIDOS&apos;&#13;&#10;AND  [kpi]= &apos;FIELD SELLERS&apos;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;) * 0.95' />
            </column>
            <column caption='Is Food Or LS' datatype='string' name='[Is_Food_Or_LS]' role='dimension' type='nominal' />
            <column caption='New Online' datatype='integer' name='[NewOnline]' role='measure' type='quantitative' />
            <column datatype='string' name='[Source]' role='dimension' type='nominal' />
            <column caption='Target Productividad  FOOD' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Target Productividad  (copia)_2363263960587952138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2363263960575787009] / [Calculation_2363263960612995086]' />
            </column>
            <column caption='Food Productividad ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Total Productividad (copia)_2363263960589668363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2363263960576606210]) / [Cantidad Sellers (copia)_1666331915840229382]' />
