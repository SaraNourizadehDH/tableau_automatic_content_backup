            <column caption='last state' datatype='string' name='[Calculation_428404930048311308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] : &#13;&#10;   MAX(IF [registered_date] = &#13;&#10;           { FIXED [partner_id], [migration_date] : MAX([registered_date]) }&#13;&#10;       THEN [restaurant_state_name]&#13;&#10;   END)&#13;&#10;}' />
            </column>
            <column aggregation='Sum' caption='date diff values' datatype='integer' name='[Calculation_428404930146693142]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  [date_difference]&gt;[Parameters].[Parameter 1] OR  [date_difference]&lt;-[Parameters].[Parameter 1] THEN  NULL&#13;&#10;ELSEIF   [is_pre_migration] THEN -1&#13;&#10;ELSEIF  [is_post_migration] THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
