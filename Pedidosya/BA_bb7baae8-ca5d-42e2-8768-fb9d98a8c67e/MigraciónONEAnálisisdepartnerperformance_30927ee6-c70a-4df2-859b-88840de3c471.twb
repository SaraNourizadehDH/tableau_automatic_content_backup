          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Frame' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='60'>
              <calculation class='tableau' formula='60' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yimo6u13gzepp174jsiz1ktmjvw'>
            <column caption='has orders c. N days before' datatype='boolean' name='[Calculation_428404930029359106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &gt;= -[Parameters].[Parameter 1] AND [date_difference] &lt;= -1 THEN [orders_confirmed] ELSE 0 END&#13;&#10;    )&#13;&#10;} &gt; 0' />
            </column>
            <column caption='has stopped orders c. N days' datatype='boolean' name='[Calculation_428404930033917956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_428404930029359106]AND  NOT [has orders c. N days before (copy)_428404930030899203]' />
            </column>
            <column caption='orders c before' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_428404930044129288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &gt;= -[Parameters].[Parameter 1] &#13;&#10;           AND [date_difference] &lt;= -1 &#13;&#10;           THEN [orders_confirmed] ELSE 0 END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='orders c after' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_428404930044338185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &gt;= 1 &#13;&#10;           AND [date_difference] &lt;= [Parameters].[Parameter 1] &#13;&#10;           THEN [orders_confirmed] ELSE 0 END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='ROH before' datatype='real' name='[Calculation_428404930044579850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &gt;= -[Parameters].[Parameter 1] &#13;&#10;           AND [date_difference] &lt;= -1 &#13;&#10;           THEN [ROH] ELSE 0 END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='ROH after' datatype='real' name='[Calculation_428404930044723211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &gt;= 1 &#13;&#10;           AND [date_difference] &lt;= [Parameters].[Parameter 1] &#13;&#10;           THEN [ROH] ELSE 0 END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='last state' datatype='string' name='[Calculation_428404930048311308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] : &#13;&#10;   MAX(IF [registered_date] = &#13;&#10;           { FIXED [partner_id], [migration_date] : MAX([registered_date]) }&#13;&#10;       THEN [restaurant_state_name]&#13;&#10;   END)&#13;&#10;}' />
            </column>
            <column caption='ROH delta' datatype='real' name='[Calculation_428404930105884686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_428404930044579850]) = 0 THEN NULL&#13;&#10;ELSE (SUM([Calculation_428404930044723211]) - SUM([Calculation_428404930044579850])) / SUM([Calculation_428404930044579850])&#13;&#10;END' />
            </column>
            <column caption='Scheduled Hours N days before' datatype='real' name='[Calculation_428404930129604626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ABS([date_difference]) &lt;= [Parameters].[Parameter 1] AND [date_difference] &lt; 0 THEN [scheduled_hours]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Scheduled Hours N days after' datatype='real' name='[Calculation_428404930129764371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ABS([date_difference]) &lt;= [Parameters].[Parameter 1] AND [date_difference] &gt; 0 THEN [scheduled_hours]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='open rate before' datatype='real' name='[Calculation_428404930130571284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_428404930129604626]) = 0 THEN NULL&#13;&#10;ELSE SUM([Calculation_428404930044579850]) / SUM([Calculation_428404930129604626])&#13;&#10;END' />
            </column>
            <column caption='open rate delta' datatype='real' default-format='p0.0%' name='[ROH delta % N days (copy)_428404932148776989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_428404930130571284] = 0 THEN NULL&#13;&#10;ELSE ([open rate N days before (copy)_428404930130833429] - [Calculation_428404930130571284]) &#13;&#10;END' />
            </column>
            <column datatype='real' name='[ROH]' role='measure' type='quantitative' />
            <column caption='AM' datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Difference' datatype='integer' name='[date_difference]' role='measure' type='quantitative' />
            <column caption='has ROH N days after' datatype='boolean' name='[has orders c. N days after (copy)_428404930041933830]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &lt;= [Parameters].[Parameter 1] AND [date_difference] &gt;= 1 THEN [ROH] ELSE 0 END&#13;&#10;    )&#13;&#10;} &gt; 0' />
            </column>
            <column caption='has orders c. N days after' datatype='boolean' name='[has orders c. N days before (copy)_428404930030899203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &lt;= [Parameters].[Parameter 1] AND [date_difference] &gt;= 1 THEN [orders_confirmed] ELSE 0 END&#13;&#10;    )&#13;&#10;} &gt; 0' />
            </column>
            <column caption='has ROH N days before' datatype='boolean' name='[has orders c. N days before (copy)_428404930041700357]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &gt;= -[Parameters].[Parameter 1] AND [date_difference] &lt;= -1 THEN [ROH] ELSE 0 END&#13;&#10;    )&#13;&#10;} &gt; 0' />
            </column>
            <column caption='has stopped ROH N days' datatype='boolean' name='[has stopped orders c. Ndays (copy)_428404930042060807]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[has orders c. N days before (copy)_428404930041700357] AND NOT [has orders c. N days after (copy)_428404930041933830]' />
            </column>
