    <worksheet name='PREL Tickets'>
      <table>
        <view>
          <datasources>
            <datasource caption='analisis_one_migraciones (automated_tables_reports)' name='federated.1yimo6u13gzepp174jsiz1ktmjvw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Frame' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='60'>
              <calculation class='tableau' formula='60' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yimo6u13gzepp174jsiz1ktmjvw'>
            <column caption='has orders c. N days before' datatype='boolean' name='[Calculation_428404930029359106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &gt;= -[Parameters].[Parameter 1] AND [date_difference] &lt;= -1 THEN [orders_confirmed] ELSE 0 END&#13;&#10;    )&#13;&#10;} &gt; 0' />
            </column>
            <column caption='has stopped orders c. N days' datatype='boolean' name='[Calculation_428404930033917956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_428404930029359106]AND  NOT [has orders c. N days before (copy)_428404930030899203]' />
            </column>
            <column caption='last state' datatype='string' name='[Calculation_428404930048311308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] : &#13;&#10;   MAX(IF [registered_date] = &#13;&#10;           { FIXED [partner_id], [migration_date] : MAX([registered_date]) }&#13;&#10;       THEN [restaurant_state_name]&#13;&#10;   END)&#13;&#10;}' />
            </column>
            <column caption='has PREL' datatype='boolean' name='[Calculation_428404931521798169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT  ISNULL([prel_num])' />
            </column>
            <column datatype='real' name='[ROH]' role='measure' type='quantitative' />
            <column caption='AM' datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Difference' datatype='integer' name='[date_difference]' role='measure' type='quantitative' />
            <column caption='has ROH N days after' datatype='boolean' name='[has orders c. N days after (copy)_428404930041933830]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &lt;= [Parameters].[Parameter 1] AND [date_difference] &gt;= 1 THEN [ROH] ELSE 0 END&#13;&#10;    )&#13;&#10;} &gt; 0' />
            </column>
            <column caption='has orders c. N days after' datatype='boolean' name='[has orders c. N days before (copy)_428404930030899203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [migration_date] :&#13;&#10;    SUM(&#13;&#10;        IF [date_difference] &lt;= [Parameters].[Parameter 1] AND [date_difference] &gt;= 1 THEN [orders_confirmed] ELSE 0 END&#13;&#10;    )&#13;&#10;} &gt; 0' />
            </column>
