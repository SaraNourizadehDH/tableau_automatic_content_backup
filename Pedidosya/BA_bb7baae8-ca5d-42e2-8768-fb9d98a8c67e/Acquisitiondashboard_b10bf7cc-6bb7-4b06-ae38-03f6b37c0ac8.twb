    <worksheet name='Commissions by account'>
      <table>
        <view>
          <datasources>
            <datasource caption='NB&amp;WB - BQ' name='federated.0iiu6k81xlb32r127tjal088rupf' />
          </datasources>
          <datasource-dependencies datasource='federated.0iiu6k81xlb32r127tjal088rupf'>
            <column caption='Target Commission' datatype='real' name='[Calculation_1176002487306088453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(AVG([Commission target]))=TRUE THEN FLOAT(&apos; &apos;) ELSE AVG([Commission target]) END' />
            </column>
            <column caption='Restaurant ID ' datatype='real' name='[Calculation_1176002487308951558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([RestaurantId])' />
            </column>
            <column caption='Add On' datatype='string' name='[Calculation_1176002487309471751]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF isnull([add_on])=TRUE THEN &apos;Non Exclusive&apos; ELSE &apos;Exclusive&apos; END' />
            </column>
            <column caption='Key Account' datatype='string' name='[Calculation_1176002487309983752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_important_account]=TRUE THEN &apos;KA&apos; ELSE &apos;Non KA&apos; END' />
            </column>
            <column caption='Single Commission' datatype='string' name='[Calculation_120471326916354049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [singlecommission]=TRUE then &apos;Single Commission&apos; else &apos;Non single commission&apos; END' />
            </column>
            <column caption='Commission' datatype='real' name='[Calculation_673851126511980554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([last_commission]) then [commission]/100 else [last_commission]/100 END' />
            </column>
            <column caption='Floor Compliance' datatype='string' name='[Calculation_673851126512758796]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_673851126511980554]&gt;=[Commission target] then &apos;Above&apos; &#13;&#10;elseif [is_important_account]=True then &apos;KA&apos; &#13;&#10;elseif [add_on]=&apos;Exclusivity&apos; then &apos;Exclusive&apos;&#13;&#10;else &apos;Remaining&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;KA&quot;' value='Key Accounts' />
              </aliases>
            </column>
            <column caption='Escalonamiento' datatype='string' name='[Calculation_673851126598918162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [first_commission]=[last_commission] then &apos;Flat&apos; else &apos;Escalonado&apos; end' />
            </column>
            <column caption='Last Commission' datatype='real' name='[Calculation_673851126601596947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[last_commission]/100' />
            </column>
            <column caption='First Commission' datatype='real' name='[Calculation_673851126601666580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[first_commission]/100' />
            </column>
            <column caption='Actual Commission' datatype='real' name='[Calculation_673851126601723925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission]/100' />
            </column>
            <column datatype='real' name='[Commission target]' role='measure' type='quantitative' />
            <column caption='Country  ' datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[GRID]' role='dimension' type='nominal' />
            <column datatype='integer' name='[RestaurantId]' role='measure' type='quantitative' />
