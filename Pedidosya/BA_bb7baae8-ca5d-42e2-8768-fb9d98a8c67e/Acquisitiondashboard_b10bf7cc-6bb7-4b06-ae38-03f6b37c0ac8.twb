            <column datatype='date' name='Month2' ordinal='0' />
            <column datatype='string' name='Month' ordinal='1' />
            <column datatype='string' name='Country' ordinal='2' />
            <column datatype='integer' name='Total Online' ordinal='3' />
            <column datatype='integer' name='New Partners' ordinal='4' />
            <column datatype='integer' name='New Partners Assisted Sale' ordinal='5' />
            <column datatype='integer' name='New Partners Self Sign Up' ordinal='6' />
