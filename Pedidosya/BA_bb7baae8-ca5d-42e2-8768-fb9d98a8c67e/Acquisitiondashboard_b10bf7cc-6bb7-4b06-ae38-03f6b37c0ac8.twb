      <aliases enabled='yes' />
      <column datatype='string' hidden='true' name='[AccountId]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[AccountSource]' role='dimension' type='nominal' />
      <column datatype='string' hidden='true' name='[Business Type Name]' role='dimension' type='nominal' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1478306611837108228]) / TOTAL(SUM([Calculation_1478306611837108228]))'>
          <table-calc ordering-field='[federated.0iiu6k81xlb32r127tjal088rupf].[none:Calculation_1035827949141499909:nk]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='% Own Delivery MTD' datatype='real' name='[Calculation_1035827949138817028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE and [Service_type]=&apos;Logistic&apos; THEN 1  ELSE 0 END))/&#13;&#10;SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE THEN 1  ELSE 0 END)))&#13;&#10;THEN FLOAT(&apos; &apos;)&#13;&#10;ELSE&#13;&#10;SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE and [Service_type]=&apos;Logistic&apos; THEN 1  ELSE 0 END))/&#13;&#10;SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE THEN 1  ELSE 0 END))&#13;&#10;END' />
      </column>
      <column caption='Category' datatype='string' name='[Calculation_1035827949141499909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [business_type_name]=&apos;Coffee&apos; OR [business_type_name]=&apos;Restaurant&apos; THEN &apos;Food&apos; ELSE &apos;New Verticals&apos; END' />
      </column>
      <column caption='Month3' datatype='date' datatype-customized='true' hidden='true' name='[Calculation_1086211968599896064]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[Date]))' />
      </column>
      <column caption='Country ' datatype='string' name='[Calculation_1176002487297552384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Country]' />
      </column>
      <column caption='New Partners' datatype='integer' name='[Calculation_1176002487304069123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_673851126534209552])' />
      </column>
      <column caption='New Partners ' datatype='integer' name='[Calculation_1176002487304437764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([GRID])' />
      </column>
      <column caption='Target Commission' datatype='real' name='[Calculation_1176002487306088453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(AVG([Commission target]))=TRUE THEN FLOAT(&apos; &apos;) ELSE AVG([Commission target]) END' />
      </column>
      <column caption='Restaurant ID ' datatype='real' name='[Calculation_1176002487308951558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([RestaurantId])' />
      </column>
      <column caption='Add On' datatype='string' name='[Calculation_1176002487309471751]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF isnull([add_on])=TRUE THEN &apos;Non Exclusive&apos; ELSE &apos;Exclusive&apos; END' />
      </column>
      <column caption='Key Account' datatype='string' name='[Calculation_1176002487309983752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_important_account]=TRUE THEN &apos;KA&apos; ELSE &apos;Non KA&apos; END' />
