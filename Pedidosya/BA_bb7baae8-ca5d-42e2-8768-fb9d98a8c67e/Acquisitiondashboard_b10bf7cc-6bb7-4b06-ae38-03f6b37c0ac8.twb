  <worksheets>
    <worksheet name='Acquisition Business'>
      <table>
        <view>
          <datasources>
            <datasource caption='NB&amp;WB - BQ' name='federated.0iiu6k81xlb32r127tjal088rupf' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month' datatype='date' default-format='*mmmm yyyy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2021-04-01#'>
              <calculation class='tableau' formula='#2021-04-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iiu6k81xlb32r127tjal088rupf'>
            <column caption='Category' datatype='string' name='[Calculation_1035827949141499909]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [business_type_name]=&apos;Coffee&apos; OR [business_type_name]=&apos;Restaurant&apos; THEN &apos;Food&apos; ELSE &apos;New Verticals&apos; END' />
            </column>
            <column caption='Country ' datatype='string' name='[Calculation_1176002487297552384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Country]' />
            </column>
            <column caption='MTD' datatype='integer' name='[Calculation_1478306611837108228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE THEN 1  &#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[FirstMonth]' role='dimension' type='ordinal' />
            <column datatype='string' name='[GRID]' role='dimension' type='nominal' />
            <column caption='Business Name' datatype='string' name='[business_type_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1035827949141499909]' derivation='None' name='[none:Calculation_1035827949141499909:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1176002487297552384]' derivation='None' name='[none:Calculation_1176002487297552384:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
