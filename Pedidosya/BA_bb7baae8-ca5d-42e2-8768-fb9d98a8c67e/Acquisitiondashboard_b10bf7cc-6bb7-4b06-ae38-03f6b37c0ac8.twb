    <dashboard name='Commission by Account'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='22'>Commissions Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/Acquisitiondashboard-v3/CommissionbyAccount?rev=' id='CommissionbyAccount' path='/t/Pedidosya/workbooks/Acquisitiondashboard-v3' revision='' site='Pedidosya' />
      <style>
        <style-rule element='dash-title'>
          <format attr='text-align' value='center' />
        </style-rule>
      </style>
      <size maxheight='1900' maxwidth='1700' minheight='1900' minwidth='1700' sizing-mode='fixed' />
      <datasources>
        <datasource caption='NB&amp;WB - BQ' name='federated.0iiu6k81xlb32r127tjal088rupf' />
      </datasources>
      <datasource-dependencies datasource='federated.0iiu6k81xlb32r127tjal088rupf'>
        <column caption='Add On' datatype='string' name='[Calculation_1176002487309471751]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF isnull([add_on])=TRUE THEN &apos;Non Exclusive&apos; ELSE &apos;Exclusive&apos; END' />
        </column>
        <column caption='Key Account' datatype='string' name='[Calculation_1176002487309983752]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_important_account]=TRUE THEN &apos;KA&apos; ELSE &apos;Non KA&apos; END' />
        </column>
        <column caption='Floor Compliance' datatype='string' name='[Calculation_673851126512758796]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [Calculation_673851126511980554]&gt;=[Commission target] then &apos;Above&apos; &#13;&#10;elseif [is_important_account]=True then &apos;KA&apos; &#13;&#10;elseif [add_on]=&apos;Exclusivity&apos; then &apos;Exclusive&apos;&#13;&#10;else &apos;Remaining&apos;&#13;&#10;END' />
          <aliases>
            <alias key='&quot;KA&quot;' value='Key Accounts' />
          </aliases>
        </column>
        <column caption='Escalonamiento' datatype='string' name='[Calculation_673851126598918162]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [first_commission]=[last_commission] then &apos;Flat&apos; else &apos;Escalonado&apos; end' />
        </column>
        <column caption='Country  ' datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Business Name' datatype='string' name='[business_type_name]' role='dimension' type='nominal' />
        <column datatype='string' name='[dateId]' role='dimension' type='nominal' />
        <column caption='Franchise Name' datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1176002487309471751]' derivation='None' name='[none:Calculation_1176002487309471751:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1176002487309983752]' derivation='None' name='[none:Calculation_1176002487309983752:nk]' pivot='key' type='nominal' />
