          <datasource-dependencies datasource='federated.0t6mvtd0nroo5p1gqyjn60b7kf5f'>
            <column caption='StageOrder' datatype='integer' name='[Calculation_1850697991474810882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [StageName]=&apos;New&apos; THEN 1&#13;&#10;ELSEIF [StageName]=&apos;Open&apos; THEN 2&#13;&#10;ELSEIF [StageName]=&apos;Contact Established&apos; THEN 3&#13;&#10;ELSEIF [StageName]=&apos;Verbal Agreement&apos; THEN 4&#13;&#10;ELSEIF [StageName]=&apos;Quote Rejected&apos; THEN 5&#13;&#10;ELSEIF [StageName]=&apos;Approval Pending&apos; THEN 6&#13;&#10;ELSEIF [StageName]=&apos;Quote Approved&apos; THEN 7&#13;&#10;ELSEIF [StageName]=&apos;Quote Sent&apos; THEN 8&#13;&#10;ELSEIF [StageName]=&apos;Feedback Received&apos; THEN 9&#13;&#10;ELSEIF [StageName]=&apos;Please Check&apos; THEN 10&#13;&#10;ELSEIF [StageName]=&apos;Quality Check Request&apos; THEN 11&#13;&#10;ELSEIF [StageName]=&apos;Promo and Logistics Queue&apos; THEN 12&#13;&#10;ELSEIF [StageName]=&apos;Editorial Queue&apos; THEN 13&#13;&#10;ELSEIF [StageName]=&apos;Delivery Pending&apos; THEN 14&#13;&#10;ELSEIF [StageName]=&apos;Onboarding Failed&apos; THEN 15&#13;&#10;ELSEIF [StageName]=&apos;Onboarding&apos; THEN 16&#13;&#10;ELSEIF [StageName]=&apos;Closed Lost&apos; THEN 17&#13;&#10;ELSEIF [StageName]=&apos;Closed Won&apos; THEN 17&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Where' datatype='string' name='[Calculation_1850697991500300298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [StageName]=&apos;Closed Lost&apos; OR [StageName]=&apos;Closed Won&apos; THEN &apos;Closed&apos; &#13;&#10;ELSEIF [StageName]=&apos;New&apos; THEN &apos;New&apos; &#13;&#10;ELSE &apos;In Process&apos; END' />
            </column>
            <column datatype='datetime' name='[LastModifiedDate]' role='dimension' type='ordinal' />
            <_.fcp.ObjectModelTableType.false...column caption='Opportunities' datatype='integer' name='[__tableau_internal_object_id__].[CustomSQL_3C87EBB4C2D64D4982B3D6687ADE966F]' role='measure' type='quantitative' />
