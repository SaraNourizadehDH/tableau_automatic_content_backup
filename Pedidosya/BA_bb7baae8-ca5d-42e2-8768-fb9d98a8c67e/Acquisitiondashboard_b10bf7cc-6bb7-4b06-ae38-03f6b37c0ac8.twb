        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.08vrr2m0ixl3jl17g93c00ji64ka' name='Opportunities' type='text'>SELECT&#13;
  op.Id OpportunityId,&#13;
  op.closedate OpportunityClosed,&#13;
  op.Business_Type OpportunityType,&#13;
  op.OwnerId,&#13;
  u.Name OwnerName,&#13;
  op.LeadSource OpportunitySource,&#13;
  op.LastModifiedDate,&#13;
  op.CreatedDate,&#13;
  op.AccountId,&#13;
  op.StageName,&#13;
  oc.ChangeDate,&#13;
  DATE_DIFF(date(current_date),date(oc.ChangeDate),day) AgeStage,&#13;
  a.GRID,&#13;
  p.partner_id RestaurantId,&#13;
  a.AccountSource,&#13;
  a.Record_Country Country,&#13;
  (CASE&#13;
    WHEN op.Business_Type=&apos;New Business&apos; THEN p.first_date_online&#13;
    WHEN op.Business_Type=&apos;Win Back&apos; THEN op.closedate END) FirstDate&#13;
FROM&#13;
  `peya-data-origins-pro.cl_salesforce.opportunity` op&#13;
LEFT JOIN (&#13;
  SELECT&#13;
    a.Id,&#13;
    a.GRID,&#13;
    a.AccountSource,&#13;
    a.Vertical,&#13;
    a.Record_Country,&#13;
    a.Type&#13;
  FROM&#13;
    `peya-data-origins-pro.cl_salesforce.account` a) a&#13;
ON&#13;
  a.Id=op.AccountId&#13;
LEFT JOIN (&#13;
  SELECT&#13;
    u.Id,&#13;
    u.Name&#13;
  FROM&#13;
    `peya-data-origins-pro.cl_salesforce.user` u) u&#13;
ON&#13;
  u.Id=op.OwnerId&#13;
LEFT JOIN (&#13;
  SELECT&#13;
    p.partner_id,&#13;
    p.salesforce_id,&#13;
    p.first_date_online,&#13;
    p.partner_name&#13;
  FROM `peya-bi-tools-pro.il_core.dim_partner`&#13;
     p) p&#13;
ON&#13;
  p.salesforce_id=a.GRID&#13;
  &#13;
LEFT JOIN &#13;
(SELECT OpportunityId,&#13;
        MAX(DATETIME(CreatedDate)) as ChangeDate&#13;
FROM `peya-data-origins-pro.cl_salesforce.opportunity_field_changes` &#13;
WHERE Field=&apos;StageName&apos;&#13;
GROUP BY OpportunityId) oc&#13;
ON oc.OpportunityId = op.Id&#13;
  &#13;
WHERE&#13;
  DATE(op.lastmodifieddate) &gt;&gt; DATE_ADD(CURRENT_DATE(), INTERVAL -4 month)&#13;
  AND op.Business_Type IN (&apos;New Business&apos;,&#13;
    &apos;Win Back&apos;)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
