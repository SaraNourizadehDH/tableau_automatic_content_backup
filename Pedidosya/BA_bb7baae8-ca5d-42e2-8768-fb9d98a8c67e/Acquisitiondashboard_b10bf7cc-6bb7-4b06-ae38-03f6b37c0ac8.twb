          <datasource-dependencies datasource='Parameters'>
            <column caption='Month' datatype='date' default-format='*mmmm yyyy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2021-04-01#'>
              <calculation class='tableau' formula='#2021-04-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iiu6k81xlb32r127tjal088rupf'>
            <column caption='% Own Delivery MTD' datatype='real' name='[Calculation_1035827949138817028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE and [Service_type]=&apos;Logistic&apos; THEN 1  ELSE 0 END))/&#13;&#10;SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE THEN 1  ELSE 0 END)))&#13;&#10;THEN FLOAT(&apos; &apos;)&#13;&#10;ELSE&#13;&#10;SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE and [Service_type]=&apos;Logistic&apos; THEN 1  ELSE 0 END))/&#13;&#10;SUM((IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE THEN 1  ELSE 0 END))&#13;&#10;END' />
            </column>
            <column caption='Country ' datatype='string' name='[Calculation_1176002487297552384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Country]' />
            </column>
            <column caption='Country   ' datatype='string' name='[Calculation_1176002487313555465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1176002487297552384])=FALSE THEN &apos;LATAM&apos; END' />
            </column>
            <column caption='MTD' datatype='integer' name='[Calculation_1478306611837108228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FirstMonth])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstMonth])=MONTH([Parameters].[Parameter 1]) and isnull([GRID])=FALSE THEN 1  &#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Remaining Days' datatype='integer' name='[Calculation_1478306611900985355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,[Date])=1 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=2 THEN 28&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=3 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=4 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=5 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=6 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=7 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=8 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=9 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=10 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=11 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=12 THEN 31&#13;&#10;END' />
            </column>
            <column caption='Projected' datatype='integer' name='[Calculation_1478306611909787660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR(today())=YEAR([Parameters].[Parameter 1]) AND MONTH(TODAY())=MONTH([Parameters].[Parameter 1]) THEN&#13;&#10;COUNTD(IF [FirstDate]&lt;TODAY() AND [FirstDate]&gt;=DATEADD(&apos;day&apos;,-[Calculation_1478306611900985355],TODAY()) THEN [OpportunityId] END)&#13;&#10;ELSE COUNTD(IF YEAR([FirstDate])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstDate])=MONTH([Parameters].[Parameter 1]) THEN [OpportunityId] END)&#13;&#10;END' />
            </column>
            <column caption='Compliance' datatype='real' name='[Calculation_1478306611910447117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1478306611909787660]/SUM([MTD (copy)_1478306611840126982])) THEN 0 ELSE [Calculation_1478306611909787660]/SUM([MTD (copy)_1478306611840126982]) END' />
            </column>
            <column caption='LY' datatype='integer' name='[Calculation_1478306611912880143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([FirstDate])=YEAR(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) AND MONTH([FirstDate])=MONTH([Parameters].[Parameter 1]) AND ISNULL([GRID])=FALSE THEN 1 ELSE 0 END)' />
            </column>
            <column caption='LM' datatype='integer' name='[Calculation_1478306611923607571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([FirstDate])=YEAR(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])) AND MONTH(FirstDate)=MONTH(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])) THEN [OpportunityId]&#13;&#10;END)' />
            </column>
            <column caption='LM&apos;s MTD' datatype='integer' name='[Calculation_1478306611925418005]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF MONTH([Parameters].[Parameter 1])=MONTH(TODAY()) AND YEAR([Parameters].[Parameter 1])=YEAR(TODAY()) THEN &#13;&#10;COUNTD(IF YEAR([FirstDate])=YEAR(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])) AND MONTH([FirstDate])=MONTH(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])) AND DATEPART(&apos;day&apos;,[FirstDate])&lt;=DAY(TODAY()) THEN [OpportunityId] END)&#13;&#10;ELSE COUNTD(IF YEAR([FirstDate])=YEAR(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])) AND MONTH([FirstDate])=MONTH(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])) THEN [OpportunityId] END)&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Projected VS LM' datatype='real' name='[Compliance (copy)_1478306611927609367]' role='measure' type='quantitative'>
