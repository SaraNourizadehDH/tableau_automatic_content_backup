        p.singlecommission,&#13;
        p.business_type.business_type_name,&#13;
        (case when (p.business_type.business_type_name = &apos;Restaurant&apos; or p.business_type.business_type_name = &apos;Coffee&apos;) then &apos;Food&apos; else &apos;New Verticals&apos; end) as Category,&#13;
        p.salesforce_id,&#13;
        p.partner_name,&#13;
        p.kitchen_id,&#13;
        p.concept_id,&#13;
        p.franchise_id,&#13;
        p.franchise_name,&#13;
        p.is_important_account,&#13;
        p.Country,&#13;
        case when p.Country = &apos;Dominican Republic&apos; then &apos;República Dominicana&apos; when p.Country=&apos;Panama&apos; then &apos;Panamá&apos; when p.Country =&apos;Perú&apos; then &apos;Perú&apos; else p.Country end as Country_Name,&#13;
        case when p.is_logistic=True then &apos;Logistic&apos; else &apos;Marketplace&apos; end as Service_type,&#13;
        p.City,&#13;
        p.is_logistic,&#13;
        concat(extract(year from op.closedate), case when length(cast(extract(month from op.closedate) as string))=1 then &apos;0&apos; else &apos;&apos; end, extract(month from op.closedate), &apos;01&apos;) as dateId,&#13;
        l_com.add_on&#13;
FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op&#13;
LEFT JOIN (SELECT a.Id,&#13;
                  a.GRID,&#13;
                  a.AccountSource,&#13;
                  a.Vertical,&#13;
                  a.Record_Country,&#13;
                  a.Type&#13;
            FROM `peya-data-origins-pro.cl_salesforce.account` a) a&#13;
ON a.Id=op.AccountId&#13;
LEFT JOIN (SELECT u.Id,&#13;
                  u.Name&#13;
            FROM `peya-data-origins-pro.cl_salesforce.user` u) u&#13;
ON u.Id=op.OwnerId&#13;
LEFT JOIN (SELECT   p.country.country_id,&#13;
                    p.business_type,&#13;
                    p.partner_id,&#13;
                    p.salesforce_id,&#13;
                    p.partner_name,&#13;
                    p.first_date_online,&#13;
                    p.kitchen.kitchen_id,&#13;
                    p.concept.concept_id,&#13;
                    p.franchise.franchise_id,&#13;
                    p.franchise.franchise_name,&#13;
                    p.is_important_account,&#13;
                    p.country.country_name_en as Country,&#13;
                    p.city.name as City,&#13;
                    p.is_logistic,&#13;
                    p.business_type.business_type_name,&#13;
                    p.billingInfo.single_commission as singlecommission,&#13;
                    (p.billingInfo.partner_commission + case p.country_id when 18 then p.billingInfo.logistics_commission when 8 then p.billingInfo.logistics_commission when 6 then p.billingInfo.logistics_commission else 0 end) as commission&#13;
            FROM `peya-bi-tools-pro.il_core.dim_partner` p) p&#13;
ON p.salesforce_id=a.GRID&#13;
LEFT JOIN (SELECT   p1.id,&#13;
                    p1.useliveordertracking as is_logistic&#13;
            FROM `peya-data-origins-pro.cl_core.partner` p1) p1&#13;
ON p1.id=p.partner_id            &#13;
LEFT JOIN (SELECT  oportunity_unique_id,&#13;
                    grid,  &#13;
                    closed_date, &#13;
                    o.account_id,  &#13;
                    com.commission first_commission, &#13;
                    com.startdate, &#13;
                    country_name, &#13;
                    add_on  &#13;
            FROM `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` o&#13;
            INNER JOIN (SELECT account_id, &#13;
                                MIN(closed_date) first_closed_date &#13;
                        FROM `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2`&#13;
                        GROUP BY account_id) lo&#13;
            ON o.account_id=lo.account_id AND first_closed_date=o.closed_date&#13;
            INNER JOIN (SELECT sc.id_opportunity, &#13;
                                CASE co.country_id WHEN 18 THEN SUM(commission) WHEN 8 THEN SUM(commission) WHEN 6 THEN SUM(commission) ELSE AVG(commission) END commission, &#13;
                                startdate, &#13;
                                country_id &#13;
                        FROM `peya-data-origins-pro.cl_salesforce.contract` sc&#13;
                        INNER JOIN   (select id_opportunity, &#13;
                                            MIN(startdate) first_start_date &#13;
                                        FROM `peya-data-origins-pro.cl_salesforce.contract`&#13;
                                        GROUP BY id_opportunity) lc&#13;
                        ON sc.id_opportunity=lc.id_opportunity AND sc.startdate=lc.first_start_date&#13;
                        LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` co&#13;
                        ON sc.id_opportunity=co.oportunity_unique_id&#13;
                        GROUP BY sc.id_opportunity,startdate, country_id ) com&#13;
            ON  com.id_opportunity=o.oportunity_unique_id ) f_com&#13;
ON f_com.oportunity_unique_id=op.Id            &#13;
LEFT JOIN (SELECT  oportunity_unique_id,&#13;
                    grid,  &#13;
                    closed_date, &#13;
                    o.account_id,  &#13;
                    com.commission last_commission, &#13;
                    com.startdate, &#13;
                    country_name, &#13;
                    add_on  &#13;
            FROM `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` o&#13;
            INNER JOIN (SELECT account_id, &#13;
                                MAX(closed_date) first_closed_date &#13;
                        FROM `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2`&#13;
                        GROUP BY account_id) lo&#13;
            ON o.account_id=lo.account_id AND first_closed_date=o.closed_date&#13;
            INNER JOIN (SELECT sc.id_opportunity, &#13;
                                CASE co.country_id WHEN 18 THEN SUM(commission) WHEN 8 THEN SUM(commission) WHEN 6 THEN SUM(commission) ElSE AVG(commission) END commission, &#13;
                                startdate, &#13;
                                country_id &#13;
                        FROM `peya-data-origins-pro.cl_salesforce.contract` sc&#13;
                        INNER JOIN   (select id_opportunity, &#13;
                                            MAX(startdate) first_start_date &#13;
                                        FROM `peya-data-origins-pro.cl_salesforce.contract`&#13;
                                        GROUP BY id_opportunity) lc&#13;
                        ON sc.id_opportunity=lc.id_opportunity AND sc.startdate=lc.first_start_date&#13;
                        LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` co&#13;
                        ON sc.id_opportunity=co.oportunity_unique_id&#13;
                        GROUP BY sc.id_opportunity,startdate, country_id ) com&#13;
            ON  com.id_opportunity=o.oportunity_unique_id ) l_com&#13;
ON l_com.oportunity_unique_id=op.Id&#13;
WHERE DATE(op.closedate) BETWEEN DATE(&apos;2021-05-01&apos;) AND DATE(&apos;2021-09-07&apos;)&#13;
AND op.StageName=&apos;Closed Won&apos;&#13;
AND op.Business_Type IN (&apos;New Business&apos;,&apos;Win Back&apos;)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
