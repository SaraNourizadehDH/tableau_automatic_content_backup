              <table-calc ordering-field='[federated.0iiu6k81xlb32r127tjal088rupf].[none:Calculation_1035827949141499909:nk]' ordering-type='Field' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <natural-sort column='[federated.0iiu6k81xlb32r127tjal088rupf].[none:Calculation_1035827949141499909:nk]' direction='DESC' />
          <filter class='categorical' column='[federated.0iiu6k81xlb32r127tjal088rupf].[none:Category:nk]' filter-group='5'>
            <groupfilter function='level-members' level='[none:Category:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
