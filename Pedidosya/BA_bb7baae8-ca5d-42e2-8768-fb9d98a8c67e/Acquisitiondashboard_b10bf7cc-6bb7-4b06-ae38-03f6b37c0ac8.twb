            <column caption='Remaining Days' datatype='integer' name='[Calculation_1478306611900985355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;,[Date])=1 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=2 THEN 28&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=3 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=4 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=5 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=6 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=7 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=8 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=9 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=10 THEN 31&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=11 THEN 30&#13;&#10;ELSEIF DATEPART(&apos;month&apos;,[Date])=12 THEN 31&#13;&#10;END' />
            </column>
            <column caption='Projected' datatype='integer' name='[Calculation_1478306611909787660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR(today())=YEAR([Parameters].[Parameter 1]) AND MONTH(TODAY())=MONTH([Parameters].[Parameter 1]) THEN&#13;&#10;COUNTD(IF [FirstDate]&lt;TODAY() AND [FirstDate]&gt;=DATEADD(&apos;day&apos;,-[Calculation_1478306611900985355],TODAY()) THEN [OpportunityId] END)&#13;&#10;ELSE COUNTD(IF YEAR([FirstDate])=YEAR([Parameters].[Parameter 1]) AND MONTH([FirstDate])=MONTH([Parameters].[Parameter 1]) THEN [OpportunityId] END)&#13;&#10;END' />
            </column>
            <column caption='Compliance' datatype='real' name='[Calculation_1478306611910447117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1478306611909787660]/SUM([MTD (copy)_1478306611840126982])) THEN 0 ELSE [Calculation_1478306611909787660]/SUM([MTD (copy)_1478306611840126982]) END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
