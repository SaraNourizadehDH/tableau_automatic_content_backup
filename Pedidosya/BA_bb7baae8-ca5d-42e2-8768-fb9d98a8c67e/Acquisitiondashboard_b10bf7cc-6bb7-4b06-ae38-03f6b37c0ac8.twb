          <filter class='categorical' column='[federated.0iiu6k81xlb32r127tjal088rupf].[none:Country:nk]' filter-group='3'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter from='&quot;Argentina&quot;' function='range' level='[none:Country:nk]' to='&quot;Chile&quot;' />
              <groupfilter from='&quot;Costa Rica&quot;' function='range' level='[none:Country:nk]' to='&quot;Venezuela&quot;' />
