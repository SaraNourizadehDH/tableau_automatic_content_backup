      <aliases enabled='yes' />
      <column caption='% Low Orders' datatype='real' name='[Calculation_284571220626874368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_low_order])/COUNTD([partner_id])' />
      </column>
      <column caption='FR' datatype='real' name='[Calculation_284571220627324929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fr_orders])/SUM([total_orders])' />
      </column>
      <column caption='VFR' datatype='real' name='[Calculation_284571220627423234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vfr_orders])/SUM([total_orders])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_284571220628226052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv])/SUM([confirmed_orders])' />
      </column>
      <column caption='OT' datatype='real' name='[Calculation_284571220628516869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([real_open_time])/SUM([schedule_open_time])' />
      </column>
      <column caption='Online Partners' datatype='integer' name='[Calculation_284571220628656134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id])' />
      </column>
      <column caption='ZR' datatype='real' name='[Calculation_284571220628914183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_zombie])/COUNTD([partner_id])' />
      </column>
      <column caption='Over 30' datatype='real' name='[Calculation_284571220629340168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_high_order])/COUNTD([partner_id])' />
      </column>
      <column caption='Pics' datatype='real' name='[Calculation_284571220629528585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_products_w_pics])/SUM([active_products])' />
      </column>
      <column caption='VFD' datatype='real' name='[Calculation_284571220629663754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([real_discount])/(SUM([gmv_gross])/AVG([rate_eu]))' />
      </column>
      <column caption='Ads/GMV' datatype='real' name='[Calculation_284571220629811211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ncr_neto])/SUM([gmv])' />
      </column>
      <column caption='NCR Rev' datatype='real' name='[Calculation_284571220630011916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ncr_neto])/AVG([rate_eu])' />
      </column>
      <column caption='FLGPO' datatype='real' name='[Calculation_284571220630229005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgp])/SUM([confirmed_orders])' />
      </column>
      <column caption='roh_m' datatype='real' name='[Calculation_284571220630667278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[real_open_time]/60' />
      </column>
      <column caption='ROH &gt;= 120' datatype='real' name='[Calculation_284571220630753295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Calculation_284571220630667278] &gt;= 120 THEN [partner_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([partner_id])' />
      </column>
      <column caption='AVG ROH' datatype='real' name='[Calculation_284571220631543824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_284571220630667278])/COUNTD([partner_id])' />
      </column>
      <column caption='VFD PP' datatype='real' name='[Calculation_284571220641718289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vfd_partner])/SUM([is_active])' />
      </column>
      <column caption='NCR PP' datatype='real' name='[Calculation_284571220641841170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ncr_partner])/SUM([is_active])' />
      </column>
      <column caption='Data up to:' datatype='string' name='[Calculation_284571220875546643]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&apos;Data up to:&apos; + STR(MAX([data_up_to]))' />
      </column>
