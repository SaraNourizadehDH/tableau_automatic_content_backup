            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='automated_tables_reports' server-oauth='' username='federico.gil@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18siz640ff7cs31ex82bq1ymnml6' name='Consulta SQL personalizada' type='text'><![CDATA[select *
from (
select month
        ,partner_id
        ,partner_status
        ,country
        ,segmentation
        ,confirmed_orders
        ,AVG_CONFIRMED_ORDERS_L2M
        ,AVG_CONFIRMED_ORDERS_L3M
        ,CONFIRMED_ORDERS_L2M
        ,CONFIRMED_ORDERS_L3M
        ,case when Orders_levels_30 = Orders_levels_60 then 'Mismo nivel'
                when Orders_levels_30 >> Orders_levels_60 then 'Sube nivel'
                when Orders_levels_30 << Orders_levels_60 then 'Cae nivel'
                else 'check' end as orders_level_30vs60
        ,case when Orders_levels_60 = Orders_levels_90 then 'Mismo nivel'
                when Orders_levels_60 >> Orders_levels_90 then 'Sube nivel'
                when Orders_levels_60 << Orders_levels_90 then 'Cae nivel'
                else 'check' end as orders_level_60vs90
        ,case when Orders_levels_30 = Orders_levels_90 then 'Mismo nivel'
                when Orders_levels_30 >> Orders_levels_90 then 'Sube nivel'
                when Orders_levels_30 << Orders_levels_90 then 'Cae nivel'
                else 'check' end as orders_level_30vs90
        ,Orders_levels_30
        ,Orders_levels_60
        ,Orders_levels_90
        ,non_confirmed_orders
        ,AVG_NON_CONFIRMED_ORDERS_L2M
        ,AVG_NON_CONFIRMED_ORDERS_L3M
        ,NON_CONFIRMED_ORDERS_L2M
        ,NON_CONFIRMED_ORDERS_L3M
        ,total_orders_all_status
        ,AVG_TOTAL_ORDERS_L2M
        ,AVG_TOTAL_ORDERS_L3M
	,TOTAL_ORDERS_L2M
        ,TOTAL_ORDERS_L3M
        ,vfr
        ,AVG_VFR_L2M
        ,AVG_VFR_L3M
        ,round(((IEEE_DIVIDE(vfr,AVG_VFR_L2M)-1)*100),1) as delta_percentage_vfr_30vs60
        ,round(((IEEE_DIVIDE(AVG_VFR_L2M,AVG_VFR_L3M)-1)*100),1) as delta_percentage_vfr_60vs90
        ,round(((IEEE_DIVIDE(vfr,AVG_VFR_L3M)-1)*100),1) as delta_percentage_vfr_30vs90
        ,case when VFR_levels_30 = VFR_levels_60 then 'Mismo nivel'
                when VFR_levels_30 >> VFR_levels_60 then 'Sube nivel'
                when VFR_levels_30 << VFR_levels_60 then 'Cae nivel'
                else 'check' end as VFR_level_30vs60
        ,case when VFR_levels_60 = VFR_levels_90 then 'Mismo nivel'
                when VFR_levels_60 >> VFR_levels_90 then 'Sube nivel'
                when VFR_levels_60 << VFR_levels_90 then 'Cae nivel'
                else 'check' end as VFR_level_60vs90
        ,case when VFR_levels_30 = VFR_levels_90 then 'Mismo nivel'
                when VFR_levels_30 >> VFR_levels_90 then 'Sube nivel'
                when VFR_levels_30 << VFR_levels_90 then 'Cae nivel'
                else 'check' end as VFR_level_30vs90
        ,VFR_levels_30
        ,VFR_levels_60
        ,VFR_levels_90
	,General_level_30
	,General_level_60
	,General_level_90
from `peya-food-and-groceries.automated_tables_reports.vendor_engagement_metrics_and_levels_30_60_90`
WHERE partner_status = 'ON_LINE'
        and q_days_from_first_date_online >>= 45
        and segmentation in ('A','B','C','D','Local Hero','Sin segmentar')
        and month >>= '2023-01-01'
)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
