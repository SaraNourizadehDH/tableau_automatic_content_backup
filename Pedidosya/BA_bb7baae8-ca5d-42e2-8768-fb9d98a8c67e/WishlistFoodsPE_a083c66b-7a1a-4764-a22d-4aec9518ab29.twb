      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='amelia_custom' id='_444D733697E44BD2B01859A0E4B9F6FF'>
            <properties context=''>
              <relation connection='bigquery.18bi2d30zsa7op1f473af0myffv3' name='Consulta SQL personalizada' type='text'>WITH promo_data AS (&#13;
    SELECT&#13;
        registered_date,&#13;
        fecha_inicio_promo,&#13;
        fecha_fin_promo,&#13;
        commission_rate,&#13;
        manager,&#13;
        team_leader,&#13;
        account_owner,&#13;
        cartera,&#13;
        city,&#13;
        partner_id,&#13;
        partner_name,&#13;
        brand_name,&#13;
        main_cousine,&#13;
        product_id,&#13;
        product_name,&#13;
        product_actual_price,&#13;
        paid_by_peya,&#13;
        paid_by_others,&#13;
        type_promo,&#13;
        confirmed_orders,&#13;
        rejected_orders,&#13;
        AVG(promo_dias) AS promo_dias&#13;
    FROM&#13;
        `peya-peru.automated_tables_reports.product_detail_foods_looker`&#13;
    WHERE&#13;
        DATE_TRUNC(registered_date, MONTH) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)&#13;
    GROUP BY&#13;
        registered_date, fecha_inicio_promo, fecha_fin_promo, commission_rate, manager,&#13;
        team_leader, account_owner, cartera, city, partner_id, partner_name,&#13;
        brand_name, main_cousine, product_id, product_name, product_actual_price,&#13;
        paid_by_peya, paid_by_others, type_promo, confirmed_orders, rejected_orders&#13;
),&#13;
promo_ranked AS (&#13;
    SELECT&#13;
        *,&#13;
        ROW_NUMBER() OVER (&#13;
            PARTITION BY &#13;
                city, brand_name, product_name,&#13;
                fecha_inicio_promo, fecha_fin_promo &#13;
            ORDER BY registered_date&#13;
        ) AS row_num&#13;
    FROM promo_data&#13;
),&#13;
exchange_rate AS (&#13;
    SELECT &#13;
        DATE_TRUNC(PARSE_DATE(&apos;%Y%m%d&apos;, CAST(date_id AS STRING)), MONTH) AS rate_month,&#13;
        rate&#13;
    FROM `peya-data-origins-pro.cl_core.currency_exchange_us`&#13;
    WHERE &#13;
        currency_id = 7&#13;
        AND DATE_TRUNC(PARSE_DATE(&apos;%Y%m%d&apos;, CAST(date_id AS STRING)), MONTH) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 3 MONTH)&#13;
)&#13;
&#13;
SELECT&#13;
    pr.registered_date,&#13;
    pr.fecha_inicio_promo,&#13;
    pr.fecha_fin_promo,&#13;
    pr.commission_rate,&#13;
    pr.manager,&#13;
    pr.team_leader,&#13;
    pr.account_owner,&#13;
    pr.cartera,&#13;
    pr.city,&#13;
    pr.partner_id,&#13;
    pr.partner_name,&#13;
    pr.brand_name,&#13;
    pr.main_cousine,&#13;
    pr.product_id,&#13;
    pr.product_name,&#13;
    pr.product_actual_price,&#13;
    pr.paid_by_peya,&#13;
    pr.paid_by_others,&#13;
    pr.type_promo,&#13;
    IF(pr.row_num = 1, pr.promo_dias, 0) AS promo_dias,&#13;
    pr.confirmed_orders,&#13;
    pr.rejected_orders,&#13;
    er.rate AS exchange_rate -- Añadimos la tasa de cambio correspondiente al mes&#13;
FROM promo_ranked pr&#13;
LEFT JOIN exchange_rate er &#13;
    ON DATE_TRUNC(pr.registered_date, MONTH) = er.rate_month -- Emparejamos por mes de registered_date</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
