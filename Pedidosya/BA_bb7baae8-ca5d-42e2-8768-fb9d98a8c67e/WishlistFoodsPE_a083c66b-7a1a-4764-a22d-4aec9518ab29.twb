              <calculation class='tableau' formula='[commission_rate]/100' />
            </column>
            <column caption='S/ Spent' datatype='real' name='[Calculation_941815274949656577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((avg(paid_by_peya)*COUNTD(confirmed_orders))*(1-AVG([Calculation_941815274949496832])))/1.18' />
            </column>
            <column caption='$ Spent' datatype='real' name='[Calculation_941815274949910530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((avg(paid_by_peya)*COUNTD(confirmed_orders))*(1-AVG([Calculation_941815274949496832])))/1.18)/AVG([exchange_rate])' />
            </column>
            <column caption='S/ Spent Daily' datatype='real' name='[Calculation_941815274950135811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((avg(paid_by_peya)*COUNTD(confirmed_orders))*(1-AVG([Calculation_941815274949496832])))/1.18)/SUM([promo_dias])' />
            </column>
            <column caption='$ Spent Daily' datatype='real' name='[Calculation_941815274950369285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((((avg(paid_by_peya)*COUNTD(confirmed_orders))*(1-AVG([Calculation_941815274949496832])))/1.18)/AVG([exchange_rate]))/SUM([promo_dias])' />
            </column>
            <column caption='CPiO' datatype='real' name='[Calculation_941815274950582278]' role='measure' type='quantitative'>
