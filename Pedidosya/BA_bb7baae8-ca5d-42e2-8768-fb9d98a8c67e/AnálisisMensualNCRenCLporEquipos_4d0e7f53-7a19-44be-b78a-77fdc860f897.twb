      <aliases enabled='yes' />
      <column caption='Account Owner' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
      <column caption='Area Equipo' datatype='string' name='[Area_Equipo]' role='dimension' type='nominal' />
      <column caption='# Partners' datatype='integer' name='[Calculation_1675620550423564289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([dim_partner_partner_id])' />
      </column>
      <column caption='CVR3' datatype='real' name='[Calculation_1675620550429364226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([agg_fact_sessions_by_partner_daily_qty_unique_orders])/SUM([agg_fact_sessions_by_partner_daily_qty_sessions])' />
      </column>
      <column caption='% OT' datatype='real' name='[Calculation_1675620550429503491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dim_historical_partners_real_open_time])/SUM([dim_historical_partners_sum_schedule_open_time])' />
      </column>
      <column caption='% Pics' datatype='real' name='[Calculation_1675620550429577220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dim_partner_qty_picts_total])/SUM([dim_partner_qty_products_total])' />
      </column>
      <column caption='Tier Editadas' datatype='string' name='[Calculation_1675620550430638086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Account_Owner] = &quot;Felipe García&quot; OR&#13;&#10;[Account_Owner] = &quot;Paulina Rocco&quot; OR&#13;&#10;[Tier] = &quot;Norte&quot;&#13;&#10;OR [Tier] = &quot;TL&quot;) AND [Area_Equipo] = &quot;AS&quot;&#13;&#10; THEN &quot;T2&quot;&#13;&#10;ELSEIF [Tier] = &quot;Growth T1&quot;&#13;&#10;Then &quot;T1&quot;&#13;&#10;ELSEIF [Equipo_Especifico] = &quot;Terreno&quot; OR&#13;&#10;[Equipo_Especifico] = &quot;Business Developer&quot; OR &#13;&#10;[Equipo_Especifico] = &quot;SSU&quot; OR &#13;&#10;[Equipo_Especifico] = &quot;Practicante LT&quot;&#13;&#10;THEN [Equipo_Especifico]&#13;&#10;ELSEIF ISNULL([Area_Equipo])&#13;&#10;THEN &quot;Ejecutivos Antiguos&quot;&#13;&#10; ELSE [Tier] END' />
      </column>
      <column caption='Sesiones por Partner' datatype='real' name='[Calculation_1675620550739189767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([agg_fact_sessions_by_partner_daily_qty_sessions])/[Calculation_1675620550423564289]' />
      </column>
      <column caption='# Franquicias' datatype='integer' name='[Calculation_6685241817535430656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Franchise])' />
      </column>
      <column caption='Check NCR' datatype='boolean' name='[Check_NCR]' role='dimension' type='nominal' />
      <column caption='Equipo Especifico' datatype='string' name='[Equipo_Especifico]' role='dimension' type='nominal' />
      <column caption='Ordenes por Partner' datatype='real' name='[Sesiones por Partner (copia)_1675620550739451912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fact_orders_total_confirmed_orders])/[Calculation_1675620550423564289]' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='NCR_Data_Abril' datatype='table' name='[__tableau_internal_object_id__].[NCR_Data_Abril_84929559DA244693AC5F1BF76A87ED01]' role='measure' type='quantitative' />
