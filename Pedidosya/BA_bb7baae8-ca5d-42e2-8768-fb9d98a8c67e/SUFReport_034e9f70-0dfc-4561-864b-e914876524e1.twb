        <objects>
          <object caption='Sheet1' id='Sheet1_7D5D2DEA72C143C1AE4F19FA9C36F77A'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.1lr75140m49ddr19mdrdm0842es8' name='Sheet1' table='[Sheet1$]' type='table'>
                <columns gridOrigin='A1:C16:no:A1:C16:0' header='yes' outcome='2'>
