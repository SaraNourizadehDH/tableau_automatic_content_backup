      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.09tf08o08w1h7n1a0iaps0pgnvoq].[sum:q_partners:qk]&quot;' value='Q Partners' />
          <alias key='&quot;[federated.09tf08o08w1h7n1a0iaps0pgnvoq].[sum:SUF_price_actual_lc:qk]&quot;' value='SUF Price Rev' />
          <alias key='&quot;[federated.09tf08o08w1h7n1a0iaps0pgnvoq].[usr:Calculation_1186417073441267714:qk]&quot;' value='Full Price Penet %' />
        </aliases>
      </column>
      <column caption='Fee Penet %' datatype='real' name='[Calculation_1186417073440215040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([w_fee])/sum([q_partners])' />
      </column>
      <column caption='Full Price' datatype='integer' name='[Calculation_1186417073441091585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [SUF_price_actual_lc] &gt;= [target_price_suf] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Full Price Penet' datatype='real' name='[Calculation_1186417073441267714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1186417073441091585]) / sum([q_partners])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1186417073441472515]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [last_first_day_online] &gt;= [first_date_online] THEN [last_first_day_online] ELSE [first_date_online] END' />
      </column>
      <column caption='Q Partners' datatype='integer' name='[Calculation_1186417073445412868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([q_partners])' />
      </column>
      <column caption='Avg. Price' datatype='real' name='[Calculation_1186417073503207429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([SUF_price_actual_lc]) / sum([w_fee])' />
      </column>
