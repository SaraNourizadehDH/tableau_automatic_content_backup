        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1igtij91mqqdfo11o7m470cf70fm' name='Consulta SQL personalizada' type='text'>SELECT &#13;
  partner_id,&#13;
  partner_name,&#13;
  salesforce_id,&#13;
  country_id,&#13;
  CASE WHEN product IN (&apos;Setup fee&apos;, &apos;Setup Fee&apos;) THEN COALESCE(pos_price_actual_lc,0) END SUF_price_actual_lc, &#13;
    IF (last_first_day_online IS NULL, (IF((EXTRACT(YEAR FROM first_date_online) = EXTRACT(YEAR FROM CURRENT_DATE) AND EXTRACT(MONTH FROM first_date_online)= EXTRACT(MONTH FROM CURRENT_DATE)), &apos;New&apos;,&apos;Existing&apos;)), IF((EXTRACT(YEAR FROM last_first_day_online) =EXTRACT(YEAR FROM CURRENT_DATE) AND EXTRACT(MONTH FROM last_first_day_online)= EXTRACT(MONTH FROM CURRENT_DATE)), &apos;New&apos;,&apos;Existing&apos;)) partner_type,&#13;
  IF (last_first_day_online IS NULL, (IF(EXTRACT(YEAR FROM first_date_online) = EXTRACT(YEAR FROM CURRENT_DATE), CONCAT(&apos;New Since Month #&apos;,&apos; &apos;,EXTRACT(MONTH FROM first_date_online)),&apos;Exisiting&apos;)),(IF(EXTRACT(YEAR FROM last_first_day_online)= EXTRACT(YEAR FROM CURRENT_DATE), CONCAT(&apos;New Since Month #&apos;,&apos; &apos;,EXTRACT(MONTH FROM last_first_day_online)), &apos;Existing&apos;))) partner_sub_type,&#13;
  business_type_name,&#13;
  first_date_online,&#13;
  last_first_day_online,&#13;
  country_name,&#13;
  Key_Account_Sub_Category  ,&#13;
  1 as q_partners,&#13;
  if (CASE WHEN product IN (&apos;Setup fee&apos;, &apos;Setup Fee&apos;) THEN COALESCE(pos_price_actual_lc,0) END &gt;&gt;0 , 1, 0) w_fee,&#13;
    FROM (&#13;
      SELECT&#13;
        DISTINCT dp.partner_id,&#13;
        dp.country_id,&#13;
        DENSE_RANK() OVER (PARTITION BY partner_id ORDER BY ad.Start_Date DESC) rn,&#13;
        ad.Product as product,&#13;
        ad.Status,&#13;
        ad.Listed_Price as pos_full_price_lc,&#13;
        ad.Total_Amount as pos_price_actual_lc,&#13;
        ad.CurrencyIsoCode,&#13;
        ad.Start_Date start_date,&#13;
        ad.Termination_Date,&#13;
        dp.salesforce_id,&#13;
        dp.business_type.business_type_name,&#13;
        dp.first_date_online,&#13;
        dp.last_first_day_online,&#13;
        dp.country.country_name,&#13;
        dp.partner_name,&#13;
        CASE WHEN sf.Key_Account_Sub_Category IS NULL THEN CONCAT (&quot;Long Tail&quot;,&quot; &quot;, COALESCE(SUBSTRING(sf.Long_Tail_Segmentation,1,1),&quot;No Segment&quot;) ) ELSE sf.Key_Account_Sub_Category END Key_Account_Sub_Category,&#13;
      FROM `peya-data-origins-pro.cl_salesforce.additional_charges` ad&#13;
      LEFT JOIN `peya-bi-tools-pro.il_salesforce.dim_salesforce_account` sf&#13;
      ON sf.account_id = ad.id_Account &#13;
      LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp&#13;
      ON dp.salesforce_id = sf.account_grid&#13;
      WHERE ad.Product IN (&apos;Setup fee&apos;, &apos;Setup Fee&apos;)&#13;
      AND  ad.Status =&apos;Active&apos;&#13;
      AND dp.is_darkstore IS FALSE&#13;
      AND dp.is_kitchen IS FALSE&#13;
      AND dp.is_concept IS FALSE&#13;
      AND dp.partner_status = &apos;ON_LINE&apos;&#13;
      AND dp.business_type.business_type_name NOT IN (&apos;Courier&apos;,&apos;Courier Business&apos;,&apos;Bills&apos;)&#13;
      ORDER BY 1,ad.Start_Date DESC&#13;
    )&#13;
WHERE rn=1</relation>
