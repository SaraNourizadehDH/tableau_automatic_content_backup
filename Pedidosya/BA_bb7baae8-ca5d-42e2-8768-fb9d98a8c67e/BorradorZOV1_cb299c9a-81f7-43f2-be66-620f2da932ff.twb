        <objects>
          <object caption='Consulta SQL personalizada' id='_EEFB6813B50A43D8BE6F21E21F3915E9'>
            <properties context=''>
              <relation connection='bigquery.1cawbeh0t98gsh1gvjzb00cz4drn' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    dim_partner_partner_name,
    dim_area_area_name,
    dim_partner_main_cousine_category_name,
    Account_Owner,
    dim_partner_partner_id,
    fact_orders_total_confirmed_orders,
    fact_orders_percentage_commercial_fail_rate,
        agg_fact_sessions_by_partner_daily_qty_unique_orders / NULLIF(agg_fact_sessions_by_partner_daily_qty_sessions, 0) AS agg_fact_sessions_by_partner_daily_cvr_1,
        CASE WHEN fact_orders_total_confirmed_orders = 0 THEN 0 ELSE fact_orders_kpi_total_gfv_confirmed / fact_orders_total_confirmed_orders END AS fact_orders_kpi_afv,
        CASE WHEN agg_fact_partner_times_schedule_times_hour = 0 THEN 0 ELSE agg_fact_partner_times_open_times_hour / agg_fact_partner_times_schedule_times_hour END AS agg_fact_partner_times_actual_open_time_rate
FROM
    (SELECT
            dim_partner.partner_id  AS dim_partner_partner_id,
            dim_partner.partner_name  AS dim_partner_partner_name,
            dim_partner.account_owner AS Account_Owner,
            dim_partner.main_cousine_category_name  AS dim_partner_main_cousine_category_name,
            dim_area.area_name  AS dim_area_area_name,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (fact_orders.fail_rate_owner_restaurant ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) / NULLIF(COUNT(DISTINCT fact_orders.order_id ), 0) AS fact_orders_percentage_commercial_fail_rate,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.unique_orders  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_unique_orders,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.sessions  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_sessions,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders_0,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( fact_orders.confirmed_total_amount  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS fact_orders_kpi_total_gfv_confirmed,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders_1,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_partner_times.times *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
