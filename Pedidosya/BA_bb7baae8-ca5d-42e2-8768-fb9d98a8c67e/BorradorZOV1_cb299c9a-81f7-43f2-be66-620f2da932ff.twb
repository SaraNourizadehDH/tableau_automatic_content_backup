        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1cawbeh0t98gsh1gvjzb00cz4drn' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    dim_partner_partner_name,
    dim_area_area_name,
    dim_partner_main_cousine_category_name,
    Account_Owner,
    dim_partner_partner_id,
    fact_orders_total_confirmed_orders,
    fact_orders_percentage_commercial_fail_rate,
        agg_fact_sessions_by_partner_daily_qty_unique_orders / NULLIF(agg_fact_sessions_by_partner_daily_qty_sessions, 0) AS agg_fact_sessions_by_partner_daily_cvr_1,
        CASE WHEN fact_orders_total_confirmed_orders = 0 THEN 0 ELSE fact_orders_kpi_total_gfv_confirmed / fact_orders_total_confirmed_orders END AS fact_orders_kpi_afv,
        CASE WHEN agg_fact_partner_times_schedule_times_hour = 0 THEN 0 ELSE agg_fact_partner_times_open_times_hour / agg_fact_partner_times_schedule_times_hour END AS agg_fact_partner_times_actual_open_time_rate
FROM
    (SELECT
            dim_partner.partner_id  AS dim_partner_partner_id,
            dim_partner.partner_name  AS dim_partner_partner_name,
            dim_partner.account_owner AS Account_Owner,
            dim_partner.main_cousine_category_name  AS dim_partner_main_cousine_category_name,
            dim_area.area_name  AS dim_area_area_name,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (fact_orders.fail_rate_owner_restaurant ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) / NULLIF(COUNT(DISTINCT fact_orders.order_id ), 0) AS fact_orders_percentage_commercial_fail_rate,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.unique_orders  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_unique_orders,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.sessions  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_sessions,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders_0,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( fact_orders.confirmed_total_amount  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS fact_orders_kpi_total_gfv_confirmed,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders_1,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_partner_times.times *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_partner_times_schedule_times_hour,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( CASE WHEN agg_fact_partner_times.state = 'OPEN' then agg_fact_partner_times.times end *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_partner_times_open_times_hour,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_partner_times.times *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_partner_times_schedule_times_hour_0,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.unique_orders  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_unique_orders_0,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.sessions  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_sessions_0
        FROM `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  AS dim_country ON dim_partner.country_id = dim_country.country_id
LEFT JOIN UNNEST([dim_partner.business_type]) as dim_partner__business_type
LEFT JOIN `peya-bi-tools-pro.il_core.dim_date`
     AS date_lookup ON date_lookup.date <<= CURRENT_DATE()
LEFT JOIN UNNEST([dim_partner.address]) as dim_partner__address
LEFT JOIN `peya-bi-tools-pro.il_core.dim_area` AS dim_area ON dim_partner__address.area_id=dim_area.area_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_historical_partners`
     AS dim_historical_partners ON dim_historical_partners.restaurant_id = dim_partner.partner_id and
      (DATE(dim_historical_partners.full_date )) = date_lookup.date
LEFT JOIN `peya-bi-tools-pro.il_sessions.agg_fact_sessions_by_partner_daily`
     AS agg_fact_sessions_by_partner_daily ON dim_partner.partner_id = agg_fact_sessions_by_partner_daily.partner_id

          AND agg_fact_sessions_by_partner_daily.session_date = date_lookup.date

LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders`  AS fact_orders ON dim_partner.partner_id = fact_orders.restaurant.id

          and fact_orders.registered_date >>= (DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH))
          and fact_orders.registered_date <<= (coalesce((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH), INTERVAL 3 MONTH)), current_date()))
          --
          AND fact_orders.registered_date = date_lookup.date

LEFT JOIN `peya-bi-tools-pro.il_core.agg_fact_partner_times`
     AS agg_fact_partner_times ON dim_partner.partner_id = agg_fact_partner_times.partner_id
      and (DATE(dim_historical_partners.full_date )) = agg_fact_partner_times.partner_time_date
      and agg_fact_partner_times.partner_time_date >>= (DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH))
      and agg_fact_partner_times.partner_time_date <<= coalesce((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH), INTERVAL 3 MONTH)), current_date())
        WHERE  ((dim_country.active ) AND ((UPPER(( dim_partner__business_type.business_type_name  )) = UPPER('Restaurant')))) AND (((( date_lookup.date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH))) AND ( date_lookup.date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH), INTERVAL 3 MONTH))))) AND ((UPPER(( dim_area.area_name  )) = UPPER('Las Condes') OR UPPER(( dim_area.area_name  )) = UPPER('Vitacura') OR UPPER(( dim_area.area_name  )) = UPPER('Lo Barnechea'))) AND ((dim_partner.country_id ) = 2 AND ((dim_partner.partner_id ) >> 0 OR (dim_partner.partner_id ) IS NULL)))
        GROUP BY
            1,
            2,
            3,
            4,
            5
        HAVING agg_fact_sessions_by_partner_daily_qty_unique_orders / NULLIF(agg_fact_sessions_by_partner_daily_qty_sessions, 0) >> 0 AND agg_fact_sessions_by_partner_daily_qty_unique_orders IS NOT NULL) AS t3
ORDER BY
    2 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1cawbeh0t98gsh1gvjzb00cz4drn' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    dim_partner_partner_name,
    dim_area_area_name,
    dim_partner_main_cousine_category_name,
    Account_Owner,
    dim_partner_partner_id,
    fact_orders_total_confirmed_orders,
    fact_orders_percentage_commercial_fail_rate,
        agg_fact_sessions_by_partner_daily_qty_unique_orders / NULLIF(agg_fact_sessions_by_partner_daily_qty_sessions, 0) AS agg_fact_sessions_by_partner_daily_cvr_1,
        CASE WHEN fact_orders_total_confirmed_orders = 0 THEN 0 ELSE fact_orders_kpi_total_gfv_confirmed / fact_orders_total_confirmed_orders END AS fact_orders_kpi_afv,
        CASE WHEN agg_fact_partner_times_schedule_times_hour = 0 THEN 0 ELSE agg_fact_partner_times_open_times_hour / agg_fact_partner_times_schedule_times_hour END AS agg_fact_partner_times_actual_open_time_rate
FROM
    (SELECT
            dim_partner.partner_id  AS dim_partner_partner_id,
            dim_partner.partner_name  AS dim_partner_partner_name,
            dim_partner.account_owner AS Account_Owner,
            dim_partner.main_cousine_category_name  AS dim_partner_main_cousine_category_name,
            dim_area.area_name  AS dim_area_area_name,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (fact_orders.fail_rate_owner_restaurant ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) / NULLIF(COUNT(DISTINCT fact_orders.order_id ), 0) AS fact_orders_percentage_commercial_fail_rate,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.unique_orders  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_unique_orders,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.sessions  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_sessions,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders_0,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( fact_orders.confirmed_total_amount  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( fact_orders.order_id   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS fact_orders_kpi_total_gfv_confirmed,
            COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders_1,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_partner_times.times *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_partner_times_schedule_times_hour,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( CASE WHEN agg_fact_partner_times.state = 'OPEN' then agg_fact_partner_times.times end *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_partner_times_open_times_hour,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_partner_times.times *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_partner_times_schedule_times_hour_0,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.unique_orders  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_unique_orders_0,
            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.sessions  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_sessions_0
        FROM `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  AS dim_country ON dim_partner.country_id = dim_country.country_id
LEFT JOIN UNNEST([dim_partner.business_type]) as dim_partner__business_type
LEFT JOIN `peya-bi-tools-pro.il_core.dim_date`
     AS date_lookup ON date_lookup.date <<= CURRENT_DATE()
LEFT JOIN UNNEST([dim_partner.address]) as dim_partner__address
LEFT JOIN `peya-bi-tools-pro.il_core.dim_area` AS dim_area ON dim_partner__address.area_id=dim_area.area_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_historical_partners`
     AS dim_historical_partners ON dim_historical_partners.restaurant_id = dim_partner.partner_id and
      (DATE(dim_historical_partners.full_date )) = date_lookup.date
LEFT JOIN `peya-bi-tools-pro.il_sessions.agg_fact_sessions_by_partner_daily`
     AS agg_fact_sessions_by_partner_daily ON dim_partner.partner_id = agg_fact_sessions_by_partner_daily.partner_id

          AND agg_fact_sessions_by_partner_daily.session_date = date_lookup.date

LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders`  AS fact_orders ON dim_partner.partner_id = fact_orders.restaurant.id

          and fact_orders.registered_date >>= (DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH))
          and fact_orders.registered_date <<= (coalesce((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH), INTERVAL 3 MONTH)), current_date()))
          --
          AND fact_orders.registered_date = date_lookup.date

LEFT JOIN `peya-bi-tools-pro.il_core.agg_fact_partner_times`
     AS agg_fact_partner_times ON dim_partner.partner_id = agg_fact_partner_times.partner_id
      and (DATE(dim_historical_partners.full_date )) = agg_fact_partner_times.partner_time_date
      and agg_fact_partner_times.partner_time_date >>= (DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH))
      and agg_fact_partner_times.partner_time_date <<= coalesce((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH), INTERVAL 3 MONTH)), current_date())
        WHERE  ((dim_country.active ) AND ((UPPER(( dim_partner__business_type.business_type_name  )) = UPPER('Restaurant')))) AND (((( date_lookup.date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH))) AND ( date_lookup.date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH), INTERVAL 3 MONTH))))) AND ((UPPER(( dim_area.area_name  )) = UPPER('Las Condes') OR UPPER(( dim_area.area_name  )) = UPPER('Vitacura') OR UPPER(( dim_area.area_name  )) = UPPER('Lo Barnechea'))) AND ((dim_partner.country_id ) = 2 AND ((dim_partner.partner_id ) >> 0 OR (dim_partner.partner_id ) IS NULL)))
        GROUP BY
            1,
            2,
            3,
            4,
            5
        HAVING agg_fact_sessions_by_partner_daily_qty_unique_orders / NULLIF(agg_fact_sessions_by_partner_daily_qty_sessions, 0) >> 0 AND agg_fact_sessions_by_partner_daily_qty_unique_orders IS NOT NULL) AS t3
ORDER BY
    2 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
