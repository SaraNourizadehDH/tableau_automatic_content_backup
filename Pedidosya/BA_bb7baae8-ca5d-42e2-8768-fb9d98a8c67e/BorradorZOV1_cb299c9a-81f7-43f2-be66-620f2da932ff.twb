            ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( CASE WHEN agg_fact_partner_times.state = 'OPEN' then agg_fact_partner_times.times end *1.0/60.0  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
