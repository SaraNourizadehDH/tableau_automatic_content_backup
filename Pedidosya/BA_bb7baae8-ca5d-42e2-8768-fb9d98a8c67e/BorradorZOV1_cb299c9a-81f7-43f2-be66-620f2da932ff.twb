                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) )   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
