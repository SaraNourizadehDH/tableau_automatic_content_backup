      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hk736p1w409l71ee9fiz1v94b22]&quot;' value='GMV' />
        </aliases>
      </column>
      <column caption='Exclusive/TOTAL' datatype='real' name='[Calculation_1192046561269039104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF  [Preference_Type (grupo)]=&quot;Exclusive&quot; THEN [gmv] else 0 END) / SUM ([gmv])' />
      </column>
      <column caption='Brand per Country' datatype='string' name='[Calculation_1503076428513648641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [segment (grupo)]= &apos;KA&apos; then [country_code]+&quot; - &quot;+[partner_name] else NULL END' />
      </column>
      <column caption='%MoM' datatype='string' name='[Calculation_1503076428516274178]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if((ZN(SUM([gmv])) - ZN(LOOKUP(SUM([gmv]), -1))) / ABS(ZN(LOOKUP(SUM([gmv]), -1)))) &lt;0 then &apos;Variación Negativa&apos; else &apos;Variación Positiva&apos; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Preference_Acq' datatype='integer' name='[Calculation_5070490232629624832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [date_month]=[add_on_start_date] and [Preference_Type (grupo)] =&apos;Exclusive&apos; and [segment (grupo)] =&apos;KA&apos; then [salesforce_id] else NULL END)' />
      </column>
      <column caption='Cálculo1' datatype='real' name='[Calculation_6351482858719113216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if[Parameters].[Parámetro 1] = &apos;Partners&apos; then round(countd([salesforce_id (Lost_Preferences)]),0)&#13;&#10;else round(sum([gmv (Lost_Preferences)]),0) end' />
      </column>
      <column caption='Exclusive GMV KA (copia)' datatype='real' name='[Exclusive GMV KA (copia)_1966384248502722561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF  [Preference_Type (grupo)]=&quot;Exclusive&quot; and [segment (grupo)]=&quot;KA&quot; THEN [gmv] else 0 END)' />
      </column>
      <column caption='Exclusive GMV KA/TOTAL  (copia)' datatype='real' name='[Exclusive GMV KA/TOTAL  (copia)_1966384248502259712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF  [Preference_Type (grupo)]=&quot;Exclusive&quot; and [segment (grupo)]=&quot;KA&quot; THEN [gmv] else 0 END)/sum([gmv])' />
      </column>
      <column caption='GMV KA/TOTAL' datatype='real' name='[Exclusive GMV KA/TOTAL  (copia)_4117134544641814528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF  [segment (grupo)]=&quot;Longtail&quot; THEN 0 else [gmv] end)' />
      </column>
      <column caption='GMV KA' datatype='real' name='[Exclusive GMV KA/TOTAL  (copia)_5070490232639176705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [segment (grupo)]=&quot;KA&quot; THEN [gmv] else 0 END)' />
      </column>
      <column caption='Exclusive MHP/TOTAL' datatype='real' name='[Exclusive Share (copy)_1544734727625494528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF  [Exclusivity]=&quot;Exclusivity&quot; and [MHP] then [gmv] else 0 END)/(SUM([gmv]))' />
      </column>
      <column caption='Exclusive GMV KA/TOTAL KA ' datatype='real' name='[Exclusive/TOTAL (copia)_4313041126633340929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Preference_Type (grupo)]=&quot;Exclusive&quot; and [segment (grupo)]=&quot;KA&quot; THEN [gmv] else 0 END)/sum(if [segment (grupo)]=&quot;KA&quot; THEN [gmv] else 0 END)' />
      </column>
      <column caption='Exclusivity (Lost Preferences)' datatype='string' name='[Exclusivity (Lost_Preferences)]' role='dimension' type='nominal' />
      <column caption='Exclusivity1' datatype='string' name='[Exclusivity]' role='dimension' type='nominal' />
      <column datatype='string' name='[Gmv (grupo)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[gmv]' default='&quot;Otro&quot;' new-bin='true'>
          <bin default-name='true' value='&quot;NULL&quot;'>
            <value>%null%</value>
          </bin>
        </calculation>
      </column>
