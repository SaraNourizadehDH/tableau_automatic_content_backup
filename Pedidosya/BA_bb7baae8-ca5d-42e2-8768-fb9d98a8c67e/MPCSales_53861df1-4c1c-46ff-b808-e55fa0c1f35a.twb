            <column caption='Commission Rate Food YoY' datatype='real' name='[Commission Rate Food MoM (copia)_1066227213447610373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [Commission_Revenue] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [GFV] END))/&#13;&#10;(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [Commission_Revenue_LY] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [GFV_LY] END))-1' />
            </column>
            <column caption='Commission Rate LS YoY' datatype='real' name='[Commission Rate LS MoM  (copia)_1066227213447774214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [Commission_Revenue] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [GFV] END))/&#13;&#10;(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [Commission_Revenue_LY] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [GFV_LY] END))-1' />
            </column>
