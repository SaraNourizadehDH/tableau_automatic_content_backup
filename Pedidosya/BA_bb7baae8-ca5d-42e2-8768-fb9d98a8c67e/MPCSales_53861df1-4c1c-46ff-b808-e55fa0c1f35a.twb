            <column caption='Active Partners F90 MoM' datatype='real' name='[Active Partners F90 (copia)_905786476786044936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([COUNTRY])=1&#13;&#10;THEN SUM([Active F90])/SUM([Active F90 LM])-1&#13;&#10;ELSE SUM([Ponderado Active F90])/SUM([Ponderado Active F90 LM])-1 END' />
