            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0rl3fue01q37w412eim720ckgbzb].[Calculation_1052997888810422272]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0rl3fue01q37w412eim720ckgbzb].[Month]' caption='Prior Period' datatype='date' default-format='*mmmm &quot;de&quot; yyyy' name='[Parámetro 1]' param-domain-type='list' role='measure' type='quantitative' value='#2022-07-01#'>
              <calculation class='tableau' formula='#2022-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rl3fue01q37w412eim720ckgbzb'>
            <column caption='Active Partners' datatype='integer' name='[Active_Partners]' role='measure' type='quantitative' />
            <column caption='Prior Month - Cal' datatype='datetime' name='[Calculation_1052997888810422272]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(DATEADD(&apos;month&apos;,-1,[Month]))}' />
            </column>
            <column caption='Month Calc' datatype='boolean' name='[Calculation_1052997888811192321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Month]=[Parameters].[Parámetro 1]' />
            </column>
            <column caption='% VFD/GMV' datatype='real' name='[Calculation_1530379516630065155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Discounts])/SUM([VFD_GMV])' />
            </column>
            <column caption='% Partners Using VFD' datatype='real' name='[Calculation_1530379516630294532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Partners])/SUM([VFD_Total_Partners])' />
            </column>
            <column caption='%Paid Traffic' datatype='real' name='[Calculation_1530379516701749253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Paid_Traffic])/SUM([Traffic])' />
            </column>
            <column caption='% Active Partners' datatype='real' name='[Calculation_1530379516708233222]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Active_Partners])/sum([Online_Partners])' />
            </column>
            <column caption='% Zombies' datatype='real' name='[Calculation_1530379516708421639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Zombie_Partners])/sum([Online_Partners])' />
            </column>
            <column caption='% Over 30' datatype='real' name='[Calculation_1530379516708536328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Over_30])/SUM([Online_Partners])' />
            </column>
            <column caption='% Churned' datatype='real' name='[Calculation_1530379516708634633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Churned_Partners])/sum([Online_Partners])' />
            </column>
            <column caption='% Low Orders' datatype='real' name='[Calculation_1530379516708823050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Low_Orders])/sum([Online_Partners])' />
