          <datasource-dependencies datasource='federated.0rl3fue01q37w412eim720ckgbzb'>
            <column caption='% Commission Rate MoM' datatype='real' name='[% Commission Rate (copia)_905786477420011542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Commission_Revenue])/sum([GFV]))&#13;&#10;/&#13;&#10;(sum([Commission_Revenue_LP])/sum([GFV_LP]))&#13;&#10;-1' />
            </column>
            <column caption='AFV MoM' datatype='real' name='[AFV (copia)_905786477418835988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([GFV])/SUM([Confirmed_Orders (MPC_Detailed)]))&#13;&#10;/&#13;&#10;(SUM([GFV_LP])/SUM([Confirmed_Orders_LP (MPC_Detailed)]))-1' />
