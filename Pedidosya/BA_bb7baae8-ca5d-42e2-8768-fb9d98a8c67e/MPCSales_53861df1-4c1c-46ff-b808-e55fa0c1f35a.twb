              <calculation class='tableau' formula='#2022-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rl3fue01q37w412eim720ckgbzb'>
            <column caption='Prior Month - Cal' datatype='datetime' name='[Calculation_1052997888810422272]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(DATEADD(&apos;month&apos;,-1,[Month]))}' />
            </column>
            <column caption='% VFD/GMV' datatype='real' name='[Calculation_1530379516630065155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Discounts])/SUM([VFD_GMV])' />
            </column>
            <column caption='Month Index' datatype='integer' name='[Calculation_1530379516716060684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,DATETRUNC(&apos;month&apos;,[Month]), {MAX(DATETRUNC(&apos;month&apos;,[Parameters].[Parámetro 1]))})' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_905786477160566801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GFV])/SUM([Confirmed_Orders (MPC_Detailed)])' />
            </column>
            <column caption='% Commission Rate' datatype='real' name='[Calculation_905786477161758738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Commission_Revenue])/sum([GFV])' />
            </column>
            <column caption='RPO' datatype='real' name='[Calculation_905786477163646995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Commission_Revenue])/SUM([Confirmed_Orders (MPC_Detailed)])' />
            </column>
            <column caption='VFD/GMV' datatype='real' name='[Calculation_905786477502222361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Discounts (MPC_Detailed)])/SUM([VFD_GMV (MPC_Detailed)])' />
            </column>
            <column caption='Partners Using VFD' datatype='real' name='[Calculation_905786477502517274]' role='measure' type='quantitative'>
