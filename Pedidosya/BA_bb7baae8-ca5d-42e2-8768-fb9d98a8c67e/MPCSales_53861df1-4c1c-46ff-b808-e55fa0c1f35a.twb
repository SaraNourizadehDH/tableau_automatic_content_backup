      <table>
        <view>
          <datasources>
            <datasource caption='MPC_Overall (automated_tables_reports)' name='federated.0rl3fue01q37w412eim720ckgbzb' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0rl3fue01q37w412eim720ckgbzb].[Calculation_1052997888810422272]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0rl3fue01q37w412eim720ckgbzb].[Month]' caption='Prior Period' datatype='date' default-format='*mmmm &quot;de&quot; yyyy' name='[Parámetro 1]' param-domain-type='list' role='measure' type='quantitative' value='#2022-07-01#'>
              <calculation class='tableau' formula='#2022-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rl3fue01q37w412eim720ckgbzb'>
            <column datatype='real' name='[Active F90]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Prior Month - Cal' datatype='datetime' name='[Calculation_1052997888810422272]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(DATEADD(&apos;month&apos;,-1,[Month]))}' />
            </column>
            <column caption='% VFD/GMV' datatype='real' name='[Calculation_1530379516630065155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Discounts])/SUM([VFD_GMV])' />
            </column>
            <column caption='Month Index' datatype='integer' name='[Calculation_1530379516716060684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,DATETRUNC(&apos;month&apos;,[Month]), {MAX(DATETRUNC(&apos;month&apos;,[Parameters].[Parámetro 1]))})' />
            </column>
            <column caption='Framework Compliance' datatype='real' name='[Calculation_905786476785197062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([COUNTRY])=1&#13;&#10;THEN SUM([Framework Compliance])&#13;&#10;ELSE SUM([Framework Ponderado]) END' />
            </column>
            <column caption='Active Partners F90' datatype='real' name='[Calculation_905786476785483783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([COUNTRY])=1&#13;&#10;THEN SUM([Active F90])&#13;&#10;ELSE SUM([Ponderado Active F90]) END' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_905786477160566801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GFV])/SUM([Confirmed_Orders (MPC_Detailed)])' />
            </column>
            <column caption='% Commission Rate' datatype='real' name='[Calculation_905786477161758738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Commission_Revenue])/sum([GFV])' />
            </column>
            <column caption='RPO' datatype='real' name='[Calculation_905786477163646995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Commission_Revenue])/SUM([Confirmed_Orders (MPC_Detailed)])' />
            </column>
            <column caption='VFD/GMV' datatype='real' name='[Calculation_905786477502222361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Discounts (MPC_Detailed)])/SUM([VFD_GMV (MPC_Detailed)])' />
            </column>
            <column caption='Partners Using VFD' datatype='real' name='[Calculation_905786477502517274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Partners (MPC_Detailed)])/SUM([VFD_TotalPartners])' />
            </column>
            <column datatype='real' name='[Commission_Revenue]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Confirmed_Orders (MPC_Detailed)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
