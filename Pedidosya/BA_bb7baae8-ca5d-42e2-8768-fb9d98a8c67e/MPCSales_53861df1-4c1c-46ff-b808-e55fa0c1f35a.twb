              <calculation class='tableau' formula='{ FIXED : MAX(DATEADD(&apos;month&apos;,-1,[Month]))}' />
            </column>
            <column caption='Month Calc' datatype='boolean' name='[Calculation_1052997888811192321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Month]=[Parameters].[Parámetro 1]' />
            </column>
            <column caption='NCR Ads Total' datatype='integer' name='[Calculation_652740472366043137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Ads Real])' />
            </column>
            <column caption='Commission Rate Food MoM' datatype='real' name='[Commission Rate Food (copia)_652740472405348360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [Commission_Revenue] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [GFV] END))/&#13;&#10;(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [Commission_Revenue_LP] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Food&quot; THEN [GFV_LP] END))-1' />
            </column>
            <column caption='Commission Rate LS MoM ' datatype='real' name='[Commission Rate Food MoM (copia)_652740472405880841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [Commission_Revenue] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [GFV] END))/&#13;&#10;(SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [Commission_Revenue_LP] END)/&#13;&#10;SUM(IF [Is_Food_or_LS_or_Courier]=&quot;Local Stores&quot; THEN [GFV_LP] END))-1' />
            </column>
            <column datatype='real' name='[Commission_Revenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[Commission_Revenue_LP]' role='measure' type='quantitative' />
            <column datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[GFV]' role='measure' type='quantitative' />
            <column datatype='real' name='[GFV_LP]' role='measure' type='quantitative' />
            <column datatype='integer' name='[GMV Real LM]' role='measure' type='quantitative' />
            <column datatype='integer' name='[GMV Real]' role='measure' type='quantitative' />
            <column caption='Is Food or LS or Courier' datatype='string' name='[Is_Food_or_LS_or_Courier]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='NCR Ads Total MoM' datatype='real' name='[NCR Ads Total (copia)_652740472406134794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Ads Real])/SUM([Total Ads Real LM])-1' />
            </column>
            <column caption='NCR Ads/GMV MoM' datatype='real' name='[NCR Ads/GMV (copia)_1066227213445984257]' role='measure' type='quantitative'>
