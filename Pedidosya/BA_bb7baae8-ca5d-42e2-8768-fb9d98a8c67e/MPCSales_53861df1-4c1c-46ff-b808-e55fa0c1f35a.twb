              <calculation class='tableau' formula='#2022-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rl3fue01q37w412eim720ckgbzb'>
            <column caption='Active Partners' datatype='integer' name='[Active_Partners]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Active_Partners_LP]' role='measure' type='quantitative' />
            <column caption='Prior Month - Cal' datatype='datetime' name='[Calculation_1052997888810422272]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(DATEADD(&apos;month&apos;,-1,[Month]))}' />
            </column>
            <column caption='Month Calc' datatype='boolean' name='[Calculation_1052997888811192321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Month]=[Parameters].[Parámetro 1]' />
            </column>
            <column caption='Active Partners MoM' datatype='real' name='[Calculation_1293096111630614545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Active_Partners])/sum([Active_Partners_LP])-1' />
            </column>
            <column caption='% Act Partners MoM' datatype='real' name='[Calculation_1293096111630794770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Active_Partners])/SUM([Online_Partners]))/&#13;&#10;(SUM([Active_Partners_LP])/SUM([Online_Partners_LP]))-1' />
            </column>
            <column caption='% Zombies MoM' datatype='real' name='[Calculation_1293096111631462419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Zombie_Partners])/SUM([Online_Partners]))/&#13;&#10;(SUM([Zombie_Partners_LP])/SUM([Online_Partners_LP]))-1' />
            </column>
            <column caption='% Over 30 MoM' datatype='real' name='[Calculation_1293096111631638548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Over_30])/SUM([Online_Partners]))/&#13;&#10;(SUM([Over_30_LP])/SUM([Online_Partners_LP]))-1' />
            </column>
            <column caption='% Low Orders MoM' datatype='real' name='[Calculation_1293096111631749141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Low_Orders])/SUM([Online_Partners]))/&#13;&#10;(SUM([Low_Orders_LP])/SUM([Online_Partners_LP]))-1' />
            </column>
            <column caption='% Churn MoM' datatype='real' name='[Calculation_1293096111631872022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Churned_Partners])/SUM([Online_Partners]))/&#13;&#10;(SUM([Churned_Partners_LP])/SUM([Online_Partners_LP]))-1' />
            </column>
            <column caption='VFD Disc MoM' datatype='real' name='[Calculation_1293096111632080919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([VFD_Discounts])/SUM([VFD_Discounts_LP])-1' />
            </column>
            <column caption='%VFD/GMV MoM' datatype='real' name='[Calculation_1293096111632228376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([VFD_Discounts])/SUM([VFD_GMV]))/&#13;&#10;(SUM([VFD_Discounts_LP])/SUM([VFD_GMV_LP]))-1' />
            </column>
            <column caption='% Partners VFD MoM' datatype='real' name='[Calculation_1293096111632441369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([VFD_Partners])/SUM([VFD_Total_Partners]))/&#13;&#10;(SUM([VFD_Partners_LP])/SUM([VFD_Total_Partners_LP]))-1' />
            </column>
