            <column caption='Commission Revenue MoM' datatype='real' name='[Calculation_905786477419716629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Commission_Revenue])/SUM([Commission_Revenue_LP])-1' />
