            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rl3fue01q37w412eim720ckgbzb'>
            <column caption='% Act Partners YoY' datatype='real' name='[% Act Partners MoM (copia)_483011128732778510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Active_Partners])/SUM([Online_Partners]))/&#13;&#10;(SUM([Active_Partners_LY])/SUM([Online_Partners_LY]))-1' />
            </column>
            <column caption='% Churn YoY' datatype='real' name='[% Churn MoM (copia)_483011128733192210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Churned_Partners])/SUM([Online_Partners]))/&#13;&#10;(SUM([Churned_Partners_LY])/SUM([Online_Partners_LY]))-1' />
            </column>
            <column caption='% Low Orders YoY' datatype='real' name='[% Low Orders MoM (copia)_483011128733106193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Low_Orders])/SUM([Online_Partners]))/&#13;&#10;(SUM([Low_Orders_LY])/SUM([Online_Partners_LY]))-1' />
            </column>
