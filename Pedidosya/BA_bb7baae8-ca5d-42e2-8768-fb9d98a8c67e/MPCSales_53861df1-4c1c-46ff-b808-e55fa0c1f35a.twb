            <column datatype='real' name='[GFV_LY]' role='measure' type='quantitative' />
            <column datatype='integer' name='[GMV Real LY]' role='measure' type='quantitative' />
            <column datatype='integer' name='[GMV Real]' role='measure' type='quantitative' />
            <column caption='Is Food or LS or Courier' datatype='string' name='[Is_Food_or_LS_or_Courier]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='NCR Ads Total YoY' datatype='real' name='[NCR Ads Total MoM (copia)_1066227213447950344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Ads Real])/SUM([Total Ads Real LY])-1' />
