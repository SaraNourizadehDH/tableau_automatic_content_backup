      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1lqxydw1l40d120zyroba1i84pby].[pcto:sum:q_orders_shop_list:qk]&quot;' value='% of Total Orders Shoplist' />
          <alias key='&quot;[federated.1lqxydw1l40d120zyroba1i84pby].[sum:q_orders_shop_list:qk]&quot;' value='Orders Shoplist' />
          <alias key='&quot;[federated.1lqxydw1l40d120zyroba1i84pby].[usr:Calculation_1992491052875005952:qk]&quot;' value='% of shoplist top 5 positions filled with NCR partners' />
          <alias key='&quot;[federated.1lqxydw1l40d120zyroba1i84pby].[usr:Calculation_1992491052885204999:qk]&quot;' value='Fill Rate Clicks' />
          <alias key='&quot;[federated.1lqxydw1l40d120zyroba1i84pby].[usr:fill rate (clicks) (copia)_1992491052915785747:qk]&quot;' value='Fill Rate Orders' />
        </aliases>
      </column>
      <column caption='% of first five positions filled with ncr partners' datatype='real' name='[Calculation_1992491052875005952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_gvips]) / (sum([impressions])*5)' />
      </column>
      <column caption='share ncr (clicks)' datatype='real' name='[Calculation_1992491052876193793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([q_ncr_clicks_first_five_positions]) / SUM([q_clicks_shop_list])' />
      </column>
      <column caption='fill rate (clicks)' datatype='real' default-format='p0.00%' name='[Calculation_1992491052885204999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([q_ncr_clicks_first_five_positions]) / sum([q_clicks_first_five_positions])' />
      </column>
      <column caption='impressions with gold vip (%)' datatype='real' name='[Calculation_1992491052912660493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([impressions_w_gvip])/sum([impressions])' />
      </column>
      <column caption='impressions with 5 gold vip (%)' datatype='real' name='[Calculation_1992491052913307662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([impressions_w_full_gvip])/sum([impressions])' />
      </column>
      <column caption='clicks ncr over orders ncr' datatype='real' name='[Calculation_1992491052913987599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([q_ncr_clicks_first_five_positions])/sum([q_ncr_orders_first_five_positions])' />
      </column>
      <column caption='ncr partners shown per impression (avg)' datatype='real' name='[Calculation_1992491052914905105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qty_gvips])/sum([impressions])' />
      </column>
      <column caption='KPI parameter selected' datatype='real' name='[Calculation_364932369146208256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Fill rate (clicks)&quot; THEN [Calculation_1992491052885204999]&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Fill rate (orders)&quot; THEN [fill rate (clicks) (copia)_1992491052915785747]&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Impressions with 5 gold vip (%)&quot; THEN [Calculation_1992491052913307662]&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Impressions with gold vip (%)&quot; THEN [Calculation_1992491052912660493]&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Share NCR (orders)&quot; THEN [share ncr (clicks) (copia)_1992491052914446352]&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;% ncr partners in first 5 positions&quot; THEN [Calculation_1992491052875005952]&#10;ELSE [Calculation_1992491052876193793] END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_364932369185538054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='above median' datatype='boolean' name='[Calculation_4792885597911609344]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(sum([impressions]) &gt;= WINDOW_MEDIAN(sum([impressions]))) and &#10;([Calculation_1992491052875005952] &lt;= window_median([Calculation_1992491052875005952]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CVR Shoplist' datatype='real' default-format='p0.0%' name='[Calculation_750975264320745473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([q_orders_shop_list])/SUM([q_clicks_shop_list])' />
      </column>
      <column caption='KPI parameter selected (copy)' datatype='real' name='[KPI parameter selected (copy)_1961880607330004992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[KPI (copy)_1961880607330304001] = &quot;Fill rate (clicks)&quot; THEN [Calculation_1992491052885204999]&#10;ELSEIF [Parameters].[KPI (copy)_1961880607330304001] = &quot;Fill rate (orders)&quot; THEN [fill rate (clicks) (copia)_1992491052915785747]&#10;ELSEIF [Parameters].[KPI (copy)_1961880607330304001] = &quot;Share NCR (orders)&quot; THEN [share ncr (clicks) (copia)_1992491052914446352]&#10;ELSEIF [Parameters].[KPI (copy)_1961880607330304001] = &quot;% ncr partners in first 5 positions&quot; THEN [Calculation_1992491052875005952]&#10;ELSE [Calculation_1992491052876193793] END' />
