            </column>
            <column caption='above median' datatype='boolean' name='[Calculation_4792885597911609344]' role='measure' type='nominal'>
              <calculation class='tableau' formula='(sum([impressions]) &gt;= WINDOW_MEDIAN(sum([impressions]))) and &#10;([Calculation_1992491052875005952] &lt;= window_median([Calculation_1992491052875005952]))'>
                <table-calc ordering-type='Rows' />
