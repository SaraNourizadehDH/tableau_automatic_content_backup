    <worksheet name='tabla midas_area'>
      <table>
        <view>
          <datasources>
            <datasource caption='ncr_fill_rate_tableau (automated_tables_reports)' name='federated.1lqxydw1l40d120zyroba1i84pby' />
          </datasources>
          <datasource-dependencies datasource='federated.1lqxydw1l40d120zyroba1i84pby'>
            <column caption='% of first five positions filled with ncr partners' datatype='real' name='[Calculation_1992491052875005952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_gvips]) / (sum([impressions])*5)' />
            </column>
            <column caption='share ncr (clicks)' datatype='real' name='[Calculation_1992491052876193793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([q_ncr_clicks_first_five_positions]) / SUM([q_clicks_shop_list])' />
            </column>
            <column caption='fill rate (clicks)' datatype='real' default-format='p0.00%' name='[Calculation_1992491052885204999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([q_ncr_clicks_first_five_positions]) / sum([q_clicks_first_five_positions])' />
            </column>
            <column caption='impressions with gold vip (%)' datatype='real' name='[Calculation_1992491052912660493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([impressions_w_gvip])/sum([impressions])' />
            </column>
            <column caption='impressions with 5 gold vip (%)' datatype='real' name='[Calculation_1992491052913307662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([impressions_w_full_gvip])/sum([impressions])' />
            </column>
            <column caption='clicks ncr over orders ncr' datatype='real' name='[Calculation_1992491052913987599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([q_ncr_clicks_first_five_positions])/sum([q_ncr_orders_first_five_positions])' />
            </column>
            <column caption='ncr partners shown per impression (avg)' datatype='real' name='[Calculation_1992491052914905105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_gvips])/sum([impressions])' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Context' datatype='string' name='[date_context]' role='dimension' type='nominal' />
            <column caption='fill rate (orders)' datatype='real' name='[fill rate (clicks) (copia)_1992491052915785747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([q_ncr_orders_first_five_positions]) / sum([q_orders_first_five_positions])' />
            </column>
            <column caption='Impressions' datatype='integer' name='[impressions]' role='measure' type='quantitative' />
            <column caption='Impressions W Full Gvip' datatype='integer' name='[impressions_w_full_gvip]' role='measure' type='quantitative' />
            <column caption='Impressions W Gvip' datatype='integer' name='[impressions_w_gvip]' role='measure' type='quantitative' />
