      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1a587t41gtq9q414v5p8o0cdk5gq'>
        <column caption='Ordenes Totales' datatype='integer' name='[Ordenes_Totales]' role='measure' type='quantitative' />
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_C639A80F37524590BD136E4951755B7B'>
            <properties context=''>
              <relation connection='bigquery.1p6ykey1wmf9xv13tmnxe13gkmhy' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    dim_partner.account_owner  AS dim_partner_account_owner,
    dim_partner.partner_id AS partner_id,
        date_lookup.date AS date_lookup_date_month,
    COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders
FROM `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  AS dim_country ON dim_partner.country_id = dim_country.country_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_date`
     AS date_lookup ON date_lookup.date <<= CURRENT_DATE()
LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders`  AS fact_orders ON dim_partner.partner_id = fact_orders.restaurant.id

          and fact_orders.registered_date >>= (DATE_TRUNC(CURRENT_DATE(), YEAR))
          and fact_orders.registered_date <<= (coalesce((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), YEAR), INTERVAL 1 YEAR)), current_date()))
          --
          AND fact_orders.registered_date = date_lookup.date

WHERE (dim_country.active ) AND ((( date_lookup.date  ) >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH))) AND ( date_lookup.date  ) << ((DATE_ADD(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -2 MONTH), INTERVAL 3 MONTH))))) AND (dim_partner.country_id ) = 2 AND ((dim_partner.partner_id ) >>= 0 OR (dim_partner.partner_id ) IS NULL)
GROUP BY
    1,
    2,
    3
ORDER BY
    4 DESC]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
