      <column caption='churn_partner_bdgt' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1108448492850069506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [NCR_churn_partner_bdgt]=&quot;YES&quot; THEN [partner_id] END' />
      </column>
      <column caption='COUNTRY_2' datatype='string' name='[Calculation_1108448492855971849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country_name]&#13;&#10;WHEN &quot;Argentina&quot; THEN &quot;AR&quot;&#13;&#10;WHEN &quot;Bolivia&quot; THEN &quot;BO&quot;&#13;&#10;WHEN &quot;Chile&quot; THEN &quot;CH&quot;&#13;&#10;WHEN &quot;Uruguay&quot; THEN &quot;UY&quot;&#13;&#10;WHEN &quot;Paraguay&quot; THEN &quot;PY&quot;&#13;&#10;WHEN &quot;Perú&quot; THEN &quot;PE&quot;&#13;&#10;WHEN &quot;Ecuador&quot; THEN &quot;EC&quot;&#13;&#10;WHEN &quot;Venezuela&quot; THEN &quot;VZ&quot;&#13;&#10;WHEN &quot;República Dominicana&quot; THEN &quot;RD&quot;&#13;&#10;WHEN &quot;Nicaragua&quot; THEN &quot;NI&quot;&#13;&#10;WHEN &quot;El Salvador&quot; THEN &quot;SV&quot;&#13;&#10;WHEN &quot;Costa Rica&quot; THEN &quot;CR&quot;&#13;&#10;WHEN &quot;Honduras&quot; THEN &quot;HN&quot;&#13;&#10;WHEN &quot;Panamá&quot; THEN &quot;PA&quot;&#13;&#10;WHEN &quot;Guatemala&quot; THEN &quot;GT&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='revenue_selfbooking' datatype='real' name='[Calculation_1199927862759280640]' role='measure' type='quantitative'>
