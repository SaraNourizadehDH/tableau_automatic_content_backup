      <column caption='date_dynamic' datatype='string' name='[Calculation_302867109076201472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Month&apos;    THEN [Calculation_302867109076283393]&#13;&#10;    WHEN &apos;Quarter&apos;  THEN [Calculation_302867109076336642]&#13;&#10;    WHEN &apos;Semester&apos; THEN [Calculation_302867109076377603]&#13;&#10;    WHEN &apos;Year&apos; THEN [Calculation_302867109076422660]&#13;&#10;END' />
      </column>
      <column caption='date_month_string' datatype='string' name='[Calculation_302867109076283393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_month]),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
      </column>
      <column caption='date_quarter' datatype='string' name='[Calculation_302867109076336642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;,[date_month]))+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
      </column>
      <column caption='date_semester' datatype='string' name='[Calculation_302867109076377603]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;quarter&apos;,[date_month]) &lt; 3 THEN &apos;H1&apos;+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month])) ELSE &apos;H2&apos;+ &apos; &apos; + STR(DATEPART(&apos;year&apos;,[date_month])) END' />
      </column>
