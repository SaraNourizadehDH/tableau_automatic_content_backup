  <worksheets>
    <worksheet name='General'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/AdsEC/General?rev=' id='General' path='/t/Pedidosya/workbooks/AdsEC' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.082ijf909mrlsk19o3lrm15fzhui' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='FX' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EU&quot;'>
              <calculation class='tableau' formula='&quot;EU&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.082ijf909mrlsk19o3lrm15fzhui'>
            <column caption='churn_partner_bdgt' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1108448492850069506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [NCR_churn_partner_bdgt]=&quot;YES&quot; THEN [partner_id] END' />
            </column>
            <column caption='revenue_selfbooking' datatype='real' name='[Calculation_1199927862759280640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_booking_source] WHEN &quot;self_booking&quot; THEN [Calculation_302867109077139461] ELSE 0 END' />
            </column>
            <column caption='date_year' datatype='string' name='[Calculation_302867109076422660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;FY&apos; + STR(DATEPART(&apos;year&apos;,[date_month]))' />
            </column>
            <column caption='revenue_data' datatype='real' name='[Calculation_302867109077139461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;LC&apos;    THEN [revenue_LC]&#13;&#10;    WHEN &apos;EU&apos;  THEN [revenue_LC]/[rate_eu]&#13;&#10;END' />
            </column>
            <column caption='new_revenue' datatype='real' name='[Calculation_302867109077565448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [NCR_new_partner] = &quot;YES&quot; THEN [Calculation_302867109077139461] ELSE 0 END' />
            </column>
            <column caption='vendor_penetration_budget' datatype='real' default-format='p0.00%' name='[Calculation_302867109079519244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Calculation_962925929232588800]))/(COUNTD([new_ncr_partner (copia)_302867109079072779])&#13;&#10;)' />
            </column>
            <column caption='empty_1' datatype='integer' name='[Calculation_302867109079822349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='rpp' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_302867109080797198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_302867109077139461])/(COUNTD([NCR_Partner (copia)_108086427332292610])-1)' />
            </column>
            <column caption='productivity' datatype='real' name='[Calculation_302867109131157521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_302867109077139461])/COUNTD([ncr_owner_name])' />
            </column>
            <column caption='ads_as_gmv' datatype='real' default-format='p0.00%' name='[Calculation_302867109179756564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_LC]/[rate_eu])/SUM([GMV_LC]/[rate_eu])' />
            </column>
            <column caption='compliance_rev' datatype='real' default-format='p0.00%' name='[Calculation_488359120217006080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_302867109077139461])/sum([revenue_data (copia)_253890463915753481])-1' />
            </column>
            <column caption='gmv_gv_lc' datatype='real' name='[Calculation_512847445259935744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [ad_product] WHEN &apos;GoldVIP CPC&apos; &#13;&#10;THEN [GMV_LC] else 0 END' />
            </column>
            <column caption='ROAS GV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_512847445260677122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_512847445259935744])&gt;0 THEN SUM([Calculation_512847445259935744]) / SUM([gmv_gv_lc (copia)_512847445260439553])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='pp_churn_in_revenue' datatype='real' name='[Calculation_806425864429895680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([revenue_data_churn (copia)_1205275896793075712])*0.01)/[churn_partner (copia)_1108448492850311172]' />
            </column>
            <column caption='pp_churn_in_partners' datatype='real' name='[Calculation_806425864436703234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((COUNTD([Calculation_1108448492850069506]))*0.01)/[churn_partner (copia)_1108448492850311172]' />
            </column>
            <column caption='NCR_Partner_budget' datatype='integer' name='[Calculation_962925929232588800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;([revenue_LC]+[budget_revenue_incl_canceled_LC]+[joker_sold])&gt;0 &#13;&#10;THEN [partner_id] END' />
            </column>
            <column caption='Quality Partner Share %' datatype='real' default-format='p0.00%' name='[Calculation_988821638050136065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [quality_partner] WHEN &apos;YES&apos; THEN [partner_id] END)/COUNTD([partner_id])' />
            </column>
            <column datatype='real' name='[GMV_LC]' role='measure' type='quantitative' />
            <column caption='NCR_Partner_to_bdgt_churn' datatype='integer' name='[NCR_Partner (copia)_108086427330629633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;([joker_sold]+[budget_revenue_excl_canceled_LC])&#13;&#10;&gt;0 THEN [partner_id] END' />
            </column>
            <column caption='NCR_Partner_revenue' datatype='integer' name='[NCR_Partner (copia)_108086427332292610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;([revenue_LC])&gt;0 &#13;&#10;THEN [partner_id] END' />
            </column>
            <column datatype='string' name='[NCR_churn_partner_bdgt]' role='dimension' type='nominal' />
            <column datatype='string' name='[NCR_churn_partner_gv_bdgt]' role='dimension' type='nominal' />
            <column datatype='string' name='[NCR_churn_partner_joker_bdgt]' role='dimension' type='nominal' />
            <column datatype='string' name='[NCR_churn_partner_rev]' role='dimension' type='nominal' />
            <column datatype='string' name='[NCR_new_partner]' role='dimension' type='nominal' />
            <column caption='QP Quality Partner' datatype='integer' name='[Quality Partner Share % (copia)_673006716001595397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [quality_partner] WHEN &apos;YES&apos; THEN [partner_id] END)' />
            </column>
            <column caption='ROAS GV Total' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ROAS GV (copia)_3511963331987300355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([gmv_gv_lc (copia)_3511963331987537924])&gt;0 THEN SUM([gmv_gv_lc (copia)_3511963331987537924]) / SUM([revenue_gv_lc (copia)_3511963331987816453])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='string' name='[active_partner]' role='dimension' type='nominal' />
            <column datatype='string' name='[ad_booking_source]' role='dimension' type='nominal' />
            <column datatype='string' name='[ad_product]' role='dimension' type='nominal' />
            <column datatype='real' name='[budget_revenue_excl_canceled_LC]' role='measure' type='quantitative' />
            <column datatype='real' name='[budget_revenue_incl_canceled_LC]' role='measure' type='quantitative' />
            <column caption='Business Type Name' datatype='string' name='[business_type_name]' role='dimension' type='nominal' />
            <column caption='churn_partner_bdgt_pcg' datatype='real' default-format='p0.00%' name='[churn_partner (copia)_1108448492850311172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Calculation_1108448492850069506]))/&#13;&#10;(COUNTD([NCR_Partner (copia)_108086427330629633]))' />
            </column>
            <column caption='churn_partner_rev' datatype='integer' name='[churn_partner_bdgt (copia)_888898020367400961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [NCR_churn_partner_rev]=&quot;YES&quot; THEN [partner_id] ELSE 0 END)' />
            </column>
            <column datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[country_id]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_962925929232588800]' derivation='CountD' name='[ctd:Calculation_962925929232588800:qk]' pivot='key' type='quantitative' />
            <column-instance column='[NCR_Partner (copia)_108086427332292610]' derivation='CountD' name='[ctd:NCR_Partner (copia)_108086427332292610:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ncr_owner_name]' derivation='CountD' name='[ctd:ncr_owner_name:qk]' pivot='key' type='quantitative' />
            <column-instance column='[new_ncr_partner (copia)_302867109079072779]' derivation='CountD' name='[ctd:new_ncr_partner (copia)_302867109079072779:qk]' pivot='key' type='quantitative' />
            <column-instance column='[new_revenue (copia)_302867109078880266]' derivation='CountD' name='[ctd:new_revenue (copia)_302867109078880266:qk]' pivot='key' type='quantitative' />
            <column-instance column='[revenue_selfbooking (copia)_1186417080843501568]' derivation='CountD' name='[ctd:revenue_selfbooking (copia)_1186417080843501568:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='empty_2' datatype='integer' name='[empty_1 (copia)_302867109125120015]' role='measure' type='quantitative'>
