      <column caption='NCR_churn_partner_BOTH_bdgt' datatype='string' name='[Calculation_1307451310971858962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NCR_churn_partner_gv_bdgt]=&quot;YES&quot; AND [NCR_churn_partner_joker_bdgt]=&quot;YES&quot; THEN &quot;YES&quot; END' />
      </column>
      <column caption='budget_consumption_gv' datatype='real' default-format='p0.00%' name='[Calculation_1347983700861181952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_budget_excl_canceled]) ELSE 0 END)&#13;&#10;&gt;0&#13;&#10;&#13;&#10;THEN&#13;&#10;&#13;&#10;ROUND (&#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_billed]) ELSE 0 END)&#13;&#10;,0) &#13;&#10;/&#13;&#10;ROUND(&#13;&#10;SUM(IF [ad_product] = &quot;GoldVIP CPC&quot; THEN ([clicks_budget_excl_canceled]) ELSE 0 END)&#13;&#10;,0)&#13;&#10;ELSE 0 END' />
      </column>
      <column caption='Increase Bdgt Gold VIP' datatype='string' name='[Calculation_1347983700870004737]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1347983700861181952]&gt;=0.85 AND [Calculation_512847445260677122]&gt;=3 THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
      </column>
      <column caption='CVR Ads' datatype='real' name='[Calculation_1465077302561054723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([clicks_tot])&gt;0 THEN&#13;&#10;&#13;&#10;SUM([confirmed_orders])/SUM([clicks_tot])&#13;&#10;ELSE 0 END' />
