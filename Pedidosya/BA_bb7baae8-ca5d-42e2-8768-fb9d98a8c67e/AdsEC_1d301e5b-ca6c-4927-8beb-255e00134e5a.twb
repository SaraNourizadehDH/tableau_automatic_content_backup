      </column>
      <column caption='Churn Type' datatype='string' name='[Calculation_202943506964328454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NCR_churn_partner_gv_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_joker_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt] =&quot;YES&quot;&#13;&#10;THEN &quot;CPC/CPP &amp; Joker Churn&quot;&#13;&#10;&#13;&#10;ELSEIF [NCR_churn_partner_gv_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_joker_bdgt]&lt;&gt;&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt] =&quot;YES&quot;&#13;&#10;THEN &quot;CPC/CPP Churn&quot;&#13;&#10;&#13;&#10;ELSEIF [NCR_churn_partner_joker_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_gv_bdgt]&lt;&gt;&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt]=&quot;YES&quot;&#13;&#10;THEN &quot;Joker Churn&quot;&#13;&#10;&#13;&#10;ELSE &quot;No Churn&quot;&#13;&#10;&#13;&#10;END' />
