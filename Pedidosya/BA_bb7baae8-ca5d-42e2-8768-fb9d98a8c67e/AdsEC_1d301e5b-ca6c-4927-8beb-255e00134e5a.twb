      <column caption='revenue_LC_churn' datatype='real' name='[revenue_data (copia)_989384589495861248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#13;&#10;&#13;&#10;([NCR_churn_partner_joker_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_gv_bdgt]&lt;&gt;&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt]=&quot;YES&quot;) &#13;&#10;THEN ([ncr_joker_LC_nm] - [ncr_joker_LC_tm]) *&#13;&#10;{ FIXED [date_month],[partner_id]: 1/COUNT([partner_id])}&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ( [NCR_churn_partner_gv_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_joker_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt] =&quot;YES&quot;)&#13;&#10;THEN ([ncr_joker_LC_nm] + [ncr_cpc_LC_nm] - [ncr_joker_LC_tm]-[ncr_cpc_LC_tm]) *&#13;&#10;{ FIXED [date_month],[partner_id]: 1/COUNT([partner_id])}&#13;&#10;&#13;&#10;ELSEIF ([NCR_churn_partner_gv_bdgt]=&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_joker_bdgt]&lt;&gt;&quot;YES&quot; &#13;&#10;AND [NCR_churn_partner_bdgt] =&quot;YES&quot;)&#13;&#10;THEN ( [ncr_cpc_LC_nm] - [ncr_cpc_LC_tm]) *&#13;&#10;{ FIXED [date_month],[partner_id]: 1/COUNT([partner_id])}&#13;&#10;&#13;&#10;ELSE 0 END' />
      </column>
      <column caption='revenue_data_churn' datatype='real' name='[revenue_data_churn (copia)_1205275896793075712]' role='measure' type='quantitative'>
