          <datasource-dependencies datasource='federated.0njmip315otede1dxjnxn02eesje'>
            <column caption='Under or Upper' datatype='integer' name='[Calculation_298644952603131904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [last_commission_rate] &lt; [commission_floor] THEN 1&#13;&#10;ELSEIF [last_commission_rate] &gt;= [commission_floor] THEN 0&#13;&#10;END' />
            </column>
            <column caption='&lt; 15 orders per month' datatype='integer' name='[Calculation_298644952612392965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [last_commission_rate]&lt;[commission_floor] and [v_tot_confirmed_orders]&lt; 15 THEN 1 &#13;&#10;ELSEIF [last_commission_rate]&lt;[commission_floor] and [v_tot_confirmed_orders]&gt;= 15 THEN 0&#13;&#10;END' />
            </column>
            <column caption='% No Order Compliance' datatype='real' name='[Calculation_298644952613265415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_298644952612392965])/SUM([Calculation_298644952603131904])' />
            </column>
            <column caption='&lt; 60% Open Time' datatype='integer' name='[Calculation_298644952613908488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [last_commission_rate]&lt;[commission_floor] and [open_time]&lt;0.6 then 1&#13;&#10;ELSEIF [last_commission_rate]&lt;[commission_floor] and [open_time]&gt;= 0.6 then 0&#13;&#10;end' />
            </column>
            <column caption='% No Open Time' datatype='real' name='[Calculation_298644952614453257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_298644952613908488])/SUM([Calculation_298644952603131904])' />
            </column>
            <column caption='No Framework Compliance' datatype='integer' name='[Calculation_298644952614772747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [last_commission_rate]&lt;[commission_floor] and [Framework_Compliance_Day_15_H1] = &apos;No&apos; THEN 1&#13;&#10;ELSEIF [last_commission_rate]&lt;[commission_floor] AND [Framework_Compliance_Day_15_H1]=&apos;Yes&apos; THEN 0&#13;&#10;END' />
            </column>
            <column caption='% No FW Compliance' datatype='real' name='[Calculation_298644952616128524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_298644952614772747])/sum([Calculation_298644952603131904])' />
