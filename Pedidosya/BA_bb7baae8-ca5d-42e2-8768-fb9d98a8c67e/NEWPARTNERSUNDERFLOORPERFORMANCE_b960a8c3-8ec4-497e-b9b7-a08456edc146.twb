        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ecab6t0u7f0g10zw1jgw00t5ro2'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='automated_tables_reports' server-oauth='server-custom' username='carlota.castillo@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ecab6t0u7f0g10zw1jgw00t5ro2' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT DISTINCT
N.Grid,
C.restaurant_id,
C.franchise_id,
C.partner_name,
N.Month,
C.first_date_online,
N.Country_Name,
C.business_type_description,
C.Key_Account_Sub_Category,
C.v_tot_confirmed_orders,
C.last_commission_rate,
C.commission_floor,
FW.Framework_Compliance_Day_1_H1,
FW.Framework_Compliance_Day_15_H1,
FW.Framework_Compliance_Day_30_H1,
ot.open_time


FROM `peya-delivery-and-support.automated_tables_reports.CPA` AS N


LEFT JOIN `peya-food-and-groceries.automated_tables_reports.take_rate_nueva_tabla` AS C
ON N.Grid = C.salesforce_id


LEFT JOIN `peya-food-and-groceries.automated_tables_reports.Clasificacion_Adquisiciones` AS FW
ON N.GRID = FW.Salesforce_ID

LEFT JOIN 

(SELECT 

month_acquisition,
first_date_online,
GRID,
partner_id,
open_time

FROM `peya-delivery-and-support.automated_tables_reports.resultados_incubation_datastudio_delfi`
WHERE month_acquisition >>='2023-01-01') AS OT
ON N.GRID = OT.GRID
WHERE
--N.Month >> DATE(EXTRACT(YEAR FROM CURRENT_DATE('-3')), EXTRACT(MONTH FROM DATE_ADD(CURRENT_DATE('-3'), INTERVAL -3 MONTH)), 1)
--AND N.Month <<= DATE(EXTRACT(YEAR FROM CURRENT_DATE('-3')), EXTRACT(MONTH FROM CURRENT_DATE('-3')), 1)
--AND N.Month >>= '2023-04-01'
--AND N.Month <<= '2023-06-01'
N.Month >>= '2023-01-01'
AND N.Month << '2023-09-01'
AND business_type_description IN ('Restaurant', 'Coffee')]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ecab6t0u7f0g10zw1jgw00t5ro2' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT DISTINCT
