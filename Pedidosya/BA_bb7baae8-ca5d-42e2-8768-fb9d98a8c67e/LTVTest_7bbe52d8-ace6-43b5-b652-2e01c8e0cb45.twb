      <object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_5A10CE38A2C641D4B3136012B79B1A53'>
            <properties context=''>
              <relation connection='bigquery.0a19nyu17pqqj50zt19op1jhcgzm' name='Consulta SQL personalizada' type='text'>WITH active AS (&#13;&#10;  SELECT sp.Salesforce_id,DATE(cw.closed_date) AS Closed_date&#13;&#10;  FROM `peya-delivery-and-support.automated_tables_reports.salesplanning` sp&#13;&#10;  LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` cw&#13;&#10;  ON cw.grid=sp.Salesforce_ID&#13;&#10;  LEFT JOIN `peya-data-origins-pro.cl_salesforce.opportunity` op&#13;&#10;  ON op.AccountId=cw.account_id&#13;&#10;&#13;&#10;  WHERE Month=DATE_TRUNC(DATE_ADD(CURRENT_DATE(),INTERVAL -1 MONTH),MONTH)&#13;&#10;  AND Is_Online&#13;&#10;  AND op.Business_Type=&quot;New Business&quot;&#13;&#10;)&#13;&#10;&#13;&#10;SELECT sp.*, DATE_DIFF(CURRENT_DATE(),closed_date,MONTH) AS PartnerAge&#13;&#10;FROM `peya-delivery-and-support.automated_tables_reports.salesplanning` sp&#13;&#10;RIGHT JOIN active act ON act.salesforce_id=sp.Salesforce_ID</relation>
            </properties>
          </object>
        </objects>
      </object-graph>
