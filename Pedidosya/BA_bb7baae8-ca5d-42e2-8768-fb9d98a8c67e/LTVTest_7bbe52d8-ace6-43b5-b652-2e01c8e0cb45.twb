          <datasource-dependencies datasource='federated.1h8ery80ax5ty21gh0d4s0ugprvv'>
            <column datatype='date' name='[Acq_Month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[CPA]' role='measure' type='quantitative' />
            <column caption='Ms' datatype='string' name='[Calculation_841891723269652480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#13;&#10;DATEDIFF(&quot;month&quot;,[Acq_Month],[Month]) = 0&#13;&#10;THEN &quot;M0&quot;&#13;&#10;ELSEIF DATEDIFF(&quot;month&quot;,[Acq_Month],[Month]) = 1&#13;&#10;THEN &quot;M1&quot;&#13;&#10;ELSEIF DATEDIFF(&quot;month&quot;,[Acq_Month],[Month]) = 2&#13;&#10;THEN &quot;M2&quot;&#13;&#10;ELSEIF DATEDIFF(&quot;month&quot;,[Acq_Month],[Month]) = 3&#13;&#10;THEN &quot;M3&quot;&#13;&#10;ELSEIF DATEDIFF(&quot;month&quot;,[Acq_Month],[Month]) = 4&#13;&#10;THEN &quot;M4&quot;&#13;&#10;ELSEIF DATEDIFF(&quot;month&quot;,[Acq_Month],[Month]) = 5&#13;&#10;THEN &quot;M5&quot;&#13;&#10;ELSEIF DATEDIFF(&quot;month&quot;,[Acq_Month],[Month]) = 6&#13;&#10;THEN &quot;M6&quot;&#13;&#10;END' />
            </column>
            <column caption='Net' datatype='real' name='[Calculation_841891723275509762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([Gross_Profit]))+zn(sum([CPA]))' />
            </column>
            <column caption='GP x Partner' datatype='real' name='[Calculation_841891723895902213]' role='measure' type='quantitative'>
