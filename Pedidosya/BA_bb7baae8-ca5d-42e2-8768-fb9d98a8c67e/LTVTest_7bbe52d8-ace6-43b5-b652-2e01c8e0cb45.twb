      <aliases enabled='yes' />
      <column caption='Account Source' datatype='string' name='[AccountSource]' role='dimension' type='nominal' />
      <column caption='Business Type Name' datatype='string' name='[Business_Type_Name]' role='dimension' type='nominal' />
      <column caption='GP + NCR' datatype='real' name='[Calculation_2148217024643518464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_841891723275509762]+zn(SUM([NCR_profit]))' />
      </column>
      <column caption='New Partners' datatype='integer' name='[Calculation_2148217024650649601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF&#13;&#10; NOT ISNULL([CPA])&#13;&#10;THEN [Grid] ELSE NULL END)' />
      </column>
      <column caption='Active Partners' datatype='integer' name='[Calculation_2148217024652353539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF&#13;&#10; NOT ISNULL([Gross_Profit])&#13;&#10;THEN [Grid] ELSE NULL END)' />
      </column>
      <column caption='Active % from New' datatype='real' name='[Calculation_2148217024653238276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2148217024652353539]/&#13;&#10;RUNNING_SUM([Calculation_2148217024650649601])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Commission Rate' datatype='real' name='[Calculation_2148217024654331909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Com_Rev])/SUM([Total_GFV])' />
      </column>
      <column caption='Partners Using NCR' datatype='integer' name='[Calculation_2148217024656809991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF&#13;&#10; NOT ISNULL([NCR_profit])&#13;&#10;THEN [Grid] ELSE NULL END)' />
