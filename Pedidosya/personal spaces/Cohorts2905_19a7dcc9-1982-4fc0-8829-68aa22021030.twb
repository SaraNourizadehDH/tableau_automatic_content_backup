    <worksheet name='Inactive lifespan 30d %riders'>
      <table>
        <view>
          <datasources>
            <datasource caption='riders_cohorts_segmentos_juan (user_felipe_aguayo)' name='sqlproxy.1ajdtus1lgj9dc1ew8slz1xk786m' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.1ajdtus1lgj9dc1ew8slz1xk786m'>
            <column aggregation='Count' caption='Lifespan 30d' datatype='string' default-type='nominal' layered='true' name='[Calculation_1271703993608966144]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [Calculation_790944721302474754] = &quot;Active&quot; then &quot;Active&quot; &#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 30 then &quot;0-30&quot;&#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 90 then &quot;31-90&quot;&#13;&#10;else &quot;&gt;90&quot;&#13;&#10;end' />
            </column>
            <column aggregation='User' caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' default-type='quantitative' layered='true' name='[Calculation_1271703993609687041]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([total_payment])/sum([sum_working_hours])' />
            </column>
            <column aggregation='User' caption='Orders per rider AVG' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1271703993612836866]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='avg({ INCLUDE [rider_id]: sum([conf_orders])})' />
            </column>
            <column aggregation='Count' caption='Vehicle Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_1570630418869215232]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [rider_vehicle] = &quot;Bicicleta Plus&quot; then &quot;Bicicleta&quot; else [rider_vehicle] end' />
            </column>
            <column aggregation='Count' caption='Termino Contrato' datatype='string' default-type='nominal' layered='true' name='[Calculation_1620451495444078596]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if ISNULL([motivo_termino_compliance]) then &quot;Sin termino/No compliance&quot; else &quot;Compliance&quot; end&#13;&#10;&#13;&#10;&#13;&#10;//diapo 11: matrices de retencion con y sin compliance' />
            </column>
            <column aggregation='Sum' caption='Lifespan in days' datatype='integer' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_790944721300393984]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='datediff(&quot;day&quot;,[first_order_date],[last_order_date])' />
            </column>
            <column aggregation='Sum' caption='Days since last order' datatype='integer' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_790944721302118401]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='datediff(&quot;day&quot;,[last_order_date],today())' />
            </column>
            <column aggregation='Count' caption='Status aprox' datatype='string' default-type='nominal' layered='true' name='[Calculation_790944721302474754]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [Calculation_790944721302118401]&lt;=30 then &quot;Active&quot;&#13;&#10;else &quot;Inactive&quot;&#13;&#10;end' />
            </column>
            <column aggregation='User' caption='CPO Rider' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' default-type='quantitative' layered='true' name='[Calculation_961237082733350912]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
