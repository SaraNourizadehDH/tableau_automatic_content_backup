      <column aggregation='Count' caption='Dimension for analysis' datatype='string' default-type='nominal' layered='true' name='[Calculation_1151232682008043521]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=1&#13;&#10;then [source]&#13;&#10;ELSEIF  [Parameters].[Parameter 1]=2&#13;&#10;then [link_type]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=3&#13;&#10;then [current_stage_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=4 then [Calculation_1151232682008354818]&#13;&#10;else [Calculation_1151232682008354818]&#13;&#10;end' />
      </column>
      <column aggregation='Count' caption='Country' datatype='string' default-type='nominal' layered='true' name='[Calculation_1151232682008354818]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='&quot;cl&quot;' />
      </column>
      <column aggregation='Count' caption='Lifespan 30d' datatype='string' default-type='nominal' layered='true' name='[Calculation_1271703993608966144]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if [Calculation_790944721302474754] = &quot;Active&quot; then &quot;Active&quot; &#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 30 then &quot;0-30&quot;&#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 90 then &quot;31-90&quot;&#13;&#10;else &quot;&gt;90&quot;&#13;&#10;end' />
      </column>
      <column aggregation='User' caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' default-type='quantitative' layered='true' name='[Calculation_1271703993609687041]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='sum([total_payment])/sum([sum_working_hours])' />
      </column>
      <column aggregation='User' caption='Orders per rider AVG' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1271703993612836866]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='avg({ INCLUDE [rider_id]: sum([conf_orders])})' />
      </column>
      <column aggregation='Sum' caption='Month btw contract and shift' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1271703993628102659]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[week_1st_contract], [week_shift])' />
      </column>
      <column aggregation='Count' caption='Vehicle Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_1570630418869215232]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
