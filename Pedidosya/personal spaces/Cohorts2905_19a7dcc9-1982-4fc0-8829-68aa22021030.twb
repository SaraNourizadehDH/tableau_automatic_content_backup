            <column aggregation='User' caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' default-type='quantitative' layered='true' name='[Calculation_803048133027172357]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([orders])/sum([sum_working_hours])' />
