        <calculation class='tableau' formula='case [city_name]&#13;&#10;when &quot;Buin&quot; then &quot;RM&quot;&#13;&#10;when &quot;Colina&quot; then &quot;RM&quot;&#13;&#10;when &quot;Penaflor&quot; then &quot;RM&quot;&#13;&#10;when &quot;Santiago&quot; then &quot;RM&quot;&#13;&#10;&#13;&#10;when &quot;Antofagasta&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Arica&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Calama&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Copiapo&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Iquique&quot; then &quot;Norte&quot;&#13;&#10;when &quot;La serena&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Ovalle&quot; then &quot;Norte&quot;&#13;&#10;&#13;&#10;when &quot;Chillan&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Concepcion&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Coyhaique&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Curico&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Linares&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Los angeles&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Osorno&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Puerto montt&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Puerto varas&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Punta arenas&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Rancagua&quot; then &quot;Sur&quot;&#13;&#10;when &quot;San fernando&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Talca&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Temuco&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Valdivia&quot; then &quot;Sur&quot;&#13;&#10;&#13;&#10;when &quot;Melipilla&quot; then &quot;Centro&quot;&#13;&#10;when &quot;San antonio&quot; then &quot;Centro&quot;&#13;&#10;when &quot;San felipe  los andes&quot; then &quot;Centro&quot;&#13;&#10;when &quot;Vina del mar&quot; then &quot;Centro&quot;&#13;&#10;else [city_name]&#13;&#10;end' />
