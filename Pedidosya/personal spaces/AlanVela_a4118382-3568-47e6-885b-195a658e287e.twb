            <column aggregation='Count' caption='Country Name' datatype='string' default-type='nominal' layered='true' name='[country_name]' pivot='key' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' caption='Date Click' datatype='date' default-type='ordinal' layered='true' name='[date_click]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Count' caption='Franchise Name' datatype='string' default-type='nominal' layered='true' name='[franchise_name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
