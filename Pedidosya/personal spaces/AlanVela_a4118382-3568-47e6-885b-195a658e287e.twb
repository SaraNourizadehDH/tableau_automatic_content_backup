          <datasource-dependencies datasource='sqlproxy.037zdz50x6u1h5148k0wy0yllyno'>
            <column caption='Budget Utilization (copy)' datatype='real' name='[Budget Utilization (copy)_975873763588280320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (sum([final_clicks_spend_gv]+[final_clicks_spend_fp_cpc]+final_clicks_spend_kw)/sum([final_budget_clicks_gv]+[final_budget_clicks_fp_cpc]+[final_budget_clicks_kw]))&#10;&gt; 1 THEN 1 ELSE&#10;(sum([final_clicks_spend_gv]+[final_clicks_spend_fp_cpc]+final_clicks_spend_kw)/sum([final_budget_clicks_gv]+[final_budget_clicks_fp_cpc]+[final_budget_clicks_kw]))&#10;END' />
            </column>
            <column aggregation='User' caption='CVR Ads' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1025976298648100872]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([orders_ads])/SUM([clicks_ads])' />
            </column>
            <column caption='Inversión NCR' datatype='real' name='[Calculation_1061653301804576768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE origin WHEN &quot;Joker&quot; THEN [ncr_investment]&#10;&#9;&#9;&#9;&#9;WHEN &quot;GoldVIP Category CPP&quot; THEN [ncr_investment]&#10;                WHEN &quot;Featured Products CPP&quot; THEN [ncr_investment]&#10;&#9;ELSE [Calculation_8397383741728382976]*[Calculation_7184508089733861376] END)' />
            </column>
            <column aggregation='User' caption='AOV Total' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1273674281319755779]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([gmv_total])/SUM([orders_total])' />
            </column>
            <column caption='Comisión' datatype='real' name='[Calculation_5226075570862661632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue])/SUM(IF [GFV_gross] = 0 THEN 1 ELSE [GFV_gross] END)' />
            </column>
            <column caption='Origen' datatype='string' name='[Calculation_5288281543192670208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [origin] WHEN &quot;Unknown&quot; THEN &quot;Organic&quot;&#10;ELSE [origin] END' />
            </column>
            <column caption='Budget Clicks' datatype='real' name='[Calculation_661395852708720640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([final_budget_clicks_gv])+sum([final_budget_clicks_fp_cpc])+sum([final_budget_clicks_kw])' />
            </column>
            <column caption='Product' datatype='string' name='[Calculation_7023293294324563970]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [origin] WHEN &quot;CPC Swimlanes&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;GoldVIP CPC&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;GoldVIP Search&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;GoldVIP Category CPC&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;CPC Campaigns&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;Featured Restaurants CPC&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;Unknown&quot; THEN &quot;Organic&quot;&#10;ELSE [origin] END' />
            </column>
            <column caption='CPC (Costo por Click)' datatype='real' name='[Calculation_7184508089733861376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_7023293294324563970]WHEN &quot;GoldVIP CPC&quot; THEN [ncr_investment]/[final_clicks_spend_gv]&#10;&#9;&#9;&#9; WHEN &quot;Featured Products CPC&quot; THEN [ncr_investment]/[final_clicks_spend_fp_cpc]&#10;             WHEN &quot;Keywords&quot; THEN [ncr_investment]/[final_clicks_spend_kw]&#10;             &#10;END' />
            </column>
            <column aggregation='User' caption='AOV Ads' datatype='real' default-type='quantitative' layered='true' name='[Calculation_751256713252052995]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([gmv_ads])/SUM([orders_ads])' />
            </column>
            <column caption='Clicks Facturados Ads' datatype='real' name='[Calculation_8397383741728382976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF(CASE [origin] WHEN &quot;GoldVIP Category CPC&quot; THEN [final_clicks_spend_gv]&#10;&#9; WHEN &quot;GoldVIP CPC&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;GoldVIP Search&quot; Then [final_clicks_spend_gv]&#10;     WHEN &quot;Featured Restaurants CPC&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;CPC Swimlanes&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;CPC Campaigns&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;Keywords&quot; THEN [final_clicks_spend_kw]&#10;     WHEN &quot;Featured Products CPC&quot; THEN [final_clicks_spend_fp_cpc]&#10;     ELSE [clicks_total]END&#10;     -&#10;CASE [origin] WHEN &quot;GoldVIP Category CPC&quot; THEN [final_budget_clicks_gv]&#10;&#9; WHEN &quot;GoldVIP CPC&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;GoldVIP Search&quot; Then [final_budget_clicks_gv]&#10;     WHEN &quot;Featured Restaurants CPC&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;CPC Swimlanes&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;CPC Campaigns&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;Keywords&quot; THEN [final_budget_clicks_kw]&#10;     WHEN &quot;Featured Products CPC&quot; THEN [final_budget_clicks_fp_cpc]&#10;     ELSE [clicks_total] END) &gt; 0 THEN&#10;     &#10;(CASE [origin] WHEN &quot;GoldVIP Category CPC&quot; THEN [final_budget_clicks_gv]&#10;&#9; WHEN &quot;GoldVIP CPC&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;GoldVIP Search&quot; Then [final_budget_clicks_gv]&#10;     WHEN &quot;Featured Restaurants CPC&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;CPC Swimlanes&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;CPC Campaigns&quot; THEN [final_budget_clicks_gv]&#10;     WHEN &quot;Keywords&quot; THEN [final_budget_clicks_kw]&#10;     WHEN &quot;Featured Products CPC&quot; THEN [final_budget_clicks_fp_cpc]&#10;     ELSE [clicks_total] END)&#10; ELSE&#10; (CASE [origin] WHEN &quot;GoldVIP Category CPC&quot; THEN [final_clicks_spend_gv]&#10;&#9; WHEN &quot;GoldVIP CPC&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;GoldVIP Search&quot; Then [final_clicks_spend_gv]&#10;     WHEN &quot;Featured Restaurants CPC&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;CPC Swimlanes&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;CPC Campaigns&quot; THEN [final_clicks_spend_gv]&#10;     WHEN &quot;Keywords&quot; THEN [final_clicks_spend_kw]&#10;     WHEN &quot;Featured Products CPC&quot; THEN [final_clicks_spend_fp_cpc]&#10;     ELSE [clicks_total]END)&#10; END' />
            </column>
