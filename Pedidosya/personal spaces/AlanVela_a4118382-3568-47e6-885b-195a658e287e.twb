    <dashboard name='NCR Ads'>
      <repository-location derived-from='http://ip-172-31-0-134:8278/t/Pedidosya/workbooks/AlanVela/NCRAds?rev=' id='166454' path='/t/Pedidosya/workbooks/AlanVela' revision='' site='Pedidosya' />
      <style />
      <size maxheight='827' maxwidth='1169' minheight='827' minwidth='1169' preset-index='16' sizing-mode='fixed' />
      <datasources>
        <datasource caption='ncr_peyaads_peya_ads_by_partner (automated_tables_reports)' name='sqlproxy.037zdz50x6u1h5148k0wy0yllyno' />
      </datasources>
      <datasource-dependencies datasource='sqlproxy.037zdz50x6u1h5148k0wy0yllyno'>
        <column caption='Origen' datatype='string' name='[Calculation_5288281543192670208]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [origin] WHEN &quot;Unknown&quot; THEN &quot;Organic&quot;&#10;ELSE [origin] END' />
        </column>
        <column caption='Product' datatype='string' name='[Calculation_7023293294324563970]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [origin] WHEN &quot;CPC Swimlanes&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;GoldVIP CPC&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;GoldVIP Search&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;GoldVIP Category CPC&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;CPC Campaigns&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;Featured Restaurants CPC&quot; THEN &quot;GoldVIP CPC&quot;&#10;WHEN &quot;Unknown&quot; THEN &quot;Organic&quot;&#10;ELSE [origin] END' />
        </column>
        <column aggregation='Count' caption='Business Type' datatype='string' default-type='nominal' layered='true' name='[businessType]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' caption='City Name' datatype='string' default-type='nominal' layered='true' name='[city_name]' pivot='key' role='dimension' semantic-role='[City].[Name]' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' caption='Country Name' datatype='string' default-type='nominal' layered='true' name='[country_name]' pivot='key' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Year' caption='Date Click' datatype='date' default-type='ordinal' layered='true' name='[date_click]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
        <column aggregation='Count' caption='Franchise Name' datatype='string' default-type='nominal' layered='true' name='[franchise_name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
