      <column caption='SUM([Ncr Investment])/sum([Clicks Ads])' datatype='real' name='[Calculation_1025976298612015109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ncr_investment])/sum([clicks_ads])' />
      </column>
      <column caption='ROAS Ads' datatype='real' name='[Calculation_1025976298619011079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_ads])/SUM([ncr_investment])' />
      </column>
      <column caption='CVR Ads' datatype='real' name='[Calculation_1025976298648100872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_ads])/SUM([clicks_ads])' />
      </column>
      <column caption='Marca' datatype='string' name='[Calculation_1047649894078095360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [origin_group] = &apos;Ads&apos; then &apos;Sí&apos; else &apos;No&apos; end' />
      </column>
      <column caption='Budget Utilization' datatype='real' name='[Calculation_1058627396881690632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([final_clicks_spend_gv])/sum([final_budget_clicks_gv])' />
