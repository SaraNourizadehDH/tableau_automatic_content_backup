            <column aggregation='Sum' caption='Clicks Total' datatype='integer' default-type='quantitative' layered='true' name='[clicks_total]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' caption='Commission Revenue' datatype='real' default-type='quantitative' layered='true' name='[commission_revenue]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
