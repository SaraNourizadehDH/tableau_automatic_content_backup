    <worksheet name='MBR'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta_SQL_personalizada (automated_tables_reports)' name='federated.01j645u13uvim61acos6n0qx06fi' />
          </datasources>
          <datasource-dependencies datasource='federated.01j645u13uvim61acos6n0qx06fi'>
            <column caption='Promised Delivery Time' datatype='real' name='[Calculation_1223853201591836673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_promised_delivery_time])/&#13;&#10;sum([orders_completed])' />
            </column>
            <column caption='Fill Rate' datatype='real' name='[Calculation_124130465141739521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([slots_assigned])&#13;&#10;/&#13;&#10;sum([slots_open])' />
            </column>
            <column caption='Total Fail Rate' datatype='real' name='[Calculation_124130465247485955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([fact_orders_total])-sum([fact_orders_completed]))/&#13;&#10;sum([fact_orders_total])' />
            </column>
            <column caption='Delivery Related Fail Rate' datatype='real' name='[Calculation_124130465247981572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fact_delivery_related_non_confirmed_orders])/&#13;&#10;sum([fact_orders_total])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_566046212629090304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([orders_completed])&#13;&#10;/&#13;&#10;sum([sum_actual_evaluated_working_hours])' />
            </column>
            <column caption='DT Avg' datatype='real' name='[Calculation_566046212631195650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_actual_delivery_time])&#13;&#10;/&#13;&#10;SUM([orders_completed])' />
            </column>
            <column caption='OL % 10&apos;' datatype='real' name='[Calculation_566046212633907204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10])&#13;&#10;/&#13;&#10;SUM([order_delay_base])' />
            </column>
            <column caption='VL %' datatype='real' name='[Calculation_566046212634955781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10])&#13;&#10;/&#13;&#10;SUM([vendor_late_not_null])' />
            </column>
            <column caption='Stacking' datatype='real' name='[Calculation_566046212646969351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked])&#13;&#10;/&#13;&#10;SUM([orders_completed])' />
            </column>
            <column caption='Under 20 min' datatype='real' name='[Calculation_566046212651651080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_under_20])&#13;&#10;/&#13;&#10;SUM([orders_completed])' />
            </column>
            <column caption='RL %' datatype='real' name='[Calculation_566046212654039049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10])&#13;&#10;/&#13;&#10;SUM([rider_late_not_null])' />
            </column>
            <column caption='Order Delay Avg' datatype='real' name='[Calculation_810929410497368067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_order_delay])/sum([orders_completed])' />
            </column>
            <column caption='Under 15&apos;' datatype='real' name='[Calculation_815996022403260418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_under_15])&#13;&#10;/&#13;&#10;sum([orders_completed])' />
            </column>
            <column caption='PU Distance' datatype='real' name='[Calculation_815996022404104195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_pickup_distance])/1000&#13;&#10;/&#13;&#10;sum([orders_completed_w_preorders])' />
            </column>
            <column caption='DO Distance' datatype='real' name='[Calculation_815996022404272132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_dropoff_distance])/1000&#13;&#10;/&#13;&#10;sum([orders_completed_w_preorders])' />
            </column>
            <column caption='No Show %' datatype='real' name='[Calculation_873135379913338880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([ns_hours])+sum([excused_ns_hours]))&#13;&#10;/&#13;&#10;sum([shift_hours])' />
            </column>
            <column caption='OL % 25&apos;' datatype='real' name='[OL % 10&apos; (copia)_512002991178407936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_25])&#13;&#10;/&#13;&#10;SUM([order_delay_base])' />
            </column>
