      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-aliased-fields='true' show-hidden-fields='true' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Argentina&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_14791C747905481A957CB77062DA3C54'>
            <properties context=''>
              <relation connection='bigquery.0i4fcz31fbvwe6187h07z0v9buz3' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH
----------------------------------------------------------------------------------------
-- Rango de fechas
dates as 
  /*(SELECT  DATE_ADD(date_sub(last_day(current_date() , isoweek)+1, interval 13 week), INTERVAL (-1 * EXTRACT(DAY FROM date_sub(last_day(current_date() , isoweek)+1, interval 13 week))+1) day)
 as date_from),
*/

  (SELECT date_sub(last_day(current_date() , isoweek), interval 13 week) as date_from),  -- Con esta forma de traer la fecha optimizo un poco de código. Básicamente lo que hace es agarrar la semana corriente, ver el último dia que siempre es domingo y traer 13 semanas para atrás  
  

-----------------------------------------------------------------------------------------
--Métricas de las zonas, DT,#orders,prep,late,etc...
orders as
  (SELECT
    ord.country_code, -- código
    DATE(del.rider_dropped_off_at, ord.timezone) AS date_local,-- fecha
    ord.city.city_id, -- ciudad
    ord.zone.zone_id, -- zona
    COUNT(IF(del.delivery_status = 'completed' and ord.is_preorder = FALSE, ord.order_id, NULL)) AS orders_completed, -- total ordenes completadas
    COUNT(IF(del.delivery_status = 'completed', ord.order_id, NULL)) AS orders_completed_w_preorders, -- total con preorders 
    sum(IF(ord.is_preorder = FALSE, (ord.timings.actual_delivery_time)/60,0)) AS sum_actual_delivery_time, -- suma del dt
    sum(IF(ord.is_preorder = FALSE, (ord.timings.rider_accepting_time)/60,0)) AS sum_accepting_time, -- suma p accepting time
    sum(IF(ord.is_preorder = FALSE, (ord.timings.to_vendor_time)/60,0)) AS sum_to_vendor_time, -- suma tvt
    sum(IF(ord.is_preorder = FALSE, (ord.timings.at_vendor_time)/60,0)) AS sum_at_vendor_time, -- suma avt
    sum(IF(ord.is_preorder = FALSE, (ord.timings.to_customer_time)/60,0)) AS sum_to_customer_time, -- suma tct
    sum(IF(ord.is_preorder = FALSE, (ord.timings.at_customer_time)/60,0)) AS sum_at_customer_time, -- suma act
    sum(IF(ord.is_preorder = FALSE, (ord.timings.promised_delivery_time)/60,0)) AS sum_promised_delivery_time, --suma pdt
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay/60>>10 THEN ord.peya_order_id ELSE NULL END) AS order_late_10, -- ol10
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS order_late_25,-- ol25
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay IS NOT NULL THEN ord.peya_order_id ELSE NULL END) AS order_delay_base, --delay
    COUNT(DISTINCT CASE WHEN ord.timings.actual_delivery_time/60<<20 THEN ord.order_id ELSE NULL END) AS order_under_20, -- under20
    COUNT(DISTINCT CASE WHEN ord.timings.actual_delivery_time/60<<15 THEN ord.order_id ELSE NULL END) AS order_under_15, -- under15
    sum(IF(ord.is_preorder = FALSE, (CASE WHEN del.stacked_deliveries >>= 1 THEN 1 ELSE 0 END),0)) AS stacked, --stacking
    sum(IF(ord.is_preorder = FALSE, (ord.estimated_prep_time)/60,0)) AS estimated_prep_time,  -- est preptime
    sum(IF(ord.is_preorder = FALSE, (ord.timings.assumed_actual_preparation_time)/60,0)) AS assumed_actual_prep_time, -- actualprep
    COUNT(DISTINCT CASE WHEN ord.is_vendor_late_10 = 1 THEN ord.order_id ELSE NULL END) AS vendor_late_10, -- vl10
    COUNT(DISTINCT CASE WHEN ord.timings.vendor_late IS NOT NULL THEN ord.peya_order_id ELSE NULL END) AS vendor_late_not_null, -- conteo de vl
    COUNT(DISTINCT CASE WHEN del.timings.rider_late/60>>10 THEN del.delivery_id ELSE NULL END) AS rider_late_10, -- rl10
    COUNT(DISTINCT CASE WHEN del.timings.rider_late IS NOT NULL THEN del.delivery_id ELSE NULL END) AS rider_late_not_null, -- conteo rl
    sum(IF(ord.is_preorder = FALSE, ord.timings.order_delay/60,0)) AS sum_order_delay, -- orderdelay
    sum(del.pickup_distance_manhattan) as sum_pickup_distance, -- pud
    sum(del.dropoff_distance_manhattan) as sum_dropoff_distance, -- dod
    sum(CASE WHEN ord.order_status = 'cancelled' THEN 1 ELSE 0 END) AS orders_cancelled, -- orders canceladas
    sum( CASE WHEN ord.order_status = 'cancelled' AND ord.cancellation.reason IN ('TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_RIDER_ACCIDENT','TRAFFIC_MANAGER_WEATHER_ISSUE','WRONG_ORDER_ITEMS_DELIVERED','COURIER_UNREACHABLE','NEVER_DELIVERED','BAD_WEATHER','UNPROFESSIONAL_BEHAVIOUR','COURIER_ACCIDENT','DELIVERY_ETA_TOO_LONG','LATE_DELIVERY','NO_COURIER') THEN 1 ELSE 0 END) as orders_cancelled_logistics, --owner cancelled log
    sum( CASE WHEN ord.order_status = 'cancelled' AND ord.cancellation.reason IN ('TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_NO_RIDER','NO_COURIER') THEN 1 ELSE 0 END) as        orders_cancelled_logistics_rider, --owner cancelled rider
  FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders`  as ord, dates -- me traigo dos fuentes de información, acá puedo usar tablas definidas anteriormente.
  LEFT JOIN UNNEST(deliveries) AS del ON is_primary -- joineo el delivery con el delivery primario
  WHERE ord.created_date BETWEEN date_from and current_date() --restrinjo la fecha
    AND ord.created_date_local BETWEEN  date_from and CURRENT_DATE -- restrinjo la fecha x2 (en fecha local)
  GROUP BY -- agrupaciones
    ord.country_code,
    DATE(del.rider_dropped_off_at, ord.timezone),
    ord.city.city_id,
    ord.zone.zone_id),


-----------------------------------------------------------------------------------------
shifts as
  (SELECT
    country_code, --pais
    e.day AS last_date_shifts, -- cuando empezó la evaluación de las horas trabajadas
    city.city_id, -- city 
    zone.zone_id, -- zone
    ROUND(SUM(CASE WHEN  shifts.shift_state = 'EVALUATED' THEN (e.duration / 60 / 60) ELSE NULL END)) AS sum_actual_evaluated_working_hours, --horas evaluadas
    count(DISTINCT CASE WHEN shifts.shift_state != 'CANCELLED' THEN shifts.shift_id ELSE NULL END) AS sum_shifts_planned,--cantidad de shifts (no en horas, en recuento)
    coalesce(sum(CASE WHEN shifts.shift_state = 'NO_SHOW' THEN DATETIME_DIFF(DATETIME (shifts.shift_start_at), DATETIME (shifts.shift_end_at), HOUR) END),0) AS sum_planned_no_show_working_hours, --fcst_noshow
    coalesce(sum(CASE WHEN shifts.shift_state != 'CANCELLED' THEN DATETIME_DIFF(DATETIME (shifts.shift_start_at), DATETIME (shifts.shift_end_at), HOUR) END),0) AS sum_planned_all_working_hours --fcst_workinghours
  FROM `peya-bi-tools-pro.il_logistics.fact_logistic_shifts` as shifts, dates
  LEFT JOIN UNNEST(shifts.actual_working_time_by_date) e
  WHERE DATE(shifts.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE-180, interval -1 month), month)-1 --esta parte está rara, no restringe mucho que digamos
    AND e.day << CURRENT_DATE()
    AND DATE(DATETIME(shifts.created_at,shifts.timezone)) BETWEEN  date_from and CURRENT_DATE
    AND shift_state NOT IN ('CANCELLED')
  GROUP BY 1,2,3,4),



  -----------------------------------------------------------------------------------------
staffing_kpi as -- esta tabla tiene errores de origen
  (SELECT
    country_code,
    created_date_local as date_local,
    city_id,
    zone_id,
    SUM(open_slots_assigned) slots_assigned, -- suma de slots asignados
    SUM(open_slots_size) slots_open, -- slots abiertos 
    SUM(planned_shift_duration / 3600) AS shift_hours,-- horas planeadas
    SUM(no_shows_duration / 3600) AS ns_hours, -- horas no show
    SUM(excused_no_shows_duration / 3600) AS excused_ns_hours, -- 
    SUM(orders_actuals) as orders_actuals, -- 
    SUM(close_orders_lost_net) as close_orders_lost_net, -- lost x close
    SUM(shrink_orders_lost_net) as shrink_orders_lost_net, -- lost x shrink 
    SUM(adjusted_orders) as adjusted_orders -- orders adjusted
   FROM `peya-data-origins-pro.cl_hurrier.staffing_kpi`, dates
   WHERE created_date_local BETWEEN date_from and CURRENT_DATE
   GROUP BY 1,2,3,4),


   
   ----------------------------------------------------------------------------------------
factorders as
  (SELECT
    LOWER(country.country_code) as country_code, 
    registered_date as date_local,
    Sum(case when ord.order_id is not null then 1 else 0 end) AS fact_orders_total, -- orders total 
    sum(case when ord.rejected_order = 0 then 1 else 0 end) as fact_orders_completed, -- orders not rejected
    COUNT(IF(rejectMessage.globalCode in ("NO_COURIER",
    "NO_PICKER",
    "TECHNICAL_PROBLEM",
    "UNREACHABLE",
    "OUTSIDE_SERVICE_HOURS",
    "COURIER_UNREACHABLE",
    "OUTSIDE_DELIVERY_AREA",
    "LATE_DELIVERY",
    "UNPROFESSIONAL_BEHAVIOUR",
    "CONTENT_WRONG_MISLEADING",
    "NEVER_DELIVERED",
    "DELIVERY_ETA_TOO_LONG"), order_id, NULL)) AS fact_delivery_related_non_confirmed_orders, -- non confirmed orders
    FROM `peya-bi-tools-pro.il_core.fact_orders` ord, dates 
    WHERE registered_date BETWEEN  date_from and CURRENT_DATE
    GROUP BY 1,2)
-----------------------------------------------------------------------------------------------------------------------



SELECT 
    orders.date_local,
    orders.orders_completed_w_preorders,
    geo.city_name,
    geo.zone_name,
    geo.country_name,
    orders_completed,
    sum_actual_delivery_time,
    sum_accepting_time,
    sum_to_vendor_time,
    sum_at_vendor_time,
    sum_to_customer_time,
    sum_at_customer_time,
    sum_promised_delivery_time,
    order_late_10,
    order_late_25,
    order_delay_base,
    order_under_20,
    order_under_15,
    stacked,
    estimated_prep_time,
    assumed_actual_prep_time,
    vendor_late_10,
    vendor_late_not_null,
    rider_late_10,
    rider_late_not_null,
    sum_order_delay,
    sum_pickup_distance,
    sum_dropoff_distance,
    orders_cancelled,
    orders_cancelled_logistics,
    orders_cancelled_logistics_rider,
    sum_actual_evaluated_working_hours,
    sum_shifts_planned,
    sum_planned_no_show_working_hours,
    sum_planned_all_working_hours,
    slots_assigned,
    slots_open,
    shift_hours,
    ns_hours,
    excused_ns_hours,
    orders_actuals,
    close_orders_lost_net,
    shrink_orders_lost_net,
    adjusted_orders,
    fact_orders_total,
    fact_orders_completed,
    fact_delivery_related_non_confirmed_orders,
FROM orders
JOIN shifts ON (orders.country_code = shifts.country_code
    AND orders.date_local = shifts.last_date_shifts
    AND orders.city_id = shifts.city_id
    AND orders.zone_id = shifts.zone_id)
JOIN staffing_kpi ON (orders.country_code = staffing_kpi.country_code
    AND orders.date_local = staffing_kpi.date_local
    AND orders.city_id = staffing_kpi.city_id
    AND orders.zone_id = staffing_kpi.zone_id)
LEFT JOIN factorders ON (orders.country_code = lower(factorders.country_code)
    AND orders.date_local = factorders.date_local)
JOIN (SELECT
        countries.country_code, 
        countries.country_name,
        cities.id as city_id,
        cities.name as city_name,
        zones.id as zone_id,
        zones.name as zone_name
    FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries,
        UNNEST(cities) cities,
        UNNEST(zones) zones
    )geo ON (orders.country_code = geo.country_code
        AND orders.city_id = geo.city_id
        AND orders.zone_id = geo.zone_id)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
