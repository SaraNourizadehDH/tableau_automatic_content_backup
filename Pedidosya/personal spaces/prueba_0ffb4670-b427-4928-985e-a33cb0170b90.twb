              <calculation class='tableau' formula='([Calculation_124130465141739521]-LOOKUP([Calculation_124130465141739521],7))&#13;&#10;/&#13;&#10;LOOKUP([Calculation_124130465141739521],7)'>
                <table-calc ordering-type='Rows' />
