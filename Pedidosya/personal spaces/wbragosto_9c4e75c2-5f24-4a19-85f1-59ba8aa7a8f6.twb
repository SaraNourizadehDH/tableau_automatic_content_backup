    <worksheet name='MBR 4'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta_SQL_personalizada (automated_tables_reports)' name='federated.01j645u13uvim61acos6n0qx06fi' />
          </datasources>
          <datasource-dependencies datasource='federated.01j645u13uvim61acos6n0qx06fi'>
            <column caption='last_day_prev_month_2' datatype='date' name='[Calculation_1069323459434602499]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF (MONTH(TODAY()) = MONTH([date_local])) THEN DATE(&apos;1999-01-01&apos;) &#13;&#10;ELSE [date_local]&#13;&#10;END' />
            </column>
            <column caption='Delivery Related FR Var Monthly' datatype='real' name='[Calculation_1152640056257138696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_124130465247981572]-LOOKUP([Calculation_124130465247981572],1))/&#13;&#10;LOOKUP([Calculation_124130465247981572],1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Fail Rate' datatype='real' name='[Calculation_124130465247485955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([fact_orders_total])-sum([fact_orders_completed]))/&#13;&#10;sum([fact_orders_total])' />
            </column>
            <column caption='Delivery Related Fail Rate' datatype='real' name='[Calculation_124130465247981572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fact_delivery_related_non_confirmed_orders])/&#13;&#10;sum([fact_orders_total])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_566046212629090304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([orders_completed])&#13;&#10;/&#13;&#10;sum([sum_actual_evaluated_working_hours])' />
            </column>
            <column caption='DT Avg' datatype='real' name='[Calculation_566046212631195650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_actual_delivery_time])&#13;&#10;/&#13;&#10;SUM([orders_completed])' />
            </column>
            <column caption='OL % 10&apos;' datatype='real' name='[Calculation_566046212633907204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_10])&#13;&#10;/&#13;&#10;SUM([order_delay_base])' />
            </column>
            <column caption='DT Var Monthly' datatype='real' name='[DT Var Weekly (copy)_1152640056257560586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_566046212631195650]-LOOKUP([Calculation_566046212631195650],1))&#13;&#10;/&#13;&#10;LOOKUP([Calculation_566046212631195650],1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='OL% 10&apos; Var Monthly' datatype='real' name='[OL% 10&apos; Var Weekly (copy)_1152640056257761291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_566046212633907204]-LOOKUP([Calculation_566046212633907204],1))&#13;&#10;/&#13;&#10;LOOKUP([Calculation_566046212633907204],1)'>
                <table-calc ordering-type='Rows' />
