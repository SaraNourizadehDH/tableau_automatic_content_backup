          <datasource-dependencies datasource='Parameters'>
            <column alias='Upselling' caption='Tools' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;upselling&quot;'>
              <calculation class='tableau' formula='&quot;upselling&quot;' />
              <aliases>
                <alias key='&quot;branded_section_qc&quot;' value='Branded Section QC' />
                <alias key='&quot;descuentos&quot;' value='Descuentos' />
                <alias key='&quot;email&quot;' value='Email' />
                <alias key='&quot;free_delivery&quot;' value='Free Delivery' />
                <alias key='&quot;in_app_message&quot;' value='In App Message' />
                <alias key='&quot;push&quot;' value='Push' />
                <alias key='&quot;section_header_qc&quot;' value='Section Header QC' />
                <alias key='&quot;tienda propia&quot;' value='Tienda Propia' />
                <alias key='&quot;upselling&quot;' value='Upselling' />
                <alias key='&quot;vouchers&quot;' value='Vouchers' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0he34ql1ppn4wx14edkim0a6jdsp'>
            <column caption='tool_filter' datatype='boolean' name='[Calculation_1445655526922694658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[tool]=[Parameters].[Parámetro 1]' />
            </column>
            <column caption='Open Rate' datatype='real' name='[Calculation_759701008738275329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([cupon_usado])/SUM([sent])&#13;&#10;WHEN &quot;push&quot; THEN SUM([clicked])/SUM([sent])&#13;&#10;WHEN &quot;in_app_message&quot; THEN SUM([clicked])/SUM([sent])&#13;&#10;WHEN &quot;email&quot; THEN SUM([clicked])/SUM([sent])&#13;&#10;&#13;&#10;END' />
