      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_99605E0C8B5A44E2B7B6FB6B01328E63'>
            <properties context=''>
              <relation connection='bigquery.02671p60qkuzfb1cx61cy1b2p3xi' name='Consulta SQL personalizada' type='text'>WITH braze AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
date&#13;
, campaign_id&#13;
, campaign_name&#13;
, country_name&#13;
, tool&#13;
, &apos;NA&apos; as brand_name&#13;
, SUM(sent)    as sent&#13;
, SUM(clicked) as clicked&#13;
, COUNT(DISTINCT user_id) as users&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_braze_push_iam_mailing`&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
UNPIVOT(values FOR metrics IN (sent, clicked, users))&#13;
)&#13;
&#13;
, section_header_qc AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
date&#13;
, campaign_id&#13;
, subcategory_name AS campaign_name&#13;
, country_name&#13;
, &apos;section_header_qc&apos; as tool&#13;
, brand_name&#13;
, COUNT(DISTINCT CONCAT(sessionId)) as impresions&#13;
, COUNT(DISTINCT user_id) as users&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_section_header_qc`&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
UNPIVOT(values FOR metrics IN (impresions, users))&#13;
)&#13;
&#13;
,branded_section_qc AS (&#13;
  SELECT *&#13;
  FROM (&#13;
    SELECT &#13;
            date&#13;
          , campaign_id&#13;
          , campaign_name&#13;
          , country_name&#13;
          , &apos;branded_section_qc&apos; as tool&#13;
          , brand_name&#13;
          , COUNT(DISTINCT (CASE WHEN branded_section_seen &gt;&gt; 0 THEN session_Id ELSE null END)) as impresions&#13;
          , COUNT(DISTINCT (CASE WHEN branded_section_clicked &gt;&gt; 0 THEN session_Id ELSE null END)) as clicked&#13;
          , COUNT(DISTINCT user_id) as users &#13;
&#13;
    FROM (&#13;
      SELECT &#13;
          date&#13;
        , user_id&#13;
        , campaign_id&#13;
        , section_name AS campaign_name&#13;
        , country_name&#13;
        , brand_name&#13;
        , CASE WHEN fullvisitorid is not null then concat(fullvisitorid,visitid,date(date),platform) &#13;
               WHEN clientid      is not null then concat(sessionId,clientid,global_entity_id)&#13;
               ELSE NULL END AS session_Id&#13;
        , MAX(branded_section_seen)    as branded_section_seen&#13;
        , MAX(branded_section_clicked) as branded_section_clicked&#13;
&#13;
      FROM `peya-food-and-groceries.automated_tables_reports.partnership_branded_section_qc`&#13;
      GROUP BY 1,2,3,4,5,6,7&#13;
      )&#13;
    GROUP BY 1,2,3,4,5,6&#13;
      )&#13;
  UNPIVOT(values FOR metrics IN (impresions, clicked, users))&#13;
&#13;
  )&#13;
&#13;
, vouchers_int AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
DATE(coupon_start) as date&#13;
, talon_campaign_id as campaign_id&#13;
, talon_campaign_name as campaign_name&#13;
, country_name&#13;
, &apos;vouchers&apos; as tool&#13;
, &apos;NA&apos; as brand_name&#13;
, COUNT(DISTINCT order_id)    as orders&#13;
, COUNT(DISTINCT user_id)     as users&#13;
, COUNT(DISTINCT coupon_id)   as sent&#13;
, SUM(cupon_usado)            as cupon_usado&#13;
, SUM(cupon_cargado)          as cupon_cargado&#13;
-- , SUM(monto_usado)          as monto_usado&#13;
-- , SUM(monto_usado_eu)       as monto_usado_eu&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_vouchers`&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
UNPIVOT(values FOR metrics IN (orders, users, sent, cupon_usado, cupon_cargado))--, monto_usado, monto_usado_eu))&#13;
&#13;
)&#13;
&#13;
, vouchers_float AS (&#13;
&#13;
SELECT&#13;
DATE(coupon_start) as date&#13;
, talon_campaign_id as campaign_id&#13;
, talon_campaign_name as campaign_name&#13;
, country_name&#13;
, &apos;vouchers&apos; as tool&#13;
, &apos;NA&apos; as brand_name&#13;
, SUM(monto_cupon)          as monto_cupon&#13;
, SUM(monto_cupon_eu)       as monto_cupon_eu&#13;
, SUM(monto_usado)          as monto_usado&#13;
, SUM(monto_usado_eu)       as monto_usado_eu&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_vouchers`&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
&#13;
&#13;
, upselling AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT &#13;
  date,&#13;
  campaign_id,&#13;
  campaign_name,&#13;
  country_name,&#13;
  tool,&#13;
  brand_name,&#13;
  sum(impresions) as impresions,&#13;
  sum(clicked) as clicked,&#13;
  sum(clicked_and_transaction) as clicked_and_transaction&#13;
FROM(&#13;
SELECT&#13;
  DATE(date) AS date,&#13;
  &apos;NA&apos; campaign_id,&#13;
  upselling_product_name AS campaign_name,&#13;
  country_name,&#13;
  &apos;upselling&apos; as tool,&#13;
  brand_name,&#13;
  CASE WHEN fullvisitorid IS NOT NULL THEN concat(fullvisitorid,visitid,date(date),platform) &#13;
       WHEN client_id IS NOT NULL THEN concat(session_id,client_id,global_entity_id,date(date),platform)&#13;
       ELSE NULL END as session_id,&#13;
  MAX(upselling_loaded) as impresions,&#13;
  MAX(upselling_clicked) AS clicked,&#13;
  MAX(upselling_clicked_and_transaction) AS clicked_and_transaction&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_upselling`&#13;
GROUP BY 1,2,3,4,5,6,7&#13;
)&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
UNPIVOT(values FOR metrics IN (impresions, clicked, clicked_and_transaction))&#13;
&#13;
)&#13;
&#13;
&#13;
, tienda_propia_int AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
  DATE(registered_date) AS date,&#13;
  &apos;NA&apos; campaign_id,&#13;
  partner_name AS campaign_name,&#13;
  country_name,&#13;
  &apos;tienda propia&apos; as tool,&#13;
  &apos;NA&apos; AS brand_name,&#13;
  SUM(total_confirmed_orders) AS confirmed_orders,&#13;
  SUM(total_users) AS users,&#13;
  --SUM(gmv_lc) AS GMV_LC,&#13;
  --SUM(gmv_eu) AS GMV_EU,&#13;
  SUM(total_sessions) AS sessions,&#13;
  SUM(session_orders) AS orders&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_tienda_propia`&#13;
GROUP BY 1,2,3,4&#13;
)&#13;
UNPIVOT(values FOR metrics IN (confirmed_orders, users, sessions,orders))&#13;
&#13;
)&#13;
&#13;
&#13;
, tienda_propia_float AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
  DATE(registered_date) AS date,&#13;
  &apos;NA&apos; campaign_id,&#13;
  partner_name AS campaign_name,&#13;
  country_name,&#13;
  &apos;tienda propia&apos; as tool,&#13;
  &apos;NA&apos; AS brand_name,&#13;
  SUM(gmv_lc) AS GMV_LC,&#13;
  SUM(gmv_eu) AS GMV_EU,&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_tienda_propia`&#13;
GROUP BY 1,2,3,4&#13;
)&#13;
&#13;
)&#13;
&#13;
&#13;
, free_delivery_int AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
  DATE(date) AS date,&#13;
  campaign_id,&#13;
  campaign_name AS campaign_name,&#13;
  country_name,&#13;
  &apos;free_delivery&apos; AS tool,&#13;
  brand_name,&#13;
  --original_amount,&#13;
  --remaining_amount,&#13;
  --((original_amount-remaining_amount)/original_amount)*100 AS consumption, &#13;
  COUNTIF(impression_boolean = 1) AS impresions,&#13;
  COUNTIF(click_boolean = 1) AS clicked,&#13;
  COUNTIF(transaction_boolean = 1) AS orders,&#13;
  COUNT (DISTINCT user_id) AS users&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_free_delivery_fee` fdf&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
UNPIVOT(values FOR metrics IN (users, impresions, clicked, orders))&#13;
)&#13;
&#13;
&#13;
, free_delivery_float AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
  DATE(date) AS date,&#13;
  campaign_id,&#13;
  free_shipping_fee_campaign_name AS campaign_name,&#13;
  country_name,&#13;
  &apos;free_delivery&apos; AS tool,&#13;
  brand_name,&#13;
  MAX(original_amount) AS original_amount,&#13;
  MAX(remaining_amount) AS remaining_amount,&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_free_delivery_fee` fdf&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
&#13;
)&#13;
&#13;
&#13;
, descuentos_int AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
  DATE(registered_date) AS date,&#13;
  campaign_id,&#13;
  campaign_name,&#13;
  country_name,&#13;
  &apos;descuentos&apos; AS tool,&#13;
  &apos;NA&apos; AS brand_name,&#13;
  SUM(qty_orders) AS orders,&#13;
  CAST(SUM(product_quantity) AS INT64) AS quantity&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_promo_tools`&#13;
GROUP BY 1,2,3,4,5,6&#13;
&#13;
)&#13;
UNPIVOT(values FOR metrics IN (orders, quantity))&#13;
)&#13;
&#13;
&#13;
, descuentos_float AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
  DATE(registered_date) AS date,&#13;
  campaign_id,&#13;
  campaign_name,&#13;
  country_name,&#13;
  &apos;descuentos&apos; AS tool,&#13;
  &apos;NA&apos; AS brand_name,&#13;
  SUM(sold_discount_amount) AS discount_LC,&#13;
  SUM(sold_discount_amount_eu) AS discount_EU&#13;
FROM `peya-food-and-groceries.automated_tables_reports.partnership_promo_tools`&#13;
GROUP BY 1,2,3,4,5,6&#13;
&#13;
)&#13;
)&#13;
&#13;
&#13;
, final AS (&#13;
SELECT *&#13;
FROM braze b&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
UNION ALL&#13;
&#13;
SELECT *&#13;
FROM section_header_qc shqc&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
UNION ALL&#13;
&#13;
SELECT *&#13;
FROM vouchers_int v&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
UNION ALL&#13;
&#13;
SELECT *&#13;
FROM upselling up&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
UNION ALL &#13;
&#13;
SELECT *&#13;
FROM branded_section_qc bsqc&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
UNION ALL &#13;
&#13;
SELECT *&#13;
FROM tienda_propia_int tpi&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
UNION ALL &#13;
&#13;
SELECT *&#13;
FROM free_delivery_int fd&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
UNION ALL &#13;
&#13;
SELECT *&#13;
FROM descuentos_int d&#13;
PIVOT(SUM(values) FOR metrics IN (&quot;sent&quot;,&quot;clicked&quot;,&quot;impresions&quot;,&quot;users&quot;,&quot;orders&quot;,&quot;cupon_usado&quot;,&quot;cupon_cargado&quot;,&quot;clicked_and_transaction&quot;,&quot;confirmed_orders&quot;,&quot;sessions&quot;,&quot;quantity&quot;))&#13;
&#13;
)&#13;
&#13;
&#13;
SELECT f.*&#13;
, vf.monto_usado&#13;
, vf.monto_usado_eu&#13;
, vf.monto_cupon&#13;
, vf.monto_cupon_eu&#13;
, tpf.GMV_LC&#13;
, tpf.GMV_EU&#13;
, fdf.original_amount&#13;
, fdf.remaining_amount&#13;
, df.discount_LC&#13;
, df.discount_EU&#13;
&#13;
FROM final f&#13;
&#13;
LEFT JOIN vouchers_float vf&#13;
ON  f.date = vf.date&#13;
AND f.campaign_id  = vf.campaign_id&#13;
&#13;
LEFT JOIN tienda_propia_float tpf&#13;
ON  f.date = tpf.date&#13;
AND f.campaign_name  = tpf.campaign_name&#13;
&#13;
LEFT JOIN free_delivery_float fdf&#13;
ON  f.date = fdf.date&#13;
AND f.campaign_name  = fdf.campaign_name&#13;
&#13;
LEFT JOIN descuentos_float df&#13;
ON  f.date = df.date&#13;
AND f.campaign_name  = df.campaign_name</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
