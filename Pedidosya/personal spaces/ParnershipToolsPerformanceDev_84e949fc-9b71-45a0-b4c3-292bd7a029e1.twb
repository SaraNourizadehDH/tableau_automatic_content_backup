    <worksheet name='Details table (2)'>
      <repository-location id='Detailstable2' path='/t/Pedidosya/workbooks/ParnershipToolsPerformanceDev' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0he34ql1ppn4wx14edkim0a6jdsp' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Upselling' caption='Tools' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;upselling&quot;'>
              <calculation class='tableau' formula='&quot;upselling&quot;' />
              <aliases>
                <alias key='&quot;branded_section_qc&quot;' value='Branded Section QC' />
                <alias key='&quot;descuentos&quot;' value='Descuentos' />
                <alias key='&quot;email&quot;' value='Email' />
                <alias key='&quot;free_delivery&quot;' value='Free Delivery' />
                <alias key='&quot;in_app_message&quot;' value='In App Message' />
                <alias key='&quot;push&quot;' value='Push' />
                <alias key='&quot;section_header_qc&quot;' value='Section Header QC' />
                <alias key='&quot;tienda propia&quot;' value='Tienda Propia' />
                <alias key='&quot;upselling&quot;' value='Upselling' />
                <alias key='&quot;vouchers&quot;' value='Vouchers' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0he34ql1ppn4wx14edkim0a6jdsp'>
            <column caption='tool_filter' datatype='boolean' name='[Calculation_1445655526922694658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[tool]=[Parameters].[Parámetro 1]' />
            </column>
            <column caption='Amount Discount LC' datatype='real' name='[Calculation_18577396144070658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_cupon])&#13;&#10;WHEN &quot;free_delivery&quot; THEN MAX([original_amount])&#13;&#10;END' />
            </column>
            <column caption='Amount Discount EU' datatype='real' name='[Calculation_18577396144812035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_cupon_eu])&#13;&#10;END' />
            </column>
            <column caption='Discount used LC' datatype='real' name='[Calculation_18577396146757637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_usado])&#13;&#10;WHEN &quot;free_delivery&quot; THEN MAX([original_amount])- MAX([remaining_amount])&#13;&#10;WHEN &quot;descuentos&quot; THEN SUM([discount_LC])&#13;&#10;END' />
            </column>
            <column caption='Discount used EU' datatype='real' name='[Calculation_18577396147212294]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_usado_eu])&#13;&#10;WHEN &quot;descuentos&quot; THEN SUM([discount_EU])&#13;&#10;END' />
            </column>
            <column caption='Utilization Rate' datatype='real' name='[Calculation_18577396149604361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;free_delivery&quot; THEN (MAX([original_amount])- MAX([remaining_amount]))/MAX([original_amount])&#13;&#10;END' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_18577396154843147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;free_delivery&quot; THEN SUM([orders])/SUM([clicked])&#13;&#10;WHEN &quot;upselling&quot; THEN SUM([clicked_and_transaction])/SUM([clicked])&#13;&#10;END' />
            </column>
            <column caption='Sessions' datatype='integer' name='[Calculation_251638676504043520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;tienda propia&apos; THEN [sessions]&#13;&#10;END' />
            </column>
            <column caption='Quantity' datatype='integer' name='[Calculation_251638676517928962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;descuentos&apos; THEN [quantity]&#13;&#10;END' />
            </column>
            <column caption='Sent' datatype='integer' name='[Calculation_322570367375015936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;in_app_message&apos; THEN SUM([sent])&#13;&#10;WHEN &apos;push&apos; THEN SUM([sent])&#13;&#10;WHEN &apos;email&apos; THEN SUM([sent])&#13;&#10;WHEN &apos;vouchers&apos; THEN SUM([sent])&#13;&#10;END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_536772827843768321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;upselling&apos; THEN [clicked_and_transaction]&#13;&#10;WHEN &apos;vouchers&apos; THEN [orders]&#13;&#10;WHEN &apos;tienda propia&apos; THEN [confirmed_orders]&#13;&#10;WHEN &apos;free_delivery&apos; THEN [orders]&#13;&#10;WHEN &apos;descuentos&apos; THEN [orders]&#13;&#10;END' />
            </column>
            <column caption='Open Rate' datatype='real' name='[Calculation_759701008738275329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([cupon_usado])/SUM([sent])&#13;&#10;WHEN &quot;push&quot; THEN SUM([clicked])/SUM([sent])&#13;&#10;WHEN &quot;in_app_message&quot; THEN SUM([clicked])/SUM([sent])&#13;&#10;WHEN &quot;email&quot; THEN SUM([clicked])/SUM([sent])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='ctr' datatype='real' name='[Calculation_911416016194588672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([clicked])/sum([impresions])' />
            </column>
            <column datatype='real' name='[GMV_LC]' role='measure' type='quantitative' />
            <column caption='Clicked' datatype='integer' name='[Sent (copia)_322570367377584129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;in_app_message&apos; THEN SUM([clicked])&#13;&#10;WHEN &apos;push&apos; THEN SUM([clicked])&#13;&#10;WHEN &apos;email&apos; THEN SUM([clicked])&#13;&#10;WHEN &apos;branded_section_qc&apos; THEN SUM([clicked])&#13;&#10;WHEN &apos;upselling&apos; THEN SUM([clicked])&#13;&#10;WHEN &apos;free_delivery&apos; THEN SUM([clicked])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Impressions' datatype='integer' name='[Sent (copia)_638103818759512064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;section_header_qc&apos; THEN SUM([impresions])&#13;&#10;WHEN &apos;branded_section_qc&apos; THEN SUM([impresions])&#13;&#10;WHEN &apos;upselling&apos; THEN SUM([impresions])&#13;&#10;WHEN &apos;free_delivery&apos; THEN SUM([impresions])&#13;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
