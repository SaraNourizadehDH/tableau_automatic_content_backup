  <column aggregation='User' caption='Last Update' datatype='datetime' default-format='*d mmm yyyy' default-type='ordinal' name='[Calculation_1019502380780707841]' pivot='key' role='measure' type='ordinal' user-datatype='datetime' visual-totals='Default'>
    <calculation class='tableau' formula='max([last_update_date])' />
  </column>
  <column aggregation='Count' caption='Select Comparison' datatype='string' default-type='nominal' name='[Calculation_1019502380798246921]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='[Parameters].[Parámetro 1]' />
  </column>
  <column aggregation='Count' caption='Domicilios Migrated' datatype='string' default-type='nominal' name='[Calculation_1169247083356667906]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='if [is_migrated] = true then &quot;Domicilios Migrated&quot;&\#13;&\#10;elseif [is_migrated] = false then &quot;Domicilios Not Migrated&quot;&\#13;&\#10;else &quot;Not Domicilios&quot; end' />
  </column>
  <column aggregation='User' caption='CVR modified' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Calculation_1181069008171794432]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([sessions_transaction_more_than_5_hits])/sum([sessions_exclude_transaction_less_than_5_hits])' />
  </column>
  <column aggregation='User' caption='Δ CVR' datatype='real' default-format='*+0.0\%;-0.0\%' default-type='quantitative' name='[Calculation_1442277828026847232]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='([Calculation_469218823971766292]/lookup([Calculation_469218823971766292],-1))-1'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column aggregation='Count' caption='Day - Week - Month' datatype='string' default-type='nominal' name='[Calculation_1442277828041035779]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Select Metric (copy)] = &quot;Daily View&quot; then &quot;Day&quot; &\#13;&\#10;elseif [Parameters].[Select Metric (copy)] = &quot;Weekly View&quot; then &quot;Week&quot; &\#13;&\#10;else &quot;Month&quot; end' />
  </column>
  <column aggregation='User' caption='Last' datatype='boolean' default-type='nominal' name='[Calculation_1442277828043558916]' pivot='key' role='measure' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='Last() = 0'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column aggregation='Year' caption='Date Week' datatype='datetime' default-format='*d mmm yyyy' default-type='ordinal' name='[Calculation_1442277828404797461]' pivot='key' role='dimension' type='ordinal' user-datatype='datetime' visual-totals='Default'>
    <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[date],&quot;monday&quot;)' />
  </column>
  <column aggregation='User' caption='Date Week Previous' datatype='datetime' default-format='*d mmm yyyy' default-type='ordinal' name='[Calculation_1442277834752905263]' pivot='key' role='measure' type='ordinal' user-datatype='datetime' visual-totals='Default'>
    <calculation class='tableau' formula='Lookup(max([Calculation_1442277828404797461]), -1)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column aggregation='Count' caption='Not Running Week' datatype='boolean' default-type='nominal' name='[Calculation_1442277835406372930]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='[Calculation_1442277828404797461] &lt; datetrunc(&apos;week&apos;,TODAY(),&apos;monday&apos;)' />
  </column>
  <column aggregation='Count' caption='Domicilios Migrated Status' datatype='string' default-type='nominal' name='[Calculation_248260969500794880]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IF date([Calculation_469218822845587456]) &lt; DATE(&quot;2019-03-18&quot;) and [Calculation_1169247083356667906] = &quot;Domicilios Migrated&quot; &\#13;&\#10;then &quot;Domicilios Migrated Start&quot; else [Calculation_1169247083356667906] end' />
  </column>
  <column aggregation='Year' caption='Dynamic Date' datatype='datetime' default-format='*d mmm yy' default-type='ordinal' name='[Calculation_469218822845587456]' pivot='key' role='dimension' type='ordinal' user-datatype='datetime' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Select Metric (copy)]=&quot;Weekly View&quot; then DATETRUNC(&quot;week&quot;,[date],&quot;monday&quot;)&\#13;&\#10;ELSEIF [Parameters].[Select Metric (copy)]=&quot;Monthly View&quot; then DATETRUNC(&quot;month&quot;,[date])&\#13;&\#10;ELSE [date] END' />
  </column>
  <column aggregation='User' caption='CVR' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Calculation_469218823971766292]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([sessions_transaction])/sum([sessions])' />
  </column>
  <column aggregation='User' caption='Selected Bars' datatype='boolean' default-type='nominal' name='[Calculation_469218823994843157]' pivot='key' role='measure' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='Last() &lt;= [Parameters].[Parámetro 1 1]-1'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column aggregation='Count' caption='Exclude Running Month' datatype='boolean' default-type='nominal' name='[Calculation_491736823048597504]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], TODAY()) &gt; 0    // Exclude current month' />
  </column>
  <column aggregation='Count' caption='Select Date View' datatype='string' default-type='nominal' name='[Calculation_847802667802984448]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='[Parameters].[Select Metric (copy)]' />
  </column>
  <column aggregation='User' caption='Avg Time to Order' datatype='real' default-format='n\#,\#\#0.0;-\#,\#\#0.0' default-type='quantitative' name='[Calculation_847802667805319170]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([timeToOrder]/60000)/sum([sessions_transaction])' />
  </column>
  <column aggregation='User' caption='Bounce Rate' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Calculation_847802667806228483]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([bounces])/sum([sessions])' />
  </column>
  <column aggregation='User' caption='Avg Menus Seen' datatype='real' default-format='n\#,\#\#0.0;-\#,\#\#0.0' default-type='quantitative' name='[Calculation_847802667806642180]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
