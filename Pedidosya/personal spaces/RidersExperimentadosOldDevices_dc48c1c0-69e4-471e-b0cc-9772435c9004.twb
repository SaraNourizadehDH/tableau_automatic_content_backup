            <column caption='([riders] / TOTAL([riders])) - LOOKUP([riders] / TOTAL([rider...' datatype='real' name='[Calculation_1271703993696100362]' role='measure' type='quantitative' user:unnamed='Cohorts (4)'>
              <calculation class='tableau' formula='([Calculation_803048132945227776] / TOTAL([Calculation_803048132945227776])) - LOOKUP([Calculation_803048132945227776] / TOTAL([Calculation_803048132945227776]), -1)'>
