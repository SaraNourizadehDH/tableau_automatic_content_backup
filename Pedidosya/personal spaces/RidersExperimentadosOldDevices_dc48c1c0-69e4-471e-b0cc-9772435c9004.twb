            <connection CATALOG='peya-chile' EXECCATALOG='peya-chile' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-chile' schema='user_felipe_aguayo' server-oauth='' username='felipe.aguayo@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hr22pd0f0yoqk1h01owd02sxjv2' name='riders_cohorts' table='[peya-chile.user_felipe_aguayo].[riders_cohorts]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1hr22pd0f0yoqk1h01owd02sxjv2' name='riders_cohorts' table='[peya-chile.user_felipe_aguayo].[riders_cohorts]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption='Dimension for analysis' datatype='string' name='[Calculation_1151232682008043521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=1&#13;&#10;then [source]&#13;&#10;ELSEIF  [Parameters].[Parameter 1]=2&#13;&#10;then [link_type]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=3&#13;&#10;then [current_stage_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=4 then [Calculation_1151232682008354818]&#13;&#10;else [Calculation_1151232682008354818]&#13;&#10;end' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_1151232682008354818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;cl&quot;' />
      </column>
      <column caption='Lifespan 30d' datatype='string' name='[Calculation_1271703993608966144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_790944721302474754] = &quot;Active&quot; then &quot;Active&quot; &#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 30 then &quot;0-30&quot;&#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 90 then &quot;31-90&quot;&#13;&#10;else &quot;&gt;90&quot;&#13;&#10;end' />
      </column>
      <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_1271703993609687041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_payment])/sum([sum_working_hours])' />
      </column>
      <column caption='Orders per rider AVG' datatype='real' name='[Calculation_1271703993612836866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ INCLUDE [rider_id]: sum([conf_orders])})' />
      </column>
      <column caption='Month btw contract and shift' datatype='integer' name='[Calculation_1271703993628102659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[week_1st_contract], [week_shift])' />
      </column>
      <column caption='Vehicle Group' datatype='string' name='[Calculation_1570630418869215232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [rider_vehicle] = &quot;Bicicleta Plus&quot; then &quot;Bicicleta&quot; else [rider_vehicle] end' />
      </column>
      <column caption='Macro Zona' datatype='string' name='[Calculation_1620451495383166977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [city_name]&#13;&#10;when &quot;Buin&quot; then &quot;RM&quot;&#13;&#10;when &quot;Colina&quot; then &quot;RM&quot;&#13;&#10;when &quot;Penaflor&quot; then &quot;RM&quot;&#13;&#10;when &quot;Santiago&quot; then &quot;RM&quot;&#13;&#10;&#13;&#10;when &quot;Antofagasta&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Arica&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Calama&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Copiapo&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Iquique&quot; then &quot;Norte&quot;&#13;&#10;when &quot;La serena&quot; then &quot;Norte&quot;&#13;&#10;when &quot;Ovalle&quot; then &quot;Norte&quot;&#13;&#10;&#13;&#10;when &quot;Chillan&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Concepcion&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Coyhaique&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Curico&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Linares&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Los angeles&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Osorno&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Puerto montt&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Puerto varas&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Punta arenas&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Rancagua&quot; then &quot;Sur&quot;&#13;&#10;when &quot;San fernando&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Talca&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Temuco&quot; then &quot;Sur&quot;&#13;&#10;when &quot;Valdivia&quot; then &quot;Sur&quot;&#13;&#10;&#13;&#10;when &quot;Melipilla&quot; then &quot;Centro&quot;&#13;&#10;when &quot;San antonio&quot; then &quot;Centro&quot;&#13;&#10;when &quot;San felipe  los andes&quot; then &quot;Centro&quot;&#13;&#10;when &quot;Vina del mar&quot; then &quot;Centro&quot;&#13;&#10;else [city_name]&#13;&#10;end' />
      </column>
      <column aggregation='Sum' caption='Week/Month Btw Contract N Shift' datatype='integer' name='[Calculation_1620451495442751490]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#13;&#10;when &quot;Mes&quot; then [Calculation_1271703993628102659]&#13;&#10;when &quot;Semana&quot; then [weeks_btw_contract_n_shift]&#13;&#10;else [weeks_btw_contract_n_shift]&#13;&#10;end' />
      </column>
      <column caption='Termino Contrato' datatype='string' name='[Calculation_1620451495444078596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([motivo_termino_compliance]) then &quot;Sin termino/No compliance&quot; else &quot;Compliance&quot; end&#13;&#10;&#13;&#10;&#13;&#10;//diapo 11: matrices de retencion con y sin compliance' />
      </column>
      <column caption='Lifespan in days' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_790944721300393984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&quot;day&quot;,[first_order_date],[last_order_date])' />
      </column>
      <column caption='Days since last order' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_790944721302118401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&quot;day&quot;,[last_order_date],today())' />
      </column>
      <column caption='Status aprox' datatype='string' name='[Calculation_790944721302474754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_790944721302118401]&lt;=30 then &quot;Active&quot;&#13;&#10;else &quot;Inactive&quot;&#13;&#10;end' />
      </column>
      <column caption='riders' datatype='integer' name='[Calculation_803048132945227776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([rider_id])' />
      </column>
      <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_803048133027172357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders])/sum([sum_working_hours])' />
      </column>
      <column caption='CPO Rider' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_961237082733350912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_payment])/sum([conf_orders])' />
      </column>
      <column caption='Week Cohort' datatype='date' datatype-customized='true' name='[Calculation_961237082735722498]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&quot;iso-week&quot;, [weeks_btw_contract_n_shift], [week_1st_contract]))' />
      </column>
      <column aggregation='None' caption='Lifespan interval' datatype='integer' name='[Lifespan in days (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[Calculation_790944721300393984]' peg='0' size='15' />
        <aliases>
          <alias key='0' value='0-14 days' />
          <alias key='1' value='15-29 days' />
          <alias key='2' value='30-44 days' />
          <alias key='3' value='45-59 days' />
          <alias key='4' value='60-74 days' />
          <alias key='5' value='75-89 days' />
          <alias key='6' value='90-104 days' />
