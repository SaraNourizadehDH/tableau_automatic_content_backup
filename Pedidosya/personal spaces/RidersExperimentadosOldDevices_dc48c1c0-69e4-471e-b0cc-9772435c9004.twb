          <alias key='15' value='225-239 days' />
          <alias key='16' value='240-254 days' />
          <alias key='17' value='255-269 days' />
          <alias key='18' value='270-284 days' />
          <alias key='19' value='285-290 days' />
          <alias key='20' value='300-314 days' />
          <alias key='21' value='315-329 days' />
          <alias key='22' value='330-344 days' />
          <alias key='23' value='345-359 days' />
          <alias key='24' value='360-374 days' />
          <alias key='25' value='375-389 days' />
        </aliases>
      </column>
      <column caption='Vehicle Group (bici-moto)' datatype='string' name='[Vehicle Group (copy)_1620451495382941696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [rider_vehicle] &#13;&#10;when &quot;Bicicleta Plus&quot; then &quot;Moto-Bici&quot; &#13;&#10;when &quot;Bicicleta&quot; then &quot;Moto-Bici&quot; &#13;&#10;when &quot;Motocicleta&quot; then &quot;Moto-Bici&quot; &#13;&#10;else [rider_vehicle] end' />
      </column>
      <column caption='Week/Month 1st Contract' datatype='date' name='[Week/Month Btw Contract N Shift (copy)_1620451495443435523]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#13;&#10;when &quot;Mes&quot; then [month_1st_contract]&#13;&#10;when &quot;Semana&quot; then [week_1st_contract]&#13;&#10;else [week_1st_contract]&#13;&#10;end' />
      </column>
