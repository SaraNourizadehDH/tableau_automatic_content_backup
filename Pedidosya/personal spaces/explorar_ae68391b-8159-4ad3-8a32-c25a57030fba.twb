  <column aggregation='User' caption='Promise Delivery Time (PDT)' datatype='real' default-type='quantitative' name='[Calculation_674836319763898375]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM(IF  order_status=&apos;CONFIRMED&apos;AND is_completed=1 AND is_pre_order = 0&\#10;    THEN timing_promised_delivery_time&\#10;    ELSE 0&\#10;  END )/SUM(IF order_status=&apos;CONFIRMED&apos; AND is_completed=1 AND  is_pre_order = 0&\#10;    THEN total_orders&\#10;    ELSE 0&\#10;  END )' />
