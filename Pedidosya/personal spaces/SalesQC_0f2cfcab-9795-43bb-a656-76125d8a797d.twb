    <worksheet name='UltrafreshIncrease%'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Ultrafresh Increase %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta_SQL_personalizada (automated_tables_reports)' name='federated.02y35xm0eqi8ia1blvyuy155sbmn' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Filter' datatype='string' name='[Parámetro 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 8 Months&quot;'>
              <calculation class='tableau' formula='&quot;Last 8 Months&quot;' />
              <aliases>
                <alias key='&quot;Last 5 Months&quot;' value='Last 5 Months' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02y35xm0eqi8ia1blvyuy155sbmn'>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1139692238859980808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parámetro 4]&#13;&#10;when &apos;Last 2 Months&apos; then [dateMonth conjunto 2]&#13;&#10;&#13;&#10;when &apos;Last 3 Months&apos; then [last three months]&#13;&#10;when &apos;Last 4 Months&apos; then [last 4 months]&#13;&#10;when &apos;Last 5 Months&apos; then [last 4 months (copia)]&#13;&#10;when &apos;Last 6 Months&apos; then [last six months]&#13;&#10;when &apos;Last 7 Months&apos; then [last 6 months (copia)]&#13;&#10;when &apos;Last 8 Months&apos; then [last 7 months (copia)]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Sales_Fab' datatype='real' name='[Calculation_1139692238880645132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 2 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='Sales_Mar' datatype='real' name='[Calculation_1139692238880714765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 3 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='Sales_Apr' datatype='real' name='[Calculation_1139692238880772110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 4 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='Sales_May' datatype='real' name='[Calculation_1139692238880931855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 5 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='Sales_Jun' datatype='real' name='[Calculation_1139692238881005584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 6 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='SalesIncrease%' datatype='real' name='[Calculation_1139692238882037777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 4] = &apos;Last 9 Months&apos; THEN&#13;&#10;&#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_1139692238880645132])) / sum([Calculation_1139692238880645132])&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parámetro 4] = &apos;Last 8 Months&apos; THEN&#13;&#10;&#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_1139692238880714765])) / sum([Calculation_1139692238880714765])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &apos;Last 7 Months&apos; then  &#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_1139692238880772110])) / sum([Calculation_1139692238880772110])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &apos;Last 6 Months&apos; then  &#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_1139692238880931855])) / sum([Calculation_1139692238880931855])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &apos;Last 5 Months&apos; then  &#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_1139692238881005584])) / sum([Calculation_1139692238881005584])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &apos;Last 4 Months&apos; then  &#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_164099977568907264])) / sum([Calculation_164099977568907264])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &apos;Last 3 Months&apos; then  &#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_79375948358082560])) / sum([Calculation_79375948358082560])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 4] = &apos;Last 2 Months&apos; then  &#13;&#10;(sum([Sales_Sep (copia)_1329687818329878528]) - sum([Calculation_98797735899447296])) / sum([Calculation_98797735899447296])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Sales_Jul' datatype='real' name='[Calculation_164099977568907264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 7 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='Sales_Aug' datatype='real' name='[Calculation_79375948358082560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 8 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='Sales_Sep' datatype='real' name='[Calculation_98797735899447296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 9 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column caption='Sales_Oct' datatype='real' name='[Sales_Sep (copia)_1329687818329878528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([dateMonth]) = 10 THEN &#13;&#10;[SubtotalEUFreshUltrafresh]&#13;&#10;END' />
            </column>
            <column datatype='real' name='[SubtotalEUFreshUltrafresh]' role='measure' type='quantitative' />
            <column datatype='date' name='[dateMonth]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1139692238859980808]' derivation='None' name='[none:Calculation_1139692238859980808:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1139692238882037777]' derivation='User' name='[usr:Calculation_1139692238882037777:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.02y35xm0eqi8ia1blvyuy155sbmn].[none:Calculation_1139692238859980808:nk]'>
            <groupfilter function='member' level='[none:Calculation_1139692238859980808:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.02y35xm0eqi8ia1blvyuy155sbmn].[none:Calculation_1139692238859980808:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' value='116' />
            <format attr='text-format' field='[federated.02y35xm0eqi8ia1blvyuy155sbmn].[usr:Calculation_1139692238882037777:qk]' value='p0%' />
