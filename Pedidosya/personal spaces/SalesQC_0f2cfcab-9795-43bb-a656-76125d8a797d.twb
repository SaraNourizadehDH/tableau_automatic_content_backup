      <column caption='LastValue Dmart&amp;LS' datatype='real' hidden='true' name='[Calculation_1045961067352371203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if LAST() = 0 then (ZN(SUM([SubtotalEUFreshUltrafresh])) - LOOKUP(ZN(SUM([SubtotalEUFreshUltrafresh])), FIRST())) / ABS(LOOKUP(ZN(SUM([SubtotalEUFreshUltrafresh])), FIRST()))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Attribute' caption='UltrafreshDmartLS' datatype='real' hidden='true' name='[Calculation_1045961067358838788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE  [DmartLS] : SUM([SubtotalEUFreshUltrafresh])}' />
      </column>
      <column caption='Ultrafresh Dmart' datatype='real' name='[Calculation_1045961067359719429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [DmartLS] = &apos;Dmart&apos; then [SubtotalEUFreshUltrafresh]&#13;&#10;END' />
      </column>
      <column caption='Ultrafresh LS' datatype='real' name='[Calculation_1045961067359891462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [DmartLS] = &apos;Local Shop&apos; then [SubtotalEUFreshUltrafresh]&#13;&#10;END' />
      </column>
      <column caption='Ultrafresh GMV Dmart %' datatype='real' name='[Calculation_1045961067363602440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1045961067359719429]) / SUM([SubtotalEUFreshUltrafresh])' />
      </column>
      <column caption='Ultrafresh LS %' datatype='real' name='[Calculation_1045961067364511753]' role='measure' type='quantitative'>
