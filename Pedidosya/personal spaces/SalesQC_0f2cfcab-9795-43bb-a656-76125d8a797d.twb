    <worksheet name='Ultrafresh_Incidence'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>Fresh-Ultrafresh Vs Others</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta_SQL_personalizada (automated_tables_reports)' name='federated.02y35xm0eqi8ia1blvyuy155sbmn' />
          </datasources>
          <datasource-dependencies datasource='federated.02y35xm0eqi8ia1blvyuy155sbmn'>
            <column caption='Ultrafresh' datatype='string' name='[Calculation_484699963008937984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Level_one_new] = &apos;produce&apos; &#13;&#10;or [Level_one_new] = &apos;meat_seafood&apos;&#13;&#10;or [Level_one_new] = &apos;bread_bakery&apos;&#13;&#10;or [Level_one_new] = &apos;dairy_chilled_eggs&apos;&#13;&#10;or [Level_one_new] = &apos;ready_to_consume&apos;&#13;&#10;&#13;&#10;then &apos;Ultrafresh&apos; ELSE &apos;No Ultrafresh&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='BusinessGroup' datatype='string' name='[Calculation_484699963061370894]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Categoria] = &apos;Supermercados&apos; then &apos;Supermarket&apos;&#13;&#10;ELSEIF  [Categoria] = &apos;Express&apos; or [Categoria] = &apos;Colmados&apos; &#13;&#10;or [Categoria] = &apos;Conveniencia&apos; or [Categoria] = &apos;Minimarkets&apos;&#13;&#10;or [Categoria] = &apos;Minimercados&apos;&#13;&#10;&#13;&#10;then &apos;Convinience&apos;&#13;&#10;&#13;&#10;ELSE &apos;Specialized&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_529454487513579521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([orders_registered_date_month], &apos;-01&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-01&apos;,&apos;-Jan&apos;)&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-02&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-02&apos;,&apos;-Fab&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-03&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-03&apos;,&apos;-Mar&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-04&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-04&apos;,&apos;-Apr&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-05&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-05&apos;,&apos;-May&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-06&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-06&apos;,&apos;-Jun&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-07&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-07&apos;,&apos;-Jul&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-08&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-08&apos;,&apos;-Aug&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-09&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-09&apos;,&apos;-Sep&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-10&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-10&apos;,&apos;-Oct&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-11&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-11&apos;,&apos;-Nov&apos;)&#13;&#10;&#13;&#10;ELSEIF   CONTAINS([orders_registered_date_month], &apos;-12&apos;) then &#13;&#10;REGEXP_REPLACE([orders_registered_date_month], &apos;-12&apos;,&apos;-Dec&apos;)&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Categoria]' role='dimension' type='nominal' />
            <column datatype='string' name='[DmartLS]' role='dimension' type='nominal' />
            <column datatype='string' name='[Level_one_new]' role='dimension' type='nominal' />
