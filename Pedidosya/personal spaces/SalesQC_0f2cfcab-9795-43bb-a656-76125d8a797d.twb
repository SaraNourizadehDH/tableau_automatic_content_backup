              <calculation class='tableau' formula='case [Parameters].[Parámetro 4]&#13;&#10;when &apos;Last 2 Months&apos; then [dateMonth conjunto 2]&#13;&#10;&#13;&#10;when &apos;Last 3 Months&apos; then [last three months]&#13;&#10;when &apos;Last 4 Months&apos; then [last 4 months]&#13;&#10;when &apos;Last 5 Months&apos; then [last 4 months (copia)]&#13;&#10;when &apos;Last 6 Months&apos; then [last six months]&#13;&#10;when &apos;Last 7 Months&apos; then [last 6 months (copia)]&#13;&#10;when &apos;Last 8 Months&apos; then [last 7 months (copia)]&#13;&#10;&#13;&#10;END' />
