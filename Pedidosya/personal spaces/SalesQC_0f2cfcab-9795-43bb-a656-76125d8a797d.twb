            <column datatype='string' name='[orders_registered_date_month]' role='dimension' type='nominal' />
            <column-instance column='[SubtotalEU]' derivation='Sum' name='[sum:SubtotalEU:qk]' pivot='key' type='quantitative' />
            <column-instance column='[SubtotalEUFreshUltrafresh]' derivation='Sum' name='[sum:SubtotalEUFreshUltrafresh:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_437693643974086656]' derivation='User' name='[usr:Calculation_437693643974086656:qk]' pivot='key' type='quantitative' />
