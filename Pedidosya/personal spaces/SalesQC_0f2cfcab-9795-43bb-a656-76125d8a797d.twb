    <datasource caption='Consulta SQL personalizada (automated_tables_reports)' inline='true' name='federated.0qw5js80o7zsxy13szl5j0al4dai' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0a2x5ep0pvhz721fqaobh1wfuovp'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='automated_tables_reports' server='' server-oauth='' username='nicolas.ferrari@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0a2x5ep0pvhz721fqaobh1wfuovp' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
ORDERS as (
select (FORMAT_DATE('%Y-%m', orders.registered_date )) AS orders_registered_date_month,
restaurant.country.name AS Country,

date_trunc(orders.registered_date, MONTH) as dateMonth,

coalesce( dim_business_category.business_category_name,'Without Category')  as Categoria,
fact_orders__business_type.business_type_name  as Vertical,
case when dim_partner.is_darkstore=false then 'Local Shop' else 'Dmart' end as DmartLS,
dim_partner.partner_id as PartnerId, partner_name as PartnerName,
ltrim(order_detail.integration_code,'0') as menuIntegrationCode_,
order_detail.product_name,

case when product.gtin is not null then ltrim(product.gtin,'0') else ltrim(order_detail.integration_code ,'0') end as menuIntegrationCode ,

order_detail.product.product_id,

orders.order_id as order_id, subtotal as Subtotal,
subtotal/rate_us as SubtotalUS,
subtotal/rate_eu as SubtotalEU,

FROM `peya-bi-tools-pro.il_core.fact_orders`  AS orders
LEFT JOIN UNNEST([orders.business_type]) as fact_orders__business_type
left join unnest(details) as order_detail

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner ON dim_partner.partner_id=orders.restaurant.id

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner_product` as partner_product  ON 
partner_product.product_id= order_detail.product.product_id
AND partner_product.partner_id=restaurant.id
LEFT JOIN
`peya-bi-tools-pro.il_core.dim_product` product
ON product.id=partner_product.product_id

LEFT JOIN `peya-bi-tools-pro.il_core.dim_business_category`
     AS dim_business_category ON dim_partner.businessCategory.id = dim_business_category.business_category_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  AS dim_country__currency_id ON orders.country_id = dim_country__currency_id.country_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange`  AS dim_currency_exchange ON dim_currency_exchange.currency_exchange_date = date_trunc(orders.registered_date, month)  AND dim_currency_exchange.currency_id = dim_country__currency_id.currency_id

WHERE DATE(orders.registered_date) >>= DATE_TRUNC(DATE(CURRENT_DATE()), YEAR) and 
DATE(orders.registered_date) << DATE_TRUNC(DATE(CURRENT_DATE()), MONTH)


--AND dim_partner.is_darkstore=FALSE 
and orders.order_status = "CONFIRMED"
--and restaurant.country.name ='Uruguay'
and coalesce( fact_orders__business_type.business_type_name,'Without Category') ='Market'
),

PIM_PRODUCTS AS (
select distinct title, ltrim(piece_barcode, '0') as gtin , LEVEL_ONE from (
select title, piece_barcode,row_number() over (partition by piece_barcode order by piece_barcode) as Aux,
REGEXP_REPLACE(REGEXP_REPLACE(LOWER(master_categories.level_one), ' ','_'), '_/_' , '_')AS LEVEL_ONE
FROM `fulfillment-dwh-production.curated_data_shared_dmart.global_catalog_master_product` 
WHERE master_categories.level_one is not null)
where aux=1),

resumen_partner as (
select orders_registered_date_month, country,vertical,DmartLS,Categoria, PartnerId,PartnerName,
--Level_one,
--case when DmartLS='Local Shop' and Categoria='Frutas y Verduras' and Level_one is null  then 'produce'
--when DmartLS='Local Shop' and Categoria='Carnicerias'and Level_one is null  then 'meat_seafood'
--when DmartLS='Local Shop' and Categoria='Panaderías'and Level_one is null  then 'bread_bakery'
--else Level_one end as Level_one_new,
count(distinct order_id) AS OrderLevelOne , round(sum( SUBTOTAL ),0) as SubtotalLC, round(sum(SubtotalEU),0) as SubtotalEU, round(sum(SubtotalUS),0) as SubtotalUS,
count (distinct (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras'  and (Level_one is null or Level_one='') then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then order_id else null end )) as OrderLevelOnereshUltrafresh,
round (sum ( (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras'  and (Level_one is null or Level_one='')  then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then SUBTOTAL else null end )) ,0) as SubtotalLCFreshUltrafresh,
round (sum ( (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras' and (Level_one is null or Level_one='')  then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then SubtotalEU else null end )) ,0) as SubtotalEUFreshUltrafresh,
round (sum ( (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras' and Level_one is null  then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then SubtotalUS else null end )) ,0) as SubtotalUSFreshUltrafresh
FROM ORDERS as orders
left JOIN PIM_PRODUCTS as products on (orders.menuIntegrationCode = products.gtin)   --or (orders.product_name = products.title)))

group by orders_registered_date_month, datemonth, country,vertical,DmartLS,Categoria, PartnerId,PartnerName

)


select * ,
SAFE_DIVIDE(SubtotalLCFreshUltrafresh,SubtotalLC) as Porcantaje_GMV_SubtotalLC, 
SAFE_DIVIDE(SubtotalEUFreshUltrafresh,SubtotalEU) as Porcantaje_GMV_SubtotalEU,
SAFE_DIVIDE(SubtotalEUFreshUltrafresh,SubtotalUS) as Porcantaje_GMV_SubtotalUS,
from resumen_partner
where
vertical='Market'

order by PartnerId,	PartnerName, country, orders_registered_date_month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0a2x5ep0pvhz721fqaobh1wfuovp' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
ORDERS as (
select (FORMAT_DATE('%Y-%m', orders.registered_date )) AS orders_registered_date_month,
restaurant.country.name AS Country,

date_trunc(orders.registered_date, MONTH) as dateMonth,

coalesce( dim_business_category.business_category_name,'Without Category')  as Categoria,
fact_orders__business_type.business_type_name  as Vertical,
case when dim_partner.is_darkstore=false then 'Local Shop' else 'Dmart' end as DmartLS,
dim_partner.partner_id as PartnerId, partner_name as PartnerName,
ltrim(order_detail.integration_code,'0') as menuIntegrationCode_,
order_detail.product_name,

case when product.gtin is not null then ltrim(product.gtin,'0') else ltrim(order_detail.integration_code ,'0') end as menuIntegrationCode ,

order_detail.product.product_id,

orders.order_id as order_id, subtotal as Subtotal,
subtotal/rate_us as SubtotalUS,
subtotal/rate_eu as SubtotalEU,

FROM `peya-bi-tools-pro.il_core.fact_orders`  AS orders
LEFT JOIN UNNEST([orders.business_type]) as fact_orders__business_type
left join unnest(details) as order_detail

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner ON dim_partner.partner_id=orders.restaurant.id

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner_product` as partner_product  ON 
partner_product.product_id= order_detail.product.product_id
AND partner_product.partner_id=restaurant.id
LEFT JOIN
`peya-bi-tools-pro.il_core.dim_product` product
ON product.id=partner_product.product_id

LEFT JOIN `peya-bi-tools-pro.il_core.dim_business_category`
     AS dim_business_category ON dim_partner.businessCategory.id = dim_business_category.business_category_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  AS dim_country__currency_id ON orders.country_id = dim_country__currency_id.country_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange`  AS dim_currency_exchange ON dim_currency_exchange.currency_exchange_date = date_trunc(orders.registered_date, month)  AND dim_currency_exchange.currency_id = dim_country__currency_id.currency_id

WHERE DATE(orders.registered_date) >>= DATE_TRUNC(DATE(CURRENT_DATE()), YEAR) and 
DATE(orders.registered_date) << DATE_TRUNC(DATE(CURRENT_DATE()), MONTH)


--AND dim_partner.is_darkstore=FALSE 
and orders.order_status = "CONFIRMED"
--and restaurant.country.name ='Uruguay'
and coalesce( fact_orders__business_type.business_type_name,'Without Category') ='Market'
),

PIM_PRODUCTS AS (
select distinct title, ltrim(piece_barcode, '0') as gtin , LEVEL_ONE from (
select title, piece_barcode,row_number() over (partition by piece_barcode order by piece_barcode) as Aux,
REGEXP_REPLACE(REGEXP_REPLACE(LOWER(master_categories.level_one), ' ','_'), '_/_' , '_')AS LEVEL_ONE
FROM `fulfillment-dwh-production.curated_data_shared_dmart.global_catalog_master_product` 
WHERE master_categories.level_one is not null)
where aux=1),

resumen_partner as (
select orders_registered_date_month, country,vertical,DmartLS,Categoria, PartnerId,PartnerName,
--Level_one,
--case when DmartLS='Local Shop' and Categoria='Frutas y Verduras' and Level_one is null  then 'produce'
--when DmartLS='Local Shop' and Categoria='Carnicerias'and Level_one is null  then 'meat_seafood'
--when DmartLS='Local Shop' and Categoria='Panaderías'and Level_one is null  then 'bread_bakery'
--else Level_one end as Level_one_new,
count(distinct order_id) AS OrderLevelOne , round(sum( SUBTOTAL ),0) as SubtotalLC, round(sum(SubtotalEU),0) as SubtotalEU, round(sum(SubtotalUS),0) as SubtotalUS,
count (distinct (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras'  and (Level_one is null or Level_one='') then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then order_id else null end )) as OrderLevelOnereshUltrafresh,
round (sum ( (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras'  and (Level_one is null or Level_one='')  then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then SUBTOTAL else null end )) ,0) as SubtotalLCFreshUltrafresh,
round (sum ( (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras' and (Level_one is null or Level_one='')  then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then SubtotalEU else null end )) ,0) as SubtotalEUFreshUltrafresh,
round (sum ( (case when case when DmartLS='Local Shop' and Categoria='Frutas y Verduras' and Level_one is null  then 'produce'
when DmartLS='Local Shop' and Categoria='Carnicerias' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Carnicerías' and (Level_one is null or Level_one='')  then 'meat_seafood'
when DmartLS='Local Shop' and Categoria='Panaderías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Panaderías y Pastelerías' and (Level_one is null or Level_one='')  then 'bread_bakery'
when DmartLS='Local Shop' and Categoria='Pescados y Mariscos' and (Level_one is null or Level_one='')  then 'meat_seafood'
else Level_one end  in ('dairy_chilled_eggs','ready_to_consume','bread_bakery','produce','meat_seafood') 
then SubtotalUS else null end )) ,0) as SubtotalUSFreshUltrafresh
FROM ORDERS as orders
left JOIN PIM_PRODUCTS as products on (orders.menuIntegrationCode = products.gtin)   --or (orders.product_name = products.title)))

group by orders_registered_date_month, datemonth, country,vertical,DmartLS,Categoria, PartnerId,PartnerName

)


select * ,
SAFE_DIVIDE(SubtotalLCFreshUltrafresh,SubtotalLC) as Porcantaje_GMV_SubtotalLC, 
SAFE_DIVIDE(SubtotalEUFreshUltrafresh,SubtotalEU) as Porcantaje_GMV_SubtotalEU,
SAFE_DIVIDE(SubtotalEUFreshUltrafresh,SubtotalUS) as Porcantaje_GMV_SubtotalUS,
from resumen_partner
where
vertical='Market'

order by PartnerId,	PartnerName, country, orders_registered_date_month]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
