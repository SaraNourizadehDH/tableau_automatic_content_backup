            <column-instance column='[DmartLS]' derivation='None' name='[none:DmartLS:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[orders_registered_date_month]' role='dimension' type='nominal' />
