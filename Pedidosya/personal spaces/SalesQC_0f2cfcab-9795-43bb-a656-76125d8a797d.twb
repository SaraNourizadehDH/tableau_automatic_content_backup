      <column caption='Jan-May' datatype='boolean' hidden='true' name='[Calculation_1139692238797754374]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[dateMonth] &gt;= [Parameters].[Parámetro 2] and [dateMonth] &lt;= DATEADD(&apos;month&apos;, -1 , [Parameters].[Parámetro 3])' />
      </column>
      <column caption='Set Selection' datatype='string' name='[Calculation_1139692238815543303]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [dateMonth conjunto 2] then &apos;Last 2 Months&apos;&#13;&#10;elseif [last three months] then &apos;Last 3 Months&apos;&#13;&#10;elseif [last 4 months] then &apos;Last 4 Months&apos;&#13;&#10;elseif [last 4 months (copia)] then &apos;Last 5 Months&apos;&#13;&#10;elseif [last six months] then &apos;Last 6 Months&apos;&#13;&#10;elseif [last 6 months (copia)] then &apos;Last 7 Months&apos;&#13;&#10;elseif [last 7 months (copia)] then &apos;Last 8 Months&apos;&#13;&#10;END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_1139692238859980808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parámetro 4]&#13;&#10;when &apos;Last 2 Months&apos; then [dateMonth conjunto 2]&#13;&#10;&#13;&#10;when &apos;Last 3 Months&apos; then [last three months]&#13;&#10;when &apos;Last 4 Months&apos; then [last 4 months]&#13;&#10;when &apos;Last 5 Months&apos; then [last 4 months (copia)]&#13;&#10;when &apos;Last 6 Months&apos; then [last six months]&#13;&#10;when &apos;Last 7 Months&apos; then [last 6 months (copia)]&#13;&#10;when &apos;Last 8 Months&apos; then [last 7 months (copia)]&#13;&#10;&#13;&#10;END' />
      </column>
