              <text column='[federated.02y35xm0eqi8ia1blvyuy155sbmn].[usr:Calculation_1139692238882037777:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontsize='16'><![CDATA[<[federated.02y35xm0eqi8ia1blvyuy155sbmn].[usr:Calculation_1139692238882037777:qk]>]]></run>
