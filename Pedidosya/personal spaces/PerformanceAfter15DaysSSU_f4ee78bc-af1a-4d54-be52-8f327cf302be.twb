      <aliases enabled='yes' />
      <column caption='% Open Time' datatype='real' name='[Calculation_1238489900791357440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([dim_historical_partners_real_open_time])/Sum([dim_historical_partners_sum_schedule_open_time])' />
      </column>
      <column caption='Zombie' datatype='integer' name='[Calculation_1238489900855209991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF {FIXED [grid]: SUM([fact_orders_total_confirmed_orders])} = 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Cuentas Totales' datatype='integer' name='[Calculation_1238489900860612619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([grid])' />
      </column>
      <column caption='Descuentos' datatype='integer' name='[Calculation_1238489901457534990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF {FIXED [grid]: SUM([Calculation_1238489900855209991]) + SUM( [Zombie (copia)_1238489901449248781])} = 2 THEN 1 &#13;&#10;ELSEIF {FIXED [grid]: SUM([Calculation_1238489900855209991]) + SUM([Zombie (copia)_1238489901449248781])} = 1 THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Real Open Time ( Horas)' datatype='real' name='[Calculation_1238489901480538130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dim_historical_partners_real_open_time]/60' />
      </column>
      <column aggregation='Sum' caption='Total Conectado ( Horas)' datatype='real' name='[Calculation_5889019466704674844]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [grid]: Sum([Calculation_1238489901480538130])}' />
      </column>
      <column caption='Total Ordenes' datatype='integer' name='[Calculation_5889019466705199133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [grid]: SUM([fact_orders_total_confirmed_orders])}' />
      </column>
      <column caption='&lt;40 Horas Semanales' datatype='integer' name='[Zombie (copia)_1238489901449248781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF {FIXED [grid]: SUM([dim_historical_partners_real_open_time]/60)} &lt; 40 THEN 1 ELSE 0 END' />
      </column>
