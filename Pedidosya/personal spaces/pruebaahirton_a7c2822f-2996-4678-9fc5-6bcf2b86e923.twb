  <column aggregation='User' caption='DT' datatype='real' default-format='n\#,\#\#0.00;-\#,\#\#0.00' default-type='quantitative' name='[Calculation_1253408133735612416]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
