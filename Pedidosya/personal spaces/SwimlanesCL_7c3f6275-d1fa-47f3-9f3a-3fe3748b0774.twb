          </datasources>
          <datasource-dependencies datasource='sqlproxy.1bh0d7o1qbeyi213wh2wj03rbznz'>
            <column aggregation='Count' caption='App Version' datatype='string' default-type='nominal' layered='true' name='[app_version]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' caption='banner_deeplink_clean' datatype='string' default-type='nominal' layered='true' name='[banner_deeplink (copy)_3987867122163003394]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if &#10;    REGEXP_MATCH([banner_deeplink], &apos;bt=&apos;)&#10;then &#10;    split([banner_deeplink], &apos;bt=&apos;, 2)&#10;else &#10;    if &#10;        REGEXP_MATCH([banner_deeplink], &apos;channels=&apos;)&#10;    then &#10;        split([banner_deeplink], &apos;channels=&apos;, 2)&#10;    else&#10;        IF &#10;          REGEXP_MATCH([banner_deeplink], &apos;cadenas/&apos;)&#10;        then&#10;          split([banner_deeplink], &apos;cadenas/&apos;, 2)&#10;        else&#10;          split([banner_deeplink], &apos;/&apos;, 1)&#10;        end&#10;    end&#10;end' />
            </column>
            <column aggregation='Count' caption='Banner Deeplink' datatype='string' default-type='nominal' layered='true' name='[banner_deeplink]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' caption='Banner Id' datatype='string' default-type='nominal' layered='true' name='[banner_id]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
