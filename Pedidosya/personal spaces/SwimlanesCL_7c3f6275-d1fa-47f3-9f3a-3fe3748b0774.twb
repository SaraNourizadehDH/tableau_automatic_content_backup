    REGEXP_MATCH([banner_deeplink], &apos;bt=&apos;)
then 
    split([banner_deeplink], &apos;bt=&apos;, 2)
else 
    if 
        REGEXP_MATCH([banner_deeplink], &apos;channels=&apos;)
    then 
        split([banner_deeplink], &apos;channels=&apos;, 2)
    else
        IF 
          REGEXP_MATCH([banner_deeplink], &apos;cadenas/&apos;)
        then
          split([banner_deeplink], &apos;cadenas/&apos;, 2)
        else
          split([banner_deeplink], &apos;/&apos;, 1)
        end
    end
end&quot;</attribute>
              <attribute datatype='integer' name='role'>0</attribute>
            </attributes>
