        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1hr22pd0f0yoqk1h01owd02sxjv2' name='riders_cohorts' table='[peya-chile.user_felipe_aguayo].[riders_cohorts]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column caption='Dimension for analysis' datatype='string' name='[Calculation_1151232682008043521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=1&#13;&#10;then [source]&#13;&#10;ELSEIF  [Parameters].[Parameter 1]=2&#13;&#10;then [link_type]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=3&#13;&#10;then [current_stage_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1]=4 then [Calculation_1151232682008354818]&#13;&#10;else [Calculation_1151232682008354818]&#13;&#10;end' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_1151232682008354818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;cl&quot;' />
      </column>
      <column caption='Lifespan 30d' datatype='string' name='[Calculation_1271703993608966144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_790944721302474754] = &quot;Active&quot; then &quot;Active&quot; &#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 30 then &quot;0-30&quot;&#13;&#10;ELSEIF  [Calculation_790944721300393984] &lt;= 90 then &quot;31-90&quot;&#13;&#10;else &quot;&gt;90&quot;&#13;&#10;end' />
      </column>
      <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_1271703993609687041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_payment])/sum([sum_working_hours])' />
      </column>
      <column caption='Orders per rider AVG' datatype='real' name='[Calculation_1271703993612836866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ INCLUDE [rider_id]: sum([conf_orders])})' />
      </column>
      <column caption='Month btw contract and shift' datatype='integer' name='[Calculation_1271703993628102659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[week_1st_contract], [week_shift])' />
      </column>
      <column caption='Vehicle Group' datatype='string' name='[Calculation_1570630418869215232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [rider_vehicle] = &quot;Bicicleta Plus&quot; then &quot;Bicicleta&quot; else [rider_vehicle] end' />
      </column>
      <column caption='Horas totales por rider' datatype='real' name='[Calculation_738520019380813857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({fixed [rider_id] : sum([sum_working_hours])})&#10;&#10;//include&#10;&#10;//exclude' />
      </column>
      <column caption='Horas totales rider grupos' datatype='string' name='[Calculation_738520019383697442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_738520019380813857] &lt; 10 then &quot;&lt;10&quot;&#10;elseif [Calculation_738520019380813857] &lt;20 then &quot;&lt;20&quot;&#10;else &quot;&gt;20&quot;&#10;end' />
      </column>
      <column caption='Lifespan in days' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_790944721300393984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&quot;day&quot;,[first_order_date],[last_order_date])' />
      </column>
      <column caption='Days since last order' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_790944721302118401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&quot;day&quot;,[last_order_date],today())' />
      </column>
      <column caption='Status aprox' datatype='string' name='[Calculation_790944721302474754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_790944721302118401]&lt;=30 then &quot;Active&quot;&#13;&#10;else &quot;Inactive&quot;&#13;&#10;end' />
      </column>
      <column caption='riders' datatype='integer' name='[Calculation_803048132945227776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([rider_id])' />
      </column>
      <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_803048133027172357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders])/sum([sum_working_hours])' />
      </column>
      <column caption='CPO Rider' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_961237082733350912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_payment])/sum([conf_orders])' />
      </column>
      <column caption='Week Cohort' datatype='date' datatype-customized='true' name='[Calculation_961237082735722498]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&quot;iso-week&quot;, [weeks_btw_contract_n_shift], [week_1st_contract]))' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_803048132945227776] / TOTAL([Calculation_803048132945227776])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
