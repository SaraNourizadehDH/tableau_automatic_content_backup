        <calculation class='tableau' formula='if [Fecha de Contratación AAAA-MM-DD]&lt;DATE (&quot;2021-02-01&quot;) &#13;&#10;AND [Fecha de Baja 2]&gt;DATE (&quot;2020-12-31&quot;)&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='# Bajas Ene 21' datatype='integer' name='[Calculation_600949133380636698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Fecha de Baja 2]&gt;DATE(&quot;2020-12-31&quot;)&#13;&#10;AND [Fecha de Baja 2]&lt;DATE(&quot;2021-02-01&quot;)&#13;&#10;then 1&#13;&#10;else 0&#13;&#10;end' />
      </column>
      <column caption='% TO Ene 21' datatype='real' name='[Calculation_600949133394432038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_600949133380636698]/[Calculation_600949133375987726])' />
      </column>
      <column caption='#Bajas' datatype='integer' name='[Calculation_600949134383390770]' role='measure' type='quantitative'>
