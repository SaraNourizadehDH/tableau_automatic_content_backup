    <worksheet name='Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Orders y UTR</run>
            <run bold='true'> &gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='seguimiento_staffing_pe (automated_tables_reports)' name='federated.1p5xmrf0769vuz15vesap194ltjw' />
          </datasources>
          <datasource-dependencies datasource='federated.1p5xmrf0769vuz15vesap194ltjw'>
            <column caption='DT' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1253408133735612416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( [actual_delivery_time]) / SUM( [completed_orders])' />
            </column>
            <column caption='AVTc' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1253408133737283585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([avtc]) / sum([completed_orders])' />
            </column>
            <column caption='EPT2' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1253408133738819586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ept]) / sum([completed_orders])' />
            </column>
            <column caption='Turnos Taken' datatype='real' name='[Calculation_1390204970219364352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_slots_assigned])' />
            </column>
            <column caption='Turnos Abiertos' datatype='integer' datatype-customized='true' name='[Calculation_1390204970219679745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(SUM([open_slots_unassigned]))' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_1390204970227691522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered])' />
            </column>
            <column caption='Fc' datatype='real' name='[Calculation_1390204970228441091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adjusted_fc])' />
            </column>
            <column caption='FILR' datatype='real' default-format='p0.00%' name='[Calculation_1390204970228862980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(open_slots_assigned)/(sum(open_slots_assigned) + sum(open_slots_unassigned))' />
            </column>
            <column caption='Delta' datatype='real' default-format='p0.00%' name='[Calculation_1390204970229481477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(adjusted_fc)/sum(orders_delivered))-1' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1390204970229735430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( sum(orders_delivered) / sum(evaluated_hours) ,0)' />
            </column>
            <column caption='NS' datatype='real' default-format='p0.00%' name='[Calculation_1390204970230018055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(no_shows_duration_hour)+ sum(excused_no_shows_duration_hour)) / (sum(planned_shift_duration_hours))' />
            </column>
            <column caption='CNE' datatype='real' default-format='p0.00%' name='[Calculation_1390204970230894600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (sum(evaluated_hours) / sum(open_slots_assigned))' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1390204970231099401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(total_payments) / sum(confirmed_orders)' />
            </column>
            <column caption='CPH' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1390204970231156746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(total_payments)/sum(evaluated_hours)' />
            </column>
            <column caption='AR' datatype='real' default-format='p0.00%' name='[Calculation_2196349279395774464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([accepted])/SUM([notified])' />
            </column>
            <column caption='UR' datatype='real' default-format='p0.00%' name='[Calculation_2196349279397138433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - ( SUM([picked_up])/sum([accepted]))' />
            </column>
            <column caption='WEEKDAY' datatype='string' name='[Calculation_2196349279400091650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[date])' />
            </column>
            <column caption='FR' datatype='real' name='[Calculation_2317664991590477824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_rate_orders])/(SUM([confirmed_orders])+ sum([fail_rate_orders]))' />
            </column>
            <column caption='MeanDelay' datatype='real' name='[Calculation_2317664991593918466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mean_delay])/sum([completed_orders])' />
            </column>
            <column caption='HBT' datatype='real' name='[Calculation_3766557412506791978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([hold_back_time]) / sum([completed_orders])' />
            </column>
            <column caption='TDT' datatype='real' name='[Calculation_3766557412507025451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_dispatch_time]) / sum([completed_orders])' />
            </column>
            <column caption='RAT' datatype='real' name='[Calculation_3766557412507328557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_accepting_time]) / sum([completed_orders])' />
            </column>
            <column caption='TVT' datatype='real' name='[Calculation_3766557412507488303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_vendor_time]) / sum([completed_orders])' />
            </column>
            <column caption='AVT' datatype='real' name='[Calculation_3766557412507562032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([at_vendor_time]) / sum([completed_orders])' />
            </column>
            <column caption='TCT' datatype='real' name='[Calculation_3766557412507652145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_customer_time]) / sum([completed_orders])' />
            </column>
            <column caption='Stacking' datatype='real' name='[Calculation_3766557412507713586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([completed_stacked_orders]) / sum([completed_orders])' />
            </column>
            <column caption='EAHC' datatype='real' name='[Calculation_3766557412507869235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([eahc_orders]) / sum([completed_orders])' />
            </column>
            <column caption='RLT' datatype='real' name='[Calculation_3766557412508598324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_late]) / sum([completed_orders])' />
            </column>
            <column caption='RL_EARLY' datatype='real' name='[Calculation_3766557412508799029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_early]) / sum([completed_orders])' />
            </column>
            <column caption='VL' datatype='real' name='[Calculation_3766557412508938294]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_orders_vl]) / sum([completed_orders])' />
            </column>
            <column caption='Turnos Totales' datatype='real' name='[Calculation_417708869074718720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1390204970219364352]+[Calculation_1390204970219679745]' />
            </column>
            <column caption='UTR100' datatype='real' name='[Calculation_6657657265947881518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1390204970227691522]/([Calculation_417708869074718720]*(1-[Calculation_1390204970230894600]))' />
            </column>
            <column caption='ACT' datatype='real' name='[Calculation_6657657269529276474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([at_customer_time]) / sum([completed_orders])' />
            </column>
            <column caption='Cash' datatype='real' name='[Calculation_747808656007614483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cash_orders])/sum([confirmed_orders])' />
            </column>
            <column caption='Accepted' datatype='integer' name='[accepted]' role='measure' type='quantitative' />
            <column caption='Actual Delivery Time' datatype='real' name='[actual_delivery_time]' role='measure' type='quantitative' />
