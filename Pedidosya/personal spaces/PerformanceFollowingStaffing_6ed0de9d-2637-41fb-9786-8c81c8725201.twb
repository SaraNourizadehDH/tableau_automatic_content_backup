      <column caption='DATE_TRUNC' datatype='date' datatype-customized='true' name='[Calculation_1023443076251942917]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy-MM-dd HH:mm:ss&quot;, STR(DATEADD(&apos;day&apos;, &#13;&#10;    IF DATEPART(&apos;weekday&apos;, [created_date]) = 1 THEN -6 ELSE 2 - DATEPART(&apos;weekday&apos;, [created_date]) END, &#13;&#10;    [created_date]&#13;&#10;)) )) ' />
      </column>
