      <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1023443076249198592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_payments)/SUM(orders_bo)' />
      </column>
      <column caption='CPH' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1023443076249276417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_payments)/SUM(rider_hours)' />
      </column>
      <column caption='CPO_QUEST' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1023443076249399298]' role='measure' type='quantitative'>
