    <worksheet name='Var ROAS mes anterior'>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_tracker_by_category' name='federated.0e81b281axz6a5130ces70bga6d7' />
          </datasources>
          <datasource-dependencies datasource='federated.0e81b281axz6a5130ces70bga6d7'>
            <column caption='Mes cerrado' datatype='datetime' name='[Calculation_1265230041892438026]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='fecha_real_joaco' datatype='date' name='[Calculation_1295347864716652548]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM&quot;, [month_year]))' />
            </column>
            <column caption='Fillrate' datatype='real' name='[Calculation_1686598079875919872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks_dh_ads]) / &#13;&#10;&#13;&#10;SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) })' />
            </column>
            <column caption='Fillrate ultimo mes cerrado' datatype='real' name='[Fillrate (copia)_1295347864709701632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441] AND&#13;&#10;       // This condition ensures we count the FIXED value only once per unique combination.&#13;&#10;       // It picks the value from the row where [Month Year] is the minimum for that combination.&#13;&#10;       [month_year] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([month_year]) }&#13;&#10;    THEN&#13;&#10;        { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Fillrate mes previo al ultimo mes cerrado' datatype='real' name='[Fillrate ultimo mes cerrado (copia)_1295347864718696454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773] AND&#13;&#10;       // This condition ensures we count the FIXED value only once per unique combination.&#13;&#10;       // It picks the value from the row where [Month Year] is the minimum for that combination.&#13;&#10;       [month_year] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([month_year]) }&#13;&#10;    THEN&#13;&#10;        { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Filtro ultimo mes cerrado' datatype='boolean' name='[Filtro mes cerrado + anterior (copia)_1295347864713277441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1295347864716652548] = [Calculation_1265230041892438026]' />
            </column>
            <column caption='Filtro mes previo al ultimo mes cerrado' datatype='boolean' name='[Filtro ultimo mes cerrado (copia)_1295347864718368773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1295347864716652548] = DATEADD(&apos;month&apos;,-1,[Calculation_1265230041892438026])' />
            </column>
            <column caption='Var Fillrate mes anterior' datatype='real' name='[Var ROAS mes anterior (copia)_1265230041906397199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Fillrate (copia)_1295347864709701632]) - ZN([Fillrate ultimo mes cerrado (copia)_1295347864718696454])) / ABS(ZN([Fillrate ultimo mes cerrado (copia)_1295347864718696454]))' />
            </column>
            <column caption='Herramienta' datatype='string' name='[asset_type]' role='dimension' type='nominal' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Clicks Dh Ads' datatype='integer' name='[clicks_dh_ads]' role='measure' type='quantitative' />
            <column caption='Clicks Potenciales' datatype='integer' name='[clicks_potenciales]' role='measure' type='quantitative' />
            <column caption='Cluster' datatype='string' name='[cluster]' role='dimension' type='nominal' />
            <column caption='País' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month Year' datatype='string' name='[month_year]' role='dimension' type='nominal' />
            <column-instance column='[asset_type]' derivation='None' name='[none:asset_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
            <column-instance column='[cluster]' derivation='None' name='[none:cluster:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_year]' derivation='None' name='[none:month_year:nk]' pivot='key' type='nominal' />
            <column-instance column='[subcategory]' derivation='None' name='[none:subcategory:nk]' pivot='key' type='nominal' />
            <column caption='Subcategoría' datatype='string' name='[subcategory]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1686598079875919872]' derivation='User' name='[usr:Calculation_1686598079875919872:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Var ROAS mes anterior (copia)_1265230041906397199]' derivation='User' name='[usr:Var ROAS mes anterior (copia)_1265230041906397199:qk:2]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0e81b281axz6a5130ces70bga6d7].[none:asset_type:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:asset_type:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0e81b281axz6a5130ces70bga6d7].[none:category:nk]' filter-group='6'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:category:nk]' />
              <groupfilter function='empty-level' member='[none:category:nk]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0e81b281axz6a5130ces70bga6d7].[none:subcategory:nk]' filter-group='5'>
            <groupfilter function='member' level='[none:subcategory:nk]' member='&quot;Confectionary&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
            <target field='[federated.0e81b281axz6a5130ces70bga6d7].[none:subcategory:nk]' />
          </filter>
          <slices>
            <column>[federated.0e81b281axz6a5130ces70bga6d7].[none:cluster:nk]</column>
            <column>[federated.0e81b281axz6a5130ces70bga6d7].[none:country_name:nk]</column>
            <column>[federated.0e81b281axz6a5130ces70bga6d7].[none:asset_type:nk]</column>
            <column>[federated.0e81b281axz6a5130ces70bga6d7].[none:category:nk]</column>
            <column>[federated.0e81b281axz6a5130ces70bga6d7].[none:subcategory:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0e81b281axz6a5130ces70bga6d7].[usr:Calculation_1686598079875919872:qk]' />
              <text column='[federated.0e81b281axz6a5130ces70bga6d7].[usr:Var ROAS mes anterior (copia)_1265230041906397199:qk:2]' />
            </encodings>
