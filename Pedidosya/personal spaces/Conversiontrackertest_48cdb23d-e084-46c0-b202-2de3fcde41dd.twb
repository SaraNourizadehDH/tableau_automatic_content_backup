      <column caption='% cumpl. fillrate gral' datatype='real' name='[% cumpl. Revenue (copia)_1265230041306169345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks_dh_ads]) / &#13;&#10;&#13;&#10;SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([obj_clicks_potenciales]) })' />
