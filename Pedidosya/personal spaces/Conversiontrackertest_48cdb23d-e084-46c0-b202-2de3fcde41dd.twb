            <column caption='Fillrate' datatype='real' name='[Calculation_1686598079875919872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks_dh_ads]) / &#13;&#10;&#13;&#10;SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) })' />
            </column>
            <column caption='Objetivo Revenue €' datatype='real' name='[Calculation_1686598079919718409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [subcategory], [asset_type], [cluster] :&#13;&#10;   MAX(IF [obj_revenue_anual_euros] != 0 THEN [obj_revenue_anual_euros] END)&#13;&#10;}' />
            </column>
            <column caption='% cumpl. Revenue' datatype='real' name='[Calculation_1686598079924350988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ad_spend_eur_dh_ads]) / &#13;&#10;&#13;&#10;SUM({ FIXED [country_name],[yyyymmdd], [subcategory], [asset_type], [cluster] :&#13;&#10;   MAX(IF  [obj_revenue_anual_euros_accum (copia)_612489578365259781] != 0 THEN [obj_revenue_anual_euros_accum (copia)_612489578365259781] END)&#13;&#10;})' />
            </column>
            <column caption='ROAS' datatype='real' name='[Calculation_1686598079926321165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sales_revenue_eur_dh_ads]) / sum([ad_spend_eur_dh_ads])' />
            </column>
            <column aggregation='Min' caption='obj_revenue_base_mensual' datatype='real' name='[Calculation_612489578332905472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([obj_revenue_anual_euros])/78)*MONTH([yyyymmdd])' />
