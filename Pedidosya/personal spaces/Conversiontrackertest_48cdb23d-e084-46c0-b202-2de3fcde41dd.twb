    <worksheet name='inversion_ultimo_mes_cat'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Bold' fontsize='8'>Último mes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_tracker_by_category' name='federated.0e81b281axz6a5130ces70bga6d7' />
          </datasources>
          <datasource-dependencies datasource='federated.0e81b281axz6a5130ces70bga6d7'>
            <column caption='Mes cerrado' datatype='datetime' name='[Calculation_1265230041892438026]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='fecha_real_joaco' datatype='date' name='[Calculation_1295347864716652548]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM&quot;, [month_year]))' />
            </column>
            <column caption='Inversion ultimo mes cerrado' datatype='real' name='[Fillrate ultimo mes cerrado (copia)_1295347864743759880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [ad_spend_eur_dh_ads]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Filtro ultimo mes cerrado' datatype='boolean' name='[Filtro mes cerrado + anterior (copia)_1295347864713277441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1295347864716652548] = [Calculation_1265230041892438026]' />
            </column>
            <column caption='Ad Spend Eur Dh Ads' datatype='real' name='[ad_spend_eur_dh_ads]' role='measure' type='quantitative' />
            <column caption='Herramienta' datatype='string' name='[asset_type]' role='dimension' type='nominal' />
            <column caption='Cluster' datatype='string' name='[cluster]' role='dimension' type='nominal' />
            <column caption='País' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
