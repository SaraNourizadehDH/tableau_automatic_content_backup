        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Bold' fontsize='8'>Último mes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_tracker_by_category' name='federated.0e81b281axz6a5130ces70bga6d7' />
          </datasources>
          <datasource-dependencies datasource='federated.0e81b281axz6a5130ces70bga6d7'>
            <column caption='Mes cerrado' datatype='datetime' name='[Calculation_1265230041892438026]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='fecha_real_joaco' datatype='date' name='[Calculation_1295347864716652548]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM&quot;, [month_year]))' />
            </column>
            <column caption='Fillrate ultimo mes cerrado' datatype='real' name='[Fillrate (copia)_1295347864709701632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441] AND&#13;&#10;       // This condition ensures we count the FIXED value only once per unique combination.&#13;&#10;       // It picks the value from the row where [Month Year] is the minimum for that combination.&#13;&#10;       [month_year] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([month_year]) }&#13;&#10;    THEN&#13;&#10;        { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Fillrate mes previo al ultimo mes cerrado' datatype='real' name='[Fillrate ultimo mes cerrado (copia)_1295347864718696454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773] AND&#13;&#10;       // This condition ensures we count the FIXED value only once per unique combination.&#13;&#10;       // It picks the value from the row where [Month Year] is the minimum for that combination.&#13;&#10;       [month_year] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([month_year]) }&#13;&#10;    THEN&#13;&#10;        { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Filtro ultimo mes cerrado' datatype='boolean' name='[Filtro mes cerrado + anterior (copia)_1295347864713277441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1295347864716652548] = [Calculation_1265230041892438026]' />
            </column>
            <column caption='Filtro mes previo al ultimo mes cerrado' datatype='boolean' name='[Filtro ultimo mes cerrado (copia)_1295347864718368773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1295347864716652548] = DATEADD(&apos;month&apos;,-1,[Calculation_1265230041892438026])' />
            </column>
            <column caption='Var Fillrate mes anterior' datatype='real' name='[Var ROAS mes anterior (copia)_1265230041906397199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Fillrate (copia)_1295347864709701632]) - ZN([Fillrate ultimo mes cerrado (copia)_1295347864718696454])) / ABS(ZN([Fillrate ultimo mes cerrado (copia)_1295347864718696454]))' />
            </column>
