          <alias key='&quot;[federated.0e81b281axz6a5130ces70bga6d7].[usr:cpc_eur_calculado (copia)_2293739610355294210:qk]&quot;' value='CPC (ML)' />
        </aliases>
      </column>
      <column caption='CPC eur dh ads' datatype='real' name='[CPC_eur_dh_ads]' role='measure' type='quantitative' />
      <column caption='CPC ml dh ads' datatype='real' name='[CPC_ml_dh_ads]' role='measure' type='quantitative' />
      <column caption='cpc_eur_calculado' datatype='real' name='[Calculation_1265230041302474752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ad_spend_eur_dh_ads]) / SUM([clicks_dh_ads])' />
      </column>
      <column caption='fecha_real' datatype='date' name='[Calculation_1265230041307774978]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(&#13;&#10;  INT(RIGHT([month_year], 4)), &#13;&#10;  CASE LEFT([month_year], FIND([month_year], &quot; &quot;) - 1)&#13;&#10;    WHEN &quot;enero&quot; THEN 1&#13;&#10;    WHEN &quot;febrero&quot; THEN 2&#13;&#10;    WHEN &quot;marzo&quot; THEN 3&#13;&#10;    WHEN &quot;abril&quot; THEN 4&#13;&#10;    WHEN &quot;mayo&quot; THEN 5&#13;&#10;    WHEN &quot;junio&quot; THEN 6&#13;&#10;    WHEN &quot;julio&quot; THEN 7&#13;&#10;    WHEN &quot;agosto&quot; THEN 8&#13;&#10;    WHEN &quot;septiembre&quot; THEN 9&#13;&#10;    WHEN &quot;octubre&quot; THEN 10&#13;&#10;    WHEN &quot;noviembre&quot; THEN 11&#13;&#10;    WHEN &quot;diciembre&quot; THEN 12&#13;&#10;  END,&#13;&#10;  1&#13;&#10;)' />
      </column>
      <column caption='ultimo_mes' datatype='date' name='[Calculation_1265230041307906051]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([Calculation_1265230041307774978]) }' />
      </column>
      <column caption='fecha_real2' datatype='date' name='[Calculation_1265230041308905477]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(&#13;&#10;    INT(LEFT([month_year], 4)),         // Año&#13;&#10;    INT(RIGHT([month_year], 2)),        // Mes&#13;&#10;    1                                   // Día&#13;&#10;)' />
      </column>
      <column caption='ultimo_mes_2' datatype='date' name='[Calculation_1265230041310474247]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([Calculation_1265230041308905477]) }' />
      </column>
      <column caption='variacion_inversion' datatype='real' name='[Calculation_1265230041889890313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Objetivo revenue anual euros (copia)_1686598079924051979])) - ZN(LOOKUP(SUM([ad_spend_eur_dh_ads]), -1))) / ZN(LOOKUP(SUM([ad_spend_eur_dh_ads]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Mes cerrado' datatype='datetime' name='[Calculation_1265230041892438026]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))' />
      </column>
      <column caption='Mes del registro' datatype='datetime' name='[Calculation_1265230041893105675]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_1265230041307774978])' />
      </column>
      <column caption='Filtro mes cerrado + anterior' datatype='boolean' name='[Calculation_1265230041893400588]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1265230041893105675] = [Calculation_1265230041892438026]&#13;&#10;OR&#13;&#10;[Calculation_1686598079916199941] = DATEADD(&apos;month&apos;, -1, [Calculation_1265230041892438026])' />
      </column>
      <column caption='potenciales ultimo mes cerrado' datatype='integer' name='[Calculation_1295347864713637890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Potenciales Último Mes Cerrado&#13;&#10;IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;THEN&#13;&#10;    { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;END' />
      </column>
      <column caption='test_filtro_mes_cerrado' datatype='integer' name='[Calculation_1295347864714452995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) })' />
      </column>
      <column caption='fecha_real_joaco' datatype='date' name='[Calculation_1295347864716652548]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM&quot;, [month_year]))' />
      </column>
      <column caption='clicks potenciales por combinacion _ ultimo mes cerrado' datatype='integer' name='[Calculation_1295347864779239441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Clicks Potenciales por Combinación (LOD Base)&#13;&#10;IF [Filtro mes cerrado + anterior (copia)_1295347864713277441] THEN&#13;&#10;    { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;END' />
      </column>
      <column caption='suma total potenciales _ ultimo mes cerrado' datatype='integer' name='[Calculation_1295347864779481106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Suma Potenciales Únicos (Para Uso Global)&#13;&#10;{ FIXED : SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441] AND&#13;&#10;       // Esta parte selecciona solo una ocurrencia del valor del FIXED LOD por combinación.&#13;&#10;       // Es una forma de &quot;deduplicar&quot; si no tienes un ID de fila.&#13;&#10;       // Asegúrate de que las dimensiones en esta MIN sean las mismas que en tu FIXED original.&#13;&#10;       [month_year] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([month_year]) } AND&#13;&#10;       [country_name] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([country_name]) } AND&#13;&#10;       [asset_type] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([asset_type]) } AND&#13;&#10;       [category] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([category]) } AND&#13;&#10;       [subcategory] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([subcategory]) }&#13;&#10;    THEN&#13;&#10;        [Calculation_1295347864779239441]&#13;&#10;   END&#13;&#10;)}' />
      </column>
      <column caption='Fillrate' datatype='real' name='[Calculation_1686598079875919872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks_dh_ads]) / &#13;&#10;&#13;&#10;SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) })' />
      </column>
      <column caption='Inversion vs mes anterior' datatype='real' name='[Calculation_1686598079914778627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ad_spend_eur_dh_ads]) - LOOKUP(SUM([ad_spend_eur_dh_ads]), -1)) / ABS(LOOKUP(SUM([ad_spend_eur_dh_ads]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='mes_real' datatype='date' name='[Calculation_1686598079916199941]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(LEFT([month_year],4) + &quot;-&quot; + RIGHT([month_year],2) + &quot;-01&quot;)' />
      </column>
      <column caption='% cumplimiento revenue' datatype='real' name='[Calculation_1686598079918739464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([ad_spend_eur_dh_ads]) / ([Calculation_1686598079919718409])' />
      </column>
      <column caption='Objetivo Revenue €' datatype='real' name='[Calculation_1686598079919718409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name], [subcategory], [asset_type], [cluster] :&#13;&#10;   MAX(IF [obj_revenue_anual_euros] != 0 THEN [obj_revenue_anual_euros] END)&#13;&#10;}' />
      </column>
      <column caption='objetivo pruba 1' datatype='real' name='[Calculation_1686598079922978826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name], [category], [subcategory], [cluster] :&#13;&#10;    MAX([obj_revenue_anual_euros])&#13;&#10;}' />
      </column>
      <column caption='% cumpl. Revenue' datatype='real' name='[Calculation_1686598079924350988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ad_spend_eur_dh_ads]) / &#13;&#10;&#13;&#10;SUM({ FIXED [country_name],[yyyymmdd], [subcategory], [asset_type], [cluster] :&#13;&#10;   MAX(IF  [obj_revenue_anual_euros_accum (copia)_612489578365259781] != 0 THEN [obj_revenue_anual_euros_accum (copia)_612489578365259781] END)&#13;&#10;})' />
      </column>
      <column caption='ROAS' datatype='real' name='[Calculation_1686598079926321165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sales_revenue_eur_dh_ads]) / sum([ad_spend_eur_dh_ads])' />
      </column>
      <column caption='es_foco' datatype='boolean' name='[Calculation_2519201065908449280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ZN([obj_revenue_anual_euros])&gt;0' />
      </column>
      <column caption='metrica_seleccionada_evolucion' datatype='real' name='[Calculation_2519201065974226946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Inversión&apos; THEN SUM([ad_spend_eur_dh_ads])&#13;&#10;&#13;&#10;WHEN &apos;Fillrate&apos; THEN [Calculation_1686598079875919872]&#13;&#10;WHEN &apos;ROAS&apos; THEN [Calculation_1686598079926321165]&#13;&#10;WHEN &apos;CPC (EU)&apos; THEN [Calculation_1265230041302474752]&#13;&#10;ELSE NULL // Opcional: para manejar casos donde no hay selección o una selección no mapeada&#13;&#10;END' />
      </column>
      <column caption='formato_metrica_evolucion' datatype='string' name='[Calculation_2519201065975226371]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Inversión&apos; THEN &apos;€#,##0.00&apos; // Formato de moneda&#13;&#10;WHEN &apos;Fillrate&apos; THEN &apos;0.0%&apos;    // Formato de porcentaje&#13;&#10;END' />
      </column>
      <column caption='filtro_foco' datatype='boolean' name='[Calculation_2519201065987358724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Si&quot; THEN&#13;&#10;    [Calculation_2519201065908449280] // Solo TRUE para las categorías foco&#13;&#10;ELSE&#13;&#10;    TRUE // Todas las categorías (TRUE para todas las filas)&#13;&#10;END' />
      </column>
      <column aggregation='Min' caption='obj_revenue_base_mensual' datatype='real' name='[Calculation_612489578332905472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([obj_revenue_anual_euros])/78)*MONTH([yyyymmdd])' />
      </column>
      <column caption='obj_revenue_anual_euros_accum' datatype='real' name='[Calculation_612489578333257729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([obj_revenue_anual_euros]/78)*((MONTH([yyyymmdd])*(MONTH([yyyymmdd])+1))/2)' />
      </column>
      <column caption='obj_revenue_acumulado' datatype='real' name='[Calculation_612489578333892610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name], [subcategory], [asset_type], [cluster] :&#13;&#10;   MAX(IF [Calculation_612489578333257729] != 0 THEN [Calculation_612489578333257729] END)&#13;&#10;}' />
      </column>
      <column caption='metrica_seleccionada_obj_evolucion' datatype='real' name='[Calculation_612489578339004420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;&#13;&#10;    WHEN &apos;Inversión&apos; THEN&#13;&#10;        SUM(&#13;&#10;            IF [Parameters].[Parámetro 2] = &apos;Si&apos; THEN [obj_revenue_anual_euros_accum (copia)_612489578365259781]&#13;&#10;            END&#13;&#10;        )&#13;&#10;&#13;&#10;    WHEN &apos;Fillrate&apos; THEN&#13;&#10;        (&#13;&#10;            IF [Parameters].[Parámetro 2] = &apos;Si&apos; THEN [Objetivo_fillrate_mensual (copia)_1434959463400480769]&#13;&#10;            END&#13;&#10;        )&#13;&#10;&#13;&#10;    ELSE&#13;&#10;        NULL&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='revenue_vs_target' datatype='real' name='[Calculation_612489578695913478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM({ FIXED [country_name],[yyyymmdd], [subcategory], [asset_type], [cluster] :&#13;&#10;   MAX(IF  [obj_revenue_anual_euros_accum (copia)_612489578365259781] != 0 THEN [obj_revenue_anual_euros_accum (copia)_612489578365259781] END)&#13;&#10;}) / SUM([ad_spend_eur_dh_ads]) ) -1' />
      </column>
      <column caption='Meses desde abril' datatype='integer' name='[Calculation_971370176413814785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, DATE(&quot;2025-02-01&quot;), [Calculation_1295347864716652548])' />
      </column>
      <column caption='Objetivo_fillrate_mensual' datatype='real' name='[Calculation_971370176413954050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1295347864716652548] &lt; DATE(&quot;2025-02-01&quot;) THEN&#13;&#10;    0.06&#13;&#10;ELSE&#13;&#10;    0.08 + ([Calculation_971370176413814785] / 11) * (0.30 - 0.08)&#13;&#10;END' />
      </column>
      <column caption='Objetivo_fillrate_calculado' datatype='real' name='[Calculation_971370176418988035]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [month_year] : MIN([Calculation_971370176413954050]) }' />
      </column>
      <column caption='Fillrate ultimo mes cerrado' datatype='real' name='[Fillrate (copia)_1295347864709701632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441] AND&#13;&#10;       // This condition ensures we count the FIXED value only once per unique combination.&#13;&#10;       // It picks the value from the row where [Month Year] is the minimum for that combination.&#13;&#10;       [month_year] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([month_year]) }&#13;&#10;    THEN&#13;&#10;        { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Inversion mes previo al ultimo mes cerrado' datatype='real' name='[Fillrate mes previo al ultimo mes cerrado (copia)_1295347864745697290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [ad_spend_eur_dh_ads]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Fillrate mes previo al ultimo mes cerrado' datatype='real' name='[Fillrate ultimo mes cerrado (copia)_1295347864718696454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773] AND&#13;&#10;       // This condition ensures we count the FIXED value only once per unique combination.&#13;&#10;       // It picks the value from the row where [Month Year] is the minimum for that combination.&#13;&#10;       [month_year] = { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MIN([month_year]) }&#13;&#10;    THEN&#13;&#10;        { FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) }&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Inversion ultimo mes cerrado' datatype='real' name='[Fillrate ultimo mes cerrado (copia)_1295347864743759880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [ad_spend_eur_dh_ads]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='ROAS ultimo mes cerrado' datatype='real' name='[Fillrate ultimo mes cerrado (copia)_1295347864758812683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [sales_revenue_eur_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/ &#13;&#10;SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [ad_spend_eur_dh_ads]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Filtro ultimo mes cerrado' datatype='boolean' name='[Filtro mes cerrado + anterior (copia)_1295347864713277441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1295347864716652548] = [Calculation_1265230041892438026]' />
      </column>
      <column caption='Filtro mes previo al ultimo mes cerrado' datatype='boolean' name='[Filtro ultimo mes cerrado (copia)_1295347864718368773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1295347864716652548] = DATEADD(&apos;month&apos;,-1,[Calculation_1265230041892438026])' />
      </column>
      <column caption='ad spend euros' datatype='real' name='[Objetivo revenue anual euros (copia)_1686598079924051979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name], [account_type], [subcategory], [cluster] : &#13;&#10;   MAX([ad_spend_eur_dh_ads]) &#13;&#10;}' />
      </column>
      <column caption='Objetivo_fillrate_mensual (copia)' datatype='real' name='[Objetivo_fillrate_mensual (copia)_1434959463400480769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([obj_clicks_potenciales]) }) /  SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX(clicks_potenciales) })' />
      </column>
      <column caption='CPC previo al ultimo mes cerrado' datatype='real' name='[ROAS previo al ultimo mes cerrado (copia)_1295347864765624336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [ad_spend_eur_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/ &#13;&#10;SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='ROAS previo al ultimo mes cerrado' datatype='real' name='[ROAS ultimo mes cerrado (copia)_1295347864761569292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [sales_revenue_eur_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/ &#13;&#10;SUM(&#13;&#10;    IF [Filtro ultimo mes cerrado (copia)_1295347864718368773]&#13;&#10;    THEN [ad_spend_eur_dh_ads]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='CPC ultimo mes cerrado' datatype='real' name='[ROAS ultimo mes cerrado (copia)_1295347864764895247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [ad_spend_eur_dh_ads]&#13;&#10;    END&#13;&#10;)&#13;&#10;/ &#13;&#10;SUM(&#13;&#10;    IF [Filtro mes cerrado + anterior (copia)_1295347864713277441]&#13;&#10;    THEN [clicks_dh_ads]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='ROAS dh ads' datatype='real' name='[ROAS_dh_ads]' role='measure' type='quantitative' />
      <column caption='Var Inversion mes anterior' datatype='real' name='[Var Fillrate mes anterior (copia)_1295347864745570313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Fillrate ultimo mes cerrado (copia)_1295347864743759880]) - ZN([Fillrate mes previo al ultimo mes cerrado (copia)_1295347864745697290])) / ABS(ZN([Fillrate mes previo al ultimo mes cerrado (copia)_1295347864745697290]))' />
      </column>
      <column caption='Var ROAS mes anterior ' datatype='real' name='[Var Fillrate mes anterior (copia)_1295347864762462221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Fillrate ultimo mes cerrado (copia)_1295347864758812683]) - ZN([ROAS ultimo mes cerrado (copia)_1295347864761569292])) / ABS(ZN([ROAS ultimo mes cerrado (copia)_1295347864761569292]))' />
      </column>
      <column caption='Var CPC mes anterior' datatype='real' name='[Var ROAS mes anterior (copia)_1265230041899622414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([ROAS ultimo mes cerrado (copia)_1295347864764895247]) - ZN([ROAS previo al ultimo mes cerrado (copia)_1295347864765624336])) / ABS(ZN([ROAS previo al ultimo mes cerrado (copia)_1295347864765624336]))' />
