    <worksheet name='evolucion_fillrate_cat'>
      <table>
        <view>
          <datasources>
            <datasource caption='conversion_tracker_by_category' name='federated.0e81b281axz6a5130ces70bga6d7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='seleccionar_metrica_evolucion' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fillrate&quot;'>
              <calculation class='tableau' formula='&quot;Fillrate&quot;' />
            </column>
            <column alias='Solamente' caption='Categorías Estratégicas' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Si&quot;'>
              <calculation class='tableau' formula='&quot;Si&quot;' />
              <aliases>
                <alias key='&quot;No&quot;' value='Todo' />
                <alias key='&quot;Si&quot;' value='Solamente' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e81b281axz6a5130ces70bga6d7'>
            <column caption='cpc_eur_calculado' datatype='real' name='[Calculation_1265230041302474752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ad_spend_eur_dh_ads]) / SUM([clicks_dh_ads])' />
            </column>
            <column caption='fecha_real_joaco' datatype='date' name='[Calculation_1295347864716652548]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM&quot;, [month_year]))' />
            </column>
            <column caption='Fillrate' datatype='real' name='[Calculation_1686598079875919872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks_dh_ads]) / &#13;&#10;&#13;&#10;SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([clicks_potenciales]) })' />
            </column>
            <column caption='ROAS' datatype='real' name='[Calculation_1686598079926321165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sales_revenue_eur_dh_ads]) / sum([ad_spend_eur_dh_ads])' />
            </column>
            <column caption='es_foco' datatype='boolean' name='[Calculation_2519201065908449280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ZN([obj_revenue_anual_euros])&gt;0' />
            </column>
            <column caption='metrica_seleccionada_evolucion' datatype='real' name='[Calculation_2519201065974226946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Inversión&apos; THEN SUM([ad_spend_eur_dh_ads])&#13;&#10;&#13;&#10;WHEN &apos;Fillrate&apos; THEN [Calculation_1686598079875919872]&#13;&#10;WHEN &apos;ROAS&apos; THEN [Calculation_1686598079926321165]&#13;&#10;WHEN &apos;CPC (EU)&apos; THEN [Calculation_1265230041302474752]&#13;&#10;ELSE NULL // Opcional: para manejar casos donde no hay selección o una selección no mapeada&#13;&#10;END' />
            </column>
            <column caption='filtro_foco' datatype='boolean' name='[Calculation_2519201065987358724]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Si&quot; THEN&#13;&#10;    [Calculation_2519201065908449280] // Solo TRUE para las categorías foco&#13;&#10;ELSE&#13;&#10;    TRUE // Todas las categorías (TRUE para todas las filas)&#13;&#10;END' />
            </column>
            <column aggregation='Min' caption='obj_revenue_base_mensual' datatype='real' name='[Calculation_612489578332905472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([obj_revenue_anual_euros])/78)*MONTH([yyyymmdd])' />
            </column>
            <column caption='metrica_seleccionada_obj_evolucion' datatype='real' name='[Calculation_612489578339004420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;&#13;&#10;    WHEN &apos;Inversión&apos; THEN&#13;&#10;        SUM(&#13;&#10;            IF [Parameters].[Parámetro 2] = &apos;Si&apos; THEN [obj_revenue_anual_euros_accum (copia)_612489578365259781]&#13;&#10;            END&#13;&#10;        )&#13;&#10;&#13;&#10;    WHEN &apos;Fillrate&apos; THEN&#13;&#10;        (&#13;&#10;            IF [Parameters].[Parámetro 2] = &apos;Si&apos; THEN [Objetivo_fillrate_mensual (copia)_1434959463400480769]&#13;&#10;            END&#13;&#10;        )&#13;&#10;&#13;&#10;    ELSE&#13;&#10;        NULL&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Objetivo_fillrate_mensual (copia)' datatype='real' name='[Objetivo_fillrate_mensual (copia)_1434959463400480769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX([obj_clicks_potenciales]) }) /  SUM({ FIXED [month_year], [country_name], [asset_type], [category], [subcategory] : MAX(clicks_potenciales) })' />
            </column>
            <column caption='Ad Spend Eur Dh Ads' datatype='real' name='[ad_spend_eur_dh_ads]' role='measure' type='quantitative' />
            <column caption='Herramienta' datatype='string' name='[asset_type]' role='dimension' type='nominal' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Clicks Dh Ads' datatype='integer' name='[clicks_dh_ads]' role='measure' type='quantitative' />
            <column caption='Clicks Potenciales' datatype='integer' name='[clicks_potenciales]' role='measure' type='quantitative' />
            <column caption='Cluster' datatype='string' name='[cluster]' role='dimension' type='nominal' />
            <column caption='País' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month Year' datatype='string' name='[month_year]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2519201065987358724]' derivation='None' name='[none:Calculation_2519201065987358724:nk]' pivot='key' type='nominal' />
            <column-instance column='[asset_type]' derivation='None' name='[none:asset_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[cluster]' derivation='None' name='[none:cluster:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[subcategory]' derivation='None' name='[none:subcategory:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[obj_clicks_potenciales]' role='measure' type='quantitative' />
            <column caption='Obj Revenue Anual Euros' datatype='real' name='[obj_revenue_anual_euros]' role='measure' type='quantitative' />
            <column caption='obj_revenue_anual_euros_month' datatype='real' name='[obj_revenue_anual_euros_accum (copia)_612489578365259781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [yyyymmdd],[country_name], [subcategory], [asset_type], [cluster] :&#13;&#10;   MAX(IF [Calculation_612489578332905472] != 0 THEN [Calculation_612489578332905472] END)&#13;&#10;}' />
            </column>
            <column caption='Sales Revenue Eur Dh Ads' datatype='real' name='[sales_revenue_eur_dh_ads]' role='measure' type='quantitative' />
            <column caption='Subcategoría' datatype='string' name='[subcategory]' role='dimension' type='nominal' />
            <column-instance column='[ad_spend_eur_dh_ads]' derivation='Sum' name='[sum:ad_spend_eur_dh_ads:qk]' pivot='key' type='quantitative' />
            <column-instance column='[obj_revenue_anual_euros_accum (copia)_612489578365259781]' derivation='Sum' name='[sum:obj_revenue_anual_euros_accum (copia)_612489578365259781:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1295347864716652548]' derivation='Month-Trunc' name='[tmn:Calculation_1295347864716652548:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1686598079875919872]' derivation='User' name='[usr:Calculation_1686598079875919872:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2519201065974226946]' derivation='User' name='[usr:Calculation_2519201065974226946:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_612489578339004420]' derivation='User' name='[usr:Calculation_612489578339004420:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[yyyymmdd]' role='dimension' type='ordinal' />
          </datasource-dependencies>
