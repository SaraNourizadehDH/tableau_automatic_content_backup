      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_F0547EC0C6BA46CD8605A929B0745122'>
            <properties context=''>
              <relation connection='bigquery.0xtfi0c0769wgq1g3t0w40bjjf73' name='Consulta SQL personalizada' type='text'>with logistic_orders AS&#13;
(&#13;
SELECT&#13;
created_date_local,&#13;
country.country_name,&#13;
country.country_code,&#13;
city.city_name,&#13;
city.city_id,&#13;
COUNT(DISTINCT platform_order_code) AS logistic_orders,&#13;
COUNT(DISTINCT CASE WHEN b.staffing_impact_min &gt;&gt; 10 then b.order_id END) AS staffing_issue_orders&#13;
FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` a &#13;
LEFT JOIN  `peya-datamarts-pro.dm_fulfillment.staffing_issues_order_level` b  &#13;
  ON a.platform_order_code = b.order_id&#13;
WHERE&#13;
created_date_local &gt;&gt;= &quot;2023-01-01&quot;&#13;
GROUP BY 1,2,3,4,5&#13;
)&#13;
&#13;
, total_sessions AS&#13;
(&#13;
SELECT&#13;
date&#13;
, country_code&#13;
, city_id&#13;
, count(distinct session_id) as total_sessions&#13;
, count(distinct case when time_start_home_in_minutes is not null then session_id end) as home_sessions&#13;
, count(distinct case when time_start_list_in_minutes is not null then session_id end) as list_sessions&#13;
FROM `peya-datamarts-pro.dm_fulfillment.fact_sessions_for_zone_stats`&#13;
WHERE date &gt;&gt;= &quot;2023-01-01&quot;&#13;
GROUP BY 1,2,3&#13;
&#13;
)&#13;
SELECT&#13;
EXTRACT (MONTH FROM ingested_at) as mes&#13;
, ingested_at as dia&#13;
, country_code&#13;
, city_name&#13;
--, sum(CVR2_sessions) as sessions_cvr2&#13;
--, sum(lost_orders_p75) as lost_orders_p75&#13;
--, sum(lost_orders_pond) as lost_orders_pond&#13;
, sum(lost_orders_comb) as lost_orders_comb&#13;
, sum(logistic_orders) as logistic_orders&#13;
, sum(staffing_issue_orders) as staffing_issue_orders&#13;
, sum(cvr2_sessions) as cvr2_sessions&#13;
, sum(cvr2_transactions) as cvr2_transactions&#13;
&#13;
&#13;
FROM(&#13;
SELECT&#13;
a.*&#13;
, b.CVR2&#13;
, b.CVR2_50&#13;
, b.cvr_index&#13;
, b.CVR2_75&#13;
, b.CVR2_sessions&#13;
, b.CVR2_transactions&#13;
, logistic_orders&#13;
, staffing_issue_orders&#13;
, c.home_sessions&#13;
, c.list_sessions&#13;
, case when cvr_index = 1 and md_index_p75 = 1 then (CVR2_75*CVR2_sessions)-(CVR2*CVR2_sessions) else 0 end as lost_orders_p75&#13;
, case when cvr_index = 1 and md_index_pond = 1 then (CVR2_75*CVR2_sessions)-(CVR2*CVR2_sessions) else 0 end as lost_orders_pond&#13;
, case when cvr_index = 1 and (md_index_pond = 1 or md_index_p75 = 1) then (CVR2_75*home_sessions)-(CVR2*home_sessions) else 0 end as lost_orders_comb_home&#13;
, case when cvr_index = 1 and (md_index_pond = 1 or md_index_p75 = 1) then (CVR2_75*list_sessions)-(CVR2*list_sessions) else 0 end as lost_orders_comb_list&#13;
, case when cvr_index = 1 and (md_index_pond = 1 or md_index_p75 = 1) then (CVR2_75*CVR2_sessions)-(CVR2*CVR2_sessions) else 0 end as lost_orders_comb&#13;
, (case when d.city_id is not null then 1 else 0 end) valid_city&#13;
FROM `peya-datamarts-pro.dm_fulfillment.mean_delay_index_daily` a&#13;
LEFT JOIN `peya-datamarts-pro.dm_fulfillment.cvr_index_daily` b&#13;
ON a.country_code = b.country_code&#13;
AND a.city_id = b.city_id&#13;
AND a.ingested_at = b.date&#13;
LEFT JOIN logistic_orders d&#13;
ON a.country_code = d.country_code&#13;
AND a.city_id = d.city_id&#13;
AND a.ingested_at = d.created_date_local&#13;
LEFT JOIN total_sessions c&#13;
ON a.country_code = c.country_code&#13;
AND a.city_id = c.city_id&#13;
AND a.ingested_at = c.date&#13;
WHERE&#13;
TRUE&#13;
--AND a.city_name in (&apos;Buenos aires&apos;, &apos;Gba sur&apos;, &apos;Panama city&apos;, &apos;Panama oeste&apos;, &apos;Asuncion&apos;, &apos;Lima&apos;)&#13;
--AND EXTRACT(MONTH FROM date) = 8&#13;
)&#13;
group by 1,2,3,4&#13;
order by 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
