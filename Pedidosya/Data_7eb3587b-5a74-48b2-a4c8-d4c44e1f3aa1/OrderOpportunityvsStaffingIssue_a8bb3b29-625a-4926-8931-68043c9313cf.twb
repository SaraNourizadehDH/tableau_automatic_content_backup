      <aliases enabled='yes' />
      <column caption='Staffing Issue prop' datatype='real' name='[Calculation_1065101380394094592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([staffing_issue_orders])/SUM([logistic_orders])' />
      </column>
      <column caption='Order Opportunity prop' datatype='real' name='[Calculation_1065101380394299393]' role='measure' type='quantitative'>
