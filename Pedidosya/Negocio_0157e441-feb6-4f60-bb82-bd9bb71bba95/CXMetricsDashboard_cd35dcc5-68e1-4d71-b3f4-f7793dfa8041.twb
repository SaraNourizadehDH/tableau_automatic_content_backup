      <column caption='YoY (copia)' datatype='real' name='[YoY (copia)_1259037602385965059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([NPS_calculado (copia)_1259037602385240065]) - [NPS_año anterior (copia)_1259037602386214916]'>
