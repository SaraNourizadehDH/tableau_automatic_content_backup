      <column caption='link fb plus' datatype='string' name='[Calculation_1215408996437901313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Sistema de Feedback Plus&quot;' />
      </column>
      <column caption='link A plus' datatype='string' name='[Calculation_1215408996438200322]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Tablero Awareness Plus&quot;' />
      </column>
      <column caption='link C plus' datatype='string' name='[Calculation_1215408996438323203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Tablero Churn Plus&quot;' />
      </column>
      <column caption='Última Actualización del Tablero' datatype='datetime' name='[Calculation_1259037603039211526]' role='dimension' type='ordinal'>
