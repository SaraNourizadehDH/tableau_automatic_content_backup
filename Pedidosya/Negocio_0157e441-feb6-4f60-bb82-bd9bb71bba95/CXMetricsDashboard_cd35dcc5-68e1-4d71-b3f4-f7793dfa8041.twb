      <column caption='link qc' datatype='string' name='[Calculation_936185802953981954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Tablero CSAT Groceries&quot;' />
      </column>
      <column caption='link plus' datatype='string' name='[Calculation_936185802967044099]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Tablero CSAT Plus&quot;' />
      </column>
      <column caption='link app' datatype='string' name='[Calculation_936185802967101444]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Tablero CSAT APP&quot;' />
      </column>
      <column caption='link care' datatype='string' name='[Calculation_936185802967175173]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Tablero CX Care Metrics&quot;' />
      </column>
      <column caption='Filtro Mes/Q' datatype='boolean' name='[Calculation_996702922529931264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Monthly&quot; AND [granularity] = &quot;Monthly&quot; THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Quarterly&quot; AND [granularity] = &quot;Quarterly&quot; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='Eje de tiempo' datatype='date' name='[Calculation_996702922530267137]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Monthly&quot; THEN [period]&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Quarterly&quot; THEN [period] &#13;&#10;END' />
