                </zone>
                <zone forceUpdate='true' h='9466' id='346' type-v2='text' w='94729' x='4685' y='15025'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15' underline='true'>CSAT Affordability:</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='20'>Æ </run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'> Mide la percepción que tienen los usuarios  y potenciales usuarios sobre nuestros precios y costos.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿Cómo se calcula?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Se basa en una escala del 1-7 , aquellos con puntajes de 6 y 7 se consideran positivos.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>La fórmula para obtener el puntaje final es: (Nº de Respuestas Positivas) / (Nº Total de Respuestas)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿A quiénes se les envía la encuesta?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Usuarios prospects y activos.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>Frecuencia:</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'> Always-on.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='1320' id='443' param='horz' type-v2='layout-flow' w='94729' x='4685' y='24491'>
                  <zone h='1320' id='355' name='link affo' show-title='false' w='15593' x='4685' y='24491'>
