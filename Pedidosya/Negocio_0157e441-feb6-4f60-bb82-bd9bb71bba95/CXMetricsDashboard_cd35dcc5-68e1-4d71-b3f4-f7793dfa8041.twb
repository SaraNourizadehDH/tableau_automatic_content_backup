                <zone forceUpdate='true' h='9466' id='348' type-v2='text' w='94729' x='4685' y='37597'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15' underline='true'>CSAT Plus:</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='20'>Æ </run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Mide el nivel de satisfacción del programa de suscripción &quot;Plus&quot;.</run>
