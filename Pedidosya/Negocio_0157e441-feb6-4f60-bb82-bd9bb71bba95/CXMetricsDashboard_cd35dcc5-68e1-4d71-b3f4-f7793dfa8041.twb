                </zone>
                <zone forceUpdate='true' h='9473' id='352' type-v2='text' w='94729' x='4685' y='90207'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15' underline='true'>Food Review:</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='20'>Æ </run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Indicador de satisfacción de los platos de nuestros partners.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿Cómo se calcula?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Se basa en la pregunta cómo estuvo lo que pediste, en la cual usuario puntúa del 1-5 cada plato individual. 4 y 5 se consideran positivos.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>La fórmula para obtener el puntaje final es: (Nº de Calificaciones de 4 y 5 estrellas) / (Nº Total de Calificaciones de productos)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿A quiénes se les envía la encuesta?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Usuarios que realizaron una orden.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>Frecuencia:</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'> Always-on.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
