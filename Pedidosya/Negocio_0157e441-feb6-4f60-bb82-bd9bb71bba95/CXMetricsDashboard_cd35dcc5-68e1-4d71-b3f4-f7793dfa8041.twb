      <column caption='NPS_mes anterior (copia)' datatype='real' name='[NPS_mes anterior (copia)_1259037602386268165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &apos;Monthly&apos; THEN LOOKUP(AVG([NPS_calculado (copia)_1259037602385240065]), -1)&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &apos;Quarterly&apos; THEN LOOKUP(AVG([NPS_calculado (copia)_1259037602385240065]), -1)&#13;&#10;END'>
