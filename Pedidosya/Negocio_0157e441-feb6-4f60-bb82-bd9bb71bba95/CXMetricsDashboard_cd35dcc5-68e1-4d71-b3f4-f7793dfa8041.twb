    <worksheet name='tabla NPS vs (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Variación NPS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='all_surveys (automated_tables_reports)' name='federated.0ppna9y024lrco1dar1wh0o6zxr5' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date part' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mes&quot;'>
              <calculation class='tableau' formula='&quot;Mes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ppna9y024lrco1dar1wh0o6zxr5'>
            <column caption='fecha dinamica' datatype='datetime' name='[Calculation_715227940603711489]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Mes&apos; THEN DATETRUNC(&apos;month&apos;, [period])&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Q&apos; THEN DATETRUNC(&apos;quarter&apos;, [period])&#13;&#10;END' />
            </column>
            <column caption='NPS_calculado' datatype='real' name='[Calculation_715227940843159554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;month&apos;, [period]), [country], [metric] : SUM([kpi_value])}' />
            </column>
            <column caption='NPS_mes anterior' datatype='real' name='[Calculation_715227940858626051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Mes&apos; THEN LOOKUP(AVG([Calculation_715227940843159554]), -1)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Q&apos; THEN LOOKUP(AVG([Calculation_715227940843159554]), -1)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NPS_año anterior' datatype='real' name='[Calculation_715227940859445252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Mes&apos; THEN LOOKUP(AVG([Calculation_715227940843159554]), -12)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Q&apos; THEN LOOKUP(AVG([Calculation_715227940843159554]), -4)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM' datatype='real' name='[Calculation_715227940859613189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_715227940843159554]) - [Calculation_715227940858626051]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='YoY' datatype='real' name='[Calculation_715227940859764742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_715227940843159554]) - [Calculation_715227940859445252]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Es_Ultimo_Periodo_Visible' datatype='boolean' name='[Calculation_715227940861984775]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() == 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Variación YoY' datatype='real' name='[Calculation_715227940930179082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Mes&apos; THEN&#13;&#10;        ZN(AVG([kpi_value])) - LOOKUP(ZN(AVG([kpi_value])), -12)&#13;&#10;    WHEN &apos;Q&apos; THEN&#13;&#10;        ZN(AVG([kpi_value])) - LOOKUP(ZN(AVG([kpi_value])), -4)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country 2' datatype='string' name='[Country (copia)_436004765392101376]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country]' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Kpi Value' datatype='real' name='[kpi_value]' role='measure' type='quantitative' />
            <column caption='Metric' datatype='string' name='[metric]' role='dimension' type='nominal' />
            <column-instance column='[period]' derivation='MY' name='[my:period:ok]' pivot='key' type='ordinal' />
