            </column>
            <column caption='MoM (copia)' datatype='real' name='[MoM (copia)_1259037602385948674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([NPS_calculado (copia)_1259037602385240065]) - [NPS_mes anterior (copia)_1259037602386268165]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
