          <datasource-dependencies datasource='Parameters'>
            <column caption='Date part' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mes&quot;'>
              <calculation class='tableau' formula='&quot;Mes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ppna9y024lrco1dar1wh0o6zxr5'>
            <column caption='fecha dinamica' datatype='datetime' name='[Calculation_715227940603711489]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Mes&apos; THEN DATETRUNC(&apos;month&apos;, [period])&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Q&apos; THEN DATETRUNC(&apos;quarter&apos;, [period])&#13;&#10;END' />
