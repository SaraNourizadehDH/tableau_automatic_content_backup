                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='1320' id='450' name='link sq (5)' show-title='false' w='17204' x='20278' y='57849'>
                    <layout-cache fixed-size-h='25' fixed-size-w='227' type-h='fixed' type-w='fixed' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
                <zone forceUpdate='true' h='9466' id='350' type-v2='text' w='94729' x='4685' y='59169'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15' underline='true'>Care Need:</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='20'>Æ </run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Mide la necesidad de ayuda de nuestros usuarios. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿Cómo se calcula?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Se basa en la pregunta: ¿Tuviste un problema en los últimos 30 días por el cual necesitaste nuestra ayuda?.Se contabilizan las respuestas &quot;Sí&quot;.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>La fórmula para obtener el puntaje final es: (Nº de Usuarios que respondieron &quot;Sí&quot;) / (Nº Total de Respuestas)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿A quiénes se les envía la encuesta?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Usuarios activos con al menos 1 orden en los últimos 30 días.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>Frecuencia:</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'> Always-on.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='1320' id='451' param='horz' type-v2='layout-flow' w='94729' x='4685' y='68635'>
                  <zone h='1320' id='440' name='link care (2)' show-title='false' w='17204' x='4685' y='68635'>
                    <layout-cache fixed-size-h='25' fixed-size-w='227' type-h='fixed' type-w='fixed' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='1320' id='452' name='link sq (6)' show-title='false' w='17204' x='21889' y='68635'>
                    <layout-cache fixed-size-h='25' fixed-size-w='227' type-h='fixed' type-w='fixed' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
                <zone forceUpdate='true' h='9466' id='351' type-v2='text' w='94729' x='4685' y='69955'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15' underline='true'>Resolution Rate:</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='20'>Æ </run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Mide la percepción de resolución de problemas de nuestros usuarios.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿Cómo se calcula?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Se basa en la respuesta de nuestros usuarios que declararon que tuvieron un problema en los últimos 30 dias. Las opciones de respuesta son: &quot;Tuve un problema y pude resolverlo&quot; y &quot;Tuve un problema pero no pude resolverlo&quot;.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>La fórmula para obtener el puntaje final es: (Nº de Usuarios que &quot;pudieron resolverlo&quot;) / (Nº Total de Usuarios que tuvieron un problema)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿A quiénes se les envía la encuesta?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Usuarios activos con al menos 1 orden en los últimos 30 días.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>Frecuencia:</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'> Always-on.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='1320' id='453' param='horz' type-v2='layout-flow' w='94729' x='4685' y='79421'>
                  <zone h='1320' id='358' name='link care' show-title='false' w='17204' x='4685' y='79421'>
                    <layout-cache fixed-size-h='25' fixed-size-w='227' type-h='fixed' type-w='fixed' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='1320' id='454' name='link sq (7)' show-title='false' w='17204' x='21889' y='79421'>
                    <layout-cache fixed-size-h='25' fixed-size-w='227' type-h='fixed' type-w='fixed' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
                <zone forceUpdate='true' h='9466' id='353' type-v2='text' w='94729' x='4685' y='80741'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='15' underline='true'>Delivery Food Review:</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='20'>Æ </run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'> Indicador de satisfacción de la entrega de nuestros pedidos.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿Cómo se calcula?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Se basa en la pregunta cómo estuvo el envío? , con una calificación binaria (Positivo / Negativo), representada con íconos de &quot;pulgar arriba / pulgar abajo”.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>¿A quiénes se les envía la encuesta?</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'>Usuarios que realizaron una orden.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Calibri' fontsize='12'>Frecuencia:</run>
                    <run fontcolor='#000000' fontname='Calibri' fontsize='12'> Always-on.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
