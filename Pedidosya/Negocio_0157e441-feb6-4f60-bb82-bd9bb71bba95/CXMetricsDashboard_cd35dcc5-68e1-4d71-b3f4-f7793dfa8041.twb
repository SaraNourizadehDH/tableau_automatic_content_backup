      <column caption='Fecha de actualización' datatype='date' name='[Calculation_996702922657189893]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([period])}' />
      </column>
      <column caption='Country 2' datatype='string' name='[Country (copia)_436004765392101376]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country]' />
      </column>
      <column caption='MoM (copia)' datatype='real' name='[MoM (copia)_1259037602385948674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([NPS_calculado (copia)_1259037602385240065]) - [NPS_mes anterior (copia)_1259037602386268165]'>
