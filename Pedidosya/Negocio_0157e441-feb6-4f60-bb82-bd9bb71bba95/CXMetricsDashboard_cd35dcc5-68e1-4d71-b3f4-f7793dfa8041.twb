          <datasource-dependencies datasource='Parameters'>
            <column caption='Date part' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mes&quot;'>
              <calculation class='tableau' formula='&quot;Mes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ppna9y024lrco1dar1wh0o6zxr5'>
            <column caption='fecha dinamica' datatype='datetime' name='[Calculation_715227940603711489]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Mes&apos; THEN DATETRUNC(&apos;month&apos;, [period])&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Q&apos; THEN DATETRUNC(&apos;quarter&apos;, [period])&#13;&#10;END' />
            </column>
            <column caption='Es_Ultimo_Periodo_Visible' datatype='boolean' name='[Calculation_715227940861984775]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() == 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Variación MoM' datatype='real' name='[Calculation_715227940924612616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(AVG([kpi_value])) - LOOKUP(ZN(AVG([kpi_value])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Variación YoY' datatype='real' name='[Calculation_715227940930179082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Mes&apos; THEN&#13;&#10;        ZN(AVG([kpi_value])) - LOOKUP(ZN(AVG([kpi_value])), -12)&#13;&#10;    WHEN &apos;Q&apos; THEN&#13;&#10;        ZN(AVG([kpi_value])) - LOOKUP(ZN(AVG([kpi_value])), -4)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country 2' datatype='string' name='[Country (copia)_436004765392101376]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
