          </datasources>
          <datasource-dependencies datasource='federated.082sdrz1odotp715ljln30hg1jxt'>
            <column caption='Devolucion' datatype='real' name='[Calculation_276127020712386561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column datatype='string' name='[PickUp]' role='dimension' type='nominal' />
            <column caption='Valor comision' datatype='real' name='[commission_amount]' role='measure' type='quantitative' />
            <column caption='Estado orden' datatype='string' name='[estado_orden]' role='dimension' type='nominal' />
            <column caption='Franchise' datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
            <column-instance column='[estado_orden]' derivation='None' name='[none:estado_orden:nk]' pivot='key' type='nominal' />
            <column-instance column='[franchise_name]' derivation='None' name='[none:franchise_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[tools_description]' derivation='None' name='[none:tools_description:nk]' pivot='key' type='nominal' />
            <column caption='Valor productos' datatype='real' name='[order_amount]' role='measure' type='quantitative' />
            <column caption='Fecha orden' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_276127020712386561]' derivation='Sum' name='[sum:Calculation_276127020712386561:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_date]' derivation='Month-Trunc' name='[tmn:order_date:ok]' pivot='key' type='ordinal' />
            <column caption='Motivo rechazo' datatype='string' name='[tools_description]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.082sdrz1odotp715ljln30hg1jxt].[none:estado_orden:nk]'>
