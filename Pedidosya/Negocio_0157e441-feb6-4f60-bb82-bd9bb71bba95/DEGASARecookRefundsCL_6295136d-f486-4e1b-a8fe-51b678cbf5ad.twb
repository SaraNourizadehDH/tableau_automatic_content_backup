      <aliases enabled='yes' />
      <column caption='Monto Penalización' datatype='real' name='[Calculation_114278870382751745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [franquicia]=&quot;Wendy&apos;s&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;KFC&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;China Wok&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Missing item&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Food quality&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Wrong order&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Wrong item&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;Buffalo Waffles&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;Pizza Hut&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;Telepizza&quot; then [valor_devolucion]*1&#13;&#10;END' />
      </column>
      <column caption='Row N' datatype='integer' name='[Calculation_114278870384832515]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fecha Orden' datatype='date' datatype-customized='true' name='[Calculation_114278870395789316]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[fecha_orden]' />
      </column>
      <column caption='Fecha' datatype='string' datatype-customized='true' name='[Calculation_271623379917475841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([order_date])' />
      </column>
      <column caption='Devolución' datatype='real' name='[Calculation_271623379925893125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;ELSEIF [franchise_name]=&quot;Telepizza&quot; then ([order_amount])*0.40&#13;&#10;ELSEIF [franchise_name]=&quot;Pizza Hut&quot; then ([order_amount])*0.40&#13;&#10;ELSEIF [franchise_name]=&quot;Buffalo Waffles&quot; then ([order_amount])*0.40&#13;&#10;END' />
      </column>
      <column caption='Rider Id' datatype='string' name='[Calculation_336081159472570368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_797700113872003072] IN (&quot;KFC&quot;, &quot;Wendy&apos;s&quot;, &quot;China Wok&quot;) then [rider_id] else &quot;BORRAR&quot; END' />
      </column>
      <column caption='User Id' datatype='string' name='[Calculation_336081159472918529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_797700113872003072] IN (&quot;KFC&quot;, &quot;Wendy&apos;s&quot;, &quot;China Wok&quot;) then [user_id] else &quot;BORRAR&quot; END' />
      </column>
      <column caption='Franchise' datatype='string' name='[Calculation_797700113872003072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[franchise_name]' />
      </column>
      <column caption='SAP ID' datatype='string' name='[Calculation_797700113873133569]' role='dimension' type='nominal'>
