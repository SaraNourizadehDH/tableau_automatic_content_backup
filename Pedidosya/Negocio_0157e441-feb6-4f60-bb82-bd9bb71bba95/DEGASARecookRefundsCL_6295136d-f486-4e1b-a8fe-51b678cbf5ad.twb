    <worksheet name='Resumen franchise Devoluciones parciales'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>&lt;</run>
            <run bold='true' fontcolor='#ffffff'>Sheet Name</run>
            <run bold='true' fontcolor='#ffffff'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Devos parciales (user_camilo_zelada)' name='federated.15dwjab05yt14u1b7rct50kehm26' />
          </datasources>
          <datasource-dependencies datasource='federated.15dwjab05yt14u1b7rct50kehm26'>
            <column caption='Penalizacion' datatype='real' name='[Calculation_849491482252857351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [franchise_name]=&quot;Wendy&apos;s&quot; then [devolucion_usuario]*0.25&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; then [devolucion_usuario]*0.25&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; then [devolucion_usuario]*0.25&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Missing item&quot; then [devolucion_usuario]*1&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Food quality&quot; then [devolucion_usuario]*0.5&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Wrong order&quot; then [devolucion_usuario]*0.5&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Wrong item&quot; then [devolucion_usuario]*0.5&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column datatype='real' name='[devolucion_usuario]' role='measure' type='quantitative' />
            <column caption='Fecha' datatype='date' name='[fecha_hora_orden]' role='dimension' type='ordinal' />
            <column caption='Franchise' datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
            <column-instance column='[fecha_hora_orden]' derivation='Month' name='[mn:fecha_hora_orden:ok]' pivot='key' type='ordinal' />
            <column caption='Motivo' datatype='string' name='[motivo]' role='dimension' type='nominal' />
            <column-instance column='[franchise_name]' derivation='None' name='[none:franchise_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[motivo]' derivation='None' name='[none:motivo:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_849491482252857351]' derivation='Sum' name='[sum:Calculation_849491482252857351:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.15dwjab05yt14u1b7rct50kehm26].[mn:fecha_hora_orden:ok]' filter-group='3'>
            <groupfilter function='level-members' level='[mn:fecha_hora_orden:ok]' />
          </filter>
          <filter class='categorical' column='[federated.15dwjab05yt14u1b7rct50kehm26].[none:franchise_name:nk]' filter-group='4'>
