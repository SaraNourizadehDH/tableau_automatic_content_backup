      </column>
      <column caption='Restaurant' datatype='string' name='[Calculation_797700113904218119]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[local]' />
      </column>
      <column caption='Cupon ID' datatype='string' name='[Calculation_797700113905008649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[coupon_id]' />
      </column>
      <column caption='Order Id' datatype='integer' name='[Calculation_797700113905115146]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[numero_orden 1]' />
      </column>
      <column caption='Restaurant Id' datatype='integer' name='[Calculation_797700113908400139]' role='dimension' type='ordinal'>
