            <column caption='Penalizacion' datatype='real' name='[Calculation_849491482252857351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [franchise_name]=&quot;Wendy&apos;s&quot; then [devolucion_usuario]*0.25&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; then [devolucion_usuario]*0.25&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; then [devolucion_usuario]*0.25&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Missing item&quot; then [devolucion_usuario]*1&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Food quality&quot; then [devolucion_usuario]*0.5&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Wrong order&quot; then [devolucion_usuario]*0.5&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; and [motivo]=&quot;Wrong item&quot; then [devolucion_usuario]*0.5&#13;&#10;else 0&#13;&#10;END' />
