              <calculation class='tableau' formula='IF [franquicia]=&quot;Wendy&apos;s&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;KFC&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;China Wok&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Missing item&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Food quality&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Wrong order&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Wrong item&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;Buffalo Waffles&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;Pizza Hut&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;Telepizza&quot; then [valor_devolucion]*1&#13;&#10;END' />
