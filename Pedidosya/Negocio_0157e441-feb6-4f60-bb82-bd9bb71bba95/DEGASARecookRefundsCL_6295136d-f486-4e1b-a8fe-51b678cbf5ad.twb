    <worksheet name='Monto SV Mes'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Monto SV por Mes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='SV logica vieja y nueva feb-mar (user_camilo_zelada)' name='federated.0wl57hx12ot96k11bgr831by5jmz' />
          </datasources>
          <datasource-dependencies datasource='federated.0wl57hx12ot96k11bgr831by5jmz'>
            <column caption='Monto Penalización' datatype='real' name='[Calculation_114278870382751745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [franquicia]=&quot;Wendy&apos;s&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;KFC&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;China Wok&quot; then [valor_devolucion]*0.25&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Missing item&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Food quality&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Wrong order&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;McDonald&apos;s&quot; and [motivo_devolucion]=&quot;Wrong item&quot; then [valor_devolucion]*0.5&#13;&#10;ELSEIF [franquicia]=&quot;Buffalo Waffles&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;Pizza Hut&quot; then [valor_devolucion]*1&#13;&#10;ELSEIF [franquicia]=&quot;Telepizza&quot; then [valor_devolucion]*1&#13;&#10;END' />
            </column>
            <column caption='Franquicia' datatype='string' name='[Calculation_797700113908940814]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[franquicia]' />
            </column>
            <column datatype='date' name='[fecha_orden]' role='dimension' type='ordinal' />
            <column datatype='string' name='[franquicia]' role='dimension' type='nominal' />
            <column-instance column='[fecha_orden]' derivation='ISO-Week' name='[iwk:fecha_orden:ok]' pivot='key' type='ordinal' />
            <column-instance column='[fecha_orden]' derivation='Month' name='[mn:fecha_orden:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[motivo_devolucion]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_797700113908940814]' derivation='None' name='[none:Calculation_797700113908940814:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_114278870382751745]' derivation='Sum' name='[sum:Calculation_114278870382751745:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[valor_devolucion]' role='measure' type='quantitative' />
          </datasource-dependencies>
