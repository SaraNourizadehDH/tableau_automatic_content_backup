      <aliases enabled='yes' />
      <column caption='% devolucion 1%' datatype='real' name='[% devolucion 5% (copia)_276127020729405448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [estado_orden]=&quot;REJECTED&quot; and [fail_rate_owner]!=&quot;Restaurant&quot; and [Etapa_rej] in (&apos;Before PickUp&apos;,&apos;Before DropOff&apos;,&apos;After Drop Off&apos;) and [tools_description] in (&apos;No es posible contactar al cliente&apos;,&apos;Repartidor incontactable&apos;) then [Calculation_276127020712386561] end)/sum(if [estado_orden]=&quot;CONFIRMED&quot; and [Etapa_rej]=&quot;Delivered&quot; then [total_amount] end)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.082sdrz1odotp715ljln30hg1jxt].[cum:sum:Calculation_276127020712386561:qk]&quot;' value='Suma devolución CAP 5%' />
          <alias key='&quot;[federated.082sdrz1odotp715ljln30hg1jxt].[cum:sum:Devolucion (copia)_849491482209742851:qk]&quot;' value='Suma devolución CAP 1%' />
          <alias key='&quot;[federated.082sdrz1odotp715ljln30hg1jxt].[sum:Devolucion (copia)_691865493931597824:qk]&quot;' value='Devolución 100% CAP 5%' />
          <alias key='&quot;[federated.082sdrz1odotp715ljln30hg1jxt].[sum:Devolucion 100\% CAP 5\% (copia)_849491482210373636:qk]&quot;' value='Devolución 100% CAP 1%' />
        </aliases>
      </column>
      <column caption='Devolucion' datatype='real' name='[Calculation_276127020712386561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])*0.57&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])*0.50&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Valor calculo' datatype='real' name='[Calculation_276127020717465603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parámetro 1]=&quot;Devolucion&quot; then [Calculation_276127020712386561]&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&quot;order_amount&quot; then [order_amount] end' />
      </column>
      <column caption='% devolucion 5%' datatype='real' name='[Calculation_276127020723736583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [estado_orden]=&quot;REJECTED&quot; and [fail_rate_owner]!=&quot;Restaurant&quot; and [Etapa_rej] in (&apos;Before PickUp&apos;,&apos;Before DropOff&apos;,&apos;After Drop Off&apos;) then [Calculation_276127020712386561] end)/sum(if [estado_orden]=&quot;CONFIRMED&quot; and [Etapa_rej]=&quot;Delivered&quot; then [total_amount] end)' />
      </column>
      <column caption='Limite cap 1%' datatype='real' name='[Calculation_849491482207162369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_amount]*0.01' />
      </column>
      <column caption='Data up to' datatype='date' name='[Calculation_849491482258223114]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([order_date])' />
      </column>
      <column caption='Devolucion 100% CAP 5%' datatype='real' name='[Devolucion (copia)_691865493931597824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])&#13;&#10;ELSEIF [franchise_name]=&quot;Wendy&apos;s&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])&#13;&#10;ELSEIF [franchise_name]=&quot;KFC&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;No&quot; then ([order_amount]-[commission_amount])&#13;&#10;ELSEIF [franchise_name]=&quot;China Wok&quot; AND [PickUp]=&quot;Si&quot; then ([order_amount]-[commission_amount])&#13;&#10;else 0&#13;&#10;END' />
      </column>
      <column caption='Devolucion 1%' datatype='real' name='[Devolucion (copia)_849491482209742851]' role='measure' type='quantitative'>
