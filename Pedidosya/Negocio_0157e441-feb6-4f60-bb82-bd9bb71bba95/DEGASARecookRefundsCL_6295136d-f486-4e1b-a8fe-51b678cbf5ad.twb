      <column caption='Penalización' datatype='real' name='[Calculation_980377387640524800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_797700113908940814]=&quot;Wendy&apos;s&quot; then [valor_redimido]*0.25&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;KFC&quot; then [valor_redimido]*0.25&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;China Wok&quot; then [valor_redimido]*0.25&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;McDonald&apos;s&quot; and [Calculation_797700113904107526]=&quot;Missing item&quot; then [valor_redimido]*1&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;McDonald&apos;s&quot; and [Calculation_797700113904107526]=&quot;Food quality&quot; then [valor_redimido]*0.5&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;McDonald&apos;s&quot; and [Calculation_797700113904107526]=&quot;Wrong order&quot; then [valor_redimido]*0.5&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;McDonald&apos;s&quot; and [Calculation_797700113904107526]=&quot;Wrong item&quot; then [valor_redimido]*0.5&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;Buffalo Waffles&quot; then [valor_redimido]*1&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;Pizza Hut&quot; then [valor_redimido]*1&#13;&#10;ELSEIF [Calculation_797700113908940814]=&quot;Telepizza&quot; then [valor_redimido]*1&#13;&#10;END' />
      </column>
