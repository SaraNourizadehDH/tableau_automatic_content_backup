          <filter class='categorical' column='[federated.15dwjab05yt14u1b7rct50kehm26].[none:motivo:nk]'>
            <groupfilter from='&quot;Food quality&quot;' function='range' level='[none:motivo:nk]' to='&quot;Wrong order&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
