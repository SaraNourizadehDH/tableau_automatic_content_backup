            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:tools_description:nk]' member='&quot;No es posible contactar al cliente&quot;' />
              <groupfilter function='member' level='[none:tools_description:nk]' member='&quot;Repartidor incontactable&quot;' />
