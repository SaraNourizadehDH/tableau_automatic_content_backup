      <column caption='Business Name' datatype='string' name='[Calculation_797700113908682764]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[negocio_tipo]' />
      </column>
      <column caption='Empresa Nombre' datatype='string' name='[Calculation_797700113908838413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[razon_social]' />
      </column>
      <column caption='Franquicia' datatype='string' name='[Calculation_797700113908940814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[franquicia]' />
      </column>
      <column caption='Date up to' datatype='date' name='[Calculation_797700114200428559]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([Calculation_114278870395789316])' />
