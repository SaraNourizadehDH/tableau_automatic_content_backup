              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='User Request' caption='Dimension Country' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;user_request&quot;'>
              <calculation class='tableau' formula='&quot;user_request&quot;' />
              <aliases>
