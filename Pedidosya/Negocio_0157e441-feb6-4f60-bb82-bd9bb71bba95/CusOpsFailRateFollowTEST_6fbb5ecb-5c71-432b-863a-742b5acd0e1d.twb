      <column caption='User FR Segm' datatype='string' name='[Calculation_1304073615306776578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status] = &quot;REJECTED&quot; &#13;&#10;    AND [accionador_level1] = &quot;USER&quot;  &#13;&#10;    AND [accionador_level2] = &quot;USER SELF MANAGED&quot; &#13;&#10;    AND [cancel_tool] = &quot;OM_AUTOCANCELLATION&quot;&#13;&#10;THEN &apos;OTP FR&apos; &#13;&#10;ELSEIF [order_status] = &quot;REJECTED&quot; &#13;&#10;    AND [accionador_level1] = &quot;USER&quot;  &#13;&#10;    AND [accionador_level2] = &quot;CUSTOMER SERVICE&quot;&#13;&#10;THEN &apos;CS FR&apos; &#13;&#10;ELSEIF [order_status] = &quot;REJECTED&quot; &#13;&#10;    AND [accionador_level1] = &quot;USER&quot;  &#13;&#10;    AND [accionador_level2] = &quot;USER SELF MANAGED&quot; &#13;&#10;    AND [cancel_tool] != &quot;OM_AUTOCANCELLATION&quot;&#13;&#10;    THEN &apos;HC FR&apos; &#13;&#10;END' />
      </column>
      <column caption='Segmentation_FR' datatype='string' name='[Calculation_1304073615308832772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 2] = &apos;fr_owner&apos;) THEN&#13;&#10;      [fr_owner]&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 2] = &apos;user_request&apos;) THEN&#13;&#10;    [Calculation_1304073615306776578]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='FailRate_context_param' datatype='real' name='[Calculation_1304073615310057478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 3] = &apos;total_orders&apos;) THEN&#13;&#10;     [Calculation_711287309380907009] &#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 3] = &apos;country_level&apos;) THEN&#13;&#10;     [Calculation_704250438512341009]&#13;&#10;END' />
      </column>
      <column caption='Dimension FR' datatype='string' name='[Calculation_1304073615635263495]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 4] = &apos;pdt_state&apos;) THEN&#13;&#10;     [rejected_pdt_state] &#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 4] = &apos;cancellation_type&apos;) THEN&#13;&#10;     [customer_cancellation_type]&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 4] = &apos;cancel_tool&apos;) THEN&#13;&#10;     [cancel_tool]&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 4] = &apos;created_to_reject&apos;) THEN&#13;&#10;     [created_to_reject_bk]&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 4] = &apos;customer_facing&apos;) THEN&#13;&#10;     [cancel_moment_customer_facing]&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 4] = &apos;customer_issue&apos;) THEN  // ← Aquí faltaba cerrar el paréntesis&#13;&#10;IF NOT ISNULL([customer_issue]) &#13;&#10;AND [customer_issue] &lt;&gt; &quot;NULL&quot; &#13;&#10;THEN [customer_issue] &#13;&#10;ELSE NULL&#13;&#10;END&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Git' datatype='string' name='[Calculation_1304073615653011464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='icon' datatype='string' name='[Calculation_1304073615654764553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='User FR' datatype='real' name='[Calculation_704250437434269697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; AND [fr_owner] = &quot;User&quot; THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='Failed Orders' datatype='integer' name='[Calculation_704250437434376194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; THEN [total_orders] ELSE 0 END)' />
      </column>
      <column caption='HC FR' datatype='real' name='[Calculation_704250437449412613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; &#13;&#10;AND accionador_level2 = &quot;USER SELF MANAGED&quot; &#13;&#10;AND cancel_tool IN (&quot;HC_DEEPLINK_AUTOCANCELLATION&quot;, &quot;HC_AUTOCANCELLATION&quot;) THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='CS FR' datatype='real' name='[Calculation_704250437454716935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; &#13;&#10;AND [accionador_level2] = &quot;CUSTOMER SERVICE&quot; &#13;&#10;THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='OTP FR' datatype='real' name='[Calculation_704250437454995465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; &#13;&#10;AND [accionador_level2] = &quot;USER SELF MANAGED&quot; &#13;&#10;AND [cancel_tool] IN (&quot;OM_AUTOCANCELLATION&quot;) THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='User Requested FR' datatype='real' name='[Calculation_704250437455532043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; &#13;&#10;AND [accionador_level1] = &quot;USER&quot; &#13;&#10;THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='VFR' datatype='real' name='[Calculation_704250437473816588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; AND [fr_owner] = &quot;Restaurant&quot; THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='Rider FR' datatype='real' name='[Calculation_704250437474103309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; AND [fr_owner] = &quot;Rider&quot; THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='Peya FR' datatype='real' name='[Calculation_704250437474238479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; AND [fr_owner] = &quot;PedidosYa&quot; THEN [total_orders] END)&#13;&#10;/&#13;&#10; AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='Fail_rate_context' datatype='real' name='[Calculation_704250438512341009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; THEN [total_orders] END)&#13;&#10;/ SUM([total_orders])' />
      </column>
      <column caption='Gral FR%' datatype='real' name='[Calculation_711287309380030464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Calculation_711287309412515845]) / AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_711287309380907009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; THEN [total_orders] END) &#13;&#10;/ AVG([Calculation_711287309385572354])' />
      </column>
      <column caption='total_order_fixed' datatype='integer' name='[Calculation_711287309385572354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Monthly&apos; THEN&#13;&#10;    { FIXED DATETRUNC(&apos;month&apos;, [order_date]): SUM([total_orders]) }&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Weekly&apos; THEN&#13;&#10;    { FIXED DATETRUNC(&apos;week&apos;, [order_date]): SUM([total_orders]) }&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Daily&apos; THEN&#13;&#10;    { FIXED [order_date]: SUM([total_orders]) }&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Granularity Date' datatype='date' datatype-customized='true' name='[Calculation_711287309409095683]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;      DATE(MAKEDATE(DATEPART(&apos;year&apos;, [order_date]), DATEPART(&apos;month&apos;, [order_date]), 1))&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    DATE(DATETRUNC(&apos;week&apos;, [order_date]))&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;  DATE([order_date])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Total Failed Orders' datatype='integer' name='[Calculation_711287309412515845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Monthly&apos; THEN&#13;&#10;    { FIXED DATETRUNC(&apos;month&apos;, [order_date]) : SUM(IF [order_status] = &quot;REJECTED&quot; THEN total_orders ELSE 0 END) }&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Weekly&apos; THEN&#13;&#10;    { FIXED DATETRUNC(&apos;week&apos;, [order_date]) : SUM(IF [order_status] = &quot;REJECTED&quot; THEN total_orders ELSE 0 END) }&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Daily&apos; THEN&#13;&#10;    { FIXED [order_date] : SUM(IF [order_status] = &quot;REJECTED&quot; THEN total_orders ELSE 0 END) }&#13;&#10;END' />
      </column>
