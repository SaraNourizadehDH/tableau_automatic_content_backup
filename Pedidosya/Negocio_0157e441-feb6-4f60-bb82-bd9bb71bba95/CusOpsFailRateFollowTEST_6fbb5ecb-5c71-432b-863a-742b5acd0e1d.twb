          <datasource-dependencies datasource='federated.080zuiw1wi1zy6160qll712sj971'>
            <column caption='FailRate_context_param' datatype='real' name='[Calculation_1304073615310057478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 3] = &apos;total_orders&apos;) THEN&#13;&#10;     [Calculation_711287309380907009] &#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 3] = &apos;country_level&apos;) THEN&#13;&#10;     [Calculation_704250438512341009]&#13;&#10;END' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_704250437434376194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='Fail_rate_context' datatype='real' name='[Calculation_704250438512341009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; THEN [total_orders] END)&#13;&#10;/ SUM([total_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_711287309380907009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status] = &quot;REJECTED&quot; THEN [total_orders] END) &#13;&#10;/ AVG([Calculation_711287309385572354])' />
            </column>
            <column caption='total_order_fixed' datatype='integer' name='[Calculation_711287309385572354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Monthly&apos; THEN&#13;&#10;    { FIXED DATETRUNC(&apos;month&apos;, [order_date]): SUM([total_orders]) }&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Weekly&apos; THEN&#13;&#10;    { FIXED DATETRUNC(&apos;week&apos;, [order_date]): SUM([total_orders]) }&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Daily&apos; THEN&#13;&#10;    { FIXED [order_date]: SUM([total_orders]) }&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Granularity Date' datatype='date' datatype-customized='true' name='[Calculation_711287309409095683]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;      DATE(MAKEDATE(DATEPART(&apos;year&apos;, [order_date]), DATEPART(&apos;month&apos;, [order_date]), 1))&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    DATE(DATETRUNC(&apos;week&apos;, [order_date]))&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;  DATE([order_date])&#13;&#10;&#13;&#10;END' />
            </column>
