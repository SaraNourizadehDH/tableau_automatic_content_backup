            <column caption='Cancel Tool' datatype='string' name='[cancel_tool]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created To Reject Bk' datatype='string' name='[created_to_reject_bk]' role='dimension' type='nominal' />
