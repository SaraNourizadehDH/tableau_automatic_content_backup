            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Date' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Total Orders' caption='Country Context' datatype='string' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;total_orders&quot;'>
              <calculation class='tableau' formula='&quot;total_orders&quot;' />
              <aliases>
                <alias key='&quot;country_level&quot;' value='Country Level' />
                <alias key='&quot;total_orders&quot;' value='Total Orders' />
