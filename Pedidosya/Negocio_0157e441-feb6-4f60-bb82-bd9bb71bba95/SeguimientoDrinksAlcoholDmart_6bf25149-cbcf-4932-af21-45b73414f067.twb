      <column caption='Loss Shop details - Add cart' datatype='real' name='[Calculation_1247215650354012160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([sessions])-sum([sessions_add_cart]))/sum([sessions])' />
      </column>
      <column caption='Loss Add Cart-Checkout' datatype='real' name='[Calculation_1247215650366775297]' role='measure' type='quantitative'>
