          <datasource-dependencies datasource='federated.0z1lba70ry9asj1a6wa9z0crjomr'>
            <column caption='Item Rol' datatype='string' name='[Calculation_126100791995473921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [item_rol] IN (&apos;long tail&apos;,&apos;long_tail&apos;) THEN &apos;Long Tail&apos;&#13;&#10;ELSEIF [item_rol] IN (&apos;kvi&apos;) THEN &apos;KVI&apos;&#13;&#10;ELSEIF [item_rol] IN (&apos;mass&apos;) THEN &apos;Mass&apos;&#13;&#10;END' />
            </column>
            <column caption='POS Item/Category' datatype='real' name='[Calculation_126100792031932432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_126100791995473921] = &apos;KVI&apos; AND [cat_rol] = &apos;Traffic&apos;&#13;&#10;THEN [Parameters].[Parámetro 2]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;KVI&apos; AND [cat_rol] = &apos;Core&apos;&#13;&#10;THEN [Parameters].[Traffic/KVI Simulado (copia)_126100792022691845]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;KVI&apos; AND [cat_rol] = &apos;Essentials&apos;&#13;&#10;THEN [Parameters].[Traffic/KVI Parametro (copia)_126100792022900742]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;KVI&apos; AND [cat_rol] = &apos;Add-on&apos;&#13;&#10;THEN [Parameters].[Traffic/KVI Parametro (copia)_126100792023019527]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Mass&apos; AND [cat_rol] = &apos;Traffic&apos;&#13;&#10;THEN [Parameters].[Add On/KVI Parametro (copia)_126100792023085064]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Mass&apos; AND [cat_rol] = &apos;Core&apos;&#13;&#10;THEN [Parameters].[Traffic/Mass Parametro (copia)_126100792023175177]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Mass&apos; AND [cat_rol] = &apos;Essentials&apos;&#13;&#10;THEN [Parameters].[Core/Mass Parametro (copia)_126100792023240714]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Mass&apos; AND [cat_rol] = &apos;Add-on&apos;&#13;&#10;THEN [Parameters].[Essentials/Mass Parametro (copia)_126100792023298059]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Long Tail&apos; AND [cat_rol] = &apos;Traffic&apos;&#13;&#10;THEN [Parameters].[Traffic/Mass Parametro (copia)_126100792023396364]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Long Tail&apos; AND [cat_rol] = &apos;Core&apos;&#13;&#10;THEN [Parameters].[Traffic/Long Tail Parametro (copia)_126100792023449613]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Long Tail&apos; AND [cat_rol] = &apos;Essentials&apos;&#13;&#10;THEN [Parameters].[Core/Long Tail Parametro (copia)_126100792023498766]/100&#13;&#10;ELSEIF [Calculation_126100791995473921] = &apos;Long Tail&apos; AND [cat_rol] = &apos;Add-on&apos;&#13;&#10;THEN [Parameters].[Essentials/Long Tail Parametro (copia)_126100792023560207]/100&#13;&#10;END' />
            </column>
            <column caption='POS Target' datatype='real' name='[POS Simulado Detalle (copia)_126100792034390034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([competitor_base_price_lc]*[units_sold]*[Calculation_126100792031932432])/SUM(IF [Calculation_126100792031932432]&gt;0 THEN [competitor_base_price_lc]*[units_sold] END)' />
            </column>
