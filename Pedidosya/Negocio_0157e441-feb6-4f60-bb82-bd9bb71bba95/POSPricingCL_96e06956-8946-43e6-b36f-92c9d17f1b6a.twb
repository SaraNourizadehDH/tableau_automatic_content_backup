            <connection CATALOG='peya-chile' EXECCATALOG='peya-chile' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-chile' schema='user_sebastian_allende' server-oauth='' username='sebastian.allende@pedidosya.com' workgroup-auth-mode='prompt' />
