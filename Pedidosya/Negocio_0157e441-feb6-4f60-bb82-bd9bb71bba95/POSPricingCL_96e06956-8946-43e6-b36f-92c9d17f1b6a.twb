            <column caption='Item Rol' datatype='string' name='[Calculation_126100791995473921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [item_rol] IN (&apos;long tail&apos;,&apos;long_tail&apos;) THEN &apos;Long Tail&apos;&#13;&#10;ELSEIF [item_rol] IN (&apos;kvi&apos;) THEN &apos;KVI&apos;&#13;&#10;ELSEIF [item_rol] IN (&apos;mass&apos;) THEN &apos;Mass&apos;&#13;&#10;END' />
