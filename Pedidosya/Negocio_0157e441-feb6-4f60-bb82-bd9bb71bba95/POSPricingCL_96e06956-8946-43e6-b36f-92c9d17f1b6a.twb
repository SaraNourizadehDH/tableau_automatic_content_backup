        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1us0lo302gi6eu10pk92h1xgt0nw' name='Consulta SQL personalizada' type='text'><![CDATA[with supplier as (
select distinct
s1.sku
from `peya-delivery-and-support.automated_tables_reports.reple_flag_supplier_portal` as s1
left join `peya-delivery-and-support.automated_tables_reports.reple_flag_supplier_portal` as s2 
on s1.sku=s2.sku 
and s1.dc_warehouse_id = s2.warehouse_id
where s1.country_code='cl'
and left(case when s2.status_final="No activo" then "No activo" else s1.status_final end,6)  = 'Activo'
group by all
order by 1
)

,inventory as ( --listed_sku al cierre de semana. Se considera cuando is_stale = false ->> El sku-tienda ha tenido stock en los últimos 30 días
select distinct
sku_id
,avg(case when stock_end_of_day-sales_buffer>>0 then 1 else 0 end) as instock
from `peya-datamarts-pro.dm_dmarts.dmarts_inventory` as i
where country_code = 'cl'
and date_local >>= current_date-91
and is_stale_day=false
and store_name not like '%CD%'
and store_name not in ('CH_19_Macul','CH_25_Bellavista')
and sku_id is not null
group by all
order by sku_id
)

,max_scraped_date as (
select 
competitor_product_id
,max(scraped_at) as max_fecha 
from `fulfillment-dwh-production.curated_data_shared_dmart.competitors_products` 
where country_code = 'cl'
and competitor_name = 'JUMBO' 
group by all
)

,competitor_info as (
select distinct
c.competitor_product_id
,c.url
from `fulfillment-dwh-production.curated_data_shared_dmart.competitors_products` c

inner join max_scraped_date as m
on c.competitor_product_id = m.competitor_product_id 
and c.scraped_at = m.max_fecha 

where country_code = 'cl'
and competitor_name = 'JUMBO'
order by 1
)

,competitor_match as (
select 
m.dmart_sku
,m.dmart_product_name
,m.competitor_product_id
,m.competitor_product_name
,m.dmart_base_price_lc
,m.competitor_base_price_lc
,m.dmart_image_url
,m.competitor_image_url
,c.url as competitor_url
,m.last_scraped_date
from `fulfillment-dwh-production.curated_data_shared_dmart.competitors_products_matched` as m
left join competitor_info as c
on m.competitor_product_id = c.competitor_product_id
where m.country_code = 'cl'
and m.competitor_name = 'JUMBO'
order by dmart_sku
)

,catalog as (
select
sku
,product_name as title
,master_category_names.level_one as level_1
,master_category_names.level_two as level_2
,master_category_names.level_three as level_3
,case when max(catalog_original_price_lc) is null then max(catalog_price_lc)else max(catalog_original_price_lc) end as catalog_price_lc
from `peya-bi-tools-pro.il_qcommerce.dim_vendor_product`
where country_code='cl'
and is_dmart
and master_category_names.level_one is not null
and warehouse_name not in ('CH_42_CD_LaReina','CH_2_Oficina')
group by all
order by sku
)

,venta as (
select 
sku_id
,ean
,product_name
,manager
,grupo
,seccion
,categoria
,proveedor_generico
,marca_generica
,level_1
,level_2
,level_3
,item_rol
,c.cat_rol
,sum(total_amount_wo_vat)total_amount_wo_vat
,sum(total_discount_wo_vat) as total_discount_wo_vat
,sum(total_cogs_wo_vat) as total_cogs_wo_vat
,sum(units_sold) as units_sold
from `peya-chile.user_camilo_zelada.ventas_dmart_cl` as v
left join `peya-chile.user_sebastian_allende.maestra_cat_rol_regional_vista` as c
on v.level_2 = c.category
and v.level_3 = c.subcategory
where order_date >>= current_date-91
and item_rol <<>> 'no_aplica'
group by all
)

select --5.676
v.*
,c.catalog_price_lc
,p.* except(dmart_sku)
,case when s.sku is not null then true else false end as active_supplier

from venta as v

left join competitor_match as p
on v.sku_id = p.dmart_sku

left join supplier as s
on v.sku_id = s.sku

left join catalog as c
on v.sku_id = c.sku]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
