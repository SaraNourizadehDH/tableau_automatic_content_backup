        <calculation class='tableau' formula='if  [zone_id]= 49 or [zone_id]=56 or [zone_id]=61 or [zone_id] =55 or [zone_id]=50 then &quot;Bucket 1&quot;&#13;&#10;elseif zone_id =57 or [zone_id]=73 or [zone_id]=59 or [zone_id]= 99 or [zone_id]= 75  or [zone_id] = 60 or [zone_id]=98 or [zone_id]=52 then &quot;Bucket 2&quot;&#13;&#10;elseif [zone_id] = 82 or [zone_id]= 101 or zone_id = 54 or zone_id = 83 or zone_id = 77 or zone_id= 53 or zone_id= 90 or zone_id= 71 or zone_id= 91 or zone_id= 63 or zone_id= 69 or zone_id= 68 or zone_id= 100 then &quot;Bucket 3&quot;&#13;&#10;elseif [zone_id] = 72 or zone_id=74 or zone_id=79 or zone_id=76 or zone_id=64 or zone_id=58 then &quot;Bucket 4&quot;&#13;&#10;elseif [zone_id] = 85 or zone_id=103 or zone_id=102 or zone_id=104 or zone_id=87 or zone_id=89 or zone_id=7 or zone_id=70 or zone_id=92 or zone_id=88 or zone_id=81  then &quot;Bucket 5&quot; &#13;&#10;elseif [zone_id] = 78 or zone_id=84 or zone_id=80 or zone_id=65 or zone_id=86 then &quot;Bucket 6&quot;&#13;&#10;&#13;&#10;END' />
