    <worksheet name='KPIs TOD DOW (dist)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold'>KPIs TOD DOW Distr:</run>
            <run fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='11'><![CDATA[ <[federated.0wgtvv01lzrqs416uce9q18yu6cg].[none:test_name_2:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Unit Economics' name='federated.0wgtvv01lzrqs416uce9q18yu6cg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Unit Ec' datatype='string' name='[Custom_SQL_Query Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Delivery Fee&quot;'>
              <calculation class='tableau' formula='&quot;Avg Delivery Fee&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wgtvv01lzrqs416uce9q18yu6cg'>
            <column caption='Avg GFV Gross' datatype='real' name='[Avg Commission Rev (copy)_1341228265941045251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum ([gfv_gross]) / SUM([orders])' />
            </column>
            <column caption='Avg Commission Rev' datatype='real' name='[Avg DF (copy)_1341228265940869121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue])/SUM([orders])' />
            </column>
            <column caption='Avg DF (revenue)' datatype='real' name='[Avg DF (copy)_919860228709363745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [delivery_fee_revenue] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Avg SF (rev)' datatype='real' name='[Avg Extra cost by Service Fee (copia)_990510448794157077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_990510448794075156]/sum([orders])' />
            </column>
            <column caption='UserCost/AFV' datatype='real' default-format='p0%' name='[Calculation_1099159798277185536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1341228265940520960]+AVG([service_fee_med]))/[Calculation_990510448672632836]' />
            </column>
            <column caption='Avg DF' datatype='real' name='[Calculation_1341228265940520960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [shipping_no_discount] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Take In' datatype='real' name='[Calculation_1341228265940971522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg DF (copy)_919860228709363745] + [Avg DF (copy)_1341228265940869121] + [Avg Extra cost by Service Fee (copia)_990510448794157077]' />
            </column>
            <column caption='CM1' datatype='real' name='[Calculation_1341228265943916551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1341228265940971522]-[Calculation_1374160837904723968]' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1374160837904723968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [sum_cpo] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Total CM1' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_919860226087432193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1341228265943916551])*sum([orders])' />
            </column>
            <column caption='Rider Distance (Dropoff)' datatype='real' default-format='N' name='[Calculation_919860226166861827]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [delivery_distance_m] else 0 end)/SUM( if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='To Customer Time' datatype='real' name='[Calculation_919860226168365060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [to_customer_time] else 0 END)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='KPI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_919860226168766469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Custom_SQL_Query Parameter] = &quot;Orders&quot; THEN SUM(if [with_logistics] then [orders] else 0 end)&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Avg Delivery Fee&quot; THEN [Calculation_1341228265940520960]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Avg Food Value&quot; THEN [Avg Commission Rev (copy)_1341228265941045251]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Contrib. Margin&quot; THEN [Calculation_1341228265943916551]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Dropoff Distance&quot; THEN [Calculation_919860226166861827]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;To Customer Time&quot; THEN [Calculation_919860226168365060]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;CPO&quot; THEN [Calculation_1374160837904723968]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;DF/AFV&quot; THEN [Calculation_1099159798277185536]*100&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Surge Fee&quot; THEN avg([surge_fee_med])&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Service Fee&quot; THEN [Calculation_990510448704827400]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;User Cost&quot; THEN [Calculation_990510448713809932]&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Avg DF Rev&quot; THEN [Avg DF (copy)_919860228709363745]&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Total DF Rev&quot; THEN sum([delivery_fee_revenue])&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Unit CM1&quot; THEN [Calculation_1341228265943916551]&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Total CM1&quot; THEN [Calculation_919860226087432193]&#13;&#10;end' />
            </column>
            <column caption='AFV Condition' datatype='real' name='[Calculation_990510448669372419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(IF [vertical_type] =  &quot;darkstores&quot; THEN [gfv_dmarts]/[orders] else [gfv]/[orders] end )' />
            </column>
            <column caption='AFV General' datatype='real' name='[Calculation_990510448672632836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_990510448669372419]/sum([orders])' />
