      <column caption='Hour of day (VE)' datatype='string' name='[Hour of day (UY) (copia)_514817800107839489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850]) &gt;= 8 &#13;&#10;and DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850])&lt; 12 then  &quot;Breakfast&quot;&#13;&#10;elseif DATEPART(&quot;hour&quot;, [order_date (copy)_919860226849144850])&gt;= 12 and &#13;&#10;DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850])&lt;15 then &quot;Lunch&quot;&#13;&#10;elseif DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850])&gt;=15 and &#13;&#10;datepart(&quot;hour&quot;,[order_date (copy)_919860226849144850])&lt;18 then &quot;Afternoon&quot;&#13;&#10;else &quot;Night&quot;&#13;&#10;end' />
