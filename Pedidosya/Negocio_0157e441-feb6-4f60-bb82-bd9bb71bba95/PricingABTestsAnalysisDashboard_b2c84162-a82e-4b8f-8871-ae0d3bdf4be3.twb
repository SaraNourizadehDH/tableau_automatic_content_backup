            </column>
            <column caption='AFV Condition' datatype='real' name='[Calculation_990510448669372419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(IF [vertical_type] =  &quot;darkstores&quot; THEN [gfv_dmarts]/[orders] else [gfv]/[orders] end )' />
