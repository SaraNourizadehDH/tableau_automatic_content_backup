        <calculation class='tableau' formula='{EXCLUDE [variant]: SUM(if [variant]=&quot;Variation2&quot; and [with_logistics] then  [orders] else null end)&#13;&#10;                        }&#13;&#10;&#13;&#10;/ &#13;&#10;&#13;&#10;{EXCLUDE [variant]: SUM(if [variant]=&quot;Control&quot; and [with_logistics] then  [orders] else null end)&#13;&#10;                       }&#13;&#10;&#13;&#10;- 1' />
      </column>
      <column caption='Dropoff distance Buckets' datatype='string' name='[Calculation_3023885739012055044]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_919860226166861827]&gt;=4000 then &quot;&gt;= 4km&quot;&#13;&#10;elseif [Calculation_919860226166861827]&gt;=3500 then &quot;&gt;= 3.5km&quot;&#13;&#10;elseif [Calculation_919860226166861827] &gt;= 3000 then &quot;&gt;= 3km&quot;&#13;&#10;elseif [Calculation_919860226166861827] &gt;= 2500 then &quot;&gt;= 2.5km&quot;&#13;&#10;elseif [Calculation_919860226166861827] &gt;= 2000 then &quot;&gt;= 2km&quot;&#13;&#10;elseif [Calculation_919860226166861827] &gt;= 1500 then &quot;&gt;= 1.5km&quot;&#13;&#10;elseif [Calculation_919860226166861827] &gt;= 1000 then &quot;&gt;= 1km&quot;&#13;&#10;elseif [Calculation_919860226166861827] &gt;= 500 then &quot;&gt;= 0.5km&quot;&#13;&#10;else &quot;&gt;= 0km&quot;&#13;&#10;end' />
      </column>
      <column caption='Surged Orders' datatype='integer' name='[Calculation_502432837317468163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum (if  [surge_local_fee]&gt;0 then orders else null end)' />
      </column>
      <column caption='Weekday' datatype='integer' name='[Calculation_5902248795991126017]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [order_date])' />
      </column>
      <column caption='Week type' datatype='string' name='[Calculation_5902248795991306242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_5902248795991126017] = 1 or [Calculation_5902248795991126017] = 6 or [Calculation_5902248795991126017] = 7 then &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot; END' />
      </column>
      <column caption='Avg Tip Amount' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_631911378877890564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_tip_amount])/SUM([has_tip])' />
      </column>
      <column caption='Orders by Acquisition' datatype='real' name='[Calculation_674695544674607105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_acquisitions])/sum([orders])' />
      </column>
      <column caption='AFV Gross' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_674695544678449154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_gross])/sum([orders])' />
      </column>
      <column caption='AFV Dmarts' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_674695544689606659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_dmarts])/sum([orders])' />
      </column>
      <column caption='Hour' datatype='string' name='[Calculation_694961759649116162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ( &#13;&#10;DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &gt;= 7&#13;&#10;//if the hour number is after or on 7&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 0 &#13;&#10;OR  DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &lt;= 10 &#13;&#10;//and the hour number is before 10&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 59 &#13;&#10;)&#13;&#10;THEN &quot;Desayuno&quot;&#13;&#10;&#13;&#10;ELSEIF( DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &gt;= 11&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 0 &#13;&#10;OR ( DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &lt;= 14 &#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 59 ))&#13;&#10;THEN &quot;Almuerzo&quot;&#13;&#10;ELSEIF (DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &gt;= 15&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 0&#13;&#10;OR ( DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &lt;=17 &#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 59 ))&#13;&#10;THEN &quot;Media Tarde&quot;&#13;&#10;ELSEIF (DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &gt;= 18&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 0 &#13;&#10;OR ( DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &lt;=21&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 59 ))&#13;&#10;THEN &quot;Cena&quot;&#13;&#10;ELSEIF (DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &gt;= 22&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 0&#13;&#10;OR ( DATEPART(&apos;hour&apos;, [order_date (copy)_919860226849144850]) &lt;=23&#13;&#10;AND DATEPART(&apos;minute&apos;, [order_date (copy)_919860226849144850]) = 59 ))&#13;&#10;THEN &quot;Late Night&quot;&#13;&#10;END' />
      </column>
      <column caption='Hour of day' datatype='string' name='[Calculation_694961759649357827]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850]) &gt;= 7 &#13;&#10;and DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850])&lt; 11 then  &quot;Desayuno&quot;&#13;&#10;elseif datepart(&quot;hour&quot;,[order_date (copy)_919860226849144850])&gt;=11 and &#13;&#10;datepart(&quot;hour&quot;,[order_date (copy)_919860226849144850])&lt;15 then &quot;Almuerzo&quot;&#13;&#10;elseif datepart(&quot;hour&quot;,[order_date (copy)_919860226849144850])&gt;=15 &#13;&#10;and datepart(&quot;hour&quot;,[order_date (copy)_919860226849144850])&lt;18 then &quot;Media tarde&quot;&#13;&#10;elseif datepart(&quot;hour&quot;,[order_date (copy)_919860226849144850])&gt;=18 and&#13;&#10;datepart(&quot;hour&quot;,[order_date (copy)_919860226849144850]) &lt;22 then &quot;Cena&quot;&#13;&#10;else &quot;Late Night&quot;&#13;&#10;end' />
      </column>
      <column caption='AFV Baseline' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846113787825725440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [gfv] END) / SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='Total Orders Baseline' datatype='integer' name='[Calculation_846113787826454529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='Avg Comission Rev Baseline' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846113787826806786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [commission_revenue] END) / SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='Avg DF Baseline' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846113787827011587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [shipping_no_discount] END)  / SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='Avg Take In Baseline' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846113787828789252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [commission_revenue]+[delivery_fee_revenue] END) / SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='CPO Baseline' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846113787830362117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [sum_cpo] END) / SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='Unit. CM1  Baseline' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846113787831205895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [commission_revenue]+[delivery_fee_revenue]-[sum_cpo] END)/SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='Dropoff Distance Baseline' datatype='real' name='[Calculation_846113787832156168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [delivery_distance_m] END)   / SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END)' />
      </column>
      <column caption='Avg to Customer Time Baseline' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_846113787832516617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [to_customer_time] END) / SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END) / 60 / 24' />
      </column>
      <column caption='AFV (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787862781995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([AFV Baseline (cum) (copia)_846113787860017186]-[AFV Baseline (copia)_846113787852095512])/ABS([AFV Baseline (copia)_846113787852095512])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Comm Rev (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787863187501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Avg Comission Rev Baseline (cum) (copia)_846113787860017187]-[Avg Comission Rev Baseline (copia)_846113787852804121])/ABS([Avg Comission Rev Baseline (copia)_846113787852804121])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Df (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787868512302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Avg DF Baseline (cum) (copia)_846113787860017188]-[Avg DF Baseline (copia)_846113787855654938])/ABS([Avg DF Baseline (copia)_846113787855654938])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg to Customer Time (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787884347440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Avg to Customer Time Baseline (cum) (copia)_846113787860017190]-[Avg to Customer Time Baseline (copia)_846113787857244189])/ABS([Avg to Customer Time Baseline (copia)_846113787857244189])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CPO (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787884728369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CPO Baseline (cum) (copia)_846113787860017191]-[CPO Baseline (copia)_846113787857928222])/ABS([CPO Baseline (copia)_846113787857928222])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dropoff Distance (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787887099954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Dropoff Distance Baseline (cum) (copia)_846113787860017192]-[Dropoff Distance Baseline (copia)_846113787858059295])/ABS([Dropoff Distance Baseline (copia)_846113787858059295])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Orders (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787887341619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Total Orders Baseline (cum) (copia)_846113787860017193]-[Total Orders Baseline (copia)_846113787859632160])/ABS([Total Orders Baseline (copia)_846113787859632160])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Unit CM1 (Diff)' datatype='real' default-format='p0.00%' name='[Calculation_846113787888934964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Unit. CM1  Baseline (cum) (copia)_846113787860017194]-[Unit. CM1  Baseline (copia)_846113787859771425])/ABS([Unit. CM1  Baseline (copia)_846113787859771425])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total CM1' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_919860226087432193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1341228265943916551])*sum([orders])' />
      </column>
      <column caption='Rider Distance (Dropoff)' datatype='real' default-format='N' name='[Calculation_919860226166861827]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(if [with_logistics] then [delivery_distance_m] else 0 end)/SUM( if [with_logistics] then [orders] else 0 end)' />
      </column>
      <column caption='To Customer Time' datatype='real' name='[Calculation_919860226168365060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [with_logistics] then [to_customer_time] else 0 END)/SUM(if [with_logistics] then [orders] else 0 end)' />
      </column>
      <column caption='KPI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_919860226168766469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Custom_SQL_Query Parameter] = &quot;Orders&quot; THEN SUM(if [with_logistics] then [orders] else 0 end)&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Avg Delivery Fee&quot; THEN [Calculation_1341228265940520960]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Avg Food Value&quot; THEN [Avg Commission Rev (copy)_1341228265941045251]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Contrib. Margin&quot; THEN [Calculation_1341228265943916551]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Dropoff Distance&quot; THEN [Calculation_919860226166861827]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;To Customer Time&quot; THEN [Calculation_919860226168365060]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;CPO&quot; THEN [Calculation_1374160837904723968]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;DF/AFV&quot; THEN [Calculation_1099159798277185536]*100&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Surge Fee&quot; THEN avg([surge_fee_med])&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;Service Fee&quot; THEN [Calculation_990510448704827400]&#13;&#10;elseif [Parameters].[Custom_SQL_Query Parameter] = &quot;User Cost&quot; THEN [Calculation_990510448713809932]&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Avg DF Rev&quot; THEN [Avg DF (copy)_919860228709363745]&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Total DF Rev&quot; THEN sum([delivery_fee_revenue])&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Unit CM1&quot; THEN [Calculation_1341228265943916551]&#13;&#10;ELSEIF [Parameters].[Custom_SQL_Query Parameter]=&quot;Total CM1&quot; THEN [Calculation_919860226087432193]&#13;&#10;end' />
      </column>
      <column caption='Test days' datatype='integer' name='[Calculation_919860226464186374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,MIN([order_date]), MAX([order_date]))+1' />
      </column>
      <column caption='Avg DF %ΔVar1' datatype='real' default-format='p0.0%' name='[Calculation_919860226465660935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [variant]: SUM(if [variant]=&quot;Variation1&quot; and [with_logistics] then  [shipping_no_discount] else null end)&#13;&#10;                        / SUM(if [variant]=&quot;Variation1&quot; and [with_logistics] then  [orders] else null end)}&#13;&#10;&#13;&#10;/ &#13;&#10;&#13;&#10;{EXCLUDE [variant]: SUM(if [variant]=&quot;Control&quot; and [with_logistics] then  [shipping_no_discount] else null end)&#13;&#10;                        / SUM(if [variant]=&quot;Control&quot; and [with_logistics] then  [orders] else null end)}&#13;&#10;&#13;&#10;- 1' />
      </column>
      <column caption='AFV Condition' datatype='real' name='[Calculation_990510448669372419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum(IF [vertical_type] =  &quot;darkstores&quot; THEN [gfv_dmarts]/[orders] else [gfv]/[orders] end )' />
      </column>
      <column caption='AFV General' datatype='real' name='[Calculation_990510448672632836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_990510448669372419]/sum([orders])' />
      </column>
      <column caption='Service Fee' datatype='real' name='[Calculation_990510448703758343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([service_fee_med])' />
      </column>
      <column caption='Avg Extra cost by Service Fee' datatype='real' name='[Calculation_990510448704827400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_990510448703758343]&gt;0 then&#13;&#10;[Calculation_990510448703758343]/[Surged Orders (copia)_990510448703197189]&#13;&#10;else 0 END' />
      </column>
      <column caption='Avg User Cost' datatype='real' name='[Calculation_990510448713809932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1341228265940520960]+ [Calculation_990510448704827400]' />
      </column>
      <column caption='Avg Service Fee' datatype='real' name='[Calculation_990510448751181840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Service Fee Local (copia)_990510448743030798])/sum([orders])' />
      </column>
      <column caption='Service Fee Revenue' datatype='real' name='[Calculation_990510448794075156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([service_fee_revenue])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_990510448795021334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_919860226087432193]+[Calculation_990510448794075156]' />
      </column>
      <column caption='Dropoff Dist %ΔVar2' datatype='real' default-format='p0.0%' name='[Dropoff Dist %ΔVar1 (copy)_919860229000052772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [variant]: SUM(if [variant]=&quot;Variation2&quot; and [with_logistics] then [delivery_distance_m] else null end)&#13;&#10;                        / SUM(if [variant]=&quot;Variation2&quot; and [with_logistics] then [orders] else null end)}&#13;&#10;&#13;&#10;/ &#13;&#10;&#13;&#10;{EXCLUDE [variant]: SUM(if [variant]=&quot;Control&quot; and [with_logistics] then [delivery_distance_m] else null end)&#13;&#10;                        / SUM(if [variant]=&quot;Control&quot; and [with_logistics] then [orders] else null end)}&#13;&#10;&#13;&#10;- 1' />
      </column>
      <column caption='Delivery Distance' datatype='real' name='[Dropoff Distance (copia)_674695544009117696]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(if [with_logistics] then [delivery_distance] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
      </column>
      <column caption='Dropoff Distance Variant' datatype='real' name='[Dropoff Distance Baseline (copia)_846113787850170389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [variant]=[Parameters].[Baseline (copia)_846113787836981261] THEN [delivery_distance_m] END)   / SUM(IF [variant]=[Parameters].[Baseline (copia)_846113787836981261] THEN [orders] END)' />
      </column>
      <column caption='Dropoff Distance Baseline (cum)' datatype='real' name='[Dropoff Distance Baseline (copia)_846113787858059295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [delivery_distance_m] END)) / RUNNING_SUM(SUM(IF [variant]=[Parameters].[Parámetro 1] THEN [orders] END))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dropoff Distance Variant (cum) ' datatype='real' name='[Dropoff Distance Baseline (cum) (copia)_846113787860017192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(IF [variant]=[Parameters].[Baseline (copia)_846113787836981261] THEN [delivery_distance_m] END)) / RUNNING_SUM(SUM(IF [variant]=[Parameters].[Baseline (copia)_846113787836981261] THEN [orders] END))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Extra  DF by Service Fee' datatype='real' name='[Extra  DF by Surge (copia)_990510448703332358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1341228265940520960] - (SUM(if [with_logistics] then [Calculation_990510448703758343] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end))' />
      </column>
      <column caption='Hour of day (EC)Low UTR' datatype='string' name='[Hour of day (EC)  (copia)_1046242501529960449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850]) &gt;= 6 &#13;&#10;and DATEPART(&quot;hour&quot;,[order_date (copy)_919860226849144850])&lt; 12 then  &quot;Breakfast&quot;&#13;&#10;else &quot;Normal DF&quot;&#13;&#10;end' />
