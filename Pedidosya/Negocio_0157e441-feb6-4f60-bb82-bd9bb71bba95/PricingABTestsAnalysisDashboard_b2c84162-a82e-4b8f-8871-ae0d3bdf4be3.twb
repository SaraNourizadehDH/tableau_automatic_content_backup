          <datasource-dependencies datasource='federated.0wgtvv01lzrqs416uce9q18yu6cg'>
            <column caption='Avg MOV' datatype='real' name='[Avg DF (copia)_224054097338490880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [mov] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Avg Base Fee DF' datatype='real' name='[Avg DF (copia)_502432837292908546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [base_fee_med] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Avg Commission Rev' datatype='real' name='[Avg DF (copy)_1341228265940869121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue])/SUM([orders])' />
            </column>
            <column caption='Avg DF (revenue)' datatype='real' name='[Avg DF (copy)_919860228709363745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [delivery_fee_revenue] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Avg SF (rev)' datatype='real' name='[Avg Extra cost by Service Fee (copia)_990510448794157077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_990510448794075156]/sum([orders])' />
            </column>
            <column caption='Avg GMV' datatype='real' name='[Avg GFV Gross (copy)_1341228265941123076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [gmv_local] else 0 end)/SUM(if [with_logistics] then [orders] else 0 END)' />
            </column>
            <column caption='UserCost/AFV' datatype='real' default-format='p0%' name='[Calculation_1099159798277185536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1341228265940520960]+AVG([service_fee_med]))/[Calculation_990510448672632836]' />
            </column>
            <column caption='Distinct Users' datatype='integer' name='[Calculation_1123366658657001473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([user_id])' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_1131247997418127362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])' />
            </column>
            <column caption='%Orders With Tip' datatype='real' name='[Calculation_1271704001650458624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([has_tip])/(sum([Calculation_1823394955974770690]))), 0)' />
            </column>
            <column caption='Distinct Users (Test Variant)' datatype='integer' name='[Calculation_1271704001658073091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ INCLUDE [variant]: [Calculation_1123366658657001473] }' />
            </column>
            <column caption='%Plus Users' datatype='real' name='[Calculation_1271704001658126340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((COUNTD(IF [is_user_plus] = 1 THEN [user_id] END )/(sum([Calculation_1271704001658073091]))), 0)' />
            </column>
            <column caption='Avg DF' datatype='real' name='[Calculation_1341228265940520960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [shipping_no_discount] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Take In' datatype='real' name='[Calculation_1341228265940971522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg DF (copy)_919860228709363745] + [Avg DF (copy)_1341228265940869121] + [Avg Extra cost by Service Fee (copia)_990510448794157077]' />
            </column>
            <column caption='CM1' datatype='real' name='[Calculation_1341228265943916551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1341228265940971522]-[Calculation_1374160837904723968]' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1374160837904723968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [sum_cpo] else 0 end)/SUM(if [with_logistics] then [orders] else 0 end)' />
            </column>
            <column caption='Orders (Test Variant)' datatype='integer' name='[Calculation_1823394955974770690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [variant], [scheme_id], [treatment]: SUM([orders]) }' />
            </column>
            <column caption='User Distance (Linear)' datatype='real' name='[Calculation_1927259234145337344]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(if [with_logistics] then [linear_distance] else 0 end)/SUM( if [with_logistics] then [orders] else 0 end)*1000' />
            </column>
            <column caption='Avg Tip Amount' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_631911378877890564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_tip_amount])/SUM([has_tip])' />
            </column>
            <column caption='Orders by Acquisition' datatype='real' name='[Calculation_674695544674607105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_acquisitions])/sum([orders])' />
            </column>
            <column caption='AFV Gross' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_674695544678449154]' role='measure' type='quantitative'>
