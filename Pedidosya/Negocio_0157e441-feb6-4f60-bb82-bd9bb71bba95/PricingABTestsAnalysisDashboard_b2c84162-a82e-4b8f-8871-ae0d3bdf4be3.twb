        <calculation class='tableau' formula='SUM(if [with_logistics] then [linear_distance] else 0 end)/SUM( if [with_logistics] then [orders] else 0 end)*1000' />
      </column>
      <column caption='user_variant' datatype='integer' name='[Calculation_301178276635697153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [user_id]: MAX(&#13;&#10;IF [Parameters].[Baseline (copia)_846113787836981261]= &apos;Control&apos; AND [Parameters].[Baseline (copia)_846113787836981261] != &apos;Variation1&apos; THEN 1&#13;&#10;ELSEIF [Parameters].[Baseline (copia)_846113787836981261]!= &apos;Control&apos; AND [Parameters].[Baseline (copia)_846113787836981261] = &apos;Variation1&apos; THEN 2&#13;&#10;ELSEIF [Parameters].[Baseline (copia)_846113787836981261] = &apos;Control&apos; AND [Parameters].[Baseline (copia)_846113787836981261] = &apos;Variation1&apos; THEN 3&#13;&#10;END)}' />
      </column>
      <column caption='Orders %ΔVar1' datatype='real' default-format='p0.00%' name='[Calculation_3023885738902392833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE  [variant]: SUM(if [variant]=&quot;Variation1&quot; and [with_logistics] then  [orders] else null end)&#13;&#10;                        }&#13;&#10;&#13;&#10;/ &#13;&#10;&#13;&#10;{EXCLUDE  [variant]: SUM(if [variant]=&quot;Control&quot;  and [with_logistics] then [orders] else null end)&#13;&#10;                       }&#13;&#10;&#13;&#10;- 1' />
      </column>
