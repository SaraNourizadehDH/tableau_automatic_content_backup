      </column>
      <column caption='OD Share' datatype='real' name='[Calculation_1341228265949110282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Calculation_1341228265948925961] = &quot;OD&quot; then [orders] else 0 end) / SUM([orders])' />
      </column>
