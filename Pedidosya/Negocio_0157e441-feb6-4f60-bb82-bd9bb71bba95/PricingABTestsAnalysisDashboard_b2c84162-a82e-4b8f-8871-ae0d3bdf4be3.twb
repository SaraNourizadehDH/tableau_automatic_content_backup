            <column caption='Total CM1' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_919860226087432193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1341228265943916551])*sum([orders])' />
            </column>
