              <calculation class='tableau' formula='if [dmartLSProductCountry] = 1 and [dmart_LS] = &quot;Dmart&quot;&#13;&#10;&#13;&#10;THEN [gtin]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='CountryProductsLS' datatype='string' name='[Calculation_694961717873864713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [dmartLSProductCountry] = 1 and [dmart_LS] = &quot;Local Shop&quot;&#13;&#10;&#13;&#10;THEN [gtin]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='CountryProductsLS+Dmarts' datatype='string' name='[Calculation_694961717874069514]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [dmartLSProductCountry] = 2 &#13;&#10;THEN [gtin]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='%ProductsDmartsCountry' datatype='real' default-format='p0.00%' name='[Calculation_694961717877821451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_694961717873172488]) / [Calculation_694961717878394892]' />
            </column>
            <column caption='CountryTotalProducts' datatype='integer' name='[Calculation_694961717878394892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_694961717873172488]) + COUNTD([Calculation_694961717873864713]) +&#13;&#10;COUNTD([Calculation_694961717874069514])' />
            </column>
            <column caption='%ProductsLSCountry' datatype='real' default-format='p0.00%' name='[Calculation_694961717881417743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_694961717873864713]) / [Calculation_694961717878394892]' />
            </column>
            <column caption='%ProductsDmartLSCountry' datatype='real' default-format='p0.00%' name='[Calculation_694961717881987088]' role='measure' type='quantitative'>
