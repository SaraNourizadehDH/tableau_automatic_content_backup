      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_5871026CE37049C492187D32AABB08DB'>
            <properties context=''>
              <relation connection='bigquery.0cxiny205ahyr41ge6zkl1wrf9u4' name='Consulta_SQL_personalizada' type='text'><![CDATA[SELECT 
supply.country,
supply.vertical, 
supply.businessCategory, 
supply.business_category_aggrupation,
supply.product, 
supply.gtin, 
supply.brand_name, 
supply.title, 
supply.minPrice as minMenuPrice, 
supply.maxPrice as maxMenuPrice, 
supply.avgPrice as avgMenuPrice,
supply.median as medianMenuPrice, 


CASE WHEN orders.gtin IS NOT NULL THEN 1 ELSE 0 END AS gtin_sold,

supply.dmartLSProductCountryCategory,
supply.dmartLSProductCountryVertical, 
supply.dmartLSProductLatam, 
supply.dmartLSProductCountry , 
supply.dmartLSProductCategory,
supply.dmart_LS, 
supply.partners, 

orders.avgPrice as ordersAvgPrice, 
orders.minPrice as ordersMinPrice , 
orders.maxPrice as ordersMaxPrice, 
orders.numberOfOrders, 
supply.productInGG, 
orders.productRanking, 
orders.countryProductRanking, 
orders.latamProductRanking,
orders.categoryCountryProductRanking,
IFNULL(numberOfOrders,0) as productOrders,  
max(orders.productRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) as lastValue,
max(orders.latamproductRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) as lastValueLatam,




/* PAÍS - CATEGORIA */
ROUND(orders.categoryCountryProductRanking / max(orders.categoryCountryProductRanking) OVER(partition BY orders.country, orders.business_category_aggrupation),4) as rankingCountryCategory, 

CASE WHEN orders.categoryCountryProductRanking / max(orders.categoryCountryProductRanking) OVER(partition BY orders.country, orders.business_category_aggrupation) <<= 0.20
     THEN "Top Seller Country Category" 

     WHEN orders.categoryCountryProductRanking / max(orders.categoryCountryProductRanking) OVER(partition BY orders.country, orders.business_category_aggrupation) >> 0.20
      AND  orders.categoryCountryProductRanking / max(orders.categoryCountryProductRanking) OVER(partition BY orders.country, orders.business_category_aggrupation) <<= 0.5 
     THEN "Mid 2 Seller Country Category" 

     WHEN orders.categoryCountryProductRanking / max(orders.categoryCountryProductRanking) OVER(partition BY orders.country, orders.business_category_aggrupation) >> 0.5
     
      AND orders.categoryCountryProductRanking / max(orders.categoryCountryProductRanking) OVER(partition BY orders.country, orders.business_category_aggrupation) <<= 1
     
     THEN "Long Tail Country Category"  
     ELSE "Non Seller"
     END AS isTopSellerCountryCategory,
    
/* CATEGORY */
ROUND(orders.categoryproductRanking / max(orders.categoryproductRanking) OVER(partition BY orders.business_category_aggrupation),4) as rankingBusinessCategory, 

CASE WHEN orders.categoryproductRanking / max(orders.categoryproductRanking) OVER(partition BY orders.business_category_aggrupation) <<= 0.20
     THEN "Top Seller Business Category" 

     WHEN orders.categoryproductRanking / max(orders.categoryproductRanking) OVER(partition BY orders.business_category_aggrupation) >> 0.20
      AND  orders.categoryproductRanking / max(orders.categoryproductRanking) OVER(partition BY orders.business_category_aggrupation) <<= 0.5 
     THEN "Mid 2 Seller Business Category" 

     WHEN orders.categoryproductRanking / max(orders.categoryproductRanking) OVER(partition BY orders.business_category_aggrupation) >> 0.5
     
      AND orders.categoryproductRanking / max(orders.categoryproductRanking) OVER(partition BY orders.business_category_aggrupation) <<= 1
     
     THEN "Long Tail Business Category"  
     ELSE "Non Seller"
     END AS isTopSellerBusinessCategory,
    

/* PAÍS - VERTICAL */
ROUND(orders.countryVerticalProductRanking / max(orders.countryVerticalProductRanking) OVER(partition BY orders.country, orders.vertical),4) as rankingCountryVertical, 

CASE WHEN orders.countryVerticalProductRanking / max(orders.countryVerticalProductRanking) OVER(partition BY orders.country, orders.vertical) <<= 0.20
     THEN "Top Seller Country Vertical" 

     WHEN orders.countryVerticalProductRanking / max(orders.countryVerticalProductRanking) OVER(partition BY orders.country, orders.vertical) >> 0.20
      AND  orders.countryVerticalProductRanking / max(orders.countryVerticalProductRanking) OVER(partition BY orders.country, orders.vertical) <<= 0.5 
     THEN "Mid 2 Seller Country Vertical" 

     WHEN orders.countryVerticalProductRanking / max(orders.countryVerticalProductRanking) OVER(partition BY orders.country, orders.vertical) >> 0.5
     
      AND orders.countryVerticalProductRanking / max(orders.countryVerticalProductRanking) OVER(partition BY orders.country, orders.vertical) <<= 1
     
     THEN "Long Tail Country Vertical"  
     ELSE "Non Seller"
     END AS isTopSellerCountryVertical,



/* PAÍS - VERTICAL - CATEGORÍA */
ROUND(orders.productRanking / max(orders.productRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory),4) as rankingCountryVerticalCategory, 

CASE WHEN orders.productRanking / max(orders.productRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) <<= 0.20
     THEN "Top Seller Country Vertical Category" 

     WHEN orders.productRanking / max(orders.productRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) >> 0.20
      AND  orders.productRanking / max(orders.productRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) <<= 0.5 
     THEN "Mid 2 Seller Country Vertical Category" 

     WHEN orders.productRanking / max(orders.productRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) >> 0.5
      AND orders.productRanking / max(orders.productRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) <<= 1
     THEN "Long Tail Country Vertical Category"  
     ELSE "Non Seller"
     END AS isTopSeller,

/* VERTICAL - CATEGORÍA */
 ROUND(orders.categoryProductRanking / max(orders.categoryProductRanking) OVER(partition BY orders.vertical, orders.business_category_aggrupation),4) as rankingVerticalCategory, 

 CASE WHEN orders.categoryProductRanking / max(orders.categoryProductRanking) OVER(partition BY orders.vertical, orders.business_category_aggrupation) <<= 0.20
      THEN "Top Seller Vertical Category" 

      WHEN orders.categoryProductRanking / max(orders.categoryProductRanking) OVER(partition BY orders.vertical, orders.business_category_aggrupation) >> 0.20
       AND  orders.categoryProductRanking / max(orders.categoryProductRanking) OVER(partition BY orders.vertical, orders.business_category_aggrupation) <<= 0.5 
      THEN "Mid 2 Seller Vertical Category" 

      WHEN orders.categoryProductRanking / max(orders.categoryProductRanking) OVER(partition BY orders.vertical, orders.business_category_aggrupation) >> 0.5
       AND orders.categoryProductRanking / max(orders.categoryProductRanking) OVER(partition BY orders.vertical, orders.business_category_aggrupation) <<= 1
      THEN "Long Tail Vertical Category"  
      ELSE "Non Seller"
      END AS isTopSellerVerticalCategory,

/* PAÍS */

ROUND(orders.countryProductRanking / max(orders.countryProductRanking) OVER(partition BY orders.country),4) as rankingCountry, 

CASE WHEN orders.countryProductRanking / max(orders.countryproductRanking) OVER(partition BY orders.country) <<= 0.20
     THEN "Top Seller Country" 

     WHEN orders.countryProductRanking / max(orders.countryProductRanking) OVER(partition BY orders.country) >> 0.20
      AND  orders.countryProductRanking / max(orders.countryProductRanking) OVER(partition BY orders.country) <<= 0.5 
     THEN "Mid 2 Seller Country" 

     WHEN orders.countryProductRanking / max(orders.countryProductRanking) OVER(partition BY orders.country) >> 0.5
      AND orders.countryProductRanking / max(orders.countryProductRanking) OVER(partition BY orders.country) <<= 1
     THEN "Long Tail Country"  
     ELSE "Non Seller"
     END AS isTopSellerCountry,

/* LATAM */
CASE WHEN orders.latamproductRanking / max(orders.latamproductRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory)  <<= 0.20
     THEN "Top Seller Latam" 

     WHEN orders.latamproductRanking / max(orders.latamproductRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) >> 0.20
      AND  orders.latamproductRanking / max(orders.latamproductRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) <<= 0.5 
     THEN "Mid 2 Seller Latam" 

     WHEN orders.latamproductRanking / max(orders.latamproductRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) >> 0.5
      AND orders.latamproductRanking / max(orders.latamproductRanking) OVER(partition BY orders.country, orders.vertical, orders.businessCategory) <<= 1
     THEN "Long Tail Latam"  
     ELSE "Non Seller"
     END AS isTopSellerLatam

FROM `peya-food-and-groceries.automated_tables_reports.supplyNV` as supply 
LEFT JOIN `peya-food-and-groceries.automated_tables_reports.ordersNV` as orders 
ON  supply.country = orders.country 
AND supply.vertical = orders.vertical 
AND supply.businessCategory = orders.businessCategory 
AND ltrim(supply.gtin,'0') = ltrim(orders.gtin, '0')
 AND NOT (starts_with(cast(supply.gtin as string) , "2") and LENGTH(CAST(supply.gtin AS STRING)) = 13)
 
ORDER BY country, vertical, businessCategory, productRanking DESC]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
