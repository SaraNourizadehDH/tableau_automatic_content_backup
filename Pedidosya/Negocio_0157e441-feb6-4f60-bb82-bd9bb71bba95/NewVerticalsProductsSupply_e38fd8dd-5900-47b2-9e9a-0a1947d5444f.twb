            </column>
            <column caption='CategoryProductLS+Dmart' datatype='string' name='[Calculation_1135751531754074116]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_619526430432030721] = &quot;Both&quot;&#13;&#10;&#13;&#10;then [gtin]&#13;&#10;END' />
            </column>
            <column caption='CategoryTotalProducts' datatype='integer' name='[Calculation_1135751531754442757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1135751531753222146])+COUNTD([Calculation_1135751531753422851])+COUNTD([Calculation_1135751531754074116])' />
