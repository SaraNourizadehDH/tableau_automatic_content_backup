            <column caption='CategoryProductDmarts' datatype='string' name='[Calculation_1135751531753222146]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_619526430432030721] = &quot;Dmart&quot;&#13;&#10;&#13;&#10;then [gtin]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='CategoryProductLS' datatype='string' name='[Calculation_1135751531753422851]' role='dimension' type='nominal'>
