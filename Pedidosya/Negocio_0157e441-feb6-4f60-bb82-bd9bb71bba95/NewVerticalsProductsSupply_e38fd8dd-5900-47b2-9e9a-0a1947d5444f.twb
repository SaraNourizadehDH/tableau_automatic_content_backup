            <run bold='true' fontsize='8'>% Products Not Solds</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta_SQL_personalizada (automated_tables_reports)' name='federated.18o22970ne116o1gpp1yd02xynhw' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.18o22970ne116o1gpp1yd02xynhw'>
            <column aggregation='Attribute' caption='#Gtins' datatype='integer' name='[Calculation_895934915002093570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE  [country]: COUNTD([gtin])}' />
            </column>
            <column caption='ProductsNotSolds' datatype='string' datatype-customized='true' name='[Calculation_895934915022209030]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [productOrders] = 0 then [gtin]&#13;&#10;END' />
            </column>
            <column caption='CountProductsNotSold' datatype='integer' name='[Calculation_895934915033276427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_895934915022209030])' />
            </column>
            <column caption='[CountProductsNotSold]/[#Gtins]' datatype='real' name='[Calculation_895934915063242775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_895934915033276427]/[Calculation_895934915002093570]' />
            </column>
            <column caption='Drinks' datatype='boolean' name='[Calculation_895934915125587996]' role='dimension' type='nominal'>
