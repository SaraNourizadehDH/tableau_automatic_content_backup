            <column caption='%ProductsDmartCategory' datatype='real' default-format='p0.00%' name='[Calculation_1135751531755376647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1135751531753222146]) / [Calculation_1135751531754442757]' />
            </column>
            <column caption='%ProductsLSCategory' datatype='real' default-format='p0.00%' name='[Calculation_1135751531755528200]' role='measure' type='quantitative'>
