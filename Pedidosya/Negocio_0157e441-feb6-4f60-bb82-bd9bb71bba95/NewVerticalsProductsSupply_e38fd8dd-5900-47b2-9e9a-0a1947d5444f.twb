            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[businessCategory]' derivation='None' name='[none:businessCategory:nk]' pivot='key' type='nominal' />
