              <calculation class='tableau' formula='split([partner_name],&quot;-&quot;, 1)' />
            </column>
            <column caption='Rejected at' datatype='datetime' name='[Picked up TS (copy)_1327998988316192775]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='makedatetime(date([last_resp_date]), &#13;&#10;MAKETIME(datepart(&quot;hour&quot;,datetime([last_resp_date]))&#13;&#10;,datepart(&quot;minute&quot;,datetime([last_resp_date]))&#13;&#10;,datepart(&quot;second&quot;,datetime([last_resp_date]))))' />
