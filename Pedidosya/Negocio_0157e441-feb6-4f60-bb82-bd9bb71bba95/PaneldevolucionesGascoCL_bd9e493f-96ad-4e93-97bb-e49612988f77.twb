      <aliases enabled='yes' />
      <column caption='Placed TS' datatype='datetime' name='[Accepted TS (copy)_1327998988315344900]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='makedatetime(date([placed_at]), &#13;&#10;MAKETIME(datepart(&quot;hour&quot;,datetime([placed_at]))&#13;&#10;,datepart(&quot;minute&quot;,datetime([placed_at]))&#13;&#10;,datepart(&quot;second&quot;,datetime([placed_at]))))' />
      </column>
      <column caption='Picked Up to Rejection' datatype='integer' name='[Accepted to Picked Up (copy)_1327998988317126665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&quot;minute&quot;,[Placed TS (copy)_1327998988315725830],[Picked up TS (copy)_1327998988316192775])' />
      </column>
      <column caption='Placed to Accepted' datatype='integer' name='[Calculation_1327998988312666112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&quot;minute&quot;,[Accepted TS (copy)_1327998988315344900],[Calculation_1327998988314206210])' />
      </column>
      <column caption='month accepted' datatype='integer' name='[Calculation_1327998988313448449]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='month([Calculation_1327998988314206210])' />
      </column>
      <column caption='Accepted TS' datatype='datetime' name='[Calculation_1327998988314206210]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='makedatetime(date([accepted_at]), &#13;&#10;MAKETIME(datepart(&quot;hour&quot;,datetime([accepted_at]))&#13;&#10;,datepart(&quot;minute&quot;,datetime([accepted_at]))&#13;&#10;,datepart(&quot;second&quot;,datetime([accepted_at]))))' />
      </column>
      <column caption='minutes to rejection' datatype='integer' name='[Calculation_1414974768835723264]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if isnull([Picked up TS (copy)_1327998988316192775]) then&#13;&#10;0&#13;&#10;else&#13;&#10;DATEDIFF(&quot;minute&quot;,[registered_at],[Picked up TS (copy)_1327998988316192775])&#13;&#10;end' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_585749470489165824]' role='measure' type='quantitative'>
