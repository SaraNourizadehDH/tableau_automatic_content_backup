      <column caption='aplica' datatype='string' name='[Calculation_70650282116546560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([Calculation_1327998988314206210]) then &quot;No&quot; else (&#13;&#10;if [tools_description] in (&quot;Pedido no entregado&quot;&#13;&#10;,&quot;Horario de entrega retrasado&quot;) and [has_pickup]=&quot;Yes&quot;&#13;&#10;then &quot;Yes&quot;&#13;&#10;elseif [tools_description] in (&quot;Error al realizar el pedido&quot;)&#13;&#10;and [Calculation_1414974768835723264] &gt;60&#13;&#10;then &quot;Yes&quot; &#13;&#10;elseif [tools_description] in (&quot;Pedido no entregado&quot;&#13;&#10;,&quot;Horario de entrega retrasado&quot;) and [has_pickup]=&quot;No&quot;&#13;&#10;and [Calculation_1414974768835723264]&gt;120 then &quot;Yes&quot;&#13;&#10;else &quot;No&quot; &#13;&#10;end)&#13;&#10;end' />
      </column>
