  <worksheets>
    <worksheet name='Datos dev'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Orders detail</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datos_gasco (user_cristian_alvarez)' name='federated.0pydn2w1ddngfn1bes7wh0ohdj3b' />
          </datasources>
          <datasource-dependencies datasource='federated.0pydn2w1ddngfn1bes7wh0ohdj3b'>
            <column caption='Placed TS' datatype='datetime' name='[Accepted TS (copy)_1327998988315344900]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='makedatetime(date([placed_at]), &#13;&#10;MAKETIME(datepart(&quot;hour&quot;,datetime([placed_at]))&#13;&#10;,datepart(&quot;minute&quot;,datetime([placed_at]))&#13;&#10;,datepart(&quot;second&quot;,datetime([placed_at]))))' />
            </column>
            <column caption='Accepted TS' datatype='datetime' name='[Calculation_1327998988314206210]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='makedatetime(date([accepted_at]), &#13;&#10;MAKETIME(datepart(&quot;hour&quot;,datetime([accepted_at]))&#13;&#10;,datepart(&quot;minute&quot;,datetime([accepted_at]))&#13;&#10;,datepart(&quot;second&quot;,datetime([accepted_at]))))' />
            </column>
            <column caption='minutes to rejection' datatype='integer' name='[Calculation_1414974768835723264]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if isnull([Picked up TS (copy)_1327998988316192775]) then&#13;&#10;0&#13;&#10;else&#13;&#10;DATEDIFF(&quot;minute&quot;,[registered_at],[Picked up TS (copy)_1327998988316192775])&#13;&#10;end' />
            </column>
            <column caption='aplica' datatype='string' name='[Calculation_70650282116546560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([Calculation_1327998988314206210]) then &quot;No&quot; else (&#13;&#10;if [tools_description] in (&quot;Pedido no entregado&quot;&#13;&#10;,&quot;Horario de entrega retrasado&quot;) and [has_pickup]=&quot;Yes&quot;&#13;&#10;then &quot;Yes&quot;&#13;&#10;elseif [tools_description] in (&quot;Error al realizar el pedido&quot;)&#13;&#10;and [Calculation_1414974768835723264] &gt;60&#13;&#10;then &quot;Yes&quot; &#13;&#10;elseif [tools_description] in (&quot;Pedido no entregado&quot;&#13;&#10;,&quot;Horario de entrega retrasado&quot;) and [has_pickup]=&quot;No&quot;&#13;&#10;and [Calculation_1414974768835723264]&gt;120 then &quot;Yes&quot;&#13;&#10;else &quot;No&quot; &#13;&#10;end)&#13;&#10;end' />
            </column>
            <column caption='Devolución' datatype='real' name='[Calculation_801359309629595649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_70650282116546560]=&quot;Yes&quot; and [order_status]=&quot;REJECTED&quot; and [is_online_payment]=1  then&#13;&#10;&#13;&#10;1*([amount_no_discount]-[commission_amount]) //100% devolución&#13;&#10;&#13;&#10;elseif [Calculation_70650282116546560]=&quot;Yes&quot; and [order_status]=&quot;REJECTED&quot; and [is_online_payment]=0  then&#13;&#10; max(0,[discount_company]-[commission_amount]) &#13;&#10;else 0 &#13;&#10;end' />
            </column>
            <column caption='Distribuidor' datatype='string' name='[Calculation_826410594628694024]' role='dimension' type='nominal'>
