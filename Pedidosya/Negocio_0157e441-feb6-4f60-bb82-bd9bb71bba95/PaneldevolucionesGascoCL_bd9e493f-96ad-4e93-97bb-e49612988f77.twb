            <column datatype='integer' name='[is_online_payment]' role='measure' type='quantitative' />
            <column caption='Last Resp Date' datatype='string' name='[last_resp_date]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_826410594628694024]' derivation='None' name='[none:Calculation_826410594628694024:nk]' pivot='key' type='nominal' />
            <column-instance column='[company_name]' derivation='None' name='[none:company_name:nk]' pivot='key' type='nominal' />
