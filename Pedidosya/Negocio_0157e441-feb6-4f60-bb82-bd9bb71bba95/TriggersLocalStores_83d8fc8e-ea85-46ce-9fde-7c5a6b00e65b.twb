            <column caption='Triggered partner' datatype='string' name='[Calculation_787848497644167172]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_546624433122988039]&gt;0 then &quot;Yes&quot; else &quot;No&quot; end' />
            </column>
            <column caption='Last 5 weeks' datatype='string' name='[Last 5 weeks (copy)_787848497642799107]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isoweek([week_date (action_trigger_grade)])&gt;=ISOWEEK(today())-5 and ISOWEEK([week_date (action_trigger_grade)])&lt;ISOWEEK(today()) then &quot;Yes&quot; else &quot;No&quot; end' />
