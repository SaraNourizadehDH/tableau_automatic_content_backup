    <worksheet name='week distr top trigger'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#666666' fontsize='12'>Triggers weekly distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='OPS triggers Local Stores' name='federated.1wu3cav1qo6a7k18z2nrb1msyoop' />
          </datasources>
          <datasource-dependencies datasource='federated.1wu3cav1qo6a7k18z2nrb1msyoop'>
            <column caption='Franchise' datatype='string' name='[Calculation_1037235325576769536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([franchise_name (action_trigger_grade)]) and isnull([franchise_name]) then &quot;No franchise&quot;&#13;&#10;elseif isnull([franchise_name (action_trigger_grade)]) then [franchise_name] &#13;&#10;else [franchise_name (action_trigger_grade)] &#13;&#10;end' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1131529439604826117]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datename(&quot;weekday&quot;,[fecha_desde (ops_triggers_cl)],&quot;monday&quot;)' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_1272548406128070656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([business_type_name (ops_triggers_cl)]) then [business_type_name] else [business_type_name (ops_triggers_cl)] end' />
            </column>
            <column caption='triggers' datatype='integer' name='[Calculation_513691853369880576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([schedule_variation_id (ops_triggers_cl)])' />
            </column>
            <column caption='% Closed by triggers' datatype='real' name='[Calculation_546624433122988039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([closed_by_trigger_flt])/sum([closed_times_flt]))' />
            </column>
            <column caption='Cierre efectivo (min)' datatype='integer' name='[Calculation_660058843775668224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [trigger_minutes (ops_triggers_cl)]=25 then [min_elapsed (ops_triggers_cl)]&#13;&#10;elseif [min_elapsed (ops_triggers_cl)]&gt;[trigger_minutes (ops_triggers_cl)] then [trigger_minutes (ops_triggers_cl)] &#13;&#10;else [min_elapsed (ops_triggers_cl)] end' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_660058843777019905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;week &quot; + str(ISOWEEK([fecha_desde (ops_triggers_cl)]))' />
            </column>
            <column caption='Triggered partner' datatype='string' name='[Calculation_787848497644167172]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_546624433122988039]&gt;0 then &quot;Yes&quot; else &quot;No&quot; end' />
            </column>
            <column caption='Account Owner' datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column caption='Business Name' datatype='string' name='[business_type_name (ops_triggers_cl)]' role='dimension' type='nominal' />
            <column caption='Business Type Name' datatype='string' name='[business_type_name]' role='dimension' type='nominal' />
            <column caption='Closed By Trigger (min)' datatype='integer' name='[closed_by_trigger_flt]' role='measure' type='quantitative' />
            <column caption='Closed Times Flt' datatype='integer' name='[closed_times_flt]' role='measure' type='quantitative' />
            <column caption='Fecha Desde' datatype='date' name='[fecha_desde (ops_triggers_cl)]' role='dimension' type='ordinal' />
            <column datatype='string' name='[franchise_name (action_trigger_grade)]' role='dimension' type='nominal' />
            <column datatype='string' name='[franchise_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='No franchise' />
              </aliases>
            </column>
            <column caption='Min Elapsed (Ops Triggers Cl)' datatype='integer' name='[min_elapsed (ops_triggers_cl)]' role='measure' type='quantitative' />
