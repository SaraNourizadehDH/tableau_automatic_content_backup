      <aliases enabled='yes' />
      <column caption='Franchise' datatype='string' name='[Calculation_1037235325576769536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([franchise_name (action_trigger_grade)]) and isnull([franchise_name]) then &quot;No franchise&quot;&#13;&#10;elseif isnull([franchise_name (action_trigger_grade)]) then [franchise_name] &#13;&#10;else [franchise_name (action_trigger_grade)] &#13;&#10;end' />
      </column>
      <column caption='main cousine' datatype='string' name='[Calculation_1124211093385805824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([main_cousine_category_name (ops_triggers_cl)]) then [main_cousine_category_name]&#13;&#10;else [main_cousine_category_name (ops_triggers_cl)]&#13;&#10;end' />
      </column>
      <column caption='Cierre' datatype='string' name='[Calculation_1131529439588560896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([trigger_minutes (ops_triggers_cl)]) and [notes (ops_triggers_cl)]=&quot;SHIFT_ENDING_VARIATION&quot; then &quot;1440 min&quot;&#13;&#10;elseif [trigger_minutes (ops_triggers_cl)]=25 then &quot;1440 min&quot;&#13;&#10;elseif isnull([trigger_minutes (ops_triggers_cl)]) and [notes (ops_triggers_cl)]=&quot;SHIFT_ENDING&quot; and [category_name (ops_triggers_cl)]=&quot;TOO_MANY_REJECTED_ORDERS&quot; then &quot;1440 min&quot;&#13;&#10;elseif isnull([trigger_minutes (ops_triggers_cl)]) and contains([notes (ops_triggers_cl)],&quot;Proceso Dolphin - Partner Alto&quot;) then &quot;1440 min&quot;&#13;&#10;else str([trigger_minutes (ops_triggers_cl)]) + &quot; min&quot;&#13;&#10;end' />
      </column>
      <column caption='Last 2 weeks' datatype='string' name='[Calculation_1131529439593312257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datetrunc(&quot;iso-week&quot;,[fecha_desde (ops_triggers_cl)])&#10;&gt;=&#10;dateadd(&quot;iso-week&quot;,-2,datetrunc(&quot;iso-week&quot;,today()))&#10;then &quot;Yes&quot; else &quot;No&quot; end' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_1131529439604826117]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datename(&quot;weekday&quot;,[fecha_desde (ops_triggers_cl)],&quot;monday&quot;)' />
      </column>
      <column caption='Data up to' datatype='string' name='[Calculation_1131529439616925708]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed: &quot;Data up to: &quot; +&#13;&#10;datename(&quot;day&quot;,max([created_date (ops_triggers_cl)]),&quot;monday&quot;) +&quot; &quot;&#13;&#10;+ datename(&quot;month&quot;,max([created_date (ops_triggers_cl)]))&#13;&#10;+&quot;, &quot;&#13;&#10;+str(datepart(&quot;year&quot;,max([created_date (ops_triggers_cl)]))) &#13;&#10;}' />
      </column>
      <column caption='Vertical' datatype='string' name='[Calculation_1272548406128070656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([business_type_name (ops_triggers_cl)]) then [business_type_name] else [business_type_name (ops_triggers_cl)] end' />
      </column>
      <column caption='Dimension' datatype='integer' name='[Calculation_1352205821369434113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[ops_triggers_cl Parameter]=&quot;1&quot; then [Calculation_513691853369880576]&#13;&#10;elseif [Parameters].[ops_triggers_cl Parameter]=&quot;2&quot; then sum([confirmed])&#13;&#10;ELSEIF [Parameters].[ops_triggers_cl Parameter]=&quot;3&quot; then [Calculation_546624433116463109]&#13;&#10;end' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_1352205821371654146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Last Vendor Grade Parameter]=&quot;1&quot; then [Calculation_546624433116663814]&#13;&#10;elseif [Parameters].[Last Vendor Grade Parameter]=&quot;2&quot; then [Calculation_1546142072923316227]&#13;&#10;end' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_1539386678352048128]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% stopped' datatype='real' name='[Calculation_1546142072898977794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([triggers (copy)_660058843782144002])/([Calculation_513691853369880576])' />
      </column>
      <column caption='Vendor Late' datatype='real' name='[Calculation_1546142072923316227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vl_num_nstacking])/sum([vl_den_nstacking])' />
      </column>
      <column caption='Open Time' datatype='real' name='[Calculation_1745989311340859392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([schedule_open_time_flt])-sum([closed_times_flt]))/sum([schedule_open_time_flt])' />
      </column>
      <column caption='Partner interrumpe trigger' datatype='string' name='[Calculation_1745989311345061889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed [partner_id (ops_triggers_cl)], [notes (ops_triggers_cl)], [business_type_name (ops_triggers_cl)],[Calculation_660058843777019905]:&#13;&#10;if [triggers (copy)_660058843782144002]&gt;=1 then &quot;Yes&quot; else &quot;No&quot; end }' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_1745989311390314499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed])+sum([rejected])' />
      </column>
      <column caption='triggers' datatype='integer' name='[Calculation_513691853369880576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([schedule_variation_id (ops_triggers_cl)])' />
      </column>
      <column caption='Apertura (min)' datatype='integer' name='[Calculation_513691853373493251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[trigger_minutes (ops_triggers_cl)]-[Calculation_660058843775668224]' />
      </column>
      <column caption='partners' datatype='integer' name='[Calculation_546624433116463109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([partner_id])' />
      </column>
      <column caption='Vendor FR' datatype='real' name='[Calculation_546624433116663814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_rejected])/sum([confirmed]+[rejected])' />
      </column>
      <column caption='% Closed by triggers' datatype='real' name='[Calculation_546624433122988039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([closed_by_trigger_flt])/sum([closed_times_flt]))' />
      </column>
      <column caption='total triggers' datatype='integer' name='[Calculation_546624433124769800]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{fixed [notes (ops_triggers_cl)],[business_type_name],[Calculation_660058843777019905]:[Calculation_513691853369880576]}' />
      </column>
      <column caption='Cierre efectivo (min)' datatype='integer' name='[Calculation_660058843775668224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [trigger_minutes (ops_triggers_cl)]=25 then [min_elapsed (ops_triggers_cl)]&#13;&#10;elseif [min_elapsed (ops_triggers_cl)]&gt;[trigger_minutes (ops_triggers_cl)] then [trigger_minutes (ops_triggers_cl)] &#13;&#10;else [min_elapsed (ops_triggers_cl)] end' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_660058843777019905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;week &quot; + str(ISOWEEK([fecha_desde (ops_triggers_cl)]))' />
