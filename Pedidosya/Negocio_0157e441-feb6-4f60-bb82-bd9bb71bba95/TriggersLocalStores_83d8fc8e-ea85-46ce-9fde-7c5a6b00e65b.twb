      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#666666'>Triggers in </run>
            <run fontcolor='#898989' italic='true'><![CDATA[<[federated.1wu3cav1qo6a7k18z2nrb1msyoop].[none:Calculation_1272548406128070656:nk]> ]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='OPS triggers Local Stores' name='federated.1wu3cav1qo6a7k18z2nrb1msyoop' />
          </datasources>
          <datasource-dependencies datasource='federated.1wu3cav1qo6a7k18z2nrb1msyoop'>
            <column caption='Franchise' datatype='string' name='[Calculation_1037235325576769536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([franchise_name (action_trigger_grade)]) and isnull([franchise_name]) then &quot;No franchise&quot;&#13;&#10;elseif isnull([franchise_name (action_trigger_grade)]) then [franchise_name] &#13;&#10;else [franchise_name (action_trigger_grade)] &#13;&#10;end' />
            </column>
            <column caption='Cierre' datatype='string' name='[Calculation_1131529439588560896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([trigger_minutes (ops_triggers_cl)]) and [notes (ops_triggers_cl)]=&quot;SHIFT_ENDING_VARIATION&quot; then &quot;1440 min&quot;&#13;&#10;elseif [trigger_minutes (ops_triggers_cl)]=25 then &quot;1440 min&quot;&#13;&#10;elseif isnull([trigger_minutes (ops_triggers_cl)]) and [notes (ops_triggers_cl)]=&quot;SHIFT_ENDING&quot; and [category_name (ops_triggers_cl)]=&quot;TOO_MANY_REJECTED_ORDERS&quot; then &quot;1440 min&quot;&#13;&#10;elseif isnull([trigger_minutes (ops_triggers_cl)]) and contains([notes (ops_triggers_cl)],&quot;Proceso Dolphin - Partner Alto&quot;) then &quot;1440 min&quot;&#13;&#10;else str([trigger_minutes (ops_triggers_cl)]) + &quot; min&quot;&#13;&#10;end' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_1272548406128070656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([business_type_name (ops_triggers_cl)]) then [business_type_name] else [business_type_name (ops_triggers_cl)] end' />
            </column>
            <column caption='% stopped' datatype='real' name='[Calculation_1546142072898977794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([triggers (copy)_660058843782144002])/([Calculation_513691853369880576])' />
            </column>
            <column caption='triggers' datatype='integer' name='[Calculation_513691853369880576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([schedule_variation_id (ops_triggers_cl)])' />
            </column>
            <column caption='% Closed by triggers' datatype='real' name='[Calculation_546624433122988039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([closed_by_trigger_flt])/sum([closed_times_flt]))' />
            </column>
            <column caption='Cierre efectivo (min)' datatype='integer' name='[Calculation_660058843775668224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [trigger_minutes (ops_triggers_cl)]=25 then [min_elapsed (ops_triggers_cl)]&#13;&#10;elseif [min_elapsed (ops_triggers_cl)]&gt;[trigger_minutes (ops_triggers_cl)] then [trigger_minutes (ops_triggers_cl)] &#13;&#10;else [min_elapsed (ops_triggers_cl)] end' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_660058843777019905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;week &quot; + str(ISOWEEK([fecha_desde (ops_triggers_cl)]))' />
            </column>
            <column caption='Account manager' datatype='string' name='[Calculation_787848497634242560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([account_owner (ops_triggers_cl)]) then [account_owner] else [account_owner (ops_triggers_cl)] end' />
            </column>
            <column caption='Partner' datatype='string' name='[Calculation_787848497638871041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([restaurant_name]) then [partner_name] else [restaurant_name] end' />
            </column>
            <column caption='Triggered partner' datatype='string' name='[Calculation_787848497644167172]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_546624433122988039]&gt;0 then &quot;Yes&quot; else &quot;No&quot; end' />
            </column>
            <column caption='Last 3 weeks' datatype='string' name='[Last 2 weeks (copy)_451204421679120385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isoweek([fecha_desde (ops_triggers_cl)])&gt;=ISOWEEK(today())-3 and ISOWEEK([fecha_desde (ops_triggers_cl)])&lt; ISOWEEK(today()) then &quot;Yes&quot; else &quot;No&quot; end' />
            </column>
