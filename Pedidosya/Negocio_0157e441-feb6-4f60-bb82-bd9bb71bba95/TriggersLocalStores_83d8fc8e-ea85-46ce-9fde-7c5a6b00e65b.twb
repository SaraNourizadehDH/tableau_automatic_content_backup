          <datasource-dependencies datasource='Parameters'>
            <column alias='Vendor Fail Rate' caption='KPI' datatype='string' name='[Last Vendor Grade Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Vendor Fail Rate' />
                <alias key='&quot;2&quot;' value='Vendor Late' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wu3cav1qo6a7k18z2nrb1msyoop'>
            <column caption='Franchise' datatype='string' name='[Calculation_1037235325576769536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([franchise_name (action_trigger_grade)]) and isnull([franchise_name]) then &quot;No franchise&quot;&#13;&#10;elseif isnull([franchise_name (action_trigger_grade)]) then [franchise_name] &#13;&#10;else [franchise_name (action_trigger_grade)] &#13;&#10;end' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_1272548406128070656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([business_type_name (ops_triggers_cl)]) then [business_type_name] else [business_type_name (ops_triggers_cl)] end' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_1352205821371654146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Last Vendor Grade Parameter]=&quot;1&quot; then [Calculation_546624433116663814]&#13;&#10;elseif [Parameters].[Last Vendor Grade Parameter]=&quot;2&quot; then [Calculation_1546142072923316227]&#13;&#10;end' />
            </column>
            <column caption='Vendor Late' datatype='real' name='[Calculation_1546142072923316227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vl_num_nstacking])/sum([vl_den_nstacking])' />
            </column>
            <column caption='Open Time' datatype='real' name='[Calculation_1745989311340859392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([schedule_open_time_flt])-sum([closed_times_flt]))/sum([schedule_open_time_flt])' />
            </column>
            <column caption='Vendor FR' datatype='real' name='[Calculation_546624433116663814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_rejected])/sum([confirmed]+[rejected])' />
            </column>
            <column caption='% Closed by triggers' datatype='real' name='[Calculation_546624433122988039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([closed_by_trigger_flt])/sum([closed_times_flt]))' />
            </column>
            <column caption='Account manager' datatype='string' name='[Calculation_787848497634242560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([account_owner (ops_triggers_cl)]) then [account_owner] else [account_owner (ops_triggers_cl)] end' />
