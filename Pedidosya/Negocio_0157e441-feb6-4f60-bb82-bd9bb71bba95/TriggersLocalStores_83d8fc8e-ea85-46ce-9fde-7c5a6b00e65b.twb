              <calculation class='tableau' formula='if isnull([trigger_minutes (ops_triggers_cl)]) and [notes (ops_triggers_cl)]=&quot;SHIFT_ENDING_VARIATION&quot; then &quot;1440 min&quot;&#13;&#10;elseif [trigger_minutes (ops_triggers_cl)]=25 then &quot;1440 min&quot;&#13;&#10;elseif isnull([trigger_minutes (ops_triggers_cl)]) and [notes (ops_triggers_cl)]=&quot;SHIFT_ENDING&quot; and [category_name (ops_triggers_cl)]=&quot;TOO_MANY_REJECTED_ORDERS&quot; then &quot;1440 min&quot;&#13;&#10;elseif isnull([trigger_minutes (ops_triggers_cl)]) and contains([notes (ops_triggers_cl)],&quot;Proceso Dolphin - Partner Alto&quot;) then &quot;1440 min&quot;&#13;&#10;else str([trigger_minutes (ops_triggers_cl)]) + &quot; min&quot;&#13;&#10;end' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_1272548406128070656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([business_type_name (ops_triggers_cl)]) then [business_type_name] else [business_type_name (ops_triggers_cl)] end' />
            </column>
            <column caption='% Closed by triggers' datatype='real' name='[Calculation_546624433122988039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([closed_by_trigger_flt])/sum([closed_times_flt]))' />
            </column>
            <column caption='Cierre efectivo (min)' datatype='integer' name='[Calculation_660058843775668224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [trigger_minutes (ops_triggers_cl)]=25 then [min_elapsed (ops_triggers_cl)]&#13;&#10;elseif [min_elapsed (ops_triggers_cl)]&gt;[trigger_minutes (ops_triggers_cl)] then [trigger_minutes (ops_triggers_cl)] &#13;&#10;else [min_elapsed (ops_triggers_cl)] end' />
            </column>
            <column caption='Triggered partner' datatype='string' name='[Calculation_787848497644167172]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_546624433122988039]&gt;0 then &quot;Yes&quot; else &quot;No&quot; end' />
            </column>
            <column caption='Business Name' datatype='string' name='[business_type_name (ops_triggers_cl)]' role='dimension' type='nominal' />
