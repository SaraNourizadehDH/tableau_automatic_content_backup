      <aliases enabled='yes' />
      <column caption='% comission 2' datatype='real' name='[% comission (copy)_769834096322162690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_919015844346548229])/sum([total_amount])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0k0xeym138oa001fkw2ja058zra6].[ctd:order_id:qk]&quot;' value='orders' />
          <alias key='&quot;[federated.0k0xeym138oa001fkw2ja058zra6].[sum:amount_no_discount:qk]&quot;' value='Monto orden' />
          <alias key='&quot;[federated.0k0xeym138oa001fkw2ja058zra6].[sum:Calculation_202662027579437056:qk]&quot;' value='Devolución' />
          <alias key='&quot;[federated.0k0xeym138oa001fkw2ja058zra6].[sum:commission_amount:qk]&quot;' value='Comisión' />
        </aliases>
      </column>
      <column caption='Data up to McD' datatype='string' name='[Calculation_1171780374857113602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Data up to:&quot;' />
      </column>
      <column caption='Projected this month' datatype='real' name='[Calculation_1500543161464307715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [partner_id]:&#13;&#10;sum(if MONTH([registered_date])=2 &#13;&#10;and [flag_last_2_months (copy)_1500543161463119874]=&quot;Yes&quot;&#13;&#10;and [Calculation_202662027591512065]=&quot;In&quot;&#13;&#10;and [Calculation_202662027824799746]=&quot;No&quot;&#13;&#10;then [Calculation_202662027579437056] else 0 end)}*[Calculation_578712614081347587]/([Calculation_578712614081347587]-[días para cerrar mes (copy)_578712614080696321])' />
      </column>
      <column aggregation='Attribute' caption='exclude' datatype='real' name='[Calculation_1500543161472495620]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{EXCLUDE MONTH([registered_date]): sum(if month([registered_date])=1 &#13;&#10;then [Calculation_202662027579437056] end)}' />
      </column>
      <column caption='Calculation3' datatype='real' name='[Calculation_1500543161472724997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [partner_id]:sum([Calculation_1500543161472495620])}' />
      </column>
      <column caption='data-up-to-mcd' datatype='string' name='[Calculation_1540231125331660801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed: str(datename(&quot;month&quot;,max([registered_date])))+&quot; &quot;+&#13;&#10;str(datepart(&quot;day&quot;,max([registered_date])))+&quot;, &quot;+&#13;&#10;str(datepart(&quot;year&quot;,max([registered_date])))}' />
      </column>
      <column caption='lógica devolución McD' datatype='real' name='[Calculation_202662027579437056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [franchise_name]=&quot;McDonald&apos;s&quot; then (&#13;&#10;if [is_online_payment]=1 then &#13;&#10;//motivos pedidosya&#13;&#10;(if [rm_id] IN (4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36) &#13;&#10;then [amount_no_discount]-[commission_amount]&#13;&#10;//motivos compartidos&#13;&#10;elseif [rm_id] in (34,27,26) then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;//motivos mcdonalds&#13;&#10;elseif [rm_id] in (23,44,3,7,39,37,11,46,2,33,32,15,12,9) &#13;&#10;then 0 &#13;&#10;else null end)&#13;&#10;elseif [is_online_payment]=0 then &#13;&#10;//motivos pedidosya&#13;&#10;(if [rm_id] in (23,44,3,39,37,11,46,2,33,32,15,12,9,4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,34,27,26)&#13;&#10;then [amount_no_discount]&#13;&#10;//motivos mcdonalds&#13;&#10;ELSEIF [rm_id] in (7) then 0 &#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end //payment if&#13;&#10;) &#13;&#10;else null end //franchise if' />
      </column>
      <column caption='rm list' datatype='string' name='[Calculation_202662027591512065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [rm_id] in &#13;&#10;(4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,23,44,3,7,39,37,11,46,2,33,32,15,12,9,34,27,26)&#13;&#10;then &quot;In&quot;&#13;&#10;else &quot;Out&quot;&#13;&#10;end' />
      </column>
      <column caption='flag null/diff timestamp' datatype='string' name='[Calculation_202662027824799746]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//difference with existence dashboard&#13;&#10;if ISNULL([sent_to_vendor_at]) or ISNULL([vendor_accepted_at]) &#13;&#10;then &quot;Yes&quot;&#13;&#10;elseif [rejection_stage]=&quot;Before vendor-acceptance&quot; &#13;&#10;and &#13;&#10;(DATEDIFF(&quot;second&quot;,[vendor_accepted_at],[last_resp_date])=-1 &#13;&#10;or DATEDIFF(&quot;second&quot;,[vendor_accepted_at],[last_resp_date])=0)&#13;&#10;then &quot;Yes&quot; &#13;&#10;else &quot;No&quot; END' />
      </column>
      <column caption='Payment' datatype='string' name='[Calculation_202662027827310595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [descriptionES]=&quot;Efectivo&quot; then &quot;Efectivo&quot;&#13;&#10;else &quot;Online&quot; &#13;&#10;end' />
      </column>
      <column caption='días del mes' datatype='integer' name='[Calculation_578712614081347587]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [partner_id]:&#13;&#10;max(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,TODAY())))))&#13;&#10;}' />
      </column>
      <column caption='% comission' datatype='real' name='[Calculation_769834096318201856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_919015844346548229])/sum([amount_no_discount])' />
      </column>
      <column caption='flag_last_2_months' datatype='string' name='[Calculation_919015844324085762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&quot;month&quot;, today()) = 1 then &#13;&#10;( if datepart(&quot;month&quot;, [registered_date]) in (12,1) then &quot;Yes&quot; else &quot;No&quot; end&#13;&#10;)&#13;&#10;elseif datepart(&quot;month&quot;, [registered_date]) &gt;= datepart(&quot;month&quot;, today())-2 then &quot;Yes&quot; &#13;&#10;else &quot;No&quot; end' />
      </column>
      <column caption='Comisión Facturable' datatype='real' name='[Calculation_919015844346548229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Motivos PeYa&#13;&#10;if [rm_id] in (4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36) &#13;&#10;and [is_online_payment]=1 &#13;&#10;then [commission_amount]&#13;&#10;//Copiado desde la Query SQL&#13;&#10;//Motivos mcdonalds&#13;&#10;ELSEIF [rm_id] in (23,44,3,7,39,37,11,46,2,33,32,15,12,9) &#13;&#10;and [is_online_payment]=1 then 0&#13;&#10;//Motivos compartidos&#13;&#10;ELSEIF [rm_id] in (34,27,26) and [is_online_payment]=1 &#13;&#10;then [commission_amount]*0.5&#13;&#10;//Pago efectivo&#13;&#10;ELSEIF [rm_id] in (7) and [is_online_payment]=0 then 0&#13;&#10;ELSEIF  [rm_id] in (23,44,3,39,37,11,46,2,33,32,15,12,9,4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,34,27,26)&#13;&#10;and [is_online_payment]=0 then [commission_amount]&#13;&#10;else null end' />
      </column>
      <column caption='Partner' datatype='string' name='[Partner Name (copy)_578712614110212104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[partner_name]' />
      </column>
      <column caption='Resultado Nov' datatype='real' name='[Proyección mes actual (copy)_578712614094819332]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{fixed [partner_id]:&#13;&#10;sum(if MONTH([registered_date])=11 &#13;&#10;//and [Last 3 months]=&quot;Yes&quot;&#13;&#10;and [Calculation_202662027591512065]=&quot;In&quot;&#13;&#10;and [Calculation_202662027824799746]=&quot;No&quot;&#13;&#10;then [Calculation_202662027579437056] else 0 end)}' />
      </column>
      <column caption='Projected scenario ' datatype='string' name='[Resultado Nov (copy)_578712614095024133]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Proyección mes actual (copy)_578712614094819332]&lt;[Calculation_1500543161464307715]&#13;&#10;then &quot;Over november&quot;&#13;&#10;else &quot;Under november&quot;&#13;&#10;end' />
      </column>
      <column caption='Tools desc.' datatype='string' name='[Tools Description (copy)_578712614109769734]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [tools_description] in &#13;&#10;(&quot;Repartidor incontactable&quot;,&#13;&#10; &quot;No es posible contactar al cliente&quot;,&#13;&#10;&quot;Pedido no entregado&quot;,&#13;&#10;&quot;No hay cadete disponible&quot;,&#13;&#10;&quot;Horario de entrega retrasado&quot;,&#13;&#10;&quot;Local cerrado&quot;,&#13;&#10;&quot;Error al realizar el pedido&quot;)&#13;&#10;then [tools_description]&#13;&#10;else &quot;Otros&quot;&#13;&#10;end' />
      </column>
      <column caption='Tools Description Top Filter' datatype='string' name='[Tools Description (copy)_919015844337139715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[tools_description]' />
      </column>
