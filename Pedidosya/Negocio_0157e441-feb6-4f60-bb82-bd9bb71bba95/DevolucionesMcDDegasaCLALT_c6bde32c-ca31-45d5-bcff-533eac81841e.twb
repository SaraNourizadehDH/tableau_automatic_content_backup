      <column caption='Last 3 months' datatype='string' name='[flag_last_2_months (copy)_1500543161463119874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&quot;month&quot;, today()) = 1 then &#13;&#10;( if datepart(&quot;month&quot;, [registered_date]) in (11,12,1) then &quot;Yes&quot; else &quot;No&quot; end&#13;&#10;)&#13;&#10;elseif datepart(&quot;month&quot;, today()) = 2 then &#13;&#10;( if datepart(&quot;month&quot;, [registered_date]) in (12,1,2) then &quot;Yes&quot; else &quot;No&quot; end&#13;&#10;)&#13;&#10;elseif datepart(&quot;month&quot;, [registered_date]) &gt;= datepart(&quot;month&quot;, today())-3 then &quot;Yes&quot; &#13;&#10;else &quot;No&quot; end' />
      </column>
