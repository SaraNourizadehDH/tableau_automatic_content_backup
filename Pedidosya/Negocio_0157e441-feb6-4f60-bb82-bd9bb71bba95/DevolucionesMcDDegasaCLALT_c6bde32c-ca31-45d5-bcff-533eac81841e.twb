      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.081r57l05zfk4s1cun4t20igpb37].[sum:amount_no_discount:qk]&quot;' value='Valor productos' />
          <alias key='&quot;[federated.081r57l05zfk4s1cun4t20igpb37].[sum:commission_amount:qk]&quot;' value='Comisión' />
          <alias key='&quot;[federated.081r57l05zfk4s1cun4t20igpb37].[sum:devolución por rechazo (copy)_1298444110847127560:qk]&quot;' value='Devolución' />
          <alias key='&quot;[federated.081r57l05zfk4s1cun4t20igpb37].[sum:total_amount:qk]&quot;' value='Total orden' />
        </aliases>
      </column>
      <column caption='CAP 5%' datatype='real' name='[CAP 1% (copy)_1298444110841278469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//CAP se calcula sobre las confirmadas&#13;&#10;0.05*[Calculation_1298444110845902855]' />
      </column>
      <column caption='frag-null-dates' datatype='string' name='[Calculation_1171780374843432960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([sent_to_vendor_at]) then &quot;Yes&quot; else &quot;No&quot; end' />
      </column>
      <column caption='Data up to Degasa ' datatype='string' name='[Calculation_1171780374856110081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Data up to: &quot;' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_1247778613610565632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_id])' />
      </column>
      <column caption='lógica devolución' datatype='real' name='[Calculation_1247778613622018049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (([franchise_name]=&quot;KFC&quot; or [franchise_name]=&quot;Wendy&apos;s&quot; &#13;&#10;or [franchise_name]=&quot;China Wok&quot;) &#13;&#10;and&#13;&#10;[has_pickup]=&quot;Yes&quot;) &#13;&#10;then &#13;&#10;0.5*([amount_no_discount]-[commission_amount])&#13;&#10;else 0.57*([amount_no_discount]-[commission_amount]) &#13;&#10;end' />
      </column>
      <column caption='CAP 1%' datatype='real' name='[Calculation_1298444110841200644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.01*[Calculation_1298444110845902855]' />
      </column>
      <column caption='Rider/User incontactable' datatype='real' name='[Calculation_1298444110844518406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; and&#13;&#10;([fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;) and&#13;&#10;([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;)&#13;&#10;and ([tools_description]=&quot;Repartidor incontactable&quot;&#13;&#10;or [tools_description]=&quot;No es posible contactar al cliente&quot;)&#13;&#10;then ( //devolución&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null&#13;&#10;end)' />
      </column>
      <column caption='confirmed amount' datatype='real' name='[Calculation_1298444110845902855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(if [order_status]=&quot;CONFIRMED&quot; then [total_amount] else NULL end)' />
      </column>
      <column caption='offset' datatype='integer' name='[Calculation_1298444110869618704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='total orders' datatype='integer' name='[Calculation_1500543161444880384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_id])' />
      </column>
      <column caption='data-up-to-degasa' datatype='string' name='[Calculation_1540231125330538496]' role='measure' type='nominal'>
        <calculation class='tableau' formula='str(datename(&quot;month&quot;,max([registered_date])))&#13;&#10;+&quot; &quot;&#13;&#10;+str(datepart(&quot;day&quot;,max([registered_date])))&#13;&#10;+&quot;, &quot;&#13;&#10;+str(datepart(&quot;year&quot;,max([registered_date])))' />
      </column>
      <column caption='flag_detalle_degasa' datatype='string' name='[Calculation_919015844280336384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//se muestran las confirmadas y las rechazadas a devolución&#13;&#10;if [order_status]=&quot;CONFIRMED&quot; then &quot;Yes&quot;&#13;&#10;ELSEIF [rejection_stage]=&quot;Before pickup&quot; &#13;&#10;or [rejection_stage]=&quot;Before drop-off&quot; &#13;&#10;or [rejection_stage]=&quot;After drop-off&quot; &#13;&#10;then (&#13;&#10;    if [fail_rate_owner]&lt;&gt;&quot;Restaurant&quot; then &quot;Yes&quot;&#13;&#10;    // logica nueva&#13;&#10;    elseif [fail_rate_owner]=&quot;Restaurant&quot; and [rm_id] in (26,32,27) then &quot;Yes&quot;&#13;&#10;    else &quot;No&quot;&#13;&#10;    end&#13;&#10;)&#13;&#10;else &quot;No&quot; &#13;&#10;end' />
      </column>
      <column caption='flag_dif_total_amt_nodisc' datatype='string' name='[Calculation_919015844287610881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [amount_no_discount]&lt;&gt;[total_amount] then &quot;Yes&quot; else &quot;No&quot; end' />
      </column>
      <column caption='% Rider/User incontactable' datatype='real' name='[Rider/User incontactable (copy)_1298444110858133515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1298444110844518406])/sum([Calculation_1298444110845902855])' />
      </column>
      <column caption='Cantidad Rider/User incontactable' datatype='integer' name='[Rider/User incontactable (copy)_1500543161446412289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; and&#13;&#10;([fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;) and&#13;&#10;([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;)&#13;&#10;and ([tools_description]=&quot;Repartidor incontactable&quot;&#13;&#10;or [tools_description]=&quot;No es posible contactar al cliente&quot;)&#13;&#10;then ( //devolución&#13;&#10;([order_id])&#13;&#10;)&#13;&#10;else null&#13;&#10;end)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='degasa_orders' datatype='table' name='[__tableau_internal_object_id__].[degasa_orders_D011E6B14111418E81991275BA2ED694]' role='measure' type='quantitative' />
      <column caption='Amount No Discount' datatype='real' name='[amount_no_discount]' role='measure' type='quantitative' />
      <column caption='Commission Amount' datatype='real' name='[commission_amount]' role='measure' type='quantitative' />
      <column caption='Delivery Status' datatype='string' name='[delivery_status]' role='dimension' type='nominal' />
      <column caption='devolución total' datatype='real' name='[devolución por rechazo (copy)_1298444110847127560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//criterios para devolución &#13;&#10;if [registered_date]&lt;DATEPARSE(&quot;yyyy-MM-dd&quot;, &quot;2021-11-01&quot;) then &#13;&#10;(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; &#13;&#10;and [fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;  //cambio sería incluido aqui&#13;&#10;and ([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;) &#13;&#10;then (&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end)  &#13;&#10;//fin caso antiguo&#13;&#10;//caso nuevo&#13;&#10;else &#13;&#10;//criterios para nueva devolución &#13;&#10;(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; &#13;&#10;and ([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;) &#13;&#10;and ([fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;  //cambio sería incluido aqui&#13;&#10;//26: Baja calidad del pedido&#13;&#10;//32: Error en los pedidos entregados &#13;&#10;//27: Pedido entregado tarde &#13;&#10;or ([fail_rate_owner]=&quot;Restaurant&quot; and [rm_id] in (26,32,27)) &#13;&#10;)&#13;&#10;then (&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end)&#13;&#10;end' />
      </column>
      <column caption='% devolución total' datatype='real' name='[devolución total (copy)_1298444110858764300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([devolución por rechazo (copy)_1298444110847127560])/sum([Calculation_1298444110845902855])' />
      </column>
      <column caption='devolución nueva' datatype='real' name='[devolución total (copy)_919015844368887815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//criterios para nueva devolución &#13;&#10;(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; &#13;&#10;and ([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;) &#13;&#10;and ([fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;  //cambio sería incluido aqui&#13;&#10;//26: Baja calidad del pedido&#13;&#10;//32: Error en los pedidos entregados &#13;&#10;//27: Pedido entregado tarde &#13;&#10;or ([fail_rate_owner]=&quot;Restaurant&quot; and [rm_id] in (26,32,27)) &#13;&#10;)&#13;&#10;then (&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end)' />
      </column>
      <column caption='devolución antigua' datatype='real' name='[devolución total (copy)_960955618292621312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//criterios para devolución &#13;&#10;//if [Registered Date]&lt;DATEPARSE(&quot;yyyy-MM-dd&quot;, &quot;2021-11-01&quot;) then &#13;&#10;(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; &#13;&#10;and [fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;  //cambio sería incluido aqui&#13;&#10;and ([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;) &#13;&#10;then (&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end)  &#13;&#10;//fin caso antiguo' />
      </column>
      <column caption='delta devolución' datatype='real' name='[devolución total nueva (copy)_919015844372717576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//criterios para devolución nueva (Delta)&#13;&#10;if ([order_status]&lt;&gt;&quot;CONFIRMED&quot; and &#13;&#10;[fail_rate_owner]=&quot;Restaurant&quot; and [rm_id] in (26,32,27)) &#13;&#10;then (&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end' />
      </column>
