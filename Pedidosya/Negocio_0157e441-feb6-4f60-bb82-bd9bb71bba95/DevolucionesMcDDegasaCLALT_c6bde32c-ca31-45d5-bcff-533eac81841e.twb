      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.001w0wo0i14e9016dgeh30qjrmzy].[sum:Calculation_1298444110751735808:qk]&quot;' value='Penalización' />
          <alias key='&quot;[federated.001w0wo0i14e9016dgeh30qjrmzy].[sum:return_value:qk]&quot;' value='Devolución' />
        </aliases>
      </column>
      <column caption='Mes' datatype='string' name='[Calculation_1062568082040078336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datename(&quot;month&quot;,[registered_date])' />
      </column>
      <column caption='devolución SV &amp; DP' datatype='real' name='[Calculation_1298444110751735808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([franchise_name]=&quot;Wendy&apos;s&quot; or [franchise_name]=&quot;KFC&quot; or&#13;&#10;[franchise_name]=&quot;China Wok&quot;) then &#13;&#10;[return_value]*0.25&#13;&#10;ELSEIF [franchise_name]=&quot;McDonald&apos;s&quot; then (&#13;&#10;if [case_reason_3]=&quot;Missing item&quot; then [return_value]*1&#13;&#10;elseif [case_reason_3]=&quot;Food quality&quot; then [return_value]*0.5&#13;&#10;ELSEIF [case_reason_3]=&quot;Wrong order&quot; then [return_value]*0.5&#13;&#10;ELSEIF [case_reason_3]=&quot;Wrong item&quot; then [return_value]*0.5&#13;&#10;else null end) //cases McD&#13;&#10;else null &#13;&#10;END' />
      </column>
      <column caption='delay_case' datatype='integer' name='[Calculation_1298444110772072449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&quot;day&quot;,[registered_date],[sf_created_date])' />
      </column>
      <column caption='row' datatype='integer' name='[Calculation_1298444110780829698]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Redimido?' datatype='string' name='[Calculation_1298444110799302659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [concepto]= &quot;Sorry Voucher&quot; then (&#13;&#10;if ISNULL([coupon_used_in_order]) = FALSE &#13;&#10;then &quot;Yes&quot;&#13;&#10;else &quot;No&quot;&#13;&#10;end)&#13;&#10;else &quot;No aplica&quot; end' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_715227931667750912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_id])' />
      </column>
      <column caption='data-up-to-sv' datatype='string' name='[Calculation_919015844362248198]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed: &quot;Data up to: &quot;+str(datename(&quot;month&quot;, max([registered_date])))&#13;&#10;+&quot; &quot;+str(datepart(&quot;day&quot;,max([registered_date])))&#13;&#10;+&quot;, &quot;+str(datepart(&quot;year&quot;,max([registered_date])))}' />
      </column>
