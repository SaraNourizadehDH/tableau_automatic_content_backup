    <worksheet name='Totales Detalle McD'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Detalle devoluciones</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mcd_orders (user_cristian_alvarez)' name='federated.0k0xeym138oa001fkw2ja058zra6' />
          </datasources>
          <datasource-dependencies datasource='federated.0k0xeym138oa001fkw2ja058zra6'>
            <column caption='lógica devolución McD' datatype='real' name='[Calculation_202662027579437056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [franchise_name]=&quot;McDonald&apos;s&quot; then (&#13;&#10;if [is_online_payment]=1 then &#13;&#10;//motivos pedidosya&#13;&#10;(if [rm_id] IN (4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36) &#13;&#10;then [amount_no_discount]-[commission_amount]&#13;&#10;//motivos compartidos&#13;&#10;elseif [rm_id] in (34,27,26) then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;//motivos mcdonalds&#13;&#10;elseif [rm_id] in (23,44,3,7,39,37,11,46,2,33,32,15,12,9) &#13;&#10;then 0 &#13;&#10;else null end)&#13;&#10;elseif [is_online_payment]=0 then &#13;&#10;//motivos pedidosya&#13;&#10;(if [rm_id] in (23,44,3,39,37,11,46,2,33,32,15,12,9,4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,34,27,26)&#13;&#10;then [amount_no_discount]&#13;&#10;//motivos mcdonalds&#13;&#10;ELSEIF [rm_id] in (7) then 0 &#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end //payment if&#13;&#10;) &#13;&#10;else null end //franchise if' />
            </column>
            <column caption='rm list' datatype='string' name='[Calculation_202662027591512065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [rm_id] in &#13;&#10;(4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,23,44,3,7,39,37,11,46,2,33,32,15,12,9,34,27,26)&#13;&#10;then &quot;In&quot;&#13;&#10;else &quot;Out&quot;&#13;&#10;end' />
            </column>
            <column caption='flag null/diff timestamp' datatype='string' name='[Calculation_202662027824799746]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//difference with existence dashboard&#13;&#10;if ISNULL([sent_to_vendor_at]) or ISNULL([vendor_accepted_at]) &#13;&#10;then &quot;Yes&quot;&#13;&#10;elseif [rejection_stage]=&quot;Before vendor-acceptance&quot; &#13;&#10;and &#13;&#10;(DATEDIFF(&quot;second&quot;,[vendor_accepted_at],[last_resp_date])=-1 &#13;&#10;or DATEDIFF(&quot;second&quot;,[vendor_accepted_at],[last_resp_date])=0)&#13;&#10;then &quot;Yes&quot; &#13;&#10;else &quot;No&quot; END' />
            </column>
            <column caption='Payment' datatype='string' name='[Calculation_202662027827310595]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [descriptionES]=&quot;Efectivo&quot; then &quot;Efectivo&quot;&#13;&#10;else &quot;Online&quot; &#13;&#10;end' />
            </column>
            <column caption='Comisión Facturable' datatype='real' name='[Calculation_919015844346548229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Motivos PeYa&#13;&#10;if [rm_id] in (4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36) &#13;&#10;and [is_online_payment]=1 &#13;&#10;then [commission_amount]&#13;&#10;//Copiado desde la Query SQL&#13;&#10;//Motivos mcdonalds&#13;&#10;ELSEIF [rm_id] in (23,44,3,7,39,37,11,46,2,33,32,15,12,9) &#13;&#10;and [is_online_payment]=1 then 0&#13;&#10;//Motivos compartidos&#13;&#10;ELSEIF [rm_id] in (34,27,26) and [is_online_payment]=1 &#13;&#10;then [commission_amount]*0.5&#13;&#10;//Pago efectivo&#13;&#10;ELSEIF [rm_id] in (7) and [is_online_payment]=0 then 0&#13;&#10;ELSEIF  [rm_id] in (23,44,3,39,37,11,46,2,33,32,15,12,9,4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,34,27,26)&#13;&#10;and [is_online_payment]=0 then [commission_amount]&#13;&#10;else null end' />
            </column>
            <column caption='Amount No Discount' datatype='real' name='[amount_no_discount]' role='measure' type='quantitative' />
            <column caption='Business Type Name' datatype='string' name='[business_type_name]' role='dimension' type='nominal' />
            <column caption='Commission Amount' datatype='real' name='[commission_amount]' role='measure' type='quantitative' />
            <column caption='Description ES' datatype='string' name='[descriptionES]' role='dimension' type='nominal' />
            <column caption='Franchise Name' datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Is Online Payment' datatype='integer' name='[is_online_payment]' role='dimension' type='ordinal' />
            <column datatype='datetime' name='[last_resp_date]' role='dimension' type='ordinal' />
            <column-instance column='[registered_date]' derivation='Month' name='[mn:registered_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_202662027591512065]' derivation='None' name='[none:Calculation_202662027591512065:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_202662027824799746]' derivation='None' name='[none:Calculation_202662027824799746:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_202662027827310595]' derivation='None' name='[none:Calculation_202662027827310595:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_type_name]' derivation='None' name='[none:business_type_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[partner_name]' derivation='None' name='[none:partner_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[rejection_stage]' derivation='None' name='[none:rejection_stage:nk]' pivot='key' type='nominal' />
            <column-instance column='[tools_description]' derivation='None' name='[none:tools_description:nk]' pivot='key' type='nominal' />
            <column caption='Partner Name' datatype='string' name='[partner_name]' role='dimension' type='nominal' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column caption='Rejection Stage' datatype='string' name='[rejection_stage]' role='dimension' type='nominal' />
            <column caption='Rm Id' datatype='integer' name='[rm_id]' role='dimension' type='ordinal' />
            <column caption='Sent To Vendor At' datatype='datetime' name='[sent_to_vendor_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_202662027579437056]' derivation='Sum' name='[sum:Calculation_202662027579437056:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_919015844346548229]' derivation='Sum' name='[sum:Calculation_919015844346548229:qk]' pivot='key' type='quantitative' />
            <column-instance column='[amount_no_discount]' derivation='Sum' name='[sum:amount_no_discount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[commission_amount]' derivation='Sum' name='[sum:commission_amount:qk]' pivot='key' type='quantitative' />
            <column caption='Tools Description' datatype='string' name='[tools_description]' role='dimension' type='nominal' />
            <column caption='Vendor Accepted At' datatype='datetime' name='[vendor_accepted_at]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0k0xeym138oa001fkw2ja058zra6].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
