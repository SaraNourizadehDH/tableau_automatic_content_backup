              <calculation class='tableau' formula='countd(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; and&#13;&#10;([fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;) and&#13;&#10;([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;)&#13;&#10;and ([tools_description]=&quot;Repartidor incontactable&quot;&#13;&#10;or [tools_description]=&quot;No es posible contactar al cliente&quot;)&#13;&#10;then ( //devolución&#13;&#10;([order_id])&#13;&#10;)&#13;&#10;else null&#13;&#10;end)' />
