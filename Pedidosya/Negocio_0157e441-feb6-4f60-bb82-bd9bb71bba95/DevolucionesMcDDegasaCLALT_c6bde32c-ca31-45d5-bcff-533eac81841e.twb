    <worksheet name='degasa'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Devoluciones mensual</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='degasa_orders (user_cristian_alvarez)' name='federated.081r57l05zfk4s1cun4t20igpb37' />
          </datasources>
          <datasource-dependencies datasource='federated.081r57l05zfk4s1cun4t20igpb37'>
            <column caption='frag-null-dates' datatype='string' name='[Calculation_1171780374843432960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([sent_to_vendor_at]) then &quot;Yes&quot; else &quot;No&quot; end' />
            </column>
            <column caption='Amount No Discount' datatype='real' name='[amount_no_discount]' role='measure' type='quantitative' />
            <column caption='Commission Amount' datatype='real' name='[commission_amount]' role='measure' type='quantitative' />
            <column caption='devolución total' datatype='real' name='[devolución por rechazo (copy)_1298444110847127560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//criterios para devolución &#13;&#10;if [registered_date]&lt;DATEPARSE(&quot;yyyy-MM-dd&quot;, &quot;2021-11-01&quot;) then &#13;&#10;(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; &#13;&#10;and [fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;  //cambio sería incluido aqui&#13;&#10;and ([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;) &#13;&#10;then (&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end)  &#13;&#10;//fin caso antiguo&#13;&#10;//caso nuevo&#13;&#10;else &#13;&#10;//criterios para nueva devolución &#13;&#10;(if [order_status]&lt;&gt;&quot;CONFIRMED&quot; &#13;&#10;and ([rejection_stage]=&quot;Before drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;After drop-off&quot; OR &#13;&#10;[rejection_stage]=&quot;Before pickup&quot;) &#13;&#10;and ([fail_rate_owner]&lt;&gt;&quot;Restaurant&quot;  //cambio sería incluido aqui&#13;&#10;//26: Baja calidad del pedido&#13;&#10;//32: Error en los pedidos entregados &#13;&#10;//27: Pedido entregado tarde &#13;&#10;or ([fail_rate_owner]=&quot;Restaurant&quot; and [rm_id] in (26,32,27)) &#13;&#10;)&#13;&#10;then (&#13;&#10;if [has_pickup]=&quot;Yes&quot; &#13;&#10;then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;elseif [has_pickup] =&quot;No&quot; &#13;&#10;then 0.57*([amount_no_discount]-[commission_amount])&#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end)&#13;&#10;end' />
            </column>
            <column caption='FR owner' datatype='string' name='[fail_rate_owner]' role='dimension' type='nominal' />
            <column datatype='string' name='[franchise_id]' role='dimension' type='nominal' />
            <column caption='Franchise Name' datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
            <column caption='Pickup' datatype='string' name='[has_pickup]' role='dimension' type='nominal' />
            <column-instance column='[registered_date]' derivation='Month' name='[mn:registered_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1171780374843432960]' derivation='None' name='[none:Calculation_1171780374843432960:nk]' pivot='key' type='nominal' />
            <column-instance column='[franchise_id]' derivation='None' name='[none:franchise_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[franchise_name]' derivation='None' name='[none:franchise_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[has_pickup]' derivation='None' name='[none:has_pickup:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:ok]' pivot='key' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column caption='Rejection Stage' datatype='string' name='[rejection_stage]' role='dimension' type='nominal' />
            <column caption='Rm Id' datatype='integer' name='[rm_id]' role='dimension' type='ordinal' />
            <column caption='Sent To Vendor At' datatype='datetime' name='[sent_to_vendor_at]' role='dimension' type='ordinal' />
            <column-instance column='[devolución por rechazo (copy)_1298444110847127560]' derivation='Sum' name='[sum:devolución por rechazo (copy)_1298444110847127560:qk]' pivot='key' type='quantitative' />
            <column-instance column='[registered_date]' derivation='Year' name='[yr:registered_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.081r57l05zfk4s1cun4t20igpb37].[mn:registered_date:ok]' filter-group='3'>
            <groupfilter from='4' function='range' level='[mn:registered_date:ok]' to='6' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
