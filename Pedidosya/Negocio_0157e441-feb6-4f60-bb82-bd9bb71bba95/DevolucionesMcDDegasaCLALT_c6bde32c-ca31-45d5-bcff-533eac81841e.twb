            <column-instance column='[amount_no_discount]' derivation='Sum' name='[sum:amount_no_discount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[commission_amount]' derivation='Sum' name='[sum:commission_amount:qk]' pivot='key' type='quantitative' />
