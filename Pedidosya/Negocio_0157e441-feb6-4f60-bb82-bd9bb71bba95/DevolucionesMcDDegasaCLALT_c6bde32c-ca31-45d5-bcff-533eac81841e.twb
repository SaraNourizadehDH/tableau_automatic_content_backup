    <worksheet name='rev null tstamp McD'>
      <table>
        <view>
          <datasources>
            <datasource caption='mcd_orders (user_cristian_alvarez)' name='federated.0k0xeym138oa001fkw2ja058zra6' />
          </datasources>
          <datasource-dependencies datasource='federated.0k0xeym138oa001fkw2ja058zra6'>
            <column caption='lógica devolución McD' datatype='real' name='[Calculation_202662027579437056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [franchise_name]=&quot;McDonald&apos;s&quot; then (&#13;&#10;if [is_online_payment]=1 then &#13;&#10;//motivos pedidosya&#13;&#10;(if [rm_id] IN (4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36) &#13;&#10;then [amount_no_discount]-[commission_amount]&#13;&#10;//motivos compartidos&#13;&#10;elseif [rm_id] in (34,27,26) then 0.5*([amount_no_discount]-[commission_amount])&#13;&#10;//motivos mcdonalds&#13;&#10;elseif [rm_id] in (23,44,3,7,39,37,11,46,2,33,32,15,12,9) &#13;&#10;then 0 &#13;&#10;else null end)&#13;&#10;elseif [is_online_payment]=0 then &#13;&#10;//motivos pedidosya&#13;&#10;(if [rm_id] in (23,44,3,39,37,11,46,2,33,32,15,12,9,4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,34,27,26)&#13;&#10;then [amount_no_discount]&#13;&#10;//motivos mcdonalds&#13;&#10;ELSEIF [rm_id] in (7) then 0 &#13;&#10;else null end&#13;&#10;)&#13;&#10;else null end //payment if&#13;&#10;) &#13;&#10;else null end //franchise if' />
            </column>
            <column caption='rm list' datatype='string' name='[Calculation_202662027591512065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [rm_id] in &#13;&#10;(4,16,1,17,40,42,29,19,38,20,28,18,31,30,35,25,36,23,44,3,7,39,37,11,46,2,33,32,15,12,9,34,27,26)&#13;&#10;then &quot;In&quot;&#13;&#10;else &quot;Out&quot;&#13;&#10;end' />
            </column>
            <column caption='flag null/diff timestamp' datatype='string' name='[Calculation_202662027824799746]' role='dimension' type='nominal'>
