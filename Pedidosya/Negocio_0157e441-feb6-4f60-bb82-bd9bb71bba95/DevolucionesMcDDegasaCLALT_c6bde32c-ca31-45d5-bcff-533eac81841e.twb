        <calculation class='tableau' formula='{fixed [partner_id]: &#13;&#10;min(DATEDIFF(&quot;day&quot;,date(today()),&#13;&#10;DATETRUNC(&quot;month&quot;,DATEADD(&quot;month&quot;,1,today()+1))-1))&#13;&#10;}' />
