      <column caption='WIS Drinks' datatype='real' name='[Calculation_1673087297732579359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([real_drinks])/sum([forecast_drinks])' />
      </column>
      <column caption='WIS Alimentacion' datatype='real' name='[Calculation_1673087297732657184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([real_ALIMENTACION])/sum([forecast_ALIMENTACION])' />
