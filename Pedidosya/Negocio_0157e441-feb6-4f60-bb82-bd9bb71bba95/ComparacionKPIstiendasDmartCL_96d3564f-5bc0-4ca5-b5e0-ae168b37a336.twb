      <column caption='Share Liquidacion Drinks' datatype='real' name='[Calculation_1520809337067991055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_LIQUIDACION_drinks])/sum([gfv_drinks])' />
