      <column caption='Share Liquidacion Bebestibles' datatype='real' name='[Calculation_1520809337068126224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_LIQUIDACION_bebestibles])/sum([gfv_bebestibles])' />
      </column>
      <column caption='Share Liquidacion Perecederos' datatype='real' name='[Calculation_1520809337068191761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_LIQUIDACION_perecederos])/sum([gfv_perecederos])' />
      </column>
      <column caption='Share Liquidacion Alimentacion' datatype='real' name='[Calculation_1520809337068257298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_LIQUIDACION_alimentacion])/sum([gfv_alimentacion])' />
      </column>
      <column caption='Share Liquidacion Non food' datatype='real' name='[Calculation_1520809337068318739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_LIQUIDACION_nonfood])/sum([gfv_nonfood])' />
      </column>
      <column caption='DOH' datatype='real' name='[Calculation_1520809337068412948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([stock_doh])/countd(IF ([stock_doh] = 0 AND [cogs_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL([stock_doh] )AND ISNULL([cogs_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END ))&#13;&#10;/&#13;&#10;(sum([cogs_doh])/countd(IF ([stock_doh] = 0 AND [cogs_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL([stock_doh] )AND ISNULL([cogs_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END ))' />
      </column>
      <column caption='AVG Stock' datatype='real' name='[Calculation_1520809337072603162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stock_doh])/countd(IF ([stock_doh] = 0 AND [cogs_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL([stock_doh] )AND ISNULL([cogs_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END )' />
      </column>
      <column caption='AVG Stock Drinks' datatype='real' name='[Calculation_1520809337072680987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stock_drinks_doh])/countd(IF (stock_drinks_doh = 0 AND [cogs_drinks_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL(stock_drinks_doh )AND ISNULL([cogs_drinks_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END )' />
      </column>
      <column caption='Voucher Share' datatype='real' name='[Calculation_1673087297727262720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([voucher_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='Bins share' datatype='real' name='[Calculation_1673087297727356929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([bins_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='Plus share' datatype='real' name='[Calculation_1673087297727418370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([plus_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='Vendor fail rate' datatype='real' name='[Calculation_1673087297727528963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_fail_rate_orders])/sum([total_orders])' />
      </column>
      <column caption='Assign time' datatype='real' name='[Calculation_1673087297727660036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([assign_time])/sum([orders_calc_tiempo])' />
      </column>
      <column caption='DT' datatype='real' name='[Calculation_1673087297727733765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([actual_delivery_time])/sum([orders_calc_tiempo])' />
      </column>
      <column caption='Orders&gt; 35&apos;' datatype='real' name='[Calculation_1673087297727791110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_35])/sum([confirmed_orders])' />
      </column>
      <column caption='Inaccuracy' datatype='real' name='[Calculation_1673087297727877127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([inacc_new]+[inacc_trust]+[inacc_untrust])/sum([trusted_orders]+[untrusted_orders]+[newbie_orders])' />
      </column>
      <column caption='Inaccuracy Newbie' datatype='real' name='[Calculation_1673087297728094216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([inacc_new])/sum([newbie_orders])' />
      </column>
      <column caption='Inaccuracy Trusted' datatype='real' name='[Calculation_1673087297728151561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([inacc_trust])/sum([trusted_orders])' />
      </column>
      <column caption='Inaccuracy Unstrusted' datatype='real' name='[Calculation_1673087297728208906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([inacc_untrust])/sum([untrusted_orders])' />
      </column>
      <column caption='Partial orders' datatype='real' name='[Calculation_1673087297728372747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([partial_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='Seamless orders' datatype='real' name='[Calculation_1673087297728430092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([seamless_orders])/sum([total_orders_seamless])' />
      </column>
      <column caption='Share units discount' datatype='real' name='[Calculation_1673087297728577549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([units_discount])/sum([units])' />
      </column>
      <column caption='Avg unit price' datatype='real' name='[Calculation_1673087297728638990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv])/sum([units])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1673087297728700431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv])/sum([orders_ventas])' />
      </column>
      <column caption='Front margin' datatype='real' name='[Calculation_1673087297728856081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(sum([cogs])/sum(gfv))' />
      </column>
      <column caption='Front Drinks' datatype='real' name='[Calculation_1673087297730322450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(sum([cogs_drinks])/sum([gfv_drinks]))' />
