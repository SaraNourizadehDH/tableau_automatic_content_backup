      <column caption='Front Alimentacion' datatype='real' name='[Calculation_1673087297730486292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(sum([cogs_alimentacion])/sum([gfv_alimentacion]))' />
