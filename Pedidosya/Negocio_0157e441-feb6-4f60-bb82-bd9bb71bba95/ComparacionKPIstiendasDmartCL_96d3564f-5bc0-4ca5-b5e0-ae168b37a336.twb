      <column caption='AFV Drinks' datatype='real' name='[Calculation_1673087297731964952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_drinks])/sum([orders_drinks])' />
      </column>
      <column caption='AFV Bebestibles' datatype='real' name='[Calculation_1673087297732128793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_bebestibles])/sum([orders_bebestibles])' />
      </column>
      <column caption='AFV Alimentacion' datatype='real' name='[Calculation_1673087297732186138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_alimentacion])/sum([orders_alimentacion])' />
      </column>
      <column caption='AFV Perecederos' datatype='real' name='[Calculation_1673087297732247579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_perecederos])/sum([orders_perecederos])' />
      </column>
      <column caption='AFV Non food' datatype='real' name='[Calculation_1673087297732321308]' role='measure' type='quantitative'>
