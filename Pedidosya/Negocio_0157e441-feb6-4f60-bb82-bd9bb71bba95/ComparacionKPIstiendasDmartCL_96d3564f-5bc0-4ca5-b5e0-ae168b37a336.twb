      <column caption='WIS Bebestibles top50' datatype='real' name='[Calculation_1673087297733034022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([real_BEBESTIBLES50])/sum([forecast_BEBESTIBLES50])' />
      </column>
      <column caption='WIS Perecederos top50' datatype='real' name='[Calculation_1673087297733115943]' role='measure' type='quantitative'>
