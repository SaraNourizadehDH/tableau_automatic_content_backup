        <calculation class='tableau' formula='sum([gfv_apt_perecederos])/sum([gfv_perecederos])' />
      </column>
      <column caption='Share APT Non food' datatype='real' name='[Calculation_1520809337067913230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_apt_nonfood])/sum([gfv_nonfood])' />
