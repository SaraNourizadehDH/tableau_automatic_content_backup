      </column>
      <column caption='WIS Non food top50' datatype='real' name='[Calculation_1673087297733242920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([real_NONFOOD50])/sum([forecast_NONFOOD50])' />
      </column>
      <column caption='CVR3' datatype='real' name='[Calculation_1673087297770770474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([unique_orders])/sum([sessions])' />
      </column>
      <column caption='Perdida Add Cart' datatype='real' name='[Calculation_1673087297770868779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions_shop_detail]-[sessions_add_cart])/sum([sessions_shop_detail])' />
      </column>
      <column caption='Perdida Checkout' datatype='real' name='[Calculation_1673087297771147308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions_add_cart]-[sessions_checkout])/sum([sessions_shop_detail])' />
      </column>
      <column caption='Perdida Transaction' datatype='real' name='[Calculation_1673087297771249709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions_checkout]-[sessions_transaction])/sum([sessions_shop_detail])' />
      </column>
      <column caption='Merma' datatype='real' name='[Calculation_1673087297771794478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Amount_shrinkage])/sum([gfv])' />
      </column>
      <column caption='Merma Drinks' datatype='real' name='[Calculation_1673087297771872303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Amount_shrinkage_drinks])/sum([gfv_drinks])' />
      </column>
      <column caption='Merma Bebestible' datatype='real' name='[Calculation_1673087297771982896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Amount_shrinkage_bebestibles])/sum([gfv_bebestibles])' />
      </column>
      <column caption='Merma Alimentacion' datatype='real' name='[Calculation_1673087297772040241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Amount_shrinkage_alimentacion])/sum([gfv_alimentacion])' />
      </column>
      <column caption='Merma Perecederos' datatype='real' name='[Calculation_1673087297772101682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Amount_shrinkage_perecederos])/sum([gfv_perecederos])' />
      </column>
      <column caption='Merma Non food' datatype='real' name='[Calculation_1673087297772175411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Amount_shrinkage_nonfood])/sum([gfv_nonfood])' />
      </column>
      <column caption='UTR+' datatype='real' name='[Calculation_1673087297772363828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([picking_units])+sum([receiving_units]))/sum([total_working_hours])' />
      </column>
      <column caption='Picker heads' datatype='real' name='[Calculation_1673087297773142069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(picker_working_hours)/(countd([registered_date])*6.2857142)' />
      </column>
      <column caption='Manager heads' datatype='real' name='[Calculation_1673087297773232182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([manager_working_hours])/(countd([registered_date])*6.2857142)' />
      </column>
      <column caption='Working/Planned hours' datatype='real' name='[Calculation_1673087297773912119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_working_hours])/sum([total_planned_hours])' />
      </column>
      <column caption='Penetracion ordenes' datatype='real' name='[Calculation_1673087297774325816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders])/sum([ordenes_radio])' />
      </column>
      <column caption='Penetracion Market' datatype='real' name='[Calculation_1673087297774403641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([market_confirmed_orders])/sum([ordenes_market_radio])' />
      </column>
      <column caption='Share sesiones' datatype='real' name='[Calculation_1673087297774469178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions])/sum([sesiones_radio])' />
      </column>
      <column caption='% Acquisitions Bins' datatype='real' name='[Calculation_1673087297774911547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions_bins])/sum([acquisitions])' />
      </column>
      <column caption='% Acquisitions Vouchers' datatype='real' name='[Calculation_1673087297774981180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions_vouchers])/sum([acquisitions])' />
      </column>
      <column caption='Rating' datatype='real' name='[Calculation_1673087297775042621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_partner_rating])/sum([respuestas_rating])' />
      </column>
      <column caption='Basket Size' datatype='real' name='[Calculation_1673087297776537662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([units])/sum([confirmed_orders])' />
      </column>
      <column caption='Daily Orders' datatype='real' name='[Calculation_1673087297777774655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders])/&#13;&#10;(countd(IF [confirmed_orders]&gt;0 then [registered_date] else null end)*countd([warehouse_id]))' />
      </column>
      <column caption='Share venta Drinks' datatype='real' name='[Calculation_1673087297778274368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_drinks])/sum([gfv])' />
      </column>
      <column caption='Share venta Bebestibles' datatype='real' name='[Calculation_1673087297778344001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_bebestibles])/sum([gfv])' />
      </column>
      <column caption='Share venta Alimentacion' datatype='real' name='[Calculation_1673087297778405442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_alimentacion])/sum([gfv])' />
      </column>
      <column caption='Share venta Perecederos' datatype='real' name='[Calculation_1673087297778462787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_perecederos])/sum([gfv])' />
      </column>
      <column caption='Share venta Non food' datatype='real' name='[Calculation_1673087297778573381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_nonfood])/sum([gfv])' />
      </column>
      <column caption='Stacking %' datatype='real' name='[Calculation_1673087297780232263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_stacking])/sum([confirmed_orders])' />
      </column>
      <column caption='% Discounts' datatype='real' name='[Calculation_1673087297780359240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([discount])/sum([gfv]+[discount])' />
      </column>
      <column caption='Blank row' datatype='integer' name='[Calculation_1673087297787748430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if false then 0 else null end' />
      </column>
      <column caption='Daily Sessions' datatype='real' name='[Calculation_1673087297793290324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions])/(countd([registered_date])*countd([warehouse_id]))' />
      </column>
      <column caption='fecha' datatype='date' name='[Calculation_1673087297794629719]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='date(DATETRUNC([Parameters].[Parámetro 1], [registered_date]))' />
      </column>
      <column caption='last' datatype='integer' name='[Calculation_1673087297795985498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='last()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monto ST+PO' datatype='real' name='[Calculation_1929792479914823680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([store_transfer_amount])+sum([purchase_orders_amount])' />
      </column>
      <column caption='%Acquisitions sobre oportunidad (Solo a nivel mes)' datatype='real' name='[Calculation_2190438309439295488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions])/avg({ FIXED [warehouse_id],[registered_date]:avg([activos_no_dmart])})' />
      </column>
      <column caption='Share ACQ vouchers - Compensation' datatype='real' name='[Calculation_2190438309442658305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([compensation_voucher_acquisitions])/sum([acquisitions_vouchers])' />
      </column>
      <column caption='% Voucher share - Compensations ' datatype='real' name='[Calculation_2190438309443493891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([compensation_voucher_orders])/sum([voucher_orders])' />
      </column>
      <column caption='Amount Inaccuracy sobre venta' datatype='real' name='[Calculation_2190438309444321285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([inaccuracy_amount])/sum([gfv])' />
      </column>
      <column caption='Inaccuracy W&amp;M Item' datatype='real' name='[Calculation_2190438309455077385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([wrong_item_inacc])+sum([missing_item_inacc]))/sum([confirmed_orders])' />
      </column>
      <column caption='CVR3 Market &amp; Drinks en Zona (Excl. Dmart)' datatype='real' name='[Calculation_2190438309460381708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sesiones_radio_transaction_market_drinks])/sum([sesiones_radio_shop_detail_market_drinks])' />
      </column>
      <column caption='Share Plus Zona' datatype='real' name='[Calculation_2190438310123110415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ordenes_plus_radio])/sum([ordenes_radio])' />
