    <worksheet name='Por fecha'>
      <table>
        <view>
          <datasources>
            <datasource caption='nuevo_kpis_tiendas (user_camilo_zelada)' name='federated.0arskis1pfxf65110b6qk1g2k3rq' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Date parameter' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;iso-week&quot;'>
              <calculation class='tableau' formula='&quot;iso-week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;year&quot;' value='Year' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0arskis1pfxf65110b6qk1g2k3rq'>
            <column caption='% Acquisitions ILD' datatype='real' name='[% Acquisitions Vouchers (copia)_1520809337067032582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions_ild])/sum([acquisitions])' />
            </column>
            <column caption='% Voucher share - QCO' datatype='real' name='[% Voucher share - Compensations  (copia)_2190438309443624964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qco_voucher_orders])/sum([voucher_orders])' />
            </column>
            <column caption='AVG Stock Perecederos' datatype='real' name='[AVG Stock Alimentacion (copia)_1520809337073020957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stock_perecederos_doh])/countd(IF ([stock_perecederos_doh] = 0 AND [cogs_perecederos_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL([stock_perecederos_doh] )AND ISNULL([cogs_perecederos_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END )' />
            </column>
            <column caption='AVG Stock Non food' datatype='real' name='[AVG Stock Bebestibles (copia)_1520809337073311775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stock_nonfood_doh])/countd(IF ([stock_nonfood_doh] = 0 AND [cogs_nonfood_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL([stock_nonfood_doh] )AND ISNULL([cogs_nonfood_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END )' />
            </column>
            <column caption='AVG Stock Alimentacion' datatype='real' name='[AVG Stock Drinks (copia)_1520809337072910364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stock_alimentacion_doh])/countd(IF ([stock_alimentacion_doh] = 0 AND [cogs_alimentacion_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL([stock_alimentacion_doh] )AND ISNULL([cogs_alimentacion_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END )' />
            </column>
            <column caption='AVG Stock Bebestibles' datatype='real' name='[AVG Stock Perecederos (copia)_1520809337073205278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stock_bebestibles_doh])/countd(IF ([stock_bebestibles_doh] = 0 AND [cogs_bebestibles_doh] = 0) THEN null&#13;&#10;    ELSEIF  (ISNULL([stock_bebestibles_doh] )AND ISNULL([cogs_bebestibles_doh])) THEN null&#13;&#10;    ELSE [registered_date]  END )' />
            </column>
            <column caption='Amount Inaccuracy sobre venta - W&amp;M item ' datatype='real' name='[Amount Inaccuracy sobre venta (copia)_2190438309444460550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([wrong_item_inacc_amount])+sum([missing_item_inacc_amount]))/sum([gfv])' />
            </column>
            <column caption='Amount Inaccuracy sobre venta - Product quality' datatype='real' name='[Amount Inaccuracy sobre venta - W&amp;M item  (copia)_2190438309444857863]' role='measure' type='quantitative'>
