            <column caption='Slowmovers' datatype='real' default-format='p0.00%' name='[Calculation_1375849701734309890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([total_slowmovers])/SUM([store_qty]))+(SUM([total_zeromovers])/SUM([store_qty])))&#13;&#10;/((SUM([avg_available_skus_slowmovers])/SUM([store_qty])))' />
            </column>
            <column caption='Is Complete Month' datatype='integer' name='[Calculation_1375849701739425796]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;,[month_date],[Calculation_1375849701739806725])=1&#13;&#10;    THEN 1 &#13;&#10;ELSEIF DATEDIFF(&apos;month&apos;,[month_date],[Calculation_1375849701739806725])=13&#13;&#10;    THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_1375849701739806725]' role='dimension' type='ordinal'>
