          <relation connection='cloudfile:googledrive-excel-direct.0mggeos00xkfcw1gad9jw1svblqd' name='OKRs Targets --&gt; updated1' table='[&apos;OKRs Targets --&gt; updated$&apos;]' type='table'>
            <columns gridOrigin='A1:AQ169:no:A1:AQ169:0' header='yes' outcome='2'>
