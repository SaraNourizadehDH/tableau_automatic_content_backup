  <worksheets>
    <worksheet name='CountryKPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='main_okr' name='federated.0rbsnre181wygd14cqe0f1ndv92y' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='AFV Gross' caption='KPI' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;22&quot;'>
              <calculation class='tableau' formula='&quot;22&quot;' />
              <aliases>
                <alias key='&quot;11&quot;' value='Number of operating stores' />
                <alias key='&quot;12&quot;' value='Dmart GMV share in PeYa' />
                <alias key='&quot;13&quot;' value='Confirmed Orders' />
                <alias key='&quot;15&quot;' value='Active Customers' />
                <alias key='&quot;16&quot;' value='Frequency' />
                <alias key='&quot;17&quot;' value='Sessions' />
                <alias key='&quot;18&quot;' value='User Acquisition' />
                <alias key='&quot;19&quot;' value='Retention Rate' />
                <alias key='&quot;20&quot;' value='Acquisition Retention Rate' />
