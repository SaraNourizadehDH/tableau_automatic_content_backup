            <column datatype='real' name='[EBITDA + Rent excl. NRV &amp; IC Comm. (OKRs - Manual data --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column datatype='real' name='[EBITDA + Rent excl. NRV &amp; IC Comm. (OKRs - Manual data --&gt; updated)]' role='measure' type='quantitative' />
