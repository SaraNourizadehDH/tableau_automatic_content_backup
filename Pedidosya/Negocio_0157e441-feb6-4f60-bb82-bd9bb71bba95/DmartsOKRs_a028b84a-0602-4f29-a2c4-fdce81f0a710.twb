            <relation connection='cloudfile:googledrive-excel-direct.0mggeos00xkfcw1gad9jw1svblqd' name='OKRs - Manual data --&gt; updated Latam' table='[&apos;OKRs - Manual data --&gt; updated$&apos;]' type='table'>
