      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_5DD4E7354FEC41E083EC4FD1B9CB83B6'>
            <properties context=''>
              <relation join='left' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='IF ISNULL([main_BQ].[country_id])=FALSE THEN TRUE ELSE FALSE END' />
                      <expression op='IF [OKRs Targets --&gt; updated1].[country_code]=&apos;LATAM&apos; THEN TRUE ELSE NULL END' />
                    </expression>
                    <expression op='='>
                      <expression op='[main_BQ].[month_date]' />
                      <expression op='[OKRs Targets --&gt; updated1].[Month]' />
                    </expression>
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='AND'>
                      <expression op='='>
                        <expression op='IF ISNULL([main_BQ].[country_id])=FALSE THEN TRUE ELSE FALSE END' />
                        <expression op='IF [OKRs - Manual data --&gt; updated Latam].[country_code]=&apos;LATAM&apos; THEN TRUE ELSE NULL END' />
                      </expression>
                      <expression op='='>
                        <expression op='[main_BQ].[month_date]' />
                        <expression op='[OKRs - Manual data --&gt; updated Latam].[Month]' />
                      </expression>
                    </expression>
                  </clause>
                  <relation join='left' type='join'>
                    <clause type='join'>
                      <expression op='AND'>
                        <expression op='='>
                          <expression op='[main_BQ].[country_id]' />
                          <expression op='[OKRs - Manual data --&gt; updated].[country_id]' />
                        </expression>
                        <expression op='='>
                          <expression op='[main_BQ].[month_date]' />
                          <expression op='[OKRs - Manual data --&gt; updated].[Month]' />
                        </expression>
                      </expression>
                    </clause>
                    <relation join='left' type='join'>
                      <clause type='join'>
                        <expression op='AND'>
                          <expression op='='>
                            <expression op='[main_BQ].[month_date]' />
                            <expression op='[OKRs Targets --&gt; updated].[Month]' />
                          </expression>
                          <expression op='='>
                            <expression op='[main_BQ].[country_id]' />
                            <expression op='[OKRs Targets --&gt; updated].[country_id]' />
                          </expression>
                        </expression>
                      </clause>
                      <relation connection='bigquery.1qocz640gzz5jc1e6ic2602drm9c' name='main_BQ' type='text'><![CDATA[WITH 

	dates AS (
		SELECT 
			DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH),INTERVAL -12 MONTH )AS start_date,
			DATE(CURRENT_DATE()) AS end_date,
	),
	orders AS (
			SELECT 
                DATE_TRUNC(o.registered_date,MONTH) AS month_date,
				o.country_id,
				c.country_name,
                COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' THEN  o.order_id else NULL END) AS confirmed_orders,
                COUNT(DISTINCT CASE WHEN o.order_status <<>> 'CONFIRMED' THEN  o.order_id else NULL END) AS non_confirmed_orders,
				COUNT(DISTINCT CASE WHEN o.order_status <<>> 'CONFIRMED' AND o.fail_rate_owner = 'Restaurant' THEN o.order_id else NULL END) AS non_confirmed_orders_restaurant,
                COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' AND o.is_pre_order=TRUE AND (EXTRACT(HOUR FROM o.registered_at) BETWEEN 18 AND 23) THEN o.order_id else NULL END) AS confirmed_preorder_18_24,
                COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' AND (EXTRACT(HOUR FROM o.registered_at) BETWEEN 18 AND 23) THEN o.order_id else NULL END) AS confirmed_orders_18_24,
                COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' THEN o.restaurant.id ELSE NULL END) AS active_partners,
                COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' THEN pd.warehouse_id ELSE NULL END) AS active_warehouses,
				COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' THEN o.customer_id ELSE NULL END) AS active_customers,
            --    COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' THEN o.customer_id ELSE NULL END) AS aquisitions,
                COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' AND o.business_type_id<<>>2 THEN  o.order_id else NULL END) AS confirmed_orders_non_market,
				SUM((CASE WHEN o.order_status = 'CONFIRMED' THEN o.total_amount_with_delivery_costs END)/ce.rate_eu) AS confirmed_gmv_net,
				SUM((CASE WHEN o.order_status = 'CONFIRMED' THEN (o.total_amount_with_delivery_costs ) + IFNULL(o.discount_paid_by_company,0)END)/ce.rate_eu) AS confirmed_gmv_gross,
                COUNT(DISTINCT CASE WHEN o.order_status = 'CONFIRMED' THEN dto.order_id ELSE null END) as orders_with_discount,
                SUM((CASE WHEN o.order_status = 'CONFIRMED' THEN items.product_quantity ELSE NULL END)) as confirmed_product_quantity
			
			FROM `peya-bi-tools-pro.il_core.fact_orders` as o
            LEFT JOIN (
                SELECT o.order_id, SUM(det.quantity) AS product_quantity
			    FROM `peya-bi-tools-pro.il_core.fact_orders`AS o
			    LEFT JOIN UNNEST(details) det
                WHERE o.registered_date>>= (SELECT start_date FROM dates) 
			      AND o.registered_date << (SELECT end_date FROM dates)
                GROUP BY 1
                ) as items  ON items.order_id = o.order_id
            LEFT JOIN (
                SELECT distinct
                    DATE_TRUNC(do.registered_date, MONTH) month
                    ,do.order_id
                FROM  `peya-markets.automated_tables_reports.discounts_orders` do
                LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` o
                    ON o.order_id = do.order_id
                WHERE TRUE
                AND do.discount_type NOT LIKE "%proxy%"
                AND o.registered_date BETWEEN (SELECT start_date FROM dates) AND (SELECT end_date FROM dates)
                AND do.order_id not in (SELECT order_id_to_be_excluded FROM `peya-markets.automated_tables_reports.dim_order_problems` )
                GROUP BY 1,2
                ) as dto on dto.order_id = o.order_id  
            INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` AS pd 
                ON o.restaurant.id=pd.partner_id
                AND pd.business_type_id not in (1,7)
			LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` c ON c.country_id = o.country_id AND c.active 
			LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce ON ce.currency_id = c.currency_id AND DATE_TRUNC(o.registered_date,MONTH) = ce.currency_exchange_date
            WHERE o.registered_date>>= (SELECT start_date FROM dates) 
			AND o.registered_date << (SELECT end_date FROM dates)
			GROUP BY 1,2,3
	),	
    orders_total AS (
			SELECT 
                DATE_TRUNC(o.registered_date,MONTH) AS month_date,
				o.country_id,
				SUM((CASE WHEN o.order_status = 'CONFIRMED' THEN o.total_amount_with_delivery_costs END)/ce.rate_eu) AS confirmed_gmv_net_total,
				SUM((CASE WHEN o.order_status = 'CONFIRMED' THEN (o.total_amount_with_delivery_costs ) + IFNULL(o.discount_paid_by_company,0)END)/ce.rate_eu) AS confirmed_gmv_gross_total,
			
			FROM `peya-bi-tools-pro.il_core.fact_orders` as o
			LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` c ON c.country_id = o.country_id AND c.active 
			LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce ON ce.currency_id = c.currency_id AND DATE_TRUNC(o.registered_date,MONTH) = ce.currency_exchange_date
            WHERE o.registered_date>>= (SELECT start_date FROM dates) 
			AND o.registered_date << (SELECT end_date FROM dates)
			GROUP BY 1,2
	),
    orders_latam AS (
			SELECT 
                DATE_TRUNC(o.registered_date,MONTH) AS month_date,
				SUM((CASE WHEN o.order_status = 'CONFIRMED' THEN o.total_amount_with_delivery_costs END)/ce.rate_eu) AS confirmed_gmv_net_total,
				SUM((CASE WHEN o.order_status = 'CONFIRMED' THEN (o.total_amount_with_delivery_costs ) + IFNULL(o.discount_paid_by_company,0)END)/ce.rate_eu) AS confirmed_gmv_gross_total,
			
			FROM `peya-bi-tools-pro.il_core.fact_orders` as o
			LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` c ON c.country_id = o.country_id AND c.active 
			LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce ON ce.currency_id = c.currency_id AND DATE_TRUNC(o.registered_date,MONTH) = ce.currency_exchange_date
            WHERE o.registered_date>>= (SELECT start_date FROM dates) 
			AND o.registered_date << (SELECT end_date FROM dates)
            AND o.country_id IN(1,2,3,7,13,15,16,17,18,19,20,21,22)
			GROUP BY 1
	),
    
    logistics AS (
        WITH delivery_time AS (
            SELECT 
            DATE_TRUNC(l.created_date_local,MONTH) AS month_date,
            l.country.country_id,
            COUNT(DISTINCT CASE WHEN UPPER(l.order_status) = 'COMPLETED' AND l.is_preorder=FALSE THEN l.order_id END) AS completed_orders_not_preorder,
            COUNT(DISTINCT CASE WHEN UPPER(l.order_status) = 'COMPLETED' AND l.is_preorder=FALSE AND pd.is_partner_dt=TRUE THEN l.order_id END) AS completed_orders_not_preorder_dt_15,
            COUNT(DISTINCT CASE WHEN l.timings.vendor_late >> 300 AND UPPER(l.order_status) = 'COMPLETED' AND l.is_preorder=FALSE THEN l.order_id END) AS vendor_late_5,
            COUNT(DISTINCT CASE WHEN l.timings.vendor_late is not null AND UPPER(l.order_status) = 'COMPLETED' AND l.is_preorder=FALSE THEN l.order_id END) AS vendor_late_base,
            COALESCE(SUM(CASE WHEN UPPER(l.order_status) = 'COMPLETED' AND l.is_preorder = FALSE THEN l.timings.actual_delivery_time END),0)/60 AS delivery_time_min,
            COUNT(DISTINCT CASE WHEN UPPER(l.order_status) = 'COMPLETED' AND l.is_preorder = FALSE AND l.timings.actual_delivery_time>>2700 THEN l.order_id END) AS delivery_time_greater_45, 
            COUNT(DISTINCT CASE WHEN UPPER(l.order_status) = 'COMPLETED' AND l.is_preorder = FALSE AND l.timings.actual_delivery_time<<900 
                AND pd.is_partner_dt=TRUE THEN l.order_id END) AS delivery_time_less_15
            FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` AS l
            INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` AS pd 
                ON pd.partner_id = l.peya_partner_id
                AND pd.business_type_id not in (1,7)
            WHERE l.created_date_local>>= (SELECT start_date FROM dates) 
                AND l.created_date_local << (SELECT end_date FROM dates)

            GROUP BY 1,2    
        )
        , handoff_prep_time AS (
            SELECT 
            DATE_TRUNC(date, MONTH) AS month_date,
            country_id,
            SUM(logistics_non_preorder_completed_orders) AS logistics_non_preorder_completed_orders,
            SUM(dmart_prep_time) AS dmart_prep_time,
            SUM(handoff_time) AS handoff_time
            FROM (
                    SELECT 
                    DATE_TRUNC(orders.created_date_local,DAY) AS date
                    ,c.country_id
                    ,pd.partner_id
                    ,DATE_TRUNC(o.registered_at,HOUR) registered_at
                    ,COUNT(DISTINCT CASE WHEN UPPER(orders.order_status) = 'COMPLETED' AND orders.is_preorder = FALSE THEN orders.order_id ELSE NULL END) AS logistics_non_preorder_completed_orders
                    /** prep time **/
                    ,SUM(CASE WHEN UPPER(orders.order_status) = 'COMPLETED' and o.is_pre_order = FALSE THEN CAST(DATETIME_DIFF(x.ready_for_pickup,IFNULL(x.unassigned,x.wms_transmission_received_by_wms), SECOND)AS NUMERIC) END) /60 as dmart_prep_time
                    /** handoff time **/
                    ,SUM(CASE WHEN UPPER(orders.order_status) = 'COMPLETED' and o.is_pre_order = FALSE AND x.picked_up << x.rider_near_pickup THEN 0 
                            WHEN UPPER(orders.order_status) = 'COMPLETED' and o.is_pre_order = FALSE AND x.rider_near_pickup <<= x.ready_for_pickup THEN CAST(DATETIME_DIFF(x.picked_up,x.ready_for_pickup, SECOND)AS NUMERIC) /60
                            WHEN UPPER(orders.order_status) = 'COMPLETED' and o.is_pre_order = FALSE AND x.rider_near_pickup >> x.ready_for_pickup THEN CAST(DATETIME_DIFF(x.picked_up,x.rider_near_pickup, SECOND)AS NUMERIC)/60 
                            ELSE 0 END) as handoff_time
                
                    FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` AS orders
                    ,UNNEST(deliveries) del 

                    INNER JOIN  (
                                SELECT 
                                    o.restaurant.id AS restaurant_id
                                    ,o.registered_date
                                    ,o.is_pre_order
                                    ,o.order_id
                                    ,o.registered_at
                                FROM `peya-bi-tools-pro.il_core.fact_orders` o
                                INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` p 
                                    ON p.partner_id = o.restaurant.id
                                    AND p.business_type_id not in (1,7)
                                WHERE o.registered_date>>= (SELECT start_date FROM dates) 
                                AND o.registered_date << (SELECT end_date FROM dates)
                                ) o ON orders.peya_order_id = o.order_id
                    
                    INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` AS pd 
                        ON pd.partner_id = o.restaurant_id
                        AND pd.business_type_id not in (1,7)
                    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` c ON orders.country_code = c.country_short_name AND c.active
                    LEFT JOIN (
                        SELECT 
                            o.order_id
                            ,MAX(CASE WHEN poe.event = 'WMS_TRANSMISSION_RECEIVED_BY_WMS' THEN DATETIME (poe.created_at, c.timezone) END) as wms_transmission_received_by_wms
                            ,MAX(CASE WHEN poe.event = 'UNASSIGNED' THEN DATETIME (poe.created_at, c.timezone) END) as unassigned
                            ,MAX(CASE WHEN poe.event = 'ASSIGNED' THEN DATETIME (poe.created_at, c.timezone) END) as assigned
                            ,MAX(CASE WHEN poe.event = 'STARTED' THEN DATETIME (poe.created_at, c.timezone) END) as started
                            ,MAX(CASE WHEN poe.event = 'READY_FOR_CHECKOUT' THEN DATETIME (poe.created_at, c.timezone) END) as ready_for_checkout
                            ,MAX(CASE WHEN poe.event = 'CHECKOUT_VALIDATION' THEN DATETIME (poe.created_at, c.timezone) END) as checkout_validation
                            ,MAX(CASE WHEN poe.event = 'CHECKOUT_CONFIRMED' THEN DATETIME (poe.created_at, c.timezone) END) as checkout_confirmed
                            ,MAX(CASE WHEN poe.event = 'READY_FOR_PICKUP' THEN DATETIME (poe.created_at, c.timezone) END) as ready_for_pickup
                            ,MAX(CASE WHEN poe.event = 'RIDER_NEAR_PICKUP' THEN DATETIME (poe.created_at, c.timezone) END) as rider_near_pickup
                            ,MAX(CASE WHEN poe.event = 'PICKED_UP' THEN DATETIME (poe.created_at, c.timezone) END) as picked_up
                        FROM `peya-bi-tools-pro.il_core.fact_orders` o
                        -- INNER JOIN partners p ON o.restaurant.id=p.partner_id
                        INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` AS pd 
                            ON pd.partner_id = o.restaurant.id
                            AND pd.business_type_id not in (1,7)
                        INNER JOIN `peya-bi-tools-pro.il_core.dim_country` c ON c.country_id = o.country_id and c.active
                        LEFT JOIN `peya-data-origins-pro.cl_pelican.orders` po ON o.order_id=SAFE_CAST(PO.external_id AS NUMERIC) AND DATE(o.registered_date) = DATE(DATETIME (po.placed_at, c.timezone))
                        LEFT JOIN `peya-bi-tools-pro.il_logistics.fact_logistic_orders` lo ON o.order_id=lo.peya_order_id
                        LEFT JOIN `peya-data-origins-pro.cl_pelican.order_events` poe ON po.id=poe.order_id
                        WHERE o.registered_date >>= (SELECT start_date FROM dates) 
                        AND o.registered_date << (SELECT end_date FROM dates)
                        GROUP BY 1) x
                            ON x.order_id = orders.peya_order_id
                    WHERE DATE(o.registered_date)>>= (SELECT start_date FROM dates) 
                        AND DATE(o.registered_date) << (SELECT end_date FROM dates)
                        AND orders.created_date_local>>= (SELECT start_date FROM dates) 
                        AND orders.created_date_local << (SELECT end_date FROM dates)
                        AND del.is_primary 
                    GROUP BY 1,2,3,4
            )
            GROUP BY 1,2
        )

        SELECT 
        DT.month_date,
        DT.country_id,
        DT.completed_orders_not_preorder,
        DT.completed_orders_not_preorder_dt_15,
        DT.vendor_late_5,
        DT.vendor_late_base,
        DT.delivery_time_min,
        DT.delivery_time_greater_45, 
        DT.delivery_time_less_15,
        HPT.logistics_non_preorder_completed_orders,
        HPT.dmart_prep_time,
        HPT.handoff_time
        FROM delivery_time DT
        LEFT JOIN handoff_prep_time HPT
        ON  DT.month_date = HPT.month_date
        AND DT.country_id = HPT.country_id
    ),
    nps AS (
			SELECT
				DATE_TRUNC(DATE(q.start_date),MONTH) AS month_date,
				q.country_id,
				COUNT(DISTINCT q.response_id) AS nps_responses,
                COUNT(DISTINCT CASE WHEN q.nps_group = 'Promoter' THEN q.response_id END) AS nps_promoters,
                COUNT(DISTINCT CASE WHEN q.nps_group = 'Detractor' THEN q.response_id END) AS nps_detractors,
                COUNT(DISTINCT CASE WHEN q.nps_group = 'Passive' THEN q.response_id END) AS nps_passives,

			FROM `peya-bi-tools-pro.il_nps.fact_qualtrics` AS q
			INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` AS pd 
                ON pd.partner_id = q.partner_id
                AND pd.business_type_id not in (1,7)
			WHERE  DATE(q.start_date)>>= (SELECT start_date FROM dates) 
			AND  DATE(q.start_date) << (SELECT end_date FROM dates) 				
			AND q.nps_type = 'NPS AO' 
			GROUP BY 1,2
	),
    sessions AS (
		SELECT
			DATE_TRUNC(s.date,MONTH) AS month_date,
			pd.country_id,                     
			SUM(s.sessions) as sessions,
			SUM(s.unique_orders) as sessions_unique_orders,
		FROM `peya-data-origins-pro.cl_sessions.export_fact_sessions_by_restaurant_daily` s
		INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` AS pd 
            ON pd.partner_id = s.restaurant_id
            AND pd.business_type_id not in (1,7)
		WHERE DATE(s.date)>>= (SELECT start_date FROM dates) 
			AND DATE(s.date) << (SELECT end_date FROM dates)
			GROUP BY 1,2
	),
    partial AS (
		SELECT 
			DATE_TRUNC(o.order_placed_localtime_at,MONTH) AS month_date,
			c.country_id,
			COUNT(DISTINCT CASE WHEN o.qty_ordered>>o.qty_delivered THEN order_id ELSE NULL END) AS partial_orders,
			COUNT(DISTINCT o.order_id) AS partial_orders_base

		FROM `peya-data-origins-pro.cl_dmarts.customer_orders`  AS o
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(o.country_code)=c.country_code
		WHERE DATE(order_placed_localtime_at)>>= (SELECT start_date FROM dates) 
		AND DATE(order_placed_localtime_at)<< (SELECT end_date FROM dates)
		AND UPPER(order_status)='SENT'
		AND is_dmart=TRUE
		GROUP BY 1,2
    ),
	reorder AS( 
		WITH customers_monthly AS (
						SELECT
								DATE_TRUNC(o.registered_date,MONTH) AS month_date,
								o.country_id,
								o.customer_id,
						FROM `peya-bi-tools-pro.il_core.fact_orders` AS o 
						INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` AS pd
                            ON o.restaurant.id=pd.partner_id
                            AND pd.business_type_id not in (1,7)
						WHERE o.registered_date>>= (SELECT start_date FROM dates) - 62
						AND DATE(o.registered_date)<< (SELECT end_date FROM dates)
						AND o.order_status='CONFIRMED'
						GROUP BY 1,2,3
    			),
			customer_base AS (
						SELECT 
							DATE_ADD(c.month_date,INTERVAL +1 MONTH) AS month_date,
							c.country_id,  
							COUNT(DISTINCT c.customer_id) AS customers_reorder_base   
					FROM customers_monthly AS c
					GROUP BY 1,2
					),
			customer_reorders AS(
						SELECT 
							c.month_date,
							c.country_id,
							COUNT(DISTINCT c2.customer_id) AS  customers_reorder       
					FROM customers_monthly AS c
					LEFT JOIN customers_monthly AS c2 ON c.customer_id=c2.customer_id AND c.month_date=DATE_ADD(c2.month_date,INTERVAL +1 MONTH)
					GROUP BY 1,2
					)
			SELECT 
							cb.month_date,
							cb.country_id,
							cb.customers_reorder_base,
							cr.customers_reorder      
			FROM customer_base AS cb
			LEFT JOIN customer_reorders AS cr ON cb.month_date=cr.month_date AND cb.country_id=cr.country_id
			GROUP BY 1,2,3,4
	),
    contact_rate AS (select distinct 
             date_trunc(registered_date, month) as month_date
             ,o.country_id
             ,count (distinct case_number) as Contacts
            
             from peya-bi-tools-pro.il_core.fact_orders o 

             left join (select distinct
                    date(DATETIME(sc.Create_Date)) AS full_date
                   , country_id
                   , safe_cast(sc.case_order_id as int) as case_order_id
                   , sc.case_number

                    FROM peya-bi-tools-pro.il_salesforce.fact_salesforce_cases as sc
                  
                    WHERE date (Create_Date) 
                      >>= (SELECT start_date FROM dates) 
                      and date (Create_Date) << (SELECT end_date FROM dates)    
                     
                     and (sc.case_subjec NOT LIKE '%NDC |%' 
                         OR sc.case_subjec NOT LIKE '%No country%' OR sc.case_subjec 
                         NOT LIKE '%restaurant portal%')    
                     and sc.Country_name != 'Colombia'
                     and sc.case_origin IN ('Email', 'Helpcenter','Social Media','Chat') 
                     and record_type_name = 'PY Inbound Case' 
                     and sc.case_type =  'Customer'
                     and Case_Reason_Level_1 = 'Post-Delivery'
                     ) sc
                    
             on case_order_id = o.order_id 

            inner join `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` as dm
                on dm.partner_id = o.restaurant.id
                AND dm.business_type_id not in (1,7)

       WHERE date (registered_date) >>= (SELECT start_date FROM dates)  
       and date(registered_date) <<  (SELECT end_date FROM dates)
       and business_type_name not in ('Restaurant','Courier','Courier Business')  
       and warehouse_id is not null    
       GROUP BY 1,2),
	 users_with_adoption AS(       
        SELECT    
                month_date
            ,   country_id
            ,   count(distinct CASE WHEN groceries = 1 AND gro_orders_3_months >>= 3 THEN customer_id ELSE null END) as users_adoption
        FROM (
            SELECT  date_trunc(o.registered_date, month) as month_date
                , o.country_id
                , o.customer_id as customer_id
                , MAX(CASE WHEN o.business_type_id not in (1,7,9,11) THEN 1 ELSE 0 END) as groceries
                , count(distinct gro_orders) as gro_orders_3_months
            FROM `peya-bi-tools-pro.il_core.fact_orders` as o
            LEFT JOIN 
                (
                SELECT o.customer_id as customer_id
                    , o.country_id
                    , o.order_id as gro_orders
                    , o.registered_date
                FROM  `peya-bi-tools-pro.il_core.fact_orders` as o
                INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` as dpd
                    ON o.restaurant.id = dpd.partner_id
                    AND dpd.business_type_id not in (1,7)
                WHERE o.registered_date >>= (SELECT start_date FROM dates)
                    AND o.confirmed_order = 1
                GROUP BY 1,2,3,4
                ) g on g.customer_id = o.customer_id 
                    AND g.country_id = o.country_id
                    AND g.registered_date >>= date_sub(date_trunc(o.registered_date, month), interval 2 month) 
                    AND date_trunc(g.registered_date, month) <<= date_trunc(o.registered_date, month)
            INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` as dpd
                    ON o.restaurant.id = dpd.partner_id
                    AND dpd.business_type_id not in (1,7)            
            WHERE o.registered_date >>= (SELECT start_date FROM dates)
                AND o.confirmed_order = 1         
            GROUP BY 1,2,3
            )
        GROUP BY 1,2
        ),
        acquisitions AS (
		WITH 
						first_order AS(
                SELECT 
					o.registered_date,
					o.order_id,
					o.country_id,
					o.customer_id,
                    date_add(date_trunc(date(registered_date), month), interval 1 month) as reorder_month,
                    ROW_NUMBER() OVER ( PARTITION BY o.customer_id ORDER BY o.registered_date asc) AS order_rank

				FROM `peya-bi-tools-pro.il_core.fact_orders` AS o
				INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` 
                       AS pd ON o.restaurant.id=pd.partner_id
                       AND pd.business_type_id not in (1,7)
				WHERE o.registered_date >>= DATE('2020-01-01')
				    AND o.order_status='CONFIRMED'
				GROUP BY 1,2,3,4
			    )
           
           , month_orders AS (
                SELECT distinct
                    customer_id,
                    o.registered_date,
                    o.order_id,
                    date_trunc(o.registered_date, month) as order_month
                FROM `peya-bi-tools-pro.il_core.fact_orders`  as o
				INNER JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` 
                       AS pd ON o.restaurant.id=pd.partner_id
                       AND pd.business_type_id not in (1,7)
                WHERE o.registered_date >>= (SELECT start_date FROM dates)  
                    AND o.registered_date << (SELECT end_date FROM dates) 
                    AND o.confirmed_order = 1                
                ) 
			
        SELECT *
        , LAG(monthly_acquisitions) OVER(PARTITION BY country_id ORDER BY country_id asc, month_date asc) as acquisitions_previous_month
        , LAG(acquisitions_with_reorder) OVER(PARTITION BY country_id ORDER BY country_id asc, month_date asc) as acquisitions_previous_month_with_reorder
        FROM( 
            SELECT 
                DATE_TRUNC(o.registered_date, MONTH) AS month_date,
                o.country_id,
                COUNT(DISTINCT o.customer_id) AS monthly_acquisitions,
                COUNT(DISTINCT CASE WHEN mo.order_month = o.reorder_month THEN o.customer_id ELSE null END) as acquisitions_with_reorder
            FROM first_order AS o
            LEFT JOIN month_orders AS mo
                ON mo.customer_id = o.customer_id
                AND mo.order_id != o.order_id
            WHERE o.order_rank=1
                AND o.registered_date >>= (SELECT start_date FROM dates) 
                AND DATE(o.registered_date)<< (SELECT end_date FROM dates)
            GROUP BY 1,2
        )
	),
    
    store_age AS(
        SELECT
            warehouse_id,
            store_name,
            DATE_DIFF(CURRENT_DATE(), MIN(order_date), DAY) as age_in_days
        FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level`
        GROUP BY 1,2
    ),
	purchase AS(
		SELECT 
			DATE_TRUNC(pp.created_localtime_at,MONTH) AS month_date, 
			c.country_id,
			SUM(CASE WHEN po.order_status='done' AND pp.quantity_ordered<<3000 THEN pp.quantity_ordered ELSE NULL END) AS quantity_ordered,
			SUM(CASE WHEN po.order_status='done' AND pp.quantity_ordered<<3000 THEN pp.quantity_delivered ELSE NULL END) AS quantity_delivered,			

		FROM `peya-data-origins-pro.cl_dmarts.purchase_orders` AS po,
		  UNNEST(products_purchased) AS pp
		LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(po.country_code)=c.country_code
		WHERE DATE(pp.created_localtime_at) >>= (SELECT start_date FROM dates) 
		AND DATE(pp.created_localtime_at)<< (SELECT end_date FROM dates)
		GROUP BY 1,2
	),
	sales_items AS(
		SELECT 
			DATE_TRUNC(co.order_placed_localtime_at,MONTH) AS month_date,
			c.country_id,
			SUM(i.value_euro.total_price_paid_net_eur) AS sales_eur_shrinkage, 
			SUM(i.value_euro.cogs_eur) AS cogs_eur, 
     
    
		FROM `peya-data-origins-pro.cl_dmarts.customer_orders` AS co, 
		UNNEST(items) AS i 
		LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(co.country_code)=c.country_code
		WHERE DATE(co.order_placed_localtime_at) >>= (SELECT start_date FROM dates) 
		AND DATE(co.order_placed_localtime_at)<< (SELECT end_date FROM dates)
		AND is_dmart=true 
		GROUP BY 1,2
	),
    sales AS(
        SELECT
            DATE_TRUNC(co.order_date,MONTH) AS month_date,
            c.country_id,
            SUM((paid_unit_price_eur*fulfilled_quantity)-vat_amount_eur-(pcm_discount_amount_lc*(SAFE_DIVIDE(total_amount_sold_net_eur,total_amount_sold_net_lc))/(1+vat_eur))) as sales_eur_shrinkage,
            SUM(total_cogs_sold_net_eur) as cogs_eur
        FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level` AS co
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(co.country_code)=c.country_code
        WHERE DATE(co.order_date) >>= (SELECT start_date FROM dates) 
		AND DATE(co.order_date)<< (SELECT end_date FROM dates)
        GROUP BY 1,2
    ),
	expired_items AS(
		-- SELECT 
		-- 	DATE_TRUNC(s.date_localtime_at,MONTH) AS month_date,
		-- 	c.country_id,
		-- 	sum(sd.quantity*sd.wac_eur) AS expired_eur_shrinkage
		-- FROM `peya-data-origins-pro.cl_dmarts.stock_movement` AS s, 
		-- UNNEST(stock_movement_data) AS sd 
		-- LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(s.country_code)=c.country_code
		-- WHERE (s.date_localtime_at)  >>= (SELECT start_date FROM dates) 
		-- AND DATE(s.date_localtime_at)<< (SELECT end_date FROM dates)
		-- AND sd.is_expired=true 
		-- GROUP BY 1,2
	       SELECT
            DATE_TRUNC(transaction_date, MONTH) AS month_date,
            c.country_id,
            SUM(
            CASE WHEN CONTAINS_SUBSTR(adjustment_reason,"expi") THEN adjustment_value_eur*(-1)
                WHEN adjustment_reason = "Supplier Return" AND d.country_code IN ("ar","uy") THEN adjustment_value_eur*(-1)
                WHEN  adjustment_reason="Store Damaged"  AND warehouse_id IN ( "9e268d3a-07b9-46a8-bb9a-76ca28d4b796",
                                                                                "6865e9eb-aa2d-4899-92cf-947411fbaf6c",
                                                                                "17586917-760d-42fa-bcbc-ddb7a1438520")
                                                                                THEN adjustment_value_eur*(-1)
                WHEN CONTAINS_SUBSTR(adjustment_reason,"Internal Vendor") AND d.country_code ="ar" THEN adjustment_value_eur*(-1)
                ELSE NULL END) expired_scloss_damage_eur_shrinkage
            FROM `peya-datamarts-pro.dm_dmarts.dmarts_stock_adjustments` d
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` c
            ON d.country_code = lower(c.country_code)
            WHERE transaction_date >>= (SELECT start_date FROM dates)
            AND transaction_date << (SELECT end_date FROM dates)
            GROUP BY 1,2
    
    ),

	doh_venta AS(
		SELECT
			order_date as fecha,
			sku_id as sku,
			warehouse_id,
			SUM(total_cogs_sold_net_eur) as cogs_eur
		FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level`
		WHERE order_date  >>= (SELECT start_date FROM dates) 
		AND order_date << (SELECT end_date FROM dates)
                AND sku_id not in ("56624216","49904139","49904140","KOXQP3","53533659","56624215","62223987","49904137","54031444","54031442","54031446","54031445","54031449","54031447","54031451")
                AND warehouse_id <<>> 'f513328f-7a59-4be3-8b2e-3724d6894dcb'
		GROUP BY 1,2,3
	),

	doh_base_skus AS (
		SELECT 
			c.country_id,
			inv.date_local as fecha,
			inv.warehouse_id,
			inv.sku_id as sku,
			inv.stock_value_end_of_day_eod_eur	 AS stock_eur,
			venta.cogs_eur
		FROM `peya-datamarts-pro.dm_dmarts.dmarts_inventory` inv
		LEFT JOIN doh_venta AS venta ON inv.sku_id=venta.sku AND inv.warehouse_id=venta.warehouse_id AND inv.date_local=venta.fecha
		LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(inv.country_code)=c.country_code
		WHERE date_local >>= (SELECT start_date FROM dates) 
		AND date_local << (SELECT end_date FROM dates)
                AND inv.sku_id not in ("56624216","49904139","49904140","KOXQP3","53533659","56624215","62223987","49904137","54031444","54031442","54031446","54031445","54031449","54031447","54031451")
                AND inv.warehouse_id <<>> 'f513328f-7a59-4be3-8b2e-3724d6894dcb'
	),

	doh AS(
		SELECT 
			DATE_TRUNC(b.fecha,MONTH) AS month_date,
			b.country_id,
			ROUND(SAFE_DIVIDE(SUM(b.stock_eur),sum(b.cogs_eur)),2) AS days_on_hand,
			SUM(b.stock_eur) AS doh_stock_eur,
			sum(b.cogs_eur) AS doh_sales_eur
		FROM doh_base_skus AS b
		GROUP BY 1,2

	),
    sku_day AS(
            SELECT
                DATE_TRUNC(order_placed_localtime_at,DAY) AS full_date,
                C.warehouse.warehouse_id AS warehouse_id, 
                items.sku AS sku,
                sum(items.qty_delivered) AS qty_delivered
            FROM  `peya-data-origins-pro.cl_dmarts.customer_orders` AS C,
            UNNEST(items) AS items
            WHERE DATE(order_placed_localtime_at)>>=(SELECT start_date FROM dates)-45
            AND DATE(order_placed_localtime_at)<<(SELECT end_date FROM dates)
            AND is_dmart=true           
            GROUP BY 1,2,3
    ),
    dates_top500 AS(
        SELECT 
            DISTINCT DATE_TRUNC(d.date, MONTH) -1 AS last_day_month
        FROM `peya-bi-tools-pro.il_core.dim_date` AS d
        WHERE d.date>>=(SELECT start_date FROM dates)
        AND d.date<<(SELECT end_date FROM dates)
        UNION ALL 
        SELECT 
             MAX(d.date) AS last_day_month
        FROM `peya-bi-tools-pro.il_core.dim_date` AS d
        WHERE d.date>>=(SELECT start_date FROM dates)
        AND d.date<<(SELECT end_date FROM dates)
    ),
    sku_acum AS(
        SELECT 
            d.last_day_month,
            s.warehouse_id,
            s.sku,
            SUM(s.qty_delivered) AS qty_delivered,
            ROW_NUMBER() OVER (PARTITION BY s.warehouse_id, d.last_day_month ORDER BY SUM(s.qty_delivered) DESC) AS contador,
        FROM dates_top500 AS d
        JOIN sku_day AS s ON d.last_day_month>>=s.full_date AND DATE_ADD(d.last_day_month, INTERVAL -45 DAY)<<=s.full_date 
        GROUP BY 1,2,3
    ),
    top_500 AS(
        SELECT 
            DATE_TRUNC(s.last_day_month, MONTH) AS date_month,
            s.warehouse_id,
            s.sku,
        FROM sku_acum AS s
        WHERE s.contador<<=500
    ),
    base_skus AS (
        SELECT 
            t.date_month,
            c.country_id,
            inv.date_local as fecha,
            inv.warehouse_id,
            inv.sku_id as sku,
            IF(stock_end_of_day>>sales_buffer,1,0) AS check_instock,
            md.status,
        FROM `peya-datamarts-pro.dm_dmarts.dmarts_inventory` inv
        LEFT JOIN `peya-delivery-and-support.automated_tables_reports.Dmarts_offline_assortment_masterdata` md ON inv.sku_id=md.sku AND inv.warehouse_id=md.warehouse_id AND FORMAT_DATETIME("%b-%Y", inv.date_local)=md.mmmyyyy
        INNER JOIN top_500 AS t ON inv.sku_id=t.sku AND inv.warehouse_id=t.warehouse_id AND t.date_month=DATE_TRUNC(inv.date_local,MONTH)
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(inv.country_code)=c.country_code
        LEFT JOIN store_age AS sa ON inv.warehouse_id=sa.warehouse_id
        WHERE date_local >>= (SELECT start_date FROM dates)-45
        AND (sa.age_in_days<<>>0 OR (sa.age_in_days=0 AND sa.store_name='AR_90_CD_Argentina'))
    ),
	instock500 AS(
		SELECT
			country_id,
			b.date_month AS month_date,
			ROUND(SAFE_DIVIDE(sum(check_instock),count(check_instock)),4) as instock_top_500,
			sum(check_instock) as instock_sum,
			count(check_instock) as instock_count
		FROM base_skus AS b
        WHERE status IN ("ACTIVE","Active","ACTIVE ") 
        GROUP BY 1,2
	),
    slowmovers AS (
      SELECT
          DATE_TRUNC(last_day_month, MONTH) as month_date
        , c.country_id
        , sm.country_code
        , COUNT(DISTINCT if(Type_SM="SM",SKU_WH_ID,null)) as total_slowmovers
        , COUNT(DISTINCT store_name) as store_qty
        , COUNT(DISTINCT if(Type_SM="ZM",SKU_WH_ID,null)) as total_zeromovers
        , sum(avg_is) as avg_available_skus_slowmovers

      FROM  `peya-delivery-and-support.automated_tables_reports.dmarts_slowmovers_regional` sm

      LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` c 
        ON sm.country_code = c.country_short_name

      WHERE sm.Level_2 <<>> "Apparel / Footwear / Sports equipment" 

      GROUP BY 1,2,3
    ),
    listed_sku  AS (WITH 
        base_skus AS (
            
            SELECT * EXCEPT (CONTADOR)
            FROM
                (SELECT
                row_number() over (partition by inv.date_local,inv.warehouse_id,inv.sku_id) AS CONTADOR,
                inv.country_name,
                c.country_id,
                inv.date_local as fecha,
                inv.store_name,
                inv.warehouse_id,
                inv.sku_id as sku,
                inv.product_name,
                inv.stock_end_of_day AS stock_un,
                inv.stock_value_end_of_day_eod_eur	 AS stock_eur,
                IF(stock_end_of_day>>sales_buffer,1,0) AS check_instock,
                FROM `peya-datamarts-pro.dm_dmarts.dmarts_inventory` inv
                LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(inv.country_code)=c.country_code
                WHERE date_local >>= (SELECT start_date FROM dates) 
		        AND date_local << (SELECT end_date FROM dates))
            WHERE CONTADOR=1),

        store_age AS(
                SELECT
                        warehouse_id,
                        DATE_DIFF(CURRENT_DATE(), MIN(order_date), DAY) as age_in_days,
                        MIN(order_date) as launch_date,
                FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level`
                GROUP BY 1),

        warehouses_multiverticalidad AS(
            SELECT DISTINCT
            warehouse_id,
            real.im_warehouse_name as warehouse_name_multiverticalidad,
            warehouse_id_multiverticalidad
            FROM `peya-data-origins-pro.cl_dmarts.warehouses` W
            LEFT JOIN
                (SELECT DISTINCT
                platform_vendor_id,
                im_warehouse_name,
                warehouse_id as warehouse_id_multiverticalidad
                FROM `peya-data-origins-pro.cl_dmarts.warehouses` 
                WHERE is_dmart AND is_migrated=false) real
            ON W.platform_vendor_id=real.platform_vendor_id
            WHERE is_dmart),

        days_of_month AS (
            SELECT 
            month,
            country_name as pais,
            country_id,
            count(fecha) as total_days_in_month
            FROM
                (SELECT DISTINCT
                date_trunc(date_local,month) as month,
                c.country_id, 
                inv.country_name,
                date_local as fecha
                FROM `peya-datamarts-pro.dm_dmarts.dmarts_inventory` AS inv
                LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(inv.country_code)=c.country_code
                WHERE date_local >>= (SELECT start_date FROM dates) 
		        AND date_local << (SELECT end_date FROM dates))
            GROUP BY 1,2,3),

        base_completa_skus AS(
            SELECT * EXCEPT (CONTADOR)
            FROM
                (SELECT
                row_number() over (partition by base_skus.fecha,warehouses_multiverticalidad.warehouse_id_multiverticalidad, base_skus.sku order by base_skus.check_instock desc) AS CONTADOR,
                base_skus.country_name,
                base_skus.country_id,
                base_skus.fecha,
                base_skus.warehouse_id,
                warehouses_multiverticalidad.warehouse_name_multiverticalidad as store_name,
                warehouses_multiverticalidad.warehouse_id_multiverticalidad,
                base_skus.sku,
                base_skus.product_name,
                base_skus.stock_un,
                base_skus.stock_eur,
                base_skus.check_instock,
                IF(fecha<<launch_date,True,
                    IF(date_trunc(fecha,month)=date_trunc(launch_date,month),True,
                        IF(date_trunc(fecha,month)=date_trunc(launch_date+31,month),True,False))) as launched_recently,
                store_age.age_in_days,

                FROM base_skus
                LEFT JOIN warehouses_multiverticalidad ON base_skus.warehouse_id=warehouses_multiverticalidad.warehouse_id
                LEFT JOIN store_age ON warehouses_multiverticalidad.warehouse_id=store_age.warehouse_id)
            WHERE CONTADOR=1),

        avg_skus_per_store AS(
            SELECT
            b.country_id,
            date_trunc(fecha,month) as month,
            store_name,
            ROUND(SAFE_DIVIDE(SUM(check_instock),AVG(total_days_in_month)),0) as avg_total_available_skus
            FROM base_completa_skus AS b
            LEFT JOIN days_of_month ON date_trunc(b.fecha,month)=days_of_month.month AND b.country_name=days_of_month.pais
            WHERE launched_recently=False
            AND (b.age_in_days<<>>0)
            AND NOT(store_name='UY_2_Pocitos' AND month>>'2021-02-01')
            AND NOT(store_name='UY_3_Carrasco' AND month>>='2021-09-01')
            AND NOT(store_name='PE_3_PuntaHermosa' AND month>>='2021-05-01')
            AND NOT(store_name='EC_1_ElBatan' AND month>>='2021-05-01' AND month<<='2021-06-01')
            AND NOT(store_name='CH_2_Providencia' AND month>>='2021-01-01' AND month<<='2021-05-01')
            AND NOT(store_name='AR_64_Rosario_Centro')
            AND NOT(store_name='AR_22_Tandil')		
            AND NOT(store_name='AR_30_Mdq_Alvarado' AND month>>='2021-06-01' AND month<<='2021-08-01')

            GROUP BY 1,2,3)

        SELECT 
        country_id,
        month AS month_date,
		COUNT(DISTINCT store_name) AS stores_available_skus,
        COUNT(DISTINCT CASE WHEN avg_total_available_skus>>=3000 THEN store_name ELSE NULL END) AS store_3000_sku,
        ROUND(avg(avg_total_available_skus),0) as avg_total_available_skus
        FROM avg_skus_per_store
        GROUP BY 1,2
    ),
    inventory_accuracy AS(
        SELECT 
            DATE_TRUNC(DATE(cc.batch_completed_at_ts), MONTH) AS month_date,
            c.country_id,
            COUNT(DISTINCT CONCAT(batch_id,product_id)) AS inventory_accuracy_base,
            COUNT(DISTINCT CASE WHEN picker_recounted IS NULL AND picker_additional_recount IS NULL AND picker_counted=on_hand_qty THEN CONCAT(batch_id,product_id)
                            WHEN picker_recounted IS NOT NULL  AND picker_additional_recount IS NULL AND picker_recounted=on_hand_qty THEN CONCAT(batch_id,product_id)
                            WHEN picker_additional_recount IS NOT NULL AND picker_additional_recount=on_hand_qty THEN CONCAT(batch_id,product_id)
                            ELSE NULL END) AS inventory_accuracy_num

        FROM `peya-data-origins-pro.cl_dmarts.cycle_count` AS cc
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON UPPER(cc.country_code)=c.country_code
        WHERE DATE(cc.batch_completed_at_ts)>>=(SELECT start_date FROM dates)
        AND DATE(cc.batch_completed_at_ts)<<(SELECT end_date FROM dates)
        AND status='COMPLETED'
        GROUP BY 1,2
    ),
ultra_fresh AS (
    WITH PIM AS (
    SELECT DISTINCT
    sku, 
    country_code,
    piece_barcode,
    P.Level_0,
    k.Level_1,
    k.Level_2,
    k.Level_3
    FROM `peya-food-and-groceries.automated_tables_reports.skus_PIM_Dmart` k
    LEFT JOIN `peya-argentina.automated_tables_reports.PIM_Level_0_Bis` P
    ON p.Level_1 = k.Level_1
    )

    SELECT  
    DATE_TRUNC(order_date, MONTH) as month_date,
    c.country_id,
    /*SUM(CASE WHEN p.Level_0 = 'Ultra Fresh' THEN total_amount_net_with_discount_lc/rate_eu 
    ELSE NULL END) AS ultra_fresh_net_sales_eur,
    SUM(total_amount_net_with_discount_lc/rate_eu) as net_sales_eur*/
     ROUND(SUM(CASE WHEN (p.Level_0 = 'Ultra Fresh' OR p.Level_0 = 'Fresh') THEN ((total_amount_sold_net_lc) - (pcm_discount_amount_lc)/(1+vat_pct)) ELSE null END),2) as   fresh_ultrafresh_gfv,
    ROUND(SUM((total_amount_sold_net_lc) - ((pcm_discount_amount_lc)/(1+vat_pct))),2) as gfv
    FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level` o
    LEFT JOIN `peya-data-origins-stg.cl_gcc_service.dmarts_warehouses` s
        ON s.platform_vendor_id = o.vendor_id
    LEFT JOIN PIM  p
        ON p.piece_barcode = o.barcode
        AND LOWER(TRIM(p.country_code)) = LOWER(TRIM(o.country_code))
    LEFT JOIN `peya-argentina.automated_tables_reports.PIM_Level_0` l
        ON l.Level_1_Bis = p.Level_1
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS c 
        ON c.country_short_name = s.country_code AND c.active =true AND o.country_code = c.country_short_name
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` exc 
        ON exc.currency_id= c.currency_id and DATE_TRUNC(order_date, MONTH) = date_trunc(date(currency_exchange_date),month)
    WHERE order_date >>= (SELECT start_date FROM dates) 
    AND order_date << (SELECT end_date FROM dates)
    AND (order_status IN ('sent', 'unknown') or order_status IS NULL)
    AND s.is_dmart = true               
    GROUP BY 1,2
),

instock_weight as ( 
    SELECT
        month_date,
        country_id,
        sum(instock*forecastrelex) as numeradorWIS,
        sum(forecastrelex) as denominadorWIS,
    FROM `peya-delivery-and-support.automated_tables_reports.dmarts_supply_chain_skureport` as d
    LEFT JOIN  `peya-bi-tools-pro.il_core.dim_country` as c
        ON c.country_short_name = d.country_code
    WHERE month_date >>= (SELECT start_date FROM dates) 
        AND month_date << (SELECT end_date FROM dates)
        AND status="ACTIVE" 
        AND launched="Launched"
    GROUP BY 1,2
)


        
SELECT
o.*,
ot.confirmed_gmv_gross_total,
ot.confirmed_gmv_net_total,
ott.confirmed_gmv_gross_total AS confirmed_gmv_gross_all_countries,
ott.confirmed_gmv_net_total AS confirmed_gmv_net_all_countries,
l.completed_orders_not_preorder,
l.completed_orders_not_preorder_dt_15,
l.vendor_late_5,
l.vendor_late_base,
l.delivery_time_min,
l.delivery_time_greater_45,
l.delivery_time_less_15,
l.logistics_non_preorder_completed_orders,
l.dmart_prep_time,
l.handoff_time,
nps.nps_responses,
nps.nps_promoters,
nps.nps_detractors,
nps.nps_passives,
s.sessions,
s.sessions_unique_orders,
p.partial_orders,
p.partial_orders_base,
r.customers_reorder_base,
r.customers_reorder,
a.monthly_acquisitions,
a.acquisitions_with_reorder,
a.acquisitions_previous_month,
a.acquisitions_previous_month_with_reorder,
cr.Contacts,
au.users_adoption,
c.audi_load_date,
pu.quantity_ordered,
pu.quantity_delivered,
sa.sales_eur_shrinkage,
sa.cogs_eur,
CASE WHEN ei.country_id = 19 THEN NULL ELSE ei.expired_scloss_damage_eur_shrinkage END AS expired_scloss_damage_eur_shrinkage,
doh.days_on_hand,
doh.doh_stock_eur,
doh.doh_sales_eur,
it.instock_top_500,
it.instock_sum,
it.instock_count,
sw.store_qty,
sw.total_slowmovers,
sw.total_zeromovers,
sw.avg_available_skus_slowmovers,
ls.avg_total_available_skus,
ls.store_3000_sku,
ls.stores_available_skus,
ia.inventory_accuracy_base,
ia.inventory_accuracy_num,
uf.fresh_ultrafresh_gfv,
uf.gfv,
iw.numeradorWIS,
iw.denominadorWIS

FROM orders AS o
LEFT JOIN orders_total AS ot ON o.month_date=ot.month_date AND o.country_id=ot.country_id
LEFT JOIN orders_latam AS ott ON o.month_date=ott.month_date 
LEFT JOIN logistics AS l ON o.month_date=l.month_date AND o.country_id=l.country_id
LEFT JOIN nps AS nps ON o.month_date=nps.month_date AND o.country_id=nps.country_id
LEFT JOIN sessions AS s ON o.month_date=s.month_date AND o.country_id=s.country_id
LEFT JOIN partial AS p ON o.month_date=p.month_date AND o.country_id=p.country_id
LEFT JOIN reorder AS r ON o.month_date=r.month_date AND o.country_id=r.country_id
LEFT JOIN acquisitions AS a ON o.month_date=a.month_date AND o.country_id=a.country_id
LEFT JOIN users_with_adoption AS au ON o.month_date=au.month_date AND o.country_id=au.country_id
LEFT JOIN contact_rate AS cr ON o.month_date=cr.month_date AND o.country_id=cr.country_id
LEFT JOIN purchase AS pu ON o.month_date=pu.month_date AND o.country_id=pu.country_id 
LEFT JOIN sales AS sa ON o.month_date=sa.month_date AND o.country_id=sa.country_id 
LEFT JOIN expired_items AS ei ON o.month_date=ei.month_date AND o.country_id=ei.country_id 
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON o.country_id=c.country_id
LEFT JOIN doh AS doh ON o.month_date=doh.month_date AND o.country_id=doh.country_id 
LEFT JOIN instock500 AS it ON o.month_date=it.month_date AND o.country_id=it.country_id 
LEFT JOIN slowmovers AS sw ON o.month_date=sw.month_date AND o.country_id=sw.country_id 
LEFT JOIN listed_sku AS ls ON o.month_date=ls.month_date AND o.country_id=ls.country_id
LEFT JOIN inventory_accuracy AS ia ON o.month_date=ia.month_date AND o.country_id=ia.country_id
LEFT JOIN ultra_fresh AS uf ON o.month_date=uf.month_date AND o.country_id=uf.country_id
LEFT JOIN instock_weight AS iw on o.month_date=iw.month_date AND o.country_id=iw.country_id]]></relation>
