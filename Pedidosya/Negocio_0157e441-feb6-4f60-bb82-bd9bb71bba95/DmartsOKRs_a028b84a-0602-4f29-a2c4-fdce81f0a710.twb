            <column caption='Ponderador GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ponderador Orders*AFV (copia)_1046805462898454530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([confirmed_gmv_gross])/{ INCLUDE [month_date]:SUM([confirmed_gmv_gross])}' />
