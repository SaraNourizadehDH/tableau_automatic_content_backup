      <column caption='   NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_652459006674276364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([nps_promoters])&#13;&#10;-SUM([nps_detractors]))&#13;&#10;/SUM([nps_responses]))&#13;&#10;*100' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_652459006696230925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;11&apos; THEN SUM([active_warehouses])&#13;&#10;WHEN &apos;12&apos; THEN [Calculation_652459006670827521]&#13;&#10;WHEN &apos;13&apos; THEN SUM([confirmed_orders])&#13;&#10;WHEN &apos;15&apos; THEN SUM([active_customers])&#13;&#10;WHEN &apos;16&apos; THEN [Calculation_652459006672777219]&#13;&#10;WHEN &apos;17&apos; THEN SUM([sessions])&#13;&#10;WHEN &apos;18&apos; THEN SUM([monthly_acquisitions])&#13;&#10;WHEN &apos;19&apos; THEN [Calculation_1907274455002468352]&#13;&#10;WHEN &apos;31&apos; THEN [Calculation_652459006673100805]&#13;&#10;WHEN &apos;32&apos; THEN [Calculation_1257067259819839488]&#13;&#10;WHEN &apos;33&apos; THEN [Calculation_652459006673489927]&#13;&#10;WHEN &apos;37&apos; THEN [Calculation_652459006674276364]&#13;&#10;WHEN &apos;39&apos; THEN [Calculation_652459006674042891]&#13;&#10;WHEN &apos;40&apos; THEN [Calculation_658932935084396548]&#13;&#10;WHEN &apos;21&apos; THEN [Calculation_658932935081545728]&#13;&#10;WHEN &apos;22&apos; THEN [Calculation_823032849264312325]&#13;&#10;WHEN &apos;23&apos; THEN [AFV Gross (excl VAT) (copia)_823032849272426513]&#13;&#10;WHEN &apos;24&apos; THEN [Calculation_1514335439182553089]&#13;&#10;WHEN &apos;25&apos; THEN [Commercial Margin (FM + BM) (copia)_823032849273516051]&#13;&#10;WHEN &apos;26&apos; THEN [Commercial Margin (FM + BM) (copia)_823032849273589780]&#13;&#10;WHEN &apos;27&apos; THEN [Commercial Margin (FM + BM) (copia)_823032849273700373]&#13;&#10;WHEN &apos;28&apos; THEN [AFV Gross (excl VAT) (copia)_823032849273896982]&#13;&#10;WHEN &apos;29&apos; THEN [AFV Gross (excl VAT) (copia)_823032849274048535]&#13;&#10;WHEN &apos;291&apos; THEN [AFV Gross (excl VAT) (copia)_823032849274167320]&#13;&#10;WHEN &apos;212&apos; THEN [Calculation_1375849701730357248]&#13;&#10;WHEN &apos;311&apos; THEN [Calculation_1375849701733580801]&#13;&#10;WHEN &apos;312&apos; THEN [Calculation_1375849701734309890]&#13;&#10;WHEN &apos;50&apos; THEN [Calculation_1107604061003575297]&#13;&#10;WHEN &apos;391&apos; THEN [AFV Gross (excl VAT) (copia)_878201992540221450]&#13;&#10;WHEN &apos;271&apos; THEN [Overhead Cost as % of Sales (copia)_878201992531308548]&#13;&#10;WHEN &apos;38&apos; THEN [Calculation_898468193707536384]&#13;&#10;WHEN &apos;41&apos; THEN [Calculation_519039877326372868]&#13;&#10;WHEN &apos;20&apos; THEN [Calculation_1961036223998353413]&#13;&#10;WHEN &apos;60&apos; THEN [Calculation_1961036223984062466]&#13;&#10;WHEN &apos;61&apos; THEN [Calculation_1961036223983493121]&#13;&#10;WHEN &apos;62&apos; THEN [Calculation_1961036223983083520]&#13;&#10;WHEN &apos;63&apos; THEN [Calculation_2037034467685904387]&#13;&#10;WHEN &apos;64&apos; THEN [Calculation_2037034467673702402]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Expired Shrinkage + SC Loss &amp; Damage' datatype='real' default-format='p0.00%' name='[Calculation_658932935081545728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(-[expired_scloss_damage_eur_shrinkage])/sum([sales_eur_shrinkage])' />
