            <column caption='% Orders Dmarts delivery time &lt; 15 mins in key cities' datatype='real' default-format='p0.00%' name='[Delivery Time &lt; 15 (copia)_1316458498657869829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_less_15])&#13;&#10;/SUM([completed_orders_not_preorder_dt_15])' />
            </column>
            <column caption='Instock Top 500 Country' datatype='real' default-format='p0.00%' name='[Instock Top 500 (copia)_1046805462895460353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_id],[month_date]:&#13;&#10;    (SUM([instock_sum])/SUM([instock_count]))}' />
            </column>
            <column caption='Dmarts + 2 months online: In-Stock of top 500 SKUs (KVI + A)' datatype='real' default-format='p0.00%' name='[Instock Top 500 (copia)_1316458498656862211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN (SUM([instock_sum])/SUM([instock_count]))&#13;&#10;ELSE SUM([Instock Top 500 (copia)_1046805462895460353]*[Ponderador Orders*AFV (copia)_1046805462898454530])&#13;&#10;END' />
