              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN SUM([Overhead Cost as % of Sales (OKRs - Manual data --&gt; updated)])&#13;&#10;ELSEIF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10;    THEN MAX([Avg Store Opex Latam (copia)_823032849271046158])&#13;&#10;ELSE SUM([Overhead Cost as % of Sales (OKRs - Manual data --&gt; updated)])&#13;&#10;END' />
            </column>
            <column caption='EBITDA + Rent excl. NRV &amp; IC Comm.' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AFV Gross (excl VAT) (copia)_823032849274167320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN SUM([EBITDA + Rent excl. NRV &amp; IC Comm. (OKRs - Manual data --&gt; updated)])&#13;&#10;ELSEIF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10;    THEN MAX([AFV Latam (copia)_823032849271144463])&#13;&#10;ELSE SUM([EBITDA + Rent excl. NRV &amp; IC Comm. (OKRs - Manual data --&gt; updated)]*[Calculation_1514335394252361731])&#13;&#10;END' />
            </column>
            <column caption='   eNPS Pickers' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AFV Gross (excl VAT) (copia)_878201992540221450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN SUM([eNPS Pickers (OKRs - Manual data --&gt; updated)])&#13;&#10;ELSEIF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10;    THEN MAX([AFV Latam (copia)_878201992540016649])&#13;&#10;ELSE SUM([eNPS Pickers (OKRs - Manual data --&gt; updated Latam)]*[Calculation_1514335394252361731])&#13;&#10;END' />
            </column>
            <column caption='AFV Gross (excl VAT) target' datatype='real' name='[AFV Gross (excl VAT)]' role='measure' type='quantitative' />
            <column caption='Avg DF Latam' datatype='real' name='[AFV Latam (copia)_823032849266917384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date]:MAX([Avg Delivery Fee per order (excl VAT) (OKRs - Manual data --&gt; updated Latam)])}' />
            </column>
            <column caption='EBITDA  + Rent excl. NRV &amp; IC Comm. Latam' datatype='real' name='[AFV Latam (copia)_823032849271144463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date]:MAX([EBITDA + Rent excl. NRV &amp; IC Comm. (OKRs - Manual data --&gt; updated Latam)])}' />
            </column>
            <column caption='eNPS Pickers Latam' datatype='integer' name='[AFV Latam (copia)_878201992540016649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date]:MAX([eNPS Pickers (OKRs - Manual data --&gt; updated Latam)])}' />
            </column>
            <column datatype='real' name='[Active Customers (OKRs Targets --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column caption='Active Customers target' datatype='real' name='[Active Customers]' role='measure' type='quantitative' />
            <column datatype='real' name='[Avg Delivery Fee per order (excl VAT) (OKRs - Manual data --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Avg Delivery Fee per order (excl VAT) (OKRs - Manual data --&gt; updated)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Avg Delivery Fee per order (excl VAT) (OKRs Targets --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column caption='Avg Delivery Fee per order (excl VAT) target' datatype='real' name='[Avg Delivery Fee per order (excl VAT)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Avg Store Opex (€) (OKRs Targets --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column caption='Avg Store Opex (€) target' datatype='real' name='[Avg Store Opex (€)]' role='measure' type='quantitative' />
            <column caption='Overhead Cost as % of Sales Latam' datatype='real' default-format='p0.00%' name='[Avg Store Opex Latam (copia)_823032849271046158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date]:MAX([Overhead Cost as % of Sales (OKRs - Manual data --&gt; updated Latam)])}' />
            </column>
            <column datatype='real' name='[CM (FM + BM) + WA (OKRs - Manual data --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column datatype='real' name='[CM (FM + BM) + WA - IIBB (OKRs Targets --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column caption='CM (FM + BM) + WA - IIBB (OKRs Targets --&gt; updated' datatype='real' name='[CM (FM + BM) + WA - IIBB]' role='measure' type='quantitative' />
            <column caption='CM (FM + BM) + WA (OKRs - Manual data --&gt; updated)' datatype='real' name='[CM (FM + BM) + WA]' role='measure' type='quantitative' />
            <column datatype='real' name='[CVR3 (OKRs Targets --&gt; updated Latam)]' role='measure' type='quantitative' />
            <column caption='Cvr3 target' datatype='real' name='[CVR3]' role='dimension' type='ordinal' />
            <column caption='GMV All countries' datatype='real' name='[Calculation_1107604060998725632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date]:MAX([confirmed_gmv_net_all_countries])}' />
            </column>
            <column caption='Inventory Accuracy (SKU) ' datatype='real' default-format='p0.0%' name='[Calculation_1107604061003575297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inventory_accuracy_num])&#13;&#10;/SUM([inventory_accuracy_base])' />
            </column>
            <column caption='Fresh &amp; Ultra Fresh GFV share' datatype='real' default-format='p0.00%' name='[Calculation_1257067259819839488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fresh_ultrafresh_gfv])/sum([gfv])' />
            </column>
            <column caption='DOH ($)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1375849701730357248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([doh_stock_eur])/SUM([doh_sales_eur])' />
            </column>
            <column caption='Instock Top 500' datatype='real' default-format='p0.00%' name='[Calculation_1375849701733580801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN (SUM([instock_sum])/SUM([instock_count]))&#13;&#10;ELSE SUM([Instock Top 500 (copia)_1046805462895460353]*[Ponderador Orders*AFV (copia)_1046805462898454530])&#13;&#10;END' />
            </column>
            <column caption='Slowmovers' datatype='real' default-format='p0.00%' name='[Calculation_1375849701734309890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([total_slowmovers])/SUM([store_qty]))+(SUM([total_zeromovers])/SUM([store_qty])))&#13;&#10;/((SUM([avg_available_skus_slowmovers])/SUM([store_qty])))' />
            </column>
            <column caption='Ponderador Ordenes' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1514335394252361731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[confirmed_orders]/{ INCLUDE [month_date]:SUM([confirmed_orders])}' />
            </column>
            <column caption='CM (FM + BM) + WA' datatype='real' default-format='p0.00%' name='[Calculation_1514335439182553089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN SUM([CM (FM + BM) + WA])&#13;&#10;ELSEIF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10;    THEN MAX([Calculation_896779335624249347])&#13;&#10;ELSE SUM([CM (FM + BM) + WA]*[Ponderador Stores (copia)_1514335394254565381])&#13;&#10;END' />
            </column>
            <column caption='Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_1907274455002468352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_reorder])/SUM([customers_reorder_base])' />
            </column>
            <column caption='Instock (weighted)' datatype='real' default-format='p0.00%' name='[Calculation_1961036223983083520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([numeradorWIS])/sum([denominadorWIS])' />
            </column>
            <column caption='Avg. Basket Size' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1961036223983493121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='round(sum([confirmed_product_quantity])/sum([confirmed_orders]),2)' />
            </column>
            <column caption='Adoption' datatype='real' default-format='p0.00%' name='[Calculation_1961036223984062466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([users_adoption])/sum([active_customers])' />
            </column>
            <column caption='Acquisition Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_1961036223998353413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions_previous_month_with_reorder])/sum([acquisitions_previous_month])' />
            </column>
            <column caption='   Affordable Orders' datatype='real' default-format='p0.00%' name='[Calculation_2037034467673702402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_discount])/sum([confirmed_orders])' />
            </column>
            <column caption='   Contact Rate - post delivery' datatype='real' default-format='p0.00%' name='[Calculation_2037034467685904387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Contacts])/sum(confirmed_orders + [non_confirmed_orders])' />
            </column>
            <column caption='GMV Share' datatype='real' default-format='p0.00%' name='[Calculation_652459006670827521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10; THEN SUM([confirmed_gmv_net])/&#13;&#10;    SUM([Calculation_1107604060998725632])&#13;&#10;ELSE&#13;&#10;    SUM([confirmed_gmv_net])/&#13;&#10;    SUM([confirmed_gmv_net_total])&#13;&#10;END' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_652459006672777219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/&#13;&#10;SUM([active_customers])' />
            </column>
            <column caption='CVR3' datatype='real' default-format='p0.00%' name='[Calculation_652459006673100805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_unique_orders])&#13;&#10;/SUM([sessions])' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_652459006673489927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_min])&#13;&#10;/SUM([completed_orders_not_preorder])' />
            </column>
            <column caption='Partial Orders' datatype='real' default-format='p0.00%' name='[Calculation_652459006674042891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders])&#13;&#10;/SUM([partial_orders_base])' />
            </column>
            <column caption='   NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_652459006674276364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_promoters])&#13;&#10;-SUM([nps_detractors]))&#13;&#10;/SUM([nps_responses]))&#13;&#10;*100' />
            </column>
            <column caption='Expired Shrinkage + SC Loss &amp; Damage' datatype='real' default-format='p0.00%' name='[Calculation_658932935081545728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(-[expired_scloss_damage_eur_shrinkage])/sum([sales_eur_shrinkage])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_658932935084396548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_restaurant])&#13;&#10;/(SUM([confirmed_orders])+SUM([non_confirmed_orders]))' />
            </column>
            <column caption='Year' datatype='integer' name='[Calculation_658932935085461509]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([month_date])' />
            </column>
            <column caption='Countries selected' datatype='integer' name='[Calculation_823032849263960068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([country_id])' />
            </column>
            <column caption='AFV Gross (excl VAT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_823032849264312325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN SUM([AFV Gross (excl VAT) (OKRs - Manual data --&gt; updated)])&#13;&#10;ELSEIF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10;    THEN MAX([Calculation_823032849266503687])&#13;&#10;ELSE SUM([AFV Gross (excl VAT) (OKRs - Manual data --&gt; updated)]*[Calculation_1514335394252361731])&#13;&#10;END' />
            </column>
            <column caption='AFV Latam' datatype='real' name='[Calculation_823032849266503687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_date]:MAX([AFV Gross (excl VAT) (OKRs - Manual data --&gt; updated Latam)])}' />
            </column>
            <column caption='Target Number of operating stores ' datatype='integer' name='[Calculation_823032849319153693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN SUM([Number of operating stores])&#13;&#10;ELSEIF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10;    THEN MAX({ FIXED [month_date]:MAX([Number of operating stores (OKRs Targets --&gt; updated Latam)])})&#13;&#10;ELSE NULL&#13;&#10;END' />
