              <calculation class='tableau' formula='IF [Calculation_823032849263960068] =1&#13;&#10;    THEN SUM([Fulfillment + Distribution Cost as % of Sales])&#13;&#10;ELSEIF [Calculation_823032849263960068]=MAX([Countries selected (copia)_823032849265020934])&#13;&#10;    THEN MAX([Overhead Cost as % of Sales Latam (copia)_878201992531161091])&#13;&#10;ELSE SUM([Fulfillment + Distribution Cost as % of Sales (OKRs - Manual data --&gt; updated)])&#13;&#10;END' />
