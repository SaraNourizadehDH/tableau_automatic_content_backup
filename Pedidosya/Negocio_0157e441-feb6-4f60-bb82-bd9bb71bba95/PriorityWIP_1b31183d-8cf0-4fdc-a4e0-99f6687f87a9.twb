      <column caption='Diff Delta Delivery Time ' datatype='real' default-format='p0.0%' name='[%Delta Delivery Time (copy)_1037798267292700691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1037798267196772357]-[Calculation_1037798267197046790]' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1rl5f3h15d3yoy1abwnmq1stqyd3].[sum:prio_orders:qk]&quot;' value='Prioritized Orders' />
          <alias key='&quot;[federated.1rl5f3h15d3yoy1abwnmq1stqyd3].[usr:Calculation_1270578072692953088:qk]&quot;' value='%Adoption' />
        </aliases>
      </column>
      <column caption='Avg Plus Revenue Loss' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Avg Priority Fee (copy)_1037798267211526153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(-sum([sum_priority_fee_revenue])/sum([prio_orders])*sum([plus_prio_orders])/SUM([prio_orders]))/(CASE [Parameters].[Parameter 2] WHEN &quot;Local Currency&quot; THEN 1 ELSE AVG([currency_conversion])END)' />
      </column>
      <column caption='Avg Priority Fee LC' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Avg Priority Fee (copy)_1037798267281956879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [sum_priority_fee] END)/sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [prio_orders] END )' />
      </column>
      <column caption='Avg Priority Fee Revenue' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Avg Priority Fee (copy)_715227945350123520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &quot;Local Currency&quot; THEN&#13;&#10;sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [sum_priority_fee_revenue] END)/sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [prio_orders] END )&#13;&#10;WHEN &quot;EUR&quot; THEN sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [sum_priority_fee_revenue] END)/sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [prio_orders] END )/AVG([currency_conversion]) END' />
      </column>
      <column caption='Total Profit' datatype='real' default-format='c&quot;$ &quot;#,##0;-&quot;$ &quot;#,##0' name='[Avg Profit (copy)_1037798267218657291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prio_orders])*([Avg Priority Fee (copy)_715227945350123520]+[Calculation_1037798267189587972]+[Avg Priority Fee (copy)_1037798267211526153])' />
      </column>
      <column caption='Date' datatype='date' default-format='*d/m/yy' name='[Calculation_1037798267182637056]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Daily&quot; THEN [date]&#13;&#10;WHEN &quot;Weekly&quot; THEN [week]&#13;&#10;WHEN &quot;Monthly&quot; THEN [month] END' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1037798267189510147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[rest_orders]+[prio_orders]' />
      </column>
      <column caption='Avg Incremental CPO' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Calculation_1037798267189587972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(-SUM(([prio_cpo]-[rest_cpo])*[Calculation_1037798267189510147])/SUM([Calculation_1037798267189510147]))/(CASE [Parameters].[Parameter 2] WHEN &quot;Local Currency&quot; THEN 1 ELSE AVG([currency_conversion])END)' />
      </column>
      <column caption='Avg Priority Delivery Time' datatype='real' name='[Calculation_1037798267196772357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prio_total_delivery_time_menos_est_preptime])/SUM([prio_orders])' />
      </column>
      <column caption='Avg Rest Delivery Time' datatype='real' name='[Calculation_1037798267197046790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rest_total_delivery_time_menos_est_preptime])/sum([rest_orders])' />
      </column>
      <column caption='%Delta Delivery Time' datatype='real' default-format='p0.0%' name='[Calculation_1037798267197169671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1037798267196772357]/[Calculation_1037798267197046790]- 1' />
      </column>
      <column caption='Avg Profit' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Calculation_1037798267202187272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg Priority Fee (copy)_715227945350123520]+[Calculation_1037798267189587972]+[Avg Priority Fee (copy)_1037798267211526153]' />
      </column>
      <column caption='df listing' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Calculation_1037798267227385868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [sum_shipping_nd] END)&#13;&#10;/SUM(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [Calculation_1037798267189510147] END)' />
      </column>
      <column caption='PF/DF' datatype='real' default-format='p0.0%' name='[Calculation_1037798267231358989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg Priority Fee (copy)_1037798267281956879]/[Calculation_1037798267227385868]' />
      </column>
      <column caption='Month Filter' datatype='boolean' name='[Calculation_1037798267283419153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN  &quot;Last Month&quot; THEN   &#13;&#10;    IF DATETRUNC(&quot;month&quot;,[date]) = DATETRUNC(&quot;month&quot;,DATEADD(&quot;month&quot;,-1, TODAY())) THEN TRUE ELSE FALSE END&#13;&#10;WHEN  &quot;MTD&quot;&#13;&#10;THEN    IF  DATETRUNC(&quot;month&quot;,[date]) = DATETRUNC(&quot;month&quot;,TODAY()) THEN TRUE ELSE FALSE END END' />
      </column>
      <column caption='KPI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1037798267293233172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Parameters].[Date View Fee (copy)] WHEN  &quot;%Adoption&quot; THEN [Calculation_1270578072692953088]*100&#13;&#10;WHEN &quot;Incremental CPO&quot; THEN [Calculation_1037798267189587972]&#13;&#10;WHEN &quot;Diff Delivery Time&quot; THEN [%Delta Delivery Time (copy)_1037798267292700691]&#13;&#10;WHEN &quot;Total Prioritized Orders&quot; THEN SUM([prio_orders])&#13;&#10;WHEN &quot;%Delta Delivery Time&quot; THEN [Calculation_1037798267197169671]*100 END' />
      </column>
      <column caption='adoption' datatype='real' default-format='p0.0%' name='[Calculation_1270578072692953088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([prio_orders])/sum([rest_orders]+[prio_orders])' />
      </column>
      <column caption='Avg Priority Fee' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Calculation_1270578072695386113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &quot;Local Currency&quot; THEN&#13;&#10;sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [sum_priority_fee] END)/sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [prio_orders] END )&#13;&#10;WHEN &quot;EUR&quot; THEN sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [sum_priority_fee] END)/sum(IF ([scheme_typee_type] !=  &quot;Campaign&quot; AND [scheme_typee_type] !=  &quot;DFS Incentive&quot;) THEN [prio_orders] END )/AVG([currency_conversion]) END' />
      </column>
