    <datasource caption='Custom SQL Query (user_matias_duek)' inline='true' name='federated.1rl5f3h15d3yoy1abwnmq1stqyd3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.13jiner1tcv1q91dtr60d0m6ytp7'>
            <connection CATALOG='peya-markets' EXECCATALOG='peya-markets' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-markets' schema='user_matias_duek' server-oauth='' username='matias.duek@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
