    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Priority Monitor'>
      <repository-location id='PriorityMonitor' path='/t/Pedidosya/workbooks/PriorityWIP' revision='' site='Pedidosya' />
      <style />
      <size maxheight='1600' maxwidth='1800' minheight='1600' minwidth='1800' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Custom SQL Query (user_matias_duek)' name='federated.1rl5f3h15d3yoy1abwnmq1stqyd3' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='KPI' datatype='string' name='[Date View Fee (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\%Adoption&quot;'>
          <calculation class='tableau' formula='&quot;%Adoption&quot;' />
          <members>
            <member value='&quot;\%Adoption&quot;' />
            <member value='&quot;\%Delta Delivery Time&quot;' />
            <member value='&quot;Diff Delivery Time&quot;' />
            <member value='&quot;Incremental CPO&quot;' />
            <member value='&quot;Total Prioritized Orders&quot;' />
          </members>
        </column>
        <column caption='Date View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
          <calculation class='tableau' formula='&quot;Daily&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
          </members>
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local Currency&quot;'>
          <calculation class='tableau' formula='&quot;Local Currency&quot;' />
          <members>
            <member value='&quot;Local Currency&quot;' />
            <member value='&quot;EUR&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1rl5f3h15d3yoy1abwnmq1stqyd3'>
        <column caption='Date' datatype='date' default-format='*d/m/yy' name='[Calculation_1037798267182637056]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Daily&quot; THEN [date]&#13;&#10;WHEN &quot;Weekly&quot; THEN [week]&#13;&#10;WHEN &quot;Monthly&quot; THEN [month] END' />
        </column>
