            <run fontname='Tableau Book' fontsize='11'>| </run>
            <run fontcolor='#fb0050' fontname='Tableau Bold' fontsize='11'>%Adoption</run>
            <run fontcolor='#91dcea' fontname='Tableau Bold' fontsize='11'>Æ </run>
            <run fontname='Tableau Book' fontsize='11'>|</run>
            <run fontname='Tableau Bold' fontsize='11'>Æ </run>
            <run fontcolor='#f9d23c' fontname='Tableau Bold' fontsize='11'>Prioritized Orders</run>
          </formatted-text>
