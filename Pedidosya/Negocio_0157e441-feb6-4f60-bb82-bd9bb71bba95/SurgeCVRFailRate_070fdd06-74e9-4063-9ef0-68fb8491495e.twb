          </datasource-dependencies>
          <datasource-dependencies datasource='federated.180ia7318vaoxy1c0bo9d0l6c0ll'>
            <column caption='CVR 2' datatype='real' default-format='p0.00%' name='[CVR (copy) (copy)_1582733801399930891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [rejected_orders]=0 THEN [list_no_transaction] END)  /SUM(IF [rejected_orders]=0 THEN [list_no] END)' />
            </column>
            <column caption='mCVR2' datatype='real' default-format='p0.00%' name='[CVR (copy)_1582733801399906314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [rejected_orders]=0 THEN [list_menu] END)  /SUM(IF [rejected_orders]=0 THEN [list_no] END)' />
