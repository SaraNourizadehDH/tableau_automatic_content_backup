      <aliases enabled='yes' />
      <column caption='CVR 2' datatype='real' default-format='p0.00%' name='[CVR (copy) (copy)_1582733801399930891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rejected_orders]=0 THEN [list_no_transaction] END)  /SUM(IF [rejected_orders]=0 THEN [list_no] END)' />
      </column>
      <column caption='mCVR2' datatype='real' default-format='p0.00%' name='[CVR (copy)_1582733801399906314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rejected_orders]=0 THEN [list_menu] END)  /SUM(IF [rejected_orders]=0 THEN [list_no] END)' />
      </column>
      <column caption='DayOfWeek' datatype='string' name='[Calculation_1582733801311735808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [hour])' />
      </column>
      <column caption='Week' datatype='date' datatype-customized='true' name='[Calculation_1582733801313366017]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yy&quot;, STR(WEEK([hour])) )) ' />
      </column>
      <column caption='Surge Rate' datatype='real' default-format='p0.0%' name='[Calculation_1582733801361117186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rejected_orders]=0 THEN [surged_orders]END)/SUM(IF [rejected_orders]=0 THEN [orders]END)' />
      </column>
      <column caption='Surge Flag' datatype='integer' name='[Calculation_1582733801361969156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Calculation_1582733801361117186]&gt;= 0.1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1582733801362726917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1582733801366913030]/SUM([all_orders])' />
      </column>
      <column caption='Rejected Orders' datatype='integer' name='[Calculation_1582733801366913030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF[rejected_orders]= 1 THEN [all_orders]END)' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_1582733801371639815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [rejected_orders]=0 THEN [total_transactions] END)  /SUM(IF [rejected_orders]=0 THEN [total_sessions] END)' />
      </column>
      <column caption='Measure' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_948852154174373888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;CVR&apos; THEN [Calculation_1582733801371639815]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;CVR2&apos; THEN [CVR (copy) (copy)_1582733801399930891]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;mCVR2&apos; THEN [CVR (copy)_1582733801399906314]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;mCVR3&apos; THEN [mCVR2 (copy)_1582733801400430604]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;mCVR4&apos; THEN [mCVR2 (copy) (copy)_1582733801400442893]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Fail Rate&apos; THEN [Calculation_1582733801362726917]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;%Surge&apos; THEN [Calculation_1582733801361117186]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;User Fail Rate&apos; THEN [Fail Rate (copy) (copy)_1582733801385508873]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor Fail Rate&apos; THEN [Fail Rate (copy)_1582733801385500680]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Rider Fail Rate&apos; THEN [User Fail Rate (copy)_828099390607360000]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Peya Fail Rate&apos; THEN [User Fail Rate (copy) (copy)_828099390607368193]*100&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Orders&apos; THEN SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Sessions&apos; THEN SUM([total_sessions])&#13;&#10;END' />
      </column>
      <column caption='User Fail Rate' datatype='real' default-format='p0.00%' name='[Fail Rate (copy) (copy)_1582733801385508873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [fail_rate_owner] = &apos;User&apos; THEN [rejected_orders] END)/SUM([all_orders])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_1582733801385500680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [fail_rate_owner] = &apos;Restaurant&apos; THEN [rejected_orders] END)/SUM([all_orders])' />
