              <relation connection='bigquery.1m3w0qs14mcdis1c0xis8189px43' name='Custom SQL Query' type='text'>WITH surge_hours &#13;&#10;AS(&#13;&#10;SELECT&#13;&#10;  dps.country_code country,&#13;&#10;  dps.city_name city,&#13;&#10;  dps.zone_name zone,&#13;&#10;  o.business_type.business_type_name business_type,&#13;&#10;  (CASE WHEN o.order_status =&quot;REJECTED&quot; THEN 1 ELSE 0 END) rejected_orders,&#13;&#10;  o.fail_rate_owner,&#13;&#10;  DATE_TRUNC(o.registered_at, HOUR) AS hour,&#13;&#10;  COUNT(DISTINCT CASE WHEN o.order_status = &apos;CONFIRMED&apos; THEN o.order_id END) orders,&#13;&#10;  COUNT(DISTINCT CASE WHEN dps_surge_fee_local  &gt;&gt; 0 THEN o.order_id END) surged_orders,&#13;&#10;  COUNT(DISTINCT o.order_id) all_orders,&#13;&#10;  IFNULL(SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN dps_surge_fee_local  &gt;&gt; 0 THEN o.order_id END), COUNT(DISTINCT o.order_id)),0) surge_rate,&#13;&#10;  CASE WHEN IFNULL(SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN dps_surge_fee_local  &gt;&gt; 0 THEN o.order_id END), COUNT(DISTINCT o.order_id)), 0)&gt;&gt;=  0.1 THEN 1 ELSE 0 END AS surge_flag,&#13;&#10;FROM&#13;&#10;  `peya-bi-tools-pro.il_core.fact_orders` o LEFT JOIN `peya-data-origins-pro.cl_hurrier.dps_sessions_mapped_to_orders_v2` dps&#13;&#10;  ON CAST(o.order_id AS STRING) = dps.platform_order_code AND dps.created_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 11 DAY)&#13;&#10;WHERE&#13;&#10;  o.registered_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 10 DAY)&#13;&#10;  AND pickup = FALSE&#13;&#10;  AND with_logistics = TRUE&#13;&#10;  AND dps.country_code IS NOT NULL&#13;&#10;  AND dps.city_name IS NOT NULL&#13;&#10;  AND dps.zone_name IS NOT NULL&#13;&#10;GROUP BY&#13;&#10;  1,2,3,4,5,6,7&#13;&#10;ORDER BY&#13;&#10;  1,2,3 ASC),&#13;&#10;&#13;&#10;&#13;&#10;cvr AS(&#13;&#10;SELECT&#13;&#10;  cvr.country_code,&#13;&#10;  cvr.dps_zones_name,&#13;&#10;  pa.business_type.business_type_name btype,&#13;&#10;  DATE_TRUNC(cvr.created_at_local, HOUR) AS hour,&#13;&#10;  COUNT(DISTINCT CASE WHEN ga_session_id IS NOT NULL THEN ga_session_id END) AS total_sessions,&#13;&#10;  COUNT(DISTINCT CASE WHEN transaction_no IS NOT NULL THEN  ga_session_id END) AS total_transactions,&#13;&#10;  COUNT(DISTINCT CASE WHEN shop_list_no IS NOT NULL THEN ga_session_id END) AS list_no,&#13;&#10;  COUNT(DISTINCT CASE WHEN list_menu IS NOT NULL THEN ga_session_id END) AS list_menu,&#13;&#10;  COUNT(DISTINCT CASE WHEN (shop_list_no IS NOT NULL AND transaction_no IS NOT NULL) THEN ga_session_id END) AS list_no_transaction,&#13;&#10;  COUNT(DISTINCT CASE WHEN shop_menu_no IS NOT NULL THEN ga_session_id END) AS menu_no,&#13;&#10;  COUNT(DISTINCT CASE WHEN menu_checkout IS NOT NULL THEN ga_session_id END) AS menu_checkout,&#13;&#10;  COUNT(DISTINCT CASE WHEN checkout_no IS NOT NULL THEN ga_session_id END) AS checkout_no,&#13;&#10;  COUNT(DISTINCT CASE WHEN checkout_transaction IS NOT NULL THEN ga_session_id END) AS checkout_transaction,&#13;&#10;FROM `peya-data-origins-pro.cl_hurrier.dps_cvr_events` as cvr LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` pa&#13;&#10;  ON cvr.vendor_code = CAST(pa.partner_id AS STRING)&#13;&#10;WHERE date(cvr.created_date) BETWEEN DATE_ADD(CURRENT_DATE, INTERVAL -11 DAY) AND CURRENT_DATE()&#13;&#10;GROUP BY 1,2,3,4&#13;&#10;)&#13;&#10;&#13;&#10;SELECT&#13;&#10;    sh.country,&#13;&#10;    sh.city,&#13;&#10;    sh.zone,&#13;&#10;    sh.business_type,&#13;&#10;    sh.hour,&#13;&#10;    rejected_orders,&#13;&#10;    fail_rate_owner, &#13;&#10;    orders,&#13;&#10;    surged_orders,&#13;&#10;    all_orders,&#13;&#10;    sh.surge_flag,&#13;&#10;    sh.surge_rate,&#13;&#10;    total_sessions,&#13;&#10;    total_transactions,&#13;&#10;    list_no,&#13;&#10;    list_menu,&#13;&#10;    list_no_transaction,&#13;&#10;    menu_no,&#13;&#10;    menu_checkout,&#13;&#10;    checkout_no,&#13;&#10;    checkout_transaction&#13;&#10;  FROM surge_hours sh LEFT JOIN cvr &#13;&#10;    ON sh.country = cvr.country_code AND sh.zone = cvr.dps_zones_name AND sh.business_type = cvr.btype AND sh.hour = CAST(cvr.hour AS TIMESTAMP)&#13;&#10;  ORDER BY 1,2,3,4,5</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
  </datasources>
