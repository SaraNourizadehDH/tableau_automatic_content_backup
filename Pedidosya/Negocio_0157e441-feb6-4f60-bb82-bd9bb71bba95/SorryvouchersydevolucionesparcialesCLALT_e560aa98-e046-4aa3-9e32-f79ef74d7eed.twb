      <aliases enabled='yes' />
      <column caption='Devolución 40%' datatype='real' name='[Calculation_578149664443604993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_amount]/1.19*0.4' />
      </column>
      <column caption='Resarcimiento' datatype='real' name='[Calculation_627970676278427648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [franchise_name] in (&quot;NIU&quot;, &quot;Pollo Taquilla&quot;, &quot;Guacamole&quot;,&quot;Kao Thai&quot;) &#13;&#10;then &#13;&#10;0.6*(([rejected_gfv]-ifnull(([serviceFee_nodisc]-[serviceFee]),0))/1.19)&#13;&#10;else &#13;&#10;0.4*(([rejected_gfv]-ifnull(([serviceFee_nodisc]-[serviceFee]),0))/1.19)&#13;&#10;end' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_832040034670321664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datename(&quot;weekday&quot;,[order_date],&quot;monday&quot;)' />
      </column>
      <column aggregation='Sum' caption='flag_lasthour' datatype='integer' name='[Calculation_832040034673483777]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [order_hour] in (21,22,23) and [Calculation_832040034670321664] = &quot;Saturday&quot; then 1 else 0 end' />
      </column>
      <column caption='Devolución RI 70%' datatype='real' name='[Devolución 40% (copy)_578149664447504386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tools_description]=&quot;Repartidor incontactable&quot;&#13;&#10;then [order_amount]/1.19*0.7&#13;&#10;else [order_amount]/1.19*0.4&#13;&#10;end' />
      </column>
      <column caption='Devolución RI 100%' datatype='real' name='[Devolución RI 70% (copy)_985162480772505601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tools_description]=&quot;Repartidor incontactable&quot;&#13;&#10;then [order_amount]/1.19*1.0&#13;&#10;else [order_amount]/1.19*0.4&#13;&#10;end' />
      </column>
