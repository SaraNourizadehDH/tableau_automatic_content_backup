      <aliases enabled='yes' />
      <column caption='Last Salesforce Case' datatype='string' name='[Calculation_1378945977862881280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Motivo] in (&quot;Missing item&quot;, &quot;Wrong item&quot;, &quot;Wrong order&quot;, &quot;Food quality&quot;)&#13;&#10;then [Motivo] else &quot;Others&quot; &#13;&#10;end' />
      </column>
      <column caption='Compensation' datatype='real' name='[Calculation_1378945977884225537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [concept]=&quot;Sorry Voucher&quot; then (&#13;&#10;&#13;&#10;if [franchise_name] in (&quot;NIU&quot;,&quot;Pollo Taquilla&quot;,&quot;Guacamole&quot;,&quot;Kao Thai&quot;) then&#13;&#10;round([redeem_coupon]*0.5,0) &#13;&#10;else [redeem_coupon]&#13;&#10;end)&#13;&#10;&#13;&#10;ELSEIF [concept]=&quot;Devolución Parcial&quot; then (&#13;&#10;if [franchise_name] in (&quot;NIU&quot;,&quot;Pollo Taquilla&quot;,&quot;Guacamole&quot;,&quot;Kao Thai&quot;)&#13;&#10;then round([redeem_value]*0.5,0)&#13;&#10;else [redeem_value]&#13;&#10;end)&#13;&#10;else null&#13;&#10;end' />
      </column>
      <column caption='Data-up-to' datatype='string' name='[Calculation_1540231074377687040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed: &quot;Data up to: &quot; + &#13;&#10;str(datename(&quot;month&quot;,max([redeem_date]))) + &quot; &quot;&#13;&#10;+ str(datepart(&quot;day&quot;,max([redeem_date]))) +&quot;, &quot;&#13;&#10;+ str(datepart(&quot;year&quot;,max([redeem_date])))}' />
      </column>
      <column caption='DP date' datatype='date' name='[Calculation_1540231074385408001]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [concept]=&quot;Devolución Parcial&quot; then [registered_date]&#13;&#10;else null end' />
      </column>
      <column caption='Total compensation' datatype='string' name='[Calculation_1601311210127785984]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Total: &quot; + &quot;$ &quot; + str(round(sum([Calculation_1378945977884225537]),0))' />
      </column>
      <column caption='Week date' datatype='datetime' name='[Calculation_337770036925444096]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[redeem_date],&quot;monday&quot;)' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_337770037251993603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Countd([order_id])' />
      </column>
      <column caption='Registro' datatype='integer' name='[Calculation_337770037263020040]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Data-up-to 2' datatype='string' name='[Data-up-to (copy)_711287292720717824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed [concept]: &#13;&#10;min([concept]) + &quot; up to: &quot;  &#13;&#10;+ str(datename(&quot;month&quot;,max([redeem_date]))) + &quot; &quot;&#13;&#10;+ str(datepart(&quot;day&quot;,max([redeem_date]))) + &quot;, &quot;&#13;&#10;+ str(datepart(&quot;year&quot;,max([redeem_date])))&#13;&#10;}' />
      </column>
