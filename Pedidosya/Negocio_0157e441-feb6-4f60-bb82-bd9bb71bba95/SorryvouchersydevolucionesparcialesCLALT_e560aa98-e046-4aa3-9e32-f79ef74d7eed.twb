            <column caption='Last Salesforce Case' datatype='string' name='[Calculation_1378945977862881280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Motivo] in (&quot;Missing item&quot;, &quot;Wrong item&quot;, &quot;Wrong order&quot;, &quot;Food quality&quot;)&#13;&#10;then [Motivo] else &quot;Others&quot; &#13;&#10;end' />
            </column>
            <column caption='Compensation' datatype='real' name='[Calculation_1378945977884225537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [concept]=&quot;Sorry Voucher&quot; then (&#13;&#10;&#13;&#10;if [franchise_name] in (&quot;NIU&quot;,&quot;Pollo Taquilla&quot;,&quot;Guacamole&quot;,&quot;Kao Thai&quot;) then&#13;&#10;round([redeem_coupon]*0.5,0) &#13;&#10;else [redeem_coupon]&#13;&#10;end)&#13;&#10;&#13;&#10;ELSEIF [concept]=&quot;Devolución Parcial&quot; then (&#13;&#10;if [franchise_name] in (&quot;NIU&quot;,&quot;Pollo Taquilla&quot;,&quot;Guacamole&quot;,&quot;Kao Thai&quot;)&#13;&#10;then round([redeem_value]*0.5,0)&#13;&#10;else [redeem_value]&#13;&#10;end)&#13;&#10;else null&#13;&#10;end' />
            </column>
            <column caption='DP date' datatype='date' name='[Calculation_1540231074385408001]' role='dimension' type='ordinal'>
