      </filter>
      <filter class='categorical' column='[federated.039d91h0pv3wd91bncxgq1r0i8ij].[none:QC_Business:nk]'>
        <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[none:QC_Business:nk]' member='%null%' />
