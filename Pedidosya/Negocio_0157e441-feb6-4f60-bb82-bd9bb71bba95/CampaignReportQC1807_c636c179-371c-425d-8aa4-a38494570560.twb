          <groupfilter function='member' level='[none:Warehouse_Name:nk]' member='%null%' />
          <groupfilter from='&quot;AR_1_Gurruchaga&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;AR_42_Villa_del_Parque&quot;' />
          <groupfilter from='&quot;AR_54_Quilmes&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;BO_1_Equipetrol&quot;' />
          <groupfilter from='&quot;BO_2_NORTE&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;CH_19_Macul&quot;' />
          <groupfilter from='&quot;CH_20_Estacion Central&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;EC_10_Tumbaco&quot;' />
          <groupfilter from='&quot;EC_2_Urdesa&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;PE_19_Trujillo&quot;' />
          <groupfilter function='member' level='[none:Warehouse_Name:nk]' member='&quot;PE_20_SMP&quot;' />
          <groupfilter function='member' level='[none:Warehouse_Name:nk]' member='&quot;PE_22_LosOlivos&quot;' />
          <groupfilter from='&quot;PE_5_SanMiguel&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;PE_8_Chorrillos&quot;' />
          <groupfilter from='&quot;PY_1_San Lorenzo&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;RD_6_Monumental Market&quot;' />
          <groupfilter from='&quot;SV_1_Constitucion&quot;' function='range' level='[none:Warehouse_Name:nk]' to='&quot;UY_9_La Blanqueada&quot;' />
        </groupfilter>
      </filter>
    </shared-view>
  </shared-views>
  <worksheets>
    <worksheet name='Evolution by Vertical'>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.039d91h0pv3wd91bncxgq1r0i8ij' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Selection' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Last N Periods' datatype='integer' name='[Parámetro 3]' param-domain-type='any' role='measure' type='quantitative' value='31'>
              <calculation class='tableau' formula='31' />
            </column>
          </datasource-dependencies>
