              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;Day&apos; THEN SUM({ FIXED [Country],[Calculation_838795472976044032]: MAX([active_qc_daily_cl])})&#13;&#10;    WHEN &apos;Week&apos; THEN SUM({ FIXED [Country],[Calculation_838795472976044032]: MAX([active_qc_weekly_cl])})&#13;&#10;    WHEN &apos;Month&apos; THEN SUM({ FIXED [Country],[Calculation_838795472976044032]: MAX([active_qc_monthly_cl])})&#13;&#10;    END' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_838795472976044032]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Month&apos; THEN [registered_date (Meses)]&#13;&#10;WHEN &apos;Week&apos; THEN [registered_date (Días de semana)]&#13;&#10;WHEN &apos;Day&apos; THEN [registered_date (Días)]&#13;&#10;END' />
            </column>
            <column caption='Basket Size' datatype='real' name='[Calculation_838795472982044675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[items_qty]/[Orders]' />
            </column>
            <column caption='Orders w/ promotions (PTool)' datatype='integer' name='[Calculation_838795474370514948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [Order_Type_L2]=&quot;PTool_Only&quot; OR [Order_Type_L2]=&quot;PTool_Other&quot; THEN [Orders] END)' />
            </column>
            <column caption='Orders w/FDF' datatype='integer' name='[Calculation_838795474391998470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF CONTAINS([Order_Type_L1],&quot;FDF&quot;) THEN [Orders] END)' />
            </column>
            <column caption='% Orders w/ Bins Discount' datatype='real' name='[Calculation_838795474638352391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders w/ promotions (PTool) (copia)_838795474389352453]/SUM([Orders])' />
            </column>
            <column caption='% Orders w/ Promotions (PTool)' datatype='real' name='[Calculation_838795474638397448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_838795474370514948]/SUM([Orders])' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Franchise_Name]' role='dimension' type='nominal' />
            <column caption='Last TF 2' datatype='boolean' name='[Last TF (copia)_1568941565396324376]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST()+1 &lt;= [Parameters].[Currency (copia)]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Order_Type_L1]' role='dimension' type='nominal' />
