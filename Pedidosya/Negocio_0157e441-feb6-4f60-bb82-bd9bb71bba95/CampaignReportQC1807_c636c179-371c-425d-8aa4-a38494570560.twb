            <column caption='Orders w/ Bins Discount' datatype='integer' name='[Orders w/ promotions (PTool) (copia)_838795474389352453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [Order_Type_L1]=&quot;Ptool_Bins&quot; OR [Order_Type_L1]=&quot;Ptool_Bins_FDF&quot; OR [Order_Type_L1]=&quot;Ptool_Bins_Vouchers&quot; OR [Order_Type_L1]=&quot;Ptool_Bins_FDF_Vouchers&quot; OR [Order_Type_L1]=&quot;Ptool_Bins_Other&quot; OR [Order_Type_L1]=&quot;Ptool_Bins_FDF_Other&quot; OR [Order_Type_L1]=&quot;Ptool_Bins_Vouchers_Other&quot; OR [Order_Type_L1]=&quot;Ptool_Bins_FDF_Vouchers_Other&quot; OR [Order_Type_L1]=&quot;Bins_Only&quot; OR [Order_Type_L1]=&quot;Bins_FDF&quot; OR [Order_Type_L1]=&quot;Bins_Vouchers&quot; OR [Order_Type_L1]=&quot;Bins_FDF_Vouchers&quot; OR [Order_Type_L1]=&quot;Bins_Other&quot; OR [Order_Type_L1]=&quot;Bins_Vouchers_Other&quot; OR [Order_Type_L1]=&quot;Bins_FDF_Other&quot; OR [Order_Type_L1]=&quot;Bins_FDF_Vouchers_Other&quot; THEN [Orders] END)' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[Orders]' role='measure' type='quantitative' />
            <column caption='QC Acquisition via LS' datatype='integer' name='[QC Acquisition via Dmart (copia)_1568941564999827463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [QC_Business]=&quot;Local Stores&quot; THEN [Calculation_1568941564999192580] END)' />
