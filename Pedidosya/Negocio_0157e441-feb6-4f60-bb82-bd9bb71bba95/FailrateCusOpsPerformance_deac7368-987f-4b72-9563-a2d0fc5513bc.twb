      <aliases enabled='yes' />
      <column caption='Help' datatype='string' name='[Calculation_11821965661171712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Gral FR%' datatype='real' name='[Calculation_1295629324164075520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order])/SUM([total_orders])' />
      </column>
      <column caption='cus_self_failrate%' datatype='real' datatype-customized='true' name='[Calculation_1295629324209754113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cus_fail_rate])/SUM([total_orders])' />
      </column>
      <column caption='helpcenter_fr%' datatype='real' name='[Calculation_1295629324221026307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hc_autocancel])/SUM([total_orders])' />
      </column>
      <column caption='FR_PEYA%' datatype='real' name='[Calculation_1295629324228161541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &apos;REJECTED&apos; AND [fr_owner] = &apos;PedidosYa&apos; THEN [total_orders] END)&#13;&#10;/&#13;&#10;SUM([total_orders])' />
      </column>
      <column caption='VENDOR_FR%' datatype='real' name='[Calculation_1295629324229382150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &apos;REJECTED&apos; AND [fr_owner] = &apos;Restaurant&apos; THEN [total_orders] END)&#13;&#10;/&#13;&#10;SUM([total_orders])' />
      </column>
      <column caption='USER_FR%' datatype='real' name='[Calculation_1295629324230414343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &apos;REJECTED&apos; AND [fr_owner] = &apos;User&apos; THEN [total_orders] END)&#13;&#10;/&#13;&#10;SUM([total_orders])' />
      </column>
      <column caption='Rider FR%' datatype='real' name='[Calculation_1295629324231286792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &apos;REJECTED&apos; AND [fr_owner] = &apos;Rider&apos; THEN [total_orders] END)&#13;&#10;/&#13;&#10;SUM([total_orders])' />
      </column>
      <column caption='Git' datatype='string' name='[Calculation_1546142067914465280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='granularity_date' datatype='string' name='[Calculation_158751894062784512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [order_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [order_date]))&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    // Muestra W + número de semana y el año&#13;&#10;    &quot;W&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;week&apos;, [order_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [order_date]))&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN&#13;&#10;    // Muestra la fecha completa en formato YYYY-MM-DD (formato ISO reconocido)&#13;&#10;    STR(DATEPART(&apos;year&apos;, [order_date])) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [order_date])), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, [order_date])), 2)&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='agnt_fr%' datatype='real' name='[Calculation_222083763740975105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([agent_fail_rate])/SUM([total_orders])' />
      </column>
      <column caption='FR_TotalOrders' datatype='real' name='[Calculation_2294865498952298496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Daily&apos; THEN SUM([fr_day])&#13;&#10;WHEN &apos;Weekly&apos; THEN SUM([fr_week])&#13;&#10;WHEN &apos;Monthly&apos; THEN SUM([fr_month])&#13;&#10;END' />
      </column>
