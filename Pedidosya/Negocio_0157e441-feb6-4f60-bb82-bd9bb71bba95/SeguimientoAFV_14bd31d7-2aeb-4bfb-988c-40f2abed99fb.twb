              <calculation class='tableau' formula='if [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Grupo&apos; then [grupo]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Seccion&apos; then [seccion]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Categoria&apos; then [categoria]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Producto&apos; then [product_name]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Marca&apos; then [marca_generica]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Proveedor&apos; then [proveedor_generico]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;SKU ID&apos; then [sku_id]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Tienda&apos; then [store_name]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Subcategoria&apos; then [subcategoria]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Plus&apos; then [Calculation_834291881012551683]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Voucher&apos; then [Calculation_834291881012727812]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;BIN&apos; then [Calculation_834291881012842501]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;User reorder type&apos; then [user_reorder_type]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;User shopping mission&apos; then [user_shopping_mission]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Mission type order&apos; then [mission_type]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Campaign&apos; then [campaign]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Vertical&apos; then [business_type_name]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Item Rol&apos; then [item_rol]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Category Rol&apos; then [cat_rol]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Total&apos; then &quot;Total&quot; end' />
