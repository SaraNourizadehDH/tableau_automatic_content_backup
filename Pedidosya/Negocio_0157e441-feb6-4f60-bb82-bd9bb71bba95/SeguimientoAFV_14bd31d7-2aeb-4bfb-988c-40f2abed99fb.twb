          <formatted-text>
            <run>Front Margin</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='seguimiento_afv (user_camilo_zelada)' name='federated.0zcsi4l18pr7wv1dcllng16534zf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Date Parameter' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;year&quot;' value='Year' />
              </aliases>
            </column>
            <column caption='Agrupacion' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zcsi4l18pr7wv1dcllng16534zf'>
            <column caption='Agrupado por' datatype='string' name='[Calculation_1221038449537466375]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parámetro 2]=&apos;Grupo&apos; then [grupo]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Seccion&apos; then [seccion]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Categoria&apos; then [categoria]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Producto&apos; then [product_name]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Marca&apos; then [marca_generica]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Proveedor&apos; then [proveedor_generico]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;SKU ID&apos; then [sku_id]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Tienda&apos; then [store_name]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Subcategoria&apos; then [subcategoria]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Plus&apos; then [Calculation_834291881012551683]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Voucher&apos; then [Calculation_834291881012727812]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;BIN&apos; then [Calculation_834291881012842501]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;User reorder type&apos; then [user_reorder_type]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;User shopping mission&apos; then [user_shopping_mission]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Mission type order&apos; then [mission_type]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Campaign&apos; then [campaign]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Vertical&apos; then [business_type_name]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Item Rol&apos; then [item_rol]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Category Rol&apos; then [cat_rol]&#13;&#10;elseif [Parameters].[Parámetro 2]=&apos;Total&apos; then &quot;Total&quot; end' />
            </column>
            <column caption='last' datatype='integer' name='[Calculation_1221038449548021776]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='last()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ATTR(STR(&quot;Variacion sobre ultimo periodo&quot;))' datatype='string' name='[Calculation_1458603331997290508]' role='measure' type='nominal' user:unnamed='Front margin graf (2)'>
              <calculation class='tableau' formula='ATTR(STR(&quot;Variacion sobre ultimo periodo&quot;))' />
            </column>
            <column caption='Front Margin' datatype='real' name='[Calculation_834291881010675713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum([total_cogs_wo_vat])/sum([total_amount_wo_vat]-[total_discount_wo_vat]))' />
            </column>
            <column caption='Plus' datatype='string' name='[Calculation_834291881012551683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_user_plus]=1 then &quot;Plus order&quot; else &quot;No Plus order&quot; end' />
            </column>
            <column caption='Voucher' datatype='string' name='[Calculation_834291881012727812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [has_voucher_discount]=1 then &quot;Voucher order&quot; else &quot;No voucher order&quot; end' />
            </column>
            <column caption='BINs' datatype='string' name='[Calculation_834291881012842501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [has_bins_discount]=1 then &quot;BINs order&quot; else &quot;No BINs order&quot; end' />
            </column>
            <column caption='fecha' datatype='date' name='[Calculation_896216394443583488]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATETRUNC([Parameters].[Parámetro 1], [order_date]))' />
