              <calculation class='tableau' formula='if [has_voucher_discount]=1 then &quot;Voucher order&quot; else &quot;No voucher order&quot; end' />
            </column>
            <column caption='BINs' datatype='string' name='[Calculation_834291881012842501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [has_bins_discount]=1 then &quot;BINs order&quot; else &quot;No BINs order&quot; end' />
            </column>
            <column caption='Dif GFV Semana' datatype='real' name='[Dif GFV Mes (copia)_411516446164021296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Share GFV Sobre total Mes Actual (copia)_411516446160351274] - [Share GFV Sobre total Mes Anterior (copia)_411516446159704102]' />
            </column>
            <column caption='Fixed GFV Semana Actual' datatype='real' name='[Fixed GFV Mes Actual (copia)_411516446159978536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED ISOWEEK([order_date]),[Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:&#13;&#10;    sum(&#13;&#10;    IF ISOWEEK([order_date]) = [Calculation_411516446156652573]&#13;&#10;    THEN [total_amount_wo_vat]-[total_discount_wo_vat] &#13;&#10;    END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Fixed GFV Semana Anterior' datatype='real' name='[Fixed GFV Mes Anterior (copia)_411516446159814695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED ISOWEEK([order_date]),[Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:&#13;&#10;    sum(&#13;&#10;    IF [Calculation_411516446156652573] = 1 THEN&#13;&#10;        IF ISOWEEK([order_date]) = 52 THEN [total_amount_wo_vat]-[total_discount_wo_vat] END&#13;&#10;    ELSE&#13;&#10;        IF ISOWEEK([order_date]) = [Calculation_411516446156652573]-1 THEN [total_amount_wo_vat]-[total_discount_wo_vat]&#13;&#10;        END&#13;&#10;    END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Share GFV Sobre total Semana Actual' datatype='real' name='[Share GFV Sobre total Mes Actual (copia)_411516446160351274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;    IF ISOWEEK([order_date]) = [Calculation_411516446156652573]&#13;&#10;    THEN [total_amount_wo_vat]-[total_discount_wo_vat] &#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;sum([Fixed GFV Mes Actual (copia)_411516446159978536])' />
            </column>
            <column caption='Share GFV Sobre total Semana Anterior' datatype='real' name='[Share GFV Sobre total Mes Anterior (copia)_411516446159704102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;IF [Calculation_411516446156652573] = 1 THEN&#13;&#10;    IF ISOWEEK([order_date]) = 52 THEN [total_amount_wo_vat]-[total_discount_wo_vat] END&#13;&#10;ELSE&#13;&#10;    IF ISOWEEK([order_date]) = [Calculation_411516446156652573]-1 THEN [total_amount_wo_vat]-[total_discount_wo_vat]&#13;&#10;    END&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;sum([Fixed GFV Mes Anterior (copia)_411516446159814695])' />
