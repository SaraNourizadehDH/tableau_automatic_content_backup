              <calculation class='tableau' formula='{ FIXED YEAR([order_date]),MONTH([order_date]),[Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:&#13;&#10;    sum(&#13;&#10;    IF [Parameters].[Parámetro 4] = 1 THEN&#13;&#10;        IF YEAR([order_date]) = INT([Parameters].[Parámetro 3])-1 AND MONTH([order_date]) = 12 THEN [total_amount_wo_vat]-[total_discount_wo_vat] END&#13;&#10;    ELSE&#13;&#10;        IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4]-1 THEN [total_amount_wo_vat]-[total_discount_wo_vat]&#13;&#10;        END&#13;&#10;    END&#13;&#10;    )&#13;&#10;}' />
