          <datasource-dependencies datasource='federated.0zcsi4l18pr7wv1dcllng16534zf'>
            <column caption='Max Mes' datatype='integer' name='[Calculation_323414784403693568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MONTH(MAX([order_date]))}' />
            </column>
            <column caption='Dif Theoric Margin Mes' datatype='real' name='[Calculation_411516446145155088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Theoric Margin (copia)_411516446142423051]-[Theoric Margin Mes Actual (copia)_411516446144589838]' />
