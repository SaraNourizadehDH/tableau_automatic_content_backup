rameters].[Agrupacion (copia)_704250454198046720]=&apos;Item Rol&apos; then [item_rol]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Category Rol&apos; then [cat_rol]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Total&apos; then &quot;Total&quot; end' />
            </column>
            <column caption='Max Mes' datatype='integer' name='[Calculation_323414784403693568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MONTH(MAX([order_date]))}' />
            </column>
            <column caption='Max Semana' datatype='string' name='[Calculation_323414784403947521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED : &apos;Semana &apos;+STR(ISOWEEK(MAX([order_date])))}' />
            </column>
            <column caption='Dif Theoric Margin Dmart Mes' datatype='real' name='[Calculation_411516446150258713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Theoric Margin (copia)_411516446142423051]-SUM([Theoric Margin Mes Actual (copia)_411516446149963800])' />
            </column>
            <column caption='&apos;Dif Teórico Dmart&apos;' datatype='string' name='[Calculation_411516446150516762]' role='dimension' type='nominal' user:unnamed='GFV Dif (2)'>
              <calculation class='tableau' formula='&apos;Dif Teórico Dmart&apos;' />
            </column>
            <column caption='Semanas BD' datatype='string' name='[Calculation_411516446156079132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Semana &apos; + STR(ISOWEEK([order_date]))' />
            </column>
            <column caption='Numero Semana Parametro' datatype='integer' name='[Calculation_411516446156652573]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(SPLIT([Parameters].[Parámetro 5],&apos; &apos;,2))' />
            </column>
            <column caption='Semana Actual y Anterior' datatype='boolean' name='[Calculation_411516446156927007]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISOWEEK([order_date]) = [Calculation_411516446156652573] &#13;&#10;OR IF [Calculation_411516446156652573] = 1 THEN ISOWEEK([order_date]) = 54 ELSE ISOWEEK([order_date]) = [Calculation_411516446156652573]-1 END' />
            </column>
            <column caption='Plus' datatype='string' name='[Calculation_834291881012551683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_user_plus]=1 then &quot;Plus order&quot; else &quot;No Plus order&quot; end' />
            </column>
            <column caption='Voucher' datatype='string' name='[Calculation_834291881012727812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [has_voucher_discount]=1 then &quot;Voucher order&quot; else &quot;No voucher order&quot; end' />
            </column>
            <column caption='BINs' datatype='string' name='[Calculation_834291881012842501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [has_bins_discount]=1 then &quot;BINs order&quot; else &quot;No BINs order&quot; end' />
            </column>
            <column caption='Theoric Margin Mes Actual' datatype='real' name='[Theoric Margin (copia)_411516446142423051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(&#13;&#10;    sum(IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4] THEN [total_cogs_wo_vat] END)&#13;&#10;    /&#13;&#10;    sum(IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4] THEN [total_amount_wo_vat] END)&#13;&#10;)' />
            </column>
            <column caption='Fixed Theoric Margin Mes Actual' datatype='real' name='[Theoric Margin Mes Actual (copia)_411516446149963800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED YEAR([order_date]),MONTH([order_date]),[Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:&#13;&#10;1-(&#13;&#10;    sum(IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4] THEN [total_cogs_wo_vat] END)&#13;&#10;    /&#13;&#10;    sum(IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4] THEN [total_amount_wo_vat] END)&#13;&#10;)&#13;&#10;}' />
