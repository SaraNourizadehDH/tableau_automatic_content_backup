              <calculation class='tableau' formula='if  [has_bins_discount]=1 then &quot;BINs order&quot; else &quot;No BINs order&quot; end' />
            </column>
            <column caption='Dif Theoric Margin Dmart Semana' datatype='real' name='[Dif Theoric Margin Dmart (copia)_411516446166732849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Theoric Margin Mes Actual (copia)_411516446158827554]-SUM([Fixed Theoric Margin Mes Actual (copia)_411516446161661995])' />
            </column>
            <column caption='Fixed Theoric Margin Semana Actual' datatype='real' name='[Fixed Theoric Margin Mes Actual (copia)_411516446161661995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED ISOWEEK([order_date]),[Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:&#13;&#10;1-(&#13;&#10;    sum(IF ISOWEEK([order_date]) = [Calculation_411516446156652573] THEN [total_cogs_wo_vat] END)&#13;&#10;    /&#13;&#10;    sum(IF ISOWEEK([order_date]) = [Calculation_411516446156652573] THEN [total_amount_wo_vat] END)&#13;&#10;)&#13;&#10;}' />
            </column>
            <column caption='Theoric Margin Semana Actual' datatype='real' name='[Theoric Margin Mes Actual (copia)_411516446158827554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(&#13;&#10;    sum(IF ISOWEEK([order_date]) = [Calculation_411516446156652573] THEN [total_cogs_wo_vat] END)&#13;&#10;    /&#13;&#10;    sum(IF ISOWEEK([order_date]) = [Calculation_411516446156652573] THEN [total_amount_wo_vat] END)&#13;&#10;)' />
            </column>
