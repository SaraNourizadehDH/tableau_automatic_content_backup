            </column>
            <column caption='Fixed orders total' datatype='integer' name='[Calculation_1221038449537691656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_896216394443583488], [Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:countd([order_id])}' />
            </column>
            <column caption='Descuentos' datatype='real' name='[Calculation_1221038449767002132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_discount_wo_vat])' />
