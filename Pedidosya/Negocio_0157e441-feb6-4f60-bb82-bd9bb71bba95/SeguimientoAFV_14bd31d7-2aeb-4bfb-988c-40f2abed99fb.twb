rameters].[Agrupacion (copia)_704250454198046720]=&apos;Item Rol&apos; then [item_rol]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Category Rol&apos; then [cat_rol]&#13;&#10;elseif [Parameters].[Agrupacion (copia)_704250454198046720]=&apos;Total&apos; then &quot;Total&quot; end' />
            </column>
            <column caption='Basket Size ponderado - Total' datatype='real' name='[Basket Size ponderado (copia)_1221038449769955353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1221038449533030403]*[Share ordenes (copia)_1221038449769705495]' />
            </column>
            <column caption='Voucher Share' datatype='real' name='[Bins Order Share (copia)_1706582807341998081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([has_voucher_discount]=1,[order_id],null))/[Calculation_1221038449533689862]' />
            </column>
            <column caption='Voucher or Bins Share' datatype='real' name='[Bins Order Share (copia)_1706582807342170114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([has_bins_discount]=1 or [has_voucher_discount]=1,[order_id],null))/[Calculation_1221038449533689862]' />
            </column>
            <column caption='Venta neta' datatype='real' name='[Calculation_1221038449532420096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_amount_wo_vat])-sum([total_discount_wo_vat])' />
            </column>
            <column caption='Share unidades con descuento' datatype='real' name='[Calculation_1221038449532526593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([units_sold_with_discount])/sum([units_sold])' />
            </column>
            <column caption='AVG unit price' datatype='real' name='[Calculation_1221038449532878850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1221038449532420096]/sum([units_sold])' />
            </column>
            <column caption='Unidades por orden' datatype='real' name='[Calculation_1221038449533030403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([units_sold])/countd([order_id])' />
            </column>
            <column caption='% Descuentos sobre venta sin descuentos' datatype='real' name='[Calculation_1221038449533210628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_discount_wo_vat])/sum([total_amount_wo_vat])' />
            </column>
            <column caption='AFV Net' datatype='real' name='[Calculation_1221038449533591557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1221038449532420096]/countd([order_id])' />
            </column>
            <column caption='Ordenes' datatype='integer' name='[Calculation_1221038449533689862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTd([order_id])' />
            </column>
            <column caption='Fixed orders total' datatype='integer' name='[Calculation_1221038449537691656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_896216394443583488], [Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:countd([order_id])}' />
            </column>
            <column caption='Descuentos' datatype='real' name='[Calculation_1221038449767002132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_discount_wo_vat])' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[Calculation_1569504492574904320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([acquisition],[order_id],null))' />
            </column>
            <column caption='Bins Order Share' datatype='real' name='[Calculation_1706582807341834240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([has_bins_discount]=1,[order_id],null))/[Calculation_1221038449533689862]' />
            </column>
            <column caption='Share GFV Sobre total' datatype='real' name='[Calculation_1806787928073752579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_amount_wo_vat]-[total_discount_wo_vat])/sum([Fixed orders total (copia)_1806787928073621506])' />
            </column>
            <column caption='Día semana' datatype='string' name='[Calculation_1936829327625302016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
            </column>
            <column caption='Share usuarios Instant Need' datatype='real' name='[Calculation_704250454200819715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([user_shopping_mission]=&apos;Instant need&apos;,[customer_id],null))/countd([customer_id])' />
            </column>
            <column caption='Usuarios' datatype='integer' name='[Calculation_781937488645042176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Countd([customer_id])' />
            </column>
            <column caption='Gasto medio por usuario' datatype='real' name='[Calculation_781937488645206017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1221038449532420096]/[Calculation_781937488645042176]' />
            </column>
            <column caption='Frecuencia' datatype='real' name='[Calculation_781937488645324802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1221038449533689862]/[Calculation_781937488645042176]' />
            </column>
            <column caption='Plus Share' datatype='real' name='[Calculation_834291881010524160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(iif([is_user_plus]=1,[order_id],null))/countd([order_id])' />
            </column>
            <column caption='Front Margin' datatype='real' name='[Calculation_834291881010675713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum([total_cogs_wo_vat])/sum([total_amount_wo_vat]-[total_discount_wo_vat]))' />
            </column>
            <column caption='Theoric Margin' datatype='real' name='[Calculation_834291881010761730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum([total_cogs_wo_vat])/sum([total_amount_wo_vat]))' />
            </column>
            <column caption='Plus' datatype='string' name='[Calculation_834291881012551683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_user_plus]=1 then &quot;Plus order&quot; else &quot;No Plus order&quot; end' />
            </column>
            <column caption='Voucher' datatype='string' name='[Calculation_834291881012727812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [has_voucher_discount]=1 then &quot;Voucher order&quot; else &quot;No voucher order&quot; end' />
            </column>
            <column caption='BINs' datatype='string' name='[Calculation_834291881012842501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [has_bins_discount]=1 then &quot;BINs order&quot; else &quot;No BINs order&quot; end' />
            </column>
            <column caption='fecha' datatype='date' name='[Calculation_896216394443583488]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATETRUNC([Parameters].[Parámetro 1], [order_date]))' />
            </column>
            <column caption='Fixed  GFV sin disc' datatype='real' name='[Fixed  GFV (copia)_7064177491330256909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_896216394443583488],[Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:sum([total_amount_wo_vat])}' />
            </column>
            <column caption='Fixed  GFV' datatype='real' name='[Fixed orders total (copia)_1806787928073621506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_896216394443583488],[Agrupado por (copia)_704250454198358017],[Agrupado ponderacion (copia)_704250454202769414]:sum([total_amount_wo_vat]-[total_discount_wo_vat])}' />
            </column>
            <column caption='Share GFV sin descuentos' datatype='real' name='[Share GFV Sobre total (copia)_7064177491330355214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_amount_wo_vat])/sum([Fixed  GFV (copia)_7064177491330256909])' />
            </column>
            <column caption='Share ordenes sobre total' datatype='real' name='[Share ordenes (copia)_1221038449769705495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1221038449533689862]/sum([Calculation_1221038449537691656])' />
