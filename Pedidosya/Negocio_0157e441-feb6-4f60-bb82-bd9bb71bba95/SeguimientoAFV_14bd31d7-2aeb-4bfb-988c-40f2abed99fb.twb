            </column>
            <column caption='Theoric Margin Mes Actual' datatype='real' name='[Theoric Margin (copia)_411516446142423051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(&#13;&#10;    sum(IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4] THEN [total_cogs_wo_vat] END)&#13;&#10;    /&#13;&#10;    sum(IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4] THEN [total_amount_wo_vat] END)&#13;&#10;)' />
            </column>
            <column caption='Theoric Margin Mes Anterior' datatype='real' name='[Theoric Margin Mes Actual (copia)_411516446144589838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(&#13;&#10;    sum(&#13;&#10;    IF [Parameters].[Parámetro 4] = 1 THEN&#13;&#10;        IF YEAR([order_date]) = INT([Parameters].[Parámetro 3])-1 AND MONTH([order_date]) = 12 THEN [total_cogs_wo_vat] END&#13;&#10;    ELSE&#13;&#10;        IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4]-1 THEN [total_cogs_wo_vat] &#13;&#10;        END&#13;&#10;    END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    sum(    IF [Parameters].[Parámetro 4] = 1 THEN&#13;&#10;        IF YEAR([order_date]) = INT([Parameters].[Parámetro 3])-1 AND MONTH([order_date]) = 12 THEN [total_cogs_wo_vat] END&#13;&#10;    ELSE&#13;&#10;        IF YEAR([order_date]) = INT([Parameters].[Parámetro 3]) AND MONTH([order_date]) = [Parameters].[Parámetro 4]-1 THEN [total_amount_wo_vat] &#13;&#10;        END&#13;&#10;    END&#13;&#10;    )&#13;&#10;)' />
            </column>
            <column caption='Grupo' datatype='string' name='[grupo]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_411516446172205113]' derivation='None' name='[none:Calculation_411516446172205113:nk]' pivot='key' type='nominal' />
            <column-instance column='[grupo]' derivation='None' name='[none:grupo:nk]' pivot='key' type='nominal' />
