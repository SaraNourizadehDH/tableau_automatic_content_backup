              <calculation class='tableau' formula='SUM({ FIXED  [zone_name]: AVG([zone_weights])}*{ EXCLUDE [tier], [registered_date], [hour]: SUM([peya_scrapped_df]*[orders (Custom SQL Query1)])&#13;&#10;/&#13;&#10;SUM(IF ISNULL([peya_scrapped_df]) THEN 0 ELSE[orders (Custom SQL Query1)] END)})&#13;&#10;&#13;&#10;/SUM({ FIXED  [zone_name]: AVG([zone_weights])})' />
