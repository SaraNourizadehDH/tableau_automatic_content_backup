              <calculation class='tableau' formula='0.' />
              <range granularity='0.001' max='0.1' min='0.0' />
            </column>
            <column caption='PedidosYa Service Fee' datatype='real' default-format='p0.0%' name='[uber_scrapped_df Parameter]' param-domain-type='range' role='measure' type='quantitative' value='0.045'>
