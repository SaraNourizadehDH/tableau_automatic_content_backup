              <calculation class='tableau' formula='CASE [Parameters].[Didi Service Fee (copy)] WHEN &apos;User Cost&apos; THEN [Weighted Peya Delivery Fee (copy)_1740078374494486532]&#13;&#10;    WHEN &apos;Delivery Fee&apos; THEN [Weighted Peya Delivery Fee (copy)_1771040557157539841] END' />
