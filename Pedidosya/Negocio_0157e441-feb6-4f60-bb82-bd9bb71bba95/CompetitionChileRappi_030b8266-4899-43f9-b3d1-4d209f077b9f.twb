      <column caption='Weighted Rappi Delivery Fee' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Peya Delivery Fee (copy)_1715590039219220482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rappi_scrapped_df]*[orders])/SUM(IF ISNULL([rappi_scrapped_df]) THEN 0 ELSE[orders] END)' />
