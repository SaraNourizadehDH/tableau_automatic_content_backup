          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Didi Service Fee (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;User Cost&quot;'>
              <calculation class='tableau' formula='&quot;User Cost&quot;' />
            </column>
            <column caption='UberEats Service Fee' datatype='real' default-format='p0.0%' name='[PedidosYa Service Fee (copy)_1740078374491164673]' param-domain-type='range' role='measure' type='quantitative' value='0.050000000000000003'>
