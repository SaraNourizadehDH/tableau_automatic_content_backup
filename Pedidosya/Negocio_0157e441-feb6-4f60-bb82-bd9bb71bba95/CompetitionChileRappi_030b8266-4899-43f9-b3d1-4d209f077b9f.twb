          <datasource-dependencies datasource='federated.15hgtg01wkbexl10rj25j00k7bwv'>
            <column caption='Peya/Uber' datatype='real' default-format='p0.0%' name='[Calculation_1127870288914808832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1740078374498349065]/[PedidosYa KPI (copy)_1740078374498652170]' />
            </column>
            <column caption='PedidosYa KPI' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Calculation_1740078374498349065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Didi Service Fee (copy)] WHEN &apos;User Cost&apos; THEN [Weighted Peya Delivery Fee (copy)_1740078374494486532]&#13;&#10;    WHEN &apos;Delivery Fee&apos; THEN [Weighted Peya Delivery Fee (copy)_1771040557157539841] END' />
            </column>
            <column caption='Weights ' datatype='real' default-format='p0.00%' name='[Calculation_1865053199089332226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [zone_name]: AVG([zone_weights])}' />
            </column>
            <column caption='Main competitor' datatype='real' name='[Calculation_359443612386533376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;Chile&apos; THEN [uber_scrapped_df]&#13;&#10;WHEN  &apos;Argentina&apos; THEN [rappi_scrapped_df]&#13;&#10;WHEN  &apos;Perú&apos; THEN [rappi_scrapped_df]&#13;&#10;WHEN  &apos;Uruguay&apos; THEN [rappi_scrapped_df]                 &#13;&#10;WHEN  &apos;El Salvador&apos; THEN [uber_scrapped_df]&#13;&#10;WHEN  &apos;Ecuador&apos; THEN [uber_scrapped_df] &#13;&#10;WHEN &apos;Costa Rica&apos; THEN [uber_scrapped_df] &#13;&#10;WHEN &apos;Guatemala&apos; THEN [uber_scrapped_df] &#13;&#10;WHEN &apos;República Dominicana&apos; THEN [uber_scrapped_df] END' />
            </column>
            <column caption='Date (copy)' datatype='date' name='[Date (copy)_971370152871260160]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[registered_date]' />
            </column>
            <column caption='UberEats KPI ' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[PedidosYa KPI (copy)_1740078374498652170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Didi Service Fee (copy)] WHEN &apos;User Cost&apos; THEN [Weighted Uber Delivery Fee  (copy)_1740078374495227912]&#13;&#10;    WHEN &apos;Delivery Fee&apos; THEN [Weighted Uber Delivery Fee  (copy)_1771040557179494404] END' />
            </column>
            <column caption='Rappi KPI' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[PedidosYa KPI (copy)_1740078374498828299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Didi Service Fee (copy)] WHEN &apos;User Cost&apos; THEN [Weighted Rappi Delivery Fee (copy)_1740078374494928902]&#13;&#10;    WHEN &apos;Delivery Fee&apos; THEN [Weighted Rappi Delivery Fee (copy)_1771040557179768837] END' />
            </column>
            <column caption='DPS KPI (Listing)' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[PedidosYa KPI (copy)_1740078374499536909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Didi Service Fee (copy)] WHEN &apos;User Cost&apos; THEN [Weighted Base Fee (copy)_1771040557183893511] + [Parameters].[uber_scrapped_df Parameter]*[Weighted Base Fee (copy)_1740078374490435584]&#13;&#10;    WHEN &apos;Delivery Fee&apos; THEN [Weighted Base Fee (copy)_1771040557183893511] END' />
            </column>
            <column caption='Peya/Rappi' datatype='real' default-format='p0.0%' name='[Peya/Uber (copy)_1127870288914870273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1740078374498349065]/[PedidosYa KPI (copy)_1740078374498828299]' />
            </column>
            <column caption='Peya/Didi' datatype='real' default-format='p0.0%' name='[Peya/Uber (copy)_1127870288914972674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1740078374498349065]/[Rappi KPI (copy)_1740078374499217420]' />
            </column>
            <column caption='Didi KPI' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Rappi KPI (copy)_1740078374499217420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Didi Service Fee (copy)] WHEN &apos;User Cost&apos; THEN [Weighted Didi Delivery Fee (copy)_1740078374495084551]&#13;&#10;    WHEN &apos;Delivery Fee&apos; THEN [Weighted Didi Delivery Fee (copy)_1771040557180346374] END' />
            </column>
            <column caption='Weighted AFV' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Base Fee (copy)_1740078374490435584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED  [zone_name]: AVG([zone_weights])}*{ EXCLUDE [tier], [registered_date], [hour]: SUM( [afv]*[orders (Custom SQL Query1)])&#13;&#10;/&#13;&#10;SUM(IF ISNULL([afv]) THEN 0 ELSE[orders (Custom SQL Query1)] END)})&#13;&#10;&#13;&#10;/SUM({ FIXED  [zone_name]: AVG([zone_weights])})' />
            </column>
            <column caption='Weighted Base Fee v2' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Base Fee (copy)_1771040557183893511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED  [zone_name]: AVG([zone_weights])}*{ EXCLUDE [tier], [registered_date], [hour]: SUM([base_fee]*[orders (Custom SQL Query1)])&#13;&#10;/&#13;&#10;SUM(IF ISNULL([base_fee]) THEN 0 ELSE[orders (Custom SQL Query1)] END)})&#13;&#10;&#13;&#10;/SUM({ FIXED  [zone_name]: AVG([zone_weights])})' />
            </column>
            <column caption='Weighted Didi UC' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Didi Delivery Fee (copy)_1740078374495084551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Weighted Didi Delivery Fee (copy)_1771040557180346374]+[Weighted Base Fee (copy)_1740078374490435584]*[Parameters].[UberEats Service Fee (copy)_1740078374491328515]' />
            </column>
            <column caption='Weighted Didi Delivery Fee v2' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Didi Delivery Fee (copy)_1771040557180346374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED  [zone_name]: AVG([zone_weights])}*{ EXCLUDE [tier], [registered_date], [hour]: SUM([didi_scrapped_df]*[orders (Custom SQL Query1)])&#13;&#10;/&#13;&#10;SUM(IF ISNULL([didi_scrapped_df]) THEN 0 ELSE[orders (Custom SQL Query1)] END)})&#13;&#10;&#13;&#10;/SUM({ FIXED  [zone_name]: AVG([zone_weights])})' />
            </column>
            <column caption='Weighted Peya UC' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Peya Delivery Fee (copy)_1740078374494486532]' role='measure' type='quantitative'>
