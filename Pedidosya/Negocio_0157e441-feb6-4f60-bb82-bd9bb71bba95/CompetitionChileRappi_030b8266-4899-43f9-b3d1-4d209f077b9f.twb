        <calculation class='tableau' formula='SUM({ FIXED  [zone_name]: AVG([zone_weights])}*{ EXCLUDE [tier], [registered_date], [hour]: SUM([didi_scrapped_df]*[orders (Custom SQL Query1)])&#13;&#10;/&#13;&#10;SUM(IF ISNULL([didi_scrapped_df]) THEN 0 ELSE[orders (Custom SQL Query1)] END)})&#13;&#10;&#13;&#10;/SUM({ FIXED  [zone_name]: AVG([zone_weights])})' />
      </column>
      <column caption='Weighted Uber Delivery Fee ' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Peya Delivery Fee (copy) (copy) (copy)_1715590039219286020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([uber_scrapped_df]*[orders (Custom SQL Query1)])/SUM(IF ISNULL([uber_scrapped_df]) THEN 0 ELSE[orders (Custom SQL Query1)] END)' />
      </column>
