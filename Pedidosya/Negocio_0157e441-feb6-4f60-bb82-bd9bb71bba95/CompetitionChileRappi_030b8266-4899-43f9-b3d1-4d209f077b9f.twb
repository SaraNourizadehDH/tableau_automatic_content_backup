            <column caption='Weighted Rappi Delivery Fee V2' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[Weighted Rappi Delivery Fee (copy)_1771040557179768837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED  [zone_name]: AVG([zone_weights])}*{ EXCLUDE [tier], [registered_date], [hour]: SUM([rappi_scrapped_df]*[orders (Custom SQL Query1)])&#13;&#10;/&#13;&#10;SUM(IF ISNULL([rappi_scrapped_df]) THEN 0 ELSE[orders (Custom SQL Query1)] END)})&#13;&#10;&#13;&#10;/SUM({ FIXED  [zone_name]: AVG([zone_weights])})' />
