            </column>
            <column caption='Main competitor' datatype='real' name='[Calculation_359443612386533376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;Chile&apos; THEN [uber_scrapped_df]&#13;&#10;WHEN  &apos;Argentina&apos; THEN [rappi_scrapped_df]&#13;&#10;WHEN  &apos;Perú&apos; THEN [rappi_scrapped_df]&#13;&#10;WHEN  &apos;Uruguay&apos; THEN [rappi_scrapped_df]                 &#13;&#10;WHEN  &apos;El Salvador&apos; THEN [uber_scrapped_df]&#13;&#10;WHEN  &apos;Ecuador&apos; THEN [uber_scrapped_df] &#13;&#10;WHEN &apos;Costa Rica&apos; THEN [uber_scrapped_df] &#13;&#10;WHEN &apos;Guatemala&apos; THEN [uber_scrapped_df] &#13;&#10;WHEN &apos;República Dominicana&apos; THEN [uber_scrapped_df] END' />
