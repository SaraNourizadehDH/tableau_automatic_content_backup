    <worksheet name='Evolutivo % CAMPAÑAS con órdenes'>
      <table>
        <view>
          <datasources>
            <datasource caption='vfd_selfbooking_dashboard (automated_tables_reports)' name='federated.0x8au4t1lwkj0014pd2k80ayukp3' />
          </datasources>
          <datasource-dependencies datasource='federated.0x8au4t1lwkj0014pd2k80ayukp3'>
            <column caption='% Campañas Tipo Subisidized Total Migración' datatype='real' name='[% Campañas Tipo Subisidized Activa Migración (copia)_534521001291124737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_534521001290211328])/[Calculation_262616172997492739]' />
            </column>
            <column caption='Campañas Tipo Deal Migración' datatype='integer' name='[Calculation_262616172996988928]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [tipo (migracion_deal)] = &quot;DEAL&quot; THEN [campaign_id (migracion_deal)] ELSE NULL END)' />
            </column>
            <column caption='Total Campañas Migración' datatype='integer' name='[Calculation_262616172997492739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_262616172996988928]) + ([Campañas Tipo Deal Migración (copia)_262616172997234689]) + ([Campañas Tipo SUBSIDIZED ACTIVA Migración (copia)_262616172997390338])' />
            </column>
            <column caption='% Campañas Tipo Deal Migración' datatype='real' name='[Calculation_262616172997672964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_262616172996988928])/[Calculation_262616172997492739]' />
            </column>
            <column caption='Migracion Subsidized Campaing' datatype='integer' name='[Calculation_534521001290211328]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(if [tipo (migracion_deal)] = &quot;SUBSIDIZED VENCIDA&quot; OR [tipo (migracion_deal)] = &quot;SUBSIDIZED ACTIVA&quot; THEN [campaign_id (migracion_deal)] ELSE NULL END)' />
            </column>
            <column caption='Campañas Tipo SUBSIDIZED ACTIVA Migración' datatype='integer' name='[Campañas Tipo Deal Migración (copia)_262616172997234689]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [tipo (migracion_deal)] = &quot;SUBSIDIZED ACTIVA&quot; THEN [campaign_id (migracion_deal)] ELSE NULL END)' />
            </column>
            <column caption='Campañas Tipo SUBSIDIZED VENCIDA Migración' datatype='integer' name='[Campañas Tipo SUBSIDIZED ACTIVA Migración (copia)_262616172997390338]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [tipo (migracion_deal)] = &quot;SUBSIDIZED VENCIDA&quot; THEN [campaign_id (migracion_deal)] ELSE NULL END)' />
