          </object>
          <object caption='vfd_selfbooking_dashboard' id='vfd_selfbooking_dashboard_C9E21466EB6E4FF3BB1146E371D5D096'>
            <properties context=''>
              <relation connection='bigquery.15byupx0mrsdlp155f24o0o3f0kw' name='Consulta SQL personalizada1' type='text'>select&#13;
month,&#13;
partner_id,&#13;
partner_Segment,&#13;
is_active,&#13;
vfd_partner,&#13;
total_orders,&#13;
vfd_total_orders,&#13;
vfd_self_managed_amount_eur vfd_autogestionado,&#13;
vfd_self_managed_orders ordenes_autogestionado,&#13;
vfd_total_amount_eur vfd_total,&#13;
vfd_subsidized_amount_eur,&#13;
vfd_subsidized_orders,&#13;
plus_subsidized_amount_eur,&#13;
vfd_subsidized_proxy_amount_eur,&#13;
ild_amount_eur,&#13;
vfd_weekly_amount_eur,&#13;
vfd_joker_amount_eur,&#13;
plus_shipping_amount_eur,&#13;
vfd_df0_proxy_amount_eur,&#13;
vfd_real,&#13;
vfd_no_scrap,&#13;
vfd_fake,&#13;
total_gmv_eur,&#13;
is_self_managed_partner,&#13;
case when ifnull(vfd_subsidized_amount_eur,0) + ifnull(plus_subsidized_amount_eur,0) + ifnull(vfd_subsidized_proxy_amount_eur,0) + ifnull(ild_amount_eur,0) + ifnull(vfd_weekly_amount_eur,0) &gt;&gt; 0 then true else false end as partner_deal,&#13;
case when ifnull(vfd_subsidized_amount_eur,0) + ifnull(plus_subsidized_amount_eur,0) + ifnull(vfd_subsidized_proxy_amount_eur,0) + ifnull(ild_amount_eur,0) + ifnull(vfd_weekly_amount_eur,0) + ifnull(plus_shipping_amount_eur,0) + ifnull(vfd_df0_proxy_amount_eur,0)= 0 and vfd_joker_amount_eur &gt;&gt; 0 then true else false end as partner_only_joker,&#13;
&#13;
case when ifnull(vfd_subsidized_amount_eur,0) + ifnull(plus_subsidized_amount_eur,0) + ifnull(vfd_subsidized_proxy_amount_eur,0) + ifnull(ild_amount_eur,0) + ifnull(vfd_weekly_amount_eur,0) + ifnull(vfd_joker_amount_eur,0) = 0 and ifnull(plus_shipping_amount_eur,0) + ifnull(vfd_df0_proxy_amount_eur,0) &gt;&gt; 0 then true else false end as partner_only_delivery_fee&#13;
&#13;
from `peya-delivery-and-support.automated_tables_reports.vfd_monthly` m&#13;
-- left join `peya-delivery-and-support.automated_tables_reports.vfd_dashboard_partners` d ON d.partner_id = m.partner_id&#13;
&#13;
where month &gt;&gt;=&quot;2025-03-01&quot;&#13;
&#13;
group by all&#13;
order by 1 desc</relation>
            </properties>
            <properties context='extract'>
              <relation name='vfd_selfbooking_dashboard_C9E21466EB6E4FF3BB1146E371D5D096' table='[Extract].[vfd_selfbooking_dashboard_C9E21466EB6E4FF3BB1146E371D5D096]' type='table' />
            </properties>
          </object>
