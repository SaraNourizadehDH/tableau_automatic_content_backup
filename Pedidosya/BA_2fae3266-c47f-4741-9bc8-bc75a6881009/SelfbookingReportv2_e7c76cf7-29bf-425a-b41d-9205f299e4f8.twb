      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Conversion Campañas' id='_D589DF125A4B48C99F2CA0B38864F8B8'>
            <properties context=''>
              <relation connection='bigquery.15byupx0mrsdlp155f24o0o3f0kw' name='Consulta SQL personalizada' type='text'>WITH RawData AS (&#13;
&#13;
  SELECT &#13;
    ds.id,&#13;
    ds.name,&#13;
    ds.status AS campaign_status,&#13;
    ds.from_date,&#13;
    ds.to_date,&#13;
    date_trunc(p._ingested_at, month) AS mes,&#13;
    p.status AS partner_status,&#13;
    partner_id,&#13;
    targeted_product_id,&#13;
    joined_product_id,&#13;
    accvp.origen,&#13;
    accvp.vfd_campanias_autogestion AS vfd_autogestion&#13;
  FROM peya-data-origins-pro.cl_growth.ops_portal_self_mgmt_campaign smc&#13;
  INNER JOIN peya-data-origins-pro.cl_growth.deals_strategies ds &#13;
    ON ds.id = smc.strategy_id&#13;
  INNER JOIN peya-data-origins-pro.cl_growth.ops_portal_self_mgmt_campaign_proposal p &#13;
    ON p.self_management_id = smc.id&#13;
  LEFT JOIN UNNEST(p.partners_ids) AS partner_id&#13;
  LEFT JOIN UNNEST(p.targeted_products_ids) AS targeted_product_id&#13;
  LEFT JOIN UNNEST(p.joined_products_ids) AS joined_product_id&#13;
  LEFT JOIN `peya-delivery-and-support.automated_tables_reports.vfd_selfbooking_dashboard_acc_vp` accvp&#13;
    ON accvp.strategy_id = ds.id &#13;
    AND partner_id = accvp.partner_id &#13;
    AND CAST(joined_product_id AS STRING) = CAST(accvp.item_id AS STRING)&#13;
  WHERE UPPER(ds.status) = &apos;ACTIVE&apos;&#13;
)&#13;
&#13;
&#13;
SELECT &#13;
  id,&#13;
  name,&#13;
  campaign_status,&#13;
  from_date,&#13;
  to_date,&#13;
  mes,&#13;
  partner_status,&#13;
  partner_id,&#13;
  targeted_product_id,&#13;
  joined_product_id,&#13;
  vfd_autogestion,&#13;
&#13;
  MAX(CASE WHEN origen != &apos;Carga Masiva&apos; THEN origen END) AS origen_corregido&#13;
FROM RawData&#13;
GROUP BY  ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='_D589DF125A4B48C99F2CA0B38864F8B8' table='[Extract].[_D589DF125A4B48C99F2CA0B38864F8B8]' type='table' />
            </properties>
          </object>
