        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.15byupx0mrsdlp155f24o0o3f0kw' name='Consulta SQL personalizada' type='text'>WITH RawData AS (&#13;
&#13;
  SELECT &#13;
    ds.id,&#13;
    ds.name,&#13;
    ds.status AS campaign_status,&#13;
    ds.from_date,&#13;
    ds.to_date,&#13;
    date_trunc(p._ingested_at, month) AS mes,&#13;
    p.status AS partner_status,&#13;
    partner_id,&#13;
    targeted_product_id,&#13;
    joined_product_id,&#13;
    accvp.origen,&#13;
    accvp.vfd_campanias_autogestion AS vfd_autogestion&#13;
  FROM peya-data-origins-pro.cl_growth.ops_portal_self_mgmt_campaign smc&#13;
  INNER JOIN peya-data-origins-pro.cl_growth.deals_strategies ds &#13;
    ON ds.id = smc.strategy_id&#13;
  INNER JOIN peya-data-origins-pro.cl_growth.ops_portal_self_mgmt_campaign_proposal p &#13;
    ON p.self_management_id = smc.id&#13;
  LEFT JOIN UNNEST(p.partners_ids) AS partner_id&#13;
  LEFT JOIN UNNEST(p.targeted_products_ids) AS targeted_product_id&#13;
  LEFT JOIN UNNEST(p.joined_products_ids) AS joined_product_id&#13;
  LEFT JOIN `peya-delivery-and-support.automated_tables_reports.vfd_selfbooking_dashboard_acc_vp` accvp&#13;
    ON accvp.strategy_id = ds.id &#13;
    AND partner_id = accvp.partner_id &#13;
    AND CAST(joined_product_id AS STRING) = CAST(accvp.item_id AS STRING)&#13;
  WHERE UPPER(ds.status) = &apos;ACTIVE&apos;&#13;
)&#13;
&#13;
&#13;
SELECT &#13;
  id,&#13;
  name,&#13;
  campaign_status,&#13;
  from_date,&#13;
  to_date,&#13;
  mes,&#13;
  partner_status,&#13;
  partner_id,&#13;
  targeted_product_id,&#13;
  joined_product_id,&#13;
  vfd_autogestion,&#13;
&#13;
  MAX(CASE WHEN origen != &apos;Carga Masiva&apos; THEN origen END) AS origen_corregido&#13;
FROM RawData&#13;
GROUP BY  ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.15byupx0mrsdlp155f24o0o3f0kw' name='Consulta SQL personalizada1' type='text'>select&#13;
month,&#13;
partner_id,&#13;
partner_Segment,&#13;
is_active,&#13;
vfd_partner,&#13;
total_orders,&#13;
vfd_total_orders,&#13;
vfd_self_managed_amount_eur vfd_autogestionado,&#13;
vfd_self_managed_orders ordenes_autogestionado,&#13;
vfd_total_amount_eur vfd_total,&#13;
vfd_subsidized_amount_eur,&#13;
vfd_subsidized_orders,&#13;
plus_subsidized_amount_eur,&#13;
vfd_subsidized_proxy_amount_eur,&#13;
ild_amount_eur,&#13;
vfd_weekly_amount_eur,&#13;
vfd_joker_amount_eur,&#13;
plus_shipping_amount_eur,&#13;
vfd_df0_proxy_amount_eur,&#13;
vfd_real,&#13;
vfd_no_scrap,&#13;
vfd_fake,&#13;
total_gmv_eur,&#13;
is_self_managed_partner,&#13;
case when ifnull(vfd_subsidized_amount_eur,0) + ifnull(plus_subsidized_amount_eur,0) + ifnull(vfd_subsidized_proxy_amount_eur,0) + ifnull(ild_amount_eur,0) + ifnull(vfd_weekly_amount_eur,0) &gt;&gt; 0 then true else false end as partner_deal,&#13;
case when ifnull(vfd_subsidized_amount_eur,0) + ifnull(plus_subsidized_amount_eur,0) + ifnull(vfd_subsidized_proxy_amount_eur,0) + ifnull(ild_amount_eur,0) + ifnull(vfd_weekly_amount_eur,0) + ifnull(plus_shipping_amount_eur,0) + ifnull(vfd_df0_proxy_amount_eur,0)= 0 and vfd_joker_amount_eur &gt;&gt; 0 then true else false end as partner_only_joker,&#13;
&#13;
case when ifnull(vfd_subsidized_amount_eur,0) + ifnull(plus_subsidized_amount_eur,0) + ifnull(vfd_subsidized_proxy_amount_eur,0) + ifnull(ild_amount_eur,0) + ifnull(vfd_weekly_amount_eur,0) + ifnull(vfd_joker_amount_eur,0) = 0 and ifnull(plus_shipping_amount_eur,0) + ifnull(vfd_df0_proxy_amount_eur,0) &gt;&gt; 0 then true else false end as partner_only_delivery_fee&#13;
&#13;
from `peya-delivery-and-support.automated_tables_reports.vfd_monthly` m&#13;
-- left join `peya-delivery-and-support.automated_tables_reports.vfd_dashboard_partners` d ON d.partner_id = m.partner_id&#13;
&#13;
where month &gt;&gt;=&quot;2025-03-01&quot;&#13;
&#13;
group by all&#13;
order by 1 desc</relation>
