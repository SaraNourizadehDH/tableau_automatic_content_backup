            <column caption='Ads/GMV % Overall YOY' datatype='real' name='[Ads/GMV % YOY (copia)_291045148940124163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([GMV_eu (Consulta SQL personalizada9)] &gt; 0 and [Revenue_eu (Consulta SQL personalizada9)]&gt;0 )&#13;&#10;THEN ROUND(([Revenue_eu (Consulta SQL personalizada9)]/[GMV_eu (Consulta SQL personalizada9)])*100 ,2)&#13;&#10;ELSE 0&#13;&#10;END' />
