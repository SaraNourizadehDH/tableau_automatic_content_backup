      <column caption='calc KPI' datatype='real' name='[Calculation_702280088760885248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Ads/GMV %&quot; THEN  [Ads_GMV (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Ads/GMV % in Partners w/NCR&quot; THEN [Ads_GMV_In_Partners_w_NCR (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Ads/GMV % Overall&quot; THEN [Ads_GMV_Overall (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;GMV (EUR)&quot; THEN [GMV_eu (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;GMV in Partners w/NCR Ads (EUR)&quot; THEN [GMV_eu_w_NCR (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;GMV (Bs)&quot; THEN [GMV_lc (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;GMV in Partners w/NCR Ads (Bs)&quot; THEN [GMV_lc_w_NCR (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Active Food Partners&quot; THEN [Partner_Active (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Recurring Partners in NCR (LM,%)&quot; THEN [Partner_NCR_Recurrente_LM1_Porcentual (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Recurring Partners in NCR (L3M,%)&quot;  THEN [Partner_NCR_Recurrente_LM3_Porcentual (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Recurring Partners in NCR (LM)&quot;  THEN [Partner_NCR_Recurrente_M1 (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Recurring Partners in NCR (L3M)&quot;  THEN [Partner_NCR_Recurrente_M1M2M3 (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;New Partners in NCR (L3M)&quot; THEN [Partner_NCR_Recurrente_M1M2M3_New (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;New Partners in NCR (L3M,%)&quot; THEN [Partner_NCR_Recurrente_New_LM3_Porcentual (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;New Partners in NCR (all-time)&quot; THEN [Partner_New_NCR (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;New Partners in NCR (all-time,%)&quot; THEN [Partner_New_NCR_Porcentual (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Active Partners w/Ads&quot; THEN   [Partner_w_NCR (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Active Partners w/Ads %&quot; THEN  [Partner_w_NCR_Porcentual (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Ads Revenue (EUR)&quot; THEN [Revenue_eu (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Ads Revenue in Partners w/NCR (EUR)&quot; THEN  [Revenue_eu_partner_w_NCR (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Ads Revenue (Bs)&quot; THEN  [Revenue_lc (Consulta SQL personalizada9)]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &quot;Ads Revenue in Partners w/NCR (Bs)&quot; THEN  [Revenue_lc_partner_w_NCR (Consulta SQL personalizada9)]&#13;&#10;ELSE NULL END' />
