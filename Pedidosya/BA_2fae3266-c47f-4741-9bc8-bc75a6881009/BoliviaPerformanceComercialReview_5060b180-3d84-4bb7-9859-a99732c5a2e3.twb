          <datasource-dependencies datasource='federated.0c4k3y619pkndt1ghhocf0u9332i'>
            <column caption='Ads/GMV %' datatype='real' name='[Calculation_1294784907078258690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([GMV_eu] &gt; 0 and  [Revenue_eu]&gt;0 )&#13;&#10;THEN ROUND(([Revenue_eu]/[GMV_eu])*100 ,2)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Partner NCR Recurrente New (LM3) %' datatype='real' name='[Calculation_1642406503979012096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Partner_NCR_Recurrente_M1M2M3_New] &gt; 0 and  [Partner_Active] &gt; 0)&#13;&#10;THEN ROUND(( [Partner_NCR_Recurrente_M1M2M3_New]/ [Partner_Active])*100,2)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Ads/GMV % In Partners w/NCR' datatype='real' name='[Calculation_400257431329894402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Revenue_eu] &gt; 0 and  [GMV_eu_w_NCR] &gt; 0)&#13;&#10;THEN ROUND(([Revenue_eu]/ [GMV_eu_w_NCR] )*100,2)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Partner w/NCR %' datatype='real' name='[Calculation_400257431375335428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Partner_w_NCR] &gt; 0 and  [Partner_Active] &gt; 0)&#13;&#10;THEN ROUND(([Partner_w_NCR]/[Partner_Active])*100,2)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Partner New NCR %' datatype='real' name='[Calculation_400257431376707590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Partner_New_NCR] &gt; 0 and  [Partner_Active] &gt; 0)&#13;&#10;THEN ROUND(([Partner_New_NCR]/[Partner_Active])*100,2)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Partner NCR Recurrente (LM1) %' datatype='real' name='[Calculation_400257431376916487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Partner_NCR_Recurrente_M1] &gt; 0 and  [Partner_Active] &gt; 0)&#13;&#10;THEN ROUND(([Partner_NCR_Recurrente_M1]/[Partner_Active])*100,2)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Partner NCR Recurrente (LM3) %' datatype='real' name='[Calculation_400257431378763784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Partner_NCR_Recurrente_M1M2M3] &gt; 0 and  [Partner_Active] &gt; 0)&#13;&#10;THEN ROUND(([Partner_NCR_Recurrente_M1M2M3] / [Partner_Active])*100,2)&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Ads/GMV % - Overall' datatype='real' name='[Calculation_479351901964992512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([GMV_eu] &gt; 0 and  [Revenue_eu]&gt;0 )&#13;&#10;THEN ROUND(([Revenue_eu]/[GMV_eu])*100 ,2)&#13;&#10;ELSE 0&#13;&#10;END' />
