      <column datatype='integer' name='[ACTIVE_PARTERNS_PLUS]' role='measure' type='quantitative' />
      <column caption='Ads/GMV % Overall YOY' datatype='real' name='[Ads/GMV % YOY (copia)_291045148940124163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([GMV_eu (Consulta SQL personalizada9)] &gt; 0 and [Revenue_eu (Consulta SQL personalizada9)]&gt;0 )&#13;&#10;THEN ROUND(([Revenue_eu (Consulta SQL personalizada9)]/[GMV_eu (Consulta SQL personalizada9)])*100 ,2)&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Ads/GMV % YOY In Partners w/NCR' datatype='real' name='[Ads/GMV % YOY (copia)_291045148940230660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ( [GMV_eu_w_NCR (Consulta SQL personalizada9)] &gt; 0 and [Revenue_eu (Consulta SQL personalizada9)]&gt;0 )&#13;&#10;THEN ROUND(([Revenue_eu (Consulta SQL personalizada9)]/ [GMV_eu_w_NCR (Consulta SQL personalizada9)] )*100 ,2)&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='FIRST_REG' datatype='boolean' name='[Calculation_1068760504644239360]' role='measure' type='nominal'>
        <calculation class='tableau' formula='FIRST() &lt;= 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Ads/GMV %' datatype='real' name='[Calculation_1294784907078258690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([GMV_eu] &gt; 0 and  [Revenue_eu]&gt;0 )&#13;&#10;THEN ROUND(([Revenue_eu]/[GMV_eu])*100 ,2)&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Partners Color' datatype='string' name='[Calculation_1617918190125101058]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if &#13;&#10;(((ZN(SUM([online_partners])) - LOOKUP(ZN(SUM([online_partners])), -1)) / ABS(LOOKUP(ZN(SUM([online_partners])), -1))) &gt; 0) then &quot;Positivo&quot;&#13;&#10;&#13;&#10;else &quot;Negativo&quot;&#13;&#10;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Partner NCR Recurrente New (LM3) %' datatype='real' name='[Calculation_1642406503979012096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Partner_NCR_Recurrente_M1M2M3_New] &gt; 0 and  [Partner_Active] &gt; 0)&#13;&#10;THEN ROUND(( [Partner_NCR_Recurrente_M1M2M3_New]/ [Partner_Active])*100,2)&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='LAST_YOY' datatype='boolean' name='[Calculation_291045148936851457]' role='measure' type='nominal'>
