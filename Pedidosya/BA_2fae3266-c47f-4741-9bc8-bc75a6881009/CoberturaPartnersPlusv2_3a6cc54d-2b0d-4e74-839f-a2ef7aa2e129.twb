    <worksheet name='Share of Cofunding (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='14'> % Cofondeo por segmento</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Partners KPIs' name='federated.1m1hcqo1d5au9w1bo747e0vw9hbj' />
          </datasources>
          <datasource-dependencies datasource='federated.1m1hcqo1d5au9w1bo747e0vw9hbj'>
            <column caption='% Cofondeo partners' datatype='real' name='[% Cofondeo ordenes (copia)_1131529441962635267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Cofondeo ordenes (copia)_1131529441962500098])/COUNTD([Partner_Id])' />
            </column>
            <column caption='% orders w FT' datatype='real' default-format='p0%' name='[% orders w fee (copia)_767300835331399683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([COFUNDABLE_ORDERS])-SUM([COFUNDED_ORDERS]))/SUM([COFUNDABLE_ORDERS]),0)' />
            </column>
            <column caption='Account Owner' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
            <column datatype='string' name='[Area]' role='dimension' type='nominal' />
            <column datatype='string' name='[Business]' role='dimension' type='nominal' />
            <column caption='Cobro Flag' datatype='string' name='[COBRO_FLAG]' role='dimension' type='nominal' />
            <column datatype='integer' name='[COFUNDABLE_ORDERS]' role='measure' type='quantitative' />
            <column caption='Cofunded Amount' datatype='real' name='[COFUNDED_AMOUNT]' role='measure' type='quantitative' />
            <column caption='Cofunded Order' datatype='integer' name='[COFUNDED_ORDERS]' role='measure' type='quantitative' />
            <column caption='Orders Pagadoras' datatype='integer' name='[Calculation_1131529441954897920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [COBRO_FLAG] WHEN &quot;Pagando&quot; THEN [TOTAL_ORDERS] END' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_2104025481222803457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Partner_Segment] WHEN IN(&quot;A&quot;, &quot;A1&quot;, &quot;A2&quot;,&quot;B&quot;,&quot;B1&quot;,&quot;B2&quot;,&quot;C&quot;,&quot;C1&quot;,&quot;C2&quot;,&quot;D&quot;,&quot;D1&quot;,&quot;D2&quot;,&quot;D3&quot;)&#13;&#10;THEN &quot;Long Tail&quot; ELSE [Partner_Segment] END' />
            </column>
            <column caption='% orders w fee' datatype='real' default-format='p0%' name='[Calculation_767300835330158594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((SUM([COFUNDED_ORDERS])/SUM([COFUNDABLE_ORDERS])),0)' />
            </column>
            <column caption='Category Name' datatype='string' name='[Category_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Cofondeo partners' datatype='integer' name='[Cofondeo ordenes (copia)_1131529441962500098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [COBRO_FLAG] WHEN &quot;Pagando&quot; THEN [Partner_Id] END' />
            </column>
            <column caption='Cofunded' datatype='real' name='[Cofunded Order (copia)_1470988265467367428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COFUNDED_ORDERS])/SUM([PLUS_ORDERS])' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Orders FT' datatype='integer' name='[FT Orders (copia)_1286059205962399745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [COBRO_FLAG] WHEN &quot;FT&quot; THEN [TOTAL_ORDERS] ELSE 0 END' />
            </column>
            <column caption='Must Have' datatype='string' name='[Must_Have]' role='dimension' type='nominal' />
            <column caption='Orders Non Plus' datatype='integer' name='[Non Plus Orders (copia)_1286059205961863168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [COBRO_FLAG] WHEN &quot;Non Plus&quot; THEN [TOTAL_ORDERS] ELSE 0 END' />
            </column>
            <column datatype='string' name='[Oficina]' role='dimension' type='nominal' />
            <column aggregation='Attribute' caption='Paying Orders' datatype='integer' name='[Orders FT (copia)_1317021453089185795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [COBRO_FLAG] : SUM(CASE [COBRO_FLAG] WHEN &quot;Pagando&quot; THEN [TOTAL_ORDERS] ELSE 0 END)}' />
            </column>
            <column aggregation='Attribute' caption='Non Plus Orders' datatype='integer' name='[Orders Paying (copia)_1317021453089529861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [COBRO_FLAG] : SUM(CASE [COBRO_FLAG] WHEN &quot;Non Plus&quot; THEN [TOTAL_ORDERS] ELSE 0 END)}' />
            </column>
            <column aggregation='Attribute' caption='FT Orders' datatype='integer' name='[Orders Plus (copia)_1317021453088837634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [COBRO_FLAG] : SUM(CASE [COBRO_FLAG] WHEN &quot;FT&quot; THEN [TOTAL_ORDERS] ELSE 0 END)}' />
            </column>
            <column datatype='integer' name='[PLUS_ORDERS]' role='measure' type='quantitative' />
            <column caption='Pp Flag' datatype='string' name='[PP_FLAG]' role='dimension' type='nominal' />
            <column datatype='string' name='[PP_FLAG_HISTORICO]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Partner Id' datatype='integer' name='[Partner_Id]' role='dimension' type='ordinal' />
            <column caption='Partner Segment' datatype='string' name='[Partner_Segment]' role='dimension' type='nominal' />
            <column caption='Partners Plus' datatype='integer' name='[Partners Plus H (copia)_1067071673052090368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [PP_FLAG] WHEN &quot;Plus&quot; THEN [Partner_Id] END)' />
            </column>
            <column caption='PeYa 100off' datatype='real' name='[PeYa_100off (copia)_1470988265467244547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([PeYa_100off])/ sum([PLUS_ORDERS])' />
            </column>
            <column datatype='integer' name='[PeYa_100off]' role='measure' type='quantitative' />
            <column datatype='integer' name='[TOTAL_ORDERS]' role='measure' type='quantitative' />
            <column caption='Partners Plus H' datatype='integer' name='[Total Partners (copia)_356065862774169602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [PP_FLAG_HISTORICO] WHEN &quot;Plus H&quot; THEN [Partner_Id] END)' />
            </column>
            <column-instance column='[Orders FT (copia)_1317021453089185795]' derivation='Attribute' name='[attr:Orders FT (copia)_1317021453089185795:qk]' pivot='key' type='quantitative' />
