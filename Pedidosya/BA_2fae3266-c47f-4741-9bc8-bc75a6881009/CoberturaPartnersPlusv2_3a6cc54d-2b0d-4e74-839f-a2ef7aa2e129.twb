    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Diagnóstico Partner'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/DashPartners/DiagnsticoPartner?rev=' id='DiagnsticoPartner' path='/t/Pedidosya/workbooks/CoberturaPartnersPlusv2' revision='' site='Pedidosya' />
