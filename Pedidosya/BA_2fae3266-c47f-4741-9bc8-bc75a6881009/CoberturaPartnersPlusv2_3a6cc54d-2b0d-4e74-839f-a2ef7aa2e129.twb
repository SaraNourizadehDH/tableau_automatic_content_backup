      <aliases enabled='yes' />
      <column caption='% Cobertura DF Sin Fact Manual' datatype='real' default-format='p0.0%' name='[% Cobertura DF (copia)_1038079738214871040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(COFUNDED_AMOUNT_EUR_LISTING_DF) )&#13;&#10;/&#13;&#10;SUM(DISCOUNT_AMOUNT_EUR_LISTING_DF)' />
      </column>
      <column caption='% Cobertura Partners Paying' datatype='real' default-format='p0.0%' name='[% Cobertura Partners FT (copia)_1849853563009028105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COBERTURA_PARTNERS_PAYING])/SUM([COBERTURA_PARTNERS])' />
      </column>
      <column caption='% Cobertura Órdenes Free Trial' datatype='real' default-format='p0.0%' name='[% Cobertura Órdenes (copia)_1849853563003965443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COBERTURA_ORDENES_FT])/SUM([COBERTURA_ORDENES])' />
      </column>
      <column caption='% Cobertura Órdenes Paying' datatype='real' default-format='p0.0%' name='[% Cobertura Órdenes Free Trial (copia)_1849853563004116996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COBERTURA_ORDENES_PAYING])/SUM([COBERTURA_ORDENES])' />
      </column>
      <column caption='% Cofondeo partners' datatype='real' name='[% Cofondeo ordenes (copia)_1131529441962635267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Cofondeo ordenes (copia)_1131529441962500098])/COUNTD([Partner_Id])' />
      </column>
      <column caption='% Cofondeo partners FR' datatype='real' name='[% Cofondeo partners (copia)_645140698588344321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Cofondeo partners (copia)_645140698587987968])/COUNTD([Calculation_1676746471634878466])' />
      </column>
      <column caption='% Orders Deals Penetration' datatype='real' default-format='p0.0%' name='[% Partners Deals Penetration (copia)_688206336212480006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PLUS_ORDERS_W_PS])/SUM([PLUS_ORDERS])' />
      </column>
      <column caption='% orders w FT' datatype='real' default-format='p0%' name='[% orders w fee (copia)_767300835331399683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((SUM([COFUNDABLE_ORDERS])-SUM([COFUNDED_ORDERS]))/SUM([COFUNDABLE_ORDERS]),0)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1m1hcqo1d5au9w1bo747e0vw9hbj].[sum:PLUS_ORDERS:qk]&quot;' value='Plus Orders' />
          <alias key='&quot;[federated.1m1hcqo1d5au9w1bo747e0vw9hbj].[sum:TOTAL_ORDERS:qk]&quot;' value='Total Orders' />
        </aliases>
      </column>
      <column caption='Account Owner' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
      <column caption='BO Status' datatype='string' name='[BO_Status]' role='dimension' type='nominal' />
      <column datatype='integer' name='[COBERTURA_ORDENES]' role='measure' type='quantitative' />
      <column datatype='integer' name='[COBERTURA_ORDENES_FT]' role='measure' type='quantitative' />
      <column datatype='integer' name='[COBERTURA_ORDENES_PAYING]' role='measure' type='quantitative' />
      <column datatype='integer' name='[COBERTURA_PARTNERS]' role='measure' type='quantitative' />
      <column datatype='integer' name='[COBERTURA_PARTNERS_FT]' role='measure' type='quantitative' />
      <column datatype='integer' name='[COBERTURA_PARTNERS_PAYING]' role='measure' type='quantitative' />
      <column caption='Cobro Flag' datatype='string' name='[COBRO_FLAG]' role='dimension' type='nominal' />
      <column datatype='integer' name='[COFUNDABLE_ORDERS]' role='measure' type='quantitative' />
      <column caption='Cofunded Amount' datatype='real' name='[COFUNDED_AMOUNT]' role='measure' type='quantitative' />
      <column datatype='real' name='[COFUNDED_AMOUNT_EUR_LISTING_DF]' role='measure' type='quantitative' />
      <column caption='Cofunded Order' datatype='integer' name='[COFUNDED_ORDERS]' role='measure' type='quantitative' />
      <column caption='Orders Pagadoras' datatype='integer' name='[Calculation_1131529441954897920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [COBRO_FLAG] WHEN &quot;Pagando&quot; THEN [TOTAL_ORDERS] END' />
      </column>
      <column caption='% Cofondeo ordenes' datatype='real' name='[Calculation_1131529441955090433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([Calculation_1131529441954897920])/SUM([TOTAL_ORDERS]),0)' />
      </column>
      <column caption='YearMonth' datatype='string' name='[Calculation_1171780334191280160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year([mes]))+&apos;-&apos;+str(month([mes]))' />
      </column>
      <column caption='Apertura KPI por semgento' datatype='real' default-format='p0%' name='[Calculation_1427359630011863048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Locación (copia)]&#13;&#10;when &apos;%Cobertura Órdenes&apos; then [Calculation_1849853563003846658]&#13;&#10;when &apos;%Cobertura Partners&apos; then [Calculation_1849853563005452295]&#13;&#10;when &apos;%Cofondeo&apos; then [Partners Plus orders (copia)_1820017211006922755]&#13;&#10;END' />
      </column>
      <column caption='Locación' datatype='string' name='[Calculation_1439463075353006080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN  &apos;Pais&apos; THEN [Country]&#13;&#10;WHEN  &apos;Ciudad&apos; THEN [City]&#13;&#10;WHEN &apos;Area&apos; THEN [Area]&#13;&#10;WHEN &apos;Oficina&apos; THEN [Oficina]&#13;&#10;WHEN &apos;Reino&apos; THEN [Reino] &#13;&#10;END' />
      </column>
      <column caption='Share 1' datatype='integer' name='[Calculation_1484217594559336448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Condicional Orders' datatype='string' name='[Calculation_1484217594561241091]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Partners Plus (copia)_1820017211006291970] &gt; 0.7 &#13;&#10;THEN &quot;Positivo&quot; &#13;&#10;ELSE &quot;Negativo&quot; &#13;&#10;END' />
      </column>
      <column caption='Penetración Plus' datatype='real' default-format='p0.0%' name='[Calculation_1601029694330392578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PLUS_ORDERS])/SUM([TOTAL_ORDERS])' />
      </column>
      <column caption='Partners' datatype='string' name='[Calculation_1676746471634878466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Franchise] WHEN &quot;-&quot; THEN [Partner_Name] ELSE [Franchise] END' />
      </column>
      <column caption='Share Partners Plus' datatype='real' default-format='p0%' name='[Calculation_1820017211005046785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE   [PP_FLAG] WHEN  &quot;Plus&quot; THEN [Partner_Id] END)&#13;&#10;/COUNTD([Partner_Id])' />
      </column>
      <column caption='% Órdenes co-fondeadas' datatype='real' default-format='p0.0%' name='[Calculation_1849853563002830849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COFUNDED_ORDERS])/SUM([COFUNDABLE_ORDERS])' />
      </column>
      <column caption='% Cobertura Órdenes' datatype='real' default-format='p0.0%' name='[Calculation_1849853563003846658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COBERTURA_ORDENES])/SUM([TOTAL_ORDERS])' />
      </column>
      <column caption='% Cobertura Partners' datatype='real' default-format='p0.0%' name='[Calculation_1849853563005452295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COBERTURA_PARTNERS])/SUM([TOTAL_PARTNERS])' />
      </column>
      <column caption='% Cobertura Partners FT' datatype='real' default-format='p0.0%' name='[Calculation_1849853563008909320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COBERTURA_PARTNERS_FT])/SUM([COBERTURA_PARTNERS])' />
      </column>
      <column caption='% Cobertura DF' datatype='real' default-format='p0.0%' name='[Calculation_1849853563009478666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(COFUNDED_AMOUNT_EUR_LISTING_DF) + AVG(EXTRA_MANUAL_BILLING_EUR))&#13;&#10;/&#13;&#10;SUM(DISCOUNT_AMOUNT_EUR_LISTING_DF)' />
      </column>
      <column caption='% Partners Deals Penetration' datatype='real' default-format='p0.0%' name='[Calculation_1849853563009875979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(PLUS_PARTNERS_W_PS)/SUM([PLUS_PARTNERS_FOOD_H])' />
      </column>
      <column caption='P1' datatype='boolean' name='[Calculation_1849853563261718541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[mes]=[Parameters].[month Parámetro]' />
      </column>
      <column caption='P1 &amp; P2' datatype='boolean' name='[Calculation_1849853563287130132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[mes]=[Parameters].[month Parámetro]&#13;&#10;OR&#13;&#10;[mes] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,[Parameters].[month Parámetro]))' />
      </column>
      <column caption='Δ Cobertura Partners' datatype='string' name='[Calculation_1849853563287695382]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;(SUM(IF [Calculation_1849853563261718541] THEN [COBERTURA_PARTNERS] END)/SUM(IF [Calculation_1849853563261718541] THEN [TOTAL_PARTNERS] END))&#13;&#10;&gt;&#13;&#10;(SUM(IF [P1 (copia)_1849853563286646802] THEN [COBERTURA_PARTNERS] END)/SUM(IF [P1 (copia)_1849853563286646802] THEN [TOTAL_PARTNERS] END))&#13;&#10;&#13;&#10;THEN&#13;&#10;&apos;SI&apos;&#13;&#10;&#13;&#10;ELSE &#13;&#10;&#13;&#10;&apos;NO&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_2104025481222803457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Partner_Segment] WHEN IN(&quot;A&quot;, &quot;A1&quot;, &quot;A2&quot;,&quot;B&quot;,&quot;B1&quot;,&quot;B2&quot;,&quot;C&quot;,&quot;C1&quot;,&quot;C2&quot;,&quot;D&quot;,&quot;D1&quot;,&quot;D2&quot;,&quot;D3&quot;)&#13;&#10;THEN &quot;Long Tail&quot; ELSE [Partner_Segment] END' />
