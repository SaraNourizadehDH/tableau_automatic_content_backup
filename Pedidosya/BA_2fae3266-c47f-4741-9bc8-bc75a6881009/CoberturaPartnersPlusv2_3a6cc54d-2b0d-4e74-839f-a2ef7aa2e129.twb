            <column caption='KPI Principal Numerador' datatype='real' name='[KPI Principal Total (copia)_698620916360708098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Apertura Segmento (copia)_698620916358991872]&#13;&#10;    WHEN &apos;%Cobertura Partners&apos; THEN [COBERTURA_PARTNERS]&#13;&#10;    WHEN &apos;%Cobertura Órdenes&apos; THEN [PLUS_ORDERS]&#13;&#10;    WHEN &apos;%Cobertura DF&apos; THEN [COFUNDED_AMOUNT_EUR_LISTING_DF]&#13;&#10;    WHEN &apos;%Cofondeo&apos; THEN [COFUNDED_ORDERS]&#13;&#10;END' />
