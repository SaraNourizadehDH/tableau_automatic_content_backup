    <worksheet name='Share of Cofunding'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='14'> % Cofondeo por segmento</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Partners KPIs' name='federated.1m1hcqo1d5au9w1bo747e0vw9hbj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Apertura Segmento' datatype='string' name='[Locación (copia)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\%Cofondeo&quot;'>
              <calculation class='tableau' formula='&quot;%Cofondeo&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1m1hcqo1d5au9w1bo747e0vw9hbj'>
            <column caption='Account Owner' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
            <column datatype='string' name='[Area]' role='dimension' type='nominal' />
            <column datatype='string' name='[Business]' role='dimension' type='nominal' />
            <column datatype='integer' name='[COBERTURA_ORDENES]' role='measure' type='quantitative' />
            <column datatype='integer' name='[COBERTURA_PARTNERS]' role='measure' type='quantitative' />
            <column datatype='integer' name='[COFUNDABLE_ORDERS]' role='measure' type='quantitative' />
            <column caption='Cofunded Order' datatype='integer' name='[COFUNDED_ORDERS]' role='measure' type='quantitative' />
            <column caption='Apertura KPI por semgento' datatype='real' default-format='p0%' name='[Calculation_1427359630011863048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Locación (copia)]&#13;&#10;when &apos;%Cobertura Órdenes&apos; then [Calculation_1849853563003846658]&#13;&#10;when &apos;%Cobertura Partners&apos; then [Calculation_1849853563005452295]&#13;&#10;when &apos;%Cofondeo&apos; then [Partners Plus orders (copia)_1820017211006922755]&#13;&#10;END' />
            </column>
            <column caption='% Cobertura Órdenes' datatype='real' default-format='p0.0%' name='[Calculation_1849853563003846658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COBERTURA_ORDENES])/SUM([TOTAL_ORDERS])' />
            </column>
            <column caption='% Cobertura Partners' datatype='real' default-format='p0.0%' name='[Calculation_1849853563005452295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COBERTURA_PARTNERS])/SUM([TOTAL_PARTNERS])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_2104025481222803457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Partner_Segment] WHEN IN(&quot;A&quot;, &quot;A1&quot;, &quot;A2&quot;,&quot;B&quot;,&quot;B1&quot;,&quot;B2&quot;,&quot;C&quot;,&quot;C1&quot;,&quot;C2&quot;,&quot;D&quot;,&quot;D1&quot;,&quot;D2&quot;,&quot;D3&quot;)&#13;&#10;THEN &quot;Long Tail&quot; ELSE [Partner_Segment] END' />
            </column>
            <column caption='Category Name' datatype='string' name='[Category_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Must Have' datatype='string' name='[Must_Have]' role='dimension' type='nominal' />
            <column datatype='string' name='[Oficina]' role='dimension' type='nominal' />
            <column caption='Pp Flag' datatype='string' name='[PP_FLAG]' role='dimension' type='nominal' />
            <column caption='Partner Segment' datatype='string' name='[Partner_Segment]' role='dimension' type='nominal' />
            <column caption='Share Partners Plus orders' datatype='real' default-format='p0%' name='[Partners Plus (copia)_1820017211006291970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE   [PP_FLAG] WHEN  &quot;Plus&quot; THEN [TOTAL_ORDERS] END)&#13;&#10;/SUM([TOTAL_ORDERS])' />
            </column>
            <column caption='Share Cofundable Orders' datatype='real' default-format='p0%' name='[Partners Plus orders (copia)_1820017211006922755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COFUNDED_ORDERS])&#13;&#10;/SUM([COFUNDABLE_ORDERS])' />
            </column>
            <column datatype='integer' name='[TOTAL_ORDERS]' role='measure' type='quantitative' />
            <column datatype='integer' name='[TOTAL_PARTNERS]' role='measure' type='quantitative' />
            <column caption='business vertical' datatype='string' name='[business_vertical]' role='dimension' type='nominal' />
            <column datatype='date' name='[mes]' role='dimension' type='ordinal' />
            <column-instance column='[mes]' derivation='MY' name='[my:mes:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Account_Owner]' derivation='None' name='[none:Account_Owner:nk]' pivot='key' type='nominal' />
            <column-instance column='[Area]' derivation='None' name='[none:Area:nk]' pivot='key' type='nominal' />
            <column-instance column='[Business]' derivation='None' name='[none:Business:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2104025481222803457]' derivation='None' name='[none:Calculation_2104025481222803457:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category_Name]' derivation='None' name='[none:Category_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Must_Have]' derivation='None' name='[none:Must_Have:nk]' pivot='key' type='nominal' />
            <column-instance column='[Oficina]' derivation='None' name='[none:Oficina:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_vertical]' derivation='None' name='[none:business_vertical:nk]' pivot='key' type='nominal' />
            <column-instance column='[COFUNDED_ORDERS]' derivation='Sum' name='[sum:COFUNDED_ORDERS:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1427359630011863048]' derivation='User' name='[usr:Calculation_1427359630011863048:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Partners Plus (copia)_1820017211006291970]' derivation='User' name='[usr:Partners Plus (copia)_1820017211006291970:qk]' pivot='key' type='quantitative' />
