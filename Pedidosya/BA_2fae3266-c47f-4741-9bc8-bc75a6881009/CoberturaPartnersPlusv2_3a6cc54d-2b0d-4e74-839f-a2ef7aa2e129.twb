            <column aggregation='Attribute' caption='Plus Orders' datatype='integer' name='[Total Franchise (copia)_1676746471540932609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [COBRO_FLAG] : SUM( [PLUS_ORDERS] ) }' />
