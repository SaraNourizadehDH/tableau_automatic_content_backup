            <column aggregation='Attribute' caption='Total Orders' datatype='integer' name='[Plus Orders (copia)_1317021453091164167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [COBRO_FLAG] : SUM( [TOTAL_ORDERS] ) }' />
