            <column datatype='integer' name='[PLUS_PARTNERS_FOOD_H]' role='measure' type='quantitative' />
            <column datatype='integer' name='[PLUS_PARTNERS_W_PS]' role='measure' type='quantitative' />
            <column caption='Partner Name' datatype='string' name='[Partner_Name]' role='dimension' type='nominal' />
            <column caption='Partner Segment' datatype='string' name='[Partner_Segment]' role='dimension' type='nominal' />
            <column datatype='integer' name='[TOTAL_ORDERS]' role='measure' type='quantitative' />
