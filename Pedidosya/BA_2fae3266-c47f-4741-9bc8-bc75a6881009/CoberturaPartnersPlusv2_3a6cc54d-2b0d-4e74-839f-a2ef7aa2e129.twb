    <worksheet name='Market KPIs Evol'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>Resumen</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Partners KPIs' name='federated.1m1hcqo1d5au9w1bo747e0vw9hbj' />
          </datasources>
          <datasource-dependencies datasource='federated.1m1hcqo1d5au9w1bo747e0vw9hbj'>
            <column caption='% Cobertura Partners Paying' datatype='real' default-format='p0.0%' name='[% Cobertura Partners FT (copia)_1849853563009028105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COBERTURA_PARTNERS_PAYING])/SUM([COBERTURA_PARTNERS])' />
            </column>
            <column caption='% Cobertura Órdenes Paying' datatype='real' default-format='p0.0%' name='[% Cobertura Órdenes Free Trial (copia)_1849853563004116996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COBERTURA_ORDENES_PAYING])/SUM([COBERTURA_ORDENES])' />
            </column>
            <column caption='% Orders Deals Penetration' datatype='real' default-format='p0.0%' name='[% Partners Deals Penetration (copia)_688206336212480006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PLUS_ORDERS_W_PS])/SUM([PLUS_ORDERS])' />
            </column>
            <column caption='Account Owner' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
            <column datatype='string' name='[Area]' role='dimension' type='nominal' />
            <column datatype='string' name='[Business]' role='dimension' type='nominal' />
            <column datatype='integer' name='[COBERTURA_ORDENES]' role='measure' type='quantitative' />
            <column datatype='integer' name='[COBERTURA_ORDENES_PAYING]' role='measure' type='quantitative' />
            <column datatype='integer' name='[COBERTURA_PARTNERS]' role='measure' type='quantitative' />
            <column datatype='integer' name='[COBERTURA_PARTNERS_PAYING]' role='measure' type='quantitative' />
            <column caption='Cobro Flag' datatype='string' name='[COBRO_FLAG]' role='dimension' type='nominal' />
            <column datatype='real' name='[COFUNDED_AMOUNT_EUR_LISTING_DF]' role='measure' type='quantitative' />
            <column caption='Orders Pagadoras' datatype='integer' name='[Calculation_1131529441954897920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [COBRO_FLAG] WHEN &quot;Pagando&quot; THEN [TOTAL_ORDERS] END' />
            </column>
            <column caption='% Cofondeo ordenes' datatype='real' name='[Calculation_1131529441955090433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([Calculation_1131529441954897920])/SUM([TOTAL_ORDERS]),0)' />
            </column>
            <column caption='YearMonth' datatype='string' name='[Calculation_1171780334191280160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(year([mes]))+&apos;-&apos;+str(month([mes]))' />
            </column>
            <column caption='Penetración Plus' datatype='real' default-format='p0.0%' name='[Calculation_1601029694330392578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PLUS_ORDERS])/SUM([TOTAL_ORDERS])' />
            </column>
            <column caption='Partners' datatype='string' name='[Calculation_1676746471634878466]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Franchise] WHEN &quot;-&quot; THEN [Partner_Name] ELSE [Franchise] END' />
            </column>
            <column caption='% Cobertura Órdenes' datatype='real' default-format='p0.0%' name='[Calculation_1849853563003846658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COBERTURA_ORDENES])/SUM([TOTAL_ORDERS])' />
            </column>
            <column caption='% Cobertura Partners' datatype='real' default-format='p0.0%' name='[Calculation_1849853563005452295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COBERTURA_PARTNERS])/SUM([TOTAL_PARTNERS])' />
            </column>
            <column caption='% Cobertura DF' datatype='real' default-format='p0.0%' name='[Calculation_1849853563009478666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(COFUNDED_AMOUNT_EUR_LISTING_DF) + AVG(EXTRA_MANUAL_BILLING_EUR))&#13;&#10;/&#13;&#10;SUM(DISCOUNT_AMOUNT_EUR_LISTING_DF)' />
            </column>
            <column caption='% Partners Deals Penetration' datatype='real' default-format='p0.0%' name='[Calculation_1849853563009875979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(PLUS_PARTNERS_W_PS)/SUM([PLUS_PARTNERS_FOOD_H])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_2104025481222803457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Partner_Segment] WHEN IN(&quot;A&quot;, &quot;A1&quot;, &quot;A2&quot;,&quot;B&quot;,&quot;B1&quot;,&quot;B2&quot;,&quot;C&quot;,&quot;C1&quot;,&quot;C2&quot;,&quot;D&quot;,&quot;D1&quot;,&quot;D2&quot;,&quot;D3&quot;)&#13;&#10;THEN &quot;Long Tail&quot; ELSE [Partner_Segment] END' />
            </column>
            <column caption='Category Name' datatype='string' name='[Category_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
