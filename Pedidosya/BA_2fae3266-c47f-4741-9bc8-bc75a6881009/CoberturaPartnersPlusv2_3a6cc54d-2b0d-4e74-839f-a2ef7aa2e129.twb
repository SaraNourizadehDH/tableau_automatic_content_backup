    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Diagnóstico por Mercado'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/DashPartners/DiagnsticoporMercado?rev=' id='DiagnsticoporMercado' path='/t/Pedidosya/workbooks/CoberturaPartnersPlusv2' revision='' site='Pedidosya' />
      <style />
      <size maxheight='1700' maxwidth='1100' minheight='1700' minwidth='1100' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Monthly Partners KPIs' name='federated.1m1hcqo1d5au9w1bo747e0vw9hbj' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Principales KPIs' datatype='string' name='[KPI Apertura Segmento (copia)_698620916358991872]' param-domain-type='list' role='measure' type='nominal' value='&quot;\%Cobertura Órdenes&quot;'>
          <calculation class='tableau' formula='&quot;%Cobertura Órdenes&quot;' />
          <members>
            <member value='&quot;\%Cofondeo&quot;' />
            <member value='&quot;\%Cobertura Partners&quot;' />
            <member value='&quot;\%Cobertura Órdenes&quot;' />
            <member value='&quot;\%Cobertura DF&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1m1hcqo1d5au9w1bo747e0vw9hbj'>
        <column caption='Account Owner' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
        <column datatype='string' name='[Area]' role='dimension' type='nominal' />
        <column datatype='string' name='[Business]' role='dimension' type='nominal' />
        <column caption='Cobro Flag' datatype='string' name='[COBRO_FLAG]' role='dimension' type='nominal' />
        <column caption='Segment' datatype='string' name='[Calculation_2104025481222803457]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE  [Partner_Segment] WHEN IN(&quot;A&quot;, &quot;A1&quot;, &quot;A2&quot;,&quot;B&quot;,&quot;B1&quot;,&quot;B2&quot;,&quot;C&quot;,&quot;C1&quot;,&quot;C2&quot;,&quot;D&quot;,&quot;D1&quot;,&quot;D2&quot;,&quot;D3&quot;)&#13;&#10;THEN &quot;Long Tail&quot; ELSE [Partner_Segment] END' />
        </column>
        <column caption='Category Name' datatype='string' name='[Category_Name]' role='dimension' type='nominal' />
        <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Must Have' datatype='string' name='[Must_Have]' role='dimension' type='nominal' />
        <column datatype='string' name='[Oficina]' role='dimension' type='nominal' />
        <column caption='business vertical' datatype='string' name='[business_vertical]' role='dimension' type='nominal' />
        <column datatype='date' name='[mes]' role='dimension' type='ordinal' />
        <column-instance column='[mes]' derivation='MY' name='[my:mes:ok]' pivot='key' type='ordinal' />
        <column-instance column='[Account_Owner]' derivation='None' name='[none:Account_Owner:nk]' pivot='key' type='nominal' />
        <column-instance column='[Area]' derivation='None' name='[none:Area:nk]' pivot='key' type='nominal' />
        <column-instance column='[Business]' derivation='None' name='[none:Business:nk]' pivot='key' type='nominal' />
        <column-instance column='[COBRO_FLAG]' derivation='None' name='[none:COBRO_FLAG:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_2104025481222803457]' derivation='None' name='[none:Calculation_2104025481222803457:nk]' pivot='key' type='nominal' />
        <column-instance column='[Category_Name]' derivation='None' name='[none:Category_Name:nk]' pivot='key' type='nominal' />
        <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
