    <worksheet name='Evolución Partners'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='14'> % Cobertura Partners Plus</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Partners KPIs' name='federated.1m1hcqo1d5au9w1bo747e0vw9hbj' />
          </datasources>
          <datasource-dependencies datasource='federated.1m1hcqo1d5au9w1bo747e0vw9hbj'>
            <column caption='Account Owner' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
            <column datatype='string' name='[Area]' role='dimension' type='nominal' />
            <column datatype='string' name='[Business]' role='dimension' type='nominal' />
            <column caption='Segment' datatype='string' name='[Calculation_2104025481222803457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Partner_Segment] WHEN IN(&quot;A&quot;, &quot;A1&quot;, &quot;A2&quot;,&quot;B&quot;,&quot;B1&quot;,&quot;B2&quot;,&quot;C&quot;,&quot;C1&quot;,&quot;C2&quot;,&quot;D&quot;,&quot;D1&quot;,&quot;D2&quot;,&quot;D3&quot;)&#13;&#10;THEN &quot;Long Tail&quot; ELSE [Partner_Segment] END' />
            </column>
            <column caption='Total Partners' datatype='integer' name='[Calculation_356065862774038529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Partner_Id])' />
            </column>
            <column caption='Category Name' datatype='string' name='[Category_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Must Have' datatype='string' name='[Must_Have]' role='dimension' type='nominal' />
            <column datatype='string' name='[Oficina]' role='dimension' type='nominal' />
            <column datatype='string' name='[Online]' role='dimension' type='nominal' />
            <column datatype='string' name='[PP_FLAG_HISTORICO]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Partner Id' datatype='integer' name='[Partner_Id]' role='dimension' type='ordinal' />
            <column caption='Partner Segment' datatype='string' name='[Partner_Segment]' role='dimension' type='nominal' />
            <column caption='Share Partners Plus Hist' datatype='real' default-format='p0%' name='[Share Partners Plus (copia)_356065862780002308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE   [PP_FLAG_HISTORICO] WHEN  &quot;Plus H&quot; THEN [Partner_Id] END)&#13;&#10;/COUNTD([Partner_Id])' />
            </column>
            <column caption='Partners Plus H' datatype='integer' name='[Total Partners (copia)_356065862774169602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [PP_FLAG_HISTORICO] WHEN &quot;Plus H&quot; THEN [Partner_Id] END)' />
            </column>
            <column caption='business vertical' datatype='string' name='[business_vertical]' role='dimension' type='nominal' />
            <column datatype='date' name='[mes]' role='dimension' type='ordinal' />
            <column-instance column='[mes]' derivation='MY' name='[my:mes:ok]' pivot='key' type='ordinal' />
