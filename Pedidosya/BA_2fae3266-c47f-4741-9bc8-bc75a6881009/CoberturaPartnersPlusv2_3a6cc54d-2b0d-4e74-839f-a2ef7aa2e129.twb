          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1m1hcqo1d5au9w1bo747e0vw9hbj].[mes]' caption='month Parámetro' datatype='date' default-format='*MMM-YY' name='[month Parámetro]' param-domain-type='list' role='measure' type='quantitative' value='#2024-05-01#'>
              <calculation class='tableau' formula='#2024-05-01#' />
