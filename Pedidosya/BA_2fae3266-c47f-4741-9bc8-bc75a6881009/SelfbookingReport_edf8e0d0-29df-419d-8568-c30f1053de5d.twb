      <column caption='Account Source' datatype='string' name='[AccountSource]' role='dimension' type='nominal' />
      <column caption='Bookings campañas Autogestionadas Vendor Portal' datatype='integer' name='[Bookings campañas Autogestionadas ACC (copia)_1476617754391584777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [origen] = &quot;Vendor Portal&quot; then [partner_id (vfd_selfbooking_dashboard_acc_vp)] else null end' />
      </column>
      <column caption='denominador_selfbooking' datatype='integer' name='[Calculation_1259037589853356032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Parameters].[Parámetro 1] THEN&#13;&#10;        IF [partner_deal] THEN [partner_id] END&#13;&#10;    ELSE&#13;&#10;       [partner_id] END&#13;&#10;    &#13;&#10;)' />
      </column>
      <column caption='is_managed_partner' datatype='integer' name='[Calculation_1259037589854711809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (&#13;&#10;  [is_self_managed_partner] = True&#13;&#10;) THEN&#13;&#10;    [partner_id]&#13;&#10;ELSE&#13;&#10;       NULL&#13;&#10;END' />
      </column>
      <column caption='% Partners Selfbooking' datatype='real' name='[Calculation_1259037589855674370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Calculation_1259037589854711809])/([Calculation_1259037589853356032])' />
      </column>
      <column caption='vfd_self_managed' datatype='real' name='[Calculation_1259037589862645763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_self_managed_partner] = true then [vfd_total] else null end' />
      </column>
      <column caption='VFD Campañas Autogestionadas' datatype='real' name='[Calculation_1476336279014993920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [origen] = &quot;ACC&quot; or [origen]  = &quot;Vendor Portal&quot; then [vfd_campanias_autogestion] else null end' />
      </column>
      <column caption='Conteo &quot;Joined&quot; ' datatype='integer' name='[Calculation_1476336279025012738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [partner_status] = &quot;JOINED&quot; THEN [partner_id (Consulta SQL personalizada)] ELSE NULL END' />
      </column>
      <column caption='Ordenes Partners Autogestionados' datatype='integer' name='[Calculation_1562749092909383680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_self_managed_partner] then [vfd_total_orders] else null end' />
      </column>
      <column caption='Joined + Targeted Product_Id' datatype='integer' name='[Calculation_1562749092964888579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([joined_product_id]) + countd([targeted_product_id])' />
      </column>
      <column caption='% Joined Product_id' datatype='real' name='[Calculation_1562749092965474308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([joined_product_id])/[Calculation_1562749092964888579]' />
      </column>
      <column caption='Campañas Tipo Deal Migración' datatype='integer' name='[Calculation_262616172996988928]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(IF [tipo (migracion_deal)] = &quot;DEAL&quot; THEN [campaign_id (migracion_deal)] ELSE NULL END)' />
      </column>
      <column caption='Total Campañas Migración' datatype='integer' name='[Calculation_262616172997492739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_262616172996988928]) + ([Campañas Tipo Deal Migración (copia)_262616172997234689]) + ([Campañas Tipo SUBSIDIZED ACTIVA Migración (copia)_262616172997390338])' />
      </column>
      <column caption='% Campañas Tipo Deal Migración' datatype='real' name='[Calculation_262616172997672964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_262616172996988928])/[Calculation_262616172997492739]' />
      </column>
      <column caption='Ordenes totales migración a deal' datatype='integer' name='[Calculation_262616173026021391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Campañas Tipo Deal Migración (copia)_262616173025628172])+sum([Campañas Tipo SUBSIDIZED ACTIVA Migración (copia)_262616173025787917])+sum([Campañas Tipo SUBSIDIZED VENCIDA Migración (copia)_262616173025886222])' />
      </column>
      <column caption='% Ordenes Tipo Deal Migracion' datatype='real' name='[Calculation_262616173026148368]' role='measure' type='quantitative'>
