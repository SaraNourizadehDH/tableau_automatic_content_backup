                <zone forceUpdate='true' h='5467' id='44' type-v2='text' w='87300' x='11900' y='533'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='14'>Selfbooking Report</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='26'>Listado de Partners por Campaña</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#fa0050' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7133' id='26' type-v2='text' w='98400' x='800' y='10467'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='6'>Detalle del estado de participación de los partners en cada campaña</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='6'>TARGETED</run>
                    <run fontcolor='#1d1c1d' fontsize='6'>: partner fue invitado a la campaña pero que todavia no se unió a la misma.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='6'>JOINED</run>
                    <run fontcolor='#1d1c1d' fontsize='6'>: partner se unió a la campaña con al menos un producto.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='6'>UNJOINED</run>
                    <run fontcolor='#1d1c1d' fontsize='6'>: partner se unió pero se bajó de la campaña.

</run>
                    <run fontcolor='#000000' fontsize='6'>Se detalla el estado de los productos respecto a cada campaña, diferenciando entre aquellos que fueron invitados a participar y los que ya están activos dentro de la misma.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='6'>Targeted Product ID:</run>
                    <run fontcolor='#1d1c1d' fontsize='6'> Producto al que se invitó a participar de la campaña, pero por el momento no fue incluida en la misma.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='6'>Joined  Product ID: </run>
                    <run fontcolor='#1d1c1d' fontsize='6'>Producto incluido en la campaña.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
