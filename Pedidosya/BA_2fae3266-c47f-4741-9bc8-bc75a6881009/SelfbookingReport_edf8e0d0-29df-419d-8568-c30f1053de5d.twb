      <column caption='Migracion Subsidized Campaing' datatype='integer' name='[Calculation_534521001290211328]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(if [tipo (migracion_deal)] = &quot;SUBSIDIZED VENCIDA&quot; OR [tipo (migracion_deal)] = &quot;SUBSIDIZED ACTIVA&quot; THEN [campaign_id (migracion_deal)] ELSE NULL END)' />
