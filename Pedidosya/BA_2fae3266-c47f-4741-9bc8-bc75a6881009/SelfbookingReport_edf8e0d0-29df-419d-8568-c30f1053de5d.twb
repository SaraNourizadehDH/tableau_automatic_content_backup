              <calculation class='tableau' formula='COUNTD(IF [tipo (migracion_deal)] = &quot;SUBSIDIZED ACTIVA&quot; THEN [campaign_id (migracion_deal)] ELSE NULL END)' />
            </column>
            <column caption='Ordenes Tipo Deal Migración' datatype='integer' name='[Campañas Tipo Deal Migración (copia)_262616173025628172]' role='dimension' type='ordinal'>
