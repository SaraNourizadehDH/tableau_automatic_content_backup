        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1ywokei0560f7215wk5qd0hmdqdw' name='Consulta SQL personalizada' type='text'>WITH acq_table AS (&#13;
    SELECT uf.user AS user,&#13;
           uf.month AS month,&#13;
           uf.country_id AS country_id,&#13;
           uf.healthy_high_chance AS healthy_high_chance,&#13;
           uf.incentived AS incentived,&#13;
           uf.country AS country&#13;
    FROM `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf&#13;
    WHERE uf.acq_month)&#13;
SELECT acq.month AS Acq_Month,&#13;
       CONCAT(&apos;M&apos;,DATE_DIFF(uf.month,acq.month,MONTH)) AS Cohort,&#13;
       acq.country AS Country,&#13;
       CASE WHEN acq.healthy_high_chance THEN &apos;Si&apos; ELSE &apos;No&apos; END AS Healthy_High_Chance,&#13;
       CASE WHEN acq.incentived THEN &apos;Si&apos; ELSE &apos;No&apos; END AS Incentived,&#13;
       CASE WHEN acq.incentived = FALSE OR acq.healthy_high_chance THEN &apos;Si&apos; ELSE &apos;No&apos; END AS Desirable, &#13;
       COUNT(DISTINCT CASE WHEN uf.active_users &gt;&gt; 0 THEN uf.user ELSE NULL END) AS Acq,&#13;
       SUM(uf.orders_tm) AS Orders,&#13;
       SUM(uf.gmv) AS GMV,&#13;
       SUM(uf.total_revenue) AS Revenue,&#13;
       SUM(uf.peya_discounts) AS Peya_Disc,&#13;
       SUM(uf.total_amount) AS Total_Amount,&#13;
       SUM(uf.basket_incentives) AS Basket_Incentives,&#13;
       SUM(uf.cpo) AS Cpo_Rider,&#13;
       SUM(uf.extra_cpo) AS Extra_CPO,&#13;
       COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.funnel = &apos;Onboarded&apos; THEN uf.user ELSE NULL END) AS Onboarded,&#13;
       COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.funnel = &apos;Onboarded&apos; AND uf.healthy = &apos;Healthy&apos; THEN uf.user ELSE NULL END) AS Onboarded_Healthy,&#13;
       CURRENT_DATE() AS Actual_Date&#13;
FROM acq_table AS acq&#13;
LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf ON acq.user = uf.user AND acq.country_id = uf.country_id AND uf.month &gt;&gt;= acq.month&#13;
GROUP BY 1,2,3,4,5,6&#13;
ORDER BY 1,2,3,4,5,6</relation>
          <relation connection='google-sheets.1y0on4900tichg12bv7oh1n5hapm' name='Madurez' table='[Madurez$]' type='table'>
