    <worksheet name='Onb_General_FLGPO'>
      <table>
        <view>
          <datasources>
            <datasource caption='Business' name='federated.0e49czv1gz5io012q9goc0rsytbs' />
          </datasources>
          <datasource-dependencies datasource='federated.0e49czv1gz5io012q9goc0rsytbs'>
            <column caption='% Unpr. Orders Healthy' datatype='real' default-format='p0.00%' name='[% Unprofitable Orders (copia 2)_434315946907123736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM_Onb_Healthy]) &gt; 0 &#13;&#10;THEN SUM([Orders_Onb_Unp_Healthy]) / SUM([Orders_TM_Onb_Healthy])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='% Unpr. Orders Unhealthy' datatype='real' default-format='p0.00%' name='[% Unprofitable Orders (copia)_434315946907115543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM_Onb_Unhealthy]) &gt; 0 &#13;&#10;THEN SUM([Orders_Onb_Unp_Unhealthy]) / SUM([Orders_TM_Onb_Unhealthy])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Comm Revenue per Order' datatype='real' default-format='C3082%' name='[AOV (copia)_1349672571119185940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM]) &gt; 0&#13;&#10;THEN SUM([Commission_Revenue]) / SUM([Orders_TM])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='real' name='[BI]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[BI_Onb]' role='measure' type='quantitative' />
            <column datatype='real' name='[BI_Onb_Healthy]' role='measure' type='quantitative' />
            <column datatype='real' name='[BI_Onb_Unhealthy]' role='measure' type='quantitative' />
            <column datatype='real' name='[CPO_Rider]' role='measure' type='quantitative' />
            <column datatype='real' name='[CPO_Rider_Onb]' role='measure' type='quantitative' />
            <column datatype='real' name='[CPO_Rider_Onb_Healthy]' role='measure' type='quantitative' />
            <column datatype='real' name='[CPO_Rider_Onb_Unhealthy]' role='measure' type='quantitative' />
            <column caption='Basket Incentives' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_1349672571121651737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([BI])*-1' />
            </column>
            <column caption='Basket Incentives per Order' datatype='real' default-format='C3082%' name='[Calculation_1349672571121971226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM]) &gt; 0&#13;&#10;THEN [Calculation_1349672571121651737] / SUM([Orders_TM])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Net Revenue per Order' datatype='real' default-format='C1027%' name='[Calculation_1349672571122602012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AOV (copia)_1349672571119185940] + [Comm Revenue per Order (copia)_1349672571120955414] + [Calculation_1349672571121971226]' />
            </column>
            <column caption='Rider CPO' datatype='real' default-format='C3082%' name='[Calculation_1349672571124002846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM]) &gt; 0&#13;&#10;THEN SUM([CPO_Rider]) / SUM([Orders_TM]) *-1&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Other CPO' datatype='real' default-format='C3082%' name='[Calculation_1349672571124408352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1349672571124002846] / [Calculation_434315946906071061] - [Calculation_1349672571124002846])' />
            </column>
            <column caption='FLGPO' datatype='real' default-format='C3082%' name='[Calculation_1349672571125592098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1349672571122602012] + [Calculation_1349672571124002846] + [Calculation_1349672571124408352]' />
            </column>
            <column caption='%Rider_Total' datatype='real' name='[Calculation_434315946906071061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.72' />
            </column>
            <column caption='% Unpr. Orders' datatype='real' default-format='p0.00%' name='[Calculation_434315946906902550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM_Onb]) &gt; 0 &#13;&#10;THEN SUM([Orders_Onb_Unp]) / SUM([Orders_TM_Onb])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Onb FLGPO' datatype='real' default-format='C3082%' name='[Calculation_434315946907869209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM_Onb]) &gt; 0&#13;&#10;THEN (SUM([Total_Revenue_Onb]) - SUM([BI_Onb]) - SUM([CPO_Rider_Onb]) / [Calculation_434315946906071061]) / SUM([Orders_TM_Onb])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Delivery Fee per Order' datatype='real' default-format='C3082%' name='[Comm Revenue per Order (copia)_1349672571120955414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM]) &gt; 0&#13;&#10;THEN SUM([DF_Revenue]) / SUM([Orders_TM])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='real' name='[Commission_Revenue]' role='measure' type='quantitative' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[DF_Revenue]' role='measure' type='quantitative' />
            <column datatype='date' datatype-customized='true' default-format='*d/m/yyyy' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Onb FLGPO Unhealthy' datatype='real' default-format='C3082%' name='[Onb FLGPO (copia) (copia)_434315946909122587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM_Onb_Unhealthy]) &gt; 0&#13;&#10;THEN (SUM([Total_Revenue_Onb_Unhealthy]) - SUM([BI_Onb_Unhealthy]) - SUM([CPO_Rider_Onb_Unhealthy]) / [Calculation_434315946906071061]) / SUM([Orders_TM_Onb_Unhealthy])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Onb FLGPO Healthy' datatype='real' default-format='C3082%' name='[Onb FLGPO (copia)_434315946909118490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_TM_Onb_Healthy]) &gt; 0&#13;&#10;THEN (SUM([Total_Revenue_Onb_Healthy]) - SUM([BI_Onb_Healthy]) - SUM([CPO_Rider_Onb_Healthy]) / [Calculation_434315946906071061]) / SUM([Orders_TM_Onb_Healthy])&#13;&#10;ELSE 0 END' />
            </column>
