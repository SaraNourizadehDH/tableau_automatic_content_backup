    <worksheet name='Cohorts'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lifecycle' name='federated.0uf0rs31231fub11xr7p31b3q2z7' />
          </datasources>
          <datasource-dependencies datasource='federated.0uf0rs31231fub11xr7p31b3q2z7'>
            <column caption='% Healthy over Total' datatype='real' default-format='p0.00%' name='[% Onboarded over Total (copia)_434315946965745761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_434315946964619359] &gt; 0&#13;&#10;THEN SUM([Onboarded_Healthy]) / [Calculation_434315946964619359]&#13;&#10;ELSE 0 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AOV Gross' datatype='real' default-format='C3082%' name='[AOV (copia)_434315946944544839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders]) &gt; 0 &#13;&#10;THEN [Calculation_434315946944413766] / SUM([Orders])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='integer' name='[Acq]' role='measure' type='quantitative' />
            <column datatype='date' name='[Acq_Month]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Basket_Incentives]' role='measure' type='quantitative' />
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_434315946930774073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Acq]) &gt; 0&#13;&#10;THEN SUM([Orders]) / SUM([Acq])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='% Healthy over Onboarded' datatype='real' default-format='p0.00%' name='[Calculation_434315946943275076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Onboarded]) &gt; 0&#13;&#10;THEN SUM([Onboarded_Healthy]) / SUM([Onboarded])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='AOV' datatype='real' default-format='C3082%' name='[Calculation_434315946944188485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders]) &gt; 0 &#13;&#10;THEN SUM([GMV]) / SUM([Orders])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='GMV Gross' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_434315946944413766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV]) + SUM([Peya_Disc])' />
            </column>
            <column caption='ADR PEYA' datatype='real' default-format='p0.00%' name='[Calculation_434315946945278024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Total_Amount]) &gt; 0&#13;&#10;THEN SUM([Basket_Incentives]) / SUM([Total_Amount])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Fully Loaded GP' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_434315946945466441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Revenue]) - SUM([Basket_Incentives]) - SUM([Cpo_Rider]) - SUM([Extra_CPO])' />
            </column>
            <column caption='Net Revenue per Order' datatype='real' default-format='C3082%' name='[Calculation_434315946946265163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders]) &gt; 0&#13;&#10;THEN [Fully Loaded GP (copia)_434315946945884234] / SUM([Orders])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Acq_M0' datatype='integer' name='[Calculation_434315946964619359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(SUM([Acq]),FIRST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Onboarded over Total' datatype='real' default-format='p0.00%' name='[Calculation_434315946965209184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_434315946964619359] &gt; 0&#13;&#10;THEN SUM([Onboarded]) / [Calculation_434315946964619359]&#13;&#10;ELSE 0 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Cohort]' role='dimension' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Cpo_Rider]' role='measure' type='quantitative' />
            <column datatype='string' name='[Desirable]' role='dimension' type='nominal' />
            <column datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Extra_CPO]' role='measure' type='quantitative' />
            <column caption='Net Revenue' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Fully Loaded GP (copia)_434315946945884234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Revenue]) - SUM([Basket_Incentives])' />
            </column>
            <column datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[GMV]' role='measure' type='quantitative' />
            <column datatype='string' name='[Healthy_High_Chance]' role='dimension' type='nominal' />
            <column datatype='string' name='[Incentived]' role='dimension' type='nominal' />
            <column caption='Madurez (Madurez)' datatype='string' name='[Madurez]' role='dimension' type='nominal' />
            <column caption='FLGP per Order' datatype='real' default-format='C3082%' name='[Net Revenue per Order (copia)_434315946946457676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders]) &gt; 0&#13;&#10;THEN [Calculation_434315946945466441] / SUM([Orders])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='integer' name='[Onboarded]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Onboarded_Healthy]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Orders]' role='measure' type='quantitative' />
