    <worksheet name='SR_M0'>
      <table>
        <view>
          <datasources>
            <datasource caption='Business' name='federated.0e49czv1gz5io012q9goc0rsytbs' />
          </datasources>
          <datasource-dependencies datasource='federated.0e49czv1gz5io012q9goc0rsytbs'>
            <column datatype='integer' name='[Acq]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Acq_BI]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Acq_Desirable]' role='measure' type='quantitative' />
            <column datatype='real' name='[BI_M0]' role='measure' type='quantitative' />
            <column caption='% Desirable' datatype='real' default-format='p0.00%' name='[Calculation_1349672571040948227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Acq]) &gt; 0&#13;&#10;THEN SUM([Acq_Desirable]) / SUM([Acq])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Frequency M0' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1349672571139387429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Acq]) &gt; 0&#13;&#10;THEN SUM([Orders_M0]) / SUM([Acq])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='AOV Gross M0' datatype='real' default-format='C3082%' name='[Calculation_1349672571139837990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_M0]) &gt; 0&#13;&#10;THEN SUM([GMV_Gross_M0]) / SUM([Orders_M0])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='ADR M0' datatype='real' default-format='p0.00%' name='[Calculation_1349672571140210727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Total_Amount_M0]) &gt; 0&#13;&#10;THEN SUM([BI_M0]) / SUM([Total_Amount_M0])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Accumulated FLGPU M0' datatype='real' default-format='C3082%' name='[Calculation_1349672571140759592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Acq]) &gt; 0&#13;&#10;THEN SUM([FLGP_M0]) / SUM([Acq])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[FLGP_M0]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV_Gross_M0]' role='measure' type='quantitative' />
