          <datasource-dependencies datasource='federated.0e49czv1gz5io012q9goc0rsytbs'>
            <column caption='% Onboarded' datatype='real' default-format='p0.00%' name='[% New (copia)_1349672571117264912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Active]) &gt; 0&#13;&#10;THEN SUM([Active_Onb]) / SUM([Active])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='% Healthy Sobre Total Onboarded' datatype='real' default-format='p0.00%' name='[% Onboarded (copia)_1349672571117559825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Active_Onb]) &gt; 0&#13;&#10;THEN SUM([Active_Onb_Healthy]) / SUM([Active_Onb])&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='integer' name='[Active]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Active_New]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Active_Onb]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Active_Onb_Healthy]' role='measure' type='quantitative' />
            <column caption='% New' datatype='real' default-format='p0.00%' name='[Calculation_1349672571116908559]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Active]) &gt; 0&#13;&#10;THEN SUM([Active_New]) / SUM([Active])&#13;&#10;ELSE 0 END' />
