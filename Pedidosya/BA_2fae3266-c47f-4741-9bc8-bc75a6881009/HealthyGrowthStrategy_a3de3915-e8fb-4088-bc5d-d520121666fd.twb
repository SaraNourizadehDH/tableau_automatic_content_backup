          <datasource-dependencies datasource='federated.0e49czv1gz5io012q9goc0rsytbs'>
            <column caption='% Heavy Healthy' datatype='real' default-format='p0.00%' name='[% Low Inter Healthy (copia)_434315946911031328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Active_Onb_Heavy]) &gt; 0&#13;&#10;THEN SUM([Active_Onb_Heavy_Healthy]) / SUM([Active_Onb_Heavy])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='% Heavy of Onboarded' datatype='real' default-format='p0.00%' name='[% Low Inter of Onboarded (copia) (copia)_434315946910486558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Active_Onb]) &gt; 0&#13;&#10;THEN SUM([Active_Onb_Heavy]) / SUM([Active_Onb])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='% No Return Heavy' datatype='real' default-format='p0.00%' name='[% No Return Low Inter (copia) (copia)_434315946912669738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Active_No_Acq_LM_Onb_Heavy]) &gt; 0&#13;&#10;THEN SUM([No_Return_Onb_Heavy]) / SUM([Active_No_Acq_LM_Onb_Heavy])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='% Unpr. Orders Stable' datatype='real' default-format='p0.00%' name='[% Unpr. Orders Low Inter (copia) (copia)_434315946913570864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_Onb_Stable]) &gt; 0&#13;&#10;THEN SUM([Orders_Onb_Unp_Stable]) / SUM([Orders_Onb_Stable])&#13;&#10;ELSE 0 END' />
            </column>
