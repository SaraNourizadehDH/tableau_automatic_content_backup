  <datasources>
    <datasource caption='Business' inline='true' name='federated.0e49czv1gz5io012q9goc0rsytbs' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Business' name='bigquery.0vq19ks09uosto1h4dscg1ha2uoi'>
            <connection CATALOG='peya-argentina' EXECCATALOG='peya-argentina' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-argentina' schema='user_santiago_curat' server-oauth='' username='santiago.curat@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vq19ks09uosto1h4dscg1ha2uoi' name='Consulta SQL personalizada' type='text'><![CDATA[WITH cohorts_table AS (
    SELECT uf.country AS Country,
           uf.month AS Month,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 1 THEN ufn.orders_tm ELSE 0 END) AS Orders_M1,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 3 THEN ufn.orders_tm ELSE 0 END) AS Orders_M3,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 6 THEN ufn.orders_tm ELSE 0 END) AS Orders_M6,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 1 THEN ufn.total_revenue - ufn.basket_incentives - ufn.cpo - ufn.extra_cpo ELSE 0 END) AS FLGP_M1,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 3 THEN ufn.total_revenue - ufn.basket_incentives - ufn.cpo - ufn.extra_cpo ELSE 0 END) AS FLGP_M3,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 6 THEN ufn.total_revenue - ufn.basket_incentives - ufn.cpo - ufn.extra_cpo ELSE 0 END) AS FLGP_M6
    FROM `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS ufn ON uf.user = ufn.user
                                                                                 AND uf.country_id = ufn.country_id
                                                                                 AND uf.month <<= ufn.month
    WHERE uf.acq_month
    GROUP BY 1,2),
    general_table AS (
    SELECT uf.country AS Country,
           uf.month AS Month,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 THEN uf.user ELSE NULL END) AS Active,
           COUNT(DISTINCT CASE WHEN ufs.active_users >> 0 THEN ufs.user ELSE NULL END) AS Active_LM,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users >> 0 THEN uf.user ELSE NULL END) AS Active_No_Acq,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE THEN uf.user ELSE NULL END) AS No_Return,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users >> 0 AND IFNULL(ufs.active_users,0) = 0 THEN uf.user ELSE NULL END) AS React,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users >> 0 AND IFNULL(ufs.active_users,0) = 0 AND uf.healthy = 'Healthy' THEN uf.user ELSE NULL END) AS Healthy_React,
           COUNT(DISTINCT CASE WHEN uf.acq_month THEN uf.user ELSE NULL END) AS Acq,
           COUNT(DISTINCT CASE WHEN ufs.acq_month THEN ufs.user ELSE NULL END) AS Acq_LM,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf.incentived = FALSE THEN uf.user ELSE NULL END) AS Acq_No_Voucher,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf1.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M1,
           COUNT(DISTINCT CASE WHEN ufs.acq_month AND uf.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M1_LM,
           COUNT(DISTINCT CASE WHEN ufs.acq_month AND uf.active_users = 0 THEN uf.user ELSE NULL END) AS Acq_M1_No_Return_LM,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND (uf.funnel = 'New' OR uf.acq_month) THEN uf.user ELSE NULL END) AS Active_New,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.user ELSE NULL END) AS Active_Onb_Healthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.user ELSE NULL END) AS Active_Onb_Unhealthy,
           SUM(uf.orders_tm) AS Orders_TM,
           SUM(uf.orders_log_tm) AS Orders_Log_TM,
           SUM(uf.gmv) AS GMV,
           SUM(uf.total_revenue) AS Total_Revenue,
           SUM(uf.commission_revenue) AS Commission_Revenue,
           SUM(uf.df_revenue) AS DF_Revenue,
           SUM(uf.cpo) AS CPO_Rider,
           SUM(uf.basket_incentives) AS BI,
           SUM(uf.acq_basket_incentives) AS Acq_BI,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.basket_incentives ELSE 0 END) AS BI_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'ADR' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_ADR,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Percentile' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_AOV,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Both' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Both,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.healthy = 'ADR' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb_ADR,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.healthy = 'Percentile' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb_AOV,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.healthy = 'Both' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb_Both,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.orders_tm ELSE 0 END) AS Orders_TM_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.healthy = 'Healthy' AND uf.acq_month = FALSE THEN uf.orders_tm ELSE 0 END) AS Orders_TM_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.healthy != 'Healthy' AND uf.acq_month = FALSE THEN uf.orders_tm ELSE 0 END) AS Orders_TM_Onb_Unhealthy,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND uf.healthy = 'Healthy' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Healthy,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND uf.healthy != 'Healthy' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Unhealthy,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' THEN uf.user ELSE NULL END) AS No_Return_Onb,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.healthy = 'Healthy' AND ufs.funnel = 'Onboarded' THEN uf.user ELSE NULL END) AS No_Return_Onb_Healthy,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.healthy != 'Healthy' AND ufs.funnel = 'Onboarded' THEN uf.user ELSE NULL END) AS No_Return_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.gmv ELSE 0 END) AS GMV_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Unhealthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.user ELSE NULL END) AS Active_Onb_Over,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.user ELSE NULL END) AS Active_Onb_Stable,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.user ELSE NULL END) AS Active_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.user ELSE NULL END) AS Active_Onb_Over_Healthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' AND uf.intermittency_type = '30D' THEN uf.user ELSE NULL END) AS Active_Onb_Stable_Healthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' AND uf.intermittency_type = '6D' THEN uf.user ELSE NULL END) AS Active_Onb_Heavy_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.orders_tm ELSE 0 END) AS Orders_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.orders_tm ELSE 0 END) AS Orders_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.orders_tm ELSE 0 END) AS Orders_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type IN ('Over 30D','No Calculable') THEN uf.user ELSE NULL END) AS No_Return_Onb_Over,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '30D' THEN uf.user ELSE NULL END) AS No_Return_Onb_Stable,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '6D' THEN uf.user ELSE NULL END) AS No_Return_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type IN ('Over 30D','No Calculable') THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Over,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '30D' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Stable,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '6D' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.gmv ELSE 0 END) AS GMV_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_Active_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf3.healthy = 'Healthy' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_Healthy_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf3.healthy = 'Healthy' AND uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_Healthy_M3,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_Active_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf6.healthy = 'Healthy' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_Healthy_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf6.healthy = 'Healthy' AND uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_Healthy_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.total_revenue - uf.basket_incentives - uf.cpo - uf.extra_cpo ELSE 0 END) AS FLGP_M0,
           SUM(CASE WHEN uf.acq_month THEN uf.orders_tm ELSE 0 END) AS Orders_M0,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Heavy,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf.desirable THEN uf.user ELSE NULL END) AS Acq_Desirable,
           SUM(CASE WHEN uf.acq_month THEN uf1.orders_tm ELSE 0 END) AS Orders_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.orders_tm ELSE 0 END) AS Orders_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.orders_tm ELSE 0 END) AS Orders_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_M0,
           SUM(CASE WHEN uf.acq_month THEN uf1.gmv + uf1.peya_discounts ELSE 0 END) AS GMV_Gross_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.gmv + uf3.peya_discounts ELSE 0 END) AS GMV_Gross_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.gmv + uf6.peya_discounts ELSE 0 END) AS GMV_Gross_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.basket_incentives ELSE 0 END) AS BI_M0,
           SUM(CASE WHEN uf.acq_month THEN uf1.basket_incentives ELSE 0 END) AS BI_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.basket_incentives ELSE 0 END) AS BI_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.basket_incentives ELSE 0 END) AS BI_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.total_amount ELSE 0 END) AS Total_Amount_M0,
           SUM(CASE WHEN uf.acq_month THEN uf1.total_amount ELSE 0 END) AS Total_Amount_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.total_amount ELSE 0 END) AS Total_Amount_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.total_amount ELSE 0 END) AS Total_Amount_M6,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M3,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M6,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_M1,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf.acq_month AND uf1.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_M1,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf1.healthy = 'Healthy' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_Healthy_M1,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf1.healthy = 'Healthy' AND uf.acq_month AND uf1.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_Healthy_M1,
           CURRENT_DATE() AS Actual_Date
    FROM `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS ufs ON uf.user = ufs.user
                                                                                 AND uf.country_id = ufs.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(ufs.month,INTERVAL 1 MONTH))
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf1 ON uf.user = uf1.user
                                                                                 AND uf.country_id = uf1.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(uf1.month,INTERVAL -1 MONTH))
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf3 ON uf.user = uf3.user
                                                                                 AND uf.country_id = uf3.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(uf3.month,INTERVAL -3 MONTH))
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf6 ON uf.user = uf6.user
                                                                                 AND uf.country_id = uf6.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(uf6.month,INTERVAL -6 MONTH))
    GROUP BY 1,2
    ORDER BY 1,2)
SELECT gt.*,
       IFNULL(ct.orders_m1,0) AS Acum_Orders_M1,
       IFNULL(ct.flgp_m1,0) AS Acum_FLGP_M1,
       IFNULL(ct.orders_m3,0) AS Acum_Orders_M3,
       IFNULL(ct.flgp_m3,0) AS Acum_FLGP_M3,
       IFNULL(ct.orders_m6,0) AS Acum_Orders_M6,
       IFNULL(ct.flgp_m6,0) AS Acum_FLGP_M6
FROM general_table AS gt
LEFT JOIN cohorts_table AS ct ON gt.country = ct.country
                                 AND gt.month = ct.month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0vq19ks09uosto1h4dscg1ha2uoi' name='Consulta SQL personalizada' type='text'><![CDATA[WITH cohorts_table AS (
    SELECT uf.country AS Country,
           uf.month AS Month,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 1 THEN ufn.orders_tm ELSE 0 END) AS Orders_M1,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 3 THEN ufn.orders_tm ELSE 0 END) AS Orders_M3,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 6 THEN ufn.orders_tm ELSE 0 END) AS Orders_M6,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 1 THEN ufn.total_revenue - ufn.basket_incentives - ufn.cpo - ufn.extra_cpo ELSE 0 END) AS FLGP_M1,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 3 THEN ufn.total_revenue - ufn.basket_incentives - ufn.cpo - ufn.extra_cpo ELSE 0 END) AS FLGP_M3,
           SUM(CASE WHEN DATE_DIFF(ufn.month,uf.month,MONTH) <<= 6 THEN ufn.total_revenue - ufn.basket_incentives - ufn.cpo - ufn.extra_cpo ELSE 0 END) AS FLGP_M6
    FROM `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS ufn ON uf.user = ufn.user
                                                                                 AND uf.country_id = ufn.country_id
                                                                                 AND uf.month <<= ufn.month
    WHERE uf.acq_month
    GROUP BY 1,2),
    general_table AS (
    SELECT uf.country AS Country,
           uf.month AS Month,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 THEN uf.user ELSE NULL END) AS Active,
           COUNT(DISTINCT CASE WHEN ufs.active_users >> 0 THEN ufs.user ELSE NULL END) AS Active_LM,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users >> 0 THEN uf.user ELSE NULL END) AS Active_No_Acq,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE THEN uf.user ELSE NULL END) AS No_Return,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users >> 0 AND IFNULL(ufs.active_users,0) = 0 THEN uf.user ELSE NULL END) AS React,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users >> 0 AND IFNULL(ufs.active_users,0) = 0 AND uf.healthy = 'Healthy' THEN uf.user ELSE NULL END) AS Healthy_React,
           COUNT(DISTINCT CASE WHEN uf.acq_month THEN uf.user ELSE NULL END) AS Acq,
           COUNT(DISTINCT CASE WHEN ufs.acq_month THEN ufs.user ELSE NULL END) AS Acq_LM,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf.incentived = FALSE THEN uf.user ELSE NULL END) AS Acq_No_Voucher,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf1.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M1,
           COUNT(DISTINCT CASE WHEN ufs.acq_month AND uf.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M1_LM,
           COUNT(DISTINCT CASE WHEN ufs.acq_month AND uf.active_users = 0 THEN uf.user ELSE NULL END) AS Acq_M1_No_Return_LM,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND (uf.funnel = 'New' OR uf.acq_month) THEN uf.user ELSE NULL END) AS Active_New,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.user ELSE NULL END) AS Active_Onb_Healthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.user ELSE NULL END) AS Active_Onb_Unhealthy,
           SUM(uf.orders_tm) AS Orders_TM,
           SUM(uf.orders_log_tm) AS Orders_Log_TM,
           SUM(uf.gmv) AS GMV,
           SUM(uf.total_revenue) AS Total_Revenue,
           SUM(uf.commission_revenue) AS Commission_Revenue,
           SUM(uf.df_revenue) AS DF_Revenue,
           SUM(uf.cpo) AS CPO_Rider,
           SUM(uf.basket_incentives) AS BI,
           SUM(uf.acq_basket_incentives) AS Acq_BI,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.basket_incentives ELSE 0 END) AS BI_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'ADR' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_ADR,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Percentile' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_AOV,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Both' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Both,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.healthy = 'ADR' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb_ADR,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.healthy = 'Percentile' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb_AOV,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.healthy = 'Both' AND uf.acq_month = FALSE THEN uf.user ELSE NULL END) AS Active_Onb_Both,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.orders_tm ELSE 0 END) AS Orders_TM_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.healthy = 'Healthy' AND uf.acq_month = FALSE THEN uf.orders_tm ELSE 0 END) AS Orders_TM_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.healthy != 'Healthy' AND uf.acq_month = FALSE THEN uf.orders_tm ELSE 0 END) AS Orders_TM_Onb_Unhealthy,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND uf.healthy = 'Healthy' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Healthy,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND uf.healthy != 'Healthy' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Unhealthy,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' THEN uf.user ELSE NULL END) AS No_Return_Onb,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.healthy = 'Healthy' AND ufs.funnel = 'Onboarded' THEN uf.user ELSE NULL END) AS No_Return_Onb_Healthy,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.healthy != 'Healthy' AND ufs.funnel = 'Onboarded' THEN uf.user ELSE NULL END) AS No_Return_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.gmv ELSE 0 END) AS GMV_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Unhealthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.user ELSE NULL END) AS Active_Onb_Over,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.user ELSE NULL END) AS Active_Onb_Stable,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.user ELSE NULL END) AS Active_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.user ELSE NULL END) AS Active_Onb_Over_Healthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' AND uf.intermittency_type = '30D' THEN uf.user ELSE NULL END) AS Active_Onb_Stable_Healthy,
           COUNT(DISTINCT CASE WHEN uf.active_users >> 0 AND uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' AND uf.intermittency_type = '6D' THEN uf.user ELSE NULL END) AS Active_Onb_Heavy_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.basket_incentives ELSE 0 END) AS BI_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.orders_tm ELSE 0 END) AS Orders_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.orders_tm ELSE 0 END) AS Orders_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.orders_tm ELSE 0 END) AS Orders_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type IN ('Over 30D','No Calculable') THEN uf.user ELSE NULL END) AS No_Return_Onb_Over,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '30D' THEN uf.user ELSE NULL END) AS No_Return_Onb_Stable,
           COUNT(DISTINCT CASE WHEN uf.acq_month = FALSE AND uf.active_users = 0 AND ufs.active_users >> 0 AND ufs.acq_month = FALSE AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '6D' THEN uf.user ELSE NULL END) AS No_Return_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type IN ('Over 30D','No Calculable') THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Over,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '30D' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Stable,
           COUNT(DISTINCT CASE WHEN ufs.acq_month = FALSE AND ufs.active_users >> 0 AND ufs.funnel = 'Onboarded' AND ufs.intermittency_type = '6D' THEN ufs.user ELSE NULL END) AS Active_No_Acq_LM_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.gmv ELSE 0 END) AS GMV_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.gmv ELSE 0 END) AS GMV_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.total_revenue ELSE 0 END) AS Total_Revenue_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.cpo ELSE 0 END) AS CPO_Rider_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_Onb_Heavy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.total_amount ELSE 0 END) AS Total_Amount_Onb_Heavy,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_Active_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf3.healthy = 'Healthy' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_Healthy_M3,
           COUNT(DISTINCT CASE WHEN uf3.funnel = 'Onboarded' AND uf3.healthy = 'Healthy' AND uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_Healthy_M3,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_Active_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf6.healthy = 'Healthy' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_Healthy_M6,
           COUNT(DISTINCT CASE WHEN uf6.funnel = 'Onboarded' AND uf6.healthy = 'Healthy' AND uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_Healthy_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.total_revenue - uf.basket_incentives - uf.cpo - uf.extra_cpo ELSE 0 END) AS FLGP_M0,
           SUM(CASE WHEN uf.acq_month THEN uf.orders_tm ELSE 0 END) AS Orders_M0,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy = 'Healthy' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Healthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.healthy != 'Healthy' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Unhealthy,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type IN ('Over 30D','No Calculable') THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Over,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '30D' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Stable,
           SUM(CASE WHEN uf.funnel = 'Onboarded' AND uf.acq_month = FALSE AND uf.intermittency_type = '6D' THEN uf.unprofitable_orders_tm ELSE 0 END) AS Orders_Onb_Unp_Heavy,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf.desirable THEN uf.user ELSE NULL END) AS Acq_Desirable,
           SUM(CASE WHEN uf.acq_month THEN uf1.orders_tm ELSE 0 END) AS Orders_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.orders_tm ELSE 0 END) AS Orders_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.orders_tm ELSE 0 END) AS Orders_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.gmv + uf.peya_discounts ELSE 0 END) AS GMV_Gross_M0,
           SUM(CASE WHEN uf.acq_month THEN uf1.gmv + uf1.peya_discounts ELSE 0 END) AS GMV_Gross_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.gmv + uf3.peya_discounts ELSE 0 END) AS GMV_Gross_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.gmv + uf6.peya_discounts ELSE 0 END) AS GMV_Gross_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.basket_incentives ELSE 0 END) AS BI_M0,
           SUM(CASE WHEN uf.acq_month THEN uf1.basket_incentives ELSE 0 END) AS BI_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.basket_incentives ELSE 0 END) AS BI_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.basket_incentives ELSE 0 END) AS BI_M6,
           SUM(CASE WHEN uf.acq_month THEN uf.total_amount ELSE 0 END) AS Total_Amount_M0,
           SUM(CASE WHEN uf.acq_month THEN uf1.total_amount ELSE 0 END) AS Total_Amount_M1,
           SUM(CASE WHEN uf.acq_month THEN uf3.total_amount ELSE 0 END) AS Total_Amount_M3,
           SUM(CASE WHEN uf.acq_month THEN uf6.total_amount ELSE 0 END) AS Total_Amount_M6,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf3.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M3,
           COUNT(DISTINCT CASE WHEN uf.acq_month AND uf6.active_users >> 0 THEN uf.user ELSE NULL END) AS Acq_M6,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_M1,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf.acq_month AND uf1.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_M1,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf1.healthy = 'Healthy' AND uf.acq_month THEN uf.user ELSE NULL END) AS Onb_Healthy_M1,
           COUNT(DISTINCT CASE WHEN uf1.funnel = 'Onboarded' AND uf1.healthy = 'Healthy' AND uf.acq_month AND uf1.active_users >> 0 THEN uf.user ELSE NULL END) AS Onb_Active_Healthy_M1,
           CURRENT_DATE() AS Actual_Date
    FROM `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS ufs ON uf.user = ufs.user
                                                                                 AND uf.country_id = ufs.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(ufs.month,INTERVAL 1 MONTH))
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf1 ON uf.user = uf1.user
                                                                                 AND uf.country_id = uf1.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(uf1.month,INTERVAL -1 MONTH))
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf3 ON uf.user = uf3.user
                                                                                 AND uf.country_id = uf3.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(uf3.month,INTERVAL -3 MONTH))
    LEFT JOIN `peya-argentina.user_santiago_curat.user_funnel_monthly` AS uf6 ON uf.user = uf6.user
                                                                                 AND uf.country_id = uf6.country_id
                                                                                 AND uf.month = LAST_DAY(DATE_ADD(uf6.month,INTERVAL -6 MONTH))
    GROUP BY 1,2
    ORDER BY 1,2)
SELECT gt.*,
       IFNULL(ct.orders_m1,0) AS Acum_Orders_M1,
       IFNULL(ct.flgp_m1,0) AS Acum_FLGP_M1,
       IFNULL(ct.orders_m3,0) AS Acum_Orders_M3,
       IFNULL(ct.flgp_m3,0) AS Acum_FLGP_M3,
       IFNULL(ct.orders_m6,0) AS Acum_Orders_M6,
       IFNULL(ct.flgp_m6,0) AS Acum_FLGP_M6
FROM general_table AS gt
LEFT JOIN cohorts_table AS ct ON gt.country = ct.country
                                 AND gt.month = ct.month]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
