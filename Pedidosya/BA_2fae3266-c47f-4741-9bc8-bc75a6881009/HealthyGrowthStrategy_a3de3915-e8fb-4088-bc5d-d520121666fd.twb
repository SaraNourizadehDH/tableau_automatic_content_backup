    <worksheet name='Frequency'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lifecycle' name='federated.0uf0rs31231fub11xr7p31b3q2z7' />
          </datasources>
          <datasource-dependencies datasource='federated.0uf0rs31231fub11xr7p31b3q2z7'>
            <column datatype='integer' name='[Acq]' role='measure' type='quantitative' />
            <column datatype='date' name='[Acq_Month]' role='dimension' type='ordinal' />
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_434315946930774073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Acq]) &gt; 0&#13;&#10;THEN SUM([Orders]) / SUM([Acq])&#13;&#10;ELSE 0 END' />
            </column>
