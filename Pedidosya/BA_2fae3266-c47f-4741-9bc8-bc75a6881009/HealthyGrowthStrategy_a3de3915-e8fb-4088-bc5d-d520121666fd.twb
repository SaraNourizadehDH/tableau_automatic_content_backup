            </column>
            <column caption='AOV Gross Heavy' datatype='real' default-format='C3082%' name='[AOV Gross Low Inter (copia)_434315946913079340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Orders_Onb_Heavy]) &gt; 0&#13;&#10;THEN SUM([GMV_Gross_Onb_Heavy]) / SUM([Orders_Onb_Heavy])&#13;&#10;ELSE 0 END' />
