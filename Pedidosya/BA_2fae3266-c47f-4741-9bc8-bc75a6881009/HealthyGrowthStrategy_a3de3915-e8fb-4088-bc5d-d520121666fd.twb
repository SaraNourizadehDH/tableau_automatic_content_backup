    <worksheet name='BR_Customers'>
      <table>
        <view>
          <datasources>
            <datasource caption='Business' name='federated.0e49czv1gz5io012q9goc0rsytbs' />
          </datasources>
          <datasource-dependencies datasource='federated.0e49czv1gz5io012q9goc0rsytbs'>
            <column datatype='integer' name='[Acq]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Acq_Desirable]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Acq_LM]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Acq_M1_LM]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Acq_M1_No_Return_LM]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Active_LM]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Active_No_Acq_LM]' role='measure' type='quantitative' />
            <column caption='% M1 Last Month' datatype='real' default-format='p0.00%' name='[Calculation_1349672571037806592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Acq_LM]) &gt; 0 &#13;&#10;THEN SUM([Acq_M1_LM]) / SUM([Acq_LM])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Acquisitions Last Month Not Retained' datatype='integer' name='[Calculation_1349672571040272385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Acq_M1_No_Return_LM])*-1' />
            </column>
            <column caption='No Return Active Customers Last Month' datatype='integer' name='[Calculation_1349672571040600066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([No_Return])*-1' />
            </column>
            <column caption='% Desirable' datatype='real' default-format='p0.00%' name='[Calculation_1349672571040948227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Acq]) &gt; 0&#13;&#10;THEN SUM([Acq_Desirable]) / SUM([Acq])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='% Healthy Reactivations' datatype='real' default-format='p0.00%' name='[Calculation_1349672571041386500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([React]) &gt; 0&#13;&#10;THEN SUM([Healthy_React]) / SUM([React])&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Active Customers This Month' datatype='integer' name='[Calculation_1349672571041685509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Active_LM]) + [Calculation_1349672571040272385] + [Calculation_1349672571040600066] + SUM([Acq]) + SUM([React])' />
            </column>
            <column caption='% No Return Active Customers Last Month' datatype='real' default-format='p0.00%' name='[Calculation_454863620295016448]' role='measure' type='quantitative'>
