      <aliases enabled='yes' />
      <column datatype='integer' name='[Age may-23]' role='measure' type='ordinal' />
      <column caption='Bucket productividad' datatype='string' name='[Calculation_1137721891063373824]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [may-23]&lt;=4 THEN &quot;0-4&quot; &#13;&#10;ELSEIF [may-23]&gt;=5 AND [may-23]&lt;=9 THEN &quot;5-9&quot;&#13;&#10;ELSEIF [may-23]&gt;=10 AND [may-23]&lt;=14 THEN &quot;10-14&quot;&#13;&#10;ELSEIF [may-23]&gt;=15 AND [may-23]&lt;=19 THEN &quot;15-19&quot;&#13;&#10;ELSEIF [may-23]&gt;=20 AND [may-23]&lt;=24 THEN &quot;20-24&quot;&#13;&#10;ELSEIF [may-23]&gt;=25 AND [may-23]&lt;=29 THEN &quot;25-29&quot;&#13;&#10;ELSEIF [may-23]&gt;=30 AND [may-23]&lt;=34 THEN &quot;30-34&quot;&#13;&#10;ELSEIF [may-23]&gt;=35 AND [may-23]&lt;=49 THEN &quot;35-49&quot;&#13;&#10;ELSEIF [may-23]&gt;=50 AND [may-23]&lt;=99 THEN &quot;50-99&quot;&#13;&#10;ELSEIF [may-23]&gt;=100 THEN &quot;&gt;100&quot;&#13;&#10;END' />
      </column>
      <column caption='Cohort may (&lt;6, &gt;6)' datatype='string' name='[Calculation_1137721891069988865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age may-23] &lt;=6 THEN &quot;0-6&quot; &#13;&#10;ELSEIF [Age may-23]&gt;6 THEN &quot;&gt;6&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;0-6&quot;' value='Seller age: 0 - 6 months' />
          <alias key='&quot;&gt;6&quot;' value='Sellers age: &gt;6 months' />
        </aliases>
      </column>
      <column caption='Low/High performer may' datatype='string' name='[Calculation_1248904506578403328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [may-23]&lt;=10 THEN &quot;Low Performer&quot; ELSE &quot;High Performer&quot; END' />
      </column>
      <column datatype='string' name='[Cohort may-23]' role='dimension' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
