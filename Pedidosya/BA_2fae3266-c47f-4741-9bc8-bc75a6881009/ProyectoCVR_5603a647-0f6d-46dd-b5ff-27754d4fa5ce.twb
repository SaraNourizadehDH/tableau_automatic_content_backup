      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05qqt5x0frgexp14hhca308dtge6].[sum:daily_qty_sessions:qk]&quot;' value='Sessions' />
          <alias key='&quot;[federated.05qqt5x0frgexp14hhca308dtge6].[sum:fact_orders_total_confirmed_orders:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.05qqt5x0frgexp14hhca308dtge6].[sum:total_confirmed_orders:qk]&quot;' value='Orders ' />
        </aliases>
      </column>
      <column caption='CVR3' datatype='real' name='[Calculation_1718967729208864768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([daily_qty_sessions_with_orders])/SUM([daily_qty_sessions])' />
      </column>
      <column caption='% Pics' datatype='real' name='[Calculation_1718967729209729025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(AVG([qty_picts])/AVG([qty_products])&gt;=1) THEN 1 ELSE AVG([qty_picts])/AVG([qty_products]) END' />
      </column>
      <column caption='dynamic_date' datatype='string' name='[Calculation_1718967729212452866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[session_date Parameter]&#13;&#10; WHEN &apos;Daily&apos; THEN [Calculation_1718967729212657667]&#13;&#10; WHEN &apos;Monthly&apos; THEN [date_day_string (copy)_1718967729212833796]&#13;&#10; WHEN &apos;Weekly&apos; THEN [date_month_string (copy)_1718967729213026309]&#13;&#10;END' />
      </column>
      <column caption='date_day_string' datatype='string' name='[Calculation_1718967729212657667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,[session_date]),3)) + &apos; &apos;+ &#13;&#10;STR(LEFT(DATENAME(&apos;day&apos;,[session_date]),2)) + &apos;, &apos;&#13;&#10;+ RIGHT(STR(DATEPART(&apos;year&apos;,[session_date])),4)' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1718967729223806982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GFV])/SUM([total_confirmed_orders])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Partners proyecto CVR' datatype='table' name='[__tableau_internal_object_id__].[Partners proyecto CVR_FAA15A39FDE14C488170682A19CEA578]' role='measure' type='quantitative' />
