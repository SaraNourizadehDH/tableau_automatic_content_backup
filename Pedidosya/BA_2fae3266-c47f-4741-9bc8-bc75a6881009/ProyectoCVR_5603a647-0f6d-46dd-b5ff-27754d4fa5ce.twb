      <column caption='date_month_string' datatype='string' name='[date_day_string (copy)_1718967729212833796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,[session_date]),3)) + &apos;, &apos; &#13;&#10;+ RIGHT(STR(DATEPART(&apos;year&apos;,[session_date])),4)' />
      </column>
      <column caption='date_week_string' datatype='string' name='[date_month_string (copy)_1718967729213026309]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,DATE(DATETRUNC(&apos;week&apos;,[session_date],&apos;monday&apos;))),3)) &#13;&#10;//+ &apos; &apos; + RIGHT(STR(DATEPART(&apos;year&apos;,DATE(DATETRUNC(&apos;week&apos;,[[session_date] date],&apos;monday&apos;)))),2) +&apos;, &apos;&#13;&#10;+&apos; &apos;+ STR(DATEPART(&apos;day&apos;, DATE(DATETRUNC(&apos;week&apos;,[session_date],&apos;monday&apos;)))) + &#13;&#10; &apos;, &apos; + RIGHT(STR(DATEPART(&apos;year&apos;,DATE(DATETRUNC(&apos;week&apos;,[session_date],&apos;monday&apos;)))),4)' />
      </column>
