      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Argentina&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_A7AA8BF2781D45078FC7E49B5BC5F805'>
            <properties context=''>
              <relation connection='bigquery.0utuwge0c0ev0c1649ffz1sjeweq' name='Consulta SQL personalizada' type='text'>SELECT  &#13;
                    DATE_TRUNC(DATE(op.closedate),MONTH) AS date_month,&#13;
                    DATE_TRUNC(DATE(op.closedate),DAY) AS date_day,&#13;
                    dc.country_id,&#13;
                    dc.country_name,&#13;
                    dc.country_name_en,&#13;
                    a.GRID,&#13;
                    p.partner_name AS Partner,&#13;
                    a.Vertical,&#13;
                    bt.business_type_id,&#13;
                    bt.business_type_name,&#13;
                    a.AccountSource,&#13;
                    a.Competitor,&#13;
                    u.Id AS Sales_Executive_ID,&#13;
                    u.Name AS Sales_Executive&#13;
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op&#13;
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId&#13;
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` AS u ON op.OwnerId=u.Id&#13;
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc ON a.Account_Country_Code =dc.country_code&#13;
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p ON p.salesforce_id=a.GRID&#13;
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_business_type` AS bt ON bt.business_type_id = p.business_type_id&#13;
            WHERE DATE(op.closedate) &gt;&gt;= &quot;2020-01-01&quot;&#13;
            AND op.StageName = &quot;Closed Won&quot;&#13;
            AND op.Business_Type IN (&quot;New Business&quot;,&quot;Win Back&quot;)&#13;
            AND a.Vertical IN (&quot;Shop&quot;,&quot;Restaurant&quot;)&#13;
            AND a.Competitor IS NOT NULL&#13;
              ORDER BY date_day ASC</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
