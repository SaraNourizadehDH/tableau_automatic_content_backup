      <column caption='Fixed_total' datatype='integer' name='[Calculation_1322369470771269633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_month], [is_competitor] : sum   ([New_closed_won]) }' />
      </column>
      <column caption='Share' datatype='real' name='[Calculation_1322369470774620162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([New_closed_won]) / SUM([Calculation_1322369470771269633])' />
      </column>
      <column caption='Vertical' datatype='string' name='[Calculation_435160334646165511]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [business_type_name] = &quot;Coffee&quot; THEN &quot;Food&quot;&#13;&#10;ELSEIF  [business_type_name] = &quot;Restaurant&quot; THEN &quot;Food&quot;&#13;&#10;ELSEIF [business_type_name] = &quot;Courier&quot; THEN &quot;Courier&quot;&#13;&#10;ELSEIF [business_type_name] = &quot;Courier Business&quot; THEN &quot;Courier&quot;&#13;&#10;ELSE &quot;Local Stores&quot;&#13;&#10;END' />
