      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0jgkzce1yzg1qc1f5clop15hz5m5'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='automated_tables_reports' server-oauth='server-custom' username='bianca.degani@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <relation connection='bigquery.0jgkzce1yzg1qc1f5clop15hz5m5' name='Consulta SQL personalizada' type='text'>with dates as (&#10;    SELECT&#10;        DATE(&apos;2023-08-01&apos;) AS from_date,&#10;        DATE(current_date)-1 AS to_date&#10;)&#10;,&#10;Order_Base as (&#10;SELECT&#10;  o.order_id,&#10;  date_trunc(o.registered_Date,month) as month,&#10;  fo.country_name country_name,&#10;  CASE WHEN user.is_user_plus THEN TRUE ELSE FALSE END is_user_plus,&#10;  category,&#10;  MOV_LC,&#10;  MOV_LC/(monthly_rate_eu) AS MOV_EU, &#10;  round(total_amount/monthly_rate_eu,2) as total_amount&#10;&#10;   FROM `peya-fraud-and-fintech.group_finance_data.fact_orders_profitability` o&#10; LEFT join(&#10;  SELECT distinct&#10;  order_id,&#10;  o.country.country_name,&#10;  o.registered_date,&#10;  amount_no_discount,&#10;  total_amount,&#10;    case &#10;  when is_darkstore then &apos;Dmart&apos;&#10;  #when o.business_type.business_type_name = &apos;Market&apos; then &apos;Dmart&apos;&#10;  when o.business_type.business_type_name in (&quot;Restaurant&quot;,&quot;Coffee&quot;,&quot;Concepts&quot;,&quot;Kitchen&quot;) then &apos;Food&apos;&#10;  else &apos;Local Stores&apos; end as category ,&#10;  FROM `peya-bi-tools-pro.il_core.fact_orders` o&#10;    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` P &#10;  ON o.restaurant.id=p.partner_id&#10;  WHERE o.registered_date  BETWEEN (SELECT from_date FROM dates) AND (SELECT to_date FROM dates)&#10; )  fo on o.order_id=fo.order_id&#10;&#10;  LEFT JOIN `peya-delivery-and-support.automated_tables_reports.ar_plus_mov_tableau` m&#10;    ON m.country=fo.country_name &#10;      and m.month=DATE_TRUNC(o.registered_date, MONTH)&#10;      and m.VERTICAL= CASE WHEN fo.category=&apos;Food&apos; then &apos;Food&apos; ELSE &apos;QC&apos; END&#10;WHERE o.registered_date BETWEEN (SELECT from_date FROM dates) AND (SELECT to_date FROM dates)&#10;and fo.country_name in(&quot;Argentina&quot;,&quot;Chile&quot;,&quot;Ecuador&quot;,&quot;Perú&quot;,&quot;República Dominicana&quot;,&quot;Guatemala&quot;, &quot;El Salvador&quot;, &quot;Bolivia&quot;, &quot;Panamá&quot;)&#10;and partner.vertical_group not in (&quot;Courier&quot;,&quot;Courier Business&quot;)&#10;and o.order_status = &quot;CONFIRMED&quot;&#10;#and is_user_plus&#10;),&#10;stats as (&#10;  select &#10;  country_name, is_user_plus, min(total_amount) as min, max(total_amount) as max&#10;  from Order_Base&#10;  where total_amount&gt;&gt;0&#10;  group by 1,2&#10;)&#10;&#10;SELECT &#10;    &apos;Total&apos; as category&#10;    ,CAST(floor(&#10;        (ln(total_amount-min+1)/ln(max-min+1)) * (60-1)) &#10;      AS INT64) group_flag,&#10;      b.country_name,&#10;      b.month,&#10;      b.is_user_plus,&#10;      case when avg(MOV_EU) &lt;&lt; max(total_amount) then &apos;NO&apos; else &apos;YES&apos; end as below_mov,&#10;    concat(&apos;[&apos;,min(total_amount),&apos;,&apos;,max(total_amount),&apos;]&apos;) as group_value_range,&#10;    avg(MOV_EU) as MOV_EU,&#10;    count(order_id) as quantity&#10;FROM Order_Base b&#10;LEFT JOIN stats s on s.country_name=b.country_name and s.is_user_plus=b.is_user_plus &#10;where total_amount&gt;&gt;0&#10;GROUP BY 1,2,3,4,5&#10;#order by 2,3,4,1&#10;&#10;UNION ALL &#10;&#10;SELECT &#10;    category as category&#10;    ,CAST(floor(&#10;        (ln(total_amount-min+1)/ln(max-min+1)) * (60-1)) &#10;      AS INT64) group_flag,&#10;      b.country_name,&#10;      b.month,&#10;      b.is_user_plus,&#10;      case when avg(MOV_EU) &lt;&lt; max(total_amount) then &apos;NO&apos; else &apos;YES&apos; end as below_mov,&#10;    concat(&apos;[&apos;,min(total_amount),&apos;,&apos;,max(total_amount),&apos;]&apos;) as group_value_range,&#10;    avg(MOV_EU) as MOV_EU,&#10;    count(order_id) as quantity&#10;FROM Order_Base b&#10;LEFT JOIN stats s on s.country_name=b.country_name and s.is_user_plus=b.is_user_plus &#10;where total_amount&gt;&gt;0&#10;GROUP BY 1,2,3,4,5</relation>
