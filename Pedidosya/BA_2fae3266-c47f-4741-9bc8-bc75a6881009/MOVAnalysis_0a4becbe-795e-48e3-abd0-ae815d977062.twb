          <alias key='&quot;[federated.0oen8y60o4yano13rmba9092931j].[usr:Calculation_1614821966998728704:qk]&quot;' value='% Orders' />
        </aliases>
      </column>
      <column caption='AFV_No Plus' datatype='real' name='[AFV_Plus (copia)_1879689917591097362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(if not [is_user_plus] then  [GFV_EU] end)/sum(if not [is_user_plus] then[ORDERS] end))' />
      </column>
      <column caption='AFV_Plus&gt;AFV_No_Plus Contry' datatype='boolean' name='[AFV_Plus&gt;AFV_No_Plus (copia)_1879689917596798995]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed [country_name], [Calculation_1879689917243752450]:[Calculation_1879689917590061073]}&#13;&#10;&gt;&#13;&#10;{fixed [country_name], [Calculation_1879689917243752450]:[AFV_Plus (copia)_1879689917591097362]}' />
      </column>
      <column caption='AFV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1879689917242810368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(case [Parameters].[Parámetro 1] when &apos;LC&apos; then [GFV] else [GFV_EU] end)/sum([ORDERS])' />
      </column>
      <column caption='YearMonth' datatype='string' name='[Calculation_1879689917243752450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year([month]))+&apos;-&apos;+str(month([month])) + &apos; (&apos; +LEFT(STR(DATENAME(&apos;month&apos;,[month])),3) + &apos;)&apos;' />
      </column>
      <column caption='%OrdersOverMOV' datatype='real' default-format='p0.0%' name='[Calculation_1879689917245116419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ORDERS_OVER_MOV])/SUM([ORDERS])' />
      </column>
      <column caption='AFV_Plus&gt;AFV_No_Plus' datatype='boolean' name='[Calculation_1879689917247369220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed [country_name],[category]:[Calculation_1879689917590061073]}&#13;&#10;&gt;&#13;&#10;{fixed [country_name],[category]:[AFV_Plus (copia)_1879689917591097362]}' />
      </column>
      <column caption='total_amount_PO_eu' datatype='real' name='[Calculation_1879689917258145797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_amount_EU])/sum([ORDERS])' />
      </column>
      <column caption='discount_paid_by_companyPO' datatype='real' name='[Calculation_1879689917258326022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([discount_paid_by_company_EU])/sum([ORDERS])' />
      </column>
      <column caption='dmart_discounts_in_productsPO' datatype='real' name='[Calculation_1879689917258493959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-sum([dmart_discounts_in_products_EU])/sum([ORDERS])' />
      </column>
      <column caption='shipping_amount_PO' datatype='real' name='[Calculation_1879689917258727432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-sum([shipping_amount_no_discount_EU]-[shipping_amount_EU])/sum([ORDERS])' />
      </column>
      <column caption='service_fee_PO' datatype='real' name='[Calculation_1879689917258973193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-sum([service_fee_no_discount_EU]-[service_fee_amount_EU])/sum([ORDERS])' />
      </column>
      <column caption='GFV_PO' datatype='real' name='[Calculation_1879689917259456522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GFV_EU])/sum([ORDERS])' />
      </column>
      <column caption='LAST' datatype='integer' name='[Calculation_1879689917300224011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LAST()+1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='fILTRO2' datatype='integer' name='[Calculation_1879689917302722572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LAST()'>
          <table-calc ordering-type='Rows' />
