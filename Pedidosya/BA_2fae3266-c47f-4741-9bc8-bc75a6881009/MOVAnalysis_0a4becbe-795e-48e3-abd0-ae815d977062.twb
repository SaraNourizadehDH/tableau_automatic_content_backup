          </named-connection>
        </named-connections>
        <relation connection='bigquery.13uv5p411c2tmf18dwpmj12evea2' name='Consulta SQL personalizada' type='text'>with dates as (&#13;&#10;    SELECT&#13;&#10;        DATE(&apos;2023-08-01&apos;) AS from_date,&#13;&#10;        DATE(current_date) AS to_date&#13;&#10;)&#13;&#10;&#13;&#10;SELECT&#13;&#10;  DATE_TRUNC(o.registered_date, MONTH) month,&#13;&#10;  fo.country_name country_name,&#13;&#10;  CASE WHEN user.is_user_plus THEN TRUE ELSE FALSE END is_user_plus,&#13;&#10;  #CASE &#13;&#10;  #  when vertical_type in(&quot;Courier&quot;,&quot;Courier Business&quot;) THEN &quot;Courier&quot;&#13;&#10;  #  when vertical_type in(&quot;Restaurant&quot;,&quot;Coffee&quot;,&quot;Concepts&quot;,&quot;Kitchen&quot;) THEN &quot;Food&quot;&#13;&#10;  #  when vertical_type in(&quot;D-Mart&quot;) THEN &quot;D-Mart&quot;&#13;&#10;  #  else &quot;Local Stores&quot; end as category,&#13;&#10;  category,&#13;&#10;  MOV_LC,&#13;&#10;  MOV_LC/avg(monthly_rate_eu) AS MOV_EU,&#13;&#10;  &#13;&#10;&#13;&#10;  count(o.order_id)  ORDERS,&#13;&#10;  count(case when total_amount&gt;&gt;=MOV_LC THEN o.order_id END)  ORDERS_OVER_MOV,&#13;&#10;  sum(o.gmv.gfv_vendor) GFV,&#13;&#10;  sum(o.gmv.gfv_vendor/monthly_rate_eu) GFV_EU,&#13;&#10;&#13;&#10;  sum(fo.total_amount/monthly_rate_eu) total_amount_EU,&#13;&#10;  sum(fo.discount_paid_by_company/monthly_rate_eu) discount_paid_by_company_EU,&#13;&#10;  sum(fo.dmart_discounts_in_products/monthly_rate_eu) dmart_discounts_in_products_EU,&#13;&#10;  sum(fo.shipping_amount/monthly_rate_eu) shipping_amount_EU,&#13;&#10;  sum(fo.service_fee_no_discount/monthly_rate_eu) service_fee_no_discount_EU,&#13;&#10;  sum(fo.service_fee_amount/monthly_rate_eu) service_fee_amount_EU,&#13;&#10;  sum(fo.shipping_amount_no_discount/monthly_rate_eu) shipping_amount_no_discount_EU,&#13;&#10;&#13;&#10;  #sum(case when o.order_status = &quot;CONFIRMED&quot; THEN o.gfv_vendor/monthly_rate_eu end) / count(case when o.order_status = &quot;CONFIRMED&quot; THEN o.order_id END) as AFV_EU,&#13;&#10;  #sum(case when o.order_status = &quot;CONFIRMED&quot; THEN o.gfv_vendor end) / count(case when o.order_status = &quot;CONFIRMED&quot; THEN o.order_id END) as AFV_LC,&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;   FROM `peya-fraud-and-fintech.group_finance_data.fact_orders_profitability` o&#13;&#10; LEFT join(&#13;&#10;  SELECT distinct&#13;&#10;  order_id,&#13;&#10;  o.country.country_name,&#13;&#10;  o.registered_date,&#13;&#10;  order_status,&#13;&#10;  has_plus_shipping_cost_discount,&#13;&#10;  plus_shipping_cost_discount_amount,&#13;&#10;  shipping_amount_no_discount,&#13;&#10;  amount_no_discount,&#13;&#10;  total_amount,&#13;&#10;  discount_paid_by_company,&#13;&#10;  o.shipping_amount,&#13;&#10;  partnership_discount_amount as dmart_discounts_in_products,&#13;&#10;  serviceFee.service_fee_no_discount,&#13;&#10;  serviceFee.service_fee_amount,&#13;&#10;  case &#13;&#10;  when is_darkstore then &apos;Dmart&apos;&#13;&#10;  #when o.business_type.business_type_name = &apos;Market&apos; then &apos;Dmart&apos;&#13;&#10;  when o.business_type.business_type_name in (&quot;Restaurant&quot;,&quot;Coffee&quot;,&quot;Concepts&quot;,&quot;Kitchen&quot;) then &apos;Food&apos;&#13;&#10;  else &apos;Local Stores&apos; end as category ,&#13;&#10;  FROM `peya-bi-tools-pro.il_core.fact_orders` o&#13;&#10;  LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` P &#13;&#10;  ON o.restaurant.id=p.partner_id&#13;&#10;  WHERE o.registered_date  BETWEEN (SELECT from_date FROM dates) AND (SELECT to_date FROM dates)&#13;&#10; )  fo on o.order_id=fo.order_id&#13;&#10;&#13;&#10;  LEFT JOIN `peya-delivery-and-support.automated_tables_reports.ar_plus_mov_tableau` m&#13;&#10;    ON m.country=fo.country_name &#13;&#10;      and m.month=DATE_TRUNC(o.registered_date, MONTH)&#13;&#10;      and m.VERTICAL= CASE WHEN fo.category=&apos;Food&apos; then &apos;Food&apos; ELSE &apos;QC&apos; END&#13;&#10;&#13;&#10;WHERE o.registered_date BETWEEN (SELECT from_date FROM dates) AND (SELECT to_date FROM dates)&#13;&#10;and fo.country_name in(&quot;Argentina&quot;,&quot;Chile&quot;,&quot;Ecuador&quot;,&quot;Perú&quot;,&quot;República Dominicana&quot;,&quot;Guatemala&quot;, &quot;El Salvador&quot;, &quot;Bolivia&quot;, &quot;Panamá&quot;)&#13;&#10;and partner.vertical_group not in (&quot;Courier&quot;,&quot;Courier Business&quot;)&#13;&#10;and o.order_status = &quot;CONFIRMED&quot;&#13;&#10;#and is_user_plus&#13;&#10;&#13;&#10;group by 1,2,3,4,5&#13;&#10;order by 2,1</relation>
