      <column caption='% Vendor/GMV' datatype='real' default-format='p0.00%' name='[% Company/GMV (copia)_960674151786442760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ISNULL([plus_discount_eur_partner]) THEN 0 ELSE [plus_discount_eur_partner] END)/SUM([gmv_eur])' />
      </column>
      <column caption='% Órdenes Partner Plus' datatype='real' default-format='p0.0%' name='[% Partner Plus (copia)_960674151457984515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partner_plus_orders])/SUM([total_orders])' />
      </column>
      <column caption='% Órdenes User Plus' datatype='real' default-format='p0.0%' name='[% Órdenes Partner Plus (copia)_806144393429630981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([user_plus_orders])/SUM([total_orders])' />
      </column>
      <column caption='% Órdenes Plus' datatype='real' default-format='p0.0%' name='[% Órdenes User Plus (copia)_806144393471430664]' role='measure' type='quantitative'>
