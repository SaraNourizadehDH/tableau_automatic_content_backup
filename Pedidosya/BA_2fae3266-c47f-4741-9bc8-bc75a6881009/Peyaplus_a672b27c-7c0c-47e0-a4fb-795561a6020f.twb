      <table>
        <view>
          <datasources>
            <datasource caption='Evolución PLUS (user_erik_otero)' name='federated.1y0vynr15v94bv1di33d5043ndvi' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Only Plus Cities' datatype='boolean' datatype-customized='true' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1y0vynr15v94bv1di33d5043ndvi'>
            <column caption='% Vendor/GMV' datatype='real' default-format='p0.00%' name='[% Company/GMV (copia)_960674151786442760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ISNULL([plus_discount_eur_partner]) THEN 0 ELSE [plus_discount_eur_partner] END)/SUM([gmv_eur])' />
            </column>
            <column caption='City Plus' datatype='boolean' name='[Calculation_960674151756779524]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN TRUE THEN [is_city_plus] = TRUE&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='% Company/GMV' datatype='real' default-format='p0.00%' name='[Calculation_960674151786172423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ISNULL([plus_discount_eur_company]) THEN 0 ELSE [plus_discount_eur_company] END)/SUM([gmv_eur])' />
