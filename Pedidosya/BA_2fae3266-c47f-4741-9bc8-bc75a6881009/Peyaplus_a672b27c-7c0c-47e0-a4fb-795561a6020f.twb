            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Only Plus Cities' datatype='boolean' datatype-customized='true' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1y0vynr15v94bv1di33d5043ndvi'>
            <column caption='% Órdenes Partner Plus' datatype='real' default-format='p0.0%' name='[% Partner Plus (copia)_960674151457984515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partner_plus_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Partner Plus' datatype='real' default-format='p0.0%' name='[Calculation_960674151452393474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_partner_plus] THEN 1 END)/SUM(IF NOT ISNULL([partner_id]) THEN 1 END)' />
            </column>
            <column caption='City Plus' datatype='boolean' name='[Calculation_960674151756779524]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN TRUE THEN [is_city_plus] = TRUE&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='Partners Plus' datatype='integer' name='[Calculation_960674151757094917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_partner_plus] THEN [partner_id] END' />
            </column>
            <column caption='Plus discount total' datatype='real' name='[Calculation_960674151778086918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([plus_discount_eur_company]) THEN 0 ELSE [plus_discount_eur_company] END&#13;&#10;+&#13;&#10;IF ISNULL([plus_discount_eur_partner]) THEN 0 ELSE [plus_discount_eur_partner] END' />
            </column>
