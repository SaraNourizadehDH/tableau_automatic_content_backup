    <datasource caption='Consulta SQL personalizada (automated_tables_reports)' inline='true' name='federated.0adtlck0cg26di1h06at50kvrlqo' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1dh7la611ryivg17jl3yb1ave07q'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='automated_tables_reports' server-oauth='server-custom' username='franco.cilotta@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1dh7la611ryivg17jl3yb1ave07q' name='Consulta SQL personalizada1' type='text'>select * from&#13;
`peya-delivery-and-support.automated_tables_reports`.`CPA`&#13;
where Month&gt;&gt;=&quot;2023-07-01&quot; and SSU_or_Field_or_Non_Seller = &quot;Field Seller&quot;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1dh7la611ryivg17jl3yb1ave07q' name='Consulta SQL personalizada' type='text'>SELECT *&#13;
 FROM `peya-food-and-groceries.automated_tables_reports.Regional_Performance`</relation>
          <relation connection='bigquery.1dh7la611ryivg17jl3yb1ave07q' name='Consulta SQL personalizada1' type='text'>select * from&#13;
`peya-delivery-and-support.automated_tables_reports`.`CPA`&#13;
where Month&gt;&gt;=&quot;2023-07-01&quot; and SSU_or_Field_or_Non_Seller = &quot;Field Seller&quot;</relation>
          <relation connection='bigquery.1dh7la611ryivg17jl3yb1ave07q' name='Consulta SQL personalizada2' type='text'>SELECT &#13;
o.registered_date,&#13;
o.commission_confirmed,&#13;
o.confirmed_gmv,&#13;
o.commission_confirmed*o.confirmed_gmv AS Com_Rev,&#13;
c.Grid,&#13;
dp.partner_name,&#13;
dp.partner_id,&#13;
c.Seller,&#13;
DATE(cw.closed_date) AS AcqDate,&#13;
COUNT(DISTINCT o.order_id) as cantidad_ordenes,&#13;
FROM `peya-bi-tools-pro.il_core.fact_orders`  o&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp&#13;
ON dp.partner_id = o.restaurant.id &#13;
LEFT JOIN  `peya-delivery-and-support.automated_tables_reports.CPA` c&#13;
on dp.salesforce_id=c.Grid&#13;
LEFT JOIN &#13;
&#13;
(SELECT grid, closed_date, ROW_NUMBER() OVER (PARTITION BY GRID ORDER BY closed_date DESC) AS ROW_NUM&#13;
  &#13;
  FROM `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` ) cw&#13;
ON cw.grid=c.Grid&#13;
WHERE o.registered_date&gt;&gt;=&quot;2023-07-01&quot;&#13;
AND o.registered_date&gt;&gt;=DATE(cw.closed_date)&#13;
AND c.Month&gt;&gt;=&quot;2023-07-01&quot;&#13;
AND cw.ROW_NUM=1&#13;
GROUP BY 1,2,3,4,5,6,7,8,9&#13;
order by 3,1 asc</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
