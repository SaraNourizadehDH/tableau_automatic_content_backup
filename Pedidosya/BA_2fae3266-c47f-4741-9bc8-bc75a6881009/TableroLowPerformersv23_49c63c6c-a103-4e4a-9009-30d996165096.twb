      <column caption='Division Antiguedad' datatype='string' name='[Calculation_1025131920292569095]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Antiguedad] = &quot;M0&quot; OR [Antiguedad] = &quot;M1&quot; OR [Antiguedad] = &quot;M2&quot; THEN &quot;Menos de 3M&quot;&#13;&#10;ELSEIF [Antiguedad] = &quot;M3+&quot; THEN &quot;Mas de 3M&quot;&#13;&#10;END' />
