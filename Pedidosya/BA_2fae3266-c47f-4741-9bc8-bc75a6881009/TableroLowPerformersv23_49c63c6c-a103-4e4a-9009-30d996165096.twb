            <column datatype='string' name='[Business]' role='dimension' type='nominal' />
            <column caption='Performance' datatype='string' name='[Calculation_1025131918920474624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Total_Acquisitions_Anteultimo_Month]  &lt; [Productividad_Condicionada] * 0.6 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Total_Acquisitions_Anteultimo_Month]  &gt;= [Productividad_Condicionada] * 0.6 AND [Total_Acquisitions_Anteultimo_Month]  &lt; [Productividad_Condicionada] * 0.89 THEN &quot;Mid&quot;&#13;&#10;ELSE &quot;Top&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[Productividad_Condicionada]' role='measure' type='quantitative' />
            <column datatype='string' name='[Productivo]' role='dimension' type='nominal' />
            <column datatype='string' name='[Seller]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Total_Acquisitions_Anteultimo_Month]' role='measure' type='quantitative' />
            <column-instance column='[Seller]' derivation='Count' name='[cnt:Seller:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Antiguedad]' derivation='None' name='[none:Antiguedad:nk]' pivot='key' type='nominal' />
            <column-instance column='[Business]' derivation='None' name='[none:Business:nk]' pivot='key' type='nominal' />
