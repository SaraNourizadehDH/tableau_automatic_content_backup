      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0adtlck0cg26di1h06at50kvrlqo].[sum:Productividad_Condicionada:qk]&quot;' value='Productividad Target' />
          <alias key='&quot;[federated.0adtlck0cg26di1h06at50kvrlqo].[sum:Total_Acquisitions_Antepenultimo_Month:qk]&quot;' value='Julio' />
          <alias key='&quot;[federated.0adtlck0cg26di1h06at50kvrlqo].[sum:Total_Acquisitions_Anteultimo_Month:qk]&quot;' value='Agosto' />
          <alias key='&quot;[federated.0adtlck0cg26di1h06at50kvrlqo].[sum:Total_Acquisitions_Current_Month:qk]&quot;' value='Septiembre' />
          <alias key='&quot;[federated.0adtlck0cg26di1h06at50kvrlqo].[sum:Total_Acquisitions_Last_3_Months:qk]&quot;' value='Últimos 3 Meses' />
