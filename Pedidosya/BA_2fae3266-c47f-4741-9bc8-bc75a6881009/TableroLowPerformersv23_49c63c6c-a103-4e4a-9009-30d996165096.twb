      <column datatype='string' name='[Antiguedad]' role='dimension' type='nominal' />
      <column caption='Performance' datatype='string' name='[Calculation_1025131918920474624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total_Acquisitions_Anteultimo_Month]  &lt; [Productividad_Condicionada] * 0.6 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Total_Acquisitions_Anteultimo_Month]  &gt;= [Productividad_Condicionada] * 0.6 AND [Total_Acquisitions_Anteultimo_Month]  &lt; [Productividad_Condicionada] * 0.89 THEN &quot;Mid&quot;&#13;&#10;ELSE &quot;Top&quot;&#13;&#10;END' />
      </column>
      <column caption='Buckets' datatype='string' name='[Calculation_1025131920291389446]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total_Acquisitions_Anteultimo_Month] &gt;= 0 AND [Total_Acquisitions_Anteultimo_Month] &lt;= 10 THEN &quot;0 - 10&quot;&#13;&#10;ELSEIF [Total_Acquisitions_Anteultimo_Month] &gt;= 11 AND [Total_Acquisitions_Anteultimo_Month] &lt;= 15 THEN &quot;11 - 15&quot;&#13;&#10;ELSEIF [Total_Acquisitions_Anteultimo_Month] &gt;= 16 AND [Total_Acquisitions_Anteultimo_Month] &lt;= 20 THEN &quot;16 - 20&quot;&#13;&#10;ELSEIF [Total_Acquisitions_Anteultimo_Month] &gt;= 21 AND [Total_Acquisitions_Anteultimo_Month] &lt;= 25 THEN &quot;21 - 25&quot;&#13;&#10;ELSEIF [Total_Acquisitions_Anteultimo_Month] &gt;= 26 AND [Total_Acquisitions_Anteultimo_Month] &lt;= 30 THEN &quot;26 - 30&quot;&#13;&#10;ELSE &quot;31 &lt;&quot;&#13;&#10;END' />
