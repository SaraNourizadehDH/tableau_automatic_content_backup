      <aliases enabled='yes' />
      <column caption='Conversion real' datatype='real' name='[Calculation_1204712926914162695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2419840400945496064]/COUNT([id])' />
      </column>
      <column caption='Time to complete' datatype='real' name='[Calculation_1964132426372276224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[module_completion_date]-[createdAt]' />
      </column>
      <column caption='Suma completed' datatype='integer' name='[Calculation_2419840400945496064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IIF([module_status]=&apos;complete&apos;,[id],NULL))' />
      </column>
      <column caption='Licencias' datatype='integer' name='[Calculation_2419840400946774017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])' />
      </column>
      <column caption='Curso promedio real' datatype='real' name='[Calculation_2419840400947273730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2419840400945496064]/[Calculation_2419840400946774017]' />
      </column>
      <column caption='Cursos completados seamless link' datatype='integer' name='[Calculation_2992641981441781760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CountD(iif(ISNULL([phone]) AND ISNULL([email]) AND [module_status]=&apos;complete&apos;,[id],NULL))' />
      </column>
      <column caption='Share cursos completados seamless' datatype='real' name='[Calculation_2992641981442129921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2992641981441781760]/[Calculation_457396865060798470]' />
      </column>
      <column caption='Seamless link v2' datatype='integer' name='[Calculation_457396865060798470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CountD(iif(ISNULL([phone]) AND ISNULL([email]),[id],NULL))' />
      </column>
      <column caption='Share seamless link' datatype='real' name='[Calculation_457396865061318663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2992641981441781760]/[Cursos completados seamless link (copia)_401664824260108288]' />
      </column>
      <column caption='Conversion gral' datatype='real' default-format='p0%' name='[Calculation_598697300913741824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [module_status]:COUNT([id])}/{ FIXED :COUNT([id])}' />
      </column>
      <column caption='Cursos Promedio' datatype='real' name='[Calculation_598697301062537220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [module_status],[group]:COUNT([id])}/{FIXED [group]:COUNTD([id])}' />
      </column>
      <column aggregation='None' datatype='integer' name='[Cursos Promedio (agrupación)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='-1' formula='[Calculation_598697301062537220]' peg='0' size='0.12' />
      </column>
      <column caption='Cursos completados' datatype='integer' name='[Cursos completados seamless link (copia)_401664824260108288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CountD(iif([module_status]=&apos;complete&apos;,[id],NULL))' />
      </column>
      <column caption='Conversion gral por pais' datatype='real' default-format='p0%' name='[Cálculo1 (copia 2)_598697300938625027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [module_status],[group]:COUNT([id])}/{ FIXED [group]:COUNT([id])}' />
      </column>
      <column caption='conversion gral por fecha y pais' datatype='real' default-format='p0%' name='[Cálculo1 (copia) (copia)_1204712926910586884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [module_status],[createdAt],[group]:COUNT([id])}/{ FIXED [createdAt],[group]:COUNT([id])}' />
      </column>
      <column caption='Conversion por pais' datatype='real' default-format='p0%' name='[Cálculo1 (copia)_598697300923740162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [module_status],(DATEPART(&apos;year&apos;, [createdAt])*100 + DATEPART(&apos;month&apos;, [createdAt])),[group]:COUNT([id])}/{ FIXED [group],(DATEPART(&apos;year&apos;, [createdAt])*100 + DATEPART(&apos;month&apos;, [createdAt])):COUNT([id])}' />
      </column>
      <column caption='Suma completed (copia)' datatype='integer' name='[Suma completed (copia)_1204712926913679366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IIF([module_status]=&apos;complete&apos;,[id],NULL))' />
      </column>
