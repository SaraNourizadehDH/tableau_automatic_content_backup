              <calculation class='tableau' formula='CountD(iif([module_status]=&apos;complete&apos;,[id],NULL))' />
            </column>
            <column caption='fecha_creacion' datatype='datetime' name='[createdAt]' role='dimension' type='ordinal' />
            <column datatype='string' name='[email]' role='dimension' type='nominal' />
            <column caption='pais' datatype='string' name='[group]' role='dimension' type='nominal' />
