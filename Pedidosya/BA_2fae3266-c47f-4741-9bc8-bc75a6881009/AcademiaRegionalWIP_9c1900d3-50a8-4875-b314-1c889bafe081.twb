    --us.email_anonymized,&#13;
    us.phone,&#13;
    --us.phone_anonymized,&#13;
    us.firstName,&#13;
    us.lastName,&#13;
    EXTRACT(MONTH FROM CAST(us.createdAt as timestamp)) AS month_created,&#13;
    EXTRACT(DAY FROM CAST(us.createdAt as timestamp)) AS day_created,&#13;
    CAST(us.createdAt as timestamp) as createdAt,&#13;
    us.employeeId,&#13;
    us.activated,&#13;
    us.group,&#13;
    team,&#13;
    course.id course_id,&#13;
    course.title course_title,&#13;
    TRUNC(AVG(SAFE_CAST(lesson.score AS INT64)),2) average,&#13;
    module.id module_id,&#13;
    module.title module_title,&#13;
    module.status module_status,&#13;
    CAST(module.completionDate as timestamp) module_completion_date&#13;
FROM `peya-data-origins-pro.cl_edume.users_stats` us&#13;
INNER JOIN UNNEST(teams) as team&#13;
