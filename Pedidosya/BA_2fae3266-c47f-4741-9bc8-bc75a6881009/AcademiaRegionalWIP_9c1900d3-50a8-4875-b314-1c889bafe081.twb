            <column caption='Cursos completados seamless link' datatype='integer' name='[Calculation_2992641981441781760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CountD(iif(ISNULL([phone]) AND ISNULL([email]) AND [module_status]=&apos;complete&apos;,[id],NULL))' />
            </column>
            <column caption='Share seamless link' datatype='real' name='[Calculation_457396865061318663]' role='measure' type='quantitative'>
