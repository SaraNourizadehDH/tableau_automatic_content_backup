        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18qzinl1ju08gj133tn360ugaodc' name='Consulta SQL personalizada' type='text'>WITH dates AS ( &#13;
	SELECT &#13;
		DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH) start_date,&#13;
		DATE(CURRENT_DATE) before_date &#13;
),&#13;
partner_campaign AS (&#13;
  SELECT&#13;
    DATE(createdAt) createdAt&#13;
    ,partnerId partner_id&#13;
    ,campaignId campaign_id&#13;
    ,status&#13;
  FROM `peya-data-origins-pro.cl_core.partner_campaign`&#13;
),&#13;
menu AS (&#13;
  SELECT&#13;
    DISTINCT &#13;
    partner_id&#13;
    ,product_legacy_id&#13;
    ,product_id&#13;
    ,product_name &#13;
  FROM  `peya-bi-tools-pro.il_core.dim_partner_menu`&#13;
),&#13;
historical AS (&#13;
  SELECT&#13;
    product_id&#13;
    ,subsidized_product_campaing_id&#13;
    ,is_deleted&#13;
  FROM `peya-data-origins-pro.cl_core.subsidized_product_historical`&#13;
),&#13;
discount AS (&#13;
  SELECT&#13;
    partnerId partner_id&#13;
    ,campaignid campaign_id&#13;
    ,product_id&#13;
    ,startDateTime&#13;
    ,endDateTime&#13;
    ,originalPrice&#13;
    ,amount&#13;
    ,createdBy&#13;
    ,partnerCountryId&#13;
    ,c.name campaign_name&#13;
  FROM `peya-data-origins-pro.cl_core.partner_discount`&#13;
    ,UNNEST (itemIds) product_id&#13;
  LEFT JOIN `peya-data-origins-pro.cl_core.campaign` c&#13;
    ON c.id = campaignid&#13;
  WHERE campaignId IS NOT NULL &#13;
),&#13;
orders_product AS (&#13;
  SELECT&#13;
    DISTINCT&#13;
    o.order_id&#13;
    ,DATE(o.registered_date) registered_date&#13;
    ,d.product.product_id&#13;
    ,o.restaurant.id partner_id&#13;
    ,o.restaurant.name partner_name&#13;
  FROM `peya-bi-tools-pro.il_core.fact_orders` o&#13;
    ,UNNEST(details) d&#13;
  WHERE DATE(registered_date) BETWEEN (SELECT start_date FROM dates) AND (SELECT before_date FROM dates)&#13;
),&#13;
orders_partner AS (&#13;
  SELECT&#13;
    DISTINCT&#13;
    o.order_id&#13;
    ,DATE(o.registered_date) registered_date&#13;
    ,o.restaurant.id partner_id&#13;
    ,o.restaurant.name partner_name&#13;
    ,d.product.product_id&#13;
  FROM `peya-bi-tools-pro.il_core.fact_orders` o&#13;
    ,UNNEST(details) d&#13;
  WHERE DATE(registered_date) BETWEEN (SELECT start_date FROM dates) AND (SELECT before_date FROM dates)&#13;
),&#13;
quantities_product AS (&#13;
  SELECT&#13;
    d.product_id&#13;
    ,d.partner_id&#13;
    ,o.partner_name&#13;
    ,d.campaign_id&#13;
    ,DATE(o.registered_date) order_date&#13;
    ,COUNT(DISTINCT IF(o.registered_date BETWEEN d.startDateTime AND d.endDateTime,o.order_id,NULL)) orders_pro&#13;
  FROM orders_product o&#13;
  LEFT JOIN discount d&#13;
    ON o.product_id = d.product_id&#13;
    AND o.partner_id = d.partner_id&#13;
  WHERE d.product_id IS NOT NULL&#13;
  GROUP BY 1,2,3,4,5&#13;
),&#13;
quantities_partner AS (&#13;
  SELECT&#13;
    d.partner_id&#13;
    ,o.partner_name&#13;
    ,d.campaign_id&#13;
    ,DATE(o.registered_date) order_date&#13;
    ,COUNT(DISTINCT IF(o.registered_date BETWEEN d.startDateTime AND d.endDateTime,o.order_id,NULL)) orders_par&#13;
  FROM orders_partner o&#13;
  LEFT JOIN discount d&#13;
    ON o.partner_id = d.partner_id&#13;
    AND o.product_id = d.product_id&#13;
  WHERE d.product_id IS NOT NULL&#13;
  GROUP BY 1,2,3,4&#13;
)&#13;
&#13;
SELECT&#13;
  DISTINCT&#13;
  qpro.order_date order_pro&#13;
  ,qpar.order_date order_par&#13;
  ,pc.createdAt&#13;
  ,pc.partner_id&#13;
  ,qpro.partner_name&#13;
  ,pc.campaign_id&#13;
  ,pc.status&#13;
  ,d.product_id&#13;
  ,DATE(d.startDateTime) start_at&#13;
  ,DATE(d.endDateTime) end_at&#13;
  ,d.originalPrice&#13;
  ,d.amount&#13;
  ,d.createdBy&#13;
  ,d.partnerCountryId&#13;
  ,d.campaign_name&#13;
  ,m.product_legacy_id&#13;
  ,m.product_name &#13;
  -- ,h.is_deleted&#13;
  ,qpro.orders_pro&#13;
  ,qpar.orders_par&#13;
&#13;
FROM partner_campaign pc&#13;
LEFT JOIN menu m&#13;
  ON pc.partner_id = m.partner_id&#13;
LEFT JOIN historical h&#13;
  ON m.product_legacy_id = h.product_id&#13;
LEFT JOIN discount d&#13;
  ON h.subsidized_product_campaing_id = pc.campaign_id&#13;
  AND m.product_legacy_id =  d.product_id&#13;
  AND m.partner_id = d.partner_id&#13;
LEFT JOIN quantities_product qpro&#13;
  ON qpro.campaign_id = pc.campaign_id&#13;
  AND qpro.partner_id = pc.partner_id&#13;
  AND qpro.product_id = m.product_legacy_id&#13;
LEFT JOIN quantities_partner qpar&#13;
  ON qpar.campaign_id = pc.campaign_id&#13;
  AND qpar.partner_id = pc.partner_id&#13;
&#13;
WHERE TRUE&#13;
  AND status NOT IN (&quot;TARGETED&quot;)&#13;
  AND d.product_id IS NOT NULL&#13;
  AND UPPER(d.campaign_name) LIKE &quot;%PROMOS ÚNICAS%&quot;&#13;
&#13;
ORDER BY 4,2,1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
