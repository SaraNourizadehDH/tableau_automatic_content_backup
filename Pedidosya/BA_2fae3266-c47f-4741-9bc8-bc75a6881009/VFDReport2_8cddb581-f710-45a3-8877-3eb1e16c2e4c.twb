            <column caption='weekly_sm_partners' datatype='integer' name='[Calculation_1483654606650093568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [weekly_orders_sm] &gt; 0 then [partner_id] END)' />
