      <table>
        <view>
          <datasources>
            <datasource caption='Totals' name='federated.1tc9i8w0mgzbyn15sywrs0hsj6uk' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Sin Free Delivery' caption='Proxy' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;No Proxy&quot;'>
              <calculation class='tableau' formula='&quot;No Proxy&quot;' />
              <aliases>
                <alias key='&quot;No Proxy&quot;' value='Sin Free Delivery' />
                <alias key='&quot;Proxy&quot;' value='Con Free Delivery' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tc9i8w0mgzbyn15sywrs0hsj6uk'>
            <column caption='VFD_partners' datatype='integer' default-format='N' name='[Calculation_1280992679112642560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [paid_by] = &apos;RESTAURANT&apos; &#13;&#10;then [partner_id (vfd_report_sub_totals_2)]&#13;&#10;END)' />
            </column>
            <column caption='total_partners' datatype='integer' name='[Calculation_1280992679118061569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([partner_id (vfd_report_totals_2)])' />
            </column>
            <column caption='%SM_partners' datatype='real' default-format='p0.0%' name='[Calculation_1306606851291332611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ild_sm_partners (copia)_1306606851290234881]/[Calculation_1280992679112642560]' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_5866923733542121474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Proxy&quot; &#10;THEN [Discount Type (grupo)]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;No Proxy&quot; &#10;AND [discount_type] != &quot;FREE_DELIVERY_proxy&quot; &#10;THEN [discount_type]&#10;ELSE NULL&#10;END' />
            </column>
            <column datatype='string' name='[Discount Type (grupo)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[discount_type]' new-bin='true'>
                <bin default-name='false' value='&quot;BINS&quot;'>
                  <value>&quot;BINS_CAMPAIGN_UNKNOWN&quot;</value>
                  <value>&quot;BINS_CASHBACK&quot;</value>
                  <value>&quot;BINS_DISCOUNT&quot;</value>
                  <value>&quot;BINS_PLUS_LOYALITY&quot;</value>
                  <value>&quot;BINS_REIMBURSEMENT&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;COUPONS&quot;'>
                  <value>&quot;COORPORATIVE_COUPON&quot;</value>
                  <value>&quot;DMART_COUPON&quot;</value>
                  <value>&quot;MARKETING_CENTRAL_COUPON&quot;</value>
                  <value>&quot;MARKETING_LOCAL_COUPON&quot;</value>
                  <value>&quot;NON_MARKETING_COUPON&quot;</value>
                  <value>&quot;OTHER_TYPE_COUPON&quot;</value>
                  <value>&quot;PLUS_COUPON&quot;</value>
                  <value>&quot;SORRY_COUPON&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;FREE DELIVERY&quot;'>
                  <value>&quot;DELIVERY_FEE&quot;</value>
                  <value>&quot;DELIVERY_FEE_SERVICE&quot;</value>
                  <value>&quot;FREE_DELIVERY_proxy&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;LOCAL_STORE&quot;'>
                  <value>&quot;LOCAL_STORE_DEAL&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;MULTI-BUY (LS)&quot;'>
                  <value>&quot;PCM_DISCOUNTS_MULTI-BUY&quot;</value>
                  <value>&quot;PROMOTOOL_BXGY&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;PERCENTAGE_DISCOUNT(LS)&quot;'>
                  <value>&quot;PCM_DISCOUNTS_PERCENTAGEDISCOUNT&quot;</value>
                  <value>&quot;PROMOTOOL&quot;</value>
                  <value>&quot;PROMOTOOL_COMPOSITE&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;WALLET&quot;'>
                  <value>&quot;WALLET_BUSINESS&quot;</value>
                  <value>&quot;WALLET_COMPENSATION&quot;</value>
                  <value>&quot;WALLET_PAYMENTS_REFUND&quot;</value>
                </bin>
