      <table>
        <view>
          <datasources>
            <datasource caption='Totals' name='federated.1tc9i8w0mgzbyn15sywrs0hsj6uk' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Sin Free Delivery' caption='Proxy' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;No Proxy&quot;'>
              <calculation class='tableau' formula='&quot;No Proxy&quot;' />
              <aliases>
                <alias key='&quot;No Proxy&quot;' value='Sin Free Delivery' />
                <alias key='&quot;Proxy&quot;' value='Con Free Delivery' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tc9i8w0mgzbyn15sywrs0hsj6uk'>
            <column caption='%SM_plus_amount' datatype='real' default-format='p0.00%' name='[%SM_ild_amount (copia)_1483654606673981448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([plus_discount_amount_sm])/[Calculation_1280992679125291010]' />
            </column>
            <column caption='%SM_deal_amount' datatype='real' default-format='p0.00%' name='[%SM_plus_amount (copia)_1483654606674251785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mkt_discount_sm])/[Calculation_1280992679125291010]' />
            </column>
            <column caption='%SM_weekly_amount' datatype='real' default-format='p0.00%' name='[%SM_plus_amount (copia)_1483654606675333130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([weekly_discount_amount])/[Calculation_1280992679125291010]' />
            </column>
            <column caption='VFD_Total' datatype='real' name='[Calculation_1280992679125291010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [paid_by] = &quot;RESTAURANT&quot; &#13;&#10;THEN [total_discount_amount_eur]&#13;&#10;END)' />
            </column>
            <column caption='%SM_ild_amount' datatype='real' default-format='p0.00%' name='[Calculation_1483654606673756167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ild_discount_amount_sm])/[Calculation_1280992679125291010]' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_5866923733542121474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Proxy&quot; &#10;THEN [Discount Type (grupo)]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;No Proxy&quot; &#10;AND [discount_type] != &quot;FREE_DELIVERY_proxy&quot; &#10;THEN [discount_type]&#10;ELSE NULL&#10;END' />
            </column>
            <column datatype='string' name='[Discount Type (grupo)]' role='dimension' type='nominal'>
