          <datasource-dependencies datasource='Parameters'>
            <column alias='Sin Free Delivery' caption='Proxy' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;No Proxy&quot;'>
              <calculation class='tableau' formula='&quot;No Proxy&quot;' />
              <aliases>
                <alias key='&quot;No Proxy&quot;' value='Sin Free Delivery' />
                <alias key='&quot;Proxy&quot;' value='Con Free Delivery' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tc9i8w0mgzbyn15sywrs0hsj6uk'>
            <column caption='VFD_partners' datatype='integer' default-format='N' name='[Calculation_1280992679112642560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [paid_by] = &apos;RESTAURANT&apos; &#13;&#10;then [partner_id (vfd_report_sub_totals_2)]&#13;&#10;END)' />
            </column>
            <column caption='total_partners' datatype='integer' name='[Calculation_1280992679118061569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([partner_id (vfd_report_totals_2)])' />
