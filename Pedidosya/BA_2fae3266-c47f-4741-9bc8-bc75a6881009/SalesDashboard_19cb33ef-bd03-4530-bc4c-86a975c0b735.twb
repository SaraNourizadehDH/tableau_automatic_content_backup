              <groupfilter function='member' level='[none:Calculation_1031324379314442296:nk]' member='&quot;202105-May 21&quot;' />
              <groupfilter function='member' level='[none:Calculation_1031324379314442296:nk]' member='&quot;202106-Jun 21&quot;' />
