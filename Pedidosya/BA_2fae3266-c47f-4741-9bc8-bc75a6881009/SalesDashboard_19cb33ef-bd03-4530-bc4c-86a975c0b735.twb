      <column caption='Is Mid Seller' datatype='boolean' name='[Is Top Seller (copia)_1031324379259822127]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_1031324379255668775] * 30 &gt;= 100  AND [Calculation_1031324379255668775] * 30 &lt; 500 AND [Calculation_1031324379233226766] = TRUE) THEN TRUE END' />
