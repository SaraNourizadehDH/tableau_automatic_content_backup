    <worksheet name='Never made an Order'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#fb0050' fontsize='16'>Partners that Never Made an Order</run>
            <run fontcolor='#fb0050'>Æ </run>
            <run fontcolor='#fb0050' fontsize='12'>(Online partners that were never active)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='partners' name='federated.1gvnsvh0v5fsv911mj4ze1re6tf6' />
