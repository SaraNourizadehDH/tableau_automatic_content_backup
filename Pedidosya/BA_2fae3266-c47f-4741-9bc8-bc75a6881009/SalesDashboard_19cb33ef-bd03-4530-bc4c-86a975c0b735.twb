      <aliases enabled='yes' />
      <column caption='Time Period' datatype='date' datatype-customized='true' name='[Calculation_1031324379206025221]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parámetro 1], [date]))' />
