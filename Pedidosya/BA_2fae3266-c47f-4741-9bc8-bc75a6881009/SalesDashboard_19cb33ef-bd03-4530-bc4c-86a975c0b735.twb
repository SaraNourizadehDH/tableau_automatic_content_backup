        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1vehjs21fmm6sp1gkxg581btj22d' name='Consulta SQL personalizada' type='text'>SELECT&#13;
  record_country AS Pais,&#13;
  EXTRACT (DATE FROM LeadCreationDate) AS date,&#13;
  Name,&#13;
  grid,&#13;
  accountsource AS Tipo_de_caso,&#13;
  business_type AS Tipo_de_negocio,&#13;
  &quot;Lead Creation&quot; AS Etapa,&#13;
  1 AS CantidadCasos,&#13;
  LeadToOppHours AS Tiempo&#13;
FROM `peya-food-and-groceries.user_francisco_fasan.onboarding_time`&#13;
UNION ALL&#13;
SELECT&#13;
  record_country AS Pais,&#13;
  EXTRACT (DATE FROM LeadCreationDate) AS date,&#13;
  Name,&#13;
  grid,&#13;
  accountsource AS Tipo_de_caso,&#13;
  business_type AS Tipo_de_negocio,&#13;
  &quot;Sales Agent&quot; AS Etapa,&#13;
  CASE WHEN qccases &gt;&gt; 1 THEN (qccases - mpcases + 1)&#13;
       ELSE 1&#13;
  END AS CantidadCasos,&#13;
  CASE WHEN (qccases = 1) THEN comoverallhours&#13;
       WHEN (qccases &gt;&gt; 1 AND qcclosed &gt;&gt; mpcreated) THEN comoverallhours&#13;
       ELSE (comoverallhours + qcoverallhours - qcsumhours)&#13;
  END AS Tiempo&#13;
FROM `peya-food-and-groceries.user_francisco_fasan.onboarding_time`&#13;
UNION ALL&#13;
SELECT&#13;
  record_country AS Pais,&#13;
  EXTRACT (DATE FROM LeadCreationDate) AS date,&#13;
  Name,&#13;
  grid,&#13;
  accountsource AS Tipo_de_caso,&#13;
  business_type AS Tipo_de_negocio,&#13;
  &quot;Quality Check&quot; AS Etapa,&#13;
  qccases AS CantidadCasos,&#13;
  qcsumhours AS Tiempo&#13;
FROM `peya-food-and-groceries.user_francisco_fasan.onboarding_time`&#13;
UNION ALL&#13;
SELECT&#13;
  record_country AS Pais,&#13;
  EXTRACT (DATE FROM LeadCreationDate) AS date,&#13;
  Name,&#13;
  grid,&#13;
  accountsource AS Tipo_de_caso,&#13;
  business_type AS Tipo_de_negocio,&#13;
  &quot;Menu Processing&quot; AS Etapa,&#13;
  mpcases AS CantidadCasos,&#13;
  mpsumhours AS Tiempo&#13;
FROM `peya-food-and-groceries.user_francisco_fasan.onboarding_time`&#13;
UNION ALL&#13;
SELECT&#13;
  record_country AS Pais,&#13;
  EXTRACT (DATE FROM LeadCreationDate) AS date,&#13;
  Name,&#13;
  grid,&#13;
  accountsource AS Tipo_de_caso,&#13;
