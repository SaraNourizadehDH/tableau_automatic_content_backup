      <column caption='Total time' datatype='real' name='[Calculation_1031324379215294472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Tiempo])/[Calculation_1031324379207573510]' />
      </column>
      <column caption='teoricos_casos' datatype='integer' name='[Calculation_1031324379216990218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Name]: COUNTD(IF (NOT ISNULL([CantidadCasos])) THEN [Etapa] END)}' />
