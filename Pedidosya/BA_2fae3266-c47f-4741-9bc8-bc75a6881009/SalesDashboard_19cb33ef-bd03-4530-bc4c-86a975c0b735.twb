        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0e0r99f0meso0d0zu36rc1it2zxz' name='Consulta SQL personalizada' type='text'><![CDATA[WITH variables AS (
  SELECT 
    DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -12 MONTH) AS start_date,
    DATE_ADD(DATE_TRUNC(CURRENT_DATE, DAY), INTERVAL -1 DAY) AS end_date
),

orders as (SELECT
registered_date,
restaurant.id restaurant_id,
COUNT(DISTINCT CASE WHEN order_status = 'CONFIRMED' THEN order_id END) as confirmed_orders,
FROM `peya-bi-tools-pro.il_core.fact_orders`
WHERE registered_date >>= (SELECT start_date FROM variables)
AND registered_date  <<= (SELECT end_date FROM variables)
AND business_type.business_type_name = 'Courier Business'
GROUP BY 1,2),

orders_last_two_months AS (SELECT
restaurant_id,
SUM(confirmed_orders) as confirmed_orders_last_two_months
FROM orders
WHERE registered_date >>= DATE_ADD(DATE_TRUNC((SELECT end_date FROM variables), MONTH), INTERVAL -1 MONTH)
GROUP BY 1),

daily_active AS (SELECT
dhp.yyyymmdd,
dhp.restaurant_id,
dhp.is_active
FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dhp
WHERE yyyymmdd >>= (SELECT start_date FROM variables)
AND yyyymmdd <<= (SELECT end_date FROM variables)
AND business_name = 'Courier Business'
AND dhp.salesforce_id IS NOT NULL),

weekly_active AS (SELECT
DATE_TRUNC(dhp.yyyymmdd, WEEK(MONDAY)) week,
dhp.restaurant_id,
MAX(dhp.is_active) is_active
FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dhp
WHERE yyyymmdd >>= (SELECT start_date FROM variables)
AND yyyymmdd <<= (SELECT end_date FROM variables)
AND business_name = 'Courier Business'
AND dhp.salesforce_id IS NOT NULL
GROUP BY 1,2),

monthly_active AS (SELECT
DATE_TRUNC(dhp.yyyymmdd, MONTH) month,
dhp.restaurant_id,
MAX(dhp.is_active) is_active
FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dhp
WHERE yyyymmdd >>= (SELECT start_date FROM variables)
AND yyyymmdd <<= (SELECT end_date FROM variables)
AND business_name = 'Courier Business'
AND dhp.salesforce_id IS NOT NULL
GROUP BY 1,2),

courier_origins AS (SELECT 
DATE_TRUNC(registered_date, MONTH) as month,
partner.id partner_id,
partner.name,
application_sub_origin,
COUNT(DISTINCT courier_order_id) AS orders
FROM `peya-bi-tools-pro.il_core.fact_orders_courier` 
WHERE registered_date >>= (SELECT start_date FROM variables) AND registered_date <<= (SELECT end_date FROM variables)
AND partner.businessType = 'COURIER_BUSINESS'
GROUP BY 1,2,3,4),

integration_type AS (SELECT
co.month,
co.partner_id,
co.name,
MAX(co.application_sub_origin) integration_type
FROM courier_origins co
LEFT JOIN (SELECT
            month,
            partner_id,
            MAX(orders) as orders
           FROM courier_origins
           GROUP BY 1,2) aux ON aux.month = co.month AND aux.partner_id = co.partner_id 
WHERE aux.orders = co.orders
GROUP BY 1,2,3
ORDER BY 2,1 DESC)

(SELECT 
dhp.yyyymmdd,
dhp.restaurant_id,
dp.partner_name As restaurant_name,
dhp.country_name,
dhp.registered_date,
dhp.account_owner,
su.Name,
it.integration_type,
ord.confirmed_orders,
dhp.is_online,
dhp.is_new_online,
dp.is_online as is_now_online,
dhp.is_active,
da.is_active as prev_d_active,
wa.is_active as prev_w_active,
ma.is_active as prev_m_active,
o2m.confirmed_orders_last_two_months,
"SalesForce" AS adquisition_channel
FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dhp
LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.GRID = dhp.salesforce_id
LEFT JOIN (select *
            from `peya-data-origins-pro.cl_salesforce.opportunity` o
            where o.business_type IN ('New Business','Win Back')
            and o.stagename='Closed Won'
           ) o ON o.AccountId = a.Id
LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` su ON o.OwnerId = su.Id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp ON dhp.restaurant_id = dp.partner_id 
LEFT JOIN daily_active da ON da.restaurant_id = dhp.restaurant_id AND da.yyyymmdd = DATE_ADD(dhp.yyyymmdd,INTERVAL -1 DAY)
LEFT JOIN weekly_active wa ON wa.restaurant_id = dhp.restaurant_id AND wa.week = DATE_ADD(DATE_TRUNC(dhp.yyyymmdd, WEEK(MONDAY)), INTERVAL -1 WEEK)
LEFT JOIN monthly_active ma ON ma.restaurant_id = dhp.restaurant_id AND ma.month = DATE_ADD(DATE_TRUNC(dhp.yyyymmdd, MONTH), INTERVAL -1 MONTH)
LEFT JOIN orders ord ON ord.registered_date = dhp.yyyymmdd AND ord.restaurant_id = dhp.restaurant_id 
LEFT JOIN integration_type it ON it.month = DATE_TRUNC(dhp.yyyymmdd, MONTH) AND it.partner_id = dhp.restaurant_id 
LEFT JOIN orders_last_two_months o2m ON o2m.restaurant_id = dhp.restaurant_id 
WHERE dhp.yyyymmdd >>= (SELECT start_date FROM variables)
AND dhp.yyyymmdd <<= (SELECT end_date FROM variables)
AND dhp.business_name = 'Courier Business'
AND dhp.salesforce_id IS NOT NULL)
UNION ALL
(SELECT 
dhp.yyyymmdd,
dhp.restaurant_id,
dp.partner_name As restaurant_name,
dhp.country_name,
dhp.registered_date,
dhp.account_owner,
su.Name,
it.integration_type,
ord.confirmed_orders,
dhp.is_online,
dhp.is_new_online,
dp.is_online as is_now_online,
dhp.is_active,
da.is_active as prev_d_active,
wa.is_active as prev_w_active,
ma.is_active as prev_m_active,
o2m.confirmed_orders_last_two_months,
"Self Onboarding" AS adquisition_channel
FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dhp
LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.GRID = dhp.salesforce_id
LEFT JOIN (select *
            from `peya-data-origins-pro.cl_salesforce.opportunity` o
            where o.business_type IN ('New Business','Win Back')
            and o.stagename='Closed Won'
           ) o ON o.AccountId = a.Id
LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` su ON o.OwnerId = su.Id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp ON dhp.restaurant_id = dp.partner_id 
LEFT JOIN daily_active da ON da.restaurant_id = dhp.restaurant_id AND da.yyyymmdd = DATE_ADD(dhp.yyyymmdd,INTERVAL -1 DAY)
LEFT JOIN weekly_active wa ON wa.restaurant_id = dhp.restaurant_id AND wa.week = DATE_ADD(DATE_TRUNC(dhp.yyyymmdd, WEEK(MONDAY)), INTERVAL -1 WEEK)
LEFT JOIN monthly_active ma ON ma.restaurant_id = dhp.restaurant_id AND ma.month = DATE_ADD(DATE_TRUNC(dhp.yyyymmdd, MONTH), INTERVAL -1 MONTH)
LEFT JOIN orders ord ON ord.registered_date = dhp.yyyymmdd AND ord.restaurant_id = dhp.restaurant_id 
LEFT JOIN integration_type it ON it.month = DATE_TRUNC(dhp.yyyymmdd, MONTH) AND it.partner_id = dhp.restaurant_id 
LEFT JOIN orders_last_two_months o2m ON o2m.restaurant_id = dhp.restaurant_id 
WHERE dhp.yyyymmdd >>= (SELECT start_date FROM variables)
AND dhp.yyyymmdd <<= (SELECT end_date FROM variables)
AND dhp.business_name = 'Courier Business'
AND dhp.salesforce_id IS NULL
AND dhp.registered_date >>= '2021-12-02')]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
