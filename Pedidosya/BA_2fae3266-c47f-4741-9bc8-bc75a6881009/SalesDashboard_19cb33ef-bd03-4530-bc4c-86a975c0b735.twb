      <column caption='Active Partners (prev)' datatype='integer' name='[Active Partners (copia)_1031324379250081828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF([Calculation_1031324379248316447] = TRUE) THEN [restaurant_id] END)' />
      </column>
      <column caption='Is Active' datatype='boolean' name='[Calculation_1031324379233226766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [restaurant_id],[Calculation_1031324379233689617]: MAX([is_active])}' />
      </column>
      <column caption='Is Online' datatype='boolean' name='[Calculation_1031324379233333263]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [restaurant_id], [Calculation_1031324379233689617]: MAX([is_online])}' />
      </column>
      <column caption='Online Partners' datatype='integer' name='[Calculation_1031324379233390608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF([Calculation_1031324379233333263] = TRUE) THEN [restaurant_id] END)' />
      </column>
      <column caption='Time Period' datatype='date' datatype-customized='true' name='[Calculation_1031324379233689617]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parámetro 1], [yyyymmdd]))' />
      </column>
      <column caption='Active Partners' datatype='integer' name='[Calculation_1031324379234222098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF([Calculation_1031324379233226766] = TRUE) THEN [restaurant_id] END)' />
      </column>
      <column caption='New Online Partners' datatype='integer' name='[Calculation_1031324379235672085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF([Is Online (copia)_1031324379235541012]=TRUE) THEN [restaurant_id] END)' />
      </column>
      <column caption='No Orders Partners' datatype='integer' name='[Calculation_1031324379235971094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([Calculation_1031324379233226766] != TRUE AND [Calculation_1031324379233333263] = TRUE) THEN [restaurant_id] END)' />
      </column>
      <column caption='Is Active (prev)' datatype='boolean' name='[Calculation_1031324379248316447]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;day&apos;) THEN [prev_d_active]&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;week&apos;) THEN [prev_w_active]&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN [prev_m_active] END' />
      </column>
      <column caption='Is Churner' datatype='boolean' name='[Calculation_1031324379248635936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_1031324379233226766] = TRUE AND [Calculation_1031324379248316447] != TRUE) THEN TRUE END' />
      </column>
      <column caption='Churn Partners' datatype='integer' name='[Calculation_1031324379248799777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([Calculation_1031324379248635936]) THEN [restaurant_id] END)' />
      </column>
      <column caption='% of No Orders Partners' datatype='real' name='[Calculation_1031324379249680419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1031324379235971094]/[Calculation_1031324379233390608]' />
      </column>
      <column caption='% Churners' datatype='real' name='[Calculation_1031324379250151461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1031324379248799777]/[Active Partners (copia)_1031324379250081828]' />
      </column>
      <column caption='Account Manager' datatype='string' name='[Calculation_1031324379251281958]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Name], [account_owner])' />
      </column>
      <column caption='Avg. Daily Orders' datatype='real' name='[Calculation_1031324379255668775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [restaurant_id], [Calculation_1031324379233689617]: AVG([Calculation_1031324379256709160])}' />
      </column>
      <column caption='Daily Orders' datatype='integer' name='[Calculation_1031324379256709160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (ISNULL([confirmed_orders])) THEN 0 ELSE [confirmed_orders] END' />
      </column>
      <column caption='Empty' datatype='integer' name='[Calculation_1031324379260805174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Registered Date' datatype='string' name='[Calculation_1031324379314442296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR({ FIXED [restaurant_id]: MIN([registered_date])})) + RIGHT(&apos;0&apos; + STR(MONTH({ FIXED [restaurant_id]: MIN([registered_date])})),2) + &apos;-&apos; + LEFT(DATENAME(&apos;month&apos;,{ FIXED [restaurant_id]: MIN([registered_date])}),3) + &apos; &apos; + STR(YEAR({ FIXED [restaurant_id]: MIN([registered_date])})-2000)' />
      </column>
      <column caption='Avg Orders per Active Partner' datatype='real' name='[Calculation_1031324379318837305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders])/[Calculation_1031324379234222098]' />
      </column>
      <column caption='% Active Partners' datatype='real' name='[Calculation_1031324379340505146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1031324379234222098]/[Calculation_1031324379233390608]' />
      </column>
      <column caption='Total Partners' datatype='integer' name='[Calculation_1031324379340890171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([restaurant_id])' />
      </column>
      <column caption='Tipo Partner' datatype='string' name='[Calculation_1031324379342360636]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Is KA (copia)_1031324379259265068]) THEN &apos;Top Seller&apos;&#13;&#10;ELSEIF ([Is Top Seller (copia)_1031324379259822127]) THEN &apos;Mid Seller&apos;&#13;&#10;ELSEIF ([Is Top Seller (copia)_1031324379260198962]) THEN &apos;Small Seller&apos;&#13;&#10;ELSEIF ([Is Tiny Seller (copia)_1440026025208365056]) THEN &apos;Tiny Seller&apos; END' />
      </column>
      <column caption='Confirmed Orders (overall)' datatype='integer' name='[Calculation_1031324379490730045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([KAs  - Orders (copia)_1031324379259531310],0) + IFNULL([Top Sellers  - Orders (copia)_1031324379259969585],0) + IFNULL([Top Sellers  - Orders (copia)_1031324379260366900],0)' />
      </column>
      <column caption='Dif' datatype='integer' name='[Calculation_1031324379494187071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders]) - [Calculation_1031324379490730045]' />
      </column>
      <column caption='Active Comercial Headcount' datatype='integer' name='[Calculation_2133580323589484546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF([Is Online (copia)_1031324379235541012]) THEN [Calculation_1031324379251281958] END)' />
      </column>
      <column caption='Comercial Productivity' datatype='real' name='[Calculation_2133580323590692867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1031324379235672085]/[Calculation_2133580323589484546]' />
      </column>
      <column caption='is Last Month' datatype='boolean' name='[Calculation_2133580323591995397]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, NOW()) = DATETRUNC(&apos;month&apos;,[yyyymmdd])' />
      </column>
      <column caption='Never made order' datatype='boolean' name='[Calculation_2133580323856257031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [restaurant_id]: MAX([is_active])} = FALSE' />
      </column>
      <column caption='Is Zombie' datatype='boolean' name='[Calculation_2133580323878182925]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [restaurant_id]: MAX([confirmed_orders_last_two_months])} = 0' />
      </column>
      <column caption='Registered Date.' datatype='string' name='[Calculation_2133580323880050704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;day&apos;, [registered_date])))' />
      </column>
      <column caption='Confirmed Orders' datatype='integer' name='[Calculation_2133580323882553361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([confirmed_orders])' />
      </column>
      <column caption='Periods' datatype='integer' name='[Calculation_2133580388346929152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,DATETRUNC(&apos;month&apos;, [registered_date]), DATETRUNC(&apos;month&apos;, [yyyymmdd]))' />
      </column>
      <column caption='Integration Type' datatype='string' name='[Calculation_2133580388413779969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(CONTAINS([restaurant_name], &apos;Tiendanube&apos;) OR CONTAINS([restaurant_name], &apos;TiendaNube&apos;) OR CONTAINS([restaurant_name], &apos;Tienda Nube&apos;)) THEN &apos;Tiendanube&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;Woo&apos;) OR CONTAINS([restaurant_name], &apos;WooCommerce&apos;) OR CONTAINS([restaurant_name], &apos;Woocommerce&apos;)) THEN &apos;WooCommerce&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;VTex&apos;) OR CONTAINS([restaurant_name], &apos;Vtex&apos;)) THEN &apos;VTex&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;Mercat&apos;)) THEN &apos;Mercat&apos;&#13;&#10;ELSEIF (CONTAINS([restaurant_name], &apos;Bootic&apos;)) THEN &apos;Bootic&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;Fenicio&apos;)) THEN &apos;Fenicio&apos;&#13;&#10;ELSE &apos;Plataforma Web&apos; END' />
      </column>
      <column caption='Empty (copia)' datatype='integer' name='[Empty (copia)_1031324379260899383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Is Top Seller' datatype='boolean' name='[Is KA (copia)_1031324379259265068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_1031324379255668775] * 30 &gt;= 500) THEN TRUE END' />
      </column>
      <column caption='Is New Online' datatype='boolean' name='[Is Online (copia)_1031324379235541012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [restaurant_id], [Calculation_1031324379233689617]: MAX([is_new_online])}' />
      </column>
      <column caption='Is Tiny Seller' datatype='boolean' name='[Is Tiny Seller (copia)_1440026025208365056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_1031324379255668775] * 30 &lt; 50 AND [Calculation_1031324379233226766] = TRUE) THEN TRUE END' />
