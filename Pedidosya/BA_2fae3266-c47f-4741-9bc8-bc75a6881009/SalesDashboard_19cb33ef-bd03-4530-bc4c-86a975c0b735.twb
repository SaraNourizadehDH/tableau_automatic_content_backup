    <worksheet name='Cohort - Avg Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#fb0050' fontsize='16'>Cohorts - Avg Confirmed Orders per Active Partner</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='partners' name='federated.1gvnsvh0v5fsv911mj4ze1re6tf6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;year&quot;' value='Yearly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gvnsvh0v5fsv911mj4ze1re6tf6'>
            <column caption='Is Active' datatype='boolean' name='[Calculation_1031324379233226766]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [restaurant_id],[Calculation_1031324379233689617]: MAX([is_active])}' />
            </column>
            <column caption='Time Period' datatype='date' datatype-customized='true' name='[Calculation_1031324379233689617]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parámetro 1], [yyyymmdd]))' />
            </column>
            <column caption='Active Partners' datatype='integer' name='[Calculation_1031324379234222098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF([Calculation_1031324379233226766] = TRUE) THEN [restaurant_id] END)' />
            </column>
            <column caption='Account Manager' datatype='string' name='[Calculation_1031324379251281958]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Name], [account_owner])' />
            </column>
            <column caption='Registered Date' datatype='string' name='[Calculation_1031324379314442296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR({ FIXED [restaurant_id]: MIN([registered_date])})) + RIGHT(&apos;0&apos; + STR(MONTH({ FIXED [restaurant_id]: MIN([registered_date])})),2) + &apos;-&apos; + LEFT(DATENAME(&apos;month&apos;,{ FIXED [restaurant_id]: MIN([registered_date])}),3) + &apos; &apos; + STR(YEAR({ FIXED [restaurant_id]: MIN([registered_date])})-2000)' />
            </column>
            <column caption='Avg Orders per Active Partner' datatype='real' name='[Calculation_1031324379318837305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])/[Calculation_1031324379234222098]' />
            </column>
            <column caption='is Last Month' datatype='boolean' name='[Calculation_2133580323591995397]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, NOW()) = DATETRUNC(&apos;month&apos;,[yyyymmdd])' />
            </column>
            <column caption='Periods' datatype='integer' name='[Calculation_2133580388346929152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,DATETRUNC(&apos;month&apos;, [registered_date]), DATETRUNC(&apos;month&apos;, [yyyymmdd]))' />
            </column>
            <column caption='Integration Type' datatype='string' name='[Calculation_2133580388413779969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(CONTAINS([restaurant_name], &apos;Tiendanube&apos;) OR CONTAINS([restaurant_name], &apos;TiendaNube&apos;) OR CONTAINS([restaurant_name], &apos;Tienda Nube&apos;)) THEN &apos;Tiendanube&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;Woo&apos;) OR CONTAINS([restaurant_name], &apos;WooCommerce&apos;) OR CONTAINS([restaurant_name], &apos;Woocommerce&apos;)) THEN &apos;WooCommerce&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;VTex&apos;) OR CONTAINS([restaurant_name], &apos;Vtex&apos;)) THEN &apos;VTex&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;Mercat&apos;)) THEN &apos;Mercat&apos;&#13;&#10;ELSEIF (CONTAINS([restaurant_name], &apos;Bootic&apos;)) THEN &apos;Bootic&apos;&#13;&#10;ELSEIF(CONTAINS([restaurant_name], &apos;Fenicio&apos;)) THEN &apos;Fenicio&apos;&#13;&#10;ELSE &apos;Plataforma Web&apos; END' />
            </column>
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column caption='Acquisition Channel' datatype='string' name='[adquisition_channel]' role='dimension' type='nominal' />
            <column datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[is_active]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1031324379251281958]' derivation='None' name='[none:Calculation_1031324379251281958:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1031324379314442296]' derivation='None' name='[none:Calculation_1031324379314442296:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2133580323591995397]' derivation='None' name='[none:Calculation_2133580323591995397:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2133580388346929152]' derivation='None' name='[none:Calculation_2133580388346929152:qk]' pivot='key' type='quantitative' />
