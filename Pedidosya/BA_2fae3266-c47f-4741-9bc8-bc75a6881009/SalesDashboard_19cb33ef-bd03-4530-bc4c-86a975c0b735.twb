            <column caption='Date' datatype='date' name='[yyyymmdd]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1gvnsvh0v5fsv911mj4ze1re6tf6].[none:Calculation_1031324379314442296:nk]' filter-group='4'>
