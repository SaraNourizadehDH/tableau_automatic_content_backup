  <worksheets>
    <worksheet name='Hoja 1 (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#fa0050' fontsize='11'>Paso 3</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>: Vea las recomendaciones</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DIARIA' name='federated.0ik2mnx1gdnmmi187pn2p1ss2dg6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Peso CVR3' datatype='integer' name='[Parámetro 1]' param-domain-type='range' role='measure' type='quantitative' value='20'>
              <calculation class='tableau' formula='20' />
              <range granularity='5' max='85' min='5' />
            </column>
            <column caption='Peso órdenes' datatype='integer' name='[Parámetro 2]' param-domain-type='range' role='measure' type='quantitative' value='25'>
              <calculation class='tableau' formula='25' />
              <range granularity='5' max='85' min='5' />
            </column>
            <column caption='Peso GMV' datatype='integer' name='[Parámetro 3]' param-domain-type='range' role='measure' type='quantitative' value='15'>
              <calculation class='tableau' formula='15' />
              <range granularity='5' max='85' min='5' />
            </column>
            <column caption='Peso comisión' datatype='integer' name='[Parámetro 4]' param-domain-type='range' role='measure' type='quantitative' value='15'>
              <calculation class='tableau' formula='15' />
              <range granularity='5' max='85' min='5' />
            </column>
            <column caption='Btm_Pct' datatype='real' default-format='p0.00%' name='[Parámetro 5]' param-domain-type='range' role='measure' type='quantitative' value='0.25'>
              <calculation class='tableau' formula='0.25' />
              <range granularity='0.05' max='0.25' min='0.0' />
            </column>
            <column caption='Top_Pct' datatype='real' default-format='p0.00%' name='[Parámetro 6]' param-domain-type='range' role='measure' type='quantitative' value='0.75'>
              <calculation class='tableau' formula='0.75' />
              <range granularity='0.05' max='1.0' min='0.75' />
            </column>
            <column caption='Peso visitas' datatype='integer' name='[Peso comisión (copia)_479351895890575360]' param-domain-type='range' role='measure' type='quantitative' value='25'>
              <calculation class='tableau' formula='25' />
              <range granularity='5' max='85' min='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ik2mnx1gdnmmi187pn2p1ss2dg6'>
            <column caption='Elim_outliers' datatype='real' name='[Calculation_1194298376412495875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [var_visits] &gt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_visits],[Parameters].[Parámetro 5])}&#13;&#10;AND&#13;&#10;[var_visits] &lt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_visits],[Parameters].[Parámetro 6])}&#13;&#10;THEN [var_visits]&#13;&#10;END' />
            </column>
            <column caption='Descuento' datatype='string' name='[Calculation_1419759783745474574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [has_subsidized] THEN &quot;Campaña&quot;&#13;&#10;ELSEIF  [has_weekly] THEN &quot;Menú completo&quot;&#13;&#10;ELSE NULL END' />
            </column>
            <column aggregation='Sum' caption='Porcentaje' datatype='real' name='[Calculation_1419759783746117647]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([subsidized_pct],[weekly_pct])' />
            </column>
            <column caption='Descuento (%)' datatype='string' name='[Calculation_1419759783911518225]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([Calculation_1419759783745474574]) + &quot; (&quot;+ STR([Calculation_1419759783746117647])+&quot;%)&quot;' />
            </column>
            <column caption='Score' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1419759783945777172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF AVG([var_CVR3])&lt;0 OR AVG([var_GMV])&lt;0 OR AVG([var_orders])&lt;0 THEN 0&#13;&#10;ELSE  (AVG([var_CVR3])*[Parameters].[Parámetro 4] + &#13;&#10;        AVG([var_GMV])*[Parameters].[Parámetro 3]+ &#13;&#10;        AVG([var_commission_amount])*[Parameters].[Parámetro 4] +  &#13;&#10;        AVG([var_orders])*[Parameters].[Parámetro 2] +&#13;&#10;        AVG([var_visits])*[Parameters].[Peso comisión (copia)_479351895890575360])&#13;&#10;/([Parameters].[Parámetro 4]+[Parameters].[Parámetro 1]+[Parameters].[Parámetro 3]+[Parameters].[Parámetro 2]+[Parameters].[Peso comisión (copia)_479351895890575360])*100&#13;&#10;END' />
            </column>
            <column caption='Día de la semana' datatype='integer' name='[Calculation_1419759849834889220]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;,[day])' />
              <aliases>
                <alias key='1' value='Domingo' />
                <alias key='2' value='Lunes' />
                <alias key='3' value='Martes' />
                <alias key='4' value='Miércoles' />
                <alias key='5' value='Jueves' />
                <alias key='6' value='Viernes' />
                <alias key='7' value='Sábado' />
              </aliases>
            </column>
            <column caption='Outliers_ordenes' datatype='real' name='[Calculation_2605825016245837824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [var_orders] &gt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_orders],[Parameters].[Parámetro 5])}&#10;AND&#10;[var_orders] &lt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_orders],[Parameters].[Parámetro 6])}&#10;THEN [var_orders]&#10;END' />
            </column>
            <column caption='Ranking de Descuento' datatype='integer' name='[Cálculo2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK([Calculation_1419759783945777172])'>
                <table-calc ordering-type='ColumnInPane' />
              </calculation>
            </column>
            <column datatype='string' name='[Key_Account_Sub_Category]' role='dimension' type='nominal' />
            <column-instance column='[var_CVR3]' derivation='Avg' name='[avg:var_CVR3:qk]' pivot='key' type='quantitative' />
            <column-instance column='[var_GMV]' derivation='Avg' name='[avg:var_GMV:qk]' pivot='key' type='quantitative' />
            <column-instance column='[var_commission_amount]' derivation='Avg' name='[avg:var_commission_amount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[var_orders]' derivation='Avg' name='[avg:var_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[var_visits]' derivation='Avg' name='[avg:var_visits:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[city (Consulta SQL personalizada)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country (Consulta SQL personalizada)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[partner_id]' derivation='CountD' name='[ctd:partner_id:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[day]' role='dimension' type='ordinal' />
