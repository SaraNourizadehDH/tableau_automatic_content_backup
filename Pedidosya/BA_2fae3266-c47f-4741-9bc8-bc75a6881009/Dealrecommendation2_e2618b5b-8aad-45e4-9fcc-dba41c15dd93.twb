            <column-instance column='[Calculation_1194298376412495875]' derivation='None' name='[none:Calculation_1194298376412495875:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1419759783745474574]' derivation='None' name='[none:Calculation_1419759783745474574:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1419759783911518225]' derivation='None' name='[none:Calculation_1419759783911518225:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1419759849834889220]' derivation='None' name='[none:Calculation_1419759849834889220:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2605825016245837824]' derivation='None' name='[none:Calculation_2605825016245837824:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Key_Account_Sub_Category]' derivation='None' name='[none:Key_Account_Sub_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[city (Consulta SQL personalizada)]' derivation='None' name='[none:city (Consulta SQL personalizada):nk]' pivot='key' type='nominal' />
            <column-instance column='[country (Consulta SQL personalizada)]' derivation='None' name='[none:country (Consulta SQL personalizada):nk]' pivot='key' type='nominal' />
            <column-instance column='[main_couisine (Consulta SQL personalizada)]' derivation='None' name='[none:main_couisine (Consulta SQL personalizada):nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[partner_id]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1419759783945777172]' derivation='User' name='[rank:usr:Calculation_1419759783945777172:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='ColumnInPane' rank-options='Competition,Descending' type='Rank' />
            </column-instance>
            <column aggregation='Sum' datatype='real' name='[subsidized_pct]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1419759783945777172]' derivation='User' name='[usr:Calculation_1419759783945777172:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Cálculo2]' derivation='User' name='[usr:Cálculo2:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='ColumnInPane' />
            </column-instance>
            <column datatype='real' default-format='p0.0%' name='[var_CVR3]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.0%' name='[var_GMV]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.0%' name='[var_commission_amount]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.0%' name='[var_orders]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.0%' name='[var_visits]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='real' name='[weekly_pct]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ik2mnx1gdnmmi187pn2p1ss2dg6].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0ik2mnx1gdnmmi187pn2p1ss2dg6].[usr:Cálculo2:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0ik2mnx1gdnmmi187pn2p1ss2dg6].[avg:var_visits:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0ik2mnx1gdnmmi187pn2p1ss2dg6].[avg:var_CVR3:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0ik2mnx1gdnmmi187pn2p1ss2dg6].[avg:var_orders:qk]&quot;' />
