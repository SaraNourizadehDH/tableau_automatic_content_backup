          <named-connection caption='BigQuery' name='bigquery.0kkzcgw1jmpjo319jpfq30fhao4z'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_erik_otero' server='' server-oauth='' username='fernando.martinez@pedidosya.com' workgroup-auth-mode='prompt' />
