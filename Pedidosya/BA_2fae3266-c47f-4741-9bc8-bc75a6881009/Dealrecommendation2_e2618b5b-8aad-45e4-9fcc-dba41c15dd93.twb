              <relation name='_3CFC95583F6049638ACABEABEFCC3E1F' table='[Extract].[_3CFC95583F6049638ACABEABEFCC3E1F]' type='table' />
            </properties>
          </object>
          <object caption='Partners' id='_DF0876008EAF48B887EB1C964DD110F0'>
            <properties context=''>
              <relation connection='bigquery.0kkzcgw1jmpjo319jpfq30fhao4z' name='Consulta SQL personalizada1' type='text'>SELECT&#13;
    # Son 11 variables sin contar partner_id &#13;
        partner_id&#13;
        ,partner_name&#13;
        ,business_type.business_type_name business_type&#13;
