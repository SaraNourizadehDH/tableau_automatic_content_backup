      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Diaria' id='_3CFC95583F6049638ACABEABEFCC3E1F'>
            <properties context=''>
              <relation connection='bigquery.0kkzcgw1jmpjo319jpfq30fhao4z' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dates AS ( 
	SELECT 
		DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH),MONTH) start_date,
		DATE(CURRENT_DATE) before_date 
),
horizon AS (
    SELECT 
        day
        ,EXTRACT(DAYOFWEEK FROM day) weekday
    FROM UNNEST(GENERATE_DATE_ARRAY((SELECT start_date FROM dates), CURRENT_DATE(), INTERVAL 1 DAY)) day
),
partners as (
    SELECT
    # Son 11 variables sin contar partner_id 
        partner_id
        ,partner_name
        ,business_type.business_type_name business_type
        ,country.country_name	        country
        ,city.name	                    city
        ,businessCategory.name	        categoryName
        ,is_concept
        ,is_kitchen
        ,is_darkstore
        ,is_important_account
        ,main_cousine_category_name     main_couisine
        ,first_date_online
    FROM `peya-bi-tools-pro.il_core.dim_partner`
    WHERE is_online
        AND first_date_online << DATE_ADD((SELECT start_date FROM dates), INTERVAL -1 MONTH)
),
orders AS (
    SELECT 
        o.order_id
        ,registered_at
        ,restaurant.id                                                                                           partner_id
        ,amount_no_discount/ce.rate_eu                                                                           food_value
        ,(o.total_amount + o.shipping_amount + o.discount_paid_by_company)/ce.rate_eu                            GMV_Gross
        ,commission_confirmed/ce.rate_eu                                                                         commission_amount
        ,o.discount_amount/ce.rate_eu                                                                            discount_amount
        ,o.discount_paid_by_partner/ce.rate_eu                                                                   discount_partner
        ,MAX(IF(d.discount_type_name IN ("WEEKLY"), d.original_value, NULL))                                     pct_weekly
        ,IF(d.discount_type_name IN ("WEEKLY"), d.discount_amount/ce.rate_eu, NULL)                              weekly
        ,IF(d.discount_type_name IN ("SUBSIDIZED"), d.discount_paid_by_partner/ce.rate_eu, NULL)                   subsidized_partner
        ,IF(d.discount_type_name NOT IN ("SUBSIDIZED","WEEKLY"), d.discount_paid_by_partner/ce.rate_eu, NULL)   others_partner
        ,o.discount_paid_by_company/ce.rate_eu                                                                      discount_peya                    
        ,IF(d.discount_type_name IN ("SUBSIDIZED"), d.discount_paid_by_company/ce.rate_eu, NULL)                 subsidized_peya
        ,IF(ds.is_subsidized, SAFE_DIVIDE(d.discount_paid_by_partner+d.discount_paid_by_company,ds.total), NULL) pct_subsidized
        ,IF(d.discount_type_name NOT IN ("SUBSIDIZED","WEEKLY"), d.discount_paid_by_company/ce.rate_eu, NULL)   others_peya   
    FROM `peya-bi-tools-pro.il_core.fact_orders` o
        ,UNNEST(discounts)  d
        ,UNNEST(details)    ds
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce 
        ON ce.currency_id = o.restaurant.country.currency.id
        AND ce.currency_exchange_date = DATE_TRUNC(DATE(o.registered_at),MONTH)
    WHERE o.order_status = "CONFIRMED"
        AND DATE(registered_date) BETWEEN (SELECT start_date FROM dates) AND (SELECT before_date FROM dates)
        AND is_test IS FALSE
        AND SAFE_DIVIDE(o.discount_amount,(o.total_amount + o.shipping_amount + o.discount_paid_by_company)) << 0.05 
    GROUP BY 1,2,3,4,5,6,7,8,10,11,12,13,14,15,16
    ORDER BY o.order_id
),
fail_rate as (
    SELECT 
        o.registered_date   date_id
        ,o.restaurant.id    partner_id
        ,COUNT(DISTINCT CASE WHEN o.order_status NOT IN ('CONFIRMED') AND o.fail_rate_owner IN ('Restaurant') THEN o.order_id END) non_confirmed_orders_restaurant_owner
        ,COUNT(DISTINCT o.order_id)     total_orders_all_status
    FROM `peya-bi-tools-pro.il_core.fact_orders` o
    WHERE DATE(registered_date) BETWEEN (SELECT start_date FROM dates) AND (SELECT before_date FROM dates)
    GROUP BY 1,2
),
historical_partners AS (
    SELECT 
        DATE(full_date)     date_id
        ,restaurant_id      partner_id
        ,commission
        ,avg_rating
        ,has_discount       has_weekly
        ,is_online
        ,TRUNC(SAFE_DIVIDE(SUM(IFNULL(schedule_open_time,0) - IFNULL(closed_times,0)), SUM(schedule_open_time)),2) as open_time,
    FROM `peya-bi-tools-pro.il_core.dim_historical_partners`
    WHERE DATE(full_date) BETWEEN (SELECT start_date FROM dates) AND (SELECT before_date FROM dates)
    GROUP BY 1,2,3,4,5,6
),
sessions as (
    SELECT 
        # CVR3 by Partner = Sessions With Transaction Visited Shop Details by Partner/ Sessions Visited Shop Details by Partner
        DATE(date) date_id
        ,shop_id partner_id
        ,sum(case when funnel_shop_details = 1 then funnel_shop_transaction else 0 end) transactions
        ,sum( funnel_shop_details)  shop_details
    FROM `peya-data-origins-pro.cl_sessions.restaurant_funnel_coca_raw_data`
    WHERE DATE(date) BETWEEN (SELECT start_date FROM dates) AND (SELECT before_date FROM dates)
    GROUP BY 1,2
    ORDER BY 1,2
),
daily as (
SELECT 
    h.day
    ,h.weekday
    ,p.partner_id
    ,hp.is_online
    ,CASE WHEN SUM(o.subsidized_partner+o.subsidized_peya)>>0 THEN TRUE
        ELSE FALSE
        END has_subsidized
    ,CASE WHEN SUM(o.weekly)>>0 THEN TRUE
        ELSE FALSE
        END has_weekly
    ,CASE WHEN SUM(o.subsidized_partner+o.subsidized_peya)>>0 AND SUM(o.subsidized_partner+o.subsidized_peya)>>SUM(o.weekly) THEN "SUBSIDIZED"
        WHEN SUM(o.weekly)>>0 AND SUM(o.weekly)>>=SUM(o.subsidized_partner+o.subsidized_peya) THEN "WEEKLY"
        ELSE NULL
        END discount_type
    ,AVG(hp.commission) pct_commission
    ,AVG(hp.avg_rating) rating
    ,AVG(hp.open_time)  open_time
    ,SUM(s.transactions) transactions
    ,SUM(s.shop_details) shop_details
    ,CASE 
        WHEN SUM(o.weekly)>>0 OR SUM(o.subsidized_partner+o.subsidized_peya)>>0 THEN TRUE
        ELSE FALSE
        END has_discount
    ,AVG(o.pct_weekly)                            weekly_discount
    ,SAFE_DIVIDE(SUM(s.transactions),SUM(s.shop_details))    CVR3
    ,SUM(s.transactions) transactions_daily
    ,SUM(o.discount_amount)                           total_discount
    ,SUM(o.discount_partner)                       total_discount_partner
    ,SUM(o.discount_peya)                         total_discount_peya
    ,SUM(o.weekly)                             total_weekly
    ,SUM(o.subsidized_partner)                     total_subsidized_partner
    ,SUM(o.subsidized_peya)                        total_subsidized_peya
    ,SUM(o.commission_amount)                      commission_amount
    ,SUM(o.GMV_Gross)                              GMV
    ,SUM(o.food_value)                             GFV
    ,CASE WHEN SUM(o.subsidized_partner+o.subsidized_peya)>>0 THEN AVG(o.pct_subsidized)*100 END pct_subsidized
    ,COUNT(DISTINCT o.order_id)                             orders
    ,ROUND(SUM(1.0*IFNULL(fr.non_confirmed_orders_restaurant_owner,0)) / SUM(fr.total_orders_all_status),2) fail_rate
    ,SUM(1.0*IFNULL(fr.non_confirmed_orders_restaurant_owner,0)) fr_nominador
    ,SUM(fr.total_orders_all_status) fr_denominador
    ,SAFE_DIVIDE(SUM(o.discount_partner),SUM(o.GMV_Gross)) pct_VFD_GMV
FROM horizon h
CROSS JOIN partners p
LEFT JOIN orders o
    ON h.day = DATE(o.registered_at)
    AND o.partner_id = p.partner_id
LEFT JOIN sessions s
    ON p.partner_id = s.partner_id
    AND h.day = s.date_id
LEFT JOIN historical_partners hp
    ON p.partner_id = hp.partner_id
    AND h.day = hp.date_id
LEFT JOIN fail_rate fr
    ON p.partner_id = fr.partner_id
    AND h.day = fr.date_id
GROUP BY 1,2,3,4
ORDER BY 1,2
),
partners_for_baseline AS (
    SELECT 
        partner_id
        ,COUNT(DISTINCT has_discount) qty_status
    FROM daily
    GROUP BY 1
),
baseline as (
SELECT 
    d.weekday
    ,d.partner_id
    ,AVG(rating)            rating
    ,AVG(open_time)         open_time
    ,SAFE_DIVIDE(SUM(commission_amount),SUM(orders)) commission_amount_order
    ,SAFE_DIVIDE(SUM(GMV),SUM(orders))   GMV_order
    ,SAFE_DIVIDE(SUM(GFV),SUM(orders))   GFV_order
    ,SAFE_DIVIDE(SUM(orders),COUNT(DISTINCT day))                    orders
    ,SAFE_DIVIDE(SUM(transactions),COUNT(DISTINCT day))              transactions_base
    ,SAFE_DIVIDE(SUM(transactions),SUM(shop_details))   CVR3
    ,SAFE_DIVIDE(SUM(fr_nominador),SUM(fr_denominador)) fail_rate
FROM daily d
LEFT JOIN partners_for_baseline pb
    ON d.partner_id = pb.partner_id
WHERE pb.qty_status = 2
    AND d.has_discount = FALSE 
GROUP BY 1,2
ORDER BY 1,2
)

SELECT
    day
    ,d.partner_id
    ,p.partner_name
    ,p.country
    ,p.city
    ,p.main_couisine
    ,p.is_important_account
    ,d.is_online
    ,d.has_discount
    ,d.has_subsidized
    ,d.has_weekly
    ,CASE WHEN d.has_subsidized THEN ROUND(d.pct_subsidized/5,0)*5 END   subsidized_pct
    ,CASE WHEN d.has_weekly THEN ROUND(d.weekly_discount/5,0)*5 END        weekly_pct
    ,d.pct_commission
    ,d.CVR3
    ,b.CVR3 CVR3_base
    ,CASE WHEN d.has_discount THEN ROUND(SAFE_DIVIDE(d.CVR3,b.CVR3)-1,2) END var_CVR3
    ,d.transactions_daily   visits
    ,b.transactions_base    visits_base
    ,CASE WHEN d.has_discount THEN ROUND(SAFE_DIVIDE(d.transactions_daily,b.transactions_base)-1,2) END var_visits
    ,SAFE_DIVIDE(d.commission_amount,d.orders) commission_amount_order
    ,b.commission_amount_order                 commission_amount_order_base
    ,CASE WHEN d.has_discount THEN ROUND(SAFE_DIVIDE(SAFE_DIVIDE(d.commission_amount,d.orders), b.commission_amount_order)-1,2) END var_commission_amount
    ,SAFE_DIVIDE(d.GMV,d.orders) GMV_order
    ,b.GMV_order GMV_order_base
    ,CASE WHEN d.has_discount THEN ROUND(SAFE_DIVIDE(SAFE_DIVIDE(d.GMV,d.orders), b.GMV_order)-1,2) END var_GMV
    ,d.orders
    ,b.orders orders_base
    ,CASE WHEN d.has_discount THEN ROUND(SAFE_DIVIDE(SAFE_DIVIDE(d.orders,d.open_time),SAFE_DIVIDE(b.orders,b.open_time))-1,2) END var_orders
    ,SAFE_DIVIDE(d.total_discount_partner,d.orders) VFD_order
    ,d.pct_VFD_GMV
FROM daily d
LEFT JOIN baseline b
    ON d.weekday = b.weekday
    AND d.partner_id = b.partner_id
LEFT JOIN partners p
    ON d.partner_id = p.partner_id
WHERE b.partner_id IS NOT NULL
    AND d.has_discount
ORDER BY 1,2]]></relation>
            </properties>
