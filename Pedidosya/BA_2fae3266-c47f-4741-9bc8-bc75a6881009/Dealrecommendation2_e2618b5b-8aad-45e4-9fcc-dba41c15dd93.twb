      <column datatype='real' default-format='p0.0%' name='[CVR3]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.0%' name='[CVR3_base]' role='measure' type='quantitative' />
      <column caption='Elim_outliers' datatype='real' name='[Calculation_1194298376412495875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [var_visits] &gt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_visits],[Parameters].[Parámetro 5])}&#13;&#10;AND&#13;&#10;[var_visits] &lt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_visits],[Parameters].[Parámetro 6])}&#13;&#10;THEN [var_visits]&#13;&#10;END' />
      </column>
      <column caption='Weekly &amp; Subsidized' datatype='boolean' name='[Calculation_1419759783641346060]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[has_weekly] AND  [has_subsidized]' />
      </column>
      <column caption='Descuento' datatype='string' name='[Calculation_1419759783745474574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [has_subsidized] THEN &quot;Campaña&quot;&#13;&#10;ELSEIF  [has_weekly] THEN &quot;Menú completo&quot;&#13;&#10;ELSE NULL END' />
      </column>
      <column aggregation='Sum' caption='Porcentaje' datatype='real' name='[Calculation_1419759783746117647]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([subsidized_pct],[weekly_pct])' />
      </column>
      <column aggregation='Sum' caption='Subsidized rounded 5' datatype='real' name='[Calculation_1419759783897088016]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ROUND([subsidized_pct]/5,0)*5' />
      </column>
      <column caption='Descuento (%)' datatype='string' name='[Calculation_1419759783911518225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_1419759783745474574]) + &quot; (&quot;+ STR([Calculation_1419759783746117647])+&quot;%)&quot;' />
      </column>
      <column aggregation='Sum' caption='Descuento válido' datatype='integer' name='[Calculation_1419759783943053331]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [var_CVR3]&lt;0 OR  [var_GMV]&lt;0 OR [var_commission_amount]&lt;0 OR [var_orders]&lt;0 THEN 0&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Score' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1419759783945777172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF AVG([var_CVR3])&lt;0 OR AVG([var_GMV])&lt;0 OR AVG([var_orders])&lt;0 THEN 0&#13;&#10;ELSE  (AVG([var_CVR3])*[Parameters].[Parámetro 4] + &#13;&#10;        AVG([var_GMV])*[Parameters].[Parámetro 3]+ &#13;&#10;        AVG([var_commission_amount])*[Parameters].[Parámetro 4] +  &#13;&#10;        AVG([var_orders])*[Parameters].[Parámetro 2] +&#13;&#10;        AVG([var_visits])*[Parameters].[Peso comisión (copia)_479351895890575360])&#13;&#10;/([Parameters].[Parámetro 4]+[Parameters].[Parámetro 1]+[Parameters].[Parámetro 3]+[Parameters].[Parámetro 2]+[Parameters].[Peso comisión (copia)_479351895890575360])*100&#13;&#10;END' />
      </column>
      <column caption='Día de la semana' datatype='integer' name='[Calculation_1419759849834889220]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;,[day])' />
        <aliases>
          <alias key='1' value='Domingo' />
          <alias key='2' value='Lunes' />
          <alias key='3' value='Martes' />
          <alias key='4' value='Miércoles' />
          <alias key='5' value='Jueves' />
          <alias key='6' value='Viernes' />
          <alias key='7' value='Sábado' />
        </aliases>
      </column>
      <column caption='Outliers_ordenes' datatype='real' name='[Calculation_2605825016245837824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [var_orders] &gt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_orders],[Parameters].[Parámetro 5])}&#10;AND&#10;[var_orders] &lt; {FIXED [Calculation_1419759849834889220]:PERCENTILE([var_orders],[Parameters].[Parámetro 6])}&#10;THEN [var_orders]&#10;END' />
      </column>
      <column datatype='integer' name='[Cálculo1]' role='measure' type='quantitative'>
