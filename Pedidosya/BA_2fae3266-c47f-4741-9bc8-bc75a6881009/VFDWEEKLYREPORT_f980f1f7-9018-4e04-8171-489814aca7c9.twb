    <worksheet name='VFD VAR'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>%VFD/GMV VARIANCE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vfd_weekly_report (automated_tables_reports)' name='federated.09bk81c0hcruci11z7jy51vj1ze9' />
          </datasources>
          <datasource-dependencies datasource='federated.09bk81c0hcruci11z7jy51vj1ze9'>
            <column caption='KPI' datatype='string' name='[Calculation_1109011432255049731]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Cálculo1] &gt;= 0.05 then &quot;AUMENTO FUERTE&quot;&#13;&#10;ELSEIF [Cálculo1] &gt;= 0.01 THEN &quot;AUMENTO LEVE&quot;&#13;&#10;ELSEIF [Cálculo1] &gt;= -0.01 THEN &quot;FLAT&quot;&#13;&#10;ELSEIF [Cálculo1] &gt;= -0.05 THEN &quot;CAIDA&quot;&#13;&#10;ELSEIF [Cálculo1] &lt; -0.05 THEN &quot;CAIDA FUERTE&quot;&#13;&#10;ELSE &quot;FLAT&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='%VFD/GMV' datatype='real' default-format='p0%' name='[Calculation_1239897294235455488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([discounts_euro])/sum([gmv_gross_euro])' />
            </column>
            <column caption='%VFD Diff' datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_1239897294235455488]) - LOOKUP(ZN([Calculation_1239897294235455488]), -1)) / ABS(LOOKUP(ZN([Calculation_1239897294235455488]), -1))'>
                <table-calc ordering-field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[wk:week:ok]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Discounts Euro' datatype='real' default-format='c&quot;$ &quot;#,##0,,.00M;-&quot;$ &quot;#,##0,,.00M' name='[discounts_euro]' role='measure' type='quantitative' />
            <column caption='Gmv Gross Euro' datatype='real' default-format='c&quot;$ &quot;#,##0,,.00M;-&quot;$ &quot;#,##0,,.00M' name='[gmv_gross_euro]' role='measure' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1109011432255049731]' derivation='User' name='[usr:Calculation_1109011432255049731:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[Cálculo1]' ordering-field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[wk:week:ok]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_1239897294235455488]' derivation='User' name='[usr:Calculation_1239897294235455488:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Cálculo1]' derivation='User' name='[usr:Cálculo1:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[wk:week:ok]' ordering-type='Field' />
            </column-instance>
            <column caption='Week' datatype='date' name='[week]' role='dimension' type='ordinal' />
