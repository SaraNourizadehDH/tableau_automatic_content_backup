      <column caption='KPI' datatype='string' name='[Calculation_1109011432255049731]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Cálculo1] &gt;= 0.05 then &quot;AUMENTO FUERTE&quot;&#13;&#10;ELSEIF [Cálculo1] &gt;= 0.01 THEN &quot;AUMENTO LEVE&quot;&#13;&#10;ELSEIF [Cálculo1] &gt;= -0.01 THEN &quot;FLAT&quot;&#13;&#10;ELSEIF [Cálculo1] &gt;= -0.05 THEN &quot;CAIDA&quot;&#13;&#10;ELSEIF [Cálculo1] &lt; -0.05 THEN &quot;CAIDA FUERTE&quot;&#13;&#10;ELSE &quot;FLAT&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI2' datatype='string' name='[Calculation_1109011432255451140]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Cálculo2] &gt;= 0.05 then &quot;AUMENTO FUERTE&quot;&#13;&#10;ELSEIF [Cálculo2] &gt;= 0.01 THEN &quot;AUMENTO LEVE&quot;&#13;&#10;ELSEIF [Cálculo2] &gt;= -0.01 THEN &quot;FLAT&quot;&#13;&#10;ELSEIF [Cálculo2] &gt;= -0.05 THEN &quot;CAIDA&quot;&#13;&#10;ELSEIF [Cálculo2] &lt; -0.05 THEN &quot;CAIDA FUERTE&quot;&#13;&#10;ELSE &quot;FLAT&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='%VFD/GMV' datatype='real' default-format='p0%' name='[Calculation_1239897294235455488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([discounts_euro])/sum([gmv_gross_euro])' />
      </column>
      <column caption='%Partner_pen' datatype='real' default-format='p0%' name='[Calculation_1239897294236827649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_partners])/sum([total_partners])' />
      </column>
      <column caption='%Order_pen' datatype='real' default-format='p0.00%' name='[Calculation_1239897294236999682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_orders])/sum([total_orders])' />
      </column>
      <column caption='%User_pen' datatype='real' default-format='p0.00%' name='[Calculation_1239897294237122563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_users])/sum([total_users])' />
      </column>
      <column caption='Non_discount_GMV' datatype='real' default-format='c&quot;$ &quot;#,##0,,.00M;-&quot;$ &quot;#,##0,,.00M' name='[Calculation_1239897294238740484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gmv_gross_euro]-[discounts_euro]' />
      </column>
      <column caption='%VFD Diff' datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_1239897294235455488]) - LOOKUP(ZN([Calculation_1239897294235455488]), -1)) / ABS(LOOKUP(ZN([Calculation_1239897294235455488]), -1))'>
