      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>%PARTNER PENETRATION VARIANCE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vfd_weekly_report (automated_tables_reports)' name='federated.09bk81c0hcruci11z7jy51vj1ze9' />
          </datasources>
          <datasource-dependencies datasource='federated.09bk81c0hcruci11z7jy51vj1ze9'>
            <column caption='KPI2' datatype='string' name='[Calculation_1109011432255451140]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Cálculo2] &gt;= 0.05 then &quot;AUMENTO FUERTE&quot;&#13;&#10;ELSEIF [Cálculo2] &gt;= 0.01 THEN &quot;AUMENTO LEVE&quot;&#13;&#10;ELSEIF [Cálculo2] &gt;= -0.01 THEN &quot;FLAT&quot;&#13;&#10;ELSEIF [Cálculo2] &gt;= -0.05 THEN &quot;CAIDA&quot;&#13;&#10;ELSEIF [Cálculo2] &lt; -0.05 THEN &quot;CAIDA FUERTE&quot;&#13;&#10;ELSE &quot;FLAT&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='%Partner_pen' datatype='real' default-format='p0%' name='[Calculation_1239897294236827649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_partners])/sum([total_partners])' />
            </column>
            <column caption='%PartPen_Diff' datatype='real' default-format='p0.00%' name='[Cálculo2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_1239897294236827649]) - LOOKUP(ZN([Calculation_1239897294236827649]), -1)) / ABS(LOOKUP(ZN([Calculation_1239897294236827649]), -1))'>
                <table-calc ordering-field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[wk:week:ok]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:qk]' pivot='key' type='quantitative' />
            <column caption='Total Partners' datatype='integer' name='[total_partners]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1109011432255451140]' derivation='User' name='[usr:Calculation_1109011432255451140:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[Cálculo2]' ordering-field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[wk:week:ok]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_1239897294236827649]' derivation='User' name='[usr:Calculation_1239897294236827649:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Cálculo2]' derivation='User' name='[usr:Cálculo2:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.09bk81c0hcruci11z7jy51vj1ze9].[wk:week:ok]' ordering-type='Field' />
            </column-instance>
            <column caption='Vfd Partners' datatype='integer' name='[vfd_partners]' role='measure' type='quantitative' />
            <column caption='Week' datatype='date' name='[week]' role='dimension' type='ordinal' />
            <column-instance column='[week]' derivation='Week' name='[wk:week:ok]' pivot='key' type='ordinal' />
            <column-instance column='[week]' derivation='Year' name='[yr:week:ok]' pivot='key' type='ordinal' />
