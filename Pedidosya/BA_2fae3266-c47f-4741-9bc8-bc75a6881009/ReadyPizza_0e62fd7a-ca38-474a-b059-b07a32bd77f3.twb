      <column caption='Zona logistica' datatype='string' name='[Calculation_1313643722988224513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(CONTAINS(UPPER([zone_name]),&quot;JACO&quot;)=TRUE) THEN &quot;Jacó - Herradura&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([zone_name]),&quot;QUEPOS&quot;)=TRUE) THEN &quot;Quepos&quot;&#13;&#10;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA DESAMPARADOS&quot;)=TRUE) THEN &quot;San jose sur&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA CALLE DE LA AMARGURA&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA CORONADO&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA MORAVIA&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA CARTAGO&quot;)=TRUE) THEN &quot;Cartago&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA PARQUE DE LA PAZ&quot;)=TRUE) THEN &quot;San jose sur&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA HEREDIA&quot;)=TRUE) THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA ALAJUELA&quot;)=TRUE) THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA CURRIDABAT&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA ESCAZÚ&quot;)=TRUE) THEN &quot;Escazu - santa ana&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA TIBÁS&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA SANTA ANA&quot;)=TRUE) THEN &quot;Escazu - santa ana&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA GUADALUPE&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA SAN FRANCISCO HEREDIA&quot;)=TRUE) THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA CIUDAD COLÓN&quot;)=TRUE) THEN &quot;Escazu - santa ana&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA TRES RÍOS&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA GRECIA&quot;)=TRUE) THEN &quot;Grecia&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA HIGUERONES&quot;)=TRUE) THEN &quot;San jose sur&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA BARVA&quot;)=TRUE) THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA SAN RAMÓN&quot;)=TRUE) THEN &quot;San ramon - palmares&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA PARAISO&quot;)=TRUE) THEN &quot;Cartago&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA ALAJUELITA&quot;)=TRUE) THEN &quot;San jose sur&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA SAN SEBASTIÁN PLAZA ECO BAMBÚ&quot;)=TRUE) THEN &quot;San jose sur&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA BELÉN&quot;)=TRUE) THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA EL CARMEN&quot;)=TRUE) THEN &quot;Heredia&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA EL ROBLE&quot;)=TRUE) THEN &quot;Puntarenas&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA JACÓ&quot;)=TRUE) THEN &quot;Jacó - Herradura&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA PASEO COLÓN&quot;)=TRUE) THEN &quot;Escazu - santa ana&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA LA FORTUNA&quot;)=TRUE) THEN &quot;Fortuna&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA CIUDAD QUESADA&quot;)=TRUE) THEN &quot;Ciudad quesada&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA GRANADILLA&quot;)=TRUE) THEN &quot;San jose norte&quot;&#13;&#10;ELSEIF(CONTAINS(UPPER([partner_name]),&quot;READY PIZZA GUÁ