        <calculation class='tableau' formula='SUM([8. Onboarding (copia)_226868887692283916])/SUM([1. SR (copia)_226868887685967877])' />
      </column>
      <column caption='Drop_Reason_Corregido' datatype='string' name='[Calculation_148900319479910415]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  CONTAINS([Drop_Reason],&quot;Number of Restaurant&quot;) THEN &quot;More than 1 local&quot;&#13;&#10;ELSEIF  &#13;&#10;[Drop_Reason]= &quot;Drinks&quot; or &#13;&#10;[Drop_Reason]= &quot;Flowers&quot; or &#13;&#10;[Drop_Reason]= &quot;Groceries&quot; or &#13;&#10;[Drop_Reason]= &quot;Healthcare &amp; Beauty&quot; or &#13;&#10;[Drop_Reason]= &quot;Home &amp; Gifts&quot; or &#13;&#10;[Drop_Reason]= &quot;kiosk&quot;or&#13;&#10;[Drop_Reason]= &quot;kiosks&quot;or &#13;&#10;[Drop_Reason]= &quot;Pets&quot; or &#13;&#10;[Drop_Reason]= &quot;Pharmacy&quot; THEN &quot;Vertical not restaurant&quot;&#13;&#10;ELSEIF&#13;&#10;[Drop_Reason]=&quot;Web  To  Lead&quot; THEN &quot;Web to lead&quot;&#13;&#10;ELSEIF  &#13;&#10;[Drop_Reason]=&quot;Contract Details&quot; THEN &quot;Contract Details&quot;&#13;&#10;ELSEIF  &#13;&#10;[Drop_Reason]=&quot;Hurrier Response - false&quot; THEN &quot;Hurrier&quot;&#13;&#10;ELSEIF &#13;&#10;INT([Drop_Reason])&gt;= 1 THEN &quot;Equifax&quot;&#13;&#10;END' />
      </column>
      <column caption='Hurrier lo saca?' datatype='string' name='[Calculation_148900319790690324]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF   &#13;&#10;([Country]=&quot;Peru&quot;  or &#13;&#10;[Country]=&quot;Ecuador&quot; or &#13;&#10;[Country]=&quot;Bolivia&quot; or &#13;&#10;[Country]=&quot;Dominican Republic&quot; or&#13;&#10;[Country]=&quot;Costa Rica&quot; or &#13;&#10;[Country]=&quot;Guatemala&quot; or &#13;&#10;[Country]=&quot;Honduras&quot;) and &#13;&#10;[Calculation_148900319479910415]= &quot;Hurrier&quot;&#13;&#10;THEN &quot;Si&quot;&#13;&#10;ELSE &quot;No&quot; &#13;&#10;END' />
      </column>
      <column caption='Elegible?' datatype='string' name='[Calculation_217580213378441216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  &#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;More than 1 local&quot;) OR&#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;Vertical not restaurant&quot;) OR&#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;Web to lead&quot;) OR&#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;Hurrier&quot;) AND&#13;&#10;[Step]&lt;&gt;&quot;Win Back failed&quot;&#13;&#10;THEN &quot;No&quot; &#13;&#10;ELSE &quot;Si&quot; &#13;&#10;END' />
      </column>
      <column caption='1. Registration' datatype='integer' name='[Calculation_226868887684857859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;[Step]=&quot;Active&quot; OR &#13;&#10;[Step]=&quot;Active - Temp. Unavailable&quot; OR &#13;&#10;[Step]=&quot;Collecting Documents&quot; OR &#13;&#10;[Step]=&quot;Contacted&quot; OR &#13;&#10;[Step]=&quot;Lost&quot; OR &#13;&#10;[Step]=&quot;Menu processing&quot; OR &#13;&#10;[Step]=&quot;Negotiation&quot; OR &#13;&#10;[Step]=&quot;New&quot; OR &#13;&#10;[Step]=&quot;Onboarding&quot; OR &#13;&#10;[Step]=&quot;Open&quot; OR &#13;&#10;[Step]=&quot;Quality Check&quot; OR &#13;&#10;[Step]=&quot;step-1&quot; OR &#13;&#10;[Step]=&quot;step-2&quot; OR &#13;&#10;[Step]=&quot;step-3&quot; OR &#13;&#10;[Step]=&quot;step-4&quot; OR &#13;&#10;[Step]=&quot;Terminated&quot;&#13;&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='Drop_Reason_Para_Forecast' datatype='string' name='[Calculation_323696289935941636]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Drop_Reason]=&quot;Healthcare &amp; Beauty&quot; THEN &quot;Pharmacy&quot; &#13;&#10;    ELSE [Drop_Reason]&#13;&#10;END' />
      </column>
      <column caption='Data up to' datatype='date' name='[Calculation_850617438424887296]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(DATE([SRCreatedDate]))' />
      </column>
