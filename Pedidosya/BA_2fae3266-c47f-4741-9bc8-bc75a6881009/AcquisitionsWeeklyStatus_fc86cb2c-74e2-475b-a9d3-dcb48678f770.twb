            from `peya-data-origins-pro.cl_salesforce.cases`
            where closed_reason = "Successful"
              and CreatedDate >>= "2020-09-01"
              and Type = "Onboarding"
            group by 1,2) Closed 
    ON Closed.AccountId = a.Id
WHERE(								
  (SR.CreatedDate between "2020-09-01 00:00:01 UTC" and "2021-03-15 00:00:01 UTC") or
  (SR.CreatedDate >> "2021-03-15 00:06:00 UTC" ))]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
