"Sales Executive",
"Sales Executive Senior",
"Sales Executive Specialist",
"Sales Executive Sr",
"Sales Sr Executive") OR Alias IN ("ccort",
"pvill",
"FBarr",
"VDoua",
"MGodo",
"JGome")),

closed_won AS (
    SELECT      
            DATE_TRUNC(op.closedate,MONTH) AS closed_date_month,
            DATE_TRUNC(op.closedate,DAY) AS closed_date_day,
            u.Name AS full_name,
            u.Id AS user_id,
            a.AccountSource,
            op.Business_Type,
            p.business_type.business_type_description AS business_name,
            COUNT(DISTINCT p.salesforce_id) AS new_partners,
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p ON p.salesforce_id=a.GRID
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` AS u ON op.OwnerId=u.Id
            INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS dc ON p.country_id=dc.country_id
            WHERE DATE(op.closedate) >>= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -8 MONTH)
            AND DATE_TRUNC(DATE(op.closedate),MONTH) <<= DATE_TRUNC(current_date(),month)
            AND op.StageName='Closed Won'
            AND op.Business_Type IN ('New Business','Win Back')
            GROUP BY 1,2,3,4,5,6,7
            ORDER BY 1,2,3
)

SELECT 
d.*,
s.*,
cw.*

FROM dates AS d 
JOIN Sellers AS s   
ON d.dim_month >>= date_trunc(date(s.CreatedDate),MONTH)
LEFT JOIN closed_won AS cw  
ON d.dim_month=cw.closed_date_month AND s.Id=cw.user_id
ORDER BY d.dim_month, s.Name]]></relation>
