          <datasource-dependencies datasource='federated.1p5keey1einqlq14zth1t0h6lbc7'>
            <column caption='Drop_Reason_Corregido' datatype='string' name='[Calculation_148900319479910415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  CONTAINS([Drop_Reason],&quot;Number of Restaurant&quot;) THEN &quot;More than 1 local&quot;&#13;&#10;ELSEIF  &#13;&#10;[Drop_Reason]= &quot;Drinks&quot; or &#13;&#10;[Drop_Reason]= &quot;Flowers&quot; or &#13;&#10;[Drop_Reason]= &quot;Groceries&quot; or &#13;&#10;[Drop_Reason]= &quot;Healthcare &amp; Beauty&quot; or &#13;&#10;[Drop_Reason]= &quot;Home &amp; Gifts&quot; or &#13;&#10;[Drop_Reason]= &quot;kiosk&quot;or&#13;&#10;[Drop_Reason]= &quot;kiosks&quot;or &#13;&#10;[Drop_Reason]= &quot;Pets&quot; or &#13;&#10;[Drop_Reason]= &quot;Pharmacy&quot; THEN &quot;Vertical not restaurant&quot;&#13;&#10;ELSEIF&#13;&#10;[Drop_Reason]=&quot;Web  To  Lead&quot; THEN &quot;Web to lead&quot;&#13;&#10;ELSEIF  &#13;&#10;[Drop_Reason]=&quot;Contract Details&quot; THEN &quot;Contract Details&quot;&#13;&#10;ELSEIF  &#13;&#10;[Drop_Reason]=&quot;Hurrier Response - false&quot; THEN &quot;Hurrier&quot;&#13;&#10;ELSEIF &#13;&#10;INT([Drop_Reason])&gt;= 1 THEN &quot;Equifax&quot;&#13;&#10;END' />
            </column>
            <column caption='Elegible?' datatype='string' name='[Calculation_217580213378441216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  &#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;More than 1 local&quot;) OR&#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;Vertical not restaurant&quot;) OR&#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;Web to lead&quot;) OR&#13;&#10;CONTAINS([Calculation_148900319479910415],&quot;Hurrier&quot;) AND&#13;&#10;[Step]&lt;&gt;&quot;Win Back failed&quot;&#13;&#10;THEN &quot;No&quot; &#13;&#10;ELSE &quot;Si&quot; &#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Drop_Reason]' role='dimension' type='nominal'>
