      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Service Request' id='_3F7265E657B249D8B8073C6084CB4E50'>
            <properties context=''>
              <relation connection='bigquery.13v90qi0s2l6l61c4cecx1u4b31r' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT			
  COALESCE(sr.Country, l.Country,a.Account_Country_Code) as Country, /*Country*/				
  COALESCE(l.LeadSource,a.AccountSource) as Source, /*Source*/				
  COALESCE(sr.Vertical,l.Vertical,a.Vertical) as Vertical, /*Vertical*/				
  sr.Number_of_Restaurants,				
  sr.Hurrier_Response,	
  sr.equifaxapi_response,
  sr.steps_completed,  
  COALESCE(sr.Current_Step,IF(l.Status="Converted",null,l.Status),a.Account_Status) as Step, /*Status*/				
  a.Relay_Method,				
  a.Delivery_Service,				
  a.AccountSource,				
  l.LeadSource,				
  sr.Current_Step,				
  l.status,	
  l.Lost_Reason,			
  a.Account_Status,				
  sr.Drop_From_SSU_Process,				
  sr.Drop_Reason,				
  sr.Reminder_Email_Status,
  sr.CreatedDate as SRCreatedDate,
  l.createddate as LeadCreatedDate,
  a.createddate as AccountCreatedDate,
  closed.ClosedDate_Closed,
  l.utm_source,
  l.utm_medium,
  l.utm_campaign,
FROM`peya-data-origins-pro.cl_salesforce.service_request` sr				
LEFT JOIN`peya-data-origins-pro.cl_salesforce.lead` l 
    ON sr.businessname = l.company 
    AND DATETIME(l.createddate) >>= DATETIME_ADD(DATETIME(sr.CreatedDate), INTERVAL -1 minute) 
    AND DATETIME(l.createddate) <<= DATETIME_ADD(DATETIME(sr.CreatedDate), INTERVAL 1 minute)
LEFT JOIN`peya-data-origins-pro.cl_salesforce.account` a 
    ON l.grid = a.grid					
LEFT JOIN (select closed_reason
                  ,AccountId
                  ,min(ClosedDate) as ClosedDate_Closed
            from `peya-data-origins-pro.cl_salesforce.cases`
            where closed_reason = "Successful"
              and CreatedDate >>= "2020-09-01"
              and Type = "Onboarding"
            group by 1,2) Closed 
    ON Closed.AccountId = a.Id
WHERE(								
  (SR.CreatedDate between "2020-09-01 00:00:01 UTC" and "2021-03-15 00:00:01 UTC") or
  (SR.CreatedDate >> "2021-03-15 00:06:00 UTC" ))]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='10'>SSU New Online &amp;  Share of FOOD acquisitions</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='1. New accounts SSU' name='federated.0kn2nq40sxewbb1gmsv8p1krhfcv' />
          </datasources>
          <datasource-dependencies datasource='federated.0kn2nq40sxewbb1gmsv8p1krhfcv'>
            <column aggregation='Attribute' caption='New Accounts [Total]' datatype='integer' name='[Calculation_1051872041538428928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [Source]:SUM([New_Online])}+ {EXCLUDE [Source]:SUM([Winback])}' />
            </column>
            <column caption='New Accounts [SSU]' datatype='integer' name='[Calculation_1051872041538736129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Source]=&quot;Self Sign Up&quot; THEN [New_Online] END) + sum(if [Source]=&quot;Self Sign Up&quot; THEN [Winback] END)' />
            </column>
            <column caption='New Accounts [SSU %]' datatype='real' default-format='p0%' name='[Calculation_1051872041539125251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1051872041538736129]/ATTR([Calculation_1051872041538428928])' />
            </column>
            <column datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[New_Online]' role='measure' type='quantitative' />
            <column datatype='string' name='[Source]' role='dimension' type='nominal' />
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Winback]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1051872041538428928]' derivation='Attribute' name='[attr:Calculation_1051872041538428928:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CloseDate]' derivation='None' name='[none:CloseDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Vertical]' derivation='None' name='[none:Vertical:nk]' pivot='key' type='nominal' />
