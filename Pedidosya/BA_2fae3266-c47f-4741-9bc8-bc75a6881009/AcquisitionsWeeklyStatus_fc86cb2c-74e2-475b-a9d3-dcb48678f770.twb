    <datasource caption='2. Funnel SSU' inline='true' name='federated.1p5keey1einqlq14zth1t0h6lbc7' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.13v90qi0s2l6l61c4cecx1u4b31r'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_agustin_cardini' server='' server-oauth='' username='agustin.cardini@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13v90qi0s2l6l61c4cecx1u4b31r' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT			
  COALESCE(sr.Country, l.Country,a.Account_Country_Code) as Country, /*Country*/				
  COALESCE(l.LeadSource,a.AccountSource) as Source, /*Source*/				
  COALESCE(sr.Vertical,l.Vertical,a.Vertical) as Vertical, /*Vertical*/				
  sr.Number_of_Restaurants,				
  sr.Hurrier_Response,	
  sr.equifaxapi_response,
  sr.steps_completed,  
  COALESCE(sr.Current_Step,IF(l.Status="Converted",null,l.Status),a.Account_Status) as Step, /*Status*/				
  a.Relay_Method,				
  a.Delivery_Service,				
  a.AccountSource,				
  l.LeadSource,				
  sr.Current_Step,				
  l.status,	
  l.Lost_Reason,			
  a.Account_Status,				
  sr.Drop_From_SSU_Process,				
  sr.Drop_Reason,				
  sr.Reminder_Email_Status,
  sr.CreatedDate as SRCreatedDate,
  l.createddate as LeadCreatedDate,
  a.createddate as AccountCreatedDate,
  closed.ClosedDate_Closed,
  l.utm_source,
  l.utm_medium,
  l.utm_campaign,
FROM`peya-data-origins-pro.cl_salesforce.service_request` sr				
LEFT JOIN`peya-data-origins-pro.cl_salesforce.lead` l 
    ON sr.businessname = l.company 
    AND DATETIME(l.createddate) >>= DATETIME_ADD(DATETIME(sr.CreatedDate), INTERVAL -1 minute) 
    AND DATETIME(l.createddate) <<= DATETIME_ADD(DATETIME(sr.CreatedDate), INTERVAL 1 minute)
LEFT JOIN`peya-data-origins-pro.cl_salesforce.account` a 
    ON l.grid = a.grid					
LEFT JOIN (select closed_reason
                  ,AccountId
                  ,min(ClosedDate) as ClosedDate_Closed
            from `peya-data-origins-pro.cl_salesforce.cases`
            where closed_reason = "Successful"
              and CreatedDate >>= "2020-09-01"
              and Type = "Onboarding"
            group by 1,2) Closed 
    ON Closed.AccountId = a.Id
WHERE(								
  (SR.CreatedDate between "2020-09-01 00:00:01 UTC" and "2021-03-15 00:00:01 UTC") or
  (SR.CreatedDate >> "2021-03-15 00:06:00 UTC" ))]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.13v90qi0s2l6l61c4cecx1u4b31r' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT			
  COALESCE(sr.Country, l.Country,a.Account_Country_Code) as Country, /*Country*/				
  COALESCE(l.LeadSource,a.AccountSource) as Source, /*Source*/				
  COALESCE(sr.Vertical,l.Vertical,a.Vertical) as Vertical, /*Vertical*/				
  sr.Number_of_Restaurants,				
  sr.Hurrier_Response,	
  sr.equifaxapi_response,
  sr.steps_completed,  
  COALESCE(sr.Current_Step,IF(l.Status="Converted",null,l.Status),a.Account_Status) as Step, /*Status*/				
  a.Relay_Method,				
  a.Delivery_Service,				
  a.AccountSource,				
  l.LeadSource,				
  sr.Current_Step,				
  l.status,	
  l.Lost_Reason,			
