    <datasource caption='1. New accounts SSU' inline='true' name='federated.0kn2nq40sxewbb1gmsv8p1krhfcv' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.105l44g0hga9471d831j206msk0h'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='yes' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_agustin_cardini' server-oauth='' username='agustin.cardini@pedidosya.com' workgroup-auth-mode='prompt' />
