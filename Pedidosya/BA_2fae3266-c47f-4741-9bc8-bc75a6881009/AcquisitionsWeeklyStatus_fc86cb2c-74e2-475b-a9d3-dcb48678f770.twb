      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='New Accounts SSU' id='_92614AF3330248A9BC52236629F7E587'>
            <properties context=''>
              <relation connection='bigquery.105l44g0hga9471d831j206msk0h' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    x.CloseDate,
    x.Country,
    x.Vertical,
    x.Source,
    x.Relay_Method,
    x.Delivery_Service,
	x.New_Online,
    y.New_Business,
    y.Winback,

FROM (
    SELECT
        DATE_TRUNC(DATE(fpm.full_date),MONTH) AS CloseDate,
        dc.country_name AS Country,
        dp.business_type.business_type_name AS Vertical,
        sa.AccountSource as Source,
        sa.Relay_Method,
        sa.Delivery_Service,
        COUNT(DISTINCT CASE WHEN fpm.is_new_online THEN fpm.restaurant_id END) AS New_Online
    
    FROM `peya-bi-tools-pro.il_core.fact_partners_monthly` fpm

    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dp 
        ON 	fpm.restaurant_id=dp.partner_id	

    LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` sa 
        ON dp.salesforce_id=sa.GRID

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc
        ON dc.country_id = fpm.country_id 
        AND dc.active

    WHERE 
        DATE_TRUNC(DATE(fpm.full_date),MONTH) >>= "2020-09-01"
        AND DATE(fpm.full_date) <<=CURRENT_DATE()

    GROUP BY 1,2,3,4,5,6
    ) x

LEFT JOIN (
    SELECT  
        DATE_TRUNC(DATE(op.closedate),MONTH) AS CloseDate,
        dc.country_name AS Country,
        dp.business_type.business_type_name AS Vertical,
        sa.AccountSource AS Source,
        sa.Relay_Method,
        sa.Delivery_Service,
        COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "New Business" THEN  op.salesforce_id ELSE NULL END) AS New_Business,
        COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "Win Back" THEN  op.salesforce_id ELSE NULL END) AS Winback,
    
    FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op

    LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` sa 
        ON sa.Id=op.AccountId

    LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  dc 
        ON sa.Account_Country_Code =dc.country_code

    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp 
        ON dp.salesforce_id=sa.GRID

    WHERE 
        DATE(op.closedate) >>= "2020-09-01"
        AND DATE(op.closedate) <<=CURRENT_DATE()

    GROUP BY 1,2,3,4,5,6
    ) y
    
    ON x.CloseDate = y.CloseDate
        AND x.Country=y.Country
        AND x.Vertical = y.Vertical
        AND x.Source = y.Source
        AND x.Relay_Method = y.Relay_Method
        AND x.Delivery_Service = y.Delivery_Service]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='3. New Partner' inline='true' name='federated.14vz6po1e64wzs102czgc11vgf2c' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1qnhp2v047a92k175e0wd1kob202'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_agustin_cardini' server='' server-oauth='' username='agustin.cardini@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1qnhp2v047a92k175e0wd1kob202' name='Consulta SQL personalizada' type='text'><![CDATA[WITH database AS

(WITH 
    closedwon AS (SELECT  DATE_TRUNC(DATE(op.closedate),MONTH) AS date_month,
                    dc.country_id,
                    dc.country_name,
                     COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "Win Back" AND a.Vertical = "Restaurant" THEN  op.salesforce_id ELSE NULL END) AS Winbacks_food,
                     COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "Win Back" AND a.Vertical = "Shop" THEN  op.salesforce_id ELSE NULL END) AS Winbacks_shop,
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc ON a.Account_Country_Code =dc.country_code
            WHERE DATE_TRUNC((DATE(op.closedate)),MONTH) >>= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -8 MONTH)
            AND DATE(op.closedate) <<=CURRENT_DATE()
            GROUP BY 1,2,3
    ),
    newonline AS(SELECT
	DATE(pm.full_date) AS month,
        dc.country_id AS country_id,
	COUNT(DISTINCT CASE WHEN pm.is_new_online AND pm.business_type IN (1,7)  THEN pm.restaurant_id END) AS new_online_food,
    COUNT(DISTINCT CASE WHEN pm.is_new_online AND pm.business_type NOT IN (1,7,11,9,13)  THEN pm.restaurant_id END) AS new_online_shop
FROM `peya-bi-tools-pro.il_core.fact_partners_monthly` pm

INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc
        ON dc.country_id = pm.country_id 
       AND dc.active
WHERE DATE_TRUNC(DATE(pm.full_date),MONTH) >>= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -8 MONTH)
AND DATE(pm.full_date) <<=CURRENT_DATE()
GROUP BY 1,2
ORDER BY 1 DESC, 2
    ),

inprocess AS ( SELECT  DATE_TRUNC(DATE(op.LastModifiedDate),MONTH) AS date_month,
                    dc.country_id,
                    COUNT(DISTINCT CASE WHEN op.StageName IN ("Editorial Queue","Delivery Pending","Onboarding") THEN op.salesforce_id ELSE NULL END) AS In_Process,
                            COUNT(DISTINCT CASE WHEN op.StageName IN ("Editorial Queue","Delivery Pending","Onboarding") AND a.Vertical="Restaurant" THEN op.salesforce_id ELSE NULL END) AS In_Process_food,
                                               COUNT(DISTINCT CASE WHEN op.StageName IN ("Editorial Queue","Delivery Pending","Onboarding") AND a.Vertical="Shop" THEN op.salesforce_id ELSE NULL END) AS In_Process_shop,
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc ON a.Account_Country_Code =dc.country_code
            WHERE DATE(op.LastModifiedDate) >>= "2021-05-01"
            AND DATE_TRUNC(DATE(op.LastModifiedDate),MONTH) <<= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -6 MONTH)
            AND op.Business_Type IN ('New Business','Win Back')
            GROUP BY 1,2

)

SELECT
cw.*,
nw.new_online_food,
nw.new_online_shop,
ip.In_Process,
ip.In_Process_food,
ip.In_Process_shop
FROM closedwon  AS cw 
LEFT JOIN newonline AS nw 
ON cw.date_month=nw.Month  AND cw.country_id=nw.country_id
LEFT JOIN inprocess AS ip
ON cw.date_month=ip.date_month AND cw.country_id=ip.country_id
) 

SELECT * FROM database   
UNPIVOT (
    Partners FOR KPI IN (Winbacks_food,	Winbacks_shop,	new_online_food,	new_online_shop,	In_Process,	In_Process_food,	In_Process_shop)
)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1qnhp2v047a92k175e0wd1kob202' name='Consulta SQL personalizada' type='text'><![CDATA[WITH database AS

(WITH 
    closedwon AS (SELECT  DATE_TRUNC(DATE(op.closedate),MONTH) AS date_month,
                    dc.country_id,
                    dc.country_name,
                     COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "Win Back" AND a.Vertical = "Restaurant" THEN  op.salesforce_id ELSE NULL END) AS Winbacks_food,
                     COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "Win Back" AND a.Vertical = "Shop" THEN  op.salesforce_id ELSE NULL END) AS Winbacks_shop,
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc ON a.Account_Country_Code =dc.country_code
            WHERE DATE_TRUNC((DATE(op.closedate)),MONTH) >>= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -8 MONTH)
            AND DATE(op.closedate) <<=CURRENT_DATE()
            GROUP BY 1,2,3
    ),
    newonline AS(SELECT
	DATE(pm.full_date) AS month,
        dc.country_id AS country_id,
	COUNT(DISTINCT CASE WHEN pm.is_new_online AND pm.business_type IN (1,7)  THEN pm.restaurant_id END) AS new_online_food,
    COUNT(DISTINCT CASE WHEN pm.is_new_online AND pm.business_type NOT IN (1,7,11,9,13)  THEN pm.restaurant_id END) AS new_online_shop
FROM `peya-bi-tools-pro.il_core.fact_partners_monthly` pm

INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc
        ON dc.country_id = pm.country_id 
       AND dc.active
WHERE DATE_TRUNC(DATE(pm.full_date),MONTH) >>= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -8 MONTH)
AND DATE(pm.full_date) <<=CURRENT_DATE()
GROUP BY 1,2
ORDER BY 1 DESC, 2
    ),

inprocess AS ( SELECT  DATE_TRUNC(DATE(op.LastModifiedDate),MONTH) AS date_month,
                    dc.country_id,
                    COUNT(DISTINCT CASE WHEN op.StageName IN ("Editorial Queue","Delivery Pending","Onboarding") THEN op.salesforce_id ELSE NULL END) AS In_Process,
                            COUNT(DISTINCT CASE WHEN op.StageName IN ("Editorial Queue","Delivery Pending","Onboarding") AND a.Vertical="Restaurant" THEN op.salesforce_id ELSE NULL END) AS In_Process_food,
                                               COUNT(DISTINCT CASE WHEN op.StageName IN ("Editorial Queue","Delivery Pending","Onboarding") AND a.Vertical="Shop" THEN op.salesforce_id ELSE NULL END) AS In_Process_shop,
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc ON a.Account_Country_Code =dc.country_code
            WHERE DATE(op.LastModifiedDate) >>= "2021-05-01"
            AND DATE_TRUNC(DATE(op.LastModifiedDate),MONTH) <<= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -6 MONTH)
            AND op.Business_Type IN ('New Business','Win Back')
            GROUP BY 1,2

)

SELECT
cw.*,
nw.new_online_food,
nw.new_online_shop,
ip.In_Process,
ip.In_Process_food,
ip.In_Process_shop
FROM closedwon  AS cw 
LEFT JOIN newonline AS nw 
ON cw.date_month=nw.Month  AND cw.country_id=nw.country_id
LEFT JOIN inprocess AS ip
ON cw.date_month=ip.date_month AND cw.country_id=ip.country_id
) 

SELECT * FROM database   
UNPIVOT (
    Partners FOR KPI IN (Winbacks_food,	Winbacks_shop,	new_online_food,	new_online_shop,	In_Process,	In_Process_food,	In_Process_shop)
)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
