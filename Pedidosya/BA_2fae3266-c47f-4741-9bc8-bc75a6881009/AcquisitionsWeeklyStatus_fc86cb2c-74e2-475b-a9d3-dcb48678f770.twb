    <datasource caption='4. Sales Executive Performance' inline='true' name='federated.0kjeucn1861u07123l1741bhpgif' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17who900et4b2816s6ip212rr8ef'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_agustin_cardini' server='' server-oauth='' username='agustin.cardini@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Telesales executives' name='google-sheets.1i6ihfr0iq0lkx15hury71g9jvs1'>
            <connection class='google-sheets' cleaning='no' compat='no' dataRefreshTime='' filename='TEMP_0jxtl6y1ve7sai1g2w0mr04w6ibo' googleSheetId='1Fk0BXgzYc_NxbHIlbfpfELj54jtnU4qMnQ-YQgzkCGM' interpretationMode='8' mimeType='application/vnd.google-apps.spreadsheet' server-oauth='' username='agustin.cardini@pedidosya.com' validate='no' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17who900et4b2816s6ip212rr8ef' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dates AS (      
        SELECT 
        DATE_TRUNC(date(date),month) AS dim_month,
        FROM 
        `peya-bi-tools-pro.il_core.dim_date` 
        WHERE DATE_TRUNC(date(date),month) >>= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -8 MONTH)
        AND DATE_TRUNC(date(date),month) <<= DATE_TRUNC(current_date(),month)
        GROUP BY 1
  ),
  Sellers AS (SELECT 
Country,
Id,
Alias,
Title,
Name,
CreatedDate,
LastModifiedDate,
FROM `peya-data-origins-pro.cl_salesforce.user` 
WHERE DATE_TRUNC(DATE(_ingested_at),MONTH) = DATE_TRUNC(CURRENT_DATE(),MONTH) 
AND IsActive = TRUE
AND Entity = "UY Pedidosya"
AND Title IN ("Sales  Executive",
"Sales Executive",
"Sales Executive Senior",
"Sales Executive Specialist",
"Sales Executive Sr",
"Sales Sr Executive") OR Alias IN ("ccort",
"pvill",
"FBarr",
"VDoua",
"MGodo",
"JGome")),

closed_won AS (
    SELECT      
            DATE_TRUNC(op.closedate,MONTH) AS closed_date_month,
            DATE_TRUNC(op.closedate,DAY) AS closed_date_day,
            u.Name AS full_name,
            u.Id AS user_id,
            a.AccountSource,
            op.Business_Type,
            p.business_type.business_type_description AS business_name,
            COUNT(DISTINCT p.salesforce_id) AS new_partners,
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p ON p.salesforce_id=a.GRID
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` AS u ON op.OwnerId=u.Id
            INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS dc ON p.country_id=dc.country_id
            WHERE DATE(op.closedate) >>= date_add(DATE_TRUNC(current_date(),MONTH), INTERVAL -8 MONTH)
            AND DATE_TRUNC(DATE(op.closedate),MONTH) <<= DATE_TRUNC(current_date(),month)
            AND op.StageName='Closed Won'
            AND op.Business_Type IN ('New Business','Win Back')
            GROUP BY 1,2,3,4,5,6,7
            ORDER BY 1,2,3
)

SELECT 
d.*,
s.*,
cw.*

FROM dates AS d 
JOIN Sellers AS s   
ON d.dim_month >>= date_trunc(date(s.CreatedDate),MONTH)
LEFT JOIN closed_won AS cw  
ON d.dim_month=cw.closed_date_month AND s.Id=cw.user_id
ORDER BY d.dim_month, s.Name]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.17who900et4b2816s6ip212rr8ef' name='Consulta SQL personalizada' type='text'><![CDATA[WITH dates AS (      
