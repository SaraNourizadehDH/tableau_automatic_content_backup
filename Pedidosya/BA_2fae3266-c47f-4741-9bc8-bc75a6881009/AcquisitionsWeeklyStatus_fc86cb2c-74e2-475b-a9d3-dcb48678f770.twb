      <aliases enabled='yes' />
      <column caption='Account_Source Organic/Non_Organic' datatype='string' name='[Account_Source SSU/Inb/Other (copia)_1103663404275232768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_498773713647583232]=&quot;Self Sign Up&quot; THEN &quot;Organic&quot;&#13;&#10;ELSEIF [Calculation_498773713647583232]=&quot;Inbound&quot; THEN &quot;Organic&quot;&#13;&#10;ELSE &quot;Non organic&quot; &#13;&#10;END' />
      </column>
      <column aggregation='Attribute' caption='New Accounts [Total]' datatype='integer' name='[Calculation_1051872041538428928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [Source]:SUM([New_Online])}+ {EXCLUDE [Source]:SUM([Winback])}' />
      </column>
      <column caption='New Accounts [SSU]' datatype='integer' name='[Calculation_1051872041538736129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Source]=&quot;Self Sign Up&quot; THEN [New_Online] END) + sum(if [Source]=&quot;Self Sign Up&quot; THEN [Winback] END)' />
      </column>
      <column caption='New Accounts [SSU %]' datatype='real' default-format='p0%' name='[Calculation_1051872041539125251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1051872041538736129]/ATTR([Calculation_1051872041538428928])' />
      </column>
      <column caption='Data up to' datatype='date' name='[Calculation_1051872041568194568]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([CloseDate])' />
      </column>
      <column caption='Week' datatype='integer' name='[Calculation_1241867619965407232]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='WEEK(today())-1' />
      </column>
      <column caption='Account_Source SSU/Inb/Other' datatype='string' name='[Calculation_237283468813475840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_498773713647583232]=&quot;Self Sign Up&quot; THEN &quot;Self Sign Up&quot;&#13;&#10;ELSEIF [Calculation_498773713647583232]=&quot;Inbound&quot; THEN &quot;Inbound&quot;&#13;&#10;ELSE &quot;Other&quot; &#13;&#10;END' />
      </column>
      <column caption='Source Corregido' datatype='string' name='[Calculation_498773713647583232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Source]=&apos;Automated LeadGen&apos; OR [Source]=&apos;Competitor&apos; OR [Source]=&apos;Inbound&apos; OR [Source]=&apos;Recommendation from customer&apos; OR [Source]=&apos;Self Sign Up&apos; OR [Source]=&apos;Cloned&apos;OR [Source]=&apos;Import&apos;OR [Source]=&apos;Own Research&apos; THEN [Source]&#13;&#10;ELSEIF [Source]=&quot;IMPORT&quot; THEN &quot;Import&quot;&#13;&#10;ELSEIF [Source]=&quot;Busqueda Propia&quot; THEN &quot;Own Research&quot;&#13;&#10;END' />
      </column>
      <column caption='NO+WB' datatype='integer' name='[Calculation_99642164159062016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[New_Online]+[Winback]' />
      </column>
