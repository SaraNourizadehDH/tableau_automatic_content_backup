        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Framework Compliance Day 15&apos; AND ISNULL([Framework_Compliance_Day_15])) THEN &apos;Nulo&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Framework Compliance Day 30&apos; AND ISNULL([Framework Compliance Da])) THEN &apos;Nulo&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Framework Compliance Day 30&apos; AND ISNULL([Framework_Compliance_Day_30])) THEN &apos;Nulo&apos;&#13;&#10;ELSE &apos;No nulo&apos;&#13;&#10;END' />
