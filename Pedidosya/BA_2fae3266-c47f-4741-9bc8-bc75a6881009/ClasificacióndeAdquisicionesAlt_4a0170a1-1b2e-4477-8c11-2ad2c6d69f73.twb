            <column caption='Nulo?' datatype='string' name='[Calculation_627970699851468804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] IN (&apos;Framework Compliance Day 1&apos;, &apos;Framework Compliance Day 15&apos;, &apos;Framework Compliance Day 1 &amp; 15&apos;, &apos;Framework Compliance Day 30&apos;, &apos;Photos Compliance Day 1&apos;, &apos;Photos Compliance Day 15&apos;, &apos;Photos Compliance Day 30&apos;, &apos;Framework: Segmentation 1&apos;, &apos;Framework: Segmentation 2&apos;, &apos;Framework: Segmentation 3&apos;) AND [Vertical] &lt;&gt; &apos;Food&apos; THEN &apos;Nulo&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Framework Compliance Day 15&apos; AND ISNULL([Framework_Compliance_Day_15])) THEN &apos;Nulo&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Framework Compliance Day 1 &amp; 15&apos; AND ISNULL([Framework_Compliance_Days_1_and_15])) THEN &apos;Nulo&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Framework Compliance Day 30&apos; AND ISNULL([Framework_Compliance_Day_30])) THEN &apos;Nulo&apos;&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Photos Compliance Day 15&apos; AND ISNULL([Photos_Compliance_Day_15])) THEN &apos;Nulo&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Photos Compliance Day 1 &amp; 15&apos; AND ISNULL([Photos_Compliance_Days_1_and_15])) THEN &apos;Nulo&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Photos Compliance Day 30&apos; AND ISNULL([Photos_Compliance_Day_30])) THEN &apos;Nulo&apos;&#13;&#10;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Framework: Segmentation 3&apos; AND ISNULL([Framework_Compliance_Day_15])) THEN &apos;Nulo&apos;&#13;&#10;&#13;&#10;ELSE &apos;No nulo&apos;&#13;&#10;END' />
            </column>
            <column caption='Medida View by' datatype='string' name='[Calculation_682295351181135874]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;New Online or Winback&quot; then [New_Online_or_Winback]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Account Source&apos; THEN [AccountSource]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Country&apos; THEN [Country_Name]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;City&apos; THEN [city_name]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Area&apos; THEN [area_name]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Vertical&apos; THEN [Vertical]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Vertical Segment&apos; THEN [vertical_segment]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Cousine Type&apos; THEN [Cousine_type]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Business Category LS&apos; THEN [Business_Category_LS]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Key Vip Account&apos; THEN [Key_Vip_account]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Selected Offer&apos; THEN [Selected_Offer_Compliance]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;POS&apos; THEN [POS]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Self Onboarded&apos; THEN [Self_Onboarded]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Self Activated&apos; THEN [Self_Activated]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Self Onboarded &amp; Self Activated&apos; THEN [Self_Onboarded_and_Self_Activated]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework Compliance Day 1&apos; THEN [Framework_Compliance_Day_1]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework Compliance Day 15&apos; THEN [Framework_Compliance_Day_15]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework Compliance Day 30&apos; THEN [Framework_Compliance_Day_30]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework Compliance Day 1&apos; THEN [Framework_Compliance_Day_1]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework Compliance Day 1 &amp; 15&apos; THEN [Framework_Compliance_Days_1_and_15]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Photos Compliance Day 1&apos; THEN [Photos_Compliance_Day_1]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Photos Compliance Day 15&apos; THEN [Photos_Compliance_Day_15]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Photos Compliance Day 30&apos; THEN [Photos_Compliance_Day_30]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Photos Compliance Day 1 &amp; 15&apos; THEN [Photos_Compliance_Days_1_and_15]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Vendor Grade&apos; THEN [Vendor_Grade]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Only 1 Quality Check Case&apos; THEN [Only_One_QC_Case]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Self Set Up&apos; THEN [Self_Setup]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;UTM Source&apos; THEN [utm_source]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Competitor&apos; THEN [Competitor]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Delivery or Marketplace&apos; THEN [Delivery_or_Marketplace]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Payment Method&apos; THEN [Payment_Method]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Pickup&apos; THEN [Pick_up]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Converted by&apos; THEN [Converted_by]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework: Segmentation 1&apos; THEN [Segmentation_1]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework: Segmentation 2&apos; THEN [Segmentation_2]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework: Segmentation 3&apos; THEN [Segmentation_3]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Framework: Accionable&apos; THEN [Action_Item]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Must have partner&apos; THEN [Must_have_partner]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Commission Floor Compliance&apos; THEN [Commission_Floor_Compliance]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;First Date Online on Acquisition Month&apos; THEN [First_Date_Online_on_Acquisition_Month]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Acquisition Date&apos; THEN STR([Acquisition_Date])&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Firma T&amp;C&apos; THEN [Firma_TC]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Tier Orders M0: 0-30&apos; THEN [Tier_Orders_M0]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Tier Orders M1: 31-60&apos; THEN [Tier_Orders_M1]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Tier Orders M2: 61-90&apos; THEN [Tier_Orders_M2]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Tier Orders M3: 91-120&apos; THEN [Tier_Orders_M3]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Tier Orders M6: 181-210&apos; THEN [Tier_Orders_M6]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Targeted Acquisition&apos; THEN [Targeted_Acquisition]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Seller&apos; THEN [Seller]&#13;&#10;END' />
