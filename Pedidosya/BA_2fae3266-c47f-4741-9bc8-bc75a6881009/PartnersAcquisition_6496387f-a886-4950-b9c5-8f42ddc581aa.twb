      <column caption='Frecuencia Plus By Partner' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frecuencia Plus (copia)_1171780334568435760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PLUS_ORDERS])/SUM([PLUS_USERS])' />
      </column>
      <column caption='Frecuencia Plus By Partner (copia)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frecuencia Plus By Partner (copia)_1171780334570135602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [PARTNER],[COUNTRY],[PARTNER_STATUS]:[Frecuencia Plus (copia)_1171780334568435760]})' />
