            <column caption='Penetracion Est. Chart' datatype='real' default-format='p0.0%' name='[Penetracion Est. (copia)_1499135733777834012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Penetración With Real - PO (copia)_1499135733779165213])/AVG([Penetración - PO Chart (copia)_1499135733779718174])' />
            </column>
            <column caption='Penetración - TO Chart' datatype='integer' name='[Penetración - PO Chart (copia)_1499135733779718174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  true&#13;&#10;and [Calculation_1499135732814716941]=0&#13;&#10;then [Penetración With Simulation TO (copia)_385057776360402947]&#13;&#10;ELSEIF TRUE&#13;&#10;    AND [Calculation_1499135732814716941]&lt;&gt;0&#13;&#10;then [TOTAL_ORDERS]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Penetración - PO Chart' datatype='real' default-format='n#,##0;-#,##0' name='[Penetración With Real - PO (copia)_1499135733779165213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  true&#13;&#10;AND [Calculation_1499135732814716941]=0&#13;&#10;then [Penetración With Simulation PO (copia)_385057776360628228]&#13;&#10;ELSEIF TRUE&#13;&#10;    AND [Calculation_1499135732814716941]&lt;&gt;0&#13;&#10;THEN [Calculation_1499135732814716941]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Penetración With Simulation PO (Chart)' datatype='integer' name='[Penetración With Simulation PO (copia)_385057776360628228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//if  true&#13;&#10;//and [Months to Estimate]&#13;&#10;//then [Penetration Estimated]&#13;&#10;//else 0&#13;&#10;//END&#13;&#10;&#13;&#10;ZN({FIXED DATETRUNC(&apos;month&apos;, [MONTH]):&#13;&#10;SUM(IF 1=1&#13;&#10;    AND [Calculation_1499135732814716941]=0&#13;&#10;    AND [COUNTRY]=[CATEGORIA Selector (copia)_1171780334121426971] &#13;&#10;    AND [CATEGORIA]=[Calculation_1171780334120214553]&#13;&#10;    AND [Partner_Segment]=[CATEGORIA Selector (copia)_1171780334120390682]&#13;&#10;    AND [VERTICAL]=[Calculation_1171780334120030232]&#13;&#10;    AND [PARTNER_STATUS]=[Calculation_1171780334169763869]&#13;&#10;    AND [PARTNER]=[CATEGORIA Selector (copia)_1171780334543286317]&#13;&#10;THEN [PLUS_ORDERS] END)})' />
            </column>
            <column caption='Penetración With Simulation TO (Chart)' datatype='integer' name='[Penetración With Simulation TO (copia)_385057776360402947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//if  true&#13;&#10;//and [Months to Estimate]&#13;&#10;//then [Penetration Estimated]&#13;&#10;//else 0&#13;&#10;//END&#13;&#10;&#13;&#10;ZN({FIXED DATETRUNC(&apos;month&apos;, [MONTH]):&#13;&#10;SUM(IF 1=1&#13;&#10;    AND [Calculation_1499135732814716941]=0&#13;&#10;    AND [COUNTRY]=[CATEGORIA Selector (copia)_1171780334121426971] &#13;&#10;    AND [CATEGORIA]=[Calculation_1171780334120214553]&#13;&#10;    AND [Partner_Segment]=[CATEGORIA Selector (copia)_1171780334120390682]&#13;&#10;    AND [VERTICAL]=[Calculation_1171780334120030232]&#13;&#10;    AND [PARTNER_STATUS]=[Calculation_1171780334169763869]&#13;&#10;    AND [PARTNER]=[CATEGORIA Selector (copia)_1171780334543286317]&#13;&#10;THEN [TOTAL_ORDERS] END)})' />
            </column>
            <column caption='Penetration Estimated Chart' datatype='real' default-format='p0.0%' name='[Penetration Estimated (copia)_1499135733781254175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='({FIXED DATETRUNC(&apos;month&apos;, [MONTH]):&#13;&#10;SUM(IF 1=1&#13;&#10;    AND [COUNTRY]=[CATEGORIA Selector (copia)_1171780334121426971] &#13;&#10;    AND [CATEGORIA]=[Calculation_1171780334120214553]&#13;&#10;    AND [Partner_Segment]=[CATEGORIA Selector (copia)_1171780334120390682]&#13;&#10;    AND [VERTICAL]=[Calculation_1171780334120030232]&#13;&#10;    AND [PARTNER_STATUS]=[Calculation_1171780334169763869]&#13;&#10;    AND [PARTNER]=[CATEGORIA Selector (copia)_1171780334543286317]&#13;&#10;THEN [PLUS_ORDERS] END)&#13;&#10;/&#13;&#10;SUM(IF 1=1&#13;&#10;    AND [COUNTRY]=[CATEGORIA Selector (copia)_1171780334121426971] &#13;&#10;    AND [CATEGORIA]=[Calculation_1171780334120214553]&#13;&#10;    AND [Partner_Segment]=[CATEGORIA Selector (copia)_1171780334120390682]&#13;&#10;    AND [VERTICAL]=[Calculation_1171780334120030232]&#13;&#10;    AND [PARTNER_STATUS]=[Calculation_1171780334169763869]&#13;&#10;    AND [PARTNER]=[CATEGORIA Selector (copia)_1171780334543286317]&#13;&#10;THEN [TOTAL_ORDERS] END)&#13;&#10;})' />
            </column>
