      <column datatype='integer' name='[DF0_ORDERS_PLUS]' role='measure' type='quantitative' />
      <column datatype='real' name='[FULL_DF_COFUNDABLE_ORDERS]' role='measure' type='quantitative' />
      <column caption='Frecuencia Non Plus By Partner' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frecuencia Non Plus (copia)_1171780334568841265]' role='measure' type='quantitative'>
