              <calculation class='tableau' formula='(&#13;&#10;(AVG(IF [LM (copia)_1171780333796229124] THEN [PLUS_USERS_FRANCHISE] END) / AVG(IF [LM (copia)_1171780333796229124] THEN [TOTAL_USERS_FRANCHISE] END)) &#13;&#10;-&#13;&#10;(AVG(IF [Calculation_1171780333790744578] THEN [PLUS_USERS_FRANCHISE] END) / AVG(IF [Calculation_1171780333790744578] THEN [TOTAL_USERS_FRANCHISE] END))&#13;&#10;)&#13;&#10;*100' />
