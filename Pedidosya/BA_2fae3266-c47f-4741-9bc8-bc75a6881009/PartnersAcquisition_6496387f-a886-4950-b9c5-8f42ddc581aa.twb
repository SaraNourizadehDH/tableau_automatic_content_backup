                </zone>
                <zone fixed-size='118' forceUpdate='true' h='5619' id='143' type-v2='text' w='95455' x='1364' y='71141'>
                  <formatted-text>
                    <run bold='true' italic='true'>Incremental Orders = </run>
                    <run italic='true'>Órdenes estimadas según selección en Incremental Orders Simulator</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Pérdida Facturación =</run>
                    <run italic='true'> Ticket Promedio * Ordenes Incrementales Estimadas</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Inversión Plus =</run>
                    <run italic='true'> (Plus Orders +  Ordenes Incrementales Estimadas) * Delivery Fee promedio * Partner Fee  -&gt; parámetro a completar</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Beneficio Bruto = </run>
                    <run italic='true'>Pérdida Facturación - Inversión Plus</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>% GFV =</run>
                    <run italic='true'>  Inversión Plus / GFV Total</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
