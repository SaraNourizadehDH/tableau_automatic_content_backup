            <column caption='VERTICAL Selector' datatype='string' name='[Calculation_1171780334120030232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[VERTICAL Parámetro]=&apos;ALL&apos; THEN [VERTICAL] ELSE [Parameters].[VERTICAL Parámetro] END' />
            </column>
            <column caption='CATEGORIA Selector' datatype='string' name='[Calculation_1171780334120214553]' role='dimension' type='nominal'>
