          <datasource-dependencies datasource='federated.0pzigxz1w4h59112hdkoz0ug2yjl'>
            <column caption='PARTNER SEGMENT Selector' datatype='string' name='[CATEGORIA Selector (copia)_1171780334120390682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Partner_Segment Parámetro]=&apos;ALL&apos; THEN [Partner_Segment] ELSE [Parameters].[Partner_Segment Parámetro] END' />
