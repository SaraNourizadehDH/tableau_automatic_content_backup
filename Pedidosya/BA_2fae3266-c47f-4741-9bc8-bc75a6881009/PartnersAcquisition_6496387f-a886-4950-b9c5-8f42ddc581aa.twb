            <column caption='Penetration Estimated' datatype='real' default-format='p0.0%' name='[Calculation_1171780334117031959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//({FIXED DATETRUNC(&apos;month&apos;, [MONTH]):&#13;&#10;//SUM(IF 1=1&#13;&#10;//    AND [COUNTRY]=[COUNTRY Selector] &#13;&#10;//    AND [CATEGORIA]=[CATEGORIA Selector]&#13;&#10;//    AND [Partner_Segment]=[PARTNER SEGMENT Selector]&#13;&#10;//    AND [VERTICAL]=[VERTICAL Selector]&#13;&#10;//    AND [PARTNER_STATUS]=[PARTNER_STATUS Selector]&#13;&#10;//    AND [PARTNER]=[PARTNER Selector ]&#13;&#10;//THEN [PLUS_ORDERS] END)&#13;&#10;///&#13;&#10;//SUM(IF 1=1&#13;&#10;//    AND [COUNTRY]=[COUNTRY Selector] &#13;&#10;//    AND [CATEGORIA]=[CATEGORIA Selector]&#13;&#10;//    AND [Partner_Segment]=[PARTNER SEGMENT Selector]&#13;&#10;//    AND [VERTICAL]=[VERTICAL Selector]&#13;&#10;//    AND [PARTNER_STATUS]=[PARTNER_STATUS Selector]&#13;&#10;//    AND [PARTNER]=[PARTNER Selector ]&#13;&#10;//THEN [TOTAL_ORDERS] END)&#13;&#10;//})&#13;&#10;[Calculation_1499135732829499417]' />
            </column>
            <column caption='VERTICAL Selector' datatype='string' name='[Calculation_1171780334120030232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[VERTICAL Parámetro]=&apos;ALL&apos; THEN [VERTICAL] ELSE [Parameters].[VERTICAL Parámetro] END' />
