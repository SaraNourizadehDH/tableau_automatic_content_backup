            <column caption='Penetracion Est.' datatype='real' default-format='p0.0%' name='[Calculation_1499135732829499417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1499135732829077526]/[Penetracion Est. PO (copia)_1499135732829331479]' />
