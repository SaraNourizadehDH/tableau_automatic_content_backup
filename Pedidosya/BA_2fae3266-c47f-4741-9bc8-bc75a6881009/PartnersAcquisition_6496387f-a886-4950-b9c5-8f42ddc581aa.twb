      <column caption='Frecuencia Non Plus' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frecuencia Plus (copia)_1171780334454288428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NON_PLUS_ORDERS])/AVG([NON_PLUS_USERS_FRANCHISE])' />
