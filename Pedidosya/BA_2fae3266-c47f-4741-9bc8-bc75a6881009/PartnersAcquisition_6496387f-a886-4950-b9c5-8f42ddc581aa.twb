            <column caption='PARTNER Selector ' datatype='string' name='[CATEGORIA Selector (copia)_1171780334543286317]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[PARTNER Parámetro] = &apos;&apos; THEN [PARTNER] ELSE [Parameters].[PARTNER Parámetro] END' />
