      <column caption='GFV GROSS TOTAL' datatype='real' default-format='c&quot;$ &quot;#,##0,.0K;-&quot;$ &quot;#,##0,.0K' name='[GFV GROSS TOTAL  (copia)_1499135733783912484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [Calculation_1171780334191280160], [COUNTRY], [PARTNER], [PARTNER_STATUS]:SUM(if [Calculation_1171780334190645279] then [GFV_GROSS] end)}' />
      </column>
      <column caption='% GFV TOTAL ' datatype='real' default-format='p0.00%' name='[GFV GROSS TOTAL (copia)_463870769457614848]' role='measure' type='quantitative'>
