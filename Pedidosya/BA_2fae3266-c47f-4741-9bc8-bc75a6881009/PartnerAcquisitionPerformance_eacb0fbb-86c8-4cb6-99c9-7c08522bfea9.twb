        <objects>
          <object caption='Consulta SQL personalizada' id='_E891339AA11D4830B3F3F8F5CBD03E77'>
            <properties context=''>
              <relation connection='bigquery.0vtcaa806a8nyd11b4is510dl13q' name='Consulta SQL personalizada' type='text'>SELECT &#13;
su.Country,&#13;
su.Company_Name,&#13;
su.Entity,&#13;
su.CountryCode,&#13;
su.Id,&#13;
su.Alias,&#13;
su.Title,&#13;
su.Name,&#13;
su.Central_Job_Role,&#13;
su.CreatedDate,&#13;
su.LastModifiedDate,&#13;
su.LastLoginDate,&#13;
su.IsActive,&#13;
DATE_TRUNC(date(su.CreatedDate),MONTH) AS Created_month&#13;
 FROM `peya-data-origins-pro.cl_salesforce.user` as su&#13;
 JOIN `peya-bi-tools-pro.il_core.dim_country` as dc&#13;
    ON dc.country_name_en=su.country&#13;
WHERE DATE_TRUNC(DATE(_ingested_at),MONTH) = DATE_TRUNC(CURRENT_DATE(),MONTH) &#13;
AND Company_Name = &quot;PY&quot;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
