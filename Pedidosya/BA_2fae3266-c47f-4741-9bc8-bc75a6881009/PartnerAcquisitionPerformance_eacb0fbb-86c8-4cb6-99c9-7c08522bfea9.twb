        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1e21rp10ri2d0a128fit70z5ayrg'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='user_matias_pita' server='' server-oauth='' username='matias.pita@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
