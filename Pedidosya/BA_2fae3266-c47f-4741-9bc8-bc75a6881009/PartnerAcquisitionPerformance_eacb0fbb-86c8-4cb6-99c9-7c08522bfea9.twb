      <aliases enabled='yes' />
      <column caption='#Sales Rep' datatype='integer' name='[Calculation_112871487713476611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Sales_Rep])' />
      </column>
      <column caption='Productivity' datatype='real' name='[Calculation_112871487713976324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_435160334636273664] / [Sales_Rep]' />
      </column>
      <column caption='Fixed Sales Rep' datatype='integer' name='[Calculation_112871487717425157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [country_name] : MAX([Sales_Rep]) }' />
      </column>
      <column caption='Fixed productivity' datatype='real' name='[Calculation_112871487717818374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_435160334636273664] / [Calculation_112871487718789127]' />
      </column>
      <column caption='Include sales rep' datatype='integer' name='[Calculation_112871487718789127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [country_name],[dim_month] : MAX([Sales_Rep]) }' />
      </column>
      <column caption='Productivity 2' datatype='real' name='[Calculation_112871487996629002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_435160334636273664] / [Calculation_112871487717425157]' />
      </column>
      <column caption='Productivity 3' datatype='real' name='[Calculation_112871487996956683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [country_name] : SUM([Calculation_435160334636273664])} / { INCLUDE [country_name] : MAX([Sales_Rep])}' />
      </column>
      <column caption='Fixed total new' datatype='integer' name='[Calculation_112871488407343117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [dim_month], [Account_Source], [Calculation_435160334646165511], [business_type_name] : SUM([Calculation_435160334636273664])}' />
      </column>
      <column caption='Share' datatype='real' name='[Calculation_112871488407801870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_435160334636273664]) / SUM([Calculation_112871488407343117])' />
      </column>
      <column caption='Total new' datatype='integer' name='[Calculation_435160334636273664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[new_online]+[Winbacks]' />
      </column>
      <column caption='Short_Source' datatype='string' name='[Calculation_435160334638149636]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Account_Source] = &quot;Self Sign Up&quot; THEN &quot;Self Sign Up&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Inbound&quot; THEN &quot;Inbound&quot;              &#13;&#10;ELSE &quot;Field Sales Representative&quot;&#13;&#10;END' />
      </column>
      <column caption='Fixed Source' datatype='string' name='[Calculation_435160334640484358]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Account_Source] = &quot;IMPORT&quot; THEN &quot;Import&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Import&quot; THEN &quot;Import&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Cloned&quot; THEN &quot;Cloned&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Automated LeadGen&quot; THEN &quot;Automated LeadGen&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Busqueda Propia&quot; THEN &quot;Own Research&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Busqueda Propia&quot; THEN &quot;Own Research&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Own Research&quot; THEN &quot;Own Research&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Self Sign Up&quot; THEN &quot;Self Sign Up&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Other&quot; THEN &quot;Other&quot;&#13;&#10;ELSEIF [Account_Source] = &quot;Inbound&quot; THEN &quot;Inbound&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Vertical' datatype='string' name='[Calculation_435160334646165511]' role='dimension' type='nominal'>
