      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_4D7EA9BB2A52416C928B2928C45BFC46'>
            <properties context=''>
              <relation connection='bigquery.1e21rp10ri2d0a128fit70z5ayrg' name='Consulta SQL personalizada' type='text'><![CDATA[WITH    dates AS (      
        SELECT 
        DATE_TRUNC(date(date),month) AS dim_month,
        FROM 
        `peya-bi-tools-pro.il_core.dim_date` 
        WHERE DATE_TRUNC(date(date),month) >>= DATE_TRUNC(date("2021-01-01"),month)
        AND DATE_TRUNC(date(date),month) <<= DATE_TRUNC(current_date(),month)
        GROUP BY 1
  ),
  business AS (SELECT business_type_name
 FROM `peya-bi-tools-pro.il_core.dim_business_type`
 GROUP BY 1),
  
  AccountSource AS(SELECT
	        IFNULL(a.AccountSource,"Other") as Account_Source,
	    FROM `peya-bi-tools-pro.il_core.fact_partners_monthly` pm
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p 
    ON 	pm.restaurant_id=p.partner_id	
 LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON p.salesforce_id=a.GRID
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc
        ON dc.country_id = pm.country_id 
       AND dc.active
WHERE DATE(pm.full_date) >>= "2021-01-01"
AND DATE(pm.full_date) <<=CURRENT_DATE()
GROUP BY 1
 ),

 Countries AS (
    SELECT country_name
 FROM `peya-bi-tools-pro.il_core.dim_country` 
 WHERE country_name NOT IN ("Puerto Rico","México","Unknown","Brasil","Colombia")
 GROUP BY 1
 ),

closedwon AS (SELECT  DATE_TRUNC(DATE(op.closedate),MONTH) AS date_month,
                    dc.country_id,
                    dc.country_name,
                    p.business_type.business_type_name AS business_type,
                    IFNULL(a.AccountSource,"Other") as Account_Source,
                    COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "New Business" THEN  op.salesforce_id ELSE NULL END) AS New_closed_won,
                    COUNT(DISTINCT CASE WHEN op.StageName = "Closed Won"AND op.Business_Type = "Win Back" THEN  op.salesforce_id ELSE NULL END) AS Winbacks
            FROM  `peya-data-origins-pro.cl_salesforce.opportunity` op
            LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON a.Id=op.AccountId
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc ON a.Account_Country_Code =dc.country_code
            LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p ON p.salesforce_id=a.GRID
            WHERE DATE(op.closedate) >>= "2021-01-01"
            AND DATE(op.closedate) <<=CURRENT_DATE()
            GROUP BY 1,2,3,4,5
    ),
    newonline AS(SELECT
	DATE_TRUNC(DATE(pm.full_date),MONTH) AS month,
        dc.country_name AS country_name,
        p.business_type.business_type_name AS business_type,
        IFNULL(a.AccountSource,"Other") as Account_Source,
	COUNT(DISTINCT CASE WHEN pm.is_new_online THEN pm.restaurant_id END) AS new_online
    
FROM `peya-bi-tools-pro.il_core.fact_partners_monthly` pm
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p 
    ON 	pm.restaurant_id=p.partner_id	
 LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` a ON p.salesforce_id=a.GRID
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc
        ON dc.country_id = pm.country_id 
       AND dc.active
WHERE DATE(pm.full_date) >>= "2021-01-01"
AND DATE(pm.full_date) <<=CURRENT_DATE()
GROUP BY 1,2,3,4
ORDER BY 1 DESC, 2
    ),


    Sellers AS (

WITH dates AS (      
        SELECT 
        DATE_TRUNC(date(date),month) AS dim_month,
        FROM 
        `peya-bi-tools-pro.il_core.dim_date` 
        WHERE DATE_TRUNC(date(date),month) >>= DATE_TRUNC(date("2021-01-01"),month)
        AND DATE_TRUNC(date(date),month) <<= DATE_TRUNC(current_date(),month)
        GROUP BY 1
  ),
  Sellers AS (SELECT 
dc.country_name as country,
u.Id,
u.Alias,
u.Title,
u.Name,
u.CreatedDate,
u.LastModifiedDate,
u.LastLoginDate
FROM `peya-data-origins-pro.cl_salesforce.user` u
LEFT JOIN   `peya-bi-tools-pro.il_core.dim_country` dc
ON u.Country=dc.country_name_en
WHERE DATE_TRUNC(DATE(_ingested_at),MONTH) = DATE_TRUNC(CURRENT_DATE(),MONTH) 
AND Entity = "UY Pedidosya"
AND Title IN ("Sales  Executive",
"Sales Executive",
"Sales Executive Senior",
"Sales Executive Specialist",
"Sales Executive Sr",
"Sales Sr Executive") OR Alias IN ("ccort",
"pvill",
"FBarr",
"VDoua",
"MGodo"))



SELECT 
d.*,
s.country,
COUNT(DISTINCT s.Id) as Sales_Rep

FROM dates AS d 
JOIN Sellers AS s   
ON d.dim_month >> date_trunc(date(s.CreatedDate),MONTH)
AND d.dim_month <<= date_trunc(date(s.LastLoginDate),MONTH)
GROUP BY 1,2
ORDER BY 1,2

    )

SELECT
d.*,
c.*,
b.*,
a.*,
cw.New_closed_won,
cw.Winbacks,
nw.new_online,
se.Sales_Rep,
current_date() AS last_update
FROM dates  AS d 
CROSS JOIN Countries AS c
CROSS JOIN business AS b
CROSS JOIN AccountSource AS a
LEFT JOIN closedwon AS cw 
ON cw.date_month=d.dim_month AND cw.country_name=c.country_name AND cw.business_type=b.business_type_name AND cw.Account_Source=a.Account_Source
LEFT JOIN newonline AS nw 
ON nw.month=d.dim_month AND nw.country_name=c.country_name AND nw.business_type=b.business_type_name AND nw.Account_Source=a.Account_Source
LEFT JOIN Sellers AS se 
ON se.dim_month=d.dim_month AND se.country=c.country_name]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Consulta SQL personalizada (user_matias_pita) (2)' inline='true' name='federated.0ma56di1ywr3sr0zxknj2028e1gw' version='18.1'>
