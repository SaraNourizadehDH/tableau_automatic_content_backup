              <calculation class='tableau' formula='IF CONTAINS([Subject],&quot;down&quot;) OR CONTAINS([Subject],&quot;Down&quot;)&#13;&#10;THEN &quot;Downgrade&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;legal&quot;) OR CONTAINS([Subject],&quot;Legal&quot;)&#13;&#10;THEN &quot;Legal form change&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;new&quot;) OR CONTAINS([Subject],&quot;New&quot;)&#13;&#10;THEN &quot;New Business&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;owner&quot;) OR CONTAINS([Subject],&quot;Owner&quot;)&#13;&#10;THEN &quot;Owner Change&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;switch&quot;) OR CONTAINS([Subject],&quot;Switch&quot;)&#13;&#10;THEN &quot;Switch&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;up&quot;) OR CONTAINS([Subject],&quot;Up&quot;)&#13;&#10;THEN &quot;Upgrade / Upsell&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;win&quot;) OR CONTAINS([Subject],&quot;Win&quot;)&#13;&#10;THEN &quot;Win Back&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
            </column>
