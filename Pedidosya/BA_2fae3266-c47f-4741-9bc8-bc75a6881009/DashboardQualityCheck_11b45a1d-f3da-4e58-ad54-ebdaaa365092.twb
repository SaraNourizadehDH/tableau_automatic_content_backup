        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.11984ec02b8ip518omv1l18wdqi5' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
        user_name as User,
        country_name as Country,
        DATE_TRUNC(create_date, DAY) AS Creation_date,
        DATE_TRUNC(closed_date, DAY) AS Close_date,
        closed_reason as Resolution,
        case_origin as Origin,
        case_subjec as Subject,
        case_type as Type,
        date_diff(closed_date, create_date, HOUR) as SLA,
        GRID,
	created_by_name as Owner,
        _ingested_at as data_up_to
    FROM
    peya-bi-tools-pro.il_salesforce.fact_salesforce_cases 
    WHERE
    case_type = "Quality Check" OR (case_type = "Sales Task" AND case_reason = "Clone Request")
    AND record_type_name = "PY Internal Case"
    AND case_status = "Closed"
    AND country_name <<>> "Colombia"
    AND create_date >>= "2021-01-01"]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
