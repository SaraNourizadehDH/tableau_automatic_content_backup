        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1nkfv0f0kisc2y1du2fhj1v2lnmw' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
        created_by_name as User,
        country_name as Country,
        DATE_TRUNC(create_date, DAY) AS Creation_date,
