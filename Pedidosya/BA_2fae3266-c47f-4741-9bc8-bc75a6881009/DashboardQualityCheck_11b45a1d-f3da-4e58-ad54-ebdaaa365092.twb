      <column caption='SLA (días)' datatype='real' name='[Calculation_1512365084244205568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SLA]/24' />
      </column>
      <column caption='Asunto' datatype='string' name='[Calculation_1512365084567552016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Subject],&quot;down&quot;) OR CONTAINS([Subject],&quot;Down&quot;)&#13;&#10;THEN &quot;Downgrade&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;legal&quot;) OR CONTAINS([Subject],&quot;Legal&quot;)&#13;&#10;THEN &quot;Legal form change&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;new&quot;) OR CONTAINS([Subject],&quot;New&quot;)&#13;&#10;THEN &quot;New Business&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;owner&quot;) OR CONTAINS([Subject],&quot;Owner&quot;)&#13;&#10;THEN &quot;Owner Change&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;switch&quot;) OR CONTAINS([Subject],&quot;Switch&quot;)&#13;&#10;THEN &quot;Switch&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;up&quot;) OR CONTAINS([Subject],&quot;Up&quot;)&#13;&#10;THEN &quot;Upgrade / Upsell&quot;&#13;&#10;ELSEIF CONTAINS([Subject],&quot;win&quot;) OR CONTAINS([Subject],&quot;Win&quot;)&#13;&#10;THEN &quot;Win Back&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
      </column>
      <column caption='Net SLA' datatype='integer' name='[Calculation_1512365084620062738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISOWEEKDAY([Close_date]) = 1 AND ISOWEEKDAY([Creation_date])&gt;=5&#13;&#10;THEN [SLA]-48&#13;&#10;ELSE [SLA]&#13;&#10;END' />
      </column>
      <column caption='Fallido' datatype='integer' name='[Calculation_1512365084639694867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Resolution] = &quot;Not Successful&quot;,1,NULL)' />
      </column>
      <column datatype='date' datatype-customized='true' name='[Close_date]' role='dimension' type='ordinal' />
      <column caption='País' datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
