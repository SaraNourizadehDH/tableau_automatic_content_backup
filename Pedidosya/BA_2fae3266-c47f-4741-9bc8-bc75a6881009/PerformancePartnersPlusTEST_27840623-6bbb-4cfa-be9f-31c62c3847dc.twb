          <zone h='5455' id='28' name='Financials Table' show-title='false' w='95000' x='1818' y='45143'>
            <layout-cache cell-count-h='6' non-cell-size-h='20' type-h='cell' type-w='fixed' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='128' forceUpdate='true' h='3886' id='57' is-fixed='true' type-v2='text' w='95000' x='1818' y='50598'>
            <formatted-text>
              <run bold='true' italic='true'>Órdenes Incrementales:</run>
              <run italic='true'> debido al aumento de frecuencia generado en los usuarios que ya compraban (usuarios frecuentes) y la mayor frecuencia con la que adquiere nuevos usuarios comparado a los nuevos usuarios no suscritos de la marca (usuarios adquiridos)</run>
              <run>Æ&#10;</run>
              <run bold='true' italic='true'>Tickets Usuarios Plus:</run>
              <run italic='true'> Average Food Value, ticket promedio de usuarios Plus en la marca</run>
              <run>Æ&#10;</run>
              <run bold='true' italic='true'>Incremental GFV: </run>
              <run italic='true'>Gross Food Value, facturación incremental a partir de las órdenes incrementales por el ticket promedio</run>
              <run>Æ&#10;</run>
              <run bold='true' italic='true'>Inversión Plus:</run>
              <run italic='true'> inversión de la marca que resulta del Partner Fee por las órdenes Plus</run>
              <run>Æ&#10;</run>
              <run bold='true' italic='true'>Inversión / GFV:</run>
              <run italic='true'> cuanto representa la inversión de Plus sobre el total de la facturación de la marca</run>
              <run>Æ&#10;</run>
              <run bold='true' italic='true'>ROI: </run>
              <run italic='true'>retorno sobre inversión: (Incremental GFV - Inversión Plus) / Inversión Plus</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
