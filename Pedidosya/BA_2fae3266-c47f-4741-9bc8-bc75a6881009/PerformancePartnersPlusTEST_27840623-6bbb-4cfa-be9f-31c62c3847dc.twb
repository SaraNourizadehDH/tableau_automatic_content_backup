                <zone fixed-size='201' h='19000' id='50' is-fixed='true' name='Tabla' show-title='false' w='36500' x='62700' y='61545'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
