              <calculation class='tableau' formula='if  true&#13;&#10;and NOT [Calculation_1171780334190645279]&#13;&#10;then [PLUS_ORDERS]&#13;&#10;ELSEIF TRUE&#13;&#10;    AND [Calculation_1171780334190645279]&#13;&#10;    AND [Calculation_1499135732814716941]&lt;&gt;0&#13;&#10;THEN [Calculation_1499135732814716941]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Penetración With Simulation PO' datatype='integer' name='[Penetración With Simulation (copia)_1499135732824018963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//if  true&#13;&#10;//and [Months to Estimate]&#13;&#10;//then [Penetration Estimated]&#13;&#10;//else 0&#13;&#10;//END&#13;&#10;&#13;&#10;ZN({FIXED DATETRUNC(&apos;month&apos;, [MONTH]):&#13;&#10;SUM(IF 1=1&#13;&#10;    AND [Calculation_1171780334190645279]&#13;&#10;    AND [Calculation_1499135732814716941]=0&#13;&#10;    AND [COUNTRY]=[CATEGORIA Selector (copia)_1171780334121426971] &#13;&#10;    AND [CATEGORIA]=[Calculation_1171780334120214553]&#13;&#10;    AND [Partner_Segment]=[CATEGORIA Selector (copia)_1171780334120390682]&#13;&#10;    AND [VERTICAL]=[Calculation_1171780334120030232]&#13;&#10;    AND [PARTNER_STATUS]=[Calculation_1171780334169763869]&#13;&#10;    AND [FRANCHISE]=[CATEGORIA Selector (copia)_1171780334543286317]&#13;&#10;    AND [CITY]=[FRANCHISE Selector  (copia)_1274800181350064134]&#13;&#10;THEN [PLUS_ORDERS] END)})' />
