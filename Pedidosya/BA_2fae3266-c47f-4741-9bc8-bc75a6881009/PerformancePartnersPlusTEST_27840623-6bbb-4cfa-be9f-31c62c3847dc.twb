            <column caption='% NoN Plus Orders with Incentives ' datatype='real' default-format='p0.0%' name='[% Plus Orders with Incentives (copia)_1461136619777785856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_plus_orders_w_incentive])/SUM([non_plus_orders])' />
            </column>
            <column caption='% Orders PS' datatype='real' default-format='p0.0%' name='[Calculation_1115766823025659904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PLUS_ORDERS_SUBSIDED_BY_PARTNER])/SUM([plus_orders])' />
            </column>
            <column caption='Plus Incentive per Order Plus' datatype='real' name='[Calculation_1847038812535156736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plus_incentives])/SUM([plus_orders])' />
            </column>
            <column caption='Basket Incentives Per Order Plus' datatype='real' name='[Calculation_1847038812535504897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([basket_incentives])/SUM([plus_orders])' />
            </column>
            <column caption='% Plus Orders with Incentives' datatype='real' default-format='p0.0%' name='[Calculation_1847038812545777669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plus_orders_w_incentive])/SUM([plus_orders])' />
