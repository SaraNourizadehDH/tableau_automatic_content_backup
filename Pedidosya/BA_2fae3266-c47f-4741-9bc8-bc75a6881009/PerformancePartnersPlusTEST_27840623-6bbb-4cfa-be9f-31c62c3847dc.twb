                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone fixed-size='99' h='3058' id='285' is-fixed='true' name='TABLE Summary - RET' show-title='false' w='17908' x='78728' y='91287'>
                  <layout-cache type-h='cell' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
