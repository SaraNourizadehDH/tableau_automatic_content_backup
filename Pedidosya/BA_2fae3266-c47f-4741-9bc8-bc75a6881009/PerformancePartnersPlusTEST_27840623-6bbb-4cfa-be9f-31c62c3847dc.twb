                </zone>
                <zone fixed-size='76' forceUpdate='true' h='2400' id='107' type-v2='text' w='48909' x='2000' y='32429'>
                  <formatted-text>
                    <run italic='true'>Estima órdenes incrementales según la penetración estimada en el Simulador de la derecha.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Seleccionar los meses a simular en los círculos azules.</run>
                    <run italic='true'> Arriba se puede filtrar por status del Partner.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Para deseleccionar utilizar el botón RESET</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='53' forceUpdate='true' h='1743' id='106' type-v2='text' w='47182' x='51000' y='32659'>
                  <formatted-text>
                    <run italic='true'>Permite obtener una penetración de órdenes plus basado en los filtros seleccionados. </run>
                    <run>Æ&#10;</run>
                    <run italic='true'>Tener en cuenta que para el filtro Partner se debe ingresar exactamente el nombre (key-sensitive).</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='1172' id='142' type-v2='text' w='95455' x='2091' y='34857'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='12'>Estimación Órdenes e Inversión Plus</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#0097a71b' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='8599' id='30' is-fixed='true' name='TABLE' show-title='false' w='77545' x='2455' y='36143'>
                  <layout-cache type-h='cell' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#0097a7' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone custom-title='true' fixed-size='46' h='1543' id='54' mode='type_in' param='[Parameters].[Parámetro 1]' type-v2='paramctrl' w='16090' x='80546' y='36314'>
                  <formatted-text>
                    <run fontalignment='1'>Partner Fee (%DF)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='2' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone fixed-size='131' h='3972' id='254' is-fixed='true' name='TABLE (2)' show-title='false' w='16090' x='80546' y='37857'>
                  <layout-cache type-h='cell' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='86' h='2742' id='255' is-fixed='true' name='TABLE (3)' show-title='false' w='16090' x='80546' y='41829'>
                  <layout-cache cell-count-h='1' non-cell-size-h='44' type-h='cell' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#0097a7' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='117' forceUpdate='true' h='3343' id='143' type-v2='text' w='95455' x='2091' y='44856'>
                  <formatted-text>
                    <run bold='true' italic='true'>Órdenes Incrementales = </run>
                    <run italic='true'>Órdenes estimadas según selección en Incremental Orders Simulator</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Pérdida Facturación =</run>
                    <run italic='true'> Ticket Promedio * Ordenes Incrementales Estimadas</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Inversión Plus =</run>
                    <run italic='true'>  Ördenes Plus (orgánicas + incrementales) * Delivery Fee promedio * Partner Fee  -&gt; parámetro a completar</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Beneficio Bruto = </run>
                    <run italic='true'>Facturación Incremental - Inversión Plus Estimada</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Inversión/Facturación =</run>
                    <run italic='true'>  cuanto representa la inversión sobre el total de la facturación de la marca</run>
                    <run>Æ&#10;</run>
                    <run bold='true' italic='true'>Partner Fee = % del Delivery Fee que pagaría la marca (deafult 50%, utilizar &quot;,&quot;)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='1172' id='147' type-v2='text' w='94727' x='2364' y='48229'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='12'>Frecuencia de Usuarios en Sucursales Plus vs Non Plus</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#0097a71b' />
                  </zone-style>
                </zone>
                <zone fixed-size='268' h='7884' id='50' is-fixed='true' name='Evolutivo Frecuencia' show-title='false' w='94727' x='2364' y='49401'>
                  <layout-cache minheight='150' type-h='scalable' type-w='fixed' />
