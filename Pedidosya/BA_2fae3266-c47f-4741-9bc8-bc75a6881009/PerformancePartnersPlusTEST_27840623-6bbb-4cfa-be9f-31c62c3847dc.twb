            <column caption='M-2' datatype='real' default-format='p0.0%' name='[M-3 (copia)_1499135732817022990]' param-domain-type='any' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
            </column>
            <column caption='M-4' datatype='real' default-format='p0.0%' name='[M1 (copia)_1499135732814049291]' param-domain-type='any' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
            </column>
            <column caption='M-3' datatype='real' default-format='p0.0%' name='[M2 (copia)_1499135732814077964]' param-domain-type='any' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
            </column>
            <column caption='FRANCHISE Parámetro' datatype='string' name='[PARTNER Parámetro]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='PARTNER_STATUS Parámetro' datatype='string' name='[PARTNER_STATUS Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;Partner Plus&quot;'>
              <calculation class='tableau' formula='&quot;Partner Plus&quot;' />
            </column>
            <column caption='Partner_Segment Parámetro' datatype='string' name='[Partner_Segment Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;ALL&quot;'>
              <calculation class='tableau' formula='&quot;ALL&quot;' />
            </column>
            <column caption='Partner Fee' datatype='real' name='[Parámetro 1]' param-domain-type='any' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
            </column>
            <column caption='M-5' datatype='real' default-format='p0.0%' name='[VERTICAL Parámetro (copia)]' param-domain-type='any' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
            </column>
            <column caption='VERTICAL Parámetro' datatype='string' name='[VERTICAL Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;FOOD&quot;'>
              <calculation class='tableau' formula='&quot;FOOD&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0pzigxz1w4h59112hdkoz0ug2yjl'>
            <column caption='PARTNER SEGMENT Selector' datatype='string' name='[CATEGORIA Selector (copia)_1171780334120390682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Partner_Segment Parámetro]=&apos;ALL&apos; THEN [Partner_Segment] ELSE [Parameters].[Partner_Segment Parámetro] END' />
            </column>
            <column caption='COUNTRY Selector' datatype='string' name='[CATEGORIA Selector (copia)_1171780334121426971]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[COUNTRY Parámetro]=&apos;ALL&apos; THEN [COUNTRY] ELSE [Parameters].[COUNTRY Parámetro] END' />
            </column>
            <column caption='FRANCHISE Selector ' datatype='string' name='[CATEGORIA Selector (copia)_1171780334543286317]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[PARTNER Parámetro] = &apos;&apos; THEN [FRANCHISE] ELSE [Parameters].[PARTNER Parámetro] END' />
            </column>
            <column datatype='string' name='[CATEGORIA]' role='dimension' type='nominal' />
            <column datatype='string' name='[CITY]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[COFUNDABLE_ORDERS]' role='measure' type='quantitative' />
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Penetracion Plus Orders' datatype='real' default-format='p0.0%' name='[Calculation_1171780333788614657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PLUS_ORDERS])/SUM([TOTAL_ORDERS])' />
            </column>
            <column caption='Penetration Estimated' datatype='real' default-format='p0.0%' name='[Calculation_1171780334117031959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//({FIXED DATETRUNC(&apos;month&apos;, [MONTH]):&#13;&#10;//SUM(IF 1=1&#13;&#10;//    AND [COUNTRY]=[COUNTRY Selector] &#13;&#10;//    AND [CATEGORIA]=[CATEGORIA Selector]&#13;&#10;//    AND [Partner_Segment]=[PARTNER SEGMENT Selector]&#13;&#10;//    AND [VERTICAL]=[VERTICAL Selector]&#13;&#10;//    AND [PARTNER_STATUS]=[PARTNER_STATUS Selector]&#13;&#10;//    AND [PARTNER]=[PARTNER Selector ]&#13;&#10;//THEN [PLUS_ORDERS] END)&#13;&#10;///&#13;&#10;//SUM(IF 1=1&#13;&#10;//    AND [COUNTRY]=[COUNTRY Selector] &#13;&#10;//    AND [CATEGORIA]=[CATEGORIA Selector]&#13;&#10;//    AND [Partner_Segment]=[PARTNER SEGMENT Selector]&#13;&#10;//    AND [VERTICAL]=[VERTICAL Selector]&#13;&#10;//    AND [PARTNER_STATUS]=[PARTNER_STATUS Selector]&#13;&#10;//    AND [PARTNER]=[PARTNER Selector ]&#13;&#10;//THEN [TOTAL_ORDERS] END)&#13;&#10;//})&#13;&#10;[Calculation_1499135732829499417]' />
            </column>
            <column caption='VERTICAL Selector' datatype='string' name='[Calculation_1171780334120030232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[VERTICAL Parámetro]=&apos;ALL&apos; THEN [VERTICAL] ELSE [Parameters].[VERTICAL Parámetro] END' />
            </column>
            <column caption='CATEGORIA Selector' datatype='string' name='[Calculation_1171780334120214553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[CATEGORIA Parámetro]=&apos;ALL&apos; THEN [CATEGORIA] ELSE [Parameters].[CATEGORIA Parámetro] END' />
            </column>
            <column caption='PARTNER_STATUS Selector' datatype='string' name='[Calculation_1171780334169763869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[PARTNER_STATUS Parámetro]=&apos;ALL&apos; THEN [PARTNER_STATUS] ELSE [Parameters].[PARTNER_STATUS Parámetro] END' />
            </column>
            <column caption='Months to Estimate' datatype='boolean' name='[Calculation_1171780334190645279]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1171780334191280160] IN [YearMonth conjunto]' />
            </column>
            <column caption='YearMonth' datatype='string' name='[Calculation_1171780334191280160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(year([MONTH]))+&apos;-&apos;+str(month([MONTH]))' />
            </column>
            <column caption='Orders Estimated' datatype='real' name='[Calculation_1171780334193975331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1171780334190645279] THEN [TOTAL_ORDERS] END) * (([Calculation_1171780334117031959])-[Calculation_1171780333788614657])' />
            </column>
            <column caption='DF prom' datatype='real' default-format='c&quot;$ &quot;#,##0.0;-&quot;$ &quot;#,##0.0' name='[Calculation_1171780334447910951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FULL_DF_COFUNDABLE_ORDERS])/SUM([COFUNDABLE_ORDERS])' />
            </column>
            <column caption='Inversión Plus' datatype='real' default-format='c&quot;$ &quot;#,##0,.0K;-&quot;$ &quot;#,##0,.0K' name='[Calculation_1171780334448050216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parámetro 1]*[Calculation_1171780334447910951]*([Calculation_1171780334193975331] +  SUM([PLUS_ORDERS]))' />
            </column>
            <column caption='ID- PARNTER' datatype='string' name='[Calculation_1473240039535722496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([ID]) + &apos; - &apos; + [PARTNER]' />
            </column>
            <column caption='Penetración With Parameter' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1499135732814716941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-6,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-0 (copia)_557601950506655744]&lt;&gt;0&#13;&#10;then [Parameters].[M-0 (copia)_557601950506655744]*[TOTAL_ORDERS]&#13;&#10;elseif  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-5,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[VERTICAL Parámetro (copia)]&lt;&gt;0&#13;&#10;then [Parameters].[VERTICAL Parámetro (copia)]*[TOTAL_ORDERS]&#13;&#10;elseif true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-4,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M1 (copia)_1499135732814049291]&lt;&gt;0&#13;&#10;then [Parameters].[M1 (copia)_1499135732814049291]*[TOTAL_ORDERS]&#13;&#10;elseif true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-3,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M2 (copia)_1499135732814077964]&lt;&gt;0&#13;&#10;then [Parameters].[M2 (copia)_1499135732814077964]*[TOTAL_ORDERS]&#13;&#10;ELSEIF  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-3 (copia)_1499135732817022990]&lt;&gt;0&#13;&#10;then [Parameters].[M-3 (copia)_1499135732817022990]*[TOTAL_ORDERS]&#13;&#10;ELSEIF  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-2 (copia)_1499135732817055759]&lt;&gt;0&#13;&#10;then [Parameters].[M-2 (copia)_1499135732817055759]*[TOTAL_ORDERS]&#13;&#10;ELSEIF  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-0,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-1 (copia)_1499135732817100816]&lt;&gt;0&#13;&#10;then [Parameters].[M-1 (copia)_1499135732817100816]*[TOTAL_ORDERS]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Penetracion Est. PO' datatype='real' name='[Calculation_1499135732829077526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Penetración With Simulation (copia)_1499135732824018963]) + SUM([Penetración With Simulation (copia)_1499135732818714642])' />
            </column>
            <column caption='Penetracion Est.' datatype='real' default-format='p0.0%' name='[Calculation_1499135732829499417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1499135732829077526]/[Penetracion Est. PO (copia)_1499135732829331479]' />
            </column>
            <column caption='CITY Selector  ' datatype='string' name='[FRANCHISE Selector  (copia)_1274800181350064134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[FRANCHISE Parámetro (copia)_1274800181349998597] = &apos;&apos; THEN [CITY] ELSE [Parameters].[FRANCHISE Parámetro (copia)_1274800181349998597] END' />
            </column>
            <column datatype='string' name='[FRANCHISE]' role='dimension' type='nominal' />
            <column datatype='real' name='[FULL_DF_COFUNDABLE_ORDERS]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[ID]' role='dimension' type='ordinal' />
            <column datatype='date' name='[MONTH]' role='dimension' type='ordinal' />
            <column caption='MaxDate Fixed' datatype='datetime' name='[MaxDate (copia)_1499135732759474183]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-0,{fixed: max([MONTH])}))' />
            </column>
            <column datatype='string' name='[PARTNER]' role='dimension' type='nominal' />
            <column datatype='string' name='[PARTNER_STATUS]' role='dimension' type='nominal' />
            <column datatype='integer' default-format='n#,##0;-#,##0' name='[PLUS_ORDERS]' role='measure' type='quantitative' />
            <column datatype='string' name='[Partner_Segment]' role='dimension' type='nominal' />
            <column caption='Penetracion Est. TO' datatype='integer' name='[Penetracion Est. PO (copia)_1499135732829331479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Penetración With Simulation PO (copia)_1499135732827295765]) + SUM([Penetración With Real - Plus Orders (copia)_1499135732824678420])' />
            </column>
            <column caption='Penetración With Real - TO' datatype='integer' name='[Penetración With Real - Plus Orders (copia)_1499135732824678420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  true&#13;&#10;and NOT [Calculation_1171780334190645279]&#13;&#10;then [TOTAL_ORDERS]&#13;&#10;ELSEIF TRUE&#13;&#10;    AND [Calculation_1171780334190645279]&#13;&#10;    AND [Calculation_1499135732814716941]&lt;&gt;0&#13;&#10;then [TOTAL_ORDERS]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Penetración With Real - PO' datatype='real' name='[Penetración With Simulation (copia)_1499135732818714642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  true&#13;&#10;and NOT [Calculation_1171780334190645279]&#13;&#10;then [PLUS_ORDERS]&#13;&#10;ELSEIF TRUE&#13;&#10;    AND [Calculation_1171780334190645279]&#13;&#10;    AND [Calculation_1499135732814716941]&lt;&gt;0&#13;&#10;THEN [Calculation_1499135732814716941]&#13;&#10;else 0&#13;&#10;END' />
            </column>
            <column caption='Penetración With Simulation PO' datatype='integer' name='[Penetración With Simulation (copia)_1499135732824018963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//if  true&#13;&#10;//and [Months to Estimate]&#13;&#10;//then [Penetration Estimated]&#13;&#10;//else 0&#13;&#10;//END&#13;&#10;&#13;&#10;ZN({FIXED DATETRUNC(&apos;month&apos;, [MONTH]):&#13;&#10;SUM(IF 1=1&#13;&#10;    AND [Calculation_1171780334190645279]&#13;&#10;    AND [Calculation_1499135732814716941]=0&#13;&#10;    AND [COUNTRY]=[CATEGORIA Selector (copia)_1171780334121426971] &#13;&#10;    AND [CATEGORIA]=[Calculation_1171780334120214553]&#13;&#10;    AND [Partner_Segment]=[CATEGORIA Selector (copia)_1171780334120390682]&#13;&#10;    AND [VERTICAL]=[Calculation_1171780334120030232]&#13;&#10;    AND [PARTNER_STATUS]=[Calculation_1171780334169763869]&#13;&#10;    AND [FRANCHISE]=[CATEGORIA Selector (copia)_1171780334543286317]&#13;&#10;    AND [CITY]=[FRANCHISE Selector  (copia)_1274800181350064134]&#13;&#10;THEN [PLUS_ORDERS] END)})' />
            </column>
            <column caption='Penetración With Simulation TO' datatype='integer' name='[Penetración With Simulation PO (copia)_1499135732827295765]' role='measure' type='quantitative'>
