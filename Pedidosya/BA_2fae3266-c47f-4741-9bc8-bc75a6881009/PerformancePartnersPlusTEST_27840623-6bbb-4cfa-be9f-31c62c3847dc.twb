              <calculation class='tableau' formula='if  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-6,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-0 (copia)_557601950506655744]&lt;&gt;0&#13;&#10;then [Parameters].[M-0 (copia)_557601950506655744]*[TOTAL_ORDERS]&#13;&#10;elseif  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-5,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[VERTICAL Parámetro (copia)]&lt;&gt;0&#13;&#10;then [Parameters].[VERTICAL Parámetro (copia)]*[TOTAL_ORDERS]&#13;&#10;elseif true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-4,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M1 (copia)_1499135732814049291]&lt;&gt;0&#13;&#10;then [Parameters].[M1 (copia)_1499135732814049291]*[TOTAL_ORDERS]&#13;&#10;elseif true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-3,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M2 (copia)_1499135732814077964]&lt;&gt;0&#13;&#10;then [Parameters].[M2 (copia)_1499135732814077964]*[TOTAL_ORDERS]&#13;&#10;ELSEIF  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-3 (copia)_1499135732817022990]&lt;&gt;0&#13;&#10;then [Parameters].[M-3 (copia)_1499135732817022990]*[TOTAL_ORDERS]&#13;&#10;ELSEIF  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-2 (copia)_1499135732817055759]&lt;&gt;0&#13;&#10;then [Parameters].[M-2 (copia)_1499135732817055759]*[TOTAL_ORDERS]&#13;&#10;ELSEIF  true&#13;&#10;and [MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-0,[MaxDate (copia)_1499135732759474183]))&#13;&#10;and [Parameters].[M-1 (copia)_1499135732817100816]&lt;&gt;0&#13;&#10;then [Parameters].[M-1 (copia)_1499135732817100816]*[TOTAL_ORDERS]&#13;&#10;else 0&#13;&#10;END' />
