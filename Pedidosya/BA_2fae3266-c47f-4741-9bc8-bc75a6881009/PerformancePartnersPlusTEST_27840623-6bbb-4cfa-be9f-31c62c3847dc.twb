    <worksheet name='Frecuentes - Penetracion'>
      <table>
        <view>
          <datasources>
            <datasource caption='Partner_Retention' name='federated.1hekb7h0m31u2v181nabl1e8285x' />
          </datasources>
          <datasource-dependencies datasource='federated.1hekb7h0m31u2v181nabl1e8285x'>
            <column caption='Partial Month Plus Users' datatype='integer' name='[Calculation_1102256019826761732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(plus_users) - SUM(plus_users_full_month)' />
            </column>
            <column caption='Usuarios Plus Frecuentes' datatype='integer' name='[Calculation_1102256019827040261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019826761732] + SUM(pre_users_active)' />
            </column>
            <column caption='Parcial Month POST Orders' datatype='integer' name='[Calculation_1102256019827523590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(plus_orders) - SUM(post_orders_full_month)' />
            </column>
            <column caption='Frequent + Parcial Orders' datatype='integer' name='[Calculation_1102256019827707911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019827523590] + SUM(post_orders_active)' />
            </column>
            <column caption='Frecuencia Post Subs' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1102256019827855368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019827707911] / [Calculation_1102256019827040261]' />
            </column>
            <column caption='Frequent Plus Users PRE Freq' datatype='real' name='[Calculation_1102256019828092937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(pre_orders_active)/SUM(pre_users_active)' />
            </column>
