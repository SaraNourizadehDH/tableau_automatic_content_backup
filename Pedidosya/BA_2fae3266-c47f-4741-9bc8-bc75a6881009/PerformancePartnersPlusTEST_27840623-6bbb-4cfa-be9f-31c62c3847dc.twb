                <zone fixed-size='193' forceUpdate='true' h='5514' id='44' type-v2='text' w='46999' x='50182' y='26429'>
                  <formatted-text>
                    <run bold='true' fontsize='8' italic='true'>Usuarios Plus Frecuentes: </run>
                    <run fontsize='8' italic='true'>usuario suscrito que compró en la marca y ya lo hacia previo a suscribirse</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8' italic='true'>Usuarios Plus Adquirido:</run>
                    <run fontsize='8' italic='true'> usuario suscrito que compró en la marca y </run>
                    <run bold='true' fontsize='8' italic='true'>NO</run>
                    <run fontsize='8' italic='true'>  lo hacia previo a suscribirse</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8' italic='true'>Órdenes Plus Incrementales de Usuarios Frecuentes: </run>
                    <run fontsize='8' italic='true'>debido al incremento de su frecuencia generado en la marca post suscripción</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8' italic='true'>Órdenes Plus Incrementales de Usuarios Adquiridos:</run>
                    <run fontsize='8' italic='true'> debido a su uplift de frecuencia vs un usuario no plus adquirido</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8' italic='true'>Órdenes Plus Órganicas: </run>
                    <run fontsize='8' italic='true'>debido a su comportamiento previo a suscribirse</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
