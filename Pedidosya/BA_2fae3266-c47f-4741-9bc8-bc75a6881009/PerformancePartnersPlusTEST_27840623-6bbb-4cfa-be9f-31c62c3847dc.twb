                <zone fixed-size='26' h='915' id='190' name='Frecuentes - Penetracion' pane-specification-id='0' param='[federated.1hekb7h0m31u2v181nabl1e8285x].[usr:Uplift (#) (copia)_577868138289065984:qk]' show-title='false' type-v2='color' w='3091' x='40182' y='33114'>
