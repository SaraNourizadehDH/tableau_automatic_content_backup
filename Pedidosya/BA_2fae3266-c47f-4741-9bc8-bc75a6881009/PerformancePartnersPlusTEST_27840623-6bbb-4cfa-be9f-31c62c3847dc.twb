            <column caption='Incentives Per Order Plus' datatype='real' name='[Incentives Per Order (copia)_1847038812535959555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([basket_incentives] + [plus_incentives]) / sum([plus_orders])' />
            </column>
