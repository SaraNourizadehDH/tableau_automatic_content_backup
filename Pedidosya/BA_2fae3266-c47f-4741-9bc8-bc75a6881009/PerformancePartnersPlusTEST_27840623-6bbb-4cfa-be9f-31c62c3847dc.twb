      <column caption='P2' datatype='boolean' name='[Calculation_1171780333790744578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[MONTH] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,[Parameters].[MONTH Parámetro]))' />
      </column>
      <column caption='MaxDate' datatype='date' name='[Calculation_1171780333790986243]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max([MONTH])}' />
      </column>
      <column caption='MoM Plus Orders' datatype='real' default-format='p0.0%' name='[Calculation_1171780333797666821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [LM (copia)_1171780333796229124] THEN [PLUS_ORDERS] END) &#13;&#10;/&#13;&#10;SUM(IF [Calculation_1171780333790744578] THEN [PLUS_ORDERS] END)) - 1' />
      </column>
      <column caption='% Branches Plus' datatype='real' default-format='p0.0%' name='[Calculation_1171780333873807374]' role='measure' type='quantitative'>
