      <column caption='Frecuencia Plus' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1171780334454091819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PLUS_ORDERS])/AVG([PLUS_USERS_FRANCHISE])' />
