                    <format attr='background-color' value='#f80050' />
                  </zone-style>
                </zone>
                <zone fixed-size='229' h='6825' id='289' is-fixed='true' name='TABLE - RET' show-title='false' w='75909' x='2364' y='89829'>
                  <layout-cache type-h='cell' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#f80050' />
