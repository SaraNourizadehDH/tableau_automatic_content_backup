          <datasources>
            <datasource caption='Partner_Retention' name='federated.1hekb7h0m31u2v181nabl1e8285x' />
          </datasources>
          <datasource-dependencies datasource='federated.1hekb7h0m31u2v181nabl1e8285x'>
            <column caption='Incremental Orders by Reac/Acq' datatype='real' name='[Calculation_1102256019821793280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pre_users_rea_acq]) * [Calculation_1102256019821977601]' />
            </column>
            <column caption='Uplift  by Reac/Acq' datatype='real' default-format='p0.0%' name='[Calculation_1102256019821977601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019822297090]- [Calculation_1102256019822579715]' />
            </column>
            <column caption='Frecuencia Usuarios Plus by Reac/Acq' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1102256019822297090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(post_orders_rea_acq)/SUM(pre_users_rea_acq)' />
            </column>
            <column caption='Frecuencia Usuarios Non Plus By React/Acq' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1102256019822579715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(REACT_ACQ_ORDERS)/SUM(REACT_ACQ_USERS)' />
            </column>
            <column caption='Partial Month Plus Users' datatype='integer' name='[Calculation_1102256019826761732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(plus_users) - SUM(plus_users_full_month)' />
            </column>
            <column caption='Usuarios Plus Frecuentes' datatype='integer' name='[Calculation_1102256019827040261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019826761732] + SUM(pre_users_active)' />
            </column>
            <column caption='Parcial Month POST Orders' datatype='integer' name='[Calculation_1102256019827523590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(plus_orders) - SUM(post_orders_full_month)' />
            </column>
            <column caption='Frequent + Parcial Orders' datatype='integer' name='[Calculation_1102256019827707911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019827523590] + SUM(post_orders_active)' />
            </column>
            <column caption='Frecuencia Post Subs' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1102256019827855368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019827707911] / [Calculation_1102256019827040261]' />
            </column>
            <column caption='Frequent Plus Users PRE Freq' datatype='real' name='[Calculation_1102256019828092937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(pre_orders_active)/SUM(pre_users_active)' />
            </column>
            <column caption='Frequent Plus Users POST Freq' datatype='real' name='[Calculation_1102256019828264970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(post_orders_active)/SUM(pre_users_active)' />
            </column>
            <column caption='Uplift Freq' datatype='real' name='[Calculation_1102256019830202379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1102256019828264970]/[Calculation_1102256019828092937]) - 1' />
            </column>
            <column caption='Frecuencia Pre Subs' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1102256019830591500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019827855368] / (1+[Calculation_1102256019830202379])' />
            </column>
            <column caption='Uplift (#)' datatype='real' name='[Calculation_1102256019830800397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019827855368]-[Calculation_1102256019830591500]' />
            </column>
            <column caption='Incremental Orders by Freq' datatype='real' name='[Calculation_1102256019830960142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1102256019827040261]*[Calculation_1102256019830800397]' />
            </column>
            <column caption='Organic Plus Orders' datatype='real' name='[Calculation_1102256019831590927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plus_orders]) - [Calculation_1102256019830960142]-[Calculation_1102256019821793280]' />
            </column>
            <column caption='Share Plus Orders' datatype='real' default-format='p0.0%' name='[Calculation_1102256019831865360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plus_orders])/SUM([total_orders])' />
            </column>
