            <column caption='Costo Después De Desc Centralizado Sin Iva' datatype='real' name='[COSTO DESPUÉS DE DESC CENTRALIZADO SIN IVA]' role='measure' type='quantitative' />
            <column caption='Costo Sin Iva' datatype='real' datatype-customized='true' name='[COSTO SIN IVA]' role='measure' type='quantitative' />
            <column caption='date_day_string' datatype='string' name='[Calculation_1609755404215754752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,[registered_date]),3)) + &apos; &apos;+ &#13;&#10;STR(LEFT(DATENAME(&apos;day&apos;,[registered_date]),2)) + &apos;, &apos;&#13;&#10;+ RIGHT(STR(DATEPART(&apos;year&apos;,[registered_date])),4)' />
            </column>
            <column caption='date_month_string' datatype='string' name='[Calculation_1609755404215914497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,[registered_date]),3)) + &apos;, &apos; &#13;&#10;+ RIGHT(STR(DATEPART(&apos;year&apos;,[registered_date])),4)' />
            </column>
            <column caption='date_week_string' datatype='string' name='[Calculation_1609755404216029186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,DATE(DATETRUNC(&apos;week&apos;,[registered_date],&apos;monday&apos;))),3)) &#13;&#10;//+ &apos; &apos; + RIGHT(STR(DATEPART(&apos;year&apos;,DATE(DATETRUNC(&apos;week&apos;,[registered_date],&apos;monday&apos;)))),2) +&apos;, &apos;&#13;&#10;+&apos; &apos;+ STR(DATEPART(&apos;day&apos;, DATE(DATETRUNC(&apos;week&apos;,[registered_date],&apos;monday&apos;)))) + &#13;&#10; &apos;, &apos; + RIGHT(STR(DATEPART(&apos;year&apos;,DATE(DATETRUNC(&apos;week&apos;,[registered_date],&apos;monday&apos;)))),4)' />
            </column>
            <column caption='dynamic_date' datatype='string' name='[Calculation_1609755404216799235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10; WHEN &apos;Daily&apos; THEN [Calculation_1609755404215754752]&#13;&#10; WHEN &apos;Monthly&apos; THEN [Calculation_1609755404215914497]&#13;&#10; WHEN &apos;Weekly&apos; THEN [Calculation_1609755404216029186]&#13;&#10;END' />
            </column>
            <column caption='Valor Ventas' datatype='real' name='[Calculation_1851542418739236865]' role='measure' type='quantitative'>
