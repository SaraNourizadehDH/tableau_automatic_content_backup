      <aliases enabled='yes' />
      <column caption='% Campañas Totales / VFD' datatype='real' hidden='true' name='[% Campañas / VFD (copy)_6092877745234657282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6092877745234513921] / sum([vfd_total_amount_eur])' />
      </column>
      <column caption='% Campañas / GMV' datatype='real' name='[% Campañas / VFD (copy)_6092877745234743299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_subsidized_amount_eur]) / sum([total_gmv_eur])' />
      </column>
      <column caption='% Campañas Proxy / GMV' datatype='real' name='[% Campañas Proxy / VFD (copy)_6092877745234821124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_subsidized_proxy_amount_eur]) / sum([total_gmv_eur])' />
      </column>
      <column caption='% Campañas Totales / GMV' datatype='real' name='[% Campañas Totales / VFD (copy)_6092877745234907141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6092877745234513921] / sum([total_gmv_eur])' />
      </column>
      <column caption='% MAIN DISH &amp; TOP' datatype='real' name='[% DEAL MAIN DISH  (copia)_1983554209425592326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[deal_main_dish_top_items_partners]/ [active_partners]' />
      </column>
      <column caption='% ONLY DELIVERY FEE' datatype='real' name='[% DEAL MAIN DISH  (copia)_1983554209427611655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[onlydeliveryfee]/ [active_partners]' />
      </column>
      <column caption='% NON VFD' datatype='real' name='[% DEAL MAIN DISH  (copia)_1983554209429815304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([active_partners]- [vfd_partners]) / [active_partners]' />
      </column>
      <column caption='Penetración top&amp;main' datatype='real' name='[% DEAL MAIN DISH  (copia)_1983554209764687882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deal_main_dish_top_items_partners])/ SUM([active_partners])' />
      </column>
      <column caption='% DEAL MAIN DISH ' datatype='real' name='[% DEAL PARTNERS (copia)_1983554209425293317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([deal_main_dish_partners]-[deal_main_dish_top_items_partners])/ [active_partners]' />
      </column>
      <column caption='% DF0 / GMV' datatype='real' default-format='p0.00%' name='[% DF0 / VFD (copy)_6092877745234976774]' role='measure' type='quantitative'>
