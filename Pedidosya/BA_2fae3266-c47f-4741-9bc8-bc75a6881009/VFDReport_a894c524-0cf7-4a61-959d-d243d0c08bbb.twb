      </column>
      <column caption='Monto Menú Completo (Rojo o amarillo)' datatype='real' name='[Monto Menú Completo (Rojo) (copia)_3199666834299805698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(IF [semaforo_wmd_final] IN (&quot;ROJO&quot;, &quot;AMARILLO&quot;) THEN [vfd_weekly_amount_eur] END,0)' />
      </column>
      <column caption='Monto VFD (Verde y sin Joker)' datatype='real' name='[Monto VFD (sin Rojo ni Joker) (copia)_3199666834300014595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vfd_total_amount_eur] - IFNULL([vfd_joker_amount_eur],0) - IFNULL(IF [semaforo_wmd_final] IN(&quot;ROJO&quot;, &quot;AMARILLO&quot;) THEN [vfd_weekly_amount_eur] END,0)' />
      </column>
      <column caption='Monto Menú Completo (Rojo)' datatype='real' name='[Monto VFD (sin Rojo ni Joker) (copia)_3633982723068956678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(IF [semaforo_wmd_final] = &quot;ROJO&quot; THEN [vfd_weekly_amount_eur] END,0)' />
      </column>
      <column caption='Partner autogestionado (medida)' datatype='integer' name='[Partner autogestionado (copia)_8644026182672814109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [vfd_self_managed_amount_eur]&gt;0 THEN 1 END' />
