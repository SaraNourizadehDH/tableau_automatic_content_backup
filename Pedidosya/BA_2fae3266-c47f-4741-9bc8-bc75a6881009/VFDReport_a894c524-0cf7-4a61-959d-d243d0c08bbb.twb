    <worksheet name='Deals Plus'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='22'>Deals Plus</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vfd_monthly+ (automated_tables_reports)' name='federated.0d61vwh0fau1jc17fsmgi0y3mqkc' />
          </datasources>
          <datasource-dependencies datasource='federated.0d61vwh0fau1jc17fsmgi0y3mqkc'>
            <column caption='% Partners con plus deals' datatype='real' name='[Calculation_626281848523051008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [vfd_plus_subsidized_orders]&gt;0 THEN [partner_id]END)/COUNTD(IF [is_plus] THEN [partner_id] END)' />
            </column>
            <column caption='Partners con plus deals' datatype='integer' name='[Calculation_626281848524124161]' role='measure' type='quantitative'>
