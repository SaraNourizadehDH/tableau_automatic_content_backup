        <calculation class='tableau' formula='[country]' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id]) / TOTAL(COUNTD([partner_id]))'>
