          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='22'>% VFD/GMV Gross </run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='12'>(EUR, by quality condition)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vfd_monthly+ (automated_tables_reports)' name='federated.0d61vwh0fau1jc17fsmgi0y3mqkc' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Si' caption='Plus Shipping Deals' datatype='boolean' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Si' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d61vwh0fau1jc17fsmgi0y3mqkc'>
            <column caption='%VFD/GMV' datatype='real' default-format='p0.00%' name='[Calculation_1054686762679300096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_total_amount_eur]) / sum([total_gmv_eur])' />
            </column>
            <column aggregation='Sum' caption='is vfd partner' datatype='integer' name='[Calculation_1054686762949853192]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  MAX(0, IFNULL([vfd_total_amount_eur],0)- IF NOT [Parameters].[Parámetro 1] THEN IFNULL([plus_shipping_amount_eur],0) ELSE 0 END) &gt; 0 then 1 else 0 end' />
            </column>
            <column caption='Is VFD Partner?' datatype='boolean' name='[Calculation_4477140988512301058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1054686762949853192]=1 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='quality %vfd/gmv' datatype='real' default-format='p0.00%' name='[Calculation_914793682911600642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [is_quality_partner] then [vfd_total_amount_eur] END)&#13;&#10;/&#13;&#10;sum([total_gmv_eur])' />
            </column>
