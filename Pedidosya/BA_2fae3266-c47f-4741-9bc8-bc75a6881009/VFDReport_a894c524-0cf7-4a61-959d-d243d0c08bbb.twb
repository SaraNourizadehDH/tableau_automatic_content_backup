              <calculation class='tableau' formula='COUNTD(if [vfd_df0_proxy_amount_eur] &gt; 0 then [partner_id] end)' />
            </column>
            <column caption='% Penetración Partners DF0' datatype='real' default-format='p0.0%' name='[Calculation_1054686763673681956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1054686763673595939] / COUNTD([partner_id])' />
            </column>
            <column caption='% Penetración Órdenes DF0' datatype='real' default-format='p0.00%' name='[Calculation_1054686763677237286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_df0_proxy_orders]) / sum([vfd_total_orders])' />
