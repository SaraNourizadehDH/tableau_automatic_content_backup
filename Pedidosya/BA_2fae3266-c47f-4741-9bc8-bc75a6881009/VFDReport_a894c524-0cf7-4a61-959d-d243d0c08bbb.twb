        <calculation class='tableau' formula='IF MAX([real_tiers_group]) != [Calculation_1630866054344822784] THEN &quot;SI&quot; ELSE &quot;NO&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Conteo partners vfd' datatype='integer' name='[Calculation_1889541559414263808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [vfd_partner] THEN [partner_id] END)' />
      </column>
      <column caption='VFD/GMV real' datatype='real' name='[Calculation_1946680980714061827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_real]) / sum([total_gmv_eur])' />
      </column>
      <column caption='VFD fake / GMV' datatype='real' name='[Calculation_1946680980719087620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1054686762679300096] - [Calculation_1946680980714061827]' />
      </column>
      <column caption='Non VFD' datatype='integer' name='[Calculation_1983554209417625600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_partners]-[vfd_partners]' />
      </column>
      <column caption='% VFD PARTNERS ' datatype='real' name='[Calculation_1983554209424986115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([vfd_partners]-[deal_partners])/ [active_partners]' />
      </column>
      <column caption='Penetracion' datatype='real' name='[Calculation_1983554209713582089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vfd_partners]/[active_partners]' />
      </column>
      <column caption='Partners Quality' datatype='integer' hidden='true' name='[Calculation_2643472304107286566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_quality_partner] then [partner_id] end)' />
      </column>
      <column caption='Partners No Quality' datatype='integer' hidden='true' name='[Calculation_2643472304107438119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if not [is_quality_partner] then [partner_id] end)' />
      </column>
      <column aggregation='Sum' caption='Partner autogestionado' datatype='integer' name='[Calculation_2697726588780015662]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [vfd_self_managed_amount_eur]&gt;0 THEN [partner_id] END' />
      </column>
      <column caption='% Partners VFD autogestionados' datatype='real' name='[Calculation_2697726588780163119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2697726588780015662])/COUNTD([Calculation_1240178783527813126])' />
      </column>
      <column caption='Órdenes Campañas Totales' datatype='integer' hidden='true' name='[Calculation_3703577405395779586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vfd_subsidized_orders] + [vfd_subsidized_proxy_orders]' />
      </column>
      <column caption='Is VFD Partner?' datatype='boolean' name='[Calculation_4477140988512301058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1054686762949853192]=1 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Monto VFD Campañas Totales' datatype='real' hidden='true' name='[Calculation_6092877745234513921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_subsidized_amount_eur]) + sum([vfd_subsidized_proxy_amount_eur])' />
      </column>
      <column caption='% Partners con plus deals' datatype='real' name='[Calculation_626281848523051008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [vfd_plus_subsidized_orders]&gt;0 THEN [partner_id]END)/COUNTD(IF [is_plus] THEN [partner_id] END)' />
      </column>
      <column caption='Partners con plus deals' datatype='integer' name='[Calculation_626281848524124161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [vfd_plus_subsidized_orders]&gt;0 THEN [partner_id]END)' />
      </column>
      <column caption='Partners plus' datatype='integer' name='[Calculation_626281848524349442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_plus] THEN [partner_id] END)' />
      </column>
      <column caption='Monto VFD Resto' datatype='real' name='[Calculation_626281848535228419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vfd_total_amount_eur]- [vfd_subsidized_amount_eur]-[vfd_subsidized_proxy_amount_eur]-[vfd_df0_proxy_amount_eur]-[ild_amount_eur]-[vfd_joker_amount_eur]-[plus_subsidized_amount_eur]-[plus_shipping_amount_eur]' />
      </column>
      <column caption='En productos' datatype='integer' name='[Calculation_626281848551354373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [products_sold_deal]&gt;0 THEN [partner_id]END)' />
      </column>
      <column caption='% con descuentos (VFD)' datatype='real' name='[Calculation_626281848555184136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Partners VFD Total (copia)_626281848553037831]/[Calculation_1054686763314905102]' />
      </column>
      <column caption='% en productos' datatype='real' name='[Calculation_626281848557957129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_626281848551354373]/[Calculation_1054686763314905102]' />
      </column>
      <column caption='% main dish' datatype='real' name='[Calculation_626281848558059530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Partners con descuento en producto (copia)_626281848552443910]/[Calculation_1054686763314905102]' />
      </column>
      <column caption='% Activos' datatype='real' name='[Calculation_626281848558149643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1054686763314905102]/[Calculation_1054686763314905102]' />
      </column>
      <column caption='% Third / GMV' datatype='real' default-format='p0.00%' name='[Calculation_739153315876528128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([third_amount_eur]) / sum([total_gmv_eur])' />
      </column>
      <column caption='Partners No Whole Menu' datatype='integer' hidden='true' name='[Calculation_739153315881177089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id]) - [Calculation_1054686763314511884]' />
      </column>
      <column caption='Partners No Item Level' datatype='integer' hidden='true' name='[Calculation_739153315899875330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id]) - [Calculation_1054686763401220115]' />
      </column>
      <column caption='Partners No Campañas' datatype='integer' hidden='true' name='[Calculation_739153315900919811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id]) - [ILD PARTNER (copia)_1054686763407048730] - [ILD PARTNER (copia)_1054686763407171611]' />
      </column>
      <column caption='Partners No DF0' datatype='integer' hidden='true' name='[Calculation_739153315904466948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id]) - [Calculation_1054686763401220115]' />
      </column>
      <column caption='Partners Plus' datatype='integer' name='[Calculation_739153315927801861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if is_plus then [partner_id] end)' />
      </column>
      <column caption='% Penetración Partners Plus' datatype='real' default-format='p0.00%' name='[Calculation_739153315928027142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_739153315927801861] / COUNTD([partner_id])' />
      </column>
      <column caption='% Plus Shipping / VFD' datatype='real' default-format='p0.0%' name='[Calculation_739153316611973128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([plus_shipping_amount_eur]) / sum([vfd_total_amount_eur])' />
      </column>
      <column caption='Partners Joker' datatype='integer' name='[Calculation_739153316627939338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [vfd_joker_amount_eur] &gt; 0 then [partner_id] end)' />
      </column>
      <column caption='% Penetración Partners Joker' datatype='real' default-format='p0.0%' name='[Calculation_739153316628008971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_739153316627939338] / COUNTD([partner_id])' />
      </column>
      <column caption='% Penetración Órdenes Joker' datatype='real' default-format='p0.0%' name='[Calculation_739153316628860940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_joker_orders]) / sum([total_orders])' />
      </column>
      <column caption='% Joker / VFD' datatype='real' default-format='p0.0%' name='[Calculation_739153316629200909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_joker_amount_eur]) / sum([vfd_total_amount_eur])' />
      </column>
      <column caption='% Penetración Órdenes Plus Shipping' datatype='real' default-format='p0.0%' name='[Calculation_739153316631601166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_plus_shipping_orders]) / sum([total_orders])' />
      </column>
      <column caption='% Con Main Dish' datatype='real' name='[Calculation_8073617156573990923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Partners con descuento en producto (copia)_626281848552443910]/[Calculation_1054686763314905102]' />
      </column>
      <column caption='Promedio markup' datatype='real' name='[Calculation_825003203548073984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([markup__fake_deals_ild_])' />
      </column>
      <column caption='quality %vfd/gmv' datatype='real' default-format='p0.00%' name='[Calculation_914793682911600642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_quality_partner] then [vfd_total_amount_eur] END)&#13;&#10;/&#13;&#10;sum([total_gmv_eur])' />
      </column>
      <column caption='Con descuentos (VFD) (copia)' datatype='integer' name='[Con descuentos (VFD) (copia)_8073617156574306316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1054686762949853192])' />
      </column>
