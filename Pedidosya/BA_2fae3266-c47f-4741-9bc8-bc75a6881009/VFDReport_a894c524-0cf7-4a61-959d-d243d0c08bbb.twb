        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.00u253u0dh7dm515s4g9700vmy86' name='Consulta SQL personalizada1' type='text'>SELECT
  
  `fake_deals_ild`.`discount_amount_real_y_ajustado_total_eu_neteado` AS `discount_amount_real_y_ajustado_total_eu_neteado`,
  `fake_deals_ild`.`discount_pct_peya` AS `discount_pct_peya`,
  `fake_deals_ild`.`discount_pct_real` AS `discount_pct_real`,
  `fake_deals_ild`.`item_id` AS `item_id`,
  `fake_deals_ild`.`markup` AS `markup__fake_deals_ild_`,
  `fake_deals_ild`.`ordenes` AS `ordenes`,
  `fake_deals_ild`.`partner_id` AS `partner_id__fake_deals_ild_`,
  `fake_deals_ild`.`precio_final_peya_ml` AS `precio_final_peya_ml`,
  `fake_deals_ild`.`precio_local_ml` AS `precio_local_ml`,
  `fake_deals_ild`.`precio_original_peya_ml` AS `precio_original_peya_ml`,
  `fake_deals_ild`.`product_name` AS `product_name`,
  `fake_deals_ild`.`real_deals` AS `real_deals`,
  `fake_deals_ild`.`real_tiers_group` AS `real_tiers_group`,
  `fake_deals_ild`.`registered_date` AS `registered_date`,
  `fake_deals_ild`.`unidades` AS `unidades`,
  `fake_deals_ild`.`vfd_amount_eu` AS `vfd_amount_eu`
FROM `peya-delivery-and-support.automated_tables_reports`.`fake_deals_ild` `fake_deals_ild`</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='AND'>
                <expression op='='>
                  <expression op='[vfd_monthly].[month]' />
                  <expression op='[Consulta SQL personalizada].[month]' />
                </expression>
                <expression op='='>
                  <expression op='[vfd_monthly].[partner_id]' />
                  <expression op='[Consulta SQL personalizada].[partner_id]' />
                </expression>
              </expression>
            </clause>
            <relation connection='bigquery.00u253u0dh7dm515s4g9700vmy86' name='vfd_monthly' table='[peya-delivery-and-support.automated_tables_reports].[vfd_monthly]' type='table' />
            <relation connection='bigquery.00u253u0dh7dm515s4g9700vmy86' name='Consulta SQL personalizada' type='text'>select &#13;
date_Trunc(registered_date, month) as month&#13;
,partner_id&#13;
,max(is_quality_partner) is_quality_partner&#13;
,max(is_plus) as is_plus&#13;
,max(partner_status) as partner_status&#13;
,max(case when semaforo_wmd_final = &apos;ROJO&apos; THEN &apos;ROJO&apos; else semaforo_wmd_final end) as semaforo_wmd_final&#13;
&#13;
from `peya-delivery-and-support.automated_tables_reports.vfd_partner_tags_historical`&#13;
&#13;
&#13;
group by 1,2</relation>
          </relation>
          <relation connection='bigquery.00u253u0dh7dm515s4g9700vmy86' name='vfd_dashboard_partners' table='[peya-delivery-and-support.automated_tables_reports].[vfd_dashboard_partners]' type='table' />
