            <datasource caption='vfd_monthly+ (automated_tables_reports)' name='federated.0d61vwh0fau1jc17fsmgi0y3mqkc' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Si' caption='Plus Shipping Deals' datatype='boolean' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Si' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d61vwh0fau1jc17fsmgi0y3mqkc'>
            <column caption='% Penetración Órdenes Item Level' datatype='real' default-format='p0.00%' name='[%weekly order pen (copia)_1054686763402551318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_ild_orders]) / sum([vfd_total_orders])' />
            </column>
            <column caption='% PeYa / GMV' datatype='real' default-format='p0.00%' name='[Calculation_1054686762679418881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([peya_total_amount_eur]) / sum([total_gmv_eur])' />
            </column>
            <column caption='% Autogestión /  VFD' datatype='real' default-format='p0.00%' name='[Calculation_1054686762725257219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_self_managed_amount_eur]) / sum([vfd_total_amount_eur])' />
            </column>
            <column aggregation='Sum' caption='is vfd partner' datatype='integer' name='[Calculation_1054686762949853192]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  MAX(0, IFNULL([vfd_total_amount_eur],0)- IF NOT [Parameters].[Parámetro 1] THEN IFNULL([plus_shipping_amount_eur],0) ELSE 0 END) &gt; 0 then 1 else 0 end' />
            </column>
            <column caption='Partners VFD Total' datatype='integer' name='[Calculation_1054686762950049801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1054686762949853192])' />
            </column>
            <column caption='% Penetración Partners VFD' datatype='real' default-format='p0.00%' name='[Calculation_1054686762958598155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1054686762950049801] / COUNTD([partner_id])' />
            </column>
            <column caption='Partners Whole Menu' datatype='integer' name='[Calculation_1054686763314511884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [vfd_weekly_amount_eur] &gt; 0 then [partner_id] end)' />
            </column>
            <column caption='% Penetración Partners Whole Menu' datatype='real' default-format='p0.00%' name='[Calculation_1054686763314696205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1054686763314511884] / COUNTD([partner_id])' />
            </column>
            <column caption='Activos' datatype='integer' name='[Calculation_1054686763314905102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([partner_id])' />
            </column>
            <column caption='Partners Item Level' datatype='integer' name='[Calculation_1054686763401220115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [ild_amount_eur] &gt; 0 then [partner_id] end)' />
            </column>
            <column caption='% Penetración Partners Item Level' datatype='real' default-format='p0.00%' name='[Calculation_1054686763401334804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1054686763401220115] / COUNTD([partner_id])' />
            </column>
            <column caption='% ILD / VFD ' datatype='real' default-format='p0.00%' name='[Calculation_1054686763403165720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ild_amount_eur]) / sum([vfd_total_amount_eur])' />
            </column>
            <column caption='% Penetración Partners Campañas' datatype='real' default-format='p0.00%' name='[Calculation_1054686763407327260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ILD PARTNER (copia)_1054686763407048730] / COUNTD([partner_id])' />
            </column>
            <column caption='% Penetración Partners Campañas Proxy' datatype='real' default-format='p0.00%' name='[Calculation_1054686763407392797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ILD PARTNER (copia)_1054686763407171611] / COUNTD([partner_id])' />
            </column>
            <column caption='% Campañas / VFD' datatype='real' name='[Calculation_1054686763668357151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_subsidized_amount_eur]) / sum([vfd_total_amount_eur])' />
