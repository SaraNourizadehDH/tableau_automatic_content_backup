    <worksheet name='Partners (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='9'>Partners</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Campaña-producto' name='federated.1qx8wkb0s1f2uw1cnsrdy1frragq' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Campaign Type' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Todo&quot;'>
              <calculation class='tableau' formula='&quot;Todo&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qx8wkb0s1f2uw1cnsrdy1frragq'>
            <column caption='&quot;Total general&quot;' datatype='string' name='[Calculation_1049057244651565062]' role='dimension' type='nominal' user:unnamed='Campañas (2)'>
              <calculation class='tableau' formula='&quot;Total general&quot;' />
            </column>
            <column caption='campaign type bool' datatype='boolean' name='[Calculation_1562186179383885824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Todo&apos; then [campaign_type] in(&apos;subsidized&apos;, &apos;deal&apos;)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Subsidized&apos; then [campaign_type] = &apos;subsidized&apos;&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Deal Carga Masiva&apos; then [campaign_type] = &apos;deal&apos; and [is_bulk_load] = true&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Deal Autogestion&apos; then [campaign_type] = &apos;deal&apos; and [is_bulk_load] = false&#13;&#10;END' />
            </column>
            <column caption='Discount (1)' datatype='real' name='[Calculation_1934014617393713152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[discount]' />
            </column>
            <column caption='Error' datatype='boolean' name='[Calculation_1934014617394049025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[amount_company]+[amount_partner]&gt;[Calculation_1934014617393713152] OR [Calculation_1934014617393713152]=0' />
            </column>
            <column caption='Total PeYa' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_1934014617394917378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amount_company]*[orders]' />
            </column>
            <column caption='Total Vendor' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_1934014617395003395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amount_partner]*[orders]' />
            </column>
            <column caption='Total discount' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_1934014617396498436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1934014617393713152]*[orders]' />
            </column>
            <column caption='% PEYA' datatype='real' default-format='p0%' name='[Calculation_1934014617397411845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1934014617394917378])/sum([Calculation_1934014617396498436])' />
            </column>
            <column caption='PEYA Funding Partner Campaign' datatype='real' name='[Calculation_1934014617658855440]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [partner_id],[month],[campaign_id]: SUM([Calculation_1934014617394917378])}' />
            </column>
            <column caption='Is cofunded?' datatype='boolean' name='[Calculation_1934014617689739291]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1934014617658855440]&gt;0' />
            </column>
            <column datatype='string' name='[Segmento (grupo)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[partner_segment]' new-bin='true'>
                <bin default-name='false' value='&quot;A&quot;'>
                  <value>&quot;A&quot;</value>
                  <value>&quot;A1&quot;</value>
                  <value>&quot;A2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;B&quot;'>
                  <value>&quot;B&quot;</value>
                  <value>&quot;B1&quot;</value>
                  <value>&quot;B2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;C&quot;'>
                  <value>&quot;C&quot;</value>
                  <value>&quot;C1&quot;</value>
                  <value>&quot;C2&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;D&quot;'>
                  <value>&quot;D&quot;</value>
                  <value>&quot;D1&quot;</value>
                  <value>&quot;D2&quot;</value>
                  <value>&quot;D3&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Sin segmento&quot;'>
                  <value>%null%</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column datatype='real' name='[amount_company]' role='measure' type='quantitative' />
            <column datatype='real' name='[amount_partner]' role='measure' type='quantitative' />
