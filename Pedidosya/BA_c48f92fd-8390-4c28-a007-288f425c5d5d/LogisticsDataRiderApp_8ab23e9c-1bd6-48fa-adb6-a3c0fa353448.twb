      </layout-options>
      <repository-location id='CUSTOMTABULARVIEW' path='/t/Pedidosya/workbooks/RIDERAPP_17274435630270' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='kr_working_hours_wn' name='federated.0fy54yf0z6jth111mdfur1e4vn97' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='GRANULARITY' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='KPI' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;KIWI WORKING HOURS&quot;'>
              <calculation class='tableau' formula='&quot;KIWI WORKING HOURS&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fy54yf0z6jth111mdfur1e4vn97'>
            <column caption='GRANULARITY' datatype='datetime' default-format='S' name='[Calculation_1780892237956083715]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Daily&apos; THEN &#13;&#10;    [created_date_local]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Weekly&apos; THEN &#13;&#10;    DATETRUNC(&apos;week&apos;, [created_date_local])&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Monthly&apos; THEN &#13;&#10;    DATETRUNC(&apos;month&apos;, [created_date_local])&#13;&#10;END' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_928586011996282880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;  WHEN &quot;WN THRESHOLD WORKING HOURS&quot; THEN (SUM(kiwi_shift_duration) / SUM(hd_evaluations_working_time)) *100&#13;&#10;  WHEN &quot;KIWI WORKING HOURS&quot; THEN SUM(hd_evaluations_working_time)&#13;&#10;  WHEN &quot;KIWI SHIFT DURATION&quot; THEN SUM([kiwi_shift_duration])&#13;&#10;  WHEN &quot;HD EVALUATIONS WORKING TIME&quot; THEN SUM([hd_evaluations_working_time])&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1780892237956083715]' derivation='Attribute' name='[attr:Calculation_1780892237956083715:ok]' pivot='key' type='ordinal' />
            <column-instance column='[created_date_local]' derivation='Attribute' name='[attr:created_date_local:ok]' pivot='key' type='ordinal' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Hd Evaluations Working Time' datatype='real' name='[hd_evaluations_working_time]' role='measure' type='quantitative' />
            <column caption='Kiwi Shift Duration' datatype='real' name='[kiwi_shift_duration]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1780892237956083715]' derivation='None' name='[none:Calculation_1780892237956083715:ok]' pivot='key' type='ordinal' />
