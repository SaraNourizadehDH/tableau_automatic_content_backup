      <aliases enabled='yes' />
      <column caption='GRANULARITY' datatype='datetime' name='[Calculation_648236939717595137]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] =  &#13;&#10;        &#13;&#10;&apos;Daily&apos; THEN [created_date]&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;[Parameters].[Parámetro 1] =  &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [created_date])&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;[Parameters].[Parámetro 1] =  &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [created_date])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='UR TOTAL' datatype='real' default-format='p0.00%' name='[Calculation_648236939726446594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_undispatch])&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM([total_accepted_orders])' />
      </column>
      <column caption='UR LIST MODE' datatype='real' name='[Calculation_648236939784777731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([list_mode_undispatch])&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM([list_mode_accepted_orders])' />
      </column>
      <column caption='UR AI' datatype='real' name='[Calculation_648236939785658372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ai_mode_undispatch])&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;SUM([ai_mode_accepted_orders])' />
      </column>
      <column caption='STACKING TOTAL' datatype='real' name='[Calculation_648236939786510341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_stacked) / SUM(total_completed_orders)' />
      </column>
      <column caption='STACKING LIST MODE' datatype='real' name='[Calculation_648236939786731526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(list_mode_stacked) / SUM(list_mode_completed_orders)' />
      </column>
      <column caption='STACKING AI' datatype='real' name='[Calculation_648236939786985479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ai_mode_stacked) / SUM(ai_mode_completed_orders)' />
      </column>
