      <table>
        <view>
          <datasources>
            <datasource caption='work_now_metrics' name='federated.099bcr216msvnz1f8oz5p0kxea39' />
            <datasource caption='kr_working_hours_wn' name='federated.0fy54yf0z6jth111mdfur1e4vn97' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='GRANULARITY' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.099bcr216msvnz1f8oz5p0kxea39'>
            <column caption='GRANULARITY' datatype='datetime' name='[Calculation_1780892237985853451]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;  WHEN &quot;Daily&quot; THEN DATE([fecha])&#13;&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [fecha])&#13;&#10;  WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [fecha])&#13;&#10;END' />
            </column>
            <column caption='MEAN DELAY' datatype='real' name='[Calculation_1780892237986471948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(mean_delay_time) / SUM(orders_delivered)' />
            </column>
