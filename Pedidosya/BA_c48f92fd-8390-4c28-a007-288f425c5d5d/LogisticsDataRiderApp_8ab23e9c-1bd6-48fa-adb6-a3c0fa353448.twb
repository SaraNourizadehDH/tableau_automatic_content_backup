      <column caption='GRANULARITY' datatype='datetime' default-format='S' name='[Calculation_1780892237956083715]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;Daily&apos; THEN &#13;&#10;    [created_date_local]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Weekly&apos; THEN &#13;&#10;    DATETRUNC(&apos;week&apos;, [created_date_local])&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Monthly&apos; THEN &#13;&#10;    DATETRUNC(&apos;month&apos;, [created_date_local])&#13;&#10;END' />
      </column>
      <column caption='KIWI WORKING HOURS / WN THRESHOLD WORKING HOURS' datatype='real' name='[Calculation_1780892237977202696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(kiwi_shift_duration) / SUM(wn_evaluations_working_time)' />
      </column>
      <column caption='KIWI WORKING HOURS / HD THRESHOLD WORKING HOURS' datatype='real' name='[Calculation_1780892237977350153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(kiwi_shift_duration) / SUM(hd_evaluations_working_time)' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_928586011996282880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;  WHEN &quot;WN THRESHOLD WORKING HOURS&quot; THEN (SUM(kiwi_shift_duration) / SUM(hd_evaluations_working_time)) *100&#13;&#10;  WHEN &quot;KIWI WORKING HOURS&quot; THEN SUM(hd_evaluations_working_time)&#13;&#10;  WHEN &quot;KIWI SHIFT DURATION&quot; THEN SUM([kiwi_shift_duration])&#13;&#10;  WHEN &quot;HD EVALUATIONS WORKING TIME&quot; THEN SUM([hd_evaluations_working_time])&#13;&#10;END' />
      </column>
