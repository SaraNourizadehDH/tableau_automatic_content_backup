        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.089y8wb02netw813mvuf80gt2dyk' name='Consulta SQL personalizada' type='text'>SELECT&#13;
        DATE_TRUNC(fecha,month) AS month,&#13;
        COUNTRY_CODE,&#13;
        shift_tag,&#13;
        intervalo,&#13;
        SUM(shifts) AS  shifts,&#13;
        COUNT(DISTINCT rider_id) AS riders_qty,&#13;
        COUNT(DISTINCT((CASE WHEN orders_accepted &gt;&gt; 1 AND shift_tag = &quot;KIWI&quot; THEN rider_id END))) AS adoption_cove_num,&#13;
        -- SAFE_DIVIDE (COUNT(DISTINCT((CASE WHEN orders_accepted &gt;&gt; 1 AND shift_tag = &quot;KIWI&quot; THEN rider_id END))), COUNT(DISTINCT(rider_id)))  AS adoption_cove_num,&#13;
        -- rider_id, &#13;
        COUNT(DISTINCT((CASE WHEN orders_accepted &gt;&gt; 0  AND shift_tag = &quot;KIWI&quot; THEN rider_id END))) AS adoption_rate_num ,&#13;
        -- SAFE_DIVIDE (COUNT(DISTINCT((CASE WHEN orders_accepted &gt;&gt; 0  AND shift_tag = &quot;KIWI&quot; THEN rider_id END))), COUNT(DISTINCT(rider_id)))  AS adoption_rate_num,&#13;
        -- CASE WHEN orders_accepted &gt;&gt; 0 AND shift_tag = &quot;KIWI&quot; THEN rider_id END AS adoption_rate_num,&#13;
        SUM(wn_actual) AS wn_actual,&#13;
        SUM(wn_planned) AS wn_planned,&#13;
        SUM(actual) AS actual,&#13;
        SUM(planned) AS planned,&#13;
        SUM(orders_accepted) AS orders_accepted,&#13;
        SUM(orders_notified) AS orders_notified&#13;
&#13;
        -- SAFE_DIVIDE(SUM(wn_actual),SUM(wn_planned)) AS actual_vs_planned_total_wn,&#13;
        -- SAFE_DIVIDE(SUM(actual),SUM(planned)) AS actual_vs_planned_total,&#13;
        -- SAFE_DIVIDE(SUM(orders_accepted),SUM(orders_notified)) AS acceptance_rate,&#13;
&#13;
        -- SUM(wn_actual)/SUM(wn_planned)  AS actual_vs_planned_total, --ACTUAL vs PLANNED (TOTAL),&#13;
        -- SUM(orders_accepted)/SUM(orders_notified) AS acceptance_rate,&#13;
        -- SUM(orders_accepted) AS orders_accepted,&#13;
&#13;
        -- ACTUAL vs PLANNED (TOTAL)&#13;
&#13;
&#13;
        -- SUM([Wn Actual]) / SUM([Wn Planned]) &#13;
FROM `peya-delivery-and-support.user_leonardo_rosa.work_now_shifts`&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
