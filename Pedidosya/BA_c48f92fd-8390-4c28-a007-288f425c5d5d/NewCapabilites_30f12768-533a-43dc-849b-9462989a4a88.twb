      UNION ALL&#13;
          SELECT &apos;Scoring&apos; as payment_source,&#13;
                 t.country_code,&#13;
                 scoring.city_id,&#13;
                 DATE(DATETIME(scoring.created_at, t.timezone)) last_date,&#13;
                 scoring.payment_type as payment_type,&#13;
                 sr.paid_unit as paid_unit,&#13;
                 scoring.delivery_id,&#13;
                 CAST(sum(case &#13;
                            when sr.paid_unit=&quot;PER_KM&quot; and t.country_code in (&apos;ds_pa&apos;) and scoring.paid_unit_amount&gt;&gt;25 then (total/paid_unit_amount)*25 &#13;
                            when sr.paid_unit=&quot;PER_KM&quot; and t.country_code in (&apos;ds_bo&apos;,&apos;co&apos;,&apos;uy&apos;) and scoring.paid_unit_amount&gt;&gt;15 then (total/paid_unit_amount)*15 &#13;
                            when sr.paid_unit=&quot;PER_KM&quot; and t.country_code in (&apos;bo&apos;,&apos;cl&apos;,&apos;py&apos;,&apos;do&apos;,&apos;ar&apos;,&apos;pa&apos;) and scoring.paid_unit_amount&gt;&gt;10 then (total/paid_unit_amount)*10 &#13;
                            else total &#13;
                           end) as FLOAT64) as pago&#13;
          FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t,&#13;
              unnest(payment_details.scoring) scoring, &#13;
            dates&#13;
            LEFT JOIN  `peya-data-origins-pro.cl_hurrier.payments_scoring_rules` as sr&#13;
                  on sr.id=scoring.payment_rule_id and sr.country_code = t.country_code&#13;
