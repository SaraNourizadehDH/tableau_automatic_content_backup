      <column caption='Date' datatype='date' name='[Calculation_7743095156958453760]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parámetro 1], [registered_date]))' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_7743095156958789633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([courier_order_id])' />
      </column>
      <column caption='Payment Method' datatype='string' name='[Calculation_7743095156958994434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([collect_from_customer] &gt;0) THEN &quot;Cash on Dropoff&quot; ELSE &quot;Online Payment&quot; END' />
      </column>
      <column caption='Week' datatype='date' datatype-customized='true' name='[Calculation_7743095156967555076]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [registered_date]))' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_7743095156968599557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([order_status] != &quot;CONFIRMED&quot;) THEN [courier_order_id] END) / [Calculation_7743095156958789633]' />
      </column>
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_7743095156969172998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_accepted])/SUM([total_notified])' />
      </column>
