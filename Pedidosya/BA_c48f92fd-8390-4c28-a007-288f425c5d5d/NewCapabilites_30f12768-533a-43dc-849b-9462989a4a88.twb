          <named-connection caption='BigQuery' name='bigquery.0j7478i1sgo6wu13bui550cq5cmp'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='user_francisco_fasan' server-oauth='' username='francisco.fasan@pedidosya.com' workgroup-auth-mode='prompt' />
