      <aliases enabled='yes' />
      <column caption='Week' datatype='date' datatype-customized='true' name='[Calculation_-3868592064290373632]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_-5169850883735228416]))' />
      </column>
      <column caption='Direct Logistic CPO' datatype='real' name='[Calculation_-5169850883504381937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 2] = &apos;local&apos;) THEN [total_payments_direct]&#13;&#10;ELSEIF ([Parameters].[Parámetro 2] = &apos;euro&apos;) THEN [total_payments_direct]/[rate_eu] END' />
      </column>
      <column caption='Delivery Fee' datatype='real' name='[Calculation_-5169850883505213426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 2] = &apos;local&apos;) THEN (IF ([order_status] = &apos;CONFIRMED&apos;) THEN [total_gross] / (1 + [percentage_tax]) END)&#13;&#10;ELSEIF ([Parameters].[Parámetro 2] = &apos;euro&apos;) THEN (IF ([order_status] = &apos;CONFIRMED&apos;) THEN ([total_gross] / (1 + [percentage_tax]))/[rate_eu] END) END' />
      </column>
      <column caption='Avg. Margin' datatype='real' name='[Calculation_-5169850883525095412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_-5169850883526561782] - [Calculation_-5169850883526098933]' />
      </column>
      <column caption='Avg. Direct Logistic CPO' datatype='real' name='[Calculation_-5169850883526098933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_-5169850883504381937])' />
      </column>
      <column caption='Avg. Delivery Fee' datatype='real' name='[Calculation_-5169850883526561782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_-5169850883505213426])' />
      </column>
      <column caption='% diff in Avg Distance' datatype='real' name='[Calculation_-5169850883529781239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_-5169850883530588152]/[Calculation_-5169850883530792953] - 1) * -1' />
      </column>
      <column caption='Avg. Dropoff Distances (w/ stacking)' datatype='real' name='[Calculation_-5169850883530588152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dropoff_distance_manhattan])' />
      </column>
      <column caption='Avg. Dropoff Distance (w/o stacking)' datatype='real' name='[Calculation_-5169850883530792953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([delivery_distance])' />
      </column>
      <column caption='% stacked orders' datatype='real' name='[Calculation_-5169850883531673594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([is_stacked]) THEN [courier_order_id] END) / [Calculation_-5169850883735064575]' />
      </column>
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_-5169850883729477628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_accepted]) / SUM([total_notifications])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_-5169850883730673661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([order_status] != &apos;CONFIRMED&apos;) THEN [courier_order_id] END) / [Calculation_-5169850883735064575]' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_-5169850883735064575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([courier_order_id])' />
      </column>
      <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_-5169850883735228416]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parámetro 1], [date]))' />
      </column>
