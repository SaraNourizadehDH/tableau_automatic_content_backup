foc.country.country_name ,&#13;
CASE WHEN delivery_mode IS NULL THEN &quot;ON_DEMAND&quot; ELSE delivery_mode END as delivery_mode,&#13;
logistics.payment.total_gross,&#13;
pay.country_code_cost,&#13;
pay.total_payments_direct,&#13;
cu.currency_iso as currency_code,&#13;
  cd.percentage_tax_logistics as percentage_tax,&#13;
  cu.rate_eu,&#13;
flo.promised_delivery_time_local,&#13;
del.rider_picked_up_at_local,&#13;
foc.time_before_close,&#13;
MAX(CASE WHEN del.is_primary THEN del.delivery_distance END) AS delivery_distance,&#13;
MAX(CASE WHEN del.is_primary THEN del.dropoff_distance_manhattan END) AS dropoff_distance_manhattan,&#13;
SUM(trans.transition_notified) AS total_notifications,&#13;
SUM(trans.transition_accepted) AS total_accepted,&#13;
