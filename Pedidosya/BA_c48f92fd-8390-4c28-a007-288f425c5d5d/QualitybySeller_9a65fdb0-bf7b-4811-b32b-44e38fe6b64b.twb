            <column caption='color orders day 60 90' datatype='string' name='[color orders day 30 60 (copia)_998673244101427205]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN([orders Day30-60 (copia)_998673244101107716]) - LOOKUP(ZN([orders Day30-60 (copia)_998673244101107716]), -1)) / ABS(LOOKUP(ZN([orders Day30-60 (copia)_998673244101107716]), -1))&gt;0 then &quot;verde&quot;&#13;&#10;ELSEIF  ISNULL((ZN([orders Day30-60 (copia)_998673244101107716]) - LOOKUP(ZN([orders Day30-60 (copia)_998673244101107716]), -1)) / ABS(LOOKUP(ZN([orders Day30-60 (copia)_998673244101107716]), -1))) then &quot;null&quot;&#13;&#10;else &quot;rojo&quot;&#13;&#10;end'>
