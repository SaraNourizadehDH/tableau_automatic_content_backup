                <zone fixed-size='264' h='7333' id='292' is-fixed='true' name='yoy Color Day 60-90 (2)' show-title='false' w='1928' x='95072' y='6529'>
                  <layout-cache cell-count-w='2' type-h='fixed' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
