            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05iwl6405ckdqs16qza1v0gydmin'>
            <column datatype='integer' name='[ActiveM3]' role='measure' type='quantitative' />
            <column datatype='integer' name='[ActiveM3_LY]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Day 61-90 YOY' datatype='real' name='[Day 61-90 (copia)_1518557531400151055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((sum([ActiveM3])/SUM([NewOnlines]))&#13;&#10;/&#13;&#10;(sum([ActiveM3_LY])/sum([NewOnlines_LY])))&#13;&#10;-1' />
            </column>
            <column caption='Filtro M3color' datatype='boolean' name='[Filtro M2 color  (copia)_895371927378280469]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;,[month],[Parameters].[Parámetro 3])&gt;=3&#13;&#10;AND DATEDIFF(&apos;month&apos;,[month],[Parameters].[Parámetro 3])&lt;=4&#13;&#10;THEN TRUE&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[NewOnlines]' role='measure' type='quantitative' />
