            <column caption='Filtro M3 1' datatype='boolean' name='[Filtro M2 (copia)_895371927375220754]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;,[month],[Parameters].[Parámetro 3])&gt;=3&#13;&#10;AND DATEDIFF(&apos;month&apos;,[month],[Parameters].[Parámetro 3])&lt;=8&#13;&#10;THEN TRUE&#13;&#10;END' />
