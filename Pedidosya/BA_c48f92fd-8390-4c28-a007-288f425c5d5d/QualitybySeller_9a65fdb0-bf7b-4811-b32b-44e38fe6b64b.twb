    <worksheet name='Seller - Day 1-30'>
      <table>
        <view>
          <datasources>
            <datasource caption='New Partners Query' name='federated.05iwl6405ckdqs16qza1v0gydmin' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.05iwl6405ckdqs16qza1v0gydmin].[month]' caption='Month Parameter' datatype='date' default-format='*MMM-YY' name='[Parámetro 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-03-01#'>
              <calculation class='tableau' formula='#2023-03-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05iwl6405ckdqs16qza1v0gydmin'>
            <column datatype='integer' name='[ActiveM1]' role='measure' type='quantitative' />
            <column caption='Day 1-30' datatype='real' name='[Calculation_895371927364177928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ActiveM1])/SUM([NewOnlines])' />
            </column>
            <column caption='Filtro M1 1' datatype='boolean' name='[Calculation_895371927367393289]' role='dimension' type='nominal'>
