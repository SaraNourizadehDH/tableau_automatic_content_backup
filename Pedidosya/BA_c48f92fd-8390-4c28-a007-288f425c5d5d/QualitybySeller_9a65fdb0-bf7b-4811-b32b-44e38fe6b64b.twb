            <column caption='Filtro Flechas YoY/MoM' datatype='boolean' name='[Calculation_239535242532155396]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month]&lt;=[Parameters].[Parámetro 3]&#13;&#10;AND&#13;&#10;[month] &gt;=DATEADD(&apos;month&apos;,-1,[Parameters].[Parámetro 3])' />
            </column>
            <column caption='Color new onlines YOY ' datatype='string' name='[Color new onlines (copia)_1518557530735173639]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN([NewOnlines MoM (copia)_1518557530731757574]) - LOOKUP(ZN([NewOnlines MoM (copia)_1518557530731757574]), -1)) / ABS(LOOKUP(ZN([NewOnlines MoM (copia)_1518557530731757574]), -1))&gt;0 THEN &quot;VERDE&quot;&#13;&#10;ELSEIF ISNULL((ZN([NewOnlines MoM (copia)_1518557530731757574]) - LOOKUP(ZN([NewOnlines MoM (copia)_1518557530731757574]), -1)) / ABS(LOOKUP(ZN([NewOnlines MoM (copia)_1518557530731757574]), -1))) THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;ROJO&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='NewOnlines YoY' datatype='real' name='[NewOnlines MoM (copia)_1518557530731757574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([NewOnlines])-sum([NewOnlines_LY]))/sum([NewOnlines_LY])' />
            </column>
