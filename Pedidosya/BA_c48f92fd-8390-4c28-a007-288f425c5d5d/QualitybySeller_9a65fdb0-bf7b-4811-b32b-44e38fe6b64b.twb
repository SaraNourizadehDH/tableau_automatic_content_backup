            <column caption='color day 60-90 yoy' datatype='string' name='[color day 60-90 (copia)_1518557531404075024]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN([Day 61-90 (copia)_1518557531400151055]) - LOOKUP(ZN([Day 61-90 (copia)_1518557531400151055]), -1)) / ABS(LOOKUP(ZN([Day 61-90 (copia)_1518557531400151055]), -1))&gt;0 then &quot;verde&quot;&#13;&#10;ELSEIF  ISNULL((ZN([Day 61-90 (copia)_1518557531400151055]) - LOOKUP(ZN([Day 61-90 (copia)_1518557531400151055]), -1)) / ABS(LOOKUP(ZN([Day 61-90 (copia)_1518557531400151055]), -1))) then &quot;null&quot;&#13;&#10;else &quot;rojo&quot;&#13;&#10;end'>
                <table-calc ordering-type='Rows' />
