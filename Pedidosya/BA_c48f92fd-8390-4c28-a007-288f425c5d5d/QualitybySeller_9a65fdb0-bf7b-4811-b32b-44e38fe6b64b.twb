            <zone fixed-size='24' forceUpdate='true' h='667' id='634' is-fixed='true' type-v2='text' w='98572' x='714' y='46165'>
              <formatted-text>
                <run fontcolor='#ffffff'>BLANK SPACE</run>
              </formatted-text>
              <zone-style>
