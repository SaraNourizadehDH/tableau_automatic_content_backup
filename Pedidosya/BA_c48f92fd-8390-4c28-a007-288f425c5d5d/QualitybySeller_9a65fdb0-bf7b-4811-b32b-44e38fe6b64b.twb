    <datasource caption='New Partners Query' inline='true' name='federated.05iwl6405ckdqs16qza1v0gydmin' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0nkn0j51gtdnvx13ytby21mvksaw'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='automated_tables_reports' server-oauth='' username='yamileth.cabrera@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0nkn0j51gtdnvx13ytby21mvksaw' name='Consulta SQL personalizada2' type='text'><![CDATA[/* M0,M1,M2 */

WITH M0 AS (

SELECT 

  sp.Salesforce_ID as Grid,
  
  CASE
    WHEN COUNT(DISTINCT o.order_id)>>=1 then TRUE
    WHEN COUNT(DISTINCT o.order_id) IS NULL THEN FALSE 
    ELSE FALSE 
  END AS ActiveM0,
  
  COUNT(DISTINCT o.order_id) AS OrdersM0

FROM `peya-delivery-and-support.automated_tables_reports.salesplanning` sp

LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` cw
  ON sp.salesforce_id=cw.grid

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
  on dp.salesforce_id=sp.salesforce_id

LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` o
  ON o.restaurant.id=dp.partner_id

WHERE date_trunc(o.registered_date,month)=DATE_trunc(date(cw.closed_date),month)
  AND (Is_New_Online=true or Winbacks=true) = true
  AND is_concept = false
  and is_kitchen=false

  AND o.order_status = 'CONFIRMED'
  AND o.registered_date>>DATE('2021-01-01')

GROUP BY 1

),

M1 AS (
  SELECT 
sp.Salesforce_ID as Grid,
CASE WHEN COUNT(DISTINCT o.order_id)>>=1 then TRUE
WHEN COUNT(DISTINCT o.order_id) IS NULL THEN FALSE ELSE FALSE END AS ActiveM1,
COUNT(DISTINCT o.order_id) AS OrdersM1
FROM `peya-delivery-and-support.automated_tables_reports.salesplanning` sp
LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` cw
ON sp.salesforce_id=cw.grid
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
on dp.salesforce_id=sp.salesforce_id
LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` o
ON o.restaurant.id=dp.partner_id
WHERE DATE_TRUNC(o.registered_date,MONTH)=DATE_TRUNC(DATE_ADD(date(cw.closed_date),INTERVAL 1 MONTH),MONTH)
AND o.order_status = 'CONFIRMED'
AND o.registered_date>>DATE('2021-01-01')
AND (Is_New_Online=true or Winbacks=true) = true
AND is_concept = false
and is_kitchen=false
GROUP BY 1
ORDER BY 2 ASC
),

M2 AS (
   
SELECT 
sp.Salesforce_ID as Grid,
CASE WHEN COUNT(DISTINCT o.order_id)>>=1 then TRUE
WHEN COUNT(DISTINCT o.order_id) IS NULL THEN FALSE ELSE FALSE END AS ActiveM2,
COUNT(DISTINCT o.order_id) AS OrdersM2
FROM `peya-delivery-and-support.automated_tables_reports.salesplanning` sp
LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` cw
ON sp.salesforce_id=cw.grid
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
on dp.salesforce_id=sp.salesforce_id
LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` o
ON o.restaurant.id=dp.partner_id
WHERE DATE_TRUNC(o.registered_date,MONTH)=DATE_TRUNC(DATE_ADD(date(cw.closed_date),INTERVAL 2 MONTH),MONTH)
AND o.order_status = 'CONFIRMED'
AND o.registered_date>>DATE('2021-01-01')
AND (Is_New_Online=true or Winbacks=true) = true
AND is_concept = false
and is_kitchen=false
GROUP BY 1
ORDER BY 2 ASC
),

Base AS (

select 

  sp.salesforce_id as Grid,
  DATE(max(cw.closed_date)) AS CloseDate,
  ActiveM0,
  ActiveM1, 
  ActiveM2,
  OrdersM0,
  OrdersM1,
  OrdersM2

FROM `peya-delivery-and-support.automated_tables_reports.salesplanning` sp

LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` cw
  ON sp.salesforce_id=cw.grid

LEFT JOIN m0 
  on m0.grid=sp.salesforce_id
LEFT JOIN M1 
  on m1.grid=sp.salesforce_id
LEFT JOIN M2 
  on m2.grid=sp.salesforce_id

where (Is_New_Online=true or Winbacks=true) = true
  AND Concept_Name is null
  AND Kitchen_Name is null

GROUP BY 1,3,4,5,6,7,8

), 



final as (

select

  sp.month,
  SP.salesforce_id as Grid,
  sp.country_name,
  Is_Food_OR_LS_OR_COURIER,
  
-- Nuevo (con must have)        
  CASE
    WHEN sp.salesforce_id IN (SELECT Grid FROM `peya-food-and-groceries.automated_tables_reports.must have partners grids nativa`) THEN 'Must Have'
    WHEN sp.Source_General="Self Sign Up" THEN "SSU" 
    ELSE "Field"
  END AS Chanel,

-- -- Viejo (sin must have)
--   CASE
--     WHEN sp.Source_General="Self Sign Up" THEN "SSU" 
--     -- WHEN sp.Source_General<<>>"Self Sign Up" AND sp.salesforce_id = mh.grid THEN "Must Have" -- quitamos must have hasta nuevo aviso 
--     ELSE "Field"
--   END AS Chanel,
  
  CloseDate,
  
  CASE
    WHEN ActiveM0 IS NULL THEN FALSE
    ELSE ACTIVEM0
  END AS ACTIVEM0,
  
  OrdersM0,
  
  CASE
    WHEN ActiveM1 IS NULL THEN FALSE 
    ELSE ACTIVEM1
  END AS ACTIVEM1,
  
  OrdersM1,
  
  CASE
    WHEN ActiveM2 IS NULL THEN FALSE
    ELSE ACTIVEM2
  END AS ACTIVEM2,
  
  OrdersM2

from `peya-delivery-and-support.automated_tables_reports.salesplanning` sp

left join `peya-data-origins-pro.cl_salesforce.account` a
  on sp.Salesforce_ID=a.GRID
LEFT JOIN BASE 
  on base.grid=sp.Salesforce_ID
-- left join `peya-food-and-groceries.automated_tables_reports.must have partners grids nativa` mh
--   on sp.Salesforce_ID=mh.grid

where (Is_New_Online=true or Winbacks=true) = true
  AND Concept_Name is null
  AND Kitchen_Name is null


),


def as (

SELECT

  Month,
  DATE_ADD(Month,INTERVAL 1 MONTH) AS M1,
  DATE_ADD(Month,INTERVAL 2 MONTH) AS M2,
  DATE_ADD(Month,INTERVAL -12 MONTH) AS LY,
  country_name,
  Is_Food_OR_LS_OR_COURIER,
  chanel,
  COUNT(DISTINCT CASE WHEN ACTIVEM0=true THEN GRID END) AS ActiveM0,
  COUNT(DISTINCT CASE WHEN ACTIVEM1=TRUE THEN GRID END) AS ActiveM1,
  COUNT(DISTINCT CASE WHEN ACTIVEM2=TRUE THEN GRID END) AS ActiveM2,
  SUM(OrdersM0) AS OrdersM0,
  SUM(OrdersM1) AS OrdersM1,
  SUM(OrdersM2) AS OrdersM2

FROM FINAL f

GROUP BY 1,2,3,4,5,6,7

)

,finalfinal as (

select

  a.*,
  b.ordersM1 as DEF_ORDERSM1,
  c.ordersm2 as def_ordersm2 

FROM def a

LEFT JOIN def b
  on a.month=b.M1
  and a.country_name=b.country_name
  and a.Is_Food_OR_LS_OR_COURIER=b.Is_Food_OR_LS_OR_COURIER
  and a.chanel=b.chanel

LEFT JOIN def c
  on a.month=c.M2
  and a.country_name=c.country_name 
  and a.Is_Food_OR_LS_OR_COURIER=c.Is_Food_OR_LS_OR_COURIER 
  and a.chanel=c.chanel


)

select 

  a.*,
  b.ordersm0 as OrdersM0_LY,
  -- b.ordersm1 as OrdersM1_LY,
  b.DEF_ORDERSM1 as OrdersM1_LY,
  -- b.ordersm2 as OrdersM2_LY,
  b.def_ordersm2 as OrdersM2_LY,

from finalfinal a

left join finalfinal b
  on a.LY=b.month
  and a.country_name=b.country_name
  and a.Is_Food_OR_LS_OR_COURIER=b.Is_Food_OR_LS_OR_COURIER
  and a.chanel=b.chanel]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
