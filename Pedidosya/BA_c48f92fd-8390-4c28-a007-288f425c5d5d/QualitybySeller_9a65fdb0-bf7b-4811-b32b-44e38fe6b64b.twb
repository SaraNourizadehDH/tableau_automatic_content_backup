      <column caption='Orders MoM' datatype='real' name='[Active MoM (copia)_1518557530431746050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders])-SUM([orders_LM]))/&#13;&#10;SUM([orders_LM])' />
      </column>
      <column caption='Orders YoY ' datatype='real' name='[Active YoY (copia)_1518557530434347011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders])-SUM([orders_LY]))/&#13;&#10;SUM([orders_LY])' />
      </column>
      <column caption='Active MoM' datatype='real' name='[Active YoY (copia)_511440058075336707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Active_Partners])-SUM([Active_Partners_LM]))/&#13;&#10;SUM([Active_Partners_LM])' />
      </column>
      <column caption='Orders' datatype='string' name='[Calculation_1518557530428665856]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([orders])/1000000&gt;1 THEN&#13;&#10;STR(ROUND(SUM([orders])/1000000,2))+&quot;M&quot;&#13;&#10;ELSEIF SUM([orders])/1000&gt;1 THEN&#13;&#10; STR(ROUND(SUM([orders])/1000,2))+&quot;K&quot;&#13;&#10;ELSE &#13;&#10;STR(ROUND(SUM([orders]),0))&#13;&#10;END' />
      </column>
      <column caption='Filtro Flechas' datatype='boolean' name='[Calculation_239535242526486529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month]=[Parameters].[Parámetro 3]' />
      </column>
      <column caption='Active YoY' datatype='real' name='[Calculation_511440058073001986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Active_Partners])-SUM([Active_Partners_LY]))/&#13;&#10;SUM([Active_Partners_LY])' />
      </column>
      <column caption='Regla forma Active' datatype='string' name='[Calculation_511440058078179333]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Active YoY (copia)_511440058075336707]&gt;0 THEN &quot;VERDE&quot;&#13;&#10;ELSE &quot;ROJO&quot;&#13;&#10;END' />
      </column>
      <column caption='Filtro 1' datatype='boolean' name='[Calculation_998673244148072456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[month],[Parameters].[Parámetro 3])&lt;([Parameters].[Parámetro 2])&#13;&#10;AND [month]&lt;=[Parameters].[Parámetro 3]' />
      </column>
      <column caption='FILTRO' datatype='boolean' name='[Calculation_998673244148641804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1]=&quot;6&quot; THEN [Calculation_998673244148072456]&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&quot;12&quot; THEN [Filtro 1 (copia)_998673244148322313]&#13;&#10;END' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_998673244166553623]' role='measure' type='ordinal'>
