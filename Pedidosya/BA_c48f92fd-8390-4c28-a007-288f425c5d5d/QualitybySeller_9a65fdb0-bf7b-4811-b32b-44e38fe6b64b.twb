      <column caption='Filtro 1 (L12M)' datatype='boolean' name='[Filtro 1 (copia)_935341381409075202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[month],[Parameters].[Month Parameter (copia)_935341381408542720])&lt;([Parameters].[Meses (copia)_935341381408870401])&#13;&#10;AND [month]&lt;=[Parameters].[Month Parameter (copia)_935341381408542720]' />
