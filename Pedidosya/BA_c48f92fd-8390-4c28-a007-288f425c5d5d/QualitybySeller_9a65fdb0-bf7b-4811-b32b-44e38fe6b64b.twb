                <zone fixed-size='264' h='7333' id='291' is-fixed='true' name='YOY Day 60-90 partners Trend (2)' show-title='false' w='4143' x='90929' y='6529'>
                  <layout-cache type-h='fixed' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
