            <column caption='Filtro M3color' datatype='boolean' name='[Filtro M2 color  (copia)_895371927378280469]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;,[month],[Parameters].[Parámetro 3])&gt;=3&#13;&#10;AND DATEDIFF(&apos;month&apos;,[month],[Parameters].[Parámetro 3])&lt;=4&#13;&#10;THEN TRUE&#13;&#10;END' />
