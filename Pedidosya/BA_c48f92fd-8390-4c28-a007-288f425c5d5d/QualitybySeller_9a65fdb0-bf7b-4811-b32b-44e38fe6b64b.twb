            <column caption='Orders 60-90 colors' datatype='string' name='[Orders 30-60 colors (copia)_971088703895048194]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [orders Day30-60 (copia)_998673244101107716] &gt;= 30 THEN &apos;Verde&apos;&#13;&#10;ELSEIF [orders Day30-60 (copia)_998673244101107716] &gt;= 20 THEN &apos;Amarillo&apos;&#13;&#10;ELSEIF [orders Day30-60 (copia)_998673244101107716] &gt;= 10 THEN &apos;Naranja&apos;&#13;&#10;ELSEIF [orders Day30-60 (copia)_998673244101107716] &lt;10 THEN &apos;Rojo&apos;&#13;&#10;ELSE &apos;Rojo&apos;&#13;&#10;END' />
