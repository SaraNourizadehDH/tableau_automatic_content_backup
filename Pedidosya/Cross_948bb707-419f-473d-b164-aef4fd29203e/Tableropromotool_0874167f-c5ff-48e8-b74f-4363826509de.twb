      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_F101BAB755DD42F0A3D20382B6A48D56'>
            <properties context=''>
              <relation connection='bigquery.1egth2n031ypsd1c0uku31nwn22f' name='Consulta SQL personalizada' type='text'>select&#13;
    registered_date&#13;
    ,t.partner_id&#13;
    ,c.campaign_id&#13;
    ,c.campaign_name&#13;
    ,case when t.barcodes is null then skus else barcodes end skus&#13;
    ,t.product_name&#13;
    ,case&#13;
      when t.sponsorship_party = &apos;vendor&apos; THEN &apos;LOCAL_STORE&apos;&#13;
      when t.sponsorship_party = &apos;platform&apos; THEN &apos;COMPANY&apos;&#13;
      when t.sponsorship_party = &apos;third_party&apos; THEN &apos;PARTNERSHIP&apos;&#13;
      end paid_by&#13;
    ,COUNT(DISTINCT t.order_id) as total_orders&#13;
    ,sum(t.product_quantity) total_units_sold&#13;
    ,round(sum(sponsorship_paid_amount/ce.rate_eu),2) discount_amount_eur&#13;
&#13;
  from `peya-bi-tools-pro.il_qcommerce.promo_tool_transactions` t&#13;
&#13;
  left join (select distinct campaign_id, campaign_name, product_name, skus from`peya-bi-tools-pro.il_qcommerce.promo_tool_campaigns`) c&#13;
    on t.campaign_id = c.campaign_id&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce&#13;
    ON ce.currency_id = t.currency_id&#13;
    AND ce.currency_exchange_date = DATE_TRUNC(t.registered_date,MONTH)&#13;
  &#13;
  where t.product_name is not null&#13;
&#13;
  group by 1,2,3,4,5,6,7&#13;
&#13;
  order by 8 desc</relation>
            </properties>
          </object>
          <object caption='promotools_orders' id='promotools_orders_936858E5159840A1985684B3ED192273'>
            <properties context='extract'>
              <relation name='promotools_orders_936858E5159840A1985684B3ED192273' table='[Extract].[promotools_orders_936858E5159840A1985684B3ED192273]' type='table' />
