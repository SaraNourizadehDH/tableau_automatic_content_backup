        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1egth2n031ypsd1c0uku31nwn22f'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='automated_tables_reports' server-oauth='' username='maria.alvarez.2@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1egth2n031ypsd1c0uku31nwn22f' name='Consulta SQL personalizada' type='text'>select&#13;
    registered_date&#13;
    ,t.partner_id&#13;
    ,c.campaign_id&#13;
    ,c.campaign_name&#13;
    ,case when t.barcodes is null then skus else barcodes end skus&#13;
    ,t.product_name&#13;
    ,case&#13;
      when t.sponsorship_party = &apos;vendor&apos; THEN &apos;LOCAL_STORE&apos;&#13;
      when t.sponsorship_party = &apos;platform&apos; THEN &apos;COMPANY&apos;&#13;
      when t.sponsorship_party = &apos;third_party&apos; THEN &apos;PARTNERSHIP&apos;&#13;
      end paid_by&#13;
    ,COUNT(DISTINCT t.order_id) as total_orders&#13;
    ,sum(t.product_quantity) total_units_sold&#13;
    ,round(sum(sponsorship_paid_amount/ce.rate_eu),2) discount_amount_eur&#13;
&#13;
  from `peya-bi-tools-pro.il_qcommerce.promo_tool_transactions` t&#13;
&#13;
  left join (select distinct campaign_id, campaign_name, product_name, skus from`peya-bi-tools-pro.il_qcommerce.promo_tool_campaigns`) c&#13;
    on t.campaign_id = c.campaign_id&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce&#13;
    ON ce.currency_id = t.currency_id&#13;
    AND ce.currency_exchange_date = DATE_TRUNC(t.registered_date,MONTH)&#13;
  &#13;
  where t.product_name is not null&#13;
&#13;
  group by 1,2,3,4,5,6,7&#13;
&#13;
  order by 8 desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1egth2n031ypsd1c0uku31nwn22f' name='vfd_partner_info' table='[peya-food-and-groceries.automated_tables_reports].[vfd_partner_info]' type='table' />
          <relation connection='bigquery.1egth2n031ypsd1c0uku31nwn22f' name='promotools_product_orders' table='[peya-food-and-groceries.automated_tables_reports].[promotools_product_orders]' type='table' />
          <relation connection='bigquery.1egth2n031ypsd1c0uku31nwn22f' name='Consulta SQL personalizada' type='text'>select&#13;
    registered_date&#13;
    ,t.partner_id&#13;
    ,c.campaign_id&#13;
    ,c.campaign_name&#13;
    ,case when t.barcodes is null then skus else barcodes end skus&#13;
    ,t.product_name&#13;
    ,case&#13;
      when t.sponsorship_party = &apos;vendor&apos; THEN &apos;LOCAL_STORE&apos;&#13;
      when t.sponsorship_party = &apos;platform&apos; THEN &apos;COMPANY&apos;&#13;
      when t.sponsorship_party = &apos;third_party&apos; THEN &apos;PARTNERSHIP&apos;&#13;
      end paid_by&#13;
    ,COUNT(DISTINCT t.order_id) as total_orders&#13;
    ,sum(t.product_quantity) total_units_sold&#13;
    ,round(sum(sponsorship_paid_amount/ce.rate_eu),2) discount_amount_eur&#13;
&#13;
  from `peya-bi-tools-pro.il_qcommerce.promo_tool_transactions` t&#13;
&#13;
  left join (select distinct campaign_id, campaign_name, product_name, skus from`peya-bi-tools-pro.il_qcommerce.promo_tool_campaigns`) c&#13;
    on t.campaign_id = c.campaign_id&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce&#13;
    ON ce.currency_id = t.currency_id&#13;
    AND ce.currency_exchange_date = DATE_TRUNC(t.registered_date,MONTH)&#13;
  &#13;
  where t.product_name is not null&#13;
&#13;
  group by 1,2,3,4,5,6,7&#13;
&#13;
  order by 8 desc</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
