            </properties>
          </object>
          <object caption='Consulta SQL personalizada' id='_4B07AF8495C848F89AB25B9A42A59BD8'>
            <properties context=''>
              <relation connection='bigquery.16hwmm41mi3xks14ewgp20dtkg7y' name='Consulta SQL personalizada' type='text'>SELECT&#13;
  p.partner_id,&#13;
  DATE_TRUNC(p.salesforce_date, MONTH) AS date_month,&#13;
  p.country_name,&#13;
  IF(p.is_strategic_partner, 1, 0) AS strategic_partners&#13;
FROM&#13;
  `peya-food-and-groceries.automated_tables_reports.new_winback_partners` AS p&#13;
WHERE&#13;
  p.salesforce_date &gt;&gt;= &quot;2022-06-01&quot;&#13;
GROUP BY&#13;
  1, 2, 3, 4&#13;
ORDER BY&#13;
  1 DESC, 2, 3</relation>
            </properties>
            <properties context='extract'>
              <relation name='_4B07AF8495C848F89AB25B9A42A59BD8' table='[Extract].[_4B07AF8495C848F89AB25B9A42A59BD8]' type='table' />
            </properties>
          </object>
        </objects>
