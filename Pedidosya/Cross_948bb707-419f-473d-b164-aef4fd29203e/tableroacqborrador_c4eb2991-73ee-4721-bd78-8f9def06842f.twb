        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.16hwmm41mi3xks14ewgp20dtkg7y' name='ACQ_LU' table='[peya-food-and-groceries.automated_tables_reports].[ACQ_LU]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.16hwmm41mi3xks14ewgp20dtkg7y' name='ACQ_LU' table='[peya-food-and-groceries.automated_tables_reports].[ACQ_LU]' type='table' />
          <relation connection='bigquery.16hwmm41mi3xks14ewgp20dtkg7y' name='Consulta SQL personalizada' type='text'>SELECT&#13;
  p.partner_id,&#13;
  DATE_TRUNC(p.salesforce_date, MONTH) AS date_month,&#13;
  p.country_name,&#13;
  IF(p.is_strategic_partner, 1, 0) AS strategic_partners&#13;
FROM&#13;
  `peya-food-and-groceries.automated_tables_reports.new_winback_partners` AS p&#13;
WHERE&#13;
  p.salesforce_date &gt;&gt;= &quot;2022-06-01&quot;&#13;
GROUP BY&#13;
  1, 2, 3, 4&#13;
ORDER BY&#13;
  1 DESC, 2, 3</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
