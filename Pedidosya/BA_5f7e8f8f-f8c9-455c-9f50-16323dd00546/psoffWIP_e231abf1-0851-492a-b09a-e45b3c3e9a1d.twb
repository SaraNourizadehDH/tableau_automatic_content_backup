    <datasource caption='resolved' inline='true' name='federated.0moli7e02bgxkm12sximf0yhenbk' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1cmbxah0ycdyro1abv2y61rx4aer'>
            <connection CATALOG='peya-argentina' EXECCATALOG='peya-argentina' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-argentina' schema='automated_tables_reports' server='' server-oauth='' username='sebastian.diazdevaldes@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1cmbxah0ycdyro1abv2y61rx4aer' name='Consulta SQL personalizada' type='text'><![CDATA[select 

IFNULL(date(resolved_date),date(closed_date)) AS fecha,

lob,
Key_account,
case 
    when LOB in ('Content NV') AND Key_account in ('falso','0') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 12  then 'in_cycle'
    when LOB in ('Content NV') AND Key_account in ('falso','0') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 12  then 'out_cycle'

    when LOB in ('Content NV') AND Key_account in ('verdadero','1') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 6  then 'in_cycle'
    when LOB in ('Content NV') AND Key_account in ('verdadero','1') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 6  then 'out_cycle'
    
    when LOB in ('Content Off')AND Key_account in ('falso','0') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 12  then 'in_cycle'
    when LOB in ('Content Off')AND Key_account in ('falso','0') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 12  then 'out_cycle'

    when LOB in ('Content Off')AND Key_account in ('verdadero','1') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 6 then 'in_cycle'
    when LOB in ('Content Off')AND Key_account in ('verdadero','1') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 6 then 'out_cycle'

    when LOB in ('Content On') AND Key_account in ('No existe') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 24  then 'in_cycle'
    when LOB in ('Content On') AND Key_account in ('No existe') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 24 then 'out_cycle'

    when LOB in ('Livechat') AND Key_account in ('No existe') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 24  then 'in_cycle'
    when LOB in ('Livechat') AND Key_account in ('No existe') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 24  then 'out_cycle'

    when LOB in ('Onboarding Altas') AND Key_account in ('No existe') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 24 then 'in_cycle'
    when LOB in ('Onboarding Altas') AND Key_account in ('No existe') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 24 then 'out_cycle'

    when LOB in ('Onboarding QC') AND Key_account in ('No existe') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 24 then 'in_cycle'
    when LOB in ('Onboarding QC') AND Key_account in ('No existe') and DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 24 then 'out_cycle'

    when LOB in ('Pics') AND Key_account in ('falso','0') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 24 then 'in_cycle'
    when LOB in ('Pics') AND Key_account in ('falso','0') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) >> 24 then 'out_cycle'

    when LOB in ('Pics') AND Key_account in ('verdadero','1') and  DATETIME_DIFF((IFNULL(sf.resolved_date, sf.closed_date)), sf.create_date, HOUR) <<= 24 then 'in_cycle'
