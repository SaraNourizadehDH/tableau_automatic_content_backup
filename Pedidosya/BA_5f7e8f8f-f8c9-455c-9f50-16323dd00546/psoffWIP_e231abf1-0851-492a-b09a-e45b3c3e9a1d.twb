      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Argentina&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_694BC979BEBA497B897BAFB5286B109A'>
            <properties context=''>
              <relation connection='bigquery.0ytvjsr0q8nb0z127j1ie036k1j0' name='Consulta SQL personalizada' type='text'><![CDATA[select 
  fecha_extraccion as fecha_extraccion,
  lob,
  Key_account,

case 
    when LOB in ('Content NV') AND Key_account in ('falso','0') and antiguedad <<= 12  then 'in_cycle'
    when LOB in ('Content NV') AND Key_account in ('falso','0') and antiguedad >> 12  then 'out_cycle'

    when LOB in ('Content NV') AND Key_account in ('verdadero','1') and antiguedad <<= 6  then 'in_cycle'
    when LOB in ('Content NV') AND Key_account in ('verdadero','1') and antiguedad >> 6  then 'out_cycle'
    
    when LOB in ('Content Off')AND Key_account in ('falso','0') and antiguedad <<= 12  then 'in_cycle'
    when LOB in ('Content Off')AND Key_account in ('falso','0') and antiguedad >> 12  then 'out_cycle'

    when LOB in ('Content Off')AND Key_account in ('verdadero','1') and  antiguedad <<= 6 then 'in_cycle'
    when LOB in ('Content Off')AND Key_account in ('verdadero','1') and  antiguedad >> 6 then 'out_cycle'

    when LOB in ('Content On') AND Key_account in ('No existe') and antiguedad <<= 24  then 'in_cycle'
    when LOB in ('Content On') AND Key_account in ('No existe') and  antiguedad >> 24 then 'out_cycle'

    when LOB in ('Livechat') AND Key_account in ('No existe') and antiguedad <<= 24  then 'in_cycle'
    when LOB in ('Livechat') AND Key_account in ('No existe') and antiguedad >> 24  then 'out_cycle'

    when LOB in ('Onboarding Altas') AND Key_account in ('No existe') and  antiguedad <<= 24 then 'in_cycle'
    when LOB in ('Onboarding Altas') AND Key_account in ('No existe') and  antiguedad >> 24 then 'out_cycle'

    when LOB in ('Onboarding QC') AND Key_account in ('No existe') and antiguedad <<= 24 then 'in_cycle'
    when LOB in ('Onboarding QC') AND Key_account in ('No existe') and antiguedad >> 24 then 'out_cycle'

    when LOB in ('Pics') AND Key_account in ('falso','0') and  antiguedad <<= 24 then 'in_cycle'
    when LOB in ('Pics') AND Key_account in ('falso','0') and  antiguedad >> 24 then 'out_cycle'

    when LOB in ('Pics') AND Key_account in ('verdadero','1') and  antiguedad <<= 24 then 'in_cycle'
    when LOB in ('Pics') AND Key_account in ('verdadero','1')and  antiguedad >> 24 then 'out_cycle'


    end as cycle_type,


  ps.case_number,



  date(sf.create_date) as fecha_creacion,
  date(sf.last_modified_date) as fecha_ult_modificacion,

   
  sf.case_status,
  sf.case_type,
  sf.case_origin,
  sf.case_priority,

  user_name,
  us.Email,
  CASE
	 		WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='.vng@pedidosya.com'      THEN 'VN' 
	 		WHEN substring(us.Email, length(us.Email)-25, length(us.Email))='._vng.ext@pedidosya.com' THEN 'VN'
	 		WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='.mix@pedidosya.com'      THEN 'MIX'
	 		WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='.ndo@pedidosya.com'      THEN 'XTO'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_ndo.ext@pedidosya.com'  THEN 'XTO'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_mix.ext@pedidosya.com'  THEN 'MIX'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_maj.ext@pedidosya.com'  THEN 'MAJ'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_baj.ext@pedidosya.com'  THEN 'MAJ'
      WHEN substring(us.Email, length(us.Email)-18, length(us.Email))='_maj@pedidosya.com'      THEN 'MAJ'
	 		WHEN substring(us.Email, length(us.Email)-18, length(us.Email))='.maj@pedidosya.com'      THEN 'MAJ'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_alo.ext@pedidosya.com'  THEN 'ALO'
      WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='_alo@pedidosya.com'      THEN 'ALO'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_dyn.ext@pedidosya.com'  THEN 'DYN'
      WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_kon.ext@pedidosya.com'  THEN 'KON'
      WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_ccn.ext@pedidosya.com'  THEN 'CCN'
      WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_uby.ext@pedidosya.com'  THEN 'UBY'
      WHEN us.Email is null then 'Sin Asignar'

            else 'IH' end as Team,

  
  sf.case_subjec,
  case_button_name,
  case_reason_level_1,
  case_reason_level_2,
  case_reason_level_3,




    ps.antiguedad,
    1 as casos






from`peya-delivery-and-support.user_lionel_gallo.backlog_PS1` ps
left join `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` as sf on sf.case_number = ps.case_number
LEFT JOIN  `peya-data-origins-pro.cl_salesforce.user` us on us.Id =sf.user_id

where fecha_extraccion >>= date('2023-05-01')
  and create_date >>= date('2022-01-01') 


order by 1 desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
