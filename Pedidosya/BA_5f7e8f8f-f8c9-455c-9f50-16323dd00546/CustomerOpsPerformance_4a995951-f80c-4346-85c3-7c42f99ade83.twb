      <column caption='Fecha dinamica' datatype='datetime' name='[Calculation_1000925062984904704]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Total orders Parámetro] = &apos;year&apos; THEN&#13;&#10;    DATETRUNC(&apos;year&apos;, [created_date])&#13;&#10;ELSEIF [Parameters].[Total orders Parámetro] = &apos;month&apos; THEN&#13;&#10;    DATETRUNC(&apos;month&apos;, [created_date])&#13;&#10;ELSEIF [Parameters].[Total orders Parámetro] = &apos;day&apos; THEN&#13;&#10;    DATETRUNC(&apos;day&apos;, [created_date])&#13;&#10;ELSE&#13;&#10;    [created_date]&#13;&#10;END' />
      </column>
      <column caption='Total orders' datatype='integer' name='[Calculation_1324058335451107328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Automation rate' datatype='real' name='[Calculation_1850135072302047233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([orders_success_automation]) / COUNTD([orderIdaut])' />
      </column>
      <column caption='CSAT AC' datatype='real' name='[Calculation_2125699069514776576]' role='measure' type='quantitative'>
