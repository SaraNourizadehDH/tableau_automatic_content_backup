      <column caption='Contact Rate' datatype='real' name='[Calculation_2125699069526069250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2125699069525757953]/[Calculation_1324058335451107328]' />
      </column>
      <column caption='FCR sin miss chats' datatype='integer' name='[Calculation_2177490468465147904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([FCR (kpi_performance_orders)]) - SUM([is_missed_ind (kpi_performance_orders)])' />
      </column>
      <column caption='contacts sin miss chats' datatype='integer' name='[Calculation_2177490468465807361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2125699069525757953] - SUM([is_missed_ind (kpi_performance_orders)])' />
      </column>
