            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-paraguay' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_hurrier' server='' server-oauth='' username='lionel.gallo@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1aylmo103tl8a1116b3l30yaj6c0' name='Consulta_SQL_personalizada' type='text'><![CDATA[SELECT li.country_code, ld.order_id as order_id, li.delivery_id, li.rider_id, li.issue_type, li.issue_category, li.issue_name
  , li.created_at as created_at
  , li.picked_at as picked_at 
  , li.processed_at as processed_at
  , picked_by
  , li.resolved_at as resolved_at
FROM `peya-data-origins-pro.cl_hurrier.issues` li
left join 
(
select ho.rider.deliveries[SAFE_OFFSET(0)].id as delivery_id, ho.rider.order_id as order_id, ho.rider.deliveries[SAFE_OFFSET(0)].rider_id, ho.rider.country_code
            from `peya-data-origins-pro.cl_hurrier.orders_v2` AS ho
            where created_date >>= DATE_ADD(CURRENT_DATE, INTERVAL -1 MONTH) group by 1,2,3,4
) ld
	ON li.delivery_id = ld.delivery_id
	and li.country_code = ld.country_code
WHERE li.created_date >>= DATE_ADD(CURRENT_DATE, INTERVAL -1 MONTH)
AND li.show_on_watchlist = TRUE 
AND li.country_code <<>> 'co']]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1aylmo103tl8a1116b3l30yaj6c0' name='Consulta_SQL_personalizada' type='text'><![CDATA[SELECT li.country_code, ld.order_id as order_id, li.delivery_id, li.rider_id, li.issue_type, li.issue_category, li.issue_name
  , li.created_at as created_at
  , li.picked_at as picked_at 
  , li.processed_at as processed_at
  , picked_by
  , li.resolved_at as resolved_at
FROM `peya-data-origins-pro.cl_hurrier.issues` li
left join 
(
select ho.rider.deliveries[SAFE_OFFSET(0)].id as delivery_id, ho.rider.order_id as order_id, ho.rider.deliveries[SAFE_OFFSET(0)].rider_id, ho.rider.country_code
            from `peya-data-origins-pro.cl_hurrier.orders_v2` AS ho
            where created_date >>= DATE_ADD(CURRENT_DATE, INTERVAL -1 MONTH) group by 1,2,3,4
) ld
	ON li.delivery_id = ld.delivery_id
	and li.country_code = ld.country_code
WHERE li.created_date >>= DATE_ADD(CURRENT_DATE, INTERVAL -1 MONTH)
AND li.show_on_watchlist = TRUE 
AND li.country_code <<>> 'co']]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
