            <column caption='COR used' datatype='integer' name='[COR_used]' role='measure' type='quantitative' />
            <column caption='SUM([COR issued])/SUM([Orders Od])' datatype='real' name='[Calculation_1147854987764203526]' role='measure' type='quantitative' user:unnamed='Hoja 1'>
              <calculation class='tableau' formula='SUM([COR_issued])/SUM([orders_od])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_1147854988060676120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_gross_wo_subs_LC])/sum([orders_od])' />
            </column>
            <column caption='sum([COR amount used LC NO IVA])/sum([COR used])/[AFV]' datatype='real' name='[Calculation_1147854988062105627]' role='measure' type='quantitative' user:unnamed='Refunds'>
              <calculation class='tableau' formula='sum([COR_amount_used_LC_NO_IVA])/sum([COR_used])/[Calculation_1147854988060676120]' />
            </column>
            <column caption='RUNNING_SUM(SUM([COR used])/SUM([COR issued]))' datatype='real' name='[Calculation_1147854989532942371]' role='measure' type='quantitative' user:unnamed='Refunds'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([COR_used])/SUM([COR_issued]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
