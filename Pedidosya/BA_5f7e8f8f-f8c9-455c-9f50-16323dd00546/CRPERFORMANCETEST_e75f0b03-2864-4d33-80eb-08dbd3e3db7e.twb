      <column caption='COR amount issued LC' datatype='real' name='[COR_amount_issued_LC]' role='measure' type='quantitative' />
      <column caption='COR amount issued LC NO IVA' datatype='real' name='[COR_amount_issued_LC_NO_IVA]' role='measure' type='quantitative' />
      <column caption='COR amount used LC' datatype='real' name='[COR_amount_used_LC]' role='measure' type='quantitative' />
      <column caption='COR amount used LC NO IVA' datatype='real' name='[COR_amount_used_LC_NO_IVA]' role='measure' type='quantitative' />
      <column caption='COR destination' datatype='string' name='[COR_destination]' role='dimension' type='nominal' />
      <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
      <column caption='COR used' datatype='integer' name='[COR_used]' role='measure' type='quantitative' />
      <column caption='CPO recuperos' datatype='real' name='[Calculation_1147854987769970695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount])/sum([orders_od])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1147854988060676120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_gross_wo_subs_LC])/sum([orders_od])' />
      </column>
      <column caption='recuperables' datatype='integer' name='[Calculation_1147854989563711524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [CCR] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) THEN [COR_issued] ELSE 0 END' />
      </column>
      <column caption='% recuperable' datatype='real' name='[Calculation_1147854989564018725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1147854989563711524])/sum([COR_issued])' />
      </column>
      <column caption='CPO Refunds' datatype='real' name='[Calculation_1147854989565878310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([COR_amount_used_LC_NO_IVA])/sum([orders_od])' />
      </column>
      <column caption='Alcance' datatype='real' name='[Calculation_1147854989570818089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount])/sum([COR_amount_issued_LC])' />
      </column>
      <column caption='CPO spilled' datatype='real' name='[Calculation_1147854989591965741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([COR_amount_used_LC_NO_IVA])-sum([amount]))/sum([orders_od])' />
      </column>
      <column caption='vertical_grouped' datatype='string' name='[Calculation_1367686948003966976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([comp_or_ref] = &apos;Refunds&apos; AND [vertical_group] != &apos;DMART&apos;) AND [comp_or_ref] = &apos;Compensation&apos; THEN&#13;&#10;    &apos;FINANCIAL&apos;&#13;&#10;ELSE&#13;&#10;    [vertical_group]&#13;&#10;END' />
      </column>
      <column caption='care_amount_used_FX' datatype='real' name='[Calculation_1805662011054030849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[COR_amount_used_LC_NO_IVA]/[fx]' />
      </column>
      <column caption='CPO spilled FX' datatype='real' name='[Calculation_1805662011058892802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Calculation_1805662011054030849])-sum([Calculation_1805662011059859459]))/sum([orders_od])' />
      </column>
      <column caption='partner_amount_fx' datatype='real' name='[Calculation_1805662011059859459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[amount]/[fx (FX!data1)]' />
      </column>
      <column caption='CPO Refunds FX' datatype='real' name='[Calculation_1805662011116040196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1805662011054030849])/sum([orders_od])' />
      </column>
      <column caption='Recupero FX' datatype='real' name='[Calculation_1805662011124617222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1805662011059859459])' />
      </column>
      <column caption='total orders ' datatype='real' name='[Calculation_2313442869374873600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([orders_od]) / TOTAL(Sum([orders_od]))'>
          <table-calc ordering-field='[federated.15tvu1n1cxcc1j15l1n1w14kx63a].[country]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='gfv gross wo subs EU' datatype='real' name='[Calculation_2313442869375766530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gfv_gross_wo_subs_LC]/[fx (FX!data2)]' />
      </column>
      <column caption='AFV EU' datatype='real' name='[Calculation_2313442869375934467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2313442869375766530])/sum([orders_od])' />
      </column>
      <column caption='AFV pond' datatype='real' name='[Calculation_2313442869392732169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2313442869375934467]*[Calculation_2313442869374873600]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='test total latam' datatype='real' name='[Calculation_2313442869429219344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM([Calculation_2313442869374873600])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CPO recuperos FX' datatype='real' name='[Calculation_983192129782636545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1805662011059859459])/sum([orders_od])' />
      </column>
