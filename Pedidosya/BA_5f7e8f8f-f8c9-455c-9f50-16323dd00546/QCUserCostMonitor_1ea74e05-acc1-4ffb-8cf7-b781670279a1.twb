    <worksheet lock-quick-filters='true' name='Hoja 10 (4)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Top Cities - GMV PeYa</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='top_citys_QC (user_sebastian_diaz_2)' name='federated.10dg3of1rhttn510yrzqr1h3bh3j' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.10dg3of1rhttn510yrzqr1h3bh3j'>
            <column caption='% Instant Need' datatype='real' name='[% Fill in (copia)_1423981932503318532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_instant_need])/sum([confirmed_orders_groceries])' />
            </column>
            <column caption='% Stock Up' datatype='real' name='[% Instant Need (copia)_1423981932503478277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_stock_up])/sum([confirmed_orders_groceries])' />
            </column>
            <column caption='% QC' datatype='real' name='[Calculation_1423981932479868929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_QC])/sum([confirmed_orders_peya])' />
            </column>
            <column caption='% Fill in' datatype='real' name='[Calculation_1423981932496900099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_fill_in])/sum([confirmed_orders_groceries])' />
            </column>
            <column caption='Basket Size QC' datatype='real' name='[Calculation_1423981932505935878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qty_total_products_QC])/sum([confirmed_orders_QC])' />
            </column>
            <column caption='DT PeYa' datatype='real' name='[Calculation_1423981932506300423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt])/sum([confirmed_orders_peya])' />
            </column>
            <column caption='DT Dmart' datatype='real' name='[Calculation_1423981932506439688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_dmart])/sum([confirmed_orders_dmart])' />
            </column>
            <column caption='DT AAA' datatype='real' name='[Calculation_1423981932506656777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_aaa])/sum([confirmed_orders_AAA])' />
            </column>
            <column caption='FR Peya' datatype='real' name='[Calculation_1423981932507869197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1- sum([confirmed_orders_peya])/sum([total_orders_peya])' />
            </column>
            <column caption='FR Dmart' datatype='real' name='[FR Peya (copia)_1423981932508008462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1- sum([confirmed_orders_dmart])/sum([total_orders_dmart])' />
            </column>
            <column caption='FR AAA' datatype='real' name='[FR QC (copia)_1423981932510392335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1- sum([confirmed_orders_AAA])/sum([total_orders_AAA])' />
            </column>
            <column caption='Maus Aaa' datatype='integer' name='[MAUS_AAA]' role='measure' type='quantitative' />
            <column caption='Maus Qc' datatype='integer' name='[MAUS_QC]' role='measure' type='quantitative' />
            <column caption='MAUS dmart' datatype='integer' name='[MAUS_dmart]' role='measure' type='quantitative' />
            <column caption='MAUS groceries' datatype='integer' name='[MAUS_groceries]' role='measure' type='quantitative' />
            <column caption='MAUS peya' datatype='integer' name='[MAUS_peya]' role='measure' type='quantitative' />
            <column caption='VL AAA' datatype='real' name='[VL Dmart (copia)_1423981932507480076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vl_aaa])/sum([confirmed_orders_AAA])' />
            </column>
            <column caption='VL PeYa' datatype='real' name='[Vl (copia)_1423981932507000842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vl])/SUM([confirmed_orders_peya])' />
            </column>
            <column caption='VL Dmart' datatype='real' name='[Vl Qc (copia)_1423981932507013131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vl_dmart])/sum([confirmed_orders_dmart])' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[Geographical].[Longitude]'>
                <semantic-value key='&quot;3 de Febrero&quot;' value='-58.56606' />
