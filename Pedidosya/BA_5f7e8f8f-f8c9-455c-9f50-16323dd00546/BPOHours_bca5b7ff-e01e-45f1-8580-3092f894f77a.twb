    count(*) as total_chats,
       
    FROM (SELECT
    FC.department,
    DATE(DATETIME(FC.chat_created_at,'America/Montevideo')) AS fecha,
    DATETIME(FC.first_assigned_timestamp,'America/Montevideo') as horasposta,
    FC.dispatcher_email,
    FC.queue_time,
    
    TIMESTAMP_DIFF(fc.first_response_timestamp,fc.first_assigned_timestamp, SECOND) as first_reply_time
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` FC
    LEFT JOIN `peya-data-origins-pro.cl_gcc_service.freshdesk_tickets` FT on FT.interaction_id = FC.interaction_id
    WHERE DATE(FC.chat_created_at) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 month)
    AND FC.department in ('Rider')
    AND FC.automated_chat = 0
    AND FC.country not in ('Colombia')) a
    GROUP BY 1,2,3,4,5,6,7) i
    GROUP BY 1,2 

order by 1 desc, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
