    <datasource caption='RS' inline='true' name='federated.1y5q6ma1c4i8ra17xbe0y0oa4nfy' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.06icgwl0sal4mk19qkzwf18y7w74'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='automated_tables_reports' server='' server-oauth='' username='sebastian.diaz.2@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.06icgwl0sal4mk19qkzwf18y7w74' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT 
        DATE(i.fecha) AS  fecha,
     
(CASE WHEN substr(i.dispatcher_email, -22) = '_alo.ext@pedidosya.com' THEN 'ALO'
       WHEN substr(i.dispatcher_email, -22) = '_maj.ext@pedidosya.com' THEN 'MAJ'
        WHEN substr(i.dispatcher_email, -22) = '_ndo.ext@pedidosya.com' THEN 'XTO'
         WHEN substr(i.dispatcher_email, -22) = '_vng.ext@pedidosya.com' THEN 'VN'
          WHEN substr(i.dispatcher_email, -26) = '_ndo.ext.ext@pedidosya.com' THEN 'XTO'
           WHEN substr(i.dispatcher_email, -28) = 'leidy.cely.ext@pedidosya.com' THEN 'XTO'
            WHEN substr(i.dispatcher_email, -18) = '.vng@pedidosya.com' THEN 'VN'
             WHEN substr(i.dispatcher_email, -22) = '_ccn.ext@pedidosya.com' THEN 'CCN'
                WHEN substr(i.dispatcher_email, -22) = '_kon.ext@pedidosya.com' THEN 'KON'
                WHEN substr(i.dispatcher_email, -22) = '_dyn.ext@pedidosya.com' THEN 'DYN'
              WHEN substr(i.dispatcher_email, -18) = 'vng3@pedidosya.com' THEN 'VN'
               WHEN substr(i.dispatcher_email, -18) = '.maj@pedidosya.com' THEN 'MAJ'
                WHEN substr(i.dispatcher_email, -18) = '_maj@pedidosya.com' THEN 'MAJ'
                 WHEN substr(i.dispatcher_email, -18) = '.alo@pedidosya.com' THEN 'ALO'
                  WHEN substr(i.dispatcher_email, -18) = '.ndo@pedidosya.com' THEN 'XTO'
                   WHEN substr(i.dispatcher_email, -23) = '_ndo.ext1@pedidosya.com' THEN 'XTO'
                    WHEN substr(i.dispatcher_email, -17) = '.vn@pedidosya.com' THEN 'VN'
                     WHEN substr(i.dispatcher_email, -15) = '@appetito24.com' THEN 'APP' ELSE 'PEYA' END) AS Team,
    SUM(i.total_chats) AS total_chats,
    sum(CASE WHEN total_chats >> 0 THEN 1 ELSE 0 END)/2 as rs_horas_pr,
    
    FROM (SELECT
    a.department,
    DATE (a.fecha)  as fecha,
    EXTRACT(ISOWEEK FROM a.fecha) as semana,
    EXTRACT (MONTH FROM a.fecha) as mes,
    EXTRACT (HOUR FROM a.horasposta) AS HORAS ,
    CASE WHEN EXTRACT (MINUTE FROM a.horasposta) << 30 THEN '00:00' else '30:00' end AS MINUTOS,
    a.dispatcher_email,
    count(*) as total_chats,
       
    FROM (SELECT
    FC.department,
    DATE(DATETIME(FC.chat_created_at,'America/Montevideo')) AS fecha,
    DATETIME(FC.first_assigned_timestamp,'America/Montevideo') as horasposta,
    FC.dispatcher_email,
    FC.queue_time,
    
    TIMESTAMP_DIFF(fc.first_response_timestamp,fc.first_assigned_timestamp, SECOND) as first_reply_time
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` FC
    LEFT JOIN `peya-data-origins-pro.cl_gcc_service.freshdesk_tickets` FT on FT.interaction_id = FC.interaction_id
    WHERE DATE(FC.chat_created_at) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 month)
    AND FC.department in ('Rider')
    AND FC.automated_chat = 0
    AND FC.country not in ('Colombia')) a
    GROUP BY 1,2,3,4,5,6,7) i
    GROUP BY 1,2 

order by 1 desc, 2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
