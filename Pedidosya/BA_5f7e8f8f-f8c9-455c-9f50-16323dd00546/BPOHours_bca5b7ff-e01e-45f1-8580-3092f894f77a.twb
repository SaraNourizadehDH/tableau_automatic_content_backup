              <relation connection='bigquery.0b7togy14vwiuk16vcq2z1tf1mh4' name='Consulta SQL personalizada' type='text'><![CDATA[with casos_changes AS (
	SELECT
		DATE(ch.created_date) AS created_date,
		ca.user_id,
		ca.case_origin,
		ca.country_id,
		ch.new_value,
		ch.field		
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca

	LEFT JOIN (
		SELECT 
			cc.CaseId AS case_id,
			cc.NewValue AS new_value,
			cc.Field AS field,
			TIMESTAMP(DATETIME(cc.CreatedDate, cd.timezone)) AS created_date
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` cc
	
		LEFT JOIN (
			SELECT 
				case_id,
				country_id 
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
		) ca ON ca.case_id = cc.CaseId

		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
				ON cd.country_id = ca.country_id
			   AND cd.active
			   AND cd.country_id != 6	

		WHERE DATE(cc.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
	) ch ON ch.case_id = ca.case_id

	WHERE DATE(ca.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
	  AND ca.case_button_name = 'PY_Inbound_Case'
	  AND ca.case_origin <<>> 'Chat'
	  AND (ca.case_type IN ('Restaurant - Data','Restaurant Request','Partner','Handover',' ') OR ca.case_type IS NULL)
	  AND ca.country_id != 6),
 shnk_ps AS (
	SELECT
		DATE(datos_ps.fecha) AS fecha,
		NULL AS country_id,
        datos_ps.user_id,
		SUM(tiempo_chats) AS tiempo_chats_ps,
		SUM(tiempo_cases) AS tiempo_casos_ps,
	FROM (
		SELECT
			fecha,
			user_id
		FROM (
			SELECT
				DATE(start_time) AS fecha,
				chat_transcript_user_id AS user_id
			FROM (
				SELECT
					DATE(ch.start_time) AS start_time,
					ch.chat_transcript_user_id
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts` ch

				WHERE DATE(ch.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
				  AND livechat_button.button_id IN ('5731r000000H1Z1AAK','5731r000000H1Z3AAK','5731r000000btd7AAA','5731r0000008gICAAY','5731r000000btd6AAA','5731r0000008gIBAAY','5731r0000008gIDAAY')
				  AND ch.country_id != 6
			)
			GROUP BY 1,2
		) chats
		
		UNION DISTINCT
			SELECT
				DATE(created_date) AS fecha,
				user_id
			FROM casos_changes
			GROUP BY 1,2
	) datos_ps
   
	
	LEFT JOIN (
		SELECT 
			DATE(presence_status_start_date) as fecha,
			presence_user_id as user_id,
            sum(case when status_name = 'Chats_Only' then presence_status_duration else 0 end) as tiempo_chats,
            sum(case when status_name <<>> 'Chats_Only' then presence_status_duration else 0 end) as tiempo_cases,
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_user_presence`
		
		WHERE DATE(presence_created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
		GROUP BY 1, 2
	) shnk_ps ON shnk_ps.fecha = datos_ps.fecha
		     AND shnk_ps.user_id = datos_ps.user_id
	GROUP BY 1,2,3
)
select 
shnk_ps.fecha,
 CASE
	 		WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='.vng@pedidosya.com'      THEN 'VN' 
	 		WHEN substring(us.Email, length(us.Email)-25, length(us.Email))='._vng.ext@pedidosya.com' THEN 'VN'
	 		WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='.mix@pedidosya.com'      THEN 'MIX'
	 		WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='.ndo@pedidosya.com'      THEN 'XTO'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_ndo.ext@pedidosya.com'  THEN 'XTO'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_mix.ext@pedidosya.com'  THEN 'MIX'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_maj.ext@pedidosya.com'  THEN 'MAJ'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_baj.ext@pedidosya.com'  THEN 'MAJ'
            WHEN substring(us.Email, length(us.Email)-18, length(us.Email))='_maj@pedidosya.com'      THEN 'MAJ'
	 		WHEN substring(us.Email, length(us.Email)-18, length(us.Email))='.maj@pedidosya.com'      THEN 'MAJ'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_alo.ext@pedidosya.com'  THEN 'ALO'
            WHEN substring(us.Email, length(us.Email)-17, length(us.Email))='_alo@pedidosya.com'      THEN 'ALO'
	 		WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_dyn.ext@pedidosya.com'  THEN 'DYN'
            WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_kon.ext@pedidosya.com'  THEN 'KON'
            WHEN substring(us.Email, length(us.Email)-21, length(us.Email))='_ccn.ext@pedidosya.com'  THEN 'CCN'
                        ELSE 'PEYA'
	 		END AS team,
SUM(tiempo_chats_ps/3600) AS tiempo_prod_chats_ps,
SUM(tiempo_casos_ps/3600) AS tiempo_prod_casos_ps,
from shnk_ps
left join `peya-data-origins-pro.cl_salesforce.user` us on us.id = shnk_ps.user_id 
group by 1,2
order by 1 desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
