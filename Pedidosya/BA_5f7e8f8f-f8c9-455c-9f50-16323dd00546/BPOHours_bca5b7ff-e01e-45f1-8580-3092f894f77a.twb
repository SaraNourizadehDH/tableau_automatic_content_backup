          <calculation class='tableau' formula='zn(sum([rs_horas_pr]))&#13;&#10;+zn(SUM([federated.10dmoia0yly3ws12todtr0l1kkx3].[ds_horas_pr]))&#13;&#10;+ zn(SUM([federated.1m39uhv0miurb7182tgji0spgvc7].[Horas_Accionables]))' />
