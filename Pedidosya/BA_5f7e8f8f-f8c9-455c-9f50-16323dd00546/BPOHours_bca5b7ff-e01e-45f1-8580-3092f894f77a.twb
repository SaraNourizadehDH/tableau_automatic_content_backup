        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0fid91j13da0ky12ual9s1klrkfq' name='Consulta SQL personalizada' type='text'>SELECT &#13;
        fecha,&#13;
       /* Pais,*/&#13;
        cd.country_id as country_id,&#13;
       &#13;
        sum(case when tipo = &apos;Chat&apos; then chats else null end) as chats_total,&#13;
        /*sum(case when equipo = &apos;Live&apos; then chats else null end) as chats_live,&#13;
        sum(case when equipo = &apos;Billing&apos; then chats else null end) as chats_billing,&#13;
        sum(case when equipo = &apos;Courier&apos; then chats else null end) as chats_courier,&#13;
        sum(case when equipo = &apos;Shopper&apos; then chats else null end) as chats_shopper,&#13;
        sum(case when equipo = &apos;Technical&apos; then chats else null end) as chats_tech,&#13;
        sum(case when equipo = &apos;Content&apos; then chats else null end) as chats_content,&#13;
        sum(case when equipo = &apos;Partner Service - Kitchen&apos; then 1 else null end) as chats_kitchen,*/&#13;
       &#13;
        sum(case when tipo = &apos;Caso&apos; then casos else null end) as cases_total,&#13;
        sum(case when tipo = &apos;Caso&apos; then casos_offline else null end) as cases_off_total,&#13;
        &#13;
        /*sum(case when tipo = &apos;Caso&apos; and equipo = &apos;Billing&apos; then casos else null end) as cases_billing,&#13;
        sum(case when tipo = &apos;Caso&apos; and equipo = &apos;Content&apos; then casos else null end) as cases_content,&#13;
        sum(case when tipo = &apos;Caso&apos; and equipo = &apos;Technical&apos; then casos else null end) as cases_tech,&#13;
        sum(case when tipo = &apos;Caso&apos; and equipo = &apos;Live&apos; then casos else null end) as cases_live,&#13;
        sum(case when tipo = &apos;Caso&apos; and equipo = &apos;Content&apos; then casos_offline else null end) as cases_content_offline,&#13;
        sum(case when tipo = &apos;Caso&apos; and equipo IN (&apos;Technical&apos;, &apos;Billing&apos;) then casos_offline else null end) as cases_refund,&#13;
        sum(case when tipo = &apos;SSF&apos; then llamadas else null end) as llamadas,&#13;
&#13;
        sum(case when tipo = &apos;Llamada&apos; then Deflectados else null end) as cases_SSF,&#13;
&#13;
        sum(case when tipo = &apos;Caso&apos; and Categoria = &apos;PicsApp&apos; then casos_offline else null end) as cases_pics_app,&#13;
        sum(case when tipo = &apos;Caso&apos; and Categoria = &apos;Fotos de logos&apos; then casos_offline else null end) as cases_pics_logos,&#13;
        sum(case when tipo = &apos;Caso&apos; and Categoria = &apos;Fotos profesionales&apos; then casos_offline else null end) as cases_pics_profes,&#13;
        sum(case when tipo = &apos;Caso&apos; and Categoria = &apos;Fotos de productos&apos; then casos_offline else null end) as cases_pics_productos,*/&#13;
        &#13;
    FROM `peya-delivery-and-support.automated_tables_reports.core_metrics_ps_clean` cm&#13;
    &#13;
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd&#13;
					ON cd.country_name = (CASE &#13;
											  WHEN cm.Pais = &apos;Panama&apos; THEN &apos;Panamá&apos;&#13;
											  WHEN cm.Pais = &apos;Dominican Republic&apos; THEN &apos;República Dominicana&apos;&#13;
											  WHEN cm.Pais = &apos;Peru&apos; THEN &apos;Perú&apos;&#13;
											  WHEN cm.Pais = &apos;Salvador&apos; THEN &apos;El Salvador&apos;&#13;
											  ELSE cm.Pais&#13;
										  END)&#13;
				   AND cd.active&#13;
				   AND cd.country_id != 6&#13;
&#13;
    WHERE DATE(fecha) &gt;&gt;= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)&#13;
    group by 1,2&#13;
    order by 1 desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
