        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18l9ixq10sdgq218p8nrt05i8vvd' name='Consulta SQL personalizada' type='text'>WITH Total_Chats AS(&#13;
        SELECT &#13;
		    DATE(created_date) AS fecha,&#13;
            country_id,&#13;
		    CASE &#13;
                WHEN country_name = &apos;Panama&apos; THEN &apos;Panamá&apos;&#13;
                WHEN country_name = &apos;Dominican Republic&apos; THEN &apos;República Dominicana&apos;&#13;
                WHEN country_name = &apos;Peru&apos; THEN &apos;Perú&apos;&#13;
                WHEN country_name = &apos;Salvador&apos; THEN &apos;El Salvador&apos;&#13;
                ELSE country_name&#13;
                END AS country_name, &#13;
		        COUNT(DISTINCT CASE WHEN livechat_button.button_name IN (&apos;Chat_Button_for_PY_Escalation&apos;,&apos;CS_SPA_Appetito_Customer_Chat&apos;,&apos;CS_SPA_PedidosYa_Customer_Chat&apos;,&apos;CS_SPA_PedidosYa_Online_Payment&apos;,&apos;CS_SPA_PedidosYa_Urgent_Customer_Chat&apos;) THEN chat_transcript_id END) AS cs_chats,&#13;
	    FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts` &#13;
    	WHERE DATE(created_date) &gt;&gt;= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)&#13;
	    AND country_id != 6&#13;
        GROUP BY 1,2,3&#13;
        ORDER BY 1 DESC, 2&#13;
),&#13;
Total_Cases AS(&#13;
	    SELECT&#13;
		    DATE(create_date) AS fecha,&#13;
            country_id,&#13;
		    CASE &#13;
                WHEN country_name = &apos;Panama&apos; THEN &apos;Panamá&apos;&#13;
                WHEN country_name = &apos;Dominican Republic&apos; THEN &apos;República Dominicana&apos;&#13;
                WHEN country_name = &apos;Peru&apos; THEN &apos;Perú&apos;&#13;
                WHEN country_name = &apos;Salvador&apos; THEN &apos;El Salvador&apos;&#13;
                ELSE country_name&#13;
            END AS country_name,&#13;
		    COUNT(DISTINCT CASE WHEN case_origin IN (&apos;Email&apos;,&apos;Helpcenter&apos;,&apos;Social Media&apos;) AND record_type_name = &apos;PY Inbound Case&apos; AND case_type = &apos;Customer&apos; THEN case_id END) AS cs_cases,&#13;
	    FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`&#13;
	    WHERE DATE(create_date) &gt;&gt;= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)&#13;
	    AND (case_subjec NOT LIKE &apos;%NDC |%&apos; OR case_subjec NOT LIKE &apos;%No country%&apos; OR case_subjec NOT LIKE &apos;%restaurant portal%&apos;)    &#13;
	    AND country_id != 6&#13;
	    GROUP BY 1,2,3	&#13;
)&#13;
SELECT &#13;
    TCH.fecha,&#13;
    TCH.country_name,&#13;
    TCH.cs_chats,&#13;
&#13;
    TCA.cs_cases&#13;
FROM Total_Chats TCH&#13;
LEFT JOIN Total_Cases TCA on TCH.fecha = TCA.fecha &#13;
    AND TCH.country_id = TCA.country_id&#13;
order by 1 desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.18l9ixq10sdgq218p8nrt05i8vvd' name='Consulta SQL personalizada' type='text'>WITH Total_Chats AS(&#13;
