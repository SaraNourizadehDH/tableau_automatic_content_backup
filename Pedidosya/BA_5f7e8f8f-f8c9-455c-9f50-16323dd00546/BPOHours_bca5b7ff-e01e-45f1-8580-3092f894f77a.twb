                END AS country_name, &#13;
		        COUNT(DISTINCT CASE WHEN livechat_button.button_name IN (&apos;Chat_Button_for_PY_Escalation&apos;,&apos;CS_SPA_Appetito_Customer_Chat&apos;,&apos;CS_SPA_PedidosYa_Customer_Chat&apos;,&apos;CS_SPA_PedidosYa_Online_Payment&apos;,&apos;CS_SPA_PedidosYa_Urgent_Customer_Chat&apos;) THEN chat_transcript_id END) AS cs_chats,&#13;
