              <relation connection='bigquery.13e8xp80xxu2yy1fx7kql0wcn02c' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT  DATE(b.Fecha) as Fecha
      ,(CASE WHEN substr(b.picked_by, -22) = '_alo.ext@pedidosya.com' THEN 'ALO'
       WHEN substr(b.picked_by, -22) = '_maj.ext@pedidosya.com' THEN 'MAJ'
        WHEN substr(b.picked_by, -22) = '_ndo.ext@pedidosya.com' THEN 'XTO'
