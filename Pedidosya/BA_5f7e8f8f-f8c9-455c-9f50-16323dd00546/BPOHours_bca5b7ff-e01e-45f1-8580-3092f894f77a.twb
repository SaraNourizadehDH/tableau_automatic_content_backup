      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_2795235ABC524DD59198702AC0C3DD0E'>
            <properties context=''>
              <relation connection='bigquery.06h8xaa1uc4vx110kg7r30j38aou' name='Consulta SQL personalizada' type='text'><![CDATA[with chats AS 
(
	SELECT
	DATE(start_time) AS start_time
	, country_id
	, chat_transcript_user.user_country
	, chat_transcript_user_id
	, livechat_button.button_name
	, chat_duration
	, end_time
	, last_modified_date 
	, operator_message_count
	, visitor_message_count
	, avg_response_time_operator
	, chat_alan_id
	, order_id
	, chat_transcript_name
	, request_time
	FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
	WHERE 
	created_date >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
	AND livechat_button.button_name IN('Chat_Button_for_PY_Escalation', 'CS_SPA_Appetito_Customer_Chat', 'CS_SPA_PedidosYa_Urgent_Customer_Chat', 'CS_SPA_PedidosYa_Customer_Chat', 'CS_SPA_PedidosYa_Online_Payment')
),
casos AS 
(
	SELECT
	DATE(resolved_date) AS resolved_date
	, case_id
	, case_number
	, country_id
	, user_id
	, case_button_name
	, case_type
	, case_origin
    , case_subjec
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
	WHERE
	create_date >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
)


SELECT 
	 total.fecha as fecha,
	 /*total.user_id as user_id,*/
     CASE WHEN total.team IS NULL THEN 'PEYA' ELSE total.team END AS team,
	 /*total.total_chats AS total_chats,
	 total.chats_od AS chats_od,
	 total.chats_vd AS chats_vd,
	 total.chats_op AS chats_op,
	 total.unansw_chats AS unansw_chats,
	 total.sum_ACW AS sum_ACW,
	 total.sum_AHT AS sum_AHT,
	 total.sum_avg_resp_time AS sum_avg_resp_time,
	 total.total_cases as total_cases,
	 total.Tiempo_no_productivo as Tiempo_no_productivo,
	 total.Tiempo_prod_cases as Tiempo_prod_cases,
	 total.Tiempo_prod_chats as Tiempo_prod_chats,*/
	 sum(total.Tiempo_total) as Tiempo_total,
     sum(total.hs_cases) as hs_cases ,
     sum(total.hs_chats) as hs_chats,
	 /*total.agente as agente,
	 total.email as email,
	 
	 cupones.total_coupons_given as cupones,
	 total.sat as sat,
	 total.insat as insat,
	 total.agente_demora as agente_demora,
	 total.agente_no_amable as agente_no_amable,
	 total.solucion_insatisf as solucion_insatisf,
	 total.espera_larga as espera_larga,
	 total.ayuda_dificil_usar as ayuda_dificil_usar,
	 total.agente_agil as agente_agil,
	 total.agente_amable as agente_amable,
	 total.solucion_satisf as solucion_satisf,
	 total.espera_corta as espera_corta,
	 total.ayuda_facil_usar as ayuda_facil_usar,
	 total.sat_email as sat_email,
	 total.insat_email as insat_email,
	 total.agente_demora_email as agente_demora_email,
	 total.agente_no_amable_email as agente_no_amable_email,
	 total.solucion_insatisf_email as solucion_insatisf_email,
	 total.espera_larga_email as espera_larga_email,
	 total.agente_agil_email as agente_agil_email,
	 total.agente_amable_email as agente_amable_email,
	 total.solucion_satisf_email as solucion_satisf_email,
	 total.espera_corta_email as espera_corta_email,
	 recontacto.recontacto as recontacto*/
FROM 
(
	SELECT 
		 data.fecha as fecha
		 , data.user_id as user_id
		 , data.total_chats AS total_chats
		 , /*data.chats_od AS chats_od
		 , data.chats_vd AS chats_vd
		 , data.chats_op AS chats_op
		 , data.unansw_chats AS unansw_chats
		 , data.sum_ACW AS sum_ACW
		 , data.sum_AHT AS sum_AHT
		 , data.sum_avg_resp_time AS sum_avg_resp_time
		 , data.sat
		 , data.insat
		 , data.agente_demora
		 , data.agente_no_amable
		 , data.solucion_insatisf
		 , data.espera_larga
		 , data.ayuda_dificil_usar
		 , data.agente_agil
		 , data.agente_amable
		 , data.solucion_satisf
		 , data.espera_corta
		 , data.ayuda_facil_usar
		 , data.total_cases as total_cases
		 , data.sat_email
		 , data.insat_email
		 , data.agente_demora_email
		 , data.agente_no_amable_email
		 , data.solucion_insatisf_email
		 , data.espera_larga_email
		 , data.agente_agil_email
		 , data.agente_amable_email
		 , data.solucion_satisf_email
		 , data.espera_corta_email
		 , shnk.Tiempo_no_prodctivo as Tiempo_no_productivo
		 , shnk.Tiempo_prod_cases as Tiempo_prod_cases
		 , shnk.Tiempo_prod_chats as Tiempo_prod_chats
		 , */shnk.Tiempo_total/3600 as Tiempo_total
         , shnk.tiempo_chats/3600 as hs_chats
         , shnk.tiempo_cases/3600 as hs_cases
		 , email.agente as agente
		 , email.email as email
		 , email.team as team
	FROM 
	(
		SELECT
			case when chats.fecha is NULL then casos.fecha else chats.fecha END as fecha
			, case when chats.user_id is NULL then casos.user_id else chats.user_id END AS user_id
			, chats.total_chats AS total_chats
			, /*chats.chats_od AS chats_od
			, chats.chats_vd AS chats_vd
			, chats.chats_op AS chats_op
			, chats.unansw_chats AS unansw_chats
			, chats.sum_ACW AS sum_ACW
			, chats.sum_AHT AS sum_AHT
			, chats.sum_avg_resp_time AS sum_avg_resp_time
			, chats.sat
			, chats.insat
			, chats.agente_demora
			, chats.agente_no_amable
			, chats.solucion_insatisf
			, chats.espera_larga
			, chats.ayuda_dificil_usar
			, chats.agente_agil
			, chats.agente_amable
			, chats.solucion_satisf
			, chats.espera_corta
			, chats.ayuda_facil_usar
			, casos.casos as total_cases
			, casos.sat_email
			, casos.insat_email
			, casos.agente_demora_email
			, casos.agente_no_amable_email
			, casos.solucion_insatisf_email
			, casos.espera_larga_email
			, casos.agente_agil_email
			, casos.agente_amable_email
			, casos.solucion_satisf_email
			, casos.espera_corta_email*/
		FROM 
		(
			SELECT
				CASE WHEN chats_sin_csat.fecha IS NULL THEN csat_chats.fecha ELSE chats_sin_csat.fecha END AS fecha
				, CASE WHEN chats_sin_csat.user_id IS NULL THEN csat_chats.user_id ELSE chats_sin_csat.user_id END AS user_id
				, chats_sin_csat.total_chats /*
				, chats_sin_csat.chats_od
				, chats_sin_csat.chats_vd
				, chats_sin_csat.chats_op
				, chats_sin_csat.sum_AHT
				, chats_sin_csat.sum_ACW
				, chats_sin_csat.unansw_chats
				, chats_sin_csat.sum_avg_resp_time
				, csat_chats.sat
				, csat_chats.insat
				, csat_chats.agente_demora
				, csat_chats.agente_no_amable
				, csat_chats.solucion_insatisf
				, csat_chats.espera_larga
				, csat_chats.ayuda_dificil_usar
				, csat_chats.agente_agil
				, csat_chats.agente_amable
				, csat_chats.solucion_satisf
				, csat_chats.espera_corta
				, csat_chats.ayuda_facil_usar */
			FROM 
			(
				SELECT
					date(start_time) AS fecha
					, chat_transcript_user_id AS user_id
					,  count(*) AS total_chats /*
					, sum(case when livechat_button_name in ('Chat_Button_for_PY_Escalation', 'CS_SPA_Appetito_Customer_Chat', 'CS_SPA_PedidosYa_Urgent_Customer_Chat') then 1 else 0 end) AS chats_od
					, sum(case when livechat_button_name in ('CS_SPA_PedidosYa_Customer_Chat') then 1 else 0 end) AS chats_vd
					, sum(case when livechat_button_name in ('CS_SPA_PedidosYa_Online_Payment') then 1 else 0 end) AS chats_op
					, sum(chat_duration) as sum_AHT
					, sum(abs(DATE_DIFF(end_time, last_modified_date, second))) AS sum_ACW
					, sum(case when operator_message_count << 2 AND visitor_message_count >>= 1 then 1 else 0 end) AS unansw_chats
					, sum(avg_response_time_operator) AS sum_avg_resp_time */
				FROM 
				(
					SELECT
						DATE(start_time) AS start_time,
						user_country as chat_transcript_country,
						chat_transcript_user_id,
						/* button_name as livechat_button_name,
						chat_duration,
						end_time,
						last_modified_date,
						operator_message_count,
						visitor_message_count,
						avg_response_time_operator */
					FROM chats AS ch
					LEFT JOIN `peya-data-origins-pro.cl_core.country_details` co ON co.country_id = ch.country_id
					WHERE DATE(start_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
				)										  
				GROUP BY 1,2
			) AS chats_sin_csat
			FULL OUTER JOIN 
			(
				SELECT 
					DATE(created_date) AS fecha,
					chat_transcript_user_id AS user_id, 
					/* sum(case when csat>>=4 then 1 else 0 end) as sat,
					sum(case when csat<<=3 then 1 else 0 end) as insat,
					sum(case when regexp_instr(qnegative,'2')>>0 then 1 else 0 end) as agente_demora,
					sum(case when regexp_instr(qnegative,'6')>>0 then 1 else 0 end) as agente_no_amable,
					sum(case when regexp_instr(qnegative,'11')>>0 then 1 else 0 end) as solucion_insatisf,
					sum(case when regexp_instr(qnegative,'13')>>0 then 1 else 0 end) as espera_larga,
					sum(case when regexp_instr(qnegative,'14')>>0 then 1 else 0 end) as ayuda_dificil_usar,
					sum(case when regexp_instr(qpositive,'2')>>0 then 1 else 0 end) as agente_agil,
					sum(case when regexp_instr(qpositive,'6')>>0 then 1 else 0 end) as agente_amable,
					sum(case when regexp_instr(qpositive,'11')>>0 then 1 else 0 end) as solucion_satisf,
					sum(case when regexp_instr(qpositive,'13')>>0 then 1 else 0 end) as espera_corta,
					sum(case when regexp_instr(qpositive,'14')>>0 then 1 else 0 end) as ayuda_facil_usar */
				FROM `peya-data-origins-pro.cl_gcc_service.qualtrics_ac_csat_responses` as r
				LEFT JOIN chats as c on c.chat_alan_id = r.chat_id
				LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` as u on c.chat_transcript_user_id=u.id
				LEFT JOIN `peya-data-origins-pro.cl_core.country_details` as d on d.country_id = c.country_id
				WHERE 
					DATE(r.created_date) >>= date(created_date)
					AND stakeholder = 'Customer'
					AND d.country_id <<>> 6
					AND r.origin = 'chat'
				GROUP BY 1,2
			) AS csat_chats ON csat_chats.user_id = chats_sin_csat.user_id AND csat_chats.fecha = chats_sin_csat.fecha
		) AS chats
		 FULL OUTER JOIN		
		 (
		 	SELECT
		 		CASE WHEN casos_sin_csat.fecha IS NULL THEN csat_email.fecha ELSE casos_sin_csat.fecha END AS fecha
		 		, CASE WHEN casos_sin_csat.user_id IS NULL THEN csat_email.user_id ELSE casos_sin_csat.user_id END AS user_id
		 		, /* casos_sin_csat.casos
		 		, csat_email.sat_email
		 		, csat_email.insat_email
		 		, csat_email.agente_demora_email
		 		, csat_email.agente_no_amable_email
		 		, csat_email.solucion_insatisf_email
		 		, csat_email.espera_larga_email
		 		, csat_email.agente_agil_email
		 		, csat_email.agente_amable_email
		 		, csat_email.solucion_satisf_email
		 		, csat_email.espera_corta_email */
		 	FROM 
		 	(
		 		SELECT 
		 			date(resolved_date) AS fecha
		 			, user_id AS user_id 
		 			, count(*) AS casos
		 		FROM
		 		(
		 			SELECT
		 				DATE(resolved_date) AS resolved_date
		 				,user_id
		 			FROM casos AS ch
		 			LEFT JOIN `peya-data-origins-pro.cl_core.country_details` as co ON ch.country_id = co.country_id
		 			WHERE case_button_name = 'PY_Inbound_Case' 
		 			  and case_type = 'Customer'
		 			  and case_origin <<>> 'Chat'
                    AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%')
		 			  AND DATE(resolved_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)
		 		)
		 		GROUP BY 1,2
		 	) AS casos_sin_csat 
		 	FULL OUTER JOIN 
		 	(
		 		SELECT
		 			DATE(fecha) AS fecha
		 			,createdbyid AS user_id
		 			/*,sum(case when csat>>=4 then 1 else 0 end) as sat_email
		 			,sum(case when csat<<=3 then 1 else 0 end) as insat_email
		 			,sum(case when regexp_instr(qnegative,'2') >>0 then 1 else 0 end) as agente_demora_email
		 			,sum(case when regexp_instr(qnegative,'6') >>0 then 1 else 0 end) as agente_no_amable_email
		 			,sum(case when regexp_instr(qnegative,'11')>>0  then 1 else 0 end) as solucion_insatisf_email
		 			,sum(case when regexp_instr(qnegative,'13')>>0  then 1 else 0 end) as espera_larga_email
		 			,sum(case when regexp_instr(qpositive,'2') >>0 then 1 else 0 end) as agente_agil_email
		 			,sum(case when regexp_instr(qpositive,'6') >>0 then 1 else 0 end) as agente_amable_email
		 			,sum(case when regexp_instr(qpositive,'11')>>0  then 1 else 0 end) as solucion_satisf_email
		 			,sum(case when regexp_instr(qpositive,'13')>>0  then 1 else 0 end) as espera_corta_email */
		 		FROM 
		 		(
					SELECT
						DATE(created_date) AS fecha
						/*,csat.csat
						,csat.qpositive
						,csat.qnegative
						,csat.case_number */
						,ch.createddate AS changes_date
						,ch.createdbyid
						,MAX(ch.createddate) OVER (PARTITION BY csat.response_id) AS max_fecha
					FROM `peya-data-origins-pro.cl_gcc_service.qualtrics_ac_csat_responses` AS csat
					INNER JOIN casos AS ca ON csat.case_number = ca.case_number
					LEFT JOIN `peya-data-origins-pro.cl_core.country_details` as d on d.country_id = ca.country_id
					INNER JOIN `peya-data-origins-pro.cl_salesforce.cases_changes` AS ch 
						ON ch.caseid = ca.case_id 
						AND ch.createddate >>= TIMESTAMP(DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH))
						AND DATE(csat.created_date) >>= DATE(ch.createddate)

					WHERE DATE(csat.created_at) >>= date(TIMESTAMP(DATE_ADD(CURRENT_DATE(), INTERVAL -3 MONTH) - EXTRACT(DAY FROM CURRENT_DATE())+1))
						AND csat.case_number IS NOT NULL
						AND ch.newvalue = 'Resolved'
						AND stakeholder = 'Customer'
						AND d.country_id <<>> 6
						AND origin in ('Helpcenter', 'Email','email')
		 		) AS encuestas
		 		WHERE encuestas.changes_date = encuestas.max_fecha
		 		GROUP BY 1,2
		 	) AS csat_email ON casos_sin_csat.user_id = csat_email.user_id and casos_sin_csat.fecha = csat_email.fecha
		 ) AS casos ON casos.user_id=chats.user_id and casos.fecha=chats.fecha
	) AS data
	 LEFT JOIN 
	 (
	 	select 
	 		date(presence_status_start_date) as fecha
	 		, sum(presence_status_duration) as Tiempo_total
	 		, sum(case when status_name = 'Chats_Only' then presence_status_duration else 0 end) as tiempo_chats
            , sum(case when status_name <<>> 'Chats_Only' then presence_status_duration else 0 end) as tiempo_cases
	 		, presence_user_id as user_id
	 	from `peya-bi-tools-pro.il_salesforce.fact_salesforce_user_presence`
	 	WHERE DATE(presence_status_start_date) >>= date(TIMESTAMP(DATE_ADD(CURRENT_DATE(), INTERVAL -3 MONTH) - EXTRACT(DAY FROM CURRENT_DATE())+1))
	 	group by date(presence_status_start_date), presence_user_id
	 ) AS shnk on data.user_id=shnk.user_id and data.fecha=shnk.fecha
	 LEFT JOIN 
	 (
	 	select
	 		id as user_id,
	 		username as email, 
	 		name as agente,
	 		CASE
	 		WHEN substring(username, length(username)-17, length(username))='.vng@pedidosya.com'      THEN 'VN' 
	 		WHEN substring(username, length(username)-25, length(username))='._vng.ext@pedidosya.com' THEN 'VN'
	 		WHEN substring(username, length(username)-17, length(username))='.mix@pedidosya.com'      THEN 'MIX'
	 		WHEN substring(username, length(username)-17, length(username))='.ndo@pedidosya.com'      THEN 'XTO'
	 		WHEN substring(username, length(username)-21, length(username))='_ndo.ext@pedidosya.com'  THEN 'XTO'
	 		WHEN substring(username, length(username)-21, length(username))='_mix.ext@pedidosya.com'  THEN 'MIX'
	 		WHEN substring(username, length(username)-21, length(username))='_maj.ext@pedidosya.com'  THEN 'MAJ'
	 		WHEN substring(username, length(username)-21, length(username))='_baj.ext@pedidosya.com'  THEN 'MAJ'
            WHEN substring(username, length(username)-18, length(username))='_maj@pedidosya.com'      THEN 'MAJ'
	 		WHEN substring(username, length(username)-18, length(username))='.maj@pedidosya.com'      THEN 'MAJ'
	 		WHEN substring(username, length(username)-21, length(username))='_alo.ext@pedidosya.com'  THEN 'ALO'
            WHEN substring(username, length(username)-17, length(username))='_alo@pedidosya.com'      THEN 'ALO'
	 		WHEN substring(username, length(username)-21, length(username))='_dyn.ext@pedidosya.com'  THEN 'DYN'
            WHEN substring(username, length(username)-21, length(username))='_kon.ext@pedidosya.com'  THEN 'KON'
            WHEN substring(username, length(username)-21, length(username))='_ccn.ext@pedidosya.com'  THEN 'CCN'
                        ELSE 'PEYA'
	 		END AS team
	 	from `peya-data-origins-pro.cl_salesforce.user`
	 ) as email ON data.user_id = email.user_id
) as total

group by 1, 2

order by 1 desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
