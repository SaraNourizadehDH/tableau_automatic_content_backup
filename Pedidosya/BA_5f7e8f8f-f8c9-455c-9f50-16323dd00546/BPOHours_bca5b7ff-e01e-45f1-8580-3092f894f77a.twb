        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.15takrb0esqb5y1bl7asa0fub1i7].[sum:hs_cases:qk]&quot;' value='Horas Casos' />
          <alias key='&quot;[federated.15takrb0esqb5y1bl7asa0fub1i7].[sum:hs_chats:qk]&quot;' value='Horas Chats' />
        </aliases>
      </column>
      <column caption='Dynamic Date' datatype='datetime' name='[Calculation_1322087994075381882]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parámetro 1], [fecha])' />
      </column>
      <column caption='fecha_ultimo_nivel' datatype='string' name='[Calculation_463307853675192451]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087994075381882]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087994075381882]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087994075381882]))&#13;&#10;END' />
      </column>
