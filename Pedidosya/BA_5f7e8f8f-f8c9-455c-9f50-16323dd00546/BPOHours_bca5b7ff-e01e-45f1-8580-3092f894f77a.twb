        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03ru8ht1j3h1pi1cop0rt0jwwnwt' name='Consulta SQL personalizada' type='text'>SELECT &#13;
        fecha AS fecha,&#13;
        agente as email_agente,&#13;
        CASE WHEN substr(agente, -22) = &apos;_alo.ext@pedidosya.com&apos; THEN &apos;ALO&apos;&#13;
            WHEN substr(agente, -22) = &apos;_maj.ext@pedidosya.com&apos; THEN &apos;MAJ&apos;&#13;
             WHEN substr(agente, -22) = &apos;_ndo.ext@pedidosya.com&apos; THEN &apos;XTO&apos;&#13;
              WHEN substr(agente, -22) = &apos;_vng.ext@pedidosya.com&apos; THEN &apos;VN&apos;&#13;
               WHEN substr(agente, -26) = &apos;_ndo.ext.ext@pedidosya.com&apos; THEN &apos;XTO&apos;&#13;
                WHEN substr(agente, -28) = &apos;leidy.cely.ext@pedidosya.com&apos; THEN &apos;XTO&apos;&#13;
                 WHEN substr(agente, -18) = &apos;.vng@pedidosya.com&apos; THEN &apos;VN&apos;&#13;
                  WHEN substr(agente, -22) = &apos;_ccn.ext@pedidosya.com&apos; THEN &apos;CCN&apos;&#13;
                    wHEN substr(agente, -22) = &apos;_kon.ext@pedidosya.com&apos; THEN &apos;KON&apos;&#13;
                    wHEN substr(agente, -22) = &apos;_dyn.ext@pedidosya.com&apos; THEN &apos;DYN&apos;&#13;
                   WHEN substr(agente, -18) = &apos;vng3@pedidosya.com&apos; THEN &apos;VN&apos;&#13;
                    WHEN substr(agente, -18) = &apos;.maj@pedidosya.com&apos; THEN &apos;MAJ&apos;&#13;
                     WHEN substr(agente, -18) = &apos;_maj@pedidosya.com&apos; THEN &apos;MAJ&apos;&#13;
                      WHEN substr(agente, -18) = &apos;.alo@pedidosya.com&apos; THEN &apos;ALO&apos;&#13;
                       WHEN substr(agente, -18) = &apos;.ndo@pedidosya.com&apos; THEN &apos;XTO&apos;&#13;
                        WHEN substr(agente, -23) = &apos;_ndo.ext1@pedidosya.com&apos; THEN &apos;XTO&apos;&#13;
                         WHEN substr(agente, -17) = &apos;.vn@pedidosya.com&apos; THEN &apos;VN&apos;&#13;
                          WHEN substr(agente, -15) = &apos;@appetito24.com&apos; THEN &apos;APPETITO&apos; ELSE &apos;PEYA&apos; END AS Team,&#13;
        SUM(actionables) AS Accionables,&#13;
        COUNT(HC_intervalo) AS Horas_Accionables,  &#13;
    FROM `peya-delivery-and-support.user_leonardo_rosa.big_orders_3`&#13;
    Where fecha &gt;&gt;= DATE_ADD(CURRENT_DATE, INTERVAL -3 MONTH)&#13;
    GROUP BY  1,2&#13;
&#13;
&#13;
order by 1 desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
