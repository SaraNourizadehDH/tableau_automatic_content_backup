      <column caption='fecha_ultimo_nivel' datatype='string' name='[Calculation_1133781241299947523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1133781241299689472]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1133781241299689472]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1133781241299689472]))&#13;&#10;END' />
      </column>
      <column caption='cases_total_2' datatype='integer' name='[Calculation_43065706832711680]' role='measure' type='quantitative'>
