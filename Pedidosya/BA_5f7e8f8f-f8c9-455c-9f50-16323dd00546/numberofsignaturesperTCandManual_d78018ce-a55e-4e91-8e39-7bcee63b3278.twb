      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='KPI_TermsandConditions_Latam' id='KPI_TermsandConditions_Latam_91F493F1DEF245B19253D75AA95F662B'>
            <properties context=''>
              <relation connection='bigquery.04j3r301jihw4x189a7g21xonyjc' name='Consulta SQL personalizada' type='text'>SELECT&#13;
  o.grid__c,&#13;
  sc.public_site_url__c,&#13;
  a.email_path__c,&#13;
  o.name as Account_Name,&#13;
  o.country_code,&#13;
  a.business_type__c,&#13;
  sc.id as id_Quote,&#13;
  sc.name as Quote_Name,&#13;
  sc.createddate,&#13;
  o.accountsource,&#13;
  sc.id,&#13;
  o.vertical__c,&#13;
  o.vertical_segment__c,&#13;
  a.ownerid,&#13;
  u.name,&#13;
  u.Email,&#13;
  CASE&#13;
    WHEN a.email_path__c is NULL AND sc.public_site_url__c LIKE &apos;https://socios.pedidosya.com%&apos; THEN &apos;Firma de T&amp;C&apos;&#13;
    WHEN a.email_path__c = &apos;Classic&apos;AND sc.public_site_url__c LIKE &apos;https://socios.pedidosya.com%&apos; THEN &apos;Firma de T&amp;C&apos;&#13;
    WHEN a.email_path__c = &apos;DocuSign&apos; AND sc.public_site_url__c LIKE &apos;https://socios.pedidosya.com%&apos; THEN &apos;Firma de T&amp;C&apos;&#13;
    WHEN a.email_path__c = &apos;Classic&apos;AND sc.public_site_url__c IS NULL THEN &apos;Firma Manual&apos;&#13;
    WHEN a.email_path__c = &apos;Classic&apos;AND sc.public_site_url__c = &apos;WithoutSignature&apos; THEN &apos;Firma Manual&apos;&#13;
    WHEN a.email_path__c = &apos;Classic&apos;AND sc.public_site_url__c = &apos;Without Signature&apos; THEN &apos;Firma Manual&apos;&#13;
    WHEN a.email_path__c is NULL AND sc.public_site_url__c = &apos;WithoutSignature&apos; THEN &apos;Sin firma en Salesforce&apos;&#13;
    WHEN a.email_path__c is NULL AND sc.public_site_url__c = &apos;Without Signature&apos; THEN &apos;Sin firma en Salesforce&apos;&#13;
    WHEN a.email_path__c is NULL AND sc.public_site_url__c IS NULL THEN &apos;Sin firma en Salesforce&apos;&#13;
    WHEN a.email_path__c = &apos;DocuSign&apos; AND sc.public_site_url__c IS NULL THEN &apos;Firma por DocuSign&apos;&#13;
    WHEN a.email_path__c = &apos;DocuSign&apos; AND sc.public_site_url__c = &apos;WithoutSignature&apos; THEN &apos;Sin firma en Salesforce&apos;&#13;
    WHEN a.email_path__c = &apos;DocuSign&apos; AND sc.public_site_url__c = &apos;Without Signature&apos; THEN &apos;Sin firma en Salesforce&apos;&#13;
    ELSE &apos;Unknown&apos;&#13;
  END tipo_url&#13;
FROM `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity_quote` sc&#13;
left join `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` a on a.id = sc.id_opportunity__c&#13;
left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` o on o.id = sc.id_account__c&#13;
left join `peya-data-origins-pro.cl_salesforce.user` u on u.UserID18 = sc.createdbyid&#13;
WHERE a.business_type__c in  (&apos;New Business&apos;,&apos;Win Back&apos;)&#13;
and a.stagename = &apos;Closed Won&apos;&#13;
and sc.status__c = &apos;Accepted&apos;&#13;
and o.recordtypeid = &apos;0121r0000007eqLAAQ&apos; &#13;
and o.accountsource != &apos;Self Sign Up&apos;&#13;
--and o.grid__c = &apos;HZ5ILT&apos;&#13;
and EXTRACT(YEAR FROM sc.createddate) &gt;&gt;= 2022</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
