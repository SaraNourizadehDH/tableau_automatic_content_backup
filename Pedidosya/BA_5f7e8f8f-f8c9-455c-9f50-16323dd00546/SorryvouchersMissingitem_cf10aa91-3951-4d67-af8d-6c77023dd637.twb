        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.14vuxni1w40buh1ax3g4h0qvhu3o' name='Custom SQL Query' type='text'>WITH&#13;
vouchers AS (&#13;
    SELECT &#13;
        a.original_order_id, &#13;
        coupon_id, &#13;
        coupon_used_amount, &#13;
        coupon_created_at, &#13;
        coupon_discount_amount,&#13;
        coupon_country_id&#13;
    FROM `peya-bi-tools-pro.il_growth.fact_talon_coupons` a&#13;
    JOIN `peya-data-origins-pro.cl_core.country_details` cd ON a.coupon_country_id = cd.country_id&#13;
    LEFT JOIN `peya-data-origins-pro.cl_compensations.user_compensations`AS c2 ON a.coupon_id = c2.provider_data.id&#13;
    WHERE &#13;
        DATE(coupon_created_at) BETWEEN &apos;2022-01-01&apos; AND CURRENT_DATE()-1&#13;
        AND (talon_campaign_id LIKE &apos;%%customer-service-missingitems-compensations%%&apos; OR talon_campaign_id LIKE &apos;%%customer-service-agent-compensation%%&apos;)&#13;
),&#13;
caso_sfdc AS (&#13;
    SELECT SAFE_CAST(producto AS INT64) product_id, Order_Number, dp.name AS product_name&#13;
    FROM&#13;
    (&#13;
        SELECT arreglo, REGEXP_REPLACE(arreglo,&apos;[^0-9 ]&apos;,&apos;&apos;) producto, Order_Number&#13;
        FROM&#13;
        (&#13;
            SELECT &#13;
                CreatedDate,  &#13;
                Order_Number, &#13;
                casenumber, &#13;
                case_reason_level_3, &#13;
                SPLIT(REPLACE(Description,&apos;\n&apos;,&apos;&apos;),&apos;:&apos;) arreglo,&#13;
            FROM `peya-data-origins-pro.cl_salesforce.cases`&#13;
            WHERE             &#13;
                DATE(CreatedDate) BETWEEN &apos;2022-01-01&apos; AND CURRENT_DATE()-1&#13;
                AND type = &apos;Customer&apos;&#13;
                AND case_reason_level_3 = &apos;Missing item&apos;&#13;
&#13;
        ), UNNEST(arreglo) AS arreglo&#13;
    )p&#13;
    JOIN `peya-bi-tools-pro.il_core.dim_product` dp  ON dp.id = SAFE_CAST(p.producto AS INT64)&#13;
    WHERE SAFE_CAST(producto AS INT64) &gt;&gt; 50     &#13;
),&#13;
franquicia AS (&#13;
    SELECT DISTINCT &#13;
        fo.order_id,&#13;
        fo.registered_date,&#13;
        df.franchise_name,&#13;
        df.franchise_id&#13;
    FROM `peya-bi-tools-pro.il_core.fact_orders` fo&#13;
    JOIN `peya-bi-tools-pro.il_core.dim_partner_franchise` dpf ON fo.restaurant.id = dpf.partner_id&#13;
    JOIN `peya-bi-tools-pro.il_core.dim_franchise` df ON dpf.franchise_id = df.franchise_id&#13;
    WHERE &#13;
        fo.registered_date BETWEEN &apos;2022-01-01&apos; AND CURRENT_DATE()-1&#13;
        AND df.franchise_id IN (&apos;0011r00002VoHw4AAF&apos;,&apos;0011r00002VoHwSAAV&apos;) -- Mostaza y mc donald&apos;s&#13;
)&#13;
&#13;
SELECT&#13;
    DATE(vch.coupon_created_at) AS fecha_emision,&#13;
    dc.country_name,&#13;
    fqa.franchise_name,&#13;
    csf.product_name AS producto_faltante,&#13;
    csf.product_id,&#13;
    COUNT(DISTINCT coupon_id) cupones,&#13;
    SUM(vch.coupon_used_amount/dce.rate_eu) AS monto_redimido_EU,&#13;
    SUM(vch.coupon_discount_amount/dce.rate_eu) AS valor_cupon_EU&#13;
FROM vouchers vch&#13;
JOIN caso_sfdc csf ON vch.original_order_id = SAFE_CAST(csf.Order_Number AS int64)&#13;
JOIN franquicia fqa ON vch.original_order_id = fqa.order_id&#13;
JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON dc.active AND dc.country_id = vch.coupon_country_id&#13;
JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce on DATE(vch.coupon_created_at) = dce.currency_exchange_date AND vch.coupon_country_id = dce.currency_id&#13;
GROUP BY 1,2,3,4,5&#13;
ORDER BY 1 DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
