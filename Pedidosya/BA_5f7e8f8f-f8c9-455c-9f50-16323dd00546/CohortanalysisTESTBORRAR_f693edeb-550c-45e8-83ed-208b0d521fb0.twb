      <aliases enabled='yes' />
      <column caption='period_numeric' datatype='integer' name='[Calculation_1439744544159342592]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(REPLACE([cohort_period], &apos;M&apos;, &apos;&apos;))' />
      </column>
      <column caption='Running users' datatype='integer' name='[Calculation_1439744544164552705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(SUM([total_users])) - RUNNING_SUM(SUM([total_users])) + ZN(SUM([total_users]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='base_date' datatype='date' fiscal-year-start='0' name='[Calculation_1439744544165543938]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&quot;01&quot;+ &quot;-&quot; + RIGHT([base_month], 2)+ &quot;-&quot; +LEFT([base_month], 4))' />
      </column>
      <column caption='frequency' datatype='real' name='[Calculation_1807632333813964800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders])/SUM([total_users])' />
      </column>
      <column caption='gmv' datatype='real' name='[Calculation_1807632333814689793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv_eu])/SUM([total_orders])' />
      </column>
      <column caption='test_prev' datatype='integer' name='[Calculation_1807632334125248516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([total_users]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='cohort_date' datatype='date' name='[Calculation_1807632334129278982]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&quot;01&quot;+ &quot;-&quot; + RIGHT([cohort_months], 2)+ &quot;-&quot; +LEFT([cohort_months], 4))' />
      </column>
      <column caption='retention_rate_m0' datatype='real' name='[Calculation_1807632334155112457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_users]) / LOOKUP(SUM([total_users]),FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='flgp' datatype='real' name='[Calculation_2207326806090035201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_flgp_eu])/SUM([total_orders])' />
      </column>
      <column caption='gmv user' datatype='real' name='[Calculation_2759017760685203456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv_eu])/SUM([total_users])' />
      </column>
      <column caption='flgp_user' datatype='real' name='[Calculation_2759017760686358529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_flgp_eu])/SUM([total_users])' />
      </column>
      <column caption='aux1' datatype='real' name='[Calculation_840202850862170115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_users]) / WINDOW_SUM(SUM([total_users]), FIRST(), FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='test_cohort_v4' datatype='table' name='[__tableau_internal_object_id__].[test_cohort_v4_A2DED3798A324352B06E63F4823C497D]' role='measure' type='quantitative' />
      <column caption='aux2' datatype='real' name='[aux1 (copia)_840202850862247940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_users]) / WINDOW_SUM(SUM([total_users]), FIRST(), FIRST() + 1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Base Month' datatype='string' name='[base_month]' role='dimension' type='nominal' />
