            <column caption='List Date View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Features' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category Pils&quot;'>
              <calculation class='tableau' formula='&quot;Category Pils&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1te1cbp1boe6ok16r2ur401edjda'>
            <column caption='Date Selector' datatype='date' name='[Calculation_1383168063628275712]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Daily&apos; THEN [Date (Exacta)]&#13;&#10;WHEN &apos;Weekly&apos; THEN [Date (Números de semanas)]&#13;&#10;WHEN &apos;Monthly&apos; THEN [Date (Meses)]&#13;&#10;END' />
            </column>
            <column caption='Shop List (by Feature)' datatype='integer' name='[Calculation_1868993885722693635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &apos;Search&apos;           THEN SUM( IF [use_search]= TRUE   THEN [shop_list] END)&#13;&#10;WHEN &apos;Banners&apos;          THEN SUM( IF [use_banner]= TRUE   THEN [shop_list] END) &#13;&#10;WHEN &apos;Category Pils&apos;    THEN SUM( IF [use_pills] = TRUE   THEN [shop_list] END) &#13;&#10;WHEN &apos;Filters&apos;          THEN SUM( IF [use_filter] = TRUE  THEN [shop_list] END) &#13;&#10;&#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='mCVR2 (by Feature)' datatype='real' name='[Calculation_1868993885725028358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Shop Details (by Feature) (copia)_1868993885724749828]/[Calculation_1868993885722693635]' />
            </column>
            <column caption='mCVR2' datatype='real' name='[Calculation_632474301078806529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shop_details_loaded])/SUM([shop_list])' />
            </column>
            <column caption='CVR2' datatype='real' name='[Calculation_632474301079212034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([shop_list])' />
            </column>
            <column caption='Business Type   ' datatype='string' name='[Calculation_943785664244637696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([businessType],&apos;market|pets|shop|drinks|kiosks|pharmacy|flowers&apos;) &#13;&#10;THEN [businessType] END' />
            </column>
            <column datatype='date' name='[Date (Exacta)]' role='dimension' type='quantitative' user:agg-type='None' user:base-field='date' user:ui-builder='date-bin-builder'>
