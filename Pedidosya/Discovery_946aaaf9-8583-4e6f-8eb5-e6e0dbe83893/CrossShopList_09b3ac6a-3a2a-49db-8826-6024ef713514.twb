              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;Daily&apos; THEN [Date (Exacta)]&#13;&#10;WHEN &apos;Weekly&apos; THEN [Date (Números de semanas)]&#13;&#10;WHEN &apos;Monthly&apos; THEN [Date (Meses)]&#13;&#10;END' />
            </column>
            <column caption='Business Type   ' datatype='string' name='[Calculation_943785664244637696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([businessType],&apos;market|pets|shop|drinks|kiosks|pharmacy|flowers&apos;) &#13;&#10;THEN [businessType] END' />
            </column>
            <column caption='Clicks Features (%)' datatype='real' name='[Clicks Features (copia)_1868993885709209600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &apos;Search&apos;           THEN SUM([search])/SUM([shop_list])&#13;&#10;WHEN &apos;Banners&apos;          THEN SUM([banner_clicked])/[Clicks Features (copia)_2221963506270838785]&#13;&#10;WHEN &apos;Category Pils&apos;    THEN SUM([pills_use])/[Clicks Features (copia)_2221963506270838785]&#13;&#10;WHEN &apos;Filters&apos;          THEN SUM([filter_use])/SUM([shop_list])&#13;&#10;&#13;&#10;ELSE 0 &#13;&#10;END' />
