              <calculation class='tableau' formula='IF [rider_vehicle] = &quot;Bicicleta Plus&quot; then &quot;Bicicleta&quot; else [rider_vehicle] end' />
            </column>
            <column caption='Termino Contrato' datatype='string' name='[Calculation_1620451495444078596]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([motivo_termino_compliance]) then &quot;Sin termino/No compliance&quot; else &quot;Compliance&quot; end&#13;&#10;&#13;&#10;&#13;&#10;//diapo 11: matrices de retencion con y sin compliance' />
            </column>
            <column caption='Lifespan in days' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_790944721300393984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='datediff(&quot;day&quot;,[first_order_date],[last_order_date])' />
            </column>
