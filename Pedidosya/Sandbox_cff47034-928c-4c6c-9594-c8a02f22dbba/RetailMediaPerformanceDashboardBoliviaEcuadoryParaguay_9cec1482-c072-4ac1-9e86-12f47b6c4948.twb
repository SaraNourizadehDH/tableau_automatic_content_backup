            <column caption='Cpg Corregida' datatype='string' name='[cpg_corregida]' role='dimension' type='nominal' />
            <column caption='cvr_calc' datatype='real' default-format='p0.000%' name='[ctr (copia)_1221882910872498188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([tool_name]) = &quot;Vertical banner&quot;&#13;&#10;   OR MIN([tool_name]) = &quot;Vendor banner&quot;&#13;&#10;   OR MIN([tool_name]) = &quot;Category banner&quot; THEN&#13;&#10;    IF SUM([impressions]) = 0 THEN 0 ELSE SUM([Calculation_2382967162419507201]) / SUM([impressions]) END&#13;&#10;ELSE&#13;&#10;    IF SUM([clicks]) = 0 THEN 0 ELSE SUM([Calculation_2382967162419507201]) / SUM([clicks]) END&#13;&#10;END' />
