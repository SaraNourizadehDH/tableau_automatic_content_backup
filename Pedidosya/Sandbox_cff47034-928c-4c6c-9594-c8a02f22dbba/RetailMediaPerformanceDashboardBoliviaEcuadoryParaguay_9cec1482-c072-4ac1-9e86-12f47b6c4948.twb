    <worksheet name='debajo_gasto'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>Impresiones</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_otros_paises_tableau (automated_tables_reports)' name='federated.1permb90tx8cmo1cl4zv51no0kxn' />
          </datasources>
          <datasource-dependencies datasource='federated.1permb90tx8cmo1cl4zv51no0kxn'>
            <column caption='gasto_esperado_hoy' datatype='real' name='[Calculation_2373397064948486145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([Calculation_4905264458483716096])} * &#13;&#10;DATEDIFF(&#13;&#10;    &apos;day&apos;, &#13;&#10;    { FIXED [campaign_name] : MIN([campaign_start_utc]) }, &#13;&#10;    IF TODAY() &lt; { FIXED [campaign_name] : MAX([campaign_end_utc]) } &#13;&#10;    THEN TODAY() &#13;&#10;    ELSE { FIXED [campaign_name] : MAX([campaign_end_utc]) } &#13;&#10;    END&#13;&#10;) / &#13;&#10;{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([campaign_start_utc]), MAX([campaign_end_utc])) }' />
            </column>
            <column caption='Status campaña' datatype='string' name='[Calculation_2373397064949878789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [campaign_name] :&#13;&#10;    IF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &gt;= 0.2 THEN&#13;&#10;        &quot;Consumo por encima de proyección 🚨&quot;&#13;&#10;    ELSEIF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &lt; -0.2 THEN&#13;&#10;        &quot;Bajo rendimiento de campaña ⚠️&quot;&#13;&#10;    ELSE &#13;&#10;        &quot;Consumo alineado a proyección ✅&quot;&#13;&#10;    END&#13;&#10;}' />
            </column>
            <column caption='Nombre campaña' datatype='string' name='[Calculation_2382967162415861760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tool_name] = &apos;Home banner&apos; OR [tool_name] = &apos;Food banner&apos; THEN [component_name]&#13;&#10;ELSE [campaign_name]&#13;&#10;END' />
            </column>
            <column caption='ultimo_ppto' datatype='real' name='[Calculation_2382967162420666370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] :&#13;&#10;    MAX(&#13;&#10;        IF [date_utc] = { FIXED [Calculation_2382967162415861760] : MAX([date_utc]) }&#13;&#10;        THEN [budget_lc]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Campañas_debajo_gasto' datatype='integer' name='[Calculation_2883711200460353536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_2382967162415861760] : &#13;&#10;   IF SUM([ad_spend_lc]) / SUM([Calculation_2373397064948486145]) &lt;= 0.8 &#13;&#10;   THEN 1 &#13;&#10;   ELSE 0 &#13;&#10;   END &#13;&#10;}' />
            </column>
            <column caption='cpg_campaña' datatype='string' name='[Calculation_377739483834208256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
            </column>
            <column caption='ppto_unico_lc' datatype='real' name='[Calculation_4905264458483716096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] : MIN([Calculation_2382967162420666370]) }' />
            </column>
            <column caption='Ad Spend Lc' datatype='real' name='[ad_spend_lc]' role='measure' type='quantitative' />
