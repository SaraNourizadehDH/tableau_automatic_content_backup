      <column caption='Rank 10 impresiones' datatype='boolean' name='[Calculation_1221882910746845186]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([impressions])) &lt;= 10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Immpresiones mayores a 0' datatype='boolean' name='[Calculation_1221882910776729603]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([impressions]) / SUM({FIXED : SUM([impressions])}) &gt; 0' />
      </column>
      <column caption='dia_semana' datatype='string' name='[Calculation_1221882910834679814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATENAME(&apos;weekday&apos;, [date_utc])&#13;&#10;    WHEN &quot;Sunday&quot; THEN &quot;Domingo&quot;&#13;&#10;    WHEN &quot;Monday&quot; THEN &quot;Lunes&quot;&#13;&#10;    WHEN &quot;Tuesday&quot; THEN &quot;Martes&quot;&#13;&#10;    WHEN &quot;Wednesday&quot; THEN &quot;Miércoles&quot;&#13;&#10;    WHEN &quot;Thursday&quot; THEN &quot;Jueves&quot;&#13;&#10;    WHEN &quot;Friday&quot; THEN &quot;Viernes&quot;&#13;&#10;    WHEN &quot;Saturday&quot; THEN &quot;Sábado&quot;&#13;&#10;END' />
      </column>
      <column caption='ctr_calc' datatype='real' name='[Calculation_1221882910871773195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks]) / SUM([impressions])' />
      </column>
      <column caption='roas_eur_calc' datatype='real' name='[Calculation_1221882911021252622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([revenue_eur]) /SUM([ad_spend_eur])) * 100' />
      </column>
      <column caption='Métrica dinámica' datatype='integer' name='[Calculation_1221882911052853267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Impresiones&quot; THEN SUM([impressions])&#13;&#10;    WHEN &quot;Clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;Completados&quot; THEN SUM([users_complete_challenge])&#13;&#10;    WHEN &quot;Conversion&quot; THEN SUM([conversion])&#13;&#10;END' />
      </column>
      <column caption='Marca' datatype='string' name='[Calculation_1221882912267583514]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Resultados de campañas - &quot; + MAX([cpg_corregida])' />
      </column>
      <column caption='Mails_Push Open' datatype='integer' name='[Calculation_1221882912566460445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tool_name] in (&quot;Email&quot;, &quot;Push&quot;) THEN [impressions] ELSE 0 END' />
      </column>
      <column caption='Campañas' datatype='string' name='[Calculation_1400338065813954561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Seleccionar todas las campañas&quot;' />
      </column>
      <column caption='sales_revenue_lc' datatype='real' name='[Calculation_1495195117413605376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tool_name] = &quot;Banner Order Status&quot; OR [tool_name] = &quot;Pre Search&quot; THEN&#13;&#10;    null&#13;&#10;ELSE&#13;&#10;    IFNULL([revenue_lc], [gmv_lc])&#13;&#10;END' />
      </column>
      <column caption='Fecha_max' datatype='date' name='[Calculation_2108247636844081152]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([date_utc])' />
      </column>
      <column caption='Fecha inicio' datatype='string' name='[Calculation_2350034642247864321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE([campaign_start_utc]))' />
      </column>
      <column caption='dias_campaña' datatype='integer' name='[Calculation_2373397064947781632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([campaign_start_utc]), MAX([campaign_end_utc])) }' />
      </column>
      <column caption='gasto_esperado_hoy' datatype='real' name='[Calculation_2373397064948486145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([Calculation_4905264458483716096])} * &#13;&#10;DATEDIFF(&#13;&#10;    &apos;day&apos;, &#13;&#10;    { FIXED [campaign_name] : MIN([campaign_start_utc]) }, &#13;&#10;    IF TODAY() &lt; { FIXED [campaign_name] : MAX([campaign_end_utc]) } &#13;&#10;    THEN TODAY() &#13;&#10;    ELSE { FIXED [campaign_name] : MAX([campaign_end_utc]) } &#13;&#10;    END&#13;&#10;) / &#13;&#10;{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([campaign_start_utc]), MAX([campaign_end_utc])) }' />
      </column>
      <column caption='gasto_real' datatype='real' name='[Calculation_2373397064948875266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([ad_spend_lc]) }' />
      </column>
      <column caption='ppto_diario_esperado' datatype='real' name='[Calculation_2373397064949084163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([Calculation_4905264458483716096]) } / &#13;&#10;{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([campaign_start_utc]), MAX([campaign_end_utc])) }' />
      </column>
      <column caption='desviacion_gasto' datatype='real' name='[Calculation_2373397064949694468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145])' />
      </column>
      <column caption='Status campaña' datatype='string' name='[Calculation_2373397064949878789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] :&#13;&#10;    IF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &gt;= 0.2 THEN&#13;&#10;        &quot;Consumo por encima de proyección 🚨&quot;&#13;&#10;    ELSEIF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &lt; -0.2 THEN&#13;&#10;        &quot;Bajo rendimiento de campaña ⚠️&quot;&#13;&#10;    ELSE &#13;&#10;        &quot;Consumo alineado a proyección ✅&quot;&#13;&#10;    END&#13;&#10;}' />
      </column>
      <column caption='Nombre campaña' datatype='string' name='[Calculation_2382967162415861760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tool_name] = &apos;Home banner&apos; OR [tool_name] = &apos;Food banner&apos; THEN [component_name]&#13;&#10;ELSE [campaign_name]&#13;&#10;END' />
      </column>
      <column caption='Órdenes' datatype='integer' name='[Calculation_2382967162419507201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tool_name] = &quot;Home banner&quot; OR [tool_name] = &quot;Food banner&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    [conversion]&#13;&#10;END' />
      </column>
      <column caption='ultimo_ppto' datatype='real' name='[Calculation_2382967162420666370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id] :&#13;&#10;    MAX(&#13;&#10;        IF [date_utc] = { FIXED [Calculation_2382967162415861760] : MAX([date_utc]) }&#13;&#10;        THEN [budget_lc]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Campañas_debajo_gasto' datatype='integer' name='[Calculation_2883711200460353536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_2382967162415861760] : &#13;&#10;   IF SUM([ad_spend_lc]) / SUM([Calculation_2373397064948486145]) &lt;= 0.8 &#13;&#10;   THEN 1 &#13;&#10;   ELSE 0 &#13;&#10;   END &#13;&#10;}' />
      </column>
      <column caption='Campañas_encima_gasto' datatype='integer' name='[Calculation_2883711200461062145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_2382967162415861760] : &#13;&#10;   IF SUM([ad_spend_lc]) / SUM([Calculation_2373397064948486145]) &gt;= 1.2 &#13;&#10;   THEN 1 &#13;&#10;   ELSE 0 &#13;&#10;   END &#13;&#10;}' />
      </column>
      <column caption='Campañas_dentro_margen' datatype='integer' name='[Calculation_2883711200461152258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_2382967162415861760] : &#13;&#10;   IF SUM([ad_spend_lc]) / SUM([Calculation_2373397064948486145]) &gt; 0.8 &#13;&#10;      AND SUM([ad_spend_lc]) / SUM([Calculation_2373397064948486145]) &lt; 1.2 &#13;&#10;   THEN 1 &#13;&#10;   ELSE 0 &#13;&#10;   END &#13;&#10;}' />
      </column>
      <column caption='Keyword' datatype='string' name='[Calculation_2883711200493240325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tool_name] = &apos;Keyword search&apos; THEN [component_name] END' />
      </column>
      <column caption='cpg_campaña' datatype='string' name='[Calculation_377739483834208256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
      </column>
      <column caption='ppto_unico_lc' datatype='real' name='[Calculation_4905264458483716096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id] : MIN([Calculation_2382967162420666370]) }' />
      </column>
      <column caption='Seleccionar productos' datatype='string' name='[Campañas (copia)_2883711200463470595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Seleccionar todos los productos&quot;' />
      </column>
      <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
      </column>
      <column caption='Métrica distribucion' datatype='real' name='[Métrica dinámica (copia)_1495195117417562114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métrica (copia 2)_1495195117417136129]&#13;&#10;    WHEN &quot;Impresiones&quot; THEN SUM([impressions])&#13;&#10;    WHEN &quot;Clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ad_spend&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;Conversion&quot; THEN SUM([conversion])&#13;&#10;END' />
      </column>
      <column caption='Métrica dinámica interacción' datatype='real' name='[Métrica dinámica (copia)_725361054016651267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métrica (copia 2)_725361054016135170]&#13;&#10;    WHEN &quot;clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;ctr&quot; THEN SUM([clicks]) / SUM([impressions])&#13;&#10;    WHEN &quot;conversion&quot; THEN SUM([conversion])&#13;&#10;    WHEN &quot;cvr&quot; THEN SUM([conversion]) / SUM([clicks])&#13;&#10;END' />
      </column>
      <column caption='Métrica dinámica economics' datatype='real' name='[Métrica dinámica interacción (copia)_4905264458521030659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métricas interacción (copia)_4905264458520391682]&#13;&#10;    WHEN &quot;sales_revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;gasto_lc&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ppto-gasto_lc&quot; THEN ([Presupuesto - gasto (lc) (copia)_4905264458516312065])&#13;&#10;END' />
      </column>
      <column caption='Métrica dinámica alcance' datatype='integer' name='[Métrica dinámica interacción (copia)_725361054024531974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métricas interacción (copia)_725361054024269829]&#13;&#10;    WHEN &quot;usuarios&quot; THEN SUM([reach])&#13;&#10;    WHEN &quot;impresiones&quot; THEN SUM([impressions]) &#13;&#10;    WHEN &quot;mails abiertos&quot; THEN SUM([Calculation_1221882912566460445])&#13;&#10;END' />
      </column>
      <column caption='Métrica duplicado' datatype='real' name='[Métrica distribucion (copia)_1462262506851479552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métrica distribucion (copia)_1462262506851508225]&#13;&#10;    WHEN &quot;Impresiones&quot; THEN SUM([impressions])&#13;&#10;    WHEN &quot;Clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ad_spend&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;Conversion&quot; THEN SUM([conversion])&#13;&#10;END' />
      </column>
      <column caption='gasto/ppto' datatype='real' name='[Presupuesto - gasto (lc) (copia)_1801158428032053248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ad_spend_lc]) / SUM([Calculation_4905264458483716096])' />
