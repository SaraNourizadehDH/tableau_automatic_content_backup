    <worksheet name='evolucion parametro alcance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#666666' fontname='Tableau Bold' fontsize='11'>Métricas de alcance y visibilidad</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_otros_paises_tableau (automated_tables_reports)' name='federated.1permb90tx8cmo1cl4zv51no0kxn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Métricas alcance' datatype='string' name='[Métricas interacción (copia)_725361054024269829]' param-domain-type='list' role='measure' type='nominal' value='&quot;impresiones&quot;'>
              <calculation class='tableau' formula='&quot;impresiones&quot;' />
              <aliases>
                <alias key='&quot;usuarios&quot;' value='usuarios' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1permb90tx8cmo1cl4zv51no0kxn'>
            <column caption='Mails_Push Open' datatype='integer' name='[Calculation_1221882912566460445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [tool_name] in (&quot;Email&quot;, &quot;Push&quot;) THEN [impressions] ELSE 0 END' />
            </column>
            <column caption='Nombre campaña' datatype='string' name='[Calculation_2382967162415861760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tool_name] = &apos;Home banner&apos; OR [tool_name] = &apos;Food banner&apos; THEN [component_name]&#13;&#10;ELSE [campaign_name]&#13;&#10;END' />
            </column>
            <column caption='cpg_campaña' datatype='string' name='[Calculation_377739483834208256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
            </column>
            <column caption='Métrica dinámica alcance' datatype='integer' name='[Métrica dinámica interacción (copia)_725361054024531974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Métricas interacción (copia)_725361054024269829]&#13;&#10;    WHEN &quot;usuarios&quot; THEN SUM([reach])&#13;&#10;    WHEN &quot;impresiones&quot; THEN SUM([impressions]) &#13;&#10;    WHEN &quot;mails abiertos&quot; THEN SUM([Calculation_1221882912566460445])&#13;&#10;END' />
            </column>
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Nombre campaña_' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Categoría' datatype='string' name='[category_name]' role='dimension' type='nominal' />
            <column caption='Component Id' datatype='string' name='[component_id]' role='dimension' type='nominal' />
            <column caption='Component Name' datatype='string' name='[component_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cpg Corregida' datatype='string' name='[cpg_corregida]' role='dimension' type='nominal' />
            <column caption='Date Utc' datatype='date' name='[date_utc]' role='dimension' type='ordinal' />
            <column caption='Funnel' datatype='string' name='[funnel]' role='dimension' type='nominal' />
            <column caption='Impressions' datatype='integer' name='[impressions]' role='measure' type='quantitative' />
            <column-instance column='[date_utc]' derivation='MY' name='[my:date_utc:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2382967162415861760]' derivation='None' name='[none:Calculation_2382967162415861760:nk]' pivot='key' type='nominal' />
