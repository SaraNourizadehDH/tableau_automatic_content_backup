    <worksheet name='imp dia semana'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='14'>Distribución por métric</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_otros_paises_tableau (automated_tables_reports)' name='federated.1permb90tx8cmo1cl4zv51no0kxn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Métrica distribucion (copia)' datatype='string' name='[Métrica distribucion (copia)_1462262506851508225]' param-domain-type='list' role='measure' type='nominal' value='&quot;Impresiones&quot;'>
              <calculation class='tableau' formula='&quot;Impresiones&quot;' />
              <aliases>
                <alias key='&quot;ad_spend&quot;' value='Gasto (lc)' />
                <alias key='&quot;ppto_unico&quot;' value='Presupuesto (lc)' />
                <alias key='&quot;revenue_lc&quot;' value='Revenue (lc)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1permb90tx8cmo1cl4zv51no0kxn'>
            <column caption='dia_semana' datatype='string' name='[Calculation_1221882910834679814]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATENAME(&apos;weekday&apos;, [date_utc])&#13;&#10;    WHEN &quot;Sunday&quot; THEN &quot;Domingo&quot;&#13;&#10;    WHEN &quot;Monday&quot; THEN &quot;Lunes&quot;&#13;&#10;    WHEN &quot;Tuesday&quot; THEN &quot;Martes&quot;&#13;&#10;    WHEN &quot;Wednesday&quot; THEN &quot;Miércoles&quot;&#13;&#10;    WHEN &quot;Thursday&quot; THEN &quot;Jueves&quot;&#13;&#10;    WHEN &quot;Friday&quot; THEN &quot;Viernes&quot;&#13;&#10;    WHEN &quot;Saturday&quot; THEN &quot;Sábado&quot;&#13;&#10;END' />
            </column>
            <column caption='Campañas' datatype='string' name='[Calculation_1400338065813954561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seleccionar todas las campañas&quot;' />
            </column>
            <column caption='sales_revenue_lc' datatype='real' name='[Calculation_1495195117413605376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [tool_name] = &quot;Banner Order Status&quot; OR [tool_name] = &quot;Pre Search&quot; THEN&#13;&#10;    null&#13;&#10;ELSE&#13;&#10;    IFNULL([revenue_lc], [gmv_lc])&#13;&#10;END' />
            </column>
            <column caption='Fecha inicio' datatype='string' name='[Calculation_2350034642247864321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_start_utc]))' />
            </column>
            <column caption='Nombre campaña' datatype='string' name='[Calculation_2382967162415861760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tool_name] = &apos;Home banner&apos; OR [tool_name] = &apos;Food banner&apos; THEN [component_name]&#13;&#10;ELSE [campaign_name]&#13;&#10;END' />
            </column>
            <column caption='ultimo_ppto' datatype='real' name='[Calculation_2382967162420666370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] :&#13;&#10;    MAX(&#13;&#10;        IF [date_utc] = { FIXED [Calculation_2382967162415861760] : MAX([date_utc]) }&#13;&#10;        THEN [budget_lc]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='cpg_campaña' datatype='string' name='[Calculation_377739483834208256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
            </column>
            <column caption='ppto_unico_lc' datatype='real' name='[Calculation_4905264458483716096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] : MIN([Calculation_2382967162420666370]) }' />
            </column>
            <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
            </column>
            <column caption='Métrica duplicado' datatype='real' name='[Métrica distribucion (copia)_1462262506851479552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Métrica distribucion (copia)_1462262506851508225]&#13;&#10;    WHEN &quot;Impresiones&quot; THEN SUM([impressions])&#13;&#10;    WHEN &quot;Clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ad_spend&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;Conversion&quot; THEN SUM([conversion])&#13;&#10;END' />
            </column>
            <column caption='Ad Spend Lc' datatype='real' name='[ad_spend_lc]' role='measure' type='quantitative' />
            <column caption='Budget Lc' datatype='real' name='[budget_lc]' role='measure' type='quantitative' />
            <column caption='Campaign End Utc' datatype='datetime' name='[campaign_end_utc]' role='dimension' type='ordinal' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Nombre campaña_' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Campaign Start Utc' datatype='datetime' name='[campaign_start_utc]' role='dimension' type='ordinal' />
            <column caption='Categoría' datatype='string' name='[category_name]' role='dimension' type='nominal' />
            <column caption='Clicks' datatype='integer' name='[clicks]' role='measure' type='quantitative' />
            <column caption='Component Id' datatype='string' name='[component_id]' role='dimension' type='nominal' />
            <column caption='Component Name' datatype='string' name='[component_name]' role='dimension' type='nominal' />
            <column caption='Conversion' datatype='integer' name='[conversion]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cpg Corregida' datatype='string' name='[cpg_corregida]' role='dimension' type='nominal' />
            <column caption='Date Utc' datatype='date' name='[date_utc]' role='dimension' type='ordinal' />
            <column caption='Funnel' datatype='string' name='[funnel]' role='dimension' type='nominal' />
