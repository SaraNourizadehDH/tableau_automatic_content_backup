    <worksheet name='ppto - gasto eur_dupli'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='9'>Gasto / Ppto</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_otros_paises_tableau (automated_tables_reports)' name='federated.1permb90tx8cmo1cl4zv51no0kxn' />
          </datasources>
          <datasource-dependencies datasource='federated.1permb90tx8cmo1cl4zv51no0kxn'>
            <column caption='Campañas' datatype='string' name='[Calculation_1400338065813954561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seleccionar todas las campañas&quot;' />
            </column>
            <column caption='Fecha inicio' datatype='string' name='[Calculation_2350034642247864321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_start_utc]))' />
            </column>
            <column caption='Nombre campaña' datatype='string' name='[Calculation_2382967162415861760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tool_name] = &apos;Home banner&apos; OR [tool_name] = &apos;Food banner&apos; THEN [component_name]&#13;&#10;ELSE [campaign_name]&#13;&#10;END' />
            </column>
            <column caption='ultimo_ppto' datatype='real' name='[Calculation_2382967162420666370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] :&#13;&#10;    MAX(&#13;&#10;        IF [date_utc] = { FIXED [Calculation_2382967162415861760] : MAX([date_utc]) }&#13;&#10;        THEN [budget_lc]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='cpg_campaña' datatype='string' name='[Calculation_377739483834208256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
            </column>
            <column caption='ppto_unico_lc' datatype='real' name='[Calculation_4905264458483716096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] : MIN([Calculation_2382967162420666370]) }' />
            </column>
            <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
            </column>
            <column caption='gasto/ppto' datatype='real' name='[Presupuesto - gasto (lc) (copia)_1801158428032053248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ad_spend_lc]) / SUM([Calculation_4905264458483716096])' />
            </column>
            <column caption='Ad Spend Lc' datatype='real' name='[ad_spend_lc]' role='measure' type='quantitative' />
            <column caption='Budget Lc' datatype='real' name='[budget_lc]' role='measure' type='quantitative' />
            <column caption='Campaign End Utc' datatype='datetime' name='[campaign_end_utc]' role='dimension' type='ordinal' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Nombre campaña_' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Campaign Start Utc' datatype='datetime' name='[campaign_start_utc]' role='dimension' type='ordinal' />
            <column caption='Categoría' datatype='string' name='[category_name]' role='dimension' type='nominal' />
            <column caption='Component Id' datatype='string' name='[component_id]' role='dimension' type='nominal' />
