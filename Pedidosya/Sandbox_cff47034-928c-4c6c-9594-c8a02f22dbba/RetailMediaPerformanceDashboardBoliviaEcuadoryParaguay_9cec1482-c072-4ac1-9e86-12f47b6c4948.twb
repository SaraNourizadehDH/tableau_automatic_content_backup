      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_otros_paises_tableau (automated_tables_reports)' name='federated.1permb90tx8cmo1cl4zv51no0kxn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Métricas interacción' datatype='string' name='[Métrica (copia 2)_725361054016135170]' param-domain-type='list' role='measure' type='nominal' value='&quot;clicks&quot;'>
              <calculation class='tableau' formula='&quot;clicks&quot;' />
              <aliases>
                <alias key='&quot;conversion&quot;' value='conversion' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1permb90tx8cmo1cl4zv51no0kxn'>
            <column caption='Nombre campaña' datatype='string' name='[Calculation_2382967162415861760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tool_name] = &apos;Home banner&apos; OR [tool_name] = &apos;Food banner&apos; THEN [component_name]&#13;&#10;ELSE [campaign_name]&#13;&#10;END' />
            </column>
            <column caption='cpg_campaña' datatype='string' name='[Calculation_377739483834208256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
            </column>
            <column caption='Métrica dinámica interacción' datatype='real' name='[Métrica dinámica (copia)_725361054016651267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Métrica (copia 2)_725361054016135170]&#13;&#10;    WHEN &quot;clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;ctr&quot; THEN SUM([clicks]) / SUM([impressions])&#13;&#10;    WHEN &quot;conversion&quot; THEN SUM([conversion])&#13;&#10;    WHEN &quot;cvr&quot; THEN SUM([conversion]) / SUM([clicks])&#13;&#10;END' />
            </column>
            <column caption='Ranking metrica interaccion' datatype='integer' name='[Ranking metrica (copia)_725361054018240516]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='RANK_UNIQUE([Métrica dinámica (copia)_725361054016651267], &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
