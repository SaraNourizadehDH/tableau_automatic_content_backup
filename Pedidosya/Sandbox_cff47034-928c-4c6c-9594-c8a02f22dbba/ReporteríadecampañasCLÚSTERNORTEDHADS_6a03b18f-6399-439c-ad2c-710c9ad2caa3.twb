      <column caption='dia_semana' datatype='string' name='[Calculation_253890477516341248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATENAME(&apos;weekday&apos;, [date_utc])&#13;&#10;    WHEN &quot;Sunday&quot; THEN &quot;Domingo&quot;&#13;&#10;    WHEN &quot;Monday&quot; THEN &quot;Lunes&quot;&#13;&#10;    WHEN &quot;Tuesday&quot; THEN &quot;Martes&quot;&#13;&#10;    WHEN &quot;Wednesday&quot; THEN &quot;Miércoles&quot;&#13;&#10;    WHEN &quot;Thursday&quot; THEN &quot;Jueves&quot;&#13;&#10;    WHEN &quot;Friday&quot; THEN &quot;Viernes&quot;&#13;&#10;    WHEN &quot;Saturday&quot; THEN &quot;Sábado&quot;&#13;&#10;END' />
      </column>
      <column caption='Keyword' datatype='string' name='[Calculation_253890477926662154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tool_name] = &apos;Keyword search&apos; THEN [component_name] END' />
      </column>
      <column caption='medida ficticia' datatype='string' name='[Calculation_830351230912794624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo4]' role='measure' type='quantitative'>
