        <zone forceUpdate='true' h='1225' id='211' type-v2='text' w='98750' x='875' y='2800'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='18'>RESULTADOS DE CAMPAÑAS</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
