          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='11'>Identificador de campaña</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='1607' id='257' type-v2='text' w='18067' x='44133' y='28679'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='13'>Herramienta</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='1607' id='259' type-v2='text' w='18067' x='3600' y='37464'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='11'>Funnel</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='1607' id='261' type-v2='text' w='18067' x='43933' y='37393'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='11'>Keyword</run>
          </formatted-text>
