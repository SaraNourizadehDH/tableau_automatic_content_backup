                <zone forceUpdate='true' h='11157' id='41' type-v2='text' w='56076' x='366' y='6198'>
                  <formatted-text>
                    <run bold='true' fontcolor='#fa0050' fontsize='24'>Assortment Monitor </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#fa0050' fontsize='22'>Definiciones &amp; Herramientas</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='16529' id='152' type-v2='text' w='71376' x='19546' y='17045'>
                  <formatted-text>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Objetivo:</run>
                    <run fontcolor='#555555' fontsize='9'> Facilitar una visión integral del Assortment a diferentes niveles, así como también evidenciar los indicadores/herramientas con las que contamos para accionar sobre este.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Usuarios</run>
                    <run fontcolor='#555555' fontsize='9'>: QC Category Managers, Key Account Managers (KAM), Account Managers (AM), Account Executive (AE),  Seller. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Periodicidad: </run>
                    <run fontcolor='#555555' fontsize='9'>El monitor se actualiza una vez por mes a cierre de mes.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4649' id='151' type-v2='text' w='38141' x='293' y='17252'>
                  <formatted-text>
                    <run bold='true' fontcolor='#f1ce63' fontsize='15'>Sobre el monitor</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4649' id='61' type-v2='text' w='38141' x='805' y='34711'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#00d9fc' fontsize='14'>Métricas Perfomance</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4545' id='64' type-v2='text' w='28258' x='41362' y='35124'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ff99be' fontsize='14'>Vendor Assortment Score (VAS)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='35537' id='93' type-v2='text' w='26281' x='72401' y='35227'>
                  <formatted-text>
                    <run bold='true' fontcolor='#0755ff' fontsize='14'>Otras herramientas relevantes</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='9'>Link a Recotool:</run>
                    <run fontcolor='#000000' fontsize='9'>Æ </run>
                    <run fontcolor='#4996b2' fontsize='9' hyperlink='tabdoc:load-url url=&amp;quot;https://recommendation-tool.pedidosya.com/&amp;quot;' underline='true'>https://recommendation-tool.pedidosya.com/</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#0755ff' fontsize='14'>Soporte </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='9'>Mail de insights:</run>
                    <run fontcolor='#000000' fontsize='9'>Æ </run>
                    <run fontcolor='#1155cc' fontsize='9' underline='true'>insightsqc@pedidosya.com</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#0755ff' fontsize='14'>Feedback</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='9'>Form de Feedback: </run>
                    <run fontcolor='#4996b2' fontsize='9' hyperlink='tabdoc:load-url url=&amp;quot;https://forms.gle/gpQLi1sSXs2jht539&amp;quot;' underline='true'>https://forms.gle/gpQLi1sSXs2jht539</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='44421' id='62' type-v2='text' w='38653' x='439' y='39669'>
                  <formatted-text>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Cantidad de partners: </run>
                    <run fontcolor='#555555' fontsize='9'>cantidad de partner_id distintos.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Promedio Basket size</run>
                    <run fontcolor='#555555' fontsize='9'>: Cantidad de items promedio de las órdenes confirmadas.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Basket Value EU:</run>
                    <run fontcolor='#555555' fontsize='9'> Valor promedio de la órden, sin considerar impuestos ni descuentos, en Euros.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>CVR3 = mCVR3 (Micro CVR3):</run>
                    <run fontcolor='#555555' fontsize='9'> Sesiones que han realizado una transacción sobre sesiones que entran en un perfil de vendedor de Quick Commerce </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>VFR (Vendor Fail Rate)</run>
                    <run fontcolor='#555555' fontsize='9'>: Porcentaje de ordenes  No Confirmados cuando el motivo es el partner sobre Ordenes Totales (todos los estados). </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>VAS (Vendor Assortment Score)</run>
                    <run fontcolor='#555555' fontsize='9'>: Puntuación a nivel de partner que evalúa calidad del assortment. Para cada tipo de categoría de negocio considera las variables de assortment que explican en mayor medida variaciones en las variables de performance.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>% prod. Activos con órdenes: </run>
                    <run fontcolor='#555555' fontsize='9'>porcentaje de productos que participaron en órdenes sobre los productos activos a la fecha de información.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Partners con Recomendación</run>
                    <run fontcolor='#555555' fontsize='9'>: cantidad y porcentaje de partners que para el mes</run>
                    <run fontcolor='#555555' fontname='Poppins, sans-serif' fontsize='9'>Æ </run>
                    <run fontcolor='#555555' fontsize='9'>corriente tienen al menos una recomendación de acción en la herramienta </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='29545' id='65' type-v2='text' w='28843' x='41874' y='40599'>
                  <formatted-text>
                    <run fontcolor='#555555' fontsize='9'>Definición de variables por Segmento (</run>
                    <run fontcolor='#4996b2' fontsize='9' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/presentation/d/1t6-2iSAi1CsyUzNqSUjX80LAT8guTo6GK0-G-lZhlZw/edit?usp=sharing&amp;quot;'>https://docs.google.com/presentation/d/1t6-2iSAi1CsyUzNqSUjX80LAT8guTo6GK0-G-lZhlZw/edit?usp=sharing</run>
                    <run fontcolor='#555555' fontsize='9'>)</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='9'>Actualmente disponible para partners de todo LATAM:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='9'>Supermercados</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='9'>Drinks</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='9'>Pharma</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontsize='9' underline='true'>Termómetro VAS:</run>
                    <run fontcolor='#555555' fontsize='9'> Agrupa según la selección los partners en 3 grupos considerando la distribución del VAS. (Ver si no hay q agregar algo mas en el ordenamiento de la tabla o en el termómetro)</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{000D0317-D008-4E3A-8473-BB1EE0C21D94}' />
