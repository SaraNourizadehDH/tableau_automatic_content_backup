        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13mb9dw1nto6l011os4h807dulne' name='Consulta SQL personalizada' type='text'><![CDATA[WITH KVICount as (WITH Framework_KVIs AS (
  SELECT DISTINCT gtin
  FROM `peya-food-and-groceries.automated_tables_reports.Framework_KVIs`
)

SELECT
  pp.partner_id,
  COUNT(DISTINCT CASE WHEN fk.gtin IS NOT NULL THEN dp.gtin ELSE NULL END) AS products_in_KVIs,
  
FROM `peya-bi-tools-pro.il_core.dim_partner_product` AS pp
JOIN `peya-bi-tools-pro.il_core.dim_product` AS dp ON pp.product_id = dp.product_id
JOIN (
  SELECT
    e.partner_id,
    sfb.business_category.name_salesforce AS vertical_segment,
    e.country.country_name
  FROM `peya-bi-tools-pro.il_core.dim_partner` e
  LEFT JOIN `peya-data-origins-pro.cl_core.vendor_salesforce_business_category` sfb
    ON e.salesforce_id = sfb.salesforce_id
  WHERE sfb.business_category.name_salesforce IS NOT NULL
) AS tabla ON tabla.partner_id = pp.partner_id
LEFT JOIN Framework_KVIs AS fk ON dp.gtin = fk.gtin
GROUP BY pp.partner_id, tabla.vertical_segment, tabla.country_name)


SELECT ass.Fecha, 
ass.partner_id, 
ass.partner_name, 
ass.franchiseName,
ass.country_name, 
ass.city, 
FechaAlta,
business_type_name, 
ass.business_type_description,

 (cantOrders) AS ordenesConfirmadas,
 ass.non_confirmed_orders as ordenesRechazadas,
-- businessCategory.name as businessCategory,

 CASE WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Colmados' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Conveniencia' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Express' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimarkets' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimercados' THEN 'Convenience'

        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Supermercados' THEN 'Supermarket'

        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Frutas y Verduras','Verdulería', 'Frutas Y Verduras')
        THEN 'Frutas Y Verduras'
WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name = 'Comercios especializados' THEN 'Specialized Stores'
        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Carnicería','Carnicerías','Pollos y Carnes','Carnes y Pescados', 'Pollos y carnes', 'Carnicerias', 'Carnes y pescados') then 'Carnicerias'
        
        WHEN  partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name IS NULL THEN 'Specialized'
            WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name <<>> 'Colmados' AND partner.businessCategory.name <<>> 'Conveniencia' AND partner.businessCategory.name <<>> 'Express' AND partner.businessCategory.name <<>> 'Supermercados'   and   businessCategory.name <<>> "Minimarkets" and businessCategory.name <<>> "Minimercados" 
            
            and   businessCategory.name <<>> "Frutas y Verduras" and businessCategory.name <<>> "Verdulería" 
            and   businessCategory.name <<>> "Carnicerías" and businessCategory.name <<>> "Carnicería" 
             and   businessCategory.name <<>> "Carnicerias" 
            and   businessCategory.name <<>> "Pollos y Carnes" and businessCategory.name <<>> "Carnes y Pescados" 
            and   businessCategory.name <<>> "Pollos y carnes" and businessCategory.name <<>> "Carnes y pescados" 
            and   businessCategory.name <<>> "Comercios especializados"  
            THEN 'Specialized Stores'
            ELSE partner.business_type.business_type_name END AS businessCategory, --#_aggrupation,

EstadoPartner,
BasketSize_2, 
ass.BasketValueEU as BasketValue, 
vendor_fail_rate as FailRate,
CantProductosConOrdenesTodasLasSemanas_90dias,
CantProductosActivos_90dias,
CantProductos, 
activeProducts+ifnull(Dmart_activeProducts,0) as CantProductosActivos,
activeProdsInOrders+ifnull(Dmart_activeProdsInOrders,0) as ProdsActivoenOrders,
Nuevos90dias+ifnull(Dmart_Nuevos90dias,0) as Nuevos90dias,
ProductosActivosConL3+ifnull(Dmart_ProductosActivosConL3,0) as ProductosActivosConL3,
CantProductosNuevosConOrdenes, 
ass.Newness,
Ultrafresh_GPV_contribution_EU,
Asst_Design_Gap_L1, 
L3_category_coverage, 
Efficiency, 
AssortmentEfficiency, 
Velocity, 
BasketMix,
Frecuency,
CVR, 
CASE WHEN CantProductos>>=QProducts THEN True
ELSE False 
END AS QProdsFW,
products_in_KVIs as QKVIs,
products_in_KVIs>>=fw.KVICoverage as HasKVICoverage,
CASE WHEN CantProductos>>=QProducts AND products_in_KVIs>>=fw.KVICoverage THEN true
ELSE FALSE
END AS FrameworkCompliant,
Calidad_Minima, 
ass.latitude, 
ass.longitude, 
zona,
region, 
area_name, 
case when partner.is_darkstore is True then 'Dmarts' else 'LocalShops' end as isDmart , 
partner.account_owner,
case when tuvo_recomendacion=1 then 1 else 0 end as tuvo_recomendacion, 
action_to_add,
action_to_activate,
action_to_remove,
action_to_improve,
        CASE WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )<<=30 THEN 'Onboarding - M1'
        WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )<<=60 THEN 'Onboarding - M2'
        WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )<<=90 THEN 'Onboarding - M3' 
        WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )>>90 THEN 'Life - M4 & Up' end as antiguedad_partner,
VAS.VAS,
VAS.price_competitiveness,
VAS.typical_basket_coverage,
VAS.sku_compliance,
VAS.newness as vas_newness,
VAS.slow_mover_incidence,
VAS.kvi_coverage ,
VAS.open_time,
case when ass.franchiseName in ('Carrefour - SMK',
'Carrefour - Express',
'Dia',
'Unimarc',
'Santa María',
'Kinko',
'Super Xtra',
'Petrobras',
'Supermercados La Torre',
'La Anónima',
'Supermercado Libertad',
'Hipermercados Olé',
'Sirena',
'Peri',
'Diarco',
'Plaza Lama',
'Tambo+',
'Copec',
'Listo!',
'Coral Hipermercados',
'Super 24',
'Super Express Market',
'Super Compro',
'Mi Super Fresh',
'Wong',
'Vega Market',
'Diprova',
'Metro',
'Carrefour',
'La Colonia',
'Real Supermercados',
'Supermercado DAR',
'Fidalga',
'Super 99',
'Supermercado Portas',
'El Colonial',
'Ketal') then 1 else 0 end as AAA

FROM `peya-food-and-groceries.automated_tables_reports.Assortment_Partner` as ass

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` as partner on partner.partner_id = ass.partner_id

LEFT JOIN  `peya-bi-tools-pro.il_core.dim_area` as area on partner.address.area_id = area.area_id

LEFT JOIN `peya-food-and-groceries.automated_tables_reports.vendor_assortment_score` as vas on cast(vas.partner_id as int64)=ass.partner_id and vas.YearMonth=ass.Fecha

LEFT JOIN 
        (select YearMonth,
                partner_id,
                account_owner ,
                MAX(CASE WHEN action is not null then 1 else 0 end)  as tuvo_recomendacion,
                MAX(CASE WHEN action='to_add' THEN 1 ELSE 0 END) AS action_to_add,
                MAX(CASE WHEN action='to_activate' THEN 1 ELSE 0 END) AS action_to_activate,
                MAX(CASE WHEN action='to_remove' THEN 1 ELSE 0 END) AS action_to_remove,
                MAX(CASE WHEN action='to_improve' THEN 1 ELSE 0 END) AS action_to_improve,
                from `peya-food-and-groceries.automated_tables_reports.reco_model_productRecommendation`
                group by 1,2,3)   as reco on cast(reco.partner_id as int64)=ass.partner_id and reco.YearMonth=ass.Fecha

LEFT JOIN `peya-food-and-groceries.automated_tables_reports.Assortment_menu_and_orders` aux on cast(aux.partner_id as int64)=ass.partner_id and aux.Fecha=ass.Fecha
  left join `peya-food-and-groceries.automated_tables_reports.Assortment_VFR` as VFR
    on VFR.partner_id = ass.partner_id AND VFR.YearMonth = ass.Fecha
  left join `peya-data-origins-pro.cl_core.vendor_salesforce_business_category` sfb
    on partner.salesforce_id = sfb.salesforce_id  
  left join `peya-food-and-groceries.automated_tables_reports.FrameworkQCommerce` as fw
    on fw.vertical_segment=sfb.business_category.name_salesforce AND fw.country=ass.country_name
  left join KVICount on KVICount.partner_id=partner.partner_id

where ass.business_type_description not in ("Restaurant","Shop", "Courier Business", "Bills", "Coffee", "Flowers","Courier")

and   DATE(ass.Fecha) >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 5 MONTH) - 1 
and EstadoPartner = "ON_LINE"
and  CASE WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Colmados' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Conveniencia' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Express' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimarkets' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimercados' THEN 'Convenience'

        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Supermercados' THEN 'Supermarket'

        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Frutas y Verduras','Verdulería', 'Frutas Y Verduras')
        THEN 'Frutas Y Verduras'
WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name = 'Comercios especializados' THEN 'Specialized Stores'
        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Carnicería','Carnicerías','Pollos y Carnes','Carnes y Pescados', 'Pollos y carnes', 'Carnicerias', 'Carnes y pescados') then 'Carnicerias'
        
        WHEN  partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name IS NULL THEN 'Specialized'
            WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name <<>> 'Colmados' AND partner.businessCategory.name <<>> 'Conveniencia' AND partner.businessCategory.name <<>> 'Express' AND partner.businessCategory.name <<>> 'Supermercados'   and   businessCategory.name <<>> "Minimarkets" and businessCategory.name <<>> "Minimercados" 
            
            and   businessCategory.name <<>> "Frutas y Verduras" and businessCategory.name <<>> "Verdulería" 
            and   businessCategory.name <<>> "Carnicerías" and businessCategory.name <<>> "Carnicería" 
             and   businessCategory.name <<>> "Carnicerias" 
            and   businessCategory.name <<>> "Pollos y Carnes" and businessCategory.name <<>> "Carnes y Pescados" 
            and   businessCategory.name <<>> "Pollos y carnes" and businessCategory.name <<>> "Carnes y pescados" 
            and   businessCategory.name <<>> "Comercios especializados"  
            THEN 'Specialized Stores'
            ELSE partner.business_type.business_type_name END not in ('Coffee', 'Restaurant')]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.13mb9dw1nto6l011os4h807dulne' name='Consulta SQL personalizada' type='text'><![CDATA[WITH KVICount as (WITH Framework_KVIs AS (
  SELECT DISTINCT gtin
  FROM `peya-food-and-groceries.automated_tables_reports.Framework_KVIs`
)

SELECT
  pp.partner_id,
  COUNT(DISTINCT CASE WHEN fk.gtin IS NOT NULL THEN dp.gtin ELSE NULL END) AS products_in_KVIs,
  
FROM `peya-bi-tools-pro.il_core.dim_partner_product` AS pp
JOIN `peya-bi-tools-pro.il_core.dim_product` AS dp ON pp.product_id = dp.product_id
JOIN (
  SELECT
    e.partner_id,
    sfb.business_category.name_salesforce AS vertical_segment,
    e.country.country_name
  FROM `peya-bi-tools-pro.il_core.dim_partner` e
  LEFT JOIN `peya-data-origins-pro.cl_core.vendor_salesforce_business_category` sfb
    ON e.salesforce_id = sfb.salesforce_id
  WHERE sfb.business_category.name_salesforce IS NOT NULL
) AS tabla ON tabla.partner_id = pp.partner_id
LEFT JOIN Framework_KVIs AS fk ON dp.gtin = fk.gtin
GROUP BY pp.partner_id, tabla.vertical_segment, tabla.country_name)


SELECT ass.Fecha, 
ass.partner_id, 
ass.partner_name, 
ass.franchiseName,
ass.country_name, 
ass.city, 
FechaAlta,
business_type_name, 
ass.business_type_description,

 (cantOrders) AS ordenesConfirmadas,
 ass.non_confirmed_orders as ordenesRechazadas,
-- businessCategory.name as businessCategory,

 CASE WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Colmados' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Conveniencia' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Express' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimarkets' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimercados' THEN 'Convenience'

        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Supermercados' THEN 'Supermarket'

        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Frutas y Verduras','Verdulería', 'Frutas Y Verduras')
        THEN 'Frutas Y Verduras'
WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name = 'Comercios especializados' THEN 'Specialized Stores'
        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Carnicería','Carnicerías','Pollos y Carnes','Carnes y Pescados', 'Pollos y carnes', 'Carnicerias', 'Carnes y pescados') then 'Carnicerias'
        
        WHEN  partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name IS NULL THEN 'Specialized'
            WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name <<>> 'Colmados' AND partner.businessCategory.name <<>> 'Conveniencia' AND partner.businessCategory.name <<>> 'Express' AND partner.businessCategory.name <<>> 'Supermercados'   and   businessCategory.name <<>> "Minimarkets" and businessCategory.name <<>> "Minimercados" 
            
            and   businessCategory.name <<>> "Frutas y Verduras" and businessCategory.name <<>> "Verdulería" 
            and   businessCategory.name <<>> "Carnicerías" and businessCategory.name <<>> "Carnicería" 
             and   businessCategory.name <<>> "Carnicerias" 
            and   businessCategory.name <<>> "Pollos y Carnes" and businessCategory.name <<>> "Carnes y Pescados" 
            and   businessCategory.name <<>> "Pollos y carnes" and businessCategory.name <<>> "Carnes y pescados" 
            and   businessCategory.name <<>> "Comercios especializados"  
            THEN 'Specialized Stores'
            ELSE partner.business_type.business_type_name END AS businessCategory, --#_aggrupation,

EstadoPartner,
BasketSize_2, 
ass.BasketValueEU as BasketValue, 
vendor_fail_rate as FailRate,
CantProductosConOrdenesTodasLasSemanas_90dias,
CantProductosActivos_90dias,
CantProductos, 
activeProducts+ifnull(Dmart_activeProducts,0) as CantProductosActivos,
activeProdsInOrders+ifnull(Dmart_activeProdsInOrders,0) as ProdsActivoenOrders,
Nuevos90dias+ifnull(Dmart_Nuevos90dias,0) as Nuevos90dias,
ProductosActivosConL3+ifnull(Dmart_ProductosActivosConL3,0) as ProductosActivosConL3,
CantProductosNuevosConOrdenes, 
ass.Newness,
Ultrafresh_GPV_contribution_EU,
Asst_Design_Gap_L1, 
L3_category_coverage, 
Efficiency, 
AssortmentEfficiency, 
Velocity, 
BasketMix,
Frecuency,
CVR, 
CASE WHEN CantProductos>>=QProducts THEN True
ELSE False 
END AS QProdsFW,
products_in_KVIs as QKVIs,
products_in_KVIs>>=fw.KVICoverage as HasKVICoverage,
CASE WHEN CantProductos>>=QProducts AND products_in_KVIs>>=fw.KVICoverage THEN true
ELSE FALSE
END AS FrameworkCompliant,
Calidad_Minima, 
ass.latitude, 
ass.longitude, 
zona,
region, 
area_name, 
case when partner.is_darkstore is True then 'Dmarts' else 'LocalShops' end as isDmart , 
partner.account_owner,
case when tuvo_recomendacion=1 then 1 else 0 end as tuvo_recomendacion, 
action_to_add,
action_to_activate,
action_to_remove,
action_to_improve,
        CASE WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )<<=30 THEN 'Onboarding - M1'
        WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )<<=60 THEN 'Onboarding - M2'
        WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )<<=90 THEN 'Onboarding - M3' 
        WHEN DATE_DIFF(ass.Fecha,FechaAlta,DAY )>>90 THEN 'Life - M4 & Up' end as antiguedad_partner,
VAS.VAS,
VAS.price_competitiveness,
VAS.typical_basket_coverage,
VAS.sku_compliance,
VAS.newness as vas_newness,
VAS.slow_mover_incidence,
VAS.kvi_coverage ,
VAS.open_time,
case when ass.franchiseName in ('Carrefour - SMK',
'Carrefour - Express',
'Dia',
'Unimarc',
'Santa María',
'Kinko',
'Super Xtra',
'Petrobras',
'Supermercados La Torre',
'La Anónima',
'Supermercado Libertad',
'Hipermercados Olé',
'Sirena',
'Peri',
'Diarco',
'Plaza Lama',
'Tambo+',
'Copec',
'Listo!',
'Coral Hipermercados',
'Super 24',
'Super Express Market',
'Super Compro',
'Mi Super Fresh',
'Wong',
'Vega Market',
'Diprova',
'Metro',
'Carrefour',
'La Colonia',
'Real Supermercados',
'Supermercado DAR',
'Fidalga',
'Super 99',
'Supermercado Portas',
'El Colonial',
'Ketal') then 1 else 0 end as AAA

FROM `peya-food-and-groceries.automated_tables_reports.Assortment_Partner` as ass

LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` as partner on partner.partner_id = ass.partner_id

LEFT JOIN  `peya-bi-tools-pro.il_core.dim_area` as area on partner.address.area_id = area.area_id

LEFT JOIN `peya-food-and-groceries.automated_tables_reports.vendor_assortment_score` as vas on cast(vas.partner_id as int64)=ass.partner_id and vas.YearMonth=ass.Fecha

LEFT JOIN 
        (select YearMonth,
                partner_id,
                account_owner ,
                MAX(CASE WHEN action is not null then 1 else 0 end)  as tuvo_recomendacion,
                MAX(CASE WHEN action='to_add' THEN 1 ELSE 0 END) AS action_to_add,
                MAX(CASE WHEN action='to_activate' THEN 1 ELSE 0 END) AS action_to_activate,
                MAX(CASE WHEN action='to_remove' THEN 1 ELSE 0 END) AS action_to_remove,
                MAX(CASE WHEN action='to_improve' THEN 1 ELSE 0 END) AS action_to_improve,
                from `peya-food-and-groceries.automated_tables_reports.reco_model_productRecommendation`
                group by 1,2,3)   as reco on cast(reco.partner_id as int64)=ass.partner_id and reco.YearMonth=ass.Fecha

LEFT JOIN `peya-food-and-groceries.automated_tables_reports.Assortment_menu_and_orders` aux on cast(aux.partner_id as int64)=ass.partner_id and aux.Fecha=ass.Fecha
  left join `peya-food-and-groceries.automated_tables_reports.Assortment_VFR` as VFR
    on VFR.partner_id = ass.partner_id AND VFR.YearMonth = ass.Fecha
  left join `peya-data-origins-pro.cl_core.vendor_salesforce_business_category` sfb
    on partner.salesforce_id = sfb.salesforce_id  
  left join `peya-food-and-groceries.automated_tables_reports.FrameworkQCommerce` as fw
    on fw.vertical_segment=sfb.business_category.name_salesforce AND fw.country=ass.country_name
  left join KVICount on KVICount.partner_id=partner.partner_id

where ass.business_type_description not in ("Restaurant","Shop", "Courier Business", "Bills", "Coffee", "Flowers","Courier")

and   DATE(ass.Fecha) >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 5 MONTH) - 1 
and EstadoPartner = "ON_LINE"
and  CASE WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Colmados' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Conveniencia' THEN 'Convenience'
        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Express' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimarkets' THEN 'Convenience'
WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Minimercados' THEN 'Convenience'

        WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name = 'Supermercados' THEN 'Supermarket'

        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Frutas y Verduras','Verdulería', 'Frutas Y Verduras')
        THEN 'Frutas Y Verduras'
WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name = 'Comercios especializados' THEN 'Specialized Stores'
        WHEN partner.business_type.business_type_name = 'Market' and partner.businessCategory.name in ('Carnicería','Carnicerías','Pollos y Carnes','Carnes y Pescados', 'Pollos y carnes', 'Carnicerias', 'Carnes y pescados') then 'Carnicerias'
        
        WHEN  partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name IS NULL THEN 'Specialized'
            WHEN partner.business_type.business_type_name = 'Market' AND partner.businessCategory.name <<>> 'Colmados' AND partner.businessCategory.name <<>> 'Conveniencia' AND partner.businessCategory.name <<>> 'Express' AND partner.businessCategory.name <<>> 'Supermercados'   and   businessCategory.name <<>> "Minimarkets" and businessCategory.name <<>> "Minimercados" 
            
            and   businessCategory.name <<>> "Frutas y Verduras" and businessCategory.name <<>> "Verdulería" 
            and   businessCategory.name <<>> "Carnicerías" and businessCategory.name <<>> "Carnicería" 
             and   businessCategory.name <<>> "Carnicerias" 
            and   businessCategory.name <<>> "Pollos y Carnes" and businessCategory.name <<>> "Carnes y Pescados" 
            and   businessCategory.name <<>> "Pollos y carnes" and businessCategory.name <<>> "Carnes y pescados" 
            and   businessCategory.name <<>> "Comercios especializados"  
            THEN 'Specialized Stores'
            ELSE partner.business_type.business_type_name END not in ('Coffee', 'Restaurant')]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
