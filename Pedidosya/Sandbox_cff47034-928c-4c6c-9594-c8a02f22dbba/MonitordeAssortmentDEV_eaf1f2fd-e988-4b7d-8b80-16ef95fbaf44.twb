              <calculation class='tableau' formula='[ProdsActivoenOrders]/[CantProductosActivos]' />
            </column>
            <column caption='Recomendación' datatype='string' name='[Calculation_1390767917420548100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [tuvo_recomendacion]=1 then &apos;✔&apos; else &apos;✖&apos; END' />
            </column>
            <column caption='Percentil' datatype='string' name='[Calculation_1390767917538967568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [VAS] &lt;= {PERCENTILE([VAS], .33)} THEN &quot;1&quot;&#13;&#10;ELSEIF [VAS] &lt;= {PERCENTILE([VAS], .66)} THEN &quot;2&quot;&#13;&#10;ELSEIF [VAS] &lt;= {PERCENTILE([VAS], 1)} THEN &quot;3&quot;&#13;&#10;ELSE &quot;NA&quot;&#13;&#10;END' />
            </column>
            <column caption='VAS  ' datatype='real' name='[Calculation_1910089248795172883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [antiguedad_partner]=&apos;Life - M4 &amp; Up&apos; then [VAS] else 0 END' />
            </column>
            <column caption='AAA_' datatype='string' name='[Calculation_1910089248853778456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF AAA=1 THEN &apos;yes&apos; ELSE &apos;no&apos; END' />
            </column>
            <column caption='Sesiones por partner' datatype='real' name='[Calculation_315252038205112324]' role='measure' type='quantitative'>
