      <datasource-dependencies datasource='Parameters'>
        <column caption='Parámetro _2' datatype='string' name='[Parámetro (copia)_1067353168233205782]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR&quot;'>
          <calculation class='tableau' formula='&quot;CVR&quot;' />
        </column>
        <column caption='Parámetro' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Basket size&quot;'>
          <calculation class='tableau' formula='&quot;Basket size&quot;' />
        </column>
        <column caption='Parámetro _3' datatype='string' name='[Parámetro _2 (copia)_1067353168233267223]' param-domain-type='list' role='measure' type='nominal' value='&quot;VFR&quot;'>
          <calculation class='tableau' formula='&quot;VFR&quot;' />
