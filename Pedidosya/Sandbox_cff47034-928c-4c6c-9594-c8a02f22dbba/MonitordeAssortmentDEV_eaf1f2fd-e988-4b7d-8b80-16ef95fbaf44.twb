    <worksheet name='termometro'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1b1b1b' fontsize='10'>Termometro VAS</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='9'>Prioridad Alta: VAS con peor performance // Prioridad Baja: VAS con mejor performance</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='9'>aplica solo a partner con segmento = Life M4 &amp; Up</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.05hyj190t5vq9n1dfj8j0160mi1o' />
          </datasources>
          <datasource-dependencies datasource='federated.05hyj190t5vq9n1dfj8j0160mi1o'>
            <column caption='Percentil' datatype='string' name='[Calculation_1390767917538967568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [VAS] &lt;= {PERCENTILE([VAS], .33)} THEN &quot;1&quot;&#13;&#10;ELSEIF [VAS] &lt;= {PERCENTILE([VAS], .66)} THEN &quot;2&quot;&#13;&#10;ELSEIF [VAS] &lt;= {PERCENTILE([VAS], 1)} THEN &quot;3&quot;&#13;&#10;ELSE &quot;NA&quot;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[VAS]' role='measure' type='quantitative' />
            <column-instance column='[partner_name]' derivation='CountD' name='[ctd:partner_name:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[isDmart]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1390767917538967568]' derivation='None' name='[none:Calculation_1390767917538967568:nk]' pivot='key' type='nominal' />
