          <named-connection caption='BigQuery' name='bigquery.13mb9dw1nto6l011os4h807dulne'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='automated_tables_reports' server-oauth='' username='isabel.geymonat@pedidosya.com' workgroup-auth-mode='prompt' />
