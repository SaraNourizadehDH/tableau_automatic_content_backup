      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05hyj190t5vq9n1dfj8j0160mi1o].[sum:BasketSize_2:qk]&quot;' value='Basket Size' />
          <alias key='&quot;[federated.05hyj190t5vq9n1dfj8j0160mi1o].[sum:BasketValue:qk]&quot;' value='Basket Value' />
        </aliases>
      </column>
      <column datatype='real' name='[BasketSize_2]' role='measure' type='quantitative' />
      <column datatype='real' name='[BasketValue]' role='measure' type='quantitative' />
      <column caption='CVR3' datatype='real' name='[CVR]' role='measure' type='quantitative' />
      <column caption='Recomendacion S/N' datatype='string' name='[Calculation_1067353167769190400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [tuvo_recomendacion]=1 then &apos;yes&apos; else &apos;no&apos; end' />
      </column>
      <column caption='Partners_anteriores' datatype='integer' name='[Calculation_1067353167786328068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id]) - LOOKUP(ZN(COUNTD([partner_id])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Variacion partners' datatype='real' name='[Calculation_1067353167788060681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1067353167786328068]/COUNTD([partner_id])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Recomendacion=si' datatype='real' name='[Calculation_1067353167794667534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tuvo_recomendacion])/COUNTD([tuvo_recomendacion])' />
      </column>
      <column caption='Partners-1' datatype='integer' name='[Calculation_1067353167832375311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='lookup(COUNTD([partner_id]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Basket size ant-.' datatype='real' name='[Calculation_1067353167837614097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([BasketSize_2]) - LOOKUP(ZN(AVG([BasketSize_2])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Var. basket size' datatype='real' name='[Calculation_1067353167837859858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1067353167837614097]/AVG([BasketSize_2])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% prod. activos con ordenes' datatype='real' name='[Calculation_1067353168150642707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ProdsActivoenOrders]/[CantProductosActivos]' />
      </column>
      <column caption='Parámetro' datatype='real' name='[Calculation_1067353168152719380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1]=&apos;Basket size&apos; then [BasketSize_2]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&apos;Basket value&apos; then [BasketValue]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&apos;# Partners&apos; then [Calculation_1067353168156307477]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&apos;CVR&apos; THEN [CVR]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&apos;VAS&apos; THEN [VAS]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&apos;VFR&apos; THEN [FailRate]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1]=&apos;Frame compliance &apos; THEN [Calculation_1390767917178376192]&#13;&#10;END' />
      </column>
      <column caption='Parteners' datatype='integer' name='[Calculation_1067353168156307477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='New FR_2' datatype='integer' name='[Calculation_1390767917178376192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [FrameworkCompliant]=true then 1 else 0 END' />
      </column>
      <column caption='ayx' datatype='date' name='[Calculation_1390767917185888257]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Fecha]-1' />
      </column>
      <column caption='Framework Compliant ' datatype='string' name='[Calculation_1390767917419347971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_1910089248805736469]=&apos;yes&apos; then &apos;✔&apos; else &apos;✖&apos; END' />
      </column>
      <column caption='Recomendación' datatype='string' name='[Calculation_1390767917420548100]' role='dimension' type='nominal'>
