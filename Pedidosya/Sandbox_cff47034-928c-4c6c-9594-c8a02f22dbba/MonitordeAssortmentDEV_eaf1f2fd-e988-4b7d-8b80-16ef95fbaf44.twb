          <datasource-dependencies datasource='federated.05hyj190t5vq9n1dfj8j0160mi1o'>
            <column datatype='integer' name='[AAA]' role='measure' type='quantitative' />
            <column caption='Recomendación' datatype='string' name='[Calculation_1390767917420548100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [tuvo_recomendacion]=1 then &apos;✔&apos; else &apos;✖&apos; END' />
            </column>
            <column caption='Percentil' datatype='string' name='[Calculation_1390767917538967568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [VAS] &lt;= {PERCENTILE([VAS], .33)} THEN &quot;1&quot;&#13;&#10;ELSEIF [VAS] &lt;= {PERCENTILE([VAS], .66)} THEN &quot;2&quot;&#13;&#10;ELSEIF [VAS] &lt;= {PERCENTILE([VAS], 1)} THEN &quot;3&quot;&#13;&#10;ELSE &quot;NA&quot;&#13;&#10;END' />
            </column>
            <column caption='VAS  ' datatype='real' name='[Calculation_1910089248795172883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [antiguedad_partner]=&apos;Life - M4 &amp; Up&apos; then [VAS] else 0 END' />
            </column>
            <column caption='AAA_' datatype='string' name='[Calculation_1910089248853778456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF AAA=1 THEN &apos;yes&apos; ELSE &apos;no&apos; END' />
            </column>
            <column caption='Competitividad en precios canasta básica  (ponderador 3)   ' datatype='real' name='[Competitividad en precios canasta básica  (peso 30%) (copia)_315252038214062088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[price_competitiveness]*3' />
            </column>
            <column caption='Cumplimiento de # de SKUs (ponderador 1.5)' datatype='real' name='[Cumplimiento de # de SKUs (peso 10%) (copia)_315252038202773506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sku_compliance]' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[FailRate]' role='measure' type='quantitative' />
            <column datatype='date' name='[Fecha]' role='dimension' type='ordinal' />
            <column caption='Slow movers / prod en órdenes (ponderador 1.5)  ' datatype='real' name='[Slow movers / prod en órdenes (peso 15%) (copia)_315252038214324233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[slow_mover_incidence]' />
            </column>
