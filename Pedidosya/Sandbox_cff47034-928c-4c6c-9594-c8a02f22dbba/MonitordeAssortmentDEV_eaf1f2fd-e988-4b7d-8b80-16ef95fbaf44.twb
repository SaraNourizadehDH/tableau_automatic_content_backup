          <formatted-text>
            <run bold='true' fontcolor='#0755ff' fontsize='14'>Otras herramientas relevantes</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontsize='9'>Link a Recotool:</run>
