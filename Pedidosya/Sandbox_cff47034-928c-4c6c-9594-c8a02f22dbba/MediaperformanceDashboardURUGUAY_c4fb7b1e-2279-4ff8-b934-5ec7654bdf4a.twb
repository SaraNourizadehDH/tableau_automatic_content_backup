    <worksheet name='evolucion parametro alcance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='2' fontcolor='#666666' fontname='Tableau Bold' fontsize='11'>Evolución de métricas</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_uruguay_tableau (automated_tables_reports)' name='federated.1pgydho1a10aqr100zdkj01psot4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Métricas alcance' datatype='string' name='[Métricas interacción (copia)_725361054024269829]' param-domain-type='list' role='measure' type='nominal' value='&quot;impresiones&quot;'>
              <calculation class='tableau' formula='&quot;impresiones&quot;' />
              <aliases>
                <alias key='&quot;usuarios&quot;' value='usuarios' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pgydho1a10aqr100zdkj01psot4'>
            <column caption='Mails_Push Open' datatype='integer' name='[Calculation_1221882912566460445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [tool_name] in (&quot;Email&quot;, &quot;Push&quot;) THEN [impressions] ELSE 0 END' />
            </column>
            <column caption='Campañas' datatype='string' name='[Calculation_1400338065813954561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seleccionar todas las campañas del periodo&quot;' />
            </column>
            <column caption='Fecha inicio' datatype='string' name='[Calculation_2350034642247864321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_start_utc]))' />
            </column>
            <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
            </column>
            <column caption='Métrica dinámica alcance' datatype='integer' name='[Métrica dinámica interacción (copia)_725361054024531974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Métricas interacción (copia)_725361054024269829]&#13;&#10;    WHEN &quot;usuarios&quot; THEN SUM([reach])&#13;&#10;    WHEN &quot;impresiones&quot; THEN SUM([impressions]) &#13;&#10;    WHEN &quot;mails abiertos&quot; THEN SUM([Calculation_1221882912566460445])&#13;&#10;END' />
            </column>
            <column caption='Campaign End Utc' datatype='datetime' name='[campaign_end_utc]' role='dimension' type='ordinal' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Campaign Start Utc' datatype='datetime' name='[campaign_start_utc]' role='dimension' type='ordinal' />
            <column caption='Category Name' datatype='string' name='[category_name]' role='dimension' type='nominal' />
            <column caption='Component Id' datatype='string' name='[component_id]' role='dimension' type='nominal' />
