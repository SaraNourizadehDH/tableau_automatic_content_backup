    <worksheet name='dsdsds'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='16'>Control gasto por campaña</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_uruguay_tableau (automated_tables_reports)' name='federated.1pgydho1a10aqr100zdkj01psot4' />
          </datasources>
          <datasource-dependencies datasource='federated.1pgydho1a10aqr100zdkj01psot4'>
            <column caption='Fecha inicio' datatype='string' name='[Calculation_2350034642247864321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_start_utc]))' />
            </column>
            <column caption='dias_campaña' datatype='integer' name='[Calculation_2373397064947781632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([campaign_start_utc]), MAX([campaign_end_utc])) }' />
            </column>
            <column caption='gasto_esperado_hoy' datatype='real' name='[Calculation_2373397064948486145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([Calculation_4905264458483716096])} * &#13;&#10;DATEDIFF(&#13;&#10;    &apos;day&apos;, &#13;&#10;    { FIXED [campaign_name] : MIN([campaign_start_utc]) }, &#13;&#10;    IF TODAY() &lt; { FIXED [campaign_name] : MAX([campaign_end_utc]) } &#13;&#10;    THEN TODAY() &#13;&#10;    ELSE { FIXED [campaign_name] : MAX([campaign_end_utc]) } &#13;&#10;    END&#13;&#10;) / &#13;&#10;{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([campaign_start_utc]), MAX([campaign_end_utc])) }' />
            </column>
            <column caption='gasto_real' datatype='real' name='[Calculation_2373397064948875266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([ad_spend_lc]) }' />
            </column>
            <column caption='ppto_diario_esperado' datatype='real' name='[Calculation_2373397064949084163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([Calculation_4905264458483716096]) } / &#13;&#10;{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([campaign_start_utc]), MAX([campaign_end_utc])) }' />
            </column>
            <column caption='desviacion_gasto' datatype='real' name='[Calculation_2373397064949694468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145])' />
            </column>
            <column caption='Estado campaña' datatype='string' name='[Calculation_2373397064949878789]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &gt; 0.2 THEN&#13;&#10;   &quot;Por encima del gasto 🚨&quot;&#13;&#10;ELSEIF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &lt; -0.2 THEN&#13;&#10;   &quot;Por debajo del gasto ⚠️&quot;&#13;&#10;ELSE &#13;&#10;   &quot;Dentro del margen ✅&quot;&#13;&#10;END' />
            </column>
            <column caption='ppto_unico_lc' datatype='real' name='[Calculation_4905264458483716096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] : MIN([budget_lc]) }' />
            </column>
            <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
            </column>
            <column caption='Ad Spend Lc' datatype='real' name='[ad_spend_lc]' role='measure' type='quantitative' />
            <column caption='Budget Lc' datatype='real' name='[budget_lc]' role='measure' type='quantitative' />
            <column caption='Campaign End Utc' datatype='datetime' name='[campaign_end_utc]' role='dimension' type='ordinal' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Campaign Start Utc' datatype='datetime' name='[campaign_start_utc]' role='dimension' type='ordinal' />
            <column caption='Category Name' datatype='string' name='[category_name]' role='dimension' type='nominal' />
