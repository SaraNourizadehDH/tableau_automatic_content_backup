  </column>
  <column caption='North LATAM' datatype='string' name='[Calculation_1037798246523670534]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [country_name] IN (&apos;Panamá&apos;, &apos;Honduras&apos;, &apos;Nicaragua&apos;, &apos;Costa Rica&apos;, &apos;Salvador&apos;, &apos;Guatemala&apos;) THEN &apos;Sì&apos; ELSE &apos;No&apos; END' />
  </column>
  <column caption='order_cpg' datatype='integer' name='[Calculation_1885037927859150851]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF  [product_cpg] = [Parameters].[Parámetro 5] THEN [orders]&#13;&#10;ELSE NULL END' />
  </column>
  <column caption='Share Órdenes' datatype='real' name='[Calculation_1885037927859228676]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([Calculation_1885037927859150851])/ (COUNTD([Calculation_930837762504982533]))' />
  </column>
  <column caption='Basket Size' datatype='real' name='[Calculation_601230561182400512]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ROUND(FLOAT(SUM([quantity]) / COUNTD([orders])), 2)' />
  </column>
  <column caption='Basket Value' datatype='real' name='[Calculation_601230561182679041]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([gmv_eu])/COUNTD([orders])' />
  </column>
  <column caption='Frecuencia' datatype='real' name='[Calculation_695243203411132416]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([orders])/COUNTD([users])' />
  </column>
  <column caption='Aux share gmv' datatype='string' name='[Calculation_930837762499674112]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='{ FIXED [categoria] : MAX(IF [Parameters].[Parámetro 5] = [product_cpg] THEN [categoria] END) }' />
  </column>
  <column caption='Categoria CPG Seleccionada' datatype='string' name='[Calculation_930837762500907011]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='{ FIXED [categoria] : MAX(IF [Parameters].[Parámetro 5] = [product_cpg] THEN [categoria] END) }' />
  </column>
  <column caption='GMV en Mismas Categorías de Otras' datatype='real' name='[Calculation_930837762502438916]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF NOT ISNULL({ FIXED [categoria] : MAX(IF [Parameters].[Parámetro 5] = [product_cpg] THEN [categoria] END) })&#13;&#10;THEN [gmv_eu] ELSE 0 END' />
  </column>
  <column caption='Orders en Mismas Categorías de Otras CPGs' datatype='integer' name='[Calculation_930837762504982533]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF NOT ISNULL({ FIXED [categoria] : MAX(IF [Parameters].[Parámetro 5] = [product_cpg] THEN [categoria] END) })&#13;&#10;THEN [orders] ELSE 0 END' />
  </column>
  <column caption='Unidades en Mismas Categorías de Otras CPGs ' datatype='real' name='[Orders en Mismas Categorías de Otras CPGs (copia)_930837762505482247]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF NOT ISNULL({ FIXED [categoria] : MAX(IF [Parameters].[Parámetro 5] = [product_cpg] THEN [categoria] END) })&#13;&#10;THEN [quantity] ELSE 0 END' />
  </column>
  <column caption='Share Unidades' datatype='real' name='[Share Órdenes (copia)_930837762505371654]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([gmv_cpg  (copia)_930837762507108360])/ (SUM([Orders en Mismas Categorías de Otras CPGs (copia)_930837762505482247]))' />
  </column>
