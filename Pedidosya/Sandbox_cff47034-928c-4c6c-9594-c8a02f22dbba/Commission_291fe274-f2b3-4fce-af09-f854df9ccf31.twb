          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0jzu5d01b7cd0c1715xq201mmb88' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='LN' caption='Source' datatype='string' name='[CR (copia)]' param-domain-type='list' role='measure' type='nominal' value='&quot;LUCANET&quot;'>
              <calculation class='tableau' formula='&quot;LUCANET&quot;' />
              <aliases>
                <alias key='&quot;LUCANET&quot;' value='LN' />
              </aliases>
            </column>
            <column caption='CR' datatype='string' name='[GMV_Food Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;FOOD&quot;'>
              <calculation class='tableau' formula='&quot;FOOD&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jzu5d01b7cd0c1715xq201mmb88'>
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='Commission Revenue Total' datatype='real' name='[Calculation_438256538946990080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Commission_Revenue_Food]+[Commission_Revenue_Local_Stores]' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_438256538947166209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Food Parámetro]&#13;&#10;      WHEN &apos;FOOD&apos; THEN [GFV_Food]&#13;&#10;      WHEN &apos;LOCAL STORES&apos; THEN [GFV_Local_Stores]&#13;&#10;      WHEN &apos;TOTAL&apos; THEN [Calculation_438256539588079624]&#13;&#10;END' />
            </column>
            <column caption='Commission Revenue ' datatype='real' name='[Calculation_438256538953269251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Food Parámetro]&#13;&#10;      WHEN &apos;FOOD&apos; THEN [Commission_Revenue_Food]&#13;&#10;      WHEN &apos;LOCAL STORES&apos; THEN [Commission_Revenue_Local_Stores]&#13;&#10;      WHEN &apos;TOTAL&apos; THEN [Calculation_438256538946990080]&#13;&#10;END' />
            </column>
            <column caption='Commission Rate' datatype='real' name='[Calculation_438256538954022916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Food Parámetro]&#13;&#10;      WHEN &apos;FOOD&apos; THEN SUM([Commission_Revenue_Food])/SUM([GFV_Food])&#13;&#10;      WHEN &apos;LOCAL STORES&apos; THEN SUM([Commission_Revenue_Local_Stores])/SUM([GFV_Local_Stores])&#13;&#10;      WHEN &apos;TOTAL&apos; THEN SUM([Calculation_438256538946990080])/SUM([Calculation_438256538947166209])&#13;&#10;END' />
            </column>
            <column caption='GFV Total' datatype='real' name='[Calculation_438256539588079624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GFV_Food]+[GFV_Local_Stores]' />
            </column>
            <column datatype='real' name='[Commission_Revenue_Food]' role='measure' type='quantitative' />
            <column datatype='real' name='[Commission_Revenue_Local_Stores]' role='measure' type='quantitative' />
            <column datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column datatype='date' name='[DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='real' name='[GFV_Food]' role='measure' type='quantitative' />
            <column datatype='real' name='[GFV_Local_Stores]' role='measure' type='quantitative' />
