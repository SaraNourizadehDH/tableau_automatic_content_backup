    <worksheet name='Tabla CR Evolution'>
      <repository-location id='TablaCREvolution' path='/t/Pedidosya/workbooks/Commission' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (automated_tables_reports)' name='federated.0jzu5d01b7cd0c1715xq201mmb88' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='CR' datatype='string' name='[GMV_Food Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;FOOD&quot;'>
              <calculation class='tableau' formula='&quot;FOOD&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jzu5d01b7cd0c1715xq201mmb88'>
            <column caption='AFV Total' datatype='real' name='[AFV (copia)_438256539588313097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AFV_Food]+[AFV_Local_Stores]' />
            </column>
            <column datatype='real' name='[AFV_Food]' role='measure' type='quantitative' />
            <column datatype='real' name='[AFV_Local_Stores]' role='measure' type='quantitative' />
            <column datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='Commission Revenue Total' datatype='real' name='[Calculation_438256538946990080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Commission_Revenue_Food]+[Commission_Revenue_Local_Stores]' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_438256538947166209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Food Parámetro]&#13;&#10;      WHEN &apos;FOOD&apos; THEN [GFV_Food]&#13;&#10;      WHEN &apos;LOCAL STORES&apos; THEN [GFV_Local_Stores]&#13;&#10;      WHEN &apos;TOTAL&apos; THEN [Calculation_438256539588079624]&#13;&#10;END' />
            </column>
            <column caption='Commission Revenue ' datatype='real' name='[Calculation_438256538953269251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Food Parámetro]&#13;&#10;      WHEN &apos;FOOD&apos; THEN [Commission_Revenue_Food]&#13;&#10;      WHEN &apos;LOCAL STORES&apos; THEN [Commission_Revenue_Local_Stores]&#13;&#10;      WHEN &apos;TOTAL&apos; THEN [Calculation_438256538946990080]&#13;&#10;END' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_438256539586183173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Food Parámetro]&#13;&#10;      WHEN &apos;FOOD&apos; THEN [AFV_Food]&#13;&#10;      WHEN &apos;LOCAL STORES&apos; THEN [AFV_Local_Stores]&#13;&#10;      WHEN &apos;TOTAL&apos; THEN [AFV (copia)_438256539588313097]&#13;&#10;END' />
