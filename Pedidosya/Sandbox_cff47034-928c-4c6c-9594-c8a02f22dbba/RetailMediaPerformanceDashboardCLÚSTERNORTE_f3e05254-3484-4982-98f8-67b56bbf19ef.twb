    <worksheet name='Share CPG - metrica (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='8'>Share por CPG  (% revenue)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_cluster_norte_tableau (automated_tables_reports)' name='federated.0uwep9l1ome0pi1a26kqu1i3gs8g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Métrica distribucion' datatype='string' name='[Métrica (copia 2)_1495195117417136129]' param-domain-type='list' role='measure' type='nominal' value='&quot;Impresiones&quot;'>
              <calculation class='tableau' formula='&quot;Impresiones&quot;' />
              <aliases>
                <alias key='&quot;ad_spend&quot;' value='Gasto (lc)' />
                <alias key='&quot;ppto_unico&quot;' value='Presupuesto (lc)' />
                <alias key='&quot;revenue_lc&quot;' value='Revenue (lc)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0uwep9l1ome0pi1a26kqu1i3gs8g'>
            <column caption='sales_revenue_lc' datatype='real' name='[Calculation_1495195117413605376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([revenue_lc], [gmv_lc])' />
            </column>
            <column caption='cpg_campaña' datatype='string' name='[Calculation_2184245884357120000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
            </column>
            <column caption='ppto_unico_lc' datatype='real' name='[Calculation_4905264458483716096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] : MIN([budget_lc]) }' />
            </column>
            <column caption='Métrica distribucion' datatype='real' name='[Métrica dinámica (copia)_1495195117417562114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Métrica (copia 2)_1495195117417136129]&#13;&#10;    WHEN &quot;Impresiones&quot; THEN SUM([impressions])&#13;&#10;    WHEN &quot;Clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ad_spend&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;Conversion&quot; THEN SUM([conversion])&#13;&#10;END' />
            </column>
            <column caption='Ad Spend Lc' datatype='real' name='[ad_spend_lc]' role='measure' type='quantitative' />
            <column caption='Budget Lc' datatype='real' name='[budget_lc]' role='measure' type='quantitative' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Category Name' datatype='string' name='[category_name]' role='dimension' type='nominal' />
            <column caption='Clicks' datatype='integer' name='[clicks]' role='measure' type='quantitative' />
