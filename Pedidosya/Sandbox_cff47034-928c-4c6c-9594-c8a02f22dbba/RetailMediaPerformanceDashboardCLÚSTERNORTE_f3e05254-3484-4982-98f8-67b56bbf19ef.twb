      <datasource-dependencies datasource='federated.0uwep9l1ome0pi1a26kqu1i3gs8g'>
        <column caption='cpg_campaña' datatype='string' name='[Calculation_2184245884357120000]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
        </column>
        <column caption='Estado campaña' datatype='string' name='[Calculation_2373397064949878789]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &gt; 0.2 THEN&#13;&#10;   &quot;Consumo por encima de proyección 🚨&quot;&#13;&#10;ELSEIF (SUM([ad_spend_lc]) - SUM([Calculation_2373397064948486145])) / SUM([Calculation_2373397064948486145]) &lt; -0.2 THEN&#13;&#10;   &quot;Bajo rendimiento de campaña ⚠️&quot;&#13;&#10;ELSE &#13;&#10;   &quot;Consumo alineado a proyección ✅&quot;&#13;&#10;END' />
        </column>
