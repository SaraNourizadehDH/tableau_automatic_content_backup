            </column>
            <column caption='Var_clicks-1' datatype='real' name='[Var_impresiones-1 (copia)_233342795409731586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([clicks]) - LOOKUP(SUM([clicks]), -1)) / LOOKUP(SUM([clicks]), -1)'>
