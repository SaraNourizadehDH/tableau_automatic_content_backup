      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='2' fontcolor='#555555' fontname='Tableau Bold' fontsize='11'>Métricas Interacción y Conversión</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_cluster_norte_tableau (automated_tables_reports)' name='federated.0uwep9l1ome0pi1a26kqu1i3gs8g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='conversion' caption='Métricas interacción' datatype='string' name='[Métrica (copia 2)_725361054016135170]' param-domain-type='list' role='measure' type='nominal' value='&quot;conversion&quot;'>
              <calculation class='tableau' formula='&quot;conversion&quot;' />
              <aliases>
                <alias key='&quot;conversion&quot;' value='conversion' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0uwep9l1ome0pi1a26kqu1i3gs8g'>
            <column caption='Campañas' datatype='string' name='[Calculation_1400338065813954561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seleccionar todas las campañas&quot;' />
            </column>
            <column caption='cpg_campaña' datatype='string' name='[Calculation_2184245884357120000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([cpg_corregida]) OR [cpg_corregida] = &quot;Others&quot; THEN&#13;&#10;    [campaign_name]&#13;&#10;ELSE&#13;&#10;    [cpg_corregida]&#13;&#10;END' />
            </column>
            <column caption='Fecha inicio' datatype='string' name='[Calculation_2350034642247864321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_start_utc]))' />
            </column>
            <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
            </column>
            <column caption='Métrica dinámica interacción' datatype='real' name='[Métrica dinámica (copia)_725361054016651267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Métrica (copia 2)_725361054016135170]&#13;&#10;    WHEN &quot;clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;ctr&quot; THEN SUM([clicks]) / SUM([impressions])&#13;&#10;    WHEN &quot;conversion&quot; THEN SUM([conversion])&#13;&#10;    WHEN &quot;cvr&quot; THEN SUM([conversion]) / SUM([clicks])&#13;&#10;END' />
            </column>
            <column caption='Campaign End Utc' datatype='datetime' name='[campaign_end_utc]' role='dimension' type='ordinal' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
