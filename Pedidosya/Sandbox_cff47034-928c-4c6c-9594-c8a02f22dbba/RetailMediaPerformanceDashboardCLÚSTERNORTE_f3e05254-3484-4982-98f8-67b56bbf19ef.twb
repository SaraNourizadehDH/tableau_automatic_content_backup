      <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
      </column>
      <column caption='Métrica distribucion' datatype='real' name='[Métrica dinámica (copia)_1495195117417562114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métrica (copia 2)_1495195117417136129]&#13;&#10;    WHEN &quot;Impresiones&quot; THEN SUM([impressions])&#13;&#10;    WHEN &quot;Clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ad_spend&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;Conversion&quot; THEN SUM([conversion])&#13;&#10;END' />
      </column>
      <column caption='Métrica dinámica interacción' datatype='real' name='[Métrica dinámica (copia)_725361054016651267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métrica (copia 2)_725361054016135170]&#13;&#10;    WHEN &quot;clicks&quot; THEN SUM([clicks])&#13;&#10;    WHEN &quot;ctr&quot; THEN SUM([clicks]) / SUM([impressions])&#13;&#10;    WHEN &quot;conversion&quot; THEN SUM([conversion])&#13;&#10;    WHEN &quot;cvr&quot; THEN SUM([conversion]) / SUM([clicks])&#13;&#10;END' />
      </column>
      <column caption='Métrica dinámica economics' datatype='real' name='[Métrica dinámica interacción (copia)_4905264458521030659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Métricas interacción (copia)_4905264458520391682]&#13;&#10;    WHEN &quot;sales_revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;gasto_lc&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ppto-gasto_lc&quot; THEN ([Presupuesto - gasto (lc) (copia)_4905264458516312065])&#13;&#10;END' />
