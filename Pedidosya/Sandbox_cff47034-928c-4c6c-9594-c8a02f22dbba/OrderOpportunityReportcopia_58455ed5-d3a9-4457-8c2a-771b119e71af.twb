    <worksheet name='TILE FR Week'>
      <repository-location id='TILEFRWeek' path='/t/Pedidosya/workbooks/OrderOpportunityReportcopia' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Order Opportunity Hurrier (Daily)' name='federated.0ez3ytj1h1ko181eiiv270xvyduh' />
          </datasources>
          <datasource-dependencies datasource='federated.0ez3ytj1h1ko181eiiv270xvyduh'>
            <column caption='Latest Week' datatype='date' name='[Calculation_1214283083024023563]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_2139772805048295424]))' />
            </column>
            <column caption='Orders This Week' datatype='integer' name='[Calculation_1214283083024207884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;, [session_date]) = [Calculation_1214283083024023563]&#13;&#10;THEN [orders_total]&#13;&#10;END' />
            </column>
            <column caption='Previous Week' datatype='date' name='[Calculation_1214283083024584717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;, -1, [Calculation_1214283083024023563]))' />
            </column>
            <column caption='Orders Previous Week to Date' datatype='integer' name='[Calculation_1214283083061567503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;, [session_date]) = DATETRUNC(&apos;week&apos;, [Calculation_1214283083024584717])&#13;&#10;and&#13;&#10;( &#13;&#10;  case DATEPART(&apos;weekday&apos;, [Calculation_2139772805048295424])&#13;&#10;    when 1 then&#13;&#10;      if DATEPART(&apos;weekday&apos;, [session_date]) &gt;= 1 then &quot;TRUE&quot; else &quot;FALSE&quot; END&#13;&#10;    ELSE&#13;&#10;      if DATEPART(&apos;weekday&apos;, [session_date]) &lt;= DATEPART(&apos;weekday&apos;, [Calculation_2139772805048295424])&#13;&#10;       and DATEPART(&apos;weekday&apos;, [session_date]) != 1 then &quot;TRUE&quot; else &quot;FALSE&quot; END&#13;&#10;  end&#13;&#10;) = &quot;TRUE&quot;&#13;&#10;then [orders_total]&#13;&#10;END' />
            </column>
            <column caption='Orders Week to Date WoW' datatype='real' name='[Calculation_1214283083061891088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_1214283083024207884])/sum([Calculation_1214283083061567503]))-1' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_2139772805048295424]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([session_date])}' />
            </column>
            <column caption='Orders Day' datatype='integer' name='[Calculation_2139772805048651777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805048295424]&#13;&#10;then  [orders_total] END' />
            </column>
            <column caption='Previous Day Week' datatype='date' name='[Calculation_2139772805049327618]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;, -1, [Calculation_2139772805048295424]))' />
            </column>
            <column caption='Orders Same Day Previous Week' datatype='integer' name='[Calculation_2139772805049643011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805049327618]&#13;&#10;then [orders_total]&#13;&#10;END' />
            </column>
            <column caption='Orders Day WoW' datatype='real' default-format='p0.0%' name='[Calculation_2139772805049909252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_2139772805048651777])/sum([Calculation_2139772805049643011]))-1' />
            </column>
            <column caption='Lost Orders Day' datatype='integer' name='[Calculation_2139772805057953797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805048295424]&#13;&#10;then  [lost_orders] END' />
            </column>
            <column caption='Lost Orders Same Day Previous Week' datatype='integer' name='[Calculation_2139772805060292616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805049327618]&#13;&#10;then [lost_orders]&#13;&#10;END' />
            </column>
            <column caption='Lost Orders WoW' datatype='real' name='[Calculation_2139772805060558857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_2139772805057953797])/sum([Calculation_2139772805060292616]))-1' />
            </column>
            <column caption='Non Confirmed Orders Same Day Previous Week' datatype='integer' name='[Calculation_2139772805068988432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805049327618]&#13;&#10;then [non_confirmed_orders]&#13;&#10;END' />
            </column>
            <column caption='FR Same Day Previous Week' datatype='real' name='[Calculation_2139772805069226001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2139772805068988432])/ SUM([Calculation_2139772805049643011])' />
            </column>
            <column caption='Opportunity Day' datatype='real' default-format='p0.00%' name='[Calculation_2139772805076324381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2139772805057953797])/SUM([Calculation_2139772805048651777])' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_225179988721897472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders])/SUM([orders_total])' />
            </column>
            <column caption='Date (copy)' datatype='date' name='[Date (copy)_1986087462129340417]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[session_date]' />
            </column>
            <column caption='Orders Total BA' datatype='integer' name='[Orders Total (copy)_737464505058238467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [session_city]=&apos;Buenos aires&apos; THEN&#13;&#10;&#13;&#10;[orders_total]&#13;&#10;&#13;&#10;END' />
            </column>
