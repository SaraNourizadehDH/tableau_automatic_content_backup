    <worksheet name='Evolution DAILY'>
      <repository-location id='EvolutionDAILY' path='/t/Pedidosya/workbooks/OrderOpportunityReportcopia' revision='' site='Pedidosya' />
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='12'>Opportunity Evolution -  DAILY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Order Opportunity Hurrier (Daily)' name='federated.0ez3ytj1h1ko181eiiv270xvyduh' />
          </datasources>
          <datasource-dependencies datasource='federated.0ez3ytj1h1ko181eiiv270xvyduh'>
            <column caption='Opportunity' datatype='real' default-format='p0.00%' name='[Calculation_1163617570649210883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lost_orders])/SUM([orders_total])' />
            </column>
            <column caption='Row Level Color Opportunity' datatype='real' name='[Calculation_1374442346137616393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1163617570649210883] = WINDOW_MIN([Calculation_1163617570649210883]) THEN 1 // minimum value = 1%&#13;&#10;ELSEIF [Calculation_1163617570649210883] = WINDOW_MEDIAN([Calculation_1163617570649210883]) THEN 50 // Middle value = 50%&#13;&#10;ELSEIF [Calculation_1163617570649210883] &lt; WINDOW_MEDIAN([Calculation_1163617570649210883]) THEN ([Calculation_1163617570649210883]/(WINDOW_MAX([Calculation_1163617570649210883]) + WINDOW_MEDIAN([Calculation_1163617570649210883])))*100 &#13;&#10;ELSE [Calculation_1163617570649210883] / WINDOW_MAX([Calculation_1163617570649210883]) * 100&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[lost_orders]' role='measure' type='quantitative' />
            <column-instance column='[session_city]' derivation='None' name='[none:session_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_country_code]' derivation='None' name='[none:session_country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_date]' derivation='None' name='[none:session_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[session_date]' derivation='None' name='[none:session_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[orders_total]' role='measure' type='quantitative' />
