            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0ez3ytj1h1ko181eiiv270xvyduh].[usr:Orders Month to Date MoM (copy)_1214283083135115325:qk]&quot;' />
