            </column>
            <column caption='AVG DT Same Day Previous Week' datatype='real' name='[Calculation_2139772805074776090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2139772805074563097])/SUM([Calculation_2139772805049643011])' />
            </column>
            <column caption='AVG DT WoW' datatype='real' name='[Calculation_2139772805074923547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([AVG DT Day (copy)_1214283081999818761])/([Calculation_2139772805074776090]))-1' />
