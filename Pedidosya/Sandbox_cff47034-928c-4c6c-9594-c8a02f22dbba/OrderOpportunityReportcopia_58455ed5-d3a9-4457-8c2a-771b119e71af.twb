      <column caption='Opportunity Previous Week to Date' datatype='real' name='[Calculation_1214283083078656022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1214283083071455249])/sum([Calculation_1214283083061567503])' />
