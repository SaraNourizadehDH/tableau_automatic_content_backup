    <worksheet name='TILE LO MoM MDT '>
      <repository-location id='TILELOMoMMDT' path='/t/Pedidosya/workbooks/OrderOpportunityReportcopia' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Order Opportunity Hurrier (Daily)' name='federated.0ez3ytj1h1ko181eiiv270xvyduh' />
          </datasources>
          <datasource-dependencies datasource='federated.0ez3ytj1h1ko181eiiv270xvyduh'>
            <column caption='Latest Month' datatype='date' name='[Calculation_1214283083122987046]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_2139772805048295424]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_1214283083123146791]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_1214283083122987046]))' />
            </column>
            <column caption='Lost Orders Actual Month' datatype='integer' name='[Calculation_1214283083126226985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATE(DATETRUNC(&apos;month&apos;, [session_date])) = [Calculation_1214283083122987046]&#13;&#10;then [lost_orders]&#13;&#10;END' />
            </column>
            <column caption='Previous Day Month' datatype='date' name='[Calculation_1214283083131273271]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_2139772805048295424]))' />
            </column>
            <column caption='Lost Orders Previous Month to Date' datatype='integer' name='[Calculation_1214283083131793466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;month&apos;, [session_date]) = DATETRUNC(&apos;month&apos;, [Calculation_1214283083123146791])&#13;&#10;AND&#13;&#10;[session_date]&lt;=[Calculation_1214283083131273271]&#13;&#10;THEN [lost_orders]&#13;&#10;END' />
            </column>
            <column caption='STR(&apos;MoM&apos;)' datatype='string' name='[Calculation_1214283083143647305]' role='dimension' type='nominal' user:unnamed='TILE Orders MoM MDT'>
              <calculation class='tableau' formula='STR(&apos;MoM&apos;)' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_2139772805048295424]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([session_date])}' />
            </column>
            <column caption='Orders Day' datatype='integer' name='[Calculation_2139772805048651777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805048295424]&#13;&#10;then  [orders_total] END' />
            </column>
            <column caption='Previous Day Week' datatype='date' name='[Calculation_2139772805049327618]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;, -1, [Calculation_2139772805048295424]))' />
            </column>
            <column caption='Orders Same Day Previous Week' datatype='integer' name='[Calculation_2139772805049643011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805049327618]&#13;&#10;then [orders_total]&#13;&#10;END' />
            </column>
            <column caption='Orders Day WoW' datatype='real' default-format='p0.0%' name='[Calculation_2139772805049909252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_2139772805048651777])/sum([Calculation_2139772805049643011]))-1' />
            </column>
            <column caption='Lost Orders Month to Date MoM' datatype='real' name='[Orders Month to Date MoM (copy)_1214283083135115325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_1214283083126226985])/sum([Calculation_1214283083131793466]))-1' />
            </column>
            <column datatype='integer' name='[lost_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1214283083143647305]' derivation='None' name='[none:Calculation_1214283083143647305:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_country_code]' derivation='None' name='[none:session_country_code:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders_total]' role='measure' type='quantitative' />
            <column caption='Country ' datatype='string' name='[session_country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[session_date]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_2139772805049909252]' derivation='User' name='[usr:Calculation_2139772805049909252:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Orders Month to Date MoM (copy)_1214283083135115325]' derivation='User' name='[usr:Orders Month to Date MoM (copy)_1214283083135115325:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
