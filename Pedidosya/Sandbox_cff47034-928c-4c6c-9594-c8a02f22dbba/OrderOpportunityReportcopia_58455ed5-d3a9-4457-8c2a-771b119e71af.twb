    <worksheet name='TILE OO Wow Week'>
      <repository-location id='TILEOOWowWeek' path='/t/Pedidosya/workbooks/OrderOpportunityReportcopia' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Order Opportunity Hurrier (Daily)' name='federated.0ez3ytj1h1ko181eiiv270xvyduh' />
          </datasources>
          <datasource-dependencies datasource='federated.0ez3ytj1h1ko181eiiv270xvyduh'>
            <column caption='Latest Week' datatype='date' name='[Calculation_1214283083024023563]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_2139772805048295424]))' />
            </column>
            <column caption='Orders This Week' datatype='integer' name='[Calculation_1214283083024207884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;, [session_date]) = [Calculation_1214283083024023563]&#13;&#10;THEN [orders_total]&#13;&#10;END' />
            </column>
            <column caption='Previous Week' datatype='date' name='[Calculation_1214283083024584717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;, -1, [Calculation_1214283083024023563]))' />
            </column>
            <column caption='Orders Previous Week to Date' datatype='integer' name='[Calculation_1214283083061567503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;, [session_date]) = DATETRUNC(&apos;week&apos;, [Calculation_1214283083024584717])&#13;&#10;and&#13;&#10;( &#13;&#10;  case DATEPART(&apos;weekday&apos;, [Calculation_2139772805048295424])&#13;&#10;    when 1 then&#13;&#10;      if DATEPART(&apos;weekday&apos;, [session_date]) &gt;= 1 then &quot;TRUE&quot; else &quot;FALSE&quot; END&#13;&#10;    ELSE&#13;&#10;      if DATEPART(&apos;weekday&apos;, [session_date]) &lt;= DATEPART(&apos;weekday&apos;, [Calculation_2139772805048295424])&#13;&#10;       and DATEPART(&apos;weekday&apos;, [session_date]) != 1 then &quot;TRUE&quot; else &quot;FALSE&quot; END&#13;&#10;  end&#13;&#10;) = &quot;TRUE&quot;&#13;&#10;then [orders_total]&#13;&#10;END' />
            </column>
            <column caption='Lost Orders Previous Week to Date' datatype='integer' name='[Calculation_1214283083071455249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;, [session_date]) = DATETRUNC(&apos;week&apos;, [Calculation_1214283083024584717])&#13;&#10;and&#13;&#10;( &#13;&#10;  case DATEPART(&apos;weekday&apos;, [Calculation_2139772805048295424])&#13;&#10;    when 1 then&#13;&#10;      if DATEPART(&apos;weekday&apos;, [session_date]) &gt;= 1 then &quot;TRUE&quot; else &quot;FALSE&quot; END&#13;&#10;    ELSE&#13;&#10;      if DATEPART(&apos;weekday&apos;, [session_date]) &lt;= DATEPART(&apos;weekday&apos;, [Calculation_2139772805048295424])&#13;&#10;       and DATEPART(&apos;weekday&apos;, [session_date]) != 1 then &quot;TRUE&quot; else &quot;FALSE&quot; END&#13;&#10;  end&#13;&#10;) = &quot;TRUE&quot;&#13;&#10;then [lost_orders]&#13;&#10;END' />
            </column>
            <column caption='Lost Orders This Week' datatype='integer' name='[Calculation_1214283083071983634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;week&apos;, [session_date]) = [Calculation_1214283083024023563]&#13;&#10;THEN [lost_orders]&#13;&#10;END' />
            </column>
            <column caption='Opportunity This Week' datatype='real' name='[Calculation_1214283083078180885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1214283083071983634])/sum([Calculation_1214283083024207884])' />
            </column>
            <column caption='Opportunity Previous Week to Date' datatype='real' name='[Calculation_1214283083078656022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1214283083071455249])/sum([Calculation_1214283083061567503])' />
            </column>
            <column caption='Opportunity Week to Date WoW' datatype='real' name='[Calculation_1214283083081592856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1214283083078180885]*100)-([Calculation_1214283083078656022]*100)' />
            </column>
            <column caption='STR(&apos;WoW p.p.&apos;)' datatype='string' name='[Calculation_1374442345794088962]' role='dimension' type='nominal' user:unnamed='TILE OO Wow Week'>
              <calculation class='tableau' formula='STR(&apos;WoW p.p.&apos;)' />
              <aliases>
                <alias key='&quot;WoW p.p.&quot;' value='WoW ' />
              </aliases>
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_2139772805048295424]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([session_date])}' />
            </column>
            <column caption='Orders Day' datatype='integer' name='[Calculation_2139772805048651777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805048295424]&#13;&#10;then  [orders_total] END' />
            </column>
            <column caption='Previous Day Week' datatype='date' name='[Calculation_2139772805049327618]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;, -1, [Calculation_2139772805048295424]))' />
            </column>
            <column caption='Orders Same Day Previous Week' datatype='integer' name='[Calculation_2139772805049643011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;[session_date] = [Calculation_2139772805049327618]&#13;&#10;then [orders_total]&#13;&#10;END' />
            </column>
            <column caption='Orders Day WoW' datatype='real' default-format='p0.0%' name='[Calculation_2139772805049909252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_2139772805048651777])/sum([Calculation_2139772805049643011]))-1' />
            </column>
            <column caption='Date (copy)' datatype='date' name='[Date (copy)_1986087462129340417]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[session_date]' />
            </column>
            <column datatype='integer' name='[lost_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1374442345794088962]' derivation='None' name='[none:Calculation_1374442345794088962:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_country_code]' derivation='None' name='[none:session_country_code:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders_total]' role='measure' type='quantitative' />
            <column caption='Country ' datatype='string' name='[session_country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[session_date]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_1214283083081592856]' derivation='User' name='[usr:Calculation_1214283083081592856:qk]' pivot='key' type='quantitative' />
