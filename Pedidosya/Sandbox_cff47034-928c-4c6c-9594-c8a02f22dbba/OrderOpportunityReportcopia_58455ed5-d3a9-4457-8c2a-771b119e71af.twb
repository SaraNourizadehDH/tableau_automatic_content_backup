        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ikba7r0d7q2mc1gd5d9s12js9to' name='Custom SQL Query' type='text'>select &#13;
created_date as session_date,&#13;
country_code as session_country_code,&#13;
warehouse_name as session_city,&#13;
sum(total_orders) as orders_total,&#13;
sum(cancelled_orders) -200 as lost_orders,&#13;
sum(cancelled_orders) as non_confirmed_orders,&#13;
avg(actual_dt) as actual_delivery_time,&#13;
sum(total_orders-cancelled_orders)  as completed_orders,&#13;
sum(total_orders) + 200 as total_orders&#13;
from `peya-delivery-and-support.automated_tables_reports.dmarts_daily_ops`&#13;
&#13;
group by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ikba7r0d7q2mc1gd5d9s12js9to' name='Custom SQL Query' type='text'>select &#13;
