            <column caption='Auto Activación' datatype='string' name='[Calculation_1550364204937277441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [last_modified_by_name] = &apos;API Vendor Onboarding&apos; then &apos;Auto Activación&apos;&#13;&#10;else &apos;Agente&apos;&#13;&#10;end' />
            </column>
            <column caption='Closed Date' datatype='date' datatype-customized='true' name='[Closed Date (copy)_1260726454263373827]' role='dimension' type='ordinal'>
