      <aliases enabled='yes' />
      <column caption='Assigned Date' datatype='date' datatype-customized='true' name='[Assigned At (copy)_1260726454263169026]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([assigned_date])' />
      </column>
      <column aggregation='Avg' caption='SLA' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1260726454191030272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Datediff(&apos;minute&apos;, [create_date], [closed_date])/60/24' />
      </column>
      <column caption='number of cases' datatype='integer' name='[Calculation_1260726454219534337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [case_status]&#13;&#10;when &apos;Closed&apos; then 1&#13;&#10;else 0&#13;&#10;end' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_1260726454264627207]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &apos;created&apos; then&#13;&#10;    [Create Date (copy)_1260726454263373828] &gt;= DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;when &apos;closed&apos; then&#13;&#10;    [Closed Date (copy)_1260726454263373827] &gt;= DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;else false&#13;&#10;END' />
      </column>
      <column caption='Max Month' datatype='string' name='[Calculation_1260726454308360203]' role='measure' type='nominal'>
        <calculation class='tableau' formula='datename(&apos;month&apos;, MAX(&#13;&#10;case [Parameters].[Parameter 1]&#13;&#10;when &apos;created&apos; then [Create Date (copy)_1260726454263373828]&#13;&#10;when &apos;closed&apos; then [Closed Date (copy)_1260726454263373827]&#13;&#10;end&#13;&#10;))' />
      </column>
      <column caption='Nombre Activo' datatype='string' name='[Calculation_1404560172661190656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [asset_name]&#13;&#10;when &apos;Admin&apos; then &apos;GoWin&apos;&#13;&#10;when &apos;POS&apos; then &apos;GoDroid&apos;&#13;&#10;when &apos;POS Incluido&apos; then &apos;GoDroid&apos;&#13;&#10;else if ISNULL([asset_name]) then &apos;No Info&apos; else [asset_name] end&#13;&#10;end' />
      </column>
      <column caption='Cant Casos' datatype='integer' name='[Calculation_1550364204936695808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([case_number])' />
      </column>
      <column caption='Auto Activación' datatype='string' name='[Calculation_1550364204937277441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [last_modified_by_name] = &apos;API Vendor Onboarding&apos; then &apos;Auto Activación&apos;&#13;&#10;else &apos;Agente&apos;&#13;&#10;end' />
      </column>
      <column caption='Closed Date' datatype='date' datatype-customized='true' name='[Closed Date (copy)_1260726454263373827]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([closed_date])' />
      </column>
      <column caption='Create Date' datatype='date' datatype-customized='true' name='[Create Date (copy)_1260726454263373828]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([create_date])' />
      </column>
      <column caption='Last Modified Date' datatype='date' datatype-customized='true' name='[Last Modified Date (copy)_1260726454263373829]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([last_modified_date])' />
      </column>
      <column caption='LMTD' datatype='boolean' name='[MTD (copy)_1260726454264999944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &apos;created&apos; then&#13;&#10;    [Create Date (copy)_1260726454263373828] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) and&#13;&#10;    [Create Date (copy)_1260726454263373828] &lt;= DATEADD(&apos;month&apos;, -1, TODAY())&#13;&#10;when &apos;closed&apos; then&#13;&#10;    [Closed Date (copy)_1260726454263373827] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) and&#13;&#10;    [Closed Date (copy)_1260726454263373827] &lt;= DATEADD(&apos;month&apos;, -1, TODAY())&#13;&#10;else false&#13;&#10;END' />
      </column>
      <column caption='Mes Actual' datatype='string' name='[MTD (copy)_1260726454306353162]' role='measure' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &apos;created&apos; then&#13;&#10;    datename(&apos;month&apos;, MAX([Create Date (copy)_1260726454263373828]))&#13;&#10;when &apos;closed&apos; then&#13;&#10;    datename(&apos;month&apos;, MAX([Closed Date (copy)_1260726454263373827]))&#13;&#10;else null&#13;&#10;END' />
      </column>
      <column caption='Max date' datatype='datetime' name='[Max Month (copy)_1599622338941526017]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(&#13;&#10;case [Parameters].[Parameter 1]&#13;&#10;when &apos;created&apos; then [create_date]&#13;&#10;when &apos;closed&apos; then [closed_date]&#13;&#10;end&#13;&#10;)' />
      </column>
