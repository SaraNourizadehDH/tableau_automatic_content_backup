          <datasource-dependencies datasource='federated.0m64dwn0wo2col1fnnlbb1g3vy1w'>
            <column caption='INCENTIVES MANAGEMENT &amp; 3P FUNDING' datatype='string' name='[BUSINESS FUNDAMENTALS (copia)_1272548374644097030]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;INCENTIVES MANAGEMENT &amp; 3P FUNDING&quot;' />
            </column>
            <column caption='([VS Target VFD/GMV]) * 100' datatype='real' name='[Calculation_484981406898073600]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target VFD GMV_1288592461121000195]) * 100' />
            </column>
            <column caption='([VS Target Push Promotional Conversion Rate]) * 100' datatype='real' name='[Calculation_484981406898380801]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target Push Promotional Conversion Rate_1288592461121000355]) * 100' />
            </column>
            <column caption='([VS Target ROI de la Inversión de PeYA]) * 100' datatype='real' name='[Calculation_484981406899146754]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target ROI Inversion PeYA_1288592461121000367]) * 100' />
            </column>
            <column caption='([VS Target Inversion en HVA]) * 100' datatype='real' name='[Calculation_484981406899302403]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target Inversion en HVA_1288592461121000296]) * 100' />
            </column>
            <column caption='([VS Target Investment in Toxic Users]) * 100' datatype='real' name='[Calculation_484981406899363844]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target Investment in Toxic Users_1288592461121000297]) * 100' />
            </column>
            <column caption='([VS Target Growth Deals 2.0]) * 100' datatype='real' name='[Calculation_484981406899417093]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target Growth Deals 2.0_1288592461121000291]) * 100' />
            </column>
            <column caption='([VS Target Subsidios en Growth Deals]) * 100' datatype='real' name='[Calculation_484981406899470342]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target Subsidios Growth Deals_1288592461121000378]) * 100' />
            </column>
            <column caption='([VS Target Test and Enable Segmented Pricing for Elastic Use...' datatype='real' name='[Calculation_484981406899531783]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target Test Enable Segmented Pricing Elastic Users_1288592461121000381]) * 100' />
            </column>
            <column caption='([VS Target Pricing DF Affordable Orders (%)]) * 100' datatype='real' name='[Calculation_484981406899597320]' role='measure' type='quantitative' user:unnamed='AFFORD - Incentives Man VS TARGET'>
              <calculation class='tableau' formula='([VS Target Pricing DF Affordable Orders Pct_1288592461121000350]) * 100' />
            </column>
            <column caption='VS Target Growth Deals 2.0' datatype='real' name='[VS Target Growth Deals 2.0_1288592461121000291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([growth_deals_2_0]) - SUM([target_growth_deals_2_0])) / SUM([target_growth_deals_2_0])' />
            </column>
            <column caption='VS Target Inversion en HVA' datatype='real' name='[VS Target Inversion en HVA_1288592461121000296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([inversion_en_hva]) - SUM([target_inversion_en_hva])) / SUM([target_inversion_en_hva])' />
            </column>
            <column caption='VS Target Investment in Toxic Users' datatype='real' name='[VS Target Investment in Toxic Users_1288592461121000297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([investment_in_toxic_users]) - SUM([target_investment_in_toxic_users])) / SUM([target_investment_in_toxic_users])' />
