            <column caption='(ZN(SUM([user_potential_ltv_framework])) - LOOKUP(ZN(SUM([use...' datatype='real' name='[Calculation_1002895354152136726]' role='measure' type='quantitative' user:unnamed='BEST APP - Overall MoM'>
