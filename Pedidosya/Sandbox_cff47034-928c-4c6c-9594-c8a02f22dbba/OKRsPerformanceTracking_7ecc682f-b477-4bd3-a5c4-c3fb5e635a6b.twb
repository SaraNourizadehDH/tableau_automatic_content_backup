              <calculation class='tableau' formula='([VS Target VFD GMV_1288592461121000195]) * 100' />
            </column>
            <column caption='([VS Target PeYa Plus Orders (%)]) * 100' datatype='real' name='[Calculation_484981406904487955]' role='measure' type='quantitative' user:unnamed='AFFORD - Overall Chap VS TARGET'>
