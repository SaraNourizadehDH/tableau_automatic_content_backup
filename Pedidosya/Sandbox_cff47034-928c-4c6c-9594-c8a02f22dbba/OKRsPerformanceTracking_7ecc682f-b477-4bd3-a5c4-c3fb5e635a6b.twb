            <column caption='VS Target Affordability Score' datatype='real' name='[VS Target Affordability Score_1288592461121000223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([affordability_score]) - SUM([target_affordability_score])) / SUM([target_affordability_score])' />
