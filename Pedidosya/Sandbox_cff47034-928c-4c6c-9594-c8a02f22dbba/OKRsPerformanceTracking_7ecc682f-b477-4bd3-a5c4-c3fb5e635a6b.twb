            <column caption='(ZN(SUM([Retention M1])) - LOOKUP(ZN(SUM([Retention M1])), -1...' datatype='real' name='[Calculation_1797780686193917953]' role='measure' type='quantitative' user:unnamed='FUNDAM - Business F - MoM -12'>
