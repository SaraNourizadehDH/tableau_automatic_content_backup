      <column caption='VS Target Commission Rate Food GFV pct' datatype='real' default-format='p0.00%' name='[Calculation_1288592460353048577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_rate_food_gfv_pct]) - SUM([target_commission_rate_food_gfv_pct])' />
      </column>
      <column caption='vs target GMV OVERALL' datatype='real' name='[Calculation_1292814585464479744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gmv_overall]) - SUM([target_gmv_overall])) / SUM([target_gmv_overall])' />
      </column>
      <column caption='vs target GMV QC' datatype='real' name='[Calculation_1292814585464627201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gmv_gross_qc]) - SUM([target_gmv_qc])) / SUM([target_gmv_qc])' />
      </column>
      <column caption='vs target ORDERS' datatype='real' name='[Calculation_1292814585464721410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders]) - SUM([target_orders])) / SUM([target_orders])' />
      </column>
      <column caption='vs target ORDERS FOOD' datatype='real' name='[Calculation_1292814585464778755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_food]) - SUM([target_orders_food])) / SUM([target_orders_food])' />
      </column>
      <column caption='vs target ORDERS QC' datatype='real' name='[Calculation_1292814585464885252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_qc]) - SUM([target_orders_qc])) / SUM([target_orders_qc])' />
      </column>
      <column caption='vs target ORDERS COURIER' datatype='real' name='[Calculation_1292814585465004037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_courier]) - SUM([target_orders_courier])) / SUM([target_orders_courier])' />
      </column>
      <column caption='vs target DAILY GMV' datatype='real' name='[Calculation_1292814585465077766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([daily_gmv]) - SUM([target_daily_gmv])) / SUM([target_daily_gmv])' />
      </column>
      <column caption='vs target DAILY ORDERS' datatype='real' name='[Calculation_1292814585465151495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([daily_orders]) - SUM([target_daily_orders])) / SUM([target_daily_orders])' />
