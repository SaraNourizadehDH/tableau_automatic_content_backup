            </column>
            <column caption='[VS Target Collected GMV (%)]* 100' datatype='real' name='[Calculation_484981406904647701]' role='measure' type='quantitative' user:unnamed='AFFORD - Overall Chap VS TARGET'>
              <calculation class='tableau' formula='[VS Target Collected GMV Pct_1288592461121000237]* 100' />
