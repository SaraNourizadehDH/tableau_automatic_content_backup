    <worksheet name='SEAMLESS Target % - Overall'>
      <table>
        <view>
          <datasources>
            <datasource caption='data_okrs' name='federated.0m64dwn0wo2col1fnnlbb1g3vy1w' />
          </datasources>
          <datasource-dependencies datasource='federated.0m64dwn0wo2col1fnnlbb1g3vy1w'>
            <column caption='([VS Target Seamless Orders (Delivery)])*100' datatype='real' name='[Calculation_1610318364009611264]' role='measure' type='quantitative' user:unnamed='SEAMLESS Target % - Overall'>
              <calculation class='tableau' formula='([VS Target Seamless Orders Percent_1288592461121000369])*100' />
            </column>
            <column caption='([VS Target CSAT AC (After Contact)])*100' datatype='real' name='[Calculation_1610318364009648129]' role='measure' type='quantitative' user:unnamed='SEAMLESS Target % - Overall'>
              <calculation class='tableau' formula='([VS Target CSAT AC_1288592461121000245])*100' />
            </column>
            <column caption='([VS Target Resolution Rate (NPS)])*100' datatype='real' name='[Calculation_1610318364009680898]' role='measure' type='quantitative' user:unnamed='SEAMLESS Target % - Overall'>
              <calculation class='tableau' formula='([VS Target Resolution Rate NPS Pct_1288592461121000358])*100' />
            </column>
            <column caption='([VS Target Fail Rate %])*100' datatype='real' name='[Calculation_1610318364009754628]' role='measure' type='quantitative' user:unnamed='SEAMLESS Target % - Overall'>
              <calculation class='tableau' formula='([VS Target Fail Rate Pct_1288592461121000262])*100' />
            </column>
            <column caption='([VS Target SOAP (Share of Orders w/ App Payments)])*100' datatype='real' name='[Calculation_1610318364009783301]' role='measure' type='quantitative' user:unnamed='SEAMLESS Target % - Overall'>
              <calculation class='tableau' formula='([VS Target SOAP_1288592461121000374])*100' />
            </column>
            <column caption='([VS Target Checkout Acceptance Rate (ACCr)])*100' datatype='real' name='[Calculation_1610318364009816070]' role='measure' type='quantitative' user:unnamed='SEAMLESS Target % - Overall'>
              <calculation class='tableau' formula='([VS Target Checkout Acceptance Rate_1288592461121000235])*100' />
            </column>
            <column caption='VS Target CSAT AC (After Contact)' datatype='real' name='[VS Target CSAT AC_1288592461121000245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([csat_ac]) - SUM([target_csat_ac])) / SUM([target_csat_ac])' />
            </column>
            <column caption='VS Target Checkout Acceptance Rate (ACCr)' datatype='real' default-format='p0.00%' name='[VS Target Checkout Acceptance Rate_1288592461121000235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_acceptance_rate]) - SUM([target_checkout_acceptance_rate])' />
            </column>
            <column caption='VS Target Fail Rate %' datatype='real' default-format='p0.00%' name='[VS Target Fail Rate Pct_1288592461121000262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_rate_pct]) - SUM([target_fail_rate_pct])' />
            </column>
            <column caption='VS Target NPS Delivery' datatype='real' name='[VS Target NPS Delivery_1288592461121000318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_delivery]) - SUM([target_nps_delivery])) / SUM([target_nps_delivery])' />
            </column>
            <column caption='VS Target NPS Online Help' datatype='real' name='[VS Target NPS Online Help_1288592461121000321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_online_help]) - SUM([target_nps_online_help])) / SUM([target_nps_online_help])' />
            </column>
            <column caption='VS Target Quality and Accuracy' datatype='real' name='[VS Target NPS Quality Accuracy_1288592461121000323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_quality_accuracy]) - SUM([target_nps_quality_accuracy])) / SUM([target_nps_quality_accuracy])' />
            </column>
            <column caption='VS Target Resolution Rate (NPS)' datatype='real' default-format='p0.00%' name='[VS Target Resolution Rate NPS Pct_1288592461121000358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([resolution_rate_nps_pct]) - SUM([target_resolution_rate_nps_pct])' />
            </column>
            <column caption='VS Target SOAP (Share of Orders w/ App Payments)' datatype='real' default-format='p0.00%' name='[VS Target SOAP_1288592461121000374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([soap]) - SUM([target_soap])' />
            </column>
            <column caption='VS Target Seamless Orders (Delivery)' datatype='real' name='[VS Target Seamless Orders Percent_1288592461121000369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([seamless_orders_percent]) - SUM([target_seamless_orders_percent]))' />
