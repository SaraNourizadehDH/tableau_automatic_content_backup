            <column caption='VS Target AQS' datatype='real' name='[VS Target AQS_1288592461121000227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([aqs_dmart]) - SUM([target_aqs_dmart])) / SUM([target_aqs_dmart])' />
