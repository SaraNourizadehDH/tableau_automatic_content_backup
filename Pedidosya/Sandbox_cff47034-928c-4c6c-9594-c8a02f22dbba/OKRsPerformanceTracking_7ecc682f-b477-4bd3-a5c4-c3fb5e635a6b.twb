              <calculation class='tableau' formula='(ZN(SUM(gmv_gross_qc)) - LOOKUP(ZN(SUM(gmv_gross_qc)), -1)) / ABS(LOOKUP(ZN(SUM(gmv_gross_qc)), -1))'>
