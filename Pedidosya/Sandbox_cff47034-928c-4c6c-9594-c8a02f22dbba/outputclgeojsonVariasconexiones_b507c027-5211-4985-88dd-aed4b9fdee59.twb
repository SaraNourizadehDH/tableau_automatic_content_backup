  <aliases enabled='yes' />
  <column caption='COLOR' datatype='real' name='[Calculation_180144006080970753]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Parameters].[Parámetro 1]=1 then SUM([count])&#13;&#10;elseif [Parameters].[Parámetro 1]=2 then AVG([n_users])&#13;&#10; // SUM([N Users]) / COUNTD([Vertical Type])&#13;&#10;else SUM([count])/AVG([n_users])&#13;&#10;END' />
  </column>
  <column caption='choice' datatype='real' name='[Calculation_180144006095138819]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(SUM(IF [fecha] = #2022-10-15# THEN [count] END) - SUM(IF [fecha] = #2023-10-01# THEN [count] END)) / ABS(SUM(IF [fecha] = #2023-10-15# THEN [count] END))' />
  </column>
