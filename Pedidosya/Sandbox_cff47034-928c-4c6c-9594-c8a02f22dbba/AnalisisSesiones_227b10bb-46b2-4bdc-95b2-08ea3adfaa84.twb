avg(totals.time_on_site) session_time,&#13;
safe_divide(avg(totals.time_on_site) ,avg(avg(totals.time_on_site) )  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_session_time,&#13;
count( distinct case when transaction_bool then session_id end) sessions_transaction,&#13;
