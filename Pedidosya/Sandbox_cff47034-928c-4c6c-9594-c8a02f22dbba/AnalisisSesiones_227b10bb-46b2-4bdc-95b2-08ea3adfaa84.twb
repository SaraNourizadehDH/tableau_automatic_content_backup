),&#13;
country as (&#13;
with orders as (&#13;
-- ssss&#13;
select&#13;
o.country_id country_id ,&#13;
registered_date,&#13;
&#13;
extract(dayofweek from registered_date) dayweek,&#13;
count( distinct case when upper(application)=&apos;ANDROID&apos; then o.order_id end) orders_conf_android,&#13;
safe_divide(count( distinct case when upper(application)=&apos;ANDROID&apos; then o.order_id end),avg(count( distinct case when upper(application)=&apos;ANDROID&apos; then o.order_id end))  OVER (partition by extract(dayofweek from registered_date) ORDER BY o.country_id,registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_conf_android,&#13;
count( distinct case when upper(application)=&apos;IPHONE&apos; then o.order_id end) orders_conf_ios,&#13;
safe_divide(count( distinct case when upper(application)=&apos;IPHONE&apos; then o.order_id end),avg(count( distinct case when upper(application)=&apos;IPHONE&apos; then o.order_id end))  OVER (partition by extract(dayofweek from registered_date) ORDER BY o.country_id,registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_conf_ios,&#13;
count( distinct o.order_id ) orders_total,&#13;
safe_divide(count( distinct o.order_id ),avg(count( distinct o.order_id ))  OVER (partition by extract(dayofweek from registered_date) ORDER BY o.country_id,registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_total,&#13;
count(distinct customer_id) customers,&#13;
safe_divide(count(distinct customer_id),avg(count(distinct customer_id))  OVER (partition by extract(dayofweek from registered_date) ORDER BY o.country_id,registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_customers,&#13;
  COALESCE(SUM(o.is_acquisition ), 0) AS orders_new_customers_with_confirmed_orders,&#13;
  COALESCE(SUM(o.is_acquisition ), 0)/count(distinct(customer_id)) as share_adquisition_customer,&#13;
  count(distinct(o.order_id)) as qty_orders,&#13;
  count(distinct(aff.order_id)) as qty_aff_orders,&#13;
  count(distinct (case when o.is_acquisition=1 then aff.order_id end)) as qty_aff_adq,&#13;
  sum(case when o.is_acquisition=1 then aff.discount_amount end) discount_amount_adq,&#13;
  sum(aff.discount_amount) discount_amount,&#13;
sum(gmv_confirmed_with_discount_paid_by_company) gmv_gross_total,&#13;
sum(case when aff.order_id is not null then gmv_confirmed_with_discount_paid_by_company else 0 end) as gmv_aff_orders,&#13;
sum(case when  o.is_acquisition=1  then gmv_confirmed_with_discount_paid_by_company else 0 end) as gmv_adq_orders&#13;
&#13;
from `peya-bi-tools-pro.il_core.fact_orders` o&#13;
left join (select order_id, sum(discount_amount) discount_amount from `peya-markets.automated_tables_reports.affordable_orders` where discount_type!=&quot;SUBSIDIZED&quot; group by 1) aff on o.order_id=aff.order_id&#13;
            join `peya-data-origins-pro.cl_core.country` c on o.country_id = c.country_id&#13;
            join `peya-bi-tools-pro.il_core.dim_currency_exchange`  ce on ce.currency_id = c.currency_id&#13;
            and  cast (FORMAT_DATE(&quot;%Y%m01&quot;, date(o.registered_date)) as int64)=ce.date_id  &#13;
&#13;
where registered_date&gt;&gt;&apos;2022-01-01&apos;&#13;
&#13;
group by 1,2,3&#13;
), &#13;
sessions as (&#13;
select&#13;
country_id,&#13;
partition_date ,&#13;
&#13;
count(distinct session_id) sessions,&#13;
safe_divide(count( distinct session_id ),avg(count( distinct session_id ))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_session,&#13;
safe_divide(count(distinct case when visit_number=1 then  session_id end),avg(count( distinct session_id ))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_share_new,&#13;
safe_divide(count(distinct case when visit_number!=1 then  session_id end),avg(count( distinct session_id ))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_share_old,&#13;
&#13;
&#13;
&#13;
&#13;
count(distinct case when upper(platform_peya)=&apos;IOS&apos; then  session_id end) sessions_ios,&#13;
safe_divide(count(distinct case when upper(platform_peya)=&apos;IOS&apos; then  session_id end),avg(count(distinct case when upper(platform_peya)=&apos;IOS&apos; then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_ios,&#13;
count(distinct case when upper(platform_peya)=&apos;ANDROID&apos; then  session_id end) sessions_android,&#13;
safe_divide(count(distinct case when upper(platform_peya)=&apos;ANDROID&apos; then  session_id end),avg(count(distinct case when upper(platform_peya)=&apos;ANDROID&apos; then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_android,&#13;
count(distinct case when visit_number!=1 then  session_id end) sessions_old,&#13;
safe_divide(count(distinct case when visit_number!=1 then  session_id end),avg(count(distinct case when visit_number!=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_old,&#13;
count(distinct case when visit_number=1 then  session_id end) sessions_new,&#13;
count(distinct case when visit_number=1 then  session_id end)/count(distinct case when visit_number!=1 then  session_id end) newoverold,&#13;
count(distinct case when visit_number=1 then  session_id end)/count(distinct session_id ) newovertotal,&#13;
&#13;
safe_divide(count(distinct case when visit_number=1 then  session_id end),avg(count(distinct case when visit_number=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_new,&#13;
count(distinct case when visit_number=1 then  session_id end)-avg(count(distinct case when visit_number=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ) as dif_new,&#13;
count(distinct case when visit_number!=1 then  session_id end)-avg(count(distinct case when visit_number!=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ) as dif_old,&#13;
&#13;
count(distinct   session_id )-avg(count(distinct   session_id))  OVER (partition by extract(dayofweek from partition_date)ORDER BY country_id, partition_date asc rows  between 8  preceding and 1  preceding ) as dif_sess,&#13;
avg(totals.hits) hits,&#13;
