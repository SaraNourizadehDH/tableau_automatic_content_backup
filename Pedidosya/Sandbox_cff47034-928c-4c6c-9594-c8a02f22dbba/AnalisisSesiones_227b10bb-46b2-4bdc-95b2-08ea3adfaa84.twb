      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0E5C9D9E2ECA494694B7B8997B983473'>
            <properties context=''>
              <relation connection='bigquery.0sdvc7i0ub31611dpptyd17t6q6o' name='Custom SQL Query' type='text'>SELECT partition_date,dc.country_name as country,platform_peya,app_browser,count(distinct (user_id)) as qty_session&#13;
FROM `peya-bi-tools-pro.il_sessions.fact_ga_sessions` o&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc &#13;
ON dc.country_id = o.country_id AND dc.active &#13;
WHERE partition_date &gt;&gt; &quot;2022-06-01&quot; &#13;
&#13;
group by 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Analisis por Pais' inline='true' name='federated.0k78iyd1mcq3bd18i0fvh0trqthz' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.13sl21h0t0j7pt168id1b1r2i5uz'>
            <connection CATALOG='peya-markets' EXECCATALOG='peya-markets' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-markets' schema='automated_tables_reports' server-oauth='' username='julian.zubieta@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13sl21h0t0j7pt168id1b1r2i5uz' name='Custom SQL Query' type='text'>with latam as (with orders as (&#13;
-- ssss&#13;
select&#13;
--country_id country_id ,&#13;
registered_date,&#13;
&#13;
extract(dayofweek from registered_date) dayweek,&#13;
count( distinct case when upper(application)=&apos;ANDROID&apos; then o.order_id end) orders_conf_android,&#13;
safe_divide(count( distinct case when upper(application)=&apos;ANDROID&apos; then o.order_id end),avg(count( distinct case when upper(application)=&apos;ANDROID&apos; then o.order_id end))  OVER (partition by extract(dayofweek from registered_date) order by registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_conf_android,&#13;
count( distinct case when upper(application)=&apos;IPHONE&apos; then o.order_id end) orders_conf_ios,&#13;
safe_divide(count( distinct case when upper(application)=&apos;IPHONE&apos; then o.order_id end),avg(count( distinct case when upper(application)=&apos;IPHONE&apos; then o.order_id end))  OVER (partition by extract(dayofweek from registered_date) order by registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_conf_ios,&#13;
count( distinct o.order_id ) orders_total,&#13;
safe_divide(count( distinct o.order_id ),avg(count( distinct o.order_id ))  OVER (partition by extract(dayofweek from registered_date) order by registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_total,&#13;
count(distinct customer_id) customers,&#13;
safe_divide(count(distinct customer_id),avg(count(distinct customer_id))  OVER (partition by extract(dayofweek from registered_date) order by registered_date asc rows  between 8  preceding and 1  preceding ))-1 delta_orders_customers,&#13;
COALESCE(SUM(o.is_acquisition ), 0) AS orders_new_customers_with_confirmed_orders,&#13;
count(distinct(aff.order_id)) as qty_aff_orders,&#13;
  count(distinct (case when o.is_acquisition=1 then aff.order_id end)) as qty_aff_adq,&#13;
  COALESCE(SUM(o.is_acquisition ), 0)/count(distinct(customer_id)) as share_adquisition_customer,&#13;
    sum(case when o.is_acquisition=1 then aff.discount_amount end) discount_amount_adq,&#13;
  sum(aff.discount_amount) discount_amount,&#13;
  sum(gmv_confirmed_with_discount_paid_by_company) gmv_gross_total,&#13;
sum(case when aff.order_id is not null then gmv_confirmed_with_discount_paid_by_company else 0 end) as gmv_aff_orders,&#13;
sum(case when  o.is_acquisition=1  then gmv_confirmed_with_discount_paid_by_company else 0 end) as gmv_adq_orders&#13;
&#13;
from `peya-bi-tools-pro.il_core.fact_orders` o&#13;
left join (select order_id, sum(discount_amount) discount_amount from `peya-markets.automated_tables_reports.affordable_orders` where discount_type!=&quot;SUBSIDIZED&quot; group by 1) aff on o.order_id=aff.order_id&#13;
            join `peya-data-origins-pro.cl_core.country` c on o.country_id = c.country_id&#13;
            INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc on dc.country_id=c.country_id AND dc.active&#13;
            join `peya-bi-tools-pro.il_core.dim_currency_exchange`  ce on ce.currency_id = c.currency_id&#13;
            and  cast (FORMAT_DATE(&quot;%Y%m01&quot;, date(o.registered_date)) as int64)=ce.date_id  &#13;
&#13;
where registered_date&gt;&gt;&apos;2022-01-01&apos;&#13;
&#13;
group by 1,2--,3&#13;
), &#13;
sessions as (&#13;
select&#13;
--country_id,&#13;
partition_date ,&#13;
&#13;
count(distinct session_id) sessions,&#13;
safe_divide(count(distinct case when visit_number=1 then  session_id end),avg(count( distinct session_id ))  OVER (partition by extract(dayofweek from partition_date)ORDER BY  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_share_new,&#13;
safe_divide(count(distinct case when visit_number!=1 then  session_id end),avg(count( distinct session_id ))  OVER (partition by extract(dayofweek from partition_date)ORDER BY  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_share_old,&#13;
safe_divide(count( distinct session_id ),avg(count( distinct session_id ))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_session,&#13;
count(distinct case when upper(platform_peya)=&apos;IOS&apos; then  session_id end) sessions_ios,&#13;
count(distinct case when visit_number=1 then  session_id end)/count(distinct case when visit_number!=1 then  session_id end) newoverold,&#13;
count(distinct case when visit_number=1 then  session_id end)/count(distinct session_id ) newovertotal,&#13;
safe_divide(count(distinct case when upper(platform_peya)=&apos;IOS&apos; then  session_id end),avg(count(distinct case when upper(platform_peya)=&apos;IOS&apos; then  session_id end))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_ios,&#13;
count(distinct case when upper(platform_peya)=&apos;ANDROID&apos; then  session_id end) sessions_android,&#13;
safe_divide(count(distinct case when upper(platform_peya)=&apos;ANDROID&apos; then  session_id end),avg(count(distinct case when upper(platform_peya)=&apos;ANDROID&apos; then  session_id end))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_android,&#13;
count(distinct case when visit_number!=1 then  session_id end) sessions_old,&#13;
safe_divide(count(distinct case when visit_number!=1 then  session_id end),avg(count(distinct case when visit_number!=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_old,&#13;
count(distinct case when visit_number=1 then  session_id end) sessions_new,&#13;
safe_divide(count(distinct case when visit_number=1 then  session_id end),avg(count(distinct case when visit_number=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_new,&#13;
count(distinct case when visit_number=1 then  session_id end)-avg(count(distinct case when visit_number=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY partition_date asc rows  between 8  preceding and 1  preceding ) as dif_new,&#13;
count(distinct case when visit_number!=1 then  session_id end)-avg(count(distinct case when visit_number!=1 then  session_id end))  OVER (partition by extract(dayofweek from partition_date)ORDER BY  partition_date asc rows  between 8  preceding and 1  preceding ) as dif_old,&#13;
&#13;
count(distinct   session_id )-avg(count(distinct   session_id))  OVER (partition by extract(dayofweek from partition_date)ORDER BY  partition_date asc rows  between 8  preceding and 1  preceding ) as dif_sess,&#13;
&#13;
avg(totals.hits) hits,&#13;
safe_divide(avg(totals.hits),avg(avg(totals.hits))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_hits,&#13;
avg(totals.screenviews) screenviews,&#13;
safe_divide(avg(totals.screenviews),avg(avg(totals.screenviews))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_screenviews,&#13;
count(distinct fullvisitor_id) fullvisitor,&#13;
safe_divide(count(distinct fullvisitor_id) ,avg(count(distinct fullvisitor_id))  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_fullvisitor,&#13;
avg(totals.time_on_site) session_time,&#13;
safe_divide(avg(totals.time_on_site) ,avg(avg(totals.time_on_site) )  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_session_time,&#13;
count( distinct case when transaction_bool then session_id end) sessions_transaction,&#13;
safe_divide(count( distinct case when transaction_bool then session_id end) ,avg(count( distinct case when transaction_bool then session_id end) )  OVER (partition by extract(dayofweek from partition_date)order by  partition_date asc rows  between 8  preceding and 1  preceding ))-1 delta_sessions_transaction,&#13;
&#13;
count(distinct(case when marketing_traffic.source   in (&apos;direct&apos;) then session_id end))  as direct_source,&#13;
count(distinct(case when marketing_traffic.source  not in (&apos;direct&apos;) then session_id end))  as other_source,&#13;
&#13;
&#13;
&#13;
from `peya-bi-tools-pro.il_sessions.fact_ga_sessions` o&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc &#13;
ON dc.country_id = o.country_id AND dc.active &#13;
where partition_date&gt;&gt;&apos;2022-01-01&apos;&#13;
&#13;
&#13;
group by 1--,2&#13;
),&#13;
partners as (select&#13;
--hp.country_id,&#13;
DATE (hp.full_date) AS date,&#13;
&#13;
&#13;
COUNT(DISTINCT CASE WHEN hp.is_online THEN hp.restaurant_id END) AS total_partners_online&#13;
FROM `peya-bi-tools-pro.il_core.dim_historical_partners` as hp&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc &#13;
ON dc.country_id = hp.country_id AND dc.active &#13;
WHERE DATE(hp.yyyymmdd) &gt;&gt;&apos;2022-01-01&apos;&#13;
&#13;
GROUP BY 1--,2&#13;
),&#13;
riders as ( SELECT  &#13;
--country.country_id,&#13;
    e.day AS date_shifts,&#13;
    &#13;
&#13;
    count(distinct rider_id) qty_riders&#13;
  FROM `peya-bi-tools-pro.il_logistics.fact_logistic_shifts` shifts&#13;
&#13;
    LEFT JOIN UNNEST(shifts.actual_working_time_by_date) e&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc &#13;
ON dc.country_id = shifts.country.country_id AND dc.active&#13;
&#13;
WHERE created_date &gt;&gt;= &apos;2022-01-01&apos;&#13;
&#13;
group by 1--,2&#13;
)&#13;
&#13;
select &#13;
&#13;
&#13;
&#13;
o.registered_date,&#13;
 &apos;LATAM&apos; country ,&#13;
 dayweek,&#13;
orders_conf_android,&#13;
delta_orders_conf_android,&#13;
 orders_conf_ios,&#13;
 delta_orders_conf_ios,&#13;
orders_total,&#13;
 delta_orders_total,&#13;
 customers,&#13;
  delta_orders_customers,&#13;
  orders_new_customers_with_confirmed_orders,&#13;
  share_adquisition_customer,&#13;
  qty_aff_orders,&#13;
  qty_aff_adq,&#13;
  discount_amount,&#13;
  discount_amount_adq,&#13;
gmv_gross_total,&#13;
 gmv_aff_orders,&#13;
 gmv_adq_orders,&#13;
sessions,&#13;
direct_source,&#13;
other_source,&#13;
delta_session,&#13;
 sessions_ios,&#13;
 delta_sessions_ios,&#13;
 sessions_android,&#13;
  delta_sessions_android,&#13;
 sessions_old,&#13;
   delta_sessions_old,&#13;
sessions_new,&#13;
   delta_sessions_new,&#13;
   delta_share_new,&#13;
   delta_share_old,&#13;
   newoverold,&#13;
   newovertotal,&#13;
 hits,&#13;
    delta_hits,&#13;
  screenviews,&#13;
      delta_screenviews,&#13;
fullvisitor,&#13;
delta_fullvisitor,&#13;
 session_time,&#13;
 delta_session_time,&#13;
 sessions_transaction,&#13;
  delta_sessions_transaction,&#13;
  dif_new,&#13;
  dif_old,&#13;
  dif_sess&#13;
from orders o&#13;
left join sessions s on o.registered_date=s.partition_date --and o.country_id=s.country_id&#13;
&#13;
left join riders r on o.registered_date=r.date_shifts -- and o.country_id=r.country_id&#13;
left join partners p on o.registered_date=p.date --and o.country_id=p.country_id&#13;
&#13;
&#13;
&#13;
order by 1 desc&#13;
),&#13;
country as (&#13;
with orders as (&#13;
-- ssss&#13;
select&#13;
o.country_id country_id ,&#13;
registered_date,&#13;
&#13;
extract(dayofweek from registered_date) dayweek,&#13;
count( distinct case when upper(application)=&apos;ANDROID&apos; then o.order_id end) orders_conf_android,&#13;
