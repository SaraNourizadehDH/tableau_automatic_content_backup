left join sessions s on o.registered_date=s.partition_date --and o.country_id=s.country_id&#13;
&#13;
left join riders r on o.registered_date=r.date_shifts -- and o.country_id=r.country_id&#13;
left join partners p on o.registered_date=p.date --and o.country_id=p.country_id&#13;
