        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0sdvc7i0ub31611dpptyd17t6q6o' name='Custom SQL Query' type='text'>SELECT partition_date,dc.country_name as country,platform_peya,app_browser,count(distinct (user_id)) as qty_session&#13;
FROM `peya-bi-tools-pro.il_sessions.fact_ga_sessions` o&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc &#13;
ON dc.country_id = o.country_id AND dc.active &#13;
WHERE partition_date &gt;&gt; &quot;2022-06-01&quot; &#13;
&#13;
group by 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
