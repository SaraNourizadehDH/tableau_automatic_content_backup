      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Discounts Amounts' id='_26B3CC2CB46042A0A943CE05C44A7D88'>
            <properties context=''>
              <relation connection='bigquery.04dq26c1k67vie1gj60f911vitd5' name='Custom SQL Query1' type='text'><![CDATA[WITH dates AS ( 
	SELECT 
		DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -6 MONTH) start_date,
		DATE(CURRENT_DATE) before_date 
),

fact_orders_discounts AS (
	SELECT * FROM `peya-markets.automated_tables_reports.affordable_orders`
  WHERE registered_date >>= (SELECT start_date FROM dates)

),
order_data AS (
	SELECT DISTINCT
		o.order_id,
		o.restaurant.id partner_id,
		o.registered_date,
		o.country_id,
		UPPER(o.country.country_name) country_name,
		COALESCE(UPPER(o.business_type.business_type_name), 'OTHER') business_type_name,
    CASE WHEN dmart.partner_id IS NOT NULL THEN 'DMART' ELSE 'NOT_DMART' END is_dmart,
		CASE WHEN part.is_concept THEN 'CONCEPT' ELSE 'NOT_CONCEPT' END is_concept,
    ce.rate_eu,
		ce.rate_us
	FROM `peya-bi-tools-pro.il_core.fact_orders` o

	INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
			ON dc.country_id = o.country_id
		   AND dc.active

	LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce 
		   ON ce.currency_id = dc.currency_id 
		  AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)

	LEFT JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` dmart
		   ON dmart.partner_id = o.restaurant.id
  left join `peya-bi-tools-pro.il_core.dim_partner` part on part.partner_id=o.restaurant.id
	WHERE o.registered_date >>= (SELECT start_date FROM dates)
  	  AND o.registered_date << (SELECT before_date FROM dates)
  	  AND o.order_status IN ('CONFIRMED')
      AND o.order_id not in (SELECT order_id_to_be_excluded FROM `peya-markets.automated_tables_reports.dim_order_problems` )
      
)
SELECT 
	od.registered_date 			   	 	   full_date,
	od.country_name 					   country_name,
	od.business_type_name 				   business_type_name,
	COALESCE(od.is_dmart, 'UNKNOWN')	   is_dmart, 
	COALESCE(fod.paid_by, 'UNKNOWN') 	   paid_by,
	COALESCE(fod.discount_type, 'UNKNOWN') discounts_in_order,
	COALESCE(od.is_concept, 'UNKNOWN')	   is_concept,
	SUM(fod.discount_amount) 		      discount_amount,
	SUM(fod.discount_amount / od.rate_us) discount_amount_usd,
	SUM(fod.discount_amount / od.rate_eu) discount_amount_euro
FROM fact_orders_discounts fod 

LEFT JOIN order_data od
	   ON od.order_id = fod.order_id

WHERE od.country_name IS NOT NULL
and fod.order_id not in (SELECT order_id_to_be_excluded FROM `peya-markets.automated_tables_reports.dim_order_problems` )

GROUP BY 1,2,3,4,5,6,7]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_26B3CC2CB46042A0A943CE05C44A7D88' table='[Extract].[_26B3CC2CB46042A0A943CE05C44A7D88]' type='table' />
            </properties>
          </object>
          <object caption='GMV &amp; Commission' id='_9BB4C4ECDC5849B8B7381E2931CA184A'>
            <properties context=''>
              <relation connection='bigquery.04dq26c1k67vie1gj60f911vitd5' name='Custom SQL Query' type='text'><![CDATA[/* inicio codigo revision
SELECT 
	DATE_TRUNC(full_date, ISOWEEK) date_week, 
	country_name,
	business_type_name,
	is_dmart,
	SUM(total_partners_with_confirmed_orders_weekly) total_partners_with_confirmed_orders_weekly,
    SUM(total_partners_with_discounts_weekly) total_partners_with_discounts_weekly
FROM (
fin codigo revision */

WITH dates AS ( 
	SELECT 
		DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -6 MONTH) start_date,
		DATE(CURRENT_DATE) before_date 
),
base_table AS (
	SELECT 
		DATE(dd.date) full_date,
		UPPER(dc.country_name) country_name,
		UPPER(bt.business_type_name) business_type_name,
		dmart.is_dmart,
    concept.is_concept
	FROM `peya-bi-tools-pro.il_core.dim_date` dd 

	CROSS JOIN (SELECT country_name FROM `peya-bi-tools-pro.il_core.dim_country` WHERE active) dc

	CROSS JOIN (SELECT business_type_name FROM `peya-bi-tools-pro.il_core.dim_business_type`) bt

	CROSS JOIN (SELECT 'DMART' is_dmart UNION ALL SELECT 'NOT_DMART' is_dmart) dmart
  CROSS JOIN (SELECT 'CONCEPT' is_concept UNION ALL SELECT 'NOT_CONCEPT' is_dmart) concept

	WHERE dd.date >>= (SELECT start_date FROM dates)
	  AND dd.date << (SELECT before_date FROM dates)	
),

fact_orders_discounts AS (
SELECT * FROM `peya-markets.automated_tables_reports.affordable_orders`
WHERE registered_date >>= (SELECT start_date FROM dates)
),
/* fing query descuentos */
subsidized_company AS (
	SELECT 
			order_id,
		SUM(discount_amount) discount_amount
	FROM `peya-markets.automated_tables_reports.affordable_orders`
		WHERE paid_by IN ('COMPANY')
	  AND discount_type IN ('SUBSIDIZED')
      AND order_id not in (SELECT order_id_to_be_excluded FROM `peya-markets.automated_tables_reports.dim_order_problems` )
    AND registered_date >>= (SELECT start_date FROM dates)
	GROUP BY 1
),

discounts AS (
    SELECT
        order_id,
        SUM(discount_amount) discount_amount_lc,
    FROM fact_orders_discounts
    where discount_amount>>0
    GROUP BY 1 
),
partners_daily AS (
	SELECT 
		DATE_TRUNC(o.registered_date, DAY) 											date_day,
		UPPER(o.country.country_name) 												country_name,
		COALESCE(UPPER(dp.business_type.business_type_name), 'OTHER') 				business_type_name,
		CASE WHEN dmart.partner_id IS NOT NULL THEN 'DMART' ELSE 'NOT_DMART' END    is_dmart,
    CASE WHEN dp.is_concept THEN 'CONCEPT' ELSE 'NOT_CONCEPT' END    is_concept,
		COUNT(DISTINCT o.restaurant.id) 										    total_partners_with_confirmed_orders_daily,
		COUNT(DISTINCT CASE WHEN dis.order_id IS NOT NULL THEN o.restaurant.id END) total_partners_with_discounts_daily
	FROM `peya-bi-tools-pro.il_core.fact_orders` o

	LEFT JOIN discounts dis
		   ON dis.order_id = o.order_id

	LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
		   ON dp.partner_id = o.restaurant.id

	LEFT JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` dmart
		   ON dmart.partner_id = o.restaurant.id

	WHERE o.registered_date >>= (SELECT start_date FROM dates)
	  AND o.registered_date << (SELECT before_date FROM dates)
	  AND o.order_status = 'CONFIRMED'
	GROUP BY 1,2,3,4,5    
),
partners_weekly AS (
	SELECT 
		DATE_TRUNC(o.registered_date, ISOWEEK) 										date_week,
		UPPER(o.country.country_name) 												country_name,
		COALESCE(UPPER(dp.business_type.business_type_name), 'OTHER') 				business_type_name,
		CASE WHEN dmart.partner_id IS NOT NULL THEN 'DMART' ELSE 'NOT_DMART' END    is_dmart,
    CASE WHEN dp.is_concept THEN 'CONCEPT' ELSE 'NOT_CONCEPT' END    is_concept,
		COUNT(DISTINCT o.restaurant.id) 										    total_partners_with_confirmed_orders_weekly,
		COUNT(DISTINCT CASE WHEN dis.order_id IS NOT NULL THEN o.restaurant.id END) total_partners_with_discounts_weekly
	FROM `peya-bi-tools-pro.il_core.fact_orders` o

	LEFT JOIN discounts dis
		   ON dis.order_id = o.order_id

	LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
		   ON dp.partner_id = o.restaurant.id

	LEFT JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` dmart
		   ON dmart.partner_id = o.restaurant.id

	WHERE o.registered_date >>= (SELECT start_date FROM dates)
	  AND o.registered_date << (SELECT before_date FROM dates)
	  AND o.order_status = 'CONFIRMED'
	GROUP BY 1,2,3,4,5	
),
partners_monthly AS (
	SELECT 
		DATE_TRUNC(o.registered_date, MONTH) 										date_month,
		UPPER(o.country.country_name) 												country_name,
		COALESCE(UPPER(dp.business_type.business_type_name), 'OTHER') 				business_type_name,
		CASE WHEN dmart.partner_id IS NOT NULL THEN 'DMART' ELSE 'NOT_DMART' END    is_dmart,
    CASE WHEN dp.is_concept THEN 'CONCEPT' ELSE 'NOT_CONCEPT' END    is_concept,
		COUNT(DISTINCT o.restaurant.id) 										    total_partners_with_confirmed_orders_monthly,
		COUNT(DISTINCT CASE WHEN dis.order_id IS NOT NULL THEN o.restaurant.id END) total_partners_with_discounts_monthly
	FROM `peya-bi-tools-pro.il_core.fact_orders` o

	LEFT JOIN discounts dis
		   ON dis.order_id = o.order_id

	LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
		   ON dp.partner_id = o.restaurant.id

	LEFT JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` dmart
		   ON dmart.partner_id = o.restaurant.id

	WHERE o.registered_date >>= (SELECT start_date FROM dates)
	  AND o.registered_date << (SELECT before_date FROM dates)
	  AND o.order_status = 'CONFIRMED'
	GROUP BY 1,2,3,4,5
),
orders AS (
	SELECT
		o.registered_date 														 date_day,
		UPPER(o.country.country_name) 											 country_name,
	    COALESCE(UPPER(o.business_type.business_type_name), 'OTHER') 			 business_type_name,
		CASE WHEN dmart.partner_id IS NOT NULL THEN 'DMART' ELSE 'NOT_DMART' END is_dmart,
    CASE WHEN dp.is_concept THEN 'CONCEPT' ELSE 'NOT_CONCEPT' END    is_concept,

		SUM( o.total_amount + o.shipping_amount + IFNULL(serviceFee.service_fee_amount,0) + COALESCE(o.discount_paid_by_company,0))               gmv_gross,
		SUM((o.total_amount + o.shipping_amount + IFNULL(serviceFee.service_fee_amount,0) + COALESCE(o.discount_paid_by_company,0)) / ce.rate_us) gmv_gross_usd,
		SUM((o.total_amount + o.shipping_amount + IFNULL(serviceFee.service_fee_amount,0) + COALESCE(o.discount_paid_by_company,0)) / ce.rate_eu) gmv_gross_euro,

		SUM( o.commission_amount - COALESCE(sub_com.discount_amount,0))               commission_amount_wo_subsidies,
		SUM((o.commission_amount - COALESCE(sub_com.discount_amount,0)) / ce.rate_us) commission_amount_wo_subsidies_usd,
		SUM((o.commission_amount - COALESCE(sub_com.discount_amount,0)) / ce.rate_eu) commission_amount_wo_subsidies_euro,

		SUM(o.delivery_fee_revenue)              delivery_fee_revenue,
		SUM(o.delivery_fee_revenue / ce.rate_us) delivery_fee_revenue_usd,
		SUM(o.delivery_fee_revenue / ce.rate_eu) delivery_fee_revenue_euro,

		SUM(IF(o.is_online_payment = 1,  (COALESCE(o.credit_card_commission,0)/100)*(COALESCE(o.total_amount,0) + COALESCE(o.shipping_amount,0)),0)) 			   credit_card_revenue,
		SUM(IF(o.is_online_payment = 1, ((COALESCE(o.credit_card_commission,0)/100)*(COALESCE(o.total_amount,0) + COALESCE(o.shipping_amount,0))) / ce.rate_us,0)) credit_card_revenue_usd,
		SUM(IF(o.is_online_payment = 1, ((COALESCE(o.credit_card_commission,0)/100)*(COALESCE(o.total_amount,0) + COALESCE(o.shipping_amount,0))) / ce.rate_us,0)) credit_card_revenue_euro
	FROM `peya-bi-tools-pro.il_core.fact_orders` o

	INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
			ON dc.country_id = o.country_id
		   AND dc.active

	LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce 
		   ON ce.currency_id = dc.currency_id 
		  AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)

	LEFT JOIN subsidized_company sub_com 
		   ON sub_com.order_id = o.order_id

	LEFT JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` dmart
		   ON dmart.partner_id = o.restaurant.id
  
	LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp
		   ON dp.partner_id = o.restaurant.id

	WHERE o.registered_date >>= (SELECT start_date FROM dates)
	  AND o.registered_date << (SELECT before_date FROM dates)
	  AND o.order_status IN ('CONFIRMED')
      AND o.order_id not in (SELECT order_id_to_be_excluded FROM `peya-markets.automated_tables_reports.dim_order_problems` )
	GROUP BY 1,2,3,4,5
)
SELECT 
	base.full_date,
	base.country_name,
	base.business_type_name,
	base.is_dmart,
  base.is_concept,
	COALESCE(o.gmv_gross, 0) 						   gmv_gross,
	COALESCE(o.gmv_gross_usd, 0) 					   gmv_gross_usd,
	COALESCE(o.gmv_gross_euro, 0) 					   gmv_gross_euro,
	COALESCE(o.commission_amount_wo_subsidies, 0) 	   commission_amount_wo_subsidies,
	COALESCE(o.commission_amount_wo_subsidies_usd, 0)  commission_amount_wo_subsidies_usd,
	COALESCE(o.commission_amount_wo_subsidies_euro, 0) commission_amount_wo_subsidies_euro,
	COALESCE(o.delivery_fee_revenue, 0) 			   delivery_fee_revenue,
	COALESCE(o.delivery_fee_revenue_usd, 0) 		   delivery_fee_revenue_usd,
	COALESCE(o.delivery_fee_revenue_euro, 0) 	   	   delivery_fee_revenue_euro,
	COALESCE(o.credit_card_revenue, 0) 				   credit_card_revenue,
	COALESCE(o.credit_card_revenue_usd, 0) 			   credit_card_revenue_usd,
	COALESCE(o.credit_card_revenue_euro, 0) 		   credit_card_revenue_euro,

	COALESCE(p_day.total_partners_with_confirmed_orders_daily, 0) total_partners_with_confirmed_orders_daily,
	COALESCE(p_day.total_partners_with_discounts_daily, 0) 		  total_partners_with_discounts_daily,

	COALESCE(p_week.total_partners_with_confirmed_orders_weekly, 0) total_partners_with_confirmed_orders_weekly,
	COALESCE(p_week.total_partners_with_discounts_weekly, 0) 	    total_partners_with_discounts_weekly,

	COALESCE(p_month.total_partners_with_confirmed_orders_monthly, 0) total_partners_with_confirmed_orders_monthly,
	COALESCE(p_month.total_partners_with_discounts_monthly, 0) 	      total_partners_with_discounts_monthly
FROM base_table base

LEFT JOIN orders o
	   ON o.date_day = base.full_date
	  AND o.country_name = base.country_name
	  AND o.business_type_name = base.business_type_name
	  AND o.is_dmart = base.is_dmart
    and o.is_concept=base.is_concept


      	   

LEFT JOIN partners_daily p_day
	   ON p_day.date_day = base.full_date
	  AND p_day.country_name = base.country_name
	  AND p_day.business_type_name = base.business_type_name
	  AND p_day.is_dmart = base.is_dmart
    and p_day.is_concept=base.is_concept

LEFT JOIN partners_weekly p_week
	   ON p_week.date_week = base.full_date
	  AND p_week.country_name = base.country_name
	  AND p_week.business_type_name = base.business_type_name
	  AND p_week.is_dmart = base.is_dmart
    and p_week.is_concept=base.is_concept

LEFT JOIN partners_monthly p_month
	   ON p_month.date_month = base.full_date
	  AND p_month.country_name = base.country_name
	  AND p_month.business_type_name = base.business_type_name
	  AND p_month.is_dmart = base.is_dmart
    and p_month.is_concept=base.is_concept

ORDER BY 1 DESC, 2, 3, 4,5

/* inicio codigo revision
)
WHERE country_name = 'ECUADOR'
GROUP BY 1,2,3,4
ORDER BY 1 DESC, 2, 3, 4
fin codigo revision */]]></relation>
            </properties>
