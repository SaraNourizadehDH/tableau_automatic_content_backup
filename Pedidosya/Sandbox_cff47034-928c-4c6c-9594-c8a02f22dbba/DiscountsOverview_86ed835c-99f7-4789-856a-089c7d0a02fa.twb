      <column caption='% Paid by Partner' datatype='real' name='[% Paid by Company (copy)_942941206472454159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([paid_by]=&apos;RESTAURANT&apos;,[discount_amount_euro],0))/SUM([discount_amount_euro])' />
      </column>
      <column caption='% discounts over Total Revenue' datatype='real' name='[% discounts over GMV Gross (copy)_1077626958373302273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount_euro]) / SUM([GMV Gross Euro (discounts fixed) (copy)_1077626958370361344])' />
      </column>
      <column caption='% discounts over GMV Gross' datatype='real' name='[% discounts over GMV Gross (discounts fixed) (copy)_236579748756799488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount_euro]) / SUM([gmv_gross_euro])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0wm2tk41hn40wf13qeqrg09iqtt8].[sum:discount_amount_euro:qk]&quot;' value='Euro' />
          <alias key='&quot;[federated.0wm2tk41hn40wf13qeqrg09iqtt8].[sum:discount_amount_usd:qk]&quot;' value='USD' />
          <alias key='&quot;[federated.0wm2tk41hn40wf13qeqrg09iqtt8].[sum:discount_amount:qk]&quot;' value='Local Currency' />
