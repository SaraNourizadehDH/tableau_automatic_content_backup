            <column caption='dynamic_date' datatype='date' name='[Calculation_942941206169309189]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#13;&#10;  CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[full_date])      &#13;&#10;    WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[full_date])&#13;&#10;    WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[full_date])&#13;&#10;  END&#13;&#10;)' />
            </column>
            <column caption='Total Revenue Euro (discounts fixed)' datatype='real' name='[GMV Gross Euro (discounts fixed) (copy)_1077626958370361344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [paid_by],[discounts_in_order] : SUM([commission_amount_wo_subsidies_euro]) + SUM([credit_card_revenue_euro]) + SUM([delivery_fee_revenue_euro])}' />
            </column>
            <column-instance column='[GMV Gross Euro (discounts fixed) (copy)_1077626958370361344]' derivation='Attribute' name='[attr:GMV Gross Euro (discounts fixed) (copy)_1077626958370361344:qk]' pivot='key' type='quantitative' />
