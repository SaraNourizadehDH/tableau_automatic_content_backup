    WHEN paid_by <<>> 'COMPANY' AND discount_type IN ('SUBSIDIZED') then 'SUBSIDIZED_BY_PARTNER' 
    ELSE discount_type end as discount_type_fixed 
    FROM `peya-markets.automated_tables_reports.affordable_orders`
    where discount_type<<>>'SUBSIDIZED_proxy'
    and registered_date >>= (SELECT start_date FROM dates)
