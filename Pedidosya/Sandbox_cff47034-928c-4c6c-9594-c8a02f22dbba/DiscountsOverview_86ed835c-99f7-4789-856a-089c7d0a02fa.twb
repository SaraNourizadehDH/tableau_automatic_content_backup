	)
	SELECT
		order_id,
		ARRAY_TO_STRING(ARRAY_AGG(DISTINCT discount_type_fixed IGNORE NULLS ORDER BY discount_type_fixed)," + ") discounts_per_order
	FROM aux_order_discounts
	GROUP BY 1
), 
order_data AS (
	SELECT 
		o.order_id,
		o.registered_date,
		o.country.country_name,
		o.business_type.business_type_name,
    CASE WHEN p.is_concept THEN 'CONCEPT' ELSE 'NOT_CONCEPT' END    is_concept,
   CASE WHEN dmart.partner_id IS NOT NULL THEN 'DMART' ELSE 'NOT_DMART' END    is_dmart,

	FROM `peya-bi-tools-pro.il_core.fact_orders` o

	INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
	        ON cd.country_id = o.country.country_id
	       AND cd.active
	left join `peya-bi-tools-pro.il_core.dim_partner` p on o.restaurant.id=p.partner_id
	LEFT JOIN `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` dmart
		   ON dmart.partner_id = o.restaurant.id
  WHERE o.registered_date >>= (SELECT start_date FROM dates)
	  AND o.registered_date << (SELECT before_date FROM dates)
	  AND o.order_status = 'CONFIRMED'
)
SELECT 
        od.registered_date 			 															   full_date,
        UPPER(od.country_name)       															   country_name,
        UPPER(od.business_type_name) 															   business_type_name,
        od.is_concept,
        od.is_dmart,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE '%BINS%' 				  THEN 'YES' ELSE 'NO' END has_bins,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%COORPORATIVE_COUPON%')      THEN 'YES' ELSE 'NO' END has_coorporative_coupon,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%DMART_COUPON%') 		      THEN 'YES' ELSE 'NO' END has_dmart_coupon,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%JOKER%') 			   	      THEN 'YES' ELSE 'NO' END has_joker,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%MARKETING_CENTRAL_COUPON%') THEN 'YES' ELSE 'NO' END has_marketing_central_coupon,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%MARKETING_LOCAL_COUPON%')   THEN 'YES' ELSE 'NO' END has_marketing_local_coupon,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%NON_MARKETING_COUPON%')     THEN 'YES' ELSE 'NO' END has_non_marketing_coupon,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%OTHER_TYPE_COUPON%')        THEN 'YES' ELSE 'NO' END has_other_type_coupon,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%PARTNERSHIPS%')             THEN 'YES' ELSE 'NO' END has_partnerships,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%PLUS_SHIPPING_COST%')       THEN 'YES' ELSE 'NO' END has_plus_shipping_cost,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%SHOPPER%')                  THEN 'YES' ELSE 'NO' END has_shopper,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%SORRY_COUPON%')             THEN 'YES' ELSE 'NO' END has_sorry_coupon,
        CASE WHEN UPPER(odi.discounts_per_order) LIKE ('%STAMPS%')                   THEN 'YES' ELSE 'NO' END has_stamps,
