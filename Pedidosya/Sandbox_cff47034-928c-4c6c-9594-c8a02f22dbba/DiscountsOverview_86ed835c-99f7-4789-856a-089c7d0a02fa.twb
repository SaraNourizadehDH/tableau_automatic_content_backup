      <column caption='Total Paid by Company' datatype='real' name='[Calculation_942941206452129804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([paid_by]=&apos;COMPANY&apos;,[discount_amount_euro],0))' />
      </column>
      <column caption='color_boolean' datatype='integer' name='[Calculation_942941206458490893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (ZN([Calculation_942941206449954827]) - LOOKUP(ZN([Calculation_942941206449954827]), -1)) / ABS(LOOKUP(ZN([Calculation_942941206449954827]), -1)) &lt; 0 THEN 1 ELSE 0 END'>
