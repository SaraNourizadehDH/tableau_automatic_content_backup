    <datasource caption='discounts_orders (BQ)' inline='true' name='federated.0kjo0ds1cnqt5l1c29z1u00r4g2o' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.198yuyo1l9iecy1gycqly0dvmtk2'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='user_rodrigo_pizzano' server-oauth='' username='emmanuel.colon@pedidosya.com' workgroup-auth-mode='prompt' />
