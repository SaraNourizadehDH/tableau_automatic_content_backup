              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kjo0ds1cnqt5l1c29z1u00r4g2o'>
            <column datatype='date' name='[full_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wm2tk41hn40wf13qeqrg09iqtt8'>
            <column caption='% discounts over Total Revenue' datatype='real' name='[% discounts over GMV Gross (copy)_1077626958373302273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_amount_euro]) / SUM([GMV Gross Euro (discounts fixed) (copy)_1077626958370361344])' />
            </column>
            <column caption='Business Name' datatype='string' name='[Calculation_1879267734478528512]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[business_type_name]' />
