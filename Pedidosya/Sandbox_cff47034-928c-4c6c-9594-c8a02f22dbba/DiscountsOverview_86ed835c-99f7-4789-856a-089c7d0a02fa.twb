      <column caption='Country' datatype='string' name='[Calculation_3888365716538089472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='total_partners_with_confirmed_orders_dynamic' datatype='integer' name='[Calculation_432486360914829312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos;   THEN SUM([total_partners_with_confirmed_orders_daily])&#10;    WHEN &apos;Weekly&apos;  THEN SUM([total_partners_with_confirmed_orders_weekly])&#10;    WHEN &apos;Monthly&apos; THEN SUM([total_partners_with_confirmed_orders_monthly])&#10;END' />
      </column>
      <column caption='dynamic_date' datatype='date' name='[Calculation_942941206169309189]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&#13;&#10;  CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[full_date])      &#13;&#10;    WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[full_date])&#13;&#10;    WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[full_date])&#13;&#10;  END&#13;&#10;)' />
      </column>
      <column caption='% Paid by Company' datatype='real' name='[Calculation_942941206449954827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([paid_by]=&apos;COMPANY&apos;,[discount_amount_euro],0))/SUM([discount_amount_euro])' />
