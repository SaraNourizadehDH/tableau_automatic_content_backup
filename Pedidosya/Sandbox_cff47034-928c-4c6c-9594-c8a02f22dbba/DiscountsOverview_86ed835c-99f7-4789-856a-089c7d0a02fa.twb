      <column caption='Business Name' datatype='string' name='[Calculation_1879267734478528512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[business_type_name]' />
      </column>
      <column caption='% by discount type' datatype='real' name='[Calculation_275282556010147840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount_euro]) / SUM({EXCLUDE [discounts_in_order] : SUM([discount_amount_euro])})' />
      </column>
      <column caption='discount_amount_by_currency_parameter' datatype='real' name='[Calculation_275282556014297090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Local Currency&apos; THEN [discount_amount]&#10;    WHEN &apos;Euro&apos; THEN [discount_amount_euro]&#10;    WHEN &apos;USD&apos; THEN [discount_amount_usd]&#10;END' />
      </column>
      <column caption='Percent of Discount Amount' datatype='real' name='[Calculation_275282556021669893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_amount]) / SUM({EXCLUDE [paid_by] : SUM([discount_amount])}) *100' />
      </column>
      <column caption='Value or Percent' datatype='string' name='[Calculation_275282556022267910]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF      [Parameters].[Parameter 3] = 1 THEN REGEXP_REPLACE(STR(ROUND(SUM([Calculation_275282556014297090]),0)),&quot;(\d)(?=(\d{3})+$)&quot;,&quot;$0,&quot;)&#10;ELSEIF  [Parameters].[Parameter 3] = 2 THEN LEFT(STR([Calculation_275282556021669893]),4) + &apos;%&apos;&#10;END' />
      </column>
      <column caption='%_partners_with_discounts' datatype='real' name='[Calculation_324259232325767168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_partners_dynamic (copy)_432486360924450817] / [Calculation_432486360914829312]' />
