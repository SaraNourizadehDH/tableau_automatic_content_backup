        </zone>
        <zone forceUpdate='true' h='2900' id='225' type-v2='text' w='32750' x='3188' y='25880'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'>Aquí se presentan los resultados económicos de la campaña,</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'> incluyendo venta y presupuesto asignado.</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'>Todas las variables monetarias se encuentran en moneda local.</run>
