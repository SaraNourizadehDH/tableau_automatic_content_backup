      </column>
      <column caption='ctr_calc' datatype='real' name='[Calculation_2057300651131899908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks]) / SUM([impressions])' />
      </column>
      <column caption='cvr_calc' datatype='real' name='[Calculation_2057300651132301317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([conversion]) / SUM([clicks])' />
      </column>
      <column caption='roas_eur' datatype='real' name='[Calculation_2057300651133853702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_2057300651134349319]) /SUM([ad_spend_eur]))' />
      </column>
      <column caption='sales_revenue_eur' datatype='real' name='[Calculation_2057300651134349319]' role='measure' type='quantitative'>
