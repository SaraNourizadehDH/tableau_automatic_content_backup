                <zone forceUpdate='true' h='3214' id='220' type-v2='text' w='22600' x='43667' y='38893'>
                  <formatted-text>
                    <run fontcolor='#555555'>En caso de querer filtrar una Keyword para la que se haya realizado una campaña, puedes elegirla</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
