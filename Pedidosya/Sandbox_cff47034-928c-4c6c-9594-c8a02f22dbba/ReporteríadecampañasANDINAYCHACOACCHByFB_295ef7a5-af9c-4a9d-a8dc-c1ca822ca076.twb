                <zone forceUpdate='true' h='2750' id='442' type-v2='text' w='25333' x='69400' y='38857'>
                  <formatted-text>
                    <run fontcolor='#555555'>Puedes elegir campañas que hayan aplicado a determinada categoría de productos </run>
