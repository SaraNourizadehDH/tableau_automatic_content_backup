                <zone forceUpdate='true' h='2071' id='219' type-v2='text' w='29667' x='3533' y='39643'>
                  <formatted-text>
                    <run fontcolor='#555555' fontsize='7'>Puedes elegir solo las campañas que cumplen  cierto objetivo del Funnel</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='9429' id='438' type-v2='text' w='96867' x='1800' y='44679'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Este tablero te permite generar un reporte estándar con los resultados de campañas. </run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Puedes elegir entre dos opciones:</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>✅ </run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Opción 1: Generar un reporte con todas las campañas que filtraste:</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Aplica los filtros que necesites, luego presiona </run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>&quot;Seleccionar todas las campañas&quot;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'> para incluirlas en tu reporte.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>✅ </run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Opción 2:  Generar un reporte con una campaña específica:</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Haz clic directamente sobre el nombre de la campaña que deseas.</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>La vista del reporte se actualizará con los datos de esa campaña en particular.</run>
                    <run fontalignment='1'>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#7bc4ac' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='3' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d2e9e0' />
                  </zone-style>
                </zone>
