          <calculation class='tableau' formula='&quot;Total_Discount_Amount&quot;' />
          <aliases>
            <alias key='&quot;GMV&quot;' value='GMV_Gross_AffectedOrders' />
            <alias key='&quot;GMV_company&quot;' value='GMV_Gross_AllOrders' />
          </aliases>
        </column>
        <column caption='Parameter X' datatype='string' name='[Parameter Y (copy)_1569504522487025682]' param-domain-type='list' role='measure' type='nominal' value='&quot;qty_restos&quot;'>
          <calculation class='tableau' formula='&quot;qty_restos&quot;' />
        </column>
