      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_466C3F652B7245998A80955C65D01526'>
            <properties context=''>
              <relation connection='bigquery.1yughhg1fitx15199kd5c0ekc9sn' name='Custom SQL Query' type='text'>SELECT&#13;
        DATE_TRUNC(registered_date, MONTH) AS month,&#13;
        c.country_id as country_id,&#13;
        case when dmart.is_darkstore then &apos;DMART&apos; else o.business_type.business_type_name end as business_type_name,&#13;
      &#13;
        round(SUM(total_amount + shipping_amount + discount_paid_by_company),2) AS GMV_company_LC,&#13;
        round(sum(round((total_amount + shipping_amount + discount_paid_by_company)/ rate_eu,2)),2)  as GMV_company_eu&#13;
        ,count(distinct(o.order_id)) as qty_orders_company&#13;
FROM peya-bi-tools-pro.il_core.fact_orders AS o&#13;
        INNER JOIN peya-bi-tools-pro.il_core.dim_country AS c ON c.country_id = o.country_id AND c.active =true&#13;
        LEFT JOIN peya-bi-tools-pro.il_core.dim_currency_exchange exc on exc.currency_id= c.currency_id and DATE_TRUNC(registered_date, MONTH) = date_trunc(date(currency_exchange_date),month)&#13;
        &#13;
left join `peya-datamarts-pro.dm_dmarts.dim_partner_darkstore` dmart on o.restaurant.id=dmart.partner_id&#13;
        where  o.registered_date &gt;&gt;= &apos;2022-01-01&apos;&#13;
        AND o.order_status = &apos;CONFIRMED&apos;&#13;
        GROUP BY 1,2,3&#13;
        order by 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='_466C3F652B7245998A80955C65D01526' table='[Extract].[_466C3F652B7245998A80955C65D01526]' type='table' />
            </properties>
          </object>
          <object caption='Consulta_SQL_personalizada' id='_90E1E467E02542A39DD4B18A73D8A7B7'>
            <properties context=''>
              <relation connection='bigquery.1yughhg1fitx15199kd5c0ekc9sn' name='Consulta_SQL_personalizada' type='text'>select &#13;
date_trunc(full_date,month) as month,&#13;
country_id,	&#13;
country_name,	&#13;
business_type_id,&#13;
business_type_name,&#13;
campaign_name,&#13;
brand,&#13;
discounts_in_order,&#13;
count(distinct(id)) as qty_restaurant,	&#13;
Count(distinct(order_id))	as qty_order,&#13;
Count(distinct(customer_id))	as qty_customer,&#13;
round(sum(total_discount_amount),2) total_discount_amount,&#13;
round(sum(company_discount_amount),2) company_discount_amount,&#13;
round(sum(partner_discount_amount),	2) partner_discount_amount,&#13;
round(sum(third_discount_amount),2) third_discount_amount,&#13;
round(sum(unknown_discount_amount),2) unknown_discount_amount,&#13;
round(sum(GMV_LC),2) GMV_LC,&#13;
round(sum(total_discount_amount_eu),2) total_discount_amount_eu,&#13;
round(sum(company_discount_amount_eu),2) company_discount_amount_eu,&#13;
round(sum(partner_discount_amount_eu),2) partner_discount_amount_eu,&#13;
round(sum(third_discount_amount_eu),2) third_discount_amount_eu,&#13;
round(sum(unknown_discount_amount_eu),2)unknown_discount_amount_eu,&#13;
round(sum(GMV_eu),2) GMV_eu&#13;
&#13;
&#13;
 from `peya-markets.automated_tables_reports.campaing_discounts`&#13;
 group by 1,2,3,4,5,6,7,8</relation>
            </properties>
            <properties context='extract'>
              <relation name='_90E1E467E02542A39DD4B18A73D8A7B7' table='[Extract].[_90E1E467E02542A39DD4B18A73D8A7B7]' type='table' />
            </properties>
          </object>
        </objects>
