      <aliases enabled='yes' />
      <column datatype='real' name='[APT_EPT_diff]' role='measure' type='quantitative' />
      <column caption='NPS Answers' datatype='integer' name='[Calculation_1420885684518330368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([response_id])' />
      </column>
      <column caption='Weeks to next order' datatype='string' name='[Calculation_1420885684543750145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATEDIFF(&apos;iso-week&apos;, [registered_date], [user_next_order_date])&gt;5 then &apos;&gt;=6&apos; else str(DATEDIFF(&apos;iso-week&apos;, [registered_date], [user_next_order_date])) end' />
      </column>
      <column caption='NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_379991249679413248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [nps_group] = &apos;Promoter&apos; then 1 else 0 end)/[Calculation_1420885684518330368]*100&#13;&#10;-&#13;&#10;sum(if [nps_group] = &apos;Detractor&apos; then 1 else 0 end)/[Calculation_1420885684518330368]*100' />
      </column>
      <column caption='%VL&gt;10' datatype='real' name='[Calculation_379991249694728194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [vendor_late] &gt; 10 then 1 else 0 end)/sum(if ISNULL([vendor_late]) then 0 else 1 end)' />
      </column>
      <column caption='%FR' datatype='real' name='[Calculation_379991249695178755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [order_state] = &apos;Non-confirmed&apos; then 1 else 0 end)/sum(if ISNULL([order_state]) then 0 ELSE 1 end)' />
      </column>
      <column caption='%Stacking' datatype='real' name='[Calculation_379991249695436804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [stacked_deliveries] &gt; 0 then 1 else 0 end)/ sum(if ISNULL([stacked_deliveries]) then 0 else 1 end)' />
      </column>
      <column caption='month' datatype='integer' name='[Calculation_76561225145401344]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;,[registered_at])' />
      </column>
      <column caption='Seamless' datatype='real' name='[Calculation_984880945898823680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([seamless_order])/[Calculation_1420885684518330368]*100' />
      </column>
