      <aliases enabled='yes' />
      <column caption='CVR2 Vertical ' datatype='real' default-format='p0.00%' name='[CVR2 Vertical (copia)_1838031630928781314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [shop_list_loaded]=TRUE  AND [transaction_bool]=TRUE THEN [session_id] ELSE NULL END)/&#13;&#10;COUNTD(IF [shop_list_loaded]=TRUE  THEN [session_id] ELSE NULL END)' />
      </column>
      <column caption='CVR ' datatype='real' default-format='p0.00%' name='[Calculation_1838031630901112832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( if [transaction_bool]=true and [home_loaded]=TRUE then [session_id] else null end )&#13;&#10;/COUNTD(if [home_loaded]=TRUE THEN [session_id] ELSE NULL END)' />
      </column>
      <column caption='CVR3 Vendor' datatype='real' default-format='p0.00%' name='[Calculation_1838031630903287809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [has_shop_detail_loaded]=TRUE  and [has_order]=true then  [session_id] ELSE NULL END)/&#13;&#10;COUNTD(IF [has_shop_detail_loaded]=TRUE  THEN [session_id] ELSE NULL END)' />
      </column>
      <column caption='mCVR1' datatype='real' default-format='p0.00%' name='[Calculation_1838031630962982915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF   [shop_list_loaded]=TRUE THEN [session_id] ELSE NULL END)/&#13;&#10;COUNTD(if [home_loaded]=TRUE THEN  [session_id] ELSE NULL END)' />
      </column>
      <column caption='mCVR2' datatype='real' default-format='p0.00%' name='[Calculation_1838031630966013956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF  [has_shop_detail_loaded]=TRUE THEN [session_id] ELSE NULL END) /&#13;&#10;COUNTD(IF [has_shop_list_loaded]=TRUE AND [shop_list_loaded] THEN [session_id] ELSE NULL END )' />
      </column>
      <column caption='mCVR3' datatype='real' default-format='p0.00%' name='[Calculation_1838031630976753669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_add_to_cart]=TRUE AND [checkout_loaded]=TRUE THEN [session_id] ELSE NULL END )/&#13;&#10;COUNTD(IF [has_shop_detail_loaded]=TRUE THEN [session_id] ELSE NULL END  )' />
      </column>
      <column caption='mCVR4' datatype='real' default-format='p0.00%' name='[Calculation_1838031630979977222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_order]=TRUE AND [transaction_bool]=TRUE THEN [session_id] ELSE NULL END )/&#13;&#10;COUNTD(IF [has_add_to_cart]=TRUE AND [checkout_loaded]=TRUE THEN [session_id] ELSE NULL END )' />
      </column>
      <column caption='sessions with transaction' datatype='integer' name='[Calculation_797418642418647040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [transaction_bool]=true  then [session_id]  else null end)' />
