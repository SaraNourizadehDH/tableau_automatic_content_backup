      <column caption='Fecha inicio campaña 1' datatype='date' default-format='*d/m/yy' name='[Calculation_1073545608301129733]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([campaign_start_utc])' />
      </column>
      <column caption='Fecha fin campaña 1' datatype='date' default-format='*d/m/yy' name='[Calculation_1073545608301228038]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([campaign_end_utc])' />
      </column>
      <column caption='Fecha_max_calc' datatype='date' name='[Calculation_1591178104029147136]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='WINDOW_MAX(MAX([date_utc]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ctr_calc' datatype='real' name='[Calculation_2057300651131899908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks]) / SUM([impressions])' />
      </column>
      <column caption='cvr_calc' datatype='real' name='[Calculation_2057300651132301317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([conversion]) / SUM([clicks])' />
      </column>
      <column caption='roas_eur' datatype='real' name='[Calculation_2057300651133853702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_2057300651134349319]) /SUM([ad_spend_eur]))' />
      </column>
      <column caption='sales_revenue_eur' datatype='real' name='[Calculation_2057300651134349319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([revenue_eur], [gmv_eur])' />
      </column>
      <column caption='Seleccionar_campañas' datatype='string' name='[Calculation_2108529106465234945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Seleccionar todas las campañas&quot;' />
      </column>
      <column caption='Fecha_min_filtro' datatype='date' name='[Calculation_2141180199958466560]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([date_utc])' />
      </column>
      <column caption='dia_semana' datatype='string' name='[Calculation_253890477516341248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATENAME(&apos;weekday&apos;, [date_utc])&#13;&#10;    WHEN &quot;Sunday&quot; THEN &quot;Domingo&quot;&#13;&#10;    WHEN &quot;Monday&quot; THEN &quot;Lunes&quot;&#13;&#10;    WHEN &quot;Tuesday&quot; THEN &quot;Martes&quot;&#13;&#10;    WHEN &quot;Wednesday&quot; THEN &quot;Miércoles&quot;&#13;&#10;    WHEN &quot;Thursday&quot; THEN &quot;Jueves&quot;&#13;&#10;    WHEN &quot;Friday&quot; THEN &quot;Viernes&quot;&#13;&#10;    WHEN &quot;Saturday&quot; THEN &quot;Sábado&quot;&#13;&#10;END' />
      </column>
      <column caption='Keyword' datatype='string' name='[Calculation_253890477926662154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tool_name] = &apos;Keyword search&apos; THEN [component_name] END' />
      </column>
      <column caption='dias_campaña' datatype='integer' name='[Calculation_6539437826439790618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([Calculation_1073545608301129733]), MAX([Calculation_1073545608301228038])) }' />
      </column>
      <column caption='gasto_real' datatype='real' name='[Calculation_6539437826440577052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([ad_spend_lc]) }' />
      </column>
      <column caption='ppto_diario_esperado' datatype='real' name='[Calculation_6539437826440839197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([ppto_unico_lc (copia 2)_1073545609380036621]) } / &#10;{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([Calculation_1073545608301129733]), MAX([Calculation_1073545608301228038])) }' />
      </column>
      <column caption='gasto_esperado_hoy' datatype='real' name='[Calculation_6539437826441117726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_name] : SUM([ppto_unico_lc (copia 2)_1073545609380036621])} * &#10;DATEDIFF(&#10;    &apos;day&apos;, &#10;    { FIXED [campaign_name] : MIN([Calculation_1073545608301129733]) }, &#10;    IF TODAY() &lt; { FIXED [campaign_name] : MAX([Calculation_1073545608301228038]) } &#10;    THEN TODAY() &#10;    ELSE { FIXED [campaign_name] : MAX([Calculation_1073545608301228038]) } &#10;    END&#10;) / &#10;{ FIXED [campaign_name] : DATEDIFF(&apos;day&apos;, MIN([Calculation_1073545608301129733]), MAX([Calculation_1073545608301228038])) }' />
      </column>
      <column caption='desviacion_gasto' datatype='real' name='[Calculation_6539437826442084384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ad_spend_lc]) - SUM([Calculation_6539437826441117726])) / SUM([Calculation_6539437826441117726])' />
      </column>
      <column caption='resumen_gasto' datatype='string' name='[Calculation_6539437826443386913]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM([ad_spend_lc]) - SUM([Calculation_6539437826441117726])) / SUM([Calculation_6539437826441117726]) &gt; 0.2 THEN&#10;   &quot;Por encima del gasto 🚨&quot;&#10;ELSEIF (SUM([ad_spend_lc]) - SUM([Calculation_6539437826441117726])) / SUM([Calculation_6539437826441117726]) &lt; -0.2 THEN&#10;   &quot;Por debajo del gasto ⚠️&quot;&#10;ELSE &#10;   &quot;Dentro del margen ✅&quot;&#10;END' />
      </column>
      <column caption='medida ficticia' datatype='string' name='[Calculation_830351230912794624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo4]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks]) / TOTAL(SUM([clicks]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
