        <zone forceUpdate='true' h='1060' id='233' type-v2='text' w='90059' x='2765' y='52680'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'>En caso de que la campaña haya contado con múltiples formatos, este apartado detalla su desempeño en función de las métricas establecidas</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='1360' id='234' type-v2='text' w='86118' x='4176' y='59920'>
