                <zone forceUpdate='true' h='2071' id='219' type-v2='text' w='29667' x='3533' y='39643'>
                  <formatted-text>
                    <run fontcolor='#555555'>Puedes elegir solo las campañas que cumplen  cierto objetivo del Funnel</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
