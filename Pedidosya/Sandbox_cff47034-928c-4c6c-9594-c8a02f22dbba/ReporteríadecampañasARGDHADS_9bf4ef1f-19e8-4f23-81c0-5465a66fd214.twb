        <zone h='5360' id='207' name='Detalle por formato' show-title='false' w='95375' x='1438' y='53740' />
        <zone h='19660' id='208' name='Detalle de productos' show-title='false' w='95471' x='1235' y='61540' />
        <zone forceUpdate='true' h='1225' id='211' type-v2='text' w='98750' x='875' y='2800'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='18'>RESULTADOS DE CAMPAÑAS</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
