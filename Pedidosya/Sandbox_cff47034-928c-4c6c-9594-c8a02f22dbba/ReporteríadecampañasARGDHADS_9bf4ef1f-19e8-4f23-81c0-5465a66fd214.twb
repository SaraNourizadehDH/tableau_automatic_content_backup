        <zone h='6080' id='215' name='evolucion economics' w='60000' x='38563' y='23360' />
        <zone h='1240' id='216' leg-item-layout='horz' name='evolucion economics' pane-specification-id='1' param='[federated.0vt4jip09r6c1d1an75wg13azhsa].[:Measure Names]' show-title='false' type-v2='color' w='17500' x='63500' y='29600' />
        <zone forceUpdate='true' h='2960' id='224' type-v2='text' w='35412' x='1588' y='18620'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'>Esta sección resume los KPIs más relevantes según el objetivo de la campaña:</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'>impresiones para medir la visibilidad, clics y CTR para evaluar la interacción, y órdenes y CVR para analizar la conversión.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='2560' id='225' type-v2='text' w='35706' x='1882' y='27700'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'>Aquí se presentan los resultados económicos de la campaña,</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'> incluyendo ROAS, revenuE, presupuesto asignado, gasto real y el porcentaje de presupuesto efectivamente utilizado. </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='10'>Todas las variables monetarias se encuentran en moneda local.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='1100' id='232' type-v2='text' w='98063' x='-625' y='51860'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>Detalle por formato</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
