    <worksheet name='evolucion parametro economics'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='2' fontcolor='#555555' fontname='Tableau Bold' fontsize='11'>Evolución de métricas</run>
            <run fontalignment='2'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='media_performance_argentina_tableau (automated_tables_reports)' name='federated.090od5o0h30qol160pkhd00kla8x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='sales revenue (lc)' caption='Métricas economics' datatype='string' name='[Métricas interacción (copia)_4905264458520391682]' param-domain-type='list' role='measure' type='nominal' value='&quot;sales_revenue_lc&quot;'>
              <calculation class='tableau' formula='&quot;sales_revenue_lc&quot;' />
              <aliases>
                <alias key='&quot;gasto_lc&quot;' value='gasto (lc)' />
                <alias key='&quot;ppto_unico&quot;' value='presupuesto (lc)' />
                <alias key='&quot;ppto-gasto_lc&quot;' value='presupuesto - gasto (lc)' />
                <alias key='&quot;sales_revenue_lc&quot;' value='sales revenue (lc)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.090od5o0h30qol160pkhd00kla8x'>
            <column caption='Campañas' datatype='string' name='[Calculation_1400338065813954561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seleccionar todas las campañas del periodo&quot;' />
            </column>
            <column caption='sales_revenue_lc' datatype='real' name='[Calculation_1495195117413605376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([revenue_lc], [gmv_lc])' />
            </column>
            <column caption='Fecha inicio' datatype='string' name='[Calculation_2350034642247864321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_start_utc]))' />
            </column>
            <column caption='ppto_unico_lc' datatype='real' name='[Calculation_4905264458483716096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id] : MIN([budget_lc]) }' />
            </column>
            <column caption='Fecha fin' datatype='string' name='[Fecha_inicio_campaña (copia)_2350034642248024066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([campaign_end_utc]))' />
            </column>
            <column caption='Métrica dinámica economics' datatype='real' name='[Métrica dinámica interacción (copia)_4905264458521030659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Métricas interacción (copia)_4905264458520391682]&#13;&#10;    WHEN &quot;sales_revenue_lc&quot; THEN SUM([Calculation_1495195117413605376])&#13;&#10;    WHEN &quot;gasto_lc&quot; THEN SUM([ad_spend_lc])&#13;&#10;    WHEN &quot;ppto_unico&quot; THEN SUM([Calculation_4905264458483716096])&#13;&#10;    WHEN &quot;ppto-gasto_lc&quot; THEN ([Presupuesto - gasto (lc) (copia)_4905264458516312065])&#13;&#10;END' />
            </column>
