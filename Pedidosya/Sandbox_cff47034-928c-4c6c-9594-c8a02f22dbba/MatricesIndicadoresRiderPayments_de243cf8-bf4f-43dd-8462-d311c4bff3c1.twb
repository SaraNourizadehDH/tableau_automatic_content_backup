              <calculation class='tableau' formula='if [Calculation_1048494290015203328] &lt;= [Parameters].[Parameter 1] then&#13;&#10;    &#13;&#10;    if [Calculation_1048494290015297537] &gt;= [Parameters].[Rango SA 1 (copy)_1061160668901085185] then &quot;A&quot;&#13;&#10;    ELSEIF [Calculation_1048494290015297537] &gt;= [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;B&quot;&#13;&#10;    ELSE &quot;C&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSEIF [Calculation_1048494290015203328] &lt;= [Parameters].[Rango SA 1 (copy)_1061160668901036032] then&#13;&#10;&#13;&#10;    if [Calculation_1048494290015297537] &gt;= [Parameters].[Rango SA 1 (copy)_1061160668901085185] then &quot;D&quot;&#13;&#10;    ELSEIF [Calculation_1048494290015297537] &gt;= [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;E&quot;&#13;&#10;    ELSE &quot;F&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    if [Calculation_1048494290015297537] &gt;= [Parameters].[Rango SA 1 (copy)_1061160668901085185] then &quot;G&quot;&#13;&#10;    ELSEIF [Calculation_1048494290015297537] &gt;= [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;H&quot;&#13;&#10;    ELSEif [Calculation_1048494290015297537] &lt; [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;I&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;end' />
