      <table>
        <view>
          <datasources>
            <datasource caption='cpo_sa_fill (user_felipe_aguayo)' name='federated.0x2e30c1e6hj181cvl4b70y4gecb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Rango SA 1' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='0.04'>
              <calculation class='tableau' formula='0.04' />
            </column>
            <column caption='Vista Bucket/Hora' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hora&quot;'>
              <calculation class='tableau' formula='&quot;Hora&quot;' />
            </column>
            <column caption='Rango CPH 2' datatype='real' name='[Rango CPH 1 (copy)_1061160668906459144]' param-domain-type='any' role='measure' type='quantitative' value='5000.'>
              <calculation class='tableau' formula='5000.' />
            </column>
            <column caption='Rango Fill R 2' datatype='real' name='[Rango Fill R 1 (copy)_1061160668901208067]' param-domain-type='any' role='measure' type='quantitative' value='0.90'>
              <calculation class='tableau' formula='0.90' />
            </column>
            <column caption='Rango SA 2' datatype='real' name='[Rango SA 1 (copy)_1061160668901036032]' param-domain-type='any' role='measure' type='quantitative' value='0.09'>
              <calculation class='tableau' formula='0.09' />
            </column>
            <column caption='Rango Fill R 1' datatype='real' name='[Rango SA 1 (copy)_1061160668901085185]' param-domain-type='any' role='measure' type='quantitative' value='0.95'>
              <calculation class='tableau' formula='0.95' />
            </column>
            <column caption='Rango UTR 1' datatype='real' name='[Rango SA 1 (copy)_1061160668906229765]' param-domain-type='any' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
            </column>
            <column caption='Rango UTR 2' datatype='real' name='[Rango UTR 1 (copy)_1061160668906315782]' param-domain-type='any' role='measure' type='quantitative' value='2.5'>
              <calculation class='tableau' formula='2.5' />
            </column>
            <column caption='Rango CPH 1' datatype='real' name='[Rango UTR 1 (copy)_1061160668906364935]' param-domain-type='any' role='measure' type='quantitative' value='4000.'>
              <calculation class='tableau' formula='4000.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2e30c1e6hj181cvl4b70y4gecb'>
            <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO (copy)_1048494290039726084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pago_total])/sum([wh])' />
            </column>
            <column caption='Caso UTR CPH' datatype='string' name='[Calculation1 (copy)_1061160668906524681]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1048494290038992898] &lt;= [Parameters].[Rango SA 1 (copy)_1061160668906229765] then&#13;&#10;    &#13;&#10;    if [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906364935] then &quot;1&quot;&#13;&#10;    ELSEIF [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango CPH 1 (copy)_1061160668906459144] then &quot;2&quot;&#13;&#10;    ELSE &quot;3&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSEIF [Calculation_1048494290038992898] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906315782] then&#13;&#10;&#13;&#10;    if [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906364935] then &quot;4&quot;&#13;&#10;    ELSEIF [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango CPH 1 (copy)_1061160668906459144] then &quot;5&quot;&#13;&#10;    ELSE &quot;6&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    if [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906364935] then &quot;7&quot;&#13;&#10;    ELSEIF [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango CPH 1 (copy)_1061160668906459144] then &quot;8&quot;&#13;&#10;    ELSE &quot;9&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='%SA' datatype='real' default-format='p0.0%' name='[Calculation_1048494290015203328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sa_orders_num])/sum([sa_orders_den])' />
            </column>
            <column caption='%Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_1048494290015297537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sh])/sum([osh])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1048494290038992898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([co])/sum([wh])' />
            </column>
            <column caption='Promedio Semanal Ord.' datatype='real' name='[Calculation_1048494290083098633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg({ INCLUDE [week] : sum([co])})' />
            </column>
            <column caption='Caso SA FillR' datatype='string' name='[Calculation_1061160668901273604]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1048494290015203328] &lt;= [Parameters].[Parameter 1] then&#13;&#10;    &#13;&#10;    if [Calculation_1048494290015297537] &gt;= [Parameters].[Rango SA 1 (copy)_1061160668901085185] then &quot;A&quot;&#13;&#10;    ELSEIF [Calculation_1048494290015297537] &gt;= [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;B&quot;&#13;&#10;    ELSE &quot;C&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSEIF [Calculation_1048494290015203328] &lt;= [Parameters].[Rango SA 1 (copy)_1061160668901036032] then&#13;&#10;&#13;&#10;    if [Calculation_1048494290015297537] &gt;= [Parameters].[Rango SA 1 (copy)_1061160668901085185] then &quot;D&quot;&#13;&#10;    ELSEIF [Calculation_1048494290015297537] &gt;= [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;E&quot;&#13;&#10;    ELSE &quot;F&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    if [Calculation_1048494290015297537] &gt;= [Parameters].[Rango SA 1 (copy)_1061160668901085185] then &quot;G&quot;&#13;&#10;    ELSEIF [Calculation_1048494290015297537] &gt;= [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;H&quot;&#13;&#10;    ELSEif [Calculation_1048494290015297537] &lt; [Parameters].[Rango Fill R 1 (copy)_1061160668901208067] then &quot;I&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_1061160668930719754]' role='measure' type='nominal'>
              <calculation class='tableau' formula='str([Calculation_1061160668901273604])+str([Calculation1 (copy)_1061160668906524681])' />
            </column>
            <column caption='Calculation2' datatype='string' name='[Calculation_1061160668979003403]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if left([Calculation_1061160668930719754] ,1) in (&apos;A&apos;,&apos;B&apos;,&apos;C&apos;) then &quot;SA OK&quot;&#13;&#10;&#13;&#10;elseif [Calculation_1061160668930719754] in (&quot;I9&quot;&#13;&#10;,&quot;G9&quot;&#13;&#10;,&quot;H9&quot;&#13;&#10;,&quot;I5&quot;&#13;&#10;,&quot;I6&quot;&#13;&#10;,&quot;G5&quot;&#13;&#10;,&quot;I1&quot;&#13;&#10;,&quot;G8&quot;&#13;&#10;,&quot;G1&quot;&#13;&#10;,&quot;I8&quot;&#13;&#10;,&quot;D9&quot;&#13;&#10;,&quot;G4&quot;&#13;&#10;,&quot;I4&quot;&#13;&#10;,&quot;G6&quot;&#13;&#10;,&quot;D1&quot;&#13;&#10;,&quot;I3&quot;&#13;&#10;,&quot;D5&quot;&#13;&#10;,&quot;H5&quot;)&#13;&#10;then &quot;80&quot; elseIF &#13;&#10;[Calculation_1061160668930719754] in (&quot;H8&quot;&#13;&#10;,&quot;F9&quot;&#13;&#10;,&quot;I2&quot;&#13;&#10;,&quot;H6&quot;&#13;&#10;,&quot;H1&quot;&#13;&#10;,&quot;D8&quot;&#13;&#10;,&quot;G2&quot;&#13;&#10;,&quot;H4&quot;) then &quot;80-90&quot;&#13;&#10;else &quot;Rest&quot; end' />
            </column>
            <column caption='Bucket/ hora' datatype='string' name='[Calculation_133419153784885250]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#13;&#10;when &quot;Bucket&quot; then [Calculation_379146807851425792]&#13;&#10;when &quot;Hora&quot; then str([hour])&#13;&#10;else str([hour])&#13;&#10;end' />
            </column>
            <column caption='Buckets' datatype='string' name='[Calculation_379146807851425792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [hour] &lt; 3 then &quot;1_night&quot; &#13;&#10;elseif [hour] &lt; 7 then &quot;2_offpeak&quot; &#13;&#10;elseif [hour] &lt; 12 then &quot;3_breakfast&quot; &#13;&#10;elseif [hour] &lt; 15 then &quot;4_lunch&quot; &#13;&#10;elseif [hour] &lt; 19 then &quot;5_afternoon&quot; &#13;&#10;elseif [hour] &lt; 22 then &quot;6_dinner&quot; &#13;&#10;else &quot;7_postdinner&quot;&#13;&#10;end' />
            </column>
