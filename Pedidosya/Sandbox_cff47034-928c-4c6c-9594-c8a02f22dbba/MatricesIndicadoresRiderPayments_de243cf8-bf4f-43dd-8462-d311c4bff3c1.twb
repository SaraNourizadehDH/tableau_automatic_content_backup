          <datasource-dependencies datasource='federated.0x2e30c1e6hj181cvl4b70y4gecb'>
            <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO (copy)_1048494290039726084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pago_total])/sum([wh])' />
            </column>
            <column caption='%SA' datatype='real' default-format='p0.0%' name='[Calculation_1048494290015203328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sa_orders_num])/sum([sa_orders_den])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1048494290038992898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([co])/sum([wh])' />
            </column>
            <column caption='CPO' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_1048494290039668739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pago_total])/sum([co])' />
            </column>
            <column caption='Segmentos RM 2025.05' datatype='string' name='[Calculation_3013471108447260672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [zone_name]&#13;&#10;when &quot;Lo barnechea&quot; then &quot;Segmento 1&quot;&#13;&#10;when &quot;Vitacura - las condes&quot; then &quot;Segmento 1&quot;&#13;&#10;when &quot;Manquehue&quot; then &quot;Segmento 1&quot;&#13;&#10;when &quot;Chicureo&quot; then &quot;Segmento 1&quot;&#13;&#10;when &quot;Bellavista_centro&quot; then &quot;Segmento 1&quot;&#13;&#10;&#13;&#10;when &quot;Padre hurtado&quot; then &quot;Segmento 2&quot;&#13;&#10;when &quot;Comuna maipu&quot; then &quot;Segmento 2&quot;&#13;&#10;when &quot;Quinta normal&quot; then &quot;Segmento 2&quot;&#13;&#10;when &quot;Peñalolen&quot; then &quot;Segmento 2&quot;&#13;&#10;when &quot;Recoleta independencia&quot; then &quot;Segmento 2&quot;&#13;&#10;&#13;&#10;when &quot;Santiago sur&quot; then &quot;Segmento 4 (Stgo Sur)&quot;&#13;&#10;when &quot;Puente alto&quot; then &quot;Segmento 4 (Stgo Sur)&quot;&#13;&#10;when &quot;San bernardo&quot; then &quot;Segmento 4 (Stgo Sur)&quot;&#13;&#10;when &quot;La florida&quot; then &quot;Segmento 4 (Stgo Sur)&quot;&#13;&#10;when &quot;La pintana&quot; then &quot;Segmento 4 (Stgo Sur)&quot;&#13;&#10;&#13;&#10;when &quot;San miguel&quot; then &quot;Segmento 3&quot;&#13;&#10;when &quot;Quilicura-huechuraba&quot; then &quot;Segmento 3&quot;&#13;&#10;when &quot;Conchali&quot; then &quot;Segmento 3&quot;&#13;&#10;when &quot;Estación central bicicleta&quot; then &quot;Segmento 3&quot;&#13;&#10;when &quot;Cerro navia&quot; then &quot;Segmento 3&quot;&#13;&#10;when &quot;Cerrillos&quot; then &quot;Segmento 3&quot;&#13;&#10;when &quot;Nuevo colina&quot; then &quot;Segmento 3&quot;&#13;&#10;else &quot;otro&quot;&#13;&#10;end' />
              <aliases>
                <alias key='&quot;Segmento 4 (Stgo Sur)&quot;' value='Segmento 4' />
              </aliases>
            </column>
            <column caption='Buckets' datatype='string' name='[Calculation_379146807851425792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [hour] &lt; 3 then &quot;1_night&quot; &#13;&#10;elseif [hour] &lt; 7 then &quot;2_offpeak&quot; &#13;&#10;elseif [hour] &lt; 12 then &quot;3_breakfast&quot; &#13;&#10;elseif [hour] &lt; 15 then &quot;4_lunch&quot; &#13;&#10;elseif [hour] &lt; 19 then &quot;5_afternoon&quot; &#13;&#10;elseif [hour] &lt; 22 then &quot;6_dinner&quot; &#13;&#10;else &quot;7_postdinner&quot;&#13;&#10;end' />
            </column>
