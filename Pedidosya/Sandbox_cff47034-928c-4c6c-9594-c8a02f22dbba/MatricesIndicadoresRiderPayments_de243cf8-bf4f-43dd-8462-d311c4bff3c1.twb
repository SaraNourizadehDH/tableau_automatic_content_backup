      <aliases enabled='yes' />
      <column caption='%Ineficiencia' datatype='real' default-format='p0.0%' name='[%Fill Rate (copy)_2246170340764037120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(sum([wh])/sum([sh]))' />
      </column>
      <column caption='%SA (bucket)' datatype='real' default-format='p0.0%' name='[%SA (Zona) (copy)_3013471108451479553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sa_orders_num])/sum({ EXCLUDE [Calculation_379146807851425792]: SUM([sa_orders_den])})' />
      </column>
      <column caption='%SA (Zona)' datatype='real' default-format='p0.0%' name='[%SA (copy)_2689774881985388545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sa_orders_num])/sum({ EXCLUDE [zone_name]: SUM([sa_orders_den])})' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0x2e30c1e6hj181cvl4b70y4gecb].[sum:co:qk]&quot;' value='Confirmed Orders' />
        </aliases>
      </column>
      <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO (copy)_1048494290039726084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pago_total])/sum([wh])' />
      </column>
      <column caption='CPO Quest' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO (copy)_1048494290054418438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pago_quest])/sum([co])' />
      </column>
      <column caption='CPO (sin quest)' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO (copy)_1151795613929705472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([pago_total])-sum([pago_quest]))/sum([co])' />
      </column>
      <column caption='CPO (%Base)' datatype='real' default-format='p0.0%' name='[CPO (copy)_133419153749270529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([pago_total])/sum([co])-[Parameters].[Parameter 2])/[Parameters].[Parameter 2]' />
      </column>
      <column caption='CPO PU+DO+km' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO Quest (copy)_1048494290057293832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pago_pu_do_km])/sum([co])' />
      </column>
      <column caption='Caso UTR CPH' datatype='string' name='[Calculation1 (copy)_1061160668906524681]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1048494290038992898] &lt;= [Parameters].[Rango SA 1 (copy)_1061160668906229765] then&#13;&#10;    &#13;&#10;    if [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906364935] then &quot;1&quot;&#13;&#10;    ELSEIF [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango CPH 1 (copy)_1061160668906459144] then &quot;2&quot;&#13;&#10;    ELSE &quot;3&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSEIF [Calculation_1048494290038992898] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906315782] then&#13;&#10;&#13;&#10;    if [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906364935] then &quot;4&quot;&#13;&#10;    ELSEIF [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango CPH 1 (copy)_1061160668906459144] then &quot;5&quot;&#13;&#10;    ELSE &quot;6&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    if [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango UTR 1 (copy)_1061160668906364935] then &quot;7&quot;&#13;&#10;    ELSEIF [CPO (copy)_1048494290039726084] &lt;= [Parameters].[Rango CPH 1 (copy)_1061160668906459144] then &quot;8&quot;&#13;&#10;    ELSE &quot;9&quot;&#13;&#10;    End&#13;&#10;&#13;&#10;end' />
      </column>
      <column caption='%SA' datatype='real' default-format='p0.0%' name='[Calculation_1048494290015203328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sa_orders_num])/sum([sa_orders_den])' />
      </column>
      <column caption='%Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_1048494290015297537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sh])/sum([osh])' />
      </column>
      <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1048494290038992898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([co])/sum([wh])' />
      </column>
      <column caption='CPO' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_1048494290039668739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pago_total])/sum([co])' />
      </column>
      <column caption='Semana Peak-Valle' datatype='string' name='[Calculation_1048494290053033989]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&quot;iso-week&quot;, [registered_date]) &#13;&#10;    in (39, 40, 36, 35, 45) then &quot;Peak&quot; &#13;&#10;&#13;&#10;ELSEIF datepart(&quot;iso-week&quot;, [registered_date]) &#13;&#10;    in (38, 44) then &quot;Otro&quot; &#13;&#10;&#13;&#10;else &quot;Valle&quot;&#13;&#10;end' />
      </column>
      <column caption='Promedio Semanal Ord.' datatype='real' name='[Calculation_1048494290083098633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({ INCLUDE [week] : sum([co])})' />
