              <calculation class='tableau' formula='0.90' />
            </column>
            <column caption='Rango SA 2' datatype='real' name='[Rango SA 1 (copy)_1061160668901036032]' param-domain-type='any' role='measure' type='quantitative' value='0.09'>
              <calculation class='tableau' formula='0.09' />
