      <table>
        <view>
          <datasources>
            <datasource caption='cpo_sa_fill (user_felipe_aguayo)' name='federated.0x2e30c1e6hj181cvl4b70y4gecb' />
          </datasources>
          <datasource-dependencies datasource='federated.0x2e30c1e6hj181cvl4b70y4gecb'>
            <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO (copy)_1048494290039726084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pago_total])/sum([wh])' />
            </column>
            <column caption='CPO Quest' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO (copy)_1048494290054418438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pago_quest])/sum([co])' />
            </column>
            <column caption='CPO PU+DO+km' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[CPO Quest (copy)_1048494290057293832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pago_pu_do_km])/sum([co])' />
            </column>
            <column caption='%SA' datatype='real' default-format='p0.0%' name='[Calculation_1048494290015203328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sa_orders_num])/sum([sa_orders_den])' />
            </column>
            <column caption='%Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_1048494290015297537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sh])/sum([osh])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1048494290038992898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([co])/sum([wh])' />
            </column>
            <column caption='CPO' datatype='real' default-format='c&quot;$&quot;#,##0;&quot;$&quot;-#,##0' name='[Calculation_1048494290039668739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pago_total])/sum([co])' />
            </column>
            <column caption='Semana Peak-Valle' datatype='string' name='[Calculation_1048494290053033989]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datepart(&quot;iso-week&quot;, [registered_date]) &#13;&#10;    in (39, 40, 36, 35, 45) then &quot;Peak&quot; &#13;&#10;&#13;&#10;ELSEIF datepart(&quot;iso-week&quot;, [registered_date]) &#13;&#10;    in (38, 44) then &quot;Otro&quot; &#13;&#10;&#13;&#10;else &quot;Valle&quot;&#13;&#10;end' />
            </column>
