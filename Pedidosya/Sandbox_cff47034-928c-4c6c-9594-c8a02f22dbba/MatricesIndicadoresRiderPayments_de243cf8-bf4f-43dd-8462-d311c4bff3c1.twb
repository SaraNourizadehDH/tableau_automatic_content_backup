              <calculation class='tableau' formula='if left([Calculation_1061160668930719754] ,1) in (&apos;A&apos;,&apos;B&apos;,&apos;C&apos;) then &quot;SA OK&quot;&#13;&#10;&#13;&#10;elseif [Calculation_1061160668930719754] in (&quot;I9&quot;&#13;&#10;,&quot;G9&quot;&#13;&#10;,&quot;H9&quot;&#13;&#10;,&quot;I5&quot;&#13;&#10;,&quot;I6&quot;&#13;&#10;,&quot;G5&quot;&#13;&#10;,&quot;I1&quot;&#13;&#10;,&quot;G8&quot;&#13;&#10;,&quot;G1&quot;&#13;&#10;,&quot;I8&quot;&#13;&#10;,&quot;D9&quot;&#13;&#10;,&quot;G4&quot;&#13;&#10;,&quot;I4&quot;&#13;&#10;,&quot;G6&quot;&#13;&#10;,&quot;D1&quot;&#13;&#10;,&quot;I3&quot;&#13;&#10;,&quot;D5&quot;&#13;&#10;,&quot;H5&quot;)&#13;&#10;then &quot;80&quot; elseIF &#13;&#10;[Calculation_1061160668930719754] in (&quot;H8&quot;&#13;&#10;,&quot;F9&quot;&#13;&#10;,&quot;I2&quot;&#13;&#10;,&quot;H6&quot;&#13;&#10;,&quot;H1&quot;&#13;&#10;,&quot;D8&quot;&#13;&#10;,&quot;G2&quot;&#13;&#10;,&quot;H4&quot;) then &quot;80-90&quot;&#13;&#10;else &quot;Rest&quot; end' />
