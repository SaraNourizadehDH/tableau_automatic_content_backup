            <column caption='Rango UTR 2' datatype='real' name='[Rango UTR 1 (copy)_1061160668906315782]' param-domain-type='any' role='measure' type='quantitative' value='2.5'>
              <calculation class='tableau' formula='2.5' />
            </column>
            <column caption='Rango CPH 1' datatype='real' name='[Rango UTR 1 (copy)_1061160668906364935]' param-domain-type='any' role='measure' type='quantitative' value='4000.'>
