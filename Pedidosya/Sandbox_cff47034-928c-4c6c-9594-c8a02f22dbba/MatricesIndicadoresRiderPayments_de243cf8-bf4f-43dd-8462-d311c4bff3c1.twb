            </column>
            <column caption='Buckets' datatype='string' name='[Calculation_379146807851425792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [hour] &lt; 3 then &quot;1_night&quot; &#13;&#10;elseif [hour] &lt; 7 then &quot;2_offpeak&quot; &#13;&#10;elseif [hour] &lt; 12 then &quot;3_breakfast&quot; &#13;&#10;elseif [hour] &lt; 15 then &quot;4_lunch&quot; &#13;&#10;elseif [hour] &lt; 19 then &quot;5_afternoon&quot; &#13;&#10;elseif [hour] &lt; 22 then &quot;6_dinner&quot; &#13;&#10;else &quot;7_postdinner&quot;&#13;&#10;end' />
