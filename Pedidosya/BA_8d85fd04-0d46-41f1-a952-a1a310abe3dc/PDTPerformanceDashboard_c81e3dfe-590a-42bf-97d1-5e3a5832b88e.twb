      <aliases enabled='yes' />
      <column caption='Avg User Facing max Promise' datatype='real' name='[Calculation_108719740210122752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([max_minutes_times_orders])/SUM([orders])' />
      </column>
      <column caption='% DT &gt; 45' datatype='real' default-format='p0.0%' name='[Calculation_3184326471789260800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-SUM([orders_less_than_45])/SUM([orders])' />
      </column>
      <column caption='% OL &gt; 10 min' datatype='real' default-format='p0.0%' name='[Calculation_3184326471789502465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_late_10])/SUM([orders])' />
      </column>
      <column caption='Last 20 records' datatype='boolean' name='[Calculation_4186377396008198144]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()&lt;21'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Today' datatype='boolean' name='[Calculation_4186377396008341505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [order_date] = TODAY() then true else false end' />
      </column>
      <column caption='PDT Performance' datatype='string' name='[Calculation_4186377396010147842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [pdt_performance_vs_bucket] = &quot;20+ min early&quot; or [pdt_performance_vs_bucket] = &quot;10-20 min early&quot;&#10;    or [pdt_performance_vs_bucket] = &quot;&lt; 10 min early&quot; then &quot;Early&quot;&#10;elseif [pdt_performance_vs_bucket] = &quot;On Time&quot; then &quot;On Time&quot;&#10;elseif [pdt_performance_vs_bucket] = &quot;20+ min late&quot; or [pdt_performance_vs_bucket] = &quot;10-20 min late&quot;&#10;    or [pdt_performance_vs_bucket] = &quot;&lt; 10 min late&quot; then &quot;Late&quot; else null end' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_4217058168474427393]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;Day&quot; then [order_date]&#10;elseif [Parameters].[Parameter 1] = &quot;Week&quot; then DATETRUNC(&apos;week&apos;,[order_date])&#10;elseif [Parameters].[Parameter 1] = &quot;Month&quot; then DATETRUNC(&apos;month&apos;,[order_date])&#10;elseif [Parameters].[Parameter 1] = &quot;Quarter&quot; then DATETRUNC(&apos;quarter&apos;,[order_date])&#10;end' />
      </column>
      <column caption='Avg TES PDT' datatype='real' name='[Calculation_4217058168476364803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tes_pdt_times_orders])/SUM([orders])/60' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_4217058168476852228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_times_orders])/SUM([orders])/60' />
      </column>
      <column caption='TES Order Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_4217058168477483013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [tes_pdt_performance] = &quot;TES late &gt; 10&quot; then [orders] else 0 end)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='Abs PDT Deviation' datatype='real' name='[Calculation_5218475715387514880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='abs([Calculation_4217058168476364803] - [Calculation_4217058168476852228])' />
      </column>
      <column caption='Last 10' datatype='boolean' name='[Last 20 records (copy)_4217058168482258952]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()&lt;11'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='TES Order Early &gt; 10 ' datatype='real' default-format='p0.0%' name='[TES Order Late &gt; 10 (copy)_4217058168477822982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [tes_pdt_performance] = &quot;TES early &gt; 10&quot; then [orders] else 0 end)&#10;/&#10;SUM([orders])' />
      </column>
