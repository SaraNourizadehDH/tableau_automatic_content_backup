      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='PDT Performance last 9 months' id='_C19B574C322E498FAD43532162581B8E'>
            <properties context=''>
              <relation connection='bigquery.0zyqrlh0ffqzbm1b7pww70t6pwf7' name='Custom SQL Query' type='text'><![CDATA[select 
order_date
, country_code
, vertical_type
, case when actual_delivery_time << (pdt_min_minutes - 20)*60 then "20+ min early"
    when actual_delivery_time >>= (pdt_min_minutes - 20)*60 and actual_delivery_time << (pdt_min_minutes - 10)*60 then "10-20 min early"
    when actual_delivery_time >>= (pdt_min_minutes - 10)*60 and actual_delivery_time << pdt_min_minutes*60 then "<< 10 min early"
    when actual_delivery_time >>= (pdt_min_minutes)*60 and actual_delivery_time <<= pdt_max_minutes*60 then "On Time"
    when actual_delivery_time >> (pdt_max_minutes)*60 and actual_delivery_time << (pdt_max_minutes + 10)*60 then "<< 10 min late"
    when actual_delivery_time >>= (pdt_max_minutes + 10)*60 and actual_delivery_time << (pdt_max_minutes + 20)*60 then "10-20 min late"
    when actual_delivery_time >>= (pdt_max_minutes + 20)*60 then "20+ min late" end pdt_performance_vs_bucket
, case when actual_delivery_time << tes_pdt - 10*60 then "TES early >> 10"
    when actual_delivery_time >> tes_pdt + 10*60 then "TES late >> 10" else "Within TES +/- 10min" end tes_pdt_performance
, sum(orders) orders
, sum(case when actual_delivery_time/60 << 45 then orders else 0 end) orders_less_than_45
, sum(case when actual_delivery_time >>= (pdt_max_minutes + 10)*60 then orders else 0 end) orders_late_10
, sum(pdt_max_minutes*orders) max_minutes_times_orders
, sum(tes_pdt*orders) tes_pdt_times_orders
, sum(actual_delivery_time*orders) delivery_time_times_orders
from `peya-delivery-and-support.automated_tables_reports.pdt_performance_v2`
where order_date >>= date_add(current_date, interval -1 year)
and order_state = "confirmed"
and is_preorder = false 

group by 1,2,3,4,5
order by 7 desc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
