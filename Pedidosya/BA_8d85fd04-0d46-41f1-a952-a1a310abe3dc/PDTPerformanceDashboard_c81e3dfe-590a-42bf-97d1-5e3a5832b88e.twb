      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Experience Data' id='_693E383AD78B4AF59D5A6B094A2821C9'>
            <properties context=''>
              <relation connection='bigquery.0mfcjxw1xx8v5m1ccnefd1szuxsh' name='Custom SQL Query' type='text'><![CDATA[with sr as
(
    select
    ag.order_id order_id
	, count(distinct ag.session_id) helpcenter_sessions
    , count(distinct case when level3='Check order status' or level3='Complain about late order' then session_id else null end) as related_sessions_sr
	
    from `peya-delivery-and-support.automated_tables_reports.helpcenter_sessions` ag 
	where created_date >>= date_add(current_date, interval -1 year)
	and ag.order_id is not null
	group by 1
),

o as
(
    select 
    cast(o.id as string) order_id
    , date(registeredDate) order_date
    , lower(c.iso_code_2) AS country_name
    , dlo.vendor.vertical_type AS business_type
    , lower(o.state) AS order_state
    , case when rm.global_code in ("LATE_DELIVERY", "DELIVERY_ETA_TOO_LONG") then "PDT Related" else "Other" end fail_rate_pdt_related

    from `peya-data-origins-pro.cl_core.orders` o 
    left join `peya-data-origins-pro.cl_core.reject_message` as rm ON o.rejectMessage.id = rm.id
    left join `peya-data-origins-pro.cl_core.country_details` c on c.country_id = o.restaurant.country.id
    left join `peya-bi-tools-pro.il_logistics.fact_logistic_orders` dlo on dlo.platform_order_code = cast(o.id as string) and date(created_date_local) >>= date_add(current_date, interval -1 year)
    where date(registeredDate) >>= date_add(current_date, interval -1 year)
    and withLogistics
)

select 
country_name 
, order_date 
, business_type vertical_type
, count(distinct o.order_id) total_orders
, count(distinct case when order_state <<>> "confirmed" then o.order_id else null end) failed_orders
, count(distinct case when order_state <<>> "confirmed" and fail_rate_pdt_related = "PDT Related" then o.order_id else null end) pdt_related_failed_orders
, sum(helpcenter_sessions) helpcenter_sessions
, sum(related_sessions_sr) related_sessions_sr

from o left join sr on o.order_id = sr.order_id
group by 1,2,3]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='PDT Performance' inline='true' name='federated.0yv3kdg05kai35112ffbm0w8eqra' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0zyqrlh0ffqzbm1b7pww70t6pwf7'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_matias_aresti' server='' server-oauth='' username='matias.aresti@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='BigQuery (2)' name='bigquery.1vl1y5k0r91vu11dtnu2b04e3xza'>
            <connection CATALOG='publicdata' EXECCATALOG='' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='' schema='' server='' server-oauth='' username='matias.aresti@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0zyqrlh0ffqzbm1b7pww70t6pwf7' name='Custom SQL Query' type='text'><![CDATA[select 
order_date
, country_code
, vertical_type
, case when actual_delivery_time << (pdt_min_minutes - 20)*60 then "20+ min early"
    when actual_delivery_time >>= (pdt_min_minutes - 20)*60 and actual_delivery_time << (pdt_min_minutes - 10)*60 then "10-20 min early"
    when actual_delivery_time >>= (pdt_min_minutes - 10)*60 and actual_delivery_time << pdt_min_minutes*60 then "<< 10 min early"
    when actual_delivery_time >>= (pdt_min_minutes)*60 and actual_delivery_time <<= pdt_max_minutes*60 then "On Time"
    when actual_delivery_time >> (pdt_max_minutes)*60 and actual_delivery_time << (pdt_max_minutes + 10)*60 then "<< 10 min late"
    when actual_delivery_time >>= (pdt_max_minutes + 10)*60 and actual_delivery_time << (pdt_max_minutes + 20)*60 then "10-20 min late"
    when actual_delivery_time >>= (pdt_max_minutes + 20)*60 then "20+ min late" end pdt_performance_vs_bucket
, case when actual_delivery_time << tes_pdt - 10*60 then "TES early >> 10"
    when actual_delivery_time >> tes_pdt + 10*60 then "TES late >> 10" else "Within TES +/- 10min" end tes_pdt_performance
, sum(orders) orders
, sum(case when actual_delivery_time/60 << 45 then orders else 0 end) orders_less_than_45
, sum(case when actual_delivery_time >>= (pdt_max_minutes + 10)*60 then orders else 0 end) orders_late_10
, sum(pdt_max_minutes*orders) max_minutes_times_orders
, sum(tes_pdt*orders) tes_pdt_times_orders
, sum(actual_delivery_time*orders) delivery_time_times_orders
from `peya-delivery-and-support.automated_tables_reports.pdt_performance_v2`
where order_date >>= date_add(current_date, interval -1 year)
and order_state = "confirmed"
and is_preorder = false 

group by 1,2,3,4,5
order by 7 desc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0zyqrlh0ffqzbm1b7pww70t6pwf7' name='Custom SQL Query' type='text'><![CDATA[select 
order_date
, country_code
, vertical_type
, case when actual_delivery_time << (pdt_min_minutes - 20)*60 then "20+ min early"
    when actual_delivery_time >>= (pdt_min_minutes - 20)*60 and actual_delivery_time << (pdt_min_minutes - 10)*60 then "10-20 min early"
    when actual_delivery_time >>= (pdt_min_minutes - 10)*60 and actual_delivery_time << pdt_min_minutes*60 then "<< 10 min early"
    when actual_delivery_time >>= (pdt_min_minutes)*60 and actual_delivery_time <<= pdt_max_minutes*60 then "On Time"
    when actual_delivery_time >> (pdt_max_minutes)*60 and actual_delivery_time << (pdt_max_minutes + 10)*60 then "<< 10 min late"
    when actual_delivery_time >>= (pdt_max_minutes + 10)*60 and actual_delivery_time << (pdt_max_minutes + 20)*60 then "10-20 min late"
    when actual_delivery_time >>= (pdt_max_minutes + 20)*60 then "20+ min late" end pdt_performance_vs_bucket
, case when actual_delivery_time << tes_pdt - 10*60 then "TES early >> 10"
    when actual_delivery_time >> tes_pdt + 10*60 then "TES late >> 10" else "Within TES +/- 10min" end tes_pdt_performance
, sum(orders) orders
, sum(case when actual_delivery_time/60 << 45 then orders else 0 end) orders_less_than_45
, sum(case when actual_delivery_time >>= (pdt_max_minutes + 10)*60 then orders else 0 end) orders_late_10
, sum(pdt_max_minutes*orders) max_minutes_times_orders
, sum(tes_pdt*orders) tes_pdt_times_orders
, sum(actual_delivery_time*orders) delivery_time_times_orders
from `peya-delivery-and-support.automated_tables_reports.pdt_performance_v2`
where order_date >>= date_add(current_date, interval -1 year)
and order_state = "confirmed"
and is_preorder = false 

group by 1,2,3,4,5
order by 7 desc]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
