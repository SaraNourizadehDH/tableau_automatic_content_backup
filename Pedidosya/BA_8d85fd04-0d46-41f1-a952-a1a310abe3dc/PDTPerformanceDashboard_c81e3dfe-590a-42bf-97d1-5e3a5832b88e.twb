    <datasource caption='Experience data' inline='true' name='federated.0reqjqz0vbdbk514o9srr0jgqctf' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0mfcjxw1xx8v5m1ccnefd1szuxsh'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_matias_aresti' server-oauth='' username='matias.aresti@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0mfcjxw1xx8v5m1ccnefd1szuxsh' name='Custom SQL Query' type='text'><![CDATA[with sr as
(
    select
    ag.order_id order_id
	, count(distinct ag.session_id) helpcenter_sessions
    , count(distinct case when level3='Check order status' or level3='Complain about late order' then session_id else null end) as related_sessions_sr
	
    from `peya-delivery-and-support.automated_tables_reports.helpcenter_sessions` ag 
	where created_date >>= date_add(current_date, interval -1 year)
	and ag.order_id is not null
	group by 1
),

o as
(
    select 
    cast(o.id as string) order_id
    , date(registeredDate) order_date
    , lower(c.iso_code_2) AS country_name
    , dlo.vendor.vertical_type AS business_type
    , lower(o.state) AS order_state
    , case when rm.global_code in ("LATE_DELIVERY", "DELIVERY_ETA_TOO_LONG") then "PDT Related" else "Other" end fail_rate_pdt_related

    from `peya-data-origins-pro.cl_core.orders` o 
    left join `peya-data-origins-pro.cl_core.reject_message` as rm ON o.rejectMessage.id = rm.id
    left join `peya-data-origins-pro.cl_core.country_details` c on c.country_id = o.restaurant.country.id
    left join `peya-bi-tools-pro.il_logistics.fact_logistic_orders` dlo on dlo.platform_order_code = cast(o.id as string) and date(created_date_local) >>= date_add(current_date, interval -1 year)
    where date(registeredDate) >>= date_add(current_date, interval -1 year)
    and withLogistics
)

select 
country_name 
, order_date 
, business_type vertical_type
, count(distinct o.order_id) total_orders
, count(distinct case when order_state <<>> "confirmed" then o.order_id else null end) failed_orders
, count(distinct case when order_state <<>> "confirmed" and fail_rate_pdt_related = "PDT Related" then o.order_id else null end) pdt_related_failed_orders
, sum(helpcenter_sessions) helpcenter_sessions
, sum(related_sessions_sr) related_sessions_sr

from o left join sr on o.order_id = sr.order_id
group by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0mfcjxw1xx8v5m1ccnefd1szuxsh' name='Custom SQL Query' type='text'><![CDATA[with sr as
(
    select
    ag.order_id order_id
	, count(distinct ag.session_id) helpcenter_sessions
    , count(distinct case when level3='Check order status' or level3='Complain about late order' then session_id else null end) as related_sessions_sr
	
    from `peya-delivery-and-support.automated_tables_reports.helpcenter_sessions` ag 
	where created_date >>= date_add(current_date, interval -1 year)
	and ag.order_id is not null
	group by 1
),

o as
(
    select 
    cast(o.id as string) order_id
    , date(registeredDate) order_date
    , lower(c.iso_code_2) AS country_name
    , dlo.vendor.vertical_type AS business_type
    , lower(o.state) AS order_state
    , case when rm.global_code in ("LATE_DELIVERY", "DELIVERY_ETA_TOO_LONG") then "PDT Related" else "Other" end fail_rate_pdt_related

    from `peya-data-origins-pro.cl_core.orders` o 
    left join `peya-data-origins-pro.cl_core.reject_message` as rm ON o.rejectMessage.id = rm.id
    left join `peya-data-origins-pro.cl_core.country_details` c on c.country_id = o.restaurant.country.id
    left join `peya-bi-tools-pro.il_logistics.fact_logistic_orders` dlo on dlo.platform_order_code = cast(o.id as string) and date(created_date_local) >>= date_add(current_date, interval -1 year)
    where date(registeredDate) >>= date_add(current_date, interval -1 year)
    and withLogistics
)

select 
country_name 
, order_date 
, business_type vertical_type
, count(distinct o.order_id) total_orders
, count(distinct case when order_state <<>> "confirmed" then o.order_id else null end) failed_orders
, count(distinct case when order_state <<>> "confirmed" and fail_rate_pdt_related = "PDT Related" then o.order_id else null end) pdt_related_failed_orders
, sum(helpcenter_sessions) helpcenter_sessions
, sum(related_sessions_sr) related_sessions_sr

from o left join sr on o.order_id = sr.order_id
group by 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>country_name</remote-name>
