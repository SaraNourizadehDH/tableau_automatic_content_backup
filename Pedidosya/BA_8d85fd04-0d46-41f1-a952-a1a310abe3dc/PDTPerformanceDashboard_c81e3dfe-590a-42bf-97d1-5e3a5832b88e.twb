        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jp9dyt0i3kuhk1dlxo0w185dfkj' name='Sessions Data' type='text'>with sessions AS
  (
	SELECT DISTINCT
	CONCAT(CAST(partition_date AS STRING),CAST(visit_id AS STRING),CAST(fullvisitor_id AS STRING),platform) ga_session_id
	, date_ga session_date
    , lower(iso_code_2) country
    , is_transaction
    , time_start_menu
    , time_start_cart
    , time_start_checkout
    FROM `peya-data-origins-pro.cl_sessions.ga_sessions` s
    LEFT JOIN `peya-data-origins-pro.cl_core.country_details` c on c.country_name_en = s.country
	LEFT JOIN UNNEST(transactions) transactions
	WHERE partition_date &gt;&gt;= date_add(current_date, interval -1 year)
	AND LOWER(platform) not like &apos;%courier%&apos;
	)
	  
SELECT 
	session_date
	, country
    , COUNT(DISTINCT ga_session_id) AS sessions
    , COUNT(DISTINCT CASE WHEN is_transaction = 1 THEN ga_session_id ELSE NULL END) AS sessions_with_transaction
    , COUNT(DISTINCT CASE WHEN is_transaction = 1 AND time_start_menu IS NOT NULL      THEN ga_session_id ELSE NULL END) CVR3
    , COUNT(DISTINCT CASE WHEN time_start_menu IS NOT NULL      THEN ga_session_id ELSE NULL END) CVR3_sessions
    
    from sessions
    group by 1,2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0jp9dyt0i3kuhk1dlxo0w185dfkj' name='Sessions Data' type='text'>with sessions AS
