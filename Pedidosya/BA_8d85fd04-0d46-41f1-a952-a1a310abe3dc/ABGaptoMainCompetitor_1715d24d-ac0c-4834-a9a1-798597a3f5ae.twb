  <datasources>
    <datasource caption='BigQuery' inline='true' name='federated.18zpwuu1uk7mxt1c1ny0h1f1oqzj' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0iv7r9m0d9389p16bob6r0u0db5r'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='automated_tables_reports' server-oauth='server-custom' username='vic.acuna@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0iv7r9m0d9389p16bob6r0u0db5r' name='Consulta SQL personalizada' type='text'>---- CALCULOS PREVIOS.&#13;
-------- 1) Zonas de cobertura.&#13;
WITH cobertura AS (&#13;
  SELECT&#13;
    country_code,&#13;
    city.id AS city_id,&#13;
    city.name AS city_name,&#13;
    zone.id AS zone_id,&#13;
    zone.name AS zone_name,&#13;
    zone.created_at,&#13;
    zone.shape AS zone_geog&#13;
  FROM `peya-data-origins-pro.cl_hurrier.countries` AS c&#13;
  LEFT JOIN UNNEST (cities) AS city&#13;
  LEFT JOIN UNNEST (city.zones) AS zone&#13;
  WHERE&#13;
    country_code IN (&apos;ar&apos;,&apos;bo&apos;,&apos;cl&apos;,&apos;cr&apos;,&apos;do&apos;,&apos;ec&apos;,&apos;sv&apos;,&apos;gt&apos;,&apos;hn&apos;,&apos;ni&apos;,&apos;pa&apos;,&apos;py&apos;,&apos;pe&apos;,&apos;uy&apos;,&apos;ve&apos;)&#13;
    AND city.is_active = TRUE&#13;
    AND zone.is_Active = TRUE&#13;
    AND LOWER(zone.name) NOT LIKE &apos;%dmart%&apos;&#13;
),&#13;
&#13;
---- 2.5. Rappi Turbo.&#13;
rappi_turbo AS (&#13;
  SELECT DISTINCT -- Usamos DISTINCT para evitar duplicados de lead_id y mes&#13;
      lead_id,&#13;
      FORMAT_DATE(&apos;%m-%Y&apos;, report_date) AS month_reported&#13;
  FROM&#13;
      `fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_historical` AS oci&#13;
  WHERE&#13;
      oci.lead_source = &quot;rappi&quot;&#13;
      AND LOWER(oci.restaurant_name) LIKE &apos;%turbo%&apos;&#13;
),&#13;
&#13;
---- CREACION DE LA BASE.&#13;
-------- 1) Base de calculos (usando sales_lead_historical y agregando &apos;month&apos;).&#13;
base AS (&#13;
  SELECT&#13;
    oci.country_code,&#13;
    oci.lead_id,&#13;
    FORMAT_DATE(&apos;%m-%Y&apos;, oci.report_date) AS month, -- AQUI AGREGAMOS LA COLUMNA MONTH&#13;
    oci.report_date,&#13;
    oci.first_created,&#13;
&#13;
    msf.sf_grid_id as GRID,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN &apos;Lead&apos;&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN &apos;Account&apos;&#13;
      ELSE NULL&#13;
    END AS tipo,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.vertical_segment&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.vertical_segment&#13;
      ELSE NULL&#13;
    END AS vertical_segmento,&#13;
&#13;
    CASE&#13;
    WHEN (msf.sf_grid_id) IS NULL THEN NULL&#13;
    ELSE COALESCE(&#13;
      a.Key_Account_Sub_Category,&#13;
      CASE&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;A&apos;,&apos;A1&apos;,&apos;A2&apos;) THEN &apos;A&apos;&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;B&apos;,&apos;B1&apos;,&apos;B2&apos;) THEN &apos;B&apos;&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;C&apos;,&apos;C1&apos;,&apos;C2&apos;) THEN &apos;C&apos;&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;D&apos;,&apos;D1&apos;,&apos;D2&apos;,&apos;D3&apos;) OR a.Long_Tail_Segmentation IS NULL THEN &apos;D&apos;&#13;
        ELSE a.Long_Tail_Segmentation&#13;
      END&#13;
    )&#13;
    END AS segmento,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Vendor_Grade&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Vendor_Grade&#13;
      ELSE NULL&#13;
    END AS vendor_grade,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) = &apos;no match&apos; THEN &apos;No Match&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%active%&apos; THEN &apos;Active&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%lost%&apos; THEN &apos;Lost&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%terminated%&apos; THEN &apos;Terminated&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%win back failed%&apos; THEN &apos;Win Back Failed&apos;&#13;
      ELSE &apos;In Progress&apos;&#13;
    END AS estado,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
      ELSE NULL&#13;
    END AS subestado,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
      ELSE NULL&#13;
    END AS lost_reason,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%duplicate%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%closed%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%invalid%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%delivery area%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%delivery service%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%fraud%&apos; THEN &apos;non addressable&apos;&#13;
      ELSE &apos;addressable&apos;&#13;
    END AS gap_type,&#13;
&#13;
    oci.lead_source,&#13;
    ST_GEOGPOINT(oci.restaurant_long, oci.restaurant_lat) AS location_point&#13;
&#13;
  -- Tabla OCI (AHORA ES HISTORICAL).&#13;
  FROM&#13;
    `fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_historical` AS oci&#13;
&#13;
  -- Tabla Match SF.&#13;
  LEFT JOIN&#13;
    `fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_salesforce_match` AS msf&#13;
    ON oci.lead_id = msf.lead_id&#13;
&#13;
  -- Tablas Accounts/Leads.&#13;
  LEFT JOIN&#13;
    `peya-data-origins-pro.cl_salesforce.account` AS a&#13;
    ON LOWER(msf.sf_status) LIKE &apos;%account%&apos; AND a.GRID = msf.sf_grid_id&#13;
  LEFT JOIN&#13;
    `peya-data-origins-pro.cl_salesforce.lead` AS l&#13;
    ON LOWER(msf.sf_status) LIKE &apos;%lead%&apos; AND l.GRID = msf.sf_grid_id&#13;
&#13;
  -- Tabla Rappi Turbo.&#13;
  LEFT JOIN rappi_turbo AS rt &#13;
    ON oci.lead_id = rt.lead_id  &#13;
    AND FORMAT_DATE(&apos;%m-%Y&apos;, oci.report_date) = rt.month_reported&#13;
&#13;
  -- Filtros.&#13;
  WHERE&#13;
    oci.report_date &gt;&gt;= &apos;2025-01-01&apos;&#13;
    AND oci.country_code in (&apos;ar&apos;,&apos;bo&apos;,&apos;cl&apos;,&apos;cr&apos;,&apos;do&apos;,&apos;ec&apos;,&apos;sv&apos;,&apos;gt&apos;,&apos;hn&apos;,&apos;ni&apos;,&apos;pa&apos;,&apos;py&apos;,&apos;pe&apos;,&apos;uy&apos;,&apos;ve&apos;) -- paises PY.&#13;
    AND oci.lead_source IN (&quot;rappi&quot;, &quot;ubereats&quot;, &quot;mercadopago&quot;, &quot;monchis&quot;, &quot;yummy&quot;) -- Competidores.&#13;
    AND oci.vertical = &apos;Restaurant&apos; -- solo restaurantes.&#13;
    AND rt.lead_id IS NULL -- saco casos de rappi turbo.&#13;
    AND oci.lead_source = (&#13;
      CASE&#13;
        WHEN oci.country_code = &apos;ar&apos; THEN &apos;rappi&apos;&#13;
        WHEN oci.country_code = &apos;cl&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;cr&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;do&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;ec&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;sv&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;gt&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;py&apos; THEN &apos;monchis&apos;&#13;
        WHEN oci.country_code = &apos;pe&apos; THEN &apos;rappi&apos;&#13;
        WHEN oci.country_code = &apos;pa&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;uy&apos; THEN &apos;rappi&apos;&#13;
        WHEN oci.country_code = &apos;ve&apos; THEN &apos;yummy&apos;&#13;
        ELSE NULL&#13;
      END&#13;
    )&#13;
),&#13;
&#13;
-------- 2) Match para IN/OUT de zona de cobertura.&#13;
match_zones AS (&#13;
  SELECT DISTINCT&#13;
    oci.lead_id,&#13;
    oci.month&#13;
  FROM base AS oci&#13;
  JOIN cobertura AS c&#13;
    ON oci.country_code = c.country_code&#13;
    AND ST_WITHIN(oci.location_point, c.zone_geog)&#13;
),&#13;
&#13;
-------- 3) Base filtrada.&#13;
base_trabajada AS (&#13;
  SELECT&#13;
    b.*,&#13;
    IF(mz.lead_id IS NOT NULL, &apos;SI&apos;, &apos;NO&apos;) AS in_cobertura&#13;
  FROM base b&#13;
  LEFT JOIN match_zones AS mz&#13;
    ON b.lead_id = mz.lead_id AND b.month = mz.month&#13;
  WHERE&#13;
    b.vendor_grade IN (&quot;A&quot;,&quot;B&quot;) -- Leads de vendor grade A o B.&#13;
    AND b.estado IN (&apos;Lost&apos;, &apos;Terminated&apos;, &apos;Win Back Failed&apos;, &quot;In Progress&quot;) -- Leads que no estan activas en SF.&#13;
    AND b.gap_type IN (&quot;addressable&quot;) -- Leads addressable.&#13;
),&#13;
&#13;
---- CALCULOS DE METRICAS.&#13;
------ 1) GAP A/B MAIN COMPETITOR:&#13;
ab_main_gap AS (&#13;
  SELECT&#13;
    month,&#13;
    country_code,&#13;
    lead_source as main_competitor,&#13;
    COUNT(DISTINCT lead_id) AS actuals&#13;
  FROM base_trabajada&#13;
  WHERE in_cobertura = &quot;SI&quot;&#13;
  GROUP BY 1,2,3&#13;
  ORDER BY 1,2,3&#13;
),&#13;
&#13;
-- LISTA DE MESES DEL 2025&#13;
months_2025 AS (&#13;
  SELECT * FROM UNNEST([&#13;
    &apos;01-2025&apos;, &apos;02-2025&apos;, &apos;03-2025&apos;, &apos;04-2025&apos;, &apos;05-2025&apos;, &apos;06-2025&apos;,&#13;
    &apos;07-2025&apos;, &apos;08-2025&apos;, &apos;09-2025&apos;, &apos;10-2025&apos;, &apos;11-2025&apos;, &apos;12-2025&apos;&#13;
  ]) AS month&#13;
),&#13;
&#13;
-- LISTA DE PAÍSES QUE TIENEN TARGETS&#13;
countries AS (&#13;
  SELECT * FROM UNNEST([&#13;
    &apos;ar&apos;,&apos;cl&apos;,&apos;cr&apos;,&apos;do&apos;,&apos;ec&apos;,&apos;gt&apos;,&apos;pa&apos;,&apos;pe&apos;,&apos;py&apos;,&apos;sv&apos;,&apos;uy&apos;,&apos;ve&apos;&#13;
  ]) AS country_code&#13;
),&#13;
&#13;
-- TARGETS POR PAÍS&#13;
targets AS (&#13;
  SELECT * FROM UNNEST([&#13;
    STRUCT(&apos;ar&apos; AS country_code, 2157 AS jul, 2126 AS aug, 2077 AS sep, 2009 AS oct, 1923 AS nov, 1818 AS dec),&#13;
    STRUCT(&apos;cl&apos;, 1783, 1758, 1719, 1666, 1597, 1514),&#13;
    STRUCT(&apos;cr&apos;, 649, 649, 649, 649, 649, 649),&#13;
    STRUCT(&apos;do&apos;, 129, 129, 129, 129, 129, 129),&#13;
    STRUCT(&apos;ec&apos;, 522, 515, 503, 487, 467, 442),&#13;
    STRUCT(&apos;gt&apos;, 25, 25, 25, 25, 25, 25),&#13;
    STRUCT(&apos;pa&apos;, 26, 26, 26, 26, 26, 26),&#13;
    STRUCT(&apos;pe&apos;, 2154, 2121, 2069, 1998, 1907, 1796),&#13;
    STRUCT(&apos;py&apos;, 28, 28, 28, 28, 28, 28),&#13;
    STRUCT(&apos;sv&apos;, 60, 60, 60, 60, 60, 60),&#13;
    STRUCT(&apos;uy&apos;, 38, 38, 38, 38, 38, 38),&#13;
    STRUCT(&apos;ve&apos;, 41, 41, 41, 41, 41, 41)&#13;
  ])&#13;
),&#13;
&#13;
-- TARGETS EN FORMATO LONG&#13;
targets_long AS (&#13;
  SELECT country_code, &apos;07-2025&apos; AS month, jul AS target FROM targets&#13;
  UNION ALL SELECT country_code, &apos;08-2025&apos;, aug FROM targets&#13;
  UNION ALL SELECT country_code, &apos;09-2025&apos;, sep FROM targets&#13;
  UNION ALL SELECT country_code, &apos;10-2025&apos;, oct FROM targets&#13;
  UNION ALL SELECT country_code, &apos;11-2025&apos;, nov FROM targets&#13;
  UNION ALL SELECT country_code, &apos;12-2025&apos;, dec FROM targets&#13;
),&#13;
&#13;
-- BASE UNIVERSAL: TODOS LOS PAISES * TODOS LOS MESES&#13;
calendar_base AS (&#13;
  SELECT&#13;
    c.country_code,&#13;
    m.month&#13;
  FROM countries c&#13;
  CROSS JOIN months_2025 m&#13;
),&#13;
&#13;
-- UNIMOS TODO&#13;
full_base AS (&#13;
  SELECT&#13;
    cb.country_code,&#13;
    cb.month,&#13;
    t.target,&#13;
    ag.main_competitor,&#13;
    ag.actuals&#13;
  FROM calendar_base cb&#13;
  LEFT JOIN targets_long t&#13;
    ON cb.country_code = t.country_code AND cb.month = t.month&#13;
  LEFT JOIN ab_main_gap ag&#13;
    ON cb.country_code = ag.country_code AND cb.month = ag.month&#13;
),&#13;
&#13;
-- METRICAS&#13;
main_metrics AS (&#13;
  SELECT&#13;
    fb.month,&#13;
    fb.country_code,&#13;
    fb.main_competitor,&#13;
    fb.actuals,&#13;
    fb.target,&#13;
    (fb.target - fb.actuals) AS target_vs_actual,&#13;
    SAFE_DIVIDE(fb.target, fb.actuals) AS target_achievement,&#13;
    LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month)) AS prev_month_actuals,&#13;
    (fb.actuals - LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month))) AS mom_variation,&#13;
    SAFE_DIVIDE(&#13;
      (fb.actuals - LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month))),&#13;
      LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month))&#13;
    ) AS mom_variation_p&#13;
  FROM full_base fb&#13;
),&#13;
&#13;
-- SUMA DE VARIACIONES POR MES&#13;
mom_sums AS (&#13;
  SELECT&#13;
    month,&#13;
    SUM(mom_variation) AS total_mom_variation&#13;
  FROM main_metrics&#13;
  GROUP BY month&#13;
)&#13;
&#13;
-- RESULTADO FINAL&#13;
SELECT&#13;
  m.*,&#13;
  SAFE_DIVIDE(m.mom_variation, s.total_mom_variation) AS month_weight&#13;
FROM main_metrics m&#13;
LEFT JOIN mom_sums s&#13;
  ON m.month = s.month&#13;
ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, m.month), m.country_code</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0iv7r9m0d9389p16bob6r0u0db5r' name='main_competitor_ab_gap' table='[peya-food-and-groceries.automated_tables_reports].[main_competitor_ab_gap]' type='table' />
          <relation connection='bigquery.0iv7r9m0d9389p16bob6r0u0db5r' name='Consulta SQL personalizada' type='text'>---- CALCULOS PREVIOS.&#13;
-------- 1) Zonas de cobertura.&#13;
WITH cobertura AS (&#13;
  SELECT&#13;
    country_code,&#13;
    city.id AS city_id,&#13;
    city.name AS city_name,&#13;
    zone.id AS zone_id,&#13;
    zone.name AS zone_name,&#13;
    zone.created_at,&#13;
    zone.shape AS zone_geog&#13;
  FROM `peya-data-origins-pro.cl_hurrier.countries` AS c&#13;
  LEFT JOIN UNNEST (cities) AS city&#13;
  LEFT JOIN UNNEST (city.zones) AS zone&#13;
  WHERE&#13;
    country_code IN (&apos;ar&apos;,&apos;bo&apos;,&apos;cl&apos;,&apos;cr&apos;,&apos;do&apos;,&apos;ec&apos;,&apos;sv&apos;,&apos;gt&apos;,&apos;hn&apos;,&apos;ni&apos;,&apos;pa&apos;,&apos;py&apos;,&apos;pe&apos;,&apos;uy&apos;,&apos;ve&apos;)&#13;
    AND city.is_active = TRUE&#13;
    AND zone.is_Active = TRUE&#13;
    AND LOWER(zone.name) NOT LIKE &apos;%dmart%&apos;&#13;
),&#13;
&#13;
---- 2.5. Rappi Turbo.&#13;
rappi_turbo AS (&#13;
  SELECT DISTINCT -- Usamos DISTINCT para evitar duplicados de lead_id y mes&#13;
      lead_id,&#13;
      FORMAT_DATE(&apos;%m-%Y&apos;, report_date) AS month_reported&#13;
  FROM&#13;
      `fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_historical` AS oci&#13;
  WHERE&#13;
      oci.lead_source = &quot;rappi&quot;&#13;
      AND LOWER(oci.restaurant_name) LIKE &apos;%turbo%&apos;&#13;
),&#13;
&#13;
---- CREACION DE LA BASE.&#13;
-------- 1) Base de calculos (usando sales_lead_historical y agregando &apos;month&apos;).&#13;
base AS (&#13;
  SELECT&#13;
    oci.country_code,&#13;
    oci.lead_id,&#13;
    FORMAT_DATE(&apos;%m-%Y&apos;, oci.report_date) AS month, -- AQUI AGREGAMOS LA COLUMNA MONTH&#13;
    oci.report_date,&#13;
    oci.first_created,&#13;
&#13;
    msf.sf_grid_id as GRID,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN &apos;Lead&apos;&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN &apos;Account&apos;&#13;
      ELSE NULL&#13;
    END AS tipo,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.vertical_segment&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.vertical_segment&#13;
      ELSE NULL&#13;
    END AS vertical_segmento,&#13;
&#13;
    CASE&#13;
    WHEN (msf.sf_grid_id) IS NULL THEN NULL&#13;
    ELSE COALESCE(&#13;
      a.Key_Account_Sub_Category,&#13;
      CASE&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;A&apos;,&apos;A1&apos;,&apos;A2&apos;) THEN &apos;A&apos;&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;B&apos;,&apos;B1&apos;,&apos;B2&apos;) THEN &apos;B&apos;&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;C&apos;,&apos;C1&apos;,&apos;C2&apos;) THEN &apos;C&apos;&#13;
        WHEN a.Long_Tail_Segmentation IN (&apos;D&apos;,&apos;D1&apos;,&apos;D2&apos;,&apos;D3&apos;) OR a.Long_Tail_Segmentation IS NULL THEN &apos;D&apos;&#13;
        ELSE a.Long_Tail_Segmentation&#13;
      END&#13;
    )&#13;
    END AS segmento,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Vendor_Grade&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Vendor_Grade&#13;
      ELSE NULL&#13;
    END AS vendor_grade,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) = &apos;no match&apos; THEN &apos;No Match&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%active%&apos; THEN &apos;Active&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%lost%&apos; THEN &apos;Lost&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%terminated%&apos; THEN &apos;Terminated&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%win back failed%&apos; THEN &apos;Win Back Failed&apos;&#13;
      ELSE &apos;In Progress&apos;&#13;
    END AS estado,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Account_Status&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Status&#13;
      ELSE NULL&#13;
    END AS subestado,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
      WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
      ELSE NULL&#13;
    END AS lost_reason,&#13;
&#13;
    CASE&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%duplicate%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%closed%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%invalid%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%delivery area%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%delivery service%&apos; THEN &apos;non addressable&apos;&#13;
      WHEN LOWER(&#13;
        CASE&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%account%&apos; THEN a.Status_Reason&#13;
          WHEN LOWER(msf.sf_status) LIKE &apos;%lead%&apos; THEN l.Lost_Reason&#13;
          ELSE &apos;&apos;&#13;
        END&#13;
      ) LIKE &apos;%fraud%&apos; THEN &apos;non addressable&apos;&#13;
      ELSE &apos;addressable&apos;&#13;
    END AS gap_type,&#13;
&#13;
    oci.lead_source,&#13;
    ST_GEOGPOINT(oci.restaurant_long, oci.restaurant_lat) AS location_point&#13;
&#13;
  -- Tabla OCI (AHORA ES HISTORICAL).&#13;
  FROM&#13;
    `fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_historical` AS oci&#13;
&#13;
  -- Tabla Match SF.&#13;
  LEFT JOIN&#13;
    `fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_salesforce_match` AS msf&#13;
    ON oci.lead_id = msf.lead_id&#13;
&#13;
  -- Tablas Accounts/Leads.&#13;
  LEFT JOIN&#13;
    `peya-data-origins-pro.cl_salesforce.account` AS a&#13;
    ON LOWER(msf.sf_status) LIKE &apos;%account%&apos; AND a.GRID = msf.sf_grid_id&#13;
  LEFT JOIN&#13;
    `peya-data-origins-pro.cl_salesforce.lead` AS l&#13;
    ON LOWER(msf.sf_status) LIKE &apos;%lead%&apos; AND l.GRID = msf.sf_grid_id&#13;
&#13;
  -- Tabla Rappi Turbo.&#13;
  LEFT JOIN rappi_turbo AS rt &#13;
    ON oci.lead_id = rt.lead_id  &#13;
    AND FORMAT_DATE(&apos;%m-%Y&apos;, oci.report_date) = rt.month_reported&#13;
&#13;
  -- Filtros.&#13;
  WHERE&#13;
    oci.report_date &gt;&gt;= &apos;2025-01-01&apos;&#13;
    AND oci.country_code in (&apos;ar&apos;,&apos;bo&apos;,&apos;cl&apos;,&apos;cr&apos;,&apos;do&apos;,&apos;ec&apos;,&apos;sv&apos;,&apos;gt&apos;,&apos;hn&apos;,&apos;ni&apos;,&apos;pa&apos;,&apos;py&apos;,&apos;pe&apos;,&apos;uy&apos;,&apos;ve&apos;) -- paises PY.&#13;
    AND oci.lead_source IN (&quot;rappi&quot;, &quot;ubereats&quot;, &quot;mercadopago&quot;, &quot;monchis&quot;, &quot;yummy&quot;) -- Competidores.&#13;
    AND oci.vertical = &apos;Restaurant&apos; -- solo restaurantes.&#13;
    AND rt.lead_id IS NULL -- saco casos de rappi turbo.&#13;
    AND oci.lead_source = (&#13;
      CASE&#13;
        WHEN oci.country_code = &apos;ar&apos; THEN &apos;rappi&apos;&#13;
        WHEN oci.country_code = &apos;cl&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;cr&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;do&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;ec&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;sv&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;gt&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;py&apos; THEN &apos;monchis&apos;&#13;
        WHEN oci.country_code = &apos;pe&apos; THEN &apos;rappi&apos;&#13;
        WHEN oci.country_code = &apos;pa&apos; THEN &apos;ubereats&apos;&#13;
        WHEN oci.country_code = &apos;uy&apos; THEN &apos;rappi&apos;&#13;
        WHEN oci.country_code = &apos;ve&apos; THEN &apos;yummy&apos;&#13;
        ELSE NULL&#13;
      END&#13;
    )&#13;
),&#13;
&#13;
-------- 2) Match para IN/OUT de zona de cobertura.&#13;
match_zones AS (&#13;
  SELECT DISTINCT&#13;
    oci.lead_id,&#13;
    oci.month&#13;
  FROM base AS oci&#13;
  JOIN cobertura AS c&#13;
    ON oci.country_code = c.country_code&#13;
    AND ST_WITHIN(oci.location_point, c.zone_geog)&#13;
),&#13;
&#13;
-------- 3) Base filtrada.&#13;
base_trabajada AS (&#13;
  SELECT&#13;
    b.*,&#13;
    IF(mz.lead_id IS NOT NULL, &apos;SI&apos;, &apos;NO&apos;) AS in_cobertura&#13;
  FROM base b&#13;
  LEFT JOIN match_zones AS mz&#13;
    ON b.lead_id = mz.lead_id AND b.month = mz.month&#13;
  WHERE&#13;
    b.vendor_grade IN (&quot;A&quot;,&quot;B&quot;) -- Leads de vendor grade A o B.&#13;
    AND b.estado IN (&apos;Lost&apos;, &apos;Terminated&apos;, &apos;Win Back Failed&apos;, &quot;In Progress&quot;) -- Leads que no estan activas en SF.&#13;
    AND b.gap_type IN (&quot;addressable&quot;) -- Leads addressable.&#13;
),&#13;
&#13;
---- CALCULOS DE METRICAS.&#13;
------ 1) GAP A/B MAIN COMPETITOR:&#13;
ab_main_gap AS (&#13;
  SELECT&#13;
    month,&#13;
    country_code,&#13;
    lead_source as main_competitor,&#13;
    COUNT(DISTINCT lead_id) AS actuals&#13;
  FROM base_trabajada&#13;
  WHERE in_cobertura = &quot;SI&quot;&#13;
  GROUP BY 1,2,3&#13;
  ORDER BY 1,2,3&#13;
),&#13;
&#13;
-- LISTA DE MESES DEL 2025&#13;
months_2025 AS (&#13;
  SELECT * FROM UNNEST([&#13;
    &apos;01-2025&apos;, &apos;02-2025&apos;, &apos;03-2025&apos;, &apos;04-2025&apos;, &apos;05-2025&apos;, &apos;06-2025&apos;,&#13;
    &apos;07-2025&apos;, &apos;08-2025&apos;, &apos;09-2025&apos;, &apos;10-2025&apos;, &apos;11-2025&apos;, &apos;12-2025&apos;&#13;
  ]) AS month&#13;
),&#13;
&#13;
-- LISTA DE PAÍSES QUE TIENEN TARGETS&#13;
countries AS (&#13;
  SELECT * FROM UNNEST([&#13;
    &apos;ar&apos;,&apos;cl&apos;,&apos;cr&apos;,&apos;do&apos;,&apos;ec&apos;,&apos;gt&apos;,&apos;pa&apos;,&apos;pe&apos;,&apos;py&apos;,&apos;sv&apos;,&apos;uy&apos;,&apos;ve&apos;&#13;
  ]) AS country_code&#13;
),&#13;
&#13;
-- TARGETS POR PAÍS&#13;
targets AS (&#13;
  SELECT * FROM UNNEST([&#13;
    STRUCT(&apos;ar&apos; AS country_code, 2157 AS jul, 2126 AS aug, 2077 AS sep, 2009 AS oct, 1923 AS nov, 1818 AS dec),&#13;
    STRUCT(&apos;cl&apos;, 1783, 1758, 1719, 1666, 1597, 1514),&#13;
    STRUCT(&apos;cr&apos;, 649, 649, 649, 649, 649, 649),&#13;
    STRUCT(&apos;do&apos;, 129, 129, 129, 129, 129, 129),&#13;
    STRUCT(&apos;ec&apos;, 522, 515, 503, 487, 467, 442),&#13;
    STRUCT(&apos;gt&apos;, 25, 25, 25, 25, 25, 25),&#13;
    STRUCT(&apos;pa&apos;, 26, 26, 26, 26, 26, 26),&#13;
    STRUCT(&apos;pe&apos;, 2154, 2121, 2069, 1998, 1907, 1796),&#13;
    STRUCT(&apos;py&apos;, 28, 28, 28, 28, 28, 28),&#13;
    STRUCT(&apos;sv&apos;, 60, 60, 60, 60, 60, 60),&#13;
    STRUCT(&apos;uy&apos;, 38, 38, 38, 38, 38, 38),&#13;
    STRUCT(&apos;ve&apos;, 41, 41, 41, 41, 41, 41)&#13;
  ])&#13;
),&#13;
&#13;
-- TARGETS EN FORMATO LONG&#13;
targets_long AS (&#13;
  SELECT country_code, &apos;07-2025&apos; AS month, jul AS target FROM targets&#13;
  UNION ALL SELECT country_code, &apos;08-2025&apos;, aug FROM targets&#13;
  UNION ALL SELECT country_code, &apos;09-2025&apos;, sep FROM targets&#13;
  UNION ALL SELECT country_code, &apos;10-2025&apos;, oct FROM targets&#13;
  UNION ALL SELECT country_code, &apos;11-2025&apos;, nov FROM targets&#13;
  UNION ALL SELECT country_code, &apos;12-2025&apos;, dec FROM targets&#13;
),&#13;
&#13;
-- BASE UNIVERSAL: TODOS LOS PAISES * TODOS LOS MESES&#13;
calendar_base AS (&#13;
  SELECT&#13;
    c.country_code,&#13;
    m.month&#13;
  FROM countries c&#13;
  CROSS JOIN months_2025 m&#13;
),&#13;
&#13;
-- UNIMOS TODO&#13;
full_base AS (&#13;
  SELECT&#13;
    cb.country_code,&#13;
    cb.month,&#13;
    t.target,&#13;
    ag.main_competitor,&#13;
    ag.actuals&#13;
  FROM calendar_base cb&#13;
  LEFT JOIN targets_long t&#13;
    ON cb.country_code = t.country_code AND cb.month = t.month&#13;
  LEFT JOIN ab_main_gap ag&#13;
    ON cb.country_code = ag.country_code AND cb.month = ag.month&#13;
),&#13;
&#13;
-- METRICAS&#13;
main_metrics AS (&#13;
  SELECT&#13;
    fb.month,&#13;
    fb.country_code,&#13;
    fb.main_competitor,&#13;
    fb.actuals,&#13;
    fb.target,&#13;
    (fb.target - fb.actuals) AS target_vs_actual,&#13;
    SAFE_DIVIDE(fb.target, fb.actuals) AS target_achievement,&#13;
    LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month)) AS prev_month_actuals,&#13;
    (fb.actuals - LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month))) AS mom_variation,&#13;
    SAFE_DIVIDE(&#13;
      (fb.actuals - LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month))),&#13;
      LAG(fb.actuals) OVER (PARTITION BY fb.country_code ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, fb.month))&#13;
    ) AS mom_variation_p&#13;
  FROM full_base fb&#13;
),&#13;
&#13;
-- SUMA DE VARIACIONES POR MES&#13;
mom_sums AS (&#13;
  SELECT&#13;
    month,&#13;
    SUM(mom_variation) AS total_mom_variation&#13;
  FROM main_metrics&#13;
  GROUP BY month&#13;
)&#13;
&#13;
-- RESULTADO FINAL&#13;
SELECT&#13;
  m.*,&#13;
  SAFE_DIVIDE(m.mom_variation, s.total_mom_variation) AS month_weight&#13;
FROM main_metrics m&#13;
LEFT JOIN mom_sums s&#13;
  ON m.month = s.month&#13;
ORDER BY PARSE_DATE(&apos;%m-%Y&apos;, m.month), m.country_code</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
