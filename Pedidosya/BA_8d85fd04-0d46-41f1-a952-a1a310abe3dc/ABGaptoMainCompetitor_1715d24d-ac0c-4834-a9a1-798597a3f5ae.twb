          <map key='[main_competitor]' value='[Consulta SQL personalizada].[main_competitor]' />
          <map key='[meses_con_actividad]' value='[main_competitor_ab_gap].[meses_con_actividad]' />
          <map key='[meses_desde_ultima_orden]' value='[main_competitor_ab_gap].[meses_desde_ultima_orden]' />
          <map key='[mom_variation]' value='[Consulta SQL personalizada].[mom_variation]' />
          <map key='[mom_variation_p]' value='[Consulta SQL personalizada].[mom_variation_p]' />
          <map key='[month]' value='[Consulta SQL personalizada].[month]' />
          <map key='[month_weight]' value='[Consulta SQL personalizada].[month_weight]' />
          <map key='[must_have]' value='[main_competitor_ab_gap].[must_have]' />
          <map key='[nombre_scrap]' value='[main_competitor_ab_gap].[nombre_scrap]' />
          <map key='[nombre_sf]' value='[main_competitor_ab_gap].[nombre_sf]' />
          <map key='[number_of_ratings]' value='[main_competitor_ab_gap].[number_of_ratings]' />
