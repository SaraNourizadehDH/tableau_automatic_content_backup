    <worksheet name='Medidas según Parámetros'>
      <repository-location id='MedidassegnParmetros' path='/t/Pedidosya/workbooks/CPOCL2' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (user_ignacio_tapia)' name='federated.1y731dj0xfvxg01gf3x671gbtm33' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period view' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Geo view' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Group view' datatype='string' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;No group&quot;'>
              <calculation class='tableau' formula='&quot;No group&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1y731dj0xfvxg01gf3x671gbtm33'>
            <column caption='Week' datatype='datetime' name='[Calculation_100979210938908711]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [last_date])' />
            </column>
            <column caption='Month' datatype='datetime' name='[Calculation_100979210939342888]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_100979210938908711])' />
            </column>
            <column caption='Total Payments' datatype='real' default-format='C13322%' name='[Calculation_128211913336745984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_payments])' />
            </column>
            <column caption='Confirmed Orders BO' datatype='integer' name='[Calculation_128211913336897537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_bo])' />
            </column>
            <column caption='Working Hours' datatype='real' name='[Calculation_128211913336979459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_actual_evaluated_working_hours])' />
            </column>
            <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0.00;&quot;$&quot;-#,##0.00' name='[Calculation_128211913337122821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_128211913336745984]/[Calculation_128211913336979459]' />
            </column>
            <column caption='Period view' datatype='datetime' name='[Calculation_128211913363308551]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#10;    WHEN &quot;Daily&quot; THEN [last_date]&#10;    WHEN &quot;Weekly&quot; THEN [Calculation_100979210938908711]&#10;    WHEN &quot;Monthly&quot; THEN [Calculation_100979210939342888]&#10;    ELSE NULL &#10;END' />
            </column>
            <column caption='Total Tips Payments' datatype='real' default-format='C13322%' name='[Calculation_128211913384136717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_payments_tips])' />
            </column>
            <column caption='CPO Tips' datatype='real' default-format='c&quot;$&quot;#,##0.00;&quot;$&quot;-#,##0.00' name='[Calculation_128211913384230926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_128211913384136717]/[Calculation_128211913336897537]' />
            </column>
            <column caption='Geo View' datatype='string' name='[Calculation_128211913393803281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#10;    WHEN &quot;City&quot; THEN [city_name]&#10;    WHEN &quot;Micro zone&quot; THEN  [micro_zona]&#10;    WHEN &quot;Macro zone&quot; THEN [macro_zona]&#10;    WHEN &quot;Country&quot; THEN [country_name]&#10;    ELSE NULL &#10;END' />
            </column>
            <column caption='Group view' datatype='string' name='[Geo View (copia)_100979210794946592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3]&#10;    WHEN &quot;Batch number&quot; THEN STR([batch_number])&#10;    WHEN &quot;Vehicle name&quot; THEN  [vehicle_name]&#10;    WHEN &quot;No group&quot; THEN [Parameters].[Parámetro 2]&#10;    ELSE NULL &#10;END' />
            </column>
            <column aggregation='Sum' caption='Batch number' datatype='integer' name='[batch_number]' role='dimension' type='ordinal' />
            <column caption='City name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[confirmed_orders_bo]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[last_date]' role='dimension' type='quantitative' />
            <column caption='Macro zone' datatype='string' name='[macro_zona]' role='dimension' type='nominal' />
            <column caption='Micro zone' datatype='string' name='[micro_zona]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_128211913393803281]' derivation='None' name='[none:Calculation_128211913393803281:nk]' pivot='key' type='nominal' />
