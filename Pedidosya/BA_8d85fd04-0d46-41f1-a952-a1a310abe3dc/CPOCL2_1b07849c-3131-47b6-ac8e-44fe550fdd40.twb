            <column-instance column='[batch_number]' derivation='None' name='[none:batch_number:ok]' pivot='key' type='ordinal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[macro_zona]' derivation='None' name='[none:macro_zona:nk]' pivot='key' type='nominal' />
