    <datasource caption='Consulta SQL personalizada (user_ignacio_tapia)' inline='true' name='federated.1y731dj0xfvxg01gf3x671gbtm33' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Rider Payments + Orders Shifts [Agrupado]' name='bigquery.1ei20vl1bg8mb7133dynr0hvsnsd'>
            <connection CATALOG='peya-chile' EXECCATALOG='peya-chile' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-chile' schema='user_ignacio_tapia' server-oauth='' username='ignacio.tapia@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ei20vl1bg8mb7133dynr0hvsnsd' name='Consulta SQL personalizada' type='text'>with orders as (
  select last_date
    , country_code
    , country_name
    , city_id
    , city_name
    , vehicle_name
    , batch_number
    , sum(orders_completed) as orders_completed
    , sum(sum_pickup_distance_manhattan) as sum_pickup_distance_manhattan
    , sum(sum_dropoff_distance_manhattan) as sum_dropoff_distance_manhattan
    , sum(deliveries_completed) as deliveries_completed
    , sum(sum_stacked_deliveries) sum_stacked_deliveries
    , sum(sum_actual_delivery_time) as sum_actual_delivery_time
    , sum(sum_actual_evaluated_working_hours) as sum_actual_evaluated_working_hours
    , sum(confirmed_orders_bo) as confirmed_orders_bo
  from `peya-chile.user_ignacio_tapia.order_shifts_automation`
  group by 1,2,3,4,5,6,7
),

rider_payments as (
  select last_date_cost
    , country_code_cost
    , city_id as city_id_cost
    , city_name as city_name_cost
    , vehicle_name as vehicle_name_cost
    , batch_number as batch_number_cost
    , sum(total_payments_basic_delivery_per_del) as total_payments_basic_delivery_per_del
    , sum(total_payments_basic_delivery_per_del_pud) as total_payments_basic_delivery_per_del_pud
    , sum(total_payments_basic_delivery_per_del_ndo) as total_payments_basic_delivery_per_del_ndo
    , sum(total_payments_basic_delivery_per_km) as total_payments_basic_delivery_per_km
    , sum(total_payments_basic_evaluation) as total_payments_basic_evaluation
    , sum(total_payments_scoring_batch) as total_payments_scoring_batch
    , sum(total_payments_quest_per_delivery) + sum(total_payments_quest_per_hour) as total_payments_quest
    , sum(total_payments_referral) as total_payments_referral
    , sum(total_payments_nhb) as total_payments_nhb
    , sum(total_payments_special_payments) as total_payments_special_payments
    , sum(total_payments) as total_payments
  from `peya-chile.user_ignacio_tapia.rider_payments_automation`
  group by 1,2,3,4,5,6
),

tip_payments as (
  select last_date_tips
    , country_code_tips
    , city_id_tips
    , city_name_tips
    , rider_vehicle_name_tips
    , rider_batch_number_tips
    , sum(total_payments_tips) as total_payments_tips
  from `peya-chile.user_ignacio_tapia.rider_payments_tips_automation`
  group by 1,2,3,4,5,6
)

select coalesce(o.last_date, p.last_date_cost) as last_date
  , coalesce(o.country_code, p.country_code_cost) as country_code
  , &apos;Chile&apos; as country_name
  , coalesce(o.city_name, p.city_name_cost) as city_name
  , coalesce(o.city_id, p.city_id_cost) as city_id
  , case
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Buin&quot;, &quot;Colina&quot;, &quot;Melipilla&quot;, &quot;Penaflor&quot;, &quot;San antonio&quot;, &quot;San felipe  los andes&quot;, &quot;Santiago&quot;, &quot;Vina del mar&quot;) then &quot;Zona Centro&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Antofagasta&quot;, &quot;Arica&quot;, &quot;Calama&quot;, &quot;Copiapo&quot;, &quot;Iquique&quot;, &quot;Alto hospicio&quot;, &quot;La serena&quot;, &quot;Ovalle&quot;) then &quot;Zona Norte&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Chillan&quot;, &quot;Concepcion&quot;, &quot;Curico&quot;, &quot;Linares&quot;, &quot;Los angeles&quot;, &quot;Osorno&quot;, &quot;Puerto montt&quot;, &quot;Puerto varas&quot;, &quot;Punta arenas&quot;, &quot;Talca&quot;, &quot;Temuco&quot;, &quot;Valdivia&quot;, &quot;Rancagua&quot;, &quot;San fernando&quot;) then &quot;Zona Sur&quot;
    else &quot;Error&quot;
    end as macro_zona
  , case
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Arica&quot;, &quot;Antofagasta&quot;, &quot;Calama&quot;, &quot;Iquique&quot;) then &quot;norte_grande&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Copiapo&quot;, &quot;La serena&quot;, &quot;Ovalle&quot;) then &quot;norte_chico&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Buin&quot;, &quot;Colina&quot;, &quot;Penaflor&quot;, &quot;Santiago&quot;) then &quot;centro_rm&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Melipilla&quot;, &quot;San felipe  los andes&quot;, &quot;Vina del mar&quot;, &quot;San antonio&quot;) then &quot;centro_quinta&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Curico&quot;, &quot;Linares&quot;, &quot;San fernando&quot;, &quot;Rancagua&quot;, &quot;Talca&quot;, &quot;Los angeles&quot;) then &quot;sur_norte&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Chillan&quot;, &quot;Concepcion&quot;) then &quot;sur_centro&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Temuco&quot;, &quot;Valdivia&quot;, &quot;Osorno&quot;, &quot;Puerto varas&quot;, &quot;Puerto montt&quot;, &quot;Punta arenas&quot;) then &quot;sur_sur&quot;
    else &quot;Error&quot;
    end as micro_zona
  , case 
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Automovil&apos; then &apos;Automovil&apos;
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Motocicleta&apos; then &apos;Motocicleta&apos;
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Bicicleta&apos; then &apos;Bicicleta&apos;
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Piloto_Dmarts&apos; then &apos;Motocicleta&apos;
    else &quot;Error&quot;
    end as vehicle_name
  , coalesce(o.batch_number, p.batch_number_cost) as batch_number
  , sum(orders_completed) as orders_completed
  , sum(sum_pickup_distance_manhattan) as sum_pickup_distance_manhattan
  , sum(sum_dropoff_distance_manhattan) as sum_dropoff_distance_manhatta
  , sum(deliveries_completed) as deliveries_completed
  , sum(sum_stacked_deliveries) sum_stacked_deliveries
  , sum(sum_actual_delivery_time) as sum_actual_delivery_time
  , sum(sum_actual_evaluated_working_hours) as sum_actual_evaluated_working_hours
  , sum(confirmed_orders_bo) as confirmed_orders_bo
  , sum(total_payments_basic_delivery_per_del) as total_payments_basic_delivery_per_del
  , sum(total_payments_basic_delivery_per_del_pud) as total_payments_basic_delivery_per_del_pud
  , sum(total_payments_basic_delivery_per_del_ndo) as total_payments_basic_delivery_per_del_ndo
  , sum(total_payments_basic_delivery_per_km) as total_payments_basic_delivery_per_km
  , sum(total_payments_basic_evaluation) as total_payments_basic_evaluation
  , sum(total_payments_scoring_batch) as total_payments_scoring_batch
  , sum(total_payments_quest) as total_payments_quest
  , sum(total_payments_referral) as total_payments_referral
  , sum(total_payments_nhb) as total_payments_nhb
  , sum(total_payments_special_payments) as total_payments_special_payments
  , sum(total_payments) as total_payments
  , sum(total_payments_tips) as total_payments_tips
from orders o
full outer join rider_payments p
  on (o.last_date = p.last_date_cost
    and o.country_code = p.country_code_cost
    and o.city_id = p.city_id_cost
    and o.vehicle_name = p.vehicle_name_cost
    and o.batch_number = p.batch_number_cost)
full outer join tip_payments t
  on (coalesce(o.last_date, p.last_date_cost) = t.last_date_tips
    and coalesce(o.country_code, p.country_code_cost) = t.country_code_tips
    and coalesce(o.city_id, p.city_id_cost) = t.city_id_tips
    and coalesce(o.vehicle_name, p.vehicle_name_cost) = t.rider_vehicle_name_tips
    and coalesce(o.batch_number, p.batch_number_cost) = t.rider_batch_number_tips)
group by 1,2,3,4,5,6,7,8,9</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ei20vl1bg8mb7133dynr0hvsnsd' name='Consulta SQL personalizada' type='text'>with orders as (
  select last_date
    , country_code
    , country_name
    , city_id
    , city_name
    , vehicle_name
    , batch_number
    , sum(orders_completed) as orders_completed
    , sum(sum_pickup_distance_manhattan) as sum_pickup_distance_manhattan
    , sum(sum_dropoff_distance_manhattan) as sum_dropoff_distance_manhattan
    , sum(deliveries_completed) as deliveries_completed
    , sum(sum_stacked_deliveries) sum_stacked_deliveries
    , sum(sum_actual_delivery_time) as sum_actual_delivery_time
    , sum(sum_actual_evaluated_working_hours) as sum_actual_evaluated_working_hours
    , sum(confirmed_orders_bo) as confirmed_orders_bo
  from `peya-chile.user_ignacio_tapia.order_shifts_automation`
  group by 1,2,3,4,5,6,7
),

rider_payments as (
  select last_date_cost
    , country_code_cost
    , city_id as city_id_cost
    , city_name as city_name_cost
    , vehicle_name as vehicle_name_cost
    , batch_number as batch_number_cost
    , sum(total_payments_basic_delivery_per_del) as total_payments_basic_delivery_per_del
    , sum(total_payments_basic_delivery_per_del_pud) as total_payments_basic_delivery_per_del_pud
    , sum(total_payments_basic_delivery_per_del_ndo) as total_payments_basic_delivery_per_del_ndo
    , sum(total_payments_basic_delivery_per_km) as total_payments_basic_delivery_per_km
    , sum(total_payments_basic_evaluation) as total_payments_basic_evaluation
    , sum(total_payments_scoring_batch) as total_payments_scoring_batch
    , sum(total_payments_quest_per_delivery) + sum(total_payments_quest_per_hour) as total_payments_quest
    , sum(total_payments_referral) as total_payments_referral
    , sum(total_payments_nhb) as total_payments_nhb
    , sum(total_payments_special_payments) as total_payments_special_payments
    , sum(total_payments) as total_payments
  from `peya-chile.user_ignacio_tapia.rider_payments_automation`
  group by 1,2,3,4,5,6
),

tip_payments as (
  select last_date_tips
    , country_code_tips
    , city_id_tips
    , city_name_tips
    , rider_vehicle_name_tips
    , rider_batch_number_tips
    , sum(total_payments_tips) as total_payments_tips
  from `peya-chile.user_ignacio_tapia.rider_payments_tips_automation`
  group by 1,2,3,4,5,6
)

select coalesce(o.last_date, p.last_date_cost) as last_date
  , coalesce(o.country_code, p.country_code_cost) as country_code
  , &apos;Chile&apos; as country_name
  , coalesce(o.city_name, p.city_name_cost) as city_name
  , coalesce(o.city_id, p.city_id_cost) as city_id
  , case
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Buin&quot;, &quot;Colina&quot;, &quot;Melipilla&quot;, &quot;Penaflor&quot;, &quot;San antonio&quot;, &quot;San felipe  los andes&quot;, &quot;Santiago&quot;, &quot;Vina del mar&quot;) then &quot;Zona Centro&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Antofagasta&quot;, &quot;Arica&quot;, &quot;Calama&quot;, &quot;Copiapo&quot;, &quot;Iquique&quot;, &quot;Alto hospicio&quot;, &quot;La serena&quot;, &quot;Ovalle&quot;) then &quot;Zona Norte&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Chillan&quot;, &quot;Concepcion&quot;, &quot;Curico&quot;, &quot;Linares&quot;, &quot;Los angeles&quot;, &quot;Osorno&quot;, &quot;Puerto montt&quot;, &quot;Puerto varas&quot;, &quot;Punta arenas&quot;, &quot;Talca&quot;, &quot;Temuco&quot;, &quot;Valdivia&quot;, &quot;Rancagua&quot;, &quot;San fernando&quot;) then &quot;Zona Sur&quot;
    else &quot;Error&quot;
    end as macro_zona
  , case
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Arica&quot;, &quot;Antofagasta&quot;, &quot;Calama&quot;, &quot;Iquique&quot;) then &quot;norte_grande&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Copiapo&quot;, &quot;La serena&quot;, &quot;Ovalle&quot;) then &quot;norte_chico&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Buin&quot;, &quot;Colina&quot;, &quot;Penaflor&quot;, &quot;Santiago&quot;) then &quot;centro_rm&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Melipilla&quot;, &quot;San felipe  los andes&quot;, &quot;Vina del mar&quot;, &quot;San antonio&quot;) then &quot;centro_quinta&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Curico&quot;, &quot;Linares&quot;, &quot;San fernando&quot;, &quot;Rancagua&quot;, &quot;Talca&quot;, &quot;Los angeles&quot;) then &quot;sur_norte&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Chillan&quot;, &quot;Concepcion&quot;) then &quot;sur_centro&quot;
    when coalesce(o.city_name, p.city_name_cost) in (&quot;Temuco&quot;, &quot;Valdivia&quot;, &quot;Osorno&quot;, &quot;Puerto varas&quot;, &quot;Puerto montt&quot;, &quot;Punta arenas&quot;) then &quot;sur_sur&quot;
    else &quot;Error&quot;
    end as micro_zona
  , case 
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Automovil&apos; then &apos;Automovil&apos;
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Motocicleta&apos; then &apos;Motocicleta&apos;
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Bicicleta&apos; then &apos;Bicicleta&apos;
    when coalesce(o.vehicle_name, p.vehicle_name_cost) = &apos;Piloto_Dmarts&apos; then &apos;Motocicleta&apos;
    else &quot;Error&quot;
    end as vehicle_name
  , coalesce(o.batch_number, p.batch_number_cost) as batch_number
  , sum(orders_completed) as orders_completed
  , sum(sum_pickup_distance_manhattan) as sum_pickup_distance_manhattan
  , sum(sum_dropoff_distance_manhattan) as sum_dropoff_distance_manhatta
  , sum(deliveries_completed) as deliveries_completed
  , sum(sum_stacked_deliveries) sum_stacked_deliveries
  , sum(sum_actual_delivery_time) as sum_actual_delivery_time
  , sum(sum_actual_evaluated_working_hours) as sum_actual_evaluated_working_hours
  , sum(confirmed_orders_bo) as confirmed_orders_bo
  , sum(total_payments_basic_delivery_per_del) as total_payments_basic_delivery_per_del
  , sum(total_payments_basic_delivery_per_del_pud) as total_payments_basic_delivery_per_del_pud
  , sum(total_payments_basic_delivery_per_del_ndo) as total_payments_basic_delivery_per_del_ndo
  , sum(total_payments_basic_delivery_per_km) as total_payments_basic_delivery_per_km
  , sum(total_payments_basic_evaluation) as total_payments_basic_evaluation
  , sum(total_payments_scoring_batch) as total_payments_scoring_batch
  , sum(total_payments_quest) as total_payments_quest
  , sum(total_payments_referral) as total_payments_referral
  , sum(total_payments_nhb) as total_payments_nhb
  , sum(total_payments_special_payments) as total_payments_special_payments
  , sum(total_payments) as total_payments
  , sum(total_payments_tips) as total_payments_tips
from orders o
full outer join rider_payments p
  on (o.last_date = p.last_date_cost
    and o.country_code = p.country_code_cost
    and o.city_id = p.city_id_cost
    and o.vehicle_name = p.vehicle_name_cost
    and o.batch_number = p.batch_number_cost)
full outer join tip_payments t
  on (coalesce(o.last_date, p.last_date_cost) = t.last_date_tips
    and coalesce(o.country_code, p.country_code_cost) = t.country_code_tips
    and coalesce(o.city_id, p.city_id_cost) = t.city_id_tips
    and coalesce(o.vehicle_name, p.vehicle_name_cost) = t.rider_vehicle_name_tips
    and coalesce(o.batch_number, p.batch_number_cost) = t.rider_batch_number_tips)
group by 1,2,3,4,5,6,7,8,9</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
