            </column>
            <column caption='Group view' datatype='string' name='[Geo View (copia)_100979210794946592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3]&#10;    WHEN &quot;Batch number&quot; THEN STR([batch_number])&#10;    WHEN &quot;Vehicle name&quot; THEN  [vehicle_name]&#10;    WHEN &quot;No group&quot; THEN [Parameters].[Parámetro 2]&#10;    ELSE NULL &#10;END' />
            </column>
