            <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0.00;&quot;$&quot;-#,##0.00' name='[Calculation_128211913337122821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_128211913336745984]/[Calculation_128211913336979459]' />
            </column>
            <column caption='Period view' datatype='datetime' name='[Calculation_128211913363308551]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#10;    WHEN &quot;Daily&quot; THEN [last_date]&#10;    WHEN &quot;Weekly&quot; THEN [Calculation_100979210938908711]&#10;    WHEN &quot;Monthly&quot; THEN [Calculation_100979210939342888]&#10;    ELSE NULL &#10;END' />
