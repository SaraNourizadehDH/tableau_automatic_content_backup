            <column datatype='real' hidden='true' name='[sum_actual_evaluated_working_hours]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_128211913363308551]' derivation='Day-Trunc' name='[tdy:Calculation_128211913363308551:ok]' pivot='key' type='ordinal' />
            <column-instance column='[last_date]' derivation='Day-Trunc' name='[tdy:last_date:qk]' pivot='key' type='quantitative' />
            <column datatype='real' default-format='C13322%' hidden='true' name='[total_payments]' role='measure' type='quantitative' />
            <column datatype='real' default-format='C13322%' hidden='true' name='[total_payments_tips]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_128211913337122821]' derivation='User' name='[usr:Calculation_128211913337122821:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_128211913384230926]' derivation='User' name='[usr:Calculation_128211913384230926:qk]' pivot='key' type='quantitative' />
            <column caption='Vehicle name' datatype='string' name='[vehicle_name]' role='dimension' type='nominal' />
