          <datasource-dependencies datasource='federated.1y731dj0xfvxg01gf3x671gbtm33'>
            <column caption='Week' datatype='datetime' name='[Calculation_100979210938908711]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [last_date])' />
            </column>
            <column caption='Month' datatype='datetime' name='[Calculation_100979210939342888]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_100979210938908711])' />
            </column>
            <column caption='Total Payments' datatype='real' default-format='C13322%' name='[Calculation_128211913336745984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_payments])' />
            </column>
            <column caption='Confirmed Orders BO' datatype='integer' name='[Calculation_128211913336897537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_bo])' />
            </column>
            <column caption='Working Hours' datatype='real' name='[Calculation_128211913336979459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_actual_evaluated_working_hours])' />
            </column>
            <column caption='CPO' datatype='real' default-format='c&quot;$&quot;#,##0.00;&quot;$&quot;-#,##0.00' name='[Calculation_128211913337077764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_128211913336745984]/[Calculation_128211913336897537]' />
            </column>
            <column caption='CPH' datatype='real' default-format='c&quot;$&quot;#,##0.00;&quot;$&quot;-#,##0.00' name='[Calculation_128211913337122821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_128211913336745984]/[Calculation_128211913336979459]' />
            </column>
            <column caption='Period view' datatype='datetime' name='[Calculation_128211913363308551]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#10;    WHEN &quot;Daily&quot; THEN [last_date]&#10;    WHEN &quot;Weekly&quot; THEN [Calculation_100979210938908711]&#10;    WHEN &quot;Monthly&quot; THEN [Calculation_100979210939342888]&#10;    ELSE NULL &#10;END' />
            </column>
            <column caption='Geo View' datatype='string' name='[Calculation_128211913393803281]' role='dimension' type='nominal'>
