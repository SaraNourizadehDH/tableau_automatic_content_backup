    <worksheet name='OKR variation SDW'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='okrs' name='federated.021cy660g4erpu10kgxix0rbcb6u' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;iso-week&quot;'>
              <calculation class='tableau' formula='&quot;iso-week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;iso-week&quot;' value='Weekly' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.021cy660g4erpu10kgxix0rbcb6u'>
            <column caption='Date' datatype='date' name='[Calculation_1185572651427770368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parámetro 1], [fecha]))' />
            </column>
            <column caption='Inacuraccy' datatype='real' name='[Calculation_1185572651428356098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inna_num])/SUM([inna_denom])' />
            </column>
            <column caption='Staffing Affection' datatype='real' name='[Calculation_1185572651428548611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([staffing_num])/SUM([staffing_denom])' />
            </column>
            <column caption='RSAT%' datatype='real' name='[Calculation_1185572651428950020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rsat_nps])/SUM([rr_rsat_nps])' />
            </column>
            <column caption='Failrate' datatype='real' name='[Calculation_1185572651429330950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rej_orders])/SUM([total_orders])' />
            </column>
            <column caption='Slow Delivery' datatype='real' name='[Calculation_1185572651429486599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([slow_orders])/SUM([total_orders])' />
            </column>
            <column caption='CR%' datatype='real' name='[Calculation_864409707607228417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_contacts])/SUM([total_orders])' />
            </column>
            <column caption='Good Stacking %' datatype='real' name='[Calculation_864409707794120706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([stacking]) * AVG(good_stacking_share)' />
            </column>
            <column caption='Dynamic Date' datatype='datetime' name='[Calculation_864409707812032517]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parámetro 1], [fecha])' />
            </column>
            <column caption='fecha_ultimo_ nivel' datatype='string' name='[Calculation_864409707812601862]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_864409707812032517]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_864409707812032517]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Parámetro 1], [Calculation_864409707812032517]))&#13;&#10;END' />
            </column>
            <column caption='WoW' datatype='string' name='[Calculation_864409707812868103]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &apos;MoM&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &apos;WoW&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &apos;QoQ&apos;&#13;&#10;ELSE&#13;&#10;    &apos;DoD&apos;&#13;&#10;END' />
            </column>
            <column caption='Last' datatype='boolean' name='[Calculation_864409707814023177]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() &lt;= 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Seamless Orders ' datatype='real' name='[Calculation_946600402787557376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_orders])-SUM(non_seamless_orders))/SUM([total_orders])' />
            </column>
            <column caption='AWT' datatype='real' name='[Calculation_946600402802724865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([avoidable_wait_time_num])/SUM([avoidable_wait_time_denom]))/60' />
            </column>
            <column caption='Order Status Session Rate for Slow and Late Orders % ' datatype='real' name='[Calculation_946600402923364354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([slow_sessions])/SUM([related_sessions])' />
            </column>
            <column datatype='integer' name='[avoidable_wait_time_denom]' role='measure' type='quantitative' />
            <column datatype='integer' name='[avoidable_wait_time_num]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
