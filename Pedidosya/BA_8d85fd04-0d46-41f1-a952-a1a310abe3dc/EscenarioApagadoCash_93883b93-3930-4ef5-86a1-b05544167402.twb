o.order_status,&#13;
o.fail_rate_owner,&#13;
o.rejectMessage.globalcode,&#13;
f.cancellation_stage,&#13;
CASE&#13;
WHEN f.concept = &quot;compensation&quot; and f.cancellation_stage = &quot;BEFORE_PICKUP&quot; THEN f.amount&#13;
WHEN f.concept = &quot;compensation&quot; and f.cancellation_stage != &quot;BEFORE_PICKUP&quot; THEN  f.commissionable_amount-f.commission_amount&#13;
ELSE 0 END resarcimientos,&#13;
total_cpo_local_currency,&#13;
pro.rider_cost.rider_cost,&#13;
pro.take_in,&#13;
pro.gpo.gpo&#13;
FROM `peya-bi-tools-pro.il_core.fact_orders` o &#13;
LEFT JOIN `peya-datamarts-pro.dm_food.fda_consolidated` f on o.order_id = f.order_id and original_order_date = o.registered_date&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` p on p.partner_id = o.restaurant.id&#13;
LEFT JOIN `peya-datamarts-pro.dm_order_profitability.fact_order_profitability` pro on pro.order_id = o.order_id and pro.registered_date = o.registered_date&#13;
left join cpo c on SAFE_CAST(c.platform_order_code as int64) = o.order_id&#13;
WHERE o.country_id = 20&#13;
and o.registered_date &gt;&gt;= DATE_SUB(CURRENT_DATE(),INTERVAL 4 month)&#13;
)&#13;
&#13;
SELECT&#13;
registered_date,&#13;
hour_time,&#13;
partner_id,&#13;
partner_name,&#13;
franchise_name,&#13;
business_type_name,&#13;
is_online_payment,&#13;
order_status,&#13;
COUNT (DISTINCT order_id) total_orders,&#13;
SUM(resarcimientos) total_resarcimientos,&#13;
SUM(total_cpo_local_currency) total_cpo,&#13;
SUM(rider_cost) total_rider_cost,&#13;
SUM(take_in) total_take_in,&#13;
SUM(gpo) total_gpo,&#13;
SUM(take_in)+SUM(rider_cost) take_in_minus_rider_cost&#13;
from orders&#13;
group by all</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
