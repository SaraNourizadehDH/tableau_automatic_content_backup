    <datasource caption='Consulta SQL personalizada (user_alberto_salazar)' inline='true' name='federated.1n0mgvd1l9pfxw10ar8be0k864b9' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1jfh80e0xxsmm71a93wcz1tu4j87'>
            <connection CATALOG='peya-nicaragua' EXECCATALOG='peya-nicaragua' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-nicaragua' schema='user_alberto_salazar' server-oauth='server-custom' username='alberto.salazar@pedidosya.com' workgroup-auth-mode='prompt' />
