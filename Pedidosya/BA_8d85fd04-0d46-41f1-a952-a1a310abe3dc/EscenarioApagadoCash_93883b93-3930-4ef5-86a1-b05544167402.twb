      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (user_alberto_salazar)' name='federated.1n0mgvd1l9pfxw10ar8be0k864b9' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='hora_apagado' datatype='integer' name='[%migracion (copia)]' param-domain-type='range' role='measure' type='quantitative' value='21'>
              <calculation class='tableau' formula='21' />
              <range max='23' min='0' />
            </column>
            <column caption='%migracion' datatype='real' default-format='p0.00%' name='[data Parámetro]' param-domain-type='range' role='measure' type='quantitative' value='0.35'>
              <calculation class='tableau' formula='0.35' />
              <range max='1.0' min='0.0' />
            </column>
            <column caption='partner_ids_apagado' datatype='string' name='[hora_apagado (copia 2)]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='apagado_masivo' datatype='boolean' name='[hora_apagado (copia)]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1n0mgvd1l9pfxw10ar8be0k864b9'>
            <column caption='confirmed_orders_1' datatype='integer' name='[Calculation_1163899049201979392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#13;&#10;[Parameters].[hora_apagado (copia)] = TRUE&#13;&#10;AND [hour_time] &gt;= [Parameters].[%migracion (copia)]&#13;&#10;AND [order_status] = &quot;CONFIRMED&quot; &#13;&#10;and [is_online_payment] = 1&#13;&#10;THEN [total_orders] &#13;&#10;ELSEIF &#13;&#10;[Parameters].[hora_apagado (copia)] = FALSE&#13;&#10;AND CONTAINS([Parameters].[hora_apagado (copia 2)], STR([partner_id])) = FALSE&#13;&#10;AND [hour_time]&gt;= [Parameters].[%migracion (copia)]&#13;&#10;AND [order_status]= &quot;CONFIRMED&quot;&#13;&#10;then [total_orders]&#13;&#10;ELSEIF&#13;&#10;[Parameters].[hora_apagado (copia)] = FALSE&#13;&#10;AND CONTAINS([Parameters].[hora_apagado (copia 2)], STR([partner_id])) = TRUE&#13;&#10;AND [hour_time]&gt;= [Parameters].[%migracion (copia)]&#13;&#10;and [order_status] &gt;= &quot;CONFIRMED&quot;&#13;&#10;AND [is_online_payment] = 1 &#13;&#10;THEN [total_orders]&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='confirmed_cash_orders' datatype='integer' name='[Calculation_1163899049206853633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [is_online_payment] =0 and [hour_time]&gt;= [Parameters].[%migracion (copia)] and [order_status]=&quot;CONFIRMED&quot; THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='total_confirmed_orders' datatype='integer' name='[Calculation_1163899049207480322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;IF hour_time &gt;= [Parameters].[%migracion (copia)] and [order_status]=&quot;CONFIRMED&quot; then [total_orders] else 0 end&#13;&#10;)' />
            </column>
            <column caption='confirmed_online_orders' datatype='integer' name='[Calculation_1163899049208557571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [is_online_payment] =1 and [order_status] =&quot;CONFIRMED&quot; and [hour_time]&gt;= [Parameters].[%migracion (copia)] THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='total_FR' datatype='real' default-format='p0.00%' name='[Calculation_1163899049211146247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [order_status] != &quot;CONFIRMED&quot; AND [hour_time]&gt;= [Parameters].[%migracion (copia)] THEN [total_orders] ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [hour_time] &gt;= [Parameters].[%migracion (copia)] THEN&#13;&#10;[total_orders] ELSE 0 END&#13;&#10;)' />
            </column>
            <column caption='online_FR' datatype='real' default-format='p0.00%' name='[Calculation_1163899049212018697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [order_status] != &quot;CONFIRMED&quot; AND [is_online_payment]=1 AND [hour_time]&gt;= [Parameters].[%migracion (copia)] THEN [total_orders] ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [hour_time] &gt;= [Parameters].[%migracion (copia)] and [is_online_payment]= 1 then&#13;&#10;[total_orders] ELSE 0 END)' />
            </column>
            <column caption='resarcimientos_total_cash' datatype='real' default-format='C19466%' name='[Calculation_1163899049213808650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#13;&#10;[order_status] != &quot;CONFIRMED&quot;&#13;&#10;AND [hour_time] &gt;= [Parameters].[%migracion (copia)]&#13;&#10;and [is_online_payment] =0&#13;&#10;then [total_resarcimientos] else 0 end&#13;&#10;)' />
            </column>
            <column caption='opport_cost_orders' datatype='integer' datatype-customized='true' name='[Calculation_1163899049218539533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(ROUND(([Calculation_1163899049207480322]-[Calculation_1163899049201979392])*(1-[Parameters].[data Parámetro]),0))' />
            </column>
            <column caption='rejected_cash_orders' datatype='integer' name='[confirmed_cash_orders (copia)_1163899049209491461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [is_online_payment] =0 and [hour_time]&gt;= [Parameters].[%migracion (copia)] and [order_status]!=&quot;CONFIRMED&quot; THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='rejected_online_orders' datatype='integer' name='[confirmed_online_orders (copia)_1163899049209634822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [is_online_payment] =1 and [order_status] !=&quot;CONFIRMED&quot; and [hour_time]&gt;= [Parameters].[%migracion (copia)] THEN [total_orders] ELSE 0 END)' />
            </column>
            <column caption='take_in_1' datatype='real' name='[confirmed_orders_1 (copia)_1163899049220190222]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#13;&#10;[Parameters].[hora_apagado (copia)] = TRUE&#13;&#10;AND [hour_time] &gt;= [Parameters].[%migracion (copia)]&#13;&#10;AND [order_status] = &quot;CONFIRMED&quot; &#13;&#10;and [is_online_payment] = 1&#13;&#10;THEN [take_in_minus_rider_cost] &#13;&#10;ELSEIF &#13;&#10;[Parameters].[hora_apagado (copia)] = FALSE&#13;&#10;AND CONTAINS([Parameters].[hora_apagado (copia 2)], STR([partner_id])) = FALSE&#13;&#10;AND [hour_time]&gt;= [Parameters].[%migracion (copia)]&#13;&#10;AND [order_status]= &quot;CONFIRMED&quot;&#13;&#10;then [take_in_minus_rider_cost]&#13;&#10;ELSEIF&#13;&#10;[Parameters].[hora_apagado (copia)] = FALSE&#13;&#10;AND CONTAINS([Parameters].[hora_apagado (copia 2)], STR([partner_id])) = TRUE&#13;&#10;AND [hour_time]&gt;= [Parameters].[%migracion (copia)]&#13;&#10;and [order_status] &gt;= &quot;CONFIRMED&quot;&#13;&#10;AND [is_online_payment] = 1 &#13;&#10;THEN [take_in_minus_rider_cost]&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)' />
            </column>
            <column datatype='string' name='[franchise_name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[hour_time]' role='measure' type='quantitative' />
            <column datatype='integer' name='[is_online_payment]' role='measure' type='quantitative' />
            <column-instance column='[franchise_name]' derivation='None' name='[none:franchise_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:qk]' pivot='key' type='quantitative' />
            <column caption='opport_cost_take_in' datatype='real' default-format='C19466%' name='[opport_cost_orders (copia)_1163899049220366351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([total_confirmed_orders (copia)_1163899049220513808]-[confirmed_orders_1 (copia)_1163899049220190222])*(1-[Parameters].[data Parámetro])' />
            </column>
            <column datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column datatype='integer' name='[partner_id]' role='measure' type='quantitative' />
            <column datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column caption='cpo_total_cash' datatype='real' default-format='C19466%' name='[resarcimientos_total (copia)_1163899049214230539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#13;&#10;[order_status] != &quot;CONFIRMED&quot;&#13;&#10;AND [hour_time] &gt;= [Parameters].[%migracion (copia)]&#13;&#10;and [is_online_payment] =0&#13;&#10;then [total_cpo] else 0 end&#13;&#10;)' />
            </column>
            <column datatype='real' name='[take_in_minus_rider_cost]' role='measure' type='quantitative' />
            <column caption='cash_FR' datatype='real' default-format='p0.00%' name='[total_FR (copia)_1163899049211830280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [order_status] != &quot;CONFIRMED&quot; AND [is_online_payment]=0 AND [hour_time]&gt;= [Parameters].[%migracion (copia)] THEN [total_orders] ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [hour_time] &gt;= [Parameters].[%migracion (copia)] and [is_online_payment]= 0 then&#13;&#10;[total_orders] ELSE 0 END&#13;&#10;)' />
            </column>
            <column caption='total_rejected_orders' datatype='integer' name='[total_confirmed_orders (copia)_1163899049209323524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;IF hour_time &gt;= [Parameters].[%migracion (copia)] and [order_status]!=&quot;CONFIRMED&quot; then [total_orders] else 0 end&#13;&#10;)' />
            </column>
            <column caption='total_take_in_minus' datatype='real' name='[total_confirmed_orders (copia)_1163899049220513808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;IF hour_time &gt;= [Parameters].[%migracion (copia)] and [order_status]=&quot;CONFIRMED&quot; then [take_in_minus_rider_cost] else 0 end&#13;&#10;)' />
            </column>
