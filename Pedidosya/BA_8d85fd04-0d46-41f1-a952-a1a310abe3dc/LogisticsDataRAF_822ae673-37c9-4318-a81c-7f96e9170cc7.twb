      <aliases enabled='yes' />
      <column caption='SHARE BAD BALANCE RIDERS RAF' datatype='real' name='[Calculation_1075234431209795584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([bad_balance_eu_raf])/SUM([bad_balance_eu])' />
      </column>
      <column caption='EPR' datatype='real' name='[Calculation_1665768929087057920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_eu])/SUM([riders_qty])' />
      </column>
      <column caption='Incentivo' datatype='real' name='[Calculation_1665768929104183298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pago_eu])/SUM([referees_paid])' />
      </column>
      <column caption='CPO RAF' datatype='real' name='[Calculation_1665768929112739843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pago_eu])/SUM([cantidad])' />
      </column>
      <column caption='RAF ACTIVATION' datatype='real' name='[Calculation_1665768929123246085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL(last_month_activated, 0) + IFNULL(month_activated, 0)) / SUM(total_hired)' />
      </column>
      <column caption='12W RETENTION' datatype='real' name='[Calculation_1665768929124057094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_tag_12w])/SUM(riders)' />
      </column>
      <column caption='RAF CVR %' datatype='real' name='[Calculation_1665768929445609479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(last_month_hired)+ SUM([month_hired]))/SUM([leads_raf])' />
      </column>
      <column caption='Monto de Incentivo / EPR' datatype='real' name='[Calculation_1665768929832226825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1665768929104183298]/[Calculation_1665768929087057920]' />
      </column>
      <column caption='RAF 12W RETENTION' datatype='real' name='[Calculation_1665768929847361547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_raf_count_12w])/SUM(rider_raf_count)' />
      </column>
      <column caption='HIRED/ LEADS ' datatype='real' name='[Calculation_1877719590103937024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([month_hired])/SUM([leads_raf])' />
      </column>
      <column caption='RAF CPO' datatype='real' name='[Calculation_1877719590107652097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pago_eu])/SUM([orders_cpo_existing])' />
