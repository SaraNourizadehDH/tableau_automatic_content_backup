          <relation connection='textscan.1e1gtic0u3v53r1dpxjoy09rw2xk' name='Clasificación RFM Riders.xlsx - Lista.csv' table='[Clasificación RFM Riders.xlsx - Lista#csv]' type='table'>
            <columns character-set='UTF-8' header='yes' locale='es_NI' separator=','>
              <column datatype='string' name='Categoría' ordinal='0' />
              <column datatype='integer' name='Score' ordinal='1' />
