            </properties>
          </object>
          <object caption='RFM_riders' id='RFM_riders_C192E2030E5B4DB4BFCD0378837FD9E9'>
            <properties context=''>
              <relation connection='bigquery.042p4pp1jvg7pe1h29f090bignl5' name='RFM_riders' table='[peya-nicaragua.user_alberto_salazar].[RFM_riders]' type='table' />
            </properties>
            <properties context='extract'>
              <relation name='RFM_riders_C192E2030E5B4DB4BFCD0378837FD9E9' table='[Extract].[RFM_riders_C192E2030E5B4DB4BFCD0378837FD9E9]' type='table' />
            </properties>
          </object>
          <object caption='Orders Riders' id='_0F14EE09BB914DA0857FFECB0F358554'>
            <properties context=''>
              <relation connection='bigquery.042p4pp1jvg7pe1h29f090bignl5' name='Consulta SQL personalizada' type='text'>SELECT&#13;
DATE_TRUNC(lo.created_date_local,month) month,&#13;
EXTRACT(HOUR FROM lo.created_at_local) hour_time,&#13;
CASE &#13;
WHEN EXTRACT(DAYOFWEEK FROM lo.created_date_local) = 1 THEN &quot;7.Sunday&quot;&#13;
ELSE CONCAT(EXTRACT(DAYOFWEEK FROM lo.created_date_local)-1,&quot;.&quot;,FORMAT_DATE(&quot;%A&quot;,lo.created_date_local)) END day_of_week,&#13;
d.rider_id,&#13;
COUNT (DISTINCT lo.peya_order_id) orders&#13;
FROM&#13;
`peya-bi-tools-pro.il_logistics.fact_logistic_orders` lo&#13;
LEFT JOIN UNNEST (deliveries) d on is_primary&#13;
WHERE lo.country.country_id = 20&#13;
and lo.created_date_local &gt;&gt;= &quot;2025-05-01&quot;&#13;
and lo.order_status = &quot;completed&quot;&#13;
group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='_0F14EE09BB914DA0857FFECB0F358554' table='[Extract].[_0F14EE09BB914DA0857FFECB0F358554]' type='table' />
            </properties>
          </object>
          <object caption='Depósitos Riders' id='_BA75B1C2A8B64A58AFFD0223BA145D7F'>
            <properties context=''>
              <relation connection='bigquery.042p4pp1jvg7pe1h29f090bignl5' name='Consulta SQL personalizada1' type='text'>SELECT &#13;
DISTINCT&#13;
    DATE_TRUNC(DATE(DATETIME(created_at, timezone)),MONTH) month,&#13;
    CASE &#13;
WHEN EXTRACT(DAYOFWEEK FROM DATE(DATETIME(created_at, timezone))) = 1 THEN &quot;7.Sunday&quot;&#13;
ELSE CONCAT(EXTRACT(DAYOFWEEK FROM DATE(DATETIME(created_at, timezone)))-1,&quot;.&quot;,FORMAT_DATE(&quot;%A&quot;,DATE(DATETIME(created_at, timezone)))) END day_of_week,&#13;
    rider_id,&#13;
    EXTRACT(HOUR FROM DATETIME(created_at,timezone)) hour_time,&#13;
    SUM(amount / 100) AS amount,&#13;
    COUNT(amount) depositos,&#13;
FROM `peya-data-origins-pro.cl_hurrier.rider_wallet`&#13;
WHERE&#13;
    DATE(DATETIME(created_at, timezone)) BETWEEN &quot;2025-05-01&quot; AND CURRENT_DATE()&#13;
    AND type = &apos;CASH_OUT&apos;&#13;
    AND country_code = &quot;ni&quot;&#13;
    --AND amount &gt;&gt; 0&#13;
    GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='_BA75B1C2A8B64A58AFFD0223BA145D7F' table='[Extract].[_BA75B1C2A8B64A58AFFD0223BA145D7F]' type='table' />
            </properties>
          </object>
        </objects>
