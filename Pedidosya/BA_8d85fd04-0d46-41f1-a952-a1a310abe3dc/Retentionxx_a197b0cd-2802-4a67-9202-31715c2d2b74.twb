      <column caption='Slicer Measure By Subs. Month' datatype='string' name='[Calculation_1664924494726549504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &apos;No Aggregation&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;Country&apos; THEN [country_name]&#13;&#10;    WHEN &apos;Free Trial Detail&apos; THEN [campaign_id]+&apos; - &apos;+[discount_detail]&#13;&#10;    WHEN &apos;Funded By&apos; THEN [founded_by]&#13;&#10;    WHEN &apos;Source&apos; THEN [source]&#13;&#10;    WHEN &apos;User Tier&apos; THEN [tier]&#13;&#10;    //WHEN &apos;Gender&apos; THEN [gender] &#13;&#10;    WHEN &apos;Income&apos; THEN [income] &#13;&#10;    //WHEN &apos;Age Range&apos; THEN [age_range] &#13;&#10;    WHEN &apos;Segment&apos; THEN [segment]&#13;&#10;    WHEN &apos;Adoption Type&apos; THEN [type]&#13;&#10;    WHEN &apos;User Intermittency&apos; THEN [inter_type]&#13;&#10;    WHEN &apos;Month&apos; THEN STR([month])&#13;&#10;    ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Subscription Month' datatype='string' name='[Calculation_1664924494727348225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year([start_date_month]))+&apos;-&apos;+str(month([start_date_month])) + &apos; (&apos; +LEFT(STR(DATENAME(&apos;month&apos;,[start_date_month])),3) + &apos;)&apos;' />
      </column>
      <column caption='M1 woFT' datatype='real' default-format='p0%' name='[Calculation_1664924494728122370]' role='measure' type='quantitative'>
