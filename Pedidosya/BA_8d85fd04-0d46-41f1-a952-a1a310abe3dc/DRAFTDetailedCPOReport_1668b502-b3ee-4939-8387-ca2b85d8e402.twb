                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='16851' id='47' type-v2='text' w='27656' x='49999' y='8000'>
                    <formatted-text>
                      <run fontcolor='#555555'>UTR Gains Glossary</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#555555'>PEYA UTR Gain</run>
                      <run fontcolor='#555555'>: Cuánto del cambio de UTR es explicado por un cambio en CPO</run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>Fórmula: CPH  Anterior * (1/CPO - 1/CPO Anterior) / (UTR - UTR Anterior)</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#555555'>Rider UTR Gain</run>
                      <run fontcolor='#555555'>: Cuánto del cambio de UTR es explicado por un cambio en CPH </run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>Fórmula: (CPH - CPH Anterior) / CPO Anterior / (UTR - UTR Anterior)</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#555555'>Mix UTR Gain</run>
                      <run fontcolor='#555555'>:  Cuánto del cambio de UTR no es asignable exclusivamente a un cambio en CPO o CPH, sino que a un movimiento en conjunto de ambos </run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>Fórmula: (CPH - CPH Anterior) * (1/CPO - 1/CPO Anterior)</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
              <zone h='74616' id='50' param='vert' type-v2='layout-flow' w='77122' x='533' y='24851'>
                <zone h='74616' id='43' type-v2='empty' w='77122' x='533' y='24851'>
