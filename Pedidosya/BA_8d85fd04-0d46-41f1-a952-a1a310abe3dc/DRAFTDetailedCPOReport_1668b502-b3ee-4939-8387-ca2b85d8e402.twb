      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='detailed_cpo_orders' id='CustomSQL_B421B0D2ABC24BDCA10DBF8847A1B46B'>
            <properties context=''>
              <relation connection='bigquery.0mr478i1kwha2010omr3z0fh5emg' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH

contract_type AS (

    SELECT DISTINCT

        *

    FROM (
      
        SELECT DISTINCT
            country_code AS country_code,
            rider_id,
            (SELECT type FROM UNNEST(contracts) WHERE status = 'VALID' AND CAST(start_at AS DATE) <<= CURRENT_DATE ORDER BY end_at DESC LIMIT 1) AS contract_type 
            
            FROM `peya-data-origins-pro.cl_hurrier.riders` 
        
        )
            
    WHERE contract_type not in ('PART_TIME')
      
),

google_distance AS (

    SELECT
        order_id,
        SUM(pickup_distance_google) AS pickup_distance_google,
        SUM(dropoff_distance_google) AS dropoff_distance_google,

    FROM `fulfillment-dwh-production.curated_data_shared.rider_payment_delivery_distance_service`

    WHERE 
        created_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1

    GROUP BY ALL

),

orders_bo AS (

    SELECT
        o.registered_date AS last_date,
        lo.country_code,
        lo.city_id,
        COUNT(DISTINCT o.order_id) AS confirmed_orders_bo


    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o

        INNER JOIN (
            
            SELECT 
                lo.peya_order_id,
                lo.country_code,
                lo.city.city_id

            FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` AS lo

                INNER JOIN UNNEST(lo.deliveries) AS d ON d.is_primary IS TRUE AND d.delivery_status = 'completed'

                INNER JOIN contract_type AS ct
                    ON ct.country_code = lo.country_code
                    AND ct.rider_id = d.rider_id

        ) AS lo ON lo.peya_order_id = o.order_id

    WHERE 
        o.registered_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
        AND o.order_status = 'CONFIRMED'
        AND o.with_logistics IS TRUE
    
    GROUP BY ALL

),

orders AS (

    SELECT
        DATE(d.rider_dropped_off_at, o.timezone) AS last_date,
        o.rider.country_code AS country_code,
        o.rider.city_id AS city_id,

        COUNT(IF(d.delivery_status = 'completed', o.rider.order_id, NULL)) AS orders_completed,

        SUM(IF(d.delivery_status = 'completed', d.pickup_distance_manhattan, 0)) AS sum_pickup_distance_manhattan,
        SUM(IF(d.delivery_status = 'completed', d.dropoff_distance_manhattan, 0)) AS sum_dropoff_distance_manhattan,

        SUM(IF(d.delivery_status = 'completed', gd.pickup_distance_google, 0)) AS sum_pickup_distance_google, -- campo nuevo
        SUM(IF(d.delivery_status = 'completed', gd.dropoff_distance_google, 0)) AS sum_dropoff_distance_google, -- campo nuevo

        COUNT(DISTINCT IF(d.delivery_status = 'completed', d.id, NULL)) AS deliveries_completed,
        COUNT(DISTINCT IF(d.stacked_deliveries >>= 1, d.id, NULL)) AS sum_stacked_deliveries,

        SUM(IF(o.rider.order_status = 'completed' AND o.is_preorder IS FALSE, o.rider.timings.actual_delivery_time, 0)) / 60 AS sum_actual_delivery_time,


    FROM `peya-data-origins-pro.cl_hurrier.orders_v2` AS o
    
        LEFT JOIN UNNEST(o.rider.deliveries) AS d ON is_primary IS TRUE

        INNER JOIN contract_type AS ct 
            ON ct.country_code = o.rider.country_code
            AND ct.rider_id = d.rider_id

        LEFT JOIN google_distance AS gd 
            ON gd.order_id = o.rider.order_id

    WHERE
        DATE(d.rider_dropped_off_at, o.timezone) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
        AND o.created_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1

    GROUP BY ALL
  
),

shifts AS (

    SELECT
      e.day AS last_date,
      s.country_code AS country_code,
      s.city_id AS city_id,

      SUM(e.duration / 60 / 60) AS sum_actual_evaluated_working_hours

    FROM `peya-data-origins-pro.cl_hurrier.shifts` AS s

        LEFT JOIN UNNEST(s.actual_working_time_by_date) AS e

        INNER JOIN contract_type AS ct 
            ON ct.country_code = s.country_code
            AND ct.rider_id = s.rider_id
      
    WHERE
        e.day >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
        AND e.status = 'ACCEPTED'
        AND s.shift_state = 'EVALUATED'

    GROUP BY ALL 

),

countries AS (

    SELECT DISTINCT
        c.country_code,
        c.country_name,
        ci.id AS city_id,
        ci.name AS city_name

    FROM `peya-data-origins-pro.cl_hurrier.countries` AS c
      
        LEFT JOIN UNNEST(cities) AS ci

    WHERE country_name != 'Colombia'

),

currency AS (

    SELECT DISTINCT
        DATE(c.currency_exchange_date) AS last_date_currency_exchange,
        LOWER(co.country_code) AS country_code_currency_exchange,
        c.rate_eu AS real_amount_euros

    FROM `peya-bi-tools-pro.il_core.dim_currency_exchange` AS c

        INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS co 
            ON c.currency_id = co.currency_id

)

SELECT
    COALESCE(o.last_date, s.last_date) AS last_date,

    COALESCE(o.country_code, s.country_code) AS country_code,
    co.country_name,

    COALESCE(o.city_id, s.city_id) AS city_id,
    co.city_name,

    o.orders_completed,
    o.sum_pickup_distance_manhattan,
    o.sum_dropoff_distance_manhattan,
    o.sum_pickup_distance_google,
    o.sum_dropoff_distance_google,
    o.deliveries_completed,
    o.sum_stacked_deliveries,
    o.sum_actual_delivery_time,
    s.sum_actual_evaluated_working_hours,
    bo.confirmed_orders_bo,

FROM orders AS o

    FULL OUTER JOIN shifts AS s 
        ON o.last_date = s.last_date
        AND o.country_code = s.country_code
        AND o.city_id = s.city_id

    INNER JOIN countries AS co
        ON COALESCE(o.country_code, s.country_code) = co.country_code
        AND COALESCE(o.city_id, s.city_id) = co.city_id

    INNER JOIN currency AS cu 
        ON (REPLACE(REPLACE(COALESCE(o.country_code, s.country_code),'ds_',''),'ds-','') = cu.country_code_currency_exchange
        AND DATE_TRUNC(COALESCE(o.last_date, s.last_date), MONTH) = cu.last_date_currency_exchange)

    LEFT JOIN orders_bo AS bo 
        ON COALESCE(o.last_date, s.last_date) = bo.last_date
        AND COALESCE(o.country_code, s.country_code) = bo.country_code
        AND COALESCE(o.city_id, s.city_id) = bo.city_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='detailed_cpo_payments' inline='true' name='federated.0qpue660y9p2291eu9udm1g6w50r' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.023a9e60yog02d1h1nnyu169w88d'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='automated_tables_reports' server-oauth='server-custom' username='leonardo.rosa@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.023a9e60yog02d1h1nnyu169w88d' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 

contract_names AS (

    SELECT DISTINCT
        r.rider_id,
        DATE(c.created_at) AS from_date,
        DATE(COALESCE(TIMESTAMP(LAG(c.created_at) OVER (PARTITION BY r.rider_id ORDER BY r.rider_id, c.created_at DESC)), TIMESTAMP(CURRENT_DATETIME + INTERVAL 1 DAY))) AS to_date,
        c.name AS contract_name
    
    FROM `peya-data-origins-pro.cl_hurrier.riders` AS r

        LEFT JOIN UNNEST(r.contracts) AS c

),

vehicle_names AS (

    SELECT DISTINCT
        r.rider_id,
        DATE(rv.created_at) AS from_date,
        DATE(COALESCE(TIMESTAMP(LAG(rv.created_at)  OVER (PARTITION BY r.rider_id ORDER BY r.rider_id, rv.created_at DESC)), TIMESTAMP(CURRENT_DATETIME + INTERVAL 1 DAY))) AS to_date,
        rv.name AS vehicle_name
      
    FROM `peya-data-origins-pro.cl_hurrier.riders` AS r
      
        LEFT JOIN UNNEST(r.rider_vehicles) AS rv

        LEFT JOIN UNNEST(r.contracts) AS c

),

geo AS (

    SELECT DISTINCT
        c.country_code AS country_country_code,
        ci.id AS country_city_id,
        ci.name AS city_name

    FROM `peya-data-origins-pro.cl_hurrier.countries` AS c
        
        LEFT JOIN UNNEST(cities) AS ci

),

riders AS (
    
    SELECT DISTINCT
        r.rider_id AS rider_rider_id,
        r.country_code AS rider_country_code,
        c.city_id,
        DATE(c.start_at) AS start_date,
        DATE(c.end_at) AS end_date
    
    FROM `peya-data-origins-pro.cl_hurrier.riders` AS r

        LEFT JOIN UNNEST(contracts) AS c

    WHERE c.status = 'VALID'

)

SELECT
    cm.last_date AS last_date_cost,
    cm.country_code AS country_code_cost,
    geo.cities_id AS city_id,
    COALESCE(cm.rider_contract_name, 'NA') AS rider_contract_name,
    COALESCE(cm.rider_vehicles_name, 'NA') AS rider_vehicles_name,
    geo.cities_name AS city_name,
    cm.paid_unit,
    SAFE_CAST(c.rate_eu AS FLOAT64) AS real_amount_euros,

    SUM(pago) AS total_payments,
    
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY', pago, 0)) AS total_payments_basic_delivery,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY', pago, 0)) AS total_payments_basic_delivery_per_del,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY' AND sub_type = 'COMPLETED_DELIVERIES', pago, 0)) AS total_payments_basic_delivery_per_del_cd,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY' AND sub_type = 'NEAR_DROPOFF_DELIVERIES', pago, 0)) AS total_payments_basic_delivery_per_del_ndo,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY' AND sub_type = 'PICKEDUP_DELIVERIES', pago, 0)) AS total_payments_basic_delivery_per_del_pud,
    
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_KM', pago, 0)) AS total_payments_basic_delivery_per_km,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_KM' AND sub_type = 'DROPOFF_DISTANCES', pago, 0)) AS total_payments_basic_delivery_per_km_do,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_KM' AND sub_type = 'PICKEDUP_DISTANCES', pago, 0)) AS total_payments_basic_delivery_per_km_pu,

    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'EVALUATION', pago, 0)) AS total_payments_basic_evaluation,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'EVALUATION' AND paid_unit = 'MINIMUM_PER_HOUR', pago, 0)) AS total_payments_basic_evaluation_mph,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'EVALUATION' AND paid_unit = 'PER_HOUR', pago, 0)) AS total_payments_basic_evaluation_ph,

    SUM(IF(cm.payment_source = 'Scoring' AND cm.payment_type = 'BATCH', pago, 0)) AS total_payments_scoring_batch,
    SUM(IF(cm.payment_source = 'Scoring' AND cm.payment_type = 'BATCH' AND paid_unit = 'PER_DELIVERY', pago, 0)) AS total_payments_scoring_batch_per_del,
    SUM(IF(cm.payment_source = 'Scoring' AND cm.payment_type = 'BATCH' AND paid_unit = 'PER_KM', pago, 0)) AS total_payments_scoring_batch_per_km,
    
    SUM(IF(cm.payment_source = 'Multipliers', pago, 0)) AS total_payments_multipliers,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'RUSH_BONUS', pago, 0)) AS total_payments_multipliers_rush_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'NIGHT_BONUS', pago, 0)) AS total_payments_multipliers_night_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'HOLIDAY_BONUS', pago, 0)) AS total_payments_multipliers_holiday_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'SNOW_BONUS', pago, 0)) AS total_payments_multipliers_snow_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'RIDER_EARNING_MULTIPLIER', pago, 0)) AS total_payments_multipliers_rider_earning_multiplier,
    
    SUM(IF(cm.payment_source = 'Quest' AND cm.payment_type = 'PER_DELIVERY', pago, 0)) AS total_payments_quest_per_delivery,
    SUM(IF(cm.payment_source = 'Quest' AND cm.payment_type = 'PER_HOUR', pago, 0)) AS total_payments_quest_per_hour,
    SUM(IF(cm.payment_source = 'Referral', pago, 0)) AS total_payments_referral,
    SUM(IF(cm.payment_source = 'NHB', pago, 0)) AS total_payments_nhb,
    SUM(IF(cm.payment_source = 'Special Payments', pago, 0)) AS total_payments_special_payments,

    SUM(tips) AS total_payments_tips,

FROM (

        SELECT
            'Basic' AS payment_source,
            t.country_code,
            b.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(b.created_at, t.timezone) AS last_date,
            b.payment_type,
            '' AS multiplier_type,
            br.type AS paid_unit,
            br.sub_type,
            SUM(b.total - IFNULL((SELECT SUM(m.value) FROM UNNEST(b.bonus_multipliers) AS m), 0)) AS pago,
            NULL AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t
            
            LEFT JOIN UNNEST(payment_details.basic) AS b
        
            LEFT JOIN `peya-data-origins-pro.cl_hurrier.payments_basic_rules` AS br 
                ON br.id = b.payment_rule_id 
                AND br.country_code = t.country_code

            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(b.created_at, t.timezone)
                AND c.to_date >> DATE(b.created_at, t.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(b.created_at, t.timezone)
                AND rv.to_date >> DATE(b.created_at, t.timezone)
        
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(b.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(b.created_at, t.timezone) << CURRENT_DATE()
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Multipliers' AS payment_source,
            t.country_code,
            b.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(b.created_at, t.timezone) AS last_date,
            '' AS payment_type,
            m.type AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(m.value) AS FLOAT64) AS pago,
            NULL AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t
            
            LEFT JOIN UNNEST(payment_details.basic) AS b

            LEFT JOIN UNNEST(b.bonus_multipliers) AS m
        
            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(b.created_at, t.timezone)
                AND c.to_date >> DATE(b.created_at, t.timezone)
                
            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(b.created_at, t.timezone)
                AND rv.to_date >> DATE(b.created_at, t.timezone)
        
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(b.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(b.created_at, t.timezone) << CURRENT_DATE()
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Quest' AS payment_source,
            t.country_code,
            q.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(q.created_at,t.timezone) AS last_date,
            q.payment_type,
            '' AS multiplier_type,
            qr.type AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t
            
            LEFT JOIN UNNEST(payment_details.quest) AS q
        
            LEFT JOIN `peya-data-origins-pro.cl_hurrier.payments_quest_rules` AS qr 
                ON qr.id = q.payment_rule_id 
                AND qr.country_code = t.country_code

            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(q.created_at, t.timezone)
                AND c.to_date >> DATE(q.created_at, t.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(q.created_at, t.timezone)
                AND rv.to_date >> DATE(q.created_at, t.timezone)
        
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(q.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(q.created_at, t.timezone) << CURRENT_DATE()
            AND q.status <<>> 'UNCERTAIN'
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Scoring' AS payment_source,
            t.country_code,
            s.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(s.created_at,t.timezone) AS last_date,
            s.payment_type,
            '' AS multiplier_type,
            sr.paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t

            LEFT JOIN UNNEST(payment_details.scoring) AS s
        
            LEFT JOIN `peya-data-origins-pro.cl_hurrier.payments_scoring_rules` AS sr 
                ON sr.id = s.payment_rule_id 
                AND sr.country_code = t.country_code

            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(s.created_at, t.timezone)
                AND c.to_date >> DATE(s.created_at, t.timezone)
                
            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(s.created_at, t.timezone)
                AND rv.to_date >> DATE(s.created_at, t.timezone)
            
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(s.created_at,t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(s.created_at,t.timezone) << CURRENT_DATE()
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Referral' AS payment_source,
            raf.country_code,
            raf.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(pd.created_at, raf.timezone) AS last_date,
            '' AS payment_type,
            '' AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_referral_payments` AS raf

            LEFT JOIN UNNEST(payment_details) AS pd

            LEFT JOIN contract_names AS c
                ON c.rider_id = raf.rider_id
                AND c.from_date <<= DATE(pd.created_at, raf.timezone)
                AND c.to_date >> DATE(pd.created_at, raf.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = raf.rider_id
                AND rv.from_date <<= DATE(pd.created_at, raf.timezone)
                AND rv.to_date >> DATE(pd.created_at, raf.timezone)
        
        WHERE 
            DATE(raf.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at, raf.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at, raf.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'NHB' AS payment_source,
            nhb.country_code,
            geo.country_city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(pd.created_at, nhb.timezone) AS last_date,
            '' AS payment_type,
            '' AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(pd.total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_new_hire_benefit_payments` AS nhb

            LEFT JOIN UNNEST(payment_details) AS pd

            LEFT JOIN contract_names AS c
                ON c.rider_id = nhb.rider_id
                AND c.from_date <<= DATE(pd.created_at, nhb.timezone)
                AND c.to_date >> DATE(pd.created_at, nhb.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = nhb.rider_id
                AND rv.from_date <<= DATE(pd.created_at, nhb.timezone)
                AND rv.to_date >> DATE(pd.created_at, nhb.timezone)

            LEFT JOIN riders  AS r
                ON nhb.created_date >>= r.start_date
                AND nhb.created_date << r.end_date
                AND nhb.country_code = r.rider_country_code
                AND nhb.rider_id = r.rider_rider_id
                
            INNER JOIN geo 
                ON nhb.country_code = geo.country_country_code 
                AND r.city_id = country_city_id

        WHERE 
            DATE(nhb.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at, nhb.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at, nhb.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')

        GROUP BY ALL

    UNION ALL

        SELECT 
            'Tips' AS payment_source,
            t.country_code,
            geo.country_city_id AS city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(pd.created_at, t.timezone) AS last_date,
            '' AS payment_type,
            '' AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            NULL AS pago,
            SAFE_CAST(SUM(pd.total) AS FLOAT64) AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_tip_payments` AS t
            
            LEFT JOIN UNNEST(payment_details) AS pd
        
            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(pd.created_at, t.timezone)
                AND c.to_date >> DATE(pd.created_at, t.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(pd.created_at, t.timezone)
                AND rv.to_date >> DATE(pd.created_at, t.timezone)

            INNER JOIN `peya-data-origins-pro.cl_hurrier.orders_v2` AS o 
                ON t.country_code = o.rider.country_code
                AND pd.order_id = o.rider.order_id
                AND o.created_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1

            INNER JOIN geo 
                ON t.country_code = geo.country_country_code
                AND o.rider.city_id = country_city_id
                
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at, t.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')
            AND o.is_rider_order IS TRUE

        GROUP BY ALL

    UNION ALL

        SELECT 'Special Payments' AS payment_source,
        raf.country_code,
        geo.country_city_id AS city_id,
        c.contract_name AS rider_contract_name,
        rv.vehicle_name AS rider_vehicles_name,
        DATE(pd.created_at,raf.timezone) AS last_date,
        '' AS payment_type,
        '' AS multiplier_type,
        '' AS paid_unit,
        '' AS sub_type,
        SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
        NULL AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_special_payments` AS raf
        
            LEFT JOIN UNNEST(payment_details) AS pd

            LEFT JOIN contract_names AS c
                ON c.rider_id = raf.rider_id
                AND c.from_date <<= DATE(pd.created_at, raf.timezone)
                AND c.to_date >> DATE(pd.created_at, raf.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = raf.rider_id
                AND rv.from_date <<= DATE(pd.created_at, raf.timezone)
                AND rv.to_date >> DATE(pd.created_at, raf.timezone)

            LEFT JOIN riders AS r
                ON raf.created_date >>= r.start_date
                AND raf.created_date << r.end_date
                AND raf.country_code = r.rider_country_code
                AND raf.rider_id = r.rider_rider_id

            INNER JOIN geo
                ON raf.country_code = geo.country_country_code
                AND r.city_id = country_city_id

        WHERE 
            DATE(raf.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at,raf.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at,raf.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')

        GROUP BY ALL

) AS cm

    INNER JOIN (

        SELECT 
            dc.country_id, 
            c.country_code, 
            c.country_name,
            ci.id AS cities_id, 
            ci.name AS cities_name, 
            dc.currency_id

        FROM `peya-data-origins-pro.cl_hurrier.countries` AS c
        
            LEFT JOIN UNNEST(cities) AS ci

            INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS dc
                ON LOWER(dc.country_short_name) = REPLACE(REPLACE(LOWER(c.country_code), 'ds_', ''),'ds-', '')

        WHERE ci.is_active IS TRUE
        
    ) AS geo 
    
    ON geo.country_code = cm.country_code 
    AND geo.cities_id = cm.city_id

    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` AS c 
        ON SAFE_CAST(c.currency_id AS INT64) = geo.currency_id 
        AND c.date_id = SAFE_CAST(REPLACE(SAFE_CAST(DATE_TRUNC(cm.last_date, MONTH) AS STRING), '-','') AS INT64)

GROUP BY ALL

HAVING SUM(COALESCE(pago, 0)) + SUM(COALESCE(tips, 0)) <<>> 0]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.023a9e60yog02d1h1nnyu169w88d' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 

contract_names AS (

    SELECT DISTINCT
        r.rider_id,
        DATE(c.created_at) AS from_date,
        DATE(COALESCE(TIMESTAMP(LAG(c.created_at) OVER (PARTITION BY r.rider_id ORDER BY r.rider_id, c.created_at DESC)), TIMESTAMP(CURRENT_DATETIME + INTERVAL 1 DAY))) AS to_date,
        c.name AS contract_name
    
    FROM `peya-data-origins-pro.cl_hurrier.riders` AS r

        LEFT JOIN UNNEST(r.contracts) AS c

),

vehicle_names AS (

    SELECT DISTINCT
        r.rider_id,
        DATE(rv.created_at) AS from_date,
        DATE(COALESCE(TIMESTAMP(LAG(rv.created_at)  OVER (PARTITION BY r.rider_id ORDER BY r.rider_id, rv.created_at DESC)), TIMESTAMP(CURRENT_DATETIME + INTERVAL 1 DAY))) AS to_date,
        rv.name AS vehicle_name
      
    FROM `peya-data-origins-pro.cl_hurrier.riders` AS r
      
        LEFT JOIN UNNEST(r.rider_vehicles) AS rv

        LEFT JOIN UNNEST(r.contracts) AS c

),

geo AS (

    SELECT DISTINCT
        c.country_code AS country_country_code,
        ci.id AS country_city_id,
        ci.name AS city_name

    FROM `peya-data-origins-pro.cl_hurrier.countries` AS c
        
        LEFT JOIN UNNEST(cities) AS ci

),

riders AS (
    
    SELECT DISTINCT
        r.rider_id AS rider_rider_id,
        r.country_code AS rider_country_code,
        c.city_id,
        DATE(c.start_at) AS start_date,
        DATE(c.end_at) AS end_date
    
    FROM `peya-data-origins-pro.cl_hurrier.riders` AS r

        LEFT JOIN UNNEST(contracts) AS c

    WHERE c.status = 'VALID'

)

SELECT
    cm.last_date AS last_date_cost,
    cm.country_code AS country_code_cost,
    geo.cities_id AS city_id,
    COALESCE(cm.rider_contract_name, 'NA') AS rider_contract_name,
    COALESCE(cm.rider_vehicles_name, 'NA') AS rider_vehicles_name,
    geo.cities_name AS city_name,
    cm.paid_unit,
    SAFE_CAST(c.rate_eu AS FLOAT64) AS real_amount_euros,

    SUM(pago) AS total_payments,
    
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY', pago, 0)) AS total_payments_basic_delivery,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY', pago, 0)) AS total_payments_basic_delivery_per_del,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY' AND sub_type = 'COMPLETED_DELIVERIES', pago, 0)) AS total_payments_basic_delivery_per_del_cd,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY' AND sub_type = 'NEAR_DROPOFF_DELIVERIES', pago, 0)) AS total_payments_basic_delivery_per_del_ndo,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_DELIVERY' AND sub_type = 'PICKEDUP_DELIVERIES', pago, 0)) AS total_payments_basic_delivery_per_del_pud,
    
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_KM', pago, 0)) AS total_payments_basic_delivery_per_km,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_KM' AND sub_type = 'DROPOFF_DISTANCES', pago, 0)) AS total_payments_basic_delivery_per_km_do,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'DELIVERY' AND paid_unit = 'PER_KM' AND sub_type = 'PICKEDUP_DISTANCES', pago, 0)) AS total_payments_basic_delivery_per_km_pu,

    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'EVALUATION', pago, 0)) AS total_payments_basic_evaluation,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'EVALUATION' AND paid_unit = 'MINIMUM_PER_HOUR', pago, 0)) AS total_payments_basic_evaluation_mph,
    SUM(IF(cm.payment_source = 'Basic' AND cm.payment_type = 'EVALUATION' AND paid_unit = 'PER_HOUR', pago, 0)) AS total_payments_basic_evaluation_ph,

    SUM(IF(cm.payment_source = 'Scoring' AND cm.payment_type = 'BATCH', pago, 0)) AS total_payments_scoring_batch,
    SUM(IF(cm.payment_source = 'Scoring' AND cm.payment_type = 'BATCH' AND paid_unit = 'PER_DELIVERY', pago, 0)) AS total_payments_scoring_batch_per_del,
    SUM(IF(cm.payment_source = 'Scoring' AND cm.payment_type = 'BATCH' AND paid_unit = 'PER_KM', pago, 0)) AS total_payments_scoring_batch_per_km,
    
    SUM(IF(cm.payment_source = 'Multipliers', pago, 0)) AS total_payments_multipliers,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'RUSH_BONUS', pago, 0)) AS total_payments_multipliers_rush_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'NIGHT_BONUS', pago, 0)) AS total_payments_multipliers_night_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'HOLIDAY_BONUS', pago, 0)) AS total_payments_multipliers_holiday_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'SNOW_BONUS', pago, 0)) AS total_payments_multipliers_snow_bonus,
    SUM(IF(cm.payment_source = 'Multipliers' AND cm.multiplier_type = 'RIDER_EARNING_MULTIPLIER', pago, 0)) AS total_payments_multipliers_rider_earning_multiplier,
    
    SUM(IF(cm.payment_source = 'Quest' AND cm.payment_type = 'PER_DELIVERY', pago, 0)) AS total_payments_quest_per_delivery,
    SUM(IF(cm.payment_source = 'Quest' AND cm.payment_type = 'PER_HOUR', pago, 0)) AS total_payments_quest_per_hour,
    SUM(IF(cm.payment_source = 'Referral', pago, 0)) AS total_payments_referral,
    SUM(IF(cm.payment_source = 'NHB', pago, 0)) AS total_payments_nhb,
    SUM(IF(cm.payment_source = 'Special Payments', pago, 0)) AS total_payments_special_payments,

    SUM(tips) AS total_payments_tips,

FROM (

        SELECT
            'Basic' AS payment_source,
            t.country_code,
            b.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(b.created_at, t.timezone) AS last_date,
            b.payment_type,
            '' AS multiplier_type,
            br.type AS paid_unit,
            br.sub_type,
            SUM(b.total - IFNULL((SELECT SUM(m.value) FROM UNNEST(b.bonus_multipliers) AS m), 0)) AS pago,
            NULL AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t
            
            LEFT JOIN UNNEST(payment_details.basic) AS b
        
            LEFT JOIN `peya-data-origins-pro.cl_hurrier.payments_basic_rules` AS br 
                ON br.id = b.payment_rule_id 
                AND br.country_code = t.country_code

            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(b.created_at, t.timezone)
                AND c.to_date >> DATE(b.created_at, t.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(b.created_at, t.timezone)
                AND rv.to_date >> DATE(b.created_at, t.timezone)
        
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(b.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(b.created_at, t.timezone) << CURRENT_DATE()
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Multipliers' AS payment_source,
            t.country_code,
            b.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(b.created_at, t.timezone) AS last_date,
            '' AS payment_type,
            m.type AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(m.value) AS FLOAT64) AS pago,
            NULL AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t
            
            LEFT JOIN UNNEST(payment_details.basic) AS b

            LEFT JOIN UNNEST(b.bonus_multipliers) AS m
        
            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(b.created_at, t.timezone)
                AND c.to_date >> DATE(b.created_at, t.timezone)
                
            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(b.created_at, t.timezone)
                AND rv.to_date >> DATE(b.created_at, t.timezone)
        
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(b.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(b.created_at, t.timezone) << CURRENT_DATE()
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Quest' AS payment_source,
            t.country_code,
            q.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(q.created_at,t.timezone) AS last_date,
            q.payment_type,
            '' AS multiplier_type,
            qr.type AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t
            
            LEFT JOIN UNNEST(payment_details.quest) AS q
        
            LEFT JOIN `peya-data-origins-pro.cl_hurrier.payments_quest_rules` AS qr 
                ON qr.id = q.payment_rule_id 
                AND qr.country_code = t.country_code

            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(q.created_at, t.timezone)
                AND c.to_date >> DATE(q.created_at, t.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(q.created_at, t.timezone)
                AND rv.to_date >> DATE(q.created_at, t.timezone)
        
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(q.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(q.created_at, t.timezone) << CURRENT_DATE()
            AND q.status <<>> 'UNCERTAIN'
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Scoring' AS payment_source,
            t.country_code,
            s.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(s.created_at,t.timezone) AS last_date,
            s.payment_type,
            '' AS multiplier_type,
            sr.paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_payments` AS t

            LEFT JOIN UNNEST(payment_details.scoring) AS s
        
            LEFT JOIN `peya-data-origins-pro.cl_hurrier.payments_scoring_rules` AS sr 
                ON sr.id = s.payment_rule_id 
                AND sr.country_code = t.country_code

            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(s.created_at, t.timezone)
                AND c.to_date >> DATE(s.created_at, t.timezone)
                
            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(s.created_at, t.timezone)
                AND rv.to_date >> DATE(s.created_at, t.timezone)
            
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(s.created_at,t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(s.created_at,t.timezone) << CURRENT_DATE()
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'Referral' AS payment_source,
            raf.country_code,
            raf.city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(pd.created_at, raf.timezone) AS last_date,
            '' AS payment_type,
            '' AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_referral_payments` AS raf

            LEFT JOIN UNNEST(payment_details) AS pd

            LEFT JOIN contract_names AS c
                ON c.rider_id = raf.rider_id
                AND c.from_date <<= DATE(pd.created_at, raf.timezone)
                AND c.to_date >> DATE(pd.created_at, raf.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = raf.rider_id
                AND rv.from_date <<= DATE(pd.created_at, raf.timezone)
                AND rv.to_date >> DATE(pd.created_at, raf.timezone)
        
        WHERE 
            DATE(raf.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at, raf.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at, raf.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')
        
        GROUP BY ALL

    UNION ALL

        SELECT 
            'NHB' AS payment_source,
            nhb.country_code,
            geo.country_city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(pd.created_at, nhb.timezone) AS last_date,
            '' AS payment_type,
            '' AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            SAFE_CAST(SUM(pd.total) AS FLOAT64) AS pago,
            NULL AS tips
        
        FROM `peya-data-origins-pro.cl_hurrier.rider_new_hire_benefit_payments` AS nhb

            LEFT JOIN UNNEST(payment_details) AS pd

            LEFT JOIN contract_names AS c
                ON c.rider_id = nhb.rider_id
                AND c.from_date <<= DATE(pd.created_at, nhb.timezone)
                AND c.to_date >> DATE(pd.created_at, nhb.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = nhb.rider_id
                AND rv.from_date <<= DATE(pd.created_at, nhb.timezone)
                AND rv.to_date >> DATE(pd.created_at, nhb.timezone)

            LEFT JOIN riders  AS r
                ON nhb.created_date >>= r.start_date
                AND nhb.created_date << r.end_date
                AND nhb.country_code = r.rider_country_code
                AND nhb.rider_id = r.rider_rider_id
                
            INNER JOIN geo 
                ON nhb.country_code = geo.country_country_code 
                AND r.city_id = country_city_id

        WHERE 
            DATE(nhb.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at, nhb.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at, nhb.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')

        GROUP BY ALL

    UNION ALL

        SELECT 
            'Tips' AS payment_source,
            t.country_code,
            geo.country_city_id AS city_id,
            c.contract_name AS rider_contract_name,
            rv.vehicle_name AS rider_vehicles_name,
            DATE(pd.created_at, t.timezone) AS last_date,
            '' AS payment_type,
            '' AS multiplier_type,
            '' AS paid_unit,
            '' AS sub_type,
            NULL AS pago,
            SAFE_CAST(SUM(pd.total) AS FLOAT64) AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_tip_payments` AS t
            
            LEFT JOIN UNNEST(payment_details) AS pd
        
            LEFT JOIN contract_names AS c
                ON c.rider_id = t.rider_id
                AND c.from_date <<= DATE(pd.created_at, t.timezone)
                AND c.to_date >> DATE(pd.created_at, t.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = t.rider_id
                AND rv.from_date <<= DATE(pd.created_at, t.timezone)
                AND rv.to_date >> DATE(pd.created_at, t.timezone)

            INNER JOIN `peya-data-origins-pro.cl_hurrier.orders_v2` AS o 
                ON t.country_code = o.rider.country_code
                AND pd.order_id = o.rider.order_id
                AND o.created_date >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1

            INNER JOIN geo 
                ON t.country_code = geo.country_country_code
                AND o.rider.city_id = country_city_id
                
        WHERE 
            DATE(t.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at, t.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at, t.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')
            AND o.is_rider_order IS TRUE

        GROUP BY ALL

    UNION ALL

        SELECT 'Special Payments' AS payment_source,
        raf.country_code,
        geo.country_city_id AS city_id,
        c.contract_name AS rider_contract_name,
        rv.vehicle_name AS rider_vehicles_name,
        DATE(pd.created_at,raf.timezone) AS last_date,
        '' AS payment_type,
        '' AS multiplier_type,
        '' AS paid_unit,
        '' AS sub_type,
        SAFE_CAST(SUM(total) AS FLOAT64) AS pago,
        NULL AS tips

        FROM `peya-data-origins-pro.cl_hurrier.rider_special_payments` AS raf
        
            LEFT JOIN UNNEST(payment_details) AS pd

            LEFT JOIN contract_names AS c
                ON c.rider_id = raf.rider_id
                AND c.from_date <<= DATE(pd.created_at, raf.timezone)
                AND c.to_date >> DATE(pd.created_at, raf.timezone)

            LEFT JOIN vehicle_names AS rv
                ON rv.rider_id = raf.rider_id
                AND rv.from_date <<= DATE(pd.created_at, raf.timezone)
                AND rv.to_date >> DATE(pd.created_at, raf.timezone)

            LEFT JOIN riders AS r
                ON raf.created_date >>= r.start_date
                AND raf.created_date << r.end_date
                AND raf.country_code = r.rider_country_code
                AND raf.rider_id = r.rider_rider_id

            INNER JOIN geo
                ON raf.country_code = geo.country_country_code
                AND r.city_id = country_city_id

        WHERE 
            DATE(raf.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH) - 1
            AND DATE(pd.created_at,raf.timezone) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -4 MONTH), MONTH)
            AND DATE(pd.created_at,raf.timezone) << CURRENT_DATE()
            AND pd.status IN ('PAID','PENDING')

        GROUP BY ALL

) AS cm

    INNER JOIN (

        SELECT 
            dc.country_id, 
            c.country_code, 
            c.country_name,
            ci.id AS cities_id, 
            ci.name AS cities_name, 
            dc.currency_id

        FROM `peya-data-origins-pro.cl_hurrier.countries` AS c
        
            LEFT JOIN UNNEST(cities) AS ci

            INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS dc
                ON LOWER(dc.country_short_name) = REPLACE(REPLACE(LOWER(c.country_code), 'ds_', ''),'ds-', '')

        WHERE ci.is_active IS TRUE
        
    ) AS geo 
    
    ON geo.country_code = cm.country_code 
    AND geo.cities_id = cm.city_id

    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` AS c 
        ON SAFE_CAST(c.currency_id AS INT64) = geo.currency_id 
        AND c.date_id = SAFE_CAST(REPLACE(SAFE_CAST(DATE_TRUNC(cm.last_date, MONTH) AS STRING), '-','') AS INT64)

GROUP BY ALL

HAVING SUM(COALESCE(pago, 0)) + SUM(COALESCE(tips, 0)) <<>> 0]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
