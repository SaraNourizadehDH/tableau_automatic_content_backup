      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='detailed_cpo_vertical' id='_7D5D3FF8DF9C4BF0A8DD59DBEACF96A1'>
            <properties context=''>
              <relation connection='bigquery.15sje42031dnrf12svpzh1i59d4l' name='Consulta SQL personalizada' type='text'>SELECT&#13;
    created_date,&#13;
    country_code,&#13;
    city_id,&#13;
&#13;
    vertical_type,&#13;
&#13;
    SUM(cpo_with_adjustments_lc) AS cpo_with_adjustments_lc,&#13;
    SUM(cpo_without_adjustments_lc) AS cpo_without_adjustments_lc,&#13;
&#13;
    SUM(cpo_with_adjustments_eu) AS cpo_with_adjustments_eu,&#13;
    SUM(cpo_without_adjustments_eu) AS cpo_without_adjustments_eu,&#13;
&#13;
    SUM(is_stacked) AS is_stacked,&#13;
    SUM(pickup_distance_manhattan) AS pickup_distance_manhattan,&#13;
    SUM(dropoff_distance_manhattan) AS dropoff_distance_manhattan,&#13;
    COUNT(DISTINCT platform_order_code) AS platform_order_code,&#13;
&#13;
FROM `peya-datamarts-pro.dm_cpo.overall_cpo` AS cpo&#13;
&#13;
WHERE cpo.created_date &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL - 4 MONTH)&#13;
&#13;
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
