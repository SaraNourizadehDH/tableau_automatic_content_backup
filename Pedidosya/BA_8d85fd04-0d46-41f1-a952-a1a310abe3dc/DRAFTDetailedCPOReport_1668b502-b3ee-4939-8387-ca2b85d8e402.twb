            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wk8zjy17f8tn2190jmrj0umkax2'>
            <column caption='PU Distance' datatype='real' name='[Calculation_6694037901070589952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([pickup_distance_manhattan]) / SUM([platform_order_code])) / 1000' />
            </column>
            <column caption='DO Distance' datatype='real' name='[Calculation_6694037901072437249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([dropoff_distance_manhattan]) / SUM([platform_order_code])) / 1000' />
            </column>
            <column caption='Time Period' datatype='datetime' name='[Calculation_6694037901077725187]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[sum_redeemed_voucher_amount Parámetro], [created_date])' />
            </column>
            <column caption='CPO by Currency' datatype='real' name='[Calculation_6694037901079420932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[View (copia)]= &quot;local&quot; &#10;THEN ([cpo_with_adjustments_lc])&#10;ELSEIF [Parameters].[View (copia)]= &quot;euro&quot; &#10;THEN [cpo_with_adjustments_eu]&#10;END' />
            </column>
            <column caption='CPO' datatype='real' name='[Calculation_6694037901079805957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6694037901079420932]) / SUM([platform_order_code])' />
            </column>
            <column caption='% Stacking' datatype='real' name='[Calculation_6694037901080223750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_stacked]) / SUM([platform_order_code])' />
            </column>
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[cpo_with_adjustments_eu]' role='measure' type='quantitative' />
            <column datatype='real' name='[cpo_with_adjustments_lc]' role='measure' type='quantitative' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[dropoff_distance_manhattan]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6694037901077725187]' derivation='Day' name='[dy:Calculation_6694037901077725187:ok]' pivot='key' type='ordinal' />
