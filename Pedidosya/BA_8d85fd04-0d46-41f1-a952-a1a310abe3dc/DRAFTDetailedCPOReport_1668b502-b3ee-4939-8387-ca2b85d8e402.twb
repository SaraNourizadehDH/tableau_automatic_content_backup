      <table>
        <view>
          <datasources>
            <datasource caption='detailed_cpo_vertical' name='federated.1wk8zjy17f8tn2190jmrj0umkax2' />
            <datasource caption='Parámetros' name='Parameters' />
            <datasource caption='detailed_cpo_orders' name='federated.1s3awti0zq24lu1h65s980dt1kvq' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Euro' caption='Currency' datatype='string' name='[View (copia)]' param-domain-type='list' role='measure' type='nominal' value='&quot;euro&quot;'>
              <calculation class='tableau' formula='&quot;euro&quot;' />
              <aliases>
                <alias key='&quot;euro&quot;' value='Euro' />
                <alias key='&quot;local&quot;' value='Local' />
              </aliases>
            </column>
            <column alias='Weekly' caption='View' datatype='string' name='[sum_redeemed_voucher_amount Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1s3awti0zq24lu1h65s980dt1kvq'>
