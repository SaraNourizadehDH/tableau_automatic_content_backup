      <column caption='Avg. Cost Per Hour' datatype='real' name='[Avg. Cost Per Order (copy)_1298162633689354251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([country_name]) = 1 AND [Parameters].[View (copia)]= &quot;local&quot; &#13;&#10;THEN SUM([federated.0qpue660y9p2291eu9udm1g6w50r].[total_payments])/sum([sum_actual_evaluated_working_hours])&#13;&#10;ELSEIF [Parameters].[View (copia)]= &quot;euro&quot; &#13;&#10;THEN SUM([federated.0qpue660y9p2291eu9udm1g6w50r].[Calculation_1693634990420885504])/sum([sum_actual_evaluated_working_hours])&#13;&#10;END' />
