    <worksheet name='ADOPTION'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>ADOPTION RATE &amp; ADOPTION COVERAGE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='work_now_shifts' name='federated.13c7hl10lm6z4f11tvhgv0xbjybt' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='GRANULARITY' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13c7hl10lm6z4f11tvhgv0xbjybt'>
            <column caption='GRANULARITY' datatype='datetime' name='[Calculation_1780892237956083715]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;  WHEN &quot;Daily&quot; THEN DATE([created_date])&#13;&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date])&#13;&#10;  WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [created_date])&#13;&#10;END' />
            </column>
            <column caption='ADOPTION RATE' datatype='real' name='[Calculation_1780892237994586127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IIF([orders_accepted] &gt; 0 AND [shift_tag] = &apos;KIWI&apos;, &#13;&#10;        1, &#13;&#10;        0)&#13;&#10;) &#13;&#10;/ COUNTD([rider_id])' />
            </column>
            <column caption='ADOPTION COVERAGE' datatype='real' name='[Calculation_1780892238010490896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IIF([orders_accepted] &gt; 1 AND [shift_tag] = &apos;KIWI&apos;, &#13;&#10;        1, &#13;&#10;        0)&#13;&#10;) &#13;&#10;/ COUNTD([rider_id])' />
            </column>
            <column-instance column='[Calculation_1780892237956083715]' derivation='Attribute' name='[attr:Calculation_1780892237956083715:ok]' pivot='key' type='ordinal' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
