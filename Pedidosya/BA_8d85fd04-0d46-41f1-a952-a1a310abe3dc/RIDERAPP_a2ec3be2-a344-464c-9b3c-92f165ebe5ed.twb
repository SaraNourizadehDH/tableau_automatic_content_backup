              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;  WHEN &quot;Daily&quot; THEN DATE([fecha])&#13;&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [fecha])&#13;&#10;  WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [fecha])&#13;&#10;END' />
