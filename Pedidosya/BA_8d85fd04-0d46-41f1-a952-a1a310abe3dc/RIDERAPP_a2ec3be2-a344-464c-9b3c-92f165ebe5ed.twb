      <aliases enabled='yes' />
      <column caption='GRANULARITY' datatype='datetime' name='[Calculation_1780892237956083715]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;  WHEN &quot;Daily&quot; THEN DATE([created_date])&#13;&#10;  WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date])&#13;&#10;  WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [created_date])&#13;&#10;END' />
      </column>
      <column caption='ADOPTION RATE' datatype='real' name='[Calculation_1780892237994586127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF([orders_accepted] &gt; 0 AND [shift_tag] = &apos;KIWI&apos;, &#13;&#10;        1, &#13;&#10;        0)&#13;&#10;) &#13;&#10;/ COUNTD([rider_id])' />
      </column>
      <column caption='ADOPTION COVERAGE' datatype='real' name='[Calculation_1780892238010490896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF([orders_accepted] &gt; 1 AND [shift_tag] = &apos;KIWI&apos;, &#13;&#10;        1, &#13;&#10;        0)&#13;&#10;) &#13;&#10;/ COUNTD([rider_id])' />
      </column>
      <column caption='ACTUAL vs PLANNED (TOTAL)' datatype='real' name='[Calculation_1780892238011944977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(actual) / SUM(planned)' />
      </column>
      <column caption='ACTUAL vs PLANNED (WN)' datatype='real' name='[Calculation_1780892238012719122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(wn_actual) / SUM(wn_planned)' />
      </column>
      <column caption='ACCEPTANCE RATE' datatype='real' name='[Calculation_1780892238014341140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(orders_accepted)/SUM(orders_notified)' />
      </column>
      <column caption='SHIFT TAG CLEAN' datatype='string' name='[Calculation_1780892238016413718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [shift_tag] = &apos;KIWI&apos; THEN &apos;KIWI&apos;&#13;&#10;ELSEIF [shift_tag] = &apos;APPLICATION&apos; THEN &apos;NO KIWI&apos;&#13;&#10;ELSEIF [shift_tag] = &apos;CSV&apos; THEN &apos;NO KIWI&apos;&#13;&#10;ELSEIF [shift_tag] = &apos;HURRIER&apos; THEN &apos;NO KIWI&apos;&#13;&#10;ELSEIF [shift_tag] = &apos;MANUAL&apos; THEN &apos;NO KIWI&apos;&#13;&#10;ELSEIF [shift_tag] = &apos;SWAP&apos; THEN &apos;NO KIWI&apos;&#13;&#10;ELSE &apos;NO KIWI&apos;&#13;&#10;END' />
      </column>
      <column caption='CONTACT RATE' datatype='real' name='[Calculation_1780892238018727959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(chats)/SUM(orders_accepted)' />
      </column>
      <column caption='PERCENTICE 95' datatype='real' name='[Calculation_1780892238034026520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_PERCENTILE(SUM([actual]), 0.95)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MEDIAN' datatype='real' name='[Calculation_1780892238038298649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(SUM([actual]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='work_now_shifts' datatype='table' name='[__tableau_internal_object_id__].[work_now_shifts_17B6BE5B747441F5902F222E42716FC0]' role='measure' type='quantitative' />
