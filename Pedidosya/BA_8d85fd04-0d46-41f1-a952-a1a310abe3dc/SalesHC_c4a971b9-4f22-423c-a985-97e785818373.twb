        <objects>
          <object caption='HC_target_juli' id='HC_target_juli_7C6AF9B28FD94BE38531AD5C0D70AEAD'>
            <properties context=''>
              <relation connection='bigquery.0br2t311wlstt51g1zkfe0wbd1kb' name='HC_target_juli1' table='[peya-delivery-and-support.automated_tables_reports].[HC_target_juli]' type='table' />
            </properties>
            <properties context='extract'>
              <relation name='HC_target_juli_7C6AF9B28FD94BE38531AD5C0D70AEAD' table='[Extract].[HC_target_juli_7C6AF9B28FD94BE38531AD5C0D70AEAD]' type='table' />
            </properties>
          </object>
          <object caption='Consulta SQL personalizada' id='_BAE173A4B19C4ED085B8E3339FEE10E1'>
            <properties context=''>
              <relation connection='bigquery.0br2t311wlstt51g1zkfe0wbd1kb' name='Consulta SQL personalizada' type='text'>WITH&#13;
HC_TOTAL AS (&#13;
  SELECT&#13;
he.month,&#13;
he.CeCo_Code___Name,&#13;
he.Work_Email1,&#13;
&#13;
&#13;
CASE&#13;
WHEN he.company in (&apos;AR BU&apos;,&apos;AR DH&apos;,&apos;AR SSC&apos;) then &quot;Argentina&quot;&#13;
WHEN he.company in (&apos;BO BU&apos;,&apos;BO DH&apos;,&apos;BO SSC&apos;) then &quot;Bolivia&quot;&#13;
WHEN he.company in (&apos;CL BU&apos;,&apos;CL DH&apos;,&apos;CL SSC&apos;) then &quot;Chile&quot;&#13;
WHEN he.company in (&apos;CR BU&apos;,&apos;CR DH&apos;,&apos;CR SSC&apos;) then &quot;Costa Rica&quot;&#13;
WHEN he.company in (&apos;DO BU&apos;,&apos;DO DH&apos;,&apos;DO SSC&apos;) then &quot;República Dominicana&quot;&#13;
WHEN he.company in (&apos;EC BU&apos;,&apos;EC DH&apos;,&apos;EC SSC&apos;) then &quot;Ecuador&quot;&#13;
WHEN he.company in (&apos;GT BU&apos;,&apos;GT DH&apos;,&apos;GT SSC&apos;) then &quot;Guatemala&quot;&#13;
WHEN he.company in (&apos;HN BU&apos;,&apos;HN DH&apos;,&apos;HN SSC&apos;) then &quot;Honduras&quot;&#13;
WHEN he.company in (&apos;NI BU&apos;,&apos;NI DH&apos;,&apos;NI SSC&apos;) then &quot;Nicaragua&quot;&#13;
WHEN he.company in (&apos;PA BU&apos;,&apos;PA DH&apos;,&apos;PA SSC&apos;) then &quot;Panamá&quot;&#13;
WHEN he.company in (&apos;PE BU&apos;,&apos;PE DH&apos;,&apos;PE SSC&apos;) then &quot;Perú&quot;&#13;
WHEN he.company in (&apos;PY BU&apos;,&apos;PY DH&apos;,&apos;PY SSC&apos;) then &quot;Paraguay&quot;&#13;
WHEN he.company in (&apos;SV BU&apos;,&apos;SV DH&apos;,&apos;SV SSC&apos;) then &quot;El Salvador&quot;&#13;
WHEN he.company in (&apos;UY BU&apos;,&apos;UY DH&apos;,&apos;UY SSC&apos;) then &quot;Uruguay&quot;&#13;
WHEN he.company in (&apos;VE BU&apos;,&apos;VE DH&apos;,&apos;VE SSC&apos;) then &quot;Venezuela&quot;&#13;
END as Country,&#13;
&#13;
&#13;
COUNT(distinct he.Work_Email1) AS hc_actual,&#13;
CASE&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202601|6151202601|6201202601|6351202601|6401202601| 6411202601|6421202601|6431202601|6481202601|6501202601|6502202601|6552202601|6602202601|6702202601|6801202601|6411202601)&apos;) THEN &apos;Sales Account Management&apos;&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202701|6151202701|6201202701|6351202701|6401202701|6411202701|6421202701|6431202701|6481202701|6501202701|6502202701|6552202701|6602202701|6702202701|6801202701)&apos;) THEN &apos;Key Account Management&apos;&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202901|6005202901|6151202901|6201202901|6351202901|6401202901|6411202901|6421202901|6431202901|6481202901|6501202901|6502202901|6552202901|6602202901|6702202901|6703202901|6801202901)&apos;) THEN &apos;Onb + Incubation&apos;&#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202811|6151202811|6201202811|6351202811|6401202811|6411202811|6421202811|6431202811|6481202811|6501202811|6502202811|6552202811|6602202811|6702202811|6801202811|6001202821|6151202821|6201202821|6351202821|6401202821|6411202821|6421202821|6431202821|6481202821|6501202821|6502202821|6552202821|6602202821|6702202821|6801202821|6481202801)&apos;) THEN &apos;Corporate Sales&apos; -- NCR SELLERS -- se sumo ceco de ncr telesales (no hay pero los dejamos)&#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202321|6001202331|6001202341|6001202351|6001202361|6151202321|6151202331|6151202341|6151202351|6151202361|6201202321|6201202331|6201202341|6201202351|6201202361|6351202321|6351202331|6351202341|6351202351|6351202361|6401202321|6401202331|6401202341|6401202351|6401202361|6411202321|6411202331|6411202341|6411202351|6411202361|6421202321|6421202331|6421202341|6421202351|6421202361|6431202321|6431202331|6431202341|6431202351|6431202361|6481202321|6481202331|6481202341|6481202351|6481202361|6501202321|6501202331|6501202341|6501202351|6501202361|6502202321|6502202331|6502202341|6502202351|6502202361|6552202321|6552202331|6552202341|6552202351|6552202361|6602202321|6602202331|6602202341|6602202351|6602202361|6702202321|6702202331|6702202341|6702202351|6702202361|6801202321|6801202331|6801202341|6801202351|6801202361|6001202311|6151202311|6201202311|6351202311|6401202311|6411202311|6421202311|6431202311|6481202311|6501202311|6502202311|6552202311|6602202311|6702202311|6801202311)&apos;) THEN &apos;Telesales Representative&apos;&#13;
&#13;
--desde 6001202311 son cecos viejos que ya no se utilizan --&#13;
&#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202221|6001202231|6001202241|6001202251|6001202261|6151202221|6151202231|6151202241|6151202251|6151202261|6201202221|6201202231|6201202241|6201202251|6201202261|6351202221|6351202231|6351202241|6351202251|6351202261|6401202221|6401202231|6401202241|6401202251|6401202261|6411202221|6411202231|6411202241|6411202251|6411202261|6421202221|6421202231|6421202241|6421202251|6421202261|6431202221|6431202231|6431202241|6431202251|6431202261|6481202221|6481202231|6481202241|6481202251|6481202261|6501202221|6501202231|6501202241|6501202251|6501202261|6502202221|6502202231|6502202241|6502202251|6502202261|6552202221|6552202231|6552202241|6552202251|6552202261|6602202221|6602202231|6602202241|6602202251|6602202261|6702202221|6702202231|6702202241|6702202251|6702202261|6801202221|6801202231|6801202241|6801202251|6801202261|6001202111|6151202111|6201202111|6351202111|6401202111|6411202111|6421202111|6431202111|6481202111|6501202111|6502202111|6552202111|6552202211|6602202111|6602202211|6702202111|6801202111|6801202211)&apos;) THEN &apos;Field Sales Representative&apos; &#13;
-- desde 6001202111 son cecos viejos que ya no se utilizan -- &#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202501|6151202501|6201202501|6351202501|6401202501|6411202501|6421202501|6431202501|6481202501|6501202501|6502202501|6552202501|6602202501|6702202501|6801202501)&apos;)THEN &apos;Sales Operations&apos;  &#13;
&#13;
/*WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202502|6702202502|6702202812|6702202402)&apos;) THEN &apos;Sales Management Regional&apos; */&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202502|6702202502|6702202812|6702202402|6001202401|6151202401|6201202401|6351202401|6401202401|6411202401|6421202401|6431202401|6481202401|6501202401|6502202401|6552202401|6602202401|6702202401|6801202401|6001202011|6001208511|6001208611|6001212011|6151202011|6151202401|6201202011|6201202401|6351202011|6351202091|6351202401|6401202011|6401202401|6411202011|6411202401|6421202011|6421202401|6431202401|6481202011|6481202401|6501202011|6501202401|6502202011|6502202401|6552202011|6552202401|6602202011|6602202401|6702202011|6702202401|6801202011|6801202401)&apos;) THEN &apos;Sales Management&apos;     &#13;
-- desde 6001202011 son cecos viejos que ya no se utilizan --   &#13;
&#13;
&#13;
ELSE NULL END AS Area&#13;
&#13;
&#13;
FROM `peya-delivery-and-support.user_gisela_riofrio.hc_total` he&#13;
WHERE he.Last_Day_Of_Work__Il_Worker_Org_ IS NULL&#13;
AND he.department = &quot;Sales&quot;&#13;
AND he.business_unit = &quot;Platform&quot;&#13;
AND he.Month &gt;&gt;= &quot;2024-01-01&quot;&#13;
GROUP BY 1,2,3,4&#13;
),&#13;
&#13;
HC_LATAM AS (&#13;
  SELECT&#13;
he.month,&#13;
he.CeCo_Code___Name,&#13;
he.Work_Email1,&#13;
&quot;Latam&quot; as Country,&#13;
&#13;
COUNT(distinct he.Work_Email1) AS hc_actual,&#13;
CASE&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202601|6151202601|6201202601|6351202601|6401202601| 6411202601|6421202601|6431202601|6481202601|6501202601|6502202601|6552202601|6602202601|6702202601|6801202601|6411202601)&apos;) THEN &apos;Sales Account Management&apos;&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202701|6151202701|6201202701|6351202701|6401202701|6411202701|6421202701|6431202701|6481202701|6501202701|6502202701|6552202701|6602202701|6702202701|6801202701)&apos;) THEN &apos;Key Account Management&apos;&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202901|6005202901|6151202901|6201202901|6351202901|6401202901|6411202901|6421202901|6431202901|6481202901|6501202901|6502202901|6552202901|6602202901|6702202901|6703202901|6801202901)&apos;) THEN &apos;Onb + Incubation&apos;&#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202811|6151202811|6201202811|6351202811|6401202811|6411202811|6421202811|6431202811|6481202811|6501202811|6502202811|6552202811|6602202811|6702202811|6801202811|6001202821|6151202821|6201202821|6351202821|6401202821|6411202821|6421202821|6431202821|6481202821|6501202821|6502202821|6552202821|6602202821|6702202821|6801202821|6481202801)&apos;) THEN &apos;Corporate Sales&apos; -- NCR SELLERS -- se sumo ceco de ncr telesales (no hay pero los dejamos)&#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202321|6001202331|6001202341|6001202351|6001202361|6151202321|6151202331|6151202341|6151202351|6151202361|6201202321|6201202331|6201202341|6201202351|6201202361|6351202321|6351202331|6351202341|6351202351|6351202361|6401202321|6401202331|6401202341|6401202351|6401202361|6411202321|6411202331|6411202341|6411202351|6411202361|6421202321|6421202331|6421202341|6421202351|6421202361|6431202321|6431202331|6431202341|6431202351|6431202361|6481202321|6481202331|6481202341|6481202351|6481202361|6501202321|6501202331|6501202341|6501202351|6501202361|6502202321|6502202331|6502202341|6502202351|6502202361|6552202321|6552202331|6552202341|6552202351|6552202361|6602202321|6602202331|6602202341|6602202351|6602202361|6702202321|6702202331|6702202341|6702202351|6702202361|6801202321|6801202331|6801202341|6801202351|6801202361|6001202311|6151202311|6201202311|6351202311|6401202311|6411202311|6421202311|6431202311|6481202311|6501202311|6502202311|6552202311|6602202311|6702202311|6801202311)&apos;) THEN &apos;Telesales Representative&apos;&#13;
&#13;
--desde 6001202311 son cecos viejos que ya no se utilizan --&#13;
&#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202221|6001202231|6001202241|6001202251|6001202261|6151202221|6151202231|6151202241|6151202251|6151202261|6201202221|6201202231|6201202241|6201202251|6201202261|6351202221|6351202231|6351202241|6351202251|6351202261|6401202221|6401202231|6401202241|6401202251|6401202261|6411202221|6411202231|6411202241|6411202251|6411202261|6421202221|6421202231|6421202241|6421202251|6421202261|6431202221|6431202231|6431202241|6431202251|6431202261|6481202221|6481202231|6481202241|6481202251|6481202261|6501202221|6501202231|6501202241|6501202251|6501202261|6502202221|6502202231|6502202241|6502202251|6502202261|6552202221|6552202231|6552202241|6552202251|6552202261|6602202221|6602202231|6602202241|6602202251|6602202261|6702202221|6702202231|6702202241|6702202251|6702202261|6801202221|6801202231|6801202241|6801202251|6801202261|6001202111|6151202111|6201202111|6351202111|6401202111|6411202111|6421202111|6431202111|6481202111|6501202111|6502202111|6552202111|6552202211|6602202111|6602202211|6702202111|6801202111|6801202211)&apos;) THEN &apos;Field Sales Representative&apos; &#13;
-- desde 6001202111 son cecos viejos que ya no se utilizan -- &#13;
&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202501|6151202501|6201202501|6351202501|6401202501|6411202501|6421202501|6431202501|6481202501|6501202501|6502202501|6552202501|6602202501|6702202501|6801202501)&apos;)THEN &apos;Sales Operations&apos;  &#13;
&#13;
/*WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202502|6702202502|6702202812|6702202402)&apos;) THEN &apos;Sales Management Regional&apos; */&#13;
WHEN REGEXP_CONTAINS(CeCo_Code___Name, r&apos;(6001202502|6702202502|6702202812|6702202402|6001202401|6151202401|6201202401|6351202401|6401202401|6411202401|6421202401|6431202401|6481202401|6501202401|6502202401|6552202401|6602202401|6702202401|6801202401|6001202011|6001208511|6001208611|6001212011|6151202011|6151202401|6201202011|6201202401|6351202011|6351202091|6351202401|6401202011|6401202401|6411202011|6411202401|6421202011|6421202401|6431202401|6481202011|6481202401|6501202011|6501202401|6502202011|6502202401|6552202011|6552202401|6602202011|6602202401|6702202011|6702202401|6801202011|6801202401)&apos;) THEN &apos;Sales Management&apos;     &#13;
-- desde 6001202011 son cecos viejos que ya no se utilizan --   &#13;
&#13;
&#13;
ELSE NULL END AS Area&#13;
&#13;
FROM `peya-delivery-and-support.user_gisela_riofrio.hc_total` he&#13;
WHERE he.Last_Day_Of_Work__Il_Worker_Org_ IS NULL&#13;
AND he.department = &quot;Sales&quot;&#13;
AND he.business_unit = &quot;Platform&quot;&#13;
AND he.Month &gt;&gt;= &quot;2024-01-01&quot;&#13;
GROUP BY 1,2,3,4&#13;
),&#13;
&#13;
UNION_HC_TOTAL AS &#13;
(SELECT * FROM HC_TOTAL&#13;
  UNION ALL&#13;
  SELECT * FROM HC_LATAM )&#13;
&#13;
&#13;
&#13;
SELECT&#13;
he.month,&#13;
he.Work_Email1,&#13;
he.CeCo_Code___Name,&#13;
he.Country,&#13;
he.Area,&#13;
he.hc_Actual,&#13;
ht.Target_Type,&#13;
CAST(CASE WHEN ht.value IS NULL THEN 0 ELSE ht.value END AS INT64) AS hc_Target,&#13;
SUM(he.hc_Actual - ht.Value) AS hcVSBudget&#13;
&#13;
FROM UNION_HC_TOTAL he&#13;
LEFT JOIN `peya-delivery-and-support.automated_tables_reports.HC_target_juli` ht ON he.Month = ht.Month AND he.Area = ht.Area AND he.Country = ht.company&#13;
GROUP BY 1,2,3,4,5,6,7,8</relation>
            </properties>
            <properties context='extract'>
              <relation name='_BAE173A4B19C4ED085B8E3339FEE10E1' table='[Extract].[_BAE173A4B19C4ED085B8E3339FEE10E1]' type='table' />
            </properties>
          </object>
