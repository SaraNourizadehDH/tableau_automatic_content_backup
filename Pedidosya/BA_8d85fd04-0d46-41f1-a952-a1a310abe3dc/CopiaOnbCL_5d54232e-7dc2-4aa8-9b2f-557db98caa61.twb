              </calculation>
            </column>
            <column caption='Auxiliar Close Date' datatype='date' name='[Aux Fecha Traspaso (copia)_9167569653277036545]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [grid]:  Max([closed_date])}' />
            </column>
            <column caption='WinBack Aux' datatype='integer' name='[Aux Fecha Traspaso 2 (copia)_9167569653277474820]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Auxiliar CloseDate 2 (copia)_9167569653277306883]=1 AND [Auxiliar Close Date (copia)_9167569653277200386]=1 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Auxiliar CloseDate 2' datatype='integer' name='[Auxiliar Close Date (copia)_9167569653277200386]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Aux Fecha Traspaso (copia)_9167569653277036545]=[closed_date] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Aux Fecha Traspaso 2' datatype='integer' name='[Auxiliar CloseDate 2 (copia)_9167569653277306883]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Calculation_9167569653276856320]=[Fecha_Traspaso] THEN 1 ELSE 0 END' />
            </column>
            <column aggregation='Sum' caption='Dias desde Closed Date' datatype='integer' name='[Calculation_1415396936396529667]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [closed_date], TODAY())' />
            </column>
            <column caption='Traspaso?¿' datatype='integer' name='[Calculation_1441996317162123265]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF { FIXED [grid], [account_owner], [account_owner_1],[NewValue]: &#13;&#10;     SUM(&#13;&#10;         IF [account_owner] != [account_owner_1] &#13;&#10;         AND ( IF MONTH([closed_date]) = 8 THEN DATEDIFF(&apos;day&apos;, [closed_date], [Fecha_Traspaso]) &lt;= 63 &#13;&#10;ELSE DATEDIFF(&apos;day&apos;, [closed_date], [Fecha_Traspaso]) &lt;= 63 END)&#13;&#10;         AND [Actual Owner (grupo)] != &quot;Onboarding - Incubation&quot;&#13;&#10;         AND [Aux Fecha Traspaso 2 (copia)_9167569653277474820]=1&#13;&#10;         AND [account_owner_1]!=&quot;Virtual AM&quot;&#13;&#10;         AND [account_owner_1] != &quot;Gloria Albornoz Navarro&quot;&#13;&#10;         AND [account_owner_1] != &quot;Gloria Albornoz&quot;&#13;&#10;         THEN 1 &#13;&#10;         ELSE 0 &#13;&#10;         END&#13;&#10;     ) &#13;&#10;   } &gt; 0 &#13;&#10;THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Periodo Traspaso (MAX)' datatype='string' name='[Calculation_1705668003356680199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL({ FIXED [grid]: MAX([Periodo Traspaso (copia)_1705668003356393478]) }, [Periodo Traspaso (copia)_1705668003356393478])' />
            </column>
            <column caption='Celulas Onb Actualizadas' datatype='string' name='[Calculation_500462558987423773]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&quot;month&quot;,[closed_date]) &lt;= DATE(&quot;2024-06-01&quot;) &#10;THEN [Celulas Onboarding]&#10;ELSEIF DATETRUNC(&quot;month&quot;,[closed_date]) = DATE(&quot;2024-07-01&quot;) &#10;THEN&#10;&#9;IF [account_owner] = &quot;Catalina Daniela Bozo Salgado&quot; OR [account_owner] = &quot;Catalina Bozo&quot;&#10;    THEN &quot;Celula Michelle Granado&quot;&#10;    ELSEIF [account_owner] = &quot;Monserrat Dorregaray&quot; &#10;    THEN &quot;Celula Daniel Mery&quot;&#10;    ELSE [Celulas Onboarding]&#10;&#9;END&#10;ELSEIF DATETRUNC(&quot;month&quot;,[closed_date]) = DATE(&quot;2024-08-01&quot;) OR&#10;DATETRUNC(&quot;month&quot;,[closed_date]) = DATE(&quot;2024-09-01&quot;)&#10;THEN &#10;&#9;IF [account_owner] IN (&quot;Catalina Daniela Bozo Salgado&quot;,&quot;Oscar Zapata&quot;,&quot;Patricio Aguilera&quot;,&quot;Catalina Bozo&quot;)&#10;    THEN &quot;Celula Michelle Granado&quot;&#10;    ELSEIF [account_owner] = &quot;Monserrat Dorregaray&quot; &#10;    THEN &quot;Celula Daniel Mery&quot;&#10;    ELSE [Celulas Onboarding]&#10;    END&#10;ELSEIF DATETRUNC(&quot;month&quot;,[closed_date]) &gt;= DATE(&quot;2024-10-01&quot;)&#10;THEN &#10;&#9;IF  [account_owner] IN (&quot;Felipe Aravena&quot;,&quot;Oscar Zapata&quot;,&quot;Sobe Gatica Mella&quot;) &#10;&#9;THEN &quot;Celula Jaqueline Vera&quot;&#10;&#9;ELSEIF [account_owner] IN (&quot;Monserrat Dorregaray&quot;,&quot;Joaquín Encina&quot;,&quot;Olga Araujo&quot;)&#10;&#9;THEN &quot;Celula Tatiana Godoy&quot;&#10;&#9;ELSEIF [account_owner] IN (&quot;Catalina Daniela Bozo Salgado&quot;,&quot;Patricio Aguilera&quot;,&quot;Reinier Landkoer&quot;,&quot;Catalina Bozo&quot;)&#10;&#9;THEN &quot;Celula Michelle Granado&quot;&#10;&#9;ELSEIF [account_owner] IN (&quot;Francys Molina&quot;,&quot;Yusette Moraga&quot;)&#10;&#9;THEN &quot;Celula Pablo Olmedo&quot;&#10;&#9;END&#10;ELSE [Celulas Onboarding] END' />
            </column>
            <column caption='Enumerar' datatype='integer' name='[Calculation_6882133573465124873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Dia de Traspaso' datatype='integer' name='[Calculation_7689403787185553410]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&#10;&apos;day&apos;,&#10;[closed_date],&#10;[Fecha_Traspaso]&#10;&#10;)' />
            </column>
            <column caption='Periodo Traspaso' datatype='string' name='[Calculation_7689403787185942531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[account_owner_1] = &quot;Virtual AM&quot; THEN &quot;Virtual AM&quot;&#10;ELSEIF [Calculation_1415396936396529667] &gt; 65 AND [Calculation_1441996317162123265] = 0 AND ISNULL([Fecha_Traspaso]) THEN &quot;Sin Traspasar / Eliminado&quot;&#10;ELSEIF [Actual Owner (grupo)] = &quot;Onboarding - Incubation&quot; OR [Actual Owner (grupo)] = &quot;Sellers&quot;&#10;THEN &quot;En Incubation&quot;&#10;ELSEIF [Calculation_7689403787185553410] &lt; 16 THEN &quot;Migro 15&quot;&#10;ELSEIF [Calculation_7689403787185553410] &lt; 31 THEN &quot;Migro 30&quot;&#10;ELSEIF [Calculation_7689403787185553410] &lt; 46 THEN &quot;Migro 45&quot;&#10;ELSEIF [Calculation_7689403787185553410] &lt;= 63 THEN &quot;Migro 60&quot;&#10;ELSEIF [Calculation_7689403787185553410] &gt; 65 THEN &quot;Migro Post Incubation&quot;&#10;&#10;&#10;&#10;END' />
            </column>
            <column caption='Aux Fecha Traspaso' datatype='date' name='[Calculation_9167569653276856320]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [grid]:  Max([Fecha_Traspaso])}' />
            </column>
            <column datatype='string' name='[Celulas Onboarding]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[account_owner]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Celula Daniel Mery&quot;'>
                  <value>&quot;Felipe Aravena&quot;</value>
                  <value>&quot;Joaquín Encina&quot;</value>
                  <value>&quot;Massiel Fuentealba&quot;</value>
