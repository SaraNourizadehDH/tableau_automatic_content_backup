      <column caption='Traspaso?¿' datatype='integer' name='[Calculation_1441996317162123265]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF { FIXED [grid], [account_owner], [account_owner_1],[NewValue]: &#13;&#10;     SUM(&#13;&#10;         IF [account_owner] != [account_owner_1] &#13;&#10;         AND ( IF MONTH([closed_date]) = 8 THEN DATEDIFF(&apos;day&apos;, [closed_date], [Fecha_Traspaso]) &lt;= 63 &#13;&#10;ELSE DATEDIFF(&apos;day&apos;, [closed_date], [Fecha_Traspaso]) &lt;= 63 END)&#13;&#10;         AND [Actual Owner (grupo)] != &quot;Onboarding - Incubation&quot;&#13;&#10;         AND [Aux Fecha Traspaso 2 (copia)_9167569653277474820]=1&#13;&#10;         AND [account_owner_1]!=&quot;Virtual AM&quot;&#13;&#10;         AND [account_owner_1] != &quot;Gloria Albornoz Navarro&quot;&#13;&#10;         AND [account_owner_1] != &quot;Gloria Albornoz&quot;&#13;&#10;         THEN 1 &#13;&#10;         ELSE 0 &#13;&#10;         END&#13;&#10;     ) &#13;&#10;   } &gt; 0 &#13;&#10;THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Periodo de Evaluacion ' datatype='string' name='[Calculation_1655635836862955520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_608548917803016199]=&quot;Aun puede traspasar&quot;&#13;&#10;AND [Calculation_1415396936396529667]&lt;=15 THEN &quot;Filtro  15 Dias&quot;&#13;&#10;ELSEIF  [Calculation_608548917803016199]=&quot;Aun puede traspasar&quot;&#13;&#10;AND [Calculation_1415396936396529667]&gt;15 AND [Calculation_1415396936396529667]&lt;=30 THEN &quot;Filtro 30 Dias&quot; &#13;&#10;ELSEIF  [Calculation_608548917803016199]=&quot;Aun puede traspasar&quot;&#13;&#10;AND [Calculation_1415396936396529667]&gt;30 AND [Calculation_1415396936396529667]&lt;=45 THEN &quot;Filtro 45 Dias&quot; &#13;&#10;ELSEIF  [Calculation_608548917803016199]=&quot;Aun puede traspasar&quot;&#13;&#10;AND [Calculation_1415396936396529667]&gt;45 AND [Calculation_1415396936396529667]&lt;=60 THEN &quot;Filtro 60 Dias&quot; &#13;&#10;END' />
      </column>
