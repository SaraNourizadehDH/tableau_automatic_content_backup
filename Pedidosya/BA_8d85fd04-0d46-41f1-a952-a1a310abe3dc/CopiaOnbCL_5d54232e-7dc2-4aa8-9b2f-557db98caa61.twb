            <column caption='Cumplimiento Exigencias Minimas' datatype='string' name='[Calculation_943222670054273042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [grid] : (IF [Calculation_943222670048448523] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;   AND {FIXED [grid] : MAX(IF [Calculation_608548917741232128] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;THEN &quot;Cumple 15&quot; &#13;&#10;ELSEIF {FIXED [grid] : (IF [Cumplimiento Frame 15  (copia)_943222670050349068] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;   AND {FIXED [grid] : MAX(IF [Filtro 1-15 Dias (copia)_608548917750128641] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;THEN &quot;Cumple 30&quot;&#13;&#10;ELSEIF {FIXED [grid] : (IF [Cumplimiento Frame 15  (copia) (copia)_943222670050357261] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;   AND {FIXED [grid] : MAX(IF [Filtro 15-30 Dias (copia)_608548917750730754] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;THEN &quot;Cumple 45&quot;&#13;&#10;ELSEIF {FIXED [grid] : (IF [Cumplimiento Frame 15  (copia) (copia) (copia)_943222670050365454] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;   AND {FIXED [grid] : MAX(IF [Filtro 30-45 Dias (copia)_608548917751693315] = &quot;Cumple&quot; THEN 1 ELSE 0 END)} = 1 &#13;&#10;THEN &quot;Cumple 60&quot;&#13;&#10;ELSE &quot;No Cumple&quot; &#13;&#10;END' />
            </column>
