      <datasources>
        <datasource caption='Oportunidades cerradas Diciembre 2023 - Marzo 2024 (user_cristobal_navarrete)' name='federated.0xo98iy1j7t05k18bv7yb1huprzc' />
      </datasources>
      <datasource-dependencies datasource='federated.0xo98iy1j7t05k18bv7yb1huprzc'>
        <column caption='Celulas Onb Actualizadas' datatype='string' name='[Calculation_500462558987423773]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF DATETRUNC(&quot;month&quot;,[closed_date]) &lt;= DATE(&quot;2024-06-01&quot;) &#10;THEN [Celulas Onboarding]&#10;ELSEIF DATETRUNC(&quot;month&quot;,[closed_date]) = DATE(&quot;2024-07-01&quot;) &#10;THEN&#10;&#9;IF [account_owner] = &quot;Catalina Daniela Bozo Salgado&quot; OR [account_owner] = &quot;Catalina Bozo&quot;&#10;    THEN &quot;Celula Michelle Granado&quot;&#10;    ELSEIF [account_owner] = &quot;Monserrat Dorregaray&quot; &#10;    THEN &quot;Celula Daniel Mery&quot;&#10;    ELSE [Celulas Onboarding]&#10;&#9;END&#10;ELSEIF DATETRUNC(&quot;month&quot;,[closed_date]) = DATE(&quot;2024-08-01&quot;) OR&#10;DATETRUNC(&quot;month&quot;,[closed_date]) = DATE(&quot;2024-09-01&quot;)&#10;THEN &#10;&#9;IF [account_owner] IN (&quot;Catalina Daniela Bozo Salgado&quot;,&quot;Oscar Zapata&quot;,&quot;Patricio Aguilera&quot;,&quot;Catalina Bozo&quot;)&#10;    THEN &quot;Celula Michelle Granado&quot;&#10;    ELSEIF [account_owner] = &quot;Monserrat Dorregaray&quot; &#10;    THEN &quot;Celula Daniel Mery&quot;&#10;    ELSE [Celulas Onboarding]&#10;    END&#10;ELSEIF DATETRUNC(&quot;month&quot;,[closed_date]) &gt;= DATE(&quot;2024-10-01&quot;)&#10;THEN &#10;&#9;IF  [account_owner] IN (&quot;Felipe Aravena&quot;,&quot;Oscar Zapata&quot;,&quot;Sobe Gatica Mella&quot;) &#10;&#9;THEN &quot;Celula Jaqueline Vera&quot;&#10;&#9;ELSEIF [account_owner] IN (&quot;Monserrat Dorregaray&quot;,&quot;Joaquín Encina&quot;,&quot;Olga Araujo&quot;)&#10;&#9;THEN &quot;Celula Tatiana Godoy&quot;&#10;&#9;ELSEIF [account_owner] IN (&quot;Catalina Daniela Bozo Salgado&quot;,&quot;Patricio Aguilera&quot;,&quot;Reinier Landkoer&quot;,&quot;Catalina Bozo&quot;)&#10;&#9;THEN &quot;Celula Michelle Granado&quot;&#10;&#9;ELSEIF [account_owner] IN (&quot;Francys Molina&quot;,&quot;Yusette Moraga&quot;)&#10;&#9;THEN &quot;Celula Pablo Olmedo&quot;&#10;&#9;END&#10;ELSE [Celulas Onboarding] END' />
        </column>
        <column caption='WinBack Aux Migracion' datatype='integer' name='[WinBack Aux (copia)_7689403787191681029]' role='dimension' type='ordinal'>
