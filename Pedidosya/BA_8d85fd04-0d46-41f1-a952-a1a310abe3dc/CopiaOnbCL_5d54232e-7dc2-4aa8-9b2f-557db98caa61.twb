          <object caption='Pics' id='_CF0EB9F37E2C4F02BDFBF099CC79377A'>
            <properties context=''>
              <relation connection='bigquery.0ruex7o0cyttcu1b0b7w91gqgd65' name='Consulta SQL personalizada1' type='text'><![CDATA[SELECT 
    Pics.partner_id,
    Pics.fecha,
    Pics.closed_date,
    COUNT(DISTINCT Pics.product_id) AS Productos,
    COUNT(DISTINCT CASE WHEN Pics.hasPhoto THEN Pics.product_id END) AS Fotos,
    ROUND(SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN Pics.hasPhoto THEN Pics.product_id END), COUNT(DISTINCT Pics.product_id)), 4) AS Porcentaje_De_Fotos,
    ROUND(SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN Pics.hasDescription THEN Pics.product_id END), COUNT(DISTINCT Pics.product_id)), 4) AS Porcentaje_De_Descripcion,
    dim_partner.salesforce_id AS Grid_SalesForce,
    dim_partner.main_cousine_category_name
FROM (
    WITH base AS (
        SELECT
            snapshotDate,
            partnerId AS partner_id,
            partnerState,
            p.id AS product_id,
            p.legacyId,
            s.isdeleted AS section_isDeleted,
            s.available AS section_available,
            p.isdeleted AS product_isDeleted,
            p.available AS product_available
        FROM `peya-bi-tools-pro.il_core.dim_partner_menu_historical`
        INNER JOIN UNNEST(section) s
        INNER JOIN UNNEST(product) p
        WHERE snapshotDate >>= '2024-01-01'
            AND s.isdeleted = FALSE
            AND s.available = TRUE
            AND p.isdeleted = FALSE
            AND p.available = TRUE
    )
    SELECT
        op.closed_date AS closed_date,
        op.grid,
        base.snapshotDate AS fecha,
        base.partner_id,
        pcq.partner_name,
        pcq.country_name,
        pcq.account_manager,
        pr.id AS product_id,
        pr.name AS product_name,
        pr.sectionName,
        pr.description,
        pr.hasDescription,
        pr.hasPhoto,
        base.section_isDeleted,
        base.section_available,
        base.product_isDeleted,
        base.product_available
    FROM `peya-bi-tools-pro.il_core.dim_is_product` pr
    JOIN base ON base.product_id = pr.id
    JOIN `peya-delivery-and-support.automated_tables_reports.Content_Food_Master_Table_daily` pcq ON pcq.partner_id = base.partner_id
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` dp ON base.partner_id = dp.partner_id
    RIGHT JOIN `peya-chile.user_cristobal_navarrete.OportunidadesCerradas_Dic23_Marzo24` op ON dp.salesforce_id = op.grid AND base.snapshotDate = op.date_lookup_date_date
    WHERE pr.country = 2
        AND dia_de_los_15 <<= 60
) AS Pics
JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner ON Pics.partner_id = dim_partner.partner_id
GROUP BY 1, 2, 3, 8, 9
ORDER BY 1, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_CF0EB9F37E2C4F02BDFBF099CC79377A' table='[Extract].[_CF0EB9F37E2C4F02BDFBF099CC79377A]' type='table' />
            </properties>
          </object>
          <object caption='Consulta SQL personalizada' id='_EE2006B8947E4B5F8292D3E97E2EC7F9'>
            <properties context=''>
              <relation connection='bigquery.0ruex7o0cyttcu1b0b7w91gqgd65' name='Consulta SQL personalizada' type='text'>SELECT &#13;
CaseNumber,&#13;
caso.GRID_fm,&#13;
Account_SF.Name as Account_Name,&#13;
User_SF.name As Owner_Onboarding,&#13;
caso.Opportunity as opp,&#13;
sf.opportunity,&#13;
caso.type,&#13;
status,&#13;
IsClosed,&#13;
caso.CreatedDate,&#13;
ClosedDate,&#13;
Closed_Reason&#13;
FROM `peya-data-origins-pro.cl_salesforce.cases` as caso&#13;
&#13;
INNER JOIN &#13;
(&#13;
SELECT GRID_fm,&#13;
max(closedDate) as max_date&#13;
from `peya-data-origins-pro.cl_salesforce.cases` as cas&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` as sf ON cas.Opportunity = sf.oportunity_unique_id&#13;
where cas.type = &quot;Onboarding&quot;&#13;
and isclosed&#13;
and Closed_Reason = &quot;Successful&quot;&#13;
and sf.opportunity is not null&#13;
GROUP BY GRID_fm&#13;
) as aux&#13;
ON aux.Grid_fm = caso.GRID_fm and aux.max_date = caso.ClosedDate&#13;
&#13;
LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` AS User_SF ON caso.OwnerId = User_SF.Id&#13;
LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` AS Account_SF ON caso.AccountId = Account_SF.Id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` as sf ON caso.Opportunity = sf.oportunity_unique_id&#13;
&#13;
&#13;
WHERE &#13;
ClosedDate &gt;&gt;= &quot;2023-12-01&quot;&#13;
AND&#13;
 caso.Type = &quot;Onboarding&quot;&#13;
--AND caso.accountid = &quot;0016900002wj9NoAAI&quot;&#13;
AND isclosed&#13;
--AND User_SF.name != &quot;Nicolas Alvarez&quot;&#13;
AND Closed_Reason = &quot;Successful&quot;&#13;
AND sf.opportunity is not null&#13;
--AND caso.GRID_fm = &quot;451U06&quot;&#13;
  AND caso.Account_Country = &quot;Chile&quot;</relation>
            </properties>
            <properties context='extract'>
              <relation name='_EE2006B8947E4B5F8292D3E97E2EC7F9' table='[Extract].[_EE2006B8947E4B5F8292D3E97E2EC7F9]' type='table' />
            </properties>
          </object>
        </objects>
