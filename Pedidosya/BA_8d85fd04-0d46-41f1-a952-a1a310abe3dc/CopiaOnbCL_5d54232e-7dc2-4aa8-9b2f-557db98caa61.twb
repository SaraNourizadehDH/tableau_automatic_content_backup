      <column caption='Periodo Actual  ' datatype='string' name='[Calculation_440508364110761985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1415396936396529667]&lt;=15 THEN &quot;Periodo 1 a 15 Dias&quot;&#13;&#10;ELSEIF [Calculation_1415396936396529667]&lt;=30 AND [Calculation_1415396936396529667]&gt;15 THEN &quot;Periodo 15 a 30 Dias&quot;&#13;&#10;ELSEIF [Calculation_1415396936396529667]&lt;=45 AND [Calculation_1415396936396529667]&gt;30 THEN &quot;Periodo 30 a 45 Dias&quot;&#13;&#10;ELSEIF [Calculation_1415396936396529667]&lt;=60 AND [Calculation_1415396936396529667]&gt;45 THEN &quot;Periodo 45 a 60 Dias&quot;&#13;&#10;ELSE &quot;Caduco&quot;&#13;&#10;END' />
