            <column caption='Auxiliar Close Date' datatype='date' name='[Aux Fecha Traspaso (copia)_9167569653277036545]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [grid]:  Max([closed_date])}' />
            </column>
            <column caption='WinBack Aux' datatype='integer' name='[Aux Fecha Traspaso 2 (copia)_9167569653277474820]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Auxiliar CloseDate 2 (copia)_9167569653277306883]=1 AND [Auxiliar Close Date (copia)_9167569653277200386]=1 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Auxiliar CloseDate 2' datatype='integer' name='[Auxiliar Close Date (copia)_9167569653277200386]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Aux Fecha Traspaso (copia)_9167569653277036545]=[closed_date] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Aux Fecha Traspaso 2' datatype='integer' name='[Auxiliar CloseDate 2 (copia)_9167569653277306883]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Calculation_9167569653276856320]=[Fecha_Traspaso] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Sheduled Time (Hours)' datatype='real' name='[Calculation_1176002463362420738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dim_historical_partners_sum_schedule_open_time]/60' />
            </column>
            <column aggregation='Sum' caption='Dias desde Closed Date' datatype='integer' name='[Calculation_1415396936396529667]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [closed_date], TODAY())' />
            </column>
            <column caption='Traspaso?¿' datatype='integer' name='[Calculation_1441996317162123265]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF { FIXED [grid], [account_owner], [account_owner_1],[NewValue]: &#13;&#10;     SUM(&#13;&#10;         IF [account_owner] != [account_owner_1] &#13;&#10;         AND ( IF MONTH([closed_date]) = 8 THEN DATEDIFF(&apos;day&apos;, [closed_date], [Fecha_Traspaso]) &lt;= 63 &#13;&#10;ELSE DATEDIFF(&apos;day&apos;, [closed_date], [Fecha_Traspaso]) &lt;= 63 END)&#13;&#10;         AND [Actual Owner (grupo)] != &quot;Onboarding - Incubation&quot;&#13;&#10;         AND [Aux Fecha Traspaso 2 (copia)_9167569653277474820]=1&#13;&#10;         AND [account_owner_1]!=&quot;Virtual AM&quot;&#13;&#10;         AND [account_owner_1] != &quot;Gloria Albornoz Navarro&quot;&#13;&#10;         AND [account_owner_1] != &quot;Gloria Albornoz&quot;&#13;&#10;         THEN 1 &#13;&#10;         ELSE 0 &#13;&#10;         END&#13;&#10;     ) &#13;&#10;   } &gt; 0 &#13;&#10;THEN 1 &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Ordenes Dias  1- 15 ' datatype='integer' name='[Calculation_1750070685489369088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [dia_de_los_15] &lt;= 15 THEN [fact_orders_total_confirmed_orders] ELSE 0 END' />
            </column>
            <column caption='Filtro 1-15 Dias' datatype='string' name='[Calculation_608548917741232128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [grid] : SUM([Calculation_1750070685489369088]) &gt;= 10 } THEN &quot;Cumple&quot; ELSEIF { FIXED [grid] : SUM([Calculation_1750070685489369088]) &gt;= 3 AND SUM([Ordenes Dias  1- 15  (copia)_1750070685491187718]) &gt; 60 } THEN &quot;Cumple&quot; ELSE &quot;No Cumple&quot; END' />
            </column>
            <column caption='Status Actual del Partner' datatype='string' name='[Calculation_608548917802037254]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [grid]:MAX([Calculation_1441996317162123265])} = 1 THEN &quot;Traspasado&quot; ELSE &quot;No Traspasado&quot; END' />
            </column>
            <column caption='Accion de cuenta ' datatype='string' name='[Calculation_608548917803016199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_608548917802037254]=&quot;Traspasado&quot; THEN &quot;No Gestionar&quot;&#13;&#10;ELSEIF ([Calculation_943222670054273042] = &quot;Cumple 15&quot; OR [Calculation_943222670054273042] = &quot;Cumple 30&quot; OR [Calculation_943222670054273042] = &quot;Cumple 45&quot; OR [Calculation_943222670054273042] = &quot;Cumple 60&quot;) &#13;&#10;   AND [Calculation_608548917802037254] = &quot;No Traspasado&quot; &#13;&#10;   AND [Calculation_1415396936396529667] &lt;= 60&#13;&#10;THEN &quot;Traspasar Cuenta&quot; &#13;&#10;ELSEIF [Calculation_608548917802037254] = &quot;No Traspasado&quot; &#13;&#10;   AND [Calculation_1415396936396529667] &gt; 60 &#13;&#10;THEN &quot;No Gestionar - AM Virtual&quot;&#13;&#10;ELSEIF [Calculation_1415396936396529667] &lt;= 60 &#13;&#10;   AND [Calculation_608548917802037254] = &quot;No Traspasado&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 15&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 30&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 45&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 60&quot; &#13;&#10;THEN &quot;Aun puede traspasar&quot;&#13;&#10;ELSE &quot;Evaluar Situacion&quot; &#13;&#10;END' />
            </column>
            <column caption='Real Open Time ( Hours)' datatype='real' name='[Calculation_812618263519113220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dim_historical_partners_real_open_time]/60' />
            </column>
            <column caption='% Conexion' datatype='real' name='[Calculation_812618263545724933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_812618263519113220])/SUM([Calculation_1176002463362420738])' />
            </column>
            <column caption='Aux Fecha Traspaso' datatype='date' name='[Calculation_9167569653276856320]' role='dimension' type='ordinal'>
