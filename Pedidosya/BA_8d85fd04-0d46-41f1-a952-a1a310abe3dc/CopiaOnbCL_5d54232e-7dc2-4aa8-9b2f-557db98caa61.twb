        <calculation class='tableau' formula='IF [Calculation_608548917802037254]=&quot;Traspasado&quot; THEN &quot;No Gestionar&quot;&#13;&#10;ELSEIF ([Calculation_943222670054273042] = &quot;Cumple 15&quot; OR [Calculation_943222670054273042] = &quot;Cumple 30&quot; OR [Calculation_943222670054273042] = &quot;Cumple 45&quot; OR [Calculation_943222670054273042] = &quot;Cumple 60&quot;) &#13;&#10;   AND [Calculation_608548917802037254] = &quot;No Traspasado&quot; &#13;&#10;   AND [Calculation_1415396936396529667] &lt;= 60&#13;&#10;THEN &quot;Traspasar Cuenta&quot; &#13;&#10;ELSEIF [Calculation_608548917802037254] = &quot;No Traspasado&quot; &#13;&#10;   AND [Calculation_1415396936396529667] &gt; 60 &#13;&#10;THEN &quot;No Gestionar - AM Virtual&quot;&#13;&#10;ELSEIF [Calculation_1415396936396529667] &lt;= 60 &#13;&#10;   AND [Calculation_608548917802037254] = &quot;No Traspasado&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 15&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 30&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 45&quot; &#13;&#10;   AND [Calculation_943222670054273042] != &quot;Cumple 60&quot; &#13;&#10;THEN &quot;Aun puede traspasar&quot;&#13;&#10;ELSE &quot;Evaluar Situacion&quot; &#13;&#10;END' />
