                </bin>
              </calculation>
            </column>
            <column caption='Cumplimiento Frame 60' datatype='string' name='[Cumplimiento Frame 15  (copia) (copia) (copia)_943222670050365454]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Frame 45 Dias (copia)_943222670043840517]*0.7+ [Descripcion 15 Dias  (copia) (copia) (copia)_943222670047191049]*0.3)&gt;0.85 THEN &quot;Cumple&quot; ELSE &quot;No Cumple&quot; END' />
            </column>
            <column caption='Cumplimiento Frame 45 ' datatype='string' name='[Cumplimiento Frame 15  (copia) (copia)_943222670050357261]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Frame 15 Dias (copia) (copia)_943222670043680772]*0.7+ [Descripcion 15 Dias  (copia) (copia)_943222670047182856]*0.3)&gt;0.85 THEN &quot;Cumple&quot; ELSE &quot;No Cumple&quot; END' />
            </column>
            <column caption='Cumplimiento Frame 30' datatype='string' name='[Cumplimiento Frame 15  (copia)_943222670050349068]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Frame 15 Dias (copia)_943222670043664387]*0.7+ [Descripcion 15 Dias  (copia)_943222670047170567]*0.3)&gt;0.85 THEN &quot;Cumple&quot; ELSE &quot;No Cumple&quot; END' />
            </column>
            <column caption='Descripcion 60 Dias' datatype='real' name='[Descripcion 15 Dias  (copia) (copia) (copia)_943222670047191049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(If [Calculation_943222670027063296]= 60 THEN [Porcentaje_De_Descripcion] END)' />
            </column>
            <column caption='Descripcion 45 Dias ' datatype='real' name='[Descripcion 15 Dias  (copia) (copia)_943222670047182856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(If [Calculation_943222670027063296]= 45 THEN [Porcentaje_De_Descripcion] END)' />
            </column>
            <column caption='Descripcion 30 Dias ' datatype='real' name='[Descripcion 15 Dias  (copia)_943222670047170567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(If [Calculation_943222670027063296]= 30 THEN [Porcentaje_De_Descripcion] END)' />
            </column>
            <column caption='Fecha Traspaso' datatype='date' name='[Fecha_Traspaso]' role='dimension' type='ordinal' />
            <column caption='Filtro 15-30 Dias' datatype='string' name='[Filtro 1-15 Dias (copia)_608548917750128641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [grid] : SUM([Ordenes 1- 15 Dias (copia)_1750070685489733633]) &gt;= 10 } THEN &quot;Cumple&quot; ELSEIF { FIXED [grid] : SUM([Ordenes 1- 15 Dias (copia)_1750070685489733633]) &gt;= 3 AND SUM([Ordenes Dias 15-30  (copia)_1750070685491400711]) &gt; 60 } THEN &quot;Cumple&quot; ELSE &quot;No Cumple&quot; END' />
