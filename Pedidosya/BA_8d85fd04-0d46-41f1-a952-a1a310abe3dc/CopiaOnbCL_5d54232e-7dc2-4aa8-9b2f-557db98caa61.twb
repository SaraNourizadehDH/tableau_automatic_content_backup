          <object caption='OportunidadesCerradas_Dic23_Marzo24' id='OportunidadesCerradas_Dic23_Marzo24_47587D1E3C3F45538E12DA7025C1D436'>
            <properties context=''>
              <relation connection='bigquery.0ruex7o0cyttcu1b0b7w91gqgd65' name='OportunidadesCerradas_Dic23_Marzo24' table='[peya-chile.user_cristobal_navarrete].[OportunidadesCerradas_Dic23_Marzo24]' type='table' />
            </properties>
            <properties context='extract'>
              <relation name='OportunidadesCerradas_Dic23_Marzo24_47587D1E3C3F45538E12DA7025C1D436' table='[Extract].[OportunidadesCerradas_Dic23_Marzo24_47587D1E3C3F45538E12DA7025C1D436]' type='table' />
            </properties>
