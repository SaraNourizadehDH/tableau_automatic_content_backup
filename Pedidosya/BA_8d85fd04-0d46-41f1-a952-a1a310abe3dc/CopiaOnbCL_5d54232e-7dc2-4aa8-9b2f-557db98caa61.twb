            <column caption='Cumplimiento Frame 15 ' datatype='string' name='[Calculation_943222670048448523]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Calculation_943222670033408002]*0.7+ [Frame 15 Dias (copia)_943222670044585990]*0.3)&gt;0.85 THEN &quot;Cumple&quot; ELSE &quot;No Cumple&quot; END' />
