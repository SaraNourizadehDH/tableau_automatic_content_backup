      <aliases enabled='yes' />
      <column caption='CVR2_' datatype='real' default-format='p0.0%' name='[CVR (copy)_602919429169299460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cvr2_transactions])/SUM([cvr2_sessions])' />
      </column>
      <column caption='CVR2_ (copy)' datatype='real' default-format='p0.0%' name='[CVR2_ (copy)_2208452717563916289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cvr2_transactions])/SUM([cvr2_sessions])' />
      </column>
      <column caption='Period' datatype='string' name='[Calculation_1900237613129355264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [created_date_local]&gt;=DATE(&apos;2022-04-30&apos;) &#13;&#10;AND [created_date_local]&lt;=DATE(&apos;2022-05-14&apos;)&#13;&#10;THEN &apos;normal situation&apos;&#13;&#10;ELSEIF [created_date_local]&gt;=DATE(&apos;2022-05-21&apos;) &#13;&#10;AND [created_date_local]&lt;=DATE(&apos;2022-06-04&apos;)&#13;&#10;THEN &apos;shrinks test&apos;&#13;&#10;END' />
      </column>
      <column caption='city_name_' datatype='string' name='[Calculation_1900237613174865924]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_code]=&apos;ec&apos; AND [city_name]=&apos;Santo domingo&apos; THEN &apos;Santo Domingo EC&apos;&#13;&#10;ELSE [city_name] END' />
      </column>
      <column caption='shrink_ratio_' datatype='real' name='[Calculation_602919429119877120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([city_shrink_minutes])/1080' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_602919429169205251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
      </column>
