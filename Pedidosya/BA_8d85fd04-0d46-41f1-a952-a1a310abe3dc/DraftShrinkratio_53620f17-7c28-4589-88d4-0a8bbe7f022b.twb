        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.07vkzok1arywz90zs9ac90h0ld5d' name='Shrinks_Table' type='text'>WITH &#13;
&#13;
lost_orders_dh AS (&#13;
&#13;
SELECT&#13;
    --lo.zone_id,&#13;
    DATE(lo2.starts_at,lo.timezone) AS date_local,&#13;
    country_code,&#13;
    city_id,&#13;
    SUM(lo2.net) AS lost_orders_net,&#13;
    -- La suma de todas las órdenes que estimamos que perdimos por achicar o cerrar zonas&#13;
    SUM(CASE WHEN lo.event_type = &quot;shrink&quot; THEN lo2.net ELSE NULL END) AS shrink_orders,&#13;
    -- La suma de todas las órdenes que estimamos que perdimos por achicar zonas&#13;
    SUM(CASE WHEN lo.event_type = &quot;close&quot; THEN lo2.net ELSE NULL END) AS close_orders,&#13;
    -- La suma de todas las órdenes que estimamos que perdimos por cerrar zonas&#13;
    COUNT(DISTINCT e.id) AS events,&#13;
    -- Cantidad de eventos de Shrink y Close&#13;
    COUNT(DISTINCT CASE WHEN lo.event_type = &quot;shrink&quot; THEN e.id ELSE NULL END) AS shrink_events,&#13;
    COUNT(DISTINCT CASE WHEN lo.event_type = &quot;close&quot; THEN e.id ELSE NULL END) AS close_events,&#13;
    ROUND(sum(TIMESTAMP_DIFF(e.ends_at, e.starts_at, minute)),2) AS total_event_duration&#13;
  &#13;
  FROM&#13;
    `fulfillment-dwh-production.curated_data_shared.lost_orders` lo&#13;
  LEFT JOIN UNNEST (lo.lost_orders) AS lo2&#13;
  LEFT JOIN UNNEST (lo.events) AS e&#13;
  &#13;
  WHERE DATE(TIMESTAMP(lo.created_date,lo.timezone))&gt;&gt;=&apos;2022-01-01&apos;&#13;
  GROUP BY 1,2,3&#13;
  ORDER BY 1,2)&#13;
&#13;
,shrinks_data AS(&#13;
SELECT &#13;
      r.*, &#13;
      l.lost_orders_net&#13;
&#13;
FROM `peya-delivery-and-support.automated_tables_reports.daily_shrink_ratio` r&#13;
LEFT JOIN lost_orders_dh l &#13;
ON r.created_date_local=l.date_local &#13;
AND r.country_code=l.country_code &#13;
AND r.city_id=l.city_id&#13;
WHERE r.created_date_local &gt;&gt;=&apos;2022-01-01&apos;)&#13;
&#13;
&#13;
,cvr_data AS (&#13;
&#13;
SELECT&#13;
      created_date_local&#13;
      ,country_code&#13;
      ,city_id&#13;
      ,city_name  &#13;
      ,SUM(total_orders) orders&#13;
      ,SUM(total_sessions_started) sessions&#13;
      ,SUM(total_transactions) transactions&#13;
      ,SUM(cvr2_transactions) cvr2_transactions&#13;
      ,SUM(cvr2_started_sessions) cvr2_sessions&#13;
&#13;
FROM `peya-delivery-and-support.automated_tables_reports.zone_results_by_mean_delay_full` &#13;
WHERE created_date_local &gt;&gt;=&apos;2022-01-01&apos;&#13;
GROUP BY 1,2,3,4)&#13;
&#13;
SELECT&#13;
      s.*&#13;
      ,c.sessions&#13;
      ,c.transactions&#13;
      ,c.cvr2_transactions&#13;
      ,c.cvr2_sessions&#13;
      ,FORMAT_DATE(&apos;%A&apos;,s.created_date_local) AS day_of_week&#13;
&#13;
FROM shrinks_data s&#13;
LEFT JOIN cvr_data c&#13;
ON s.created_date_local=c.created_date_local &#13;
AND lower(s.country_code)=lower(c.country_code)&#13;
AND s.city_id=c.city_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
