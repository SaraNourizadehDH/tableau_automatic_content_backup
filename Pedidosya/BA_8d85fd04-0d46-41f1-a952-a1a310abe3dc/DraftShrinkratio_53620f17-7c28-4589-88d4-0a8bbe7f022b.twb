      s.*&#13;
      ,c.sessions&#13;
      ,c.transactions&#13;
      ,c.cvr2_transactions&#13;
      ,c.cvr2_sessions&#13;
      ,FORMAT_DATE(&apos;%A&apos;,s.created_date_local) AS day_of_week&#13;
&#13;
FROM shrinks_data s&#13;
LEFT JOIN cvr_data c&#13;
ON s.created_date_local=c.created_date_local &#13;
AND lower(s.country_code)=lower(c.country_code)&#13;
