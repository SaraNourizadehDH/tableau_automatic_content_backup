    <datasource caption='Oportunidades cerradas Diciembre 2023 - Marzo 2024 (user_cristobal_navarrete)' inline='true' name='federated.0xo98iy1j7t05k18bv7yb1huprzc' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ruex7o0cyttcu1b0b7w91gqgd65'>
            <connection CATALOG='peya-chile' EXECCATALOG='peya-chile' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-chile' schema='user_cristobal_navarrete' server-oauth='server-custom' username='cristobal.navarrete@pedidosya.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ruex7o0cyttcu1b0b7w91gqgd65' name='OportunidadesCerradas_Dic23_Marzo24' table='[peya-chile.user_cristobal_navarrete].[OportunidadesCerradas_Dic23_Marzo24]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0ruex7o0cyttcu1b0b7w91gqgd65' name='OportunidadesCerradas_Dic23_Marzo24' table='[peya-chile.user_cristobal_navarrete].[OportunidadesCerradas_Dic23_Marzo24]' type='table' />
          <relation connection='bigquery.0ruex7o0cyttcu1b0b7w91gqgd65' name='Consulta SQL personalizada' type='text'>SELECT &#13;
CaseNumber,&#13;
caso.GRID_fm,&#13;
Account_SF.Name as Account_Name,&#13;
User_SF.name As Owner_Onboarding,&#13;
caso.Opportunity as opp,&#13;
sf.opportunity,&#13;
caso.type,&#13;
status,&#13;
IsClosed,&#13;
caso.CreatedDate,&#13;
ClosedDate,&#13;
Closed_Reason&#13;
FROM `peya-data-origins-pro.cl_salesforce.cases` as caso&#13;
&#13;
INNER JOIN &#13;
(&#13;
SELECT GRID_fm,&#13;
max(closedDate) as max_date&#13;
from `peya-data-origins-pro.cl_salesforce.cases` as cas&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` as sf ON cas.Opportunity = sf.oportunity_unique_id&#13;
where cas.type = &quot;Onboarding&quot;&#13;
and isclosed&#13;
and Closed_Reason = &quot;Successful&quot;&#13;
and sf.opportunity is not null&#13;
GROUP BY GRID_fm&#13;
) as aux&#13;
ON aux.Grid_fm = caso.GRID_fm and aux.max_date = caso.ClosedDate&#13;
&#13;
LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` AS User_SF ON caso.OwnerId = User_SF.Id&#13;
LEFT JOIN `peya-data-origins-pro.cl_salesforce.account` AS Account_SF ON caso.AccountId = Account_SF.Id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_sales_executives_closed_won_v2` as sf ON caso.Opportunity = sf.oportunity_unique_id&#13;
&#13;
&#13;
WHERE &#13;
ClosedDate &gt;&gt;= &quot;2023-12-01&quot;&#13;
AND&#13;
 caso.Type = &quot;Onboarding&quot;&#13;
--AND caso.accountid = &quot;0016900002wj9NoAAI&quot;&#13;
AND isclosed&#13;
--AND User_SF.name != &quot;Nicolas Alvarez&quot;&#13;
AND Closed_Reason = &quot;Successful&quot;&#13;
AND sf.opportunity is not null&#13;
--AND caso.GRID_fm = &quot;451U06&quot;&#13;
  AND caso.Account_Country = &quot;Chile&quot;</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
