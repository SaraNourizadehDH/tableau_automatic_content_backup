      <column caption='% bloqueos que terminan en orden o orden posterior' datatype='real' name='[% bloqueos que terminan en orden (copia)_1183039351226925057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([purchase_with_post_order])/sum([total_purchases])' />
