      <_.fcp.ObjectModelTableType.true...column caption='Consulta SQL personalizada' datatype='table' name='[__tableau_internal_object_id__].[_0E96D70DE2EC4AC292E8897FD2E47941]' role='measure' type='quantitative' />
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='date' datatype='datetime' name='[date_created (copia)_998673241690112003]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parámetro 1] when &apos;month&apos; then DATETRUNC(&apos;month&apos;,[date_created]) when &apos;week&apos; then DATETRUNC(&apos;week&apos;,[date_created]) else [date_created] end' />
