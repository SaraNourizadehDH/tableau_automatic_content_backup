      <aliases enabled='yes' />
      <column caption='Opportunity' datatype='real' default-format='p0.00%' name='[Calculation_1163617570649210883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_222646723185377281])/SUM([orders_total])' />
      </column>
      <column caption='Week Number' datatype='integer' name='[Calculation_1986087462129168384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ISOWEEK([session_date])' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_1986087462130733058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND((DATEADD(&apos;day&apos;, 3, DATETRUNC(&apos;week&apos;,[session_date]))-&#13;&#10;&#13;&#10;DATEADD(&apos;day&apos;, 3, DATETRUNC(&apos;year&apos;, DATEADD(&apos;day&apos;, 3, DATETRUNC(&apos;week&apos;,[session_date])))) +&#13;&#10;&#13;&#10;DATEPART(&apos;weekday&apos;, DATEADD(&apos;day&apos;, 2, DATETRUNC(&apos;year&apos;, DATETRUNC(&apos;week&apos;,[session_date]))))&#13;&#10;&#13;&#10;-4) / 7 + 1,0))' />
      </column>
      <column caption='Lost Orders' datatype='real' name='[Calculation_222646723185377281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [session_country_code]=&apos;ar&apos; &#13;&#10;THEN ([adjusted_orders_total_cvr2]-[orders_total_cvr2])*0.5&#13;&#10;&#13;&#10;ELSEIF [session_country_code]&lt;&gt;&apos;ar&apos; &#13;&#10;THEN ([adjusted_orders_total_cvr2]-[orders_total_cvr2])*0.55&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_225179988721897472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([non_confirmed_orders])/SUM([orders_total])' />
      </column>
      <column caption='AVG DT' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_225179988722892801]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([delivery_time])/SUM([orders_total])' />
      </column>
      <column caption='Date (copy)' datatype='date' name='[Date (copy)_1986087462129340417]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[session_date]' />
      </column>
      <column caption='Lost Orders BA' datatype='real' name='[Lost Orders (copy)_737464505058066434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [session_city]=&apos;Buenos aires&apos; THEN&#13;&#10;&#13;&#10;[adjusted_orders_total_cvr2]-[orders_total_cvr2]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Opportunity BA' datatype='real' default-format='p0.00%' name='[Opportunity (copy)_737464505054498816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Lost Orders (copy)_737464505058066434])/SUM([Orders Total (copy)_737464505058238467])' />
      </column>
      <column caption='Orders Total BA' datatype='integer' name='[Orders Total (copy)_737464505058238467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [session_city]=&apos;Buenos aires&apos; THEN&#13;&#10;&#13;&#10;[orders_total]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Session City (copy)' datatype='string' name='[Session City (copy)_37717713065496576]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='[session_city]' />
      </column>
      <column caption='Session Country Code (copy)' datatype='string' name='[Session Country Code (copy)_222646723190820868]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[session_country_code]' />
      </column>
      <column caption='Session Date (copy)' datatype='date' name='[Session Date (copy)_737464505055662081]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[session_date]' />
      </column>
