    <worksheet name='CARD3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='12'>Opportunity Evolution -  City Level DAILY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Order Opportunity Hurrier (Daily)' name='federated.0ez3ytj1h1ko181eiiv270xvyduh' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0ez3ytj1h1ko181eiiv270xvyduh'>
            <column caption='Opportunity' datatype='real' default-format='p0.00%' name='[Calculation_1163617570649210883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_222646723185377281])/SUM([orders_total])' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_1986087462130733058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND((DATEADD(&apos;day&apos;, 3, DATETRUNC(&apos;week&apos;,[session_date]))-&#13;&#10;&#13;&#10;DATEADD(&apos;day&apos;, 3, DATETRUNC(&apos;year&apos;, DATEADD(&apos;day&apos;, 3, DATETRUNC(&apos;week&apos;,[session_date])))) +&#13;&#10;&#13;&#10;DATEPART(&apos;weekday&apos;, DATEADD(&apos;day&apos;, 2, DATETRUNC(&apos;year&apos;, DATETRUNC(&apos;week&apos;,[session_date]))))&#13;&#10;&#13;&#10;-4) / 7 + 1,0))' />
            </column>
            <column caption='Lost Orders' datatype='real' name='[Calculation_222646723185377281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [session_country_code]=&apos;ar&apos; &#13;&#10;THEN ([adjusted_orders_total_cvr2]-[orders_total_cvr2])*0.5&#13;&#10;&#13;&#10;ELSEIF [session_country_code]&lt;&gt;&apos;ar&apos; &#13;&#10;THEN ([adjusted_orders_total_cvr2]-[orders_total_cvr2])*0.55&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Date (copy)' datatype='date' name='[Date (copy)_1986087462129340417]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[session_date]' />
            </column>
            <column caption='Adjusted Orders Total Cvr2' datatype='real' name='[adjusted_orders_total_cvr2]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1986087462130733058]' derivation='None' name='[none:Calculation_1986087462130733058:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_city]' derivation='None' name='[none:session_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_country_code]' derivation='None' name='[none:session_country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[session_date]' derivation='None' name='[none:session_date:qk]' pivot='key' type='quantitative' />
            <column caption='Orders Total' datatype='integer' name='[orders_total]' role='measure' type='quantitative' />
            <column caption='Orders Total Cvr2' datatype='integer' name='[orders_total_cvr2]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[session_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country Code' datatype='string' name='[session_country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[session_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1163617570649210883]' derivation='User' name='[usr:Calculation_1163617570649210883:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Date (copy)_1986087462129340417]' derivation='Week' name='[wk:Date (copy)_1986087462129340417:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ez3ytj1h1ko181eiiv270xvyduh].[none:Calculation_1986087462130733058:nk]' filter-group='15'>
            <groupfilter function='level-members' level='[none:Calculation_1986087462130733058:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0ez3ytj1h1ko181eiiv270xvyduh].[none:session_city:nk]' filter-group='11'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter from='&quot;Aguadulce&quot;' function='range' level='[none:session_city:nk]' to='&quot;Talara&quot;' />
              <groupfilter from='&quot;Tamarindo&quot;' function='range' level='[none:session_city:nk]' to='&quot;Zarate campana&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0ez3ytj1h1ko181eiiv270xvyduh].[none:session_country_code:nk]' filter-group='14'>
            <groupfilter from='&quot;ar&quot;' function='range' level='[none:session_country_code:nk]' to='&quot;ve&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
