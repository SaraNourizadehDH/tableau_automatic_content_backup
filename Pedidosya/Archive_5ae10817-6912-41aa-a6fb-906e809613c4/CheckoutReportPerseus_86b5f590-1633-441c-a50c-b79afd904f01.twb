    <datasource caption='main_source' inline='true' name='federated.1ncj4j40o1bnu81d5tath1ahjems' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0pfnwu10f62n6o16be8480i0zowq'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='automated_tables_reports' server-oauth='' username='santiago.castillo@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0pfnwu10f62n6o16be8480i0zowq' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
    dates AS (
           SELECT 
          --DATE_ADD(DATE_TRUNC(CURRENT_DATE,DAY), INTERVAL -15 day) AS start_date,
          --DATE_ADD(DATE_TRUNC(CURRENT_DATE,DAY), INTERVAL -1 DAY) AS end_date 
          date('2023-06-15') AS start_date,
          date('2023-07-07') AS end_date

    ) ---1665257140648.872156159988543150.w8EpiD9aBGPY_AR
     ,tmp_mcvr4_backend as (
        select CONCAT(sessionId,global_entity_id) as session_id
       --   , max(case when order_id is not null then 1 else null end) as mcvr4_backend
        , MAX(payload_timestamp )  as session_end_timestamp_utc
        , min(payload_timestamp )  as session_start_timestamp_utc
        , max(case when eventaction = 'checkout.loaded'  then 1 else 0 end) as mcvr4_checkout_sessions_trad
        , max(case when eventaction = 'transaction'  then 1 else 0      end) as mcvr4_transactions
        , max(userid) as user_id
        FROM `peya-data-origins-pro.cl_sessions.perseus_events`
        WHERE TRUE
        AND partition_date >>= (SELECT start_date FROM dates)
        AND partition_date <<  (SELECT end_date FROM dates)
        GROUP BY 1
        )
    , mcvr4 as (
        SELECT m.*
        , max(case when order_id is not null then 1 when mcvr4_checkout_sessions_trad = 1 then 0 else null end) as mcvr4_orders_backend
        , max(case when  order_id is not null then 1 when mcvr4_checkout_sessions_trad = 1 then 1 else null end) as mcvr4_checkout_sessions
        FROM tmp_mcvr4_backend m
        LEFT JOIN (SELECT order_id
        , user.id as user_id
        ,registered_at_utc
        FROM `peya-bi-tools-pro.il_core.fact_orders`
        where date(registered_date) >>= (SELECT start_date FROM dates)
        ) o on o.user_id = safe_cast(m.user_id as int64) and o.registered_at_utc between session_start_timestamp_utc and session_end_timestamp_utc 
        group by 1,2,3,4,5,6
    )   ,
    funnel AS (
        SELECT 
            f.country_id,
            c.country_name,
            f.platform_DH AS platform,
            f.date,
            CASE WHEN checkout_restaurant = 1 THEN "RESTAURANT"
                WHEN checkout_groceries = 1 THEN "GROCERIES"
                WHEN checkout_coffee = 1 THEN "COFFEE"
                WHEN checkout_courier = 1 THEN "COURIER"
                WHEN checkout_drinks = 1 THEN "DRINKS"
                WHEN checkout_pharmacy = 1 THEN "PHARMACY"
                WHEN checkout_pets = 1 THEN "PETS"
                WHEN checkout_shops = 1 THEN "SHOP"
                WHEN checkout_kiosks = 1 THEN "KIOSKS"
                WHEN checkout_other_vertical = 1 THEN "OTHERS"
                ELSE 'NA'
                END AS vertical,
            CASE WHEN f.user_ordered_before=TRUE THEN TRUE ELSE FALSE END AS returning_user,
            COUNT(DISTINCT f.sessionId) AS total_sessions,
            SUM(m.mcvr4_orders_backend) AS mcvr4_orders_backend,
            SUM(m.mcvr4_checkout_sessions) AS mcvr4_checkout_sessions,
            SUM(m.mcvr4_transactions) AS mcvr4_transactions,
            SUM(m.mcvr4_checkout_sessions_trad) AS mcvr4_checkout_sessions_trad,
            SUM(CASE WHEN (f.checkout_summary_loaded=1 OR f.payment_method_loaded=1) THEN 1 END) AS chk_or_pm_loaded,
            SUM(f.transaction_delivery) AS transactions_delivery,
            SUM(f.transaction_online) AS transactions_online,
            SUM(f.transaction_failed) AS transactions_failed,
            SUM(f.transaction) AS transactions_succeeded,
            
            SUM(f.cart_loaded) AS cart_loaded,
            SUM(f.checkout_clicked) AS checkout_clicked,
            SUM(f.checkout_summary_loaded) AS checkout_summary_loaded,
            SUM(f.payment_method_loaded) AS payment_method_loaded,
            SUM(f.payment_method_before_checkout) AS payment_method_loaded_before_checkout,
            SUM(f.transaction_clicked) AS transaction_clicked,
            SUM(f.transaction_failed) AS transaction_failed,

            /*----CART----*/
            SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_clicked <<>>1 AND f.checkout_summary_loaded<<>>1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS cart_drop_before_checkout,
            SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_clicked =1) THEN 1 END) AS cart_loaded_checkout_clicked,
            /*--SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_clicked <<>>1) THEN 1 END) AS cart_drop_before_clicked,
            --SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_summary_loaded =1) THEN 1 END) AS cart_loaded_checkout_loaded,*/

            /*----CHECKOUT AND PAYMENT METHODS----*/
            SUM(CASE WHEN (f.payment_method_before_checkout =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS pm_loaded_chk_summary_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS checkout_clicked_checkout_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_before_checkout =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_clicked_pm_loaded_chk_summary_loaded,
            SUM(CASE WHEN (f.payment_method_loaded =1 AND f.checkout_summary_loaded <<>>1) THEN 1 END) AS pm_loaded_no_chk,
            SUM(CASE WHEN (f.payment_method_loaded =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_loaded_pm_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_before_checkout =1) THEN 1 END) AS checkout_clicked_pm_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_loaded =1 AND f.checkout_summary_loaded <<>>1) THEN 1 END) AS chk_clicked_pm_loaded_no_chk,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.checkout_summary_loaded <<>>1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS checkout_clicked_no_chk_no_pm, 
            SUM(CASE WHEN (f.payment_method_before_checkout =1 AND f.checkout_summary_loaded <<>>1) THEN 1 END) AS pm_loaded_before_chk_drop,

            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_summary_loaded_pm_loaded,
            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1 AND f.transaction = 1) THEN 1 END) AS chk_summary_loaded_pm_loaded_and_transaction,

            /*--SUM(CASE WHEN (f.checkout_clicked =1 AND f.checkout_summary_loaded =1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS checkout_clicked_checkout_loaded_no_pm,
            --SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_loaded =1) THEN 1 END) AS checkout_clicked_pm_loaded,          
            --SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS chk_loaded_no_pm,
            --SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_after_checkout <<>>1) THEN 1 END) AS chk_loaded_no_pm_after,*/

            SUM(CASE WHEN (f.checkout_summary_loaded =1 AND (f.payment_method_after_checkout <<>>1 OR f.payment_method_after_checkout IS NULL) AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_no_pm_after_drop,
            SUM(CASE WHEN (f.checkout_summary_loaded =1 AND (f.payment_method_after_checkout <<>>1 OR f.payment_method_after_checkout IS NULL) AND f.transaction_clicked =1) THEN 1 END) AS chk_no_pm_after_transaction_clicked,
            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1 AND f.transaction_clicked =1) THEN 1 END) AS chk_pm_after_transaction_clicked,
            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1 AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_pm_after_no_transaction_clicked,

            /*--SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_loaded <<>>1 AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_no_pm_no_transaction_clicked,
            --SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_loaded=1 AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_pm_no_transaction_clicked,
            --SUM(CASE WHEN (f.checkout_summary_loaded <<>>1 AND f.payment_method_loaded=1 AND f.transaction_clicked =1) THEN 1 END) AS pm_no_chk_transaction_clicked,*/

            /*---- ADDRESS AND CHECKOUT ----*/

            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.address_loaded_chk = 1 THEN 1 ELSE 0 END) AS chk_loaded_address_loaded,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.address_change_chk = 1 THEN 1 ELSE 0 END) AS chk_loaded_address_change,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.address_change_chk = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS chk_loaded_address_change_and_transaction,

            /*---- DONATIONS AND CHECKOUT ----*/

            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.donation_clicked = 1 THEN 1 ELSE 0 END) AS chk_loaded_donation_clicked,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.donation_updated = 1 THEN 1 ELSE 0 END) AS chk_loaded_donation_updated,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.donation_updated = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS chk_loaded_donation_updated_and_transaction,

            /*---- TIPS AND CHECKOUT ----*/

            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.tip_edited = 1 THEN 1 ELSE 0 END) AS chk_loaded_tip_edited,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.tip_edited = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS chk_loaded_tip_edited_and_transaction,

            /*---- VOUCHERS AND CHECKOUT ----*/
            
            SUM(CASE WHEN f.voucher_loaded_checkout = 1 THEN 1 ELSE 0 END) AS voucher_loaded_chk,
            SUM(CASE WHEN f.voucher_reserve_checkout = 1 THEN 1 ELSE 0 END) AS voucher_reserved_chk,
            SUM(CASE WHEN f.voucher_reserve_checkout = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS voucher_reserved_chk_and_transaction,

            /*---- BILLING AND CHECKOUT ---*/
            
            SUM(CASE WHEN f.billing_info_loaded = 1 THEN 1 ELSE 0 END) AS billing_info_loaded_chk,
            SUM(CASE WHEN f.billing_info_saved = 1 THEN 1 ELSE 0 END) AS billing_info_saved_chk,
            SUM(CASE WHEN f.billing_info_saved = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS billing_info_saved_chk_and_transaction,
            
            /*----TRANSACTION----*/
        
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_loaded_transaction_clicked,
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.transaction <<>>1 AND f.transaction_failed<<>>1) THEN 1 END) AS transaction_clicked_no_transaction_or_fail,            
            SUM(CASE WHEN (f.transaction=1 AND f.transaction_failed<<>>1) THEN 1 END) AS transaction_without_fail,
            SUM(CASE WHEN (f.transaction=1 AND f.transaction_failed=1) THEN 1 END) AS transaction_with_fail,
            SUM(CASE WHEN (f.transaction<<>>1 AND f.transaction_failed =1) THEN 1 END) AS no_transaction_with_fail,
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.transaction=1 AND f.transaction_failed<<>>1) THEN 1 END) AS transaction_clicked_transaction_without_fail,
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.transaction_failed=1) THEN 1 END) AS transaction_clicked_transaction_fail,

            SUM(f.add_card_click) AS add_card_click,
            SUM(f.add_card_proceeded) AS add_card_proceeded,
            SUM(CASE WHEN (f.add_card_click=1 AND f.add_card_cancel=1) THEN 1 END) AS add_card_clicked_cancel,
            SUM(f.add_card_cancel) AS add_card_cancel,
            /*
            --SUM(f.delete_card_click) AS delete_card_click,
            --SUM(CASE WHEN (f.delete_card_click=1 AND f.delete_card_proceeded<<>>1) THEN 1 END) AS delete_card_cancel,
            --SUM(f.delete_card_proceeded) AS delete_card_proceeded,*/


        FROM `peya-delivery-and-support.automated_tables_reports.perseus_checkout_funnel`  AS f
        LEFT JOIN mcvr4 AS m ON m.session_id=f.sessionId
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON f.country_id=c.country_id
        WHERE date >>= (SELECT start_date FROM dates)
        AND date << (SELECT end_date FROM dates)
        GROUP BY 1,2,3,4,5,6


    ),
        payments_states AS (
        SELECT
            p.payment_id,
            p.country_id,
            CASE WHEN p.order_application = "ANDROID" THEN "Android"
                WHEN p.order_application = "IPHONE" THEN "iOS"
                WHEN p.order_application = "WEB" THEN "Web"
                WHEN p.order_application = "web" THEN "Web"
                WHEN p.order_application = "WEB_MOBILE"THEN "mWeb"
                WHEN p.order_application = "huawei" THEN "Android"
                ELSE "other"
                END AS platform,
            CASE WHEN pt.initiative = "COURIER_BUSINESS" THEN "COURIER"
                WHEN pt.initiative = "FLOWERS" THEN "OTHERS"
                ELSE pt.initiative
                END AS vertical,
            DATE_TRUNC(DATE(p.date_created),DAY) AS payment_date,
            CASE
                WHEN (REPLACE(payment_state,'_', '') = 'AUTHORIZED' AND order_id IS NOT NULL) THEN 'ACCEPTED'
                WHEN REPLACE(payment_state,'_', '') = 'AUTHORIZED' THEN 'REJECTED'
                WHEN REPLACE(payment_state,'_', '') IN ('PENDING', 'TIMEOUT', 'AUTHORIZED', 'ERROR', 'ANTIFRAUD', 'BLOCKED', 'SCORING') OR payment_state IS NULL OR payment_state ='' THEN 'NA'
                WHEN REPLACE(payment_state,'_', '') IN ('ACCEPTED','REFUNDED','PARTIALREFUNDED','CANCELLED','CHARGEBACK') THEN 'ACCEPTED'
                WHEN REPLACE(payment_reject_reason,'_','') IN ('ANTIFRAUD', 'FRAUDRISK', 'COULDNOTSCORE', 'INTERNALRULES', 'REJECTEDBYIDEMPOTENCY') THEN 'NA'
                WHEN payment_reject_reason IS NOT NULL AND payment_reject_reason != '' THEN 'REJECTED'
                ELSE  'NA' 
            END AS payment_state_gateway,
            CASE
                WHEN date_created << '2021-07-01' AND internal_rules = 'BLACK' THEN 'REJECTED'  WHEN date_created << '2021-07-01' AND internal_rules != 'BLACK' AND internal_rules IS NOT NULL AND internal_rules!='' THEN 'ACCEPTED'
                WHEN date_created << '2021-07-01' THEN 'NA'
                WHEN date_created >>= '2021-07-01' AND REPLACE(payment_reject_reason,'_','') = 'INTERNALRULES' THEN 'REJECTED'
                ELSE 'ACCEPTED'
            END AS payment_state_antifraud_int,
            CASE  
                WHEN payment_reject_reason IN ('ANTIFRAUD','FRAUD_RISK') THEN 'REJECTED'
                WHEN payment_state IN ('PENDING','TIMEOUT','ERROR') OR payment_reject_reason = 'COULD_NOT_SCORE' OR payment_state IS NULL OR payment_state = '' THEN 'NA'
                ELSE 'ACCEPTED' 
            END AS payment_state_antifraud_ext,
        CASE  WHEN REPLACE(p.payment_state,'_', '') in ('BLOCKED') then 'REJECTED' ELSE 'ACCEPTED' end as payment_state_int_block,
        CASE  WHEN REPLACE(p.payment_state,'_', '') in ('PENDING','TIMEOUT','ERROR') then 'REJECTED' ELSE 'ACCEPTED' end as payment_state_af_tech,
        FROM `peya-bi-tools-pro.il_payments.fact_payments_transaction` AS p
        LEFT JOIN `peya-data-origins-pro.cl_payments.payment_type` AS pt ON p.payment_id = pt.payment_id
        WHERE date(p.date_created) >>= (SELECT start_date FROM dates)
        AND date(p.date_created) << (SELECT end_date FROM dates)
        AND pt.initiative IN ("COFFEE", "COURIER", "COURIER_BUSINESS","DRINKS","FLOWERS","GROCERIES","KIOSKS","PETS","PHARMACY","RESTAURANT","SHOP")
    ),
    payments AS (
        SELECT 
            payment_date,
            country_id,
            platform,
            vertical,
            TRUE as returning_user,
            COUNT(DISTINCT CASE WHEN payment_state_gateway = 'ACCEPTED' AND payment_state_antifraud_int <<>> 'REJECTED' AND payment_state_antifraud_ext <<>> 'REJECTED' THEN payment_id END) AS payments_accepted,
            COUNT(DISTINCT payment_id) AS payments_total,
            COUNT(DISTINCT CASE WHEN payment_state_int_block !='REJECTED' AND payment_state_af_tech !='REJECTED' THEN payment_id END) as payments_total_business
        FROM payments_states
        GROUP BY 1,2,3,4,5
    ),
    vouchers_fail AS (
        SELECT  
            DATE_TRUNC(session_date,DAY) AS full_date,
            platform as platform,
            c.country_id,
            CASE WHEN visitortype='Returning Visitor' THEN TRUE ELSE FALSE END AS returning_user,
            'NA' AS vertical,
            SUM(CASE WHEN eventaction="reserve_coupon.failed" THEN qty_events END) AS reserve_failed_events,
            SUM(CASE WHEN eventaction="redeem_coupon.failed" THEN qty_events END) AS redeem_failed_events,

        FROM `peya-growth-and-onboarding.automated_tables_reports.board_acquisition_coupon_reserve_and_redeem_events_daily` AS v
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON c.country_name=v.cdcountry
        WHERE DATE(session_date) >>= (SELECT start_date FROM dates)
        AND DATE(session_date) << (SELECT end_date FROM dates)
        GROUP BY 1,2,3,4,5

    )



SELECT 
f.*,
p.payments_accepted,
p.payments_total,
p.payments_total_business,
v.reserve_failed_events,
v.redeem_failed_events,

FROM funnel AS f
LEFT JOIN payments AS p ON f.date=p.payment_date AND f.country_id=p.country_id AND f.platform=p.platform AND f.vertical=p.vertical AND f.returning_user=p.returning_user
LEFT JOIN vouchers_fail AS v ON f.date=v.full_date AND f.country_id=v.country_id AND f.platform=v.platform AND f.vertical=v.vertical AND f.returning_user=v.returning_user]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0pfnwu10f62n6o16be8480i0zowq' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
    dates AS (
           SELECT 
          --DATE_ADD(DATE_TRUNC(CURRENT_DATE,DAY), INTERVAL -15 day) AS start_date,
          --DATE_ADD(DATE_TRUNC(CURRENT_DATE,DAY), INTERVAL -1 DAY) AS end_date 
          date('2023-06-15') AS start_date,
          date('2023-07-07') AS end_date

    ) ---1665257140648.872156159988543150.w8EpiD9aBGPY_AR
     ,tmp_mcvr4_backend as (
        select CONCAT(sessionId,global_entity_id) as session_id
       --   , max(case when order_id is not null then 1 else null end) as mcvr4_backend
        , MAX(payload_timestamp )  as session_end_timestamp_utc
        , min(payload_timestamp )  as session_start_timestamp_utc
        , max(case when eventaction = 'checkout.loaded'  then 1 else 0 end) as mcvr4_checkout_sessions_trad
        , max(case when eventaction = 'transaction'  then 1 else 0      end) as mcvr4_transactions
        , max(userid) as user_id
        FROM `peya-data-origins-pro.cl_sessions.perseus_events`
        WHERE TRUE
        AND partition_date >>= (SELECT start_date FROM dates)
        AND partition_date <<  (SELECT end_date FROM dates)
        GROUP BY 1
        )
    , mcvr4 as (
        SELECT m.*
        , max(case when order_id is not null then 1 when mcvr4_checkout_sessions_trad = 1 then 0 else null end) as mcvr4_orders_backend
        , max(case when  order_id is not null then 1 when mcvr4_checkout_sessions_trad = 1 then 1 else null end) as mcvr4_checkout_sessions
        FROM tmp_mcvr4_backend m
        LEFT JOIN (SELECT order_id
        , user.id as user_id
        ,registered_at_utc
        FROM `peya-bi-tools-pro.il_core.fact_orders`
        where date(registered_date) >>= (SELECT start_date FROM dates)
        ) o on o.user_id = safe_cast(m.user_id as int64) and o.registered_at_utc between session_start_timestamp_utc and session_end_timestamp_utc 
        group by 1,2,3,4,5,6
    )   ,
    funnel AS (
        SELECT 
            f.country_id,
            c.country_name,
            f.platform_DH AS platform,
            f.date,
            CASE WHEN checkout_restaurant = 1 THEN "RESTAURANT"
                WHEN checkout_groceries = 1 THEN "GROCERIES"
                WHEN checkout_coffee = 1 THEN "COFFEE"
                WHEN checkout_courier = 1 THEN "COURIER"
                WHEN checkout_drinks = 1 THEN "DRINKS"
                WHEN checkout_pharmacy = 1 THEN "PHARMACY"
                WHEN checkout_pets = 1 THEN "PETS"
                WHEN checkout_shops = 1 THEN "SHOP"
                WHEN checkout_kiosks = 1 THEN "KIOSKS"
                WHEN checkout_other_vertical = 1 THEN "OTHERS"
                ELSE 'NA'
                END AS vertical,
            CASE WHEN f.user_ordered_before=TRUE THEN TRUE ELSE FALSE END AS returning_user,
            COUNT(DISTINCT f.sessionId) AS total_sessions,
            SUM(m.mcvr4_orders_backend) AS mcvr4_orders_backend,
            SUM(m.mcvr4_checkout_sessions) AS mcvr4_checkout_sessions,
            SUM(m.mcvr4_transactions) AS mcvr4_transactions,
            SUM(m.mcvr4_checkout_sessions_trad) AS mcvr4_checkout_sessions_trad,
            SUM(CASE WHEN (f.checkout_summary_loaded=1 OR f.payment_method_loaded=1) THEN 1 END) AS chk_or_pm_loaded,
            SUM(f.transaction_delivery) AS transactions_delivery,
            SUM(f.transaction_online) AS transactions_online,
            SUM(f.transaction_failed) AS transactions_failed,
            SUM(f.transaction) AS transactions_succeeded,
            
            SUM(f.cart_loaded) AS cart_loaded,
            SUM(f.checkout_clicked) AS checkout_clicked,
            SUM(f.checkout_summary_loaded) AS checkout_summary_loaded,
            SUM(f.payment_method_loaded) AS payment_method_loaded,
            SUM(f.payment_method_before_checkout) AS payment_method_loaded_before_checkout,
            SUM(f.transaction_clicked) AS transaction_clicked,
            SUM(f.transaction_failed) AS transaction_failed,

            /*----CART----*/
            SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_clicked <<>>1 AND f.checkout_summary_loaded<<>>1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS cart_drop_before_checkout,
            SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_clicked =1) THEN 1 END) AS cart_loaded_checkout_clicked,
            /*--SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_clicked <<>>1) THEN 1 END) AS cart_drop_before_clicked,
            --SUM(CASE WHEN (f.cart_loaded=1 AND f.checkout_summary_loaded =1) THEN 1 END) AS cart_loaded_checkout_loaded,*/

            /*----CHECKOUT AND PAYMENT METHODS----*/
            SUM(CASE WHEN (f.payment_method_before_checkout =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS pm_loaded_chk_summary_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS checkout_clicked_checkout_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_before_checkout =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_clicked_pm_loaded_chk_summary_loaded,
            SUM(CASE WHEN (f.payment_method_loaded =1 AND f.checkout_summary_loaded <<>>1) THEN 1 END) AS pm_loaded_no_chk,
            SUM(CASE WHEN (f.payment_method_loaded =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_loaded_pm_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_before_checkout =1) THEN 1 END) AS checkout_clicked_pm_loaded,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_loaded =1 AND f.checkout_summary_loaded <<>>1) THEN 1 END) AS chk_clicked_pm_loaded_no_chk,
            SUM(CASE WHEN (f.checkout_clicked =1 AND f.checkout_summary_loaded <<>>1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS checkout_clicked_no_chk_no_pm, 
            SUM(CASE WHEN (f.payment_method_before_checkout =1 AND f.checkout_summary_loaded <<>>1) THEN 1 END) AS pm_loaded_before_chk_drop,

            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_summary_loaded_pm_loaded,
            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1 AND f.transaction = 1) THEN 1 END) AS chk_summary_loaded_pm_loaded_and_transaction,

            /*--SUM(CASE WHEN (f.checkout_clicked =1 AND f.checkout_summary_loaded =1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS checkout_clicked_checkout_loaded_no_pm,
            --SUM(CASE WHEN (f.checkout_clicked =1 AND f.payment_method_loaded =1) THEN 1 END) AS checkout_clicked_pm_loaded,          
            --SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_loaded <<>>1) THEN 1 END) AS chk_loaded_no_pm,
            --SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_after_checkout <<>>1) THEN 1 END) AS chk_loaded_no_pm_after,*/

            SUM(CASE WHEN (f.checkout_summary_loaded =1 AND (f.payment_method_after_checkout <<>>1 OR f.payment_method_after_checkout IS NULL) AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_no_pm_after_drop,
            SUM(CASE WHEN (f.checkout_summary_loaded =1 AND (f.payment_method_after_checkout <<>>1 OR f.payment_method_after_checkout IS NULL) AND f.transaction_clicked =1) THEN 1 END) AS chk_no_pm_after_transaction_clicked,
            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1 AND f.transaction_clicked =1) THEN 1 END) AS chk_pm_after_transaction_clicked,
            SUM(CASE WHEN (f.payment_method_after_checkout =1 AND f.checkout_summary_loaded =1 AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_pm_after_no_transaction_clicked,

            /*--SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_loaded <<>>1 AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_no_pm_no_transaction_clicked,
            --SUM(CASE WHEN (f.checkout_summary_loaded =1 AND f.payment_method_loaded=1 AND f.transaction_clicked <<>>1) THEN 1 END) AS chk_pm_no_transaction_clicked,
            --SUM(CASE WHEN (f.checkout_summary_loaded <<>>1 AND f.payment_method_loaded=1 AND f.transaction_clicked =1) THEN 1 END) AS pm_no_chk_transaction_clicked,*/

            /*---- ADDRESS AND CHECKOUT ----*/

            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.address_loaded_chk = 1 THEN 1 ELSE 0 END) AS chk_loaded_address_loaded,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.address_change_chk = 1 THEN 1 ELSE 0 END) AS chk_loaded_address_change,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.address_change_chk = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS chk_loaded_address_change_and_transaction,

            /*---- DONATIONS AND CHECKOUT ----*/

            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.donation_clicked = 1 THEN 1 ELSE 0 END) AS chk_loaded_donation_clicked,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.donation_updated = 1 THEN 1 ELSE 0 END) AS chk_loaded_donation_updated,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.donation_updated = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS chk_loaded_donation_updated_and_transaction,

            /*---- TIPS AND CHECKOUT ----*/

            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.tip_edited = 1 THEN 1 ELSE 0 END) AS chk_loaded_tip_edited,
            SUM(CASE WHEN f.checkout_summary_loaded = 1 AND f.tip_edited = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS chk_loaded_tip_edited_and_transaction,

            /*---- VOUCHERS AND CHECKOUT ----*/
            
            SUM(CASE WHEN f.voucher_loaded_checkout = 1 THEN 1 ELSE 0 END) AS voucher_loaded_chk,
            SUM(CASE WHEN f.voucher_reserve_checkout = 1 THEN 1 ELSE 0 END) AS voucher_reserved_chk,
            SUM(CASE WHEN f.voucher_reserve_checkout = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS voucher_reserved_chk_and_transaction,

            /*---- BILLING AND CHECKOUT ---*/
            
            SUM(CASE WHEN f.billing_info_loaded = 1 THEN 1 ELSE 0 END) AS billing_info_loaded_chk,
            SUM(CASE WHEN f.billing_info_saved = 1 THEN 1 ELSE 0 END) AS billing_info_saved_chk,
            SUM(CASE WHEN f.billing_info_saved = 1 AND f.transaction = 1 THEN 1 ELSE 0 END) AS billing_info_saved_chk_and_transaction,
            
            /*----TRANSACTION----*/
        
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.checkout_summary_loaded =1) THEN 1 END) AS chk_loaded_transaction_clicked,
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.transaction <<>>1 AND f.transaction_failed<<>>1) THEN 1 END) AS transaction_clicked_no_transaction_or_fail,            
            SUM(CASE WHEN (f.transaction=1 AND f.transaction_failed<<>>1) THEN 1 END) AS transaction_without_fail,
            SUM(CASE WHEN (f.transaction=1 AND f.transaction_failed=1) THEN 1 END) AS transaction_with_fail,
            SUM(CASE WHEN (f.transaction<<>>1 AND f.transaction_failed =1) THEN 1 END) AS no_transaction_with_fail,
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.transaction=1 AND f.transaction_failed<<>>1) THEN 1 END) AS transaction_clicked_transaction_without_fail,
            SUM(CASE WHEN (f.transaction_clicked =1 AND f.transaction_failed=1) THEN 1 END) AS transaction_clicked_transaction_fail,

            SUM(f.add_card_click) AS add_card_click,
            SUM(f.add_card_proceeded) AS add_card_proceeded,
            SUM(CASE WHEN (f.add_card_click=1 AND f.add_card_cancel=1) THEN 1 END) AS add_card_clicked_cancel,
            SUM(f.add_card_cancel) AS add_card_cancel,
            /*
            --SUM(f.delete_card_click) AS delete_card_click,
            --SUM(CASE WHEN (f.delete_card_click=1 AND f.delete_card_proceeded<<>>1) THEN 1 END) AS delete_card_cancel,
            --SUM(f.delete_card_proceeded) AS delete_card_proceeded,*/


        FROM `peya-delivery-and-support.automated_tables_reports.perseus_checkout_funnel`  AS f
        LEFT JOIN mcvr4 AS m ON m.session_id=f.sessionId
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON f.country_id=c.country_id
        WHERE date >>= (SELECT start_date FROM dates)
        AND date << (SELECT end_date FROM dates)
        GROUP BY 1,2,3,4,5,6


    ),
        payments_states AS (
        SELECT
            p.payment_id,
            p.country_id,
            CASE WHEN p.order_application = "ANDROID" THEN "Android"
                WHEN p.order_application = "IPHONE" THEN "iOS"
                WHEN p.order_application = "WEB" THEN "Web"
                WHEN p.order_application = "web" THEN "Web"
                WHEN p.order_application = "WEB_MOBILE"THEN "mWeb"
                WHEN p.order_application = "huawei" THEN "Android"
                ELSE "other"
                END AS platform,
            CASE WHEN pt.initiative = "COURIER_BUSINESS" THEN "COURIER"
                WHEN pt.initiative = "FLOWERS" THEN "OTHERS"
                ELSE pt.initiative
                END AS vertical,
            DATE_TRUNC(DATE(p.date_created),DAY) AS payment_date,
            CASE
                WHEN (REPLACE(payment_state,'_', '') = 'AUTHORIZED' AND order_id IS NOT NULL) THEN 'ACCEPTED'
                WHEN REPLACE(payment_state,'_', '') = 'AUTHORIZED' THEN 'REJECTED'
                WHEN REPLACE(payment_state,'_', '') IN ('PENDING', 'TIMEOUT', 'AUTHORIZED', 'ERROR', 'ANTIFRAUD', 'BLOCKED', 'SCORING') OR payment_state IS NULL OR payment_state ='' THEN 'NA'
                WHEN REPLACE(payment_state,'_', '') IN ('ACCEPTED','REFUNDED','PARTIALREFUNDED','CANCELLED','CHARGEBACK') THEN 'ACCEPTED'
                WHEN REPLACE(payment_reject_reason,'_','') IN ('ANTIFRAUD', 'FRAUDRISK', 'COULDNOTSCORE', 'INTERNALRULES', 'REJECTEDBYIDEMPOTENCY') THEN 'NA'
                WHEN payment_reject_reason IS NOT NULL AND payment_reject_reason != '' THEN 'REJECTED'
                ELSE  'NA' 
            END AS payment_state_gateway,
            CASE
                WHEN date_created << '2021-07-01' AND internal_rules = 'BLACK' THEN 'REJECTED'  WHEN date_created << '2021-07-01' AND internal_rules != 'BLACK' AND internal_rules IS NOT NULL AND internal_rules!='' THEN 'ACCEPTED'
                WHEN date_created << '2021-07-01' THEN 'NA'
                WHEN date_created >>= '2021-07-01' AND REPLACE(payment_reject_reason,'_','') = 'INTERNALRULES' THEN 'REJECTED'
                ELSE 'ACCEPTED'
            END AS payment_state_antifraud_int,
            CASE  
                WHEN payment_reject_reason IN ('ANTIFRAUD','FRAUD_RISK') THEN 'REJECTED'
                WHEN payment_state IN ('PENDING','TIMEOUT','ERROR') OR payment_reject_reason = 'COULD_NOT_SCORE' OR payment_state IS NULL OR payment_state = '' THEN 'NA'
                ELSE 'ACCEPTED' 
            END AS payment_state_antifraud_ext,
        CASE  WHEN REPLACE(p.payment_state,'_', '') in ('BLOCKED') then 'REJECTED' ELSE 'ACCEPTED' end as payment_state_int_block,
        CASE  WHEN REPLACE(p.payment_state,'_', '') in ('PENDING','TIMEOUT','ERROR') then 'REJECTED' ELSE 'ACCEPTED' end as payment_state_af_tech,
        FROM `peya-bi-tools-pro.il_payments.fact_payments_transaction` AS p
        LEFT JOIN `peya-data-origins-pro.cl_payments.payment_type` AS pt ON p.payment_id = pt.payment_id
        WHERE date(p.date_created) >>= (SELECT start_date FROM dates)
        AND date(p.date_created) << (SELECT end_date FROM dates)
        AND pt.initiative IN ("COFFEE", "COURIER", "COURIER_BUSINESS","DRINKS","FLOWERS","GROCERIES","KIOSKS","PETS","PHARMACY","RESTAURANT","SHOP")
    ),
    payments AS (
        SELECT 
            payment_date,
            country_id,
            platform,
            vertical,
            TRUE as returning_user,
            COUNT(DISTINCT CASE WHEN payment_state_gateway = 'ACCEPTED' AND payment_state_antifraud_int <<>> 'REJECTED' AND payment_state_antifraud_ext <<>> 'REJECTED' THEN payment_id END) AS payments_accepted,
            COUNT(DISTINCT payment_id) AS payments_total,
            COUNT(DISTINCT CASE WHEN payment_state_int_block !='REJECTED' AND payment_state_af_tech !='REJECTED' THEN payment_id END) as payments_total_business
        FROM payments_states
        GROUP BY 1,2,3,4,5
    ),
    vouchers_fail AS (
        SELECT  
            DATE_TRUNC(session_date,DAY) AS full_date,
            platform as platform,
            c.country_id,
            CASE WHEN visitortype='Returning Visitor' THEN TRUE ELSE FALSE END AS returning_user,
            'NA' AS vertical,
            SUM(CASE WHEN eventaction="reserve_coupon.failed" THEN qty_events END) AS reserve_failed_events,
            SUM(CASE WHEN eventaction="redeem_coupon.failed" THEN qty_events END) AS redeem_failed_events,

        FROM `peya-growth-and-onboarding.automated_tables_reports.board_acquisition_coupon_reserve_and_redeem_events_daily` AS v
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON c.country_name=v.cdcountry
        WHERE DATE(session_date) >>= (SELECT start_date FROM dates)
        AND DATE(session_date) << (SELECT end_date FROM dates)
        GROUP BY 1,2,3,4,5

    )



SELECT 
f.*,
p.payments_accepted,
p.payments_total,
p.payments_total_business,
v.reserve_failed_events,
v.redeem_failed_events,

FROM funnel AS f
LEFT JOIN payments AS p ON f.date=p.payment_date AND f.country_id=p.country_id AND f.platform=p.platform AND f.vertical=p.vertical AND f.returning_user=p.returning_user
LEFT JOIN vouchers_fail AS v ON f.date=v.full_date AND f.country_id=v.country_id AND f.platform=v.platform AND f.vertical=v.vertical AND f.returning_user=v.returning_user]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
