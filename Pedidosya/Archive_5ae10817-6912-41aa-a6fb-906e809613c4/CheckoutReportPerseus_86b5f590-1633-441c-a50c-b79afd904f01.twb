            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ncj4j40o1bnu81d5tath1ahjems'>
            <column caption='Checkout Clicked Drop' datatype='integer' name='[Calculation_1331095183569326083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_clicked_no_chk_no_pm])' />
            </column>
            <column caption='Checkout Summary after Payment Method' datatype='integer' name='[Calculation_1331095183570796549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pm_loaded_chk_summary_loaded])' />
            </column>
            <column caption='Checkout Summary Loaded' datatype='integer' name='[Calculation_1331095183571365896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_summary_loaded])' />
            </column>
            <column caption='Payment Methods After Checkout' datatype='integer' name='[Calculation_1331095183572389899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chk_summary_loaded_pm_loaded])' />
            </column>
            <column caption='Checkout no PM Transaction Clicked' datatype='integer' name='[Calculation_1331095183572787213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([chk_no_pm_after_transaction_clicked])' />
            </column>
            <column caption='Checkout no PM Drop' datatype='integer' name='[Calculation_1331095183574429711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chk_no_pm_after_drop])' />
            </column>
            <column caption='PM after Checkout Transaction Clicked' datatype='integer' name='[Calculation_1331095183574867985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chk_pm_after_transaction_clicked])' />
            </column>
            <column caption='PM after Checkout Drop' datatype='integer' name='[Calculation_1331095183575281683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chk_pm_after_no_transaction_clicked])' />
            </column>
            <column caption='Detail' datatype='string' name='[Calculation_801077799647981581]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;    WHEN &apos;Country&apos; THEN [country_name]&#13;&#10;    WHEN &apos;Platform&apos; THEN [platform]&#13;&#10;    WHEN &apos;Vertical&apos; THEN [vertical]&#13;&#10;    WHEN &apos;Day&apos; THEN STR(DATETRUNC(&apos;day&apos;,[date]))&#13;&#10;    WHEN &apos;Week&apos; THEN STR(DATETRUNC(&apos;week&apos;,[date]))&#13;&#10;    WHEN &apos;Month&apos; THEN STR(DATETRUNC(&apos;month&apos;,[date]))&#13;&#10;ELSE NULL END' />
            </column>
            <column caption='Checkout Loaded Default Payment Method' datatype='integer' name='[Calculation_913949267446751232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_summary_loaded])-SUM(pm_loaded_chk_summary_loaded)' />
            </column>
            <column caption='Payment Method Loaded Before Checkout' datatype='integer' name='[Calculation_913949267448778753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pm_loaded_chk_summary_loaded])&#13;&#10;+SUM(ZN(pm_loaded_no_chk))' />
            </column>
            <column caption='Checkout Loaded No PM' datatype='integer' name='[Calculation_913949267454275587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_summary_loaded])&#13;&#10;-SUM([chk_summary_loaded_pm_loaded])' />
            </column>
            <column caption='Drop PM Before Checkout' datatype='integer' name='[Calculation_913949267467902980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_913949267448778753]-&#13;&#10;SUM([pm_loaded_chk_summary_loaded])' />
            </column>
