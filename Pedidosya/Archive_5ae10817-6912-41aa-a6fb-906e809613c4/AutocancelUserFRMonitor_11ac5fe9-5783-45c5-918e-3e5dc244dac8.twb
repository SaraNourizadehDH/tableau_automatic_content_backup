  <column aggregation='User' caption='\#Rejected (copia)' datatype='integer' default-type='quantitative' name='[\#Rejected (copia)_2507379121501573128]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,[orders],0))' />
  </column>
  <column aggregation='User' caption='UserFR' datatype='real' default-format='p0.00\%' default-type='quantitative' name='[\% Fail Rate (copia 2)_2507379121194766340]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM(IIF([fail_rate_owner]=&apos;User&apos;,[orders],0)) / SUM([orders])' />
  </column>
  <column aggregation='User' caption='\% True FR' datatype='real' default-format='p0.00\%' default-type='quantitative' name='[\% Fail Rate (copia) (copia)_2507379121405669382]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM(IIF([true_fr] = 1 and [order_status]!=&apos;CONFIRMED&apos;,orders,0))  / SUM({EXCLUDE [fail_rate_owner], [order_status] : SUM([orders]) })' />
  </column>
  <column aggregation='User' caption='\% Fail Rate (owner)' datatype='real' default-format='p0.00\%' default-type='quantitative' name='[\% Fail Rate (copia) (copia)_2507379121500377095]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
