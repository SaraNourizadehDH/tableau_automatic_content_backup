  </column>
  <column aggregation='User' caption='\% Fail Rate (copia)' datatype='real' default-format='p0.00\%' default-type='quantitative' name='[\% Fail Rate (copia)_2507379119405113345]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,orders,0)) / SUM({EXCLUDE [fail_rate_owner], [order_status] : SUM(orders)})' />
