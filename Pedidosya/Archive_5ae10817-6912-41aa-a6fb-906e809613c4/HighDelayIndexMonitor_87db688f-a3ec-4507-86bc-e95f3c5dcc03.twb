&#13;
FROM  `peya-bi-tools-pro.il_logistics.fact_high_delay_zone_index` hd&#13;
&#13;
WHERE TRUE&#13;
--AND DATE(date_local)BETWEEN &apos;2024-06-15&apos; AND &apos;2024-06-16&apos;&#13;
AND EXTRACT(HOUR FROM start_time_bucket_local)&gt;&gt;=10&#13;
