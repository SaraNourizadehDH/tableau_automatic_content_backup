        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rg6l4n1bl8esh1eabicf095wbhx' name='Consulta SQL personalizada' type='text'>WITH &#13;
&#13;
all_sessions AS (&#13;
SELECT &#13;
    hd.country_code&#13;
   ,hd.zone_id&#13;
    ,date_local&#13;
&#13;
    ,SUM(total_sessions_started)  AS total_sessions&#13;
&#13;
FROM  `peya-bi-tools-pro.il_logistics.fact_high_delay_zone_index` hd&#13;
&#13;
WHERE TRUE&#13;
--AND DATE(date_local)BETWEEN &apos;2024-06-15&apos; AND &apos;2024-06-16&apos;&#13;
AND EXTRACT(HOUR FROM start_time_bucket_local)&gt;&gt;=10&#13;
&#13;
GROUP BY 1,2,3&#13;
)&#13;
&#13;
,delay_moments AS (&#13;
SELECT &#13;
    hd.country_code&#13;
   ,hd.zone_id&#13;
    ,date_local&#13;
    ,delay_moment&#13;
    ,delay_moment_name&#13;
&#13;
    ,SUM(total_sessions_started) AS sessions_count&#13;
    &#13;
&#13;
FROM  `peya-bi-tools-pro.il_logistics.fact_high_delay_zone_index` hd&#13;
&#13;
WHERE TRUE&#13;
--AND DATE(date_local)BETWEEN &apos;2024-06-15&apos; AND &apos;2024-06-16&apos;&#13;
AND EXTRACT(HOUR FROM start_time_bucket_local)&gt;&gt;=10&#13;
&#13;
GROUP BY 1,2,3,4,5&#13;
)&#13;
&#13;
,proportions AS (&#13;
SELECT&#13;
    a.country_code&#13;
    ,a.zone_id&#13;
    ,a.date_local&#13;
    ,delay_moment&#13;
    ,delay_moment_name&#13;
&#13;
    ,a.total_sessions&#13;
&#13;
    ,ROUND(SAFE_DIVIDE(sessions_count,a.total_sessions),4) prop_sessions&#13;
&#13;
FROM all_sessions a&#13;
&#13;
LEFT JOIN delay_moments d&#13;
ON a.country_code=d.country_code&#13;
AND a.zone_id=d.zone_id&#13;
AND a.date_local=d.date_local&#13;
&#13;
WHERE TRUE&#13;
--AND a.country_code IN (&apos;ar&apos;)&#13;
--AND a.zone_id=13&#13;
)&#13;
&#13;
&#13;
SELECT&#13;
      p.*&#13;
&#13;
      ,cz.city_id&#13;
      ,cz.city_name&#13;
      ,cz.zone_name&#13;
&#13;
FROM proportions p&#13;
LEFT JOIN `peya-delivery-and-support.da_delivery.country_city_zone_mapping` cz&#13;
ON lower(p.country_code)=lower(cz.country_code)&#13;
AND p.zone_id=cz.zone_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1rg6l4n1bl8esh1eabicf095wbhx' name='Consulta SQL personalizada' type='text'>WITH &#13;
