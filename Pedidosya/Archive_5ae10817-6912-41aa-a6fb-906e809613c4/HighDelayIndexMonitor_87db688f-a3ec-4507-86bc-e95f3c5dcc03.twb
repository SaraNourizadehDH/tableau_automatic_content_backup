          <named-connection caption='BigQuery' name='bigquery.0z5ljdr0nlpqd41erthxu1x2r1zx'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='da_delivery' server-oauth='' username='ignacio.sardi@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0z5ljdr0nlpqd41erthxu1x2r1zx' name='Consulta SQL personalizada' type='text'>WITH&#13;
&#13;
get_performance_metrics AS (&#13;
SELECT &#13;
      p.country_code&#13;
      ,p.zone_name&#13;
      ,cz.zone_id&#13;
&#13;
      ,p.created_date&#13;
&#13;
      --- START TIME BUCKET (15 min) ---&#13;
      , TIMESTAMP_TRUNC(DATETIME(TIMESTAMP(p.created_at_utc), timezone), HOUR) &#13;
      + INTERVAL DIV(EXTRACT(MINUTE FROM DATETIME(TIMESTAMP(p.created_at_utc), timezone)), 15) * 15 MINUTE &#13;
        AS start_time_bucket_local&#13;
&#13;
      --- END TIME BUCKET (15 min) ---&#13;
      , TIMESTAMP_TRUNC(DATETIME(TIMESTAMP(p.created_at_utc), timezone), HOUR) &#13;
      + INTERVAL (DIV(EXTRACT(MINUTE FROM DATETIME(TIMESTAMP(p.created_at_utc), timezone)), 15) + 1) * 15 MINUTE &#13;
        AS end_time_bucket_local&#13;
&#13;
      ,platform_order_code   AS order_id&#13;
&#13;
      --- EXPERIENCE METRICS ---&#13;
      ,non_seamless_order&#13;
      ,non_confirmed&#13;
&#13;
      --- PERFORMANCE METRICS ---&#13;
      ,is_stacked&#13;
      ,order_staffing_affection_over_10&#13;
      ,order_abe&#13;
      ,actual_delivery_time&#13;
      ,PDT_completed          AS promised_delivery_time&#13;
      ,mean_delay&#13;
      ,staffing_affection_minutes&#13;
&#13;
FROM `peya-datamarts-pro.dm_fulfillment.performance_order_level` p&#13;
LEFT JOIN `peya-delivery-and-support.da_delivery.country_city_zone_mapping` cz&#13;
ON lower(p.country_code)=lower(cz.country_code)&#13;
AND lower(p.zone_name)=lower(cz.zone_name)&#13;
)&#13;
&#13;
,performance_metrics AS (&#13;
SELECT &#13;
      country_code&#13;
      ,zone_name&#13;
      ,zone_id&#13;
&#13;
      ,created_date&#13;
      ,start_time_bucket_local&#13;
      ,end_time_bucket_local&#13;
&#13;
      --- EXPERIENCE METRICS ---&#13;
      ,COUNT(DISTINCT order_id)                                                AS total_orders&#13;
      ,COUNT(DISTINCT CASE WHEN non_seamless_order=true THEN order_id END)     AS non_seamless_orders&#13;
      ,COUNT(DISTINCT CASE WHEN non_confirmed=1 THEN order_id END)             AS non_confirmed_orders&#13;
&#13;
      --- PERFORMANCE METRICS ---&#13;
      ,COUNT(DISTINCT CASE WHEN is_stacked=true THEN order_id END)                                AS stacked_orders&#13;
      ,COUNT(DISTINCT CASE WHEN order_staffing_affection_over_10=1 THEN order_id END)             AS staffing_affection_10_orders&#13;
      ,COUNT(DISTINCT CASE WHEN order_abe=1 THEN order_id END)                                    AS abe_orders&#13;
&#13;
      ,AVG(actual_delivery_time)        AS avg_delivery_time&#13;
      ,AVG(promised_delivery_time)      AS avg_promised_delivery_time&#13;
      ,AVG(mean_delay)                  AS avg_mean_delay&#13;
      ,ROUND(AVG(staffing_affection_minutes),0)  AS avg_staffing_affection_mins&#13;
&#13;
&#13;
FROM get_performance_metrics p&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
&#13;
&#13;
SELECT &#13;
    --- INDEX DATA ---&#13;
      hd.* &#13;
     ,DATE(hd.start_time_bucket_local)                      AS local_date&#13;
     ,FORMAT_TIMESTAMP(&apos;%T&apos;, hd.start_time_bucket_local)    AS start_time_bucket_localtime&#13;
&#13;
    --- COUNTRIES DATA ---&#13;
     ,cz.city_id&#13;
     ,cz.city_name&#13;
     ,cz.zone_id      AS zone_id_1&#13;
     ,cz.zone_name&#13;
    &#13;
    --- PERFORMANCE DATA ---&#13;
    ,pm.total_orders&#13;
    ,pm.non_seamless_orders&#13;
    ,pm.non_confirmed_orders&#13;
&#13;
    ,pm.stacked_orders&#13;
    ,pm.staffing_affection_10_orders&#13;
    ,pm.abe_orders&#13;
&#13;
    ,pm.avg_delivery_time&#13;
    ,pm.avg_promised_delivery_time&#13;
    ,pm.avg_mean_delay&#13;
    ,pm.avg_staffing_affection_mins&#13;
&#13;
&#13;
FROM `peya-bi-tools-pro.il_logistics.fact_high_delay_zone_index` hd&#13;
&#13;
LEFT JOIN `peya-delivery-and-support.da_delivery.country_city_zone_mapping` cz&#13;
ON lower(hd.country_code)=lower(cz.country_code)&#13;
AND hd.zone_id=cz.zone_id&#13;
&#13;
LEFT JOIN performance_metrics pm&#13;
ON lower(hd.country_code)=lower(pm.country_code)&#13;
AND hd.zone_id=pm.zone_id&#13;
AND DATE(hd.start_time_bucket_local)=DATE(pm.start_time_bucket_local)&#13;
AND CAST(hd.start_time_bucket_local AS DATETIME)=pm.start_time_bucket_local&#13;
&#13;
WHERE TRUE&#13;
--AND DATE(hd.start_time_bucket_local)=&apos;2024-06-17&apos;&#13;
--AND lower(hd.country_code)=&apos;ar&apos;&#13;
--AND hd.zone_id=13&#13;
--AND EXTRACT(HOUR FROM hd.start_time_bucket_local)=18</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0z5ljdr0nlpqd41erthxu1x2r1zx' name='Consulta SQL personalizada' type='text'>WITH&#13;
