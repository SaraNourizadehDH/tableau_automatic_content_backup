      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_2961CFF9CC914E828142691310C18E64'>
            <properties context=''>
              <relation connection='bigquery.1rkbzue1na33f11g7gdjd0odsxrb' name='Consulta SQL personalizada' type='text'>SELECT &#13;
    --- INDEX DATA ---&#13;
      hd.* &#13;
     ,DATE(hd.start_time_bucket_local)                      AS local_date&#13;
     ,FORMAT_TIMESTAMP(&apos;%T&apos;, hd.start_time_bucket_local)    AS start_time_bucket_localtime&#13;
&#13;
    --- COUNTRIES DATA ---&#13;
     ,cz.city_id&#13;
     ,cz.city_name&#13;
     ,cz.zone_id      AS zone_id_1&#13;
     ,cz.zone_name&#13;
    &#13;
&#13;
FROM `peya-bi-tools-pro.il_logistics.fact_high_delay_zone_index` hd&#13;
&#13;
LEFT JOIN `peya-delivery-and-support.da_delivery.country_city_zone_mapping` cz&#13;
ON lower(hd.country_code)=lower(cz.country_code)&#13;
AND hd.zone_id=cz.zone_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
