          <datasource-dependencies datasource='federated.05vk42q0uv3mfv18oajju03mozes'>
            <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[% Non Seamless Orders (copia)_957577901400313857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Staffing Affection &gt;10' datatype='real' default-format='p0.0%' name='[% Stacked Orders (copia)_957577901400911875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([staffing_affection_10_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Non Seamless Orders' datatype='real' default-format='p0.0%' name='[Calculation_957577901400064000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_seamless_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Stacked Orders' datatype='real' default-format='p0.0%' name='[Calculation_957577901400547330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([total_orders])' />
            </column>
            <column caption='Mean Delay' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_957577901409439749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avg_mean_delay])' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_957577901409624070]' role='measure' type='quantitative'>
