      <table>
        <view>
          <datasources>
            <datasource caption='Apertura diaria' name='federated.1yiznri1j7otqe1e084xr1idm9ft' />
            <datasource caption='Sheet2 (Peya _ OKRs 2022 H1)' name='federated.0mgoa1p1vu22vk13xu4el0ghsm1n' />
          </datasources>
          <datasource-dependencies datasource='federated.0mgoa1p1vu22vk13xu4el0ghsm1n'>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yiznri1j7otqe1e084xr1idm9ft'>
            <column caption='[       KR2 - Courier acceptance rate]/100' datatype='real' name='[Calculation_1062286626766209047]' role='measure' type='quantitative' user:unnamed='Perf 05'>
              <calculation class='tableau' formula='[Calculation_877639040992550914]/100' />
            </column>
            <column caption='[KR3 - % of orders below 7% of DF/AFV (Affordable Orders)]/100' datatype='real' name='[Calculation_1062286626766671898]' role='measure' type='quantitative' user:unnamed='Perf 05'>
              <calculation class='tableau' formula='[Calculation_877639041178648582]/100' />
            </column>
            <column caption='[KR4 - Partner NPS logistics]/100' datatype='real' name='[Calculation_1062286626766737436]' role='measure' type='quantitative' user:unnamed='Perf 05'>
              <calculation class='tableau' formula='[Calculation_877639041088274435]/100' />
            </column>
            <column caption='Aux - Baseline Date' datatype='date' name='[Calculation_1332361802655739930]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(&quot;2021-11-30&quot;)' />
            </column>
            <column caption='Aux - IsBaseline' datatype='string' name='[Calculation_1332361802660139039]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (DATEPART(&apos;year&apos;, [fecha])*100 + DATEPART(&apos;month&apos;, fecha)) = (DATEPART(&apos;year&apos;, [Calculation_1332361802655739930])*100 + DATEPART(&apos;month&apos;, [Calculation_1332361802655739930])) then &apos;Baseline&apos; else &apos;&apos; end' />
            </column>
            <column caption='current month' datatype='boolean' name='[Calculation_196469598452686849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH(TODAY()) = MONTH([fecha])' />
            </column>
            <column caption='       KR2 - Courier acceptance rate' datatype='real' default-format='p0.00%' name='[Calculation_877639040992550914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([KR05_02_NUM]) / sum([KR05_02_DEN])' />
            </column>
            <column caption='KR4 - Partner NPS logistics' datatype='real' name='[Calculation_877639041088274435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((sum([KR05_04_promoters])-sum([KR05_04_detractors]))/sum([KR05_04_responses]))*100' />
            </column>
            <column caption='KR3 - % of orders below 7% of DF/AFV (Affordable Orders)' datatype='real' default-format='p0%' name='[Calculation_877639041178648582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(KR05_03_NUM) / sum([KR05_03_DEN])' />
            </column>
            <column caption='KR1 - Lost Orders PeYa Proxy due to delay' datatype='integer' datatype-customized='true' name='[Calculation_877639041180172295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Previous month' datatype='string' name='[Calculation_92605300657332225]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if MONTH([fecha]) = 11 OR &#13;&#10;(&#13;&#10;    YEAR([fecha])=2022 and month([fecha])=month(today())-1&#13;&#10;)&#13;&#10;then &apos;yes&apos; else &apos;no&apos; end' />
            </column>
            <column caption='performance title' datatype='string' name='[Calculation_92605300659462146]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[fecha])+&quot; progress&quot;' />
            </column>
