              <calculation class='tableau' formula='([Calculation_877639041176727556]&#13;&#10;-[BaseLine 2KR4 - Contact Center Acceptance Rate (copy)_1062286626749046796])&#13;&#10;/&#13;&#10;(SUM([Calculation_462744929703235590])&#13;&#10;-[BaseLine 2KR4 - Contact Center Acceptance Rate (copy)_1062286626749046796])'>
