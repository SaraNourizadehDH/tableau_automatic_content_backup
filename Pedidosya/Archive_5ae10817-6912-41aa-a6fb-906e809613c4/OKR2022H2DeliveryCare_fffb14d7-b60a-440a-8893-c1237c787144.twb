              <calculation class='tableau' formula='Running_Sum(IF ATTR(YEAR([fecha])) = 2021 AND ATTR(MONTH([fecha])) = 11 THEN SUM([federated.0mgoa1p1vu22vk13xu4el0ghsm1n].[O3_KR1]) end)'>
