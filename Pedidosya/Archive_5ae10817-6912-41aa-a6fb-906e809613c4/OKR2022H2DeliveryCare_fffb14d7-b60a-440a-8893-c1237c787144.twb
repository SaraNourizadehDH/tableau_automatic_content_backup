    <worksheet name='detail grid 03'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>Seamless experience to our riders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Apertura diaria' name='federated.1yiznri1j7otqe1e084xr1idm9ft' />
            <datasource caption='Sheet2 (Peya _ OKRs 2022 H1)' name='federated.0mgoa1p1vu22vk13xu4el0ghsm1n' />
          </datasources>
          <datasource-dependencies datasource='federated.0mgoa1p1vu22vk13xu4el0ghsm1n'>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column aggregation='CountD' caption='        KR3 - Increase retention / Reduce churn' datatype='real' name='[O3_KR3]' role='measure' type='quantitative' />
            <column-instance column='[O3_KR3]' derivation='Min' name='[min:O3_KR3:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yiznri1j7otqe1e084xr1idm9ft'>
            <column caption='KR3 - Reduce Rider CR - Off shift (#Contacts/riders activos)' datatype='real' default-format='p0.00%' name='[Calculation_1062286626726264836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([KR03_03_N_NUM])/sum([KR03_03_N_DEN])' />
            </column>
            <column caption='current month' datatype='boolean' name='[Calculation_196469598452686849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH(TODAY()) = MONTH([fecha])' />
            </column>
            <column caption='        KR1 - Increase Rider NPS Existing (Non Payment Related) (sin  compliance+)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_544654146584481798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((sum([PROMOTERS])-sum([DETRACTORS]))/(sum([PROMOTERS])+sum([DETRACTORS])+sum([PASSIVES])))*100' />
            </column>
            <column caption='KR4 - Rider Contacts with SLA &lt; 90 Sec' datatype='real' default-format='p0.00%' name='[Calculation_877639040921526273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(KR03_04_N_NUM) / sum(KR03_04_N_DEN)' />
            </column>
