              <calculation class='tableau' formula='(ZN([Calculation_1032450220900950019]) * ZN(&#13;&#10;&#9;(SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs]))&#13;&#10;&#9;/ &#13;&#10;&#9;(SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs]) +[Calculation_1032450220904067078])&#13;&#10;)&#13;&#10;+&#13;&#10;ZN([Calculation_1032450220899418112]) * ZN(&#13;&#10;&#9;[Calculation_1032450220904067078]&#13;&#10;        /&#13;&#10;&#9;(SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs]) + [Calculation_1032450220904067078])&#13;&#10;)&#13;&#10;) * 100' />
