      <aliases enabled='yes' />
      <column caption='Reach 80% seamless orders' datatype='real' name='[Calculation_1137721869687427078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders_1_payment_no_contact_not_delayed])/sum([total_orders_logistic_seamless])' />
      </column>
      <column caption='Increase customer NPS' datatype='real' name='[Calculation_1137721869687787527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nps_ao_promoter])-SUM([nps_ao_detractor]))&#13;&#10;/&#13;&#10;(SUM([nps_ao_promoter])+SUM([nps_ao_pasive])+SUM([nps_ao_detractor]))' />
      </column>
      <column caption='Increase non seamless customer retention rate' datatype='real' name='[Calculation_1137721869714333704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([n_retained_new]+[n_retained_onboard])&#13;&#10;/SUM([n_users_new]+[n_users_onboard])' />
      </column>
      <column caption='Increase rider NPS' datatype='real' name='[Calculation_1137721869715300361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nps_riders_new_promoter])+SUM([nps_riders_existing_promoter])&#13;&#10;-SUM([nps_riders_new_detractor])-SUM([nps_riders_existing_detractor]))&#13;&#10;/&#13;&#10;(SUM([nps_riders_new_promoter])+SUM([nps_riders_existing_promoter])&#13;&#10;+SUM([nps_riders_new_detractor])+SUM([nps_riders_existing_detractor])&#13;&#10;+SUM([nps_riders_new_pasive])+SUM([nps_riders_existing_pasive]))&#13;&#10;*100' />
      </column>
      <column caption='Decrease share of deliveries delayed more than 10 min &amp; non delivered' datatype='real' name='[Calculation_1137721870046580746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([cancelled_orders])+sum([late_10_orders]))/sum([orders_total])' />
      </column>
      <column caption='Current month' datatype='boolean' name='[Calculation_1982709801100697600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH(TODAY())=MONTH([fecha])' />
      </column>
      <column caption='Previous month - bool' datatype='boolean' name='[Calculation_1982709801107468293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH([fecha])=&#13;&#10;(&#13;&#10;IF [Calculation_960251898556313600]=1 THEN &#13;&#10;12 &#13;&#10;ELSE &#13;&#10;[Calculation_960251898556313600]-1 &#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Last Updated Month' datatype='integer' name='[Calculation_960251898556313600]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{Fixed : Month(Max(fecha))}' />
      </column>
