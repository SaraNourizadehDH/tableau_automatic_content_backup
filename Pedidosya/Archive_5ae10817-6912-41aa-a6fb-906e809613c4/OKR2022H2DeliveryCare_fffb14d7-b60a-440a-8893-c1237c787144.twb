              <calculation class='tableau' formula='([Calculation_877639040921526273]&#13;&#10;-[BaseLine 4KR6 - Avg. DT &gt; 45 (min) (copy)_1768507280397869093])&#13;&#10;/&#13;&#10;([Calculation_689332218964705286]&#13;&#10;-[BaseLine 4KR6 - Avg. DT &gt; 45 (min) (copy)_1768507280397869093])'>
