      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>OKRs Delivery &amp; Care 2022 H1</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Apertura diaria' name='federated.1yiznri1j7otqe1e084xr1idm9ft' />
            <datasource caption='Sheet2 (Peya _ OKRs 2022 H1)' name='federated.0mgoa1p1vu22vk13xu4el0ghsm1n' />
          </datasources>
          <datasource-dependencies datasource='federated.0mgoa1p1vu22vk13xu4el0ghsm1n'>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yiznri1j7otqe1e084xr1idm9ft'>
            <column caption='        KR1 - Increase Quick Re-order after cancellation' datatype='real' name='[        KR1 - Retention after non seamless delivery - Healthy (copy)_877639040710254592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([KR02_01_N_NUM])/sum([KR02_01_N_DEN])' />
            </column>
            <column caption='        KR3 - User Contacts with SLA &lt; 90 Sec' datatype='real' default-format='p0.00%' name='[        KR3 - Avg. Customer &amp; Delivery FR (copy)_960392683165097984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(L02_03_N_total_chats_attended_less_90_seconds)/sum(L02_03_N_total_chats_attended) + sum(L02_03_N_total_chats_missed_more_90_seconds)' />
            </column>
            <column caption='CSAT SSF' datatype='real' name='[Calculation_1032450220899418112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([L02_03_sat_ssf_cs])&#13;&#10;/&#13;&#10;SUM([L02_03_response_ssf_cs])' />
            </column>
            <column caption='CSAT Casos' datatype='real' name='[Calculation_1032450220900409345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([L02_03_sat_casos_cs])&#13;&#10;/&#13;&#10;sum([L02_03_response_casos_cs])' />
            </column>
            <column caption='CSAT Chats' datatype='real' name='[Calculation_1032450220900745218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([L02_03_sat_chat_cs])&#13;&#10;/&#13;&#10;SUM([L02_03_response_chats_cs])' />
            </column>
            <column caption='CSAT Agente' datatype='real' name='[Calculation_1032450220900950019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// 20210122 - Solamente HC tiene CSAT Agente&#13;&#10;ZN([Calculation_1032450220900409345]) * (SUM([L02_03_total_cases_cs]) / (SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs])))&#13;&#10;+&#13;&#10;ZN([Calculation_1032450220900745218]) * (SUM([L02_03_total_chats_cs]) / (SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs])))' />
            </column>
            <column caption='Total Sessions CS' datatype='integer' name='[Calculation_1032450220903714821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([L02_03_cs_hc_sesions]))' />
            </column>
            <column caption='Deflectados CS' datatype='integer' name='[Calculation_1032450220904067078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1032450220903714821]-SUM([L02_03_total_chats_cs])-SUM([L02_03_total_cases_cs])' />
            </column>
            <column caption='        KR2 - Increase customer satisfaction' datatype='real' default-format='p0.00%' name='[Calculation_1032450220904292359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_1032450220900950019]) * ZN(&#13;&#10;&#9;(SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs]))&#13;&#10;&#9;/ &#13;&#10;&#9;(SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs]) +[Calculation_1032450220904067078])&#13;&#10;)&#13;&#10;+&#13;&#10;ZN([Calculation_1032450220899418112]) * ZN(&#13;&#10;&#9;[Calculation_1032450220904067078]&#13;&#10;        /&#13;&#10;&#9;(SUM([L02_03_total_cases_cs]) + SUM([L02_03_total_chats_cs]) + [Calculation_1032450220904067078])&#13;&#10;)&#13;&#10;) * 100' />
            </column>
            <column caption='current month' datatype='boolean' name='[Calculation_196469598452686849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH(TODAY()) = MONTH([fecha])' />
            </column>
            <column caption='KR4 - Increase non seamless experience compensations coverage' datatype='real' default-format='p0.00%' name='[Calculation_877639041176727556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([KR02_04_N_NUM]) / sum([KR02_04_N_DEN])' />
            </column>
