              <calculation class='tableau' formula='(SUM([federated.0mgoa1p1vu22vk13xu4el0ghsm1n].[O3_KR1])-[BaseLine 1KR7 - Minimize Dmarts creation to near pickup time (copy)_310185427523080198])/(([Calculation_1312799293189480451])-([BaseLine 1KR7 - Minimize Dmarts creation to near pickup time (copy)_310185427523080198]))'>
