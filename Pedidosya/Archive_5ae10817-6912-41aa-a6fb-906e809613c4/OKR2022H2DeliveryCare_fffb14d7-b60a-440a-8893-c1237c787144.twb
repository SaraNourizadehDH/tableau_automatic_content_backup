            <column caption='BaseLine 3KR2 - Reduce Churn (sin fraude o compliance+)' datatype='integer' name='[BaseLine KR1 - Retention After non seamless delivery - Healthy (copy)_1768507280354762787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(IF ATTR(YEAR([fecha])) = 2022 AND ATTR(MONTH([fecha])) = 5 THEN MIN([Calculation_689332218961555457]) end)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KR3 - Reduce Rider CR - Off shift (#Contacts/riders activos)' datatype='real' default-format='p0.00%' name='[Calculation_1062286626726264836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([KR03_03_N_NUM])/sum([KR03_03_N_DEN])' />
            </column>
            <column caption='Target KR03_01 - Increase Rider NPS Existing (Non Payment Related) (sin  compliance+)' datatype='real' default-format='p0.00%' name='[Calculation_1312799293189480451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='24.7' />
            </column>
            <column caption='Aux - Baseline Date' datatype='date' name='[Calculation_1332361802655739930]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(&quot;2021-11-30&quot;)' />
            </column>
            <column caption='Aux - IsBaseline' datatype='string' name='[Calculation_1332361802660139039]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (DATEPART(&apos;year&apos;, [fecha])*100 + DATEPART(&apos;month&apos;, fecha)) = (DATEPART(&apos;year&apos;, [Calculation_1332361802655739930])*100 + DATEPART(&apos;month&apos;, [Calculation_1332361802655739930])) then &apos;Baseline&apos; else &apos;&apos; end' />
            </column>
            <column caption='BaseLine 3KR1 - Increase Rider NPS (Existing - Non Payment Related)' datatype='real' name='[Calculation_1332361802993229871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Running_Sum(IF ATTR(YEAR([fecha])) = 2022 AND ATTR(MONTH([fecha])) = 5 THEN [Calculation_544654146584481798] end)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Performance 3KR1 - Increase Rider NPs (Existing - Non payment related)' datatype='real' default-format='*&quot;+&quot;0.00%;&quot;-&quot;0.00%' name='[Calculation_1332361803010682955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_544654146584481798]&#13;&#10;-[Calculation_1332361802993229871])&#13;&#10;/([Calculation_1312799293189480451]&#13;&#10;-[Calculation_1332361802993229871])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Target KR03_02 - Reduce Churn (sin fraude o compliance+)' datatype='real' name='[Calculation_1546986538919153670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.09' />
            </column>
            <column caption='current month' datatype='boolean' name='[Calculation_196469598452686849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH(TODAY()) = MONTH([fecha])' />
            </column>
            <column caption='        KR1 - Increase Rider NPS Existing (Non Payment Related) (sin  compliance+)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_544654146584481798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((sum([PROMOTERS])-sum([DETRACTORS]))/(sum([PROMOTERS])+sum([DETRACTORS])+sum([PASSIVES])))*100' />
            </column>
            <column caption='       KR2 - Reduce Churn (sin fraude o compliance+)' datatype='real' default-format='p0.0%' name='[Calculation_689332218961555457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Q_Churned])/sum([Q_Total_Rider_Churned])' />
