            <column caption='BaseLine 2KR4 - Increase non seamless experience compensations coverage' datatype='real' name='[BaseLine 2KR4 - Contact Center Acceptance Rate (copy)_1062286626749046796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Running_Sum(IF ATTR(YEAR([fecha])) = 2022 AND ATTR(MONTH([fecha])) = 5 THEN [Calculation_877639041176727556] end)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
