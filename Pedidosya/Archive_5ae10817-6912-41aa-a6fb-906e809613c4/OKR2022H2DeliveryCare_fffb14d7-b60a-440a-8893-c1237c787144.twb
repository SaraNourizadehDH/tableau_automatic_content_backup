              <calculation class='tableau' formula='sum(KR03_04_N_NUM) / sum(KR03_04_N_DEN)' />
            </column>
            <column caption='Previous month' datatype='string' name='[Calculation_92605300657332225]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if MONTH([fecha]) = 11 OR &#13;&#10;(&#13;&#10;    YEAR([fecha])=2022 and month([fecha])=month(today())-1&#13;&#10;)&#13;&#10;then &apos;yes&apos; else &apos;no&apos; end' />
