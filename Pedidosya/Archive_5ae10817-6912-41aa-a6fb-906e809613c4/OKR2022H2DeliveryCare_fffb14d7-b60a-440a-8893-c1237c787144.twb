    <datasource caption='KRs company daily' inline='true' name='federated.0jplk6e1n3opr910gsv5h15aj3e2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.11sn9o90b5pfm617seqa71gh0si1'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='automated_tables_reports' server-oauth='' username='ignacio.sardi@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.11sn9o90b5pfm617seqa71gh0si1' name='Custom SQL Query' type='text'><![CDATA[with 
seamless AS (
    SELECT 
        seamless.date as fecha,
        fo.country_id as country_id,
        count(distinct platform_order_code) - sum(non_seamless)as confirmed_orders_1_payment_no_contact_not_delayed,
        count(distinct platform_order_code) as total_orders_logistic_seamless,
    FROM  `peya-delivery-and-support.automated_tables_reports.perfect_orders_data_order_level` seamless
    INNER JOIN `peya-bi-tools-pro.il_core.fact_orders` fo ON fo.order_id = SAFE_CAST(seamless.platform_order_code as int64)
    WHERE 
        seamless.date >>= '2021-11-01'
        AND fo.registered_date >>= '2021-11-01'
    group by 1,2
)
---------------------------------------------------------------------
,
---------------------------------------------------------------------
NPS_AO AS(
    SELECT 
        DATE(q.start_date) AS fecha,
        q.country_id,
        SUM(CASE WHEN q.nps_type = 'NPS AO' AND q.nps_group = 'Promoter' then 1 else 0 end) as nps_ao_promoter,
        SUM(CASE WHEN q.nps_type = 'NPS AO' AND q.nps_group = 'Passive' then 1 else 0 end) as nps_ao_pasive,
        SUM(CASE WHEN q.nps_type = 'NPS AO' AND q.nps_group = 'Detractor' then 1 else 0 end) as nps_ao_detractor,  
        SUM(CASE WHEN q.nps_type IN('NPS New Partners','NPS Existing Partners') AND q.nps_group = 'Promoter' then 1 else 0 end) as nps_partners_promoter,
        SUM(CASE WHEN q.nps_type IN('NPS New Partners','NPS Existing Partners') AND q.nps_group = 'Passive' then 1 else 0 end) as nps_partners_pasive,
        SUM(CASE WHEN q.nps_type IN('NPS New Partners','NPS Existing Partners') AND q.nps_group = 'Detractor' then 1 else 0 end) as nps_partners_detractor,  
    FROM `peya-bi-tools-pro.il_nps.fact_qualtrics` AS q
    WHERE DATE(q.start_date) >>= '2021-11-01'
    GROUP BY 1,2    
)
---------------------------------------------------------------------
,
---------------------------------------------------------------------
nps_riders_new AS(
    SELECT
        nps.response_date as fecha,
        cty.country_id,
        SUM(CASE WHEN nps_group = 'Promoter' THEN 1 END) AS nps_riders_new_promoter,
        SUM(CASE WHEN nps_group = 'Detractor' THEN 1 END) AS  nps_riders_new_detractor,
        SUM(CASE WHEN nps_group = 'Passive' THEN 1 END) AS  nps_riders_new_pasive
    FROM `peya-delivery-and-support.automated_tables_reports.newbies_nps` nps
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cty on cty.country_code = nps.country_code
    WHERE 
        response_date  >>= '2021-11-01'
        and nps_reason_label <<>> 'Payments' 
    GROUP BY 1,2
),
nps_riders_existing AS(    
    SELECT
        nps.response_date as fecha,
        cty.country_id,
        SUM(CASE WHEN nps_group = 'Promoter' THEN 1 END) AS nps_riders_existing_promoter,
        SUM(CASE WHEN nps_group = 'Detractor' THEN 1 END) AS  nps_riders_existing_detractor,
        SUM(CASE WHEN nps_group = 'Passive' THEN 1 END) AS  nps_riders_existing_pasive
    FROM `peya-delivery-and-support.automated_tables_reports.existing_nps` nps
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cty on cty.country_code = nps.country_code
    WHERE 
        response_date  >>= '2021-11-01'
        and nps_reason_label <<>> 'Payments'
    GROUP BY 1,2
)      
---------------------------------------------------------------------
,
---------------------------------------------------------------------
NON_RETENTION_SEAMLESS AS(
    select 
        month_date, 
        country_id, 
        n_retained_new,
        n_retained_onboard,
        n_users_new,
        n_users_onboard
    from `peya-markets.automated_tables_reports.OKRCompany-RetentionSeamless`
    order by month_date desc, country_id    
)
---------------------------------------------------------------------
,
---------------------------------------------------------------------
ORDER_LATE_AND_NON_DELIVERED AS(
    SELECT 
        seamless.date AS fecha,
        fo.country_id,
        COUNT(*) AS orders_total,
        SUM(seamless.fail_order) AS cancelled_orders,
        SUM(late_10) AS late_10_orders
    FROM `peya-delivery-and-support.automated_tables_reports.perfect_orders_data_order_level` seamless
    INNER JOIN `peya-bi-tools-pro.il_core.fact_orders` fo ON fo.order_id = SAFE_CAST(seamless.platform_order_code as int64)
    WHERE
        seamless.date >>= '2021-11-01'
        AND fo.registered_date >>= '2021-11-01'
    GROUP BY 1,2    
)

SELECT DISTINCT
    a.fecha,
    f.country_name,
    a.confirmed_orders_1_payment_no_contact_not_delayed,
    a.total_orders_logistic_seamless,
    b.nps_ao_promoter,
    b.nps_ao_pasive,
    b.nps_ao_detractor,  
    b.nps_partners_promoter,
    b.nps_partners_pasive,
    b.nps_partners_detractor,      
    c.nps_riders_new_promoter,
    c.nps_riders_new_detractor,
    c.nps_riders_new_pasive,
    d.nps_riders_existing_promoter,
    d.nps_riders_existing_detractor,
    d.nps_riders_existing_pasive,
    e.n_retained_new,
    e.n_retained_onboard,
    e.n_users_new,
    e.n_users_onboard,
    g.orders_total,
    g.cancelled_orders,
    g.late_10_orders

FROM seamless a
LEFT JOIN NPS_AO b                                  ON a.fecha = b.fecha        AND a.country_id = b.country_id
LEFT JOIN nps_riders_new c                          ON a.fecha = c.fecha        AND a.country_id = c.country_id
LEFT JOIN nps_riders_existing d                     ON a.fecha = d.fecha        AND a.country_id = d.country_id
LEFT JOIN NON_RETENTION_SEAMLESS e                  ON a.fecha = e.month_date   AND a.country_id = e.country_id
LEFT JOIN ORDER_LATE_AND_NON_DELIVERED g            ON a.fecha = g.fecha        AND a.country_id = g.country_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` f ON a.country_id = f.country_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.11sn9o90b5pfm617seqa71gh0si1' name='Custom SQL Query' type='text'><![CDATA[with 
seamless AS (
    SELECT 
        seamless.date as fecha,
        fo.country_id as country_id,
        count(distinct platform_order_code) - sum(non_seamless)as confirmed_orders_1_payment_no_contact_not_delayed,
        count(distinct platform_order_code) as total_orders_logistic_seamless,
    FROM  `peya-delivery-and-support.automated_tables_reports.perfect_orders_data_order_level` seamless
    INNER JOIN `peya-bi-tools-pro.il_core.fact_orders` fo ON fo.order_id = SAFE_CAST(seamless.platform_order_code as int64)
    WHERE 
        seamless.date >>= '2021-11-01'
        AND fo.registered_date >>= '2021-11-01'
    group by 1,2
)
---------------------------------------------------------------------
,
---------------------------------------------------------------------
NPS_AO AS(
    SELECT 
        DATE(q.start_date) AS fecha,
        q.country_id,
        SUM(CASE WHEN q.nps_type = 'NPS AO' AND q.nps_group = 'Promoter' then 1 else 0 end) as nps_ao_promoter,
        SUM(CASE WHEN q.nps_type = 'NPS AO' AND q.nps_group = 'Passive' then 1 else 0 end) as nps_ao_pasive,
        SUM(CASE WHEN q.nps_type = 'NPS AO' AND q.nps_group = 'Detractor' then 1 else 0 end) as nps_ao_detractor,  
        SUM(CASE WHEN q.nps_type IN('NPS New Partners','NPS Existing Partners') AND q.nps_group = 'Promoter' then 1 else 0 end) as nps_partners_promoter,
        SUM(CASE WHEN q.nps_type IN('NPS New Partners','NPS Existing Partners') AND q.nps_group = 'Passive' then 1 else 0 end) as nps_partners_pasive,
        SUM(CASE WHEN q.nps_type IN('NPS New Partners','NPS Existing Partners') AND q.nps_group = 'Detractor' then 1 else 0 end) as nps_partners_detractor,  
    FROM `peya-bi-tools-pro.il_nps.fact_qualtrics` AS q
    WHERE DATE(q.start_date) >>= '2021-11-01'
    GROUP BY 1,2    
)
---------------------------------------------------------------------
,
---------------------------------------------------------------------
nps_riders_new AS(
    SELECT
        nps.response_date as fecha,
        cty.country_id,
        SUM(CASE WHEN nps_group = 'Promoter' THEN 1 END) AS nps_riders_new_promoter,
        SUM(CASE WHEN nps_group = 'Detractor' THEN 1 END) AS  nps_riders_new_detractor,
        SUM(CASE WHEN nps_group = 'Passive' THEN 1 END) AS  nps_riders_new_pasive
    FROM `peya-delivery-and-support.automated_tables_reports.newbies_nps` nps
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cty on cty.country_code = nps.country_code
    WHERE 
        response_date  >>= '2021-11-01'
        and nps_reason_label <<>> 'Payments' 
    GROUP BY 1,2
),
nps_riders_existing AS(    
    SELECT
        nps.response_date as fecha,
        cty.country_id,
        SUM(CASE WHEN nps_group = 'Promoter' THEN 1 END) AS nps_riders_existing_promoter,
        SUM(CASE WHEN nps_group = 'Detractor' THEN 1 END) AS  nps_riders_existing_detractor,
        SUM(CASE WHEN nps_group = 'Passive' THEN 1 END) AS  nps_riders_existing_pasive
    FROM `peya-delivery-and-support.automated_tables_reports.existing_nps` nps
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cty on cty.country_code = nps.country_code
    WHERE 
        response_date  >>= '2021-11-01'
        and nps_reason_label <<>> 'Payments'
    GROUP BY 1,2
)      
---------------------------------------------------------------------
,
---------------------------------------------------------------------
NON_RETENTION_SEAMLESS AS(
    select 
        month_date, 
        country_id, 
        n_retained_new,
        n_retained_onboard,
        n_users_new,
        n_users_onboard
    from `peya-markets.automated_tables_reports.OKRCompany-RetentionSeamless`
    order by month_date desc, country_id    
)
---------------------------------------------------------------------
,
---------------------------------------------------------------------
ORDER_LATE_AND_NON_DELIVERED AS(
    SELECT 
        seamless.date AS fecha,
        fo.country_id,
        COUNT(*) AS orders_total,
        SUM(seamless.fail_order) AS cancelled_orders,
        SUM(late_10) AS late_10_orders
    FROM `peya-delivery-and-support.automated_tables_reports.perfect_orders_data_order_level` seamless
    INNER JOIN `peya-bi-tools-pro.il_core.fact_orders` fo ON fo.order_id = SAFE_CAST(seamless.platform_order_code as int64)
    WHERE
        seamless.date >>= '2021-11-01'
        AND fo.registered_date >>= '2021-11-01'
    GROUP BY 1,2    
)

SELECT DISTINCT
    a.fecha,
    f.country_name,
    a.confirmed_orders_1_payment_no_contact_not_delayed,
    a.total_orders_logistic_seamless,
    b.nps_ao_promoter,
    b.nps_ao_pasive,
    b.nps_ao_detractor,  
    b.nps_partners_promoter,
    b.nps_partners_pasive,
    b.nps_partners_detractor,      
    c.nps_riders_new_promoter,
    c.nps_riders_new_detractor,
    c.nps_riders_new_pasive,
    d.nps_riders_existing_promoter,
    d.nps_riders_existing_detractor,
    d.nps_riders_existing_pasive,
    e.n_retained_new,
    e.n_retained_onboard,
    e.n_users_new,
    e.n_users_onboard,
    g.orders_total,
    g.cancelled_orders,
    g.late_10_orders

FROM seamless a
LEFT JOIN NPS_AO b                                  ON a.fecha = b.fecha        AND a.country_id = b.country_id
LEFT JOIN nps_riders_new c                          ON a.fecha = c.fecha        AND a.country_id = c.country_id
LEFT JOIN nps_riders_existing d                     ON a.fecha = d.fecha        AND a.country_id = d.country_id
LEFT JOIN NON_RETENTION_SEAMLESS e                  ON a.fecha = e.month_date   AND a.country_id = e.country_id
LEFT JOIN ORDER_LATE_AND_NON_DELIVERED g            ON a.fecha = g.fecha        AND a.country_id = g.country_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` f ON a.country_id = f.country_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
