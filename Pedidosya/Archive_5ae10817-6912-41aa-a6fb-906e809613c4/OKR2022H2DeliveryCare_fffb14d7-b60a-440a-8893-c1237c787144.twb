              <calculation class='tableau' formula='RUNNING_MIN(IF ATTR(YEAR([fecha])) = 2022 AND ATTR(MONTH([fecha])) = 5 THEN [Calculation_1062286626726264836] end)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='BaseLine 3KR4 - % Rider Contacts with SLA &lt; 90 Sec' datatype='real' name='[BaseLine 4KR6 - Avg. DT &gt; 45 (min) (copy)_1768507280397869093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Running_Sum(IF ATTR(YEAR([fecha])) = 2022 AND ATTR(MONTH([fecha])) = 5 THEN [Calculation_877639040921526273] end)'>
                <table-calc ordering-type='Rows' />
