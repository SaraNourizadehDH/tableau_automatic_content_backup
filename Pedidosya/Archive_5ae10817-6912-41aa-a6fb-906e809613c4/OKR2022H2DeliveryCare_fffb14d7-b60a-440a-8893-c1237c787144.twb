            </column>
            <column caption='Aux - IsBaseline' datatype='string' name='[Calculation_1332361802660139039]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (DATEPART(&apos;year&apos;, [fecha])*100 + DATEPART(&apos;month&apos;, fecha)) = (DATEPART(&apos;year&apos;, [Calculation_1332361802655739930])*100 + DATEPART(&apos;month&apos;, [Calculation_1332361802655739930])) then &apos;Baseline&apos; else &apos;&apos; end' />
