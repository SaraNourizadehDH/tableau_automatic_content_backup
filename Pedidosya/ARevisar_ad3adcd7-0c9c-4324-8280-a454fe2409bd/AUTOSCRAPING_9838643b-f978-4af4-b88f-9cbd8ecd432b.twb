      <aliases enabled='yes' />
      <column caption='Open Partners' datatype='integer' name='[Avg Open Partners (copy)_498773674857259010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [status] = &quot;OPEN&quot; THEN [qty_partners] END)' />
      </column>
      <column caption='Delivery Fee max' datatype='real' name='[Calculation_1147292022207307777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; and [status]=&quot;OPEN&quot; THEN  [sum_delivery_fee_euro]/[count_rows]&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;USD&quot; and [status]=&quot;OPEN&quot; THEN [sum_delivery_fee_usd]/[count_rows]&#13;&#10;ELSEif [status]=&quot;OPEN&quot; THEN [sum_delivery_fee]/[count_rows] END' />
      </column>
      <column caption='avg_delivery_fee' datatype='real' name='[Calculation_1179661647671369728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Delivery Fee max (copy)_1179661647674732545])/sum(if [status]=&apos;OPEN&apos;then [count_rows] end )' />
      </column>
      <column caption='Max_qty_occasion' datatype='integer' name='[Calculation_1292814586509877248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [date],[address],[occasion],[reason] : max([qty_partners])}' />
      </column>
      <column caption='COUNT_ADDRESS' datatype='integer' name='[Calculation_470344704365072384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([address])' />
      </column>
      <column caption='SUM MAX OPEN PARTNERS' datatype='integer' name='[Calculation_470344704408670216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [address],[date]:sum({EXCLUDE [status],[reason]:max(IF [status]=&quot;OPEN&quot; THEN [qty_partners]end)})}' />
      </column>
      <column caption='Open Partners (%)' datatype='real' default-format='p0%' name='[Calculation_498773674851880960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;OPEN&quot; THEN [qty_partners] END) / SUM([qty_partners])' />
      </column>
      <column caption='Day Of Week' datatype='string' name='[Calculation_498773674852397057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[date])' />
      </column>
      <column caption='Delivery Fee' datatype='real' name='[Delivery Fee max (copy)_1179661647674732545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; and [status]=&quot;OPEN&quot; THEN  [sum_delivery_fee_euro]&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;USD&quot; and [status]=&quot;OPEN&quot; THEN [sum_delivery_fee_usd]&#13;&#10;ELSEif [status]=&quot;OPEN&quot; THEN [sum_delivery_fee] END' />
      </column>
      <column caption='AVG Open Partners' datatype='real' name='[Open Partners (copy) (copy) (copy)_470344704380149763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [status] = &quot;OPEN&quot; THEN [qty_partners] END)' />
      </column>
      <column caption='Closed Partners' datatype='integer' name='[Open Partners (copy)_1147292022236266498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;CLOSED&quot; THEN [qty_partners] END' />
      </column>
      <column caption='MAX Open Partners' datatype='integer' name='[Open Partners (copy)_470344704379727873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [status] = &quot;OPEN&quot; THEN [qty_partners] END)' />
      </column>
      <column caption='Open Partner' datatype='integer' default-format='N' name='[Open Partners (copy)_470344704450662413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;OPEN&quot; THEN [qty_partners] END' />
      </column>
