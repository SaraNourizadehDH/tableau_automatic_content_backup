LEFT JOIN tmp AS att&#13;
ON wallet_top.campaignCode = att.campaignCode&#13;
  AND wallet_top.userId = att.userId&#13;
WHERE wallet_top.country = &quot;BO&quot;&#13;
  AND UPPER(wallet_top.campaignCode) LIKE &apos;%BISA%&apos;&#13;
GROUP BY 1,2,3,4</relation>
