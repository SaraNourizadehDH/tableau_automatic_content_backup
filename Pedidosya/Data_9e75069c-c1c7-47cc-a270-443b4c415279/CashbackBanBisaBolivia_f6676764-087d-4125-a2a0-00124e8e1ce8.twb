      </semantic-values>
      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_6ACEF6042FF4453686E95DFDDC02A4E1'>
            <properties context=''>
              <relation connection='bigquery.14cl00q1mvaoju142vxw01ex6n4o' name='first_order_BQ' type='text'>--FIRST ORDER&#13;
&#13;
WITH&#13;
datos AS (&#13;
  SELECT&#13;
    city.city_name,&#13;
    fecha.day_name,&#13;
    FORMAT_DATE(&quot;%Y %m&quot;, orders.registered_date ) yyyymm,&#13;
    fecha.full_date,&#13;
    pt.issuer,&#13;
    pt.card_bin,&#13;
    pt.card_last_digits,&#13;
    UPPER(pt.card_holder_name) card_holder_name,&#13;
    orders.order_id,&#13;
    orders.user.id user_id,&#13;
    orders.registered_date,&#13;
    pt.payment_authorize_response_code,&#13;
    pt.payment_authorize_date,&#13;
    pt.payment_authorize_response_message,&#13;
    pt.payment_authorize_reference,&#13;
    pt.transaction_id,&#13;
    (orders.total_amount + orders.discount_paid_by_company + orders.shipping_amount) total_amount,&#13;
    orders.commission_amount,&#13;
    ROW_NUMBER() OVER (PARTITION BY fecha.day_name, fecha.full_date, pt.issuer, pt.card_bin, pt.card_last_digits, UPPER(pt.card_holder_name)&#13;
    ORDER BY orders.registered_at ASC ) row_num&#13;
  FROM&#13;
    `peya-bi-tools-pro.il_core.fact_orders` orders&#13;
  INNER JOIN&#13;
    `peya-bi-tools-pro.il_core.dim_date` fecha&#13;
  ON orders.registered_date_id = fecha.date_id&#13;
  LEFT JOIN&#13;
    `peya-bi-tools-pro.il_core.dim_area` area&#13;
  ON area.area_id = orders.restaurant.address.area.id&#13;
  LEFT JOIN&#13;
    `peya-bi-tools-pro.il_core.dim_city` city&#13;
  ON area.city_id = city.city_id&#13;
  INNER JOIN&#13;
    `peya-bi-tools-pro.il_payments.fact_payments_transaction` pt&#13;
  ON pt.order_id = orders.order_id&#13;
  WHERE orders.confirmed_order = 1&#13;
    AND orders.country_id = 17&#13;
    AND ( UPPER(pt.issuer) like &apos;%BISA%&apos; )&#13;
    AND fecha.day_name = &apos;Wednesday&apos;&#13;
    AND fecha.date_id &gt;&gt;= 20200717&#13;
    AND orders.registered_date &gt;&gt;= &apos;2021-01-01&apos;&#13;
    AND pt.card_bin IN (&apos;411044&apos;,&apos;411045&apos;,&apos;411046&apos;,&apos;428341&apos;,&apos;441051&apos;,&apos;478785&apos;,&apos;430906&apos;,&apos;430906&apos;,&apos;111112&apos;)&#13;
  ORDER BY orders.user.id ),&#13;
&#13;
return AS(&#13;
  SELECT&#13;
    datos.*,&#13;
    CASE&#13;
      WHEN datos.total_amount*0.20 &gt;&gt; 50 THEN 50&#13;
    ELSE&#13;
    datos.total_amount*0.20&#13;
  END as return_wallet&#13;
  FROM datos as datos&#13;
  WHERE row_num=1 ),&#13;
datos_2 AS (&#13;
  SELECT&#13;
    return.*,&#13;
    SUM( return_wallet ) OVER (PARTITION BY day_name, yyyymm, issuer, card_bin, card_last_digits, card_holder_name ORDER BY registered_date ASC ) return_wallet_monthly&#13;
  FROM return as return )&#13;
&#13;
SELECT&#13;
  datos_2.*,&#13;
  ABS(CASE&#13;
      WHEN datos_2.return_wallet_monthly &gt;&gt; 100 THEN datos_2.return_wallet_monthly - datos_2.return_wallet -100&#13;
    ELSE&#13;
    datos_2.return_wallet&#13;
  END) as devolver_oficial&#13;
FROM&#13;
  datos_2 as datos_2</relation>
            </properties>
