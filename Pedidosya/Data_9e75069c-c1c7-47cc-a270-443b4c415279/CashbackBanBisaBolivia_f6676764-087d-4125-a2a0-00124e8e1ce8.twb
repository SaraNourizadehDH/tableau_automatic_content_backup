        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gvhql70d8uszn169m3mj0l89mkb' name='Consulta_SQL_personalizada' type='text'>--WALLET SPENT&#13;
&#13;
WITH&#13;
tmp AS(&#13;
  SELECT&#13;
    ATTR.amount,&#13;
    userId,&#13;
    campaignCode,&#13;
    orderId&#13;
  FROM&#13;
    `peya-data-origins-pro.cl_wallet.wallet_attributions` AS wallet_attr&#13;
  CROSS JOIN&#13;
    UNNEST( attributionDetails ) ATTR&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` AS fact_orders&#13;
    ON wallet_attr.orderId = fact_orders.order_id&#13;
  WHERE wallet_attr.country = &quot;BO&quot;&#13;
    AND DATE(fact_orders.registered_date) &gt;&gt;= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -12 MONTH)&#13;
    AND order_status = &apos;CONFIRMED&apos;&#13;
  ORDER BY orderId&#13;
  )&#13;
  &#13;
SELECT&#13;
  DATE(wallet_top.topupDate) yyyymmdd,&#13;
  wallet_top.amount monto_acreditado,&#13;
  wallet_top.campaignCode,&#13;
  wallet_top.userId user_id,&#13;
  SUM(CASE&#13;
      WHEN att.amount IS NULL THEN 0&#13;
    ELSE&#13;
    att.amount&#13;
  END) as monto_gastado,&#13;
  COUNT(att.orderId) ordenes&#13;
FROM&#13;
  `peya-data-origins-pro.cl_wallet.wallet_topups` wallet_top&#13;
LEFT JOIN tmp AS att&#13;
ON wallet_top.campaignCode = att.campaignCode&#13;
  AND wallet_top.userId = att.userId&#13;
WHERE wallet_top.country = &quot;BO&quot;&#13;
  AND UPPER(wallet_top.campaignCode) LIKE &apos;%BISA%&apos;&#13;
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1gvhql70d8uszn169m3mj0l89mkb' name='Consulta_SQL_personalizada' type='text'>--WALLET SPENT&#13;
