              <relation connection='bigquery.1gvhql70d8uszn169m3mj0l89mkb' name='Consulta_SQL_personalizada' type='text'>--WALLET SPENT&#13;
&#13;
WITH&#13;
tmp AS(&#13;
  SELECT&#13;
    ATTR.amount,&#13;
    userId,&#13;
    campaignCode,&#13;
    orderId&#13;
