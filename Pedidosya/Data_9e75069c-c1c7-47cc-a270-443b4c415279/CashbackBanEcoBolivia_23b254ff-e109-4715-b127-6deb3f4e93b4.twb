      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_6ACEF6042FF4453686E95DFDDC02A4E1'>
            <properties context=''>
              <relation connection='bigquery.14cl00q1mvaoju142vxw01ex6n4o' name='first_order_BQ' type='text'>with datos as (&#13;
  select &#13;
    city.city_name,fecha.day_name,FORMAT_DATE(&quot;%Y %m&quot;, o.registered_date ) yyyymm,&#13;
    fecha.full_date,pt.issuer,pt.card_bin,pt.card_last_digits,upper(pt.card_holder_name) card_holder_name,o.order_id,&#13;
    o.user.id user_id,o.registered_date,&#13;
    pt.payment_authorize_response_code,pt.payment_authorize_date,pt.payment_authorize_response_message,pt.payment_authorize_reference,pt.transaction_id,&#13;
    (o.total_amount+ o.discount_paid_by_company+o.shipping_amount) total_amount,&#13;
    o.commission_amount,&#13;
     ROW_NUMBER() OVER (&#13;
          PARTITION BY fecha.day_name,fecha.full_date,pt.issuer,pt.card_bin,pt.card_last_digits,upper(pt.card_holder_name) &#13;
          ORDER BY o.registered_at asc&#13;
       ) row_num&#13;
    from `peya-bi-tools-pro.il_core.fact_orders` o &#13;
    inner join `peya-bi-tools-pro.il_core.dim_date` fecha &#13;
    on o.registered_date_id=fecha.date_id&#13;
    left join `peya-bi-tools-pro.il_core.dim_area` are&#13;
    on are.area_id=o.restaurant.address.area.id  &#13;
    left join `peya-bi-tools-pro.il_core.dim_city` city &#13;
    on are.city_id=city.city_id&#13;
    inner join `peya-bi-tools-pro.il_payments.fact_payments_transaction` pt &#13;
    on pt.order_id=o.order_id &#13;
    where o.confirmed_order =1&#13;
    and o.country_id=17&#13;
    and (pt.issuer = &apos;BANCO ECONOMICO S.A.&apos; or pt.issuer =&apos;BANCO ECONOMICO, S.A.&apos;) &#13;
    and fecha.day_name=&apos;Friday&apos;&#13;
    and fecha.date_id &gt;&gt;= 20200717 &#13;
    and o.registered_date &gt;&gt;= &apos;2021-01-01&apos;&#13;
    and pt.card_bin in (&apos;456014&apos;,&apos;456016&apos;,&apos;456015&apos;,&apos;471294&apos;,&apos;434786&apos;)  &#13;
    order by o.user.id &#13;
),&#13;
&#13;
return as(&#13;
    select a.*,&#13;
    case when a.total_amount*0.20 &gt;&gt; 50 then 50 else a.total_amount*0.20  end return_wallet&#13;
    from datos a&#13;
    where row_num=1&#13;
),&#13;
&#13;
datos_2 as (&#13;
    select a.*,&#13;
    sum( return_wallet ) OVER (&#13;
          PARTITION BY day_name,yyyymm,issuer,card_bin,card_last_digits,card_holder_name&#13;
          ORDER BY registered_date asc&#13;
       ) return_wallet_monthly&#13;
    from return a&#13;
)&#13;
&#13;
 &#13;
select a.* ,abs(case when a.return_wallet_monthly &gt;&gt; 100 then a.return_wallet_monthly - a.return_wallet -100  else a.return_wallet end) devolver_oficial&#13;
from datos_2 a</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
