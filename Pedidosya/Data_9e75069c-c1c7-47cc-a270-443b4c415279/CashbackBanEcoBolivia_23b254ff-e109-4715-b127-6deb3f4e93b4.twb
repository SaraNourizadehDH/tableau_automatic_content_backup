        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gvhql70d8uszn169m3mj0l89mkb' name='Consulta_SQL_personalizada' type='text'>with tmp as(&#13;
select ATTR.amount , userId ,campaignCode,orderId  &#13;
from &#13;
 `peya-data-origins-pro.cl_wallet.wallet_attributions` a CROSS JOIN UNNEST( attributionDetails ) ATTR&#13;
where  a.country  = &quot;BO&quot;&#13;
)&#13;
SELECT  date(w.topupDate) yyyymmdd,w.amount monto_acreditado,w.campaignCode , w.userId user_id,sum(case when att.amount is null then 0 else att.amount end) monto_gastado,count(att.orderId) ordenes&#13;
FROM `peya-data-origins-pro.cl_wallet.wallet_topups` w &#13;
left join tmp as att&#13;
on w.campaignCode   =  att.campaignCode  &#13;
and w.userId  = att.userId &#13;
where  w.country = &quot;BO&quot;&#13;
and w.campaignCode like &apos;%%BANECO%%&apos; &#13;
group by  1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1gvhql70d8uszn169m3mj0l89mkb' name='Consulta_SQL_personalizada' type='text'>with tmp as(&#13;
