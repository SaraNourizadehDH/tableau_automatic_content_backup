            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Avg. SF Food' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. DF Food (copy)_349029003989393409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM([service_fee_food])&#13;&#10;/SUM([confirmed_orders_food])&#13;&#10;ELSE&#13;&#10;// LOCAL CURRENCY&#13;&#10;SUM([service_fee_food_lc]) &#13;&#10;/SUM([confirmed_orders_food])&#13;&#10;END' />
            </column>
            <column caption='Avg. SF Non Food' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. DF Non Food (copy)_349029003989962754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM([service_fee_non_food])&#13;&#10;/SUM(confirmed_orders_nv)&#13;&#10;&#13;&#10;ELSE&#13;&#10;// LOCAL CURRENCY&#13;&#10;SUM([service_fee_non_food_lc])&#13;&#10;/SUM(confirmed_orders_nv)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Avg. DF Non Food' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. DF Total (copia) (copia)_204913841871564805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM([delivery_fee_non_food])&#13;&#10;/SUM(confirmed_orders_nv)&#13;&#10;&#13;&#10;ELSE&#13;&#10;// LOCAL CURRENCY&#13;&#10;SUM([delivery_fee_non_food_lc])&#13;&#10;/SUM(confirmed_orders_nv)&#13;&#10;END' />
            </column>
            <column caption='Avg. DF Food' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. DF Total (copia)_204913841871548420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM([delivery_fee_food])&#13;&#10;/SUM([confirmed_orders_food])&#13;&#10;&#13;&#10;ELSE &#13;&#10;// LOCAL CURRENCY&#13;&#10;SUM([delivery_fee_food_lc])&#13;&#10;/SUM([confirmed_orders_food])&#13;&#10;END' />
            </column>
            <column caption='Avg. SF Total' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. DF Total (copy)_349029003988660224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM([service_fee])&#13;&#10;/(SUM([confirmed_orders_food])+SUM(confirmed_orders_nv))&#13;&#10;ELSE&#13;&#10;// LOCAL CURRENCY&#13;&#10;SUM([service_fee_lc])&#13;&#10;/(SUM([confirmed_orders_food])+SUM(confirmed_orders_nv))&#13;&#10;END' />
            </column>
            <column caption='Avg. DF Total' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1306606888439341059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM([delivery_fee]) &#13;&#10;/(SUM([confirmed_orders_food])+SUM(confirmed_orders_nv))&#13;&#10;ELSE&#13;&#10;&#13;&#10;// LOCAL CURRENCY&#13;&#10;SUM([delivery_fee_lc]) &#13;&#10;/(SUM([confirmed_orders_food])+SUM(confirmed_orders_nv))&#13;&#10;END' />
            </column>
            <column caption='GFV Gross Total' datatype='real' name='[Calculation_1651413722935463936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN [confirmed_gfv_gross]&#13;&#10;ELSE [confirmed_gfv_gross_lc]&#13;&#10;END' />
            </column>
            <column caption='Revenue Fee (DF + SF)' datatype='real' name='[Calculation_439100997916749825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN SUM([delivery_fee])  ELSE SUM([delivery_fee_lc]) end&#13;&#10;+ &#13;&#10;IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN SUM([service_fee]) ELSE SUM([service_fee_lc]) END)&#13;&#10;&#13;&#10;&#13;&#10;/(SUM([confirmed_orders_food])+SUM(confirmed_orders_nv))' />
            </column>
            <column caption='Take Rate - Total' datatype='real' name='[Calculation_439100997970366484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tr_num_all]) / SUM([tr_den_all])' />
            </column>
            <column caption='GFV Gross - Non Food' datatype='real' name='[GFV Food (copy)_1651413722935705602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN [confirmed_gfv_gross_non_food]&#13;&#10;ELSE [confirmed_gfv_gross_non_food_lc]&#13;&#10;END' />
