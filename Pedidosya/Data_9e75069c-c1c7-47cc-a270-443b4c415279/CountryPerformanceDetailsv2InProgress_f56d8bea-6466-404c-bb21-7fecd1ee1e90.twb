    <worksheet name='Ensure Clear Leadership'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='total_days_months' datatype='integer' name='[Calculation_100486627871641600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_date] = DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;THEN DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;month&apos;,today()),today())&#13;&#10;ELSE&#13;&#10;DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[month_date]))))&#13;&#10;END' />
            </column>
            <column caption='avg_daily_orders' datatype='real' name='[Calculation_100486627872206849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders]) / MAX([Calculation_100486627871641600])' />
            </column>
            <column caption='Frequency ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1661546823722532864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_customers_orders])/SUM([active_customers])' />
            </column>
            <column caption='Confirmed GMV GROSS' datatype='real' name='[Calculation_1754996532142612480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;[confirmed_gmvgross]&#13;&#10;ELSE&#13;&#10;[confirmed_gmvgross_lc]&#13;&#10;END' />
            </column>
            <column caption='Confirmed Orders Courier' datatype='integer' name='[Calculation_439100997948178437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_courier_b2c] + [confirmed_orders_courier_c2c])' />
            </column>
            <column caption='Retention Overall M1' datatype='real' name='[Calculation_439100997950226438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retention_overall_m1]) / SUM([active_customers_overall_m1])' />
            </column>
            <column caption='Title Ensure Clear Leadership' datatype='string' name='[Title Affordability (copy)_1628895727631835142]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Ensure Clear Leadership&quot;' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Active Customers' datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
            <column caption='Active Customers Orders' datatype='integer' name='[active_customers_orders]' role='measure' type='quantitative' />
            <column caption='Active Customers Overall M1' datatype='integer' name='[active_customers_overall_m1]' role='measure' type='quantitative' />
            <column caption='Confirmed Gmvgross' datatype='real' name='[confirmed_gmvgross]' role='measure' type='quantitative' />
            <column caption='Confirmed Gmvgross Lc' datatype='real' name='[confirmed_gmvgross_lc]' role='measure' type='quantitative' />
