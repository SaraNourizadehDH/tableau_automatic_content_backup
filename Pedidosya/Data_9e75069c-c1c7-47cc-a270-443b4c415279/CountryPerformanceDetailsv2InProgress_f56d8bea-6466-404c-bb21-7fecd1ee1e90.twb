    <worksheet name='Riders_review'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='CPO - Basic Per Km' datatype='real' name='[CPO - Basic Per Delivery (copy)_1126181425978413058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_payments_basic_delivery_per_km])/(SUM([completed_orders]))' />
            </column>
            <column caption='CPO - Basic Evaluation' datatype='real' name='[CPO - Basic Per Delivery (copy)_1126181425978523651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_payments_basic_evaluation])/(SUM([completed_orders]))' />
            </column>
            <column caption='CPO - Others' datatype='real' name='[CPO - Basic Per Km (copy)_1126181425978642436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_payments_scoring_batch])/(SUM([completed_orders]))+&#13;&#10;SUM([total_payments_quest_per_delivery])/(SUM([completed_orders]))' />
            </column>
            <column caption='CPO - Basic Per Delivery' datatype='real' name='[CPO - Total (copy)_1126181425978277889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_payments_basic_delivery_per_del])/(SUM([completed_orders]))' />
            </column>
            <column caption='CPO - Total' datatype='real' name='[Calculation_1126181425977786368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_payments])/(SUM([completed_orders]))' />
            </column>
            <column caption='Fill Rate' datatype='real' name='[Calculation_1289999860243853312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_slots_assigned])/SUM([open_slots_size])' />
            </column>
            <column caption='Working Hours' datatype='real' name='[Calculation_1713619698399698945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_actual_evaluated_working_hours])/60/60' />
            </column>
            <column caption='NPS Existing Riders' datatype='real' name='[Calculation_66428135825469440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([nps_riders_existing_promoter]-[nps_riders_existing_detractor])/([nps_riders_existing_detractor] + [nps_riders_existing_pasive]+ [nps_riders_existing_promoter])' />
            </column>
