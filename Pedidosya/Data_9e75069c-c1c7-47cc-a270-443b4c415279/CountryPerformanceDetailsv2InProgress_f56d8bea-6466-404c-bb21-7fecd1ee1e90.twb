            <column caption='VFR_Dmart' datatype='real' name='[VFR_Food (copia)_130041476661305365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_partner_owner_dmart])/SUM([confirmed_orders_dmart])' />
