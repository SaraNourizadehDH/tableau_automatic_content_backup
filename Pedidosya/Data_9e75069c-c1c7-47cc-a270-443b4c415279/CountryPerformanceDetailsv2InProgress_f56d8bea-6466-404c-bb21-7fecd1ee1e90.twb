          <datasource-dependencies datasource='federated.1mc54dn1lkbhw51diwx8500dihfu'>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_1944992141290676224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_min])/SUM([completed_logistic_orders])' />
            </column>
            <column caption='Seamless Orders Share' datatype='real' name='[Calculation_1944992141291266050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_1_payment_no_contact_not_delayed]) / SUM([total_orders_logistic_seamless])' />
            </column>
            <column caption='NPS AO' datatype='real' name='[Calculation_1944992141291511811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM([nps_ao_promoter]-[nps_ao_detractor]) / SUM([nps_ao_promoter]+[nps_ao_detractor]+[nps_ao_pasive]) ) * 100' />
            </column>
            <column caption='Retention Overall M1 ' datatype='real' name='[Calculation_1944992141292068868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retention_overall_m1])/SUM([active_customers_overall_m1])' />
            </column>
            <column caption='GPO' datatype='real' name='[Calculation_1944992141292285957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_numerador])/SUM([gpo_flgpo_denominador])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_450360018852384768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_total_sessions]) / SUM([sessions_total])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[GPO (copia)_1944992141292417030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_numerador])/SUM([gpo_flgpo_denominador])' />
