    <worksheet name='Customer_segmentation_by_income'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Frequency high income seg' datatype='real' name='[Calculation_130041476685578275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_confirmed_orders_HIGH])/sum([active_customers_HIGH])' />
            </column>
            <column caption='Frequency mid high income seg' datatype='real' name='[Frequency high income seg (copia)_130041476685811748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_confirmed_orders_MID_HIGH])/sum([active_customers_MID_HIGH])' />
            </column>
            <column caption='Frequency mid income seg' datatype='real' name='[Frequency mid high income seg (copia)_130041476685914149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_confirmed_orders_MID])/sum([active_customers_MID])' />
            </column>
            <column caption='Frequency mid low income seg' datatype='real' name='[Frequency mid high income seg (copia)_130041476685979686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_confirmed_orders_MID_LOW])/sum([active_customers_MID_LOW])' />
            </column>
            <column caption='Frequency low income seg' datatype='real' name='[Frequency mid high income seg (copia)_130041476686069799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_confirmed_orders_LOW])/sum([active_customers_LOW])' />
            </column>
            <column caption='Frequency unknown income seg' datatype='real' name='[Frequency mid high income seg (copia)_130041476686250024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_confirmed_orders_UNKNOWN])/sum([active_customers_UNKNOWN])' />
            </column>
            <column caption='Reorder mid-high income seg' datatype='real' name='[Reorder high income seg (copy)_211669221367320577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [segment] = &quot;MID_HIGH&quot; THEN [retention_segment_m1] END ) &#13;&#10;/ &#13;&#10;SUM(IF [segment] = &quot;MID_HIGH&quot; THEN [active_customers_segment_m1] END)' />
            </column>
            <column caption='Reorder mid income seg' datatype='real' name='[Reorder mid-high income seg (copy)_211669221367595010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [segment] = &quot;MID&quot; THEN [retention_segment_m1] END ) &#13;&#10;/ &#13;&#10;SUM(IF [segment] = &quot;MID&quot; THEN [active_customers_segment_m1] END)' />
            </column>
            <column caption='Reorder mid-low income seg' datatype='real' name='[Reorder mid-high income seg (copy)_211669221367734275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [segment] = &quot;MID_LOW&quot; THEN [retention_segment_m1] END ) &#13;&#10;/ &#13;&#10;SUM(IF [segment] = &quot;MID_LOW&quot; THEN [active_customers_segment_m1] END)' />
            </column>
            <column caption='Reorder low income seg' datatype='real' name='[Reorder mid-low income seg (copy)_211669221367881732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [segment] = &quot;LOW&quot; THEN [retention_segment_m1] END ) &#13;&#10;/ &#13;&#10;SUM(IF [segment] = &quot;LOW&quot; THEN [active_customers_segment_m1] END)' />
            </column>
            <column caption='Reorder unkown income seg' datatype='real' name='[Reorder mid-low income seg (copy)_211669221368008709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [segment] = &quot;UNKNOWN&quot; THEN [retention_segment_m1] END ) &#13;&#10;/ &#13;&#10;SUM(IF [segment] = &quot;UNKNOWN&quot; THEN [active_customers_segment_m1] END)' />
            </column>
            <column caption='Reorder high income seg' datatype='real' name='[Retention Overall M1 (copy)_211669221354192896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [segment] = &quot;HIGH&quot; THEN [retention_segment_m1] END ) &#13;&#10;/ &#13;&#10;SUM(IF [segment] = &quot;HIGH&quot; THEN [active_customers_segment_m1] END)' />
            </column>
            <column caption='Title Customer Segmentation by Income' datatype='string' name='[Title Ensure Clear Leadership (copia)_130041476676497440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Customer Segmentation by Income&quot;' />
            </column>
            <column caption='Active Customers' datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
            <column caption='active customers HIGH' datatype='integer' name='[active_customers_HIGH]' role='measure' type='quantitative' />
