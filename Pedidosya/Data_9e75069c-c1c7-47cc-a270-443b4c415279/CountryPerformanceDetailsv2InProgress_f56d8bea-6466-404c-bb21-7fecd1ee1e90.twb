            </column>
            <column caption='Revenue Fee Food (DF + SF)' datatype='real' name='[Revenue Fee (DF + SF) (copy)_439100997917110274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN SUM([delivery_fee_food]) ELSE SUM([delivery_fee_food_lc]) END&#13;&#10;+ &#13;&#10;IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN SUM([service_fee_food]) ELSE SUM([service_fee_food_lc]) END)&#13;&#10;&#13;&#10;/SUM([confirmed_orders_food])' />
            </column>
            <column caption='Revenue Fee Non Food (DF + SF)' datatype='real' name='[Revenue Fee Food (DF + SF) (copy)_439100997917286403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN SUM([delivery_fee_non_food]) ELSE SUM([delivery_fee_non_food_lc]) END&#13;&#10;+ &#13;&#10;IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN SUM([service_fee_non_food]) ELSE SUM([service_fee_non_food_lc]) END)&#13;&#10;&#13;&#10;&#13;&#10;/SUM(confirmed_orders_nv)' />
            </column>
            <column caption='Take Rate - Local stores' datatype='real' name='[Take Rate - Food (copy)_439100997970632726]' role='measure' type='quantitative'>
