    <worksheet name='Overall_performance_review'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Avg. Drop-off Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Pick-up Distance (copia)_223491168411824131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([dropoff_distance])/1000)/SUM([dropoff_distance_base])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1374160872899305482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_orders])/&#13;&#10;SUM([sum_actual_evaluated_working_hours]/3600)' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1661546823772717059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders])/(sum([confirmed_orders])+sum([non_confirmed_orders]))' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1661546823786659847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([delivery_time])/60)/sum([delivery_time_base])' />
            </column>
            <column caption='Order Late &gt; 10&apos; Share' datatype='real' default-format='p0.0%' name='[Calculation_1661546823787130888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_late_10])/sum([order_late_base])' />
            </column>
            <column caption='Stacking' datatype='real' default-format='p0.0%' name='[Calculation_223491168406953985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries])/SUM([completed_deliveries])' />
            </column>
            <column caption='Avg. Pick-up Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_223491168411537410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([pickup_distance])/1000)/SUM([pickup_distance_base])' />
            </column>
            <column caption='Fail Rate Vendor' datatype='real' default-format='p0.00%' name='[Fail Rate (copia)_223491168417423364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders_restaurant])/(sum([confirmed_orders])+sum([non_confirmed_orders]))' />
            </column>
            <column caption='Fail Rate PeYa' datatype='real' default-format='p0.00%' name='[Fail Rate Vendor (copia)_223491168417488901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders_peya])/(sum([confirmed_orders])+sum([non_confirmed_orders]))' />
            </column>
            <column caption='Fail Rate Rider' datatype='real' default-format='p0.00%' name='[Fail Rate Vendor (copia)_223491168417562630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders_rider])/(sum([confirmed_orders])+sum([non_confirmed_orders]))' />
            </column>
            <column caption='Fail Rate User' datatype='real' default-format='p0.00%' name='[Fail Rate Vendor (copia)_223491168417628167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders_user])/(sum([confirmed_orders])+sum([non_confirmed_orders]))' />
            </column>
            <column caption='Title Overall performance review' datatype='string' name='[Title Ensure Clear Leadership (copia)_130041476659200017]' role='dimension' type='nominal'>
