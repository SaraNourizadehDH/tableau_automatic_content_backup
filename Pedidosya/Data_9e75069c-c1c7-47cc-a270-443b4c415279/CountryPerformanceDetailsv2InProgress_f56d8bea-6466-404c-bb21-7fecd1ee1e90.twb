            <column caption='Confirmed Orders Courier C2C' datatype='integer' name='[confirmed_orders_courier_c2c]' role='measure' type='quantitative' />
            <column caption='Confirmed Orders Dmart' datatype='integer' name='[confirmed_orders_dmart]' role='measure' type='quantitative' />
