    <worksheet name='Performance Highlights 4.1'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1374160872893661192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoter])-SUM([nps_ao_detractor]))/&#13;&#10;SUM([nps_ao_detractor]+[nps_ao_pasive]+[nps_ao_promoter]))&#13;&#10;*100' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1374160872899305482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_orders])/&#13;&#10;SUM([sum_actual_evaluated_working_hours]/3600)' />
            </column>
            <column caption='Title Seamless Experience' datatype='string' name='[Calculation_1628895727630422016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seamless Experience&quot;' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1661546823772717059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders])/(sum([confirmed_orders])+sum([non_confirmed_orders]))' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1661546823786659847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([delivery_time])/60)/sum([delivery_time_base])' />
            </column>
            <column caption='Order Late &gt; 10&apos; Share' datatype='real' default-format='p0.0%' name='[Calculation_1661546823787130888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_late_10])/sum([order_late_base])' />
            </column>
            <column caption='Seamless Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_758012152095957013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_1_payment_no_contact_not_delayed])/SUM([total_orders_logistic_Seamless])' />
            </column>
            <column caption='NPS Partners Existing' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS Partners Newbies  (copia)_362539807582576644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_partners_existing_ao_promoter]))-&#13;&#10;SUM(ZN([nps_partners_existing_ao_detractor])))/&#13;&#10;SUM(ZN([nps_partners_existing_ao_detractor])+&#13;&#10;ZN([nps_partners_existing_ao_passive])+&#13;&#10;ZN([nps_partners_existing_ao_promoter])))&#13;&#10;*100' />
            </column>
            <column caption='NPS Riders Existing' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS Riders Newbies (copia)_362539807580848131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_riders_existing_promoter]))-&#13;&#10;SUM(ZN([nps_riders_existing_detractor])))/&#13;&#10;SUM(ZN([nps_riders_existing_detractor])+&#13;&#10;ZN([nps_riders_existing_pasive])+&#13;&#10;ZN([nps_riders_existing_promoter])))&#13;&#10;*100' />
            </column>
            <column caption='Online Payment Orders Share' datatype='real' default-format='p0.0%' name='[New Verticals Orders Share (copia)_1661546823783038980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_online_payment])/SUM([confirmed_orders])' />
            </column>
            <column caption='Own Delivery Orders Share' datatype='real' default-format='p0.0%' name='[New Verticals Orders Share (copia)_1661546823786512390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_logistics])/SUM([confirmed_orders])' />
            </column>
            <column caption='Contact Rate ' datatype='real' default-format='p0.0%' name='[Session Rate (copia)_961518557785792551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cs_chats])+SUM([cs_cases]))&#13;&#10;/SUM([total_orders])' />
            </column>
