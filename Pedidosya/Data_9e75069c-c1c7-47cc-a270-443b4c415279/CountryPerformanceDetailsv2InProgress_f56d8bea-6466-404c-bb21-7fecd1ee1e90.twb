    <worksheet name='Quick-Commerce Profitability'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Basket Size - Total QC' datatype='real' name='[Basket Size Dmart (copy) (copy)_1110137354454192130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_ordered_products_dmart] + qty_ordered_products_ls)/SUM([confirmed_orders_dmart] + confirmed_orders_ls)' />
            </column>
            <column caption='Basket Size - Local Stores' datatype='real' name='[Basket Size Dmart (copy)_1110137354454179841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_ordered_products_ls])/SUM([confirmed_orders_ls])' />
            </column>
            <column caption='GPO (€) - Dmarts' datatype='real' name='[Calculation_1110137354459594757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_dmart]) / SUM([confirmed_orders_gpo_flgpo_dmart])' />
            </column>
            <column caption='Basket Size Dmart' datatype='real' name='[Calculation_804174053688856580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_ordered_products_dmart])/SUM([confirmed_orders_dmart])' />
            </column>
            <column caption='FLGPO (€) - Local Stores' datatype='real' name='[FLGPO (€) - Total QC (copy) (copy)_1110137354460381194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_ls]) / SUM([confirmed_orders_gpo_flgpo_ls])' />
            </column>
            <column caption='FLGPO (€) - Dmarts' datatype='real' name='[FLGPO (€) - Total QC (copy)_1110137354460364809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_dmart]) / SUM([confirmed_orders_gpo_flgpo_dmart])' />
            </column>
            <column caption='GPO (€) - Total QC' datatype='real' name='[GPO (€) - Dmarts (copy) (copy)_1110137354459881479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_dmart] + [gpo_ls]) / SUM([confirmed_orders_gpo_flgpo_dmart] + [confirmed_orders_gpo_flgpo_ls])' />
            </column>
            <column caption='GPO (€) - Local Stores' datatype='real' name='[GPO (€) - Dmarts (copy)_1110137354459869190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_ls]) / SUM([confirmed_orders_gpo_flgpo_ls])' />
            </column>
            <column caption='FLGPO (€) - Total QC' datatype='real' name='[GPO (€) - Total QC (copy)_1110137354460225544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_dmart] + [flgpo_ls]) / SUM([confirmed_orders_gpo_flgpo_dmart] + [confirmed_orders_gpo_flgpo_ls])' />
