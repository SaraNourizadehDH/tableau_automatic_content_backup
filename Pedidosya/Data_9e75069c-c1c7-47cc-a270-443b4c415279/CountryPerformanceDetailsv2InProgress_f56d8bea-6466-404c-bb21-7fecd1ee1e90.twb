    <worksheet name='Coverage and choice'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='CVR3 Dmart' datatype='real' default-format='p0.0%' name='[Calculation_170855357653618694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_orders_dmart])/SUM([sessions_dmart])' />
            </column>
            <column caption='Last Day Month' datatype='datetime' name='[Calculation_1713901180334440448]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,1,[month_date])-1' />
            </column>
            <column caption='Days Month' datatype='integer' name='[Calculation_1713901180334841857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[month_date],[Calculation_1713901180334440448])+1' />
            </column>
            <column caption='Daily Orders per Dmart' datatype='real' name='[Calculation_1713901180335198210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_dmart])/MAX([Calculation_1713901180334841857])/SUM([active_dmart_warehouses])' />
            </column>
            <column caption='WIS (weighted in stock)' datatype='real' name='[Calculation_66428135828004868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([wis_numerador])/SUM([wis_denominador])' />
            </column>
            <column caption='Fresh &amp; Ultra Fresh GMV Share' datatype='real' name='[Calculation_77968583325659137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales_uf_fresh] + [sales_fresh] ) / SUM([net_sales_eur])' />
            </column>
            <column caption='Penetration Dmarts ' datatype='real' default-format='p0.0%' name='[Coverage Dmarts (copia)_170855357650952193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers_dmart])/sum([active_customer_dmart_areas])' />
            </column>
            <column caption='Order share dmart' datatype='real' name='[Order share qc (copia)_1161647267995402242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_dmart])/SUM([confirmed_orders])' />
            </column>
            <column caption='Title Coverage and choice' datatype='string' name='[Title Customer Segmentation by Income (copia)_66428135828996101]' role='dimension' type='nominal'>
