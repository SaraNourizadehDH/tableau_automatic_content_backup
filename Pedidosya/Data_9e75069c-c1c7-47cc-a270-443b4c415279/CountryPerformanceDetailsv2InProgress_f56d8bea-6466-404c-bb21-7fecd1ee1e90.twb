    <worksheet name='Seamless Orders Experience'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Discounts paid by PeYa' datatype='real' hidden='true' name='[Calculation_1293940506676146177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM(ZN([disc_peya_bins])+&#13;&#10;ZN([disc_peya_mark_vouchers])+&#13;&#10;ZN([disc_peya_plus_ship_cost])+&#13;&#10;ZN([disc_peya_sorry_vouchers])+&#13;&#10;ZN([disc_peya_subsidized])+&#13;&#10;ZN([disc_peya_partnerships])+&#13;&#10;ZN([disc_peya_non_mark_vouchers])&#13;&#10;)&#13;&#10;ELSE &#13;&#10;// LOCAL CURRENCY&#13;&#10;SUM(ZN([disc_peya_bins_lc])+&#13;&#10;ZN([disc_peya_mark_vouchers_lc])+&#13;&#10;ZN([disc_peya_plus_ship_cost_lc])+&#13;&#10;ZN([disc_peya_sorry_vouchers_lc])+&#13;&#10;ZN([disc_peya_subsidized_lc])+&#13;&#10;ZN([disc_peya_partnerships_lc])+&#13;&#10;ZN([disc_peya_non_mark_vouchers_lc])&#13;&#10;)&#13;&#10;END' />
            </column>
            <column caption='Total Discounts Amount' datatype='real' hidden='true' name='[Calculation_1293940506678624259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1293940506676146177]+[Disconts paid by PeYa (copia)_1293940506677186562]' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1374160872893661192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoter])-SUM([nps_ao_detractor]))/&#13;&#10;SUM([nps_ao_detractor]+[nps_ao_pasive]+[nps_ao_promoter]))&#13;&#10;*100' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1374160872899305482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_orders])/&#13;&#10;SUM([sum_actual_evaluated_working_hours]/3600)' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1661546823772717059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([non_confirmed_orders])/(sum([confirmed_orders])+sum([non_confirmed_orders]))' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1661546823786659847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([delivery_time])/60)/sum([delivery_time_base])' />
            </column>
            <column caption='Order Late &gt; 10&apos; Share' datatype='real' default-format='p0.0%' name='[Calculation_1661546823787130888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_late_10])/sum([order_late_base])' />
            </column>
            <column caption='Seamless Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_758012152095957013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_1_payment_no_contact_not_delayed])/SUM([total_orders_logistic_Seamless])' />
            </column>
            <column caption='Discounts paid by Others' datatype='real' hidden='true' name='[Disconts paid by PeYa (copia)_1293940506677186562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Euro&quot; THEN&#13;&#10;SUM(ZN([disc_others_bins])+&#13;&#10;ZN([disc_others_joker])+&#13;&#10;ZN([disc_others_mark_vouchers])+&#13;&#10;ZN([disc_others_shopper])+&#13;&#10;ZN([disc_others_stamps])+&#13;&#10;ZN([disc_others_subsidized])+&#13;&#10;ZN([disc_others_weekly])+&#13;&#10;ZN([disc_others_coorporative_vouchers])+&#13;&#10;ZN([disc_others_wallet_coorp])&#13;&#10;)&#13;&#10;ELSE&#13;&#10;// Local Currency&#13;&#10;SUM(ZN([disc_others_bins_lc])+&#13;&#10;ZN([disc_others_joker_lc])+&#13;&#10;ZN([disc_others_mark_vouchers_lc])+&#13;&#10;ZN([disc_others_shopper_lc])+&#13;&#10;ZN([disc_others_stamps_lc])+&#13;&#10;ZN([disc_others_subsidized_lc])+&#13;&#10;ZN([disc_others_weekly_lc])+&#13;&#10;ZN([disc_others_coorporative_vouchers_lc])+&#13;&#10;ZN([disc_others_wallet_coorp_lc])&#13;&#10;)&#13;&#10;END' />
            </column>
            <column caption='NPS Partners Existing' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS Partners Newbies  (copia)_362539807582576644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_partners_existing_ao_promoter]))-&#13;&#10;SUM(ZN([nps_partners_existing_ao_detractor])))/&#13;&#10;SUM(ZN([nps_partners_existing_ao_detractor])+&#13;&#10;ZN([nps_partners_existing_ao_passive])+&#13;&#10;ZN([nps_partners_existing_ao_promoter])))&#13;&#10;*100' />
            </column>
            <column caption='NPS Riders Existing' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS Riders Newbies (copia)_362539807580848131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_riders_existing_promoter]))-&#13;&#10;SUM(ZN([nps_riders_existing_detractor])))/&#13;&#10;SUM(ZN([nps_riders_existing_detractor])+&#13;&#10;ZN([nps_riders_existing_pasive])+&#13;&#10;ZN([nps_riders_existing_promoter])))&#13;&#10;*100' />
            </column>
            <column caption='Online Payment Orders Share' datatype='real' default-format='p0.0%' name='[New Verticals Orders Share (copia)_1661546823783038980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_online_payment])/SUM([confirmed_orders])' />
            </column>
            <column caption='Own Delivery Orders Share' datatype='real' default-format='p0.0%' name='[New Verticals Orders Share (copia)_1661546823786512390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_logistics])/SUM([confirmed_orders])' />
            </column>
            <column caption='Contact Rate ' datatype='real' default-format='p0.0%' name='[Session Rate (copia)_961518557785792551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cs_chats])+SUM([cs_cases]))&#13;&#10;/SUM([total_orders])' />
            </column>
            <column caption='Discounts founded by Others Share' datatype='real' default-format='p0.0%' hidden='true' name='[Share Discounts Paid by Others (copia)_758012152082403346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Disconts paid by PeYa (copia)_1293940506677186562]/[Calculation_1293940506678624259]' />
            </column>
            <column caption='Title Seamless Orders Experience' datatype='string' name='[Title Seamless Experience (copia)_1161647268070760472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seamless Orders Experience&quot;' />
            </column>
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Confirmed Orders 1 Payment No Contact Not Delayed' datatype='integer' name='[confirmed_orders_1_payment_no_contact_not_delayed]' role='measure' type='quantitative' />
            <column caption='Confirmed Orders Logistics' datatype='integer' name='[confirmed_orders_logistics]' role='measure' type='quantitative' />
            <column caption='Confirmed Orders Online Payment' datatype='integer' name='[confirmed_orders_online_payment]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cs Cases' datatype='integer' name='[cs_cases]' role='measure' type='quantitative' />
            <column caption='Cs Chats' datatype='integer' name='[cs_chats]' role='measure' type='quantitative' />
            <column caption='Delivery Time' datatype='integer' name='[delivery_time]' role='measure' type='quantitative' />
