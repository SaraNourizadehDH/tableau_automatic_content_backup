    <worksheet name='Pick-Up Review'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Active_pickup_customers_share' datatype='real' name='[Calculation_1161647268077088798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_customers_pickup])/SUM([active_customers_food])' />
            </column>
            <column caption='Pick-Up Frequency' datatype='real' name='[Calculation_1161647268077473823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_pickup])/SUM([active_customers_pickup])' />
            </column>
            <column caption='Pick-Up Active Users Share (%Food Active Users)' datatype='real' name='[Calculation_244320331015741442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_users_pickup])/SUM([active_users_food])' />
            </column>
            <column caption='Fail Rate pickup' datatype='real' name='[Fail Rate - Dmart (copia)_1161647268106055721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_pickup])/SUM([total_orders_pickup])' />
            </column>
            <column caption='pickup VFR' datatype='real' name='[Fail Rate pickup (copia)_1161647268106194986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_partner_owner_pickup])/SUM([total_orders_pickup])' />
            </column>
            <column caption='Food OD Fail rate (excl. Pick-Up)' datatype='real' name='[Food OD Fail rate (copia)_1284370362555453442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_od_food_non_pu])/SUM([total_orders_od_food_non_pu])' />
            </column>
