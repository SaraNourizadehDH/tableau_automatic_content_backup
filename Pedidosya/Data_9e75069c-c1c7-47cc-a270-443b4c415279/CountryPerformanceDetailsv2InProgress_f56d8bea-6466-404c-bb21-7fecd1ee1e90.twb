            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month Date' datatype='date' name='[month_date]' role='dimension' type='ordinal' />
            <column-instance column='[Title Affordability (copy)_1628895727631835142]' derivation='None' name='[none:Title Affordability (copy)_1628895727631835142:nk]' pivot='key' type='nominal' />
