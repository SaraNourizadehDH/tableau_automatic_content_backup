    <worksheet name='Plus Review'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Confirmed peya total orders (excl. Courier)' datatype='integer' name='[Calculation_178455181436678144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])-SUM([confirmed_orders_courier_b2c])-SUM([confirmed_orders_courier_c2c])' />
            </column>
            <column caption='Adoption % (subscribers/total active users excl. Courier)' datatype='real' name='[Calculation_558446395394060289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Subscribers_funded_by_3p])+SUM([Subscribers_funded_by_PeYa])+SUM([Subscribers_organic]))/SUM([peya_total_active_users_non_courier])' />
            </column>
            <column caption='Frequency Plus' datatype='real' name='[Calculation_558446395394609154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plus_freq_numerador])/SUM([plus_freq_denominador])' />
            </column>
            <column caption='Frequency Plus/Frequency non-plus' datatype='real' name='[Calculation_558446395395010564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_558446395394609154]/[Frequency Plus (copia)_558446395394887683]' />
            </column>
            <column caption='Cofunded Orders Share' datatype='real' name='[Calculation_558446395395399685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cofunded_orders_numerador])/SUM([cofunded_orders_denominador])' />
            </column>
            <column caption='Plus active partners coverage (% total active partners excl. courier)' datatype='real' name='[Calculation_558446395395739654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_partner_plus])/SUM([active_partner_non_courier])' />
            </column>
            <column caption='Frequency Non Plus' datatype='real' name='[Frequency Plus (copia)_558446395394887683]' role='measure' type='quantitative'>
