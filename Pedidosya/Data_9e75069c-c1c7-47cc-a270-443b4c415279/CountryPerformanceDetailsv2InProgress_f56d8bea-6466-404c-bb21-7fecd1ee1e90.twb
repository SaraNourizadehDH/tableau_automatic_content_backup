          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='AVG Delivery time dmarts' datatype='real' name='[AVG Delivery time LS (copia)_1161647268034596882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([delivery_time_dmarts]))/SUM([delivery_time_base_dmarts]))/60' />
            </column>
            <column caption='AVG Delivery time LS' datatype='real' name='[AVG Delivery time qc (copia)_1161647268033957905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([delivery_time_ls]))/SUM([delivery_time_base_ls]))/60' />
            </column>
            <column caption='Fail Rate - Total QC' datatype='real' name='[Calculation_1161647268031098893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([non_confirmed_orders_dmart]) + SUM([non_confirmed_orders_ls]))/(SUM([total_orders_dmart])+SUM([total_orders_ls]))' />
            </column>
            <column caption='AVG Delivery time qc' datatype='real' name='[Calculation_1161647268033331216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([delivery_time_qc]))/SUM([delivery_time_base_qc]))/60' />
            </column>
            <column caption='Fail Rate - Local Stores' datatype='real' name='[Fail Rate - Total QC (copia)_1161647268031623182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_ls])/SUM([total_orders_ls])' />
            </column>
            <column caption='Fail Rate - Dmart' datatype='real' name='[Fail Rate - Total QC (copia)_1161647268031819791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_dmart])/SUM([total_orders_dmart])' />
            </column>
            <column caption='NPS AO Dmarts' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS AO (copia)_705376330740056074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoter_dmarts])-SUM([nps_ao_detractor_dmarts]))/&#13;&#10;SUM([nps_ao_detractor_dmarts]+&#13;&#10;[nps_ao_pasive_dmarts]+&#13;&#10;[nps_ao_promoter_dmarts]))&#13;&#10;*100' />
            </column>
            <column caption='NPS AO QC' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS AO Dmarts (copia)_1161647268068978710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoter_qc])-SUM([nps_ao_detractor_qc]))/&#13;&#10;SUM([nps_ao_detractor_qc]+&#13;&#10;[nps_ao_pasive_qc]+&#13;&#10;[nps_ao_promoter_qc]))&#13;&#10;*100' />
            </column>
            <column caption='NPS AO LS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS AO QC (copia)_1161647268069105687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoter_ls])-SUM([nps_ao_detractor_ls]))/&#13;&#10;SUM([nps_ao_detractor_ls]+&#13;&#10;[nps_ao_pasive_ls]+&#13;&#10;[nps_ao_promoter_ls]))&#13;&#10;*100' />
            </column>
            <column caption='Title Ops' datatype='string' name='[Title Choice (copia)_1161647268035043347]' role='dimension' type='nominal'>
