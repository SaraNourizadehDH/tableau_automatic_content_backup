    <worksheet name='Partners_review'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Assumed Preparation Time non courier (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Assumed Preparation Time (min) (copia)_130041476669181976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([assumed_preptime_non_courier]/60)/sum([assumed_preptime_base_non_courier])' />
            </column>
            <column caption='CVR3_food' datatype='real' default-format='p0.0%' name='[CVR3 (copia)_1529535067890180098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([TA_sessions_shop_details_food])/SUM([sessions_shop_details_food])' />
            </column>
            <column caption='VFR_Food' datatype='real' name='[Calculation_130041476660895764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_partner_owner_food])/SUM([confirmed_orders_food])' />
            </column>
            <column caption='Vendor Late 10 non courier' datatype='real' default-format='p0.0%' name='[Calculation_223491168460738568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10_non_courier])/sum([vendor_late_base_non_courier])' />
            </column>
            <column caption='Products w/ pics (%) (Food)' datatype='real' name='[Calculation_66428135826894850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_products_images])/SUM([total_products_base])' />
            </column>
            <column caption='Contact Rate Non Courier' datatype='real' default-format='p0.0%' name='[Contact Rate  (copia)_130041476671463450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ps_chats_non_courier])+SUM([ps_cases_non_courier]))&#13;&#10;/SUM([total_orders_non_courier])' />
            </column>
            <column caption='NPS Partners Existing Non Courier' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS Partners Existing (copia)_130041476674252831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_partners_existing_ao_promoter_non_courier]))-&#13;&#10;SUM(ZN([nps_partners_existing_ao_detractor_non_courier])))/&#13;&#10;SUM(ZN([nps_partners_existing_ao_detractor_non_courier])+&#13;&#10;ZN([nps_partners_existing_ao_passive_non_courier])+&#13;&#10;ZN([nps_partners_existing_ao_promoter_non_courier])))&#13;&#10;*100' />
            </column>
            <column caption='Products w/ description (%) (QC) ' datatype='real' name='[Products w/ description (%) (Food) (copia)_1289999860245168131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_products_description_qc])/SUM([total_products_base_qc])' />
            </column>
            <column caption='Products w/ pics (%) (QC)' datatype='real' name='[Products w/ pics (%) (Food) (copia)_1289999860245032962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_products_images_qc])/SUM([total_products_base_qc])' />
            </column>
            <column caption='Products w/ description (%) (Food)' datatype='real' name='[Products w/ pics (%) (Food) (copia)_66428135827066883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_products_description])/SUM([total_products_base])' />
            </column>
            <column caption='TA sessions shop details food' datatype='integer' name='[TA_sessions_shop_details_food]' role='measure' type='quantitative' />
            <column caption='Title Partners review(excl. Courier)' datatype='string' name='[Title Ensure Clear Leadership (copia)_130041476660715539]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Partners review&#13;&#10;(excl. Courier)&quot;' />
