    <worksheet name='Seamless_o_experience_dmart'>
      <table>
        <view>
          <datasources>
            <datasource caption='general' name='federated.0i9ffvp09v2tzd1168ksh18cdjlq' />
          </datasources>
          <datasource-dependencies datasource='federated.0i9ffvp09v2tzd1168ksh18cdjlq'>
            <column caption='Avg. Delivery Time Dmarts' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Delivery Time (copia)_705376330740334604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([delivery_time_dmarts])/60)/sum([completed_orders_np_dmarts])' />
            </column>
            <column caption='Avg. Orders With Delivery Time &gt;= 45 mins' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Delivery Time Dmarts (copy)_100486627948773380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cant_orders_with_delivery_time_45]) / sum([completed_orders_dmarts])' />
            </column>
            <column caption='online key account FOOD share' datatype='real' hidden='true' name='[Calculation_1161647268104863781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Online_Partners_KA_PU])/SUM([Online_Partners_Food_KA])' />
            </column>
            <column caption='Avg. Delivery Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_204913841922564108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_deliveries_distance])&#13;&#10;/&#13;&#10;SUM([completed_deliveries_dmarts])' />
            </column>
            <column caption='Vendor Fail Rate Dmarts' datatype='real' default-format='p0.0%' name='[Fail Rate (copia)_705376330740199435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(non_confirmed_orders_partner_owner_dmart)/(sum([confirmed_orders_dmart])+sum([non_confirmed_orders_dmart]))' />
            </column>
            <column caption='Food OD Fail rate' datatype='real' hidden='true' name='[Fail Rate - Dmart (copia)_1161647268105568295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_od_food])/SUM([total_orders_od_food])' />
            </column>
            <column caption='Fail Rate pickup' datatype='real' name='[Fail Rate - Dmart (copia)_1161647268106055721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_pickup])/SUM([total_orders_pickup])' />
            </column>
            <column caption='Food OD VFR' datatype='real' hidden='true' name='[Food OD Fail rate (copia)_1161647268105752616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders_od_partner_owner_food])/SUM([total_orders_od_food])' />
            </column>
            <column caption='NPS AO Dmarts (copia)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS AO Dmarts (copia)_1161647268075810843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoter_dmarts])-SUM([nps_ao_detractor_dmarts]))/&#13;&#10;SUM([nps_ao_detractor_dmarts]+&#13;&#10;[nps_ao_pasive_dmarts]+&#13;&#10;[nps_ao_promoter_dmarts]))&#13;&#10;*100' />
            </column>
            <column caption='Online Partners Food KA' datatype='integer' hidden='true' name='[Online_Partners_Food_KA]' role='measure' type='quantitative' />
            <column caption='Online Partners KA PU' datatype='integer' hidden='true' name='[Online_Partners_KA_PU]' role='measure' type='quantitative' />
            <column caption='Stacking Dmarts' datatype='real' default-format='p0.0%' name='[Stacking (copia)_705376330740494350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries_dmarts])/SUM([completed_deliveries_dmarts])' />
            </column>
            <column caption='Title Seamless Orders Experience' datatype='string' name='[Title Seamless Experience (copia)_1161647268070760472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Seamless Orders Experience&quot;' />
            </column>
            <column caption='Active Customers Reorder Dmart' datatype='integer' name='[active_customers_reorder_dmart]' role='measure' type='quantitative' />
            <column caption='Active Partners Food Ka' datatype='integer' name='[active_partners_food_ka]' role='measure' type='quantitative' />
            <column caption='Active Partners Pu Ka' datatype='integer' name='[active_partners_pu_ka]' role='measure' type='quantitative' />
            <column caption='Cant Orders With Delivery Time 45' datatype='integer' name='[cant_orders_with_delivery_time_45]' role='measure' type='quantitative' />
            <column caption='Completed Deliveries Dmarts' datatype='integer' name='[completed_deliveries_dmarts]' role='measure' type='quantitative' />
            <column caption='Completed Orders Dmarts' datatype='integer' name='[completed_orders_dmarts]' role='measure' type='quantitative' />
            <column caption='Completed Orders Np Dmarts' datatype='integer' name='[completed_orders_np_dmarts]' role='measure' type='quantitative' />
            <column caption='Confirmed Orders Dmart' datatype='integer' name='[confirmed_orders_dmart]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
