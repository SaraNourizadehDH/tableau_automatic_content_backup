      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_3A9BC48FE62E4549B3430EB0A499B3D9'>
            <properties context=''>
              <relation connection='bigquery.1oxft7i09o3cyf1f80njs07b70pv' name='Custom SQL Query' type='text'>SELECT&#13;
            DATE_TRUNC(sessions.partition_date,MONTH) as month,&#13;
            sessions.area.area_name  AS area_name,&#13;
            sessions.area.area_id AS area_id,&#13;
            sessions.city.city_name  AS city_name,&#13;
            COUNT(DISTINCT case when  sessions.totals.orders   &gt;&gt;0 then  sessions.session_sk   else null end ) AS sessions_w_transaction,&#13;
            COUNT(DISTINCT sessions.session_sk ) AS total_sessions,&#13;
        FROM `peya-bi-tools-pro.il_sessions.fact_perseus_sessions` AS sessions&#13;
        WHERE 1 = 1&#13;
        -- AND ((UPPER(( sessions.city.city_name  )) LIKE UPPER(&apos;%managua%&apos;))) &#13;
        AND sessions.city IS NOT NULL&#13;
        AND sessions.area.area_id IS NOT NULL&#13;
        AND (sessions.country_id ) = 8 &#13;
        AND sessions.partition_date &gt;&gt;= (DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -10 MONTH))&#13;
        GROUP BY 1,2,3,4&#13;
        HAVING total_sessions &gt;&gt;= 100</relation>
            </properties>
            <properties context='extract'>
              <relation name='_3A9BC48FE62E4549B3430EB0A499B3D9' table='[Extract].[_3A9BC48FE62E4549B3430EB0A499B3D9]' type='table' />
            </properties>
          </object>
          <object caption='Area Polygon' id='_932197C807194A5DB1670EF92A9E4A36'>
            <properties context=''>
              <relation connection='bigquery.1oxft7i09o3cyf1f80njs07b70pv' name='Custom SQL Query1' type='text'>SELECT  area.area_id, &#13;
        area.area_name, &#13;
        area.city_id as area_city_id, &#13;
        city.city_name AS area_city_name,&#13;
        area.country_id AS area_country_id,&#13;
        country.country_name AS area_country_name,&#13;
        SAFE_CAST(polygon_points.latitud AS FLOAT64) as latitude,&#13;
        SAFE_CAST(polygon_points.longitud AS FLOAT64) as longitude,&#13;
        ROW_NUMBER() OVER (PARTITION BY area_id, area_name) as row_num,&#13;
FROM `peya-bi-tools-pro.il_core.dim_area` AS area&#13;
LEFT JOIN UNNEST(polygon_points) AS polygon_points&#13;
INNER JOIN peya-bi-tools-pro.il_core.dim_country AS country ON country.country_id = area.country_id AND country.active&#13;
INNER JOIN peya-bi-tools-pro.il_core.dim_city AS city ON city.city_id = area.city_id&#13;
WHERE area.is_deleted = false&#13;
AND polygon IS NOT NULL&#13;
AND area.country_id = 8</relation>
            </properties>
            <properties context='extract'>
              <relation name='_932197C807194A5DB1670EF92A9E4A36' table='[Extract].[_932197C807194A5DB1670EF92A9E4A36]' type='table' />
            </properties>
          </object>
        </objects>
