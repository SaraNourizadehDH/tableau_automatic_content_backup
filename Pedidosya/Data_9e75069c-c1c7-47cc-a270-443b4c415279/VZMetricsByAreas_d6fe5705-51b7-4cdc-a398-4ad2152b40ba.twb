        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1eimdqs1vb69ls14ffykz0ha1m7v' name='Custom SQL Query1' type='text'>SELECT  area.area_id, &#13;
        area.area_name, &#13;
        area.city_id as area_city_id, &#13;
        city.city_name AS area_city_name,&#13;
        area.country_id AS area_country_id,&#13;
        country.country_name AS area_country_name,&#13;
        SAFE_CAST(polygon_points.latitud AS FLOAT64) as latitude,&#13;
        SAFE_CAST(polygon_points.longitud AS FLOAT64) as longitude,&#13;
        ROW_NUMBER() OVER (PARTITION BY area_id, area_name) as row_num,&#13;
FROM `peya-bi-tools-pro.il_core.dim_area` AS area&#13;
LEFT JOIN UNNEST(polygon_points) AS polygon_points&#13;
INNER JOIN peya-bi-tools-pro.il_core.dim_country AS country ON country.country_id = area.country_id AND country.active&#13;
INNER JOIN peya-bi-tools-pro.il_core.dim_city AS city ON city.city_id = area.city_id&#13;
WHERE area.is_deleted = false&#13;
AND polygon IS NOT NULL&#13;
AND area.country_id = 8</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1eimdqs1vb69ls14ffykz0ha1m7v' name='Custom SQL Query' type='text'>SELECT&#13;
    DATE_TRUNC(orders.registered_date,MONTH) AS month,&#13;
    orders.country.country_name AS country_name,&#13;
    dim_area_order.area_name  AS area_name,&#13;
    dim_area_order.area_id  AS area_id,&#13;
    dim_city_order.city_name AS city_name,&#13;
    COUNT(DISTINCT CASE WHEN is_acquisition = 1 THEN orders.customer_id END) AS qty_acquisitions&#13;
FROM `peya-bi-tools-pro.il_core.fact_orders`  AS orders&#13;
LEFT JOIN UNNEST([orders.country]) as fact_orders_country&#13;
LEFT JOIN UNNEST([orders.address]) as fact_orders_address&#13;
LEFT JOIN UNNEST([orders.restaurant.address.area]) as fact_orders_restaurant_address_area&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_area` AS dim_area_order ON COALESCE(fact_orders_address.area.id,fact_orders_restaurant_address_area.id) =dim_area_order.area_id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_city` AS dim_city_order ON coalesce(orders.address.area.city.id, orders.city.city_id)  = dim_city_order.city_id&#13;
WHERE 1 = 1&#13;
AND orders.registered_date &gt;&gt;= (DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -10 MONTH))&#13;
AND orders.order_status = &quot;CONFIRMED&quot;&#13;
AND orders.country_id = 8&#13;
GROUP BY ALL&#13;
ORDER BY 2 DESC</relation>
          <relation connection='bigquery.1eimdqs1vb69ls14ffykz0ha1m7v' name='Custom SQL Query1' type='text'>SELECT  area.area_id, &#13;
        area.area_name, &#13;
        area.city_id as area_city_id, &#13;
        city.city_name AS area_city_name,&#13;
        area.country_id AS area_country_id,&#13;
        country.country_name AS area_country_name,&#13;
        SAFE_CAST(polygon_points.latitud AS FLOAT64) as latitude,&#13;
        SAFE_CAST(polygon_points.longitud AS FLOAT64) as longitude,&#13;
        ROW_NUMBER() OVER (PARTITION BY area_id, area_name) as row_num,&#13;
FROM `peya-bi-tools-pro.il_core.dim_area` AS area&#13;
LEFT JOIN UNNEST(polygon_points) AS polygon_points&#13;
INNER JOIN peya-bi-tools-pro.il_core.dim_country AS country ON country.country_id = area.country_id AND country.active&#13;
INNER JOIN peya-bi-tools-pro.il_core.dim_city AS city ON city.city_id = area.city_id&#13;
WHERE area.is_deleted = false&#13;
AND polygon IS NOT NULL&#13;
AND area.country_id = 8</relation>
