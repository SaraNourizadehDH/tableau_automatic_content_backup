                    <formatted-text>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='12'>Definitions</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Hugo Active 0 - 90</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'> (Hugo users active at least 90 days before migration date)</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Hugo Active 90 - 365</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'> (Hugo users active between 90 and 365 days before migration date)</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Hugo Users (Static) </run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'>: Qty of Hugo Users in each cluster at the time of migration. This number is fixed. </run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontname='Arial' fontsize='10'>Hugo&apos;s metrics are for the last 3 months.</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>(For Hugo Active 0 - 90 from Oct24 - Dic24</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>For Hugo Active 90 - 365 from Jul24 -Sep24)</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Avg Orders in Hugo</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'>: Average orders these users had in Hugo (L3M)</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>AOV in Hugo:</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'> AOV in Hugo</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Æ </run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'>(L3M)</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>AFV in Hugo</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'>: AFV in Hugo</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Æ </run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'>(L3M)</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>DF in Hugo</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'>: DF in Hugo</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Æ </run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'>(L3M)</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Migrated Users:</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'> How many of these users ordered in PeYa?</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>Orders in PeYa:</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'> How many orders have they made in PeYa?</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='10'>AOV in PeYa:</run>
                      <run fontcolor='#000000' fontname='Arial' fontsize='10'> What is their AOV?</run>
