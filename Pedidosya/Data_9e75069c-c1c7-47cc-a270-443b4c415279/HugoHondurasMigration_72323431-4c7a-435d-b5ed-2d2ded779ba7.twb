      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='data_hugo_migration_honduras (automated_tables_reports)' name='federated.0mfkuwc0v33kov16nwsgf1905tog' />
          </datasources>
          <datasource-dependencies datasource='federated.0mfkuwc0v33kov16nwsgf1905tog'>
            <column caption='% Users Migrated' datatype='real' name='[Calculation_1410752621533687808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_911978961753501696] / [Calculation_911978961753739265]' />
            </column>
            <column caption='Avg Hugo Orders' datatype='real' name='[Calculation_373517333486428160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [month], [hugo_cluster], [peya_cluster] : SUM(IF [hugo_orders] &gt; 0 THEN [hugo_orders] END)})' />
            </column>
            <column caption='Peya Users' datatype='integer' name='[Calculation_911978961753501696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [peya_orders] &gt; 0 THEN [peya_id] END)' />
            </column>
            <column caption='Hugo Users (Static)' datatype='integer' name='[Calculation_911978961753739265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [total_orders_hugo] &gt; 0 THEN [hugo_id] END)' />
            </column>
            <column caption='Peya DF (USD)' datatype='real' name='[Calculation_911978961754656770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([peya_df_usd]) / SUM([peya_orders])' />
            </column>
            <column caption='Hugo DF (USD)' datatype='real' name='[Calculation_911978961759924228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hugo_df]) / SUM([hugo_orders])' />
            </column>
            <column caption='Hugo AOV (GMV)' datatype='real' name='[Calculation_95420055411347456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hugo_gmv]) / SUM([hugo_orders])' />
            </column>
            <column caption='Hugo AFV (USD)' datatype='real' name='[Calculation_95420055411515393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hugo_gfv]) / SUM([hugo_orders])' />
            </column>
            <column caption='Peya AOV (USD)' datatype='real' name='[Calculation_95420055411830786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([peya_gmv_usd]) / sum([peya_orders])' />
            </column>
            <column caption='Peya AFV (USD)' datatype='real' name='[Calculation_95420055411986435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([peya_gfv_usd]) / SUM([peya_orders])' />
            </column>
            <column caption='Hugo Cluster' datatype='string' name='[hugo_cluster]' role='dimension' type='nominal' />
            <column caption='Hugo Df' datatype='real' name='[hugo_df]' role='measure' type='quantitative' />
