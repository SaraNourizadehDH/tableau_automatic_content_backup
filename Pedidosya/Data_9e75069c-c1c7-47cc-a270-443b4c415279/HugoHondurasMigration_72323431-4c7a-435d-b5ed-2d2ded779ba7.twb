      <table>
        <view>
          <datasources>
            <datasource caption='data_hugo_migration_honduras (automated_tables_reports)' name='federated.0mfkuwc0v33kov16nwsgf1905tog' />
          </datasources>
          <datasource-dependencies datasource='federated.0mfkuwc0v33kov16nwsgf1905tog'>
            <column caption='Avg Peya Orders' datatype='real' name='[Avg Hugo Orders (copy)_667940159341211650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [month], [hugo_cluster], [peya_cluster] : SUM(IF [peya_orders] &gt; 0 THEN [peya_orders] END)})' />
            </column>
            <column caption='% Users Migrated' datatype='real' name='[Calculation_1410752621533687808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_911978961753501696] / [Calculation_911978961753739265]' />
            </column>
            <column caption='Peya Users' datatype='integer' name='[Calculation_911978961753501696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [peya_orders] &gt; 0 THEN [peya_id] END)' />
            </column>
            <column caption='Hugo Users (Static)' datatype='integer' name='[Calculation_911978961753739265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [total_orders_hugo] &gt; 0 THEN [hugo_id] END)' />
            </column>
            <column caption='Peya DF (USD)' datatype='real' name='[Calculation_911978961754656770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([peya_df_usd]) / SUM([peya_orders])' />
            </column>
            <column caption='Peya AOV (USD)' datatype='real' name='[Calculation_95420055411830786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([peya_gmv_usd]) / sum([peya_orders])' />
            </column>
