      <aliases enabled='yes' />
      <column caption='Base Customers Month' datatype='integer' name='[Active Customers (copy)_1237082547892051969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED year([order_month]),month([order_month]), [region], [Calculation_1145321705782632448] :[Calculation_1237082547891855360]}' />
      </column>
      <column caption='Reorder Rate Crosstab' datatype='real' name='[Base Customers Month (copy)_1237082547892269058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1237082547891855360]/ SUM([Active Customers (copy)_1237082547892051969])' />
      </column>
      <column caption='Condition DT' datatype='string' name='[Calculation_1145321705782632448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_time_min_bucket] &gt;= 25 AND [delivery_time_min_bucket] &lt;= 35 THEN &quot;DT &gt;= 25 AND &lt;= 35&quot;&#13;&#10;ELSEIF [delivery_time_min_bucket] &gt; 35 AND [delivery_time_min_bucket] &lt;= 45 THEN &quot;DT &gt; 35 AND &lt;= 45&quot;&#13;&#10;ELSEIF [delivery_time_min_bucket] &gt; 45 AND [delivery_time_min_bucket] &lt;= 55 THEN &quot;DT &gt; 45 AND &lt;= 55&quot;&#13;&#10;ELSEIF [delivery_time_min_bucket] &gt; 55 AND [delivery_time_min_bucket] &lt;= 65 THEN &quot;DT &gt; 55 AND &lt;= 65&quot;&#13;&#10;ELSE &quot;Other&quot; END' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_1237082547891855360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
