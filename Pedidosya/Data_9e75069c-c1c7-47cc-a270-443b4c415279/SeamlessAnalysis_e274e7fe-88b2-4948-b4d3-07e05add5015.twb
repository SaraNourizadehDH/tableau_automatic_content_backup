              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;User&quot; THEN&#13;&#10;{ FIXED [region] : COUNTD(IF [order_status] != &quot;CONFIRMED&quot; AND [fail_rate_owner] = &quot;User&quot; AND [delivery_time_min_bucket] &lt;= 35 THEN [order_id] END) }&#13;&#10;ELSEIF  [Parameters].[Parameter 1]  = &quot;All&quot; THEN&#13;&#10;{ FIXED [region] : COUNTD(IF [order_status] != &quot;CONFIRMED&quot; AND [delivery_time_min_bucket] &lt;= 35 THEN [order_id] END) }&#13;&#10;ELSE &#13;&#10;{ FIXED [region] : COUNTD(IF [order_status] != &quot;CONFIRMED&quot; AND [delivery_time_min_bucket] &lt;= 35 THEN [order_id] END) }&#13;&#10;END&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;{ FIXED [region] : COUNTD(IF [delivery_time_min_bucket] &lt;= 35 THEN [order_id] END) }' />
