              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Orders&quot;                        THEN SUM(IF ([vertical] != &quot;Restaurant&quot; AND [vertical] != &quot;Coffee&quot; AND [vertical] != &quot;Courier&quot; AND [vertical] != &quot;Courier Business&quot;) then [order_id] END) / SUM ([order_id])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Amount&quot;                   THEN SUM(IF ([vertical] != &quot;Restaurant&quot; AND [vertical] != &quot;Coffee&quot; AND [vertical] != &quot;Courier&quot; AND [vertical] != &quot;Courier Business&quot;) then [total_amount_no_discount] END) / SUM ([total_amount_no_discount])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Company&quot; THEN SUM(IF ([vertical] != &quot;Restaurant&quot; AND [vertical] != &quot;Coffee&quot; AND [vertical] != &quot;Courier&quot; AND [vertical] != &quot;Courier Business&quot;) then [discount_company] END) / SUM ([discount_company])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Other&quot;   THEN SUM(IF ([vertical] != &quot;Restaurant&quot; AND [vertical] != &quot;Coffee&quot; AND [vertical] != &quot;Courier&quot; AND [vertical] != &quot;Courier Business&quot;) then [discount_third] END) / SUM ([discount_third]) &#13;&#10;END' />
            </column>
            <column caption='Share Food Parameter' datatype='real' default-format='p0.00%' name='[Share Online Pay Parameter (copia)_910571605014495246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Orders&quot; THEN SUM(IF ([vertical] = &quot;Restaurant&quot; OR [vertical] = &quot;Coffee&quot;) then [order_id] END) / SUM ([order_id])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Amount&quot; THEN SUM(IF ([vertical] = &quot;Restaurant&quot; OR [vertical] = &quot;Coffee&quot;) then [total_amount_no_discount] END) / SUM ([total_amount_no_discount])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Company&quot; THEN SUM(IF ([vertical] = &quot;Restaurant&quot; OR [vertical] = &quot;Coffee&quot;) then [discount_company] END) / SUM ([discount_company])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Other&quot; THEN SUM(IF ([vertical] = &quot;Restaurant&quot; OR [vertical] = &quot;Coffee&quot;) then [discount_third] END) / SUM ([discount_third]) &#13;&#10;END' />
