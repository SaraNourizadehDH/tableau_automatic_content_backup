      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_0809577691AF4275BE067C06592EEEC8'>
            <properties context=''>
              <relation connection='bigquery.0xfrqly1sle62s1gbvda901w8542' name='Consulta SQL personalizada' type='text'>SELECT &#13;
    FORMAT_DATETIME(&apos;%F %T&apos;,DATETIME(st.messageTimestamp,dim_country.timezone)) as create_date,&#13;
    st.data.vendorId as vendorId,&#13;
    dim_partner.partner_name as partner_name,&#13;
    dim_partner.partner_status as partner_status,&#13;
    dim_partner.country.country_name,&#13;
    dim_partner.city.name as city_name,&#13;
    dim_partner.account_owner as account_owner,&#13;
    st.data.reason as reason,&#13;
    st.data.status as status,&#13;
    st.data.notes as notes,&#13;
    dim_partner.business_type.business_type_name as vertical ,&#13;
&#13;
FROM `peya-data-origins-pro.raw_core.stream_rr_vendor_status_change` st&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner ON dim_partner.partner_id = st.data.vendorId&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS dim_country ON dim_country.country_id = dim_partner.country_id&#13;
WHERE (DATE(st._partitiontime) &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 2 day))&#13;
AND UPPER(dim_partner.partner_status) = &quot;ON_LINE&quot;&#13;
QUALIFY ROW_NUMBER() OVER (PARTITION BY st.data.vendorId ORDER BY st.messageTimestamp DESC) = 1&#13;
/*AND st.data.reason IS NOT NULL&#13;
AND UPPER(st.data.reason) NOT IN (&quot;OUTSIDE_WORKING_HOURS&quot;,&quot;NOT_ONLINE_STATE&quot;)*/&#13;
ORDER BY st.data.status DESC</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
