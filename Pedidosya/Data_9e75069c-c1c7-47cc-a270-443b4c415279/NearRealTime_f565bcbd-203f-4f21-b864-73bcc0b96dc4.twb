&#13;
  FROM peya-data-origins-pro.raw_core.stream_rr_order_service_updates as o &#13;
  LEFT JOIN UNNEST (o.data.details) d&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc on o.data.country = dc.country_short_name&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce ON dce.currency_id = dc.currency_id &#13;
                                                                AND DATE(dce.currency_exchange_date) &#13;
                                                                    = DATE_TRUNC(DATE(DATETIME(o.data.registered_date, dc.timezone)), MONTH)&#13;
  &#13;
  WHERE DATE(DATETIME(o.data.registered_date, dc.timezone)) = DATE(CURRENT_DATE(dc.timezone))&#13;
