        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0xfrqly1sle62s1gbvda901w8542' name='Consulta SQL personalizada' type='text'>SELECT &#13;
    FORMAT_DATETIME(&apos;%F %T&apos;,DATETIME(st.messageTimestamp,dim_country.timezone)) as create_date,&#13;
    st.data.vendorId as vendorId,&#13;
