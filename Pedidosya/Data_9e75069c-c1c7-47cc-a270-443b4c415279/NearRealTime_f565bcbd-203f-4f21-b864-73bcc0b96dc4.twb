    <worksheet name='Forecast'>
      <table>
        <view>
          <datasources>
            <datasource caption='NRT_data' name='federated.1r4cosv1u3tnfh191ynaj1suy0xs' />
          </datasources>
          <datasource-dependencies datasource='federated.1r4cosv1u3tnfh191ynaj1suy0xs'>
            <column caption='Max Hour Today' datatype='integer' name='[Calculation_829788291929505795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name] : MAX( IF [date_days_filter] = &quot;CURRENT DATE&quot; THEN [hora] END) }' />
            </column>
            <column caption='Formula Proyeccion' datatype='real' name='[Fixed Confirmed Orders LD (copy)_829788291921244162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(ROUND(SUM(([Qty Orders (copy)_829788291919757313])) * (1 + [Qty Orders -N Days (copy)_829788291918618624]),0))' />
            </column>
            <column caption='Fixed Confirmed Orders LD' datatype='integer' name='[Qty Orders (copy)_829788291919757313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name] : SUM(IF date_days_filter = &quot;-1 DAYS&quot; AND state = &quot;CONFIRMED&quot; THEN [order_id] END)}' />
            </column>
            <column caption='Orders vs LD (Formula)' datatype='real' name='[Qty Orders -N Days (copy)_829788291918618624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [date_days_filter] = &quot;CURRENT DATE&quot; AND [state] = &quot;CONFIRMED&quot; AND hora &lt;= [Calculation_829788291929505795] then [order_id] ELSE NULL  END) &#13;&#10;- &#13;&#10;SUM(IF [date_days_filter] = &quot;-1 DAYS&quot; AND [state] = &quot;CONFIRMED&quot; AND hora &lt;= [Calculation_829788291929505795] then [order_id] ELSE NULL  END)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF [date_days_filter] = &quot;-1 DAYS&quot; AND [state] = &quot;CONFIRMED&quot; AND hora &lt;= [Calculation_829788291929505795] then [order_id] ELSE NULL  END)' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[date_days_filter]' role='dimension' type='nominal' />
            <column datatype='datetime' datatype-customized='true' name='[fecha]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[hora]' role='dimension' type='ordinal' />
            <column-instance column='[fecha]' derivation='MDY' name='[md:fecha:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[order_id]' role='measure' type='quantitative' />
            <column datatype='string' name='[state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Fixed Confirmed Orders LD (copy)_829788291921244162]' derivation='User' name='[usr:Fixed Confirmed Orders LD (copy)_829788291921244162:qk]' pivot='key' type='quantitative' />
