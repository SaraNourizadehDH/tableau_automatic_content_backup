      <datasource-dependencies datasource='Parameters'>
        <column caption='Metrica' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
          <calculation class='tableau' formula='&quot;Orders&quot;' />
        </column>
        <column caption='Vs N Days' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vs -1 Days&quot;'>
          <calculation class='tableau' formula='&quot;Vs -1 Days&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_E3A990A2C14E4AC4B14C3910ABF59746'>
            <properties context=''>
              <relation connection='bigquery.0i5feo91a0f822188x8q805ob6l0' name='Consulta SQL personalizada' type='text'>WITH data_discounts_orders_service AS (&#13;
&#13;
  SELECT&#13;
        o.id AS order_id,&#13;
        sum(disc.amount/dce.rate_eu) AS discount_amount,&#13;
        sum(case when paid_by=&apos;COMPANY&apos; then disc.amount/dce.rate_eu end) as discount_company,&#13;
        sum(case when paid_by!=&apos;COMPANY&apos; then disc.amount/dce.rate_eu end) as discount_third,&#13;
        count(distinct case when disc.type=&apos;VOUCHER&apos; then o.id end) as order_voucher,&#13;
        count(distinct case when disc.type=&apos;SUBSIDIZED&apos; then o.id end) as order_subsidized,&#13;
&#13;
  FROM `peya-data-origins-pro.cl_core.orders_service` as o &#13;
  LEFT JOIN UNNEST (o.discounts) disc&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc on o.country = dc.country_short_name&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce ON dce.currency_id = dc.currency_id &#13;
                                                              AND DATE(dce.currency_exchange_date) = DATE_TRUNC(DATE(o.registered_date), MONTH) &#13;
  WHERE &#13;
        (date(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 1 day) or &#13;
         date(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 7 day) or &#13;
         date(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 28 day))&#13;
  GROUP BY ALL&#13;
&#13;
), data_discounts_orders_stream AS (&#13;
&#13;
  SELECT&#13;
        o.data.id AS order_id,&#13;
        sum(disc.amount/dce.rate_eu) AS discount_amount,&#13;
        sum(case when paid_by=&apos;COMPANY&apos; then disc.amount/dce.rate_eu end) as discount_company,&#13;
        sum(case when paid_by!=&apos;COMPANY&apos; then disc.amount/dce.rate_eu end) as discount_third,&#13;
        count(distinct case when disc.type=&apos;VOUCHER&apos; then o.data.id end) as order_voucher,&#13;
        count(distinct case when disc.type=&apos;SUBSIDIZED&apos; then o.data.id end) as order_subsidized,&#13;
&#13;
  FROM peya-data-origins-pro.raw_core.stream_rr_order_service_updates as o &#13;
  LEFT JOIN UNNEST (o.data.discounts) disc&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc on o.data.country = dc.country_short_name&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce ON dce.currency_id = dc.currency_id &#13;
                                                                AND DATE(dce.currency_exchange_date) &#13;
                                                                    = DATE_TRUNC(DATE(DATETIME(o.data.registered_date, dc.timezone)), MONTH)&#13;
  &#13;
  WHERE DATE(DATETIME(o.data.registered_date, dc.timezone)) = DATE(CURRENT_DATE(dc.timezone))&#13;
  AND DATE(_PARTITIONTIME) &gt;&gt;= DATE_SUB(DATE(CURRENT_DATE()), INTERVAL 1 DAY)&#13;
  GROUP BY ALL&#13;
&#13;
), data_discounts_orders_stream_details AS (&#13;
&#13;
  SELECT&#13;
        o.data.id AS order_id,&#13;
        sum(d.total/dce.rate_eu) AS total_amount,&#13;
&#13;
  FROM peya-data-origins-pro.raw_core.stream_rr_order_service_updates as o &#13;
  LEFT JOIN UNNEST (o.data.details) d&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc on o.data.country = dc.country_short_name&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce ON dce.currency_id = dc.currency_id &#13;
                                                                AND DATE(dce.currency_exchange_date) &#13;
                                                                    = DATE_TRUNC(DATE(DATETIME(o.data.registered_date, dc.timezone)), MONTH)&#13;
  &#13;
  WHERE DATE(DATETIME(o.data.registered_date, dc.timezone)) = DATE(CURRENT_DATE(dc.timezone))&#13;
  AND DATE(_PARTITIONTIME) &gt;&gt;= DATE_SUB(DATE(CURRENT_DATE()), INTERVAL 1 DAY)&#13;
  GROUP BY ALL&#13;
&#13;
)&#13;
, data_raw_max_timestamp AS (&#13;
&#13;
  SELECT&#13;
      o.data.id order_id,&#13;
      MAX(messageTimestamp) AS max_messageTimestamp&#13;
  FROM peya-data-origins-pro.raw_core.stream_rr_order_service_updates as o&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc on o.data.country = dc.country_short_name&#13;
  WHERE DATE(DATETIME(o.data.registered_date, dc.timezone)) = DATE(CURRENT_DATE(dc.timezone))&#13;
  AND DATE(_PARTITIONTIME) &gt;&gt;= DATE_SUB(DATE(CURRENT_DATE()), INTERVAL 1 DAY)&#13;
  GROUP BY ALL&#13;
&#13;
)&#13;
&#13;
SELECT &#13;
      DATE(o.registered_date) fecha,&#13;
      extract(hour from o.registered_date) hora,&#13;
      city.name ciudad,&#13;
      dc.country_name,&#13;
      p.business_type.business_type_name as vertical,&#13;
      p.is_darkstore,&#13;
      p.account_owner,&#13;
      o.payment.method.online as is_online_payment,&#13;
      DATETIME(MAX(o.registered_date)) AS max_date,&#13;
      o.delivery.type,&#13;
      o.is_pickup,&#13;
      o.is_preorder,&#13;
      CASE WHEN disc.discount_amount &gt;&gt; 0 THEN 1 else 0 END has_discount,&#13;
      state,&#13;
      p.partner_id as partner_id,&#13;
      p.partner_name as partner,&#13;
      CASE WHEN p.franchise.franchise_name IS NULL THEN p.partner_name ELSE p.franchise.franchise_name END franchise_name,&#13;
      o.state_info.reject_message.global_code,&#13;
      o.state_info.reject_message.name reject_message,&#13;
      CASE&#13;
            WHEN o.state_info.reject_message.default_owner = &quot;TRANSPORT&quot; THEN &quot;Rider&quot;&#13;
            WHEN o.state_info.reject_message.default_owner = &quot;VENDOR&quot; THEN &quot;Vendor&quot;&#13;
            WHEN o.state_info.reject_message.default_owner = &quot;CUSTOMER&quot; THEN &quot;User&quot;&#13;
            WHEN o.state_info.reject_message.default_owner = &quot;PLATFORM&quot; THEN &quot;PedidosYa&quot;&#13;
          END as reject_owner,&#13;
      dpm.payment_method_name,&#13;
&#13;
      SUM(disc.discount_amount) discount_amount,&#13;
      SUM(disc.discount_company) as discount_company,&#13;
      SUM(disc.discount_third) as discount_third,&#13;
      COUNT(distinct case when order_voucher = 1 then o.id end) as order_voucher,&#13;
      COUNT(distinct case when order_subsidized = 1 then o.id end) as order_subsidized,&#13;
      SUM(total_amount_no_discount/dce.rate_eu) total_amount_no_discount,&#13;
      COUNT(distinct  o.id) order_id,&#13;
      CASE WHEN DATE(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 1 day) then &quot;-1 DAYS&quot; &#13;
          WHEN DATE(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 7 day) then &quot;-7 DAYS&quot; &#13;
          WHEN DATE(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 28 day) then &quot;-28 DAYS&quot; ELSE &quot;CURRENT DATE&quot; END date_days_filter&#13;
&#13;
FROM `peya-data-origins-pro.cl_core.orders_service` as o &#13;
LEFT JOIN data_discounts_orders_service AS disc ON disc.order_id = o.id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner`as p on p.partner_id = o.vendor.id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc on o.country = dc.country_short_name&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_payment_method` dpm ON o.payment.method.id = dpm.payment_method_id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce ON dce.currency_id = dc.currency_id &#13;
                                                                AND DATE(dce.currency_exchange_date) = DATE_TRUNC(DATE(o.registered_date), MONTH)&#13;
&#13;
WHERE &#13;
       (&#13;
       date(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 1 day) or &#13;
       date(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 7 day) or &#13;
       date(o.registered_date) = date_add(current_date(&quot;America/Montevideo&quot;),interval - 28 day)&#13;
       )&#13;
GROUP BY ALL&#13;
&#13;
UNION ALL&#13;
&#13;
SELECT&#13;
    DATE(DATETIME(o.data.registered_date, dc.timezone)) fecha,&#13;
    extract(hour from DATETIME(o.data.registered_date, dc.timezone)) hora,&#13;
    city.name ciudad,&#13;
    dc.country_name,&#13;
    p.business_type.business_type_name as vertical,&#13;
    p.is_darkstore,&#13;
    p.account_owner,&#13;
    o.data.payment.method.online as is_online_payment,&#13;
    MAX(DATETIME(o.data.registered_date, dc.timezone)) AS max_date,&#13;
        o.data.delivery.type,&#13;
    o.data.is_pickup,&#13;
    o.data.is_preorder,&#13;
    CASE WHEN disc.discount_amount &gt;&gt; 0 THEN 1 else 0 END has_discount,&#13;
    data.state,&#13;
    p.partner_id as partner_id,&#13;
    p.partner_name as partner,&#13;
    CASE WHEN p.franchise.franchise_name IS NULL THEN p.partner_name ELSE p.franchise.franchise_name END franchise_name,&#13;
    o.data.state_info.reject_message.global_code,&#13;
    o.data.state_info.reject_message.name reject_message,&#13;
    CASE&#13;
          WHEN o.data.state_info.reject_message.default_owner = &quot;TRANSPORT&quot; THEN &quot;Rider&quot;&#13;
          WHEN o.data.state_info.reject_message.default_owner = &quot;VENDOR&quot; THEN &quot;Vendor&quot;&#13;
          WHEN o.data.state_info.reject_message.default_owner = &quot;CUSTOMER&quot; THEN &quot;User&quot;&#13;
          WHEN o.data.state_info.reject_message.default_owner = &quot;PLATFORM&quot; THEN &quot;PedidosYa&quot;&#13;
        END as reject_owner,&#13;
    dpm.payment_method_name,&#13;
    &#13;
    SUM(disc.discount_amount) discount_amount,&#13;
    SUM(disc.discount_company) as discount_company,&#13;
    SUM(disc.discount_third) as discount_third,&#13;
    COUNT(distinct case when order_voucher = 1 then o.data.id end) as order_voucher,&#13;
    COUNT(distinct case when order_subsidized = 1 then o.data.id end) as order_subsidized,&#13;
    SUM(d.total_amount/dce.rate_eu) total_amount_no_discount,&#13;
    COUNT(distinct  o.data.id) order_id,&#13;
    &quot;CURRENT DATE&quot; AS date_days_filter&#13;
&#13;
from peya-data-origins-pro.raw_core.stream_rr_order_service_updates as o&#13;
INNER JOIN data_raw_max_timestamp AS max_order ON max_order.order_id = o.data.id AND max_order.max_messageTimestamp = o.messageTimestamp&#13;
LEFT JOIN data_discounts_orders_stream AS disc ON disc.order_id = o.data.id&#13;
LEFT JOIN data_discounts_orders_stream_details AS d ON d.order_id = o.data.id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner`as p on p.partner_id = o.data.vendor.id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` as dc on o.data.country = dc.country_short_name&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_payment_method` dpm ON o.data.payment.method.id = dpm.payment_method_id&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` dce ON dce.currency_id = dc.currency_id &#13;
                                                                AND DATE(dce.currency_exchange_date) &#13;
                                                                    = DATE_TRUNC(DATE(DATETIME(o.data.registered_date, dc.timezone)), MONTH)&#13;
WHERE DATE(DATETIME(o.data.registered_date, dc.timezone)) = DATE(CURRENT_DATE(dc.timezone))&#13;
AND DATE(_PARTITIONTIME) &gt;&gt;= DATE_SUB(DATE(CURRENT_DATE()), INTERVAL 1 DAY)&#13;
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
