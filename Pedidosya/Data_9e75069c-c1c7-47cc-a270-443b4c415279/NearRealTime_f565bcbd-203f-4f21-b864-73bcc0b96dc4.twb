      <table>
        <view>
          <datasources>
            <datasource caption='NRT_data' name='federated.1r4cosv1u3tnfh191ynaj1suy0xs' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metrica' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='Vs N Days' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vs -1 Days&quot;'>
              <calculation class='tableau' formula='&quot;Vs -1 Days&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r4cosv1u3tnfh191ynaj1suy0xs'>
            <column caption='Diff General N' datatype='real' name='[Calculation_910571605005942789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([General KPI N (copia)_892275731513737241]/[General KPI (copia)_892275731511406615]) -1' />
            </column>
            <column caption='General KPI N' datatype='real' name='[General KPI (copia)_892275731511406615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parámetro 1] = &quot;Orders&quot; THEN [Qty Orders (copia)_892275731480326164] &#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Amount&quot; THEN [Qty Orders -N Days (copia)_910571605007077382]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Company&quot; THEN [Qty Orders -N Days (copia)_910571605007704072]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Other&quot; THEN [Qty Orders -N Days (copia)_910571605008183306] END' />
            </column>
            <column caption='General KPI Current Date' datatype='real' name='[General KPI N (copia)_892275731513737241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parámetro 1] = &quot;Orders&quot; THEN [Qty Orders -N Days (copia)_892275731513413656] &#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Amount&quot; THEN [Qty Orders Current Day (copia)_910571605007261703]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Company&quot; THEN [Qty Orders Current Day (copia)_910571605007704073]&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Other&quot; THEN [Qty Orders Current Day (copia)_910571605008183307] END' />
            </column>
            <column caption='Qty Orders -N Days' datatype='integer' name='[Qty Orders (copia)_892275731480326164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Vs -1 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-1 DAYS&quot; then [order_id] ELSE NULL  END) &#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -7 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-7 DAYS&quot; then [order_id] ELSE NULL  END)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -28 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-28 DAYS&quot; then [order_id] ELSE NULL  END)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Qty Orders Current Day' datatype='integer' name='[Qty Orders -N Days (copia)_892275731513413656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date_days_filter] = &quot;CURRENT DATE&quot; then [order_id] ELSE NULL END)' />
            </column>
            <column caption='Amount -N Days' datatype='real' name='[Qty Orders -N Days (copia)_910571605007077382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Vs -1 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-1 DAYS&quot; then [total_amount_no_discount] ELSE NULL  END) &#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -7 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-7 DAYS&quot; then [total_amount_no_discount] ELSE NULL  END)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -28 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-28 DAYS&quot; then [total_amount_no_discount] ELSE NULL  END)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Disc Paid by Comp -N Days' datatype='real' name='[Qty Orders -N Days (copia)_910571605007704072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Vs -1 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-1 DAYS&quot; then [discount_company] ELSE NULL  END) &#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -7 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-7 DAYS&quot; then [discount_company] ELSE NULL  END)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -28 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-28 DAYS&quot; then [discount_company] ELSE NULL  END)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Disc Paid by Third  -N Days' datatype='real' name='[Qty Orders -N Days (copia)_910571605008183306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Vs -1 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-1 DAYS&quot; then [discount_third] ELSE NULL  END) &#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -7 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-7 DAYS&quot; then [discount_third] ELSE NULL  END)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -28 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-28 DAYS&quot; then [discount_third] ELSE NULL  END)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Amount Current Day' datatype='real' name='[Qty Orders Current Day (copia)_910571605007261703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date_days_filter] = &quot;CURRENT DATE&quot; then [total_amount_no_discount] ELSE NULL END)' />
            </column>
            <column caption='Disc Paid by Comp Current Day' datatype='real' name='[Qty Orders Current Day (copia)_910571605007704073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date_days_filter] = &quot;CURRENT DATE&quot; then [discount_company] ELSE NULL END)' />
            </column>
            <column caption='Disc Paid by Third Current Day' datatype='real' name='[Qty Orders Current Day (copia)_910571605008183307]' role='measure' type='quantitative'>
