          <datasource-dependencies datasource='Parameters'>
            <column caption='Metrica' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r4cosv1u3tnfh191ynaj1suy0xs'>
            <column caption='Fail Rate Parameter PEYA' datatype='real' default-format='p0.00%' name='[Fail Rate Parameter (copia)_532550712297832450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Orders&quot;                        THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;PedidosYa&quot;) then [order_id] END) / SUM ([order_id])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Amount&quot;                   THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;PedidosYa&quot;) then [total_amount_no_discount] END) / SUM ([total_amount_no_discount])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Company&quot; THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;PedidosYa&quot;) then [discount_company] END)        / SUM ([discount_company])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Other&quot;   THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;PedidosYa&quot;) then [discount_third] END)  / SUM ([discount_third]) &#13;&#10;END' />
            </column>
            <column datatype='string' name='[ciudad]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[discount_company]' role='measure' type='quantitative' />
            <column datatype='real' name='[discount_third]' role='measure' type='quantitative' />
            <column datatype='datetime' datatype-customized='true' name='[fecha]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_code]' role='dimension' type='nominal' />
