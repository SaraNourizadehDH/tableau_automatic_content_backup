    st.data.status as status,&#13;
    st.data.notes as notes,&#13;
    dim_partner.business_type.business_type_name as vertical ,&#13;
&#13;
FROM `peya-data-origins-pro.raw_core.stream_rr_vendor_status_change` st&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner ON dim_partner.partner_id = st.data.vendorId&#13;
