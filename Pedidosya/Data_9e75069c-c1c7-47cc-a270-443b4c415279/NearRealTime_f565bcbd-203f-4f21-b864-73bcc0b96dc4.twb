              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Orders&quot;                        THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;User&quot;) then [order_id] END) / SUM ([order_id])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Amount&quot;                   THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;User&quot;) then [total_amount_no_discount] END) / SUM ([total_amount_no_discount])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Company&quot; THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;User&quot;) then [discount_company] END)        / SUM ([discount_company])&#13;&#10;ELSEIF  [Parameters].[Parámetro 1] = &quot;Discount Paid by Other&quot;   THEN SUM(IF ([state] = &quot;REJECTED&quot; AND [reject_owner] = &quot;User&quot;) then [discount_third] END)  / SUM ([discount_third]) &#13;&#10;END' />
