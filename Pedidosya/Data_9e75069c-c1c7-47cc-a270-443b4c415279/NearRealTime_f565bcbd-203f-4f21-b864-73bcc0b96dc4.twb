            </column>
            <column caption='Qty Orders -N Days' datatype='integer' name='[Qty Orders (copia)_892275731480326164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Vs -1 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-1 DAYS&quot; then [order_id] ELSE NULL  END) &#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -7 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-7 DAYS&quot; then [order_id] ELSE NULL  END)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parámetro 2] = &quot;Vs -28 Days&quot; THEN&#13;&#10;SUM(IF [date_days_filter] = &quot;-28 DAYS&quot; then [order_id] ELSE NULL  END)&#13;&#10;&#13;&#10;END' />
