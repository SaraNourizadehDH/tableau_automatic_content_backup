      <column caption='TOTAL city' datatype='integer' name='[Calculation_1183320863053787136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(COUNTD([city_name]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='cf_user' datatype='integer' name='[Calculation_1183320863054127105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1183320863053787136] &lt;= 5 THEN&#13;&#10;SUM([users])&#13;&#10;ELSE &#13;&#10;SUM({ FIXED [country_name], [date_month] : MAX([users_by_country])})&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_183521743989342208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / [Calculation_1183320863054127105]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Order Share' datatype='real' name='[Calculation_183521743989563393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(orders)/SUM(orders_total)' />
      </column>
      <column caption='User Share' datatype='real' name='[Calculation_183521743989932034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1183320863054127105]/ [cf_user (copy)_1183320863062499330]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Partner Share' datatype='real' name='[Calculation_183521743990059011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(partners) / SUM(partners_total)' />
      </column>
      <column caption='Basket Size' datatype='real' name='[Calculation_183521743990214660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(units) / SUM(orders)' />
      </column>
      <column caption='Basket Size - Total' datatype='real' name='[Calculation_183521743990288389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([units_total])/SUM([orders])' />
      </column>
      <column caption='AVG discount item' datatype='real' name='[Calculation_183521743990566918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(price_paid_with_discount) / SUM(price_unit)' />
      </column>
      <column caption='AFV (EUR)' datatype='real' name='[Calculation_183521743990812679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_eur]) / SUM([orders])' />
      </column>
      <column caption='AFV (EUR) - Total' datatype='real' name='[Calculation_183521743991255048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_eur_total]) / SUM([orders])' />
      </column>
      <column caption='Delivery Fee (EUR)' datatype='real' name='[Calculation_183521743993561097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee]) / SUM([orders])' />
      </column>
      <column caption='UC / AFV - Total' datatype='real' name='[Calculation_183521743998992394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([service_fee] + [delivery_fee])) / sum([gfv_eur_total])' />
      </column>
      <column caption='CTR Banner' datatype='real' name='[Calculation_183521744000036875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(Count_Clicked) / sum(Count_Shown)' />
      </column>
      <column caption='CVR Banner' datatype='real' name='[Calculation_183521744000516108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_coming_from_banner]) / sum(Sum_Last_Clicked)' />
      </column>
      <column caption='% of Total Acquisitions' datatype='real' name='[Calculation_183521744000778253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acq]) / sum([acq_total])' />
      </column>
      <column caption='% Orders Coming From Banner' datatype='real' name='[Calculation_183521744000974862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_coming_from_banner]) / SUM([orders])' />
      </column>
