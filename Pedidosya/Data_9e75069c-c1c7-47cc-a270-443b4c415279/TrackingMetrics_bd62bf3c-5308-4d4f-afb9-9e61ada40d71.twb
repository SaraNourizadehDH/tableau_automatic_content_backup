            <column caption='calc Rains (mm)' datatype='real' default-format='N' name='[calc Qty Rains (copy)_698339445421305858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_mm])' />
            </column>
            <column caption='calc Share Orders Cash' datatype='real' default-format='p0.00%' name='[calc Qty Rains (copy)_698339445421400067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_pay_with_cash]) / [Calculation_726486942988603392]' />
