              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN SUM([active_customers])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN &#13;&#10;&#13;&#10;    IF [Fixed city (copy) (copy)_202380540213030915] THEN&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;week&apos;,[date_day],&apos;monday&apos;), [country_name], [city_name] : MAX([active_customers_week_by_city])})&#13;&#10;    ELSE&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;week&apos;,[date_day],&apos;monday&apos;), [country_name] : MAX([active_customers_week_by_country])})&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN &#13;&#10;&#13;&#10;    IF [Fixed city (copy) (copy)_202380540213030915] THEN&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;month&apos;,[date_day]), [country_name], [city_name] : MAX([active_customers_month_by_city])})&#13;&#10;    ELSE&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;month&apos;,[date_day]), [country_name] : MAX([active_customers_month_by_country])})&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE SUM(0) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
