            <column caption='calc Share Orders Seamless' datatype='real' default-format='p0.00%' name='[calc Share Orders Cash (copy)_1598496425137963008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders_seamless]) / SUM([total_orders_logistic_seamless])' />
