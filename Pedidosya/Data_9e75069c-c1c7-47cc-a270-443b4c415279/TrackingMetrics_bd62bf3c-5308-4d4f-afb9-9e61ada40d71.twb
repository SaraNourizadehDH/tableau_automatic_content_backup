            <column caption='calc Confirmed Orders Avg Daily - Fixed' datatype='real' name='[Calculation_1117455688190418944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [date_day], [country_name] : SUM([qty_confirmed_orders]) })' />
