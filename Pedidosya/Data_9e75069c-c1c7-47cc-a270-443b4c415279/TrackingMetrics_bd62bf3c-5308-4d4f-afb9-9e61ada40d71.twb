              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Confirmed Orders&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Sessions&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;CVR&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mcvr1&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mcvr2&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mcvr3&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Mcvr4&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;New Customers&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Frequency&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Active Customers&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Qty Rains&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Rains (mm)&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Share Orders Cash&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Food Orders&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;LS Orders&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Dmart Orders&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Plus Orders&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Share Plus&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Orders w Subs&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Orders w Vouchers&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Orders w DFO&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Organic Orders&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Orders w DTO Plus&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Users Plus&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Frequency Plus&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Fail Rate&quot; THEN &quot;%&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Riders Working Hours&quot; THEN &quot;&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Share Orders Seamless&quot; THEN &quot;%&quot;&#13;&#10;ELSE &quot;&quot; END' />
            </column>
            <column caption='calc Riders Working Hours' datatype='real' name='[calc LS Orders (copy)_94857097451769872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([worked_seconds]) / 3600' />
            </column>
            <column caption='calc Active Customers' datatype='integer' name='[calc New Customers (copy)_726486942990372872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN SUM([active_customers])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN &#13;&#10;&#13;&#10;    IF [Fixed city (copy) (copy)_202380540213030915] THEN&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;week&apos;,[date_day],&apos;monday&apos;), [country_name], [city_name] : MAX([active_customers_week_by_city])})&#13;&#10;    ELSE&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;week&apos;,[date_day],&apos;monday&apos;), [country_name] : MAX([active_customers_week_by_country])})&#13;&#10;    END&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN &#13;&#10;&#13;&#10;    IF [Fixed city (copy) (copy)_202380540213030915] THEN&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;month&apos;,[date_day]), [country_name], [city_name] : MAX([active_customers_month_by_city])})&#13;&#10;    ELSE&#13;&#10;        SUM({ FIXED DATETRUNC(&apos;month&apos;,[date_day]), [country_name] : MAX([active_customers_month_by_country])})&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE SUM(0) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='calc Orders w DTO Plus' datatype='integer' name='[calc Orders Organic (copy)_94857097450348555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_plus_w_discount])' />
