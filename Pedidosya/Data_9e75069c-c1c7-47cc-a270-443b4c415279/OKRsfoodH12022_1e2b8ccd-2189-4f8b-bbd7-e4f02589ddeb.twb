              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oiuemu1q0dgyw18885ml028xl7h'>
            <column caption='Rollout Mark Up' datatype='real' name='[Calculation_288793346262339585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [month_year],[country_id]:SUM([Rollout_status])/COUNTD([country_id])}' />
            </column>
            <column caption='Rollout status' datatype='integer' name='[Rollout_status]' role='measure' type='quantitative' />
            <column caption='Country Id' datatype='integer' name='[country_id]' role='dimension' type='ordinal' />
            <column caption='Month Year' datatype='date' name='[month_year]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tnu3yh1y66ifd15cr9px0814s67'>
            <column datatype='integer' name='[CVR2_den]' role='measure' type='quantitative' />
            <column datatype='integer' name='[CVR2_num]' role='measure' type='quantitative' />
            <column caption='Vendor Fail rate (%).' datatype='real' name='[Calculation_1130122036525203461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fail_rate_num])/sum([fail_rate_den])' />
            </column>
            <column caption='Vendor late &gt; 10&apos; (%)' datatype='real' name='[Calculation_1130122036526809095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_10])/sum([vendor_late_base])' />
            </column>
            <column caption='CVR2' datatype='real' name='[Calculation_1219912559795642368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([CVR2_num])/sum([CVR2_den])' />
            </column>
            <column caption='KPI Food target label %' datatype='real' name='[Calculation_1245808260119916549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;17&apos; THEN MAX([Calculation_187743818034794509])&#13;&#10;WHEN &apos;8&apos; THEN MAX([Calculation_187743818035720206])&#13;&#10;WHEN &apos;9&apos; THEN MAX([Calculation_187743818036072463])&#13;&#10;WHEN &apos;2&apos; THEN MAX ([Calculation_187743818014003205])&#13;&#10;WHEN &apos;18&apos; THEN MAX([Calculation_129760032291299328])&#13;&#10;WHEN &apos;19&apos; THEN MAX([Calculation_129760032291586049])&#13;&#10;WHEN &apos;25&apos; THEN MAX([Calculation_288793346954506255])&#13;&#10;WHEN &apos;26&apos; THEN MAX([Calculation_288793346954706960])&#13;&#10;WHEN &apos;27&apos; THEN MAX([Calculation_288793346954895377])&#13;&#10;WHEN &apos;28&apos; THEN MAX([Calculation_288793346955075602])&#13;&#10;WHEN &apos;21&apos; THEN MAX ([Calculation_446700807166951429])&#13;&#10;WHEN &apos;22&apos; THEN MAX([Calculation_446700807167266822])&#13;&#10;WHEN &apos;31&apos; THEN MAX([Calculation_288793346277294082])&#13;&#10;WHEN &apos;32&apos; THEN MAX([Calculation_288793346277613571])&#13;&#10;WHEN &apos;23&apos; THEN MAX([Calculation_446700807167524871])&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='KPI Food target label int' datatype='real' name='[Calculation_1245808260122337286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;3&apos; THEN MAX([Calculation_187743818015924230])&#13;&#10;WHEN &apos;20&apos; THEN MAX([Calculation_129760032292208642])&#13;&#10;WHEN &apos;24&apos; THEN MAX ([Calculation_446700807167782920])&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Target mCVR3' datatype='real' name='[Calculation_129760032291299328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.50' />
            </column>
            <column caption='Target DLP Coverage' datatype='real' name='[Calculation_129760032291586049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.6' />
            </column>
            <column caption='Target NCR Ads' datatype='integer' name='[Calculation_129760032292208642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='11700000' />
            </column>
            <column caption='% Pick up Orders' datatype='real' name='[Calculation_1364590755141746688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_pick_up])/sum([confirmed_orders])' />
            </column>
            <column caption='mCVR3' datatype='real' name='[Calculation_1364590755143434241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mCVR3_num])/sum([mCVR3_den])' />
            </column>
            <column caption='Dish Level Photo Coverage' datatype='real' name='[Calculation_1364590755143806978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_images])/sum([total_products])' />
            </column>
            <column caption='NCR Ads' datatype='real' name='[Calculation_1364590755145498627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_gold_vip]+[total_gold_vip_category]+&#13;&#10;[total_featured_products]+[total_joker])' />
            </column>
            <column caption='KPIs food' datatype='real' name='[Calculation_187743817982525442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;2&apos; THEN [Calculation_1364590755141746688]&#13;&#10;WHEN &apos;3&apos; THEN SUM([active_partners_with_orders])&#13;&#10;WHEN &apos;8&apos; THEN [Calculation_1130122036525203461]&#13;&#10;WHEN &apos;9&apos; THEN [Calculation_1130122036526809095]&#13;&#10;WHEN &apos;17&apos; THEN [Calculation_1219912559795642368]&#13;&#10;WHEN &apos;18&apos; THEN [Calculation_1364590755143434241]&#13;&#10;WHEN &apos;19&apos; THEN [Calculation_1364590755143806978]&#13;&#10;WHEN &apos;20&apos; THEN [Calculation_1364590755145498627]&#13;&#10;WHEN &apos;25&apos; THEN [Calculation_288793346951495691]&#13;&#10;WHEN &apos;26&apos; THEN [Calculation_288793346952323084]&#13;&#10;WHEN &apos;27&apos; THEN [Calculation_288793346952581133]&#13;&#10;WHEN &apos;28&apos; THEN [Calculation_288793346952810510]&#13;&#10;WHEN &apos;21&apos; THEN [Calculation_446700807160307712]&#13;&#10;WHEN &apos;22&apos; THEN [Calculation_446700807161081857]&#13;&#10;WHEN &apos;31&apos; THEN [Calculation_288793346258305024]&#13;&#10;WHEN &apos;32&apos; THEN SUM([federated.1oiuemu1q0dgyw18885ml028xl7h].[Calculation_288793346262339585])&#13;&#10;WHEN &apos;23&apos; THEN [Calculation_446700807163686914]&#13;&#10;WHEN &apos;24&apos; THEN [Calculation_446700807165091844]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Target pick up orders' datatype='real' name='[Calculation_187743818014003205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.015' />
            </column>
            <column caption='Target active partners' datatype='integer' name='[Calculation_187743818015924230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='115000' />
            </column>
            <column caption='Target CVR2' datatype='real' name='[Calculation_187743818034794509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.369' />
