            <column datatype='integer' name='[CVR2_den]' role='measure' type='quantitative' />
            <column datatype='integer' name='[CVR2_num]' role='measure' type='quantitative' />
            <column caption='blank4' datatype='integer' name='[Calculation_1130122036467634176 1 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='blank5' datatype='integer' name='[Calculation_1130122036467634176 1 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
