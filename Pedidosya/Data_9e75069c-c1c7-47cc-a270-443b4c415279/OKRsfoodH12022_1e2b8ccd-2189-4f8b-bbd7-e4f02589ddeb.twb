            <column caption='blank1' datatype='integer' name='[Calculation_1130122036467634176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Vendor Fail rate (%).' datatype='real' name='[Calculation_1130122036525203461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fail_rate_num])/sum([fail_rate_den])' />
            </column>
            <column caption='Vendor late &gt; 10&apos; (%)' datatype='real' name='[Calculation_1130122036526809095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_10])/sum([vendor_late_base])' />
            </column>
            <column caption='NPS AO' datatype='real' name='[Calculation_1130122036530397193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([NPS_PROMOTERS_AO])-sum([NPS_DETRACTORS_AO]))/sum([NPS_TOTAL_RESPONSES_AO])' />
            </column>
            <column caption='Exclude current month' datatype='boolean' name='[Calculation_121878699820503040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[year_month], Today())  =0' />
            </column>
            <column caption='CVR2' datatype='real' name='[Calculation_1219912559795642368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([CVR2_num])/sum([CVR2_den])' />
            </column>
            <column caption='% Pick up Orders' datatype='real' name='[Calculation_1364590755141746688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_pick_up])/sum([confirmed_orders])' />
            </column>
            <column caption='mCVR3' datatype='real' name='[Calculation_1364590755143434241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([mCVR3_num])/sum([mCVR3_den])' />
            </column>
            <column caption='Dish Level Photo Coverage' datatype='real' name='[Calculation_1364590755143806978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_images])/sum([total_products])' />
            </column>
            <column caption='NCR Ads' datatype='real' name='[Calculation_1364590755145498627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_gold_vip]+[total_gold_vip_category]+&#13;&#10;[total_featured_products]+[total_joker])' />
            </column>
            <column caption='% VDF/ GMV' datatype='real' name='[Calculation_288793346258305024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_amount_euro])/SUM([GMV_Gross_eur])' />
            </column>
            <column caption='NPS Business Improvement' datatype='real' name='[Calculation_288793346951495691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_b]- [detractors_b])/SUM([responses_b])' />
            </column>
            <column caption='NPS Care' datatype='real' name='[Calculation_288793346952323084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_ca]-[detractors_ca])/SUM([responses_ca])' />
            </column>
            <column caption='NPS Management Tools' datatype='real' name='[Calculation_288793346952581133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_m]- [detractors_m])/SUM([responses_m])' />
            </column>
            <column caption='NPS Logistics' datatype='real' name='[Calculation_288793346952810510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_lo]- [detractors_lo])/SUM([responses_lo])' />
            </column>
            <column caption='Concepts CVR3' datatype='real' name='[Calculation_446700807160307712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fact_partner_funnel_sessions_funnel_shop_transaction])/sum([fact_partner_funnel_sessions_funnel_shop_details])' />
            </column>
            <column caption='NPS for returning customers' datatype='real' name='[Calculation_446700807161081857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([NPS_survey_promoters]-[NPS_survey_detractos])/SUM([NPS_survey_responses])' />
            </column>
            <column caption='Retention Rate new customers' datatype='real' name='[Calculation_446700807163686914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users_reordered])/SUM([users_base])' />
            </column>
            <column caption='Avg Commission Revenue eu' datatype='real' name='[Calculation_446700807164866563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission_revenue_LC]/[rate_eu]' />
            </column>
            <column caption='Avg Commission Revenue per order' datatype='real' name='[Calculation_446700807165091844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_446700807164866563])/sum([total_orders])' />
            </column>
            <column caption='%Partners PeYa Plus' datatype='real' name='[Calculation_446700807202758665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plus_partners_subs])/SUM([active_partners_by_month])' />
            </column>
            <column caption='Blank7' datatype='integer' name='[Calculation_446700807203209226]' role='measure' type='quantitative'>
