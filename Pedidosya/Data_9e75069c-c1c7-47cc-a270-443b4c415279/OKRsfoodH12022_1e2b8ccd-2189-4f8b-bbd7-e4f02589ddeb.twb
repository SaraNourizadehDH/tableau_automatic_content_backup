              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
