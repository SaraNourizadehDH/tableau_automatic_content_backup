            <column caption='Target vendor late' datatype='real' name='[Calculation_187743818036072463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.0985' />
            </column>
            <column caption='KPIs food target' datatype='real' name='[Calculation_187743818042478615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;2&apos; THEN [Calculation_187743818014003205]&#13;&#10;WHEN &apos;3&apos; THEN [Calculation_187743818015924230]&#13;&#10;WHEN &apos;8&apos; THEN [Calculation_187743818035720206]&#13;&#10;WHEN &apos;9&apos; THEN [Calculation_187743818036072463]&#13;&#10;WHEN &apos;17&apos; THEN [Calculation_187743818034794509]&#13;&#10;WHEN &apos;18&apos; THEN [Calculation_129760032291299328]&#13;&#10;WHEN &apos;19&apos; THEN [Calculation_129760032291586049]&#13;&#10;WHEN &apos;20&apos; THEN [Calculation_129760032292208642]&#13;&#10;WHEN &apos;25&apos; THEN [Calculation_288793346954506255]&#13;&#10;WHEN &apos;26&apos; THEN [Calculation_288793346954706960]&#13;&#10;WHEN &apos;27&apos; THEN [Calculation_288793346954895377]&#13;&#10;WHEN &apos;28&apos; THEN [Calculation_288793346955075602]&#13;&#10;WHEN &apos;21&apos; THEN [Calculation_446700807166951429]&#13;&#10;WHEN &apos;22&apos; THEN [Calculation_446700807167266822]&#13;&#10;WHEN &apos;31&apos; THEN [Calculation_288793346277294082]&#13;&#10;WHEN &apos;32&apos; THEN [Calculation_288793346277613571]&#13;&#10;WHEN &apos;23&apos; THEN [Calculation_446700807167524871]&#13;&#10;WHEN &apos;24&apos; THEN [Calculation_446700807167782920]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='% VDF/ GMV' datatype='real' name='[Calculation_288793346258305024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_amount_euro])/SUM([GMV_Gross_eur])' />
            </column>
            <column caption='Target vdf/gmv' datatype='real' name='[Calculation_288793346277294082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.032' />
            </column>
            <column caption='Target Markup' datatype='real' name='[Calculation_288793346277613571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.0' />
            </column>
            <column caption='NPS Business Improvement' datatype='real' name='[Calculation_288793346951495691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_b]- [detractors_b])/SUM([responses_b])' />
            </column>
            <column caption='NPS Care' datatype='real' name='[Calculation_288793346952323084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_ca]-[detractors_ca])/SUM([responses_ca])' />
            </column>
            <column caption='NPS Management Tools' datatype='real' name='[Calculation_288793346952581133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_m]- [detractors_m])/SUM([responses_m])' />
            </column>
            <column caption='NPS Logistics' datatype='real' name='[Calculation_288793346952810510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters_lo]- [detractors_lo])/SUM([responses_lo])' />
            </column>
            <column caption='Target NPS Improvement' datatype='real' name='[Calculation_288793346954506255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-0.3150' />
            </column>
            <column caption='Target NPS Care' datatype='real' name='[Calculation_288793346954706960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-0.4630' />
            </column>
            <column caption='Target NPS Management' datatype='real' name='[Calculation_288793346954895377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.1740' />
            </column>
            <column caption='Target NPS Logistics' datatype='real' name='[Calculation_288793346955075602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-0.2160' />
            </column>
            <column caption='Concepts CVR3' datatype='real' name='[Calculation_446700807160307712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fact_partner_funnel_sessions_funnel_shop_transaction])/sum([fact_partner_funnel_sessions_funnel_shop_details])' />
            </column>
            <column caption='NPS for returning customers' datatype='real' name='[Calculation_446700807161081857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([NPS_survey_promoters]-[NPS_survey_detractos])/SUM([NPS_survey_responses])' />
            </column>
            <column caption='Retention Rate new customers' datatype='real' name='[Calculation_446700807163686914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users_reordered])/SUM([users_base])' />
