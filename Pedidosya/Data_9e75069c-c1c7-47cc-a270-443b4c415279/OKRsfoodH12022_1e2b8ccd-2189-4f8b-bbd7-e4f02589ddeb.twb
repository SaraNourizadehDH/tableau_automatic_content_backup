      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Argentina&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Dish Level Photo Coverage' caption='KPIs food' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;19&quot;'>
          <calculation class='tableau' formula='&quot;19&quot;' />
          <aliases>
            <alias key='&quot;17&quot;' value='CVR2' />
            <alias key='&quot;18&quot;' value='mCVR3' />
            <alias key='&quot;19&quot;' value='Dish Level Photo Coverage' />
            <alias key='&quot;2&quot;' value='% Pick up Confirmed Orders' />
            <alias key='&quot;20&quot;' value='NCR Ads' />
            <alias key='&quot;21&quot;' value='Concepts CVR3' />
            <alias key='&quot;22&quot;' value='NPS for returning customers' />
            <alias key='&quot;23&quot;' value='Retention Rate new customers' />
            <alias key='&quot;24&quot;' value='Avg Commission Revenue per order' />
            <alias key='&quot;25&quot;' value='NPS Business Improvement' />
            <alias key='&quot;26&quot;' value='NPS Related to Care' />
            <alias key='&quot;27&quot;' value='NPS Related to Management Tools' />
            <alias key='&quot;28&quot;' value='NPS Related to Logistics' />
            <alias key='&quot;3&quot;' value='Active Partners (+1 order)' />
            <alias key='&quot;31&quot;' value='% VFD/ GMV' />
            <alias key='&quot;32&quot;' value='Rollout Mark Up Action' />
            <alias key='&quot;8&quot;' value='Vendor Fail rate (%)' />
            <alias key='&quot;9&quot;' value='Vendor late &gt; 10&apos; (%)' />
          </aliases>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1oiuemu1q0dgyw18885ml028xl7h'>
        <column caption='Rollout Mark Up' datatype='real' name='[Calculation_288793346262339585]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='{ FIXED [month_year],[country_id]:SUM([Rollout_status])/COUNTD([country_id])}' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Datos migrados' id='Migrated Data'>
            <properties context=''>
              <relation connection='bigquery.1dllm9k09l4mcm15rpmqe1jdv5ua' name='Custom_SQL_Query' type='text'><![CDATA[with food_O1 as(
    Select
        dc.country_id,
        dc.country_name,
        year_month,
        confirmed_orders,
        confirmed_orders_pick_up,
    from `peya-bi-tools-pro.il_core.dim_country` dc
    left join 
    (
        select 
            date_trunc(registered_date, MONTH) as year_month,
            country_id,
            COUNT(DISTINCT CASE WHEN order_status="CONFIRMED" and lower(business_type.business_type_name) in ('coffee','restaurant') THEN order_id ELSE NULL END) AS confirmed_orders,
            COUNT(DISTINCT CASE WHEN order_status="CONFIRMED" and lower(business_type.business_type_name) in ('coffee','restaurant') AND is_take_out=1 THEN order_id ELSE NULL END) AS confirmed_orders_pick_up,
        from peya-bi-tools-pro.il_core.fact_orders 
        where registered_date >>= '2022-01-01'
        group by 1,2
    )fo on fo.country_id = dc.country_id
    where dc.country_id >> 0
),
food_O1_active_partners as (

       WITH orders AS (
    SELECT 
        DATE_TRUNC(o.registered_date,MONTH) as Month
        ,o.restaurant.id AS partner_id
        ,1 as rol
        ,COUNT(DISTINCT CASE WHEN o.order_status IN ('CONFIRMED') THEN o.order_id END) AS Confirmed_Orders

    FROM `peya-bi-tools-pro.il_core.fact_orders` o
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
            ON dc.country_id = o.country_id 
           AND dc.active
      WHERE o.registered_date >>= "2022-01-01"
  	  AND o.registered_date << CURRENT_DATE
   
    GROUP BY 1,2,3
),

summary AS(
SELECT
    ordpar.Month,
    p.partner_id,
    p.country_id,
    CASE WHEN pm.is_active = TRUE AND ordpar.Confirmed_Orders >> 0 THEN TRUE ELSE FALSE END AS Is_Active

    FROM `peya-bi-tools-pro.il_core.fact_partners_monthly` AS pm 
    LEFT JOIN orders AS ordpar ON pm.restaurant_id = ordpar.partner_id AND DATE(DATE_TRUNC(pm.full_date,MONTH)) = ordpar.Month
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS p ON p.partner_id = pm.restaurant_id
   
    WHERE   p.is_darkstore = FALSE 
        AND DATE(pm.full_date) >>= "2022-01-01"
        AND pm.country_id NOT IN (6,5,4,9)
         AND p.business_type.business_type_name NOT IN ('Bills','Courier','Courier Business') )

SELECT 

              month AS registered_date,
              country_id,
              COUNT(DISTINCT partner_id) active_partners_with_orders

              FROM summary
              WHERE Is_Active = TRUE
              GROUP BY 1,2

),
food_O1_concepts_CVR3 AS ( -----VER BIEN
    
    SELECT
    date(DATE_trunc(fpf.date, month)) as year_month,
    dim_partner_funnel.country_id,
    COALESCE(SUM(fpf.funnel_shop_details ), 0) AS fact_partner_funnel_sessions_funnel_shop_details,
    COALESCE(SUM(case when fpf.funnel_shop_details = 1 then fpf.funnel_shop_transaction end ), 0) AS fact_partner_funnel_sessions_funnel_shop_transaction
    
    FROM `peya-bi-tools-pro.il_sessions.fact_partner_funnel` as fpf
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner_funnel ON fpf.partner.partner_id = dim_partner_funnel.partner_id
    WHERE date(fpf.date) >>= "2022-01-01" 
    AND (dim_partner_funnel.is_concept) AND ((dim_partner_funnel.country_id ) >> 0 OR (dim_partner_funnel.country_id) IS NULL)
    and (
    (dim_partner_funnel.country.country_name = "Argentina" and concept.concept_name = 'Viva la Mila') or
    (dim_partner_funnel.country.country_name = "Chile" and concept.concept_name = 'Wing it') or
    (dim_partner_funnel.country.country_name = "Panamá" and concept.concept_name = 'Wing it') or
    (dim_partner_funnel.country.country_name = "República Dominicana" and concept.concept_name = 'Poked') or
    (dim_partner_funnel.country.country_name = "Bolivia" and concept.concept_name = 'Gusto') or
    (dim_partner_funnel.country.country_name = "Uruguay" and concept.concept_name = 'Gusto') or
    (dim_partner_funnel.country.country_name = "Paraguay" and concept.concept_name = 'Gusto')
    )
    group by 1, 2

),

food_O2_NPS_Business_improvement AS (select distinct  mes_respuesta,country_id,count(distinct response_id) responses_b,sum(promoter) promoters_b,sum(Detractor) detractors_b
from (
    --TABLEAU FOOD
       SELECT response_id
              , start_date
              , DATE_TRUNC(DATE(start_date),MONTH) mes_respuesta
              , partner_id
              , nps_type_group
              , nps_type
              , nps_group
              , Promoter
              , Passive
              , Detractor
              , response
              , further_comments
              , case when send_method = 'Email' then 'Email'
                     when send_method = 'email' then 'Email'
                     when send_method = 'Partner Portal' then 'Partner Portal'
                     when send_method = 'si' then 'Partner Portal'
                     when send_method = 'Anonymous' then 'Partner Portal'
                     else send_method end as send_method
              , country_name
              , Reason
              , Sub_reason
              , Sub_sub_reason
              , Journey_step
              , role
              , user_role
              , user_id
              , platformIdentifiers
              , salesforceId
              , restaurant_name
              , AccountSource
              , is_logistic
              , is_important_account
              , Key_Account_Sub_Category
              , is_online
              , is_active
              , state
              , business_type
              , Vertical
              , reception_system
              , registeredDate
              , first_date_online
              , antiquity
              , commission
              , privatePhone
              , publicPhone
              , account_owner
              , user_id_account_owner
              , lead_owner
              , user_id_lead_owner
              , city
              , province
              , area
              , vendor_grade
              ,'FOOD' as business_unit
              ,case when nps_type like "%Existing%" then 'Existing Partners'
                     when nps_type like "%New%" then 'New Partners'
                     else 'CHECK'
                     end as survey_type
              ,case when Reason = 'Servicio de Atención recibido por Chat, Whatsapp Business e Email' then 'FOOD'
                     when Reason = 'Informes y reportes de performance' then 'FOOD'
                     when Reason = 'Partner Portal' then 'FOOD'
                     when Reason = 'Sistemas de recepción de pedidos' then 'FOOD'
                     when Reason = 'Asesoramiento comercial' then 'FOOD'
                     when Reason = 'Marketing y Posicionamiento' then 'FOOD'
                     when Reason = 'Volúmenes de Ordenes / Costos de Asociacion' then 'FOOD'
                     when Reason = 'Servicio de repartos y logística' then 'FOOD'
                     when Reason = 'Facturación y Cobranzas' then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Chapter
              ,case when Reason = 'Servicio de Atención recibido por Chat, Whatsapp Business e Email' then 'CARE'
                     when Reason = 'Informes y reportes de performance' then 'Management tools (RS, VP)'
                     when Reason = 'Partner Portal' then 'Management tools (RS, VP)'
                     when Reason = 'Sistemas de recepción de pedidos' then 'Management tools (RS, VP)'
                     when Reason = 'Asesoramiento comercial' then 'Business Improvement Advising'
                     when Reason = 'Marketing y Posicionamiento' then 'Business Improvement Advising'
                     when Reason = 'Volúmenes de Ordenes / Costos de Asociacion' then 'Business Improvement Advising'
                     when Reason = 'Servicio de repartos y logística' then 'Logistics (and rider interactions)'
                     when Reason = 'Facturación y Cobranzas' then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Sub_Chapter
       FROM (
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
              WHERE nps.nps_type in ('NPS Existing Partners','NPS New Partners')
                            and nps.Vertical = 'FOOD'
              )
        UNION ALL 
        --TABLERO SHOPS
       select response_id
              , start_date
              , DATE_TRUNC(DATE(start_date), MONTH) mes_respuesta
              , partner_id
              , nps_type_group
              , case when nps_type = 'NPS Existing Partners' then 'NPS Existing Partners Shops'
                     when nps_type = 'NPS New Partners' then 'NPS New Partners Shops'
                     else nps_type end as nps_type
              , nps_group
              , Promoter
              , Passive
              , Detractor
              , response
              , further_comments
              , case when send_method = 'Email' then 'Email'
                     when send_method = 'Partner Portal' then 'Partner Portal'
                     when send_method = 'si' then 'Partner Portal'
                     when send_method = 'Anonymous' then 'Partner Portal'
                     else send_method end as send_method
              , country_name
              , case when Reason = 'Asesoramiento comercial' then 'Asesoramiento comercial (asesoría y profesionalismo)'
                     when Reason = 'Facturación y Cobranzas' then 'Facturación y Cobranzas (estado de cuenta, pagos y cobros)'
                     when Reason = 'Informes y reportes de performance' then 'Informes y reportes de performance (calidad y frecuencia)'
                     when Reason = 'Marketing y Posicionamiento' then 'Marketing y Posicionamiento (promociones, campañas, merchandising)'
                     when Reason = 'Partner Portal' then 'Partner Portal (gestión del menú y local, diseño y funcionamiento)'
                     when Reason = 'Servicio de Atención recibido por Chat, Whatsapp Business e Email' then 'Servicio de Atención recibido por Chat, Whatsapp Business e Email'
                     when Reason = 'Servicio de repartos y logística' then 'Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)'
                     when Reason = 'Sistemas de recepción de pedidos' then 'Sistema de recepción de pedidos (funcionalidad y capacitación)'
                     when Reason = 'Volúmenes de Ordenes / Costos de Asociacion' then 'Volúmenes de Ordenes / Costos de Asociacion'
                     else Reason end as Reason
              , case when Sub_reason = 'Alta de promociones y/o descuentos en mi carta ( por ejemplo decuentos en el menu)' then 'Alta de promociones y/o descuentos en mi carta (por ejemplo decuentos en el catálogo)'
                     when Sub_reason = 'Opciones de modificación de menú' then 'Opciones de modificación de catálogo'
                     when Sub_reason = 'Funcionalidades disponibles ( manipulacion de ordenes, menu, configuraciones de store)' then 'Funcionalidades disponibles (manipulacion de ordenes, catálogo, configuraciones de store)'
                     else Sub_reason end as Sub_reason
              , Sub_sub_reason
              , Journey_step
              , role
              , user_role
              , user_id
              , platformIdentifiers
              , salesforceId
              , restaurant_name
              , AccountSource
              , is_logistic
              , is_important_account
              , Key_Account_Sub_Category
              , is_online
              , is_active
              , state
              , business_type
              , Vertical
              , reception_system
              , registeredDate
              , first_date_online
              , antiquity
              , commission
              , privatePhone
              , publicPhone
              , account_owner
              , user_id_account_owner
              , lead_owner
              , user_id_lead_owner
              , city
              , province
              , area
              , vendor_grade
              ,'QCommerce' as business_unit
              ,case when nps_type like "%Existing%" then 'Existing Partners'
                     when nps_type like "%New%" then 'New Partners'
                     else 'CHECK'
                     end as survey_type
              ,case when Reason in ('Servicio de Atención recibido por Chat, Whatsapp Business e Email','Servicio de Atención recibido por Chat, Whatsapp Business e Email') then 'QC'
                     when Reason in ('Volúmenes de Ordenes / Costos de Asociacion','Volúmenes de Ordenes / Costos de Asociacion') then 'QC'
                     when Reason in ('Marketing y Posicionamiento (promociones, campañas, merchandising)','Marketing y Posicionamiento') then 'QC'
                     when Reason in ('Asesoramiento comercial (asesoría y profesionalismo)','Asesoramiento comercial') then 'QC'
                     when Reason in ('Sistema de recepción de pedidos (funcionalidad y capacitación)','Sistemas de recepción de pedidos') then 'QC'
                     when Reason in ('Partner Portal (gestión del menú y local, diseño y funcionamiento)','Partner Portal') then 'QC'
                     when Reason = 'Mantenimiento del Catálogo (Aplica Sólo a integraciones)' then 'QC'
                     when Reason in ('Informes y reportes de performance (calidad y frecuencia)','Informes y reportes de performance') then 'QC'
                     when Reason = 'Dispositivo de recepción de pedidos - POSNET (funcionamiento y material de capacitación)' then 'QC'
                     when Reason in ('Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)','Servicio de repartos y logística') then 'QC'
                     when Reason in ('Facturación y Cobranzas (estado de cuenta, pagos y cobros)','Facturación y Cobranzas') then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Chapter
              ,case when Reason in ('Servicio de Atención recibido por Chat, Whatsapp Business e Email','Servicio de Atención recibido por Chat, Whatsapp Business e Email') then 'CARE'
                     when Reason in ('Volúmenes de Ordenes / Costos de Asociacion','Volúmenes de Ordenes / Costos de Asociacion') then 'Business Improvement Advising'
                     when Reason in ('Marketing y Posicionamiento (promociones, campañas, merchandising)','Marketing y Posicionamiento') then 'Business Improvement Advising'
                     when Reason in ('Asesoramiento comercial (asesoría y profesionalismo)','Asesoramiento comercial') then 'Business Improvement Advising'
                     when Reason in ('Sistema de recepción de pedidos (funcionalidad y capacitación)','Sistemas de recepción de pedidos') then 'Management tools (RS, VP)'
                     when Reason in ('Partner Portal (gestión del menú y local, diseño y funcionamiento)','Partner Portal') then 'Management tools (RS, VP)'
                     when Reason = 'Mantenimiento del Catálogo (Aplica Sólo a integraciones)' then 'Management tools (RS, VP)'
                     when Reason in ('Informes y reportes de performance (calidad y frecuencia)','Informes y reportes de performance') then 'Management tools (RS, VP)'
                     when Reason = 'Dispositivo de recepción de pedidos - POSNET (funcionamiento y material de capacitación)' then 'Management tools (RS, VP)'
                     when Reason in ('Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)','Servicio de repartos y logística') then 'Logistics (and rider interactions)'
                     when Reason in ('Facturación y Cobranzas (estado de cuenta, pagos y cobros)','Facturación y Cobranzas') then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Sub_Chapter
       from (
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
              where nps.nps_type in ('NPS Existing Partners','NPS New Partners')
                     and nps.Vertical = 'NEW VERTICALS'
                     and DATE_TRUNC(nps.start_date, MONTH) >>= "2022-01-01" 
              union all
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners_shops` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
       )
) nps
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON LOWER(nps.country_name) = LOWER (dc.country_name) and dc.active
 where business_unit = 'FOOD'
    and Sub_Chapter in ('Business Improvement Advising')
       group by 1,2


),

