                     when Reason = 'Sistemas de recepción de pedidos' then 'Sistema de recepción de pedidos (funcionalidad y capacitación)'
                     when Reason = 'Volúmenes de Ordenes / Costos de Asociacion' then 'Volúmenes de Ordenes / Costos de Asociacion'
                     else Reason end as Reason
              , case when Sub_reason = 'Alta de promociones y/o descuentos en mi carta ( por ejemplo decuentos en el menu)' then 'Alta de promociones y/o descuentos en mi carta (por ejemplo decuentos en el catálogo)'
                     when Sub_reason = 'Opciones de modificación de menú' then 'Opciones de modificación de catálogo'
                     when Sub_reason = 'Funcionalidades disponibles ( manipulacion de ordenes, menu, configuraciones de store)' then 'Funcionalidades disponibles (manipulacion de ordenes, catálogo, configuraciones de store)'
                     else Sub_reason end as Sub_reason
              , Sub_sub_reason
              , Journey_step
              , role
              , user_role
              , user_id
              , platformIdentifiers
              , salesforceId
              , restaurant_name
              , AccountSource
              , is_logistic
              , is_important_account
              , Key_Account_Sub_Category
              , is_online
              , is_active
              , state
              , business_type
              , Vertical
              , reception_system
              , registeredDate
              , first_date_online
              , antiquity
              , commission
              , privatePhone
              , publicPhone
              , account_owner
              , user_id_account_owner
              , lead_owner
              , user_id_lead_owner
              , city
              , province
              , area
              , vendor_grade
              ,'QCommerce' as business_unit
              ,case when nps_type like "%Existing%" then 'Existing Partners'
                     when nps_type like "%New%" then 'New Partners'
                     else 'CHECK'
                     end as survey_type
              ,case when Reason in ('Servicio de Atención recibido por Chat, Whatsapp Business e Email','Servicio de Atención recibido por Chat, Whatsapp Business e Email') then 'QC'
                     when Reason in ('Volúmenes de Ordenes / Costos de Asociacion','Volúmenes de Ordenes / Costos de Asociacion') then 'QC'
                     when Reason in ('Marketing y Posicionamiento (promociones, campañas, merchandising)','Marketing y Posicionamiento') then 'QC'
                     when Reason in ('Asesoramiento comercial (asesoría y profesionalismo)','Asesoramiento comercial') then 'QC'
                     when Reason in ('Sistema de recepción de pedidos (funcionalidad y capacitación)','Sistemas de recepción de pedidos') then 'QC'
                     when Reason in ('Partner Portal (gestión del menú y local, diseño y funcionamiento)','Partner Portal') then 'QC'
                     when Reason = 'Mantenimiento del Catálogo (Aplica Sólo a integraciones)' then 'QC'
                     when Reason in ('Informes y reportes de performance (calidad y frecuencia)','Informes y reportes de performance') then 'QC'
                     when Reason = 'Dispositivo de recepción de pedidos - POSNET (funcionamiento y material de capacitación)' then 'QC'
                     when Reason in ('Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)','Servicio de repartos y logística') then 'QC'
                     when Reason in ('Facturación y Cobranzas (estado de cuenta, pagos y cobros)','Facturación y Cobranzas') then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Chapter
              ,case when Reason in ('Servicio de Atención recibido por Chat, Whatsapp Business e Email','Servicio de Atención recibido por Chat, Whatsapp Business e Email') then 'CARE'
                     when Reason in ('Volúmenes de Ordenes / Costos de Asociacion','Volúmenes de Ordenes / Costos de Asociacion') then 'Business Improvement Advising'
                     when Reason in ('Marketing y Posicionamiento (promociones, campañas, merchandising)','Marketing y Posicionamiento') then 'Business Improvement Advising'
                     when Reason in ('Asesoramiento comercial (asesoría y profesionalismo)','Asesoramiento comercial') then 'Business Improvement Advising'
                     when Reason in ('Sistema de recepción de pedidos (funcionalidad y capacitación)','Sistemas de recepción de pedidos') then 'Management tools (RS, VP)'
                     when Reason in ('Partner Portal (gestión del menú y local, diseño y funcionamiento)','Partner Portal') then 'Management tools (RS, VP)'
                     when Reason = 'Mantenimiento del Catálogo (Aplica Sólo a integraciones)' then 'Management tools (RS, VP)'
                     when Reason in ('Informes y reportes de performance (calidad y frecuencia)','Informes y reportes de performance') then 'Management tools (RS, VP)'
                     when Reason = 'Dispositivo de recepción de pedidos - POSNET (funcionamiento y material de capacitación)' then 'Management tools (RS, VP)'
                     when Reason in ('Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)','Servicio de repartos y logística') then 'Logistics (and rider interactions)'
                     when Reason in ('Facturación y Cobranzas (estado de cuenta, pagos y cobros)','Facturación y Cobranzas') then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Sub_Chapter
       from (
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
              where nps.nps_type in ('NPS Existing Partners','NPS New Partners')
                     and nps.Vertical = 'NEW VERTICALS'
                     and DATE_TRUNC(nps.start_date, MONTH) >>= "2022-01-01" 
              union all
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners_shops` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
       )
) nps
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON LOWER(nps.country_name) = LOWER (dc.country_name) and dc.active
 where business_unit = 'FOOD'
    and Sub_Chapter in ('Management tools (RS, VP)')
       group by 1,2


),

food_O2_NPS_logistics AS (select distinct  mes_respuesta,country_id,count(distinct response_id) responses_lo,sum(promoter) promoters_lo,sum(Detractor) detractors_lo
from (
    --TABLEAU FOOD
       SELECT response_id
              , start_date
              , DATE_TRUNC(DATE(start_date),MONTH) mes_respuesta
              , partner_id
              , nps_type_group
              , nps_type
              , nps_group
              , Promoter
              , Passive
              , Detractor
              , response
              , further_comments
              , case when send_method = 'Email' then 'Email'
                     when send_method = 'email' then 'Email'
                     when send_method = 'Partner Portal' then 'Partner Portal'
                     when send_method = 'si' then 'Partner Portal'
                     when send_method = 'Anonymous' then 'Partner Portal'
                     else send_method end as send_method
              , country_name
              , Reason
              , Sub_reason
              , Sub_sub_reason
              , Journey_step
              , role
              , user_role
              , user_id
              , platformIdentifiers
              , salesforceId
              , restaurant_name
              , AccountSource
              , is_logistic
              , is_important_account
              , Key_Account_Sub_Category
              , is_online
              , is_active
              , state
              , business_type
              , Vertical
              , reception_system
              , registeredDate
              , first_date_online
              , antiquity
              , commission
              , privatePhone
              , publicPhone
              , account_owner
              , user_id_account_owner
              , lead_owner
              , user_id_lead_owner
              , city
              , province
              , area
              , vendor_grade
              ,'FOOD' as business_unit
              ,case when nps_type like "%Existing%" then 'Existing Partners'
                     when nps_type like "%New%" then 'New Partners'
                     else 'CHECK'
                     end as survey_type
              ,case when Reason = 'Servicio de Atención recibido por Chat, Whatsapp Business e Email' then 'FOOD'
                     when Reason = 'Informes y reportes de performance' then 'FOOD'
                     when Reason = 'Partner Portal' then 'FOOD'
                     when Reason = 'Sistemas de recepción de pedidos' then 'FOOD'
                     when Reason = 'Asesoramiento comercial' then 'FOOD'
                     when Reason = 'Marketing y Posicionamiento' then 'FOOD'
                     when Reason = 'Volúmenes de Ordenes / Costos de Asociacion' then 'FOOD'
                     when Reason = 'Servicio de repartos y logística' then 'FOOD'
                     when Reason = 'Facturación y Cobranzas' then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Chapter
              ,case when Reason = 'Servicio de Atención recibido por Chat, Whatsapp Business e Email' then 'CARE'
                     when Reason = 'Informes y reportes de performance' then 'Management tools (RS, VP)'
                     when Reason = 'Partner Portal' then 'Management tools (RS, VP)'
                     when Reason = 'Sistemas de recepción de pedidos' then 'Management tools (RS, VP)'
                     when Reason = 'Asesoramiento comercial' then 'Business Improvement Advising'
                     when Reason = 'Marketing y Posicionamiento' then 'Business Improvement Advising'
                     when Reason = 'Volúmenes de Ordenes / Costos de Asociacion' then 'Business Improvement Advising'
                     when Reason = 'Servicio de repartos y logística' then 'Logistics (and rider interactions)'
                     when Reason = 'Facturación y Cobranzas' then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Sub_Chapter
       FROM (
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
              WHERE nps.nps_type in ('NPS Existing Partners','NPS New Partners')
                            and nps.Vertical = 'FOOD'
              )
        UNION ALL 
        --TABLERO SHOPS
       select response_id
              , start_date
              , DATE_TRUNC(DATE(start_date),MONTH) mes_respuesta
              , partner_id
              , nps_type_group
              , case when nps_type = 'NPS Existing Partners' then 'NPS Existing Partners Shops'
                     when nps_type = 'NPS New Partners' then 'NPS New Partners Shops'
                     else nps_type end as nps_type
              , nps_group
              , Promoter
              , Passive
              , Detractor
              , response
              , further_comments
              , case when send_method = 'Email' then 'Email'
                     when send_method = 'Partner Portal' then 'Partner Portal'
                     when send_method = 'si' then 'Partner Portal'
                     when send_method = 'Anonymous' then 'Partner Portal'
                     else send_method end as send_method
              , country_name
              , case when Reason = 'Asesoramiento comercial' then 'Asesoramiento comercial (asesoría y profesionalismo)'
                     when Reason = 'Facturación y Cobranzas' then 'Facturación y Cobranzas (estado de cuenta, pagos y cobros)'
                     when Reason = 'Informes y reportes de performance' then 'Informes y reportes de performance (calidad y frecuencia)'
                     when Reason = 'Marketing y Posicionamiento' then 'Marketing y Posicionamiento (promociones, campañas, merchandising)'
                     when Reason = 'Partner Portal' then 'Partner Portal (gestión del menú y local, diseño y funcionamiento)'
                     when Reason = 'Servicio de Atención recibido por Chat, Whatsapp Business e Email' then 'Servicio de Atención recibido por Chat, Whatsapp Business e Email'
                     when Reason = 'Servicio de repartos y logística' then 'Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)'
                     when Reason = 'Sistemas de recepción de pedidos' then 'Sistema de recepción de pedidos (funcionalidad y capacitación)'
                     when Reason = 'Volúmenes de Ordenes / Costos de Asociacion' then 'Volúmenes de Ordenes / Costos de Asociacion'
                     else Reason end as Reason
              , case when Sub_reason = 'Alta de promociones y/o descuentos en mi carta ( por ejemplo decuentos en el menu)' then 'Alta de promociones y/o descuentos en mi carta (por ejemplo decuentos en el catálogo)'
                     when Sub_reason = 'Opciones de modificación de menú' then 'Opciones de modificación de catálogo'
                     when Sub_reason = 'Funcionalidades disponibles ( manipulacion de ordenes, menu, configuraciones de store)' then 'Funcionalidades disponibles (manipulacion de ordenes, catálogo, configuraciones de store)'
                     else Sub_reason end as Sub_reason
              , Sub_sub_reason
              , Journey_step
              , role
              , user_role
              , user_id
              , platformIdentifiers
              , salesforceId
              , restaurant_name
              , AccountSource
              , is_logistic
              , is_important_account
              , Key_Account_Sub_Category
              , is_online
              , is_active
              , state
              , business_type
              , Vertical
              , reception_system
              , registeredDate
              , first_date_online
              , antiquity
              , commission
              , privatePhone
              , publicPhone
              , account_owner
              , user_id_account_owner
              , lead_owner
              , user_id_lead_owner
              , city
              , province
              , area
              , vendor_grade
              ,'QCommerce' as business_unit
              ,case when nps_type like "%Existing%" then 'Existing Partners'
                     when nps_type like "%New%" then 'New Partners'
                     else 'CHECK'
                     end as survey_type
              ,case when Reason in ('Servicio de Atención recibido por Chat, Whatsapp Business e Email','Servicio de Atención recibido por Chat, Whatsapp Business e Email') then 'QC'
                     when Reason in ('Volúmenes de Ordenes / Costos de Asociacion','Volúmenes de Ordenes / Costos de Asociacion') then 'QC'
                     when Reason in ('Marketing y Posicionamiento (promociones, campañas, merchandising)','Marketing y Posicionamiento') then 'QC'
                     when Reason in ('Asesoramiento comercial (asesoría y profesionalismo)','Asesoramiento comercial') then 'QC'
                     when Reason in ('Sistema de recepción de pedidos (funcionalidad y capacitación)','Sistemas de recepción de pedidos') then 'QC'
                     when Reason in ('Partner Portal (gestión del menú y local, diseño y funcionamiento)','Partner Portal') then 'QC'
                     when Reason = 'Mantenimiento del Catálogo (Aplica Sólo a integraciones)' then 'QC'
                     when Reason in ('Informes y reportes de performance (calidad y frecuencia)','Informes y reportes de performance') then 'QC'
                     when Reason = 'Dispositivo de recepción de pedidos - POSNET (funcionamiento y material de capacitación)' then 'QC'
                     when Reason in ('Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)','Servicio de repartos y logística') then 'QC'
                     when Reason in ('Facturación y Cobranzas (estado de cuenta, pagos y cobros)','Facturación y Cobranzas') then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Chapter
              ,case when Reason in ('Servicio de Atención recibido por Chat, Whatsapp Business e Email','Servicio de Atención recibido por Chat, Whatsapp Business e Email') then 'CARE'
                     when Reason in ('Volúmenes de Ordenes / Costos de Asociacion','Volúmenes de Ordenes / Costos de Asociacion') then 'Business Improvement Advising'
                     when Reason in ('Marketing y Posicionamiento (promociones, campañas, merchandising)','Marketing y Posicionamiento') then 'Business Improvement Advising'
                     when Reason in ('Asesoramiento comercial (asesoría y profesionalismo)','Asesoramiento comercial') then 'Business Improvement Advising'
                     when Reason in ('Sistema de recepción de pedidos (funcionalidad y capacitación)','Sistemas de recepción de pedidos') then 'Management tools (RS, VP)'
                     when Reason in ('Partner Portal (gestión del menú y local, diseño y funcionamiento)','Partner Portal') then 'Management tools (RS, VP)'
                     when Reason = 'Mantenimiento del Catálogo (Aplica Sólo a integraciones)' then 'Management tools (RS, VP)'
                     when Reason in ('Informes y reportes de performance (calidad y frecuencia)','Informes y reportes de performance') then 'Management tools (RS, VP)'
                     when Reason = 'Dispositivo de recepción de pedidos - POSNET (funcionamiento y material de capacitación)' then 'Management tools (RS, VP)'
                     when Reason in ('Servicio de repartos y logística (repartidores, proceso de entrega y zona de cobertura)','Servicio de repartos y logística') then 'Logistics (and rider interactions)'
                     when Reason in ('Facturación y Cobranzas (estado de cuenta, pagos y cobros)','Facturación y Cobranzas') then 'FINTECH'
                     when nps_type like "%New%" then 'New Partners'
                     else 'SIN ESPECIFICAR'
                     end as Sub_Chapter
       from (
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
              where nps.nps_type in ('NPS Existing Partners','NPS New Partners')
                     and nps.Vertical = 'NEW VERTICALS'
                     and DATE_TRUNC(nps.start_date, MONTH) >>= "2022-01-01" 
              union all
              SELECT nps.*,
                     case when vg.vendor_grade is null then 'No data' else vg.vendor_grade end as vendor_grade
              FROM `peya-food-and-groceries.user_federico_gil.nps_partners_shops` nps
              left join (
                     select a.partner_id
                                   ,b.vendor_grade
                            from (
                                   SELECT partner_id,
                                          max(process_date) as process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   group by 1
                                   ) a
                            left join (
                                   SELECT partner_id,
                                          vendor_grade,
                                          process_date
                                   FROM `peya-delivery-and-support.automated_tables_reports.partner_vendor_grades`
                                   ) b on a.partner_id = b.partner_id 
                                          and a.process_date = b.process_date
                     ) vg on nps.partner_id = vg.partner_id
       )
) nps
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON LOWER(nps.country_name) = LOWER (dc.country_name) and dc.active
 where business_unit = 'FOOD'
    and Sub_Chapter in ('Logistics (and rider interactions)')
       group by 1,2


),

food_O3_CVR2_MCVR3 AS(
   

    SELECT date_trunc(date(date), month) as month_year
        , DC.country_id
        , sum(CASE WHEN shop_list_dummy = 1 THEN sessions ELSE 0 END) as food_shop_list_visits
        , sum(CASE WHEN shop_details_dummy = 1 THEN sessions ELSE 0 END) as food_shop_details_visits
        , sum(CASE WHEN shop_details_dummy = 1 AND checkout_loaded_dummy = 1 THEN sessions ELSE 0 END) as food_checkout_visits
        , sum(case when shop_list_dummy = 1 AND transaction_dummy =1 THEN sessions else 0 end) as food_transactions

    FROM `peya-food-and-groceries.automated_tables_reports.overview_and_squad_dash_agg_chapter_level` FV
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` DC on FV.country = DC.country_name_en
    WHERE date >>= "2022-01-01"
    AND country_id <<>> 6
    AND businessChapter = 'Food'
    GROUP BY 1, 2
),

food_O3_DLP AS (
   WITH  Max_fecha AS (
SELECT Date_trunc(date, month) month
    , MAX(date) date
FROM `peya-food-and-groceries.automated_tables_reports.historical_coverage_pics` 
GROUP BY 1
ORDER BY 2,1 DESC
)
SELECT  month year_month
      , country_id
      , SUM(total_products) total_products
      , SUM(total_images) total_images
      , ROUND(SUM(total_images)/ SUM(total_products),3) AS coverage_image
FROM `peya-food-and-groceries.automated_tables_reports.historical_coverage_pics`  cp
     INNER JOIN max_fecha mf
       ON cp.date = mf.date
WHERE country_name NOT IN ('México', 'Puerto Rico')
  AND month >>= '2022-01-01'
GROUP BY 1,2
ORDER BY 1 DESC
),

food_O3_NPS_survey AS(
     SELECT  
        DATE(DATE_trunc(start_date,month)) as year_month,
        country_id,
        COUNT(CASE WHEN nps_group = 'Promoter' THEN response_id END) promoters,
        COUNT(CASE WHEN nps_group = 'Detractor' THEN response_id END) detractors,
        COUNT(response_id) as responses 
        FROM `peya-cx-analytics.automated_tables_reports.tableau_nps_ao` np
        LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON LOWER(dc.country_name) = LOWER(np.country_name)
        WHERE start_date >>= "2022-01-01" 
        AND order_state = "Confirmed"
        AND customer_type = "Returning Customer"
        AND nps_reason IN ("Navigation Through the Platform","Ordering Process","Pricing, Deals and Discounts")
        AND nps_type = "NPS AO"
        AND business_type in ("Restaurant", "Coffee")
        AND dc.active
        GROUP BY 1,2

),

food_O3_NPS_AO AS(
    SELECT 
        date(DATE_trunc(q.start_date,month)) as year_month,
        fo.country_id,
        COUNT(CASE WHEN q.nps_group = 'Promoter' THEN q.response_id END) promoters,
        COUNT(CASE WHEN q.nps_group = 'Detractor' THEN q.response_id END) detractors,
        COUNT(q.response_id) as responses
    FROM `peya-bi-tools-pro.il_nps.fact_qualtrics` AS q
    INNER JOIN `peya-bi-tools-pro.il_core.fact_orders` fo on q.order_id = fo.order_id
    WHERE q.nps_type = 'NPS AO'
    AND DATE(q.start_date) >>= '2022-01-01'
    AND fo.order_status = 'CONFIRMED'
    and lower(business_type.business_type_name) in ('restaurant','coffee')
    and fo.is_first_confirmed_order_user <<>> 1
    and fo.registered_date >>= '2021-07-01'
    GROUP BY 1,2
),
food_O4_vfd_gmv AS (WITH VFD as (WITH  dates AS (
  SELECT
    DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -3 MONTH) start_date,
    DATE(CURRENT_DATE) before_date 
),    
discounts_amounts_no_subsidized_no_bins AS (
  WITH
    coupon_type AS (
    SELECT
      DISTINCT order_id,
      CASE
        WHEN cam.talon_campaign_name LIKE '%CENTRAL%' THEN 'MARKETING_CENTRAL'
        WHEN cam.talon_campaign_name LIKE '%LOCAL%' THEN 'MARKETING_LOCAL'
        WHEN cam.talon_campaign_name LIKE '%_dma_%' THEN 'DMART'
        WHEN (tc.talon_campaign_id IN ('97')
        OR tc.talon_campaign_id LIKE '%-customer-service-agent-compensations%') THEN 'SORRY'
        WHEN cam.talon_campaign_name LIKE '%COOP%' THEN 'COORPORATIVE'
        WHEN (cam.talon_campaign_name LIKE '%NONE%'
        OR cam.talon_campaign_name LIKE '%OTHER%'
        OR cam.talon_campaign_name LIKE '%EMPLOYEE%'
        OR cam.talon_campaign_name LIKE '%RH%'
        OR cam.talon_campaign_name LIKE 'OTHER_NCR_%'
        OR cam.talon_campaign_name LIKE '%other_cc_%'
        OR cam.talon_campaign_name LIKE '%other_autocomp_%'
        OR cam.talon_campaign_name LIKE '%other_employee_%'
        OR cam.talon_campaign_name LIKE '%other_other_%'
        OR cam.talon_campaign_name LIKE '%other_ncr_%'
        OR cam.talon_campaign_name LIKE '%COOP__LOCAL_%'
        OR cam.talon_campaign_name LIKE '%WEBPAY_REFUNDS%'
        OR cam.talon_campaign_name LIKE '%PAYMENT_REFUNDS%') THEN 'NON_MARKETING'
    END
      discount_type
    FROM
      `peya-bi-tools-pro.il_growth.fact_talon_coupons` tc
    LEFT JOIN
      `peya-bi-tools-pro.il_growth.dim_talon_campaigns` cam
    ON cam.talon_campaign_id = tc.talon_campaign_id
    WHERE
      DATE(tc.coupon_created_at) >>= (SELECT start_date FROM dates) /* es la particion */
      AND DATE(tc.order_registered_date) >>= (SELECT start_date FROM dates)
      AND DATE(tc.order_registered_date) << (SELECT before_date FROM dates)
      AND tc.order_state_id = 1 )
  SELECT
    d.order_id,
    CASE
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IN ('COORPORATIVE') THEN 'THIRD'
        ELSE d.discount_paid_by
        END paid_by,
    CASE
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IN ('MARKETING_CENTRAL') THEN 'MARKETING_CENTRAL_COUPON'
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IN ('MARKETING_LOCAL') THEN 'MARKETING_LOCAL_COUPON'
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IN ('DMART') THEN 'DMART_COUPON'
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IN ('SORRY') THEN 'SORRY_COUPON'
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IN ('COORPORATIVE') THEN 'COORPORATIVE_COUPON'
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IN ('NON_MARKETING') THEN 'NON_MARKETING_COUPON'
        WHEN d.discount_type_name IN ('VOUCHER') AND cp.discount_type IS NULL THEN 'OTHER_TYPE_COUPON'
        ELSE COALESCE(d.discount_type_name, 'DISCOUNT_NAME_MISSING')
        END discount_type,
    SUM(d.discount_amount) discount_amount
  FROM `peya-bi-tools-pro.il_core.fact_orders` o,
    UNNEST(discounts) d
  LEFT JOIN coupon_type cp
    ON cp.order_id = o.order_id
  WHERE
    o.registered_date >>= (SELECT start_date FROM dates)
    AND o.registered_date << (SELECT before_date FROM dates)
    AND o.order_status IN ('CONFIRMED')
    AND d.discount_type_name NOT IN ('SUBSIDIZED','BINS')
  GROUP BY    1,    2,    3
  HAVING
    SUM(d.discount_amount) >> 0 
),
discounts_amounts_subsidized AS (
  WITH
    subsidized_orders_company AS (
    SELECT
      o.order_id,
      'COMPANY' paid_by,
      'SUBSIDIZED' discount_type,
      SUM(d.subsidized_subtotal) discount_amount
    FROM `peya-bi-tools-pro.il_core.fact_orders` o,
      UNNEST(details) d
    WHERE
      o.registered_date >>= (SELECT start_date FROM dates)
      AND o.registered_date << (SELECT before_date FROM dates)
      AND o.order_status IN ('CONFIRMED')
      AND d.is_subsidized
    GROUP BY      1,      2,      3     
),
subsidized_discounts AS (
    SELECT
      d.order_id,
      SUM(d.discount_amount) discount_amount
    FROM
      `peya-bi-tools-pro.il_core.fact_orders` o,
      UNNEST(discounts) d
    WHERE
      o.registered_date >>= (SELECT start_date FROM dates)
      AND o.registered_date << (SELECT before_date FROM dates)
      AND o.order_status IN ('CONFIRMED')
      AND d.discount_type_name IN ('SUBSIDIZED')
    GROUP BY 1 
),
subsidized_orders_partner AS (
    SELECT
      soc.order_id,
      'RESTAURANT' paid_by,
      'SUBSIDIZED' discount_type,
      SUM( IF(sdi.discount_amount >> soc.discount_amount, sdi.discount_amount - soc.discount_amount, 0)) discount_amount
    FROM
      subsidized_orders_company soc
    LEFT JOIN
      subsidized_discounts sdi
    ON
      sdi.order_id = soc.order_id
    GROUP BY      1,    2,      3 )
  SELECT *
  FROM subsidized_orders_company
  WHERE
    discount_amount >> 0
  UNION DISTINCT
  SELECT
    *
  FROM
    subsidized_orders_partner
  WHERE
    discount_amount >> 0 
),
discounts_amounts_bins AS (
  WITH
    bins_company AS (
    SELECT
      p.purchase_id order_id,
      'COMPANY' paid_by,
      CASE
        WHEN i.campaign_type = 0 THEN 'BINS_REIMBURSEMENT'
        WHEN i.campaign_type = 1 THEN 'BINS_CASHBACK'
        WHEN i.campaign_type = 2 THEN 'BINS_DISCOUNT'
      ELSE
      'BINS_CAMPAIGN_UNKNOWN'
    END
      discount_type,
      ROUND(SAFE_MULTIPLY(i.cart_amount_discount + i.delivery_amount_discount,
          a.company/100),2) discount_amount
    FROM `peya-data-origins-pro.cl_campaigns.purchase_log` p
    LEFT JOIN`peya-data-origins-pro.cl_campaigns.campaign_purchase_log_items` i
        ON p.id = i.purchase_log_id
    LEFT JOIN`peya-data-origins-pro.cl_campaigns.campaign` c
        ON i.id = c.id
    LEFT JOIN`peya-data-origins-pro.cl_campaigns.absorbed_by` a
        ON i.id = a.id
    WHERE
      DATE(p.created_at) >>= (SELECT start_date FROM dates)
      AND DATE(p.created_at) << (SELECT before_date FROM dates)
      AND a.company >> 0 
),
bins_partner AS (
    SELECT
      p.purchase_id order_id,
      'RESTAURANT' paid_by,
      CASE
        WHEN i.campaign_type = 0 THEN 'BINS_REIMBURSEMENT'
        WHEN i.campaign_type = 1 THEN 'BINS_CASHBACK'
        WHEN i.campaign_type = 2 THEN 'BINS_DISCOUNT'
        ELSE'BINS_CAMPAIGN_UNKNOWN'
        END discount_type,
      ROUND(SAFE_MULTIPLY(i.cart_amount_discount + i.delivery_amount_discount,
          a.partner/100),2) discount_amount
    FROM`peya-data-origins-pro.cl_campaigns.purchase_log` p
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.campaign_purchase_log_items` i
        ON p.id = i.purchase_log_id
    LEFT JOIN`peya-data-origins-pro.cl_campaigns.campaign` c
        ON i.id = c.id
    LEFT JOIN`peya-data-origins-pro.cl_campaigns.absorbed_by` a
        ON i.id = a.id
    WHERE
      DATE(p.created_at) >>= (SELECT start_date FROM dates)
      AND DATE(p.created_at) << (SELECT before_date FROM dates)
      AND a.partner >> 0 
),
bins_bank AS (
    SELECT
      p.purchase_id order_id,
      'THIRD' paid_by,
      CASE
        WHEN i.campaign_type = 0 THEN 'BINS_REIMBURSEMENT'
        WHEN i.campaign_type = 1 THEN 'BINS_CASHBACK'
        WHEN i.campaign_type = 2 THEN 'BINS_DISCOUNT'
        ELSE 'BINS_CAMPAIGN_UNKNOWN'
        END discount_type,
      ROUND(SAFE_MULTIPLY(i.cart_amount_discount + i.delivery_amount_discount,
          a.bank/100),2) discount_amount
    FROM`peya-data-origins-pro.cl_campaigns.purchase_log` p
    LEFT JOIN `peya-data-origins-pro.cl_campaigns.campaign_purchase_log_items` i
        ON p.id = i.purchase_log_id
    LEFT JOIN`peya-data-origins-pro.cl_campaigns.campaign` c
        ON i.id = c.id
    LEFT JOIN`peya-data-origins-pro.cl_campaigns.absorbed_by` a
        ON i.id = a.id
    WHERE
      DATE(p.created_at) >>= (SELECT start_date FROM dates)
      AND DATE(p.created_at) << (SELECT before_date FROM dates)
      AND a.bank >> 0 )
  SELECT *
  FROM bins_company
  UNION DISTINCT
    SELECT *
    FROM bins_partner
  UNION DISTINCT
    SELECT *
    FROM bins_bank 
),
wallet_coorporative AS (
  SELECT
    att.order_id,
    'THIRD' paid_by,
    'WALLET_COORPORATIVE' discount_type,
    SUM(att_det.amount) discount_amount
  FROM
    `peya-bi-tools-pro.il_wallet.fact_wallet_attributions` att,
    UNNEST(attributionDetails) att_det
  LEFT JOIN
    `peya-bi-tools-pro.il_core.dim_country` dc
  ON
    UPPER(dc.country_code) = UPPER(att.country)
    AND dc.active
  WHERE
    DATE(att.attributedAt) >>= (SELECT start_date FROM dates)
    AND DATE(att.attributedAt) << (SELECT before_date FROM dates)
    AND att_det.campaignCode LIKE '%COOP%'
  GROUP BY     1,    2,    3 
),
pcm_discounts AS (
  SELECT
    order_id,
    CASE 
        WHEN type IN ('beforePrice') THEN "RESTAURANT" 
        ELSE "THIRD"
        END paid_by,
    CASE
        WHEN type IN ('freeShippingFee') THEN 'PCM_FREE_SHIPPING'
        WHEN type IN ('discounts') THEN 'PCM_PARTNERSHIPS'
        WHEN type IN ('beforePrice') THEN "PCM_BEFOREPRICE" 
        ELSE "PCM_OTHERS"
        END discount_type,
    SUM(amount) discount_amount
  FROM
    `peya-data-origins-pro.cl_pcm.order_discount`
  WHERE
    DATE(creation_at) >>= (SELECT start_date FROM dates)
    AND DATE(creation_at) << (SELECT before_date FROM dates)
  GROUP BY     1,    2,    3
  HAVING
    SUM(amount) >> 0 
),
orders_with_error AS (
  SELECT 
    order_id_to_be_excluded
  FROM `peya-markets.automated_tables_reports.dim_order_problems`
),
fact_orders_discounts AS (
  SELECT*
  FROM discounts_amounts_no_subsidized_no_bins
  UNION DISTINCT
    SELECT *
    FROM discounts_amounts_subsidized
  UNION DISTINCT
    SELECT *
    FROM discounts_amounts_bins
  UNION DISTINCT
    SELECT *
    FROM wallet_coorporative
  UNION DISTINCT
    SELECT *
    FROM pcm_discounts 
),
order_data AS (
  SELECT
    DISTINCT o.order_id,
    o.restaurant.id partner_id,
    o.restaurant.name as partner_name,
    o.registered_date,
    o.country_id,
    UPPER(o.country.country_name) country_name,
    UPPER(o.business_type.business_type_name) business_type_name,
    ce.rate_eu,
    _ingested_at
  FROM
    `peya-bi-tools-pro.il_core.fact_orders` o
  INNER JOIN
    `peya-bi-tools-pro.il_core.dim_country` dc
    ON
      dc.country_id = o.country_id
      AND dc.active
  LEFT JOIN
    `peya-bi-tools-pro.il_core.dim_currency_exchange` ce
    ON
      ce.currency_id = dc.currency_id
      AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)
  WHERE
    o.registered_date >>= (SELECT start_date FROM dates)
    AND o.registered_date << (SELECT before_date FROM dates)
    AND o.order_status IN ('CONFIRMED') 
)

SELECT
  DATE_TRUNC(od.registered_date,MONTH) month,
  od.country_id,
  COALESCE(fod.paid_by,'UNKNOWN') paid_by,
  ROUND(SUM(fod.discount_amount / od.rate_eu),2) discount_amount_euro,
  MAX(od._ingested_at) _ingested_at

FROM  fact_orders_discounts fod

LEFT JOIN  order_data od
    ON  od.order_id = fod.order_id

LEFT JOIN orders_with_error owe
    ON fod.order_id = owe.order_id_to_be_excluded

WHERE
  od.country_name IS NOT NULL
  AND owe.order_id_to_be_excluded IS NULL
  AND fod.discount_amount >> 0
  AND fod.paid_by = "RESTAURANT"

GROUP BY  1,2,3
ORDER BY  1,2,3),

GMV as(SELECT
        DATE_TRUNC(registered_date, MONTH) AS month
        ,c.country_id
        ,ROUND(SUM(total_amount/ce.rate_eu + shipping_amount/ce.rate_eu + discount_paid_by_company/ce.rate_eu),2) AS GMV_Gross_eur
FROM `peya-bi-tools-pro.il_core.fact_orders` AS o

INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS c 
    ON c.country_id = o.country_id AND c.active =true

LEFT JOIN `peya-markets.automated_tables_reports.dim_order_problems` op
    ON o.order_id = op.order_id_to_be_excluded

LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce 
	   ON ce.currency_id = c.currency_id 
	  AND ce.currency_exchange_date = DATE_TRUNC(o.registered_date,MONTH)

WHERE TRUE
    AND DATE_TRUNC(registered_date, MONTH) >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL -3 MONTH)
    AND o.order_status = 'CONFIRMED'
    AND op.order_id_to_be_excluded IS NULL

GROUP BY 1,2)


SELECT 
vfd.month month_year
,vfd.country_id
,discount_amount_euro
,GMV_Gross_eur

FROM VFD vfd
LEFT JOIN GMV gmv ON gmv.month = vfd.month
AND vfd.country_id = gmv.country_id

),

food_O4_Partners_Peya_Plus AS (WITH loyalty_partners_single_row AS (

    SELECT 
                    
         pd.partnerId AS partnerId
        ,DATE(MIN(pd.startDateTime)) AS startDateTime
        ,DATE(CASE WHEN MAX(CASE WHEN pd.endDateTime IS NULL THEN 1 ELSE 0 END) = 0
            THEN MAX(pd.endDateTime) ELSE NULL
        END) AS endDateTime
        ,pd.type AS discount_type
        ,dp.partner_name
        ,dp.country.country_name
        ,dp.country_id
    FROM `peya-data-origins-pro.cl_core.partner_discount` AS pd
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dp ON pd.partnerId = dp.partner_id
    WHERE pd.initiativeProject = 'LOYALTY'
    AND (pd.endDateTime << CURRENT_DATE OR pd.endDateTime IS NULL)
    GROUP BY 1,4,5,6,7
    ORDER BY pd.partnerId

),

 active_partner_by_month AS (

        WITH active_partners_by_month AS (

            SELECT
                DATE_TRUNC(DATE(dhp.full_date),MONTH) AS month
                , dhp.country_name
                ,dhp.country_id
                , COUNT(DISTINCT CASE WHEN dhp.is_active THEN dhp.restaurant_id END) AS active_partners_by_month
              ,ROW_NUMBER() OVER (PARTITION BY DATE_TRUNC(DATE(dhp.full_date),MONTH)-1,dhp.country_id ORDER BY yyyymmdd DESC) as ranking
            FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dhp
            INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON dc.country_id = dhp.country_id AND dc.active
            WHERE DATE(dhp.full_date) >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -3 MONTH)
            GROUP BY 1,2,3,dhp.full_date, yyyymmdd
            ORDER BY 1,2,3

        )
        SELECT

            DATE_TRUNC(DATE(dhp.full_date),MONTH) AS MONTH
            , dhp.country_name
            ,dhp.country_id
            , MAX(apbm.active_partners_by_month) AS active_partners_by_month
        
        FROM `peya-bi-tools-pro.il_core.dim_historical_partners` dhp
        INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc ON dc.country_id = dhp.country_id AND dc.active
        INNER JOIN active_partners_by_month AS apbm 
                ON DATE_TRUNC(DATE(dhp.full_date),MONTH) = apbm.month 
                AND dhp.country_name = apbm.country_name 
                where ranking = 1
        GROUP BY 1,2,3
        ORDER BY 1,2,3

    )

    SELECT 
    a.month month_year
    ,p.country_id
    ,active_partners_by_month
    , COUNT (DISTINCT partnerID) as plus_partners_subs
    
 FROM loyalty_partners_single_row p
 LEFT JOIN  active_partner_by_month a ON a.country_id = p.country_id
 GROUP BY 1,2,3
        




    
    ),


food_O5_vendor_fail_rate AS (
    select 
        year_month,
        country_name,
        country_id,
        non_confirmed_orders,
        total_orders_all_status,
        ROUND(1.0 * non_confirmed_orders / total_orders_all_status,2) AS vendor_fail_rate
    from
    (
        SELECT 
            date_trunc(o.registered_date,month) AS year_month,
            o.country_id,
            dc.country_name,
            COUNT(DISTINCT CASE WHEN o.order_status NOT IN ('CONFIRMED') AND o.fail_rate_owner = 'Restaurant' THEN o.order_id END) AS non_confirmed_orders,
            COUNT(DISTINCT o.order_id) AS total_orders_all_status
        FROM `peya-bi-tools-pro.il_core.fact_orders` o
        INNER JOIN `peya-bi-tools-pro.il_core.dim_country` dc 
            ON dc.country_id = o.country_id
            AND dc.active
        WHERE registered_date >>= '2022-01-01'
        AND business_type_id in (1,7)
        GROUP BY 1,2,3
    )
),
food_O5_vendor_late AS(
    SELECT 
        date_trunc(lo.created_date_local,month) AS year_month,
        lo.country.country_id,
        COUNT(DISTINCT CASE WHEN del.timings.vendor_late >> 300 THEN lo.order_id END) AS vendor_late_5,
        COUNT(DISTINCT CASE WHEN del.timings.vendor_late >> 600 THEN lo.order_id END) AS vendor_late_10,
        COUNT(DISTINCT CASE WHEN del.timings.vendor_late >> 900 THEN lo.order_id END) AS vendor_late_15,
        COUNT(DISTINCT CASE WHEN del.timings.vendor_late IS NOT NULL THEN lo.order_id END) AS vendor_late_base
    FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` lo,
    UNNEST(deliveries) del
    LEFT JOIN 
    (
        SELECT 
            DISTINCT order_id,
            business_type.business_type_id AS business_type
        FROM `peya-bi-tools-pro.il_core.fact_orders`
        WHERE registered_date >>= '2022-01-01'
    ) o ON o.order_id = lo.peya_order_id
    WHERE lo.created_date_local >>= '2022-01-01'
    AND del.is_primary
    AND lo.order_status IN ('completed')
    --AND NOT lo.is_preorder
    AND o.business_type in(1,7)
    --AND o.business_type IS NOT NULL
    GROUP BY 1,2

),
food_O5_Retention_rate_new_customers AS (
/*Métrica: 1ra orden en Food y reorder a Food el mes calendario siguiente
Consideraciones:
Food = Restaurant+Coffee
Solo ordenes confirmadas
Sin vouchers */


           WITH range_dates AS(
                    SELECT 
                    DISTINCT 
                    DATE(DATE_ADD(DATE_TRUNC(sd,MONTH),INTERVAL -1 MONTH )) as from_interval
                    ,DATE(DATE_TRUNC(sd,MONTH))-1 AS to_interval
                    , DATE(DATE_TRUNC(sd,MONTH)) as from_interval_reorder
                    , DATE(DATE_ADD(DATE_TRUNC(sd,MONTH), INTERVAL 1 MONTH)-1) as to_interval_reorder
                    FROM UNNEST(
                            GENERATE_DATE_ARRAY( "2022-01-01" , CURRENT_DATE , interval 1 MONTH)
                                ) as sd )

                    SELECT
                    DATE_TRUNC(rd.from_interval_reorder,MONTH) month_year, 
                    c.country_id,
                    count(distinct fo.user_id) users_base,
                    count(distinct (case when so.order_id is not null then fo.user_id end)) users_reordered,
                    FROM `peya-bi-tools-pro.il_core.fact_peya_orders_by_customers` fo
                    LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` o ON fo.order_id = o.order_id
                    INNER JOIN range_dates as rd
                    ON  fo.registered_date_partition  >>= rd.from_interval
                    AND  fo.registered_date_partition  <<= rd.to_interval_reorder 
                    LEFT JOIN `peya-bi-tools-pro.il_core.fact_peya_orders_by_customers` so  ON fo.user_id = so.user_id
                                                                        AND date(so.registered_date_partition) between from_interval_reorder and to_interval_reorder
                                                                        AND so.order_id >> fo.order_id
                                                                        AND so.nro_order_confirmed >> 1
                                                                        AND so.business_type_id in (1,7)
                    LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` c ON fo.country_id = c.country_id

                    WHERE date(fo.registered_date_partition) BETWEEN from_interval AND to_interval
                    AND date(o.registered_date) BETWEEN DATE(from_interval) AND DATE(to_interval)
                    AND DATE(o.registered_date) >>= "2021-12-01"
                    AND fo.business_type_id in (1,7)
                    AND fo.nro_order_confirmed = 1
                    AND o.has_voucher_discount = 0
                    group by 1,2

                /*
Entonces, para la métrica que se informa para Noviembre, por ejemplo, se calcula como los acquisitions de Octubre que volvieron a hacer una orden en Food en Noviembre
*/ ),

food_NPS_Partners_business_improvement AS(
  SELECT 
        DATE(DATE_trunc(q.start_date, month)) as year_month,
        q.country_id,
        COUNT(CASE WHEN q.nps_group = 'Promoter' THEN q.response_id END) as promoters,
        COUNT(CASE WHEN q.nps_group = 'Detractor' THEN q.response_id END) as detractors,
        COUNT(q.response_id) as total_responses
    FROM `peya-bi-tools-pro.il_nps.fact_qualtrics` q
    left join `peya-bi-tools-pro.il_core.dim_partner` p on q.partner_id = p.partner_id
    WHERE q.start_date >>= '2022-01-01' and nps_type in ('NPS Existing Partners', 'NPS New Partners')
    and q.nps_reason_label in('Business Improvement Advicing from AMs')
    and p.business_type_id in (1,7)
    group by 1,2

),

food_O6_NCR_Ads AS(
    SELECT 
             DATE_TRUNC(DATE(p.full_date), MONTH) AS month_date,
             co.country_id,
             ROUND(SUM(CASE WHEN p.has_confirmed_orders = TRUE AND p.business_type IN (1,7) THEN p.total_featured_product / ce.rate_eu ELSE NULL END),2) AS total_featured_products,
             ROUND(SUM(CASE WHEN p.has_confirmed_orders = TRUE AND p.business_type IN (1,7) THEN p.total_gold_vip / ce.rate_eu ELSE NULL END),2) AS total_gold_vip,
             ROUND(SUM(CASE WHEN p.has_confirmed_orders = TRUE AND p.business_type IN (1,7) THEN p.total_gold_vip_category / ce.rate_eu ELSE NULL END),2) AS total_gold_vip_category,
             ROUND(SUM(CASE WHEN p.has_confirmed_orders = TRUE AND p.business_type IN (1,7) THEN p.joker_fee/ ce.rate_eu ELSE NULL END),2) AS total_joker            
     FROM `peya-bi-tools-pro.il_core.fact_partners_monthly` AS p
     LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS co ON  co.country_id = p.country_id and co.active 
     LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` AS ce ON ce.currency_exchange_date = DATE_TRUNC(DATE(p.full_date),MONTH) AND ce.currency_id = co.currency_id
     WHERE DATE(p.full_date) >>= DATE('2022-01-01')
     GROUP BY 1,2),

food_O6_avg_commission_revenue_per_order AS(
    SELECT
        date_trunc(registered_date,month) as year_month,
        c.country_id,
        ce.rate_eu,
        count (distinct order_id) total_orders,
        cast(cast(round(sum(o.commission_amount),2) as numeric) as float64) AS commission_revenue_LC
    FROM `peya-bi-tools-pro.il_core.fact_orders` AS o 
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS c ON c.country_id = o.country_id AND c.active = true
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` ce 
       ON ce.currency_id = c.currency_id AND date_trunc(registered_date,month) = ce.currency_exchange_date
    WHERE registered_date >>= '2022-01-01' and lower(business_type.business_type_name) in ('restaurant','coffee')
    AND o.order_status = 'CONFIRMED'
    GROUP BY 1,2,3   
)
SELECT 
	fO1.country_name
    ,fO1.country_id 
	,fO1.year_month
	,fO1.confirmed_orders
	,fO1.confirmed_orders_pick_up
    ,fO1_ap.active_partners_with_orders
    ,fO1_concepts.fact_partner_funnel_sessions_funnel_shop_details
    ,fO1_concepts.fact_partner_funnel_sessions_funnel_shop_transaction
    ,fO2_bi.responses_b
    ,fO2_bi.detractors_b
    ,fO2_bi.promoters_b
    ,fO2_ca.responses_ca
    ,fO2_ca.detractors_ca
    ,fO2_ca.promoters_ca
    ,fO2_ma.responses_m
    ,fO2_ma.detractors_m
    ,fO2_ma.promoters_m
    ,fO2_lo.responses_lo
    ,fO2_lo.detractors_lo
    ,fO2_lo.promoters_lo
    ,f03_CVR2_MCVR3.food_transactions as CVR2_num
    ,f03_CVR2_MCVR3.food_shop_list_visits as CVR2_den
    ,f03_CVR2_MCVR3.food_checkout_visits as mCVR3_num
    ,f03_CVR2_MCVR3.food_shop_details_visits as mCVR3_den
    ,f03_DLP.total_images
    ,f03_DLP.total_products
    ,f03_NPS.promoters as NPS_survey_promoters
    ,f03_NPS.detractors as NPS_survey_detractos
    ,f03_NPS.responses as NPS_survey_responses
    ,fO4_GMV.discount_amount_euro
    ,fO4_GMV.GMV_Gross_eur
    ,fO4_Peya_plus.active_partners_by_month
    ,fO4_Peya_plus.plus_partners_subs
	,fO5_VFR.non_confirmed_orders as fail_rate_num
	,fO5_VFR.total_orders_all_status as fail_rate_den
	,fO5_VL.vendor_late_5
	,fO5_VL.vendor_late_10
	,fO5_VL.vendor_late_15
	,fO5_VL.vendor_late_base
    ,fO5_Ret_rate.users_base
    ,fO5_Ret_rate.users_reordered
	,fO3_NPSAO.promoters as NPS_PROMOTERS_AO
	,fO3_NPSAO.detractors as NPS_DETRACTORS_AO
	,fO3_NPSAO.responses as NPS_TOTAL_RESPONSES_AO
    ,NPS_partners.promoters as Partner_promoters
    ,NPS_partners.detractors as Partner_detractors
    ,NPS_partners.total_responses as Partner_responses
    ,fO6.total_featured_products
    ,fO6.total_gold_vip
    ,fO6.total_gold_vip_category
    ,fO6.total_joker
    ,fO6_commission.total_orders
    ,fO6_commission.commission_revenue_LC
    ,fO6_commission.rate_eu
FROM food_O1 AS fO1
LEFT JOIN food_O1_active_partners AS fO1_ap
    ON fO1.country_id = fO1_ap.country_id
    AND fO1.year_month = fO1_ap.registered_date
LEFT JOIN food_O1_concepts_CVR3  as fO1_concepts
    ON fO1.country_id = fO1_concepts.country_id
    AND fO1.year_month = fO1_concepts.year_month
LEFT JOIN food_O2_NPS_Business_improvement fO2_bi
 ON fO1.country_id = fO2_bi.country_id
 AND fO1.year_month = fO2_bi.mes_respuesta
 LEFT JOIN food_O2_NPS_Care  fO2_ca
 ON fO1.country_id = fO2_ca.country_id
 AND fO1.year_month = fO2_ca.mes_respuesta
 LEFT JOIN food_O2_NPS_Management  fO2_ma
 ON fO1.country_id = fO2_ma.country_id
 AND fO1.year_month = fO2_ma.mes_respuesta
 LEFT JOIN food_O2_NPS_logistics  fO2_lo
 ON fO1.country_id = fO2_lo.country_id
 AND fO1.year_month = fO2_lo.mes_respuesta
LEFT JOIN food_O3_CVR2_MCVR3 as f03_CVR2_MCVR3
	ON fO1.country_id = f03_CVR2_MCVR3.country_id
	AND fO1.year_month = f03_CVR2_MCVR3.month_year	
LEFT JOIN food_O3_NPS_survey f03_NPS
    ON fO1.country_id = f03_NPS.country_id
    AND fO1.year_month = f03_NPS.year_month
LEFT JOIN food_O4_vfd_gmv fO4_GMV
    ON fO1.country_id = fO4_GMV.country_id
    AND fO1.year_month = fO4_GMV.month_year
LEFT JOIN food_O4_Partners_Peya_Plus fO4_Peya_plus
    ON fO1.country_id = fO4_Peya_plus.country_id
    AND fO1.year_month = fO4_Peya_plus.month_year
LEFT JOIN food_O5_vendor_fail_rate fO5_VFR
	ON fO1.country_id = fO5_VFR.country_id
	AND fO1.year_month = fO5_VFR.year_month
LEFT JOIN food_O5_vendor_late fO5_VL
	ON fO1.country_id = fO5_VL.country_id
	AND fO1.year_month = fO5_VL.year_month	
LEFT JOIN food_O5_Retention_rate_new_customers fO5_Ret_rate
    ON fO1.country_id = fO5_Ret_rate.country_id
    AND fO1.year_month = fO5_Ret_rate.month_year
LEFT JOIN food_O3_NPS_AO fO3_NPSAO
	ON fO1.country_id = fO3_NPSAO.country_id
	AND fO1.year_month = fO3_NPSAO.year_month
LEFT JOIN food_O6_NCR_Ads as fO6
    ON fO1.country_id = fO6.country_id
    AND fO1.year_month = fO6.month_date
LEFT JOIN food_O6_avg_commission_revenue_per_order fO6_commission 
    ON  fO1.country_id = fO6_commission.country_id
    AND fO1.year_month = fO6_commission.year_month
LEFT JOIN food_O3_DLP as f03_DLP
    ON fO1.country_id = f03_DLP.country_id
    AND fO1.year_month = f03_DLP.year_month
LEFT JOIN food_NPS_Partners_business_improvement AS NPS_partners
    ON fO1.country_id = NPS_partners.country_id
    AND fO1.year_month = NPS_partners.year_month]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
