            <column caption='KPI Food label int' datatype='real' name='[Calculation_1364590687360860165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;3&apos; THEN SUM([active_partners_with_orders])&#13;&#10;WHEN &apos;20&apos; THEN [Calculation_1364590755145498627]&#13;&#10;WHEN &apos;24&apos; THEN [Calculation_446700807165091844]&#13;&#10;ELSE null&#13;&#10;END' />
            </column>
            <column caption='KPI Food label %' datatype='real' name='[Calculation_1364590687361646598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;17&apos; THEN [Calculation_1219912559795642368]&#13;&#10;WHEN &apos;8&apos; THEN [Calculation_1130122036525203461]&#13;&#10;WHEN &apos;9&apos; THEN [Calculation_1130122036526809095]&#13;&#10;WHEN &apos;2&apos; THEN [Calculation_1364590755141746688]&#13;&#10;WHEN &apos;18&apos; THEN    [Calculation_1364590755143434241]&#13;&#10;WHEN &apos;19&apos; THEN [Calculation_1364590755143806978]&#13;&#10;WHEN &apos;25&apos; THEN [Calculation_288793346951495691]&#13;&#10;WHEN &apos;26&apos; THEN [Calculation_288793346952323084]&#13;&#10;WHEN &apos;27&apos; THEN [Calculation_288793346952581133]&#13;&#10;WHEN &apos;28&apos; THEN [Calculation_288793346952810510]&#13;&#10;WHEN &apos;21&apos; THEN [Calculation_446700807160307712]&#13;&#10;WHEN &apos;22&apos; THEN [Calculation_446700807161081857]&#13;&#10;WHEN &apos;31&apos; THEN [Calculation_288793346258305024]&#13;&#10;WHEN &apos;32&apos; THEN SUM([federated.1oiuemu1q0dgyw18885ml028xl7h].[Calculation_288793346262339585])&#13;&#10;WHEN &apos;23&apos; THEN [Calculation_446700807163686914]&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END' />
