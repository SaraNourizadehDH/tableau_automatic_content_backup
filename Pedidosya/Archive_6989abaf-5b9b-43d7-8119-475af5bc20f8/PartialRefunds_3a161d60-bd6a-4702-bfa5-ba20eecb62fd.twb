        <relation connection='presto.0kzrm511s33d5012ua0bb0jxl7ar' name='Custom SQL Query' type='text'>SELECT &#13;
	u.user_email, o.order_id, p.restaurant_name, p.business_name, date_created,	operation_date,	state,	reject_reason,	type,	amount,	description&#13;
FROM (&#13;
	SELECT * &#13;
	FROM datalake.payments_refund &#13;
    WHERE&#13;
		CAST(SUBSTR(yyyymmdd, 1, 6) AS BIGINT) &gt;&gt;= YEAR(DATE_ADD(&apos;month&apos;, -6, DATE_TRUNC(&apos;month&apos;, CURRENT_DATE)))*100 + MONTH(DATE_ADD(&apos;month&apos;, -6, DATE_TRUNC(&apos;month&apos;, CURRENT_DATE)))&#13;
) ref&#13;
INNER JOIN( &#13;
	SELECT * FROM sensitive_data.users WHERE user_email in (&apos;andres.buadas@pedidosya.com&apos;,	&apos;barbara.araneda@pedidosya.com&apos;,	&apos;santiago.bica@pedidosya.com&apos;,&apos;hamilton.suarez@pedidosya.com&apos;,	&apos;tatiana.gutierrez@pedidosya.com&apos;,	&apos;valentina.castro@pedidosya.com&apos;,	&apos;angely.ramirez@pedidosya.com&apos;,&apos;jose.noguera@pedidosya.com&apos;,	&apos;felipe.collazo@pedidosya.com&apos;,	&apos;gaia.grana@pedidosya.com&apos;,	&apos;lucas.lanterna@pedidosya.com&apos;,	&apos;carlos.alvarez@pedidosya.com&apos;,	&apos;leticia.navarro@pedidosya.com&apos;,	&apos;gaston.sendic@pedidosya.com&apos;,	&apos;kimberlee.de@pedidosya.com&apos;,	&apos;eddalis.guerrero@pedidosya.com&apos;,	&apos;ernestina.haller@pedidosya.com&apos;,	&apos;florencia.gomez@pedidosya.com&apos;,	&apos;georgina.lema@pedidosya.com&apos;,	&apos;gonzalo.acosta@pedidosya.com&apos;,	&apos;guadalupe.pintos@pedidosya.com&apos;,	&apos;nahuel.arce@pedidosya.com&apos;,	&apos;nahuel.delossantos@pedidosya.com&apos;,	&apos;nicolas.cladera@pedidosya.com&apos;,	&apos;nicolas.sosa@pedidosya.com&apos;,	&apos;nicolas.zerboni@pedidosya.com&apos;,	&apos;camila.urbin@pedidosya.com&apos;,	&apos;carlos.contreras@pedidosya.com&apos;,	&apos;romina.fleitas@pedidosya.com&apos;,	&apos;catherine.sosa@pedidosya.com&apos;,	&apos;hernan.castro@pedidosya.com&apos;,	&apos;lucas.deccia@pedidosya.com&apos;,	&apos;sabrina.ferreira@pedidosya.com&apos;,	&apos;cristian.larraza@pedidosya.com&apos;,	&apos;andrea.garcia@pedidosya.com&apos;,	&apos;geremias.fernandez@pedidosya.com&apos;,	&apos;shezabel.martinez@pedidosya.com&apos;,	&apos;diana.rivas@pedidosya.com&apos;,	&apos;martin.escobar@pedidosya.com&apos;)&#13;
) u ON ref.user_id = u.user_id&#13;
LEFT JOIN (&#13;
	SELECT &#13;
		payment_id, order_id &#13;
	FROM datalake.payments&#13;
    WHERE&#13;
		CAST(SUBSTR(yyyymmdd, 1, 6) AS BIGINT) &gt;&gt;= YEAR(DATE_ADD(&apos;month&apos;, -6, DATE_TRUNC(&apos;month&apos;, CURRENT_DATE)))*100 + MONTH(DATE_ADD(&apos;month&apos;, -6, DATE_TRUNC(&apos;month&apos;, CURRENT_DATE)))&#13;
) pay ON ref.payment_id = pay.payment_id&#13;
LEFT JOIN (&#13;
	SELECT order_id, restaurant_id FROM datalake.orders &#13;
	WHERE&#13;
		CAST(yyyymm AS BIGINT) &gt;&gt;= YEAR(DATE_ADD(&apos;month&apos;, -6, DATE_TRUNC(&apos;month&apos;, CURRENT_DATE)))*100 + MONTH(DATE_ADD(&apos;month&apos;, -6, DATE_TRUNC(&apos;month&apos;, CURRENT_DATE)))&#13;
) o ON pay.order_id = o.order_id&#13;
LEFT JOIN (&#13;
	SELECT restaurant_id, restaurant_name, business_name FROM datalake.partners&#13;
) p on o.restaurant_id = p.restaurant_id</relation>
