    <worksheet name='Partner Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>By Bucket</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Consulta SQL personalizada (datalake)' name='federated.0c4wl3i0w7641j198nsmj1s79gbf' />
          </datasources>
          <datasource-dependencies datasource='federated.0c4wl3i0w7641j198nsmj1s79gbf'>
            <column caption='Area Name1' datatype='string' name='[Area Name]' role='dimension' type='nominal' />
            <column caption='VL &gt; 10 (W/o Stacking)' datatype='real' name='[Calculation_1478869537344987137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vl_num_nstacking])/sum([vl_den_nstacking])' />
            </column>
            <column caption='% Stacking' datatype='real' name='[Calculation_1478869537645400066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([confirmed_orders_stacking])/sum([confirmed_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_174795971751698433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rejected_orders])/sum([total_orders])' />
            </column>
            <column caption='VFR' datatype='real' name='[Calculation_174795972009242627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_rejected_orders])/sum([total_orders])' />
            </column>
            <column caption='VL &gt; 10 min' datatype='real' name='[Calculation_174795972014481412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vl_num])/sum([vl_den])' />
            </column>
            <column caption='RL &gt; 10 min' datatype='real' name='[Calculation_174795972014997509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rl_num])/sum([rl_den])' />
            </column>
            <column caption='Avg Estim Prep Time (W)' datatype='real' name='[Calculation_174795972037038090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([estim_prep_time]*[confirmed_orders])/sum([confirmed_orders])' />
            </column>
            <column caption='Order hour (bucket)' datatype='string' name='[Calculation_1750492901605408771]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_hour] = 8 THEN &apos;8_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 9 THEN &apos;9_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 10 THEN &apos;10_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 11 THEN &apos;11_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 12 THEN &apos;12_lunch&apos;&#13;&#10;ELSEIF [order_hour] = 13 THEN &apos;13_lunch&apos;&#13;&#10;ELSEIF [order_hour] = 14 THEN &apos;14_lunch&apos;&#13;&#10;ELSEIF [order_hour] = 15 THEN &apos;15_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 16 THEN &apos;16_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 17 THEN &apos;17_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 18 THEN &apos;18_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 19 THEN &apos;19_dinner&apos;&#13;&#10;ELSEIF [order_hour] = 20 THEN &apos;20_dinner&apos;&#13;&#10;ELSEIF [order_hour] = 21 THEN &apos;21_dinner&apos;&#13;&#10;ELSEIF [order_hour] = 22 THEN &apos;22_postdinner&apos;&#13;&#10;ELSEIF [order_hour] = 23 THEN &apos;23_postdinner&apos;&#13;&#10;ELSEIF [order_hour] = 0 THEN &apos;0_night&apos;&#13;&#10;ELSEIF [order_hour] = 1 THEN &apos;1_night&apos;&#13;&#10;ELSEIF [order_hour] = 2 THEN &apos;2_night&apos;&#13;&#10;ELSEIF [order_hour] = 3 THEN &apos;3_night&apos;&#13;&#10;ELSEIF [order_hour] = 4 THEN &apos;4_night&apos;&#13;&#10;ELSEIF [order_hour] = 5 THEN &apos;5_night&apos;&#13;&#10;ELSEIF [order_hour] = 6 THEN &apos;6_night&apos;&#13;&#10;ELSEIF [order_hour] = 7 THEN &apos;7_night&apos;&#13;&#10;END' />
            </column>
