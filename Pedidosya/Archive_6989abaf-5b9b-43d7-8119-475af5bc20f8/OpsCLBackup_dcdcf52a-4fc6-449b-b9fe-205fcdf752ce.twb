      <column caption='Account Owner1' datatype='string' hidden='true' name='[Account Owner]' role='dimension' type='nominal' />
      <column caption='Area Name1' datatype='string' name='[Area Name]' role='dimension' type='nominal' />
      <column caption='*Conf Order WoW' datatype='real' name='[Calculation_1215690457539624962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([confirmed_orders])) - LOOKUP(ZN(SUM([confirmed_orders])), -1)) / ABS(LOOKUP(ZN(SUM([confirmed_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='* VL WoW' datatype='real' name='[Calculation_1215690457540599811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_174795972014481412]) - LOOKUP(ZN([Calculation_174795972014481412]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='* RL WoW' datatype='real' name='[Calculation_1215690457540952068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_174795972014997509]) - LOOKUP(ZN([Calculation_174795972014997509]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='VL &gt; 10 (Stacking)' datatype='real' name='[Calculation_1478869537344827392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vl_num_stacking])/sum([vl_den_stacking])' />
      </column>
      <column caption='VL &gt; 10 (W/o Stacking)' datatype='real' name='[Calculation_1478869537344987137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vl_num_nstacking])/sum([vl_den_nstacking])' />
      </column>
      <column caption='% Stacking' datatype='real' name='[Calculation_1478869537645400066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders_stacking])/sum([confirmed_orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_174795971751698433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rejected_orders])/sum([total_orders])' />
      </column>
      <column caption='VFR' datatype='real' name='[Calculation_174795972009242627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_rejected_orders])/sum([total_orders])' />
      </column>
      <column caption='VL &gt; 10 min' datatype='real' name='[Calculation_174795972014481412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vl_num])/sum([vl_den])' />
      </column>
      <column caption='RL &gt; 10 min' datatype='real' name='[Calculation_174795972014997509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rl_num])/sum([rl_den])' />
      </column>
      <column caption='Avg Estim Prep Time (W)' datatype='real' name='[Calculation_174795972037038090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([estim_prep_time]*[confirmed_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='Avg HBT (W)' datatype='real' name='[Calculation_174795972043583500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hold_back_time]*([confirmed_orders]+[rejected_orders]))/sum([confirmed_orders]+[rejected_orders])' />
      </column>
      <column caption='Avg DT (W)' datatype='real' name='[Calculation_174795972044668941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders]*[act_dt])/sum([confirmed_orders])' />
      </column>
      <column caption='Past 4 Weeks' datatype='date' name='[Calculation_174795972069855246]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [week]&lt; DATEADD(&apos;week&apos;, -4,today())&#13;&#10;OR [week]&gt; DATEADD(&apos;week&apos;, 1,today())&#13;&#10;THEN NULL&#13;&#10;ELSE [week]&#13;&#10;END' />
      </column>
      <column caption='Past 7 Days' datatype='date' name='[Calculation_174795972083527696]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [day] &lt; DATEADD(&apos;day&apos;, -8,today())&#13;&#10;OR [day] &gt; DATEADD(&apos;day&apos;, 1,today())&#13;&#10;THEN NULL&#13;&#10;ELSE [day]&#13;&#10;END' />
      </column>
      <column caption='Order hour (bucket)' datatype='string' name='[Calculation_1750492901605408771]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_hour] = 8 THEN &apos;8_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 9 THEN &apos;9_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 10 THEN &apos;10_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 11 THEN &apos;11_breakfast&apos;&#13;&#10;ELSEIF [order_hour] = 12 THEN &apos;12_lunch&apos;&#13;&#10;ELSEIF [order_hour] = 13 THEN &apos;13_lunch&apos;&#13;&#10;ELSEIF [order_hour] = 14 THEN &apos;14_lunch&apos;&#13;&#10;ELSEIF [order_hour] = 15 THEN &apos;15_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 16 THEN &apos;16_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 17 THEN &apos;17_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 18 THEN &apos;18_afternoon&apos;&#13;&#10;ELSEIF [order_hour] = 19 THEN &apos;19_dinner&apos;&#13;&#10;ELSEIF [order_hour] = 20 THEN &apos;20_dinner&apos;&#13;&#10;ELSEIF [order_hour] = 21 THEN &apos;21_dinner&apos;&#13;&#10;ELSEIF [order_hour] = 22 THEN &apos;22_postdinner&apos;&#13;&#10;ELSEIF [order_hour] = 23 THEN &apos;23_postdinner&apos;&#13;&#10;ELSEIF [order_hour] = 0 THEN &apos;0_night&apos;&#13;&#10;ELSEIF [order_hour] = 1 THEN &apos;1_night&apos;&#13;&#10;ELSEIF [order_hour] = 2 THEN &apos;2_night&apos;&#13;&#10;ELSEIF [order_hour] = 3 THEN &apos;3_night&apos;&#13;&#10;ELSEIF [order_hour] = 4 THEN &apos;4_night&apos;&#13;&#10;ELSEIF [order_hour] = 5 THEN &apos;5_night&apos;&#13;&#10;ELSEIF [order_hour] = 6 THEN &apos;6_night&apos;&#13;&#10;ELSEIF [order_hour] = 7 THEN &apos;7_night&apos;&#13;&#10;END' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_2316257614927130630]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Measure' datatype='real' name='[Calculation_2316257614928834569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Dimension 3 Criteria (copia)_2316257614900514821]&#13;&#10;WHEN &apos;VFR&apos; THEN sum([vendor_rejected_orders])/sum([total_orders])&#13;&#10;WHEN &apos;VL W/o Stacking&apos; THEN sum([vl_num_nstacking])/sum([vl_den_nstacking])&#13;&#10;END' />
      </column>
      <column caption='Measure Criteria' datatype='real' name='[Calculation_2316257614933012492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Dimension 3 Criteria (copia)_2316257614900514821]&#13;&#10;WHEN &apos;VFR&apos; THEN&#13;&#10;{ FIXED CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, CASE [Parameters].[Select Dimension 1 Criteria (copia)_2316257614900277251]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, CASE [Parameters].[Select Dimension 2 Criteria (copia)_2316257614900441092]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, [week]:SUM([vendor_rejected_orders])/SUM([total_orders])}&#13;&#10;WHEN &apos;VL W/o Stacking&apos; THEN&#13;&#10;{ FIXED CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, CASE [Parameters].[Select Dimension 1 Criteria (copia)_2316257614900277251]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, CASE [Parameters].[Select Dimension 2 Criteria (copia)_2316257614900441092]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, [week]:SUM([vl_num_nstacking])/SUM([vl_den_nstacking])}&#13;&#10;END' />
      </column>
