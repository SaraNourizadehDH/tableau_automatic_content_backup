            <column caption='Confirmed Orders' datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_174795972043583500]' derivation='User' name='[diff:usr:Calculation_174795972043583500:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
