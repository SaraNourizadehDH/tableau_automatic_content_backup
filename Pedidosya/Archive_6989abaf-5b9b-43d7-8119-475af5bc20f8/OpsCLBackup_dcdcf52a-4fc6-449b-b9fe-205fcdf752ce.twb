eya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, CASE [Parameters].[Select Dimension 1 Criteria (copia)_2316257614900277251]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, CASE [Parameters].[Select Dimension 2 Criteria (copia)_2316257614900441092]&#13;&#10;WHEN &apos;City Name&apos; THEN [city_name]&#13;&#10;WHEN &apos;Area Name&apos; THEN [area_name]&#13;&#10;WHEN &apos;Area Peya&apos; THEN [Area Name]&#13;&#10;WHEN &apos;Business Name&apos; THEN [business_name]&#13;&#10;WHEN &apos;Account Owner&apos; THEN [account_owner]&#13;&#10;WHEN &apos;Franchise&apos; THEN [franchise_name]&#13;&#10;WHEN &apos;PQP&apos; THEN [PQP Advisor]&#13;&#10;WHEN &apos;N/A&apos; THEN &apos;&apos;&#13;&#10;END, [week]:SUM([vl_num_nstacking])/SUM([vl_den_nstacking])}&#13;&#10;END' />
