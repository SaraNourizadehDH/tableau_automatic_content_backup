            <column caption='# Abandoned' datatype='integer' name='[Calculation_1036109429633818636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [chat_abandoned] &gt; 0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% Abandoned' datatype='real' name='[Calculation_1036109429633994765]' role='measure' type='quantitative'>
