          <datasource-dependencies datasource='federated.00z2asf0hwfv6s1dhqcf31vylt8g'>
            <column caption='% Chat WT 60 &lt; 120s' datatype='real' name='[% Chat WT 30 &lt; 60s (copia)_1036109429959696406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Chat WT  30 &lt; 60s (copia)_1036109429959438356])/sum([Chats])' />
            </column>
            <column caption='% Chat WT &gt; 120s' datatype='real' name='[% Chat WT &lt; 120s (copia)_1036109429632860170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Chat WT &lt; 60s (copia)_1036109429632376838])/sum([Chats])' />
            </column>
            <column caption='% Chat WT 30 &lt; 60s' datatype='real' name='[% Chat WT &lt; 30s (copia)_1036109429959581717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Chat WT &lt; 30s (copia)_1036109429959159827])/sum([Chats])' />
            </column>
            <column datatype='string' name='[Area Name]' role='dimension' type='nominal' />
            <column caption='Chat wait time (min)' datatype='real' name='[Calculation_1036109429625802755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Chat_wait_time]/60' />
            </column>
            <column caption='Chat WT &lt; 30s' datatype='integer' name='[Calculation_1036109429631991812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Chat_wait_time] &lt; 30 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% Chat WT &lt; 30s' datatype='real' name='[Calculation_1036109429632512007]' role='measure' type='quantitative'>
