      <table>
        <view>
          <datasources>
            <datasource caption='partners contact+ (Varias conexiones)' name='federated.00z2asf0hwfv6s1dhqcf31vylt8g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00z2asf0hwfv6s1dhqcf31vylt8g'>
            <column caption='% Chat WT 60 &lt; 120s' datatype='real' name='[% Chat WT 30 &lt; 60s (copia)_1036109429959696406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Chat WT  30 &lt; 60s (copia)_1036109429959438356])/sum([Chats])' />
            </column>
            <column caption='% Chat WT &gt; 120s' datatype='real' name='[% Chat WT &lt; 120s (copia)_1036109429632860170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Chat WT &lt; 60s (copia)_1036109429632376838])/sum([Chats])' />
            </column>
            <column caption='% Chat WT 30 &lt; 60s' datatype='real' name='[% Chat WT &lt; 30s (copia)_1036109429959581717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Chat WT &lt; 30s (copia)_1036109429959159827])/sum([Chats])' />
            </column>
            <column datatype='string' name='[Area Name]' role='dimension' type='nominal' />
            <column caption='Chat wait time (min)' datatype='real' name='[Calculation_1036109429625802755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Chat_wait_time]/60' />
            </column>
            <column caption='Chat WT &lt; 30s' datatype='integer' name='[Calculation_1036109429631991812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Chat_wait_time] &lt; 30 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% Chat WT &lt; 30s' datatype='real' name='[Calculation_1036109429632512007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1036109429631991812])/sum([Chats])' />
            </column>
            <column caption='# Abandoned' datatype='integer' name='[Calculation_1036109429633818636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [chat_abandoned] &gt; 0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='% Abandoned' datatype='real' name='[Calculation_1036109429633994765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1036109429633818636])/sum([Chats])' />
            </column>
            <column caption='Period Dim' datatype='date' name='[Calculation_1036109429955444751]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Date(DATETRUNC([Parameters].[Parámetro 1],[Created_day]))' />
            </column>
            <column caption='ISOWeek' datatype='integer' name='[Calculation_1036109431088463896]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ISOWEEK([Created_week])' />
            </column>
            <column caption='Chat WT  60 &lt; 120s' datatype='integer' name='[Chat WT  30 &lt; 60s (copia)_1036109429959438356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Chat_wait_time] &gt;= 60 AND [Chat_wait_time] &lt; 120 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Chat WT  30 &lt; 60s' datatype='integer' name='[Chat WT &lt; 30s (copia)_1036109429959159827]' role='measure' type='quantitative'>
