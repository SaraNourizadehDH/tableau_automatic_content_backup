            <column caption='3. VFR Wednesdays' datatype='real' default-format='p0.0%' name='[1. VFR Mondays (copia 2) (copia)_1286340702458355744]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM([partnerRejected in1.Monday (copia) (copia 2)_1286340702453075980])/SUM([partnerTotalOrders in1.Monday (copia 2) (copia)_1286340702457397274])' />
