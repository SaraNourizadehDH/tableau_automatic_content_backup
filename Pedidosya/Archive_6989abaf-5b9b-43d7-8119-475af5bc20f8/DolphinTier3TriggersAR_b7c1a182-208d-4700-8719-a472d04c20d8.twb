    <worksheet name='Hoja 4'>
      <table>
        <view>
          <datasources>
            <datasource caption='Tableau_Dolphin_AR (user_cristian_haberl)' name='federated.1yrdyeg145yf0v18aqyr80atmw66' />
          </datasources>
          <datasource-dependencies datasource='federated.1yrdyeg145yf0v18aqyr80atmw66'>
            <column caption='Account Executive' datatype='string' name='[Account_Owner]' role='dimension' type='nominal' />
            <column datatype='string' name='[Agente de Performance (Area)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Agente de Performance (City)]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[Agente de Performance (KA)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Agente de Performance (Partner)]' role='dimension' type='nominal' />
            <column caption='Remaining Closed Time' datatype='string' name='[Calculation_1286340702405701632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    [remaining FFEE (copia)_1286340702411522050] = 1000&#13;&#10;THEN&#13;&#10;    &quot;Case closed&quot;&#13;&#10;ELSE&#13;&#10;    IF &#13;&#10;        [remaining FFEE (copia)_1286340702411522050] = 1&#13;&#10;    THEN&#13;&#10;        STR(DATEDIFF(&apos;day&apos;,TODAY(),[outFFEE])) +&#13;&#10;        &quot; day remaining&quot;&#13;&#10;    ELSE&#13;&#10;        STR(DATEDIFF(&apos;day&apos;,TODAY(),[outFFEE])) +&#13;&#10;        &quot; days remaining&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Team Leader' datatype='string' name='[Calculation_1286340702414917635]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([xFranchise])&#13;&#10;THEN [Team Leader (KA)]&#13;&#10;ELSE &#13;&#10;    IF NOT ISNULL([xCity])&#13;&#10;    THEN [Team Leader (City)]&#13;&#10;    ELSE&#13;&#10;        IF NOT ISNULL([xArea])&#13;&#10;        THEN [Team Leader (Area)]&#13;&#10;        ELSE &quot;Error de Asignación&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='PQP' datatype='string' name='[Calculation_338614455549448206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [business_type_name] = &quot;Coffee&quot; &#13;&#10;    AND ISNULL([xFranchise])&#13;&#10;    AND [city] IN (&quot;Buenos Aires&quot;,&#13;&#10;                    &apos;Almirante Brown&apos;, &#13;&#10;                    &apos;Avellaneda&apos;, &#13;&#10;                    &apos;Berazategui&apos;, &#13;&#10;                    &apos;Esteban Echeverría&apos;, &#13;&#10;                    &apos;Ezeiza&apos;, &#13;&#10;                    &apos;Florencio Varela&apos;, &#13;&#10;                    &apos;Lanús&apos;, &#13;&#10;                    &apos;Lomas de Zamora&apos;, &#13;&#10;                    &apos;Presidente Perón&apos;, &#13;&#10;                    &apos;Quilmes&apos;, &#13;&#10;                    &apos;ZONA OESTE&apos;, &#13;&#10;                    &apos;Hurlingham&apos;, &#13;&#10;                    &apos;Ituzaingó&apos;, &#13;&#10;                    &apos;La Matanza&apos;, &#13;&#10;                    &apos;Luján&apos;, &#13;&#10;                    &apos;Merlo&apos;, &#13;&#10;                    &apos;Moreno&apos;, &#13;&#10;                    &apos;Morón&apos;, &#13;&#10;                    &apos;San Miguel&apos;, &#13;&#10;                    &apos;3 de Febrero&apos;, &#13;&#10;                    &apos;ZONA NORTE&apos;, &#13;&#10;                    &apos;Vicente López&apos;, &#13;&#10;                    &apos;San Martín&apos;, &#13;&#10;                    &apos;San Isidro&apos;, &#13;&#10;                    &apos;Tigre&apos;, &#13;&#10;                    &apos;Pilar&apos;, &#13;&#10;                    &apos;José C Paz&apos;, &#13;&#10;                    &apos;Malvinas Argentinas&apos;, &#13;&#10;                    &apos;Escobar&apos;, &#13;&#10;                    &apos;San Fernando&apos;, &#13;&#10;                    &apos;Zárate&apos;, &#13;&#10;                    &apos;Campana&apos;, &#13;&#10;                    &apos;INTERIOR&apos;, &#13;&#10;                    &apos;