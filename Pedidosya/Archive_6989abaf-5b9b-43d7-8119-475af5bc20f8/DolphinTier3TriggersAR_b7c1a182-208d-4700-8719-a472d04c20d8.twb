        <column caption='PQP' datatype='string' name='[Calculation_338614455549448206]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [business_type_name] = &quot;Coffee&quot; &#13;&#10;    AND ISNULL([xFranchise])&#13;&#10;    AND [city] IN (&quot;Buenos Aires&quot;,&#13;&#10;                    &apos;Almirante Brown&apos;, &#13;&#10;                    &apos;Avellaneda&apos;, &#13;&#10;                    &apos;Berazategui&apos;, &#13;&#10;                    &apos;Esteban Echeverría&apos;, &#13;&#10;                    &apos;Ezeiza&apos;, &#13;&#10;                    &apos;Florencio Varela&apos;, &#13;&#10;                    &apos;Lanús&apos;, &#13;&#10;                    &apos;Lomas de Zamora&apos;, &#13;&#10;                    &apos;Presidente Perón&apos;, &#13;&#10;                    &apos;Quilmes&apos;, &#13;&#10;                    &apos;ZONA OESTE&apos;, &#13;&#10;                    &apos;Hurlingham&apos;, &#13;&#10;                    &apos;Ituzaingó&apos;, &#13;&#10;                    &apos;La Matanza&apos;, &#13;&#10;                    &apos;Luján&apos;, &#13;&#10;                    &apos;Merlo&apos;, &#13;&#10;                    &apos;Moreno&apos;, &#13;&#10;                    &apos;Morón&apos;, &#13;&#10;                    &apos;San Miguel&apos;, &#13;&#10;                    &apos;3 de Febrero&apos;, &#13;&#10;                    &apos;ZONA NORTE&apos;, &#13;&#10;                    &apos;Vicente López&apos;, &#13;&#10;                    &apos;San Martín&apos;, &#13;&#10;                    &apos;San Isidro&apos;, &#13;&#10;                    &apos;Tigre&apos;, &#13;&#10;                    &apos;Pilar&apos;, &#13;&#10;                    &apos;José C Paz&apos;, &#13;&#10;                    &apos;Malvinas Argentinas&apos;, &#13;&#10;                    &apos;Escobar&apos;, &#13;&#10;                    &apos;San Fernando&apos;, &#13;&#10;                    &apos;Zárate&apos;, &#13;&#10;                    &apos;Campana&apos;, &#13;&#10;                    &apos;INTERIOR&apos;, &#13;&#10;                    &apos;Necochea&apos;, &#13;&#10;                    &apos;Pinamar&apos;, &#13;&#10;                    &apos;Villa Gesell&apos;, &#13;&#10;                    &apos;La Costa&apos;, &#13;&#10;                    &apos;Mar del Plata&apos;, &#13;&#10;                    &apos;La Plata&apos;, &#13;&#10;                    &apos;Berisso&apos;, &#13;&#10;                    &apos;General Rodríguez&apos;, &#13;&#10;                    &apos;9 de Julio&apos;, &#13;&#10;                    &apos;Carmen de Patagones&apos;, &#13;&#10;                    &apos;Cañuelas&apos;, &#13;&#10;                    &apos;Azul&apos;, &#13;&#10;                    &apos;Baradero&apos;, &#13;&#10;                    &apos;Bragados&apos;, &#13;&#10;                    &apos;Coronel Dorrego&apos;, &#13;&#10;                    &apos;Coronel Suárez&apos;, &#13;&#10;                    &apos;General Villegas&apos;, &#13;&#10;                    &apos;San Miguel del Monte&apos;, &#13;&#10;                    &apos;Tres Arroyos&apos;, &#13;&#10;                    &apos;Chivilcoy&apos;, &#13;&#10;                    &apos;Marcos Paz&apos;, &#13;&#10;                    &apos;Juan José Castelli&apos;, &#13;&#10;                    &apos;Lincoln&apos;, &#13;&#10;                    &apos;Ramallo&apos;, &#13;&#10;                    &apos;Rojas&apos;, &#13;&#10;                    &apos;San Vicente&apos;, &#13;&#10;                    &apos;Villa Ocampo&apos;, &#13;&#10;                    &apos;Bella Vista&apos;, &#13;&#10;                    &apos;Chacabuco&apos;, &#13;&#10;                    &apos;Mercedes&apos;, &#13;&#10;                    &apos;Exaltación de la Cruz&apos;, &#13;&#10;                    &apos;General Alvear&apos;, &#13;&#10;                    &apos;Gral. José de San Martín&apos;)&#13;&#10;THEN &quot;Camila Buasso&quot;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    IF NOT ISNULL([xPartnerID])&#13;&#10;    THEN [Agente de Performance (Partner)]&#13;&#10;    ELSE&#13;&#10;        IF NOT ISNULL([xFranchise])&#13;&#10;        THEN [Agente de Performance (KA)]&#13;&#10;        ELSE &#13;&#10;            IF NOT ISNULL([xCity])&#13;&#10;            THEN [Agente de Performance (City)]&#13;&#10;            ELSE&#13;&#10;                IF NOT ISNULL([xArea])&#13;&#10;                THEN [Agente de Performance (Area)]&#13;&#10;                ELSE &quot;Error de Asignación&quot;&#13;&#10;                END&#13;&#10;            END&#13;&#10;        END&#13;&#10;    END&#13;&#10;END' />
        </column>
        <column caption='Bad Performance' datatype='string' name='[Calculation_338614455551717391]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF &#13;&#10;    [VFR Total (copia)_338614455545933835] &gt;= 0.15&#13;&#10;    AND [VFR Week (copia)_338614455546073100] &gt;= 0.15&#13;&#10;THEN&#13;&#10;    &quot;Whole week&quot;&#13;&#10;    &#13;&#10;    ELSEIF &#13;&#10;        [VFR Total (copia)_338614455545933835] &gt;= 0.15&#13;&#10;        AND [VFR Week (copia)_338614455546073100] &lt; 0.15&#13;&#10;    THEN&#13;&#10;        &quot;Weekdays&quot;&#13;&#10;        &#13;&#10;        ELSEIF &#13;&#10;            [VFR Total (copia)_338614455545933835] &lt; 0.15&#13;&#10;            AND [VFR Week (copia)_338614455546073100] &gt;= 0.15&#13;&#10;        THEN&#13;&#10;            &quot;Weekends&quot;&#13;&#10;&#13;&#10;END' />
        </column>
