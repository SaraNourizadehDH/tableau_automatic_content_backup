      <aliases enabled='yes' />
      <column caption='3. VFR Wednesdays' datatype='real' default-format='p0.0%' name='[1. VFR Mondays (copia 2) (copia)_1286340702458355744]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([partnerRejected in1.Monday (copia) (copia 2)_1286340702453075980])/SUM([partnerTotalOrders in1.Monday (copia 2) (copia)_1286340702457397274])' />
      </column>
      <column caption='2. VFR Tuesdays' datatype='real' default-format='p0.0%' name='[1. VFR Mondays (copia 2)_1286340702458335263]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([partnerRejected in1.Monday (copia)_1286340702453043209])/SUM([partnerTotalOrders in1.Monday (copia 2)_1286340702457372697])' />
      </column>
      <column caption='5. VFR Fridays' datatype='real' default-format='p0.0%' name='[1. VFR Mondays (copia) (copia 2)_1286340702458355746]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([partnerRejected in1.Monday (copia) (copia 3)_1286340702453088270])/SUM([partnerTotalOrders in1.Monday (copia)_1286340702457352215])' />
      </column>
      <column caption='7. VFR Sundays' datatype='real' default-format='p0.0%' name='[1. VFR Mondays (copia) (copia) (copia)_1286340702458355745]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([partnerRejected in1.Monday (copia) (copia) (copia)_1286340702453075979])/SUM([partnerTotalOrders in1.Monday (copia) (copia)_1286340702457372696])' />
      </column>
      <column caption='6. VFR Saturday' datatype='real' default-format='p0.0%' name='[1. VFR Mondays (copia) (copia)_1286340702458335262]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([partnerRejected in1.Monday (copia) (copia)_1286340702453055498])/SUM([partnerTotalOrders in1.Monday (copia) (copia 2)_1286340702457397275])' />
