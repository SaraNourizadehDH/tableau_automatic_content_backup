      <column datatype='string' name='[CR3]' role='dimension' type='nominal' />
      <column caption='Date HrC' datatype='datetime' name='[Calculation_1100004269917876224]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Queue Name Parámetro], [created_date_Mvd])' />
      </column>
      <column caption='level_date_hrc' datatype='string' name='[Calculation_1100004269918744577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Queue Name Parámetro] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Queue Name Parámetro] = &apos;week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Queue Name Parámetro], [Calculation_1100004269917876224]))&#13;&#10;ELSEIF ([Parameters].[Queue Name Parámetro] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Queue Name Parámetro], [Calculation_1100004269917876224]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Queue Name Parámetro], [Calculation_1100004269917876224]))&#13;&#10;END' />
      </column>
      <column caption='Empty 1' datatype='integer' name='[Calculation_1100004269919010818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Elegir parámetro' datatype='string' name='[Calculation_1100004269965070343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[View (copia)]&#13;&#10;  WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;  WHEN &quot;CR1&quot; THEN [CR1]&#13;&#10;  WHEN &quot;CR2&quot; THEN [CR2]&#13;&#10;  WHEN &quot;CR3&quot; THEN [CR3]&#13;&#10;  WHEN &quot;Lob&quot; THEN [lob]&#13;&#10;  WHEN &quot;Bpo&quot; THEN [bpo]&#13;&#10;END' />
      </column>
      <column caption='CSAT AC' datatype='real' name='[Calculation_1100004269966229513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sat_ac_cont]) / SUM([resp_ac_cont])' />
      </column>
      <column caption='Date HC' datatype='datetime' name='[Date HrC (copia)_1100004269921472517]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Queue Name Parámetro], [created_date])' />
      </column>
      <column caption='Empty 2' datatype='integer' name='[Empty 1 (copia)_1100004269966458890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='kpi_performance_retyp' datatype='table' name='[__tableau_internal_object_id__].[kpi_performance_retyp_BA3C896954674DE3A3BEBF56CDA63FF4]' role='measure' type='quantitative' />
