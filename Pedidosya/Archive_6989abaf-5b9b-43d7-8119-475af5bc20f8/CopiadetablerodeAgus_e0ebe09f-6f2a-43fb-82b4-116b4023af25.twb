              <calculation class='tableau' formula='SUM([total_contacts_retyp_1]) / SUM([total_chats_created_hc])' />
            </column>
            <column datatype='string' name='[CR3]' role='dimension' type='nominal' />
            <column caption='Empty 1' datatype='integer' name='[Calculation_1100004269919010818]' role='measure' type='quantitative'>
