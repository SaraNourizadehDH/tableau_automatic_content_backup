              <calculation class='tableau' formula='IF ([Parameters].[Queue Name Parámetro] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Queue Name Parámetro] = &apos;week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Queue Name Parámetro], [created_date]))&#13;&#10;ELSEIF ([Parameters].[Queue Name Parámetro] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Queue Name Parámetro], [created_date]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Queue Name Parámetro], [created_date]))&#13;&#10;END' />
