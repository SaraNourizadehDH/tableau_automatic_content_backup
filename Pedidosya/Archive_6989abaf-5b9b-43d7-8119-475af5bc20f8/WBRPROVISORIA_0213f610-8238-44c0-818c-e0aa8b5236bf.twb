            <remote-alias>non_confirmed_orders</remote-alias>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_6423CEB9782347DF8BDE5B0B8BE3041F]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
