            <column caption='PSAT Agente' datatype='real' default-format='p0.0%' name='[Calculation_231090982319009833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_231090982318764071]) * ((SUM([cant_casos_ps])) / (SUM([cant_casos_ps]) + SUM([cant_chats_ps])))&#13;&#10;+&#13;&#10;ZN([PSAT Casos (copia)_231090982318927912]) * ((SUM([cant_chats_ps])) / (SUM([cant_casos_ps]) + SUM([cant_chats_ps])))' />
            </column>
            <column caption='Total Casos PS' datatype='integer' name='[Calculation_231090982635065388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_cases]))&#13;&#10;+ ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[auto_cases]))&#13;&#10;+ ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[refund_cases]))&#13;&#10;+ ZN(SUM([actualizaciones_cases]))&#13;&#10;+ ZN(SUM([altas_cases]))' />
