      </column>
      <column caption='Dynamic Date' datatype='datetime' name='[Calculation_1322087993817104440]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parámetro 1], [fecha])' />
      </column>
      <column caption='Empty1' datatype='integer' name='[Calculation_1322087993817702457]' role='measure' type='quantitative'>
