          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bs001i0x334ee18l7pgi0dps6r3'>
            <column caption='Dynamic Date' datatype='datetime' name='[Calculation_1322087993728655360]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parámetro 1], [ss_date])' />
            </column>
            <column caption='Empty1' datatype='integer' name='[Calculation_1322087993729708033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Total Contacts SS' datatype='integer' name='[Calculation_1322087993730736138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([total_actions_ss]))&#13;&#10;+ ZN(SUM([fc_chats_ss]))' />
            </column>
            <column caption='Contact Rate SS' datatype='real' default-format='p0.0%' name='[Calculation_1322087993749700620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ex Issue Rate&#13;&#10;// Deja de ser sobre pelican orders&#13;&#10;([Calculation_1322087993730736138] - SUM(ZN([qty_pelican_action])))&#13;&#10;/&#13;&#10;SUM([total_orders])' />
            </column>
            <column caption='Session Rate SS' datatype='real' default-format='p0.0%' name='[Calculation_1322087993750867981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ex Contact Rate&#13;&#10;([Calculation_1322087993730736138] + ZN(SUM([federated.0ok0qi71jguvvi1bcdjwj00dk7s0].[WAB Consultas])) - SUM(ZN([qty_pelican_action])))&#13;&#10;/&#13;&#10;SUM([total_orders])' />
            </column>
            <column caption='SSAT' datatype='real' default-format='p0.0%' name='[Calculation_1322087993755742223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Se pasa de qualtrics a fc&#13;&#10;(&#13;&#10;    ZN(SUM([sat_qualtrics_ss]))&#13;&#10;    + ZN(SUM([sat_fc_ss]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([sat_qualtrics_ss]))&#13;&#10;    + ZN(SUM([insat_qualtrics_ss]))&#13;&#10;    + ZN(SUM([sat_fc_ss]))&#13;&#10;    + ZN(SUM([insat_fc_ss]))&#13;&#10;)' />
            </column>
            <column caption='SLA SS' datatype='real' default-format='p0.0%' name='[Calculation_1322087993757114384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    ZN(SUM([sum_sla_ss]))&#13;&#10;    + ZN(SUM([fc_sum_sla_ss]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([zendesk_chats_ss]))&#13;&#10;    + ZN(SUM([fc_chats_ss]))&#13;&#10;)' />
            </column>
            <column caption='Prod Op SS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1322087993766023185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1322087993730736138] &#13;&#10;/&#13;&#10;[Calculation_229402136594227310]' />
            </column>
            <column caption='Deflection SS' datatype='real' default-format='p0.0%' name='[Calculation_1322087994167267465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Sobre todo el universo, no unicamente sobre wpp&#13;&#10;// Las consultas de wmr de alan, nunca llegan a agente&#13;&#10;[Calculation_2867948541755965495]&#13;&#10;/&#13;&#10;[Calculation_2867948541755539510]' />
            </column>
            <column caption='Tiempo Op SS' datatype='real' name='[Calculation_229402136594227310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hours_worked_ss])' />
            </column>
            <column caption='Total Session SS' datatype='integer' name='[Calculation_2867948541755539510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1322087993730736138] + ZN(SUM([federated.0ok0qi71jguvvi1bcdjwj00dk7s0].[WAB Consultas]))' />
            </column>
            <column caption='Deflectados SS' datatype='integer' name='[Calculation_2867948541755965495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([federated.0ok0qi71jguvvi1bcdjwj00dk7s0].[WAB Consultas]))' />
            </column>
            <column caption='fecha_ultimo_nivel' datatype='string' name='[Calculation_463307853676470406]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087993728655360]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087993728655360]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087993728655360]))&#13;&#10;END' />
            </column>
