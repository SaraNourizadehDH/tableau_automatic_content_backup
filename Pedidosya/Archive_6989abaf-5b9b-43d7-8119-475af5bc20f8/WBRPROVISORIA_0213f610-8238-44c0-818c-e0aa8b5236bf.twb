            <column caption='SSAT' datatype='real' default-format='p0.0%' name='[Calculation_1322087993755742223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Se pasa de qualtrics a fc&#13;&#10;(&#13;&#10;    ZN(SUM([sat_qualtrics_ss]))&#13;&#10;    + ZN(SUM([sat_fc_ss]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([sat_qualtrics_ss]))&#13;&#10;    + ZN(SUM([insat_qualtrics_ss]))&#13;&#10;    + ZN(SUM([sat_fc_ss]))&#13;&#10;    + ZN(SUM([insat_fc_ss]))&#13;&#10;)' />
            </column>
