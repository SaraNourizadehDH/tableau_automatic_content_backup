            <datasource caption='RS (BQ)' name='federated.0hg7usr1tkcpft131oell1mbbk8x' />
            <datasource caption='CS (BQ)' name='federated.0e7yaqr1ivmpk310mijqx0wx69zq' />
            <datasource name='Parameters' />
            <datasource caption='PS Calls (Sheet)' name='federated.014jwi501qmwa516va8g11ep5kco' />
            <datasource caption='SS (BQ)' name='federated.0bs001i0x334ee18l7pgi0dps6r3' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;iso-week&quot;' value='Weekly' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
              </aliases>
