              <calculation class='tableau' formula='ZN([Calculation_986006870540726306]) * ZN(&#13;&#10;&#9;(SUM([total_casos_cs]) + SUM([total_chats_cs]))&#13;&#10;&#9;/ &#13;&#10;&#9;(SUM([total_casos_cs]) + SUM([total_chats_cs]) +[Calculation_986006870541361188])&#13;&#10;)&#13;&#10;+&#13;&#10;ZN([Calculation_986006870542348327]) * ZN(&#13;&#10;&#9;[Calculation_986006870541361188]&#13;&#10;        /&#13;&#10;&#9;(SUM([total_casos_cs]) + SUM([total_chats_cs]) + [Calculation_986006870541361188])&#13;&#10;)' />
