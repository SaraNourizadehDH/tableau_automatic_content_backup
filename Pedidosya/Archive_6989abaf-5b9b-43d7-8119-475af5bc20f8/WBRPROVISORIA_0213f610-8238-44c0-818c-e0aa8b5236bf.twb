        <calculation class='tableau' formula='SUM([tiempo_non_sf_cs])&#13;&#10;/&#13;&#10;3600' />
      </column>
      <column caption='AHT+ACW CS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1090434091157987358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aht_acw_cs])&#13;&#10;/&#13;&#10;SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats_atendidos])' />
