              <calculation class='tableau' formula='ZN([Calculation_231090982316036129]) * (ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_chats])) / [Total Issues PS (ps, auto, calls) (copia)_1666331917839003664])&#13;&#10;+&#13;&#10;ZN([Calculation_231090982316703778]) * (ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_cases])) / [Total Issues PS (ps, auto, calls) (copia)_1666331917839003664])&#13;&#10;+&#13;&#10;ZN([SLA Auto KA (copia)_1666331917559013382]) * (ZN(SUM([casos_actualizaciones_ka])) / [Total Issues PS (ps, auto, calls) (copia)_1666331917839003664])&#13;&#10;+&#13;&#10;ZN([SLA Auto NKA (copia)_1666331917559160839]) * (ZN(SUM([casos_actualizaciones_nka])) / [Total Issues PS (ps, auto, calls) (copia)_1666331917839003664])&#13;&#10;+&#13;&#10;ZN([SLA Auto KA (copia)_1666331917559320584]) * (ZN(SUM([casos_altas])) / [Total Issues PS (ps, auto, calls) (copia)_1666331917839003664])' />
