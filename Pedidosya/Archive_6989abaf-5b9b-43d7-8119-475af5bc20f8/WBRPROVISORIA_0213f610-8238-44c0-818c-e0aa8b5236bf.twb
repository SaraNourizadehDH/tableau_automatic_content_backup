      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_E0C2B32B864B43CBB3F78CBADE65F10B'>
            <properties context=''>
              <relation connection='bigquery.08ypu520rij7x319gx7yv0ncmiix' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH ss_data AS (
	SELECT
		COALESCE(ss.ss_date, p.fecha) AS ss_date,
		COALESCE(ss.email, p.email) AS email,
		COALESCE(ss.qty_zendesk_chats,0) AS qty_zendesk_chats,
		COALESCE(ss.qty_wpp_action,0) AS qty_wpp_action,
		COALESCE(ss.qty_update_action_wpp,0) AS qty_update_action_wpp,
		COALESCE(ss.escalations_ds,0) AS escalations_ds,
		COALESCE(ss.qty_update_action_zen,0) AS qty_update_action_zen,
		COALESCE(ss.qty_pelican_action, p.pelican_review, 0) AS qty_pelican_action,
		COALESCE(ss.escalations,0) AS escalations,
		COALESCE(ss.zendesk_sla,0) AS zendesk_sla,
		COALESCE(ss.aht,0) AS aht
	FROM (
		SELECT
			DATE(shopper_support_date) AS ss_date,
			email,
			COALESCE(qty_zendesk_chats,0) AS qty_zendesk_chats,
			COALESCE(qty_wpp_action,0) AS qty_wpp_action,
			COALESCE(qty_update_action_wpp,0) AS qty_update_action_wpp,
			COALESCE(escalations_ds,0) AS escalations_ds,
			COALESCE(qty_update_action_zen,0) AS qty_update_action_zen,
			qty_pelican_action,
			COALESCE(escalations,0) AS escalations,
			COALESCE(SAFE_CAST(REPLACE(SUBSTR(zendesk_sla, 1, INSTR(zendesk_sla, '%') - 1),',','.') AS DECIMAL),0) AS zendesk_sla,
			qty_zendesk_chats * (60 * SAFE_CAST(SPLIT(SPLIT(zendesk_aht,' ')[SAFE_OFFSET(0)],'m')[SAFE_OFFSET(0)] AS INT64) + SAFE_CAST(SPLIT(SPLIT(zendesk_aht,' ')[SAFE_OFFSET(1)],'s')[SAFE_OFFSET(0)] AS INT64)) AS aht
		FROM `peya-data-origins-pro.cl_core.shopper_support`
		WHERE shopper_support_date >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	) ss
	
    FULL OUTER JOIN (
		SELECT 
			DATE(events.created_at) AS fecha,
			orders.reviewer AS email,
			COUNT(DISTINCT orders.external_id) AS pelican_review
		FROM `peya-data-origins-pro.cl_pelican.orders` orders

		LEFT JOIN (
            SELECT 
                order_id,
                created_at,
				event
            FROM `peya-data-origins-pro.cl_pelican.order_events`
            WHERE yyyymmdd >>= '2020-12-23' 
        ) events ON events.order_id = orders.id
		
        WHERE orders.yyyymmdd >>= '2020-12-23'
		  AND orders.global_entity_id NOT IN ('CD_CO','PY_CO')
		  AND orders.internal_admin_status ='REVIEWED'
		  AND events.event = 'ORDER_REVIEWED'
		GROUP BY 1,2
	) p ON p.fecha = ss.ss_date 
       AND p.email = ss.email
), 
horas AS (
	SELECT 
			DATE(r.created_date) AS fecha,
			r.email AS email,
			round((ra.productive_sec/3600.0),2) AS hours_clocked_net,
		FROM `peya-data-origins-pro.cl_gcc_service.rooster_shifts` r

        left join `peya-data-origins-pro.cl_gcc_service.rooster_activity` ra 
            on r.instance_id = ra.instance_id
            and r.employee_id= ra.employee_id
            AND r.created_date = ra.created_date
		
        WHERE DATE(r.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		    AND r.state in ('EVALUATED','IN_DISCUSSION')
            and r.environment = 'cc-py'
            AND r.team_name IN ('Shopper support')

), 
freshchat AS (
	SELECT 
		DATE(chat_created_at) AS fc_date,
        cd.country_id,
		COUNT(DISTINCT interaction_id) AS fc_chats_ss,
		SUM(handling_time) AS fc_sum_ht_ss,
		SUM(CASE WHEN TIMESTAMP_DIFF(first_response_timestamp, chat_created_at, SECOND) << 30 THEN 1 ELSE 0 END) AS fc_sum_sla_ss,
		SUM(CASE WHEN csat_rating >>= 4 THEN 1 ELSE 0 END) AS sat_fc_ss,
		SUM(CASE WHEN csat_rating <<= 3 THEN 1 ELSE 0 END) AS insat_fc_ss
	FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN fc.country = 'Panama' THEN 'Panamá'
											  WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN fc.country = 'Peru' THEN 'Perú'
											  WHEN fc.country = 'Salvador' THEN 'El Salvador'
											  ELSE fc.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6
	
    WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND department = 'Shopper' 
	  AND management_entity = 'Pedidosya' 
	  AND automated_chat = 0
	GROUP BY 1,2
),
pelican_orders AS (
	SELECT
		DATE(o.registered_date) AS po_date,
		COUNT(DISTINCT o.order_id) pelican_orders
    FROM (
    	SELECT
			SAFE_CAST(external_id AS INT64) AS order_id,
        FROM `peya-data-origins-pro.cl_pelican.orders`
        WHERE SAFE_CAST(SUBSTR(REPLACE(SAFE_CAST(yyyymmdd AS STRING),'-',''),1,6) AS INT64) >>= SAFE_CAST(EXTRACT(YEAR FROM (DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -6 MONTH))) * 100 + EXTRACT(MONTH FROM (DATE_ADD(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL -6 MONTH))) AS INT64)
    ) po

    INNER JOIN (
		SELECT 
			order_id,
			registered_date,
			country.country_id AS country_id
        FROM `peya-bi-tools-pro.il_core.fact_orders`
        WHERE DATE(registered_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    ) o ON o.order_id = po.order_id
    
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
            ON cd.country_id = o.country_id 
           AND cd.active
           AND cd.country_id != 6
    GROUP BY 1
), 
orders AS (
	SELECT 
		DATE(ord.registered_date) AS fecha,
		COUNT(DISTINCT ord.order_id) AS total_orders
	FROM `peya-bi-tools-pro.il_core.fact_orders` ord

	INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
            ON cd.country_id = ord.country.country_id
		   AND cd.active 
		   AND cd.country_id != 6
	
    WHERE DATE(registered_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	GROUP BY 1
), 
ssat AS (
	SELECT
		DATE(start_at) AS fecha,
		SUM(CASE WHEN csat >>= 4 THEN 1 ELSE 0 END) AS sat_qualtrics_ss,
		SUM(CASE WHEN csat <<= 3 THEN 1 ELSE 0 END) AS insat_qualtrics_ss
	FROM `peya-data-origins-pro.cl_gcc_service.qualtrics_ac_csat_responses`

	WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND DATE(start_at) >>= '2020-08-22' /* empieza la data de SS */
	  AND DATE(start_at) <<= '2020-10-11' /* se deja de usar qualtrics */
	  AND stakeholder IS NULL
	  AND origin = 'chat'
	GROUP BY 1
)
SELECT
	ss.ss_date,
	NULL AS country_id,
	ss.qty_pelican_action,
	ss.total_chats_ss,
	ss.total_actions_ss,
	ss.zendesk_chats_ss,
	ss.sum_sla_ss,
	ss.aht_ss,
	ss.total_orders,
	h.hours_worked_ss,
	fc.fc_chats_ss,
	fc.fc_sum_ht_ss,
	fc.fc_sum_sla_ss,
	fc.sat_fc_ss,
	fc.insat_fc_ss,
	po.pelican_orders,
	ssat.sat_qualtrics_ss,
	ssat.insat_qualtrics_ss
FROM (
	SELECT
		COALESCE(ss.ss_date,o.fecha) AS ss_date,
		ss.qty_pelican_action,
		ss.total_chats_ss,
		ss.total_actions_ss,
		ss.zendesk_chats_ss,
		ss.sum_sla_ss,
		ss.aht_ss,
		o.total_orders
	FROM(
		SELECT
			ss_data.ss_date,
			SUM(qty_pelican_action) AS qty_pelican_action,
			SUM(qty_zendesk_chats + qty_wpp_action + qty_update_action_wpp + escalations_ds) AS total_chats_ss,
			SUM(qty_zendesk_chats + qty_wpp_action + 2*qty_update_action_wpp + qty_update_action_zen + qty_pelican_action + escalations + escalations_ds) AS total_actions_ss,
			SUM(qty_zendesk_chats) AS zendesk_chats_ss,
			SUM(zendesk_sla *qty_zendesk_chats)/100 AS sum_sla_ss,
			SUM(aht) AS aht_ss
		FROM ss_data
		GROUP BY 1
	) ss
	
	FULL OUTER JOIN orders AS o 
				 ON o.fecha = ss.ss_date
) ss

LEFT JOIN (
	SELECT
		ss_date,
		SUM(hours_worked) AS hours_worked_ss
	FROM (
		SELECT
			ss.ss_date,
			ss.email,
			SUM(h.hours_clocked_net ) AS hours_worked
		FROM ss_data ss

		LEFT JOIN horas h 
			   ON h.fecha = ss.ss_date 
			  AND h.email = ss.email 

		GROUP BY 1,2
		HAVING SUM(qty_zendesk_chats + qty_wpp_action + 2*qty_update_action_wpp + qty_update_action_zen + qty_pelican_action + escalations + escalations_ds) >> 20
	)
	GROUP BY 1
) h ON h.ss_date = ss.ss_date

LEFT JOIN freshchat fc 
       ON ss.ss_date = fc.fc_date

LEFT JOIN pelican_orders po 
       ON po.po_date = ss.ss_date

LEFT JOIN ssat AS ssat 
	   ON ssat.fecha = ss.ss_date

ORDER BY 1 DESC, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='liveops (BQ)' inline='true' name='federated.0d2t8if0qr9af91bt6a6a0indn1o' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.02b9mv70voy7e216la1pm0ygn5sq'>
            <connection CATALOG='peya-bi-tools-pro' EXECCATALOG='peya-nicaragua' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-bi-tools-pro' schema='il_core' server-oauth='' username='sebastian.diazdevaldes@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02b9mv70voy7e216la1pm0ygn5sq' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*-- WBR LIVE OPS --*/

WITH orders AS (
	SELECT 
		DATE(registered_date) AS full_date,
		country.country_id AS country_id,
		country.country_name AS country_name,
		COUNT(DISTINCT order_id) AS total_orders,
		COUNT(DISTINCT CASE WHEN order_status IN ('CONFIRMED') THEN order_id END) AS confirmed_orders,
		COUNT(DISTINCT CASE WHEN order_status NOT IN ('CONFIRMED') THEN order_id END) AS non_confirmed_orders,
		COUNT(DISTINCT CASE WHEN with_logistics THEN order_id END) AS od_orders
	FROM `peya-bi-tools-pro.il_core.fact_orders` ord
	
	WHERE DATE(registered_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	  AND country.country_id != 6
	GROUP BY 1,2,3
),
cases AS (
	SELECT
		DATE(create_date) AS full_date,
		country_id,
        COUNT(DISTINCT CASE WHEN case_origin <<>> 'Chat' AND record_type_name = 'PY Inbound Case' AND case_type like '%ustomer' THEN case_id END) AS cs_cases,
		COUNT(DISTINCT CASE WHEN case_origin = 'Helpcenter' AND record_type_name = 'PY Inbound Case' AND case_type = 'Customer' THEN case_id END) AS cs_hc_casos,
		COUNT(DISTINCT CASE WHEN case_origin IN ('Facebook','Instagram','Twitter') AND record_type_name = 'PY Inbound Case' AND case_type = 'Customer' THEN case_id END) AS cs_redes,
		COUNT(DISTINCT CASE WHEN case_origin NOT IN ('Chat','Phone') AND record_type_name = 'PY Inbound Case' AND (case_type IN ('Restaurant - Data','Restaurant Request','Partner','Handover',' ') OR case_type IS NULL) THEN case_id END) AS ps_cases,
		COUNT(DISTINCT CASE WHEN case_type IN ('Restaurant - Transmission','Partner System Integration') AND closed_reason NOT IN ('Duplicate','Duplicated','Invalid','Invalido') THEN case_id END) AS auto_cases,
		COUNT(DISTINCT CASE WHEN case_type = 'Refund' THEN case_id END) AS refund_cases,
        COUNT(DISTINCT CASE WHEN case_origin NOT IN ('Chat', 'Phone') AND case_reason_level_3 = 'Spam / Irrelevant' AND record_type_name = 'PY Inbound Case' AND (case_type IN ('Restaurant -...Request','Partner','Handover', ' ') OR case_type IS NULL) THEN case_id END) AS ps_cases_spam,
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

	WHERE DATE(create_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%')    
	  AND country_id != 6
	GROUP BY 1,2	
),
livechat AS (
	SELECT 
		DATE(created_date) AS full_date,
		country_id,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') THEN chat_transcript_id END) AS cs_chats,
    COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') and status = 'Completed' AND chat_Wait_Time <<= 30 THEN chat_transcript_id END) AS sla_cs_chats,
		SUM(CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') AND status = 'Completed' AND chat_transcript_user.user_name = 'Automated Process' THEN 1 ELSE 0 END) AS cs_auto_proc,
		SUM(CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') AND status = 'Completed' THEN 1 ELSE 0 END) AS cs_chats_atendidos,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') THEN chat_transcript_id END) AS ps_chats,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND visitor_message_count >> 0 THEN chat_transcript_id END) AS ps_chats_con_interaccion,
		SUM(CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND status = 'Completed' AND chat_transcript_user.user_name = 'Automated Process' THEN 1 ELSE 0 END) AS ps_auto_proc,
		SUM(CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND status = 'Completed' AND chat_transcript_user_id NOT IN ('005w0000003pERkAAM') THEN 1 ELSE 0 END) AS ps_chats_atendidos
	FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`

	WHERE DATE(created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	AND country_id != 6
  GROUP BY 1,2
  ORDER BY 1 DESC, 2
), 
helpcenter AS (
	SELECT	
		DATE(s.created_at) AS full_date,
		cd.country_id,
		COUNT(DISTINCT s.session_id) AS cs_hc_sesiones,
		/*COUNT(DISTINCT CASE WHEN NOT s.is_ticket_created AND NOT s.is_chat_created THEN s.flow_session_id END) AS cs_hc_deflectados*/
	FROM `peya-data-origins-pro.cl_gcc_service.hc_sessions` s

	INNER JOIN `peya-data-origins-pro.cl_gcc_service.countries` c
            ON c.global_entity_id = s.global_entity_id

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_code = c.country_code
           AND cd.active
		   AND cd.country_id != 6
	
	WHERE DATE(s.created_at) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
), 

rs_data AS (
	SELECT
		fecha AS full_date,
		country_id,
		SUM(total_chats) AS rs_chats
	FROM (
		SELECT
			DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
			country_id,
			COUNT(*) AS total_chats
		FROM (
			SELECT
				fc.chat_created_at,
				/*fc.first_assigned_timestamp as horasposta,*/
                DATETIME(fc.first_assigned_timestamp, 'America/Montevideo') as horasposta,
				cd.country_id
			FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

			INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN fc.country = 'Panama' THEN 'Panamá'
											  WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN fc.country = 'Peru' THEN 'Perú'
											  WHEN fc.country = 'Salvador' THEN 'El Salvador'
											  ELSE fc.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6

			WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND fc.department = 'Rider'
			  AND fc.management_entity = 'Pedidosya'
              AND FC.automated_chat = 0
		)
		GROUP BY 1,2
	)
	GROUP BY 1,2
),

ps_contacts as (

    select 
        date(psc.Fecha) as full_date,
        cd.country_id,
        psc.total_contactos as total_contacts_ps,
        psc.total_deflectados as total_deflect_ps,
    from `peya-delivery-and-support.automated_tables_reports.wbr_ps_contact` psc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = psc.Pais
           AND cd.active
		   AND cd.country_id != 6
        WHERE DATE(psc.Fecha) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	ORDER BY 1 DESC, 2
),



ss_contacts as (
    SELECT 
		DATE(chat_created_at) AS fc_date,
        cd.country_id,
		COUNT(DISTINCT interaction_id) AS chats_ss,
	FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN fc.country = 'Panama' THEN 'Panamá'
											  WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN fc.country = 'Peru' THEN 'Perú'
											  WHEN fc.country = 'Salvador' THEN 'El Salvador'
											  ELSE fc.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6
	
    WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND department = 'Shopper' 
	  AND management_entity = 'Pedidosya' 
	  AND automated_chat = 0
	GROUP BY 1,2
    
)


SELECT
	distinct(COALESCE(o.full_date, f.full_date)) AS full_date,
	COALESCE(o.country_id, f.country_id) AS country_id,

	o.country_name,
	o.total_orders,
	o.confirmed_orders,
	o.non_confirmed_orders,
	o.od_orders,

	c.cs_cases,
	c.cs_hc_casos,
	c.cs_redes,
	c.ps_cases,
	c.auto_cases,
	c.refund_cases,
    c.ps_cases_spam,

	li.cs_chats,
  li.sla_cs_chats,
	li.cs_chats_atendidos,
	li.cs_auto_proc,
	li.ps_chats,
	li.ps_chats_con_interaccion,
	li.ps_chats_atendidos,
	li.ps_auto_proc,

    rsd.rs_chats,

    psc.total_contacts_ps,
    psc.total_deflect_ps,

    ss.chats_ss,
    
	hc.cs_hc_sesiones,
	
FROM orders o

LEFT JOIN cases c 
	   ON c.full_date = o.full_date
	  AND c.country_id = o.country_id

LEFT JOIN livechat li 
	   ON li.full_date = o.full_date
	  AND li.country_id = o.country_id

LEFT JOIN helpcenter hc
	   ON hc.full_date = o.full_date
	  AND hc.country_id = o.country_id

LEFT JOIN ps_contacts  psc
	   ON psc.full_date = o.full_date
	  AND psc.country_id = o.country_id

LEFT JOIN rs_data  rsd
	   ON rsd.full_date = o.full_date
	  AND rsd.country_id = o.country_id


LEFT JOIN ss_contacts ss
        on ss.fc_date  = o.full_date
        and ss.country_id = o.country_id  

FULL OUTER JOIN (
	SELECT
		full_date,
		NULL AS country_id
	FROM orders
	GROUP BY 1
) AS f ON f.full_date = o.full_date 
      AND f.country_id = o.country_id
      
ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.02b9mv70voy7e216la1pm0ygn5sq' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*-- WBR LIVE OPS --*/

WITH orders AS (
	SELECT 
		DATE(registered_date) AS full_date,
		country.country_id AS country_id,
		country.country_name AS country_name,
		COUNT(DISTINCT order_id) AS total_orders,
		COUNT(DISTINCT CASE WHEN order_status IN ('CONFIRMED') THEN order_id END) AS confirmed_orders,
		COUNT(DISTINCT CASE WHEN order_status NOT IN ('CONFIRMED') THEN order_id END) AS non_confirmed_orders,
		COUNT(DISTINCT CASE WHEN with_logistics THEN order_id END) AS od_orders
	FROM `peya-bi-tools-pro.il_core.fact_orders` ord
	
	WHERE DATE(registered_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	  AND country.country_id != 6
	GROUP BY 1,2,3
),
cases AS (
	SELECT
		DATE(create_date) AS full_date,
		country_id,
        COUNT(DISTINCT CASE WHEN case_origin <<>> 'Chat' AND record_type_name = 'PY Inbound Case' AND case_type like '%ustomer' THEN case_id END) AS cs_cases,
		COUNT(DISTINCT CASE WHEN case_origin = 'Helpcenter' AND record_type_name = 'PY Inbound Case' AND case_type = 'Customer' THEN case_id END) AS cs_hc_casos,
		COUNT(DISTINCT CASE WHEN case_origin IN ('Facebook','Instagram','Twitter') AND record_type_name = 'PY Inbound Case' AND case_type = 'Customer' THEN case_id END) AS cs_redes,
		COUNT(DISTINCT CASE WHEN case_origin NOT IN ('Chat','Phone') AND record_type_name = 'PY Inbound Case' AND (case_type IN ('Restaurant - Data','Restaurant Request','Partner','Handover',' ') OR case_type IS NULL) THEN case_id END) AS ps_cases,
		COUNT(DISTINCT CASE WHEN case_type IN ('Restaurant - Transmission','Partner System Integration') AND closed_reason NOT IN ('Duplicate','Duplicated','Invalid','Invalido') THEN case_id END) AS auto_cases,
		COUNT(DISTINCT CASE WHEN case_type = 'Refund' THEN case_id END) AS refund_cases,
        COUNT(DISTINCT CASE WHEN case_origin NOT IN ('Chat', 'Phone') AND case_reason_level_3 = 'Spam / Irrelevant' AND record_type_name = 'PY Inbound Case' AND (case_type IN ('Restaurant -...Request','Partner','Handover', ' ') OR case_type IS NULL) THEN case_id END) AS ps_cases_spam,
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

	WHERE DATE(create_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%')    
	  AND country_id != 6
	GROUP BY 1,2	
),
livechat AS (
	SELECT 
		DATE(created_date) AS full_date,
		country_id,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') THEN chat_transcript_id END) AS cs_chats,
    COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') and status = 'Completed' AND chat_Wait_Time <<= 30 THEN chat_transcript_id END) AS sla_cs_chats,
		SUM(CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') AND status = 'Completed' AND chat_transcript_user.user_name = 'Automated Process' THEN 1 ELSE 0 END) AS cs_auto_proc,
		SUM(CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') AND status = 'Completed' THEN 1 ELSE 0 END) AS cs_chats_atendidos,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') THEN chat_transcript_id END) AS ps_chats,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND visitor_message_count >> 0 THEN chat_transcript_id END) AS ps_chats_con_interaccion,
		SUM(CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND status = 'Completed' AND chat_transcript_user.user_name = 'Automated Process' THEN 1 ELSE 0 END) AS ps_auto_proc,
		SUM(CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND status = 'Completed' AND chat_transcript_user_id NOT IN ('005w0000003pERkAAM') THEN 1 ELSE 0 END) AS ps_chats_atendidos
	FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`

	WHERE DATE(created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	AND country_id != 6
  GROUP BY 1,2
  ORDER BY 1 DESC, 2
), 
helpcenter AS (
	SELECT	
		DATE(s.created_at) AS full_date,
		cd.country_id,
		COUNT(DISTINCT s.session_id) AS cs_hc_sesiones,
		/*COUNT(DISTINCT CASE WHEN NOT s.is_ticket_created AND NOT s.is_chat_created THEN s.flow_session_id END) AS cs_hc_deflectados*/
	FROM `peya-data-origins-pro.cl_gcc_service.hc_sessions` s

	INNER JOIN `peya-data-origins-pro.cl_gcc_service.countries` c
            ON c.global_entity_id = s.global_entity_id

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_code = c.country_code
           AND cd.active
		   AND cd.country_id != 6
	
	WHERE DATE(s.created_at) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
), 

rs_data AS (
	SELECT
		fecha AS full_date,
		country_id,
		SUM(total_chats) AS rs_chats
	FROM (
		SELECT
			DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
			country_id,
			COUNT(*) AS total_chats
		FROM (
			SELECT
				fc.chat_created_at,
				/*fc.first_assigned_timestamp as horasposta,*/
                DATETIME(fc.first_assigned_timestamp, 'America/Montevideo') as horasposta,
				cd.country_id
			FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

			INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN fc.country = 'Panama' THEN 'Panamá'
											  WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN fc.country = 'Peru' THEN 'Perú'
											  WHEN fc.country = 'Salvador' THEN 'El Salvador'
											  ELSE fc.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6

			WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND fc.department = 'Rider'
			  AND fc.management_entity = 'Pedidosya'
              AND FC.automated_chat = 0
		)
		GROUP BY 1,2
	)
	GROUP BY 1,2
),

ps_contacts as (

    select 
        date(psc.Fecha) as full_date,
        cd.country_id,
        psc.total_contactos as total_contacts_ps,
        psc.total_deflectados as total_deflect_ps,
    from `peya-delivery-and-support.automated_tables_reports.wbr_ps_contact` psc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = psc.Pais
           AND cd.active
		   AND cd.country_id != 6
        WHERE DATE(psc.Fecha) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	ORDER BY 1 DESC, 2
),



ss_contacts as (
    SELECT 
		DATE(chat_created_at) AS fc_date,
        cd.country_id,
		COUNT(DISTINCT interaction_id) AS chats_ss,
	FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN fc.country = 'Panama' THEN 'Panamá'
											  WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN fc.country = 'Peru' THEN 'Perú'
											  WHEN fc.country = 'Salvador' THEN 'El Salvador'
											  ELSE fc.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6
	
    WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND department = 'Shopper' 
	  AND management_entity = 'Pedidosya' 
	  AND automated_chat = 0
	GROUP BY 1,2
    
)


SELECT
	distinct(COALESCE(o.full_date, f.full_date)) AS full_date,
	COALESCE(o.country_id, f.country_id) AS country_id,

	o.country_name,
	o.total_orders,
	o.confirmed_orders,
	o.non_confirmed_orders,
	o.od_orders,

	c.cs_cases,
	c.cs_hc_casos,
	c.cs_redes,
	c.ps_cases,
	c.auto_cases,
	c.refund_cases,
    c.ps_cases_spam,

	li.cs_chats,
  li.sla_cs_chats,
	li.cs_chats_atendidos,
	li.cs_auto_proc,
	li.ps_chats,
	li.ps_chats_con_interaccion,
	li.ps_chats_atendidos,
	li.ps_auto_proc,

    rsd.rs_chats,

    psc.total_contacts_ps,
    psc.total_deflect_ps,

    ss.chats_ss,
    
	hc.cs_hc_sesiones,
	
FROM orders o

LEFT JOIN cases c 
	   ON c.full_date = o.full_date
	  AND c.country_id = o.country_id

LEFT JOIN livechat li 
	   ON li.full_date = o.full_date
	  AND li.country_id = o.country_id

LEFT JOIN helpcenter hc
	   ON hc.full_date = o.full_date
	  AND hc.country_id = o.country_id

LEFT JOIN ps_contacts  psc
	   ON psc.full_date = o.full_date
	  AND psc.country_id = o.country_id

LEFT JOIN rs_data  rsd
	   ON rsd.full_date = o.full_date
	  AND rsd.country_id = o.country_id


LEFT JOIN ss_contacts ss
        on ss.fc_date  = o.full_date
        and ss.country_id = o.country_id  

FULL OUTER JOIN (
	SELECT
		full_date,
		NULL AS country_id
	FROM orders
	GROUP BY 1
) AS f ON f.full_date = o.full_date 
      AND f.country_id = o.country_id
      
ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
