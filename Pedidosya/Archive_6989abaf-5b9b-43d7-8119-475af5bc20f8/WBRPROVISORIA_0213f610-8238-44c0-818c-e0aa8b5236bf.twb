            <column caption='Contact Rate CS' datatype='real' default-format='p0.0%' name='[Calculation_986006870514245651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ex Issue Rate&#13;&#10;[Calculation_986006870514139154] / SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[total_orders])' />
            </column>
            <column caption='CSAT Casos' datatype='real' default-format='p0.0%' name='[Calculation_986006870539845664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sat_casos_cs])&#13;&#10;/&#13;&#10;sum([resp_casos_cs])' />
            </column>
            <column caption='CSAT Agente' datatype='real' default-format='p0.0%' name='[Calculation_986006870540726306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// 20210122 - Solamente HC tiene CSAT Agente&#13;&#10;ZN([Calculation_986006870539845664]) * (SUM([total_casos_cs]) / (SUM([total_casos_cs]) + SUM([total_chats_cs])))&#13;&#10;+&#13;&#10;ZN([CSAT Casos (copia)_986006870540169249]) * (SUM([total_chats_cs]) / (SUM([total_casos_cs]) + SUM([total_chats_cs])))' />
            </column>
            <column caption='Deflectados CS' datatype='integer' name='[Calculation_986006870541361188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_hc_deflectados])&#13;&#10;[Calculation_986006870512570384]- SUM([total_chats_cs]) - SUM([total_casos_cs])' />
            </column>
            <column caption='CSAT Total' datatype='real' default-format='p0.0%' name='[Calculation_986006870542143526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_986006870540726306]) * ZN(&#13;&#10;&#9;(SUM([total_casos_cs]) + SUM([total_chats_cs]))&#13;&#10;&#9;/ &#13;&#10;&#9;(SUM([total_casos_cs]) + SUM([total_chats_cs]) +[Calculation_986006870541361188])&#13;&#10;)&#13;&#10;+&#13;&#10;ZN([Calculation_986006870542348327]) * ZN(&#13;&#10;&#9;[Calculation_986006870541361188]&#13;&#10;        /&#13;&#10;&#9;(SUM([total_casos_cs]) + SUM([total_chats_cs]) + [Calculation_986006870541361188])&#13;&#10;)' />
            </column>
