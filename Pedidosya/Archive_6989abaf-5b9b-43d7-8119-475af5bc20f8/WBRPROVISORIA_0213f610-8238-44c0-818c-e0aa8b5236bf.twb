      <column caption='AHT+ACW PS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1090434091158609951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aht_acw_ps])&#13;&#10;/&#13;&#10;SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_chats_atendidos])' />
      </column>
      <column caption='Simultaneidad PS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1090434091167694885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([aht_acw_ps]) / 3600)&#13;&#10;/&#13;&#10;(SUM([tiempo_prod_chats_ps]) / 3600)' />
      </column>
      <column caption='PSAT Chat Bill' datatype='real' name='[Calculation_1239897305361301504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sat_chats_Billing])/sum([resp_chats_Billing])' />
      </column>
      <column caption='WoW' datatype='string' name='[Calculation_1322087994065838167]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &apos;MoM&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &apos;WoW&apos;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &apos;QoQ&apos;&#13;&#10;ELSE&#13;&#10;    &apos;DoD&apos;&#13;&#10;END' />
      </column>
      <column caption='EmptyDimension' datatype='string' name='[Calculation_1322087994065920088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='Last' datatype='boolean' name='[Calculation_1322087994067906659]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() &lt;= 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Actualizaciones' datatype='integer' name='[Calculation_1666331917560029194]' role='measure' type='quantitative'>
