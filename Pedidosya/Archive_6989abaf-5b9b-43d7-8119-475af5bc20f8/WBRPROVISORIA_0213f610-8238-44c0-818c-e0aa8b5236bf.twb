      <column caption='AHT RS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1090434091159134240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aht_rs])&#13;&#10;/&#13;&#10;SUM([rs_chats])' />
      </column>
      <column caption='Simultaneidad RS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1090434091455393833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([aht_rs]) / 3600)&#13;&#10;/&#13;&#10;[Calculation_1322087993818890307]' />
      </column>
      <column caption='%CWT' datatype='real' name='[Calculation_1252000747323396096]' role='measure' type='quantitative'>
