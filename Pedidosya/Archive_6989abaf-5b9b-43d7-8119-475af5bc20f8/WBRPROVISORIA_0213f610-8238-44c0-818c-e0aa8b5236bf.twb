              <calculation class='tableau' formula='[SLA Casos CS (copia)_986006870551654441] * (&#13;&#10;    SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats]) &#13;&#10;    / (&#13;&#10;        SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_cases])&#13;&#10;        + SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats])&#13;&#10;    )&#13;&#10;)&#13;&#10;+&#13;&#10;[Calculation_986006870550032424] * (&#13;&#10;    SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_cases]) &#13;&#10;    / (&#13;&#10;        SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_cases])&#13;&#10;        + SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats])&#13;&#10;    )&#13;&#10;)' />
            </column>
            <column caption='Deflection HC CS' datatype='real' default-format='p0.0%' name='[Calculation_2867948540304945189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1- (&#13;&#10;    (SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_hc_casos]) + SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats]))&#13;&#10;    /&#13;&#10;    SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_hc_sesiones])&#13;&#10;)' />
            </column>
            <column caption='CWT' datatype='real' name='[Calculation_413768264647491584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(cwt_numerador_completed)&#13;&#10;/&#13;&#10;(SUM([tot_chats])-sum(abandonados_antes_10segs))' />
            </column>
            <column caption='fecha_ultimo_nivel' datatype='string' name='[Calculation_463307853675192451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_986006870507741184]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_986006870507741184]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Parámetro 1], [Calculation_986006870507741184]))&#13;&#10;END' />
            </column>
            <column caption='Dynamic Date' datatype='datetime' name='[Calculation_986006870507741184]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parámetro 1], [fecha])' />
