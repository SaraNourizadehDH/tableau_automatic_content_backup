            <column caption='PSAT Agente' datatype='real' default-format='p0.0%' name='[Calculation_231090982319009833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_231090982318764071]) * ((SUM([cant_casos_ps])) / (SUM([cant_casos_ps]) + SUM([cant_chats_ps])))&#13;&#10;+&#13;&#10;ZN([PSAT Casos (copia)_231090982318927912]) * ((SUM([cant_chats_ps])) / (SUM([cant_casos_ps]) + SUM([cant_chats_ps])))' />
