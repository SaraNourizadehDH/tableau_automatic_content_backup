            <column-instance column='[Calculation_1322087994075381882]' derivation='Month' name='[mn:Calculation_1322087994075381882:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1322087994075381882]' derivation='None' name='[none:Calculation_1322087994075381882:qk]' pivot='key' type='quantitative' />
