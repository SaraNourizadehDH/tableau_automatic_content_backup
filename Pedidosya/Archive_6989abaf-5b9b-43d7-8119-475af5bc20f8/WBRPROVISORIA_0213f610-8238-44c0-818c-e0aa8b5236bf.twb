            </column>
            <column caption='SLA PS (ps, auto, calls)' datatype='real' default-format='p0.0%' name='[Calculation_231090982317199395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_231090982316036129]) * (ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_chats])) / [Calculation_231090982274187268])&#13;&#10;+&#13;&#10;ZN([Calculation_231090982316703778]) * (ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_cases])) / [Calculation_231090982274187268])' />
            </column>
            <column caption='PSAT Casos' datatype='real' default-format='p0.0%' name='[Calculation_231090982318764071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    ZN(SUM([sat_casos_ps]))&#13;&#10;    &#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([resp_casos_ps]))&#13;&#10;    &#13;&#10;    &#13;&#10;)' />
