          <datasource-dependencies datasource='federated.0e7yaqr1ivmpk310mijqx0wx69zq'>
            <column caption='CSAT Chats' datatype='real' default-format='p0.0%' name='[CSAT Casos (copia)_986006870540169249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sat_chats_cs])&#13;&#10;/&#13;&#10;sum([resp_chats_cs])' />
