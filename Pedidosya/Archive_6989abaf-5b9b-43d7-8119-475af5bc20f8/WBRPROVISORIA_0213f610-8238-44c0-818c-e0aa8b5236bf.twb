            </column>
            <column caption='fecha_ultimo_nivel' datatype='string' name='[Calculation_463307853673578626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;month&apos;) THEN&#13;&#10;    &quot;&quot;&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;iso-week&apos;) THEN&#13;&#10;    &quot;W&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087994075381882]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;quarter&apos;) THEN&#13;&#10;    &quot;Q&quot; + STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087994075381882]))&#13;&#10;ELSE // day&#13;&#10;    STR(DATEPART([Parameters].[Parámetro 1], [Calculation_1322087994075381882]))&#13;&#10;END' />
            </column>
            <column caption='SLA Total Sin redes' datatype='real' default-format='p0.0%' name='[SLA Total (copia)_229402136660631667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([federated.0e7yaqr1ivmpk310mijqx0wx69zq].[Calculation_229402137007063158]) * ((ZN(SUM([cs_cases])) + ZN(SUM([cs_chats]))) / [Total Issues SLA (copia)_229402136664461428])&#13;&#10;+&#13;&#10;ZN([federated.0icrhgu0d17hy81c5mxe211ktu4x].[Calculation_231090982317199395]) * ([federated.0icrhgu0d17hy81c5mxe211ktu4x].[Calculation_231090982274187268] / [Total Issues SLA (copia)_229402136664461428])&#13;&#10;+&#13;&#10;ZN([federated.0hg7usr1tkcpft131oell1mbbk8x].[SLA1 RS (copia)_1322087993820397638]) * ([federated.0hg7usr1tkcpft131oell1mbbk8x].[Calculation_1322087993814409269] / [Total Issues SLA (copia)_229402136664461428])&#13;&#10;+&#13;&#10;ZN([federated.0bs001i0x334ee18l7pgi0dps6r3].[Calculation_1322087993757114384]) * (ZN((SUM([federated.0bs001i0x334ee18l7pgi0dps6r3].[zendesk_chats_ss])) + ZN(SUM([federated.0bs001i0x334ee18l7pgi0dps6r3].[fc_chats_ss]))) / [Total Issues SLA (copia)_229402136664461428])' />
