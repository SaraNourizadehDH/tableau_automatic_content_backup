      <column caption='Total Casos SS' datatype='integer' name='[Calculation_463307845882597442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//fc chats no se saca porque no esta en el total de acciones&#13;&#10;ZN(SUM([total_actions_ss])) - ZN(SUM([total_chats_ss]))' />
