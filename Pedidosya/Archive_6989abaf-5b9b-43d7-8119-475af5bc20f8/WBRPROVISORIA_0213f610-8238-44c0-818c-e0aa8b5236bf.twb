              <calculation class='tableau' formula='zn([Calculation_231090982319009833]) * zn(sum([cant_casos_ps])+SUM([cant_chats_ps]))&#13;&#10;/&#13;&#10;(sum([cant_casos_ps])+SUM([cant_chats_ps])+ zn(sum([qty_deflection])))&#13;&#10;+&#13;&#10;zn([Calculation_229402134848126976]) * zn(sum([qty_deflection]))&#13;&#10;/&#13;&#10;(sum([cant_casos_ps])+SUM([cant_chats_ps])+ zn(sum([qty_deflection])))' />
            </column>
            <column caption='PSAT Chats' datatype='real' default-format='p0.0%' name='[PSAT Casos (copia)_231090982318927912]' role='measure' type='quantitative'>
