            <column caption='Session Rate PS' datatype='real' default-format='p0.0%' name='[Calculation_231090982276624389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ex Contact Rate&#13;&#10;// 20210122 - Se vuelven a sumar las calls&#13;&#10;[Calculation_2867948540611227691]&#13;&#10;/&#13;&#10;SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[total_orders])' />
