      <column caption='Metric A' datatype='real' name='[Calculation_1252000747401285639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &apos;%CWT&apos; then [Calculation_1252000747323396096]&#13;&#10;WHEN &apos;CR RS&apos; THEN [Contact Rate RS (copia)_6320802082038448128]&#13;&#10;WHEN &apos;SLA2 RS&apos; THEN [SLA1 RS (copia)_1322087993820397638]&#13;&#10;WHEN &apos;RSAT&apos; THEN [Calculation_1322087993820782663]&#13;&#10;WHEN &apos;AHT&apos; THEN [Calculation_1090434091159134240]&#13;&#10;WHEN &apos;Total contacts&apos; THEN [Calculation_1322087993814409269]&#13;&#10;END' />
      </column>
      <column caption='Total Contacts RS' datatype='integer' name='[Calculation_1322087993814409269]' role='measure' type='quantitative'>
