      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_39536D0156B34990B789877B7AFA603E'>
            <properties context=''>
              <relation connection='bigquery.0aghob70xlut8f11iayo31yud8i6' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH chats AS (
	SELECT
    date(lt.createddate, 'America/Montevideo') as fecha,
		cd.country_id,
		sum(CASE WHEN lt.status = 'Completed' AND lt.WaitTime <<= 30 THEN 1 ELSE 0 END) AS sla_chats_cs,
    sum(CASE WHEN lt.status = 'Missed' AND lt.Abandoned << 10 THEN 1 ELSE 0 END) AS abandonados_antes_10segs,
    sum(CASE WHEN lt.status = 'Completed' AND lt.WaitTime <<= 90 THEN 1  ELSE 0 END) AS cwt_numerador_completed,
		(COUNT(order_number) - COUNT(DISTINCT order_number)) AS chats_repetidos_cs,
		sum(DATETIME_DIFF(datetime(lt.LastModifiedDate), datetime(lt.StartTime), SECOND )) AS aht_acw_cs,
    count (lt.id) as tot_chats
	FROM `peya-data-origins-pro.cl_salesforce.livechat_transcript` as lt

  INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN lt.Country = 'Panama' THEN 'Panamá'
                                      WHEN lt.Country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN lt.Country = 'Peru' THEN 'Perú'
                                      WHEN lt.Country = 'Salvador' THEN 'El Salvador'
                                      ELSE lt.Country
                                  END)
           AND cd.active
		   AND cd.country_id != 6
	
	WHERE date(lt.createddate, 'America/Montevideo')  >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND lt.Country not in('Colombia')
    AND lt.Country not in('Germany')
    and lt.LiveChatButtonId IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK')

   
	GROUP BY 1,2
), 
casos AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','Social Media') AND DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 24 THEN 1 ELSE 0 END) AS sla_casos_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 1 THEN 1 ELSE 0 END) AS sla_redes_cs,
		(COUNT(case_order_id) - COUNT(DISTINCT case_order_id)) AS issues_repetidos_cs
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
	
	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND case_type IN ('Customer')
	  AND record_type_name IN ('PY Inbound Case')
	  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%') 	  
	  AND country_id != 6
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
), 
casos_changes AS (
	SELECT
		DATE(ca.create_date) AS created_date,
		ca.user_id,
		ca.case_origin,
		ca.country_id,
		ch.new_value,
		ch.field
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca
	
	LEFT JOIN (
		SELECT 
			CaseId AS case_id,
			NewValue AS new_value,
			Field AS field
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes`
		WHERE DATE(CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	) ch ON ch.case_id = ca.case_id
	
	WHERE DATE(ca.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ca.case_button_name IN ('PY_Inbound_Case')
	  AND ca.case_origin IN ('Helpcenter','Email','Facebook','Twitter','Instagram','Social Media')
	  AND ca.case_type IN ('Customer')
	  AND ca.country_id != 6
	  AND (ca.case_subjec NOT LIKE '%NDC |%' OR ca.case_subjec NOT LIKE '%No country%' OR ca.case_subjec NOT LIKE '%restaurant portal%')
), 
shnk_cs AS (
	SELECT
		DATE(datos_cs.fecha) AS fecha,
		NULL AS country_id,
		SUM(tiempo_conexion_cs) AS tiempo_conexion_cs,
		SUM(tiempo_prod_chats_cs) AS tiempo_prod_chats_cs,
		SUM(tiempo_prod_casos_cs) AS tiempo_prod_casos_cs,
		SUM(tiempo_non_sf_cs) AS tiempo_non_sf_cs,
		SUM(tiempo_noprod_cs) AS tiempo_noprod_cs
	FROM (
		SELECT
			fecha,
			user_id
		FROM (
			SELECT
				DATE(start_time) AS fecha,
				chat_transcript_user_id AS user_id
			FROM (
				SELECT
					DATE(start_time) AS start_time,
					chat_transcript_user_id
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
				
				WHERE DATE(start_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment','CS_SPA_PedidosYa_Urgent_Customer_Chat')
				  AND country_id != 6
			)
			GROUP BY 1,2
		) AS chats
		
		UNION DISTINCT
			SELECT
				DATE(created_date) AS fecha,
				user_id
			FROM casos_changes
			GROUP BY 1,2
	) AS datos_cs
	
	LEFT JOIN (
		SELECT 
			DATE(presence_status_start_date) as fecha,
			presence_user_id as user_id,
			SUM(CASE WHEN status_name in ('Busy','Lunch_Dinner','Short_Break_personal','Training_QA_Meeting') THEN presence_status_duration ELSE 0 END) AS tiempo_noprod_cs,
			SUM(presence_status_duration) as tiempo_conexion_cs,
			SUM(CASE WHEN status_name in ('Chats_Only', 'Cases_Chats') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_chats_cs,
			SUM(CASE WHEN status_name in ('Cases_Only') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_casos_cs,
			SUM(CASE WHEN status_name IN ('Assigned_Task_Non_SF') THEN presence_status_duration ELSE 0 END) AS tiempo_non_sf_cs
		FROM`peya-bi-tools-pro.il_salesforce.fact_salesforce_user_presence`
		
		WHERE DATE(presence_status_start_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		GROUP BY 1, 2
	) AS shnk_cs ON shnk_cs.fecha = datos_cs.fecha
				AND shnk_cs.user_id = datos_cs.user_id
	GROUP BY 1
),
csat AS (
	SELECT
		DATE(csat_mg.created_date) AS fecha,
        cd.country_id,
		SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media') THEN sat else 0 END) as  sat_casos_cs,
        SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media') THEN total_cases else 0 END) as  total_casos_cs,
        SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media')THEN response else 0 END) as  resp_casos_cs,
		SUM(CASE WHEN csat_mg.origin = 'SSF' THEN sat ELSE 0 END) AS sat_ssf_cs,
        SUM(CASE WHEN csat_mg.origin = 'SSF' THEN total_cases ELSE 0 END) AS total_ssf_cs,
        SUM(CASE WHEN csat_mg.origin = 'SSF' THEN response ELSE 0 END) AS resp_ssf_cs,
		SUM(CASE WHEN csat_mg.origin = 'Chat' THEN sat ELSE 0 END) AS sat_chats_cs,
        SUM(CASE WHEN csat_mg.origin = 'Chat' THEN total_cases ELSE 0 END) AS total_chats_cs,
        SUM(CASE WHEN csat_mg.origin = 'Chat' THEN response ELSE 0 END) AS resp_chats_cs,

	FROM `peya-delivery-and-support.automated_tables_reports.data_wbr_cs` csat_mg

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN csat_mg.country_name = 'Panama' THEN 'Panamá'
                                      WHEN csat_mg.country_name = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN csat_mg.country_name = 'Peru' THEN 'Perú'
                                      WHEN csat_mg.country_name = 'Salvador' THEN 'El Salvador'
                                      ELSE csat_mg.country_name
                                  END)
           AND cd.active
		   AND cd.country_id != 6

	WHERE DATE(csat_mg.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
),



chats_repetidos_agente AS (
	SELECT
		fecha,
		country_id,
		SUM(recontacto) AS chats_repetidos_agente_cs
	FROM (
		SELECT 
			DATE(request_time) AS fecha,
			chat_transcript_user_id,
			slt.country_id,
			COUNT(*) AS recontacto
		FROM(
			SELECT
				request_time,
				start_time,
				order_id,
				chat_transcript_user_id,
				chat_transcript_name,
				country_id,
				CAST(request_time AS STRING) || ' ' || CAST(order_id AS STRING) AS con
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			WHERE DATE(request_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Urgent_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment')
			  AND start_time IS NOT NULL
		) AS slt
		
		FULL OUTER JOIN(
			SELECT 
				CAST(fecha_max AS STRING) || ' ' ||  CAST(order_id AS STRING) AS con
			FROM (
				SELECT 
					DATE(request_time) AS fecha,
					order_id,
					MAX(request_time) AS fecha_max,
					COUNT(*) AS dupli 
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`

				WHERE DATE(request_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Urgent_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment')
				  AND start_time IS NOT NULL
				GROUP BY 1,2
			)
		) AS ultimo_chat ON slt.con = ultimo_chat.con
		
		WHERE ultimo_chat.con is null
		  AND request_time IS NOT null
		  AND order_id IS NOT NULL
		GROUP BY 1,2,3
	)
	GROUP BY 1,2
), 
 
sla_fr AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN (DATE_DIFF(created_date,create_date,SECOND)/3600 << 12 AND case_origin IN ('Helpcenter','Email','Social Media')) THEN 1 ELSE 0 END) AS sla_casos_fr_cs,
		SUM(CASE WHEN (DATE_DIFF(created_date,create_date,SECOND)/60 << 10 AND case_origin IN ('Facebook','Twitter','Instagram')) THEN 1 ELSE 0 END) AS sla_redes_fr_cs
	FROM (
		SELECT 
			TIMESTAMP(create_date) AS create_date,
			case_id,
			case_type,
			case_origin,
			country_id
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

		WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	      AND record_type_name = 'PY Inbound Case' 
		  AND case_origin != 'Chat'
		  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%')
		  AND case_type IN ('Customer')
	) AS casos
	
	LEFT JOIN (
		SELECT 
			cc.CaseId AS case_id,
			MIN(TIMESTAMP(DATETIME(cc.CreatedDate, cd.timezone))) AS created_date 
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` cc

		LEFT JOIN (
			SELECT 
				case_id,
				country_id 
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) ca ON ca.case_id = cc.CaseId

		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
				ON cd.country_id = ca.country_id
			   AND cd.active
			   AND cd.country_id != 6

		WHERE DATE(cc.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND cc.Field IN ('Status') 
		  AND cc.NewValue IN ('Resolved')
		GROUP BY 1
	) AS primera_resp ON primera_resp.case_id = casos.case_id
	GROUP BY 1,2
)
SELECT
	COALESCE(c.fecha, h.fecha) AS fecha,
	COALESCE(c.country_id, h.country_id) AS country_id,

	c.sla_chats_cs,
	c.chats_repetidos_cs,
	c.aht_acw_cs,
	c.sla_casos_cs,
	c.sla_redes_cs,
	c.issues_repetidos_cs,
  c.abandonados_antes_10segs,
  c.cwt_numerador_completed,
  c.tot_chats,

	r.chats_repetidos_agente_cs,

	sfr.sla_casos_fr_cs,
	sfr.sla_redes_fr_cs,

	s.sat_casos_cs,
    s.resp_casos_cs,
    s.total_casos_cs,
    s.sat_chats_cs,
    s.resp_chats_cs,
    s.total_chats_cs,
    s.sat_ssf_cs,
    s.resp_ssf_cs,
    s.total_ssf_cs,
	
	resueltos.casos_resueltos_cs,
	resueltos.casos_reabiertos_cs,	
	resueltos.redes_resueltas_cs,
	resueltos.redes_newanswer_cs,
		
	h.tiempo_conexion_cs,
	h.tiempo_noprod_cs,
	h.tiempo_prod_chats_cs,
	h.tiempo_prod_casos_cs,
	h.tiempo_non_sf_cs,

	
FROM (
	SELECT
		COALESCE(ch.fecha,ca.fecha) AS fecha,
		COALESCE(ch.country_id,ca.country_id) AS country_id,
		ch.sla_chats_cs,
		ch.chats_repetidos_cs,
		ch.aht_acw_cs,
		ca.sla_casos_cs,
		ca.sla_redes_cs,
		ca.issues_repetidos_cs,
    ch.abandonados_antes_10segs,
    ch.cwt_numerador_completed,
    ch.tot_chats,
  
	FROM chats AS ch
	
	FULL OUTER JOIN casos ca 
			     ON ca.fecha = ch.fecha 
			    AND ca.country_id = ch.country_id
) AS c

LEFT JOIN csat s 
	   ON s.fecha = c.fecha 
	  AND s.country_id = c.country_id


LEFT JOIN chats_repetidos_agente r 
	   ON r.fecha = c.fecha 
	  AND r.country_id = c.country_id


FULL OUTER JOIN shnk_cs h 
			 ON h.fecha = c.fecha
			AND h.country_id = c.country_id

LEFT JOIN (
	SELECT
		DATE(created_date) AS fecha,
		country_id,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','email','Social Media') AND field IN ('Status') AND new_value IN ('Resolved') THEN 1 ELSE 0 END) AS casos_resueltos_cs,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','email','Social Media') AND field IN ('Status') AND new_value IN ('Reopen') THEN 1 ELSE 0 END) AS casos_reabiertos_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND field IN ('Status') AND new_value IN ('Resolved') THEN 1 ELSE 0 END) AS redes_resueltas_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND field IN ('Status') AND new_value IN ('New Answer') THEN 1 ELSE 0 END) AS redes_newanswer_cs
	FROM casos_changes
	GROUP BY 1,2
) AS resueltos ON resueltos.fecha = c.fecha 
	          AND resueltos.country_id = c.country_id

LEFT JOIN sla_fr sfr ON sfr.fecha = c.fecha 
                    AND sfr.country_id = c.country_id   

ORDER BY 1 DESC, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='RS (BQ)' inline='true' name='federated.0hg7usr1tkcpft131oell1mbbk8x' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1elsjbz17up41d0ztj2fv046akuo'>
            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-paraguay' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_gcc_service' server-oauth='' username='sebastian.diazdevaldes@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1elsjbz17up41d0ztj2fv046akuo' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*--- WBR RS ---*/

WITH chats_rs AS (
    SELECT
        DISTINCT fc.chat_created_at,
        DATETIME(fc.chat_created_at, 'America/Montevideo') as horasposta,
        fc.dispatcher_email,
        fc.queue_time,
        CASE WHEN TIMESTAMP_DIFF(fc.first_response_timestamp,fc.chat_created_at, SECOND) << 30 THEN 1 ELSE 0 END as chat_within_sla_30,
        CASE WHEN TIMESTAMP_DIFF(fc.first_response_timestamp,fc.chat_created_at, SECOND) <<= 90 THEN 1 ELSE 0 END AS cwt_90,
        fc.handling_time,
        fc.first_reply_time,
        cd.country_id,
        fc.interaction_id
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN fc.country = 'Panama' THEN 'Panamá'
                                      WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN fc.country = 'Peru' THEN 'Perú'
                                      WHEN fc.country = 'Salvador' THEN 'El Salvador'
                                      ELSE fc.country
                                  END)
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND fc.department = 'Rider'
      AND fc.management_entity = 'Pedidosya'
          /*AND FC.dispatcher_email NOT LIKE('%%@deliveryhero.com') 
          AND FC.dispatcher_email NOT LIKE('%%@clickdelivery.com') */
          AND FC.automated_chat = 0
          AND fc. country != 'Colombia'
), 
hurrier AS (
    SELECT 
        DATE(DATE_ADD(li.created_at, INTERVAL -3 HOUR)) AS fecha,
        cd.country_id,
        COUNT(DISTINCT li.issue_id) AS rs_hurrier_issues,
        COUNT(DISTINCT CASE WHEN li.picked_at IS NOT NULL THEN li.issue_id END) rs_hurrier_picked_issues
    FROM `peya-data-origins-pro.cl_hurrier.issues` li

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
            ON LOWER(cd.iso_code_2) = li.country_code
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(li.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND li.show_on_watchlist
    GROUP BY 1,2
),
rsat AS (
    SELECT
        DATE(fc.chat_created_at) AS fecha,
            cd.country_id,
        SUM(CASE WHEN ft.contact_reason_l2 <<>> ' Chat acknowledgment' AND csat_rating >>= 4 THEN 1 ELSE 0 END) AS sat_rs,
        SUM(CASE WHEN ft.contact_reason_l2 <<>> ' Chat acknowledgment' and csat_rating <<= 3 THEN 1 ELSE 0 END) AS insat_rs
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc
    
    LEFT JOIN (
        SELECT 
            interaction_id,
            contact_reason_l2
        FROM `peya-data-origins-pro.cl_gcc_service.freshdesk_tickets`
        WHERE DATE(created_date) >>=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    ) ft ON ft.interaction_id = fc.interaction_id

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN fc.country = 'Panama' THEN 'Panamá'
                                      WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN fc.country = 'Peru' THEN 'Perú'
                                      WHEN fc.country = 'Salvador' THEN 'El Salvador'
                                      ELSE fc.country
                                  END)
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND fc.department = 'Rider'
      AND fc.automated_chat = 0
    GROUP BY 1,2
)

SELECT
    COALESCE(data_rs.fecha,prod_rs.fecha) AS fecha,
    COALESCE(data_rs.country_id,prod_rs.country_id) AS country_id,
    /* FRESCHAT */
    data_rs.rs_chats,
    prod_rs.tiempo_prod_rs,
    data_rs.sla1_rs,
    data_rs.cwt,
    data_rs.sla2_rs,
    data_rs.aht_rs,
    data_rs.aqt_rs,
    data_rs.aat_rs,
    rsat.sat_rs,
    rsat.insat_rs,
    /* HURRIER */
    data_rs.rs_hurrier_issues,
    data_rs.rs_hurrier_picked_issues
FROM (
    SELECT
        COALESCE(r.fecha,h.fecha) AS fecha,
        COALESCE(r.country_id,h.country_id) AS country_id,
        r.rs_chats,
        r.sla1_rs,
        r.cwt,
        r.sla2_rs,
        r.aht_rs,
        r.aqt_rs,
        r.aat_rs,
        h.rs_hurrier_issues,
        h.rs_hurrier_picked_issues
    FROM (
        SELECT
            fecha,
            country_id,
            SUM(total_chats) AS rs_chats,
            sum(sla1) as sla1_rs,
            sum(cwt) as cwt,
            sum(sla2) as sla2_rs,
            sum(AHT) as aht_rs,
            sum(AQT) as aqt_rs,
            sum(AAT) as aat_rs
        FROM (
            SELECT
                DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
                EXTRACT(WEEK FROM horasposta) AS semana,
                EXTRACT(MONTH FROM horasposta) AS mes,
                EXTRACT(HOUR FROM horasposta) AS HORAS,
                CASE WHEN EXTRACT(MINUTE FROM horasposta) <<= 30 THEN '00:00' else '30:00' end AS MINUTOS,
                dispatcher_email,
                country_id,
                COUNT(DISTINCT interaction_id) AS total_chats,
                SUM(case when queue_time << 30 then 1 else 0 end) as sla1,
                SUM(chat_within_sla_30) as sla2,
                SUM(cwt_90) as cwt,
                SUM(handling_time) as AHT,
                SUM(queue_time) as AQT,
                SUM(first_reply_time) as AAT
            FROM chats_rs
            GROUP BY 1,2,3,4,5,6,7
        )
        GROUP BY 1,2
    ) r

    FULL OUTER JOIN hurrier h 
                 ON h.fecha = r.fecha 
                AND h.country_id = r.country_id
) data_rs

LEFT JOIN rsat AS rsat 
       ON rsat.fecha = data_rs.fecha 
      AND rsat.country_id = data_rs.country_id

FULL OUTER JOIN (
    SELECT
        fecha,
        NULL AS country_id,
        SUM(CASE WHEN total_chats >> 2 THEN 0.5 ELSE 0 END) as tiempo_prod_rs
    FROM (
        SELECT
            DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
            EXTRACT(WEEK FROM horasposta) AS semana,
            EXTRACT(MONTH FROM horasposta) AS mes,
            EXTRACT(HOUR FROM horasposta) AS HORAS,
            CASE WHEN EXTRACT(MINUTE FROM horasposta) <<= 30 THEN '00:00' else '30:00' end AS MINUTOS,
            dispatcher_email,
            COUNT(DISTINCT interaction_id) AS total_chats
        FROM chats_rs
        GROUP BY 1,2,3,4,5,6
    )
    GROUP BY 1
) prod_rs ON prod_rs.fecha = data_rs.fecha 
         AND prod_rs.country_id = data_rs.country_id

ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1elsjbz17up41d0ztj2fv046akuo' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*--- WBR RS ---*/

WITH chats_rs AS (
    SELECT
        DISTINCT fc.chat_created_at,
        DATETIME(fc.chat_created_at, 'America/Montevideo') as horasposta,
        fc.dispatcher_email,
        fc.queue_time,
        CASE WHEN TIMESTAMP_DIFF(fc.first_response_timestamp,fc.chat_created_at, SECOND) << 30 THEN 1 ELSE 0 END as chat_within_sla_30,
        CASE WHEN TIMESTAMP_DIFF(fc.first_response_timestamp,fc.chat_created_at, SECOND) <<= 90 THEN 1 ELSE 0 END AS cwt_90,
        fc.handling_time,
        fc.first_reply_time,
        cd.country_id,
        fc.interaction_id
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN fc.country = 'Panama' THEN 'Panamá'
                                      WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN fc.country = 'Peru' THEN 'Perú'
                                      WHEN fc.country = 'Salvador' THEN 'El Salvador'
                                      ELSE fc.country
                                  END)
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND fc.department = 'Rider'
      AND fc.management_entity = 'Pedidosya'
          /*AND FC.dispatcher_email NOT LIKE('%%@deliveryhero.com') 
          AND FC.dispatcher_email NOT LIKE('%%@clickdelivery.com') */
          AND FC.automated_chat = 0
          AND fc. country != 'Colombia'
), 
hurrier AS (
    SELECT 
        DATE(DATE_ADD(li.created_at, INTERVAL -3 HOUR)) AS fecha,
        cd.country_id,
        COUNT(DISTINCT li.issue_id) AS rs_hurrier_issues,
        COUNT(DISTINCT CASE WHEN li.picked_at IS NOT NULL THEN li.issue_id END) rs_hurrier_picked_issues
    FROM `peya-data-origins-pro.cl_hurrier.issues` li

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
            ON LOWER(cd.iso_code_2) = li.country_code
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(li.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND li.show_on_watchlist
    GROUP BY 1,2
),
rsat AS (
    SELECT
        DATE(fc.chat_created_at) AS fecha,
            cd.country_id,
        SUM(CASE WHEN ft.contact_reason_l2 <<>> ' Chat acknowledgment' AND csat_rating >>= 4 THEN 1 ELSE 0 END) AS sat_rs,
        SUM(CASE WHEN ft.contact_reason_l2 <<>> ' Chat acknowledgment' and csat_rating <<= 3 THEN 1 ELSE 0 END) AS insat_rs
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc
    
    LEFT JOIN (
        SELECT 
            interaction_id,
            contact_reason_l2
        FROM `peya-data-origins-pro.cl_gcc_service.freshdesk_tickets`
        WHERE DATE(created_date) >>=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    ) ft ON ft.interaction_id = fc.interaction_id

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN fc.country = 'Panama' THEN 'Panamá'
                                      WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN fc.country = 'Peru' THEN 'Perú'
                                      WHEN fc.country = 'Salvador' THEN 'El Salvador'
                                      ELSE fc.country
                                  END)
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND fc.department = 'Rider'
      AND fc.automated_chat = 0
    GROUP BY 1,2
)

SELECT
    COALESCE(data_rs.fecha,prod_rs.fecha) AS fecha,
    COALESCE(data_rs.country_id,prod_rs.country_id) AS country_id,
    /* FRESCHAT */
    data_rs.rs_chats,
    prod_rs.tiempo_prod_rs,
    data_rs.sla1_rs,
    data_rs.cwt,
    data_rs.sla2_rs,
    data_rs.aht_rs,
    data_rs.aqt_rs,
    data_rs.aat_rs,
    rsat.sat_rs,
    rsat.insat_rs,
    /* HURRIER */
    data_rs.rs_hurrier_issues,
    data_rs.rs_hurrier_picked_issues
FROM (
    SELECT
        COALESCE(r.fecha,h.fecha) AS fecha,
        COALESCE(r.country_id,h.country_id) AS country_id,
        r.rs_chats,
        r.sla1_rs,
        r.cwt,
        r.sla2_rs,
        r.aht_rs,
        r.aqt_rs,
        r.aat_rs,
        h.rs_hurrier_issues,
        h.rs_hurrier_picked_issues
    FROM (
        SELECT
            fecha,
            country_id,
            SUM(total_chats) AS rs_chats,
            sum(sla1) as sla1_rs,
            sum(cwt) as cwt,
            sum(sla2) as sla2_rs,
            sum(AHT) as aht_rs,
            sum(AQT) as aqt_rs,
            sum(AAT) as aat_rs
        FROM (
            SELECT
                DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
                EXTRACT(WEEK FROM horasposta) AS semana,
                EXTRACT(MONTH FROM horasposta) AS mes,
                EXTRACT(HOUR FROM horasposta) AS HORAS,
                CASE WHEN EXTRACT(MINUTE FROM horasposta) <<= 30 THEN '00:00' else '30:00' end AS MINUTOS,
                dispatcher_email,
                country_id,
                COUNT(DISTINCT interaction_id) AS total_chats,
                SUM(case when queue_time << 30 then 1 else 0 end) as sla1,
                SUM(chat_within_sla_30) as sla2,
                SUM(cwt_90) as cwt,
                SUM(handling_time) as AHT,
                SUM(queue_time) as AQT,
                SUM(first_reply_time) as AAT
            FROM chats_rs
            GROUP BY 1,2,3,4,5,6,7
        )
        GROUP BY 1,2
    ) r

    FULL OUTER JOIN hurrier h 
                 ON h.fecha = r.fecha 
                AND h.country_id = r.country_id
) data_rs

LEFT JOIN rsat AS rsat 
       ON rsat.fecha = data_rs.fecha 
      AND rsat.country_id = data_rs.country_id

FULL OUTER JOIN (
    SELECT
        fecha,
        NULL AS country_id,
        SUM(CASE WHEN total_chats >> 2 THEN 0.5 ELSE 0 END) as tiempo_prod_rs
    FROM (
        SELECT
            DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
            EXTRACT(WEEK FROM horasposta) AS semana,
            EXTRACT(MONTH FROM horasposta) AS mes,
            EXTRACT(HOUR FROM horasposta) AS HORAS,
            CASE WHEN EXTRACT(MINUTE FROM horasposta) <<= 30 THEN '00:00' else '30:00' end AS MINUTOS,
            dispatcher_email,
            COUNT(DISTINCT interaction_id) AS total_chats
        FROM chats_rs
        GROUP BY 1,2,3,4,5,6
    )
    GROUP BY 1
) prod_rs ON prod_rs.fecha = data_rs.fecha 
         AND prod_rs.country_id = data_rs.country_id

ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
