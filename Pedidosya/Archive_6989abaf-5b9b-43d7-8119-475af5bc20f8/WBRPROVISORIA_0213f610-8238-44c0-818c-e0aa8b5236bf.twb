            </column>
            <column caption='SLA Total CS' datatype='real' default-format='p0.0%' name='[Calculation_986006870552424492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[SLA Casos CS (copia)_986006870551654441] * (SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats]) / [Calculation_986006870514139154])&#13;&#10;+&#13;&#10;[Calculation_986006870550032424] * (SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_cases]) / [Calculation_986006870514139154])&#13;&#10;+&#13;&#10;[SLA Chats CS (copia)_986006870552014890] * (SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_redes]) / [Calculation_986006870514139154])' />
            </column>
            <column caption='ACC CS' datatype='real' default-format='p0.0%' name='[Calculation_986006870559391789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats_atendidos]) + SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_auto_proc]))&#13;&#10;/&#13;&#10;SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats])' />
