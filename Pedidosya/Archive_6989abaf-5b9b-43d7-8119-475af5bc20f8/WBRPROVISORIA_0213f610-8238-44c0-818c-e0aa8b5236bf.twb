            </column>
            <column caption='Total Sessions PS' datatype='integer' name='[Calculation_2867948540611227691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Contacts PS (copia)_482729597194108928] + SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[total_deflect_ps])' />
