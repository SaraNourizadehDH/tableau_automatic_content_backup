      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_2883A042A0EF49BDA3610B1347A12CC6'>
            <properties context=''>
              <relation connection='bigquery.1elsjbz17up41d0ztj2fv046akuo' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*--- WBR RS ---*/

WITH chats_rs AS (
    SELECT
        DISTINCT fc.chat_created_at,
        DATETIME(fc.chat_created_at, 'America/Montevideo') as horasposta,
        fc.dispatcher_email,
        fc.queue_time,
        CASE WHEN TIMESTAMP_DIFF(fc.first_response_timestamp,fc.chat_created_at, SECOND) << 30 THEN 1 ELSE 0 END as chat_within_sla_30,
        CASE WHEN TIMESTAMP_DIFF(fc.first_response_timestamp,fc.chat_created_at, SECOND) <<= 90 THEN 1 ELSE 0 END AS cwt_90,
        fc.handling_time,
        fc.first_reply_time,
        cd.country_id,
        fc.interaction_id
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN fc.country = 'Panama' THEN 'Panamá'
                                      WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN fc.country = 'Peru' THEN 'Perú'
                                      WHEN fc.country = 'Salvador' THEN 'El Salvador'
                                      ELSE fc.country
                                  END)
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND fc.department = 'Rider'
      AND fc.management_entity = 'Pedidosya'
          /*AND FC.dispatcher_email NOT LIKE('%%@deliveryhero.com') 
          AND FC.dispatcher_email NOT LIKE('%%@clickdelivery.com') */
          AND FC.automated_chat = 0
          AND fc. country != 'Colombia'
), 
hurrier AS (
    SELECT 
        DATE(DATE_ADD(li.created_at, INTERVAL -3 HOUR)) AS fecha,
        cd.country_id,
        COUNT(DISTINCT li.issue_id) AS rs_hurrier_issues,
        COUNT(DISTINCT CASE WHEN li.picked_at IS NOT NULL THEN li.issue_id END) rs_hurrier_picked_issues
    FROM `peya-data-origins-pro.cl_hurrier.issues` li

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
            ON LOWER(cd.iso_code_2) = li.country_code
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(li.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND li.show_on_watchlist
    GROUP BY 1,2
),
rsat AS (
    SELECT
        DATE(fc.chat_created_at) AS fecha,
            cd.country_id,
        SUM(CASE WHEN ft.contact_reason_l2 <<>> ' Chat acknowledgment' AND csat_rating >>= 4 THEN 1 ELSE 0 END) AS sat_rs,
        SUM(CASE WHEN ft.contact_reason_l2 <<>> ' Chat acknowledgment' and csat_rating <<= 3 THEN 1 ELSE 0 END) AS insat_rs
    FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc
    
    LEFT JOIN (
        SELECT 
            interaction_id,
            contact_reason_l2
        FROM `peya-data-origins-pro.cl_gcc_service.freshdesk_tickets`
        WHERE DATE(created_date) >>=  DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    ) ft ON ft.interaction_id = fc.interaction_id

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN fc.country = 'Panama' THEN 'Panamá'
                                      WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN fc.country = 'Peru' THEN 'Perú'
                                      WHEN fc.country = 'Salvador' THEN 'El Salvador'
                                      ELSE fc.country
                                  END)
           AND cd.active
           AND cd.country_id != 6

    WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
      AND fc.department = 'Rider'
      AND fc.automated_chat = 0
    GROUP BY 1,2
)

SELECT
    COALESCE(data_rs.fecha,prod_rs.fecha) AS fecha,
    COALESCE(data_rs.country_id,prod_rs.country_id) AS country_id,
    /* FRESCHAT */
    data_rs.rs_chats,
    prod_rs.tiempo_prod_rs,
    data_rs.sla1_rs,
    data_rs.cwt,
    data_rs.sla2_rs,
    data_rs.aht_rs,
    data_rs.aqt_rs,
    data_rs.aat_rs,
    rsat.sat_rs,
    rsat.insat_rs,
    /* HURRIER */
    data_rs.rs_hurrier_issues,
    data_rs.rs_hurrier_picked_issues
FROM (
    SELECT
        COALESCE(r.fecha,h.fecha) AS fecha,
        COALESCE(r.country_id,h.country_id) AS country_id,
        r.rs_chats,
        r.sla1_rs,
        r.cwt,
        r.sla2_rs,
        r.aht_rs,
        r.aqt_rs,
        r.aat_rs,
        h.rs_hurrier_issues,
        h.rs_hurrier_picked_issues
    FROM (
        SELECT
            fecha,
            country_id,
            SUM(total_chats) AS rs_chats,
            sum(sla1) as sla1_rs,
            sum(cwt) as cwt,
            sum(sla2) as sla2_rs,
            sum(AHT) as aht_rs,
            sum(AQT) as aqt_rs,
            sum(AAT) as aat_rs
        FROM (
            SELECT
                DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
                EXTRACT(WEEK FROM horasposta) AS semana,
                EXTRACT(MONTH FROM horasposta) AS mes,
                EXTRACT(HOUR FROM horasposta) AS HORAS,
                CASE WHEN EXTRACT(MINUTE FROM horasposta) <<= 30 THEN '00:00' else '30:00' end AS MINUTOS,
                dispatcher_email,
                country_id,
                COUNT(DISTINCT interaction_id) AS total_chats,
                SUM(case when queue_time << 30 then 1 else 0 end) as sla1,
                SUM(chat_within_sla_30) as sla2,
                SUM(cwt_90) as cwt,
                SUM(handling_time) as AHT,
                SUM(queue_time) as AQT,
                SUM(first_reply_time) as AAT
            FROM chats_rs
            GROUP BY 1,2,3,4,5,6,7
        )
        GROUP BY 1,2
    ) r

    FULL OUTER JOIN hurrier h 
                 ON h.fecha = r.fecha 
                AND h.country_id = r.country_id
) data_rs

LEFT JOIN rsat AS rsat 
       ON rsat.fecha = data_rs.fecha 
      AND rsat.country_id = data_rs.country_id

FULL OUTER JOIN (
    SELECT
        fecha,
        NULL AS country_id,
        SUM(CASE WHEN total_chats >> 2 THEN 0.5 ELSE 0 END) as tiempo_prod_rs
    FROM (
        SELECT
            DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
            EXTRACT(WEEK FROM horasposta) AS semana,
            EXTRACT(MONTH FROM horasposta) AS mes,
            EXTRACT(HOUR FROM horasposta) AS HORAS,
            CASE WHEN EXTRACT(MINUTE FROM horasposta) <<= 30 THEN '00:00' else '30:00' end AS MINUTOS,
            dispatcher_email,
            COUNT(DISTINCT interaction_id) AS total_chats
        FROM chats_rs
        GROUP BY 1,2,3,4,5,6
    )
    GROUP BY 1
) prod_rs ON prod_rs.fecha = data_rs.fecha 
         AND prod_rs.country_id = data_rs.country_id

ORDER BY 1 DESC, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='PS (BQ)' inline='true' name='federated.0icrhgu0d17hy81c5mxe211ktu4x' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1emg0cz1a4ziwj14w124b08myy0r'>
            <connection CATALOG='peya-bi-tools-pro' EXECCATALOG='peya-nicaragua' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-bi-tools-pro' schema='il_salesforce' server='' server-oauth='' username='sebastian.diazdevaldes@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1emg0cz1a4ziwj14w124b08myy0r' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*--WBR PS--*/

WITH chats AS (
	SELECT
    date(ch.createddate, 'America/Montevideo') AS fecha,
    
		cd.country_id,
		SUM(CASE WHEN ch.status = 'Completed' AND ch.WaitTime <<= 30 AND ch.OwnerId NOT IN ('005w0000003pERkAAM') THEN 1 ELSE 0 END) AS sla_chats_ps,
		count (distinct case when ch.OwnerId NOT IN ('005w0000003pERkAAM') then ch.Id end) as total_chats_para_sla,
 

		sum(CASE WHEN status = 'Completed' AND ch.WaitTime <<= 90 THEN 1  ELSE 0 END) AS cwt_numerador_completed,
		sum(CASE WHEN status = 'Missed' AND ch.Abandoned << 10 THEN 1 ELSE 0 END) AS abandonados_antes_10segs,

		count (distinct ch.id) AS total_chats,

    sum(ch.ChatDuration +(case when ch.chat_cleanup_time_seconds >> 0 then chat_cleanup_time_seconds else 0 end ))AS aht_acw_ps,
	FROM `peya-data-origins-pro.cl_salesforce.livechat_transcript` ch

  INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN ch.Country = 'Panama' THEN 'Panamá'
											  WHEN ch.Country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN ch.Country = 'Peru' THEN 'Perú'
											  WHEN ch.Country = 'Salvador' THEN 'El Salvador'
											  ELSE ch.Country
										  END)
				   AND cd.active
				   AND cd.country_id != 6

	
    WHERE date(ch.createddate, 'America/Montevideo') >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ch.LiveChatButtonId IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK')
	  AND ch.Country not in('Colombia')
    AND ch.Country not in('Germany')
	GROUP BY 1,2
), 
casos AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 24 THEN 1 ELSE 0 END) AS sla_casos_ps
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND record_type_name = 'PY Inbound Case' 
	  AND case_origin NOT IN ('Chat','Phone')
	  AND (case_subjec NOT LIKE '%%NDC |%%' OR case_subjec NOT LIKE '%%No country%%' OR case_subjec NOT LIKE '%%restaurant portal%%') 
	  AND (case_type IN ('Restaurant - Data', 'Restaurant Request', 'Partner','Handover', ' ') OR case_type IS NULL)
	  AND country_id != 6
	GROUP BY 1,2
), 
casos_changes AS (
	SELECT
		DATE(ch.created_date) AS created_date,
		ca.user_id,
		ca.case_origin,
		ca.country_id,
		ch.new_value,
		ch.field		
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca

	LEFT JOIN (
		SELECT 
			cc.CaseId AS case_id,
			cc.NewValue AS new_value,
			cc.Field AS field,
			TIMESTAMP(DATETIME(cc.CreatedDate, cd.timezone)) AS created_date
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` cc
	
		LEFT JOIN (
			SELECT 
				case_id,
				country_id 
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) ca ON ca.case_id = cc.CaseId

		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
				ON cd.country_id = ca.country_id
			   AND cd.active
			   AND cd.country_id != 6	

		WHERE DATE(cc.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	) ch ON ch.case_id = ca.case_id

	WHERE DATE(ca.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ca.case_button_name = 'PY_Inbound_Case'
	  AND ca.case_origin <<>> 'Chat'
	  AND (ca.case_type IN ('Restaurant - Data','Restaurant Request','Partner','Handover',' ') OR ca.case_type IS NULL)
	  AND ca.country_id != 6
), 
shnk_ps AS (
	SELECT
		DATE(datos_ps.fecha) AS fecha,
		NULL AS country_id,
		SUM(tiempo_conexion_ps) AS tiempo_conexion_ps,
		SUM(tiempo_prod_chats_ps) AS tiempo_prod_chats_ps,
		SUM(tiempo_prod_casos_ps) AS tiempo_prod_casos_ps,
		SUM(tiempo_noprod_ps) AS tiempo_noprod_ps
	FROM (
		SELECT
			fecha,
			user_id
		FROM (
			SELECT
				DATE(start_time) AS fecha,
				chat_transcript_user_id AS user_id
			FROM (
				SELECT
					DATE(ch.start_time) AS start_time,
					ch.chat_transcript_user_id
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts` ch

				WHERE DATE(ch.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_id IN ('5731r000000H1Z1AAK','5731r000000H1Z3AAK','5731r000000btd7AAA','5731r0000008gICAAY','5731r000000btd6AAA','5731r0000008gIBAAY','5731r0000008gIDAAY')
				  AND ch.country_id != 6
			)
			GROUP BY 1,2
		) chats
		
		UNION DISTINCT
			SELECT
				DATE(created_date) AS fecha,
				user_id
			FROM casos_changes
			GROUP BY 1,2
	) datos_ps
	
	LEFT JOIN (
		SELECT 
			DATE(presence_status_start_date) as fecha,
			presence_user_id as user_id,
			SUM(CASE WHEN status_name in ('Busy','Lunch_Dinner','Short_Break_personal','Training_QA_Meeting') THEN presence_status_duration ELSE 0 END) AS tiempo_noprod_ps,
			SUM(presence_status_duration) as tiempo_conexion_ps,
			SUM(CASE WHEN status_name in ('Chats_Only') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_chats_ps,
			SUM(CASE WHEN status_name in ('Cases_Only','Assigned_Task_Non_Omni','Cases_Calls') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_casos_ps
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_user_presence`
		
		WHERE DATE(presence_created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		GROUP BY 1, 2
	) shnk_ps ON shnk_ps.fecha = datos_ps.fecha
		     AND shnk_ps.user_id = datos_ps.user_id
	GROUP BY 1
), 



psat_new as (

    SELECT 
        gp.fecha,
        cd.country_id as country_id,
        gp.sat_cases as sat_casos_ps,
        gp.respuestas_cases as resp_casos_ps,
        gp.sat_chat as sat_chats_ps,
        gp.respuestas_chat as resp_chats_ps,
        gp.sat_ssf as sat_ssf,
        gp.respuestas_ssf as resp_ssf,
        gp.qty_intenciones_deflectadas as qty_deflection,
        gp.qty_casos as cant_casos_ps,
        gp.qty_chats as cant_chats_ps,
        FROM `peya-delivery-and-support.user_gabriel_paolillo.PSAT_WBR` gp

        INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = gp.country
           AND cd.active
		   AND cd.country_id != 6
        WHERE DATE(gp.fecha) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)

),
content_casos AS (
	SELECT
		ca.closed_date,
		ca.create_date,
		ca.case_id,
		ca.case_number,
		ca.record_type_name,
		ca.case_type,
		ca.closed_reason,
		ca.country_id,
		sa.key_vip_account,
		r.Name AS role_name,
		sa.BillingAddress.country AS billing_country
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca
	
	LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` u 
		   ON u.Id = ca.user_id
	
	LEFT JOIN `peya-data-origins-pro.cl_salesforce.user_role` r 
	       ON r.Id = u.UserRoleId
	
	INNER JOIN `peya-data-origins-pro.cl_salesforce.account` sa 
			ON sa.Id = ca.account_id
	
	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ca.closed_reason != 'Invalid'
	  AND ca.country_id != 6
), 
content_incoming AS (
	SELECT
		DATE(create_date) AS fecha,
		ca.country_id,
		COUNT(CASE WHEN ca.record_type_name IN ('PY Entry Case','PY Internal Case') AND ca.case_type IN ('Restaurant - Data','Take Offline','Setup Backend') THEN ca.case_id  END) AS actualizaciones_cases,
		COUNT(CASE WHEN ca.case_type = 'Menu Processing' THEN ca.case_id END) AS altas_cases
	FROM content_casos AS ca
	WHERE role_name = 'PY Editorial'
	GROUP BY 1,2
), 
content_sla AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN key_vip_account AND case_type IN ('Restaurant - Data','Setup Backend') THEN 1 ELSE 0 END) AS casos_actualizaciones_ka,
		SUM(CASE WHEN key_vip_account AND case_type IN ('Restaurant - Data','Setup Backend') AND DATE_DIFF(closed_date,create_date,SECOND)/3600 << 6 THEN 1 ELSE 0 END) AS sla_actualizaciones_ka,
		SUM(CASE WHEN NOT key_vip_account AND case_type IN ('Restaurant - Data','Setup Backend') THEN 1 ELSE 0 END) AS casos_actualizaciones_nka,
		SUM(CASE WHEN NOT key_vip_account  AND case_type IN ('Restaurant - Data', 'Setup Backend') AND DATE_DIFF(closed_date,create_date,SECOND)/3600 << 12 THEN 1 ELSE 0 END) AS sla_actualizaciones_nka,
		SUM(CASE WHEN case_type = 'Menu Processing' THEN 1 ELSE 0 END) AS casos_altas,
		SUM(CASE WHEN case_type = 'Menu Processing' AND DATE_DIFF(closed_date,create_date,SECOND)/3600 << 24 THEN 1 ELSE 0 END) AS sla_altas
	FROM content_casos
	WHERE closed_date IS NOT NULL
	  AND closed_reason NOT IN ('Invalid','Spam','Duplicated')
	  AND billing_country IS NOT NULL
	GROUP BY 1,2
), 
padre AS (
	SELECT
		resolved_date,
		country_id,
		country_name,
		caso_padre,
		area_padre,
		subject_padre,
		ccr1_padre,
		creacion,
		restaurant_id,
		created_by_id,
		tipo
	FROM (
		SELECT
			s.CreatedDate AS resolved_date,
			s.NewValue AS new_value,
			CASE 
				WHEN c.chat_transcript_name IS NOT NULL THEN 'Chat'
				WHEN c.chat_transcript_name IS NULL AND cs.case_origin = 'Phone' THEN 'Phone'
				ELSE 'Case'
			END AS tipo,
			CASE WHEN c.chat_transcript_name IS NULL THEN cs.country_id ELSE c.country_id END AS country_id,
			CASE WHEN c.chat_transcript_name IS NULL THEN cs.country_name ELSE c.country_name END AS country_name,
			cs.case_number AS caso_padre,
			CASE 
				WHEN c.partner_id IS NULL AND p.restaurant_id IS NOT NULL THEN p.restaurant_id
				WHEN p.restaurant_id IS NULL AND c.partner_id IS NULL THEN o.restaurant_id
				WHEN p.restaurant_id = o.restaurant_id THEN o.restaurant_id
				ELSE c.partner_id 
			END AS restaurant_id,
			CASE 
				WHEN c.origin = 'Whatsapp' THEN 'WAB' 
				WHEN c.origin IS NULL AND cs.case_origin = 'Chat' THEN 'Portal' 
				ELSE cs.case_origin 
			END AS origin_n,
			s.CreatedById AS created_by_id,
			cs.parent_id,
			cs.case_reason_level_1 AS ccr1_padre,
			cs.create_date AS creacion,
			cs.case_subjec AS subject_padre,
			c.chat_transcript_name,
			CASE
				WHEN cs.case_type = 'Partner' THEN 'PS' 
				WHEN cs.case_type = 'Refund' THEN 'Refund'
				WHEN cs.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
				WHEN cs.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido' 
			END AS area_padre,
			SUM(CASE WHEN s.NewValue = 'Resolved' THEN 1 ELSE 0 END) OVER (PARTITION BY s.CaseId) AS qty_resolved 
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` s
		
		INNER JOIN (
			SELECT 
				case_id, 
				case_number, 
				grid, 
				case_origin, 
				parent_id, 
				case_type, 
				case_order_id, 
				country_id, 
				create_date, 
				case_reason_level_1, 
				case_subjec, 
				closed_date, 
				country_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH) 
			  AND country_id != 6
			  AND case_type IN ('Partner','Restaurant - Data','Refund','Restaurant - Transmission','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Partner System Integration','Owner/Legal Form Change')
		) cs ON cs.case_id = s.CaseId	
		
		LEFT JOIN (
			SELECT 
				case_id,
				SAFE_CAST(partner_id AS INT64) AS partner_id, 
				origin, 
				chat_transcript_name, 
				country_id, 
				country_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			
			WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND livechat_button.button_id IN ('5731r000000H1Z1AAK','5731r000000H1Z3AAK','5731r000000btd7AAA','5731r0000008gICAAY','5731r000000btd6AAA','5731r0000008gIBAAY','5731r0000008gIDAAY')
			  AND country_id != 6
		) c ON c.case_id = cs.case_id
		
		LEFT JOIN (
			SELECT 
				order_id, 
				restaurant.id AS restaurant_id, 
				country.country_id AS country_id
			FROM `peya-bi-tools-pro.il_core.fact_orders`
			WHERE DATE(registered_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND country.country_id != 6
		) o ON o.order_id = SAFE_CAST(cs.case_order_id AS INT64)
		
		LEFT JOIN (
			SELECT 
				salesforce_id, 
				partner_id AS restaurant_id, 
				country_id
			FROM `peya-bi-tools-pro.il_core.dim_partner`
		) p ON p.salesforce_id = cs.grid
		
		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
		        ON cd.country_id = cs.country_id 
			   AND cd.active 
			   AND cd.country_id != 6
		
		WHERE DATE(s.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND s.NewValue IN ('Resolved','Closed')
		  AND (case_origin <<>> 'Chat' OR (case_origin = 'Chat' AND c.chat_transcript_name IS NOT NULL))
	)
	WHERE (new_value = 'Closed' and qty_resolved = 0) OR (new_value = 'Resolved' and qty_resolved >> 0)
),
hijo AS (
	SELECT
		create_date AS created_date,
		cs.country_id,
		cs.country_name,
		cs.case_reason_level_1 as ccr1_hijo,
		cs.case_number AS caso_hijo,
		CASE 
			WHEN c.partner_id IS NULL AND p.restaurant_id IS NOT NULL THEN p.restaurant_id
			WHEN p.restaurant_id IS NULL AND c.partner_id IS NULL THEN o.restaurant_id 
			WHEN p.restaurant_id = o.restaurant_id THEN o.restaurant_id
			ELSE c.partner_id 
		END AS restaurant_id,
		CASE WHEN c.origin = 'Whatsapp' THEN 'WAB' WHEN c.origin IS NULL AND cs.case_origin = 'Chat' THEN 'Portal' ELSE cs.case_origin END AS origin_n,
		cs.closed_date,
		cs.created_by_id,
		sc.case_number AS caso_boton_padre,
		cs.closed_reason AS resolucion_hijo,
		c.chat_transcript_name,
		CASE 
			WHEN cs.case_type = 'Partner' THEN 'PS' 
			WHEN cs.case_type = 'Refund' THEN 'Refund'
			WHEN cs.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
			WHEN cs.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido' 
		END AS area_hijo
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` cs
	
	LEFT JOIN (
		SELECT 
			case_id, 
			SAFE_CAST(partner_id AS INT64) AS partner_id, 
			origin, 
			chat_transcript_name
		FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
		WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND country_id != 6
	) c ON c.case_id = cs.case_id
	
	LEFT JOIN (
		SELECT 
			salesforce_id, 
			partner_id AS restaurant_id
		FROM `peya-bi-tools-pro.il_core.dim_partner`
	) p ON p.salesforce_id = cs.grid
	
	LEFT JOIN (
		SELECT 
			order_id, 
			restaurant.id AS restaurant_id
		FROM `peya-bi-tools-pro.il_core.fact_orders`
		WHERE DATE(registered_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND country.country_id != 6
	) o ON o.order_id = SAFE_CAST(cs.case_order_id AS INT64) 
	
	LEFT JOIN (
		SELECT 
			case_id, 
			case_number
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
		WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND country_id != 6
	) sc ON sc.case_id = cs.parent_id 
	
	INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
		    ON cd.country_id = cs.country_id 
		   AND cd.active 
		   AND cd.country_id != 6
	
	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH) 
	  AND case_type IN ('Partner','Restaurant - Data','Refund','Restaurant - Transmission','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Partner System Integration','Owner/Legal Form Change')
), 
padres_hijos AS (
	SELECT  
		CAST(creacion_padre AS date) AS fecha,
		padre_country_id,
		CASE 
			WHEN padre_country_name = 'Peru' THEN 'Perú'
			WHEN padre_country_name = 'Dominican Republic' THEN 'República Dominicana'
			ELSE padre_country_name
		END AS padre_country_name,
		COUNT(DISTINCT caso_padre) AS padres_con_hijos,
		COUNT(DISTINCT CASE WHEN padre_tipo = 'Case' THEN caso_padre END) AS padre_caso_con_hijos,
		COUNT(DISTINCT CASE WHEN padre_tipo = 'Chat' THEN caso_padre END) AS padre_chat_con_hijos,
		COUNT(DISTINCT CASE WHEN padre_tipo = 'Phone' THEN caso_padre END) AS padre_phone_con_hijos
	FROM (
		SELECT
			padre.caso_padre,
			padre.area_padre,
			hijo.caso_hijo,
			hijo.area_hijo,
			hijo.origin_n AS origen_hijo,
			hijo.resolucion_hijo,
			padre.subject_padre,
			padre.ccr1_padre,
			padre.creacion as creacion_padre,
			hijo.chat_transcript_name,
			padre.country_id AS padre_country_id,
			padre.country_name AS padre_country_name,
			padre.tipo AS padre_tipo
		FROM padre 

		LEFT JOIN hijo AS hijo
			   ON hijo.restaurant_id = padre.restaurant_id
			  AND hijo.created_by_id = padre.created_by_id
			  AND (DATE_DIFF(DATETIME(TIMESTAMP_ADD(padre.resolved_date , INTERVAL -3 HOUR)),hijo.created_date,SECOND)/60) BETWEEN -5 AND 5
              
		
		WHERE caso_padre != caso_hijo 
		  AND hijo.chat_transcript_name IS NULL
		
		UNION ALL
		SELECT 
			sc2.case_number as caso_padre,
			CASE 
				WHEN sc2.case_type = 'Partner' THEN 'PS' 
				WHEN sc2.case_type = 'Refund' THEN 'Refund'
				WHEN sc2.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
				WHEN sc2.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido' 
			END AS area_padre,
			sc1.case_number AS caso_hijo,
			CASE 
				WHEN sc1.case_type = 'Partner' THEN 'PS' 
				WHEN sc1.case_type = 'Refund' THEN 'Refund'
				WHEN sc1.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
				WHEN sc1.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido'
			END AS area_hijo,
			sc1.case_origin AS origen_hijo,
			sc1.closed_reason AS resolucion_hijo,
			sc2.case_subjec AS subject_padre,
			sc2.case_reason_level_1 AS ccr1_padre,
			sc2.create_date AS creacion_padre,
			slt.chat_transcript_name,
			CASE WHEN slt2.chat_transcript_name IS NULL THEN sc2.country_id ELSE slt2.country_id END AS padre_country_id,
			CASE WHEN slt2.chat_transcript_name IS NULL THEN sc2.country_name ELSE slt2.country_name END AS padre_country_name,
			CASE
				WHEN slt2.chat_transcript_name IS NOT NULL THEN 'Chat'
				WHEN slt2.chat_transcript_name IS NULL AND sc2.case_origin = 'Phone' THEN 'Phone'
				ELSE 'Case'
			END AS padre_tipo
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` sc1

		INNER JOIN (
			SELECT 
				case_id,
				case_number,
				case_type,
				case_subjec,
				case_reason_level_1,
				create_date,
				country_id,
				country_name,
				case_origin
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` sc2 
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) sc2 ON sc2.case_id = sc1.parent_id


		LEFT JOIN (
			SELECT
				case_id,
				chat_transcript_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) slt ON slt.case_id = sc1.case_id
		
		LEFT JOIN (
			SELECT 
				case_id,
				chat_transcript_name, 
				country_id, 
				country_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND country_id != 6
			  AND livechat_button.button_id IN ('5731r000000H1Z1AAK','5731r000000H1Z3AAK','5731r000000btd7AAA','5731r0000008gICAAY','5731r000000btd6AAA','5731r0000008gIBAAY','5731r0000008gIDAAY')
		) slt2 ON slt2.case_id = sc2.case_id
		
		WHERE DATE(sc1.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND sc1.parent_id IS NOT NULL
		  AND sc2.case_type = 'Partner'
		  AND slt.chat_transcript_name IS NULL
		  AND sc2.country_id != 6
		  AND (sc2.case_origin <<>> 'Chat' OR (sc2.case_origin = 'Chat' AND slt2.chat_transcript_name IS NOT NULL))
	) final
	GROUP BY 1,2,3
),

psat_esp as (

    select
        s.fecha,
        cd.country_id,
        s.country as country_name,
        sum(case when level like '%Billing%' then promotores_chat else 0 end) as sat_chats_Billing,
        sum(case when level like '%Billing%' then respuestas_chat else 0 end) as resp_chats_Billing,
        sum(case when level like 'Partner Service' then promotores_chat else 0 end) as sat_chats_PSLive,
        sum(case when level like 'Partner Service' then respuestas_chat else 0 end) as resp_chats_PSLive,
        sum(case when level like '%Content%' then promotores_chat else 0 end) as sat_chats_ContLive,
        sum(case when level like '%Content%' then respuestas_chat else 0 end) as resp_chats_ContLive,
        sum(case when level like '%Shopper%' then promotores_chat else 0 end) as sat_chats_SS,
        sum(case when level like '%Shopper%' then respuestas_chat else 0 end) as resp_chats_SS,
        sum(case when level like '%Tech%' then promotores_chat else 0 end) as sat_chats_Tech,
        sum(case when level like '%Tech%' then respuestas_chat else 0 end) as resp_chats_Tech,
        sum(case when level like '%Courier%' then promotores_chat else 0 end) as sat_chats_Courier,
        sum(case when level like '%Courier%' then respuestas_chat else 0 end) as resp_chats_Courier,
        sum(case when level like '%Kitchen%' then promotores_chat else 0 end) as sat_chats_Kitch,
        sum(case when level like '%Kitchen%' then respuestas_chat else 0 end) as resp_chats_Kitch,

        

    from `peya-delivery-and-support.user_gabriel_paolillo.PSAT_ALAN` s

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN s.country = 'Panama' THEN 'Panamá'
											  WHEN s.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN s.country = 'Peru' THEN 'Perú'
											  WHEN s.country = 'Salvador' THEN 'El Salvador'
											  ELSE s.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6

    WHERE DATE(s.fecha) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    group by 1,2,3
    order by 1 desc
  
),

calls as 
(
	SELECT DISTINCT 
    DATE(i.start_date) AS fecha, 
	 
	CASE WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0054%%') THEN '3' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('54%%') THEN '3' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00591%%') THEN '17' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('591%%') THEN '17' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00595%%') THEN '15' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('595%%') THEN '15' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0018%%') THEN '18' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('18%%') THEN '18' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0058%%') THEN '8' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('58%%') THEN '8' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0056%%') THEN '2' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('56%%') THEN '2' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00507%%') THEN '11' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('507%%') THEN '11' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0051%%') THEN '7' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('51%%') THEN '7' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00503%%') THEN '19' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('503%%') THEN '19' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00593%%') THEN '13' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('593%%') THEN '13' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00506%%') THEN '16' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('506%%') THEN '16' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00502%%') THEN '21' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('502%%') THEN '21' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00504%%') THEN '22' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('504%%') THEN '22' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00505%%') THEN '20' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('505%%') THEN '20' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00598%%') THEN '1' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('598%%') THEN '1' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('09%%') THEN '1' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('2%%') THEN '1' 
			ELSE null END AS country_id, 
		       	
			sum (case when i.survey_question_2 in ('4', '5') then 1 else 0 end) as sat_calls,
      sum (case when i.survey_question_2 in ('4', '5', '3', '2', '1') then 1 else 0 end) as resp_calls,

FROM `peya-data-origins-pro.cl_inconcert.call_report` AS i
            
WHERE i.campaign LIKE 'ps_in'
AND DATE(i.start_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)


group by 1,2

order by 1 desc
),

especializ as (

        SELECT 
        Fecha,
        Pais,
        cd.country_id as country_id,
       
        sum(case when tipo = 'Chat' then chats else null end) as chats_total,
        sum(case when equipo = 'Live' then chats else null end) as chats_live,
        sum(case when equipo = 'Billing' then chats else null end) as chats_billing,
        sum(case when equipo = 'Courier' then chats else null end) as chats_courier,
        sum(case when equipo = 'Shopper' then chats else null end) as chats_shopper,
        sum(case when equipo = 'Technical' then chats else null end) as chats_tech,
        sum(case when equipo = 'Content' then chats else null end) as chats_content,
        sum(case when equipo = 'Partner Service - Kitchen' then 1 else null end) as chats_kitchen,
       
        sum(case when tipo = 'Caso' then casos else null end) as cases_total,
        sum(case when tipo = 'Caso' then casos_offline else null end) as cases_off_total,
        sum(case when tipo = 'Caso' and equipo = 'Billing' then casos else null end) as cases_billing,
        sum(case when tipo = 'Caso' and equipo = 'Content' then casos else null end) as cases_content,
        sum(case when tipo = 'Caso' and equipo = 'Technical' then casos else null end) as cases_tech,
        sum(case when tipo = 'Caso' and equipo = 'Live' then casos else null end) as cases_live,
        sum(case when tipo = 'Caso' and equipo = 'Content' then casos_offline else null end) as cases_content_offline,
        sum(case when tipo = 'Caso' and equipo IN ('Technical', 'Billing') then casos_offline else null end) as cases_refund,
        sum(case when tipo = 'SSF' then llamadas else null end) as llamadas,

        sum(case when tipo = 'Llamada' then Deflectados else null end) as cases_SSF,

        sum(case when tipo = 'Caso' and Categoria = 'PicsApp' then casos_offline else null end) as cases_pics_app,
        sum(case when tipo = 'Caso' and Categoria = 'Fotos de logos' then casos_offline else null end) as cases_pics_logos,
        sum(case when tipo = 'Caso' and Categoria = 'Fotos profesionales' then casos_offline else null end) as cases_pics_profes,
        sum(case when tipo = 'Caso' and Categoria = 'Fotos de productos' then casos_offline else null end) as cases_pics_productos,
        
    FROM `peya-delivery-and-support.automated_tables_reports.core_metrics_ps_clean` cm
    
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN cm.Pais = 'Panama' THEN 'Panamá'
											  WHEN cm.Pais = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN cm.Pais = 'Peru' THEN 'Perú'
											  WHEN cm.Pais = 'Salvador' THEN 'El Salvador'
											  ELSE cm.Pais
										  END)
				   AND cd.active
				   AND cd.country_id != 6

    WHERE DATE(Fecha) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    group by 1,2,3
    order by 1 desc,2

)


SELECT
	COALESCE(p.fecha, h.fecha) AS fecha,
	COALESCE(p.country_id, h.country_id) AS country_id,

	p.sla_chats_ps,
	p.total_chats_para_sla,

	p.aht_acw_ps,
	p.cwt_numerador_completed,
	p.abandonados_antes_10segs,
	p.total_chats,

	ca.sla_casos_ps,

	s.sat_chats_ps,
	s.resp_chats_ps,
	s.sat_casos_ps,
	s.resp_casos_ps,
  s.sat_ssf,
	s.resp_ssf,
  s.qty_deflection,
  s.cant_casos_ps,
  s.cant_chats_ps,

	resueltos.casos_resueltos_ps,
	resueltos.casos_reabiertos_ps,
	
	h.tiempo_conexion_ps,
	h.tiempo_noprod_ps,
	h.tiempo_prod_chats_ps,
	h.tiempo_prod_casos_ps,

	/*
    a.casos_auto_ka,
	a.sla_auto_ka,
	a.casos_auto_nka,
	a.sla_auto_nka,
	a.casos_refund_ka,
	a.sla_refund_ka,
	a.casos_refund_nka,
	a.sla_refund_nka,
    */

	content.actualizaciones_cases,
	content.casos_actualizaciones_ka,
	content.sla_actualizaciones_ka,
	content.casos_actualizaciones_nka,
	content.sla_actualizaciones_nka,
	content.altas_cases,
	content.casos_altas,
	content.sla_altas,

	padres_hijos.padres_con_hijos,
	padres_hijos.padre_caso_con_hijos,
	padres_hijos.padre_chat_con_hijos,
	padres_hijos.padre_phone_con_hijos,

    espz.cases_total,
    espz.cases_off_total,    
    espz.chats_live,
    espz.chats_total,
    espz.chats_billing,
    espz.chats_content,
    espz.chats_shopper,
    espz.chats_courier,
    espz.chats_kitchen,
    espz.chats_tech,
    espz.cases_billing,
    espz.cases_content,
    espz.cases_tech,
    espz.cases_live,
    espz.cases_content_offline,
    espz.cases_refund,
    espz.llamadas,
    espz.cases_pics_app,
    espz.cases_pics_logos,
    espz.cases_pics_productos,
    espz.cases_pics_profes,

    psat_esp.sat_chats_Billing,
    psat_esp.sat_chats_PSLive,
    psat_esp.sat_chats_ContLive,
    psat_esp.sat_chats_SS,
    psat_esp.sat_chats_Tech,
    psat_esp.sat_chats_Courier,
    psat_esp.sat_chats_Kitch,
    psat_esp.resp_chats_Billing,
    psat_esp.resp_chats_PSLive,
    psat_esp.resp_chats_ContLive,
    psat_esp.resp_chats_SS,
    psat_esp.resp_chats_Tech,
    psat_esp.resp_chats_Courier,
    psat_esp.resp_chats_Kitch,

	  calls.sat_calls as sat_calls,
	  calls.resp_calls as resp_calls,
    


FROM (
	SELECT
	*
	from chats 


) p

/*
LEFT JOIN auto_refund a 
	   ON a.fecha = p.fecha 
	  AND a.country_id = p.country_id
*/

left join casos ca
	 ON ca.fecha = p.fecha 
				AND ca.country_id = p.country_id

LEFT JOIN psat_new s 
	   ON s.fecha = p.fecha 
	  AND s.country_id = p.country_id



FULL OUTER JOIN shnk_ps h 
		     ON h.fecha = p.fecha 
			AND h.country_id = p.country_id

LEFT JOIN (
	SELECT
		DATE(created_date) AS fecha,
		country_id,
		SUM(CASE WHEN field = 'Status' AND new_value = 'Resolved' THEN 1 ELSE 0 END) AS casos_resueltos_ps,
		SUM(CASE WHEN field = 'Status' AND new_value = 'Reopen' THEN 1 ELSE 0 END) AS casos_reabiertos_ps
	FROM casos_changes
	WHERE case_origin != 'Phone'
	GROUP BY 1,2
) resueltos ON resueltos.fecha = p.fecha 
		   AND resueltos.country_id = p.country_id

LEFT JOIN (
	SELECT
		COALESCE(i.fecha, s.fecha) AS fecha,
		COALESCE(i.country_id, s.country_id) AS country_id,
		/* ACTUALIZACIONES */
		actualizaciones_cases,
		casos_actualizaciones_ka,
		sla_actualizaciones_ka,
		casos_actualizaciones_nka,
		sla_actualizaciones_nka,
		/* ALTAS */
		altas_cases,
		casos_altas,
		sla_altas,
	FROM content_incoming i

	FULL OUTER JOIN content_sla s 
	             ON s.fecha = i.fecha
				AND s.country_id = i.country_id

) content ON content.fecha = p.fecha 
         AND content.country_id = p.country_id

LEFT JOIN padres_hijos 
	   ON padres_hijos.fecha = p.fecha 
	  AND padres_hijos.padre_country_id = p.country_id

LEFT JOIN especializ espz 
	   ON espz.fecha = p.fecha 
	  AND espz.country_id = p.country_id

LEFT JOIN psat_esp  
	   ON psat_esp.fecha = p.fecha 
	  AND psat_esp.country_id = p.country_id

LEFT JOIN calls  
	   ON calls.fecha = p.fecha 
	  AND cast (calls.country_id as int64) = p.country_id


ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1emg0cz1a4ziwj14w124b08myy0r' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*--WBR PS--*/

WITH chats AS (
	SELECT
    date(ch.createddate, 'America/Montevideo') AS fecha,
    
		cd.country_id,
		SUM(CASE WHEN ch.status = 'Completed' AND ch.WaitTime <<= 30 AND ch.OwnerId NOT IN ('005w0000003pERkAAM') THEN 1 ELSE 0 END) AS sla_chats_ps,
		count (distinct case when ch.OwnerId NOT IN ('005w0000003pERkAAM') then ch.Id end) as total_chats_para_sla,
 

		sum(CASE WHEN status = 'Completed' AND ch.WaitTime <<= 90 THEN 1  ELSE 0 END) AS cwt_numerador_completed,
		sum(CASE WHEN status = 'Missed' AND ch.Abandoned << 10 THEN 1 ELSE 0 END) AS abandonados_antes_10segs,

		count (distinct ch.id) AS total_chats,

    sum(ch.ChatDuration +(case when ch.chat_cleanup_time_seconds >> 0 then chat_cleanup_time_seconds else 0 end ))AS aht_acw_ps,
	FROM `peya-data-origins-pro.cl_salesforce.livechat_transcript` ch

  INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN ch.Country = 'Panama' THEN 'Panamá'
											  WHEN ch.Country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN ch.Country = 'Peru' THEN 'Perú'
											  WHEN ch.Country = 'Salvador' THEN 'El Salvador'
											  ELSE ch.Country
										  END)
				   AND cd.active
				   AND cd.country_id != 6

	
    WHERE date(ch.createddate, 'America/Montevideo') >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ch.LiveChatButtonId IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK')
	  AND ch.Country not in('Colombia')
    AND ch.Country not in('Germany')
	GROUP BY 1,2
), 
casos AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 24 THEN 1 ELSE 0 END) AS sla_casos_ps
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND record_type_name = 'PY Inbound Case' 
	  AND case_origin NOT IN ('Chat','Phone')
	  AND (case_subjec NOT LIKE '%%NDC |%%' OR case_subjec NOT LIKE '%%No country%%' OR case_subjec NOT LIKE '%%restaurant portal%%') 
	  AND (case_type IN ('Restaurant - Data', 'Restaurant Request', 'Partner','Handover', ' ') OR case_type IS NULL)
	  AND country_id != 6
	GROUP BY 1,2
), 
casos_changes AS (
	SELECT
		DATE(ch.created_date) AS created_date,
		ca.user_id,
		ca.case_origin,
		ca.country_id,
		ch.new_value,
		ch.field		
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca

	LEFT JOIN (
		SELECT 
			cc.CaseId AS case_id,
			cc.NewValue AS new_value,
			cc.Field AS field,
			TIMESTAMP(DATETIME(cc.CreatedDate, cd.timezone)) AS created_date
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` cc
	
		LEFT JOIN (
			SELECT 
				case_id,
				country_id 
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) ca ON ca.case_id = cc.CaseId

		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
				ON cd.country_id = ca.country_id
			   AND cd.active
			   AND cd.country_id != 6	

		WHERE DATE(cc.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	) ch ON ch.case_id = ca.case_id

	WHERE DATE(ca.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ca.case_button_name = 'PY_Inbound_Case'
	  AND ca.case_origin <<>> 'Chat'
	  AND (ca.case_type IN ('Restaurant - Data','Restaurant Request','Partner','Handover',' ') OR ca.case_type IS NULL)
	  AND ca.country_id != 6
), 
shnk_ps AS (
	SELECT
		DATE(datos_ps.fecha) AS fecha,
		NULL AS country_id,
		SUM(tiempo_conexion_ps) AS tiempo_conexion_ps,
		SUM(tiempo_prod_chats_ps) AS tiempo_prod_chats_ps,
		SUM(tiempo_prod_casos_ps) AS tiempo_prod_casos_ps,
		SUM(tiempo_noprod_ps) AS tiempo_noprod_ps
	FROM (
		SELECT
			fecha,
			user_id
		FROM (
			SELECT
				DATE(start_time) AS fecha,
				chat_transcript_user_id AS user_id
			FROM (
				SELECT
					DATE(ch.start_time) AS start_time,
					ch.chat_transcript_user_id
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts` ch

				WHERE DATE(ch.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_id IN ('5731r000000H1Z1AAK','5731r000000H1Z3AAK','5731r000000btd7AAA','5731r0000008gICAAY','5731r000000btd6AAA','5731r0000008gIBAAY','5731r0000008gIDAAY')
				  AND ch.country_id != 6
			)
			GROUP BY 1,2
		) chats
		
		UNION DISTINCT
			SELECT
				DATE(created_date) AS fecha,
				user_id
			FROM casos_changes
			GROUP BY 1,2
	) datos_ps
	
	LEFT JOIN (
		SELECT 
			DATE(presence_status_start_date) as fecha,
			presence_user_id as user_id,
			SUM(CASE WHEN status_name in ('Busy','Lunch_Dinner','Short_Break_personal','Training_QA_Meeting') THEN presence_status_duration ELSE 0 END) AS tiempo_noprod_ps,
			SUM(presence_status_duration) as tiempo_conexion_ps,
			SUM(CASE WHEN status_name in ('Chats_Only') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_chats_ps,
			SUM(CASE WHEN status_name in ('Cases_Only','Assigned_Task_Non_Omni','Cases_Calls') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_casos_ps
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_user_presence`
		
		WHERE DATE(presence_created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		GROUP BY 1, 2
	) shnk_ps ON shnk_ps.fecha = datos_ps.fecha
		     AND shnk_ps.user_id = datos_ps.user_id
	GROUP BY 1
), 



psat_new as (

    SELECT 
        gp.fecha,
        cd.country_id as country_id,
        gp.sat_cases as sat_casos_ps,
        gp.respuestas_cases as resp_casos_ps,
        gp.sat_chat as sat_chats_ps,
        gp.respuestas_chat as resp_chats_ps,
        gp.sat_ssf as sat_ssf,
        gp.respuestas_ssf as resp_ssf,
        gp.qty_intenciones_deflectadas as qty_deflection,
        gp.qty_casos as cant_casos_ps,
        gp.qty_chats as cant_chats_ps,
        FROM `peya-delivery-and-support.user_gabriel_paolillo.PSAT_WBR` gp

        INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = gp.country
           AND cd.active
		   AND cd.country_id != 6
        WHERE DATE(gp.fecha) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)

),
content_casos AS (
	SELECT
		ca.closed_date,
		ca.create_date,
		ca.case_id,
		ca.case_number,
		ca.record_type_name,
		ca.case_type,
		ca.closed_reason,
		ca.country_id,
		sa.key_vip_account,
		r.Name AS role_name,
		sa.BillingAddress.country AS billing_country
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca
	
	LEFT JOIN `peya-data-origins-pro.cl_salesforce.user` u 
		   ON u.Id = ca.user_id
	
	LEFT JOIN `peya-data-origins-pro.cl_salesforce.user_role` r 
	       ON r.Id = u.UserRoleId
	
	INNER JOIN `peya-data-origins-pro.cl_salesforce.account` sa 
			ON sa.Id = ca.account_id
	
	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ca.closed_reason != 'Invalid'
	  AND ca.country_id != 6
), 
content_incoming AS (
	SELECT
		DATE(create_date) AS fecha,
		ca.country_id,
		COUNT(CASE WHEN ca.record_type_name IN ('PY Entry Case','PY Internal Case') AND ca.case_type IN ('Restaurant - Data','Take Offline','Setup Backend') THEN ca.case_id  END) AS actualizaciones_cases,
		COUNT(CASE WHEN ca.case_type = 'Menu Processing' THEN ca.case_id END) AS altas_cases
	FROM content_casos AS ca
	WHERE role_name = 'PY Editorial'
	GROUP BY 1,2
), 
content_sla AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN key_vip_account AND case_type IN ('Restaurant - Data','Setup Backend') THEN 1 ELSE 0 END) AS casos_actualizaciones_ka,
		SUM(CASE WHEN key_vip_account AND case_type IN ('Restaurant - Data','Setup Backend') AND DATE_DIFF(closed_date,create_date,SECOND)/3600 << 6 THEN 1 ELSE 0 END) AS sla_actualizaciones_ka,
		SUM(CASE WHEN NOT key_vip_account AND case_type IN ('Restaurant - Data','Setup Backend') THEN 1 ELSE 0 END) AS casos_actualizaciones_nka,
		SUM(CASE WHEN NOT key_vip_account  AND case_type IN ('Restaurant - Data', 'Setup Backend') AND DATE_DIFF(closed_date,create_date,SECOND)/3600 << 12 THEN 1 ELSE 0 END) AS sla_actualizaciones_nka,
		SUM(CASE WHEN case_type = 'Menu Processing' THEN 1 ELSE 0 END) AS casos_altas,
		SUM(CASE WHEN case_type = 'Menu Processing' AND DATE_DIFF(closed_date,create_date,SECOND)/3600 << 24 THEN 1 ELSE 0 END) AS sla_altas
	FROM content_casos
	WHERE closed_date IS NOT NULL
	  AND closed_reason NOT IN ('Invalid','Spam','Duplicated')
	  AND billing_country IS NOT NULL
	GROUP BY 1,2
), 
padre AS (
	SELECT
		resolved_date,
		country_id,
		country_name,
		caso_padre,
		area_padre,
		subject_padre,
		ccr1_padre,
		creacion,
		restaurant_id,
		created_by_id,
		tipo
	FROM (
		SELECT
			s.CreatedDate AS resolved_date,
			s.NewValue AS new_value,
			CASE 
				WHEN c.chat_transcript_name IS NOT NULL THEN 'Chat'
				WHEN c.chat_transcript_name IS NULL AND cs.case_origin = 'Phone' THEN 'Phone'
				ELSE 'Case'
			END AS tipo,
			CASE WHEN c.chat_transcript_name IS NULL THEN cs.country_id ELSE c.country_id END AS country_id,
			CASE WHEN c.chat_transcript_name IS NULL THEN cs.country_name ELSE c.country_name END AS country_name,
			cs.case_number AS caso_padre,
			CASE 
				WHEN c.partner_id IS NULL AND p.restaurant_id IS NOT NULL THEN p.restaurant_id
				WHEN p.restaurant_id IS NULL AND c.partner_id IS NULL THEN o.restaurant_id
				WHEN p.restaurant_id = o.restaurant_id THEN o.restaurant_id
				ELSE c.partner_id 
			END AS restaurant_id,
			CASE 
				WHEN c.origin = 'Whatsapp' THEN 'WAB' 
				WHEN c.origin IS NULL AND cs.case_origin = 'Chat' THEN 'Portal' 
				ELSE cs.case_origin 
			END AS origin_n,
			s.CreatedById AS created_by_id,
			cs.parent_id,
			cs.case_reason_level_1 AS ccr1_padre,
			cs.create_date AS creacion,
			cs.case_subjec AS subject_padre,
			c.chat_transcript_name,
			CASE
				WHEN cs.case_type = 'Partner' THEN 'PS' 
				WHEN cs.case_type = 'Refund' THEN 'Refund'
				WHEN cs.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
				WHEN cs.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido' 
			END AS area_padre,
			SUM(CASE WHEN s.NewValue = 'Resolved' THEN 1 ELSE 0 END) OVER (PARTITION BY s.CaseId) AS qty_resolved 
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` s
		
		INNER JOIN (
			SELECT 
				case_id, 
				case_number, 
				grid, 
				case_origin, 
				parent_id, 
				case_type, 
				case_order_id, 
				country_id, 
				create_date, 
				case_reason_level_1, 
				case_subjec, 
				closed_date, 
				country_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH) 
			  AND country_id != 6
			  AND case_type IN ('Partner','Restaurant - Data','Refund','Restaurant - Transmission','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Partner System Integration','Owner/Legal Form Change')
		) cs ON cs.case_id = s.CaseId	
		
		LEFT JOIN (
			SELECT 
				case_id,
				SAFE_CAST(partner_id AS INT64) AS partner_id, 
				origin, 
				chat_transcript_name, 
				country_id, 
				country_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			
			WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND livechat_button.button_id IN ('5731r000000H1Z1AAK','5731r000000H1Z3AAK','5731r000000btd7AAA','5731r0000008gICAAY','5731r000000btd6AAA','5731r0000008gIBAAY','5731r0000008gIDAAY')
			  AND country_id != 6
		) c ON c.case_id = cs.case_id
		
		LEFT JOIN (
			SELECT 
				order_id, 
				restaurant.id AS restaurant_id, 
				country.country_id AS country_id
			FROM `peya-bi-tools-pro.il_core.fact_orders`
			WHERE DATE(registered_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND country.country_id != 6
		) o ON o.order_id = SAFE_CAST(cs.case_order_id AS INT64)
		
		LEFT JOIN (
			SELECT 
				salesforce_id, 
				partner_id AS restaurant_id, 
				country_id
			FROM `peya-bi-tools-pro.il_core.dim_partner`
		) p ON p.salesforce_id = cs.grid
		
		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
		        ON cd.country_id = cs.country_id 
			   AND cd.active 
			   AND cd.country_id != 6
		
		WHERE DATE(s.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND s.NewValue IN ('Resolved','Closed')
		  AND (case_origin <<>> 'Chat' OR (case_origin = 'Chat' AND c.chat_transcript_name IS NOT NULL))
	)
	WHERE (new_value = 'Closed' and qty_resolved = 0) OR (new_value = 'Resolved' and qty_resolved >> 0)
),
hijo AS (
	SELECT
		create_date AS created_date,
		cs.country_id,
		cs.country_name,
		cs.case_reason_level_1 as ccr1_hijo,
		cs.case_number AS caso_hijo,
		CASE 
			WHEN c.partner_id IS NULL AND p.restaurant_id IS NOT NULL THEN p.restaurant_id
			WHEN p.restaurant_id IS NULL AND c.partner_id IS NULL THEN o.restaurant_id 
			WHEN p.restaurant_id = o.restaurant_id THEN o.restaurant_id
			ELSE c.partner_id 
		END AS restaurant_id,
		CASE WHEN c.origin = 'Whatsapp' THEN 'WAB' WHEN c.origin IS NULL AND cs.case_origin = 'Chat' THEN 'Portal' ELSE cs.case_origin END AS origin_n,
		cs.closed_date,
		cs.created_by_id,
		sc.case_number AS caso_boton_padre,
		cs.closed_reason AS resolucion_hijo,
		c.chat_transcript_name,
		CASE 
			WHEN cs.case_type = 'Partner' THEN 'PS' 
			WHEN cs.case_type = 'Refund' THEN 'Refund'
			WHEN cs.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
			WHEN cs.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido' 
		END AS area_hijo
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` cs
	
	LEFT JOIN (
		SELECT 
			case_id, 
			SAFE_CAST(partner_id AS INT64) AS partner_id, 
			origin, 
			chat_transcript_name
		FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
		WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND country_id != 6
	) c ON c.case_id = cs.case_id
	
	LEFT JOIN (
		SELECT 
			salesforce_id, 
			partner_id AS restaurant_id
		FROM `peya-bi-tools-pro.il_core.dim_partner`
	) p ON p.salesforce_id = cs.grid
	
	LEFT JOIN (
		SELECT 
			order_id, 
			restaurant.id AS restaurant_id
		FROM `peya-bi-tools-pro.il_core.fact_orders`
		WHERE DATE(registered_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND country.country_id != 6
	) o ON o.order_id = SAFE_CAST(cs.case_order_id AS INT64) 
	
	LEFT JOIN (
		SELECT 
			case_id, 
			case_number
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
		WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND country_id != 6
	) sc ON sc.case_id = cs.parent_id 
	
	INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd 
		    ON cd.country_id = cs.country_id 
		   AND cd.active 
		   AND cd.country_id != 6
	
	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH) 
	  AND case_type IN ('Partner','Restaurant - Data','Refund','Restaurant - Transmission','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Partner System Integration','Owner/Legal Form Change')
), 
padres_hijos AS (
	SELECT  
		CAST(creacion_padre AS date) AS fecha,
		padre_country_id,
		CASE 
			WHEN padre_country_name = 'Peru' THEN 'Perú'
			WHEN padre_country_name = 'Dominican Republic' THEN 'República Dominicana'
			ELSE padre_country_name
		END AS padre_country_name,
		COUNT(DISTINCT caso_padre) AS padres_con_hijos,
		COUNT(DISTINCT CASE WHEN padre_tipo = 'Case' THEN caso_padre END) AS padre_caso_con_hijos,
		COUNT(DISTINCT CASE WHEN padre_tipo = 'Chat' THEN caso_padre END) AS padre_chat_con_hijos,
		COUNT(DISTINCT CASE WHEN padre_tipo = 'Phone' THEN caso_padre END) AS padre_phone_con_hijos
	FROM (
		SELECT
			padre.caso_padre,
			padre.area_padre,
			hijo.caso_hijo,
			hijo.area_hijo,
			hijo.origin_n AS origen_hijo,
			hijo.resolucion_hijo,
			padre.subject_padre,
			padre.ccr1_padre,
			padre.creacion as creacion_padre,
			hijo.chat_transcript_name,
			padre.country_id AS padre_country_id,
			padre.country_name AS padre_country_name,
			padre.tipo AS padre_tipo
		FROM padre 

		LEFT JOIN hijo AS hijo
			   ON hijo.restaurant_id = padre.restaurant_id
			  AND hijo.created_by_id = padre.created_by_id
			  AND (DATE_DIFF(DATETIME(TIMESTAMP_ADD(padre.resolved_date , INTERVAL -3 HOUR)),hijo.created_date,SECOND)/60) BETWEEN -5 AND 5
              
		
		WHERE caso_padre != caso_hijo 
		  AND hijo.chat_transcript_name IS NULL
		
		UNION ALL
		SELECT 
			sc2.case_number as caso_padre,
			CASE 
				WHEN sc2.case_type = 'Partner' THEN 'PS' 
				WHEN sc2.case_type = 'Refund' THEN 'Refund'
				WHEN sc2.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
				WHEN sc2.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido' 
			END AS area_padre,
			sc1.case_number AS caso_hijo,
			CASE 
				WHEN sc1.case_type = 'Partner' THEN 'PS' 
				WHEN sc1.case_type = 'Refund' THEN 'Refund'
				WHEN sc1.case_type IN ('Restaurant - Transmission','Partner System Integration') THEN 'Auto' 
				WHEN sc1.case_type IN ('Restaurant - Data','Menu Processing','Take Online','Take Offline','Dish Level Photo','Setup Backend','Owner/Legal Form Change') THEN 'Contenido'
			END AS area_hijo,
			sc1.case_origin AS origen_hijo,
			sc1.closed_reason AS resolucion_hijo,
			sc2.case_subjec AS subject_padre,
			sc2.case_reason_level_1 AS ccr1_padre,
			sc2.create_date AS creacion_padre,
			slt.chat_transcript_name,
			CASE WHEN slt2.chat_transcript_name IS NULL THEN sc2.country_id ELSE slt2.country_id END AS padre_country_id,
			CASE WHEN slt2.chat_transcript_name IS NULL THEN sc2.country_name ELSE slt2.country_name END AS padre_country_name,
			CASE
				WHEN slt2.chat_transcript_name IS NOT NULL THEN 'Chat'
				WHEN slt2.chat_transcript_name IS NULL AND sc2.case_origin = 'Phone' THEN 'Phone'
				ELSE 'Case'
			END AS padre_tipo
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` sc1

		INNER JOIN (
			SELECT 
				case_id,
				case_number,
				case_type,
				case_subjec,
				case_reason_level_1,
				create_date,
				country_id,
				country_name,
				case_origin
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` sc2 
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) sc2 ON sc2.case_id = sc1.parent_id


		LEFT JOIN (
			SELECT
				case_id,
				chat_transcript_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) slt ON slt.case_id = sc1.case_id
		
		LEFT JOIN (
			SELECT 
				case_id,
				chat_transcript_name, 
				country_id, 
				country_name
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND country_id != 6
			  AND livechat_button.button_id IN ('5731r000000H1Z1AAK','5731r000000H1Z3AAK','5731r000000btd7AAA','5731r0000008gICAAY','5731r000000btd6AAA','5731r0000008gIBAAY','5731r0000008gIDAAY')
		) slt2 ON slt2.case_id = sc2.case_id
		
		WHERE DATE(sc1.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND sc1.parent_id IS NOT NULL
		  AND sc2.case_type = 'Partner'
		  AND slt.chat_transcript_name IS NULL
		  AND sc2.country_id != 6
		  AND (sc2.case_origin <<>> 'Chat' OR (sc2.case_origin = 'Chat' AND slt2.chat_transcript_name IS NOT NULL))
	) final
	GROUP BY 1,2,3
),

psat_esp as (

    select
        s.fecha,
        cd.country_id,
        s.country as country_name,
        sum(case when level like '%Billing%' then promotores_chat else 0 end) as sat_chats_Billing,
        sum(case when level like '%Billing%' then respuestas_chat else 0 end) as resp_chats_Billing,
        sum(case when level like 'Partner Service' then promotores_chat else 0 end) as sat_chats_PSLive,
        sum(case when level like 'Partner Service' then respuestas_chat else 0 end) as resp_chats_PSLive,
        sum(case when level like '%Content%' then promotores_chat else 0 end) as sat_chats_ContLive,
        sum(case when level like '%Content%' then respuestas_chat else 0 end) as resp_chats_ContLive,
        sum(case when level like '%Shopper%' then promotores_chat else 0 end) as sat_chats_SS,
        sum(case when level like '%Shopper%' then respuestas_chat else 0 end) as resp_chats_SS,
        sum(case when level like '%Tech%' then promotores_chat else 0 end) as sat_chats_Tech,
        sum(case when level like '%Tech%' then respuestas_chat else 0 end) as resp_chats_Tech,
        sum(case when level like '%Courier%' then promotores_chat else 0 end) as sat_chats_Courier,
        sum(case when level like '%Courier%' then respuestas_chat else 0 end) as resp_chats_Courier,
        sum(case when level like '%Kitchen%' then promotores_chat else 0 end) as sat_chats_Kitch,
        sum(case when level like '%Kitchen%' then respuestas_chat else 0 end) as resp_chats_Kitch,

        

    from `peya-delivery-and-support.user_gabriel_paolillo.PSAT_ALAN` s

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN s.country = 'Panama' THEN 'Panamá'
											  WHEN s.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN s.country = 'Peru' THEN 'Perú'
											  WHEN s.country = 'Salvador' THEN 'El Salvador'
											  ELSE s.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6

    WHERE DATE(s.fecha) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    group by 1,2,3
    order by 1 desc
  
),

calls as 
(
	SELECT DISTINCT 
    DATE(i.start_date) AS fecha, 
	 
	CASE WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0054%%') THEN '3' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('54%%') THEN '3' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00591%%') THEN '17' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('591%%') THEN '17' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00595%%') THEN '15' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('595%%') THEN '15' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0018%%') THEN '18' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('18%%') THEN '18' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0058%%') THEN '8' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('58%%') THEN '8' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0056%%') THEN '2' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('56%%') THEN '2' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00507%%') THEN '11' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('507%%') THEN '11' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('0051%%') THEN '7' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('51%%') THEN '7' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00503%%') THEN '19' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('503%%') THEN '19' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00593%%') THEN '13' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('593%%') THEN '13' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00506%%') THEN '16' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('506%%') THEN '16' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00502%%') THEN '21' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('502%%') THEN '21' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00504%%') THEN '22' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('504%%') THEN '22' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00505%%') THEN '20' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('505%%') THEN '20' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('00598%%') THEN '1' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('598%%') THEN '1' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('09%%') THEN '1' 
			WHEN REGEXP_EXTRACT(i.contact_address, '[0-9]+') LIKE ('2%%') THEN '1' 
			ELSE null END AS country_id, 
		       	
			sum (case when i.survey_question_2 in ('4', '5') then 1 else 0 end) as sat_calls,
      sum (case when i.survey_question_2 in ('4', '5', '3', '2', '1') then 1 else 0 end) as resp_calls,

FROM `peya-data-origins-pro.cl_inconcert.call_report` AS i
            
WHERE i.campaign LIKE 'ps_in'
AND DATE(i.start_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)


group by 1,2

order by 1 desc
),

especializ as (

        SELECT 
        Fecha,
        Pais,
        cd.country_id as country_id,
       
        sum(case when tipo = 'Chat' then chats else null end) as chats_total,
        sum(case when equipo = 'Live' then chats else null end) as chats_live,
        sum(case when equipo = 'Billing' then chats else null end) as chats_billing,
        sum(case when equipo = 'Courier' then chats else null end) as chats_courier,
        sum(case when equipo = 'Shopper' then chats else null end) as chats_shopper,
        sum(case when equipo = 'Technical' then chats else null end) as chats_tech,
        sum(case when equipo = 'Content' then chats else null end) as chats_content,
        sum(case when equipo = 'Partner Service - Kitchen' then 1 else null end) as chats_kitchen,
       
        sum(case when tipo = 'Caso' then casos else null end) as cases_total,
        sum(case when tipo = 'Caso' then casos_offline else null end) as cases_off_total,
        sum(case when tipo = 'Caso' and equipo = 'Billing' then casos else null end) as cases_billing,
        sum(case when tipo = 'Caso' and equipo = 'Content' then casos else null end) as cases_content,
        sum(case when tipo = 'Caso' and equipo = 'Technical' then casos else null end) as cases_tech,
        sum(case when tipo = 'Caso' and equipo = 'Live' then casos else null end) as cases_live,
        sum(case when tipo = 'Caso' and equipo = 'Content' then casos_offline else null end) as cases_content_offline,
        sum(case when tipo = 'Caso' and equipo IN ('Technical', 'Billing') then casos_offline else null end) as cases_refund,
        sum(case when tipo = 'SSF' then llamadas else null end) as llamadas,

        sum(case when tipo = 'Llamada' then Deflectados else null end) as cases_SSF,

        sum(case when tipo = 'Caso' and Categoria = 'PicsApp' then casos_offline else null end) as cases_pics_app,
        sum(case when tipo = 'Caso' and Categoria = 'Fotos de logos' then casos_offline else null end) as cases_pics_logos,
        sum(case when tipo = 'Caso' and Categoria = 'Fotos profesionales' then casos_offline else null end) as cases_pics_profes,
        sum(case when tipo = 'Caso' and Categoria = 'Fotos de productos' then casos_offline else null end) as cases_pics_productos,
        
    FROM `peya-delivery-and-support.automated_tables_reports.core_metrics_ps_clean` cm
    
    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN cm.Pais = 'Panama' THEN 'Panamá'
											  WHEN cm.Pais = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN cm.Pais = 'Peru' THEN 'Perú'
											  WHEN cm.Pais = 'Salvador' THEN 'El Salvador'
											  ELSE cm.Pais
										  END)
				   AND cd.active
				   AND cd.country_id != 6

    WHERE DATE(Fecha) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
    group by 1,2,3
    order by 1 desc,2

)


SELECT
	COALESCE(p.fecha, h.fecha) AS fecha,
	COALESCE(p.country_id, h.country_id) AS country_id,

	p.sla_chats_ps,
	p.total_chats_para_sla,

	p.aht_acw_ps,
	p.cwt_numerador_completed,
	p.abandonados_antes_10segs,
	p.total_chats,

	ca.sla_casos_ps,

	s.sat_chats_ps,
	s.resp_chats_ps,
	s.sat_casos_ps,
	s.resp_casos_ps,
  s.sat_ssf,
	s.resp_ssf,
  s.qty_deflection,
  s.cant_casos_ps,
  s.cant_chats_ps,

	resueltos.casos_resueltos_ps,
	resueltos.casos_reabiertos_ps,
	
	h.tiempo_conexion_ps,
	h.tiempo_noprod_ps,
	h.tiempo_prod_chats_ps,
	h.tiempo_prod_casos_ps,

	/*
    a.casos_auto_ka,
	a.sla_auto_ka,
	a.casos_auto_nka,
	a.sla_auto_nka,
	a.casos_refund_ka,
	a.sla_refund_ka,
	a.casos_refund_nka,
	a.sla_refund_nka,
    */

	content.actualizaciones_cases,
	content.casos_actualizaciones_ka,
	content.sla_actualizaciones_ka,
	content.casos_actualizaciones_nka,
	content.sla_actualizaciones_nka,
	content.altas_cases,
	content.casos_altas,
	content.sla_altas,

	padres_hijos.padres_con_hijos,
	padres_hijos.padre_caso_con_hijos,
	padres_hijos.padre_chat_con_hijos,
	padres_hijos.padre_phone_con_hijos,

    espz.cases_total,
    espz.cases_off_total,    
    espz.chats_live,
    espz.chats_total,
    espz.chats_billing,
    espz.chats_content,
    espz.chats_shopper,
    espz.chats_courier,
    espz.chats_kitchen,
    espz.chats_tech,
    espz.cases_billing,
    espz.cases_content,
    espz.cases_tech,
    espz.cases_live,
    espz.cases_content_offline,
    espz.cases_refund,
    espz.llamadas,
    espz.cases_pics_app,
    espz.cases_pics_logos,
    espz.cases_pics_productos,
    espz.cases_pics_profes,

    psat_esp.sat_chats_Billing,
    psat_esp.sat_chats_PSLive,
    psat_esp.sat_chats_ContLive,
    psat_esp.sat_chats_SS,
    psat_esp.sat_chats_Tech,
    psat_esp.sat_chats_Courier,
    psat_esp.sat_chats_Kitch,
    psat_esp.resp_chats_Billing,
    psat_esp.resp_chats_PSLive,
    psat_esp.resp_chats_ContLive,
    psat_esp.resp_chats_SS,
    psat_esp.resp_chats_Tech,
    psat_esp.resp_chats_Courier,
    psat_esp.resp_chats_Kitch,

	  calls.sat_calls as sat_calls,
	  calls.resp_calls as resp_calls,
    


FROM (
	SELECT
	*
	from chats 


) p

/*
LEFT JOIN auto_refund a 
	   ON a.fecha = p.fecha 
	  AND a.country_id = p.country_id
*/

left join casos ca
	 ON ca.fecha = p.fecha 
				AND ca.country_id = p.country_id

LEFT JOIN psat_new s 
	   ON s.fecha = p.fecha 
	  AND s.country_id = p.country_id



FULL OUTER JOIN shnk_ps h 
		     ON h.fecha = p.fecha 
			AND h.country_id = p.country_id

LEFT JOIN (
	SELECT
		DATE(created_date) AS fecha,
		country_id,
		SUM(CASE WHEN field = 'Status' AND new_value = 'Resolved' THEN 1 ELSE 0 END) AS casos_resueltos_ps,
		SUM(CASE WHEN field = 'Status' AND new_value = 'Reopen' THEN 1 ELSE 0 END) AS casos_reabiertos_ps
	FROM casos_changes
	WHERE case_origin != 'Phone'
	GROUP BY 1,2
) resueltos ON resueltos.fecha = p.fecha 
		   AND resueltos.country_id = p.country_id

LEFT JOIN (
	SELECT
		COALESCE(i.fecha, s.fecha) AS fecha,
		COALESCE(i.country_id, s.country_id) AS country_id,
		/* ACTUALIZACIONES */
		actualizaciones_cases,
		casos_actualizaciones_ka,
		sla_actualizaciones_ka,
		casos_actualizaciones_nka,
		sla_actualizaciones_nka,
		/* ALTAS */
		altas_cases,
		casos_altas,
		sla_altas,
	FROM content_incoming i

	FULL OUTER JOIN content_sla s 
	             ON s.fecha = i.fecha
				AND s.country_id = i.country_id

) content ON content.fecha = p.fecha 
         AND content.country_id = p.country_id

LEFT JOIN padres_hijos 
	   ON padres_hijos.fecha = p.fecha 
	  AND padres_hijos.padre_country_id = p.country_id

LEFT JOIN especializ espz 
	   ON espz.fecha = p.fecha 
	  AND espz.country_id = p.country_id

LEFT JOIN psat_esp  
	   ON psat_esp.fecha = p.fecha 
	  AND psat_esp.country_id = p.country_id

LEFT JOIN calls  
	   ON calls.fecha = p.fecha 
	  AND cast (calls.country_id as int64) = p.country_id


ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
