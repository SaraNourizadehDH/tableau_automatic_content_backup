      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta_SQL_personalizada' id='_6423CEB9782347DF8BDE5B0B8BE3041F'>
            <properties context=''>
              <relation connection='bigquery.02b9mv70voy7e216la1pm0ygn5sq' name='Consulta_SQL_personalizada' type='text'><![CDATA[/*-- WBR LIVE OPS --*/

WITH orders AS (
	SELECT 
		DATE(registered_date) AS full_date,
		country.country_id AS country_id,
		country.country_name AS country_name,
		COUNT(DISTINCT order_id) AS total_orders,
		COUNT(DISTINCT CASE WHEN order_status IN ('CONFIRMED') THEN order_id END) AS confirmed_orders,
		COUNT(DISTINCT CASE WHEN order_status NOT IN ('CONFIRMED') THEN order_id END) AS non_confirmed_orders,
		COUNT(DISTINCT CASE WHEN with_logistics THEN order_id END) AS od_orders
	FROM `peya-bi-tools-pro.il_core.fact_orders` ord
	
	WHERE DATE(registered_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	  AND country.country_id != 6
	GROUP BY 1,2,3
),
cases AS (
	SELECT
		DATE(create_date) AS full_date,
		country_id,
        COUNT(DISTINCT CASE WHEN case_origin <<>> 'Chat' AND record_type_name = 'PY Inbound Case' AND case_type like '%ustomer' THEN case_id END) AS cs_cases,
		COUNT(DISTINCT CASE WHEN case_origin = 'Helpcenter' AND record_type_name = 'PY Inbound Case' AND case_type = 'Customer' THEN case_id END) AS cs_hc_casos,
		COUNT(DISTINCT CASE WHEN case_origin IN ('Facebook','Instagram','Twitter') AND record_type_name = 'PY Inbound Case' AND case_type = 'Customer' THEN case_id END) AS cs_redes,
		COUNT(DISTINCT CASE WHEN case_origin NOT IN ('Chat','Phone') AND record_type_name = 'PY Inbound Case' AND (case_type IN ('Restaurant - Data','Restaurant Request','Partner','Handover',' ') OR case_type IS NULL) THEN case_id END) AS ps_cases,
		COUNT(DISTINCT CASE WHEN case_type IN ('Restaurant - Transmission','Partner System Integration') AND closed_reason NOT IN ('Duplicate','Duplicated','Invalid','Invalido') THEN case_id END) AS auto_cases,
		COUNT(DISTINCT CASE WHEN case_type = 'Refund' THEN case_id END) AS refund_cases,
        COUNT(DISTINCT CASE WHEN case_origin NOT IN ('Chat', 'Phone') AND case_reason_level_3 = 'Spam / Irrelevant' AND record_type_name = 'PY Inbound Case' AND (case_type IN ('Restaurant -...Request','Partner','Handover', ' ') OR case_type IS NULL) THEN case_id END) AS ps_cases_spam,
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

	WHERE DATE(create_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%')    
	  AND country_id != 6
	GROUP BY 1,2	
),
livechat AS (
	SELECT 
		DATE(created_date) AS full_date,
		country_id,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') THEN chat_transcript_id END) AS cs_chats,
    COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') and status = 'Completed' AND chat_Wait_Time <<= 30 THEN chat_transcript_id END) AS sla_cs_chats,
		SUM(CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') AND status = 'Completed' AND chat_transcript_user.user_name = 'Automated Process' THEN 1 ELSE 0 END) AS cs_auto_proc,
		SUM(CASE WHEN livechat_button_id IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK') AND status = 'Completed' THEN 1 ELSE 0 END) AS cs_chats_atendidos,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') THEN chat_transcript_id END) AS ps_chats,
		COUNT(DISTINCT CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND visitor_message_count >> 0 THEN chat_transcript_id END) AS ps_chats_con_interaccion,
		SUM(CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND status = 'Completed' AND chat_transcript_user.user_name = 'Automated Process' THEN 1 ELSE 0 END) AS ps_auto_proc,
		SUM(CASE WHEN livechat_button_id IN ('5731r0000008gIBAAY','5731r0000008gIDAAY','5731r000000H1Z3AAK') AND status = 'Completed' AND chat_transcript_user_id NOT IN ('005w0000003pERkAAM') THEN 1 ELSE 0 END) AS ps_chats_atendidos
	FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`

	WHERE DATE(created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	AND country_id != 6
  GROUP BY 1,2
  ORDER BY 1 DESC, 2
), 
helpcenter AS (
	SELECT	
		DATE(s.created_at) AS full_date,
		cd.country_id,
		COUNT(DISTINCT s.session_id) AS cs_hc_sesiones,
		/*COUNT(DISTINCT CASE WHEN NOT s.is_ticket_created AND NOT s.is_chat_created THEN s.flow_session_id END) AS cs_hc_deflectados*/
	FROM `peya-data-origins-pro.cl_gcc_service.hc_sessions` s

	INNER JOIN `peya-data-origins-pro.cl_gcc_service.countries` c
            ON c.global_entity_id = s.global_entity_id

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_code = c.country_code
           AND cd.active
		   AND cd.country_id != 6
	
	WHERE DATE(s.created_at) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
), 

rs_data AS (
	SELECT
		fecha AS full_date,
		country_id,
		SUM(total_chats) AS rs_chats
	FROM (
		SELECT
			DATE_TRUNC(DATE(horasposta), DAY) AS fecha,
			country_id,
			COUNT(*) AS total_chats
		FROM (
			SELECT
				fc.chat_created_at,
				/*fc.first_assigned_timestamp as horasposta,*/
                DATETIME(fc.first_assigned_timestamp, 'America/Montevideo') as horasposta,
				cd.country_id
			FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

			INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN fc.country = 'Panama' THEN 'Panamá'
											  WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN fc.country = 'Peru' THEN 'Perú'
											  WHEN fc.country = 'Salvador' THEN 'El Salvador'
											  ELSE fc.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6

			WHERE DATE(fc.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND fc.department = 'Rider'
			  AND fc.management_entity = 'Pedidosya'
              AND FC.automated_chat = 0
		)
		GROUP BY 1,2
	)
	GROUP BY 1,2
),

ps_contacts as (

    select 
        date(psc.Fecha) as full_date,
        cd.country_id,
        psc.total_contactos as total_contacts_ps,
        psc.total_deflectados as total_deflect_ps,
    from `peya-delivery-and-support.automated_tables_reports.wbr_ps_contact` psc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = psc.Pais
           AND cd.active
		   AND cd.country_id != 6
        WHERE DATE(psc.Fecha) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), month)
	ORDER BY 1 DESC, 2
),



ss_contacts as (
    SELECT 
		DATE(chat_created_at) AS fc_date,
        cd.country_id,
		COUNT(DISTINCT interaction_id) AS chats_ss,
	FROM `peya-data-origins-pro.cl_gcc_service.freshchat_chats` fc

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
					ON cd.country_name = (CASE 
											  WHEN fc.country = 'Panama' THEN 'Panamá'
											  WHEN fc.country = 'Dominican Republic' THEN 'República Dominicana'
											  WHEN fc.country = 'Peru' THEN 'Perú'
											  WHEN fc.country = 'Salvador' THEN 'El Salvador'
											  ELSE fc.country
										  END)
				   AND cd.active
				   AND cd.country_id != 6
	
    WHERE DATE(created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND department = 'Shopper' 
	  AND management_entity = 'Pedidosya' 
	  AND automated_chat = 0
	GROUP BY 1,2
    
)


SELECT
	distinct(COALESCE(o.full_date, f.full_date)) AS full_date,
	COALESCE(o.country_id, f.country_id) AS country_id,

	o.country_name,
	o.total_orders,
	o.confirmed_orders,
	o.non_confirmed_orders,
	o.od_orders,

	c.cs_cases,
	c.cs_hc_casos,
	c.cs_redes,
	c.ps_cases,
	c.auto_cases,
	c.refund_cases,
    c.ps_cases_spam,

	li.cs_chats,
  li.sla_cs_chats,
	li.cs_chats_atendidos,
	li.cs_auto_proc,
	li.ps_chats,
	li.ps_chats_con_interaccion,
	li.ps_chats_atendidos,
	li.ps_auto_proc,

    rsd.rs_chats,

    psc.total_contacts_ps,
    psc.total_deflect_ps,

    ss.chats_ss,
    
	hc.cs_hc_sesiones,
	
FROM orders o

LEFT JOIN cases c 
	   ON c.full_date = o.full_date
	  AND c.country_id = o.country_id

LEFT JOIN livechat li 
	   ON li.full_date = o.full_date
	  AND li.country_id = o.country_id

LEFT JOIN helpcenter hc
	   ON hc.full_date = o.full_date
	  AND hc.country_id = o.country_id

LEFT JOIN ps_contacts  psc
	   ON psc.full_date = o.full_date
	  AND psc.country_id = o.country_id

LEFT JOIN rs_data  rsd
	   ON rsd.full_date = o.full_date
	  AND rsd.country_id = o.country_id


LEFT JOIN ss_contacts ss
        on ss.fc_date  = o.full_date
        and ss.country_id = o.country_id  

FULL OUTER JOIN (
	SELECT
		full_date,
		NULL AS country_id
	FROM orders
	GROUP BY 1
) AS f ON f.full_date = o.full_date 
      AND f.country_id = o.country_id
      
ORDER BY 1 DESC, 2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='CS (BQ)' inline='true' name='federated.0e7yaqr1ivmpk310mijqx0wx69zq' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0aghob70xlut8f11iayo31yud8i6'>
            <connection CATALOG='peya-bi-tools-pro' EXECCATALOG='peya-nicaragua' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-bi-tools-pro' schema='il_salesforce' server='' server-oauth='' username='sebastian.diazdevaldes@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0aghob70xlut8f11iayo31yud8i6' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH chats AS (
	SELECT
    date(lt.createddate, 'America/Montevideo') as fecha,
		cd.country_id,
		sum(CASE WHEN lt.status = 'Completed' AND lt.WaitTime <<= 30 THEN 1 ELSE 0 END) AS sla_chats_cs,
    sum(CASE WHEN lt.status = 'Missed' AND lt.Abandoned << 10 THEN 1 ELSE 0 END) AS abandonados_antes_10segs,
    sum(CASE WHEN lt.status = 'Completed' AND lt.WaitTime <<= 90 THEN 1  ELSE 0 END) AS cwt_numerador_completed,
		(COUNT(order_number) - COUNT(DISTINCT order_number)) AS chats_repetidos_cs,
		sum(DATETIME_DIFF(datetime(lt.LastModifiedDate), datetime(lt.StartTime), SECOND )) AS aht_acw_cs,
    count (lt.id) as tot_chats
	FROM `peya-data-origins-pro.cl_salesforce.livechat_transcript` as lt

  INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN lt.Country = 'Panama' THEN 'Panamá'
                                      WHEN lt.Country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN lt.Country = 'Peru' THEN 'Perú'
                                      WHEN lt.Country = 'Salvador' THEN 'El Salvador'
                                      ELSE lt.Country
                                  END)
           AND cd.active
		   AND cd.country_id != 6
	
	WHERE date(lt.createddate, 'America/Montevideo')  >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND lt.Country not in('Colombia')
    AND lt.Country not in('Germany')
    and lt.LiveChatButtonId IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK')

   
	GROUP BY 1,2
), 
casos AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','Social Media') AND DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 24 THEN 1 ELSE 0 END) AS sla_casos_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 1 THEN 1 ELSE 0 END) AS sla_redes_cs,
		(COUNT(case_order_id) - COUNT(DISTINCT case_order_id)) AS issues_repetidos_cs
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
	
	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND case_type IN ('Customer')
	  AND record_type_name IN ('PY Inbound Case')
	  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%') 	  
	  AND country_id != 6
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
), 
casos_changes AS (
	SELECT
		DATE(ca.create_date) AS created_date,
		ca.user_id,
		ca.case_origin,
		ca.country_id,
		ch.new_value,
		ch.field
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca
	
	LEFT JOIN (
		SELECT 
			CaseId AS case_id,
			NewValue AS new_value,
			Field AS field
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes`
		WHERE DATE(CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	) ch ON ch.case_id = ca.case_id
	
	WHERE DATE(ca.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ca.case_button_name IN ('PY_Inbound_Case')
	  AND ca.case_origin IN ('Helpcenter','Email','Facebook','Twitter','Instagram','Social Media')
	  AND ca.case_type IN ('Customer')
	  AND ca.country_id != 6
	  AND (ca.case_subjec NOT LIKE '%NDC |%' OR ca.case_subjec NOT LIKE '%No country%' OR ca.case_subjec NOT LIKE '%restaurant portal%')
), 
shnk_cs AS (
	SELECT
		DATE(datos_cs.fecha) AS fecha,
		NULL AS country_id,
		SUM(tiempo_conexion_cs) AS tiempo_conexion_cs,
		SUM(tiempo_prod_chats_cs) AS tiempo_prod_chats_cs,
		SUM(tiempo_prod_casos_cs) AS tiempo_prod_casos_cs,
		SUM(tiempo_non_sf_cs) AS tiempo_non_sf_cs,
		SUM(tiempo_noprod_cs) AS tiempo_noprod_cs
	FROM (
		SELECT
			fecha,
			user_id
		FROM (
			SELECT
				DATE(start_time) AS fecha,
				chat_transcript_user_id AS user_id
			FROM (
				SELECT
					DATE(start_time) AS start_time,
					chat_transcript_user_id
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
				
				WHERE DATE(start_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment','CS_SPA_PedidosYa_Urgent_Customer_Chat')
				  AND country_id != 6
			)
			GROUP BY 1,2
		) AS chats
		
		UNION DISTINCT
			SELECT
				DATE(created_date) AS fecha,
				user_id
			FROM casos_changes
			GROUP BY 1,2
	) AS datos_cs
	
	LEFT JOIN (
		SELECT 
			DATE(presence_status_start_date) as fecha,
			presence_user_id as user_id,
			SUM(CASE WHEN status_name in ('Busy','Lunch_Dinner','Short_Break_personal','Training_QA_Meeting') THEN presence_status_duration ELSE 0 END) AS tiempo_noprod_cs,
			SUM(presence_status_duration) as tiempo_conexion_cs,
			SUM(CASE WHEN status_name in ('Chats_Only', 'Cases_Chats') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_chats_cs,
			SUM(CASE WHEN status_name in ('Cases_Only') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_casos_cs,
			SUM(CASE WHEN status_name IN ('Assigned_Task_Non_SF') THEN presence_status_duration ELSE 0 END) AS tiempo_non_sf_cs
		FROM`peya-bi-tools-pro.il_salesforce.fact_salesforce_user_presence`
		
		WHERE DATE(presence_status_start_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		GROUP BY 1, 2
	) AS shnk_cs ON shnk_cs.fecha = datos_cs.fecha
				AND shnk_cs.user_id = datos_cs.user_id
	GROUP BY 1
),
csat AS (
	SELECT
		DATE(csat_mg.created_date) AS fecha,
        cd.country_id,
		SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media') THEN sat else 0 END) as  sat_casos_cs,
        SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media') THEN total_cases else 0 END) as  total_casos_cs,
        SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media')THEN response else 0 END) as  resp_casos_cs,
		SUM(CASE WHEN csat_mg.origin = 'SSF' THEN sat ELSE 0 END) AS sat_ssf_cs,
        SUM(CASE WHEN csat_mg.origin = 'SSF' THEN total_cases ELSE 0 END) AS total_ssf_cs,
        SUM(CASE WHEN csat_mg.origin = 'SSF' THEN response ELSE 0 END) AS resp_ssf_cs,
		SUM(CASE WHEN csat_mg.origin = 'Chat' THEN sat ELSE 0 END) AS sat_chats_cs,
        SUM(CASE WHEN csat_mg.origin = 'Chat' THEN total_cases ELSE 0 END) AS total_chats_cs,
        SUM(CASE WHEN csat_mg.origin = 'Chat' THEN response ELSE 0 END) AS resp_chats_cs,

	FROM `peya-delivery-and-support.automated_tables_reports.data_wbr_cs` csat_mg

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN csat_mg.country_name = 'Panama' THEN 'Panamá'
                                      WHEN csat_mg.country_name = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN csat_mg.country_name = 'Peru' THEN 'Perú'
                                      WHEN csat_mg.country_name = 'Salvador' THEN 'El Salvador'
                                      ELSE csat_mg.country_name
                                  END)
           AND cd.active
		   AND cd.country_id != 6

	WHERE DATE(csat_mg.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
),



chats_repetidos_agente AS (
	SELECT
		fecha,
		country_id,
		SUM(recontacto) AS chats_repetidos_agente_cs
	FROM (
		SELECT 
			DATE(request_time) AS fecha,
			chat_transcript_user_id,
			slt.country_id,
			COUNT(*) AS recontacto
		FROM(
			SELECT
				request_time,
				start_time,
				order_id,
				chat_transcript_user_id,
				chat_transcript_name,
				country_id,
				CAST(request_time AS STRING) || ' ' || CAST(order_id AS STRING) AS con
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			WHERE DATE(request_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Urgent_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment')
			  AND start_time IS NOT NULL
		) AS slt
		
		FULL OUTER JOIN(
			SELECT 
				CAST(fecha_max AS STRING) || ' ' ||  CAST(order_id AS STRING) AS con
			FROM (
				SELECT 
					DATE(request_time) AS fecha,
					order_id,
					MAX(request_time) AS fecha_max,
					COUNT(*) AS dupli 
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`

				WHERE DATE(request_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Urgent_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment')
				  AND start_time IS NOT NULL
				GROUP BY 1,2
			)
		) AS ultimo_chat ON slt.con = ultimo_chat.con
		
		WHERE ultimo_chat.con is null
		  AND request_time IS NOT null
		  AND order_id IS NOT NULL
		GROUP BY 1,2,3
	)
	GROUP BY 1,2
), 
 
sla_fr AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN (DATE_DIFF(created_date,create_date,SECOND)/3600 << 12 AND case_origin IN ('Helpcenter','Email','Social Media')) THEN 1 ELSE 0 END) AS sla_casos_fr_cs,
		SUM(CASE WHEN (DATE_DIFF(created_date,create_date,SECOND)/60 << 10 AND case_origin IN ('Facebook','Twitter','Instagram')) THEN 1 ELSE 0 END) AS sla_redes_fr_cs
	FROM (
		SELECT 
			TIMESTAMP(create_date) AS create_date,
			case_id,
			case_type,
			case_origin,
			country_id
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

		WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	      AND record_type_name = 'PY Inbound Case' 
		  AND case_origin != 'Chat'
		  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%')
		  AND case_type IN ('Customer')
	) AS casos
	
	LEFT JOIN (
		SELECT 
			cc.CaseId AS case_id,
			MIN(TIMESTAMP(DATETIME(cc.CreatedDate, cd.timezone))) AS created_date 
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` cc

		LEFT JOIN (
			SELECT 
				case_id,
				country_id 
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) ca ON ca.case_id = cc.CaseId

		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
				ON cd.country_id = ca.country_id
			   AND cd.active
			   AND cd.country_id != 6

		WHERE DATE(cc.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND cc.Field IN ('Status') 
		  AND cc.NewValue IN ('Resolved')
		GROUP BY 1
	) AS primera_resp ON primera_resp.case_id = casos.case_id
	GROUP BY 1,2
)
SELECT
	COALESCE(c.fecha, h.fecha) AS fecha,
	COALESCE(c.country_id, h.country_id) AS country_id,

	c.sla_chats_cs,
	c.chats_repetidos_cs,
	c.aht_acw_cs,
	c.sla_casos_cs,
	c.sla_redes_cs,
	c.issues_repetidos_cs,
  c.abandonados_antes_10segs,
  c.cwt_numerador_completed,
  c.tot_chats,

	r.chats_repetidos_agente_cs,

	sfr.sla_casos_fr_cs,
	sfr.sla_redes_fr_cs,

	s.sat_casos_cs,
    s.resp_casos_cs,
    s.total_casos_cs,
    s.sat_chats_cs,
    s.resp_chats_cs,
    s.total_chats_cs,
    s.sat_ssf_cs,
    s.resp_ssf_cs,
    s.total_ssf_cs,
	
	resueltos.casos_resueltos_cs,
	resueltos.casos_reabiertos_cs,	
	resueltos.redes_resueltas_cs,
	resueltos.redes_newanswer_cs,
		
	h.tiempo_conexion_cs,
	h.tiempo_noprod_cs,
	h.tiempo_prod_chats_cs,
	h.tiempo_prod_casos_cs,
	h.tiempo_non_sf_cs,

	
FROM (
	SELECT
		COALESCE(ch.fecha,ca.fecha) AS fecha,
		COALESCE(ch.country_id,ca.country_id) AS country_id,
		ch.sla_chats_cs,
		ch.chats_repetidos_cs,
		ch.aht_acw_cs,
		ca.sla_casos_cs,
		ca.sla_redes_cs,
		ca.issues_repetidos_cs,
    ch.abandonados_antes_10segs,
    ch.cwt_numerador_completed,
    ch.tot_chats,
  
	FROM chats AS ch
	
	FULL OUTER JOIN casos ca 
			     ON ca.fecha = ch.fecha 
			    AND ca.country_id = ch.country_id
) AS c

LEFT JOIN csat s 
	   ON s.fecha = c.fecha 
	  AND s.country_id = c.country_id


LEFT JOIN chats_repetidos_agente r 
	   ON r.fecha = c.fecha 
	  AND r.country_id = c.country_id


FULL OUTER JOIN shnk_cs h 
			 ON h.fecha = c.fecha
			AND h.country_id = c.country_id

LEFT JOIN (
	SELECT
		DATE(created_date) AS fecha,
		country_id,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','email','Social Media') AND field IN ('Status') AND new_value IN ('Resolved') THEN 1 ELSE 0 END) AS casos_resueltos_cs,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','email','Social Media') AND field IN ('Status') AND new_value IN ('Reopen') THEN 1 ELSE 0 END) AS casos_reabiertos_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND field IN ('Status') AND new_value IN ('Resolved') THEN 1 ELSE 0 END) AS redes_resueltas_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND field IN ('Status') AND new_value IN ('New Answer') THEN 1 ELSE 0 END) AS redes_newanswer_cs
	FROM casos_changes
	GROUP BY 1,2
) AS resueltos ON resueltos.fecha = c.fecha 
	          AND resueltos.country_id = c.country_id

LEFT JOIN sla_fr sfr ON sfr.fecha = c.fecha 
                    AND sfr.country_id = c.country_id   

ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0aghob70xlut8f11iayo31yud8i6' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH chats AS (
	SELECT
    date(lt.createddate, 'America/Montevideo') as fecha,
		cd.country_id,
		sum(CASE WHEN lt.status = 'Completed' AND lt.WaitTime <<= 30 THEN 1 ELSE 0 END) AS sla_chats_cs,
    sum(CASE WHEN lt.status = 'Missed' AND lt.Abandoned << 10 THEN 1 ELSE 0 END) AS abandonados_antes_10segs,
    sum(CASE WHEN lt.status = 'Completed' AND lt.WaitTime <<= 90 THEN 1  ELSE 0 END) AS cwt_numerador_completed,
		(COUNT(order_number) - COUNT(DISTINCT order_number)) AS chats_repetidos_cs,
		sum(DATETIME_DIFF(datetime(lt.LastModifiedDate), datetime(lt.StartTime), SECOND )) AS aht_acw_cs,
    count (lt.id) as tot_chats
	FROM `peya-data-origins-pro.cl_salesforce.livechat_transcript` as lt

  INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN lt.Country = 'Panama' THEN 'Panamá'
                                      WHEN lt.Country = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN lt.Country = 'Peru' THEN 'Perú'
                                      WHEN lt.Country = 'Salvador' THEN 'El Salvador'
                                      ELSE lt.Country
                                  END)
           AND cd.active
		   AND cd.country_id != 6
	
	WHERE date(lt.createddate, 'America/Montevideo')  >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND lt.Country not in('Colombia')
    AND lt.Country not in('Germany')
    and lt.LiveChatButtonId IN ('5731r000000H1YzAAK', '5731r0000008gFvAAI', '5731r000000H1YyAAK', '5731r000000H1Z0AAK', '5731r000000H1Z2AAK')

   
	GROUP BY 1,2
), 
casos AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','Social Media') AND DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 24 THEN 1 ELSE 0 END) AS sla_casos_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND DATE_DIFF(resolved_date,create_date,SECOND)/3600 << 1 THEN 1 ELSE 0 END) AS sla_redes_cs,
		(COUNT(case_order_id) - COUNT(DISTINCT case_order_id)) AS issues_repetidos_cs
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
	
	WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND case_type IN ('Customer')
	  AND record_type_name IN ('PY Inbound Case')
	  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%') 	  
	  AND country_id != 6
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
), 
casos_changes AS (
	SELECT
		DATE(ca.create_date) AS created_date,
		ca.user_id,
		ca.case_origin,
		ca.country_id,
		ch.new_value,
		ch.field
	FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases` ca
	
	LEFT JOIN (
		SELECT 
			CaseId AS case_id,
			NewValue AS new_value,
			Field AS field
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes`
		WHERE DATE(CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	) ch ON ch.case_id = ca.case_id
	
	WHERE DATE(ca.create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	  AND ca.case_button_name IN ('PY_Inbound_Case')
	  AND ca.case_origin IN ('Helpcenter','Email','Facebook','Twitter','Instagram','Social Media')
	  AND ca.case_type IN ('Customer')
	  AND ca.country_id != 6
	  AND (ca.case_subjec NOT LIKE '%NDC |%' OR ca.case_subjec NOT LIKE '%No country%' OR ca.case_subjec NOT LIKE '%restaurant portal%')
), 
shnk_cs AS (
	SELECT
		DATE(datos_cs.fecha) AS fecha,
		NULL AS country_id,
		SUM(tiempo_conexion_cs) AS tiempo_conexion_cs,
		SUM(tiempo_prod_chats_cs) AS tiempo_prod_chats_cs,
		SUM(tiempo_prod_casos_cs) AS tiempo_prod_casos_cs,
		SUM(tiempo_non_sf_cs) AS tiempo_non_sf_cs,
		SUM(tiempo_noprod_cs) AS tiempo_noprod_cs
	FROM (
		SELECT
			fecha,
			user_id
		FROM (
			SELECT
				DATE(start_time) AS fecha,
				chat_transcript_user_id AS user_id
			FROM (
				SELECT
					DATE(start_time) AS start_time,
					chat_transcript_user_id
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
				
				WHERE DATE(start_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment','CS_SPA_PedidosYa_Urgent_Customer_Chat')
				  AND country_id != 6
			)
			GROUP BY 1,2
		) AS chats
		
		UNION DISTINCT
			SELECT
				DATE(created_date) AS fecha,
				user_id
			FROM casos_changes
			GROUP BY 1,2
	) AS datos_cs
	
	LEFT JOIN (
		SELECT 
			DATE(presence_status_start_date) as fecha,
			presence_user_id as user_id,
			SUM(CASE WHEN status_name in ('Busy','Lunch_Dinner','Short_Break_personal','Training_QA_Meeting') THEN presence_status_duration ELSE 0 END) AS tiempo_noprod_cs,
			SUM(presence_status_duration) as tiempo_conexion_cs,
			SUM(CASE WHEN status_name in ('Chats_Only', 'Cases_Chats') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_chats_cs,
			SUM(CASE WHEN status_name in ('Cases_Only') THEN presence_status_duration ELSE 0 END) AS tiempo_prod_casos_cs,
			SUM(CASE WHEN status_name IN ('Assigned_Task_Non_SF') THEN presence_status_duration ELSE 0 END) AS tiempo_non_sf_cs
		FROM`peya-bi-tools-pro.il_salesforce.fact_salesforce_user_presence`
		
		WHERE DATE(presence_status_start_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		GROUP BY 1, 2
	) AS shnk_cs ON shnk_cs.fecha = datos_cs.fecha
				AND shnk_cs.user_id = datos_cs.user_id
	GROUP BY 1
),
csat AS (
	SELECT
		DATE(csat_mg.created_date) AS fecha,
        cd.country_id,
		SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media') THEN sat else 0 END) as  sat_casos_cs,
        SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media') THEN total_cases else 0 END) as  total_casos_cs,
        SUM(CASE WHEN csat_mg.origin in ('Helpcenter', 'Case', 'Social Media')THEN response else 0 END) as  resp_casos_cs,
		SUM(CASE WHEN csat_mg.origin = 'SSF' THEN sat ELSE 0 END) AS sat_ssf_cs,
        SUM(CASE WHEN csat_mg.origin = 'SSF' THEN total_cases ELSE 0 END) AS total_ssf_cs,
        SUM(CASE WHEN csat_mg.origin = 'SSF' THEN response ELSE 0 END) AS resp_ssf_cs,
		SUM(CASE WHEN csat_mg.origin = 'Chat' THEN sat ELSE 0 END) AS sat_chats_cs,
        SUM(CASE WHEN csat_mg.origin = 'Chat' THEN total_cases ELSE 0 END) AS total_chats_cs,
        SUM(CASE WHEN csat_mg.origin = 'Chat' THEN response ELSE 0 END) AS resp_chats_cs,

	FROM `peya-delivery-and-support.automated_tables_reports.data_wbr_cs` csat_mg

    INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
            ON cd.country_name = (CASE 
                                      WHEN csat_mg.country_name = 'Panama' THEN 'Panamá'
                                      WHEN csat_mg.country_name = 'Dominican Republic' THEN 'República Dominicana'
                                      WHEN csat_mg.country_name = 'Peru' THEN 'Perú'
                                      WHEN csat_mg.country_name = 'Salvador' THEN 'El Salvador'
                                      ELSE csat_mg.country_name
                                  END)
           AND cd.active
		   AND cd.country_id != 6

	WHERE DATE(csat_mg.created_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	GROUP BY 1,2
	ORDER BY 1 DESC, 2
),



chats_repetidos_agente AS (
	SELECT
		fecha,
		country_id,
		SUM(recontacto) AS chats_repetidos_agente_cs
	FROM (
		SELECT 
			DATE(request_time) AS fecha,
			chat_transcript_user_id,
			slt.country_id,
			COUNT(*) AS recontacto
		FROM(
			SELECT
				request_time,
				start_time,
				order_id,
				chat_transcript_user_id,
				chat_transcript_name,
				country_id,
				CAST(request_time AS STRING) || ' ' || CAST(order_id AS STRING) AS con
			FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`
			WHERE DATE(request_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
			  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Urgent_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment')
			  AND start_time IS NOT NULL
		) AS slt
		
		FULL OUTER JOIN(
			SELECT 
				CAST(fecha_max AS STRING) || ' ' ||  CAST(order_id AS STRING) AS con
			FROM (
				SELECT 
					DATE(request_time) AS fecha,
					order_id,
					MAX(request_time) AS fecha_max,
					COUNT(*) AS dupli 
				FROM `peya-bi-tools-pro.il_salesforce.fact_livechat_transcripts`

				WHERE DATE(request_time) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
				  AND livechat_button.button_name IN ('Chat_Button_for_PY_Escalation','CS_SPA_Appetito_Customer_Chat','CS_SPA_PedidosYa_Urgent_Customer_Chat','CS_SPA_PedidosYa_Customer_Chat','CS_SPA_PedidosYa_Online_Payment')
				  AND start_time IS NOT NULL
				GROUP BY 1,2
			)
		) AS ultimo_chat ON slt.con = ultimo_chat.con
		
		WHERE ultimo_chat.con is null
		  AND request_time IS NOT null
		  AND order_id IS NOT NULL
		GROUP BY 1,2,3
	)
	GROUP BY 1,2
), 
 
sla_fr AS (
	SELECT
		DATE(create_date) AS fecha,
		country_id,
		SUM(CASE WHEN (DATE_DIFF(created_date,create_date,SECOND)/3600 << 12 AND case_origin IN ('Helpcenter','Email','Social Media')) THEN 1 ELSE 0 END) AS sla_casos_fr_cs,
		SUM(CASE WHEN (DATE_DIFF(created_date,create_date,SECOND)/60 << 10 AND case_origin IN ('Facebook','Twitter','Instagram')) THEN 1 ELSE 0 END) AS sla_redes_fr_cs
	FROM (
		SELECT 
			TIMESTAMP(create_date) AS create_date,
			case_id,
			case_type,
			case_origin,
			country_id
		FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`

		WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
	      AND record_type_name = 'PY Inbound Case' 
		  AND case_origin != 'Chat'
		  AND (case_subjec NOT LIKE '%NDC |%' OR case_subjec NOT LIKE '%No country%' OR case_subjec NOT LIKE '%restaurant portal%')
		  AND case_type IN ('Customer')
	) AS casos
	
	LEFT JOIN (
		SELECT 
			cc.CaseId AS case_id,
			MIN(TIMESTAMP(DATETIME(cc.CreatedDate, cd.timezone))) AS created_date 
		FROM `peya-data-origins-pro.cl_salesforce.cases_changes` cc

		LEFT JOIN (
			SELECT 
				case_id,
				country_id 
			FROM `peya-bi-tools-pro.il_salesforce.fact_salesforce_cases`
			WHERE DATE(create_date) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		) ca ON ca.case_id = cc.CaseId

		INNER JOIN `peya-bi-tools-pro.il_core.dim_country` cd
				ON cd.country_id = ca.country_id
			   AND cd.active
			   AND cd.country_id != 6

		WHERE DATE(cc.CreatedDate) >>= DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH)
		  AND cc.Field IN ('Status') 
		  AND cc.NewValue IN ('Resolved')
		GROUP BY 1
	) AS primera_resp ON primera_resp.case_id = casos.case_id
	GROUP BY 1,2
)
SELECT
	COALESCE(c.fecha, h.fecha) AS fecha,
	COALESCE(c.country_id, h.country_id) AS country_id,

	c.sla_chats_cs,
	c.chats_repetidos_cs,
	c.aht_acw_cs,
	c.sla_casos_cs,
	c.sla_redes_cs,
	c.issues_repetidos_cs,
  c.abandonados_antes_10segs,
  c.cwt_numerador_completed,
  c.tot_chats,

	r.chats_repetidos_agente_cs,

	sfr.sla_casos_fr_cs,
	sfr.sla_redes_fr_cs,

	s.sat_casos_cs,
    s.resp_casos_cs,
    s.total_casos_cs,
    s.sat_chats_cs,
    s.resp_chats_cs,
    s.total_chats_cs,
    s.sat_ssf_cs,
    s.resp_ssf_cs,
    s.total_ssf_cs,
	
	resueltos.casos_resueltos_cs,
	resueltos.casos_reabiertos_cs,	
	resueltos.redes_resueltas_cs,
	resueltos.redes_newanswer_cs,
		
	h.tiempo_conexion_cs,
	h.tiempo_noprod_cs,
	h.tiempo_prod_chats_cs,
	h.tiempo_prod_casos_cs,
	h.tiempo_non_sf_cs,

	
FROM (
	SELECT
		COALESCE(ch.fecha,ca.fecha) AS fecha,
		COALESCE(ch.country_id,ca.country_id) AS country_id,
		ch.sla_chats_cs,
		ch.chats_repetidos_cs,
		ch.aht_acw_cs,
		ca.sla_casos_cs,
		ca.sla_redes_cs,
		ca.issues_repetidos_cs,
    ch.abandonados_antes_10segs,
    ch.cwt_numerador_completed,
    ch.tot_chats,
  
	FROM chats AS ch
	
	FULL OUTER JOIN casos ca 
			     ON ca.fecha = ch.fecha 
			    AND ca.country_id = ch.country_id
) AS c

LEFT JOIN csat s 
	   ON s.fecha = c.fecha 
	  AND s.country_id = c.country_id


LEFT JOIN chats_repetidos_agente r 
	   ON r.fecha = c.fecha 
	  AND r.country_id = c.country_id


FULL OUTER JOIN shnk_cs h 
			 ON h.fecha = c.fecha
			AND h.country_id = c.country_id

LEFT JOIN (
	SELECT
		DATE(created_date) AS fecha,
		country_id,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','email','Social Media') AND field IN ('Status') AND new_value IN ('Resolved') THEN 1 ELSE 0 END) AS casos_resueltos_cs,
		SUM(CASE WHEN case_origin IN ('Helpcenter','Email','email','Social Media') AND field IN ('Status') AND new_value IN ('Reopen') THEN 1 ELSE 0 END) AS casos_reabiertos_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND field IN ('Status') AND new_value IN ('Resolved') THEN 1 ELSE 0 END) AS redes_resueltas_cs,
		SUM(CASE WHEN case_origin IN ('Facebook','Twitter','Instagram') AND field IN ('Status') AND new_value IN ('New Answer') THEN 1 ELSE 0 END) AS redes_newanswer_cs
	FROM casos_changes
	GROUP BY 1,2
) AS resueltos ON resueltos.fecha = c.fecha 
	          AND resueltos.country_id = c.country_id

LEFT JOIN sla_fr sfr ON sfr.fecha = c.fecha 
                    AND sfr.country_id = c.country_id   

ORDER BY 1 DESC, 2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
