        <calculation class='tableau' formula='(&#13;&#10;    ZN(SUM([casos_resueltos_ps]))&#13;&#10;    + ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_chats_atendidos]))&#13;&#10;    + ZN(SUM([federated.014jwi501qmwa516va8g11ep5kco].[accepted_calls]))&#13;&#10;)&#13;&#10;/&#13;&#10;[Calculation_231090982309486622]' />
