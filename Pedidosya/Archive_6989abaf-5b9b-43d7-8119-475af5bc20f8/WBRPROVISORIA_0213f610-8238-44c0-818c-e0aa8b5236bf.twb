      </column>
      <column caption='PSAT SSF' datatype='real' default-format='p0.0%' name='[Calculation_229402134848126976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    ZN(SUM([sat_ssf]))&#13;&#10;    )&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([resp_ssf]))&#13;&#10;    &#13;&#10;    &#13;&#10;)' />
      </column>
