              <calculation class='tableau' formula='ZN([Calculation_231090982316036129]) * (ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_chats])) / [Calculation_231090982274187268])&#13;&#10;+&#13;&#10;ZN([Calculation_231090982316703778]) * (ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_cases])) / [Calculation_231090982274187268])' />
