            <column caption='ACC PS' datatype='real' default-format='p0.0%' name='[Calculation_231090982311039008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_chats_atendidos]) - SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_auto_proc]))&#13;&#10;/&#13;&#10;SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[ps_chats])' />
            </column>
            <column caption='SLA Chats PS' datatype='real' default-format='p0.0%' name='[Calculation_231090982316036129]' role='measure' type='quantitative'>
