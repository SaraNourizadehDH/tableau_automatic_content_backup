            <column caption='Session Rate CS' datatype='real' default-format='p0.0%' name='[Calculation_986006870513041425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ex Contact Rate&#13;&#10;[Calculation_986006870512570384] / SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[total_orders])' />
            </column>
            <column caption='Total Contacts CS' datatype='integer' name='[Calculation_986006870514139154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_cases]))&#13;&#10;+ ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_chats]))&#13;&#10;+ ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_redes]))' />
