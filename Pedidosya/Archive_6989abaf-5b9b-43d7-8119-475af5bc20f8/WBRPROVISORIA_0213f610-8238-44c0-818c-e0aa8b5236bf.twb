            <column caption='Total Sessions CS' datatype='integer' name='[Calculation_986006870512570384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([federated.0d2t8if0qr9af91bt6a6a0indn1o].[cs_hc_sesiones]))' />
