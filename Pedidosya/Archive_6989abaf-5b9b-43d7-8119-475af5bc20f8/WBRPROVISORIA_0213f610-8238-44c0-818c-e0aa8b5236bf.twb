          </datasource-dependencies>
          <datasource-dependencies datasource='federated.014jwi501qmwa516va8g11ep5kco'>
            <column caption='Accepted Calls' datatype='real' datatype-customized='true' name='[accepted_calls]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bs001i0x334ee18l7pgi0dps6r3'>
            <column caption='SLA Total SS' datatype='real' default-format='p0.0%' name='[Calculation_1090434091133194246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1322087993757114384]' />
            </column>
            <column caption='AHT SS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1090434091162255393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    ZN(SUM([aht_ss])) &#13;&#10;    + ZN(SUM([fc_sum_ht_ss]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([fc_chats_ss]))&#13;&#10;    + ZN(SUM([zendesk_chats_ss]))&#13;&#10;)' />
            </column>
            <column caption='Total Contacts SS' datatype='integer' name='[Calculation_1322087993730736138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([total_actions_ss]))&#13;&#10;+ ZN(SUM([fc_chats_ss]))' />
            </column>
            <column caption='Session Rate SS' datatype='real' default-format='p0.0%' name='[Calculation_1322087993750867981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ex Contact Rate&#13;&#10;([Calculation_1322087993730736138] + ZN(SUM([federated.0ok0qi71jguvvi1bcdjwj00dk7s0].[WAB Consultas])) - SUM(ZN([qty_pelican_action])))&#13;&#10;/&#13;&#10;SUM([total_orders])' />
            </column>
            <column caption='SLA SS' datatype='real' default-format='p0.0%' name='[Calculation_1322087993757114384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    ZN(SUM([sum_sla_ss]))&#13;&#10;    + ZN(SUM([fc_sum_sla_ss]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([zendesk_chats_ss]))&#13;&#10;    + ZN(SUM([fc_chats_ss]))&#13;&#10;)' />
            </column>
            <column caption='Prod Op SS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1322087993766023185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1322087993730736138] &#13;&#10;/&#13;&#10;[Calculation_229402136594227310]' />
            </column>
            <column caption='Tiempo Op SS' datatype='real' name='[Calculation_229402136594227310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hours_worked_ss])' />
            </column>
            <column caption='Total Chats SS' datatype='integer' name='[Calculation_463307845882376257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_chats_ss]) + SUM([fc_chats_ss])' />
            </column>
            <column datatype='integer' name='[aht_ss]' role='measure' type='quantitative' />
            <column datatype='integer' name='[fc_chats_ss]' role='measure' type='quantitative' />
            <column datatype='integer' name='[fc_sum_ht_ss]' role='measure' type='quantitative' />
            <column datatype='integer' name='[fc_sum_sla_ss]' role='measure' type='quantitative' />
            <column datatype='real' name='[hours_worked_ss]' role='measure' type='quantitative' />
            <column datatype='integer' name='[qty_pelican_action]' role='measure' type='quantitative' />
            <column datatype='date' name='[ss_date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[sum_sla_ss]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_actions_ss]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_chats_ss]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1090434091133194246]' derivation='User' name='[usr:Calculation_1090434091133194246:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1090434091162255393]' derivation='User' name='[usr:Calculation_1090434091162255393:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1322087993766023185]' derivation='User' name='[usr:Calculation_1322087993766023185:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[zendesk_chats_ss]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d2t8if0qr9af91bt6a6a0indn1o'>
            <column caption='AHT+ACW Total' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1090434091163328546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    ZN(SUM([federated.0e7yaqr1ivmpk310mijqx0wx69zq].[aht_acw_cs]))&#13;&#10;    + ZN(SUM([federated.0icrhgu0d17hy81c5mxe211ktu4x].[aht_acw_ps]))&#13;&#10;    + ZN(SUM([federated.0hg7usr1tkcpft131oell1mbbk8x].[aht_rs]))&#13;&#10;    + ZN(SUM([federated.0bs001i0x334ee18l7pgi0dps6r3].[aht_ss]))&#13;&#10;    + ZN(SUM([federated.0bs001i0x334ee18l7pgi0dps6r3].[fc_sum_ht_ss]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    ZN(SUM([cs_chats_atendidos]))&#13;&#10;    + ZN(SUM([ps_chats_atendidos]))&#13;&#10;    + ZN(SUM([federated.0hg7usr1tkcpft131oell1mbbk8x].[rs_chats]))&#13;&#10;    + ZN(SUM([federated.0bs001i0x334ee18l7pgi0dps6r3].[zendesk_chats_ss]))&#13;&#10;    + ZN(SUM([federated.0bs001i0x334ee18l7pgi0dps6r3].[fc_chats_ss]))&#13;&#10;)' />
