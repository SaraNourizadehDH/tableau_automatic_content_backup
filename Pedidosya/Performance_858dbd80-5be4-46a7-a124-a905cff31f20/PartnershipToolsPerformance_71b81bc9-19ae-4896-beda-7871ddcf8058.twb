  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Attribution Model'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/PartnershipToolsPerformance/AttributionModel?rev=' id='AttributionModel' path='/t/Pedidosya/workbooks/PartnershipToolsPerformance' revision='' site='Pedidosya' />
      <style />
      <size maxheight='900' maxwidth='1000' minheight='900' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='16500' id='3' is-scaled='1' param='Image/Rectangle 1 1.png' type-v2='bitmap' w='98100' x='1000' y='1250'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
        <zone h='14000' id='4' is-centered='0' is-scaled='1' param='Image/ícono-negativo.png' type-v2='bitmap' w='13700' x='86100' y='2250' />
        <zone forceUpdate='true' h='6750' id='5' type-v2='text' w='62500' x='4400' y='6000'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='24'>Attribution Model</run>
          </formatted-text>
        </zone>
        <zone h='75875' id='6' param='horz' type-v2='layout-flow' w='93700' x='1700' y='20000'>
          <zone fixed-size='929' forceUpdate='true' h='74444' id='7' is-fixed='true' type-v2='text' w='93700' x='1700' y='20000'>
            <formatted-text>
              <run bold='true' fontcolor='#555555' fontsize='8'>Push: </run>
              <run fontcolor='#555555' fontsize='8'>De los usuarios impactados por la push, se atribuye la conversión de el / los productos dentro de una ventana de 14 días.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion A:</run>
              <run fontcolor='#555555' fontsize='8'> Ordenes en la app</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion B:</run>
              <run fontcolor='#555555' fontsize='8'> En la vertical</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion C:</run>
              <run fontcolor='#555555' fontsize='8'>  En el partner</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion D:</run>
              <run fontcolor='#555555' fontsize='8'> En toda la app a 30 días  (utlizado en el dashboard como &quot;Orders&quot;)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Email:</run>
              <run fontcolor='#555555' fontsize='8'> De los usuarios abrieron el mail, se atribuye la conversión de el / los productos dentro de una ventana de 14 días.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion A:</run>
              <run fontcolor='#555555' fontsize='8'> Ordenes en la app</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion B:</run>
              <run fontcolor='#555555' fontsize='8'> En la vertical</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion C:</run>
              <run fontcolor='#555555' fontsize='8'>  En el partner</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Conversion D:</run>
              <run fontcolor='#555555' fontsize='8'> En toda la app a 30 días  (utlizado en el dashboard como &quot;Orders&quot;)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Sponsored products:</run>
              <run fontcolor='#555555' fontsize='8'> Se utiliza el modelo </run>
