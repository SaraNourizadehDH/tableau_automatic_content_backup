, home_banner_qc AS (&#13;
SELECT *&#13;
FROM (&#13;
SELECT&#13;
date&#13;
, bannerId AS CampaignId&#13;
, bannerName AS campaign_name&#13;
, country&#13;
, &apos;home_banner&apos; as tool&#13;
, &apos;NA&apos; brand_name&#13;
, &apos;NA&apos; brand_group_name&#13;
, SUM(banner_shown) as impresions&#13;
