  <column caption='challenge' datatype='real' name='[Calculation_1423137527691997185]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([challenge_completed]+[challenge_incomplete])' />
  </column>
  <column caption='tool_filter' datatype='boolean' name='[Calculation_1445655526922694658]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[tool]=[Parameters].[Parámetro 1]' />
  </column>
  <column caption='Filtro tabla' datatype='string' name='[Calculation_18577396092399617]' role='dimension' type='nominal'>
