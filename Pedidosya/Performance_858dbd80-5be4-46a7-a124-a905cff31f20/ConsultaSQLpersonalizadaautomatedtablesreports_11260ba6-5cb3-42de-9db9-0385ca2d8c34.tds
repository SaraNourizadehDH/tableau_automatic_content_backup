  <column caption='GMV EU' datatype='real' name='[CTR (copia)_882705529660379137]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;discounts&apos; THEN [total_product_price_eu]&#13;&#10;WHEN &apos;upselling&apos; THEN [total_product_price_eu]&#13;&#10;&#13;&#10;&#13;&#10;END' />
  </column>
  <column caption='CVR (copia 2)' datatype='real' name='[CVR (copia 2)_1225823528647892993]' role='measure' type='quantitative'>
