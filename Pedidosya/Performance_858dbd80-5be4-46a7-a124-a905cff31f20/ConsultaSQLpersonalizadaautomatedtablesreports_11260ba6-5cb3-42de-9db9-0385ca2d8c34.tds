    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02671p60qkuzfb1cx61cy1b2p3xi' name='Consulta SQL personalizada' type='text'><![CDATA[WITH braze AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, campaign_name
, country_name
, tool
, 'NA' as brand_name
, 'NA' brand_group_name
, SUM(sent)    as sent
, SUM(clicked) as clicked
, SUM(open) as open
, COUNT(DISTINCT user_id) as users
, SUM(orders) as orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_braze_push_iam_mailing2`
WHERE sent>>0








GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (sent, open, clicked, users, orders))
)








, citrus AS(
SELECT *
FROM (
SELECT
ingressed_at as date,
campaign_id,
campaign_name,
REGEXP_REPLACE(supplier_name, r'\s*Fixed Campa?i?gns?\s*', '') AS country_name,
campaign_placements as tool,
'' as brand_name,
'' as brand_group_name,
SUM(Impressions) as impresions,
SUM(Clicks) as clicked,
SUM(Conversions) as orders,
SUM(Unit_Sales) as quantity,
SUM(SalesRevenue) as total_product_price_eu,
AVG(ROAS) AS roas
FROM `peya-food-and-groceries.automated_tables_reports.citrus`
WHERE regexp_contains(UPPER(campaign_name),'PS')
GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, clicked, orders, quantity, total_product_price_eu,roas))
)




, branded_challenge AS (
  SELECT *
  FROM (
SELECT 
max(date),
challenge_id as campaign_id,
challenge_title as campaign_name,
country_name,
'Branded Challenge' as tool,
'NA' as brand_name,
'NA' brand_group_name,
COUNT(DISTINCT user_id) as users,
COUNT(DISTINCT CASE WHEN progress >> 0 AND progress << 100 THEN user_id ELSE NULL END) AS challenge_incomplete,
COUNT(DISTINCT CASE WHEN progress = 100 THEN user_id ELSE NULL END) AS challenge_completed
FROM `peya-food-and-groceries.automated_tables_reports.partnership_branded_challenge` 
group by 2,3,4,5,6,7
  )
  UNPIVOT(values FOR metrics IN (users, challenge_incomplete, challenge_completed))
)




, section_header_qc AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, subcategory_name AS campaign_name
, country_name
, 'section_header_qc' as tool
, brand_name
, 'NA' brand_group_name
, COUNT(DISTINCT CONCAT(sessionId)) as impresions
, COUNT(DISTINCT user_id) as users




FROM `peya-food-and-groceries.automated_tables_reports.partnership_section_header_qc`




GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, users))
)








, banner_order_status AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, campaign_name
, country_name
, 'banner_order_status' as tool
, brand_name as brand_BOS
, brand_group_name as CPG_BOS
, SUM(Users) as users
, SUM(Impressions) as impresions
, SUM(Viewed_Impressions) as viewed_impressions
, SUM(Clicks) as clicked
, 0 as orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_banner_order_status`




GROUP BY 1,2,3,4,5,6,7
)
UNPIVOT(values FOR metrics IN (users, impresions,viewed_impressions, clicked, orders))
)












, presearch AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, campaign_name
, country_name
, 'presearch' as tool
, brand_name as brand_PS
, brand_group_name as CPG_PS
, SUM(Users) as users
, SUM(impresiones) as impresions
, SUM(Clicks) as clicked
, 0 as orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_presearch`




GROUP BY 1,2,3,4,5,6,7
)
UNPIVOT(values FOR metrics IN (users, impresions, clicked, orders))
)








, home_banner_qc AS (
SELECT *
FROM (
SELECT
date
, bannerId AS CampaignId
, bannerName AS campaign_name
, country
, 'home_banner' as tool
, 'NA' brand_name
, 'NA' brand_group_name
, SUM(banner_shown) as impresions
, SUM(banner_clicked) as clicked
, SUM(session_with_transaction) as orders




FROM `peya-food-and-groceries.automated_tables_reports.performance_banners_home`
WHERE attribute_tags = 'is_partnership'








GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, clicked, orders))
)








, food_banner_qc AS (
SELECT *
FROM (
SELECT
date
, bannerId AS CampaignId
, bannerName AS campaign_name
, cc.country_name as country
, 'food_banner' as tool
, 'NA' brand_name
, 'NA' brand_group_name
, SUM(banner_shown) as impresions
, SUM(banner_clicked) as clicked
, SUM(banner_shop_transaction) as orders




FROM `peya-food-and-groceries.automated_tables_reports.performance_banners_food` as bff
LEFT JOIN `peya-data-origins-pro.cl_core.country` as cc
ON bff.country = cc.country_code
WHERE attribute_tags = 'is_partnership'








GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, clicked, orders))
)








,branded_section_qc AS (
  SELECT *
  FROM (
    SELECT
            date
          , campaign_id
          , campaign_name
          , country_name
          , 'branded_section_qc' as tool
          , brand_name
          , 'NA' brand_group_name
          , COUNT(DISTINCT (CASE WHEN branded_section_seen >> 0 THEN session_Id ELSE null END)) as impresions
          , COUNT(DISTINCT (CASE WHEN branded_section_clicked >> 0 THEN session_Id ELSE null END)) as clicked
          , COUNT(DISTINCT (CASE WHEN branded_section_transaction >> 0 THEN session_Id ELSE null END)) as orders
          , COUNT(DISTINCT user_id) as users




    FROM (
      SELECT
          date
        , user_id
        , campaign_id
        , section_name AS campaign_name
        , country_name
        , brand_name
        , CASE WHEN fullvisitorid is not null then concat(fullvisitorid,visitid,date(date),platform)
               WHEN clientid      is not null then concat(sessionId,clientid,global_entity_id)
               ELSE NULL END AS session_Id
        , MAX(branded_section_seen)    as branded_section_seen
        , MAX(branded_section_clicked) as branded_section_clicked
        , MAX(branded_section_transaction) as branded_section_transaction




      FROM `peya-food-and-groceries.automated_tables_reports.partnership_branded_section_qc`
      GROUP BY 1,2,3,4,5,6,7
      )
    GROUP BY 1,2,3,4,5,6
      )
  UNPIVOT(values FOR metrics IN (impresions, clicked, users, orders))




  )




, vouchers_int AS (
SELECT *
FROM (
SELECT
DATE(coupon_start) as date
, talon_campaign_id as campaign_id
, talon_campaign_name as campaign_name
, country_name
, 'vouchers' as tool
, 'NA' as brand_name
, 'NA' brand_group_name
, COUNT(DISTINCT order_id)    as orders
, COUNT(DISTINCT user_id)     as users
, COUNT(DISTINCT coupon_id)   as sent
, SUM(cupon_usado)            as cupon_usado
, SUM(cupon_cargado)          as cupon_cargado
-- , SUM(monto_usado)          as monto_usado
-- , SUM(monto_usado_eu)       as monto_usado_eu




FROM `peya-food-and-groceries.automated_tables_reports.partnership_vouchers`




GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (orders, users, sent, cupon_usado, cupon_cargado))--, monto_usado, monto_usado_eu))




)




, vouchers_float AS (




SELECT
DATE(coupon_start) as date
, talon_campaign_id as campaign_id
, talon_campaign_name as campaign_name
, country_name
, 'vouchers' as tool
, 'NA' as brand_name
, 'NA' brand_group_name
, SUM(monto_cupon)          as monto_cupon
, SUM(monto_cupon_eu)       as monto_cupon_eu
, SUM(monto_usado)          as monto_usado
, SUM(monto_usado_eu)       as monto_usado_eu




FROM `peya-food-and-groceries.automated_tables_reports.partnership_vouchers`




GROUP BY 1,2,3,4,5,6
)








, upselling AS (




SELECT *
FROM (
SELECT
date,
campaign_id,
campaign_name,
country_name,
tool,
brand_name,
brand_owner_name,
sum(impresions) as impresions,
sum(clicked) as clicked,
sum(clicked_and_transaction) as clicked_and_transaction,
CAST(sum(total_product_price_eu) AS INT64) as total_product_price_eu,
CAST(sum(total_product_price_lc) AS INT64) as total_product_price_lc
FROM(
SELECT
DATE(date) AS date,
'NA' campaign_id,
upselling_product_name AS campaign_name,
country_name,
'upselling' as tool,
brand_name,
brand_owner_name,
CASE WHEN fullvisitorid IS NOT NULL THEN concat(fullvisitorid,visitid,date(date),platform)
WHEN client_id IS NOT NULL THEN concat(session_id,client_id,global_entity_id,date(date),platform)
ELSE NULL END as session_id,
MAX(upselling_loaded) as impresions,
MAX(upselling_clicked) AS clicked,
MAX(upselling_clicked_and_transaction) AS clicked_and_transaction,
total_product_price_eu as total_product_price_eu,
total_product_price_lc as total_product_price_lc




FROM `peya-food-and-groceries.automated_tables_reports.partnership_upselling2`
GROUP BY 1,2,3,4,5,6,7,8, total_product_price_eu, total_product_price_lc
)
GROUP BY 1,2,3,4,5,6,7
)
UNPIVOT(values FOR metrics IN (impresions, clicked, clicked_and_transaction, total_product_price_eu, total_product_price_lc))
)








, tienda_propia_int AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  'NA' campaign_id,
  partner_name AS campaign_name,
  country_name,
  'tienda propia' as tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  SUM(total_confirmed_orders) AS confirmed_orders,
  SUM(total_users) AS users,
  --SUM(gmv_lc) AS GMV_LC,
  --SUM(gmv_eu) AS GMV_EU,
  SUM(total_sessions) AS sessions,
  SUM(session_orders) AS orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_tienda_propia`
GROUP BY 1,2,3,4
)
UNPIVOT(values FOR metrics IN (confirmed_orders, users, sessions,orders))




)








, tienda_propia_float AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  'NA' campaign_id,
  partner_name AS campaign_name,
  country_name,
  'tienda propia' as tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  SUM(gmv_lc) AS GMV_LC,
  SUM(gmv_eu) AS GMV_EU,




FROM `peya-food-and-groceries.automated_tables_reports.partnership_tienda_propia`
GROUP BY 1,2,3,4
)




)








, free_delivery_int AS (
SELECT *
FROM (
SELECT
  DATE(date) AS date,
  campaign_id,
  campaign_name AS campaign_name,
  country_name,
  'free_delivery' AS tool,
  brand_name,
  'NA' brand_group_name,
  --original_amount,
  --remaining_amount,
  --((original_amount-remaining_amount)/original_amount)*100 AS consumption,
  COUNTIF(impression_boolean = 1) AS impresions,
  COUNTIF(click_boolean = 1) AS clicked,
  COUNTIF(transaction_boolean = 1) AS orders,
  COUNT (DISTINCT user_id) AS users
FROM `peya-food-and-groceries.automated_tables_reports.partnership_free_delivery_fee` fdf




GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (users, impresions, clicked, orders))
)








, free_delivery_float AS (
SELECT *
FROM (
SELECT
  DATE(date) AS date,
  campaign_id,
  free_shipping_fee_campaign_name AS campaign_name,
  country_name,
  'free_delivery' AS tool,
  brand_name,
  'NA' brand_group_name,
  MAX(original_amount) AS original_amount,
  MAX(remaining_amount) AS remaining_amount,




FROM `peya-food-and-groceries.automated_tables_reports.partnership_free_delivery_fee` fdf




GROUP BY 1,2,3,4,5,6
)




)








, descuentos_int AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  campaign_id,
  campaign_name,
  country_name,
  'descuentos' AS tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  COUNT(order_id) AS orders,
  CAST(SUM(qty_sold) AS INT64) AS quantity
FROM `peya-food-and-groceries.automated_tables_reports.partnership_promo_tools`
GROUP BY 1,2,3,4,5,6




)
UNPIVOT(values FOR metrics IN (orders, quantity))
)








, descuentos_float AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  campaign_id,
  discount_product_name,
  campaign_name,
  country_name,
  'descuentos' AS tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  SUM(sponsorship_paid_amount) AS discount_LC,
  SUM(sponsorship_paid_amount_eu) AS discount_EU,
  SUM(product_subtotal_lc) AS product_subtotal_lc,
  SUM(product_subtotal_eu) AS product_subtotal_eu
FROM `peya-food-and-groceries.automated_tables_reports.partnership_promo_tools`
GROUP BY 1,2,3,4,5,6




)
)








, final AS (
SELECT *
FROM braze b
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM citrus c
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




 --SELECT *
 --FROM branded_challenge bc
 --PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))

--UNION ALL




SELECT *
FROM section_header_qc shqc
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM banner_order_status bos
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM presearch ps
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM home_banner_qc hb
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM food_banner_qc fb
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM vouchers_int v
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM upselling up
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu",  "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM branded_section_qc bsqc
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu",  "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM tienda_propia_int tpi
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu",  "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM free_delivery_int fd
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu",  "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM descuentos_int d
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu",  "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))
)








SELECT f.*
, vf.monto_usado
, vf.monto_usado_eu
, vf.monto_cupon
, vf.monto_cupon_eu
, tpf.GMV_LC
, tpf.GMV_EU
, fdf.original_amount
, fdf.remaining_amount
, df.discount_LC
, df.discount_EU
, df.product_subtotal_eu
, df.product_subtotal_lc
, df.discount_product_name




FROM final f




LEFT JOIN vouchers_float vf
ON  f.date = vf.date
AND f.campaign_id  = vf.campaign_id




LEFT JOIN tienda_propia_float tpf
ON  f.date = tpf.date
AND f.campaign_name  = tpf.campaign_name




LEFT JOIN free_delivery_float fdf
ON  f.date = fdf.date
AND f.campaign_name  = fdf.campaign_name




LEFT JOIN descuentos_float df
ON  f.date = df.date
AND f.campaign_name  = df.campaign_name]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.02671p60qkuzfb1cx61cy1b2p3xi' name='Consulta SQL personalizada' type='text'><![CDATA[WITH braze AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, campaign_name
, country_name
, tool
, 'NA' as brand_name
, 'NA' brand_group_name
, SUM(sent)    as sent
, SUM(clicked) as clicked
, SUM(open) as open
, COUNT(DISTINCT user_id) as users
, SUM(orders) as orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_braze_push_iam_mailing2`
WHERE sent>>0








GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (sent, open, clicked, users, orders))
)








, citrus AS(
SELECT *
FROM (
SELECT
ingressed_at as date,
campaign_id,
campaign_name,
REGEXP_REPLACE(supplier_name, r'\s*Fixed Campa?i?gns?\s*', '') AS country_name,
campaign_placements as tool,
'' as brand_name,
'' as brand_group_name,
SUM(Impressions) as impresions,
SUM(Clicks) as clicked,
SUM(Conversions) as orders,
SUM(Unit_Sales) as quantity,
SUM(SalesRevenue) as total_product_price_eu,
AVG(ROAS) AS roas
FROM `peya-food-and-groceries.automated_tables_reports.citrus`
WHERE regexp_contains(UPPER(campaign_name),'PS')
GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, clicked, orders, quantity, total_product_price_eu,roas))
)




, branded_challenge AS (
  SELECT *
  FROM (
SELECT 
max(date),
challenge_id as campaign_id,
challenge_title as campaign_name,
country_name,
'Branded Challenge' as tool,
'NA' as brand_name,
'NA' brand_group_name,
COUNT(DISTINCT user_id) as users,
COUNT(DISTINCT CASE WHEN progress >> 0 AND progress << 100 THEN user_id ELSE NULL END) AS challenge_incomplete,
COUNT(DISTINCT CASE WHEN progress = 100 THEN user_id ELSE NULL END) AS challenge_completed
FROM `peya-food-and-groceries.automated_tables_reports.partnership_branded_challenge` 
group by 2,3,4,5,6,7
  )
  UNPIVOT(values FOR metrics IN (users, challenge_incomplete, challenge_completed))
)




, section_header_qc AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, subcategory_name AS campaign_name
, country_name
, 'section_header_qc' as tool
, brand_name
, 'NA' brand_group_name
, COUNT(DISTINCT CONCAT(sessionId)) as impresions
, COUNT(DISTINCT user_id) as users




FROM `peya-food-and-groceries.automated_tables_reports.partnership_section_header_qc`




GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, users))
)








, banner_order_status AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, campaign_name
, country_name
, 'banner_order_status' as tool
, brand_name as brand_BOS
, brand_group_name as CPG_BOS
, SUM(Users) as users
, SUM(Impressions) as impresions
, SUM(Viewed_Impressions) as viewed_impressions
, SUM(Clicks) as clicked
, 0 as orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_banner_order_status`




GROUP BY 1,2,3,4,5,6,7
)
UNPIVOT(values FOR metrics IN (users, impresions,viewed_impressions, clicked, orders))
)












, presearch AS (
SELECT *
FROM (
SELECT
date
, campaign_id
, campaign_name
, country_name
, 'presearch' as tool
, brand_name as brand_PS
, brand_group_name as CPG_PS
, SUM(Users) as users
, SUM(impresiones) as impresions
, SUM(Clicks) as clicked
, 0 as orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_presearch`




GROUP BY 1,2,3,4,5,6,7
)
UNPIVOT(values FOR metrics IN (users, impresions, clicked, orders))
)








, home_banner_qc AS (
SELECT *
FROM (
SELECT
date
, bannerId AS CampaignId
, bannerName AS campaign_name
, country
, 'home_banner' as tool
, 'NA' brand_name
, 'NA' brand_group_name
, SUM(banner_shown) as impresions
, SUM(banner_clicked) as clicked
, SUM(session_with_transaction) as orders




FROM `peya-food-and-groceries.automated_tables_reports.performance_banners_home`
WHERE attribute_tags = 'is_partnership'








GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, clicked, orders))
)








, food_banner_qc AS (
SELECT *
FROM (
SELECT
date
, bannerId AS CampaignId
, bannerName AS campaign_name
, cc.country_name as country
, 'food_banner' as tool
, 'NA' brand_name
, 'NA' brand_group_name
, SUM(banner_shown) as impresions
, SUM(banner_clicked) as clicked
, SUM(banner_shop_transaction) as orders




FROM `peya-food-and-groceries.automated_tables_reports.performance_banners_food` as bff
LEFT JOIN `peya-data-origins-pro.cl_core.country` as cc
ON bff.country = cc.country_code
WHERE attribute_tags = 'is_partnership'








GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (impresions, clicked, orders))
)








,branded_section_qc AS (
  SELECT *
  FROM (
    SELECT
            date
          , campaign_id
          , campaign_name
          , country_name
          , 'branded_section_qc' as tool
          , brand_name
          , 'NA' brand_group_name
          , COUNT(DISTINCT (CASE WHEN branded_section_seen >> 0 THEN session_Id ELSE null END)) as impresions
          , COUNT(DISTINCT (CASE WHEN branded_section_clicked >> 0 THEN session_Id ELSE null END)) as clicked
          , COUNT(DISTINCT (CASE WHEN branded_section_transaction >> 0 THEN session_Id ELSE null END)) as orders
          , COUNT(DISTINCT user_id) as users




    FROM (
      SELECT
          date
        , user_id
        , campaign_id
        , section_name AS campaign_name
        , country_name
        , brand_name
        , CASE WHEN fullvisitorid is not null then concat(fullvisitorid,visitid,date(date),platform)
               WHEN clientid      is not null then concat(sessionId,clientid,global_entity_id)
               ELSE NULL END AS session_Id
        , MAX(branded_section_seen)    as branded_section_seen
        , MAX(branded_section_clicked) as branded_section_clicked
        , MAX(branded_section_transaction) as branded_section_transaction




      FROM `peya-food-and-groceries.automated_tables_reports.partnership_branded_section_qc`
      GROUP BY 1,2,3,4,5,6,7
      )
    GROUP BY 1,2,3,4,5,6
      )
  UNPIVOT(values FOR metrics IN (impresions, clicked, users, orders))




  )




, vouchers_int AS (
SELECT *
FROM (
SELECT
DATE(coupon_start) as date
, talon_campaign_id as campaign_id
, talon_campaign_name as campaign_name
, country_name
, 'vouchers' as tool
, 'NA' as brand_name
, 'NA' brand_group_name
, COUNT(DISTINCT order_id)    as orders
, COUNT(DISTINCT user_id)     as users
, COUNT(DISTINCT coupon_id)   as sent
, SUM(cupon_usado)            as cupon_usado
, SUM(cupon_cargado)          as cupon_cargado
-- , SUM(monto_usado)          as monto_usado
-- , SUM(monto_usado_eu)       as monto_usado_eu




FROM `peya-food-and-groceries.automated_tables_reports.partnership_vouchers`




GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (orders, users, sent, cupon_usado, cupon_cargado))--, monto_usado, monto_usado_eu))




)




, vouchers_float AS (




SELECT
DATE(coupon_start) as date
, talon_campaign_id as campaign_id
, talon_campaign_name as campaign_name
, country_name
, 'vouchers' as tool
, 'NA' as brand_name
, 'NA' brand_group_name
, SUM(monto_cupon)          as monto_cupon
, SUM(monto_cupon_eu)       as monto_cupon_eu
, SUM(monto_usado)          as monto_usado
, SUM(monto_usado_eu)       as monto_usado_eu




FROM `peya-food-and-groceries.automated_tables_reports.partnership_vouchers`




GROUP BY 1,2,3,4,5,6
)








, upselling AS (




SELECT *
FROM (
SELECT
date,
campaign_id,
campaign_name,
country_name,
tool,
brand_name,
brand_owner_name,
sum(impresions) as impresions,
sum(clicked) as clicked,
sum(clicked_and_transaction) as clicked_and_transaction,
CAST(sum(total_product_price_eu) AS INT64) as total_product_price_eu,
CAST(sum(total_product_price_lc) AS INT64) as total_product_price_lc
FROM(
SELECT
DATE(date) AS date,
'NA' campaign_id,
upselling_product_name AS campaign_name,
country_name,
'upselling' as tool,
brand_name,
brand_owner_name,
CASE WHEN fullvisitorid IS NOT NULL THEN concat(fullvisitorid,visitid,date(date),platform)
WHEN client_id IS NOT NULL THEN concat(session_id,client_id,global_entity_id,date(date),platform)
ELSE NULL END as session_id,
MAX(upselling_loaded) as impresions,
MAX(upselling_clicked) AS clicked,
MAX(upselling_clicked_and_transaction) AS clicked_and_transaction,
total_product_price_eu as total_product_price_eu,
total_product_price_lc as total_product_price_lc




FROM `peya-food-and-groceries.automated_tables_reports.partnership_upselling2`
GROUP BY 1,2,3,4,5,6,7,8, total_product_price_eu, total_product_price_lc
)
GROUP BY 1,2,3,4,5,6,7
)
UNPIVOT(values FOR metrics IN (impresions, clicked, clicked_and_transaction, total_product_price_eu, total_product_price_lc))
)








, tienda_propia_int AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  'NA' campaign_id,
  partner_name AS campaign_name,
  country_name,
  'tienda propia' as tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  SUM(total_confirmed_orders) AS confirmed_orders,
  SUM(total_users) AS users,
  --SUM(gmv_lc) AS GMV_LC,
  --SUM(gmv_eu) AS GMV_EU,
  SUM(total_sessions) AS sessions,
  SUM(session_orders) AS orders




FROM `peya-food-and-groceries.automated_tables_reports.partnership_tienda_propia`
GROUP BY 1,2,3,4
)
UNPIVOT(values FOR metrics IN (confirmed_orders, users, sessions,orders))




)








, tienda_propia_float AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  'NA' campaign_id,
  partner_name AS campaign_name,
  country_name,
  'tienda propia' as tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  SUM(gmv_lc) AS GMV_LC,
  SUM(gmv_eu) AS GMV_EU,




FROM `peya-food-and-groceries.automated_tables_reports.partnership_tienda_propia`
GROUP BY 1,2,3,4
)




)








, free_delivery_int AS (
SELECT *
FROM (
SELECT
  DATE(date) AS date,
  campaign_id,
  campaign_name AS campaign_name,
  country_name,
  'free_delivery' AS tool,
  brand_name,
  'NA' brand_group_name,
  --original_amount,
  --remaining_amount,
  --((original_amount-remaining_amount)/original_amount)*100 AS consumption,
  COUNTIF(impression_boolean = 1) AS impresions,
  COUNTIF(click_boolean = 1) AS clicked,
  COUNTIF(transaction_boolean = 1) AS orders,
  COUNT (DISTINCT user_id) AS users
FROM `peya-food-and-groceries.automated_tables_reports.partnership_free_delivery_fee` fdf




GROUP BY 1,2,3,4,5,6
)
UNPIVOT(values FOR metrics IN (users, impresions, clicked, orders))
)








, free_delivery_float AS (
SELECT *
FROM (
SELECT
  DATE(date) AS date,
  campaign_id,
  free_shipping_fee_campaign_name AS campaign_name,
  country_name,
  'free_delivery' AS tool,
  brand_name,
  'NA' brand_group_name,
  MAX(original_amount) AS original_amount,
  MAX(remaining_amount) AS remaining_amount,




FROM `peya-food-and-groceries.automated_tables_reports.partnership_free_delivery_fee` fdf




GROUP BY 1,2,3,4,5,6
)




)








, descuentos_int AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  campaign_id,
  campaign_name,
  country_name,
  'descuentos' AS tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  COUNT(order_id) AS orders,
  CAST(SUM(qty_sold) AS INT64) AS quantity
FROM `peya-food-and-groceries.automated_tables_reports.partnership_promo_tools`
GROUP BY 1,2,3,4,5,6




)
UNPIVOT(values FOR metrics IN (orders, quantity))
)








, descuentos_float AS (
SELECT *
FROM (
SELECT
  DATE(registered_date) AS date,
  campaign_id,
  discount_product_name,
  campaign_name,
  country_name,
  'descuentos' AS tool,
  'NA' AS brand_name,
  'NA' brand_group_name,
  SUM(sponsorship_paid_amount) AS discount_LC,
  SUM(sponsorship_paid_amount_eu) AS discount_EU,
  SUM(product_subtotal_lc) AS product_subtotal_lc,
  SUM(product_subtotal_eu) AS product_subtotal_eu
FROM `peya-food-and-groceries.automated_tables_reports.partnership_promo_tools`
GROUP BY 1,2,3,4,5,6




)
)








, final AS (
SELECT *
FROM braze b
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




SELECT *
FROM citrus c
PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))




UNION ALL




 --SELECT *
 --FROM branded_challenge bc
 --PIVOT(SUM(values) FOR metrics IN ("sent","clicked","open","impresions","viewed_impressions","users","orders","cupon_usado","cupon_cargado","clicked_and_transaction","confirmed_orders","sessions","quantity", "total_product_price_eu", "total_product_price_lc","challenge_incomplete", "challenge_completed", "roas"))

--UNION ALL




SELECT *
