  </column>
  <column caption='Amount Discount LC' datatype='real' name='[Calculation_18577396144070658]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_cupon])&#13;&#10;WHEN &quot;free_delivery&quot; THEN MAX([original_amount])&#13;&#10;END' />
  </column>
  <column caption='Amount Discount EU' datatype='real' name='[Calculation_18577396144812035]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_cupon_eu])&#13;&#10;END' />
  </column>
  <column caption='Discount used LC' datatype='real' name='[Calculation_18577396146757637]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_usado])&#13;&#10;WHEN &quot;free_delivery&quot; THEN MAX([original_amount])- MAX([remaining_amount])&#13;&#10;WHEN &quot;descuentos&quot; THEN SUM([discount_LC])&#13;&#10;END' />
  </column>
  <column caption='Discount used EU' datatype='real' name='[Calculation_18577396147212294]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;vouchers&quot; THEN SUM([monto_usado_eu])&#13;&#10;WHEN &quot;descuentos&quot; THEN SUM([discount_EU])&#13;&#10;END' />
  </column>
  <column caption='Utilization Rate' datatype='real' name='[Calculation_18577396149604361]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;free_delivery&quot; THEN (MAX([original_amount])- MAX([remaining_amount]))/MAX([original_amount])&#13;&#10;END' />
  </column>
  <column caption='CVR' datatype='real' name='[Calculation_18577396154843147]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([clicked_and_transaction])/SUM([clicked])' />
  </column>
  <column caption='Sessions' datatype='real' name='[Calculation_251638676504043520]' role='measure' type='quantitative'>
