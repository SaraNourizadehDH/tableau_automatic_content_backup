  <column caption='Sent' datatype='real' name='[Calculation_322570367375015936]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;in_app_message&apos; THEN SUM([sent])&#13;&#10;WHEN &apos;push&apos; THEN SUM([sent])&#13;&#10;WHEN &apos;email&apos; THEN SUM([sent])&#13;&#10;WHEN &apos;vouchers&apos; THEN SUM([sent])&#13;&#10;END' />
  </column>
  <column caption='Orders' datatype='real' name='[Calculation_536772827843768321]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1] &#13;&#10;WHEN &apos;upselling&apos; THEN SUM([clicked_and_transaction])&#13;&#10;WHEN &apos;vouchers&apos; THEN SUM([orders])&#13;&#10;WHEN &apos;tienda propia&apos; THEN SUM([confirmed_orders])&#13;&#10;WHEN &apos;free_delivery&apos; THEN SUM([orders])&#13;&#10;WHEN &apos;descuentos&apos; THEN SUM([orders])&#13;&#10;WHEN &apos;foos_banner_qc&apos; THEN SUM([orders])&#13;&#10;WHEN &apos;push&apos; THEN SUM([orders])&#13;&#10;&#13;&#10;END' />
