      <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2507379119404752896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,[orders],0)) / SUM({EXCLUDE [fail_rate_owner], [order_status] : SUM([orders]) })' />
      </column>
      <column caption='#Rejected' datatype='integer' name='[Calculation_2507379121191550979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [order_status]: SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,[orders],0))}' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_94294174913503236]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[registered_date Parámetro] = &quot;Day&quot; then DATETRUNC(&quot;day&quot;, [registered_date]) &#13;&#10;elseif [Parameters].[registered_date Parámetro] = &quot;Week&quot; then DATETRUNC(&quot;week&quot;, [registered_date]) &#13;&#10;elseif [Parameters].[registered_date Parámetro] = &quot;Month&quot; then DATETRUNC(&quot;month&quot;, [registered_date]) &#13;&#10;end' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
