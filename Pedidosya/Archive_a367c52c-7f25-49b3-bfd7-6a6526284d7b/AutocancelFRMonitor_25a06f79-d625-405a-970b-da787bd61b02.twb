      <aliases enabled='yes' />
      <column caption='#Rejected (copia)' datatype='integer' name='[#Rejected (copia)_2507379121501573128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,[orders],0))' />
      </column>
      <column caption='% Fail Rate (copia 2)' datatype='real' default-format='p0.00%' name='[% Fail Rate (copia 2)_1684346304741314560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,[orders],0)) /  SUM([orders])' />
      </column>
      <column caption='UserFR' datatype='real' default-format='p0.00%' name='[% Fail Rate (copia 2)_2507379121194766340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([fail_rate_owner]=&apos;User&apos;,[orders],0)) / SUM([orders])' />
      </column>
      <column caption='% True FR' datatype='real' default-format='p0.00%' name='[% Fail Rate (copia) (copia)_2507379121405669382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([true_fr] = 1 and [order_status]!=&apos;CONFIRMED&apos;,orders,0))  / SUM({EXCLUDE [fail_rate_owner], [order_status] : SUM([orders]) })' />
      </column>
      <column caption='% Fail Rate (owner)' datatype='real' default-format='p0.00%' name='[% Fail Rate (copia) (copia)_2507379121500377095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,[orders],0)) / SUM({EXCLUDE [fail_rate_owner] : SUM([orders])})' />
      </column>
      <column caption='% Fail Rate (copia)' datatype='real' default-format='p0.00%' name='[% Fail Rate (copia)_2507379119405113345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([order_status]!=&apos;CONFIRMED&apos;,orders,0)) / SUM({EXCLUDE [fail_rate_owner], [order_status] : SUM(orders)})' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0g2k6w21nisczf1ehwzmf10hm4lx].[sum:amount_no_discount_eur:qk]&quot;' value='food_value_eur' />
          <alias key='&quot;[federated.0g2k6w21nisczf1ehwzmf10hm4lx].[sum:Budget_EUR_to_GRANT:qk]&quot;' value='Budget EUR' />
