    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glosario'>
      <repository-location id='Glosario' path='/t/Pedidosya/workbooks/AcquisitionsProfitROI' revision='' site='Pedidosya' />
      <style />
      <size maxheight='3000' maxwidth='1000' minheight='3000' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='7' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='8' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone fixed-size='72' forceUpdate='true' h='2667' id='3' is-fixed='true' type-v2='text' w='100000' x='0' y='0'>
              <formatted-text>
                <run fontalignment='1' fontcolor='#ffffff' fontsize='17'>Glosario</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#ec1d60' />
              </zone-style>
            </zone>
            <zone fixed-size='351' forceUpdate='true' h='11967' id='4' is-fixed='true' type-v2='text' w='100000' x='0' y='2667'>
              <formatted-text>
                <run fontsize='8'>El reporte de </run>
                <run bold='true' fontsize='8'>ROI</run>
                <run fontsize='8'> tiene como objetivo evaluar el retorno de inversion de las adquisiciones, considerando el </run>
                <run bold='true' fontsize='8'>M3 </run>
                <run fontsize='8'>como cohort &quot;ideal&quot;  para recuperar esa inversión.</run>
                <run>Æ&#10;&#10;</run>
                <run fontsize='8'>La inversión en una adquisicion es el </run>
                <run bold='true' fontsize='8'>CPA </run>
                <run fontsize='8'>(costo de adquisicion).</run>
                <run>Æ&#10;&#10;</run>
                <run fontsize='8' italic='true'>Indicadores:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ec1d60' fontsize='7'>Seller: </run>
                <run fontsize='7'>Cada FTEs</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ec1d60' fontsize='7'>Acquisitions:</run>
                <run fontsize='7'> # New Partners </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ec1d60' fontsize='7'>Take In:</run>
                <run fontsize='7'> Commission Revenue Without Subsidizes + Other Revenue + Other Take In + Delivery Fee + Joker Fee</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ec1d60' fontsize='7'>NCR Profit:</run>
                <run fontsize='7'> Revenues Ads (Gold Vip + Featured Products + Keywords)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ec1d60' fontsize='7'>CPO:</run>
                <run fontsize='7'> Rider cost basic + Food Delivery Accident + Payment CPO + Other non Specific CPO + Semivariable Delivery CPO</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ec1d60' fontsize='7'>CPA: </run>
                <run fontsize='7'>Seller Fixed + Seller Variable + Marketing Campaign + Quality Check + Onboarding + Lead Research + Salesforce Lice</run>
                <run bold='true' fontsize='7'>nse</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontsize='7'>PROFIT</run>
                <run fontsize='7'>= - CPA (costo de adquisición en el M0) - CPO (costos operativos por orden)+ Take In (Ingresos por órden) + NCR Profit (Ingresos por ADS)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='7'>ROI</run>
                <run fontsize='7'> = Profit / CPA  &gt; Retorno de la inversión, siendo la inversión el CPA</run>
                <run>Æ&#10;</run>
                <run fontsize='7'>Color code = </run>
                <run fontcolor='#f30000' fontsize='7'>Profit negativo</run>
                <run fontsize='7'> / </run>
                <run fontcolor='#226239' fontsize='7'>Profit positivo</run>
                <run fontsize='7'> / </run>
                <run fontcolor='#f30000' fontsize='7'>ROI &lt;1</run>
                <run fontsize='7'> / </run>
                <run fontcolor='#226239' fontsize='7'>ROI &gt;1</run>
                <run>Æ&#10;&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='9600' id='9' param='vert' type-v2='layout-flow' w='100000' x='0' y='14634'>
              <zone forceUpdate='true' h='9600' id='11' type-v2='text' w='100000' x='0' y='14634'>
                <formatted-text>
                  <run bold='true' fontsize='8' italic='true'>Visualización por performance Cohort:</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#ec1d60' fontsize='8'>MO (0-30 DIAS DESDE EL FIRST DAY ONLINE)</run>
                  <run fontsize='8'> = -CPA + TAKE IN - CPO + NCR PROFIT = PROFIT M0</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ec1d60' fontsize='8'>M1 (31-60 DIAS DESDE EL FIRST DAY ONLINE) </run>
                  <run fontsize='8'>= TAKE IN - CPO + NCR PROFIT = PROFIT M1</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ec1d60' fontsize='8'>M2 (61-90 DIAS DESDE EL FIRST DAY ONLINE) </run>
                  <run fontsize='8'>= TAKE IN - CPO + NCR PROFIT = PROFIT M2</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#595959' fontsize='8' italic='true'>VISUAL CASCADA ACUMULANDO PROFIT</run>
                  <run fontcolor='#595959' fontsize='8'> : ES POSITIVO CUANDO ROI&gt;1 </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#595959' fontsize='8'>* CPA sólo es costo en MO</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#595959' fontsize='8'>* PROFIT ACUMULADO : resultado del cohort + profit de cohort vigente</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontsize='8' italic='true'>Visualización  por Country:</run>
                  <run bold='true' fontsize='8'>Æ </run>
                  <run>Æ&#10;</run>
                  <run fontsize='8'>objetivo visualizar profitability del conjunto de nuevas cuentas, de acuerdo al mes de adquisición</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='497' h='16567' id='12' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='24234'>
              <zone fixed-size='123' h='4367' id='17' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Captura de pantalla 2025-02-07 153239.png' type-v2='bitmap' w='100000' x='0' y='24234'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='6766' id='18' param='horz' type-v2='layout-flow' w='100000' x='0' y='28601'>
                <zone fixed-size='58' h='6766' id='20' is-fixed='true' param='horz' type-v2='layout-flow' w='5800' x='0' y='28601' />
                <zone forceUpdate='true' h='6766' id='19' type-v2='text' w='94200' x='5800' y='28601'>
                  <formatted-text>
                    <run fontsize='7'>Si filtro:</run>
                    <run>Æ&#10;</run>
                    <run fontsize='7'>Mes de Adquisici´ón: </run>
                    <run bold='true' fontsize='7'>Junio 2024</run>
                    <run>Æ&#10;</run>
                    <run fontsize='7'>Country: Costa Rica</run>
                    <run>Æ&#10;</run>
                    <run fontsize='7'>MO: cohort de junio 24 - Se acumulan órdenes del día 1 al 30 / Profit net en esos primeros 30 días (comienza siendo neg)</run>
                    <run>Æ&#10;</run>
                    <run fontsize='7'>MI: cohort de junio 24 y su performance en julio 24 - Se acumulan órdenes del día 31 al 60 / Profit net en esos 60 días</run>
                    <run>Æ&#10;</run>
                    <run fontsize='7'>M2: cohort de junio 24 y su performance en agosto 24 - Se acumulan órdenes del día 61 al 90 / Profit net en esos 90 días</run>
                    <run>Æ&#10;</run>
                    <run fontsize='7'>M3: cohort de junio 24 y su performance en septiembre 24 - Se acumulan ordenes del día 91 al 120 / Profit net en esos 120 días</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='7'>Identificamos en color </run>
                    <run bold='true' fontcolor='#005500' fontsize='7'>VERDE</run>
                    <run fontsize='7'> cuando el retorno de inversión ROI &gt; 1, a partir de ese momento supera la inversión.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone fixed-size='155' forceUpdate='true' h='5434' id='13' is-fixed='true' type-v2='text' w='100000' x='0' y='35367'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='30' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='99466' id='29' param='vert' type-v2='layout-flow' w='98400' x='800' y='267'>
                <zone fixed-size='72' forceUpdate='true' h='2667' id='3' type-v2='text' w='100000' x='0' y='0'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#ffffff' fontsize='17'>Glosario</run>
