        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.08em2xt16m0smw1ez4gxv1lfdsk4' name='Consulta SQL personalizada3' type='text'>SELECT * FROM `peya-food-and-groceries.automated_tables_reports.Acquisitions_LTV`&#13;
