              <zone forceUpdate='true' h='4933' id='24' type-v2='text' w='98666' x='667' y='9298'>
                <formatted-text>
                  <run bold='true' fontsize='7'>Profit</run>
                  <run fontsize='7'> = -CPA (costo adquisición en M0) - CPO (costos operativos por orden) + TAKE IN (ingresos por órden) + NCR Profit (ingresos por ADS)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontsize='7'>ROI</run>
                  <run fontsize='7'> = Profit / CPA = retorno de la inversión siendo la inversión el CPA </run>
                  <run>Æ&#10;</run>
                  <run fontsize='7'>Color code = </run>
                  <run fontcolor='#f30000' fontsize='7'>Profit negativo</run>
                  <run fontsize='7'> / </run>
                  <run fontcolor='#226239' fontsize='7'>Profit positivo</run>
                  <run fontsize='7'> / </run>
                  <run fontcolor='#f30000' fontsize='7'>ROI &lt;1</run>
                  <run fontsize='7'> / </run>
                  <run fontcolor='#226239' fontsize='7'>ROI &gt;1</run>
