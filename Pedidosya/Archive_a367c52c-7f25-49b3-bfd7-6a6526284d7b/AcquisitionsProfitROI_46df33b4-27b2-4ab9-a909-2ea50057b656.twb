          <relation connection='bigquery.08em2xt16m0smw1ez4gxv1lfdsk4' name='Consulta SQL personalizada3' type='text'>SELECT * FROM `peya-food-and-groceries.automated_tables_reports.Acquisitions_LTV`&#13;
&#13;
union all &#13;
SELECT &#13;
month,&#13;
acquisition_date,&#13;
date_online,&#13;
&apos;LATAM&apos; as country_name,&#13;
&apos;LATAM&apos; as city_name,&#13;
&apos;LATAM&apos; as area_name,&#13;
partner_id,&#13;
