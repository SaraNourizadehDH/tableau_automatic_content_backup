          <relation connection='bigquery.08em2xt16m0smw1ez4gxv1lfdsk4' name='Consulta SQL personalizada1' type='text'>WITH TOTAL_ORDERS_paises AS (&#13;
  -- La primera consulta de TOTAL_ORDERS_paises&#13;
WITH total_orders AS (&#13;
  SELECT&#13;
    DATE_TRUNC(Month, MONTH) AS Month,&#13;
    Country,&#13;
    Source as Channel,&#13;
    SUM(orders) AS OrdersTotalCompany&#13;
  FROM `peya-food-and-groceries.automated_tables_reports.SQR_Active_y_Orders_Query_Juani`&#13;
  where vertical = &apos;Food&apos;&#13;
  GROUP BY 1, 2,3&#13;
),&#13;
&#13;
&#13;
&#13;
&#13;
total_orders_M1_M2 AS (&#13;
  SELECT&#13;
    curr.Month AS Month,&#13;
    curr.Country,&#13;
    curr.Channel,&#13;
    curr.OrdersTotalCompany AS OrdersTotalCompanyM0,&#13;
    next1.OrdersTotalCompany AS OrdersTotalCompanyM1,&#13;
    next2.OrdersTotalCompany AS OrdersTotalCompanyM2&#13;
  FROM total_orders curr&#13;
  LEFT JOIN total_orders next1&#13;
    ON curr.Country = next1.Country&#13;
    AND curr.Channel = next1.Channel&#13;
    AND next1.Month = DATE_ADD(curr.Month, INTERVAL 1 MONTH)&#13;
  LEFT JOIN total_orders next2&#13;
    ON curr.Country = next2.Country&#13;
    AND curr.Channel = next2.Channel&#13;
    AND next2.Month = DATE_ADD(curr.Month, INTERVAL 2 MONTH)&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
&#13;
&#13;
SELECT&#13;
  Month,&#13;
  Country,&#13;
  Channel,&#13;
  OrdersTotalCompanyM0,&#13;
  OrdersTotalCompanyM1,&#13;
  OrdersTotalCompanyM2&#13;
FROM total_orders_M1_M2&#13;
&#13;
&#13;
&#13;
&#13;
),&#13;
&#13;
&#13;
&#13;
&#13;
ACTIVE_COHORTS AS (&#13;
  -- La consulta de ACTIVE_COHORTS&#13;
select  &#13;
month_online as Month,&#13;
country_name as Country,&#13;
channel as Channel,&#13;
SUM(base_onlines) as base_onlines, -- todos los partners que tuvieron first date online en ese mes&#13;
SUM(ActiveM0) as ActiveM0,&#13;
SUM (ActiveM1) as ActiveM1,&#13;
SUM(ActiveM2) AS ActiveM2,&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.SQR_MO_M1_M2_2`&#13;
GROUP BY 1,2,3&#13;
&#13;
&#13;
),&#13;
ORDERS_COHORTS AS (&#13;
  -- La consulta de ORDERS_COHORTS&#13;
select  &#13;
month_online as Month,&#13;
country_name as Country,&#13;
channel as Channel,&#13;
SUM(base_onlines) as base_onlines, -- todos los partners que tuvieron first date online en ese mes&#13;
SUM(ordersM1) AS OrdersM0,&#13;
SUM(ordersM2) AS ordersM1,&#13;
SUM(ordersM3) AS ordersM2,&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.SQR_M1_M2_M3_2`&#13;
GROUP BY 1,2,3&#13;
&#13;
&#13;
),&#13;
TOTAL_ORDERS_latam AS (&#13;
  -- La segunda consulta de TOTAL_ORDERS_latam&#13;
WITH total_orders AS (&#13;
  SELECT&#13;
    DATE_TRUNC(Month, MONTH) AS Month,&#13;
    &apos;LATAM&apos; as Country,&#13;
    Source as Channel,&#13;
    SUM(orders) AS OrdersTotalCompany&#13;
  FROM `peya-food-and-groceries.automated_tables_reports.SQR_Active_y_Orders_Query_Juani`&#13;
  where vertical = &apos;Food&apos;&#13;
  GROUP BY 1, 2,3&#13;
),&#13;
&#13;
&#13;
&#13;
&#13;
total_orders_M1_M2 AS (&#13;
  SELECT&#13;
    curr.Month AS Month,&#13;
    &apos;LATAM&apos; as Country,&#13;
    curr.Channel,&#13;
    curr.OrdersTotalCompany AS OrdersTotalCompanyM0,&#13;
    next1.OrdersTotalCompany AS OrdersTotalCompanyM1,&#13;
    next2.OrdersTotalCompany AS OrdersTotalCompanyM2&#13;
  FROM total_orders curr&#13;
  LEFT JOIN total_orders next1&#13;
    ON curr.Channel = next1.Channel&#13;
    AND next1.Month = DATE_ADD(curr.Month, INTERVAL 1 MONTH)&#13;
  LEFT JOIN total_orders next2&#13;
    ON curr.Channel = next2.Channel&#13;
    AND next2.Month = DATE_ADD(curr.Month, INTERVAL 2 MONTH)&#13;
GROUP BY 1,2,3,4,5,6&#13;
)&#13;
&#13;
&#13;
&#13;
&#13;
SELECT&#13;
  Month,&#13;
  Country,&#13;
  Channel,&#13;
  OrdersTotalCompanyM0,&#13;
  OrdersTotalCompanyM1,&#13;
  OrdersTotalCompanyM2&#13;
FROM total_orders_M1_M2&#13;
&#13;
&#13;
&#13;
&#13;
),&#13;
&#13;
&#13;
ACTIVE_COHORTS_latam AS (&#13;
  -- La consulta de ACTIVE_COHORTS para LATAM&#13;
select  &#13;
month_online as Month,&#13;
&apos;LATAM&apos; as Country,&#13;
channel as Channel,&#13;
SUM(base_onlines) as base_onlines, -- todos los partners que tuvieron first date online en ese mes&#13;
SUM(ActiveM0) as ActiveM0,&#13;
SUM (ActiveM1) as ActiveM1,&#13;
SUM(ActiveM2) AS ActiveM2,&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.SQR_MO_M1_M2_2`&#13;
GROUP BY 1,2,3&#13;
&#13;
&#13;
),&#13;
ORDERS_COHORTS_latam AS (&#13;
  -- La consulta de ORDERS_COHORTS para LATAM&#13;
select  &#13;
month_online as Month,&#13;
&apos;LATAM&apos; as Country,&#13;
channel as Channel,&#13;
SUM(base_onlines) as base_onlines, -- todos los partners que tuvieron first date online en ese mes&#13;
SUM(ordersM1) AS OrdersM0,&#13;
SUM(ordersM2) AS ordersM1,&#13;
SUM(ordersM3) AS ordersM2,&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.SQR_M1_M2_M3_2`&#13;
GROUP BY 1,2,3  &#13;
)&#13;
&#13;
&#13;
-- Aquí se combinan las dos tablas usando UNION ALL&#13;
SELECT&#13;
  tt.Month,&#13;
  tt.Country,&#13;
  tt.Channel,&#13;
  tt.OrdersTotalCompanyM0 AS OrdersTotalCompanyM0,&#13;
  tt.OrdersTotalCompanyM1 AS OrdersTotalCompanyM1,&#13;
  tt.OrdersTotalCompanyM2 AS OrdersTotalCompanyM2,&#13;
  MAX(ac.base_onlines) AS Base_onlines,&#13;
  MAX(ac.ActiveM0) AS ActiveM0,&#13;
  MAX(ac.ActiveM1) AS ActiveM1,&#13;
  MAX(ac.ActiveM2) AS ActiveM2,&#13;
  MAX(oc.OrdersM0) AS OrdersM0,&#13;
  MAX(oc.OrdersM1) AS OrdersM1,&#13;
  MAX(oc.OrdersM2) AS OrdersM2&#13;
FROM TOTAL_ORDERS_paises tt&#13;
LEFT JOIN ACTIVE_COHORTS ac&#13;
  ON tt.Month = ac.Month&#13;
  AND tt.Country = ac.Country&#13;
  AND tt.Channel = ac.Channel&#13;
LEFT JOIN ORDERS_COHORTS oc&#13;
  ON tt.Month = oc.Month&#13;
  AND tt.Country = oc.Country&#13;
  AND tt.Channel = oc.Channel&#13;
GROUP BY 1,2,3,4,5,6&#13;
&#13;
&#13;
UNION ALL&#13;
&#13;
&#13;
SELECT&#13;
  tt.Month,&#13;
  tt.Country,&#13;
  tt.Channel,&#13;
  tt.OrdersTotalCompanyM0 AS OrdersTotalCompanyM0,&#13;
  tt.OrdersTotalCompanyM1 AS OrdersTotalCompanyM1,&#13;
  tt.OrdersTotalCompanyM2 AS OrdersTotalCompanyM2,&#13;
  MAX(ac.base_onlines) AS Base_onlines,&#13;
  MAX(ac.ActiveM0) AS ActiveM0,&#13;
  MAX(ac.ActiveM1) AS ActiveM1,&#13;
  MAX(ac.ActiveM2) AS ActiveM2,&#13;
  MAX(oc.OrdersM0) AS OrdersM0,&#13;
  MAX(oc.OrdersM1) AS OrdersM1,&#13;
  MAX(oc.OrdersM2) AS OrdersM2&#13;
FROM TOTAL_ORDERS_latam tt&#13;
LEFT JOIN ACTIVE_COHORTS_latam ac&#13;
  ON tt.Month = ac.Month&#13;
  AND tt.Country = ac.Country&#13;
  AND tt.Channel = ac.Channel&#13;
LEFT JOIN ORDERS_COHORTS_latam oc&#13;
  ON tt.Month = oc.Month&#13;
  AND tt.Country = oc.Country&#13;
  AND tt.Channel = oc.Channel&#13;
GROUP BY 1,2,3,4,5,6</relation>
          <relation connection='bigquery.08em2xt16m0smw1ez4gxv1lfdsk4' name='Consulta SQL personalizada' type='text'>WITH acq AS&#13;
(&#13;
select&#13;
month,&#13;
Country,&#13;
&apos;SSU&apos; as Seller_Channel,&#13;
Seller_Head_Count_SSU_Exp as Headcount_Exp,&#13;
Food_Acquisitions_SSU_Exp as Acquisitions_Exp,&#13;
Food_Acquisitions_SSU as Acquisitions_Total,&#13;
SAFE_DIVIDE (Food_Acquisitions_SSU_Exp,Seller_Head_Count_SSU_Exp) as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
UNION ALL&#13;
select&#13;
month,&#13;
Country,&#13;
&apos;Field&apos; as Seller_Channel,&#13;
Seller_Head_Count_Field_Exp as Headcount_Exp,&#13;
Food_Acquisitions_Field_Exp as Acquisitions_Exp,&#13;
Food_Acquisitions_Field as Acquisitions_Total,&#13;
SAFE_DIVIDE (Food_Acquisitions_Field_Exp,Seller_Head_Count_Field_Exp) as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
UNION ALL&#13;
select&#13;
month,&#13;
Country,&#13;
&apos;Must Have&apos; as Seller_Channel,&#13;
Seller_Head_Count_Must_Have_Exp as Headcount_Exp,&#13;
Food_Acquisitions_Must_Have_Exp as Acquisitions_Exp,&#13;
Food_Acquisitions_Must_Have as Acquisitions_Total,&#13;
SAFE_DIVIDE (Food_Acquisitions_Must_Have_Exp,Seller_Head_Count_Must_Have_Exp) as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
UNION ALL&#13;
select&#13;
month,&#13;
Country,&#13;
&apos;Non Seller&apos; as Seller_Channel,&#13;
0 as Headcount_Exp,&#13;
0 as Acquisitions_Exp,&#13;
(Food_Acquisitions_Total - Food_Acquisitions_SSU - Food_Acquisitions_Field - Food_Acquisitions_Must_Have) as Acquisitions_Total,&#13;
0 as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
UNION ALL&#13;
select&#13;
month,&#13;
&apos;LATAM&apos; Country,&#13;
&apos;SSU&apos; as Seller_Channel,&#13;
SUM(Seller_Head_Count_SSU_Exp) as Headcount_Exp,&#13;
SUM(Food_Acquisitions_SSU_Exp) as Acquisitions_Exp,&#13;
SUM(Food_Acquisitions_SSU) as Acquisitions_Total,&#13;
SAFE_DIVIDE (SUM(Food_Acquisitions_SSU_Exp),SUM(Seller_Head_Count_SSU_Exp)) as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
group by 1,2,3&#13;
UNION ALL&#13;
select&#13;
month,&#13;
&apos;LATAM&apos; as Country,&#13;
&apos;Field&apos; as Seller_Channel,&#13;
SUM(Seller_Head_Count_Field_Exp) as Headcount_Exp,&#13;
SUM(Food_Acquisitions_Field_Exp) as Acquisitions_Exp,&#13;
SUM(Food_Acquisitions_Field) as Acquisitions_Total,&#13;
SAFE_DIVIDE (SUM(Food_Acquisitions_Field_Exp),SUM(Seller_Head_Count_Field_Exp)) as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
group by 1,2,3&#13;
UNION ALL&#13;
select&#13;
month,&#13;
&apos;LATAM&apos; as Country,&#13;
&apos;Must Have&apos; as Seller_Channel,&#13;
sum(Seller_Head_Count_Must_Have_Exp) as Headcount_Exp,&#13;
sum(Food_Acquisitions_Must_Have_Exp) as Acquisitions_Exp,&#13;
sum(Food_Acquisitions_Must_Have) as Acquisitions_Total,&#13;
SAFE_DIVIDE (sum(Food_Acquisitions_Must_Have_Exp),sum(Seller_Head_Count_Must_Have_Exp)) as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
group by 1,2,3&#13;
UNION ALL&#13;
select&#13;
month,&#13;
&apos;LATAM&apos; as Country,&#13;
&apos;Non Seller&apos; as Seller_Channel,&#13;
0 as Headcount_Exp,&#13;
0 as Acquisitions_Exp,&#13;
SUM(Food_Acquisitions_Total - Food_Acquisitions_SSU - Food_Acquisitions_Field - Food_Acquisitions_Must_Have) as Acquisitions_Total,&#13;
0 as Productivity_Exp&#13;
from&#13;
`peya-food-and-groceries.automated_tables_reports.Productivity`&#13;
GROUP BY 1,2,3&#13;
)&#13;
select * from acq</relation>
          <relation connection='bigquery.08em2xt16m0smw1ez4gxv1lfdsk4' name='Consulta SQL personalizada2' type='text'>SELECT  &#13;
  Month,&#13;
  Country_Name,&#13;
  Seller_Channel as Channel,&#13;
  COUNT(DISTINCT Partner_Id) AS total_partners,&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_1_H2 = &apos;Yes&apos; THEN Partner_Id END) AS partners_yes1,&#13;
  SAFE_DIVIDE(&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_1_H2 = &apos;Yes&apos; THEN Partner_Id END),&#13;
  COUNT(DISTINCT Partner_Id)&#13;
  ) * 100 AS percentage_yes_D1,&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_15_H2 = &apos;Yes&apos; THEN Partner_Id END) AS partners_yes15,&#13;
  SAFE_DIVIDE(&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_15_H2 = &apos;Yes&apos; THEN Partner_Id END),&#13;
  COUNT(DISTINCT Partner_Id)&#13;
  ) * 100 AS percentage_yes_D15,&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_30_H2 = &apos;Yes&apos; THEN Partner_Id END) AS partners_yes30,&#13;
  SAFE_DIVIDE(&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_30_H2 = &apos;Yes&apos; THEN Partner_Id END),&#13;
  COUNT(DISTINCT Partner_Id)&#13;
  ) * 100 AS percentage_yes_D30&#13;
FROM&#13;
  `peya-food-and-groceries.automated_tables_reports.Clasificacion_Adquisiciones`&#13;
WHERE&#13;
  Vertical = &apos;Food&apos;&#13;
GROUP BY&#13;
  Month, Country_Name, Channel&#13;
&#13;
&#13;
UNION ALL&#13;
&#13;
&#13;
SELECT  &#13;
  Month,&#13;
  &apos;LATAM&apos; as Country_Name,&#13;
  Seller_Channel as Channel,&#13;
  COUNT(DISTINCT Partner_Id) AS total_partners,&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_1_H2 = &apos;Yes&apos; THEN Partner_Id END) AS partners_yes1,&#13;
  SAFE_DIVIDE(&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_1_H2 = &apos;Yes&apos; THEN Partner_Id END),&#13;
  COUNT(DISTINCT Partner_Id)&#13;
  ) * 100 AS percentage_yes_D1,&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_15_H2 = &apos;Yes&apos; THEN Partner_Id END) AS partners_yes15,&#13;
  SAFE_DIVIDE(&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_15_H2 = &apos;Yes&apos; THEN Partner_Id END),&#13;
  COUNT(DISTINCT Partner_Id)&#13;
  ) * 100 AS percentage_yes_D15,&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_30_H2 = &apos;Yes&apos; THEN Partner_Id END) AS partners_yes30,&#13;
  SAFE_DIVIDE(&#13;
  COUNT(DISTINCT CASE WHEN Framework_Compliance_Day_30_H2 = &apos;Yes&apos; THEN Partner_Id END),&#13;
  COUNT(DISTINCT Partner_Id)&#13;
  ) * 100 AS percentage_yes_D30&#13;
FROM&#13;
  `peya-food-and-groceries.automated_tables_reports.Clasificacion_Adquisiciones`&#13;
WHERE&#13;
  Vertical = &apos;Food&apos;&#13;
GROUP BY&#13;
  Month, Country_Name, Channel</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
