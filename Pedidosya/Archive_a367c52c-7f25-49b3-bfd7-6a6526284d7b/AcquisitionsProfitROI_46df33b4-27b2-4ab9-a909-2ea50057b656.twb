      <aliases enabled='yes' />
      <column caption='Account Source' datatype='string' name='[AccountSource]' role='dimension' type='nominal' />
      <column caption='Active Rate M1' datatype='real' name='[Active Rate M0 (copia)_1469580895224782849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ActiveM1]) / SUM([Base_onlines])' />
      </column>
      <column caption='Active Rate M2' datatype='real' name='[Active Rate M1 (copia)_1469580895226122242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ActiveM2]) / SUM([Base_onlines])' />
      </column>
      <column caption='Business Type' datatype='string' name='[Business_Type]' role='dimension' type='nominal' />
      <column caption='CPA Canal' datatype='real' name='[CPA_Canal]' role='measure' type='quantitative' />
      <column caption='Orders / Total M0' datatype='real' name='[Calculation_1142225485295292416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([OrdersM0]) / SUM([OrdersTotalCompanyM0])' />
      </column>
      <column caption='Order Profit' datatype='real' name='[Calculation_1196268670463123456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[take_in]+[cpo]' />
      </column>
      <column caption='framework D1' datatype='real' name='[Calculation_1319836207637950464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partners_yes1]) / SUM ([total_partners])' />
      </column>
      <column caption='Productividad_Overall' datatype='real' name='[Calculation_1516024243756609536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisitions_Total])/SUM([Headcount_Exp])' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_1632554877387018242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Net' datatype='real' name='[Calculation_1858579282543857664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([take_in]) + SUM ([ncr_profit]) + SUM([cpo]) + SUM ([Calculation_93168229057552384])' />
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_93168229057552384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='- [CPA_Canal]' />
      </column>
      <column caption='RUNNING_SUM_PROFIT' datatype='real' name='[Calculation_93168229058736129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_1858579282543857664])'>
          <table-calc ordering-type='Rows' />
        </calculation>
