              <calculation class='tableau' formula='(SUM([late_more_than_10])/SUM([total_orders_OD]))*100' />
            </column>
            <column caption='AVG DT' datatype='real' default-format='n#,##0;-#,##0' name='[% Late &gt;10 min (copy)_2165668506198212609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time])/SUM([total_orders_OD])' />
            </column>
            <column caption='% Orders with Shrink (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Orders with Shrink (copy)_199847269190242330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_2165668506230525969])/SUM([total_orders]))*100' />
            </column>
            <column caption='% Slow Delivery (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Slow Delivery (copy)_199847269190287387]' role='measure' type='quantitative'>
