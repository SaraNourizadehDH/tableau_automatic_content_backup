          <alias key='&quot;[federated.0bqjgpq1bnau4w19jocq915vo0uh].[usr:Calculation_2165668506231164946:qk]&quot;' value='% Orders with Shrink*' />
        </aliases>
      </column>
      <column caption='AVG Action Value per Order (copy)' datatype='real' default-format='n#,##0;-#,##0' name='[AVG Action Value per Order (copy)_249949817991651340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([action_value_int])/SUM([Calculation_2165668506230525969])' />
      </column>
      <column caption='AVG Action Value per Order' datatype='real' default-format='n#,##0;-#,##0' name='[AVG Driving Time per Session (copy)_2165668506244542489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([action_value_int])/SUM([Calculation_2165668506230525969])' />
      </column>
      <column caption='Business Type (copy)' datatype='string' name='[Business Type (copy)_2165668506199937034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[business_type]' />
      </column>
      <column caption='CVR (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CVR (copy)_199847269189070861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_transactions])/SUM([total_sessions]))*100' />
      </column>
      <column caption='CVR2 (copy)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CVR2 (copy)_199847269189185550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([CVR2])/SUM([CVR2_sessions]))*100' />
      </column>
      <column caption='CVR3' datatype='real' default-format='p0.00%' name='[CVR2 (copy)_2165668506293043227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CVR3])/SUM([CVR3_sessions])' />
      </column>
      <column caption='CVR4' datatype='real' default-format='p0.00%' name='[CVR2 (copy)_2165668506293104668]' role='measure' type='quantitative'>
