    <worksheet name='Overall ORDERS KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='10'>Order KPIs Overall</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='FULL QUERY' name='federated.0bqjgpq1bnau4w19jocq915vo0uh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Fail Rate Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fail Rate&quot;'>
              <calculation class='tableau' formula='&quot;Fail Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bqjgpq1bnau4w19jocq915vo0uh'>
            <column caption='AVG DT' datatype='real' default-format='n#,##0;-#,##0' name='[% Late &gt;10 min (copy)_2165668506198212609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time])/SUM([total_orders_OD])' />
            </column>
            <column caption='AVG Dropoff Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1637058500117110784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_distance_manhattan]/1000)/SUM([total_orders_OD])' />
            </column>
            <column caption='% Late &gt;10' datatype='real' default-format='p0.00%' name='[Calculation_2165668506198065152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_more_than_10])/SUM([total_orders_OD])' />
            </column>
            <column caption='AVG TES PDT' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2165668506198388738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([TES_PDT])/SUM([total_orders_OD])' />
            </column>
            <column caption='AVG CPO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2165668506198560771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cpo_local_currency])/SUM([total_orders_OD])' />
            </column>
            <column caption='AVG DF Local' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2165668506198667268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_delivery_fee_local])/SUM([total_orders_OD])' />
            </column>
            <column caption='Session Rate' datatype='real' default-format='p0.00%' name='[Calculation_2165668506198859781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([helpcenter_sessions])/SUM([total_orders])' />
            </column>
            <column caption='Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_2165668506198974470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts])/SUM([total_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2165668506199093255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_confirmed_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Slow Delivery' datatype='real' default-format='p0.00%' name='[Calculation_2165668506199531529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([slow_delivery])/SUM([total_orders_OD])' />
            </column>
            <column caption='AVG SURGE Local' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2165668506200072203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_surge_fee_local])/SUM([total_orders_SURGE])' />
            </column>
            <column caption='Order KPI' datatype='real' name='[Calculation_2165668506212806668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Fail Rate Parameter]=&apos;Fail Rate&apos; THEN [Calculation_2165668506199093255]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;Session Rate&apos; THEN [Calculation_2165668506198859781]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;Contact Rate&apos; THEN [Calculation_2165668506198974470]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;AVG DT&apos; THEN [% Late &gt;10 min (copy)_2165668506198212609]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;AVG TES PDT&apos; THEN [Calculation_2165668506198388738]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;% Late &gt;10&apos; THEN [Calculation_2165668506198065152]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;% Slow Delivery&apos; THEN [Calculation_2165668506199531529]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;AVG CPO&apos; THEN [Calculation_2165668506198560771]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;AVG DF Local&apos; THEN [Calculation_2165668506198667268]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;AVG SURGE Local&apos; THEN [Calculation_2165668506200072203]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;Dropoff Distance&apos; THEN [Calculation_1637058500117110784]&#13;&#10;ELSEIF [Parameters].[Fail Rate Parameter]=&apos;Orders&apos; THEN SUM([total_orders])&#13;&#10;END' />
            </column>
            <column caption='Country (copy)' datatype='string' name='[Country (copy)_562949990293504004]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[session_country]' />
            </column>
            <column caption='Session City (copy)' datatype='string' name='[Session City (copy)_1368531373902708736]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='[session_city]' />
            </column>
            <column caption='Tes Pdt' datatype='real' name='[TES_PDT]' role='measure' type='quantitative' />
            <column caption='Action Value' datatype='string' name='[action_value]' role='dimension' type='nominal' />
            <column caption='Actual Delivery Time' datatype='real' name='[actual_delivery_time]' role='measure' type='quantitative' />
            <column caption='Business Type' datatype='string' name='[business_type]' role='dimension' type='nominal' />
