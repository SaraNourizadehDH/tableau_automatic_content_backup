        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0obaqoo07vd21d15t5ltb1r4ldn2' name='Consulta SQL personalizada' type='text'>SELECT country&#13;
  , lower(city) as city&#13;
  , address&#13;
  , extract (month from date) as month&#13;
  , count(distinct lower(peya_name)) as peya_partners&#13;
  , count(distinct lower(rappi_name)) as rappi_partners&#13;
  , count(distinct lower(ubereats_name)) as uber_partners&#13;
  FROM `peya-bi-tools-pro.il_scraping.dim_competitor_historical`&#13;
  WHERE date   BETWEEN &apos;2023-03-01&apos; AND &apos;2023-05-31&apos;&#13;
  --and address =&apos;Av San Josemaría Escrivá de Balaguer 9055&apos;&#13;
  group by 1,2,3,4&#13;
  order by 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
