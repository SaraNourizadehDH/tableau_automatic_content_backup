              <calculation class='tableau' formula='IF [Calculation_1595681662703828992] &lt; IFNULL([Calculation_1595681662703828992 1],999999) AND [Calculation_1595681662703828992] &lt; IFNULL([Calculation_1595681662703828992 1 1],999999) THEN TRUE ELSE FALSE END' />
