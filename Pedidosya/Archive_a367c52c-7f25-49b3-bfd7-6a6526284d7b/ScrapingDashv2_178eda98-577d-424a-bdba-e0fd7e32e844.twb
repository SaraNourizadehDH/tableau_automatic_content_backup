      <aliases enabled='yes' />
      <column caption='# city' datatype='string' name='[# address (copia)_2435603007651106821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF month = 5 THEN [city] END' />
      </column>
      <column caption='LatestMonth' datatype='integer' name='[Calculation_2435603007647379456]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([month])' />
      </column>
      <column caption='# address' datatype='string' name='[Calculation_2435603007648468993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF month = 5 THEN [address] END' />
      </column>
      <column caption='vs_Rappi' datatype='integer' name='[Calculation_2435603007648722946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [peya_partners]&gt;[rappi_partners] then 1 else 0 end' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Consulta SQL personalizada' datatype='table' name='[__tableau_internal_object_id__].[_4CADFFB2F96C49738BB5E39A34242068]' role='measure' type='quantitative' />
      <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' name='[month]' role='dimension' type='ordinal'>
        <aliases>
          <alias key='3' value='March' />
          <alias key='4' value='April' />
          <alias key='5' value='May' />
        </aliases>
      </column>
      <column caption='vs_rappi_city_fix' datatype='integer' name='[prueba_vs_rappi (copia)_2435603007660253191]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ FIXED [city] , [month]: IF sum([peya_partners]) &gt; sum([rappi_partners]) then 1 else 0 end})' />
      </column>
      <column caption='vs_Rappi_and_uber' datatype='integer' name='[vs_Rappi (copia)_2435603007648792579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [peya_partners]&gt;[uber_partners] and [peya_partners]&gt;[rappi_partners]then 1 else 0 end' />
      </column>
      <column caption='vs_uber' datatype='integer' name='[vs_Rappi (copia)_2435603007648907268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF country in (&apos;Argentina&apos; , &apos;Perú&apos;, &apos;Uruguay&apos;) then null elseif [peya_partners]&gt;[uber_partners] then 1 else 0 end' />
      </column>
      <column caption='vs_uber_city_fix' datatype='integer' name='[vs_both_city_fix (copia)_2435603007690059785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum ( IF  [country] in(&apos;Uruguay&apos;, &apos;Argentina&apos; , &apos;Perú&apos; ) THEN NULL&#13;&#10;ELSE { FIXED [city], [month] : IF SUM([peya_partners]) &gt; SUM([uber_partners]) THEN 1 ELSE 0 END }&#13;&#10;END)' />
      </column>
      <column caption='vs_both_city_fix' datatype='integer' name='[vs_rappi_city_fix (copia)_2435603007661322248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ FIXED [city] , [month]: IF sum([peya_partners]) &gt; sum([uber_partners]) and sum([peya_partners]) &gt; SUM([rappi_partners]) then  1 else 0 end})' />
      </column>
      <drill-paths>
        <drill-path name='country, city'>
          <field>[country]</field>
          <field>[city]</field>
        </drill-path>
      </drill-paths>
