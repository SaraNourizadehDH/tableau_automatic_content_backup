          <alias key='&quot;[federated.0f0g0xf06vck1l186klgu1cdzdwy].[usr:qty_rappi_partners_calc (copy)_1274518719922233346:qk]&quot;' value='# Uber Eats' />
        </aliases>
      </column>
      <column caption='Share Peya' datatype='real' name='[Calculation_1270296597082394624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1274518719922020352] / ( [Calculation_1274518719922020352] + [qty_peya_partners_calc (copy)_1274518719922135041] + [qty_rappi_partners_calc (copy)_1274518719922233346] )' />
      </column>
      <column caption='qty_peya_partners_calc' datatype='integer' name='[Calculation_1274518719922020352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([peya_name])' />
      </column>
      <column caption='fixed_sum_quantity' datatype='integer' name='[Calculation_1274518719947509768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country],[city],[zone_name] : COUNTD([peya_name]) }&#13;&#10;+&#13;&#10;{ FIXED [country],[city],[zone_name] : COUNTD([rappi_name]) }&#13;&#10;+&#13;&#10;{ FIXED [country],[city],[zone_name] : COUNTD([ubereats_name]) }' />
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_1553460423199891456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='blanck' datatype='string' name='[Calculation_1707427238309863428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Qty Zones' datatype='integer' name='[Calculation_1707427238316175366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([zone_name])' />
      </column>
      <column caption='Last Completed Week' datatype='boolean' name='[Calculation_376050596701700096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[week] = DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))' />
      </column>
      <column caption='Peya Name' datatype='string' name='[Calculation_770959987638128641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([peya_name],&quot;ND&quot;)' />
      </column>
      <column caption='peya_is_greater' datatype='boolean' name='[Calculation_976155245357993984]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1274518719922020352] &gt; [qty_peya_partners_calc (copy)_1274518719922135041] AND [Calculation_1274518719922020352] &gt; [qty_rappi_partners_calc (copy)_1274518719922233346] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Partner Name&apos;s in Competitor&apos;s app' datatype='string' name='[Calculation_976155245363634177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Rappi&quot; THEN&#13;&#10;IFNULL([rappi_name],&quot;ND&quot;)&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Uber Eats&quot; THEN&#13;&#10;IFNULL([ubereats_name],&quot;ND&quot;)&#13;&#10;ELSE &quot;&quot; END' />
      </column>
      <column caption='Qty Scrapped Competitor' datatype='integer' name='[Competitor Name (copy)_770959987637592064]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Rappi&quot; THEN&#13;&#10;COUNT([rappi_name])&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Uber Eats&quot; THEN&#13;&#10;COUNT([ubereats_name])&#13;&#10;ELSE 0 END' />
      </column>
      <column caption='Qty Scrapped Peya' datatype='integer' name='[Qty Scrapped Competitor (copy)_770959987638964226]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT([peya_name])' />
      </column>
      <column caption='Qty Zones Won' datatype='integer' name='[Qty Zones (copy)_1707427238317707272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE  [country],[zone_name] : ( IF [Calculation_976155245357993984] = TRUE THEN 1 END)}' />
      </column>
      <column caption='Zones Won Share' datatype='real' name='[Qty Zones Won (copy)_1707427238326116361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty Zones (copy)_1707427238317707272]) / ([Calculation_1707427238316175366])' />
      </column>
      <column caption='Share With UberEats' datatype='real' name='[Share With Rappi (copy)_770959987689394185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[qty_peya_partners_calc_share_both_rappi (copy)_770959987680088069] / [Calculation_1274518719922020352]' />
