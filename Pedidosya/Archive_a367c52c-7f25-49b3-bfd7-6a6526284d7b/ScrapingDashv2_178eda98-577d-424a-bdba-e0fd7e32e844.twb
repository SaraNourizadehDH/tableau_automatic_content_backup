    <worksheet name='DF - City'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Avg. Delivery Fee By City</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Main Query' name='federated.0q8054d034f9101by9hmo0hkgxi8' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Excluding DF = 0' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;USD&quot;'>
              <calculation class='tableau' formula='&quot;USD&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q8054d034f9101by9hmo0hkgxi8'>
            <column caption='peya_is_lower' datatype='boolean' name='[Calculation_1010495196319981568]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1595681662703828992] &lt; IFNULL([Calculation_1595681662703828992 1],999999) AND [Calculation_1595681662703828992] &lt; IFNULL([Calculation_1595681662703828992 1 1],999999) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Last Completed Week' datatype='boolean' name='[Calculation_1010495196331978753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([week_date]) = (DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))' />
            </column>
            <column caption='Avg Uber  Delivery Fee ' datatype='real' name='[Calculation_1595681662703828992 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local Currency&quot; THEN&#13;&#10;sum([ubereats_delivery_fee])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Euro&quot; THEN&#13;&#10;sum([ubereats_delivery_fee_euro])&#13;&#10;ELSE&#13;&#10;sum([ubereats_delivery_fee_usd]) END&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;IF [Parameters].[Parameter 2] = FALSE THEN&#13;&#10;sum([qubereats_delivery_fee])&#13;&#10;ELSE&#13;&#10;sum([t_ubereats_partner_fd_excluding_0])&#13;&#10;END' />
            </column>
            <column caption='Avg Rappi  Delivery Fee ' datatype='real' name='[Calculation_1595681662703828992 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local Currency&quot; THEN&#13;&#10;sum([rappi_delivery_fee])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Euro&quot; THEN&#13;&#10;sum([rappi_delivery_fee_euro])&#13;&#10;ELSE&#13;&#10;sum([rappi_delivery_fee_usd]) END&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;IF [Parameters].[Parameter 2] = FALSE THEN&#13;&#10;sum([qrappi_delivery_fee])&#13;&#10;ELSE&#13;&#10;sum([t_rappi_partner_fd_excluding_0])&#13;&#10;END' />
            </column>
            <column caption='Avg Peya Delivery Fee' datatype='real' name='[Calculation_1595681662703828992]' role='measure' type='quantitative'>
