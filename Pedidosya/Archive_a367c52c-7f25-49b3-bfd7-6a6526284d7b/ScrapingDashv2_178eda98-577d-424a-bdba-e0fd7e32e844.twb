            <properties context=''>
              <relation connection='bigquery.1qcv71k1ex6ahm1b0geyb0d8m1u4' name='Custom SQL Query' type='text'>SELECT *,&#13;
       DATE(CURRENT_DATE - 1) as date_up_to&#13;
FROM `peya-markets.automated_tables_reports.fact_tableau_scraping_delivery`&#13;
WHERE week_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE, WEEK(MONDAY)), INTERVAL 18 WEEK)</relation>
