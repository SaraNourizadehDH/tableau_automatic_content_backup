              <calculation class='tableau' formula='([week_date]) = (DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())))' />
            </column>
            <column caption='Avg Uber  Delivery Fee ' datatype='real' name='[Calculation_1595681662703828992 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Local Currency&quot; THEN&#13;&#10;sum([ubereats_delivery_fee])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Euro&quot; THEN&#13;&#10;sum([ubereats_delivery_fee_euro])&#13;&#10;ELSE&#13;&#10;sum([ubereats_delivery_fee_usd]) END&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;IF [Parameters].[Parameter 2] = FALSE THEN&#13;&#10;sum([qubereats_delivery_fee])&#13;&#10;ELSE&#13;&#10;sum([t_ubereats_partner_fd_excluding_0])&#13;&#10;END' />
