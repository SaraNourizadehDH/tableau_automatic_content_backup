    <datasource caption='Consulta_SQL_personalizada (automated_tables_reports)' inline='true' name='federated.01j645u13uvim61acos6n0qx06fi' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0i4fcz31fbvwe6187h07z0v9buz3'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='automated_tables_reports' server-oauth='' username='constantino.dimartino@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0i4fcz31fbvwe6187h07z0v9buz3' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH
dates as (
    SELECT current_date()-45 as date_from),
orders as
  (SELECT
    ord.country_code,
    DATE(del.rider_dropped_off_at, ord.timezone) AS date_local,
    ord.city.city_id,
    ord.zone.zone_id,
    COUNT(IF(del.delivery_status = 'completed' and ord.is_preorder = FALSE, ord.order_id, NULL)) AS orders_completed,
    COUNT(IF(del.delivery_status = 'completed', ord.order_id, NULL)) AS orders_completed_w_preorders,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.actual_delivery_time)/60,0)) AS sum_actual_delivery_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.rider_accepting_time)/60,0)) AS sum_accepting_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.to_vendor_time)/60,0)) AS sum_to_vendor_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.at_vendor_time)/60,0)) AS sum_at_vendor_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.to_customer_time)/60,0)) AS sum_to_customer_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.at_customer_time)/60,0)) AS sum_at_customer_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.promised_delivery_time)/60,0)) AS sum_promised_delivery_time,
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay/60>>10 THEN ord.peya_order_id ELSE NULL END) AS order_late_10,
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS order_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.rider_accepting_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS accepting_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.to_vendor_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS to_vendor_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.at_vendor_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS at_vendor_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.to_customer_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS to_customer_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay IS NOT NULL THEN ord.peya_order_id ELSE NULL END) AS order_delay_base,
    COUNT(DISTINCT CASE WHEN ord.timings.actual_delivery_time/60<<20 THEN ord.order_id ELSE NULL END) AS order_under_20,
    COUNT(DISTINCT CASE WHEN ord.timings.actual_delivery_time/60<<15 THEN ord.order_id ELSE NULL END) AS order_under_15,
    sum(IF(ord.is_preorder = FALSE, (CASE WHEN del.stacked_deliveries >>= 1 THEN 1 ELSE 0 END),0)) AS stacked,
    sum(IF(ord.is_preorder = FALSE, (ord.estimated_prep_time)/60,0)) AS estimated_prep_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.assumed_actual_preparation_time)/60,0)) AS assumed_actual_prep_time,
    COUNT(DISTINCT CASE WHEN ord.is_vendor_late_10 = 1 THEN ord.order_id ELSE NULL END) AS vendor_late_10,
    COUNT(DISTINCT CASE WHEN ord.timings.vendor_late IS NOT NULL THEN ord.peya_order_id ELSE NULL END) AS vendor_late_not_null,
    COUNT(DISTINCT CASE WHEN del.timings.rider_late/60>>10 THEN del.delivery_id ELSE NULL END) AS rider_late_10,
    COUNT(DISTINCT CASE WHEN del.timings.rider_late IS NOT NULL THEN del.delivery_id ELSE NULL END) AS rider_late_not_null,
    sum(IF(ord.is_preorder = FALSE, ord.timings.order_delay/60,0)) AS sum_order_delay,
    sum(del.pickup_distance_manhattan) as sum_pickup_distance,
    sum(del.dropoff_distance_manhattan) as sum_dropoff_distance,
    sum(CASE WHEN ord.order_status = 'cancelled' THEN 1 ELSE 0 END) AS orders_cancelled,
    sum( CASE WHEN ord.order_status = 'cancelled' AND ord.cancellation.reason IN ('TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_RIDER_ACCIDENT','TRAFFIC_MANAGER_WEATHER_ISSUE','WRONG_ORDER_ITEMS_DELIVERED','COURIER_UNREACHABLE','NEVER_DELIVERED','BAD_WEATHER','UNPROFESSIONAL_BEHAVIOUR','COURIER_ACCIDENT','DELIVERY_ETA_TOO_LONG','LATE_DELIVERY','NO_COURIER') THEN 1 ELSE 0 END) as orders_cancelled_logistics,
    sum( CASE WHEN ord.order_status = 'cancelled' AND ord.cancellation.reason IN ('TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_NO_RIDER','NO_COURIER') THEN 1 ELSE 0 END) as orders_cancelled_logistics_rider,
    sum(case when state="accepted" then 1 else 0 end) as orders_accepted,
    sum(case when state="courier_notified"then 1 else 0 end) as orders_notified
  FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` ord, dates
  LEFT JOIN UNNEST(deliveries) AS del ON is_primary
  INNER JOIN UNNEST(transitions) AS tran
  WHERE ord.created_date BETWEEN date_from and current_date() 
    AND ord.created_date_local BETWEEN  date_from and CURRENT_DATE
  GROUP BY
    ord.country_code,
    DATE(del.rider_dropped_off_at, ord.timezone),
    ord.city.city_id,
    ord.zone.zone_id),
shifts as
  (SELECT
    country_code,
    e.day AS last_date_shifts,
    city.city_id,
    zone.zone_id,
    ROUND(SUM(CASE WHEN  shifts.shift_state = 'EVALUATED' THEN (e.duration / 60 / 60) ELSE NULL END)) AS sum_actual_evaluated_working_hours,
    count(DISTINCT CASE WHEN shifts.shift_state != 'CANCELLED' THEN shifts.shift_id ELSE NULL END) AS sum_shifts_planned,
    coalesce(sum(CASE WHEN shifts.shift_state = 'NO_SHOW' THEN DATETIME_DIFF(DATETIME (shifts.shift_start_at), DATETIME (shifts.shift_end_at), HOUR) END),0) AS sum_planned_no_show_working_hours,
    coalesce(sum(CASE WHEN shifts.shift_state != 'CANCELLED' THEN DATETIME_DIFF(DATETIME (shifts.shift_start_at), DATETIME (shifts.shift_end_at), HOUR) END),0) AS sum_planned_all_working_hours
  FROM `peya-bi-tools-pro.il_logistics.fact_logistic_shifts` shifts, dates
  LEFT JOIN UNNEST(shifts.actual_working_time_by_date) e
  WHERE DATE(shifts.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE-60, interval -1 month), month)-1
    AND e.day << CURRENT_DATE()
    AND DATE(DATETIME(shifts.created_at,shifts.timezone)) BETWEEN  DATE_TRUNC(DATE_ADD(CURRENT_DATE, interval -2 month), month) and CURRENT_DATE
    AND shift_state NOT IN ('CANCELLED')
  GROUP BY 1,2,3,4),
staffing_kpi as
  (SELECT
    country_code,
    created_date_local as date_local,
    city_id,
    zone_id,
    SUM(open_slots_assigned) slots_assigned,
    SUM(open_slots_size) slots_open,
    SUM(planned_shift_duration / 3600) AS shift_hours,
    SUM(no_shows_duration / 3600) AS ns_hours,
    SUM(excused_no_shows_duration / 3600) AS excused_ns_hours,
    SUM(orders_actuals) as orders_actuals,
    SUM(close_orders_lost_net) as close_orders_lost_net,
    SUM(shrink_orders_lost_net) as shrink_orders_lost_net,
    SUM(adjusted_orders) as adjusted_orders
   FROM `peya-data-origins-pro.cl_hurrier.staffing_kpi`, dates
   WHERE created_date_local BETWEEN date_from and CURRENT_DATE
   GROUP BY 1,2,3,4)
SELECT 
    orders.date_local,
    orders.orders_completed_w_preorders,
    geo.city_name,
    geo.zone_name,
    geo.country_name,
    orders_completed,
    sum_actual_delivery_time,
    sum_accepting_time,
    accepting_time_late_25,
    sum_to_vendor_time,
    to_vendor_time_late_25,
    sum_at_vendor_time,
    at_vendor_time_late_25,
    sum_to_customer_time,
    to_customer_time_late_25,
    sum_at_customer_time,
    sum_promised_delivery_time,
    order_late_10,
    order_late_25,
    order_delay_base,
    order_under_20,
    order_under_15,
    stacked,
    estimated_prep_time,
    assumed_actual_prep_time,
    vendor_late_10,
    vendor_late_not_null,
    rider_late_10,
    rider_late_not_null,
    sum_order_delay,
    sum_pickup_distance,
    sum_dropoff_distance,
    orders_cancelled,
    orders_cancelled_logistics,
    orders_cancelled_logistics_rider,
    orders_accepted,
    orders_notified,
    sum_actual_evaluated_working_hours,
    sum_shifts_planned,
    sum_planned_no_show_working_hours,
    sum_planned_all_working_hours,
    slots_assigned,
    slots_open,
    shift_hours,
    ns_hours,
    excused_ns_hours,
    orders_actuals,
    close_orders_lost_net,
    shrink_orders_lost_net,
    adjusted_orders,
FROM orders
JOIN shifts ON (orders.country_code = shifts.country_code
    AND orders.date_local = shifts.last_date_shifts
    AND orders.city_id = shifts.city_id
    AND orders.zone_id = shifts.zone_id)
JOIN staffing_kpi ON (orders.country_code = staffing_kpi.country_code
    AND orders.date_local = staffing_kpi.date_local
    AND orders.city_id = staffing_kpi.city_id
    AND orders.zone_id = staffing_kpi.zone_id)

JOIN (SELECT
        countries.country_code, 
        countries.country_name,
        cities.id as city_id,
        cities.name as city_name,
        zones.id as zone_id,
        zones.name as zone_name
    FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries,
        UNNEST(cities) cities,
        UNNEST(zones) zones
    )geo ON (orders.country_code = geo.country_code
        AND orders.city_id = geo.city_id
        AND orders.zone_id = geo.zone_id)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0i4fcz31fbvwe6187h07z0v9buz3' name='Consulta_SQL_personalizada' type='text'><![CDATA[WITH
dates as (
    SELECT current_date()-45 as date_from),
orders as
  (SELECT
    ord.country_code,
    DATE(del.rider_dropped_off_at, ord.timezone) AS date_local,
    ord.city.city_id,
    ord.zone.zone_id,
    COUNT(IF(del.delivery_status = 'completed' and ord.is_preorder = FALSE, ord.order_id, NULL)) AS orders_completed,
    COUNT(IF(del.delivery_status = 'completed', ord.order_id, NULL)) AS orders_completed_w_preorders,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.actual_delivery_time)/60,0)) AS sum_actual_delivery_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.rider_accepting_time)/60,0)) AS sum_accepting_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.to_vendor_time)/60,0)) AS sum_to_vendor_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.at_vendor_time)/60,0)) AS sum_at_vendor_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.to_customer_time)/60,0)) AS sum_to_customer_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.at_customer_time)/60,0)) AS sum_at_customer_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.promised_delivery_time)/60,0)) AS sum_promised_delivery_time,
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay/60>>10 THEN ord.peya_order_id ELSE NULL END) AS order_late_10,
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS order_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.rider_accepting_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS accepting_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.to_vendor_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS to_vendor_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.at_vendor_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS at_vendor_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.to_customer_time/60>>25 AND ord.timings.order_delay/60>>25 THEN ord.peya_order_id ELSE NULL END) AS to_customer_time_late_25,
    COUNT(DISTINCT CASE WHEN ord.timings.order_delay IS NOT NULL THEN ord.peya_order_id ELSE NULL END) AS order_delay_base,
    COUNT(DISTINCT CASE WHEN ord.timings.actual_delivery_time/60<<20 THEN ord.order_id ELSE NULL END) AS order_under_20,
    COUNT(DISTINCT CASE WHEN ord.timings.actual_delivery_time/60<<15 THEN ord.order_id ELSE NULL END) AS order_under_15,
    sum(IF(ord.is_preorder = FALSE, (CASE WHEN del.stacked_deliveries >>= 1 THEN 1 ELSE 0 END),0)) AS stacked,
    sum(IF(ord.is_preorder = FALSE, (ord.estimated_prep_time)/60,0)) AS estimated_prep_time,
    sum(IF(ord.is_preorder = FALSE, (ord.timings.assumed_actual_preparation_time)/60,0)) AS assumed_actual_prep_time,
    COUNT(DISTINCT CASE WHEN ord.is_vendor_late_10 = 1 THEN ord.order_id ELSE NULL END) AS vendor_late_10,
    COUNT(DISTINCT CASE WHEN ord.timings.vendor_late IS NOT NULL THEN ord.peya_order_id ELSE NULL END) AS vendor_late_not_null,
    COUNT(DISTINCT CASE WHEN del.timings.rider_late/60>>10 THEN del.delivery_id ELSE NULL END) AS rider_late_10,
    COUNT(DISTINCT CASE WHEN del.timings.rider_late IS NOT NULL THEN del.delivery_id ELSE NULL END) AS rider_late_not_null,
    sum(IF(ord.is_preorder = FALSE, ord.timings.order_delay/60,0)) AS sum_order_delay,
    sum(del.pickup_distance_manhattan) as sum_pickup_distance,
    sum(del.dropoff_distance_manhattan) as sum_dropoff_distance,
    sum(CASE WHEN ord.order_status = 'cancelled' THEN 1 ELSE 0 END) AS orders_cancelled,
    sum( CASE WHEN ord.order_status = 'cancelled' AND ord.cancellation.reason IN ('TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_RIDER_ACCIDENT','TRAFFIC_MANAGER_WEATHER_ISSUE','WRONG_ORDER_ITEMS_DELIVERED','COURIER_UNREACHABLE','NEVER_DELIVERED','BAD_WEATHER','UNPROFESSIONAL_BEHAVIOUR','COURIER_ACCIDENT','DELIVERY_ETA_TOO_LONG','LATE_DELIVERY','NO_COURIER') THEN 1 ELSE 0 END) as orders_cancelled_logistics,
    sum( CASE WHEN ord.order_status = 'cancelled' AND ord.cancellation.reason IN ('TRAFFIC_MANAGER_NO_RIDER','TRAFFIC_MANAGER_NO_RIDER','NO_COURIER') THEN 1 ELSE 0 END) as orders_cancelled_logistics_rider,
    sum(case when state="accepted" then 1 else 0 end) as orders_accepted,
    sum(case when state="courier_notified"then 1 else 0 end) as orders_notified
  FROM `peya-bi-tools-pro.il_logistics.fact_logistic_orders` ord, dates
  LEFT JOIN UNNEST(deliveries) AS del ON is_primary
  INNER JOIN UNNEST(transitions) AS tran
  WHERE ord.created_date BETWEEN date_from and current_date() 
    AND ord.created_date_local BETWEEN  date_from and CURRENT_DATE
  GROUP BY
    ord.country_code,
    DATE(del.rider_dropped_off_at, ord.timezone),
    ord.city.city_id,
    ord.zone.zone_id),
shifts as
  (SELECT
    country_code,
    e.day AS last_date_shifts,
    city.city_id,
    zone.zone_id,
    ROUND(SUM(CASE WHEN  shifts.shift_state = 'EVALUATED' THEN (e.duration / 60 / 60) ELSE NULL END)) AS sum_actual_evaluated_working_hours,
    count(DISTINCT CASE WHEN shifts.shift_state != 'CANCELLED' THEN shifts.shift_id ELSE NULL END) AS sum_shifts_planned,
    coalesce(sum(CASE WHEN shifts.shift_state = 'NO_SHOW' THEN DATETIME_DIFF(DATETIME (shifts.shift_start_at), DATETIME (shifts.shift_end_at), HOUR) END),0) AS sum_planned_no_show_working_hours,
    coalesce(sum(CASE WHEN shifts.shift_state != 'CANCELLED' THEN DATETIME_DIFF(DATETIME (shifts.shift_start_at), DATETIME (shifts.shift_end_at), HOUR) END),0) AS sum_planned_all_working_hours
  FROM `peya-bi-tools-pro.il_logistics.fact_logistic_shifts` shifts, dates
  LEFT JOIN UNNEST(shifts.actual_working_time_by_date) e
  WHERE DATE(shifts.created_date) >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE-60, interval -1 month), month)-1
    AND e.day << CURRENT_DATE()
    AND DATE(DATETIME(shifts.created_at,shifts.timezone)) BETWEEN  DATE_TRUNC(DATE_ADD(CURRENT_DATE, interval -2 month), month) and CURRENT_DATE
    AND shift_state NOT IN ('CANCELLED')
  GROUP BY 1,2,3,4),
staffing_kpi as
  (SELECT
    country_code,
    created_date_local as date_local,
    city_id,
    zone_id,
    SUM(open_slots_assigned) slots_assigned,
    SUM(open_slots_size) slots_open,
    SUM(planned_shift_duration / 3600) AS shift_hours,
    SUM(no_shows_duration / 3600) AS ns_hours,
    SUM(excused_no_shows_duration / 3600) AS excused_ns_hours,
    SUM(orders_actuals) as orders_actuals,
    SUM(close_orders_lost_net) as close_orders_lost_net,
    SUM(shrink_orders_lost_net) as shrink_orders_lost_net,
    SUM(adjusted_orders) as adjusted_orders
   FROM `peya-data-origins-pro.cl_hurrier.staffing_kpi`, dates
   WHERE created_date_local BETWEEN date_from and CURRENT_DATE
   GROUP BY 1,2,3,4)
SELECT 
    orders.date_local,
    orders.orders_completed_w_preorders,
    geo.city_name,
    geo.zone_name,
    geo.country_name,
    orders_completed,
    sum_actual_delivery_time,
    sum_accepting_time,
    accepting_time_late_25,
    sum_to_vendor_time,
    to_vendor_time_late_25,
    sum_at_vendor_time,
    at_vendor_time_late_25,
    sum_to_customer_time,
    to_customer_time_late_25,
    sum_at_customer_time,
    sum_promised_delivery_time,
    order_late_10,
    order_late_25,
    order_delay_base,
    order_under_20,
    order_under_15,
    stacked,
    estimated_prep_time,
    assumed_actual_prep_time,
    vendor_late_10,
    vendor_late_not_null,
    rider_late_10,
    rider_late_not_null,
    sum_order_delay,
    sum_pickup_distance,
    sum_dropoff_distance,
    orders_cancelled,
    orders_cancelled_logistics,
    orders_cancelled_logistics_rider,
    orders_accepted,
    orders_notified,
    sum_actual_evaluated_working_hours,
    sum_shifts_planned,
    sum_planned_no_show_working_hours,
    sum_planned_all_working_hours,
    slots_assigned,
    slots_open,
    shift_hours,
    ns_hours,
    excused_ns_hours,
    orders_actuals,
    close_orders_lost_net,
    shrink_orders_lost_net,
    adjusted_orders,
FROM orders
JOIN shifts ON (orders.country_code = shifts.country_code
    AND orders.date_local = shifts.last_date_shifts
    AND orders.city_id = shifts.city_id
    AND orders.zone_id = shifts.zone_id)
JOIN staffing_kpi ON (orders.country_code = staffing_kpi.country_code
    AND orders.date_local = staffing_kpi.date_local
    AND orders.city_id = staffing_kpi.city_id
    AND orders.zone_id = staffing_kpi.zone_id)

JOIN (SELECT
        countries.country_code, 
        countries.country_name,
        cities.id as city_id,
        cities.name as city_name,
        zones.id as zone_id,
        zones.name as zone_name
    FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries,
        UNNEST(cities) cities,
        UNNEST(zones) zones
    )geo ON (orders.country_code = geo.country_code
        AND orders.city_id = geo.city_id
        AND orders.zone_id = geo.zone_id)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
