          <bin default-name='false' value='&quot;LOW&quot;'>
            <value>%null%</value>
            <value>&quot;New&quot;</value>
            <value>&quot;Onboarded&quot;</value>
            <value>&quot;Prospect&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;MID&quot;'>
            <value>&quot;Stable&quot;</value>
          </bin>
        </calculation>
      </column>
