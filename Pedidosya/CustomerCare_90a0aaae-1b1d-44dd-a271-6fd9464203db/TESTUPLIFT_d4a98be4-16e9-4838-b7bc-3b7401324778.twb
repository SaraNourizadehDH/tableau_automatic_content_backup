      <column caption='COST / GMV TOTAL' datatype='real' name='[Calculation_1312517852199510016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_cost_EU])/SUM([gmv_eu])' />
      </column>
      <column caption='FREQ_PRE_HO' datatype='real' name='[Calculation_2384374562422767617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_type] = &apos;Control&apos; THEN [PRE30] ELSE 0 END)&#13;&#10;/ &#13;&#10;SUM(IF [order_type] = &apos;Control&apos; THEN [total_orders] ELSE 0 END)' />
      </column>
      <column caption='FREQ_POS_HO' datatype='real' name='[Calculation_2384374562441695237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Pos30])/SUM([Total Orders])&#13;&#10;&#13;&#10;&#13;&#10;SUM(IF [order_type] = &apos;Control&apos; THEN [POS30] ELSE 0 END)&#13;&#10;/ &#13;&#10;SUM(IF [order_type] = &apos;Control&apos; THEN [total_orders] ELSE 0 END)' />
      </column>
      <column caption='VAR_PREPOS' datatype='real' name='[Calculation_2384374562447237129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2384374562447695882]/ [VAR_PREPOS_HO (copia)_2384374562448302091]) -1' />
      </column>
      <column caption='VAR_PREPOS_nonHO' datatype='real' name='[Calculation_2384374562447695882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[FREQ_POST_HO (copia)_2384374562446708743]/[FREQ_PRE_HO (copia)_2384374562446958600]' />
      </column>
      <column caption='% UPLIFT (COST / GMV TOTAL)' datatype='real' name='[Calculation_2384374562456514572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2384374562447237129]/ [Calculation_1312517852199510016]' />
      </column>
      <column caption='FREQ_POS_nonHO' datatype='real' name='[FREQ_POST_HO (copia)_2384374562446708743]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Pos30])/SUM([Total Orders])&#13;&#10;&#13;&#10;&#13;&#10;SUM(IF [order_type] = &apos;Variation&apos; THEN [POS30] ELSE 0 END)&#13;&#10;/ &#13;&#10;SUM(IF [order_type] = &apos;Variation&apos; THEN [total_orders] ELSE 0 END)' />
      </column>
      <column caption='FREQ_PRE_nonHO ' datatype='real' name='[FREQ_PRE_HO (copia)_2384374562446958600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_type] = &apos;Variation&apos; THEN [PRE30] ELSE 0 END)&#13;&#10;/ &#13;&#10;SUM(IF [order_type] = &apos;Variation&apos; THEN [total_orders] ELSE 0 END)' />
      </column>
      <column datatype='string' name='[Lifecycle Stage (grupo)]' role='dimension' type='nominal'>
