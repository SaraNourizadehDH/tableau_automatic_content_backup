      <column caption='Control_order_red' datatype='integer' name='[Calculation_1894326629615980545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Variation] = &apos;Control&apos; THEN [redeemed_order]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Q_RR' datatype='real' default-format='p0.00%' name='[Calculation_1894326629646360579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([QRR])/COUNTD([orderId])' />
      </column>
      <column caption='TTR (Minutes)' datatype='integer' name='[Calculation_1894326629688479757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [comp_timestamp], [redemption_timestamp])' />
      </column>
      <column caption='Reminder type' datatype='string' name='[Calculation_1894326629706031119]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [day_number]&#13;&#10;    WHEN 2 THEN &apos;2 DAY REMINDER&apos;&#13;&#10;    WHEN 7 THEN &apos;7 DAY REMINDER&apos;&#13;&#10;    WHEN 14 THEN &apos;14 DAY REMINDER&apos;&#13;&#10;    WHEN 24 THEN &apos;24 DAY REMINDER&apos;&#13;&#10;    WHEN 29 THEN &apos;29 DAY REMINDER&apos;&#13;&#10;    ELSE &apos;NO REMINDER&apos;&#13;&#10;END' />
      </column>
      <column caption='control_reminder_ts' datatype='datetime' name='[Calculation_1894326629989875728]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;hour&apos;, 19 - DATEPART(&apos;hour&apos;, [redemption_timestamp]), DATETRUNC(&apos;day&apos;, [redemption_timestamp]))' />
      </column>
      <column caption='TTR control TEST' datatype='integer' name='[Calculation_1894326629992902675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;day&apos;, [redemption_timestamp]) = DATETRUNC(&apos;day&apos;, [Calculation_1894326629989875728])&#13;&#10;AND  DATEPART(&apos;hour&apos;, [redemption_timestamp]) = 19&#13;&#10;AND [redemption_timestamp] &gt;= [Calculation_1894326629989875728]&#13;&#10;THEN&#13;&#10;    DATEDIFF(&apos;minute&apos;, [Calculation_1894326629989875728], [redemption_timestamp])&#13;&#10;ELSE&#13;&#10;    NULL // O puedes poner 0, o un mensaje de error, según lo que necesites&#13;&#10;END' />
      </column>
