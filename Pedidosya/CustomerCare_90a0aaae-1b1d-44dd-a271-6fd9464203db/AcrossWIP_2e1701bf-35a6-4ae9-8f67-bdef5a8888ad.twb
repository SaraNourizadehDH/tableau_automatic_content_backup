      <column datatype='string' name='[CR1]' role='dimension' type='nominal' />
      <column caption='Cr3 Hc' datatype='string' name='[CR3_HC]' role='dimension' type='nominal' />
      <column caption='Share volumen' datatype='real' name='[Calculation_2074963200279412790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([contact_id]) / SUM({FIXED : COUNTD([contact_id])})' />
      </column>
      <column caption='Share respuestas' datatype='real' name='[Calculation_2885400026981281799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_satresp_ind]) / SUM({FIXED : SUM([is_satresp_ind])})' />
      </column>
      <column caption='Contribución csat after contact' datatype='real' name='[Calculation_2885400026981847048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_satresp_ind]) / SUM({FIXED : SUM([is_satresp_ind])})*SUM([is_sat_ind])/SUM([is_satresp_ind])' />
      </column>
      <column caption='Vacio' datatype='integer' name='[Calculation_3001789930535116807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT (null)' />
      </column>
      <column caption='Csat after contact' datatype='real' name='[Calculation_3001789930546888738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_sat_ind])/ SUM([is_satresp_ind])' />
      </column>
      <column caption='Prom. Att' datatype='real' name='[Calculation_3001789930547761188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([att])' />
      </column>
      <column caption='Prom. Acw' datatype='real' name='[Calculation_3001789930547994661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([acw])' />
      </column>
      <column caption='Prom. FCR' datatype='real' name='[Calculation_3001789930548080678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([is_fcr_ind])' />
      </column>
      <column caption='Prom. Retipificación' datatype='real' name='[Calculation_3001789930548187175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([retipificacion])' />
      </column>
      <column caption='Wow att' datatype='real' name='[Calculation_3001789930549035048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(AVG([att]), 0) - LOOKUP(AVG([att]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Wow acw' datatype='real' name='[Calculation_3001789930549772329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(AVG([acw]), 0) - LOOKUP(AVG([acw]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Wow FCR' datatype='real' name='[Calculation_3001789930550030378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(AVG([is_fcr_ind]), 0) - LOOKUP(AVG([is_fcr_ind]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Wow retipificación' datatype='real' name='[Calculation_3001789930550349867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(AVG([retipificacion]), 0) - LOOKUP(AVG([retipificacion]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Contribución_csat_ac_wow' datatype='real' name='[Calculation_5437181797122973771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_sat_ind]) / SUM({FIXED [created_week],[CR1_lob]: SUM([is_satresp_ind])})' />
      </column>
      <column caption='Vol_wow' datatype='integer' name='[Calculation_5437181797125922896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD([contact_id]), 0) - LOOKUP(COUNTD([contact_id]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Csat_wow ' datatype='real' name='[Calculation_5437181797135036498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_sat_ind]) / SUM([is_satresp_ind]) &#10;- LOOKUP(SUM([is_sat_ind]) / SUM([is_satresp_ind]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
