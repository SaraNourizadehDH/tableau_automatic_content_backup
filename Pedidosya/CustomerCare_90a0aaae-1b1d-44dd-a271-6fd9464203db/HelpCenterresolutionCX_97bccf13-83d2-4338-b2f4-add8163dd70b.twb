            <column-instance column='[buckets]' derivation='None' name='[none:buckets:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[type_block]' derivation='None' name='[none:type_block:nk]' pivot='key' type='nominal' />
            <column-instance column='[total_responses_nps]' derivation='Sum' name='[sum:total_responses_nps:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_users_with_nps]' derivation='Sum' name='[sum:total_users_with_nps:qk]' pivot='key' type='quantitative' />
            <column-instance column='[users_w_refunds]' derivation='Sum' name='[sum:users_w_refunds:qk]' pivot='key' type='quantitative' />
            <column caption='Total Responses Nps' datatype='integer' name='[total_responses_nps]' role='measure' type='quantitative' />
            <column caption='Total Users With Nps' datatype='integer' name='[total_users_with_nps]' role='measure' type='quantitative' />
            <column datatype='string' name='[type_block]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;low_friction&quot;' value='Low Friction' />
                <alias key='&quot;mid_friction&quot;' value='Mid Friction' />
