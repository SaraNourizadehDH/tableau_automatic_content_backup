          <alias key='&quot;[federated.0vzs74o02xttkx1dg2j8009l2z7q].[usr:Calculation_856809878302777345:qk]&quot;' value='%% Cont.' />
        </aliases>
      </column>
      <column datatype='string' name='[CCR]' role='dimension' type='nominal' />
      <column caption='% Cont. Fraud' datatype='real' name='[Calculation_1007680466152927234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_users_with_nps]) / &#13;&#10;SUM({ FIXED MONTH([created_date_resolution]) : SUM([total_responses_nps])})' />
      </column>
      <column caption='% Fraud rate' datatype='real' name='[Calculation_682013922502664192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM([users_w_refunds]) / SUM([total_users_with_nps]))' />
      </column>
      <column caption='% Refunds rate' datatype='real' name='[Calculation_682013922505183233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([orders_w_refunds])' />
      </column>
      <column caption='%Hc resolution' datatype='real' name='[Calculation_856809877917630464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([yes_solved]) / sum([total_responses_nps])' />
      </column>
      <column caption='% contribution' datatype='real' name='[Calculation_856809878302777345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([yes_solved]) / &#13;&#10;SUM({ FIXED MONTH([created_date_resolution]) : SUM([total_responses_nps])})' />
      </column>
      <column caption='%%Cont. FO' datatype='real' name='[Calculation_856809878306349058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_users_food_onto]) / SUM([total_users_with_nps])' />
      </column>
