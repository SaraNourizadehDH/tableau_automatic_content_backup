    <worksheet name='total fraud'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Light' fontsize='9'>Fraud performance summary</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='nps_customer_resolution_rate (automated_tables_reports)' name='federated.0vzs74o02xttkx1dg2j8009l2z7q' />
          </datasources>
          <datasource-dependencies datasource='federated.0vzs74o02xttkx1dg2j8009l2z7q'>
            <column caption='% Cont. Fraud' datatype='real' name='[Calculation_1007680466152927234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_users_with_nps]) / &#13;&#10;SUM({ FIXED MONTH([created_date_resolution]) : SUM([total_responses_nps])})' />
            </column>
            <column caption='% Fraud rate' datatype='real' name='[Calculation_682013922502664192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM([users_w_refunds]) / SUM([total_users_with_nps]))' />
            </column>
            <column caption='%Hc resolution' datatype='real' name='[Calculation_856809877917630464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([yes_solved]) / sum([total_responses_nps])' />
            </column>
            <column caption='Buckets' datatype='string' name='[buckets]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date Resolution' datatype='date' name='[created_date_resolution]' role='dimension' type='ordinal' />
