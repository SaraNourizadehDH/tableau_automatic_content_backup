          <alias key='&quot;[federated.0vzs74o02xttkx1dg2j8009l2z7q].[diff:usr:Calculation_856809878302777345:qk:2]&quot;' value='Var % cont.     ' />
          <alias key='&quot;[federated.0vzs74o02xttkx1dg2j8009l2z7q].[sum:total_responses_nps:qk]&quot;' value='Total responses NPS' />
