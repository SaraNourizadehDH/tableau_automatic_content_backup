    <worksheet name='orders&amp;AFV wow'>
      <table>
        <view>
          <datasources>
            <datasource caption='care_performance+ (user_carolina_torres)' name='federated.15tvu1n1cxcc1j15l1n1w14kx63a' />
          </datasources>
          <datasource-dependencies datasource='federated.15tvu1n1cxcc1j15l1n1w14kx63a'>
            <column caption='orders_wow' datatype='real' name='[COR_issued_wow (copia)_2022960706523111427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([orders_od])) - LOOKUP(ZN(SUM([orders_od])), -1)) / ABS(LOOKUP(ZN(SUM([orders_od])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is last Week -1 ORDERS' datatype='integer' name='[Calculation_2022960706520305666]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF&#13;&#10; (DATETRUNC(&apos;week&apos;,[week_date (afv_performance)]) &gt;= DATEADD(&apos;week&apos;,-1,[Calculation_799670456677875714]))&#13;&#10;AND&#13;&#10; (DATETRUNC(&apos;week&apos;,[week_date (afv_performance)]) &lt;= [Calculation_799670456677875714])&#13;&#10;THEN 1 ELSE 0 END' />
            </column>
            <column caption='Title WOW' datatype='string' name='[Calculation_2022960706582425608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;WoW&quot;' />
            </column>
            <column caption='gfv gross wo subs EU' datatype='real' name='[Calculation_2313442869375766530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_gross_wo_subs_LC]/[fx (FX!data2)]' />
            </column>
            <column caption='AFV EU' datatype='real' name='[Calculation_2313442869375934467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_2313442869375766530])/sum([orders_od])' />
            </column>
            <column caption='Last complete week' datatype='date' name='[Calculation_799670456677875714]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISOWEEKDAY([Calculation_799670456678117379])=7&#13;&#10;THEN [Calculation_799670456678301700]&#13;&#10;ELSE [Calculation_799670456678301700]-7&#13;&#10;END' />
            </column>
            <column caption='Latest day' datatype='date' name='[Calculation_799670456678117379]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([week_date])}' />
            </column>
            <column caption='Latest week' datatype='date' name='[Calculation_799670456678301700]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_799670456678117379]))' />
            </column>
            <column caption='LAST' datatype='integer' name='[Calculation_799670456678825990]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Week number ORDERS' datatype='string' name='[Week number (copia)_1391330858500956170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Week&apos; + &apos; &apos;+ RIGHT(&apos;0&apos; + STR(DATEPART(&apos;week&apos;, [full_date (afv_performance)])), 2)' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[full_date (afv_performance)]' role='dimension' type='ordinal' />
