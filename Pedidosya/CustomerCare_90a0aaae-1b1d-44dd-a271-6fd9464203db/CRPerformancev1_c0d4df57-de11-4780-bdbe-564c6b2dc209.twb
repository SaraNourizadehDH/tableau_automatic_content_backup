      <column datatype='string' name='[CCR]' role='dimension' type='nominal' />
      <column datatype='string' name='[CCR_group]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[CCR]' default='&quot;Otro&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Cancelation&quot;'>
            <value>&quot;cancel&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Delayed Order&quot;'>
            <value>&quot;delayed order&quot;</value>
          </bin>
          <bin default-name='true' value='&quot;PDI&quot;'>
            <value>&quot;PDI&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='COR amount issued LC' datatype='real' name='[COR_amount_issued_LC]' role='measure' type='quantitative' />
      <column caption='COR amount issued LC NO IVA' datatype='real' name='[COR_amount_issued_LC_NO_IVA]' role='measure' type='quantitative' />
      <column caption='COR_frecuency_wow' datatype='real' name='[COR_amount_issued_wow (copia)_1391330858510200844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Frequency refunds (copia)_2211548931080585220]) - LOOKUP(ZN([Frequency refunds (copia)_2211548931080585220]), -1)) / ABS(LOOKUP(ZN([Frequency refunds (copia)_2211548931080585220]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='COR_issued_wow' datatype='real' name='[COR_amount_issued_wow (copia)_2022960706503094273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([COR_issued])) - LOOKUP(ZN(SUM([COR_issued])), -1)) / ABS(LOOKUP(ZN(SUM([COR_issued])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='COR amount used LC' datatype='real' name='[COR_amount_used_LC]' role='measure' type='quantitative' />
      <column caption='COR amount used LC NO IVA' datatype='real' name='[COR_amount_used_LC_NO_IVA]' role='measure' type='quantitative' />
      <column caption='COR destination' datatype='string' name='[COR_destination]' role='dimension' type='nominal' />
      <column caption='COR_freq_refunds_wow' datatype='real' name='[COR_frecuency_wow (copia)_2022960706593628169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_2211548931079995395]) - LOOKUP(ZN([Calculation_2211548931079995395]), -1)) / ABS(LOOKUP(ZN([Calculation_2211548931079995395]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
      <column caption='orders_wow' datatype='real' name='[COR_issued_wow (copia)_2022960706523111427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([orders_od])) - LOOKUP(ZN(SUM([orders_od])), -1)) / ABS(LOOKUP(ZN(SUM([orders_od])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='COR used' datatype='integer' name='[COR_used]' role='measure' type='quantitative' />
      <column caption='Compensations CPO [LC]' datatype='real' name='[CPO Refunds (copia)_2211548931084623881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([COR_amount_used_LC_NO_IVA])/sum([orders_od])' />
      </column>
      <column caption='Compensations CPO [€]' datatype='real' name='[CPO Refunds FX (copia)_2211548931084783626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1805662011054030849])/sum([orders_od])' />
      </column>
      <column caption='CPO recuperos' datatype='real' name='[Calculation_1147854987769970695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount])/sum([orders_od])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1147854988060676120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_gross_wo_subs_LC])/sum([orders_od])' />
      </column>
      <column caption='recuperables' datatype='integer' name='[Calculation_1147854989563711524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [CCR] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) THEN [COR_issued] ELSE 0 END' />
      </column>
      <column caption='% Refunds trasladables al partner' datatype='real' name='[Calculation_1147854989564018725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1147854989563711524])/sum([COR_issued])' />
      </column>
      <column caption='CPO Refunds' datatype='real' name='[Calculation_1147854989565878310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([COR_amount_used_LC_NO_IVA])/sum([orders_od])' />
      </column>
      <column caption='Alcance' datatype='real' name='[Calculation_1147854989570818089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount])/sum([COR_amount_issued_LC])' />
      </column>
