                <bin default-name='false' value='&quot;Cancelation&quot;'>
                  <value>&quot;cancel&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Delayed Order&quot;'>
                  <value>&quot;delayed order&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;PDI&quot;'>
                  <value>&quot;PDI&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='COR amount issued LC NO IVA' datatype='real' name='[COR_amount_issued_LC_NO_IVA]' role='measure' type='quantitative' />
            <column caption='COR_frecuency_wow' datatype='real' name='[COR_amount_issued_wow (copia)_1391330858510200844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Frequency refunds (copia)_2211548931080585220]) - LOOKUP(ZN([Frequency refunds (copia)_2211548931080585220]), -1)) / ABS(LOOKUP(ZN([Frequency refunds (copia)_2211548931080585220]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='COR_issued_wow' datatype='real' name='[COR_amount_issued_wow (copia)_2022960706503094273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([COR_issued])) - LOOKUP(ZN(SUM([COR_issued])), -1)) / ABS(LOOKUP(ZN(SUM([COR_issued])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='Week number' datatype='string' name='[Calculation_1391330858432770049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Week&apos; + &apos; &apos;+ RIGHT(&apos;0&apos; + STR(DATEPART(&apos;week&apos;, [full_date])), 2)' />
            </column>
            <column caption='Title WOW' datatype='string' name='[Calculation_2022960706582425608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;WoW&quot;' />
            </column>
            <column caption='Last complete week' datatype='date' name='[Calculation_799670456677875714]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ISOWEEKDAY([Calculation_799670456678117379])=7&#13;&#10;THEN [Calculation_799670456678301700]&#13;&#10;ELSE [Calculation_799670456678301700]-7&#13;&#10;END' />
            </column>
            <column caption='Latest day' datatype='date' name='[Calculation_799670456678117379]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([week_date])}' />
            </column>
            <column caption='Latest week' datatype='date' name='[Calculation_799670456678301700]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_799670456678117379]))' />
            </column>
            <column caption='Is last week -1' datatype='integer' name='[Calculation_799670456678608901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF&#13;&#10; (DATETRUNC(&apos;week&apos;,[week_date]) &gt;= DATEADD(&apos;week&apos;,-1,[Calculation_799670456677875714]))&#13;&#10;AND&#13;&#10; (DATETRUNC(&apos;week&apos;,[week_date]) &lt;= [Calculation_799670456677875714])&#13;&#10;THEN 1 ELSE 0 END' />
            </column>
            <column caption='LAST' datatype='integer' name='[Calculation_799670456678825990]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='COR_amount_issued_wow' datatype='real' name='[Calculation_799670456680030215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([COR_amount_issued_LC_NO_IVA])) - LOOKUP(ZN(SUM([COR_amount_issued_LC_NO_IVA])), -1)) / ABS(LOOKUP(ZN(SUM([COR_amount_issued_LC_NO_IVA])), -1))'>
