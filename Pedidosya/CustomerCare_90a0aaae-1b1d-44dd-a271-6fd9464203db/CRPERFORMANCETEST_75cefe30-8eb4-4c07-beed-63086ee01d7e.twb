    <worksheet name='BASE 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Noto Sans Lao' fontsize='10'>Orders Confirmed / AFV  - Operative metrics </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity v2' datatype='string' name='[Granularity (copia 2)_2135832147632836622]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column alias='Euros' caption='Moneda' datatype='integer' name='[Granularity (copia)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Local Currency' />
                <alias key='2' value='Euros' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column caption='AFV Dinamic' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[AFV_LC (copia)_1654228465096192002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([gfv_lc])/SUM([Calculation_2221400567166021632])&#13;&#10;WHEN 2 THEN SUM([gfv_eu])/SUM([Calculation_2221400567166021632])&#13;&#10;END' />
            </column>
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='innacuracy_orders' datatype='integer' name='[Calculation_2135832138092900355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([ccr] IN (&apos;missing item&apos;,&apos;wrong item&apos;,&apos;wrong order&apos;,&apos;food quality&apos;,&apos;food temperature&apos;,&apos;spilled food&apos;) AND [comp_or_ref] != &apos;Refunds&apos;) &#13;&#10;THEN [COR_issued] &#13;&#10;END' />
            </column>
            <column caption='Innacuracy' datatype='real' default-format='p0.00%' name='[Calculation_2135832138093858820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2135832138092900355])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2221400567168610307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Orders OD Confirmed (copia)_2221400567168536578])/SUM([total_orders])' />
            </column>
            <column caption='OL_COMPS' datatype='real' default-format='p0.00%' name='[Calculation_2959709387536826369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='DATE_FILTER (V2)' datatype='string' name='[DATE_FILTER (copia)_2135832147633020943]' role='dimension' type='nominal'>
