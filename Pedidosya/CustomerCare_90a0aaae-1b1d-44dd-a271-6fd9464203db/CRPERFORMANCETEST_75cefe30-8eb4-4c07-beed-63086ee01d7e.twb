            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='AV / AFV' datatype='real' default-format='p0.00%' name='[Calculation_796855684984631299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN [Calculation_796855684985458692] / [Calculation_796855685225062406]&#13;&#10;WHEN 2 THEN [AV COR (copia)_1742611610564624386] / [Calculation_796855685302222871]&#13;&#10;END' />
            </column>
            <column caption='AV COR LC' datatype='real' default-format='C11274%' name='[Calculation_796855684985458692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COR_amount_used_LC_NO_IVA])/SUM([COR_used])' />
            </column>
            <column caption='AFV_LC' datatype='real' name='[Calculation_796855685225062406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_lc])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='AFV_EU' datatype='real' name='[Calculation_796855685302222871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_eu])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='DATE_FILTER NEW' datatype='string' name='[DATE_FILTER (copia)_416864477321637888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
            </column>
            <column caption='Ccr' datatype='string' name='[ccr]' role='dimension' type='nominal' />
            <column caption='Comp Or Ref' datatype='string' name='[comp_or_ref]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
