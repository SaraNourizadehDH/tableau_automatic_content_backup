            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vertical_group]' derivation='None' name='[none:vertical_group:nk]' pivot='key' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[AV COR Dinamic (copia)_2135832140606308362]' derivation='User' name='[usr:AV COR Dinamic (copia)_2135832140606308362:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2221400567168610307]' derivation='User' name='[usr:Calculation_2221400567168610307:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Group' datatype='string' name='[vertical_group]' role='dimension' type='nominal' />
          </datasource-dependencies>
