      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='9'><![CDATA[<[Parameters].[Parámetro 1]> View: ]]></run>
            <run fontcolor='#ffffff' fontsize='9'><![CDATA[Values in <[Parameters].[Granularity (copia 2)_2135832140544954376]> by Vertical (<[federated.1w5o5p21a6qqgu10i7r2a0hdo138].[none:comp_or_ref:nk]>)]]></run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run><![CDATA[Las lineas de tendencia muestran los valores de acuerdo a los motivos de contacto: <]]></run>
            <run>[federated.1w5o5p21a6qqgu10i7r2a0hdo138].[none:AV COR Dinamic (copia)_2135832140618502155:nk]</run>
            <run>&gt;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='# Issued' caption='Type of Value' datatype='integer' datatype-customized='true' name='[Granularity (copia 2)_2135832140544954376]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <aliases>
                <alias key='1' value='Amount emmited' />
                <alias key='2' value='Amount used' />
                <alias key='3' value='# Issued' />
                <alias key='4' value='# Used' />
              </aliases>
            </column>
            <column caption='Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column caption='Montos Dinamic' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[AV COR Dinamic (copia)_2135832140606308362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia 2)_2135832140544954376]&#13;&#10;WHEN 1 THEN SUM([COR_amount_issued_EU])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])&#13;&#10;WHEN 3 THEN SUM([COR_issued])&#13;&#10;WHEN 4 THEN SUM([COR_used])&#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>Values dinamics</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='CCR Dinamic' datatype='string' default-format='C11274%' name='[AV COR Dinamic (copia)_2135832140618502155]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [comp_or_ref]&#13;&#10;WHEN &apos;Compensation&apos; THEN [CCR_group]&#13;&#10;WHEN &apos;Refunds&apos; THEN [CCR_REFUNDS]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[CCR_REFUNDS]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ccr]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Food quality&quot;'>
                  <value>&quot;food quality&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Food temperature&quot;'>
                  <value>&quot;food temperature&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Missing item&quot;'>
                  <value>&quot;missing item&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Spilled food&quot;'>
                  <value>&quot;spilled food&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Wrong item&quot;'>
                  <value>&quot;wrong item&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Wrong order&quot;'>
                  <value>&quot;wrong order&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='CCR_COMPS' datatype='string' name='[CCR_group]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ccr]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Cancelation&quot;'>
                  <value>&quot;cancel&quot;</value>
                  <value>&quot;cancelation&quot;</value>
                  <value>&quot;order marked as delivered but didn&apos;t receive&quot;</value>
                  <value>&quot;order not delivered&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Delayed Order&quot;'>
                  <value>&quot;delayed order&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Free Delivery - PDI&quot;'>
                  <value>&quot;food quality&quot;</value>
                  <value>&quot;missing item&quot;</value>
                  <value>&quot;PDI&quot;</value>
                  <value>&quot;wrong item&quot;</value>
                  <value>&quot;wrong order&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='real' name='[COR_amount_issued_EU]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;€&quot;#,##0,K;-&quot;€&quot;#,##0,K' name='[COR_amount_used_EU_NO_IVA]' role='measure' type='quantitative' />
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='COR used' datatype='integer' name='[COR_used]' role='measure' type='quantitative' />
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2221400567168610307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Orders OD Confirmed (copia)_2221400567168536578])/SUM([total_orders])' />
            </column>
            <column caption='DATE_FILTER NEW' datatype='string' name='[DATE_FILTER (copia)_416864477321637888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
            </column>
            <column caption='Orders OD Rejected' datatype='integer' name='[Orders OD Confirmed (copia)_2221400567168536578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] != &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='Ccr' datatype='string' name='[ccr]' role='dimension' type='nominal' />
            <column caption='Comp Or Ref' datatype='string' name='[comp_or_ref]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column-instance column='[AV COR Dinamic (copia)_2135832140618502155]' derivation='None' name='[none:AV COR Dinamic (copia)_2135832140618502155:nk]' pivot='key' type='nominal' />
            <column-instance column='[DATE_FILTER (copia)_416864477321637888]' derivation='None' name='[none:DATE_FILTER (copia)_416864477321637888:nk]' pivot='key' type='nominal' />
            <column-instance column='[comp_or_ref]' derivation='None' name='[none:comp_or_ref:nk]' pivot='key' type='nominal' />
