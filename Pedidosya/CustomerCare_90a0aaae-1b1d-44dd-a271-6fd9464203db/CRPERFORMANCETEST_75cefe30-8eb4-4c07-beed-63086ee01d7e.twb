    <worksheet name='Recuperos'>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity v2' datatype='string' name='[Granularity (copia 2)_2135832147632836622]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column alias='Euros' caption='Moneda' datatype='integer' name='[Granularity (copia)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Local Currency' />
                <alias key='2' value='Euros' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column caption='Recuperos Dinamic' datatype='real' name='[AFV Dinamic (copia)_726486942180073483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([amount])&#13;&#10;WHEN 2 THEN SUM([amount_EU])&#13;&#10;END)' />
            </column>
            <column caption='COR amount issued LC' datatype='real' name='[COR_amount_issued_LC]' role='measure' type='quantitative' />
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='CPO RECUPEROS Dinamic ' datatype='real' name='[CPO COMPS Dinamic (copia)_726486942178865160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN sum([amount])/sum([Calculation_2221400567166021632])&#13;&#10;WHEN 2 THEN SUM([amount_EU])/sum([Calculation_2221400567166021632])&#13;&#10;END)' />
            </column>
            <column caption='recuperables' datatype='integer' name='[Calculation_1147854989563711524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF [CCR (care performance)] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;//THEN [COR issued (care performance)] ELSE 0 END&#13;&#10;&#13;&#10;IF &#13;&#10;([ccr] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;AND [vertical_group (base_ccare)] IN (&apos;FOOD&apos;,&apos;LOCAL STORE&apos;,&apos;VD&apos;)) &#13;&#10;//OR //traer valores VD&#13;&#10;//([CCR] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;//AND [business_type (CoR_care_performance_V2)] IN (&apos;VD&apos;) AND [Cor Date] &gt;= DATE(&apos;2024-12-01&apos;))&#13;&#10;THEN [COR_issued] &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='% Refunds trasladables al partner' datatype='real' name='[Calculation_1147854989564018725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1147854989563711524])/sum([COR_issued])' />
            </column>
            <column caption='Alcance' datatype='real' name='[Calculation_1147854989570818089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([amount])/sum([COR_amount_issued_LC])' />
            </column>
            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='-[Recuperos Dinamic]' datatype='real' name='[Calculation_726486942180306956]' role='measure' type='quantitative' user:unnamed='Recuperos'>
              <calculation class='tableau' formula='-[AFV Dinamic (copia)_726486942180073483]' />
            </column>
            <column caption='AFV_LC' datatype='real' name='[Calculation_796855685225062406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_lc])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='CPO RECUPEROS LC' datatype='real' name='[Calculation_796855685241036810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([amount])/sum([Calculation_2221400567166021632])' />
            </column>
            <column caption='CPO / AFV RECUPEROS' datatype='real' name='[Calculation_796855685241544717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_796855685241036810]/[Calculation_796855685225062406]' />
            </column>
            <column caption='DATE_FILTER (V2)' datatype='string' name='[DATE_FILTER (copia)_2135832147633020943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Mercado&apos;) THEN  // New: Mercados&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([country_code])&#13;&#10;END' />
            </column>
