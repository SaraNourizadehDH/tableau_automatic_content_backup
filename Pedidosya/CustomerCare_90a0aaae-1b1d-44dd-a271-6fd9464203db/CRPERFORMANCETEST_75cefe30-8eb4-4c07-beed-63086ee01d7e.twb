      <column caption='CPO SPILLED DINAMIC' datatype='real' name='[TOTAL COST C+R DINAMIC (copia)_1654228465098207236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN [Calculation_796855685240623113]&#13;&#10;WHEN 2 THEN [Calculation_796855685290811413]&#13;&#10;END' />
      </column>
      <column caption='Total Cost Refunds Dinamic' datatype='real' name='[Total Cost Compensations Dinamic (copia)_726486942172946436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([COR_amount_used_LC_NO_IVA])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])&#13;&#10;END' />
      </column>
      <column caption='Total Cost Compensations Dinamic' datatype='real' name='[Total Cost Compensations [LC]] (copia)_726486942172618753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([COR_amount_used_LC_NO_IVA])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])&#13;&#10;END' />
      </column>
      <column caption='Total Cost Refunds [€]' datatype='real' name='[Total Cost Refunds [LC]]  (copia)_289356302571941890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_amount_used_EU_NO_IVA])' />
