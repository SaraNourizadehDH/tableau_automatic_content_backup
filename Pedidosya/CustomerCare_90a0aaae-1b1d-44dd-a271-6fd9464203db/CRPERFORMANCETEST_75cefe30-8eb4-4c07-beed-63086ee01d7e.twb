    <worksheet name='Spilled full (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Euros' caption='Moneda' datatype='integer' name='[Granularity (copia)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Local Currency' />
                <alias key='2' value='Euros' />
              </aliases>
            </column>
            <column caption='Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column datatype='real' default-format='c&quot;€&quot;#,##0,K;-&quot;€&quot;#,##0,K' name='[COR_amount_used_EU_NO_IVA]' role='measure' type='quantitative' />
            <column caption='COR amount used LC NO IVA' datatype='real' name='[COR_amount_used_LC_NO_IVA]' role='measure' type='quantitative' />
            <column caption='TOTAL COST C+R DINAMIC' datatype='real' name='[Calculation_1654228465097834499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([COR_amount_used_LC_NO_IVA])-SUM([amount])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])-SUM([amount_EU])&#13;&#10;END' />
            </column>
            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='AFV_LC' datatype='real' name='[Calculation_796855685225062406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_lc])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='CPO SPILLED LC' datatype='real' name='[Calculation_796855685240623113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([COR_amount_used_LC_NO_IVA])-sum([amount]))/sum([Calculation_2221400567166021632])' />
            </column>
            <column caption='[CPO SPILLED LC] / [AFV_LC]' datatype='real' name='[Calculation_796855685248778255]' role='measure' type='quantitative' user:unnamed='Spilled full'>
              <calculation class='tableau' formula='[Calculation_796855685240623113] / [Calculation_796855685225062406]' />
            </column>
            <column caption='CPO SPILLED EU' datatype='real' name='[Calculation_796855685290811413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([COR_amount_used_EU_NO_IVA])-SUM([amount_EU]))/sum([Calculation_2221400567166021632])' />
            </column>
            <column caption='DATE_FILTER NEW' datatype='string' name='[DATE_FILTER (copia)_416864477321637888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
            </column>
            <column caption='CPO SPILLED DINAMIC' datatype='real' name='[TOTAL COST C+R DINAMIC (copia)_1654228465098207236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN [Calculation_796855685240623113]&#13;&#10;WHEN 2 THEN [Calculation_796855685290811413]&#13;&#10;END' />
            </column>
            <column caption='Amount' datatype='real' name='[amount]' role='measure' type='quantitative' />
            <column caption='amount EU' datatype='real' name='[amount_EU]' role='measure' type='quantitative' />
            <column caption='Ccr' datatype='string' name='[ccr]' role='dimension' type='nominal' />
            <column caption='Comp Or Ref' datatype='string' name='[comp_or_ref]' role='dimension' type='nominal' />
            <column caption='Country Code (Base Ccare)' datatype='string' name='[country_code (base_ccare)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
