            <column caption='Total Orders (Weekly)' datatype='integer' name='[month_total_orders (copia)_1063130998012235776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;week&apos;, [registered_date]),[country_code] : SUM([total_orders])}' />
            </column>
