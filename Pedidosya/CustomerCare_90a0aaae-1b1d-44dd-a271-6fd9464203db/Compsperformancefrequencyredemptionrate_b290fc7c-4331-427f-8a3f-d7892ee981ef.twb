            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0los5yx1f0291g17wanpq1ihlkhv'>
            <column caption='Date filter RR' datatype='string' name='[Calculation_1887571212260253698]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [Comp Date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [Comp Date]))&#13;&#10;    STR(DATEPART(&apos;year&apos;, [comp_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [comp_date])), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [comp_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [comp_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [comp_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([comp_date])&#13;&#10;END' />
            </column>
            <column caption='Tipo Redemption' datatype='real' default-format='p0.00%' name='[Calculation_1887571212260446211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Seleccionar periodo (copia)]&#13;&#10;WHEN &quot;RR 7D&quot; THEN [RR7D]&#13;&#10;WHEN &quot;RR 15D&quot; THEN [RR15D]&#13;&#10;WHEN &quot;RR 30D&quot; THEN [RR30D]&#13;&#10;END' />
            </column>
            <column datatype='real' default-format='p0.00%' name='[RR15D]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[RR30D]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[RR7D]' role='measure' type='quantitative' />
            <column datatype='string' name='[Vertical (grupo)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[vertical]' new-bin='true'>
