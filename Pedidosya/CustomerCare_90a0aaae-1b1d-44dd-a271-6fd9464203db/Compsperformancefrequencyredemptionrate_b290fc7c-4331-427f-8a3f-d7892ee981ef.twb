          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0los5yx1f0291g17wanpq1ihlkhv'>
            <column caption='Frequency (Daily)' datatype='real' default-format='p0.00%' name='[Calculation_1708834593173430272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_comps])/SUM([Calculation_1708834593174638593])' />
            </column>
            <column caption='Total Orders (Daily)' datatype='integer' name='[Calculation_1708834593174638593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [registered_date],[country_code] : SUM([total_orders])}' />
            </column>
            <column caption='Total Orders (Monthly)' datatype='integer' name='[Calculation_1708834593207074818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;month&apos;, [registered_date]),[country_code]: SUM([total_orders])}' />
            </column>
            <column caption='Frequency (Monthly)' datatype='real' name='[Calculation_1708834593207123971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_comps])/SUM([Calculation_1708834593207074818])' />
            </column>
            <column caption='Tipo Frecuencia' datatype='real' default-format='p0.00%' name='[Calculation_2107684642656075778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN [Calculation_1708834593207123971]&#13;&#10;WHEN &quot;Weekly&quot; THEN [freq_monthly (copia)_1063130998012325889]&#13;&#10;WHEN &quot;Daily&quot; THEN [Calculation_1708834593173430272]&#13;&#10;END' />
            </column>
            <column caption='Date filter freq' datatype='string' name='[DATE_FILTER (copia)_1887571211181592576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [Registered Date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [Registered Date]))&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;//ELSEIF [Granularity] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    //&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Registered Date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [Registered Date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Vertical (grupo)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[vertical]' new-bin='true'>
                <bin default-name='false' value='&quot;C2C&quot;'>
                  <value>&quot;Courier&quot;</value>
                  <value>&quot;Courier Business&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;FOOD&quot;'>
                  <value>&quot;Coffee&quot;</value>
                  <value>&quot;Restaurant&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;QC&quot;'>
                  <value>&quot;Drinks&quot;</value>
                  <value>&quot;Kiosks&quot;</value>
                  <value>&quot;Market&quot;</value>
                  <value>&quot;Pets&quot;</value>
                  <value>&quot;Pharmacy&quot;</value>
                  <value>&quot;Shop&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Ccr' datatype='string' name='[ccr]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Frequency (Weekly)' datatype='real' name='[freq_monthly (copia)_1063130998012325889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_comps])/SUM([month_total_orders (copia)_1063130998012235776])' />
