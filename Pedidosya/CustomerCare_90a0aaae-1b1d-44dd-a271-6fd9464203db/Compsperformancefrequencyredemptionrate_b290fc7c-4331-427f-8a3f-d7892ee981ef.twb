            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0los5yx1f0291g17wanpq1ihlkhv'>
            <column caption='freq_var_daily' datatype='real' default-format='p0.00%' name='[Calculation_1642687980347469824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([freq_semana_pasada (copia)_1721219503819636738])-SUM([Calculation_1642687980348428290]))/SUM([Calculation_1642687980348428290])' />
            </column>
            <column caption='freq_pasada_D' datatype='real' default-format='p0.00%' name='[Calculation_1642687980348428290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [registered_date] = DATEADD(&apos;day&apos;, -7, [DIA ANTERIOR (copia)_1944147683651706880]) THEN [total_comps]/[Calculation_1708834593174638593] ELSE NULL END' />
