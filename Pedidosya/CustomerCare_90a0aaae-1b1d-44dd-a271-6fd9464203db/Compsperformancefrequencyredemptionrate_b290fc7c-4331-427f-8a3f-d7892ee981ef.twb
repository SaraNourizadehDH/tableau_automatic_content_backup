      <aliases enabled='yes' />
      <column caption='freq_var_daily' datatype='real' default-format='p0.00%' name='[Calculation_1642687980347469824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([freq_semana_pasada (copia)_1721219503819636738])-SUM([Calculation_1642687980348428290]))/SUM([Calculation_1642687980348428290])' />
      </column>
      <column caption='fecha_semana_pasada' datatype='datetime' name='[Calculation_1642687980348276737]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;week&apos;, -1, [registered_date])' />
      </column>
      <column caption='freq_pasada_D' datatype='real' default-format='p0.00%' name='[Calculation_1642687980348428290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [registered_date] = DATEADD(&apos;day&apos;, -7, [DIA ANTERIOR (copia)_1944147683651706880]) THEN [total_comps]/[Calculation_1708834593174638593] ELSE NULL END' />
      </column>
      <column caption='DIA ANTERIOR' datatype='datetime' name='[Calculation_1642687980358520835]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -2, TODAY())' />
      </column>
      <column caption='ES DIA ANTERIOR' datatype='boolean' name='[Calculation_1642687980358643716]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[registered_date] = DATEADD(&apos;day&apos;, -2, TODAY())' />
      </column>
      <column caption='Frequency (Daily)' datatype='real' default-format='p0.00%' name='[Calculation_1708834593173430272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_comps])/SUM([Calculation_1708834593174638593])' />
      </column>
      <column caption='Total Orders (Daily)' datatype='integer' name='[Calculation_1708834593174638593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [registered_date],[country_code] : SUM([total_orders])}' />
      </column>
      <column caption='Total Orders (Monthly)' datatype='integer' name='[Calculation_1708834593207074818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;month&apos;, [registered_date]),[country_code]: SUM([total_orders])}' />
      </column>
      <column caption='Frequency (Monthly)' datatype='real' name='[Calculation_1708834593207123971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_comps])/SUM([Calculation_1708834593207074818])' />
      </column>
      <column caption='VAR_FREQ_MOVIL' datatype='real' name='[Calculation_1721219503825690634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN [freq_var_weekly (copia)_1721219503825293320]&#13;&#10;WHEN &quot;Weekly&quot; THEN [freq_var_daily (copia)_1721219503825223687]&#13;&#10;WHEN &quot;Daily&quot; THEN [Calculation_1642687980347469824]&#13;&#10;END' />
      </column>
      <column caption='texto_variation' datatype='string' name='[Calculation_1721219503837921296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN &quot;Δ MoM&quot;&#13;&#10;WHEN &quot;Weekly&quot; THEN &quot;Δ WoW&quot;&#13;&#10;WHEN &quot;Daily&quot; THEN &quot;Δ DoD&quot;&#13;&#10;END' />
      </column>
      <column caption='Date filter RR' datatype='string' name='[Calculation_1887571212260253698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [Comp Date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [Comp Date]))&#13;&#10;    STR(DATEPART(&apos;year&apos;, [comp_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [comp_date])), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [comp_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [comp_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [comp_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([comp_date])&#13;&#10;END' />
      </column>
      <column caption='Tipo Redemption' datatype='real' default-format='p0.00%' name='[Calculation_1887571212260446211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Seleccionar periodo (copia)]&#13;&#10;WHEN &quot;RR 7D&quot; THEN [RR7D]&#13;&#10;WHEN &quot;RR 15D&quot; THEN [RR15D]&#13;&#10;WHEN &quot;RR 30D&quot; THEN [RR30D]&#13;&#10;END' />
      </column>
      <column caption='Tipo Frecuencia' datatype='real' default-format='p0.00%' name='[Calculation_2107684642656075778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN [Calculation_1708834593207123971]&#13;&#10;WHEN &quot;Weekly&quot; THEN [freq_monthly (copia)_1063130998012325889]&#13;&#10;WHEN &quot;Daily&quot; THEN [Calculation_1708834593173430272]&#13;&#10;END' />
      </column>
      <column caption='Variación daily' datatype='boolean' name='[Calculation_518195446716002304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[registered_date] = TODAY()-1' />
      </column>
      <column caption='DATE_FILTER  (copia)' datatype='string' datatype-customized='true' name='[DATE_FILTER  (copia)_1793277103925866496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [comp_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [comp_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    // Muestra W + número de semana y el año&#13;&#10;    &quot;W&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;week&apos;, [comp_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [comp_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR(DAY([comp_date])) + &quot;-&quot; + STR(MONTH([comp_date])) + &quot;-&quot; + STR(YEAR([comp_date]))&#13;&#10;END' />
      </column>
      <column caption='Date filter freq' datatype='string' name='[DATE_FILTER (copia)_1887571211181592576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [Registered Date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [Registered Date]))&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;//ELSEIF [Granularity] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    //&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Registered Date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [Registered Date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
      </column>
      <column caption='CURRENT DATE DATA' datatype='date' name='[DIA ANTERIOR (copia)_1944147683651706880]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([registered_date]) }' />
      </column>
      <column caption='Date filter freq (copia)' datatype='string' name='[Date filter freq (copia)_1793277103926501377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    // Muestra W + número de semana y el año&#13;&#10;    &quot;W&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;week&apos;, [registered_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
      </column>
      <column caption='Frequency' datatype='real' name='[Freq_v1 (copia)_1708834593216126980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_comps])/SUM([total_orders])' />
