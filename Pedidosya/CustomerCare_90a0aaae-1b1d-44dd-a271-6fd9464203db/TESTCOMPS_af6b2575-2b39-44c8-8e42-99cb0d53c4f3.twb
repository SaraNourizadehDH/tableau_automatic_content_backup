      <column caption='recuperables' datatype='integer' name='[Calculation_1147854989563711524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF [CCR (care performance)] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;//THEN [COR issued (care performance)] ELSE 0 END&#13;&#10;&#13;&#10;IF &#13;&#10;([CCR] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;AND [business_type (base_ccare_performance)] IN (&apos;FOOD&apos;,&apos;LOCAL STORE&apos;,&apos;VD&apos;)) &#13;&#10;//OR //traer valores VD&#13;&#10;//([CCR] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;//AND [business_type (CoR_care_performance_V2)] IN (&apos;VD&apos;) AND [Cor Date] &gt;= DATE(&apos;2024-12-01&apos;))&#13;&#10;THEN [COR_issued] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='% Refunds trasladables al partner' datatype='real' name='[Calculation_1147854989564018725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1147854989563711524])/sum([COR_issued])' />
      </column>
      <column caption='order_late' datatype='real' default-format='p0.00%' name='[Calculation_1233141931717144576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_late])/SUM([completadas])' />
      </column>
      <column caption='% Innacuracy' datatype='real' default-format='p0.00%' name='[Calculation_1233141932464852993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inaccurate_orders])/SUM([confirmed_orders])' />
      </column>
      <column caption='Relacion Cancel-FR' datatype='real' default-format='p0.00%' name='[Calculation_1233141932471750658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Frequency refunds (copia)_2211548931080585220]/[Calculation_2221400567168610307]' />
      </column>
      <column caption='Relacion OL-Delay' datatype='real' default-format='p0.00%' name='[Calculation_1233141932474916869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Frequency refunds (copia)_2211548931080585220]/[Calculation_1233141931717144576]' />
      </column>
      <column caption='Relacion PDI-INNA' datatype='real' default-format='p0.00%' name='[Calculation_1233141932476002310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Frequency refunds (copia)_2211548931080585220]/[Calculation_1233141932464852993]' />
      </column>
      <column caption='Elasticidad FR CANCEL' datatype='real' default-format='p0.00%' name='[Calculation_1233141933521252360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Frequency refunds (copia)_2211548931080585220]) - LOOKUP([Frequency refunds (copia)_2211548931080585220], -1) / &#13;&#10;([Calculation_2221400567168610307]) - LOOKUP([Calculation_2221400567168610307], -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DATE_PRUEBA' datatype='string' name='[Calculation_1654228465076785152]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Dates from &quot;+&#13;&#10;&#13;&#10;str(window_min(min(datetrunc(&apos;day&apos;,[COR_DATE (base_ccare_performance)])))) +&quot; to &quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Refunded Orders' datatype='real' name='[Calculation_2211548931079995395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_issued])/SUM([Calculation_2221400567166021632])' />
      </column>
      <column caption='Total Cost Refunds [LC] ' datatype='real' name='[Calculation_2211548931081576453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_amount_used_LC_NO_IVA])' />
