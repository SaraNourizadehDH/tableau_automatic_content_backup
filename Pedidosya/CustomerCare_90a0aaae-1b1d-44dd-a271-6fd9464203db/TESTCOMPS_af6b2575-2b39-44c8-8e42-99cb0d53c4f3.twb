    <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' inline='true' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.00n2yme0tfbll71eqi59u1omfvbi'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_lucas_bejarano' server-oauth='server-custom' username='lucas.bejarano@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.00n2yme0tfbll71eqi59u1omfvbi' name='Consulta SQL personalizada' type='text'>SELECT&#13;
UPPER(o.rider.country_code) as country&#13;
,DATE(o.created_at,o.timezone) as created_date_local&#13;
-- ,CONCAT(EXTRACT(YEAR FROM DATE(o.created_at,o.timezone)),RIGHT(CAST(100+ EXTRACT(MONTH FROM DATE(o.created_at,o.timezone)) AS STRING),2)) as year_month&#13;
&#13;
,CASE &#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type IN (&quot;restaurants&quot;, &quot;coffee&quot;) THEN &quot;FOOD&quot;&#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type IN (&apos;fashion&apos;,&apos;health_and_wellness&apos;,&apos;home_and_gifts&apos;,&apos;vehicles&apos;,&apos;convenience&apos;,&apos;games&apos;,&apos;flowers_and_plants&apos;,&apos;pets&apos;,&apos;beauty&apos;,&apos;butchery&apos;,&apos;just_for_adults&apos;,&apos;supermarket&apos;,&apos;flowers&apos;,&apos;nuts_and_dried_fruits&apos;,&apos;fruits_and_vegetables&apos;,&apos;drinks&apos;,&apos;kiosks&apos;,&apos;shop&apos;,&apos;pharmacies&apos;,&apos;services&apos;,&apos;gourmet&apos;,&apos;electronics&apos;,&apos;snacks_and_sweets&apos;,&apos;cross_vertical&apos;,&apos;tobacco&apos;,&apos;groceries&apos;,&apos;frozen_food&apos;,&apos;hardware&apos;,&apos;pet_services&apos;,&apos;alcoholic_drinks&apos;,&apos;bakery&apos;,&apos;sports_and_lifestyle&apos;,&apos;dairy_products&apos;,&apos;pasta_shop&apos;,&apos;fishery&apos;,&apos;stationery_and_books&apos;,&apos;tickets_and_experience&apos;,&apos;hypermarket&apos;) THEN &quot;LOCAL STORE&quot;&#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type = &apos;darkstores&apos; THEN &quot;DMART&quot;&#13;
  WHEN o.delivery_type = &apos;VENDOR_DELIVERY&apos; THEN &quot;VD&quot;&#13;
  WHEN o.delivery_type = &apos;PICKUP&apos; THEN &apos;PU&apos;&#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type IN (&apos;courier_business&apos;, &apos;courier&apos;) THEN &quot;COURIER&quot;&#13;
  ELSE &quot;OTHER&quot;&#13;
END AS vertical_group&#13;
,&#13;
COUNT(DISTINCT CASE WHEN rider.timings.actual_delivery_time &gt;&gt; ol.promiseddeliverytime.maxMinutes * 60 + 10 * 60 AND ol.with_logistics THEN o.order_code END) AS count_late,&#13;
COUNT(DISTINCT CASE WHEN rider.order_status = &apos;completed&apos; THEN o.order_code ELSE NULL END) AS completadas&#13;
&#13;
FROM `peya-data-origins-pro.cl_hurrier.orders_v2` AS o&#13;
LEFT JOIN UNNEST (rider.deliveries) AS d&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` ol ON o.order_code=CAST(ol.order_id AS STRING)&#13;
&#13;
WHERE TRUE&#13;
AND DATE(o.created_at,o.timezone) &gt;&gt;=&quot;2024-01-01&quot; &#13;
AND ol.registered_date &gt;&gt;=&quot;2024-01-01&quot; &#13;
AND o.rider.country_code in (&quot;ar&quot;,&quot;bo&quot;,&quot;cr&quot;,&quot;cl&quot;,&quot;ec&quot;,&quot;gt&quot;,&quot;do&quot;,&quot;hn&quot;,&quot;ni&quot;,&quot;py&quot;,&quot;pa&quot;,&quot;pe&quot;,&quot;sv&quot;,&quot;uy&quot;,&quot;ve&quot;)&#13;
--AND o.rider.vendor.vertical_type in (&quot;restaurants&quot;,&quot;coffee&quot;)&#13;
AND o.is_preorder=false&#13;
&#13;
GROUP BY all</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.00n2yme0tfbll71eqi59u1omfvbi' name='base_orders_ccare' table='[peya-delivery-and-support.user_lucas_bejarano].[base_orders_ccare]' type='table' />
          <relation connection='bigquery.00n2yme0tfbll71eqi59u1omfvbi' name='Consulta SQL personalizada' type='text'>SELECT&#13;
UPPER(o.rider.country_code) as country&#13;
,DATE(o.created_at,o.timezone) as created_date_local&#13;
-- ,CONCAT(EXTRACT(YEAR FROM DATE(o.created_at,o.timezone)),RIGHT(CAST(100+ EXTRACT(MONTH FROM DATE(o.created_at,o.timezone)) AS STRING),2)) as year_month&#13;
&#13;
,CASE &#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type IN (&quot;restaurants&quot;, &quot;coffee&quot;) THEN &quot;FOOD&quot;&#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type IN (&apos;fashion&apos;,&apos;health_and_wellness&apos;,&apos;home_and_gifts&apos;,&apos;vehicles&apos;,&apos;convenience&apos;,&apos;games&apos;,&apos;flowers_and_plants&apos;,&apos;pets&apos;,&apos;beauty&apos;,&apos;butchery&apos;,&apos;just_for_adults&apos;,&apos;supermarket&apos;,&apos;flowers&apos;,&apos;nuts_and_dried_fruits&apos;,&apos;fruits_and_vegetables&apos;,&apos;drinks&apos;,&apos;kiosks&apos;,&apos;shop&apos;,&apos;pharmacies&apos;,&apos;services&apos;,&apos;gourmet&apos;,&apos;electronics&apos;,&apos;snacks_and_sweets&apos;,&apos;cross_vertical&apos;,&apos;tobacco&apos;,&apos;groceries&apos;,&apos;frozen_food&apos;,&apos;hardware&apos;,&apos;pet_services&apos;,&apos;alcoholic_drinks&apos;,&apos;bakery&apos;,&apos;sports_and_lifestyle&apos;,&apos;dairy_products&apos;,&apos;pasta_shop&apos;,&apos;fishery&apos;,&apos;stationery_and_books&apos;,&apos;tickets_and_experience&apos;,&apos;hypermarket&apos;) THEN &quot;LOCAL STORE&quot;&#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type = &apos;darkstores&apos; THEN &quot;DMART&quot;&#13;
  WHEN o.delivery_type = &apos;VENDOR_DELIVERY&apos; THEN &quot;VD&quot;&#13;
  WHEN o.delivery_type = &apos;PICKUP&apos; THEN &apos;PU&apos;&#13;
  WHEN o.delivery_type = &apos;OWN_DELIVERY&apos; AND o.rider.vendor.vertical_type IN (&apos;courier_business&apos;, &apos;courier&apos;) THEN &quot;COURIER&quot;&#13;
  ELSE &quot;OTHER&quot;&#13;
END AS vertical_group&#13;
,&#13;
COUNT(DISTINCT CASE WHEN rider.timings.actual_delivery_time &gt;&gt; ol.promiseddeliverytime.maxMinutes * 60 + 10 * 60 AND ol.with_logistics THEN o.order_code END) AS count_late,&#13;
COUNT(DISTINCT CASE WHEN rider.order_status = &apos;completed&apos; THEN o.order_code ELSE NULL END) AS completadas&#13;
&#13;
FROM `peya-data-origins-pro.cl_hurrier.orders_v2` AS o&#13;
LEFT JOIN UNNEST (rider.deliveries) AS d&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` ol ON o.order_code=CAST(ol.order_id AS STRING)&#13;
&#13;
WHERE TRUE&#13;
AND DATE(o.created_at,o.timezone) &gt;&gt;=&quot;2024-01-01&quot; &#13;
AND ol.registered_date &gt;&gt;=&quot;2024-01-01&quot; &#13;
AND o.rider.country_code in (&quot;ar&quot;,&quot;bo&quot;,&quot;cr&quot;,&quot;cl&quot;,&quot;ec&quot;,&quot;gt&quot;,&quot;do&quot;,&quot;hn&quot;,&quot;ni&quot;,&quot;py&quot;,&quot;pa&quot;,&quot;pe&quot;,&quot;sv&quot;,&quot;uy&quot;,&quot;ve&quot;)&#13;
--AND o.rider.vendor.vertical_type in (&quot;restaurants&quot;,&quot;coffee&quot;)&#13;
AND o.is_preorder=false&#13;
&#13;
GROUP BY all</relation>
          <relation connection='bigquery.00n2yme0tfbll71eqi59u1omfvbi' name='Consulta SQL personalizada1' type='text'>WITH # calculamos la cantida de órdenes para cada partner&#13;
orders AS &#13;
(&#13;
  SELECT DISTINCT&#13;
    o.registered_date,&#13;
    o.country.country_code AS country_code,&#13;
    o.restaurant.id AS partner_id,&#13;
    o.business_type.business_type_name business_type_name,&#13;
    COUNT(DISTINCT o.order_id) AS confirmed_orders,&#13;
    is_darkstore,&#13;
    o.with_logistics&#13;
  FROM `peya-bi-tools-pro.il_core.fact_orders` o&#13;
  LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` p ON p.partner_id = o.restaurant.id&#13;
  WHERE TRUE&#13;
  AND o.registered_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
  --AND o.with_logistics = FALSE&#13;
  AND o.business_type.business_type_name not in (&quot;Courier&quot;, &quot;Courier Business&quot;)&#13;
  AND UPPER(o.order_status) = &quot;CONFIRMED&quot;&#13;
  group by 1,2,3,4,6,7&#13;
),&#13;
&#13;
refunds as &#13;
(&#13;
  SELECT DISTINCT&#13;
    country,&#13;
    original_order_date,&#13;
    original_partner_id AS partner_id&#13;
    , COUNT(DISTINCT CASE&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;MISSING ITEM&apos;, &apos;PRODUCT MISSING&apos;,&apos;MISSING_ITEMS&apos;)&#13;
    AND original_order_logistics = true THEN original_order_id&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;MISSING ITEM&apos;, &apos;PRODUCT MISSING&apos;,&apos;MISSING_ITEMS&apos;)&#13;
    AND original_order_logistics = false&#13;
    AND original_order_date &gt;&gt;= &quot;2024-09-30&quot; THEN original_order_id ELSE NULL END) AS missing_item_orders,&#13;
    COUNT(DISTINCT CASE&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;WRONG ITEM&apos;, &apos;PRODUCT INCORRECT&apos;)&#13;
    AND original_order_logistics = true THEN original_order_id&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;WRONG ITEM&apos;, &apos;PRODUCT INCORRECT&apos;)&#13;
    AND original_order_logistics = false&#13;
    AND original_order_date &gt;&gt;= &quot;2024-09-30&quot; THEN original_order_id ELSE NULL END) AS wrong_item_orders,&#13;
    COUNT(DISTINCT CASE&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;WRONG ORDER&apos;)&#13;
    AND original_order_logistics = true THEN original_order_id&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;WRONG ORDER&apos;)&#13;
    AND original_order_logistics = false&#13;
    AND original_order_date &gt;&gt;= &quot;2024-09-30&quot; THEN original_order_id ELSE NULL END) AS wrong_order_orders,&#13;
    COUNT(DISTINCT CASE&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;FOOD QUALITY&apos;)&#13;
    AND original_order_logistics = true THEN original_order_id&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;FOOD QUALITY&apos;)&#13;
    AND original_order_logistics = false&#13;
    AND original_order_date &gt;&gt;= &quot;2024-09-30&quot; THEN original_order_id ELSE NULL END) AS food_quality_orders,&#13;
    COUNT(DISTINCT CASE&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;FOOD TEMPERATURE&apos;)&#13;
    AND original_order_logistics = false&#13;
    AND original_order_date &gt;&gt;= &quot;2024-09-30&quot; THEN original_order_id ELSE NULL END) AS food_temperature_orders_vd,&#13;
    COUNT(DISTINCT CASE&#13;
    WHEN UPPER(cor.backoffice_or_contact_reason) IN (&apos;SPILLED FOOD&apos;)&#13;
    AND original_order_logistics = false&#13;
    AND original_order_date &gt;&gt;= &quot;2024-09-30&quot; THEN original_order_id ELSE NULL END) AS spilled_food_orders_vd&#13;
  FROM `peya-bi-tools-pro.il_compensations.fact_compensations_and_refunds_care`, UNNEST(cor) AS cor&#13;
  WHERE TRUE&#13;
  AND (UPPER(cor.care) = &quot;REFUNDS&quot; OR (UPPER(cor.backoffice_or_contact_reason) IN (&apos;FOOD QUALITY&apos;) AND UPPER(cor.care) = &quot;COMPENSATION&quot; AND original_order_date BETWEEN &quot;2024-01-02&quot; AND &quot;2024-02-02&quot;))&#13;
  --AND UPPER(cor.country) = &quot;AR&quot;&#13;
  AND (UPPER(cor.backoffice_or_contact_reason) IN (&apos;MISSING ITEM&apos;, &apos;PRODUCT MISSING&apos;,&apos;MISSING_ITEMS&apos;,&apos;WRONG ITEM&apos;, &apos;PRODUCT INCORRECT&apos;,&apos;WRONG ORDER&apos;,&apos;FOOD QUALITY&apos;) AND original_order_logistics = true)&#13;
  OR (UPPER(cor.backoffice_or_contact_reason) IN (&apos;MISSING ITEM&apos;, &apos;PRODUCT MISSING&apos;,&apos;MISSING_ITEMS&apos;,&apos;WRONG ITEM&apos;, &apos;PRODUCT INCORRECT&apos;,&apos;WRONG ORDER&apos;,&apos;FOOD QUALITY&apos;,&apos;FOOD TEMPERATURE&apos;,&apos;SPILLED FOOD&apos;) AND original_order_logistics = false AND original_order_date &gt;&gt;= &quot;2024-09-30&quot;)&#13;
  AND original_business_type_name not in (&quot;Courier&quot;, &quot;Courier Business&quot;)&#13;
  GROUP BY 1, 2,3&#13;
)&#13;
&#13;
&#13;
&#13;
SELECT &#13;
registered_date,&#13;
-- &quot;Actual&quot; AS source,&#13;
o.country_code,&#13;
-- &quot;Inaccuracy&quot; as KPI,&#13;
case	&#13;
when o.business_type_name = &quot;Restaurant&quot; then &quot;FOOD&quot;	&#13;
when o.business_type_name =&quot;Coffee&quot; then &quot;FOOD&quot;	&#13;
when is_darkstore = true then &quot;DMART&quot;	&#13;
when o.with_logistics = false then &quot;VD&quot;&#13;
else &quot;LOCAL STORE&quot; end as vertical,	&#13;
&#13;
sum(missing_item_orders + wrong_item_orders + wrong_order_orders + food_quality_orders + food_temperature_orders_vd + spilled_food_orders_vd) as inaccurate_orders,&#13;
sum(confirmed_orders) as confirmed_orders,&#13;
sum(missing_item_orders) as MI_orders,&#13;
sum(wrong_item_orders) as WI_orders,&#13;
sum(wrong_order_orders) as WO_orders,&#13;
sum(food_quality_orders) as FQ_orders,&#13;
sum(food_temperature_orders_vd) as FT_orders,&#13;
sum(spilled_food_orders_vd) as SP_orders,&#13;
&#13;
sum(missing_item_orders + wrong_item_orders + wrong_order_orders + food_quality_orders + food_temperature_orders_vd + spilled_food_orders_vd)/sum(confirmed_orders) as inaccuracy,&#13;
&#13;
&#13;
from orders o&#13;
LEFT JOIN refunds AS r&#13;
ON o.registered_date = r.original_order_date&#13;
AND o.country_code = r.country&#13;
AND o.partner_id = r.partner_id&#13;
where o.business_type_name not in (&quot;Courier&quot;, &quot;Courier Business&quot;)&#13;
Group by all</relation>
          <relation connection='bigquery.00n2yme0tfbll71eqi59u1omfvbi' name='base_ccare_performance' table='[peya-delivery-and-support.user_lucas_bejarano].[base_ccare_performance]' type='table' />
