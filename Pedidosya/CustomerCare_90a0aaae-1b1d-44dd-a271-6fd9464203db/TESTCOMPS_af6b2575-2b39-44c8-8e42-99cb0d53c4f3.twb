            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:business_type (base_ccare_performance):nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:business_type (base_ccare_performance):nk]' member='&quot;COURIER&quot;' />
                <groupfilter function='member' level='[none:business_type (base_ccare_performance):nk]' member='%null%' />
              </groupfilter>
            </groupfilter>
          </filter>
