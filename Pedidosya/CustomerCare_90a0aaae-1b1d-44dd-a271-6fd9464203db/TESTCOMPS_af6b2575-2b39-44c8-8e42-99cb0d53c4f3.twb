    <worksheet name='INNA &amp; PDI'>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column datatype='string' name='[CCR]' role='dimension' type='nominal' />
            <column datatype='string' name='[CCR_group]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[CCR]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Cancelation&quot;'>
                  <value>&quot;cancel&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Delayed Order&quot;'>
                  <value>&quot;delayed order&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;PDI&quot;'>
                  <value>&quot;PDI&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='COR DATE (base ccare performance)' datatype='date' name='[COR_DATE (base_ccare_performance)]' role='dimension' type='ordinal' />
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='% Innacuracy' datatype='real' default-format='p0.00%' name='[Calculation_1233141932464852993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inaccurate_orders])/SUM([confirmed_orders])' />
            </column>
            <column caption='DATE_FILTER' datatype='string' name='[Calculation_796855685229428743]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [COR_DATE (base_ccare_performance)])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR_DATE (base_ccare_performance)])), 2)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [COR_DATE (base_ccare_performance)])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [COR_DATE (base_ccare_performance)]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [COR_DATE (base_ccare_performance)]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [COR_DATE (base_ccare_performance)]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [COR_DATE (base_ccare_performance)]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([COR_DATE (base_ccare_performance)])&#13;&#10;END' />
            </column>
            <column caption='% Compensated Orders' datatype='real' default-format='p0.00%' name='[Frequency refunds (copia)_2211548931080585220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([COR issued])/SUM([Orders OD Confirmed])&#13;&#10;&#13;&#10;SUM([COR_issued])/SUM([total_orders])' />
            </column>
            <column caption='Business Type (Base Ccare Performance)' datatype='string' name='[business_type (base_ccare_performance)]' role='dimension' type='nominal' />
            <column datatype='integer' name='[confirmed_orders]' role='measure' type='quantitative' />
            <column caption='Country Code (Base Ccare Performance)' datatype='string' name='[country_code (base_ccare_performance)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[inaccurate_orders]' role='measure' type='quantitative' />
            <column-instance column='[COR_DATE (base_ccare_performance)]' derivation='None' name='[none:COR_DATE (base_ccare_performance):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_796855685229428743]' derivation='None' name='[none:Calculation_796855685229428743:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_type (base_ccare_performance)]' derivation='None' name='[none:business_type (base_ccare_performance):nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code (base_ccare_performance)]' derivation='None' name='[none:country_code (base_ccare_performance):nk]' pivot='key' type='nominal' />
            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:qk]' pivot='key' type='quantitative' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1233141932464852993]' derivation='User' name='[usr:Calculation_1233141932464852993:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Frequency refunds (copia)_2211548931080585220]' derivation='User' name='[usr:Frequency refunds (copia)_2211548931080585220:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
