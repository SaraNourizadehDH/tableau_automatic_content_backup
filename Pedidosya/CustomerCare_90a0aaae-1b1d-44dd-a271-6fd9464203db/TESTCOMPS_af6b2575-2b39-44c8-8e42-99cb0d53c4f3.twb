      <column caption='Total Cost Compensations [€]' datatype='real' name='[Calculation_289356302570102784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_amount_used_EU_NO_IVA (base_ccare_performance)])' />
