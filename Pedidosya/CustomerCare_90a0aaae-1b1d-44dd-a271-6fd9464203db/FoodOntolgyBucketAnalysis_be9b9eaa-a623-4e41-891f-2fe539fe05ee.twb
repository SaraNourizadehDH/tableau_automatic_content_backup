      </column>
      <column caption='CSAT SSF' datatype='real' name='[Calculation_1775544194913275904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sat_ssf_fo]) / SUM([resp_ssf_fo])' />
      </column>
      <column caption='qReorder' datatype='real' name='[Calculation_1775544194913738753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorder1H]) / SUM([totalorders_reorder])' />
      </column>
      <column caption='Reorder 1D' datatype='real' name='[Calculation_1775544194913923074]' role='measure' type='quantitative'>
