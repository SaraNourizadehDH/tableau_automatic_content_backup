      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.09ybwrj19jrdii1cxb1og0qfqaqh].[sum:resp_ssf_fo:qk]&quot;' value='Total responses ' />
          <alias key='&quot;[federated.09ybwrj19jrdii1cxb1og0qfqaqh].[sum:sat_ssf_fo:qk]&quot;' value='Positive sat' />
