      </column>
      <column caption='Retention' datatype='real' name='[Calculation_1775544194929831942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users]) / LOOKUP(SUM([users]),FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='%Share orders' datatype='real' name='[Calculation_1775544194935193607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) / SUM([total_orders])' />
      </column>
      <column caption='orders fix' datatype='integer' name='[Calculation_1775544194936709128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year_month]: SUM([total_orders])}' />
      </column>
