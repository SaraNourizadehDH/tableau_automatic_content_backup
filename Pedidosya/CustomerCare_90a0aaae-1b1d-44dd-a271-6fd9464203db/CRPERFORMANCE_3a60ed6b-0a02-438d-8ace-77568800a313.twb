    <worksheet name='GRAL: TABLE 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Noto Sans Lao' fontsize='10'>Orders Confirmed / AFV  - Operative metrics </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity v2' datatype='string' name='[Granularity (copia 2)_2135832147632836622]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Euros' caption='Moneda' datatype='integer' name='[Granularity (copia)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Local Currency' />
                <alias key='2' value='Euros' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column caption='AFV Dinamic' datatype='real' default-format='c&quot;$ &quot;#,##0.00;-&quot;$ &quot;#,##0.00' name='[AFV_LC (copia)_1654228465096192002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([gfv_lc])/SUM([Calculation_2221400567166021632])&#13;&#10;WHEN 2 THEN SUM([gfv_eu])/SUM([Calculation_2221400567166021632])&#13;&#10;END' />
            </column>
            <column caption='CCR Dinamic' datatype='string' default-format='C11274%' name='[AV COR Dinamic (copia)_2135832140618502155]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [comp_or_ref]&#13;&#10;WHEN &apos;Compensation&apos; THEN [CCR_group]&#13;&#10;WHEN &apos;Refunds&apos; THEN [CCR_REFUNDS]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[CCR_REFUNDS]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ccr]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Food quality&quot;'>
                  <value>&quot;food quality&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Food temperature&quot;'>
                  <value>&quot;food temperature&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Missing item&quot;'>
                  <value>&quot;missing item&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Spilled food&quot;'>
                  <value>&quot;spilled food&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Wrong item&quot;'>
                  <value>&quot;wrong item&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Wrong order&quot;'>
                  <value>&quot;wrong order&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='CCR_COMPS' datatype='string' name='[CCR_group]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ccr]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Cancelation&quot;'>
                  <value>&quot;cancel&quot;</value>
                  <value>&quot;cancelation&quot;</value>
                  <value>&quot;order marked as delivered but didn&apos;t receive&quot;</value>
                  <value>&quot;order not delivered&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Delayed Order&quot;'>
                  <value>&quot;delayed order&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;PDI&quot;'>
                  <value>&quot;food quality&quot;</value>
                  <value>&quot;item unavailable for pickup&quot;</value>
                  <value>&quot;missing item&quot;</value>
                  <value>&quot;PDI&quot;</value>
                  <value>&quot;wrong item&quot;</value>
                  <value>&quot;wrong order&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='innacuracy_orders' datatype='integer' name='[Calculation_2135832138092900355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([ccr] IN (&apos;missing item&apos;,&apos;wrong item&apos;,&apos;wrong order&apos;,&apos;food quality&apos;,&apos;food temperature&apos;,&apos;spilled food&apos;) AND [comp_or_ref] != &apos;Refunds&apos;) &#13;&#10;THEN [COR_issued] &#13;&#10;END' />
            </column>
            <column caption='Innacuracy' datatype='real' default-format='p0.00%' name='[Calculation_2135832138093858820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2135832138092900355])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2221400567168610307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Orders OD Confirmed (copia)_2221400567168536578])/SUM([total_orders])' />
            </column>
            <column caption='OL_COMPS' datatype='real' default-format='p0.00%' name='[Calculation_2959709387536826369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='DATE_FILTER (V2)' datatype='string' name='[DATE_FILTER (copia)_2135832147633020943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Mercado&apos;) THEN  // New: Mercados&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([country_code])&#13;&#10;END' />
            </column>
            <column caption='Orders OD Rejected' datatype='integer' name='[Orders OD Confirmed (copia)_2221400567168536578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] != &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='Ccr' datatype='string' name='[ccr]' role='dimension' type='nominal' />
            <column caption='Comp Or Ref' datatype='string' name='[comp_or_ref]' role='dimension' type='nominal' />
            <column caption='Cor Destination' datatype='string' name='[cor_destination]' role='dimension' type='nominal' />
            <column caption='Cor Source' datatype='string' name='[cor_source]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Gfv Eu' datatype='real' name='[gfv_eu]' role='measure' type='quantitative' />
            <column caption='Gfv Lc' datatype='real' name='[gfv_lc]' role='measure' type='quantitative' />
            <column-instance column='[AV COR Dinamic (copia)_2135832140618502155]' derivation='None' name='[none:AV COR Dinamic (copia)_2135832140618502155:nk]' pivot='key' type='nominal' />
            <column-instance column='[DATE_FILTER (copia)_2135832147633020943]' derivation='None' name='[none:DATE_FILTER (copia)_2135832147633020943:nk]' pivot='key' type='nominal' />
            <column-instance column='[ccr]' derivation='None' name='[none:ccr:nk]' pivot='key' type='nominal' />
            <column-instance column='[cor_destination]' derivation='None' name='[none:cor_destination:nk]' pivot='key' type='nominal' />
            <column-instance column='[cor_source]' derivation='None' name='[none:cor_source:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vertical_group (base_ccare)]' derivation='None' name='[none:vertical_group (base_ccare):nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_group]' derivation='None' name='[none:vertical_group:nk]' pivot='key' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Orders Late' datatype='integer' name='[orders_late]' role='measure' type='quantitative' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2221400567166021632]' derivation='Sum' name='[sum:Calculation_2221400567166021632:qk]' pivot='key' type='quantitative' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[AFV_LC (copia)_1654228465096192002]' derivation='User' name='[usr:AFV_LC (copia)_1654228465096192002:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2135832138093858820]' derivation='User' name='[usr:Calculation_2135832138093858820:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2221400567168610307]' derivation='User' name='[usr:Calculation_2221400567168610307:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2959709387536826369]' derivation='User' name='[usr:Calculation_2959709387536826369:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Group (Base Ccare)' datatype='string' name='[vertical_group (base_ccare)]' role='dimension' type='nominal' />
            <column caption='Vertical Group' datatype='string' name='[vertical_group]' role='dimension' type='nominal' />
