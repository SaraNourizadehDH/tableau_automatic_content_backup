            <column-instance column='[Calculation_796855685241364492]' derivation='User' name='[usr:Calculation_796855685241364492:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total Cost Compensations [LC]] (copia)_726486942172618753]' derivation='User' name='[usr:Total Cost Compensations [LC]] (copia)_726486942172618753:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Group (Base Ccare)' datatype='string' name='[vertical_group (base_ccare)]' role='dimension' type='nominal' />
            <column caption='Vertical Group' datatype='string' name='[vertical_group]' role='dimension' type='nominal' />
