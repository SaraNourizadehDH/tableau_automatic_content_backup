      <column caption='CPO RECUPEROS EU NETO' datatype='real' name='[CPO RECUPEROS EU (copia)_1742611611597139983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CPO REFUNDS (copia)_289356302572883972] - [CPO RECUPEROS (copia)_289356302575788039]' />
