        <calculation class='tableau' formula='sum([COR_amount_used_EU_NO_IVA])/sum([Calculation_2221400567166021632])' />
      </column>
      <column caption='MoM COR' datatype='real' name='[Calculation_1141381057725247488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Comps_redeemed])- LOOKUP(SUM([Comps_redeemed]), -1)&#13;&#10;&#13;&#10;1-(LOOKUP(SUM([Calculation_1141381057727172609]), -1)/SUM([Calculation_1141381057727172609]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Comps_redeemed' datatype='real' name='[Calculation_1141381057727172609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [comp_or_ref] = &apos;Compensation&apos; THEN [COR_amount_used_EU_NO_IVA] ELSE 0 END' />
      </column>
      <column caption='Refunds_redeemed' datatype='real' name='[Calculation_1141381057727500290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [comp_or_ref] = &apos;Refunds&apos; THEN [COR_amount_used_EU_NO_IVA] ELSE 0 END' />
      </column>
      <column caption='Var_comps_redeemed' datatype='real' name='[Calculation_1141381057727684611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((SUM([Calculation_1141381057727172609]) - LOOKUP(SUM([Calculation_1141381057727172609]), -1)) / ABS(LOOKUP(SUM([Calculation_1141381057727172609]), -1)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='recuperables' datatype='integer' name='[Calculation_1147854989563711524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF [CCR (care performance)] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;//THEN [COR issued (care performance)] ELSE 0 END&#13;&#10;&#13;&#10;IF &#13;&#10;([ccr] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;AND [vertical_group (base_ccare)] IN (&apos;FOOD&apos;,&apos;LOCAL STORE&apos;,&apos;VD&apos;)) &#13;&#10;//OR //traer valores VD&#13;&#10;//([CCR] IN (&quot;missing item&quot;, &quot;wrong item&quot;, &quot;wrong order&quot;, &quot;food quality&quot;) &#13;&#10;//AND [business_type (CoR_care_performance_V2)] IN (&apos;VD&apos;) AND [Cor Date] &gt;= DATE(&apos;2024-12-01&apos;))&#13;&#10;THEN [COR_issued] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='% Refunds trasladables al partner' datatype='real' name='[Calculation_1147854989564018725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1147854989563711524])/sum([COR_issued])' />
      </column>
      <column caption='Alcance' datatype='real' name='[Calculation_1147854989570818089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount])/sum([COR_amount_issued_LC])' />
      </column>
      <column caption='DATE_PRUEBA' datatype='string' name='[Calculation_1654228465076785152]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Dates from &quot;+&#13;&#10;&#13;&#10;str(window_min(min(datetrunc(&apos;day&apos;,[cor_date])))) +&quot; to &quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='TOTAL COST C+R DINAMIC' datatype='real' name='[Calculation_1654228465097834499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([COR_amount_used_LC_NO_IVA])-SUM([amount])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])-SUM([amount_EU])&#13;&#10;END' />
      </column>
      <column caption='Recuperos LC NETO' datatype='real' name='[Calculation_1742611611595669516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2211548931081576453] -SUM([amount])' />
      </column>
      <column caption='FREQ_COR' datatype='real' default-format='p0.00%' name='[Calculation_2135832138088460289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_issued])/SUM([total_orders])' />
      </column>
      <column caption='innacuracy_orders' datatype='integer' name='[Calculation_2135832138092900355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([ccr] IN (&apos;missing item&apos;,&apos;wrong item&apos;,&apos;wrong order&apos;,&apos;food quality&apos;,&apos;food temperature&apos;,&apos;spilled food&apos;) AND [comp_or_ref] != &apos;Refunds&apos;) &#13;&#10;THEN [COR_issued] &#13;&#10;END' />
      </column>
      <column caption='Innacuracy' datatype='real' default-format='p0.00%' name='[Calculation_2135832138093858820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2135832138092900355])/SUM([Calculation_2221400567166021632])' />
      </column>
      <column caption='Relacion_cancel_fr' datatype='real' default-format='p0.00%' name='[Calculation_2135832138127745029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2135832138088460289]/[Calculation_2221400567168610307]' />
      </column>
      <column caption='% Refunded Orders' datatype='real' name='[Calculation_2211548931079995395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_issued])/SUM([Calculation_2221400567166021632])' />
      </column>
      <column caption='Total Cost Refunds [LC] ' datatype='real' name='[Calculation_2211548931081576453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_amount_used_LC_NO_IVA])' />
      </column>
      <column caption='Total Cost Compensations [LC]' datatype='real' name='[Calculation_2211548931083845639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_amount_used_LC_NO_IVA])' />
      </column>
      <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2221400567168610307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Orders OD Confirmed (copia)_2221400567168536578])/SUM([total_orders])' />
      </column>
      <column caption='Redemption Rate' datatype='real' default-format='p0.00%' name='[Calculation_2573525752163577856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_used])/SUM([COR_issued])' />
      </column>
      <column caption='Total Cost Compensations [€]' datatype='real' name='[Calculation_289356302570102784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_amount_used_EU_NO_IVA])' />
      </column>
      <column caption='OL_COMPS' datatype='real' default-format='p0.00%' name='[Calculation_2959709387536826369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_late])/SUM([Calculation_2221400567166021632])' />
      </column>
      <column caption='AV / AFV' datatype='real' default-format='p0.00%' name='[Calculation_796855684984631299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN [Calculation_796855684985458692] / [Calculation_796855685225062406]&#13;&#10;WHEN 2 THEN [AV COR (copia)_1742611610564624386] / [Calculation_796855685302222871]&#13;&#10;END' />
      </column>
      <column caption='AV COR LC' datatype='real' default-format='C11274%' name='[Calculation_796855684985458692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([COR_amount_used_LC_NO_IVA])/SUM([COR_used])' />
      </column>
      <column caption='AFV_LC' datatype='real' name='[Calculation_796855685225062406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_lc])/SUM([Calculation_2221400567166021632])' />
      </column>
      <column caption='DATE_FILTER' datatype='string' name='[Calculation_796855685229428743]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [cor_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [cor_date])), 2)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [cor_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [cor_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [cor_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [cor_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [cor_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([cor_date])&#13;&#10;END' />
      </column>
      <column caption='CPO REFUNDS LC' datatype='real' name='[Calculation_796855685240500232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([COR_amount_used_LC_NO_IVA])/sum([Calculation_2221400567166021632])' />
      </column>
      <column caption='CPO SPILLED LC' datatype='real' name='[Calculation_796855685240623113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([COR_amount_used_LC_NO_IVA])-sum([amount]))/sum([Calculation_2221400567166021632])' />
      </column>
      <column caption='CPO RECUPEROS LC' datatype='real' name='[Calculation_796855685241036810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount])/sum([Calculation_2221400567166021632])' />
      </column>
