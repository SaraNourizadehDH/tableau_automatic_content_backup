        <calculation class='tableau' formula='[Calculation_796855685241241611]/[Calculation_796855685225062406]' />
      </column>
      <column caption='CPO / AFV RECUPEROS' datatype='real' name='[Calculation_796855685241544717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_796855685241036810]/[Calculation_796855685225062406]' />
      </column>
      <column caption='CPO / AFV REFUNDS' datatype='real' name='[Calculation_796855685241663502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_796855685240500232]/[Calculation_796855685225062406]' />
      </column>
      <column caption='CPO SPILLED EU' datatype='real' name='[Calculation_796855685290811413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([COR_amount_used_EU_NO_IVA])-SUM([amount_EU]))/sum([Calculation_2221400567166021632])' />
      </column>
      <column caption='Prueba' datatype='real' name='[Calculation_796855685294026774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;All Countries&quot; THEN &#13;&#10;        SUM([COR_amount_used_EU_NO_IVA])-SUM([amount_EU])&#13;&#10;ELSE&#13;&#10;        SUM([COR_amount_used_LC_NO_IVA])-SUM([amount])&#13;&#10;END' />
      </column>
      <column caption='AFV_EU' datatype='real' name='[Calculation_796855685302222871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_eu])/SUM([Calculation_2221400567166021632])' />
      </column>
      <column caption='DATE_FILTER deprecado' datatype='string' name='[DATE_FILTER (copia)_1654228465079234561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// LOGICA ANTERIOR &#13;&#10;&#13;&#10;IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [cor_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [cor_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    // Muestra W + número de semana y el año&#13;&#10;    &quot;W&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;week&apos;, [cor_date])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [cor_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([cor_date])&#13;&#10;END' />
      </column>
      <column caption='DATE_FILTER (V2)' datatype='string' name='[DATE_FILTER (copia)_2135832147633020943]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Mercado&apos;) THEN  // New: Mercados&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([country_code])&#13;&#10;END' />
      </column>
      <column caption='DATE_FILTER NEW' datatype='string' name='[DATE_FILTER (copia)_416864477321637888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
      </column>
      <column caption='% Compensated Orders' datatype='real' name='[Frequency refunds (copia)_2211548931080585220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([COR issued])/SUM([Orders OD Confirmed])&#13;&#10;&#13;&#10;SUM([COR_issued])/SUM([total_orders])' />
      </column>
      <column caption='Montos Dinamic (DETAIL)' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Montos Dinamic (copia)_1792151211035656193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia 2)_2135832140544954376]&#13;&#10;WHEN 1 THEN SUM([COR_amount_issued_EU])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])&#13;&#10;WHEN 3 THEN SUM([COR_issued])&#13;&#10;WHEN 4 THEN SUM([COR_used])&#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>Values dinamics</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='CARE DINAMIC' datatype='string' default-format='c&quot;€&quot;#,##0,K;-&quot;€&quot;#,##0,K' name='[Montos Dinamic (copia)_2135832140961411085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Moneda (copia)]&#13;&#10;WHEN &quot;Compensation&quot; THEN [comp_or_ref]&#13;&#10;WHEN &quot;Refunds&quot; THEN [comp_or_ref]&#13;&#10;END' />
      </column>
      <column caption='Orders OD Confirmed (DETAIL)' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Orders OD Confirmed (copia)_1792151210986565632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
      </column>
      <column caption='Orders OD Rejected' datatype='integer' name='[Orders OD Confirmed (copia)_2221400567168536578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] != &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
      </column>
      <column caption='Recuperos EU NETO' datatype='real' name='[Recuperos LC (copia)_1742611611595866125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Cost Refunds [LC]]  (copia)_289356302571941890]-SUM([amount_EU])' />
      </column>
      <column caption='Relacion_delay_ol' datatype='real' default-format='p0.00%' name='[Relacion_cancel_fr (copia)_2135832138128789510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2135832138088460289]/[Calculation_2959709387536826369]' />
      </column>
      <column caption='Relacion_fd_innacuracy' datatype='real' default-format='p0.00%' name='[Relacion_delay_ol (copia)_2135832138128883719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2135832138088460289]/[Calculation_2135832138093858820]' />
