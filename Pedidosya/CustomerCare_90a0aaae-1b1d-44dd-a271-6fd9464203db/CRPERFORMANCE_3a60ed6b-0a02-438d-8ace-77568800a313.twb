    <worksheet name='GRAL: TABLE 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity v2' datatype='string' name='[Granularity (copia 2)_2135832147632836622]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Euros' caption='Moneda' datatype='integer' name='[Granularity (copia)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Local Currency' />
                <alias key='2' value='Euros' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column caption='AV COR Dinamic COMP' datatype='real' name='[AV COR (copia)_1742611610186936320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([COR_amount_used_LC_NO_IVA])/SUM([COR_used])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])/SUM([COR_used])&#13;&#10;END' />
            </column>
            <column caption='CCR Dinamic' datatype='string' default-format='C11274%' name='[AV COR Dinamic (copia)_2135832140618502155]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [comp_or_ref]&#13;&#10;WHEN &apos;Compensation&apos; THEN [CCR_group]&#13;&#10;WHEN &apos;Refunds&apos; THEN [CCR_REFUNDS]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[CCR_REFUNDS]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ccr]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Food quality&quot;'>
                  <value>&quot;food quality&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Food temperature&quot;'>
                  <value>&quot;food temperature&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Missing item&quot;'>
                  <value>&quot;missing item&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Spilled food&quot;'>
                  <value>&quot;spilled food&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Wrong item&quot;'>
                  <value>&quot;wrong item&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Wrong order&quot;'>
                  <value>&quot;wrong order&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='CCR_COMPS' datatype='string' name='[CCR_group]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ccr]' default='&quot;Otro&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Cancelation&quot;'>
                  <value>&quot;cancel&quot;</value>
                  <value>&quot;cancelation&quot;</value>
                  <value>&quot;order marked as delivered but didn&apos;t receive&quot;</value>
                  <value>&quot;order not delivered&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Delayed Order&quot;'>
                  <value>&quot;delayed order&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;PDI&quot;'>
                  <value>&quot;food quality&quot;</value>
                  <value>&quot;item unavailable for pickup&quot;</value>
                  <value>&quot;missing item&quot;</value>
                  <value>&quot;PDI&quot;</value>
                  <value>&quot;wrong item&quot;</value>
                  <value>&quot;wrong order&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='real' default-format='c&quot;€&quot;#,##0,K;-&quot;€&quot;#,##0,K' name='[COR_amount_used_EU_NO_IVA]' role='measure' type='quantitative' />
            <column caption='COR amount used LC NO IVA' datatype='real' name='[COR_amount_used_LC_NO_IVA]' role='measure' type='quantitative' />
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='COR used' datatype='integer' name='[COR_used]' role='measure' type='quantitative' />
            <column caption='CPO COMPS Dinamic' datatype='real' name='[CPO COMPS EU (copia)_726486942173065221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN sum([COR_amount_used_LC_NO_IVA])/sum([Calculation_2221400567166021632])&#13;&#10;WHEN 2 THEN sum([COR_amount_used_EU_NO_IVA])/sum([Calculation_2221400567166021632])&#13;&#10;END' />
            </column>
            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='AFV_LC' datatype='real' name='[Calculation_796855685225062406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_lc])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='CPO COMPS LC' datatype='real' name='[Calculation_796855685241241611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([COR_amount_used_LC_NO_IVA])/sum([Calculation_2221400567166021632])' />
            </column>
            <column caption='CPO / AFV COMPS' datatype='real' name='[Calculation_796855685241364492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_796855685241241611]/[Calculation_796855685225062406]' />
            </column>
            <column caption='DATE_FILTER (V2)' datatype='string' name='[DATE_FILTER (copia)_2135832147633020943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;ELSEIF ([Parameters].[Granularity (copia 2)_2135832147632836622] = &apos;Mercado&apos;) THEN  // New: Mercados&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([country_code])&#13;&#10;END' />
            </column>
            <column caption='Total Cost Compensations Dinamic' datatype='real' name='[Total Cost Compensations [LC]] (copia)_726486942172618753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN SUM([COR_amount_used_LC_NO_IVA])&#13;&#10;WHEN 2 THEN SUM([COR_amount_used_EU_NO_IVA])&#13;&#10;END' />
            </column>
