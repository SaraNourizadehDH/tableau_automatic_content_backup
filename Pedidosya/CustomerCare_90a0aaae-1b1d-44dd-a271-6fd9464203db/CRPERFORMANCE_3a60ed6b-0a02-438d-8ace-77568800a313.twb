            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[AV COR (copia)_1742611611567230979]' derivation='User' name='[usr:AV COR (copia)_1742611611567230979:qk]' pivot='key' type='quantitative' />
