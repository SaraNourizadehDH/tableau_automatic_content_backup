      <column caption='CPO REFUNDS Dinamic' datatype='real' name='[CPO COMPS Dinamic (copia)_726486942174011399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN sum([COR_amount_used_LC_NO_IVA])/sum([Calculation_2221400567166021632])&#13;&#10;WHEN 2 THEN sum([COR_amount_used_EU_NO_IVA])/sum([Calculation_2221400567166021632])&#13;&#10;END' />
      </column>
      <column caption='CPO RECUPEROS Dinamic ' datatype='real' name='[CPO COMPS Dinamic (copia)_726486942178865160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(CASE [Parameters].[Granularity (copia)]&#13;&#10;WHEN 1 THEN sum([amount])/sum([Calculation_2221400567166021632])&#13;&#10;WHEN 2 THEN SUM([amount_EU])/sum([Calculation_2221400567166021632])&#13;&#10;END)' />
