      <column caption='CPO RECUPEROS LC NETO' datatype='real' name='[CPO RECUPEROS LC (copia)_1742611611596873742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_796855685240500232] - [Calculation_796855685241036810]' />
