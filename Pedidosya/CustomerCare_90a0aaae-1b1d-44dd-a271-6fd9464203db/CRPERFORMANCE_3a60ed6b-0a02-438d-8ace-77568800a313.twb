              <calculation class='tableau' formula='CASE [comp_or_ref]&#13;&#10;WHEN &apos;Compensation&apos; THEN [CCR_group]&#13;&#10;WHEN &apos;Refunds&apos; THEN [CCR_REFUNDS]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[CCR_REFUNDS]' role='dimension' type='nominal'>
