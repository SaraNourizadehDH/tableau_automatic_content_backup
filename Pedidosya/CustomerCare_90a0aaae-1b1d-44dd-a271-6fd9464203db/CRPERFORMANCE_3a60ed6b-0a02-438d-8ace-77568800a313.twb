            </column>
            <column caption='[CPO / AFV REFUNDS] - [CPO / AFV RECUPEROS]' datatype='real' name='[Calculation_1742611611581194247]' role='measure' type='quantitative' user:unnamed='Recuperos Netos'>
              <calculation class='tableau' formula='[Calculation_796855685241663502] - [Calculation_796855685241544717]' />
            </column>
            <column caption='[Total Cost Refunds Dinamic] + [Recuperos Dinamic]' datatype='real' name='[Calculation_1742611611661738005]' role='measure' type='quantitative' user:unnamed='Recuperos Netos'>
              <calculation class='tableau' formula='[Total Cost Compensations Dinamic (copia)_726486942172946436] + [AFV Dinamic (copia)_726486942180073483]' />
            </column>
            <column caption='[CPO REFUNDS Dinamic] + [CPO RECUPEROS Dinamic ]' datatype='real' name='[Calculation_1742611611661910038]' role='measure' type='quantitative' user:unnamed='Recuperos Netos'>
              <calculation class='tableau' formula='[CPO COMPS Dinamic (copia)_726486942174011399] + [CPO COMPS Dinamic (copia)_726486942178865160]' />
            </column>
            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
