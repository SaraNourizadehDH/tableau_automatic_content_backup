    <worksheet name='COMP/INNA'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='8'><![CDATA[<[Parameters].[Parámetro 1]> View: ]]></run>
            <run fontcolor='#ffffff' fontsize='8'>Free Delivey Freq. &amp; Innacuracy</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CoR_care_performance_V2+ (user_lucas_bejarano)' name='federated.1w5o5p21a6qqgu10i7r2a0hdo138' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5o5p21a6qqgu10i7r2a0hdo138'>
            <column caption='COR issued' datatype='integer' name='[COR_issued]' role='measure' type='quantitative' />
            <column caption='FREQ_COR' datatype='real' default-format='p0.00%' name='[Calculation_2135832138088460289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COR_issued])/SUM([total_orders])' />
            </column>
            <column caption='innacuracy_orders' datatype='integer' name='[Calculation_2135832138092900355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([ccr] IN (&apos;missing item&apos;,&apos;wrong item&apos;,&apos;wrong order&apos;,&apos;food quality&apos;,&apos;food temperature&apos;,&apos;spilled food&apos;) AND [comp_or_ref] != &apos;Refunds&apos;) &#13;&#10;THEN [COR_issued] &#13;&#10;END' />
            </column>
            <column caption='Innacuracy' datatype='real' default-format='p0.00%' name='[Calculation_2135832138093858820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2135832138092900355])/SUM([Calculation_2221400567166021632])' />
            </column>
            <column caption='Orders OD Confirmed' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2221400567166021632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([delivery_type] = &apos;OD&apos; AND [order_status] = &apos;CONFIRMED&apos;) &#13;&#10;THEN [total_orders] &#13;&#10;END' />
            </column>
            <column caption='DATE_FILTER NEW' datatype='string' name='[DATE_FILTER (copia)_416864477321637888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parámetro 1] = &apos;Monthly&apos;) THEN&#13;&#10;    // Muestra el mes y el año en formato MM-YYYY&#13;&#10;    //RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [COR DATE (care performance)])), 2) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [COR DATE (care performance)]))&#13;&#10;// Muestra el mes y el año en formato YYYY-MM&#13;&#10;STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;Quarterly&apos; THEN&#13;&#10;    // Muestra el trimestre en formato Q1, Q2, etc.&#13;&#10;    &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Weekly&apos;) THEN&#13;&#10;    STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2) + &quot;-&quot; +&#13;&#10;    RIGHT(&quot;0&quot; + STR(DATEPART(&apos;day&apos;, DATETRUNC(&apos;week&apos;, [registered_date]))), 2)&#13;&#10;ELSEIF ([Parameters].[Parámetro 1] = &apos;Daily&apos;) THEN  // Vista diaria&#13;&#10;    // Muestra el día en formato DD-MM-YYYY&#13;&#10;    STR([registered_date])&#13;&#10;END' />
            </column>
            <column caption='Relacion_fd_innacuracy' datatype='real' default-format='p0.00%' name='[Relacion_delay_ol (copia)_2135832138128883719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2135832138088460289]/[Calculation_2135832138093858820]' />
            </column>
            <column caption='Ccr' datatype='string' name='[ccr]' role='dimension' type='nominal' />
            <column caption='Comp Or Ref' datatype='string' name='[comp_or_ref]' role='dimension' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column-instance column='[DATE_FILTER (copia)_416864477321637888]' derivation='None' name='[none:DATE_FILTER (copia)_416864477321637888:nk]' pivot='key' type='nominal' />
            <column-instance column='[ccr]' derivation='None' name='[none:ccr:nk]' pivot='key' type='nominal' />
            <column-instance column='[comp_or_ref]' derivation='None' name='[none:comp_or_ref:nk]' pivot='key' type='nominal' />
            <column-instance column='[registered_date]' derivation='None' name='[none:registered_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vertical_group (base_ccare)]' derivation='None' name='[none:vertical_group (base_ccare):nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_group]' derivation='None' name='[none:vertical_group:nk]' pivot='key' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Registered Date' datatype='date' name='[registered_date]' role='dimension' type='ordinal' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2135832138088460289]' derivation='User' name='[usr:Calculation_2135832138088460289:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2135832138093858820]' derivation='User' name='[usr:Calculation_2135832138093858820:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Relacion_delay_ol (copia)_2135832138128883719]' derivation='User' name='[usr:Relacion_delay_ol (copia)_2135832138128883719:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Group (Base Ccare)' datatype='string' name='[vertical_group (base_ccare)]' role='dimension' type='nominal' />
            <column caption='Vertical Group' datatype='string' name='[vertical_group]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1w5o5p21a6qqgu10i7r2a0hdo138].[none:ccr:nk]' filter-group='11'>
            <groupfilter function='level-members' level='[none:ccr:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
