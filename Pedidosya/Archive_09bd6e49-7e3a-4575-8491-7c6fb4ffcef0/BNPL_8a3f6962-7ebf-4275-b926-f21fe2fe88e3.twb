when qty_partial_refunded_collections_others &gt;&gt; 0 and first_collection_attempt_utc_others = last_collection_attempt_utc_others and first_collection_attempt_utc_next_month is null then &apos;COLLECTED &amp; PARTIAL REFUNDED DELAYED AT FIRST ATTEMPT&apos; &#13;
when qty_partial_refunded_collections_next_month &gt;&gt; 0 then &apos;COLLECTED &amp; PARTIAL REFUNDED MULTIPLE ATTEMPTS&apos;&#13;
when qty_partial_refunded_collections_others &gt;&gt; 0 then &apos;COLLECTED &amp; PARTIAL REFUNDED DELAYED MULTIPLE ATTEMPTS&apos;&#13;
when has_collection_attempts then &apos;COLLECTION FAILURE&apos;&#13;
else &apos;NO COLLECTION ATTEMPTS&apos; end as collection,&#13;
count(distinct(purchase_id)) as total_offers,&#13;
round(sum(net_amount_eu),0) as amount_eu,&#13;
sum(qty_success_collections_next_month+qty_success_collections_others+qty_chargedback_collections_next_month+qty_chargedback_collections_others+qty_partial_refunded_collections_next_month+qty_partial_refunded_collections_others+qty_refunded_collections_next_month+qty_refunded_collections_others+qty_failed_collections_next_month+qty_failed_collections_others) as total_collection_tries&#13;
FROM `peya-datamarts-pro.dm_fintech.fact_consumer_credit_order_recovery` b&#13;
