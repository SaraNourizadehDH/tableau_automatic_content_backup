  <worksheets>
    <worksheet name='% Collected Delayed'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Book' fontsize='9'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Payments - Installments' name='federated.0bnfdh10kwtycd13nl2na0yr8d2z' />
          </datasources>
          <datasource-dependencies datasource='federated.0bnfdh10kwtycd13nl2na0yr8d2z'>
            <column caption='% Qty NO COLLECTION ATTEMPTS' datatype='real' name='[% DEBT QTY (copia)_24769815196536833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Qty DEBT BNPL  (copia)_24769815196340224]/[Calculation_807551723973705728]' />
            </column>
            <column caption='% Qty DELAYED COLLECTIONS' datatype='real' name='[% Qty NO COLLECTION ATTEMPTS (copia)_1291688693508857856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Qty NO COLLECTION ATTEMPTS (copia)_1291688693508902913]/[Calculation_807551723973705728]' />
            </column>
            <column caption='min(0)' datatype='integer' name='[Calculation_1562186161753366538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(0)' />
            </column>
            <column caption='Qty BNPL Orders' datatype='integer' name='[Calculation_807551723973705728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(case [conversion] when &quot;YES_BY_BNPL&quot;&#13;&#10;THEN [total_offers] ELSE 0 END)' />
