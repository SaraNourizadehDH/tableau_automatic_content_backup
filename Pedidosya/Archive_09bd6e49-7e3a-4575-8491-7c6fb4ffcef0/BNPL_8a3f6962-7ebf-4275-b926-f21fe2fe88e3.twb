            <column caption='Qty CBK BNPL' datatype='integer' name='[Amount CBK BNPL €  (copia)_807551724000063501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [conversion] = &quot;YES_BY_BNPL&quot; and [date] &lt; DATETRUNC(&quot;month&quot;,TODAY()) &#13;&#10;and collection IN (&quot;COLLECTED &amp; CHARGEDBACK AT FIRST ATTEMPT&quot;,&#13;&#10;&quot;COLLECTED &amp; CHARGEDBACK DELAYED AT FIRST ATTEMPT&quot;,&#13;&#10;&quot;COLLECTED &amp; CHARGEDBACK MULTIPLE ATTEMPTS&quot;,&#13;&#10;&quot;COLLECTED &amp; CHARGEDBACK DELAYED MULTIPLE ATTEMPTS&quot;) then [total_offers] ELSE 0 END)' />
