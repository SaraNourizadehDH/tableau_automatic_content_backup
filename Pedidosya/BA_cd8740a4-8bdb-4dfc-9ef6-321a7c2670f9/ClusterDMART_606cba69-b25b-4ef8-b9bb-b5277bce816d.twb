      <column caption='BasketSize' datatype='real' name='[Calculation_2070811454433546240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_products])/COUNTD([order_id1])' />
      </column>
      <column caption='Cluster AFV' datatype='string' name='[Calculation_2070811454439895041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders_kpi_afv_dmarts_euros]&lt;=10 then &quot;0 to 10 (LOW)&quot;&#13;&#10;ELSEIF [orders_kpi_afv_dmarts_euros]&lt;=20 then &quot;10 to 20(MID)&quot;&#13;&#10;else  &quot;20+(HIGH)&quot; END' />
      </column>
      <column caption='Type GPO' datatype='string' name='[Calculation_2070811454465019907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [gpo_dmart]&lt;0 then &quot;Negativo&quot; else &quot;Positivo&quot; END' />
      </column>
      <column caption='Cluster AFV V2' datatype='string' name='[Cluster AFV (copy)_2070811454441431042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders_kpi_afv_dmarts_euros]&lt;=10 then &quot;0 to 10 (LOW)&quot;&#13;&#10;ELSEIF [orders_kpi_afv_dmarts_euros]&lt;=20 then &quot;10 to 20(MID)&quot;&#13;&#10;ELSEIF [orders_kpi_afv_dmarts_euros]&lt;=30 then &quot;20 to 30(HIGH)&quot;&#13;&#10;else  &quot;30+(KING)&quot; END' />
