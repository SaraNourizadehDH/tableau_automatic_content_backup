          <object caption='Consulta SQL personalizada2' id='_316A10940D5448F29373B54EDF586E3E'>
            <properties context=''>
              <relation connection='bigquery.0tiefot0khvz3i16t1sgp1ho7mvq' name='Consulta SQL personalizada2' type='text'><![CDATA[WITH max_rate AS (
 SELECT
  dcd.country_id,
  dce.rate_eu

  FROM  `peya-bi-tools-pro.il_core.dim_currency_exchange` dce
  LEFT JOIN`peya-bi-tools-pro.il_core.dim_country` dcd 
		   ON dce.currency_id = dcd.currency_id
			 AND active IS TRUE

  WHERE
    DATE(dce.currency_exchange_date) = DATE_SUB(DATE_TRUNC(CURRENT_DATE,month), INTERVAL 1 MONTH)

)



SELECT
  cd.country_name,
  cd.country_id,
  DATE(ce.currency_exchange_date) mes,
  ce.rate_eu,
  mr.rate_eu as max_rate_eu
  

FROM  `peya-bi-tools-pro.il_core.dim_currency_exchange` ce
LEFT JOIN`peya-bi-tools-pro.il_core.dim_country` cd 
		   ON ce.currency_id = cd.currency_id
			 AND active IS TRUE
LEFT JOIN  max_rate mr
  ON cd.country_id = mr.country_id


WHERE  1=1
  AND DATE(ce.currency_exchange_date)>>= "2022-05-01"
  AND DATE(ce.currency_exchange_date)<<= DATE_TRUNC(CURRENT_DATE,month)
  AND cd.country_name IS NOT NULL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_316A10940D5448F29373B54EDF586E3E' table='[Extract].[_316A10940D5448F29373B54EDF586E3E]' type='table' />
            </properties>
          </object>
          <object caption='Consulta SQL personalizada3' id='_39A160202ABA49D985418FAAFA0F439E'>
            <properties context=''>
              <relation connection='bigquery.0nqxmk31yp9fir1bcjc3u0hqvbsy' name='Consulta SQL personalizada3' type='text'>SELECT * FROM `peya-fraud-and-fintech.user_maria_borga.bad_debt_sap`</relation>
            </properties>
            <properties context='extract'>
              <relation name='_39A160202ABA49D985418FAAFA0F439E' table='[Extract].[_39A160202ABA49D985418FAAFA0F439E]' type='table' />
            </properties>
          </object>
