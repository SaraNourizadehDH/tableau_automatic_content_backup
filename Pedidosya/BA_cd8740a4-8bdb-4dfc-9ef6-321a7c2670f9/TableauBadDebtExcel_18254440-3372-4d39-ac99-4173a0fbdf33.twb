      <column caption='Monto_Positivo_' datatype='real' name='[Calculation_883831486948421655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;[Parameters].[Parámetro 2]= &quot;Moneda Local&quot; then SUM([Calculation_883831486927597574])&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;&#13;&#10;[Parameters].[Parámetro 2]= &quot;Euro&quot; THEN SUM([Calculation_883831486927597574])/AVG([rate_eu])&#13;&#10;&#13;&#10;END' />
