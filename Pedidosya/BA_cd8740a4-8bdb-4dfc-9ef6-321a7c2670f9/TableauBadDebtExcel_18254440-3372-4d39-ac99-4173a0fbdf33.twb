    <worksheet name='Saldo_Provision_Aging_Apertura'>
      <table>
        <view>
          <datasources>
            <datasource caption='Base (Database cierre Julio 2023 final)' name='federated.0apmv3l02cen2k1cz56sb06wjhiv' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Tipodecambio' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Moneda Local&quot;'>
              <calculation class='tableau' formula='&quot;Moneda Local&quot;' />
            </column>
            <column caption='Aging_parametro' datatype='string' name='[Parámetro 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Aging &gt;180&quot;' value='Bucket &gt;180' />
                <alias key='&quot;Aging 0A30&quot;' value='Bucket 0A30' />
                <alias key='&quot;Aging 120A180&quot;' value='Bucket 120A180' />
                <alias key='&quot;Aging 30A60&quot;' value='Bucket 30A60' />
                <alias key='&quot;Aging 60A90&quot;' value='Bucket 60A90' />
                <alias key='&quot;Aging 90A120&quot;' value='Bucket 90A120' />
                <alias key='&quot;Aging A0&quot;' value='Bucket A0' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0apmv3l02cen2k1cz56sb06wjhiv'>
            <column caption='Tipo_filtro' datatype='string' name='[Calculation_1288873924206141443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tipo] = &quot;Deudor Generico&quot; OR [Tipo] = &quot;No tomar&quot; THEN &quot;Deudor genérico&quot; ELSE [Tipo] END' />
            </column>
            <column caption='SAP_ID&amp;Customer' datatype='string' name='[Calculation_1379227413651931152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([Customer]) + &quot;-&quot; + [Customer Name]' />
            </column>
            <column caption='provision_filtro' datatype='real' name='[Calculation_846676758347984896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parámetro 4] &#13;&#10;when &quot;All&quot; then sum(if [Calculation_883831486940090385] &gt; 0 then [Calculation_883831486940090385] end ) &#13;&#10;when &quot;Aging A0&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;A 0&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385]end )&#13;&#10;when &quot;Aging 0A30&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then[Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 30A60&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 60A90&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 90A120&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 120A180&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging &gt;180&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Prov A 0' datatype='real' name='[Calculation_846676758348869633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;A 0&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 0 A 30' datatype='real' name='[Calculation_846676758348976130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 30 A 60' datatype='real' name='[Calculation_846676758349860867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 90 A 120' datatype='real' name='[Calculation_846676758349971460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 120 A 180' datatype='real' name='[Calculation_846676758350102533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov &gt; 180' datatype='real' name='[Calculation_846676758350241798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov_Total' datatype='real' name='[Calculation_846676758350356487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_846676758348869633] + [Calculation_846676758348976130] + [Calculation_846676758349860867] + [Calculation_846676758350573576] + [Calculation_846676758349971460] + [Calculation_846676758350102533] + [Calculation_846676758350241798]' />
            </column>
            <column caption='Prov 60 A 90' datatype='real' name='[Calculation_846676758350573576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='1 - Calculo Por Vertical' datatype='real' name='[Calculation_883831486937956366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Tipo] = &quot;Prestamo&quot; THEN &#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN 0&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;elseIF [Tipo] = &quot;Multi&quot; AND [Positivos] = &quot;TRUE&quot;  THEN&#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN [Valores de campo de tabla dinámica] *0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN [Valores de campo de tabla dinámica] * 0.006 &#13;&#10;END&#13;&#10;&#13;&#10;ELSEIF [Tipo] &lt;&gt; &quot;Multi&quot; AND [Tipo] &lt;&gt; &quot;Dmart&quot;  AND [Positivos] = &quot;TRUE&quot; AND YEAR([Fecha Mes]) = 2023 AND MONTH([Fecha Mes]) &lt;= 10 THEN&#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN [Valores de campo de tabla dinámica]*0.015&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN [Valores de campo de tabla dinámica]*0.098&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN [Valores de campo de tabla dinámica]*0.1780&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN [Valores de campo de tabla dinámica]*0.4350&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN [Valores de campo de tabla dinámica]*0.5610&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN [Valores de campo de tabla dinámica]*0.6080&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN [Valores de campo de tabla dinámica]*1&#13;&#10;END&#13;&#10;&#13;&#10;ELSEIF [Tipo] &lt;&gt; &quot;Multi&quot; AND [Tipo] &lt;&gt; &quot;Dmart&quot;  AND [Positivos] = &quot;TRUE&quot; THEN&#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN [Valores de campo de tabla dinámica]*0.007&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN [Valores de campo de tabla dinámica]*0.038&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN [Valores de campo de tabla dinámica]*0.071&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN [Valores de campo de tabla dinámica]*0.208&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN [Valores de campo de tabla dinámica]*0.2510&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN [Valores de campo de tabla dinámica]*0.295&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN [Valores de campo de tabla dinámica]*1&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='2 -  Calculo Por Vertical  EUROS' datatype='real' name='[Calculation_883831486939942928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_883831486937956366]/[rate_eu]' />
            </column>
            <column caption='3 - Currency - Calculo Por Vertical' datatype='real' name='[Calculation_883831486940090385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;[Parameters].[Parámetro 2]= &quot;Moneda Local&quot; then [Calculation_883831486937956366]&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;&#13;&#10;[Parameters].[Parámetro 2]= &quot;Euro&quot; THEN [Calculation_883831486939942928]&#13;&#10;&#13;&#10;END' />
            </column>
