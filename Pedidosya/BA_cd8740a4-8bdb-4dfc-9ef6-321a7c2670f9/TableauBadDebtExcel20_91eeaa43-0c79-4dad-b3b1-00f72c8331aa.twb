      <column caption='Moneda' datatype='string' name='[Calculation_883831486940422162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_883831486940090385]) THEN NULL ELSE&#13;&#10;IF  [Parameters].[Parámetro 2] = &quot;Euro&quot; then &quot;€&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2] = &quot;Moneda Local&quot; and [Country] = &quot;Argentina&quot; THEN &quot;$&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Bolivia&quot; THEN &quot;Bs&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Chile&quot; THEN &quot;$&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Dominicana&quot; THEN &quot;$&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Ecuador&quot; THEN &quot;$&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Salvador&quot; THEN &quot;₡&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Guatemala&quot; THEN &quot;Q&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Honduras&quot; THEN &quot;L&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Nicaragua&quot; THEN &quot;C$&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Panama&quot; THEN &quot;B/&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Costa Rica&quot; THEN &quot;₡&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Venezuela&quot; THEN &quot;VEF&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Peru&quot; THEN &quot;S/&quot;&#13;&#10;ELSEIF  [Parameters].[Parámetro 2]= &quot;Moneda Local&quot; and [Country] = &quot;Paraguay&quot;  THEN &quot;₲&quot;&#13;&#10;END&#13;&#10;END' />
      </column>
