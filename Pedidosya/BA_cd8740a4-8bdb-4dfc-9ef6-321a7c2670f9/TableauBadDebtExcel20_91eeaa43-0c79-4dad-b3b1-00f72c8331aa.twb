      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1379227413628747780]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3] &#13;&#10;WHEN &quot;Country&quot; THEN [Country_Name]&#13;&#10;WHEN &quot;Vertical&quot; THEN [Calculation_1288873924190384130]&#13;&#10;END' />
      </column>
      <column caption='60 A 90' datatype='real' name='[Calculation_1379227413631582213]' role='measure' type='quantitative'>
