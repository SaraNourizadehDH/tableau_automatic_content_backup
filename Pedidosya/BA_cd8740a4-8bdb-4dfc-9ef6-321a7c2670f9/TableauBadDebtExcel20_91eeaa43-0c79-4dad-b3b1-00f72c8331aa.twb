          <relation connection='bigquery.0tiefot0khvz3i16t1sgp1ho7mvq' name='Consulta SQL personalizada2' type='text'><![CDATA[WITH max_rate AS (
 SELECT
  dcd.country_id,
  dce.rate_eu

  FROM  `peya-bi-tools-pro.il_core.dim_currency_exchange` dce
  LEFT JOIN`peya-bi-tools-pro.il_core.dim_country` dcd 
		   ON dce.currency_id = dcd.currency_id
			 AND active IS TRUE

  WHERE
    DATE(dce.currency_exchange_date) = DATE_SUB(DATE_TRUNC(CURRENT_DATE,month), INTERVAL 1 MONTH)

)



SELECT
  cd.country_name,
  cd.country_id,
  DATE(ce.currency_exchange_date) mes,
  ce.rate_eu,
  mr.rate_eu as max_rate_eu
  

FROM  `peya-bi-tools-pro.il_core.dim_currency_exchange` ce
LEFT JOIN`peya-bi-tools-pro.il_core.dim_country` cd 
		   ON ce.currency_id = cd.currency_id
			 AND active IS TRUE
LEFT JOIN  max_rate mr
  ON cd.country_id = mr.country_id


WHERE  1=1
  AND DATE(ce.currency_exchange_date)>>= "2022-05-01"
  AND DATE(ce.currency_exchange_date)<<= DATE_TRUNC(CURRENT_DATE,month)
  AND cd.country_name IS NOT NULL]]></relation>
          <relation connection='bigquery.0nqxmk31yp9fir1bcjc3u0hqvbsy' name='Consulta SQL personalizada3' type='text'><![CDATA[WITH lucanet as (
  select distinct
DATE_MONTH,
l.COUNTRY_NAME,
SUM( CASE WHEN currency = "EUR" THEN revenues ELSE null END ) as revenue_eur,
SUM( CASE WHEN currency = "Default Currency" THEN revenues ELSE null END ) as revenue_lc

from `peya-fraud-and-fintech.group_finance_data.fact_ln_platform_pnl` l 
where data_level = "Actual" and date_month >>= "2023-01-01"
group by 1,2
order by 1,2

),

sap as (

  select fecha, country_name,sum(value_eur) as delivery_fee_eur,sum(value_lc) as delivery_fee_lc,
from `peya-fraud-and-fintech.group_finance_data.fact_sap_LNfromSAP`
where gl_account like "%70020000%" and fecha >>= "2023-01-01"
group by 1,2

)

select
l.date_month,
l.country_name,
country_id,
revenue_lc,
revenue_eur, 
delivery_Fee_eur,
delivery_Fee_lc
from lucanet l
left join sap s on l.date_month = s.fecha and l.country_name = s.country_name
left join `peya-bi-tools-pro.il_core.dim_country` c on l.country_name = c.country_name_en 
where revenue_lc <<>> 0 
order by 1,2]]></relation>
          <relation connection='bigquery.0tiefot0khvz3i16t1sgp1ho7mvq' name='Consulta SQL personalizada1' type='text'><![CDATA[--- Query Bad Debt Allowances ---

SELECT
f.company_code,
REPLACE(m.Country_Name,'Dominican Republic', 'Dominicana') as country,
m.country_id,
f.company_description,
DATE_TRUNC(PARSE_DATE('%Y%m%d', CAST(accounting_date AS STRING)),MONTH) AS year_month,
f.date,
ma.Description_ES,
f.accounting_account,
f.accounting_account_description,
--  f.text,
-- f.document_type,
SUM(f.amount_in_accounting_currency) accounting_currency,		
SUM(f.amount_in_document_currency) document_currency		

FROM `peya-data-origins-pro.cl_sap.finance` f

LEFT JOIN `peya-fraud-and-fintech.user_victoria_paolucci.sap_entities_nativa` m on cast(f.company_code as string)=m.Company_Code

LEFT JOIN `peya-fraud-and-fintech.user_victoria_paolucci.sap_document_type_nativa` ma on cast(f.document_type as string)=ma.document_type

WHERE accounting_account_description = 'Bad debt allowances'
    AND Description_ES IN ('G/L Account Document','Accrual Posting')    
    AND document_date >>= 20221001
    AND m.Vertical <<>> "Dmart"
    AND f.company_code NOT IN (6004,6005)

GROUP BY 1,2,3,4,5,6,7,8,9]]></relation>
          <relation connection='bigquery.0tiefot0khvz3i16t1sgp1ho7mvq' name='Consulta SQL personalizada' type='text'><![CDATA[--- Query Trade Receivables ---
WITH saldo_inicial AS (
    SELECT
    company_code,
    country_id,
    country_name,
    saldo_inicial,
    fecha_mes

    FROM `peya-fraud-and-fintech.user_victoria_paolucci.saldos_iniciales_nativa`
), 

saldo_mensual AS (
    SELECT
    m.Country_Name,
    f.company_code,
    m.country_id,
    DATE_TRUNC(PARSE_DATE('%Y%m%d', CAST(accounting_date AS STRING)),MONTH) AS year_month,
    si.saldo_inicial,
    --amount_in_accounting_currency,
    SUM(f.amount_in_accounting_currency) AS saldo_mensual

    FROM `peya-data-origins-pro.cl_sap.finance` f
    LEFT JOIN `peya-fraud-and-fintech.user_victoria_paolucci.sap_entities_nativa` m 
      ON CAST(f.company_code AS STRING) = m.Company_Code
    LEFT JOIN `peya-fraud-and-fintech.user_victoria_paolucci.sap_document_type_nativa` ma 
      ON CAST(f.document_type AS STRING) = ma.document_type
    LEFT JOIN saldo_inicial si
      ON f.company_code = si.company_code
      AND DATE_TRUNC(PARSE_DATE('%Y%m%d', CAST(accounting_date AS STRING)),MONTH) = si.fecha_mes

---cuentas contables de trade receivales: 41010200,41010201,41010203,41010204,41010220

    WHERE
    accounting_account IN (41010200,41010203,41010204,41010220)
      AND m.Vertical <<>> "Dmart"
      AND DATE_TRUNC(PARSE_DATE('%Y%m%d', CAST(accounting_date AS STRING)),MONTH) >>= '2023-01-01'
      AND f.company_code NOT IN (6702,6504,6004,6005)
      and document_number <<>> 1100353268
  GROUP BY 1,2,3,4,5--,6
  ORDER BY 4
)

SELECT s.*

  , SUM(saldo_mensual + COALESCE(saldo_inicial,0)) OVER (PARTITION BY company_code ORDER BY year_month ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as saldo_acumulado

FROM saldo_mensual s]]></relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
