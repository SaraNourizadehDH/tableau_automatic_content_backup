              <calculation class='tableau' formula='IF [Tipo de Negocio] = &quot;Courier&quot; OR [Tipo de Negocio] = &quot;Courier Business&quot; THEN &quot;COURIER&quot; &#13;&#10;ELSEIF [Tipo de Negocio] = &quot;No Tomar&quot; THEN &quot;DEUDOR GENÉRICO&quot;&#13;&#10;ELSE UPPER([Tipo de Negocio]) END' />
