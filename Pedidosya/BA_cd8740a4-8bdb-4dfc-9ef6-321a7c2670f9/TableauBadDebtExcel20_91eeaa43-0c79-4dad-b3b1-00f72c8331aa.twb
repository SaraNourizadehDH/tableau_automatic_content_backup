              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='Aging_parametro' datatype='string' name='[Parámetro 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Aging &gt;180&quot;' value='Bucket &gt;180' />
                <alias key='&quot;Aging 0A30&quot;' value='Bucket 0A30' />
                <alias key='&quot;Aging 120A180&quot;' value='Bucket 120A180' />
                <alias key='&quot;Aging 30A60&quot;' value='Bucket 30A60' />
                <alias key='&quot;Aging 60A90&quot;' value='Bucket 60A90' />
                <alias key='&quot;Aging 90A120&quot;' value='Bucket 90A120' />
                <alias key='&quot;Aging A0&quot;' value='Bucket A0' />
              </aliases>
            </column>
            <column caption='Top N' datatype='integer' name='[Parámetro 7]' param-domain-type='any' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column alias='Top N' caption='TOP N or Select ALL parametro' datatype='string' name='[Parámetro 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Top n&quot;'>
              <calculation class='tableau' formula='&quot;Top n&quot;' />
              <aliases>
                <alias key='&quot;ALL&quot;' value='All' />
                <alias key='&quot;Top n&quot;' value='Top N' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0apmv3l02cen2k1cz56sb06wjhiv'>
            <column caption='SAP_ID&amp;Customer&amp;Country' datatype='string' name='[Calculation_103301350912434182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([Customer]) + &quot;-&quot; + [Customer Name] + &quot;-&quot; + [country]' />
            </column>
            <column caption='Tipo_filtro' datatype='string' name='[Calculation_1288873924206141443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tipo] = &quot;Deudor Generico&quot; OR [Tipo] = &quot;No tomar&quot; THEN &quot;Deudor genérico&quot; ELSE [Tipo] END' />
            </column>
            <column caption='TOP N or Select All _ Prov' datatype='boolean' name='[Calculation_408983176334168076]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 8] = &quot;Top n&quot; then [Filter_Top_N_Prov]&#13;&#10;else [Filter_All_Customer]&#13;&#10;END' />
            </column>
            <column caption='% Prov_Total_General' datatype='real' name='[Calculation_408983176672948240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_846676758350356487] / [Monto_buckets_ALL_bycountry (copia)_408983176672526351]' />
            </column>
            <column caption='provision_filtro' datatype='real' name='[Calculation_846676758347984896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parámetro 4] &#13;&#10;when &quot;All&quot; then sum(if [Calculation_883831486940090385] &gt; 0 then [Calculation_883831486940090385] end ) &#13;&#10;when &quot;Aging A0&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;A 0&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385]end )&#13;&#10;when &quot;Aging 0A30&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then[Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 30A60&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 60A90&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 90A120&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging 120A180&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;when &quot;Aging &gt;180&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; and [Calculation_883831486940090385] &lt;&gt; 0 then [Calculation_883831486940090385] end )&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Prov A 0' datatype='real' name='[Calculation_846676758348869633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;A 0&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 0 A 30' datatype='real' name='[Calculation_846676758348976130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 30 A 60' datatype='real' name='[Calculation_846676758349860867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 90 A 120' datatype='real' name='[Calculation_846676758349971460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov 120 A 180' datatype='real' name='[Calculation_846676758350102533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov &gt; 180' datatype='real' name='[Calculation_846676758350241798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; then [Calculation_883831486940090385] else 0 end' />
            </column>
            <column caption='Prov_Total' datatype='real' name='[Calculation_846676758350356487]' role='measure' type='quantitative'>
