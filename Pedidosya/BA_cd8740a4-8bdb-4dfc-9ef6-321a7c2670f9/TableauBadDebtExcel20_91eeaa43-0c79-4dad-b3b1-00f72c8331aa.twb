          <datasource-dependencies datasource='Parameters'>
            <column caption='Tipodecambio' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0apmv3l02cen2k1cz56sb06wjhiv'>
            <column caption='Tipo_filtro' datatype='string' name='[Calculation_1288873924206141443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tipo] = &quot;Deudor Generico&quot; OR [Tipo] = &quot;No tomar&quot; THEN &quot;Deudor genérico&quot; ELSE [Tipo] END' />
            </column>
            <column caption='Revenue_total' datatype='real' name='[Calculation_1379227413955338261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;[Parameters].[Parámetro 2]= &quot;Moneda Local&quot; THEN [revenue_lc] &#13;&#10;ELSE [revenue_eur] END' />
            </column>
            <column caption='Delivery_Fee_total' datatype='real' name='[Calculation_1379227413955514390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;[Parameters].[Parámetro 2]= &quot;Moneda Local&quot; THEN [delivery_Fee_lc] &#13;&#10;ELSE [delivery_Fee_eur] END' />
            </column>
            <column caption='Revenue-Deliver_Fee' datatype='real' name='[Calculation_1379227413955985431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1379227413955338261]-[Calculation_1379227413955514390]' />
            </column>
            <column caption='Bad_Debt/Revenue' datatype='real' name='[Calculation_1379227413958225944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_883831486930014215] / sum([Calculation_1379227413955985431] )' />
            </column>
            <column caption='Diferencias_Prov' datatype='real' name='[Calculation_883831486930014215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_883831486931238923]) - SUM([Calculation_883831486931644428])' />
            </column>
