      <column caption='Aging1' datatype='string' name='[Aging]' role='dimension' type='nominal' />
      <column caption='TOP N or Select ALL' datatype='boolean' name='[Calculation_103301350904209409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 8] = &quot;Top n&quot; then [Top_N]&#13;&#10;else [Filter_All_Customer]&#13;&#10;END' />
      </column>
      <column caption='SAP_ID&amp;Customer&amp;Country' datatype='string' name='[Calculation_103301350912434182]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Customer]) + &quot;-&quot; + [Customer Name] + &quot;-&quot; + [country]' />
      </column>
      <column caption='filter_rank_aging' datatype='integer' datatype-customized='true' name='[Calculation_103301350952521738]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK([Calculation_1379227413680771090])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vertical_filtro' datatype='string' name='[Calculation_1288873924190384130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tipo de Negocio] = &quot;Courier&quot; OR [Tipo de Negocio] = &quot;Courier Business&quot; THEN &quot;COURIER&quot; &#13;&#10;ELSEIF [Tipo de Negocio] = &quot;No Tomar&quot; THEN &quot;DEUDOR GENÉRICO&quot;&#13;&#10;ELSE UPPER([Tipo de Negocio]) END' />
      </column>
      <column caption='Tipo_filtro' datatype='string' name='[Calculation_1288873924206141443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tipo] = &quot;Deudor Generico&quot; OR [Tipo] = &quot;No tomar&quot; THEN &quot;Deudor genérico&quot; ELSE [Tipo] END' />
      </column>
      <column caption='A 0 ' datatype='real' name='[Calculation_1379227413617790978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;A 0&quot; then [Calculation_1447907343724920833] else 0 end' />
      </column>
