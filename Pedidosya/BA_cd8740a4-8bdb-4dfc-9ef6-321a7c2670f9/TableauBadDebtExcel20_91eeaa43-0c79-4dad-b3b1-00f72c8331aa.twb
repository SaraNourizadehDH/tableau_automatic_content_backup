          <filter class='categorical' column='[federated.0apmv3l02cen2k1cz56sb06wjhiv].[none:Nombres de campo de tabla dinámica:nk]'>
            <groupfilter from='&quot;0 A 30&quot;' function='range' level='[none:Nombres de campo de tabla dinámica:nk]' to='&quot;A 0&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
