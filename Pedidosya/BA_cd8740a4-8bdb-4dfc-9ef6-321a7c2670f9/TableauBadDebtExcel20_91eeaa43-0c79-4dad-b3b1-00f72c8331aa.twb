    <worksheet name='Saldo_Provision_Aging'>
      <table>
        <view>
          <datasources>
            <datasource caption='Base (Database cierre Julio 2023 final)' name='federated.0apmv3l02cen2k1cz56sb06wjhiv' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Tipodecambio' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0apmv3l02cen2k1cz56sb06wjhiv'>
            <column caption='Tipo_filtro' datatype='string' name='[Calculation_1288873924206141443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tipo] = &quot;Deudor Generico&quot; OR [Tipo] = &quot;No tomar&quot; THEN &quot;Deudor genérico&quot; ELSE [Tipo] END' />
            </column>
            <column caption='1 - Calculo Por Vertical' datatype='real' name='[Calculation_883831486937956366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Tipo] = &quot;Prestamo&quot; THEN &#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN 0&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN 0&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;elseIF [Tipo] = &quot;Multi&quot; AND [Positivos] = &quot;TRUE&quot;  THEN&#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN [Valores de campo de tabla dinámica] *0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN [Valores de campo de tabla dinámica]*0.006 &#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN [Valores de campo de tabla dinámica] * 0.006 &#13;&#10;END&#13;&#10;&#13;&#10;ELSEIF [Tipo] &lt;&gt; &quot;Multi&quot; AND [Tipo] &lt;&gt; &quot;Dmart&quot;  AND [Positivos] = &quot;TRUE&quot; AND YEAR([Fecha Mes]) = 2023 AND MONTH([Fecha Mes]) &lt;= 10 THEN&#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN [Valores de campo de tabla dinámica]*0.015&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN [Valores de campo de tabla dinámica]*0.098&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN [Valores de campo de tabla dinámica]*0.1780&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN [Valores de campo de tabla dinámica]*0.4350&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN [Valores de campo de tabla dinámica]*0.5610&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN [Valores de campo de tabla dinámica]*0.6080&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN [Valores de campo de tabla dinámica]*1&#13;&#10;END&#13;&#10;&#13;&#10;ELSEIF [Tipo] &lt;&gt; &quot;Multi&quot; AND [Tipo] &lt;&gt; &quot;Dmart&quot;  AND [Positivos] = &quot;TRUE&quot; THEN&#13;&#10;IF [Nombres de campo de tabla dinámica] = &quot;A 0&quot; THEN [Valores de campo de tabla dinámica]*0.007&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; THEN [Valores de campo de tabla dinámica]*0.038&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; THEN [Valores de campo de tabla dinámica]*0.071&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; THEN [Valores de campo de tabla dinámica]*0.208&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; THEN [Valores de campo de tabla dinámica]*0.2510&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; THEN [Valores de campo de tabla dinámica]*0.295&#13;&#10;ELSEIF [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; THEN [Valores de campo de tabla dinámica]*1&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='2 -  Calculo Por Vertical  EUROS' datatype='real' name='[Calculation_883831486939942928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_883831486937956366]/[rate_eu]' />
            </column>
            <column caption='3 - Currency - Calculo Por Vertical' datatype='real' name='[Calculation_883831486940090385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;[Parameters].[Parámetro 2]= &quot;Moneda Local&quot; then [Calculation_883831486937956366]&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;&#13;&#10;[Parameters].[Parámetro 2]= &quot;Euro&quot; THEN [Calculation_883831486939942928]&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[Fecha Mes]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Mes]' role='dimension' type='nominal' />
            <column caption='Aging' datatype='string' name='[Nombres de campo de tabla dinámica]' role='dimension' type='nominal' />
            <column datatype='string' name='[Positivos]' role='dimension' type='nominal' />
            <column datatype='string' name='[Tipo]' role='dimension' type='nominal' />
            <column caption='Monto Total' datatype='real' name='[Valores de campo de tabla dinámica]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1288873924206141443]' derivation='None' name='[none:Calculation_1288873924206141443:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Mes]' derivation='None' name='[none:Mes:nk]' pivot='key' type='nominal' />
            <column-instance column='[Nombres de campo de tabla dinámica]' derivation='None' name='[none:Nombres de campo de tabla dinámica:nk]' pivot='key' type='nominal' />
