    <worksheet name='Stock_Deuda_Aging_Apertura'>
      <table>
        <view>
          <datasources>
            <datasource caption='Base (Database cierre Julio 2023 final)' name='federated.0apmv3l02cen2k1cz56sb06wjhiv' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Tipodecambio' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='Aging_parametro' datatype='string' name='[Parámetro 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Aging &gt;180&quot;' value='Bucket &gt;180' />
                <alias key='&quot;Aging 0A30&quot;' value='Bucket 0A30' />
                <alias key='&quot;Aging 120A180&quot;' value='Bucket 120A180' />
                <alias key='&quot;Aging 30A60&quot;' value='Bucket 30A60' />
                <alias key='&quot;Aging 60A90&quot;' value='Bucket 60A90' />
                <alias key='&quot;Aging 90A120&quot;' value='Bucket 90A120' />
                <alias key='&quot;Aging A0&quot;' value='Bucket A0' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0apmv3l02cen2k1cz56sb06wjhiv'>
            <column caption='Tipo_filtro' datatype='string' name='[Calculation_1288873924206141443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tipo] = &quot;Deudor Generico&quot; OR [Tipo] = &quot;No tomar&quot; THEN &quot;Deudor genérico&quot; ELSE [Tipo] END' />
            </column>
            <column caption='A 0 ' datatype='real' name='[Calculation_1379227413617790978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;A 0&quot; then [Calculation_1447907343724920833] else 0 end' />
            </column>
            <column caption='30 A 60' datatype='real' name='[Calculation_1379227413626093571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; then [Calculation_1447907343724920833] else 0 end' />
            </column>
            <column caption='60 A 90' datatype='real' name='[Calculation_1379227413631582213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; then [Calculation_1447907343724920833] else 0 end' />
            </column>
            <column caption='0 A 30' datatype='real' name='[Calculation_1379227413631766534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; then [Calculation_1447907343724920833] else 0 end' />
            </column>
            <column caption='90 A 120' datatype='real' name='[Calculation_1379227413632040967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; then [Calculation_1447907343724920833] else 0 end' />
            </column>
            <column caption='120 A 180' datatype='real' name='[Calculation_1379227413632188424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; then [Calculation_1447907343724920833] else 0 end' />
            </column>
            <column caption='&gt; 180' datatype='real' name='[Calculation_1379227413632761865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; then [Calculation_1447907343724920833] else 0 end' />
            </column>
            <column caption='aging_filtro' datatype='real' name='[Calculation_1379227413644288015]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parámetro 4] &#13;&#10;&#13;&#10;when &quot;All&quot; then sum(if [Calculation_1447907343724920833] &gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;when &quot;Aging A0&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;A 0&quot; and [Calculation_1447907343724920833] &lt;&gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;when &quot;Aging 0A30&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;0 A 30&quot; and [Calculation_1447907343724920833] &lt;&gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;when &quot;Aging 30A60&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;30 A 60&quot; and [Calculation_1447907343724920833] &lt;&gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;when &quot;Aging 60A90&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;60 A 90&quot; and [Calculation_1447907343724920833] &lt;&gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;when &quot;Aging 90A120&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;90 A 120&quot; and [Calculation_1447907343724920833] &lt;&gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;when &quot;Aging 120A180&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;120 A 180&quot; and [Calculation_1447907343724920833] &lt;&gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;when &quot;Aging &gt;180&quot; then sum(if [Nombres de campo de tabla dinámica] = &quot;&gt; 180&quot; and [Calculation_1447907343724920833] &lt;&gt; 0 then [Calculation_1447907343724920833] end )&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='SAP_ID&amp;Customer' datatype='string' name='[Calculation_1379227413651931152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([Customer]) + &quot;-&quot; + [Customer Name]' />
            </column>
            <column caption='Monto_buckets' datatype='real' name='[Calculation_1379227413680771090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1379227413617790978])+SUM([Calculation_1379227413631766534])+SUM([Calculation_1379227413626093571])+SUM([Calculation_1379227413631582213])+SUM([Calculation_1379227413632040967])+SUM([Calculation_1379227413632188424])+SUM([Calculation_1379227413632761865])' />
            </column>
            <column caption='Monto_euros_pais' datatype='real' name='[Calculation_1447907343724920833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;&#13;&#10;[Parameters].[Parámetro 2]= &quot;Moneda Local&quot; THEN [Valores de campo de tabla dinámica] &#13;&#10;ELSE [Valores de campo de tabla dinámica] / [rate_eu] END' />
            </column>
