                <expression op='[occasions (Custom SQL Query1)]' />
              </expression>
              <expression op='='>
                <expression op='[fact_orders_registered_date_date]' />
                <expression op='[sessions_session_date_date]' />
              </expression>
            </expression>
            <first-end-point guaranteed-value='true' object-id='_E3E59CC2AAD448459527E832920FF8BC' unique-key='true' />
            <second-end-point guaranteed-value='true' object-id='_F9687D9AF9194C319929FF76E1A2BB54' unique-key='true' />
