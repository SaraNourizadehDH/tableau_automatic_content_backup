        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hrkao41ppoipv12jkzuf184rvsx' name='Custom SQL Query' type='text'><![CDATA[SELECT
    dim_partner.partner_id  AS dim_partner_partner_id,
    dim_partner.partner_name  AS dim_partner_partner_name,
    concat ( concat(CASE WHEN length(cast(dim_partner_schedule.open_from_hour as string) ) = 1 THEN  concat('0', cast(dim_partner_schedule.open_from_hour as string) ) ELSE cast(dim_partner_schedule.open_from_hour as string )END , ':' , CASE WHEN length(cast(dim_partner_schedule.open_from_minute as string) ) = 1 THEN  concat('0' , cast(dim_partner_schedule.open_from_minute as string) ) ELSE cast(dim_partner_schedule.open_from_minute as string )END )
          , ' - ' ,
          concat (CASE WHEN length(cast(dim_partner_schedule.open_to_hour as string)) = 1 THEN  concat('0',  cast(dim_partner_schedule.open_to_hour as string) ) ELSE cast(dim_partner_schedule.open_to_hour as string )END  , ':',  CASE WHEN length(cast(dim_partner_schedule.open_to_minute as string) ) = 1 THEN  concat('0' , cast(dim_partner_schedule.open_to_minute as string) ) ELSE cast(dim_partner_schedule.open_to_minute as string )END ) ) AS dim_partner_schedule_open_hour,
    dim_zone_logistic.zone_name  AS dim_zone_logistic_zone_name,
    dim_partner.main_cousine_category_name  AS dim_partner_main_cousine_category_name,
        (EXTRACT(HOUR FROM fact_orders.registered_at )) AS fact_orders_registered_at_hour_of_day,
    CASE WHEN (EXTRACT(HOUR FROM fact_orders.registered_at )) << 11 THEN '1. Desayuno' ELSE CASE WHEN (EXTRACT(HOUR FROM fact_orders.registered_at )) << 14 THEN '2. Almuerzo' ELSE CASE WHEN (EXTRACT(HOUR FROM fact_orders.registered_at )) << 17 THEN '3. Off Peak' ELSE CASE WHEN (EXTRACT(HOUR FROM fact_orders.registered_at )) << 21 THEN '4. Cena' ELSE '5. Noche' END
 END
 END
 END
 AS hora_orden_1,
        (fact_orders.registered_date ) AS fact_orders_registered_date_date,
        CASE WHEN ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (agg_fact_partner_times.times *1.0/60.0 ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6) = 0 THEN 0 ELSE ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (CASE WHEN agg_fact_partner_times.state = 'OPEN' then agg_fact_partner_times.times end *1.0/60.0 ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6) / ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (agg_fact_partner_times.times *1.0/60.0 ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6) END AS agg_fact_partner_times_actual_open_time_rate,
        ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (agg_fact_sessions_by_partner_daily.unique_orders ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6) / NULLIF(ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.sessions  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6), 0) AS agg_fact_sessions_by_partner_daily_cvr_1,
    ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( agg_fact_sessions_by_partner_daily.sessions  ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( agg_fact_sessions_by_partner_daily.sessions_by_partner_daily_sk   AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6) AS agg_fact_sessions_by_partner_daily_qty_sessions,
    COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) AS fact_orders_total_confirmed_orders,
        CASE WHEN COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) = 0 THEN 0 ELSE ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (fact_orders.confirmed_gfv_with_discount_paid_by_company ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (fact_orders.order_id )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS NUMERIC), 0), 6) / COUNT(DISTINCT case when  fact_orders.order_status    = 'CONFIRMED' then   fact_orders.order_id   end) END AS fact_orders_kpi_avf_gross
FROM `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  AS dim_country ON dim_partner.country_id = dim_country.country_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_date`
     AS date_lookup ON date_lookup.date <<= CURRENT_DATE()
LEFT JOIN `peya-bi-tools-pro.il_core.dim_historical_partners`
     AS dim_historical_partners ON dim_historical_partners.restaurant_id = dim_partner.partner_id and
      (DATE(dim_historical_partners.full_date )) = date_lookup.date
LEFT JOIN `peya-bi-tools-pro.il_sessions.perseus_agg_fact_sessions_by_partner_daily`
     AS agg_fact_sessions_by_partner_daily ON dim_partner.partner_id = agg_fact_sessions_by_partner_daily.partner_id

          AND agg_fact_sessions_by_partner_daily.session_date = date_lookup.date

LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders`  AS fact_orders ON dim_partner.partner_id = fact_orders.restaurant.id

          and fact_orders.registered_date >>= (DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY))
          and fact_orders.registered_date <<= (coalesce((DATE_ADD(DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY), INTERVAL 30 DAY)), current_date()))
          --
          AND fact_orders.registered_date = date_lookup.date

LEFT JOIN `peya-bi-tools-pro.il_logistics.fact_logistic_orders` AS fact_orders__logistic ON fact_orders.order_id = fact_orders__logistic.peya_order_id
      and fact_orders__logistic.created_date_local >>= (DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY))
      and fact_orders__logistic.created_date_local <<= coalesce((DATE_ADD(DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY), INTERVAL 30 DAY)), current_date())
LEFT JOIN UNNEST([fact_orders__logistic.zone]) as fact_logistic_orders__zone
LEFT JOIN `peya-bi-tools-pro.il_logistics.dim_zone`
     AS dim_zone_logistic ON fact_logistic_orders__zone.zone_id = dim_zone_logistic.zone_id
      AND fact_orders__logistic.country_code = dim_zone_logistic.dh_country_code
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner_schedule`
     AS dim_partner_schedule ON dim_partner.partner_id = dim_partner_schedule.partner_id
LEFT JOIN `peya-bi-tools-pro.il_core.agg_fact_partner_times`
     AS agg_fact_partner_times ON dim_partner.partner_id = agg_fact_partner_times.partner_id
      and (DATE(dim_historical_partners.full_date )) = agg_fact_partner_times.partner_time_date
      and agg_fact_partner_times.partner_time_date >>= (DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY))
      and agg_fact_partner_times.partner_time_date <<= coalesce((DATE_ADD(DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY), INTERVAL 30 DAY)), current_date())
WHERE ((UPPER(( dim_partner.partner_status  )) = UPPER('ON_LINE'))) AND (dim_country.active ) AND ((( date_lookup.date  ) >>= ((DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY))) AND ( date_lookup.date  ) << ((DATE_ADD(DATE_ADD(CURRENT_DATE(), INTERVAL -29 DAY), INTERVAL 30 DAY))))) AND (dim_partner.country_id ) = 16 AND ((dim_partner.partner_id ) >> 0 OR (dim_partner.partner_id ) IS NULL)
GROUP BY
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
ORDER BY
    2 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
