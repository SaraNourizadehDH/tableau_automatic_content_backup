      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([dim_user_user_id]) / TOTAL(COUNTD([dim_user_user_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_total_confirmed_orders (Migraciondmart_partnerv4)]) / TOTAL(SUM([orders_total_confirmed_orders (Migraciondmart_partnerv4)]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column datatype='integer' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([ND3m] = 1 AND [business] = &quot;3.DMARTS&quot;) then&#13;&#10;1 else 0 END' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation5]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id]) / TOTAL(COUNTD([user_id]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Calculation4' datatype='integer' name='[Calculation_1837468699916345344]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [user_id]: COUNTD(IF [business] = &quot;1.Foods&quot; AND &#13;&#10;[business] = &quot;3.DMARTS&quot; then &quot;Multivertical&quot; END)}' />
      </column>
      <column caption='Food' datatype='string' name='[Calculation_1837468700217479169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([business]=&quot;1.Foods&quot; AND [orders_total_confirmed_orders]&gt;=1)&#13;&#10;THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
      </column>
      <column caption='Tipos de usuarios' datatype='string' name='[Calculation_1837468700223156228]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([Calculation_1837468700217479169]=&quot;Yes&quot; AND [Food (copy)_1837468700220067842]=&quot;No&quot; AND [Food (copy)_1837468700220227587]=&quot;No&quot;)&#13;&#10;THEN &quot;Solo Food&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_1837468700217479169]=&quot;Yes&quot; AND [Food (copy)_1837468700220067842]=&quot;Yes&quot; AND [Food (copy)_1837468700220227587]=&quot;No&quot;)&#13;&#10;THEN &quot;Food &amp; LS&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_1837468700217479169]=&quot;Yes&quot; AND [Food (copy)_1837468700220067842]=&quot;No&quot; AND [Food (copy)_1837468700220227587]=&quot;Yes&quot;)&#13;&#10;THEN &quot;Food &amp; DMARTS&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_1837468700217479169]=&quot;No&quot; AND [Food (copy)_1837468700220067842]=&quot;Yes&quot; AND [Food (copy)_1837468700220227587]=&quot;Yes&quot;)&#13;&#10;THEN &quot;LS &amp; DMARTS&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_1837468700217479169]=&quot;No&quot; AND [Food (copy)_1837468700220067842]=&quot;Yes&quot; AND [Food (copy)_1837468700220227587]=&quot;No&quot;)&#13;&#10;THEN &quot;Solo LS&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_1837468700217479169]=&quot;No&quot; AND [Food (copy)_1837468700220067842]=&quot;No&quot; AND [Food (copy)_1837468700220227587]=&quot;Yes&quot;)&#13;&#10;THEN &quot;Solo DMARTS&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_1837468700217479169]=&quot;Yes&quot; AND [Food (copy)_1837468700220067842]=&quot;Yes&quot; AND [Food (copy)_1837468700220227587]=&quot;Yes&quot;)&#13;&#10;THEN &quot;Food &amp; LS &amp; DMARTS&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Multivertical_GROUP' datatype='string' name='[Calculation_1837468701710860294]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Multiverical] = &apos;Foods / DMART&apos; OR &#13;&#10;[Multiverical] = &apos;Foods / LS&apos;) then &quot;Foods / QC&quot;&#13;&#10;ELSEIF&#13;&#10;([Multiverical] = &apos;Sólo LS&apos; OR &#13;&#10;[Multiverical] = &apos;Sólo DMARTs&apos;&#13;&#10;OR &#13;&#10;[Multiverical] = &apos;DMART / LS&apos;) then &quot;Sólo QC&quot;&#13;&#10;else [Multiverical]&#13;&#10;END' />
      </column>
      <column caption='Filtro_DMART' datatype='string' name='[Calculation_1837468701715542023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Multiverical] &lt;&gt; &apos;Sólo DMARTs&apos;&#13;&#10;then &quot;No&quot; &#13;&#10;elseif [Multiverical]&#13;&#10;END' />
      </column>
      <column caption='Calculation6' datatype='boolean' name='[Calculation_1837468701723623433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Multiverical],[Calculation_1837468701710860294])' />
      </column>
      <column aggregation='Sum' caption='FiltroFecha' datatype='integer' name='[Calculation_2146246741183709185]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ([dim_user_user_last_order_date] =[orders_registered_date_date])&#13;&#10;then 1 else 0 END' />
      </column>
      <column aggregation='Sum' caption='UsuariosND' datatype='integer' name='[Calculation_2146246741209919493]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF([business] &lt;&gt; &apos;3.DMARTS&apos; AND [orders_total_confirmed_orders] &gt;= 1)&#13;&#10;then 1 else 0 end' />
        <aliases>
          <alias key='0' value='DMART User' />
          <alias key='1' value='No DMART User' />
        </aliases>
      </column>
      <column caption='NC_DMART' datatype='integer' name='[Calculation_2146246741230579719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])-SUM([NDGeneral])' />
      </column>
      <column caption='NCD3m_NEW' datatype='integer' name='[Calculation_2146246741304909832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [dim_user_user_id] : MIN([ND3m (Migraciondmart_partnerv4)])}' />
      </column>
      <column caption='Tipo Cliente' datatype='string' name='[Calculation_2146246741319323657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_2146246741321834506] = 1 then&#13;&#10;&quot;Occassional&quot; ELSEIF &#13;&#10;([Calculation_2146246741321834506] &gt;= 1 AND [Calculation_2146246741321834506] &lt; 5)&#13;&#10;then &quot;Stable&quot; ELSEIF &#13;&#10;[Calculation_2146246741321834506] &gt;=5 then &quot;Heavy User&quot;&#13;&#10;ELSE &quot;Other&quot; END' />
        <aliases>
          <alias key='&quot;Heavy User&quot;' value='Heavy User : 5 o más órdenes' />
          <alias key='&quot;Occassional&quot;' value='Occassional: 1 órden' />
          <alias key='&quot;Stable&quot;' value='Stable: 2 a 4 órdenes' />
        </aliases>
      </column>
      <column caption='User Classification' datatype='integer' name='[Calculation_2146246741321834506]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [user_id],[business],MONTH([orders_registered_date_date] )  :SUM([orders_total_confirmed_orders])}' />
      </column>
      <column caption='Local Stores' datatype='string' name='[Food (copy)_1837468700220067842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([business]=&quot;2.LS&quot; AND [orders_total_confirmed_orders]&gt;=1)&#13;&#10;THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
      </column>
      <column caption='Dmarts' datatype='string' name='[Food (copy)_1837468700220227587]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([business]=&quot;3.DMARTS&quot; AND [orders_total_confirmed_orders]&gt;=1)&#13;&#10;THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
      </column>
      <column datatype='string' name='[Multiverical]' role='dimension' type='nominal' />
      <column caption='ND3m (Migraciondmart partnerv4)' datatype='integer' name='[ND3m (Migraciondmart_partnerv4)]' role='measure' type='quantitative' />
      <column caption='NDGeneral (Migraciondmart partnerv4)' datatype='integer' name='[NDGeneral (Migraciondmart_partnerv4)]' role='measure' type='quantitative' />
      <column caption='ND General' datatype='integer' name='[NDGeneral]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='UsuariosND (copy)' datatype='integer' name='[UsuariosND (copy)_1366561061386629122]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF([business] &lt;&gt; &apos;3.DMARTS&apos; AND [orders_total_confirmed_orders] &gt;= 1 AND &#13;&#10;[orders_registered_date_datev2] &lt; #01/07/2023#)&#13;&#10;then 1 else 0 end' />
