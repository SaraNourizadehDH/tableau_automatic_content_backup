          <datasource-dependencies datasource='federated.0cagp1g19syxjl17953jc1yqqws5'>
            <column caption='Tipo Cliente' datatype='string' name='[Calculation_2146246741319323657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_2146246741321834506] = 1 then&#13;&#10;&quot;Occassional&quot; ELSEIF &#13;&#10;([Calculation_2146246741321834506] &gt;= 1 AND [Calculation_2146246741321834506] &lt; 5)&#13;&#10;then &quot;Stable&quot; ELSEIF &#13;&#10;[Calculation_2146246741321834506] &gt;=5 then &quot;Heavy User&quot;&#13;&#10;ELSE &quot;Other&quot; END' />
              <aliases>
                <alias key='&quot;Heavy User&quot;' value='Heavy User : 5 o más órdenes' />
                <alias key='&quot;Occassional&quot;' value='Occassional: 1 órden' />
                <alias key='&quot;Stable&quot;' value='Stable: 2 a 4 órdenes' />
              </aliases>
            </column>
            <column caption='User Classification' datatype='integer' name='[Calculation_2146246741321834506]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [user_id],[business],MONTH([orders_registered_date_date] )  :SUM([orders_total_confirmed_orders])}' />
