    <worksheet name='NC scorecard'>
      <repository-location id='NCscorecard' path='/t/Pedidosya/workbooks/Case_study_DHDanielTrujillo' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Raw_data_from_postgres (Casem study results - Daniel Trujillo)' name='federated.0h10mt20fmjewh1bhbbp8148spac' />
          </datasources>
          <datasource-dependencies datasource='federated.0h10mt20fmjewh1bhbbp8148spac'>
            <column caption='&amp; growth NC' datatype='real' default-format='p0.00%' name='[&amp; growth orders (copia)_741123648360751134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[2022 orders (copia)_741123648359800858]/[2022 NC (copia)_741123648360263707]-1' />
            </column>
            <column caption='2021 NC' datatype='integer' name='[2022 NC (copia)_741123648360263707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Calculation_741123648350117905] &#13;&#10;AND [user_type] = &apos;nc&apos;&#13;&#10;THEN [analytical_customer_id] END)' />
            </column>
            <column caption='2022 NC' datatype='integer' name='[2022 orders (copia)_741123648359800858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Last year (copia)_741123648352964626] &#13;&#10;AND [user_type] = &apos;nc&apos;&#13;&#10;THEN [analytical_customer_id] END)' />
            </column>
            <column caption='2021' datatype='boolean' name='[Calculation_741123648350117905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR(DATEADD(&apos;year&apos;,-2,TODAY()))=YEAR([order_year])' />
            </column>
            <column caption='2022' datatype='boolean' name='[Last year (copia)_741123648352964626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR(DATEADD(&apos;year&apos;,-1,TODAY()))=YEAR([order_year])' />
            </column>
            <column caption='NC Growth UP' datatype='string' name='[NC Growth DOWN (copia)_741123648360562717]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [2022 orders (copia)_741123648359800858]-[2022 NC (copia)_741123648360263707] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='NC Growth DOWN' datatype='string' name='[Order Growth DOWN (copia)_741123648360362012]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [2022 orders (copia)_741123648359800858]-[2022 NC (copia)_741123648360263707] &lt; 0 THEN &quot;▼&quot; END' />
            </column>
