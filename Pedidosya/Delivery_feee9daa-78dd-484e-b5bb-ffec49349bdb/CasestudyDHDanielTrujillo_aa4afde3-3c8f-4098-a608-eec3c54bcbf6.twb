              <text column='[federated.0h10mt20fmjewh1bhbbp8148spac].[usr:Order Growth UP (copia)_741123648355102742:nk]' />
              <text column='[federated.0h10mt20fmjewh1bhbbp8148spac].[usr:Calculation_741123648353845269:nk]' />
              <text column='[federated.0h10mt20fmjewh1bhbbp8148spac].[sum:2022 orders (copia)_741123648353460244:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontalignment='0'>Order Growth&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#59a14f' fontsize='24'><![CDATA[<[federated.0h10mt20fmjewh1bhbbp8148spac].[usr:Calculation_741123648353845269:nk]>]]></run>
                <run bold='true' fontalignment='0' fontcolor='#d61f27' fontsize='24'><![CDATA[<[federated.0h10mt20fmjewh1bhbbp8148spac].[usr:Order Growth UP (copia)_741123648355102742:nk]>]]></run>
                <run bold='true' fontalignment='0' fontsize='24'><![CDATA[<[federated.0h10mt20fmjewh1bhbbp8148spac].[usr:Calculation_741123648356540441:qk]>]]></run>
                <run fontalignment='0'><![CDATA[
