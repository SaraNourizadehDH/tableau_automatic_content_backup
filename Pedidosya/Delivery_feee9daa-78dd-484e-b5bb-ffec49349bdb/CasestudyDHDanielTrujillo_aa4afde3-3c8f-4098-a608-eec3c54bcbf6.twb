      <aliases enabled='yes' />
      <column caption='&amp; growth Churn' datatype='real' default-format='p0.00%' name='[&amp; growth NC (copia)_741123648363155492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[2022 NC (copia)_741123648362623009]/[2021 NC (copia)_741123648362463264]-1' />
      </column>
      <column caption='&amp; growth NC' datatype='real' default-format='p0.00%' name='[&amp; growth orders (copia)_741123648360751134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[2022 orders (copia)_741123648359800858]/[2022 NC (copia)_741123648360263707]-1' />
      </column>
      <column caption='&amp; growth Frequency' datatype='real' default-format='p0.00%' name='[&amp; growth orders (copia)_741123648367718443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_741123648353132563])/SUM([2022 orders (copia)_741123648367267882])/12)/(SUM([2022 orders (copia)_741123648353460244])/SUM([2021 orders  (copia)_741123648367075369])/12)-1' />
      </column>
      <column caption='2021 Churners' datatype='integer' name='[2021 NC (copia)_741123648362463264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Calculation_741123648350117905] &#13;&#10;AND [status_by_eoy] = &apos;Churner&apos;&#13;&#10;THEN [analytical_customer_id] END)' />
      </column>
      <column caption='2021 users' datatype='integer' name='[2021 orders  (copia)_741123648367075369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_741123648350117905] THEN [unique_users] END' />
      </column>
      <column caption='2021 NC' datatype='integer' name='[2022 NC (copia)_741123648360263707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Calculation_741123648350117905] &#13;&#10;AND [user_type] = &apos;nc&apos;&#13;&#10;THEN [analytical_customer_id] END)' />
      </column>
      <column caption='2022 Churners' datatype='integer' name='[2022 NC (copia)_741123648362623009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Last year (copia)_741123648352964626] &#13;&#10;AND [status_by_eoy] = &apos;Churner&apos;&#13;&#10;THEN [analytical_customer_id] END)' />
      </column>
      <column caption='2021 orders ' datatype='integer' name='[2022 orders (copia)_741123648353460244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_741123648350117905] THEN [orders] END' />
      </column>
      <column caption='2022 NC' datatype='integer' name='[2022 orders (copia)_741123648359800858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Last year (copia)_741123648352964626] &#13;&#10;AND [user_type] = &apos;nc&apos;&#13;&#10;THEN [analytical_customer_id] END)' />
      </column>
      <column caption='2022 users' datatype='integer' name='[2022 orders (copia)_741123648367267882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Last year (copia)_741123648352964626] THEN [unique_users] END' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0h10mt20fmjewh1bhbbp8148spac].[sum:churn_orders:qk]&quot;' value='Additional Churn Orders' />
          <alias key='&quot;[federated.0h10mt20fmjewh1bhbbp8148spac].[sum:incentives:qk]&quot;' value='Incentives' />
          <alias key='&quot;[federated.0h10mt20fmjewh1bhbbp8148spac].[sum:promo_orders:qk]&quot;' value='Promo orders' />
          <alias key='&quot;[federated.0h10mt20fmjewh1bhbbp8148spac].[usr:Calculation_226024440264855552:qk]&quot;' value='Monthly Frequency' />
        </aliases>
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_226024440264855552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([unique_users])/12' />
      </column>
      <column caption='Max orders' datatype='real' name='[Calculation_226024440277676033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])+SUM([churn_orders])' />
      </column>
      <column caption='Avg DF' datatype='real' default-format='c&quot;$&quot;#,##0.00;&quot;$&quot;-#,##0.00' name='[Calculation_226024440293683204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([df])/SUM([orders])' />
      </column>
      <column aggregation='Sum' caption='Customer first year' datatype='integer' name='[Calculation_226024440498536455]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [acq_year]: COUNTD([analytical_customer_id]) }' />
      </column>
      <column caption='Retention rate NC' datatype='real' default-format='p0.0%' name='[Calculation_226024440498950152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])/SUM([Calculation_226024440498536455])' />
      </column>
      <column caption='count ids' datatype='integer' name='[Calculation_741123647918981121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([analytical_customer_id])' />
      </column>
      <column caption='Customer first purchase' datatype='date' default-format='*yyyy' name='[Calculation_741123648231952393]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [analytical_customer_id] : MIN([order_year])}' />
      </column>
      <column caption='2021' datatype='boolean' name='[Calculation_741123648350117905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR(DATEADD(&apos;year&apos;,-2,TODAY()))=YEAR([order_year])' />
      </column>
      <column caption='2022 orders' datatype='integer' name='[Calculation_741123648353132563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Last year (copia)_741123648352964626] THEN [orders] END' />
      </column>
      <column caption='Order Growth UP' datatype='string' name='[Calculation_741123648353845269]' role='measure' type='nominal'>
