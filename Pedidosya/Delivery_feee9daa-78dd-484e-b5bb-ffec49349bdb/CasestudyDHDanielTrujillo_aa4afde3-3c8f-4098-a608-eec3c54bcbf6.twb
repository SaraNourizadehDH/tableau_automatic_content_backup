    <worksheet name='Order scorecard'>
      <repository-location id='Orderscorecard' path='/t/Pedidosya/workbooks/Case_study_DHDanielTrujillo' revision='' site='Pedidosya' />
      <table>
        <view>
          <datasources>
            <datasource caption='Raw_data_from_postgres (Casem study results - Daniel Trujillo)' name='federated.0h10mt20fmjewh1bhbbp8148spac' />
          </datasources>
          <datasource-dependencies datasource='federated.0h10mt20fmjewh1bhbbp8148spac'>
            <column caption='2021 orders ' datatype='integer' name='[2022 orders (copia)_741123648353460244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_741123648350117905] THEN [orders] END' />
            </column>
            <column caption='2021' datatype='boolean' name='[Calculation_741123648350117905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR(DATEADD(&apos;year&apos;,-2,TODAY()))=YEAR([order_year])' />
            </column>
            <column caption='2022 orders' datatype='integer' name='[Calculation_741123648353132563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Last year (copia)_741123648352964626] THEN [orders] END' />
            </column>
            <column caption='Order Growth UP' datatype='string' name='[Calculation_741123648353845269]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_741123648353132563])-SUM([2022 orders (copia)_741123648353460244]) &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='&amp; growth orders' datatype='real' default-format='p0.00%' name='[Calculation_741123648356540441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_741123648353132563])/SUM([2022 orders (copia)_741123648353460244])-1' />
            </column>
            <column caption='2022' datatype='boolean' name='[Last year (copia)_741123648352964626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR(DATEADD(&apos;year&apos;,-1,TODAY()))=YEAR([order_year])' />
            </column>
            <column caption='Order Growth DOWN' datatype='string' name='[Order Growth UP (copia)_741123648355102742]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_741123648353132563])-SUM([2022 orders (copia)_741123648353460244]) &lt; 0 THEN &quot;▼&quot; END' />
            </column>
            <column caption='Order Year' datatype='date' default-format='*yyyy' name='[order_year]' role='dimension' type='ordinal' />
            <column caption='Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[2022 orders (copia)_741123648353460244]' derivation='Sum' name='[sum:2022 orders (copia)_741123648353460244:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_741123648353845269]' derivation='User' name='[usr:Calculation_741123648353845269:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_741123648356540441]' derivation='User' name='[usr:Calculation_741123648356540441:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Growth UP (copia)_741123648355102742]' derivation='User' name='[usr:Order Growth UP (copia)_741123648355102742:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='203' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#666666' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='color' value='#ffffff' />
          </style-rule>
        </style>
