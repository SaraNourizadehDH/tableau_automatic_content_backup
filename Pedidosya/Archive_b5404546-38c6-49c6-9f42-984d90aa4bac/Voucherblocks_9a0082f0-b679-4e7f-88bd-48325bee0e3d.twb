            <column caption='FP_uid' datatype='real' name='[FP_hits (copia)_586312394218115077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum (IF [false_positive] == TRUE THEN [Calculation_586312394199830531] ELSE 0 END) / sum (IF [Calculation_586312394186018816]&lt;&gt; &apos;CLEAN&apos; THEN [Calculation_586312394199830531] ELSE 0 END)' />
