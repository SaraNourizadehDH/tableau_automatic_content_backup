    <dashboard name='Voucher claim'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Pedidosya/workbooks/Voucherblocks/Voucherclaim?rev=' id='Voucherclaim' path='/t/Pedidosya/workbooks/Voucherblocks' revision='' site='Pedidosya' />
      <style />
      <size maxheight='1600' maxwidth='1400' minheight='1600' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='marketing' name='federated.1ovzszm1ppzrzc18fjquj1kjhlaq' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Daily' caption='View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
          <calculation class='tableau' formula='&quot;day&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Weekly' value='&quot;week&quot;' />
            <member alias='Daily' value='&quot;day&quot;' />
            <member alias='Monthly' value='&quot;month&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1ovzszm1ppzrzc18fjquj1kjhlaq'>
        <column caption='Algorithm' datatype='string' name='[Calculation_1159395447507210241]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [return_value] &#13;&#10;when &apos;0&apos; then &apos;0 - Clean&apos;&#13;&#10;when &apos;1&apos; then &apos;1 - Eurus&apos;&#13;&#10;when &apos;2&apos; then &apos;2 - Gadget&apos;&#13;&#10;when &apos;3&apos; then &apos;3 - Eurus+Gadget&apos;&#13;&#10;when &apos;4&apos; then &apos;4 - Device rules&apos;&#13;&#10;else &apos;Others&apos; end' />
        </column>
        <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Date Api Request' datatype='date' name='[date_api_request]' role='dimension' type='ordinal' />
        <column-instance column='[Calculation_1159395447507210241]' derivation='None' name='[none:Calculation_1159395447507210241:nk]' pivot='key' type='nominal' />
        <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
