            <column caption='Algorithm' datatype='string' name='[Calculation_1159395447507210241]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [return_value] &#13;&#10;when &apos;0&apos; then &apos;0 - Clean&apos;&#13;&#10;when &apos;1&apos; then &apos;1 - Eurus&apos;&#13;&#10;when &apos;2&apos; then &apos;2 - Gadget&apos;&#13;&#10;when &apos;3&apos; then &apos;3 - Eurus+Gadget&apos;&#13;&#10;when &apos;4&apos; then &apos;4 - Device rules&apos;&#13;&#10;else &apos;Others&apos; end' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_447826706045980672]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parámetro 1]=&apos;day&apos; THEN [date_api_request]&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;week&apos; THEN DATETRUNC(&apos;week&apos;,[date_api_request])&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;month&apos; THEN DATETRUNC(&apos;month&apos;,[date_api_request])&#13;&#10;END)' />
            </column>
            <column caption='respuesta' datatype='string' name='[Calculation_586312394186018816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [return_value] WHEN &apos;1&apos; THEN &apos;E&amp;G&apos; &#13;&#10;            WHEN &apos;2&apos; THEN &apos;E&amp;G&apos; &#13;&#10;            WHEN &apos;3&apos; THEN &apos;E&amp;G&apos; &#13;&#10;            WHEN &apos;4&apos; THEN &apos;DR&apos;&#13;&#10;            WHEN &apos;0&apos; THEN &apos;CLEAN&apos; &#13;&#10;            ELSE &apos;OTHER&apos; END' />
            </column>
            <column caption='blockrate_hits' datatype='real' name='[Calculation_586312394192818177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum (IF [Calculation_586312394186018816]&lt;&gt; &apos;CLEAN&apos; THEN [hits] ELSE 0 END) / SUM([hits])' />
