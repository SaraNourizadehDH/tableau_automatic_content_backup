            <run fontalignment='1' fontcolor='#c14a4c' fontname='Arial' fontsize='10'>block rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing' name='federated.1ovzszm1ppzrzc18fjquj1kjhlaq' />
