        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.09swmca1yf9viw1cmuw331fmlsae' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT 
DATE(r.messageTimestamp) AS date_message
, r.result AS result_resolver
, s.reason
, CASE WHEN s.eur_amount >>= 60 THEN '>> 60 EUR' ELSE '<< 60 EUR' END AS range_eur
, a.country
, count(*) AS qty
, sum(s.eur_amount) AS amount

FROM `peya-data-origins-pro.cl_fraud_risk.resolver_result` AS r
LEFT JOIN `peya-data-origins-pro.cl_fraud_risk.scoring` AS s ON s.scoring_id = r.scoring_id
LEFT JOIN `peya-data-origins-pro.cl_fraud_risk.purchase_scoring` AS a ON a.scoring_id = r.scoring_id
WHERE s.messageTimestamp >> '2022-06-20 18:21:24'
AND UPPER(r.resolver_id) IN ('DM', 'DECISION_MANAGER')
and r.scoring_id IS NOT NULL
AND s.reason != 'payment_retry'
AND s.reason != 'whitelist'
AND r.result IN ('ACCEPT', 'REJECT')

GROUP BY 1, 2, 3, 4, 5]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.09swmca1yf9viw1cmuw331fmlsae' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT 
DATE(r.messageTimestamp) AS date_message
