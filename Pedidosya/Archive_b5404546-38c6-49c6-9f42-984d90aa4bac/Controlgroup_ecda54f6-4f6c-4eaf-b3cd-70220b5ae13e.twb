      <column caption='group' datatype='string' name='[Calculation_1081989861152669696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(UPPER([reason]), &quot;DECISION&quot;) THEN &quot;DECISION_MANAGER&quot; ELSEIF CONTAINS(UPPER([reason]), &quot;CONTROL_GROUP_CARD&quot;) THEN &quot;CONTROL_GROUP&quot; ELSE &quot;OTHER&quot; END' />
