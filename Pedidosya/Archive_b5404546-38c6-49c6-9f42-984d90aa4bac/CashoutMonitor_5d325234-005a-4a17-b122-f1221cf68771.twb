        <relation connection='bigquery.1xtv0bw18kom8n18hmzly13rw4q4' name='Consulta SQL personalizada' type='text'>SELECT&#10;    country_name&#10;    , vertical&#10;    , trust_segment&#10;    , lower(payment_mean) as payment_mean&#10;    , o.city.city_name&#10;    , date(a.order_created_utc) date    &#10;    , case when darkstore = 1 then true else false end as is_darkstore&#10;    , case when prf_amt &gt;&gt; 0 then &apos;Refund&apos; when comp_amt &gt;&gt; 0 then &apos;Compensation&apos; else null end prc_type&#10;&#10;    , round(sum(a.order_amount_eur)) total_amt&#10;    , round(sum(case when a.order_status = &apos;CONFIRMED&apos; then a.order_amount_eur else 0 end)) gmv&#10;    , round(sum(prc_amt)) partial_comp_amt&#10;    , round(sum(risk_prc_amt)) risk_partial_comp_amt&#10;    , round(sum(case when a.order_status = &apos;REJECTED&apos; then a.order_amount_eur else 0 end)) rejected_amt&#10;    , round(sum(case when a.order_status = &apos;REJECTED&apos; and (a.is_reject_risk_customer = 1) then a.order_amount_eur else 0 end)) rejected_risk_amt&#10;    , sum(coup.coupon_used_amt) mkt_amt&#10;    &#10;&#10;FROM `peya-datamarts-pro.dm_fraud.orders_main` a &#10;LEFT JOIN `peya-datamarts-pro.dm_fraud.orders_customer_trust_segment` c on a.order_id = c.order_id&#10;left join `peya-bi-tools-pro.il_core.fact_orders` as o on a.order_id = o.order_id and o.registered_date &gt;&gt;= &apos;2021-01-01&apos; and o.registered_date &gt;&gt;= date_add(current_date,interval -18 month)&#10;left join `peya-datamarts-pro.dm_fraud.orders_prc` as prc on a.order_id = prc.order_id&#10;left join `peya-datamarts-pro.dm_fraud.orders_coupons` as coup on a.order_id = coup.order_id&#10;  &#10;WHERE date(a.order_created_utc) &gt;&gt;= date_add(current_date,interval -18 month)&#10;AND date(a.order_created_utc) &gt;&gt;= &apos;2021-01-01&apos;&#10;--- no tomar datos de órdenes mayores a 2000 euros &#10;AND a.order_amount_eur &lt;&lt; 2000 &#10;GROUP BY 1,2,3,4,5,6,7,8</relation>
