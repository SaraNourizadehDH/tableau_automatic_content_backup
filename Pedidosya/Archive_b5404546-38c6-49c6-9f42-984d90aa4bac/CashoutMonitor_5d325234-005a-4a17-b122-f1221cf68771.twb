            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='group_pf_operativo' server-oauth='server-custom' username='adriano.barsanti@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
