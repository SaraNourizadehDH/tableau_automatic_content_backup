      <column caption='Amount fail rate trusted' datatype='real' name='[Amount fail rate newbie  (copia)_18577398852571137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [trust_segment]=&apos;Trusted&apos; then [rejected_amt] else 0 end)/&#13;&#10;SUM(if [trust_segment]=&apos;Trusted&apos; then [total_amt] else 0 end)' />
      </column>
      <column caption='Amount risk fail rate newbie' datatype='real' name='[Amount fail rate newbie  (copia)_18577398856916995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [trust_segment]=&apos;Newbie&apos; then [rejected_risk_amt] else 0 end)/&#13;&#10;SUM(if [trust_segment]=&apos;Newbie&apos; then [total_amt] else 0 end)' />
      </column>
      <column caption='Marketing amount newbie ' datatype='real' name='[Amount fail rate newbie  (copia)_234750185543413765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [trust_segment]=&apos;Newbie&apos; then [mkt_amt] else 0 end)/&#13;&#10;SUM(if [trust_segment]=&apos;Newbie&apos; then [gmv] else 0 end)' />
      </column>
      <column caption='Amount fail rate untrusted' datatype='real' name='[Amount fail rate trusted (copia)_18577398852710402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [trust_segment]=&apos;Untrusted&apos; then [rejected_amt] else 0 end)/&#13;&#10;SUM(if [trust_segment]=&apos;Untrusted&apos; then [total_amt] else 0 end)' />
      </column>
      <column caption='Amount risk fail rate untrusted' datatype='real' name='[Amount risk fail rate newbie (copia)_18577398857019396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [trust_segment]=&apos;Untrusted&apos; then [rejected_risk_amt] else 0 end)/&#13;&#10;SUM(if [trust_segment]=&apos;Untrusted&apos; then [total_amt] else 0 end)' />
      </column>
      <column caption='Amount risk fail rate trusted' datatype='real' name='[Amount risk fail rate untrusted (copia)_18577398857134085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [trust_segment]=&apos;Trusted&apos; then [rejected_risk_amt] else 0 end)/&#13;&#10;SUM(if [trust_segment]=&apos;Trusted&apos; then [total_amt] else 0 end)' />
      </column>
      <column caption='Fail rate' datatype='real' name='[Calculation_1160521378624901123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rejected_amt])/SUM([total_amt])' />
      </column>
      <column caption='% Risk Fail Rate' datatype='real' name='[Calculation_1178817268052164608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rejected_risk_amt])/SUM([total_amt])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1321525064925794304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(If [Parameters].[Parámetro 1]=&apos;day&apos; THEN [date]&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;week&apos; THEN DATETRUNC(&apos;week&apos;,[date])&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;month&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;END)' />
      </column>
      <column caption='% Mkt amount' datatype='real' name='[Calculation_234750185521336320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mkt_amt])/SUM([gmv])' />
      </column>
      <column caption='Risk PRC Rate' datatype='real' name='[Calculation_305400399304589312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([risk_partial_comp_amt])/SUM([gmv])' />
      </column>
      <column caption='Risk PRC Rate Untrusted' datatype='real' name='[Calculation_87538768125640705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [trust_segment]=&apos;Untrusted&apos; then [risk_partial_comp_amt] else 0 end)/&#13;&#10;SUM(if [trust_segment]=&apos;Untrusted&apos; then [gmv] else 0 end)' />
      </column>
      <column caption='% of Risk from Amount fail rate' datatype='real' name='[Calculation_87538768133595140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rejected_risk_amt])/SUM([gmv])' />
      </column>
      <column caption='risk partial comp rate' datatype='real' name='[Calculation_989103118156722176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([risk_partial_comp_amt])/SUM([gmv])' />
      </column>
      <column caption='% risk partial comp' datatype='real' name='[Calculation_989103118163472385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([risk_partial_comp_amt])/SUM([gmv])' />
      </column>
      <column caption='Risk fail rate' datatype='real' name='[Fail rate (copia)_267401277531586560]' role='measure' type='quantitative'>
