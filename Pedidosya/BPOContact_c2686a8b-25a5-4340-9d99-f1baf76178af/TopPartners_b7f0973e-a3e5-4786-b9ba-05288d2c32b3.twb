      <table>
        <view>
          <datasources>
            <datasource caption='bo_bi_vw_gral_red_wall_partners (user_gustavo_rossell)' name='federated.1kqup8h17x9ujv13lu3dx1y9fgjv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Seleccion de Tiempo' datatype='string' name='[% Fail Rate Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semanal&quot;'>
              <calculation class='tableau' formula='&quot;Semanal&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqup8h17x9ujv13lu3dx1y9fgjv'>
            <column caption='% Open Time' datatype='real' name='[% Fail Rate (copia)_25332748005601283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([closed_times])&#13;&#10;/SUM([schedule_open_time]))' />
            </column>
            <column caption='% Vendor Late' datatype='real' name='[% Fail Rate (copia)_25332749304332293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_vendor_late]=1 THEN [order_id] END)&#13;&#10;/COUNTD([order_id])' />
            </column>
            <column caption='% Fail Rate' datatype='real' name='[% Online Payment (copia)_25332747983572993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status]&lt;&gt;&apos;CONFIRMED&apos; THEN [order_id] END)&#13;&#10;/COUNTD([order_id])' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[Calculation_2391974420157665280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [order_id] END)' />
            </column>
            <column caption='Confirmed Users' datatype='integer' name='[Calculation_2391974420162236420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [user_id] END)' />
            </column>
            <column caption='% Online Payment' datatype='real' name='[Calculation_25332747927179264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status]=&apos;CONFIRMED&apos; AND [is_online_payment]=1 THEN [order_id] END)&#13;&#10;/COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [order_id] END)' />
            </column>
            <column caption='Lag Ordenes Confirmadas' datatype='integer' name='[Calculation_25332750398484488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP((COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [order_id] END)),1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Crecimiento Respecto al Lag' datatype='real' name='[Calculation_25332750399127561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([Calculation_25332750398484488]) THEN&#13;&#10;    (COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [order_id] END)- [Calculation_25332750398484488]) / [Calculation_25332750398484488]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Confirmed Amount' datatype='real' name='[Confirmed Orders (copia)_25332749300441092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status]=&apos;CONFIRMED&apos; THEN [total_amount] ELSE 0 END)' />
            </column>
            <column caption='Confirmed Orders subsidiadas' datatype='integer' name='[Confirmed Orders plus (copia)_1179661633323868162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status]=&apos;CONFIRMED&apos; AND  [is_subsidized] THEN [order_id] END)' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Closed Times' datatype='real' name='[closed_times]' role='measure' type='quantitative' />
            <column caption='Franchise' datatype='string' name='[franchise]' role='dimension' type='nominal' />
            <column caption='Is Acquisition' datatype='integer' name='[is_acquisition]' role='measure' type='quantitative' />
