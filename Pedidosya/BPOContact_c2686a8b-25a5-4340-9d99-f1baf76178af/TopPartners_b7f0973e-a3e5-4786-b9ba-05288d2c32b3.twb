              </calculation>
            </column>
            <column caption='Lag Ordenes Confirmadas Columnas' datatype='integer' name='[Lag Ordenes Confirmadas (copia)_825284638296469506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP((COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [order_id] END)),-1)'>
