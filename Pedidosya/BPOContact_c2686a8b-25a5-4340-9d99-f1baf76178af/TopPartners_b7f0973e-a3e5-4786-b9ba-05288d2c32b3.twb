            <column caption='Is Top 5' datatype='string' name='[is_top_5]' role='dimension' type='nominal' />
            <column caption='Is Vendor Late' datatype='integer' name='[is_vendor_late]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_25332750381096966]' derivation='MDY' name='[md:Calculation_25332750381096966:ok]' pivot='key' type='ordinal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
