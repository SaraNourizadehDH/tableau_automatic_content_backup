            <column caption='% Crecimiento Respecto al Periodo Previo' datatype='real' name='[% Crecimiento Respecto al Lag (copia)_825284638296768515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([Calculation_25332750398484488]) THEN&#13;&#10;    (COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [order_id] END)- [Lag Ordenes Confirmadas (copia)_825284638296469506]) / [Lag Ordenes Confirmadas (copia)_825284638296469506]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
