          <datasource-dependencies datasource='Parameters'>
            <column caption='Seleccion de Tiempo' datatype='string' name='[% Fail Rate Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semanal&quot;'>
              <calculation class='tableau' formula='&quot;Semanal&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqup8h17x9ujv13lu3dx1y9fgjv'>
            <column caption='Categoria Incentivo' datatype='string' name='[Calculation_1179661633493909508]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_df0] = 1 AND [is_subsidized] = FALSE AND [has_voucher_discount] = 0 THEN &apos;Solo DF0&apos;&#13;&#10;ELSEIF [is_df0] = 0 AND [is_subsidized] = TRUE AND [has_voucher_discount] = 0 THEN &apos;Solo Subsidio&apos;&#13;&#10;ELSEIF [is_df0] = 0 AND [is_subsidized] = FALSE AND [has_voucher_discount] = 1 THEN &apos;Solo Voucher&apos;&#13;&#10;ELSEIF [is_df0] = 1 AND [is_subsidized] = TRUE AND [has_voucher_discount] = 0 THEN &apos;DF0+Subsidio&apos;&#13;&#10;ELSEIF [is_df0] = 1 AND [is_subsidized] = FALSE AND [has_voucher_discount] = 1 THEN &apos;DF0+Voucher&apos;&#13;&#10;ELSEIF [is_df0] = 0 AND [is_subsidized] = TRUE AND [has_voucher_discount] = 1 THEN &apos;Subsidio+Voucher&apos;&#13;&#10;ELSEIF [is_df0] = 1 AND [is_subsidized] = TRUE AND [has_voucher_discount] = 1 THEN &apos;DF0+Subsidio+Voucher&apos;&#13;&#10;ELSE &apos;Orgánica&apos;&#13;&#10;END' />
            </column>
            <column caption='Confirmed Orders' datatype='integer' name='[Calculation_2391974420157665280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status]=&apos;CONFIRMED&apos; THEN [order_id] END)' />
            </column>
            <column caption='Filtro Fecha' datatype='datetime' name='[Calculation_25332750381096966]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[% Fail Rate Parámetro]&#13;&#10;  WHEN &quot;Diaria&quot; THEN [registered_date]&#13;&#10;  WHEN &quot;Semanal&quot; THEN DATETRUNC(&apos;week&apos;, [registered_date])&#13;&#10;  WHEN &quot;Mensual&quot; THEN DATETRUNC(&apos;month&apos;, [registered_date])&#13;&#10;END' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Franchise' datatype='string' name='[franchise]' role='dimension' type='nominal' />
            <column datatype='integer' name='[has_voucher_discount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[is_df0]' role='measure' type='quantitative' />
