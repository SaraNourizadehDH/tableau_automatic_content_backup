          <named-connection caption='BigQuery' name='bigquery.1i0ygi713xhmnl11u7thf0zqs6vk'>
            <connection CATALOG='peya-costa-rica' EXECCATALOG='peya-costa-rica' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-costa-rica' schema='user_ricardo_wille' server-oauth='' username='ricardo.wille@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1i0ygi713xhmnl11u7thf0zqs6vk' name='Custom SQL Query' type='text'>SELECT level_report.*, suppliers.supplier_name&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.tableau_promo_roi_campaign_level_report` level_report&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.products_suppliers` product_suppliers ON level_report.sku = product_suppliers.sku&#13;
LEFT JOIN UNNEST (product_suppliers.suppliers) as suppliers&#13;
WHERE level_report.country_code = &apos;cr&apos; &#13;
AND order_date &gt;&gt; DATE(&apos;2025-01-01&apos;)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1i0ygi713xhmnl11u7thf0zqs6vk' name='Custom SQL Query' type='text'>SELECT level_report.*, suppliers.supplier_name&#13;
FROM `fulfillment-dwh-production.curated_data_shared_dmart.tableau_promo_roi_campaign_level_report` level_report&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.products_suppliers` product_suppliers ON level_report.sku = product_suppliers.sku&#13;
LEFT JOIN UNNEST (product_suppliers.suppliers) as suppliers&#13;
WHERE level_report.country_code = &apos;cr&apos; &#13;
AND order_date &gt;&gt; DATE(&apos;2025-01-01&apos;)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
