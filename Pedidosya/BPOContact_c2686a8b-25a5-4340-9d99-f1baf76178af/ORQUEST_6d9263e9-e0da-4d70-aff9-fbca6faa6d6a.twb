  <datasources>
    <datasource caption='query forecast' inline='true' name='federated.1embhp21b8whu112mb11805u0c7n' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1xexnda04nftco1b0umf209qvadi'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_marcos_tedesco' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1xexnda04nftco1b0umf209qvadi' name='Consulta SQL personalizada' type='text'>WITH &#13;
forecast AS (&#13;
  SELECT&#13;
    product_id,&#13;
    business_id,&#13;
    measure,  &#13;
    DATE(dia) AS fecha,&#13;
    SUM(value) AS valor_fcst&#13;
  FROM `peya-data-origins-pro.raw_orquest.output_measure_forecast`,&#13;
  UNNEST(GENERATE_DATE_ARRAY(DATE(`from`), DATE(`to`))) AS dia&#13;
  GROUP BY 1,2,3,4&#13;
),&#13;
&#13;
store AS (&#13;
  SELECT DISTINCT&#13;
    warehouse_id,&#13;
    store_name&#13;
  FROM `peya-delivery-and-support.user_marcos_tedesco.ops_okr`&#13;
),&#13;
&#13;
reales AS (&#13;
  WITH &#13;
  st AS (&#13;
    SELECT&#13;
      destination_warehouse,&#13;
      FORMAT_DATE(&apos;%Y%m%d&apos;, DATE(completed_at)) AS DATE,&#13;
      SUM(received_qty) AS units_received_st&#13;
    FROM `peya-datamarts-pro.dm_dmarts.dmarts_store_transfers`&#13;
    WHERE DATE(completed_at) &gt;&gt;= &apos;2023-01-01&apos; AND transfer_status = &apos;COMPLETED&apos;&#13;
    GROUP BY 1, 2&#13;
  ),&#13;
&#13;
  po AS (&#13;
    SELECT&#13;
      store_name,&#13;
      FORMAT_DATE(&apos;%Y%m%d&apos;, DATE(receiving_timestamp)) AS DATE,&#13;
      SUM(received_qty) AS units_received_po&#13;
    FROM `peya-datamarts-pro.dm_dmarts.dmarts_purchase_orders_sku_level`&#13;
    WHERE DATE(receiving_timestamp) &gt;&gt;= &apos;2023-01-01&apos;&#13;
      AND po_creation_date &gt;&gt;= &apos;2022-01-01&apos;&#13;
      AND po_status = &apos;done&apos;&#13;
    GROUP BY 1, 2&#13;
  ),&#13;
&#13;
  ord AS (&#13;
    SELECT&#13;
      warehouse.warehouse_name AS STORE,&#13;
      FORMAT_DATE(&apos;%Y%m%d&apos;, DATE(order_placed_localtime_at)) AS DATE,&#13;
      &apos;GENERAL&apos; AS ZONE,&#13;
      SUM(order_value_lc.amt_gmv_lc) AS sales,&#13;
      COUNT(DISTINCT order_id) AS tickets,&#13;
      SUM(qty_ordered) AS units&#13;
    FROM `peya-data-origins-pro.cl_dmarts.customer_orders` c&#13;
    WHERE DATE(order_placed_localtime_at) &gt;&gt;= &apos;2023-01-01&apos;&#13;
      AND order_status = &apos;sent&apos;&#13;
    GROUP BY 1, 2&#13;
  ),&#13;
&#13;
  calendar AS (&#13;
    SELECT STORE, DATE&#13;
    FROM (SELECT DISTINCT STORE FROM ord)&#13;
    CROSS JOIN (SELECT DISTINCT DATE FROM ord)&#13;
  ),&#13;
&#13;
  base AS (&#13;
    SELECT&#13;
      c.STORE,&#13;
      c.DATE,&#13;
      COALESCE(ord.ZONE, &apos;GENERAL&apos;) AS ZONE,&#13;
      SAFE_CAST(COALESCE(ord.sales, 0) AS NUMERIC) AS sales,&#13;
      SAFE_CAST(COALESCE(ord.tickets, 0) AS NUMERIC) AS tickets,&#13;
      SAFE_CAST(COALESCE(ord.units, 0) AS NUMERIC) AS units_out,&#13;
      SAFE_CAST(COALESCE(st.units_received_st, 0) + COALESCE(po.units_received_po, 0) AS NUMERIC) AS units_in&#13;
    FROM calendar c&#13;
    LEFT JOIN ord ON c.STORE = ord.STORE AND c.DATE = ord.DATE&#13;
    LEFT JOIN st ON c.STORE = st.destination_warehouse AND c.DATE = st.DATE&#13;
    LEFT JOIN po ON c.STORE = po.store_name AND c.DATE = po.DATE&#13;
  )&#13;
&#13;
  SELECT&#13;
    PARSE_DATE(&apos;%Y%m%d&apos;, DATE) AS fecha,&#13;
    STORE AS store_name,&#13;
    measure,&#13;
    value AS valor_real&#13;
  FROM (&#13;
    SELECT&#13;
      base.DATE,&#13;
      base.STORE,&#13;
      base.sales,&#13;
      base.tickets,&#13;
      base.units_in,&#13;
      base.units_out&#13;
    FROM base&#13;
  )&#13;
  UNPIVOT (&#13;
    value FOR measure IN (&#13;
      sales AS &quot;sales&quot;,&#13;
      tickets AS &quot;tickets&quot;,&#13;
      units_in AS &quot;units_in&quot;,&#13;
      units_out AS &quot;units_out&quot;&#13;
    )&#13;
  )&#13;
)&#13;
&#13;
-- Unión final forecast + reales&#13;
SELECT&#13;
  fcst.fecha,&#13;
  s.store_name,&#13;
  fcst.measure,&#13;
  fcst.valor_fcst,&#13;
  r.valor_real&#13;
FROM forecast fcst&#13;
JOIN store s ON fcst.product_id = s.warehouse_id&#13;
LEFT JOIN reales r &#13;
  ON r.fecha = fcst.fecha&#13;
  AND r.store_name = s.store_name&#13;
  AND r.measure = fcst.measure</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
