      PARSE_TIMESTAMP(&apos;%Y-%m-%dT%H:%M:%E*S%Ez&apos;, ts.from),&#13;
      MINUTE&#13;
    ) / 60.0&#13;
  ) AS horas_totales&#13;
FROM `peya-data-origins-pro.raw_orquest.output_assignments_summary_by_service`,&#13;
UNNEST(timeSlots) AS ts,&#13;
UNNEST(GENERATE_DATE_ARRAY(&#13;
