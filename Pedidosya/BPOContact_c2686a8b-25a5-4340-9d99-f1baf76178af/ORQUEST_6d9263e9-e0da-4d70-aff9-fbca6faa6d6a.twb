      sales AS &quot;sales&quot;,&#13;
      tickets AS &quot;tickets&quot;,&#13;
      units_in AS &quot;units_in&quot;,&#13;
      units_out AS &quot;units_out&quot;&#13;
    )&#13;
  )&#13;
)&#13;
&#13;
-- Unión final forecast + reales&#13;
SELECT&#13;
  fcst.fecha,&#13;
  s.store_name,&#13;
  fcst.measure,&#13;
  fcst.valor_fcst,&#13;
  r.valor_real&#13;
FROM forecast fcst&#13;
JOIN store s ON fcst.product_id = s.warehouse_id&#13;
LEFT JOIN reales r &#13;
  ON r.fecha = fcst.fecha&#13;
  AND r.store_name = s.store_name&#13;
  AND r.measure = fcst.measure</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
