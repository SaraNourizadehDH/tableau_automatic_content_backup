      <column caption='Reactivado?' datatype='string' name='[Calculation_4702320995192815617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fact_orders_total_confirmed_orders] &gt;= 1 then &quot;Reactivado&quot; else &quot;Zombie&quot; end' />
