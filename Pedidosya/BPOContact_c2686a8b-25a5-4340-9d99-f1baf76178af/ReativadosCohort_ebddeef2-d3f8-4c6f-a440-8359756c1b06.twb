      <aliases enabled='yes' />
      <column caption='N Partner' datatype='integer' name='[Calculation_220394958128046080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([dim_partner_partner_id])' />
      </column>
      <column caption='Tipo Traspaso' datatype='string' name='[Calculation_220394959202414594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [OldValue] IN (&#13;&#10;    &quot;Javiera Mora&quot;,&#13;&#10;    &quot;Ruben Quintero&quot;,&#13;&#10;    &quot;Felipe Aravena&quot;,&#13;&#10;    &quot;Pablo Godoy&quot;,&#13;&#10;    &quot;Bernardita Marín&quot;,&#13;&#10;    &quot;Francys Molina&quot;,&#13;&#10;    &quot;Olga Araujo&quot;,&#13;&#10;    &quot;Reinier Landkoer&quot;,&#13;&#10;    &quot;Rodrigo Ibacache&quot;,&#13;&#10;    &quot;Sobe Gatica Mella&quot;,&#13;&#10;    &quot;Estefanía Ignacia González&quot;,&#13;&#10;    &quot;Joaquin Camus&quot;,&#13;&#10;    &quot;Joaquín Encina&quot;,&#13;&#10;    &quot;Juan Sebastian Pinto&quot;,&#13;&#10;    &quot;Monserrat Dorregaray&quot;,&#13;&#10;    &quot;Oscar Zapata&quot;,&#13;&#10;    &quot;Ramiro Vera&quot;,&#13;&#10;    &quot;Valeria Ongaro Neira&quot;,&#13;&#10;    &quot;Tatiana Godoy&quot;,&#13;&#10;    &quot;Diego Cruz&quot;,&#13;&#10;    &quot;Pablo Olmedo&quot;,&#13;&#10;    &quot;Michelle Granado&quot;,&#13;&#10;    &quot;Jaqueline Vera&quot;,&#13;&#10;    &quot;Daniel Antonio Mery&quot;,&#13;&#10;    &quot;Patricio Aguilera&quot;,&#13;&#10;    &quot;Catalina Daniela Bozo Salgado&quot;&#13;&#10;) &#13;&#10;and [NewValue] = [Account_Owner]&#13;&#10;&#13;&#10;THEN&#13;&#10;    &quot;Traspaso Sales&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Traspaso entre AM&quot;&#13;&#10;END' />
      </column>
      <column caption='N dias traspasos' datatype='integer' name='[Calculation_631348425581613056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [dim_partner_first_date_online_date], [fecha_traspaso_full])' />
      </column>
      <column caption='Equipo Sales' datatype='string' name='[Calculation_631348426680320010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Usar IF en lugar de CASE&#13;&#10;IF [OldValue] IN (&quot;Javiera Mora&quot;, &quot;Ruben Quintero&quot;, &quot;Estefanía Ignacia González&quot;) THEN &quot;Business Developer&quot;&#13;&#10;ELSEIF [OldValue] IN (&quot;Tatiana Godoy&quot;, &quot;Diego Cruz&quot;, &quot;Pablo Olmedo&quot;, &quot;Michelle Granado&quot;, &quot;Jaqueline Vera&quot;, &quot;Daniel Antonio Mery&quot;) THEN &quot;Onboarding Incubation&quot;&#13;&#10;ELSEIF [OldValue] in (&quot;Bernardita Marín&quot;,&quot;Francys Molina&quot;,&quot;Olga Araujo&quot;,&quot;Reinier Landkoer&quot;,&quot;Rodrigo Ibacache&quot;,&quot;Sobe Gatica Mella&quot;) then &quot;SSU&quot;&#13;&#10;ELSEIF [OldValue] IN (&quot;Felipe Aravena&quot;,&quot;Joaquin Camus&quot;,&quot;Joaquín Encina&quot;,&quot;Juan Sebastian Pinto&quot;,&quot;Monserrat Dorregaray&quot;,&quot;Oscar Zapata&quot;,&quot;Ramiro Vera&quot;,&quot;Patricio Aguilera&quot;,&quot;Catalina Daniela Bozo Salgado&quot;) THEN &quot;Terreno&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
      </column>
      <column caption='Equipo AS' datatype='string' name='[Equipo Sales (copia)_631348426694717452]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dim_partner_account_owner] IN (&quot;Constanza Belen Fuentes&quot;,&quot;Cristian Ignacio Barba&quot;,&quot;Cristian Villagrán&quot;,&quot;CristianHernán Villagrán&quot;,&quot;Diego Rivera&quot;,&quot;Jorge Acevedo&quot;,&quot;José Reyes&quot;,&quot;José Tomás Reyes&quot;,&quot;Shirley Blas&quot;,&quot;Tomás Valdés&quot;,&quot;Yusette Moraga&quot;,&quot;Catalina Altamirano&quot;) THEN &quot;Longtail&quot;&#13;&#10;ELSEIF [dim_partner_account_owner] IN (&quot;Alexandra Romyna Espinoza&quot;,&quot;Felipe Hernández Morales&quot;,&quot;Jerónimo Jarpa Dufey&quot;,&quot;Jorge Escobar Pizarro&quot;) THEN &quot;Regiones Norte&quot;&#13;&#10;ELSEIF [dim_partner_account_owner] in (&quot;Gustavo Melo Salazar&quot;,&quot;Maria Bernardita Duran&quot;,&quot;Bernardita Palma Giralt&quot;,&quot;Sandra Alfonso&quot;,&quot;Daniela Negrón&quot;,&quot;Gaston Alonso Henriquez&quot;,&quot;Ignacio Toro&quot;,&quot;Magdalena Ramírez&quot;,&quot;Mariett Contreras&quot;,&quot;Victoria Delgado&quot;) then &quot;Regiones Sur&quot;&#13;&#10;ELSEIF [dim_partner_account_owner] IN (&quot;Juan Silva Ríos&quot;,&quot;Daniela Ojeda&quot;,&quot;Alysha Ramirez&quot;,&quot;Carla Neira Magliocchetti&quot;,&quot;Marycarmen Sanjuan Villasante&quot;,&quot;Ignacio Hernández&quot;) THEN &quot;Santiago I&quot;&#13;&#10;ELSEIF [dim_partner_account_owner] IN (&quot;Carolina Toloza&quot;,&quot;Constanza García&quot;,&quot;Katherine Tackeray&quot;) THEN &quot;Santiago I-VTA&quot;&#13;&#10;ELSEIF [dim_partner_account_owner] IN (&quot;Felipe García&quot;,&quot;Alejandra Pía Sanchez&quot;,&quot;Jesus Alejandro Trias&quot;,&quot;Pablo Cárdenas&quot;,&quot;Patricio Ignacio Benavides&quot;,&quot;Vanessa Ortiz&quot;,&quot;Shayda Salem Peña&quot;) THEN &quot;Santiago II&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
      </column>
      <column caption='Mes Cohort' datatype='string' name='[Fecha Traspaso Month (copia)_1319273267061104640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;month&apos;, &#13;&#10;        DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyy-MM&apos;, [fecha_traspaso_month])), &#13;&#10;        DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyy-MM&apos;,[date_lookup_date_month]))&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Mes de traspaso' datatype='datetime' name='[Fecha Traspaso Month (copia)_1319273267061792769]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPARSE(&apos;YYYY-MM&apos;,[fecha_traspaso_month])' />
      </column>
      <column caption='N dias traspasos  ##' datatype='string' name='[N dias traspasos (copia)_631348425582034945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [dim_partner_first_date_online_date], [fecha_traspaso_full]) &lt;= 15 THEN&#13;&#10;    &quot;0-15 días&quot;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [dim_partner_first_date_online_date], [fecha_traspaso_full]) &lt;= 30 THEN&#13;&#10;    &quot;16-30 días&quot;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [dim_partner_first_date_online_date], [fecha_traspaso_full]) &lt;= 60 THEN&#13;&#10;    &quot;31-60 días&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Más de 60 días&quot;&#13;&#10;END' />
      </column>
      <column caption='New Value' datatype='string' name='[NewValue]' role='dimension' type='nominal' />
      <column caption='Ejecutivos Sales' datatype='string' name='[OldValue]' role='dimension' type='nominal' />
      <column caption='Traspasos Pato' datatype='string' name='[Tipo Traspaso (copia)_220394959207002117]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [OldValue] = &quot;Patricio Aguilera&quot; and [NewValue] = &quot;Constanza Belen Fuentes&quot; or [NewValue] = &quot;Cristian Ignacio Barba&quot; or [NewValue] = &quot;Cristian Villagrán&quot;&#13;&#10;then &quot;Traspaso Swat&quot;&#13;&#10;ELSE &quot;Traspaso Sales&quot;&#13;&#10;&#13;&#10;end' />
      </column>
      <column caption='Agg Fact Partner Times Open Times Hour' datatype='real' name='[agg_fact_partner_times_open_times_hour]' role='measure' type='quantitative' />
      <column caption='Agg Fact Sessions By Partner Daily Cvr 1' datatype='real' name='[agg_fact_sessions_by_partner_daily_cvr_1]' role='measure' type='quantitative' />
      <column caption='Agg Fact Sessions By Partner Daily Qty Sessions' datatype='real' name='[agg_fact_sessions_by_partner_daily_qty_sessions]' role='measure' type='quantitative' />
      <column caption='Mes Cohort ROH' datatype='string' name='[date lookup date month (traspasos longtail CL ROH) (copia)_1858297848730226689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;month&apos;, &#13;&#10;        DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyy-MM&apos;, [fecha_traspaso_month])), &#13;&#10;        DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyy-MM&apos;,[date_lookup_date_month (traspasos_longtail_CL_ROH)]))&#13;&#10;    )&#13;&#10;)' />
      </column>
