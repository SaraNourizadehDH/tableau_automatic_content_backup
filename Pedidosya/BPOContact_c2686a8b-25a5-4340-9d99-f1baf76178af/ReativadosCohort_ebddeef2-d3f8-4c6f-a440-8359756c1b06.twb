      <column caption='Tipo Opportunity' datatype='string' name='[type_opportunity (copia)_501869944088727552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([type_opportunity], &quot;New Business&quot;) THEN &quot;New Business&quot;&#13;&#10;ELSEIF CONTAINS([type_opportunity], &quot;Win Back&quot;) THEN &quot;Win Back&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
