      </column>
      <column caption='Mes Cohort' datatype='string' name='[Calculation_4702320995198840835]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;month&apos;, &#13;&#10;        [mes_reactivacion], &#13;&#10;        DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyy-MM&apos;,[date_lookup_date_month]))&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
