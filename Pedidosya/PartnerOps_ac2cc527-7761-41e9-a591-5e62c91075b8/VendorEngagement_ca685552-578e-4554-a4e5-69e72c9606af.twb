      </column>
      <column caption='VL10&apos;_sup_outliers' datatype='boolean' name='[Calculation_1365435171061665794]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([Calculation_1365435171060764673])&gt;= (WINDOW_PERCENTILE(AVG([Calculation_1365435171060764673]),0.75)+&#13;&#10;1.5*(WINDOW_PERCENTILE(AVG([Calculation_1365435171060764673]),0.75)-&#13;&#10;WINDOW_PERCENTILE(AVG([Calculation_1365435171060764673]),0.25)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='VL10&apos;_inf_outliers' datatype='boolean' name='[Calculation_1365435171061956611]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([Calculation_1365435171060764673])&lt;= (WINDOW_PERCENTILE(AVG([Calculation_1365435171060764673]),0.25)-&#13;&#10;1.5*(WINDOW_PERCENTILE(AVG([Calculation_1365435171060764673]),0.75)-&#13;&#10;WINDOW_PERCENTILE(AVG([Calculation_1365435171060764673]),0.25)))'>
          <table-calc ordering-type='Rows' />
