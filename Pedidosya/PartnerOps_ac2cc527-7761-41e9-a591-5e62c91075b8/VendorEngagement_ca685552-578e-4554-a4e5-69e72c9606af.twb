              <calculation class='tableau' formula='IF [rating] &gt;= [Parameters].[Threshold 3 rating (copia)_815996009382596612] THEN 4&#13;&#10;ELSEIF [rating] &gt;= [Parameters].[Threshold 2 rating (copia)_815996009381912579] THEN 3&#13;&#10;ELSEIF [rating] &gt;= [Parameters].[Threshold 1 vfr (copia)_815996009381445633] THEN 2&#13;&#10;ELSEIF [rating] &gt;= [Parameters].[Threshold 2 rating (copia)_815996009381810178] THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='VFR Level' datatype='integer' name='[Content Level (copia)_815996009397923852]' role='measure' type='quantitative'>
