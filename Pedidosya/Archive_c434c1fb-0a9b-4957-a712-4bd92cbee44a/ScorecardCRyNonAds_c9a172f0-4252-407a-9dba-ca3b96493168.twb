      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_A3BCD5BFDA31457D90FE892BBE014864'>
            <properties context=''>
              <relation connection='bigquery.1ltngh90ha04u914izm7f0m4axbd' name='Consulta SQL personalizada' type='text'>select pos.*, fx.rate_eu, (pos.POS_price_actual_lc / fx.rate_eu) Tot_POS_Actual_EU&#13;
from `peya-food-and-groceries.automated_tables_reports.POS_DB_Revenue` pos&#13;
left join(&#13;
select dc.country_name, extract(month from dcr.currency_exchange_date) mes, extract(year from dcr.currency_exchange_date) year, dcr.rate_eu&#13;
from `peya-bi-tools-pro.il_core.dim_currency_exchange` dcr&#13;
left join `peya-bi-tools-pro.il_core.dim_country` dc&#13;
on dcr.currency_id = dc.currency_id&#13;
) fx&#13;
on pos.country_name = fx.country_name and extract(year from pos.date_id) = year and extract(month from pos.date_id) = mes</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
