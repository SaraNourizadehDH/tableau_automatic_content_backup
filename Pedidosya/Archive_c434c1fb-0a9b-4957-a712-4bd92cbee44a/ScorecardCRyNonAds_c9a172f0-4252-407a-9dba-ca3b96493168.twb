    <worksheet name='POS EC Penet'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Partners Evolution&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='POS_Revenue' name='federated.1ufdu1q0n919wm1ejwvm81a4e4zn' />
          </datasources>
          <datasource-dependencies datasource='federated.1ufdu1q0n919wm1ejwvm81a4e4zn'>
            <column caption='Q Partners WPOS' datatype='integer' name='[Calculation_1343198627060453381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [device_id] != &quot;&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Diff pp pos penet vs target' datatype='real' default-format='p0%' name='[Calculation_1785114356601237505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_244883270332792832]-[Calculation_601793553896054785]' />
            </column>
            <column caption='Full Price Penet (%)' datatype='real' default-format='p0%' name='[Calculation_244883270332792832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [device_id] != &quot;&quot; THEN(IF [Tot_POS_Actual_LC] &gt;= [target_price] THEN 1 ELSE 0 END) ELSE 0 END) / sum([Calculation_1343198627060453381])' />
            </column>
            <column caption='Target Penet full price new partners' datatype='integer' name='[Calculation_601793553896054785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='First Date' datatype='date' name='[Calculation_89509083569405953]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [last_first_day_online] &gt;= [first_date_online] THEN [last_first_day_online] ELSE [first_date_online] END' />
            </column>
            <column datatype='real' name='[Tot_POS_Actual_LC]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;República Dominicana&quot;' value='Rep. Dominicana' />
              </aliases>
            </column>
            <column datatype='date' name='[date_id]' role='dimension' type='quantitative' />
            <column datatype='string' name='[device_id]' role='dimension' type='nominal' />
            <column datatype='date' name='[first_date_online]' role='dimension' type='ordinal' />
            <column datatype='date' name='[last_first_day_online]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_89509083569405953]' derivation='MY' name='[my:Calculation_89509083569405953:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_id]' derivation='None' name='[none:date_id:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[target_price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1785114356601237505]' derivation='User' name='[usr:Calculation_1785114356601237505:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_244883270332792832]' derivation='User' name='[usr:Calculation_244883270332792832:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ufdu1q0n919wm1ejwvm81a4e4zn].[my:Calculation_89509083569405953:ok]' filter-group='4'>
            <groupfilter function='member' level='[my:Calculation_89509083569405953:ok]' member='202301' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1ufdu1q0n919wm1ejwvm81a4e4zn].[none:country_name:nk]' filter-group='9'>
            <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Ecuador&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
            <target field='[federated.1ufdu1q0n919wm1ejwvm81a4e4zn].[none:country_name:nk]' />
          </filter>
