            <column-instance column='[Calculation_1878845525346762755]' derivation='Avg' name='[avg:Calculation_1878845525346762755:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1878845525361946629]' derivation='None' name='[none:Calculation_1878845525361946629:nk]' pivot='key' type='nominal' />
