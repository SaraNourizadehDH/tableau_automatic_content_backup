      <aliases enabled='yes' />
      <column caption='% Active Weekly W/POS ' datatype='real' name='[% Active Partners W/POS (copia)_258394067086827523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Q Active Partners WPOS (copia)_258394067086401538])/SUM([q_partners_online])' />
      </column>
      <column caption='% Active Partners W/POS' datatype='real' name='[% Partners W/POS (copia)_258394067083915264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Q Partners WPOS (copia)_258394067084873729])/SUM([q_partners_online])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1ufdu1q0n919wm1ejwvm81a4e4zn].[max:target_price:qk]&quot;' value='Full Price' />
          <alias key='&quot;[federated.1ufdu1q0n919wm1ejwvm81a4e4zn].[sum:q_partners_online:qk]&quot;' value='Online Partners' />
          <alias key='&quot;[federated.1ufdu1q0n919wm1ejwvm81a4e4zn].[usr:Calculation_1343198626965614594:qk]&quot;' value='Fee Penet (%)' />
          <alias key='&quot;[federated.1ufdu1q0n919wm1ejwvm81a4e4zn].[usr:Calculation_244883270336245761:qk]&quot;' value='Online Partners ' />
        </aliases>
      </column>
      <column caption='% Partners W/POS' datatype='real' name='[Calculation_1343198626959040512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1343198627060453381])/SUM([q_partners_online])' />
      </column>
      <column caption='Fee Penetration (%)' datatype='real' name='[Calculation_1343198626965614594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [device_id] != &quot;&quot; THEN(IF [Tot_POS_Actual_LC] &gt; 0 THEN 1 ELSE 0 END) ELSE 0 END) / sum([Calculation_1343198627060453381])' />
      </column>
      <column caption='Tot. Revenue' datatype='real' name='[Calculation_1343198626985365507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([POS_price_actual_lc]) / MAX(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date_id])))))) * 7' />
      </column>
      <column caption='Q Partners WPOS' datatype='integer' name='[Calculation_1343198627060453381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [device_id] != &quot;&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Avg. Price' datatype='real' name='[Calculation_1343198627063332870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([POS_price_actual_lc]) / SUM([Calculation_1343198627060453381])' />
      </column>
      <column caption='Diff pp pos penet vs target' datatype='real' default-format='p0%' name='[Calculation_1785114356601237505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_244883270332792832]-[Calculation_601793553896054785]' />
      </column>
      <column caption='Full Price Penet (%)' datatype='real' default-format='p0%' name='[Calculation_244883270332792832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [device_id] != &quot;&quot; THEN(IF [Tot_POS_Actual_LC] &gt;= [target_price] THEN 1 ELSE 0 END) ELSE 0 END) / sum([Calculation_1343198627060453381])' />
      </column>
      <column caption='Online Partnersv2' datatype='integer' name='[Calculation_244883270336245761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [date_id] = [Calculation_244883270337425410] THEN [q_partners_online] ELSE 0 END)' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_244883270337425410]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, date_id):MAX([date_id])}' />
      </column>
      <column caption='Target Penet full price new partners' datatype='integer' name='[Calculation_601793553896054785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Target Full Price Penet' datatype='integer' name='[Calculation_601793554104324098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Dif PP' datatype='real' default-format='p0%' name='[Calculation_601793554216083459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_601793554104324098]-[Calculation_244883270332792832]' />
      </column>
      <column caption='First Date' datatype='date' name='[Calculation_89509083569405953]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [last_first_day_online] &gt;= [first_date_online] THEN [last_first_day_online] ELSE [first_date_online] END' />
      </column>
      <column caption='Tot. Revenue EU' datatype='real' name='[Calculation_89509083594444802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Tot_POS_Actual_EU]) / MAX(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date_id])))))) * 7' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Cálculo1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_601793554104324098]) / TOTAL(SUM([Calculation_601793554104324098]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Q Active Week Partners WPOS' datatype='integer' name='[Q Active Partners WPOS (copia)_258394067086401538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [device_id] != &quot;&quot; AND [active_weeks] = 5 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Q Active Partners WPOS' datatype='integer' name='[Q Partners WPOS (copia)_258394067084873729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [device_id] != &quot;&quot; AND [active_partner] = 1 THEN 1 ELSE 0 END' />
      </column>
