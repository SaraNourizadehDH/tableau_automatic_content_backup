            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[q_partners]' role='measure' type='quantitative' />
            <column-instance column='[Dif PP (copia)_2159194607661400070]' derivation='User' name='[usr:Dif PP (copia)_2159194607661400070:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Full Price Penet (copia)_2159194607655624709]' derivation='User' name='[usr:Full Price Penet (copia)_2159194607655624709:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
