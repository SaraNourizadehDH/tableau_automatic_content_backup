            <column caption='Date' datatype='date' name='[Calculation_1186417073441472515]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [last_first_day_online] &gt;= [first_date_online] THEN [last_first_day_online] ELSE [first_date_online] END' />
            </column>
            <column caption='target_prce_suf_fixed' datatype='integer' name='[Calculation_2159194607652909059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Country] = &apos;Argentina&apos; THEN 3550&#13;&#10;ELSEIF  [Country] = &apos;Bolivia&apos; THEN 165&#13;&#10;ELSEIF  [Country] = &apos;Chile&apos; THEN 63000&#13;&#10;ELSEIF  [Country] = &apos;Costa Rica&apos; THEN 39214&#13;&#10;ELSEIF  [Country] = &apos;Ecuador&apos; THEN 68&#13;&#10;ELSEIF  [Country] = &apos;El Salvador&apos; THEN 68&#13;&#10;ELSEIF  [Country] = &apos;Guatemala&apos; THEN 304&#13;&#10;ELSEIF  [Country] = &apos;Honduras&apos; THEN 1603&#13;&#10;ELSEIF  [Country] = &apos;Nicaragua&apos; THEN 875&#13;&#10;ELSEIF  [Country] = &apos;Panamá&apos; THEN 85&#13;&#10;ELSEIF  [Country] = &apos;Paraguay&apos; THEN 150000&#13;&#10;ELSEIF  [Country] = &apos;Perú&apos; THEN 220&#13;&#10;ELSEIF  [Country] = &apos;Rep. Dominicana&apos; THEN 1410&#13;&#10;ELSEIF  [Country] = &apos;Uruguay&apos; THEN 1035&#13;&#10;ELSEIF  [Country] = &apos;Venezuela&apos; THEN 62&#13;&#10;ELSE 1410 END' />
            </column>
            <column caption='Target Full Penet New Partners' datatype='integer' name='[Calculation_601793553893109760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;República Dominicana&quot;' value='Rep. Dominicana' />
              </aliases>
            </column>
            <column caption='diff_pp_fixed' datatype='real' default-format='p0%' name='[Dif PP (copia)_2159194607661400070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Full Price Penet (copia)_2159194607655624709]-[Calculation_601793553893109760]' />
            </column>
            <column caption='full_price_fixed' datatype='integer' name='[Full Price (copia)_2159194607655460868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [SUF_price_actual_lc] &gt;= [Calculation_2159194607652909059] THEN 1 ELSE 0 END' />
            </column>
            <column caption='full_price_penet_fixed' datatype='real' default-format='p0%' name='[Full Price Penet (copia)_2159194607655624709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Full Price (copia)_2159194607655460868]) / sum([q_partners])' />
            </column>
