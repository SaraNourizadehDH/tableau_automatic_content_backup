            </column>
            <column caption='Online Partnersv2' datatype='integer' name='[Calculation_244883270336245761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date_id] = [Calculation_244883270337425410] THEN [q_partners_online] ELSE 0 END)' />
            </column>
