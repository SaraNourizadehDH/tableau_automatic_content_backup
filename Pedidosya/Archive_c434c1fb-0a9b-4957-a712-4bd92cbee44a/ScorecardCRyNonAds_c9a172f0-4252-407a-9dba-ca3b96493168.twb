    <worksheet name='POS_R_Q_TotOnl'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Partners Evolution&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='POS_Revenue' name='federated.1ufdu1q0n919wm1ejwvm81a4e4zn' />
          </datasources>
          <datasource-dependencies datasource='federated.1ufdu1q0n919wm1ejwvm81a4e4zn'>
            <column caption='% Partners W/POS' datatype='real' name='[Calculation_1343198626959040512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1343198627060453381])/SUM([q_partners_online])' />
            </column>
            <column caption='Fee Penetration (%)' datatype='real' name='[Calculation_1343198626965614594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [device_id] != &quot;&quot; THEN(IF [Tot_POS_Actual_LC] &gt; 0 THEN 1 ELSE 0 END) ELSE 0 END) / sum([Calculation_1343198627060453381])' />
            </column>
            <column caption='Tot. Revenue' datatype='real' name='[Calculation_1343198626985365507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([POS_price_actual_lc]) / MAX(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date_id])))))) * 7' />
            </column>
            <column caption='Q Partners WPOS' datatype='integer' name='[Calculation_1343198627060453381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [device_id] != &quot;&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Avg. Price' datatype='real' name='[Calculation_1343198627063332870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([POS_price_actual_lc]) / SUM([Calculation_1343198627060453381])' />
            </column>
            <column caption='Online Partnersv2' datatype='integer' name='[Calculation_244883270336245761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date_id] = [Calculation_244883270337425410] THEN [q_partners_online] ELSE 0 END)' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_244883270337425410]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, date_id):MAX([date_id])}' />
            </column>
            <column caption='Tot. Revenue EU' datatype='real' name='[Calculation_89509083594444802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Tot_POS_Actual_EU]) / MAX(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date_id])))))) * 7' />
            </column>
            <column datatype='string' name='[Key_Account_Sub_Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[POS_price_actual_lc]' role='measure' type='quantitative' />
            <column datatype='real' name='[Tot_POS_Actual_EU]' role='measure' type='quantitative' />
