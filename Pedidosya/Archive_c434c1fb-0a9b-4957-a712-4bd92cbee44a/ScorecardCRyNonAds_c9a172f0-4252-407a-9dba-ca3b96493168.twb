              <calculation class='tableau' formula='IF [country_name] = &apos;PanamÃ¡&apos;THEN &apos;Panamá&apos;&#13;&#10;ELSEIF [country_name] = &apos;PerÃº&apos; THEN &apos;Perú&apos;&#13;&#10;ELSEIF [country_name]=&apos;RepÃºblica Dominicana&apos; THEN &apos;Rep. Dominicana&apos;&#13;&#10;ELSE [country_name] END' />
