              <calculation class='tableau' formula='IF [País]=&apos; Dominican Republic&apos; THEN &apos;Rep. Dominicana&apos;&#13;&#10;ELSEIF [País]=&apos; Argentina&apos; THEN &apos;Argentina&apos;&#13;&#10;ELSEIF [País]=&apos; Bolivia&apos; THEN &apos;Bolivia&apos;&#13;&#10;ELSEIF [País]=&apos; Chile&apos; THEN &apos;Chile&apos;&#13;&#10;ELSEIF [País]=&apos; Costa Rica&apos; THEN &apos;Costa Rica&apos;&#13;&#10;ELSEIF [País]=&apos; Ecuador&apos; THEN &apos;Ecuador&apos;&#13;&#10;ELSEIF [País]=&apos; El Salvador&apos; THEN &apos;El Salvador&apos;&#13;&#10;ELSEIF [País]=&apos; Guatemala&apos; THEN &apos;Guatemala&apos;&#13;&#10;ELSEIF [País]=&apos; Honduras&apos; THEN &apos;Honduras&apos;&#13;&#10;ELSEIF [País]=&apos; Nicaragua&apos; THEN &apos;Nicaragua&apos;&#13;&#10;ELSEIF [País]=&apos; Panama&apos; THEN &apos;Panamá&apos;&#13;&#10;ELSEIF [País]=&apos; Paraguay&apos; THEN &apos;Paraguay&apos;&#13;&#10;ELSEIF [País]=&apos; Peru&apos; THEN &apos;Perú&apos;&#13;&#10;ELSEIF [País]=&apos; Uruguay&apos; THEN &apos;Uruguay&apos;&#13;&#10;ELSEIF [País]=&apos; Venezuela&apos; THEN &apos;Venezuela&apos;&#13;&#10;ELSE [País] END' />
