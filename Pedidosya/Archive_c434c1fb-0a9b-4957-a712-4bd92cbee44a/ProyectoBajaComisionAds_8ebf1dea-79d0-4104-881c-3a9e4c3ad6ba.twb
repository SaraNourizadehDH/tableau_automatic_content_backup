        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1e77y3a1qc9ty51ah4jaa0dms0b1' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    (FORMAT_DATE('%F', DATE_TRUNC(sessions.partition_date , WEEK(MONDAY)))) AS sessions_session_date_week,
    fact_orders.restaurant.id AS fact_orders_restaurant_id,
    CASE WHEN COUNT(fact_transaction_origin_and_mrr.position_rank ) <<= 10000 THEN (ARRAY_AGG(fact_transaction_origin_and_mrr.position_rank  IGNORE NULLS ORDER BY fact_transaction_origin_and_mrr.position_rank  LIMIT 10000)[OFFSET(CAST(FLOOR(COUNT(fact_transaction_origin_and_mrr.position_rank ) * 0.5 - 0.0000001) AS INT64))] + ARRAY_AGG(fact_transaction_origin_and_mrr.position_rank  IGNORE NULLS ORDER BY fact_transaction_origin_and_mrr.position_rank  LIMIT 10000)[OFFSET(CAST(FLOOR(COUNT(fact_transaction_origin_and_mrr.position_rank ) * 0.5) AS INT64))]) / 2 ELSE APPROX_QUANTILES(fact_transaction_origin_and_mrr.position_rank ,1000)[OFFSET(500)] END AS fact_transaction_origin_and_mrr_med_position_rank
FROM `peya-bi-tools-pro.il_sessions.fact_ga_sessions`
     AS sessions
LEFT JOIN UNNEST(sessions.transactions) as fact_ga_sessions__transactions
LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders`  AS fact_orders ON fact_orders.order_id= safe_cast(fact_ga_sessions__transactions.transaction_id as int64)
      and fact_orders.registered_date >>= date_sub(DATE('2023-04-03'), interval 1 day)
      and fact_orders.registered_date <<= date_add(DATE('2023-09-04'), interval 1 day)
LEFT JOIN `peya-bi-tools-pro.il_sessions.fact_transaction_origin_and_mrr`
     AS fact_transaction_origin_and_mrr ON -- sessions.partition_date = fact_transaction_origin_and_mrr.date
            -- and sessions.platform_peya = fact_transaction_origin_and_mrr.platform
            -- and sessions.fullvisitor_id = fact_transaction_origin_and_mrr.fullVisitorId
            -- and sessions.visit_id = fact_transaction_origin_and_mrr.visitId
            sessions.session_sk = fact_transaction_origin_and_mrr.session_sk
            and fact_orders.order_id = fact_transaction_origin_and_mrr.transactionId
            and fact_orders.restaurant.id = fact_transaction_origin_and_mrr.shop_id
            and fact_transaction_origin_and_mrr.date >>= date(TIMESTAMP_TRUNC(DATE('2023-04-03'), DAY))
            and fact_transaction_origin_and_mrr.date << date(TIMESTAMP_TRUNC(DATE('2023-09-04'), DAY))
WHERE ((( sessions.partition_date  ) >>= (DATE('2023-04-03')) AND ( sessions.partition_date  ) << (DATE('2023-09-04')))) 
AND fact_orders.restaurant.id IN(
222753,
176410,
