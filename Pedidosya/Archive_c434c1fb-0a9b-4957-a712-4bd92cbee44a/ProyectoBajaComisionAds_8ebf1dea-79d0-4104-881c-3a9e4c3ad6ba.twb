      </column>
      <column caption='Diferencia Comisiones' datatype='real' name='[Calculation_1389641998842613762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Comision_Previa])-AVG([Comision_Posterior]))*100' />
      </column>
      <column caption='Mes en Fecha' datatype='date' name='[Calculation_1389641998845140995]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([date_lookup_date_month]+&quot;-01&quot;)' />
      </column>
      <column caption='Ultimo Día del Mes' datatype='integer' name='[Calculation_1389641998846230533]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DAY(DATEADD(&quot;day&quot;,-1,DATEADD(&quot;month&quot;,1,DATETRUNC(&quot;month&quot;,MAX([Calculation_1389641998845140995])))))' />
      </column>
      <column caption='Ayer' datatype='date' name='[Calculation_1389641998846656519]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-1' />
      </column>
      <column caption='MoM Ordenes' datatype='real' name='[Calculation_1389641998851907594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Com Revenue RR (copia)_1389641998848974856])) - LOOKUP(ZN(SUM([Com Revenue RR (copia)_1389641998848974856])), -1)) / ABS(LOOKUP(ZN(SUM([Com Revenue RR (copia)_1389641998848974856])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Budget' datatype='integer' datatype-customized='true' name='[Calculation_1389641999151411211]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(REPLACE(&#13;&#10;REPLACE([Budget_CPC],&quot;.&quot;,&quot;&quot;)&#13;&#10;,&quot;$&quot;,&quot;&quot;&#13;&#10;))' />
      </column>
      <column caption='Budget Esperado' datatype='integer' name='[Calculation_1389641999968239630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1389641999151411211])' />
      </column>
      <column caption='% CpC Consumido' datatype='real' name='[Calculation_1389641999968772111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fact_billing_products_cpc_cpc_price_total])/sum([Budget_Total_CpC])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_1389641999970066448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fact_billing_products_cpc_cpc_price_total])+SUM([Calculation_1389641998816169984])' />
      </column>
      <column caption='Confirmed Orders RR' datatype='real' name='[Com Revenue RR (copia)_1389641998848974856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MONTH(TODAY()) = MONTH([Calculation_1389641998845140995])&#13;&#10;AND YEAR(TODAY()) = YEAR([Calculation_1389641998845140995])&#13;&#10; THEN&#13;&#10;[Ordenes_Confirmadas]&#13;&#10;/(DAY(TODAY())-1)*&#13;&#10;{ FIXED MONTH([Calculation_1389641998845140995]):&#13;&#10;([Calculation_1389641998846230533]) }&#13;&#10;&#13;&#10;ELSE &#13;&#10;[Ordenes_Confirmadas] END' />
      </column>
      <column caption='Com Revenue' datatype='real' name='[Com_Revenue]' role='measure' type='quantitative' />
      <column caption='Comision Posterior' datatype='real' name='[Comision_Posterior]' role='measure' type='quantitative' />
      <column caption='Comision Previa' datatype='real' name='[Comision_Previa]' role='measure' type='quantitative' />
      <column caption='Sesiones RR' datatype='real' name='[Confirmed Orders RR (copia)_1389641998849167369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MONTH(TODAY()) = MONTH([Calculation_1389641998845140995])&#13;&#10;AND YEAR(TODAY()) = YEAR([Calculation_1389641998845140995])&#13;&#10; THEN&#13;&#10;[Sesiones]&#13;&#10;/(DAY(TODAY())-1)*&#13;&#10;{ FIXED MONTH([Calculation_1389641998845140995]):&#13;&#10;([Calculation_1389641998846230533]) }&#13;&#10;&#13;&#10;ELSE &#13;&#10;[Sesiones] END' />
      </column>
      <column caption='Confirmed GMV' datatype='real' name='[Confirmed_GMV]' role='measure' type='quantitative' />
      <column caption='MoM Total Revenue' datatype='real' name='[MoM Ordenes (copia)_1389641999970263057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_1389641999970066448]) - LOOKUP(ZN([Calculation_1389641999970066448]), -1)) / ABS(LOOKUP(ZN([Calculation_1389641999970066448]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
