        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0j9boek0qk8iar12s2qc61b8j8bg' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    dim_partner.partner_id  AS dim_partner_partner_id,
        (FORMAT_DATE('%Y-%m', date_lookup.date )) AS date_lookup_date_month,
        CASE WHEN ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (agg_fact_partner_times.times *1.0/60.0 ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) = 0 THEN 0 ELSE ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (CASE WHEN agg_fact_partner_times.state = 'OPEN' then agg_fact_partner_times.times end *1.0/60.0 ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) / ROUND(COALESCE(CAST( ( SUM(DISTINCT (CAST(ROUND(COALESCE( (agg_fact_partner_times.times *1.0/60.0 ) ,0)*(1/1000*1.0), 9) AS NUMERIC) + (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001 )) - SUM(DISTINCT (cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 1, 15)) as int64) as numeric) * 4294967296 + cast(cast(concat('0x', substr(to_hex(md5(CAST( (TO_HEX (SHA256(concat(agg_fact_partner_times.date_id, '-',
                                agg_fact_partner_times.partner_id, '-',
                                agg_fact_partner_times.partner_time_hour, '-',
                                agg_fact_partner_times.state, '-',
                                agg_fact_partner_times.times)) ) )  AS STRING))), 16, 8)) as int64) as numeric)) * 0.000000001) )  / (1/1000*1.0) AS FLOAT64), 0), 6) END AS agg_fact_partner_times_actual_open_time_rate
FROM `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country`  AS dim_country ON dim_partner.country_id = dim_country.country_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_date`
     AS date_lookup ON date_lookup.date <<= CURRENT_DATE()
LEFT JOIN `peya-bi-tools-pro.il_core.dim_historical_partners`
     AS dim_historical_partners ON dim_historical_partners.restaurant_id = dim_partner.partner_id and
      (DATE(dim_historical_partners.full_date )) = date_lookup.date
LEFT JOIN `peya-bi-tools-pro.il_core.agg_fact_partner_times`
     AS agg_fact_partner_times ON dim_partner.partner_id = agg_fact_partner_times.partner_id
      and (DATE(dim_historical_partners.full_date )) = agg_fact_partner_times.partner_time_date
      and agg_fact_partner_times.partner_time_date >>= (DATE('2023-04-01'))
      and agg_fact_partner_times.partner_time_date <<= coalesce((DATE('2023-08-01')), current_date())
WHERE (dim_partner.partner_id ) IN (60846, 65790, 66053, 66648, 67453, 98953, 106448, 113442, 116833, 119130, 120336, 123243, 130950, 135646, 137715, 138023, 138072, 139798, 156702, 157746, 159274, 161677, 163107, 163114, 165383, 167314, 169766, 172768, 176410, 176693, 177559, 186272, 186576, 191374, 197852, 203244, 204251, 205182, 209888, 220363, 220516, 222753, 223857, 226855, 227357, 229413, 229581, 236620, 237222, 244433, 252079, 255981, 256876, 257454, 261452, 261746, 267397, 282308, 282490, 286935, 290250, 294969, 297305, 302367, 309179, 312763, 319557, 321401, 324531, 331461, 331528, 332698, 333916, 339988, 342360, 346265, 348699, 353832, 354129, 363906, 390340, 394650, 401780) AND (dim_country.active ) AND ((( date_lookup.date  ) >>= (DATE('2023-04-01')) AND ( date_lookup.date  ) << (DATE('2023-08-01')))) AND (dim_partner.country_id ) = 2 AND ((dim_partner.partner_id ) >> 0 OR (dim_partner.partner_id ) IS NULL)
GROUP BY
    1,
    2
ORDER BY
    2 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
