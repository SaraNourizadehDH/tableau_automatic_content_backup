      <table>
        <view>
          <datasources>
            <datasource caption='Proyecto Baja Comision' name='federated.1js6tq21h8k1ee1co54ja1odf3ld' />
          </datasources>
          <datasource-dependencies datasource='federated.1js6tq21h8k1ee1co54ja1odf3ld'>
            <column caption='Cvr3' datatype='real' name='[CVR3]' role='measure' type='quantitative' />
            <column caption='Com Revenue RR' datatype='real' name='[Calculation_1389641998816169984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH(TODAY()) = MONTH([Calculation_1389641998845140995])&#13;&#10;AND YEAR(TODAY()) = YEAR([Calculation_1389641998845140995])&#13;&#10; THEN&#13;&#10;[Com_Revenue]&#13;&#10;/(DAY(TODAY())-1)*&#13;&#10;{ FIXED MONTH([Calculation_1389641998845140995]):&#13;&#10;([Calculation_1389641998846230533]) }&#13;&#10;&#13;&#10;ELSE [Com_Revenue] END' />
            </column>
            <column caption='Mes en Fecha' datatype='date' name='[Calculation_1389641998845140995]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([date_lookup_date_month]+&quot;-01&quot;)' />
            </column>
            <column caption='Ultimo Día del Mes' datatype='integer' name='[Calculation_1389641998846230533]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DAY(DATEADD(&quot;day&quot;,-1,DATEADD(&quot;month&quot;,1,DATETRUNC(&quot;month&quot;,MAX([Calculation_1389641998845140995])))))' />
            </column>
            <column caption='MoM Ordenes' datatype='real' name='[Calculation_1389641998851907594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Com Revenue RR (copia)_1389641998848974856])) - LOOKUP(ZN(SUM([Com Revenue RR (copia)_1389641998848974856])), -1)) / ABS(LOOKUP(ZN(SUM([Com Revenue RR (copia)_1389641998848974856])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Confirmed Orders RR' datatype='real' name='[Com Revenue RR (copia)_1389641998848974856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH(TODAY()) = MONTH([Calculation_1389641998845140995])&#13;&#10;AND YEAR(TODAY()) = YEAR([Calculation_1389641998845140995])&#13;&#10; THEN&#13;&#10;[Ordenes_Confirmadas]&#13;&#10;/(DAY(TODAY())-1)*&#13;&#10;{ FIXED MONTH([Calculation_1389641998845140995]):&#13;&#10;([Calculation_1389641998846230533]) }&#13;&#10;&#13;&#10;ELSE &#13;&#10;[Ordenes_Confirmadas] END' />
            </column>
            <column caption='Com Revenue' datatype='real' name='[Com_Revenue]' role='measure' type='quantitative' />
            <column caption='Sesiones RR' datatype='real' name='[Confirmed Orders RR (copia)_1389641998849167369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH(TODAY()) = MONTH([Calculation_1389641998845140995])&#13;&#10;AND YEAR(TODAY()) = YEAR([Calculation_1389641998845140995])&#13;&#10; THEN&#13;&#10;[Sesiones]&#13;&#10;/(DAY(TODAY())-1)*&#13;&#10;{ FIXED MONTH([Calculation_1389641998845140995]):&#13;&#10;([Calculation_1389641998846230533]) }&#13;&#10;&#13;&#10;ELSE &#13;&#10;[Sesiones] END' />
            </column>
