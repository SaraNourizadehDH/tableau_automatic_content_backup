            <datasource caption='Query_tableau_Traspasos_CL (automated_tables_reports)' name='federated.04txbw10wvzi2b14w8g5q070s3sg' />
          </datasources>
          <datasource-dependencies datasource='federated.04txbw10wvzi2b14w8g5q070s3sg'>
            <column caption='N Partner' datatype='integer' name='[Calculation_220394958128046080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([dim_partner_partner_id])' />
            </column>
            <column caption='Equipo Sales' datatype='string' name='[Calculation_631348426680320010]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Usar IF en lugar de CASE&#13;&#10;IF [OldValue] IN (&quot;Javiera Mora&quot;, &quot;Ruben Quintero&quot;, &quot;Estefanía Ignacia González&quot;) THEN &quot;Business Developer&quot;&#13;&#10;ELSEIF [OldValue] IN (&quot;Tatiana Godoy&quot;, &quot;Diego Cruz&quot;, &quot;Pablo Olmedo&quot;, &quot;Michelle Granado&quot;, &quot;Jaqueline Vera&quot;, &quot;Daniel Antonio Mery&quot;) THEN &quot;Onboarding Incubation&quot;&#13;&#10;ELSEIF [OldValue] in (&quot;Bernardita Marín&quot;,&quot;Francys Molina&quot;,&quot;Olga Araujo&quot;,&quot;Reinier Landkoer&quot;,&quot;Rodrigo Ibacache&quot;,&quot;Sobe Gatica Mella&quot;) then &quot;SSU&quot;&#13;&#10;ELSEIF [OldValue] IN (&quot;Felipe Aravena&quot;,&quot;Joaquin Camus&quot;,&quot;Joaquín Encina&quot;,&quot;Juan Sebastian Pinto&quot;,&quot;Monserrat Dorregaray&quot;,&quot;Oscar Zapata&quot;,&quot;Ramiro Vera&quot;,&quot;Patricio Aguilera&quot;,&quot;Catalina Daniela Bozo Salgado&quot;) THEN &quot;Terreno&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
            </column>
            <column caption='Equipo AM' datatype='string' name='[Equipo]' role='dimension' type='nominal' />
            <column caption='Mes Cohort' datatype='string' name='[Fecha Traspaso Month (copia)_1319273267061104640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&#13;&#10;    DATEDIFF(&#13;&#10;        &apos;month&apos;, &#13;&#10;        DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyy-MM&apos;, [fecha_traspaso_month])), &#13;&#10;        DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyy-MM&apos;,[date_lookup_date_month]))&#13;&#10;    )&#13;&#10;)' />
            </column>
            <column caption='Mes de traspaso' datatype='datetime' name='[Fecha Traspaso Month (copia)_1319273267061792769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPARSE(&apos;YYYY-MM&apos;,[fecha_traspaso_month])' />
            </column>
            <column caption='New Value' datatype='string' name='[NewValue]' role='dimension' type='nominal' />
            <column caption='Ejecutivos Sales' datatype='string' name='[OldValue]' role='dimension' type='nominal' />
            <column caption='Traspasos Pato' datatype='string' name='[Tipo Traspaso (copia)_220394959207002117]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [OldValue] = &quot;Patricio Aguilera&quot; and [NewValue] = &quot;Constanza Belen Fuentes&quot; or [NewValue] = &quot;Cristian Ignacio Barba&quot; or [NewValue] = &quot;Cristian Villagrán&quot; &#13;&#10;and [fecha_traspaso_month] = &quot;2024-05&quot;&#13;&#10;then &quot;Traspaso Swat&quot;&#13;&#10;ELSE &quot;Traspaso Sales&quot;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Traspaso Yuse LT' datatype='string' name='[Traspasos Pato (copia)_2584714354053693446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [OldValue] = &quot;Yusette Moraga&quot; AND &#10;   ([NewValue] = &quot;Fernanda Fuentes&quot; OR &#10;    [NewValue] = &quot;Shirley Blas&quot; OR &#10;    [NewValue] = &quot;Catalina Altamirano&quot;)&#10;    and [fecha_traspaso_month] = &quot;2024-09&quot;&#10;THEN &quot;Traspaso Swat&quot;&#10;ELSE &quot;Traspaso Sales&quot;&#10;END' />
            </column>
            <column datatype='string' name='[account_source]' role='dimension' type='nominal' />
            <column-instance column='[fact_orders_percentage_commercial_fail_rate]' derivation='Avg' name='[avg:fact_orders_percentage_commercial_fail_rate:qk]' pivot='key' type='quantitative' />
            <column caption='Date Lookup Date Month' datatype='string' name='[date_lookup_date_month]' role='dimension' type='nominal' />
            <column caption='Ciudad' datatype='string' name='[dim_partner__city_city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Actual Owner' datatype='string' name='[dim_partner_account_owner]' role='dimension' type='nominal' />
            <column caption='Dim Partner Partner Id' datatype='integer' name='[dim_partner_partner_id]' role='dimension' type='ordinal' />
            <column caption='GRID' datatype='string' name='[dim_partner_salesforce_id]' role='dimension' type='nominal' />
            <column caption='Fact Orders Percentage Commercial Fail Rate' datatype='real' name='[fact_orders_percentage_commercial_fail_rate]' role='measure' type='quantitative' />
            <column caption='Fecha Traspaso Month' datatype='string' name='[fecha_traspaso_month]' role='dimension' type='nominal' />
            <column-instance column='[Fecha Traspaso Month (copia)_1319273267061792769]' derivation='Month' name='[mn:Fecha Traspaso Month (copia)_1319273267061792769:ok]' pivot='key' type='ordinal' />
