            <column-instance column='[Calculation_631348426680320010]' derivation='None' name='[none:Calculation_631348426680320010:nk]' pivot='key' type='nominal' />
            <column-instance column='[Equipo]' derivation='None' name='[none:Equipo:nk]' pivot='key' type='nominal' />
            <column-instance column='[Fecha Traspaso Month (copia)_1319273267061104640]' derivation='None' name='[none:Fecha Traspaso Month (copia)_1319273267061104640:nk]' pivot='key' type='nominal' />
            <column-instance column='[OldValue]' derivation='None' name='[none:OldValue:nk]' pivot='key' type='nominal' />
            <column-instance column='[Tipo Traspaso (copia)_220394959207002117]' derivation='None' name='[none:Tipo Traspaso (copia)_220394959207002117:nk]' pivot='key' type='nominal' />
            <column-instance column='[Traspasos Pato (copia)_2584714354053693446]' derivation='None' name='[none:Traspasos Pato (copia)_2584714354053693446:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_source]' derivation='None' name='[none:account_source:nk]' pivot='key' type='nominal' />
            <column-instance column='[dim_partner__city_city_name]' derivation='None' name='[none:dim_partner__city_city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[dim_partner_account_owner]' derivation='None' name='[none:dim_partner_account_owner:nk]' pivot='key' type='nominal' />
