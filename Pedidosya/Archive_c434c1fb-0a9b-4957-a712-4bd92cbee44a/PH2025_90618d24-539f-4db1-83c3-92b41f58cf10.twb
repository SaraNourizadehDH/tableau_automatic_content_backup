            <connection CATALOG='peya-peru' EXECCATALOG='peya-peru' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-peru' schema='automated_tables_reports' server-oauth='' username='willy.vasquez@pedidosya.com' workgroup-auth-mode='prompt' />
