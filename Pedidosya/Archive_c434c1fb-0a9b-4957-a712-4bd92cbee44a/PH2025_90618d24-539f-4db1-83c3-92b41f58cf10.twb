        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.011i2761nrrf4k1g457050egtsfn' name='Consulta SQL personalizada' type='text'><![CDATA[WITH top_products AS (
  SELECT
    a.registered_date,
    a.restaurant.id AS restaurant_id,
    ad.product_name,
    ad.product.price,
    SUM(CASE WHEN a.order_status = "CONFIRMED" THEN 1 ELSE 0 END) AS qty
  FROM `peya-bi-tools-pro.il_core.fact_orders` a,
  UNNEST(a.details) AS ad
  WHERE DATE_TRUNC(a.registered_date, MONTH) >>= "2023-01-01"
  GROUP BY 1, 2, 3, 4
),
ranked_products AS (
  SELECT
    registered_date,
    restaurant_id,
    product_name,
    price,
    qty,
    ROW_NUMBER() OVER (PARTITION BY registered_date, restaurant_id ORDER BY qty DESC) AS rn
  FROM top_products
  WHERE qty >> 0  -- Solo productos con ventas confirmadas
),
main_query AS (
  SELECT
    a.registered_date,
    FORMAT_DATE('%A', a.registered_date) AS week_day,
    a.partner_id,
    a.partner_name,
    COALESCE(a.manager,"No data") AS manager,
    COALESCE(a.team_leader,"No data") AS team_leader,
    COALESCE(a.account_owner,"No data") AS account_owner,
    COALESCE(a.brand, "No data") AS brand,
    COALESCE(a.main_cousine, "No data") AS main_cousine,
    b.schedule_day,
    b.open_from_hour,
    b.open_to_hour,
    SUM(a.ordenes_confirmadas) AS confirmed_orders,
    SUM(a.ordenes_totales) AS total_orders,
    SUM(a.ordenes_rechazadas_totales) AS cancel_orders,
    SUM(a.open_time) AS open_time,
    SUM(a.schedule_times) AS schedule_time,
    SAFE_DIVIDE(SUM(a.open_time), SUM(a.schedule_times)) AS open_rate,
    SUM(a.open_time) AS real_hours
  FROM `peya-peru.automated_tables_reports.vigia_commercial_foods_pe` a
  LEFT JOIN (
    SELECT 
      partner_id,
      schedule_day,
      open_from_hour,
      open_to_hour
    FROM `peya-bi-tools-pro.il_core.dim_partner_schedule`
  ) b 
  ON a.partner_id = b.partner_id
  AND LOWER(
    CASE FORMAT_DATE('%A', a.registered_date)
      WHEN 'Monday' THEN 'lunes'
      WHEN 'Tuesday' THEN 'martes'
      WHEN 'Wednesday' THEN 'miercoles'
      WHEN 'Thursday' THEN 'jueves'
      WHEN 'Friday' THEN 'viernes'
      WHEN 'Saturday' THEN 'sabado'
      WHEN 'Sunday' THEN 'domingo'
    END
  ) = LOWER(b.schedule_day)  -- Normalizamos a minúsculas para asegurar coincidencias
  WHERE 
    DATE_TRUNC(a.registered_date, MONTH) >>= "2023-01-01"
    AND a.city = "Punta Hermosa"
  GROUP BY 
    a.registered_date, b.schedule_day, a.partner_id, a.partner_name, 
    a.brand, a.main_cousine, b.open_from_hour, b.open_to_hour, a.manager, a.team_leader, a.account_owner
)

SELECT
    main_query.registered_date,
    main_query.week_day,
    main_query.partner_id,
    main_query.partner_name,
    main_query.manager,
    main_query.team_leader,
    main_query.account_owner,
    main_query.brand,
    main_query.main_cousine,
    -- Mostrar open_from_hour y open_to_hour solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.open_from_hour ELSE NULL END AS open_from_hour,
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.open_to_hour ELSE NULL END AS open_to_hour,
    -- Mostrar confirmed_orders solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.confirmed_orders ELSE NULL END AS confirmed_orders,
    -- Mostrar total_orders solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.total_orders ELSE NULL END AS total_orders,
    -- Mostrar cancel_orders solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.cancel_orders ELSE NULL END AS cancel_orders,
    -- Mostrar open_time solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.open_time ELSE NULL END AS open_time,
    -- Mostrar schedule_time solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.schedule_time ELSE NULL END AS schedule_time,
    -- Mostrar open_rate solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.open_rate ELSE NULL END AS open_rate,
    -- Mostrar real_hours solo en la primera fila
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main_query.registered_date, main_query.partner_id ORDER BY main_query.registered_date) = 1 
      THEN main_query.real_hours ELSE NULL END AS real_hours,
    -- Información de los productos top en filas separadas, usando "Zombie" si no hay product_name
    COALESCE(rp.product_name, "Zombie") AS top_product_name,
    rp.price AS top_product_price,
    rp.qty AS top_product_qty,
    rp.rn AS product_rank  -- Indicamos si es el producto 1, 2 o 3
FROM main_query
LEFT JOIN ranked_products rp  -- Unimos con los productos clasificados
  ON main_query.registered_date = rp.registered_date 
  AND main_query.partner_id = rp.restaurant_id
  AND rp.rn <<= 3  -- Solo obtenemos los productos del top 3
ORDER BY main_query.registered_date, main_query.partner_id, rp.rn]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
