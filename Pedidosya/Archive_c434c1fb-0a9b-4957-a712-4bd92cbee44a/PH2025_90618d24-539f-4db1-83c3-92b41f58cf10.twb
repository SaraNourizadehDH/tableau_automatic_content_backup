      <aliases enabled='yes' />
      <column caption='Open Rate' datatype='real' name='[Calculation_323696289917423616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([open_time])/SUM([schedule_time])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_323696289918197761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &quot;Partner ID&quot; THEN STR([partner_id])&#13;&#10;WHEN &quot;Partner Name&quot; THEN [partner_name]&#13;&#10;WHEN &quot;Brand&quot; THEN [brand]&#13;&#10;WHEN &quot;Main Cousine&quot; THEN [main_cousine]&#13;&#10;ELSE &quot;Otros Valores Nulos&quot;&#13;&#10;END' />
      </column>
      <column caption='Metric Time' datatype='string' name='[Calculation_323696289919823874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#13;&#10;    WHEN &quot;Date&quot; THEN STR(DATE([registered_date]))  // Formato: yyyy-mm-dd&#13;&#10;    WHEN &quot;Week&quot; THEN STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot; - W&quot; + RIGHT(&quot;00&quot; + STR(DATEPART(&apos;week&apos;, [registered_date])), 2)  // Formato: YYYY - W01&#13;&#10;    WHEN &quot;Month&quot; THEN STR(DATEPART(&apos;year&apos;, [registered_date])) + &quot;-&quot; + RIGHT(&quot;00&quot; + STR(DATEPART(&apos;month&apos;, [registered_date])), 2)  // Formato: yyyy-mm&#13;&#10;    WHEN &quot;Quarter&quot; THEN &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [registered_date])) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [registered_date]))  // Formato: Q1-YYYY&#13;&#10;    WHEN &quot;Year&quot; THEN STR(DATEPART(&apos;year&apos;, [registered_date]))  // Formato: YYYY&#13;&#10;    ELSE STR(DATE([registered_date]))  // Formato por defecto&#13;&#10;END' />
      </column>
      <column caption='Start Hour' datatype='real' name='[Calculation_323696289921347587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([open_from_hour]))' />
      </column>
      <column caption='Closed Hour' datatype='real' name='[Calculation_323696289921433604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([open_to_hour]))' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_323696289936994309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([total_orders]),0)' />
      </column>
      <column caption='Confirmed Orders' datatype='integer' name='[Calculation_323696289937190918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([confirmed_orders]),0)' />
      </column>
      <column caption='Cancel Orders' datatype='integer' name='[Calculation_323696289937281031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([cancel_orders]),0)' />
      </column>
      <column caption='Open Rate - Cluster' datatype='string' name='[Calculation_323696289949216776]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_323696289917423616] &lt;= 0.20 THEN &quot;0 - 0.20&quot;&#13;&#10;ELSEIF [Calculation_323696289917423616] &lt;= 0.40 THEN &quot;0.20 - 0.40&quot;&#13;&#10;ELSEIF [Calculation_323696289917423616] &lt;= 0.60 THEN &quot;0.40 - 0.60&quot;&#13;&#10;ELSEIF [Calculation_323696289917423616] &lt;= 0.80 THEN &quot;0.60 - 0.80&quot;&#13;&#10;ELSE &quot;&gt; 0.80&quot;&#13;&#10;END' />
      </column>
      <column caption='Fixed OR' datatype='real' name='[Calculation_323696289951875081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partner_id]: SUM([open_time])/SUM([schedule_time]) }' />
      </column>
      <column caption='OR Cluster' datatype='string' name='[Calculation_323696289952067594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [partner_id]: AVG([Calculation_323696289951875081]) } &lt;= 0.20 THEN &quot;0% - 20%&quot;&#13;&#10;ELSEIF { FIXED [partner_id]: AVG([Calculation_323696289951875081]) } &lt;= 0.40 THEN &quot;20% - 40%&quot;&#13;&#10;ELSEIF { FIXED [partner_id]: AVG([Calculation_323696289951875081]) } &lt;= 0.60 THEN &quot;40% - 60%&quot;&#13;&#10;ELSEIF { FIXED [partner_id]: AVG([Calculation_323696289951875081]) } &lt;= 0.80 THEN &quot;60% - 80%&quot;&#13;&#10;ELSE &quot;&gt; 80%&quot;&#13;&#10;END' />
      </column>
      <column caption='Qty Partners ID' datatype='integer' name='[Calculation_323696289952608267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([partner_id])' />
      </column>
      <column caption='Closed Hour (copia)' datatype='real' name='[Closed Hour (copia)_323696289956544526]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ROUND(AVG([open_to_hour]))' />
      </column>
      <column aggregation='Sum' caption='% Partner ID' datatype='integer' name='[Partner ID (copia)_323696289955749901]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[partner_id]' />
      </column>
