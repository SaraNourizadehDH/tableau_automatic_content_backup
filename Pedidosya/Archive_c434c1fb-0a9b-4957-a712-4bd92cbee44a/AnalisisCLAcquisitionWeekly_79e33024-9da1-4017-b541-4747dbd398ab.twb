        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1k6xgyl1szpoxy13hm29k18d2jlq' name='Weekly_Acq_CL' table='[peya-chile.user_diego_sanmartin].[Weekly_Acq_CL]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1k6xgyl1szpoxy13hm29k18d2jlq' name='Weekly_Acq_CL' table='[peya-chile.user_diego_sanmartin].[Weekly_Acq_CL]' type='table' />
          <relation connection='bigquery.1k6xgyl1szpoxy13hm29k18d2jlq' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
    a.partner_id,
    a.salesforce_id,
    sf.account_type,
    count(distinct a.product_id) as campaign_products_count
  FROM(
    SELECT 
        dim_subsidized_campaign.subsidized_campaign_name,
        dim_partner_product.partner_id,
        dim_partner.account_owner,
        dim_partner.salesforce_id,
        dim_partner_product.menu_section_name,
        dim_partner_product.section_is_deleted,
        dim_partner_product.product_id,
        dim_partner_product.product_name,
        dim_partner_product.product_description,
        dim_subsidized_product.end_date,
        dim_subsidized_product.original_price,
        dim_subsidized_campaign.start_date_utc,
        dim_subsidized_campaign.end_date_utc,
        dim_subsidized_campaign.is_active 
    FROM `peya-bi-tools-pro.il_core.dim_partner` AS dim_partner                                                         
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner_product` AS dim_partner_product
      ON dim_partner.partner_id = dim_partner_product.partner_id                                                          
    LEFT JOIN `peya-bi-tools-pro.il_core.dim_subsidized_product` AS dim_subsidized_product
      ON dim_partner_product.product_id = dim_subsidized_product.product_id
    LEFT JOIN `peya-bi-tools-pro.il_growth.dim_subsidized_campaign` AS dim_subsidized_campaign
      ON dim_subsidized_product.subsidized_product_campaing_id = dim_subsidized_campaign.subsidized_campaign_id
    WHERE dim_partner.country_id= 2
    AND date(dim_subsidized_product.end_date)  >>= ((DATE_ADD(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL -2 WEEK)))
    AND dim_partner_product.enabled=TRUE 
    AND dim_subsidized_campaign.subsidized_campaign_name IS NOT NULL
  --  AND dim_subsidized_campaign.is_active
    AND dim_partner_product.unavailable IS FALSE
    AND ((UPPER(( dim_partner.partner_status  )) <<>> UPPER('CLOSED') AND UPPER(( dim_partner.partner_status  )) <<>> UPPER('DELETED') AND UPPER(( dim_partner.partner_status  )) <<>> UPPER('PENDING')
      OR ( dim_partner.partner_status  ) IS NULL))
    AND dim_partner.business_type_id IN (1,7)
 --   AND dim_partner_product.partner_id = 405928
  ) a
  left join `peya-bi-tools-pro.il_salesforce.dim_salesforce_account` as sf ON a.salesforce_id = sf.account_grid
  GROUP BY 1,2,3]]></relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
