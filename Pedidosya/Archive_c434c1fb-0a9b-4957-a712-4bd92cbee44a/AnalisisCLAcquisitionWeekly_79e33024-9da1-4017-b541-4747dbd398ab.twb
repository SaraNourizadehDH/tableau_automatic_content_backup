      <aliases enabled='yes' />
      <column caption='# Cuentas VR' datatype='integer' name='[# Partners (copia)_1056375590617223169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [account_type] = &quot;Branch - Virtual Restaurant&quot;&#13;&#10;THEN   &#13;&#10;[GRID]&#13;&#10;END)' />
      </column>
      <column caption='Tag Winback' datatype='string' name='[# Winback (copia)_1056375590623498242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Opp_Name],&quot;Win Back&quot;) THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.15ocyyr0jptzyl1e5j5xx1gq6xtn].[avg:Open_Time:qk]&quot;' value='% OT' />
          <alias key='&quot;[federated.15ocyyr0jptzyl1e5j5xx1gq6xtn].[sum:campaign_products_count:qk]&quot;' value='Productos en Campaña Actuales Activas' />
        </aliases>
      </column>
      <column caption='Grupo Sales' datatype='string' name='[Account Owner (grupo)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Account_Owner]' new-bin='true'>
          <bin default-name='false' value='&quot;Business Developer&quot;'>
            <value>&quot;Gabriel Mardones&quot;</value>
            <value>&quot;Javiera Mora&quot;</value>
            <value>&quot;Javiera Rubio&quot;</value>
            <value>&quot;Kenneth Howard&quot;</value>
            <value>&quot;Maria Bernardita Duran&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;SSU&quot;'>
