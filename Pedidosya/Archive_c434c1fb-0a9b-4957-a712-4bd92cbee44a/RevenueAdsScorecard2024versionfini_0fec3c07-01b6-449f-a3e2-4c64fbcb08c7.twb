              <calculation class='tableau' formula='sum([Ads/GMV LS])&#13;&#10;-&#13;&#10;SUM(IF ({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Budget 2024&quot;) THEN &#13;&#10;[Ads/GMV LS] ELSE 0 END)})&gt;0 THEN { FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Budget 2024&quot;) THEN &#13;&#10;[Ads/GMV LS] ELSE 0 END)} ELSE NULL END)' />
