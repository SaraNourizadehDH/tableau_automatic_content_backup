            <column caption='Score Plan 50 AM' datatype='integer' name='[Score Plan 50 Rev (copy)_888897993945821196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([% of New AM Revenue])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([% of New AM Revenue])END) THEN 5 &#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([% of New AM Revenue])END) = SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([% of New AM Revenue])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([% of New AM Revenue])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([% of New AM Revenue])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
            <column-instance column='[DATE]' derivation='Month' name='[mn:DATE:ok]' pivot='key' type='ordinal' />
            <column-instance column='[DATE]' derivation='MY' name='[my:DATE:ok]' pivot='key' type='ordinal' />
