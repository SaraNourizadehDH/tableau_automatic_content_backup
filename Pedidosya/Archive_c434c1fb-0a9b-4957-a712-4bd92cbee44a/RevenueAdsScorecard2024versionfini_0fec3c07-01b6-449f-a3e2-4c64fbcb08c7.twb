          <datasource-dependencies datasource='federated.1yl281p1anocop16a87tg0x7lbcj'>
            <column datatype='real' default-format='p0%' name='[Budget Utilization]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cpc Roas' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPC ROAS]' role='dimension' type='ordinal' />
            <column caption='Currency' datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='Vs CPC ROAS (Color)' datatype='integer' name='[Calculation_1649161951511871489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2024&quot; THEN([CPC ROAS])END)&gt;4&#13;&#10;AND  SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&lt;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2024&quot; THEN([CPC ROAS])END)&#13;&#10;AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&gt; 3.5&#13;&#10;&#13;&#10;THEN 1 &#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2024&quot; THEN([CPC ROAS])END)&lt; 3.5&#13;&#10;AND  SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&gt;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2024&quot; THEN([CPC ROAS])END)&#13;&#10;AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&lt; 4&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2024&quot; THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2024&quot; THEN([CPC ROAS])END)&lt; 4&#13;&#10;AND  SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&gt; 3.5 AND SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)&lt; 4&#13;&#10;THEN 1&#13;&#10;&#13;&#10;ELSE -1 END' />
            </column>
            <column caption='Aux Date Intervalo' datatype='boolean' name='[Calculation_594475188115542035]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[DATE]=[Parameters].[Parámetro 5]' />
            </column>
            <column caption='Vs CPC ROAS' datatype='real' default-format='p0.0%' name='[Calculation_764486097862049793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([CPC ROAS])END)-&#13;&#10;SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2024&quot; THEN([CPC ROAS])END)' />
            </column>
            <column caption='2022 Vs Budget Utilization' datatype='real' name='[Calculation_764486097992769551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE Year([DATE]) WHEN  YEAR([Parameters].[Parámetro 5])&#13;&#10;&#13;&#10;THEN([Budget Utilization])END)-&#13;&#10;&#13;&#10;SUM(CASE Year([DATE]) WHEN  YEAR([Parameters].[Parámetro 5])-1&#13;&#10;&#13;&#10;THEN([Budget Utilization])END)' />
            </column>
