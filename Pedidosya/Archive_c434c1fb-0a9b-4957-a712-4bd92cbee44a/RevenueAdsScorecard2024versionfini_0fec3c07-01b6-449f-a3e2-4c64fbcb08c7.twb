      <column caption='max_date' datatype='date' default-format='*DD/MM/YY' name='[Calculation_1214564572551389185]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(&#13;&#10;IF &#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND (([Listing_Priority]+[Commission_Revenue_Food]+[Set_Up_Fee]+[Pos_Rental]&#13;&#10;+[Commission_Revenue_Local_Stores]+[Joker])&gt;0)&#13;&#10;THEN ([DATE]) END)' />
      </column>
      <column caption='boldmax_ads_as_gmv_country_fxc' datatype='real' default-format='p0.00%' name='[Calculation_1236801081525620748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [compliance_ads_as_gmv_country_fxc (copia)_1236801081523097604] = &quot;Max&quot; Then [compliance_ads_as_gmv (copia)_224617064995151898] End'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='date_dynamic' datatype='string' name='[Calculation_1283525947915735040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;    WHEN &apos;Month&apos;    THEN [Calculation_1283525947915792385]&#13;&#10;    WHEN &apos;Quarter&apos;  THEN [date_quarter (copia)_1283525947916398596]&#13;&#10;    WHEN &apos;Semester&apos;  THEN [date_quarter_dynamic (copia)_1283525947916742661]&#13;&#10;    WHEN &apos;Year&apos; THEN [date_quarter_dynamic (copia)_1283525947916873734]&#13;&#10;END' />
      </column>
      <column caption='date_month_string_dynamic' datatype='string' name='[Calculation_1283525947915792385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,DATE),3) + &apos; &apos; + STR(DATEPART(&apos;year&apos;,[DATE]))' />
      </column>
      <column caption='ads / gmv' datatype='real' default-format='p0.00%' name='[Calculation_1446218481267433472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_409827598311694336]*1000000)/sum([GMV_including_Incentives__user_paid_amount_])' />
      </column>
      <column caption='joker / GMV' datatype='real' default-format='p0.00%' name='[Calculation_1446218481270194177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Joker]))/sum([GMV_including_Incentives__user_paid_amount_])' />
      </column>
      <column caption='listing priority / gmv' datatype='real' default-format='p0.00%' name='[Calculation_1446218481270325250]' role='measure' type='quantitative'>
