    <worksheet name='CPC'>
      <table>
        <view>
          <datasources>
            <datasource caption='Inputs (Scorecard Inputs)' name='federated.1yl281p1anocop16a87tg0x7lbcj' />
          </datasources>
          <datasource-dependencies datasource='federated.1yl281p1anocop16a87tg0x7lbcj'>
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='CountD' datatype='real' datatype-customized='true' name='[CPC]' role='measure' type='quantitative' />
            <column caption='date_LM' datatype='integer' name='[Calculation_849210016974848008]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(MAX(DATEDIFF(&apos;month&apos;,{ MAX(IF&#13;&#10;[DATA_LEVEL] = &apos;Actual&apos;&#13;&#10;AND [VP Active Food %]&gt;0&#13;&#10;THEN ([DATE]) END)},[DATE])))' />
            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' default-format='*d mmm yyyy' name='[DATE]' role='dimension' type='ordinal' />
            <column caption='Dashboard1' datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='real' default-format='p0.0%' name='[VP Active Food %]' role='measure' type='quantitative' />
            <column-instance column='[DATE]' derivation='MY' name='[my:DATE:ok]' pivot='key' type='ordinal' />
