    <worksheet name='Final Ranking'>
      <table>
        <view>
          <datasources>
            <datasource caption='Inputs (Scorecard Inputs)' name='federated.1yl281p1anocop16a87tg0x7lbcj' />
          </datasources>
          <datasource-dependencies datasource='federated.1yl281p1anocop16a87tg0x7lbcj'>
            <column aggregation='Count' datatype='real' datatype-customized='true' default-format='p0.0%' name='[% of New AM Revenue]' role='measure' type='ordinal' />
            <column datatype='real' default-format='p0%' name='[Budget Utilization]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Score Plan 50 Rev' datatype='integer' name='[Calculation_888897993942683655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([NCR EU ($M)])END) THEN 5 &#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([NCR EU ($M)])END)*0.97 THEN 4&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([NCR EU ($M)])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([NCR Neutral (BE04)])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([NCR EU ($M)])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
            <column caption='Score Plan 50 Rev Final' datatype='integer' name='[Calculation_888897993946550285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_888897993942683655]*3' />
            </column>
            <column caption='Score Plan 50 Final' datatype='integer' name='[Calculation_888897993948962831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_888897993946550285]+[Score Plan 50 Rev (copy)_888897993945821196]+[Score Plan 50 Rev (copy)_888897993944182793]+[Score Plan 50 VP (copy)_888897993944420362]+[Score Plan 50 Rev (copy)_888897993945120779]+[Score Plan 50 Rev (copy)_888897993943961608]' />
            </column>
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' default-format='*d mmm yyyy' name='[DATE]' role='dimension' type='ordinal' />
            <column caption='Dashboard1' datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column datatype='string' default-format='p0.0%' default-role='measure' default-type='ordinal' name='[Joker CVR %]' role='dimension' type='nominal' />
            <column caption='Ncr Eu ($M)' datatype='string' default-format='c&quot;€&quot;#,##0.000;(&quot;€&quot;#,##0.000)' default-role='measure' default-type='ordinal' name='[NCR EU ($M)]' role='dimension' type='nominal' />
            <column datatype='string' default-format='c&quot;€&quot;#,##0.000;(&quot;€&quot;#,##0.000)' default-role='measure' default-type='ordinal' name='[NCR Neutral (BE04)]' role='dimension' type='nominal' />
            <column caption='Score Plan 50 VP' datatype='integer' name='[Score Plan 50 Rev (copy)_888897993943961608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([VP Active Food %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([VP Active Food %])END) THEN 5&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([VP Active Food %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([VP Active Food %])END)*0.97 THEN 4&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([VP Active Food %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([VP Active Food %])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([VP Active Food %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([VP Active Food %])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
            <column caption='Score Plan 50 BU' datatype='integer' name='[Score Plan 50 Rev (copy)_888897993944182793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Budget Utilization])END) THEN 5 &#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Budget Utilization])END)*0.97 THEN 4&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Budget Utilization])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Budget Utilization])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Budget Utilization])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
            <column caption='Score Plan 50 SB' datatype='integer' name='[Score Plan 50 Rev (copy)_888897993945120779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Selfbooking Revenue Penetration])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Selfbooking Revenue Penetration])END) THEN 5&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Selfbooking Revenue Penetration])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Selfbooking Revenue Penetration])END)*0.97 THEN 4&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Selfbooking Revenue Penetration])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Selfbooking Revenue Penetration])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Selfbooking Revenue Penetration])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Selfbooking Revenue Penetration])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
            <column caption='Score Plan 50 AM' datatype='integer' name='[Score Plan 50 Rev (copy)_888897993945821196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([% of New AM Revenue])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([% of New AM Revenue])END) THEN 5 &#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([% of New AM Revenue])END) = SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([% of New AM Revenue])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([% of New AM Revenue])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([% of New AM Revenue])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
            <column caption='Score Plan 50 JCVR' datatype='integer' name='[Score Plan 50 VP (copy)_888897993944420362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Joker CVR %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Joker CVR %])END) THEN 5 &#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Joker CVR %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Plan 50&quot; THEN([Joker CVR %])END)*0.97 THEN 4&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Joker CVR %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Joker CVR %])END) THEN 3&#13;&#10;ELSEIF SUM(CASE [DATA_LEVEL] WHEN  &quot;Actual&quot; THEN([Joker CVR %])END) &gt; SUM(CASE [DATA_LEVEL] WHEN  &quot;Budget 2023&quot; THEN([Joker CVR %])END)*0.97 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
            </column>
