            <column aggregation='Count' datatype='real' datatype-customized='true' default-format='p0.0%' name='[% of New AM Revenue]' role='measure' type='ordinal' />
            <column caption='Country' datatype='string' name='[COUNTRY]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Currency' datatype='string' name='[CURRENCY]' role='dimension' type='nominal' />
            <column caption='Data Level' datatype='string' name='[DATA_LEVEL]' role='dimension' type='nominal' />
