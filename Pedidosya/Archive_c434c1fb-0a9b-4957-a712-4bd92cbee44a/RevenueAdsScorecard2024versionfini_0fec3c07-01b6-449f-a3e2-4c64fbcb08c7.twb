            <column caption='compliance_ord_food_country_fxc' datatype='real' default-format='p0.00%' name='[compliance_commrev_food_country_fxc CORREGIR (copia)_562668538172469271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM({ FIXED [CURRENCY],[DATE],[COUNTRY]: SUM ( IF ([DATA_LEVEL]=&quot;Actual&quot;) THEN &#13;&#10;[Orders_Food] ELSE 0 END)} )&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;&#13;&#10;SUM([Orders_Food])&#13;&#10;)-1' />
