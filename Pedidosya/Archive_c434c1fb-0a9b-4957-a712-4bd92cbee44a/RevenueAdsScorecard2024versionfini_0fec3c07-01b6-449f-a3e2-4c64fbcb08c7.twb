            <column caption='Dashboard1' datatype='string' name='[Dashboard]' role='dimension' type='nominal' />
            <column caption='Ncr Eu ($M)' datatype='string' default-format='c&quot;€&quot;#,##0.000;(&quot;€&quot;#,##0.000)' default-role='measure' default-type='ordinal' name='[NCR EU ($M)]' role='dimension' type='nominal' />
            <column datatype='string' default-format='c&quot;€&quot;#,##0.000;(&quot;€&quot;#,##0.000)' default-role='measure' default-type='ordinal' name='[NCR Neutral (BE04)]' role='dimension' type='nominal' />
