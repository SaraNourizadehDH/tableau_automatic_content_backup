SUM(transaction_boolean) as transactions&#13;
FROM (&#13;
    SELECT&#13;
    fullVisitorId,&#13;
    visitid,&#13;
    platform,&#13;
    date,&#13;
    origin,&#13;
    country_name,&#13;
    brand_name,&#13;
    campaign_id,&#13;
