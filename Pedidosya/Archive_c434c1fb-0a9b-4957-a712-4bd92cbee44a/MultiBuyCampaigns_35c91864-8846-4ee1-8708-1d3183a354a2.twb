        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.18sxede0frnert1g7cuk60cxbj2a'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='user_josefina_lin' server-oauth='' username='rodrigo.benitez@pedidosya.com' workgroup-auth-mode='prompt' />
