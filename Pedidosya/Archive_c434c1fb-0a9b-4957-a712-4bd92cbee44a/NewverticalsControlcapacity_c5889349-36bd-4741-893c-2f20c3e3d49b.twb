      <aliases enabled='yes' />
      <column caption='Qty orders' datatype='integer' name='[Calculation_1462262513611313152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Size ' datatype='integer' name='[Calculation_1462262513644072961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([size_bucket_final])' />
      </column>
      <column caption='% orders/ Total size' datatype='real' name='[Calculation_1462262513645793282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1462262513611313152]/[Calculation_1462262513644072961]' />
      </column>
      <column caption='Qty vendors' datatype='integer' name='[Calculation_1462262513648558083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendorId])' />
      </column>
      <column caption='Qty rejected' datatype='integer' name='[Calculation_1462262513648861188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF ([order_status]= &quot;REJECTED&quot;) THEN [order_id] ELSE NULL END)' />
      </column>
      <column caption='qty pre order' datatype='integer' name='[Calculation_1462262513649700871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([is_pre_order])' />
      </column>
      <column caption='Cálculo1' datatype='string' name='[Calculation_1462262513687785483]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_1462262513644072961]=[Calculation_1462262513611313152]) THEN &quot;Sin capacidad&quot; ELSE NULL END' />
      </column>
      <column caption='Date up to' datatype='date' name='[Calculation_1462262513960374284]' role='dimension' type='ordinal'>
