)
,   vendor_capacity AS (
    SELECT
            EXTRACT(DATE FROM _ingested_at) as ingested_date
        ,   c.vendorId
        ,   c.dayId
        ,   CASE
                WHEN c.dayId = 1 THEN "Sunday"
                WHEN c.dayId = 2 THEN "Monday"
                WHEN c.dayId = 3 THEN "Tuesday"
                WHEN c.dayId = 4 THEN "Wednesday"
                WHEN c.dayId = 5 THEN "Thursday"
                WHEN c.dayId = 6 THEN "Friday"
                WHEN c.dayId = 7 THEN "Saturday"
            END as week_day
        ,   c.duration
        ,   s.size
        ,   PARSE_TIMESTAMP("%H:%M:%S", CONCAT(s.start.hour,":",s.start.minute,":00")) as start_interval
        ,   PARSE_TIMESTAMP("%H:%M:%S", CONCAT(s.end.hour,":",s.end.minute,":00"))     as end_interval
    FROM `peya-data-origins-pro.cl_groceries.vendor_capacity` c
    , UNNEST(shifts) s
    )
, buckets AS (
    SELECT
            vc.ingested_date
        ,   vc.RANK
        ,   vc.vendorId
        ,   vc.dayId
        ,   vc.week_day
        ,   vc.duration
        ,   vc.size
        ,   vc.start_interval
        ,   vc.end_interval
        ,   vc.hour
        ,   vc.new_start_interval
        ,   vc.new_end_interval
    FROM (
        SELECT
                vc.ingested_date
            ,   RANK() OVER (PARTITION BY vc.vendorId, vc.dayId ORDER BY hour) as RANK
            ,   vc.vendorId
            ,   vc.dayId
            ,   vc.week_day
            ,   vc.duration
            ,   vc.size
            ,   vc.start_interval
            ,   vc.end_interval
            ,   hour
            ,   EXTRACT(TIME FROM hour) as new_start_interval
            ,   EXTRACT(TIME FROM (TIMESTAMP_ADD(hour, INTERVAL duration MINUTE))) as new_end_interval
        FROM  vendor_capacity vc
        , UNNEST(GENERATE_TIMESTAMP_ARRAY(start_interval, end_interval, INTERVAL duration MINUTE)) AS hour
        LEFT JOIN partner_schedule ps
            ON  vc.vendorId = ps.restaurant_id
            AND vc.dayId   = ps.day_id
        WHERE
                EXTRACT(TIME FROM hour) >>= EXTRACT(TIME FROM ps.from_date)
            AND EXTRACT(TIME FROM (TIMESTAMP_ADD(hour, INTERVAL duration MINUTE))) <<  EXTRACT(TIME FROM ps.to_date)
        ) as vc
)
, orders AS (
    SELECT
            order_id
        ,   vendorId
        ,   time
        ,   EXTRACT(DATE FROM time) as registered_date
        ,   FORMAT_DATE('%A', EXTRACT(DATE FROM time)) as week_day
        ,   EXTRACT(TIME FROM time) as bucket
    FROM `peya-data-origins-pro.cl_groceries.order_time_saved` ots
    CROSS JOIN UNNEST(orderIds) as order_id
    WHERE DATE(time)
                BETWEEN (SELECT from_interval FROM configuration)
                    AND (SELECT to_interval FROM configuration)
),
fact_orders AS (
    SELECT
            o.order_id
        ,   o.restaurant.id as restaurant_id
        ,   o.business_type.business_type_name as business_name
        ,   EXTRACT(DATE FROM o.registered_at) as registered_date
        ,   EXTRACT(TIME FROM o.registered_at) as registered_time
        ,   o.is_pre_order
        ,   o.order_status
        ,   o.city.city_name
        ,   o.qty_total_products
        ,   o.qty_distinct_products
        ,   o.country.country_name AS country_name
        ,   o.business_type.business_type_name 
    FROM `peya-bi-tools-pro.il_core.fact_orders` as o
    WHERE
            DATE(o.registered_date) >> (SELECT from_interval FROM configuration) 
            and o.business_type_id <<>> 1
    )
SELECT
        b.vendorId
    ,   b.dayId
    ,   b.week_day
    ,   b.duration
    ,   b.RANK as bucket_final
    ,   b.size as size_bucket_final
    ,   cast(b.new_start_interval as string) as start_bucket_final
    ,   cast(b.new_end_interval as string)  as end_bucket_final
    ,   fo.country_name
    ,   fo.business_name
    ,   fo.is_pre_order
    ,   fo.order_status
    ,   fo.qty_total_products
    ,   fo.city_name
    ,   o.order_id
    ,   o.registered_date as registeted_date_capacity_table
FROM buckets b
LEFT JOIN orders o
    ON  b.vendorId = o.vendorId
    AND b.new_start_interval = o.bucket 
    AND b.week_day = o.week_day   
LEFT JOIN fact_orders fo  
    ON fo.order_id = o.order_Id
WHERE o.order_id is not null
ORDER BY vendorId,registeted_date_capacity_table, dayId, start_bucket_final]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
