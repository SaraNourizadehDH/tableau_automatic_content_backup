      <column caption='Daily Orders Per Store' datatype='real' name='[Calculation_1208935085487173632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(Sum([confirmed_orders])/sum([stores_qty]))/sum([total_days_in_month])' />
      </column>
      <column caption='Slowmovers' datatype='real' name='[Calculation_1237645483867914240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([total_slowmovers])/SUM([store_qty]))+(SUM([total_zeromovers])/SUM([store_qty])))&#13;&#10;/((SUM([avg_available_skus_slowmovers])/SUM([store_qty])))' />
      </column>
      <column caption='Zeromovers' datatype='real' name='[Calculation_1237645483868135425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_zeromovers])/SUM([store_qty]))&#13;&#10;/((SUM([avg_available_skus_slowmovers])/SUM([store_qty])))' />
      </column>
      <column caption='Front Margin %' datatype='real' name='[Calculation_232779871601307648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([net_sales_eur])-sum([total_cogs_sold_net_eur]))/sum([net_sales_eur])' />
      </column>
      <column caption='DOH' datatype='real' name='[Calculation_232779871601659905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([doh_stock_eur])/sum([doh_sales_eur])' />
      </column>
      <column caption='avg listed' datatype='real' name='[Calculation_232779871602593794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([total_listed_skus])/sum([total_days_in_month]))/sum([stores_qty])' />
      </column>
      <column caption=' % Instock' datatype='real' name='[Calculation_547187408183156741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum ([avg_instock_active_skus_open_stores])/sum([avg_commercially_active_skus_open_stores])' />
      </column>
      <column caption='% Front Margin' datatype='real' name='[Calculation_547187408183701510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([net_sales_eur])-sum([total_cogs_sold_net_eur]))/sum([net_sales_eur])' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_547187408184881159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_orders])/sum([active_customers])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_547187408185126920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([confirmed_gfv_net_eur])/sum([confirmed_orders])' />
      </column>
      <column caption='Avg Available SKUs Active + Inactive' datatype='real' name='[Calculation_81064847040450560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([avg_available_skus_active]) + sum([avg_available_skus_inactive])' />
      </column>
      <column caption='Daily Orders per Store' datatype='real' name='[Calculation_885801807550787585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([confirmed_orders])/sum([stores_qty]))/sum([total_days_in_month])' />
      </column>
      <column caption='ABS' datatype='real' name='[Calculation_885801807551700995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([units_sold])/sum([confirmed_orders])' />
      </column>
