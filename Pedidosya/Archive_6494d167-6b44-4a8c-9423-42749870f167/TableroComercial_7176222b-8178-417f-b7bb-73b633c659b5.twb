    <datasource caption='Slowmovers - Recurrencia' inline='true' name='federated.0fksjis1a0p0nq1977kaq1sk13ue' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1gbtadt0hzfy0519k1atf1uyq1i0'>
            <connection CATALOG='peya-food-and-groceries' EXECCATALOG='peya-food-and-groceries' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-food-and-groceries' schema='automated_tables_reports' server-oauth='' username='aldana.cid@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gbtadt0hzfy0519k1atf1uyq1i0' name='Consulta SQL personalizada' type='text'>with tabla_base as (&#13;
&#13;
SELECT&#13;
date_trunc (last_day_month,month) as last_day_month, country_code, sku_id, product_name, store_name, Category, Subcategory, Level_2, Level_3, Type_SM, Status, INSTOCK,Sales&#13;
&#13;
FROM `peya-delivery-and-support.automated_tables_reports.dmarts_slowmovers_regional`&#13;
&#13;
where Type_SM = &quot;ZM&quot;&#13;
&#13;
),&#13;
&#13;
orders as (&#13;
SELECT&#13;
&#13;
sku_id,&#13;
last_day_month,&#13;
sum(Sales) as units_sold_sku&#13;
&#13;
FROM tabla_base&#13;
group by 1,2&#13;
&#13;
),&#13;
&#13;
tabla_base_final as (&#13;
SELECT&#13;
tb. *,&#13;
units_sold_sku&#13;
&#13;
from tabla_base as tb&#13;
&#13;
left join orders as o&#13;
&#13;
on tb.last_day_month = o.last_day_month and tb.sku_id = o.sku_id&#13;
&#13;
),&#13;
&#13;
&#13;
warehouses as (&#13;
&#13;
SELECT&#13;
date_trunc(order_date,month) as month,&#13;
country_code,&#13;
count (distinct warehouse_id) as qty_wh_month&#13;
&#13;
FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level`&#13;
&#13;
&#13;
group by 1,2&#13;
&#13;
),&#13;
&#13;
skus_zm as (&#13;
&#13;
SELECT&#13;
tb.country_code,&#13;
tb.last_day_month,&#13;
tb.sku_id,&#13;
tb.product_name,&#13;
count (distinct store_name) as qty_wh_zm,&#13;
qty_wh_month/2 as half_warehouses --trae esta fila vacia, aunque en la tabla de warehouses la trae bien&#13;
&#13;
from tabla_base as tb&#13;
&#13;
left join warehouses as wh on wh.country_code = tb.country_code and wh.month = tb.last_day_month&#13;
&#13;
&#13;
group by 1,2,3,4,6&#13;
)&#13;
&#13;
SELECT&#13;
country_code,&#13;
sku_id,&#13;
product_name,&#13;
count (distinct last_day_month) as recurrency_month&#13;
FROM skus_zm&#13;
where qty_wh_zm&gt;&gt;=half_warehouses&#13;
group by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1gbtadt0hzfy0519k1atf1uyq1i0' name='Consulta SQL personalizada' type='text'>with tabla_base as (&#13;
