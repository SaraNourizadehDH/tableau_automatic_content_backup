      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_D44EAF24285041BC8E5EF3D75B15BE0B'>
            <properties context=''>
              <relation connection='bigquery.0a0pl6d0cn5rbz18ubjih0qaplow' name='Consulta SQL personalizada' type='text'><![CDATA[SELECT
          DATE_TRUNC(last_day_month, MONTH) as month
        , c.country_name as country
        , sm.country_code
        , COUNT(DISTINCT if(Type_SM="SM",SKU_WH_ID,null)) as total_slowmovers
        , COUNT(DISTINCT store_name) as store_qty
        , COUNT(DISTINCT if(Type_SM="ZM",SKU_WH_ID,null)) as total_zeromovers
        , sum(avg_is) as avg_available_skus_slowmovers

      FROM  `peya-delivery-and-support.automated_tables_reports.dmarts_slowmovers_regional` sm

      LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` c 
        ON sm.country_code = c.country_short_name

      WHERE sm.Level_2 <<>> "Apparel / Footwear / Sports equipment" 

      GROUP BY 1,2,3]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
