            <connection CATALOG='peya-argentina' EXECCATALOG='peya-argentina' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-argentina' schema='automated_tables_reports' server-oauth='' username='aldana.cid@pedidosya.com' workgroup-auth-mode='prompt' />
