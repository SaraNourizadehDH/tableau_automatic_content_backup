    <datasource caption='Listed SKUs' inline='true' name='federated.0hg6vp00b60oka15ayhu81atv5qu' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0lvphta1i82c3t1fc84yh1dyqmtz'>
            <connection CATALOG='peya-argentina' EXECCATALOG='peya-argentina' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-argentina' schema='automated_tables_reports' server-oauth='' username='aldana.cid@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0lvphta1i82c3t1fc84yh1dyqmtz' name='Consulta SQL personalizada' type='text'><![CDATA[WITH latest_order as (
  SELECT orders.global_entity_id
    , orders.region 
    , warehouse.warehouse_id
    , MAX(DATE(orders.order_placed_at)) as latest_order_date
  FROM `peya-data-origins-pro.cl_dmarts.customer_orders` orders
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` wu
    ON warehouse.warehouse_id = wu.warehouse_id
    AND orders.global_entity_id = wu.global_entity_id
  WHERE orders.is_sent = TRUE
  AND warehouse.warehouse_id IS NOT NULL
  AND wu.is_dmart = TRUE
  AND wu.is_dc = FALSE
  AND wu.online_since IS NOT NULL
  GROUP BY 1,2,3
  )
  
, listed_skus_per_warehouse AS (
  SELECT sources.global_entity_id
    , sources.region
    , sources.management_entity
    , country_code
    , date_localtime_at as stock_date
    , wu.warehouse_id
    , wu.warehouse_name
    ,(CASE WHEN (DATE(online_since) << date(date_localtime_at) -31) THEN 1 ELSE 0 END) as mature_flag -- on / of for "mature wh"
    , COUNTIF(NOT is_stale_day) fresh_skus
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.stock_movement`
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` wu USING(warehouse_id, country_code)
  LEFT JOIN `peya-data-origins-pro.cl_dmarts.sources` sources using (country_code)
  LEFT JOIN latest_order ON latest_order.global_entity_id = sources.global_entity_id
      AND latest_order.region = sources.region
      AND latest_order.warehouse_id = wu.warehouse_id
  WHERE 1=1
  AND DATE(valid_to) >> CURRENT_DATE()
  AND is_dmart = TRUE
  AND is_dc = FALSE
  AND online_since is not null
  AND wu.warehouse_id is not null
  AND latest_order.latest_order_date >> DATE_ADD(CURRENT_DATE(),INTERVAL -30 DAY)
  AND product.is_product_active = TRUE -->> 
  GROUP BY 1,2,3,4,5,6,7,8
)

SELECT DATE(stock_date) as stock_date
  , w.global_entity_id
  , w.region
  , w.management_entity
  , w.fresh_skus as listed_skus
  , w.warehouse_id
  , w.warehouse_name
  , w.mature_flag
  , count(distinct w.warehouse_id) as stocking_warehouses
FROM listed_skus_per_warehouse w



GROUP BY 1,2,3,4,5,6,7,8
ORDER BY stock_date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0lvphta1i82c3t1fc84yh1dyqmtz' name='Consulta SQL personalizada' type='text'><![CDATA[WITH latest_order as (
  SELECT orders.global_entity_id
    , orders.region 
    , warehouse.warehouse_id
    , MAX(DATE(orders.order_placed_at)) as latest_order_date
  FROM `peya-data-origins-pro.cl_dmarts.customer_orders` orders
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` wu
    ON warehouse.warehouse_id = wu.warehouse_id
    AND orders.global_entity_id = wu.global_entity_id
  WHERE orders.is_sent = TRUE
  AND warehouse.warehouse_id IS NOT NULL
  AND wu.is_dmart = TRUE
  AND wu.is_dc = FALSE
  AND wu.online_since IS NOT NULL
  GROUP BY 1,2,3
  )
  
, listed_skus_per_warehouse AS (
  SELECT sources.global_entity_id
    , sources.region
    , sources.management_entity
    , country_code
    , date_localtime_at as stock_date
    , wu.warehouse_id
    , wu.warehouse_name
    ,(CASE WHEN (DATE(online_since) << date(date_localtime_at) -31) THEN 1 ELSE 0 END) as mature_flag -- on / of for "mature wh"
    , COUNTIF(NOT is_stale_day) fresh_skus
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.stock_movement`
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` wu USING(warehouse_id, country_code)
  LEFT JOIN `peya-data-origins-pro.cl_dmarts.sources` sources using (country_code)
  LEFT JOIN latest_order ON latest_order.global_entity_id = sources.global_entity_id
      AND latest_order.region = sources.region
      AND latest_order.warehouse_id = wu.warehouse_id
  WHERE 1=1
  AND DATE(valid_to) >> CURRENT_DATE()
  AND is_dmart = TRUE
  AND is_dc = FALSE
  AND online_since is not null
  AND wu.warehouse_id is not null
  AND latest_order.latest_order_date >> DATE_ADD(CURRENT_DATE(),INTERVAL -30 DAY)
  AND product.is_product_active = TRUE -->> 
  GROUP BY 1,2,3,4,5,6,7,8
)

SELECT DATE(stock_date) as stock_date
  , w.global_entity_id
  , w.region
  , w.management_entity
  , w.fresh_skus as listed_skus
  , w.warehouse_id
  , w.warehouse_name
  , w.mature_flag
  , count(distinct w.warehouse_id) as stocking_warehouses
FROM listed_skus_per_warehouse w



GROUP BY 1,2,3,4,5,6,7,8
ORDER BY stock_date]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
