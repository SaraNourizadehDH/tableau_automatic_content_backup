        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gs44lq12xv4vo17lkauk0owx9ho' name='Consulta SQL personalizada' type='text'><![CDATA[WITH fichajes_reales AS (

  SELECT DISTINCT
    service_id,
    type,
    employee_id,
    check_in,
    check_out,
    DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS fecha_check_in,
    FORMAT_DATETIME('%H:%M', DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS hora_check_in,
    DATE(DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS fecha_check_out,
    FORMAT_DATETIME('%H:%M', DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS hora_check_out
  FROM peya-data-origins-pro.cl_orquest.clockguards_by_service 
  
),


fichajes_planificados AS (

  WITH TABLA AS (

    SELECT DISTINCT
      employee_orquest_id AS person,
      DATE(day) AS fecha,
      service_id,
      
      tf.start_minute_day,
      tf.minute_duration,
      tf.start_minute_day + tf.minute_duration AS end_minute_day,

      -- Hora de entrada
      FORMAT(
        '%02d:%02d',
        CAST(FLOOR(tf.start_minute_day / 60) AS INT64),
        CAST(MOD(tf.start_minute_day, 60) AS INT64)
      ) AS hora_entrada,

      -- Hora de salida
      FORMAT(
        '%02d:%02d',
        CAST(FLOOR((tf.start_minute_day + tf.minute_duration) / 60) AS INT64),
        CAST(MOD((tf.start_minute_day + tf.minute_duration), 60) AS INT64)
      ) AS hora_salida,

    FROM peya-data-origins-pro.cl_orquest.assignments_by_service,
    UNNEST(presence.time_frames) AS tf

  )

  SELECT
    person,
    FORMAT('W%02d', CAST(FORMAT_TIMESTAMP('%V', TIMESTAMP(fecha)) AS INT64)) AS week,
    fecha AS day,
    service_id,
    MIN(hora_entrada) AS hora_entrada,
    CASE 
      WHEN MAX(hora_salida) = "24:00" THEN "00:00"
      ELSE MAX(hora_salida)
    END AS hora_salida,
    MIN(start_minute_day) AS start_minute_day,
    SUM(minute_duration) AS minute_duration,
    MIN(start_minute_day) + SUM(minute_duration) AS end_minute_day,

  FROM TABLA
  
  GROUP BY person,week, day, service_id
  
)

-- JOIN entre fichajes reales y planificados
SELECT
  CASE 
    WHEN REGEXP_CONTAINS(fp.service_id, r'^\d{6}$') THEN 'LS'
    ELSE 'DMARTS'
  END AS vertical,
  fr.type,
  fp.service_id AS tienda,
  fp.person AS empleado,
  fp.day AS fecha,
  fp.week AS semana,
  fp.hora_entrada AS HE_plan,
  fp.hora_salida AS HS_plan,
  (fp.minute_duration) / 60.0 AS T_plan,
  MIN(fr.hora_check_in) AS HE_real,
  MAX(fr.hora_check_out) AS HS_real,
  (
  (  
    CASE 
      WHEN 
        CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(0)] AS INT64) * 60 + CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(1)] AS INT64)
        <<
        CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(0)] AS INT64) * 60 + CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(1)] AS INT64)
      THEN 
        -- Ajuste para salida al día siguiente
        (CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(0)] AS INT64) + 24) * 60 
        + CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(1)] AS INT64)
      ELSE 
        CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(0)] AS INT64) * 60 
        + CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(1)] AS INT64)
    END
  )
  -
  (
    CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(0)] AS INT64) * 60 
    + CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(1)] AS INT64)
  )
  ) / 60.0
  AS T_real

FROM fichajes_planificados fp
LEFT JOIN fichajes_reales fr
  ON fr.employee_id = fp.person
  AND fr.fecha_check_in = fp.day
  
GROUP BY 1,2,3,4,5,6,7,8,9  
ORDER BY fp.person, fp.day]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0gs44lq12xv4vo17lkauk0owx9ho' name='Consulta SQL personalizada' type='text'><![CDATA[WITH fichajes_reales AS (

