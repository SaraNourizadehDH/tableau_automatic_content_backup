        '%02d:%02d',
        CAST(FLOOR((tf.start_minute_day + tf.minute_duration) / 60) AS INT64),
        CAST(MOD((tf.start_minute_day + tf.minute_duration), 60) AS INT64)
      ) AS hora_salida,

    FROM peya-data-origins-pro.cl_orquest.assignments_by_service,
    UNNEST(presence.time_frames) AS tf

  )

  SELECT
    person,
    FORMAT('W%02d', CAST(FORMAT_TIMESTAMP('%V', TIMESTAMP(fecha)) AS INT64)) AS week,
    fecha AS day,
    service_id,
    MIN(hora_entrada) AS hora_entrada,
    CASE 
      WHEN MAX(hora_salida) = "24:00" THEN "00:00"
