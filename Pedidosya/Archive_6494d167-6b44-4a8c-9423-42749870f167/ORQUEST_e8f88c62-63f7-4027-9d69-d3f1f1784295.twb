    DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS fecha_check_in,
    FORMAT_DATETIME('%H:%M', DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS hora_check_in,
    DATE(DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS fecha_check_out,
    FORMAT_DATETIME('%H:%M', DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS hora_check_out
  FROM peya-data-origins-pro.cl_orquest.clockguards_by_service 
  
),


fichajes_planificados AS (

  WITH TABLA AS (

    SELECT DISTINCT
      employee_orquest_id AS person,
      DATE(day) AS fecha,
      service_id,
      
      tf.start_minute_day,
      tf.minute_duration,
      tf.start_minute_day + tf.minute_duration AS end_minute_day,

      -- Hora de entrada
      FORMAT(
        '%02d:%02d',
        CAST(FLOOR(tf.start_minute_day / 60) AS INT64),
        CAST(MOD(tf.start_minute_day, 60) AS INT64)
      ) AS hora_entrada,

      -- Hora de salida
      FORMAT(
        '%02d:%02d',
        CAST(FLOOR((tf.start_minute_day + tf.minute_duration) / 60) AS INT64),
        CAST(MOD((tf.start_minute_day + tf.minute_duration), 60) AS INT64)
      ) AS hora_salida,

    FROM peya-data-origins-pro.cl_orquest.assignments_by_service,
    UNNEST(presence.time_frames) AS tf

  )

  SELECT
    person,
    FORMAT('W%02d', CAST(FORMAT_TIMESTAMP('%V', TIMESTAMP(fecha)) AS INT64)) AS week,
    fecha AS day,
    service_id,
    MIN(hora_entrada) AS hora_entrada,
    CASE 
      WHEN MAX(hora_salida) = "24:00" THEN "00:00"
      ELSE MAX(hora_salida)
    END AS hora_salida,
    MIN(start_minute_day) AS start_minute_day,
    SUM(minute_duration) AS minute_duration,
    MIN(start_minute_day) + SUM(minute_duration) AS end_minute_day,

  FROM TABLA
  
  GROUP BY person,week, day, service_id
  
)

-- JOIN entre fichajes reales y planificados
SELECT
  CASE 
    WHEN REGEXP_CONTAINS(fp.service_id, r'^\d{6}$') THEN 'LS'
    ELSE 'DMARTS'
  END AS vertical,
  fr.type,
  fp.service_id AS tienda,
  fp.person AS empleado,
  fp.day AS fecha,
  fp.week AS semana,
  fp.hora_entrada AS HE_plan,
  fp.hora_salida AS HS_plan,
  (fp.minute_duration) / 60.0 AS T_plan,
  MIN(fr.hora_check_in) AS HE_real,
  MAX(fr.hora_check_out) AS HS_real,
  (
  (  
    CASE 
      WHEN 
        CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(0)] AS INT64) * 60 + CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(1)] AS INT64)
        <<
        CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(0)] AS INT64) * 60 + CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(1)] AS INT64)
      THEN 
        -- Ajuste para salida al día siguiente
        (CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(0)] AS INT64) + 24) * 60 
        + CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(1)] AS INT64)
      ELSE 
        CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(0)] AS INT64) * 60 
        + CAST(SPLIT(MAX(fr.hora_check_out), ":")[OFFSET(1)] AS INT64)
    END
  )
  -
  (
    CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(0)] AS INT64) * 60 
    + CAST(SPLIT(MIN(fr.hora_check_in), ":")[OFFSET(1)] AS INT64)
  )
  ) / 60.0
  AS T_real

FROM fichajes_planificados fp
LEFT JOIN fichajes_reales fr
  ON fr.employee_id = fp.person
  AND fr.fecha_check_in = fp.day
  
GROUP BY 1,2,3,4,5,6,7,8,9  
ORDER BY fp.person, fp.day]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='comparativa horas' inline='true' name='federated.084urdl0jssrt91300joi0achemm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.13xswg7164upda1akjxvw1rgqnoi'>
            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_orquest' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13xswg7164upda1akjxvw1rgqnoi' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
  fichajes_reales AS (
    SELECT DISTINCT
      service_id,
      type,
      employee_id,
      check_in,
      check_out,
      DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS fecha_check_in
    FROM peya-data-origins-pro.cl_orquest.clockguards_by_service 
    WHERE TYPE="WORK"
    QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id  ORDER BY check_in asc) = 1  
  ),
 
  fichajes_planificados AS (
    WITH tramos_desanidados AS (
      SELECT
        service_id,
        employee_orquest_id AS person,
        DATE(day) AS fecha,
        tf.start_minute_day,
        tf.minute_duration
      FROM `peya-data-origins-pro.cl_orquest.assignments_by_service`,
      UNNEST(presence.time_frames) AS tf
      WHERE minute_duration << 720
      AND employee_orquest_id LIKE "20__-__-____"
      --AND DATE(day) IN ("2025-08-11","2025-08-12","2025-08-13","2025-08-14","2025-08-15","2025-08-16","2025-08-17")
      --AND service_id = "AR_210_Neuquen_Este"

    ),

    tramos_unicos AS (
      SELECT DISTINCT
        service_id,
        person,
        fecha,
        start_minute_day,
        minute_duration
      FROM tramos_desanidados
    )

    SELECT
      person,
      CONCAT('W', FORMAT_DATE('%V',fecha)) AS week,
      fecha AS day,
      service_id,
      SUM(minute_duration) AS minute_duration
    FROM tramos_unicos
    GROUP BY 1,2,3,4 
  ),

  calculo_horas_reales_plan AS (
    SELECT
      fr.type,
      fp.service_id AS tienda,
      DATE(fp.day) AS fecha,
      fp.week AS semana,
      SUM(fp.minute_duration / 60.0) AS T_plan,
      SUM(TIMESTAMP_DIFF(fr.check_out, fr.check_in, MINUTE) / 60.0) AS T_real
    FROM fichajes_planificados fp
    
    LEFT JOIN fichajes_reales fr
    ON fr.employee_id = fp.person 
    
    --WHERE fp.week = "W33"
    --AND fp.service_id = "AR_210_Neuquen_Este"

    GROUP BY 1, 2, 3, 4
  ),

  calculo_horas_necesarias AS (

    SELECT
      business_id,
      service_name,
      fecha,
      SUM(
        CASE 
          WHEN tipo_tarea = "FIJA" THEN (valor_fija_variable * 15) / 60
          WHEN tipo_tarea = "LIQUIDA" THEN valor_liquida / 60
          WHEN tipo_tarea = "VARIABLE" THEN (valor_fija_variable * 15) / 60
        END
      ) AS horas_necesarias
    FROM (
      SELECT
        DATE(summary_at) AS fecha,
        business_id,
        service_name,
        location,
        CASE
          WHEN location IN ("Recepción no variable") THEN "FIJA"
          WHEN location IN ("Putaway") 
            OR location LIKE "%Recepción%" 
            OR location LIKE "%Picking%" THEN "VARIABLE"
          WHEN location IN (
            "Ajuste de bolsas","Calibración de Termómetros", "Carga de Facturas", "Carga de Facturas + PNC", "Conteos cíclicos",
            "Control de Frescos y ultra frescos AM", "Control de Frescos y ultra frescos PM", "Control de expirados",
            "Control de temperatura", "Control de temperatura AM", "Control de temperatura PM",
            "Despacho de órdenes AM", "Despacho de órdenes PM", "Gestión de Merma","Limpieza", "Limpieza Piso de tienda",
            "Limpieza de freezers y heladeras", "Limpieza y organización general", "Merma PM",
            "Reposición de mercaderia", "Reposición de mercaderia AM", "Reposición de mercaderia PM",
            "Revisión de SKUs para promos (Comercial)", "Toma de temperaturas"
          ) THEN "LIQUIDA"
          ELSE "FIJA"
        END AS tipo_tarea,
        ANY_VALUE(ts.applied) AS valor_liquida,
        SUM(ts.applied) AS valor_fija_variable
      FROM
        `peya-data-origins-pro.cl_orquest.needs_by_service`,
        UNNEST(time_slots) AS ts
      WHERE
        NOT REGEXP_CONTAINS(service_name, r'^\d{6}$')
        --AND service_name = "AR_210_Neuquen_Este"
        
      GROUP BY
        fecha, business_id, service_name, location
    ) sub
    GROUP BY 1, 2, 3

  )

SELECT 
  a.type,
  a.tienda,
  a.fecha,
  a.semana,
  a.T_plan,
  a.T_real,
  b.horas_necesarias
FROM calculo_horas_reales_plan a
JOIN calculo_horas_necesarias b 
  ON a.tienda = b.service_name 
  AND a.fecha = b.fecha
WHERE a.type = "WORK"
-- AND a.tienda = "AR_210_Neuquen_Este"
-- AND a.semana = "W33"

ORDER BY a.fecha desc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.13xswg7164upda1akjxvw1rgqnoi' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
