      WHEN wh.name IN ('AR_129_San_Luis','AR_177_Mendoza_Las_Heras','AR_181_San_Juan_Centro','AR_39_Mendoza_Godoy','AR_81_Mendoza_Guaymallen') THEN "Cuyo"
      WHEN wh.name IN ('AR_131_Ing_Maschwitz','AR_19_Beccar','AR_197_San_Fernando','AR_66_Escobar','AR_8_Nordelta','AR_80_Pacheco') THEN "GBA NorEste"
      WHEN wh.name IN ('AR_16_Pilar','AR_182_Munro','AR_20_San _Andres','AR_215_Lujan','AR_220_Villa_Ballester','AR_229_Pilar_II','AR_242_Manuel_Alberti','AR_508_San_Martin') THEN "GBA NorOeste"
      WHEN wh.name IN ('AR_13_Caseros','AR_147_Ituzaingo','AR_226_Moreno','AR_180_Hurlingham','AR_187_Merlo','AR_232_San_Justo','AR_29_Ramos_Mejia','AR_67_Castelar','AR_7_San Miguel','AR_510_Ramos_Mejia_II') THEN "GBA Oeste"
      WHEN wh.name IN ('AR_173_Wilde','AR_223_Monte_Grande','AR_4_Avellaneda','AR_54_Quilmes','AR_6_Lanus','AR_65_Lomas') THEN "GBA Sur-Norte"
      WHEN wh.name IN ('AR_10_La Plata','AR_134_City_Bell','AR_170_La_Plata_II','AR_209_Florencio_Varela','AR_277_Berazategui') THEN "GBA Sur-Sur"
      WHEN wh.name IN ('AR_55_SANTA_FE','AR_57_PARANA','AR_68_Rosario_ll') THEN "LITORAL"
      WHEN wh.name IN ('AR_40_Resistencia','AR_63_Corrientes') THEN "NEA"
      WHEN wh.name IN ('AR_179_Tucuman Centro II','AR_38_Tucuman','AR_56_SALTA','AR_58_TUCUMAN_YERBA_BUENA') THEN "NOA"
      WHEN wh.name IN ('AR_183_Bahia_Blanca_II','AR_23_Mdq_Luro','AR_30_Mdq_Alvarado','AR_41_Bahia_Blanca') THEN "PBA"
      WHEN wh.name IN ('AR_210_Neuquen_Este') THEN "Sur"
      ELSE 'LATAM'
    END AS zona
  FROM tiendas_activas t
  LEFT JOIN warehouses wh ON wh.warehouse_id = t.warehouse_id
),

-- Tiendas con zona asegurada
tiendas_con_zona AS (
  SELECT 
    ta.country_code,
    ta.warehouse_id,
    m.zona
  FROM tiendas_activas ta
  LEFT JOIN maestro m
    ON CAST(m.warehouse_id AS STRING) = CAST(ta.warehouse_id AS STRING)
),

-- Tabla de semanas W01-W52
semanas AS (
  SELECT FORMAT('W%02d', semana) AS week
  FROM UNNEST(GENERATE_ARRAY(1, 52)) AS semana
),

-- Rooster
rooster AS (
  WITH TABLA AS (
    SELECT
      employee_orquest_id AS person,
      DATE(day) AS fecha,
      service_id,
      product,
      tf.start_minute_day,
      tf.minute_duration,
      FORMAT('%02d:%02d', CAST(FLOOR(tf.start_minute_day / 60) AS INT64), CAST(MOD(tf.start_minute_day, 60) AS INT64)) AS hora_entrada,
      FORMAT('%02d:%02d', CAST(FLOOR(MOD(tf.start_minute_day + CAST(tf.minute_duration AS INT64), 1440) / 60) AS INT64), CAST(MOD(MOD(tf.start_minute_day + CAST(tf.minute_duration AS INT64), 1440), 60) AS INT64)) AS hora_salida
    FROM `peya-data-origins-pro.cl_orquest.assignments_by_service`,
    UNNEST(presence.time_frames) AS tf
    WHERE NOT REGEXP_CONTAINS(service_id, r'^\d+$')
      AND tf.start_minute_day <<>> 0
  )

  SELECT
    person,
    FORMAT('W%02d', EXTRACT(WEEK(MONDAY) FROM fecha)) AS week,
    fecha AS day,
    service_id,
    product,
    MIN(hora_entrada) AS hora_entrada,
    MAX(hora_salida) AS hora_salida
  FROM TABLA
  GROUP BY person, day, service_id, product
  HAVING NOT (hora_entrada = '06:00' AND hora_salida IN ('23:00', '23:30','00:00'))
),

-- Agregación de turnos por tienda y semana
turnos AS (
  SELECT
    m.country_code,
    m.zona,
    m.warehouse_id,
    r.service_id,
    r.product,
    r.week,
    COUNT(DISTINCT r.person) AS turnos_publicados,
    COUNT(DISTINCT e.employee_id) AS empleados_tienda,
    CASE 
      WHEN SAFE_DIVIDE(COUNT(DISTINCT r.person), COUNT(DISTINCT e.employee_id)) >> 0.7 THEN "SI"
      ELSE "NO"
    END AS publico
  FROM rooster r
  FULL OUTER JOIN maestro m ON CAST(m.warehouse_id AS STRING) = CAST(r.product AS STRING)
  FULL OUTER JOIN empleados_unicos e ON UPPER(r.service_id) = UPPER(e.service_id)
  GROUP BY 1,2,3,4,5,6
)

-- Resultado final
SELECT
  ta.country_code,
  ta.warehouse_id,
  tz.zona,
  wh.name,
  s.week,
  t.turnos_publicados,
  t.empleados_tienda,
  IFNULL(t.publico, 'NO') AS publico

FROM tiendas_activas ta
CROSS JOIN semanas s
LEFT JOIN warehouses wh ON wh.warehouse_id = ta.warehouse_id
LEFT JOIN tiendas_con_zona tz ON ta.country_code = tz.country_code AND ta.warehouse_id = tz.warehouse_id
LEFT JOIN turnos t ON ta.country_code = t.country_code AND ta.warehouse_id = t.warehouse_id AND s.week = t.week
GROUP BY 1,2,3,4,5,6,7,8]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='forecast agrupado por semana' inline='true' name='federated.17rgl7e03nb4hu1089blg1hk39x7' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0vs2vyw0j14wjs1gh8emr1dprz7e'>
            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_orquest' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vs2vyw0j14wjs1gh8emr1dprz7e' name='Consulta SQL personalizada' type='text'><![CDATA[WITH reales AS (

SELECT
  input_vendor_measures.product_id,
  input_vendor_measures.measure,
  CAST(input_vendor_measures.`value` AS FLOAT64) AS value,
  input_vendor_measures.`date` AS date_utc,
  DATETIME(TIMESTAMP(input_vendor_measures.`date`),country.timezone) AS date_ls
FROM `peya-bi-tools-pro.il_orquest.input_vendor_measures` AS input_vendor_measures
LEFT JOIN `peya-data-origins-pro.cl_qcommerce.warehouses_v2` AS dp ON dp.warehouse_id = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dp2 ON CAST(dp2.partner_id AS STRING) = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS country ON COALESCE(UPPER(dp.country_code),UPPER(dp2.country.country_code)) = country.country_code

),


proyeccion AS (

SELECT
  service_id,
  business_id,
  measure,  
  DATE(from_ls) AS fecha,
  EXTRACT(HOUR FROM from_ls) AS hora,
  SUM(value) AS total_value
FROM `peya-data-origins-pro.cl_orquest.measure_projections`
GROUP BY service_id, business_id, measure, fecha, hora
ORDER BY fecha, hora

),

forecast AS (

SELECT
  service_id,
  business_id,
  measure,  
  DATE(from_ls) AS fecha,
  EXTRACT(HOUR FROM from_ls) AS hora,
  SUM(value) AS total_value
FROM `peya-data-origins-pro.cl_orquest.measure_forecast`
GROUP BY service_id, business_id, measure, fecha, hora
ORDER BY fecha, hora

),

warehouses AS (

SELECT
  warehouse_id,
  name
FROM `peya-data-origins-pro.cl_qcommerce.warehouses_v2`

)


SELECT
  CASE 
    WHEN REGEXP_CONTAINS(fcst.service_id, r'^\d{6}$') THEN 'LS'
    ELSE 'DMARTS'
  END AS vertical,
  fcst.business_id,
  fcst.service_id,
  warehouses.name,
  CASE
  WHEN warehouses.name IN ('AR_12_ParqueAvellaneda','AR_138_Villa_Ortuzar','AR_153_Nunez','AR_199_Mataderos','AR_3_Belgrano','AR_42_Villa_del_Parque') THEN "CABA Norte"
  WHEN warehouses.name IN ('AR_126_Parque_Patricios','AR_141_Barracas','AR_2_Boedo','AR_235_Barrio_Norte','AR_507_Villa_Crespo','AR_9_Microcentro') THEN "CABA Sur"
  WHEN warehouses.name IN ('AR_14_Cordillera','AR_15_25deMayo','AR_156_Crisol','AR_159_Rio_Cuarto') THEN "Cordoba"
  WHEN warehouses.name IN ('AR_129_San_Luis','AR_177_Mendoza_Las_Heras','AR_181_San_Juan_Centro','AR_39_Mendoza_Godoy','AR_81_Mendoza_Guaymallen') THEN "Cuyo"
  WHEN warehouses.name IN ('AR_131_Ing_Maschwitz','AR_19_Beccar','AR_197_San_Fernando','AR_66_Escobar','AR_8_Nordelta','AR_80_Pacheco') THEN "GBA NorEste"
  WHEN warehouses.name IN ('AR_16_Pilar','AR_182_Munro','AR_20_San _Andres','AR_215_Lujan','AR_220_Villa_Ballester','AR_229_Pilar_II','AR_242_Manuel_Alberti','AR_508_San_Martin') THEN "GBA NorOeste"
  WHEN warehouses.name IN ('AR_13_Caseros','AR_147_Ituzaingo','AR_226_Moreno','AR_180_Hurlingham','AR_187_Merlo','AR_232_San_Justo','AR_29_Ramos_Mejia','AR_67_Castelar','AR_7_San Miguel') THEN "GBA Oeste"
  WHEN warehouses.name IN ('AR_173_Wilde','AR_223_Monte_Grande','AR_4_Avellaneda','AR_54_Quilmes','AR_6_Lanus','AR_65_Lomas') THEN "GBA Sur-Norte"
  WHEN warehouses.name IN ('AR_10_La Plata','AR_134_City_Bell','AR_170_La_Plata_II','AR_209_Florencio_Varela','AR_277_Berazategui') THEN "GBA Sur-Sur"
  WHEN warehouses.name IN ('AR_55_SANTA_FE','AR_57_PARANA','AR_68_Rosario_ll') THEN "LITORAL"
  WHEN warehouses.name IN ('AR_40_Resistencia','AR_63_Corrientes') THEN "NEA"
  WHEN warehouses.name IN ('AR_179_Tucuman Centro II','AR_38_Tucuman','AR_56_SALTA','AR_58_TUCUMAN_YERBA_BUENA') THEN "NOA"
  WHEN warehouses.name IN ('AR_183_Bahia_Blanca_II','AR_23_Mdq_Luro','AR_30_Mdq_Alvarado','AR_41_Bahia_Blanca') THEN "PBA"
  WHEN warehouses.name IN ('AR_210_Neuquen_Este') THEN "Sur"
  ELSE 'LATAM'
  END AS zona,
  fcst.measure,
  FORMAT('W%02d', CAST(FORMAT_TIMESTAMP('%V', TIMESTAMP(fcst.fecha)) AS INT64)) AS week,
  SUM(proyeccion.total_value) AS proyeccion_value,
  SUM(fcst.total_value) AS forecast_value,
  SUM(reales.value) AS real_value,
  CASE 
    WHEN SAFE_DIVIDE(SUM(reales.value), SUM(fcst.total_value)) IS NULL THEN 'Sin datos'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(fcst.total_value), SUM(fcst.total_value))) <<= 0.10 THEN '±10%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(fcst.total_value), SUM(fcst.total_value))) <<= 0.25 THEN '±25%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(fcst.total_value), SUM(fcst.total_value))) <<= 0.50 THEN '±50%'
    ELSE '±50% o más'
  END AS clasificacion_desvio_orquest,
    CASE 
    WHEN SAFE_DIVIDE(SUM(reales.value), SUM(proyeccion.total_value)) IS NULL THEN 'Sin datos'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(proyeccion.total_value), SUM(proyeccion.total_value))) <<= 0.10 THEN '±10%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(proyeccion.total_value), SUM(proyeccion.total_value))) <<= 0.25 THEN '±25%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(proyeccion.total_value), SUM(proyeccion.total_value))) <<= 0.50 THEN '±50%'
    ELSE '±50% o más'
  END AS clasificacion_desvio_manual

FROM forecast fcst

LEFT JOIN warehouses
  ON fcst.service_id = warehouses.warehouse_id

LEFT JOIN proyeccion
  ON fcst.service_id = proyeccion.service_id
  AND fcst.measure = proyeccion.measure
  AND fcst.fecha = proyeccion.fecha
  AND fcst.hora = proyeccion.hora

LEFT JOIN reales
  ON fcst.service_id = reales.product_id
  AND fcst.measure = reales.measure
  AND DATE(reales.date_ls) = fcst.fecha
  AND EXTRACT(HOUR FROM reales.date_ls) = fcst.hora

GROUP BY  fcst.business_id,  fcst.service_id,  week, warehouses.name, fcst.measure
ORDER BY  fcst.business_id,  fcst.service_id,  week]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0vs2vyw0j14wjs1gh8emr1dprz7e' name='Consulta SQL personalizada' type='text'><![CDATA[WITH reales AS (

SELECT
  input_vendor_measures.product_id,
  input_vendor_measures.measure,
  CAST(input_vendor_measures.`value` AS FLOAT64) AS value,
  input_vendor_measures.`date` AS date_utc,
  DATETIME(TIMESTAMP(input_vendor_measures.`date`),country.timezone) AS date_ls
FROM `peya-bi-tools-pro.il_orquest.input_vendor_measures` AS input_vendor_measures
LEFT JOIN `peya-data-origins-pro.cl_qcommerce.warehouses_v2` AS dp ON dp.warehouse_id = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dp2 ON CAST(dp2.partner_id AS STRING) = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS country ON COALESCE(UPPER(dp.country_code),UPPER(dp2.country.country_code)) = country.country_code

),


proyeccion AS (

SELECT
  service_id,
  business_id,
