      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_D9B3960F7E6C4A1BBA820F85BC314CBE'>
            <properties context=''>
              <relation connection='bigquery.1xexnda04nftco1b0umf209qvadi' name='Consulta SQL personalizada' type='text'><![CDATA[WITH reales AS (

SELECT
  input_vendor_measures.product_id,
  input_vendor_measures.measure,
  CAST(input_vendor_measures.`value` AS FLOAT64) AS value,
  input_vendor_measures.`date` AS date_utc,
  DATETIME(TIMESTAMP(input_vendor_measures.`date`),country.timezone) AS date_ls
FROM `peya-bi-tools-pro.il_orquest.input_vendor_measures` AS input_vendor_measures
LEFT JOIN `peya-data-origins-pro.cl_qcommerce.warehouses_v2` AS dp ON dp.warehouse_id = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dp2 ON CAST(dp2.partner_id AS STRING) = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS country ON COALESCE(UPPER(dp.country_code),UPPER(dp2.country.country_code)) = country.country_code

),


proyeccion AS (

SELECT
  service_id,
  business_id,
  measure,  
  DATE(from_ls) AS fecha,
  EXTRACT(HOUR FROM from_ls) AS hora,
  SUM(value) AS total_value
FROM `peya-data-origins-pro.cl_orquest.measure_projections`
GROUP BY service_id, business_id, measure, fecha, hora
ORDER BY fecha, hora

),

forecast AS (

SELECT
  service_id,
  business_id,
  measure,  
  DATE(from_ls) AS fecha,
  EXTRACT(HOUR FROM from_ls) AS hora,
  SUM(value) AS total_value
FROM `peya-data-origins-pro.cl_orquest.measure_forecast`
GROUP BY service_id, business_id, measure, fecha, hora
ORDER BY fecha, hora

),

warehouses AS (

SELECT
  warehouse_id,
  name
FROM `peya-data-origins-pro.cl_qcommerce.warehouses_v2`

)


SELECT
  CASE 
    WHEN REGEXP_CONTAINS(fcst.service_id, r'^\d{6}$') THEN 'LS'
    ELSE 'DMARTS'
  END AS vertical,
  fcst.business_id,
  fcst.service_id,
  warehouses.name,
  fcst.measure,
  fcst.fecha,
  fcst.hora,
  proyeccion.total_value AS proyeccion_value,
  fcst.total_value AS forecast_value,
  reales.value AS real_value,
  CASE 
    WHEN SAFE_DIVIDE(reales.value, fcst.total_value) IS NULL THEN 'Sin datos'
    WHEN ABS(SAFE_DIVIDE(reales.value - fcst.total_value, fcst.total_value)) <<= 0.10 THEN '±10%'
    WHEN ABS(SAFE_DIVIDE(reales.value - fcst.total_value, fcst.total_value)) <<= 0.25 THEN '±25%'
    WHEN ABS(SAFE_DIVIDE(reales.value - fcst.total_value, fcst.total_value)) <<= 0.50 THEN '±50%'
    ELSE '±50% o más'
  END AS clasificacion_desvio_orquest,
    CASE 
    WHEN SAFE_DIVIDE(reales.value, proyeccion.total_value) IS NULL THEN 'Sin datos'
    WHEN ABS(SAFE_DIVIDE(reales.value - proyeccion.total_value, proyeccion.total_value)) <<= 0.10 THEN '±10%'
    WHEN ABS(SAFE_DIVIDE(reales.value - proyeccion.total_value, proyeccion.total_value)) <<= 0.25 THEN '±25%'
    WHEN ABS(SAFE_DIVIDE(reales.value - proyeccion.total_value, proyeccion.total_value)) <<= 0.50 THEN '±50%'
    ELSE '±50% o más'
  END AS clasificacion_desvio_manual

FROM forecast fcst

LEFT JOIN warehouses
  ON fcst.service_id = warehouses.warehouse_id

LEFT JOIN proyeccion
  ON fcst.service_id = proyeccion.service_id
  AND fcst.measure = proyeccion.measure
  AND fcst.fecha = proyeccion.fecha
  AND fcst.hora = proyeccion.hora

LEFT JOIN reales
  ON fcst.service_id = reales.product_id
  AND fcst.measure = reales.measure
  AND DATE(reales.date_ls) = fcst.fecha
  AND EXTRACT(HOUR FROM reales.date_ls) = fcst.hora

ORDER BY  fcst.business_id,  fcst.service_id,  fcst.fecha,  fcst.hora]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='horas v2' inline='true' name='federated.1ljpjx7002l48a1cgveaw1xtlwhd' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1vc7w3j1mjxz4i0zitcrq0lv5cv3'>
            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_orquest' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1vc7w3j1mjxz4i0zitcrq0lv5cv3' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
  -- fichajes_reales AS (
  --   SELECT DISTINCT
  --     service_id,
  --     type,
  --     employee_id,
  --     check_in,
  --     check_out,
  --     DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS fecha_check_in
  --   FROM `peya-data-origins-pro.cl_orquest.clockguards_by_service` 
  --   WHERE TYPE="WORK"
  --   AND DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) = "2025-08-18"
  --   --AND employee_id = "2024-05-0726"
  --   QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id  ORDER BY check_in asc) = 1  
  -- ),
 
  fichajes_planificados AS (
    WITH tramos_desanidados AS (
      SELECT
        service_id,
        employee_orquest_id AS person,
        DATE(day) AS fecha,
        tf.start_minute_day,
        tf.minute_duration,
        tf.location.name AS tarea
      FROM `peya-data-origins-pro.cl_orquest.assignments_by_service`,
      UNNEST(presence.time_frames) AS tf
      WHERE minute_duration << 720
      AND employee_orquest_id LIKE "20__-__-____"
      --AND DATE(day) IN ("2025-08-11","2025-08-12","2025-08-13","2025-08-14","2025-08-15","2025-08-16","2025-08-17")
      --AND service_id = "AR_210_Neuquen_Este"

    ),

    tramos_unicos AS (
      SELECT DISTINCT
        service_id,
        person,
        fecha,
        start_minute_day,
        minute_duration,
        tarea
      FROM tramos_desanidados
    )

    SELECT
      person,
      CONCAT('W', FORMAT_DATE('%V',fecha)) AS week,
      fecha AS day,
      service_id,
      CASE WHEN tarea IS NULL THEN "Descanso" ELSE tarea END AS tarea,
      SUM(minute_duration) AS minute_duration,
    FROM tramos_unicos

    --WHERE service_id = "AR_210_Neuquen_Este"
    --AND fecha = "2025-08-18"
    --AND person = "2024-05-0726"

    GROUP BY 1,2,3,4,5 
  ),

  calculo_horas_reales_plan AS (
    SELECT
      --fr.type,
      fp.service_id AS tienda,
      DATE(fp.day) AS fecha,
      fp.week AS semana,
      fp.tarea,
      SUM(fp.minute_duration / 60.0) AS T_plan,
      --SUM(TIMESTAMP_DIFF(fr.check_out, fr.check_in, MINUTE) / 60.0) AS T_real
    FROM fichajes_planificados fp
    
    -- LEFT JOIN fichajes_reales fr
    -- ON fr.employee_id = fp.person 
    -- AND fr.fecha_check_in = fp.day
    
    --WHERE fp.week = "W33"
    --AND fp.service_id = "AR_210_Neuquen_Este"

    GROUP BY 1, 2, 3, 4--,5
  ),

  calculo_horas_necesarias AS (

    SELECT
      business_id,
      service_name,
      fecha,
      location,
      SUM(
        CASE 
          WHEN tipo_tarea = "FIJA" THEN (valor_fija_variable * 15) / 60
          WHEN tipo_tarea = "LIQUIDA" THEN valor_liquida / 60
          WHEN tipo_tarea = "VARIABLE" THEN (valor_fija_variable * 15) / 60
        END
      ) AS horas_necesarias
    FROM (
      SELECT
        DATE(summary_at) AS fecha,
        business_id,
        service_name,
        location,
        CASE
          WHEN location IN ("Recepción no variable") THEN "FIJA"
          WHEN location IN ("Putaway") 
            OR location LIKE "%Recepción%" 
            OR location LIKE "%Picking%" THEN "VARIABLE"
          WHEN location IN (
            "Ajuste de bolsas","Calibración de Termómetros", "Carga de Facturas", "Carga de Facturas + PNC", "Conteos cíclicos",
            "Control de Frescos y ultra frescos AM", "Control de Frescos y ultra frescos PM", "Control de expirados",
            "Control de temperatura", "Control de temperatura AM", "Control de temperatura PM",
            "Despacho de órdenes AM", "Despacho de órdenes PM", "Gestión de Merma","Limpieza", "Limpieza Piso de tienda",
            "Limpieza de freezers y heladeras", "Limpieza y organización general", "Merma PM",
            "Reposición de mercaderia", "Reposición de mercaderia AM", "Reposición de mercaderia PM",
            "Revisión de SKUs para promos (Comercial)", "Toma de temperaturas"
          ) THEN "LIQUIDA"
          ELSE "FIJA"
        END AS tipo_tarea,
        ANY_VALUE(ts.applied) AS valor_liquida,
        SUM(ts.applied) AS valor_fija_variable
      FROM
        `peya-data-origins-pro.cl_orquest.needs_by_service`,
        UNNEST(time_slots) AS ts
      WHERE
        NOT REGEXP_CONTAINS(service_name, r'^\d{6}$')
        --AND service_name = "AR_210_Neuquen_Este"
        --AND summary_at = "2025-08-18"
        --AND person = "2024-05-0726"
        
      GROUP BY
        fecha, business_id, service_name, location
    ) sub
    GROUP BY 1, 2, 3, 4

  )

SELECT 
  --a.type,
  b.business_id,
  b.service_name,
  b.fecha,
  CONCAT('W', FORMAT_DATE('%V',b.fecha)) AS week,
  b.location,
  a.T_plan,
  --a.T_real,
  b.horas_necesarias
FROM calculo_horas_necesarias b 
LEFT JOIN calculo_horas_reales_plan a
  ON a.tienda = b.service_name 
  AND a.fecha = b.fecha
  AND a.tarea = b.location
--WHERE a.type = "WORK"
-- AND a.tienda = "AR_210_Neuquen_Este"
-- AND a.semana = "W33"

ORDER BY a.fecha desc]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1vc7w3j1mjxz4i0zitcrq0lv5cv3' name='Consulta SQL personalizada' type='text'><![CDATA[WITH 
  -- fichajes_reales AS (
  --   SELECT DISTINCT
  --     service_id,
  --     type,
  --     employee_id,
  --     check_in,
  --     check_out,
  --     DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS fecha_check_in
  --   FROM `peya-data-origins-pro.cl_orquest.clockguards_by_service` 
  --   WHERE TYPE="WORK"
  --   AND DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) = "2025-08-18"
  --   --AND employee_id = "2024-05-0726"
  --   QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id  ORDER BY check_in asc) = 1  
  -- ),
 
  fichajes_planificados AS (
    WITH tramos_desanidados AS (
      SELECT
        service_id,
        employee_orquest_id AS person,
        DATE(day) AS fecha,
        tf.start_minute_day,
        tf.minute_duration,
        tf.location.name AS tarea
      FROM `peya-data-origins-pro.cl_orquest.assignments_by_service`,
      UNNEST(presence.time_frames) AS tf
      WHERE minute_duration << 720
      AND employee_orquest_id LIKE "20__-__-____"
      --AND DATE(day) IN ("2025-08-11","2025-08-12","2025-08-13","2025-08-14","2025-08-15","2025-08-16","2025-08-17")
      --AND service_id = "AR_210_Neuquen_Este"

    ),

    tramos_unicos AS (
      SELECT DISTINCT
        service_id,
        person,
        fecha,
        start_minute_day,
        minute_duration,
        tarea
      FROM tramos_desanidados
    )

    SELECT
      person,
      CONCAT('W', FORMAT_DATE('%V',fecha)) AS week,
      fecha AS day,
      service_id,
      CASE WHEN tarea IS NULL THEN "Descanso" ELSE tarea END AS tarea,
      SUM(minute_duration) AS minute_duration,
    FROM tramos_unicos

    --WHERE service_id = "AR_210_Neuquen_Este"
    --AND fecha = "2025-08-18"
    --AND person = "2024-05-0726"

    GROUP BY 1,2,3,4,5 
  ),

  calculo_horas_reales_plan AS (
    SELECT
      --fr.type,
      fp.service_id AS tienda,
      DATE(fp.day) AS fecha,
      fp.week AS semana,
      fp.tarea,
      SUM(fp.minute_duration / 60.0) AS T_plan,
      --SUM(TIMESTAMP_DIFF(fr.check_out, fr.check_in, MINUTE) / 60.0) AS T_real
    FROM fichajes_planificados fp
    
    -- LEFT JOIN fichajes_reales fr
    -- ON fr.employee_id = fp.person 
    -- AND fr.fecha_check_in = fp.day
    
    --WHERE fp.week = "W33"
    --AND fp.service_id = "AR_210_Neuquen_Este"

    GROUP BY 1, 2, 3, 4--,5
  ),

  calculo_horas_necesarias AS (

    SELECT
      business_id,
      service_name,
      fecha,
      location,
      SUM(
        CASE 
          WHEN tipo_tarea = "FIJA" THEN (valor_fija_variable * 15) / 60
          WHEN tipo_tarea = "LIQUIDA" THEN valor_liquida / 60
          WHEN tipo_tarea = "VARIABLE" THEN (valor_fija_variable * 15) / 60
        END
      ) AS horas_necesarias
    FROM (
      SELECT
        DATE(summary_at) AS fecha,
        business_id,
        service_name,
        location,
        CASE
          WHEN location IN ("Recepción no variable") THEN "FIJA"
          WHEN location IN ("Putaway") 
            OR location LIKE "%Recepción%" 
            OR location LIKE "%Picking%" THEN "VARIABLE"
          WHEN location IN (
            "Ajuste de bolsas","Calibración de Termómetros", "Carga de Facturas", "Carga de Facturas + PNC", "Conteos cíclicos",
            "Control de Frescos y ultra frescos AM", "Control de Frescos y ultra frescos PM", "Control de expirados",
            "Control de temperatura", "Control de temperatura AM", "Control de temperatura PM",
            "Despacho de órdenes AM", "Despacho de órdenes PM", "Gestión de Merma","Limpieza", "Limpieza Piso de tienda",
            "Limpieza de freezers y heladeras", "Limpieza y organización general", "Merma PM",
            "Reposición de mercaderia", "Reposición de mercaderia AM", "Reposición de mercaderia PM",
            "Revisión de SKUs para promos (Comercial)", "Toma de temperaturas"
          ) THEN "LIQUIDA"
          ELSE "FIJA"
        END AS tipo_tarea,
        ANY_VALUE(ts.applied) AS valor_liquida,
        SUM(ts.applied) AS valor_fija_variable
      FROM
        `peya-data-origins-pro.cl_orquest.needs_by_service`,
        UNNEST(time_slots) AS ts
      WHERE
        NOT REGEXP_CONTAINS(service_name, r'^\d{6}$')
        --AND service_name = "AR_210_Neuquen_Este"
        --AND summary_at = "2025-08-18"
        --AND person = "2024-05-0726"
        
      GROUP BY
        fecha, business_id, service_name, location
    ) sub
    GROUP BY 1, 2, 3, 4

  )

SELECT 
  --a.type,
  b.business_id,
  b.service_name,
  b.fecha,
  CONCAT('W', FORMAT_DATE('%V',b.fecha)) AS week,
  b.location,
  a.T_plan,
  --a.T_real,
  b.horas_necesarias
FROM calculo_horas_necesarias b 
LEFT JOIN calculo_horas_reales_plan a
  ON a.tienda = b.service_name 
  AND a.fecha = b.fecha
  AND a.tarea = b.location
--WHERE a.type = "WORK"
-- AND a.tienda = "AR_210_Neuquen_Este"
-- AND a.semana = "W33"

ORDER BY a.fecha desc]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
