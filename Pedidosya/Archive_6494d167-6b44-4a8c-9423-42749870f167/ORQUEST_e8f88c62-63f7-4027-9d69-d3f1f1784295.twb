        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gfwitm0gv97yj10g5lq71k9ika0' name='Consulta SQL personalizada' type='text'>WITH&#13;
&#13;
warehouses AS (&#13;
&#13;
  SELECT&#13;
    warehouse_id,&#13;
    name&#13;
  FROM `peya-data-origins-pro.cl_qcommerce.warehouses_v2`&#13;
&#13;
),&#13;
&#13;
tareas AS (&#13;
&#13;
  SELECT&#13;
    LOCATION,&#13;
    location_id,&#13;
    service,&#13;
    ts.from_timestamp,&#13;
    ts.TO_TIMESTAMP,&#13;
    ts.total,&#13;
    business_id,&#13;
    summary_date&#13;
  FROM `peya-data-origins-pro.cl_orquest.assignments_summary_by_service`,&#13;
  UNNEST(timeSlots) AS ts&#13;
&#13;
)&#13;
&#13;
&#13;
SELECT&#13;
  CASE &#13;
    WHEN REGEXP_CONTAINS(t.service, r&apos;^\d{6}$&apos;) THEN &apos;LS&apos;&#13;
    ELSE &apos;DMARTS&apos;&#13;
  END AS vertical,&#13;
  business_id AS mercado,&#13;
  service AS tienda,&#13;
  EXTRACT(DATE FROM DATETIME(TIMESTAMP(from_timestamp),country.timezone)) AS fecha,&#13;
  EXTRACT(HOUR FROM DATETIME(TIMESTAMP(from_timestamp),country.timezone)) AS hora,&#13;
  LOCATION AS tarea,&#13;
  SUM(total)/4.0 AS pickers_por_hora,&#13;
  &#13;
FROM tareas t&#13;
&#13;
LEFT JOIN warehouses wh&#13;
ON wh.name = t.service&#13;
&#13;
LEFT JOIN `peya-data-origins-pro.cl_qcommerce.warehouses_v2` AS dp &#13;
ON dp.warehouse_id = wh.warehouse_id&#13;
&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dp2 &#13;
ON CAST(dp2.partner_id AS STRING) = wh.warehouse_id&#13;
&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS country &#13;
ON COALESCE(UPPER(dp.country_code),UPPER(dp2.country.country_code)) = country.country_code&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
ORDER BY 1,2,3,4,5,6</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0gfwitm0gv97yj10g5lq71k9ika0' name='Consulta SQL personalizada' type='text'>WITH&#13;
