      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='_2AA76AC0BFD94D179DBEAEA58DF5F7A9'>
            <properties context=''>
              <relation connection='bigquery.13b4ojt18hwwrj1c9mtkh1yroa3t' name='Consulta SQL personalizada' type='text'><![CDATA[WITH reales AS (

SELECT
  input_vendor_measures.product_id,
  input_vendor_measures.measure,
  CAST(input_vendor_measures.`value` AS FLOAT64) AS value,
  input_vendor_measures.`date` AS date_utc,
  DATETIME(TIMESTAMP(input_vendor_measures.`date`),country.timezone) AS date_ls
FROM `peya-bi-tools-pro.il_orquest.input_vendor_measures` AS input_vendor_measures
LEFT JOIN `peya-data-origins-pro.cl_qcommerce.warehouses_v2` AS dp ON dp.warehouse_id = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_partner` AS dp2 ON CAST(dp2.partner_id AS STRING) = input_vendor_measures.product_id
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS country ON COALESCE(UPPER(dp.country_code),UPPER(dp2.country.country_code)) = country.country_code

),


proyeccion AS (

SELECT
  service_id,
  business_id,
  measure,  
  DATE(from_ls) AS fecha,
  EXTRACT(HOUR FROM from_ls) AS hora,
  SUM(value) AS total_value
FROM `peya-data-origins-pro.cl_orquest.measure_projections`
GROUP BY service_id, business_id, measure, fecha, hora
ORDER BY fecha, hora

),

forecast AS (

SELECT
  service_id,
  business_id,
  measure,  
  DATE(from_ls) AS fecha,
  EXTRACT(HOUR FROM from_ls) AS hora,
  SUM(value) AS total_value
FROM `peya-data-origins-pro.cl_orquest.measure_forecast`
GROUP BY service_id, business_id, measure, fecha, hora
ORDER BY fecha, hora

),

warehouses AS (

SELECT
  warehouse_id,
  name
FROM `peya-data-origins-pro.cl_qcommerce.warehouses_v2`

)


SELECT
  CASE 
    WHEN REGEXP_CONTAINS(fcst.service_id, r'^\d{6}$') THEN 'LS'
    ELSE 'DMARTS'
  END AS vertical,
  fcst.business_id,
  fcst.service_id,
  warehouses.name,
  CASE
  WHEN warehouses.name IN ('AR_12_ParqueAvellaneda','AR_138_Villa_Ortuzar','AR_153_Nunez','AR_199_Mataderos','AR_3_Belgrano','AR_42_Villa_del_Parque') THEN "CABA Norte"
  WHEN warehouses.name IN ('AR_126_Parque_Patricios','AR_141_Barracas','AR_2_Boedo','AR_235_Barrio_Norte','AR_507_Villa_Crespo','AR_9_Microcentro') THEN "CABA Sur"
  WHEN warehouses.name IN ('AR_14_Cordillera','AR_15_25deMayo','AR_156_Crisol','AR_159_Rio_Cuarto') THEN "Cordoba"
  WHEN warehouses.name IN ('AR_129_San_Luis','AR_177_Mendoza_Las_Heras','AR_181_San_Juan_Centro','AR_39_Mendoza_Godoy','AR_81_Mendoza_Guaymallen') THEN "Cuyo"
  WHEN warehouses.name IN ('AR_131_Ing_Maschwitz','AR_19_Beccar','AR_197_San_Fernando','AR_66_Escobar','AR_8_Nordelta','AR_80_Pacheco') THEN "GBA NorEste"
  WHEN warehouses.name IN ('AR_16_Pilar','AR_182_Munro','AR_20_San _Andres','AR_215_Lujan','AR_220_Villa_Ballester','AR_229_Pilar_II','AR_242_Manuel_Alberti','AR_508_San_Martin') THEN "GBA NorOeste"
  WHEN warehouses.name IN ('AR_13_Caseros','AR_147_Ituzaingo','AR_226_Moreno','AR_180_Hurlingham','AR_187_Merlo','AR_232_San_Justo','AR_29_Ramos_Mejia','AR_67_Castelar','AR_7_San Miguel') THEN "GBA Oeste"
  WHEN warehouses.name IN ('AR_173_Wilde','AR_223_Monte_Grande','AR_4_Avellaneda','AR_54_Quilmes','AR_6_Lanus','AR_65_Lomas') THEN "GBA Sur-Norte"
  WHEN warehouses.name IN ('AR_10_La Plata','AR_134_City_Bell','AR_170_La_Plata_II','AR_209_Florencio_Varela','AR_277_Berazategui') THEN "GBA Sur-Sur"
  WHEN warehouses.name IN ('AR_55_SANTA_FE','AR_57_PARANA','AR_68_Rosario_ll') THEN "LITORAL"
  WHEN warehouses.name IN ('AR_40_Resistencia','AR_63_Corrientes') THEN "NEA"
  WHEN warehouses.name IN ('AR_179_Tucuman Centro II','AR_38_Tucuman','AR_56_SALTA','AR_58_TUCUMAN_YERBA_BUENA') THEN "NOA"
  WHEN warehouses.name IN ('AR_183_Bahia_Blanca_II','AR_23_Mdq_Luro','AR_30_Mdq_Alvarado','AR_41_Bahia_Blanca') THEN "PBA"
  WHEN warehouses.name IN ('AR_210_Neuquen_Este') THEN "Sur"
  ELSE 'LATAM'
  END AS zona,
  fcst.measure,
  fcst.fecha,
  SUM(proyeccion.total_value) AS proyeccion_value,
  SUM(fcst.total_value) AS forecast_value,
  SUM(reales.value) AS real_value,
  CASE 
    WHEN SAFE_DIVIDE(SUM(reales.value), SUM(fcst.total_value)) IS NULL THEN 'Sin datos'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(fcst.total_value), SUM(fcst.total_value))) <<= 0.10 THEN '±10%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(fcst.total_value), SUM(fcst.total_value))) <<= 0.25 THEN '±25%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(fcst.total_value), SUM(fcst.total_value))) <<= 0.50 THEN '±50%'
    ELSE '±50% o más'
  END AS clasificacion_desvio_orquest,
    CASE 
    WHEN SAFE_DIVIDE(SUM(reales.value), SUM(proyeccion.total_value)) IS NULL THEN 'Sin datos'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(proyeccion.total_value), SUM(proyeccion.total_value))) <<= 0.10 THEN '±10%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(proyeccion.total_value), SUM(proyeccion.total_value))) <<= 0.25 THEN '±25%'
    WHEN ABS(SAFE_DIVIDE(SUM(reales.value) - SUM(proyeccion.total_value), SUM(proyeccion.total_value))) <<= 0.50 THEN '±50%'
    ELSE '±50% o más'
  END AS clasificacion_desvio_manual

FROM forecast fcst

LEFT JOIN warehouses
  ON fcst.service_id = warehouses.warehouse_id

LEFT JOIN proyeccion
  ON fcst.service_id = proyeccion.service_id
  AND fcst.measure = proyeccion.measure
  AND fcst.fecha = proyeccion.fecha
  AND fcst.hora = proyeccion.hora

LEFT JOIN reales
  ON fcst.service_id = reales.product_id
  AND fcst.measure = reales.measure
  AND DATE(reales.date_ls) = fcst.fecha
  AND EXTRACT(HOUR FROM reales.date_ls) = fcst.hora


GROUP BY  fcst.business_id,  fcst.service_id,  fcst.fecha, warehouses.name, fcst.measure
ORDER BY  fcst.business_id,  fcst.service_id,  fcst.fecha]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='horas v3' inline='true' name='federated.0m7qg2g0v8zo511doecxy1bve60a' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17qsepw0gxk1b2113oc0m0pkgtj6'>
            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_orquest' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17qsepw0gxk1b2113oc0m0pkgtj6' name='Consulta SQL personalizada' type='text'><![CDATA[WITH maestro AS (
      WITH tiendas_activas AS (

      SELECT DISTINCT 
        country_code,
        warehouse_id

      FROM `peya-data-origins-pro.cl_dmarts.qc_orders`

      WHERE is_dmart IS TRUE
      AND DATE(order_created_date_lt) 
      BETWEEN current_date()-30 AND current_date()

      ORDER BY 1,2

    ),

    warehouses AS (

    SELECT
      warehouse_id,
      name
    FROM `peya-data-origins-pro.cl_qcommerce.warehouses_v2`

    )

    SELECT
      t.country_code,
      wh.name,
      t.warehouse_id,
      CASE
      WHEN wh.name IN ('AR_12_ParqueAvellaneda','AR_138_Villa_Ortuzar','AR_153_Nunez','AR_199_Mataderos','AR_3_Belgrano','AR_42_Villa_del_Parque') THEN "CABA Norte"
      WHEN wh.name IN ('AR_126_Parque_Patricios','AR_141_Barracas','AR_2_Boedo','AR_235_Barrio_Norte','AR_507_Villa_Crespo','AR_9_Microcentro') THEN "CABA Sur"
      WHEN wh.name IN ('AR_14_Cordillera','AR_15_25deMayo','AR_156_Crisol','AR_159_Rio_Cuarto') THEN "Cordoba"
      WHEN wh.name IN ('AR_129_San_Luis','AR_177_Mendoza_Las_Heras','AR_181_San_Juan_Centro','AR_39_Mendoza_Godoy','AR_81_Mendoza_Guaymallen') THEN "Cuyo"
      WHEN wh.name IN ('AR_131_Ing_Maschwitz','AR_19_Beccar','AR_197_San_Fernando','AR_66_Escobar','AR_8_Nordelta','AR_80_Pacheco') THEN "GBA NorEste"
      WHEN wh.name IN ('AR_16_Pilar','AR_182_Munro','AR_20_San _Andres','AR_215_Lujan','AR_220_Villa_Ballester','AR_229_Pilar_II','AR_242_Manuel_Alberti','AR_508_San_Martin') THEN "GBA NorOeste"
      WHEN wh.name IN ('AR_13_Caseros','AR_147_Ituzaingo','AR_226_Moreno','AR_180_Hurlingham','AR_187_Merlo','AR_232_San_Justo','AR_29_Ramos_Mejia','AR_67_Castelar','AR_7_San Miguel','AR_510_Ramos_Mejia_II') THEN "GBA Oeste"
      WHEN wh.name IN ('AR_173_Wilde','AR_223_Monte_Grande','AR_4_Avellaneda','AR_54_Quilmes','AR_6_Lanus','AR_65_Lomas') THEN "GBA Sur-Norte"
      WHEN wh.name IN ('AR_10_La Plata','AR_134_City_Bell','AR_170_La_Plata_II','AR_209_Florencio_Varela','AR_277_Berazategui') THEN "GBA Sur-Sur"
      WHEN wh.name IN ('AR_55_SANTA_FE','AR_57_Parana','AR_68_Rosario_ll') THEN "LITORAL"
      WHEN wh.name IN ('AR_40_Resistencia','AR_63_Corrientes') THEN "NEA"
      WHEN wh.name IN ('AR_179_Tucuman Centro II','AR_38_Tucuman','AR_56_SALTA','AR_58_TUCUMAN_YERBA_BUENA') THEN "NOA"
      WHEN wh.name IN ('AR_183_Bahia_Blanca_II','AR_23_Mdq_Luro','AR_30_Mdq_Alvarado','AR_41_Bahia_Blanca') THEN "PBA"
      WHEN wh.name IN ('AR_210_Neuquen_Este') THEN "Sur"
      ELSE 'LATAM'
      END AS zona

    FROM tiendas_activas t

    LEFT JOIN warehouses wh
    ON wh.warehouse_id = t.warehouse_id
),  
  
  
  fichajes_reales AS (
    SELECT DISTINCT
      service_id,
      type,
      employee_id,
      check_in,
      check_out,
      (TIMESTAMP_DIFF(check_out, check_in, MINUTE)) / 60.0 AS T_real,
      DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS fecha_check_in,
      FORMAT_DATETIME('%H:%M', DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS hora_check_in,
      DATE(DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS fecha_check_out,
      FORMAT_DATETIME('%H:%M', DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS hora_check_out
    FROM peya-data-origins-pro.cl_orquest.clockguards_by_service 

    WHERE NOT REGEXP_CONTAINS(service_id, r'^\d{6}$')
    AND type = "WORK"
    --AND service_id = "AR_210_Neuquen_Este"
    --AND DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) = "2025-08-11"

    --QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id  ORDER BY check_in asc) = 1  
  ),

  fichajes_reales_consolidados AS(
    SELECT
    service_id,
    fecha_check_in,
    SUM(T_real) AS T_real,

    FROM fichajes_reales

    WHERE type = "WORK"

    GROUP BY 1,2

    ORDER BY 1,2 DESC

  ),
 
  fichajes_planificados AS (
    WITH tramos_desanidados AS (
      SELECT
        service_id,
        employee_orquest_id AS person,
        DATE(day) AS fecha,
        tf.start_minute_day,
        tf.minute_duration,
        tf.location.name AS tarea
      FROM `peya-data-origins-pro.cl_orquest.assignments_by_service`,
      UNNEST(presence.time_frames) AS tf
      WHERE minute_duration << 720
      AND employee_orquest_id LIKE "20__-__-____"
      --AND DATE(day) IN ("2025-08-11","2025-08-12","2025-08-13","2025-08-14","2025-08-15","2025-08-16","2025-08-17")
      --AND service_id = "AR_210_Neuquen_Este"

    ),

    tramos_unicos AS (
      SELECT DISTINCT
        service_id,
        person,
        fecha,
        start_minute_day,
        minute_duration,
        tarea
      FROM tramos_desanidados
    )

    SELECT
      person,
      CONCAT('W', FORMAT_DATE('%V',fecha)) AS week,
      fecha AS day,
      service_id,
      CASE WHEN tarea IS NULL THEN "Descanso" ELSE tarea END AS tarea,
      SUM(minute_duration) AS minute_duration,
    FROM tramos_unicos

    --WHERE service_id = "AR_210_Neuquen_Este"
    --AND fecha = "2025-08-18"
    --AND person = "2024-05-0726"

    GROUP BY 1,2,3,4,5 
  ),

  calculo_horas_reales_plan AS (
    SELECT
      --fr.type,
      fp.service_id AS tienda,
      DATE(fp.day) AS fecha,
      fp.week AS semana,
      fp.tarea,
      SUM(fp.minute_duration / 60.0) AS T_plan,
      
    FROM fichajes_planificados fp
    
    -- LEFT JOIN fichajes_reales fr
    -- ON fr.employee_id = fp.person 
    -- AND fr.fecha_check_in = fp.day
    
    --WHERE fp.week = "W33"
    --AND fp.service_id = "AR_210_Neuquen_Este"

    GROUP BY 1, 2, 3, 4--,5
  ),

  calculo_horas_necesarias AS (

    SELECT
      business_id,
      service_name,
      fecha,
      location,
      SUM(
        CASE 
          WHEN tipo_tarea = "FIJA" THEN (valor_fija_variable * 15) / 60
          WHEN tipo_tarea = "LIQUIDA" THEN valor_liquida / 60
          WHEN tipo_tarea = "VARIABLE" THEN (valor_fija_variable * 15) / 60
        END
      ) AS horas_necesarias
    FROM (
      SELECT
        DATE(summary_at) AS fecha,
        business_id,
        service_name,
        location,
        CASE
          WHEN location IN ("Recepción no variable") THEN "FIJA"
          WHEN location IN ("Putaway") 
            OR location LIKE "%Recepción%" 
            OR location LIKE "%Picking%" THEN "VARIABLE"
          WHEN location IN (
            "Ajuste de bolsas","Calibración de Termómetros", "Carga de Facturas", "Carga de Facturas + PNC", "Conteos cíclicos",
            "Control de Frescos y ultra frescos AM", "Control de Frescos y ultra frescos PM", "Control de expirados",
            "Control de temperatura", "Control de temperatura AM", "Control de temperatura PM",
            "Despacho de órdenes AM", "Despacho de órdenes PM", "Gestión de Merma","Limpieza", "Limpieza Piso de tienda",
            "Limpieza de freezers y heladeras", "Limpieza y organización general", "Merma PM",
            "Reposición de mercaderia", "Reposición de mercaderia AM", "Reposición de mercaderia PM",
            "Revisión de SKUs para promos (Comercial)", "Toma de temperaturas"
          ) THEN "LIQUIDA"
          ELSE "FIJA"
        END AS tipo_tarea,
        ANY_VALUE(ts.applied) AS valor_liquida,
        SUM(ts.applied) AS valor_fija_variable
      FROM
        `peya-data-origins-pro.cl_orquest.needs_by_service`,
        UNNEST(time_slots) AS ts
      WHERE
        NOT REGEXP_CONTAINS(service_name, r'^\d{6}$')
        --AND service_name = "AR_210_Neuquen_Este"
        --AND summary_at = "2025-08-18"
        --AND person = "2024-05-0726"
        
      GROUP BY
        fecha, business_id, service_name, location
    ) sub
    GROUP BY 1, 2, 3, 4

  )

SELECT 
  --a.type,
  b.business_id,
  m.zona,
  b.service_name,
  b.fecha,
  CONCAT('W', FORMAT_DATE('%V',b.fecha)) AS week,
  b.location,
  a.T_plan,
  b.horas_necesarias,
  frc.T_real
  
FROM calculo_horas_necesarias b 
LEFT JOIN calculo_horas_reales_plan a
  ON a.tienda = b.service_name 
  AND a.fecha = b.fecha
  AND a.tarea = b.location
LEFT JOIN fichajes_reales_consolidados frc
ON b.service_name = frc.service_id
AND frc.fecha_check_in = b.fecha
LEFT JOIN maestro m
ON m.name = b.service_name
--WHERE b.service_name  = "AR_210_Neuquen_Este"
--AND b.fecha = "2025-08-11"]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.17qsepw0gxk1b2113oc0m0pkgtj6' name='Consulta SQL personalizada' type='text'><![CDATA[WITH maestro AS (
      WITH tiendas_activas AS (

      SELECT DISTINCT 
        country_code,
        warehouse_id

      FROM `peya-data-origins-pro.cl_dmarts.qc_orders`

      WHERE is_dmart IS TRUE
      AND DATE(order_created_date_lt) 
      BETWEEN current_date()-30 AND current_date()

      ORDER BY 1,2

    ),

    warehouses AS (

    SELECT
      warehouse_id,
      name
    FROM `peya-data-origins-pro.cl_qcommerce.warehouses_v2`

    )

    SELECT
      t.country_code,
      wh.name,
      t.warehouse_id,
      CASE
      WHEN wh.name IN ('AR_12_ParqueAvellaneda','AR_138_Villa_Ortuzar','AR_153_Nunez','AR_199_Mataderos','AR_3_Belgrano','AR_42_Villa_del_Parque') THEN "CABA Norte"
      WHEN wh.name IN ('AR_126_Parque_Patricios','AR_141_Barracas','AR_2_Boedo','AR_235_Barrio_Norte','AR_507_Villa_Crespo','AR_9_Microcentro') THEN "CABA Sur"
      WHEN wh.name IN ('AR_14_Cordillera','AR_15_25deMayo','AR_156_Crisol','AR_159_Rio_Cuarto') THEN "Cordoba"
      WHEN wh.name IN ('AR_129_San_Luis','AR_177_Mendoza_Las_Heras','AR_181_San_Juan_Centro','AR_39_Mendoza_Godoy','AR_81_Mendoza_Guaymallen') THEN "Cuyo"
      WHEN wh.name IN ('AR_131_Ing_Maschwitz','AR_19_Beccar','AR_197_San_Fernando','AR_66_Escobar','AR_8_Nordelta','AR_80_Pacheco') THEN "GBA NorEste"
      WHEN wh.name IN ('AR_16_Pilar','AR_182_Munro','AR_20_San _Andres','AR_215_Lujan','AR_220_Villa_Ballester','AR_229_Pilar_II','AR_242_Manuel_Alberti','AR_508_San_Martin') THEN "GBA NorOeste"
      WHEN wh.name IN ('AR_13_Caseros','AR_147_Ituzaingo','AR_226_Moreno','AR_180_Hurlingham','AR_187_Merlo','AR_232_San_Justo','AR_29_Ramos_Mejia','AR_67_Castelar','AR_7_San Miguel','AR_510_Ramos_Mejia_II') THEN "GBA Oeste"
      WHEN wh.name IN ('AR_173_Wilde','AR_223_Monte_Grande','AR_4_Avellaneda','AR_54_Quilmes','AR_6_Lanus','AR_65_Lomas') THEN "GBA Sur-Norte"
      WHEN wh.name IN ('AR_10_La Plata','AR_134_City_Bell','AR_170_La_Plata_II','AR_209_Florencio_Varela','AR_277_Berazategui') THEN "GBA Sur-Sur"
      WHEN wh.name IN ('AR_55_SANTA_FE','AR_57_Parana','AR_68_Rosario_ll') THEN "LITORAL"
      WHEN wh.name IN ('AR_40_Resistencia','AR_63_Corrientes') THEN "NEA"
      WHEN wh.name IN ('AR_179_Tucuman Centro II','AR_38_Tucuman','AR_56_SALTA','AR_58_TUCUMAN_YERBA_BUENA') THEN "NOA"
      WHEN wh.name IN ('AR_183_Bahia_Blanca_II','AR_23_Mdq_Luro','AR_30_Mdq_Alvarado','AR_41_Bahia_Blanca') THEN "PBA"
      WHEN wh.name IN ('AR_210_Neuquen_Este') THEN "Sur"
      ELSE 'LATAM'
      END AS zona

    FROM tiendas_activas t

    LEFT JOIN warehouses wh
    ON wh.warehouse_id = t.warehouse_id
),  
  
  
  fichajes_reales AS (
    SELECT DISTINCT
      service_id,
      type,
      employee_id,
      check_in,
      check_out,
      (TIMESTAMP_DIFF(check_out, check_in, MINUTE)) / 60.0 AS T_real,
      DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS fecha_check_in,
      FORMAT_DATETIME('%H:%M', DATETIME(check_in, "America/Argentina/Buenos_Aires")) AS hora_check_in,
      DATE(DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS fecha_check_out,
      FORMAT_DATETIME('%H:%M', DATETIME(check_out, "America/Argentina/Buenos_Aires")) AS hora_check_out
    FROM peya-data-origins-pro.cl_orquest.clockguards_by_service 

    WHERE NOT REGEXP_CONTAINS(service_id, r'^\d{6}$')
    AND type = "WORK"
    --AND service_id = "AR_210_Neuquen_Este"
    --AND DATE(DATETIME(check_in, "America/Argentina/Buenos_Aires")) = "2025-08-11"

    --QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id  ORDER BY check_in asc) = 1  
  ),

  fichajes_reales_consolidados AS(
    SELECT
    service_id,
    fecha_check_in,
    SUM(T_real) AS T_real,

    FROM fichajes_reales

    WHERE type = "WORK"

    GROUP BY 1,2

    ORDER BY 1,2 DESC

  ),
 
  fichajes_planificados AS (
    WITH tramos_desanidados AS (
      SELECT
        service_id,
        employee_orquest_id AS person,
        DATE(day) AS fecha,
        tf.start_minute_day,
        tf.minute_duration,
        tf.location.name AS tarea
      FROM `peya-data-origins-pro.cl_orquest.assignments_by_service`,
      UNNEST(presence.time_frames) AS tf
      WHERE minute_duration << 720
      AND employee_orquest_id LIKE "20__-__-____"
      --AND DATE(day) IN ("2025-08-11","2025-08-12","2025-08-13","2025-08-14","2025-08-15","2025-08-16","2025-08-17")
      --AND service_id = "AR_210_Neuquen_Este"

    ),

    tramos_unicos AS (
      SELECT DISTINCT
        service_id,
        person,
        fecha,
        start_minute_day,
        minute_duration,
        tarea
      FROM tramos_desanidados
    )

    SELECT
      person,
      CONCAT('W', FORMAT_DATE('%V',fecha)) AS week,
      fecha AS day,
      service_id,
      CASE WHEN tarea IS NULL THEN "Descanso" ELSE tarea END AS tarea,
      SUM(minute_duration) AS minute_duration,
    FROM tramos_unicos

    --WHERE service_id = "AR_210_Neuquen_Este"
    --AND fecha = "2025-08-18"
    --AND person = "2024-05-0726"

    GROUP BY 1,2,3,4,5 
  ),

  calculo_horas_reales_plan AS (
    SELECT
      --fr.type,
      fp.service_id AS tienda,
      DATE(fp.day) AS fecha,
      fp.week AS semana,
      fp.tarea,
      SUM(fp.minute_duration / 60.0) AS T_plan,
      
    FROM fichajes_planificados fp
    
    -- LEFT JOIN fichajes_reales fr
    -- ON fr.employee_id = fp.person 
    -- AND fr.fecha_check_in = fp.day
    
    --WHERE fp.week = "W33"
    --AND fp.service_id = "AR_210_Neuquen_Este"

    GROUP BY 1, 2, 3, 4--,5
  ),

  calculo_horas_necesarias AS (

    SELECT
      business_id,
      service_name,
      fecha,
      location,
      SUM(
        CASE 
          WHEN tipo_tarea = "FIJA" THEN (valor_fija_variable * 15) / 60
          WHEN tipo_tarea = "LIQUIDA" THEN valor_liquida / 60
          WHEN tipo_tarea = "VARIABLE" THEN (valor_fija_variable * 15) / 60
        END
      ) AS horas_necesarias
    FROM (
      SELECT
        DATE(summary_at) AS fecha,
        business_id,
        service_name,
        location,
        CASE
          WHEN location IN ("Recepción no variable") THEN "FIJA"
          WHEN location IN ("Putaway") 
            OR location LIKE "%Recepción%" 
            OR location LIKE "%Picking%" THEN "VARIABLE"
          WHEN location IN (
            "Ajuste de bolsas","Calibración de Termómetros", "Carga de Facturas", "Carga de Facturas + PNC", "Conteos cíclicos",
            "Control de Frescos y ultra frescos AM", "Control de Frescos y ultra frescos PM", "Control de expirados",
            "Control de temperatura", "Control de temperatura AM", "Control de temperatura PM",
            "Despacho de órdenes AM", "Despacho de órdenes PM", "Gestión de Merma","Limpieza", "Limpieza Piso de tienda",
            "Limpieza de freezers y heladeras", "Limpieza y organización general", "Merma PM",
            "Reposición de mercaderia", "Reposición de mercaderia AM", "Reposición de mercaderia PM",
            "Revisión de SKUs para promos (Comercial)", "Toma de temperaturas"
          ) THEN "LIQUIDA"
          ELSE "FIJA"
        END AS tipo_tarea,
        ANY_VALUE(ts.applied) AS valor_liquida,
        SUM(ts.applied) AS valor_fija_variable
      FROM
        `peya-data-origins-pro.cl_orquest.needs_by_service`,
        UNNEST(time_slots) AS ts
      WHERE
        NOT REGEXP_CONTAINS(service_name, r'^\d{6}$')
        --AND service_name = "AR_210_Neuquen_Este"
        --AND summary_at = "2025-08-18"
        --AND person = "2024-05-0726"
        
      GROUP BY
        fecha, business_id, service_name, location
    ) sub
    GROUP BY 1, 2, 3, 4

  )

SELECT 
  --a.type,
  b.business_id,
  m.zona,
  b.service_name,
  b.fecha,
  CONCAT('W', FORMAT_DATE('%V',b.fecha)) AS week,
  b.location,
  a.T_plan,
  b.horas_necesarias,
  frc.T_real
  
FROM calculo_horas_necesarias b 
LEFT JOIN calculo_horas_reales_plan a
  ON a.tienda = b.service_name 
  AND a.fecha = b.fecha
  AND a.tarea = b.location
LEFT JOIN fichajes_reales_consolidados frc
ON b.service_name = frc.service_id
AND frc.fecha_check_in = b.fecha
LEFT JOIN maestro m
ON m.name = b.service_name
--WHERE b.service_name  = "AR_210_Neuquen_Este"
--AND b.fecha = "2025-08-11"]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
