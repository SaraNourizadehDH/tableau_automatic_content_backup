  WHEN warehouses.name IN ('AR_126_Parque_Patricios','AR_141_Barracas','AR_2_Boedo','AR_235_Barrio_Norte','AR_507_Villa_Crespo','AR_9_Microcentro') THEN "CABA Sur"
  WHEN warehouses.name IN ('AR_14_Cordillera','AR_15_25deMayo','AR_156_Crisol','AR_159_Rio_Cuarto') THEN "Cordoba"
  WHEN warehouses.name IN ('AR_129_San_Luis','AR_177_Mendoza_Las_Heras','AR_181_San_Juan_Centro','AR_39_Mendoza_Godoy','AR_81_Mendoza_Guaymallen') THEN "Cuyo"
  WHEN warehouses.name IN ('AR_131_Ing_Maschwitz','AR_19_Beccar','AR_197_San_Fernando','AR_66_Escobar','AR_8_Nordelta','AR_80_Pacheco') THEN "GBA NorEste"
  WHEN warehouses.name IN ('AR_16_Pilar','AR_182_Munro','AR_20_San _Andres','AR_215_Lujan','AR_220_Villa_Ballester','AR_229_Pilar_II','AR_242_Manuel_Alberti','AR_508_San_Martin') THEN "GBA NorOeste"
  WHEN warehouses.name IN ('AR_13_Caseros','AR_147_Ituzaingo','AR_226_Moreno','AR_180_Hurlingham','AR_187_Merlo','AR_232_San_Justo','AR_29_Ramos_Mejia','AR_67_Castelar','AR_7_San Miguel') THEN "GBA Oeste"
  WHEN warehouses.name IN ('AR_173_Wilde','AR_223_Monte_Grande','AR_4_Avellaneda','AR_54_Quilmes','AR_6_Lanus','AR_65_Lomas') THEN "GBA Sur-Norte"
  WHEN warehouses.name IN ('AR_10_La Plata','AR_134_City_Bell','AR_170_La_Plata_II','AR_209_Florencio_Varela','AR_277_Berazategui') THEN "GBA Sur-Sur"
  WHEN warehouses.name IN ('AR_55_SANTA_FE','AR_57_PARANA','AR_68_Rosario_ll') THEN "LITORAL"
  WHEN warehouses.name IN ('AR_40_Resistencia','AR_63_Corrientes') THEN "NEA"
  WHEN warehouses.name IN ('AR_179_Tucuman Centro II','AR_38_Tucuman','AR_56_SALTA','AR_58_TUCUMAN_YERBA_BUENA') THEN "NOA"
  WHEN warehouses.name IN ('AR_183_Bahia_Blanca_II','AR_23_Mdq_Luro','AR_30_Mdq_Alvarado','AR_41_Bahia_Blanca') THEN "PBA"
  WHEN warehouses.name IN ('AR_210_Neuquen_Este') THEN "Sur"
