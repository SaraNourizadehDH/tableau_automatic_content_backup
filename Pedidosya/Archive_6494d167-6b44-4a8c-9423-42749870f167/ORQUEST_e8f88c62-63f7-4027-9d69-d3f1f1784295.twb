    <datasource caption='rooster' inline='true' name='federated.1yooneg142hfs61c1xovb0v9ry6f' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1puca9w1uoyz411a50fd71tbf8lt'>
            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_orquest' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1puca9w1uoyz411a50fd71tbf8lt' name='Consulta SQL personalizada' type='text'><![CDATA[WITH TABLA AS (
  SELECT
    employee_orquest_id AS person,
    DATE(day) AS fecha,
    service_id,
    
    tf.start_minute_day,
    tf.minute_duration,

    -- Hora de entrada
    FORMAT(
      '%02d:%02d',
      CAST(FLOOR(tf.start_minute_day / 60) AS INT64),
      CAST(MOD(tf.start_minute_day, 60) AS INT64)
    ) AS hora_entrada,

    -- Hora de salida
    FORMAT(
      '%02d:%02d',
      CAST(FLOOR(MOD(tf.start_minute_day + CAST(tf.minute_duration AS INT64), 1440) / 60) AS INT64),
      CAST(MOD(MOD(tf.start_minute_day + CAST(tf.minute_duration AS INT64), 1440), 60) AS INT64)
    ) AS hora_salida

  FROM `peya-data-origins-pro.cl_orquest.assignments_by_service`,
  UNNEST(presence.time_frames) AS tf

  WHERE business_id IN ("PedidosYa_ARG")
    AND NOT REGEXP_CONTAINS(service_id, r'^\d+$')
    AND tf.start_minute_day <<>> 0
    AND DATE(day) >>= DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY))
    --AND employee_orquest_id = "2022-08-0041"
    --AND day = "2025-07-07"
)

SELECT
  person,
  FORMAT('W%02d', EXTRACT(WEEK(MONDAY) FROM fecha)) AS week,
  fecha AS day,
  service_id,
  MIN(hora_entrada) AS hora_entrada,
  MAX(hora_salida) AS hora_salida
FROM TABLA
--WHERE service_id = "AR_210_Neuquen_Este"
--AND fecha = DATE('2025-07-27')
 

GROUP BY person, day, service_id
HAVING NOT (
  hora_entrada = '06:00' AND hora_salida IN ('23:00', '23:30','00:00')
)
ORDER BY service_id, day, person]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
