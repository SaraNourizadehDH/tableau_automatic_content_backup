    <datasource caption='clockguards' inline='true' name='federated.1yhtb340nfs9ez1b1y26w0yifnd9' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gs44lq12xv4vo17lkauk0owx9ho'>
            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-republica-dominicana' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_orquest' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
