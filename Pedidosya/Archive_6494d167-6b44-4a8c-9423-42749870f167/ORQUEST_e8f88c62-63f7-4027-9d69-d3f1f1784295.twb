    <datasource caption='tareas planificadas' inline='true' name='federated.1j9lfss1rxtpax12tekhu0bthiip' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gfwitm0gv97yj10g5lq71k9ika0'>
            <connection CATALOG='peya-delivery-and-support' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-delivery-and-support' schema='user_agus_cordoba' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
