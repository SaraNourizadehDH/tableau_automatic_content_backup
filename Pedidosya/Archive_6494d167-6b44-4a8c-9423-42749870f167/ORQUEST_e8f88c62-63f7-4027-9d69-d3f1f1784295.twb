            <connection CATALOG='peya-data-origins-pro' EXECCATALOG='peya-delivery-and-support' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='peya-data-origins-pro' schema='cl_dmarts' server-oauth='server-custom' username='agus.cordoba@pedidosya.com' workgroup-auth-mode='prompt' />
