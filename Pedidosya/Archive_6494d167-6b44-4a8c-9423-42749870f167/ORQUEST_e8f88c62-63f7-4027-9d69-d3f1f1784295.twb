          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.076t4q90gvq18l19vypx20wy2xi6' name='Consulta SQL personalizada' type='text'>WITH tiendas_activas AS (&#13;
&#13;
  SELECT DISTINCT &#13;
    country_code,&#13;
    warehouse_id&#13;
  FROM `peya-data-origins-pro.cl_dmarts.qc_orders`&#13;
  WHERE is_dmart IS TRUE&#13;
    AND DATE(order_created_date_lt) BETWEEN CURRENT_DATE() - 30 AND CURRENT_DATE()&#13;
&#13;
),&#13;
&#13;
&#13;
warehouses AS (&#13;
&#13;
SELECT&#13;
  warehouse_id,&#13;
  name&#13;
FROM `peya-data-origins-pro.cl_qcommerce.warehouses_v2`&#13;
&#13;
),&#13;
&#13;
semanas AS (&#13;
  SELECT &#13;
    FORMAT(&apos;W%02d&apos;, semana) AS week&#13;
  FROM UNNEST(GENERATE_ARRAY(1, 52)) AS semana&#13;
)&#13;
&#13;
-- Scaffold final: todas las combinaciones tienda × semana&#13;
SELECT&#13;
  t.country_code,&#13;
  wh.name,&#13;
  t.warehouse_id,&#13;
  s.week&#13;
FROM tiendas_activas t&#13;
CROSS JOIN semanas s&#13;
LEFT JOIN warehouses wh&#13;
ON wh.warehouse_id = t.warehouse_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
