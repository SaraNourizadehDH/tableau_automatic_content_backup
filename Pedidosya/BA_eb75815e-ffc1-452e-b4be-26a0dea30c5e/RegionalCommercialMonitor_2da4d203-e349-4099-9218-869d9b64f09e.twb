    <worksheet name='OKRs Follow-Up'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>OKR Follow-Up</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Base_Sales_Wo/Levels' name='federated.0jdjp9u1weck6q135jw2p102kkku' />
          </datasources>
          <datasource-dependencies datasource='federated.0jdjp9u1weck6q135jw2p102kkku'>
            <column caption='Days month' datatype='datetime' name='[Calculation_450359992833249289]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[order_date]))))' />
            </column>
            <column caption='Run Rate' datatype='real' name='[Calculation_450359992835489802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_orders]/(DAY(TODAY())-1)*(DAY([Calculation_450359992833249289]))' />
            </column>
            <column caption='Avance vs. RR ' datatype='real' name='[Calculation_450359992835801099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_450359992835489802]/[Confirmed orders])-1' />
            </column>
            <column datatype='real' name='[Confirmed orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[order_date]' derivation='Month' name='[mn:order_date:ok]' pivot='key' type='ordinal' />
