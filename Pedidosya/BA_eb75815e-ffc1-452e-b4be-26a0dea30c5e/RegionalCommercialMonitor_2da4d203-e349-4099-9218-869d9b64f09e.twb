    <worksheet name='Summary Euros'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Summary Euros</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Base_Sales_Wo/Levels' name='federated.0jdjp9u1weck6q135jw2p102kkku' />
          </datasources>
          <datasource-dependencies datasource='federated.0jdjp9u1weck6q135jw2p102kkku'>
            <column caption='Net_Sales_EU' datatype='real' name='[Calculation_1389641981536681984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([net_sales_Eur])' />
            </column>
            <column caption='NMR Eur' datatype='real' name='[Calculation_599823205391233025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [dmarts_campaign_type (Consulta SQL personalizada3)] = &apos;NMR (Non Margin Revenue)&apos; &#13;&#10;THEN [total_amount_eur (Consulta SQL personalizada3)] &#13;&#10;END)' />
            </column>
            <column caption='Back Margin Eur' datatype='real' name='[Calculation_599823205393027074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [dmarts_campaign_type (Consulta SQL personalizada3)] = &apos;Back Margin&apos; &#13;&#10;THEN [total_amount_eur (Consulta SQL personalizada3)] &#13;&#10;END)' />
            </column>
            <column caption='NMR % Eur' datatype='real' name='[Calculation_599823205394350083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_599823205391233025]/[Calculation_1389641981536681984]' />
            </column>
            <column caption='Back Margin % Eur' datatype='real' name='[Calculation_599823205394833412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_599823205393027074]/[Calculation_1389641981536681984]' />
            </column>
            <column caption='NMR LC' datatype='real' name='[Calculation_599823205395288069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [dmarts_campaign_type (Consulta SQL personalizada3)] = &apos;NMR (Non Margin Revenue)&apos; &#13;&#10;THEN [total_amount (Consulta SQL personalizada3)]&#13;&#10;END)' />
            </column>
            <column caption='Back Margin LC' datatype='real' name='[Calculation_599823205395431430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [dmarts_campaign_type (Consulta SQL personalizada3)] = &apos;Back Margin&apos; &#13;&#10;THEN [total_amount_eur (Consulta SQL personalizada3)] &#13;&#10;END)' />
            </column>
            <column caption='Warehouse Allowance $' datatype='real' name='[Calculation_611645143182532608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([WA_CALC])' />
            </column>
            <column caption='Warehouse Allowance $ EUR' datatype='real' name='[Calculation_611645143223971852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([WA_CALC]/[rate_eu])' />
            </column>
            <column caption='Warehouse Allowance % EUR' datatype='real' name='[Calculation_611645143224201229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_611645143223971852]/SUM([net_sales_Eur])' />
            </column>
            <column caption='Commercial Margin % LC' datatype='real' name='[Calculation_611645143230492687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_611645143231184912]+&#13;&#10;IFNULL([Calculation_611645143182532608],0)+&#13;&#10;IFNULL([Calculation_599823205395288069],0)+&#13;&#10;IFNULL([Calculation_599823205395431430],0))&#13;&#10;/SUM([net_sales])' />
            </column>
            <column caption='Front Margin LC' datatype='real' name='[Calculation_611645143231184912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([net_sales])-SUM([total_cogs_wo_vat]))' />
            </column>
            <column caption='Avg. Basket Size' datatype='real' name='[Calculation_658088510753808384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_sold])/SUM([total_orders])' />
            </column>
            <column caption='Front Margin EUR' datatype='real' name='[Calculation_658088510755012609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([net_sales_Eur])-SUM([total_cogs_wo_vat_Eur]))' />
            </column>
            <column caption='Theoric Margin' datatype='real' name='[Calculation_658088510773133315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_discount_wo_vat_Eur])+[Calculation_658088510755012609])/(SUM([total_amount_wo_vat_eur]))' />
            </column>
            <column caption='Discounts (%)' datatype='real' name='[Calculation_658088510774939652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_discount_with_vat_Eur])/SUM([total_amount_with_vat_eur])' />
            </column>
            <column caption='Front Margin %' datatype='real' name='[Calculation_658088510780289029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_658088510755012609]/SUM([net_sales_Eur])' />
            </column>
            <column caption='Total Shrinkage EUR' datatype='real' name='[Calculation_658088510782128135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adjustment_value_eur])' />
            </column>
            <column caption='Shrinkage / Net Sales (%) EUR' datatype='real' name='[Calculation_658088510783787016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_658088510782128135]/sum([net_sales_Eur])' />
            </column>
            <column caption='Shrinkage / Net COGS (%) EUR' datatype='real' name='[Calculation_658088510784131081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_658088510782128135]/SUM([total_cogs_wo_vat_Eur])' />
            </column>
            <column datatype='real' name='[WA_CALC]' role='measure' type='quantitative' />
            <column datatype='real' name='[adjustment_value_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[dmarts_campaign_type (Consulta SQL personalizada3)]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='Month' name='[mn:order_date:ok]' pivot='key' type='ordinal' />
            <column datatype='real' name='[net_sales]' role='measure' type='quantitative' />
            <column datatype='real' name='[net_sales_Eur]' role='measure' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[rate_eu]' role='measure' type='quantitative' />
            <column-instance column='[net_sales_Eur]' derivation='Sum' name='[sum:net_sales_Eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_amount_with_vat_eur]' derivation='Sum' name='[sum:total_amount_with_vat_eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_amount_wo_vat_eur]' derivation='Sum' name='[sum:total_amount_wo_vat_eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_cogs_wo_vat_Eur]' derivation='Sum' name='[sum:total_cogs_wo_vat_Eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_discount_with_vat_Eur]' derivation='Sum' name='[sum:total_discount_with_vat_Eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders]' derivation='Sum' name='[sum:total_orders:qk]' pivot='key' type='quantitative' />
