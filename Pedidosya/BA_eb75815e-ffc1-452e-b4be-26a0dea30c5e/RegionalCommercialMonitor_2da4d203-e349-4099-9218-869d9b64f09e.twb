          <object caption='WA' id='_6A67D692892C4852A22907EB95652666'>
            <properties context=''>
              <relation connection='bigquery.12g6q340k6uik210rq2dm00x5pd6' name='Consulta SQL personalizada' type='text'>WITH dim_country AS (&#13;
SELECT &#13;
country_short_name,&#13;
currency_id, &#13;
FROM `peya-bi-tools-pro.il_core.dim_country`&#13;
WHERE active =true),&#13;
exchange AS (&#13;
SELECT &#13;
currency_exchange_date,&#13;
currency_id,&#13;
rate_us,&#13;
rate_eu,&#13;
FROM `peya-bi-tools-pro.il_core.dim_currency_exchange`)&#13;
&#13;
SELECT  &#13;
&#13;
w.country_code,&#13;
supplier_ID AS supplier_id, &#13;
Supplier_name,&#13;
WA_Concept,&#13;
WA_pct,&#13;
WA_CALC,&#13;
w.month,&#13;
w.date, &#13;
exc.rate_eu&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.warehouse_allowance_dmarts_bq` w&#13;
&#13;
LEFT JOIN dim_country AS c &#13;
       ON c.country_short_name = w.country_code &#13;
LEFT JOIN exchange exc &#13;
       ON exc.currency_id= c.currency_id &#13;
       AND DATE_TRUNC(w.date, MONTH) = date_trunc(date(currency_exchange_date),month)&#13;
    &#13;
WHERE w.country_code IS NOT NULL</relation>
            </properties>
            <properties context='extract'>
              <relation name='_6A67D692892C4852A22907EB95652666' table='[Extract].[_6A67D692892C4852A22907EB95652666]' type='table' />
            </properties>
          </object>
          <object caption='Shrinkage' id='_AD86999140CA415983425C2E53D44BC8'>
            <properties context=''>
              <relation connection='bigquery.12g6q340k6uik210rq2dm00x5pd6' name='Consulta SQL personalizada1' type='text'>WITH PIM AS (&#13;
SELECT DISTINCT &#13;
&#13;
sku, &#13;
piece_barcode,&#13;
P.Level_0,&#13;
k.Level_1,&#13;
k.Level_2,&#13;
k.Level_3,&#13;
k.brand_name&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.skus_PIM_Dmart` k&#13;
&#13;
LEFT JOIN `peya-argentina.automated_tables_reports.PIM_Level_0_Bis` P&#13;
    ON p.Level_1 = k.Level_1)&#13;
&#13;
SELECT &#13;
        transaction_date,&#13;
        (CASE WHEN adjustment_reason NOT IN (&apos;Store Expired&apos;, &apos;Store Damaged&apos;, &apos;Supplier Return&apos;) THEN &apos;Expired_Damaged&apos; ELSE &apos;others&apos;END) AS adjustment_reason,&#13;
        country_code,&#13;
        p.Level_0,&#13;
        p.Level_1,&#13;
        p.Level_2,&#13;
        SUM (quantity) AS quantity, &#13;
        ROUND (SUM (adjustment_value_lc)) AS adjustment_value_lc,&#13;
        ROUND (SUM (adjustment_value_eur)) AS adjustment_value_eur&#13;
        &#13;
FROM `peya-datamarts-pro.dm_dmarts.dmarts_stock_adjustments` &#13;
&#13;
LEFT JOIN PIM  p&#13;
        ON p.piece_barcode = barcodes_array&#13;
&#13;
LEFT JOIN `peya-argentina.automated_tables_reports.PIM_Level_0` l&#13;
      ON l.Level_1_Bis = p.Level_1&#13;
&#13;
WHERE transaction_date &gt;&gt;= &quot;2022-01-01&quot;&#13;
        AND adjustment_reason IN (&apos;Store Expired&apos;, &apos;Store Damaged&apos;, &apos;Supplier Return&apos; , &apos;Stock Addition&apos; , &apos;Stock Subtraction&apos; , &apos;OUTGOING&apos; , &apos;INCOMING&apos;)&#13;
        AND adjustment_value_eur IS NOT NULL &#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
ORDER BY 2 DESC, 1 DESC</relation>
            </properties>
            <properties context='extract'>
              <relation name='_AD86999140CA415983425C2E53D44BC8' table='[Extract].[_AD86999140CA415983425C2E53D44BC8]' type='table' />
            </properties>
          </object>
          <object caption='Sales Wo/Vat' id='_BFCC730784234A3DB9CFDFE78206BD15'>
            <properties context=''>
              <relation connection='bigquery.12g6q340k6uik210rq2dm00x5pd6' name='Sales' type='text'>SELECT  &#13;
        o.order_date,&#13;
        o.country_code AS country,&#13;
        COUNT(DISTINCT order_id) AS total_orders,&#13;
        SUM(total_amount_sold_lc) as total_amount_with_vat,&#13;
        SUM(total_amount_sold_net_lc) as total_amount_wo_vat,&#13;
        SUM(vat_amount_lc) as vat_amount,&#13;
        SUM(pcm_discount_amount_lc) as total_discount_with_vat,&#13;
        SUM(pcm_discount_amount_net_lc) as total_discount_wo_vat,&#13;
        SUM(total_amount_net_with_discount) as net_sales,&#13;
        SUM(total_cogs_sold_net_lc) as total_cogs_wo_vat,&#13;
        SUM(pcm_qty_products_applied_discount) as units_with_discount,&#13;
        SUM(fulfilled_quantity) as units_sold,&#13;
        SUM(total_amount_net_with_discount)/COUNT(DISTINCT order_id) AS AFV_wo_VAT,&#13;
        SUM(total_amount_net_with_discount/rate_eu)/COUNT(DISTINCT order_id) AS AFV_wo_VAT_Eur,&#13;
        SUM (total_amount_sold_eur) AS total_amount_with_vat_eur,&#13;
        SUM (vat_eur) as vat_amount_eur,&#13;
        SUM(pcm_discount_amount_lc/rate_eu) as total_discount_with_vat_Eur, &#13;
        SUM(pcm_discount_amount_net_lc/rate_eu) as total_discount_wo_vat_Eur,&#13;
        SUM(total_amount_net_with_discount/rate_eu) as net_sales_Eur, &#13;
        SUM(total_cogs_sold_net_lc/rate_eu) as total_cogs_wo_vat_Eur, &#13;
        SUM (total_amount_sold_net_lc/rate_eu) AS total_amount_wo_vat_eur,    &#13;
&#13;
FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level` o&#13;
&#13;
--LEFT JOIN `peya-data-origins-pro.cl_dmarts.warehouses` s&#13;
     --ON s.platform_vendor_id = o.vendor_id &#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` AS c &#13;
      ON c.country_short_name = o.country_code AND c.active =true AND o.country_code = c.country_short_name&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` exc &#13;
      ON exc.currency_id= c.currency_id and DATE_TRUNC(order_date, MONTH) = date_trunc(date(currency_exchange_date),month)&#13;
&#13;
WHERE order_date &gt;&gt;= &quot;2022-01-01&quot;&#13;
      AND (order_status IN (&apos;sent&apos;, &apos;unknown&apos;) or order_status IS NULL)&#13;
&#13;
GROUP BY 1,2&#13;
ORDER BY 2 DESC,1 DESC</relation>
            </properties>
            <properties context='extract'>
              <relation name='_BFCC730784234A3DB9CFDFE78206BD15' table='[Extract].[_BFCC730784234A3DB9CFDFE78206BD15]' type='table' />
            </properties>
          </object>
          <object caption='NMR &amp; BM (TK)' id='_E0C3DD7596304D969707621541B9B38D'>
            <properties context=''>
              <relation connection='bigquery.12g6q340k6uik210rq2dm00x5pd6' name='Consulta SQL personalizada3' type='text'>WITH ticketera_Dmarts AS(&#13;
&#13;
SELECT &#13;
*&#13;
FROM `peya-bi-tools-pro.il_ncr.dim_partnership_non_revenue`&#13;
&#13;
WHERE summary IN (&apos;DMarts&apos;)&#13;
&#13;
), &#13;
&#13;
ticketera_partnership_dmarts AS(&#13;
&#13;
SELECT &#13;
*&#13;
FROM `peya-bi-tools-pro.il_ncr.dim_partnership_non_revenue`&#13;
&#13;
WHERE intercompany = &apos;Dmarts&apos;&#13;
    AND summary IN (&apos;Partnership&apos;)&#13;
),&#13;
&#13;
ticketera_final AS (&#13;
&#13;
SELECT * FROM ticketera_Dmarts&#13;
UNION ALL &#13;
SELECT * FROM ticketera_partnership_dmarts)&#13;
&#13;
SELECT&#13;
&#13;
tf.country_name, &#13;
CASE WHEN tf.country_name = &apos;Rep. Dominicana&apos; THEN &apos;do&apos; ELSE dm.country_short_name END as country,&#13;
DATE_TRUNC (end_date,MONTH) AS fecha,&#13;
EXTRACT (MONTH FROM end_date) AS Mes, &#13;
dmarts_tools,&#13;
CASE WHEN dmarts_campaign_type IS NULL THEN &apos;NMR (Non Margin Revenue)&apos; ELSE dmarts_campaign_type END AS dmarts_campaign_type,&#13;
SUM (total_amount) as total_amount,&#13;
SUM (total_amount_eur) AS total_amount_eur,&#13;
&#13;
FROM ticketera_final tf&#13;
&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_country` dm&#13;
    ON tf.country_name = dm.country_name&#13;
&#13;
WHERE end_date &gt;&gt; &apos;2022-01-01&apos;&#13;
&#13;
GROUP BY 1,2,3,4,5,6&#13;
ORDER BY 1,3 DESC</relation>
            </properties>
            <properties context='extract'>
              <relation name='_E0C3DD7596304D969707621541B9B38D' table='[Extract].[_E0C3DD7596304D969707621541B9B38D]' type='table' />
            </properties>
          </object>
        </objects>
