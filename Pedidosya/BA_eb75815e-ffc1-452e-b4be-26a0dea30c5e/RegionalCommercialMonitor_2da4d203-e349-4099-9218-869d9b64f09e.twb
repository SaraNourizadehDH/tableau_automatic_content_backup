            <column-instance column='[Calculation_450359992835801099]' derivation='Sum' name='[sum:Calculation_450359992835801099:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Confirmed orders]' derivation='Sum' name='[sum:Confirmed orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders]' derivation='Sum' name='[sum:total_orders:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0jdjp9u1weck6q135jw2p102kkku].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0jdjp9u1weck6q135jw2p102kkku].[sum:Confirmed orders:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0jdjp9u1weck6q135jw2p102kkku].[sum:total_orders:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0jdjp9u1weck6q135jw2p102kkku].[sum:Calculation_450359992835489802:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0jdjp9u1weck6q135jw2p102kkku].[sum:Calculation_450359992835801099:qk]&quot;' />
