    <datasource caption='Consulta SQL personalizada (automated_tables_reports)' inline='true' name='federated.1p13w3v0qryl640zqr1g00vk23ky' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0787to01u56se314t2y4k0gc1xwn'>
            <connection CATALOG='peya-argentina' EXECCATALOG='peya-argentina' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-argentina' schema='automated_tables_reports' server-oauth='server-custom' username='santiago.carreras@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0787to01u56se314t2y4k0gc1xwn' name='Consulta SQL personalizada' type='text'>WITH PIM AS (&#13;
SELECT DISTINCT &#13;
&#13;
sku, &#13;
piece_barcode,&#13;
P.Level_0,&#13;
k.Level_1,&#13;
k.Level_2,&#13;
k.Level_3,&#13;
k.brand_name&#13;
&#13;
FROM `peya-food-and-groceries.automated_tables_reports.skus_PIM_Dmart` k&#13;
&#13;
LEFT JOIN `peya-argentina.automated_tables_reports.PIM_Level_0_Bis` P&#13;
    ON p.Level_1 = k.Level_1)&#13;
&#13;
SELECT  &#13;
        EXTRACT (ISOWEEK FROM order_date) AS week,&#13;
        EXTRACT (MONTH FROM order_date) AS month,&#13;
        EXTRACT (YEAR FROM order_date) AS year,&#13;
        s.country_code AS country,&#13;
        --p.product_type AS Level_0,&#13;
        p.Level_0,&#13;
        p.Level_1,&#13;
        p.Level_2,&#13;
        COUNT(DISTINCT order_id) AS total_orders,&#13;
        SUM(total_amount_sold_lc) as total_amount_with_vat,&#13;
        SUM(total_amount_sold_net_lc) as total_amount_wo_vat, &#13;
        SUM(vat_amount_lc) as vat_amount, &#13;
        SUM(pcm_discount_amount_lc) as total_discount_with_vat, &#13;
        SUM(pcm_discount_amount_net_lc) as total_discount_wo_vat, &#13;
        SUM(total_amount_net_with_discount) as net_sales, &#13;
        SUM(total_cogs_sold_net_lc) as total_cogs_wo_vat, &#13;
        SUM(pcm_qty_products_applied_discount) as units_with_discount,&#13;
        SUM(total_amount_net_with_discount)/COUNT(DISTINCT order_id) AS AFV_wo_VAT,&#13;
        SUM(fulfilled_quantity) as units_sold, &#13;
        SUM(fulfilled_quantity)/COUNT(DISTINCT order_id) as Basket_Size,&#13;
        SUM (total_amount_sold_eur) AS total_amount_with_vat_eur,&#13;
        SUM (vat_eur) as vat_amount_eur,&#13;
        SUM(pcm_discount_amount_lc/rate_eu) as total_discount_with_vat_Eur, &#13;
        SUM(pcm_discount_amount_net_lc/rate_eu) as total_discount_wo_vat_Eur,&#13;
        SUM(total_amount_net_with_discount/rate_eu) as net_sales_Eur, &#13;
        SUM(total_cogs_sold_net_lc/rate_eu) as total_cogs_wo_vat_Eur, &#13;
                        &#13;
FROM `peya-datamarts-pro.dm_dmarts.dmarts_customer_orders_sku_level` o&#13;
&#13;
LEFT JOIN `peya-food-and-groceries.automated_tables_reports.Maestro_SKUs` i&#13;
    ON o.sku_id = i.sku&#13;
&#13;
LEFT JOIN `peya-data-origins-stg.cl_gcc_service.dmarts_warehouses` s&#13;
    ON s.platform_vendor_id = o.vendor_id&#13;
&#13;
LEFT JOIN PIM  p&#13;
      ON p.piece_barcode = o.barcode&#13;
&#13;
LEFT JOIN `peya-argentina.automated_tables_reports.PIM_Level_0` l&#13;
      ON l.Level_1_Bis = p.Level_1&#13;
&#13;
INNER JOIN `peya-bi-tools-pro.il_core.dim_country` AS c &#13;
      ON c.country_short_name = s.country_code AND c.active =true AND o.country_code = c.country_short_name&#13;
LEFT JOIN `peya-bi-tools-pro.il_core.dim_currency_exchange` exc &#13;
      ON exc.currency_id= c.currency_id and DATE_TRUNC(order_date, MONTH) = date_trunc(date(currency_exchange_date),month)&#13;
&#13;
WHERE order_date &gt;&gt;= &quot;2022-01-01&quot;&#13;
      --AND s.country_code = &apos;pe&apos;&#13;
      AND (order_status IN (&apos;sent&apos;, &apos;unknown&apos;) or order_status IS NULL)&#13;
      AND s.is_dmart = true&#13;
            &#13;
GROUP BY 1,2,3,4,5,6,7&#13;
ORDER BY 2 DESC,1 DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0787to01u56se314t2y4k0gc1xwn' name='Consulta SQL personalizada' type='text'>WITH PIM AS (&#13;
