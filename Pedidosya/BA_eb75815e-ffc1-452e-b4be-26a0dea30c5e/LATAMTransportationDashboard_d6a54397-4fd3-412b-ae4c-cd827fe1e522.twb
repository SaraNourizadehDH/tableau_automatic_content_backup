          <object caption='CMT_TABLE' id='_3CA25AC3E632474189AAB6769C95B077'>
            <properties context=''>
              <relation connection='bigquery.0e2tirj1t0t19g19534d80g4nied' name='Consulta SQL personalizada' type='text'>SELECT &#13;
country_code,&#13;
source_warehouse,&#13;
cast(DATE_TRUNC(completed_at_utc,DAY) AS DATE) date,&#13;
sum(source_sku_wac_lc*received_qty) cmt&#13;
 FROM `peya-datamarts-pro.dm_dmarts.dmarts_store_transfers` &#13;
 WHERE&#13;
 DATE_TRUNC(completed_at_utc,month) &gt;&gt;= &quot;2022-03-01&quot;&#13;
  AND transfer_status= &apos;COMPLETED&apos; and sku_id NOT IN (&quot;56624216&quot;,&quot;49904139&quot;,&quot;49904140&quot;,&quot;KOXQP3&quot;,&quot;53533659&quot;,&quot;56624215&quot;,&quot;62223987&quot;,&quot;49904137&quot;,&quot;54031444&quot;,&quot;54031442&quot;,&quot;54031446&quot;,&quot;54031445&quot;,&quot;54031449&quot;,&quot;54031447&quot;,&quot;54031451&quot;,&quot;KOXQP3&quot;,&quot;41O4GH&quot;,&quot;56624216&quot;)&#13;
  GROUP BY 1,2,3&#13;
  order by cmt desc</relation>
            </properties>
