          <relation connection='bigquery.05pnksa147y1fd1aeza601tnduag' name='Consulta SQL personalizada2' type='text'>with &#13;
dates as(&#13;
with &#13;
days as(&#13;
SELECT day&#13;
FROM UNNEST(&#13;
    GENERATE_DATE_ARRAY(DATE(&apos;2022-01-01&apos;), CURRENT_DATE(), INTERVAL 1 DAY)&#13;
) as day&#13;
)&#13;
&#13;
SELECT &#13;
day as day,&#13;
DATE_TRUNC(days.day, MONTH) as first_day&#13;
from days&#13;
),&#13;
&#13;
country_currency as (&#13;
  SELECT DISTINCT country_name,&#13;
if(country_name = &quot;Argentina&quot;, &quot;ar&quot;,if(country_name = &quot;Bolivia&quot;, &quot;bo&quot;,if(country_name = &quot;Chile&quot;,&quot;cl&quot;,if(country_name = &quot;Costa Rica&quot;, &quot;cr&quot;,if(country_name = &quot;República Dominicana&quot;,&quot;do&quot;, if(country_name=&quot;Ecuador&quot;, &quot;ec&quot;,if(country_name = &quot;Guatemala&quot;, &quot;gt&quot;, if(country_name= &quot;Honduras&quot;, &quot;hn&quot;, if(country_name = &quot;Nicaragua&quot;, &quot;ni&quot;, if(country_name = &quot;Panamá&quot;, &quot;pa&quot;, if(country_name = &quot;Perú&quot;, &quot;pe&quot;, if(country_name=&quot;Paraguay&quot;, &quot;py&quot;, if(country_name = &quot;Uruguay&quot;, &quot;uy&quot;,NUll))))))))))))) as country_code,&#13;
currency_iso&#13;
from `peya-food-and-groceries.automated_tables_reports.fx`&#13;
),&#13;
&#13;
rates as(&#13;
SELECT&#13;
  currency_exchange_date,&#13;
  currency_iso,&#13;
  currency_name,&#13;
  rate_eu&#13;
FROM&#13;
  `peya-bi-tools-pro.il_core.dim_currency_exchange`&#13;
WHERE&#13;
  currency_exchange_date &gt;&gt;= &quot;2022-01-01&quot;&#13;
)&#13;
&#13;
SELECT&#13;
dates.day,&#13;
dates.first_day,&#13;
country_code,&#13;
rates.currency_iso,&#13;
rate_eu&#13;
from &#13;
dates&#13;
left join rates on dates.first_day = rates.currency_exchange_date&#13;
left join country_currency on country_currency.currency_iso = rates.currency_iso</relation>
          <relation connection='bigquery.0e2tirj1t0t19g19534d80g4nied' name='Consulta SQL personalizada' type='text'>SELECT &#13;
country_code,&#13;
source_warehouse,&#13;
cast(DATE_TRUNC(completed_at_utc,DAY) AS DATE) date,&#13;
sum(source_sku_wac_lc*received_qty) cmt&#13;
 FROM `peya-datamarts-pro.dm_dmarts.dmarts_store_transfers` &#13;
 WHERE&#13;
 DATE_TRUNC(completed_at_utc,month) &gt;&gt;= &quot;2022-03-01&quot;&#13;
  AND transfer_status= &apos;COMPLETED&apos; and sku_id NOT IN (&quot;56624216&quot;,&quot;49904139&quot;,&quot;49904140&quot;,&quot;KOXQP3&quot;,&quot;53533659&quot;,&quot;56624215&quot;,&quot;62223987&quot;,&quot;49904137&quot;,&quot;54031444&quot;,&quot;54031442&quot;,&quot;54031446&quot;,&quot;54031445&quot;,&quot;54031449&quot;,&quot;54031447&quot;,&quot;54031451&quot;,&quot;KOXQP3&quot;,&quot;41O4GH&quot;,&quot;56624216&quot;)&#13;
  GROUP BY 1,2,3&#13;
  order by cmt desc</relation>
