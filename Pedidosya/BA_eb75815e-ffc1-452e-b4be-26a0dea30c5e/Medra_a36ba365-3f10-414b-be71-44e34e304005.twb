      <layout-options>
        <title>
          <formatted-text>
            <run>Clasificación campañas</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='medra_campaign_performance (automated_tables_reports)' name='federated.1g9oqse1y80iz51e4jz7e1sz632y' />
          </datasources>
          <datasource-dependencies datasource='federated.1g9oqse1y80iz51e4jz7e1sz632y'>
            <column datatype='string' name='[campaign]' role='dimension' type='nominal' />
            <column-instance column='[fase funel (copia)_959548224596656188]' derivation='Count' name='[cnt:fase funel (copia)_959548224596656188:qk]' pivot='key' type='quantitative' />
            <column caption='fase funel (copia) -1' datatype='integer' name='[fase funel (copia) (copia)_959548224853729346]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD({ FIXED [partner_id], [campaign] :&#13;&#10;    MIN(&#13;&#10;        IF [statusmensaje] IN (&quot;failed&quot;, &quot;sent&quot;) THEN &quot;1 - Failed&quot;&#13;&#10;        ELSEIF [statusmensaje] IN (&quot;delivered&quot;, &quot;Delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) AND [respondio ] = &quot;No&quot; THEN &quot;3 - No Respondió&quot;&#13;&#10;        ELSEIF [statusmensaje] IN (&quot;delivered&quot;, &quot;Delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) AND [respondio ] = &quot;Sí&quot; THEN &quot;4 - Sí Respondió&quot;&#13;&#10;        ELSE [fase funel (copia)_959548222482198562]&#13;&#10;        END&#13;&#10;    )&#13;&#10;})*-1' />
            </column>
            <column caption='fase funel Partners' datatype='string' name='[fase funel (copia)_959548222482198562]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [statusmensaje] IN (&quot;failed&quot;, &quot;sent&quot;, &quot;delivered&quot;, &quot;Delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) THEN &quot;0 - partners&quot;&#13;&#10;    END' />
            </column>
            <column caption='fase funel (copia)' datatype='string' name='[fase funel (copia)_959548224596656188]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [partner_id], [campaign] :&#13;&#10;    MIN(&#13;&#10;        IF [statusmensaje] IN (&quot;failed&quot;, &quot;sent&quot;) THEN &quot;1 - Failed&quot;&#13;&#10;        ELSEIF [statusmensaje] IN (&quot;delivered&quot;, &quot;Delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) AND [respondio ] = &quot;No&quot; THEN &quot;2 - No Respondió&quot;&#13;&#10;        ELSEIF [statusmensaje] IN (&quot;delivered&quot;, &quot;Delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) AND [respondio ] = &quot;Sí&quot; THEN &quot;3 - Sí Respondió&quot;&#13;&#10;        ELSE [fase funel (copia)_959548222482198562]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column-instance column='[campaign]' derivation='None' name='[none:campaign:nk]' pivot='key' type='nominal' />
            <column caption='Partner Id' datatype='integer' name='[partner_id]' role='dimension' type='ordinal' />
            <column caption='Respondio' datatype='string' name='[respondio ]' role='dimension' type='nominal' />
            <column caption='Statusmensaje' datatype='string' name='[statusmensaje]' role='dimension' type='nominal' />
            <column-instance column='[fase funel (copia) (copia)_959548224853729346]' derivation='User' name='[usr:fase funel (copia) (copia)_959548224853729346:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1g9oqse1y80iz51e4jz7e1sz632y].[none:campaign:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:campaign:nk]' member='&quot;2025-5-26&quot;' />
              <groupfilter function='member' level='[none:campaign:nk]' member='&quot;2025-5-28&quot;' />
              <groupfilter function='member' level='[none:campaign:nk]' member='&quot;2025-5-29&quot;' />
