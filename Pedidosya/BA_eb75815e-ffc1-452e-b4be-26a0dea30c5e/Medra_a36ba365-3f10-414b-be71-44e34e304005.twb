          <formatted-text>
            <run fontname='Tahoma' fontsize='12'>Partners w/ Real Hours &gt;28</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='medra_campaign_performance (automated_tables_reports)' name='federated.1g9oqse1y80iz51e4jz7e1sz632y' />
