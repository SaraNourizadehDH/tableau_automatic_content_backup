          <datasource-dependencies datasource='federated.1g9oqse1y80iz51e4jz7e1sz632y'>
            <column caption='partners week +3' datatype='integer' name='[% variación sem -1 /sem +3 (copia)_959548222470148125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF ([Calculation_959548221104955394] = &quot;Week +3&quot; AND [orders]&gt;0) THEN [partner_id] END )' />
            </column>
            <column caption='week agrupado' datatype='string' name='[Calculation_959548221104955394]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEDIFF(&apos;day&apos;, DATE([campaign]), DATE([week]))&#13;&#10;   &#13;&#10;&#13;&#10;    WHEN 7 THEN &quot;Week +1&quot;&#13;&#10;    WHEN 14 THEN &quot;Week +2&quot;&#13;&#10;    WHEN 21 THEN &quot;Week +3&quot;&#13;&#10;    WHEN 28 THEN &quot;Week +4&quot;&#13;&#10;    WHEN 0 THEN &quot;Week 0&quot;&#13;&#10;    WHEN -7 THEN &quot;Week -1&quot;&#13;&#10;    WHEN -14 THEN &quot;Week -2&quot;&#13;&#10;    WHEN -21 THEN &quot;Week -3&quot;&#13;&#10;    WHEN -28 THEN &quot;Week -4&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Variación -1 /+3' datatype='real' name='[Calculation_959548222471757856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([% variación sem -1 /sem +3 (copia)_959548222470148125] - [partners week +3 (copia)_959548222470406174]) / [partners week +3 (copia)_959548222470406174]' />
            </column>
