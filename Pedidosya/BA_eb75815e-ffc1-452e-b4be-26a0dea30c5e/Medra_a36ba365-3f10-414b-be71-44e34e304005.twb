      <aliases enabled='yes' />
      <column caption='% Active Partners respondió' datatype='real' name='[% Active Partners (copia)_959548224684716096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([orders]) AND [orders] &gt; 0 AND [respondio ] = &quot;Si&quot; THEN [partner_id] END&#13;&#10;) / COUNTD([partner_id])' />
      </column>
      <column caption='% Active Partners no respondió' datatype='real' name='[% Active Partners respondió (copia)_959548224684986433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([orders]) AND [orders] &gt; 0 AND [respondio ] = &quot;No&quot; THEN [partner_id] END&#13;&#10;) / COUNTD([partner_id])' />
      </column>
      <column caption='partners week +3' datatype='integer' name='[% variación sem -1 /sem +3 (copia)_959548222470148125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF ([Calculation_959548221104955394] = &quot;Week +3&quot; AND [orders]&gt;0) THEN [partner_id] END )' />
      </column>
      <column caption='Active Sem 0' datatype='integer' name='[Active Sem -1 (copia)_959548223138725940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([orders]) AND [orders] &gt; 0 AND [Calculation_959548221104955394] = &quot;Week 0&quot; THEN [partner_id] END)' />
      </column>
      <column caption='Active Sem 1' datatype='integer' name='[Active Sem 0 (copia)_959548223138975797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([orders]) AND [orders] &gt; 0 AND [Calculation_959548221104955394] = &quot;Week +1&quot; THEN [partner_id] END)' />
      </column>
      <column caption='week agrupado' datatype='string' name='[Calculation_959548221104955394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATEDIFF(&apos;day&apos;, DATE([campaign]), DATE([week]))&#13;&#10;   &#13;&#10;&#13;&#10;    WHEN 7 THEN &quot;Week +1&quot;&#13;&#10;    WHEN 14 THEN &quot;Week +2&quot;&#13;&#10;    WHEN 21 THEN &quot;Week +3&quot;&#13;&#10;    WHEN 28 THEN &quot;Week +4&quot;&#13;&#10;    WHEN 0 THEN &quot;Week 0&quot;&#13;&#10;    WHEN -7 THEN &quot;Week -1&quot;&#13;&#10;    WHEN -14 THEN &quot;Week -2&quot;&#13;&#10;    WHEN -21 THEN &quot;Week -3&quot;&#13;&#10;    WHEN -28 THEN &quot;Week -4&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Partners Campañas' datatype='integer' name='[Calculation_959548222128160772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign] : COUNTD([partner_id]) }' />
      </column>
      <column caption='Photo_Coverage' datatype='real' name='[Calculation_959548222131900421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_pics]) / SUM([qty_products])' />
      </column>
      <column caption='Active_Partners' datatype='integer' name='[Calculation_959548222137327623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([orders]) AND [orders] &gt; 0 THEN [partner_id] END)' />
      </column>
      <column caption='Incontactable' datatype='string' name='[Calculation_959548222143336456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [classification] = &quot;failed&quot; OR [classification] = &quot;sent&quot; THEN &quot;Sí&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='% Active Partners' datatype='real' name='[Calculation_959548222156591115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([orders]) AND [orders] &gt; 0 THEN [partner_id] END&#13;&#10;) / COUNTD([partner_id])' />
      </column>
      <column caption='Órdenes por partner por semana' datatype='integer' name='[Calculation_959548222163562509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partner_id], [Calculation_959548221104955394] : SUM([orders]) }' />
      </column>
      <column caption='Partner activo en la semana' datatype='integer' name='[Calculation_959548222163804174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_959548222163562509] &gt; 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Semana Relativa' datatype='string' name='[Calculation_959548222170599442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATEDIFF(&apos;day&apos;, DATE([campaign]), DATE([week]))&#13;&#10;    WHEN -28 THEN &quot;Week -4&quot;&#13;&#10;    WHEN -21 THEN &quot;Week -3&quot;&#13;&#10;    WHEN -14 THEN &quot;Week -2&quot;&#13;&#10;    WHEN -7 THEN &quot;Week -1&quot;&#13;&#10;    WHEN 0 THEN &quot;Week 0&quot;&#13;&#10;    WHEN 7 THEN &quot;Week +1&quot;&#13;&#10;    WHEN 14 THEN &quot;Week +2&quot;&#13;&#10;    WHEN 21 THEN &quot;Week +3&quot;&#13;&#10;    WHEN 28 THEN &quot;Week +4&quot;&#13;&#10;END' />
      </column>
      <column caption='Primera Semana Con Orden (por campaña)' datatype='string' name='[Calculation_959548222170746899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [partner_id], [campaign] :&#13;&#10;    MIN(&#13;&#10;        IF [orders] &gt; 0 THEN&#13;&#10;            CASE DATEDIFF(&apos;day&apos;, DATE([campaign]), DATE([week]))&#13;&#10;                WHEN -28 THEN &quot;Week -4&quot;&#13;&#10;                WHEN -21 THEN &quot;Week -3&quot;&#13;&#10;                WHEN -14 THEN &quot;Week -2&quot;&#13;&#10;                WHEN -7 THEN &quot;Week -1&quot;&#13;&#10;                WHEN 0 THEN &quot;Week 0&quot;&#13;&#10;                WHEN 7 THEN &quot;Week +1&quot;&#13;&#10;                WHEN 14 THEN &quot;Week +2&quot;&#13;&#10;                WHEN 21 THEN &quot;Week +3&quot;&#13;&#10;                WHEN 28 THEN &quot;Week +4&quot;&#13;&#10;            END&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Partner Nuevo por Campaña' datatype='integer' name='[Calculation_959548222170861588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_959548222170599442] = [Calculation_959548222170746899]&#13;&#10;THEN [partner_id] END' />
      </column>
      <column caption='Partners Nuevos por Semana' datatype='integer' name='[Calculation_959548222171017237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_959548222170861588])' />
      </column>
      <column caption='Qnt partners' datatype='integer' name='[Calculation_959548222460637210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id])' />
      </column>
      <column caption='Variación -1 /+3' datatype='real' name='[Calculation_959548222471757856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([% variación sem -1 /sem +3 (copia)_959548222470148125] - [partners week +3 (copia)_959548222470406174]) / [partners week +3 (copia)_959548222470406174]' />
      </column>
      <column caption='fase funel' datatype='string' name='[Calculation_959548222478585889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [statusmensaje] IN (&quot;failed&quot;, &quot;sent&quot;) THEN &quot;1 - Failed&quot;&#13;&#10;    ELSEIF [statusmensaje] IN (&quot;delivered&quot;, &quot;Delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) AND [respondio ] = &quot;No&quot; THEN &quot;3 - No Respondió&quot;&#13;&#10;    ELSEIF [statusmensaje] IN (&quot;delivered&quot;, &quot;Delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) AND [respondio ] = &quot;Sí&quot; THEN &quot;4 - Sí Respondió&quot;&#13;&#10;    ELSE [fase funel (copia)_959548222482198562]&#13;&#10;    END' />
      </column>
      <column caption='fase funel -1' datatype='integer' name='[Calculation_959548223114424355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([partner_id])*-1' />
      </column>
      <column caption='Recibió' datatype='string' name='[Calculation_959548223127023657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([statusmensaje]) IN (&quot;delivered&quot;, &quot;read&quot;, &quot;accepted&quot;) THEN &quot;Recibió&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Respondió mensaje' datatype='string' name='[Calculation_959548223127158826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([statusmensaje]) IN (&quot;delivered&quot;, &quot;read&quot;, &quot;accepted&quot;)&#13;&#10;AND [respondio ] = &quot;Sí&quot; THEN &quot;Respondió&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Real_hours_28' datatype='real' name='[Calculation_959548223128211501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF NOT ISNULL([real_hours]) AND [real_hours] &gt; 28 THEN [partner_id] END)/COUNT([partner_id])' />
      </column>
      <column caption='Orders &gt;7 sem' datatype='integer' name='[Calculation_959548223129608238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([orders]) AND [orders] &gt; 7 THEN [partner_id] END)' />
      </column>
      <column caption='Part. VFD Orders&gt;0' datatype='real' name='[Calculation_959548223130660911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF NOT ISNULL([vfd_orders]) AND [vfd_orders] &gt; 0 THEN [partner_id] END)/COUNT([partner_id])' />
      </column>
      <column caption='Primera semana con orden' datatype='string' name='[Calculation_959548223135678512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [partner_id] : MIN(IF [orders] &gt; 0 THEN [Calculation_959548221104955394] END) }' />
      </column>
      <column caption='Activo hasta semana' datatype='integer' name='[Calculation_959548223136227377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_959548223135678512] &lt;= [Calculation_959548221104955394] THEN [partner_id] END' />
