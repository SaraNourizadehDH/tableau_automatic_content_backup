      <aliases enabled='yes' />
      <column caption='Partial item' datatype='integer' name='[% Partial item (copia)_82190716914589697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [is_partial_item]=1 then [order_id] else null end)' />
      </column>
      <column caption='% Item quantity delivered=0' datatype='real' name='[% Partial item (copia)_983192119174287361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [not_delivered_item]=1 then [order_id] else null end)/COUNTD(if [fail_rate_owner]=&apos;Confirmed&apos; then [order_id] else null end)' />
      </column>
      <column caption='% Orders with not delivered items' datatype='real' name='[% Partial orders (copia)_983192119181012995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([item_not_fulfilled_orders])/sum([confirmed_orders])' />
      </column>
      <column caption='VFR' datatype='real' name='[Calculation_1136314504543350785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_rejected_orders])/sum([total_orders])' />
      </column>
      <column caption='% Partial item' datatype='real' name='[Calculation_82190716912590848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [is_partial_item]=1 then [order_id] else null end)/COUNTD(if [fail_rate_owner]=&apos;Confirmed&apos; then [order_id] else null end)' />
      </column>
      <column caption='Confirmed orders' datatype='integer' name='[Calculation_82190716914835458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [fail_rate_owner]=&apos;Confirmed&apos; then [order_id] else null end)' />
      </column>
      <column caption='RowN' datatype='integer' name='[Calculation_82190716915724292]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales buffer/Max quantity status' datatype='string' name='[Calculation_82190716961705989]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF avg([sales_buffer])=0 THEN &apos;Sales buffer is 0&apos;&#13;&#10;ELSEIF avg([max_quantity])=0 then &apos;Max quantity not defined&apos;&#13;&#10;ELSEIF avg([sales_buffer])&lt;avg([max_quantity]) then &apos;Max quantity above sales buffer&apos;&#13;&#10;ELSEIF avg([sales_buffer])=avg([max_quantity]) then &apos;Max quantity equals sales buffer&apos;&#13;&#10;ELSEIF avg([sales_buffer])&gt;avg([max_quantity]) then &apos;Max quantity below sales buffer&apos;&#13;&#10;end' />
      </column>
      <column caption='min date' datatype='date' name='[Calculation_82190716989689868]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED DATEPART([Parameters].[Parámetro 1],[registered_date]):min([registered_date])}' />
      </column>
      <column caption='Max order date' datatype='date' name='[Calculation_82190716993933325]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([registered_date])' />
      </column>
      <column caption='max order detail date' datatype='date' name='[Calculation_82190716994048014]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([registered_date])' />
      </column>
      <column caption='% Partial orders' datatype='real' name='[VFR (copia)_1136314504543457282]' role='measure' type='quantitative'>
