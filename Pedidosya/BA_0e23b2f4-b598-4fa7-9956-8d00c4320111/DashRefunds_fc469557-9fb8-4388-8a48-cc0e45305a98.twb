              <calculation class='tableau' formula='IF ([Has_PARTIAL_type_refund]=true or [Has_TOTAL_type_refund]=true or [Has_OTHER_type_refund]=true) then [qty_payments]else 0 end' />
            </column>
            <column caption='Automatic Source' datatype='string' name='[Calculation_923519443951869964]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Has_AUTOMATIC_source_refund] = TRUE AND [Has_ASK_USER_source_refund] = TRUE AND [Has_ORDER_MODIFICATION_source_refund] then &apos;AUTOMATIC &amp; ASK USER &amp; ORDER MODIFICATION&apos;&#13;&#10;ELSEIF [Has_AUTOMATIC_source_refund] = TRUE AND [Has_ASK_USER_source_refund] = TRUE then &apos;AUTOMATIC &amp; ASK USER&apos;&#13;&#10;ELSEIF [Has_AUTOMATIC_source_refund] = TRUE AND [Has_ORDER_MODIFICATION_source_refund] = TRUE THEN &apos;AUTOMATIC &amp; ORDER MODIFICATION&apos; &#13;&#10;ELSEIF [Has_ASK_USER_source_refund] = TRUE AND [Has_ORDER_MODIFICATION_source_refund] = TRUE THEN &apos;ASK USER &amp; ORDER MODIFICATION&apos; &#13;&#10;ELSEIF [Has_AUTOMATIC_source_refund] = TRUE THEN &apos;AUTOMATIC&apos;&#13;&#10;ELSEIF [Has_ORDER_MODIFICATION_source_refund] = TRUE THEN &apos;ORDER MODIFICATION&apos;&#13;&#10;ELSEIF [Has_ASK_USER_source_refund] = TRUE THEN &apos;ASK USER&apos; ELSE &apos;OTHER&apos; END' />
