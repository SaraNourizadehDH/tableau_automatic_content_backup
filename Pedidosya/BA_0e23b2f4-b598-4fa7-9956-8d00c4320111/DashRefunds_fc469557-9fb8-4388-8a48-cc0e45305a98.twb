      <aliases enabled='yes' />
      <column caption='Acc Refunds / OP Orders' datatype='real' name='[Acc Refunds / Acc Payments (copia)_923519443929473029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty_ACCEPTED_state_refund])/[Accepted Payments Orders With Refund (copia)_923519443930591240]' />
      </column>
      <column caption='OP Orders with Refund  / OP Orders' datatype='real' name='[Acc Refunds / OP Generated Orders (copia)_923519443930120199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Accepted Payments (copia)_923519443929759750]/[Accepted Payments Orders With Refund (copia)_923519443930591240]' />
      </column>
      <column caption='Accepted Payments Orders With Refund' datatype='integer' name='[Accepted Payments (copia)_923519443929759750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [payment_state] in (&apos;ACCEPTED&apos;,&apos;REFUNDED&apos;,&apos;PARTIAL_REFUNDED&apos;,&apos;CHARGEBACK&apos;,&apos;CANCELLED&apos;) then [qty_orders_with_refund] else 0 end)' />
      </column>
      <column caption='Accepted Payments Orders ' datatype='integer' name='[Accepted Payments Orders With Refund (copia)_923519443930591240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [payment_state] in (&apos;ACCEPTED&apos;,&apos;REFUNDED&apos;,&apos;PARTIAL_REFUNDED&apos;,&apos;CHARGEBACK&apos;,&apos;CANCELLED&apos;) then [total_order_id] else 0 end)' />
      </column>
      <column caption='Accepted Payments' datatype='integer' name='[Calculation_923519443928371202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [payment_state] in (&apos;ACCEPTED&apos;,&apos;REFUNDED&apos;,&apos;PARTIAL_REFUNDED&apos;,&apos;CHARGEBACK&apos;,&apos;CANCELLED&apos;) then [qty_payments] else 0 end)' />
      </column>
      <column caption='Acc Refunds / Acc Payments' datatype='real' name='[Calculation_923519443929030660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Qty_ACCEPTED_state_refund])/[Calculation_923519443928371202]' />
      </column>
      <column caption='Qty Payments With Refund Request' datatype='integer' name='[Calculation_923519443935535113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Has_PARTIAL_type_refund]=true or [Has_TOTAL_type_refund]=true or [Has_OTHER_type_refund]=true) then [qty_payments]else 0 end' />
      </column>
      <column caption='Automatic Source' datatype='string' name='[Calculation_923519443951869964]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Has_AUTOMATIC_source_refund] = TRUE AND [Has_ASK_USER_source_refund] = TRUE AND [Has_ORDER_MODIFICATION_source_refund] then &apos;AUTOMATIC &amp; ASK USER &amp; ORDER MODIFICATION&apos;&#13;&#10;ELSEIF [Has_AUTOMATIC_source_refund] = TRUE AND [Has_ASK_USER_source_refund] = TRUE then &apos;AUTOMATIC &amp; ASK USER&apos;&#13;&#10;ELSEIF [Has_AUTOMATIC_source_refund] = TRUE AND [Has_ORDER_MODIFICATION_source_refund] = TRUE THEN &apos;AUTOMATIC &amp; ORDER MODIFICATION&apos; &#13;&#10;ELSEIF [Has_ASK_USER_source_refund] = TRUE AND [Has_ORDER_MODIFICATION_source_refund] = TRUE THEN &apos;ASK USER &amp; ORDER MODIFICATION&apos; &#13;&#10;ELSEIF [Has_AUTOMATIC_source_refund] = TRUE THEN &apos;AUTOMATIC&apos;&#13;&#10;ELSEIF [Has_ORDER_MODIFICATION_source_refund] = TRUE THEN &apos;ORDER MODIFICATION&apos;&#13;&#10;ELSEIF [Has_ASK_USER_source_refund] = TRUE THEN &apos;ASK USER&apos; ELSE &apos;OTHER&apos; END' />
      </column>
      <column caption='Average Refunds by User' datatype='real' name='[Calculation_923519443974389773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_refund])/SUM([qty_users_with_refund])' />
      </column>
