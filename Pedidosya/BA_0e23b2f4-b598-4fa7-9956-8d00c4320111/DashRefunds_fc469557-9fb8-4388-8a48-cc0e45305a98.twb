        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.07t63ik0ncqq721dswdvu1c27z5w' name='Consulta_SQL_personalizada' type='text'>select &#13;
date(pt.date_created) as Payment_Date,&#13;
r.reason,&#13;
r.state,&#13;
r.type,&#13;
pt.payment_type,&#13;
o.country.country_name,&#13;
pt.user_id,&#13;
o.restaurant.id as restaurant_id,&#13;
o.restaurant.name as partner_name,&#13;
count(distinct(r.id)) qty_refunds&#13;
from `peya-data-origins-pro.cl_payments.refund` r &#13;
left join `peya-bi-tools-pro.il_payments.fact_payments_transaction` pt on pt.payment_id = r.payment_id&#13;
left join `peya-bi-tools-pro.il_core.fact_orders` o on o.order_id = pt.order_id&#13;
where date(o.registered_date) &gt;&gt;= DATE_ADD (DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -1 MONTH)&#13;
and date(pt.date_created) &gt;&gt;= DATE_ADD (DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL -1 MONTH)&#13;
group by 1,2,3,4,5,6,7,8,9</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
