            <column aggregation='Sum' caption='Qty Acc Rebates' datatype='integer' name='[qty_accepted_rebates]' role='dimension' type='ordinal' />
            <column caption='Qty Orders' datatype='integer' name='[qty_orders]' role='measure' type='quantitative' />
