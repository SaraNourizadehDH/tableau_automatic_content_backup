        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1m80q1o0d8xlpd1e29hxu0bslllj'>
            <connection CATALOG='peya-fraud-and-fintech' EXECCATALOG='peya-fraud-and-fintech' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='peya-fraud-and-fintech' schema='user_santiago_castillo' server='' server-oauth='' username='maria.camblor@pedidosya.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1m80q1o0d8xlpd1e29hxu0bslllj' name='Consulta_SQL_personalizada' type='text'>WITH vars as (&#13;
     SELECT &#13;
        date_add(date_trunc(current_date, month),interval -5 month) as start_date&#13;
),&#13;
    rebates as (&#13;
     SELECT &#13;
     re.date_created,&#13;
     r.country as country_code,&#13;
     re.type,&#13;
     re.status,&#13;
     case when re.status_detail IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;)  then re.status_detail else &apos;REJECTED&apos; end as status_detail,&#13;
     re.amount,&#13;
     re.id,&#13;
     r.purchase_id,&#13;
     pt.payment_type,&#13;
     case when r.external_reference_type = &apos;ORDER&apos; then r.external_reference_id end as order_id&#13;
          FROM `peya-data-origins-pro.cl_refunds.refunds` r, unnest (refund_payments) rp, unnest (refund_methods) rm, unnest (rebates) re, vars&#13;
     LEFT JOIN `peya-bi-tools-pro.il_payments.fact_payments_transaction` pt on cast(pt.payment_id as string) = rp.external_reference_id&#13;
     WHERE DATE(r.date_created) &gt;&gt;= start_date&#13;
     ),&#13;
     orders as (&#13;
     SELECT &#13;
        user.id as user_id,&#13;
        registered_at_utc as registered_at,&#13;
        country.country_name,&#13;
        order_id,&#13;
        paymentMethod.online&#13;
        FROM `peya-bi-tools-pro.il_core.fact_orders`, vars&#13;
        WHERE &#13;
            DATE(registered_date) &gt;&gt;= start_date),&#13;
     rebates_by_orders as (&#13;
     SELECT &#13;
        date(registered_at) as Date,&#13;
        country_name,&#13;
        online,&#13;
        o.order_id,&#13;
        count(distinct(case when payment_type = &apos;ORDER&apos; then (id) end)) as qty_order_acc_rebates,&#13;
        count(distinct(case when payment_type != &apos;ORDER&apos; then (id) end)) as qty_other_acc_rebates,&#13;
        count(distinct(id)) as qty_accepted_rebates&#13;
        FROM orders o&#13;
        LEFT JOIN rebates re on o.order_id = cast(re.order_id as NUMERIC) and status_detail IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;)&#13;
        group by 1,2,3,4&#13;
        order by 7 desc)&#13;
        SELECT&#13;
        Date,&#13;
        country_name,&#13;
        online as is_op,&#13;
        qty_accepted_rebates,&#13;
        count(distinct(order_id)) qty_orders&#13;
        from rebates_by_orders&#13;
        group by 1,2,3,4&#13;
        order by 4 desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1m80q1o0d8xlpd1e29hxu0bslllj' name='Consulta_SQL_personalizada' type='text'>WITH vars as (&#13;
