    <worksheet name='Rebates AccR'>
      <table>
        <view>
          <datasources>
            <datasource caption='AccR &amp; Recovery post Orders' name='federated.1ncj4j40o1bnu81d5tath1ahjems' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Granularity' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ncj4j40o1bnu81d5tath1ahjems'>
            <column caption='Date Dash' datatype='datetime' name='[Calculation_3395714150146859014]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case  [Parameters].[Parámetro 1] when &apos;Day&apos; then [Date]&#13;&#10;when &apos;Month&apos; then DATETRUNC(&quot;month&quot;,Date)&#13;&#10;when &apos;Week&apos; then DATETRUNC(&quot;week&quot;,Date,&quot;Monday&quot;)&#13;&#10;when &apos;Quarter&apos; then DATETRUNC(&quot;quarter&quot;,Date)&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,Date) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[Date])) ELSE DATETRUNC(&quot;year&quot;,[Date]) END)&#13;&#10;When &apos;Year&apos; then DATETRUNC (&quot;year&quot;,Date)&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column caption='Ref Reb AccR' datatype='real' name='[Ref Pur AccR (copia)_3395714148085366785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [reb_status_detail] IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;) THEN [qty_rebates] ELSE 0 END)/SUM([qty_rebates])' />
            </column>
            <column caption='Ref Reb Amount AccR' datatype='real' name='[Ref Reb AccR (copia)_3395714148088356867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [reb_status_detail] IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;) THEN [ref_reb_amount_eu] ELSE 0 END)/SUM([ref_reb_amount_eu])' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Date]' derivation='MY' name='[my:Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[reb_status]' derivation='None' name='[none:reb_status:nk]' pivot='key' type='nominal' />
            <column-instance column='[reb_status_detail]' derivation='None' name='[none:reb_status_detail:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[qty_purchases]' role='measure' type='quantitative' />
            <column datatype='integer' name='[qty_rebates]' role='measure' type='quantitative' />
            <column caption='Rebate Status' datatype='string' name='[reb_status]' role='dimension' type='nominal' />
