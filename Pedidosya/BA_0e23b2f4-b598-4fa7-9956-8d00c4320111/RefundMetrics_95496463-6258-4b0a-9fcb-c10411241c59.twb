                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aann8p03ov8en1gbi1r80n5s3nz'>
            <column caption='Date Dash' datatype='datetime' name='[Calculation_3395714150586576904]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case  [Parameters].[Parámetro 1] when &apos;Day&apos; then [Date]&#13;&#10;when &apos;Month&apos; then DATETRUNC(&quot;month&quot;,Date)&#13;&#10;when &apos;Week&apos; then DATETRUNC(&quot;week&quot;,Date,&quot;Monday&quot;)&#13;&#10;when &apos;Quarter&apos; then DATETRUNC(&quot;quarter&quot;,Date)&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,Date) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[Date])) ELSE DATETRUNC(&quot;year&quot;,[Date]) END)&#13;&#10;When &apos;Year&apos; then DATETRUNC (&quot;year&quot;,Date)&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
