      <column caption='Ref Pur AccR' datatype='real' name='[Calculation_3395714148082311168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [pur_status_detail] IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;) THEN [qty_purchases] ELSE 0 END)/SUM([qty_purchases])' />
      </column>
      <column caption='Date Dash' datatype='datetime' name='[Calculation_3395714150146859014]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case  [Parameters].[Parámetro 1] when &apos;Day&apos; then [Date]&#13;&#10;when &apos;Month&apos; then DATETRUNC(&quot;month&quot;,Date)&#13;&#10;when &apos;Week&apos; then DATETRUNC(&quot;week&quot;,Date,&quot;Monday&quot;)&#13;&#10;when &apos;Quarter&apos; then DATETRUNC(&quot;quarter&quot;,Date)&#13;&#10;WHEN &apos;Half&apos; THEN (IF datepart(&quot;month&quot;,Date) &gt; 6&#13;&#10;then DATEADD(&quot;month&quot;,5,DATETRUNC(&quot;year&quot;,[Date])) ELSE DATETRUNC(&quot;year&quot;,[Date]) END)&#13;&#10;When &apos;Year&apos; then DATETRUNC (&quot;year&quot;,Date)&#13;&#10;END' />
      </column>
      <column caption='Ref Reb AccR' datatype='real' name='[Ref Pur AccR (copia)_3395714148085366785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [reb_status_detail] IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;) THEN [qty_rebates] ELSE 0 END)/SUM([qty_rebates])' />
      </column>
      <column caption='Ref Pur Amount AccR ' datatype='real' name='[Ref Pur AccR (copia)_3395714148087218178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [pur_status_detail] IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;) THEN [ref_pur_amount_eu] ELSE 0 END)/SUM([ref_pur_amount_eu])' />
      </column>
      <column caption='Ref Reb Amount AccR' datatype='real' name='[Ref Reb AccR (copia)_3395714148088356867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [reb_status_detail] IN (&apos;ACCEPTED&apos;,&apos;RESOLVED&apos;) THEN [ref_reb_amount_eu] ELSE 0 END)/SUM([ref_reb_amount_eu])' />
      </column>
