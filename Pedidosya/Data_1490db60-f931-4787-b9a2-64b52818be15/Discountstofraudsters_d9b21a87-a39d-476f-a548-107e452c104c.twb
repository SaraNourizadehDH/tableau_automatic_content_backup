        , country_name&#13;
        , already_captured&#13;
        , capture_timing&#13;
        , caught_by&#13;
&#13;
        , sum(total_amount_no_discount) as total_amount_no_discount&#13;
        , sum(total_amount) as total_amount&#13;
        , sum(discount_paid_by_company) as discount_paid_by_company&#13;
        , sum(discount_paid_by_partner) as discount_paid_by_partner&#13;
        , sum(case when coupon_peyapays then coupon_used_amount else 0 end) as coupon_company&#13;
        , sum(case when not coupon_peyapays then coupon_used_amount else 0 end) as coupon_partner&#13;
        , sum(case when coupon_sorry then coupon_used_amount else 0 end) as sorry_coupon&#13;
&#13;
from `peya-fraud-and-fintech.automated_tables_reports.capture_analysis`&#13;
&#13;
group by 1,2,3,4,5</relation>
