            <column datatype='real' name='[discount_paid_by_partner]' role='measure' type='quantitative' />
            <column caption='discounts_fraud_eurus_and_gadget' datatype='real' name='[discounts_fraud_device_rules (copia)_971370172239720463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; and ([caught_by]=&apos;eurus_offline_and_gadget&apos; or [caught_by]=&apos;eurus_online_and_gadget&apos;) then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
            </column>
            <column caption='discounts_fraud_eurus_on' datatype='real' name='[discounts_fraud_eurus_off (copia)_971370172232843276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; and [caught_by]=&apos;eurus_online&apos; then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
            </column>
            <column caption='discounts_fraud_gadget' datatype='real' name='[discounts_fraud_eurus_off (copia)_971370172232929293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; and [caught_by]=&apos;gadget&apos; then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
            </column>
            <column caption='discounts_fraud_device_rules' datatype='real' name='[discounts_fraud_eurus_off (copia)_971370172239523854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; and [caught_by]=&apos;device_rules&apos; then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
            </column>
            <column caption='discounts_fraud_eurus_off' datatype='real' name='[discounts_fraud_partner (copia)_971370172232564747]' role='measure' type='quantitative'>
