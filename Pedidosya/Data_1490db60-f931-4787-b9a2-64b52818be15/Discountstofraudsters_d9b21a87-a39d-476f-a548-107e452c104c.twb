      </column>
      <column caption='discounts_fraud_gadget' datatype='real' name='[discounts_fraud_eurus_off (copia)_971370172232929293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; and [caught_by]=&apos;gadget&apos; then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
      </column>
