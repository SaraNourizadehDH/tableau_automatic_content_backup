          <alias key='&quot;[federated.1rf9yqs0z9tsxd114rxdi0m3uowh].[sum:discount_paid_by_company:qk]&quot;' value='paid by Company' />
          <alias key='&quot;[federated.1rf9yqs0z9tsxd114rxdi0m3uowh].[sum:discount_paid_by_partner:qk]&quot;' value='paid by Partner' />
