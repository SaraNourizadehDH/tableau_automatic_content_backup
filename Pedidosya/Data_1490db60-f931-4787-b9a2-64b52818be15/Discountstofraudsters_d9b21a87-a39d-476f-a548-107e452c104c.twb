    <worksheet name='capture_algorithm_fraud'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='13'>Discounts by capture timing (% of total discounts)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='capture_analysis' name='federated.1rf9yqs0z9tsxd114rxdi0m3uowh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='View' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rf9yqs0z9tsxd114rxdi0m3uowh'>
            <column caption='Date' datatype='date' name='[Calculation_1041457419187159045]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parámetro 1]=&apos;day&apos; THEN [date]&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;week&apos; THEN DATETRUNC(&apos;week&apos;,[date])&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;month&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;END)' />
            </column>
            <column caption='discounts_fraud_total' datatype='real' name='[Calculation_971370172182855684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
            </column>
            <column datatype='string' name='[caught_by]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='not captured' />
              </aliases>
            </column>
