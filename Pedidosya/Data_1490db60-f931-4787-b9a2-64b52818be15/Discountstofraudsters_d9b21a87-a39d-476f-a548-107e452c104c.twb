          <alias key='&quot;[federated.1rf9yqs0z9tsxd114rxdi0m3uowh].[usr:discounts_fraud_company (copia)_971370172223029258:qk]&quot;' value='paid by Partner  ' />
          <alias key='&quot;[federated.1rf9yqs0z9tsxd114rxdi0m3uowh].[usr:discounts_fraud_day (copia)_971370172186152967:qk]&quot;' value='Pre capture' />
          <alias key='&quot;[federated.1rf9yqs0z9tsxd114rxdi0m3uowh].[usr:discounts_fraud_post (copia)_971370172222087177:qk]&quot;' value='paid by Company  ' />
          <alias key='&quot;[federated.1rf9yqs0z9tsxd114rxdi0m3uowh].[usr:discounts_fraud_pre (copia)_971370172186255368:qk]&quot;' value='Post capture' />
          <alias key='&quot;[federated.1rf9yqs0z9tsxd114rxdi0m3uowh].[usr:discounts_fraud_total (copia)_971370172184944645:qk]&quot;' value='Day capture' />
        </aliases>
      </column>
      <column caption='% discounts Fraud' datatype='real' name='[Calculation_1041457419151716354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [already_captured] or not [already_captured] then [discount_paid_by_company] else 0 end)/&#13;&#10;sum([discount_paid_by_company])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1041457419187159045]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(If [Parameters].[Parámetro 1]=&apos;day&apos; THEN [date]&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;week&apos; THEN DATETRUNC(&apos;week&apos;,[date])&#13;&#10;ELSEIF [Parameters].[Parámetro 1]=&apos;month&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;END)' />
      </column>
      <column caption='p_discount_paid_by_partner' datatype='real' name='[Calculation_971370171136950272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([discount_paid_by_partner])/sum([discount_paid_by_partner]+[discount_paid_by_company]+[total_amount])' />
      </column>
      <column caption='discounts_fraud_total' datatype='real' name='[Calculation_971370172182855684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Consulta SQL personalizada' datatype='table' name='[__tableau_internal_object_id__].[_6584E0B2962D4AFA844AD065B778011A]' role='measure' type='quantitative' />
      <column caption='already_captured (copia)' datatype='boolean' name='[already_captured (copia)_1041457419159289859]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[already_captured]' />
      </column>
      <column datatype='boolean' name='[already_captured]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='Not captured' />
          <alias key='false' value='Pre capture' />
          <alias key='true' value='Post capture' />
        </aliases>
      </column>
      <column datatype='string' name='[capture_timing]' role='dimension' type='nominal' />
      <column datatype='string' name='[caught_by]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='not captured' />
        </aliases>
      </column>
      <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='real' name='[coupon_company]' role='measure' type='quantitative' />
      <column datatype='real' name='[coupon_partner]' role='measure' type='quantitative' />
      <column datatype='real' name='[discount_paid_by_company]' role='measure' type='quantitative' />
      <column datatype='real' name='[discount_paid_by_partner]' role='measure' type='quantitative' />
      <column caption='discounts_fraud_partner' datatype='real' name='[discounts_fraud_company (copia)_971370172223029258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; then [discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
      </column>
      <column caption='discounts_fraud_pre' datatype='real' name='[discounts_fraud_day (copia)_971370172186152967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; and [capture_timing]=&apos;Pre capture&apos; then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
      </column>
      <column caption='discounts_fraud_eurus_and_gadget' datatype='real' name='[discounts_fraud_device_rules (copia)_971370172239720463]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [caught_by] &lt;&gt; &apos;not captured&apos; and ([caught_by]=&apos;eurus_offline_and_gadget&apos; or [caught_by]=&apos;eurus_online_and_gadget&apos;) then [discount_paid_by_company]+[discount_paid_by_partner] else 0 end)/&#13;&#10;sum([discount_paid_by_company]+[discount_paid_by_partner])' />
      </column>
      <column caption='discounts_fraud_eurus_on' datatype='real' name='[discounts_fraud_eurus_off (copia)_971370172232843276]' role='measure' type='quantitative'>
