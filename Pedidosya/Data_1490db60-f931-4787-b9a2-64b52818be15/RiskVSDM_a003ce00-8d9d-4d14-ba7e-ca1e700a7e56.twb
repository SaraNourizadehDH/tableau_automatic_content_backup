                <run bold='true'>RISK_FPASS = FreePassRisk</run>
                <run>
NO_ACCEPT = REJECT
Other responses do not vary

</run>
                <run bold='true'>DM_GLOBAL = RResultDM </run>
                <run>&#10;Responses do not vary&#10;&#10;</run>
                <run bold='true'>DM_FPASS = ScoredFreePassDm</run>
