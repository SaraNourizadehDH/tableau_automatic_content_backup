    <worksheet name='Total_number'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='14'>Transactions scored by dm</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Data_goal' name='federated.07oht3a1bg8li017id5z8179b203' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly Goal' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Parámetro 1]' param-domain-type='any' role='measure' type='quantitative' value='5100000.'>
              <calculation class='tableau' formula='5100000.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07oht3a1bg8li017id5z8179b203'>
            <column caption='necessary_by_day' datatype='real' name='[Calculation_1211468358406262790]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ROUND([Parameters].[Parámetro 1]/DAY(DATEADD(&apos;day&apos;, -1,DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[date])))),0)' />
            </column>
            <column caption='SUM([Qty Scoring Id])- RUNNING_SUM(min([necessary_by_day]))' datatype='real' name='[Calculation_1211468358464761882]' role='measure' type='quantitative' user:unnamed='Total'>
              <calculation class='tableau' formula='SUM([qty_scoring_id])- RUNNING_SUM(min([Calculation_1211468358406262790]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Countries' datatype='string' name='[Calculation_1390204976462376960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country] when &quot;AR&quot; then [country] + &quot;_&quot; + [ri_result_profile] else [country] END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='Month' name='[mn:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1390204976462376960]' derivation='None' name='[none:Calculation_1390204976462376960:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[ri_result_profile]' derivation='None' name='[none:ri_result_profile:nk]' pivot='key' type='nominal' />
            <column caption='Qty Scoring Id' datatype='integer' name='[qty_scoring_id]' role='dimension' type='ordinal' />
            <column caption='Ri Result Profile' datatype='string' name='[ri_result_profile]' role='dimension' type='nominal' />
            <column-instance column='[qty_scoring_id]' derivation='Sum' name='[sum:qty_scoring_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1211468358464761882]' derivation='User' name='[usr:Calculation_1211468358464761882:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <slices>
            <column>[federated.07oht3a1bg8li017id5z8179b203].[none:ri_result_profile:nk]</column>
            <column>[federated.07oht3a1bg8li017id5z8179b203].[none:country:nk]</column>
            <column>[federated.07oht3a1bg8li017id5z8179b203].[mn:date:ok]</column>
            <column>[federated.07oht3a1bg8li017id5z8179b203].[none:Calculation_1390204976462376960:nk]</column>
          </slices>
          <aggregation value='true' />
