          <zone h='54584' id='3' param='vert' type-v2='layout-flow' w='98882' x='559' y='906'>
            <zone fixed-size='130' h='14723' id='5' is-fixed='true' param='vert' type-v2='layout-flow' w='98882' x='559' y='906'>
              <zone forceUpdate='true' h='12684' id='6' type-v2='text' w='98882' x='559' y='906'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='20'>RISK VS DM</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='15'>Free_Pass strategies comparison</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='20'>GLOSSARY</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#ff0000' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='156' h='17667' id='10' is-fixed='true' param='horz' type-v2='layout-flow' w='98882' x='559' y='15629'>
              <zone fixed-size='447' forceUpdate='true' h='15629' id='9' is-fixed='true' type-v2='text' w='98882' x='559' y='15629'>
                <formatted-text>
                  <run bold='true' fontcolor='#4e79a7' fontsize='11'>RISK_FPASS:</run>
                  <run>
Risk response regarding FreePass Strategy (based on ResolverResult table).

</run>
                  <run bold='true'>ACCEPT</run>
                  <run>: The scoring_id complies with FreePass Strategy.
</run>
                  <run bold='true'>NO_ACCEPT</run>
                  <run>: The scoring_id does not complies with FreePass Strategy.
</run>
                  <run bold='true'>NOT_SCORED</run>
                  <run>: The scoring_id has no result for FreePass evaluation.
</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='20385' id='11' param='horz' type-v2='layout-flow' w='98882' x='559' y='33296'>
              <zone h='20385' id='13' param='horz' type-v2='layout-flow' w='98882' x='559' y='33296'>
                <zone h='20385' id='14' type-v2='text' w='49441' x='559' y='33296'>
                  <formatted-text>
                    <run bold='true' fontcolor='#4e79a7' fontsize='11'>DM_GLOBAL:</run>
                    <run>
Final resolution for the whole DecisionManager Strategy (based on ResolverResult table).

</run>
                    <run bold='true'>ACCEPT</run>
                    <run>: The scoring_id was accepted by DM.
</run>
                    <run bold='true'>REJECT</run>
                    <run>: The scoring_id was rejected by DM.
</run>
                    <run bold='true'>NOT_SCORED</run>
                    <run>: The scoring_id has no result for DM evaluation.
</run>
                    <run bold='true'>FAILED</run>
                    <run>; </run>
                    <run bold='true'>NOT_EXECUTED </run>
                    <run>or </run>
                    <run bold='true'>ERROR</run>
                    <run>: The scoring_id was not able to be scored by DM.
</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='20385' id='15' param='vert' type-v2='layout-flow' w='49441' x='50000' y='33296'>
                  <zone h='20385' id='16' type-v2='text' w='49441' x='50000' y='33296'>
                    <formatted-text>
                      <run bold='true' fontcolor='#4e79a7' fontsize='11'>DM_FPASS:</run>
                      <run>
DM response regarding FreePass Strategy (based on daily_cybersource table).

</run>
                      <run bold='true'>ACCEPT</run>
                      <run>: any of the 15 active rules is FreePass and the decision is ACCEPT
</run>
                      <run bold='true'>REJECT</run>
                      <run>: any of the 15 active rules is FreePass and the decision is REJECT
</run>
                      <run bold='true'>MONITOR</run>
                      <run>: any of the 15 active rules is FreePass and the decision is MONITOR
</run>
                      <run bold='true'>NONE</run>
                      <run>: none of the 15 active rules is a FreePass rule
</run>
                      <run bold='true'>NOT_SCORED</run>
                      <run>: the scoring_id was not able in Cybersource table</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
            </zone>
          </zone>
