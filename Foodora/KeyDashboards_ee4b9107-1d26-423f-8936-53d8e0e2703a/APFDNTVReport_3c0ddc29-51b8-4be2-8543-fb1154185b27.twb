      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9290DB699EBA42A397C9DE2AC243A038'>
            <properties context=''>
              <relation connection='bigquery.1kkz8ed0s6evre1degtbe0fbvuip' name='Custom SQL Query' type='text'>SELECT&#13;
    DATE_TRUNC(oo.created_date_local, MONTH) as order_month,&#13;
    rev.global_entity_id,&#13;
    rev.business_type_apac AS redeemed_vertical,&#13;
    new_customer_condition_type,&#13;
    dps_incentive_type.hva_type,&#13;
    dps_incentive_type.marketing,&#13;
    vendors.vendor_name, &#13;
    --price_reasons.reason,&#13;
    count(*) AS all_count,&#13;
    count(distinct platform_order_code) AS unique_count,&#13;
    sum(dps_incentive_discount_local) AS dps_incentive_local,&#13;
    sum(dps_delivery_fee_local) AS delivery_fee_local,&#13;
    sum(dps_incentive_discount_eur) AS dps_incentive_eur,&#13;
    sum(dps_delivery_fee_eur) AS delivery_fee_eur,&#13;
  FROM `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` oo&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_business_types` rev&#13;
      ON rev.order_code = oo.platform_order_code&#13;
  LEFT JOIN fulfillment-dwh-production.pandata_curated.billing_flags bf &#13;
      ON bf.global_entity_id = rev.global_entity_id&#13;
     AND bf.order_code = rev.order_code &#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS vendors&#13;
         ON rev.pd_vendor_uuid = vendors.pd_vendor_uuid&#13;
  WHERE TRUE&#13;
  AND dps_incentive_type.hva_type IN (&quot;fdnc_quickcommerce&quot;, &quot;fdnc_darkstores&quot;)&#13;
  AND oo.created_date_local &gt;&gt; &quot;2024-09-01&quot;&#13;
  AND rev.ordered_at_date_local &gt;&gt; &quot;2024-09-01&quot;&#13;
  AND bf.is_billable&#13;
  --AND price_reasons.reason_applied&#13;
  --AND assignments.id IN (1246,1230)&#13;
 -- AND country_code = &quot;BD&quot;&#13;
  AND oo.has_dps_incentive&#13;
  group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
