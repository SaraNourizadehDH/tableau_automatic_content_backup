  <worksheets>
    <worksheet name='DF Reduction Split'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b8209d' fontsize='11'>Delivery Fee Reduction Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (fd_finance)' name='federated.0sso5421chdsnl10ks0f70gh0009' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Incentive Source' datatype='string' name='[Currency (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;offers&quot;'>
              <calculation class='tableau' formula='&quot;offers&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[dh_funded_non_df_discounts Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sso5421chdsnl10ks0f70gh0009'>
            <column caption='K11200 - GFV / GPV' datatype='real' name='[Calculation_3782601536475381760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([gfv_w_dmart_adj_local], 0) + IFNULL([Calculation_3782601536899362832], 0)&#10;ELSE (IFNULL([gfv_w_dmart_adj_local], 0) /[fx_rate]) + IFNULL([Calculation_3782601536899362832], 0) END' />
            </column>
            <column caption='K11210 - Delivery fee (+)' datatype='real' name='[Calculation_3782601536475574273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([df_user_paid_incl_vat_local], 0) + IFNULL([df_priority_incl_vat_local], 0)&#10;ELSE (IFNULL([df_user_paid_incl_vat_local], 0) + IFNULL([df_priority_incl_vat_local], 0))/[fx_rate] END' />
            </column>
            <column caption='K11220 - Other fees (+)' datatype='real' name='[Calculation_3782601536475992066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([service_fee_plus_vat_local], 0) + IFNULL([difference_to_minimum_order_value_plus_vat_local], 0)&#10;ELSE (IFNULL([service_fee_plus_vat_local], 0) + IFNULL([difference_to_minimum_order_value_plus_vat_local], 0))/[fx_rate] END' />
            </column>
            <column caption='K11230 - Vendor funded incentives (-)' datatype='real' name='[Calculation_3782601536476282883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([Calculation_3782601536482856972], 0) + IFNULL([Calculation_3782601536483106829], 0)) * -1&#10;ELSE ((IFNULL([Calculation_3782601536482856972], 0) + IFNULL([Calculation_3782601536483106829], 0)) *-1)/[fx_rate] END' />
            </column>
            <column caption='K11240 - Joker (-)' datatype='real' name='[Calculation_3782601536476622852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([joker_fee_plus_vat_local], 0) + ABS(IFNULL([Calculation_3782601536483328014], 0)))*-1&#10;ELSE ((IFNULL([joker_fee_plus_vat_local], 0) + ABS(IFNULL([Calculation_3782601536483328014], 0)))*-1)/[fx_rate] END' />
            </column>
            <column caption='K11270 - DH funded incentives (-)' datatype='real' name='[Calculation_3782601536477032453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([Calculation_3782601536482365450], 0) + IFNULL([Calculation_3782601536482615307], 0) + IFNULL([dmart_item_discounts], 0)) * -1&#10;ELSE ((IFNULL([Calculation_3782601536482365450], 0) + IFNULL([Calculation_3782601536482615307], 0) + IFNULL([dmart_item_discounts], 0))*-1)/[fx_rate] END' />
            </column>
            <column caption='K11280 - Share of Joker kept by DH = Joker Fee (+)' datatype='real' name='[Calculation_3782601536477302790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([joker_fee_plus_vat_local], 0)&#10;ELSE IFNULL([joker_fee_plus_vat_local], 0)/[fx_rate] END' />
            </column>
            <column caption='K11249 - Vendor generated GMV' datatype='real' name='[Calculation_3782601536480239623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_3782601536475381760], 0)&#10;+ IFNULL([Calculation_3782601536475574273], 0)&#10;+ IFNULL([Calculation_3782601536475992066], 0) &#10;+ IFNULL([Calculation_3782601536476282883], 0) &#10;+ IFNULL([Calculation_3782601536476622852], 0)' />
            </column>
            <column caption='K11299 - GMV including incentives' datatype='real' name='[Calculation_3782601536480915464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_3782601536480239623], 0)&#10;+ IFNULL([Calculation_3782601536477032453], 0)&#10;+ IFNULL([Calculation_3782601536477302790], 0)' />
            </column>
            <column caption='DH Funded Discounts' datatype='real' name='[Calculation_3782601536482365450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Currency (copy)] = &quot;offers&quot; then IFNULL([offers_dh_funded_non_df_discounts], 0) + IFNULL([wallet_incentives_local], 0)&#10;else IFNULL([dh_funded_non_df_discounts], 0) + IFNULL([wallet_incentives_local], 0) END' />
            </column>
            <column caption='DH Funded Vouchers' datatype='real' name='[Calculation_3782601536482615307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Currency (copy)] = &quot;offers&quot; then [offers_dh_funded_non_df_vouchers] else [dh_funded_non_df_vouchers] END' />
            </column>
            <column caption='Vendor Funded Discounts' datatype='real' name='[Calculation_3782601536482856972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Currency (copy)] = &quot;offers&quot; then [offers_vendor_funded_non_df_discounts] else [vendor_funded_non_df_discounts] END' />
            </column>
            <column caption='Vendor Funded Vouchers' datatype='real' name='[Calculation_3782601536483106829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Currency (copy)] = &quot;offers&quot; then [offers_vendor_funded_non_df_non_joker_vouchers] else [vendor_funded_non_df_non_joker_vouchers] END' />
            </column>
            <column caption='Joker Vouchers' datatype='real' name='[Calculation_3782601536483328014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Currency (copy)] = &quot;offers&quot; then [offers_vendor_funded_joker_vouchers] else [joker_voucher_local] END' />
            </column>
            <column caption='Container Charges' datatype='real' name='[Calculation_3782601536899362832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_difference_from_container_charges] = TRUE THEN 0&#10;ELSEIF [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN [container_charges_local] ELSE [container_charges_local]/[fx_rate] END' />
            </column>
            <column caption='K11300 - Couriers / ODR Delivery fees' datatype='real' name='[Calculation_3782601536905490449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN [laas_delivery_fee_local] ELSE [laas_delivery_fee_local]/[fx_rate] END' />
            </column>
            <column caption='K11100 - GMV paid online' datatype='real' name='[Calculation_3782601536913223699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_paid_online] then [Calculation_3782601536480915464] else 0 end' />
            </column>
            <column caption='K11800 - GMV from Subscribed Customers Orders' datatype='real' name='[Calculation_3782601536913440788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_subscriber_order] then [Calculation_3782601536480915464] else 0 end' />
            </column>
            <column caption='K11080 - Orders paid online' datatype='integer' name='[Calculation_3782601536914161687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_paid_online] then [order_count] else 0 end' />
            </column>
            <column caption='K11750 - Orders from Subscribed Customers' datatype='integer' name='[Calculation_3782601536914370584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_subscriber_order] then [order_count] else 0 end' />
            </column>
            <column caption='New Customer DF Incentives' datatype='real' name='[Calculation_5618662810647900160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [delivery_type] = &quot;OD&quot; AND [is_acquisition] THEN&#10;&#10;IF [Parameters].[Currency (copy)] = &quot;offers&quot; then &#10;[offers_dh_dps_new_customer_discount_local] &#10;+ [offers_vendor_dps_new_customer_discount_local]&#10;+ [offers_dh_funded_non_subscriber_df_mmt_discounts] &#10;+ [offers_dh_funded_non_subscriber_df_mmt_vouchers] &#10;+ [offers_vendor_funded_non_subscriber_df_mmt_discounts] &#10;+ [offers_vendor_funded_non_subscriber_df_mmt_vouchers] &#10;ELSE &#10;[dh_funded_non_subscriber_df_discounts]&#10;+ [dh_funded_non_subscriber_df_vouchers]&#10;+ [vendor_funded_non_subscriber_df_discounts]&#10;+ [vendor_funded_non_subscriber_df_vouchers]&#10;+ [pd_dps_dh_funded_dps_new_customer_discount_local]&#10;+ [pd_dps_vendor_funded_dps_new_customer_discount_local]&#10;END&#10;&#10;ELSE 0 END' />
            </column>
            <column caption='K11600 - Marketing Delivery Fee Reduction - Acquisition' datatype='real' name='[Calculation_5618662810649616385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; then [Calculation_5618662810647900160]&#10;ELSE [Calculation_5618662810647900160] / [fx_rate] END' />
            </column>
            <column caption='K11550 - Marketing Subscription Delivery Fee Reduction - Retention' datatype='real' name='[K11500 - Marketing Delivery Fee Reduction - Retention (copy)_5618662810651570181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; then [Non Subscriber DF Incentives (copy)_5618662810651095044]&#10;ELSE [Non Subscriber DF Incentives (copy)_5618662810651095044] / [fx_rate] END' />
            </column>
            <column caption='K11500 - Marketing Delivery Fee Reduction - Retention' datatype='real' name='[K11600 - Marketing Delivery Fee Reduction - Acquisition (copy)_5618662810650820611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; then [New Customer DF Incentives (copy)_5618662810649952258]&#10;ELSE [New Customer DF Incentives (copy)_5618662810649952258] / [fx_rate] END' />
            </column>
            <column caption='Non Subscriber DF Incentives' datatype='real' name='[New Customer DF Incentives (copy)_5618662810649952258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [delivery_type] = &quot;OD&quot; AND NOT [is_acquisition] THEN&#10;&#10;IF [Parameters].[Currency (copy)] = &quot;offers&quot; then &#10;[offers_dh_dps_non_subscriber_discount_local] &#10;+ [offers_vendor_dps_non_subscriber_discount_local]&#10;+ [offers_dh_funded_non_subscriber_df_mmt_discounts] &#10;+ [offers_dh_funded_non_subscriber_df_mmt_vouchers] &#10;+ [offers_vendor_funded_non_subscriber_df_mmt_discounts] &#10;+ [offers_vendor_funded_non_subscriber_df_mmt_vouchers] &#10;ELSE &#10;[dh_funded_non_subscriber_df_discounts]&#10;+ [dh_funded_non_subscriber_df_vouchers]&#10;+ [vendor_funded_non_subscriber_df_discounts]&#10;+ [vendor_funded_non_subscriber_df_vouchers]&#10;+ [pd_dps_dh_funded_dps_non_subscription_discount_local]&#10;+ [pd_dps_vendor_funded_dps_non_subscription_discount_local]&#10;END&#10;&#10;ELSE 0 END' />
            </column>
            <column caption='Subscriber DF Incentives' datatype='real' name='[Non Subscriber DF Incentives (copy)_5618662810651095044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [delivery_type] = &quot;OD&quot; AND NOT [is_acquisition] THEN&#10;&#10;if [region] = &quot;APAC&quot; THEN [loss_delivery_fee_plus_vat_local] ELSE&#10;&#10;IF [Parameters].[Currency (copy)] = &quot;offers&quot; then &#10;[offers_dh_dps_subscriber_discount_local] &#10;+ [offers_dh_funded_subscriber_df_mmt_discounts] &#10;+ [offers_dh_funded_subscriber_df_mmt_vouchers] &#10;+ [offers_vendor_dps_subscriber_discount_local] &#10;+ [offers_vendor_funded_subscriber_df_mmt_discounts] &#10;+ [offers_vendor_funded_subscriber_df_mmt_vouchers] &#10;&#10;ELSE &#10;[dh_funded_subscriber_df_discounts]&#10;+ [dh_funded_subscriber_df_vouchers]&#10;+ [pd_dps_dh_funded_dps_subscription_discount_local]&#10;+ [vendor_funded_subscriber_df_discounts]&#10;+ [vendor_funded_subscriber_df_vouchers]&#10;+ [pd_dps_vendor_funded_dps_subscription_discount_local]&#10;END&#10;&#10;END&#10;&#10;ELSE 0 END' />
