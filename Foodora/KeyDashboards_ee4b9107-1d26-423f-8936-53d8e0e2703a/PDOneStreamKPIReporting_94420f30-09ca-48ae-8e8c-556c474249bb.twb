  0 AS offers_vendor_dps_non_subscriber_discount_local,
  0 AS active_subscribers,
  COUNT(DISTINCT analytical_customer_id) AS active_users,
  0 AS outlets_online,
  0 AS wallet_incentives_local,
  0 AS loss_delivery_fee_plus_vat_local
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders
WHERE created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 12 MONTH) AND is_successful
GROUP BY ALL

UNION ALL

SELECT
  kpi.globaL_entity_id,
  CASE WHEN countries.name IN ("Austria", "Sweden", "Norway", "Finland", "Hungary", "Czech Republic", "Turkey") THEN "Europe"
  ELSE "APAC" END AS region,
  countries.name AS  country_name,
  DATE_TRUNC(kpi.report_date, MONTH) AS report_month,
  DATE_TRUNC(kpi.report_date, MONTH) AS order_date,
  CASE WHEN business_type.business_type LIKE "%laas%" THEN "laas" ELSE business_type.business_type END AS business_type,
  CASE 
    WHEN business_type.business_type LIKE "%laas%" THEN "PF_DAN"
    WHEN business_type.business_type IN ("caterers", "restaurants") THEN "PF_RES"
    WHEN business_type.business_type IN ("shops") THEN "PF_QCL"
    WHEN business_type.business_type IN ("kitchens", "concepts") THEN "PF_KIT"
    WHEN business_type.business_type IN ("dmart") THEN "PF_QCD" 
    ELSE "PF_OTH"
  END AS onestream_business_line,
  "CH_NO" AS delivery_type,
  NULL AS is_laas_order,
  NULL AS is_subscriber_order,
  NULL AS is_acquisition,
  NULL AS is_paid_online,
  NULL AS is_difference_from_container_charges,
  "Total" AS funding_share,
  1 AS fx_rate,
  0 AS order_count,
  0 AS customer_count,
  0 AS gfv_w_dmart_adj_local,  
  0 AS gfv_local,  
