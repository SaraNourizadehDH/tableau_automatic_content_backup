      <aliases enabled='yes' />
      <column caption='GMV difference' datatype='real' name='[Calculation_2836634450275786766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_3782601536480915464], 0)-IFNULL([K11299 - GMV including incentives (copy)_2836634450092761099], 0)' />
      </column>
      <column caption='Incentive difference' datatype='real' name='[Calculation_2836634450278150159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [onestream_business_line] = &quot;PF_QCD&quot; THEN&#10;(IFNULL([Calculation_3782601536476282883], 0)+ifnull([Calculation_3782601536477032453], 0)) + abs(ifnull([joker_voucher_local], 0))&#10;-(ifnull([K12230 - IV Dmart/Vendor incentives (-) (copy)_2836634450088140806], 0) + ifnull([K11270 - DH funded incentives (-) (copy)_2836634450087776261], 0))&#10;ELSE 0 END' />
      </column>
      <column caption='gfv difference' datatype='real' name='[Calculation_2836634450427174928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3782601536475381760]-[K11200 - GFV / GPV (copy)_2836634450092138503]' />
      </column>
      <column caption='delivery fee difference' datatype='real' name='[Calculation_2836634450427322385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3782601536475574273]-[K11210 - Delivery fee (+) (copy)_2836634450092326920]' />
      </column>
      <column caption='other fee difference' datatype='real' name='[Calculation_2836634450427482130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3782601536475992066]-[K11220 - Other fees (+) (copy)_2836634450092503049]' />
      </column>
      <column caption='K11200 - GFV / GPV' datatype='real' name='[Calculation_3782601536475381760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([gfv_w_dmart_adj_local], 0) + IFNULL([Calculation_3782601536899362832], 0)&#10;ELSE (IFNULL([gfv_w_dmart_adj_local], 0) /[fx_rate]) + IFNULL([Calculation_3782601536899362832], 0) END' />
      </column>
      <column caption='K11210 - Delivery fee (+)' datatype='real' name='[Calculation_3782601536475574273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([df_user_paid_incl_vat_local], 0) + IFNULL([df_priority_incl_vat_local], 0)&#10;ELSE (IFNULL([df_user_paid_incl_vat_local], 0) + IFNULL([df_priority_incl_vat_local], 0))/[fx_rate] END' />
      </column>
      <column caption='K11220 - Other fees (+)' datatype='real' name='[Calculation_3782601536475992066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([service_fee_plus_vat_local], 0) + IFNULL([difference_to_minimum_order_value_plus_vat_local], 0)&#10;ELSE (IFNULL([service_fee_plus_vat_local], 0) + IFNULL([difference_to_minimum_order_value_plus_vat_local], 0))/[fx_rate] END' />
      </column>
      <column caption='K11230 - Vendor funded incentives (-)' datatype='real' name='[Calculation_3782601536476282883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([Calculation_3782601536482856972], 0) + IFNULL([Calculation_3782601536483106829], 0)) * -1&#10;ELSE ((IFNULL([Calculation_3782601536482856972], 0) + IFNULL([Calculation_3782601536483106829], 0)) *-1)/[fx_rate] END' />
      </column>
      <column caption='K11240 - Joker (-)' datatype='real' name='[Calculation_3782601536476622852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([joker_fee_plus_vat_local], 0) + ABS(IFNULL([Calculation_3782601536483328014], 0)))*-1&#10;ELSE ((IFNULL([joker_fee_plus_vat_local], 0) + ABS(IFNULL([Calculation_3782601536483328014], 0)))*-1)/[fx_rate] END' />
      </column>
      <column caption='K11270 - DH funded incentives (-)' datatype='real' name='[Calculation_3782601536477032453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([Calculation_3782601536482365450], 0) + IFNULL([Calculation_3782601536482615307], 0) + IFNULL([dmart_item_discounts], 0)) * -1&#10;ELSE ((IFNULL([Calculation_3782601536482365450], 0) + IFNULL([Calculation_3782601536482615307], 0) + IFNULL([dmart_item_discounts], 0))*-1)/[fx_rate] END' />
      </column>
      <column caption='K11280 - Share of Joker kept by DH = Joker Fee (+)' datatype='real' name='[Calculation_3782601536477302790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([joker_fee_plus_vat_local], 0)&#10;ELSE IFNULL([joker_fee_plus_vat_local], 0)/[fx_rate] END' />
      </column>
      <column caption='K11249 - Vendor generated GMV' datatype='real' name='[Calculation_3782601536480239623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_3782601536475381760], 0)&#10;+ IFNULL([Calculation_3782601536475574273], 0)&#10;+ IFNULL([Calculation_3782601536475992066], 0) &#10;+ IFNULL([Calculation_3782601536476282883], 0) &#10;+ IFNULL([Calculation_3782601536476622852], 0)' />
      </column>
      <column caption='K11299 - GMV including incentives' datatype='real' name='[Calculation_3782601536480915464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_3782601536480239623], 0)&#10;+ IFNULL([Calculation_3782601536477032453], 0)&#10;+ IFNULL([Calculation_3782601536477302790], 0)' />
