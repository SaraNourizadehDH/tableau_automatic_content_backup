  0 AS offers_dh_dps_new_customer_discount_local,
  0 AS offers_vendor_dps_new_customer_discount_local,
  0 AS offers_dh_dps_subscriber_discount_local,
  0 AS offers_vendor_dps_subscriber_discount_local,
  0 AS offers_dh_dps_non_subscriber_discount_local,
  0 AS offers_vendor_dps_non_subscriber_discount_local,
  SUM(active_subscribers) AS active_subscribers,
  0 AS active_users,
  0 AS outlets_online,
  0 AS wallet_incentives_local,
  0 AS loss_delivery_fee_plus_vat_local
FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn` AS subs
INNER JOIN (
    SELECT 
      DATE_TRUNC(report_date, MONTH) AS month_start,
      MAX(report_date) AS month_end
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
    WHERE report_date << CURRENT_DATE
    GROUP BY ALL
) m
        ON subs.report_date = m.month_end
WHERE report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 12 MONTH)
GROUP BY ALL

UNION ALL

