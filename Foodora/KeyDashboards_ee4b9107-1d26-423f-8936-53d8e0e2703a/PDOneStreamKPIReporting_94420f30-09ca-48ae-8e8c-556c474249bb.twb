  0 AS offers_vendor_funded_joker_vouchers,  
  0 AS offers_vendor_funded_non_df_non_joker_vouchers,  
  0 AS offers_vendor_funded_non_df_discounts,  
  0 AS offers_dh_funded_non_df_discounts,  
