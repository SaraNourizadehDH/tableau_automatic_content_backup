  0 AS offers_dh_dps_subscriber_discount_local,
  0 AS offers_vendor_dps_subscriber_discount_local,
  0 AS offers_dh_dps_non_subscriber_discount_local,
  0 AS offers_vendor_dps_non_subscriber_discount_local,
  0 AS active_subscribers,
  0 AS active_users,
  COUNT(DISTINCT CASE WHEN kpi.is_online THEN kpi.vendor_id END) AS outlets_online,
  0 AS wallet_incentives_local,
  0 AS loss_delivery_fee_plus_vat_local
  
FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.agg_vendor_kpis_daily` AS kpi
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendors
       ON kpi.global_entity_id = vendors.global_entity_id
      AND kpi.vendor_id = vendors.vendor_code
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__core_vendor_business_types` AS business_type
       ON kpi.global_entity_id = business_type.global_entity_id
      AND kpi.vendor_id = business_type.vendor_code
INNER JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS countries
        ON kpi.global_entity_id = countries.global_entity_id
WHERE report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 12 MONTH)
GROUP BY ALL]]></relation>
