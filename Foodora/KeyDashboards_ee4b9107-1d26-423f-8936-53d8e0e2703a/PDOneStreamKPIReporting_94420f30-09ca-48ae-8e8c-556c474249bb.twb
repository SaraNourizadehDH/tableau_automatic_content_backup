  0 AS pd_dps_vendor_funded_dps_subscription_discount_local,
  0 AS pd_dps_dh_funded_dps_new_customer_discount_local,
  0 AS pd_dps_vendor_funded_dps_new_customer_discount_local,
  0 AS pd_dps_dh_funded_dps_non_subscription_discount_local,
  0 AS pd_dps_vendor_funded_dps_non_subscription_discount_local,

  0 AS offers_dh_funded_subscriber_df_mmt_vouchers,
  0 AS offers_dh_funded_subscriber_df_mmt_discounts,
