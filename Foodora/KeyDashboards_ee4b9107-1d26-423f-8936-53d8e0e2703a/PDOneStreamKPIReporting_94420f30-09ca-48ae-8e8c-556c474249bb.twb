    <worksheet name='Dmart GMV'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b8209d' fontname='Tableau Light' fontsize='18'>IV-DMT GMV Reporting</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (fd_finance)' name='federated.0sso5421chdsnl10ks0f70gh0009' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Incentive Source' datatype='string' name='[Currency (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;offers&quot;'>
              <calculation class='tableau' formula='&quot;offers&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[dh_funded_non_df_discounts Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sso5421chdsnl10ks0f70gh0009'>
            <column caption='Container Charges' datatype='real' name='[Calculation_3782601536899362832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_difference_from_container_charges] = TRUE THEN 0&#10;ELSEIF [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN [container_charges_local] ELSE [container_charges_local]/[fx_rate] END' />
            </column>
            <column caption='IV Platform Funded discounts' datatype='real' name='[DH Funded Discounts (copy)_2836634450085609472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Currency (copy)] = &quot;offers&quot; THEN &#10;    IFNULL([dmart_platform_funded_offers_discounts], 0) + IFNULL([wallet_incentives_local], 0)&#10;ELSE &#10;    IFNULL([dmart_platform_funded_discounts], 0) + IFNULL([wallet_incentives_local], 0)&#10;END' />
            </column>
            <column caption='IV Dmart Funded vouchers' datatype='real' name='[IV Dmart Funded discounts (copy)_2836634450087038980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Currency (copy)] = &quot;offers&quot; THEN &#10;    IFNULL([offers_dh_funded_non_df_vouchers], 0) &#10;    + IFNULL([offers_vendor_funded_non_df_non_joker_vouchers], 0) &#10;  &#10;    - IFNULL([dmart_platform_funded_offers_vouchers], 0)&#10;&#10;ELSE&#10;    IFNULL([dh_funded_non_df_vouchers], 0) &#10;    + IFNULL([vendor_funded_non_df_non_joker_vouchers], 0) &#10;    &#10;    - IFNULL([dmart_platform_funded_vouchers], 0)&#10;END' />
            </column>
            <column caption='IV Platform Funded vouchers' datatype='real' name='[IV Platform Funded discounts (copy)_2836634450085847041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Currency (copy)] = &quot;offers&quot; THEN &#10;    IFNULL([dmart_platform_funded_offers_vouchers], 0) + ifnull([offers_vendor_funded_joker_vouchers], 0)&#10;ELSE &#10;    IFNULL([dmart_platform_funded_vouchers], 0) + ifnull([joker_voucher_local], 0)&#10;END' />
            </column>
            <column caption='IV Dmart Funded discounts' datatype='real' name='[IV Platform Funded discounts (copy)_2836634450086055938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Currency (copy)] = &quot;offers&quot; then &#10;IFNULL([offers_dh_funded_non_df_discounts], 0) + ifnull([offers_vendor_funded_non_df_discounts], 0) - ifnull([dmart_platform_funded_offers_discounts], 0) + ifnull([dmart_item_discounts], 0)&#10;else ifnuLL([dh_funded_non_df_discounts], 0) + ifnull([vendor_funded_non_df_discounts], 0) - ifnull([dmart_platform_funded_discounts], 0) + ifnull([dmart_item_discounts], 0)&#10;END' />
            </column>
            <column caption='K12200 - IV GFV / GPV' datatype='real' name='[K11200 - GFV / GPV (copy)_2836634450092138503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([gfv_w_dmart_adj_local], 0) + IFNULL([Calculation_3782601536899362832], 0)&#10;ELSE (IFNULL([gfv_w_dmart_adj_local], 0) /[fx_rate]) + IFNULL([Calculation_3782601536899362832], 0) END' />
            </column>
            <column caption='K12210 - IV Delivery fee (+)' datatype='real' name='[K11210 - Delivery fee (+) (copy)_2836634450092326920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([df_user_paid_incl_vat_local], 0) + IFNULL([df_priority_incl_vat_local], 0)&#10;ELSE (IFNULL([df_user_paid_incl_vat_local], 0) + IFNULL([df_priority_incl_vat_local], 0))/[fx_rate] END' />
            </column>
            <column caption='K12220 - IV Other fees (+)' datatype='real' name='[K11220 - Other fees (+) (copy)_2836634450092503049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN IFNULL([service_fee_plus_vat_local], 0) + IFNULL([difference_to_minimum_order_value_plus_vat_local], 0)&#10;ELSE (IFNULL([service_fee_plus_vat_local], 0) + IFNULL([difference_to_minimum_order_value_plus_vat_local], 0))/[fx_rate] END' />
            </column>
            <column caption='K12249 - IV Dmart/Vendor generated GMV' datatype='real' name='[K11249 - Vendor generated GMV (copy)_2836634450092675082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([K11200 - GFV / GPV (copy)_2836634450092138503], 0)&#10;+ IFNULL([K11210 - Delivery fee (+) (copy)_2836634450092326920], 0)&#10;+ IFNULL([K11220 - Other fees (+) (copy)_2836634450092503049], 0) &#10;+ IFNULL([K11270 - DH funded incentives (-) (copy)_2836634450087776261], 0)' />
            </column>
            <column caption='K12230 - IV Dmart/Vendor incentives (-)' datatype='real' name='[K11270 - DH funded incentives (-) (copy)_2836634450087776261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([IV Platform Funded discounts (copy)_2836634450086055938], 0) + IFNULL([IV Dmart Funded discounts (copy)_2836634450087038980], 0)) * -1&#10;ELSE ((IFNULL([IV Platform Funded discounts (copy)_2836634450086055938], 0) + IFNULL([IV Dmart Funded discounts (copy)_2836634450087038980], 0))*-1)/[fx_rate] END' />
            </column>
            <column caption='K12299 - IV GMV including incentives' datatype='real' name='[K11299 - GMV including incentives (copy)_2836634450092761099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([K11249 - Vendor generated GMV (copy)_2836634450092675082], 0)&#10;+ IFNULL([K12230 - IV Dmart/Vendor incentives (-) (copy)_2836634450088140806], 0)' />
            </column>
            <column caption='K12270 - Platform/Group incentives (-)' datatype='real' name='[K12230 - IV Dmart/Vendor incentives (-) (copy)_2836634450088140806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[dh_funded_non_df_discounts Parameter] = &quot;Local&quot; THEN (IFNULL([DH Funded Discounts (copy)_2836634450085609472], 0) + IFNULL([IV Platform Funded discounts (copy)_2836634450085847041], 0)) * -1&#10;ELSE ((IFNULL([DH Funded Discounts (copy)_2836634450085609472], 0) + IFNULL([IV Platform Funded discounts (copy)_2836634450085847041], 0))*-1)/[fx_rate] END' />
            </column>
