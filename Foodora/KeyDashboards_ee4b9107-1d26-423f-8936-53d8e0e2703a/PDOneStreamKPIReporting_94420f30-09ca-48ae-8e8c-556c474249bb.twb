    <datasource caption='Custom SQL Query (fd_finance)' inline='true' name='federated.0sso5421chdsnl10ks0f70gh0009' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.13excgq1vrr6mw14rdgvc0qe7txa'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='EU Data Production' schema='fd_finance' server-oauth='' username='saptarshi.nag@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13excgq1vrr6mw14rdgvc0qe7txa' name='Custom SQL Query' type='text'><![CDATA[WITH month_array AS (
  SELECT 
    DISTINCT
    month_start AS month
  FROM 
    UNNEST(GENERATE_DATE_ARRAY('2024-01-01', '2025-12-01', INTERVAL 1 MONTH)) AS month_start
),

scenario_mapping AS (
  SELECT
    month,
    CASE WHEN month << "2025-08-01" THEN "ACTUAL" ELSE "BE06" END AS scenario
  FROM month_array
),

apac_avg_df_loss AS (
  SELECT
    global_entity_id,
    code AS order_code,
    SUM(loss_delivery_fee_plus_vat_local) AS loss_delivery_fee_plus_vat_local
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_pandapro_loss_df_adjustment`
  WHERE is_free_delivery_foodpanda_funded_subscription_order
      AND is_valid_order
      AND created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 12 MONTH)
  GROUP BY ALL

),

fx_rate_eur AS (
  SELECT
    f_month_date AS month,
    CASE WHEN country = "Czechia" THEN "Czech Republic" ELSE country END AS country,
    pnl.scenario,
    SAFE_DIVIDE(SUM(CASE WHEN currency_flag = "LOCAL" THEN total_revenue ELSE 0 END), SUM(CASE WHEN currency_flag = "EUR" THEN total_revenue ELSE 0 END)) AS fx_rate
  FROM `fulfillment-dwh-production.cl_fsa_os.pandora_os_pnl` AS pnl
  INNER JOIN scenario_mapping AS sc
          ON pnl.f_month_date = sc.month
        AND pnl.scenario = sc.scenario
  GROUP BY ALL
)

SELECT
  kpi.globaL_entity_id,
  CASE WHEN kpi.country_name IN ("Austria", "Sweden", "Norway", "Finland", "Hungary", "Czech Republic", "Turkey") THEN "Europe"
  ELSE "APAC" END AS region,
  kpi.country_name,
  report_month,
  order_date,
  CASE WHEN kpi.business_type LIKE "%laas%" THEN "laas" ELSE kpi.business_type END AS business_type,
  CASE 
    WHEN kpi.business_type LIKE "%laas%" THEN "PF_DAN"
    WHEN kpi.business_type IN ("caterers", "restaurants") THEN "PF_RES"
    WHEN kpi.business_type IN ("shops") THEN "PF_QCL"
    WHEN kpi.business_type IN ("kitchens", "concepts") THEN "PF_KIT"
    WHEN kpi.business_type IN ("dmart") THEN "PF_QCD" 
    ELSE "PF_OTH"
  END AS onestream_business_line,
  kpi.delivery_type,
  kpi.is_laas_order,
  kpi.is_subscriber_order,
  kpi.is_acquisition,
  kpi.is_paid_online,
  kpi.container_charges_local >> 0 AND offers_gmv_finance - kpi.user_paid_gmv_local = kpi.container_charges_local AS is_difference_from_container_charges,
  "Total" AS funding_share,
  fx.fx_rate,
  COUNT(DISTINCT kpi.order_code) AS order_count,
  COUNT(DISTINCT kpi.analytical_customer_id) AS customer_count,
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE gfv_w_dmart_adj_local END) AS gfv_w_dmart_adj_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.gfv_local END) AS gfv_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.df_user_paid_incl_vat_local END) AS df_user_paid_incl_vat_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.df_priority_incl_vat_local END) AS df_priority_incl_vat_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.service_fee_plus_vat_local END) AS service_fee_plus_vat_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.difference_to_minimum_order_value_plus_vat_local END) AS difference_to_minimum_order_value_plus_vat_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.container_charges_local END) AS container_charges_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE joker_voucher_local END) AS joker_voucher_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE vendor_funded_non_df_non_joker_vouchers END) AS vendor_funded_non_df_non_joker_vouchers,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE vendor_funded_non_df_discounts END) AS vendor_funded_non_df_discounts,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE dh_funded_non_df_discounts END) AS dh_funded_non_df_discounts,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE dh_funded_non_df_vouchers END) AS dh_funded_non_df_vouchers,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE dmart_item_discounts END) AS dmart_item_discounts,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.corporate_allowance_local END) AS corporate_allowance_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.customer_paid_loyalty_local END) AS customer_paid_loyalty_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.joker_fee_plus_vat_local END) AS joker_fee_plus_vat_local,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE offers_vendor_funded_joker_vouchers END) AS offers_vendor_funded_joker_vouchers,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE offers_vendor_funded_non_df_non_joker_vouchers END) AS offers_vendor_funded_non_df_non_joker_vouchers,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE offers_vendor_funded_non_df_discounts END) AS offers_vendor_funded_non_df_discounts,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE offers_dh_funded_non_df_discounts END) AS offers_dh_funded_non_df_discounts,  
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE offers_dh_funded_non_df_vouchers END) AS offers_dh_funded_non_df_vouchers,
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE offers_gmv_finance END) AS offers_gmv_finance,
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN 0 ELSE kpi.user_paid_gmv_local END) AS user_paid_gmv_local,
  SUM(CASE WHEN kpi.business_type LIKE "%laas%" THEN kpi.df_user_paid_incl_vat_local ELSE 0 END) AS laas_delivery_fee_local,
  SUM(
    CASE 
      WHEN kpi.business_type = "dmart" AND (IFNULL(orders.is_subscription_voucher_order, FALSE) OR IFNULL(orders.voucher_purpose IN ("compensation", "refund", "autocompensation_realtime", "sorry_panda"), FALSE)) 
      THEN COALESCE(vendor_funded_non_df_non_joker_vouchers, 0) + COALESCE(dh_funded_non_df_vouchers, 0)
    ELSE 0 END
  ) AS dmart_platform_funded_vouchers,
  SUM(
    CASE 
      WHEN kpi.business_type = "dmart" AND IFNULL(orders.is_subscription_discount_order, FALSE) 
      THEN COALESCE(vendor_funded_non_df_discounts, 0) + COALESCE(dh_funded_non_df_discounts, 0)
    ELSE 0 END
  ) AS dmart_platform_funded_discounts,

  SUM(
    CASE 
      WHEN kpi.business_type = "dmart" AND (IFNULL(orders.is_subscription_voucher_order, FALSE) OR IFNULL(orders.voucher_purpose IN ("compensation", "refund", "autocompensation_realtime", "sorry_panda"), FALSE)) 
      THEN COALESCE(offers_vendor_funded_non_df_non_joker_vouchers, 0) + COALESCE(offers_dh_funded_non_df_vouchers, 0)
    ELSE 0 END
  ) AS dmart_platform_funded_offers_vouchers,
  SUM(
    CASE 
      WHEN kpi.business_type = "dmart" AND IFNULL(orders.is_subscription_discount_order, FALSE) 
      THEN COALESCE(offers_vendor_funded_non_df_discounts, 0) + COALESCE(offers_dh_funded_non_df_discounts, 0)
    ELSE 0 END
  ) AS dmart_platform_funded_offers_discounts,

  SUM(vendor_funded_subscriber_df_vouchers) AS vendor_funded_subscriber_df_vouchers,
  SUM(vendor_funded_subscriber_df_discounts) AS vendor_funded_subscriber_df_discounts,
  SUM(dh_funded_subscriber_df_discounts) AS dh_funded_subscriber_df_discounts,
  SUM(dh_funded_subscriber_df_vouchers) AS dh_funded_subscriber_df_vouchers,
  SUM(vendor_funded_non_subscriber_df_vouchers) AS vendor_funded_non_subscriber_df_vouchers,
  SUM(vendor_funded_non_subscriber_df_discounts) AS vendor_funded_non_subscriber_df_discounts,
  SUM(dh_funded_non_subscriber_df_discounts) AS dh_funded_non_subscriber_df_discounts,
  SUM(dh_funded_non_subscriber_df_vouchers) AS dh_funded_non_subscriber_df_vouchers,
  SUM(pd_dps_dh_funded_dps_subscription_discount_local) AS pd_dps_dh_funded_dps_subscription_discount_local,
  SUM(pd_dps_vendor_funded_dps_subscription_discount_local) AS pd_dps_vendor_funded_dps_subscription_discount_local,
  SUM(pd_dps_dh_funded_dps_new_customer_discount_local) AS pd_dps_dh_funded_dps_new_customer_discount_local,
  SUM(pd_dps_vendor_funded_dps_new_customer_discount_local) AS pd_dps_vendor_funded_dps_new_customer_discount_local,
  SUM(pd_dps_dh_funded_dps_non_subscription_discount_local) AS pd_dps_dh_funded_dps_non_subscription_discount_local,
  SUM(pd_dps_vendor_funded_dps_non_subscription_discount_local) AS pd_dps_vendor_funded_dps_non_subscription_discount_local,
  
  SUM(offers_dh_funded_subscriber_df_mmt_vouchers) AS offers_dh_funded_subscriber_df_mmt_vouchers,
  SUM(offers_dh_funded_subscriber_df_mmt_discounts) AS offers_dh_funded_subscriber_df_mmt_discounts,
  SUM(offers_vendor_funded_subscriber_df_mmt_vouchers) AS offers_vendor_funded_subscriber_df_mmt_vouchers,
  SUM(offers_vendor_funded_subscriber_df_mmt_discounts) AS offers_vendor_funded_subscriber_df_mmt_discounts,
  SUM(offers_dh_funded_non_subscriber_df_mmt_vouchers) AS offers_dh_funded_non_subscriber_df_mmt_vouchers,
  SUM(offers_dh_funded_non_subscriber_df_mmt_discounts) AS offers_dh_funded_non_subscriber_df_mmt_discounts,
  SUM(offers_vendor_funded_non_subscriber_df_mmt_vouchers) AS offers_vendor_funded_non_subscriber_df_mmt_vouchers,
  SUM(offers_vendor_funded_non_subscriber_df_mmt_discounts) AS offers_vendor_funded_non_subscriber_df_mmt_discounts,
  
  SUM(offers_dh_dps_new_customer_discount_local) AS offers_dh_dps_new_customer_discount_local,
  SUM(offers_vendor_dps_new_customer_discount_local) AS offers_vendor_dps_new_customer_discount_local,
  SUM(offers_dh_dps_subscriber_discount_local) AS offers_dh_dps_subscriber_discount_local,
  SUM(offers_vendor_dps_subscriber_discount_local) AS offers_vendor_dps_subscriber_discount_local,
  SUM(offers_dh_dps_non_subscriber_discount_local) AS offers_dh_dps_non_subscriber_discount_local,
  SUM(offers_vendor_dps_non_subscriber_discount_local) AS offers_vendor_dps_non_subscriber_discount_local,
  0 AS active_subscribers,
  0 AS active_users,
  0 AS outlets_online,
  SUM(wallet_incentives_local) AS wallet_incentives_local,
  SUM(loss_delivery_fee_plus_vat_local) AS loss_delivery_fee_plus_vat_local
FROM `fulfillment-dwh-production.pandata_report.finance__onestream_kpi_report` AS kpi
LEFT JOIN fx_rate_eur AS fx
       ON kpi.country_name = fx.country
       AND kpi.report_month = fx.month
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders
       ON kpi.global_entity_id = orders.global_entity_id
      AND kpi.order_code = orders.order_code
      AND orders.created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 12 MONTH)
LEFT JOIN apac_avg_df_loss
       ON kpi.order_code = apac_avg_df_loss.order_code
      AND kpi.global_entity_id = apac_avg_df_loss.global_entity_id
GROUP BY ALL

UNION ALL

SELECT
  kpi.globaL_entity_id,
  CASE WHEN country_name IN ("Austria", "Sweden", "Norway", "Finland", "Hungary", "Czech Republic", "Turkey") THEN "Europe"
  ELSE "APAC" END AS region,
  country_name,
  report_month,
  order_date,
  CASE WHEN business_type LIKE "%laas%" THEN "laas" ELSE business_type END AS business_type,
  CASE 
    WHEN business_type LIKE "%laas%" THEN "PF_DAN"
    WHEN business_type IN ("caterers", "restaurants") THEN "PF_RES"
    WHEN business_type IN ("shops") THEN "PF_QCL"
    WHEN business_type IN ("kitchens", "concepts") THEN "PF_KIT"
    WHEN business_type IN ("dmart") THEN "PF_QCD" 
    ELSE "PF_OTH"
  END AS onestream_business_line,
  delivery_type,
  is_laas_order,
  is_subscriber_order,
  is_acquisition,
  is_paid_online,
  container_charges_local >> 0 AND offers_gmv_finance - user_paid_gmv_local = container_charges_local AS is_difference_from_container_charges,
  "DH Funded" AS funding_share,
  fx.fx_rate,
  0 AS order_count,
  0 AS customer_count,
  0 AS gfv_w_dmart_adj_local,  
  0 AS gfv_local,  
  0 AS df_user_paid_incl_vat_local,  
  0 AS df_priority_incl_vat_local,  
  0 AS service_fee_plus_vat_local,  
  0 AS difference_to_minimum_order_value_plus_vat_local,  
  0 AS container_charges_local,  
  0 AS joker_voucher_local,  
  0 AS vendor_funded_non_df_non_joker_vouchers,  
  0 AS vendor_funded_non_df_discounts,  
  0 AS dh_funded_non_df_discounts,  
  0 AS dh_funded_non_df_vouchers,  
  0 AS dmart_item_discounts,  
  0 AS corporate_allowance_local,  
  0 AS customer_paid_loyalty_local,  
  0 AS joker_fee_plus_vat_local,  
  0 AS offers_vendor_funded_joker_vouchers,  
  0 AS offers_vendor_funded_non_df_non_joker_vouchers,  
  0 AS offers_vendor_funded_non_df_discounts,  
  0 AS offers_dh_funded_non_df_discounts,  
  0 AS offers_dh_funded_non_df_vouchers,
  0 AS offers_gmv_finance,
  0 AS user_paid_gmv_local,
  0 AS laas_delivery_fee_local,
  0 AS dmart_platform_funded_vouchers,
  0 AS dmart_platform_funded_discounts,
  0 AS dmart_platform_funded_offers_vouchers,
  0 AS dmart_platform_funded_offers_discounts,


  0 AS vendor_funded_subscriber_df_vouchers,
  0 AS vendor_funded_subscriber_df_discounts,
  SUM(dh_funded_subscriber_df_discounts) AS dh_funded_subscriber_df_discounts,
  SUM(dh_funded_subscriber_df_vouchers) AS dh_funded_subscriber_df_vouchers,
  0 AS vendor_funded_non_subscriber_df_vouchers,
  0 AS vendor_funded_non_subscriber_df_discounts,
  SUM(dh_funded_non_subscriber_df_discounts) AS dh_funded_non_subscriber_df_discounts,
  SUM(dh_funded_non_subscriber_df_vouchers) AS dh_funded_non_subscriber_df_vouchers,
  SUM(pd_dps_dh_funded_dps_subscription_discount_local) AS pd_dps_dh_funded_dps_subscription_discount_local,
  0 AS pd_dps_vendor_funded_dps_subscription_discount_local,
  SUM(pd_dps_dh_funded_dps_new_customer_discount_local) AS pd_dps_dh_funded_dps_new_customer_discount_local,
  0 AS pd_dps_vendor_funded_dps_new_customer_discount_local,
  SUM(pd_dps_dh_funded_dps_non_subscription_discount_local) AS pd_dps_dh_funded_dps_non_subscription_discount_local,
  0 AS pd_dps_vendor_funded_dps_non_subscription_discount_local,

  SUM(offers_dh_funded_subscriber_df_mmt_vouchers) AS offers_dh_funded_subscriber_df_mmt_vouchers,
  SUM(offers_dh_funded_subscriber_df_mmt_discounts) AS offers_dh_funded_subscriber_df_mmt_discounts,
  0 AS offers_vendor_funded_subscriber_df_mmt_vouchers,
  0 AS offers_vendor_funded_subscriber_df_mmt_discounts,
  SUM(offers_dh_funded_non_subscriber_df_mmt_vouchers) AS offers_dh_funded_non_subscriber_df_mmt_vouchers,
  SUM(offers_dh_funded_non_subscriber_df_mmt_discounts) AS offers_dh_funded_non_subscriber_df_mmt_discounts,
  0 AS offers_vendor_funded_non_subscriber_df_mmt_vouchers,
  0 AS offers_vendor_funded_non_subscriber_df_mmt_discounts,

  SUM(offers_dh_dps_new_customer_discount_local) AS offers_dh_dps_new_customer_discount_local,
  0 AS offers_vendor_dps_new_customer_discount_local,
  SUM(offers_dh_dps_subscriber_discount_local) AS offers_dh_dps_subscriber_discount_local,
  0 AS offers_vendor_dps_subscriber_discount_local,
  SUM(offers_dh_dps_non_subscriber_discount_local) AS offers_dh_dps_non_subscriber_discount_local,
  0 AS offers_vendor_dps_non_subscriber_discount_local,
  0 AS active_subscribers,
  0 AS active_users,
  0 AS outlets_online,
  0 AS wallet_incentives_local,
  SUM(
    SAFE_DIVIDE(
      (
        COALESCE(offers_dh_dps_subscriber_discount_local, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_vouchers, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_discounts, 0)
      ),
      (
        COALESCE(offers_dh_dps_subscriber_discount_local, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_vouchers, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_discounts, 0)
        + COALESCE(offers_vendor_dps_subscriber_discount_local, 0)
        + COALESCE(offers_vendor_funded_subscriber_df_mmt_vouchers, 0)
        + COALESCE(offers_vendor_funded_subscriber_df_mmt_discounts, 0)
      )
    ) *
    COALESCE(loss_delivery_fee_plus_vat_local, 0)
  ) AS loss_delivery_fee_plus_vat_local

FROM `fulfillment-dwh-production.pandata_report.finance__onestream_kpi_report` AS kpi
LEFT JOIN fx_rate_eur AS fx
       ON kpi.country_name = fx.country
       AND kpi.report_month = fx.month
LEFT JOIN apac_avg_df_loss
       ON kpi.order_code = apac_avg_df_loss.order_code
      AND kpi.global_entity_id = apac_avg_df_loss.global_entity_id
GROUP BY ALL

UNION ALL

SELECT
  kpi.globaL_entity_id,
  CASE WHEN country_name IN ("Austria", "Sweden", "Norway", "Finland", "Hungary", "Czech Republic", "Turkey") THEN "Europe"
  ELSE "APAC" END AS region,
  country_name,
  report_month,
  order_date,
  CASE WHEN business_type LIKE "%laas%" THEN "laas" ELSE business_type END AS business_type,
  CASE 
    WHEN business_type LIKE "%laas%" THEN "PF_DAN"
    WHEN business_type IN ("caterers", "restaurants") THEN "PF_RES"
    WHEN business_type IN ("shops") THEN "PF_QCL"
    WHEN business_type IN ("kitchens", "concepts") THEN "PF_KIT"
    WHEN business_type IN ("dmart") THEN "PF_QCD" 
    ELSE "PF_OTH"
  END AS onestream_business_line,
  delivery_type,
  is_laas_order,
  is_subscriber_order,
  is_acquisition,
  is_paid_online,
  container_charges_local >> 0 AND offers_gmv_finance - user_paid_gmv_local = container_charges_local AS is_difference_from_container_charges,
  "Vendor Funded" AS funding_share,
  fx.fx_rate,
  0 AS order_count,
  0 AS customer_count,
  0 AS gfv_w_dmart_adj_local,  
  0 AS gfv_local,  
  0 AS df_user_paid_incl_vat_local,  
  0 AS df_priority_incl_vat_local,  
  0 AS service_fee_plus_vat_local,  
  0 AS difference_to_minimum_order_value_plus_vat_local,  
  0 AS container_charges_local,  
  0 AS joker_voucher_local,  
  0 AS vendor_funded_non_df_non_joker_vouchers,  
  0 AS vendor_funded_non_df_discounts,  
  0 AS dh_funded_non_df_discounts,  
  0 AS dh_funded_non_df_vouchers,  
  0 AS dmart_item_discounts,  
  0 AS corporate_allowance_local,  
  0 AS customer_paid_loyalty_local,  
  0 AS joker_fee_plus_vat_local,  
  0 AS offers_vendor_funded_joker_vouchers,  
  0 AS offers_vendor_funded_non_df_non_joker_vouchers,  
  0 AS offers_vendor_funded_non_df_discounts,  
  0 AS offers_dh_funded_non_df_discounts,  
  0 AS offers_dh_funded_non_df_vouchers,
  0 AS offers_gmv_finance,
  0 AS user_paid_gmv_local,
  0 AS laas_delivery_fee_local,
  0 AS dmart_platform_funded_vouchers,
  0 AS dmart_platform_funded_discounts,
  0 AS dmart_platform_funded_offers_vouchers,
  0 AS dmart_platform_funded_offers_discounts,

  SUM(vendor_funded_subscriber_df_vouchers) AS vendor_funded_subscriber_df_vouchers,
  SUM(vendor_funded_subscriber_df_discounts) AS vendor_funded_subscriber_df_discounts,
  0 AS dh_funded_subscriber_df_discounts,
  0 AS dh_funded_subscriber_df_vouchers,
  SUM(vendor_funded_non_subscriber_df_vouchers) AS vendor_funded_non_subscriber_df_vouchers,
  SUM(vendor_funded_non_subscriber_df_discounts) AS vendor_funded_non_subscriber_df_discounts,
  0 AS dh_funded_non_subscriber_df_discounts,
  0 AS dh_funded_non_subscriber_df_vouchers,
  0 AS pd_dps_dh_funded_dps_subscription_discount_local,
  SUM(pd_dps_vendor_funded_dps_subscription_discount_local) AS pd_dps_vendor_funded_dps_subscription_discount_local,
  0 AS pd_dps_dh_funded_dps_new_customer_discount_local,
  SUM(pd_dps_vendor_funded_dps_new_customer_discount_local) AS pd_dps_vendor_funded_dps_new_customer_discount_local,
  0 AS pd_dps_dh_funded_dps_non_subscription_discount_local,
  SUM(pd_dps_vendor_funded_dps_non_subscription_discount_local) AS pd_dps_vendor_funded_dps_non_subscription_discount_local,

  0 AS offers_dh_funded_subscriber_df_mmt_vouchers,
  0 AS offers_dh_funded_subscriber_df_mmt_discounts,
  SUM(offers_vendor_funded_subscriber_df_mmt_vouchers) AS offers_vendor_funded_subscriber_df_mmt_vouchers,
  SUM(offers_vendor_funded_subscriber_df_mmt_discounts) AS offers_vendor_funded_subscriber_df_mmt_discounts,
  0 AS offers_dh_funded_non_subscriber_df_mmt_vouchers,
  0 AS offers_dh_funded_non_subscriber_df_mmt_discounts,
  SUM(offers_vendor_funded_non_subscriber_df_mmt_vouchers) AS offers_vendor_funded_non_subscriber_df_mmt_vouchers,
  SUM(offers_vendor_funded_non_subscriber_df_mmt_discounts) AS offers_vendor_funded_non_subscriber_df_mmt_discounts,

  0 AS offers_dh_dps_new_customer_discount_local,
  SUM(offers_vendor_dps_new_customer_discount_local) AS offers_vendor_dps_new_customer_discount_local,
  0 AS offers_dh_dps_subscriber_discount_local,
  SUM(offers_vendor_dps_subscriber_discount_local) AS offers_vendor_dps_subscriber_discount_local,
  0 AS offers_dh_dps_non_subscriber_discount_local,
  SUM(offers_vendor_dps_non_subscriber_discount_local) AS offers_vendor_dps_non_subscriber_discount_local,
  0 AS active_subscribers,
  0 AS active_users,
  0 AS outlets_online,
  0 AS wallet_incentives_local,
  SUM(COALESCE(loss_delivery_fee_plus_vat_local, 0))
  - SUM(
    SAFE_DIVIDE(
      (
        COALESCE(offers_dh_dps_subscriber_discount_local, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_vouchers, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_discounts, 0)
      ),
      (
        COALESCE(offers_dh_dps_subscriber_discount_local, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_vouchers, 0)
        + COALESCE(offers_dh_funded_subscriber_df_mmt_discounts, 0)
        + COALESCE(offers_vendor_dps_subscriber_discount_local, 0)
        + COALESCE(offers_vendor_funded_subscriber_df_mmt_vouchers, 0)
        + COALESCE(offers_vendor_funded_subscriber_df_mmt_discounts, 0)
      )
    ) *
    COALESCE(loss_delivery_fee_plus_vat_local, 0)
  ) AS loss_delivery_fee_plus_vat_local

FROM `fulfillment-dwh-production.pandata_report.finance__onestream_kpi_report` AS kpi
LEFT JOIN fx_rate_eur AS fx
       ON kpi.country_name = fx.country
       AND kpi.report_month = fx.month
LEFT JOIN apac_avg_df_loss
       ON kpi.order_code = apac_avg_df_loss.order_code
      AND kpi.global_entity_id = apac_avg_df_loss.global_entity_id
GROUP BY ALL

UNION ALL

