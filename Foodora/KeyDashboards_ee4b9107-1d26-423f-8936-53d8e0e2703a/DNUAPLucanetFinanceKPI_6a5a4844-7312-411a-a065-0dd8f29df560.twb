    <datasource caption='Vendors Data' inline='true' name='federated.09s0b8d19jdbdn10tntvx087ppvt' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.12eag2t1melizn16xfqa01c6epc4'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Data Production' schema='pandata_ap_finance' server-oauth='' username='jelmer.ochoa@foodpanda.ph' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.12eag2t1melizn16xfqa01c6epc4' name='Custom SQL Query' type='text'><![CDATA[WITH online_vendors AS 
(
SELECT
  DATE_TRUNC(report_date,month) AS month,
  pandora_pd_vendor_status.global_entity_id,
  (CASE WHEN 
  NOT pd_vendors_agg_business_types.business_type_apac_reclassified IS NULL
  AND report_date BETWEEN pd_vendors_agg_business_types.date_reclassified AND pd_vendors_agg_business_types.end_date_reclassified THEN pd_vendors_agg_business_types.business_type_apac_reclassified
    ELSE pd_vendors_agg_business_types.business_type_apac
  END) as vertical,
  COUNT(DISTINCT pandora_pd_vendor_status.vendor_code) AS online_vendors
FROM
  `fulfillment-dwh-production.pandata_report.pandora_vendor_status` pandora_pd_vendor_status
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` pd_vendors_agg_business_types
  on pandora_pd_vendor_status.pd_vendor_uuid  = pd_vendors_agg_business_types.uuid
  
WHERE
  report_date >>= "2021-01-01"
  AND pandora_pd_vendor_status.global_entity_id IN ('FP_SG',
'FP_BD',
'FP_PK',
'FP_MY',
'FP_HK',
'FP_TW',
'FP_KH',
'FP_MM',
'FP_LA',
'FP_JP',
'FP_PH',
'FP_TH')
and pd_vendor_uuid not in (SELECT * FROM `dhh---analytics-apac.pandata_ap_finance.voucher_vendors_reclassification`)
AND is_active 
AND NOT is_private 
AND NOT is_test 
GROUP BY 1,2,3
ORDER BY 1,2,3

),

new_vendors AS 
(
  SELECT 
  date_trunc( date(pd_vendors.activated_at_local),month) as month,
  pd_vendors.global_entity_id,
  CASE WHEN NOT pd_vendors_agg_business_types.business_type_apac_reclassified IS NULL AND COALESCE(
        pd_vendors_agg_business_types.date_reclassified, date(pd_vendors.activated_at_local)
      ) <<= date(pd_vendors.activated_at_local) THEN pd_vendors_agg_business_types.business_type_apac_reclassified
    ELSE pd_vendors_agg_business_types.business_type_apac
  END as vertical,
  COUNT(DISTINCT pd_vendors.uuid) as new_vendors
  FROM `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` pd_vendors
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` pd_vendors_agg_business_types
  ON pd_vendors.uuid = pd_vendors_agg_business_types.uuid
  WHERE 
  date(activated_at_local) >>= "2021-01-01"
  AND pd_vendors.global_entity_id IN ('FP_SG',
  'FP_BD',
  'FP_PK',
  'FP_MY',
  'FP_HK',
  'FP_TW',
  'FP_KH',
  'FP_MM',
  'FP_LA',
  'FP_JP',
  'FP_PH',
  'FP_TH')
  and pd_vendors.uuid not in (SELECT * FROM `dhh---analytics-apac.pandata_ap_finance.voucher_vendors_reclassification`)
  and not pd_vendors.is_testing
  GROUP BY 1,2,3
  ORDER BY 1,2,3
  
)

SELECT 
ov.month,
countries.name ,
ov.vertical,
online_vendors,
new_vendors
FROM online_vendors ov
LEFT JOIN new_vendors nv
on ov.month = nv.month
and ov.global_entity_id = nv.global_entity_id 
and ov.vertical = nv.vertical
LEFT JOIN fulfillment-dwh-production.pandata_curated.shared_countries countries
on countries.global_entity_id = ov.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
