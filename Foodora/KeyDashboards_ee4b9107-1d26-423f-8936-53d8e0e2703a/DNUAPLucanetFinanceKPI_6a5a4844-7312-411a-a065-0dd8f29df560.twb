            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_finance' server-oauth='' username='jelmer.ochoa@foodpanda.ph' workgroup-auth-mode='prompt' />
