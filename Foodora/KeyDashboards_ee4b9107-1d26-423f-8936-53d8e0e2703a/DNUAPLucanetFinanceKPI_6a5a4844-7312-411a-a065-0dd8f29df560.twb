        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ncob7b05uebz41cdt8ig0j51c5x' name='Custom SQL Query' type='text'>WITH all_users_db AS (&#13;
  SELECT&#13;
    id_mapping.global_entity_id,&#13;
    COUNT(DISTINCT id_mapping.analytical_customer_id) AS total_users&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS id_mapping&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries&#13;
         ON id_mapping.global_entity_id = shared_countries.global_entity_id&#13;
  WHERE shared_countries.region = &quot;Asia&quot;&#13;
    AND shared_countries.company_name = &quot;Foodpanda&quot;&#13;
  GROUP BY 1&#13;
),&#13;
&#13;
all_users_db2 AS (&#13;
  SELECT&#13;
    orders.global_entity_id,&#13;
    shared_countries.name AS country,&#13;
    COUNT(DISTINCT&#13;
      CASE&#13;
        WHEN DATE_TRUNC(orders.ordered_at_date_local, MONTH)= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH) THEN id_mapping.analytical_customer_id&#13;
      END&#13;
    ) AS Active_Customer,&#13;
    COUNT(DISTINCT&#13;
      CASE&#13;
        WHEN DATE_TRUNC(orders.ordered_at_date_local, month)= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH) &#13;
        AND DATE_TRUNC(DATE(TIMESTAMP(acquisitions.first_valid_order_all_at_utc, shared_countries.timezone)), MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH) THEN id_mapping.analytical_customer_id&#13;
      END&#13;
    ) AS New_Users,&#13;
    COUNT(DISTINCT&#13;
      CASE&#13;
        WHEN DATE_TRUNC(orders.ordered_at_date_local, month) BETWEEN DATE_SUB(DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH),INTERVAL 3 MONTH)AND DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH) THEN id_mapping.analytical_customer_id&#13;
      END&#13;
    ) AS active_customer_last_3_month,&#13;
    COUNT(DISTINCT&#13;
      CASE&#13;
        WHEN DATE_TRUNC(orders.ordered_at_date_local, month) BETWEEN DATE_SUB(DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH),INTERVAL 6 MONTH)AND DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH) THEN id_mapping.analytical_customer_id&#13;
      END&#13;
    ) AS active_customer_last_6_month,&#13;
    COUNT(DISTINCT&#13;
      CASE&#13;
        WHEN DATE_TRUNC(orders.ordered_at_date_local, month) BETWEEN DATE_SUB(DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH),INTERVAL 12 MONTH) AND DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH),INTERVAL 1 MONTH) THEN id_mapping.analytical_customer_id&#13;
      END&#13;
    ) AS active_customer_last_12_month&#13;
  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS orders&#13;
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS id_mapping&#13;
         ON orders.global_entity_id = id_mapping.global_entity_id&#13;
        AND orders.pd_customer_uuid = CONCAT(REGEXP_EXTRACT(id_mapping.external_id, r&quot;[0-9]+&quot;), &quot;_FP_&quot;, REGEXP_EXTRACT(id_mapping.external_id, r&quot;^..&quot;))&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries&#13;
         ON orders.global_entity_id = shared_countries.global_entity_id&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_order_dates`  AS acquisitions&#13;
         ON orders.pd_customer_uuid = acquisitions.uuid&#13;
  WHERE orders.is_valid_order&#13;
    AND NOT orders.is_test_order&#13;
    AND shared_countries.region = &quot;Asia&quot;&#13;
    AND shared_countries.company_name = &quot;Foodpanda&quot;&#13;
    AND orders.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH),INTERVAL 13 MONTH)&#13;
  GROUP BY&#13;
    1,&#13;
    2&#13;
  ORDER BY&#13;
    1,&#13;
    2 &#13;
)&#13;
&#13;
