          <datasource-dependencies datasource='federated.09s0b8d19jdbdn10tntvx087ppvt'>
            <column caption='Shops Online' datatype='integer' name='[Calculation_1881097286171533312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical]= &apos;shops&apos; THEN [online_vendors] ELSE 0 END)' />
            </column>
            <column caption='Restaurants Online' datatype='integer' name='[Shops Online (copy)_1881097286171779073]' role='measure' type='quantitative'>
