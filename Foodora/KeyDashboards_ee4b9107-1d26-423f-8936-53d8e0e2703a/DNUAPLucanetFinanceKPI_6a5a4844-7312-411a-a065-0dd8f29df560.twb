    <worksheet name='PU/VD'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders' name='federated.1ul2yue0ryc2be1c8fntm13jwq33' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ul2yue0ryc2be1c8fntm13jwq33'>
            <column caption='MP GFV/GPV' datatype='real' name='[Calculation_4474748453697757184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN [GFV]&#10;ELSE [GFV] / [fx]&#10;END' />
            </column>
            <column caption='= MP Restaurant Generated GMV' datatype='real' name='[Calculation_4474748453706846218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies])&#10;ELSE ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies]) / [fx]&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='+ MP Other Fees' datatype='real' name='[Delivery Fee (copy)_4474748453698322435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN [Other_fees]&#10;ELSE [Other_fees] / [fx]&#10;END' />
            </column>
            <column caption='+ MP Delivery Fee' datatype='real' name='[GFV/GPV (copy)_4474748453698105346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN [delivery_fee]&#10;ELSE [delivery_fee] / [fx]&#10;END' />
            </column>
            <column caption='- MP Group Subsidies' datatype='real' name='[GFV/GPV (copy)_4474748453698539525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN [Group_Subsidies]&#10;ELSE [Group_Subsidies] / [fx]&#10;END' />
            </column>
            <column datatype='real' name='[GFV]' role='measure' type='quantitative' />
            <column caption='= OD GMV including Subsidies (user paid amount)' datatype='real' name='[GMV including Subsidies (user paid amount) (copy)_264516121393692679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies]-[Group_Subsidies])&#10;ELSE ([GFV]+[delivery_fee]+[Other_fees]-[Restaurant_Subsidies]-[Group_Subsidies]) / [fx]&#10;END' />
            </column>
            <column caption='- MP Restaurant Subsidies' datatype='real' name='[Group Subsidies (copy)_4474748453698744326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN [Restaurant_Subsidies]&#10;ELSE [Restaurant_Subsidies] / [fx]&#10;END' />
            </column>
            <column caption='Group Subsidies' datatype='real' name='[Group_Subsidies]' role='measure' type='quantitative' />
            <column datatype='string' name='[OD_VD_PU]' role='dimension' type='nominal' />
