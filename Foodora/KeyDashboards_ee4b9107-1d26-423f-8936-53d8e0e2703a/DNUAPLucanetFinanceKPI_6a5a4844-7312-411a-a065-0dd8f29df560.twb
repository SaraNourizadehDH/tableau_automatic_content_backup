            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ul2yue0ryc2be1c8fntm13jwq33'>
            <column caption='Delivery Fee Reduction - Marketing Non Subscription' datatype='real' name='[Calculation_3201566816258326528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Local&apos; THEN (IFNULL([fp_funded_non_pro_delivery_discounts], 0) + IFNULL([fp_funded_non_pro_delivery_vouchers], 0)&#13;&#10;+ IFNULL([vendor_funded_delivery_discounts_local], 0) + IFNULL([vendor_funded_delivery_vouchers_local], 0))&#13;&#10;&#10;ELSE (IFNULL([fp_funded_non_pro_delivery_discounts], 0) + IFNULL([fp_funded_non_pro_delivery_vouchers], 0)&#13;&#10;+ IFNULL([vendor_funded_delivery_discounts_local], 0) + IFNULL([vendor_funded_delivery_vouchers_local], 0))&#13;&#10; / [fx]&#10;END' />
            </column>
            <column caption='Delivery Fee Reduction - Acquisition v1' datatype='real' name='[Calculation_3840796469933568000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [new_customer_delivery_vouchers_local] else [new_customer_delivery_vouchers_local]/[fx] END' />
            </column>
            <column caption='Revenue reduction from Subscription delivery fee' datatype='real' name='[Calculation_4328803683149901824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [pro_df_reductions] else [pro_df_reductions]/[fx] END' />
            </column>
            <column caption='Avg Delivery Fee Reduction - Subscription' datatype='real' name='[Calculation_4328803683150159873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_4328803683149901824])/sum([pandapro_fd_orders])' />
            </column>
            <column caption='Delivery Fee Reduction - Acquisition v2' datatype='real' name='[Calculation_6516005018051440640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]= &apos;Local&apos; then [total_fdnc_local] else [total_fdnc_local]/[fx] END' />
            </column>
            <column caption='Delivery Fee Reduction - Acquisition' datatype='real' name='[Calculation_6516005018053124097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &quot;Avg Lost DF&quot; then [Calculation_6516005018051440640] else [Calculation_3840796469933568000] end' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
