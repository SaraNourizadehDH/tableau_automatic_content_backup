        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1kp3y311rq7shw10i62hx1n1naxp' name='Custom SQL Query' type='text'>SELECT
    global_entity_id,
    created_date_local,
    is_free_delivery_foodpanda_funded_subscription_order,
    is_valid_order,
    is_billable,
    business_type_apac,
    
    COUNT(code) AS order_count,
    SUM(foodpanda_funded_discount_local) AS foodpanda_funded_discount_local,
    SUM(foodpanda_funded_discount_eur) AS foodpanda_funded_discount_eur,
    SUM(foodpanda_funded_voucher_local) AS foodpanda_funded_voucher_local,
    SUM(foodpanda_funded_voucher_eur) AS foodpanda_funded_voucher_eur,
    SUM(delivery_fee_local) AS delivery_fee_local,
    SUM(delivery_fee_eur) AS delivery_fee_eur,
    SUM(delivery_fee_local_wo_vat_calculated) AS delivery_fee_local_wo_vat_calculated,
    SUM(delivery_fee_eur_wo_vat_calculated) AS delivery_fee_eur_wo_vat_calculated,
    SUM(delivery_fee_plus_vat_local) AS delivery_fee_plus_vat_local,
    SUM(delivery_fee_plus_vat_eur) AS delivery_fee_plus_vat_eur,
    SUM(pandapro_excess_delivery_fee_local) AS pandapro_excess_delivery_fee_local,
    SUM(pandapro_excess_delivery_fee_eur) AS pandapro_excess_delivery_fee_eur,
    SUM(pandapro_excess_delivery_fee_plus_vat_local) AS pandapro_excess_delivery_fee_plus_vat_local,
    SUM(pandapro_excess_delivery_fee_plus_vat_eur) AS pandapro_excess_delivery_fee_plus_vat_eur,
    SUM(loss_delivery_fee_local) AS loss_delivery_fee_local,
    SUM(loss_delivery_fee_eur) AS loss_delivery_fee_eur,
    SUM(loss_delivery_fee_local_dps) AS loss_delivery_fee_local_dps,
    SUM(loss_delivery_fee_eur_dps) AS loss_delivery_fee_eur_dps,
    SUM(loss_delivery_fee_plus_vat_local) AS loss_delivery_fee_plus_vat_local,
    SUM(loss_delivery_fee_plus_vat_eur) AS loss_delivery_fee_plus_vat_eur,
    SUM(loss_delivery_fee_plus_vat_local_dps) AS loss_delivery_fee_plus_vat_local_dps,
    SUM(loss_delivery_fee_plus_vat_eur_dps) AS loss_delivery_fee_plus_vat_eur_dps,
    SUM(gmv_local) AS gmv_local,
    SUM(gmv_eur) AS gmv_eur,
    SUM(gfv_local) AS gfv_local,
    SUM(gfv_eur) AS gfv_eur,

FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_pandapro_loss_df_adjustment`

GROUP BY
    global_entity_id,
    created_date_local,
    is_free_delivery_foodpanda_funded_subscription_order,
    is_valid_order,
    is_billable,
    business_type_apac</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
