    <datasource caption='Pandamart Orders and GPV by Store' inline='true' name='federated.16t7pk902cu4kv0zna0xv08ki8bm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1bytbld0d77smz13xq49k0pfvv7b'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Production' schema='pandata' server-oauth='server-custom' username='jelmer.ochoa@foodpanda.ph' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1bytbld0d77smz13xq49k0pfvv7b' name='Custom SQL Query' type='text'>SELECT&#13;
  kpi.global_entity_id,&#13;
  kpi.order_date,&#13;
  kpi.country_name AS country_name,&#13;
  orders.vendor_name AS name,&#13;
  COUNT(DISTINCT kpi.order_code) AS count_of_orders,&#13;
  SUM(kpi.gfv_w_dmart_adj_local + kpi.container_charges_local) AS gfv_local,&#13;
  SUM((kpi.gfv_w_dmart_adj_local + kpi.container_charges_local) / fx.fx_rate_eur) AS gfv_eur&#13;
FROM `fulfillment-dwh-production.pandata_report.finance__onestream_kpi_report` kpi&#13;
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders&#13;
       ON kpi.global_entity_id = orders.global_entity_id&#13;
      AND kpi.order_code = orders.order_code&#13;
      AND orders.created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL 4 month)&#13;
JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` sc&#13;
       ON kpi.global_entity_id = sc.global_entity_id&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS fx&#13;
       ON sc.currency_code_iso = fx.currency_code&#13;
      AND kpi.order_date = fx.fx_rate_date&#13;
      AND fx.fx_rate_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 12 MONTH)&#13;
WHERE TRUE&#13;
  AND report_month &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL 4 month)&#13;
  AND kpi.business_type = &quot;dmart&quot;&#13;
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1bytbld0d77smz13xq49k0pfvv7b' name='Custom SQL Query' type='text'>SELECT&#13;
  kpi.global_entity_id,&#13;
  kpi.order_date,&#13;
  kpi.country_name AS country_name,&#13;
  orders.vendor_name AS name,&#13;
  COUNT(DISTINCT kpi.order_code) AS count_of_orders,&#13;
  SUM(kpi.gfv_w_dmart_adj_local + kpi.container_charges_local) AS gfv_local,&#13;
  SUM((kpi.gfv_w_dmart_adj_local + kpi.container_charges_local) / fx.fx_rate_eur) AS gfv_eur&#13;
FROM `fulfillment-dwh-production.pandata_report.finance__onestream_kpi_report` kpi&#13;
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders&#13;
       ON kpi.global_entity_id = orders.global_entity_id&#13;
      AND kpi.order_code = orders.order_code&#13;
      AND orders.created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL 4 month)&#13;
JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` sc&#13;
       ON kpi.global_entity_id = sc.global_entity_id&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS fx&#13;
       ON sc.currency_code_iso = fx.currency_code&#13;
      AND kpi.order_date = fx.fx_rate_date&#13;
      AND fx.fx_rate_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 12 MONTH)&#13;
WHERE TRUE&#13;
  AND report_month &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),month), INTERVAL 4 month)&#13;
  AND kpi.business_type = &quot;dmart&quot;&#13;
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
