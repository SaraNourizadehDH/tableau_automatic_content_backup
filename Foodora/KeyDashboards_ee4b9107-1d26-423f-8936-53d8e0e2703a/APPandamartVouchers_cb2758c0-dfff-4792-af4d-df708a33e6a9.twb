LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` a
ON o.uuid = a.uuid
, UNNEST(accounting) accounting
LEFT JOIN
  `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` vouchers
ON
  o.uuid = vouchers.uuid
LEFT JOIN
  `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` bt
ON
