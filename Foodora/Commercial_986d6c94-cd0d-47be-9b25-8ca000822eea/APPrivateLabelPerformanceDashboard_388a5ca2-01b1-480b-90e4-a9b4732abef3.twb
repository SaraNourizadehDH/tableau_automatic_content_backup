                <zone fixed-size='892' forceUpdate='true' h='2600' id='313' type-v2='text' w='76923' x='22052' y='400'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Semibold' fontsize='22'>  PRIVATE LABEL PERFORMANCE - PORTFOLIO</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#e6e6e6' />
