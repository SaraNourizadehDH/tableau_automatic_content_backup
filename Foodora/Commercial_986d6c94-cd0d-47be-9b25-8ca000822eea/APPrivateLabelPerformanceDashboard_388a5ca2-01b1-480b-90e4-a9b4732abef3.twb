            <column caption='Vendor Brands Total Margins (€)' datatype='real' name='[Own Brands Margins (copy)_4367717621129216003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#10;  ABS(&#10;  SUM(IFNULL([front_margins_eur_vb],0)) + &#10;  SUM(IFNULL([back_margins_eur_vb],0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_vb],0))&#10;  ) &gt; 0&#10;&#10;THEN &#10;  SUM(IFNULL([front_margins_eur_vb],0)) + &#10;  SUM(IFNULL([back_margins_eur_vb],0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_vb],0))&#10;&#10;ELSE NULL END' />
