    <worksheet name='Report - 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='14'>Business Report</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8'>Metrics:</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8'> GFV Share, Margin %, Margins Share, Discount Value as % of GFV, GFV from Discount %, Average Selling Price</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Report (Product) Table' name='federated.0jh6q7r0xg9y0d144jktv08it1fe' />
          </datasources>
          <datasource-dependencies datasource='federated.0jh6q7r0xg9y0d144jktv08it1fe'>
            <column caption='Margin %' datatype='real' name='[Calculation_1463599552740433937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([front_margins_eur],0) + IFNULL([total_back_margins_eur],0))/SUM([gfv_eur_less_vat])' />
            </column>
            <column caption='Total Margins' datatype='real' name='[Calculation_1463599552740659218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([front_margins_eur],0) + IFNULL([total_back_margins_eur],0))' />
            </column>
            <column caption='Discount Value as % of GFV' datatype='real' name='[Calculation_1463599552740868115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_eur])/SUM([gfv_eur])' />
            </column>
            <column caption='GFV from Discount %' datatype='real' name='[Calculation_1463599552741105684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_eur_discount])/SUM([gfv_eur])' />
            </column>
            <column caption='Average Selling Price' datatype='real' name='[Calculation_1463599552741335061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([selling_price_total])/SUM([qty_sold])' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952348958723]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_group]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
