        <calculation class='tableau' formula='RANK_UNIQUE(&#10;  SUM({ FIXED [master_category_one]: SUM(IF [period] = &quot;MTD&quot; THEN [gfv_eur_ob] ELSE 0 END) }) &#10;    -&#10;  SUM({ FIXED [master_category_one]: SUM(IF [period] = &quot;M-1 MTD&quot; THEN [gfv_eur_ob] ELSE 0 END) })&#10;  , &#10;  &apos;desc&apos;)'>
