    <worksheet name='GFV WMQ - Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='14'>GFV (€)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'>(GFV gross of tax, inclusive of Retail + Consignment sales)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Summary + Portfolio Table' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Sort by Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Own Brands GFV&quot;'>
              <calculation class='tableau' formula='&quot;Own Brands GFV&quot;' />
            </column>
            <column caption='Sort by Period' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;MTD&quot;'>
              <calculation class='tableau' formula='&quot;MTD&quot;' />
            </column>
            <column caption='Select Period' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Derived: Category 1 with OB' datatype='boolean' name='[Calculation_2234840990721355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_one_has_ob], FALSE)' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952342142977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Own Brands GFV Share (%)' datatype='real' default-format='p0.0%' name='[Calculation_4367717621115760640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_eur_ob]) &#10;/ &#10;SUM([gfv_eur_dmart])' />
            </column>
            <column caption='Period_Filter' datatype='string' name='[Calculation_5636606778880147456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;&#10;WHEN &quot;Default&quot; THEN IIF(&#10;  (DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  (DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  [period] IN (&quot;M-1 MTD&quot;, &quot;MTD&quot;, &quot;D-1&quot;)&#10;  , &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Week&quot; THEN IIF([period] = &quot;ISO Week&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Month&quot; THEN IIF([period] = &quot;Month&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Quarter&quot; THEN IIF([period] = &quot;Quarter&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;&#10;END' />
            </column>
            <column caption='Sort by Ranking - Country' datatype='integer' name='[Calculation_577375612573286400]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;Own Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;  &#10;  WHEN &apos;Vendor Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands GFV Share&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) &#10;      / &#10;      (SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) })), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Total GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_ob] ELSE 0 END) }) +   &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_ob] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_ob] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Vendor Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_vb] ELSE 0 END) }) +   &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_vb] ELSE 0 END) }) + &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_vb] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_vb] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Derived: Category 2 with OB' datatype='boolean' name='[Derived: Category 1 with OB (copy)_2234840990724685826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_two_has_ob], FALSE)' />
