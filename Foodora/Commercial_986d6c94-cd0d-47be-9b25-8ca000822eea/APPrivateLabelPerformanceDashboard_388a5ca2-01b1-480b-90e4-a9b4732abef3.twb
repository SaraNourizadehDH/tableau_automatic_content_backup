        <calculation class='tableau' formula='/* GFV MoM */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (SUM([gfv_eur_dmart])&#10;  / &#10;  LOOKUP(SUM([gfv_eur_dmart]), -1)) - 1&#10;ELSE NULL &#10;END&#10;&#10;* &#10;&#10;/* MoM Contribution */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN&#10;  LOOKUP(IFNULL(SUM([gfv_eur_dmart]), 0), -1) &#10;  / &#10;  LOOKUP(&#10;    SUM({FIXED [period] : SUM([gfv_eur_dmart])}), &#10;    -1&#10;  )&#10;ELSE NULL &#10;END'>
