        <calculation class='tableau' formula='IF   SUM(IFNULL([gfv_eur_ob],0)) &gt; 0 AND [Calculation_1463599552193441797] = 0 &#10;THEN SUM(IFNULL([gfv_eur_ob],0))&#10;&#10;ELSE &#10;&#10;SUM(IFNULL([gfv_eur_ob],0))/[Calculation_1463599552193441797]&#10;&#10;END' />
      </column>
      <column caption='Portfolio: OB GFV % ' datatype='real' default-format='p0.0%' name='[Calculation_1463599552194203658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([gfv_eur_ob],0))&#10;/&#10;(SUM(IFNULL([gfv_eur_ob],0))+SUM(IFNULL([gfv_eur_vb],0)))' />
      </column>
      <column caption='Portfolio: OB Margins per SKU' datatype='real' name='[Calculation_1463599552194666507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;    (SUM(IFNULL([front_margins_eur_ob],0))+&#10;     SUM(IFNULL([back_margins_eur_ob],0))+&#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob],0))) &gt; 0 &#10;AND [Calculation_1463599552193441797] = 0 &#10;&#10;THEN &#10;    (SUM(IFNULL([front_margins_eur_ob],0))+&#10;     SUM(IFNULL([back_margins_eur_ob],0))+&#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob],0)))&#10;&#10;ELSE &#10;    (SUM(IFNULL([front_margins_eur_ob],0))+&#10;     SUM(IFNULL([back_margins_eur_ob],0))+&#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob],0)))&#10;    /&#10;    [Calculation_1463599552193441797]&#10;&#10;END' />
      </column>
      <column caption='Variance Period' datatype='boolean' name='[Calculation_1510535510784724994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Month Variance&quot; THEN [Period Set]&#10;WHEN &quot;Month-To-Date Variance&quot; THEN [MTD Variance]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Derived: Category 1 with OB' datatype='boolean' name='[Calculation_2234840990721355776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([cat_one_has_ob], FALSE)' />
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952342142977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
      </column>
      <column caption='Margin Deviation Filter' datatype='boolean' name='[Calculation_295267252432334854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([period] IN (&quot;ISO Week&quot;, &quot;M-1 MTD&quot;, &quot;MTD&quot;, &quot;D-1&quot;), TRUE, FALSE)' />
      </column>
      <column caption='Period Definition' datatype='string' name='[Calculation_3266235672729337856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[period] + &apos;: &apos; + [period_date_value]' />
      </column>
      <column caption='Own Brands Total Revenue Share' datatype='real' name='[Calculation_3451164709579612160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([total_revenue_eur_ob]), 0) &#10;/ &#10;IFNULL(SUM([total_revenue_eur_dmart]), 0)' />
      </column>
      <column caption='Own Brands Margins with Commissions (€)' datatype='real' name='[Calculation_3451164709583654916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_4367717621129093122], 0) + SUM(IFNULL([consignment_revenue_eur_ob], 0))' />
      </column>
      <column caption='Own Brands Margins with Commissions Share' datatype='real' name='[Calculation_3451164709585592330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3451164709583654916] &#10;  /&#10;[Vendor Brands Margins with Commissions (€) (copy)_3451164709584248838]' />
      </column>
      <column caption='Own Brands Consignment Margins Blend' datatype='real' name='[Calculation_3451164709587034123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([consignment_revenue_eur_ob])&#10;/&#10;[Calculation_3451164709583654916]' />
      </column>
      <column caption='Own Brands GFV Share (%)' datatype='real' default-format='p0.0%' name='[Calculation_4367717621115760640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_eur_ob]) &#10;/ &#10;SUM([gfv_eur_dmart])' />
      </column>
      <column caption='Own Brands Total Margins (€)' datatype='real' name='[Calculation_4367717621129093122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;  ABS(&#10;  SUM(IFNULL([front_margins_eur_ob],0)) + &#10;  SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))&#10;  ) != 0&#10;&#10;THEN &#10;  SUM(IFNULL([front_margins_eur_ob],0)) + &#10;  SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))&#10;&#10;ELSE NULL END' />
      </column>
      <column caption='Own Brands Margin Share' datatype='real' name='[Calculation_4367717621129650181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;&#10;// Scenario 1: Own Brands Margins &gt; 0, Vendor Brands Margins &gt; 0 -&gt; Calculate per normal&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &gt; 0  &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &gt; 0 &#10;THEN &#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;    / &#10;    ((SUM(IFNULL([front_margins_eur_ob],0)) + &#10;      SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;     +&#10;     (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;      SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))))&#10;&#10;// Scenario 2: Own Brands Margins &gt; 0, Vendor Brands Margins &lt; 0 -&gt; show NULL&#10;ELSEIF&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &gt; 0  &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &lt; 0&#10;THEN NULL&#10;&#10;// Scenario 3: Own Brands Margins &lt; 0, Vendor Brands Margins &gt; 0 -&gt; show margins&#10;ELSEIF&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &lt; 0  &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &gt; 0&#10;THEN &#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;    / &#10;    ((SUM(IFNULL([front_margins_eur_ob],0)) + &#10;      SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;     +&#10;     (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;      SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))))&#10;&#10;// Scenario 4: Own Brands Margins is NULL, Vendor Brands Margins &gt; 0 -&gt; show NULL&#10;ELSEIF&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) = 0 &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &gt; 0&#10;THEN NULL &#10;&#10;ELSE NULL END' />
      </column>
      <column caption='Own Brands Margin (%)' datatype='real' default-format='p0.0%' name='[Calculation_4367717621131042822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;  (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;   SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0)))&#10;  &#10;   /&#10; &#10;   SUM([gfv_eur_less_vat_ob]) != 0&#10;&#10;THEN&#10;&#10;  (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;   SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0)))&#10;  &#10;   /&#10; &#10;   SUM([gfv_eur_less_vat_ob])&#10;&#10;ELSE NULL END' />
      </column>
      <column caption='Vendor Brands Margin (%)' datatype='real' default-format='p0.0%' name='[Calculation_4367717621131309063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([front_margins_eur_vb]) + &#10;  SUM(IFNULL([back_margins_eur_vb],0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_vb],0))&#10;)&#10;&#10;  / &#10;&#10;  SUM(IFNULL([gfv_eur_less_vat_vb],0))' />
      </column>
      <column caption='Own Brands GFV Blend' datatype='real' default-format='p0.0%' name='[Calculation_4367717621136965642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;  SUM(IFNULL([gfv_eur_ob],0)) &#10;&#10;  / &#10;&#10;  AVG({FIXED [country_name], [period], [date_value] : SUM([gfv_eur_ob])}) &gt; 0&#10;&#10;THEN &#10;&#10;  SUM(IFNULL([gfv_eur_ob],0)) &#10;&#10;  / &#10;&#10;  AVG({FIXED [country_name], [period], [date_value] : SUM([gfv_eur_ob])})&#10;&#10;ELSE NULL END' />
      </column>
      <column caption='Dmart GFV Blend' datatype='real' default-format='p0.0%' name='[Calculation_4367717621137502220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([gfv_eur_dmart], 0)) &#10;&#10;/&#10; &#10;AVG(&#10;  { FIXED [country_name], [period], [date_value] : &#10;      SUM(IFNULL([gfv_eur_dmart], 0)) }&#10;)' />
      </column>
      <column caption='Own Brands Margins with Commissions (%)' datatype='real' default-format='p0.0%' name='[Calculation_4621396927385526272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3451164709583654916] / SUM([gfv_eur_less_vat_ob])' />
      </column>
      <column caption='Vendor Brands Margins with Commissions (%)' datatype='real' default-format='p0.0%' name='[Calculation_4621396927386157057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Own Brands Margins with Commissions (€) (copy)_3451164709584101381] / SUM([gfv_eur_less_vat_vb])' />
      </column>
      <column caption='Dmart Margins with Commissions (%)' datatype='real' default-format='p0.0%' name='[Calculation_4621396927411531779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendor Brands Margins with Commissions (€) (copy)_3451164709584248838] / SUM([gfv_eur_less_vat_dmart])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_4790774511183073281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Category 1&apos; THEN [master_category_one]&#10;WHEN &apos;Category 2&apos; THEN [master_category_two]&#10;WHEN &apos;Category 3&apos; THEN [master_category_three]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE &apos; &apos; &#10;END' />
      </column>
      <column caption='Category 0' datatype='integer' datatype-customized='true' name='[Calculation_5508887574373191680]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[Sort by Ranking (copy)_577375612681904140]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Own Brands GFV Attribution' datatype='real' name='[Calculation_5514657809961144320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/* GFV MoM */&#10;IF ATTR([period]) = &quot;Month&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (SUM([gfv_eur_ob]) &#10;  /&#10;  LOOKUP(SUM([gfv_eur_ob]), -1)) - 1&#10;ELSE NULL &#10;END&#10;&#10;/* MoM Contribution */&#10;/*&#10;&#10;&#10;IF ATTR([Period]) = &quot;Month&quot; OR ATTR([Period]) = &quot;MTD&quot;&#10;THEN&#10;  LOOKUP(IFNULL(SUM([Own Brands GFV]), 0), -1) &#10;  / &#10;  LOOKUP(&#10;    SUM({ FIXED [Country Name], [Period] : SUM([Own Brands GFV]) }), &#10;    -1&#10;  )&#10;ELSE NULL &#10;END &#10;*/'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Period_Filter' datatype='string' name='[Calculation_5636606778880147456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;&#10;WHEN &quot;Default&quot; THEN IIF(&#10;  (DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  (DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  [period] IN (&quot;M-1 MTD&quot;, &quot;MTD&quot;, &quot;D-1&quot;)&#10;  , &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Week&quot; THEN IIF([period] = &quot;ISO Week&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Month&quot; THEN IIF([period] = &quot;Month&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Quarter&quot; THEN IIF([period] = &quot;Quarter&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;&#10;END' />
      </column>
      <column caption='Sort by Ranking - Country' datatype='integer' name='[Calculation_577375612573286400]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;Own Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;  &#10;  WHEN &apos;Vendor Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands GFV Share&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) &#10;      / &#10;      (SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) })), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Total GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;      SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_ob] ELSE 0 END) }) +   &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_ob] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_ob] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Vendor Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_vb] ELSE 0 END) }) +   &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_vb] ELSE 0 END) }) + &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_vb] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_vb] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Test' datatype='real' name='[Calculation_577375612583669762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END)}' />
      </column>
      <column caption='Category 1 (copy)' datatype='string' name='[Category 1 (copy)_295267252430639109]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[master_category_one]' />
      </column>
      <column caption='Category 2 (copy)' datatype='string' name='[Category 2 (copy)_295267252433969160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[master_category_two]' />
