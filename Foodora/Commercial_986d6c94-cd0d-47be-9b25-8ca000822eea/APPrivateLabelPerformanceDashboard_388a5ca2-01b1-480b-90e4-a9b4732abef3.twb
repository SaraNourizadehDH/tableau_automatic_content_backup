    <worksheet name='Margins WMQ - Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='14'>Margins (€)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'>(Front Margins + Back Margins + Retail Promotional Scan Rebates)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Click on the &apos;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>+</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>&apos; icon at the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 1 </run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>header to drill down to </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 3</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> and you may choose to select 1 or more countries in the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Country Name</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> filter.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Summary + Portfolio Table' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Period' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Derived: Category 1 with OB' datatype='boolean' name='[Calculation_2234840990721355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_one_has_ob], FALSE)' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952342142977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Own Brands Total Margins (€)' datatype='real' name='[Calculation_4367717621129093122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;  ABS(&#10;  SUM(IFNULL([front_margins_eur_ob],0)) + &#10;  SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))&#10;  ) != 0&#10;&#10;THEN &#10;  SUM(IFNULL([front_margins_eur_ob],0)) + &#10;  SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))&#10;&#10;ELSE NULL END' />
            </column>
            <column caption='Own Brands Margin Share' datatype='real' name='[Calculation_4367717621129650181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#10;&#10;// Scenario 1: Own Brands Margins &gt; 0, Vendor Brands Margins &gt; 0 -&gt; Calculate per normal&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &gt; 0  &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &gt; 0 &#10;THEN &#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;    / &#10;    ((SUM(IFNULL([front_margins_eur_ob],0)) + &#10;      SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;     +&#10;     (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;      SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))))&#10;&#10;// Scenario 2: Own Brands Margins &gt; 0, Vendor Brands Margins &lt; 0 -&gt; show NULL&#10;ELSEIF&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &gt; 0  &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &lt; 0&#10;THEN NULL&#10;&#10;// Scenario 3: Own Brands Margins &lt; 0, Vendor Brands Margins &gt; 0 -&gt; show margins&#10;ELSEIF&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &lt; 0  &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &gt; 0&#10;THEN &#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;    / &#10;    ((SUM(IFNULL([front_margins_eur_ob],0)) + &#10;      SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) &#10;     +&#10;     (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;      SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;      SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))))&#10;&#10;// Scenario 4: Own Brands Margins is NULL, Vendor Brands Margins &gt; 0 -&gt; show NULL&#10;ELSEIF&#10;    (SUM(IFNULL([front_margins_eur_ob],0)) + &#10;     SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))) = 0 &#10;     AND &#10;    (SUM(IFNULL([front_margins_eur_vb],0)) + &#10;     SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))) &gt; 0&#10;THEN NULL &#10;&#10;ELSE NULL END' />
            </column>
            <column caption='Period_Filter' datatype='string' name='[Calculation_5636606778880147456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;&#10;WHEN &quot;Default&quot; THEN IIF(&#10;  (DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  (DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  [period] IN (&quot;M-1 MTD&quot;, &quot;MTD&quot;, &quot;D-1&quot;)&#10;  , &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Week&quot; THEN IIF([period] = &quot;ISO Week&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Month&quot; THEN IIF([period] = &quot;Month&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;WHEN &quot;Quarter&quot; THEN IIF([period] = &quot;Quarter&quot;, &quot;In&quot;, &quot;Out&quot;)&#10;&#10;END' />
            </column>
            <column caption='Derived: Category 2 with OB' datatype='boolean' name='[Derived: Category 1 with OB (copy)_2234840990724685826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_two_has_ob], FALSE)' />
            </column>
            <column caption='Derived: Category 3 with OB' datatype='boolean' name='[Derived: Category 2 with OB (copy)_2234840990724849667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_three_has_ob], FALSE)' />
            </column>
            <column caption='Vendor Brands Total Margins (€)' datatype='real' name='[Own Brands Margins (copy)_4367717621129216003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#10;  ABS(&#10;  SUM(IFNULL([front_margins_eur_vb],0)) + &#10;  SUM(IFNULL([back_margins_eur_vb],0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_vb],0))&#10;  ) &gt; 0&#10;&#10;THEN &#10;  SUM(IFNULL([front_margins_eur_vb],0)) + &#10;  SUM(IFNULL([back_margins_eur_vb],0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_vb],0))&#10;&#10;ELSE NULL END' />
            </column>
            <column caption='Dmart Total Margins (€)' datatype='real' name='[Own Brands Margins (copy)_4367717621129478148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;  ABS(&#10;  (SUM(IFNULL([front_margins_eur_dmart],0)) + &#10;   SUM(IFNULL([back_margins_eur_dmart],0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_dmart],0)))&#10;  ) &gt; 0&#10;&#10;THEN &#10;  (&#10;   SUM(IFNULL([front_margins_eur_dmart],0)) + &#10;   SUM(IFNULL([back_margins_eur_dmart],0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_dmart],0))&#10;  )&#10;&#10;ELSE NULL END' />
            </column>
