    <worksheet name='Margins Variance - Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='14'>Margins (€) Variance</run>
            <run fontcolor='#ffffff' fontsize='16'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'>(Front Margins + Back Margins + Retail Promotional Scan Rebates)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Click on the &apos;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>+</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>&apos; icon at the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 1 </run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>header to drill down to </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 3</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> and you may choose to select 1 or more countries in the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Country Name</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> filter.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Summary + Portfolio Table' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Sort by Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Own Brands GFV&quot;'>
              <calculation class='tableau' formula='&quot;Own Brands GFV&quot;' />
            </column>
            <column caption='Sort by Period' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;MTD&quot;'>
              <calculation class='tableau' formula='&quot;MTD&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Derived: Category 1 with OB' datatype='boolean' name='[Calculation_2234840990721355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_one_has_ob], FALSE)' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952342142977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Derived: Category 2 with OB' datatype='boolean' name='[Derived: Category 1 with OB (copy)_2234840990724685826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_two_has_ob], FALSE)' />
            </column>
            <column caption='Derived: Category 3 with OB' datatype='boolean' name='[Derived: Category 2 with OB (copy)_2234840990724849667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_three_has_ob], FALSE)' />
            </column>
            <column caption='Own Brands Margins Attribution' datatype='real' name='[Own Brands GFV Attribution (copy)_5514657809974665238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Margins MoM */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (&#10;   SUM(IFNULL([front_margins_eur_ob],0)) + &#10;   SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))&#10;  )&#10;   /&#10;  ( &#10;   LOOKUP(SUM(IFNULL([front_margins_eur_ob],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_ob], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0)), -1)&#10;  ) - 1&#10;ELSE NULL &#10;END&#10;&#10;* &#10;&#10;/* MoM Contribution */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN&#10;  (&#10;   LOOKUP(SUM(IFNULL([front_margins_eur_ob],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_ob], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0)), -1)&#10;  )&#10;   / &#10;  (&#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([front_margins_eur_ob])}), -1) + &#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([back_margins_eur_ob])}), -1) + &#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([retail_promo_scan_rebate_eur_ob])}), -1)&#10;  )&#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Vendor Brands Margins Attribution' datatype='real' name='[Own Brands Margin Attribution (copy)_5514657809975824408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Margins MoM */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (&#10;   SUM(IFNULL([front_margins_eur_vb],0)) + &#10;   SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))&#10;  )&#10;   /&#10;  ( &#10;   LOOKUP(SUM(IFNULL([front_margins_eur_vb],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_vb], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0)), -1)&#10;  ) - 1&#10;ELSE NULL &#10;END&#10;&#10;* &#10;&#10;/* MoM Contribution */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN&#10;  (&#10;   LOOKUP(SUM(IFNULL([front_margins_eur_vb],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_vb], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0)), -1)&#10;  )&#10;   / &#10;  (&#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([front_margins_eur_vb])}), -1) + &#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([back_margins_eur_vb])}), -1) + &#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([retail_promo_scan_rebate_eur_vb])}), -1)&#10;  )&#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Own Brands Margins Variance Abs' datatype='real' name='[Own Brands Margins (copy)_5514657809972441103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([period]) = &quot;Month&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;&#10;THEN&#10;  ( &#10;   SUM(IFNULL([front_margins_eur_ob],0)) + &#10;   SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))&#10;  )&#10;&#10;  - &#10;  &#10;  (&#10;   LOOKUP(SUM(IFNULL([front_margins_eur_ob],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_ob], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0)), -1)&#10;  ) &#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dmart Total Margins Attribution' datatype='real' name='[Own Brands Margins Attribution (copy)_5514657809976827929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Margins MoM */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (&#10;   SUM(IFNULL([front_margins_eur_dmart], 0)) + &#10;   SUM(IFNULL([back_margins_eur_dmart], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_dmart], 0))&#10;  )&#10;   /&#10;  ( &#10;   LOOKUP(SUM(IFNULL([front_margins_eur_dmart],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_dmart], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_dmart], 0)), -1)&#10;  ) - 1&#10;ELSE NULL &#10;END&#10;&#10;* &#10;&#10;/* MoM Contribution */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN&#10;  (&#10;   LOOKUP(SUM(IFNULL([front_margins_eur_dmart],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_dmart], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_dmart], 0)), -1)&#10;  )&#10;   / &#10;  (&#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([front_margins_eur_dmart])}), -1) + &#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([back_margins_eur_dmart])}), -1) + &#10;   LOOKUP(SUM({FIXED [country_name], [period] : SUM([retail_promo_scan_rebate_eur_dmart])}), -1)&#10;  )&#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Vendor Brands Margins Variance (%)' datatype='real' name='[Own Brands Margins Variance % (copy)_5514657809973288978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([period]) = &quot;Month&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;&#10;THEN&#10;  (&#10;   SUM(IFNULL([front_margins_eur_vb],0)) + &#10;   SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))&#10;  )&#10;  /&#10;  ( &#10;   LOOKUP(SUM(IFNULL([front_margins_eur_vb],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_vb], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0)), -1)&#10;  ) - 1&#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dmart Total Margins Variance (%)' datatype='real' name='[Own Brands Margins Variance % (copy)_5514657809973841940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;&#10;THEN&#10;  (&#10;   SUM(IFNULL([front_margins_eur_dmart], 0)) + &#10;   SUM(IFNULL([back_margins_eur_dmart], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_dmart], 0))&#10;  )&#10;  /&#10;  ( &#10;   LOOKUP(SUM(IFNULL([front_margins_eur_dmart],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_dmart], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_dmart], 0)), -1)&#10;  ) - 1&#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Own Brands Margins Variance %' datatype='real' name='[Own Brands Margins Variance Abs (copy)_5514657809972883472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([period]) = &quot;Month&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;&#10;THEN&#10;  (&#10;   SUM(IFNULL([front_margins_eur_ob], 0)) + &#10;   SUM(IFNULL([back_margins_eur_ob], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0))&#10;  )&#10;  /&#10;  ( &#10;   LOOKUP(SUM(IFNULL([front_margins_eur_ob], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_ob], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_ob], 0)), -1)&#10;  ) - 1&#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Vendor Brands Margins Variance Abs' datatype='real' name='[Own Brands Margins Variance Abs (copy)_5514657809973288977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([period]) = &quot;Month&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;&#10;THEN&#10;  ( &#10;   SUM(IFNULL([front_margins_eur_vb],0)) + &#10;   SUM(IFNULL([back_margins_eur_vb], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0))&#10;  )&#10;&#10;  - &#10;  &#10;  (&#10;   LOOKUP(SUM(IFNULL([front_margins_eur_vb],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_vb], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_vb], 0)), -1)&#10;  ) &#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dmart Total Margins Variance Abs' datatype='real' name='[Own Brands Margins Variance Abs (copy)_5514657809973841939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;&#10;THEN&#10;  ( &#10;   SUM(IFNULL([front_margins_eur_dmart],0)) + &#10;   SUM(IFNULL([back_margins_eur_dmart], 0)) + &#10;   SUM(IFNULL([retail_promo_scan_rebate_eur_dmart], 0))&#10;  )&#10;&#10;  - &#10;  &#10;  (&#10;   LOOKUP(SUM(IFNULL([front_margins_eur_dmart],0)), -1) + &#10;   LOOKUP(SUM(IFNULL([back_margins_eur_dmart], 0)), -1) + &#10;   LOOKUP(SUM(IFNULL([retail_promo_scan_rebate_eur_dmart], 0)), -1)&#10;  ) &#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Period_Filter Summary' datatype='string' name='[Period_Filter (copy)_2737484888152387584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(&#10;  (DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  (DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  [period] IN (&quot;M-1 MTD&quot;, &quot;MTD&quot;, &quot;D-1&quot;)&#10;  , &quot;In&quot;, &quot;Out&quot;)' />
            </column>
            <column caption='Sort by Ranking - Category' datatype='integer' datatype-customized='true' name='[Sort by Ranking (copy)_577375612681904140]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;Own Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;  &#10;  WHEN &apos;Vendor Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands GFV Share&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) &#10;      / &#10;      (SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) })), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Total GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_ob] ELSE 0 END) }) +   &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_ob] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_ob] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Vendor Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_vb] ELSE 0 END) }) +   &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_vb] ELSE 0 END) }) + &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_vb] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_vb] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
