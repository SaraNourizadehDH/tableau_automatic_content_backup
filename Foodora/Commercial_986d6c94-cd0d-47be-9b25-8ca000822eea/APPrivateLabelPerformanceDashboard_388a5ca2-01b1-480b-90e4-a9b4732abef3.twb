        <calculation class='tableau' formula='[master_category_three]' />
      </column>
      <column caption='Derived: Category 2 with OB' datatype='boolean' name='[Derived: Category 1 with OB (copy)_2234840990724685826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([cat_two_has_ob], FALSE)' />
      </column>
      <column caption='Derived: Category 3 with OB' datatype='boolean' name='[Derived: Category 2 with OB (copy)_2234840990724849667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([cat_three_has_ob], FALSE)' />
      </column>
      <column caption='Own Brands Margins with Commissions (%) Variance' datatype='real' default-format='p0.0%' name='[Dmart Total Margin (%) Variance (copy)_4621396927412285445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (&#10;   [Calculation_4621396927385526272]&#10;  )&#10;   - &#10;  (&#10;   LOOKUP([Calculation_4621396927385526272], -1)&#10;  )&#10;ELSE NULL &#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Vendor Brands GFV Attribution' datatype='real' name='[Own Brands GFV Attribution (copy)_5514657809962536961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/* GFV MoM */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (SUM([gfv_eur_vb]) &#10;  / &#10;  LOOKUP(SUM([gfv_eur_vb]), -1)) - 1&#10;ELSE NULL &#10;END&#10;&#10;* &#10;&#10;/* MoM Contribution */&#10;IF ATTR([period]) = &quot;M-1&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN&#10;  LOOKUP(IFNULL(SUM([gfv_eur_vb]),0),-1) &#10;  / &#10;  LOOKUP(&#10;    SUM({FIXED [country_name], [period] : SUM([gfv_eur_vb])}), &#10;    -1&#10;  )&#10;ELSE NULL &#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Own Brands GFV Variance Abs' datatype='real' name='[Own Brands GFV Attribution (copy)_5514657809962758146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/* GFV Variance */&#10;&#10;// Handle MTD and Latest Month case&#10;IF ATTR([period]) = &quot;MTD&quot; OR ATTR([period]) = &quot;Month&quot;&#10;THEN &#10;  (SUM([gfv_eur_ob]) &#10;  -&#10;  LOOKUP(SUM([gfv_eur_ob]), -1))&#10;&#10;ELSE NULL &#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
