            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_PH&apos;)' function='filter'>
              <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_PH&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_PK&apos;)' function='filter'>
              <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_PK&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_SG&apos;)' function='filter'>
              <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_SG&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_TH&apos;)' function='filter'>
              <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_TH&quot;' />
