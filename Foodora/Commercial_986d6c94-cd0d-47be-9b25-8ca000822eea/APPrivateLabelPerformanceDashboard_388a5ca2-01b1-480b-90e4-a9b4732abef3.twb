              <calculation class='tableau' formula='/* GFV Variance */&#10;IF ATTR([period]) = &quot;Month&quot; OR ATTR([period]) = &quot;MTD&quot;&#10;THEN &#10;  (SUM([gfv_eur_dmart]) &#10;  /&#10;  LOOKUP(SUM([gfv_eur_dmart]), -1)) - 1&#10;ELSE NULL &#10;END'>
