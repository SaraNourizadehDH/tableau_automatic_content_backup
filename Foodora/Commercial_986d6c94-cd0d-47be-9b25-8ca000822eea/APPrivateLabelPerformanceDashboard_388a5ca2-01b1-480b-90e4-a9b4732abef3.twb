    <worksheet name='GFV Blend - Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='14'>GFV Blend</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'>(Category GFV / Country GFV)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8'>Please </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' underline='true'>select 1 country only</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> in the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Country Name</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> filter and you may choose to click on the &apos;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>+</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>&apos; icon at the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 1 </run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>header to drill down to </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 3</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Summary + Portfolio Table' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Sort by Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Own Brands GFV&quot;'>
              <calculation class='tableau' formula='&quot;Own Brands GFV&quot;' />
            </column>
            <column caption='Sort by Period' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;MTD&quot;'>
              <calculation class='tableau' formula='&quot;MTD&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Derived: Category 1 with OB' datatype='boolean' name='[Calculation_2234840990721355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_one_has_ob], FALSE)' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952342142977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Own Brands GFV Blend' datatype='real' default-format='p0.0%' name='[Calculation_4367717621136965642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;  SUM(IFNULL([gfv_eur_ob],0)) &#10;&#10;  / &#10;&#10;  AVG({FIXED [country_name], [period], [date_value] : SUM([gfv_eur_ob])}) &gt; 0&#10;&#10;THEN &#10;&#10;  SUM(IFNULL([gfv_eur_ob],0)) &#10;&#10;  / &#10;&#10;  AVG({FIXED [country_name], [period], [date_value] : SUM([gfv_eur_ob])})&#10;&#10;ELSE NULL END' />
            </column>
            <column caption='Dmart GFV Blend' datatype='real' default-format='p0.0%' name='[Calculation_4367717621137502220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gfv_eur_dmart], 0)) &#10;&#10;/&#10; &#10;AVG(&#10;  { FIXED [country_name], [period], [date_value] : &#10;      SUM(IFNULL([gfv_eur_dmart], 0)) }&#10;)' />
            </column>
            <column caption='Derived: Category 2 with OB' datatype='boolean' name='[Derived: Category 1 with OB (copy)_2234840990724685826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_two_has_ob], FALSE)' />
            </column>
            <column caption='Derived: Category 3 with OB' datatype='boolean' name='[Derived: Category 2 with OB (copy)_2234840990724849667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_three_has_ob], FALSE)' />
            </column>
            <column caption='Vendor Brands GFV Blend' datatype='real' default-format='p0.0%' name='[Own Brands GFV Blend (copy)_4367717621137063947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_eur_vb]) / AVG({FIXED [country_name], [period], [date_value] : SUM([gfv_eur_vb])})' />
            </column>
            <column caption='Dmart Total Margin (%)' datatype='real' default-format='p0.0%' name='[Own Brands Margin % (copy)_4367717621134589961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;  SUM(IFNULL([front_margins_eur_dmart],0)) + &#10;  SUM(IFNULL([back_margins_eur_dmart],0)) + &#10;  SUM(IFNULL([retail_promo_scan_rebate_eur_dmart],0))&#10;)&#10;/&#10;SUM(IFNULL([gfv_eur_less_vat_dmart],0))' />
            </column>
            <column caption='Period_Filter Summary' datatype='string' name='[Period_Filter (copy)_2737484888152387584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(&#10;  (DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  (DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  [period] IN (&quot;M-1 MTD&quot;, &quot;MTD&quot;, &quot;D-1&quot;)&#10;  , &quot;In&quot;, &quot;Out&quot;)' />
            </column>
            <column caption='Sort by Ranking - Category' datatype='integer' datatype-customized='true' name='[Sort by Ranking (copy)_577375612681904140]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;Own Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;  &#10;  WHEN &apos;Vendor Brands GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands GFV Share&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) &#10;      / &#10;      (SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) })), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Total GFV&apos; &#10;    THEN RANK_UNIQUE(&#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_ob] ELSE 0 END) }) + &#10;      SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_vb] ELSE 0 END) }), &#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Own Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_ob] ELSE 0 END) }) +   &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_ob] ELSE 0 END) }) + &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_ob] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_ob] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;  WHEN &apos;Vendor Brands Margin %&apos;&#10;    THEN RANK_UNIQUE(&#10;      (SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [front_margins_eur_vb] ELSE 0 END) }) +   &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [retail_promo_scan_rebate_eur_vb] ELSE 0 END) }) + &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [back_margins_eur_vb] ELSE 0 END) }))&#10;       / &#10;       SUM({ FIXED [master_category_one]: SUM(IF [period] = [Parameters].[Parameter 6] THEN [gfv_eur_less_vat_vb] ELSE 0 END) }),&#10;      &apos;desc&apos;)&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dmart Back Margins (€)' datatype='real' name='[back_margins_eur_dmart]' role='measure' type='quantitative' />
            <column caption='Own Brands Back Margins (€)' datatype='real' name='[back_margins_eur_ob]' role='measure' type='quantitative' />
            <column caption='Vendor Brands Back Margins (€)' datatype='real' name='[back_margins_eur_vb]' role='measure' type='quantitative' />
            <column caption='Category 1 with OB' datatype='boolean' name='[cat_one_has_ob]' role='dimension' type='nominal' />
            <column caption='Category 3 with OB' datatype='boolean' name='[cat_three_has_ob]' role='dimension' type='nominal' />
            <column caption='Category 2 with OB' datatype='boolean' name='[cat_two_has_ob]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Value' datatype='date' name='[date_value]' role='dimension' type='ordinal' />
            <column caption='Dmart Front Margins (€)' datatype='real' name='[front_margins_eur_dmart]' role='measure' type='quantitative' />
            <column caption='Own Brands Front Margins (€)' datatype='real' name='[front_margins_eur_ob]' role='measure' type='quantitative' />
            <column caption='Vendor Brands Front Margins (€)' datatype='real' name='[front_margins_eur_vb]' role='measure' type='quantitative' />
            <column caption='Dmart GFV (€)' datatype='real' name='[gfv_eur_dmart]' role='measure' type='quantitative' />
            <column caption='Dmart GFV Less Vat (€)' datatype='real' name='[gfv_eur_less_vat_dmart]' role='measure' type='quantitative' />
            <column caption='Own Brands GFV Less Vat (€)' datatype='real' name='[gfv_eur_less_vat_ob]' role='measure' type='quantitative' />
            <column caption='Vendor Brands GFV Less Vat (€)' datatype='real' name='[gfv_eur_less_vat_vb]' role='measure' type='quantitative' />
            <column caption='Own Brands GFV (€)' datatype='real' name='[gfv_eur_ob]' role='measure' type='quantitative' />
            <column caption='Vendor Brands GFV (€)' datatype='real' name='[gfv_eur_vb]' role='measure' type='quantitative' />
            <column caption='Category 1' datatype='string' name='[master_category_one]' role='dimension' type='nominal' />
            <column caption='Category 3' datatype='string' name='[master_category_three]' role='dimension' type='nominal' />
            <column caption='Category 2' datatype='string' name='[master_category_two]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2234840990721355776]' derivation='None' name='[none:Calculation_2234840990721355776:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2398377952342142977]' derivation='None' name='[none:Calculation_2398377952342142977:nk]' pivot='key' type='nominal' />
            <column-instance column='[Derived: Category 1 with OB (copy)_2234840990724685826]' derivation='None' name='[none:Derived: Category 1 with OB (copy)_2234840990724685826:nk]' pivot='key' type='nominal' />
            <column-instance column='[Derived: Category 2 with OB (copy)_2234840990724849667]' derivation='None' name='[none:Derived: Category 2 with OB (copy)_2234840990724849667:nk]' pivot='key' type='nominal' />
            <column-instance column='[Period_Filter (copy)_2737484888152387584]' derivation='None' name='[none:Period_Filter (copy)_2737484888152387584:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_value]' derivation='None' name='[none:date_value:ok]' pivot='key' type='ordinal' />
            <column-instance column='[master_category_one]' derivation='None' name='[none:master_category_one:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_three]' derivation='None' name='[none:master_category_three:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_two]' derivation='None' name='[none:master_category_two:nk]' pivot='key' type='nominal' />
            <column-instance column='[period]' derivation='None' name='[none:period:nk]' pivot='key' type='nominal' />
