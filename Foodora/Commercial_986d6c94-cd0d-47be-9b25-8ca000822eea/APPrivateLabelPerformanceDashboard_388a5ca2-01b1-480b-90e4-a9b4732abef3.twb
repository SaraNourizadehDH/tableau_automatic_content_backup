              <zone h='4450' id='1557' mode='radiolist' name='MTD Portfolio' param='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[none:Derived: Category 2 with OB (copy)_2234840990724849667:nk]' show-exclude='false' show-mode='false' show-search='false' type-v2='filter' values='database' w='12307' x='87009' y='3000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
