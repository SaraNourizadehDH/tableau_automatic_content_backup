      <column caption='Overall Order Frequency by Country &amp; Category' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1463599553114624031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_nc_adopted]) + &#10; SUM([orders_nc_acquired]) + &#10; SUM([orders_ec]))&#10;/&#10;(SUM([nc_acquired_country_category]) + &#10; SUM([nc_adopted_country_category]) + &#10; SUM([ec_country_category]))' />
      </column>
      <column aggregation='Avg' caption='% of Orders from New Customers' datatype='real' default-format='p0.0%' name='[Calculation_1463599553116057635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([orders_nc_adopted] + &#10; [orders_nc_acquired])&#10;/&#10;([orders_nc_adopted] + &#10; [orders_nc_acquired] + &#10; [orders_ec])' />
      </column>
      <column aggregation='Avg' caption='% of Orders from Existing Customers' datatype='real' default-format='p0.0%' name='[Calculation_1463599553116573732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_ec]&#10;/&#10;([orders_nc_adopted] + &#10;[orders_nc_acquired] + &#10;[orders_ec])' />
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952348733442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
      </column>
      <column caption='Overall Order Frequency of New Customers by Country &amp; Category' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Overall Order Frequency by Country &amp; Category (copy)_1463599553115111457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_nc_adopted]) + &#10; SUM([orders_nc_acquired]))&#10;/&#10;(SUM([nc_acquired_country_category]) + &#10; SUM([nc_adopted_country_category]))' />
      </column>
      <column caption='Overall Order Frequency of Existing Customers by Country &amp; Category' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Overall Order Frequency of New Customers by Country &amp; Category (copy)_1463599553115312162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_ec]) &#10;/&#10;SUM([ec_country_category])' />
