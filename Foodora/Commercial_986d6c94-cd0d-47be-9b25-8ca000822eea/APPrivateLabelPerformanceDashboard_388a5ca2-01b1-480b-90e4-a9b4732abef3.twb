              <zone h='84000' id='1884' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='242' forceUpdate='true' h='2600' id='170' type-v2='text' w='21368' x='684' y='400'>
                  <formatted-text>
                    <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Semibold' fontsize='24'>    foodpanda</run>
                  </formatted-text>
                  <zone-style>
