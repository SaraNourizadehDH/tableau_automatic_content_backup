      <column caption='Period_Filter Summary' datatype='string' name='[Period_Filter (copy)_2737484888152387584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(&#10;  (DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  (DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, TODAY())) = DATE([date_value]) AND [period] = &quot;Month&quot;)&#10;   OR &#10;  [period] IN (&quot;M-1 MTD&quot;, &quot;MTD&quot;, &quot;D-1&quot;)&#10;  , &quot;In&quot;, &quot;Out&quot;)' />
      </column>
