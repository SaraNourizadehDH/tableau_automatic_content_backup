            <zone forceUpdate='true' h='2808' id='1305' type-v2='text' w='98632' x='684' y='6654'>
              <formatted-text>
                <run fontcolor='#000000' fontsize='8'>Select a </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Period</run>
                <run fontcolor='#000000' fontsize='8'> to view by </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>% change</run>
                <run fontcolor='#000000' fontsize='8'> by </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Month</run>
                <run fontcolor='#000000' fontsize='8'> or by </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Month-To-Date</run>
                <run fontcolor='#000000' fontsize='8'>.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>1.</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'> % △</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> represents </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>percentage change</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> which computes the </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>difference in GFV / Margins </run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>between two periods, </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>as a percentage of its GFV / Margins in the earlier period</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>. </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>2.</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'> △</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> represents </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>change</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> which computes the </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8'>difference in GFV Share / Margin Share / Margin %</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'> between two periods.  </run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
