    <worksheet name='YTD Portfolio'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='16'>Portfolio - YTD </run>
            <run fontcolor='#ffffff' fontsize='16'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Summary + Portfolio Table' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Portfolio Level of Detail' datatype='string' name='[Level of Detail (copy)_4683532547060256774]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category 1&quot;'>
              <calculation class='tableau' formula='&quot;Category 1&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Portfolio: VB Subcategories' datatype='integer' name='[Calculation_1463599552183787520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(CASE [Parameters].[Level of Detail (copy)_4683532547060256774]&#10;WHEN &quot;Category 1&quot; THEN AVG([avg_num_of_vb_cat2])&#10;WHEN &quot;Category 2&quot; THEN AVG([avg_num_of_vb_cat3])&#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='Portfolio: Dimension' datatype='string' name='[Calculation_1463599552184139777]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Level of Detail (copy)_4683532547060256774]&#10;WHEN &apos;Category 1&apos; THEN [master_category_one (regional_apac_dmart__performance_private_label_performance_portfolio_dashboard)]&#10;WHEN &apos;Category 2&apos; THEN [master_category_two (regional_apac_dmart__performance_private_label_performance_portfolio_dashboard)]&#10;WHEN &apos;Category 3&apos; THEN [master_category_three (regional_apac_dmart__performance_private_label_performance_portfolio_dashboard)]&#10;ELSE &apos; &apos; &#10;END' />
            </column>
            <column caption='Portfolio: OB Subcategories' datatype='integer' name='[Calculation_1463599552184360962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(CASE [Parameters].[Level of Detail (copy)_4683532547060256774]&#10;WHEN &quot;Category 1&quot; THEN AVG([avg_num_of_ob_cat2])&#10;WHEN &quot;Category 2&quot; THEN AVG([avg_num_of_ob_cat3])&#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='Portfolio: OB Countries' datatype='integer' name='[Calculation_1463599552193187843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(CASE [Parameters].[Level of Detail (copy)_4683532547060256774]&#10;WHEN &quot;Category 1&quot; THEN AVG([avg_num_of_ob_cat1_countries])&#10;WHEN &quot;Category 2&quot; THEN AVG([avg_num_of_ob_cat2_countries])&#10;WHEN &quot;Category 3&quot; THEN AVG([avg_num_of_ob_cat3_countries])&#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='Portfolio: OB Stores' datatype='integer' name='[Calculation_1463599552193347588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(CASE [Parameters].[Level of Detail (copy)_4683532547060256774]&#10;WHEN &quot;Category 1&quot; THEN AVG([avg_num_of_ob_cat1_warehouses])&#10;WHEN &quot;Category 2&quot; THEN AVG([avg_num_of_ob_cat2_warehouses])&#10;WHEN &quot;Category 3&quot; THEN AVG([avg_num_of_ob_cat3_warehouses])&#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='Portfolio: OB SKUs' datatype='integer' name='[Calculation_1463599552193441797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(CASE [Parameters].[Level of Detail (copy)_4683532547060256774]&#10;WHEN &quot;Category 1&quot; THEN AVG([avg_num_of_ob_cat1_skus])&#10;WHEN &quot;Category 2&quot; THEN AVG([avg_num_of_ob_cat2_skus])&#10;WHEN &quot;Category 3&quot; THEN AVG([avg_num_of_ob_cat3_skus])&#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='Portfolio: Dmart SKUs' datatype='integer' name='[Calculation_1463599552193699847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(CASE [Parameters].[Level of Detail (copy)_4683532547060256774]&#10;WHEN &quot;Category 1&quot; THEN AVG([avg_num_of_ob_cat1_skus])+AVG([avg_num_of_vb_cat1_skus])&#10;WHEN &quot;Category 2&quot; THEN AVG([avg_num_of_ob_cat2_skus])+AVG([avg_num_of_vb_cat2_skus])&#10;WHEN &quot;Category 3&quot; THEN AVG([avg_num_of_ob_cat3_skus])+AVG([avg_num_of_vb_cat3_skus])&#10;ELSE NULL &#10;END)' />
            </column>
            <column caption='Portfolio: OB SKUs %' datatype='real' default-format='p0.0%' name='[Calculation_1463599552193810440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1463599552193441797]/[Calculation_1463599552193699847]' />
            </column>
            <column caption='Portfolio: OB GFV per SKU' datatype='real' name='[Calculation_1463599552194064393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF   SUM(IFNULL([gfv_eur_ob],0)) &gt; 0 AND [Calculation_1463599552193441797] = 0 &#10;THEN SUM(IFNULL([gfv_eur_ob],0))&#10;&#10;ELSE &#10;&#10;SUM(IFNULL([gfv_eur_ob],0))/[Calculation_1463599552193441797]&#10;&#10;END' />
            </column>
            <column caption='Portfolio: OB GFV % ' datatype='real' default-format='p0.0%' name='[Calculation_1463599552194203658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gfv_eur_ob],0))&#10;/&#10;(SUM(IFNULL([gfv_eur_ob],0))+SUM(IFNULL([gfv_eur_vb],0)))' />
            </column>
            <column caption='Portfolio: OB Margins per SKU' datatype='real' name='[Calculation_1463599552194666507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;    (SUM(IFNULL([front_margins_eur_ob],0))+&#10;     SUM(IFNULL([back_margins_eur_ob],0))+&#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob],0))) &gt; 0 &#10;AND [Calculation_1463599552193441797] = 0 &#10;&#10;THEN &#10;    (SUM(IFNULL([front_margins_eur_ob],0))+&#10;     SUM(IFNULL([back_margins_eur_ob],0))+&#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob],0)))&#10;&#10;ELSE &#10;    (SUM(IFNULL([front_margins_eur_ob],0))+&#10;     SUM(IFNULL([back_margins_eur_ob],0))+&#10;     SUM(IFNULL([retail_promo_scan_rebate_eur_ob],0)))&#10;    /&#10;    [Calculation_1463599552193441797]&#10;&#10;END' />
            </column>
            <column caption='Derived: Category 1 with OB' datatype='boolean' name='[Calculation_2234840990721355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_one_has_ob], FALSE)' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952342142977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Derived: Category 2 with OB' datatype='boolean' name='[Derived: Category 1 with OB (copy)_2234840990724685826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_two_has_ob], FALSE)' />
            </column>
            <column caption='Derived: Category 3 with OB' datatype='boolean' name='[Derived: Category 2 with OB (copy)_2234840990724849667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([cat_three_has_ob], FALSE)' />
            </column>
            <column caption='Portfolio: VB GFV % ' datatype='real' default-format='p0.0%' name='[Portfolio: OB GFV %  (copy)_1463599552727494671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([gfv_eur_vb],0))&#10;/&#10;(SUM(IFNULL([gfv_eur_ob],0))+SUM(IFNULL([gfv_eur_vb],0)))' />
            </column>
            <column caption='Portfolio: VB GFV per SKU' datatype='real' name='[Portfolio: OB GFV per SKU (copy)_1463599552727248910]' role='measure' type='quantitative'>
