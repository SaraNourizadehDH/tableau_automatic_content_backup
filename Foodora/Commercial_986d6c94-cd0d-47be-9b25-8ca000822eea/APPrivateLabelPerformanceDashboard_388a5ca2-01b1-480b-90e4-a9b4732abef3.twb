    <worksheet name='Shrinkage - Dmart - PIM1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='14'>GFV Blend</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'>(Category GFV / Country GFV)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8'>Please </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' underline='true'>select 1 country only</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> in the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Country Name</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'> filter and you may choose to click on the &apos;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>+</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>&apos; icon at the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 1 </run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>header to drill down to </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>Category 3</run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8' italic='true'>.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Operations Table' name='federated.1w5938g1yfqoh819ii82k04ay7ix' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w5938g1yfqoh819ii82k04ay7ix'>
            <column caption='PL Categories' datatype='boolean' name='[Calculation_187040190528450574]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5754826335305236481] != 0&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Period in Date Type' datatype='string' name='[Calculation_2907214300948643843]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Period Date Value (copy)_2907214300944314368] = TRUE THEN&#10;[period_date_value]&#10;END' />
            </column>
            <column caption='PL Shrink Adjustment Value Eur' datatype='real' name='[Calculation_5754826335305236481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;&#10;SUM(IF [is_pl_sku] = TRUE AND [period] = [Parameters].[Parameter 7] THEN [shrink_adjustment_value_eur] ELSE 0 END) = 0&#10;THEN NULL&#10;ELSE&#10;&#10;SUM(IF [is_pl_sku] = TRUE AND [period] = [Parameters].[Parameter 7] THEN [shrink_adjustment_value_eur] ELSE 0 END)&#10;&#10;END' />
            </column>
            <column caption='Country Derived' datatype='string' name='[Country (copy)_2907214300945317889]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Dmart Shrinkage %' datatype='real' name='[Dmart Shrink Adjustment Value Eur (copy)_187040190097354753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &quot;Month&quot; THEN &#10;  SUM(IF [period] = &quot;Month&quot; THEN [shrink_adjustment_value_eur] END) &#10;  / &#10;  SUM(IF [period] = &quot;Month&quot; THEN [gfv_eur] END)&#10;WHEN &quot;ISO Week&quot; THEN &#10;  SUM(IF [period] = &quot;ISO Week&quot; THEN [shrink_adjustment_value_eur] END) &#10;  / &#10;  SUM(IF [period] = &quot;ISO Week&quot; THEN [gfv_eur] END)&#10;END' />
            </column>
            <column caption='Dmart Shrink Adjustment Value Eur Variance' datatype='real' name='[Dmart Shrink Adjustment Value Eur (copy)_2907214300947496962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[PL Shrink Adjustment Value Eur (copy)_5754826335307137026]' />
            </column>
            <column caption='Dmart Shrinkage Variance' datatype='real' name='[Dmart Shrink Adjustment Value Eur (copy)_5754826335309729796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &quot;Month&quot; THEN SUM(IF [period] = &quot;Month&quot; THEN [shrink_adjustment_value_eur] END)&#10;WHEN &quot;ISO Week&quot; THEN SUM(IF [period] = &quot;ISO Week&quot; THEN [shrink_adjustment_value_eur] END)&#10;END' />
            </column>
            <column caption='Null filter' datatype='string' name='[Master Category One (copy)_187040190098067458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[master_category_one]' />
            </column>
            <column caption='PL Shrinkage %' datatype='real' name='[PL Shrink Adjustment Value Eur (copy)_187040190097035264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_pl_sku] = TRUE AND [period] = [Parameters].[Parameter 7] THEN [shrink_adjustment_value_eur] ELSE 0 END) &#10;   / &#10;SUM(IF [is_pl_sku] = TRUE AND [period] = [Parameters].[Parameter 7] THEN [gfv_eur] ELSE 0 END)' />
            </column>
            <column caption='Dmart Shrink Adjustment Value Eur' datatype='real' name='[PL Shrink Adjustment Value Eur (copy)_5754826335307137026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [period] = [Parameters].[Parameter 7] THEN [shrink_adjustment_value_eur] ELSE 0 END)' />
            </column>
            <column caption='PL Shrink Adjustment Value Eur Variance' datatype='real' name='[PL Shrink Adjustment Value Eur (copy)_5754826335309455363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5754826335305236481]' />
