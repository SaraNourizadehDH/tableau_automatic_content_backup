      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_563F7ADA2EA94C4B9CF93703FE996238'>
            <properties context=''>
              <relation connection='bigquery.1oscokh0w8589b110eyjp1rwnqgs' name='Custom SQL Query' type='text'><![CDATA[SELECT 
  DATE_TRUNC(DATE(placed_at_local), MONTH) AS month_local,
  FORMAT_DATE("%G-%m", DATE_TRUNC(DATE(placed_at_local), MONTH)) AS month_local_string,
  global_entity_id, 
  master_category_one, 
  master_category_two, 
  master_category_three,
  sku, 
  product_name,
  SUM(gfv_eur) AS gfv_eur, 
  SUM(gfv_eur_less_vat) AS gfv_eur_less_vat,
  SUM(front_margins_eur) AS front_margins_eur, 
  SUM(COALESCE(promotional_scan_rebate_amount_eur,0)) AS promo_scan_rebate_eur,
  SUM(COALESCE(SAFE_DIVIDE(total_back_margins_abs, fx_rate_eur),0)) AS back_margins_eur 
FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__commercial_private_label_dashboard`
WHERE DATE(placed_at_local) >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 3 MONTH) 
  AND DATE(placed_at_local) << DATE_TRUNC(CURRENT_DATE(), MONTH)
  AND is_valid_order 
GROUP BY 1,2,3,4,5,6,7,8]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
