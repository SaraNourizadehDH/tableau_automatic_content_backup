      <column caption='% of New Customers (Adopted)' datatype='real' default-format='p0.0%' name='[Calculation_1463599553101905950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[nc_adopted_country]/[nc_country]' />
