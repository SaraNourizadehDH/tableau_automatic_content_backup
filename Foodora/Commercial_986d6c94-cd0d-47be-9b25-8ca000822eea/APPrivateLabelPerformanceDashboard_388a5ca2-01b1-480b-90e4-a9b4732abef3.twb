          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='16'>Customer Acquisition by Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer Table' name='federated.1e7y1dv0eqs0li1d9zsnl13ocyks' />
          </datasources>
          <datasource-dependencies datasource='federated.1e7y1dv0eqs0li1d9zsnl13ocyks'>
            <column caption='% of New Customers' datatype='real' default-format='p0.0%' name='[Calculation_1463599553099419674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([nc_country]/[active_customers_country])' />
            </column>
            <column caption='% of Existing Customers' datatype='real' default-format='p0.0%' name='[Calculation_1463599553100619804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([ec_country]/[active_customers_country])' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952348733442]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Active Customers by Country' datatype='integer' name='[active_customers_country]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Existing Customers by Country' datatype='integer' name='[ec_country]' role='measure' type='quantitative' />
            <column caption='New Customers by Country' datatype='integer' name='[nc_country]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2398377952348733442]' derivation='None' name='[none:Calculation_2398377952348733442:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
