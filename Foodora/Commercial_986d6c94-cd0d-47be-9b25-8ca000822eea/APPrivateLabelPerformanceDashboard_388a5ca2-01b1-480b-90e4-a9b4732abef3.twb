    <worksheet name='Users - Country &amp; Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='16'>Customer Acquisition by Category</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer Table' name='federated.1e7y1dv0eqs0li1d9zsnl13ocyks' />
          </datasources>
          <datasource-dependencies datasource='federated.1e7y1dv0eqs0li1d9zsnl13ocyks'>
            <column caption='Overall Order Frequency by Country &amp; Category' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1463599553114624031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_nc_adopted]) + &#10; SUM([orders_nc_acquired]) + &#10; SUM([orders_ec]))&#10;/&#10;(SUM([nc_acquired_country_category]) + &#10; SUM([nc_adopted_country_category]) + &#10; SUM([ec_country_category]))' />
            </column>
            <column aggregation='Avg' caption='% of Orders from New Customers' datatype='real' default-format='p0.0%' name='[Calculation_1463599553116057635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([orders_nc_adopted] + &#10; [orders_nc_acquired])&#10;/&#10;([orders_nc_adopted] + &#10; [orders_nc_acquired] + &#10; [orders_ec])' />
            </column>
            <column aggregation='Avg' caption='% of Orders from Existing Customers' datatype='real' default-format='p0.0%' name='[Calculation_1463599553116573732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_ec]&#10;/&#10;([orders_nc_adopted] + &#10;[orders_nc_acquired] + &#10;[orders_ec])' />
            </column>
            <column caption='Overall Order Frequency of New Customers by Country &amp; Category' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Overall Order Frequency by Country &amp; Category (copy)_1463599553115111457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_nc_adopted]) + &#10; SUM([orders_nc_acquired]))&#10;/&#10;(SUM([nc_acquired_country_category]) + &#10; SUM([nc_adopted_country_category]))' />
            </column>
            <column caption='Overall Order Frequency of Existing Customers by Country &amp; Category' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Overall Order Frequency of New Customers by Country &amp; Category (copy)_1463599553115312162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_ec]) &#10;/&#10;SUM([ec_country_category])' />
            </column>
            <column caption='Active Customers by Country &amp; Category' datatype='integer' name='[active_customers_country_category]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1463599553116057635]' derivation='Avg' name='[avg:Calculation_1463599553116057635:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1463599553116573732]' derivation='Avg' name='[avg:Calculation_1463599553116573732:qk]' pivot='key' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Existing Customers by Country &amp; Category' datatype='integer' name='[ec_country_category]' role='measure' type='quantitative' />
            <column caption='Category 1' datatype='string' name='[master_category_one]' role='dimension' type='nominal' />
            <column caption='New Customers (Acquired) by Country &amp; Category' datatype='integer' name='[nc_acquired_country_category]' role='measure' type='quantitative' />
            <column caption='New Customers (Adopted) by Country &amp; Category' datatype='integer' name='[nc_adopted_country_category]' role='measure' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_one]' derivation='None' name='[none:master_category_one:nk]' pivot='key' type='nominal' />
            <column-instance column='[period]' derivation='None' name='[none:period:nk]' pivot='key' type='nominal' />
            <column caption='Orders from Existing Customers' datatype='integer' name='[orders_ec]' role='measure' type='quantitative' />
