    <worksheet name='GFV and Margin % Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Book' fontsize='16'>Private Label GFV and Margin % Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APPrivateLabelPerformanceDashboardWIP/GFVandMarginDistribution?rev=' id='GFVandMarginDistribution' path='/t/Foodora/workbooks/APPrivateLabelPerformanceDashboardWIP' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='Distribution CQ' name='federated.00p0bpa10ct09e1erw5hb0ikny83' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Distribution Level of Detail' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category 1&quot;'>
              <calculation class='tableau' formula='&quot;Category 1&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00p0bpa10ct09e1erw5hb0ikny83'>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952349388804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_3498804375072849920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;SKU&apos; THEN [sku] + &apos;: &apos; + [product_name]&#10;WHEN &apos;Category 1&apos; THEN [master_category_one]&#10;WHEN &apos;Category 2&apos; THEN [master_category_two]&#10;WHEN &apos;Category 3&apos; THEN [master_category_three]&#10;ELSE &apos; &apos; &#10;END' />
            </column>
            <column caption='Total Margins (€)' datatype='real' name='[Calculation_3498804375073226753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[front_margins_eur] + &#10;[back_margins_eur] + &#10;[promo_scan_rebate_eur]' />
            </column>
            <column caption='Margin %' datatype='real' name='[Total Margins (€) (copy)_3498804375073583106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([front_margins_eur] + &#10; [back_margins_eur] + &#10; [promo_scan_rebate_eur])&#10;/ &#10;([gfv_eur_less_vat])' />
            </column>
            <column-instance column='[global_entity_id]' derivation='Attribute' name='[attr:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_one]' derivation='Attribute' name='[attr:master_category_one:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_three]' derivation='Attribute' name='[attr:master_category_three:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_two]' derivation='Attribute' name='[attr:master_category_two:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total Margins (€) (copy)_3498804375073583106]' derivation='Avg' name='[avg:Total Margins (€) (copy)_3498804375073583106:qk]' pivot='key' type='quantitative' />
            <column caption='Back Margins Eur' datatype='real' name='[back_margins_eur]' role='measure' type='quantitative' />
            <column caption='Front Margins Eur' datatype='real' name='[front_margins_eur]' role='measure' type='quantitative' />
            <column caption='GFV Eur' datatype='real' name='[gfv_eur]' role='measure' type='quantitative' />
            <column caption='GFV Eur less VAT' datatype='real' name='[gfv_eur_less_vat]' role='measure' type='quantitative' />
