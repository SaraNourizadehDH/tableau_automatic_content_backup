    <worksheet name='Report - 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='14'>Marketing Report</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Light' fontsize='8'>Metrics: </run>
            <run fontcolor='#ffffff' fontname='Tableau Light' fontsize='8'>Customer Retention (Retained Customers in the month/ Last Month Customers), Orders, Category 3 Order Penetration, Category 3 User Penetration</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Report (Product) Table' name='federated.0jh6q7r0xg9y0d144jktv08it1fe' />
          </datasources>
          <datasource-dependencies datasource='federated.0jh6q7r0xg9y0d144jktv08it1fe'>
            <column caption='Customer Retention' datatype='real' default-format='p0.00%' name='[Calculation_1463599552743034902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_cust])/SUM([last_month_cust])' />
            </column>
            <column caption='Category 3 Order Penetration' datatype='real' name='[Calculation_1463599552743292951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([cat_orders])' />
            </column>
            <column caption='User Penetration' datatype='real' name='[Calculation_1463599552743424024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers])/SUM([cat_customers])' />
            </column>
            <column caption='Avg Selling Quantity' datatype='real' name='[Calculation_1463599552743567385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_sold])/SUM([orders])' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952348958723]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_group]' role='dimension' type='nominal' />
            <column caption='Cat Customers' datatype='integer' name='[cat_customers]' role='measure' type='quantitative' />
            <column caption='Cat Orders' datatype='integer' name='[cat_orders]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='Last Month Cust' datatype='integer' name='[last_month_cust]' role='measure' type='quantitative' />
            <column caption='Category 1' datatype='string' name='[master_category_one]' role='dimension' type='nominal' />
            <column caption='Category 3' datatype='string' name='[master_category_three]' role='dimension' type='nominal' />
            <column caption='Category 2' datatype='string' name='[master_category_two]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2398377952348958723]' derivation='None' name='[none:Calculation_2398377952348958723:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand_group]' derivation='None' name='[none:brand_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
