      <aliases enabled='yes' />
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2398377952349388804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_3498804375072849920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;SKU&apos; THEN [sku] + &apos;: &apos; + [product_name]&#10;WHEN &apos;Category 1&apos; THEN [master_category_one]&#10;WHEN &apos;Category 2&apos; THEN [master_category_two]&#10;WHEN &apos;Category 3&apos; THEN [master_category_three]&#10;ELSE &apos; &apos; &#10;END' />
      </column>
      <column caption='Total Margins (€)' datatype='real' name='[Calculation_3498804375073226753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[front_margins_eur] + &#10;[back_margins_eur] + &#10;[promo_scan_rebate_eur]' />
      </column>
      <column caption='Margin %' datatype='real' name='[Total Margins (€) (copy)_3498804375073583106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([front_margins_eur] + &#10; [back_margins_eur] + &#10; [promo_scan_rebate_eur])&#10;/ &#10;([gfv_eur_less_vat])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_563F7ADA2EA94C4B9CF93703FE996238]' role='measure' type='quantitative' />
