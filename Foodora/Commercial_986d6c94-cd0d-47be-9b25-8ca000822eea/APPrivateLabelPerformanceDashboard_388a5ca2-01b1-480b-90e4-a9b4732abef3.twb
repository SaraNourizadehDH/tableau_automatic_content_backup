              <zone h='4450' id='1556' mode='radiolist' name='MTD Portfolio' param='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[none:Derived: Category 1 with OB (copy)_2234840990724685826:nk]' show-exclude='false' show-mode='false' show-search='false' type-v2='filter' values='database' w='12308' x='74701' y='3000'>
                <zone-style>
