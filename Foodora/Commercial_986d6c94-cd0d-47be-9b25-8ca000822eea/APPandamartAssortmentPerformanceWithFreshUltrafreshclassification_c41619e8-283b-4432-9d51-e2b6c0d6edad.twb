    <worksheet name='Category level 1 - weekly'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontcolor='#555555' fontsize='10'>(*Please select all countries before minimizing to APAC level)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__assortment_performance_dashboard (pandata_report)' name='federated.0b7te091tx41b010ihqim0deh8o2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0b7te091tx41b010ihqim0deh8o2'>
            <column caption='ABV Cat One' datatype='real' name='[ABV Eur Fresh (copy)_560064864593661954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;SUM([gfv_eur])/[Num of Orders Fresh (new) (copy)_179510707461443585]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;SUM([gfv_local])/[Num of Orders Fresh (new) (copy)_179510707461443585]&#10;END' />
            </column>
            <column caption='Avg Sku count per store cat one' datatype='real' name='[Avg Sku count per store fresh (copy) (copy)_201817599739609090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_warehouses])&#10;/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_vendors])})' />
            </column>
            <column caption='Basket Penetration cat one' datatype='real' default-format='p0.0%' name='[Basket Penetration cat two (copy)_127860019210027029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_orders_cat_one])})&#10;/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_orders_overall])})' />
            </column>
            <column caption='ASP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_127860019199205376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;SUM([gfv_eur])/SUM([num_of_units])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;SUM([gfv_local])/SUM([num_of_units])&#10;END' />
            </column>
            <column caption='Back Margin (% of Retail Revenue)' datatype='real' default-format='p0.0%' name='[Calculation_127860019199438849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([back_margins_eur])/SUM([retail_revenue_eur])' />
            </column>
            <column caption='Shrinkage %' datatype='real' default-format='p0.0%' name='[Calculation_127860019200704518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;SUM([Calculation_646548035696099328])/SUM([retail_revenue_eur])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;SUM([Calculation_646548035696099328])/SUM([retail_revenue_local])&#10;END' />
            </column>
            <column caption='SKU Productivity (GFV per sku)' datatype='real' name='[Calculation_127860019200962567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;SUM([gfv_eur])/SUM(IF[is_sku_sold]=TRUE THEN 1 ELSE 0 END)&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;SUM([gfv_local])/SUM(IF[is_sku_sold]=TRUE THEN 1 ELSE 0 END)&#10;END' />
            </column>
            <column caption='Total Margin (% of Retail Revenue)' datatype='real' default-format='p0.0%' name='[Calculation_127860019201347592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT [is_consignment] THEN [front_margins_eur] + IFNULL([back_margins_eur],0) + IFNULL([total_promo_scan_rebate_eur],0) END)&#10;/SUM([retail_revenue_eur])' />
            </column>
            <column caption='Unique SKUs with sale' datatype='integer' name='[Calculation_127860019202539530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_sku_sold]=TRUE THEN [sku] END)' />
            </column>
            <column caption='Back Margins' datatype='real' name='[Calculation_1296544143986905088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;SUM([back_margins_eur])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;SUM([back_margins_local])&#10;END' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_1296544143988146178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[gfv_eur]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[gfv_local]&#10;END' />
            </column>
            <column caption='Retail Revenue' datatype='real' name='[Calculation_1296544143989772293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[retail_revenue_eur]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[retail_revenue_local]&#10;END' />
            </column>
            <column caption='Total Revenue' datatype='real' name='[Calculation_1296544143990988808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[total_revenue_eur]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[total_revenue_local]&#10;END' />
            </column>
            <column caption='Sales Penetration' datatype='real' name='[Calculation_200691695558737922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_eur]) / SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local]: SUM([gfv_eur])})' />
            </column>
            <column caption='Consignment Commission %' datatype='real' name='[Calculation_297026484760145924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([consignment_revenue_eur])/&#10;SUM(IF [is_consignment] THEN [gfv_eur] END)' />
            </column>
            <column caption='Front Margin w Promo' datatype='real' name='[Calculation_313492766327377921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT [is_consignment] AND [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[front_margins_eur]+[total_promo_scan_rebate_eur]&#10;ELSEIF NOT [is_consignment] AND [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[front_margins_local]+[total_promo_scan_rebate_local]&#10;END' />
            </column>
            <column caption='Front Margin w Promo (% of Retail Revenue)' datatype='real' name='[Calculation_313492766329384962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;SUM([Calculation_313492766327377921])/SUM([retail_revenue_eur])&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;SUM([Calculation_313492766327377921])/SUM([retail_revenue_local])&#10;END' />
            </column>
            <column caption='Shrinkage' datatype='real' name='[Calculation_646548035696099328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//new formula due to 1 SKU having more than 1 line in the table, shrinkage is joined on SKU level so it got duplicated&#10;IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[shrink_adjustment_value_eur]&#10;/&#10;{FIXED [date_type],[order_date_local],[global_entity_id],[sku],[store_closure_type]: COUNT([sku])}&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[shrink_adjustment_value_local]&#10;/&#10;{FIXED [date_type],[order_date_local],[global_entity_id],[sku],[store_closure_type]: COUNT([sku])}&#10;END' />
            </column>
            <column caption='Classification' datatype='string' name='[Classification Fresh (copy)_743586531129192449]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [master_category_one] IN (&quot;Bread / Bakery&quot;,&quot;Dairy / Chilled / Eggs&quot;) THEN &quot;Fresh&quot;&#10;ELSEIF [master_category_one] IN (&quot;Meat / Seafood&quot;,&quot;Produce&quot;,&quot;Ready To Consume&quot;) THEN &quot;Ultrafresh&quot;&#10;ELSE &quot;Non-Fresh&quot; END' />
            </column>
            <column caption='Consignment Revenue' datatype='real' name='[Consignment Promo Scan Sales Rebate (copy)_1296544143987593217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_consignment] AND [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[consignment_revenue_eur]&#10;ELSEIF [is_consignment] AND [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[consignment_revenue_local]&#10;END' />
            </column>
            <column caption='Customer Penetration cat one' datatype='real' default-format='p0.0%' name='[Customer Penetration cat two (copy)_127860019209633809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_customers_cat_one])})&#10;/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_customers_overall])})' />
            </column>
            <column caption='GFV Net Tax' datatype='real' name='[GFV (copy)_1296544143988301827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[gfv_eur_net_tax]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[gfv_local_net_tax]&#10;END' />
            </column>
            <column caption='APAC' datatype='string' name='[Global Entity Id (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[global_entity_id]' new-bin='true'>
                <bin default-name='false' value='&quot;APAC&quot;'>
                  <value>&quot;FP_BD&quot;</value>
                  <value>&quot;FP_HK&quot;</value>
                  <value>&quot;FP_KH&quot;</value>
                  <value>&quot;FP_LA&quot;</value>
                  <value>&quot;FP_MM&quot;</value>
                  <value>&quot;FP_MY&quot;</value>
                  <value>&quot;FP_PH&quot;</value>
                  <value>&quot;FP_PK&quot;</value>
                  <value>&quot;FP_SG&quot;</value>
                  <value>&quot;FP_TH&quot;</value>
                  <value>&quot;FP_TW&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Num Of Existing Customers Cat One (new)' datatype='real' name='[Num Of Existing Customers Fresh (new) (copy)_179510707465424909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Num of New Customers Cat One (new) (copy)_179510707463081991] - [Num of New Customers Fresh (new) (copy)_179510707462615045]' />
            </column>
            <column caption='Num of Customers Cat One (new)' datatype='real' name='[Num of New Customers Cat One (new) (copy)_179510707463081991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_customers_cat_one])})' />
            </column>
            <column caption='Num of New Customers Cat One (new)' datatype='real' name='[Num of New Customers Fresh (new) (copy)_179510707462615045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_new_customers_cat_one])})' />
            </column>
            <column caption='Num of Orders Cat One (new)' datatype='real' name='[Num of Orders Fresh (new) (copy)_179510707461443585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_orders_cat_one])})' />
            </column>
            <column caption='Order Frequency cat one' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Order Frequency cat two (copy)_224828148689141761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_orders_cat_one])})&#10;/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_customers_cat_one])})' />
            </column>
            <column caption='Consignment Promo Scan Sales Rebate' datatype='real' name='[Retail Promo Scan Sales Rebate Eur (copy)_297026484763447302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_consignment] AND [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;[total_promo_scan_rebate_eur]&#10;ELSEIF [is_consignment] AND [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;[total_promo_scan_rebate_local]&#10;END' />
            </column>
            <column caption='Units per order cat one' datatype='real' name='[Units per order cat two (copy)_127860019209154573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_units])/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_orders_cat_one])})' />
            </column>
