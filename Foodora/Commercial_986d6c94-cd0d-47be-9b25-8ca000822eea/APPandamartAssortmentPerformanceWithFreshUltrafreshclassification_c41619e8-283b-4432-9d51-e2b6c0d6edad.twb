      </column>
      <column caption='Avg Sku count per store cat two' datatype='real' name='[Avg Sku count per store fresh (copy)_201817599739600897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_warehouses])&#10;/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_two]:&#10;AVG([num_of_vendors])})' />
      </column>
      <column caption='Basket Penetration cat two' datatype='real' default-format='p0.0%' name='[Basket Penetration (copy)_127860019209916436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_two]:&#10;AVG([num_of_orders_cat_two])})&#10;/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_two]:&#10;AVG([num_of_orders_overall])})' />
      </column>
      <column caption='Basket Penetration ultrafresh' datatype='real' default-format='p0.0%' name='[Basket Penetration cat two (copy) (copy) (copy)_127860019210043415]' role='measure' type='quantitative'>
