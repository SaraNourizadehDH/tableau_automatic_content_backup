      </column>
      <column caption='Avg Sku count per store' datatype='real' name='[Avg Sku count per store cat one (copy)_201817599739834371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_warehouses])&#10;/&#10;AVG([num_of_vendors])' />
      </column>
      <column caption='Avg Sku count per store cat one' datatype='real' name='[Avg Sku count per store fresh (copy) (copy)_201817599739609090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_warehouses])&#10;/&#10;SUM({FIXED [global_entity_id],[date_type],[store_closure_type],[order_date_local],[master_category_one]:&#10;AVG([num_of_vendors])})' />
      </column>
      <column caption='Avg Sku count per store ultrafresh' datatype='real' name='[Avg Sku count per store fresh (copy)_201817599739514880]' role='measure' type='quantitative'>
