  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <repository-location derived-from='http://ip-172-31-0-71:8561/t/Foodora/workbooks/Freshdashboard_16509658231480/Description?rev=' id='Description' path='/t/Foodora/workbooks/Freshdashboard_16509658231480' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='300' maxwidth='1000' minheight='300' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='94666' id='3' type-v2='text' w='98400' x='800' y='2667'>
            <formatted-text>
              <run fontcolor='#333333'>This dashboard contains metrics used by the Dmart Commercial team. Monthly and Weekly Dmart performance is broken down by:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>  1) Fresh vs Non-Fresh category (Fresh = Bread/bakery, Dairy/Chilled/Eggs, Meat/Seafood, Produce, Ready To Consume)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>  2) UltraFresh vs Remaining categories (UltraFresh = Meat/Seafood, Produce, Ready To Consume)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>  3) PIM Category 1 categories</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>  4) PIM Category 2 categories</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>  5) SKU level</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>There are also additional tabs ranking top/bottom SKUs based on Front Margins/Orders/GFV</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
              <run fontcolor='#333333'>For more information or questions, please reach out to the APAC Qcommerce BI team at #pandata-qcommerce Slack channel</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
