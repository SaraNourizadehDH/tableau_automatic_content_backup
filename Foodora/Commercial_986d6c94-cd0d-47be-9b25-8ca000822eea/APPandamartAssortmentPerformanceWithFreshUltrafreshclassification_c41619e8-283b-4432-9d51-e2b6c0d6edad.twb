      <column caption='ABV Cat Two' datatype='real' name='[ABV Eur Cat One (copy)_560064864593723395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Euro&apos; THEN&#10;SUM([gfv_eur])/[Num of Orders Cat One (new) (copy)_179510707461566466]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Local&apos; THEN&#10;SUM([gfv_local])/[Num of Orders Cat One (new) (copy)_179510707461566466]&#10;END' />
