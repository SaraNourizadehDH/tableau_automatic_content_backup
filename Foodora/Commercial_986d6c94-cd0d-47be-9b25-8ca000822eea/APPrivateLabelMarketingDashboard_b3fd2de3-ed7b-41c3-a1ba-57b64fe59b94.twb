    <worksheet name='Country: User Retention'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Tableau Semibold' fontsize='12'>   Country</run>
            <run fontalignment='0' fontname='Tableau Semibold' fontsize='12'> level</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>     1. Private Label Overall User Retention Rate = Number of users who reordered within 30 days from their previous order / Number of users who ordered in the previous month</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>     2. </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>Vendor Brands</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> Overall User Retention Rate = Number of </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>Vendor Brands</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> users who reordered within 30 days from their previous order / Number of </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>Vendor Brands</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> users who ordered in the previous month</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>     3. Private Label New User Retention Rate = Number of </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>new</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> users who reordered within 30 days from their previous order / Number of users who ordered in the previous month </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>     4. Private Label Existing User Retention Rate = Number of </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>existing</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> users who reordered within 30 days from their previous order / Number of users who ordered in the previous month </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>Note: Vendor Brands Overall User Retention Rate </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>excludes</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>Æ </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>Dmart orders that</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>Æ </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>only contain Private Label SKUs</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>. </run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__private_label_marketing_user_retention_dashboard' name='federated.1pigfns1n893lm190zdvw1li62su' />
          </datasources>
          <datasource-dependencies datasource='federated.1pigfns1n893lm190zdvw1li62su'>
            <column caption='Overall User Retention Rate (Country &amp; APAC)' datatype='real' default-format='p0.00%' name='[Calculation_6092948117091631105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_30d_retention_country_users])/SUM([num_of_country_users])' />
            </column>
            <column caption='New User Retention Rate (Country &amp; APAC)' datatype='real' default-format='p0.00%' name='[Calculation_6092948117092106242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_30d_retention_new_country_users])/SUM([num_of_new_country_users])' />
            </column>
            <column caption='Existing User Retention Rate (Country &amp; APAC)' datatype='real' default-format='p0.00%' name='[Calculation_6092948117092274179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_30d_retention_existing_country_users])/SUM([num_of_existing_country_users])' />
            </column>
            <column caption='Vendor Brands Overall User Retention Rate (Country &amp; APAC)' datatype='real' default-format='p0.0%' name='[Overall User Retention Rate (Country &amp; APAC) (copy)_3189744871543054337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_30d_retention_vendor_brands_country_users])/SUM([num_of_vendor_brands_country_users])' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
