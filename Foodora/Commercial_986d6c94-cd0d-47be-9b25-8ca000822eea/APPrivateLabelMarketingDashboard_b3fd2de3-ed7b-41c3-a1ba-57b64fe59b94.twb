    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Overview'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PrivateLabelMarketingDashboard/Overview?rev=' id='Overview' path='/t/Foodora/workbooks/PrivateLabelMarketingDashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone forceUpdate='true' h='8000' id='3' type-v2='text' w='97700' x='1000' y='1250'>
          <formatted-text>
            <run fontname='Arial Black' fontsize='20'>   Private Label Marketing Dashboard Overview</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='0' />
            <format attr='background-color' value='#e6e6e6' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='37625' id='5' type-v2='text' w='97500' x='1000' y='10375'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Arial Rounded MT Bold' fontsize='14'>Overview</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontsize='10'>This dashboard provides an overview of key marketing metrics at brand level as well as brand and master category 3 level on a monthly basis for the past 6 months. The 4 marketing metrics of interest are listed as follows. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontsize='10'>1. GFV Share </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontsize='10'>2. Average Order Value (AOV)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontsize='10'>3. User Penetration </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontsize='10'>4. User Retention </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontsize='10'>This dashboard also examines Private Label users segregated into 5 mutually exclusive segments, which are Prospects, Acquired, Adopted, Churning and Inactive. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontsize='10'>The definition and interpretation of the above marketing metrics and customer segments will be elaborated in the following section. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontname='Arial Rounded MT Bold' fontsize='14'>General Definitions</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontsize='10'>1. </run>
            <run bold='true' fontalignment='0' fontsize='10'>MTD</run>
            <run fontalignment='0' fontsize='10'> refers to the current month. Metrics for MTD aggregates data from 1st of the month to the current date. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontsize='10'>2. </run>
            <run bold='true' fontalignment='0' fontsize='10'>M-1</run>
            <run fontalignment='0' fontsize='10'> refers to 1 month ago, similarly for </run>
            <run bold='true' fontalignment='0' fontsize='10'>M-2</run>
            <run fontalignment='0' fontsize='10'>, </run>
            <run bold='true' fontalignment='0' fontsize='10'>M-3</run>
            <run fontalignment='0' fontsize='10'>, </run>
            <run bold='true' fontalignment='0' fontsize='10'>M-4</run>
            <run fontalignment='0' fontsize='10'>, </run>
            <run bold='true' fontalignment='0' fontsize='10'>M-5 </run>
            <run fontalignment='0' fontsize='10'>and </run>
            <run bold='true' fontalignment='0' fontsize='10'>M-6</run>
            <run fontalignment='0' fontsize='10'> which refers to 2, 3, 4, 5 and 6 months ago respectively. </run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='100' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98000' id='99' param='vert' type-v2='layout-flow' w='98400' x='800' y='1000'>
                <zone forceUpdate='true' h='8000' id='3' type-v2='text' w='97700' x='1000' y='1250'>
                  <formatted-text>
                    <run fontname='Arial Black' fontsize='20'>   Private Label Marketing Dashboard Overview</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#e6e6e6' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='37625' id='5' type-v2='text' w='97500' x='1000' y='10375'>
                  <formatted-text>
                    <run bold='true' fontalignment='0' fontname='Arial Rounded MT Bold' fontsize='14'>Overview</run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run fontalignment='0' fontsize='10'>This dashboard provides an overview of key marketing metrics at brand level as well as brand and master category 3 level on a monthly basis for the past 6 months. The 4 marketing metrics of interest are listed as follows. </run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run fontalignment='0' fontsize='10'>1. GFV Share </run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run fontalignment='0' fontsize='10'>2. Average Order Value (AOV)</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run fontalignment='0' fontsize='10'>3. User Penetration </run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run fontalignment='0' fontsize='10'>4. User Retention </run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run fontalignment='0' fontsize='10'>This dashboard also examines Private Label users segregated into 5 mutually exclusive segments, which are Prospects, Acquired, Adopted, Churning and Inactive. </run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run fontalignment='0' fontsize='10'>The definition and interpretation of the above marketing metrics and customer segments will be elaborated in the following section. </run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='0' fontname='Arial Rounded MT Bold' fontsize='14'>General Definitions</run>
                    <run fontalignment='0'>Æ&#10;&#10;</run>
                    <run fontalignment='0' fontsize='10'>1. </run>
                    <run bold='true' fontalignment='0' fontsize='10'>MTD</run>
                    <run fontalignment='0' fontsize='10'> refers to the current month. Metrics for MTD aggregates data from 1st of the month to the current date. </run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run fontalignment='0' fontsize='10'>2. </run>
                    <run bold='true' fontalignment='0' fontsize='10'>M-1</run>
                    <run fontalignment='0' fontsize='10'> refers to 1 month ago, similarly for </run>
                    <run bold='true' fontalignment='0' fontsize='10'>M-2</run>
                    <run fontalignment='0' fontsize='10'>, </run>
                    <run bold='true' fontalignment='0' fontsize='10'>M-3</run>
                    <run fontalignment='0' fontsize='10'>, </run>
                    <run bold='true' fontalignment='0' fontsize='10'>M-4</run>
                    <run fontalignment='0' fontsize='10'>, </run>
                    <run bold='true' fontalignment='0' fontsize='10'>M-5 </run>
                    <run fontalignment='0' fontsize='10'>and </run>
                    <run bold='true' fontalignment='0' fontsize='10'>M-6</run>
                    <run fontalignment='0' fontsize='10'> which refers to 2, 3, 4, 5 and 6 months ago respectively. </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{7A4DEF7A-96E9-4CD8-A9B6-DDA7CC05968F}' />
    </dashboard>
