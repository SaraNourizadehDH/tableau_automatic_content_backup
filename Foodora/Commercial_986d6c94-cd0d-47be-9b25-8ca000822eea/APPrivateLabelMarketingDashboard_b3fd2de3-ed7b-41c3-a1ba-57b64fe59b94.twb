            <column caption='Existing Retained Users on Country level' datatype='integer' name='[num_of_30d_retention_existing_country_users]' role='measure' type='quantitative' />
            <column caption='New Retained Users on Country level' datatype='integer' name='[num_of_30d_retention_new_country_users]' role='measure' type='quantitative' />
            <column caption='Num Of 30D Retention Vendor Brands Country Users' datatype='integer' name='[num_of_30d_retention_vendor_brands_country_users]' role='measure' type='quantitative' />
            <column caption='Overall Users on Country level' datatype='integer' name='[num_of_country_users]' role='measure' type='quantitative' />
            <column caption='Existing Users on Country level' datatype='integer' name='[num_of_existing_country_users]' role='measure' type='quantitative' />
