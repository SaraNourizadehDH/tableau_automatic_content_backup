    <worksheet name='Brand: User Retention'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Tableau Semibold' fontsize='12'>   Brand</run>
            <run fontalignment='0' fontname='Tableau Semibold' fontsize='12'> level</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>     1. Overall User Retention Rate = Number of users who reordered from this </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>brand</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> within 30 days from their previous order / Number of users who ordered from this </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>brand</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> in the previous month</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>     2. New User Retention Rate = Number of </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>new</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> users who reordered from this </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>brand</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> within 30 days from their previous order / Number of users who ordered from this </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>brand</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> in the previous month </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'>     3. Existing User Retention Rate = Number of </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>existing</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> users who reordered from this brand within 30 days from their previous order / Number of users who ordered from this </run>
            <run bold='true' fontalignment='0' fontname='Tableau Light' fontsize='8'>brand</run>
            <run fontalignment='0' fontname='Tableau Light' fontsize='8'> in the previous month</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__private_label_marketing_user_retention_dashboard' name='federated.1pigfns1n893lm190zdvw1li62su' />
