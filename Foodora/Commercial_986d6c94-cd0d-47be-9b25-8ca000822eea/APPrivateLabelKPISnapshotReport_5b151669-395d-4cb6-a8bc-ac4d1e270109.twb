  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APPrivateLabelKPISnapshotReport/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/Foodora/workbooks/APPrivateLabelKPISnapshotReport' revision='' site='Foodora' />
      <style />
      <size maxheight='1000' maxwidth='1600' minheight='1000' minwidth='1000' sizing-mode='range' />
      <zones>
        <zone h='100000' id='94' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone fixed-size='549' friendly-name='README Container' h='59856' id='95' is-fixed='true' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='98684' x='658' y='3944'>
            <zone fixed-size='551' forceUpdate='true' h='59900' id='11' is-fixed='true' type-v2='text' w='98684' x='658' y='3900'>
              <formatted-text>
                <run fontcolor='#df2c79' fontname='Tableau Bold' fontsize='11'>Overview / How to Use</run>
                <run>Æ&#10;</run>
                <run fontcolor='#c9d1d9' fontname='Tableau Bold' fontsize='10'>❗</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='10'>Dashboard reflects an overview of key KPIs that are looked into by the PL team</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Definitions</run>
                <run fontcolor='#000000' fontsize='8'>: </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>MTD</run>
                <run fontcolor='#000000' fontsize='8'> refers to the current month - on the date 22 Sep 23, this represents the period from 1 - 21st Sep 23</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='8'>M-1 MTD</run>
                <run fontcolor='#000000' fontsize='8'> refers to the previous month - on the date 22 Sep 23, this represents the period from 1 - 21 Aug 23</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#df2c79' fontname='Tableau Bold' fontsize='11'>KPIs</run>
                <run>Æ&#10;</run>
                <run fontcolor='#c9d1d9' fontname='Tableau Bold' fontsize='10'>❗</run>
                <run fontcolor='#333333' fontname='Tableau Bold' fontsize='10'>User Metrics</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>1. </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>PL Users</run>
                <run fontcolor='#000000' fontsize='8'>: Number of unique users who made at least 1 order containing Private Label SKUs in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>2. </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>PL User Penetration</run>
                <run fontcolor='#000000' fontsize='8'>: Percentage of Dmart users who are also Private Label users in the given period (and country) </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>3. </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>PL User Retention Rate</run>
                <run fontcolor='#000000' fontsize='8'>: Percentage of Private Label users who made at least 1 Private Label order in the current period and previous period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>4. </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>PL Orders</run>
                <run fontcolor='#000000' fontsize='8'>: Number of unique Private Label orders in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>5. </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>PL Order Frequency</run>
                <run fontcolor='#000000' fontsize='8'>: Average number of unique Private Label orders made by each Private Label user in the given period (and country) </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>6. </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>PL Order Penetration</run>
                <run fontcolor='#000000' fontsize='8'>: Percentage of orders containing Private Label SKUs out of all Dmart orders in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>7. </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>GFV</run>
                <run fontcolor='#202124' fontsize='8'>: Total value (gross of tax) of </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> SKUs purchased by users in the given period (and country) </run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>8. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL GFV Share</run>
                <run fontcolor='#202124' fontsize='8'>: Percentage of GFV (gross of tax) from </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> out of total Dmart GFV (gross of tax) in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>9. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Margins</run>
                <run fontcolor='#202124' fontsize='8'>: Total front and back margins for Private Label in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>10. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL Margin Share</run>
                <run fontcolor='#202124' fontsize='8'>: Percentage of gross margin (front and back) from </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> out of total Dmart margin in the given period (and country) </run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>11. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL Margin %:</run>
                <run fontcolor='#202124' fontsize='8'>Æ </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> front and back margins divided by total GFV (net of tax)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>12. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL True Margin %</run>
                <run fontcolor='#202124' fontsize='8'>: Private Label Margin % net of Private Label Shrinkage %</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>13. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Dmart Margin %</run>
                <run fontcolor='#202124' fontsize='8'>: Dmart front and back margins divided by total GFV (net of tax)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>14. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Dmart True Margin %</run>
                <run fontcolor='#202124' fontsize='8'>: Dmart Margin % net of Dmart Shrinkage %</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>15. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Dmart PL LFL Margin %</run>
                <run fontcolor='#202124' fontsize='8'>: Dmart front and back margins of SKUs in the same Master Category 3 as Private Label divided by total GFV (net of tax)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>16. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Dmart PL LFL True Margin %</run>
                <run fontcolor='#202124' fontsize='8'>: Dmart PL LFL Margin % net of Dmart PL LFL Shrinkage %</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>17. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL Margin Advantage</run>
                <run fontcolor='#202124' fontsize='8'>: </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> Margin % - Dmart Margin %</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>18. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Average Order Value, AOV</run>
                <run fontcolor='#202124' fontsize='8'>: Average GFV for each valid </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> order in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>19. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Average Selling Quantity, ASQ</run>
                <run fontcolor='#202124' fontsize='8'>: Average quantity of </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> SKUs sold for each </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> order in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>20. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Average Selling Price, ASP</run>
                <run fontcolor='#202124' fontsize='8'>: Average price for each </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> SKU in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>21. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL Shrinkage %</run>
                <run fontcolor='#202124' fontsize='8'>: Percentage of shrinkage amount out of total GFV (gross of tax) for </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>22. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Dmart Shrinkage %</run>
                <run fontcolor='#202124' fontsize='8'>: Percentage of shrinkage amount out of total GFV (gross of tax) for Dmart in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>23. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Dmart PL LFL Shrinkage %</run>
                <run fontcolor='#202124' fontsize='8'>: Percentage of shrinkage amount out of total GFV (gross of tax) for Dmart SKUs in the same Master Category 3 as Private Label in the given period (and country)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>24. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL Availability</run>
                <run fontcolor='#202124' fontsize='8'>: Average number of hours </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> SKUs are available across all warehouses out of the total operating hours</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>25. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>PL Sales Weighted Availability, SWA</run>
                <run fontcolor='#202124' fontsize='8'>: Average number of hours </run>
                <run fontcolor='#000000' fontsize='8'>Private Label</run>
                <run fontcolor='#202124' fontsize='8'> SKUs are available across all warehouses out of the total operating hours, weighted based on past 4 weeks of quantity sold for each SKU in a warehouse</run>
                <run>Æ&#10;</run>
                <run fontcolor='#202124' fontsize='8'>26. </run>
                <run bold='true' fontcolor='#202124' fontsize='8'>Dmart Sales Weighted Availability, SWA</run>
                <run fontcolor='#202124' fontsize='8'>: Average number of hours </run>
                <run fontcolor='#000000' fontsize='8'>Dmart</run>
                <run fontcolor='#202124' fontsize='8'> SKUs are available across all warehouses out of the total operating hours, weighted based on past 4 weeks of quantity sold for each SKU in a warehouse</run>
                <run>Æ&#10;&#10;</run>
                <run fontsize='8' italic='true'>Note: </run>
                <run fontsize='8'>The above metrics are defined based on </run>
                <run bold='true' fontsize='8'>valid</run>
                <run fontsize='8'> orders only and all amounts are in </run>
                <run bold='true' fontsize='8'>EUR</run>
                <run fontsize='8'>.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zone>
          <zone friendly-name='Header Container' h='3144' id='233' param='vert' type-v2='layout-flow' w='98684' x='658' y='800'>
            <zone fixed-size='32' forceUpdate='true' h='3144' id='235' is-fixed='true' type-v2='text' w='98684' x='658' y='800'>
              <formatted-text>
