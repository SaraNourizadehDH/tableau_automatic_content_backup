                <run bold='true' fontcolor='#cc0033' fontsize='8'>Æ </run>
                <run fontcolor='#000000' fontsize='8'>represents MTD performance</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Definitions</run>
                <run fontcolor='#000000' fontsize='8'>: A full list of definitions can be found in the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Definitions</run>
                <run fontcolor='#000000' fontsize='8'> tab</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
