              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
