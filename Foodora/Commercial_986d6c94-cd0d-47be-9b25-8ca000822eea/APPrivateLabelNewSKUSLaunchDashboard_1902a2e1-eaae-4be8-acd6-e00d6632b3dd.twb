        <column caption='Master Category One' datatype='string' name='[master_category_one]' role='dimension' type='nominal' />
        <column caption='Master Category Three' datatype='string' name='[master_category_three]' role='dimension' type='nominal' />
        <column caption='Master Category Two' datatype='string' name='[master_category_two]' role='dimension' type='nominal' />
        <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[master_category_one]' derivation='None' name='[none:master_category_one:nk]' pivot='key' type='nominal' />
        <column-instance column='[master_category_three]' derivation='None' name='[none:master_category_three:nk]' pivot='key' type='nominal' />
        <column-instance column='[master_category_two]' derivation='None' name='[none:master_category_two:nk]' pivot='key' type='nominal' />
