          <datasource-dependencies datasource='federated.1gwek6a0ejsl4i1g7iogz0tcnyw4'>
            <column caption='Avg Penny Profit' datatype='real' name='[Calculation_1161225072987832322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avg_list_price_eur])-AVG([avg_cost_price_eur])' />
            </column>
            <column caption='Avg Benchmarked Penny Profit' datatype='real' name='[Calculation_1161225072989315075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([benchmarked_list_price_eur])-AVG([benchmarked_cost_price_eur])' />
            </column>
            <column caption='Avg Quantity Sold Daily' datatype='real' name='[Calculation_1277614969551396869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([quantity])/COUNTD([order_date_local])' />
            </column>
            <column caption='Avg Benchmark Quantity Sold Daily' datatype='real' name='[Calculation_1277614969551708166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([benchmarked_quantity])/COUNTD([order_date_local])' />
            </column>
            <column caption='Total Margins with Commission' datatype='real' name='[Calculation_1387390210482958339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([front_margins_eur])+SUM([promo_scan_rebate_eur])+SUM([back_margins_eur]))/SUM([gfv_eur_less_vat])' />
            </column>
            <column caption='Margins Diff.' datatype='real' name='[Total Margins with Commission (copy)_1161225073000488964]' role='measure' type='quantitative'>
