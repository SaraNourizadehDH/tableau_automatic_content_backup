    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Customer Metrics'>
      <repository-location derived-from='http://ip-172-31-0-212:8578/t/Foodora/workbooks/20242501NewSKUSDashboardv3/CustomerMetrics?rev=' id='CustomerMetrics' path='/t/Foodora/workbooks/20242501NewSKUSDashboardv3' revision='' site='Foodora' />
      <style />
      <size maxheight='1100' maxwidth='1200' minheight='1100' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource caption='dmart__private_label_new_product_launch_marketing_metrics' name='federated.1ljaayc07ahko31h8gcxh0d1yqne' />
      </datasources>
      <datasource-dependencies datasource='federated.1ljaayc07ahko31h8gcxh0d1yqne'>
        <column-instance column='[pl_sku_first_active_month]' derivation='Attribute' name='[attr:pl_sku_first_active_month:ok]' pivot='key' type='ordinal' />
