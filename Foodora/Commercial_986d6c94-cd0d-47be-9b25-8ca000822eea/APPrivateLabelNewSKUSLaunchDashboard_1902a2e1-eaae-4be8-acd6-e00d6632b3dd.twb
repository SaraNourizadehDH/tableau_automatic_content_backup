      <column caption='Cat3 GFV Share' datatype='real' name='[Calculation_1161225073337995274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sku_gfv])/ATTR({FIXED [global_entity_id], [order_month_local], [master_category_three] : MAX([cat3_gfv_dmart])})' />
