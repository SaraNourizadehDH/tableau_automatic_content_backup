      <column caption='Total Margins Eur' datatype='real' name='[Calculation_3156741911616180239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([front_margins_eur]) + SUM([back_margins_eur]) + SUM([retail_promo_scan_rebate_eur]) + SUM([consignment_promo_scan_rebate_eur])' />
      </column>
      <column caption='Store Coverage' datatype='real' name='[Calculation_3156741911617646609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([dmart_imt_warehouse_uuid]) / ATTR({FIXED [global_entity_id] : COUNTD([dmart_imt_warehouse_uuid])})' />
      </column>
      <column caption='Dimension Select' datatype='string' name='[Calculation_3156741911622197267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[list_price_eur Parameter] = &apos;Global Entity ID&apos; then [global_entity_id]&#10;ELSEIF [Parameters].[list_price_eur Parameter] = &apos;Master Category One&apos; then [master_category_one]&#10;ELSEIF [Parameters].[list_price_eur Parameter] = &apos;SKU First Active Month&apos; then STR([pl_sku_first_active_month])&#10;ELSEIF [Parameters].[list_price_eur Parameter] = &apos;Warehouse&apos; then STR([dmart_imt_warehouse_name])&#10;ELSEIF [Parameters].[list_price_eur Parameter] = &apos;Product Title&apos; then STR([product_title])&#10;END' />
      </column>
      <column caption='Sales Metric Select' datatype='real' default-format='p0.0%' name='[Calculation_3156741911622713365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Dimension Select (copy)_3156741911622574100] = &apos;GFV Eur&apos; then SUM([Calculation_3156741911577911296])&#10;ELSEIF [Parameters].[Dimension Select (copy)_3156741911622574100] = &apos;Quantity&apos; then SUM([quantity])&#10;END' />
      </column>
      <column caption='Date Dimension' datatype='string' name='[Calculation_3156741911625211928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Dimension Select (copy)_3156741911625089047] = &apos;Day&apos; then STR([order_date_local])&#10;ELSEIF [Parameters].[Dimension Select (copy)_3156741911625089047] = &apos;Week Start Date&apos; then STR(DATE(DATETRUNC(&apos;week&apos;, [order_date_local])))&#10;ELSEIF [Parameters].[Dimension Select (copy)_3156741911625089047] = &apos;Month&apos; then STR(DATE(DATETRUNC(&apos;month&apos;,[order_date_local])))&#10;ELSEIF [Parameters].[Dimension Select (copy)_3156741911625089047] = &apos;All Time&apos; then [Calculation_3156741911622197267]&#10;END' />
