            <column caption='Shrinkage Perc' datatype='real' name='[Calculation_3156741911586410500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_adjustment_value_eur])/SUM([Calculation_1161225073344581645])' />
