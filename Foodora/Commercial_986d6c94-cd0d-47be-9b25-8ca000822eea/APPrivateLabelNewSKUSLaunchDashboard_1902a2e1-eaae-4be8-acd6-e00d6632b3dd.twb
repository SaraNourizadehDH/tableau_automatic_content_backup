      <column caption='30D Repeat Purchase Rate' datatype='real' name='[Calculation_3251387879269433344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sku_30d_repeat_customers])/SUM([sku_all_customers])' />
      </column>
