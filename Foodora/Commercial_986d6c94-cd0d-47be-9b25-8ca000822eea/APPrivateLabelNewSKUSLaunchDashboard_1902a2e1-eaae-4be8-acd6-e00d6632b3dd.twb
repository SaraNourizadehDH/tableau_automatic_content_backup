              <zone forceUpdate='true' h='8868' id='35' type-v2='text' w='98666' x='667' y='5132'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Definitions:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontsize='8'>PL New SKUs are defined as SKUs with the first sale within the last 3 complete months till date</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#555555' fontsize='8'>Store Coverage:</run>
                  <run fontcolor='#555555' fontsize='8'>  Warehouses with Private Label SKUS with a sale / Total Warehouses</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontsize='8' italic='true'>Underlying data-set is at a </run>
                  <run bold='true' fontcolor='#555555' fontsize='8' italic='true'>day-sku-warehouse</run>
                  <run fontcolor='#555555' fontsize='8' italic='true'> granularity.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontsize='8'>This dashboard contains data from the last 3 complete months till date.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
