      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b91b55' fontsize='10'>SKU Performance | </run>
            <run fontcolor='#b91b55' fontsize='10'>Commercial &amp; Operational Metrics</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'>Data last refreshed: </run>
            <run fontsize='8'>Updated at: &lt;Data Update Time&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dmart__private_label_new_product_launch_sales_metrics' name='federated.104m2bi1iuw2yy16mgh7y00djiou' />
          </datasources>
          <datasource-dependencies datasource='federated.104m2bi1iuw2yy16mgh7y00djiou'>
            <column caption='Total GFV Eur Less Vat' datatype='real' name='[Calculation_1161225073344581645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[retail_gfv_eur_less_vat]+[consignment_gfv_eur_less_vat]' />
            </column>
            <column caption='Total GFV Eur' datatype='real' name='[Calculation_3156741911577911296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[consignment_gfv_eur]+[retail_gfv_eur]' />
            </column>
            <column caption='Availability' datatype='real' name='[Calculation_3156741911580594177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours])/SUM([potential_hours])' />
            </column>
            <column caption='Weighted Availability' datatype='real' name='[Calculation_3156741911580692482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avail_events_weightage_forecast])/SUM([total_events_weightage_forecast])' />
            </column>
            <column caption='Shrinkage Perc' datatype='real' name='[Calculation_3156741911586410500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_adjustment_value_eur])/SUM([Calculation_1161225073344581645])' />
            </column>
            <column caption='Store Coverage' datatype='real' name='[Calculation_3156741911617646609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([dmart_imt_warehouse_uuid]) / ATTR({FIXED [global_entity_id] : COUNTD([dmart_imt_warehouse_uuid])})' />
            </column>
            <column caption='Total Margins with Commissions Perc' datatype='real' name='[Total Margins Perc (copy)_3156741913352237091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([front_margins_eur]) + SUM([back_margins_eur]) + SUM([retail_promo_scan_rebate_eur]) + SUM([consignment_promo_scan_rebate_eur]) + SUM([consignment_revenue_eur]))/(SUM([retail_gfv_eur_less_vat])+SUM([consignment_gfv_eur_less_vat]))' />
            </column>
            <column caption='Avail Events Weighted Forecast' datatype='real' name='[avail_events_weightage_forecast]' role='measure' type='quantitative' />
            <column caption='Available Hours' datatype='integer' name='[available_hours]' role='measure' type='quantitative' />
