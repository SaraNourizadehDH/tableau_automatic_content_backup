              <zone h='84000' id='113' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='56' h='4033' id='6' is-fixed='true' param='Image/pandora rectangle.png' type-v2='bitmap' w='98666' x='667' y='571'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#b91e9c' />
                  </zone-style>
                </zone>
                <zone fixed-size='32' h='3143' id='10' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Pandora_Logo_Black_Gradient.png' type-v2='bitmap' w='11000' x='667' y='4604'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
