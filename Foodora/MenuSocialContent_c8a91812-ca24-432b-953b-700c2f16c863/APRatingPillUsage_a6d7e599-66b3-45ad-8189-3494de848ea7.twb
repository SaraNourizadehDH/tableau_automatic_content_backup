      <column caption='Food Complete Order Share' datatype='real' name='[Calculation_6064448784611143680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_no_food_complete_order])/SUM([total_no_restaurant_food_rating])' />
      </column>
      <column caption='Food Good Packaging Share' datatype='real' name='[Calculation_6064448784611287041]' role='measure' type='quantitative'>
