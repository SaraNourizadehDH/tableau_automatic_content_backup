              <calculation class='tableau' formula='if isnull(sum([total_terminated_vendors])) or sum([total_terminated_vendors]) = 0 then 0&#10;elseif (sum([total_terminated_vendors]) - [New Vendors L7D Average (copy)_392235447752470588])/abs([New Vendors L7D Average (copy)_392235447752470588]) &lt;=-0.5&#10;then 2&#10;elseif (sum([total_terminated_vendors]) - [New Vendors L7D Average (copy)_392235447752470588])/abs([New Vendors L7D Average (copy)_392235447752470588]) &gt;=0.5 or sum([total_terminated_vendors]) &gt;= 50&#10;then -2&#10;elseif ((sum([total_terminated_vendors]) - [New Vendors L7D Average (copy)_392235447752470588])/abs([New Vendors L7D Average (copy)_392235447752470588]) &lt;=-0.3)&#10;then 1&#10;elseif (sum([total_terminated_vendors]) - [New Vendors L7D Average (copy)_392235447752470588])/abs([New Vendors L7D Average (copy)_392235447752470588]) &gt;=0.3&#10;then -1&#10;else 0&#10;end'>
