              <calculation class='tableau' formula='[Active Delivery Vendor WoW Main (Negative) (copy)_6009350027132428299] + STR(ROUND([Vendors with Orders Delivery WoW Main (Negative) (copy)_6009350027134070798], 2)) + &apos;%&apos;' />
