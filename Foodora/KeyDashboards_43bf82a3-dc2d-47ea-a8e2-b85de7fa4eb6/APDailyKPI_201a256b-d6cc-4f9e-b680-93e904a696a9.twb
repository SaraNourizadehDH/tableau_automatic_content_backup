    <worksheet name='Revenue/GMV LW Growth Lowest Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>Lowest Growth %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='W1 Revenue/GMV %' datatype='string' datatype-customized='true' name='[Calculation_881931480923811840]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;sum(iif([is_yesterday],[Calculation_128141504822948034],0)) / sum(iif([is_yesterday],[total_gmv_eur],0))&#10;- sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0))&#10;)&#10;/ sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(&#10;round(sum(iif([is_yesterday],[Calculation_128141504822948034],0)),4) / round(sum(iif([is_yesterday],[total_gmv_eur],0)),4)&#10;- sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0))&#10;)&#10;/ round(sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0)),4)&#10;* 100, 2))' />
            </column>
            <column caption='W1 Revenue/GMV % (indicator)' datatype='string' datatype-customized='true' name='[Calculation_881931480924233729]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [Calculation_128141504822948034] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_gmv_eur] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_128141504822948034] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_128141504822948034] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
