            <column caption='% of total Orders' datatype='real' name='[Calculation_6109836638281674769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6649142689517953024]&#10;/&#10;( &#10;sum(&#10;{fixed: sum(iif([is_yesterday], [total_number_of_successful_orders], 0))}&#10;)&#10;+&#10;sum(&#10;{fixed [reference_date_local], [country_name]:&#10;max(iif([is_yesterday], [total_delivery_count], 0))&#10;}&#10;)&#10;)' />
            </column>
            <column caption='Orders WoW Main (Positive)' datatype='string' name='[Calculation_6109836638295011353]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Yesterday&apos;s Orders Main' datatype='integer' name='[Calculation_6649142689517953024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], ifnull([total_number_of_successful_orders], 0), 0))' />
            </column>
            <column caption='Orders WoW Main (Negative)' datatype='string' name='[Orders WoW Main (copy)_6109836638307602458]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / [Yesterday&apos;s Orders Main (copy)_6109836638288412692] &lt;= 0&#10;or isnull(([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / [Yesterday&apos;s Orders Main (copy)_6109836638288412692])&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / [Yesterday&apos;s Orders Main (copy)_6109836638288412692] &lt;= 0&#10;or isnull(([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / [Yesterday&apos;s Orders Main (copy)_6109836638288412692])&#10;then&#10;str(&#10;round(&#10;    ([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / [Yesterday&apos;s Orders Main (copy)_6109836638288412692] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='L7D Orders Main' datatype='integer' name='[Yesterday&apos;s Orders Main (copy)_6109836638288412692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_same_day_last_week], [total_number_of_successful_orders], null))' />
