      <table>
        <view>
          <datasources>
            <datasource caption='Vendors BQ (pandata)' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' />
          </datasources>
          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column caption='Kitchen Delivery' datatype='integer' name='[Calculation_94012665891921949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [vendor_type] = &apos;kitchen&apos; //or [vendor_type] = &apos;kitchen&amp;concepts&apos;&#10;    then [total_deliver_vendors]&#10;    else 0&#10;    END&#10;)' />
