            <column caption='Active Vendor WoW Main (Negative)' datatype='string' name='[Active Delivery Vendor WoW Main (Negative) (copy)_5849401880977408000]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Active Delivery Vendors Main (copy)_5849401880978919430] - [Active Delivery Vendors L7D Main (copy)_5849401880978317316]) / [Active Delivery Vendors L7D Main (copy)_5849401880978317316] &lt;= 0&#10;or isnull(([Yesterday&apos;s Active Delivery Vendors Main (copy)_5849401880978919430] - [Active Delivery Vendors L7D Main (copy)_5849401880978317316]) / [Active Delivery Vendors L7D Main (copy)_5849401880978317316])&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Active Delivery Vendors Main (copy)_5849401880978919430] - [Active Delivery Vendors L7D Main (copy)_5849401880978317316]) / [Active Delivery Vendors L7D Main (copy)_5849401880978317316] &lt;= 0&#10;or isnull(([Yesterday&apos;s Active Delivery Vendors Main (copy)_5849401880978919430] - [Active Delivery Vendors L7D Main (copy)_5849401880978317316]) / [Active Delivery Vendors L7D Main (copy)_5849401880978317316])&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Active Delivery Vendors Main (copy)_5849401880978919430] - [Active Delivery Vendors L7D Main (copy)_5849401880978317316]) / [Active Delivery Vendors L7D Main (copy)_5849401880978317316] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Active Vendors L7D Main' datatype='integer' name='[Active Delivery Vendors L7D Main (copy)_5849401880978317316]' role='measure' type='quantitative'>
