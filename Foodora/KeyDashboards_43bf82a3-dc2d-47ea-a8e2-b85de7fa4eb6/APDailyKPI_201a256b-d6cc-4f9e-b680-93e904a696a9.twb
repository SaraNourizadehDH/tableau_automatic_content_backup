      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='actuals vs YoY vs RR' id='_0FFA1DB809F7467892354DE7D57658E3'>
            <properties context=''>
              <relation connection='bigquery.1ilzdzo0lb2noy1dyjpd01k85h9h' name='Custom SQL Query' type='text'><![CDATA[WITH actuals_yoy AS (
  SELECT
  created_date_local,
  region,
  country_name,
  "FP_" || RIGHT(global_entity_id,2) AS global_entity_id,
  DATE_ADD(created_date_local, INTERVAL 364 DAY) AS equivalent_date,
  COUNT(DISTINCT order_code) AS total_orders_ly,
  SUM(COALESCE(user_paid_gmv_eur,0)) AS total_gmv_ly,

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders

WHERE created_date_local BETWEEN
                         DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Manila")-10, MONTH), INTERVAL 364 DAY)
                         AND
                         DATE_SUB(LAST_DAY(CURRENT_DATE("Asia/Manila")), INTERVAL 364 DAY)
  AND region = "Asia"
  AND is_successful

GROUP BY ALL
),

actuals_wow AS (
  SELECT
  DATE_ADD(created_date_local, INTERVAL 7 DAY) AS equivalent_date,
  created_date_local,
  region,
  country_name,
  "FP_" || RIGHT(global_entity_id,2) AS global_entity_id,
  COUNT(DISTINCT order_code) AS total_orders_l7D,
  SUM(COALESCE(user_paid_gmv_eur,0)) AS total_gmv_l7D,

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders

WHERE created_date_local BETWEEN
                         DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Manila")-10, MONTH), INTERVAL 7 DAY)
                         AND
                         DATE_SUB(CURRENT_DATE("Asia/Manila"), INTERVAL 7 DAY)
  AND region = "Asia"
  AND is_successful

GROUP BY ALL
),

mtd_orders AS (
  /*SELECT
    reference_date_local,
    region,
    country_name,
    global_entity_id,
    (SUM(total_number_of_successful_orders) + MAX(total_delivery_count)) AS total_orders,
    (SUM(total_gmv_eur) + MAX(total_pandago_gmv_eur)) AS total_gmv_eur,

  FROM `fulfillment-dwh-production.pandata_report.main_kpi_management_daily_apac`
  WHERE reference_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE()

  GROUP BY ALL*/
SELECT
  created_date_local AS reference_date_local,
  region,
  country_name,
  "FP_" || RIGHT(global_entity_id,2) AS global_entity_id,
  COUNT(DISTINCT order_code) AS total_orders,
  SUM(COALESCE(user_paid_gmv_eur,0)) AS total_gmv_eur,

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders

WHERE created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE()
  AND region = "Asia"
  AND is_successful
  GROUP BY ALL
),

runrates_mtd AS (

SELECT
  global_entity_id,
  DATE_TRUNC(order_date, MONTH) AS order_month,
  SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS rr_orders_eom,
  SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS rr_gmv_eom

FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates`

WHERE management_entity_group = "Foodpanda APAC"
  AND insert_date = CURRENT_DATE("Asia/Manila") - 1
  AND order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) AND LAST_DAY(CURRENT_DATE())

GROUP BY ALL

),

rr_daily_eom AS (

SELECT 
insert_date AS order_date, 
global_entity_id,
SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS orders_rr_eom,
SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS gmv_rr_eom

 FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates` 
 WHERE management_entity_group = 'Foodpanda APAC'
   AND insert_date BETWEEN DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE), MONTH) AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
   AND order_date BETWEEN DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE), MONTH) AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
 GROUP BY ALL

),

rr_daily_ly AS (
SELECT 
  insert_date AS order_date,
  DATE_ADD(insert_date, INTERVAL 1 YEAR) AS equivalent_date,
  global_entity_id,
  SUM(IF( DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH), COALESCE(orders,0), 0 ))
  +
  SUM(IF( DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH), COALESCE(orders_c2c,0), 0 ))
  +
  SUM(IF( DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH), COALESCE(orders_odr,0), 0 )) AS orders_rr_eom,
  -- SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS orders_rr_eom,
  SUM(IF( DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH), COALESCE(gmv_eur,0), 0 ))
  +
  SUM(IF( DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH), COALESCE(gmv_c2c_eur,0), 0 ))
  +
  SUM(IF( DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH), COALESCE(gmv_odr_eur,0), 0 )) AS gmv_rr_eom
  -- SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS gmv_rr_eom

 FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates` 
 WHERE management_entity_group = 'Foodpanda APAC'
    AND insert_date BETWEEN
                    DATE_SUB(DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())<<10,CURRENT_DATE-10,CURRENT_DATE), MONTH), INTERVAL 1 YEAR)
                    AND
                    DATE_SUB(LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE)), INTERVAL 1 YEAR)

   AND order_date BETWEEN
                    DATE_SUB(DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())<<10,CURRENT_DATE-10,CURRENT_DATE), MONTH), INTERVAL 1 YEAR)
                    AND
                    DATE_SUB(LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE)), INTERVAL 1 YEAR)

GROUP BY ALL
)

SELECT
  runrates.order_date,
  runrates.global_entity_id,
  mtd_orders.region,
  mtd_orders.country_name,

  mtd_orders.total_orders,
  actuals_yoy.total_orders_ly,
  actuals_wow.total_orders_l7D,
  SUM(rr_daily_eom.orders_rr_eom) AS orders_rr_eom,
  SUM(rr_daily_ly.orders_rr_eom) AS orders_rr_ly,
  SUM(runrates.orders) AS order_rr_for_the_day,
  SUM(runrates.orders_cum) AS order_rr_td,
  runrates_mtd.rr_orders_eom,
  
  mtd_orders.total_gmv_eur,
  actuals_yoy.total_gmv_ly,
  actuals_wow.total_gmv_l7D,
  SUM(rr_daily_eom.gmv_rr_eom) AS gmv_rr_eom,
  SUM(rr_daily_ly.gmv_rr_eom) AS gmv_rr_ly,
  SUM(runrates.gmv_eur) AS gmv_rr_for_the_day,
  SUM(runrates.gmv_eur_cum) AS gmv_rr_td,
  runrates_mtd.rr_gmv_eom,

FROM mtd_orders

LEFT JOIN actuals_yoy
       ON actuals_yoy.equivalent_date = mtd_orders.reference_date_local
      AND actuals_yoy.global_entity_id = mtd_orders.global_entity_id

LEFT JOIN actuals_wow
       ON actuals_wow.equivalent_date = mtd_orders.reference_date_local
      AND actuals_wow.global_entity_id = mtd_orders.global_entity_id

LEFT JOIN rr_daily_eom
       ON rr_daily_eom.order_date = mtd_orders.reference_date_local
      AND rr_daily_eom.global_entity_id = mtd_orders.global_entity_id

LEFT JOIN `fulfillment-dwh-production.curated_data_shared_intl_markets.runrates` AS runrates
       ON runrates.order_date = mtd_orders.reference_date_local
      AND runrates.global_entity_id = mtd_orders.global_entity_id

LEFT JOIN runrates_mtd
       ON runrates_mtd.order_month = DATE_TRUNC(mtd_orders.reference_date_local, MONTH)
      AND runrates_mtd.global_entity_id = mtd_orders.global_entity_id

LEFT JOIN rr_daily_ly
       ON rr_daily_ly.equivalent_date = mtd_orders.reference_date_local
      AND rr_daily_ly.global_entity_id = mtd_orders.global_entity_id

WHERE mtd_orders.region = "Asia"
  AND mtd_orders.reference_date_local BETWEEN DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE)<<10,CURRENT_DATE-10,CURRENT_DATE), MONTH)
                                          AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE)=1,CURRENT_DATE-1,CURRENT_DATE))

GROUP BY ALL
ORDER BY 1 DESC,2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
