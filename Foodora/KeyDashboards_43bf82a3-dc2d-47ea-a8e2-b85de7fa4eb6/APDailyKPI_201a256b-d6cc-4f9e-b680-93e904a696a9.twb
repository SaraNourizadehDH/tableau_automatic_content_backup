            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='marquee.enriquez@foodpanda.ph' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.035c99m0tei44m12hj8i10gbz88h' name='Custom SQL Query' type='text'>WITH mtd_orders AS (
  SELECT
    reference_date_local,
    (SUM(total_number_of_successful_orders) + SUM(total_delivery_count)) AS total_orders,
    (SUM(total_gmv_eur) + SUM(total_pandago_gmv_eur)) AS total_gmv_eur,
    (SUM(total_gmv_eur) + SUM(total_pandago_gmv_eur))
    /
    (SUM(total_number_of_successful_orders) + SUM(total_delivery_count)) AS afv_eur,
    SUM(total_commission_revenue_eur) + SUM(total_delivery_fee_eur) AS total_revenue_eur,
    (SUM(total_commission_revenue_eur) + SUM(total_delivery_fee_eur))
    /
    (SUM(total_gmv_eur) + SUM(total_pandago_gmv_eur)) AS revenue_per_gmv_eur

  FROM `fulfillment-dwh-production.pandata_report.main_kpi_management_daily_apac`
  WHERE reference_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 DAY) AND CURRENT_DATE()

  GROUP BY ALL
),

mtd_vendors AS (
  SELECT
    reference_date_local,
    SUM(total_vendors) AS total_new_vendors,
    SUM(total_terminated_vendors) AS total_churned_vendors,

  FROM `fulfillment-dwh-production.pandata_report.vendors_metrics_daily_country_categories`
  WHERE reference_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 DAY) AND CURRENT_DATE()

  GROUP BY ALL
)

SELECT
  mtd_orders.*,
  mtd_vendors.total_new_vendors,
  mtd_vendors.total_churned_vendors

FROM mtd_orders

LEFT JOIN mtd_vendors 
       ON mtd_vendors.reference_date_local = mtd_orders.reference_date_local

ORDER BY 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.035c99m0tei44m12hj8i10gbz88h' name='Custom SQL Query' type='text'>WITH mtd_orders AS (
  SELECT
    reference_date_local,
    (SUM(total_number_of_successful_orders) + SUM(total_delivery_count)) AS total_orders,
    (SUM(total_gmv_eur) + SUM(total_pandago_gmv_eur)) AS total_gmv_eur,
    (SUM(total_gmv_eur) + SUM(total_pandago_gmv_eur))
    /
    (SUM(total_number_of_successful_orders) + SUM(total_delivery_count)) AS afv_eur,
    SUM(total_commission_revenue_eur) + SUM(total_delivery_fee_eur) AS total_revenue_eur,
    (SUM(total_commission_revenue_eur) + SUM(total_delivery_fee_eur))
    /
