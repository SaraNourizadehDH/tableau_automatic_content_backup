      <table>
        <view>
          <datasources>
            <datasource caption='Vendors BQ (pandata)' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' />
          </datasources>
          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141504435327157]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_128141504433950898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_128141504434032819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Churned Vendors MTD vs PMTD (Indicator)' datatype='string' name='[Churned Vendors MTD vs PMTD (copy)_128141504435953847]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_128141504433950898], [total_terminated_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_128141504434032819], [total_terminated_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_128141504434032819], [total_terminated_vendors], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
