              <calculation class='tableau' formula='(SUM(IF [is_yesterday] THEN [total_number_of_successful_orders] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END))&#10;/ SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END)' />
