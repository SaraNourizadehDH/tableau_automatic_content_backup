    <worksheet name='Yesterday&apos;s Revenue/GMV '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='21'>Revenue/GMV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column caption='Revenue/GMV' datatype='real' name='[Calculation_411586794766696449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_128141504822948034])&#10;/&#10;(SUM([total_gmv_eur]) + ifnull(sum([Total PandaGo Orders (copy)_94012672827007022]),0))' />
            </column>
            <column caption='Total PandaGo GMV' datatype='integer' name='[Total PandaGo Orders (copy)_94012672827007022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [reference_date_local], [global_entity_id]:&#10;IFNULL(INT(SUM([total_pandago_gmv_eur])), 0)&#10;}' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Expedition Type1' datatype='string' name='[expedition_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;delivery&quot;' value='Delivery' />
                <alias key='&quot;pickup&quot;' value='Pickup' />
              </aliases>
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Corporate' datatype='boolean' name='[is_corporate]' role='dimension' type='nominal' />
            <column caption='Is Group Order' datatype='boolean' name='[is_group_order]' role='dimension' type='nominal' />
            <column caption='Is Yesterday' datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_yesterday]' derivation='None' name='[none:is_yesterday:nk]' pivot='key' type='nominal' />
            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Total Commission Revenue Eur' datatype='real' name='[total_commission_revenue_eur]' role='measure' type='quantitative' />
            <column caption='Total Delivery Fee Eur' datatype='real' name='[total_delivery_fee_eur]' role='measure' type='quantitative' />
            <column caption='Total Gmv Eur' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Total Pandago Gmv Eur' datatype='real' name='[total_pandago_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_411586794766696449]' derivation='User' name='[usr:Calculation_411586794766696449:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0esr49h041to0d1eolrdb0zzwgcd].[none:is_yesterday:nk]'>
            <groupfilter function='member' level='[none:is_yesterday:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
