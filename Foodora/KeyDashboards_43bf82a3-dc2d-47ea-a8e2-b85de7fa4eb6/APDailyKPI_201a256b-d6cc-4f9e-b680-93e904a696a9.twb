            </column>
            <column caption='Vendors with Orders Pickup WoW Main (Positive)' datatype='string' name='[Vendors with Orders Delivery WoW Main (Positive) (copy)_6009350027137847317]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Vendors with Orders Delivery WoW Main (Indicator) (copy)_6009350027134898192] = &apos;▲ &apos; &#10;then [Vendors with Orders Delivery WoW Main (copy)_6009350027136413714] &#10;ELSE null&#10;end' />
