    <datasource caption='Vendors BQ (pandata)' inline='true' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1nm370n179qtjn147zdym13hd2t7'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='marquee.enriquez@foodpanda.ph' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1nm370n179qtjn147zdym13hd2t7' name='Vendors BQ' type='text'><![CDATA[SELECT
  reference_date_local AS date,
  
  DATE_TRUNC(reference_date_local, ISOWEEK) AS isoweek,
  DATE_TRUNC(reference_date_local, month) AS month,
  reference_date_local = CURRENT_DATE AS is_today,
  reference_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, ISOWEEK), INTERVAL 4 WEEK) AND
      DATE_TRUNC(reference_date_local, ISOWEEK) << DATE_TRUNC(CURRENT_DATE, ISOWEEK) AS is_past_4_complete_isoweeks,
  reference_date_local = DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY) AS is_yesterday,
  reference_date_local = DATE_SUB(CURRENT_DATE, INTERVAL 8 DAY) AS is_last_week_same_day,
  reference_date_local = DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH) AS is_last_month_same_day,
  reference_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 3 MONTH) AND
    DATE_TRUNC(reference_date_local, MONTH) << DATE_TRUNC(CURRENT_DATE, MONTH) AS is_past_3_complete_months,
  DATE_TRUNC(reference_date_local, month) = DATE_TRUNC(CURRENT_DATE, month) AS is_current_month,
  region,
  country_name,
  vendor_type,
  total_vendors,
  total_pickup_vendors,
  total_deliver_vendors,
  
  total_active_vendors,
  total_active_pickup_vendors,
  total_active_deliver_vendors,
  
  total_terminated_vendors,
  total_new_pandago_vendors,
  total_pandago_active_vendors,
  total_vendor_with_orders,
  total_delivery_vendor_with_orders,
  total_pickup_vendor_with_orders,
  total_pandago_vendor_with_orders

FROM `fulfillment-dwh-production.pandata_report.vendors_metrics_daily_country_categories`
where reference_date_local << current_date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1nm370n179qtjn147zdym13hd2t7' name='Vendors BQ' type='text'><![CDATA[SELECT
