            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Total Gmv Eur' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Total Pandago Gmv Eur' datatype='real' name='[total_pandago_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1937392283964772353]' derivation='User' name='[usr:Calculation_1937392283964772353:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13ohnqk0cuautt13ln5q815t2u72'>
            <column caption='WoW (GMV) (formatted)' datatype='string' name='[WoW (GMV) (copy)_329959063513722881]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM([total_gmv_eur])-SUM([total_gmv_l7D]))&#10;   /&#10;   (SUM([total_gmv_eur])) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; +&#10;&#10;STR(&#10;ROUND(&#10;     (SUM([total_gmv_eur])-SUM([total_gmv_l7D]))&#10;     /&#10;     (SUM([total_gmv_eur]))&#10;     * 100, 2)&#10;)' />
            </column>
            <column caption='WoW (GMV) (indicator)' datatype='string' name='[WoW (GMV) (formatted) (copy)_248753537322119170]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM([total_gmv_eur])-SUM([total_gmv_l7D]))&#10;   /&#10;   (SUM([total_gmv_eur])) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
