        <calculation class='tableau' formula='if isnull(sum([total_number_of_successful_orders])) then 0&#10;elseif ((sum([total_number_of_successful_orders]) - [Shrinkage Time L7D Average (copy)_392235447105040416])/abs([Shrinkage Time L7D Average (copy)_392235447105040416]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([total_number_of_successful_orders]) - [Shrinkage Time L7D Average (copy)_392235447105040416])/abs([Shrinkage Time L7D Average (copy)_392235447105040416]) &lt;=-0.1&#10;then -2&#10;elseif ((sum([total_number_of_successful_orders]) - [Shrinkage Time L7D Average (copy)_392235447105040416])/abs([Shrinkage Time L7D Average (copy)_392235447105040416]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([total_number_of_successful_orders]) - [Shrinkage Time L7D Average (copy)_392235447105040416])/abs([Shrinkage Time L7D Average (copy)_392235447105040416]) &lt;=-0.05&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders L7D Average' datatype='real' name='[Shrinkage Time L7D Average (copy)_392235447105040416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([total_number_of_successful_orders]),first(),first()+7)'>
