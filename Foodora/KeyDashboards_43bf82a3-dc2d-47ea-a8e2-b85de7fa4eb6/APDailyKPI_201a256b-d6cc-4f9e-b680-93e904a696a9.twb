    <datasource caption='MTD runrates apac' inline='true' name='federated.0hlch8d0qwvlvg1aqae6i1olec8f' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1ty0co31nt0d8l131lz0701g0gea'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='marquee.enriquez@foodpanda.ph' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ty0co31nt0d8l131lz0701g0gea' name='Custom SQL Query' type='text'><![CDATA[SELECT
  DATE_TRUNC(order_date, MONTH) AS month,
  CASE
    WHEN EXTRACT(DAY FROM CURRENT_DATE)=1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()-1) THEN "MTD"
    WHEN EXTRACT(DAY FROM CURRENT_DATE)<<>>1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()) THEN "MTD"
    ELSE "PMTD"
  END AS period,
  SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS total_orders,
  SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS total_gmv_eur,

FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates`

WHERE management_entity_group = "Foodpanda APAC"
  AND insert_date = CURRENT_DATE("Asia/Manila") - 1
  AND order_date BETWEEN DATE_SUB(DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE), MONTH), INTERVAL 1 MONTH)
                     AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ty0co31nt0d8l131lz0701g0gea' name='Custom SQL Query' type='text'><![CDATA[SELECT
  DATE_TRUNC(order_date, MONTH) AS month,
  CASE
    WHEN EXTRACT(DAY FROM CURRENT_DATE)=1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()-1) THEN "MTD"
    WHEN EXTRACT(DAY FROM CURRENT_DATE)<<>>1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()) THEN "MTD"
    ELSE "PMTD"
  END AS period,
  SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS total_orders,
  SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS total_gmv_eur,

FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates`

WHERE management_entity_group = "Foodpanda APAC"
  AND insert_date = CURRENT_DATE("Asia/Manila") - 1
  AND order_date BETWEEN DATE_SUB(DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE), MONTH), INTERVAL 1 MONTH)
                     AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
