        <calculation class='tableau' formula='IF ([Calculation_2493516504955674626] &gt; 0 OR [country_name] = &apos;Japan&apos;) THEN [total_l7d_orders] ELSE NULL END' />
      </column>
      <column caption='L7D &amp; Previous L7D  (2 days before)' datatype='string' hidden='true' name='[L7D &amp; Previous L7D  (copy)_5401364115947757613]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -9, NOW()) AND [reference_date_local] &lt;= NOW() - 2&#10;THEN &apos;L7D&apos;&#10;ELSEIF [reference_date_local] &gt;= DATEADD(&apos;day&apos;, -16, NOW()) AND [reference_date_local] &lt;= DATEADD(&apos;day&apos;, -9, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
