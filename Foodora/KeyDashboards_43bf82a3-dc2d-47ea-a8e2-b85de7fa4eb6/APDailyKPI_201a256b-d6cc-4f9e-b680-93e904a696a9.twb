    <worksheet name='Revenue/GMV Daily'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column caption='Total GMV EUR (inc. Pandago)' datatype='real' name='[Calculation_345017965387022337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_gmv_eur] + [Total PandaGo Orders (copy)_94012672827007022]' />
            </column>
            <column caption='Revenue/GMV' datatype='real' name='[Calculation_411586794766696449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_128141504822948034])&#10;/&#10;(SUM([total_gmv_eur]) + ifnull(sum([Total PandaGo Orders (copy)_94012672827007022]),0))' />
            </column>
            <column caption='Revenue/GMV (inc. Pandago) L7D Average' datatype='real' name='[GMV (inc. Pandago) L7D Average (copy)_345017965669699596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_411586794766696449],last()-7,last())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Revenue/GMV (Indicator)' datatype='integer' name='[Revenue (Indicator) (copy)_147422529463877639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull(SUM([Calculation_128141504822948034])) then 0&#10;elseif isnull(SUM([Calculation_345017965387022337])) then 0&#10;elseif &#10;   (&#10;       ([Calculation_411586794766696449] - [GMV (inc. Pandago) L7D Average (copy)_345017965669699596])&#10;        / &#10;       [GMV (inc. Pandago) L7D Average (copy)_345017965669699596]&#10;    &gt;= 0.1)&#10;then 2&#10;elseif &#10;    (&#10;        ([Calculation_411586794766696449] - [GMV (inc. Pandago) L7D Average (copy)_345017965669699596])&#10;        / &#10;       [GMV (inc. Pandago) L7D Average (copy)_345017965669699596]&#10;    &lt;= -0.1)&#10;then -2&#10;elseif &#10;   (&#10;        ([Calculation_411586794766696449] - [GMV (inc. Pandago) L7D Average (copy)_345017965669699596])&#10;        / &#10;       [GMV (inc. Pandago) L7D Average (copy)_345017965669699596]&#10;    &gt;= 0.05)&#10;then 1&#10;elseif &#10;    (&#10;        ([Calculation_411586794766696449] - [GMV (inc. Pandago) L7D Average (copy)_345017965669699596])&#10;        / &#10;       [GMV (inc. Pandago) L7D Average (copy)_345017965669699596]&#10;    &lt;= -0.05)&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total PandaGo GMV' datatype='integer' name='[Total PandaGo Orders (copy)_94012672827007022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [reference_date_local], [global_entity_id]:&#10;IFNULL(INT(SUM([total_pandago_gmv_eur])), 0)&#10;}' />
            </column>
            <column caption='Yesterday&apos;s Revenue/GMV Main' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Yesterday&apos;s Revenue Main (copy)_147422529507872780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;IF [is_yesterday] AND [expedition_type] = &apos;delivery&apos;&#10;THEN [Calculation_128141504822948034] //- [ads_revenue_eur]&#10;ELSEIF [is_yesterday] AND [expedition_type] = &apos;pickup&apos;&#10;THEN [Calculation_128141504822948034]&#10;ELSE null&#10;END)&#10;)&#10;/&#10;(SUM(IIF([is_yesterday], [total_gmv_eur], null)))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Expedition Type1' datatype='string' name='[expedition_type]' role='dimension' type='nominal'>
