        <calculation class='tableau' formula='IF &#10;  (&#10;    ([MTD GMV Main (copy)_2421247803289403409] - [PMTD GMV Main (copy)_2421247803289403415])&#10;    /&#10;    IIF([PMTD GMV Main (copy)_2421247803289403415] = 0, 1, [PMTD GMV Main (copy)_2421247803289403415])&#10;  ) &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([MTD GMV Main (copy)_2421247803289403409] - [PMTD GMV Main (copy)_2421247803289403415])&#10;    /&#10;    IIF([PMTD GMV Main (copy)_2421247803289403415] = 0, 1, [PMTD GMV Main (copy)_2421247803289403415])&#10;  ) &gt; 0&#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([MTD GMV Main (copy)_2421247803289403409] - [PMTD GMV Main (copy)_2421247803289403415])&#10;            / &#10;            IIF([PMTD GMV Main (copy)_2421247803289403415] = 0, 1, [PMTD GMV Main (copy)_2421247803289403415])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
