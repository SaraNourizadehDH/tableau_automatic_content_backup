      <column caption='MoM Terminated Vendor Growth (Indicator)' datatype='string' hidden='true' name='[MoM Terminated Vendor Growth (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;(SUM(IIF([is_yesterday], [total_terminated_vendors], 0)) - SUM(IIF([is_last_month_same_day], [total_terminated_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_month_same_day], [total_terminated_vendors], 0)) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSEIF isnull((SUM(IIF([is_yesterday], [total_terminated_vendors], 0)) - SUM(IIF([is_last_month_same_day], [total_terminated_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_month_same_day], [total_terminated_vendors], 0))) THEN &apos;-&apos;&#10;ELSE &apos;▼&apos; END' />
