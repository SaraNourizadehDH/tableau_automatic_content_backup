              <calculation class='tableau' formula='1' />
            </column>
            <column caption='LW Vendor Growth' datatype='string' name='[Calculation_6433251340714938375]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[LW Vendor Growth (copy)]&#10;&#10;+&#10;&#10;STR(ROUND([LW Vendor Growth (copy 6)_861313449380503571],1))' />
            </column>
            <column caption='LW Vendor Growth (Positive)' datatype='string' name='[LW Vendor Growth (Indicator) (copy 3)_861313449381715989]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [LW Vendor Growth (copy)] = &apos;▲ &apos; THEN [LW Vendor Growth (copy 6)_861313449384054807] ELSE NULL END' />
