        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_128141504433950898], [total_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_128141504434032819], [total_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;iif(&#10;isnull(SUM(&#10;    iif([Calculation_128141504434032819], [total_vendors], 0)&#10;)) or (SUM(&#10;    iif([Calculation_128141504434032819], [total_vendors], 0)&#10;)) = 0,&#10;1,&#10;SUM(&#10;    iif([Calculation_128141504434032819], [total_vendors], 0)&#10;)&#10;)&#10;&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_128141504433950898], [total_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_128141504434032819], [total_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;iif(&#10;isnull(SUM(&#10;    iif([Calculation_128141504434032819], [total_vendors], 0)&#10;)) or (SUM(&#10;    iif([Calculation_128141504434032819], [total_vendors], 0)&#10;)) = 0,&#10;1,&#10;SUM(&#10;    iif([Calculation_128141504434032819], [total_vendors], 0)&#10;)&#10;)&#10;* 100&#10;,2)&#10;)' />
