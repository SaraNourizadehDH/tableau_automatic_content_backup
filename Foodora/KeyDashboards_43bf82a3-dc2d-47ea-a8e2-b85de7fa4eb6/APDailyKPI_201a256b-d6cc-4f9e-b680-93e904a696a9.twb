        <calculation class='tableau' formula='STR(&#10;    IIF(&#10;        ROUND(&#10;                (&#10;                    ([Yesterday AFV Eur (copy)_1281977819188674586] - [Last Week AFV Eur (copy)_1281977819188957211])&#10;                    / &#10;                    [Last Week AFV Eur (copy)_1281977819188957211]&#10;                ) * 100&#10;            , 2) &gt;= 0,&#10;        &apos;▲&apos;,&#10;        &apos;▼&apos;&#10;    )&#10;) &#10;&#10;+&#10;&#10;STR(&#10;    ROUND(&#10;        (&#10;            ([Yesterday AFV Eur (copy)_1281977819188674586] - [Last Week AFV Eur (copy)_1281977819188957211])&#10;            / &#10;            [Last Week AFV Eur (copy)_1281977819188957211]&#10;        ) * 100&#10;    , 2)&#10;) + &apos;%&apos;' />
