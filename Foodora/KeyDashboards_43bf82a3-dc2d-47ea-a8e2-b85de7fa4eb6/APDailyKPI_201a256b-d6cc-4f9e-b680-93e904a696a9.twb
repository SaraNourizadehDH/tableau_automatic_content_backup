rr_daily_ly AS (
SELECT 
  insert_date AS order_date,
  DATE_ADD(insert_date, INTERVAL 1 YEAR) AS equivalent_date,
  global_entity_id,
  SUM(IF( DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH), COALESCE(orders,0), 0 ))
  +
