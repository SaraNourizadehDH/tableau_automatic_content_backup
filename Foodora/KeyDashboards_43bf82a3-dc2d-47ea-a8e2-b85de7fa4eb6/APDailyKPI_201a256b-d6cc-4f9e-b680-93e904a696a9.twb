            <column caption='W1 Order % (Indicator)' datatype='string' name='[W1 GFV % (Indicator) (copy 2)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [is_yesterday] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [is_yesterday] THEN [Calculation_94012672413073445] ELSE 0 END)) - (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 Order %' datatype='string' name='[W1 GFV % (copy 3)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [is_yesterday] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [is_yesterday] THEN [Calculation_94012672413073445] ELSE 0 END)) - (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF (SUM(IF [is_yesterday] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [is_yesterday] THEN [Calculation_94012672413073445] ELSE 0 END)) - (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END)) &gt;= 0&#10;THEN &#10;   ((SUM(IF [is_yesterday] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [is_yesterday] THEN [Calculation_94012672413073445] ELSE 0 END)) - (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END)))&#10;   / (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END))&#10;ELSE&#10;   ((SUM(IF [is_yesterday] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [is_yesterday] THEN [Calculation_94012672413073445] ELSE 0 END)) - (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END)))&#10;   / (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_3363766717911343105] ELSE 0 END)+MAX(IF [Calculation_6180416436320313347] THEN [Calculation_94012672413073445] ELSE 0 END))&#10;END * 100, 2))' />
            </column>
            <column caption='W1 Order % Ranking' datatype='real' name='[W1 Order % (copy 2)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(IF [is_yesterday] THEN [total_number_of_successful_orders] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END))&#10;/ SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END)' />
