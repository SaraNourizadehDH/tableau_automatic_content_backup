        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.15vho5a0yc446h1al8uh50lkxb3s' name='Custom SQL Query' type='text'><![CDATA[SELECT
  date_local,
  country,
  region,
  platform,

  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY) AS is_yesterday, 
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 2 DAY) AS is_2yesterday,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 8 DAY) AS is_same_day_last_week,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 9 DAY) AS is_same_2day_last_week,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 32 DAY) AS is_same_day_last_month,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 367 DAY) AS is_same_day_last_year,

  sessions,
  transactions,

  SUM_mOCVR1,
  SUM_mOCVR2,
  SUM_mOCVR3,
  SUM_mOCVR4,
  SUM_mCVR1,
  SUM_mCVR2,
  SUM_mCVR3,
  SUM_mCVR4,

  count_mOCVR1,
  count_mOCVR2,
  count_mOCVR3,
  count_mOCVR4
FROM `fulfillment-dwh-production.pandata_report.frontend_kpis_daily_sessions_count_by_country`
where date_local << current_date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.15vho5a0yc446h1al8uh50lkxb3s' name='Custom SQL Query' type='text'><![CDATA[SELECT
  date_local,
  country,
  region,
  platform,

  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY) AS is_yesterday, 
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 2 DAY) AS is_2yesterday,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 8 DAY) AS is_same_day_last_week,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 9 DAY) AS is_same_2day_last_week,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 32 DAY) AS is_same_day_last_month,
  date_local = DATE_SUB(CURRENT_DATE, INTERVAL 367 DAY) AS is_same_day_last_year,

