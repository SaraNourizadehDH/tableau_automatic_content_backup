        <calculation class='tableau' formula='IF &#10;(&#10;SUM(IF [is_yesterday] THEN [total dh subsidies (copy)] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_gmv_eur] ELSE 0 END)&#10;-&#10;SUM(IF [Calculation_6180416436320313347] THEN [total dh subsidies (copy)] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END)&#10;)&#10;/&#10;SUM(IF [Calculation_6180416436320313347] THEN [total dh subsidies (copy)] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(&#10;ROUND( SUM(IF [is_yesterday] THEN [total dh subsidies (copy)] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_gmv_eur] ELSE 0 END), 3)&#10;-&#10;ROUND( SUM(IF [Calculation_6180416436320313347] THEN [total dh subsidies (copy)] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END), 3)&#10;)&#10;/&#10;ROUND( SUM(IF [Calculation_6180416436320313347] THEN [total dh subsidies (copy)] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END), 3)&#10;* 100, 2))' />
