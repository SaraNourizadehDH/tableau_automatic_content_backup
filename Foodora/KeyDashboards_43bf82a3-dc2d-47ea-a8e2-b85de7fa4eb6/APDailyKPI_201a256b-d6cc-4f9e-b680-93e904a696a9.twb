      <table>
        <view>
          <datasources>
            <datasource caption='frontend KPIs' name='federated.1dfy97k0y0hksj15r8lif14anfxu' />
          </datasources>
          <datasource-dependencies datasource='federated.1dfy97k0y0hksj15r8lif14anfxu'>
            <column caption='W1 Session % Ranking' datatype='real' name='[Calculation_130111845120487428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END)' />
            </column>
            <column caption='W1 Session %' datatype='string' name='[Calculation_5946862607191425025]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END)&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;END * 100, 2))' />
            </column>
            <column caption='W1 Session % (indicator)' datatype='string' name='[Calculation_5946862607192367106]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='INDEX' datatype='integer' name='[Calculation_5946862607196160004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
