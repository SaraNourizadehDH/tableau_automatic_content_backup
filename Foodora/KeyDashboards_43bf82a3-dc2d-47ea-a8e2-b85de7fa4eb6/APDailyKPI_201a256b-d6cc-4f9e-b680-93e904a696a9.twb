      <column caption='A7D CVR' datatype='real' hidden='true' name='[A7D Sessions (copy)_267190132477788171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IIF([date_local] &gt;= NOW() - 8, [transactions], 0)) / SUM(IIF([date_local] &gt;= NOW() - 8, [sessions], 0)))&#10;/&#10;7' />
      </column>
      <column caption='A7D CVR Avg' datatype='real' hidden='true' name='[A7D Sessions Avg (copy)_267190132478574605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([transactions]),first(),first()+7)&#10;/&#10;WINDOW_AVG(sum([sessions]),first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CVR Per Day' datatype='real' hidden='true' name='[Calculation_1139199613502623744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{&#10;FIXED [date_local]:&#10;[Calculation_267190132453117953]&#10;}' />
      </column>
      <column caption='MoM CVR Growth%' datatype='string' hidden='true' name='[Calculation_1139199614489714690]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;    ROUND(SUM(IF [is_2yesterday] THEN [transactions] ELSE 0 END) / SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END),4)&#10;    - ROUND(SUM(IF [is_same_day_last_month] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_day_last_month] THEN [sessions] ELSE 0 END),4)&#10;)&#10;/ ROUND(SUM(IF [is_same_day_last_month] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_day_last_month] THEN [sessions] ELSE 0 END),4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(&#10;ROUND(SUM(IF [is_2yesterday] THEN [transactions] ELSE 0 END) / SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END),4)&#10;    - ROUND(SUM(IF [is_same_day_last_month] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_day_last_month] THEN [sessions] ELSE 0 END),4)&#10;)&#10;/ ROUND(SUM(IF [is_same_day_last_month] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_day_last_month] THEN [sessions] ELSE 0 END),4)&#10;* 100, 2))' />
      </column>
      <column caption='MoM CVR Growth % (Indicator)' datatype='string' hidden='true' name='[Calculation_1139199614520156163]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;    ROUND(SUM(IF [is_2yesterday] THEN [transactions] ELSE 0 END) / SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END),4)&#10;    - ROUND(SUM(IF [is_same_day_last_month] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_day_last_month] THEN [sessions] ELSE 0 END),4)&#10;)&#10;/ ROUND(SUM(IF [is_same_day_last_month] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_day_last_month] THEN [sessions] ELSE 0 END),4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Yesterday Sessions' datatype='integer' name='[Calculation_1281977819495858229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_2yesterday], [sessions], 0))' />
      </column>
      <column caption='% Diff in Sum Sessions' datatype='string' hidden='true' name='[Calculation_1281977819496775735]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(&#10;    IIF(&#10;        ROUND(&#10;                (&#10;                    ([Calculation_1281977819495858229] - [Yesterday Sessions (copy)_1281977819496431670])&#10;                    / &#10;                    [Yesterday Sessions (copy)_1281977819496431670]&#10;                ) * 100&#10;            , 2) &gt;= 0,&#10;        &apos;▲&apos;,&#10;        &apos;▼&apos;&#10;    )&#10;) &#10;&#10;+&#10;&#10;STR(&#10;    ROUND(&#10;        (&#10;            ([Calculation_1281977819495858229] - [Yesterday Sessions (copy)_1281977819496431670])&#10;            / &#10;            [Yesterday Sessions (copy)_1281977819496431670]&#10;        ) * 100&#10;    , 2)&#10;) + &apos;%&apos;' />
      </column>
      <column caption='Last T7D Sessions Number' datatype='integer' hidden='true' name='[Calculation_1281977819498299448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(LAST()=1, [Calculation_2903766264184377345], NULL)'>
