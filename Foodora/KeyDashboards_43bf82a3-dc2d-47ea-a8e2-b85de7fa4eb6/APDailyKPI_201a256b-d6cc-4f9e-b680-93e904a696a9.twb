      <column caption='Yesterday&apos;s Revenue/GMV Main' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Yesterday&apos;s Revenue Main (copy)_147422529507872780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;IF [is_yesterday] AND [expedition_type] = &apos;delivery&apos;&#10;THEN [Calculation_128141504822948034] //- [ads_revenue_eur]&#10;ELSEIF [is_yesterday] AND [expedition_type] = &apos;pickup&apos;&#10;THEN [Calculation_128141504822948034]&#10;ELSE null&#10;END)&#10;)&#10;/&#10;(SUM(IIF([is_yesterday], [total_gmv_eur], null)))' />
      </column>
      <column caption='YoY AFV % (Indicator)' datatype='string' hidden='true' name='[YoY AFV % (copy)_5401364105261809679]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;(&#10;ROUND(SUM(IF [is_yesterday] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;- ROUND(SUM(IF [is_last_year] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_last_year] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;/ &#10;ROUND(SUM(IF [is_last_year] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_last_year] THEN [total_number_of_successful_orders] ELSE 0 END),2) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='YoY Comm Rev % (Indicator)' datatype='string' hidden='true' name='[YoY GMV % (Indicator) (copy)_746893856029605905]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [total_commission_revenue_eur] ELSE 0 END) - SUM(IF [is_last_year] THEN [total_commission_revenue_eur] ELSE 0 END))&#10;/ SUM(IF [is_last_year] THEN [total_commission_revenue_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='YoY AFV %' datatype='string' hidden='true' name='[YoY GMV % (copy)_5401364105261518862]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;(&#10;ROUND(SUM(IF [is_yesterday] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;- ROUND(SUM(IF [is_last_year] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_last_year] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;/ &#10;ROUND(SUM(IF [is_last_year] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_last_year] THEN [total_number_of_successful_orders] ELSE 0 END),2) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND( &#10;(&#10;    ROUND(SUM(IF [is_yesterday] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;    - ROUND(SUM(IF [is_last_year] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_last_year] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;    / &#10;    ROUND(SUM(IF [is_last_year] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [is_last_year] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;* 100, 2))' />
      </column>
      <column caption='YoY Comm Rev %' datatype='string' hidden='true' name='[YoY GMV % (copy)_746893856029429776]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [total_commission_revenue_eur] ELSE 0 END) - SUM(IF [is_last_year] THEN [total_commission_revenue_eur] ELSE 0 END))&#10;/ SUM(IF [is_last_year] THEN [total_commission_revenue_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND( &#10;   (SUM(IF [is_yesterday] THEN [total_commission_revenue_eur] ELSE 0 END) - SUM(IF [is_last_year] THEN [total_commission_revenue_eur] ELSE 0 END))&#10;   / SUM(IF [is_last_year] THEN [total_commission_revenue_eur] ELSE 0 END)&#10;* 100, 2))' />
      </column>
