            <column caption='Total Commission Revenue Eur' datatype='real' name='[total_commission_revenue_eur]' role='measure' type='quantitative' />
            <column caption='Total Delivery Fee Eur' datatype='real' name='[total_delivery_fee_eur]' role='measure' type='quantitative' />
            <column caption='Total Gmv Eur' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Revenue WoW Main (Negative) (copy)_147422529481183241]' derivation='User' name='[usr:Revenue WoW Main (Negative) (copy)_147422529481183241:nk]' pivot='key' type='nominal' />
            <column-instance column='[Revenue WoW Main (Positive) (copy)_147422529480409096]' derivation='User' name='[usr:Revenue WoW Main (Positive) (copy)_147422529480409096:nk]' pivot='key' type='nominal' />
