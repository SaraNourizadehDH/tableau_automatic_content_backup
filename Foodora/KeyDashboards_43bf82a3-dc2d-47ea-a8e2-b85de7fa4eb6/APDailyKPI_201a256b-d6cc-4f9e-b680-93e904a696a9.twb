    <worksheet name='Order T7D Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column aggregation='Sum' caption='1 T7D Growth' datatype='integer' name='[1 T7D (copy)_128141500668571653]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='T7D Growth %' />
              </aliases>
            </column>
            <column caption='T7D Orders' datatype='integer' name='[Calculation_128141500660142081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 8, [total_number_of_successful_orders], 0))&#10;+&#10;IFNULL(&#10;    SUM( &#10;        {FIXED [reference_date_local], [country_name]:&#10;          MAX(IIF([reference_date_local] &gt;= now() - 8, [total_delivery_count], 0))&#10;         }&#10;        )&#10;,0)' />
            </column>
            <column caption='T7D Growth %' datatype='string' name='[Calculation_128141500664979459]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Calculation_128141500660142081] - [T7D Orders (copy)_128141500664102914]) / [T7D Orders (copy)_128141500664102914] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([Calculation_128141500660142081] - [T7D Orders (copy)_128141500664102914]) / [T7D Orders (copy)_128141500664102914]*100,2)&#10;)' />
            </column>
            <column caption='Yesterday&apos;s Orders Main' datatype='integer' name='[Calculation_6649142689517953024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], ifnull([total_number_of_successful_orders], 0), 0))' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='T7D Growth % (Indicator)' datatype='string' name='[T7D Growth % (copy)_128141500667166724]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Calculation_128141500660142081] - [T7D Orders (copy)_128141500664102914]) / [T7D Orders (copy)_128141500664102914] &lt;= 0&#10;then &apos;▼&apos; &#10;ELSE &apos;▲&apos; &#10;end' />
            </column>
            <column caption='Previous T7D Orders' datatype='integer' name='[T7D Orders (copy)_128141500664102914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 15 AND [reference_date_local] &lt; now() - 8, [total_number_of_successful_orders], 0))' />
            </column>
