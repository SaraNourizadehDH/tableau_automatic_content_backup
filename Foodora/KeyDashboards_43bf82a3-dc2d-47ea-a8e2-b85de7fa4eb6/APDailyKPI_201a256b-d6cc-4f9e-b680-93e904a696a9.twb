    <worksheet name='Revenue/GMV MTD Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 0&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 1&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Revenue/GMV MTD vs PMTD (Indicator) ' datatype='string' name='[Revenue MTD vs PMTD (Indicator) (copy)_881931480934952964]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    (&#10;    SUM(iif([PMTD (copy)_128141502928715882], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;    )&#10;    -&#10;    (&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;    )&#10;)&#10;&#10;/&#10;    (&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;    )&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Revenue/GMV MTD vs PMTD' datatype='string' name='[Revenue MTD vs PMTD (copy)_881931480932655107]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    (&#10;    SUM(iif([PMTD (copy)_128141502928715882], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;    )&#10;    -&#10;    (&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;    )&#10;)&#10;&#10;/&#10;    (&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;    )&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    (&#10;    SUM(iif([PMTD (copy)_128141502928715882], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;    )&#10;    -&#10;    (&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;    )&#10;)&#10;&#10;/&#10;&#10;    (&#10;    SUM(iif([PMTD (copy)_128141502928715882], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;    )&#10;    -&#10;    (&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0))&#10;    /&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;    )&#10;* 100&#10;,2)&#10;)' />
            </column>
            <column caption='Yesterday&apos;s Revenue/GMV Main' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Yesterday&apos;s Revenue Main (copy)_147422529507872780]' role='measure' type='quantitative'>
