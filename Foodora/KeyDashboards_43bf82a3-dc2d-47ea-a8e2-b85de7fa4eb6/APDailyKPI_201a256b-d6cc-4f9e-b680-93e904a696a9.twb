      <column caption='CVR  Indicator (Color) ' datatype='integer' hidden='true' name='[Sessions Indicator (Color) (copy)_267190132478488588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull(sum([Calculation_1139199613502623744])) then 0&#10;elseif ((sum([Calculation_1139199613502623744]) - [A7D Sessions Avg (copy)_267190132478574605])/abs([A7D Sessions Avg (copy)_267190132478574605]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([Calculation_1139199613502623744]) - [A7D Sessions Avg (copy)_267190132478574605])/abs([A7D Sessions Avg (copy)_267190132478574605]) &lt;=-0.1&#10;then -2&#10;elseif ((sum([Calculation_1139199613502623744]) - [A7D Sessions Avg (copy)_267190132478574605])/abs([A7D Sessions Avg (copy)_267190132478574605]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([Calculation_1139199613502623744]) - [A7D Sessions Avg (copy)_267190132478574605])/abs([A7D Sessions Avg (copy)_267190132478574605]) &lt;=-0.05&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='T7D CVR (Previous L7D)' datatype='real' hidden='true' name='[T7D Sessions (Previous L7D) (copy)_267190132475785224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(IIF([date_local]&gt;= now() - 15 and [date_local] &gt;= NOW() - 8, [transactions], 0))) &#10;/ &#10;(SUM(IIF([date_local]&gt;= now() - 15 and [date_local] &gt;= NOW() - 8, [sessions], 0)))&#10;)&#10;/&#10;7' />
      </column>
      <column caption='T7D Sessions (Exec)' datatype='integer' hidden='true' name='[T7D Sessions (copy)_1281977819499413561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([date_local]&gt;= now() - 9, [sessions], 0))' />
      </column>
      <column caption='T7D CVR' datatype='real' hidden='true' name='[T7D Sessions (copy)_267190132475441159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IIF([date_local] &gt;= NOW() - 8, [transactions], 0))) &#10;/ &#10;(SUM(IIF([date_local] &gt;= NOW() - 8, [sessions], 0))))&#10;/&#10;7' />
      </column>
      <column caption='T7D CVR Growth ' datatype='string' hidden='true' name='[T7D Sessions Growth  (copy)_267190132476477449]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([T7D Sessions (copy)_267190132475441159] - [T7D Sessions (Previous L7D) (copy)_267190132475785224])&#10;/&#10;[T7D Sessions (Previous L7D) (copy)_267190132475785224] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;    ([T7D Sessions (copy)_267190132475441159] - [T7D Sessions (Previous L7D) (copy)_267190132475785224])&#10;    /&#10;    [T7D Sessions (Previous L7D) (copy)_267190132475785224]&#10;    * 100&#10;    , 2&#10;))' />
      </column>
      <column caption='T7D CVR Growth (Indicator)' datatype='string' hidden='true' name='[T7D Sessions Growth (Indicator) (copy)_267190132476682250]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([T7D Sessions (copy)_267190132475441159] - [T7D Sessions (Previous L7D) (copy)_267190132475785224]) / [T7D Sessions (Previous L7D) (copy)_267190132475785224] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='W1 CVR Growth % (Ranking)' datatype='real' hidden='true' name='[W1 CVR  Growth % (copy)_1139199614605008906]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ROUND(&#10;(&#10;ROUND(SUM(IF [is_2yesterday] THEN [transactions] ELSE 0 END) / SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END),4)&#10;    - ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4)&#10;)&#10;/ ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4)&#10;* 100, 2)' />
      </column>
      <column caption='Last Week Sessions' datatype='integer' hidden='true' name='[Yesterday Sessions (copy)_1281977819496431670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_same_2day_last_week], [sessions], 0))' />
      </column>
