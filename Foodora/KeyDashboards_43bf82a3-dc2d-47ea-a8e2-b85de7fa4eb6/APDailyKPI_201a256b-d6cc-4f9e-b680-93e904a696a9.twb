      </column>
      <column caption='W1 CVR  Growth %' datatype='string' hidden='true' name='[Calculation_267190132454871042]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;    ROUND(SUM(IF [is_2yesterday] THEN [transactions] ELSE 0 END) / SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END),4)&#10;    - ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4)&#10;)&#10;/ ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(&#10;ROUND(SUM(IF [is_2yesterday] THEN [transactions] ELSE 0 END) / SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END),4)&#10;    - ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4)&#10;)&#10;/ ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4)&#10;* 100, 2))' />
      </column>
      <column caption='W1 CVR Growth % (indicator)' datatype='string' hidden='true' name='[Calculation_267190132462022659]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;    ROUND(SUM(IF [is_2yesterday] THEN [transactions] ELSE 0 END) / SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END),4)&#10;    - ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4)&#10;)&#10;/ ROUND(SUM(IF [is_same_2day_last_week] THEN [transactions] ELSE 0 END) / SUM(IF [is_same_2day_last_week] THEN [sessions] ELSE 0 END),4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='A7D Sessions Avg' datatype='real' name='[Calculation_2719118681297281024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum(sessions),first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_284219392700309504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Sessions Ranking' datatype='integer' hidden='true' name='[Calculation_284219392712097793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([date_local] &gt;= NOW() - 8, [sessions], NULL))' />
      </column>
      <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_284219392721838084]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='MTD Growth %' />
        </aliases>
      </column>
      <column caption='MoM' datatype='string' hidden='true' name='[Calculation_284219392729989127]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
        <aliases>
          <alias key='&quot;&quot;' value='MoM Growth %' />
        </aliases>
      </column>
      <column caption='YoY Sessions Growth %' datatype='string' hidden='true' name='[Calculation_284219392730755080]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END)&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;END * 100, 2))' />
      </column>
      <column caption='YoY Sessions Growth % (Indicator)' datatype='string' hidden='true' name='[Calculation_284219392730845193]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_2yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_year] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='A7D Growth' datatype='string' name='[Calculation_284219392730980362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
        <aliases>
          <alias key='&quot;&quot;' value='A7D Growth %' />
        </aliases>
      </column>
      <column caption='A7D Sessions' datatype='real' name='[Calculation_284219393412456459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([date_local] &gt;= now() - 8, [sessions], 0)) / 7' />
      </column>
      <column caption='A7D Total Sessions Label' datatype='string' name='[Calculation_2903766264177389568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
        <aliases>
          <alias key='&quot;&quot;' value='A7D Total Sessions' />
        </aliases>
      </column>
      <column caption='T7D Sessions' datatype='integer' name='[Calculation_2903766264184377345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([date_local]&gt; DATE(now()) - 8 AND [date_local]&lt; date(now()), [sessions], null)) // / 7' />
      </column>
      <column caption='T7D Sessions (Previous L7D)' datatype='integer' name='[Calculation_2903766264184512514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([date_local]&gt;= now() - 15 and [date_local]&lt; now() - 8, [sessions], null)) // / 7' />
      </column>
      <column caption='T7D Sessions Growth ' datatype='string' name='[Calculation_2903766264184836099]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_2903766264184377345] - [Calculation_2903766264184512514])&#10;/&#10;[Calculation_2903766264184512514] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;    ([Calculation_2903766264184377345] - [Calculation_2903766264184512514])&#10;    /&#10;    [Calculation_2903766264184512514]&#10;    * 100&#10;    , 2&#10;))' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_2903766264200196100]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today()) = 1&#10;AND&#10;DAY([date_local]) &lt; DAY(TODAY())' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_2903766264200929285]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today()) = 0&#10;AND&#10;DAY([date_local]) &lt; DAY(TODAY())' />
      </column>
      <column caption='MTD Sessions Growth %' datatype='string' name='[Calculation_2903766264201121798]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [sessions], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [sessions], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [sessions], 0)&#10;    ) &lt;= 0&#10;    then &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    end&#10;    &#10;    +&#10;    str(round(&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [sessions], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [sessions], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [sessions], 0)&#10;    ) * 100&#10;    ,2)&#10;    )' />
      </column>
      <column caption='MTD Sessions Growth % (Indicator)' datatype='string' name='[Calculation_2903766264201953287]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [sessions], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [sessions], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [sessions], 0)&#10;    ) &lt;= 0&#10;    then &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    end' />
      </column>
      <column caption='L7D vs Previous L7D' datatype='string' name='[Calculation_2903766264206626825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [date_local] &gt; DATEADD(&apos;day&apos;, -8, DATE(NOW())) AND [date_local] &lt; DATE(NOW())&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date_local] &gt; DATEADD(&apos;day&apos;, -15, DATE(NOW())) AND [date_local] &lt;= DATEADD(&apos;day&apos;, -8, DATE(NOW()))&#10;THEN &apos;Previous L7D&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Day Similar L7D' datatype='datetime' name='[Calculation_2903766264208769034]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [date_local] &lt; DATEADD(&apos;day&apos;, -7, DATE(now()))&#10;THEN DATEADD(&apos;day&apos;, 7, [date_local])&#10;ELSE [date_local]&#10;END' />
      </column>
      <column caption='f.Exclude Today' datatype='boolean' name='[Calculation_5946862607182192640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, NOW()) &lt;= 2, [date_utc] &lt;= NOW() - 2, [date_utc] != TODAY())&#10;&#10;[date_local] != TODAY()' />
      </column>
      <column caption='W1 Session %' datatype='string' name='[Calculation_5946862607191425025]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END)&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;END * 100, 2))' />
      </column>
      <column caption='W1 Session % (indicator)' datatype='string' name='[Calculation_5946862607192367106]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='INDEX' datatype='integer' name='[Calculation_5946862607196160004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MTD CVR Growth % (Indicator)' datatype='string' hidden='true' name='[MTD Sessions Growth % (Indicator) (copy)_267190132472999942]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [Calculation_267190132453117953], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [Calculation_267190132453117953], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [Calculation_267190132453117953], 0)&#10;    ) &lt;= 0&#10;    then &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    end' />
      </column>
      <column caption='MTD CVR Growth % ' datatype='string' hidden='true' name='[MTD Sessions Growth % (copy)_267190132471709701]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [Calculation_267190132453117953], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [Calculation_267190132453117953], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [Calculation_267190132453117953], 0)&#10;    ) &lt;= 0&#10;    then &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    end&#10;    &#10;    +&#10;    str(round(&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [Calculation_267190132453117953], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [Calculation_267190132453117953], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [Calculation_267190132453117953], 0)&#10;    ) * 100&#10;    ,2)&#10;    )' />
