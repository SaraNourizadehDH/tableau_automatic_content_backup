    <worksheet name='YoY checks'>
      <table>
        <view>
          <datasources>
            <datasource caption='actuals vs YoY vs RR' name='federated.13ohnqk0cuautt13ln5q815t2u72' />
          </datasources>
          <datasource-dependencies datasource='federated.13ohnqk0cuautt13ln5q815t2u72'>
            <column caption='ORDERS' datatype='integer' name='[Calculation_139048649864601600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='GMV' datatype='integer' name='[Calculation_139048649864667137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='YoY (Orders)' datatype='real' name='[Calculation_139048649876406276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_orders])-SUM([total_orders_ly]))&#10;/&#10;(SUM([total_orders]))' />
            </column>
            <column caption='YoY (GMV)' datatype='real' name='[Calculation_139048649877643269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_gmv_eur])-SUM([total_gmv_ly]))&#10;/&#10;(SUM([total_gmv_eur]))' />
            </column>
            <column caption='Day of Week' datatype='string' name='[Calculation_4173922080167383040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[order_date])' />
            </column>
            <column caption='Orders Run Rate Country' datatype='real' name='[Calculation_478085260921401348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [order_date] = { FIXED : MAX([order_date]) } THEN [orders_rr_eom] ELSE 0 END&#10;)' />
            </column>
            <column caption='Orders Run Rate: Period LY' datatype='real' name='[GMV Run Rate: Period LY (copy)_1324058307869159444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [order_date] = { FIXED : MAX([order_date]) } THEN [orders_rr_ly] ELSE 0 END&#10;)' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_4173922080167383040]' derivation='None' name='[none:Calculation_4173922080167383040:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Orders Run Rate' datatype='real' name='[orders_rr_eom]' role='measure' type='quantitative' />
            <column caption='Orders Run Rate (LY)' datatype='real' name='[orders_rr_ly]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_139048649864601600]' derivation='Sum' name='[sum:Calculation_139048649864601600:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_139048649864667137]' derivation='Sum' name='[sum:Calculation_139048649864667137:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders_rr_eom]' derivation='Sum' name='[sum:orders_rr_eom:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders_rr_ly]' derivation='Sum' name='[sum:orders_rr_ly:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_gmv_eur]' derivation='Sum' name='[sum:total_gmv_eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_gmv_ly]' derivation='Sum' name='[sum:total_gmv_ly:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders]' derivation='Sum' name='[sum:total_orders:qk]' pivot='key' type='quantitative' />
