              <calculation class='tableau' formula='if&#10;([T7D Active Vendors (copy)_6009350027149996068] - [T7D Active Vendors (Previous L7D) (copy)_6009350027150352422])&#10;/&#10;[T7D Active Vendors (Previous L7D) (copy)_6009350027150352422] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;    ([T7D Active Vendors (copy)_6009350027149996068] - [T7D Active Vendors (Previous L7D) (copy)_6009350027150352422])&#10;    /&#10;    [T7D Active Vendors (Previous L7D) (copy)_6009350027150352422]&#10;    * 100&#10;    , 2&#10;))' />
            </column>
            <column caption='Yesterday&apos;s Vendors with Orders' datatype='integer' name='[Yesterday New Vendors (copy)_6009350027123183616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_vendor_with_orders], 0))' />
