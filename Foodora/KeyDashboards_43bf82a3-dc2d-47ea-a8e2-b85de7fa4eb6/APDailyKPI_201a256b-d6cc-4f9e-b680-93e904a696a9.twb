            <column caption='T7D Sessions Growth (Indicator)' datatype='string' name='[Calculation_130111845020094467]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Calculation_2903766264184377345] - [Calculation_2903766264184512514]) / [Calculation_2903766264184512514] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='A7D Growth' datatype='string' name='[Calculation_284219392730980362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&quot;' />
              <aliases>
                <alias key='&quot;&quot;' value='A7D Growth %' />
              </aliases>
            </column>
            <column caption='T7D Sessions' datatype='integer' name='[Calculation_2903766264184377345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([date_local]&gt; DATE(now()) - 8 AND [date_local]&lt; date(now()), [sessions], null)) // / 7' />
            </column>
            <column caption='T7D Sessions (Previous L7D)' datatype='integer' name='[Calculation_2903766264184512514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([date_local]&gt;= now() - 15 and [date_local]&lt; now() - 8, [sessions], null)) // / 7' />
            </column>
            <column caption='T7D Sessions Growth ' datatype='string' name='[Calculation_2903766264184836099]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Calculation_2903766264184377345] - [Calculation_2903766264184512514])&#10;/&#10;[Calculation_2903766264184512514] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;    ([Calculation_2903766264184377345] - [Calculation_2903766264184512514])&#10;    /&#10;    [Calculation_2903766264184512514]&#10;    * 100&#10;    , 2&#10;))' />
