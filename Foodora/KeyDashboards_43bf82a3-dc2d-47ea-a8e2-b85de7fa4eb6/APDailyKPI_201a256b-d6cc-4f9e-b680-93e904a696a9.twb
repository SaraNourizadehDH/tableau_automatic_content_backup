      <column caption='% Diff in Sum Revenue' datatype='string' hidden='true' name='[Calculation_1281977819095760900]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(&#10;    IIF(&#10;        ROUND(&#10;                (&#10;                    ([Calculation_1281977819128492037] - [Yesterday Revenue (copy)_1281977819129020423])&#10;                    / &#10;                    [Yesterday Revenue (copy)_1281977819129020423]&#10;                ) * 100&#10;            , 2) &gt;= 0,&#10;        &apos;▲&apos;,&#10;        &apos;▼&apos;&#10;    )&#10;) &#10;&#10;+&#10;&#10;STR(&#10;    ROUND(&#10;        (&#10;            ([Calculation_1281977819128492037] - [Yesterday Revenue (copy)_1281977819129020423])&#10;            / &#10;            [Yesterday Revenue (copy)_1281977819129020423]&#10;        ) * 100&#10;    , 2)&#10;) + &apos;%&apos;' />
      </column>
