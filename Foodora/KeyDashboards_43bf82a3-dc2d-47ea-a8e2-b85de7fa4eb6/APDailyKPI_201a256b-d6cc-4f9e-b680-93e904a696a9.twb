      <column caption='Orders RR Indicator' datatype='string' name='[Calculation_1324058307843149828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;  (&#10;    ([Calculation_1324058307837026304] - [Orders RR Main (MTD) (copy)_1324058307843334149])&#10;    /&#10;    IIF([Orders RR Main (MTD) (copy)_1324058307843334149] = 0, 1, [Orders RR Main (MTD) (copy)_1324058307843334149])&#10;  ) &gt; 0 &#10;THEN &apos;▲ &apos; &#10;ELSE &apos;▼ &apos;&#10;END' />
