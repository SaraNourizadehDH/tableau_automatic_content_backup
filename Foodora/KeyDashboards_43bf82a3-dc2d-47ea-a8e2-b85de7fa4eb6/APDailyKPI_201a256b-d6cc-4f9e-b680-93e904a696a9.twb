    <worksheet name='GMV LW Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
            <datasource caption='actuals vs YoY vs RR' name='federated.13ohnqk0cuautt13ln5q815t2u72' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='Yesterday&apos;s GMV Main (with PandaGo)' datatype='real' name='[Calculation_1937392283964772353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Yesterday&apos;s Orders Main (copy)_45739685114138626] + [Yesterday&apos;s GMV Main (PandaGo) (copy)_2476627963601113089]' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_6180416436319469570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WoW %' />
              </aliases>
            </column>
            <column caption='Yesterday&apos;s GMV Main (PandaGo) (copy)' datatype='real' name='[Yesterday&apos;s GMV Main (PandaGo) (copy)_2476627963601113089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;{FIXED [reference_date_local], [country_name]:&#10;MAX(IIF([is_yesterday], IFNULL([total_pandago_gmv_eur],0) , null))&#10;}&#10;)' />
            </column>
            <column caption='Yesterday&apos;s GMV Main' datatype='real' name='[Yesterday&apos;s Orders Main (copy)_45739685114138626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_gmv_eur], 0))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Yesterday' datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6180416436319469570]' derivation='None' name='[none:Calculation_6180416436319469570:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_yesterday]' derivation='None' name='[none:is_yesterday:nk]' pivot='key' type='nominal' />
