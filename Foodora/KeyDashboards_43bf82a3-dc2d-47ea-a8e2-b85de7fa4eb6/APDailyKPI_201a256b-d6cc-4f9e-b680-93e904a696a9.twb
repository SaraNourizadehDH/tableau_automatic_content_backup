    <worksheet name='Yesterday&apos;s Corporate Revenue/GMV'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>  Corporate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column aggregation='Sum' caption='Expedition Type' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' Delivery and Pickup' />
              </aliases>
            </column>
            <column caption='L7D Revenue/GMV' datatype='real' name='[L7D Revenue Main (copy)_1139199614592233480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_same_day_last_week], [Calculation_128141504822948034], null))&#10;/&#10;SUM(IIF([is_same_day_last_week], [total_gmv_eur], null))' />
            </column>
            <column caption='Revenue/GMV WoW Main (Negative) ' datatype='string' name='[Revenue WoW Main (Negative) (copy)_147422529481183241]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(([Yesterday&apos;s Revenue Main (copy)_147422529507872780] - [L7D Revenue Main (copy)_1139199614592233480]) / iif([L7D Revenue Main (copy)_1139199614592233480] = 0, 1, [L7D Revenue Main (copy)_1139199614592233480])) &#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;(([Yesterday&apos;s Revenue Main (copy)_147422529507872780] - [L7D Revenue Main (copy)_1139199614592233480]) / iif([L7D Revenue Main (copy)_1139199614592233480] = 0, 1, [L7D Revenue Main (copy)_1139199614592233480])) &#10;&lt;= 0&#10;then&#10;str(&#10;round(&#10;    (([Yesterday&apos;s Revenue Main (copy)_147422529507872780] - [L7D Revenue Main (copy)_1139199614592233480]) / iif([L7D Revenue Main (copy)_1139199614592233480] = 0, 1, [L7D Revenue Main (copy)_1139199614592233480])) &#10; * 100,1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Revenue/GMV WoW Main (Positive)' datatype='string' name='[Revenue WoW Main (Positive) (copy)_147422529480409096]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(([Yesterday&apos;s Revenue Main (copy)_147422529507872780] - [L7D Revenue Main (copy)_1139199614592233480]) / iif([L7D Revenue Main (copy)_1139199614592233480] = 0, 1, [L7D Revenue Main (copy)_1139199614592233480])) &#10;&gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;(([Yesterday&apos;s Revenue Main (copy)_147422529507872780] - [L7D Revenue Main (copy)_1139199614592233480]) / iif([L7D Revenue Main (copy)_1139199614592233480] = 0, 1, [L7D Revenue Main (copy)_1139199614592233480])) &#10;&gt; 0&#10;then&#10;str(&#10;round(&#10;    (([Yesterday&apos;s Revenue Main (copy)_147422529507872780] - [L7D Revenue Main (copy)_1139199614592233480]) / iif([L7D Revenue Main (copy)_1139199614592233480] = 0, 1, [L7D Revenue Main (copy)_1139199614592233480])) &#10;    * 100,1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Yesterday&apos;s Revenue/GMV Main' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Yesterday&apos;s Revenue Main (copy)_147422529507872780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;IF [is_yesterday] AND [expedition_type] = &apos;delivery&apos;&#10;THEN [Calculation_128141504822948034] //- [ads_revenue_eur]&#10;ELSEIF [is_yesterday] AND [expedition_type] = &apos;pickup&apos;&#10;THEN [Calculation_128141504822948034]&#10;ELSE null&#10;END)&#10;)&#10;/&#10;(SUM(IIF([is_yesterday], [total_gmv_eur], null)))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Expedition Type1' datatype='string' name='[expedition_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;delivery&quot;' value='Delivery' />
                <alias key='&quot;pickup&quot;' value='Pickup' />
              </aliases>
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
