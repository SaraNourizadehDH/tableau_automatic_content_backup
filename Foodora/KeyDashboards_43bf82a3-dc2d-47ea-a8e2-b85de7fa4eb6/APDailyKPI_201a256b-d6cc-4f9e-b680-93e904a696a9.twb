    <worksheet name='Sessions Daily'>
      <table>
        <view>
          <datasources>
            <datasource caption='frontend KPIs' name='federated.1dfy97k0y0hksj15r8lif14anfxu' />
          </datasources>
          <datasource-dependencies datasource='federated.1dfy97k0y0hksj15r8lif14anfxu'>
            <column caption='Yesterday Sessions' datatype='integer' name='[Calculation_1281977819495858229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_2yesterday], [sessions], 0))' />
            </column>
            <column caption='Sessions Indicator (Color)' datatype='integer' name='[Calculation_2575777549398773760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull(sum([sessions])) then 0&#10;elseif ((sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &lt;=-0.1&#10;then -2&#10;elseif ((sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &lt;=-0.05&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='A7D Sessions Avg' datatype='real' name='[Calculation_2719118681297281024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(sum(sessions),first(),first()+7)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Number of Records' datatype='integer' name='[Calculation_284219392700309504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='f.Exclude Today' datatype='boolean' name='[Calculation_5946862607182192640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, NOW()) &lt;= 2, [date_utc] &lt;= NOW() - 2, [date_utc] != TODAY())&#10;&#10;[date_local] != TODAY()' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date_local]' role='dimension' type='ordinal' />
