    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description/Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APDailyKPIv2/DescriptionMetricDefinitions?rev=' id='DescriptionMetricDefinitions' path='/t/Foodora/workbooks/APDailyKPIv2' revision='' site='Foodora' />
      <style />
      <size maxheight='900' maxwidth='1000' minheight='900' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98222' id='3' type-v2='text' w='98400' x='800' y='889'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='20' underline='true'>Introduction</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='11'>APAC Daily KPI dashboard contains key metrics that are used by the Senior Leadership to track the overall performance of the company.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='11'>This dashboard is being sent out to a group of management leaders every 9AM at </run>
              <run bold='true' fontcolor='#000000' fontsize='11'>pandata-daily-report </run>
              <run fontcolor='#000000' fontsize='11'>slack channel.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>More Information</run>
              <run>Æ&#10;</run>
              <run auto-url='true' bold='true' fontcolor='#ffffff' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/AD/APAC+Daily+KPI&amp;quot;'>https://confluence.deliveryhero.com/display/AD/APAC+Daily+KPI</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Metrics</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total GMV EUR</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total GMV of valid orders in EUR. GMV is defined as GFV plus delivery fees, service fees, container charges, difference to MOV and also includes priority delivery fee and add-pro-to-cart values, after basket updates, in local currency</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Revenue EUR</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total Commission Revenue EUR + Total Delivery Fee EUR</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Orders </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total number of successful orders and total pandago orders</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total AFV EUR</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total Gross Food Value EUR  / Total number of successful orders</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Revenue/GMV</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total Revenue EUR  / Total GMV</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total New Vendors</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total new vendors that are onboarded to the Foodpanda platform</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Churned Vendors</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total vendors that are marked as &quot;Terminated&quot; on salesforce where reasons are not &quot;Onboarding Failed&quot; and &quot;Duplicate&quot;. Excludes test vendors.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Active Vendors</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total active vendors. Excludes private and test vendors</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Vendors with Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Total vendors that have at least one order for the time period</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='256' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='255' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='98222' id='3' type-v2='text' w='98400' x='800' y='889'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='20' underline='true'>Introduction</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>APAC Daily KPI dashboard contains key metrics that are used by the Senior Leadership to track the overall performance of the company.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>This dashboard is being sent out to a group of management leaders every 9AM at </run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>pandata-daily-report </run>
                    <run fontcolor='#000000' fontsize='11'>slack channel.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>More Information</run>
                    <run>Æ&#10;</run>
                    <run auto-url='true' bold='true' fontcolor='#ffffff' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/AD/APAC+Daily+KPI&amp;quot;'>https://confluence.deliveryhero.com/display/AD/APAC+Daily+KPI</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Metrics</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total GMV EUR</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total GMV of valid orders in EUR. GMV is defined as GFV plus delivery fees, service fees, container charges, difference to MOV and also includes priority delivery fee and add-pro-to-cart values, after basket updates, in local currency</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total Revenue EUR</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total Commission Revenue EUR + Total Delivery Fee EUR</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total Orders </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total number of successful orders and total pandago orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total AFV EUR</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total Gross Food Value EUR  / Total number of successful orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Revenue/GMV</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total Revenue EUR  / Total GMV</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total New Vendors</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total new vendors that are onboarded to the Foodpanda platform</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total Churned Vendors</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total vendors that are marked as &quot;Terminated&quot; on salesforce where reasons are not &quot;Onboarding Failed&quot; and &quot;Duplicate&quot;. Excludes test vendors.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total Active Vendors</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total active vendors. Excludes private and test vendors</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Total Vendors with Orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>Total vendors that have at least one order for the time period</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{49689C12-B25D-4FDA-AC37-86F71E295E05}' />
    </dashboard>
