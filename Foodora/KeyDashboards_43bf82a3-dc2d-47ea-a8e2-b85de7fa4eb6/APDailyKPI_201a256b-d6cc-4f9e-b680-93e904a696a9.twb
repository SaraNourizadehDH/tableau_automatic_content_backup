    <worksheet name='Revenue/GMV T7D Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column aggregation='Sum' caption='1 T7D Growth' datatype='integer' name='[1 T7D (copy)_128141500668571653]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='T7D Growth %' />
              </aliases>
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column caption='T7D Revenue/GMV Growth %' datatype='string' name='[Calculation_147422529455190019]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;    (([T7D Comm Revenue (copy)_128141504828203210] - [Previous T7D Comm Rev (copy)_128141504828969164]) / [Previous T7D Comm Rev (copy)_128141504828969164])&#10;    /&#10;    (([T7D Orders (copy)_128141500933558278] - [Previous T7D Orders (copy)_128141500936294409]) / [Previous T7D Orders (copy)_128141500936294409])&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(ROUND(&#10;    round(([T7D Comm Revenue (copy)_128141504828203210] - [Previous T7D Comm Rev (copy)_128141504828969164]) / [Previous T7D Comm Rev (copy)_128141504828969164]*100,2)&#10;    /&#10;    round(([T7D Orders (copy)_128141500933558278] - [Previous T7D Orders (copy)_128141500936294409]) / [Previous T7D Orders (copy)_128141500936294409]*100,2)&#10;,2)&#10;)' />
            </column>
            <column caption='T7D Revenue/Gmv Growth % (Indicator)' datatype='string' name='[Calculation_147422529458208773]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;    (([T7D Comm Revenue (copy)_128141504828203210] - [Previous T7D Comm Rev (copy)_128141504828969164]) / [Previous T7D Comm Rev (copy)_128141504828969164])&#10;    /&#10;    (([T7D Orders (copy)_128141500933558278] - [Previous T7D Orders (copy)_128141500936294409]) / [Previous T7D Orders (copy)_128141500936294409] )&#10;&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Previous T7D Revenue' datatype='real' name='[Previous T7D Comm Rev (copy)_128141504828969164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 15 AND [reference_date_local] &lt; now() - 8, [Calculation_128141504822948034], 0))' />
            </column>
            <column caption='Previous T7D GMV' datatype='real' name='[Previous T7D Orders (copy)_128141500936294409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 15 AND [reference_date_local] &lt; now() - 8, [total_gmv_eur], 0))&#10;+&#10;SUM(&#10;{fixed [reference_date_local], [country_name]:&#10;MAX(IIF([reference_date_local] &gt;= now() - 15 AND [reference_date_local] &lt; now() - 8, [total_pandago_gmv_eur], 0))&#10;}&#10;)' />
            </column>
            <column caption='T7D Revenue' datatype='real' name='[T7D Comm Revenue (copy)_128141504828203210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 8, [Calculation_128141504822948034], 0))' />
            </column>
            <column caption='T7D GMV' datatype='real' name='[T7D Orders (copy)_128141500933558278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 8, [total_gmv_eur], 0))&#10;+&#10;SUM(&#10;{fixed [reference_date_local], [country_name]:&#10;MAX(IIF([reference_date_local] &gt;= now() - 8, [total_pandago_gmv_eur], 0))&#10;}&#10;)' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Expedition Type1' datatype='string' name='[expedition_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;delivery&quot;' value='Delivery' />
                <alias key='&quot;pickup&quot;' value='Pickup' />
              </aliases>
            </column>
