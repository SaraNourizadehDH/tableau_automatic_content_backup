              <calculation class='tableau' formula='if&#10;[Active Delivery Vendor WoW Main (Negative) (copy)_6009350027132428299] = &apos;▲ &apos; &#10;then [Vendors with Orders Delivery WoW Main (Value Only) (copy)_6009350027135303697]&#10;ELSE null&#10;end' />
