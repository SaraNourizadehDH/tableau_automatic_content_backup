        <calculation class='tableau' formula='if&#10;([Calculation_746893858218340388] - [Calculation_746893858224807983]) / [Calculation_746893858224807983] &lt;= 0&#10;or isnull(([Calculation_746893858218340388] - [Calculation_746893858224807983]) / [Calculation_746893858224807983])&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_746893858218340388] - [Calculation_746893858224807983]) / [Calculation_746893858224807983] &lt;= 0&#10;or isnull(([Calculation_746893858218340388] - [Calculation_746893858224807983]) / [Calculation_746893858224807983])&#10;then&#10;str(&#10;round(&#10;    ([Calculation_746893858218340388] - [Calculation_746893858224807983]) / [Calculation_746893858224807983] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
