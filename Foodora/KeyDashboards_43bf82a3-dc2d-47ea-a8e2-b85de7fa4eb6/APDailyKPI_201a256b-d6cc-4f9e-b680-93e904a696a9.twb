            <column aggregation='Sum' caption='1 T7D (Revenue)' datatype='integer' name='[1 T7D (Comm Revenue) (copy)_128141504828399819]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='T7D Revenue' />
              </aliases>
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column caption='T7D Revenue/GMV' datatype='real' name='[Calculation_147422529447297024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[T7D Comm Revenue (copy)_128141504828203210]&#10;/&#10;[T7D Orders (copy)_128141500933558278]' />
