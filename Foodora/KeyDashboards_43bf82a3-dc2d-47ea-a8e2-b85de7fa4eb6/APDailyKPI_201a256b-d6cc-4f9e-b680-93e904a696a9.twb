              <calculation class='tableau' formula='IF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &gt;= 0.02 THEN 2&#10;ELSEIF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &lt;= -0.02 THEN -2&#10;ELSEIF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &gt;= 0.01 THEN 1&#10;ELSEIF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &lt; 0 THEN -1&#10;ELSE 0&#10;END'>
