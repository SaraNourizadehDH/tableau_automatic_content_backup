    <worksheet name='GFV Daily (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
            <datasource caption='actuals vs YoY vs RR' name='federated.13ohnqk0cuautt13ln5q815t2u72' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='Yesterday&apos;s GMV Main (with PandaGo)' datatype='real' name='[Calculation_1937392283964772353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Yesterday&apos;s Orders Main (copy)_45739685114138626] + [Yesterday&apos;s GMV Main (PandaGo) (copy)_2476627963601113089]' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Yesterday&apos;s GMV Main (PandaGo) (copy)' datatype='real' name='[Yesterday&apos;s GMV Main (PandaGo) (copy)_2476627963601113089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;{FIXED [reference_date_local], [country_name]:&#10;MAX(IIF([is_yesterday], IFNULL([total_pandago_gmv_eur],0) , null))&#10;}&#10;)' />
            </column>
            <column caption='Yesterday&apos;s GMV Main' datatype='real' name='[Yesterday&apos;s Orders Main (copy)_45739685114138626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_gmv_eur], 0))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Expedition Type1' datatype='string' name='[expedition_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;delivery&quot;' value='Delivery' />
                <alias key='&quot;pickup&quot;' value='Pickup' />
              </aliases>
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Yesterday' datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[expedition_type]' derivation='None' name='[none:expedition_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[reference_date_local]' derivation='None' name='[none:reference_date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[reference_date_local]' derivation='ISO-Weekday-Trunc' name='[tiwd:reference_date_local:ok]' pivot='key' type='ordinal' />
            <column caption='Total Gmv Eur' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Total Pandago Gmv Eur' datatype='real' name='[total_pandago_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1937392283964772353]' derivation='User' name='[usr:Calculation_1937392283964772353:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13ohnqk0cuautt13ln5q815t2u72'>
            <column caption='GMV (Indicator - New)' datatype='integer' name='[Orders (Indicator - New) (copy)_203576808404168708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull(sum([total_gmv_eur])) then 0&#10;elseif ((sum([total_gmv_eur]) - SUM([total_gmv_l7D]))/abs(SUM([total_gmv_l7D])) &gt;= 0.1)&#10;then 2&#10;elseif (sum([total_gmv_eur]) - SUM([total_gmv_l7D]))/abs(SUM([total_gmv_l7D])) &lt;=-0.1&#10;then -2&#10;elseif ((sum([total_gmv_eur]) - SUM([total_gmv_l7D]))/abs(SUM([total_gmv_l7D])) &gt;= 0.05)&#10;then 1&#10;elseif (sum([total_gmv_eur]) - SUM([total_gmv_l7D]))/abs(SUM([total_gmv_l7D])) &lt;=-0.05&#10;then -1&#10;else 0&#10;end' />
            </column>
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column-instance column='[total_gmv_eur]' derivation='Sum' name='[sum:total_gmv_eur:qk]' pivot='key' type='quantitative' />
            <column caption='Actuals: Total GMV' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_gmv_l7D]' role='measure' type='quantitative' />
            <column-instance column='[Orders (Indicator - New) (copy)_203576808404168708]' derivation='User' name='[usr:Orders (Indicator - New) (copy)_203576808404168708:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0esr49h041to0d1eolrdb0zzwgcd].[none:country_name:nk]' direction='DESC' using='[federated.0esr49h041to0d1eolrdb0zzwgcd].[usr:Calculation_1937392283964772353:qk]' />
          <filter class='categorical' column='[federated.0esr49h041to0d1eolrdb0zzwgcd].[none:expedition_type:nk]'>
