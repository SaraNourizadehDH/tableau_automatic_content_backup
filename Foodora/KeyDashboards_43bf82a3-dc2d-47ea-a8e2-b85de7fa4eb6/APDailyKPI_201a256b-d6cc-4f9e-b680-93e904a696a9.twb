      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendors BQ (pandata)' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' />
          </datasources>
          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column caption='Vendors with Orders Pickup L7D Main' datatype='integer' name='[Active Pickup Vendors L7D Main (copy)_6009350027131793414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_last_week_same_day], [total_pickup_vendor_with_orders], null))' />
            </column>
            <column caption='Vendors with Orders Pickup WoW Main (Indicator)' datatype='string' name='[Vendors with Orders Delivery WoW Main (Indicator) (copy)_6009350027134898192]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Vendors with Orders Delivery WoW Main (Value Only) (copy)_6009350027134595087] &lt;= 0&#10;or isnull([Vendors with Orders Delivery WoW Main (Value Only) (copy)_6009350027134595087])&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Vendors with Orders Pickup WoW Main (Negative)' datatype='string' name='[Vendors with Orders Delivery WoW Main (Negative) (copy)_6009350027137847318]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Vendors with Orders Delivery WoW Main (Indicator) (copy)_6009350027134898192] = &apos;▼ &apos; &#10;then [Vendors with Orders Delivery WoW Main (copy)_6009350027136413714]&#10;ELSE null&#10;end' />
            </column>
            <column caption='Vendors with Orders Pickup WoW Main (Positive)' datatype='string' name='[Vendors with Orders Delivery WoW Main (Positive) (copy)_6009350027137847317]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Vendors with Orders Delivery WoW Main (Indicator) (copy)_6009350027134898192] = &apos;▲ &apos; &#10;then [Vendors with Orders Delivery WoW Main (copy)_6009350027136413714] &#10;ELSE null&#10;end' />
            </column>
            <column caption='Vendors with Orders Pickup WoW Main (Value Only)' datatype='real' name='[Vendors with Orders Delivery WoW Main (Value Only) (copy)_6009350027134595087]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='([Yesterday&apos;s Active Pickup Vendors Main (copy 2)_6009350027127115779] - [Active Pickup Vendors L7D Main (copy)_6009350027131793414]) / [Active Pickup Vendors L7D Main (copy)_6009350027131793414] * 100' />
            </column>
            <column caption='Vendors with Orders Pickup WoW Main ' datatype='string' name='[Vendors with Orders Delivery WoW Main (copy)_6009350027136413714]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Vendors with Orders Delivery WoW Main (Indicator) (copy)_6009350027134898192] + STR(ROUND([Vendors with Orders Delivery WoW Main (Value Only) (copy)_6009350027134595087], 2)) + &apos;%&apos;' />
            </column>
            <column caption='Yesterday&apos;s Vendors with Orders Pickup Main' datatype='integer' name='[Yesterday&apos;s Active Pickup Vendors Main (copy 2)_6009350027127115779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_pickup_vendor_with_orders], null))' />
            </column>
            <column datatype='boolean' name='[is_last_week_same_day]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
