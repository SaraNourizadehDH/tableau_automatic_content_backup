    <worksheet name='Sessions MTD Growth %'>
      <table>
        <view>
          <datasources>
            <datasource caption='frontend KPIs' name='federated.1dfy97k0y0hksj15r8lif14anfxu' />
          </datasources>
          <datasource-dependencies datasource='federated.1dfy97k0y0hksj15r8lif14anfxu'>
            <column caption='Yesterday Sessions' datatype='integer' name='[Calculation_1281977819495858229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_2yesterday], [sessions], 0))' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_284219392721838084]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_2903766264200196100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today()) = 1&#10;AND&#10;DAY([date_local]) &lt; DAY(TODAY())' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_2903766264200929285]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today()) = 0&#10;AND&#10;DAY([date_local]) &lt; DAY(TODAY())' />
            </column>
            <column caption='MTD Sessions Growth %' datatype='string' name='[Calculation_2903766264201121798]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [sessions], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [sessions], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [sessions], 0)&#10;    ) &lt;= 0&#10;    then &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    end&#10;    &#10;    +&#10;    str(round(&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [sessions], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [sessions], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [sessions], 0)&#10;    ) * 100&#10;    ,2)&#10;    )' />
            </column>
            <column caption='MTD Sessions Growth % (Indicator)' datatype='string' name='[Calculation_2903766264201953287]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;    (&#10;        AVG(&#10;            iif([Calculation_2903766264200929285], [sessions], 0)&#10;        )&#10;        -&#10;        AVG(&#10;            iif([Calculation_2903766264200196100], [sessions], 0)&#10;        )&#10;    )&#10;    &#10;    /&#10;    &#10;    AVG(&#10;        iif([Calculation_2903766264200196100], [sessions], 0)&#10;    ) &lt;= 0&#10;    then &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    end' />
            </column>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_2yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_284219392721838084]' derivation='None' name='[none:Calculation_284219392721838084:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
