            <column caption='Vendors with Orders Pickup WoW Main (Value Only)' datatype='real' name='[Vendors with Orders Delivery WoW Main (Value Only) (copy)_6009350027134595087]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='([Yesterday&apos;s Active Pickup Vendors Main (copy 2)_6009350027127115779] - [Active Pickup Vendors L7D Main (copy)_6009350027131793414]) / [Active Pickup Vendors L7D Main (copy)_6009350027131793414] * 100' />
            </column>
            <column caption='Vendors with Orders Pickup WoW Main ' datatype='string' name='[Vendors with Orders Delivery WoW Main (copy)_6009350027136413714]' role='measure' type='nominal'>
