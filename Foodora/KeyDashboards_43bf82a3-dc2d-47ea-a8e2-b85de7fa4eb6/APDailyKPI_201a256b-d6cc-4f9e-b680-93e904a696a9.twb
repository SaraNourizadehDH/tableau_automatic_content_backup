    <worksheet name='MTD AFV Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='AFV MTD vs PMTD (Indicator)' datatype='string' name='[AFV MTD vs PMTD (copy)_128141503797129334]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [AFV Per Day By Country (copy)_128141503736733810]&#10;    -&#10;    [AFV Per Day By Country (MTD) (copy)_128141503736893555]&#10;)&#10;&#10;/&#10;&#10;[AFV Per Day By Country (MTD) (copy)_128141503736893555] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='AFV Per Day By Country (PMTD)' datatype='real' name='[AFV Per Day By Country (MTD) (copy)_128141503736893555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([Previous L30D (copy)_128141502928400489],[total_gfv_eur],0))&#10;/ &#10;sum(iif([Previous L30D (copy)_128141502928400489],[total_number_of_successful_orders],0))' />
            </column>
            <column caption='AFV Per Day By Country (MTD)' datatype='real' name='[AFV Per Day By Country (copy)_128141503736733810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([PMTD (copy)_128141502928715882],[total_gfv_eur],0))&#10;/ &#10;sum(iif([PMTD (copy)_128141502928715882],[total_number_of_successful_orders],0))' />
            </column>
            <column caption='AFV MTD vs PMTD' datatype='string' name='[GMV MTD vs PMTD (copy)_128141503796084852]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [AFV Per Day By Country (copy)_128141503736733810]&#10;    -&#10;    [AFV Per Day By Country (MTD) (copy)_128141503736893555]&#10;)&#10;&#10;/&#10;&#10;[AFV Per Day By Country (MTD) (copy)_128141503736893555] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    [AFV Per Day By Country (copy)_128141503736733810]&#10;    -&#10;    [AFV Per Day By Country (MTD) (copy)_128141503736893555]&#10;)&#10;&#10;/&#10;&#10;[AFV Per Day By Country (MTD) (copy)_128141503736893555] * 100&#10;,2)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 0&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 1&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Yesterday AFV Eur' datatype='real' name='[Yesterday Revenue (copy)_1281977819176394764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], ROUND([total_gmv_eur], 2), 0)) / &#10;SUM(IIF([is_yesterday], [total_number_of_successful_orders], 0))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Yesterday' datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[1 T7D Growth (copy)_128141502953201774]' derivation='None' name='[none:1 T7D Growth (copy)_128141502953201774:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Total Gfv Eur' datatype='real' name='[total_gfv_eur]' role='measure' type='quantitative' />
            <column caption='Total Gmv Eur' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Total Number Of Successful Orders' datatype='integer' name='[total_number_of_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[AFV MTD vs PMTD (copy)_128141503797129334]' derivation='User' name='[usr:AFV MTD vs PMTD (copy)_128141503797129334:nk]' pivot='key' type='nominal' />
            <column-instance column='[GMV MTD vs PMTD (copy)_128141503796084852]' derivation='User' name='[usr:GMV MTD vs PMTD (copy)_128141503796084852:nk]' pivot='key' type='nominal' />
            <column-instance column='[Yesterday Revenue (copy)_1281977819176394764]' derivation='User' name='[usr:Yesterday Revenue (copy)_1281977819176394764:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0esr49h041to0d1eolrdb0zzwgcd].[none:country_name:nk]' direction='DESC' using='[federated.0esr49h041to0d1eolrdb0zzwgcd].[usr:Yesterday Revenue (copy)_1281977819176394764:qk]' />
