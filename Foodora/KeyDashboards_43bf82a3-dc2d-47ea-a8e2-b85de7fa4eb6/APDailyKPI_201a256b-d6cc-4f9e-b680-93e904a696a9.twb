      <column caption='Actuals vs YoY: GMV MTD' datatype='real' name='[Actuals vs RR: GMV MTD (copy)_139048649883996173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total GMV (copy)_139048649867104259]) - SUM([YoY: Total GMV (copy)_139048649883561996]))&#10;/&#10;SUM([Total GMV (copy)_139048649867104259])' />
      </column>
      <column caption='Actuals vs RR: GMV MTD' datatype='real' name='[Actuals vs RR: Orders MTD (copy)_139048649881829385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(RUNNING_SUM(SUM([Total GMV (copy)_139048649867104259])) - SUM([gmv_rr_td]))&#10;/&#10;RUNNING_SUM(SUM([Total GMV (copy)_139048649867104259]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Actuals vs YoY: Orders MTD' datatype='real' name='[Actuals vs RR: Orders MTD (copy)_139048649883058187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(RUNNING_SUM(SUM([Total Orders (copy)_139048649866588162])) - RUNNING_SUM(SUM([YoY: Total Orders (copy)_139048649882656778])))&#10;/&#10;RUNNING_SUM(SUM([Total Orders (copy)_139048649866588162]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Actuals vs RR (GMV)' datatype='real' name='[Actuals vs YoY (GMV) (copy)_139048649880084487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_gmv_eur])-SUM([gmv_rr_for_the_day]))&#10;/&#10;(SUM([total_gmv_eur]))' />
      </column>
      <column caption='Actuals vs RR (Orders)' datatype='real' name='[Actuals vs YoY (Orders) (copy)_139048649879842822]' role='measure' type='quantitative'>
