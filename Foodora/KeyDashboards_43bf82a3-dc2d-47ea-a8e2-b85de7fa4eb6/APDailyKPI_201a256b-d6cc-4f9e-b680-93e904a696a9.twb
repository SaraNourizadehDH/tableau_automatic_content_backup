            <column caption='AFV Eur' datatype='real' name='[Calculation_5401364105257897994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_gfv_eur]) / sum([total_number_of_successful_orders])' />
            </column>
            <column caption='AFV (Indicator - New)' datatype='integer' name='[GMV (Indicator - New) (copy)_392235447114584101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull([Calculation_5401364105257897994]) then 0&#10;elseif (([Calculation_5401364105257897994] - [GMV L7D Average (copy)_392235447114592294])/abs([GMV L7D Average (copy)_392235447114592294]) &gt;= 0.1)&#10;then 2&#10;elseif ([Calculation_5401364105257897994] - [GMV L7D Average (copy)_392235447114592294])/abs([GMV L7D Average (copy)_392235447114592294]) &lt;= -0.1 &#10;then -2&#10;elseif (([Calculation_5401364105257897994] - [GMV L7D Average (copy)_392235447114592294])/abs([GMV L7D Average (copy)_392235447114592294]) &gt;= 0.05)&#10;then 1&#10;elseif ([Calculation_5401364105257897994] - [GMV L7D Average (copy)_392235447114592294])/abs([GMV L7D Average (copy)_392235447114592294]) &lt;= -0.05&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AFV L7D Average' datatype='real' name='[GMV L7D Average (copy)_392235447114592294]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_5401364105257897994],first(),first()+7)'>
