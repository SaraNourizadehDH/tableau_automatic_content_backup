        <calculation class='tableau' formula='SUM(IIF([date] &gt;= NOW()-8, [total_vendors], 0))' />
      </column>
      <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_6433251340711219206]' role='dimension' type='ordinal'>
