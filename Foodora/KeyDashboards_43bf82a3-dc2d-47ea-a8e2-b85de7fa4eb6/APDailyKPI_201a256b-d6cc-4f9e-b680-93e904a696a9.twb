    <worksheet name='L7D Order Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
            <datasource caption='actuals vs YoY vs RR' name='federated.13ohnqk0cuautt13ln5q815t2u72' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='DayOfWeek' datatype='string' name='[Calculation_2636153901957091335]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [reference_date_local])' />
            </column>
            <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_6149806036921335808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [reference_date_local] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [reference_date_local])&#10;ELSE [reference_date_local]&#10;END' />
            </column>
            <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Current MTD (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [reference_date_local] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [reference_date_local] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [reference_date_local] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
