            <column caption='T7D Revenue' datatype='real' name='[T7D Comm Revenue (copy)_128141504828203210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 8, [Calculation_128141504822948034], 0))' />
            </column>
            <column caption='T7D GMV' datatype='real' name='[T7D Orders (copy)_128141500933558278]' role='measure' type='quantitative'>
