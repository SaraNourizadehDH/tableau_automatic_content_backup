    <worksheet name='Vendor with Orders Daily'>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendors BQ (pandata)' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' />
          </datasources>
          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column caption='Active Vendors (Indicator New)' datatype='integer' name='[Calculation_480125942551883776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &gt;= 0.02 THEN 2&#10;ELSEIF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &lt;= -0.02 THEN -2&#10;ELSEIF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &gt;= 0.01 THEN 1&#10;ELSEIF (ZN(SUM([total_vendor_with_orders])) - LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) / ABS(LOOKUP(ZN(SUM([total_vendor_with_orders])), 1)) &lt; 0 THEN -1&#10;ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Yesterday&apos;s Vendors with Orders' datatype='integer' name='[Yesterday New Vendors (copy)_6009350027123183616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_vendor_with_orders], 0))' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_today]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
