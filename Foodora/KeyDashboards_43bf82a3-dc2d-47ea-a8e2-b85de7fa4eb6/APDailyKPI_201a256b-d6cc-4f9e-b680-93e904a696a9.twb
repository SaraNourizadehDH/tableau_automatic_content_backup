              <calculation class='tableau' formula='IF &#10;(&#10;sum(iif([is_yesterday],[Calculation_128141504822948034],0)) / sum(iif([is_yesterday],[total_gmv_eur],0))&#10;- sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0))&#10;)&#10;/ sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(&#10;round(sum(iif([is_yesterday],[Calculation_128141504822948034],0)),4) / round(sum(iif([is_yesterday],[total_gmv_eur],0)),4)&#10;- sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0))&#10;)&#10;/ round(sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0)),4)&#10;* 100, 2))' />
