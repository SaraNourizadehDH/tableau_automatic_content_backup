        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.07eefaw0w8jbfd1glklp31xmp1mg' name='Custom SQL Query' type='text'>SELECT
  order_date,
  SUM(orders) AS orders_rr,
  SUM(gmv_eur) AS gmv_eur_rr,

FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.runrates`

WHERE management_entity_group = &quot;Foodpanda APAC&quot;
  AND order_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 12 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)

GROUP BY ALL
ORDER BY 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
