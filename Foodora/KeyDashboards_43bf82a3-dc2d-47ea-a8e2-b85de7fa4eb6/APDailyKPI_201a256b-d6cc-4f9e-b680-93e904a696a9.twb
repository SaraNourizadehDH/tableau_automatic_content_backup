      <column caption='YoY Terminated Vendor Growth' datatype='string' hidden='true' name='[YoY Active Vendor Growth (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [MoM Data Availability Check (copy)]&#10;&#10;THEN&#10;&#10;iif(isnull((SUM(IIF([is_yesterday], [total_terminated_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0))), &apos;0.0&apos;,&#10;&#10;IF&#10;(SUM(IIF([is_yesterday], [total_terminated_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; +&#10;&#10;STR(ROUND(&#10;((SUM(IIF([is_yesterday], [total_terminated_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0))) * 100&#10;,2)&#10;)&#10;&#10;)&#10;&#10;ELSE &apos;-&apos; END' />
      </column>
      <column caption='YoY Terminated Vendor Growth (Indicator)' datatype='string' hidden='true' name='[YoY Terminated Vendor Growth (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;(SUM(IIF([is_yesterday], [total_terminated_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_terminated_vendors], 0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='YoY Active Vendor Growth (Indicator)' datatype='string' hidden='true' name='[YoY Vendor Growth (Indicator) (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;(SUM(IIF([is_yesterday], [total_active_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_active_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_active_vendors], 0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='YoY Active Vendor Growth' datatype='string' hidden='true' name='[YoY Vendor Growth (copy 2)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [MoM Data Availability Check (copy)]&#10;&#10;THEN&#10;&#10;IF&#10;(SUM(IIF([is_yesterday], [total_active_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_active_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_active_vendors], 0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; +&#10;&#10;STR(ROUND(&#10;((SUM(IIF([is_yesterday], [total_active_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_active_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_active_vendors], 0))) * 100&#10;,2)&#10;)&#10;&#10;ELSE &apos;-&apos; END' />
      </column>
      <column caption='YoY Vendor Growth (Indicator)' datatype='string' hidden='true' name='[YoY Vendor Growth (copy)]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;(SUM(IIF([is_yesterday], [total_vendors], 0)) - SUM(IIF([is_last_year_same_day], [total_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_year_same_day], [total_vendors], 0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
