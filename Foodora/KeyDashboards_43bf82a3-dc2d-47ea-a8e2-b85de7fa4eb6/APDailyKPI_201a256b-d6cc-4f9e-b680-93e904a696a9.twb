      </column>
      <column caption='MTD GMV (with PandaGo)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_4516125317079691271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV MoM Main (Negative) TEST (copy)_4516125317056180228] + [MTD GMV Main (copy)_4516125317079588870]' />
      </column>
      <column caption='total_gmv_eur_indicator_ranking' datatype='real' hidden='true' name='[Calculation_4610560173721505792]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='// This is used to sort the country_name of the country_name column in the blended data.&#10;// By default, values are sorted in asc order. (-) are added so that sorting is done descendingly.&#10;&#10;-SUM([total_gmv_eur (copy)])' />
      </column>
      <column caption='Is Today' datatype='boolean' hidden='true' name='[Calculation_5284200113965608960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([reference_date_local] = date(NOW()), TRUE, FALSE)' />
      </column>
      <column caption='AFV Eur' datatype='real' name='[Calculation_5401364105257897994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_gfv_eur]) / sum([total_number_of_successful_orders])' />
      </column>
      <column caption='2 days before' datatype='boolean' hidden='true' name='[Calculation_5401364115944001580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_date_local] &lt;= now() - 2' />
      </column>
      <column caption='NULL' datatype='string' hidden='true' name='[Calculation_6109836637894942736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='% of total Orders' datatype='real' name='[Calculation_6109836638281674769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6649142689517953024]&#10;/&#10;( &#10;sum(&#10;{fixed: sum(iif([is_yesterday], [total_number_of_successful_orders], 0))}&#10;)&#10;+&#10;sum(&#10;{fixed [reference_date_local], [country_name]:&#10;max(iif([is_yesterday], [total_delivery_count], 0))&#10;}&#10;)&#10;)' />
      </column>
      <column caption='test total orders' datatype='integer' hidden='true' name='[Calculation_6109836638282981394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({fixed: sum(iif([is_yesterday], [total_number_of_successful_orders], 0))})' />
      </column>
      <column caption='Yesterday&apos;s Orders + Pandago Main' datatype='integer' name='[Calculation_6109836638287081491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_6649142689517953024],0) + IFNULL([Yesterday&apos;s Orders Main (copy)_94012672460591142],0)' />
      </column>
      <column caption='Orders WoW Main (Positive)' datatype='string' name='[Calculation_6109836638295011353]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Calculation_6649142689517953024] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='% of Total Orders Str' datatype='string' name='[Calculation_6109836638400880667]' role='measure' type='nominal'>
        <calculation class='tableau' formula='iif(isnull([Calculation_6109836638281674769]), null, &#10;str(round([Calculation_6109836638281674769]*100,2)) + &quot;% of Total&quot;&#10;)' />
      </column>
      <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_6149806036921335808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [reference_date_local] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [reference_date_local])&#10;ELSE [reference_date_local]&#10;END' />
      </column>
      <column caption='hour now' datatype='integer' hidden='true' name='[Calculation_6149806037898752003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, now())' />
      </column>
      <column caption='Revenue Run-rate (per day)' datatype='real' name='[Calculation_617274630512168960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD GMV Main (copy)_2421247803274092548] / [Calculation_3878443760153657405])' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_6180416436319469570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='WoW %' />
        </aliases>
      </column>
      <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[is_same_day_last_week]' />
      </column>
      <column caption='W1 GFV %' datatype='string' hidden='true' name='[Calculation_6180416436345286660]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [total_gfv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END))&#10;/ SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;//IF SUM(IF [Yesterday] THEN [total_gfv_eur] ELSE 0 END) - SUM(IF [L1W] THEN [total_gfv_eur] ELSE 0 END) &gt;= 0&#10;//THEN &#10;   (SUM(IF [is_yesterday] THEN [total_gfv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END))&#10;   / SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END)&#10;//ELSE&#10;//    SUM(IF [L1W] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_gfv_eur] ELSE 0 END)&#10;//END &#10;* 100, 2))' />
      </column>
      <column caption='Total GFV Eur Per Day' datatype='real' hidden='true' name='[Calculation_6180416436372983814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [reference_date_local]:&#10;SUM([total_gfv_eur])&#10;}' />
      </column>
      <column caption='Max GFV In L7D' datatype='real' hidden='true' name='[Calculation_6180416436375367687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Calculation_6180416436372983814])' />
      </column>
      <column caption='total_number_of_successful_orders_indicator_ranking' datatype='integer' hidden='true' name='[Calculation_6522690062563975169]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='-SUM([total_number_of_successful_orders (copy)])' />
      </column>
      <column caption='total_commission_revenue_eur_indicator_ranking' datatype='real' hidden='true' name='[Calculation_6522690062565040130]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='// needed to sort the indicator countries descendingly&#10;&#10;-SUM([total_gmv_eur (ranking) (copy)_746893856030023698])' />
      </column>
      <column caption='AFV_Eur_indicator_ranking' datatype='real' hidden='true' name='[Calculation_6522690062565769219]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='// needed to sort the indicator countries descendingly&#10;&#10;-[W1 AFV % (copy 2)_5401364105265557520]' />
      </column>
      <column caption='vendor subsidies indicator ranking' datatype='real' hidden='true' name='[Calculation_6522690062573162506]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='// needed to sort the indicator countries descendingly&#10;&#10;-([total vendor subsidies (copy 2)])' />
      </column>
      <column caption='Orders MTD vs PMTD' datatype='string' name='[Calculation_652459033143308296]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([PMTD (copy)_128141502928715882],[total_number_of_successful_orders],null))},0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;        - sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_number_of_successful_orders],null))},0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_number_of_successful_orders],null))},0)) &#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([PMTD (copy)_128141502928715882],[total_number_of_successful_orders],null))},0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;        - sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_number_of_successful_orders],null))},0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_number_of_successful_orders],null))},0)) &#10;)&#10;* 100&#10;,2)&#10;)' />
      </column>
      <column caption='Orders MTD vs PMTD (Indicator)' datatype='string' name='[Calculation_652459033143566345]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([PMTD (copy)_128141502928715882],[total_number_of_successful_orders],null))},0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;        - sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_number_of_successful_orders],null))},0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_number_of_successful_orders],null))},0)) &#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Yesterday&apos;s Orders Main' datatype='integer' name='[Calculation_6649142689517953024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_yesterday], ifnull([total_number_of_successful_orders], 0), 0))' />
      </column>
      <column caption='Vendor Subsidies %' datatype='real' hidden='true' name='[Calculation_841399085322592256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total dh subsidies (copy)]) / SUM([total_gmv_eur])' />
      </column>
      <column caption='TT Orders Yesterday' datatype='integer' name='[Calculation_841399086758039563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_yesterday] THEN [Calculation_3363766717671026688] ELSE 0 END)' />
      </column>
      <column caption='Orders Value (With Pandago)' datatype='integer' name='[Calculation_861313449187639297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ifnull([total_number_of_successful_orders],0)) + sum(ifnull([Total PandaGo Orders (copy)_2476627963599482880],0))' />
      </column>
      <column caption='W1 Revenue/GMV %' datatype='string' datatype-customized='true' name='[Calculation_881931480923811840]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;(&#10;sum(iif([is_yesterday],[Calculation_128141504822948034],0)) / sum(iif([is_yesterday],[total_gmv_eur],0))&#10;- sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0))&#10;)&#10;/ sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(&#10;round(sum(iif([is_yesterday],[Calculation_128141504822948034],0)),4) / round(sum(iif([is_yesterday],[total_gmv_eur],0)),4)&#10;- sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0))&#10;)&#10;/ round(sum(iif([Calculation_6180416436320313347],[Calculation_128141504822948034],0)) / sum(iif([Calculation_6180416436320313347],[total_gmv_eur],0)),4)&#10;* 100, 2))' />
      </column>
      <column caption='W1 Revenue/GMV % (indicator)' datatype='string' datatype-customized='true' name='[Calculation_881931480924233729]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [Calculation_128141504822948034] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_gmv_eur] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_128141504822948034] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [Calculation_128141504822948034] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_gmv_eur] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Kitchens GMV' datatype='real' hidden='true' name='[Calculation_94012665307082756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_yesterday] and ([vendor_type] = &apos;kitchen&apos; or [vendor_type] = &apos;kitchen&amp;concepts&apos;)&#10;then [total_gmv_eur]&#10;else 0 end' />
      </column>
      <column caption='Total PandaGo Orders' datatype='integer' name='[Calculation_94012672413073445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#10;  {FIXED [reference_date_local], [global_entity_id]:&#10;  MAX([total_delivery_count])&#10;},0)' />
      </column>
      <column caption='Revenue (Indicator)' datatype='integer' name='[Comm Rev (Indicator - New) (copy)_128141504825254085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull(sum([Calculation_128141504822948034])) then 0&#10;elseif ((sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &lt;= -0.1 &#10;then -2&#10;elseif ((sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &lt;= -0.05&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue (ranking)' datatype='real' hidden='true' name='[Comm Rev (ranking) (copy)_128141504826286279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([reference_date_local] &gt;= NOW() - 8, [Calculation_128141504822948034], 0)' />
      </column>
      <column caption='Revenue L7D Average' datatype='real' name='[Comm Rev L7D Average (copy)_128141504825458886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Calculation_345017965404803077]),last()-7, last())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Comm Rev MTD vs PMTD (Indicator)' datatype='string' hidden='true' name='[Comm Rev MTD vs PMTD (copy)_128141504551370945]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([PMTD (copy)_128141502928715882], [total_commission_revenue_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Previous L30D (copy)_128141502928400489], [total_commission_revenue_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Previous L30D (copy)_128141502928400489], [total_commission_revenue_eur], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Revenue MTD vs PMTD' datatype='string' name='[Comm Rev MTD vs PMTD (copy)_128141504829669583]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Revenue MTD vs PMTD (copy)_128141504853610704]&#10;&#10;+ &#10;&#10;STR([Revenue MTD vs PMTD (copy)_6097522066086932485])' />
      </column>
      <column caption='W1 Revenue WoW Main (Negative)' datatype='string' name='[Comm Rev WoW Main (Negative) (copy)_128141504857403604]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Revenue WoW Main (Negative) (copy)_6097522066083115009] = &apos;▼ &apos; THEN [Revenue WoW Main (Value Only) (copy)_6097522066083336194] + &apos;%&apos;&#10;ELSE null&#10;end' />
      </column>
      <column caption='W1 Revenue WoW Main (Positive)' datatype='string' name='[Comm Rev WoW Main (Positive) (copy)_128141504855920849]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Revenue WoW Main (Negative) (copy)_6097522066083115009] = &apos;▲ &apos; THEN [Revenue WoW Main (Value Only) (copy)_6097522066083336194] + &apos;%&apos;&#10;ELSE null&#10;end' />
      </column>
      <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Current MTD (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [reference_date_local] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [reference_date_local] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [reference_date_local] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
      </column>
      <column caption='Previous L30D' datatype='boolean' hidden='true' name='[Current MTD (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_date_local] &gt;= DATEADD(&apos;day&apos;, -61, NOW())&#10;AND&#10;[reference_date_local] &lt;= DATEADD(&apos;day&apos;, -31, NOW())&#10;//DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1,NOW())))&#10;//AND&#10;//[date] &lt;= DATEADD(&apos;month&apos;, -1, DATE(DATEADD(&apos;day&apos;, -1, NOW())))' />
      </column>
      <column caption='Vendor Subsidies (Indicator - New)' datatype='integer' hidden='true' name='[DH Subsidies (Indicator - New) (copy)_392235447411269682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull([Calculation_841399085322592256]) then 0&#10;elseif ([Calculation_841399085322592256]) &gt;= 0.1&#10;then 2&#10;elseif ([Calculation_841399085322592256] - [DH Subsidies L7D Average (copy)_392235447411576883])/abs([DH Subsidies L7D Average (copy)_392235447411576883]) &lt;=-0.2 OR [Calculation_841399085322592256] &lt;= 0.02&#10;then -2&#10;elseif (([Calculation_841399085322592256] - [DH Subsidies L7D Average (copy)_392235447411576883])/abs([DH Subsidies L7D Average (copy)_392235447411576883]) &gt;= 0.1)&#10;then 1&#10;elseif ([Calculation_841399085322592256] - [DH Subsidies L7D Average (copy)_392235447411576883])/abs([DH Subsidies L7D Average (copy)_392235447411576883]) &lt;=-0.1&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vendor Subsidies L7D Average' datatype='real' hidden='true' name='[DH Subsidies L7D Average (copy)_392235447411576883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_841399085322592256],first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
