            <column-instance column='[Yesterday&apos;s Revenue Main (copy)_147422529507872780]' derivation='User' name='[usr:Yesterday&apos;s Revenue Main (copy)_147422529507872780:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
