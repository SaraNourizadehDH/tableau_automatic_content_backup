    <worksheet name='GMV MTD %'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Yesterday&apos;s GMV Main (with PandaGo)' datatype='real' name='[Calculation_1937392283964772353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Yesterday&apos;s Orders Main (copy)_45739685114138626] + [Yesterday&apos;s GMV Main (PandaGo) (copy)_2476627963601113089]' />
            </column>
            <column caption='GMV MTD vs PMTD (Indicator)' datatype='string' name='[GMV MTD vs PMTD (copy)_128141502956556400]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([PMTD (copy)_128141502928715882],[total_pandago_gmv_eur],null))},0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;        - sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_pandago_gmv_eur],null))},0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_pandago_gmv_eur],null))},0)) &#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='GMV MTD vs PMTD' datatype='string' name='[Orders MTD vs PMTD (copy)_128141502956388463]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([PMTD (copy)_128141502928715882],[total_pandago_gmv_eur],null))},0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;        - sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_pandago_gmv_eur],null))},0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_pandago_gmv_eur],null))},0)) &#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([PMTD (copy)_128141502928715882],[total_pandago_gmv_eur],null))},0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;        - sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_pandago_gmv_eur],null))},0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_gmv_eur], 0))&#10;        + sum(ifnull({fixed [reference_date_local], [country_name]: max(iif([Previous L30D (copy)_128141502928400489],[total_pandago_gmv_eur],null))},0)) &#10;)&#10;* 100&#10;,2)&#10;)' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 0&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 1&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Yesterday&apos;s GMV Main (PandaGo) (copy)' datatype='real' name='[Yesterday&apos;s GMV Main (PandaGo) (copy)_2476627963601113089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;{FIXED [reference_date_local], [country_name]:&#10;MAX(IIF([is_yesterday], IFNULL([total_pandago_gmv_eur],0) , null))&#10;}&#10;)' />
            </column>
            <column caption='Yesterday&apos;s GMV Main' datatype='real' name='[Yesterday&apos;s Orders Main (copy)_45739685114138626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_gmv_eur], 0))' />
