          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column aggregation='Sum' caption='1 A7D Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502031929435]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='A7D Growth %' />
              </aliases>
            </column>
            <column caption='AFV Per Day By Country' datatype='real' name='[AFV Per Day (copy)_128141501170745359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([reference_date_local]&gt;=now()-8,[total_gfv_eur],0))&#10;/&#10;sum(iif([reference_date_local]&gt;=now()-8,[total_number_of_successful_orders],0))' />
            </column>
            <column caption='AFV Per Day By Country (Previous 7 Day)' datatype='real' name='[AFV Per Day By Country (copy)_128141501189500944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([reference_date_local]&lt;now()-8 and [reference_date_local]&gt;=now()-15,[total_gfv_eur],0))&#10;/&#10;sum(iif([reference_date_local]&lt;now()-8 and [reference_date_local]&gt;=now()-15,[total_number_of_successful_orders],0))' />
            </column>
            <column caption='T7D AFV Growth' datatype='string' name='[Calculation_128141501190492177]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([AFV Per Day (copy)_128141501170745359] - [AFV Per Day By Country (copy)_128141501189500944])&#10;/&#10;[AFV Per Day By Country (copy)_128141501189500944] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;    ([AFV Per Day (copy)_128141501170745359] - [AFV Per Day By Country (copy)_128141501189500944])&#10;    /&#10;    [AFV Per Day By Country (copy)_128141501189500944]&#10;    * 100&#10;    , 2&#10;))&#10;+ &apos;%&apos;' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='T7D AFV Growth (Indicator)' datatype='string' name='[T7D AFV Growth (copy)_128141501191102482]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([AFV Per Day (copy)_128141501170745359] - [AFV Per Day By Country (copy)_128141501189500944])&#10;/&#10;[AFV Per Day By Country (copy)_128141501189500944] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
