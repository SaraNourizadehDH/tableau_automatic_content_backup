          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>  Kitchen &amp; Concepts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='% of total revenue' datatype='real' name='[% of total Comm Rev (copy)_128141504857682133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Yesterday&apos;s Comms Rev Main (copy)_128141504856039634]&#10;/ &#10;sum({fixed: sum(iif([is_yesterday], [Calculation_128141504822948034], 0))})' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column aggregation='Sum' caption='Expedition Type' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' Delivery and Pickup' />
              </aliases>
            </column>
            <column caption='W1 Revenue WoW Main (Negative)' datatype='string' name='[Comm Rev WoW Main (Negative) (copy)_128141504857403604]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Revenue WoW Main (Negative) (copy)_6097522066083115009] = &apos;▼ &apos; THEN [Revenue WoW Main (Value Only) (copy)_6097522066083336194] + &apos;%&apos;&#10;ELSE null&#10;end' />
            </column>
            <column caption='W1 Revenue WoW Main (Positive)' datatype='string' name='[Comm Rev WoW Main (Positive) (copy)_128141504855920849]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Revenue WoW Main (Negative) (copy)_6097522066083115009] = &apos;▲ &apos; THEN [Revenue WoW Main (Value Only) (copy)_6097522066083336194] + &apos;%&apos;&#10;ELSE null&#10;end' />
            </column>
            <column caption='L7D Revenue Main' datatype='real' name='[L7D Comm Rev Main (copy)_128141504856514771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_same_day_last_week], [Calculation_128141504822948034], null))' />
            </column>
            <column caption='W1 Revenue WoW Main (Value Only)' datatype='real' name='[Revenue WoW Main (Negative) (copy)_6097522066082992128]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round(&#10;    ([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / [L7D Comm Rev Main (copy)_128141504856514771] * 100,&#10; 2)' />
            </column>
            <column caption='W1 Revenue WoW Main (Indicator)' datatype='string' name='[Revenue WoW Main (Negative) (copy)_6097522066083115009]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Revenue WoW Main (Negative) (copy)_6097522066082992128] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='W1 Revenue WoW Main' datatype='string' name='[Revenue WoW Main (Value Only) (copy)_6097522066083336194]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Revenue WoW Main (Negative) (copy)_6097522066083115009] &#10;&#10;+ &#10;&#10;STR([Revenue WoW Main (Negative) (copy)_6097522066082992128])' />
            </column>
            <column caption='Yesterday&apos;s Revenue Main' datatype='real' name='[Yesterday&apos;s Comms Rev Main (copy)_128141504856039634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [Calculation_128141504822948034], 0))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Expedition Type1' datatype='string' name='[expedition_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;delivery&quot;' value='Delivery' />
                <alias key='&quot;pickup&quot;' value='Pickup' />
