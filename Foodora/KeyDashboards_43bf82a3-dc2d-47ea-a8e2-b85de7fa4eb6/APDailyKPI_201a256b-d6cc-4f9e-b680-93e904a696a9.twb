          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column caption='Day Similar L7D' datatype='datetime' name='[Calculation_6433251340892000268]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [date])&#10;ELSE [date]&#10;END' />
            </column>
            <column caption='L7D vs Previous L7D' datatype='string' name='[Calculation_6433251340892442638]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
