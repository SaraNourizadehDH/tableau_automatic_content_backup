            <column caption='YoY: Total Orders' datatype='integer' name='[total_orders_ly]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_139048649876406276]' derivation='User' name='[usr:Calculation_139048649876406276:qk]' pivot='key' type='quantitative' />
