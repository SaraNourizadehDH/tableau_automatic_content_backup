            <column-instance column='[reference_date_local]' derivation='None' name='[none:reference_date_local:qk]' pivot='key' type='quantitative' />
            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6149806036921335808]' derivation='Day-Trunc' name='[tdy:Calculation_6149806036921335808:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13ohnqk0cuautt13ln5q815t2u72'>
