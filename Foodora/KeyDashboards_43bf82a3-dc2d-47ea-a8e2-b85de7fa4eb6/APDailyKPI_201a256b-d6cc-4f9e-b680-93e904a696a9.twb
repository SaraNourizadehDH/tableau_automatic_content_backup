            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column caption='Revenue MTD vs PMTD' datatype='string' name='[Comm Rev MTD vs PMTD (copy)_128141504829669583]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Revenue MTD vs PMTD (copy)_128141504853610704]&#10;&#10;+ &#10;&#10;STR([Revenue MTD vs PMTD (copy)_6097522066086932485])' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 0&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 1&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Revenue MTD vs PMTD (Indicator)' datatype='string' name='[Revenue MTD vs PMTD (copy)_128141504853610704]' role='measure' type='nominal'>
