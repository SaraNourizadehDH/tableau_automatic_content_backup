      </column>
      <column caption='T7D Sessions Growth (Indicator)' datatype='string' name='[Calculation_130111845020094467]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_2903766264184377345] - [Calculation_2903766264184512514]) / [Calculation_2903766264184512514] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='W1 Session % Ranking' datatype='real' name='[Calculation_130111845120487428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [is_yesterday] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [sessions] ELSE 0 END)' />
      </column>
      <column caption='Sessions Indicator (Color)' datatype='integer' name='[Calculation_2575777549398773760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull(sum([sessions])) then 0&#10;elseif ((sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &lt;=-0.1&#10;then -2&#10;elseif ((sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([sessions]) - [Calculation_2719118681297281024])/abs([Calculation_2719118681297281024]) &lt;=-0.05&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SUM_CVR' datatype='real' hidden='true' name='[Calculation_267190132451495936]' role='measure' type='quantitative'>
