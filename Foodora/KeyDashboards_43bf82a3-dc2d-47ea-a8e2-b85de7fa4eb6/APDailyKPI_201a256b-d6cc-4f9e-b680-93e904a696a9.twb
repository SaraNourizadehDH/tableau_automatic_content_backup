            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
            </column>
            <column caption='DayOfWeek' datatype='string' name='[Calculation_2636153901957091335]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [reference_date_local])' />
            </column>
            <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_6149806036921335808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [reference_date_local] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [reference_date_local])&#10;ELSE [reference_date_local]&#10;END' />
            </column>
            <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Current MTD (copy 2)]' role='dimension' type='nominal'>
