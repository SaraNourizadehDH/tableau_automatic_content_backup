      </column>
      <column caption='Forecast ' datatype='real' hidden='true' name='[Calculation_1089660058067070976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;  [day] &gt;= TODAY() - 1 AND ([Calculation_2493516504955674626] &gt; 0 OR [country_name] = &apos;Japan&apos;)&#10;  THEN [forecast_orders] &#10;  ELSE NULL &#10;END' />
      </column>
      <column caption='One' datatype='integer' name='[Calculation_1127588798567391234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='T7D Orders' datatype='integer' name='[Calculation_128141500660142081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([reference_date_local] &gt;= now() - 8, [total_number_of_successful_orders], 0))&#10;+&#10;IFNULL(&#10;    SUM( &#10;        {FIXED [reference_date_local], [country_name]:&#10;          MAX(IIF([reference_date_local] &gt;= now() - 8, [total_delivery_count], 0))&#10;         }&#10;        )&#10;,0)' />
      </column>
      <column caption='T7D Growth %' datatype='string' name='[Calculation_128141500664979459]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_128141500660142081] - [T7D Orders (copy)_128141500664102914]) / [T7D Orders (copy)_128141500664102914] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([Calculation_128141500660142081] - [T7D Orders (copy)_128141500664102914]) / [T7D Orders (copy)_128141500664102914]*100,2)&#10;)' />
      </column>
      <column caption='T7D AFV Growth' datatype='string' name='[Calculation_128141501190492177]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([AFV Per Day (copy)_128141501170745359] - [AFV Per Day By Country (copy)_128141501189500944])&#10;/&#10;[AFV Per Day By Country (copy)_128141501189500944] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;    ([AFV Per Day (copy)_128141501170745359] - [AFV Per Day By Country (copy)_128141501189500944])&#10;    /&#10;    [AFV Per Day By Country (copy)_128141501189500944]&#10;    * 100&#10;    , 2&#10;))&#10;+ &apos;%&apos;' />
      </column>
      <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [reference_date_local], [region], [country_name], [vendor_type], [expedition_type], [is_group_order], [is_corporate]:&#10;&#10;    SUM(&#10;        ifnull(iif([region]=&apos;Asia&apos;,[total_commission_revenue_eur], NULL),0)&#10;&#10;        + IFNULL([total_delivery_fee_eur],0)&#10;    ) &#10;&#10;}' />
      </column>
      <column caption='Last T7D Revenue Number' datatype='real' hidden='true' name='[Calculation_1281977819087036419]' role='measure' type='quantitative'>
