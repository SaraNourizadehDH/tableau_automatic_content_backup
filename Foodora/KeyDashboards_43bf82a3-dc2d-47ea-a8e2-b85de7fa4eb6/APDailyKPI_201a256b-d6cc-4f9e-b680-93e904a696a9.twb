            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Total Number Of Successful Orders' datatype='integer' name='[total_number_of_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_652459033143308296]' derivation='User' name='[usr:Calculation_652459033143308296:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_652459033143566345]' derivation='User' name='[usr:Calculation_652459033143566345:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6649142689517953024]' derivation='User' name='[usr:Calculation_6649142689517953024:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
