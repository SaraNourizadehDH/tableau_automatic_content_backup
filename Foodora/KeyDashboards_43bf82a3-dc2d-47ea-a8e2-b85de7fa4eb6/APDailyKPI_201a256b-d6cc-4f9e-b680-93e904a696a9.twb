    <worksheet name='Vendor with Orders MTD Growth '>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendors BQ (pandata)' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' />
          </datasources>
          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141504435327157]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Vendors with Orders MTD vs PMTD (Indicator) ' datatype='string' name='[Active Vendors MTD vs PMTD (Indicator) (copy)_6009350027149328418]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Vendors with Orders MTD vs PMTD (Indicator)  (copy)_3607383317940563968] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_128141504433950898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_128141504434032819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Vendors with Orders MTD vs PMTD (Value Only)' datatype='real' name='[Vendors with Orders MTD vs PMTD (Indicator)  (copy)_3607383317940563968]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;AVG(&#10;    iif([Calculation_128141504433950898], [total_vendor_with_orders], 0)&#10;)&#10;-&#10;AVG(&#10;    iif([Calculation_128141504434032819], [total_vendor_with_orders], 0)&#10;)&#10;)&#10;&#10;/&#10;&#10;AVG(&#10;iif([Calculation_128141504434032819], [total_vendor_with_orders], 0)&#10;)&#10;&#10;* 100' />
            </column>
            <column caption='Vendors with Orders MTD vs PMTD' datatype='string' name='[Vendors with Orders MTD vs PMTD (Indicator)  (copy)_3607383317940977668]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Active Vendors MTD vs PMTD (Indicator) (copy)_6009350027149328418]&#10;&#10;+&#10;&#10;STR(ROUND([Vendors with Orders MTD vs PMTD (Indicator)  (copy)_3607383317940563968], 2))' />
            </column>
            <column caption='Yesterday&apos;s Vendors with Orders' datatype='integer' name='[Yesterday New Vendors (copy)_6009350027123183616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_vendor_with_orders], 0))' />
            </column>
