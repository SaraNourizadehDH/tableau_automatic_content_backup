            <column-instance column='[Calculation_2903766264201121798]' derivation='User' name='[usr:Calculation_2903766264201121798:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2903766264201953287]' derivation='User' name='[usr:Calculation_2903766264201953287:nk]' pivot='key' type='nominal' />
