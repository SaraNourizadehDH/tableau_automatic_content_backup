    <worksheet name='MTD checks'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily kpis (pandata)' name='federated.0esr49h041to0d1eolrdb0zzwgcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd'>
            <column caption='Total Number of Successful Orders' datatype='integer' name='[Calculation_3363766717911343105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([total_number_of_successful_orders],0)' />
            </column>
            <column caption='MTD GMV (with PandaGo)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_4516125317079691271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV MoM Main (Negative) TEST (copy)_4516125317056180228] + [MTD GMV Main (copy)_4516125317079588870]' />
            </column>
            <column caption='Total PandaGo Orders' datatype='integer' name='[Calculation_94012672413073445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;  {FIXED [reference_date_local], [global_entity_id]:&#10;  MAX([total_delivery_count])&#10;},0)' />
            </column>
            <column caption='MTD GMV Main' datatype='real' name='[GMV MoM Main (Negative) TEST (copy)_4516125317056180228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))' />
            </column>
            <column caption='MTD Orders Main (Pandago) (copy)' datatype='integer' name='[MTD GMV Main (Pandago) (copy)_1584352290547380227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull({fixed [reference_date_local], [country_name]: MAX(iif([PMTD (copy)_128141502928715882],[Total PandaGo Orders (copy)_2476627963599482880],null))},0))' />
            </column>
            <column caption='MTD Orders Main (copy)' datatype='integer' name='[MTD GMV Main (copy)_1584352290546978818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_128141502928715882], [Calculation_3363766717911343105], 0))' />
            </column>
            <column caption='MTD Orders Main' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[MTD GMV Main (copy)_2421247803289403409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0)) + &#10;SUM(iif([PMTD (copy)_128141502928715882], [Total PandaGo Orders (copy)_2476627963599482880], 0))' />
            </column>
            <column caption='MTD GMV Main (Pandago)' datatype='real' name='[MTD GMV Main (copy)_4516125317079588870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull({fixed [reference_date_local], [country_name]: MAX(iif([PMTD (copy)_128141502928715882],[total_pandago_gmv_eur],null))},0))' />
            </column>
            <column caption='MTD Orders Main (copy 2)' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[MTD Orders Main (copy 2)_1584352290547814404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[MTD GMV Main (copy)_1584352290546978818] + [MTD GMV Main (Pandago) (copy)_1584352290547380227]' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], today() - 1) = 0&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Total PandaGo Orders (copy)' datatype='integer' name='[Total PandaGo Orders (copy)_2476627963599482880]' role='measure' type='quantitative'>
