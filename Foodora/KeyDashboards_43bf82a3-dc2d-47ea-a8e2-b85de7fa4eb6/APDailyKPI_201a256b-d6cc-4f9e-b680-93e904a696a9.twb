    <worksheet name='Total Active Vendors MTD Growth.'>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendors BQ (pandata)' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' />
          </datasources>
          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141504435327157]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Active Vendors MTD vs PMTD (Indicator)' datatype='string' name='[Active Vendors MTD vs PMTD (copy)_128141504438485177]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    AVG(&#10;        iif([Calculation_128141504433950898], [total_active_vendors], 0)&#10;    )&#10;    -&#10;    AVG(&#10;        iif([Calculation_128141504434032819], [total_active_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;AVG(&#10;    iif([Calculation_128141504434032819], [total_active_vendors], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_128141504433950898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_128141504434032819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Active Vendors MTD vs PMTD' datatype='string' name='[New Vendors MTD vs PMTD (copy)_128141504438251704]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    AVG(&#10;        iif([Calculation_128141504433950898], [total_active_vendors], 0)&#10;    )&#10;    -&#10;    AVG(&#10;        iif([Calculation_128141504434032819], [total_active_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;AVG(&#10;    iif([Calculation_128141504434032819], [total_active_vendors], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    AVG(&#10;        iif([Calculation_128141504433950898], [total_active_vendors], 0)&#10;    )&#10;    -&#10;    AVG(&#10;        iif([Calculation_128141504434032819], [total_active_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;AVG(&#10;    iif([Calculation_128141504434032819], [total_active_vendors], 0)&#10;) * 100&#10;,2)&#10;)' />
            </column>
            <column caption='Yesterday&apos;s Active Delivery Vendors Main' datatype='integer' name='[Yesterday&apos;s New Delivery Vendors Main (copy)_746893858244399163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_active_deliver_vendors], null))' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[1 T7D Growth (copy)_128141504435327157]' derivation='None' name='[none:1 T7D Growth (copy)_128141504435327157:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='integer' name='[total_active_deliver_vendors]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_active_vendors]' role='measure' type='quantitative' />
            <column-instance column='[Active Vendors MTD vs PMTD (copy)_128141504438485177]' derivation='User' name='[usr:Active Vendors MTD vs PMTD (copy)_128141504438485177:nk]' pivot='key' type='nominal' />
            <column-instance column='[New Vendors MTD vs PMTD (copy)_128141504438251704]' derivation='User' name='[usr:New Vendors MTD vs PMTD (copy)_128141504438251704:nk]' pivot='key' type='nominal' />
            <column-instance column='[Yesterday&apos;s New Delivery Vendors Main (copy)_746893858244399163]' derivation='User' name='[usr:Yesterday&apos;s New Delivery Vendors Main (copy)_746893858244399163:qk]' pivot='key' type='quantitative' />
