  DATE_TRUNC(order_date, MONTH) AS order_month,
  SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS rr_orders_eom,
  SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS rr_gmv_eom

FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates`

WHERE management_entity_group = "Foodpanda APAC"
  AND insert_date = CURRENT_DATE("Asia/Manila") - 1
  AND order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH) AND LAST_DAY(CURRENT_DATE())

GROUP BY ALL

