            </column>
            <column caption='Revenue MTD vs PMTD (Value Only)' datatype='real' name='[Revenue MTD vs PMTD (copy)_6097522066086932485]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round(&#10;(&#10;    SUM(&#10;        iif([PMTD (copy)_128141502928715882], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Previous L30D (copy)_128141502928400489], [Calculation_128141504822948034], 0)&#10;) * 100&#10;, 2)' />
            </column>
            <column caption='Yesterday&apos;s Revenue Main' datatype='real' name='[Yesterday&apos;s Comms Rev Main (copy)_128141504856039634]' role='measure' type='quantitative'>
