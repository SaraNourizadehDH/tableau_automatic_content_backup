            <column caption='LW Active Vendor Growth (Value Only)' datatype='real' name='[LW Active Vendor Growth (Indicator) (copy)_861313449394417699]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='((SUM(IIF([is_yesterday], [total_active_vendors], 0)) - SUM(IIF([is_last_week_same_day], [total_active_vendors], 0)))&#10;/&#10;SUM(IIF([is_last_week_same_day], [total_active_vendors], 0))) * 100' />
