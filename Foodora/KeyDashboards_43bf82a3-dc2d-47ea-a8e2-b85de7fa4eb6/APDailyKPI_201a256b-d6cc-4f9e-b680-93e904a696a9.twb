            <column caption='W1 GMV % (Indicator)' datatype='string' name='[W1 GFV % (Indicator) (copy 3)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Calculation_1937392283964772353] - [Yesterday&apos;s GMV Main (with PandaGo) (copy)_5098919246258327554])&#10;/ [Yesterday&apos;s GMV Main (with PandaGo) (copy)_5098919246258327554] &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
