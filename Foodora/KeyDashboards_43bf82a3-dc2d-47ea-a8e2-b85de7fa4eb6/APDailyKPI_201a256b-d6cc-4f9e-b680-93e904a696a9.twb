            </column>
            <column caption='LW Active Vendor Growth' datatype='string' name='[LW Vendor Growth (copy 4)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[LW Vendor Growth (Indicator) (copy 2)] &#10;&#10;+ &#10;&#10;STR(ROUND([LW Active Vendor Growth (Indicator) (copy)_861313449394417699],2))' />
            </column>
