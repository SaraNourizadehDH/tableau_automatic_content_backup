            <column caption='Vendors with Orders Delivery WoW Main (Indicator)' datatype='string' name='[Active Delivery Vendor WoW Main (Negative) (copy)_6009350027132428299]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Vendors with Orders Delivery WoW Main (Negative) (copy)_6009350027134070798] &lt;= 0&#10;or isnull([Vendors with Orders Delivery WoW Main (Negative) (copy)_6009350027134070798])&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
