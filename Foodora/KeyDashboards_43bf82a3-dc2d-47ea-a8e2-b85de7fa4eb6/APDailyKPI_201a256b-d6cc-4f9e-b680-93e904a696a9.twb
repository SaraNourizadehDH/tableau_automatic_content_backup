    <worksheet name='Active Vendors Daily'>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendors BQ (pandata)' name='federated.00zpoct0lmjn101cg8k8h17j4oqw' />
          </datasources>
          <datasource-dependencies datasource='federated.00zpoct0lmjn101cg8k8h17j4oqw'>
            <column caption='New Vendors (Indicator - New)' datatype='integer' name='[Calculation_392235447750910008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull(sum([total_vendors])) then 0&#10;elseif (sum([total_vendors]) - [Calculation_392235447751127098])/abs([Calculation_392235447751127098]) &gt;=0.3&#10;then 2&#10;elseif (sum([total_vendors]) - [Calculation_392235447751127098])/abs([Calculation_392235447751127098]) &lt;=-0.3 &#10;then -2&#10;elseif ((sum([total_vendors]) - [Calculation_392235447751127098])/abs([Calculation_392235447751127098]) &gt;= 0.2)&#10;then 1&#10;elseif (sum([total_vendors]) - [Calculation_392235447751127098])/abs([Calculation_392235447751127098]) &lt;=-0.2&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='New Vendors L7D Average' datatype='real' name='[Calculation_392235447751127098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(sum([total_vendors]),first(),first()+7)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Yesterday&apos;s New Delivery Vendors Main' datatype='integer' name='[Calculation_746893858218340388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday], [total_deliver_vendors], null))' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Yesterday&apos;s New Vendors Main' datatype='integer' name='[Yesterday&apos;s New Delivery Vendors Main (copy)_861313449379577874]' role='measure' type='quantitative'>
