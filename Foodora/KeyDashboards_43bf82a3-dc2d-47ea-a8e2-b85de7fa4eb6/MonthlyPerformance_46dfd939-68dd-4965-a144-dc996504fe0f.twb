Number Of Failed Orders Parameter]=&quot;Acquisitions&quot; THEN SUM([main_total_new_customer_count]) / LOOKUP(SUM([main_total_new_customer_count]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Active Customers %&quot; THEN SUM([Calculation_222083767578501157]) / LOOKUP(SUM([Calculation_222083767578501157]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Frequency&quot; THEN SUM([Successful Orders (copy)_222083767586455608]) / LOOKUP(SUM([Successful Orders (copy)_222083767586455608]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Active Customers Dmart %&quot; THEN SUM([Active Customers % (copy)_222083767588790329]) / LOOKUP(SUM([Active Customers % (copy)_222083767588790329]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Sessions&quot; THEN SUM([sessions]) / LOOKUP(SUM([sessions]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Sessions New Visit&quot; THEN SUM([sessions_new_visit]) / LOOKUP(SUM([sessions_new_visit]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Basket Incentives&quot; THEN SUM([Calculation_222083767595728991]) / LOOKUP(SUM([Calculation_222083767595728991]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Reactivated from Churn&quot; THEN SUM([reactivated_from_churn]) / LOOKUP(SUM([reactivated_from_churn]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Reactivated from Inactive&quot; THEN SUM([reactivated_from_inactive]) / LOOKUP(SUM([reactivated_from_inactive]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;AVG DT&quot; THEN SUM([Calculation_1832894725125865472]) / LOOKUP(SUM([Calculation_1832894725125865472]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;AVG Promised DT&quot; THEN SUM([Calculation_1832894725126336513]) / LOOKUP(SUM([Calculation_1832894725126336513]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Orders Late &gt; 10&quot; THEN SUM([Calculation_285837881995104256]) / LOOKUP(SUM([Calculation_285837881995104256]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;DT &gt; 45&quot; THEN SUM([Orders Late &gt; 10 (copy) (copy)_2823545904034140164]) / LOOKUP(SUM([Orders Late &gt; 10 (copy) (copy)_2823545904034140164]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Seamless Orders&quot; THEN SUM([Calculation_2823545904032305154]) / LOOKUP(SUM([Calculation_2823545904032305154]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Weighted Shrinkage Time&quot; THEN SUM([weighted_shrinkage_time]) / LOOKUP(SUM([weighted_shrinkage_time]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Weighted Closure Time&quot; THEN SUM([weighted_closure_time]) / LOOKUP(SUM([weighted_closure_time]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Active Riders&quot; THEN SUM([active_riders_weekly]) / LOOKUP(SUM([active_riders_weekly]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;OD Fail Rate&quot; THEN SUM([od_fail_rate]) / LOOKUP(SUM([od_fail_rate]), -1) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;MP Fail Rate&quot; THEN SUM([mp_fail_rate]) / LOOKUP(SUM([mp_fail_rate]), -1) - 1&#10;END'>
