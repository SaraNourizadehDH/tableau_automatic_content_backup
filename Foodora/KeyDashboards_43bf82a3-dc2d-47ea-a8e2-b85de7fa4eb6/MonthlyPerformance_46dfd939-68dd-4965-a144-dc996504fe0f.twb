              <calculation class='tableau' formula='(AVG([Calculation_5277374344708214845]) / AVG([Calculation_6447606564337008655]))-1' />
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
