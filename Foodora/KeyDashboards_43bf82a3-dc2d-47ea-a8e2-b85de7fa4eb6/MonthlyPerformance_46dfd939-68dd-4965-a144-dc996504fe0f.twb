    <worksheet name='Table (YoY) - AM (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='CPC YoY' datatype='real' default-format='p0.00%' name='[CPC WoW (copy)_3365244483630661636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ABS(LOOKUP(ZN(SUM([cpp_cpc])), -1)) - LOOKUP(ZN(SUM([cpp_cpc])), -13)) / ABS(LOOKUP(ZN(SUM([cpp_cpc])), -13))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='&quot;Complete month YoY&quot;' datatype='string' name='[Calculation_6213419435659616261]' role='dimension' type='nominal' user:unnamed='Table (YoY) - AM (2)'>
              <calculation class='tableau' formula='&quot;Complete month YoY&quot;' />
            </column>
            <column caption='Orders w VF Discount %' datatype='real' default-format='p0.00%' name='[Calculation_6243748316232310822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_with_vfd_dash_definition] / ([total_number_of_successful_orders]-[count_successful_orders_dmart])' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='Joker Revenue YoY' datatype='real' default-format='p0.00%' name='[Joker Revenue WoW (copy)_3365244483814105094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(LOOKUP(ZN(SUM([joker_revenue])), -1) - LOOKUP(ZN(SUM([joker_revenue])), -13)) / ABS(LOOKUP(ZN(SUM([joker_revenue])), -13))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='&lt;= Reporting Month' datatype='boolean' name='[Month Filter (copy)_5277374343931424775]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month]&lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='NCR (EUR) - YoY' datatype='real' default-format='p0.00%' name='[NCR (EUR) - WoW (copy)_2782239425329491970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(LOOKUP(ZN(SUM([ncr_eur])), -1) - LOOKUP(ZN(SUM([ncr_eur])), -13)) / ABS(LOOKUP(ZN(SUM([ncr_eur])), -13))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders w VF Discount % - YoY' datatype='real' default-format='p0.00%' name='[Orders w VF Discount % - WoW (copy)_2782239425329025025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_6243748316232310822])) - LOOKUP(ZN(AVG([Calculation_6243748316232310822])), -12))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Vendor w VF discount YoY' datatype='real' default-format='p0.00%' name='[Vendor w VF discount WoW (copy)_3365244483816026119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([vendor_vf_discount])) - LOOKUP(ZN(AVG([vendor_vf_discount])), -12)) / ABS(LOOKUP(ZN(AVG([vendor_vf_discount])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - Dmart' datatype='integer' name='[count_successful_orders_dmart]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
