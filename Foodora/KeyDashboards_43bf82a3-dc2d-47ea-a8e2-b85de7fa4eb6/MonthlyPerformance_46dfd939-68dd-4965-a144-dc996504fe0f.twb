            <column caption='Frequency MTD growth % ' datatype='real' name='[Acquisition MTD growth % (copy)_317996380372430852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Frequency Monthly (copy)_317996380755726367], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Frequency Monthly (copy)_317996380755726367], 0)))-1' />
            </column>
            <column caption='Session MTD growth %' datatype='real' name='[Acquisition MTD growth % (copy)_317996380373798918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [sessions], 0))/&#10;SUM(iif([Calculation_21673596521619459], [sessions], 0)))-1' />
            </column>
            <column caption='Basket Incentive MTD growth %' datatype='real' name='[Acquisition MTD growth % (copy)_317996380390072328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Calculation_222083767595728991], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Calculation_222083767595728991], 0)))-1' />
            </column>
            <column caption='Active Customers Dmart %' datatype='real' default-format='p0.00%' name='[Active Customers % (copy)_222083767588790329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[weekly_total_dmart_active_customer_count] / [weekly_total_active_customer_count]' />
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Active Customer MTD growth %' datatype='real' name='[Calculation_2019301519332708353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(iif([Calculation_21673596520853506], [monthly_total_active_customer_count], 0))/&#10;AVG(iif([Calculation_21673596521619459], [monthly_total_active_customer_count], 0))-1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,today())&#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;  //  AND day([order_day]) &lt;= day(today())-1&#10;//OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Active Customers %' datatype='real' default-format='p0.00%' name='[Calculation_222083767578501157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[monthly_total_active_customer_count] / [all_customer_count]' />
            </column>
            <column caption='Basket Incentives' datatype='real' name='[Calculation_222083767595728991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_voucher_value_eur] + [total_discount_value_eur]' />
            </column>
            <column caption='Active Customers DMart MTD growth % ' datatype='real' name='[Frequency MTD growth %  (copy)_317996380373422085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG(iif([Calculation_21673596520853506], [Active Customers % (copy)_222083767588790329], 0)) -&#10;AVG(iif([Calculation_21673596521619459], [Active Customers % (copy)_222083767588790329], 0)))' />
            </column>
            <column caption='Frequency Daily' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Frequency Monthly (copy)_317996380755726367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_number_of_successful_orders] / [daily_total_active_customer_count]' />
            </column>
            <column caption='Acquisition MTD growth %' datatype='real' name='[GMV MTD growth % (copy)_317996380369608704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [main_total_new_customer_count], 0))/&#10;SUM(iif([Calculation_21673596521619459], [main_total_new_customer_count], 0)))-1' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='MTD  Growth Title' datatype='string' name='[MTD Title (copy)_21673596542980104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,TODAY()),3) + &quot; MTD Growth %&quot;' />
