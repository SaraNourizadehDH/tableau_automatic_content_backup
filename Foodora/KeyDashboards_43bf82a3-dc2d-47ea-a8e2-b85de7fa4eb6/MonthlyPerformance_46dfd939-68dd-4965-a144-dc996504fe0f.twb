          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='Online Restraunts - YoY' datatype='real' default-format='p0.00%' name='[Calculation29 (copy)_2570359136596463627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([online_restaurants_monthly])) - LOOKUP(ZN(AVG([online_restaurants_monthly])), -12)) / ABS(LOOKUP(ZN(AVG([online_restaurants_monthly])), -12))'>
