      <column caption='_Measure YoY' datatype='real' hidden='true' name='[_Measure WoW (copy)_164873985253478402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;GMV&quot; THEN  SUM([total_gmv_eur]) / LOOKUP(SUM([total_gmv_eur]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Revenue&quot; THEN  SUM([Calculation_5277374344612036660]) / LOOKUP(SUM([Calculation_5277374344612036660]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;AFV&quot; THEN  SUM([Calculation_5277374344598286378]) / LOOKUP(SUM([Calculation_5277374344598286378]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;AVG DF&quot; THEN  SUM([Calculation_5277374344708214845]) / LOOKUP(SUM([Calculation_5277374344708214845]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Successful Orders&quot; THEN SUM([total_number_of_successful_orders]) / LOOKUP(SUM([total_number_of_successful_orders]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Active Customers&quot; THEN SUM([weekly_total_active_customer_count]) / LOOKUP(SUM([weekly_total_active_customer_count]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Successful Orders - Dmart&quot; THEN SUM([count_successful_orders_dmart]) / LOOKUP(SUM([count_successful_orders_dmart]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Successful Orders - LS&quot; THEN SUM([count_successful_orders_local_shops]) / LOOKUP(SUM([count_successful_orders_local_shops]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Successful Orders - OD%&quot; THEN SUM([Calculation_5277374344003272728]) / LOOKUP(SUM([Calculation_5277374344003272728]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Successful Orders - Pickup%&quot; THEN SUM([Calculation_5277374344004399137]) / LOOKUP(SUM([Calculation_5277374344004399137]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Acquisitions&quot; THEN SUM([main_total_new_customer_count]) / LOOKUP(SUM([main_total_new_customer_count]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Active Customers %&quot; THEN SUM([Calculation_222083767578501157]) / LOOKUP(SUM([Calculation_222083767578501157]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Frequency&quot; THEN SUM([Successful Orders (copy)_222083767586455608]) / LOOKUP(SUM([Successful Orders (copy)_222083767586455608]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Active Customers Dmart %&quot; THEN SUM([Active Customers % (copy)_222083767588790329]) / LOOKUP(SUM([Active Customers % (copy)_222083767588790329]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Sessions&quot; THEN SUM([sessions]) / LOOKUP(SUM([sessions]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Sessions New Visit&quot; THEN SUM([sessions_new_visit]) / LOOKUP(SUM([sessions_new_visit]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Basket Incentives&quot; THEN SUM([Calculation_222083767595728991]) / LOOKUP(SUM([Calculation_222083767595728991]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Reactivated from Churn&quot; THEN SUM([reactivated_from_churn]) / LOOKUP(SUM([reactivated_from_churn]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Reactivated from Inactive&quot; THEN SUM([reactivated_from_inactive]) / LOOKUP(SUM([reactivated_from_inactive]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;AVG DT&quot; THEN SUM([Calculation_1832894725125865472]) / LOOKUP(SUM([Calculation_1832894725125865472]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;AVG Promised DT&quot; THEN SUM([Calculation_1832894725126336513]) / LOOKUP(SUM([Calculation_1832894725126336513]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Orders Late &gt; 10&quot; THEN SUM([Calculation_285837881995104256]) / LOOKUP(SUM([Calculation_285837881995104256]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;DT &gt; 45&quot; THEN SUM([Orders Late &gt; 10 (copy) (copy)_2823545904034140164]) / LOOKUP(SUM([Orders Late &gt; 10 (copy) (copy)_2823545904034140164]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Seamless Orders&quot; THEN SUM([Calculation_2823545904032305154]) / LOOKUP(SUM([Calculation_2823545904032305154]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Weighted Shrinkage Time&quot; THEN SUM([weighted_shrinkage_time]) / LOOKUP(SUM([weighted_shrinkage_time]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Weighted Closure Time&quot; THEN SUM([weighted_closure_time]) / LOOKUP(SUM([weighted_closure_time]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;Active Riders&quot; THEN SUM([active_riders_weekly]) / LOOKUP(SUM([active_riders_weekly]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;OD Fail Rate&quot; THEN SUM([od_fail_rate]) / LOOKUP(SUM([od_fail_rate]), -52) - 1&#10;ELSEIF [Parameters].[Total Number Of Failed Orders Parameter]=&quot;MP Fail Rate&quot; THEN SUM([mp_fail_rate]) / LOOKUP(SUM([mp_fail_rate]), -52) -1&#10;END'>
          <table-calc ordering-type='Rows' />
