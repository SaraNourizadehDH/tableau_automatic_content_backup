            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - OD%' datatype='real' name='[Calculation_5277374344003272728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
            </column>
            <column caption='Successful Orders - Pickup%' datatype='real' name='[Calculation_5277374344004399137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_pickup]) / SUM([total_number_of_successful_orders])}' />
            </column>
            <column caption='Successful Orders - MP% ' datatype='real' name='[Successful Orders - OD% (copy)_249316482096132096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_mp])/ SUM([total_number_of_successful_orders])}' />
