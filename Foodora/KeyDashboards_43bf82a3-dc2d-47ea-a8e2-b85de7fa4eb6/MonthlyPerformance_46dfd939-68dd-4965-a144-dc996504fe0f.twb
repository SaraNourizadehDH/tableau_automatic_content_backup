      <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
      </column>
      <column caption='Active Customer MTD growth %' datatype='real' name='[Calculation_2019301519332708353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(iif([Calculation_21673596520853506], [monthly_total_active_customer_count], 0))/&#10;AVG(iif([Calculation_21673596521619459], [monthly_total_active_customer_count], 0))-1' />
      </column>
      <column caption='Commission Rate blended' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_2093751647819096064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([commission_rate_od]*[Calculation_3786190288629309457] + [commission_rate_mp]*[successful_orders_mp])/&#10;([Calculation_3786190288629309457] + [successful_orders_mp])' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,today())&#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;  //  AND day([order_day]) &lt;= day(today())-1&#10;//OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])})&#10;THEN TRUE&#10;END' />
      </column>
      <column caption='Successful Orders MTD growth %' datatype='real' name='[Calculation_21673596522942468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))/&#10;SUM(iif([Calculation_21673596521619459], [total_number_of_successful_orders], 0)))-1' />
