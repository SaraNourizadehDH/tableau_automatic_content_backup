          </clause>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='AND'>
                <expression op='='>
                  <expression op='[weekly_report_main].[global_entity_id]' />
                  <expression op='[Lucanet].[global_entity_id]' />
                </expression>
                <expression op='='>
                  <expression op='[weekly_report_main].[order_day]' />
                  <expression op='[Lucanet].[month]' />
                </expression>
              </expression>
            </clause>
            <relation join='left' type='join'>
              <clause type='join'>
                <expression op='AND'>
                  <expression op='='>
                    <expression op='[weekly_report_main].[global_entity_id]' />
                    <expression op='[RR - month].[global_entity_id]' />
                  </expression>
                  <expression op='='>
                    <expression op='[weekly_report_main].[order_day]' />
                    <expression op='[RR - month].[order_date]' />
                  </expression>
                </expression>
              </clause>
              <relation connection='bigquery.1tqh5cy1mhk9r51h0z6pj0t3pgqz' name='weekly_report_main' table='[dhh---analytics-eu.bl_europe].[weekly_report_main]' type='table' />
              <relation connection='bigquery.1tqh5cy1mhk9r51h0z6pj0t3pgqz' name='RR - month' type='text'>WITH countries as 
(
SELECT 
   order_date,
	 global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (&apos;OP_SE&apos;, &apos;FO_NO&apos;, &apos;PO_FI&apos;, &apos;DJ_CZ&apos;, &apos;NP_HU&apos;, &apos;MJM_AT&apos;, &apos;YS_TR&apos;)
GROUP BY 1,2 
),

total AS
(
SELECT 
   order_date,
	&apos;total&apos; global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (&apos;OP_SE&apos;, &apos;FO_NO&apos;, &apos;PO_FI&apos;, &apos;DJ_CZ&apos;, &apos;NP_HU&apos;, &apos;MJM_AT&apos;)
GROUP BY 1,2 
),

total_with_TR AS
(
SELECT 
   order_date,
	&apos;total_with_TR&apos; global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (&apos;OP_SE&apos;, &apos;FO_NO&apos;, &apos;PO_FI&apos;, &apos;DJ_CZ&apos;, &apos;NP_HU&apos;, &apos;MJM_AT&apos;, &apos;YS_TR&apos;)
GROUP BY 1,2 
)

SELECT * FROM countries
UNION ALL 
SELECT * FROM total
UNION ALL 
SELECT * FROM total_with_TR</relation>
            </relation>
            <relation connection='bigquery.1tqh5cy1mhk9r51h0z6pj0t3pgqz' name='Lucanet' type='text'><![CDATA[WITH base as 
(
SELECT 
    month,
    lucanet.global_entity_id,
    -- Commissions
     SUM(IF(currency = 'Default currency', od_restaurant_commission, 0)) AS od_restaurant_comission,
      SUM(IF(currency = 'Default currency', od_restaurant_commission_base, 0)) AS od_restaurant_gfv_sales_definition_cr_base,
    SUM(IF(currency = 'Default currency', mp_restaurant_commission, 0)) AS mp_restaurant_commission,
    SUM(IF(currency = 'Default currency', mp_restaurant_commission_base, 0)) AS mp_restaurant__gmv_sales_definition_cr_base,
     SUM(IF(currency = 'EUR', total_orders, 0)) AS total_delivery_orders,
   SUM(IF(currency = 'EUR', total_marketplace_orders, 0)) AS total_marketplace_orders,
       SUM(IF(currency = 'EUR', total_ncr_P70299, 0)) AS ncr_eur,
   SUM(IF(currency = 'EUR', joker_revenue, 0)) AS joker_revenue,
  SUM(IF(currency = 'EUR', cpc_cpp_revenue, 0)) AS cpp_cpc,
    -- ncr

   /* SUM(lucanet.total_ncr_P70299)* SAFE_DIVIDE( SUM(eur_gfv_incl__vat__del), SUM(gfv_incl__vat__del)) ncr_eur, 
    SAFE_DIVIDE( SUM(eur_gfv_incl__vat__del), SUM(gfv_incl__vat__del))*SUM(num_70012500_joker_revenue) AS joker_revenue,
    SAFE_DIVIDE( SUM(eur_gfv_incl__vat__del), SUM(gfv_incl__vat__del))*SUM(num_70012000_advertising_revenues__listing_priority) As cpp_cpc*/
  FROM `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_ln_os_key_kpis`  lucanet
  WHERE lucanet.global_entity_id IN ('OP_SE', 'FO_NO', 'PO_FI', 'DJ_CZ', 'NP_HU', 'MJM_AT', 'YS_TR')
    and record_type = 'Actual' 
  group by 1,2
  order by 1 desc,2
),

prep AS
(
SELECT
  month,
  global_entity_id,
  SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) AS  cr_od,
  SAFE_DIVIDE (SUM(mp_restaurant_commission ), SUM(mp_restaurant__gmv_sales_definition_cr_base)) AS  cr_mp,
  (SUM(total_delivery_orders)* SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) + 
    SUM(total_marketplace_orders) *  SAFE_DIVIDE(SUM(mp_restaurant_commission), SUM(mp_restaurant__gmv_sales_definition_cr_base)))/
    SUM(total_delivery_orders+total_marketplace_orders) AS commission_rate_blended,
  SUM(ncr_eur) ncr_eur,
  SUM(joker_revenue) joker_revenue,
  SUM(cpp_cpc) cpp_cpc
FROM base
GROUP BY 1, 2
UNION ALL
SELECT
  month,
  'total' AS global_entity_id,
  SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) AS  cr_od,
  SAFE_DIVIDE (SUM(mp_restaurant_commission ), SUM(mp_restaurant__gmv_sales_definition_cr_base)) AS  cr_mp,
  (SUM(total_delivery_orders)* SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) + 
    SUM(total_marketplace_orders) *  SAFE_DIVIDE(SUM(mp_restaurant_commission), SUM(mp_restaurant__gmv_sales_definition_cr_base)))/
    SUM(total_delivery_orders+total_marketplace_orders) AS commission_rate_blended,
  SUM(ncr_eur) ncr_eur,
  SUM(joker_revenue) joker_revenue,
  SUM(cpp_cpc) cpp_cpc
FROM base
WHERE global_entity_id <<>> 'YS_TR'
GROUP BY 1, 2
UNION ALL
SELECT
  month,
  'total_with_TR' AS global_entity_id,
  SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) AS  cr_od,
  SAFE_DIVIDE (SUM(mp_restaurant_commission ), SUM(mp_restaurant__gmv_sales_definition_cr_base)) AS  cr_mp,
  (SUM(total_delivery_orders)* SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) + 
    SUM(total_marketplace_orders) *  SAFE_DIVIDE(SUM(mp_restaurant_commission), SUM(mp_restaurant__gmv_sales_definition_cr_base)))/
    SUM(total_delivery_orders+total_marketplace_orders) AS commission_rate_blended,
  SUM(ncr_eur) ncr_eur,
  SUM(joker_revenue) joker_revenue,
  SUM(cpp_cpc) cpp_cpc
FROM base
GROUP BY 1, 2
)

SELECT *
FROM prep





/*WITH base as 
(
SELECT 
    date_trunc(date(date),month) month,
    lucanet.global_entity_id,
    -- Commissions
    SUM(od_restaurant_comission) od_restaurant_comission,
    SUM(od_restaurant_gfv_sales_definition_cr_base) od_restaurant_gfv_sales_definition_cr_base,
    SUM(mp_restaurant_commission) mp_restaurant_commission, 
    SUM(mp_restaurant__gmv_sales_definition_cr_base) mp_restaurant__gmv_sales_definition_cr_base,
    SUM(total_delivery_orders) total_delivery_orders,
