    <worksheet name='Table (YoY) - Marketing'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='Acquisitions - YoY' datatype='real' default-format='p0.00%' name='[Acquisitions - WoW (copy)_164873985574514703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([main_total_new_customer_count])) - LOOKUP(ZN(SUM([main_total_new_customer_count])), -12)) / ABS(LOOKUP(ZN(SUM([main_total_new_customer_count])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Active Customers Dmart %' datatype='real' default-format='p0.00%' name='[Active Customers % (copy)_222083767588790329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[weekly_total_dmart_active_customer_count] / [weekly_total_active_customer_count]' />
            </column>
            <column caption='Active Customers % - YoY' datatype='real' default-format='p0.00%' name='[Active Customers % - WoW (copy)_164873985582133269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_222083767578501157])) - LOOKUP(ZN(AVG([Calculation_222083767578501157])), -12))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Active Customers Dmart % YoY' datatype='real' default-format='p0.00%' name='[Active Customers Dmart % WoW (copy)_164873985582952471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Active Customers % (copy)_222083767588790329])) - LOOKUP(ZN(AVG([Active Customers % (copy)_222083767588790329])), -12))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Active Customers- YOY' datatype='real' default-format='p0.00%' name='[Active Customers- WoW (copy)_2019301519335014404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(avg([monthly_total_active_customer_count])) - LOOKUP(ZN(avg([monthly_total_active_customer_count])), -12)) / &#10;&#10;ABS(LOOKUP(ZN(avg([monthly_total_active_customer_count])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Basket Incentives - YoY' datatype='real' default-format='p0.00%' name='[Basket Incentives - WoW (copy)_164873985584226330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_222083767595728991])) - LOOKUP(ZN(SUM([Calculation_222083767595728991])), -12)) / ABS(LOOKUP(ZN(SUM([Calculation_222083767595728991])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Active Customers %' datatype='real' default-format='p0.00%' name='[Calculation_222083767578501157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[monthly_total_active_customer_count] / [all_customer_count]' />
            </column>
            <column caption='Basket Incentives' datatype='real' name='[Calculation_222083767595728991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_voucher_value_eur] + [total_discount_value_eur]' />
            </column>
            <column caption='Dummy 1' datatype='integer' default-format='*#,##0.000;-#,##0.000;-' name='[Calculation_3786190287120756737]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Dummy 2' datatype='integer' default-format='*#,##0.000;-#,##0.000;-' name='[Dummy 1 (copy)_3786190287120822274]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Frequency - YoY' datatype='real' default-format='p0.00%' name='[Frequency - WoW (copy)_164873985582641174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Successful Orders (copy)_222083767586455608]) - LOOKUP(ZN([Successful Orders (copy)_222083767586455608]), -12)) / ABS(LOOKUP(ZN([Successful Orders (copy)_222083767586455608]), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='YoY Title' datatype='string' name='[LM YoY Title (copy)_3357222421324894246]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[Parameter 1]),3) + &quot; YoY&quot;' />
            </column>
            <column caption='&lt;= Reporting Month' datatype='boolean' name='[Month Filter (copy)_5277374343931424775]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month]&lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Reactivated from Churn - YoY' datatype='real' default-format='p0.00%' name='[Reactivated from Churn - WoW (copy)_164873985575288849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([reactivated_from_churn])) - LOOKUP(ZN(SUM([reactivated_from_churn])), -12)) / ABS(LOOKUP(ZN(SUM([reactivated_from_churn])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Reactivated from Inactive - YoY' datatype='real' default-format='p0.00%' name='[Reactivated from Inactive - WoW (copy)_164873985576480787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([reactivated_from_inactive])) - LOOKUP(ZN(SUM([reactivated_from_inactive])), -12)) / ABS(LOOKUP(ZN(SUM([reactivated_from_inactive])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions - YoY' datatype='real' default-format='p0.00%' name='[Sessions - WoW (copy)_164873985583280152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF((ZN(SUM([sessions])) - LOOKUP(ZN(SUM([sessions])), -12)) / ABS(LOOKUP(ZN(SUM([sessions])), -12))&gt;10,&#10;&#10;NULL,&#10;&#10;(ZN(SUM([sessions])) - LOOKUP(ZN(SUM([sessions])), -12)) / ABS(LOOKUP(ZN(SUM([sessions])), -12)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions New Visit YoY' datatype='real' datatype-customized='true' default-format='p0.00%' name='[Sessions New Visit WoW (copy)_164873985583558681]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='FLOAT(IIF((ZN(SUM([sessions_new_visit])) - LOOKUP(ZN(SUM([sessions_new_visit])), -12)) / ABS(LOOKUP(ZN(SUM([sessions_new_visit])), -12)) &gt;0,&#10;&#10;&quot;NA&quot;,&#10;&#10;&#10;STR((ZN(SUM([sessions_new_visit])) - LOOKUP(ZN(SUM([sessions_new_visit])), -12)) / ABS(LOOKUP(ZN(SUM([sessions_new_visit])), -12)))))'>
                <table-calc ordering-type='Rows' />
