            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Commission Rate MP - YoY' datatype='real' default-format='p0.00%' name='[Commission Rate MP - WoW (copy)_2570359136597819406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(LOOKUP(ZN(AVG([cr_mp])), -1) - LOOKUP(ZN(AVG([cr_mp])), -13))*100'>
