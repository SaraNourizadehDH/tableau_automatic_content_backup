              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='ADF MTD growth %' datatype='real' name='[AFV MTD growth % (copy)_317996380620603402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Calculation_5277374344708214845], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Calculation_5277374344708214845], 0)))-1' />
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,today())&#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;  //  AND day([order_day]) &lt;= day(today())-1&#10;//OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Successful Orders - OD% - MTD growth %' datatype='real' name='[Calculation_21673596540612615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Calculation_5277374344003272728], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Calculation_5277374344003272728], 0)))-1' />
            </column>
            <column caption='Successful Orders - OD' datatype='integer' default-format='p0.00%' name='[Calculation_3786190288629309457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders_od]' />
            </column>
            <column caption='Successful Orders - OD%' datatype='real' name='[Calculation_5277374344003272728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_5277374344598286378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_gfv_eur] / [total_number_of_successful_orders]' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_5277374344612036660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission_revenue_eur] + [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]&#10;//+ ZN([delivery_fee_od_eur])' />
            </column>
            <column caption='AVG DF' datatype='real' name='[Calculation_5277374344708214845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[delivery_fee_od_eur] / [Calculation_3786190288629309457]' />
            </column>
            <column caption='Revenue MTD growth %' datatype='real' name='[GMV MTD growth % (copy)_21673596883136527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Calculation_5277374344612036660], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Calculation_5277374344612036660], 0)))-1' />
