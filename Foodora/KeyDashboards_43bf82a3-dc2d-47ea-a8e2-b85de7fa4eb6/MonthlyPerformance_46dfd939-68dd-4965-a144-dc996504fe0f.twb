            <column caption='Online Restaurants MTD growth %' datatype='real' name='[GMV MTD growth % (copy)_317996380661788693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(iif([Calculation_21673596520853506], [online_restaurants (daily_report_main)], 0))/&#10;AVG(iif([Calculation_21673596521619459], [online_restaurants (daily_report_main)], 0))-1' />
