    <worksheet name='Table (WoW) - Logistics'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='AVG DT - MoM' datatype='real' default-format='p0.00%' name='[Calculation19]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(([Calculation_1832894725125865472])) - LOOKUP(ZN(([Calculation_1832894725125865472])), -1)) / ABS(LOOKUP(ZN(([Calculation_1832894725125865472])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AVG Promised DT - MoM' datatype='real' default-format='p0.00%' name='[Calculation20]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(([Calculation_1832894725126336513])) - LOOKUP(ZN([Calculation_1832894725126336513]), -1)) / ABS(LOOKUP(([Calculation_1832894725126336513]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders Late &gt; 10 - MoM' datatype='real' default-format='p0.00%' name='[Calculation21]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_285837881995104256]) - LOOKUP(ZN([Calculation_285837881995104256]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DT &gt; 45 - MoM' datatype='real' default-format='p0.00%' name='[Calculation22]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((ZN(([Orders Late &gt; 10 (copy) (copy)_2823545904034140164])) - LOOKUP(ZN(([Orders Late &gt; 10 (copy) (copy)_2823545904034140164])), -1)))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Seamless Orders - MoM' datatype='real' default-format='p0.00%' name='[Calculation23]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((ZN(([Calculation_2823545904032305154])) - LOOKUP(ZN(([Calculation_2823545904032305154])), -1)))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Weighted Shrinkage Time - WoW' datatype='real' default-format='p0.00%' name='[Calculation24]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([weighted_shrinkage_time])) - LOOKUP(ZN(AVG([weighted_shrinkage_time])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Active Riders - MoM' datatype='real' default-format='p0.00%' name='[Calculation25]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([active_riders_weekly])) - LOOKUP(ZN(SUM([active_riders_weekly])), -1)) / ABS(LOOKUP(ZN(SUM([active_riders_weekly])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Weighted Closure Time -WoW' datatype='real' default-format='p0.00%' name='[Calculation26]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((ZN(AVG([weighted_closure_time])) - LOOKUP(ZN(AVG([weighted_closure_time])), -1)))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='OD Fail Rate - MoM' datatype='real' default-format='p0.00%' name='[Calculation27]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([od_fail_rate])) - LOOKUP(ZN(AVG([od_fail_rate])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MP Fail Rate MoM' datatype='real' default-format='p0.00%' name='[Calculation28]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([mp_fail_rate])) - LOOKUP(ZN(AVG([mp_fail_rate])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AVG DT ' datatype='real' name='[Calculation_1832894725125865472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_sum])/SUM([actual_delivery_time_cnt])' />
            </column>
            <column caption='average_promised_time' datatype='real' name='[Calculation_1832894725126336513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(promised_delivery_time_sum)/SUM(promised_delivery_time_cnt)' />
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Seamless Order' datatype='real' name='[Calculation_2823545904032305154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM([seamless_orders_od])/SUM([Successful Orders OD - Target])&#10;&#10;SUM([seamless_orders_od])/SUM([seamless_table_all_orders])' />
            </column>
            <column caption='Orders Late &gt; 10' datatype='real' name='[Calculation_285837881995104256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_delay_over_10_min_count])/SUM([order_delay_cnt]))' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='Month  Filter' datatype='boolean' name='[Is YTD ? (copy)_5277374343910019074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month] &gt;= DATEADD(&apos;month&apos;,-5,[Parameters].[Parameter 1])&#10;AND&#10;[order_month] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='MoM Title ' datatype='string' name='[MoM Title (copy)_21673596845686793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[Parameter 1]),3) +&quot; MoM&quot;' />
            </column>
            <column caption='DT &gt; 45 ' datatype='real' name='[Orders Late &gt; 10 (copy) (copy)_2823545904034140164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(actual_delivery_time_over_45_min_cnt)/SUM(actual_delivery_time_cnt))' />
            </column>
