            </column>
            <column caption='Seamless Orders - YoY' datatype='real' default-format='p0.00%' name='[Seamless Orders - WoW (copy)_2570359136570331138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((ZN(([Calculation_2823545904032305154])) - LOOKUP(ZN(([Calculation_2823545904032305154])), -12)))*100'>
