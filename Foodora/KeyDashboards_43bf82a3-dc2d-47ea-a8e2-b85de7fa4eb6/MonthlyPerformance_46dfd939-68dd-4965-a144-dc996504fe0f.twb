  SUM(cpp_cpc) cpp_cpc
FROM base
GROUP BY 1, 2
UNION ALL
SELECT
  month,
  'total' AS global_entity_id,
  SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) AS  cr_od,
  SAFE_DIVIDE (SUM(mp_restaurant_commission ), SUM(mp_restaurant__gmv_sales_definition_cr_base)) AS  cr_mp,
  (SUM(total_delivery_orders)* SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) + 
    SUM(total_marketplace_orders) *  SAFE_DIVIDE(SUM(mp_restaurant_commission), SUM(mp_restaurant__gmv_sales_definition_cr_base)))/
    SUM(total_delivery_orders+total_marketplace_orders) AS commission_rate_blended,
  SUM(ncr_eur) ncr_eur,
  SUM(joker_revenue) joker_revenue,
  SUM(cpp_cpc) cpp_cpc
FROM base
WHERE global_entity_id <<>> 'YS_TR'
GROUP BY 1, 2
UNION ALL
SELECT
  month,
  'total_with_TR' AS global_entity_id,
  SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) AS  cr_od,
  SAFE_DIVIDE (SUM(mp_restaurant_commission ), SUM(mp_restaurant__gmv_sales_definition_cr_base)) AS  cr_mp,
  (SUM(total_delivery_orders)* SAFE_DIVIDE(SUM(od_restaurant_comission), SUM(od_restaurant_gfv_sales_definition_cr_base)) + 
    SUM(total_marketplace_orders) *  SAFE_DIVIDE(SUM(mp_restaurant_commission), SUM(mp_restaurant__gmv_sales_definition_cr_base)))/
    SUM(total_delivery_orders+total_marketplace_orders) AS commission_rate_blended,
  SUM(ncr_eur) ncr_eur,
  SUM(joker_revenue) joker_revenue,
  SUM(cpp_cpc) cpp_cpc
FROM base
GROUP BY 1, 2
)

SELECT *
FROM prep */]]></relation>
                </relation>
                <relation connection='bigquery.1kjb9a5002l3cc14orwz400icamk' name='Custom SQL Query' type='text'><![CDATA[/*WITH prep AS (SELECT global_entity_id, 
target_month,
be_version,
successful_orders, 
amt_total_revenue_eur,
acquisitions, 
amt_gmv_eur, 
active_users, 
od_restaurant_delivery_fees, 
od_restaurant_orders, 
quarter_orders_target,
quarter_revenue_eur_target,
quarter_gmv_target,
quarter_acquisitions_target
FROM fulfillment-dwh-production.curated_data_shared_intl_markets.lucanet_be
LEFT JOIN (SELECT
  date_trunc(current_date -1, month) AS target_month,
  global_entity_id,
  SUM(successful_orders) quarter_orders_target,
  SUM(amt_total_revenue_eur) quarter_revenue_eur_target,
  SUM(amt_gmv_eur) quarter_gmv_target,
  SUM(acquisitions) quarter_acquisitions_target
  FROM fulfillment-dwh-production.curated_data_shared_intl_markets.lucanet_be
  WHERE DATE_TRUNC(target_month, quarter) = date_trunc(current_date -1, quarter)
  GROUP BY 1, 2
) USING (target_month, global_entity_id)
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"FP_DE",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU",
"YS_TR")),

total_with_TR AS (SELECT
  'DH_Europe+YS_TR' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_total_revenue_eur),
SUM(acquisitions), 
SUM(amt_gmv_eur), 
SUM(active_users), 
SUM(od_restaurant_delivery_fees), 
SUM(od_restaurant_orders), 
SUM(quarter_orders_target),
SUM(quarter_revenue_eur_target),
SUM(quarter_gmv_target),
SUM(quarter_acquisitions_target)
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU",
"YS_TR")
GROUP BY 1, 2
),

total_without_TR AS (SELECT
  'DH_Europe' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_total_revenue_eur),
SUM(acquisitions), 
SUM(amt_gmv_eur), 
SUM(active_users), 
SUM(od_restaurant_delivery_fees), 
SUM(od_restaurant_orders), 
SUM(quarter_orders_target),
SUM(quarter_revenue_eur_target),
SUM(quarter_gmv_target),
SUM(quarter_acquisitions_target)
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU")
GROUP BY 1, 2)

SELECT *
FROM prep
UNION ALL
SELECT *
FROM total_with_TR
UNION ALL
SELECT *
FROM total_without_TR*/

with
prep as
(SELECT distinct 
global_entity_id,
month as target_month,
record_type as be_Version,
total_orders as successful_orders, 
total_net_gmv  as amt_gmv_eur,
acquisitions, 
 revenue_total as amt_total_revenue_eur  ,
 mp_gfv as amt_gfv_mp_eur, 
od_gfv amt_gfv_od_eur, 
od_restaurant_delivery_fees od_restaurant_delivery_fees,  
od_restaurant_orders od_restaurant_orders
FROM `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_ln_os_key_kpis_lm_be` 
where
currency = 'EUR' 
and record_type <<>> 'Actual'
and month = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH)
and country in ('Austria', 'Czech Republic', 'Finland', 'Sweden', 'Norway', 'Hungary', 'Turkey')

UNION ALL

SELECT distinct 
global_entity_id,
month as target_month, 
record_type as be_Version,
total_orders as successful_orders, 
total_net_gmv  as amt_gmv_eur,
acquisitions, 
 revenue_total as amt_total_revenue_eur  ,
 mp_gfv as amt_gfv_mp_eur, 
od_gfv amt_gfv_od_eur, 
od_restaurant_delivery_fees od_restaurant_delivery_fees,  
od_restaurant_orders od_restaurant_orders
FROM `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_ln_os_key_kpis` 
where
currency = 'EUR' 
and record_type <<>> 'Actual'
and month = DATE_TRUNC(CURRENT_DATE(), MONTH)
and country in ('Austria', 'Czech Republic', 'Finland', 'Sweden', 'Norway', 'Hungary', 'Turkey')

),

total_with_TR AS (SELECT
  'total_with_TR' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_gmv_eur), 
SUM(acquisitions),
SUM(amt_total_revenue_eur),
SUM(amt_gfv_mp_eur),  
SUM(amt_gfv_od_eur),
SUM(od_restaurant_delivery_fees),
SUM(od_restaurant_orders)
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU",
"YS_TR")
GROUP BY 1, 2
),

total_without_TR AS (SELECT
  'total' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_gmv_eur), 
SUM(acquisitions),
SUM(amt_total_revenue_eur),
SUM(amt_gfv_mp_eur),  
SUM(amt_gfv_od_eur),
SUM(od_restaurant_delivery_fees),
SUM(od_restaurant_orders) 
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU")
GROUP BY 1, 2)

SELECT *
FROM prep
UNION ALL
SELECT *
FROM total_with_TR
UNION ALL
SELECT *
FROM total_without_TR]]></relation>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
