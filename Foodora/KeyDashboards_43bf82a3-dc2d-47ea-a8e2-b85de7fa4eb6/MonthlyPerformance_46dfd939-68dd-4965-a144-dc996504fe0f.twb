      <column caption='AFV - Target' datatype='real' name='[Calculation_6447606564331470861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([amt_gfv_mp_eur] + [amt_gfv_od_eur]) / [successful_orders]' />
