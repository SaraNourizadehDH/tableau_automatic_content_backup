            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='Active Customers- MoM' datatype='real' default-format='p0.00%' name='[AVG Promised DT - WoW (copy)_2019301519333257218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(avg([monthly_total_active_customer_count])) - LOOKUP(ZN(avg([monthly_total_active_customer_count])), -1)) / &#10;&#10;ABS(LOOKUP(ZN(avg([monthly_total_active_customer_count])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Active Customers Dmart %' datatype='real' default-format='p0.00%' name='[Active Customers % (copy)_222083767588790329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[weekly_total_dmart_active_customer_count] / [weekly_total_active_customer_count]' />
            </column>
            <column caption='Acquisitions - MoM' datatype='real' default-format='p0.00%' name='[Calculation10]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([main_total_new_customer_count])) - LOOKUP(ZN(SUM([main_total_new_customer_count])), -1)) / ABS(LOOKUP(ZN(SUM([main_total_new_customer_count])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Reactivated from Churn - MoM' datatype='real' default-format='p0.00%' name='[Calculation11]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([reactivated_from_churn])) - LOOKUP(ZN(SUM([reactivated_from_churn])), -1)) / ABS(LOOKUP(ZN(SUM([reactivated_from_churn])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Reactivated from Inactive -MoM' datatype='real' default-format='p0.00%' name='[Calculation12]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([reactivated_from_inactive])) - LOOKUP(ZN(SUM([reactivated_from_inactive])), -1)) / ABS(LOOKUP(ZN(SUM([reactivated_from_inactive])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Active Customers % - MoM' datatype='real' default-format='p0.00%' name='[Calculation13]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((ZN(AVG([Calculation_222083767578501157])) - LOOKUP(ZN(AVG([Calculation_222083767578501157])), -1)))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Frequency - MoM' datatype='real' default-format='p0.00%' name='[Calculation14]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Successful Orders (copy)_222083767586455608]) - LOOKUP(ZN([Successful Orders (copy)_222083767586455608]), -1)) / ABS(LOOKUP(ZN([Successful Orders (copy)_222083767586455608]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Active Customers Dmart % MoM' datatype='real' default-format='p0.00%' name='[Calculation15]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Active Customers % (copy)_222083767588790329])) - LOOKUP(ZN(AVG([Active Customers % (copy)_222083767588790329])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions - MoM' datatype='real' default-format='p0.00%' name='[Calculation16]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([sessions])) - LOOKUP(ZN(SUM([sessions])), -1)) / ABS(LOOKUP(ZN(SUM([sessions])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions New Visit MoM' datatype='real' default-format='p0.00%' name='[Calculation17]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([sessions_new_visit])) - LOOKUP(ZN(SUM([sessions_new_visit])), -1)) / ABS(LOOKUP(ZN(SUM([sessions_new_visit])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Basket Incentives - MoM' datatype='real' default-format='p0.00%' name='[Calculation18]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_222083767595728991])) - LOOKUP(ZN(SUM([Calculation_222083767595728991])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_222083767595728991])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Active Customers %' datatype='real' default-format='p0.00%' name='[Calculation_222083767578501157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[monthly_total_active_customer_count] / [all_customer_count]' />
            </column>
            <column caption='Basket Incentives' datatype='real' name='[Calculation_222083767595728991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_voucher_value_eur] + [total_discount_value_eur]' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='Month  Filter' datatype='boolean' name='[Is YTD ? (copy)_5277374343910019074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month] &gt;= DATEADD(&apos;month&apos;,-5,[Parameters].[Parameter 1])&#10;AND&#10;[order_month] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='MoM Title ' datatype='string' name='[MoM Title (copy)_21673596845686793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[Parameter 1]),3) +&quot; MoM&quot;' />
            </column>
            <column caption='Sessions Perseus - MoM' datatype='real' default-format='p0.00%' name='[Sessions - MoM (copy)_5054727696656666624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([sessions_perseus])) - LOOKUP(ZN(SUM([sessions_perseus])), -1)) / ABS(LOOKUP(ZN(SUM([sessions_perseus])), -1))'>
                <table-calc ordering-type='Rows' />
