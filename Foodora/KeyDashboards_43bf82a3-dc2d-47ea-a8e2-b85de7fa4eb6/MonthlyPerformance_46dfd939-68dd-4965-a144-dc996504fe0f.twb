    <worksheet name='Table (MOM) - Topline Orders'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='Successful Orders - OD% - MoM' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_5277374344003272728])) - LOOKUP(ZN(AVG([Calculation_5277374344003272728])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='successful_orders_restaurants_od MoM' datatype='real' default-format='p0.00%' name='[Calculation49]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([successful_orders_restaurants_od])) - LOOKUP(ZN(SUM([successful_orders_restaurants_od])), -1)) / ABS(LOOKUP(ZN(SUM([successful_orders_restaurants_od])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - Pickup% MoM' datatype='real' default-format='p0.00%' name='[Calculation4]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_5277374344004399137])) - LOOKUP(ZN(AVG([Calculation_5277374344004399137])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - Dmart - MoM' datatype='real' default-format='p0.00%' name='[Calculation5]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([count_successful_orders_dmart])) - LOOKUP(ZN(SUM([count_successful_orders_dmart])), -1)) / ABS(LOOKUP(ZN(SUM([count_successful_orders_dmart])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - LS - MoM' datatype='real' default-format='p0.00%' name='[Calculation6]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([count_successful_orders_local_shops])) - LOOKUP(ZN(SUM([count_successful_orders_local_shops])), -1)) / ABS(LOOKUP(ZN(SUM([count_successful_orders_local_shops])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='MoM Title' datatype='string' name='[Calculation_3357222421305200662]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[Parameter 1]),3) + &quot; MoM&quot;' />
            </column>
            <column caption='Successful Orders - OD%' datatype='real' name='[Calculation_5277374344003272728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
            </column>
            <column caption='Successful Orders - Pickup%' datatype='real' name='[Calculation_5277374344004399137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_pickup]) / SUM([total_number_of_successful_orders])}' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='Month  Filter' datatype='boolean' name='[Is YTD ? (copy)_5277374343910019074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month] &gt;= DATEADD(&apos;month&apos;,-5,[Parameters].[Parameter 1])&#10;AND&#10;[order_month] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Successful Orders - MP% ' datatype='real' name='[Successful Orders - OD% (copy)_249316482096132096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_mp])/ SUM([total_number_of_successful_orders])}' />
            </column>
            <column caption='Successful Orders - MP% - MoM ' datatype='real' default-format='p0.00%' name='[Successful Orders - OD% - MoM (copy)_249316482098409473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Successful Orders - OD% (copy)_249316482096132096])) - LOOKUP(ZN(AVG([Successful Orders - OD% (copy)_249316482096132096])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - Dmart' datatype='integer' name='[count_successful_orders_dmart]' role='measure' type='quantitative' />
