    <worksheet name='Table (MTD growth %) - Logistics'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='Avg. Promised DT MTD growth %' datatype='real' name='[ADF MTD growth % (copy)_317996380650811404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [promised_delivery_time_sum], 0))/&#10;SUM(iif([Calculation_21673596520853506], [promised_delivery_time_cnt], 0)))*&#10;SUM(iif([Calculation_21673596521619459], [promised_delivery_time_cnt], 0))/&#10;SUM(iif([Calculation_21673596521619459], [promised_delivery_time_sum], 0))&#10;&#10;&#10;-1' />
            </column>
            <column caption='Avg. DT MTD growth %' datatype='real' name='[AFV MTD growth % (copy)_317996380650213387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [actual_delivery_time_sum], 0))/&#10;SUM(iif([Calculation_21673596520853506], [actual_delivery_time_cnt], 0)))*&#10;SUM(iif([Calculation_21673596521619459], [actual_delivery_time_cnt], 0))/&#10;SUM(iif([Calculation_21673596521619459], [actual_delivery_time_sum], 0))&#10;&#10;&#10;-1' />
            </column>
            <column caption='Seamless orders MTD growth %' datatype='real' name='[AFV MTD growth % (copy)_317996380654538767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_21673596520853506], ([seamless_orders_od]),0))/&#10;SUM(IIF([Calculation_21673596520853506], ([successful_orders_od]),0))&#10;&#10;*&#10;SUM(IIF([Calculation_21673596521619459], ([successful_orders_od]),0))/&#10;SUM(IIF([Calculation_21673596521619459], ([seamless_orders_od]),0))' />
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,today())&#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;  //  AND day([order_day]) &lt;= day(today())-1&#10;//OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Orders Late &gt;10  MTD growth %' datatype='real' name='[Frequency MTD growth %  (copy)_317996380651495437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_21673596520853506], ([order_delay_over_10_min_count]),0))/&#10;SUM(IIF([Calculation_21673596520853506], ([order_delay_cnt]),0))&#10;&#10;*&#10;SUM(IIF([Calculation_21673596521619459], ([order_delay_cnt]),0))/&#10;SUM(IIF([Calculation_21673596521619459], ([order_delay_over_10_min_count]),0))' />
            </column>
            <column caption='DT &gt; 45 MTD growth %' datatype='real' name='[GMV MTD growth % (copy)_317996380653285390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_21673596520853506], (actual_delivery_time_over_45_min_cnt),0))/&#10;SUM(IIF([Calculation_21673596520853506], (actual_delivery_time_cnt),0))&#10;&#10;*&#10;SUM(IIF([Calculation_21673596521619459], (actual_delivery_time_cnt),0))/&#10;SUM(IIF([Calculation_21673596521619459], (actual_delivery_time_over_45_min_cnt),0))' />
            </column>
            <column caption='OD Fail Rate MTD growth %' datatype='real' name='[GMV MTD growth % (copy)_317996380657799187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG(iif([Calculation_21673596520853506], [od_fail_rate], 0))-&#10;AVG(iif([Calculation_21673596521619459], [od_fail_rate], 0)))*100' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='MTD  Growth Title' datatype='string' name='[MTD Title (copy)_21673596542980104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,TODAY()),3) + &quot; MTD Growth %&quot;' />
            </column>
            <column caption='MP Fail Rate MTD growth %' datatype='real' name='[OD Fail Rate MTD growth % (copy)_317996380658040852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((AVG(iif([Calculation_21673596520853506], [mp_fail_rate], 0))-&#10;AVG(iif([Calculation_21673596521619459], [mp_fail_rate], 0))))*100' />
            </column>
            <column caption='Weighted shrinkage time MTD growth %' datatype='real' name='[Session MTD growth % (copy)_317996380656607248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG(iif([Calculation_21673596520853506], [weighted_shrinkage_time], 0))-&#10;AVG(iif([Calculation_21673596521619459], [weighted_shrinkage_time], 0)))*100' />
            </column>
            <column caption='Active Riders MTD growth %' datatype='real' name='[Session MTD growth % (copy)_317996380657352722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [active_riders_weekly], 0))/&#10;SUM(iif([Calculation_21673596521619459], [active_riders_weekly], 0)))-1' />
            </column>
            <column caption='Weighted Closure time MTD growth %' datatype='real' name='[Weighted shrinkage time MTD growth % (copy)_317996380656857105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG(iif([Calculation_21673596520853506], [weighted_closure_time], 0))-&#10;AVG(iif([Calculation_21673596521619459], [weighted_closure_time], 0)))*100' />
            </column>
            <column datatype='integer' name='[active_riders_weekly]' role='measure' type='quantitative' />
            <column datatype='integer' name='[actual_delivery_time_cnt]' role='measure' type='quantitative' />
            <column datatype='integer' name='[actual_delivery_time_over_45_min_cnt]' role='measure' type='quantitative' />
            <column datatype='real' name='[actual_delivery_time_sum]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
