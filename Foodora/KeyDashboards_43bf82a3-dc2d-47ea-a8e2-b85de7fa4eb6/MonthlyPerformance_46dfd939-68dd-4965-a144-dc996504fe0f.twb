            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='GMV MoM' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([total_gmv_eur])) - LOOKUP(ZN(SUM([total_gmv_eur])), -1)) / ABS(LOOKUP(ZN(SUM([total_gmv_eur])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Revenue MoM' datatype='real' default-format='p0.00%' name='[Calculation7]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_5277374344612036660])) - LOOKUP(ZN(SUM([Calculation_5277374344612036660])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_5277374344612036660])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AFV MoM' datatype='real' default-format='p0.00%' name='[Calculation8]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_5277374344598286378])) - LOOKUP(ZN(SUM([Calculation_5277374344598286378])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_5277374344598286378])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AVG DF MOM' datatype='real' default-format='p0.00%' name='[Calculation9]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_5277374344708214845])) - LOOKUP(ZN(AVG([Calculation_5277374344708214845])), -1)) / ABS(LOOKUP(ZN(AVG([Calculation_5277374344708214845])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Successful Orders - OD' datatype='integer' default-format='p0.00%' name='[Calculation_3786190288629309457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders_od]' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_5277374344598286378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_gfv_eur] / [total_number_of_successful_orders]' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_5277374344612036660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission_revenue_eur] + [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]&#10;//+ ZN([delivery_fee_od_eur])' />
            </column>
            <column caption='AVG DF' datatype='real' name='[Calculation_5277374344708214845]' role='measure' type='quantitative'>
