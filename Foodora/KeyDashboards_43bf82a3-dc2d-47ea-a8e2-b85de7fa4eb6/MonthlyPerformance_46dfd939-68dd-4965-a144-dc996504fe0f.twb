            <column datatype='date' name='[order_month]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='order_week' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_day]))' scope-isolation='false' />
