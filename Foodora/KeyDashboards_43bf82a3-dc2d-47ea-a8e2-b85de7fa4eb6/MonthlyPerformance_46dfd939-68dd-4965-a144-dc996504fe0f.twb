              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='Month  Filter' datatype='boolean' name='[Is YTD ? (copy)_5277374343910019074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month] &gt;= DATEADD(&apos;month&apos;,-5,[Parameters].[Parameter 1])&#10;AND&#10;[order_month] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='RR - MoM Title' datatype='string' name='[MoM Title (copy)_3786190288589885453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[Parameter 1]),3) + &quot; RR MoM&quot;' />
            </column>
            <column caption='GMV - RR - MoM' datatype='real' default-format='p0.00%' name='[Successful Orders - RR - MoM - Last Month (copy)_3786190288842412056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([gmv_eur_month_rr])) - LOOKUP(ZN(SUM([total_gmv_eur])), -1)) / ABS(LOOKUP(ZN(SUM([total_gmv_eur])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
