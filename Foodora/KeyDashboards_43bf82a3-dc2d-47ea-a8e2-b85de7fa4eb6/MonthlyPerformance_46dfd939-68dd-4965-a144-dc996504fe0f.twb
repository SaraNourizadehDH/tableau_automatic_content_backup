    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#9b0031' fontname='Tableau Medium'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/MonthlyPerformance_16920152207660/Glossary?rev=' id='Glossary' path='/t/Foodora/workbooks/MonthlyPerformance_16920152207660' revision='' site='Foodora' />
      <style />
      <size maxheight='1600' maxwidth='1500' minheight='1600' minwidth='1500' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='99000' id='7' param='vert' type-v2='layout-flow' w='98934' x='533' y='500'>
            <zone h='99000' id='5' type-v2='layout-basic' w='98934' x='533' y='500'>
              <zone forceUpdate='true' h='94747' id='3' type-v2='text' w='98934' x='533' y='4753'>
                <formatted-text>
                  <run fontcolor='#000000' fontsize='14' underline='true'>KPIs</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Acquisitions =</run>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'># of customers placing their very first order on the platform</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Active Customers =</run>
                  <run bold='true' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'># of customers placing an order on the platform</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>ADF =</run>
                  <run fontname='Tableau Medium' fontsize='10'> Total Delivery fee for OD orders / #OD successful orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>AFV =</run>
                  <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'>Average food value, GFV divided by total successful orders </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Avg. Promised Delivery Time = </run>
                  <run fontname='Tableau Medium' fontsize='10'> Average time (mins) which was promised to the customer upon order placement (preorders excluded)</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Basket Incentives = </run>
                  <run fontname='Tableau Medium' fontsize='10'>Total discount value + Total voucher value .</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Commission Rate OD rest sales def (Lucanet) =</run>
                  <run fontcolor='#cc0050' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'>Commission revenue from OD restaurants divided by GFV(Sales definition) for OD restaurants.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Commission Rate MPrest sales def (Lucanet) =</run>
                  <run fontcolor='#b4003e' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'>Commission revenue from MP restaurants divided by GMV(Sales definition) for MP restaurants.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>DT&gt; 45= </run>
                  <run fontname='Tableau Medium' fontsize='10'>% of orders that were delivered &gt; 45 minutes from when the order was placed (preorders excluded).</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Existing Customers =</run>
                  <run fontname='Tableau Medium' fontsize='10'> # of customers placing an order on the platform; not for the first time. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Fail Rate OD =</run>
                  <run bold='true' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'> # Failed Orders (own delivery) / # Gross Orders (own delivery).</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Fail Rate MP = </run>
                  <run fontname='Tableau Medium' fontsize='10'> # Failed Orders (marketplace) / # Gross Orders (marketplace).</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Frequency =</run>
                  <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'># Successful Orders / # Active Customers</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>GMV =</run>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'>Gross Merchandise Value [€]</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Revenue = </run>
                  <run fontname='Tableau Medium' fontsize='10'>The sum of commission plus Delivery Fee [€].</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Seamless Orders = </run>
                  <run fontname='Tableau Medium' fontsize='10'>An order is seamless if the following conditions are met:</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- The order was own delivery</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- The order was successful</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- There were no logistics-related cancellations i.e. failures</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- Its delivery was within +/- 10 minutes of promised delivery time</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>- There were no Service interactions i.e. no Help Center sessions and no contacts</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Session =</run>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ  </run>
                  <run fontname='Tableau Medium' fontsize='10'># of visits to our platform</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Signed Local Shops (after QC)= </run>
                  <run fontname='Tableau Medium' fontsize='10'>Number of signed Local Shops who passed quality checks </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Signed Vendors (after QC)= </run>
                  <run fontname='Tableau Medium' fontsize='10'>Number of signed vendors who passed quality checks </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Successful Orders =</run>
                  <run fontname='Tableau Medium' fontsize='10'>Total number of orders successfully processed during the reported period. Success is from a customer perspective, not commission. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Successful Orders </run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>% Pickup</run>
                  <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>= </run>
                  <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>#</run>
                  <run fontname='Tableau Medium' fontsize='10'> Successful Orders - Pickup / # Successful Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Successful Orders - OD =  </run>
                  <run fontname='Tableau Medium' fontsize='10'># Successful Orders that were delivered by OD = &quot;Own Delivery&quot;.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Successful Orders for Dmarts =</run>
                  <run bold='true' fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run fontname='Tableau Medium' fontsize='10'>same as above, for the dmarts vertical.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Total New Local Shops =</run>
                  <run fontname='Tableau Medium' fontsize='10'> Total numbers for local shops that went online in a given month, this inlcludes all the vendors signed at any given time. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Total New Vendors= </run>
                  <run fontname='Tableau Medium' fontsize='10'>Total numbers for vendors that went online in a given month, this inlcludes all the vendors signed at any given time. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Vendors with VF Deals = </run>
                  <run fontname='Tableau Medium' fontsize='10'># Vendors that ran a fully funded discounts (Including Joker, considering only Restaurants and Local Shops)</run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='14' underline='true'>Calculations</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>MTD = </run>
                  <run fontname='Tableau Medium' fontsize='10'>The month-to-date amount of a given metric. For example, if today is the 15th of March, for additive matrix-like successful orders and sessions, MTD will be the sum of orders from the 1st of March until the 14th.  For non-additive KPIs like online restaurants and active customers, it will be the actual value on the 14th.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>MTD growth%= </run>
                  <run fontname='Tableau Medium' fontsize='10'>The MTD growth compared to the previous MTD. The example above would be the MTD for the current month till 14th, minus the MTD value till 14th Feb., divided by the MTD value till 14th Feb. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>pp = </run>
                  <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>Percentage Points, the absolute difference in the percentages.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Run Rate =</run>
                  <run fontname='Tableau Medium' fontsize='10'>Calculated as the actual amount of the current month, plus the average of the last 21 days. For example, if we have data until the 3rd of the current month, we take the actual gmv amount for those 3 days, plus the average amount of gmv from the last 21 days, and extrapolate it for the whole month. The only exception to this is active/existing customer KPIs which use 3 months daily average and extrapolate it to the remaining days in the month.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Current Month RR vs Target =</run>
                  <run fontname='Tableau Medium' fontsize='10'> Defined as the Run Rate for the current month - the target for the current month, divided by the Run Rate for the current month. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Current Month RR vs YoY % = </run>
                  <run fontname='Tableau Medium' fontsize='10'> Defined as the Run Rate for the current month - the actual value for the same month the previous year, divided by the Run Rate for the current month.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Current Month MTD vs YoY % =</run>
                  <run fontname='Tableau Medium' fontsize='10'> Defined as the MTD value for the current month - the actual value for the same month the previous year, divided by the MTD value for the current month.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>ACID =</run>
                  <run fontname='Tableau Medium' fontsize='10'>  All customer KPIs are based on analytical_customer_id which combines multiple accounts of the same person using a fuzzy matching logic, therefore more accurate when calculating those KPIs.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Medium' fontsize='10'>Æ </run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10' underline='true'>Additional information</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>The targets are extracted from LUCANET 2022. You can see them in the following gsheet, under the Targets tab: </run>
                  <run auto-url='true' fontcolor='#4996b2' fontname='Tableau Medium' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1pEG3ThsJrNUUEA_hUSh14h3KXmb7k5iI0VI6jz_2L80/edit#gid=1485601104&amp;quot;'>https://docs.google.com/spreadsheets/d/1pEG3ThsJrNUUEA_hUSh14h3KXmb7k5iI0VI6jz_2L80/edit#gid=1485601104</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone alt-text='Current Backlog' h='4253' id='9' is-scaled='1' param='Image/Screenshot 2022-05-13 at 14.05.26.png' type-v2='bitmap' url='https://docs.google.com/spreadsheets/d/1DA8El1oe4v-9lDTLUa-4qxPZrXX4tYNG_c8O-NO-SuY/edit#gid=1155261892' w='11229' x='88238' y='500'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='4253' id='8' type-v2='title' w='87705' x='533' y='500'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <layout-options>
            <title>
              <formatted-text>
                <run fontcolor='#9b0031' fontname='Tableau Medium'>&lt;Sheet Name&gt;</run>
              </formatted-text>
            </title>
          </layout-options>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='533' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='532' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='4253' id='8' type-v2='title' w='87705' x='533' y='500'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone alt-text='Current Backlog' fixed-size='60' h='4253' id='9' is-fixed='true' is-scaled='1' param='Image/Screenshot 2022-05-13 at 14.05.26.png' type-v2='bitmap' url='https://docs.google.com/spreadsheets/d/1DA8El1oe4v-9lDTLUa-4qxPZrXX4tYNG_c8O-NO-SuY/edit#gid=1155261892' w='11229' x='88238' y='500'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='94747' id='3' type-v2='text' w='98934' x='533' y='4753'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='14' underline='true'>KPIs</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Acquisitions =</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'># of customers placing their very first order on the platform</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Active Customers =</run>
                    <run bold='true' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'># of customers placing an order on the platform</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>ADF =</run>
                    <run fontname='Tableau Medium' fontsize='10'> Total Delivery fee for OD orders / #OD successful orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>AFV =</run>
                    <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'>Average food value, GFV divided by total successful orders </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Avg. Promised Delivery Time = </run>
                    <run fontname='Tableau Medium' fontsize='10'> Average time (mins) which was promised to the customer upon order placement (preorders excluded)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Basket Incentives = </run>
                    <run fontname='Tableau Medium' fontsize='10'>Total discount value + Total voucher value .</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Commission Rate OD rest sales def (Lucanet) =</run>
                    <run fontcolor='#cc0050' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'>Commission revenue from OD restaurants divided by GFV(Sales definition) for OD restaurants.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Commission Rate MPrest sales def (Lucanet) =</run>
                    <run fontcolor='#b4003e' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'>Commission revenue from MP restaurants divided by GMV(Sales definition) for MP restaurants.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>DT&gt; 45= </run>
                    <run fontname='Tableau Medium' fontsize='10'>% of orders that were delivered &gt; 45 minutes from when the order was placed (preorders excluded).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Existing Customers =</run>
                    <run fontname='Tableau Medium' fontsize='10'> # of customers placing an order on the platform; not for the first time. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Fail Rate OD =</run>
                    <run bold='true' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'> # Failed Orders (own delivery) / # Gross Orders (own delivery).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Fail Rate MP = </run>
                    <run fontname='Tableau Medium' fontsize='10'> # Failed Orders (marketplace) / # Gross Orders (marketplace).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Frequency =</run>
                    <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'># Successful Orders / # Active Customers</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>GMV =</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'>Gross Merchandise Value [€]</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Revenue = </run>
                    <run fontname='Tableau Medium' fontsize='10'>The sum of commission plus Delivery Fee [€].</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Seamless Orders = </run>
                    <run fontname='Tableau Medium' fontsize='10'>An order is seamless if the following conditions are met:</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium' fontsize='10'>- The order was own delivery</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium' fontsize='10'>- The order was successful</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium' fontsize='10'>- There were no logistics-related cancellations i.e. failures</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium' fontsize='10'>- Its delivery was within +/- 10 minutes of promised delivery time</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium' fontsize='10'>- There were no Service interactions i.e. no Help Center sessions and no contacts</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Session =</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ  </run>
                    <run fontname='Tableau Medium' fontsize='10'># of visits to our platform</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Signed Local Shops (after QC)= </run>
                    <run fontname='Tableau Medium' fontsize='10'>Number of signed Local Shops who passed quality checks </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Signed Vendors (after QC)= </run>
                    <run fontname='Tableau Medium' fontsize='10'>Number of signed vendors who passed quality checks </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Successful Orders =</run>
                    <run fontname='Tableau Medium' fontsize='10'>Total number of orders successfully processed during the reported period. Success is from a customer perspective, not commission. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Successful Orders </run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>% Pickup</run>
                    <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>= </run>
                    <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>#</run>
                    <run fontname='Tableau Medium' fontsize='10'> Successful Orders - Pickup / # Successful Orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9e0041' fontname='Tableau Medium' fontsize='10'>Successful Orders - OD =  </run>
                    <run fontname='Tableau Medium' fontsize='10'># Successful Orders that were delivered by OD = &quot;Own Delivery&quot;.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Successful Orders for Dmarts =</run>
                    <run bold='true' fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run fontname='Tableau Medium' fontsize='10'>same as above, for the dmarts vertical.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Total New Local Shops =</run>
                    <run fontname='Tableau Medium' fontsize='10'> Total numbers for local shops that went online in a given month, this inlcludes all the vendors signed at any given time. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Total New Vendors= </run>
                    <run fontname='Tableau Medium' fontsize='10'>Total numbers for vendors that went online in a given month, this inlcludes all the vendors signed at any given time. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Vendors with VF Deals = </run>
                    <run fontname='Tableau Medium' fontsize='10'># Vendors that ran a fully funded discounts (Including Joker, considering only Restaurants and Local Shops)</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='14' underline='true'>Calculations</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>MTD = </run>
                    <run fontname='Tableau Medium' fontsize='10'>The month-to-date amount of a given metric. For example, if today is the 15th of March, for additive matrix-like successful orders and sessions, MTD will be the sum of orders from the 1st of March until the 14th.  For non-additive KPIs like online restaurants and active customers, it will be the actual value on the 14th.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>MTD growth%= </run>
                    <run fontname='Tableau Medium' fontsize='10'>The MTD growth compared to the previous MTD. The example above would be the MTD for the current month till 14th, minus the MTD value till 14th Feb., divided by the MTD value till 14th Feb. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>pp = </run>
                    <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>Percentage Points, the absolute difference in the percentages.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Run Rate =</run>
                    <run fontname='Tableau Medium' fontsize='10'>Calculated as the actual amount of the current month, plus the average of the last 21 days. For example, if we have data until the 3rd of the current month, we take the actual gmv amount for those 3 days, plus the average amount of gmv from the last 21 days, and extrapolate it for the whole month. The only exception to this is active/existing customer KPIs which use 3 months daily average and extrapolate it to the remaining days in the month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Current Month RR vs Target =</run>
                    <run fontname='Tableau Medium' fontsize='10'> Defined as the Run Rate for the current month - the target for the current month, divided by the Run Rate for the current month. </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Current Month RR vs YoY % = </run>
                    <run fontname='Tableau Medium' fontsize='10'> Defined as the Run Rate for the current month - the actual value for the same month the previous year, divided by the Run Rate for the current month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>Current Month MTD vs YoY % =</run>
                    <run fontname='Tableau Medium' fontsize='10'> Defined as the MTD value for the current month - the actual value for the same month the previous year, divided by the MTD value for the current month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#9b0031' fontname='Tableau Medium' fontsize='10'>ACID =</run>
                    <run fontname='Tableau Medium' fontsize='10'>  All customer KPIs are based on analytical_customer_id which combines multiple accounts of the same person using a fuzzy matching logic, therefore more accurate when calculating those KPIs.</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Medium' fontsize='10'>Æ </run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10' underline='true'>Additional information</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>The targets are extracted from LUCANET 2022. You can see them in the following gsheet, under the Targets tab: </run>
                    <run auto-url='true' fontcolor='#4996b2' fontname='Tableau Medium' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1pEG3ThsJrNUUEA_hUSh14h3KXmb7k5iI0VI6jz_2L80/edit#gid=1485601104&amp;quot;'>https://docs.google.com/spreadsheets/d/1pEG3ThsJrNUUEA_hUSh14h3KXmb7k5iI0VI6jz_2L80/edit#gid=1485601104</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{AAB4EE16-C11A-4597-9BE6-BA493FF32EA5}' />
