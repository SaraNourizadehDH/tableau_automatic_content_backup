            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Successful Orders - OD' datatype='integer' default-format='p0.00%' name='[Calculation_3786190288629309457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders_od]' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_5277374344598286378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_gfv_eur] / [total_number_of_successful_orders]' />
            </column>
            <column caption='AVG DF' datatype='real' name='[Calculation_5277374344708214845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[delivery_fee_od_eur] / [Calculation_3786190288629309457]' />
            </column>
            <column caption='AFV - Target' datatype='real' name='[Calculation_6447606564331470861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([amt_gfv_mp_eur] + [amt_gfv_od_eur]) / [successful_orders]' />
            </column>
            <column caption='AFV - Actual vs Target' datatype='real' default-format='p0.00%' name='[Calculation_6447606564331622414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([Calculation_5277374344598286378]) / AVG([Calculation_6447606564331470861]))-1' />
            </column>
            <column caption='AVG DF - Target' datatype='real' name='[Calculation_6447606564337008655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[od_restaurant_delivery_fees] / [od_restaurant_orders]' />
            </column>
            <column caption='Dummy 11' datatype='integer' default-format='*#,##0.000;-#,##0.000;-' name='[Dummy 8 (copy) (copy) (copy)_1715660363386339400]' role='dimension' type='ordinal'>
