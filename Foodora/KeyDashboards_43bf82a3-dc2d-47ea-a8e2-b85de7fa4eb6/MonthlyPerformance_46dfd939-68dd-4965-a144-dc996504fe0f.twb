      <group hidden='true' name='[Exclusions (Country Name,ISOWEEK(order_day))]' name-style='unqualified' user:auto-column='exclude'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[none:country_name:nk]' />
          <groupfilter function='level-members' level='[tiwk:order_day:ok]' />
        </groupfilter>
      </group>
      <group hidden='true' name='[Exclusions (Country Name,WEEK(order_week))]' name-style='unqualified' user:auto-column='exclude'>
