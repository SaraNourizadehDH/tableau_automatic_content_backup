      <column caption='Is YTD ? - Selection' datatype='boolean' hidden='true' name='[Is Last Month YoY? (copy)_3357222421325299751]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR(Month([order_day])) &lt;= MONTH(TOTAL(MAX([order_day])))&#10;AND&#10;ATTR(YEAR([order_day])) = Year(TOTAL(MAX([order_day])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Previous Week? - Selection' datatype='boolean' hidden='true' name='[Is Last Month? (copy)_3357222421215162371]' role='measure' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, ATTR([order_day])) = DATEADD(&apos;week&apos;, -1, TOTAL(MAX([order_day])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Last Week YoY? - Selection' datatype='boolean' hidden='true' name='[Is Last Month? (copy)_3357222421305700376]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR(ISOWEEK([order_day])) = ISOWEEK((MAX([order_day])))&#10;AND&#10;ATTR(YEAR([order_day])) = Year(TOTAL(MAX([order_day]))) - 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
      </column>
      <column caption='Is Last Year YTD ? - Selection' datatype='boolean' hidden='true' name='[Is YTD ? (copy)_3357222421325643816]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR(Month([order_day])) &lt;= MONTH(TOTAL(MAX([order_day])))&#10;AND&#10;ATTR(YEAR([order_day])) = Year(TOTAL(MAX([order_day]))) - 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Month  Filter' datatype='boolean' name='[Is YTD ? (copy)_5277374343910019074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_month] &gt;= DATEADD(&apos;month&apos;,-5,[Parameters].[Parameter 1])&#10;AND&#10;[order_month] &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Joker Revenue YoY' datatype='real' default-format='p0.00%' name='[Joker Revenue WoW (copy)_3365244483814105094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(LOOKUP(ZN(SUM([joker_revenue])), -1) - LOOKUP(ZN(SUM([joker_revenue])), -13)) / ABS(LOOKUP(ZN(SUM([joker_revenue])), -13))'>
          <table-calc ordering-type='Rows' />
        </calculation>
