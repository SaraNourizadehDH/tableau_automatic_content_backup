            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='OD Fail Rate' datatype='real' default-format='p0.00%' name='[od_fail_rate]' role='measure' type='quantitative' />
            <column datatype='date' name='[order_day]' role='dimension' type='ordinal' />
