    <worksheet name='Table (MTD growth %) - Topline Orders'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,today())&#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;  //  AND day([order_day]) &lt;= day(today())-1&#10;//OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Successful Orders MTD growth %' datatype='real' name='[Calculation_21673596522942468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))/&#10;SUM(iif([Calculation_21673596521619459], [total_number_of_successful_orders], 0)))-1' />
            </column>
            <column caption='Successful Orders - OD% - MTD growth %' datatype='real' name='[Calculation_21673596540612615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Calculation_5277374344003272728], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Calculation_5277374344003272728], 0)))-1' />
            </column>
            <column caption='Successful Orders - OD%' datatype='real' name='[Calculation_5277374344003272728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
            </column>
            <column caption='Successful Orders - Pickup%' datatype='real' name='[Calculation_5277374344004399137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_pickup]) / SUM([total_number_of_successful_orders])}' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='MTD  Growth Title' datatype='string' name='[MTD Title (copy)_21673596542980104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,TODAY()),3) + &quot; MTD Growth %&quot;' />
            </column>
            <column caption='Successful Orders - MP% ' datatype='real' name='[Successful Orders - OD% (copy)_249316482096132096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_mp])/ SUM([total_number_of_successful_orders])}' />
            </column>
            <column caption='Successful Orders - MP% - MTD growth %' datatype='real' name='[Successful Orders - OD% - MTD growth % (copy)_200339836434051072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Successful Orders - OD% (copy)_249316482096132096], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Successful Orders - OD% (copy)_249316482096132096], 0)))-1' />
            </column>
            <column caption='Successful Orders -LS - MTD growth %' datatype='real' name='[Successful Orders - OD% - MTD growth % (copy)_21673596886749202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [count_successful_orders_local_shops], 0))/&#10;SUM(iif([Calculation_21673596521619459], [count_successful_orders_local_shops], 0)))-1' />
            </column>
            <column caption='Successful Orders - Pickup% MTD growth %' datatype='real' name='[Successful Orders MTD growth % (copy)_21673596885397520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [Calculation_5277374344004399137], 0))/&#10;SUM(iif([Calculation_21673596521619459], [Calculation_5277374344004399137], 0)))-1' />
            </column>
            <column caption='Successful Orders - Dmart MTD growth %' datatype='real' name='[Successful Orders MTD growth % (copy)_21673596886413329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [count_successful_orders_dmart], 0))/&#10;SUM(iif([Calculation_21673596521619459], [count_successful_orders_dmart], 0)))-1' />
            </column>
            <column caption='Successful Orders Rest OD MTD growth %' datatype='real' name='[Successful Orders MTD growth % (copy)_4971129617409712129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [successful_orders_restaurants_od], 0))/&#10;SUM(iif([Calculation_21673596521619459], [successful_orders_restaurants_od], 0)))-1' />
            </column>
            <column caption='Successful Orders Rest MP MTD growth %' datatype='real' name='[Successful Orders Rest OD MTD growth % (copy)_200339836434468865]' role='measure' type='quantitative'>
