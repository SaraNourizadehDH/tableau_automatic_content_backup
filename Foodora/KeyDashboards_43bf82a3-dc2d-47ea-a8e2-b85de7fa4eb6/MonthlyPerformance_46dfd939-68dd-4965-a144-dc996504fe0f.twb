              <calculation class='tableau' formula='(ZN(SUM([sessions_new_visit_perseus])) - LOOKUP(ZN(SUM([sessions_new_visit_perseus])), -1)) / ABS(LOOKUP(ZN(SUM([sessions_new_visit_perseus])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Frequency Weekly' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Successful Orders (copy)_222083767586455608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_number_of_successful_orders]) / AVG([weekly_total_active_customer_count])' />
