      <column caption='Reactivated from Inactive - RR' datatype='real' hidden='true' name='[Calculation_6194982782875926534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reactivated_from_inactive])*(7/[Calculation_6194982782874845189])' />
      </column>
      <column caption='Orders w. Discount %' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_6243748316231352352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_with_discount] / [total_number_of_successful_orders]' />
      </column>
      <column caption='Orders w VF Discount %' datatype='real' default-format='p0.00%' name='[Calculation_6243748316232310822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_with_vfd_dash_definition] / ([total_number_of_successful_orders]-[count_successful_orders_dmart])' />
      </column>
      <column caption='NCR (EUR) / GMV' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_6243748316233687089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ncr_in_eur]) / SUM([total_gmv_eur])' />
      </column>
      <column caption='Successful Orders  rest OD- vs Target' datatype='real' default-format='p0.00%' name='[Calculation_6447606564305592324]' role='measure' type='quantitative'>
