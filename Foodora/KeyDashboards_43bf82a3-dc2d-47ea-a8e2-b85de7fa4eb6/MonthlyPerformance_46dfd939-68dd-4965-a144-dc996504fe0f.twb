      <column caption='Within Last 21 days' datatype='boolean' hidden='true' name='[Calculation_6593058783964016641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1) THEN null&#10;ELSE&#10;[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-21&#10;END' />
