    <worksheet name='Table (YoY) - Topline Orders'>
      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(datetrunc(&apos;month&apos;, dateadd(&apos;month&apos;,-1,today())))' />
            </column>
            <column caption='Successful Orders - OD%' datatype='real' name='[Calculation_5277374344003272728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
            </column>
            <column caption='Successful Orders - Pickup%' datatype='real' name='[Calculation_5277374344004399137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_pickup]) / SUM([total_number_of_successful_orders])}' />
            </column>
            <column caption='Is Last Month? - All' datatype='boolean' name='[Is Last Month? - Selection (copy)_3786190288203776008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) =   MONTH(TODAY())&#10;AND YEAR([Parameters].[Parameter 1]) = YEAR(TODAY())' />
            </column>
            <column caption='YoY Title' datatype='string' name='[LM YoY Title (copy)_3357222421324894246]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[Parameter 1]),3) + &quot; YoY&quot;' />
            </column>
            <column caption='&lt;= Reporting Month' datatype='boolean' name='[Month Filter (copy)_5277374343931424775]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month]&lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Successful Orders - Dmart - YoY' datatype='real' default-format='p0.00%' name='[Successful Orders - Dmart - WoW (copy)_164873985283371015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([count_successful_orders_dmart])) - LOOKUP(ZN(SUM([count_successful_orders_dmart])), -52)) / ABS(LOOKUP(ZN(SUM([count_successful_orders_dmart])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - LS - YoY' datatype='real' default-format='p0.00%' name='[Successful Orders - LS - WoW (copy)_164873985283661832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([count_successful_orders_local_shops])) - LOOKUP(ZN(SUM([count_successful_orders_local_shops])), -52)) / ABS(LOOKUP(ZN(SUM([count_successful_orders_local_shops])), -52))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - MP% ' datatype='real' name='[Successful Orders - OD% (copy)_249316482096132096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_mp])/ SUM([total_number_of_successful_orders])}' />
            </column>
            <column caption='Successful Orders - OD% - YoY' datatype='real' default-format='p0.00%' name='[Successful Orders - OD% - WoW (copy)_3032189220536340481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_5277374344003272728])) - LOOKUP(AVG([Calculation_5277374344003272728]), -12))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - MP% - YoY' datatype='real' default-format='p0.00%' name='[Successful Orders - OD% - YoY (copy)_249316482106441731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Successful Orders - OD% (copy)_249316482096132096])) - LOOKUP(AVG([Successful Orders - OD% (copy)_249316482096132096]), -12))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - Pickup% YoY' datatype='real' default-format='p0.00%' name='[Successful Orders - Pickup% WoW (copy)_3032189220536082432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_5277374344004399137])) - LOOKUP(ZN(AVG([Calculation_5277374344004399137])), -12))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders YoY' datatype='real' default-format='p0.00%' name='[Successful Orders WoW (copy)_164873985270554630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF((ZN(SUM([total_number_of_successful_orders])) - LOOKUP(ZN(SUM([total_number_of_successful_orders])), -12)) / ABS(LOOKUP(ZN(SUM([total_number_of_successful_orders])), -12))&gt;3,NULL, &#10;&#10;(ZN(SUM([total_number_of_successful_orders])) - LOOKUP(ZN(SUM([total_number_of_successful_orders])), -12)) / ABS(LOOKUP(ZN(SUM([total_number_of_successful_orders])), -12)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Successful Orders - Dmart' datatype='integer' name='[count_successful_orders_dmart]' role='measure' type='quantitative' />
            <column caption='Successful Orders - LS' datatype='integer' name='[count_successful_orders_local_shops]' role='measure' type='quantitative' />
