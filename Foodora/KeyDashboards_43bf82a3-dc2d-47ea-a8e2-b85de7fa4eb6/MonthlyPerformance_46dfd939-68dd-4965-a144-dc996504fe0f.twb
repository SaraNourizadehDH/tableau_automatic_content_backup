      <table>
        <view>
          <datasources>
            <datasource caption='global_reporting' name='federated.1mi17cf0bxg4a01h90stc0ru82u8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[Calculation_199987980106035203]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1mi17cf0bxg4a01h90stc0ru82u8].[order_month]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mi17cf0bxg4a01h90stc0ru82u8'>
            <column caption='Orders w VF Discount % - MoM' datatype='real' default-format='p0.00%' name='[Calculation35]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Calculation_6243748316232310822])) - LOOKUP(ZN(AVG([Calculation_6243748316232310822])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NCR (EUR) - MoM' datatype='real' default-format='p0.00%' name='[Calculation36]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(LOOKUP(ZN(SUM([ncr_eur])), 0) - LOOKUP(ZN(SUM([ncr_eur])), -1)) / ABS(LOOKUP(ZN(SUM([ncr_eur])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NCR (EUR) / GMV - WoW' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation37]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_6243748316233687089]) - LOOKUP(ZN([Calculation_6243748316233687089]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPC CPP MoM' datatype='real' default-format='p0.00%' name='[Calculation39]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ABS(LOOKUP(ZN(SUM([cpp_cpc])), 0)) - LOOKUP(ZN(SUM([cpp_cpc])), -1)) / ABS(LOOKUP(ZN(SUM([cpp_cpc])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPP WoW' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation40]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([cpp_revenue_daily])) - LOOKUP(ZN(SUM([cpp_revenue_daily])), -1)) / ABS(LOOKUP(ZN(SUM([cpp_revenue_daily])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Joker Revenue MoM' datatype='real' default-format='p0.00%' name='[Calculation41]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( ABS(LOOKUP(ZN(SUM([joker_revenue])), 0))- LOOKUP(ZN(SUM([joker_revenue])), -1)) / ABS(LOOKUP(ZN(SUM([joker_revenue])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NCR other WoW' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation42]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([ncr_others])) - LOOKUP(ZN(SUM([ncr_others])), -1)) / ABS(LOOKUP(ZN(SUM([ncr_others])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='previous month' datatype='date' name='[Calculation_199987980106035203]' role='dimension' type='ordinal'>
