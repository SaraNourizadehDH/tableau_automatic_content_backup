      <column caption='Online Restaurants - Calc.' datatype='integer' name='[Calculation_3588454131674173440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [order_day], [country_name]: SUM([online_restaurants (daily_report_main)])}' />
      </column>
      <column caption='New Online Restaurants (Total)' datatype='integer' name='[Calculation_3672967026324029441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[new_online_restaurants_total_monthly]' />
      </column>
      <column caption='Dummy 1' datatype='integer' default-format='*#,##0.000;-#,##0.000;-' name='[Calculation_3786190287120756737]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Successful Orders - OD' datatype='integer' default-format='p0.00%' name='[Calculation_3786190288629309457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[successful_orders_od]' />
      </column>
      <column caption='Successful Orders - Pickup% - Target' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_3786190288629555218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[successful_orders_pickup] / [successful_orders]' />
      </column>
      <column caption='Successful Orders - LS - Target ' datatype='integer' hidden='true' name='[Calculation_3786190288632754198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders - OD LS] + [Orders - VDPU LS]' />
      </column>
      <column caption='vendor_vf_discount_penetration' datatype='real' name='[Calculation_469781798335254528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([number_of_vendors_vf_discount_monthly]) + AVG([total_only_joker_vendors_monthly]))/AVG([total_active_vendors_monthly])' />
      </column>
      <column caption='Banner I' datatype='string' name='[Calculation_5277374343916171267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;DH Europe Monthly KPI&quot;' />
      </column>
      <column caption='Successful Orders - OD%' datatype='real' name='[Calculation_5277374344003272728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
      </column>
      <column caption='Successful Orders - Pickup%' datatype='real' name='[Calculation_5277374344004399137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [order_month]: SUM([successful_orders_pickup]) / SUM([total_number_of_successful_orders])}' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_5277374344598286378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_gfv_eur] / [total_number_of_successful_orders]' />
      </column>
      <column caption='Revenue' datatype='real' name='[Calculation_5277374344612036660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[commission_revenue_eur] + [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]&#10;//+ ZN([delivery_fee_od_eur])' />
      </column>
      <column caption='AVG DF' datatype='real' name='[Calculation_5277374344708214845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[delivery_fee_od_eur] / [Calculation_3786190288629309457]' />
      </column>
      <column caption='Reactivated from Churn - RR' datatype='real' hidden='true' name='[Calculation_6194982782873493505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reactivated_from_churn])*(7/[Calculation_6194982782874845189])' />
      </column>
      <column caption='Days left in the week' datatype='integer' hidden='true' name='[Calculation_6194982782874845189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ISOWEEKDAY(TODAY())-1' />
