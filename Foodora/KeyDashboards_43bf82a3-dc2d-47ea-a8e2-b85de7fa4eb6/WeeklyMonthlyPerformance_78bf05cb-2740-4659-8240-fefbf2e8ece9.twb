              <calculation class='tableau' formula='//[Commission Revenue Eur] + ZN([Delivery Fee Eur])&#10; [commission_revenue_eur] + [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]' />
            </column>
            <column caption='Revenue WoW' datatype='real' name='[GMV WoW (copy)_5515220700250660875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Commission Revenue Eur (copy)_5515220700249513994])) - LOOKUP(ZN(SUM([Commission Revenue Eur (copy)_5515220700249513994])), -1)) / ABS(LOOKUP(ZN(SUM([Commission Revenue Eur (copy)_5515220700249513994])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX WEEK AUX' datatype='boolean' name='[INDEX WEEK (copy)_140033822718402568]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
