            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Signed restos LY MTD growth %' datatype='real' name='[Signed restos MTD growth % (copy)_4549057841458454528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;(SUM(iif([Calculation_21673596520853506], [signed_restos], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [signed_restos], 0)))-1 &gt;= 5&#10;THEN NULL&#10;ELSE&#10;(SUM(iif([Calculation_21673596520853506], [signed_restos], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [signed_restos], 0)))-1&#10;END' />
            </column>
