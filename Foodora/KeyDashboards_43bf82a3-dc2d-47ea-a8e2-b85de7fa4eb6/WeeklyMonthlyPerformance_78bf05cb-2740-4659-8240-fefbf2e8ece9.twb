            <column caption='Successful Orders Restaurants MP LY QTD growth %' datatype='real' name='[Successful Orders OD LY QTD growth % (copy)_2915940025926995973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM(iif([MTD (copy)_1931270242855276544], [count_successful_orders_restaurants_mp], 0))/&#10;SUM(iif([PQTD (copy)_1931270242855862274], [count_successful_orders_restaurants_mp], 0)))-1 &gt; 5&#10;THEN NULL&#10;ELSE&#10;(SUM(iif([MTD (copy)_1931270242855276544], [count_successful_orders_restaurants_mp], 0))/&#10;SUM(iif([PQTD (copy)_1931270242855862274], [count_successful_orders_restaurants_mp], 0)))-1&#10;END' />
            </column>
