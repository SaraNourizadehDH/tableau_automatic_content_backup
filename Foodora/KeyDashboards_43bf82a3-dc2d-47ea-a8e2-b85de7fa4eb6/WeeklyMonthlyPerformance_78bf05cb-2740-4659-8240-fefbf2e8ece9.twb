            <column datatype='real' name='[df_service_fee_exclude_vat_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[df_user_paid_exclude_vat_eur]' role='measure' type='quantitative' />
            <column-instance column='[MTD Growth Title (copy)_1931270242856280068]' derivation='None' name='[none:MTD Growth Title (copy)_1931270242856280068:nk]' pivot='key' type='nominal' />
