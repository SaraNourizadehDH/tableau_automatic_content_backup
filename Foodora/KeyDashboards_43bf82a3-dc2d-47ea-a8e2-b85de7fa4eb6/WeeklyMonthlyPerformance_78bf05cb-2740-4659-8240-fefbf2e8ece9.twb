          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Vendors w VFD RR M' datatype='real' name='[Orders Late &gt; 10 RR M (copy)_496803341152333898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Successful Orders OD RR (copy)_2744381027666284546]: [Orders With VFD % (copy)_496803341111009307]})' />
            </column>
            <column caption='Vendors w VFD RR MoM growth %' datatype='real' name='[Orders Late &gt; 10 RR MoM growth % (copy)_496803341152948300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Late &gt; 10 RR M (copy)_496803341152333898] -&#10;(AVG(iif([PMTD (copy)_2744381027682492421], [number_of_vendors_vf_discount_weekly], 0)) + AVG(iif([PMTD (copy)_2744381027682492421], [total_only_joker_vendors_weekly], 0))) / AVG(iif([PMTD (copy)_2744381027682492421], [total_active_vendors_weekly], 0))) * 100' />
            </column>
            <column caption='Vendors With VFD %' datatype='real' name='[Orders With VFD % (copy)_496803341111009307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([number_of_vendors_vf_discount_weekly]) + AVG([total_only_joker_vendors_weekly]))/AVG([total_active_vendors_weekly])' />
            </column>
            <column caption='PM' datatype='boolean' name='[PMTD (copy)_2744381027682492421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-1' />
            </column>
            <column caption='Within Last 21 Days' datatype='boolean' name='[Successful Orders OD RR (copy)_2744381027666284546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-21' />
            </column>
            <column caption='RR MoM Title' datatype='string' name='[WoW Title  (copy)_6569414853212516355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR MoM&quot;' />
              <aliases>
                <alias key='&quot;RR MoM&quot;' value='Monthly RR MoM' />
              </aliases>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
