            <column caption='Order Delay Over 10 Min Count' datatype='integer' name='[order_delay_over_10_min_count]' role='measure' type='quantitative' />
            <column-instance column='[Avg DT MTD growth % (copy)_2387470757600051233]' derivation='User' name='[usr:Avg DT MTD growth % (copy)_2387470757600051233:qk]' pivot='key' type='quantitative' />
