              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Orders Late  &gt; 20 LY QTD growth %' datatype='real' name='[Orders Late  &gt; 20 QTD growth % (copy)_4549057841489657891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([MTD (copy)_1931270242855276544], [order_delay_over_20_min_count], 0))/&#10;SUM(iif([MTD (copy)_1931270242855276544], [order_delay_cnt], 0)))&#10;-&#10;(SUM(iif([PQTD (copy)_1931270242855862274], [order_delay_over_20_min_count], 0))/&#10;SUM(iif([PQTD (copy)_1931270242855862274], [order_delay_cnt], 0))))&#10;*100' />
