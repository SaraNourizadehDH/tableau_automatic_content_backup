      <column caption='Active Customers PMTD' datatype='integer' name='[Calculation_1238419566430437376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF &#10;DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [au_previous_month_cumulative_cum_distinct_cnt] END)' />
      </column>
