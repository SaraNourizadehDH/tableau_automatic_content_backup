            <column caption='Total Voucher Value Eur' datatype='real' name='[total_voucher_value_eur]' role='measure' type='quantitative' />
            <column-instance column='[Reactivated From Churn YTD growth % (copy)_2321042665533894687]' derivation='User' name='[usr:Reactivated From Churn YTD growth % (copy)_2321042665533894687:qk]' pivot='key' type='quantitative' />
