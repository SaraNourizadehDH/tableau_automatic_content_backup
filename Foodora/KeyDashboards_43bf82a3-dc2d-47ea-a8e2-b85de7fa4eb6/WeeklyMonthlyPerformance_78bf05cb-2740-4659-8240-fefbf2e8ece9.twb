            <column caption='Successful Orders' datatype='integer' name='[total_number_of_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Successful Orders QTD growth % (copy)_1931270242856693766]' derivation='User' name='[usr:Successful Orders QTD growth % (copy)_1931270242856693766:qk]' pivot='key' type='quantitative' />
