      <column caption='AVG DF RR MoM growth %' datatype='real' name='[AFV RR MoM growth % (copy)_496803341078147074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Delivery Fee Od Eur (copy)_6996060553082314753])/SUM(iif([Calculation_21673596520853506], [orders_month_rr], 0)))/&#10;(SUM(iif([PMTD (copy)_2744381027682492421], [delivery_fee_od_eur], 0)) / SUM(iif([PMTD (copy)_2744381027682492421], [total_number_of_successful_orders], 0))) - 1' />
      </column>
      <column caption='Orders w VFD RR MoM growth %' datatype='real' name='[AFV RR MoM growth % (copy)_496803341105668117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((([Delivery Fee Od RR M (copy)_496803341105418260])/SUM(iif([Calculation_21673596520853506], [orders_month_rr] - [orders_dmart_month_rr], 0))) - &#10;(SUM(iif([PMTD (copy)_2744381027682492421], [orders_with_vfd_dash_definition], 0)) / SUM(iif([PMTD (copy)_2744381027682492421], [total_number_of_successful_orders] - [count_successful_orders_dmart], 0)))) * 100' />
      </column>
      <column caption='Avg DT RR MoM growth %' datatype='real' name='[AFV RR MoM growth % (copy)_496803341124653089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders w VFD MTD growth pp (copy)_496803341124071456]/&#10;(SUM(iif([PMTD (copy)_2744381027682492421], [actual_delivery_time_sum], 0)) / SUM(iif([PMTD (copy)_2744381027682492421], [actual_delivery_time_cnt], 0))) - 1' />
      </column>
      <column caption='AVG DF RR YoY growth %' datatype='real' name='[AFV RR YoY growth % (copy)_496803341078876164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Commission Revenue RR Y (copy)_6996060553086894083] /[Successful Orders Dmart RR Y (copy)_5515220700244832259]) / &#10;(SUM(iif([PM (copy)_2387470757550784515], [delivery_fee_od_eur], 0)) / SUM(iif([PM (copy)_2387470757550784515], [total_number_of_successful_orders], 0))) - 1' />
      </column>
      <column caption='Orders w VFD RR YoY growth %' datatype='real' name='[AFV RR YoY growth % (copy)_496803341108330522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Delivery Fee OD RR Y (copy)_496803341107515415]/([Successful Orders Dmart RR Y (copy)_5515220700244832259] + [Successful Orders OD RR Y (copy)_2387470757554647048])) -&#10;(SUM(iif([PM (copy)_2387470757550784515], [orders_with_vfd_dash_definition], 0)) / SUM(iif([PM (copy)_2387470757550784515], [total_number_of_successful_orders] - [count_successful_orders_dmart], 0)))) * 100' />
      </column>
