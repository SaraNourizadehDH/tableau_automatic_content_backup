            <column caption='Successful Orders Dmart RR MTD' datatype='real' name='[Successful Orders Dmart MTD (copy)_122441650355429404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_21673596520853506], [Successful Orders OD RR (copy)_1395975151756570627], 0))' />
            </column>
            <column caption='Successful Orders Dmart RR M' datatype='real' name='[Successful Orders OD RR (copy)_1395975151756570627]' role='measure' type='quantitative'>
