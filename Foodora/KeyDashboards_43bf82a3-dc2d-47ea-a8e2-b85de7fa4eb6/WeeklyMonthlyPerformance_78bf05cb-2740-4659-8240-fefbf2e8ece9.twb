    <worksheet name='CVR RR MoM'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
          </datasources>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='CVR RR M' datatype='real' name='[Orders Late &gt; 10 RR M (copy)_2082703780653441043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Successful Orders OD RR (copy)_2744381027666284546]: [Successful Orders MP% (copy)_2082703780651425807]})' />
            </column>
            <column caption='CVR RR MoM growth %' datatype='real' name='[Orders Late &gt; 10 RR MoM growth % (copy)_2082703780653522964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Late &gt; 10 RR M (copy)_2082703780653441043] - &#10;(SUM(iif([PMTD (copy)_2744381027682492421], [transaction_perseus], 0)) / SUM(iif([PMTD (copy)_2744381027682492421], [sessions_perseus], 0)))) * 100' />
            </column>
            <column caption='PM' datatype='boolean' name='[PMTD (copy)_2744381027682492421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-1' />
            </column>
            <column caption='CVR' datatype='real' name='[Successful Orders MP% (copy)_2082703780651425807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction_perseus]) / SUM([sessions_perseus])' />
            </column>
            <column caption='Within Last 21 Days' datatype='boolean' name='[Successful Orders OD RR (copy)_2744381027666284546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-21' />
            </column>
            <column caption='RR MoM Title' datatype='string' name='[WoW Title  (copy)_6569414853212516355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR MoM&quot;' />
              <aliases>
                <alias key='&quot;RR MoM&quot;' value='Monthly RR MoM' />
              </aliases>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[WoW Title  (copy)_6569414853212516355]' derivation='None' name='[none:WoW Title  (copy)_6569414853212516355:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Order Day' datatype='date' name='[order_day]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[sessions_perseus]' role='measure' type='quantitative' />
            <column datatype='integer' name='[transaction_perseus]' role='measure' type='quantitative' />
            <column-instance column='[Orders Late &gt; 10 RR MoM growth % (copy)_2082703780653522964]' derivation='User' name='[usr:Orders Late &gt; 10 RR MoM growth % (copy)_2082703780653522964:qk]' pivot='key' type='quantitative' />
