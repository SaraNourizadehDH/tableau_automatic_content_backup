              <calculation class='tableau' formula='(ZN(SUM([Sessions (copy)_2082703780698632227])) - LOOKUP(ZN(SUM([Sessions (copy)_2082703780698632227])), -1)) / ABS(LOOKUP(ZN(SUM([Sessions (copy)_2082703780698632227])), -1))'>
