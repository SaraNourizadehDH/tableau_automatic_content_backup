            <column caption='Successful Orders Pickup% MTD YoY growth pp' datatype='real' name='[Successful Orders Pickup% MTD growth pp (copy)_122441650358583329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//({ FIXED [Global Entity Id], [MTD]: SUM([Successful Orders Pickup])/ SUM([Successful Orders])} - &#10;//{ FIXED [Global Entity Id], [LY MTD]: SUM([Successful Orders Pickup])/ SUM([Successful Orders])}) * 100&#10;&#10;&#10;(SUM(iif([Calculation_21673596520853506], [successful_orders_pickup], 0)) / SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0)))*100&#10;-&#10;(SUM(iif([MTD (copy)_1931270242863067149], [successful_orders_pickup], 0)) / SUM(iif([MTD (copy)_1931270242863067149], [total_number_of_successful_orders], 0)))*100' />
            </column>
