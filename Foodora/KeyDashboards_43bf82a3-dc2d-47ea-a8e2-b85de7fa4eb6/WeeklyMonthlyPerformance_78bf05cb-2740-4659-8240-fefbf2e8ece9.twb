              <calculation class='tableau' formula='INT(SUM(iif([MTD (copy)_6569414853215997956], [orders_with_vfd_dash_definition], 0))&#10;+ SUM(iif([Within Last 21 Days (copy)_2387470757548802048], [orders_with_vfd_dash_definition], 0))&#10;/ 60&#10;* (365 - DATEPART(&apos;dayofyear&apos;, TODAY()-1)))' />
            </column>
