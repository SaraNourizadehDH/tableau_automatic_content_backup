              <calculation class='tableau' formula='((SUM(iif([MTD (copy)_1931270242855276544], [seamless_orders_od], 0))/&#10;SUM(iif([MTD (copy)_1931270242855276544], [seamless_table_all_orders], 0)))&#10;-&#10;(SUM(iif([PQTD (copy)_1931270242855862274], [seamless_orders_od], 0))/&#10;SUM(iif([PQTD (copy)_1931270242855862274], [seamless_table_all_orders], 0))))&#10;*100' />
