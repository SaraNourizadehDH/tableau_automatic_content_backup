              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Orders Late &gt;20 YTD growth %' datatype='real' name='[Orders Late &gt;10 YTD growth % (copy)_2082703780639363086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([MTD (copy)_6569414853215997956], [order_delay_over_20_min_count], 0))/&#10;SUM(iif([MTD (copy)_6569414853215997956], [order_delay_cnt], 0)))&#10;-&#10;(SUM(iif([PMTD (copy)_6569414853216116741], [order_delay_over_20_min_count], 0))/&#10;SUM(iif([PMTD (copy)_6569414853216116741], [order_delay_cnt], 0))))&#10;*100' />
