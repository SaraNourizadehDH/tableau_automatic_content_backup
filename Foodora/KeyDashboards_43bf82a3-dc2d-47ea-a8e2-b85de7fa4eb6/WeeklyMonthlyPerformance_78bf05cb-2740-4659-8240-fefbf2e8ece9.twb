  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/WeeklyReport-WIP/Definitions?rev=' id='Definitions' path='/t/Foodora/workbooks/WeeklyReport-WIP' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run fontcolor='#df1067' fontname='Tableau Bold' fontsize='24'>Definitions</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Bold' fontsize='12'>MTD MoM</run>
              <run fontcolor='#333333' fontsize='12'> - </run>
              <run fontcolor='#000000' fontsize='12'>current month to date values vs previous month to same date</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>RR MoM</run>
              <run fontcolor='#000000' fontsize='12'> - RR for current month vs complete previous month actuals; RR is calculated as a sum of month to date value and forecast to the end of the month (based on last 21 days performance) </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>YTD YoY</run>
              <run fontcolor='#000000' fontsize='12'> - current year to date values vs previous year to same date</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>RR YoY</run>
              <run fontcolor='#000000' fontsize='12'> - RR for current year vs complete previous year actuals; RR is calculated as a sum of year to date value and forecast to the end of the year (based on last 60 days performance) </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Sessions</run>
              <run fontcolor='#000000' fontsize='12'> and </run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Revenue</run>
              <run fontcolor='#000000' fontsize='12'> are reported with 1 day lag and therefore are complete for the previous week only on Tuesday</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='352' type-v2='layout-basic' w='100000' x='0' y='0'>
