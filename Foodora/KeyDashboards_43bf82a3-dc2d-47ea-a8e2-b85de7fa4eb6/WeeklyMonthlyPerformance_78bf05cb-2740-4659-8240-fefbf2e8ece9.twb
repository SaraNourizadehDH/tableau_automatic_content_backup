              <calculation class='tableau' formula='(ZN(AVG([Total Gfv Eur (copy)_5515220700253798419])) - LOOKUP(ZN(AVG([Total Gfv Eur (copy)_5515220700253798419])), -52)) / ABS(LOOKUP(ZN(AVG([Total Gfv Eur (copy)_5515220700253798419])), -52))&#10;&#10;//LOOKUP(ZN(SUM([Successful Orders])), -52)'>
