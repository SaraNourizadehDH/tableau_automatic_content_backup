              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Within Last 21 Days (copy)_2387470757548802048]: [Successful Orders MP% (copy)_2082703780651425807]})' />
            </column>
            <column caption='CVR RR YoY growth %' datatype='real' name='[Orders Late &gt; 10 RR YoY growth % (copy)_2082703780653801494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Late &gt; 10 RR Y (copy)_2082703780653670421] - &#10;(SUM(iif([PM (copy)_2387470757550784515], [transaction], 0)) / SUM(iif([PM (copy)_2387470757550784515], [sessions], 0)))) * 100' />
            </column>
            <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,today()))' />
