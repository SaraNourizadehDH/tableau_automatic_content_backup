          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='MP Fail Rate RR Y' datatype='real' name='[OD Fail Rate RR Y (copy)_496803341144735807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Within Last 21 Days (copy)_2387470757548802048]: AVG([mp_fail_rate])})' />
            </column>
            <column caption='MP Fail Rate RR YoY growth pp' datatype='real' name='[OD Fail Rate RR YoY growth pp (copy)_496803341144911937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([OD Fail Rate RR Y (copy)_496803341144735807] -&#10;AVG({ FIXED [global_entity_id], [PM (copy)_2387470757550784515]: AVG([mp_fail_rate])})) * 100' />
            </column>
            <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,today()))' />
