              <calculation class='tableau' formula='(ZN(SUM([Commission Revenue Eur (copy)_5515220700249513994])) - LOOKUP(ZN(SUM([Commission Revenue Eur (copy)_5515220700249513994])), -52)) / ABS(LOOKUP(ZN(SUM([Commission Revenue Eur (copy)_5515220700249513994])), -52))&#10;&#10;//LOOKUP(ZN(SUM([Successful Orders])), -52)'>
                <table-calc ordering-type='Rows' />
