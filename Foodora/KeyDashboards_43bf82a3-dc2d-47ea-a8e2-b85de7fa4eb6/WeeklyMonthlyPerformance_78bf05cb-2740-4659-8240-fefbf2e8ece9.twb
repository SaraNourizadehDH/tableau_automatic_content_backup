            <column caption='INDEX WEEK AUX' datatype='boolean' name='[INDEX WEEK (copy)_140033822718402568]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW Title ' datatype='string' name='[MoM Title (copy)_21673596845686793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;W&quot; + STR(DATEPART(&apos;week&apos;, DATEADD(&apos;week&apos;, 0,[Parameters].[Parameter 1]))) + &quot;/ W&quot; + STR(DATEPART(&apos;week&apos;, DATEADD(&apos;week&apos;, -1,[Parameters].[Parameter 1])))' />
              <aliases>
                <alias key='&quot;W51/ W50&quot;' value='LW              WoW' />
              </aliases>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Week Filter' datatype='boolean' name='[Order Week (copy)_5361464990307966979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Order Day (copy)_5361464990301970432] &gt;= DATEADD(&apos;week&apos;,-4,[Parameters].[Parameter 1])&#10;AND&#10;[Order Day (copy)_5361464990301970432] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Orders Late &gt; 20' datatype='real' name='[Orders Late &gt; 10 (copy)_2082703780635082756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_delay_over_20_min_count])/SUM([order_delay_cnt]))' />
            </column>
            <column caption='Orders Late &gt;20 WoW' datatype='real' name='[Orders Late &gt;10 WoW (copy)_2082703780639281165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Orders Late &gt; 10 (copy)_2082703780635082756]) - LOOKUP(ZN([Orders Late &gt; 10 (copy)_2082703780635082756]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
