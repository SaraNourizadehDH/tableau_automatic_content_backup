            <column caption='Successful Orders Restraurants OD%' datatype='real' name='[Successful Orders Od (copy)_6259370166296219649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], DATETRUNC(&apos;iso-week&apos;, [order_day]): SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
            </column>
            <column caption='Successful Orders OD% WoW' datatype='real' name='[Successful Orders WoW (copy)_6259370166304690179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([Successful Orders Od (copy)_6259370166296219649])) - LOOKUP(ZN(AVG([Successful Orders Od (copy)_6259370166296219649])), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
