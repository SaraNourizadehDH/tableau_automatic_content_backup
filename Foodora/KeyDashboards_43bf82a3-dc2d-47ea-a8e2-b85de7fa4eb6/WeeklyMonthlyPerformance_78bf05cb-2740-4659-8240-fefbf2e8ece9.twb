            <column datatype='integer' name='[sessions_perseus]' role='measure' type='quantitative' />
            <column-instance column='[Successful Orders Restaurants MP RR MoM growth % (copy)_496803341169373270]' derivation='User' name='[usr:Successful Orders Restaurants MP RR MoM growth % (copy)_496803341169373270:qk]' pivot='key' type='quantitative' />
