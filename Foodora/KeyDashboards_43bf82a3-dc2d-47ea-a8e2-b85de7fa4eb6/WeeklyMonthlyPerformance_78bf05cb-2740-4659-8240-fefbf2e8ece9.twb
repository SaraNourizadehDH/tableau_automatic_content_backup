            <column caption='Avg DT RR MoM growth %' datatype='real' name='[AFV RR MoM growth % (copy)_496803341124653089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders w VFD MTD growth pp (copy)_496803341124071456]/&#10;(SUM(iif([PMTD (copy)_2744381027682492421], [actual_delivery_time_sum], 0)) / SUM(iif([PMTD (copy)_2744381027682492421], [actual_delivery_time_cnt], 0))) - 1' />
            </column>
            <column caption='Avg DT RR M' datatype='real' name='[Orders w VFD MTD growth pp (copy)_496803341124071456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Successful Orders OD RR (copy)_2744381027666284546]: [Successful Orders (copy)_2387470757582307340]})' />
            </column>
            <column caption='PM' datatype='boolean' name='[PMTD (copy)_2744381027682492421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-1' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Successful Orders (copy)_2387470757582307340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_sum])/SUM([actual_delivery_time_cnt])' />
            </column>
            <column caption='Within Last 21 Days' datatype='boolean' name='[Successful Orders OD RR (copy)_2744381027666284546]' role='dimension' type='nominal'>
