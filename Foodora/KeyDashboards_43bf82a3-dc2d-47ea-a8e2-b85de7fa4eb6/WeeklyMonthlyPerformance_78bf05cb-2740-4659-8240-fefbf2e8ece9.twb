              <calculation class='tableau' formula='IF &#10;(SUM(iif([MTD (copy)_1931270242855276544], [reactivated_from_churn], 0))/&#10;SUM(iif([PQTD (copy)_1931270242855862274], [reactivated_from_churn], 0)))-1 &gt;= 5&#10;THEN NULL&#10;ELSE&#10;(SUM(iif([MTD (copy)_1931270242855276544], [reactivated_from_churn], 0))/&#10;SUM(iif([PQTD (copy)_1931270242855862274], [reactivated_from_churn], 0)))-1&#10;END' />
