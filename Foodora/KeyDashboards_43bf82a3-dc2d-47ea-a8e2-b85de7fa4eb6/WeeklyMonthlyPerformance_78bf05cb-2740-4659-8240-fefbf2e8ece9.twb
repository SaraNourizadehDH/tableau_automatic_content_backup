              <calculation class='tableau' formula='IF &#10;(AVG(iif([Calculation_21673596520853506], [online_local_shops_weekly], 0))/&#10;AVG(iif([MTD (copy)_1931270242863067149], [online_local_shops_weekly], 0)))-1 &gt;= 5&#10;THEN NULL&#10;ELSE&#10;(AVG(iif([Calculation_21673596520853506], [online_local_shops_weekly], 0))/&#10;AVG(iif([MTD (copy)_1931270242863067149], [online_local_shops_weekly], 0)))-1&#10;END' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
