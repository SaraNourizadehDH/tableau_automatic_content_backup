              <calculation class='tableau' formula='&quot;QTD &quot; + &#10;STR(DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1]))) + &quot;    &quot; +&quot;        QTD &quot;+ &#10;STR(DATEPART(&apos;year&apos;, [Parameters].[Parameter 1]))' />
              <aliases>
                <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
              </aliases>
            </column>
            <column caption='QTD' datatype='boolean' name='[MTD (copy)_1931270242855276544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, TODAY() - 1)&#10;&#10; DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= (TODAY()-1) &#10;//THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= ([Reporting Week]) THEN TRUE&#10;//ELSE False END' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='LY QTD' datatype='boolean' name='[PQTD (copy)_1931270242855862274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF &#10;//[Max Order Week] = [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, TODAY()-1)&#10;//THEN TRUE&#10;//ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//THEN TRUE&#10;//END&#10;&#10;&#10;[order_day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]))&#10;AND [order_day] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1])&#10;OR (&#10;DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]))) &#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10;//AND [Order Day] &lt;= [Reporting Week]&#10; //or (DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10; //and DATEPART(&apos;week&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))' />
            </column>
            <column caption='Successful Orders MP% QTD ' datatype='real' name='[Successful Orders MP% LY QTD  (copy)_103793933169152010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{ FIXED [Global Entity Id], [QTD]: SUM([Successful Orders Mp])/ SUM([Successful Orders])}&#10;&#10;SUM(iif([MTD (copy)_1931270242855276544], [successful_orders_mp], 0)) / &#10;SUM(iif([MTD (copy)_1931270242855276544], [total_number_of_successful_orders], 0))' />
            </column>
            <column caption='Successful Orders MP% LY QTD ' datatype='real' name='[Successful Orders MP% LY QTD growth pp (copy)_103793933168922633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{ FIXED [Global Entity Id], [LY QTD]: SUM([Successful Orders Mp])/ SUM([Successful Orders])}&#10;&#10;SUM(iif([PQTD (copy)_1931270242855862274], [successful_orders_mp], 0)) / &#10;SUM(iif([PQTD (copy)_1931270242855862274], [total_number_of_successful_orders], 0))' />
