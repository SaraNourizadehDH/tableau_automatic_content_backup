          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='YTD' datatype='boolean' name='[MTD (copy)_6569414853215997956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;&#10;&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week])&#10;//and &#10;//[Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and  DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week]) and [Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE END' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,today()))' />
            </column>
            <column caption='RR YoY Title' datatype='string' name='[RR MoM Title (copy)_2387470757551210500]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR YoY&quot;' />
            </column>
            <column caption='Seamless Orders % RR YoY growth pp' datatype='real' name='[Seamless Orders % RR MoM growth pp (copy)_496803341142122553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Successful Orders OD RR Y (copy)_496803341141217335]/[Successful Orders OD RR (copy)_2387470757549277185]  - &#10;SUM(iif([PM (copy)_2387470757550784515], [seamless_orders_od], 0)) / SUM(iif([PM (copy)_2387470757550784515], [successful_orders_od], 0))) * 100' />
            </column>
            <column caption='Successful Orders OD RR Y' datatype='integer' name='[Successful Orders OD RR (copy)_2387470757549277185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(SUM(iif([MTD (copy)_6569414853215997956], [successful_orders_od], 0))&#10;+ SUM(iif([Within Last 21 Days (copy)_2387470757548802048], [successful_orders_od], 0))&#10;/ 60&#10;* (365 - DATEPART(&apos;dayofyear&apos;, TODAY()-1)))' />
            </column>
            <column caption='Seamless Orders OD RR Y' datatype='integer' name='[Successful Orders OD RR Y (copy)_496803341141217335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(SUM(iif([MTD (copy)_6569414853215997956], [seamless_orders_od], 0))&#10;+ SUM(iif([Within Last 21 Days (copy)_2387470757548802048], [seamless_orders_od], 0))&#10;/ 60&#10;* (365 - DATEPART(&apos;dayofyear&apos;, TODAY()-1)))' />
            </column>
            <column caption='Within Last 60 Days' datatype='boolean' name='[Within Last 21 Days (copy)_2387470757548802048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-60' />
