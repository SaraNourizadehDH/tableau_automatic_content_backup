    <worksheet name='Avg PDT WoW'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Avg PDT' datatype='real' name='[Avg DT (copy)_2387470757589749783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_delivery_time_sum])/SUM([promised_delivery_time_cnt])' />
            </column>
            <column caption='Avg PDT WoW' datatype='real' name='[Avg DT WoW (copy)_2387470757590814745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Avg DT (copy)_2387470757589749783]) - LOOKUP(ZN([Avg DT (copy)_2387470757589749783]), -1)) / ABS(LOOKUP(ZN([Avg DT (copy)_2387470757589749783]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX WEEK AUX' datatype='boolean' name='[INDEX WEEK (copy)_140033822718402568]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW Title ' datatype='string' name='[MoM Title (copy)_21673596845686793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;W&quot; + STR(DATEPART(&apos;week&apos;, DATEADD(&apos;week&apos;, 0,[Parameters].[Parameter 1]))) + &quot;/ W&quot; + STR(DATEPART(&apos;week&apos;, DATEADD(&apos;week&apos;, -1,[Parameters].[Parameter 1])))' />
              <aliases>
                <alias key='&quot;W51/ W50&quot;' value='LW              WoW' />
              </aliases>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
