            <column-instance column='[Acquisitions QTD (copy)_132574750954954799]' derivation='User' name='[usr:Acquisitions QTD (copy)_132574750954954799:qk]' pivot='key' type='quantitative' />
            <column-instance column='[GMV QTD (copy)_132574750861291526]' derivation='User' name='[usr:GMV QTD (copy)_132574750861291526:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Successful Orders QTD  (copy)_132574750861172741]' derivation='User' name='[usr:Successful Orders QTD  (copy)_132574750861172741:qk]' pivot='key' type='quantitative' />
