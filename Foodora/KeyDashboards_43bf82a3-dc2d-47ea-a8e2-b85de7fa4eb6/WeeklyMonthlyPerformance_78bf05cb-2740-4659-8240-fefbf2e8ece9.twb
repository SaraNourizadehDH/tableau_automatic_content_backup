            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Acquisitions MTD growth %' datatype='real' name='[Successful Orders Dmart MTD growth % (copy)_2076511279471939591]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [main_total_new_customer_count], 0))/&#10;SUM(iif([Calculation_21673596521619459], [main_total_new_customer_count], 0)))-1' />
