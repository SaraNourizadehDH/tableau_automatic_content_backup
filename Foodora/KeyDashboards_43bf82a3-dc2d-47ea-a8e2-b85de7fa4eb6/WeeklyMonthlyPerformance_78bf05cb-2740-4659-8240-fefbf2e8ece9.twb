              <calculation class='tableau' formula='//[Commission Revenue Eur] + ZN([Delivery Fee Eur])&#10; [commission_revenue_eur] + [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]' />
