      <column caption='Frequency Weekly' datatype='real' name='[AFV (copy)_2321042665522323470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_number_of_successful_orders]) / AVG([weekly_total_active_customer_count])' />
      </column>
      <column caption='avg DF LW YoY' datatype='real' name='[AFV LW YoY (copy) (copy)_132574750910230555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(AVG([Successful Orders YTD growth % (copy)_5515220700256469015])) - LOOKUP(ZN(AVG([Successful Orders YTD growth % (copy)_5515220700256469015])), -52)) / ABS(LOOKUP(ZN(AVG([Successful Orders YTD growth % (copy)_5515220700256469015])), -52))&#10;&#10;//LOOKUP(ZN(SUM([Successful Orders])), -52)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AFV QTD growth %' datatype='real' name='[AFV LY MTD growth % (copy)_3966334270599151624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(SUM(iif([QTD], [AFV], 0))/&#10;//SUM(iif([PQTD], [AFV], 0)))-1&#10;&#10;&#10;((sum(iif([MTD (copy)_1931270242855276544], [total_gfv_eur], 0)) / &#10;sum(iif([MTD (copy)_1931270242855276544], [total_number_of_successful_orders], 0))) / &#10;(sum(iif([MTD (copy)_1931270242855424001], [total_gfv_eur], 0)) / &#10;sum(iif([MTD (copy)_1931270242855424001], [total_number_of_successful_orders], 0))))-1' />
