              <calculation class='tableau' formula='//(SUM(iif([YTD], [AVG DF], 0))/&#10;//SUM(iif([PYTD], [AVG DF], 0)))-1&#10;&#10;&#10;((sum(iif([MTD (copy)_6569414853215997956], [delivery_fee_od_eur], 0)) / &#10;sum(iif([MTD (copy)_6569414853215997956], [successful_orders_od], 0))) / &#10;(sum(iif([PMTD (copy)_6569414853216116741], [delivery_fee_od_eur], 0)) / &#10;sum(iif([PMTD (copy)_6569414853216116741], [successful_orders_od], 0))))-1' />
            </column>
            <column caption='YTD Growth Title' datatype='string' name='[MTD  Growth Title (copy)_6569414853230739463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YTD YoY&quot;' />
              <aliases>
                <alias key='&quot;YTD YoY&quot;' value='YTD                        YoY' />
              </aliases>
            </column>
            <column caption='YTD' datatype='boolean' name='[MTD (copy)_6569414853215997956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;&#10;&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week])&#10;//and &#10;//[Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and  DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week]) and [Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE END' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='PYTD' datatype='boolean' name='[PMTD (copy)_6569414853216116741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, today()-1)&#10;//THEN TRUE&#10;//ELSEIF  &#10;//[Max Order Week] &lt;&gt; [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, [Reporting Week])&#10;//THEN TRUE &#10;//END&#10;&#10;&#10;&#10;DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;AND [order_day] &lt;= dateadd(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#10;or (DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))' />
            </column>
