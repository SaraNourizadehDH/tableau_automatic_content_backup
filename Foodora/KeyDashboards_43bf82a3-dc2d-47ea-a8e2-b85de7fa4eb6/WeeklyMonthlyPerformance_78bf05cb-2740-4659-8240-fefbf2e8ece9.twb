          <named-connection caption='BigQuery' name='bigquery.1eqkgr60pzle461exbcsa1depb4e'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata EU Production' schema='bl_europe' server-oauth='' username='berker.yuruktumen@yemeksepeti.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='AND'>
              <expression op='='>
                <expression op='[weekly_report_main].[global_entity_id]' />
                <expression op='[Budget - month].[global_entity_id]' />
              </expression>
              <expression op='='>
                <expression op='[weekly_report_main].[order_day]' />
                <expression op='[Budget - month].[target_month]' />
              </expression>
            </expression>
          </clause>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='AND'>
                <expression op='='>
                  <expression op='[weekly_report_main].[global_entity_id]' />
                  <expression op='[weekly_monthly_mkt_mtd_qtd_ytd_kpi].[global_entity_id]' />
                </expression>
                <expression op='='>
                  <expression op='[weekly_report_main].[order_day]' />
                  <expression op='[weekly_monthly_mkt_mtd_qtd_ytd_kpi].[date]' />
                </expression>
              </expression>
            </clause>
            <relation join='left' type='join'>
              <clause type='join'>
                <expression op='AND'>
                  <expression op='='>
                    <expression op='[weekly_report_main].[global_entity_id]' />
                    <expression op='[RR - month].[global_entity_id]' />
                  </expression>
                  <expression op='='>
                    <expression op='[weekly_report_main].[order_day]' />
                    <expression op='[RR - month].[order_date]' />
                  </expression>
                </expression>
              </clause>
              <relation connection='bigquery.1eqkgr60pzle461exbcsa1depb4e' name='weekly_report_main' table='[dhh---analytics-eu.bl_europe].[weekly_report_main]' type='table' />
              <relation connection='bigquery.1eqkgr60pzle461exbcsa1depb4e' name='RR - month' type='text'>WITH countries as 
(
SELECT 
   order_date,
	 global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (
&quot;FP_SK&quot;,
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;HN_DK&quot;,
&quot;YS_TR&quot;)

group by 1,2 
),

total_with_TR AS
(
SELECT 
   order_date,
	&apos;total_with_TR&apos; global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (
&quot;FP_SK&quot;,
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;HN_DK&quot;,
&quot;YS_TR&quot;)
group by 1,2
),

total AS
(
SELECT 
   order_date,
	&apos;total&apos; global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (
&quot;FP_SK&quot;,
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;HN_DK&quot;)
group by 1,2
)

SELECT * FROM countries
UNION ALL 
SELECT * FROM total
UNION ALL 
SELECT * FROM total_with_TR</relation>
            </relation>
            <relation connection='bigquery.1eqkgr60pzle461exbcsa1depb4e' name='weekly_monthly_mkt_mtd_qtd_ytd_kpi' table='[dhh---analytics-eu.bl_europe].[weekly_monthly_mkt_mtd_qtd_ytd_kpi]' type='table' />
          </relation>
          <relation connection='bigquery.1eqkgr60pzle461exbcsa1depb4e' name='Budget - month' type='text'>WITH countries as 
(
SELECT 
  month as target_month,
	 global_entity_id,
	total_orders orders_month_budget,
  total_net_gmv gmv_eur_month_budget
FROM `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_ln_os_key_kpis_budget`
WHERE global_entity_id IN (
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;YS_TR&quot;)
and currency = &apos;EUR&apos; 
),

total_with_TR AS
(
SELECT 
   target_month,
	&apos;total_with_TR&apos; global_entity_id,
	sum(orders_month_budget) orders_month_budget,
  sum(gmv_eur_month_budget) gmv_eur_month_budget
FROM countries
WHERE global_entity_id IN (
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;YS_TR&quot;)
group by 1,2
),

total AS
(
SELECT 
   target_month,
	&apos;total&apos; global_entity_id,
	sum(orders_month_budget) orders_month_budget,
  sum(gmv_eur_month_budget) gmv_eur_month_budget
FROM countries
WHERE global_entity_id IN (
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;)
group by 1,2
)

SELECT * FROM countries
UNION ALL 
SELECT * FROM total
UNION ALL 
SELECT * FROM total_with_TR








