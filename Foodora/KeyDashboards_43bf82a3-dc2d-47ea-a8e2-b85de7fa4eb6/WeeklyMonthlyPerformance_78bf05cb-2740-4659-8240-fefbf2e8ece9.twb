            <column caption='Online LS WoW' datatype='real' name='[Online Restos WoW (copy)_496803341087375371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([online_local_shops_weekly])) - LOOKUP(ZN(AVG([online_local_shops_weekly])), -1)) / ABS(LOOKUP(ZN(AVG([online_local_shops_weekly])), -1))'>
                <table-calc ordering-type='Rows' />
