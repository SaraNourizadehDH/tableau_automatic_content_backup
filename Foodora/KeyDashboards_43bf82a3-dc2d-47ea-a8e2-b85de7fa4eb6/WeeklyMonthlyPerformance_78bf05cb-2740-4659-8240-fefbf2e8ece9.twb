            </column>
            <column caption='Sessions Existing Customer RR Y' datatype='integer' name='[Sessions New Visit RR Y (copy)_2082703780700356649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(SUM(iif([MTD (copy)_6569414853215997956], [Sessions (copy)_2082703780698632227], 0))&#10;+ SUM(iif([Within Last 21 Days (copy)_2387470757548802048], [Sessions (copy)_2082703780698632227], 0))&#10;/ 60&#10;* (365 - DATEPART(&apos;dayofyear&apos;, TODAY()-1)))' />
            </column>
            <column caption='Sessions Existing Customer RR YoY growth %' datatype='real' name='[Sessions New Visit RR YoY growth % (copy)_2082703780700581931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sessions New Visit RR Y (copy)_2082703780700356649]/&#10;SUM(iif([PM (copy)_2387470757550784515], [Sessions (copy)_2082703780698632227], 0)) - 1' />
            </column>
            <column caption='Within Last 60 Days' datatype='boolean' name='[Within Last 21 Days (copy)_2387470757548802048]' role='dimension' type='nominal'>
