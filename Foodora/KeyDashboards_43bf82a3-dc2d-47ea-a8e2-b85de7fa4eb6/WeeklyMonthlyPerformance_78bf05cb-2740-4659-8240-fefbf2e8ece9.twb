            </column>
            <column caption='Orders Late  &gt; 20 LY MTD growth %' datatype='real' name='[Orders Late  &gt; 20 MTD growth % (copy)_4549057841489764388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([Calculation_21673596520853506], [order_delay_over_20_min_count], 0))/&#10;SUM(iif([Calculation_21673596520853506], [order_delay_cnt], 0)))&#10;-&#10;(SUM(iif([MTD (copy)_1931270242863067149], [order_delay_over_20_min_count], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [order_delay_cnt], 0))))&#10;*100' />
            </column>
