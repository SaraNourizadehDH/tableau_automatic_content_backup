    <worksheet name='Frequecny LW YoY (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Frequency Weekly' datatype='real' name='[AFV (copy)_2321042665522323470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_number_of_successful_orders]) / AVG([weekly_total_active_customer_count])' />
            </column>
            <column caption='Frequency LW YoY' datatype='real' name='[Frequency WoW (copy)_132574750958288946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(ZN([AFV (copy)_2321042665522323470])) - LOOKUP(ZN([AFV (copy)_2321042665522323470]), -52)) / ABS(LOOKUP(ZN([AFV (copy)_2321042665522323470]), -52))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX WEEK AUX -1' datatype='boolean' name='[INDEX WEEK AUX (copy)_3648126839560245249]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Week Filter (copy)' datatype='boolean' name='[Week Filter (copy)_3648126839562969092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Order Day (copy)_5361464990301970432] &gt;= DATEADD(&apos;week&apos;,-53,[Parameters].[Parameter 1])&#10;AND&#10;[Order Day (copy)_5361464990301970432] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='LW YoY Title  Exec' datatype='string' name='[WoW Title  Exec (copy)_122441650322063368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;LW YoY&apos;' />
              <aliases>
                <alias key='&quot;LW YoY&quot;' value='LW            YoY' />
                <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
