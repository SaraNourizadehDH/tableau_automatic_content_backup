              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Successful Orders OD RR (copy)_2744381027666284546]: AVG([od_fail_rate])})' />
            </column>
            <column caption='OD Fail Rate RR MoM growth pp' datatype='real' name='[Active Riders RR MoM growth % (copy)_496803341143564348]' role='measure' type='quantitative'>
