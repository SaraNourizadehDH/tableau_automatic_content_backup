              <calculation class='tableau' formula='//({ FIXED [Global Entity Id], [QTD]: SUM([Successful Orders Pickup])/ SUM([Successful Orders])} - &#10;//{ FIXED [Global Entity Id], [PQTD]: SUM([Successful Orders Pickup])/ SUM([Successful Orders])}) * 100&#10;&#10;(SUM(iif([MTD (copy)_1931270242855276544], [successful_orders_pickup], 0)) / SUM(iif([MTD (copy)_1931270242855276544], [total_number_of_successful_orders], 0)))*100&#10;-&#10;(SUM(iif([MTD (copy)_1931270242855424001], [successful_orders_pickup], 0)) / SUM(iif([MTD (copy)_1931270242855424001], [total_number_of_successful_orders], 0)))*100' />
