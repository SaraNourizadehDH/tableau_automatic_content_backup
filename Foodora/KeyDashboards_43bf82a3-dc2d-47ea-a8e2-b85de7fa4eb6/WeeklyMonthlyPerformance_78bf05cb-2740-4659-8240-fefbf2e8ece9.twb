          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Avg PDT' datatype='real' name='[Avg DT (copy)_2387470757589749783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_delivery_time_sum])/SUM([promised_delivery_time_cnt])' />
            </column>
            <column caption='Avg PDT RR Y' datatype='real' name='[Avg DT RR Y (copy)_496803341127962661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Within Last 21 Days (copy)_2387470757548802048]: [Avg DT (copy)_2387470757589749783]})' />
            </column>
            <column caption='Avg PDT RR YoY growth %' datatype='real' name='[Avg DT RR YoY growth % (copy)_496803341128163367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg DT RR Y (copy)_496803341127962661]/&#10;(SUM(iif([PM (copy)_2387470757550784515], [promised_delivery_time_sum], 0)) / SUM(iif([PM (copy)_2387470757550784515], [promised_delivery_time_cnt], 0))) - 1' />
            </column>
            <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,today()))' />
            </column>
            <column caption='RR YoY Title' datatype='string' name='[RR MoM Title (copy)_2387470757551210500]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR YoY&quot;' />
            </column>
            <column caption='Within Last 60 Days' datatype='boolean' name='[Within Last 21 Days (copy)_2387470757548802048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-60' />
            </column>
            <column caption='RR MoM Title' datatype='string' name='[WoW Title  (copy)_6569414853212516355]' role='dimension' type='nominal'>
