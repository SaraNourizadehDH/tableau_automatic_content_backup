            <column caption='Online LS RR M' datatype='real' name='[Online Restos RR M (copy)_496803341149708358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Successful Orders OD RR (copy)_2744381027666284546]: AVG([online_local_shops_weekly])})' />
            </column>
            <column caption='Online LS RR MoM growth %' datatype='real' name='[Online Restos RR MoM growth % (copy)_496803341149962312]' role='measure' type='quantitative'>
