          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) &#10;    AND ([order_day] &lt;= [Parameters].[Parameter 1] OR DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;OR (DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1) AND YEAR([order_day]) = YEAR(TODAY()-1))' />
            </column>
            <column caption='DT &gt; 45 LY MTD growth %' datatype='real' name='[DT &gt; 45 MTD growth % (copy)_4549057841491439654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([Calculation_21673596520853506], [actual_delivery_time_over_45_min_cnt], 0))/&#10;SUM(iif([Calculation_21673596520853506], [actual_delivery_time_cnt], 0)))&#10;-&#10;(SUM(iif([MTD (copy)_1931270242863067149], [actual_delivery_time_over_45_min_cnt], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [actual_delivery_time_cnt], 0))))&#10;*100' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[MTD (copy)_1931270242863067149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//(DATETRUNC(&apos;week&apos;,([Order Day]))) = [Reporting Week]&#10;//AND DATETRUNC(&apos;month&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-1)) &#10; //  AND day([Order Day]) &lt;= day(TODAY()-1)&#10;  // AND month([Order Day]) &lt;= month(TODAY()-1)&#10;//OR &#10;&#10;&#10;&#10;&#10;&#10;&#10; DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#10;    AND ([order_day] &lt;= DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1])) &#10;//OR &#10; //(DATETRUNC(&apos;month&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,[Reporting Week]))&#10;//and&#10;//DATEPART(&apos;week&apos;, [Reporting Week]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) )))' />
            </column>
            <column caption='LY MTD Growth Title' datatype='string' name='[MTD Growth Title (copy)_1931270242864181263]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MTD YoY&quot;' />
              <aliases>
                <alias key='&quot;MTD YoY&quot;' value='MTD                  YoY' />
              </aliases>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Actual Delivery Time Cnt' datatype='integer' name='[actual_delivery_time_cnt]' role='measure' type='quantitative' />
            <column caption='Actual Delivery Time Over 45 Min Cnt' datatype='integer' name='[actual_delivery_time_over_45_min_cnt]' role='measure' type='quantitative' />
