    <worksheet name='Orders OD% Matrix'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Exec Week Filter' datatype='string' name='[Calculation_3648126839559774208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Order Day (copy)_5361464990301970432] = DATEADD(&apos;week&apos;,-52,[Parameters].[Parameter 1]) then &apos;LY last week&apos;&#10;ELSEIF &#10;[Order Day (copy)_5361464990301970432] = [Parameters].[Parameter 1] then &apos;TY last week&apos; else &apos;No&apos; end' />
            </column>
            <column caption='DATE(DATETRUNC(&apos;week&apos;, [Order Day], &apos;Monday&apos;))' datatype='date' name='[Calculation_5361464990308225028]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [order_day], &apos;Monday&apos;))' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Successful Orders Restraurants OD%' datatype='real' name='[Successful Orders Od (copy)_6259370166296219649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], DATETRUNC(&apos;iso-week&apos;, [order_day]): SUM([successful_orders_restaurants_od])/ SUM([count_successful_orders_restaurants] - [successful_orders_pickup_rest])}' />
            </column>
            <column-instance column='[Successful Orders Od (copy)_6259370166296219649]' derivation='Avg' name='[avg:Successful Orders Od (copy)_6259370166296219649:qk]' pivot='key' type='quantitative' />
