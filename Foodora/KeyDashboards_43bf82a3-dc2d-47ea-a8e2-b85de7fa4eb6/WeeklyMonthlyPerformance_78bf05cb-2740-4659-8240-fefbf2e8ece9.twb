    <worksheet name='OD Fail Rate MTD %'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) &#10;    AND ([order_day] &lt;= [Parameters].[Parameter 1] OR DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;OR (DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1) AND YEAR([order_day]) = YEAR(TODAY()-1))' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;  //  AND day([Order Day]) &lt;= day(today())-1&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)-1&#10;&#10;//IF  [Max Order Week] = [Reporting Week]  AND &#10;//MONTH([Order Day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND YEAR([Order Day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])})&#10;//AND day([Order Day]) &lt;= day(TODAY()-1) THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week]  &#10;//AND MONTH([Order Day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND YEAR([Order Day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND day([Order Day]) &lt;= day([Reporting Week]) &#10;//THEN TRUE&#10;//END&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,(DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 1])))&#10;   AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 1]) &#10;OR&#10;(DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,(DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 1])))&#10;and&#10; DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, (DATETRUNC(&apos;month&apos;, [order_day])))))))' />
            </column>
            <column caption='MTD Growth Title' datatype='string' name='[MTD Title (copy)_21673596542980104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MTD MoM&quot;' />
              <aliases>
                <alias key='&quot;MTD MoM&quot;' value='MTD       MoM' />
              </aliases>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='OD Fail Rate MTD growth %' datatype='real' name='[Seamless Order MTD growth % (copy)_3606890725758210049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((AVG(iif([Calculation_21673596520853506], [od_fail_rate], 0))&#10;-&#10;(AVG(iif([Calculation_21673596521619459], [od_fail_rate], 0)))))&#10;*100' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[MTD Title (copy)_21673596542980104]' derivation='None' name='[none:MTD Title (copy)_21673596542980104:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Od Fail Rate' datatype='real' name='[od_fail_rate]' role='measure' type='quantitative' />
            <column caption='Order Day' datatype='date' name='[order_day]' role='dimension' type='ordinal' />
            <column-instance column='[Seamless Order MTD growth % (copy)_3606890725758210049]' derivation='User' name='[usr:Seamless Order MTD growth % (copy)_3606890725758210049:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[none:country_name:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
