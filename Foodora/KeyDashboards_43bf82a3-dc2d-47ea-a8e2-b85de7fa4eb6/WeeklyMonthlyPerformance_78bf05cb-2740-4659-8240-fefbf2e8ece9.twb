      <column caption='AFV LY MTD growth %' datatype='real' name='[AFV MTD growth % (copy)_3966334270598025223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(SUM(iif([MTD], [AFV], 0))/&#10;//SUM(iif([LY MTD], [AFV], 0)))-1&#10;&#10;&#10;((sum(iif([Calculation_21673596520853506], [total_gfv_eur], 0)) / &#10;sum(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))) / &#10;(sum(iif([MTD (copy)_1931270242863067149], [total_gfv_eur], 0)) / &#10;sum(iif([MTD (copy)_1931270242863067149], [total_number_of_successful_orders], 0))))-1' />
      </column>
      <column caption='AFV YTD growth %' datatype='real' name='[AFV MTD growth % (copy)_5515220700255686678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(SUM(iif([YTD], [AFV], 0))/&#10;//SUM(iif([PYTD], [AFV], 0)))-1&#10;&#10;&#10;//((sum(iif([YTD], [Total Gfv Eur], 0)) / &#10;//sum(iif([YTD], [Successful Orders], 0))) / &#10;//(sum(iif([PYTD], [Total Gfv Eur], 0)) / &#10;//sum(iif([PYTD], [Successful Orders], 0))))-1&#10;&#10;[AFV QTD (copy)_132574750889889817]  / [AFV YTD (copy)_132574750889984026] -1' />
      </column>
      <column caption='AVG DF MTD growth %' datatype='real' name='[AFV MTD growth % (copy)_5515220700258123801]' role='measure' type='quantitative'>
