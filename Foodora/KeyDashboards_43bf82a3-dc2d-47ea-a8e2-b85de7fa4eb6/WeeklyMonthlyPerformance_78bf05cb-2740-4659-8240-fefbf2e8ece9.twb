          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Vendors w VFD RR Y' datatype='real' name='[Orders Late &gt; 10 RR Y (copy)_496803341152780363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Within Last 21 Days (copy)_2387470757548802048]: [Orders With VFD % (copy)_496803341111009307]})' />
            </column>
            <column caption='Vendors With VFD %' datatype='real' name='[Orders With VFD % (copy)_496803341111009307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([number_of_vendors_vf_discount_weekly]) + AVG([total_only_joker_vendors_weekly]))/AVG([total_active_vendors_weekly])' />
            </column>
            <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,today()))' />
            </column>
            <column caption='Vendors w VFD RR YoY growth %' datatype='real' name='[Vendors w VFD RR MoM growth % (copy)_496803341155381326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Late &gt; 10 RR Y (copy)_496803341152780363] -&#10;(AVG(iif([PM (copy)_2387470757550784515], [number_of_vendors_vf_discount_weekly], 0)) + AVG(iif([PM (copy)_2387470757550784515], [total_only_joker_vendors_weekly], 0))) / AVG(iif([PM (copy)_2387470757550784515], [total_active_vendors_weekly], 0))) * 100' />
            </column>
            <column caption='Within Last 60 Days' datatype='boolean' name='[Within Last 21 Days (copy)_2387470757548802048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-60' />
            </column>
            <column caption='RR MoM Title' datatype='string' name='[WoW Title  (copy)_6569414853212516355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR MoM&quot;' />
              <aliases>
                <alias key='&quot;RR MoM&quot;' value='Monthly RR MoM' />
