            <column caption='Reactivated From Inactive RR Y' datatype='integer' name='[Reactivated From Churn RR Y (copy)_2321042665506091018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(SUM(iif([MTD (copy)_6569414853215997956], [reactivated_from_inactive], 0))&#10;+ SUM(iif([Within Last 21 Days (copy)_2387470757548802048], [reactivated_from_inactive], 0))&#10;/ 60&#10;* (365 - DATEPART(&apos;dayofyear&apos;, TODAY()-1)))' />
            </column>
            <column caption='Reactivated From Inactive RR YoY growth %' datatype='real' name='[Reactivated From Churn RR YoY growth % (copy)_2321042665506185227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Reactivated From Churn RR Y (copy)_2321042665506091018]/&#10;SUM(iif([PM (copy)_2387470757550784515], [reactivated_from_inactive], 0)) - 1 &gt;5&#10;THEN NULL&#10;ELSE&#10;[Reactivated From Churn RR Y (copy)_2321042665506091018]/&#10;SUM(iif([PM (copy)_2387470757550784515], [reactivated_from_inactive], 0)) - 1&#10;END' />
