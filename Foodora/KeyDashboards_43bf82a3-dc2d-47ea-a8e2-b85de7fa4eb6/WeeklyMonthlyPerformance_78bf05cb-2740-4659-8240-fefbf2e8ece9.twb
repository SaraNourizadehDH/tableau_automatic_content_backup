            </column>
            <column caption='Orders Late &gt; 10 LY MTD growth %' datatype='real' name='[Orders Late &gt; 10 MTD growth % (copy)_4549057841488121889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([Calculation_21673596520853506], [order_delay_over_10_min_count], 0))/&#10;SUM(iif([Calculation_21673596520853506], [order_delay_cnt], 0)))&#10;-&#10;(SUM(iif([MTD (copy)_1931270242863067149], [order_delay_over_10_min_count], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [order_delay_cnt], 0))))&#10;*100' />
            </column>
