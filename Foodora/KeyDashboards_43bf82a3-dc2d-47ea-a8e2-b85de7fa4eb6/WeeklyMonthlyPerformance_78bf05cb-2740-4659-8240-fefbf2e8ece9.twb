            <column caption='aCVR' datatype='real' name='[CVR (copy)_2082703780657553433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([main_total_new_customer_count]) / SUM([sessions_new_visit_perseus])' />
            </column>
            <column caption='aCVR RR M' datatype='real' name='[CVR RR M (copy)_2082703780658057245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Successful Orders OD RR (copy)_2744381027666284546]: [CVR (copy)_2082703780657553433]})' />
            </column>
            <column caption='aCVR RR MoM growth %' datatype='real' name='[CVR RR MoM growth % (copy)_2082703780658126878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([CVR RR M (copy)_2082703780658057245] - &#10;(SUM(iif([PMTD (copy)_2744381027682492421], [main_total_new_customer_count], 0)) / SUM(iif([PMTD (copy)_2744381027682492421], [sessions_new_visit_perseus], 0)))) * 100' />
            </column>
            <column caption='PM' datatype='boolean' name='[PMTD (copy)_2744381027682492421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-1' />
            </column>
            <column caption='Within Last 21 Days' datatype='boolean' name='[Successful Orders OD RR (copy)_2744381027666284546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-21' />
            </column>
            <column caption='RR MoM Title' datatype='string' name='[WoW Title  (copy)_6569414853212516355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR MoM&quot;' />
              <aliases>
                <alias key='&quot;RR MoM&quot;' value='Monthly RR MoM' />
              </aliases>
            </column>
