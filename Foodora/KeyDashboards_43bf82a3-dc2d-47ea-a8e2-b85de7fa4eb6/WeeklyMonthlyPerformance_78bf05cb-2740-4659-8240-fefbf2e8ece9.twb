              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Successful Orders MP LY MTD growth %' datatype='real' name='[Successful Orders OD LY MTD growth % (copy)_2915940025926164483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;(SUM(iif([Calculation_21673596520853506], [count_successful_orders_restaurants_mp], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [count_successful_orders_restaurants_mp], 0)))-1 &gt; 5&#10;THEN NULL&#10;ELSE&#10;(SUM(iif([Calculation_21673596520853506], [count_successful_orders_restaurants_mp], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [count_successful_orders_restaurants_mp], 0)))-1&#10;END' />
            </column>
