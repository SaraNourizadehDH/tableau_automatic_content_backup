    <worksheet name='Orders OD% QTD %'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='QTD' datatype='boolean' name='[MTD (copy)_1931270242855276544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, TODAY() - 1)&#10;&#10; DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= (TODAY()-1) &#10;//THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= ([Reporting Week]) THEN TRUE&#10;//ELSE False END' />
            </column>
            <column caption='PQTD' datatype='boolean' name='[MTD (copy)_1931270242855424001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF &#10;//[Max Order Week] = [Reporting Week] and &#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;quarter&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;quarter&apos;, -1, TODAY()-1)&#10;//THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week] and &#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;quarter&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;quarter&apos;, -1, [Reporting Week])&#10;//THEN TRUE&#10;//END&#10;&#10;&#10; DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, DATEADD(&apos;quarter&apos;, -1, [Parameters].[Parameter 1])) &#10;AND [order_day] &lt;= DATEADD(&apos;quarter&apos;, -1, [Parameters].[Parameter 1])&#10; or ( DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, DATEADD(&apos;quarter&apos;, -1, [Parameters].[Parameter 1])) &#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;&#10;&#10;&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= ([Reporting Week]) + 6' />
            </column>
            <column caption='QTD Growth Title' datatype='string' name='[MTD Growth Title (copy)_1931270242856280068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;QTD QoQ&quot;' />
              <aliases>
                <alias key='&quot;QTD QoQ&quot;' value='QTD           QoQ' />
              </aliases>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Successful Orders Restaurants OD% QTD growth pp' datatype='real' name='[Successful Orders OD% MTD growth pp (copy)_2915940025955680272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([MTD (copy)_1931270242855276544], [successful_orders_restaurants_od], 0)) / SUM(iif([MTD (copy)_1931270242855276544], count_successful_orders_restaurants, 0)))*100&#10;-&#10;(SUM(iif([MTD (copy)_1931270242855424001], [successful_orders_restaurants_od], 0)) / SUM(iif([MTD (copy)_1931270242855424001], count_successful_orders_restaurants, 0)))*100' />
            </column>
            <column datatype='integer' name='[count_successful_orders_restaurants]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[MTD Growth Title (copy)_1931270242856280068]' derivation='None' name='[none:MTD Growth Title (copy)_1931270242856280068:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Order Day' datatype='date' name='[order_day]' role='dimension' type='ordinal' />
            <column caption='Successful Orders Restaurants Od' datatype='integer' name='[successful_orders_restaurants_od]' role='measure' type='quantitative' />
