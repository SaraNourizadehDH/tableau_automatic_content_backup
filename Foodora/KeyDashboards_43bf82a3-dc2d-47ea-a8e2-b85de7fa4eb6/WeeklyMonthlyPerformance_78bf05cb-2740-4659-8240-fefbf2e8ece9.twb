              <calculation class='tableau' formula='SUM([total_number_of_successful_orders]) / AVG([weekly_total_active_customer_count])' />
            </column>
            <column caption='Frequency RR YoY growth %' datatype='real' name='[Frequency RR MoM growth % (copy)_2321042665529475094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Within Last 21 Days (copy)_2387470757548802048]: [AFV (copy)_2321042665522323470]}) / &#10;AVG({ FIXED [global_entity_id], [PM (copy)_2387470757550784515]: [AFV (copy)_2321042665522323470]}) - 1' />
            </column>
            <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
