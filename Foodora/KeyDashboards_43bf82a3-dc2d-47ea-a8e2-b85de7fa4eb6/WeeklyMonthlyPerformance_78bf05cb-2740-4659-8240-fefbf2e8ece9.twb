            <column caption='Acquisitions RR Y' datatype='integer' name='[Successful Orders Dmart RR Y (copy)_2076511279472922634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(SUM(iif([MTD (copy)_6569414853215997956], [main_total_new_customer_count], 0))&#10;+ SUM(iif([Within Last 21 Days (copy)_2387470757548802048], [main_total_new_customer_count], 0))&#10;/ 60&#10;* (365 - DATEPART(&apos;dayofyear&apos;, TODAY()-1)))' />
