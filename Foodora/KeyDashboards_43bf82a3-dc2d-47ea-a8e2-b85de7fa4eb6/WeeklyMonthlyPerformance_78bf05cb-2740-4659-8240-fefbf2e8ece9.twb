            <column caption='Total Active Vendors Weekly' datatype='integer' name='[total_active_vendors_weekly]' role='measure' type='quantitative' />
            <column caption='Total Only Joker Vendors Weekly' datatype='integer' name='[total_only_joker_vendors_weekly]' role='measure' type='quantitative' />
