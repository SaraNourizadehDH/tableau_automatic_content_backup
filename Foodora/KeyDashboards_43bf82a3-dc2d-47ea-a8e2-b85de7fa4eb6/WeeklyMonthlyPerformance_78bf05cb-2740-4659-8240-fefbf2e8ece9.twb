    <worksheet name='Orders Late &gt; 20 RR MoM'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
          </datasources>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Orders Late &gt; 20' datatype='real' name='[Orders Late &gt; 10 (copy)_2082703780635082756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_delay_over_20_min_count])/SUM([order_delay_cnt]))' />
            </column>
            <column caption='Orders Late &gt; 20 RR M' datatype='real' name='[Orders Late &gt; 10 RR M (copy)_2082703780638781449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Successful Orders OD RR (copy)_2744381027666284546]: [Orders Late &gt; 10 (copy)_2082703780635082756]})' />
            </column>
            <column caption='Orders Late &gt; 20 RR MoM growth %' datatype='real' name='[Orders Late &gt; 10 RR MoM growth % (copy)_2082703780638928906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Late &gt; 10 RR M (copy)_2082703780638781449] - &#10;(SUM(iif([PMTD (copy)_2744381027682492421], [order_delay_over_20_min_count], 0)) / SUM(iif([PMTD (copy)_2744381027682492421], [order_delay_cnt], 0)))) * 100' />
            </column>
            <column caption='PM' datatype='boolean' name='[PMTD (copy)_2744381027682492421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-1' />
            </column>
            <column caption='Within Last 21 Days' datatype='boolean' name='[Successful Orders OD RR (copy)_2744381027666284546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-21' />
            </column>
            <column caption='RR MoM Title' datatype='string' name='[WoW Title  (copy)_6569414853212516355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR MoM&quot;' />
              <aliases>
                <alias key='&quot;RR MoM&quot;' value='Monthly RR MoM' />
              </aliases>
            </column>
