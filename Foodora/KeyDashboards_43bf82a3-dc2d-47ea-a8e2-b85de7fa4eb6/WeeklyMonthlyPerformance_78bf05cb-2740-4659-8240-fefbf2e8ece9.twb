          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='Orders Late &gt; 20' datatype='real' name='[Orders Late &gt; 10 (copy)_2082703780635082756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_delay_over_20_min_count])/SUM([order_delay_cnt]))' />
            </column>
            <column caption='Orders Late &gt; 20 RR Y' datatype='real' name='[Orders Late &gt; 10 RR Y (copy)_2082703780639068171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [Within Last 21 Days (copy)_2387470757548802048]: [Orders Late &gt; 10 (copy)_2082703780635082756]})' />
            </column>
            <column caption='Orders Late &gt; 20 RR YoY growth %' datatype='real' name='[Orders Late &gt; 10 RR YoY growth % (copy)_2082703780639145996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Late &gt; 10 RR Y (copy)_2082703780639068171] - &#10;(SUM(iif([PM (copy)_2387470757550784515], [order_delay_over_20_min_count], 0)) / SUM(iif([PM (copy)_2387470757550784515], [order_delay_cnt], 0)))) * 100' />
            </column>
            <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,today()))' />
            </column>
            <column caption='RR YoY Title' datatype='string' name='[RR MoM Title (copy)_2387470757551210500]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR YoY&quot;' />
            </column>
            <column caption='Within Last 60 Days' datatype='boolean' name='[Within Last 21 Days (copy)_2387470757548802048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] &lt;= TODAY()-1&#10;AND&#10;[order_day] &gt;= TODAY()-60' />
            </column>
            <column caption='RR MoM Title' datatype='string' name='[WoW Title  (copy)_6569414853212516355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RR MoM&quot;' />
              <aliases>
                <alias key='&quot;RR MoM&quot;' value='Monthly RR MoM' />
              </aliases>
            </column>
