            <column-instance column='[Frequency PMTD (copy)_1982006086412447747]' derivation='User' name='[usr:Frequency PMTD (copy)_1982006086412447747:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Frequency Weekly LY MTD growth % (copy)_3966334270636793885]' derivation='User' name='[usr:Frequency Weekly LY MTD growth % (copy)_3966334270636793885:qk]' pivot='key' type='quantitative' />
