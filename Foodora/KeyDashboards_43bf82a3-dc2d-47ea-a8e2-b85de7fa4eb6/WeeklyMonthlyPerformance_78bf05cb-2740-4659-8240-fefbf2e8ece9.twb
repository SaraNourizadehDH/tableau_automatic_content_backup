            <column caption='Basket Incentives RR Y' datatype='integer' name='[Reactivated From Churn RR Y (copy)_2321042665533599772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(SUM(iif([MTD (copy)_6569414853215997956], [Sessions New Visit (copy)_2321042665531736087], 0))&#10;+ SUM(iif([Within Last 21 Days (copy)_2387470757548802048], [Sessions New Visit (copy)_2321042665531736087], 0))&#10;/ 60&#10;* (365 - DATEPART(&apos;dayofyear&apos;, TODAY()-1)))' />
