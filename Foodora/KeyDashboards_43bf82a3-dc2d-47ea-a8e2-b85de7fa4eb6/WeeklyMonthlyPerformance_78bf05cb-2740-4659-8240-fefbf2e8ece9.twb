            <column-instance column='[AVG DF MTD growth % (copy)_3966334270604705803]' derivation='User' name='[usr:AVG DF MTD growth % (copy)_3966334270604705803:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
