    <worksheet name='Orders OD% YTD &amp; PYTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) &#10;    AND ([order_day] &lt;= [Parameters].[Parameter 1] OR DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;OR (DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1) AND YEAR([order_day]) = YEAR(TODAY()-1))' />
            </column>
            <column caption='YTD' datatype='boolean' name='[MTD (copy)_6569414853215997956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;&#10;&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week])&#10;//and &#10;//[Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and  DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week]) and [Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE END' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='PYTD' datatype='boolean' name='[PMTD (copy)_6569414853216116741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, today()-1)&#10;//THEN TRUE&#10;//ELSEIF  &#10;//[Max Order Week] &lt;&gt; [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, [Reporting Week])&#10;//THEN TRUE &#10;//END&#10;&#10;&#10;&#10;DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;AND [order_day] &lt;= dateadd(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#10;or (DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))' />
            </column>
            <column caption='LY QTD' datatype='boolean' name='[PQTD (copy)_1931270242855862274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF &#10;//[Max Order Week] = [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, TODAY()-1)&#10;//THEN TRUE&#10;//ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//THEN TRUE&#10;//END&#10;&#10;&#10;[order_day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]))&#10;AND [order_day] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1])&#10;OR (&#10;DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]))) &#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10;//AND [Order Day] &lt;= [Reporting Week]&#10; //or (DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10; //and DATEPART(&apos;week&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))' />
            </column>
            <column caption='YTD Title' datatype='string' name='[QTD Title (copy)_1369798010025598979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1]))) + &quot;                         &quot; +&#10;STR(DATEPART(&apos;year&apos;,[Parameters].[Parameter 1]))' />
              <aliases>
                <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
              </aliases>
            </column>
            <column caption='Successful Orders Restaurant OD% MTD ' datatype='real' name='[Successful Orders OD%  LY MTD  (copy)_122441650352115732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM(iif([MTD], [Successful Orders Od], 0)) / &#10;//((SUM(iif([MTD], [Count Successful Orders], 0)) - SUM(iif([MTD], [Successful Orders Pickup], 0))))&#10;&#10;&#10;&#10;&#10;SUM(iif([Calculation_21673596520853506],[successful_orders_restaurants_od],0)) / SUM(iif([Calculation_21673596520853506],[count_successful_orders_restaurants] - [successful_orders_pickup_rest],0))' />
            </column>
            <column caption='Successful Orders Restaurants OD% LY QTD' datatype='real' name='[Successful Orders OD% QTD (copy)_103793933165944838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PQTD (copy)_1931270242855862274], [successful_orders_restaurants_od], 0)) / &#10;(SUM(iif([PQTD (copy)_1931270242855862274], [count_successful_orders_restaurants], 0)) - SUM(iif([PQTD (copy)_1931270242855862274], [successful_orders_pickup_rest], 0)))' />
            </column>
            <column caption='Successful Orders Restaurants OD% LY YTD' datatype='real' name='[Successful Orders OD% YTD growth pp (copy) (copy)_446208242581209089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_6569414853216116741], [successful_orders_restaurants_od], 0)) / &#10;(SUM(iif([PMTD (copy)_6569414853216116741], [count_successful_orders_restaurants], 0)) - SUM(iif([PMTD (copy)_6569414853216116741], [successful_orders_pickup_rest], 0)))' />
            </column>
            <column caption='Successful Orders Restaurants OD% YTD' datatype='real' name='[Successful Orders OD% YTD growth pp (copy)_446208242581188608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_6569414853215997956], [successful_orders_restaurants_od], 0)) / &#10;(SUM(iif([MTD (copy)_6569414853215997956], [count_successful_orders_restaurants], 0)) - SUM(iif([MTD (copy)_6569414853215997956], [successful_orders_pickup_rest], 0)))' />
            </column>
            <column-instance column='[Successful Orders OD% YTD growth pp (copy) (copy)_446208242581209089]' derivation='Avg' name='[avg:Successful Orders OD% YTD growth pp (copy) (copy)_446208242581209089:qk]' pivot='key' type='quantitative' />
