    <worksheet name='Acutals Orders MTD &amp; LY MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_report_main (bl_europe)' name='federated.1c9k3t5104xbdx1afvl6j0uymxp2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Week (copy)_2206904614099456000]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1c9k3t5104xbdx1afvl6j0uymxp2].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c9k3t5104xbdx1afvl6j0uymxp2'>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) &#10;    AND ([order_day] &lt;= [Parameters].[Parameter 1] OR DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;OR (DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1) AND YEAR([order_day]) = YEAR(TODAY()-1))' />
            </column>
            <column caption='QTD' datatype='boolean' name='[MTD (copy)_1931270242855276544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, TODAY() - 1)&#10;&#10; DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= (TODAY()-1) &#10;//THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= ([Reporting Week]) THEN TRUE&#10;//ELSE False END' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[MTD (copy)_1931270242863067149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//(DATETRUNC(&apos;week&apos;,([Order Day]))) = [Reporting Week]&#10;//AND DATETRUNC(&apos;month&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-1)) &#10; //  AND day([Order Day]) &lt;= day(TODAY()-1)&#10;  // AND month([Order Day]) &lt;= month(TODAY()-1)&#10;//OR &#10;&#10;&#10;&#10;&#10;&#10;&#10; DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#10;    AND ([order_day] &lt;= DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1])) &#10;//OR &#10; //(DATETRUNC(&apos;month&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,[Reporting Week]))&#10;//and&#10;//DATEPART(&apos;week&apos;, [Reporting Week]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) )))' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Successful Orders Budget Monhtly' datatype='real' name='[Orders RR MTD (copy)_2120351041787789314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_21673596520853506], [orders_month_budget], 0))' />
            </column>
            <column caption='Orders RR QTD' datatype='real' name='[Orders RR MTD (copy)_2120351041788887044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_1931270242855276544], [orders_month_rr], 0))' />
            </column>
            <column caption='GMV Budget quarterly' datatype='real' name='[Successful Orders Budget (copy)_2120351041788411907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_1931270242855276544], [gmv_eur_month_budget], 0))' />
            </column>
            <column caption='Orders RR MTD' datatype='real' name='[Successful Orders LY MTD (copy)_122441650265354240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_21673596520853506], [orders_month_rr], 0))' />
            </column>
            <column caption='Successful Orders LY MTD' datatype='integer' name='[Successful Orders MTD (copy)_3648126839566827528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_1931270242863067149], [total_number_of_successful_orders], 0))' />
            </column>
            <column caption='Successful Orders MTD' datatype='integer' name='[Successful Orders MTD growth % (copy)_3648126839566712839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))' />
            </column>
            <column caption='LY MTD Title' datatype='string' name='[WoW Title  (copy)_1369798010021756928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;month&apos;, DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1]))) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1]))) + &quot;    &quot; + STR(DATEPART(&apos;month&apos;, [Parameters].[Parameter 1])) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;,[Parameters].[Parameter 1])) + &quot;    &quot; + STR(DATEPART(&apos;month&apos;,[Parameters].[Parameter 1])) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;,[Parameters].[Parameter 1])) + &quot; RR&quot;' />
              <aliases>
                <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
              </aliases>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[gmv_eur_month_budget]' role='measure' type='quantitative' />
