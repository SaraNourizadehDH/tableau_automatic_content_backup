            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Successful Orders LS LY MTD growth %' datatype='real' name='[Successful Orders Dmart LY MTD growth % (copy)_2915940025949257738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;(SUM(iif([Calculation_21673596520853506], [count_successful_orders_local_shops], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [count_successful_orders_local_shops], 0)))-1 &gt;= 5&#10;THEN NULL&#10;ELSE&#10;(SUM(iif([Calculation_21673596520853506], [count_successful_orders_local_shops], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [count_successful_orders_local_shops], 0)))-1&#10;END' />
            </column>
            <column caption='Successful Orders Local Shops' datatype='integer' name='[count_successful_orders_local_shops]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
