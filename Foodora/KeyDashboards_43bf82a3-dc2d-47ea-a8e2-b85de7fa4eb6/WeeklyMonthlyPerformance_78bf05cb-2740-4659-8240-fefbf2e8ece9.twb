            </column>
            <column caption='Reactivated From Churn LY MTD growth %' datatype='real' name='[Reactivated From Churn MTD growth % (copy)_3966334270623903769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;(SUM(iif([Calculation_21673596520853506], [reactivated_from_churn], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [reactivated_from_churn], 0)))-1 &gt;= 5&#10;THEN NULL&#10;ELSE&#10;(SUM(iif([Calculation_21673596520853506], [reactivated_from_churn], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [reactivated_from_churn], 0)))-1&#10;END' />
            </column>
