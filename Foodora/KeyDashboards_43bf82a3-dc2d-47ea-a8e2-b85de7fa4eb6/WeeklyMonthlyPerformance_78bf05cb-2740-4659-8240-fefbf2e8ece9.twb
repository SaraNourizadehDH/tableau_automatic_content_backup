              <calculation class='tableau' formula='[Avg DT RR M (copy)_496803341125853218]/&#10;(SUM(iif([PM (copy)_2387470757550784515], [actual_delivery_time_sum], 0)) / SUM(iif([PM (copy)_2387470757550784515], [actual_delivery_time_cnt], 0))) - 1' />
