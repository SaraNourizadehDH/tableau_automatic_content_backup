            <column caption='Active Customers LW YoY' datatype='real' name='[Active Customers WoW (copy)_132574750946725925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([weekly_total_active_customer_count])) - LOOKUP(ZN(AVG([weekly_total_active_customer_count])), -52)) / ABS(LOOKUP(ZN(AVG([weekly_total_active_customer_count])), -52))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX WEEK AUX -1' datatype='boolean' name='[INDEX WEEK AUX (copy)_3648126839560245249]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
            </column>
            <column caption='Max Order Week' datatype='date' name='[Order Week (copy)_2206904614099456000]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
            </column>
            <column caption='Week Filter (copy)' datatype='boolean' name='[Week Filter (copy)_3648126839562969092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Order Day (copy)_5361464990301970432] &gt;= DATEADD(&apos;week&apos;,-53,[Parameters].[Parameter 1])&#10;AND&#10;[Order Day (copy)_5361464990301970432] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='LW YoY Title  Exec' datatype='string' name='[WoW Title  Exec (copy)_122441650322063368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;LW YoY&apos;' />
              <aliases>
                <alias key='&quot;LW YoY&quot;' value='LW            YoY' />
                <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
              </aliases>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Week Filter (copy)_3648126839562969092]' derivation='None' name='[none:Week Filter (copy)_3648126839562969092:nk]' pivot='key' type='nominal' />
            <column-instance column='[WoW Title  Exec (copy)_122441650322063368]' derivation='None' name='[none:WoW Title  Exec (copy)_122441650322063368:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Order Day' datatype='date' name='[order_day]' role='dimension' type='ordinal' />
            <column-instance column='[Order Day (copy)_5361464990301970432]' derivation='Week-Trunc' name='[twk:Order Day (copy)_5361464990301970432:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Active Customers WoW (copy)_132574750946725925]' derivation='User' name='[usr:Active Customers WoW (copy)_132574750946725925:qk]' pivot='key' type='quantitative'>
