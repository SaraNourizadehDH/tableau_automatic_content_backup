    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Data Quality Checks'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/OrderLossAttribution/DataQualityChecks?rev=' id='DataQualityChecks' path='/t/Foodora/workbooks/OrderLossAttribution' revision='' site='Foodora' />
      <style />
      <size maxheight='900' maxwidth='1200' minheight='900' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='486' param='horz' type-v2='layout-flow' w='98666' x='667' y='889'>
            <zone h='98222' id='484' type-v2='layout-basic' w='98666' x='667' y='889'>
              <zone h='42111' id='309' param='horz' type-v2='layout-flow' w='98666' x='667' y='889'>
                <zone h='42111' id='307' type-v2='layout-basic' w='98666' x='667' y='889'>
                  <zone forceUpdate='true' h='5555' id='1' type-v2='text' w='98666' x='667' y='889'>
                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='18'>Data Freshness Check</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='background-color' value='#cb0052' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='7270' id='7' type-v2='text' w='98666' x='667' y='6444'>
                    <formatted-text>
                      <run>This page shows the freshness of the data available in each sheet. The data will be considered as</run>
                      <run bold='true'> &apos;fresh&apos; </run>
                      <run>if the sheet contains </run>
                      <run bold='true'>D-1 data</run>
                      <run>; otherwise, it will be labelled as </run>
                      <run bold='true'>&apos;not fresh&apos;</run>
                      <run>.&#10;&#10;</run>
                      <run italic='true'>*Note: this only checks for </run>
                      <run bold='true' italic='true'>freshness</run>
                      <run italic='true'>Æ </run>
                      <run bold='true' italic='true'>of data</run>
                      <run italic='true'> and does not check for data completeness</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='background-color' value='#f8f8d3' />
                    </zone-style>
                  </zone>
                  <zone h='29286' id='306' name='Freshness Checks' show-title='false' w='98666' x='667' y='13714'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
              <zone h='16778' id='310' type-v2='empty' w='98666' x='667' y='43000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='39333' id='483' name='Metrics Quality' w='49333' x='667' y='59778'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='33778' id='487' type-v2='text' w='49333' x='50000' y='59778'>
                <formatted-text>
                  <run fontcolor='#000000' fontsize='11'>This attempts to give a simple check for certain key metrics </run>
                  <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>for the whole of APAC</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='11'> It compares the sum of the metric between </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>- latest date to latest date - 7</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>- latest date  - 8 to latest date - 13</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>i.e. if today was 2024-05-28, the latest date for the data will be 2024-05-27. So it compares the </run>
                  <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>SUM</run>
                  <run fontcolor='#000000' fontsize='11'> of the metrics between</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>- 2024-05-21 to 2024-05-27</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>- 2024-05-14 to 2024-05-20</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='11'><![CDATA[If the Percentage Difference of the comparison is >= 80% or <= -80%, it'll show ]]></run>
                  <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Possible Error</run>
                  <run fontcolor='#000000' fontsize='11'> with a</run>
                  <run>Æ </run>
                  <run bold='true' fontcolor='#ff2600' fontsize='11' underline='true'>red box</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='5555' id='488' type-v2='empty' w='49333' x='50000' y='93556'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
