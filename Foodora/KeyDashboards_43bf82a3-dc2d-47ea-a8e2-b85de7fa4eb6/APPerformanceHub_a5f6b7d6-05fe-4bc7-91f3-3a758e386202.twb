            <column caption='Date Comparison' datatype='string' name='[Calculation_799811201492168709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter 2] AND [created_date_local] &lt;= [Parameters].[Report Start Date (copy)_142426395933470745] THEN &quot;Report Date&quot;&#10;ELSEIF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter] AND [created_date_local] &lt;= [Parameters].[Previous Start Date (copy)_142426395933605914] THEN &quot;Previous Date&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Shrink 1 Order Loss Rate Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_799811201558683713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_1st_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_1st_orders] ELSE 0 END))) - &#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_1st_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_1st_orders] ELSE 0 END)))&#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_1st_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_1st_orders] ELSE 0 END)))' />
            </column>
            <column caption='Shrink 2 Order Loss Rate Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_799811201558872131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_2nd_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_2nd_orders] ELSE 0 END))) - &#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_2nd_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_2nd_orders] ELSE 0 END)))&#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_2nd_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_2nd_orders] ELSE 0 END)))' />
            </column>
