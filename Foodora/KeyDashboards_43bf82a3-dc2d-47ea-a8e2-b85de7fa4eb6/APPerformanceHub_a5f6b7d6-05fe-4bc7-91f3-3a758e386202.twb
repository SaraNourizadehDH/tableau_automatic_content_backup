                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='39333' id='483' is-fixed='true' name='Metrics Quality' w='49333' x='667' y='59778'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='33778' id='487' type-v2='text' w='49333' x='50000' y='59778'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='11'>This attempts to give a simple check for certain key metrics </run>
                    <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>for the whole of APAC</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'> It compares the sum of the metric between </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- latest date to latest date - 7</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- latest date  - 8 to latest date - 13</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>i.e. if today was 2024-05-28, the latest date for the data will be 2024-05-27. So it compares the </run>
                    <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>SUM</run>
                    <run fontcolor='#000000' fontsize='11'> of the metrics between</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- 2024-05-21 to 2024-05-27</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- 2024-05-14 to 2024-05-20</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'><![CDATA[If the Percentage Difference of the comparison is >= 80% or <= -80%, it'll show ]]></run>
                    <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Possible Error</run>
                    <run fontcolor='#000000' fontsize='11'> with a</run>
                    <run>Æ </run>
                    <run bold='true' fontcolor='#ff2600' fontsize='11' underline='true'>red box</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{2B50ADB9-6188-4AF5-A31E-6051403477A7}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/OrderLossAttribution/Description?rev=' id='Description' path='/t/Foodora/workbooks/OrderLossAttribution' revision='' site='Foodora' />
      <style />
      <size maxheight='900' maxwidth='1200' minheight='900' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='21222' id='3' type-v2='text' w='98666' x='667' y='889'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='20' underline='true'>Introduction</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#172b4d' fontsize='12'>The Performance Hub dashboard is a </run>
              <run bold='true' fontcolor='#172b4d' fontsize='12'>diagnostic</run>
              <run fontcolor='#172b4d' fontsize='12'> dashboard that enables users to </run>
              <run bold='true' fontcolor='#172b4d' fontsize='12'>identify clear component metrics of key KPIs</run>
              <run fontcolor='#172b4d' fontsize='12'> &amp; </run>
              <run bold='true' fontcolor='#172b4d' fontsize='12'>understand the contributions by each segment</run>
              <run fontcolor='#172b4d' fontsize='12'> to empower teams to easily </run>
              <run bold='true' fontcolor='#172b4d' fontsize='12'>deep dive &amp; attribute reasons for metric movements.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#172b4d' fontsize='12'>More info available: </run>
              <run auto-url='true' bold='true' fontcolor='#172b4d' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/AD/Performance+Hub&amp;quot;'>https://confluence.deliveryhero.com/display/AD/Performance+Hub</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='58222' id='5' type-v2='text' w='98666' x='667' y='22111'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>How to use dashboard</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Metric Definitions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>A tab that shows definitions of each segment in Segment Drilldown and the definitions of all metrics shown in this dashboard</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Data Quality Checks</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>A tab that shows the status of the underlying data. Includes Freshness and Quality of Data</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Summary</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>A tab that gives a quick overview of key metrics for the past week. Has Calender View and 12W Trend Lines</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Overview Drilldown</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>A tab that breaks down key metrics into its components in a Metric Tree for more in-depth exploration.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Segment Drilldown</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>A tab that breakdowns key metrics into its different segments. Showing the Loss Contribution.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Vendor Drilldown</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>A tab that breaks down key metrics into different vendors. Showing the Loss Contribution.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Changelog</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>A tab that shows the various changes to the underlying table, data or the dashboard</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='18778' id='6' type-v2='text' w='98666' x='667' y='80333'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Point of Contact</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Please reach out in the slack channel </run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>#apac-data-performance-hub</run>
              <run fontcolor='#000000' fontsize='12'> if you encounter any issues using this dashboard</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Please feel free to provide any feedback in this gsheet: </run>
              <run auto-url='true' fontcolor='#000000' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/19Ny1UYqDeWhJAXdC-saoW9UjUXz9dWPqTKM2aCxWjQs/edit#gid=0&amp;quot;'>https://docs.google.com/spreadsheets/d/19Ny1UYqDeWhJAXdC-saoW9UjUXz9dWPqTKM2aCxWjQs/edit#gid=0</run>
              <run fontcolor='#000000' fontsize='12'>Æ </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
