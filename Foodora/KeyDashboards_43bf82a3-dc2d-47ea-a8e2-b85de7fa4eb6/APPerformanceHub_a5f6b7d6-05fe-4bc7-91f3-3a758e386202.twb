      <column caption='Is Sheet Fresh' datatype='string' name='[Calculation_270849301597106181]' role='measure' type='nominal'>
        <calculation class='tableau' formula='//CASE ATTR([Sheet Name])&#10;//  WHEN &quot;Summary&quot; THEN IF MIN([Summary Latest Date], [Overview Latest Date]) = TODAY()-1 THEN &quot;Data is fresh&quot; ELSE &quot;Data is not fresh&quot; END&#10;//  WHEN [Sheet Name] = &quot;Overview&quot; AND [Overview Latest Date] = TODAY()-1 THEN &quot;Data is fresh&quot;&#10;//  WHEN [Sheet Name] = &quot;Overview Drill Down&quot; AND [Overview Latest Date] = TODAY()-1 THEN &quot;Data is fresh&quot;&#10;//  WHEN [Sheet Name] = &quot;Segment Drill Down&quot; AND [Drilldown Latest Date] = TODAY()-1 THEN &quot;Data is fresh&quot;&#10;//  WHEN [Sheet Name] = &quot;Vendor Drill Down&quot; AND [Vendor Drilldown Latest Date] = TODAY()-1 &#10;//  ELSE &quot;Data is not fresh&quot;&#10;//END&#10;&#10;IF ATTR([sheet_name]) = &quot;Summary&quot; AND [Summary Latest Date (copy)_270849301596540930] &gt;= TODAY()-1 THEN &quot;Data is fresh&quot; &#10;// ELSEIF ATTR([Sheet Name]) = &quot;Overview&quot; AND [Overview Latest Date] &gt;= TODAY()-1 THEN &quot;Data is fresh&quot; &#10;ELSEIF ATTR([sheet_name]) = &quot;Overview Drill Down&quot; AND [Summary Latest Date (copy)_270849301596540930] &gt;= TODAY()-1 THEN &quot;Data is fresh&quot; &#10;ELSEIF ATTR([sheet_name]) = &quot;Segment Drill Down&quot; AND MIN([Summary Latest Date (copy) (copy)_270849301596553219], [Summary Latest Date (copy)_270849301596540930]) &gt;= TODAY()-1 THEN &quot;Data is fresh&quot; &#10;ELSEIF ATTR([sheet_name]) = &quot;Vendor Drill Down&quot; AND MIN([Summary Latest Date (copy) (copy) (copy)_270849301596561412], [Summary Latest Date (copy)_270849301596540930]) &gt;= TODAY()-1 THEN &quot;Data is fresh&quot; &#10;ELSE &quot;Data is not fresh&quot; &#10;END' />
      </column>
      <column caption='Latest Available Date' datatype='date' name='[Is Sheet Fresh (copy)_270849301605359623]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//IF ATTR([Sheet Name]) = &quot;Summary&quot; THEN MIN([Summary Latest Date], [Overview Latest Date])&#10;IF ATTR([sheet_name]) = &quot;Summary&quot; THEN [Summary Latest Date (copy)_270849301596540930]&#10;ELSEIF ATTR([sheet_name]) = &quot;Overview Drill Down&quot; THEN [Summary Latest Date (copy)_270849301596540930]&#10;ELSEIF ATTR([sheet_name]) = &quot;Segment Drill Down&quot; THEN MIN([Summary Latest Date (copy) (copy)_270849301596553219], [Summary Latest Date (copy)_270849301596540930])&#10;ELSEIF ATTR([sheet_name]) = &quot;Vendor Drill Down&quot; THEN MIN([Summary Latest Date (copy) (copy) (copy)_270849301596561412], [Summary Latest Date (copy)_270849301596540930])&#10;END' />
      </column>
      <column caption='Vendor Drilldown Latest Date' datatype='date' name='[Summary Latest Date (copy) (copy) (copy)_270849301596561412]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([Parameters].[Parameter 4])' />
      </column>
      <column caption='Drilldown Latest Date' datatype='date' name='[Summary Latest Date (copy) (copy)_270849301596553219]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([Parameters].[Parameter 3])' />
      </column>
      <column caption='Overview Latest Date' datatype='date' name='[Summary Latest Date (copy)_270849301596540930]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([Parameters].[Parameter 2])' />
      </column>
