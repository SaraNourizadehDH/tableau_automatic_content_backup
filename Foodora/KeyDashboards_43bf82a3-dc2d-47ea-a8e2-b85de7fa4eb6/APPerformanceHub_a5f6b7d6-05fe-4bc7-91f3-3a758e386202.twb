              <calculation class='tableau' formula='IF [Parameters].[Calendar Measures (copy)] = 1&#10;THEN MAX(&#10;    MAX([Calculation_799811201560236113], [Calculation_799811201560461395]), &#10;    MAX(&#10;        MAX([Calculation_799811201560744021], [Calculation_799811201561006167]),&#10;        [Calculation_799811201561309273]&#10;    )&#10;)&#10;ELSE MIN(&#10;    MIN([Calculation_799811201560236113], [Calculation_799811201560461395]), &#10;    MIN(&#10;        MIN([Calculation_799811201560744021], [Calculation_799811201561006167]),&#10;        [Calculation_799811201561309273]&#10;    )&#10;)&#10;END' />
