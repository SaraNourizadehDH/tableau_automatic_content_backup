            <column caption='Sheet Name' datatype='string' name='[sheet_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_270849301597106181]' derivation='User' name='[usr:Calculation_270849301597106181:nk]' pivot='key' type='nominal' />
            <column-instance column='[Is Sheet Fresh (copy)_270849301605359623]' derivation='User' name='[usr:Is Sheet Fresh (copy)_270849301605359623:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
