              <calculation class='tableau' formula='CASE [Parameters].[Measures (copy 3)]&#10;    WHEN 19 THEN {FIXED [Calculation_1458181147540840448], [global_entity_id (Custom SQL Query1)]: MAX([total_monthly_cum_orders_runrate])}&#10;    WHEN 66 THEN {FIXED [Calculation_1458181147540840448], [global_entity_id (Custom SQL Query1)]: MAX([total_monthly_cum_gmv_eur_runrate])}&#10;END' />
