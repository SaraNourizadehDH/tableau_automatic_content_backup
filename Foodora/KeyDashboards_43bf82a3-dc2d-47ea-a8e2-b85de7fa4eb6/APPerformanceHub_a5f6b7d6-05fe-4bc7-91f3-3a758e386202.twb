            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13tuvvu0dl2hkh14m21x816fuaek'>
            <column caption='Dates for Trends' datatype='boolean' name='[Calculation_106116125978492928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Created Date Local] &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -4, [Created Date Local])) AND [Created Date Local] &lt;= DATETRUNC(&apos;week&apos;, [Created Date Local])&#10;{ &#10;FIXED [Calculation_5103352496644923392] : &#10;    IF COUNTD([created_date_local]) = 7 &#10;    THEN TRUE&#10;    ELSE FALSE&#10;    END&#10;}' />
