      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.180j8m20f3ozbp19j5k1l05dzd8w'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='pandata_report' server-oauth='server-custom' username='harith.bahren@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.180j8m20f3ozbp19j5k1l05dzd8w' name='Custom SQL Query' type='text'><![CDATA[WITH base AS (
  SELECT
    IF(created_date_local <<= DATE_SUB(CURRENT_DATE(), INTERVAL 8 DAY), "week1", "week2") AS week,
    SUM(net_gmv_eur) AS total_gmv_eur,
    SUM(net_delivery_fee_eur) AS total_net_df_eur,
    SUM(valid_order_count) AS total_valid_order_count,
    SUM(session_count) AS total_session_count,
    SUM(incentive_cost_fp_marketing_eur) AS total_mkt_incentive_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pandata_af_metric_attribution_overview_daily`
  WHERE created_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 14 DAY) AND CURRENT_DATE()
  GROUP BY 1
  ORDER BY 1
)

SELECT
  "%diff Total GMV Eur" AS title,
  base.total_gmv_eur AS week1,
  base2.total_gmv_eur AS week2,
  SAFE_DIVIDE(base2.total_gmv_eur - base.total_gmv_eur, base.total_gmv_eur) AS perc_diff
FROM base
LEFT JOIN base AS base2
       ON base2.week = "week2"
WHERE base.week = "week1"

UNION ALL

SELECT
  "%diff Total Net DF Eur" AS title,
  base.total_net_df_eur AS week1,
  base2.total_net_df_eur AS week2,
  SAFE_DIVIDE(base2.total_net_df_eur - base.total_net_df_eur, base.total_net_df_eur) AS perc_diff
FROM base
LEFT JOIN base AS base2
       ON base2.week = "week2"
WHERE base.week = "week1"

UNION ALL

SELECT
  "%diff Total Valid Order Count" AS title,
  base.total_valid_order_count AS week1,
  base2.total_valid_order_count AS week2,
  SAFE_DIVIDE(base2.total_valid_order_count - base.total_valid_order_count, base.total_valid_order_count) AS perc_diff
FROM base
LEFT JOIN base AS base2
       ON base2.week = "week2"
WHERE base.week = "week1"

UNION ALL

SELECT
  "%diff Total Session Count" AS title,
  base.total_session_count AS week1,
  base2.total_session_count AS week2,
  SAFE_DIVIDE(base2.total_session_count - base.total_session_count, base.total_session_count) AS perc_diff
FROM base
LEFT JOIN base AS base2
       ON base2.week = "week2"
WHERE base.week = "week1"

UNION ALL

SELECT
  "%diff Total Mkt Incentive Eur" AS title,
  base.total_mkt_incentive_eur AS week1,
  base2.total_mkt_incentive_eur AS week2,
  SAFE_DIVIDE(base2.total_mkt_incentive_eur - base.total_mkt_incentive_eur, base.total_mkt_incentive_eur) AS perc_diff
FROM base
LEFT JOIN base AS base2
       ON base2.week = "week2"
WHERE base.week = "week1"]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.180j8m20f3ozbp19j5k1l05dzd8w' name='Custom SQL Query' type='text'><![CDATA[WITH base AS (
