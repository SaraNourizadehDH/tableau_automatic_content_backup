            <column caption='Gross Delivery Fee per Order Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_799811201549344786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [GFV (copy)_277534337983889423] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_w_df_count] ELSE 0 END)) - &#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [GFV (copy)_277534337983889423] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_w_df_count] ELSE 0 END))&#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [GFV (copy)_277534337983889423] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_w_df_count] ELSE 0 END))' />
