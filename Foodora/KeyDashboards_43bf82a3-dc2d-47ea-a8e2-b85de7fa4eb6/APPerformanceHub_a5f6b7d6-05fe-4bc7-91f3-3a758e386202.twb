              <calculation class='tableau' formula='{MAX([created_date_local] - 7)}' />
            </column>
            <column caption='Worst Vertical Order Count' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Worst CVR (copy) (copy)_158048264140070918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Worst CVR Comparison (copy) (copy)_158048264140070919]&#10;  WHEN [Calculation_461900501144293377] THEN SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [vertical_restaurants_order_count] ELSE 0 END)&#10;  WHEN [Calculation_461900501144674308] THEN SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [vertical_dmart_order_count] ELSE 0 END)&#10;  WHEN [Calculation_461900501144453122] THEN SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [vertical_shops_order_count] ELSE 0 END)&#10;  WHEN [Calculation_461900501144555523] THEN SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [Calculation_461900501142667264] ELSE 0 END)&#10;  ELSE 0&#10;END' />
            </column>
            <column caption='Worst Vertical Order Count Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Worst CVR Comparison (copy) (copy)_158048264140070919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Calendar Measures (copy)] = 1&#10;THEN MIN(&#10;    MIN([Calculation_461900501144293377], [Calculation_461900501144674308]), &#10;    MIN([Calculation_461900501144453122], [Calculation_461900501144555523])&#10;)&#10;ELSE MAX(&#10;    MAX([Calculation_461900501144293377], [Calculation_461900501144674308]), &#10;    MAX([Calculation_461900501144453122], [Calculation_461900501144555523])&#10;)&#10;END' />
            </column>
            <column caption='Worst Vertical Order Count Name' datatype='string' name='[Worst CVR Name (copy) (copy)_158048264140070920]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Worst CVR Comparison (copy) (copy)_158048264140070919]&#10;  WHEN [Calculation_461900501144293377] THEN &apos;Restaurant Order Count&apos;&#10;  WHEN [Calculation_461900501144674308] THEN &apos;Dmart Order Count&apos;&#10;  WHEN [Calculation_461900501144453122] THEN &apos;Shops Order Count&apos;&#10;  WHEN [Calculation_461900501144555523] THEN &apos;Other Vertical Order Count&apos;&#10;  ELSE &apos;&apos;&#10;END' />
            </column>
