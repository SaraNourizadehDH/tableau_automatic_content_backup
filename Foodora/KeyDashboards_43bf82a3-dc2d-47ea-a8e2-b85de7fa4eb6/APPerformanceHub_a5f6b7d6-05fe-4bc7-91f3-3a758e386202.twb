        <calculation class='tableau' formula='IF [Parameters].[Calendar Measures (copy)] = 1&#10;THEN MAX(&#10;    MAX([Calculation_799811201552506911], [Calculation_799811201557454903]), &#10;    MAX([Calculation_799811201561792605], [Calculation_799811201552789537])&#10;)&#10;ELSE MIN(&#10;    MIN([Calculation_799811201552506911], [Calculation_799811201557454903]), &#10;    MIN([Calculation_799811201561792605], [Calculation_799811201552789537])&#10;)&#10;END' />
