            <column caption='Organic Order Rate Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_189714193453985794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [organic_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END)) -&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [organic_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END))&#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [organic_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END))' />
            </column>
            <column caption='Date Comparison' datatype='string' name='[Calculation_799811201492168709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter 2] AND [created_date_local] &lt;= [Parameters].[Report Start Date (copy)_142426395933470745] THEN &quot;Report Date&quot;&#10;ELSEIF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter] AND [created_date_local] &lt;= [Parameters].[Previous Start Date (copy)_142426395933605914] THEN &quot;Previous Date&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Discount Order Rate Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Discount Order Count Comparison (copy)_158048264140853261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [non_corporate_discount_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END)) - &#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [non_corporate_discount_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END)) &#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [non_corporate_discount_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END))' />
            </column>
            <column caption='Latest overview created date local - 6' datatype='date' name='[Latest overview created date local (copy)_2442217651670155269]' role='dimension' type='ordinal'>
