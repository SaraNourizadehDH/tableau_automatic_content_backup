            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1o3jrka1un9788144uspe0j7aqzd].[Calculation_2442217651666337796]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1o3jrka1un9788144uspe0j7aqzd].[created_date_local]' caption='Report End Date' datatype='date' default-format='*dd/m/yyyy (ddd)' name='[Report Start Date (copy)_142426395933470745]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-22#'>
              <calculation class='tableau' formula='#2025-08-22#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.13tuvvu0dl2hkh14m21x816fuaek].[global_entity_id]' caption='Global Entity ID' datatype='string' name='[Vendor Measures (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;FP_SG&quot;'>
              <calculation class='tableau' formula='&quot;FP_SG&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13tuvvu0dl2hkh14m21x816fuaek'>
            <column caption='GID Filter' datatype='boolean' name='[Calculation_137852430334951425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [global_entity_id] = [Parameters].[Vendor Measures (copy)]&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Other Vertical Order Count' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_461900501142667264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vertical_courier_order_count] + [vertical_pandago_order_count] + [vertical_caterers_order_count] + [vertical_concepts_order_count] + [vertical_kitchens_order_count] + [vertical_pandamerchant_order_count] + [vertical_vouchers_order_count]' />
            </column>
            <column caption='Restaurant Order Count Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_461900501144293377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [vertical_restaurants_order_count] ELSE 0 END) - &#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [vertical_restaurants_order_count] ELSE 0 END)&#10;)/&#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [vertical_restaurants_order_count] ELSE 0 END)' />
            </column>
            <column caption='Shops Order Count Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_461900501144453122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#10;SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [vertical_shops_order_count] ELSE 0 END) - &#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [vertical_shops_order_count] ELSE 0 END)&#10;)/&#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [vertical_shops_order_count] ELSE 0 END), &#10;0)' />
            </column>
            <column caption='Other Vertical Order Count Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_461900501144555523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#10;SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [Calculation_461900501142667264] ELSE 0 END) - &#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [Calculation_461900501142667264] ELSE 0 END)&#10;)/&#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [Calculation_461900501142667264] ELSE 0 END),&#10;0)' />
            </column>
            <column caption='Dmart Order Count Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_461900501144674308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#10;SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [vertical_dmart_order_count] ELSE 0 END) - &#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [vertical_dmart_order_count] ELSE 0 END)&#10;)/&#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [vertical_dmart_order_count] ELSE 0 END),&#10;0)' />
            </column>
            <column caption='Date Comparison' datatype='string' name='[Calculation_799811201492168709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter 2] AND [created_date_local] &lt;= [Parameters].[Report Start Date (copy)_142426395933470745] THEN &quot;Report Date&quot;&#10;ELSEIF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter] AND [created_date_local] &lt;= [Parameters].[Previous Start Date (copy)_142426395933605914] THEN &quot;Previous Date&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Latest overview created date local - 6' datatype='date' name='[Latest overview created date local (copy)_2442217651670155269]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_date_local] - 6)}' />
            </column>
            <column caption='Latest overview created date local - 13' datatype='date' name='[Latest overview created date local - 7 (copy) (copy)_2442217651672100874]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_date_local] - 13)}' />
