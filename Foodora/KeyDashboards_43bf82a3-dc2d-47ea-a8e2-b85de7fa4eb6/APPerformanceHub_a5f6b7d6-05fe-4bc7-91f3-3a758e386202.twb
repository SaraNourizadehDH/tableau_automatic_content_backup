            <column caption='Shrink &gt;=3 Orders Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' hidden='true' name='[Calculation_2354890080567541786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END) - &#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END)&#10;)/&#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END)' />
