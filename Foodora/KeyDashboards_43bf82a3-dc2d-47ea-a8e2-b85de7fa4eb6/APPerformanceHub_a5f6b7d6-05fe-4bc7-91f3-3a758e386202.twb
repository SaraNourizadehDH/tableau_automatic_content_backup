            <column caption='Dynamic Measure' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_682576875480055821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Measures (copy 3)]&#10;    WHEN 1 THEN SUM([Calculation_277534337983746062])/(SUM([valid_order_count])-SUM([vertical_courier_order_count]))&#10;    WHEN 2 THEN SUM([Calculation_277534337983746062])&#10;    WHEN 3 THEN SUM([Gross Delivery Fee (copy)_277534337984045072])&#10;    WHEN 66 THEN SUM([Net Delivery Fee (copy)_277534337984528403])&#10;    WHEN 4 THEN SUM([Gross GMV (copy)_277534337984204817])&#10;    WHEN 5 THEN SUM([Gross GMV (copy)_277534337984204817])/SUM([valid_order_count])&#10;    WHEN 70 THEN SUM([Gross GMV (copy)_277534337984204817])/SUM([incentivised_order_count])&#10;    WHEN 69 THEN SUM([Gross GMV (copy)_277534337984204817])/SUM([Net Delivery Fee (copy)_277534337984528403])&#10;    WHEN 6 THEN SUM([GFV (copy)_277534337983889423])&#10;    WHEN 67 THEN SUM([Marketing Incentive Cost (copy)_277534337984397330])&#10;    WHEN 7 THEN SUM([GFV (copy)_277534337983889423])/SUM([valid_order_count])&#10;    WHEN 68 THEN SUM([Marketing Incentive Cost (copy)_277534337984397330])/SUM([valid_order_count])&#10;    WHEN 71 THEN SUM([GFV (copy)_277534337983889423])/SUM([valid_order_w_df_count])&#10;    WHEN 72 THEN SUM([Marketing Incentive Cost (copy)_277534337984397330])/SUM([valid_order_w_df_count])&#10;    WHEN 73 THEN SUM([GFV (copy)_277534337983889423])/SUM([valid_order_od_count])&#10;    WHEN 74 THEN SUM([Marketing Incentive Cost (copy)_277534337984397330])/SUM([valid_order_od_count])&#10;    WHEN 8 THEN SUM([delivery_time_in_minutes_n])/SUM([delivery_time_in_minutes_d])&#10;    WHEN 9 THEN SUM([promised_delivery_time_in_minutes_n])/SUM([promised_delivery_time_in_minutes_d])&#10;    WHEN 10 THEN SUM([order_delay_in_minutes_n])/SUM([order_delay_in_minutes_d])&#10;    WHEN 11 THEN SUM([failed_order_count])/SUM([gross_order_count])&#10;    WHEN 12 THEN SUM([customer_failed_order_count])/SUM([gross_order_count])&#10;    WHEN 13 THEN SUM([logistics_failed_order_count])/SUM([gross_order_count])&#