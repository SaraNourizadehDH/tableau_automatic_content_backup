              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [non_corporate_voucher_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END)) - &#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [non_corporate_voucher_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END))&#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [non_corporate_voucher_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END))' />
            </column>
            <column caption='Worst Incentives Order Rate' datatype='real' default-format='p0.0%' name='[Worst CVR (copy)_158048264140054531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Worst CVR Comparison (copy)_158048264140054532]&#10;  WHEN [Calculation_189714193453985794] THEN SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [organic_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [valid_order_count] ELSE 0 END)&#10;  WHEN [Discount Order Count Comparison (copy)_158048264140853261] THEN SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [non_corporate_discount_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [valid_order_count] ELSE 0 END)&#10;  WHEN [Voucher Order Count Comparison (copy)_158048264141225998] THEN SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [non_corporate_voucher_order_count] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &apos;Report Date&apos; THEN [valid_order_count] ELSE 0 END)&#10;  ELSE 0&#10;END' />
            </column>
            <column caption='Worst Incentives Order Rate Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Worst CVR Comparison (copy)_158048264140054532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Calendar Measures (copy)] = 1&#10;THEN MIN(&#10;    MIN([Calculation_189714193453985794], [Discount Order Count Comparison (copy)_158048264140853261]), [Voucher Order Count Comparison (copy)_158048264141225998] &#10;)&#10;ELSE MAX(&#10;    MAX([Calculation_189714193453985794], [Discount Order Count Comparison (copy)_158048264140853261]), [Voucher Order Count Comparison (copy)_158048264141225998] &#10;)&#10;END' />
            </column>
