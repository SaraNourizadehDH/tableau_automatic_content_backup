      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='regional apac targets' id='_13392C54B5D94DAB8DFD1CDDA2B4449F'>
            <properties context=''>
              <relation connection='bigquery.1nl6y6s09c47c4123ekcy145qf3h' name='Custom SQL Query' type='text'><![CDATA[SELECT
  months,
  CASE
    WHEN country = "Laos"
    THEN "FP_LA"
    WHEN country = "Taiwan"
    THEN "FP_TW"
    WHEN country = "Myanmar"
    THEN "FP_MM"
    WHEN country = "Cambodia"
    THEN "FP_KH"
    WHEN country = "Malaysia"
    THEN "FP_MY"
    WHEN country = "Pakistan"
    THEN "FP_PK"
    WHEN country = "Thailand"
    THEN "FP_TH"
    WHEN country = "Hong Kong"
    THEN "FP_HK"
    WHEN country = "Singapore"
    THEN "FP_SG"
    WHEN country = "Bangladesh"
    THEN "FP_BD"
    WHEN country = "Philippines"
    THEN "FP_PH"
  END AS global_entity_id,
  currency,
  gmv_incl_subsidies AS target_gmv_eur,
  total_orders_by_user_type AS target_order_count_eur
FROM `dhh---analytics-apac.pandata_ap_finance.lucanet_be_ct_latest`
WHERE record_type = "APAC country targets (APAC internal only)"
  AND months >>= DATE_SUB(CURRENT_DATE, INTERVAL 90 DAY)
  /* mainly used together with regional_apac_pandata_af_metric_attribution_overview_daily table
    that has 1st feb data as the earliest date */
  AND currency = "EUR"
  AND country NOT IN ("Japan", "Woowa DH Asia", "SSC Malaysia", "DH APAC", "APAC")
  AND months <<= DATE_TRUNC(CURRENT_DATE, MONTH)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_13392C54B5D94DAB8DFD1CDDA2B4449F' table='[Extract].[_13392C54B5D94DAB8DFD1CDDA2B4449F]' type='table' />
            </properties>
          </object>
          <object caption='regional_apac_daily_runrates' id='regional_apac_daily_runrates_DD48D838CD59413D95D09942FC7EDDCD'>
            <properties context=''>
              <relation connection='bigquery.1nl6y6s09c47c4123ekcy145qf3h' name='Custom SQL Query1' type='text'><![CDATA[WITH lucanet_monthly_targets AS (
  SELECT
    months,
    CASE
      WHEN country = "Laos"
      THEN "FP_LA"
      WHEN country = "Taiwan"
      THEN "FP_TW"
      WHEN country = "Myanmar"
      THEN "FP_MM"
      WHEN country = "Cambodia"
      THEN "FP_KH"
      WHEN country = "Malaysia"
      THEN "FP_MY"
      WHEN country = "Pakistan"
      THEN "FP_PK"
      WHEN country = "Thailand"
      THEN "FP_TH"
      WHEN country = "Hong Kong"
      THEN "FP_HK"
      WHEN country = "Singapore"
      THEN "FP_SG"
      WHEN country = "Bangladesh"
      THEN "FP_BD"
      WHEN country = "Philippines"
      THEN "FP_PH"
    END AS global_entity_id,
    currency,
    gmv_incl_subsidies AS target_gmv_eur,
    total_orders_by_user_type AS target_order_count_eur
  FROM `dhh---analytics-apac.pandata_ap_finance.lucanet_be_ct_latest`
  WHERE record_type = "APAC country targets (APAC internal only)"
    AND months >>= DATE_SUB(CURRENT_DATE, INTERVAL 90 DAY)
    /* mainly used together with regional_apac_pandata_af_metric_attribution_overview_daily table
      that has 1st feb data as the earliest date */
    AND currency = "EUR"
    AND country NOT IN ("Japan", "Woowa DH Asia", "SSC Malaysia", "DH APAC", "APAC")
    AND months <<= DATE_TRUNC(CURRENT_DATE, MONTH)
),

daily_runrates_and_targets AS (
  SELECT
    runrates.*,
    targets.target_order_count_eur / EXTRACT(DAY FROM last_day(runrates.order_date, MONTH)) AS daily_target_order_count_eur,
    targets.target_gmv_eur / EXTRACT(DAY FROM last_day(runrates.order_date, MONTH)) AS daily_target_gmv_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_daily_runrates` AS runrates
  LEFT JOIN lucanet_monthly_targets AS targets
        ON targets.months = DATE_TRUNC(runrates.order_date, month)
        AND targets.global_entity_id = runrates.global_entity_id
  WHERE runrates.order_date >>= DATE_SUB(CURRENT_DATE, INTERVAL 90 DAY)
)

SELECT
  *,
  SUM(daily_target_order_count_eur)
    OVER(PARTITION BY global_entity_id, DATE_TRUNC(order_date, month)
    ORDER BY order_date
  ) AS daily_cum_target_order_count,
  SUM(daily_target_gmv_eur)
    OVER(PARTITION BY global_entity_id, DATE_TRUNC(order_date, month)
    ORDER BY order_date
  ) AS daily_cum_target_gmv_eur,
FROM daily_runrates_and_targets]]></relation>
            </properties>
