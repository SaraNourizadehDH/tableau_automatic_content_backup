              <calculation class='tableau' formula='IF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter 2] AND [created_date_local] &lt;= [Parameters].[Report Start Date (copy)_142426395933470745] THEN &quot;Report Date&quot;&#10;ELSEIF [created_date_local] &gt;= [Parameters].[Created Date Local Parameter] AND [created_date_local] &lt;= [Parameters].[Previous Start Date (copy)_142426395933605914] THEN &quot;Previous Date&quot;&#10;ELSE NULL&#10;END' />
