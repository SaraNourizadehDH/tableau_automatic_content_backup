        <calculation class='tableau' formula='(&#10;SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [Net Delivery Fee (copy)_277534337984528403] ELSE 0 END) - &#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [Net Delivery Fee (copy)_277534337984528403] ELSE 0 END)&#10;)/&#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [Net Delivery Fee (copy)_277534337984528403] ELSE 0 END)' />
      </column>
      <column caption='Dynamic Measure' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_682576875480055821]' role='measure' type='quantitative'>
