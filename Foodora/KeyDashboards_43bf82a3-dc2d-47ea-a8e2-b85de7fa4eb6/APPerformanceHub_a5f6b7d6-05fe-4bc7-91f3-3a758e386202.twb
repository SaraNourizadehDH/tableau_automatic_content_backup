              <calculation class='tableau' formula='IF [global_entity_id] = [Parameters].[Vendor Measures (copy)]&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Surge Order Rate Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_189714193461862406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [surge_orders] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END)) - &#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [surge_orders] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END))&#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [surge_orders] ELSE 0 END)/SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END))' />
            </column>
            <column caption='Shrink Order Loss Rate Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' name='[Calculation_189714193462132743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        (SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_orders] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [close_orders] ELSE 0 END))&#10;        /(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_orders] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [close_orders] ELSE 0 END))&#10;    ) - &#10;    (&#10;        (SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_orders] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [close_orders] ELSE 0 END))&#10;        /(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_orders] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [close_orders] ELSE 0 END))&#10;    )&#10;)/&#10;(&#10;    (SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_orders] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [close_orders] ELSE 0 END))&#10;    /(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_orders] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [close_orders] ELSE 0 END))&#10;)' />
            </column>
            <column caption='Shrink Orders Comparison' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%; ~ 0.0%' hidden='true' name='[Calculation_2354890080566890517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_orders] ELSE 0 END) - &#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_orders] ELSE 0 END)&#10;)/&#10;SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_orders] ELSE 0 END)' />
