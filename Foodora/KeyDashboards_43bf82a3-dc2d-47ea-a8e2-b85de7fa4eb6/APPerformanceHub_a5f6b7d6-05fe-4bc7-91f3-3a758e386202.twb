            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.13tuvvu0dl2hkh14m21x816fuaek].[global_entity_id]' caption='Global Entity ID' datatype='string' name='[Vendor Measures (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;FP_SG&quot;'>
