              <calculation class='tableau' formula='(&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Report Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END))) - &#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END)))&#10;)/&#10;(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END)/(SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [valid_order_count] ELSE 0 END) + SUM(IF [Calculation_799811201492168709] = &quot;Previous Date&quot; THEN [shrink_3_and_above_orders] ELSE 0 END)))' />
            </column>
