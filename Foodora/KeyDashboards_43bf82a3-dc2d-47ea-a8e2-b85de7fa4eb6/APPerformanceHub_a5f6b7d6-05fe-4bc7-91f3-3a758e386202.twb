            </column>
            <column caption='Runrate Status' datatype='string' name='[Calculation_1530731327475171328]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Measures (copy 3)] = 19 AND //valid order count&#10;  [Calculation_4196510458882662410] &gt; 1.07 THEN &quot;Over Plan&quot;&#10;ELSEIF [Parameters].[Measures (copy 3)] = 19 AND&#10;  [Calculation_4196510458882662410] &lt; 0.93 THEN &quot;Behind Plan&quot;&#10;ELSEIF [Parameters].[Measures (copy 3)] = 66 AND // Net GMV&#10;  [Calculation_4196510458882662410] &gt; 1.08 THEN &quot;Over Plan&quot;&#10;ELSEIF [Parameters].[Measures (copy 3)] = 66 AND&#10;  [Calculation_4196510458882662410] &lt; 0.92 THEN &quot;Behind Plan&quot;&#10;ELSE &quot;On Plan&quot; &#10;END' />
            </column>
            <column caption='datename' datatype='boolean' name='[Calculation_3880273326446256129]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;day&apos;, DATE(TODAY())) = 1&#10;THEN [Calculation_1458181147540840448] = DATE(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, today())))&#10;ELSE [Calculation_1458181147540840448] = DATE(DATETRUNC(&apos;month&apos;, today()))&#10;END' />
            </column>
            <column caption='Target vs. Actual - Dynamic Measures' datatype='real' name='[Calculation_4196510458867408899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Measures (copy 3)]&#10;  WHEN 19 THEN SUM([valid_order_count])&#10;  WHEN 66 THEN SUM([Net Delivery Fee (copy)_277534337984528403])&#10;END' />
            </column>
            <column caption='Dynamic Measure - Actual over Target' datatype='real' name='[Calculation_4196510458875695110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Measures (copy 3)]&#10;  WHEN 19 THEN SUM([valid_order_count])/SUM([target_order_count_eur])&#10;  WHEN 66 THEN SUM([net_gmv_eur])/SUM([target_gmv_eur])&#10;END' />
            </column>
            <column caption='Target Dynamic Measure' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_4196510458876502023]' role='measure' type='quantitative'>
