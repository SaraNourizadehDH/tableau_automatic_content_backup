          <datasource-dependencies datasource='federated.13tuvvu0dl2hkh14m21x816fuaek'>
            <column caption='Dates for Trends' datatype='boolean' name='[Calculation_106116125978492928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Created Date Local] &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -4, [Created Date Local])) AND [Created Date Local] &lt;= DATETRUNC(&apos;week&apos;, [Created Date Local])&#10;{ &#10;FIXED [Calculation_5103352496644923392] : &#10;    IF COUNTD([created_date_local]) = 7 &#10;    THEN TRUE&#10;    ELSE FALSE&#10;    END&#10;}' />
            </column>
            <column caption='GID Filter' datatype='boolean' name='[Calculation_137852430334951425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [global_entity_id] = [Parameters].[Vendor Measures (copy)]&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='View Swap Selected' datatype='string' name='[Calculation_33988159049314305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Previous Date (copy)]' />
            </column>
            <column caption='Other Vertical Order Count' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_461900501142667264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vertical_courier_order_count] + [vertical_pandago_order_count] + [vertical_caterers_order_count] + [vertical_concepts_order_count] + [vertical_kitchens_order_count] + [vertical_pandamerchant_order_count] + [vertical_vouchers_order_count]' />
            </column>
            <column caption='Restaurant Order Rate' datatype='real' default-format='p0.0%' name='[Calculation_461900501173293076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vertical_restaurants_order_count])/SUM([valid_order_count])' />
            </column>
            <column caption='Other Vertical Order Rate' datatype='real' default-format='p0.0%' name='[Calculation_461900501173407765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_461900501142667264])/SUM([valid_order_count])' />
            </column>
            <column caption='Shops Order Rate' datatype='real' default-format='p0.0%' name='[Calculation_461900501173506070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vertical_shops_order_count])/SUM([valid_order_count])' />
            </column>
            <column caption='Dmart Order Rate' datatype='real' default-format='p0.0%' name='[Calculation_461900501173620759]' role='measure' type='quantitative'>
