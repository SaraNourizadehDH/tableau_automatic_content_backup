    <worksheet name='Surge Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Metric Attribution Overview' name='federated.13tuvvu0dl2hkh14m21x816fuaek' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Tree' datatype='string' name='[Previous Date (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
              <calculation class='tableau' formula='&quot;GMV&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.13tuvvu0dl2hkh14m21x816fuaek].[global_entity_id]' caption='Global Entity ID' datatype='string' name='[Vendor Measures (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;FP_SG&quot;'>
              <calculation class='tableau' formula='&quot;FP_SG&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13tuvvu0dl2hkh14m21x816fuaek'>
            <column caption='Dates for Trends' datatype='boolean' name='[Calculation_106116125978492928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Created Date Local] &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -4, [Created Date Local])) AND [Created Date Local] &lt;= DATETRUNC(&apos;week&apos;, [Created Date Local])&#10;{ &#10;FIXED [Calculation_5103352496644923392] : &#10;    IF COUNTD([created_date_local]) = 7 &#10;    THEN TRUE&#10;    ELSE FALSE&#10;    END&#10;}' />
            </column>
            <column caption='GID Filter' datatype='boolean' name='[Calculation_137852430334951425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [global_entity_id] = [Parameters].[Vendor Measures (copy)]&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='View Swap Selected' datatype='string' name='[Calculation_33988159049314305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Previous Date (copy)]' />
            </column>
            <column caption='Created Date Weeknum' datatype='integer' name='[Calculation_5103352496644923392]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ISOWEEK([created_date_local])' />
            </column>
            <column caption='Shrink Order Loss Rate' datatype='real' default-format='p0.0%' name='[Calculation_799811201559986254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([shrink_orders]) + sum([close_orders]))/(SUM([valid_order_count]) + SUM([shrink_orders]) + sum([close_orders]))' />
            </column>
            <column caption='Surge Order Rate' datatype='real' default-format='p0.0%' name='[Calculation_799811201561509978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surge_orders])/SUM([valid_order_count])' />
            </column>
            <column caption='Close Orders' datatype='real' name='[close_orders]' role='measure' type='quantitative' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_106116125978492928]' derivation='None' name='[none:Calculation_106116125978492928:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_137852430334951425]' derivation='None' name='[none:Calculation_137852430334951425:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_33988159049314305]' derivation='None' name='[none:Calculation_33988159049314305:nk]' pivot='key' type='nominal' />
            <column caption='Shrink Orders' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[shrink_orders]' role='measure' type='quantitative' />
            <column-instance column='[shrink_orders]' derivation='Sum' name='[sum:shrink_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[surge_orders]' derivation='Sum' name='[sum:surge_orders:qk]' pivot='key' type='quantitative' />
