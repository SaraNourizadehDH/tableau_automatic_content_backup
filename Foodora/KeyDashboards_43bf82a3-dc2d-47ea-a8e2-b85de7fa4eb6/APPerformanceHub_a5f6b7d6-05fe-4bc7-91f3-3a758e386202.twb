          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14' underline='true'>Changelog</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>A log showing the changes to the dashboard or underlying tables</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' underline='true'>2024-09-06</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>-</run>
              <run bold='true' fontcolor='#000000'>Æ </run>
              <run fontcolor='#000000'>Added the following metrics for Vendor Measures under </run>
              <run bold='true' fontcolor='#000000'>Vendor Drilldown Tab</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>  - </run>
              <run fontcolor='#000000'>Gross OD GMV, Gross PU GMV, Net OD GMV, Net PU GMV, Valid OD Order Count, Valid PU Order Count</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- With the </run>
              <run bold='true' fontcolor='#000000'>migration of pd_orders to coredata_business.orders</run>
              <run fontcolor='#000000'>, the following metrics will be affected due to a change in definitions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>  - Customer Failed Order Rate, Logistics Failed Order Rate, Vendor Failed Order Rate, Customer Cancelled Order Rate, Post Delivery Issue Order Rate, Logistics Cancelled Order Rate, Vendor Declined Order Rate</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' underline='true'>2024-07-07</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>-</run>
              <run bold='true' fontcolor='#000000'>Æ </run>
              <run fontcolor='#000000'>Added </run>
              <run bold='true' fontcolor='#000000'>Pro vs Non Pro</run>
              <run fontcolor='#000000'> segment breakdown under </run>
              <run bold='true' fontcolor='#000000'>Segment Drilldown Tab</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' underline='true'>2024-07-05</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>-</run>
              <run bold='true' fontcolor='#000000'>Æ </run>
              <run fontcolor='#000000'>Added </run>
              <run bold='true' fontcolor='#000000'>Target vs. Actual and Runrate</run>
              <run fontcolor='#000000'> visualization to understand if we’re on track to meet the target at the end of the month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' underline='true'>2024-06-05</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- To adhere to the gold standard of dashboards that the APAC Data Team is implementing, the following changes have been made</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Renamed </run>
              <run bold='true' fontcolor='#000000'>Performance Hub </run>
              <run fontcolor='#000000'>dashboard to </run>
              <run bold='true' fontcolor='#000000'>[AP] Performance Hub</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Added </run>
              <run bold='true' fontcolor='#000000'>Description</run>
              <run fontcolor='#000000'> tab</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Renamed </run>
              <run bold='true' fontcolor='#000000'>Glossary </run>
              <run fontcolor='#000000'>tab to </run>
              <run bold='true' fontcolor='#000000'>Metric Definitions</run>
              <run fontcolor='#000000'>. Content remains the same</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Renamed </run>
              <run bold='true' fontcolor='#000000'>Data Freshness </run>
              <run fontcolor='#000000'>tab to </run>
              <run bold='true' fontcolor='#000000'>Data Quality Checks. </run>
              <run fontcolor='#000000'>Content remains the same</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' underline='true'>2024-05-28</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Added Changelog Tab, showing the changes to the dashboard or underlying tables</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Temporary. To find a better way to have this</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Added a </run>
              <run bold='true' fontcolor='#000000'>Metrics Quality</run>
              <run fontcolor='#000000'> check section under </run>
              <run bold='true' fontcolor='#000000'>Data Freshness</run>
              <run fontcolor='#000000'> tab</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Explanation in the tab itself</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - A first cut to gather feedback</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' underline='true'>2024-05-24</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- HK zones have been remapped using </run>
              <run bold='true' fontcolor='#000000'>country_HK_lg_zone_groups</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>- </run>
              <run fontcolor='#000000'>Added a </run>
              <run bold='true' fontcolor='#000000'>Vertical Type</run>
              <run fontcolor='#000000'> filter on </run>
              <run bold='true' fontcolor='#000000'>Vendor Drilldown</run>
              <run fontcolor='#000000'> tab</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - These verticals are actually business types, i.e. dmart, shops</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Does </run>
              <run bold='true' fontcolor='#000000' underline='true'>not</run>
              <run fontcolor='#000000'> show pickup, since pickup is a delivery type</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' underline='true'>2024-05-14</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Fixes to gross DFO, which was null due to underlying table issues</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Explicit naming for the following metrics</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Incentive Cost per Incentivised Order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Incentive Cost per Valid Order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Net/Gross Delivery Fee per Valid Order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Net/Gross Delivery Fee per OD Order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'> - Net/Gross Delivery Fee per Order with DF</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
