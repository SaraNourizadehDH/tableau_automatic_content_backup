          <datasource-dependencies datasource='federated.11omran1ganeho1dw4hh20k3wsho'>
            <column caption='Most Recent Week' datatype='date' name='[Calculation_2006494393578586113]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([report_week])}' />
            </column>
            <column caption='Past Week' datatype='string' name='[Calculation_2006494393578852355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_week] = DATEADD(&apos;week&apos;, -1, [Calculation_2006494393578586113])&#10;THEN &apos;L2W&apos;&#10;ELSEIF [report_week] = DATEADD(&apos;week&apos;, -2, [Calculation_2006494393578586113])&#10;THEN &apos;L3W&apos;&#10;END' />
            </column>
            <column caption='SUM(IF [Report Week] = [Most Recent Week] THEN [dmart_sum_val...' datatype='real' name='[Calculation_3021070954257170433]' role='measure' type='quantitative' user:unnamed='QC W-2 (2)'>
