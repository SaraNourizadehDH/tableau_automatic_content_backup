              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_shops]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_shops]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_shops]/[Parameters].[Currency (copy)]&#10;END' />
