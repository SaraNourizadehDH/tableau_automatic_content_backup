            </column>
            <column caption='SUM(IF [Report Week] = [Most Recent Week] THEN [fill_rate] EN...' datatype='real' name='[Calculation_3021070954263724101]' role='measure' type='quantitative' user:unnamed='Logistics W-1'>
              <calculation class='tableau' formula='SUM(IF [report_week] = [Calculation_2006494393578586113] THEN [fill_rate] END)-SUM(IF [Calculation_2006494393578852355] = &apos;L2W&apos; THEN [fill_rate] END)' />
