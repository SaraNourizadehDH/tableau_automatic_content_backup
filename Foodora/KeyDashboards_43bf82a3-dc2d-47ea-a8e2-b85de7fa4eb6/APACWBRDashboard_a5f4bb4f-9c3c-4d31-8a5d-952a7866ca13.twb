    <datasource caption='productivity metrics' inline='true' name='federated.1bspdg20107yi21c2yxa50986m2f' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1nhmih501bhuy4137d3sa0to1vvc'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='shernis.ong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1nhmih501bhuy4137d3sa0to1vvc' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
  SELECT
    DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 52 WEEK) AS start_date,
    DATE_TRUNC(current_date(), ISOWEEK) AS end_date
),

users_monthly AS (
  SELECT
    users.report_date AS report_month, -- only monthly granularity
    users.country,
    countries.global_entity_id,
    users.sf_user_id,
    users.user_type,
    users.account_age_snapshot,
    users.is_active_snapshot,
    users.is_contractor
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
          ON users.country = countries.name
),

lao AS (
  SELECT
    global_entity_id,
    country,
    city,
    sf_opportunity_id,
    first_qc_success_date_utc,
    activation_date,
    opportunity_business_type,
    lead_source,
    vertical_segment,
    vendor_code,
    vendor_type,
    vendor_grade,
    is_successful_signup,
    is_won,
    is_closed,
    incubated_date_30_days,
    IF(vendor_grade IN ("A","AA","AAA","B") AND is_gtc_acquisition, TRUE, FALSE) AS is_prio_gtc_acquisition,
  --owner attributes
    sf_opportunity_owner_id,
  FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` lao
  WHERE 
    vendor_type = "Restaurants"
    AND vertical_segment != "caterers"
    AND opportunity_business_type != 'Upgrade/Upsell'
    AND (activation_date >>= (SELECT parameters.start_date FROM parameters)
    OR first_qc_submission_date_utc >>= (SELECT parameters.start_date FROM parameters)
    )
),

activations AS (
  SELECT 
    activation_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_activations,
    COUNT(DISTINCT IF(vendor_grade IN ('A','B', 'AA', 'AAA'),sf_opportunity_id, NULL )) AS num_ab_activations,
  FROM lao
  WHERE is_won
  GROUP BY
    activation_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition
),

signings AS (
  SELECT 
    first_qc_success_date_utc AS signing_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_signings
  FROM lao
  WHERE is_successful_signup
  GROUP BY
    signing_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition
),

activations_and_signings AS (
  SELECT 
    COALESCE(signings.signing_date, activations.activation_date) AS report_date,
    COALESCE(signings.global_entity_id, activations.global_entity_id) AS global_entity_id,
    COALESCE(signings.country, activations.country) AS country,
    COALESCE(signings.city, activations.city) AS city,
    COALESCE(signings.opportunity_business_type, activations.opportunity_business_type) AS opportunity_business_type,
    COALESCE(signings.sf_opportunity_owner_id, activations.sf_opportunity_owner_id) AS sf_opportunity_owner_id,
    COALESCE(signings.lead_source,activations.lead_source) AS lead_source,
    COALESCE(signings.vendor_type, activations.vendor_type) AS vendor_type,
    COALESCE(signings.vendor_grade, activations.vendor_grade) AS vendor_grade,
    COALESCE(signings.is_prio_gtc_acquisition, activations.is_prio_gtc_acquisition) AS is_prio_gtc_acquisition,
    COALESCE(signings.num_signings, 0) AS num_signings,
    COALESCE(activations.num_activations, 0) AS num_activations,
    COALESCE(activations.num_ab_activations, 0) AS num_ab_activations
  FROM signings
  FULL JOIN activations
         ON signings.signing_date = activations.activation_date
        AND signings.global_entity_id = activations.global_entity_id
        AND signings.city = activations.city
        AND signings.opportunity_business_type = activations.opportunity_business_type
        AND signings.sf_opportunity_owner_id = activations.sf_opportunity_owner_id
        AND signings.lead_source = activations.lead_source
        AND signings.vendor_grade = activations.vendor_grade
        AND signings.vendor_type = activations.vendor_type
        AND signings.is_prio_gtc_acquisition = activations.is_prio_gtc_acquisition
),

agg AS (
  SELECT 
    activations_and_signings.report_date,
    users_monthly.global_entity_id,
    users_monthly.country AS user_country,
    users_monthly.sf_user_id,
    users_monthly.user_type,
    users_monthly.account_age_snapshot,
    users_monthly.is_active_snapshot,
    activations_and_signings.opportunity_business_type,
    COALESCE(activations_and_signings.num_activations, 0) AS num_activations,
    COALESCE(activations_and_signings.num_ab_activations, 0) AS num_ab_activations,
    COALESCE(activations_and_signings.num_signings, 0) AS num_signings
  FROM users_monthly
  LEFT JOIN activations_and_signings
        ON users_monthly.report_month = DATE_TRUNC(activations_and_signings.report_date, MONTH)
        AND users_monthly.sf_user_id = activations_and_signings.sf_opportunity_owner_id
),

user_agg AS (
  SELECT 
    report_date,
    global_entity_id,
    user_country as country,
    sf_user_id,
    SUM(num_activations) AS num_activations,
    SUM(num_ab_activations) AS num_ab_activations,
  FROM agg
  WHERE      
    opportunity_business_type IN ('New Business', 'Win Back')
    AND account_age_snapshot >>= 60
    AND is_active_snapshot
    AND user_type IN ("field rep", "telesales")
    AND report_date >>= (SELECT parameters.start_date FROM parameters)
  GROUP BY
    report_date,
    global_entity_id,
    country,
    sf_user_id
)

SELECT 
  'week' AS date_dimension,
 DATE_TRUNC(report_date, ISOWEEK) AS date,
 global_entity_id,
 SUM(num_activations) AS num_activations,
COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END) AS distinct_user_count,
ROUND(SAFE_DIVIDE(SUM(num_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS productivity,
SUM(num_ab_activations) AS num_ab_activations,
ROUND(SAFE_DIVIDE(SUM(num_ab_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS ab_productivity
FROM user_agg
WHERE report_date <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)
GROUP BY ALL

UNION ALL 

SELECT 
 'month' AS date_dimension,
 DATE_TRUNC(report_date, MONTH) AS date,
 global_entity_id,
 SUM(num_activations) AS num_activations,
COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END) AS distinct_user_count,
ROUND(SAFE_DIVIDE(SUM(num_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS productivity,
SUM(num_ab_activations) AS num_ab_activations,
ROUND(SAFE_DIVIDE(SUM(num_ab_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS ab_productivity
FROM user_agg
WHERE report_date <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)

GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1nhmih501bhuy4137d3sa0to1vvc' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
  SELECT
    DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 52 WEEK) AS start_date,
    DATE_TRUNC(current_date(), ISOWEEK) AS end_date
),

users_monthly AS (
  SELECT
    users.report_date AS report_month, -- only monthly granularity
    users.country,
    countries.global_entity_id,
    users.sf_user_id,
    users.user_type,
    users.account_age_snapshot,
    users.is_active_snapshot,
    users.is_contractor
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
          ON users.country = countries.name
),

lao AS (
  SELECT
    global_entity_id,
    country,
    city,
    sf_opportunity_id,
    first_qc_success_date_utc,
    activation_date,
    opportunity_business_type,
    lead_source,
    vertical_segment,
    vendor_code,
    vendor_type,
    vendor_grade,
    is_successful_signup,
    is_won,
    is_closed,
    incubated_date_30_days,
    IF(vendor_grade IN ("A","AA","AAA","B") AND is_gtc_acquisition, TRUE, FALSE) AS is_prio_gtc_acquisition,
  --owner attributes
    sf_opportunity_owner_id,
  FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` lao
  WHERE 
    vendor_type = "Restaurants"
    AND vertical_segment != "caterers"
    AND opportunity_business_type != 'Upgrade/Upsell'
    AND (activation_date >>= (SELECT parameters.start_date FROM parameters)
    OR first_qc_submission_date_utc >>= (SELECT parameters.start_date FROM parameters)
    )
),

activations AS (
  SELECT 
    activation_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_activations,
    COUNT(DISTINCT IF(vendor_grade IN ('A','B', 'AA', 'AAA'),sf_opportunity_id, NULL )) AS num_ab_activations,
  FROM lao
  WHERE is_won
  GROUP BY
    activation_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition
),

signings AS (
  SELECT 
    first_qc_success_date_utc AS signing_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_signings
  FROM lao
  WHERE is_successful_signup
  GROUP BY
    signing_date,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition
),

activations_and_signings AS (
  SELECT 
    COALESCE(signings.signing_date, activations.activation_date) AS report_date,
    COALESCE(signings.global_entity_id, activations.global_entity_id) AS global_entity_id,
    COALESCE(signings.country, activations.country) AS country,
    COALESCE(signings.city, activations.city) AS city,
    COALESCE(signings.opportunity_business_type, activations.opportunity_business_type) AS opportunity_business_type,
    COALESCE(signings.sf_opportunity_owner_id, activations.sf_opportunity_owner_id) AS sf_opportunity_owner_id,
    COALESCE(signings.lead_source,activations.lead_source) AS lead_source,
    COALESCE(signings.vendor_type, activations.vendor_type) AS vendor_type,
    COALESCE(signings.vendor_grade, activations.vendor_grade) AS vendor_grade,
    COALESCE(signings.is_prio_gtc_acquisition, activations.is_prio_gtc_acquisition) AS is_prio_gtc_acquisition,
    COALESCE(signings.num_signings, 0) AS num_signings,
    COALESCE(activations.num_activations, 0) AS num_activations,
    COALESCE(activations.num_ab_activations, 0) AS num_ab_activations
  FROM signings
  FULL JOIN activations
         ON signings.signing_date = activations.activation_date
        AND signings.global_entity_id = activations.global_entity_id
        AND signings.city = activations.city
        AND signings.opportunity_business_type = activations.opportunity_business_type
        AND signings.sf_opportunity_owner_id = activations.sf_opportunity_owner_id
        AND signings.lead_source = activations.lead_source
        AND signings.vendor_grade = activations.vendor_grade
        AND signings.vendor_type = activations.vendor_type
        AND signings.is_prio_gtc_acquisition = activations.is_prio_gtc_acquisition
),

agg AS (
  SELECT 
    activations_and_signings.report_date,
    users_monthly.global_entity_id,
    users_monthly.country AS user_country,
    users_monthly.sf_user_id,
    users_monthly.user_type,
    users_monthly.account_age_snapshot,
    users_monthly.is_active_snapshot,
    activations_and_signings.opportunity_business_type,
    COALESCE(activations_and_signings.num_activations, 0) AS num_activations,
    COALESCE(activations_and_signings.num_ab_activations, 0) AS num_ab_activations,
    COALESCE(activations_and_signings.num_signings, 0) AS num_signings
  FROM users_monthly
  LEFT JOIN activations_and_signings
        ON users_monthly.report_month = DATE_TRUNC(activations_and_signings.report_date, MONTH)
        AND users_monthly.sf_user_id = activations_and_signings.sf_opportunity_owner_id
),

user_agg AS (
  SELECT 
    report_date,
    global_entity_id,
    user_country as country,
    sf_user_id,
    SUM(num_activations) AS num_activations,
    SUM(num_ab_activations) AS num_ab_activations,
  FROM agg
  WHERE      
    opportunity_business_type IN ('New Business', 'Win Back')
    AND account_age_snapshot >>= 60
    AND is_active_snapshot
    AND user_type IN ("field rep", "telesales")
    AND report_date >>= (SELECT parameters.start_date FROM parameters)
  GROUP BY
    report_date,
    global_entity_id,
    country,
    sf_user_id
)

SELECT 
  'week' AS date_dimension,
 DATE_TRUNC(report_date, ISOWEEK) AS date,
 global_entity_id,
 SUM(num_activations) AS num_activations,
COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END) AS distinct_user_count,
ROUND(SAFE_DIVIDE(SUM(num_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS productivity,
SUM(num_ab_activations) AS num_ab_activations,
ROUND(SAFE_DIVIDE(SUM(num_ab_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS ab_productivity
FROM user_agg
WHERE report_date <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)
GROUP BY ALL

UNION ALL 

SELECT 
 'month' AS date_dimension,
 DATE_TRUNC(report_date, MONTH) AS date,
 global_entity_id,
 SUM(num_activations) AS num_activations,
COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END) AS distinct_user_count,
ROUND(SAFE_DIVIDE(SUM(num_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS productivity,
SUM(num_ab_activations) AS num_ab_activations,
ROUND(SAFE_DIVIDE(SUM(num_ab_activations), COUNT(DISTINCT CASE WHEN num_activations >>= 2 THEN sf_user_id END))) AS ab_productivity
FROM user_agg
WHERE report_date <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)

GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
