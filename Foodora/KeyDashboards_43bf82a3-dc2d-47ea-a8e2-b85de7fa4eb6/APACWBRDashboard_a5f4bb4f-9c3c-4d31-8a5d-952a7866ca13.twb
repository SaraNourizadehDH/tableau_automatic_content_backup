              <calculation class='tableau' formula='[pickup_orders]/[pickup_sessions]' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_661325482753429512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [df_user_paid_excl_vat_local]&#10;WHEN &apos;Eur&apos; THEN [df_user_paid_excl_vat_eur]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [df_user_paid_excl_vat_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='DF/OD MTD' datatype='real' name='[Calculation_661325482753839114]' role='measure' type='quantitative'>
