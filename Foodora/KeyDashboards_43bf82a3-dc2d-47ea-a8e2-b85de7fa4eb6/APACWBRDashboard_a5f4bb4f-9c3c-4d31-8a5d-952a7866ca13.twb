        <calculation class='tableau' formula='IF ISNULL([Parameters].[Parameter 1]) OR ISNULL([Parameters].[Start Date (copy)_4117275258473255008]) THEN&#10;[week] &gt;= DATEADD(&apos;week&apos;, -6, DATETRUNC(&apos;week&apos;, TODAY()))&#10;ELSE&#10;[week] &gt;= [Parameters].[Parameter 1] AND [week] &lt;= [Parameters].[Start Date (copy)_4117275258473255008]&#10;END' />
