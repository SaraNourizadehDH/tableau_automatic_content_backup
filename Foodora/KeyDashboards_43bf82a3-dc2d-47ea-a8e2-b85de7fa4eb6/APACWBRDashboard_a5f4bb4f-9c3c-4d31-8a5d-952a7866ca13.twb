          </datasources>
          <datasource-dependencies datasource='federated.0rmp22o0x05sf718rtt0n1dabpi1'>
            <column caption='% Vendors F30D Orders' datatype='real' name='[Calculation_2136887696418938892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([d30_has_order])/SUM([vendor_count])' />
            </column>
            <column caption='Most Recent Week' datatype='date' name='[Calculation_2136887696423055389]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='L2W' datatype='boolean' name='[Calculation_2136887696423133214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date] = DATEADD(&apos;week&apos;, -1, {MAX([date])})&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Vendors F30D LOD' datatype='real' name='[Calculation_2335046080083361834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id] :&#10;[Calculation_2136887696418938892]&#10;}' />
            </column>
            <column caption='SUM(IF [Date] = [Most Recent Week] THEN [Vendors F30D LOD] EN...' datatype='real' name='[Calculation_2335046080084529198]' role='measure' type='quantitative' user:unnamed='Incubation WoW'>
              <calculation class='tableau' formula='SUM(IF [date] = [Calculation_2136887696423055389] THEN [Calculation_2335046080083361834] END)-SUM(IF [Calculation_2136887696423133214] THEN [Calculation_2335046080083361834] END)' />
            </column>
