              <calculation class='tableau' formula='SUM(IF [report_week] = [Calculation_2006494393578586113] THEN [Calculation_661325482723196933] END)/SUM(IF [Calculation_2006494393578852355] = &apos;L2W&apos; THEN [Calculation_661325482723196933] END)-1' />
