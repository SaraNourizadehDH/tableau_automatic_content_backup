            <column caption='Incentives (w/ DF) MTD' datatype='real' name='[Calculation_661325482753966091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [incentives_local_with_df]&#10;WHEN &apos;Eur&apos; THEN [incentives_eur_with_df]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [incentives_local_with_df]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='iCPGMV MTD' datatype='real' name='[Calculation_661325482754154508]' role='measure' type='quantitative'>
