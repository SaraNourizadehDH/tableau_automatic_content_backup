            <column caption='FX Neutral' datatype='real' name='[Currency (copy)]' param-domain-type='any' role='measure' type='quantitative' value='61.63233992'>
              <calculation class='tableau' formula='61.63233992' />
            </column>
            <column alias='Eur (€)' caption='Currency' datatype='string' name='[country_name Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='Eur (€)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0avpxc00gslmia1dr48070up6hpk'>
            <column caption='Total GMV MTD' datatype='real' name='[Calculation_2006494393620963554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_total]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_total]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_total]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='OD_Food_GMV_MTD' datatype='real' name='[Calculation_2006494393621143779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_food_od]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_food_od]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_food_od]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='VD_Food_GMV_MTD' datatype='real' name='[Calculation_2006494393621389540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; then [net_gmv_local_food_vd]&#10;WHEN &apos;Eur&apos; then [net_gmv_eur_food_vd]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_food_vd]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Pickup_GMV_MTD' datatype='real' name='[Calculation_2006494393621549285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_food_pu]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_food_pu]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_food_pu]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Shops_GMV_MTD' datatype='real' name='[Calculation_2006494393621700838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_shops]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_shops]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_shops]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Dmart_GMV MTD' datatype='real' name='[Calculation_2006494393639051519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [dmart_sum_gmv_local]&#10;WHEN &apos;Eur&apos; THEN [dmart_sum_gmv_eur]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [dmart_sum_gmv_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Total GMV Excl Pandago MTD' datatype='real' name='[Calculation_2348205023485366301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_total_excl_laas]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_total_excl_laas]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_total_excl_laas]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Current Month' datatype='date' name='[Calculation_6977905451669549056]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([month])}' />
            </column>
            <column caption='Month Filter' datatype='string' name='[Calculation_6977905451669610497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] = [Calculation_6977905451669549056] THEN &apos;MTD&apos;&#10;ELSEIF [month] = DATEADD(&apos;month&apos;, -1, [Calculation_6977905451669549056]) THEN &apos;M-1&apos;&#10;ELSEIF [month] = DATEADD(&apos;month&apos;, -2, [Calculation_6977905451669549056])  THEN &apos;M-2&apos;&#10;&#10;END' />
