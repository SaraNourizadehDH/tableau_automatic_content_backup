            </column>
            <column caption='Delivery Fee / Order (VAT Inclusive)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3474738258208534558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3474738258208292892]/[count_valid_orders_excl_pandago]' />
