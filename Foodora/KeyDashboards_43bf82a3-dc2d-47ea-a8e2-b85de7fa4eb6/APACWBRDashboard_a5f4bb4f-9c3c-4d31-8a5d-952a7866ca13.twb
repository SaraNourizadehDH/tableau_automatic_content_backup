              <calculation class='tableau' formula='SUM(IF [report_week] = [Calculation_2006494393578586113] THEN [Calculation_2348205023480315908] END)-SUM(IF [Calculation_2006494393578852355] = &apos;L2W&apos; THEN [Calculation_2348205023480315908] END)' />
