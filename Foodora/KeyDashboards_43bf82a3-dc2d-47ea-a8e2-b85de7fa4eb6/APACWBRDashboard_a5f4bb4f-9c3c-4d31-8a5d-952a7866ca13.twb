            <column caption='Past Week' datatype='string' name='[Calculation_2006494393578852355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_week] = DATEADD(&apos;week&apos;, -1, [Calculation_2006494393578586113])&#10;THEN &apos;L2W&apos;&#10;ELSEIF [report_week] = DATEADD(&apos;week&apos;, -2, [Calculation_2006494393578586113])&#10;THEN &apos;L3W&apos;&#10;END' />
            </column>
            <column caption='&apos;W-1 Δ %&apos;' datatype='string' name='[Calculation_2006494393606607061]' role='dimension' type='nominal' user:unnamed='Logistics W-1'>
              <calculation class='tableau' formula='&apos;W-1 Δ %&apos;' />
            </column>
            <column caption='SUM(IF [Report Week] = [Most Recent Week] THEN [UTR] END)/SUM...' datatype='real' name='[Calculation_2006494393606770907]' role='measure' type='quantitative' user:unnamed='Logistics W-1'>
              <calculation class='tableau' formula='SUM(IF [report_week] = [Calculation_2006494393578586113] THEN [UTR] END)/SUM(IF [Calculation_2006494393578852355] = &apos;L2W&apos; THEN [UTR] END)-1' />
            </column>
            <column caption='Orders Late &gt;30 min %' datatype='real' name='[Calculation_2348205023479980035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_late_30min]/[count_valid_orders_excl_pandago]' />
