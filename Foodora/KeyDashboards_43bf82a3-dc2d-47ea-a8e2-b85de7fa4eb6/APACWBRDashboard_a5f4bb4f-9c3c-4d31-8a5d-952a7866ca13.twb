            <column caption='SUM(IF [Report Week] = [Most Recent Week] THEN [Orders Late &gt;...' datatype='real' name='[Calculation_2348205023482900500]' role='measure' type='quantitative' user:unnamed='Logistics W-1'>
              <calculation class='tableau' formula='SUM(IF [report_week] = [Calculation_2006494393578586113] THEN [Calculation_2348205023479980035] END)-SUM(IF [Calculation_2006494393578852355] = &apos;L2W&apos; THEN [Calculation_2348205023479980035] END)' />
