      </field-sort-info>
      <datasource-dependencies datasource='Parameters'>
        <column caption='FX Neutral' datatype='real' name='[Currency (copy)]' param-domain-type='any' role='measure' type='quantitative' value='61.63233992'>
          <calculation class='tableau' formula='61.63233992' />
        </column>
        <column alias='Eur (€)' caption='Currency' datatype='string' name='[country_name Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
          <calculation class='tableau' formula='&quot;Eur&quot;' />
          <aliases>
            <alias key='&quot;Eur&quot;' value='Eur (€)' />
          </aliases>
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_DE1438A1468248F1952DCEAAD184981C'>
            <properties context=''>
              <relation connection='bigquery.1ooqfg318sbxbp17pvwq80lmdpmq' name='Custom SQL Query' type='text'><![CDATA[SELECT *
FROM `fulfillment-dwh-production.pandata_report.markets__wbr_dashboard_monthly`
WHERE month <<= DATE_TRUNC(DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 WEEK), MONTH)]]></relation>
            </properties>
