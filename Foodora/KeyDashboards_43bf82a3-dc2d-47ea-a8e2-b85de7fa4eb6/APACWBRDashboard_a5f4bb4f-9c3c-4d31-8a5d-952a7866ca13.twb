    <worksheet name='Logistics'>
      <table>
        <view>
          <datasources>
            <datasource caption='markets__wbr_dashboard_weekly' name='federated.11omran1ganeho1dw4hh20k3wsho' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='FX Neutral' datatype='real' name='[Currency (copy)]' param-domain-type='any' role='measure' type='quantitative' value='61.63233992'>
              <calculation class='tableau' formula='61.63233992' />
            </column>
            <column alias='Eur (€)' caption='Currency' datatype='string' name='[country_name Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='Eur (€)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11omran1ganeho1dw4hh20k3wsho'>
            <column caption='Orders On Time %' datatype='real' name='[Calculation_2348205023479648258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    IF SUM([pdt_bucket_10_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_10_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_10_is_order_on_time_within_10_minutes_d]) * 0.07 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_20_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_20_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_20_is_order_on_time_within_10_minutes_d]) * 0.35 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_30_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_30_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_30_is_order_on_time_within_10_minutes_d]) * 0.35 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_40_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_40_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_40_is_order_on_time_within_10_minutes_d]) * 0.16 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_50_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_50_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_50_is_order_on_time_within_10_minutes_d]) * 0.05 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_60_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_60_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_60_is_order_on_time_within_10_minutes_d]) * 0.02 END&#10;)' />
            </column>
            <column caption='Orders Late &gt;30 min %' datatype='real' name='[Calculation_2348205023479980035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_late_30min]/[count_valid_orders_excl_pandago]' />
            </column>
            <column caption='Shrinkage %' datatype='real' name='[Calculation_2348205023480315908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[shrinkage]/[forecasted_adjusted_order_count]' />
            </column>
            <column caption='Closure %' datatype='real' name='[Calculation_2348205023480377349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[closure]/[forecasted_adjusted_order_count]' />
            </column>
            <column caption='Fail Rate %' datatype='real' name='[Calculation_2348205023480471558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fail_rate]/[total_gross_orders]' />
            </column>
            <column caption='Wastage' datatype='real' name='[Calculation_661325482722906116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [wastage_local]&#10;WHEN &apos;Eur&apos; THEN [wastage_eur]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [wastage_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Wastage/Order' datatype='real' name='[Calculation_661325482723196933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_661325482722906116]/[total_gross_orders]' />
            </column>
            <column caption='CPO' datatype='real' name='[Calculation_661325482723590150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos;&#10;THEN [total_delivery_rider_cost_not_proportioned_local]/[cpo_successful_orders]&#10;WHEN &apos;Eur&apos;&#10;THEN [total_delivery_rider_cost_not_proportioned_eur]/[cpo_successful_orders]&#10;WHEN &apos;Eur FX Neutral&apos;&#10;THEN ([total_delivery_rider_cost_not_proportioned_local]/[Parameters].[Currency (copy)])/[cpo_successful_orders]&#10;END' />
            </column>
            <column caption='Week #' datatype='string' name='[Calculation_6824642314916798464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;W&quot;+STR(WEEK([report_week]))' />
            </column>
            <column datatype='real' name='[UTR]' role='measure' type='quantitative' />
            <column datatype='real' name='[acceptance_rate]' role='measure' type='quantitative' />
            <column datatype='real' name='[closure]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_valid_orders_excl_pandago]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[cpo_successful_orders]' role='measure' type='quantitative' />
