    <worksheet name='Choice WOW'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/WIPWBRDashboard/ChoiceWOW?rev=' id='ChoiceWOW' path='/t/Foodora/workbooks/WIPWBRDashboard' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='markets__okr_dashboard_weekly' name='federated.1ezeo3f0sdijfe1gwekvi1vb6ke4' />
            <datasource caption='productivity metrics' name='federated.1bspdg20107yi21c2yxa50986m2f' />
            <datasource caption='incubation metrics' name='federated.0rmp22o0x05sf718rtt0n1dabpi1' />
          </datasources>
          <datasource-dependencies datasource='federated.0rmp22o0x05sf718rtt0n1dabpi1'>
            <column caption='% Vendors F30D Orders' datatype='real' name='[Calculation_2136887696418938892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([d30_has_order])/SUM([vendor_count])' />
            </column>
            <column datatype='integer' name='[d30_has_order]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[date_dimension]' role='dimension' type='nominal' />
            <column-instance column='[date_dimension]' derivation='None' name='[none:date_dimension:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2136887696418938892]' derivation='User' name='[usr:Calculation_2136887696418938892:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[vendor_count]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bspdg20107yi21c2yxa50986m2f'>
            <column caption='Most Recent Week' datatype='date' name='[Calculation_2136887696416690179]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([date])}' />
            </column>
            <column caption='L2W' datatype='boolean' name='[Calculation_2136887696416780292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date] = DATEADD(&apos;week&apos;, -1, {MAX([date])})&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[date_dimension]' role='dimension' type='nominal' />
            <column-instance column='[date_dimension]' derivation='None' name='[none:date_dimension:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ezeo3f0sdijfe1gwekvi1vb6ke4'>
            <column caption='IF [Date] = [Most Recent Week] THEN [zombie_perc]' datatype='real' name='[Calculation_2335046080078553107]' role='measure' type='quantitative' user:unnamed='Choice WOW'>
              <calculation class='tableau' formula='IF [week] = [Calculation_2723692632184061969] THEN [zombie_perc]' />
            </column>
            <column caption='L2W' datatype='boolean' name='[Calculation_2723692632182464523]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [week] = DATEADD(&apos;week&apos;, -1, {MAX([week])})&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Most Recent Week' datatype='date' datatype-customized='true' name='[Calculation_2723692632184061969]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([week])}' />
            </column>
            <column caption='SUM(IF [Date] =[Most Recent Week] THEN [total_active_vendors]...' datatype='real' name='[Calculation_2938739527091179535]' role='measure' type='quantitative' user:unnamed='Choice WOW'>
              <calculation class='tableau' formula='SUM(IF [week] =[Calculation_2723692632184061969] THEN [total_active_vendors] END)/SUM(IF [Calculation_2723692632182464523] THEN [total_active_vendors] END)-1' />
            </column>
            <column caption='SUM(IF [Date] =[Most Recent Week] THEN [total_vendor_aquisiti...' datatype='real' name='[Calculation_2938739527091236881]' role='measure' type='quantitative' user:unnamed='Choice WOW'>
              <calculation class='tableau' formula='SUM(IF [week] =[Calculation_2723692632184061969] THEN [total_vendor_aquisitions] END)/SUM(IF [Calculation_2723692632182464523] THEN [total_vendor_aquisitions] END)-1' />
            </column>
            <column caption='SUM(IF [Date] =[Most Recent Week] THEN [ab_aquisitions] END)/...' datatype='real' name='[Calculation_2938739527091265555]' role='measure' type='quantitative' user:unnamed='Choice WOW'>
              <calculation class='tableau' formula='SUM(IF [week] =[Calculation_2723692632184061969] THEN [ab_aquisitions] END)/SUM(IF [Calculation_2723692632182464523] THEN [ab_aquisitions] END)-1' />
            </column>
            <column caption='SUM(IF [Date] =[Most Recent Week] THEN [lead_count] END)/SUM(...' datatype='real' name='[Calculation_2938739527091453979]' role='measure' type='quantitative' user:unnamed='Choice WOW'>
              <calculation class='tableau' formula='SUM(IF [week] =[Calculation_2723692632184061969] THEN [lead_count] END)/SUM(IF [Calculation_2723692632182464523] THEN [lead_count] END)-1' />
            </column>
            <column caption='SUM(IF [Date] =[Most Recent Week] THEN [successful_ab_vendor_...' datatype='real' name='[Calculation_4117275258466754633]' role='measure' type='quantitative' user:unnamed='Choice WOW'>
              <calculation class='tableau' formula='SUM(IF [week] =[Calculation_2723692632184061969] THEN [successful_ab_vendor_pcnt] END)-SUM(IF [Calculation_2723692632182464523] THEN [successful_ab_vendor_pcnt] END)' />
