            <column caption='Month Filter' datatype='string' name='[Calculation_6977905451669610497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] = [Calculation_6977905451669549056] THEN &apos;MTD&apos;&#10;ELSEIF [month] = DATEADD(&apos;month&apos;, -1, [Calculation_6977905451669549056]) THEN &apos;M-1&apos;&#10;ELSEIF [month] = DATEADD(&apos;month&apos;, -2, [Calculation_6977905451669549056])  THEN &apos;M-2&apos;&#10;&#10;END' />
