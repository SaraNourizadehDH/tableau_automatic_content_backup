        <field-sort-custom-order field='orders_late_30min' />
        <field-sort-custom-order field='Calculation_2006494393621389540' />
        <field-sort-custom-order field='acceptance_rate' />
        <field-sort-custom-order field='stacked_deliveries' />
        <field-sort-custom-order field='fill_rate' />
        <field-sort-custom-order field='UTR' />
        <field-sort-custom-order field='shrinkage' />
        <field-sort-custom-order field='closure' />
        <field-sort-custom-order field='sessions' />
        <field-sort-custom-order field='cvr' />
        <field-sort-custom-order field='flgpo_local' />
        <field-sort-custom-order field='flgpo_eur' />
        <field-sort-custom-order field='shops_trial' />
        <field-sort-custom-order field='dmart_trial' />
        <field-sort-custom-order field='dmart_pct_weighted_availability' />
        <field-sort-custom-order field='shops_pct_offline_hours' />
        <field-sort-custom-order field='shops_pct_items_not_delivered' />
