    </datasource>
    <datasource caption='incubation metrics' inline='true' name='federated.0rmp22o0x05sf718rtt0n1dabpi1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0pl1f7f0b3ei6h12otbox0dvgxyo'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='shernis.ong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0pl1f7f0b3ei6h12otbox0dvgxyo' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
  SELECT
    DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 52 WEEK) AS start_date,
    DATE_TRUNC(current_date(), ISOWEEK) AS end_date
),

vendor_base AS (
  SELECT
    incubation.activation_date AS d0,
    DATE_ADD(incubation.activation_date, INTERVAL 7 DAY) AS d7,
    incubation.incubated_date_30_days AS d30,
    incubation.incubated_date_60_days AS d60,
    incubation.country,
    countries.global_entity_id,
    incubation.vendor_code,
    incubation.city as vendor_city,
    CASE
      WHEN incubation.vendor_grade IN ("A", "B", "AA", "AAA") THEN "AB"
      WHEN incubation.vendor_grade IN ("C", "D") THEN "CD"
      ELSE "Ungraded"
    END AS vendor_grade,
    num_f30d_valid_orders
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_incubation_cut` AS incubation
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
         ON incubation.country = countries.name
  WHERE incubation.opportunity_business_type IN ("New Business", "Win Back")
    AND COALESCE(incubation.key_account_sub_category, "") NOT IN ("Global KA", "National KA")
    AND incubation.vendor_type IN ("Restaurants")
    AND NOT incubation.is_terminated_within_60_days
    AND incubation.activation_date >>= (SELECT parameters.start_date FROM parameters)
),

deals AS (
  -- at deal level
  -- discounts
  SELECT  
    discounts.uuid,
    discounts.global_entity_id,
    entries.vendor_code,
    discounts.start_date_utc AS start_date,
    discounts.end_date_utc AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_discounts` AS discounts
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS entries
         ON discounts.uuid = entries.offers_discount_uuid
  WHERE
    discounts.created_date_utc >>= (SELECT parameters.start_date FROM parameters)
    AND NOT discounts.is_deleted
    AND discounts.foodpanda_ratio <<>> 100

  UNION ALL 

  -- vouchers
  SELECT
    vouchers.uuid,
    vouchers.global_entity_id,
    entries.vendor_code,
    vouchers.start_date_local AS start_date,
    vouchers.stop_date_local AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS vouchers
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_voucher_vendor_entries` AS entries
         ON vouchers.uuid = entries.offers_voucher_uuid
  WHERE vouchers.created_date_utc >>= (SELECT parameters.start_date FROM parameters)
    AND NOT vouchers.is_deleted
    AND vouchers.foodpanda_ratio <<>> 100
),

ads AS (
-- CPC
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__cpc_campaigns_daily`
  WHERE
    campaign_date_local >>= (SELECT parameters.start_date FROM parameters)
    AND status = "active"
    AND business_type = "restaurants"

  UNION ALL

-- Display ads
  SELECT
  display_ads.global_entity_id,
  CASE
    WHEN advertiser_type = "chain" THEN vendor.vendor_code
    WHEN advertiser_type = "restaurants" THEN display_ads.advertiser_vendor_code
    ELSE display_ads.advertiser_vendor_code
  END AS vendor_code,
  display_ads.campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__display_ads_campaigns_daily` AS display_ads
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendor
      ON display_ads.global_entity_id = vendor.global_entity_id
      AND display_ads.advertiser_chain_code = vendor.chain_code
      AND display_ads.advertiser_type = "chain"
  WHERE display_ads.campaign_date_local >>= (SELECT parameters.start_date FROM parameters)
  -- campaign_date_local >>= "2024-10-01"
  AND display_ads.status = "active"
  AND display_ads.advertiser_type IN ("restaurants", "chain")

  UNION ALL

  -- Joker
  SELECT
  global_entity_id,
  vendor_code,
  campaign_date_utc AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__joker_campaigns_daily`
  WHERE 
    campaign_date_utc >>= (SELECT parameters.start_date FROM parameters)
    AND status = "active"

  UNION ALL

  -- Targeted deals
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__targeted_deals_campaigns_daily` 
  WHERE
    campaign_date_local >>= (SELECT parameters.start_date FROM parameters)
    AND is_active = TRUE
    AND is_deleted = FALSE

),

adoption AS (
  -- vendor level F0D, F30D and F60D adoption of deals and ads
  SELECT
    vendor_base.d0,
    vendor_base.d7,
    vendor_base.d30,
    vendor_base.d60,
    vendor_base.global_entity_id,
    vendor_base.vendor_grade,
    vendor_base.vendor_code,
    -- aggregation to avoid duplication from multiple deals/ads
    MAX(vendor_base.d0 BETWEEN deals.start_date AND deals.end_date) AS d0_on_deals,
    MAX(vendor_base.d7 BETWEEN deals.start_date AND deals.end_date) AS d7_on_deals,
    MAX(vendor_base.d30 BETWEEN deals.start_date AND deals.end_date) AS d30_on_deals,
    MAX(vendor_base.d60 BETWEEN deals.start_date AND deals.end_date) AS d60_on_deals,
    MAX(vendor_base.d0 = ads.ad_date) AS d0_on_ads,
    MAX(vendor_base.d7 = ads.ad_date) AS d7_on_ads,
    MAX(vendor_base.d30 = ads.ad_date) AS d30_on_ads,
    MAX(vendor_base.d60 = ads.ad_date) AS d60_on_ads,
    MAX(vendor_base.num_f30d_valid_orders >>= 1) as d30_has_order 
  FROM vendor_base
  LEFT JOIN deals
        ON deals.global_entity_id = vendor_base.global_entity_id 
        AND deals.vendor_code = vendor_base.vendor_code
  LEFT JOIN ads
         ON ads.global_entity_id = vendor_base.global_entity_id 
        AND ads.vendor_code = vendor_base.vendor_code
  GROUP BY ALL
)

SELECT
  'week' as date_dimension, 
  DATE_TRUNC(d30, ISOWEEK) AS date,
  global_entity_id,
  COUNT(DISTINCT vendor_code) AS vendor_count,
  COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) AS d30_deals_only,
  COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_ads_only,
  COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)) AS d0_deals_only,
  COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_ads_only,
  COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d0_ab_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d30_ab_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)) AS d30_has_order,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_has_order_pcnt
FROM adoption
WHERE 
  d30 <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)

GROUP BY
  date_dimension, 
  date,
  global_entity_id

UNION ALL

SELECT
  'month' as date_dimension, 
  DATE_TRUNC(d30, MONTH) AS date,
  global_entity_id,
  COUNT(DISTINCT vendor_code) AS vendor_count,
  COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) AS d30_deals_only,
  COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_ads_only,
  COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)) AS d0_deals_only,
  COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_ads_only,
  COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d0_ab_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d30_ab_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)) AS d30_has_order,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_has_order_pcnt
FROM adoption
WHERE
  d30 <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)
GROUP BY
  date_dimension, 
  date,
  global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0pl1f7f0b3ei6h12otbox0dvgxyo' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
  SELECT
    DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 52 WEEK) AS start_date,
    DATE_TRUNC(current_date(), ISOWEEK) AS end_date
),

vendor_base AS (
  SELECT
    incubation.activation_date AS d0,
    DATE_ADD(incubation.activation_date, INTERVAL 7 DAY) AS d7,
    incubation.incubated_date_30_days AS d30,
    incubation.incubated_date_60_days AS d60,
    incubation.country,
    countries.global_entity_id,
    incubation.vendor_code,
    incubation.city as vendor_city,
    CASE
      WHEN incubation.vendor_grade IN ("A", "B", "AA", "AAA") THEN "AB"
      WHEN incubation.vendor_grade IN ("C", "D") THEN "CD"
      ELSE "Ungraded"
    END AS vendor_grade,
    num_f30d_valid_orders
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_incubation_cut` AS incubation
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
         ON incubation.country = countries.name
  WHERE incubation.opportunity_business_type IN ("New Business", "Win Back")
    AND COALESCE(incubation.key_account_sub_category, "") NOT IN ("Global KA", "National KA")
    AND incubation.vendor_type IN ("Restaurants")
    AND NOT incubation.is_terminated_within_60_days
    AND incubation.activation_date >>= (SELECT parameters.start_date FROM parameters)
),

deals AS (
  -- at deal level
  -- discounts
  SELECT  
    discounts.uuid,
    discounts.global_entity_id,
    entries.vendor_code,
    discounts.start_date_utc AS start_date,
    discounts.end_date_utc AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_discounts` AS discounts
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS entries
         ON discounts.uuid = entries.offers_discount_uuid
  WHERE
    discounts.created_date_utc >>= (SELECT parameters.start_date FROM parameters)
    AND NOT discounts.is_deleted
    AND discounts.foodpanda_ratio <<>> 100

  UNION ALL 

  -- vouchers
  SELECT
    vouchers.uuid,
    vouchers.global_entity_id,
    entries.vendor_code,
    vouchers.start_date_local AS start_date,
    vouchers.stop_date_local AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS vouchers
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_voucher_vendor_entries` AS entries
         ON vouchers.uuid = entries.offers_voucher_uuid
  WHERE vouchers.created_date_utc >>= (SELECT parameters.start_date FROM parameters)
    AND NOT vouchers.is_deleted
    AND vouchers.foodpanda_ratio <<>> 100
),

ads AS (
-- CPC
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__cpc_campaigns_daily`
  WHERE
    campaign_date_local >>= (SELECT parameters.start_date FROM parameters)
    AND status = "active"
    AND business_type = "restaurants"

  UNION ALL

-- Display ads
  SELECT
  display_ads.global_entity_id,
  CASE
    WHEN advertiser_type = "chain" THEN vendor.vendor_code
    WHEN advertiser_type = "restaurants" THEN display_ads.advertiser_vendor_code
    ELSE display_ads.advertiser_vendor_code
  END AS vendor_code,
  display_ads.campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__display_ads_campaigns_daily` AS display_ads
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendor
      ON display_ads.global_entity_id = vendor.global_entity_id
      AND display_ads.advertiser_chain_code = vendor.chain_code
      AND display_ads.advertiser_type = "chain"
  WHERE display_ads.campaign_date_local >>= (SELECT parameters.start_date FROM parameters)
  -- campaign_date_local >>= "2024-10-01"
  AND display_ads.status = "active"
  AND display_ads.advertiser_type IN ("restaurants", "chain")

  UNION ALL

  -- Joker
  SELECT
  global_entity_id,
  vendor_code,
  campaign_date_utc AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__joker_campaigns_daily`
  WHERE 
    campaign_date_utc >>= (SELECT parameters.start_date FROM parameters)
    AND status = "active"

  UNION ALL

  -- Targeted deals
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__targeted_deals_campaigns_daily` 
  WHERE
    campaign_date_local >>= (SELECT parameters.start_date FROM parameters)
    AND is_active = TRUE
    AND is_deleted = FALSE

),

adoption AS (
  -- vendor level F0D, F30D and F60D adoption of deals and ads
  SELECT
    vendor_base.d0,
    vendor_base.d7,
    vendor_base.d30,
    vendor_base.d60,
    vendor_base.global_entity_id,
    vendor_base.vendor_grade,
    vendor_base.vendor_code,
    -- aggregation to avoid duplication from multiple deals/ads
    MAX(vendor_base.d0 BETWEEN deals.start_date AND deals.end_date) AS d0_on_deals,
    MAX(vendor_base.d7 BETWEEN deals.start_date AND deals.end_date) AS d7_on_deals,
    MAX(vendor_base.d30 BETWEEN deals.start_date AND deals.end_date) AS d30_on_deals,
    MAX(vendor_base.d60 BETWEEN deals.start_date AND deals.end_date) AS d60_on_deals,
    MAX(vendor_base.d0 = ads.ad_date) AS d0_on_ads,
    MAX(vendor_base.d7 = ads.ad_date) AS d7_on_ads,
    MAX(vendor_base.d30 = ads.ad_date) AS d30_on_ads,
    MAX(vendor_base.d60 = ads.ad_date) AS d60_on_ads,
    MAX(vendor_base.num_f30d_valid_orders >>= 1) as d30_has_order 
  FROM vendor_base
  LEFT JOIN deals
        ON deals.global_entity_id = vendor_base.global_entity_id 
        AND deals.vendor_code = vendor_base.vendor_code
  LEFT JOIN ads
         ON ads.global_entity_id = vendor_base.global_entity_id 
        AND ads.vendor_code = vendor_base.vendor_code
  GROUP BY ALL
)

SELECT
  'week' as date_dimension, 
  DATE_TRUNC(d30, ISOWEEK) AS date,
  global_entity_id,
  COUNT(DISTINCT vendor_code) AS vendor_count,
  COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) AS d30_deals_only,
  COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_ads_only,
  COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)) AS d0_deals_only,
  COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_ads_only,
  COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d0_ab_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d30_ab_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)) AS d30_has_order,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_has_order_pcnt
FROM adoption
WHERE 
  d30 <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)

GROUP BY
  date_dimension, 
  date,
  global_entity_id

UNION ALL

SELECT
  'month' as date_dimension, 
  DATE_TRUNC(d30, MONTH) AS date,
  global_entity_id,
  COUNT(DISTINCT vendor_code) AS vendor_count,
  COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) AS d30_deals_only,
  COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_ads_only,
  COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)) AS d0_deals_only,
  COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_ads_only,
  COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_deals_and_ads,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_ads_only_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d0_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d0_on_deals AND d0_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d0_ab_deals_and_ads_pcnt,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(vendor_grade = "AB" AND d30_on_deals AND d30_on_ads, vendor_code, NULL)),
    COUNT(DISTINCT IF(vendor_grade = "AB", vendor_code, NULL))) AS d30_ab_deals_and_ads_pcnt,
  COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)) AS d30_has_order,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(d30_has_order, vendor_code, NULL)),
    COUNT(DISTINCT vendor_code)) AS d30_has_order_pcnt
FROM adoption
WHERE
  d30 <<= DATE_SUB(DATE_TRUNC(current_date(), ISOWEEK), INTERVAL 1 DAY)
GROUP BY
  date_dimension, 
  date,
  global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
