    <worksheet name='Growth &amp; Marketing'>
      <table>
        <view>
          <datasources>
            <datasource caption='markets__wbr_dashboard_weekly' name='federated.11omran1ganeho1dw4hh20k3wsho' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='FX Neutral' datatype='real' name='[Currency (copy)]' param-domain-type='any' role='measure' type='quantitative' value='61.63233992'>
              <calculation class='tableau' formula='61.63233992' />
            </column>
            <column alias='Eur (€)' caption='Currency' datatype='string' name='[country_name Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='Eur (€)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11omran1ganeho1dw4hh20k3wsho'>
            <column caption='GMV Excl Pandago (Currency)' datatype='real' name='[Calculation_2348205023476723712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_total_excl_laas]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_total_excl_laas]&#10;WHEN &apos;Eur FX Neutral&apos; then [net_gmv_local_total_excl_laas]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Daily Average Orders' datatype='real' name='[Calculation_2348205023477534721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_valid_orders])/7' />
            </column>
            <column caption='Delivery Fee (VAT Inclusive)' datatype='real' name='[Calculation_3474738258187862016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [total_successful_paid_df_eur]&#10;WHEN &apos;Local&apos; THEN [total_successful_paid_df_local]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [total_successful_paid_df_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Service Fee' datatype='real' name='[Calculation_3474738258188013569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [total_successful_service_fee_eur]&#10;WHEN &apos;Local&apos; THEN [total_successful_service_fee_local]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [total_successful_service_fee_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Delivery Fee/Order (Incl VAT)' datatype='real' datatype-customized='true' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3474738258188419075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3474738258187862016]/[count_valid_orders_excl_pandago]' />
            </column>
            <column caption='Service Fee/Order (Incl VAT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3474738258188525572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3474738258188013569]/[count_valid_orders_excl_pandago]' />
            </column>
            <column caption='DF + SF / Order (Incl VAT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3474738258189090821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3474738258187862016] + [Calculation_3474738258188013569])/[count_valid_orders_excl_pandago]' />
            </column>
            <column caption='Incentives (w/o DF)' datatype='real' name='[Calculation_3798715943599104000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [voucher_cost_dh_marketing_local] + [discount_cost_dh_marketing_local] + [cashback_utilized_amount_local]&#10;WHEN &apos;Eur&apos; THEN [voucher_cost_dh_marketing_eur] + [discount_cost_dh_marketing_eur] + [cashback_utilized_amount_eur]&#10;WHEN &apos;Eur FX Neutral&apos; THEN ([voucher_cost_dh_marketing_local] + [discount_cost_dh_marketing_local] + [cashback_utilized_amount_local])/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='iCPGMV (w/o DF)' datatype='real' name='[Calculation_3798715943599333377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3798715943599104000]/[Calculation_2348205023476723712]' />
            </column>
            <column caption='AFV_Currency' datatype='real' name='[Calculation_4265260707645280265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [abv_eur_excl_laas]&#10;WHEN &apos;Local&apos; THEN [abv_local_excl_laas]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [abv_local_excl_laas]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Organic_AFV' datatype='real' name='[Calculation_4265260707645669386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [abv_eur_organic]&#10;WHEN &apos;Local&apos; THEN [abv_local_organic]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [abv_local_organic]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Incentivised_AFV' datatype='real' name='[Calculation_4265260707645816843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [abv_eur_incentivized]&#10;WHEN &apos;Local&apos; THEN [abv_local_incentivized]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [abv_local_incentivized]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='FLGPO_Currency' datatype='real' name='[Calculation_4265260707646001164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [flgpo_eur]&#10;WHEN &apos;Local&apos; THEN [flgpo_local]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [flgpo_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Total CVR' datatype='real' name='[Calculation_4372854527447044127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_orders]/[total_sessions]' />
            </column>
            <column caption='Restaurant CVR' datatype='real' name='[Calculation_4372854527447113760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[restaurant_orders]/[restaurant_sessions]' />
            </column>
            <column caption='QC CVR' datatype='real' name='[Calculation_4372854527447171105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[qc_orders]/[qc_sessions]' />
            </column>
            <column caption='Shops CVR' datatype='real' name='[Calculation_4372854527447216162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[shops_orders]/[shops_sessions]' />
            </column>
            <column caption='Dmart CVR' datatype='real' name='[Calculation_4372854527447277603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dmart_orders]/[dmart_sessions]' />
            </column>
            <column caption='Pickup CVR' datatype='real' name='[Calculation_4372854527447326756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[pickup_orders]/[pickup_sessions]' />
            </column>
