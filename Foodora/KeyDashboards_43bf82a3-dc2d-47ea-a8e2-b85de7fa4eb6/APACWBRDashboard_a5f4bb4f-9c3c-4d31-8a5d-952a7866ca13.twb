      <aliases enabled='yes' />
      <column caption='MTD_GMV' datatype='real' name='[Calculation_1331587767784513541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; then [gmv]&#10;when &apos;Local&apos; then [gmv_local]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [gmv_local]/[Parameters].[Currency (copy)]&#10;END' />
      </column>
      <column caption='country_name' datatype='string' name='[Calculation_2244481501309575169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF global_entity_id = &quot;FP_BD&quot; THEN &quot;Bangladesh&quot;&#10;ELSEIF global_entity_id = &quot;FP_HK&quot; THEN &quot;Hong Kong&quot;&#10;ELSEIF global_entity_id = &quot;FP_KH&quot; THEN &quot;Cambodia&quot;&#10;ELSEIF global_entity_id = &quot;FP_LA&quot; THEN &quot;Laos&quot;&#10;ELSEIF global_entity_id = &quot;FP_MM&quot; THEN &quot;Myanmar&quot;&#10;ELSEIF global_entity_id = &quot;FP_MY&quot; THEN &quot;Malaysia&quot;&#10;ELSEIF global_entity_id = &quot;FP_PH&quot; THEN &quot;Philippines&quot;&#10;ELSEIF global_entity_id = &quot;FP_PK&quot; THEN &quot;Pakistan&quot;&#10;ELSEIF global_entity_id = &quot;FP_SG&quot; THEN &quot;Singapore&quot;&#10;ELSEIF global_entity_id = &quot;FP_TW&quot; THEN &quot;Taiwan&quot;&#10;END' />
      </column>
      <column caption='Current Month' datatype='date' name='[Calculation_3359192777061969923]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([month])}' />
      </column>
      <column caption='MTD Filter' datatype='boolean' name='[Calculation_3359192777062379526]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [month] = [Calculation_3359192777061969923] THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Orders On Time % MTD' datatype='real' name='[Calculation_3898358097440358405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    IF SUM([pdt_bucket_10_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_10_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_10_is_order_on_time_within_10_minutes_d]) * 0.07 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_20_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_20_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_20_is_order_on_time_within_10_minutes_d]) * 0.35 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_30_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_30_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_30_is_order_on_time_within_10_minutes_d]) * 0.35 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_40_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_40_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_40_is_order_on_time_within_10_minutes_d]) * 0.16 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_50_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_50_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_50_is_order_on_time_within_10_minutes_d]) * 0.05 END&#10;) +&#10;(&#10;    IF SUM([pdt_bucket_60_is_order_on_time_within_10_minutes_d]) = 0 THEN 0&#10;    ELSE SUM([pdt_bucket_60_is_order_on_time_within_10_minutes_n]) / SUM([pdt_bucket_60_is_order_on_time_within_10_minutes_d]) * 0.02 END&#10;)' />
      </column>
      <column caption='AB Zombie LOD % ' datatype='real' name='[Calculation_4763682542844178482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [month], [global_entity_id]: &#10;SUM([ab_zombie_percentage])/SUM([total_vendors_zombies_calc])&#10;}' />
      </column>
      <column caption='AB Zombie %' datatype='real' name='[Calculation_4763682542844465203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ab_zombie_vendors])/SUM([total_vendors_zombies_calc])' />
      </column>
      <column caption='Disco Cofunding Ratio %' datatype='real' name='[Calculation_4763682542844743732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([disco_vendor_eur])/SUM([disco_eur])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='OKR MTD' datatype='table' name='[__tableau_internal_object_id__].[_673C2CB930694B0A8D41F9185ECE9738]' role='measure' type='quantitative' />
