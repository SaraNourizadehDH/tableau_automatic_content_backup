      <table>
        <view>
          <datasources>
            <datasource caption='markets__wbr_dashboard_monthly' name='federated.0avpxc00gslmia1dr48070up6hpk' />
            <datasource caption='markets__wbr_dashboard_weekly' name='federated.11omran1ganeho1dw4hh20k3wsho' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='FX Neutral' datatype='real' name='[Currency (copy)]' param-domain-type='any' role='measure' type='quantitative' value='61.63233992'>
              <calculation class='tableau' formula='61.63233992' />
            </column>
            <column alias='Eur (€)' caption='Currency' datatype='string' name='[country_name Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
              <aliases>
                <alias key='&quot;Eur&quot;' value='Eur (€)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0avpxc00gslmia1dr48070up6hpk'>
            <column caption='Total GMV MTD' datatype='real' name='[Calculation_2006494393620963554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_total]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_total]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_total]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='AFV_Currency MTD' datatype='real' name='[Calculation_2006494393622974712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [abv_local_excl_laas]&#10;WHEN &apos;Eur&apos; THEN [abv_eur_excl_laas]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [abv_local_excl_laas]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Organic_AFV MTD' datatype='real' name='[Calculation_2006494393623195897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [abv_local_organic]&#10;WHEN &apos;Eur&apos; THEN [abv_eur_organic]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [abv_local_organic]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Incentivised_AFV MTD' datatype='real' name='[Calculation_2006494393623400698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [abv_local_incentivized]&#10;WHEN &apos;Eur&apos; THEN [abv_eur_incentivized]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [abv_local_incentivized]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='FLGPO_Currency MTD' datatype='real' name='[Calculation_2006494393623552251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Local&apos; THEN [flgpo_local]&#10;WHEN &apos;Eur&apos; THEN [flgpo_eur]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [flgpo_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Total GMV Excl Pandago MTD' datatype='real' name='[Calculation_2348205023485366301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [net_gmv_eur_total_excl_laas]&#10;WHEN &apos;Local&apos; THEN [net_gmv_local_total_excl_laas]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [net_gmv_local_total_excl_laas]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
            <column caption='Daily Average Orders Monthly' datatype='real' name='[Calculation_2348205023492694046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_valid_orders]/30' />
            </column>
            <column caption='Delivery Fee (VAT Inclusive)' datatype='real' name='[Calculation_3474738258208292892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[country_name Parameter]&#10;WHEN &apos;Eur&apos; THEN [total_successful_paid_df_eur]&#10;WHEN &apos;Local&apos; THEN [total_successful_paid_df_local]&#10;WHEN &apos;Eur FX Neutral&apos; THEN [total_successful_paid_df_local]/[Parameters].[Currency (copy)]&#10;END' />
            </column>
