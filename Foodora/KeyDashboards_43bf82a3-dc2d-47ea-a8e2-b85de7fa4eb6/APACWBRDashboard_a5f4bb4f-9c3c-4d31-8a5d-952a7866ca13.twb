              <calculation class='tableau' formula='SUM(IF [report_week] = [Calculation_2006494393578586113] THEN [acceptance_rate] END)-SUM(IF [Calculation_2006494393578852355] = &apos;L2W&apos; THEN [acceptance_rate] END)' />
