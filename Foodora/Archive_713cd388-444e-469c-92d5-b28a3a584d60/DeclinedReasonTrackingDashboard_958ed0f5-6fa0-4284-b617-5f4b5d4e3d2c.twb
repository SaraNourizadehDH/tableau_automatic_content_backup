      <datasource-dependencies datasource='Parameters'>
        <column caption='Decline Reason Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;VENDOR&quot;'>
          <calculation class='tableau' formula='&quot;VENDOR&quot;' />
          <members>
            <member value='&quot;TRAFFIC_MANAGER&quot;' />
            <member value='&quot;CUSTOMER&quot;' />
            <member value='&quot;VENDOR&quot;' />
            <member value='&quot;POST_DELIVERY&quot;' />
          </members>
        </column>
        <column caption='Brand or Outlet' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
          <calculation class='tableau' formula='&quot;Brand&quot;' />
          <members>
            <member value='&quot;Brand&quot;' />
            <member value='&quot;Outlet&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='sqlproxy.0qiinfr1gdkt8n1d5dcwe1x2vpds'>
        <column caption='Brands / Outlets' datatype='string' name='[Calculation_356065858668269571]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Brand&apos; THEN TRIM(REGEXP_REPLACE(LOWER([vendor_name]),&apos;\(.*?\)|\（.*?\）|\(.*?\）|\（.*?\)&apos;,&apos;&apos;))&#13;&#10;WHEN &apos;Outlet&apos; THEN [vendor_name]&#13;&#10;END' />
        </column>
        <column caption='sub order_date' datatype='date' name='[Calculation_861946792156667904]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='date([ordered_at_local])' />
        </column>
        <column datatype='string' name='[city (group)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
          <calculation class='categorical-bin' column='[city]' new-bin='true'>
            <bin default-name='false' value='&quot;Chiayi City&quot;'>
              <value>&quot;Chiayi City&quot;</value>
              <value>&quot;Chiayi County&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;Hsinchu City&quot;'>
              <value>&quot;Hsinchu City&quot;</value>
              <value>&quot;Hsinchu County&quot;</value>
            </bin>
          </calculation>
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[city]' pivot='key' role='dimension' semantic-role='[City].[Name]' type='nominal' user-datatype='string' visual-totals='Default' />
