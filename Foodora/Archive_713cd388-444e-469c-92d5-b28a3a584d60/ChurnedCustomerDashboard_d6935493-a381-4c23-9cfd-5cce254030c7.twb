          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Part' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Daily' />
                <alias key='&quot;Monthly&quot;' value='Monthly' />
                <alias key='&quot;Mtd&quot;' value='Mtd' />
                <alias key='&quot;Weekly&quot;' value='Weekly' />
                <alias key='&quot;Wtd&quot;' value='Wtd' />
              </aliases>
            </column>
            <column caption='Partition By' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.05bx8sl0293bhk182i0qt1v095v4'>
            <column caption='partition_by' datatype='string' name='[Calculation_1607151806765838343]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;All&quot; THEN &quot;All&quot;&#10;WHEN &quot;Last Order Business Type&quot; THEN [last_order_business_type_apac]&#10;WHEN &quot;Last Order City Name&quot; THEN [last_order_city_name]&#10;WHEN &quot;Last Order Expedition Type&quot; THEN [last_order_expedition_type]&#10;WHEN &quot;Last Order Is First Order&quot; THEN IF [last_order_is_first_order] = TRUE THEN &quot;TRUE&quot; ELSE &quot;FALSE&quot; END&#10;END' />
            </column>
            <column caption='updated_date' datatype='date' name='[Calculation_276408455382786050]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
            </column>
            <column caption='wtd updated_date' datatype='integer' name='[Calculation_276408455383965702]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[Calculation_276408455382786050]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[Calculation_276408455382786050]) - 1&#13;&#10;end' />
            </column>
            <column caption='wtd report_date' datatype='integer' name='[Calculation_276408455384076295]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[report_date]) - 1&#13;&#10;end' />
            </column>
            <column caption='mtd updated_date' datatype='integer' name='[Calculation_276408455384158216]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [Calculation_276408455382786050])' />
            </column>
            <column caption='mtd report_date' datatype='integer' name='[Calculation_276408455384219657]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
            </column>
            <column caption='datetrunc report_date' datatype='date' name='[Calculation_276408455384391690]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(Monthly)|(Mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(Weekly)|(Wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
            </column>
            <column caption='datename(2) report_date' datatype='string' name='[Calculation_276408455384498187]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Daily&apos;&#13;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#13;&#10;else str(year([Calculation_276408455384391690]))&#13;&#10;end' />
            </column>
            <column caption='datename report_date' datatype='string' name='[Calculation_276408455384604684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(Monthly)|(Mtd)&apos;) then &#13;&#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(Weekly)|(Wtd)&apos;) then &#13;&#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;Daily&apos; then str([report_date])&#13;&#10;end' />
            </column>
            <column caption='net_customer_30d' datatype='integer' name='[Calculation_3953597589887160330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reactivate_churned_30d_customers])-sum([new_churned_30d_customers])' />
