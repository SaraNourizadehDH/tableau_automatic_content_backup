          <datasource-dependencies datasource='sqlproxy.05bx8sl0293bhk182i0qt1v095v4'>
            <column caption='partition_by' datatype='string' name='[Calculation_1607151806765838343]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;All&quot; THEN &quot;All&quot;&#10;WHEN &quot;Last Order Business Type&quot; THEN [last_order_business_type_apac]&#10;WHEN &quot;Last Order City Name&quot; THEN [last_order_city_name]&#10;WHEN &quot;Last Order Expedition Type&quot; THEN [last_order_expedition_type]&#10;WHEN &quot;Last Order Is First Order&quot; THEN IF [last_order_is_first_order] = TRUE THEN &quot;TRUE&quot; ELSE &quot;FALSE&quot; END&#10;END' />
            </column>
            <column caption='updated_date' datatype='date' name='[Calculation_276408455382786050]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
