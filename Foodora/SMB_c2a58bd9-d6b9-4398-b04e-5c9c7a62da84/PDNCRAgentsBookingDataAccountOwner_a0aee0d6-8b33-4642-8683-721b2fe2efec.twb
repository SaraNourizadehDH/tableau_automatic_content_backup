              <calculation class='tableau' formula='IF CONTAINS([agent], &apos;foodpanda.com&apos;) THEN &quot;Central&quot;&#10;ELSEIF NOT CONTAINS([agent], &apos;foodpanda&apos;) THEN &quot;Self-Booking&quot;&#10;ELSE &quot;Non-Central&quot;&#10;END' />
            </column>
            <column caption='Joker Counts' datatype='real' name='[Calculation_571605356061282304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED country_name, agent, booking_source, vendor_code, team_source, [booking_date] : AVG([pandabox_units]) }' />
            </column>
            <column caption='Booking Month' datatype='string' name='[Calculation_571605356067962883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;month&apos;,[booking_date])))' />
            </column>
            <column caption='Live Days' datatype='string' name='[Calculation_571605356092477446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEDIFF(&apos;day&apos;,DATE([booking_date]), DATE([end_date])))' />
