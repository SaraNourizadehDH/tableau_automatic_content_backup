    <worksheet name='Pandabox Bookings Weekly'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_ssc_commercial_agent_bookings_dashboard_pb(pandata_report)' name='federated.0xcw1yo0pzlg5h1b3asos0we0ca0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity..' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xcw1yo0pzlg5h1b3asos0we0ca0'>
            <column caption='Central_Commercial' datatype='boolean' name='[Calculation_1232578978844667905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([team_source]) = &quot;central&quot; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Gran Filter' datatype='string' name='[Calculation_1232578978853548035]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Joker Counts' datatype='real' name='[Calculation_571605356061282304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED country_name, agent, booking_source, vendor_code, team_source, [booking_date] : AVG([pandabox_units]) }' />
            </column>
            <column caption='Gran' datatype='string' name='[Calculation_571605356062363649]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Weekly&quot; THEN STR(YEAR([booking_date])) + &quot;W&quot; + &quot;-&quot; + STR(DATEPART(&apos;week&apos;, DATE([booking_date])))&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Daily&quot; THEN STR(DATE([booking_date]))&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Monthly&quot; THEN STR(YEAR([booking_date])) + &quot;-&quot; + STR(MONTH([booking_date]))&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Country&quot; THEN [country_name]&#10;END' />
            </column>
            <column caption='Last 6 Months' datatype='boolean' name='[Calculation_571605356066557954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE([booking_date]) &gt;= DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY()))' />
            </column>
            <column caption='Booking Month' datatype='string' name='[Calculation_571605356067962883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;month&apos;,[booking_date])))' />
            </column>
            <column caption='Booking Source' datatype='string' name='[Calculation_803892590700929024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[booking_source]' />
            </column>
            <column caption='Agent' datatype='string' name='[agent]' role='dimension' type='nominal' />
            <column caption='Booking Date1' datatype='date' name='[booking_date]' role='dimension' type='ordinal' />
            <column caption='Booking Source1' datatype='string' name='[booking_source]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[vendor_code]' derivation='CountD' name='[ctd:vendor_code:qk]' pivot='key' type='quantitative' />
            <column caption='Effective Date1' datatype='date' name='[effective_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1232578978844667905]' derivation='None' name='[none:Calculation_1232578978844667905:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1232578978853548035]' derivation='None' name='[none:Calculation_1232578978853548035:nk]' pivot='key' type='nominal' />
