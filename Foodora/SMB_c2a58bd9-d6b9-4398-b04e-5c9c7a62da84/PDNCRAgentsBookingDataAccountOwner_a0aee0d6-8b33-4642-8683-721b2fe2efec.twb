      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0xcw1yo0pzlg5h1b3asos0we0ca0].[ctd:vendor_code:qk]&quot;' value='Vendor Count' />
          <alias key='&quot;[federated.0xcw1yo0pzlg5h1b3asos0we0ca0].[sum:joker_count:qk]&quot;' value='Pandabox Units' />
        </aliases>
      </column>
      <column caption='Central_Commercial' datatype='boolean' name='[Calculation_1232578978844667905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([team_source]) = &quot;central&quot; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='Gran Filter' datatype='string' name='[Calculation_1232578978853548035]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='Agent Department' datatype='string' name='[Calculation_3172152646158565376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([agent], &apos;foodpanda.com&apos;) THEN &quot;Central&quot;&#10;ELSEIF NOT CONTAINS([agent], &apos;foodpanda&apos;) THEN &quot;Self-Booking&quot;&#10;ELSE &quot;Non-Central&quot;&#10;END' />
      </column>
      <column caption='Joker Counts' datatype='real' name='[Calculation_571605356061282304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED country_name, agent, booking_source, vendor_code, team_source, [booking_date] : AVG([pandabox_units]) }' />
      </column>
      <column caption='Gran' datatype='string' name='[Calculation_571605356062363649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Weekly&quot; THEN STR(YEAR([booking_date])) + &quot;W&quot; + &quot;-&quot; + STR(DATEPART(&apos;week&apos;, DATE([booking_date])))&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Daily&quot; THEN STR(DATE([booking_date]))&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Monthly&quot; THEN STR(YEAR([booking_date])) + &quot;-&quot; + STR(MONTH([booking_date]))&#10;ELSEIF [Parameters].[Parameter 3] = &quot;Country&quot; THEN [country_name]&#10;END' />
      </column>
      <column caption='Last 6 Months' datatype='boolean' name='[Calculation_571605356066557954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE([booking_date]) &gt;= DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;, TODAY()))' />
      </column>
      <column caption='Booking Month' datatype='string' name='[Calculation_571605356067962883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;month&apos;,[booking_date])))' />
      </column>
      <column caption='Effective Month' datatype='string' name='[Calculation_571605356072747012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([datelive])' />
      </column>
      <column caption='Live Days' datatype='string' name='[Calculation_571605356092477446]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEDIFF(&apos;day&apos;,DATE([booking_date]), DATE([end_date])))' />
      </column>
      <column caption='Booking Date' datatype='string' name='[Calculation_571605356103770120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([booking_date])' />
      </column>
      <column caption='Booking Source' datatype='string' name='[Calculation_803892590700929024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[booking_source]' />
      </column>
      <column caption='Pandabox Units' datatype='string' name='[Calculation_878201974489890816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([pandabox_units], 0))' />
      </column>
      <column caption='End Date' datatype='string' name='[Calculation_878201974491652097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([end_date])' />
      </column>
      <column caption='Effective Date' datatype='string' name='[Calculation_878201974493143042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([effective_date])' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
