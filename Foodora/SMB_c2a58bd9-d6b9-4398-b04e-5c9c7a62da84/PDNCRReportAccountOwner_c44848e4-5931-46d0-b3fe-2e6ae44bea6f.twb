    <worksheet name='PB pene'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_ssc_commercial_ncr_report_cpc_pb_penetration (pandata_report)' name='federated.1pzncbr0glf62k1h1yv7e09pjgfq' />
          </datasources>
          <datasource-dependencies datasource='federated.1pzncbr0glf62k1h1yv7e09pjgfq'>
            <column caption='PB Penetration %' datatype='real' default-format='p0.0%' name='[CPC Penetration % (copy)_785174503577788419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([pb_live_vendor_count])) / SUM(ZN([central_allocated_vendor_count]))' />
            </column>
            <column caption='Relevant Time Period' datatype='boolean' name='[Calculation_387379997988188162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_month] &lt;= DATETRUNC(&apos;month&apos;, TODAY()) &#13;&#10;OR (MONTH([report_month]) = MONTH(DATEADD(&apos;month&apos;, 1, [report_month])) AND DAY([report_month]) &gt;= 27)&#10;THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_month]) &lt; 10 then str(YEAR([report_month])) + &quot;-0&quot; + str(month([report_month]))&#13;&#10;ELSE str(YEAR([report_month])) + &quot;-&quot; + str(month([report_month]))&#13;&#10;END' />
            </column>
            <column caption='PB Penetration Target' datatype='real' default-format='p0.0%' name='[Calculation_785174503577391105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [report_month], [country]: MAX([pb_penetration_target])}' />
            </column>
            <column caption='Central Allocated Vendor Count' datatype='integer' name='[central_allocated_vendor_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Final Source' datatype='string' name='[final_source]' role='dimension' type='nominal' />
