            <column caption='MTD Sold Vendors' datatype='integer' name='[MTD Sold Vendors (copy)_547187362567385089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_vendor_count])&#10;            +&#10;SUM([today_dt_vendor_count_without_cpc])&#10;            + &#10;SUM([pandabox_vendor_count_without_cpc_dt])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Relative Date Filter with Anchor (copy)_1490128553386672145]' role='dimension' type='nominal'>
