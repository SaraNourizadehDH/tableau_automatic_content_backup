    <worksheet name='Sheet 21'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_ssc_commercial_ncr_report_page_1 (pandata report)' name='federated.1qnqp010x3pnid164v33g09yaasu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1qnqp010x3pnid164v33g09yaasu].[Calculation_747316120880996352]' caption='Choose Anchor Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-20#'>
              <calculation class='tableau' formula='#2025-08-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qnqp010x3pnid164v33g09yaasu'>
            <column caption='MTD NCR Penetration' datatype='real' name='[Calculation_102668002775392256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76420460082634758] / [Calculation_76420460152315938]' />
            </column>
            <column caption='L7D' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Calculation_1490128553369919498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &lt;= 7 AND DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &gt;= 0 THEN [booking_price_eur] END' />
            </column>
            <column caption='DT Rev MTD Fixed' datatype='real' name='[Calculation_4397694667550687232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date], [Calculation_76420459124830209]: AVG([dt_rev]) }' />
            </column>
            <column caption='DT Rev MTD' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_4397694667621953542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_4397694667550687232])' />
            </column>
            <column caption='Select Date' datatype='date' hidden='true' name='[Calculation_747316120880996352]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-2' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_76420459124830209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([country])' />
            </column>
            <column caption='Distinct Vendor Count' datatype='integer' name='[Calculation_76420460082634758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [vendor_count] ELSE 0 END&#10;                        + &#10;IF [Date Filter (copy)_76420459160481795] = TRUE THEN [pandabox_vendor_count] ELSE 0 END' />
            </column>
            <column caption='Distinct Pandabox Vendor' datatype='integer' name='[Calculation_76420460084281355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [pandabox_vendor_count] ELSE 0 END' />
            </column>
            <column caption='MTD CPC Sold (EUR)' datatype='real' name='[Calculation_76420460086222861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_booking_price_eur])' />
            </column>
            <column caption='MTD CPC Revenue (EUR)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_76420460088446993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_rev_eur])' />
            </column>
            <column caption='MTD NCR Realized' datatype='real' name='[Calculation_76420460088709138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76420460088446993] + [Calculation_76420460089073683] + AVG([Calculation_4397694667550687232])' />
            </column>
            <column caption='MTD Pandabox Realized' datatype='real' name='[Calculation_76420460089073683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pb_rev_eur])' />
            </column>
            <column caption='Ads / Allocated GFV' datatype='real' name='[Calculation_76420460146061341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76420460088709138] / SUM([gfv_eur_central])' />
            </column>
            <column caption='Booking Price Current Week' datatype='real' name='[Calculation_76420460150505503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;iso-week&apos;, [date]), [country] : AVG([booking_price_eur_current_week]) }' />
            </column>
            <column caption='Booking Price Last Week' datatype='real' name='[Calculation_76420460150882336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;iso-week&apos;, [date]), [country] : AVG([booking_price_eur_last_week]) }' />
            </column>
            <column caption='% LW Sold Comparsion ' datatype='real' name='[Calculation_76420460151021601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([Calculation_76420460150505503]) / AVG([Calculation_76420460150882336])) - 1' />
            </column>
            <column caption='Central Allocated Vendors' datatype='real' name='[Calculation_76420460152315938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [date]), [country] : AVG([central_vendors]) }' />
            </column>
            <column caption='Booking Price Last Month' datatype='real' name='[Calculation_76420460175556652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [date]), [country] : AVG([booking_price_eur_last_month]) }' />
            </column>
            <column caption='%LM Sold Comparison' datatype='real' name='[Calculation_76420460175814701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([mtd_booking_price_cm]) /AVG([mtd_booking_price_pm])) - 1' />
            </column>
            <column caption='% LM Realized Comparison' datatype='real' name='[Calculation_76420460176937008]' role='measure' type='quantitative'>
