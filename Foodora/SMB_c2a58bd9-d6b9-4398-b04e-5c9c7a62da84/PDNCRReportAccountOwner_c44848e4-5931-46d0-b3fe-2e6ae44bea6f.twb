      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hbbxxd0s4cczq14uc42x1z0kmhq].[avg:vendor_count:qk]&quot;' value='Vendor Count' />
        </aliases>
      </column>
      <column caption='Forcasted Revenue' datatype='real' name='[Calculation_102668002800967682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country], [datelive] : AVG([expected_overall_rev]) }' />
      </column>
      <column caption='Date Filters' datatype='boolean' name='[Calculation_102668002801983491]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[datelive] = (TODAY() - 2)' />
      </column>
      <column caption='Revenue Eur' datatype='real' name='[Calculation_1517924184989044740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_rev_eur]) &#10;        + &#10;SUM([pb_rev_eur])&#10;        +&#10;SUM([dt_rev])' />
      </column>
      <column caption='date' datatype='string' name='[Calculation_1517924184990547973]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([datelive])' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_1517924184991023110]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (ISOWEEK(DATETRUNC(&apos;iso-week&apos;, [datelive]))) &lt; 10 THEN STR(ISOYEAR(DATETRUNC(&apos;iso-year&apos;, [datelive]))) + &quot;W0&quot; + STR(ISOWEEK(DATETRUNC(&apos;iso-week&apos;, [datelive])))&#10;ELSE STR(ISOYEAR(DATETRUNC(&apos;iso-year&apos;, [datelive]))) + &quot;W&quot; + STR(ISOWEEK(DATETRUNC(&apos;iso-week&apos;, [datelive])))&#10;END&#10;//IF ISOWEEK([datelive]) &lt; 10 then str(YEAR([datelive])) + &quot;-W0&quot; + str(ISOWEEK([datelive]))&#10;//ELSE str(YEAR([datelive])) + &quot;-W&quot; + str(ISOWEEK([datelive]))&#10;//END' />
      </column>
      <column caption='Total SUM' datatype='real' name='[Calculation_1517924185012150282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [datelive] : SUM([cpc_rev_eur]) + SUM([pb_rev_eur])}' />
      </column>
      <column caption='Today&apos;s Date' datatype='boolean' name='[Calculation_2259258907326046208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;, [datelive])) &lt;= DATE(DATETRUNC(&apos;iso-week&apos;, TODAY()))' />
      </column>
      <column caption='Based On FIlter' datatype='string' name='[Calculation_554787237831741443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='Gran Filter' datatype='string' name='[Calculation_796574214517686278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
