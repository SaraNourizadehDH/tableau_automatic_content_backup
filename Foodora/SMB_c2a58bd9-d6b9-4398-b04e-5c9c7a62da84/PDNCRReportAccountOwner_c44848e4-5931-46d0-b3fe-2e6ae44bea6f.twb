      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1qnqp010x3pnid164v33g09yaasu].[sum:booking_price_eur:qk]&quot;' value='Today Sold Performance (EUR)' />
          <alias key='&quot;[federated.1qnqp010x3pnid164v33g09yaasu].[sum:pandabox_units:qk]&quot;' value='Today Pandabox Sold' />
          <alias key='&quot;[federated.1qnqp010x3pnid164v33g09yaasu].[sum:running_sum_next_months:qk]&quot;' value='Next Month Booked Revenue (EUR)' />
          <alias key='&quot;[federated.1qnqp010x3pnid164v33g09yaasu].[sum:total_sold_eur:qk]&quot;' value='MTD Sold (EUR).' />
        </aliases>
      </column>
      <column caption='Previous L7D' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Calculation2 (copy)_1490128553370374155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &lt;= 14 AND DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &gt;= 8 THEN [booking_price_eur] END' />
      </column>
      <column caption='MTD NCR Penetration' datatype='real' name='[Calculation_102668002775392256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_76420460082634758] / [Calculation_76420460152315938]' />
      </column>
      <column caption='MTD Total Vendors' datatype='integer' hidden='true' name='[Calculation_102668002776010753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_count]) &#10;            + &#10;SUM([pandabox_vendor_count])' />
      </column>
      <column caption='L7D &amp; P7D Date' datatype='date' name='[Calculation_1302384745213947904]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &gt; 7 AND DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &lt;= 14 THEN date + 7 &#13;&#10;ELSE [date]&#13;&#10;END' />
      </column>
      <column caption='Next Month Target Achievement %' datatype='real' default-format='p0.00%' name='[Calculation_1490128553346555904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([running_sum_next_months])/SUM([next_month_target])' />
      </column>
      <column caption='Relative Date Filter with Anchor' datatype='boolean' name='[Calculation_1490128553367212040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &lt;= 14&#13;&#10;AND DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &gt;= 1' />
      </column>
      <column caption='L7D' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Calculation_1490128553369919498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &lt;= 7 AND DATEDIFF(&apos;day&apos;,[date],[Parameters].[Parameter 3]) &gt;= 0 THEN [booking_price_eur] END' />
      </column>
      <column caption='Max Growth' datatype='real' name='[Calculation_1517924184693526528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date] : AVG([max_rr]) }' />
      </column>
      <column caption='Min Growth' datatype='real' name='[Calculation_1517924184693653505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date] : AVG([min_rr]) }' />
      </column>
      <column caption='DT Rev MTD Fixed' datatype='real' name='[Calculation_4397694667550687232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [Calculation_76420459124830209]: AVG([dt_rev]) }' />
      </column>
      <column caption='Today DT Booked Vendors' datatype='integer' name='[Calculation_4397694667618496517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [today_dt_vendor_count] ELSE 0 END' />
      </column>
      <column caption='DT Rev MTD' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_4397694667621953542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_4397694667550687232])' />
      </column>
      <column caption='Select Date' datatype='date' hidden='true' name='[Calculation_747316120880996352]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-2' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_76420459124830209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([country])' />
      </column>
      <column caption='Total Sold Performance (EUR)' datatype='real' hidden='true' name='[Calculation_76420459160850437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [booking_price_eur] END' />
      </column>
      <column caption='Distinct Vendor Count' datatype='integer' name='[Calculation_76420460082634758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [vendor_count] ELSE 0 END&#10;                        + &#10;IF [Date Filter (copy)_76420459160481795] = TRUE THEN [pandabox_vendor_count] ELSE 0 END' />
      </column>
      <column caption='Today CPP Sold ' datatype='real' hidden='true' name='[Calculation_76420460083064839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [cpp_booking_price_eur] ELSE 0 END' />
      </column>
      <column caption='Today CPC Sold' datatype='real' name='[Calculation_76420460083998730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [cpc_booking_price_eur] ELSE 0 END' />
      </column>
      <column caption='Distinct Pandabox Vendor' datatype='integer' name='[Calculation_76420460084281355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [pandabox_vendor_count] ELSE 0 END' />
      </column>
      <column caption='MTD Pandabox SOLD' datatype='integer' name='[Calculation_76420460084523020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pandabox_vendor_count])&#10;//IF [Single Date] = TRUE THEN [MTD Pandabox Sold] ELSE 0 END' />
      </column>
      <column caption='MTD CPC Sold (EUR)' datatype='real' name='[Calculation_76420460086222861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_booking_price_eur])' />
      </column>
      <column caption='MTD Sold (EUR)' datatype='real' hidden='true' name='[Calculation_76420460086489103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_76420460086386702] + [Calculation_76420460086222861]' />
      </column>
      <column caption='Target NCR (EUR)' datatype='real' name='[Calculation_76420460087521296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [date]), [country] : AVG([current_month_target])}' />
      </column>
      <column caption='MTD CPC Revenue (EUR)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_76420460088446993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_rev_eur])' />
      </column>
      <column caption='MTD NCR Realized' datatype='real' name='[Calculation_76420460088709138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_76420460088446993] + [Calculation_76420460089073683] + AVG([Calculation_4397694667550687232])' />
      </column>
      <column caption='MTD Pandabox Realized' datatype='real' name='[Calculation_76420460089073683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pb_rev_eur])' />
      </column>
      <column caption='Monthly Realized Target Achievement ' datatype='real' name='[Calculation_76420460089577492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_76420460088709138] / AVG([Calculation_76420460087521296])' />
      </column>
      <column caption='Next Month Bokked Revenue(EUR)' datatype='real' name='[Calculation_76420460090642454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [date]) , [country] : AVG([running_sum_next_months]) }' />
      </column>
      <column caption='Next Month NCR Target' datatype='real' name='[Calculation_76420460091326487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [date]) , [country] : AVG([next_month_target]) }' />
      </column>
      <column caption='Today CPC Booked Vendors' datatype='integer' name='[Calculation_76420460145385500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date Filter (copy)_76420459160481795] = TRUE THEN [cpc_vendor_count] ELSE 0 END' />
      </column>
      <column caption='Ads / Allocated GFV' datatype='real' name='[Calculation_76420460146061341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_76420460088709138] / SUM([gfv_eur_central])' />
      </column>
      <column caption='MTD SB Vendors' datatype='integer' name='[Calculation_76420460148502558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_vendor_count]) &#10;         +&#10;SUM([pandabox_vendor_count_sb])' />
      </column>
      <column caption='Booking Price Current Week' datatype='real' name='[Calculation_76420460150505503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;iso-week&apos;, [date]), [country] : AVG([booking_price_eur_current_week]) }' />
      </column>
      <column caption='Booking Price Last Week' datatype='real' name='[Calculation_76420460150882336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;iso-week&apos;, [date]), [country] : AVG([booking_price_eur_last_week]) }' />
      </column>
      <column caption='% LW Sold Comparsion ' datatype='real' name='[Calculation_76420460151021601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Calculation_76420460150505503]) / AVG([Calculation_76420460150882336])) - 1' />
      </column>
      <column caption='Central Allocated Vendors' datatype='real' name='[Calculation_76420460152315938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [date]), [country] : AVG([central_vendors]) }' />
