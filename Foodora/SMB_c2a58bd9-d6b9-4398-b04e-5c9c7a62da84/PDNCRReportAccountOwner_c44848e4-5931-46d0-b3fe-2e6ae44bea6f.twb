          <calculation class='tableau' formula='IF (ISOWEEK(DATETRUNC(&apos;iso-week&apos;, [datelive]))) &lt; 10 THEN STR(ISOYEAR(DATETRUNC(&apos;iso-year&apos;, [datelive]))) + &quot;W0&quot; + STR(ISOWEEK(DATETRUNC(&apos;iso-week&apos;, [datelive])))&#10;ELSE STR(ISOYEAR(DATETRUNC(&apos;iso-year&apos;, [datelive]))) + &quot;W&quot; + STR(ISOWEEK(DATETRUNC(&apos;iso-week&apos;, [datelive])))&#10;END&#10;//IF ISOWEEK([datelive]) &lt; 10 then str(YEAR([datelive])) + &quot;-W0&quot; + str(ISOWEEK([datelive]))&#10;//ELSE str(YEAR([datelive])) + &quot;-W&quot; + str(ISOWEEK([datelive]))&#10;//END' />
