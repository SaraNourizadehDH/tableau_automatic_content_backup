            </column>
            <column caption='Central Deal Value' datatype='real' name='[Calculation_1267130039230550032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([central_deal_value_eur])' />
            </column>
            <column caption='Central Joker Value' datatype='real' name='[Calculation_1267130039230615569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([central_joker_deal_value_eur])' />
            </column>
            <column caption='Central Voucher Value' datatype='real' name='[Calculation_1267130039230767122]' role='measure' type='quantitative'>
