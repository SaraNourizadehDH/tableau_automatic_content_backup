            </column>
            <column caption='central_vendors_fixed' datatype='real' name='[Calculation_1374794220274823171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country], DATETRUNC(&apos;month&apos;, [anchor_date]) : AVG([central_vendors])}' />
            </column>
            <column caption='Anchor Month Pro Live Vendors' datatype='integer' name='[Calculation_1374794220275200004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_vendors_live_pro_today])' />
            </column>
            <column caption='Central Allocated Vendors' datatype='real' name='[Calculation_1374794220277334021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1374794220274823171])' />
            </column>
            <column caption='Overall Deal Value Central / GFV Allocated Portfolio' datatype='real' name='[Calculation_1374794220279664650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_352688154313961473]) / SUM([Calculation_352688154313609216])' />
            </column>
