    <worksheet name='Country Level Working Non Pro'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_ssc_commercial_deal_page_2 (pandata_report)' name='federated.09wwgsv15ebjwm1emaph508ngrwu' />
          </datasources>
          <datasource-dependencies datasource='federated.09wwgsv15ebjwm1emaph508ngrwu'>
            <column caption='Non-Pro Vendors w. Active Deals ' datatype='integer' name='[Calculation_1374794220307812381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_unique_vendor_live_nonpro_today]) + SUM([pickup_unique_vendor_live_nonpro_today])' />
            </column>
            <column caption='Agent Department Name' datatype='string' name='[Calculation_1708834587883884546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([agent_department_name] = &quot;NULL&quot;&#10; &#9;&#9;&#9;&#9;&#9;OR &#10;&#9;[agent_department_name] = &quot;Non-Central&quot;&#10;&#9;&#9;&#9;&#9;&#9;OR&#10;    [agent_department_name] = NULL&#10;) &#10;THEN &quot;Non-Central&quot;&#10;ELSE [agent_department_name]&#10;END' />
            </column>
            <column caption='non_pro_utilization_a_fixed' datatype='real' name='[Calculation_3439624230311608329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([non_pro_utilization_a]) }' />
            </column>
            <column caption='non_pro_utilization_b_fixed' datatype='real' name='[Calculation_3439624230311800842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([non_pro_utilization_b]) }' />
            </column>
            <column caption='p rate denominator' datatype='real' name='[Calculation_456059895222726681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_99008876985720834])' />
            </column>
            <column caption='Non-Pro Deal Utilization - %' datatype='real' name='[Calculation_4989636557985239042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3439624230311608329]) / SUM([Calculation_3439624230311800842])' />
            </column>
            <column caption='Trend' datatype='string' name='[Calculation_99008876707127296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class] = &quot;Daily&quot; THEN STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-&quot; + STR(DATEPART(&apos;month&apos;,[anchor_date])) + &quot;-&quot; + STR(DATEPART(&apos;day&apos;,[anchor_date]))&#10;ELSEIF [class] = &quot;Weekly&quot; THEN (&#10;IF ISOWEEK([anchor_date]) &lt; 10 &#10;   THEN STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-W0&quot; + STR(DATEPART(&apos;iso-week&apos;,[anchor_date]))&#10;   ELSE STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-W&quot; + STR(DATEPART(&apos;iso-week&apos;,[anchor_date])) END) &#10;ELSEIF [class] = &quot;Monthly&quot; THEN&#10;(IF MONTH([anchor_date]) &lt; 10 THEN&#10; STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-0&quot; + STR(DATEPART(&apos;month&apos;,[anchor_date])) &#10; ELSE STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-&quot; + STR(DATEPART(&apos;month&apos;,[anchor_date])) &#10; END)&#10;END' />
            </column>
            <column caption='central allocated vendors' datatype='real' name='[Calculation_99008876985720834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country], [anchor_date] : AVG([central_vendors])}' />
            </column>
            <column caption='Non-Pro Deal Penetration%' datatype='real' name='[Calculation_99008876986626052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1374794220307812381] / [Calculation_456059895222726681]' />
            </column>
            <column caption='Agent_Department Name' datatype='string' name='[agent_department_name]' role='dimension' type='nominal' />
            <column caption='Anchor Date' datatype='date' name='[anchor_date]' role='dimension' type='ordinal' />
            <column caption='Central Vendors' datatype='integer' name='[central_vendors]' role='measure' type='quantitative' />
            <column caption='Class' datatype='string' name='[class]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='# Non-Pro Vendors w. Active Deals - Central(Delivery)' datatype='integer' name='[delivery_unique_vendor_live_nonpro_today]' role='measure' type='quantitative' />
            <column caption='Non Pro Utilization A' datatype='integer' name='[non_pro_utilization_a]' role='measure' type='quantitative' />
            <column caption='Non Pro Utilization B' datatype='integer' name='[non_pro_utilization_b]' role='measure' type='quantitative' />
