    <dashboard name='Deal Value Vs Discount Ratio'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-158:8297/t/Foodora/workbooks/APACDealsCountryReportTEST/DealValueVsDiscountRatio?rev=' id='DealValueVsDiscountRatio' path='/t/Foodora/workbooks/APACDealsCountryReportTEST' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-title'>
          <format attr='text-align' value='center' />
          <format attr='color' value='#ffffff' />
          <format attr='font-weight' value='normal' />
          <format attr='background-color' value='#555555' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='color' value='#ffffff' />
          <format attr='font-weight' value='bold' />
        </style-rule>
      </style>
      <size maxheight='950' maxwidth='1400' minheight='950' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='regional_ssc_commercial_deal_page_4 (sandbox_ssc)' name='federated.1420orn0hal8gi12sjb5q0hlmoz7' />
        <datasource caption='regional_ssc_commercial_deal_page_3 (pandata_report)' name='federated.1qesum70ucvnic1exq3qb1h59pxx' />
      </datasources>
      <datasource-dependencies datasource='federated.1420orn0hal8gi12sjb5q0hlmoz7'>
        <column caption='Agent Department Name' datatype='string' name='[Calculation_1708834587886387204]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ([agent_department_name] = &quot;NULL&quot;&#10; &#9;&#9;&#9;&#9;&#9;OR &#10;&#9;[agent_department_name] = &quot;Non-Central&quot;&#10;&#9;&#9;&#9;&#9;&#9;OR&#10;    [agent_department_name] = NULL&#10;) &#10;THEN &quot;Non-Central&quot;&#10;ELSE [agent_department_name]&#10;END' />
        </column>
        <column caption='FoodPanda Ratio' datatype='string' name='[Calculation_99008877416755225]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [discount_type] = &apos;percentage&apos; THEN&#10;(IF [Calculation_99008877416886298] &gt;=10 and [Calculation_99008877416886298] &lt; 15 then &apos; 10%&apos; &#10;ELSEIF [Calculation_99008877416886298] &gt;=15 and [Calculation_99008877416886298] &lt; 20 then &apos; 15%&apos; &#10;ELSEIF [Calculation_99008877416886298] &gt;=20 and [Calculation_99008877416886298] &lt; 25 then &apos; 20%&apos; &#10;ELSEIF [Calculation_99008877416886298] &gt;=25 and [Calculation_99008877416886298] &lt; 30 then &apos; 25%&apos; &#10;ELSEIF [Calculation_99008877416886298] &gt;=30 and [Calculation_99008877416886298] &lt;= 100  then &apos; 30%&apos;&#10;ELSEIF [Calculation_99008877416886298] &gt;=0 and [Calculation_99008877416886298] &lt;10  then &apos; &lt;10%&apos;&#10;END)&#10;ELSE [discount_type] &#10;END' />
        </column>
