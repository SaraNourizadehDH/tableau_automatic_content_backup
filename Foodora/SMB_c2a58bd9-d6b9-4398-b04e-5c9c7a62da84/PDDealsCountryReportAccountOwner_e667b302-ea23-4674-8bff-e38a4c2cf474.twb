            <local-type>boolean</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_1D3AE1FD594A448BBBA09BFA5C082C51]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>is_vendor_booked_on_voucher</remote-name>
            <remote-type>11</remote-type>
            <local-name>[is_vendor_booked_on_voucher]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>is_vendor_booked_on_voucher</remote-alias>
            <local-type>boolean</local-type>
