            </column>
            <column caption='Agent Department Name' datatype='string' name='[Calculation_1708834587883884546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([agent_department_name] = &quot;NULL&quot;&#10; &#9;&#9;&#9;&#9;&#9;OR &#10;&#9;[agent_department_name] = &quot;Non-Central&quot;&#10;&#9;&#9;&#9;&#9;&#9;OR&#10;    [agent_department_name] = NULL&#10;) &#10;THEN &quot;Non-Central&quot;&#10;ELSE [agent_department_name]&#10;END' />
            </column>
            <column caption='utilization_a_fixed' datatype='real' name='[Calculation_3439624230302769156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([utilization_a]) }' />
            </column>
            <column caption='utilization_b_fixed' datatype='real' name='[Calculation_3439624230302904325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([utilization_b]) }' />
