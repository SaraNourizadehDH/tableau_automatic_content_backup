    </datasource>
    <datasource caption='regional_ssc_commercial_mmt_deal_raw_data Query (pandata_report)' inline='true' name='federated.0xlf8b016zu1410zogyi91l1uunh' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.15xhdrm0w4vbae1gau3wl0awhhep'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='kampon.wongwuttinun@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.15xhdrm0w4vbae1gau3wl0awhhep' name='Custom SQL Query' type='text'><![CDATA[WITH base AS (
    SELECT
      DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH) AS effective_month,
      regional_apac_daily_vendor_deals_config.report_date,
      MAX(report_date) OVER(PARTITION BY DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH)) AS last_report_month_date,
      regional_apac_daily_vendor_deals_config.global_entity_id,
      regional_apac_daily_vendor_deals_config.vendor_code,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_voucher_config,
      discount_details.pd_discount_uuid,
      discount_details.title AS deal_title,
      FALSE AS is_voucher,
      FALSE AS is_jimatpro,
      discount_details.is_subscription_discount,
      DATETIME(TIMESTAMP(discount_details.created_at_utc), shared_countries.timezone) AS booked_at_local,
      discount_details.start_date_local,
      discount_details.end_date_local,
      DATETIME(TIMESTAMP(discount_details.updated_at_utc), shared_countries.timezone) AS updated_at_local,
      discount_details.minimum_order_value_local,
      discount_details.amount_local,
      discount_details.discount_type,
      discount_details.foodpanda_ratio,
      CASE
        WHEN pd_discounts.foodpanda_ratio = 100 THEN "Foodpanda Funded"
        WHEN pd_discounts.foodpanda_ratio = 0 THEN "Vendor Funded"
        WHEN pd_discounts.foodpanda_ratio >> 0 AND pd_discounts.foodpanda_ratio << 100 THEN "Co-Funded"
      END AS deal_funding_type,
      pd_discounts.maximum_discount_amount_local,
      pd_discounts.maximum_discount_amount_eur,
      IF(LOWER(pd_discounts.discount_mgmt_created_by) NOT LIKE "%@foodpanda%", TRUE, FALSE) AS is_ssu,
      pd_discounts.discount_mgmt_created_by,
      CASE
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%@%" AND pd_discounts.discount_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, ":")[OFFSET(0)])
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(0)])
        ELSE pd_discounts.discount_mgmt_created_by
      END AS booking_agent_type,
      CASE
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%@%" AND pd_discounts.discount_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, ":")[OFFSET(1)])
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)])
        ELSE pd_discounts.discount_mgmt_created_by
      END AS booking_agent_email,
      CASE
        WHEN pd_discounts.discount_mgmt_updated_by LIKE "%@%" AND pd_discounts.discount_mgmt_updated_by LIKE "%:%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_updated_by, ":")[OFFSET(1)])
        WHEN pd_discounts.discount_mgmt_updated_by LIKE "%-%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_updated_by, "-")[OFFSET(1)])
        ELSE pd_discounts.discount_mgmt_updated_by
      END AS booking_updated_by_agent_email,
      regional_ssc_commercial_central_agents.team AS agent_team_name,
      CASE
        WHEN LOWER(regional_ssc_commercial_central_agents.department) = "commercial" THEN "Central-Ops"
        WHEN LOWER(regional_ssc_commercial_central_agents.department) = "quality, training & knowledge" THEN "Central-QTK"
        WHEN LOWER(pd_discounts.discount_mgmt_created_by) NOT LIKE "%@foodpanda%" THEN "Self-Booking"
        ELSE "Non-Central"
      END AS agent_department_name,
      IF(regional_ssc_commercial_central_agents.alias IS NOT NULL, "central", "non-central") AS agent_booking_source
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_daily_vendor_deals_config` AS regional_apac_daily_vendor_deals_config
    LEFT JOIN UNNEST(discounts_details) AS discount_details
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
           ON regional_apac_daily_vendor_deals_config.global_entity_id = shared_countries.global_entity_id
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS pd_discounts
       ON discount_details.pd_discount_uuid = pd_discounts.uuid
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_ssc_commercial_central_agents` AS regional_ssc_commercial_central_agents
           ON SPLIT(LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]),
          CASE
            WHEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]) LIKE "%foodpanda.com" THEN ".com"
            WHEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]) LIKE "%foodpanda.my" THEN ".my"
            WHEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]) LIKE "%foodpanda.co.th" THEN ".co.th"
          END)[OFFSET(0)] = regional_ssc_commercial_central_agents.alias
    WHERE regional_apac_daily_vendor_deals_config.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 6 MONTH)
      AND discount_details.foodpanda_ratio << 100
      AND regional_apac_daily_vendor_deals_config.global_entity_id IN ("FP_MY", "FP_SG", "FP_HK", "FP_PH", "FP_TH", "FP_TW")
    QUALIFY ROW_NUMBER() OVER(PARTITION BY global_entity_id, vendor_code, effective_month, is_subscription_discount ORDER BY report_date DESC, booked_at_local DESC) = 1

    UNION ALL

    SELECT
      DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH) AS effective_month,
      regional_apac_daily_vendor_deals_config.report_date,
      MAX(report_date) OVER(PARTITION BY DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH)) AS last_report_month_date,
      regional_apac_daily_vendor_deals_config.global_entity_id,
      regional_apac_daily_vendor_deals_config.vendor_code,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_voucher_config,
      voucher_details.pd_voucher_uuid,
      "NULL" AS deal_title,
      TRUE AS is_voucher,
      IF(voucher_details.pd_voucher_uuid = "OFRV_7893852307825541_FP_MY", TRUE, FALSE) AS is_jimatpro,
      voucher_details.is_subscription_voucher,
      DATETIME(TIMESTAMP(voucher_details.created_at_utc), shared_countries.timezone) AS booked_at_local,
      voucher_details.start_date_local,
      voucher_details.end_date_local,
      DATETIME(TIMESTAMP(voucher_details.updated_at_utc), shared_countries.timezone) AS updated_at_local,
      voucher_details.minimum_order_value_local,
      voucher_details.amount_local,
      voucher_details.voucher_type,
      pd_vouchers.foodpanda_ratio,
       CASE
        WHEN pd_vouchers.foodpanda_ratio = 100 THEN "Foodpanda Funded"
        WHEN pd_vouchers.foodpanda_ratio = 0 THEN "Vendor Funded"
        WHEN pd_vouchers.foodpanda_ratio >> 0 AND pd_vouchers.foodpanda_ratio << 100 THEN "Co-Funded"
      END AS deal_funding_type,
      pd_vouchers.maximum_discount_amount_local,
      SAFE_DIVIDE(pd_vouchers.maximum_discount_amount_local, fx_rates.fx_rate_eur) AS maximum_discount_amount_eur,
      IF(LOWER(pd_vouchers.voucher_mgmt_created_by) NOT LIKE "%@foodpanda%", TRUE, FALSE) AS is_ssu,
      pd_vouchers.voucher_mgmt_created_by,
      CASE
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%@%" AND pd_vouchers.voucher_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, ":")[OFFSET(0)])
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, "-")[OFFSET(0)])
    ELSE pd_vouchers.voucher_mgmt_created_by
  END AS booking_agent_type,
  CASE
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%@%" AND pd_vouchers.voucher_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, ":")[OFFSET(1)])
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, "-")[OFFSET(1)])
    ELSE pd_vouchers.voucher_mgmt_created_by
  END AS booking_agent_email,
  CASE
    WHEN pd_vouchers.voucher_mgmt_updated_by LIKE "%@%" AND pd_vouchers.voucher_mgmt_updated_by LIKE "%:%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_updated_by, ":")[OFFSET(1)])
    WHEN pd_vouchers.voucher_mgmt_updated_by LIKE "%-%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_updated_by, "-")[OFFSET(1)])
    ELSE pd_vouchers.voucher_mgmt_updated_by
  END AS booking_updated_by_agent_email,
  regional_ssc_commercial_central_agents.team AS agent_team_name,
  CASE
    WHEN LOWER(regional_ssc_commercial_central_agents.department) = "commercial" THEN "Central-Ops"
    WHEN LOWER(regional_ssc_commercial_central_agents.department) = "quality, training & knowledge" THEN "Central-QTK"
    WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) NOT LIKE "%@foodpanda%" THEN "Self-Booking"
    ELSE "Non-Central"
  END AS agent_department_name,
  IF(regional_ssc_commercial_central_agents.alias IS NOT NULL, "central", "non-central") AS agent_booking_source
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_daily_vendor_deals_config` AS regional_apac_daily_vendor_deals_config
    LEFT JOIN UNNEST(vouchers_details) AS voucher_details
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS  shared_countries
           ON regional_apac_daily_vendor_deals_config.global_entity_id = shared_countries.global_entity_id
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS pd_vouchers
       ON voucher_details.pd_voucher_uuid = pd_vouchers.uuid
      AND pd_vouchers.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH) 
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_ssc_commercial_central_agents` AS regional_ssc_commercial_central_agents
           ON SPLIT(LOWER(pd_vouchers.voucher_mgmt_created_by), 
            CASE 
              WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) LIKE "%foodpanda.com" THEN '.com' 
              WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) LIKE "%foodpanda.my" THEN '.my' 
              WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) LIKE "%foodpanda.co.th" THEN '.co.th' 
            END)[OFFSET(0)] = regional_ssc_commercial_central_agents.alias
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS fx_rates
           ON shared_countries.currency_code_iso = fx_rates.currency_code
          AND regional_apac_daily_vendor_deals_config.report_date = fx_rates.fx_rate_date
    WHERE regional_apac_daily_vendor_deals_config.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 6 MONTH)
      AND voucher_details.foodpanda_ratio << 100
      AND regional_apac_daily_vendor_deals_config.global_entity_id IN ("FP_MY", "FP_SG", "FP_HK", "FP_PH", "FP_TH", "FP_TW")
    QUALIFY ROW_NUMBER() OVER(PARTITION BY global_entity_id, vendor_code, effective_month, is_subscription_voucher ORDER BY report_date DESC, booked_at_local DESC) = 1
  ),

  active_vendors AS (
  SELECT
    pandora_vendor_status.global_entity_id,
    DATE_TRUNC(pandora_vendor_status.report_date, MONTH) AS report_month,
    pandora_vendor_status.vendor_code
  FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS pandora_vendor_status
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS regional_apac_commercial_vendors
         ON pandora_vendor_status.global_entity_id = regional_apac_commercial_vendors.global_entity_id
        AND pandora_vendor_status.vendor_code = regional_apac_commercial_vendors.vendor_code
  WHERE pandora_vendor_status.is_active
    AND NOT pandora_vendor_status.is_private
    AND NOT pandora_vendor_status.is_test
    AND regional_apac_commercial_vendors.business_type_apac = "restaurants"
    AND pandora_vendor_status.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR)
  QUALIFY ROW_NUMBER()
    OVER (PARTITION BY pandora_vendor_status.global_entity_id, report_month, pandora_vendor_status.vendor_code) = 1
),

deals_data AS (
  SELECT
    effective_month,
    global_entity_id,
    IF(is_vf_regular_pro_delivery_deal_config OR is_vf_regular_pro_pickup_deal_config, TRUE, FALSE) AS is_panda_pro,
    is_vf_regular_platform_delivery_deal_config,
    is_vf_regular_platform_pickup_deal_config,
    is_vf_regular_voucher_config AS is_vendor_booked_on_voucher,
    base.vendor_code,
    pd_discount_uuid,
    deal_title,
    is_voucher,
    is_jimatpro,
    is_subscription_discount AS is_subscription_deal,
    booked_at_local,
    start_date_local,
    end_date_local,
    updated_at_local,
    minimum_order_value_local,
    amount_local,
    discount_type,
    foodpanda_ratio,
    deal_funding_type,
    maximum_discount_amount_local,
    maximum_discount_amount_eur,
    is_ssu,
    discount_mgmt_created_by,
    booking_agent_type,
    booking_agent_email,
    booking_updated_by_agent_email,
    agent_team_name,
    agent_department_name,
    agent_booking_source
  FROM base
  QUALIFY ROW_NUMBER() OVER(PARTITION BY global_entity_id, vendor_code, effective_month, is_subscription_discount ORDER BY report_date DESC, booked_at_local DESC) = 1
)

SELECT
  deals_data.effective_month,
  deals_data.global_entity_id,
  shared_countries.name AS country,
  deals_data.is_panda_pro,
  deals_data.is_vf_regular_platform_delivery_deal_config AS is_non_pro_delivery,
  deals_data.is_vf_regular_platform_pickup_deal_config AS is_non_pro_pickup,
  deals_data.is_vendor_booked_on_voucher,
  deals_data.vendor_code,
  deals_data.pd_discount_uuid,
  deals_data.deal_title,
  deals_data.is_voucher,
  deals_data.is_jimatpro,
  deals_data.is_subscription_deal,
  deals_data.booked_at_local,
  deals_data.start_date_local,
  deals_data.end_date_local,
  deals_data.updated_at_local,
  deals_data.minimum_order_value_local,
  deals_data.amount_local,
  deals_data.discount_type,
  deals_data.foodpanda_ratio,
  deals_data.deal_funding_type,
  deals_data.maximum_discount_amount_local,
  deals_data.maximum_discount_amount_eur,
  deals_data.is_ssu,
  deals_data.discount_mgmt_created_by,
  deals_data.booking_agent_type,
  deals_data.booking_agent_email,
  deals_data.booking_updated_by_agent_email,
  deals_data.agent_team_name,
  agent_department_name,
  deals_data.agent_booking_source,
  regional_ssc_commercial_central_account_owner.owner_name AS owner_name_lead_month,
  regional_ssc_commercial_central_account_owner.account_classification AS account_classification_lead_month,
  sf_accounts.vendor_grade,
  regional_apac_pd_vendors_agg_business_types.business_type_apac AS vendor_business_type_apac,
  regional_apac_vendor_gmv_class.gmv_class AS vendor_gmv_class
FROM deals_data
  LEFT JOIN active_vendors
         ON active_vendors.global_entity_id = deals_data.global_entity_id
        AND active_vendors.vendor_code = deals_data.vendor_code
        AND active_vendors.report_month = DATE_TRUNC(deals_data.effective_month, MONTH)
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_ssc_commercial_central_account_owner` AS regional_ssc_commercial_central_account_owner
         ON deals_data.global_entity_id = regional_ssc_commercial_central_account_owner.global_entity_id
        AND DATE_TRUNC(deals_data.effective_month, MONTH) = regional_ssc_commercial_central_account_owner.report_month
        AND deals_data.vendor_code = regional_ssc_commercial_central_account_owner.vendor_code
        AND regional_ssc_commercial_central_account_owner.report_month >>= "2021-05-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_cx_sf_accounts` AS sf_accounts
       ON deals_data.global_entity_id = sf_accounts.global_entity_id
      AND deals_data.vendor_code = sf_accounts.vendor_code
      AND sf_accounts.created_date_utc >>= "2018-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS regional_apac_pd_vendors_agg_business_types
       ON deals_data.global_entity_id = regional_apac_pd_vendors_agg_business_types.global_entity_id
      AND deals_data.vendor_code = regional_apac_pd_vendors_agg_business_types.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_gmv_class` AS regional_apac_vendor_gmv_class
       ON deals_data.global_entity_id = regional_apac_vendor_gmv_class.global_entity_id
      AND deals_data.vendor_code = regional_apac_vendor_gmv_class.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON deals_data.global_entity_id = shared_countries.global_entity_id
  WHERE active_vendors.vendor_code IS NOT NULL
    AND (
    IF(regional_ssc_commercial_central_account_owner.global_entity_id = "FP_TW",
     CASE
      WHEN regional_ssc_commercial_central_account_owner.report_month << "2022-10-1"
           AND TRIM(regional_ssc_commercial_central_account_owner.gmv_class) IN ("D")
           AND TRIM(regional_ssc_commercial_central_account_owner.vendor_grade) IN ("B", "D") THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month BETWEEN "2022-10-1" AND "2022-12-1"
           AND (LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "ssc"
                OR TRIM(regional_ssc_commercial_central_account_owner.gmv_class) IN ("D")) THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month BETWEEN "2022-12-01" AND "2023-06-01"
        AND regional_ssc_commercial_central_account_owner.global_entity_id = "FP_TW"
        AND (LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "ssc"
        OR LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "pc - country") THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month >>= "2022-12-01" AND regional_ssc_commercial_central_account_owner.report_month <<= "2023-12-01"
           AND (LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "ssc") THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month >> "2023-12-01" AND regional_ssc_commercial_central_account_owner.is_central_allocated THEN TRUE
      ELSE FALSE
     END,
     regional_ssc_commercial_central_account_owner.is_central_allocated)
     ) = TRUE
     AND (deals_data.is_panda_pro
      OR deals_data.is_vf_regular_platform_delivery_deal_config
      OR deals_data.is_vf_regular_platform_pickup_deal_config)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.15xhdrm0w4vbae1gau3wl0awhhep' name='Custom SQL Query' type='text'><![CDATA[WITH base AS (
    SELECT
      DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH) AS effective_month,
      regional_apac_daily_vendor_deals_config.report_date,
      MAX(report_date) OVER(PARTITION BY DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH)) AS last_report_month_date,
      regional_apac_daily_vendor_deals_config.global_entity_id,
      regional_apac_daily_vendor_deals_config.vendor_code,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_voucher_config,
      discount_details.pd_discount_uuid,
      discount_details.title AS deal_title,
      FALSE AS is_voucher,
      FALSE AS is_jimatpro,
      discount_details.is_subscription_discount,
      DATETIME(TIMESTAMP(discount_details.created_at_utc), shared_countries.timezone) AS booked_at_local,
      discount_details.start_date_local,
      discount_details.end_date_local,
      DATETIME(TIMESTAMP(discount_details.updated_at_utc), shared_countries.timezone) AS updated_at_local,
      discount_details.minimum_order_value_local,
      discount_details.amount_local,
      discount_details.discount_type,
      discount_details.foodpanda_ratio,
      CASE
        WHEN pd_discounts.foodpanda_ratio = 100 THEN "Foodpanda Funded"
        WHEN pd_discounts.foodpanda_ratio = 0 THEN "Vendor Funded"
        WHEN pd_discounts.foodpanda_ratio >> 0 AND pd_discounts.foodpanda_ratio << 100 THEN "Co-Funded"
      END AS deal_funding_type,
      pd_discounts.maximum_discount_amount_local,
      pd_discounts.maximum_discount_amount_eur,
      IF(LOWER(pd_discounts.discount_mgmt_created_by) NOT LIKE "%@foodpanda%", TRUE, FALSE) AS is_ssu,
      pd_discounts.discount_mgmt_created_by,
      CASE
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%@%" AND pd_discounts.discount_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, ":")[OFFSET(0)])
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(0)])
        ELSE pd_discounts.discount_mgmt_created_by
      END AS booking_agent_type,
      CASE
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%@%" AND pd_discounts.discount_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, ":")[OFFSET(1)])
        WHEN pd_discounts.discount_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)])
        ELSE pd_discounts.discount_mgmt_created_by
      END AS booking_agent_email,
      CASE
        WHEN pd_discounts.discount_mgmt_updated_by LIKE "%@%" AND pd_discounts.discount_mgmt_updated_by LIKE "%:%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_updated_by, ":")[OFFSET(1)])
        WHEN pd_discounts.discount_mgmt_updated_by LIKE "%-%" THEN LOWER(SPLIT(pd_discounts.discount_mgmt_updated_by, "-")[OFFSET(1)])
        ELSE pd_discounts.discount_mgmt_updated_by
      END AS booking_updated_by_agent_email,
      regional_ssc_commercial_central_agents.team AS agent_team_name,
      CASE
        WHEN LOWER(regional_ssc_commercial_central_agents.department) = "commercial" THEN "Central-Ops"
        WHEN LOWER(regional_ssc_commercial_central_agents.department) = "quality, training & knowledge" THEN "Central-QTK"
        WHEN LOWER(pd_discounts.discount_mgmt_created_by) NOT LIKE "%@foodpanda%" THEN "Self-Booking"
        ELSE "Non-Central"
      END AS agent_department_name,
      IF(regional_ssc_commercial_central_agents.alias IS NOT NULL, "central", "non-central") AS agent_booking_source
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_daily_vendor_deals_config` AS regional_apac_daily_vendor_deals_config
    LEFT JOIN UNNEST(discounts_details) AS discount_details
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
           ON regional_apac_daily_vendor_deals_config.global_entity_id = shared_countries.global_entity_id
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS pd_discounts
       ON discount_details.pd_discount_uuid = pd_discounts.uuid
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_ssc_commercial_central_agents` AS regional_ssc_commercial_central_agents
           ON SPLIT(LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]),
          CASE
            WHEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]) LIKE "%foodpanda.com" THEN ".com"
            WHEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]) LIKE "%foodpanda.my" THEN ".my"
            WHEN LOWER(SPLIT(pd_discounts.discount_mgmt_created_by, "-")[OFFSET(1)]) LIKE "%foodpanda.co.th" THEN ".co.th"
          END)[OFFSET(0)] = regional_ssc_commercial_central_agents.alias
    WHERE regional_apac_daily_vendor_deals_config.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 6 MONTH)
      AND discount_details.foodpanda_ratio << 100
      AND regional_apac_daily_vendor_deals_config.global_entity_id IN ("FP_MY", "FP_SG", "FP_HK", "FP_PH", "FP_TH", "FP_TW")
    QUALIFY ROW_NUMBER() OVER(PARTITION BY global_entity_id, vendor_code, effective_month, is_subscription_discount ORDER BY report_date DESC, booked_at_local DESC) = 1

    UNION ALL

    SELECT
      DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH) AS effective_month,
      regional_apac_daily_vendor_deals_config.report_date,
      MAX(report_date) OVER(PARTITION BY DATE_TRUNC(regional_apac_daily_vendor_deals_config.report_date, MONTH)) AS last_report_month_date,
      regional_apac_daily_vendor_deals_config.global_entity_id,
      regional_apac_daily_vendor_deals_config.vendor_code,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_pro_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_delivery_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_platform_pickup_deal_config,
      regional_apac_daily_vendor_deals_config.is_vf_regular_voucher_config,
      voucher_details.pd_voucher_uuid,
      "NULL" AS deal_title,
      TRUE AS is_voucher,
      IF(voucher_details.pd_voucher_uuid = "OFRV_7893852307825541_FP_MY", TRUE, FALSE) AS is_jimatpro,
      voucher_details.is_subscription_voucher,
      DATETIME(TIMESTAMP(voucher_details.created_at_utc), shared_countries.timezone) AS booked_at_local,
      voucher_details.start_date_local,
      voucher_details.end_date_local,
      DATETIME(TIMESTAMP(voucher_details.updated_at_utc), shared_countries.timezone) AS updated_at_local,
      voucher_details.minimum_order_value_local,
      voucher_details.amount_local,
      voucher_details.voucher_type,
      pd_vouchers.foodpanda_ratio,
       CASE
        WHEN pd_vouchers.foodpanda_ratio = 100 THEN "Foodpanda Funded"
        WHEN pd_vouchers.foodpanda_ratio = 0 THEN "Vendor Funded"
        WHEN pd_vouchers.foodpanda_ratio >> 0 AND pd_vouchers.foodpanda_ratio << 100 THEN "Co-Funded"
      END AS deal_funding_type,
      pd_vouchers.maximum_discount_amount_local,
      SAFE_DIVIDE(pd_vouchers.maximum_discount_amount_local, fx_rates.fx_rate_eur) AS maximum_discount_amount_eur,
      IF(LOWER(pd_vouchers.voucher_mgmt_created_by) NOT LIKE "%@foodpanda%", TRUE, FALSE) AS is_ssu,
      pd_vouchers.voucher_mgmt_created_by,
      CASE
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%@%" AND pd_vouchers.voucher_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, ":")[OFFSET(0)])
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, "-")[OFFSET(0)])
    ELSE pd_vouchers.voucher_mgmt_created_by
  END AS booking_agent_type,
  CASE
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%@%" AND pd_vouchers.voucher_mgmt_created_by LIKE "%:%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, ":")[OFFSET(1)])
    WHEN pd_vouchers.voucher_mgmt_created_by LIKE "%-%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_created_by, "-")[OFFSET(1)])
    ELSE pd_vouchers.voucher_mgmt_created_by
  END AS booking_agent_email,
  CASE
    WHEN pd_vouchers.voucher_mgmt_updated_by LIKE "%@%" AND pd_vouchers.voucher_mgmt_updated_by LIKE "%:%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_updated_by, ":")[OFFSET(1)])
    WHEN pd_vouchers.voucher_mgmt_updated_by LIKE "%-%" THEN LOWER(SPLIT(pd_vouchers.voucher_mgmt_updated_by, "-")[OFFSET(1)])
    ELSE pd_vouchers.voucher_mgmt_updated_by
  END AS booking_updated_by_agent_email,
  regional_ssc_commercial_central_agents.team AS agent_team_name,
  CASE
    WHEN LOWER(regional_ssc_commercial_central_agents.department) = "commercial" THEN "Central-Ops"
    WHEN LOWER(regional_ssc_commercial_central_agents.department) = "quality, training & knowledge" THEN "Central-QTK"
    WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) NOT LIKE "%@foodpanda%" THEN "Self-Booking"
    ELSE "Non-Central"
  END AS agent_department_name,
  IF(regional_ssc_commercial_central_agents.alias IS NOT NULL, "central", "non-central") AS agent_booking_source
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_daily_vendor_deals_config` AS regional_apac_daily_vendor_deals_config
    LEFT JOIN UNNEST(vouchers_details) AS voucher_details
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS  shared_countries
           ON regional_apac_daily_vendor_deals_config.global_entity_id = shared_countries.global_entity_id
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS pd_vouchers
       ON voucher_details.pd_voucher_uuid = pd_vouchers.uuid
      AND pd_vouchers.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH) 
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_ssc_commercial_central_agents` AS regional_ssc_commercial_central_agents
           ON SPLIT(LOWER(pd_vouchers.voucher_mgmt_created_by), 
            CASE 
              WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) LIKE "%foodpanda.com" THEN '.com' 
              WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) LIKE "%foodpanda.my" THEN '.my' 
              WHEN LOWER(pd_vouchers.voucher_mgmt_created_by) LIKE "%foodpanda.co.th" THEN '.co.th' 
            END)[OFFSET(0)] = regional_ssc_commercial_central_agents.alias
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS fx_rates
           ON shared_countries.currency_code_iso = fx_rates.currency_code
          AND regional_apac_daily_vendor_deals_config.report_date = fx_rates.fx_rate_date
    WHERE regional_apac_daily_vendor_deals_config.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 6 MONTH)
      AND voucher_details.foodpanda_ratio << 100
      AND regional_apac_daily_vendor_deals_config.global_entity_id IN ("FP_MY", "FP_SG", "FP_HK", "FP_PH", "FP_TH", "FP_TW")
    QUALIFY ROW_NUMBER() OVER(PARTITION BY global_entity_id, vendor_code, effective_month, is_subscription_voucher ORDER BY report_date DESC, booked_at_local DESC) = 1
  ),

  active_vendors AS (
  SELECT
    pandora_vendor_status.global_entity_id,
    DATE_TRUNC(pandora_vendor_status.report_date, MONTH) AS report_month,
    pandora_vendor_status.vendor_code
  FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS pandora_vendor_status
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS regional_apac_commercial_vendors
         ON pandora_vendor_status.global_entity_id = regional_apac_commercial_vendors.global_entity_id
        AND pandora_vendor_status.vendor_code = regional_apac_commercial_vendors.vendor_code
  WHERE pandora_vendor_status.is_active
    AND NOT pandora_vendor_status.is_private
    AND NOT pandora_vendor_status.is_test
    AND regional_apac_commercial_vendors.business_type_apac = "restaurants"
    AND pandora_vendor_status.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR)
  QUALIFY ROW_NUMBER()
    OVER (PARTITION BY pandora_vendor_status.global_entity_id, report_month, pandora_vendor_status.vendor_code) = 1
),

deals_data AS (
  SELECT
    effective_month,
    global_entity_id,
    IF(is_vf_regular_pro_delivery_deal_config OR is_vf_regular_pro_pickup_deal_config, TRUE, FALSE) AS is_panda_pro,
    is_vf_regular_platform_delivery_deal_config,
    is_vf_regular_platform_pickup_deal_config,
    is_vf_regular_voucher_config AS is_vendor_booked_on_voucher,
    base.vendor_code,
    pd_discount_uuid,
    deal_title,
    is_voucher,
    is_jimatpro,
    is_subscription_discount AS is_subscription_deal,
    booked_at_local,
    start_date_local,
    end_date_local,
    updated_at_local,
    minimum_order_value_local,
    amount_local,
    discount_type,
    foodpanda_ratio,
    deal_funding_type,
    maximum_discount_amount_local,
    maximum_discount_amount_eur,
    is_ssu,
    discount_mgmt_created_by,
    booking_agent_type,
    booking_agent_email,
    booking_updated_by_agent_email,
    agent_team_name,
    agent_department_name,
    agent_booking_source
  FROM base
  QUALIFY ROW_NUMBER() OVER(PARTITION BY global_entity_id, vendor_code, effective_month, is_subscription_discount ORDER BY report_date DESC, booked_at_local DESC) = 1
)

SELECT
  deals_data.effective_month,
  deals_data.global_entity_id,
  shared_countries.name AS country,
  deals_data.is_panda_pro,
  deals_data.is_vf_regular_platform_delivery_deal_config AS is_non_pro_delivery,
  deals_data.is_vf_regular_platform_pickup_deal_config AS is_non_pro_pickup,
  deals_data.is_vendor_booked_on_voucher,
  deals_data.vendor_code,
  deals_data.pd_discount_uuid,
  deals_data.deal_title,
  deals_data.is_voucher,
  deals_data.is_jimatpro,
  deals_data.is_subscription_deal,
  deals_data.booked_at_local,
  deals_data.start_date_local,
  deals_data.end_date_local,
  deals_data.updated_at_local,
  deals_data.minimum_order_value_local,
  deals_data.amount_local,
  deals_data.discount_type,
  deals_data.foodpanda_ratio,
  deals_data.deal_funding_type,
  deals_data.maximum_discount_amount_local,
  deals_data.maximum_discount_amount_eur,
  deals_data.is_ssu,
  deals_data.discount_mgmt_created_by,
  deals_data.booking_agent_type,
  deals_data.booking_agent_email,
  deals_data.booking_updated_by_agent_email,
  deals_data.agent_team_name,
  agent_department_name,
  deals_data.agent_booking_source,
  regional_ssc_commercial_central_account_owner.owner_name AS owner_name_lead_month,
  regional_ssc_commercial_central_account_owner.account_classification AS account_classification_lead_month,
  sf_accounts.vendor_grade,
  regional_apac_pd_vendors_agg_business_types.business_type_apac AS vendor_business_type_apac,
  regional_apac_vendor_gmv_class.gmv_class AS vendor_gmv_class
FROM deals_data
  LEFT JOIN active_vendors
         ON active_vendors.global_entity_id = deals_data.global_entity_id
        AND active_vendors.vendor_code = deals_data.vendor_code
        AND active_vendors.report_month = DATE_TRUNC(deals_data.effective_month, MONTH)
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_ssc_commercial_central_account_owner` AS regional_ssc_commercial_central_account_owner
         ON deals_data.global_entity_id = regional_ssc_commercial_central_account_owner.global_entity_id
        AND DATE_TRUNC(deals_data.effective_month, MONTH) = regional_ssc_commercial_central_account_owner.report_month
        AND deals_data.vendor_code = regional_ssc_commercial_central_account_owner.vendor_code
        AND regional_ssc_commercial_central_account_owner.report_month >>= "2021-05-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_cx_sf_accounts` AS sf_accounts
       ON deals_data.global_entity_id = sf_accounts.global_entity_id
      AND deals_data.vendor_code = sf_accounts.vendor_code
      AND sf_accounts.created_date_utc >>= "2018-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS regional_apac_pd_vendors_agg_business_types
       ON deals_data.global_entity_id = regional_apac_pd_vendors_agg_business_types.global_entity_id
      AND deals_data.vendor_code = regional_apac_pd_vendors_agg_business_types.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_gmv_class` AS regional_apac_vendor_gmv_class
       ON deals_data.global_entity_id = regional_apac_vendor_gmv_class.global_entity_id
      AND deals_data.vendor_code = regional_apac_vendor_gmv_class.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON deals_data.global_entity_id = shared_countries.global_entity_id
  WHERE active_vendors.vendor_code IS NOT NULL
    AND (
    IF(regional_ssc_commercial_central_account_owner.global_entity_id = "FP_TW",
     CASE
      WHEN regional_ssc_commercial_central_account_owner.report_month << "2022-10-1"
           AND TRIM(regional_ssc_commercial_central_account_owner.gmv_class) IN ("D")
           AND TRIM(regional_ssc_commercial_central_account_owner.vendor_grade) IN ("B", "D") THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month BETWEEN "2022-10-1" AND "2022-12-1"
           AND (LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "ssc"
                OR TRIM(regional_ssc_commercial_central_account_owner.gmv_class) IN ("D")) THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month BETWEEN "2022-12-01" AND "2023-06-01"
        AND regional_ssc_commercial_central_account_owner.global_entity_id = "FP_TW"
        AND (LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "ssc"
        OR LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "pc - country") THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month >>= "2022-12-01" AND regional_ssc_commercial_central_account_owner.report_month <<= "2023-12-01"
           AND (LOWER(TRIM(regional_ssc_commercial_central_account_owner.account_classification)) LIKE "ssc") THEN TRUE
      WHEN regional_ssc_commercial_central_account_owner.report_month >> "2023-12-01" AND regional_ssc_commercial_central_account_owner.is_central_allocated THEN TRUE
      ELSE FALSE
     END,
     regional_ssc_commercial_central_account_owner.is_central_allocated)
     ) = TRUE
     AND (deals_data.is_panda_pro
      OR deals_data.is_vf_regular_platform_delivery_deal_config
      OR deals_data.is_vf_regular_platform_pickup_deal_config)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
