            </column>
            <column caption='wvc_a_fixed' datatype='real' name='[Calculation_3439624230301245440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([wvc_a]) }' />
            </column>
            <column caption='wvc_b_fixed' datatype='real' name='[Calculation_3439624230301425665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([wvc_b]) }' />
