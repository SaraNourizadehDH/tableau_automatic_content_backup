          <object caption='regional_ssc_commercial_deal_page_2' id='regional_ssc_commercial_deal_page_2_9C25C56AF9CB403EA0F683E93D633AB6'>
            <properties context=''>
              <relation connection='bigquery.01svpii06x9ejv1d1wjdk1dhq8gc' name='regional_ssc_commercial_deal_page_2' table='[fulfillment-dwh-production.pandata_report].[regional_ssc_commercial_deal_page_2]' type='table' />
