    <worksheet name='Pro Non Pro Dstr'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='14'>Deal Distribution to Pro Subscription</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_ssc_commercial_deal_page_3 (pandata_report)' name='federated.1qesum70ucvnic1exq3qb1h59pxx' />
          </datasources>
          <datasource-dependencies datasource='federated.1qesum70ucvnic1exq3qb1h59pxx'>
            <column caption='Agent Department Name' datatype='string' name='[Calculation_1708834587885223939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([agent_department_name] = &quot;NULL&quot;&#10; &#9;&#9;&#9;&#9;&#9;OR &#10;&#9;[agent_department_name] = &quot;Non-Central&quot;&#10;&#9;&#9;&#9;&#9;&#9;OR&#10;    [agent_department_name] = NULL&#10;) &#10;THEN &quot;Non-Central&quot;&#10;ELSE [agent_department_name]&#10;END' />
            </column>
            <column caption='Zero axis' datatype='integer' name='[Calculation_99008877283020822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Percentage Bins' datatype='string' name='[Calculation_99008877292548119]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [discount_type] = &apos;percentage&apos; THEN&#10;(IF [Calculation_99008877292953624] &gt;=10 and [Calculation_99008877292953624] &lt; 15 then &apos;10%&apos; &#10;ELSEIF [Calculation_99008877292953624] &gt;=15 and [Calculation_99008877292953624] &lt; 20 then &apos;15%&apos; &#10;ELSEIF [Calculation_99008877292953624] &gt;=20 and [Calculation_99008877292953624] &lt; 25 then &apos;20%&apos; &#10;ELSEIF [Calculation_99008877292953624] &gt;=25 and [Calculation_99008877292953624] &lt; 30 then &apos;25%&apos; &#10;ELSEIF [Calculation_99008877292953624] &gt;=30 and [Calculation_99008877292953624] &lt;= 100  then &apos;30%&apos;&#10;ELSEIF [Calculation_99008877292953624] &gt;=0 and [Calculation_99008877292953624] &lt;10  then &apos;&lt;10%&apos;&#10;END)&#10;ELSE [discount_type] &#10;END' />
            </column>
            <column caption='Discount Percent - Split 1' datatype='real' name='[Calculation_99008877292953624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 - ([foodpanda_ratio])' />
            </column>
            <column caption='PandaPro Subscription' datatype='string' name='[PandaPro_Subscription]' role='dimension' type='nominal' />
            <column caption='Agent_Department Name' datatype='string' name='[agent_department_name]' role='dimension' type='nominal' />
            <column caption='Discount Type' datatype='string' name='[discount_type]' role='dimension' type='nominal' />
            <column caption='Foodpanda Ratio' datatype='real' name='[foodpanda_ratio]' role='measure' type='quantitative' />
