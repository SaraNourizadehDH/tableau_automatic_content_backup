            <column caption='dt_wvc_a_fixed' datatype='real' name='[Calculation_4000111262867349504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([dt_wvc_a_delivery]) }' />
            </column>
            <column caption='p rate denominator' datatype='real' name='[Calculation_456059895222726681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_99008876985720834])' />
            </column>
            <column caption='Central Deal Value / Allocated GFV' datatype='real' name='[Calculation_456059895227781150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[MTD Deal Value - Central] / SUM([wvc_b_fixed])&#10;SUM([Calculation_831125259488071680]) / SUM([Calculation_831125259488296961])' />
            </column>
            <column caption='WVC % - Central' datatype='real' name='[Calculation_4989636557981159424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3439624230301245440]) / SUM([Calculation_3439624230301425665])' />
            </column>
            <column caption='vendor_deal_all_product_value_eur_fixed' datatype='real' name='[Calculation_831125259488071680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([vendor_deal_all_product_value_eur]) }' />
            </column>
            <column caption='gfv_eur_2_fixed' datatype='real' name='[Calculation_831125259488296961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [class], [anchor_date], [country]: AVG([gfv_eur_2]) }' />
            </column>
            <column caption='wvc_pro_target_fix' datatype='real' name='[Calculation_97671843558563845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [anchor_date]), [country]: AVG([wvc_pro_target]) }' />
            </column>
            <column caption='pro_wvc_a_fix' datatype='real' name='[Calculation_97671843559215110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [anchor_date], [country]: AVG([pro_wvc_a]) }' />
            </column>
            <column caption='pro_wvc_b_fix' datatype='real' name='[Calculation_97671843559313415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [anchor_date], [country]: AVG([pro_wvc_b]) }' />
            </column>
            <column caption='Pro % WVC MTD Live' datatype='real' name='[Calculation_97671843559776265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_97671843559215110]) / SUM([Calculation_97671843559313415])' />
            </column>
            <column caption='wvc_target_fixed' datatype='real' name='[Calculation_97671843560615947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [anchor_date]), [country]: AVG([wvc_target]) }' />
            </column>
            <column caption='deal_value_over_allocated_gfv_target_fixed' datatype='real' name='[Calculation_97671843561644044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;, [anchor_date]), [country]: AVG([deal_value_over_allocated_gfv_target]) }' />
            </column>
            <column caption='Trend' datatype='string' name='[Calculation_99008876707127296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class] = &quot;Daily&quot; THEN STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-&quot; + STR(DATEPART(&apos;month&apos;,[anchor_date])) + &quot;-&quot; + STR(DATEPART(&apos;day&apos;,[anchor_date]))&#10;ELSEIF [class] = &quot;Weekly&quot; THEN (&#10;IF ISOWEEK([anchor_date]) &lt; 10 &#10;   THEN STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-W0&quot; + STR(DATEPART(&apos;iso-week&apos;,[anchor_date]))&#10;   ELSE STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-W&quot; + STR(DATEPART(&apos;iso-week&apos;,[anchor_date])) END) &#10;ELSEIF [class] = &quot;Monthly&quot; THEN&#10;(IF MONTH([anchor_date]) &lt; 10 THEN&#10; STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-0&quot; + STR(DATEPART(&apos;month&apos;,[anchor_date])) &#10; ELSE STR(DATEPART(&apos;year&apos;,[anchor_date])) + &quot;-&quot; + STR(DATEPART(&apos;month&apos;,[anchor_date])) &#10; END)&#10;END' />
            </column>
            <column caption='central allocated vendors' datatype='real' name='[Calculation_99008876985720834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country], [anchor_date] : AVG([central_vendors])}' />
            </column>
