      <aliases enabled='yes' />
      <column caption='% floating panda penetration mau' datatype='real' name='[% floating panda penetration (copy)_2638476072403161089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_fab_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
      </column>
      <column caption='% homescreen penetration mau' datatype='real' name='[% floating panda penetration mau (copy)_6337409134685782017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_homescreen_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
      </column>
      <column caption='% mau with sufficient users of mau' datatype='real' name='[% mau with sufficient users of exposed mau (copy)_2768939721115828240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_users_enough_point_and_mau])/sum([total_active_users])' />
      </column>
      <column caption='% of intentional completers of mau' datatype='real' name='[% of intentional completers of exposed mau (copy)_2768939721113911308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_intentional_challenge_completers])/sum([total_active_users])' />
      </column>
      <column caption='% of intentional participant of mau' datatype='real' name='[% of intentional participant of exposed mau (copy)_2768939721114066957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_intentional_challenge_participants])/sum([total_active_users])' />
      </column>
      <column caption='% of intentional participant of exposed mau (copy)' datatype='real' name='[% of intentional participant of exposed mau (copy)_4172303617231163393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_intentional_challenge_participants])/sum([total_users_exposed_and_mau])' />
      </column>
      <column caption='% of platform gmv (int part)' datatype='real' name='[% of platform gmv (copy)_3123105640706818050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_intentional_challenge_gmv_eur])/SUM([total_gmv_eur])' />
      </column>
      <column caption='% of platform wallet spend (int part)' datatype='real' name='[% of platform wallet spend (copy)_3123105640706830339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_intentional_wallet_spend_eur])/sum([total_wallet_spend_eur])' />
      </column>
      <column caption='% otp penetration mau' datatype='real' name='[% otp penetration (copy)_2638476072403177474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_otp_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
      </column>
      <column caption='% redeemers of mau' datatype='real' name='[% redeemers of exposed mau (copy)_2768939721114357774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_users_redemeed])/sum([total_active_users])' />
      </column>
      <column caption='% sidebar penetration mau' datatype='real' name='[% sidebar penetration (copy)_2638476072403185667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_sidebar_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
      </column>
      <column caption='% total participants of mau' datatype='real' name='[% total participants of exposed mau (copy)_2768939721115250703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_participants])/sum([total_active_users])' />
      </column>
