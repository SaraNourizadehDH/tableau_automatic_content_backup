                <zone forceUpdate='true' h='5896' id='2957' type-v2='text' w='26143' x='15095' y='47919'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Intentional </run>
                    <run fontcolor='#333333' fontsize='8'>=</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Æ </run>
                    <run fontcolor='#333333' fontsize='8'>AC from Oct onwards, old definition before Oct</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Existing</run>
                    <run fontcolor='#333333' fontsize='8'> = Int. completer previous month and this month (eg. for Nov month = Oct and Nov)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Reactivated </run>
                    <run fontcolor='#333333' fontsize='8'>= Int. completer before previous month and this month (eg. for Nov month = Apr and Nov)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>New</run>
                    <run fontcolor='#333333' fontsize='8'> = First time in lifetime int. completer this month (eg. for Nov month = first time in Nov)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
