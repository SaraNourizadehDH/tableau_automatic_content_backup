      <column caption='User Aware New' datatype='integer' hidden='true' name='[Calculation_6262536774093619207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[user_shown_challenge_list]-[user_aware_existing]' />
      </column>
      <column caption='Intentional participation rate (%)' datatype='real' hidden='true' name='[Calculation_638174180317868033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(intentional_challenge_participant)/sum([user_exposed_and_active])' />
      </column>
      <column caption='Challenges awareness (%)' datatype='real' hidden='true' name='[Calculation_82964749674188801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([user_shown_challenge_list])/sum([user_exposed])' />
      </column>
      <column caption='# of Unintentional Challenge Completer' datatype='integer' hidden='true' name='[Calculation_82964749675810818]' role='measure' type='quantitative'>
