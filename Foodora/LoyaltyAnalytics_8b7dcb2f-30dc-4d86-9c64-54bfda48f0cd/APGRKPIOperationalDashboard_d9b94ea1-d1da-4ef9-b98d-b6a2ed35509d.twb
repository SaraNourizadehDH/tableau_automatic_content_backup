        <zone forceUpdate='true' h='2821' id='983' type-v2='text' w='76667' x='1083' y='52000'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='8' underline='true'>Defintion of G&amp;R Int. Part. iCPGMV</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#b70454' fontsize='8'>G&amp;R iCPGMV</run>
            <run fontcolor='#000000' fontsize='8'> = (points issued * avg points redemption rate based on last quarter * value per redeemed point) + direct voucher value/ total intentional challenge orders gmv</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='8'>Fp Mktg iCPGMV</run>
            <run fontcolor='#000000' fontsize='8'> = total platform marketing incentive cost / total platform gmv</run>
          </formatted-text>
