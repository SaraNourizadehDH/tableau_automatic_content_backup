      <column caption='Completion Rate' datatype='real' name='[Calculation_1859353352429764609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_completer])/sum([total_participant])' />
      </column>
      <column caption='Engagement Rate' datatype='real' hidden='true' name='[Calculation_1859353352430096387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([intentional_challenge_participant])/sum([user_aware_challenge])' />
      </column>
      <column caption='Wallet Spent EUR per Point' datatype='real' name='[Calculation_1859353352431022084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_gmv_eur])/sum([total_point_earned])' />
      </column>
