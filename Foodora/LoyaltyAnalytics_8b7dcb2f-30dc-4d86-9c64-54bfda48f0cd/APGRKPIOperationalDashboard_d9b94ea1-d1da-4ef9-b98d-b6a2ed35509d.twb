      <column caption='If month = Oct' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2158561260976197632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH(STR([month_start]),&quot;2022-10-01&quot;) THEN &quot;Colour&quot; END' />
      </column>
      <column caption='oct 2022' datatype='boolean' name='[Calculation_2158561260996018181]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='year([date_month]) = 2022 AND&#10;month([date_month]) = 10' />
      </column>
      <column caption='G&amp;R Int. Part. iCPGMV' datatype='real' name='[Calculation_2337157116748591109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ABS([points_cost_eur])+ ABS([used_direct_voucher_value_eur]))/SUM([total_intentional_challenge_gmv_eur])' />
      </column>
      <column caption='lq redemption rate (reporting)' datatype='real' name='[Calculation_2396196522835369984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [global_entity_id] WHEN IN (&quot;FP_HK&quot;, &quot;FP_LA&quot;)&#10;THEN 0.48&#10;ELSE [redemption_rate] END' />
      </column>
      <column caption='% starters out of page viewers' datatype='real' name='[Calculation_2520115871762436096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_starter_mau])/SUM([total_users_challenge_aware_and_mau])' />
