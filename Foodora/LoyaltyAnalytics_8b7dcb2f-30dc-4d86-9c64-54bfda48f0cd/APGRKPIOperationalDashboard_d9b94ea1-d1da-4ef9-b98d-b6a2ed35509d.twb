          <datasource-dependencies datasource='federated.1kqe9v71lxz5uc122knye1fyyldc'>
            <column caption='% of intentional completers of mau' datatype='real' name='[% of intentional completers of exposed mau (copy)_2768939721113911308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_intentional_challenge_completers])/sum([total_active_users])' />
            </column>
            <column caption='% of intentional participant of exposed mau (copy)' datatype='real' name='[% of intentional participant of exposed mau (copy)_4172303617231163393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_intentional_challenge_participants])/sum([total_users_exposed_and_mau])' />
            </column>
            <column caption='% total participants of mau' datatype='real' name='[% total participants of exposed mau (copy)_2768939721115250703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_participants])/sum([total_active_users])' />
            </column>
            <column caption='Empty Line' datatype='integer' name='[Calculation_1426726329712242692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='If month = Oct' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2158561260976197632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH(STR([month_start]),&quot;2022-10-01&quot;) THEN &quot;Colour&quot; END' />
            </column>
            <column caption='lq redemption rate (reporting)' datatype='real' name='[Calculation_2396196522835369984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [global_entity_id] WHEN IN (&quot;FP_HK&quot;, &quot;FP_LA&quot;)&#10;THEN 0.48&#10;ELSE [redemption_rate] END' />
            </column>
            <column caption='point issued per completer' datatype='real' name='[Calculation_3685844455382425613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_points_earned])/sum([total_intentional_challenge_completers])' />
            </column>
            <column caption='current month measures' datatype='boolean' name='[Calculation_5866501469325221933]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year(today()) = year([date_month]) &#10;AND month(today()) = month([date_month])' />
              <aliases>
                <alias key='false' value='previous' />
                <alias key='true' value='current' />
