    <worksheet name='4.Challenge Part 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>Challenge Participation &amp; Completion</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_gnr_dash_kpi' name='federated.1kqe9v71lxz5uc122knye1fyyldc' />
          </datasources>
          <datasource-dependencies datasource='federated.1kqe9v71lxz5uc122knye1fyyldc'>
            <column caption='If month = Oct' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2158561260976197632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH(STR([month_start]),&quot;2022-10-01&quot;) THEN &quot;Colour&quot; END' />
            </column>
            <column caption='lq redemption rate (reporting)' datatype='real' name='[Calculation_2396196522835369984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [global_entity_id] WHEN IN (&quot;FP_HK&quot;, &quot;FP_LA&quot;)&#10;THEN 0.48&#10;ELSE [redemption_rate] END' />
            </column>
            <column caption='point issued per completer' datatype='real' name='[Calculation_3685844455382425613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_points_earned])/sum([total_intentional_challenge_completers])' />
            </column>
            <column caption='current month measures' datatype='boolean' name='[Calculation_5866501469325221933]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year(today()) = year([date_month]) &#10;AND month(today()) = month([date_month])' />
              <aliases>
                <alias key='false' value='previous' />
                <alias key='true' value='current' />
              </aliases>
            </column>
            <column caption='on' datatype='integer' name='[Calculation_6814649930865627137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='off' datatype='integer' name='[Calculation_6814649930865704962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='cost per redeemed point (eur)' datatype='real' name='[Calculation_83879599320330245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([total_used_voucher_value_eur])/sum([total_points_redeemed])' />
            </column>
            <column caption='Line Break 6' datatype='integer' name='[Line Break (copy)_1859212650280644608]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column-instance column='[Calculation_6814649930865627137]' derivation='Attribute' name='[attr:Calculation_6814649930865627137:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6814649930865704962]' derivation='Attribute' name='[attr:Calculation_6814649930865704962:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2396196522835369984]' derivation='Avg' name='[avg:Calculation_2396196522835369984:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2158561260976197632]' derivation='CountD' name='[ctd:Calculation_2158561260976197632:qk]' pivot='key' type='quantitative' />
            <column caption='Date Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='is_past_12_month' datatype='boolean' name='[is_past_6_month (copy)_2768939720866140160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If DATEDIFF(&apos;month&apos;,[date_month],TODAY()) &lt;= 12 then True else False end' />
            </column>
            <column-instance column='[Line Break (copy)_1859212650280644608]' derivation='Max' name='[max:Line Break (copy)_1859212650280644608:qk]' pivot='key' type='quantitative' />
            <column caption='Month Start' datatype='date' name='[month_start]' role='dimension' type='ordinal' />
            <column-instance column='[date_month]' derivation='MY' name='[my:date_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_5866501469325221933]' derivation='None' name='[none:Calculation_5866501469325221933:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_past_6_month (copy)_2768939720866140160]' derivation='None' name='[none:is_past_6_month (copy)_2768939720866140160:nk]' pivot='key' type='nominal' />
            <column caption='points issued per int part' datatype='integer' datatype-customized='true' default-format='N' name='[points issued per completer (copy 2)_3123105640711725060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(sum([total_points_earned])/sum([total_intentional_challenge_participants]))' />
