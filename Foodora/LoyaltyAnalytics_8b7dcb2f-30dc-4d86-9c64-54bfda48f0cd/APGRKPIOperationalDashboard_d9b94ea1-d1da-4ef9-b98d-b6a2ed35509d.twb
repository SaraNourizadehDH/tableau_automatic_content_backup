        <zone forceUpdate='true' h='2543' id='2072' type-v2='text' w='16364' x='59227' y='2343'>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontsize='7' underline='true'>Note: </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='7'>1.  Intentional definition has been updated to &apos;accept challenge&apos; from 1st Oct 2022 onwards.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='7'>(except BD and LA - 1st Nov 2022 onwards)</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='7'>2. Stamp card data has been integrated from 1st Jan 2023 onwards.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#dcd55f' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='3786' hidden-by-user='true' id='2269' type-v2='text' w='21100' x='76800' y='1357'>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontname='Tableau Medium' fontsize='8' underline='true'>Definition:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Int. participants</run>
            <run fontcolor='#333333' fontsize='8'>: MAU who clicked on &apos;accept challenge&apos; nbutton and made a related order in the current month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Int. completers</run>
            <run fontcolor='#333333' fontsize='8'>: Int. participants who have completed a challenge</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Redeemers: </run>
            <run fontcolor='#333333' fontsize='8'>Users who have redeemed a reward in the current month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Gamers</run>
            <run fontcolor='#333333' fontsize='8'>: Int. participants in the current month and have &gt;= 2 redemptions in his lifetime, with the latest redemption in L90D</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Page</run>
            <run fontcolor='#333333' fontsize='8'>Æ </run>
            <run bold='true' fontcolor='#333333' fontsize='8'>viewers</run>
            <run fontcolor='#333333' fontsize='8'>: MAU who have viewed the challenges page</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#d4d4d4' />
          </zone-style>
        </zone>
        <zone h='543' id='2270' type-v2='dashboard-object' w='1182' x='90500' y='4314'>
          <button action='' active-visual-state-index='1'>
            <toggle-action>tabdoc:toggle-button-click-action window-id=&quot;{2ED817A2-D595-404F-9437-56FA1DB18202}&quot; zone-id=&quot;2270&quot; zone-ids=[2269]</toggle-action>
            <button-visual-state>
              <image-path>Image/icons8-info-500 fade.png</image-path>
              <tooltip-text>click here to close</tooltip-text>
            </button-visual-state>
            <button-visual-state>
              <image-path>Image/icons8-info-500.png</image-path>
              <tooltip-text>click here for more definition</tooltip-text>
            </button-visual-state>
          </button>
        </zone>
