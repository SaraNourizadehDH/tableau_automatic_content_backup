      <aliases enabled='yes' />
      <column caption='Completion Rate' datatype='real' name='[Calculation_1859353352429764609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_completer])/sum([total_participant])' />
      </column>
      <column caption='Wallet Spent EUR per Point' datatype='real' name='[Calculation_1859353352431022084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_gmv_eur])/sum([total_point_earned])' />
      </column>
      <column caption='month' datatype='string' name='[Calculation_2039778809009975296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;, [date_month_local]), 3) + STR(DATEPART(&apos;year&apos;, [date_month_local]))' />
      </column>
      <column caption='start_date_month (local)' datatype='datetime' name='[Calculation_2743114436938563587]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [start_date_local])' />
      </column>
      <column caption='search for internal name' datatype='string' name='[Calculation_3631590185197326366]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[internal_name]' />
      </column>
      <column caption='vertical_type' datatype='string' name='[Calculation_5135299884987154432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_restaurant] = TRUE THEN &apos;restaurant&apos; &#10;ELSEIF [is_pickup] = TRUE THEN &apos;pickup&apos;&#10;ELSEIF [is_pandamart]= TRUE THEN &apos;pandamart&apos;&#10;ELSEIF [is_shop] = TRUE THEN &apos;shop&apos;&#10;ELSEIF [is_platform] = TRUE THEN &apos;platform&apos;&#10;ELSEIF [Calculation_5135299884989456386] = TRUE THEN &apos;pandamart and shop&apos;&#10;END' />
      </column>
      <column caption='is_pandamart_and_shop' datatype='boolean' name='[Calculation_5135299884989456386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_pandamart] = TRUE AND [is_shop] = TRUE THEN TRUE&#10;END' />
      </column>
      <column caption='row_num' datatype='integer' name='[Calculation_5922092808848932870]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
