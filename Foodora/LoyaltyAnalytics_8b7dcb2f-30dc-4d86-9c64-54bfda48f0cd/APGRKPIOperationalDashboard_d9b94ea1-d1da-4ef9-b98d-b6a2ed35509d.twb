    <worksheet name='Reward Redeemers (new/existing)'>
      <table>
        <view>
          <datasources>
            <datasource caption='new/existing redeemers' name='federated.1ycnwss0zs5yrs1e2b3y2176j92l' />
          </datasources>
          <datasource-dependencies datasource='federated.1ycnwss0zs5yrs1e2b3y2176j92l'>
            <column caption='is_past_12_month' datatype='boolean' name='[Calculation_3631590185029591047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If DATEDIFF(&apos;month&apos;,[date_month],TODAY()) &lt; 12 then True else False end' />
