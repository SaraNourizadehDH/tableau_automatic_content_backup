    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Challenge Performance backup'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b70054' fontsize='20'>Challenge Vertical Level Pre/Post </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#499894' fontsize='10'>pre period metrics = based on vertical participants active in pre period</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#499894' fontsize='10'>post = based on all vertical participants</run>
          </formatted-text>
        </title>
      </layout-options>
