  <worksheets>
    <worksheet name='3. Page Viewers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>Page Browsers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_gnr_dash_kpi' name='federated.1kqe9v71lxz5uc122knye1fyyldc' />
          </datasources>
          <datasource-dependencies datasource='federated.1kqe9v71lxz5uc122knye1fyyldc'>
            <column caption='% floating panda penetration mau' datatype='real' name='[% floating panda penetration (copy)_2638476072403161089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_fab_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
            </column>
            <column caption='% homescreen penetration mau' datatype='real' name='[% floating panda penetration mau (copy)_6337409134685782017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_homescreen_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
            </column>
            <column caption='% otp penetration mau' datatype='real' name='[% otp penetration (copy)_2638476072403177474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_otp_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
            </column>
            <column caption='% sidebar penetration mau' datatype='real' name='[% sidebar penetration (copy)_2638476072403185667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_sidebar_users_mau])/SUM([total_users_challenge_aware_and_mau])' />
            </column>
            <column caption='If month = Oct' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2158561260976197632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH(STR([month_start]),&quot;2022-10-01&quot;) THEN &quot;Colour&quot; END' />
            </column>
            <column caption='% starters out of page viewers' datatype='real' name='[Calculation_2520115871762436096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_starter_mau])/SUM([total_users_challenge_aware_and_mau])' />
            </column>
            <column caption='% challenge aware of mau' datatype='real' name='[Calculation_3685844455294640131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_users_challenge_aware_and_mau])/sum([total_active_users])' />
            </column>
            <column caption='week with date ranges' datatype='string' name='[Calculation_3685844455336943628]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(date(datetrunc(&apos;week&apos;, [date_month]))) + &quot; to &quot; + str(date(datetrunc(&apos;week&apos;, [date_month]) + 6 ))' />
            </column>
            <column caption='current month measures' datatype='boolean' name='[Calculation_5866501469325221933]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year(today()) = year([date_month]) &#10;AND month(today()) = month([date_month])' />
              <aliases>
                <alias key='false' value='previous' />
                <alias key='true' value='current' />
              </aliases>
            </column>
            <column caption='% starters out of mau' datatype='real' name='[Calculation_6470476417929887744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_starter_mau])/sum([total_active_users])' />
            </column>
            <column caption='% of exposed user' datatype='real' name='[Calculation_83879599317594112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_users_exposed_and_mau])/sum([total_active_users])' />
            </column>
            <column caption='Line Break 4' datatype='integer' name='[Line Break (copy)_221661604252860416]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Line Break 9' datatype='integer' name='[Line Break (copy)_5866501469277945856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Line Break 2' datatype='integer' name='[Line Break (copy)_83879599321194503]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Line Break 3' datatype='integer' name='[Line Break 2 (copy)_83879599321665544]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Line Break 10' datatype='integer' name='[Line Break 9 (copy)_119063919920394241]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column-instance column='[Calculation_2158561260976197632]' derivation='CountD' name='[ctd:Calculation_2158561260976197632:qk]' pivot='key' type='quantitative' />
            <column caption='Date Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='is_past_12_month' datatype='boolean' name='[is_past_6_month (copy)_2768939720866140160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If DATEDIFF(&apos;month&apos;,[date_month],TODAY()) &lt;= 12 then True else False end' />
