      <column caption='User Click Rate' datatype='real' hidden='true' name='[Calculation_1103663437075243014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(user_click_foodpanda_icon)/sum([user_shown_foodpanda_icon])' />
      </column>
      <column caption='Safe to use till (UTC)' datatype='date' hidden='true' name='[Calculation_2431451220599287812]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([safe_date])' />
      </column>
      <column caption='       New intentional participants (abs)' datatype='integer' hidden='true' name='[Calculation_2431451220658257926]' role='measure' type='quantitative'>
