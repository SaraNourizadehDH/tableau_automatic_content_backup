    <worksheet name='5. Rewards Funnel View (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b80d54' fontsize='18'>Rewards Redemption</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_gnr_dash_kpi' name='federated.1kqe9v71lxz5uc122knye1fyyldc' />
          </datasources>
          <datasource-dependencies datasource='federated.1kqe9v71lxz5uc122knye1fyyldc'>
            <column caption='total points redeemed (abs)' datatype='integer' name='[Calculation_1453888690886463488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[total_points_redeemed]' />
            </column>
            <column caption='total points burnt (ab)' datatype='integer' name='[Calculation_1809813737303478273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[total_points_burnt_incl_expiry]' />
            </column>
            <column caption='oct 2022' datatype='boolean' name='[Calculation_2158561260996018181]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year([date_month]) = 2022 AND&#10;month([date_month]) = 10' />
            </column>
            <column caption='avg redemption value per redeemer' datatype='real' name='[Calculation_2768939720871948295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_used_voucher_value_eur])/SUM([total_redemptions])' />
            </column>
            <column caption='avg redemptions per redeemer' datatype='real' name='[Calculation_2768939720873730056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_redemptions])/SUM([total_users_redemeed])' />
            </column>
            <column caption='point redeemed per redeemer' datatype='real' name='[Calculation_3685844455382425613 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-sum([total_points_redeemed])/SUM([total_users_redemeed])' />
            </column>
            <column caption='point issued per completer' datatype='real' name='[Calculation_3685844455382425613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_points_earned])/sum([total_intentional_challenge_completers])' />
            </column>
            <column caption='point redemption rate' datatype='real' default-format='p0.0%' name='[Calculation_3685844455385722894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([total_points_redeemed])/SUM([total_points_earned])' />
            </column>
            <column caption='voucher_usage_rate' datatype='real' name='[Calculation_4410220347722702849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_used_voucher])/SUM([total_issued_voucher])' />
            </column>
            <column caption='Line Break' datatype='integer' name='[Calculation_4766778734759989249]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='current month measures' datatype='boolean' name='[Calculation_5866501469325221933]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year(today()) = year([date_month]) &#10;AND month(today()) = month([date_month])' />
              <aliases>
                <alias key='false' value='previous' />
                <alias key='true' value='current' />
              </aliases>
            </column>
            <column caption='on' datatype='integer' name='[Calculation_6814649930865627137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='off' datatype='integer' name='[Calculation_6814649930865704962]' role='measure' type='quantitative'>
