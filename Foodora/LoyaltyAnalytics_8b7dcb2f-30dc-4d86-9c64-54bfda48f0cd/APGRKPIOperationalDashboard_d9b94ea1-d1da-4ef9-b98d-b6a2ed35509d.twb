            <run fontcolor='#333333' fontsize='8'> = Int. completer previous month and this month (eg. for Nov month = Oct and Nov)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Reactivated </run>
            <run fontcolor='#333333' fontsize='8'>= Int. completer before previous month and this month (eg. for Nov month = Apr and Nov)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>New</run>
