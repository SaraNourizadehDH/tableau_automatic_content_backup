      <column caption='COUNT of missing date' datatype='real' hidden='true' name='[Calculation_1092193340584587266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Wave Definition Selector' datatype='date' hidden='true' name='[Calculation_1103663436803596288]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;wave_string&apos; then [start]&#10;else [start] end' />
      </column>
      <column caption='Completion Rate' datatype='real' hidden='true' name='[Calculation_1103663437073379330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_completer])/sum([total_challenge_particpater])' />
      </column>
      <column caption='Participation Rate vs Exposed Active Users' datatype='real' hidden='true' name='[Calculation_1103663437073522691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_particpater])/sum([user_shown_foodpanda_icon_and_active])' />
      </column>
      <column caption='Participation Rate vs Acitive User' datatype='real' hidden='true' name='[Calculation_1103663437074096132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_particpater])/sum([fp_active_user])' />
