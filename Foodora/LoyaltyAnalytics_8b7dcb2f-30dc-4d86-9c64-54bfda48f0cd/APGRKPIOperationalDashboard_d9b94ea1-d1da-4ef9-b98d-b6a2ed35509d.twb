        <zone forceUpdate='true' h='5372' id='2406' type-v2='text' w='22857' x='61071' y='3883'>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontsize='7' underline='true'>Note: </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='7'>1.  Intentional definition has been updated to &apos;accept challenge&apos; from 1st Oct 2022 onwards.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='7'>(except BD and LA - 1st Nov 2022 onwards)</run>
