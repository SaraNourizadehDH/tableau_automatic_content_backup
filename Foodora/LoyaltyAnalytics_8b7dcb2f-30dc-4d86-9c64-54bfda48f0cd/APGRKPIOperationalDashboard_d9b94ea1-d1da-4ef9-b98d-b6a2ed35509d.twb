        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1nhdrt01phg52r1a0e8db1sxpa8v' name='Custom SQL Query' type='text'>SELECT
    global_entity_id,
    date_month,
    &quot;new&quot; AS type,
    SUM(total_new_intentional_challenge_participants) AS total_intentional_challenge_participants,
    SUM(total_new_intentional_challenge_completers) AS total_intentional_challenge_completers
