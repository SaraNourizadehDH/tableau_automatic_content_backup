            <run bold='true' fontcolor='#333333' fontsize='8'>Intentional </run>
            <run fontcolor='#333333' fontsize='8'>=</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Æ </run>
            <run fontcolor='#333333' fontsize='8'>&apos;accept challenge&apos; from Oct onwards, old definition before Oct</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Existing</run>
            <run fontcolor='#333333' fontsize='8'> = Int. participant previous month and this month (eg. for Nov month = Oct and Nov)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>Reactivated </run>
            <run fontcolor='#333333' fontsize='8'>= Int. participant before previous month and this month (eg. for Nov month = Apr and Nov)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='8'>New</run>
            <run fontcolor='#333333' fontsize='8'> = First time in lifetime int. participant this month (eg. for Nov month = first time in Nov)</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#d4d4d4' />
          </zone-style>
        </zone>
