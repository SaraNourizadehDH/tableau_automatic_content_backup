      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='monthly_propensity' id='_909FCCE40ECF4673A279F7EFB385CEAB'>
            <properties context=''>
              <relation connection='bigquery.0nsam0v1dzxku314hbsvk0f6b549 (copy 2)' name='Custom SQL Query' type='text'>WITH platform_metrics AS (
  SELECT
    global_entity_id,
    date_month,
    total_active_users,
    total_orders,
    total_gmv_eur,
    total_wallet_spend_eur,
    total_intentional_challenge_participants AS int_part_count,
    total_used_voucher_value_eur
  FROM `fulfillment-dwh-production.pandata_report.rw_kpi_monthly`
  WHERE date_month &gt;&gt;= &quot;2022-01-01&quot;

  UNION ALL

  SELECT
    &apos;APAC&apos; AS global_entity_id,
    date_month,
    SUM(total_active_users) AS total_active_users,
    SUM(total_orders) AS total_orders,
    SUM(total_gmv_eur) AS total_gmv_eur,
    SUM(total_wallet_spend_eur) AS total_wallet_spend_eur,
    SUM(total_intentional_challenge_participants) AS int_part_count,
    SUM(total_used_voucher_value_eur) AS total_used_voucher_value_eur 
  FROM `fulfillment-dwh-production.pandata_report.rw_kpi_monthly`
  WHERE date_month &gt;&gt;= &quot;2022-01-01&quot;
  GROUP BY 1,2
)

SELECT
  propensity.*,
  propensity.global_entity_id IN (&apos;FP_PH&apos;,
                                  &apos;FP_TH&apos;,
                                  &apos;FP_TW&apos;,
                                  &apos;FP_MY&apos;,
                                  &apos;FP_MM&apos;,
                                  &apos;FP_KH&apos;,
                                  &apos;FP_PK&apos;,
                                  &apos;FP_HK&apos;,
                                  &apos;FP_LA&apos;,
                                  &apos;FP_BD&apos;,
                                  &apos;FP_SG&apos;,
                                  &apos;APAC&apos;) AS is_APAC,
  fp.int_part_count,
  fp.total_active_users,
  fp.total_orders,
  fp.total_gmv_eur,
  fp.total_wallet_spend_eur,
  fp.total_used_voucher_value_eur AS total_used_voucher_value_eur_copy,
  DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH) = propensity.date_month AS is_last_month
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gnr_rw_kpi_monthly_with_propensity_overall` AS propensity
LEFT JOIN platform_metrics AS fp
       ON propensity.global_entity_id = fp.global_entity_id
      AND propensity.date_month = fp.date_month
WHERE propensity.global_entity_id IS NOT NULL
  AND propensity.date_month &gt;&gt;= &quot;2022-01-01&quot;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
