      </column>
      <column caption='Avg. cost per voucher' datatype='real' hidden='true' name='[Calculation_2631298496254181376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_usage_value_eur])/SUM([number_of_used_voucher])' />
      </column>
      <column caption='Avg point redeemed per Redemption' datatype='real' hidden='true' name='[Calculation_2631298496254427137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_burnt_points])/ SUM([total_redemption])' />
      </column>
      <column caption='issued value per point' datatype='real' hidden='true' name='[Calculation_3243506555510960130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_issued_voucher_value_eur])/sum(-[total_point_burnt])' />
      </column>
      <column caption='Rollout Rate' datatype='real' hidden='true' name='[Calculation_3243506555513798660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([user_exposed_and_active])/sum([fp_active_user])' />
      </column>
      <column caption='Order marketplace uplift (%)' datatype='real' hidden='true' name='[Calculation_3298534924831928320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([net_raw_uplift_per_treatment]*[intentional_challenge_participant])/sum([total_order])' />
      </column>
      <column caption='Total Order (Excluded Uplift)' datatype='real' hidden='true' name='[Calculation_3330834184276357124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(total_order) - [% Order Uplift Contribution (copy)_3298534924842790913]' />
      </column>
      <column caption='Non-Intentional Participant' datatype='integer' hidden='true' name='[Calculation_3330834184279769093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='total_challenge_particpater - intentional_challenge_participant' />
      </column>
      <column caption='avg daily aware user' datatype='real' hidden='true' name='[Calculation_3446379676993175553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([user_aware_challenge]),first()+7,first()+17)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='missing data' datatype='boolean' hidden='true' name='[Calculation_3446379676993507330]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([user_aware_challenge]) &lt; [Calculation_3446379676993175553]*0.5 THEN True ELSE False END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='daily to get avg' datatype='integer' hidden='true' name='[Calculation_3446379676996087811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([date] &gt;= now() - 18 AND [date] &lt; now() - 8 AND [user_aware_challenge] &gt; 0, 1, 0))' />
      </column>
      <column caption='is_last30D' datatype='boolean' hidden='true' name='[Calculation_3446379676998094852]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF date &gt; NOW()-30 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='last update' datatype='integer' hidden='true' name='[Calculation_4211287921984462852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [max_date_redemption],TODAY())' />
      </column>
      <column caption='wave_string' datatype='string' hidden='true' name='[Calculation_4410220347722018816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(wave)' />
      </column>
      <column caption='voucher_usage_rate' datatype='real' hidden='true' name='[Calculation_4410220347722702849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_used_voucher]/[total_issued_voucher]' />
      </column>
      <column caption='completion rate' datatype='real' hidden='true' name='[Calculation_4410220347819126794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_challenge_completer])/SUM([total_challenge_particpater])' />
      </column>
      <column caption='% of traffic are active users' datatype='real' hidden='true' name='[Calculation_4479674262090956805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(user_shown_challenge_list_and_active)/sum(user_shown_challenge_list)' />
      </column>
      <column caption='Wallet Spent per Point' datatype='real' hidden='true' name='[Calculation_4479674267048349729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(total_loyalty_nett_gfv_eur_completed)/sum([total_point_earned])' />
      </column>
      <column caption='Coverage Rate' datatype='real' hidden='true' name='[Calculation_4479674267053662242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_completer])/sum([user_exposed_and_active])' />
      </column>
      <column caption='Engagement Rate' datatype='real' hidden='true' name='[Calculation_4766778734939922435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_challenge_completer_intended])/sum([user_shown_challenge_list])' />
      </column>
      <column caption='user exposed new' datatype='integer' hidden='true' name='[Calculation_6262536774088777734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[user_exposed] - [user_exposed_existing]' />
