      </column>
      <column caption='If month = Oct' datatype='string' default-role='measure' default-type='quantitative' hidden='true' name='[Calculation_2158561260976197632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH(STR([month_start]),&quot;2022-10-01&quot;) THEN &quot;Colour&quot; END' />
      </column>
      <column caption='oct 2022' datatype='boolean' hidden='true' name='[Calculation_2158561260996018181]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='year([date_month 1]) = 2022 AND&#10;month([date_month 1]) = 10' />
      </column>
      <column caption='% AC clickers out of page viewers' datatype='real' hidden='true' name='[Calculation_2520115871762436096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_AC_clickers])/SUM([total_users_challenge_aware_and_mau])' />
      </column>
      <column caption='avg redemption value per redeemer' datatype='real' hidden='true' name='[Calculation_2768939720871948295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_used_voucher_value_eur 1])/SUM([total_redemptions])' />
      </column>
      <column caption='avg redemptions per redeemer' datatype='real' hidden='true' name='[Calculation_2768939720873730056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_redemptions])/SUM([total_users_redemeed])' />
      </column>
      <column caption='is_past_12_month' datatype='boolean' name='[Calculation_2768939720880672778]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If DATEDIFF(&apos;month&apos;,[date_month],TODAY()) &lt; 12+1 then True else False end' />
      </column>
      <column caption='rolling L30D gamer wallet spend' datatype='real' hidden='true' name='[Calculation_2768939721088733195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (datediff(&apos;week&apos;, [month], today())) &lt;=4 THEN [gamer_wallet_spend_per_user] else null end' />
      </column>
      <column caption='% of gamers with food and 1 other vertical ' datatype='real' hidden='true' name='[Calculation_2768939721121107985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gamer_count_with_food_and_1_other_vertical_bucket])/SUM([gamer_count])' />
      </column>
      <column caption='current month measures' datatype='boolean' name='[Calculation_2768939721128894482]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='year(today()) = year([date_month]) &#10;AND month(today()) = month([date_month])' />
        <aliases>
          <alias key='false' value='previous' />
          <alias key='true' value='current' />
        </aliases>
      </column>
      <column caption='uplift_gamer_control_orders_per_user' datatype='real' hidden='true' name='[Calculation_312015016177946624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gamer_orders_per_user])/SUM([gamer_control_orders_per_user])-1' />
