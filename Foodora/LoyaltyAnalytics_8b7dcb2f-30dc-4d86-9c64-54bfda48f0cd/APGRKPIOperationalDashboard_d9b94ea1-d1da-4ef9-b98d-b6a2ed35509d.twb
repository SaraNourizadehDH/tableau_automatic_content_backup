    <worksheet name='Monthly - Summary (All markets)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>Monthly - Key Funnel Metrics - All Markets</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_gnr_dash_kpi' name='federated.1kqe9v71lxz5uc122knye1fyyldc' />
          </datasources>
          <datasource-dependencies datasource='federated.1kqe9v71lxz5uc122knye1fyyldc'>
            <column caption='% of intentional participant of mau' datatype='real' name='[% of intentional participant of exposed mau (copy)_2768939721114066957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_intentional_challenge_participants])/sum([total_active_users])' />
            </column>
            <column caption='% of platform gmv (int part)' datatype='real' name='[% of platform gmv (copy)_3123105640706818050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_intentional_challenge_gmv_eur])/SUM([total_gmv_eur])' />
            </column>
            <column caption='% of platform wallet spend (int part)' datatype='real' name='[% of platform wallet spend (copy)_3123105640706830339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_intentional_wallet_spend_eur])/sum([total_wallet_spend_eur])' />
            </column>
            <column caption='% redeemers of mau' datatype='real' name='[% redeemers of exposed mau (copy)_2768939721114357774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_users_redemeed])/sum([total_active_users])' />
            </column>
            <column caption='% gamers of mau' datatype='real' hidden='true' name='[Calculation_3685844455293919232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gamer_count])/SUM([total_active_users 1])' />
            </column>
            <column caption='% challenge aware of mau' datatype='real' name='[Calculation_3685844455294640131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_users_challenge_aware_and_mau])/sum([total_active_users])' />
            </column>
            <column caption='wallet spent per gamer (eur)' datatype='real' hidden='true' name='[Calculation_3685844455295672325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gamer_wallet_spend_eur])/sum([gamer_count])' />
            </column>
            <column caption='% of platform wallet spend' datatype='real' hidden='true' name='[Calculation_3685844455296745479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gamer_wallet_spend_eur])/sum([total_wallet_spend_eur])' />
            </column>
            <column caption='gmv per gamer (eur)' datatype='real' hidden='true' name='[Calculation_3685844455297605640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gamer_gmv_eur])/SUM([gamer_count])' />
            </column>
            <column caption='% of platform gmv' datatype='real' hidden='true' name='[Calculation_3685844455297966090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gamer_gmv_eur])/SUM([total_gmv_eur])' />
            </column>
            <column caption='current month measures' datatype='boolean' name='[Calculation_5866501469325221933]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year(today()) = year([date_month]) &#10;AND month(today()) = month([date_month])' />
              <aliases>
                <alias key='false' value='previous' />
                <alias key='true' value='current' />
              </aliases>
            </column>
            <column caption='on' datatype='integer' name='[Calculation_6814649930865627137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='off' datatype='integer' name='[Calculation_6814649930865704962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='% of exposed user' datatype='real' name='[Calculation_83879599317594112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_users_exposed_and_mau])/sum([total_active_users])' />
