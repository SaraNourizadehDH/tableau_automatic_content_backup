      <column caption='pct exposed &amp; mau' datatype='real' hidden='true' name='[Calculation_1793769699762761728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([exposed_and_active_users])/SUM([total_active_users])' />
