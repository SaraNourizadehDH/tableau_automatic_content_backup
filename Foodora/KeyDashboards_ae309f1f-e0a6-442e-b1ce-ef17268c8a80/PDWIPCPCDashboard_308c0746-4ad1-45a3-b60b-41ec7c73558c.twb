      </column>
      <column caption='LMTD CPC Revenue' datatype='real' name='[Budget LMTD € (copy)_371828464614113286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF  DATETRUNC(&quot;month&quot;, [campaign_date_local]) = DATEADD(&quot;month&quot;, -1, DATETRUNC(&quot;month&quot;, [Calculation_371828464611033090]))&#13;&#10;    AND DAY([campaign_date_local]) &lt;= DAY([Calculation_371828464611033090])&#13;&#10;    THEN &#13;&#10;        (IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_clicks_revenue_eur] ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_clicks_revenue_local]&#13;&#10;        END)&#13;&#10;    END)' />
      </column>
      <column caption='Est. CPC vs. LM %' datatype='real' default-format='p0.00%' name='[Budget MTD vs. LMTD % (copy)_371828464615137289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_371828464614473736]/[CPC Revenue LMTD € (copy)_371828464614285319]-1' />
      </column>
      <column caption='LM CPC Revenue' datatype='real' name='[CPC Revenue LMTD € (copy)_371828464614285319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE DATETRUNC(&apos;month&apos;, [report_date]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))&#10;&#10;WHEN TRUE THEN [Calculation_371828464642830348] END' />
      </column>
      <column caption='vendor with budget less 5% gfv' datatype='string' name='[Calculation_1132936813720723466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_3194459537811718145]/[Calculation_5276107732784939020]) &lt; 0.05 THEN [vendor_code] END' />
      </column>
      <column caption='% vendors with budget less 5% gfv ' datatype='real' default-format='p0%' name='[Calculation_1132936813721104395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1132936813720723466]) / COUNTD([vendor_code])' />
      </column>
      <column caption='City Zone Coverage' datatype='real' name='[Calculation_1132936814924541971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Avg Click Price&quot; THEN [Calculation_1132936814925090837]&#10;WHEN &quot;CPC Vendor Coverage %&quot; THEN [Calculation_1132936814925410326]&#10;WHEN &quot;CPC Vendors #&quot; THEN SUM([cpc_vendors_count])&#10;WHEN &quot;Total Billed Clicks #&quot; THEN SUM([total_billed_clicks_count])&#10;WHEN &quot;Total CPC Revenue&quot; THEN SUM([Calculation_371828464642830348])&#10;END' />
      </column>
      <column caption='Avg Click Price' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1132936814925090837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_371828464642830348])/SUM([total_billed_clicks_count])' />
      </column>
      <column caption='CPC Vendor Coverage' datatype='real' default-format='*0.0%' name='[Calculation_1132936814925410326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_vendors_count])/SUM([active_vendors_count])' />
      </column>
      <column caption='is_weekend' datatype='string' name='[Calculation_3194459537809403904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;Daily&apos; THEN &#10;    IF DATENAME(&apos;weekday&apos;, [report_date]) IN (&apos;Saturday&apos;, &apos;Sunday&apos;) THEN &apos;weekend&apos; ELSE &apos;weekday&apos; END&#10;ELSEIF [granularity]  IN (&apos;Weekly&apos;) THEN &apos;week&apos;&#10;ELSEIF [granularity]  IN (&apos;Monthly&apos;) THEN &apos;month&apos;&#10;END' />
      </column>
      <column caption='Campaign Budget' datatype='real' name='[Calculation_3194459537811718145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [campaign_budget_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [campaign_budget_local]&#13;&#10;END' />
      </column>
      <column caption='last_refreshed_date' datatype='datetime' name='[Calculation_3194459537821368324]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='NOW()' />
      </column>
      <column caption='Final Budget MTD' datatype='real' name='[Calculation_371828464610127872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;&#10;WHEN TRUE THEN [Calculation_3194459537811718145] END' />
      </column>
      <column caption='Data Date' datatype='date' name='[Calculation_371828464611033090]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([report_date])}' />
      </column>
      <column caption='Budget MTD vs. LMTD %' datatype='real' default-format='p0.00%' name='[Calculation_371828464612081667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_371828464610127872])/SUM([Campaign Budget MTD Eur (copy)_371828464610521089])-1' />
      </column>
      <column caption='Est. CPC Revenue' datatype='real' name='[Calculation_371828464614473736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Final Budget MTD € (copy)_371828464613748741] &#10;&#10;/ &#10;&#10;//Days passed&#10;DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), [Calculation_371828464611033090])&#10;&#10;*&#10;&#10;//Total days in month&#10;DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;,TODAY()), DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,TODAY())))' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_371828464616767498]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[campaign_date_local]' />
      </column>
      <column caption='CPC Revenue' datatype='real' name='[Calculation_371828464642830348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_clicks_revenue_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_clicks_revenue_local] &#13;&#10;END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_371828464643162125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Ad Credits Consumed Eur Parameter]&#10;WHEN &apos;Local&apos; THEN [total_gmv_local]&#10;ELSE [total_gmv_eur] &#10;END' />
      </column>
      <column caption='CPC Revenue / GMV %' datatype='real' default-format='p0.00%' name='[Calculation_371828464643293198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_371828464642830348])/SUM([Calculation_371828464643162125])' />
      </column>
      <column caption='Month' datatype='date' default-format='*mmmm-yy' name='[Calculation_371828464643661839]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&quot;month&quot;,[campaign_date_local]))' />
      </column>
      <column caption='Initial Booked Budget (incl Ad Credits)' datatype='real' name='[Calculation_3969078691508215808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [initial_campaign_budget_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [initial_campaign_budget_local] &#10;END' />
      </column>
      <column caption='Final Booked Budget (incl Ad Credits)' datatype='real' name='[Calculation_3969078691508482049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [initial_campaign_budget_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [initial_campaign_budget_local] END' />
      </column>
      <column caption='granularity cpc breakdown fiter' datatype='boolean' name='[Calculation_5276107732692488193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[granularity] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Date Selection Daily Breakdown' datatype='string' name='[Calculation_5276107732729380866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(CASE  [Parameters].[Parameter 2]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_5276107732729585667]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_5276107732729737220]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;END)' />
      </column>
      <column caption='Year Month' datatype='string' name='[Calculation_5276107732729585667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [report_date])) + &#10;RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [report_date])), 2)' />
      </column>
      <column caption='Year Week' datatype='string' name='[Calculation_5276107732729737220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([report_date])) + &apos;W&apos;+&#10;IF WEEK([report_date]) &lt; 10 THEN &apos;0&apos; + STR(WEEK([report_date]))&#10;ELSE STR(WEEK([report_date])) END' />
      </column>
      <column caption='Placeholder 1' datatype='integer' name='[Calculation_5276107732745076741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
