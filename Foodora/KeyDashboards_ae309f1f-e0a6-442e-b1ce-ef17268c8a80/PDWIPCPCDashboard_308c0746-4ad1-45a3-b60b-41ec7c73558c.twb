    <worksheet name='Total Budget'>
      <table>
        <view>
          <datasources>
            <datasource caption='campaign level data' name='federated.1fohas21lmmdxc11euiux1r05zdo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Ad Credits Consumed Eur Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
            <column caption='Granularity Total Budget' datatype='string' name='[Granularity Overall Performance (copy)_1132936813687033862]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fohas21lmmdxc11euiux1r05zdo'>
            <column caption='Campaign Budget' datatype='real' name='[Calculation_3194459537811718145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [campaign_budget_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [campaign_budget_local]&#13;&#10;END' />
            </column>
            <column caption='Year Month' datatype='string' name='[Calculation_5276107732729585667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [report_date])) + &#10;RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [report_date])), 2)' />
            </column>
            <column caption='Year Week' datatype='string' name='[Calculation_5276107732729737220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) + &apos;W&apos;+&#10;IF WEEK([report_date]) &lt; 10 THEN &apos;0&apos; + STR(WEEK([report_date]))&#10;ELSE STR(WEEK([report_date])) END' />
            </column>
            <column caption='Date Selection Total Budget' datatype='string' name='[Date Selection Daily Breakdown (copy)_1132936813686886405]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE  [Parameters].[Granularity Overall Performance (copy)_1132936813687033862]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_5276107732729585667]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_5276107732729737220]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;END)' />
            </column>
            <column caption='Account Owner' datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Foodora&quot;' value='EU' />
                <alias key='&quot;Foodpanda&quot;' value='APAC' />
                <alias key='&quot;Yemeksepeti&quot;' value='TR' />
              </aliases>
            </column>
            <column caption='Campaign Budget Eur' datatype='real' name='[campaign_budget_eur]' role='measure' type='quantitative' />
            <column caption='Campaign Budget Local' datatype='real' name='[campaign_budget_local]' role='measure' type='quantitative' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Chain Code' datatype='string' name='[chain_code]' role='dimension' type='nominal' />
