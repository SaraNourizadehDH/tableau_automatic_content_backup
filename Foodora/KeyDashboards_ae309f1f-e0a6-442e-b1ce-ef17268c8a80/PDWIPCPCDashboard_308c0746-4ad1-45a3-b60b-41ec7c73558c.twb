        <calculation class='tableau' formula='SUM([total_orders_count])' />
      </column>
      <column caption='CPC Revenue excl Ad Credits' datatype='real' name='[Calculation_6329105632980480008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_371828464642830348] - [Calculation_6329105632980783113]' />
      </column>
      <column caption='Ad Credits Consumed' datatype='real' name='[Calculation_6329105632980783113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [ad_credits_consumed_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [ad_credits_consumed_local]&#10;END' />
      </column>
