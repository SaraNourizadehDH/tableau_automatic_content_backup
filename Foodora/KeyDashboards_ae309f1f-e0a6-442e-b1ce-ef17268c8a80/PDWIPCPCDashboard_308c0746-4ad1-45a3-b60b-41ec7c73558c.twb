    <worksheet name='Daily Final Budget'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>&lt;</run>
            <run fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>[Parameters].[Parameter 1]</run>
            <run fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>&gt; - &lt;</run>
            <run fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>[Parameters].[Ad Credits Consumed Eur Parameter]</run>
            <run fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='campaign level data' name='federated.1fohas21lmmdxc11euiux1r05zdo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Ad Credits Consumed Eur Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
            <column caption='Final Budget / CPC Revenue / Total Clicks' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Clicks&quot;'>
              <calculation class='tableau' formula='&quot;Total Clicks&quot;' />
            </column>
            <column caption='Granularity CPC Daily Breakdown' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fohas21lmmdxc11euiux1r05zdo'>
            <column caption='is_weekend' datatype='string' name='[Calculation_3194459537809403904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;Daily&apos; THEN &#10;    IF DATENAME(&apos;weekday&apos;, [report_date]) IN (&apos;Saturday&apos;, &apos;Sunday&apos;) THEN &apos;weekend&apos; ELSE &apos;weekday&apos; END&#10;ELSEIF [granularity]  IN (&apos;Weekly&apos;) THEN &apos;week&apos;&#10;ELSEIF [granularity]  IN (&apos;Monthly&apos;) THEN &apos;month&apos;&#10;END' />
            </column>
            <column caption='Campaign Budget' datatype='real' name='[Calculation_3194459537811718145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [campaign_budget_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [campaign_budget_local]&#13;&#10;END' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_371828464642830348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_clicks_revenue_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_clicks_revenue_local] &#13;&#10;END' />
            </column>
            <column caption='granularity cpc breakdown fiter' datatype='boolean' name='[Calculation_5276107732692488193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Date Selection Daily Breakdown' datatype='string' name='[Calculation_5276107732729380866]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE  [Parameters].[Parameter 2]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_5276107732729585667]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_5276107732729737220]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;END)' />
            </column>
            <column caption='Year Month' datatype='string' name='[Calculation_5276107732729585667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [report_date])) + &#10;RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [report_date])), 2)' />
            </column>
            <column caption='Year Week' datatype='string' name='[Calculation_5276107732729737220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) + &apos;W&apos;+&#10;IF WEEK([report_date]) &lt; 10 THEN &apos;0&apos; + STR(WEEK([report_date]))&#10;ELSE STR(WEEK([report_date])) END' />
            </column>
            <column caption='CPC Budget / Revenue / Total Clicks' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_6329105632634843136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Final Budget&apos; THEN [Calculation_3194459537811718145]&#10;WHEN &apos;CPC Revenue&apos; THEN [Calculation_371828464642830348] &#10;WHEN &apos;Total Clicks&apos; THEN [total_billed_clicks_count] END' />
            </column>
            <column caption='Region' datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Foodora&quot;' value='EU' />
                <alias key='&quot;Foodpanda&quot;' value='APAC' />
                <alias key='&quot;Yemeksepeti&quot;' value='TR' />
              </aliases>
            </column>
            <column caption='Campaign Budget Eur' datatype='real' name='[campaign_budget_eur]' role='measure' type='quantitative' />
            <column caption='Campaign Budget Local' datatype='real' name='[campaign_budget_local]' role='measure' type='quantitative' />
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Booking Source' datatype='string' name='[created_by_actor]' role='dimension' type='nominal' />
            <column caption='GMV Class' datatype='string' name='[gmv_class]' role='dimension' type='nominal' />
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column caption='Lg Zone Name' datatype='string' name='[lg_zone_name]' role='dimension' type='nominal' />
