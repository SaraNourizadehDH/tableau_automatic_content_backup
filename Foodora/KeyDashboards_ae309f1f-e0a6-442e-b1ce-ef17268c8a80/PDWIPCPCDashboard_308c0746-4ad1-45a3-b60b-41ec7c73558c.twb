            </column>
            <column caption='Granularity City Vendor Penetration' datatype='string' name='[Granularity CPC Daily Breakdown (copy)_1132936814923460626]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Measure Selection' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total CPC Revenue&quot;'>
              <calculation class='tableau' formula='&quot;Total CPC Revenue&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fohas21lmmdxc11euiux1r05zdo'>
            <column caption='City Zone Coverage' datatype='real' name='[Calculation_1132936814924541971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Avg Click Price&quot; THEN [Calculation_1132936814925090837]&#10;WHEN &quot;CPC Vendor Coverage %&quot; THEN [Calculation_1132936814925410326]&#10;WHEN &quot;CPC Vendors #&quot; THEN SUM([cpc_vendors_count])&#10;WHEN &quot;Total Billed Clicks #&quot; THEN SUM([total_billed_clicks_count])&#10;WHEN &quot;Total CPC Revenue&quot; THEN SUM([Calculation_371828464642830348])&#10;END' />
            </column>
            <column caption='Avg Click Price' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1132936814925090837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_371828464642830348])/SUM([total_billed_clicks_count])' />
            </column>
            <column caption='CPC Vendor Coverage' datatype='real' default-format='*0.0%' name='[Calculation_1132936814925410326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_vendors_count])/SUM([active_vendors_count])' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_371828464642830348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_clicks_revenue_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_clicks_revenue_local] &#13;&#10;END' />
            </column>
            <column caption='Year Month' datatype='string' name='[Calculation_5276107732729585667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [report_date])) + &#10;RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [report_date])), 2)' />
            </column>
            <column caption='Year Week' datatype='string' name='[Calculation_5276107732729737220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) + &apos;W&apos;+&#10;IF WEEK([report_date]) &lt; 10 THEN &apos;0&apos; + STR(WEEK([report_date]))&#10;ELSE STR(WEEK([report_date])) END' />
            </column>
            <column caption='Date Selection City Level Penetration' datatype='string' name='[Date Selection Daily Breakdown (copy 2)_1132936814923243537]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE  [Parameters].[Granularity CPC Daily Breakdown (copy)_1132936814923460626]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_5276107732729585667]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_5276107732729737220]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;END)' />
            </column>
            <column caption='Total Vendors #' datatype='integer' name='[active_vendors_count]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
