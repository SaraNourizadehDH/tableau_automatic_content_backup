        <calculation class='tableau' formula='IF [Calculation_6329105633334755340] &lt; 0.05 THEN &quot;&lt;5%&quot;&#10;ELSEIF [Calculation_6329105633334755340] &lt; 0.10 THEN &quot;5-10%&quot;&#10;ELSEIF [Calculation_6329105633334755340]&lt; 0.15 THEN &quot;10-15%&quot;&#10;ELSEIF [Calculation_6329105633334755340] &lt; 0.20 THEN &quot;15-20%&quot;&#10;ELSEIF [Calculation_6329105633334755340] &lt; 0.25 THEN &quot;20-25%&quot;&#10;ELSEIF [Calculation_6329105633334755340] &lt; 0.30 THEN &quot;25-30%&quot;&#10;ELSEIF [Calculation_6329105633334755340] &lt; 0.35 THEN &quot;30-35%&quot;&#10;ELSEIF [Calculation_6329105633334755340] &lt; 0.40 THEN &quot;35-40%&quot;&#10;ELSE &quot;40%+&quot;&#10;END' />
