    <worksheet name='CPC Revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>&lt;Sheet Name&gt; - &lt;</run>
            <run fontalignment='1' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>[Parameters].[Ad Credits Consumed Eur Parameter]</run>
            <run fontalignment='1' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='campaign level data' name='federated.1fohas21lmmdxc11euiux1r05zdo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Ad Credits Consumed Eur Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fohas21lmmdxc11euiux1r05zdo'>
            <column caption='Est. CPC vs. LM %' datatype='real' default-format='p0.00%' name='[Budget MTD vs. LMTD % (copy)_371828464615137289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_371828464614473736]/[CPC Revenue LMTD € (copy)_371828464614285319]-1' />
            </column>
            <column caption='LM CPC Revenue' datatype='real' name='[CPC Revenue LMTD € (copy)_371828464614285319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE DATETRUNC(&apos;month&apos;, [report_date]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))&#10;&#10;WHEN TRUE THEN [Calculation_371828464642830348] END' />
            </column>
            <column caption='Data Date' datatype='date' name='[Calculation_371828464611033090]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([report_date])}' />
            </column>
            <column caption='Est. CPC Revenue' datatype='real' name='[Calculation_371828464614473736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Final Budget MTD € (copy)_371828464613748741] &#10;&#10;/ &#10;&#10;//Days passed&#10;DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), [Calculation_371828464611033090])&#10;&#10;*&#10;&#10;//Total days in month&#10;DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;,TODAY()), DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,TODAY())))' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_371828464642830348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_clicks_revenue_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_clicks_revenue_local] &#13;&#10;END' />
            </column>
            <column caption='Placeholder 1' datatype='integer' name='[Calculation_5276107732745076741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Placeholder 2' datatype='integer' name='[Calculation_5276107732745150470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Placeholder 3' datatype='integer' name='[Calculation_5276107732745191431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Placeholder 4' datatype='integer' name='[Calculation_5276107732753448968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='CPC Revenue MoM' datatype='real' default-format='p0.00%' name='[Calculation_5276107732761174027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([Calculation_371828464614473736])&#10;/&#10;MAX([CPC Revenue LMTD € (copy)_371828464614285319])&#10;&#10;- 1' />
            </column>
            <column caption='MTD CPC Revenue' datatype='real' name='[Final Budget MTD € (copy)_371828464613748741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;&#10;WHEN TRUE THEN [Calculation_371828464642830348] END' />
            </column>
            <column caption='Region' datatype='string' name='[brand]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Foodora&quot;' value='EU' />
                <alias key='&quot;Foodpanda&quot;' value='APAC' />
                <alias key='&quot;Yemeksepeti&quot;' value='TR' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Booking Source' datatype='string' name='[created_by_actor]' role='dimension' type='nominal' />
