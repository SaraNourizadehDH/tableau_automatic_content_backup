            <column caption='Avg Click Price' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1132936814925090837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_371828464642830348])/SUM([total_billed_clicks_count])' />
            </column>
            <column caption='Campaign Budget' datatype='real' name='[Calculation_3194459537811718145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [campaign_budget_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [campaign_budget_local]&#13;&#10;END' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_371828464642830348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_clicks_revenue_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_clicks_revenue_local] &#13;&#10;END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_371828464643162125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Ad Credits Consumed Eur Parameter]&#10;WHEN &apos;Local&apos; THEN [total_gmv_local]&#10;ELSE [total_gmv_eur] &#10;END' />
            </column>
            <column caption='CPC Revenue / GMV %' datatype='real' default-format='p0.00%' name='[Calculation_371828464643293198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_371828464642830348])/SUM([Calculation_371828464643162125])' />
            </column>
            <column caption='Year Month' datatype='string' name='[Calculation_5276107732729585667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [report_date])) + &#10;RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [report_date])), 2)' />
            </column>
            <column caption='Year Week' datatype='string' name='[Calculation_5276107732729737220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) + &apos;W&apos;+&#10;IF WEEK([report_date]) &lt; 10 THEN &apos;0&apos; + STR(WEEK([report_date]))&#10;ELSE STR(WEEK([report_date])) END' />
            </column>
            <column caption='CPC Vendors GFV' datatype='real' name='[Calculation_5276107732784939020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [vendor_gfv_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [vendor_gfv_local] &#10;END' />
            </column>
            <column caption='CPC Revenue / GFV %' datatype='real' default-format='p0.00%' name='[Calculation_5276107732786274317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_371828464642830348]/[Calculation_5276107732784939020])' />
            </column>
            <column caption='Overall Utilization %' datatype='real' default-format='p0%' name='[Calculation_5276107732788551695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_371828464642830348])/SUM([Calculation_3194459537811718145])' />
            </column>
            <column caption='Median Utilizaton %' datatype='real' default-format='p0.00%' name='[Calculation_5276107732791193618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([Calculation_371828464642830348] / [Calculation_3194459537811718145])' />
            </column>
            <column caption='Avg CPC ROI' datatype='real' name='[Calculation_5276107732792434707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Campaign Budget (copy)_1132936813822521358])/SUM([Calculation_371828464642830348])' />
            </column>
            <column caption='Median CPC ROI' datatype='real' name='[Calculation_5276107732792549396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([Campaign Budget (copy)_1132936813822521358]/[Calculation_371828464642830348])' />
            </column>
            <column caption='Vendor with 4+ Hours #' datatype='integer' name='[Calculation_5276107732792774677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[is_four_hours_plus_open] THEN 1 ELSE 0 END' />
            </column>
            <column caption='CPC Budget / GMV %' datatype='real' default-format='p0.00%' name='[Calculation_6329105632971714563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3194459537811718145])/SUM([Calculation_371828464643162125])' />
            </column>
            <column caption='Avg CPC Budget / GFV %' datatype='real' name='[Calculation_6329105632974745604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_3194459537811718145]/[Calculation_5276107732784939020])' />
            </column>
            <column caption='Median Click Price' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6329105632975728645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([Calculation_371828464642830348]/[total_billed_clicks_count])' />
            </column>
            <column caption='Final Active Budget' datatype='real' name='[Calculation_6465620986782425089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;active&apos; THEN [Calculation_3194459537811718145] ELSE 0 END' />
            </column>
            <column caption='GMV Total from CPC' datatype='real' name='[Campaign Budget (copy)_1132936813822521358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_gmv_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_gmv_local]&#13;&#10;END' />
            </column>
            <column caption='Date Selection Overall Performance' datatype='string' name='[Date Selection Daily Breakdown (copy)_1132936813669990404]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE  [Parameters].[Parameter 2]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_5276107732729585667]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_5276107732729737220]&#10;WHEN &apos;Daily&apos; THEN STR([report_date])&#10;END)' />
            </column>
