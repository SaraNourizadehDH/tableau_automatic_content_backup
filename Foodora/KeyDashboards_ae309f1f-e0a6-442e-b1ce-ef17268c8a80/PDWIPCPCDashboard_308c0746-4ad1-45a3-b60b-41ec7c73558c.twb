      <table>
        <view>
          <datasources>
            <datasource caption='campaign level data' name='federated.1fohas21lmmdxc11euiux1r05zdo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Ad Credits Consumed Eur Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fohas21lmmdxc11euiux1r05zdo'>
            <column caption='Campaign Budget' datatype='real' name='[Calculation_3194459537811718145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [campaign_budget_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [campaign_budget_local]&#13;&#10;END' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_371828464642830348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_clicks_revenue_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_clicks_revenue_local] &#13;&#10;END' />
            </column>
            <column caption='Initial Booked Budget (incl Ad Credits)' datatype='real' name='[Calculation_3969078691508215808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [initial_campaign_budget_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [initial_campaign_budget_local] &#10;END' />
            </column>
            <column caption='Final Booked Budget (incl Ad Credits)' datatype='real' name='[Calculation_3969078691508482049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [initial_campaign_budget_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [initial_campaign_budget_local] END' />
            </column>
            <column caption='Year Month' datatype='string' name='[Calculation_5276107732729585667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [report_date])) + &#10;RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [report_date])), 2)' />
            </column>
            <column caption='CPC Vendors GFV' datatype='real' name='[Calculation_5276107732784939020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [vendor_gfv_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [vendor_gfv_local] &#10;END' />
            </column>
            <column caption='CPC Revenue / GFV %' datatype='real' default-format='p0.00%' name='[Calculation_5276107732786274317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_371828464642830348]/[Calculation_5276107732784939020])' />
            </column>
            <column caption='Overall Utilization %' datatype='real' default-format='p0%' name='[Calculation_5276107732788551695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_371828464642830348])/SUM([Calculation_3194459537811718145])' />
            </column>
            <column caption='Avg CPC ROI' datatype='real' name='[Calculation_5276107732792434707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Campaign Budget (copy)_1132936813822521358])/SUM([Calculation_371828464642830348])' />
            </column>
            <column caption='CPC Revenue excl Ad Credits' datatype='real' name='[Calculation_6329105632980480008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_371828464642830348] - [Calculation_6329105632980783113]' />
            </column>
            <column caption='Ad Credits Consumed' datatype='real' name='[Calculation_6329105632980783113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [ad_credits_consumed_eur]&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [ad_credits_consumed_local]&#10;END' />
            </column>
            <column caption='GMV Total from CPC' datatype='real' name='[Campaign Budget (copy)_1132936813822521358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Euro&quot; THEN [total_gmv_eur]&#13;&#10;ELSEIF [Parameters].[Ad Credits Consumed Eur Parameter] = &quot;Local&quot; THEN [total_gmv_local]&#13;&#10;END' />
            </column>
