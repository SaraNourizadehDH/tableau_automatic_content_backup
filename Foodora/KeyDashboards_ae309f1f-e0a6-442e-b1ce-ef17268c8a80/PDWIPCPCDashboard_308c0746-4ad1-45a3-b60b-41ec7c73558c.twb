      <column caption='Median CPC ROI' datatype='real' name='[Calculation_5276107732792549396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([Campaign Budget (copy)_1132936813822521358]/[Calculation_371828464642830348])' />
