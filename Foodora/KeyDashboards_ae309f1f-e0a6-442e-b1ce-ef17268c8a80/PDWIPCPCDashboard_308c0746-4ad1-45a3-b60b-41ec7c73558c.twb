        <calculation class='tableau' formula='MEDIAN([Calculation_371828464642830348]/[total_billed_clicks_count])' />
      </column>
      <column caption='Avg CPC Orders' datatype='real' name='[Calculation_6329105632977100806]' role='measure' type='quantitative'>
