      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_C4DFD5C8E5D446F48AD26E80241FD0ED'>
            <properties context=''>
              <relation connection='bigquery.19o4fbd13bptde158n6fy0iyib2b' name='Custom SQL Query' type='text'>WITH monthly_active_vendor_list AS (
  SELECT
    DISTINCT
    FORMAT_DATE(&quot;%Y-%m&quot;, b.order_date) AS month_year,
    DATE_TRUNC(b.order_date, MONTH) AS order_month_main,
    b.vendor_code,
    b.vendor_name,
    b.chain_code,
    b.chain_name,
    vm.sf_account_owner_name,
    vm.account_type,
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` AS b
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS vm
         ON b.vendor_code = vm.vendor_code
  WHERE b.is_valid_order
    AND b.order_date &gt;&gt;= &quot;2022-01-01&quot;
    AND b.business_type_apac = &quot;restaurants&quot;
),

monthly_orders AS (
  SELECT
    FORMAT_DATE(&quot;%Y-%m&quot;, order_date) AS month,
    primary_zone_name,
    vendor_code,
    DATE_TRUNC(order_date, MONTH) AS order_month_2nd,
    COUNT(order_code) AS orders
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  WHERE is_valid_order
  AND order_date &gt;&gt;= &quot;2022-01-01&quot;
  AND business_type_apac = &quot;restaurants&quot;
  GROUP BY 1,2,3,4
),

main AS (
SELECT
  monthly_active_vendor_list.*,
  monthly_orders.* EXCEPT(vendor_code),
  IF(monthly_active_vendor_list.month_year = monthly_orders.month, TRUE, FALSE) AS order_tag_month
FROM monthly_active_vendor_list
LEFT JOIN monthly_orders
       ON monthly_orders.vendor_code = monthly_active_vendor_list.vendor_code 
      AND monthly_orders.order_month_2nd &gt;&gt;= monthly_active_vendor_list.order_month_main
),

zero_orders_in_next_m AS (
  SELECT
    main.month_year,
    main.order_month_main,
    main.vendor_code,
    SUM(CASE WHEN main.order_month_2nd &gt;&gt; main.order_month_main THEN orders ELSE 0 END) AS orders
  FROM main
  GROUP BY 1,2,3
)

SELECT
  main.*,
  (CASE WHEN IFNULL(zero_orders_in_next_m.orders,0) = 0 THEN TRUE ELSE FALSE END) AS next_month_zero_order
FROM main
LEFT JOIN zero_orders_in_next_m
       ON zero_orders_in_next_m.vendor_code = main.vendor_code
      AND zero_orders_in_next_m.order_month_main = main.order_month_main</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
