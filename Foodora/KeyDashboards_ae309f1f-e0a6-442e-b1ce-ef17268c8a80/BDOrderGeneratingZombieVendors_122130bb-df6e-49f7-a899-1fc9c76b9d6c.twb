  GROUP BY 1,2,3
)

SELECT
  main.*,
  (CASE WHEN IFNULL(zero_orders_in_next_m.orders,0) = 0 THEN TRUE ELSE FALSE END) AS next_month_zero_order
FROM main
LEFT JOIN zero_orders_in_next_m
       ON zero_orders_in_next_m.vendor_code = main.vendor_code
      AND zero_orders_in_next_m.order_month_main = main.order_month_main</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
