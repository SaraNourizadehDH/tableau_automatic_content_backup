              <calculation class='tableau' formula='IF table_name = &apos;regional_apac_lead_account_opp_aggregated_users_layer&apos; &#10;    AND DATEDIFF(&apos;month&apos;, [latest_update],TODAY()) &lt;= 1 &#10;THEN &apos;PASS&apos;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [latest_update],TODAY()) &lt;= 1 &#10;THEN &apos;PASS&apos; &#10;ELSE &apos;FAIL&apos; &#10;END' />
