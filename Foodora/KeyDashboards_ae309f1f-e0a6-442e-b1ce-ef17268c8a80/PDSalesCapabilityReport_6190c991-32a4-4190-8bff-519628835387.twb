            <column caption='Vendor Grade ' datatype='string' name='[Calculation_3669941133120344064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_grade] IN (&apos;A&apos;,&apos;AA&apos;,&apos;AAA&apos;,&apos;B&apos;) THEN &apos;A/B&apos;&#10;ELSE [vendor_grade] END' />
            </column>
            <column caption='Is Underperformer (&lt;=10 Acq)' datatype='boolean' name='[Calculation_625718928037785600]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2966253693896478721] &lt;= 10 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Total Headcount' datatype='integer' name='[Calculation_625718928390656001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(sf_user_id)' />
            </column>
            <column caption='Account Age &gt; 60' datatype='boolean' name='[Calculation_754704814563266561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[account_age_snapshot] &gt;= 60' />
            </column>
            <column caption='Total Headcount Colour Coding' datatype='integer' name='[Total Active Headcount Colour Coding (copy)_625718928390836226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF isnull([Calculation_625718928390656001]) then 0&#10;ELSEIF ([Calculation_625718928390656001] - LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &gt;= 0.1&#10;then 2&#10;ELSEIF ([Calculation_625718928390656001] - LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &lt;= -0.1&#10;then -2&#10;ELSEIF ([Calculation_625718928390656001] - LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &gt;= 0.05&#10;then 1&#10;ELSEIF ([Calculation_625718928390656001]- LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &lt;= -0.05&#10;THEN -1&#10;ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Account Age Snapshot' datatype='integer' name='[account_age_snapshot]' role='dimension' type='ordinal' />
