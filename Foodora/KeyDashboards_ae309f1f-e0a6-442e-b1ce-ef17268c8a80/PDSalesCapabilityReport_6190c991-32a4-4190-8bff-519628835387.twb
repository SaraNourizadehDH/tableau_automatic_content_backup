            <column caption='User Country' datatype='string' name='[user_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='User Type' datatype='string' name='[user_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;field rep&quot;' value='Field Rep' />
                <alias key='&quot;others&quot;' value='Others' />
                <alias key='&quot;telesales&quot;' value='Telesales' />
              </aliases>
            </column>
            <column caption='Vendor Grade (original)' datatype='string' name='[vendor_grade]' role='dimension' type='nominal' />
            <column datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
