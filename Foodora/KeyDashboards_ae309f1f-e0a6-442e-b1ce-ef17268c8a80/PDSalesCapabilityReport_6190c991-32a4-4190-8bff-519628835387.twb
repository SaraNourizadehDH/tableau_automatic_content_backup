        <groupfilter function='level-members' level='[none:user_country:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:user_type:nk]'>
        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[none:user_type:nk]' member='&quot;field rep&quot;' />
