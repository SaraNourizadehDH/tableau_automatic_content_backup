            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Activations' datatype='integer' name='[num_activations]' role='measure' type='quantitative' />
            <column datatype='string' name='[opportunity_business_type]' role='dimension' type='nominal' />
            <column caption='Report Month' datatype='date' default-format='*MMM YY' name='[report_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[resto_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Resto Country' datatype='string' name='[resto_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Sf User Id' datatype='string' name='[sf_user_id]' role='dimension' type='nominal' />
            <column-instance column='[num_activations]' derivation='Sum' name='[sum:num_activations:ok]' pivot='key' type='ordinal' />
