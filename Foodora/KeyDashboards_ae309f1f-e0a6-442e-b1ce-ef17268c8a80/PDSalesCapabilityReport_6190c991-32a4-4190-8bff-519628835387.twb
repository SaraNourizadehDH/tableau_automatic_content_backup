            <column caption='Activations' datatype='integer' name='[num_activations]' role='measure' type='quantitative' />
            <column caption='Signings' datatype='integer' name='[num_signings]' role='measure' type='quantitative' />
            <column datatype='string' name='[opportunity_business_type]' role='dimension' type='nominal' />
            <column caption='Report Month' datatype='date' default-format='*MMM YY' name='[report_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[resto_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Sf User Id' datatype='string' name='[sf_user_id]' role='dimension' type='nominal' />
            <column-instance column='[num_activations]' derivation='Sum' name='[sum:num_activations:qk]' pivot='key' type='quantitative' />
            <column-instance column='[num_signings]' derivation='Sum' name='[sum:num_signings:qk]' pivot='key' type='quantitative' />
            <column caption='Title' datatype='string' name='[title]' role='dimension' type='nominal' />
            <column caption='User Country' datatype='string' name='[user_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='User Type' datatype='string' name='[user_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;field rep&quot;' value='Field Rep' />
                <alias key='&quot;others&quot;' value='Others' />
                <alias key='&quot;telesales&quot;' value='Telesales' />
