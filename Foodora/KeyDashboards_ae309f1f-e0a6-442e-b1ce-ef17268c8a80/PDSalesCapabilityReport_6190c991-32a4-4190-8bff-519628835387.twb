            <column-instance column='[Calculation_3372773926206877702]' derivation='User' name='[pcto:usr:Calculation_3372773926206877702:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:report_month:ok]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column caption='Report Month' datatype='date' default-format='*MMM YY' name='[report_month]' role='dimension' type='ordinal' />
