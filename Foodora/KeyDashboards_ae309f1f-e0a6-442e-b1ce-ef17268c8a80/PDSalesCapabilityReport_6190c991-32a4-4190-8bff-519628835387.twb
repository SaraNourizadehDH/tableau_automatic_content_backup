      </filter>
      <filter class='categorical' column='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:Calculation_754704814563266561:nk]'>
        <groupfilter function='member' level='[none:Calculation_754704814563266561:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:hk_user_type:nk]'>
        <groupfilter function='level-members' level='[none:hk_user_type:nk]' />
      </filter>
      <filter class='categorical' column='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:is_contractor:nk]'>
        <groupfilter function='level-members' level='[none:is_contractor:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:opportunity_business_type:nk]'>
        <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[none:opportunity_business_type:nk]' member='%null%' />
          <groupfilter function='member' level='[none:opportunity_business_type:nk]' member='&quot;New Business&quot;' />
          <groupfilter function='member' level='[none:opportunity_business_type:nk]' member='&quot;Win Back&quot;' />
        </groupfilter>
      </filter>
