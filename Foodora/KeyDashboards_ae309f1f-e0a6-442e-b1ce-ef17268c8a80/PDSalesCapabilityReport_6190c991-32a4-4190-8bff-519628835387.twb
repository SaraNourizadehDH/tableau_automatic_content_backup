    <worksheet name='Target vs Achievement'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12' underline='true'>Acquisitions / HC Target vs Achievement </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#898989' fontsize='8' italic='true'>   * Headcount numbers here refer to total headcount </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor level calculations [custom query]' name='federated.1h52z2m10oih9w1bj9bux0wn52hv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentage&quot;'>
              <calculation class='tableau' formula='&quot;Percentage&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h52z2m10oih9w1bj9bux0wn52hv'>
            <column caption='Entity' datatype='string' name='[Calculation_1838876046051983360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [user_country]&#10;    WHEN &quot;Austria&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Czech Republic&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Finland&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Hungary&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Norway&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Sweden&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Thailand&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Turkey&quot; THEN &quot;Yemeksepeti&quot;&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='Account Age Bucket' datatype='string' name='[Calculation_2282128765470769154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [account_age_snapshot] &lt;= 30 THEN &apos;0 - 1 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 30 AND [account_age_snapshot] &lt;= 60 THEN &apos;1 - 2 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 60 AND [account_age_snapshot] &lt;= 90 THEN &apos;2 - 3 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 90 AND [account_age_snapshot] &lt;= 180 THEN &apos;3 - 6 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 180 AND [account_age_snapshot] &lt;= 360 THEN &apos;6 - 12 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 360 THEN &apos;12+ month&apos;&#10;END' />
            </column>
            <column caption='Capital/Cities' datatype='string' name='[Calculation_280067605375016960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [resto_city] IN (&apos;Dhaka&apos;, &apos;Phnom Penh&apos;, &apos;Vientiane Capital&apos;, &apos;Yangon&apos;, &apos;Kuala Lumpur&apos;, &apos;Manila&apos;, &apos;Karachi&apos;, &apos;Taipei&apos;, &apos;Bangkok&apos;)&#10;THEN &apos;Capital&apos;&#10;ELSE &apos;City&apos;&#10;END' />
            </column>
            <column caption='Activations per user' datatype='integer' name='[Calculation_2966253693896478721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sf_user_id],[user_country],[report_month] : SUM([num_activations])}' />
            </column>
            <column caption='Activation Bucket' datatype='string' name='[Calculation_2966253693896777730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2966253693896478721] = 0 THEN &apos;0 Activations&apos;&#10;ELSEIF [Calculation_2966253693896478721] = 1 THEN &apos;1 Activation&apos;&#10;ELSE &apos;&gt;= 2 Activations&apos;&#10;END' />
            </column>
            <column caption='Field sales HC %achievement' datatype='real' name='[Calculation_3638978910041169921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;    IF MIN([field_sales_headcount_target]) = MAX([field_sales_headcount_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: SUM([Calculation_3638978910045196293]) / [Calculation_3638978910042152962]}) &#10;    ELSE SUM([Calculation_3638978910045196293]) / [Calculation_3638978910042152962]&#10;    END&#10;ELSE &#10;    IF MIN([latest_field_sales_headcount_target]) = MAX([latest_field_sales_headcount_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: SUM([Calculation_3638978910045196293]) / [Field Sales HC Target (copy)_687784160969379840]}) &#10;    ELSE SUM([Calculation_3638978910045196293]) / [Field Sales HC Target (copy)_687784160969379840]&#10;    END&#10;END' />
            </column>
            <column caption='Field Sales HC Target (2024)' datatype='integer' name='[Calculation_3638978910042152962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([field_sales_headcount_target]) = MAX([field_sales_headcount_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_headcount_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_headcount_target])})&#10;END' />
            </column>
            <column caption='Telesales HC Target' datatype='real' name='[Calculation_3638978910043758596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 &#10;THEN SUM({INCLUDE [report_month], [user_country]: MIN([telesales_headcount_target])}) &#10;ELSE SUM({INCLUDE [report_month], [user_country]: MIN([latest_telesales_headcount_target])}) &#10;END' />
            </column>
            <column caption='Field Sales HC' datatype='integer' name='[Calculation_3638978910045196293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [user_country], [report_month] : COUNTD(IF [user_type] = &apos;field rep&apos; THEN [email_internal_non_pii] ELSE NULL END)}' />
            </column>
            <column caption='Telesales HC' datatype='integer' name='[Calculation_3638978910098743304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [user_country], [report_month] : COUNTD(IF [user_type] = &apos;telesales&apos; THEN [email_internal_non_pii] ELSE NULL END)}' />
            </column>
            <column caption='Telesales HC % achievement' datatype='real' name='[Calculation_3638978910098841609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;IF MIN([telesales_headcount_target]) = MAX([field_sales_headcount_target]) &#10;THEN SUM({FIXED [report_month],[user_country]: SUM([Calculation_3638978910098743304])/ [Calculation_3638978910043758596]})&#10;ELSE SUM([Calculation_3638978910098743304]) / [Calculation_3638978910043758596]&#10;END&#10;ELSE IF MIN([latest_telesales_headcount_target]) = MAX([latest_field_sales_headcount_target]) &#10;THEN SUM({FIXED [report_month],[user_country]: SUM([Calculation_3638978910098743304])/ [Calculation_3638978910043758596]})&#10;ELSE SUM([Calculation_3638978910098743304]) / [Calculation_3638978910043758596]&#10;END&#10;END' />
            </column>
            <column caption='View ' datatype='string' name='[Calculation_3638978910378422290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Field Sales HC Colour Coding' datatype='integer' name='[Calculation_3638978911134388252]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_3638978910041169921] &lt; 0.5 THEN -1&#10;ELSEIF [Calculation_3638978910041169921]  &gt;= .5 AND [Calculation_3638978910041169921] &lt; .8 THEN 0&#10;ELSEIF [Calculation_3638978910041169921] &gt;= 0.8 THEN 1&#10;END' />
            </column>
            <column caption='Vendor Grade ' datatype='string' name='[Calculation_3669941133120344064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_grade] IN (&apos;A&apos;,&apos;AA&apos;,&apos;AAA&apos;,&apos;B&apos;) THEN &apos;A/B&apos;&#10;ELSE [vendor_grade] END' />
            </column>
            <column caption='Telesales Acquisitions' datatype='integer' name='[Calculation_59461632724054020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_type] = &apos;telesales&apos; THEN [num_activations] END)' />
            </column>
            <column caption='Telesales Acquisitions Target' datatype='real' name='[Calculation_59461632724393989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN [Field Sales acquisition Target (2024) (copy)_687784161008582662] &#10;ELSE [Field Sales acquisition Target (2025) (copy)_687784161008971783] END' />
            </column>
            <column caption='Telesales Acquisitions % achievement' datatype='real' name='[Calculation_59461632725532679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;    IF MIN([telesales_acquisition_target]) = MAX([telesales_acquisition_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: [Calculation_59461632724054020]/ [Field Sales acquisition Target (2024) (copy)_687784161008582662]}) &#10;    ELSE [Calculation_59461632724054020]/ [Field Sales acquisition Target (2024) (copy)_687784161008582662]&#10;   END&#10;ELSE &#10;    IF MIN([latest_telesales_acquisition_target]) = MAX([latest_telesales_acquisition_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: [Calculation_59461632724054020] / [Field Sales acquisition Target (2025) (copy)_687784161008971783] }) &#10;    ELSE [Calculation_59461632724054020] / [Field Sales acquisition Target (2025) (copy)_687784161008971783]&#10;    END&#10;END' />
            </column>
            <column caption='Is Underperformer (&lt;=10 Acq)' datatype='boolean' name='[Calculation_625718928037785600]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2966253693896478721] &lt;= 10 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Field Sales HC Target ' datatype='real' name='[Calculation_687784160969658369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN [Calculation_3638978910042152962]&#10;ELSE [Field Sales HC Target (copy)_687784160969379840] END' />
            </column>
            <column caption='Account Age &gt; 60' datatype='boolean' name='[Calculation_754704814563266561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[account_age_snapshot] &gt;= 60' />
            </column>
            <column caption='Telesales HC Colour Coding ' datatype='integer' name='[Field Sales Colour Coding (copy)_3638978911159263261]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_3638978910098841609] &lt; .5 THEN -1&#10;ELSEIF [Calculation_3638978910098841609] &gt;= .5 AND [Calculation_3638978910098841609] &lt; .8 THEN 0&#10;ELSE 1&#10;END' />
            </column>
            <column caption='Field Sales Acqusition Target ' datatype='real' name='[Field Sales HC Target  (copy)_687784160994553861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN [Field Sales HC Target (2024) (copy)_687784160993927171]&#10;ELSE [Field Sales acquisition Target (2024) (copy)_687784160994189316] END' />
            </column>
            <column caption='Field Sales acquisition Target (2024)' datatype='integer' name='[Field Sales HC Target (2024) (copy)_687784160993927171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([field_sales_acquisition_target]) = MAX([field_sales_acquisition_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_acquisition_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_acquisition_target])})&#10;END' />
            </column>
            <column caption='Field Sales HC Target (2025)' datatype='real' name='[Field Sales HC Target (copy)_687784160969379840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([latest_field_sales_headcount_target]) = MAX([latest_field_sales_headcount_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MIN([latest_field_sales_headcount_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MIN([latest_field_sales_headcount_target])})&#10;END' />
            </column>
            <column caption='Field Sales acquisition Target (2025)' datatype='real' name='[Field Sales acquisition Target (2024) (copy)_687784160994189316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([latest_field_sales_acquisition_target]) = MAX([latest_field_sales_acquisition_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MAX([latest_field_sales_acquisition_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MAX([latest_field_sales_acquisition_target])})&#10;END' />
            </column>
            <column caption='Telesale Sales acquisition Target (2024) (copy)' datatype='integer' name='[Field Sales acquisition Target (2024) (copy)_687784161008582662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([telesales_acquisition_target]) = MAX([telesales_acquisition_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MIN([telesales_acquisition_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MIN([telesales_acquisition_target])})&#10;END' />
            </column>
            <column caption='Telesales acquisition Target (2025)' datatype='real' name='[Field Sales acquisition Target (2025) (copy)_687784161008971783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([latest_field_sales_acquisition_target]) = MAX([latest_telesales_acquisition_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MAX([latest_telesales_acquisition_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MAX([latest_telesales_acquisition_target])})&#10;END' />
            </column>
            <column caption='Field Sales Acq Colour Coding   ' datatype='integer' name='[Telesales Acq Colour Coding   (copy)_59461632727732236]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Telesales Acquisitions % achievement (copy)_59461632727330826] &lt; .5 THEN -1&#10;ELSEIF [Telesales Acquisitions % achievement (copy)_59461632727330826] &gt;= .5 AND [Telesales Acquisitions % achievement (copy)_59461632727330826] &lt; .8 THEN 0&#10;ELSE 1&#10;END' />
            </column>
            <column caption='Field Sales Acquisitions % achievement' datatype='real' name='[Telesales Acquisitions % achievement (copy)_59461632727330826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;    IF MIN([field_sales_acquisition_target]) = MAX([field_sales_acquisition_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales HC Target (2024) (copy)_687784160993927171]}) &#10;    ELSE [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales HC Target (2024) (copy)_687784160993927171]&#10;   END&#10;ELSE &#10;    IF MIN([latest_field_sales_acquisition_target]) = MAX([latest_field_sales_acquisition_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales acquisition Target (2024) (copy)_687784160994189316]}) &#10;    ELSE [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales acquisition Target (2024) (copy)_687784160994189316]&#10;    END&#10;END' />
            </column>
