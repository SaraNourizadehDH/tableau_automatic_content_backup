      <column caption='Field Sales Acquisitions % achievement' datatype='real' name='[Telesales Acquisitions % achievement (copy)_59461632727330826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;    IF MIN([field_sales_acquisition_target]) = MAX([field_sales_acquisition_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales HC Target (2024) (copy)_687784160993927171]}) &#10;    ELSE [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales HC Target (2024) (copy)_687784160993927171]&#10;   END&#10;ELSE &#10;    IF MIN([latest_field_sales_acquisition_target]) = MAX([latest_field_sales_acquisition_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales acquisition Target (2024) (copy)_687784160994189316]}) &#10;    ELSE [Telesales Acquisitions (copy)_59461632727220233] / [Field Sales acquisition Target (2024) (copy)_687784160994189316]&#10;    END&#10;END' />
