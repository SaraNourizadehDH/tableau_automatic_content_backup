      <column caption='LC2 desc' datatype='string' name='[dlp 70% description (copy)_208854438137880579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;NCR is defined as whether a vendor meets at least one of the following criteria: (1) activated with CPC within 3 days of activation, (2) had their first Joker order within 30 days of activation, or (3) had their first Targeted Deals order within 30 days of activation. If any one of these conditions is met, the vendor is counted towards NCR&quot;' />
