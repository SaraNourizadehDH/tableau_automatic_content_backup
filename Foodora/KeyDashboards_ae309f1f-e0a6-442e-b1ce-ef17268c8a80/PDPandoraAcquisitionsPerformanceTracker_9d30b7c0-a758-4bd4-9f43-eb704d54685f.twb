    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='(Rep) Pandora Acquisition Performance Tracker '>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PDPandoraAcquisitionsPerformanceTracker/RepPandoraAcquisitionPerformanceTracker?rev=' id='RepPandoraAcquisitionPerformanceTracker' path='/t/Foodora/workbooks/PDPandoraAcquisitionsPerformanceTracker' revision='' site='Foodora' />
      <style />
      <size maxheight='1300' maxwidth='2100' minheight='1300' minwidth='2100' sizing-mode='fixed' />
      <datasources>
        <datasource caption='vendor level calculations [custom query]' name='federated.1h52z2m10oih9w1bj9bux0wn52hv' />
      </datasources>
      <datasource-dependencies datasource='federated.1h52z2m10oih9w1bj9bux0wn52hv'>
        <column caption='Activation Bucket' datatype='string' name='[Calculation_2966253693896777730]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Calculation_2966253693896478721] = 0 THEN &apos;0 Activations&apos;&#10;ELSEIF [Calculation_2966253693896478721] = 1 THEN &apos;1 Activation&apos;&#10;ELSE &apos;&gt;= 2 Activations&apos;&#10;END' />
        </column>
        <column caption='Account Age &gt; 60' datatype='boolean' name='[Calculation_754704814563266561]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[account_age_snapshot] &gt;= 60' />
        </column>
        <column caption='is_tartgeted_deal_flag' datatype='boolean' name='[Calculation_784330027783819264]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_targeted_deal] = TRUE THEN TRUE ELSE FALSE END' />
        </column>
        <column caption='Is Active' datatype='boolean' name='[is_active_snapshot]' role='dimension' type='nominal' />
        <column caption='is_regular_deals_flag' datatype='boolean' name='[is_tartgeted_deal_flag (copy)_784330027784019969]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_regular_deal_flag] = TRUE THEN TRUE ELSE FALSE END' />
        </column>
        <column caption='is_cpc_flag' datatype='boolean' name='[is_tartgeted_deal_flag (copy)_784330027784192002]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [cpc_opportunity_flag] = TRUE THEN TRUE ELSE FALSE END' />
        </column>
        <column caption='is_joker_flag' datatype='boolean' name='[is_tartgeted_deal_flag (copy)_784330027784331267]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_joker_deal] = TRUE THEN TRUE ELSE FALSE END' />
        </column>
