      <datasource-dependencies datasource='Parameters'>
        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[report_month]' caption='Date Parameter' datatype='date' name='[Dynamic Date (copy)]' param-domain-type='list' role='measure' type='quantitative' value='#2024-08-01#'>
          <calculation class='tableau' formula='#2024-08-01#' />
