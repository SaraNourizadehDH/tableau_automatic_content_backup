        <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;    IF MIN([field_sales_headcount_target]) = MAX([field_sales_headcount_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: SUM([Calculation_3638978910045196293]) / [Calculation_3638978910042152962]}) &#10;    ELSE SUM([Calculation_3638978910045196293]) / [Calculation_3638978910042152962]&#10;    END&#10;ELSE &#10;    IF MIN([latest_field_sales_headcount_target]) = MAX([latest_field_sales_headcount_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: SUM([Calculation_3638978910045196293]) / [Field Sales HC Target (copy)_687784160969379840]}) &#10;    ELSE SUM([Calculation_3638978910045196293]) / [Field Sales HC Target (copy)_687784160969379840]&#10;    END&#10;END' />
