      <column caption='CM/PM Total Activations Delta ' datatype='real' name='[CM/PM Total Productivity Delta (copy)_625718928746811405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM(IF [Calculation_59461632737325072] THEN [num_activations] END) / (COUNTD(IF [Calculation_59461632737325072] AND [Calculation_754704814563266561] AND [is_active_snapshot] THEN [email_internal_non_pii] END)),0)&#10;-&#10;ROUND(SUM(IF [Calculation_59461632737132559] THEN [num_activations] END) / (COUNTD(IF [Calculation_59461632737132559] AND [Calculation_754704814563266561] AND [is_active_snapshot] THEN [email_internal_non_pii] END)), 0)' />
      </column>
      <column caption='CM/PM Total Productivity %Chg (Neg)' datatype='string' name='[CM/PM Total Signings %Chg (Pos) (copy)_59461632738934804]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [CM Total Signings (copy)_59461632738263058] &lt; 0&#10;THEN &quot;▼&quot;&#10;END' />
      </column>
      <column caption='ABCD targets' datatype='real' name='[Calculation_1260022746090455040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Field Sales acquisition Target (2025) (copy)_687784161017462794] + [A/B acquisition Target (2025) (copy)_481814852805111808])' />
