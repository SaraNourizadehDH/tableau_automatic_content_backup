      <column caption='Market (truncated)' datatype='string' name='[Calculation_280067605785886724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [user_country] = &apos;Bangladesh&apos; THEN &apos;BD&apos;&#10;ELSEIF [user_country] = &apos;Cambodia&apos; THEN &apos;KH&apos;&#10;ELSEIF [user_country]  = &apos;Hong Kong&apos; THEN &apos;HK&apos;&#10;ELSEIF [user_country]  = &apos;Laos&apos; THEN &apos;LA&apos;&#10;ELSEIF [user_country]  = &apos;Malaysia&apos; THEN &apos;MY&apos;&#10;ELSEIF [user_country]  = &apos;Myanmar&apos; THEN &apos;MM&apos;&#10;ELSEIF [user_country]  = &apos;Pakistan&apos; THEN &apos;PK&apos;&#10;ELSEIF [user_country]  = &apos;Philippines&apos; THEN &apos;PH&apos;&#10;ELSEIF [user_country]  = &apos;Singapore&apos; THEN &apos;SG&apos;&#10;ELSEIF [user_country]  = &apos;Taiwan&apos; THEN &apos;TW&apos;&#10;ELSEIF [user_country]  = &apos;Thailand&apos; THEN &apos;TH&apos;&#10;END' />
