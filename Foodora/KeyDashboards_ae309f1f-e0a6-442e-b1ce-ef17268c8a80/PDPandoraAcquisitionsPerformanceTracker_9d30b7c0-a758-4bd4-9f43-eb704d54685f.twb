        <calculation class='tableau' formula='IF isnull([Calculation_625718928390656001]) then 0&#10;ELSEIF ([Calculation_625718928390656001] - LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &gt;= 0.1&#10;then 2&#10;ELSEIF ([Calculation_625718928390656001] - LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &lt;= -0.1&#10;then -2&#10;ELSEIF ([Calculation_625718928390656001] - LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &gt;= 0.05&#10;then 1&#10;ELSEIF ([Calculation_625718928390656001]- LOOKUP([Calculation_625718928390656001], 1))/[Calculation_625718928390656001] &lt;= -0.05&#10;THEN -1&#10;ELSE 0&#10;END'>
