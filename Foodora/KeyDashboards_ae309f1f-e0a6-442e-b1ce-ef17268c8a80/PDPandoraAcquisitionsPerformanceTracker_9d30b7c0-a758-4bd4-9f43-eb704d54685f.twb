      </column>
      <column caption='Total A/B max weight' datatype='real' name='[Calculation_1260022746095669250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF [Calculation_4528158377007149056] &gt;=1 THEN 1&#10;ELSE [Calculation_4528158377007149056] END) &#10;* (MIN([Calculation_654007176885579776]))' />
      </column>
      <column caption='dlp perc targets' datatype='real' name='[Calculation_1616792326555983872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dlp_threshold]' />
      </column>
      <column caption='(report date) Dynamic Date' datatype='boolean' name='[Calculation_1630866040139722752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;month&apos; THEN [report_month] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [report_month] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week&apos; THEN [report_month]&gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_month] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; THEN [report_month]&gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [report_month]&lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;month w mtd&apos; THEN [report_month] &gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,TODAY())) AND [report_month] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week w wtd&apos; THEN [report_month]&gt;= DATEADD(&apos;iso-week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_month] &lt; TODAY()&#10;END' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_1838876046051983360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [user_country]&#10;    WHEN &quot;Austria&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Czech Republic&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Finland&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Hungary&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Norway&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Sweden&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Thailand&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Turkey&quot; THEN &quot;Yemeksepeti&quot;&#10;    ELSE NULL&#10;END' />
      </column>
      <column caption='a/b activations description' datatype='string' name='[Calculation_208854438133559296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Numbers of A &amp; B graded vendor activations&quot;' />
      </column>
      <column caption='dynamic dlp' datatype='integer' name='[Calculation_2204934265212780545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [report_month] &gt;= DATE(&quot;2025-08-01&quot;) THEN &#10;    [dlp_80_perc_opportunity_id]&#10;ELSE &#10;    [dlp_70_perc_opportunity_id]&#10;END' />
      </column>
      <column caption='Account Age Bucket' datatype='string' name='[Calculation_2282128765470769154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [account_age_snapshot] &lt;= 30 THEN &apos;0 - 1 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 30 AND [account_age_snapshot] &lt;= 60 THEN &apos;1 - 2 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 60 AND [account_age_snapshot] &lt;= 90 THEN &apos;2 - 3 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 90 AND [account_age_snapshot] &lt;= 180 THEN &apos;3 - 6 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 180 AND [account_age_snapshot] &lt;= 360 THEN &apos;6 - 12 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 360 THEN &apos;12+ month&apos;&#10;END' />
      </column>
      <column caption='Productivity Colour Coding' datatype='integer' name='[Calculation_255157096063291392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF isnull([Calculation_3372773926184079360]) then 0&#10;ELSEIF ([Calculation_3372773926184079360] - LOOKUP([Calculation_3372773926184079360], 1))/[Calculation_3372773926184079360] &gt;= 0.1&#10;then 2&#10;ELSEIF ([Calculation_3372773926184079360] - LOOKUP([Calculation_3372773926184079360], 1))/[Calculation_3372773926184079360] &lt;= -0.1&#10;then -2&#10;ELSEIF ([Calculation_3372773926184079360] - LOOKUP([Calculation_3372773926184079360], 1))/[Calculation_3372773926184079360] &gt;= 0.05&#10;then 1&#10;ELSEIF ([Calculation_3372773926184079360] - LOOKUP([Calculation_3372773926184079360], 1))/[Calculation_3372773926184079360] &lt;= -0.05&#10;THEN -1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic VFD' datatype='real' name='[Calculation_265149465760305155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([report_month]) &lt; DATE(&quot;2025-07-01&quot;) THEN [Calculation_3781053365120983042] ELSE [total LC1 (copy)_265149465759547393]END' />
      </column>
      <column caption='opportunity business type exception' datatype='boolean' name='[Calculation_2704693103054585857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([user_country] = &quot;Hong Kong&quot; OR [user_country] = &quot;Finland&quot;) AND &#10;   ([opportunity_business_type] IN (&quot;Legal Form Change&quot;, &quot;New Business&quot;, &quot;Owner Change&quot;, &quot;Win Back&quot;))  &#10;THEN TRUE  &#10;ELSEIF ([user_country] &lt;&gt; &quot;Hong Kong&quot; AND [user_country] &lt;&gt; &quot;Finland&quot;) AND &#10;       ([opportunity_business_type] IN (&quot;New Business&quot;, &quot;Win Back&quot;))  &#10;THEN TRUE  &#10;ELSE FALSE  &#10;END' />
      </column>
      <column caption='Total Active Headcount Colour Coding' datatype='integer' name='[Calculation_278097336144216065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF isnull([Calculation_3372773926186041347]) then 0&#10;ELSEIF ([Calculation_3372773926186041347] - LOOKUP([Calculation_3372773926186041347], 1))/[Calculation_3372773926186041347] &gt;= 0.1&#10;then 2&#10;ELSEIF ([Calculation_3372773926186041347] - LOOKUP([Calculation_3372773926186041347], 1))/[Calculation_3372773926186041347] &lt;= -0.1&#10;then -2&#10;ELSEIF ([Calculation_3372773926186041347] - LOOKUP([Calculation_3372773926186041347], 1))/[Calculation_3372773926186041347] &gt;= 0.05&#10;then 1&#10;ELSEIF ([Calculation_3372773926186041347]- LOOKUP([Calculation_3372773926186041347], 1))/[Calculation_3372773926186041347] &lt;= -0.05&#10;THEN -1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Activations Colour Coding' datatype='integer' name='[Calculation_278097336146595842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF isnull(SUM([num_activations])) then 0&#10;ELSEIF (SUM([num_activations]) - LOOKUP(SUM([num_activations]), 1))/SUM([num_activations]) &gt;= 0.1&#10;then 2&#10;ELSEIF (SUM([num_activations]) - LOOKUP(SUM([num_activations]), 1))/SUM([num_activations]) &lt;= -0.1&#10;then -2&#10;ELSEIF (SUM([num_activations]) - LOOKUP(SUM([num_activations]), 1))/SUM([num_activations]) &gt;= 0.05&#10;then 1&#10;ELSEIF (SUM([num_activations]) - LOOKUP(SUM([num_activations]), 1))/SUM([num_activations]) &lt;= -0.05&#10;THEN -1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Productivity (Bins)' datatype='string' name='[Calculation_278097336158920708]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [sf_user_id], [report_month] : [Calculation_3372773926184079360] }  &lt;=10 and {FIXED [sf_user_id], [report_month] : [Calculation_3372773926184079360] }  &lt;= 5 THEN &apos;&lt;= 10&apos;&#10;ELSEIF {FIXED [sf_user_id], [report_month] : [Calculation_3372773926184079360] }  &gt; 10 and {FIXED [sf_user_id], [report_month] : [Calculation_3372773926184079360] }  &lt;= 20 THEN &apos;&gt; 10 &amp; &lt;= 20&apos;&#10;ELSE &apos;&gt; 20&apos;&#10;END' />
