      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_CD68AA2F2F1A46C89A7DA24375A858DA'>
            <properties context=''>
              <relation connection='bigquery.10t05791akr1vm19tmodx0jj8uz9' name='Custom SQL Query' type='text'><![CDATA[WITH users_monthly AS (
  SELECT
    users.report_date AS report_month,
    users.country,
    countries.global_entity_id,
    users.full_name_internal_non_pii,
    users.email_internal_non_pii,
    users.sf_user_id,
    users.central_job_role,
    users.title,
    users.job_role_vertical,
    users.user_type,
    users.account_age_snapshot,
    users.is_active_snapshot,
    users.is_contractor,
    targets.field_sales_headcount AS field_sales_headcount_target,
    targets.telesales_headcount AS telesales_headcount_target,
    targets.field_sales_productivity AS field_sales_productivity_target,
    targets.telesales_productivity AS telesales_productivity_target,
    targets.field_sales_acquisition AS field_sales_acquisition_target,
    targets.telesales_acquisition AS telesales_acquisition_target,
    new_targets.field_sales_headcount AS latest_field_sales_headcount_target , 
    new_targets.field_sales_acquisition AS latest_field_sales_acquisition_target, 
    new_targets.telesales_headcount AS latest_telesales_headcount_target,
    new_targets.telesales_acquisition AS latest_telesales_acquisition_target, 
    new_targets.ab_acquisition AS latest_ab_acquisition_target, 
    new_targets.dlp_threshold,
    new_targets.cd_acquisition,
    IF(underperformer.email_internal_non_pii IS NOT NULL, TRUE, FALSE) AS is_underperformer,
    underperformer.actions AS underperformer_action,
    underperformer.remarks AS underperformer_remarks,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
          ON users.country = countries.name
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_productivity_targets` targets
         ON users.report_date = targets.report_month
        AND countries.global_entity_id = targets.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.reional_apac_sales_pandora_productivity_targets` new_targets
         ON users.report_date = new_targets.report_month
        AND countries.global_entity_id = new_targets.global_entity_id       
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_underperformer_action` underperformer
         ON users.report_date = underperformer.report_month
        AND users.email_internal_non_pii = underperformer.email_internal_non_pii
  WHERE users.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 YEAR)
),

cpc AS (
  SELECT
  global_entity_id, 
  DATE(created_date) AS cpc_created_date,
  vendor_id,
  ROW_NUMBER() OVER (
      PARTITION BY vendor_id,
                   global_entity_id
      ORDER BY created_date DESC
    ) AS seq
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.ad_tech_il_cpc`
WHERE global_entity_id IN ("FO_NO", "FP_TW", "DJ_CZ", "FP_SG", "FP_TH", "FP_KH", "FP_LA", "FP_MM", "FP_MY", "FP_BD",
    "NP_HU", "MJM_AT", "YS_TR", "OP_SE", "PO_FI", "FP_PH", "FP_HK", "FP_PK")),

 first_cpc AS (
  SELECT 
  global_entity_id,
  cpc_created_date,
  vendor_id
 FROM cpc 
 WHERE seq =1 
 ),

 dt AS (SELECT 
created_date_local, 
lao.activation_date,
dt.global_entity_id, 
dt.country, 
dt.vendor_code, 
lao.sf_opportunity_id,
lao.global_vendor_id,
dt.order_uid, 
dt.is_targeted_deal,
ROW_NUMBER() OVER (PARTITION BY dt.vendor_code ORDER BY created_date_local ASC) AS earliest
FROM `fulfillment-dwh-production.pandata_report.commercial__vfd_orders`  AS dt
LEFT JOIN `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` AS lao
       ON dt.global_entity_id = lao.global_entity_id
       AND dt.vendor_code = lao.vendor_code
WHERE created_date_local BETWEEN lao.activation_date 
                             AND DATE_ADD(lao.activation_date, INTERVAL 30 DAY)
  AND lao.activation_date >>= DATE '2025-01-01'
AND is_targeted_deal),

first_dt AS (
SELECT 
global_entity_id,
vendor_code,
sf_opportunity_id,
global_vendor_id,
is_targeted_deal
FROM dt
WHERE earliest = 1),

joker AS (
SELECT 
created_date_local, 
lao.activation_date,
joker.global_entity_id, 
joker.country, 
joker.vendor_code, 
lao.sf_opportunity_id,
lao.global_vendor_id,
joker.order_uid, 
joker.is_joker_deal,
ROW_NUMBER() OVER (PARTITION BY joker.vendor_code ORDER BY created_date_local ASC) AS earliest
FROM `fulfillment-dwh-production.pandata_report.commercial__vfd_orders`  AS joker
LEFT JOIN `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` AS lao
       ON joker.global_entity_id = lao.global_entity_id
       AND joker.vendor_code = lao.vendor_code
WHERE created_date_local BETWEEN lao.activation_date 
                             AND DATE_ADD(lao.activation_date, INTERVAL 30 DAY)
  AND lao.activation_date >>= DATE '2025-01-01'
AND is_joker_deal),

first_joker AS (
SELECT 
global_entity_id,
vendor_code,
sf_opportunity_id,
global_vendor_id,
is_joker_deal
FROM joker
WHERE earliest = 1
),

regular_deals AS ( -- signup with VFD
SELECT 
  global_entity_id, 
  vendor_type, 
  user_type, 
  sf_opportunity_id, 
  regular_deal
FROM `fulfillment-dwh-production.pandata_report.regional_apac_apac_golive_signups_with_deals_vendor_level` 
),

mmt AS (
  -- discounts
    SELECT  
      d.uuid,
      d.global_entity_id,
      e.vendor_code,
      d.start_date_utc AS start_date,
      d.end_date_utc AS end_date
    FROM `fulfillment-dwh-production.pandata_curated.offers_discounts` AS d
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS e
            ON d.uuid = e.offers_discount_uuid
    WHERE d.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 16 MONTH), MONTH)
      AND NOT d.is_deleted
      AND d.foodpanda_ratio <<>> 100

    UNION ALL 

    -- vouchers
    SELECT
      v.uuid,
      v.global_entity_id,
      e.vendor_code,
      v.start_date_local AS start_date,
      v.stop_date_local AS end_date
    FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS v
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_voucher_vendor_entries` AS e
            ON v.uuid = e.offers_voucher_uuid
    WHERE v.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 16 MONTH), MONTH)
      AND NOT v.is_deleted
      AND v.foodpanda_ratio <<>> 100
),

mmt_first_deal_submission AS (
  SELECT global_entity_id,
  vendor_code,
  MIN(start_date) AS first_deal_submission_date
  FROM mmt
  GROUP BY ALL
),

lao_base AS (
  SELECT
  lao.global_entity_id,
  lao.country,
  lao.city,
  lao.sf_opportunity_id,
  lao.global_vendor_id,
  lao.first_qc_success_date_utc,
  lao.activation_date,
    first_cpc.cpc_created_date,
  DATE_DIFF(DATE(first_cpc.cpc_created_date), DATE(lao.activation_date), DAY) date_diff_cpc_activation,
    CASE 
    WHEN DATE_DIFF(DATE(first_cpc.cpc_created_date), DATE(lao.activation_date), DAY) BETWEEN 0 AND 2
    THEN TRUE  
    ELSE FALSE 
  END AS cpc_opportunity_flag,
  first_dt.is_targeted_deal,
  first_joker.is_joker_deal,
  regular_deals.regular_deal AS is_regular_deal_flag,
  lao.opportunity_business_type,
  lao.lead_source,
  lao.vertical_segment,
  lao.vendor_code,
  lao.vendor_type,
  lao.vendor_grade,
  lao.is_successful_signup,
  lao.is_won,
  lao.is_closed,
  lao.incubated_date_30_days,
  IF(lao.vendor_grade IN ("A","AA","AAA","B") AND lao.is_gtc_acquisition, TRUE, FALSE) AS is_prio_gtc_acquisition,
 --owner attributes
  lao.sf_opportunity_owner_id,
  mmt_first_deal_submission.first_deal_submission_date IS NOT NULL AS signup_with_mmt_vfd_deal
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` lao
LEFT JOIN first_cpc
       ON lao.global_entity_id = first_cpc.global_entity_id
      AND lao.vendor_code = first_cpc.vendor_id 
LEFT JOIN first_dt
       ON lao.global_entity_id = first_dt.global_entity_id
      AND lao.sf_opportunity_id = first_dt.sf_opportunity_id
LEFT JOIN first_joker
       ON lao.global_entity_id = first_joker.global_entity_id
      AND lao.sf_opportunity_id = first_joker.sf_opportunity_id     
LEFT JOIN regular_deals
       ON lao.global_entity_id = regular_deals.global_entity_id
      AND lao.sf_opportunity_id = regular_deals.sf_opportunity_id       
LEFT JOIN mmt_first_deal_submission
       ON lao.global_entity_id = mmt_first_deal_submission.global_entity_id
      AND lao.vendor_code = mmt_first_deal_submission.vendor_code        
WHERE lao.vendor_type = "Restaurants"
  AND vertical_segment != "caterers"
  AND opportunity_business_type != 'Upgrade/Upsell'
  AND (lao.activation_date  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 YEAR)
   OR first_qc_submission_date_utc  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 YEAR))

),

f30d_comms AS ( -- vendor level
  SELECT
    pd_orders.global_entity_id,
    pd_orders.vendor_code,
    -- comm revenue
    SUM(COALESCE(order_comms.invoiced_commission_eur, order_comms.estimated_commission_eur)) AS f30d_comms_rev_eur
  FROM lao_base
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
         ON lao_base.global_entity_id = pd_orders.global_entity_id
        AND lao_base.vendor_code = pd_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.order_commissions` AS order_comms
         ON pd_orders.uuid = order_comms.order_uuid
  WHERE pd_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 YEAR)
    AND NOT pd_orders.is_test_order
    AND pd_orders.is_valid_order
    AND pd_orders.created_date_utc << lao_base.incubated_date_30_days
  GROUP BY ALL
),

lao AS (
  SELECT
    lao_base.global_entity_id,
    lao_base.country,
    lao_base.city,
    lao_base.sf_opportunity_id,
    lao_base.first_qc_success_date_utc,
    lao_base.activation_date,
    lao_base.cpc_opportunity_flag,
    lao_base.is_targeted_deal,
    lao_base.is_joker_deal,
    lao_base.is_regular_deal_flag,
    lao_base.opportunity_business_type,
    lao_base.lead_source,
    lao_base.vertical_segment,
    lao_base.vendor_code,
    lao_base.vendor_type,
    lao_base.vendor_grade,
    lao_base.is_successful_signup,
    lao_base.is_won,
    lao_base.is_closed,
    lao_base.incubated_date_30_days,
    lao_base.is_prio_gtc_acquisition,
    lao_base.sf_opportunity_owner_id,
    CASE WHEN lao_base.country IN ('Hong Kong', 'Finland') AND lao_base.opportunity_business_type IN ('Legal Form Change', 'New Business', 'Owner Change', 'Win Back')
     THEN TRUE
     WHEN lao_base.country NOT IN ('Hong Kong', 'Finland') AND lao_base.opportunity_business_type IN ('New Business', 'Win Back')
    THEN TRUE
     ELSE FALSE
     END AS is_valid_business_type,
    -- comm revenue
    COALESCE(f30d_comms.f30d_comms_rev_eur, 0) AS f30d_comms_rev_eur,
    dlp.num_pre_act_menu_items,
    dlp.num_pre_act_menu_images,
    dlp.num_pre_act_menu_info,
    CASE 
    WHEN SAFE_DIVIDE(dlp.num_pre_act_menu_images, dlp.num_pre_act_menu_items) >>= 0.7 
    THEN sf_opportunity_id 
    ELSE NULL 
    END AS dlp_70_perc_opportunity_id,
        CASE 
    WHEN SAFE_DIVIDE(dlp.num_pre_act_menu_images, dlp.num_pre_act_menu_items) >>= 0.8 
    THEN sf_opportunity_id 
    ELSE NULL 
    END AS dlp_80_perc_opportunity_id,
    lao_base.signup_with_mmt_vfd_deal
  FROM lao_base
  LEFT JOIN f30d_comms
         ON lao_base.global_entity_id = f30d_comms.global_entity_id
        AND lao_base.vendor_code = f30d_comms.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_menu_items_images_agg` AS dlp
         ON lao_base.global_entity_id = dlp.global_entity_id
        AND lao_base.global_vendor_id = dlp.global_vendor_id      
  WHERE lao_base.vendor_type = "Restaurants"
    AND lao_base.vertical_segment != "caterers"
    AND lao_base.opportunity_business_type != 'Upgrade/Upsell'
    AND (lao_base.activation_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 YEAR)
    OR first_qc_success_date_utc  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 YEAR))
  GROUP BY ALL

),

activations AS (
  SELECT 
    DATE_TRUNC(activation_date, MONTH) AS activation_month,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    is_valid_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    cpc_opportunity_flag,
    is_targeted_deal,
    is_joker_deal,
    is_regular_deal_flag,
    signup_with_mmt_vfd_deal,
    COUNT(DISTINCT IF(is_valid_business_type, sf_opportunity_id, NULL)) AS num_activations,
    COUNT(DISTINCT IF(
    cpc_opportunity_flag = TRUE
    OR is_targeted_deal = TRUE
    OR is_joker_deal = TRUE,
    sf_opportunity_id,
    NULL
  )) AS ncr_products_count,
  COUNT(DISTINCT IF(is_regular_deal_flag = TRUE, sf_opportunity_id, NULL)) AS signup_with_deals_count,
  COUNT(DISTINCT IF(signup_with_mmt_vfd_deal = TRUE, sf_opportunity_id, NULL)) AS signup_with_deals_count_mmt,
    COALESCE(SUM(f30d_comms_rev_eur), 0) AS f30d_comms_revenue_eur,
    COALESCE(SUM(num_pre_act_menu_items), 0) AS num_pre_act_menu_items,
    COALESCE(SUM(num_pre_act_menu_images), 0) AS num_pre_act_menu_images,
    COALESCE(SUM(num_pre_act_menu_info), 0) AS num_pre_act_menu_info,
    COUNT(DISTINCT(dlp_70_perc_opportunity_id)) AS dlp_70_perc_opportunity_id,
    COUNT(DISTINCT(dlp_80_perc_opportunity_id)) AS dlp_80_perc_opportunity_id
  FROM lao
  WHERE is_won
  GROUP BY ALL
),

signings AS (
  SELECT 
    DATE_TRUNC(first_qc_success_date_utc, MONTH) AS signing_month,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    is_valid_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT IF(is_valid_business_type, sf_opportunity_id, NULL)) AS num_signings
  FROM lao
  WHERE is_successful_signup
  GROUP BY ALL
),

activations_and_signings AS (
  SELECT 
    COALESCE(signings.signing_month, activations.activation_month) AS report_month,
    COALESCE(signings.global_entity_id, activations.global_entity_id) AS global_entity_id,
    COALESCE(signings.country, activations.country) AS country,
    COALESCE(signings.city, activations.city) AS city,
    COALESCE(signings.opportunity_business_type, activations.opportunity_business_type) AS opportunity_business_type,
    COALESCE(signings.is_valid_business_type, activations.is_valid_business_type) AS is_valid_business_type,
    COALESCE(signings.sf_opportunity_owner_id, activations.sf_opportunity_owner_id) AS sf_opportunity_owner_id,
    COALESCE(signings.lead_source,activations.lead_source) AS lead_source,
    COALESCE(signings.vendor_type, activations.vendor_type) AS vendor_type,
    COALESCE(signings.vendor_grade, activations.vendor_grade) AS vendor_grade,
    COALESCE(signings.is_prio_gtc_acquisition, activations.is_prio_gtc_acquisition) AS is_prio_gtc_acquisition,
    cpc_opportunity_flag,
    is_targeted_deal,
    is_joker_deal,
    is_regular_deal_flag,
    activations.f30d_comms_revenue_eur,
    activations.ncr_products_count,
    activations.signup_with_deals_count,
    activations.num_pre_act_menu_items,
    activations.num_pre_act_menu_images,
    activations.num_pre_act_menu_info,
    activations.dlp_70_perc_opportunity_id,
    activations.dlp_80_perc_opportunity_id,
    COALESCE(signings.num_signings, 0) AS num_signings,
    COALESCE(activations.num_activations, 0) AS num_activations,
    activations.signup_with_mmt_vfd_deal,
     activations.signup_with_deals_count_mmt
  FROM signings
  FULL JOIN activations
         ON signings.signing_month = activations.activation_month
        AND signings.global_entity_id = activations.global_entity_id
        AND signings.city = activations.city
        AND signings.opportunity_business_type = activations.opportunity_business_type
        AND signings.sf_opportunity_owner_id = activations.sf_opportunity_owner_id
        AND signings.lead_source = activations.lead_source
        AND signings.vendor_grade = activations.vendor_grade
        AND signings.vendor_type = activations.vendor_type
        AND signings.is_prio_gtc_acquisition = activations.is_prio_gtc_acquisition
        AND signings.is_valid_business_type = activations.is_valid_business_type
)

SELECT 
  users_monthly.report_month,
  users_monthly.global_entity_id,
  users_monthly.country AS user_country,
  users_monthly.title,
  users_monthly.sf_user_id,
  users_monthly.full_name_internal_non_pii,
  users_monthly.email_internal_non_pii,
  users_monthly.user_type,
  users_monthly.central_job_role,
  users_monthly.job_role_vertical,
  users_monthly.account_age_snapshot,
  users_monthly.is_active_snapshot,
  users_monthly.is_contractor,
  CASE WHEN users_monthly.country = 'Hong Kong' 
        AND user_type = 'field rep' 
        AND LOWER(title) LIKE '%manager%' THEN 'BDM'
        WHEN users_monthly.country = 'Hong Kong' 
        AND user_type = 'field rep' 
        AND LOWER(title) LIKE '%executive%' THEN 'BDE'
        ELSE NULL
  END AS hk_user_type,
  users_monthly.field_sales_headcount_target,
  users_monthly.telesales_headcount_target,
  users_monthly.field_sales_productivity_target,
  users_monthly.telesales_productivity_target,
  users_monthly.field_sales_acquisition_target,
  users_monthly.telesales_acquisition_target,
  users_monthly.latest_field_sales_headcount_target , 
  users_monthly.latest_field_sales_acquisition_target, 
  users_monthly.latest_telesales_headcount_target,
  users_monthly.latest_telesales_acquisition_target, 
  users_monthly.latest_ab_acquisition_target,
  users_monthly.dlp_threshold,
  users_monthly.cd_acquisition, 
  users_monthly.is_underperformer,
  users_monthly.underperformer_action,
  users_monthly.underperformer_remarks,
  activations_and_signings.global_entity_id AS resto_global_entity_id,
  activations_and_signings.country AS resto_country,
  activations_and_signings.city AS resto_city,
  activations_and_signings.opportunity_business_type,
  activations_and_signings.is_valid_business_type,
  activations_and_signings.lead_source,
  activations_and_signings.vendor_type,
  activations_and_signings.vendor_grade,
  activations_and_signings.is_prio_gtc_acquisition,
  activations_and_signings.f30d_comms_revenue_eur,
  activations_and_signings.ncr_products_count,
  activations_and_signings.signup_with_deals_count,
  activations_and_signings.signup_with_deals_count_mmt,
  activations_and_signings.num_pre_act_menu_items,
  activations_and_signings.num_pre_act_menu_images,
  activations_and_signings.num_pre_act_menu_info,
  activations_and_signings.dlp_70_perc_opportunity_id,
  activations_and_signings.dlp_80_perc_opportunity_id,
  cpc_opportunity_flag,
  is_targeted_deal,
  is_joker_deal,
  is_regular_deal_flag,
  signup_with_mmt_vfd_deal,
  country_exception,
  high_low,
  ab_acquisition_per_rep,
  cd_acquisition_per_rep,
  COALESCE(activations_and_signings.num_activations, 0) AS num_activations,
  COALESCE(activations_and_signings.num_signings, 0) AS num_signings
FROM users_monthly
LEFT JOIN activations_and_signings
       ON users_monthly.report_month = activations_and_signings.report_month
      AND users_monthly.sf_user_id = activations_and_signings.sf_opportunity_owner_id
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_pandora_sales_reps_targets` AS rep_target
       ON users_monthly.report_month = rep_target.report_month
      AND users_monthly.sf_user_id = rep_target.user_id
      AND users_monthly.global_entity_id = rep_target.global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.1h52z2m10oih9w1bj9bux0wn52hv'>
      <datasources>
        <datasource caption='vendor level calculations [custom query]' name='federated.1h52z2m10oih9w1bj9bux0wn52hv' />
      </datasources>
      <datasource-dependencies datasource='federated.1h52z2m10oih9w1bj9bux0wn52hv'>
        <column caption='Entity' datatype='string' name='[Calculation_1838876046051983360]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [user_country]&#10;    WHEN &quot;Austria&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Czech Republic&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Finland&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Hungary&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Norway&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Sweden&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Thailand&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Turkey&quot; THEN &quot;Yemeksepeti&quot;&#10;    ELSE NULL&#10;END' />
        </column>
        <column caption='Account Age Bucket' datatype='string' name='[Calculation_2282128765470769154]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [account_age_snapshot] &lt;= 30 THEN &apos;0 - 1 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 30 AND [account_age_snapshot] &lt;= 60 THEN &apos;1 - 2 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 60 AND [account_age_snapshot] &lt;= 90 THEN &apos;2 - 3 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 90 AND [account_age_snapshot] &lt;= 180 THEN &apos;3 - 6 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 180 AND [account_age_snapshot] &lt;= 360 THEN &apos;6 - 12 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 360 THEN &apos;12+ month&apos;&#10;END' />
        </column>
        <column caption='Capital/Cities' datatype='string' name='[Calculation_280067605375016960]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [resto_city] IN (&apos;Dhaka&apos;, &apos;Phnom Penh&apos;, &apos;Vientiane Capital&apos;, &apos;Yangon&apos;, &apos;Kuala Lumpur&apos;, &apos;Manila&apos;, &apos;Karachi&apos;, &apos;Taipei&apos;, &apos;Bangkok&apos;)&#10;THEN &apos;Capital&apos;&#10;ELSE &apos;City&apos;&#10;END' />
        </column>
        <column caption='Activation Bucket' datatype='string' name='[Calculation_2966253693896777730]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Calculation_2966253693896478721] = 0 THEN &apos;0 Activations&apos;&#10;ELSEIF [Calculation_2966253693896478721] = 1 THEN &apos;1 Activation&apos;&#10;ELSE &apos;&gt;= 2 Activations&apos;&#10;END' />
        </column>
        <column caption='Account Age &gt; 60' datatype='boolean' name='[Calculation_754704814563266561]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[account_age_snapshot] &gt;= 60' />
        </column>
        <column aggregation='Sum' caption='Account Age Snapshot' datatype='integer' name='[account_age_snapshot]' role='dimension' type='ordinal' />
        <column caption='Is Contractor' datatype='boolean' name='[is_contractor]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1838876046051983360]' derivation='None' name='[none:Calculation_1838876046051983360:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_2282128765470769154]' derivation='None' name='[none:Calculation_2282128765470769154:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_280067605375016960]' derivation='None' name='[none:Calculation_280067605375016960:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_2966253693896777730]' derivation='None' name='[none:Calculation_2966253693896777730:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_754704814563266561]' derivation='None' name='[none:Calculation_754704814563266561:nk]' pivot='key' type='nominal' />
        <column-instance column='[account_age_snapshot]' derivation='None' name='[none:account_age_snapshot:ok]' pivot='key' type='ordinal' />
        <column-instance column='[is_contractor]' derivation='None' name='[none:is_contractor:nk]' pivot='key' type='nominal' />
        <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
        <column datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <filter class='categorical' column='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:Calculation_1838876046051983360:nk]'>
        <groupfilter function='level-members' level='[none:Calculation_1838876046051983360:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[federated.1h52z2m10oih9w1bj9bux0wn52hv].[none:Calculation_2282128765470769154:nk]'>
        <groupfilter function='level-members' level='[none:Calculation_2282128765470769154:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
