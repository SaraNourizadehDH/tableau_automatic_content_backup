    <worksheet name='[WIP total weight] Sales Rep Monthly Performance (4)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d50065' fontsize='12'>Underperformance Analysis: Activations vs. Targets: Field Rep Breakdown</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='9'>This metric set tracks underperformers by comparing total activations, A/B activations, targets, and the activation against target percentage to highlight performance gaps</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor level calculations [custom query]' name='federated.1h52z2m10oih9w1bj9bux0wn52hv' />
          </datasources>
          <datasource-dependencies datasource='federated.1h52z2m10oih9w1bj9bux0wn52hv'>
            <column caption='A/B acquisition Target Rep' datatype='real' name='[A/B acquisition Target (2025) (copy)_1557752899535630337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([ab_acquisition_per_rep]) = MAX([ab_acquisition_per_rep]) &#10;THEN SUM({INCLUDE [report_month],[user_country], [full_name_internal_non_pii]: MAX([ab_acquisition_per_rep])})&#10;ELSE SUM({INCLUDE [report_month],[user_country], [full_name_internal_non_pii]: MAX([ab_acquisition_per_rep])})&#10;END' />
            </column>
            <column caption='C/D Activations' datatype='integer' name='[AB activations (copy)_199917663598784512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_grade] = &apos;C&apos;  OR [vendor_grade] = &apos;D&apos;  THEN [num_activations] END)' />
            </column>
            <column caption='C/D acquisition Target Rep' datatype='real' name='[C/D acquisition Target (2025)  (copy)_1557752899536814082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([cd_acquisition_per_rep]) = MAX([cd_acquisition_per_rep]) &#10;THEN SUM({INCLUDE [report_month],[user_country], [full_name_internal_non_pii]: MAX([cd_acquisition_per_rep])})&#10;ELSE SUM({INCLUDE [report_month],[user_country], [full_name_internal_non_pii]: MAX([cd_acquisition_per_rep])})&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_1838876046051983360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [user_country]&#10;    WHEN &quot;Austria&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Czech Republic&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Finland&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Hungary&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Norway&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Sweden&quot; THEN &quot;Foodora&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Thailand&quot; THEN &quot;Foodpanda&quot;&#10;    WHEN &quot;Turkey&quot; THEN &quot;Yemeksepeti&quot;&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='dynamic dlp' datatype='integer' name='[Calculation_2204934265212780545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_month] &gt;= DATE(&quot;2025-08-01&quot;) THEN &#10;    [dlp_80_perc_opportunity_id]&#10;ELSE &#10;    [dlp_70_perc_opportunity_id]&#10;END' />
            </column>
            <column caption='Account Age Bucket' datatype='string' name='[Calculation_2282128765470769154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [account_age_snapshot] &lt;= 30 THEN &apos;0 - 1 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 30 AND [account_age_snapshot] &lt;= 60 THEN &apos;1 - 2 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 60 AND [account_age_snapshot] &lt;= 90 THEN &apos;2 - 3 month&apos;&#10;ELSEIF[account_age_snapshot] &gt; 90 AND [account_age_snapshot] &lt;= 180 THEN &apos;3 - 6 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 180 AND [account_age_snapshot] &lt;= 360 THEN &apos;6 - 12 month&apos;&#10;ELSEIF [account_age_snapshot] &gt; 360 THEN &apos;12+ month&apos;&#10;END' />
            </column>
            <column caption='Dynamic VFD' datatype='real' name='[Calculation_265149465760305155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([report_month]) &lt; DATE(&quot;2025-07-01&quot;) THEN [Calculation_3781053365120983042] ELSE [total LC1 (copy)_265149465759547393]END' />
            </column>
            <column caption='Capital/Cities' datatype='string' name='[Calculation_280067605375016960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [resto_city] IN (&apos;Dhaka&apos;, &apos;Phnom Penh&apos;, &apos;Vientiane Capital&apos;, &apos;Yangon&apos;, &apos;Kuala Lumpur&apos;, &apos;Manila&apos;, &apos;Karachi&apos;, &apos;Taipei&apos;, &apos;Bangkok&apos;)&#10;THEN &apos;Capital&apos;&#10;ELSE &apos;City&apos;&#10;END' />
            </column>
            <column caption='signup with deals%' datatype='real' name='[Calculation_2831497530901053440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([signup_with_deals_count_mmt])/SUM([num_activations])' />
            </column>
            <column caption='Activations per user' datatype='integer' name='[Calculation_2966253693896478721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sf_user_id],[user_country],[report_month] : SUM([num_activations])}' />
            </column>
            <column caption='Activation Bucket' datatype='string' name='[Calculation_2966253693896777730]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2966253693896478721] = 0 THEN &apos;0 Activations&apos;&#10;ELSEIF [Calculation_2966253693896478721] = 1 THEN &apos;1 Activation&apos;&#10;ELSE &apos;&gt;= 2 Activations&apos;&#10;END' />
            </column>
            <column caption='AB activations' datatype='integer' name='[Calculation_3638978910483243035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_3669941133120344064] = &apos;A/B&apos; THEN [num_activations] END)' />
            </column>
            <column caption='Vendor Grade ' datatype='string' name='[Calculation_3669941133120344064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_grade] IN (&apos;A&apos;,&apos;AA&apos;,&apos;AAA&apos;,&apos;B&apos;) THEN &apos;A/B&apos;&#10;ELSE [vendor_grade] END' />
            </column>
            <column caption='total LC1' datatype='real' name='[Calculation_3781053365120983042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([user_country]) = &quot;Philippines&quot; AND [Calculation_2831497530901053440] &gt;= 0.25 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Malaysia&quot; AND [Calculation_2831497530901053440] &gt;= 0.35 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Taiwan&quot; AND [Calculation_2831497530901053440] &gt;= 0.3 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Hong Kong&quot; AND [Calculation_2831497530901053440] &gt;= 0.5 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Singapore&quot; AND [Calculation_2831497530901053440] &gt;= 0.5 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Pakistan&quot; AND [Calculation_2831497530901053440] &gt;= 0.5 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Bangladesh&quot; AND [Calculation_2831497530901053440] &gt;= 0.3 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF (ATTR([user_country]) = &quot;Cambodia&quot; &#10;        OR ATTR([user_country]) = &quot;Laos&quot; &#10;        OR ATTR([user_country]) = &quot;Myanmar&quot;) &#10;       AND [Calculation_2831497530901053440] &gt;= 0.3 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF (ATTR([user_country]) = &quot;Hungary&quot; &#10;        OR ATTR([user_country]) = &quot;Sweden&quot; &#10;        OR ATTR([user_country]) = &quot;Austria&quot; &#10;        OR ATTR([user_country]) = &quot;Norway&quot; &#10;        OR ATTR([user_country]) = &quot;Czech Republic&quot;) &#10;       AND [Calculation_2831497530901053440] &gt;= 0.5 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Finland&quot; AND [Calculation_2831497530901053440] &gt;= 0.35 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSE&#10;    0&#10;END' />
            </column>
            <column caption='DLP' datatype='real' name='[Calculation_4847562107920453634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2204934265212780545])/SUM([num_activations])' />
            </column>
            <column caption='Treshold DLP %' datatype='real' name='[Calculation_4847562107924811779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([user_country]) = &quot;Taiwan&quot;&#10; OR ATTR([user_country]) = &quot;Bangladesh&quot;&#10; OR ATTR([user_country]) = &quot;Norway&quot;&#10; OR ATTR([user_country]) = &quot;Finland&quot; THEN&#10;    0&#10;ELSEIF ATTR([user_country]) = &quot;Sweden&quot; THEN&#10;    IF [Calculation_4847562107920453634] &gt;= 0.5 THEN [Calculation_4847562107920453634] ELSE NULL END&#10;&#10;ELSEIF ATTR([user_country]) = &quot;Austria&quot; THEN&#10;    IF ATTR([report_month]) &gt;= DATE(&quot;2025-08-01&quot;) THEN&#10;        IF [Calculation_4847562107920453634] &gt;= 0.8 THEN [Calculation_4847562107920453634] ELSE NULL END&#10;    ELSE&#10;        IF [Calculation_4847562107920453634] &gt;= 0.5 THEN [Calculation_4847562107920453634] ELSE NULL END&#10;  END&#10;&#10;ELSE&#10;    IF ATTR([report_month]) &gt;= DATE(&quot;2025-08-01&quot;) THEN&#10;        IF [Calculation_4847562107920453634] &gt;= 0.8 THEN [Calculation_4847562107920453634] ELSE NULL END&#10;    ELSE&#10;        IF [Calculation_4847562107920453634] &gt;= 0.7 THEN [Calculation_4847562107920453634] ELSE NULL END&#10;    END&#10;END' />
            </column>
            <column caption='NCR activations%' datatype='real' name='[Calculation_4858891476052725760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ncr_products_count)/SUM([num_activations])' />
            </column>
            <column caption='NCR weight' datatype='real' name='[Calculation_4858891476053049345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([user_country]) = &quot;Philippines&quot; AND [Calculation_4858891476052725760] &gt;= 0.1 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF ATTR([user_country]) = &quot;Malaysia&quot; AND [Calculation_4858891476052725760] &gt;= 0.35 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF ATTR([user_country]) = &quot;Taiwan&quot; AND [Calculation_4858891476052725760] &gt;= 0.3 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF ATTR([user_country]) = &quot;Hong Kong&quot; AND [Calculation_4858891476052725760] &gt;= 0.5 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF ATTR([user_country]) = &quot;Singapore&quot; AND [Calculation_4858891476052725760] &gt;= 0.25 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF ATTR([user_country]) = &quot;Pakistan&quot; AND [Calculation_4858891476052725760] &gt;= 0.5 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF ATTR([user_country]) = &quot;Bangladesh&quot; AND [Calculation_4858891476052725760] &gt;= 0.3 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF (ATTR([user_country]) = &quot;Cambodia&quot;&#10;        OR ATTR([user_country]) = &quot;Laos&quot;&#10;        OR ATTR([user_country]) = &quot;Myanmar&quot;) AND [Calculation_4858891476052725760] &gt;= 0.3 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF (ATTR([user_country]) = &quot;Hungary&quot;&#10;        OR ATTR([user_country]) = &quot;Sweden&quot;&#10;        OR ATTR([user_country]) = &quot;Austria&quot;&#10;        OR ATTR([user_country]) = &quot;Norway&quot;&#10;        OR ATTR([user_country]) = &quot;Czech Republic&quot;) AND [Calculation_4858891476052725760] &gt;= 0.5 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSEIF ATTR([user_country]) = &quot;Finland&quot; AND [Calculation_4858891476052725760] &gt;= 0.35 THEN&#10;    [Calculation_4858891476052725760] * MIN([lc1 max weight   (copy)_3781053365123088387])&#10;ELSE&#10;    0&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_6151354201471725568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [user_country]&#10;    WHEN &quot;Austria&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; THEN &quot;Turkey&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Thailand&quot; THEN &quot;APAC&quot;&#10;    ELSE &quot;Other&quot;&#10;END' />
