        <calculation class='tableau' formula='IF ATTR([user_country]) = &quot;Philippines&quot; AND [Calculation_2831497530901053440] &gt;= 0.4 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Malaysia&quot; AND [Calculation_2831497530901053440] &gt;= 0.4 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Taiwan&quot; AND [Calculation_2831497530901053440] &gt;= 0.3 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Hong Kong&quot; AND [Calculation_2831497530901053440] &gt;= 0.4 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Singapore&quot; AND [Calculation_2831497530901053440] &gt;= 0.4 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Pakistan&quot; AND [Calculation_2831497530901053440] &gt;= 0.25 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Bangladesh&quot; AND [Calculation_2831497530901053440] &gt;= 0.3 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF (ATTR([user_country]) = &quot;Cambodia&quot; &#10;        OR ATTR([user_country]) = &quot;Laos&quot; &#10;        OR ATTR([user_country]) = &quot;Myanmar&quot;) &#10;       AND [Calculation_2831497530901053440] &gt;= 0.4 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF (ATTR([user_country]) = &quot;Hungary&quot; &#10;        OR ATTR([user_country]) = &quot;Sweden&quot; &#10;        OR ATTR([user_country]) = &quot;Austria&quot; &#10;        OR ATTR([user_country]) = &quot;Norway&quot; &#10;        OR ATTR([user_country]) = &quot;Czech Republic&quot;) &#10;       AND [Calculation_2831497530901053440] &gt;= 0.4 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSEIF ATTR([user_country]) = &quot;Finland&quot; AND [Calculation_2831497530901053440] &gt;= 0.4 THEN &#10;    [Calculation_2831497530901053440] * MIN([dlp max weight  (copy)_3781053365120417793])&#10;ELSE&#10;    0&#10;END' />
