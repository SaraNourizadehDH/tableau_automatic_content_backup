        <calculation class='tableau' formula='CASE [user_country]&#10;WHEN &quot;Philippines&quot; THEN 0.10&#10;WHEN &quot;Thailand&quot; THEN 0.2&#10;WHEN &quot;Malaysia&quot; THEN 0.1&#10;WHEN &quot;Taiwan&quot; THEN 0.256&#10;WHEN &quot;Hong Kong&quot; THEN 0.14&#10;WHEN &quot;Singapore&quot; THEN 0.1&#10;WHEN &quot;Pakistan&quot; THEN 0.067&#10;WHEN &quot;Bangladesh&quot; THEN 0.167&#10;WHEN &quot;Cambodia&quot; THEN 0.13&#10;WHEN &quot;Laos&quot; THEN 0.2&#10;WHEN &quot;Myanmar&quot; THEN 0.25&#10;WHEN &quot;Hungary&quot; THEN 0.10&#10;WHEN &quot;Sweden&quot; THEN 0.125&#10;WHEN &quot;Austria&quot; THEN 0.193&#10;WHEN &quot;Norway&quot; THEN 0.375&#10;WHEN &quot;Czech Republic&quot; THEN 0.25&#10;WHEN &quot;Finland&quot; THEN 0.26&#10;WHEN &quot;Turkey&quot; THEN 0&#10;END' />
