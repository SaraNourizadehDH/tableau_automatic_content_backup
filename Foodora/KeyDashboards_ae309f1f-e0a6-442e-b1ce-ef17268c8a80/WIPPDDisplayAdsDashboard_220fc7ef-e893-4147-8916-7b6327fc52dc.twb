    <worksheet name='Campaign Level'>
      <table>
        <view>
          <datasources>
            <datasource caption='commercial__display_ads_dashboard_campaign_level' name='federated.1hkcybr04gynyc112sow50lzoy98' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='No' caption='Custom Date Range' datatype='string' name='[Daily Metric Selection (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
              <aliases>
                <alias key='&quot;No&quot;' value='No' />
                <alias key='&quot;Yes&quot;' value='Yes' />
              </aliases>
            </column>
            <column alias='Euro' caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;eur&quot;'>
              <calculation class='tableau' formula='&quot;eur&quot;' />
              <aliases>
                <alias key='&quot;eur&quot;' value='Euro' />
                <alias key='&quot;local&quot;' value='Local' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hkcybr04gynyc112sow50lzoy98'>
            <column caption='Impressions Utilized' datatype='integer' name='[Budget Spent (LOD) (copy)_4602256617305448449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id], [campaign_year_month]: SUM([total_impressions])}' />
            </column>
            <column caption='Budget Spent' datatype='real' name='[Budget Spent (copy)_4602256617300418560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1454592360515084288])/1000' />
            </column>
            <column caption='Deafult Date Filter (3M)' datatype='boolean' name='[Calculation_1389360518629515266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Daily Metric Selection (copy)] = &apos;No&apos; THEN&#13;&#10;    [campaign_year_month] &gt;= DATEADD(&apos;month&apos;, -3, DATETRUNC(&apos;month&apos;, {MAX([campaign_year_month])}))&#13;&#10;    AND [campaign_year_month] &lt;= DATETRUNC(&apos;month&apos;, {MAX([campaign_year_month])})&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
            </column>
            <column caption='Show Date Range' datatype='boolean' name='[Calculation_1389360518630326275]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Daily Metric Selection (copy)] = &apos;Yes&apos;' />
