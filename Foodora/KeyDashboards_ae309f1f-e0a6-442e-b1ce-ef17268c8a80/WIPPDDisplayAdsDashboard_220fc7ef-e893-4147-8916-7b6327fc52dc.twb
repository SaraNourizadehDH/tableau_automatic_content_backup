      <table>
        <view>
          <datasources>
            <datasource caption='commercial__display_ads_dashboard_daily_metrics' name='federated.096ex5m03agye31a3mhf21152vg1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Euro' caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;eur&quot;'>
              <calculation class='tableau' formula='&quot;eur&quot;' />
              <aliases>
                <alias key='&quot;eur&quot;' value='Euro' />
                <alias key='&quot;local&quot;' value='Local' />
              </aliases>
            </column>
            <column alias='Daily Revenue' caption='Daily Metric Selection' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;daily_revenue&quot;'>
              <calculation class='tableau' formula='&quot;daily_revenue&quot;' />
              <aliases>
                <alias key='&quot;daily_allocated_budget&quot;' value='Daily Allocated Budget' />
                <alias key='&quot;daily_revenue&quot;' value='Daily Revenue' />
                <alias key='&quot;total_impressions&quot;' value='Daily Billable Impressions' />
              </aliases>
            </column>
            <column alias='Daily Revenue / Daily Allocated Budget' caption='Bottom Metric Selection' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;daily_revenue/daily_allocated_budget&quot;'>
              <calculation class='tableau' formula='&quot;daily_revenue/daily_allocated_budget&quot;' />
              <aliases>
                <alias key='&quot;allocated_impressions/total_requests&quot;' value='Allocated Impressions / Total Ad Requests' />
                <alias key='&quot;daily_revenue/daily_allocated_budget&quot;' value='Daily Revenue / Daily Allocated Budget' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.096ex5m03agye31a3mhf21152vg1'>
            <column caption='Bottom Line Graph' datatype='real' default-format='p0.00%' name='[Bottom Bar Chart (copy)_4905616271665491970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;allocated_impressions/total_requests&quot; THEN [Calculation_2818197843694313478]&#10;WHEN &quot;daily_revenue/daily_allocated_budget&quot; THEN SUM([daily_display_ads_revenue_local])/SUM([daily_allocated_budget_local])&#10;END' />
            </column>
            <column caption='Bid' datatype='real' name='[Calculation_1475491858722582535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;local&quot; THEN [bid_local]&#13;&#10;    WHEN &quot;eur&quot; THEN [bid_eur]&#13;&#10;END' />
            </column>
            <column caption='Budget' datatype='real' name='[Calculation_1475491858722750472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;local&quot; THEN [Calculation_1475491858723594250]&#13;&#10;    WHEN &quot;eur&quot; THEN [Calculation_1475491858723319817]&#13;&#10;END' />
            </column>
            <column caption='Budget Eur LOD' datatype='real' name='[Calculation_1475491858723319817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id], [report_date] : MAX([budget_eur])}/1000' />
            </column>
            <column caption='Budget Local LOD' datatype='real' name='[Calculation_1475491858723594250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id], [report_date] : MAX([budget_local])}/1000' />
            </column>
            <column caption='Daily Revenue' datatype='real' name='[Calculation_2818197843684450305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;local&quot; THEN [daily_display_ads_revenue_local]&#10;WHEN &quot;eur&quot; THEN [daily_display_ads_revenue_eur] END' />
            </column>
            <column caption='Daily Metric Selection' datatype='real' name='[Calculation_2818197843685179396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;daily_allocated_budget&quot; THEN [Daily Revenue (copy)_2818197843684827138]&#10;WHEN &quot;daily_revenue&quot; THEN [Calculation_2818197843684450305]&#10;WHEN &quot;total_impressions&quot; THEN [daily_impressions_recieved]&#10;END' />
            </column>
            <column caption='Is Weekend' datatype='string' name='[Calculation_2818197843691884549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [report_date]) IN (1, 7) THEN &apos;Weekend&apos;&#13;&#10;ELSE &apos;Weekday&apos;&#13;&#10;END' />
            </column>
            <column caption='Daily Allocated Impressions / Daily Ad Requests' datatype='real' name='[Calculation_2818197843694313478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_allocated_impressions])&#10;/&#10;SUM([daily_ad_requests])' />
            </column>
            <column caption='Bottom Bar Chart' datatype='real' name='[Calculation_4905616271665123329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;allocated_impressions/total_requests&quot; THEN SUM([daily_ad_requests])&#10;WHEN &quot;daily_revenue/daily_allocated_budget&quot; THEN SUM([Daily Revenue (copy)_2818197843684827138])&#10;END' />
            </column>
            <column caption='Not today' datatype='boolean' name='[Calculation_4905616271666917379]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] != TODAY()' />
            </column>
