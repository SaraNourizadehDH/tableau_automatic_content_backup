              <calculation class='tableau' formula='&quot;Refreshed: &quot; + &#13;&#10;IF ISNULL([refresh_datetime]) THEN &quot;No Data&quot; &#13;&#10;ELSE DATENAME(&apos;month&apos;, [refresh_datetime]) + &quot; &quot; + &#13;&#10;     STR(DAY([refresh_datetime])) + &quot;, &quot; + &#13;&#10;     STR(YEAR([refresh_datetime])) + &quot; &quot; + &#13;&#10;     RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [refresh_datetime])), 2) + &quot;:&quot; + &#13;&#10;     RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [refresh_datetime])), 2) + &quot; &quot; + &#13;&#10;     IF DATEPART(&apos;hour&apos;, [refresh_datetime]) &gt;= 12 THEN &quot;PM&quot; ELSE &quot;AM&quot; END &#13;&#10;END' />
            </column>
