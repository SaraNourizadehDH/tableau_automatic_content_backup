      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hkcybr04gynyc112sow50lzoy98].[max:Calculation_1454592360515391489:qk]&quot;' value='CPM' />
          <alias key='&quot;[federated.1hkcybr04gynyc112sow50lzoy98].[sum:Calculation_1454592360515489794:qk]&quot;' value='Final Budget' />
          <alias key='&quot;[federated.1hkcybr04gynyc112sow50lzoy98].[sum:gfv_local:qk]&quot;' value='GFV Local' />
        </aliases>
      </column>
      <column caption='Impressions Utilized' datatype='integer' name='[Budget Spent (LOD) (copy)_4602256617305448449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id], [campaign_year_month]: SUM([total_impressions])}' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Budget Spent (LOD) (copy)_4602256617306066947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id], [campaign_year_month]: SUM([orders])}' />
      </column>
      <column caption='Budget Spent' datatype='real' name='[Budget Spent (copy)_4602256617300418560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1454592360515084288])/1000' />
      </column>
      <column caption='Max Start Date' datatype='date' name='[Calculation_1008524865792819205]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([start_date])' />
      </column>
      <column caption='Max End Date' datatype='date' name='[Calculation_1008524865792892934]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([end_date])' />
      </column>
      <column caption='Deafult Date Filter (3M)' datatype='boolean' name='[Calculation_1389360518629515266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Daily Metric Selection (copy)] = &apos;No&apos; THEN&#13;&#10;    [campaign_year_month] &gt;= DATEADD(&apos;month&apos;, -3, DATETRUNC(&apos;month&apos;, {MAX([campaign_year_month])}))&#13;&#10;    AND [campaign_year_month] &lt;= DATETRUNC(&apos;month&apos;, {MAX([campaign_year_month])})&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
      </column>
      <column caption='Show Date Range' datatype='boolean' name='[Calculation_1389360518630326275]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Daily Metric Selection (copy)] = &apos;Yes&apos;' />
      </column>
      <column caption='Gfv Local Currency' datatype='real' hidden='true' name='[Calculation_1389360518817648645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id], [campaign_year_month]: SUM([gfv_local])}' />
      </column>
      <column caption='Budget Spent Currency' datatype='real' hidden='true' name='[Calculation_1454592360515084288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &quot;local&quot; THEN [revenue_local]&#10;WHEN &quot;eur&quot; THEN [revenue_eur]&#10;END' />
      </column>
      <column caption='Bid' datatype='real' name='[Calculation_1454592360515391489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;local&quot; THEN [bid_local]&#10;WHEN &quot;eur&quot; THEN [bid_eur]&#10;END' />
      </column>
      <column caption='Budget Currency' datatype='real' hidden='true' name='[Calculation_1454592360515489794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;local&quot; THEN [final_monthly_budget_local]&#10;WHEN &quot;eur&quot; THEN [final_monthly_budget_eur]&#10;END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1475491858687938561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;local&quot; THEN [Calculation_1389360518817648645]&#13;&#10;WHEN &quot;eur&quot; THEN [GFV Local Currency (copy)_1475491858686390272]&#13;&#10;END' />
      </column>
      <column caption='Refresh Time' datatype='string' name='[Calculation_1475491858736070667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Refreshed: &quot; + &#13;&#10;IF ISNULL([refresh_datetime]) THEN &quot;No Data&quot; &#13;&#10;ELSE DATENAME(&apos;month&apos;, [refresh_datetime]) + &quot; &quot; + &#13;&#10;     STR(DAY([refresh_datetime])) + &quot;, &quot; + &#13;&#10;     STR(YEAR([refresh_datetime])) + &quot; &quot; + &#13;&#10;     RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [refresh_datetime])), 2) + &quot;:&quot; + &#13;&#10;     RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [refresh_datetime])), 2) + &quot; &quot; + &#13;&#10;     IF DATEPART(&apos;hour&apos;, [refresh_datetime]) &gt;= 12 THEN &quot;PM&quot; ELSE &quot;AM&quot; END &#13;&#10;END' />
      </column>
      <column caption='Impressions Utilzed%' datatype='real' default-format='p0.00%' name='[Calculation_2177631205132996609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_impressions]) / [Calculation_4922152971973529600]' />
      </column>
      <column caption='Budget Booked' datatype='real' name='[Calculation_2454602584071569408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id], [campaign_year_month]: MAX([Calculation_1454592360515489794])}/1000' />
      </column>
      <column caption='Total Chains' datatype='integer' hidden='true' name='[Calculation_2643613037660536832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([advertiser_name])' />
      </column>
      <column caption='Budget Spent%' datatype='real' default-format='p0.00%' name='[Calculation_2643613037660733441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Budget Spent (copy)_4602256617300418560]&#10;/&#10;SUM([Calculation_2454602584071569408])' />
      </column>
      <column caption='Duration' datatype='integer' name='[Calculation_4139159906554720256]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&quot;day&quot;,[start_date],[end_date])' />
