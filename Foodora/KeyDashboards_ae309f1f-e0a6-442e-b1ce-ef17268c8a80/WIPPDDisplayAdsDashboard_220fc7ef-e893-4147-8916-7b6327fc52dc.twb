      <aliases enabled='yes' />
      <column caption='Avg. Daily GFV' datatype='real' name='[Avg. Daily Orders (copy)_1808617520484065282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_local])/COUNTD([created_date_local])' />
      </column>
      <column caption='Avg. Shop Menu Loads' datatype='real' name='[Avg. Daily Orders (copy)_1808617520493690885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shop_menu_load])/COUNTD([created_date_local])' />
      </column>
      <column caption='Avg. New Customers' datatype='real' name='[Avg. Shop Menu Loads (copy)_2818197843697651719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_new_customer_orders])/COUNTD([created_date_local])' />
      </column>
      <column caption='Campaign Period' datatype='string' name='[Calculation_1229764207389831168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pre_campaign_active] = TRUE THEN &quot;Pre-Campaign&quot;&#13;&#10;ELSEIF [display_campaign_active] = TRUE THEN &quot;During Campaign&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Measure Selection' datatype='real' name='[Calculation_1808617520474750976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;gfv&quot; THEN [Avg. Daily Orders (copy)_1808617520484065282]&#10;WHEN &quot;total_orders&quot; THEN [Calculation_1808617520483655681]&#10;WHEN &quot;shop_loads&quot; THEN [Avg. Daily Orders (copy)_1808617520493690885]&#10;END' />
      </column>
      <column caption='Avg. Daily Orders' datatype='real' name='[Calculation_1808617520483655681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders])/COUNTD([created_date_local])' />
      </column>
      <column caption='MIN(1)' datatype='integer' name='[Calculation_1808617520484327427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Campaign Start Month' datatype='string' name='[Calculation_4905616271253807104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&quot;month&quot;, DATETRUNC(&quot;month&quot;, [start_date])) + &quot;, &quot; + STR(YEAR(DATETRUNC(&quot;month&quot;, [start_date])))' />
      </column>
