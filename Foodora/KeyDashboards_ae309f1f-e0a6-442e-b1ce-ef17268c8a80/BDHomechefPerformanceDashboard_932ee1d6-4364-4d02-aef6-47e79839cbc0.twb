      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='NCR' id='_28509A68177442708C6512C6E98CF58F'>
            <properties context=''>
              <relation connection='bigquery.0zhc1k50a5owb815bhp9y15nrzyd' name='ncr' type='text'>WITH organic_placement AS(
  with A as(
  SELECT * 
  from `fulfillment-dwh-production.pandata_report.country_BD_cpc_info`
  WHERE datelive&gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH)
)    
SELECT 
  yearmonth_live,
  vendor_code,
  SUM(cpc_rev_local) as organic_placement_local,
  SUM(cpc_rev_eur) as organic_placement_eur,
FROM A
GROUP BY 1,2
order by 1,2
),

-- premium_placements AS(
--   WITH A AS(
--   SELECT * 
--   FROM `fulfillment-dwh-production.pandata_report.country_BD_cpp_info`
--   WHERE month_booked &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH)
-- )    
-- SELECT
--   CAST(year_month AS STRING) AS year_month,
--   vendor_code,
--   sum(sold_price_local_PL) as sold_price_local,
--   sum(sold_price_eur) as sold_price_eur,
-- FROM A
-- group by 1,2
-- order by 1,2
-- ),

pandabox_fee AS(
  with A as(
  SELECT * 
  FROM `fulfillment-dwh-production.pandata_report.country_BD_pandabox_info`
  WHERE yearmonth_live&gt;&gt;=DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH)
)    
SELECT
  CAST(year_month AS STRING) AS year_month,
  vendor_code,
  SUM(pb_rev_local) as joker_fee_amount_local,
  SUM(pb_rev_eur) as joker_fee_amount_eur,
FROM A
group by 1,2
order by 1,2  
),

month AS(
  SELECT DISTINCT 
    FORMAT_DATETIME(&quot;%Y%m&quot;, DATETIME(date)) AS month_year,
    FORMAT_DATETIME(&quot;%b-%y&quot;, DATETIME(date)) AS month_name,
  FROM `fulfillment-dwh-production.pandata_curated.shared_dates`
  WHERE
    date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH) AND DATE_ADD(CURRENT_DATE(), INTERVAL 3 MONTH) ),

month_ranking AS(
  SELECT
    DISTINCT month.*,
    ROW_NUMBER() OVER(ORDER BY month.month_year ASC) AS rank
  FROM
month ),

vendor_with_month_city_info AS(
  SELECT
    v.vendor_code,
    v.vendor_name,
    v.chain_code,
    v.chain_name,
    v.cluster_name,
    v.city_name,
    v.business_type_apac AS business_type,
    v.primary_zone_name,
    v.lg_city_name AS lg_city_name,
    city_name AS final_city_name,
    city_tag,
    sf_account_owner_name,
    account_type,
    wxyz_class,
    is_home_based_kitchen,
    month_ranking.month_year,
    month_ranking.month_name,
    month_ranking.rank
  FROM `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS v
  CROSS JOIN
    month_ranking
  WHERE month_ranking.rank &gt;&gt;= 1 
  AND is_home_based_kitchen=true)    

SELECT
    &quot;FP_BD&quot; AS global_entity_id,
  &apos;Bangladesh&apos; AS country,
  vendor_with_month_city_info.*,
  organic_placement.organic_placement_eur,
  organic_placement.organic_placement_local,
  -- premium_placements.sold_price_eur,
  -- premium_placements.sold_price_local,
  pandabox_fee.joker_fee_amount_eur,
  pandabox_fee.joker_fee_amount_local,
  (IFNULL(organic_placement.organic_placement_eur,
      0)+IFNULL(pandabox_fee.joker_fee_amount_eur,
      0)) AS total_ncr_eur,
  (IFNULL(organic_placement.organic_placement_local,
      0)+IFNULL(pandabox_fee.joker_fee_amount_local,
      0)) AS total_ncr_local
FROM vendor_with_month_city_info
LEFT JOIN organic_placement
       ON vendor_with_month_city_info.vendor_code = organic_placement.vendor_code
      AND vendor_with_month_city_info.month_year = organic_placement.yearmonth_live
-- LEFT JOIN premium_placements
--        ON vendor_with_month_city_info.vendor_code = premium_placements.vendor_code
--       AND vendor_with_month_city_info.month_year = premium_placements.year_month
LEFT JOIN pandabox_fee
       ON vendor_with_month_city_info.vendor_code = pandabox_fee.vendor_code
      AND vendor_with_month_city_info.month_year= pandabox_fee.year_month
WHERE
  (IFNULL(organic_placement.organic_placement_eur,
      0)+IFNULL(pandabox_fee.joker_fee_amount_eur,
      0)) &gt;&gt; 0
    and vendor_with_month_city_info.is_home_based_kitchen</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
