          </datasources>
          <datasource-dependencies datasource='federated.0r5nw211srmwhw12q4qfk1dym5bo'>
            <column caption='is Incubation' datatype='string' name='[Calculation_616430261163806720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [date]&gt;= [pd_activation_date_local] and [date]&lt;=DATEADD(&apos;day&apos;,30,[pd_activation_date_local]) then &quot;In Incubation&quot; else &quot;regular&quot; end' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[pd_activation_date_local]' derivation='Month' name='[mn:pd_activation_date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[wxyz_class]' derivation='None' name='[none:wxyz_class:nk]' pivot='key' type='nominal' />
            <column caption='pd activation date local' datatype='date' name='[pd_activation_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[sf_activated_date]' derivation='Quarter' name='[qr:sf_activated_date:ok]' pivot='key' type='ordinal' />
            <column datatype='date' name='[sf_activated_date]' role='dimension' type='ordinal' />
