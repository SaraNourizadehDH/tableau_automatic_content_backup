              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Daily&quot; THEN [date (copy)_1804254621867118593]&#13;&#10;WHEN &quot;Weekly&quot; THEN [week]&#13;&#10;WHEN &quot;Monthly&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Order / Day' datatype='real' name='[Calculation_1804254621882499090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867003904]/COUNTD([order_date])' />
            </column>
            <column caption='Order / Day / Vendor' datatype='real' name='[Calculation_1804254621882671123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867003904]/COUNTD([order_date])/COUNTD(IF [valid_orders] &gt; 0 THEN [Vendor_code] END)' />
            </column>
            <column caption='Order per Vendor' datatype='real' name='[Calculation_214483996063076353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867003904]/COUNTD([Vendor_code])' />
            </column>
            <column caption='FP funded subsidy/GMV%' datatype='real' name='[Calculation_718605674711842816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([discount_fp],0))+SUM(IFNULL([voucher_fp],0)))/[Calculation_1804254621867560962]' />
            </column>
            <column caption='Burn per order' datatype='real' name='[Calculation_718605674728833025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([discount_fp])+SUM([voucher_fp]))/SUM([valid_orders])' />
            </column>
            <column caption='ECR' datatype='real' name='[Calculation_718605674730467330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_amount])/SUM([gfv_combined])' />
            </column>
            <column caption='DLP %' datatype='real' name='[Calculation_883268538156867585]' role='measure' type='quantitative'>
