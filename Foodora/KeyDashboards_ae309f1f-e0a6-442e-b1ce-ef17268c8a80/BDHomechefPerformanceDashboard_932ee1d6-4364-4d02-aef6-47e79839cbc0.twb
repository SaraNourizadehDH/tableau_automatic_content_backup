            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0r5nw211srmwhw12q4qfk1dym5bo].[Action (YEAR(pd activation date local),MONTH(pd activation date local))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action3_B740D122A2364069B00A84153DEE9724]' user:ui-enumeration='all' user:ui-marker='enumerate'>
