    <datasource caption='Home chef NCR' inline='true' name='federated.1yvym7v18aayuu1eil3ek1ocyopl' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0zhc1k50a5owb815bhp9y15nrzyd'>
            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='foodpanda-bd-bigquery' schema='pandata_bd_commerical' server-oauth='' username='ateeq.ur@foodpanda.com.bd' workgroup-auth-mode='prompt' />
