      <column caption='AFV (EUR)' datatype='real' name='[AFV (copy)_974747847697211394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GFV (copy)_974747847696609280]/[Calculation_1804254621867003904]' />
      </column>
      <column datatype='integer' hidden='true' name='[Active_products_menu_category_count]' role='measure' type='quantitative' />
      <column caption='Measure KPI Value' datatype='real' name='[Calculation_1180224598852431873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;GMV&quot; THEN [Calculation_1804254621867560962]&#13;&#10;WHEN &quot;GFV&quot; THEN [Calculation_1804254621867958275]&#13;&#10;WHEN &quot;AFV&quot; THEN [Calculation_1804254621877022725]&#13;&#10;WHEN &quot;Food Rating&quot; THEN [Calculation_1804254621881004046]&#13;&#10;WHEN &quot;Packaging Rating&quot; THEN [Calculation_1804254621881360399]&#13;&#10;WHEN &quot;DT&quot; THEN [Calculation_1804254621880475661]&#13;&#10;WHEN &quot;Prep Time&quot; THEN [Calculation_1804254621879910411]&#13;&#10;WHEN &quot;Vendor Late&quot; THEN [Calculation_1804254621880164364]&#13;&#10;WHEN &quot;Vendor Offline Hour %&quot; THEN [Calculation_1572319241422651392]*100&#13;&#10;WHEN &quot;Vendor Cancellation %&quot; THEN [Calculation_1804254621879578634]*100&#13;&#10;END' />
      </column>
      <column caption='online hour' datatype='real' hidden='true' name='[Calculation_1201616692875378688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([actual_open_seconds]/3600)' />
      </column>
      <column caption='L14D AVG OPD' datatype='real' name='[Calculation_1337006161648091136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [date] &gt;= TODAY()-15 AND [date] &lt;= TODAY()-2 THEN [valid_orders] END)' />
      </column>
      <column caption='Day-1 Orders' datatype='real' name='[Calculation_1337006161650266113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [date] = TODAY()-1 THEN [valid_orders] END)' />
      </column>
      <column caption='Order Growth (L14D AVG Vs Day-1)' datatype='real' name='[Calculation_1337006161650479106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1337006161650266113]-[Calculation_1337006161648091136])/[Calculation_1337006161648091136]' />
      </column>
      <column caption='Vendor Offline Hour %' datatype='real' name='[Calculation_1572319241422651392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_closed_seconds])/SUM([total_scheduled_open_seconds])' />
      </column>
      <column caption='Date Type Values' datatype='string' name='[Calculation_1572319241441226755]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Overall&quot; THEN NULL&#13;&#10;WHEN &quot;Daily&quot; THEN [date (copy)_1804254621867118593]&#13;&#10;WHEN &quot;Weekly&quot; THEN [week]&#13;&#10;WHEN &quot;Monthly&quot; THEN [month]&#13;&#10;END' />
      </column>
      <column caption='Valid Orders' datatype='integer' name='[Calculation_1804254621867003904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_orders])' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1804254621867560962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv])' />
      </column>
      <column caption='GFV' datatype='real' name='[Calculation_1804254621867958275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv])' />
