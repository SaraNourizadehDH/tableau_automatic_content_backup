              <calculation class='tableau' formula='[Calculation_1804254621867958275]/[Calculation_1804254621867003904]' />
            </column>
            <column caption='Subsidized Orders %' datatype='real' name='[Calculation_1804254621877178374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subsidized_orders])/[Calculation_1804254621867003904]' />
            </column>
            <column caption='Organic Orders' datatype='integer' name='[Calculation_1804254621877383175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867003904]-SUM([subsidized_orders])' />
            </column>
            <column caption='Vendor Funded Subsidy/GMV %' datatype='real' name='[Calculation_1804254621878185993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([voucher_vd],0)) + SUM(IFNULL([discount_vd],0)))/[Calculation_1804254621867560962]' />
            </column>
            <column caption='Vendor Cancellation %' datatype='real' name='[Calculation_1804254621879578634]' role='measure' type='quantitative'>
