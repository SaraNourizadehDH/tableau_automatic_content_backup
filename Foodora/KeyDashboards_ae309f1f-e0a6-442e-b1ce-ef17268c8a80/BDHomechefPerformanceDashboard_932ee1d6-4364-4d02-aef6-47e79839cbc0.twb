    <worksheet name='Cluster wise'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#dd0c78' fontname='Tableau Semibold' fontsize='20'>&lt;</run>
            <run bold='true' fontcolor='#dd0c78' fontname='Tableau Semibold' fontsize='20'>[Parameters].[Parameter 3]</run>
            <run bold='true' fontcolor='#dd0c78' fontname='Tableau Semibold' fontsize='20'>&gt; Summary: Cluster Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Homechefs_1' name='federated.0r5nw211srmwhw12q4qfk1dym5bo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0r5nw211srmwhw12q4qfk1dym5bo'>
            <column caption='Vendor Offline Hour %' datatype='real' name='[Calculation_1572319241422651392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_closed_seconds])/SUM([total_scheduled_open_seconds])' />
            </column>
            <column caption='Date Type Values' datatype='string' name='[Calculation_1572319241441226755]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Overall&quot; THEN NULL&#13;&#10;WHEN &quot;Daily&quot; THEN [date (copy)_1804254621867118593]&#13;&#10;WHEN &quot;Weekly&quot; THEN [week]&#13;&#10;WHEN &quot;Monthly&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Valid Orders' datatype='integer' name='[Calculation_1804254621867003904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1804254621867560962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv])' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_1804254621867958275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_1804254621876842500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_fee])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_1804254621877022725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867958275]/[Calculation_1804254621867003904]' />
            </column>
            <column caption='Subsidized Orders %' datatype='real' name='[Calculation_1804254621877178374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subsidized_orders])/[Calculation_1804254621867003904]' />
            </column>
            <column caption='Organic Orders' datatype='integer' name='[Calculation_1804254621877383175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867003904]-SUM([subsidized_orders])' />
            </column>
            <column caption='Vendor Funded Subsidy/GMV %' datatype='real' name='[Calculation_1804254621878185993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([voucher_vd],0)) + SUM(IFNULL([discount_vd],0)))/[Calculation_1804254621867560962]' />
            </column>
            <column caption='Vendor Cancellation %' datatype='real' name='[Calculation_1804254621879578634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cancelled_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Assumed Prep Time (mins)' datatype='real' name='[Calculation_1804254621879910411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Prep_time_sum])/SUM([Prep_time_count])' />
            </column>
            <column caption='Vendor Late (mins)' datatype='real' name='[Calculation_1804254621880164364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_sum])/SUM([vendor_late_count])' />
            </column>
            <column caption='DT (mins)' datatype='real' name='[Calculation_1804254621880475661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT_sum])/SUM([DT_count])' />
            </column>
            <column caption='Food Ratings' datatype='real' name='[Calculation_1804254621881004046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_rating_sum])/SUM([food_rating_count])' />
            </column>
            <column caption='Packaging Ratings' datatype='real' name='[Calculation_1804254621881360399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([packaging_rating_sum])/SUM([packaging_rating_count])' />
            </column>
            <column caption='Order / Day' datatype='real' name='[Calculation_1804254621882499090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867003904]/COUNTD([order_date])' />
            </column>
            <column datatype='integer' name='[DT_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[DT_sum]' role='measure' type='quantitative' />
            <column datatype='real' name='[Delivery_fee]' role='measure' type='quantitative' />
