            <column caption='WXYZ Class' datatype='string' name='[wxyz_class]' role='dimension' type='nominal' />
            <column-instance column='[pd_activation_date_local]' derivation='Year' name='[yr:pd_activation_date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sf_activated_date]' derivation='Year' name='[yr:sf_activated_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0r5nw211srmwhw12q4qfk1dym5bo].[Action (MY(date),WXYZ Class)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action1_A59E8DF857154D8EB282923D2F8214EB]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[my:date:ok]' />
