            <column caption='valid orders' datatype='integer' name='[valid_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[voucher_fp]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0r5nw211srmwhw12q4qfk1dym5bo].[User Filter BD commercial]</column>
          </slices>
          <aggregation value='true' />
