              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Measure KPI Name' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Offline Hour \%&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Offline Hour %&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0r5nw211srmwhw12q4qfk1dym5bo'>
            <column caption='Measure KPI Value' datatype='real' name='[Calculation_1180224598852431873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;GMV&quot; THEN [Calculation_1804254621867560962]&#13;&#10;WHEN &quot;GFV&quot; THEN [Calculation_1804254621867958275]&#13;&#10;WHEN &quot;AFV&quot; THEN [Calculation_1804254621877022725]&#13;&#10;WHEN &quot;Food Rating&quot; THEN [Calculation_1804254621881004046]&#13;&#10;WHEN &quot;Packaging Rating&quot; THEN [Calculation_1804254621881360399]&#13;&#10;WHEN &quot;DT&quot; THEN [Calculation_1804254621880475661]&#13;&#10;WHEN &quot;Prep Time&quot; THEN [Calculation_1804254621879910411]&#13;&#10;WHEN &quot;Vendor Late&quot; THEN [Calculation_1804254621880164364]&#13;&#10;WHEN &quot;Vendor Offline Hour %&quot; THEN [Calculation_1572319241422651392]*100&#13;&#10;WHEN &quot;Vendor Cancellation %&quot; THEN [Calculation_1804254621879578634]*100&#13;&#10;END' />
            </column>
            <column caption='Vendor Offline Hour %' datatype='real' name='[Calculation_1572319241422651392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_closed_seconds])/SUM([total_scheduled_open_seconds])' />
            </column>
            <column caption='Valid Orders' datatype='integer' name='[Calculation_1804254621867003904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1804254621867560962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv])' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_1804254621867958275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_1804254621877022725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1804254621867958275]/[Calculation_1804254621867003904]' />
            </column>
            <column caption='Vendor Cancellation %' datatype='real' name='[Calculation_1804254621879578634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cancelled_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Assumed Prep Time (mins)' datatype='real' name='[Calculation_1804254621879910411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Prep_time_sum])/SUM([Prep_time_count])' />
            </column>
            <column caption='Vendor Late (mins)' datatype='real' name='[Calculation_1804254621880164364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_sum])/SUM([vendor_late_count])' />
            </column>
            <column caption='DT (mins)' datatype='real' name='[Calculation_1804254621880475661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT_sum])/SUM([DT_count])' />
            </column>
            <column caption='Food Ratings' datatype='real' name='[Calculation_1804254621881004046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_rating_sum])/SUM([food_rating_count])' />
            </column>
            <column caption='Packaging Ratings' datatype='real' name='[Calculation_1804254621881360399]' role='measure' type='quantitative'>
