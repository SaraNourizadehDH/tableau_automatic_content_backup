          </datasources>
          <datasource-dependencies datasource='federated.0r5nw211srmwhw12q4qfk1dym5bo'>
            <column caption='Burn per order' datatype='real' name='[Calculation_718605674728833025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([discount_fp])+SUM([voucher_fp]))/SUM([valid_orders])' />
            </column>
            <column datatype='real' name='[discount_fp]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
