      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='offline_hours' id='_1CC7D4C963444F03B5C2EB633D15122F'>
            <properties context=''>
              <relation connection='bigquery.064kgeh0nevxq81dls92j0d3x9k8' name='Custom SQL Query1' type='text'><![CDATA[WITH dates AS(
  SELECT
  DISTINCT
  date,
  FORMAT_DATETIME("%Y-%m", DATETIME(date)) AS month,
  FORMAT_DATETIME("%Y-%W", DATETIME(date)) AS week
  FROM `fulfillment-dwh-production.pandata_curated.shared_dates` 
  WHERE date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
),

month_ranking AS(
  SELECT
  month,
  ROW_NUMBER() OVER(ORDER BY month DESC) AS month_rank
  FROM(
    SELECT
    DISTINCT
    month
    FROM dates
    )  
),

week_ranking AS(
  SELECT
  week,
  ROW_NUMBER() OVER(ORDER BY week DESC) AS week_rank
  FROM(
    SELECT
    DISTINCT
    week
    FROM dates
    )  
),

final_dates AS(
  SELECT
  dates.*,
  month_ranking.month_rank,
  week_ranking.week_rank
  FROM dates
  LEFT JOIN month_ranking
         ON month_ranking.month = dates.month
  LEFT JOIN week_ranking
         ON week_ranking.week = dates.week
),

homechefs AS (
  SELECT
  *
  FROM `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` 
  WHERE is_home_based_kitchen
),

homechefs_x_dates AS (
  SELECT
  *
  FROM homechefs
  CROSS JOIN final_dates
)


SELECT
vendor_offline.vendor_code,
vendor_offline.report_date,
(SUM(vendor_offline.scheduled_open_seconds) - SUM(vendor_offline.unavailable_seconds)) AS actual_open_seconds,
SUM(vendor_offline.unavailable_seconds) AS  actual_closed_seconds,
SUM(vendor_offline.scheduled_open_seconds) AS total_scheduled_open_seconds
FROM `fulfillment-dwh-production.pandata_report.country_BD_vendor_hourly_offline` AS vendor_offline
LEFT JOIN homechefs_x_dates
       ON homechefs_x_dates.vendor_code = vendor_offline.vendor_code
      AND homechefs_x_dates.date = vendor_offline.report_date
WHERE report_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH)
AND homechefs_x_dates.month_rank <<= 3
group by 1,2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_1CC7D4C963444F03B5C2EB633D15122F' table='[Extract].[_1CC7D4C963444F03B5C2EB633D15122F]' type='table' />
            </properties>
          </object>
          <object caption='vendors_x_dates_x_orders' id='_6A5C7BD3238841A18726471A4C8E83EF'>
            <properties context=''>
              <relation connection='bigquery.064kgeh0nevxq81dls92j0d3x9k8' name='Custom SQL Query' type='text'><![CDATA[WITH dates AS(
  SELECT
  DISTINCT
  date,
  FORMAT_DATETIME("%Y%m", DATETIME(date)) AS month,
  FORMAT_DATETIME("%Y-%W", DATETIME(date)) AS week
  FROM `fulfillment-dwh-production.pandata_curated.shared_dates` 
  WHERE date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
),

month_ranking AS(
  SELECT
  month,
  ROW_NUMBER() OVER(ORDER BY month DESC) AS month_rank
  FROM(
    SELECT
    DISTINCT
    month
    FROM dates
    )  
),

week_ranking AS(
  SELECT
  week,
  ROW_NUMBER() OVER(ORDER BY week DESC) AS week_rank
  FROM(
    SELECT
    DISTINCT
    week
    FROM dates
    )  
),

final_dates AS(
  SELECT
  dates.*,
  month_ranking.month_rank,
  week_ranking.week_rank
  FROM dates
  LEFT JOIN month_ranking
         ON month_ranking.month = dates.month
  LEFT JOIN week_ranking
         ON week_ranking.week = dates.week
),

homechefs AS (
  SELECT
  *
  FROM `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use`  
  WHERE is_home_based_kitchen
),

homechefs_x_dates AS (
  SELECT
  *
  FROM homechefs
  CROSS JOIN final_dates
),

rating AS (
SELECT 
DISTINCT order_code,
  packaging_rating,
  restaurant_food_rating
FROM `fulfillment-dwh-production.pandata_report.country_BD_order_rating`
WHERE order_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH)

),

dlpmenu AS(
----- DLP Coverage & Menu Description -----

SELECT
vm.vendor_code,
Y.capture_date ,
---(CASE WHEN Z.chain_code IS NULL THEN Z.vendor_code ELSE z.chain_code END) AS tag,
-- FORMAT_DATETIME("%Y%m", DATETIME(Y.capture_date)) AS month_year,
Y.Total_product_count AS Total_product_count,
Y.Active_product_count AS Active_product_count,
Y.Active_products_image_count AS Active_products_image_count, 
Y.Active_products_description_count AS Active_products_description_count,
Y.active_products_menu_category_count AS Active_products_menu_category_count,

SAFE_DIVIDE(Y.Active_products_image_count , Y.Active_product_count) AS DLP_Percent,
SAFE_DIVIDE(Y.Active_products_description_count, Y.Active_product_count) AS
menu_desciption_Percent 

FROM
`fulfillment-dwh-production.pandata_report.country_BD_product_image_description_count` AS Y
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS VM 
ON Y.vendor_code = vm.vendor_code

WHERE Y.capture_date >>= date_sub(CURRENT_DATE(), INTERVAL 30 DAY)
-- BETWEEN '2021-11-01' AND '2021-12-31'
and VM.is_home_based_kitchen 
AND VM.is_active 
AND VM.is_private = FALSE

GROUP BY 1,2,3,4,5,6,7
),

orders AS ( 
  SELECT
  b.vendor_code,
  b.order_date,
  COUNT(CASE WHEN b.is_valid_order THEN b.order_code END) AS valid_orders,
  SUM(CASE WHEN b.is_valid_order THEN b.gfv_gross_local END) AS gfv,
  SUM(CASE WHEN b.is_valid_order THEN (b.gfv_gross_local/b.fx_rate_eur) END) AS gfv_eur,
  sum(case when b.is_valid_order then b.gfv_combined_local end) as gfv_combined,
  sum(case when b.is_valid_order then (b.gfv_combined_local/b.fx_rate_eur) end) as gfv_combined_eur,
  SUM(CASE WHEN b.is_valid_order THEN b.gmv_gross_local END) AS gmv,
  SUM(CASE WHEN b.is_valid_order THEN (b.gmv_gross_local/b.fx_rate_eur) END) AS gmv_eur,
  SUM(CASE WHEN b.is_valid_order THEN IFNULL(b.discount_amount_local,0) END) AS discount_amount, 
  SUM(CASE WHEN b.is_valid_order THEN IFNULL(b.voucher_amount_local,0) END) AS voucher_amount,
  (SUM(CASE WHEN b.is_valid_order THEN b.gmv_gross_local END) - SUM(CASE WHEN b.is_valid_order THEN IFNULL(b.discount_amount_local,0) END) - SUM(CASE WHEN b.is_valid_order THEN IFNULL(b.voucher_amount_local,0) END)) AS gmv_net,
  sum(case when b.is_gross_order and b.is_wastage = "wastage" then b.gfv_gross_local end) as wastage,
  SUM(CASE WHEN b.is_valid_order THEN b.discount_value_foodpanda_subsidized END) AS discount_fp,
  SUM(CASE WHEN b.is_valid_order THEN b.discount_value_vendor_subsidized END) AS discount_vd,
  SUM(CASE WHEN b.is_valid_order THEN b.voucher_value_foodpanda_subsidized END) AS voucher_fp,
  SUM(CASE WHEN b.is_valid_order THEN b.voucher_value_vendor_subsidized END) AS voucher_vd,
  SUM(CASE WHEN b.is_valid_order THEN IFNULL(bogo.BOGO_VF, 0) END) AS bogo_price,
  COUNT(CASE WHEN b.decline_reason_type = 'VENDOR' THEN b.order_code END) AS vendor_cancelled_orders,
  COUNT(b.order_code) AS gross_orders,
  SUM(CASE WHEN b.is_valid_order THEN commission_local END) AS commission_amount,

  SUM(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" THEN rd.timings.actual_delivery_time/60 END) AS DT_sum,
  COUNT(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" AND rd.timings.actual_delivery_time is not null THEN rd.timings.actual_delivery_time END) AS DT_count,
  
  SUM(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" THEN rd.timings.assumed_actual_preparation_time/60 END) AS Prep_time_sum,
  COUNT(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" AND rd.timings.assumed_actual_preparation_time is not null THEN rd.timings.assumed_actual_preparation_time END) AS Prep_time_count,
  
  SUM(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" THEN lg_orders.estimated_prep_time/60 END) AS estimated_prep_time_sum,
  COUNT(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" AND lg_orders.estimated_prep_time is not null THEN lg_orders.estimated_prep_time END) AS estimated_prep_time_count,
 
  SUM(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" THEN IFNULL(lg_orders.estimated_prep_time,0) + IFNULL(rd.timings.at_vendor_time_cleaned,0) END)/60 AS actual_prep_time_sum,
  COUNT(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" AND lg_orders.estimated_prep_time is not null THEN lg_orders.estimated_prep_time END) AS actual_prep_time_count,
  
  SUM(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" THEN rd.timings.vendor_late/60 END) AS vendor_late_sum,
  COUNT(CASE WHEN b.is_valid_order AND lg_orders.order_status = "completed" AND rd.timings.vendor_late is not null THEN rd.timings.vendor_late/60 END) AS vendor_late_count,
  
  SUM(rating.restaurant_food_rating) AS food_rating_sum,
  COUNT(rating.restaurant_food_rating) AS food_rating_count,
  
  SUM(rating.packaging_rating) AS packaging_rating_sum,
  COUNT(rating.packaging_rating) AS packaging_rating_count,
  
  SUM(CASE WHEN b.is_valid_order THEN b.delivery_fee_local END) AS Delivery_fee,
  SUM(CASE WHEN b.is_valid_order THEN (b.delivery_fee_local/b.fx_rate_eur) END) AS Delivery_fee_eur,
  COUNT(CASE WHEN b.is_valid_order AND (b.is_voucher_used OR b.is_discount_used) THEN b.order_code END) AS subsidized_orders,
  COUNT(CASE WHEN b.is_voucher_used THEN b.order_code END) AS voucher_used_orders,
  COUNT(CASE WHEN b.is_discount_used THEN b.order_code END) AS discount_used_orders,

  SUM(IFNULL((CASE WHEN NOT (
    (b.voucher_channel = "channel_partnership" AND b.voucher_purpose = "activation")
    OR (b.voucher_channel = "channel_employee_benefits" AND b.voucher_purpose = "benefits")
    OR (b.voucher_channel = "channel_online" AND b.voucher_purpose = "autocompensation_realtime")
    OR (b.voucher_channel = "channel_customer_service" AND b.voucher_purpose = "refund")
    OR (b.voucher_channel = "channel_partnership" AND b.voucher_purpose = "revenue")
    OR (b.voucher_channel = "channel_corporate" AND b.voucher_purpose = "revenue")
    OR (b.voucher_channel = "channel_customer_service" AND b.voucher_purpose = "sorry_panda")
  ) THEN b.voucher_value_foodpanda_subsidized END),0)
      +IFNULL(b.discount_value_foodpanda_subsidized,0)) AS marketing_icp
  
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` AS b
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.orders` AS lg_orders
         ON b.order_code = lg_orders.platform_order_code
        AND b.global_entity_id = lg_orders.entity.id
        AND lg_orders.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH)-1
  LEFT JOIN lg_orders.deliveries as rd      
  LEFT JOIN rating
         ON rating.order_code = b.order_code
  INNER JOIN homechefs
          ON homechefs.vendor_code = b.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_BD_bogo_order_level` AS bogo
         ON bogo.order_code = b.order_code

  WHERE b.is_gross_order
  AND b.order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH),MONTH) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  
  GROUP BY b.vendor_code,
  b.order_date
)

SELECT
homechefs_x_dates.*,
orders.* EXCEPT(vendor_code),
dlpmenu.* EXCEPT(vendor_code,capture_date)
FROM homechefs_x_dates
LEFT JOIN orders
       ON homechefs_x_dates.vendor_code = orders.vendor_code
      AND homechefs_x_dates.date = orders.order_date
LEFT JOIN dlpmenu
ON homechefs_x_dates.vendor_code= dlpmenu.vendor_code 
and homechefs_x_dates.date= dlpmenu.capture_date 

WHERE homechefs_x_dates.month_rank <<= 3]]></relation>
            </properties>
