              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;local&quot; THEN [daily_display_ads_revenue_local]&#10;WHEN &quot;eur&quot; THEN [daily_display_ads_revenue_eur] END' />
