              <calculation class='tableau' formula='{ FIXED [campaign_id], [datelive], [creative_id], [impression_date]: SUM([total_impressions])/ COUNTD([placement_screen])}' />
            </column>
            <column caption='Total Orders (LOD)' datatype='real' name='[Budget Spent (LOD) (copy)_4602256617306066947]' role='measure' type='quantitative'>
