            </column>
            <column caption='Budget' datatype='real' name='[Calculation_1454592360515489794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;local&quot; THEN [final_monthly_budget_local]&#10;WHEN &quot;eur&quot; THEN [final_monthly_budget_eur]&#10;END' />
