    DATE(display_ad_requests.served_timestamp) AS report_date,
    COUNT(DISTINCT display_ad_requests.request_id) AS daily_ad_requests
  FROM `fulfillment-dwh-production.curated_data_shared_adtech.display_ad_requests` AS display_ad_requests
  --LEFT JOIN UNNEST(keywords) AS keys
  INNER JOIN `fulfillment-dwh-production`.`pandata_curated`.`shared_countries` AS shared_countries
