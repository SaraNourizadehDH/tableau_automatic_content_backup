            </column>
            <column caption='Budget Spent' datatype='real' name='[Calculation_1454592360515084288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &quot;local&quot; THEN [revenue_local]&#10;WHEN &quot;eur&quot; THEN [revenue_eur]&#10;END' />
            </column>
            <column caption='Bid' datatype='real' name='[Calculation_1454592360515391489]' role='measure' type='quantitative'>
