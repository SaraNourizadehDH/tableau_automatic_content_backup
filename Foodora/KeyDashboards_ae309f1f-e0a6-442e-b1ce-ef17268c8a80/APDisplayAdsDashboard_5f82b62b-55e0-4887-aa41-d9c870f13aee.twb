    <datasource caption='regional_apac_da_dashboard_daily_metrics (pandata_report)' inline='true' name='federated.18155th0fptet012cnwv000s4al5' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.11ckda300c82fr12tq2ux06tv9vt'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='theeranop.wongtitirote@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.11ckda300c82fr12tq2ux06tv9vt' name='Custom SQL Query' type='text'>WITH ad_requests AS (
  SELECT
    display_ad_requests.global_entity_id,
    DATE(display_ad_requests.served_timestamp) AS report_date,
    COUNT(DISTINCT display_ad_requests.request_id) AS daily_ad_requests
  FROM `fulfillment-dwh-production.curated_data_shared_adtech.display_ad_requests` AS display_ad_requests
  --LEFT JOIN UNNEST(keywords) AS keys
  INNER JOIN `fulfillment-dwh-production`.`pandata_curated`.`shared_countries` AS shared_countries
          ON display_ad_requests.global_entity_id = shared_countries.global_entity_id
  WHERE DATE(display_ad_requests.served_timestamp) &gt;&gt;= &quot;2024-01-01&quot;
    AND JSON_EXTRACT_SCALAR(display_ad_requests.ext, &quot;$.screen&quot;) = &quot;shop_list&quot;
    AND shared_countries.region = &quot;Asia&quot;
    AND shared_countries.company_name = &quot;Foodpanda&quot;
  GROUP BY ALL
),


pre_dashboard_daily_metrics AS (
  SELECT
    global_entity_id,
    impression_date AS report_date,
    total_impressions AS total_impressions_recieved,
    revenue_local AS daily_display_ads_revenue_local,
    revenue_eur AS daily_display_ads_revenue_eur,
    final_monthly_budget_local AS monthly_local_budget,
    final_monthly_budget_eur AS monthly_budget_eur
  FROM `fulfillment-dwh-production`.`pandata_report`.`regional_apac_da_dashboard_campaign_level`
  WHERE impression_date &gt;&gt;= &quot;2024-01-01&quot;
  -- There may be multiple rows per day per campaign if multiple creative IDs are used
  QUALIFY ROW_NUMBER() OVER(
    PARTITION BY
      global_entity_id,
      impression_date,
      campaign_id
  ) = 1
),

dashboard_daily_metrics AS (
  SELECT
    global_entity_id,
    report_date,
    SUM(total_impressions_recieved) AS daily_impressions_recieved,
    SUM(daily_display_ads_revenue_local) AS daily_display_ads_revenue_local,
    SUM(daily_display_ads_revenue_eur) AS daily_display_ads_revenue_eur,
    SUM(monthly_local_budget) AS cum_monthly_local_budget,
    SUM(monthly_budget_eur) AS cum_monthly_budget_eur
  FROM pre_dashboard_daily_metrics
  WHERE report_date &gt;&gt;= &quot;2024-01-01&quot;
  GROUP BY ALL
),

-- Daily booked capacity calculations
base AS (
  SELECT DISTINCT
    global_entity_id,
    campaign_id,
    DATE(start_date) AS start_date,
    DATE(end_date) AS end_date,
    SAFE_DIVIDE(final_monthly_budget_local, DATE_DIFF(DATE(end_date), DATE(start_date), DAY) + 1) AS daily_allocated_budget_local,
    SAFE_DIVIDE(final_monthly_budget_eur, DATE_DIFF(DATE(end_date), DATE(start_date), DAY) + 1) AS daily_allocated_budget_eur,
    SAFE_DIVIDE(final_monthly_budget_local / bid_local * 1000, DATE_DIFF(DATE(end_date), DATE(start_date), DAY) + 1) AS daily_allocated_impressions
  FROM `fulfillment-dwh-production`.`pandata_report`.`regional_apac_da_dashboard_campaign_level`
),

date_array AS (
  SELECT
    GENERATE_DATE_ARRAY(start_date, end_date, INTERVAL 1 DAY) AS report_date,
    *
  FROM base
),

daily_booked_capacity AS (
  SELECT
    report_date,
    date_array.global_entity_id,
    SUM(date_array.daily_allocated_budget_local) AS daily_allocated_budget_local,
    SUM(date_array.daily_allocated_budget_eur) AS daily_allocated_budget_eur,
    SUM(date_array.daily_allocated_impressions) AS daily_allocated_impressions
  FROM date_array
  LEFT JOIN UNNEST(report_date) AS report_date
  WHERE report_date &gt;&gt;= &quot;2024-01-01&quot;
  GROUP BY ALL
),

da_dashboard_daily_metrics AS (
SELECT
  ad_requests.global_entity_id,
  ad_requests.report_date,
  ad_requests.daily_ad_requests,
  dashboard_daily_metrics.daily_impressions_recieved,
  dashboard_daily_metrics.daily_display_ads_revenue_local,
  dashboard_daily_metrics.daily_display_ads_revenue_eur,
  dashboard_daily_metrics.cum_monthly_local_budget,
  dashboard_daily_metrics.cum_monthly_budget_eur,
  daily_booked_capacity.daily_allocated_budget_local,
  daily_booked_capacity.daily_allocated_budget_eur,
  daily_booked_capacity.daily_allocated_impressions
FROM ad_requests
LEFT JOIN dashboard_daily_metrics
       ON ad_requests.report_date = dashboard_daily_metrics.report_date
      AND ad_requests.global_entity_id = dashboard_daily_metrics.global_entity_id
LEFT JOIN daily_booked_capacity
       ON ad_requests.report_date = daily_booked_capacity.report_date
      AND ad_requests.global_entity_id = daily_booked_capacity.global_entity_id
WHERE ad_requests.report_date &gt;&gt;= &quot;2024-01-01&quot;
),

dashboard_campaign_level AS (
  SELECT
    global_entity_id,
    impression_date AS report_date,
    SUM(total_impressions) AS total_impressions_recieved,
    SUM(revenue_local) AS daily_display_ads_revenue_local,
    SUM(revenue_eur) AS daily_display_ads_revenue_eur,
  FROM fulfillment-dwh-production.pandata_report.regional_apac_da_dashboard_campaign_level
  GROUP BY ALL
)


SELECT 
  daily_metrics.* EXCEPT(daily_impressions_recieved, daily_display_ads_revenue_eur, daily_display_ads_revenue_local),
  dashboard_campaign_level.total_impressions_recieved,
  dashboard_campaign_level.daily_display_ads_revenue_eur,
  dashboard_campaign_level.daily_display_ads_revenue_local
FROM da_dashboard_daily_metrics AS daily_metrics
LEFT JOIN dashboard_campaign_level
       ON daily_metrics.global_entity_id = dashboard_campaign_level.global_entity_id
      AND daily_metrics.report_date = dashboard_campaign_level.report_date</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.11ckda300c82fr12tq2ux06tv9vt' name='Custom SQL Query' type='text'>WITH ad_requests AS (
