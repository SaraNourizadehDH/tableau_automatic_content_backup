    <worksheet name='WoW (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>WoW</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='telesales' name='federated.1xh22f407xbc4b1ga3d7g0lg40ml (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1xh22f407xbc4b1ga3d7g0lg40ml (copy)'>
            <column caption='vendor grade score' datatype='integer' name='[Calculation_5472788404530376704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_won] THEN&#10;  CASE [vendor_grade]&#10;    WHEN &quot;A&quot; THEN 10&#10;    WHEN &quot;B&quot; THEN 7&#10;    WHEN &quot;C&quot; THEN 5&#10;    WHEN &quot;D&quot; THEN 1&#10;    ELSE 1&#10;  END&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Exclude Current Date' datatype='boolean' name='[Calculation_6023846040454131713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] = TODAY()' />
            </column>
            <column caption='current month sort' datatype='integer' name='[Calculation_6023846040460034051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH([report_date]), [full_name_internal_non_pii] : &#10;    SUM(IF DATEPART(&apos;month&apos;, [report_date]) = DATEPART(&apos;month&apos;, TODAY()) &#10;         AND DATEPART(&apos;year&apos;, [report_date]) = DATEPART(&apos;year&apos;, TODAY()) &#10;    THEN [Calculation_5472788404530376704] END) &#10;}' />
            </column>
            <column caption='WoW' datatype='string' name='[DoD (copy)_6023846040454856706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;week&apos;, [report_date]) = DATETRUNC(&apos;week&apos;, TODAY()) THEN &apos;This Week&apos;&#10;ELSEIF DATETRUNC(&apos;week&apos;, [report_date]) = DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Last Week&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column-instance column='[Calculation_5472788404530376704]' derivation='Sum' name='[diff:sum:Calculation_5472788404530376704:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column datatype='string' name='[full_name_internal_non_pii]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_won]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6023846040454131713]' derivation='None' name='[none:Calculation_6023846040454131713:nk]' pivot='key' type='nominal' />
            <column-instance column='[DoD (copy)_6023846040454856706]' derivation='None' name='[none:DoD (copy)_6023846040454856706:nk]' pivot='key' type='nominal' />
