WHERE created_date_local &gt;&gt;= &quot;2025-04-01&quot;
AND global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
