            <column-instance column='[user_country]' derivation='None' name='[none:user_country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5472788404530376704]' derivation='Sum' name='[pcdf:sum:Calculation_5472788404530376704:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6023846040460034051]' derivation='Sum' name='[sum:Calculation_6023846040460034051:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[user_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[vendor_grade]' role='dimension' type='nominal' />
