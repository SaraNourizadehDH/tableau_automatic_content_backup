        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0tgfkhp0ro8b2t191kzf70c5kq9y (copy)' name='Custom SQL Query' type='text'>WITH date_cte AS (
  -- Generate daily dates from April 1, 2025, to today
  SELECT date_value AS report_date
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE &apos;2025-03-01&apos;, CURRENT_DATE(), INTERVAL 1 DAY)) AS date_value
),

users_monthly AS (
  -- Extract all users from April 1, 2025, onward
  SELECT
    users.report_date,
    users.country,
    countries.global_entity_id,
    users.full_name_internal_non_pii,
    users.email_internal_non_pii,
    users.sf_user_id,
    users.central_job_role,
    users.title,
    users.job_role_vertical,
    users.user_type,
    users.account_age_snapshot,
    users.is_active_snapshot,
    users.is_contractor,
    ROW_NUMBER() OVER (PARTITION BY users.sf_user_id ORDER BY report_date DESC) = 1 AS is_latest
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
          ON users.country = countries.name
  WHERE users.report_date &gt;&gt;= DATE &apos;2025-03-01&apos;
  AND user_type = &quot;telesales&quot; 
  AND is_active_snapshot
),


activations AS (
SELECT 
global_entity_id,
country,
vendor_type,
vendor_grade,
is_key_vip_account,
key_account_sub_category,
account_created_date_utc,
activation_date,
vendor_code,
global_vendor_id,
vendor_name,
sf_opportunity_id,
user_type,
full_name_internal_non_pii,
is_won,
is_closed,
opportunity_business_type,
sf_opp_created_by_user_id,
sf_opportunity_owner_id
 FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` 
WHERE user_type = &quot;telesales&quot; 
AND activation_date &gt;&gt;= &quot;2025-03-01&quot;
AND LOWER(vendor_type) = &quot;restaurants&quot;
AND is_won
AND is_closed
AND ((country IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;Legal Form Change&apos;, &apos;New Business&apos;, &apos;Owner Change&apos;, &apos;Win Back&apos;))
    OR
    (country NOT IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)))
)
-- Cross join to get every user on every date
SELECT 
  date_cte.report_date,
  users_monthly.full_name_internal_non_pii,
  users_monthly.country AS user_country,
  users_monthly.sf_user_id,
  users_monthly.central_job_role,
  users_monthly.account_age_snapshot,
  users_monthly.is_active_snapshot,
  users_monthly.is_contractor,
  activations.country,
activations.vendor_type,
activations.vendor_grade,
activations.is_key_vip_account,
activations.key_account_sub_category,
activations.account_created_date_utc,
activations.activation_date,
activations.vendor_code,
activations.global_vendor_id,
activations.vendor_name,
activations.sf_opportunity_id,
activations.user_type,
activations.is_won,
activations.is_closed,
activations.opportunity_business_type,
activations.sf_opp_created_by_user_id,
