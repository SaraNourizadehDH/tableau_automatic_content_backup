      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1mn4pzm0qp2obo181vhhf0dx3s9m].[pcdf:usr:Calculation_2367486093336317952:qk:2]&quot;' value='% MoM vfd/gmv' />
          <alias key='&quot;[federated.1mn4pzm0qp2obo181vhhf0dx3s9m].[pcdf:usr:Calculation_2367486093336428545:qk:2]&quot;' value='%MoM ncr/gmv' />
          <alias key='&quot;[federated.1mn4pzm0qp2obo181vhhf0dx3s9m].[pcdf:usr:Calculation_2367486093336559618:qk:2]&quot;' value='%MoM Actual % | (VFD+NCR)/GMV' />
          <alias key='&quot;[federated.1mn4pzm0qp2obo181vhhf0dx3s9m].[usr:Calculation_2367486093336559618:qk]&quot;' value='Actual % | (VFD+NCR)/GMV' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_2367486093336559618]) - LOOKUP(ZN([Calculation_2367486093336559618]), -1)) / ABS(LOOKUP(ZN([Calculation_2367486093336559618]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='vfd/gmv' datatype='real' name='[Calculation_2367486093336317952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vfd_eur])/SUM([gmv_eur])' />
      </column>
      <column caption='ncr/gmv' datatype='real' name='[Calculation_2367486093336428545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([cpc_rev_eur]+[joker_rev_eur])/SUM([gmv_eur]), 0 )' />
      </column>
      <column caption='(vfd+ncr)/gmv' datatype='real' name='[Calculation_2367486093336559618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([vfd_eur]+[joker_rev_eur]+[cpc_rev_eur])/SUM([gmv_eur]),0)' />
      </column>
      <column caption='rank total' datatype='integer' name='[Calculation_2367486093340262403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE([Calculation_2367486093336559618] , &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='dod' datatype='boolean' name='[Calculation_2367486093355130889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;= DATE(TODAY() - 2) AND [report_date] &lt;= DATE(TODAY() -1)' />
      </column>
      <column caption='am top 1' datatype='boolean' name='[Calculation_6022368298950463490]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2367486093340262403] = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='WoW' datatype='string' name='[DoD (copy)_6023846040454856706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;week&apos;, [report_date]) = DATETRUNC(&apos;week&apos;, TODAY()) THEN &apos;This Week&apos;&#10;ELSEIF DATETRUNC(&apos;week&apos;, [report_date]) = DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Last Week&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_4E285F6D8BFC44A299CE4E15B55A2863]' role='measure' type='quantitative' />
      <column caption='country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;DJ_CZ&quot;' value='Czech Republic' />
          <alias key='&quot;FO_NO&quot;' value='Norway' />
          <alias key='&quot;FP_BD&quot;' value='Bangladesh' />
          <alias key='&quot;FP_HK&quot;' value='Hong Kong' />
          <alias key='&quot;FP_KH&quot;' value='Cambodia' />
          <alias key='&quot;FP_LA&quot;' value='Laos' />
