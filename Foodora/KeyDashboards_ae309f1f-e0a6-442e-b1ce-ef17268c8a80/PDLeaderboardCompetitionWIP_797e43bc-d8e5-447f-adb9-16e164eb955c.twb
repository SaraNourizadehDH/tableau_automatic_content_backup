            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='theeranop.wongtitirote@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rcvxho0k0u63o17cn6ig0ng1n4z' name='Custom SQL Query' type='text'>WITH 

sf_account AS (
    SELECT
      sf_accounts.global_entity_id,
      sf_accounts.vendor_code,
      sf_accounts.name AS account_name,
      sf_accounts.id AS account_id,
      sf_accounts.sf_owner_id AS owner_id,
      sf_accounts.owner_name,
      sf_accounts.created_at_utc,
      sf_accounts.gmv_class AS sf_gmv_class,
      sf_accounts.vendor_grade AS sf_vendor_grade,
      sf_accounts.vertical_segment AS sf_vertical_segment,
      sf_accounts.primary_cuisine AS sf_primary_cuisine,
      sf_accounts.category AS sf_category,
      CASE WHEN NOT has_mark_up OR mark_up_type IS NULL THEN &quot;No mark-up&quot;
          WHEN has_mark_up THEN mark_up_type
          ELSE mark_up_type
      END AS markup_type_use,
      sf_accounts.has_mark_up,
      sf_accounts.mark_up_type,
      sf_accounts.mark_up_value_local AS mark_up_value,
      sf_accounts.invoice_frequency AS billing_interval,
      sf_accounts.exclude_from_options LIKE &quot;%Sanctions%&quot; AS excluded_from_sanctions,
      COALESCE(sf_accounts.status, &quot;Null&quot;) AS sf_account_status,
      sf_accounts.account_classification
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS sf_accounts
    QUALIFY
      ROW_NUMBER() OVER (PARTITION BY sf_accounts.global_entity_id, sf_accounts.vendor_code ORDER BY sf_accounts.global_entity_id ASC, sf_accounts.vendor_code ASC, sf_accounts.created_at_utc DESC) = 1),
am_base AS(
  SELECT 
  global_entity_id,
  vendor_code,
  owner_name    
  FROM sf_account
  WHERE global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;) 

),
vfd_base AS (
SELECT
  DATE_TRUNC(created_date_local, MONTH) AS report_date,
  global_entity_id,
  vendor_code,
  SUM(gmv_eur) AS gmv_eur,
  SUM(total_incentive_cost_vendor_eur) AS vfd_eur
FROM `fulfillment-dwh-production.pandata_report.commercial__vfd_orders`
WHERE created_date_local &gt;&gt;= &quot;2025-04-01&quot;
AND global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;)
GROUP BY ALL
),

cpc AS (
SELECT 
date_month AS report_month,
global_entity_id, 
vendor_id,
SUM(cpc_revenue) AS cpc_rev_eur
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.ad_tech_il_cpc` 
WHERE date_month &gt;&gt;= &quot;2025-04-01&quot;
  AND global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;)
  GROUP BY
date_month,
global_entity_id, 
vendor_id
),

joker AS (
SELECT report_month,
global_entity_id, 
vendor_id, 
SUM(joker_revenue_eur) AS joker_rev_eur 
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.ad_tech_il_joker_vendors_monthly` 
WHERE report_month &gt;&gt;= &quot;2025-04-01&quot;
  AND global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;)
GROUP BY report_month, 
global_entity_id, 
vendor_id
)

SELECT 
  vfd_base.report_date,
  vfd_base.global_entity_id,
  am_base.owner_name AS account_manager,
  SUM(vfd_base.gmv_eur) AS gmv_eur,
  SUM(vfd_base.vfd_eur) AS vfd_eur,
  SUM(cpc.cpc_rev_eur) AS cpc_rev_eur,
  SUM(joker.joker_rev_eur) AS joker_rev_eur

FROM  vfd_base
LEFT JOIN cpc
       ON vfd_base.report_date = cpc.report_month
      AND vfd_base.global_entity_id = cpc.global_entity_id
      AND vfd_base.vendor_code = cpc.vendor_id
LEFT JOIN joker
       ON vfd_base.report_date = joker.report_month
      AND vfd_base.global_entity_id = joker.global_entity_id
      AND vfd_base.vendor_code = joker.vendor_id 
LEFT JOIN am_base
       ON vfd_base.global_entity_id = am_base.global_entity_id
      AND vfd_base.vendor_code = am_base.vendor_code    
      GROUP BY   
      vfd_base.report_date,
      vfd_base.global_entity_id,
      am_base.owner_name</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
