      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1xh22f407xbc4b1ga3d7g0lg40ml].[sum:Calculation_3841359441622007808:qk]&quot;' value='A' />
          <alias key='&quot;[federated.1xh22f407xbc4b1ga3d7g0lg40ml].[sum:Calculation_5472788404530376704:qk]&quot;' value='Daily Score' />
          <alias key='&quot;[federated.1xh22f407xbc4b1ga3d7g0lg40ml].[sum:Calculation_754423369903165445:qk]&quot;' value='# Activations' />
          <alias key='&quot;[federated.1xh22f407xbc4b1ga3d7g0lg40ml].[sum:Vendor Grade A (copy)_3841359441623232514:qk]&quot;' value='B' />
          <alias key='&quot;[federated.1xh22f407xbc4b1ga3d7g0lg40ml].[sum:Vendor Grade A (copy)_3841359441623355395:qk]&quot;' value='C' />
          <alias key='&quot;[federated.1xh22f407xbc4b1ga3d7g0lg40ml].[sum:Vendor Grade C (copy)_3841359441623470084:qk]&quot;' value='D' />
        </aliases>
      </column>
      <column caption='latest day' datatype='date' name='[Calculation_2367486093342629892]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([report_date])}' />
      </column>
      <column caption='Previous Day' datatype='date' name='[Calculation_2367486093342789637]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_2367486093342629892]-1' />
      </column>
      <column caption='score latest day' datatype='integer' name='[Calculation_2367486093342920710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([report_date] = [Calculation_2367486093342629892]) * [Calculation_5472788404530376704]' />
      </column>
      <column caption='A' datatype='integer' name='[Calculation_3841359441622007808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [vendor_grade] = &quot;A&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
      </column>
      <column caption='vendor grade score' datatype='integer' name='[Calculation_5472788404530376704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_won] THEN&#10;  CASE [vendor_grade]&#10;    WHEN &quot;A&quot; THEN 10&#10;    WHEN &quot;B&quot; THEN 7&#10;    WHEN &quot;C&quot; THEN 5&#10;    WHEN &quot;D&quot; THEN 1&#10;    ELSE 1&#10;  END&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_6022368298949406720]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_754423369901895683] = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Exclude Current Date' datatype='boolean' name='[Calculation_6023846040454131713]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] = TODAY()' />
      </column>
      <column caption='current month sort' datatype='integer' name='[Calculation_6023846040460034051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED MONTH([report_date]), [full_name_internal_non_pii] : &#10;    SUM(IF DATEPART(&apos;month&apos;, [report_date]) = DATEPART(&apos;month&apos;, TODAY()) &#10;         AND DATEPART(&apos;year&apos;, [report_date]) = DATEPART(&apos;year&apos;, TODAY()) &#10;    THEN [Calculation_5472788404530376704] END) &#10;}' />
      </column>
      <column caption='fix null' datatype='string' name='[Calculation_6942650736067768321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([vendor_grade]) THEN &quot;null&quot; &#10;ELSEIF [vendor_grade] = &quot;&quot; THEN &quot;null&quot; &#10;ELSE [vendor_grade] &#10;END' />
      </column>
      <column caption='DoD' datatype='boolean' name='[Calculation_754423369897209856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;= DATE(TODAY() - 2) AND [report_date] &lt;= DATE(TODAY() -1)' />
      </column>
      <column caption='rank total' datatype='integer' name='[Calculation_754423369901895683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(WINDOW_SUM(SUM([Calculation_5472788404530376704])), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall Activations' datatype='integer' name='[Calculation_754423369903165445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED MONTH([report_date]),[full_name_internal_non_pii] : COUNTD([sf_opportunity_id]) }' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_754423369903431687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Ungraded' datatype='integer' name='[D (copy)_4160200221860511744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;  IF ([Calculation_6942650736067768321] = &quot;null&quot; OR [vendor_grade] = &quot;Ungraded&quot;)&#10;     AND NOT ISNULL([sf_opportunity_id])&#10;  THEN [sf_opportunity_id]&#10;END)' />
      </column>
      <column caption='WoW' datatype='string' name='[DoD (copy)_6023846040454856706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;week&apos;, [report_date]) = DATETRUNC(&apos;week&apos;, TODAY()) THEN &apos;This Week&apos;&#10;ELSEIF DATETRUNC(&apos;week&apos;, [report_date]) = DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Last Week&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='Overall Score' datatype='integer' name='[Overall Activations (copy)_5472788404530995201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED MONTH([report_date]),[full_name_internal_non_pii] : SUM([Calculation_5472788404530376704]) }' />
      </column>
      <column caption='B' datatype='integer' name='[Vendor Grade A (copy)_3841359441623232514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [vendor_grade] = &quot;B&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
      </column>
      <column caption='C' datatype='integer' name='[Vendor Grade A (copy)_3841359441623355395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [vendor_grade] = &quot;C&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
      </column>
      <column caption='D' datatype='integer' name='[Vendor Grade C (copy)_3841359441623470084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [vendor_grade] = &quot;D&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
      </column>
