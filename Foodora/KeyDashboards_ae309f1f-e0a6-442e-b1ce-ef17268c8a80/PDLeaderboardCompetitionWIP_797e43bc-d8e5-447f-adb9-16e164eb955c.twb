      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4E285F6D8BFC44A299CE4E15B55A2863'>
            <properties context=''>
              <relation connection='bigquery.0rcvxho0k0u63o17cn6ig0ng1n4z' name='Custom SQL Query' type='text'>WITH 

sf_account AS (
    SELECT
      sf_accounts.global_entity_id,
      sf_accounts.vendor_code,
      sf_accounts.name AS account_name,
      sf_accounts.id AS account_id,
      sf_accounts.sf_owner_id AS owner_id,
      sf_accounts.owner_name,
      sf_accounts.created_at_utc,
      sf_accounts.gmv_class AS sf_gmv_class,
      sf_accounts.vendor_grade AS sf_vendor_grade,
      sf_accounts.vertical_segment AS sf_vertical_segment,
      sf_accounts.primary_cuisine AS sf_primary_cuisine,
      sf_accounts.category AS sf_category,
      CASE WHEN NOT has_mark_up OR mark_up_type IS NULL THEN &quot;No mark-up&quot;
          WHEN has_mark_up THEN mark_up_type
          ELSE mark_up_type
      END AS markup_type_use,
      sf_accounts.has_mark_up,
      sf_accounts.mark_up_type,
      sf_accounts.mark_up_value_local AS mark_up_value,
      sf_accounts.invoice_frequency AS billing_interval,
      sf_accounts.exclude_from_options LIKE &quot;%Sanctions%&quot; AS excluded_from_sanctions,
      COALESCE(sf_accounts.status, &quot;Null&quot;) AS sf_account_status,
      sf_accounts.account_classification
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS sf_accounts
    QUALIFY
      ROW_NUMBER() OVER (PARTITION BY sf_accounts.global_entity_id, sf_accounts.vendor_code ORDER BY sf_accounts.global_entity_id ASC, sf_accounts.vendor_code ASC, sf_accounts.created_at_utc DESC) = 1),
am_base AS(
  SELECT 
  global_entity_id,
  vendor_code,
  owner_name    
  FROM sf_account
  WHERE global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;) 

),
vfd_base AS (
SELECT
  DATE_TRUNC(created_date_local, MONTH) AS report_date,
  global_entity_id,
  vendor_code,
  SUM(gmv_eur) AS gmv_eur,
  SUM(total_incentive_cost_vendor_eur) AS vfd_eur
FROM `fulfillment-dwh-production.pandata_report.commercial__vfd_orders`
WHERE created_date_local &gt;&gt;= &quot;2025-04-01&quot;
AND global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;)
GROUP BY ALL
),

cpc AS (
SELECT 
date_month AS report_month,
global_entity_id, 
vendor_id,
SUM(cpc_revenue) AS cpc_rev_eur
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.ad_tech_il_cpc` 
WHERE date_month &gt;&gt;= &quot;2025-04-01&quot;
  AND global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;)
  GROUP BY
date_month,
global_entity_id, 
vendor_id
),

joker AS (
SELECT report_month,
global_entity_id, 
vendor_id, 
SUM(joker_revenue_eur) AS joker_rev_eur 
FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.ad_tech_il_joker_vendors_monthly` 
WHERE report_month &gt;&gt;= &quot;2025-04-01&quot;
  AND global_entity_id IN (&quot;FO_NO&quot;, &quot;FP_TW&quot;, &quot;DJ_CZ&quot;, &quot;FP_SG&quot;, &quot;FP_TH&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;,
      &quot;FP_BD&quot;, &quot;NP_HU&quot;, &quot;MJM_AT&quot;, &quot;YS_TR&quot;, &quot;OP_SE&quot;, &quot;PO_FI&quot;, &quot;FP_PH&quot;, &quot;FP_HK&quot;, &quot;FP_PK&quot;)
GROUP BY report_month, 
global_entity_id, 
vendor_id
)

SELECT 
  vfd_base.report_date,
  vfd_base.global_entity_id,
  am_base.owner_name AS account_manager,
  SUM(vfd_base.gmv_eur) AS gmv_eur,
  SUM(vfd_base.vfd_eur) AS vfd_eur,
  SUM(cpc.cpc_rev_eur) AS cpc_rev_eur,
  SUM(joker.joker_rev_eur) AS joker_rev_eur

FROM  vfd_base
LEFT JOIN cpc
       ON vfd_base.report_date = cpc.report_month
      AND vfd_base.global_entity_id = cpc.global_entity_id
      AND vfd_base.vendor_code = cpc.vendor_id
LEFT JOIN joker
       ON vfd_base.report_date = joker.report_month
      AND vfd_base.global_entity_id = joker.global_entity_id
      AND vfd_base.vendor_code = joker.vendor_id 
LEFT JOIN am_base
       ON vfd_base.global_entity_id = am_base.global_entity_id
      AND vfd_base.vendor_code = am_base.vendor_code    
      GROUP BY   
      vfd_base.report_date,
      vfd_base.global_entity_id,
      am_base.owner_name</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='field sales' inline='true' name='federated.1xh22f407xbc4b1ga3d7g0lg40ml' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0tgfkhp0ro8b2t191kzf70c5kq9y'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='theeranop.wongtitirote@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0tgfkhp0ro8b2t191kzf70c5kq9y' name='Custom SQL Query' type='text'>WITH date_cte AS (
  -- Generate daily dates from April 1, 2025, to today
  SELECT date_value AS report_date
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE &apos;2025-03-01&apos;, CURRENT_DATE(), INTERVAL 1 DAY)) AS date_value
),

users_monthly AS (
  -- Extract all users from April 1, 2025, onward
  SELECT
    users.report_date,
    users.country,
    countries.global_entity_id,
    users.full_name_internal_non_pii,
    users.email_internal_non_pii,
    users.sf_user_id,
    users.central_job_role,
    users.title,
    users.job_role_vertical,
    users.user_type,
    users.account_age_snapshot,
    users.is_active_snapshot,
    users.is_contractor,
    ROW_NUMBER() OVER (PARTITION BY users.sf_user_id ORDER BY report_date DESC) = 1 AS is_latest
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
          ON users.country = countries.name
  WHERE users.report_date &gt;&gt;= DATE &apos;2025-03-01&apos;
  AND user_type = &quot;field rep&quot; 
  AND is_active_snapshot
),


activations AS (
SELECT 
global_entity_id,
country,
vendor_type,
vendor_grade,
is_key_vip_account,
key_account_sub_category,
account_created_date_utc,
activation_date,
vendor_code,
global_vendor_id,
vendor_name,
sf_opportunity_id,
user_type,
full_name_internal_non_pii,
is_won,
is_closed,
opportunity_business_type,
sf_opp_created_by_user_id,
sf_opportunity_owner_id
 FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` 
WHERE user_type = &quot;field rep&quot;
AND activation_date &gt;&gt;= &quot;2025-03-01&quot;
AND LOWER(vendor_type) = &quot;restaurants&quot;
AND is_won
AND is_closed
AND ((country IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;Legal Form Change&apos;, &apos;New Business&apos;, &apos;Owner Change&apos;, &apos;Win Back&apos;))
    OR
    (country NOT IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)))
)
-- Cross join to get every user on every date
SELECT 
  date_cte.report_date,
  users_monthly.full_name_internal_non_pii,
  users_monthly.country AS user_country,
  users_monthly.sf_user_id,
  users_monthly.central_job_role,
  users_monthly.account_age_snapshot,
  users_monthly.is_active_snapshot,
  users_monthly.is_contractor,
  activations.country,
activations.vendor_type,
activations.vendor_grade,
activations.is_key_vip_account,
activations.key_account_sub_category,
activations.account_created_date_utc,
activations.activation_date,
activations.vendor_code,
activations.global_vendor_id,
activations.vendor_name,
activations.sf_opportunity_id,
activations.user_type,
activations.is_won,
activations.is_closed,
activations.opportunity_business_type,
activations.sf_opp_created_by_user_id,
activations.sf_opportunity_owner_id
FROM date_cte
CROSS JOIN users_monthly
LEFT JOIN activations
ON users_monthly.sf_user_id = activations.sf_opportunity_owner_id
AND date_cte.report_date = activations.activation_date
WHERE users_monthly.is_latest
ORDER BY date_cte.report_date</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
