    <worksheet name='sum score (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>#Activations &amp; Overall Score</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='telesales' name='federated.1xh22f407xbc4b1ga3d7g0lg40ml (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1xh22f407xbc4b1ga3d7g0lg40ml (copy)'>
            <column caption='A' datatype='integer' name='[Calculation_3841359441622007808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [vendor_grade] = &quot;A&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
            </column>
            <column caption='vendor grade score' datatype='integer' name='[Calculation_5472788404530376704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_won] THEN&#10;  CASE [vendor_grade]&#10;    WHEN &quot;A&quot; THEN 10&#10;    WHEN &quot;B&quot; THEN 7&#10;    WHEN &quot;C&quot; THEN 5&#10;    WHEN &quot;D&quot; THEN 1&#10;    ELSE 1&#10;  END&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Exclude Current Date' datatype='boolean' name='[Calculation_6023846040454131713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] = TODAY()' />
            </column>
            <column caption='rank total' datatype='integer' name='[Calculation_754423369901895683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(WINDOW_SUM(SUM([Calculation_5472788404530376704])), &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Overall Activations' datatype='integer' name='[Calculation_754423369903165445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH([report_date]),[full_name_internal_non_pii] : COUNTD([sf_opportunity_id]) }' />
            </column>
            <column caption='Ungraded' datatype='integer' name='[D (copy)_4160200221860511744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ISNULL([vendor_grade]) OR [vendor_grade] = &quot;Ungraded&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
            </column>
            <column caption='Overall Score' datatype='integer' name='[Overall Activations (copy)_5472788404530995201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED MONTH([report_date]),[full_name_internal_non_pii] : SUM([Calculation_5472788404530376704]) }' />
            </column>
            <column caption='B' datatype='integer' name='[Vendor Grade A (copy)_3841359441623232514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [vendor_grade] = &quot;B&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
            </column>
            <column caption='C' datatype='integer' name='[Vendor Grade A (copy)_3841359441623355395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [vendor_grade] = &quot;C&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
