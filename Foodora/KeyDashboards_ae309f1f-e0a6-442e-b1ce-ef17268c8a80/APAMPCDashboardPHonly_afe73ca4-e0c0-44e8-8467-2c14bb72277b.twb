          <calculation class='tableau' formula='ifnull([Calculation_1468454956601208833],0) + ifnull([Calculation_1468454956601434114],0) + ifnull([Calculation_1468454956601987077],0)' />
        </column>
        <column datatype='integer' name='[cpc_vendors]' role='measure' type='quantitative' />
