      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='latest query' id='_C5A6D8CF5F8C40C7BA6A69092A7199D5'>
            <properties context=''>
              <relation connection='bigquery.053tt3v1esx8ne13dht1p0zv1gam' name='Custom_SQL_Query' type='text'><![CDATA[WITH 

months as (
SELECT
DISTINCT
format_date('%Y%m',date) as year_month
FROM `fulfillment-dwh-production.pandata_curated.shared_dates`
WHERE date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH),INTERVAL 13 MONTH)
AND date <<= DATE_SUB(DATE_ADD(DATE_TRUNC(CURRENT_DATE(),MONTH),INTERVAL 1 MONTH),INTERVAL 1 DAY)
),


vendors AS (

SELECT

year_month,
v.global_entity_id,
v.vendor_code,
gmv_class.gmv_class

FROM months m
CROSS JOIN  `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` v 
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_gmv_class` AS gmv_class
         ON gmv_class.global_entity_id = v.global_entity_id
        AND gmv_class.vendor_code = v.vendor_code

where v.global_entity_id IN ("FP_BD","FP_PK","FP_SG","FP_MY","FP_TH","FP_TW","FP_HK","FP_PH","FP_LA","FP_KH","FP_MM","FP_JP")
ORDER BY 3,1 asc
),


active_in_month as (

SELECT 
global_entity_id,
month,
format_date('%Y%m',month) as year_month,
format_date('%b',month) as month_name,
vendor_code,
gmv_class,
CASE 
when active_in_month IS FALSE THEN FALSE
when (not_private_in_month IS FALSE OR not_test_in_month IS FALSE) THEN FALSE
ELSE TRUE
END AS vendor_active

FROM 

(SELECT 
s.global_entity_id,
date_trunc(report_date,month) as month,
s.vendor_code,
gmv_class.gmv_class,

logical_or(s.is_active IS TRUE) as active_in_month,
logical_or(s.is_private IS FALSE) as not_private_in_month, 
logical_or(s.is_test IS FALSE) as not_test_in_month, 

FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_status` s 
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_gmv_class` AS gmv_class
         ON gmv_class.global_entity_id = s.global_entity_id
        AND gmv_class.vendor_code = s.vendor_code

WHERE date_trunc(report_date,month) >>= DATE_SUB(DATE_TRUNC(current_date,MONTH),INTERVAL 13 MONTH) 
GROUP BY 1,2,3,4
ORDER BY 3,2 asc)),

vendors_live as (
SELECT *
FROM (
SELECT 
v.*,
a.vendor_active,
CASE 
WHEN a.vendor_active IS NULL THEN FALSE 
ELSE a.vendor_active
end as is_vendor_active,
sf.owner_name,
bt.is_home_based_kitchen

FROM vendors v
left join active_in_month a ON v.global_entity_id = a.global_entity_id and v.vendor_code = a.vendor_code and v.year_month = a.year_month 
left join `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` sf on sf.global_entity_id = v.global_entity_id and sf.vendor_code = v.vendor_code 
left join `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` bt on bt.global_entity_id = v.global_entity_id and bt.vendor_code = v.vendor_code 

where business_type_apac = 'restaurants'

ORDER BY vendor_code,year_month asc)

WHERE is_vendor_active IS TRUE),

monthly_vendors as (SELECT
global_entity_id,
year_month,
owner_name,
vendors_live.gmv_class,
count(distinct vendor_code) as active_vendors,
is_home_based_kitchen

FROM vendors_live
GROUP BY 1,2,3,4,6
ORDER BY 1,2),

monthly_gmv as ( select
o.global_entity_id,
sf.owner_name,
format_date('%Y%m',o.created_date_local) as yearmonth,
gmv_class.gmv_class,
bt.is_home_based_kitchen,
CAST(sum(gmv_local) AS INT64) as total_gmv,
CAST(sum(gfv_local) AS INT64) as total_gfv,
CAST(sum(gmv_eur) AS INT64) as total_gmv_eur,
CAST(sum(gfv_eur) AS INT64) as total_gfv_eur

from `fulfillment-dwh-production.pandata_report.pandora_pd_orders_agg_jkr_deals` o
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` v on o.global_entity_id = v.global_entity_id and o.vendor_code = v.vendor_code
LEFT JOIN vendors_live vl on o.global_entity_id = vl.global_entity_id and o.vendor_code = vl.vendor_code and vl.year_month = format_date('%Y%m',o.created_date_local) 
left join `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` sf on sf.global_entity_id = o.global_entity_id and sf.vendor_code = o.vendor_code
left join `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` bt on bt.global_entity_id = o.global_entity_id and bt.vendor_code = o.vendor_code 
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_gmv_class` AS gmv_class
         ON gmv_class.global_entity_id = o.global_entity_id
        AND gmv_class.vendor_code = o.vendor_code

where 
is_valid_order = TRUE
and is_test_order = FALSE
and bt.business_type_apac = 'restaurants'
and v.is_test = FALSE
and v.is_private = FALSE
and o.created_date_local >>= DATE_SUB(DATE_TRUNC(current_date,MONTH),INTERVAL 13 MONTH)
and o.global_entity_id IN ("FP_BD","FP_PK","FP_SG","FP_MY","FP_TH","FP_TW","FP_HK","FP_PH","FP_LA","FP_KH","FP_MM","FP_JP")
GROUP BY 1,2,3,4,5)

SELECT mv.*,
c.name as country,
gmv.total_gmv,
gmv.total_gfv,
total_gmv_eur,
total_gfv_eur
FROM monthly_vendors mv
left join monthly_gmv gmv
on mv.global_entity_id = gmv.global_entity_id and mv.owner_name =  gmv.owner_name
and mv.year_month = gmv.yearmonth 
and mv.gmv_class = gmv.gmv_class
and mv.is_home_based_kitchen = gmv.is_home_based_kitchen
left join `fulfillment-dwh-production.pandata_curated.shared_countries` c on mv.global_entity_id = c.global_entity_id 


ORDER BY global_entity_id,yearmonth asc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='AM Incentives: CPC' inline='true' name='federated.1dikdbs04w98uf1aimqrh1ebxk0v' version='18.1'>
