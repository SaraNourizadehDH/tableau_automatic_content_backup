   cpc.is_sam,
   sum(cpc.cpc_rev_local) as CPC_rev_local,
   sum(cpc.cpc_rev_eur) as CPC_rev_eur,
   sum(cpc.final_budget_local) as CPC_final_budget_local,
   sum(cpc.final_budget_eur) as CPC_final_budget_eur,
   count(distinct cpc.vendor_code) as cpc_vendors
   from cpc 
