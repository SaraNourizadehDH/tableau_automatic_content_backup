      <column datatype='real' name='[CPC_final_budget_local]' role='measure' type='quantitative' />
      <column datatype='real' name='[CPP_PR_rev_local]' role='measure' type='quantitative' />
      <column datatype='real' name='[CPP_noPR_rev_local]' role='measure' type='quantitative' />
      <column caption='vendors' datatype='integer' name='[Calculation_1095500652616114176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column aggregation='Sum' caption='day' datatype='integer' name='[Calculation_111745599581163520]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='day(now())' />
      </column>
      <column caption='last day of month' datatype='integer' name='[Calculation_111745599582101505]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='day(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,now())))))' />
      </column>
      <column caption='PB estimate' datatype='real' name='[Calculation_111745599583866883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull((if([year_month]=[current_year_month])then[Calculation_1468454956601208833]/([Calculation_111745599581163520]-1)*[Calculation_111745599582101505] else [Calculation_1468454956601208833] END),0)' />
      </column>
      <column caption='CPC utilisation%' datatype='real' name='[Calculation_111745599607861259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc_rev_local])/sum([CPC_final_budget_local])' />
      </column>
      <column caption='previous util%' datatype='real' name='[Calculation_111745599609675789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([year_month]) = sum([prev_year_month]) then sum([cpc_rev_local])/sum([CPC_final_budget_local]) end' />
      </column>
      <column caption='CPC estimate' datatype='real' name='[Calculation_111745599612846095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(if(sum([year_month])=sum([current_year_month]))&#10;then max((lookup([Calculation_111745599607861259],-1)*sum([Calculation_1468454956601667587])),&#10;sum([Calculation_1468454956601434114])) else sum([Calculation_1468454956601434114]) end,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Estimates' datatype='real' name='[Calculation_111745599624507408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull((  &#10;sum(IFNULL([Calculation_111745599583866883],0))+ifnull([Calculation_111745599612846095],0)+sum(ifnull([Calculation_1468454956601987077],0))),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='PB Rev' datatype='real' name='[Calculation_1468454956601208833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = true then [PB_rev_local] else [PB_rev_eur] end' />
      </column>
      <column caption='CPC Rev' datatype='real' name='[Calculation_1468454956601434114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = true then [cpc_rev_local] else [cpc_rev_eur] end' />
      </column>
      <column caption='CPC Budget' datatype='real' name='[Calculation_1468454956601667587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = true then [CPC_final_budget_local] else [CPC_final_budget_eur] end' />
      </column>
      <column caption='Pro-Rated CPP Rev' datatype='real' name='[Calculation_1468454956601798660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = true then [CPP_PR_rev_local] else [CPP_PR_rev_eur] end' />
      </column>
      <column caption='CPP Rev' datatype='real' name='[Calculation_1468454956601987077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = true then [CPP_noPR_rev_local] else [CPP_noPR_rev_eur] end' />
      </column>
      <column caption='Total (Pro-rated)' datatype='real' name='[Calculation_3342022829691453441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull([Calculation_1468454956601208833],0) + ifnull([Calculation_1468454956601434114],0) + ifnull([Calculation_1468454956601798660],0)' />
      </column>
      <column caption='is_prev_month' datatype='integer' name='[Calculation_3342022829694746628]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [year_month] = [prev_year_month] then 1&#10;else 0&#10;END' />
      </column>
      <column caption='date selector (prevmonth)' datatype='integer' name='[Calculation_779122772635557888]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='count (if [year_month] =[prev_year_month] then 1 end)' />
      </column>
      <column caption='dater selector (current month)' datatype='integer' name='[Calculation_779122772636348417]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [year_month] = [current_year_month]THEN 1 else 0 end' />
      </column>
      <column caption='vendor on ads' datatype='integer' name='[Calculation_785878175232348160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='p util' datatype='real' name='[Calculation_919789892264058882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP([Calculation_111745599607861259],-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='p month' datatype='integer' name='[Calculation_919789892269731843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_month] = [current_year_month]-1 then 1 end' />
      </column>
      <column caption='Total Estimates diff MOM' datatype='real' name='[Calculation_919789892301602821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_111745599624507408] - lookup([Calculation_111745599624507408],-1))/(lookup([Calculation_111745599624507408],-1))'>
          <table-calc ordering-type='Rows' />
