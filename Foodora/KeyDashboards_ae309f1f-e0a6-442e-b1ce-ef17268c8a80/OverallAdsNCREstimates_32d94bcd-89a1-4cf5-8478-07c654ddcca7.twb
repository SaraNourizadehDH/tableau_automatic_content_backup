    <worksheet name='MBR data'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_report)' name='federated.1fohas21lmmdxc11euiux1r05zdo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fohas21lmmdxc11euiux1r05zdo'>
            <column caption='Joker Self-booking Vendors, % ' datatype='real' name='[CPC Self-booking Vendors, % (copy)_3578039587094884354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// CPC Self-booking Vendors % (weighted, ratio-of-sums)&#10;IIF(&#10;    { FIXED [region], [report_month], [record_type] :&#10;        SUM( IF [metric_name] = &apos;joker_vendors&apos;&#10;             AND [booking_source] = &apos;Total&apos;&#10;             AND [record_type] = &apos;Monthly Actuals&apos;&#10;             THEN [value] END )&#10;    } = 0,&#10;    NULL,&#10;    { FIXED [region], [report_month], [record_type] :&#10;        SUM( IF [metric_name] = &apos;joker_vendors&apos;&#10;             AND [booking_source] = &apos;Self-booking&apos;&#10;             AND [record_type] = &apos;Monthly Actuals&apos;&#10;             THEN [value] END )&#10;    }&#10;    /&#10;    { FIXED [region], [report_month], [record_type] :&#10;        SUM( IF [metric_name] = &apos;joker_vendors&apos;&#10;             AND [booking_source] = &apos;Total&apos;&#10;             AND [record_type] = &apos;Monthly Actuals&apos;&#10;             THEN [value] END )&#10;    }&#10;)' />
            </column>
            <column caption='Estimated Ads over GMV, %' datatype='real' name='[Calculation_3578039587092590592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ads over GMV % — correct, weighted, respects Team &amp; Currency&#10;IIF(&#10;    { FIXED [region], [global_entity_id], [team], [report_month], [Parameters].[Parameter 1] :&#10;        SUM( IIF(TRIM([metric_name])=&apos;gmv_total&apos;&#10;                 AND [record_type]=&apos;Monthly Actuals&apos;&#10;                 AND [booking_source]=&apos;Total&apos;,&#10;                 [value], 0) )&#10;    } = 0,&#10;    NULL,&#10;    { FIXED [region], [global_entity_id], [team], [report_month], [Parameters].[Parameter 1] :&#10;        SUM( IIF(TRIM([metric_name])=&apos;ncr_revenue_total&apos;&#10;                 AND [record_type]=&apos;Monthly Actuals&apos;&#10;                 AND [booking_source]=&apos;Total&apos;,&#10;                 [value], 0) )&#10;    }&#10;    /&#10;    { FIXED [region], [global_entity_id], [team], [report_month], [Parameters].[Parameter 1] :&#10;        SUM( IIF(TRIM([metric_name])=&apos;gmv_total&apos;&#10;                 AND [record_type]=&apos;Monthly Actuals&apos;&#10;                 AND [booking_source]=&apos;Total&apos;,&#10;                 [value], 0) )&#10;    }&#10;)' />
            </column>
            <column caption='CPC Self-booking Vendors, %' datatype='real' name='[Calculation_3578039587094573057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// CPC Self-booking Vendors % (weighted, ratio-of-sums)&#10;IIF(&#10;    { FIXED [region], [global_entity_id], [team], [report_month], [record_type] :&#10;        SUM( IF [metric_name] = &apos;cpc_vendors&apos;&#10;             AND [booking_source] = &apos;Total&apos;&#10;             AND [record_type] = &apos;Monthly Actuals&apos;&#10;             THEN [value] END )&#10;    } = 0,&#10;    NULL,&#10;    { FIXED [region], [global_entity_id], [team], [record_type] :&#10;        SUM( IF [metric_name] = &apos;cpc_vendors&apos;&#10;             AND [booking_source] = &apos;Self-booking&apos;&#10;             AND [record_type] = &apos;Monthly Actuals&apos;&#10;             THEN [value] END )&#10;    }&#10;    /&#10;    { FIXED [region], [global_entity_id], [team], [record_type] :&#10;        SUM( IF [metric_name] = &apos;cpc_vendors&apos;&#10;             AND [booking_source] = &apos;Total&apos;&#10;             AND [record_type] = &apos;Monthly Actuals&apos;&#10;             THEN [value] END )&#10;    }&#10;)' />
            </column>
            <column caption='Value final' datatype='real' name='[Calculation_3578039587095916547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([metric_name])&#10;WHEN &apos;ads_over_gmv&apos; THEN&#10;    AVG([Calculation_3578039587092590592])     // already an aggregate (LOD)&#10;WHEN &apos;CPC Self-booking Vendors, %&apos; THEN&#10;    AVG([Calculation_3578039587094573057])&#10;WHEN &apos;Joker Self-booking Vendors, %&apos; THEN&#10;    AVG([CPC Self-booking Vendors, % (copy)_3578039587094884354])&#10;ELSE&#10;    MAX([value])                       &#10;END' />
            </column>
            <column caption='Color Metric' datatype='string' name='[Calculation_3725391732446957568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([metric_name] IN (&quot;menu_sessions&quot;, &quot;ads_over_gmv&quot;, &quot;gmv_total&quot;, &quot;ads_contribution&quot;)) THEN &apos;Color&apos;&#10;ELSEIF [metric_name] IN (&quot;ncr_revenue_total&quot;) THEN &apos;Bold&apos;&#10;ELSE &apos;Normal&apos;&#10;END' />
            </column>
            <column caption='Currency Filter' datatype='boolean' name='[Calculation_5839691010193915906]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[currency] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Percentage formatting' datatype='real' default-format='p0.00%' name='[Calculation_5839691010198446084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#10;    ATTR([record_type]) = &quot;Estimate vs Budget %&quot; OR&#10;    ATTR([record_type]) = &quot;Current Month&apos;s Estimate vs Last month %&quot; OR&#10;    ATTR([record_type]) = &quot;Current Month Estimate vs Target %&quot; OR&#10;    ATTR([record_type]) = &quot;Last Month vs Budget %&quot; OR&#10;    ATTR([record_type]) = &quot;MoM, %&quot; OR&#10;    ATTR([metric_name]) = &quot;ads_over_gmv&quot; OR&#10;    ATTR([metric_name]) = &quot;ads_contribution&quot; OR&#10;    ATTR([metric_name]) = &quot;CPC Vendor Penetration&quot; OR&#10;    ATTR([metric_name]) = &quot;Joker Vendor Penetration&quot; OR&#10;    ATTR([metric_name]) = &quot;Display Ads Vendor Penetration&quot; OR&#10;    ATTR([metric_name]) = &quot;Deals Targeting Vendor Penetration&quot; OR&#10;    ATTR([metric_name]) = &quot;CPC Self-booking Vendors, %&quot; OR&#10;    ATTR([metric_name]) = &quot;Joker Self-booking Vendors, %&quot;&#10;) THEN&#10;    [Calculation_3578039587095916547] * 1.0   &#10;END' />
            </column>
            <column caption='Absolute Values' datatype='real' name='[Calculation_5839691010198962181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([record_type]) != &quot;Estimate vs Budget %&quot;&#10;   AND ATTR([record_type]) != &quot;Current Month&apos;s Estimate vs Last month %&quot;&#10;   AND ATTR([record_type]) != &quot;MoM, %&quot;&#10;   AND ATTR([record_type]) != &quot;Last Month vs Budget %&quot;&#10;   AND ATTR([record_type]) != &quot;Current Month Estimate vs Target %&quot;&#10;AND NOT (&#10;    ATTR([metric_name]) = &quot;ads_over_gmv&quot;&#10;    OR ATTR([metric_name]) = &quot;ads_contribution&quot;&#10;    OR ATTR([metric_name]) = &quot;CPC Vendor Penetration&quot;&#10;    OR ATTR([metric_name]) = &quot;Joker Vendor Penetration&quot;&#10;    OR ATTR([metric_name]) = &quot;Display Ads Vendor Penetration&quot;&#10;    OR ATTR([metric_name]) = &quot;Deals Targeting Vendor Penetration&quot;&#10;    OR ATTR([metric_name]) = &quot;CPC Self-booking Vendors, %&quot;&#10;    OR ATTR([metric_name]) = &quot;Joker Self-booking Vendors, %&quot;&#10;)&#10;THEN [Calculation_3578039587095916547]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Booking Source' datatype='string' name='[booking_source]' role='dimension' type='nominal' />
            <column datatype='string' name='[currency]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;DJ_CZ&quot;' value='Czech Republic' />
                <alias key='&quot;FO_NO&quot;' value='Norway' />
                <alias key='&quot;FP_BD&quot;' value='Bangladesh' />
                <alias key='&quot;FP_HK&quot;' value='Hong Kong' />
                <alias key='&quot;FP_KH&quot;' value='Cambodia' />
                <alias key='&quot;FP_LA&quot;' value='Laos' />
                <alias key='&quot;FP_MM&quot;' value='Myanmar' />
                <alias key='&quot;FP_MY&quot;' value='Malaysia' />
                <alias key='&quot;FP_PH&quot;' value='Philippines' />
                <alias key='&quot;FP_PK&quot;' value='Pakistan' />
                <alias key='&quot;FP_SG&quot;' value='Singapore' />
                <alias key='&quot;FP_TH&quot;' value='Thailand' />
                <alias key='&quot;FP_TW&quot;' value='Taiwan' />
                <alias key='&quot;MJM_AT&quot;' value='Austria' />
                <alias key='&quot;NP_HU&quot;' value='Hungary' />
                <alias key='&quot;OP_SE&quot;' value='Sweden' />
                <alias key='&quot;PO_FI&quot;' value='Finland' />
                <alias key='&quot;YS_TR&quot;' value='Turkey' />
              </aliases>
            </column>
            <column caption='Metric Name' datatype='string' name='[metric_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;ad_credits_consumed&quot;' value='CPC Ad Credits Utilized' />
                <alias key='&quot;ads_contribution&quot;' value='Ads Contribution (% of Country&apos;s Total)' />
                <alias key='&quot;ads_over_gfv&quot;' value='Ads Over GFV' />
                <alias key='&quot;ads_over_gmv&quot;' value='Estimated Ads Over GMV, %' />
                <alias key='&quot;CPC Vendor Penetration&quot;' value='CPC Vendor Penetration, %' />
                <alias key='&quot;cpc_budget&quot;' value='CPC Booked Budget' />
                <alias key='&quot;cpc_net_revenue&quot;' value='CPC Net Revenue' />
                <alias key='&quot;cpc_revenue&quot;' value='CPC Revenue' />
