                      <formatted-text>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Disco MAU: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Customers with at least 1 Disco Order</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Other Incentives MAU: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Customers with at least 1 Incentivized Order (excluding Disco MAU)</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Organic MAU: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Customers with zero Incentivized Order</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Disco Orders: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Disco Orders</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Other Incentives Orders: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Orders with incentives (excluding Disco Orders)</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Organic Orders: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Orders without any incentives</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>PM Acquisitions: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Acquisitions from PM Channels</run>
                        <run>Æ&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Non-PM Acquisitions: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Acquisitions from non-PM Channels</run>
                        <run>Æ&#10;&#10;</run>
                        <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>Android Pandora Downloads: </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>No. of Android Downloads (Data is retrieved from data.ai &quot;</run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12' italic='true'>previously called App Annie&quot; </run>
                        <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>)</run>
