    <dashboard name='L12M Summary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/DemandDashboard-Pandora_17304540594900/L12MSummary?rev=' id='L12MSummary' path='/t/Foodora/workbooks/DemandDashboard-Pandora_17304540594900' revision='' site='Foodora' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='font-family' value='Tableau Regular' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-family' value='Tableau Medium' />
          <format attr='color' value='#b8209d' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='demand_dash_cumulative' name='federated.0v22jyc1axib0m15jci161k7y21w' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
          <members>
            <member value='&quot;EUR&quot;' />
            <member value='&quot;LC&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0v22jyc1axib0m15jci161k7y21w'>
        <column caption='Overall Vertical' datatype='string' name='[Calculation_2184386621169623040]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([vertical_per_origin], [vertical])' />
        </column>
        <column caption='Region' datatype='string' name='[Calculation_5015672983521988608]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [country]&#10;WHEN IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Austria&quot;, &quot;Hungary&quot;, &quot;Sweden&quot;, &quot;Turkey&quot;) THEN &quot;EU&quot;&#10;ELSE &quot;APAC&quot;&#10;END' />
        </column>
        <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column-instance column='[Calculation_2184386621169623040]' derivation='None' name='[none:Calculation_2184386621169623040:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_5015672983521988608]' derivation='None' name='[none:Calculation_5015672983521988608:nk]' pivot='key' type='nominal' />
        <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
        <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
        <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
        <column caption='Vertical' datatype='string' name='[vertical]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='1018' param='horz' type-v2='layout-flow' w='99000' x='500' y='889'>
            <zone h='98222' id='418' type-v2='layout-basic' w='99000' x='500' y='889'>
              <zone h='10292' id='16' param='horz' type-v2='layout-flow' w='99000' x='500' y='889'>
                <zone forceUpdate='true' h='10292' id='5' type-v2='text' w='99000' x='500' y='889'>
                  <formatted-text>
                    <run bold='true' fontalignment='0' fontcolor='#b8209d' fontname='Tableau Medium' fontsize='20'>Demand Report - L12M Summary</run>
                  </formatted-text>
                  <zone-style>
