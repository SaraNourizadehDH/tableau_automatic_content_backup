      </column>
      <column caption='Region' datatype='string' name='[Calculation_5015672983521988608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country]&#10;WHEN IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Austria&quot;, &quot;Hungary&quot;, &quot;Sweden&quot;, &quot;Turkey&quot;) THEN &quot;EU&quot;&#10;ELSE &quot;APAC&quot;&#10;END' />
      </column>
      <column caption='Dimension Axis' datatype='string' name='[Calculation_552042800544985089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Country&apos; THEN [country]&#10;    WHEN &apos;Verticals&apos; THEN [vertical]&#10;    WHEN &apos;Time&apos; THEN STR([time_aggregation_value])&#10;END' />
      </column>
      <column caption='time_aggregation_string_description' datatype='string' hidden='true' name='[Calculation_552042800545533954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [time_aggregation] =&apos;DAY&apos; then DATENAME(&apos;month&apos;,[time_aggregation_value]) +&apos; &apos;+ STR(DAY([time_aggregation_value]))+&apos;, &apos;+STR(YEAR([time_aggregation_value]))&#10;ELSEIF [time_aggregation] = &apos;WEEK&apos; then &apos;Week &apos;+ STR(WEEK([time_aggregation_value]))+&apos;, &apos;+ STR(YEAR([time_aggregation_value]))&#10;elseif [time_aggregation] = &apos;MONTH&apos; then DATENAME(&apos;month&apos;,[time_aggregation_value]) +&apos;, &apos;+ STR(YEAR([time_aggregation_value])) &#10;ELSEIF [time_aggregation] = &apos;QUARTER&apos; THEN &apos;Quarter &apos; + STR(QUARTER([time_aggregation_value]))+&apos;, &apos;+ STR(YEAR([time_aggregation_value]))&#10;end' />
      </column>
