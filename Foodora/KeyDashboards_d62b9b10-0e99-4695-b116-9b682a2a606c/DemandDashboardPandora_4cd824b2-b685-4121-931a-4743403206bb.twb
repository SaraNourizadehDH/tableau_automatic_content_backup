              <calculation class='tableau' formula='SUM([GFV (net) (copy)_5700431296028282880])/SUM([orders])' />
            </column>
            <column caption='avg_daily_orders' datatype='real' name='[Calculation_1892426656262946818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/[Calculation_3143934771749961728]' />
            </column>
            <column caption='Overall Vertical' datatype='string' name='[Calculation_2184386621169623040]' role='dimension' type='nominal'>
