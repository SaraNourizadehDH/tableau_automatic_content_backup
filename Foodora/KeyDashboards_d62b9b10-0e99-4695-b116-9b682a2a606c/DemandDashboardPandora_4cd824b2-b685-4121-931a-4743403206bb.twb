      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/DemandDashboard-Pandora_17304540594900/VerticalPerformance?rev=' id='VerticalPerformance' path='/t/Foodora/workbooks/DemandDashboard-Pandora_17304540594900' revision='' site='Foodora' />
