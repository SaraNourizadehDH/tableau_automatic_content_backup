            <column caption='FP ICpRev (Rev incl RR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[FP ICpRev Mktg (excl. NCR) (copy)_1948017969175896064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FP Incentive Cost Mktg (copy)_552042800601841702])/[Revenue net RR (copy)_6383219198954057728]' />
            </column>
            <column caption='FP Incentive Cost' datatype='real' name='[FP Incentive Cost Mktg (copy)_552042800601841702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [incentive_cost_fp_eur]&#10;else [incentive_cost_fp_local]&#10;END' />
