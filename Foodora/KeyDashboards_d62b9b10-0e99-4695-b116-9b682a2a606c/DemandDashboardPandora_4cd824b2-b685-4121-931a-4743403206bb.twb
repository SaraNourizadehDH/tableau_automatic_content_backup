      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='demand_dash_cumulative' name='federated.0v22jyc1axib0m15jci161k7y21w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Time trend' caption='axis_dimensions' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Time&quot;'>
              <calculation class='tableau' formula='&quot;Time&quot;' />
              <aliases>
                <alias key='&quot;Time&quot;' value='Time trend' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0v22jyc1axib0m15jci161k7y21w'>
            <column caption='FLGP' datatype='real' name='[Calculation_1648669321877454848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [fully_loaded_gross_profit_eur]&#10;ELSE [fully_loaded_gross_profit_local]&#10;END' />
            </column>
            <column caption='RR Free Delivery Discounts (Non-Pro)' datatype='real' name='[Calculation_1824520844648742913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN -1*[revenue_reduction_df_discount_eur]&#10;ELSE -1*[revenue_reduction_df_discount_local]&#10;END' />
            </column>
            <column caption='RR Basket Value Free Delivery' datatype='real' name='[Calculation_1824520844649922563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [basket_df_revenue_reduction_eur]&#10;ELSE [basket_df_revenue_reduction_local]&#10;END' />
            </column>
            <column caption='Overall Vertical' datatype='string' name='[Calculation_2184386621169623040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([vertical_per_origin], [vertical])' />
            </column>
            <column caption='_days' datatype='real' name='[Calculation_3143934771749961728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [time_aggregation_value], [time_aggregation]:AVG([days_in_time_aggregation])})' />
            </column>
            <column caption='FP ICpRev Mktg (excl. NCR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3420202453658513409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_552042800597528611])/[Calculation_954411280865071119]' />
            </column>
            <column caption='Non Commission Revenue' datatype='integer' name='[Calculation_4588464358047387648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN ZN([ads_ncr_eur])&#10;ELSE ZN([ads_ncr_local])&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_5015672983521988608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Austria&quot;, &quot;Hungary&quot;, &quot;Sweden&quot;, &quot;Turkey&quot;) THEN &quot;EU&quot;&#10;ELSE &quot;APAC&quot;&#10;END' />
            </column>
            <column caption='Dimension Axis' datatype='string' name='[Calculation_552042800544985089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Country&apos; THEN [country]&#10;    WHEN &apos;Verticals&apos; THEN [vertical]&#10;    WHEN &apos;Time&apos; THEN STR([time_aggregation_value])&#10;END' />
            </column>
            <column caption='GMV (net)' datatype='real' name='[Calculation_552042800584790036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [gmv_net_eur]&#10;WHEN &apos;LC&apos; THEN [gmv_net_local]&#10;END' />
            </column>
            <column caption='Delivery Fee (net)' datatype='real' name='[Calculation_552042800592924702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [delivery_fee_net_eur] + [delivery_fee_adjustment_net_eur]&#10;ELSE [delivery_fee_net_local] + [delivery_fee_adjustment_net_local]&#10;END' />
            </column>
            <column caption='FP Incentive Cost Mktg' datatype='real' name='[Calculation_552042800597528611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [incentive_cost_fp_marketing_eur]&#10;else [incentive_cost_fp_marketing_local]&#10;END' />
            </column>
            <column caption='Has FP Funding' datatype='string' name='[Calculation_6721200237608321024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([voucher_funding] IN (&quot;Foodpanda&quot;, &quot;Co-Funded&quot;) AND [discount_funding] = &quot;No Discount&quot;)&#10;OR ([voucher_funding] = &quot;No Voucher&quot; AND [discount_funding] IN (&quot;Foodpanda&quot;, &quot;Co-Funded&quot;))&#10;OR ([voucher_funding] IN (&quot;Foodpanda&quot;, &quot;Co-Funded&quot;) AND [discount_funding] IN (&quot;Foodpanda&quot;, &quot;Co-Funded&quot;)) &#10;THEN &quot;Has FP Funding&quot; ELSE &quot;None&quot; END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_954411280086192130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [gmv_eur]&#10;ELSE [gmv_local]&#10;END' />
            </column>
            <column caption='_BLANK' datatype='integer' name='[Calculation_954411280137072646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Commission Revenue' datatype='real' name='[Calculation_954411280855572490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [commission_revenue_eur]&#10;ELSE [commission_revenue_local]&#10;END' />
            </column>
            <column caption='Revenue Reduction Evergreen' datatype='real' name='[Calculation_954411280864600078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [revenue_reduction_evergreen_eur]&#10;ELSE [revenue_reduction_evergreen_local]&#10;END' />
            </column>
            <column caption='Revenue net RR' datatype='real' name='[Calculation_954411280865071119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_954411280855572490]) &#10;+ SUM([Calculation_552042800592924702]) &#10;+ SUM([Revenue Reduction Delivery Fee (copy)_954411280863424525]) &#10;+ SUM([Surcharge Revenue (copy)_335588554233225216])&#10;+ SUM([Calculation_4588464358047387648])&#10;+ SUM([Delivery Fee (net) (copy)_3114520640127483904])&#10;+ [Revenue Reduction Free Delivery Total (copy)_1824520844682432518]&#10;+ SUM([Revenue Reduction Delivery Fee (copy)_4180818232488919040])&#10;+ SUM([Calculation_954411280864600078])' />
            </column>
            <column caption='Incentive Cost Vendor' datatype='real' name='[Calculation_954411280867966992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [incentive_cost_vendor_eur]&#10;ELSE [incentive_cost_vendor_local]&#10;END' />
            </column>
            <column caption='Incentive Cost Partner' datatype='real' name='[Calculation_954411280868278289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [incentive_cost_partner_eur]&#10;ELSE [incentive_cost_partner_local]&#10;END' />
            </column>
            <column caption='Incentive Cost Total' datatype='real' name='[Calculation_954411280869335058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([FP Incentive Cost Mktg (copy)_552042800601841702] + [Calculation_954411280867966992] + [Calculation_954411280868278289])' />
            </column>
            <column caption='fp share incentive cost' datatype='real' default-format='p0.0%' name='[Calculation_954411280881061907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FP Incentive Cost Mktg (copy)_552042800601841702])/SUM([Calculation_954411280869335058])' />
            </column>
            <column caption='Total Incentive Cost per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_954411280882532372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_954411280869335058])/SUM([orders])' />
            </column>
            <column caption='FP Incentive Cost per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_954411280883204117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FP Incentive Cost Mktg (copy)_552042800601841702])/SUM([orders])' />
            </column>
            <column caption='Vendor Incentive Cost per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_954411280884559894]' role='measure' type='quantitative'>
