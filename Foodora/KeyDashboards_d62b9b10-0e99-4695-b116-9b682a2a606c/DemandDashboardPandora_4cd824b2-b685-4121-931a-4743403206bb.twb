            <column caption='Dmart Margins' datatype='real' name='[Delivery Fee (net) (copy)_3114520640127483904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [dmart_revenue_eur]&#10;ELSE [dmart_revenue_local]&#10;END' />
