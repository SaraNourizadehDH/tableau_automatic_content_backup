      <column caption='AFV (gross)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AFV (net) (copy)_5700431296028393473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GFV (net) (copy)_5700431296028282880])/SUM([orders])' />
      </column>
      <column caption='AFV Incentivised' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AFV (net) (copy)_5809995410399248391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GFV (net) (copy)_5809995410398986245])/SUM([orders_incentivised])' />
      </column>
      <column caption='AFV Non Incentivised' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AFV Incentivised (net)  (copy)_5809995410399657992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GFV Incentivised (net)  (copy)_5809995410399121414])/SUM([orders_non_incentivised])' />
      </column>
      <column caption='FLGP' datatype='real' name='[Calculation_1648669321877454848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [fully_loaded_gross_profit_eur]&#10;ELSE [fully_loaded_gross_profit_local]&#10;END' />
      </column>
      <column caption='RR Pandapro Free Delivery' datatype='integer' name='[Calculation_1824520844648034304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN -1*[pandapro_fd_revenue_reduction_plus_vat_eur]&#10;ELSE -1*[pandapro_fd_revenue_reduction_plus_vat_local]&#10;END' />
      </column>
      <column caption='RR Free Delivery Discounts (Non-Pro)' datatype='real' name='[Calculation_1824520844648742913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN -1*[revenue_reduction_df_discount_eur]&#10;ELSE -1*[revenue_reduction_df_discount_local]&#10;END' />
      </column>
      <column caption='RR Basket Value Free Delivery' datatype='real' name='[Calculation_1824520844649922563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;EUR&apos; THEN [basket_df_revenue_reduction_eur]&#10;ELSE [basket_df_revenue_reduction_local]&#10;END' />
      </column>
      <column caption='Revenue Reduction Free Delivery Total' datatype='real' name='[Calculation_1824520844650397700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1824520844648034304])&#10;+ SUM([Calculation_1824520844648742913])&#10;+ SUM([RR Free Delivery Discounts (Non-Pro) (copy)_1824520844649238530])&#10;+ SUM([Calculation_1824520844649922563])' />
      </column>
      <column caption='avg_daily_orders' datatype='real' name='[Calculation_1892426656262946818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/[Calculation_3143934771749961728]' />
      </column>
      <column caption='one' datatype='real' hidden='true' name='[Calculation_1892426656268140552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(1)' />
      </column>
      <column caption='window' datatype='integer' hidden='true' name='[Calculation_1892426656276697097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_COUNT(1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Overall Vertical' datatype='string' name='[Calculation_2184386621169623040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([vertical_per_origin], [vertical])' />
      </column>
      <column caption='Helptext Overview' datatype='string' name='[Calculation_2798635333497606144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [time_aggregation]&#10;WHEN &apos;DAY&apos; THEN &quot;Metrics are showing previous day&apos;s (&quot; + STR(DATE(NOW())-1) + &quot;) values&quot; + char(10) + &quot;-&gt; Previous day&apos;s value is compared to the same weekday in previous week&quot;&#10;WHEN &apos;WEEK&apos; THEN &quot;Metrics are showing current week&apos;s (incl previous day: &quot; + STR(DATE(NOW())-1) + &quot;) values&quot;+ char(10) + &quot;-&gt; Current week&apos;s value is compared to the same timeframe last week&quot;&#10;WHEN &apos;MONTH&apos; THEN &quot;Metrics are showing current month&apos;s (incl previous day: &quot; + STR(DATE(NOW())-1) + &quot;) values&quot;+ char(10) + &quot;-&gt; Current month&apos;s value is compared to the same timeframe last month&quot;&#10;WHEN &apos;QUARTER&apos; THEN &quot;Metrics are showing current quarter&apos;s (incl previous day: &quot; + STR(DATE(NOW())-1) + &quot;) values&quot;+ char(10) + &quot;-&gt; Current quarter&apos;s value is compared to the same timeframe last quarter&quot;&#10;END' />
      </column>
      <column caption='2' datatype='integer' name='[Calculation_290271118801223683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='2' />
      </column>
      <column caption='_days' datatype='real' name='[Calculation_3143934771749961728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [time_aggregation_value], [time_aggregation]:AVG([days_in_time_aggregation])})' />
      </column>
