            <column caption='ABS([_BLANK])' datatype='integer' name='[Calculation_954411280885284888]' role='measure' type='quantitative' user:unnamed='Detailed View'>
              <calculation class='tableau' formula='ABS([Calculation_954411280137072646])' />
