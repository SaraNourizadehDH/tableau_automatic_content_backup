            <column caption='2' datatype='integer' name='[Calculation_290271118801223683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2' />
            </column>
            <column caption='_days' datatype='real' name='[Calculation_3143934771749961728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [time_aggregation_value], [time_aggregation]:AVG([days_in_time_aggregation])})' />
            </column>
            <column caption='Delivery Fee per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3420202453656113152]' role='measure' type='quantitative'>
