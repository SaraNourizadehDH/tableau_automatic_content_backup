            <column caption='gmv_local - L2W ' datatype='real' name='[L2W - Orders (copy)_3793227209713627149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[order_date]),{MAX(DATETRUNC(&apos;iso-week&apos;,[order_date]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[order_date]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3793227209380696064])&#10;THEN [gmv_local]&#10;END&#10;)}' />
            </column>
            <column caption='gmv_local - LW' datatype='real' name='[LW - Orders (copy)_3793227209713545228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[order_date]),{MAX(DATETRUNC(&apos;iso-week&apos;,[order_date]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[order_date]) &lt;= DATEPART(&apos;iso-weekday&apos;,[order_date])&#10;THEN [gmv_local]&#10;END&#10;)}' />
            </column>
            <column caption='Vertical (Condensed)' datatype='string' name='[Vertical (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[vertical]' new-bin='true'>
                <bin default-name='false' value='&quot;Shops&quot;'>
