              <calculation class='tableau' formula='&quot;Collapsed&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hlhrxj16uls4n13y216x0v1puxs'>
            <column caption='Verticals' datatype='string' name='[Calculation_1675127971784929280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Expanded&quot;  THEN [vertical]&#10;WHEN &quot;Collapsed&quot; THEN [Vertical (group)]&#10;END' />
              <aliases>
                <alias key='&quot;shops&quot;' value='Shops' />
              </aliases>
            </column>
            <column caption='MAX DATE' datatype='date' name='[Calculation_3793227209380696064]' role='dimension' type='ordinal'>
