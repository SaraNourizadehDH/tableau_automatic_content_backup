      </column>
      <column caption='monthly_points_redeemed' datatype='integer' name='[Calculation_312296498714046464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([total_points_redeemed])' />
      </column>
      <column caption='total_points_redeem' datatype='integer' name='[Calculation_691513715331182593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [total_points_expired_n4q] = 0 THEN NULL&#10;ELSE [total_points_balance_lqly] - ABS([total_points_expired_n4q]) END' />
      </column>
      <column caption='total_points_expire' datatype='integer' name='[Calculation_691513715333607427]' role='measure' type='quantitative'>
