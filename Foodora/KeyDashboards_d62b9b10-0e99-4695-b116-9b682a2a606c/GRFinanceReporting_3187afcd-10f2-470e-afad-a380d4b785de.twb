      <column caption='redemption_rate_liability' datatype='real' name='[Calculation_3118320536883417090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_691513715331182593])/SUM([total_points_balance_lqly])' />
