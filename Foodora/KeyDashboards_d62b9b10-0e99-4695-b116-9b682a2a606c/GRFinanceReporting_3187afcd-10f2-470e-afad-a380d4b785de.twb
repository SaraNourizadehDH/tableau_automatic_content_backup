    CASE WHEN end_date_month &gt;&gt; DATE_TRUNC(CURRENT_DATE(), MONTH) 
         THEN GENERATE_DATE_ARRAY(start_date_month, (DATE_ADD(CURRENT_DATE(), INTERVAL 15 MONTH)), INTERVAL 1 MONTH) 
         ELSE GENERATE_DATE_ARRAY(start_date_month, end_date_month, INTERVAL 1 MONTH) END AS value_active_range
  FROM value_dates
),
--added avg for pk due to mid-month change
value_final AS (
    SELECT
      &quot;FP_PK&quot; AS global_entity_id,
      DATE_TRUNC(DATE(&quot;2023-07-01&quot;), MONTH) AS start_date_month,
      DATE_TRUNC(DATE(&quot;2023-07-31&quot;), MONTH) AS end_date_month,
      DATE(&quot;2023-07-01&quot;) AS value_active_month,
      SAFE_CAST(0.075 AS FLOAT64) AS value_per_redeemed_point_local

UNION ALL

  SELECT
    value_lifetime_array.global_entity_id,
    value_lifetime_array.start_date_month,
    value_lifetime_array.end_date_month,
    value_active_month,
    value_lifetime_array.value_per_redeemed_point_local
  FROM value_lifetime_array
  CROSS JOIN UNNEST(value_lifetime_array.value_active_range) AS value_active_month

),

fin_dates AS (
SELECT
  *
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gnr_finance_reporting`
),

points_outstanding_lqly AS (
  SELECT
    anchor.global_entity_id,
    anchor.date_month,
    DATE_TRUNC(DATE_SUB(DATE_SUB(DATE_TRUNC(anchor.date_month, QUARTER), INTERVAL 4 QUARTER), INTERVAL 1 DAY), MONTH) AS points_outstanding_month_lqly,
    SUM(lqly.total_points_balance_to_date) AS total_points_balance_lqly
  FROM fin_dates AS anchor
  INNER JOIN fin_dates AS lqly
          ON lqly.global_entity_id = anchor.global_entity_id
         AND lqly.date_month = DATE_TRUNC(DATE_SUB(DATE_SUB(DATE_TRUNC(anchor.date_month, QUARTER), INTERVAL 4 QUARTER), INTERVAL 1 DAY), MONTH) 
  GROUP BY 1,2
),

points_expired_n4q AS (
  SELECT
    anchor.global_entity_id,
    anchor.date_month,
    DATE_TRUNC(DATE_SUB(DATE_TRUNC(anchor.date_month, QUARTER), INTERVAL 4 QUARTER), MONTH) AS expired_points_month_start,
    DATE_ADD(DATE_TRUNC(DATE_SUB(DATE_TRUNC(anchor.date_month, QUARTER), INTERVAL 4 QUARTER), MONTH), INTERVAL 11 MONTH) AS expired_points_month_end,
    SUM(n4q.total_points_expired) AS total_points_expired_n4q
  FROM fin_dates AS anchor
  INNER JOIN fin_dates AS n4q
          ON n4q.global_entity_id = anchor.global_entity_id
         AND n4q.date_month BETWEEN DATE_TRUNC(DATE_SUB(DATE_TRUNC(anchor.date_month, QUARTER), INTERVAL 4 QUARTER), MONTH) 
         AND DATE_ADD(DATE_TRUNC(DATE_SUB(DATE_TRUNC(anchor.date_month, QUARTER), INTERVAL 4 QUARTER), MONTH), INTERVAL 11 MONTH)
  GROUP BY 1,2,3
)

SELECT
 fin_dates.*,
 balance.points_outstanding_month_lqly,
 expiring.expired_points_month_start,
 expiring.expired_points_month_end,
 balance.total_points_balance_lqly,
 expiring.total_points_expired_n4q,
 vprp.value_per_redeemed_point_local AS value_prp_local_monthly
FROM fin_dates
LEFT JOIN value_final AS vprp
       ON vprp.global_entity_id = fin_dates.global_entity_id
      AND vprp.value_active_month = fin_dates.date_month
LEFT JOIN points_outstanding_lqly AS balance
        ON fin_dates.global_entity_id = balance.global_entity_id
       AND fin_dates.date_month = balance.date_month
LEFT JOIN points_expired_n4q AS expiring
       ON fin_dates.global_entity_id = expiring.global_entity_id
      AND fin_dates.date_month = expiring.date_month
WHERE fin_dates.date_month &gt;&gt;= &quot;2021-01-01&quot;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
