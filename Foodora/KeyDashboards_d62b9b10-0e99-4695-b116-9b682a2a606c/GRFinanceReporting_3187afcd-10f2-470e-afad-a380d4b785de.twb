      </column>
      <column caption='value_per_point' datatype='real' name='[Calculation_691513715333931012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [global_entity_id]&#10;    WHEN &apos;FP_BD&apos; THEN 0.1&#10;    WHEN &apos;FP_TW&apos; THEN 0.05&#10;    WHEN &apos;FP_TH&apos; THEN 0.1&#10;    WHEN &apos;FP_PH&apos; THEN 0.1&#10;    WHEN &apos;FP_MY&apos; THEN 0.01&#10;    WHEN &apos;FP_SG&apos; THEN 0.005&#10;    WHEN &apos;FP_HK&apos; THEN 0.05&#10;    WHEN &apos;FP_PK&apos; THEN 0.2&#10;    WHEN &apos;FP_BD&apos; THEN 0.1&#10;    WHEN &apos;FP_LA&apos; THEN 10&#10;    WHEN &apos;FP_KH&apos; THEN 0.002&#10;END' />
      </column>
