    <datasource caption='value_per_point' inline='true' name='federated.0pt3cf6186sjlz1ck79d00hwtq8z' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1ffv9u703kcd691024jvf1i8s8gx'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='hailey.cheong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ffv9u703kcd691024jvf1i8s8gx' name='Custom SQL Query' type='text'>WITH value_dates AS (
  SELECT
    value_pp.global_entity_id,
    value_pp.value_per_redeemed_point_local,
    DATE_TRUNC(value_pp.start_date_month, MONTH) AS start_date_month,
    DATE_TRUNC(value_pp.end_date_month, MONTH) AS end_date_month
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gnr_value_per_point` AS value_pp
),

value_lifetime_array AS (
 SELECT
    global_entity_id,
    start_date_month,
    end_date_month,
    value_per_redeemed_point_local,
    CASE WHEN end_date_month &gt;&gt; DATE_TRUNC(CURRENT_DATE(), MONTH) 
         THEN GENERATE_DATE_ARRAY(start_date_month, (DATE_ADD(CURRENT_DATE(), INTERVAL 15 MONTH)), INTERVAL 1 MONTH) 
         ELSE GENERATE_DATE_ARRAY(start_date_month, end_date_month, INTERVAL 1 MONTH) END AS value_active_range
  FROM value_dates
),
--added avg for pk due to mid-month change
final AS (
    SELECT
      &quot;FP_PK&quot; AS global_entity_id,
      DATE_TRUNC(DATE(&quot;2023-07-01&quot;), MONTH) AS start_date_month,
      DATE_TRUNC(DATE(&quot;2023-07-31&quot;), MONTH) AS end_date_month,
      DATE(&quot;2023-07-01&quot;) AS value_active_month,
      SAFE_CAST(0.075 AS FLOAT64) AS value_per_redeemed_point_local

UNION ALL

  SELECT
    value_lifetime_array.global_entity_id,
    value_lifetime_array.start_date_month,
    value_lifetime_array.end_date_month,
    value_active_month,
    value_lifetime_array.value_per_redeemed_point_local
  FROM value_lifetime_array
  CROSS JOIN UNNEST(value_lifetime_array.value_active_range) AS value_active_month

)
SELECT * FROM final</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ffv9u703kcd691024jvf1i8s8gx' name='Custom SQL Query' type='text'>WITH value_dates AS (
