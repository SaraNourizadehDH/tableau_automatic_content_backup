      <column caption='total_points_redeemed_tqty' datatype='integer' name='[Calculation_691513715337408520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [total_points_expired_tqty] != 0 THEN ABS([total_points_issued_tqly]-[total_points_expired_tqty])&#10;ELSE NULL &#10;END' />
      </column>
      <column caption='redemption_rate' datatype='real' name='[Calculation_691513715338362890]' role='measure' type='quantitative'>
