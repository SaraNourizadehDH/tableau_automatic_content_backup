      </column>
      <column caption='Date Period' datatype='date' datatype-customized='true' default-format='S' name='[Calculation_863283774452457476]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [granularity] = &apos;daily&apos; &#13;&#10;    THEN DATETRUNC(&apos;day&apos;,[report_date (country_SG_macro_reporting_platform_kpis)])&#13;&#10;ELSEIF [granularity] = &apos;weekly&apos; &#13;&#10;    THEN DATETRUNC(&quot;week&quot;, [report_date (country_SG_macro_reporting_platform_kpis)],&apos;monday&apos;)&#13;&#10;ELSEIF [granularity] = &apos;monthly&apos; &#13;&#10;    THEN DATETRUNC(&apos;month&apos;,[report_date (country_SG_macro_reporting_platform_kpis)])&#13;&#10;END)' />
      </column>
      <column caption='Date Period control' datatype='boolean' name='[Calculation_863283774459908104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]= &apos;day&apos; THEN [granularity] = &apos;daily&apos; &#13;&#10;ELSEIF [Parameters].[Parameter 1]= &apos;week&apos; THEN [granularity] = &apos;weekly&apos; &#13;&#10;ELSEIF [Parameters].[Parameter 1]= &apos;month&apos; THEN [granularity] = &apos;monthly&apos; &#13;&#10;END' />
      </column>
      <column caption='Date Period 2' datatype='date' datatype-customized='true' name='[Calculation_863283774461243401]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;day&apos; &#13;&#10;    THEN DATETRUNC(&apos;day&apos;,[report_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; &#13;&#10;    THEN DATETRUNC(&quot;week&quot;, [report_date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month&apos; &#13;&#10;    THEN DATETRUNC(&apos;month&apos;,[report_date])&#13;&#10;END)' />
      </column>
      <column caption='(not in use) Relevant date fitler 2' datatype='boolean' name='[Date Period 2 (copy)_863283774462308362]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then IIF(DATEADD(&apos;day&apos;, -16, TODAY()) &lt; [report_date] AND [report_date] != TODAY() AND [report_date] &lt;= DATEADD(&apos;day&apos;, -1, TODAY()), true, false)&#13;&#10; when &apos;week&apos; then IIF(DATEADD(&apos;iso-week&apos;, -13, DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) &lt; DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;) AND ISOWEEK(TODAY()) != ISOWEEK([report_date]), true, false)&#13;&#10; when &apos;month&apos; then IIF(DATEADD(&apos;month&apos;, -7, TODAY()) &lt; [report_date] AND Month([report_date]) != month(DATEADD(&apos;month&apos;, -5, TODAY())), true, false)&#13;&#10;end' />
      </column>
      <column caption='iCP_numerator' datatype='real' name='[N_iCP_dmart (copy)_224335586173186050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [vertical] = &quot;pandamart&quot; &#13;&#10;THEN ([voucher_cost_mktg_fp]+ [deal_cost_mktg_fp] + [fd_voucher_cost_fp] + [voucher_for_dmart_only])&#13;&#10;ELSE ([voucher_cost_mktg_fp]+ [deal_cost_mktg_fp])&#13;&#10;END' />
      </column>
      <column caption='Shrink 3 %' datatype='real' default-format='p0.00%' name='[Shrink % (incl. Close) (copy)_1244400917697941506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrink_3_orders])/SUM([forecasted_orders])' />
      </column>
      <column caption='Surge % (excl. FD)' datatype='real' default-format='p0.00%' name='[Surge % (copy)_1313925242897043456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([surged_orders_excl_FD])/SUM([actual_orders])' />
      </column>
      <column caption='(not in use) Relevant date filter' datatype='boolean' name='[Test 1 (copy)_863283774457409543]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [granularity]&#13;&#10; when &apos;daily&apos; then IIF(DATEADD(&apos;day&apos;, -16, TODAY()) &lt; [report_date (Custom SQL Query1)] AND [report_date (Custom SQL Query1)] != TODAY() AND [report_date (Custom SQL Query1)] &lt;= DATEADD(&apos;day&apos;, -1, TODAY()), true, false)&#13;&#10; when &apos;weekly&apos; then IIF(DATEADD(&apos;iso-week&apos;, -13, DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) &lt; DATETRUNC(&apos;week&apos;,[report_date (Custom SQL Query1)],&apos;monday&apos;) AND ISOWEEK(TODAY()) != ISOWEEK([report_date (Custom SQL Query1)]), true, false)&#13;&#10; when &apos;monthly&apos; then IIF(DATEADD(&apos;month&apos;, -7, TODAY()) &lt; [report_date (Custom SQL Query1)] AND Month([report_date (Custom SQL Query1)]) != month(DATEADD(&apos;month&apos;, -5, TODAY())), true, false)&#13;&#10;end' />
      </column>
