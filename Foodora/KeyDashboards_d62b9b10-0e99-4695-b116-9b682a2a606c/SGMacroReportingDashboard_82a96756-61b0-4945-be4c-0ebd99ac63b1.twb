      <repository-location derived-from='http://ip-172-31-0-217:8239/t/Foodora/workbooks/SGMacroReportingDashboard/SGMacroReporting?rev=' id='SGMacroReporting' path='/t/Foodora/workbooks/SGMacroReportingDashboard_17459163805280' revision='' site='Foodora' />
      <style />
      <size maxheight='2200' maxwidth='1700' minheight='2200' minwidth='1700' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Macro Reporting' name='federated.1gyop5k1wlbx3h17jicwe0nsdssh' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
          <calculation class='tableau' formula='&quot;month&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Daily' value='&quot;day&quot;' />
            <member alias='Weekly' value='&quot;week&quot;' />
            <member alias='Monthly' value='&quot;month&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1gyop5k1wlbx3h17jicwe0nsdssh'>
        <column caption='Day of Week' datatype='string' name='[Calculation_750693790529855489]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[report_date (country_SG_macro_reporting_platform_kpis)])' />
        </column>
        <column caption='Expedition Type' datatype='string' name='[expedition_type]' role='dimension' type='nominal' />
