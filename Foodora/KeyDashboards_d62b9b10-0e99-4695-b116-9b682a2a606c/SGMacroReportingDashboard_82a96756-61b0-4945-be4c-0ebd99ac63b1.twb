    <worksheet name='Resto - MTD Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Orders (MTD)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='MTD and WTD GMV and Orders' name='federated.1f19gie1rgt9jw14oh49p0eiv44k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1f19gie1rgt9jw14oh49p0eiv44k'>
            <column caption='MAX DATE' datatype='date' name='[Calculation_236720459910643712]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED: MAX([created_date_local])}' />
            </column>
            <column caption='MTD?' datatype='boolean' name='[Calculation_236720459910856705]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [created_date_local]) &lt;= [Calculation_236720459910643712] AND day([created_date_local]) &lt;= day([Calculation_236720459910643712])' />
            </column>
            <column caption='W/M To Date?' datatype='boolean' name='[Calculation_236720459911389186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;&#13;&#10;&#9;WHEN &apos;week&apos; THEN [MTD? (copy)_236720459911647235]&#13;&#10;&#9;WHEN &apos;month&apos; THEN [Calculation_236720459910856705]&#13;&#10;&#9;&#13;&#10;END' />
            </column>
            <column caption='Data up to' datatype='date' name='[MAX DATE (copy)_236720459919441924]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX([created_date_local])' />
            </column>
            <column caption='WTD?' datatype='boolean' name='[MTD? (copy)_236720459911647235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[created_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_236720459910643712])' />
            </column>
            <column caption='Business Type Apac V2' datatype='string' name='[business_type_apac_v2]' role='dimension' type='nominal' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[created_date_local]' derivation='Month' name='[mn:created_date_local:ok]' pivot='key' type='ordinal' />
