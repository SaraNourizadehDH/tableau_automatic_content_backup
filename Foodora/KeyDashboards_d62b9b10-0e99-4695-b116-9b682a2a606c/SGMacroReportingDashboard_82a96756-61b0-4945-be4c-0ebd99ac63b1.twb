      <column caption='Day of Week' datatype='string' name='[Calculation_750693790529855489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[report_date (country_SG_macro_reporting_platform_kpis)])' />
      </column>
      <column caption='Pass or Fail' datatype='string' name='[Calculation_7754354178598662144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [latest_date] &gt;= TODAY()-1 THEN &quot;Pass&quot; ELSE &quot;Fail&quot; END' />
      </column>
      <column caption='gpo_excl_wastage' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_779685708874211328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gpo_excl_wastage_total])/SUM([total_orders])' />
