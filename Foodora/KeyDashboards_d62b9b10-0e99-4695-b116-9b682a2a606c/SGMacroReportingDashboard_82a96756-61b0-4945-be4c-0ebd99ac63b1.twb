    <worksheet name='Platform KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f17b79' fontsize='14'>Platform KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Macro Reporting' name='federated.1gyop5k1wlbx3h17jicwe0nsdssh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gyop5k1wlbx3h17jicwe0nsdssh'>
            <column caption='Exclude Today filter' datatype='boolean' name='[(not in use) Relevant date filter (copy)_750693790532435970]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date (country_SG_macro_reporting_platform_kpis)]&lt;TODAY()' />
            </column>
            <column caption='Surge %' datatype='real' default-format='p0.00%' name='[Calculation_1244400917658583040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surged_orders])/SUM([actual_orders])' />
            </column>
            <column caption='Shrink % (incl. Close)' datatype='real' default-format='p0.00%' name='[Calculation_1244400917658701825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='Surged Time %' datatype='real' name='[Calculation_5889019468388864032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surged_order_experience])/SUM(lg_gross_orders_count_created_date)' />
            </column>
            <column caption='Day of Week' datatype='string' name='[Calculation_750693790529855489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[report_date (country_SG_macro_reporting_platform_kpis)])' />
            </column>
            <column caption='Date Period' datatype='date' datatype-customized='true' default-format='S' name='[Calculation_863283774452457476]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [granularity] = &apos;daily&apos; &#13;&#10;    THEN DATETRUNC(&apos;day&apos;,[report_date (country_SG_macro_reporting_platform_kpis)])&#13;&#10;ELSEIF [granularity] = &apos;weekly&apos; &#13;&#10;    THEN DATETRUNC(&quot;week&quot;, [report_date (country_SG_macro_reporting_platform_kpis)],&apos;monday&apos;)&#13;&#10;ELSEIF [granularity] = &apos;monthly&apos; &#13;&#10;    THEN DATETRUNC(&apos;month&apos;,[report_date (country_SG_macro_reporting_platform_kpis)])&#13;&#10;END)' />
            </column>
            <column caption='Date Period control' datatype='boolean' name='[Calculation_863283774459908104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]= &apos;day&apos; THEN [granularity] = &apos;daily&apos; &#13;&#10;ELSEIF [Parameters].[Parameter 1]= &apos;week&apos; THEN [granularity] = &apos;weekly&apos; &#13;&#10;ELSEIF [Parameters].[Parameter 1]= &apos;month&apos; THEN [granularity] = &apos;monthly&apos; &#13;&#10;END' />
            </column>
            <column caption='Shrink 3 %' datatype='real' default-format='p0.00%' name='[Shrink % (incl. Close) (copy)_1244400917697941506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_3_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='Surge % (excl. FD)' datatype='real' default-format='p0.00%' name='[Surge % (copy)_1313925242897043456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surged_orders_excl_FD])/SUM([actual_orders])' />
            </column>
            <column caption='Active Users' datatype='integer' name='[active_users]' role='measure' type='quantitative' />
            <column datatype='integer' name='[actual_orders]' role='measure' type='quantitative' />
            <column caption='Customers With Sessions' datatype='integer' name='[customers_with_sessions]' role='measure' type='quantitative' />
            <column caption='Cvr' datatype='real' default-format='p0.00%' name='[cvr]' role='measure' type='quantitative' />
            <column datatype='integer' name='[forecasted_orders]' role='measure' type='quantitative' />
            <column caption='granularity (platform)' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column datatype='integer' name='[lg_gross_orders_count_created_date]' role='measure' type='quantitative' />
            <column-instance column='[(not in use) Relevant date filter (copy)_750693790532435970]' derivation='None' name='[none:(not in use) Relevant date filter (copy)_750693790532435970:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_750693790529855489]' derivation='None' name='[none:Calculation_750693790529855489:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_863283774452457476]' derivation='None' name='[none:Calculation_863283774452457476:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_863283774459908104]' derivation='None' name='[none:Calculation_863283774459908104:nk]' pivot='key' type='nominal' />
            <column caption='report date (platform kpis)' datatype='date' name='[report_date (country_SG_macro_reporting_platform_kpis)]' role='dimension' type='ordinal' />
            <column caption='Sessions Converted' datatype='integer' name='[sessions_converted]' role='measure' type='quantitative' />
            <column datatype='real' name='[shrink_3_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[shrink_orders]' role='measure' type='quantitative' />
            <column-instance column='[active_users]' derivation='Sum' name='[sum:active_users:qk]' pivot='key' type='quantitative' />
            <column-instance column='[customers_with_sessions]' derivation='Sum' name='[sum:customers_with_sessions:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cvr]' derivation='Sum' name='[sum:cvr:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sessions_converted]' derivation='Sum' name='[sum:sessions_converted:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_orders (country_SG_macro_reporting_platform_kpis)]' derivation='Sum' name='[sum:total_orders (country_SG_macro_reporting_platform_kpis):qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_sessions]' derivation='Sum' name='[sum:total_sessions:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[surged_order_experience]' role='measure' type='quantitative' />
            <column datatype='integer' name='[surged_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[surged_orders_excl_FD]' role='measure' type='quantitative' />
