      <column caption='Average SF' datatype='real' name='[AFV (copy) (copy)_234257586145054723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([service_fee_local]) / SUM([number_of_orders])' />
      </column>
      <column caption='Average SOF' datatype='real' name='[AFV (copy)_234257586145046530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([difference_to_minimum_order_value_local]) / SUM([number_of_orders])' />
      </column>
      <column caption='Basket Discount - vendor iCPO' datatype='real' name='[Basket Discount - fp iCPO  (copy)_234257586153963525]' role='measure' type='quantitative'>
