        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0zanxh61g4pvk512gosro0zmo3tm' name='Custom SQL Query' type='text'><![CDATA[WITH acquisition_spend AS (
  SELECT 
    country,
    CASE 
      WHEN country = "Hong Kong" THEN "FP_HK"
      WHEN country = "Cambodia" THEN "FP_KH"
      WHEN country = "Singapore" THEN "FP_SG"
      WHEN country = "Malaysia" THEN "FP_MY"
      WHEN country = "Philippines" THEN "FP_PH"
      WHEN country = "Taiwan" THEN "FP_TW"
      WHEN country = "Pakistan" THEN "FP_PK"
      WHEN country = "Bangladesh" THEN "FP_BD"
      WHEN country = "Myanmar" THEN "FP_MM"
      WHEN country = "Laos" THEN "FP_LA"
      WHEN country = "Thailand" THEN "FP_TH"
      WHEN country = "Austria" THEN "MJM_AT"
      WHEN country = "Czech Republic" THEN "DJ_CZ"
      WHEN country = "Finland" THEN "PO_FI"
      WHEN country = "Norway" THEN "FO_NO"
      WHEN country = "Hungary" THEN "NP_HU"
      WHEN country = "Sweden" THEN "OP_SE"
      WHEN country = "Turkey" THEN "YS_TR"
    END AS global_entity_id,
    report_month,
    ABS(SUM(IF(account_name IN ("Online PM for Acquisition","SEM Brand"), actual_eur, 0))) AS pm_acquisition_spend,
    ABS(SUM(IF(account_group = "CAC", actual_eur, 0))) AS acquisition_spend
    -- sum(runrate_eur) as runrate_eur
 FROM `dhh---analytics-eu.bi_marketing.pandora__marketing_mcr_report` 
  WHERE report_month <<= CURRENT_DATE()
  AND country IN ("Hong Kong","Cambodia","Singapore","Malaysia","Philippines","Taiwan","Pakistan","Bangladesh","Myanmar","Laos","Thailand","Austria","Czech Republic","Finland","Norway","Hungary","Sweden","Turkey")
  GROUP BY ALL

  UNION ALL

  SELECT 
    "Pandora" AS country,
    "Pandora" AS global_entity_id,    
    report_month,
    ABS(SUM(IF(account_name IN ("Online PM for Acquisition","SEM Brand"), actual_eur, 0))) AS pm_acquisition_spend,
    ABS(SUM(IF(account_group = "CAC", actual_eur, 0))) AS acquisition_spend
    -- sum(runrate_eur) as runrate_eur
 FROM `dhh---analytics-eu.bi_marketing.pandora__marketing_mcr_report` 
  WHERE report_month <<= CURRENT_DATE()
  AND country IN ("Hong Kong","Cambodia","Singapore","Malaysia","Philippines","Taiwan","Pakistan","Bangladesh","Myanmar","Laos","Thailand","Austria","Czech Republic","Finland","Norway","Hungary","Sweden","Turkey")
  GROUP BY ALL

  UNION ALL

  SELECT 
    "Foodpanda" AS country,
    "Foodpanda" AS global_entity_id,    
    report_month,
    ABS(SUM(IF(account_name IN ("Online PM for Acquisition","SEM Brand"), actual_eur, 0))) AS pm_acquisition_spend,
    ABS(SUM(IF(account_group = "CAC", actual_eur, 0))) AS acquisition_spend
    -- sum(runrate_eur) as runrate_eur
 FROM `dhh---analytics-eu.bi_marketing.pandora__marketing_mcr_report` 
  WHERE report_month <<= CURRENT_DATE()
  AND country IN ("Hong Kong","Cambodia","Singapore","Malaysia","Philippines","Taiwan","Pakistan","Bangladesh","Myanmar","Laos","Thailand")
  GROUP BY ALL  

  UNION ALL

  SELECT 
    "Foodora" AS country,
    "Foodora" AS global_entity_id,
    report_month,
    ABS(SUM(IF(account_name IN ("Online PM for Acquisition","SEM Brand"), actual_eur, 0))) AS pm_acquisition_spend,
    ABS(SUM(IF(account_group = "CAC", actual_eur, 0))) AS acquisition_spend
    -- sum(runrate_eur) as runrate_eur
 FROM `dhh---analytics-eu.bi_marketing.pandora__marketing_mcr_report` 
  WHERE report_month <<= CURRENT_DATE()
  AND country IN ("Austria","Czech Republic","Finland","Norway","Hungary","Sweden")
  GROUP BY ALL 

  UNION ALL

  SELECT 
    "Foodora+Yemeksepeti" AS country,
    "Foodora+Yemeksepeti" AS global_entity_id,
    report_month,
    ABS(SUM(IF(account_name IN ("Online PM for Acquisition","SEM Brand"), actual_eur, 0))) AS pm_acquisition_spend,
    ABS(SUM(IF(account_group = "CAC", actual_eur, 0))) AS acquisition_spend
    -- sum(runrate_eur) as runrate_eur
 FROM `dhh---analytics-eu.bi_marketing.pandora__marketing_mcr_report` 
  WHERE report_month <<= CURRENT_DATE()
  AND country IN ("Austria","Czech Republic","Finland","Norway","Hungary","Sweden","Turkey")
  GROUP BY ALL 
),

-- From Tamerlan
pm_flag AS (
  SELECT
    global_entity_id,
    date,
    CASE
      WHEN (goal_dh = "ACQUISITION" or goal_dh = "BRAND PROTECTION" or channel = "AFFILIATE" )
        OR (
        (sub_channel in ("REACH","RMA") and channel in ("DISPLAY","PAIDSOCIAL","APP")
      )
      OR channel like "SEM"
      OR sub_channel like "SEM"
      OR channel like "AFFILIATE"
      )
      THEN "PM"
      ELSE "nonPM"
    END AS PM_nonPM,
    SUM(acquisitions_calibration_ios14fix) AS pm_acquisitions
  FROM fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_l2_detailed
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
  GROUP BY ALL  
),

pm_acquisition AS (
  SELECT
    global_entity_id,
    DATE_TRUNC(date, MONTH) AS month,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND PM_nonPM = "PM"
  GROUP BY ALL

  UNION ALL

  SELECT
    "Pandora" AS global_entity_id,
    DATE_TRUNC(date, MONTH) AS month,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND PM_nonPM = "PM"
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodpanda" AS global_entity_id,
    DATE_TRUNC(date, MONTH) AS month,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY")
    AND PM_nonPM = "PM"
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodora" AS global_entity_id,
    DATE_TRUNC(date, MONTH) AS month,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
    AND PM_nonPM = "PM"
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodora+Yemeksepeti" AS global_entity_id,
    DATE_TRUNC(date, MONTH) AS month,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("YS_TR","MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
    AND PM_nonPM = "PM"
  GROUP BY ALL
),

subscriber AS (
  SELECT
    DATE_TRUNC(report_date, MONTH) AS month,
    global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    DATE_TRUNC(report_date, MONTH) AS month,
    "Pandora" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    DATE_TRUNC(report_date, MONTH) AS month,
    "Foodpanda" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY")
  GROUP BY ALL

  UNION ALL

  SELECT
    DATE_TRUNC(report_date, MONTH) AS month,
    "Foodora" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    DATE_TRUNC(report_date, MONTH) AS month,
    "Foodora+Yemeksepeti" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("YS_TR","MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL  
)

SELECT
CASE
  WHEN monthly.global_entity_id = "Pandora" THEN "Pandora"
  WHEN monthly.global_entity_id = "Foodpanda" THEN "Foodpanda"
  WHEN monthly.global_entity_id = "Foodora" THEN "Foodora"
  WHEN monthly.global_entity_id = "Foodora+Yemeksepeti" THEN "Foodora+Yemeksepeti"
  ELSE country.name
END AS country_name,
monthly.*,
acquisition_spend.pm_acquisition_spend,
acquisition_spend.acquisition_spend,
pm_acquisition.pm_acquisitions,
subscriber.first_time_subscriber,
subscriber.returning_subscriber,
SAFE_DIVIDE((subscriber.first_time_subscriber+subscriber.returning_subscriber), monthly.non_pro_active_customers) AS pro_rate
FROM fulfillment-dwh-production.pandata_report.marketing__performance_dashboard_monthly monthly
LEFT JOIN acquisition_spend
       ON monthly.global_entity_id = acquisition_spend.global_entity_id
      AND monthly.month_local = acquisition_spend.report_month
LEFT JOIN pm_acquisition
       ON monthly.global_entity_id = pm_acquisition.global_entity_id
      AND monthly.month_local = pm_acquisition.month
LEFT JOIN subscriber 
       ON monthly.global_entity_id = subscriber.global_entity_id
      AND monthly.month_local = subscriber.month
LEFT JOIN fulfillment-dwh-production.pandata_datamart.pandora__core_countries country
       ON monthly.global_entity_id = country.global_entity_id]]></relation>
