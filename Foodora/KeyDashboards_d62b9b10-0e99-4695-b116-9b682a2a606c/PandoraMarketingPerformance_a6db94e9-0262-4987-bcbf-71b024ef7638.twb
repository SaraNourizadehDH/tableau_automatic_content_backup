      <column caption='acquisition_spend_RM MoM' datatype='real' name='[Calculation_1709116085693218816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [acquisition_spend] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [acquisition_spend]&#10;    END)&#10;-1&#10;}' />
      </column>
      <column caption='pm_acquisition_spend_RM MoM' datatype='real' name='[Calculation_1709116085693399041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [pm_acquisition_spend] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [pm_acquisition_spend]&#10;    END)&#10;-1&#10;}' />
      </column>
      <column caption='acquisition_spend RM YoY' datatype='real' name='[Calculation_1709116085693734914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [acquisition_spend] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [acquisition_spend]&#10;    END)&#10;-1&#10;}' />
      </column>
      <column caption='pm_acquisition_spend RM YoY' datatype='real' name='[Calculation_1709116085693906947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [pm_acquisition_spend] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [pm_acquisition_spend]&#10;    END)&#10;-1&#10;}' />
      </column>
      <column caption='acquisition_spend_RR' datatype='real' name='[Calculation_1709116085704425479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([acquisition_spend_MTD]/[no_of_days_to_yesterday_TM])*[no_of_days_TM]' />
      </column>
      <column caption='acquisition_MoM MTD' datatype='real' name='[Calculation_2962876008156250114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([month_local]) = ATTR([Calculation_2962876008157491203])&#10;THEN (SUM([acquisition_MTD]) / SUM([acquisition_PMTD])) -1&#10;ELSE SUM([acquisition RM YoY (copy)_64387426862919682])&#10;END' />
      </column>
      <column caption='Current Month' datatype='datetime' name='[Calculation_2962876008157491203]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()-1)' />
      </column>
      <column caption='pro_customer_ppt_MTD' datatype='real' name='[Calculation_2962876008161464332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_customer_MTD]) / SUM([active_customers_MTD])' />
      </column>
      <column caption='qc_customer_ppt_MTD' datatype='real' name='[Calculation_2962876008164007955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qc_active_customer_MTD]) / SUM([active_customers_MTD])' />
      </column>
      <column caption='hva_incentive_ppt_MTD' datatype='real' name='[Calculation_2962876008168779807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hva_mkt_contribution_eur_MTD]) / SUM([dh_mkt_contribution_eur_MTD])' />
      </column>
      <column caption='Highlight' datatype='string' name='[Calculation_64387426546311170]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [global_entity_id] IN (&apos;Pandora&apos;,&apos;Foodpanda&apos;,&apos;Foodora&apos;,&apos;Foodora+Yemeksepeti&apos;) THEN &apos;highlight&apos;&#10;ELSE &apos;normal&apos;&#10;END' />
      </column>
      <column caption='Max Reporting Month' datatype='datetime' name='[Calculation_64387426694250499]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(DATEADD(&apos;month&apos;, -1, [month_local]))}' />
      </column>
      <column caption='Rolling 12 Months Filter' datatype='boolean' name='[Calculation_64387426698346500]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_local] &gt;= DATEADD(&apos;month&apos;,-12,[Parameters].[Parameter 1])&#10;AND&#10;[month_local] &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Reporting Month Filter' datatype='boolean' name='[Calculation_64387426710441989]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month_local] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Last Month Filter (lookup)' datatype='date' name='[Calculation_64387426711830534]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP(MIN([Parameters].[Parameter 1]),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='successful_order RM YoY' datatype='real' name='[Calculation_64387426718224393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [successful_orders] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [successful_orders]&#10;    END)&#10;-1&#10;}' />
      </column>
      <column caption='pro_rate_MTD' datatype='real' name='[Calculation_89368332473917441]' role='measure' type='quantitative'>
