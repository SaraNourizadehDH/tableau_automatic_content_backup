    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Read Me - Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PandoraMarketingPreformance/ReadMe-Definitions?rev=' id='ReadMe-Definitions' path='/t/Foodora/workbooks/PandoraMarketingPreformance' revision='' site='Foodora' />
      <style />
      <size maxheight='1100' maxwidth='1100' minheight='1100' minwidth='1100' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='95637' id='3' type-v2='text' w='98546' x='727' y='3636'>
            <formatted-text>
              <run bold='true' fontcolor='#b8209c' fontname='Tableau Medium' fontsize='12'>Definitions</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Successful Orders :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Number of successful platform orders.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>GMV (user paid):</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> GMV in eur that users paid.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>% HVA Incentive :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>   HVA Incentived Spend Eur /  Total DH Spend Eur. (data source: pandora__order_hva_costs)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Active Customers:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  Number of customers who placed at least one successful order on the platform during selected period.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Acquisitions </run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>: Number of customers who placed their very first order on the platform.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Reacquisitions :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Number of customers who reordered after 365 days.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PM Acquisitions :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Number of acquisitions with performance marketing channel.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PM Acquisition Spend:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Incentive spend on PM acquisitions.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Acquisition Spend:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Incentive spend on acquisitions.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>QC Successful Orders :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Number of successful QC orders.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>QC Active Customers:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  Number of customers who placed at least one successful QC order during selected period.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>% QC Active Customers:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>   QC Active Customers / Active Customers.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>QC GMV (user paid):</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> QC GMV in eur that users paid.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>QC Trials :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Number of customers who placed their first QC orders.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PRO Customers :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> Number of active customers who are subscribers.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>% PRO Customers :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  Pro Customers /  Active Customers.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PRO GMV (user paid):</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  GMV from pro orders in eur that users paid.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PRO Join Rate : </run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> (First-time subscriber  activations +  Returning subscriber activations) /  Non-pro active customers.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Reactivations: </run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Number of reactivated users from Churned/Inactive/Lost segments, including reacquisitions. No HVA prioritization logic applied.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#b8209c' fontname='Tableau Medium' fontsize='12'>Run Rate Calculation Logic</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Time Series Frocasting Model </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - </run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Successful Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - GMV  (user paid)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - Acquisitions</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Run Rate based on No of Days</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> (Current month MTD * No of days MTD) / Total no of days in a month</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - Reacquisitions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - PM Acquisitions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - PM Acquisition Spend</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - Acquisition Spend</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - QC Successful Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - QC GMV (user paid)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - QC Trial</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - Pro GMV (user paid)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - Reactivations</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Run Rate based on MTD&amp;Previous MTD </run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>(Current month MTD / Previous month MTD) * Previous month full month</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>   - Active Customers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>   - QC Active Customers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>   - Pro Customers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>   - Pro Rate</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='2909' id='40' param='Image/Header- long.png' type-v2='bitmap' w='98546' x='727' y='727'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
