when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CX Vouchers" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Compensation" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Corporate Vouchers" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new not in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new  in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "P61347"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 ="Affiliate & Coop - NC" THEN "P61316" 
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 ="DHF Vouchers - HVAs" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Employee Benefits" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform" and budget_channel_new = "Loyalty Programme" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform " and budget_channel_new = "Loyalty Programme" THEN "P61342"

when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Refer-a-friend","Refer A Friend") THEN "P61312"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Vouchers - NC") THEN "P61316"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Experimentation" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Rider Rewards") THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Refund") THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Test Vouchers") THEN "Non-Carc"
ELSE "Other Vouchers"

 end as account_id,
SUM(voucher_cost_dh_eur)*-1 as voucher_cost_dh_marketing_eur,
SUM(voucher_cost_dh_local)*-1 as voucher_cost_dh_marketing_local,
SUM(voucher_cost_dh_net_eur)*-1 as voucher_cost_dh_marketing_exc_vat_eur,
SUM(voucher_cost_dh_net_local)*-1 as voucher_cost_dh_marketing_exc_vat_local,

FROM
  `dhh---analytics-eu.bi_marketing.pandora_agg_mcr_orders` o
  LEFT JOIN
  `dhh---analytics-eu.bi_marketing.regional_eu_loyalty_vouchers` AS loyalty
ON
  loyalty.global_entity_id = o.global_entity_id
  AND loyalty.order_id = o.order_code
  where o.business_type <<>> "dmart"
group by all
 ),

deals_raw as (
SELECT 
  o.global_entity_id,
  o.order_code,
  o.created_date_local,
  o.is_acquisition as is_acquisition_order,
  o.business_type,
  o.discount_type,
  o.is_discount_used,
  o.df_user_paid_incl_vat_eur,
  o.df_original_incl_vat_eur,
  o.df_original_incl_vat_local,
  o.df_original_excl_vat_eur,
  o.df_original_excl_vat_local,
  o.is_meal_for_one,
  CASE WHEN o.dps_details.dps_type = "dps_bvdf" THEN TRUE ELSE FALSE end as is_bvdf,

COALESCE(o.is_subscription_incentive_order,FALSE) as is_subscription_incentive_order,
  case when o.delivery_type = "Own Delivery" then TRUE else FALSE end as is_own_delivery,
  COALESCE(discounts.is_evergreen,FALSE) as is_evergreen,
  COALESCE(o.is_subscription_incentive_order,FALSE) as still_is_subscription_incentive_order,
  COALESCE(subscription.is_subscription_voucher_order,FALSE) as is_subscription_voucher_order,
  
---
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN  o.discount_cost_dh_eur END,0) AS dh_deal_pickup_pro_eur,
COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN  o.discount_cost_dh_net_eur END,0) AS dh_deal_pickup_pro_exc_vat_eur,
---
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN o.discount_cost_dh_local END,0) AS dh_deal_pickup_pro_local,
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN o.voucher_cost_dh_net_local END,0) AS dh_deal_pickup_pro_exc_vat_local,
---
  ARRAY_TO_STRING(discounts.expedition_types,",") as expedition_types,
  COALESCE(subscription.is_subscription_discount_order,FALSE) as is_subscription_discount_order,
---
  CASE WHEN  subscription.is_free_delivery_dh_fully_funded_subscription_order or is_free_delivery_vendor_fully_funded_subscription_order or o.dps_details.dps_type = "dps_subscription" THEN TRUE
  WHEN  is_discounted_delivery_subscription_order THEN TRUE
   ELSE FALSE END AS is_free_delivery_subscription_order,
--
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_eur END,0) AS dh_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_vendor_eur END,0) AS vendor_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_eur END,0) AS all_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_eur END,0) AS dh_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_eur END,0) AS all_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_eur END,0)-COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_eur END,0) as vendor_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_local END,0) AS dh_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_vendor_local END,0) AS vendor_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_local END,0) AS all_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_local END,0) AS dh_deal_free_delivery_exc_vat_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_local END,0) AS all_deal_free_delivery_exc_vat_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_local END,0)-COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_local END,0) AS vendor_deal_free_delivery_exc_vat_local,

COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_eur END,0) AS fd_voucher_dh_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_vendor_eur END,0) AS fd_voucher_vendor_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_eur END,0) AS fd_voucher_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_eur END,0) AS fd_voucher_dh_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_eur END,0) AS fd_voucher_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_eur END,0)-COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_eur END,0) as fd_voucher_vendor_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_local END,0) AS fd_voucher_dh_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_vendor_local END,0) AS fd_voucher_vendor_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_local END,0) AS fd_voucher_local, 
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_local END,0) AS fd_voucher_dh_exc_vat_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_local END,0)-COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_local END,0) as fd_voucher_vendor_exc_vat_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_local END,0) AS fd_voucher_exc_vat_local,



COALESCE(o.dps_total_dh_cost_eur,0) AS dps_fd_dh_eur,
COALESCE(o.dps_total_vendor_cost_eur,0) as dps_fd_vendor_eur,
COALESCE(o.dps_total_vendor_cost_local,0) as dps_total_vendor_cost_local,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_dh_cost_eur,0),COALESCE(o.dps_total_cost_eur,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_eur,0),0) AS dps_fd_dh_exc_vat_eur,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_vendor_cost_eur,0),COALESCE(o.dps_total_cost_eur,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_eur,0),0) AS dps_fd_vendor_exc_vat_eur,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_vendor_cost_local,0),COALESCE(o.dps_total_cost_local,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_local,0),0) AS dps_fd_vendor_exc_vat_local,


COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_eur END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_eur END),0) = 0 THEN o.dps_total_cost_eur END,0) AS dps_fd_eur, 
  
COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_eur END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_eur END),0) = 0 THEN dps_costs.dps_total_cost_excl_vat_eur END,0) AS dps_fd_exc_vat_eur, 

 COALESCE(o.dps_total_dh_cost_local,0) AS dps_fd_dh_local,
 SAFE_DIVIDE(COALESCE(o.dps_total_dh_cost_local,0),COALESCE(o.dps_total_cost_local,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_local,0) AS dps_fd_dh_exc_vat_local,

COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_local END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_local END),0) = 0 THEN o.dps_total_cost_local END,0) AS dps_fd_local, 

COALESCE(CASE WHEN IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_local END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_local END),0)  = 0 THEN dps_costs.dps_total_cost_excl_vat_local END,0) AS dps_fd_exc_vat_local,

 COALESCE(o.discount_cost_dh_local,0) + COALESCE(o.mp_fd_cost_dh_local,0) + COALESCE(o.dps_total_dh_cost_local,0) as dh_deal_total_local,
 COALESCE(o.discount_cost_dh_eur,0) + COALESCE(o.mp_fd_cost_dh_eur,0) + COALESCE(o.dps_total_dh_cost_eur,0) as dh_deal_total_eur,
  COALESCE(o.discount_cost_dh_net_eur,0)- COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_eur END,0) as dh_deal_total_net_eur,
  COALESCE(o.discount_cost_dh_net_local,0)- COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_local END,0) as dh_deal_total_net_local,
 0 as disco_vouchers,
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_value_local-o.discount_cost_dh_local END,0) as pro_discount_vf_local, 
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_value_eur-o.discount_cost_dh_eur END,0) as pro_discount_vf_eur, 
COALESCE(case when o.is_subscription_voucher_order  THEN  o.voucher_value_local-o.voucher_cost_dh_local END,0) as pro_voucher_vf_local, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_value_eur-o.voucher_cost_dh_eur END,0)  as pro_voucher_vf_eur,

COALESCE(case when o.is_subscription_discount_order  THEN o.discount_cost_net_local-o.discount_cost_dh_net_local END,0) as pro_discount_vf_net_local, 
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_cost_net_eur-o.discount_cost_dh_net_eur END,0) as pro_discount_vf_net_eur, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_cost_net_local-o.voucher_cost_dh_net_local END,0) as pro_voucher_vf_net_local, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_cost_net_eur-o.voucher_cost_dh_net_eur END,0)  as pro_voucher_vf_net_eur

FROM
 `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
 LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_discount_costs` as marketing_discounts
ON
  marketing_discounts.order_code = o.order_code
  AND marketing_discounts.global_entity_id = o.global_entity_id 
  AND marketing_discounts.created_date_local>>="2025-01-01"
LEFT JOIN
  `fulfillment-dwh-production.pandata_datamart.pandora__order_subscriptions` AS subscription
ON
  subscription.global_entity_id = o.global_entity_id
  AND subscription.order_code = o.order_code

LEFT JOIN    `fulfillment-dwh-production.pandata_curated.offers_discounts` as discounts on discounts.uuid = o.pd_discount_uuid and discounts.global_entity_id = o.global_entity_id

LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_dps_costs` as dps_costs
ON
  dps_costs.order_code = o.order_code
  AND dps_costs.global_entity_id = o.global_entity_id and dps_costs.created_date_local>>= "2025-01-01"

      WHERE 1=1
        AND o.created_date_local >>= "2025-07-01"
        AND o.is_billable
        and o.business_type <<>> "dmart"
        and o.global_entity_id not like "%ODR_%"
        
      GROUP BY all


UNION ALL

SELECT * EXCEPT(is_pickup_evergreen_discount)
FROM  `dhh---analytics-eu.bi_marketing.2024_deals_mcr`
),


deals_agg as (  # OK
SELECT 
  deals.global_entity_id,
  
  deals.created_date_local AS month,
  CASE 
  -- Subscription Discounts
  WHEN   COALESCE(deals.is_subscription_discount_order,FALSE) THEN "Subscriptions"
  --  Deals NC
  WHEN  COALESCE(deals.is_acquisition_order,FALSE) and NOT COALESCE(deals.is_subscription_discount_order,FALSE) THEN "DH Funded Discounts Acquisition"
  -- Deals EC
  WHEN  NOT COALESCE(deals.is_acquisition_order,FALSE)  and  NOT COALESCE(deals.is_subscription_discount_order,FALSE) THEN "DH Funded Discounts Retention"

  ELSE "Other Deals"

  END AS account_name,
  "" AS accontut_id,

  SUM(COALESCE((ROUND(COALESCE(dh_deal_total_eur,0),2) - ROUND(COALESCE(dh_deal_free_delivery_eur,0),2) - ROUND(COALESCE(dps_fd_dh_eur,0),2) - 
  ROUND(COALESCE(dh_deal_pickup_pro_eur,0),2)), 0))*-1  AS incentive_cost_dh_eur,
  SUM(COALESCE((ROUND(COALESCE(dh_deal_total_local,0),2) - ROUND(COALESCE(dh_deal_free_delivery_local,0),2) - ROUND(COALESCE(dps_fd_dh_local,0),2) - 
  ROUND(COALESCE(dh_deal_pickup_pro_local,0),2)), 0))*-1 AS incentive_cost_dh_local ,
  SUM(dh_deal_total_net_eur)*-1 as incentive_cost_dh_net_eur,
  SUM(dh_deal_total_net_local)*-1 as incentive_cost_dh_net_local

FROM deals_raw as deals
WHERE 1=1
     -- AND deals.discount_type != "free_delivery"
     -- AND deals.is_discount_used
      GROUP BY all
),

od_fd_cost as ( # See slack message -- done 
select 
global_entity_id,
created_date_local AS month,
      CASE
-- Subscription
---WHEN  is_free_delivery_subscription_order and is_own_delivery THEN "Delivery Fee Reduction Marketing Non Subscription"
-- FD MMT New Customers done 
WHEN NOT is_free_delivery_subscription_order AND is_acquisition_order and is_own_delivery and NOT is_meal_for_one and not is_bvdf
THEN "Revenue Reduction From Delivery Fee Acquisition"
-- FD MMT Existing Customers -- done 
WHEN NOT is_free_delivery_subscription_order AND NOT is_acquisition_order and is_own_delivery and NOT is_meal_for_one and not is_bvdf
THEN "Delivery Fee Reduction Marketing Non Subscription"
ELSE "Other DF"
END AS account_name,
"" as account_id,
SUM(all_deal_free_delivery_eur+fd_voucher_eur+dps_fd_eur)*-1 AS incentive_cost_dh_eur,
SUM(all_deal_free_delivery_local+fd_voucher_local+dps_fd_local)*-1  AS incentive_cost_dh_local,
SUM(all_deal_free_delivery_exc_vat_eur+fd_voucher_exc_vat_eur+dps_fd_exc_vat_eur)*-1  AS incentive_cost_dh_net_eur,
SUM(all_deal_free_delivery_exc_vat_local+fd_voucher_exc_vat_local+dps_fd_exc_vat_local)*-1  AS incentive_cost_dh_net_local
from deals_raw
WHERE is_own_delivery
GROUP BY ALL
),

mp_fd_cost AS ( # let"s split this into Dmart and Platform too in case it"s needed -- done 
  select 
  global_entity_id,
created_date_local AS month,
CASE WHEN NOT is_free_delivery_subscription_order and not is_acquisition_order THEN "Voucher Generic Retention"
 WHEN NOT is_free_delivery_subscription_order and  is_acquisition_order THEN "Vouchers Generic Acquisition"
ELSE "Other DF MP" END AS account_name,
"" as account_id,
SUM(COALESCE(dh_deal_free_delivery_eur,0)+COALESCE(fd_voucher_dh_eur,0)+COALESCE(dps_fd_dh_eur,0))*-1 AS incentive_cost_dh_eur,
SUM(COALESCE(dh_deal_free_delivery_local,0)+COALESCE(fd_voucher_dh_local,0)+COALESCE(dps_fd_dh_local,0))*-1 AS incentive_cost_dh_local,
SUM(COALESCE(dh_deal_free_delivery_exc_vat_eur,0)+COALESCE(fd_voucher_dh_exc_vat_eur,0)+COALESCE(dps_fd_dh_exc_vat_eur,0))*-1 AS incentive_cost_dh_net_eur,
SUM(COALESCE(dh_deal_free_delivery_exc_vat_local,0)+COALESCE(fd_voucher_dh_exc_vat_local,0)+COALESCE(dps_fd_dh_exc_vat_local,0))*-1 AS incentive_cost_dh_net_local
   from deals_raw
  WHERE not is_own_delivery

group by all
),

incentive_combined as(select 
global_entity_id,
report_month AS report_day, -- Irene"s note: actually, this is daily data. To avoid breaking any part, I didn"t touch anything besides rename this row.
kpi,
sum(bq_value_eur) as bq_value_eur, 
sum(bq_value_local) as bq_value_local,
SUM(bq_value_net_eur) as bq_value_net_eur,
sum(bq_value_net_local) as bq_value_net_local 
from (select * from performance_marketing
union all
select * from deals_agg
union all
select * from od_fd_cost
 )
group by all),

pm_acquisition_spend_daily AS (
SELECT
  global_entity_id,
  report_day,
  SUM(IF(kpi IN ("Online PM for Acquisition","SEM Brand"), ABS(bq_value_eur), 0)) AS pm_acquisition_spend,
  SUM(IF(kpi IN ("Vouchers Generic Acquisition","Revenue Reduction From Delivery Fee Acquisition", "DH Funded Discounts Acquisition","CRM Activities","Refer A Friend","Online PM for Acquisition","SEM Brand"), ABS(bq_value_eur), 0)) AS acquisition_spend
FROM incentive_combined
GROUP BY ALL
),

pm_acquisition_spend AS (
  SELECT
    global_entity_id,
    report_day,
    pm_acquisition_spend,
    acquisition_spend
  FROM pm_acquisition_spend_daily

  UNION ALL

  SELECT
    "Pandora" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodpanda" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY")
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodora" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodora+Yemeksepeti" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("YS_TR","MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL
)

SELECT
CASE
  WHEN daily.global_entity_id = "Pandora" THEN "Pandora"
  WHEN daily.global_entity_id = "Foodpanda" THEN "Foodpanda"
  WHEN daily.global_entity_id = "Foodora" THEN "Foodora"
  WHEN daily.global_entity_id = "Foodora+Yemeksepeti" THEN "Foodora+Yemeksepeti"
  ELSE country.name
END AS country_name,
daily.* EXCEPT(country_name),
subscriber.first_time_subscriber,
subscriber.returning_subscriber,
SAFE_DIVIDE((subscriber.first_time_subscriber+subscriber.returning_subscriber), daily.non_pro_active_customers) AS pro_rate,
pm_acquisition.pm_acquisitions,
pm_acquisition_spend.pm_acquisition_spend,
pm_acquisition_spend.acquisition_spend
FROM fulfillment-dwh-production.pandata_report.marketing__performance_dashboard_daily daily
LEFT JOIN subscriber 
       ON daily.global_entity_id = subscriber.global_entity_id
      AND daily.created_date_local = subscriber.report_date
LEFT JOIN pm_acquisition 
       ON daily.global_entity_id = pm_acquisition.global_entity_id
      AND daily.created_date_local = pm_acquisition.date
LEFT JOIN pm_acquisition_spend
       ON daily.global_entity_id = pm_acquisition_spend.global_entity_id
      AND daily.created_date_local = pm_acquisition_spend.report_day
LEFT JOIN fulfillment-dwh-production.pandata_datamart.pandora__core_countries country
       ON daily.global_entity_id = country.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1gn7420089ak4w1dgzs740sxlzo1' name='Custom SQL Query' type='text'><![CDATA[WITH subscriber AS (
  SELECT
    report_date,
    global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    report_date,
    "Pandora" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    report_date,
    "Foodpanda" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY")
  GROUP BY ALL

  UNION ALL

  SELECT
    report_date,
    "Foodora" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    report_date,
    "Foodora+Yemeksepeti" AS global_entity_id,
    SUM(newly_active_new_subscriber) AS first_time_subscriber,
    SUM(newly_active_reactivated_subscriber) AS returning_subscriber
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_subscriber_acquisition_churn`
  WHERE report_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
    AND global_entity_id IN ("YS_TR","MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL  
),
-- From Tamerlan
pm_flag AS (
  SELECT
    global_entity_id,
    date,
    CASE
      WHEN (goal_dh = "ACQUISITION" or goal_dh = "BRAND PROTECTION" or channel = "AFFILIATE" )
        OR (
        (sub_channel in ("REACH","RMA") and channel in ("DISPLAY","PAIDSOCIAL","APP")
      )
      OR channel like "SEM"
      OR sub_channel like "SEM"
      OR channel like "AFFILIATE"
      )
      THEN "PM"
      ELSE "nonPM"
    END AS PM_nonPM,
    SUM(acquisitions_calibration_ios14fix) AS pm_acquisitions
  FROM fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_l2_detailed
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR) AND CURRENT_DATE()
  GROUP BY ALL  
),

pm_acquisition AS (
  SELECT
    global_entity_id,
    date,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND PM_nonPM = "PM"
  GROUP BY ALL

  UNION ALL

  SELECT
    "Pandora" AS global_entity_id,
    date,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND PM_nonPM = "PM"
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodpanda" AS global_entity_id,
    date,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY")
  AND PM_nonPM = "PM"
  GROUP BY ALL  

  UNION ALL

  SELECT
    "Foodora" AS global_entity_id,
    date,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND PM_nonPM = "PM"
  GROUP BY ALL   

  UNION ALL

  SELECT
    "Foodora+Yemeksepeti" AS global_entity_id,
    date,
    SUM(pm_acquisitions) AS pm_acquisitions
  FROM pm_flag
  WHERE global_entity_id IN ("YS_TR","MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  AND PM_nonPM = "PM"
  GROUP BY ALL   
),

-- pm acq spend from Ozan
performance_marketing AS (
  select 
global_entity_id,
report_month,
kpi,
account_id,
SUM(bq_value_eur) as bq_value_eur,
SUM(bq_value_local) as bq_value_local,
SUM(bq_value_net_eur) as bq_value_net_eur,
SUM(bq_value_net_local) as bq_value_net_local
 from ((SELECT
    pm.global_entity_id,
    date as report_month,
CASE
    	WHEN (LOWER(campaign) LIKE "%dv360%" or LOWER(campaign) LIKE "%mob_bra%") and not (LOWER(campaign) LIKE "%_rma_%" or LOWER(campaign) LIKE "%_reach_%") THEN "Online PM for Acquisition"
	    WHEN LOWER(campaign) LIKE "%dis_bra%" THEN "Online Branding"
	    WHEN LOWER(campaign) LIKE "%dis_xrea%" THEN "Online Branding"
      WHEN (LOWER(campaign) LIKE "%ps_bra%" OR LOWER(campaign) LIKE "%smartly_bra%" OR LOWER(campaign) LIKE "%tiktok_bra%") THEN "Online Branding"
      WHEN (LOWER(campaign) LIKE "%smartly_xrea%" OR LOWER(campaign) LIKE "%ps_xrea%") THEN "Online Branding"
      WHEN campaign LIKE "dis_rmo%" THEN "Online PM for Retention"
      WHEN campaign LIKE "mob_rmo%" THEN "Online PM for Retention"
      WHEN campaign LIKE "mob_%" THEN "Online PM for Acquisition"
      WHEN campaign LIKE "dis_r%" THEN "Online PM for Acquisition"
      WHEN campaign LIKE "sem_rmo%" THEN "Online PM for Retention"
      WHEN (campaign LIKE "%sem%" AND campaign NOT LIKE "sem_bra%") THEN "Online PM for Acquisition"
      WHEN campaign LIKE "sem_bra%" THEN "SEM Brand"
      WHEN (campaign LIKE "ps_rmo%" OR campaign LIKE "smartly_rmo%") THEN  "Online PM for Retention"
      WHEN (campaign LIKE "ps_reach%" OR campaign LIKE "smartly_reach%" OR campaign LIKE "ps_rma%" OR campaign LIKE "smartly_rma%") THEN "Online PM for Acquisition"
    ELSE
    "Non-pm"
  END
    AS kpi,
    "" AS account_id,
    SUM(cost_eur)*-1 bq_value_eur,
    SUM(cost_eur*fx_rate_eur)*-1 as bq_value_local,
    SUM(cost_eur)*-1 bq_value_net_eur,
    SUM(cost_eur*fx_rate_eur)*-1 as bq_value_net_local

  FROM
    `fulfillment-dwh-production.curated_data_shared_coda_datamart.clarisights_camp_costs` as pm
    LEFT JOIN (SELECT 
DISTINCT
countries.global_entity_id,
fx_rates.currency_code,
fx_rates.fx_rate_date,
fx_rates.fx_rate_eur


FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` as fx_rates 
 join `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` as countries 
on fx_rates.currency_code = countries.currency_code_iso and countries.global_entity_id not like "%ODR_%"
WHERE fx_rate_date>>= "2024-01-01"

) as fx_rates on pm.global_entity_id =fx_rates.global_entity_id
and pm.date = fx_rates.fx_rate_date
  WHERE
    1=1
    AND DATE_TRUNC(date,month) >>= "2024-01-01"
    AND (
      (marketing_channel NOT IN ("Social Engagement","SEM - Restaurant Recruiting (SSU)", "Paid Social - Restaurant Recruiting","Cooperations","Paid Social - Riders","Partner ads")
      or marketing_channel is null)
    AND lower(campaign) NOT LIKE "%_rid_%" AND lower(campaign) NOT LIKE "%_rider_%" and lower(campaign) not like "%some_promo%")
    and pm.global_entity_id IN ("YS_TR", "NP_HU", "DJ_CZ", "MJM_AT", "OP_SE", "FO_NO", "PO_FI", "FP_BD", "FP_TW", "FP_KH", "FP_PK", "FP_MM", "FP_TH", "FP_SG", "FP_LA", "FP_HK", "FP_PH", "FP_MY")
  GROUP BY all
)
union all
(
    SELECT  
   aff.global_entity_id,
   conversion_date AS report_month,
"Online PM for Acquisition" as account_name,
"" AS account_id,
   SUM(cost_eur)*-1 bq_value_eur,
  SUM(cost_eur*fx_rate_eur)*-1 as bq_value_local,
    SUM(cost_eur)*-1 bq_value_net_eur,
    SUM(cost_eur*fx_rate_eur)*-1 as bq_value_net_local

FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_clarisights_affiliate_cost`  as aff
    LEFT JOIN (SELECT 
DISTINCT
countries.global_entity_id,
fx_rates.currency_code,
fx_rates.fx_rate_date,
fx_rates.fx_rate_eur


FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` as fx_rates 
 join `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` as countries 
on fx_rates.currency_code = countries.currency_code_iso and countries.global_entity_id not like "%ODR_%"
WHERE fx_rate_date>>= "2024-01-01"

) as fx_rates on aff.global_entity_id =fx_rates.global_entity_id
and aff.conversion_date = fx_rates.fx_rate_date
WHERE conversion_date  between "2024-01-01"  and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
GROUP BY ALL
HAVING bq_value_eur >> 1))
GROUP BY ALL


    UNION ALL

     SELECT
o.global_entity_id,
o.created_date_local as report_month,
case 
WHEN  (year = "2024" and region = "Europe" and loyalty.coupon_usage_status = "consumed") OR (year = "2024" and region = "Europe"
  and voucher_purpose = "loyalty") or (year = "2024" and region = "Europe"
  and voucher_channel = "channel_loyalty") THEN "Voucher Generic Retention"
WHEN year = "2024" and region = "Europe" and COALESCE(is_subscription_voucher,FALSE) THEN "Subscriptions"

  WHEN  (year = "2024" and region = "Europe" AND voucher_channel = "channel_online" AND voucher_purpose = "acquisition") OR
  (year = "2024" and region = "Europe" AND voucher_channel in ("channel_crm_prospect","channel_crm_ad_hoc") AND voucher_purpose IN ("platform_ec","local_shops_only","platform_nc","qc_general","dmart_only","platform_nc")) THEN "CRM Activities"


  WHEN (year = "2024" and region = "Europe" AND voucher_channel = "channel_online" AND voucher_purpose IN ("activation", "engagement", "reactivation")) OR 
  (year = "2024" and region = "Europe" AND voucher_channel IN ("channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation","channel_crm_ad_hoc") AND voucher_purpose IN ("platform_ec","local_shops_only","qc_general","dmart_only")) THEN "CRM Rebates And Discounts"

  WHEN year = "2024" and region = "Europe" AND  voucher_channel IN ("channel_referral_welcome","channel_referral_reward","channel_refer_a_friend") THEN "Refer A Friend"


  WHEN year = "2024" and region = "Europe" AND is_acquisition AND voucher_channel NOT IN ("channel_referral_welcome","channel_referral_reward","channel_online","channel_refer_a_friend","channel_crm_prospect","channel_crm_ad_hoc") and voucher_purpose NOT IN ("sorry_panda","loyalty","refund","benefits","revenue","corporate","customer_support")
  THEN "Vouchers Generic Acquisition"

  WHEN (year = "2024" and region = "Europe" AND NOT is_acquisition AND voucher_channel NOT IN ("channel_referral_welcome","channel_referral_reward","channel_online","channel_refer_a_friend","channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation","channel_crm_prospect","channel_loyalty") and voucher_purpose NOT IN ("sorry_panda","loyalty","refund","benefits","revenue","corporate","customer_support"))
    THEN "Voucher Generic Retention"

when year = "2025" and   Reporting_Lines_MCR_2025 = "Affiliate & Coop - EC" THEN "Voucher Generic Retention"
when year = "2025" and   Reporting_Lines_MCR_2025 = "Autocompensation Realtime" THEN "Autocompensation Realtime"
when year = "2025" and Reporting_Lines_MCR_2025 = "CF Vouchers" THEN "Voucher Generic Retention"
when year = "2025" and Reporting_Lines_MCR_2025 = "CRM RMA" THEN "CRM Activities"
when year = "2025" and Reporting_Lines_MCR_2025 = "CRM RMO" THEN "CRM Rebates And Discounts"
when year = "2025" and Reporting_Lines_MCR_2025 = "CX Vouchers" THEN "CX Vouchers"
when year = "2025" and Reporting_Lines_MCR_2025 = "Compensation" THEN "Compensation"
when year = "2025" and Reporting_Lines_MCR_2025 = "Corporate Vouchers" THEN "Corporate Vouchers"
when year = "2025" and Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new not in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "Voucher Generic Retention"
when year = "2025" and Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new  in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "Subscriptions"
when year = "2025" and Reporting_Lines_MCR_2025 ="Affiliate & Coop - NC" THEN "Vouchers Generic Acquisition" 
when year = "2025" and Reporting_Lines_MCR_2025 ="DHF Vouchers - HVAs" THEN "Voucher Generic Retention"
when year = "2025" and Reporting_Lines_MCR_2025 = "Employee Benefits" THEN "Employee Benefits"
when year = "2025" and Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform" and budget_channel_new = "Loyalty Programme" THEN "Voucher Generic Retention"
when year = "2025" and Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform " and budget_channel_new = "Loyalty Programme" THEN "Voucher Generic Retention"

when year = "2025" and Reporting_Lines_MCR_2025 in ("Refer-a-friend","Refer A Friend") THEN "Refer A Friend"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Vouchers - NC") THEN "Vouchers Generic Acquisition"
when year = "2025" and Reporting_Lines_MCR_2025 = "Experimentation" THEN "Voucher Generic Retention"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Rider Rewards") THEN "Rider Rewards"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Refund") THEN "Refund"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Test Vouchers") THEN "Test Vouchers"


when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Affiliate & Coop - EC" THEN "Voucher Generic Retention"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Autocompensation Realtime" THEN "Autocompensation Realtime"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CF Vouchers" THEN "Voucher Generic Retention"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CRM RMA" THEN "CRM Activities"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CRM RMO" THEN "CRM Rebates And Discounts"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CX Vouchers" THEN "CX Vouchers"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Compensation" THEN "Compensation"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Corporate Vouchers" THEN "Corporate Vouchers"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new not in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "Voucher Generic Retention"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new  in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "Subscriptions"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 ="Affiliate & Coop - NC" THEN "Vouchers Generic Acquisition" 
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 ="DHF Vouchers - HVAs" THEN "Voucher Generic Retention"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Employee Benefits" THEN "Employee Benefits"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform" and budget_channel_new = "Loyalty Programme" THEN "Voucher Generic Retention"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform " and budget_channel_new = "Loyalty Programme" THEN "Voucher Generic Retention"

when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Refer-a-friend","Refer A Friend") THEN "Refer A Friend"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Vouchers - NC") THEN "Vouchers Generic Acquisition"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Experimentation" THEN "Voucher Generic Retention"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Rider Rewards") THEN "Rider Rewards"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Refund") THEN "Refund"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Test Vouchers") THEN "Test Vouchers"
ELSE "Other Vouchers"


 end as account_name,

 case 
WHEN  (year = "2024" and region = "Europe" and loyalty.coupon_usage_status = "consumed") OR (year = "2024" and region = "Europe"
  and voucher_purpose = "loyalty") or (year = "2024" and region = "Europe"
  and voucher_channel = "channel_loyalty") THEN "P61342"
WHEN year = "2024" and region = "Europe" and COALESCE(is_subscription_voucher,FALSE) THEN "P61342"

  WHEN  (year = "2024" and region = "Europe" AND voucher_channel = "channel_online" AND voucher_purpose = "acquisition") OR
  (year = "2024" and region = "Europe" AND voucher_channel in ("channel_crm_prospect","channel_crm_ad_hoc") AND voucher_purpose IN ("platform_ec","local_shops_only","platform_nc","qc_general","dmart_only","platform_nc")) THEN "P61310"


  WHEN (year = "2024" and region = "Europe" AND voucher_channel = "channel_online" AND voucher_purpose IN ("activation", "engagement", "reactivation")) OR 
  (year = "2024" and region = "Europe" AND voucher_channel IN ("channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation","channel_crm_ad_hoc") AND voucher_purpose IN ("platform_ec","local_shops_only","qc_general","dmart_only")) THEN "P61340"

  WHEN year = "2024" and region = "Europe" AND  voucher_channel IN ("channel_referral_welcome","channel_referral_reward","channel_refer_a_friend") THEN "P61312"


  WHEN year = "2024" and region = "Europe" AND is_acquisition AND voucher_channel NOT IN ("channel_referral_welcome","channel_referral_reward","channel_online","channel_refer_a_friend","channel_crm_prospect","channel_crm_ad_hoc") and voucher_purpose NOT IN ("sorry_panda","loyalty","refund","benefits","revenue","corporate","customer_support")
  THEN "P61316"

  WHEN (year = "2024" and region = "Europe" AND NOT is_acquisition AND voucher_channel NOT IN ("channel_referral_welcome","channel_referral_reward","channel_online","channel_refer_a_friend","channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation","channel_crm_prospect","channel_loyalty") and voucher_purpose NOT IN ("sorry_panda","loyalty","refund","benefits","revenue","corporate","customer_support"))
    THEN "P61342"
when year = "2025" and  Reporting_Lines_MCR_2025 = "Affiliate & Coop - EC" THEN "P61342"
when year = "2025" and Reporting_Lines_MCR_2025 = "Autocompensation Realtime" THEN "Non-Carc"
when year = "2025" and Reporting_Lines_MCR_2025 = "CF Vouchers" THEN "P61342"
when year = "2025" and Reporting_Lines_MCR_2025 = "CRM RMA" THEN "P61310"
when year = "2025" and Reporting_Lines_MCR_2025 = "CRM RMO" THEN "P61340"
when year = "2025" and Reporting_Lines_MCR_2025 = "CX Vouchers" THEN "Non-Carc"
when year = "2025" and Reporting_Lines_MCR_2025 = "Compensation" THEN "Non-Carc"
when year = "2025" and Reporting_Lines_MCR_2025 = "Corporate Vouchers" THEN "Non-Carc"
when year = "2025" and Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new not in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "P61342"
when year = "2025" and Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new  in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "P61347"
when year = "2025" and Reporting_Lines_MCR_2025 ="Affiliate & Coop - NC" THEN "P61316" 
when year = "2025" and Reporting_Lines_MCR_2025 ="DHF Vouchers - HVAs" THEN "P61342"
when year = "2025" and Reporting_Lines_MCR_2025 = "Employee Benefits" THEN "Non-Carc"
when year = "2025" and Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform" and budget_channel_new = "Loyalty Programme" THEN "P61342"
when year = "2025" and Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform " and budget_channel_new = "Loyalty Programme" THEN "P61342"

when year = "2025" and Reporting_Lines_MCR_2025 in ("Refer-a-friend","Refer A Friend") THEN "P61312"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Vouchers - NC") THEN "P61316"
when year = "2025" and Reporting_Lines_MCR_2025 = "Experimentation" THEN "P61342"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Rider Rewards") THEN "Non-Carc"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Refund") THEN "Non-Carc"
when year = "2025" and Reporting_Lines_MCR_2025 in ("Test Vouchers") THEN "Non-Carc"

when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Affiliate & Coop - EC" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Autocompensation Realtime" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CF Vouchers" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CRM RMA" THEN "P61310"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CRM RMO" THEN "P61340"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "CX Vouchers" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Compensation" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Corporate Vouchers" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new not in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "DHF Vouchers" and budget_channel_new  in ("PandaPro Benefits","Subscription Benefit Vouchers") THEN "P61347"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 ="Affiliate & Coop - NC" THEN "P61316" 
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 ="DHF Vouchers - HVAs" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Employee Benefits" THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform" and budget_channel_new = "Loyalty Programme" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Loyalty & Cashback Platform " and budget_channel_new = "Loyalty Programme" THEN "P61342"

when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Refer-a-friend","Refer A Friend") THEN "P61312"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Vouchers - NC") THEN "P61316"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 = "Experimentation" THEN "P61342"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Rider Rewards") THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Refund") THEN "Non-Carc"
when year = "2024" and region = "APAC" and   Reporting_Lines_MCR_2025 in ("Test Vouchers") THEN "Non-Carc"
ELSE "Other Vouchers"

 end as account_id,
SUM(voucher_cost_dh_eur)*-1 as voucher_cost_dh_marketing_eur,
SUM(voucher_cost_dh_local)*-1 as voucher_cost_dh_marketing_local,
SUM(voucher_cost_dh_net_eur)*-1 as voucher_cost_dh_marketing_exc_vat_eur,
SUM(voucher_cost_dh_net_local)*-1 as voucher_cost_dh_marketing_exc_vat_local,

FROM
  `dhh---analytics-eu.bi_marketing.pandora_agg_mcr_orders` o
  LEFT JOIN
  `dhh---analytics-eu.bi_marketing.regional_eu_loyalty_vouchers` AS loyalty
ON
  loyalty.global_entity_id = o.global_entity_id
  AND loyalty.order_id = o.order_code
  where o.business_type <<>> "dmart"
group by all
 ),

deals_raw as (
SELECT 
  o.global_entity_id,
  o.order_code,
  o.created_date_local,
  o.is_acquisition as is_acquisition_order,
  o.business_type,
  o.discount_type,
  o.is_discount_used,
  o.df_user_paid_incl_vat_eur,
  o.df_original_incl_vat_eur,
  o.df_original_incl_vat_local,
  o.df_original_excl_vat_eur,
  o.df_original_excl_vat_local,
  o.is_meal_for_one,
  CASE WHEN o.dps_details.dps_type = "dps_bvdf" THEN TRUE ELSE FALSE end as is_bvdf,

COALESCE(o.is_subscription_incentive_order,FALSE) as is_subscription_incentive_order,
  case when o.delivery_type = "Own Delivery" then TRUE else FALSE end as is_own_delivery,
  COALESCE(discounts.is_evergreen,FALSE) as is_evergreen,
  COALESCE(o.is_subscription_incentive_order,FALSE) as still_is_subscription_incentive_order,
  COALESCE(subscription.is_subscription_voucher_order,FALSE) as is_subscription_voucher_order,
  
---
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN  o.discount_cost_dh_eur END,0) AS dh_deal_pickup_pro_eur,
COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN  o.discount_cost_dh_net_eur END,0) AS dh_deal_pickup_pro_exc_vat_eur,
---
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN o.discount_cost_dh_local END,0) AS dh_deal_pickup_pro_local,
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = "pickup" THEN o.voucher_cost_dh_net_local END,0) AS dh_deal_pickup_pro_exc_vat_local,
---
  ARRAY_TO_STRING(discounts.expedition_types,",") as expedition_types,
  COALESCE(subscription.is_subscription_discount_order,FALSE) as is_subscription_discount_order,
---
  CASE WHEN  subscription.is_free_delivery_dh_fully_funded_subscription_order or is_free_delivery_vendor_fully_funded_subscription_order or o.dps_details.dps_type = "dps_subscription" THEN TRUE
  WHEN  is_discounted_delivery_subscription_order THEN TRUE
   ELSE FALSE END AS is_free_delivery_subscription_order,
--
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_eur END,0) AS dh_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_vendor_eur END,0) AS vendor_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_eur END,0) AS all_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_eur END,0) AS dh_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_eur END,0) AS all_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_eur END,0)-COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_eur END,0) as vendor_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_local END,0) AS dh_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_vendor_local END,0) AS vendor_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_local END,0) AS all_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_local END,0) AS dh_deal_free_delivery_exc_vat_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_local END,0) AS all_deal_free_delivery_exc_vat_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_net_local END,0)-COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_local END,0) AS vendor_deal_free_delivery_exc_vat_local,

COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_eur END,0) AS fd_voucher_dh_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_vendor_eur END,0) AS fd_voucher_vendor_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_eur END,0) AS fd_voucher_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_eur END,0) AS fd_voucher_dh_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_eur END,0) AS fd_voucher_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_eur END,0)-COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_eur END,0) as fd_voucher_vendor_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_local END,0) AS fd_voucher_dh_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_vendor_local END,0) AS fd_voucher_vendor_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_local END,0) AS fd_voucher_local, 
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_local END,0) AS fd_voucher_dh_exc_vat_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_local END,0)-COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_dh_net_local END,0) as fd_voucher_vendor_exc_vat_local,
COALESCE(CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_cost_net_local END,0) AS fd_voucher_exc_vat_local,



COALESCE(o.dps_total_dh_cost_eur,0) AS dps_fd_dh_eur,
COALESCE(o.dps_total_vendor_cost_eur,0) as dps_fd_vendor_eur,
COALESCE(o.dps_total_vendor_cost_local,0) as dps_total_vendor_cost_local,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_dh_cost_eur,0),COALESCE(o.dps_total_cost_eur,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_eur,0),0) AS dps_fd_dh_exc_vat_eur,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_vendor_cost_eur,0),COALESCE(o.dps_total_cost_eur,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_eur,0),0) AS dps_fd_vendor_exc_vat_eur,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_vendor_cost_local,0),COALESCE(o.dps_total_cost_local,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_local,0),0) AS dps_fd_vendor_exc_vat_local,


COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_eur END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_eur END),0) = 0 THEN o.dps_total_cost_eur END,0) AS dps_fd_eur, 
  
COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_eur END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_eur END),0) = 0 THEN dps_costs.dps_total_cost_excl_vat_eur END,0) AS dps_fd_exc_vat_eur, 

 COALESCE(o.dps_total_dh_cost_local,0) AS dps_fd_dh_local,
 SAFE_DIVIDE(COALESCE(o.dps_total_dh_cost_local,0),COALESCE(o.dps_total_cost_local,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_local,0) AS dps_fd_dh_exc_vat_local,

COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_local END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_local END),0) = 0 THEN o.dps_total_cost_local END,0) AS dps_fd_local, 

COALESCE(CASE WHEN IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_value_local END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = "free_delivery" THEN o.voucher_value_local END),0)  = 0 THEN dps_costs.dps_total_cost_excl_vat_local END,0) AS dps_fd_exc_vat_local,

 COALESCE(o.discount_cost_dh_local,0) + COALESCE(o.mp_fd_cost_dh_local,0) + COALESCE(o.dps_total_dh_cost_local,0) as dh_deal_total_local,
 COALESCE(o.discount_cost_dh_eur,0) + COALESCE(o.mp_fd_cost_dh_eur,0) + COALESCE(o.dps_total_dh_cost_eur,0) as dh_deal_total_eur,
  COALESCE(o.discount_cost_dh_net_eur,0)- COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_eur END,0) as dh_deal_total_net_eur,
  COALESCE(o.discount_cost_dh_net_local,0)- COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = "free_delivery" THEN o.discount_cost_dh_net_local END,0) as dh_deal_total_net_local,
 0 as disco_vouchers,
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_value_local-o.discount_cost_dh_local END,0) as pro_discount_vf_local, 
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_value_eur-o.discount_cost_dh_eur END,0) as pro_discount_vf_eur, 
COALESCE(case when o.is_subscription_voucher_order  THEN  o.voucher_value_local-o.voucher_cost_dh_local END,0) as pro_voucher_vf_local, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_value_eur-o.voucher_cost_dh_eur END,0)  as pro_voucher_vf_eur,

COALESCE(case when o.is_subscription_discount_order  THEN o.discount_cost_net_local-o.discount_cost_dh_net_local END,0) as pro_discount_vf_net_local, 
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_cost_net_eur-o.discount_cost_dh_net_eur END,0) as pro_discount_vf_net_eur, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_cost_net_local-o.voucher_cost_dh_net_local END,0) as pro_voucher_vf_net_local, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_cost_net_eur-o.voucher_cost_dh_net_eur END,0)  as pro_voucher_vf_net_eur

FROM
 `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
 LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_discount_costs` as marketing_discounts
ON
  marketing_discounts.order_code = o.order_code
  AND marketing_discounts.global_entity_id = o.global_entity_id 
  AND marketing_discounts.created_date_local>>="2025-01-01"
LEFT JOIN
  `fulfillment-dwh-production.pandata_datamart.pandora__order_subscriptions` AS subscription
ON
  subscription.global_entity_id = o.global_entity_id
  AND subscription.order_code = o.order_code

LEFT JOIN    `fulfillment-dwh-production.pandata_curated.offers_discounts` as discounts on discounts.uuid = o.pd_discount_uuid and discounts.global_entity_id = o.global_entity_id

LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_dps_costs` as dps_costs
ON
  dps_costs.order_code = o.order_code
  AND dps_costs.global_entity_id = o.global_entity_id and dps_costs.created_date_local>>= "2025-01-01"

      WHERE 1=1
        AND o.created_date_local >>= "2025-07-01"
        AND o.is_billable
        and o.business_type <<>> "dmart"
        and o.global_entity_id not like "%ODR_%"
        
      GROUP BY all


UNION ALL

SELECT * EXCEPT(is_pickup_evergreen_discount)
FROM  `dhh---analytics-eu.bi_marketing.2024_deals_mcr`
),


deals_agg as (  # OK
SELECT 
  deals.global_entity_id,
  
  deals.created_date_local AS month,
  CASE 
  -- Subscription Discounts
  WHEN   COALESCE(deals.is_subscription_discount_order,FALSE) THEN "Subscriptions"
  --  Deals NC
  WHEN  COALESCE(deals.is_acquisition_order,FALSE) and NOT COALESCE(deals.is_subscription_discount_order,FALSE) THEN "DH Funded Discounts Acquisition"
  -- Deals EC
  WHEN  NOT COALESCE(deals.is_acquisition_order,FALSE)  and  NOT COALESCE(deals.is_subscription_discount_order,FALSE) THEN "DH Funded Discounts Retention"

  ELSE "Other Deals"

  END AS account_name,
  "" AS accontut_id,

  SUM(COALESCE((ROUND(COALESCE(dh_deal_total_eur,0),2) - ROUND(COALESCE(dh_deal_free_delivery_eur,0),2) - ROUND(COALESCE(dps_fd_dh_eur,0),2) - 
  ROUND(COALESCE(dh_deal_pickup_pro_eur,0),2)), 0))*-1  AS incentive_cost_dh_eur,
  SUM(COALESCE((ROUND(COALESCE(dh_deal_total_local,0),2) - ROUND(COALESCE(dh_deal_free_delivery_local,0),2) - ROUND(COALESCE(dps_fd_dh_local,0),2) - 
  ROUND(COALESCE(dh_deal_pickup_pro_local,0),2)), 0))*-1 AS incentive_cost_dh_local ,
  SUM(dh_deal_total_net_eur)*-1 as incentive_cost_dh_net_eur,
  SUM(dh_deal_total_net_local)*-1 as incentive_cost_dh_net_local

FROM deals_raw as deals
WHERE 1=1
     -- AND deals.discount_type != "free_delivery"
     -- AND deals.is_discount_used
      GROUP BY all
),

od_fd_cost as ( # See slack message -- done 
select 
global_entity_id,
created_date_local AS month,
      CASE
-- Subscription
---WHEN  is_free_delivery_subscription_order and is_own_delivery THEN "Delivery Fee Reduction Marketing Non Subscription"
-- FD MMT New Customers done 
WHEN NOT is_free_delivery_subscription_order AND is_acquisition_order and is_own_delivery and NOT is_meal_for_one and not is_bvdf
THEN "Revenue Reduction From Delivery Fee Acquisition"
-- FD MMT Existing Customers -- done 
WHEN NOT is_free_delivery_subscription_order AND NOT is_acquisition_order and is_own_delivery and NOT is_meal_for_one and not is_bvdf
THEN "Delivery Fee Reduction Marketing Non Subscription"
ELSE "Other DF"
END AS account_name,
"" as account_id,
SUM(all_deal_free_delivery_eur+fd_voucher_eur+dps_fd_eur)*-1 AS incentive_cost_dh_eur,
SUM(all_deal_free_delivery_local+fd_voucher_local+dps_fd_local)*-1  AS incentive_cost_dh_local,
SUM(all_deal_free_delivery_exc_vat_eur+fd_voucher_exc_vat_eur+dps_fd_exc_vat_eur)*-1  AS incentive_cost_dh_net_eur,
SUM(all_deal_free_delivery_exc_vat_local+fd_voucher_exc_vat_local+dps_fd_exc_vat_local)*-1  AS incentive_cost_dh_net_local
from deals_raw
WHERE is_own_delivery
GROUP BY ALL
),

mp_fd_cost AS ( # let"s split this into Dmart and Platform too in case it"s needed -- done 
  select 
  global_entity_id,
created_date_local AS month,
CASE WHEN NOT is_free_delivery_subscription_order and not is_acquisition_order THEN "Voucher Generic Retention"
 WHEN NOT is_free_delivery_subscription_order and  is_acquisition_order THEN "Vouchers Generic Acquisition"
ELSE "Other DF MP" END AS account_name,
"" as account_id,
SUM(COALESCE(dh_deal_free_delivery_eur,0)+COALESCE(fd_voucher_dh_eur,0)+COALESCE(dps_fd_dh_eur,0))*-1 AS incentive_cost_dh_eur,
SUM(COALESCE(dh_deal_free_delivery_local,0)+COALESCE(fd_voucher_dh_local,0)+COALESCE(dps_fd_dh_local,0))*-1 AS incentive_cost_dh_local,
SUM(COALESCE(dh_deal_free_delivery_exc_vat_eur,0)+COALESCE(fd_voucher_dh_exc_vat_eur,0)+COALESCE(dps_fd_dh_exc_vat_eur,0))*-1 AS incentive_cost_dh_net_eur,
SUM(COALESCE(dh_deal_free_delivery_exc_vat_local,0)+COALESCE(fd_voucher_dh_exc_vat_local,0)+COALESCE(dps_fd_dh_exc_vat_local,0))*-1 AS incentive_cost_dh_net_local
   from deals_raw
  WHERE not is_own_delivery

group by all
),

incentive_combined as(select 
global_entity_id,
report_month AS report_day, -- Irene"s note: actually, this is daily data. To avoid breaking any part, I didn"t touch anything besides rename this row.
kpi,
sum(bq_value_eur) as bq_value_eur, 
sum(bq_value_local) as bq_value_local,
SUM(bq_value_net_eur) as bq_value_net_eur,
sum(bq_value_net_local) as bq_value_net_local 
from (select * from performance_marketing
union all
select * from deals_agg
union all
select * from od_fd_cost
 )
group by all),

pm_acquisition_spend_daily AS (
SELECT
  global_entity_id,
  report_day,
  SUM(IF(kpi IN ("Online PM for Acquisition","SEM Brand"), ABS(bq_value_eur), 0)) AS pm_acquisition_spend,
  SUM(IF(kpi IN ("Vouchers Generic Acquisition","Revenue Reduction From Delivery Fee Acquisition", "DH Funded Discounts Acquisition","CRM Activities","Refer A Friend","Online PM for Acquisition","SEM Brand"), ABS(bq_value_eur), 0)) AS acquisition_spend
FROM incentive_combined
GROUP BY ALL
),

pm_acquisition_spend AS (
  SELECT
    global_entity_id,
    report_day,
    pm_acquisition_spend,
    acquisition_spend
  FROM pm_acquisition_spend_daily

  UNION ALL

  SELECT
    "Pandora" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY","YS_TR", "MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodpanda" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("FP_BD","FP_KH","FP_TH","FP_MM","FP_SG","FP_PK","FP_LA","FP_HK","FP_TW","FP_PH","FP_MY")
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodora" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL

  UNION ALL

  SELECT
    "Foodora+Yemeksepeti" AS global_entity_id,
    report_day,
    SUM(pm_acquisition_spend) AS pm_acquisition_spend,
    SUM(acquisition_spend) AS acquisition_spend
  FROM pm_acquisition_spend_daily
  WHERE global_entity_id IN ("YS_TR","MJM_AT", "OP_SE","FO_NO","PO_FI","NP_HU","DJ_CZ")
  GROUP BY ALL
)

SELECT
CASE
  WHEN daily.global_entity_id = "Pandora" THEN "Pandora"
  WHEN daily.global_entity_id = "Foodpanda" THEN "Foodpanda"
  WHEN daily.global_entity_id = "Foodora" THEN "Foodora"
  WHEN daily.global_entity_id = "Foodora+Yemeksepeti" THEN "Foodora+Yemeksepeti"
  ELSE country.name
END AS country_name,
daily.* EXCEPT(country_name),
subscriber.first_time_subscriber,
subscriber.returning_subscriber,
SAFE_DIVIDE((subscriber.first_time_subscriber+subscriber.returning_subscriber), daily.non_pro_active_customers) AS pro_rate,
pm_acquisition.pm_acquisitions,
pm_acquisition_spend.pm_acquisition_spend,
pm_acquisition_spend.acquisition_spend
FROM fulfillment-dwh-production.pandata_report.marketing__performance_dashboard_daily daily
LEFT JOIN subscriber 
       ON daily.global_entity_id = subscriber.global_entity_id
      AND daily.created_date_local = subscriber.report_date
LEFT JOIN pm_acquisition 
       ON daily.global_entity_id = pm_acquisition.global_entity_id
      AND daily.created_date_local = pm_acquisition.date
LEFT JOIN pm_acquisition_spend
       ON daily.global_entity_id = pm_acquisition_spend.global_entity_id
      AND daily.created_date_local = pm_acquisition_spend.report_day
LEFT JOIN fulfillment-dwh-production.pandata_datamart.pandora__core_countries country
       ON daily.global_entity_id = country.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
