    <worksheet name='RM - MoM'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>MoM (MTD)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly View' name='federated.0a3rb9y0mzjvol1dsn25801vxq12' />
            <datasource caption='Weekly View' name='federated.1dvwlcx082dwz819ufrbc0owd1qd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0a3rb9y0mzjvol1dsn25801vxq12].[Calculation_64387426694250499]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0a3rb9y0mzjvol1dsn25801vxq12].[month_local]' caption='Reporting Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0a3rb9y0mzjvol1dsn25801vxq12'>
            <column caption='acquisition_spend_RM MoM' datatype='real' name='[Calculation_1709116085693218816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [acquisition_spend] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [acquisition_spend]&#10;    END)&#10;-1&#10;}' />
            </column>
            <column caption='pm_acquisition_spend_RM MoM' datatype='real' name='[Calculation_1709116085693399041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [pm_acquisition_spend] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;month&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [pm_acquisition_spend]&#10;    END)&#10;-1&#10;}' />
            </column>
            <column caption='acquisition_MoM MTD' datatype='real' name='[Calculation_2962876008156250114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([month_local]) = ATTR([Calculation_2962876008157491203])&#10;THEN (SUM([acquisition_MTD]) / SUM([acquisition_PMTD])) -1&#10;ELSE SUM([acquisition RM YoY (copy)_64387426862919682])&#10;END' />
