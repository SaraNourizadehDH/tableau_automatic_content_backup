                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - Acquisitions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Run Rate based on No of Days</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> (Current month MTD * No of days MTD) / Total no of days in a month</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - Reacquisitions</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  - PM Acquisitions</run>
                    <run>Æ&#10;</run>
