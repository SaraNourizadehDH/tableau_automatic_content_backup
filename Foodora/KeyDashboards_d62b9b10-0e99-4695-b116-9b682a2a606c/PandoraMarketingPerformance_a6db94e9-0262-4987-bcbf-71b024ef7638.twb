    <worksheet name='Sheet 10'>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly View' name='federated.0a3rb9y0mzjvol1dsn25801vxq12' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0a3rb9y0mzjvol1dsn25801vxq12].[Calculation_64387426694250499]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0a3rb9y0mzjvol1dsn25801vxq12].[month_local]' caption='Reporting Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0a3rb9y0mzjvol1dsn25801vxq12'>
            <column caption='Current Month' datatype='datetime' name='[Calculation_2962876008157491203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, TODAY()-1)' />
            </column>
            <column caption='Max Reporting Month' datatype='datetime' name='[Calculation_64387426694250499]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;month&apos;, -1, [month_local]))}' />
            </column>
            <column caption='successful_order RM YoY' datatype='real' name='[Calculation_64387426718224393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 1], [country_name]:&#10;SUM(IF [month_local] = [Parameters].[Parameter 1] THEN [successful_orders] END)/&#10;SUM(IF [month_local] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) &#10;    THEN [successful_orders]&#10;    END)&#10;-1&#10;}' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[entity]' role='dimension' type='nominal' />
            <column datatype='date' name='[month_local]' role='dimension' type='ordinal' />
            <column-instance column='[month_local]' derivation='MY' name='[my:month_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[entity]' derivation='None' name='[none:entity:nk]' pivot='key' type='nominal' />
            <column caption='successful_order_YoY MTD' datatype='real' name='[reactivations_YoY MTD (copy)_2962876008221331512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([month_local]) = ATTR([Calculation_2962876008157491203])&#10;THEN (SUM([successful_orders_MTD]) / SUM([successful_orders_PYMTD])) -1&#10;ELSE SUM([Calculation_64387426718224393])&#10;END' />
            </column>
            <column datatype='integer' name='[successful_orders]' role='measure' type='quantitative' />
