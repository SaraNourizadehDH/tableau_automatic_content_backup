      <table>
        <view>
          <datasources>
            <datasource caption='reactivation_cohort' name='federated.1rc18ih03d4hep16es8h81k1d47f' />
          </datasources>
          <datasource-dependencies datasource='federated.1rc18ih03d4hep16es8h81k1d47f'>
            <column caption='CPA' datatype='real' name='[Calculation_4050424955755806721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentive_cost_fp_marketing_eur]) / SUM([num_users])' />
