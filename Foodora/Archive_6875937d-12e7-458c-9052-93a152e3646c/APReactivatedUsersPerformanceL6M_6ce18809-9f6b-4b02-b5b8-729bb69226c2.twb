              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Customers&apos; THEN [Calculation_1481332447366377475]&#10;WHEN &apos;Orders&apos; THEN [Total Customers (copy)_1481332447366516740]&#10;WHEN &apos;GMV&apos; THEN ROUND([Calculation_1481332447366742021],0)&#10;WHEN &apos;GFV&apos; THEN ROUND([Total GMV (copy)_1481332447366770694],0)&#10;WHEN &apos;Comm Rev Net Incentives&apos; THEN ROUND([Total GFV (copy)_6192449502637162501],0)&#10;WHEN &apos;Incentivised Orders&apos; THEN [Total Customers (copy)_1481332447366897671]&#10;WHEN &apos;FP Incentive Cost&apos; THEN ROUND([Total Customers (copy)_1481332447367200777],0)&#10;WHEN &apos;Vendor Incentive Cost&apos; THEN ROUND([Total FP Incentive Cost (copy)_1481332447367364618],0)&#10;WHEN &apos;% Incentivised Orders&apos; THEN ROUND([Calculation_1481332447367004168]*100,2)&#10;WHEN &apos;Vouchered Orders&apos; THEN [Total Incentivised Orders (copy)_6192449502636244993]&#10;WHEN &apos;Orders w/ VF&apos; THEN [Total Vouchered Orders (copy)_6192449502636380162]&#10;WHEN &apos;% Vouchered Orders&apos; THEN ROUND([% Incentivised Orders (copy)_6192449502636163072]*100,2)&#10;WHEN &apos;% Orders w/ VF&apos; THEN ROUND([% Incentivised Orders (copy)_6192449502636670979]*100,2)&#10;WHEN &apos;AFV&apos; THEN ROUND([Calculation_1481332447367454731],2)&#10;WHEN &apos;FP iCPO&apos; THEN ROUND([Total Orders w/ VF (copy)_6192449502637252614],2)&#10;END)' />
