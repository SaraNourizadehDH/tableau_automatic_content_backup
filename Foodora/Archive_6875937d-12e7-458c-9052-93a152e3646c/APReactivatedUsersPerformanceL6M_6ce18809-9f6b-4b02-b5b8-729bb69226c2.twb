        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1e1kslw1d4r7vr1doqg181mh9j6h' name='Custom SQL Query' type='text'>WITH shared_countries AS (
  SELECT 
    global_entity_id,
    name AS country
  FROM fulfillment-dwh-production.pandata_curated.shared_countries
  WHERE region = &quot;Asia&quot;
    AND company_name = &quot;Foodpanda&quot;
    AND global_entity_id NOT IN (&quot;FP_MM&quot;)
)

SELECT
  base.global_entity_id,
  shared_countries.country,
  DATE(base.date_month) AS date_month,
  base.user_bucket,
  COUNT(DISTINCT base.pd_customer_uuid) AS num_users,
  COUNT(DISTINCT CASE WHEN base.user_bucket = &quot;reactivated&quot; THEN base.pd_customer_uuid END) AS num_reactivated_users
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_monthly_platform_user_buckets` AS base
LEFT JOIN shared_countries
       ON shared_countries.global_entity_id = base.global_entity_id
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1e1kslw1d4r7vr1doqg181mh9j6h' name='Custom SQL Query' type='text'>WITH shared_countries AS (
