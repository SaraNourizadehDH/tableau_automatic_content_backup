          <formatted-text />
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='reactivation_cohort' name='federated.1rc18ih03d4hep16es8h81k1d47f' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Per Customer Metrics' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;GFV Per Customer&quot;'>
              <calculation class='tableau' formula='&quot;GFV Per Customer&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rc18ih03d4hep16es8h81k1d47f'>
            <column caption='1' datatype='integer' name='[Calculation_1481332447366152193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Total Customers' datatype='integer' name='[Calculation_1481332447366377475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_users])' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_1481332447366742021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])' />
            </column>
            <column caption='Per Customer Metrics' datatype='string' name='[Calculation_1481332447375228949]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Orders Per Customer&apos; THEN STR(ROUND([Total Orders (copy)_1481332447375310870],2))&#10;WHEN &apos;GMV Per Customer&apos; THEN STR(ROUND([Total GMV (copy)_1481332447375409175],2))&#10;WHEN &apos;GFV Per Customer&apos; THEN STR(ROUND([Total GFV (copy)_1481332447375482904],2))&#10;WHEN &apos;Incentivised Orders Per Customer&apos; THEN STR(ROUND([Total Incentivised Orders (copy)_1481332447375892507],2))&#10;WHEN &apos;FP Incentive Cost Per Customer&apos; THEN STR(ROUND([Total FP Incentive Cost (copy)_1481332447375601689],2))&#10;WHEN &apos;Vendor Incentive Cost Per Customer&apos; THEN STR(ROUND([Total Vendor Incentive Cost (copy)_1481332447375699994],2))&#10;WHEN &apos;Vouchered Orders Per Customer&apos; THEN STR(ROUND([Incentivised Orders Per Customer (copy)_6192449502640828423],2))&#10;WHEN &apos;Orders w/ VF Per Customer&apos; THEN STR(ROUND([Incentivised Orders Per Customer (copy) (copy)_6192449502640840712],2))&#10;END)' />
            </column>
            <column caption='Per Customer Metrics (numeric)' datatype='real' name='[Calculation_1481332447376093212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Orders Per Customer&apos; THEN [Total Orders (copy)_1481332447375310870]&#10;WHEN &apos;GMV Per Customer&apos; THEN [Total GMV (copy)_1481332447375409175]&#10;WHEN &apos;GFV Per Customer&apos; THEN [Total GFV (copy)_1481332447375482904]&#10;WHEN &apos;Incentivised Orders Per Customer&apos; THEN [Total Incentivised Orders (copy)_1481332447375892507]&#10;WHEN &apos;FP Incentive Cost Per Customer&apos; THEN [Total FP Incentive Cost (copy)_1481332447375601689]&#10;WHEN &apos;Vendor Incentive Cost Per Customer&apos; THEN [Total Vendor Incentive Cost (copy)_1481332447375699994]&#10;WHEN &apos;Vouchered Orders Per Customer&apos; THEN [Incentivised Orders Per Customer (copy)_6192449502640828423]&#10;WHEN &apos;Orders w/ VF Per Customer&apos; THEN [Incentivised Orders Per Customer (copy) (copy)_6192449502640840712]&#10;END' />
            </column>
            <column caption='Per Customer Metric (change)' datatype='real' name='[Calculation_1481332447376207901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_1481332447376093212]) - LOOKUP(ZN([Calculation_1481332447376093212]), -1)) / ABS(LOOKUP(ZN([Calculation_1481332447376093212]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders w/ VF Per Customer' datatype='real' name='[Incentivised Orders Per Customer (copy) (copy)_6192449502640840712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Vouchered Orders (copy)_6192449502636380162]/[Calculation_1481332447366377475]' />
            </column>
            <column caption='Vouchered Orders Per Customer' datatype='real' name='[Incentivised Orders Per Customer (copy)_6192449502640828423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Incentivised Orders (copy)_6192449502636244993]/[Calculation_1481332447366377475]' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Total Customers (copy)_1481332447366516740]' role='measure' type='quantitative'>
