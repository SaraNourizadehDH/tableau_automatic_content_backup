    <worksheet name='CG Country Total %'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ff2784' fontname='Verdana' fontsize='12'>&lt;[Parameters].[Parameter 5]&gt;</run>
            <run fontcolor='#000000' fontname='Verdana' fontsize='12'> CG Spend (Country Total) </run>
            <run fontcolor='#e23265' fontname='Verdana' fontsize='10'>[Addressable Only]</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dg_dash_cg_tracking' name='federated.06brmv81nfxsec1ex9wxo1gt28lj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Percent %' caption='Values (CG)' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percent&quot;'>
              <calculation class='tableau' formula='&quot;Percent&quot;' />
              <aliases>
                <alias key='&quot;Absolute&quot;' value='Absolute €' />
                <alias key='&quot;Percent&quot;' value='Percent %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06brmv81nfxsec1ex9wxo1gt28lj'>
            <column caption='Values (CG) Toggle' datatype='string' name='[Calculation_5196942925786824720]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Percent&quot; THEN STR(ROUND([Calculation_5775444368489091073]*100, 1)) + &apos;%&apos;&#10;WHEN &quot;Absolute&quot; THEN REGEXP_REPLACE(STR(ROUND(SUM([cg_addressable_incentive_cost_mktg_eur]), 0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;END' />
            </column>
            <column caption='is_APAC' datatype='boolean' name='[Calculation_5196942925788545041]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country] = &quot;APAC&quot; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='% cg addressable spend' datatype='real' name='[Calculation_5775444368489091073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cg_addressable_incentive_cost_mktg_eur])/SUM([incentive_cost_mktg_eur])' />
            </column>
            <column caption='Addressable Cg' datatype='string' name='[addressable_cg]' role='dimension' type='nominal' />
            <column caption='Cg Addressable Incentive Cost Mktg Eur' datatype='real' name='[cg_addressable_incentive_cost_mktg_eur]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Incentive Cost Mktg Eur' datatype='real' name='[incentive_cost_mktg_eur]' role='measure' type='quantitative' />
            <column caption='Incentive Type' datatype='string' name='[incentive_type]' role='dimension' type='nominal' />
