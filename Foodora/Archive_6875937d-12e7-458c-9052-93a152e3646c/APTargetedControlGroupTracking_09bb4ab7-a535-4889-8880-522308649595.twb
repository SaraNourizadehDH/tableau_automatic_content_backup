          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Percent %' caption='Values' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percent&quot;'>
              <calculation class='tableau' formula='&quot;Percent&quot;' />
              <aliases>
                <alias key='&quot;Absolute&quot;' value='Absolute €‎' />
                <alias key='&quot;Percent&quot;' value='Percent %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q3gpzm033u57b1aztpav01b7mtd'>
            <column caption='Addressable Grouping Lvl 1' datatype='string' name='[Calculation_2185231021695639553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [addressable_at] = &quot;Addressable&quot; THEN [at_type]&#10;ELSE &quot;&quot; END' />
            </column>
            <column caption='is_APAC' datatype='boolean' name='[Calculation_5196942925439205386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country]= &quot;APAC&quot; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Values Toggle' datatype='string' name='[Calculation_5196942925777145869]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Percent&apos; THEN STR(ROUND([Calculation_5775444368483569664]*100, 1)) + &apos;%&apos;&#10;WHEN &apos;Absolute&apos; THEN REGEXP_REPLACE(STR(ROUND(SUM([targeted_addressable_incentive_cost_mktg_eur]),0)), &apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;END' />
            </column>
            <column caption='% targeted addressable spend' datatype='real' default-format='p0.00%' name='[Calculation_5775444368483569664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([targeted_addressable_incentive_cost_mktg_eur])/SUM([incentive_cost_mktg_eur])' />
            </column>
