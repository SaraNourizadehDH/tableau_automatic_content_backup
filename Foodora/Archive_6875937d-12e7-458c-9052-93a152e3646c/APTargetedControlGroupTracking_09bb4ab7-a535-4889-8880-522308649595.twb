              <calculation class='tableau' formula='IF SUM([incentive_cost_mktg_eur]) &gt; 0&#10;THEN TRUE&#10;ELSE FALSE &#10;END' />
            </column>
            <column caption='Addressable Grouping Lvl 1' datatype='string' name='[Calculation_2185231021695639553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [addressable_at] = &quot;Addressable&quot; THEN [at_type]&#10;ELSE &quot;&quot; END' />
            </column>
            <column caption='ovmc_spend_eur' datatype='real' name='[Calculation_5196942925418938368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [construct_type] = &quot;multiple&quot; THEN [incentive_cost_mktg_eur] ELSE 0 END' />
            </column>
            <column caption='% ovmc spend' datatype='real' name='[Calculation_5196942925419360257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5196942925418938368])/ SUM([incentive_cost_mktg_eur])' />
            </column>
            <column caption='is_APAC' datatype='boolean' name='[Calculation_5196942925439205386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country]= &quot;APAC&quot; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Values Toggle (OVMC)' datatype='real' name='[Values Toggle (copy)_5064649690921803777]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Values (copy)_5064649690921578496]&#10;WHEN &quot;Percent&quot; THEN (ROUND([Calculation_5196942925419360257]*100, 1))&#10;WHEN &quot;Absolute&quot; THEN ROUND(SUM([Calculation_5196942925418938368]),0)&#10;END' />
            </column>
            <column caption='Addressable At' datatype='string' name='[addressable_at]' role='dimension' type='nominal' />
