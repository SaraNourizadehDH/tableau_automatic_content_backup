                <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_KH&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_marketing_FP_LA&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[global_entity_id]' member='&quot;APAC&quot;' />
                <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_LA&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_marketing_FP_MM&apos;)' function='filter'>
              <groupfilter function='union'>
