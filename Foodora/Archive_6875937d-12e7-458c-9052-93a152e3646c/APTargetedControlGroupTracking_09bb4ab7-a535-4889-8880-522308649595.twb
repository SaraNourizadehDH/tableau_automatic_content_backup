      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ff2784' fontname='Verdana' fontsize='12'>&lt;[Parameters].[Parameter 4]&gt;</run>
            <run fontcolor='#000000' fontname='Verdana' fontsize='12'> Targeted Spend (Country Total) </run>
            <run fontcolor='#e23265' fontname='Verdana' fontsize='12'>[Addressable Only]</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
