          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Percent %' caption='Values (OVMC)' datatype='string' name='[Values (copy)_5064649690921578496]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percent&quot;'>
              <calculation class='tableau' formula='&quot;Percent&quot;' />
              <aliases>
                <alias key='&quot;Absolute&quot;' value='Absolute €‎' />
                <alias key='&quot;Percent&quot;' value='Percent %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q3gpzm033u57b1aztpav01b7mtd'>
