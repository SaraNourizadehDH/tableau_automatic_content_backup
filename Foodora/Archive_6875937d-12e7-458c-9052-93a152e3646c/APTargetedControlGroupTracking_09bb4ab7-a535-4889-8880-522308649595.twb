      <group caption='APAC User Filter' name='[APAC User Filter]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[global_entity_id]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[global_entity_id]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_marketing_developer&apos;)' function='filter'>
              <groupfilter function='except'>
                <groupfilter function='level-members' level='[global_entity_id]' />
                <groupfilter function='member' level='[global_entity_id]' member='%null%' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_marketing_FP_BD&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[global_entity_id]' member='&quot;APAC&quot;' />
                <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_BD&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_marketing_FP_HK&apos;)' function='filter'>
