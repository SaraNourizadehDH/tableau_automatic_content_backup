      <aliases enabled='yes' />
      <column caption='Addressable Grouping Lvl 1' datatype='string' name='[Calculation_4350266176366985217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([addressable_cg] = &quot;Addressable&quot;) THEN [cg_type]&#10;ELSE &quot;&quot; END' />
      </column>
      <column caption='Addressable Grouping Lvl 2' datatype='string' name='[Calculation_4350266176369909763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4350266176366985217] = &quot;&quot;&#10;THEN &quot;&quot;&#10;ELSE [incentive_cost_attribution_grouped_2]&#10;END' />
      </column>
      <column caption='cg_incentive_cost_mktg_eur' datatype='real' name='[Calculation_5103845069387485185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4350266176366985217] = &quot;Has CG&quot; THEN [incentive_cost_mktg_eur] END' />
      </column>
      <column caption='% CG/Channel spend' datatype='real' name='[Calculation_5103845069387866115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cg_addressable_incentive_cost_mktg_eur])/SUM([incentive_cost_mktg_eur])' />
      </column>
      <column caption='Values (CG) Toggle' datatype='string' name='[Calculation_5196942925786824720]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Percent&quot; THEN STR(ROUND([Calculation_5775444368489091073]*100, 1)) + &apos;%&apos;&#10;WHEN &quot;Absolute&quot; THEN REGEXP_REPLACE(STR(ROUND(SUM([cg_addressable_incentive_cost_mktg_eur]), 0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;END' />
      </column>
      <column caption='is_APAC' datatype='boolean' name='[Calculation_5196942925788545041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country] = &quot;APAC&quot; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='% cg addressable spend' datatype='real' name='[Calculation_5775444368489091073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cg_addressable_incentive_cost_mktg_eur])/SUM([incentive_cost_mktg_eur])' />
      </column>
