      <column caption='OKR Value' datatype='real' name='[Calculation_442830560396390400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([numerator]), SUM([value]))/IFNULL(SUM([denominator]),1)' />
      </column>
      <column caption='Latest Value' datatype='real' name='[Calculation_442830560423653391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN SUM([numerator])/SUM([denominator]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last 2 Value' datatype='real' name='[Calculation_442830560423804944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0&#10;THEN&#10;LOOKUP(SUM([numerator]) / SUM([denominator]),-1)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='D' datatype='real' name='[Calculation_442830560424099857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(([Calculation_442830560423804944]-[Calculation_442830560423653391])*100, NULL)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delta' datatype='real' name='[Delta (copy)_442830560476561440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([value]) - [Last 2 Value (copy)_442830560447160345])'>
          <table-calc ordering-type='Rows' />
