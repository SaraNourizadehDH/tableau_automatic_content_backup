      <column caption='Date' datatype='string' name='[Calculation_193514105076097024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [granularity]&#10; when &apos;Daily&apos; then [Week (copy)_193514105076957187]&#10; when &apos;Weekly&apos; then [Month (copy)_193514105076826114]&#10; when &apos;Monthly&apos; then [Report Date (copy)_193514105076338689]&#10;end' />
