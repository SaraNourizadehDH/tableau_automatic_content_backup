              <calculation class='tableau' formula='IF [kpi_name] = &apos;# of opportunities won&apos; THEN &apos;Quantity&apos;&#10;ELSEIF CONTAINS([kpi_name], &apos;Success&apos;) THEN &apos;Success rate&apos;&#10;ELSEIF STARTSWITH([kpi_name], &apos;#&apos;) THEN &apos;SLA&apos;&#10;ELSE &apos;Speed&apos;&#10;END' />
