      <aliases enabled='yes' />
      <column caption='Calculation1' datatype='real' name='[Calculation_1532138735687352322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [kpi_reference]=&apos;2. Time (Total)&apos; &#10;OR [kpi_reference]=&apos;3. Time (Successful)&apos; &#10;OR  [kpi_reference]=&apos;4. Time (Failed)&apos; &#10;OR  [kpi_reference]=&apos;1. Time since 1st QC&apos;&#10;OR [kpi_reference]=&apos;Onboarding time - all success opps&apos;&#10;THEN [kpi_1]/[kpi_2]&#10;ELSE [kpi_1]&#10;END' />
      </column>
      <column caption='Time Dimension Filter mp' datatype='string' name='[Calculation_2802083394171088901]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[time_dimension]=[Parameters].[Parameter 1] THEN [time_dimension]&#10;ELSE NULL END' />
      </column>
      <column caption='Time Dimension Filter ' datatype='string' name='[Calculation_2802083394171441158]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[time_dimension]=[Parameters].[Parameter 1] THEN [time_dimension]&#10;ELSE NULL END' />
      </column>
      <column caption='Category' datatype='string' name='[Calculation_6854619374870503424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_name] = &apos;# of opportunities won&apos; THEN &apos;Quantity&apos;&#10;ELSEIF CONTAINS([kpi_name], &apos;Success&apos;) THEN &apos;Success rate&apos;&#10;ELSEIF STARTSWITH([kpi_name], &apos;#&apos;) THEN &apos;SLA&apos;&#10;ELSE &apos;Speed&apos;&#10;END' />
      </column>
      <column caption='colortest' datatype='string' name='[Calculation_6854619374871855105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_name] = &apos;# of Menu Processing Cases &gt; 3 days&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# of Menu Processing Cases &gt; 3 days&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;# of Onboarding Cases &gt; 7 days&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# of Onboarding Cases &gt; 7 days&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;# of Onboarding Fail Cases&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# of Onboarding Fail Cases&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;# of Opportunities with Onboarding TAT &gt; 7 days&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# of Opportunities with Onboarding TAT &gt; 7 days&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;# of opportunities won&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# of opportunities won&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;# of Photo Listing Cases &gt; 3 days&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# of Photo Listing Cases &gt; 3 days&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;# of Quality Check Cases &gt; 1 day&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# of Quality Check Cases &gt; 1 day&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;# Open Opportunities with Onboarding Case Fail &gt; 7 days ago&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;# Open Opportunities with Onboarding Case Fail &gt; 7 days ago&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Average total onboarding time&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Average total onboarding time&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Dish Level Photo Success rate&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Dish Level Photo Success rate&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Dish Level Photo Time&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Dish Level Photo Time&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Menu Processing Success rate&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Menu Processing Success rate&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Menu Processing Time&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Menu Processing Time&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Onboarding Success rate&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Onboarding Success rate&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Onboarding Time&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Onboarding Time&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Photo Listing Success rate&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Photo Listing Success rate&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Photo Listing Time&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Photo Listing Time&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Quality Check Success rate&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Quality Check Success rate&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Red&apos;&#10;&#10;ELSEIF [kpi_name] = &apos;Quality Check Time&apos; AND [WoW_change_percent] &lt; 0 THEN &apos;Green&apos;&#10;ELSEIF [kpi_name] = &apos;Quality Check Time&apos; AND [WoW_change_percent] &gt; 0 THEN &apos;Red&apos;&#10;&#10;ELSE &apos;Neutral&apos;&#10;END' />
      </column>
      <column caption='Level' datatype='string' name='[Calculation_6863063625573437442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [kpi_name]=&apos;Average total onboarding time&apos; &#10;OR [kpi_name]=&apos;# Open Opportunities with Onboarding Case Fail &gt; 7 days ago&apos;&#10;OR [kpi_name]=&apos;# of Opportunities with Onboarding TAT &gt; 7 days&apos;&#10;OR [kpi_name]=&apos;# of opportunities won&apos; THEN &apos;Opportunity Level&apos; ELSE &apos;Case Level&apos; END' />
      </column>
      <column caption='SSU/Non-SSU filter' datatype='string' name='[Calculation_7111887506106925058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [lead_source]=[Parameters].[Parameter 2] THEN [lead_source]&#10;ELSE NULL END' />
      </column>
      <column caption='time' datatype='string' name='[Calculation_7509330166899834880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_dimension] = &apos;weekly&apos; THEN STR(WEEK([report_time])) &#10;ELSEIF [time_dimension] = &apos;monthly&apos; THEN DATENAME(&apos;month&apos;, [report_time]) &#10;ELSE NULL &#10;END' />
      </column>
      <column caption='SSU/Non-SSU filter mp' datatype='string' name='[Calculation_7918735526873223178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[lead_source]=[Parameters].[Parameter 2] THEN [lead_source]&#10;ELSE NULL END' />
      </column>
      <column caption='time_mp' datatype='string' name='[Calculation_85779500145725443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_dimension] = &apos;weekly&apos; THEN STR(WEEK([report_time])) &#10;ELSEIF [time_dimension]  = &apos;monthly&apos; THEN DATENAME(&apos;month&apos;, [report_time]) &#10;ELSE NULL &#10;END' />
      </column>
      <column caption='final KPI' datatype='real' name='[Calculation_85779500146417668]' role='measure' type='quantitative'>
