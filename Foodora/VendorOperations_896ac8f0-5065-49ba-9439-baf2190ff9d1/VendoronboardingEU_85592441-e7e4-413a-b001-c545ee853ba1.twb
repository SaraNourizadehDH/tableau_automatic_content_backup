          <datasource-dependencies datasource='federated.0rcp15s1ymq4qs1ctgu251lluj4d'>
            <column caption='Calculation1' datatype='real' name='[Calculation_1532138735687352322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [kpi_reference]=&apos;2. Time (Total)&apos; &#10;OR [kpi_reference]=&apos;3. Time (Successful)&apos; &#10;OR  [kpi_reference]=&apos;4. Time (Failed)&apos; &#10;OR  [kpi_reference]=&apos;1. Time since 1st QC&apos;&#10;OR [kpi_reference]=&apos;Onboarding time - all success opps&apos;&#10;THEN [kpi_1]/[kpi_2]&#10;ELSE [kpi_1]&#10;END' />
            </column>
            <column caption='Time Dimension Filter ' datatype='string' name='[Calculation_2802083394171441158]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[time_dimension]=[Parameters].[Parameter 1] THEN [time_dimension]&#10;ELSE NULL END' />
            </column>
            <column caption='SSU/Non-SSU filter' datatype='string' name='[Calculation_7111887506106925058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lead_source]=[Parameters].[Parameter 2] THEN [lead_source]&#10;ELSE NULL END' />
            </column>
            <column caption='time' datatype='string' name='[Calculation_7509330166899834880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [time_dimension] = &apos;weekly&apos; THEN STR(WEEK([report_time])) &#10;ELSEIF [time_dimension] = &apos;monthly&apos; THEN DATENAME(&apos;month&apos;, [report_time]) &#10;ELSE NULL &#10;END' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Kpi 1' datatype='real' name='[kpi_1]' role='measure' type='quantitative' />
