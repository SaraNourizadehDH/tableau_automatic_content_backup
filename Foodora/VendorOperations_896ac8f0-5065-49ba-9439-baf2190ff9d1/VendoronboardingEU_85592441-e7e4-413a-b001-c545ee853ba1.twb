        <zone forceUpdate='true' h='18625' id='3' type-v2='text' w='96500' x='1700' y='875'>
          <formatted-text>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontsize='12'>Dear Team,</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontsize='12'>We hope this message finds you well. Below are the key highlights and performance metrics for </run>
            <run bold='true' fontsize='12'>non-SSU vendor onboarding</run>
            <run fontsize='12'> over the last 7 days. This report offers a comprehensive overview of onboarding efficiency, case quality, and SLA compliance during the past week.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone h='59250' id='5' name='SE - weekly' w='97800' x='1300' y='22125' />
        <zone forceUpdate='true' h='18625' id='11' type-v2='text' w='96500' x='2100' y='79625'>
          <formatted-text>
            <run fontsize='12'>Please note that the </run>
            <run bold='true' fontsize='12'>total onboarding time</run>
            <run fontsize='12'> is not a sum of the case-level speed KPIs presented here, as opportunities closed last week may have associated cases that were closed in prior weeks. To see the onboarding time breakdown by stages, please refer to the </run>
            <run bold='true' fontsize='12'>&lt;Overview&gt;</run>
            <run fontsize='12'> sheet.</run>
          </formatted-text>
        </zone>
      </zones>
