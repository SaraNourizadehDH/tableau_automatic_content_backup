            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0rcp15s1ymq4qs1ctgu251lluj4d].[time_dimension]' caption='Time Dimension Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;weekly&quot;'>
              <calculation class='tableau' formula='&quot;weekly&quot;' />
