      <aliases enabled='yes' />
      <column caption='Fixed Open Hours' datatype='real' name='[Calculation_269371603214942211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED&#10;[global_entity_id],&#10;[report_date]:&#10;SUM([open_hours_day])&#10;}' />
      </column>
      <column caption='Offline Rate' datatype='real' name='[Calculation_269371603215740932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unavailable_hours])/SUM([Calculation_269371603214942211])' />
      </column>
      <column caption='Date_Filter' datatype='string' name='[Calculation_269371603240624134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;day&quot; THEN STR([report_date])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN [Calculation_456271002456002578]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; THEN [Calculation_456271002455613457]&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
