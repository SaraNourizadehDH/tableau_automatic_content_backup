      <aliases enabled='yes' />
      <column caption='fixed gross' datatype='integer' name='[Calculation_269371603196289025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED &#10;[country_name],&#10;[created_date_local],&#10;[vertical_type]&#10;: &#10;&#10;SUM([total_gross_orders_daily])}' />
      </column>
      <column caption='fail rate' datatype='real' default-format='p0.00%' name='[Calculation_269371603204890626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_failed_orders_daily])/SUM([Calculation_269371603196289025])' />
      </column>
      <column caption='Date_Filter' datatype='string' name='[Calculation_269371603240624134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;day&quot; THEN STR([created_date_local])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN [Calculation_456271002456002578]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; THEN [Calculation_456271002455613457]&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([created_date_local]) &lt; 10 then str(YEAR([created_date_local])) + &quot;-0&quot; + str(month([created_date_local]))&#13;&#10;ELSE str(YEAR([created_date_local])) + &quot;-&quot; + str(month([created_date_local]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([created_date_local]) &lt; 10 then str(ISOYEAR([created_date_local])) + &quot;-W0&quot; + str(ISOWEEK([created_date_local]))&#13;&#10;ELSE str(ISOYEAR([created_date_local])) + &quot;-W&quot; + str(ISOWEEK([created_date_local]))&#13;&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_56A94DEA911E45B283ECFFE58E355D32]' role='measure' type='quantitative' />
