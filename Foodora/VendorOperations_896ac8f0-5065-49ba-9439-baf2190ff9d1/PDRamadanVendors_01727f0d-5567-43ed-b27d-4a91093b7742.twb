      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_56A94DEA911E45B283ECFFE58E355D32'>
            <properties context=''>
              <relation connection='bigquery.0ttirzz1s2uwna15rklnr1ajqgid' name='Custom SQL Query' type='text'>WITH gross_orders_base AS (
    SELECT  
      DATE(placed_at_local) AS created_date_local,
      DATE(DATE_TRUNC(placed_at_local, WEEK(MONDAY)))AS report_week,
      DATE(DATE_TRUNC(placed_at_local, MONTH)) AS report_month,
      name AS country_name,
      vertical_type,   
      COUNT(DISTINCT order_uid) total_gross_orders_daily,
      -- COUNT(DISTINCT order_uid) OVER (PARTITION BY vertical_type, shared_countries.name, DATE_TRUNC(placed_at_local, WEEK(MONDAY))) AS total_gross_orders_weekly,
      -- COUNT(DISTINCT order_uid) OVER (PARTITION BY vertical_type, shared_countries.name, DATE_TRUNC(placed_at_local, MONTH)) AS total_gross_orders_monthly,
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
    INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
      ON orders.global_entity_id = shared_countries.global_entity_id
    WHERE DATE(placed_at_local) &gt;&gt;= &quot;2025-01-01&quot;
      AND partition_date_local &gt;&gt;= &quot;2025-01-01&quot;
      AND order_status != &quot;PENDING_ORDER_FAILED&quot;
      AND vertical_type IN (&quot;home_based_kitchen&quot;,&quot;restaurants&quot;, &quot;caterers&quot;)
      AND orders.global_entity_id IN (&quot;FP_MY&quot;, &quot;FP_BD&quot;, &quot;FP_PK&quot;, &quot;FP_SG&quot;, &quot;YS_TR&quot;)
    GROUP BY 1, 2, 3,4,5 -- Ensure a single row per grou
)

, gross_orders AS (
  SELECT 
    created_date_local,
    report_week,
    report_month,
    country_name,
    vertical_type,
    total_gross_orders_daily,
    SUM(total_gross_orders_daily) OVER (PARTITION BY report_week, country_name, vertical_type) AS total_gross_orders_weekly,
    SUM(total_gross_orders_daily) OVER (PARTITION BY report_month, country_name, vertical_type) AS total_gross_orders_monthly
  FROM gross_orders_base
)

, fail_orders_base AS (
  SELECT
    DATE(placed_at_local) AS created_date_local,
    DATE(DATE_TRUNC(placed_at_local, WEEK)) AS report_week,
    DATE(DATE_TRUNC(placed_at_local, MONTH)) AS report_month,
    name AS country_name,
    failure_owner,
    failure_reason,
    vertical_type,
    COUNT(DISTINCT IF(is_failed, order_uid, NULL)) AS total_failed_orders_daily
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
  WHERE DATE(placed_at_local) &gt;&gt;= &quot;2025-01-01&quot;
    AND partition_date_local &gt;&gt;= &quot;2025-01-01&quot;
    AND order_status != &quot;PENDING_ORDER_FAILED&quot;
    AND vertical_type IN (&quot;home_based_kitchen&quot;,&quot;restaurants&quot;, &quot;caterers&quot;)
    AND orders.global_entity_id IN (&quot;FP_MY&quot;, &quot;FP_BD&quot;, &quot;FP_PK&quot;, &quot;FP_SG&quot;, &quot;YS_TR&quot;)
  GROUP BY 1, 2, 3, 4, 5, 6, 7
)

, fail_orders AS (
  SELECT 
    created_date_local,
    report_week,
    report_month,
    country_name,
    failure_owner,
    failure_reason,
    vertical_type,
    total_failed_orders_daily,
    SUM(total_failed_orders_daily) OVER (PARTITION BY report_week, country_name, vertical_type, failure_owner, failure_reason) AS total_failed_orders_weekly,
    SUM(total_failed_orders_daily) OVER (PARTITION BY report_month, country_name, vertical_type, failure_owner, failure_reason) AS total_failed_orders_monthly
  FROM fail_orders_base
  GROUP BY ALL
)

SELECT 
    g.created_date_local,
    -- g.report_week,
    -- g.report_month,
    g.country_name,
    g.vertical_type,
    NULL AS failure_owner,
    NULL AS failure_reason,
    NULL AS total_failed_orders_daily,
    g.total_gross_orders_daily,
    -- total_failed_orders_daily/total_gross_orders_daily AS fail_rate_daily,
    -- f.total_failed_orders_weekly,
    -- g.total_gross_orders_weekly,
    -- total_failed_orders_weekly/total_gross_orders_weekly AS fail_rate_weekly,
    -- f.total_failed_orders_monthly,
    -- g.total_gross_orders_monthly,
    -- total_failed_orders_monthly/total_gross_orders_monthly AS fail_rate_monthly
FROM gross_orders g 

UNION ALL

SELECT 
    f.created_date_local,
    -- f.report_week,
    -- f.report_month,
    f.country_name,
    f.vertical_type,
    failure_owner,
    failure_reason,
    total_failed_orders_daily,
    NULL AS total_gross_orders_daily,
FROM fail_orders f
-- ON f.created_date_local = g.created_date_local
-- AND f.country_name = g.country_name
-- AND f.vertical_type = g.vertical_type
order by 1,2</relation>
