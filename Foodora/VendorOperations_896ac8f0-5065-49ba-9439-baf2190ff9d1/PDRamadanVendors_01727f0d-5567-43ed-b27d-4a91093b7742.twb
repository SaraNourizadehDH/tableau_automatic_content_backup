            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vjxl1d14s2u6g13qbuud0az3f6w'>
            <column caption='fixed gross' datatype='integer' name='[Calculation_269371603196289025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED &#10;[country_name],&#10;[created_date_local],&#10;[vertical_type]&#10;: &#10;&#10;SUM([total_gross_orders_daily])}' />
            </column>
            <column caption='fail rate' datatype='real' default-format='p0.00%' name='[Calculation_269371603204890626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_failed_orders_daily])/SUM([Calculation_269371603196289025])' />
            </column>
            <column caption='Date_Filter' datatype='string' name='[Calculation_269371603240624134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;day&quot; THEN STR([created_date_local])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN [Calculation_456271002456002578]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; THEN [Calculation_456271002455613457]&#10;END' />
