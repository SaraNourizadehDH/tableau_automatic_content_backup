      <column caption='Date_Filter' datatype='string' name='[Calculation_269371603240624134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;day&quot; THEN STR([order_date])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN [Calculation_456271002456002578]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; THEN [Calculation_456271002455613457]&#10;END' />
      </column>
      <column caption='Delay Rate' datatype='real' name='[Calculation_305963350880464896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_delay_order_counts_daily])/SUM([delivered_orders])' />
      </column>
      <column caption='SUM([total_delay_order_counts_daily])/SUM([delivered_orders])' datatype='real' name='[Calculation_305963350881361922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_delay_order_counts_daily])/SUM([delivered_orders])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([order_date]) &lt; 10 then str(YEAR([order_date])) + &quot;-0&quot; + str(month([order_date]))&#13;&#10;ELSE str(YEAR([order_date])) + &quot;-&quot; + str(month([order_date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([order_date]) &lt; 10 then str(ISOYEAR([order_date])) + &quot;-W0&quot; + str(ISOWEEK([order_date]))&#13;&#10;ELSE str(ISOYEAR([order_date])) + &quot;-W&quot; + str(ISOWEEK([order_date]))&#13;&#10;END' />
      </column>
