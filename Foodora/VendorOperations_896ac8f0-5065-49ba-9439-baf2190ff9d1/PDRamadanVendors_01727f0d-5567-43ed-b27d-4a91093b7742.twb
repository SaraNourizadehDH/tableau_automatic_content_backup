    , country_name
    , SUM(total_vendors_cnt) AS active_vendors_cnt
    , SUM(adopted_vendors_cnt_mobile_web_only+adopted_vendors_cnt_desktop_web_only+adopted_vendors_cnt_desktop_and_mobile_web+adopted_vendors_cnt_only_app+adopted_vendors_cnt_app_and_web) AS adopted_vendors_cnt
    , SUM(adopted_mobile_web_only_opening_times_vendors_cnt
         +adopted_desktop_web_only_opening_times_vendors_cnt
         +adopted_desktop_and_mobile_web_opening_times_vendors_cnt
         +adopted_only_app_opening_times_vendors_cnt
         +adopted_app_and_web_opening_times_vendors_cnt) AS adopted_vendors_opening_times_cnt
  FROM `fulfillment-dwh-production.curated_data_shared_vendor.vp_plugin_adoption_agg_rl`
  WHERE TRUE
    AND fielddate &gt;&gt;= &apos;2025-01-01&apos;
    and country_name IN (&quot;Malaysia&quot;, &quot;Singapore&quot;, &quot;Pakistan&quot;, &quot;Bangladesh&quot;, &quot;Turkey&quot;)
    AND NOT COALESCE(is_zombie, FALSE) -- Filter on at least 1 order in that period
    AND vertical_type = &apos;restaurants&apos; -- If needed to pick specific verticals only (restaurants is a default reporting view)
    AND period_granularity = &apos;day&apos; -- ENUM: week/month/quarter 
    AND adoption_type = &apos;lb&apos; -- &quot;High-Band adoption (default reporting view)&quot;
    AND user_type = &apos;ALL&apos; -- ENUM: ALL/Internal/External, all by default but there&apos;s an option to exclude impersonation and DH-related activity
  GROUP BY ALL
  ORDER BY 1 desc</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
