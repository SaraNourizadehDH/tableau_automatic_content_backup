      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_73B4EF1769204BF5871D4952234DCCFB'>
            <properties context=''>
              <relation connection='bigquery.0es7oqz19l4jn41h7nvk81ory984' name='Custom SQL Query' type='text'>WITH vendor_offline AS (
  SELECT
  vendor_offline.global_entity_id,
  countries.name AS country_name,
  vendor_offline.report_date,
  -- vendor_offline.vendor_code,
  -- vendor_offline.pd_vendor_uuid,
  CASE WHEN availabilities.reason IN (&quot;UNREACHABLE&quot;, &quot;CHECK_IN_FAILED&quot;, &quot;CHECK_IN_REQUIRED&quot;, &quot;CLOSED&quot;, &quot;HOLIDAY_SPECIAL_DAY&quot;, &quot;ORDER_FAILURE&quot;, &quot;REFURBISHMENT&quot;, &quot;TOO_BUSY_KITCHEN&quot;) THEN &quot;Vendor&quot;
       WHEN availabilities.reason IN (&quot;COURIER_DELAYED_AT_PICKUP&quot;, &quot;RESTRICTED_VISIBILITY&quot;, &quot;TECHNICAL_PROBLEM&quot;, &quot;TOO_BUSY_NO_DRIVERS&quot;, &quot;UPDATES_IN_MENU&quot;) THEN &quot;foodpanda&quot;
       ELSE &quot;Other&quot; END AS unavailable_reason_by,
  availabilities.reason AS unavailable_reason,
  NULL AS open_seconds_day,
  SUM(availabilities.unavailable_seconds) AS unavailable_seconds
FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_offline` AS vendor_offline
LEFT JOIN vendor_offline.schedules
LEFT JOIN vendor_offline.availabilities
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
    ON countries.global_entity_id = vendor_offline.global_entity_id
WHERE vendor_offline.report_date &gt;&gt;= &quot;2025-01-01&quot;
  AND vendor_offline.global_entity_id IN (&quot;FP_MY&quot;, &quot;FP_BD&quot;, &quot;FP_PK&quot;, &quot;FP_SG&quot;, &quot;YS_TR&quot;)
  AND vendor_offline.is_active
  AND NOT vendor_offline.is_private
  AND NOT vendor_offline.is_test
  --AND reason IS NOT NULL
GROUP BY 1, 2, 3, 4, 5
)

,vendor_schedule AS (
  SELECT
    vendor_offline.global_entity_id,
    countries.name AS country_name,
    vendor_offline.report_date,
    &quot;NULL&quot; AS unavailable_reason_by,
    &quot;NULL&quot; AS unavailable_reason,
    -- DATE_TRUNC(vendor_offline.report_date, MONTH) AS report_month,
    -- DATE_TRUNC(vendor_offline.report_date, WEEK(MONDAY)) AS report_week,
    -- vendor_offline.vendor_code,
    -- vendor_offline.pd_vendor_uuid,
    SUM(COALESCE(vendor_offline.total_open_seconds, 0)) AS open_seconds_day,
    NULL AS unavailable_seconds

  FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_offline` AS vendor_offline
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
    ON countries.global_entity_id = vendor_offline.global_entity_id
  WHERE vendor_offline.report_date &gt;&gt;= &quot;2025-01-01&quot;
  AND vendor_offline.is_active
  AND vendor_offline.global_entity_id IN (&quot;FP_MY&quot;, &quot;FP_BD&quot;, &quot;FP_PK&quot;, &quot;FP_SG&quot;, &quot;YS_TR&quot;)
  AND NOT vendor_offline.is_private
  AND NOT vendor_offline.is_test
  GROUP BY 1, 2,3,4,5,7
)


SELECT 
    report_date,
    country_name,
    global_entity_id,
    unavailable_reason_by,
    unavailable_reason,
    open_seconds_day / 3600 AS open_hours_day,
    NULL AS unavailable_hours
FROM vendor_schedule

UNION ALL

SELECT 
    report_date,
    country_name,
    global_entity_id,
    unavailable_reason_by,
    unavailable_reason,
    NULL open_seconds_day,
    unavailable_seconds / 3600 AS unavailable_hours
FROM vendor_offline

