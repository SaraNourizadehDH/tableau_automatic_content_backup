        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0hvfck50vzzqax1926stg189t5ss' name='Custom SQL Query' type='text'>-- WITH non_stack_vendor_delay_orders AS (
  SELECT 
    DATE(order_placed_at) AS order_date,
    vendor.vertical_type,
    cont.name AS country_name,
    -- log_orders.stacked_delivery_count,
    orders.order_status,
    IF(log_orders.stacked_delivery_count &gt;&gt; 1, TRUE, FALSE) AS is_stacked,
    SUM(timings.vendor_late)/60 AS vendor_delay_minutes,
    COUNT(DISTINCT(IF(timings.vendor_late/60 &gt;&gt; 10, platform_order_code, NULL))) AS total_delay_order_counts_daily,
    COUNT(DISTINCT platform_order_code) AS delivered_orders
  FROM `fulfillment-dwh-production.curated_data_shared.orders` orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` cont
    ON orders.entity.id = cont.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_logistics` log_orders
    ON log_orders.order_code = orders.platform_order_code
  WHERe 
        log_orders.created_date_local &gt;&gt;= &quot;2025-01-01&quot;
    AND DATE(order_placed_at) &gt;&gt;= &quot;2025-01-01&quot;
    AND orders.entity.id IN (&quot;FP_MY&quot;, &quot;FP_BD&quot;, &quot;FP_PK&quot;, &quot;FP_SG&quot;, &quot;YS_TR&quot;)
    -- AND vendor.vertical_type IN (&quot;home_based_kitchen&quot;,&quot;restaurants&quot;, &quot;caterers&quot;)
    -- AND log_orders.stacked_delivery_count &gt;&gt; 1
    AND orders.order_status IN (&quot;cancelled&quot;, &quot;completed&quot;)
-- AND platform_order_code = &quot;o0id-2508-2uhh&quot;
    GROUP BY 1,2,3,4,5
-- )

