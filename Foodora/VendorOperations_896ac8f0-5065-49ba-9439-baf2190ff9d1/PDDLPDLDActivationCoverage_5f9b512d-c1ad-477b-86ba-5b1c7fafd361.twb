        <calculation class='tableau' formula='CASE [Parameters].[Overview Parameter (copy)]&#10;    WHEN &apos;100%&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN (1 - [Calculation_6379067418238320640]) * 100&#10;            WHEN &apos;DLP&apos; THEN (1 - [1. DLD D0 (copy) (copy) (copy)_6379067418238468099]) * 100&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN SUM(NULL)&#10;        END&#10;&#10;    WHEN &apos;Stacked&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN SUM([active_product_count] - [active_products_w_description_count])&#10;            WHEN &apos;DLP&apos; THEN SUM([active_product_count] - [active_products_w_image_count]) // Active Products W No Images&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN SUM(NULL) // Active Products W No Images&#10;        END&#10;END' />
