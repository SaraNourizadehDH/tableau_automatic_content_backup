          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gmd9kd1xa9ieq14m61l41rettje'>
            <column caption='DLP D0' datatype='real' name='[1. DLD D0 (copy) (copy) (copy)_6379067418238468099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([active_products_w_image_count])/SUM([active_product_count]), 0)' />
            </column>
            <column caption='DLP D0 (Non Stock Image)' datatype='real' name='[4. DLP (copy) (copy) (copy)_6379067418238849032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([active_products_w_image_count]) = 0 THEN 0&#10;ELSE SUM([active_products_w_non_stock_image_count])/SUM([active_products_w_image_count])&#10;END' />
            </column>
            <column caption='Bar 3' datatype='real' name='[Bar 1 (copy)_5738571110452031507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Overview Parameter (copy)]&#10;    WHEN &apos;100%&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN (1 - [Calculation_6379067418238320640]) * 100&#10;            WHEN &apos;DLP&apos; THEN (1 - [1. DLD D0 (copy) (copy) (copy)_6379067418238468099]) * 100&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN SUM(NULL)&#10;        END&#10;&#10;    WHEN &apos;Stacked&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN SUM([active_product_count] - [active_products_w_description_count])&#10;            WHEN &apos;DLP&apos; THEN SUM([active_product_count] - [active_products_w_image_count]) // Active Products W No Images&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN SUM(NULL) // Active Products W No Images&#10;        END&#10;END' />
            </column>
            <column caption='Bar Chart Title' datatype='string' name='[Bar 1 (copy)_5738571110462418968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;    WHEN &apos;DLD&apos; THEN &apos;Products W Description + Products W No Description = Total Products&apos;&#10;    WHEN &apos;DLP&apos; THEN &apos;Products W Non Stock Image + Products W Stock Image + Products W No Image = Total Products&apos;&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN &apos;Products W Non Stock Image + Products W Stock Image = Products W Image&apos;&#10;END' />
            </column>
            <column caption='Bar 1 Title' datatype='string' name='[Bar 1 (copy)_5738571110473965598]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;    WHEN &apos;DLD&apos; THEN &apos;■ Active Products W Description&apos;&#10;    WHEN &apos;DLP&apos; THEN &apos;■ Active Products W Non Stock Image&apos;&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN &apos;■ Active Products W Non Stock Image&apos;&#10;END' />
            </column>
            <column caption='Bar 2' datatype='real' name='[Bar 2 (copy)_5738571110452428821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Overview Parameter (copy)]&#10;    WHEN &apos;100%&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN SUM(NULL)&#10;            WHEN &apos;DLP&apos; THEN (SUM([active_products_w_image_count] - [active_products_w_non_stock_image_count]) / SUM([active_product_count])) * 100&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN (1 - [4. DLP (copy) (copy) (copy)_6379067418238849032]) * 100&#10;        END&#10;&#10;    WHEN &apos;Stacked&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN SUM(NULL)&#10;            WHEN &apos;DLP&apos; THEN SUM([active_products_w_image_count] - [active_products_w_non_stock_image_count]) // Active Products W Stock Images&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN SUM([active_products_w_image_count] - [active_products_w_non_stock_image_count]) // Active Products W Stock Images&#10;        END&#10;END' />
            </column>
            <column caption='Bar 2 Title' datatype='string' name='[Bar 2 (copy)_5738571110463221787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;    WHEN &apos;DLD&apos; THEN &apos;&apos;&#10;    WHEN &apos;DLP&apos; THEN &apos;■ Active Products W Stock Image&apos;&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN &apos;■ Active Products W Stock Image&apos;&#10;END' />
            </column>
            <column caption='Bar 3 Title' datatype='string' name='[Bar 3 (copy)_5738571110474362911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;    WHEN &apos;DLD&apos; THEN &apos;■ Active Products W No Description&apos;&#10;    WHEN &apos;DLP&apos; THEN &apos;■ Active Products W No Image&apos;&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Bar 1' datatype='real' name='[Calculation_5738571110451118098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Overview Parameter (copy)]&#10;    WHEN &apos;100%&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN [Calculation_6379067418238320640] * 100&#10;            WHEN &apos;DLP&apos; THEN SUM([active_products_w_non_stock_image_count]) / SUM([active_product_count]) * 100&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN [4. DLP (copy) (copy) (copy)_6379067418238849032] * 100&#10;        END&#10;&#10;    WHEN &apos;Stacked&apos; THEN &#10;        CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;            WHEN &apos;DLD&apos; THEN SUM([active_products_w_description_count])&#10;            WHEN &apos;DLP&apos; THEN SUM([active_products_w_non_stock_image_count])&#10;            WHEN &apos;DLP (Non Stock Image)&apos; THEN SUM([active_products_w_non_stock_image_count])&#10;        END&#10;END' />
            </column>
            <column caption='DLD D0' datatype='real' name='[Calculation_6379067418238320640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_products_w_description_count])/SUM([active_product_count])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_6379067418247954452]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [report_date]) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [report_date]))&#10;WHEN &apos;iso-week&apos; THEN STR(DATE([Report Month (copy)_6379067418244882448])) + &apos; (W&apos; + STR(DATEPART(&apos;iso-week&apos;, [report_date])) + &apos;)&apos;&#10;WHEN &apos;day&apos; THEN STR(DATE([report_date]))&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [report_date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [report_date]))&#10;END' />
            </column>
            <column caption='Date Level Dynamic Filter' datatype='boolean' name='[Calculation_6379067418248060949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;quarter&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 3&#10;WHEN &apos;month&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 6&#10;WHEN &apos;iso-week&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 10&#10;WHEN &apos;day&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 16&#10;&#10;&#10;END' />
            </column>
            <column caption='Overview Metric Dynamic Title' datatype='string' name='[Metric (copy)_6379067418638114851]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy)_6379067418562687004]&#10;    WHEN &apos;DLP&apos; THEN &apos;DLP Overall&apos;&#10;    WHEN &apos;DLD&apos; THEN &apos;DLD Overall&apos;&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN &apos;DLP Overall (Non Stock Image)&apos;&#10;END' />
            </column>
            <column caption='Report Week' datatype='datetime' name='[Report Month (copy)_6379067418244882448]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;, [report_date])' />
            </column>
