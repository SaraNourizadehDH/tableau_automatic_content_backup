          <datasource-dependencies datasource='Parameters'>
            <column caption='Line Parameter' datatype='string' name='[Line Chart Parameter (copy 2)_5738571110159949831]' param-domain-type='list' role='measure' type='nominal' value='&quot;DLD&quot;'>
              <calculation class='tableau' formula='&quot;DLD&quot;' />
            </column>
            <column alias='Month' caption='Date Level Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gmd9kd1xa9ieq14m61l41rettje'>
            <column caption='DLP D0' datatype='real' name='[1. DLD D0 (copy) (copy) (copy)_6379067418238468099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([active_products_w_image_count])/SUM([active_product_count]), 0)' />
            </column>
            <column caption='DLD D7' datatype='real' name='[1. DLD D0 (copy)_6379067418238455809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_products_w_description_count_d7])/SUM([active_product_count_d7])' />
            </column>
            <column caption='D0  ' datatype='real' name='[1. Line Chart D0  (copy)_5738571110160490506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy 2)_5738571110159949831]&#10;    WHEN &apos;DLD&apos; THEN MAX(NULL)&#10;    WHEN &apos;DLP&apos; THEN MAX(NULL)&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN MAX(NULL)&#10;    WHEN &apos;DLP + DLP (Non Stock Image)&apos; THEN [4. DLP (copy) (copy) (copy)_6379067418238849032]&#10;    &#10;&#10;END' />
            </column>
            <column caption='D7  ' datatype='real' name='[2. Line Chart D7 (copy)_5738571110160498699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy 2)_5738571110159949831]&#10;    WHEN &apos;DLD&apos; THEN MAX(NULL)&#10;    WHEN &apos;DLP&apos; THEN MAX(NULL)&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN MAX(NULL)&#10;    WHEN &apos;DLP + DLP (Non Stock Image)&apos; THEN [7. DLP D0 (Stock Image) (copy)_6379067418239184905]&#10;END' />
            </column>
            <column caption='DLP D0 (Non Stock Image)' datatype='real' name='[4. DLP (copy) (copy) (copy)_6379067418238849032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([active_products_w_image_count]) = 0 THEN 0&#10;ELSE SUM([active_products_w_non_stock_image_count])/SUM([active_products_w_image_count])&#10;END' />
            </column>
            <column caption='DLP D7' datatype='real' name='[4. DLP (copy)_6379067418238828550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_products_w_image_count_d7])/SUM([active_product_count_d7])' />
            </column>
            <column caption='DLP D7 (Non Stock Image)' datatype='real' name='[7. DLP D0 (Stock Image) (copy)_6379067418239184905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([active_products_w_image_count_d7]) = 0 THEN 0&#10;ELSE SUM([active_products_w_non_stock_image_count_d7])/SUM([active_products_w_image_count_d7])&#10;END' />
            </column>
            <column caption='DLD D0' datatype='real' name='[Calculation_6379067418238320640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_products_w_description_count])/SUM([active_product_count])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_6379067418247954452]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [report_date]) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [report_date]))&#10;WHEN &apos;iso-week&apos; THEN STR(DATE([Report Month (copy)_6379067418244882448])) + &apos; (W&apos; + STR(DATEPART(&apos;iso-week&apos;, [report_date])) + &apos;)&apos;&#10;WHEN &apos;day&apos; THEN STR(DATE([report_date]))&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [report_date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [report_date]))&#10;END' />
            </column>
            <column caption='Date Level Dynamic Filter' datatype='boolean' name='[Calculation_6379067418248060949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;quarter&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 3&#10;WHEN &apos;month&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 6&#10;WHEN &apos;iso-week&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 10&#10;WHEN &apos;day&apos; THEN DATEDIFF([Parameters].[Parameter 1], DATETRUNC([Parameters].[Parameter 1], [report_date]), TODAY()) &lt;= 16&#10;&#10;&#10;END' />
            </column>
            <column caption='Pandora' datatype='string' name='[Calculation_6379067418603675681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Pandora&apos;' />
            </column>
            <column caption='Metric' datatype='string' name='[Calculation_6379067418632445986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy 2)_5738571110159949831]&#10;    WHEN &apos;DLP&apos; THEN &apos;DLP&apos;&#10;    WHEN &apos;DLD&apos; THEN &apos;DLD&apos;&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN &apos;DLP (Non Stock Image)&apos;&#10;    WHEN &apos;DLP + DLP (Non Stock Image)&apos; THEN &apos;DLP + DLP (Non Stock Image)&apos;&#10;END' />
            </column>
            <column caption='D0 ' datatype='real' name='[Line Chart D0 (copy)_5738571110160076808]' role='measure' type='quantitative'>
