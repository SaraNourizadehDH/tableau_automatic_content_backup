            </column>
            <column caption='D7 ' datatype='real' name='[Line Chart D7 (copy)_5738571110160334857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Line Chart Parameter (copy 2)_5738571110159949831]&#10;    WHEN &apos;DLD&apos; THEN [1. DLD D0 (copy)_6379067418238455809]&#10;    WHEN &apos;DLP&apos; THEN [4. DLP (copy)_6379067418238828550]&#10;    WHEN &apos;DLP (Non Stock Image)&apos; THEN [7. DLP D0 (Stock Image) (copy)_6379067418239184905]&#10;    WHEN &apos;DLP + DLP (Non Stock Image)&apos; THEN [4. DLP (copy)_6379067418238828550]&#10;END' />
