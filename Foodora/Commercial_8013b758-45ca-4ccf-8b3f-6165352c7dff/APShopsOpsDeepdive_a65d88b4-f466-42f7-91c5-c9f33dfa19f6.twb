      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98400' id='9' param='horz' type-v2='layout-flow' w='98788' x='606' y='800'>
            <zone h='98400' id='7' type-v2='layout-basic' w='98788' x='606' y='800'>
              <zone forceUpdate='true' h='5000' id='3' type-v2='text' w='98788' x='606' y='800'>
                <formatted-text>
                  <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='15'>APAC SHOPS PARTIAL ORDER PNL IMPACT</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#e80078' />
                </zone-style>
              </zone>
              <zone h='93400' id='5' param='vert' type-v2='layout-flow' w='98788' x='606' y='5800'>
                <zone fixed-size='79' h='7900' id='11' is-fixed='true' param='horz' type-v2='layout-flow' w='98788' x='606' y='5800'>
                  <zone fixed-size='652' forceUpdate='true' h='7900' id='13' is-fixed='true' type-v2='text' w='49394' x='606' y='5800'>
                    <formatted-text>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>Data only accounts for </run>
                      <run bold='true' fontalignment='1' fontcolor='#c9005d' fontname='Tableau Semibold' fontsize='8'>Own Delivery</run>
                      <run bold='true' fontalignment='1' fontcolor='#c9005d' fontsize='8'>Æ </run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>valid orders.</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontname='Tableau Semibold' fontsize='8'>Delivered Partial</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'> and </run>
                      <run bold='true' fontalignment='1' fontcolor='#c9005d' fontname='Tableau Semibold' fontsize='8'>Ordered Partial</run>
                      <run bold='true' fontalignment='1' fontcolor='#c9005d' fontsize='8'>Æ </run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>numbers may match for certain metrics</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>(e.g. Valid Orders) as they are calculated based on the condition that the order is partial.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='padding' value='4' />
                      <format attr='background-color' value='#fcf5f9b4' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='652' forceUpdate='true' h='7900' id='24' is-fixed='true' type-v2='text' w='49394' x='50000' y='5800'>
                    <formatted-text>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>For metrics that depend on quantity, </run>
                      <run fontalignment='1' fontcolor='#c9005d' fontname='Tableau Semibold' fontsize='8'>Delivered Partial</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'> and </run>
                      <run fontalignment='1' fontcolor='#c9005d' fontname='Tableau Semibold' fontsize='8'>Ordered Partial</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'> will differ.</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>For instance, GFV per Order for </run>
                      <run fontalignment='1' fontcolor='#c9005d' fontname='Tableau Semibold' fontsize='8'>Delivered Partial</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'> the calculation used is Delivered Quantity * Item Cost</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>whereas for </run>
                      <run fontalignment='1' fontcolor='#c9005d' fontname='Tableau Semibold' fontsize='8'>Ordered Partial </run>
                      <run fontalignment='1' fontcolor='#c9005d' fontsize='8'>the calculation used is Ordered Quantity * Item Cost.</run>
                      <run fontalignment='1'>Æ&#10;</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='background-color' value='#fcf5f9b4' />
                    </zone-style>
                  </zone>
                </zone>
