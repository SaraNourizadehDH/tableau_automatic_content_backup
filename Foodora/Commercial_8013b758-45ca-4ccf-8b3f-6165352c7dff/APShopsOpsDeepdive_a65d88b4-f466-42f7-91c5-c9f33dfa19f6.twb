      <aliases enabled='yes' />
      <column caption='GMV (€)' datatype='real' hidden='true' name='[# Valid Orders (copy)_1075445540203745293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    AND ([Calculation_1075445537741946881] = &apos;Not Integrated&apos; OR [Perspective #1 (copy)_1413496969084428289] = &apos;Not Integrated&apos; OR [Persp #2 (copy)_1075445539109261317] = &apos;Not Integrated&apos;) &#10;    THEN [valid_gmv_eur]&#10;&#10;ELSEIF  [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    THEN [integrated_valid_gmv_eur]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;) &#10;    AND ([Calculation_1075445537741946881] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Perspective #1 (copy)_1413496969084428289] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Persp #2 (copy)_1075445539109261317] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;)) &#10;    THEN [valid_gmv_eur]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;)&#10;    THEN [pelican_valid_gmv_eur]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;POS Status&apos;,&#10;                     &apos;Country ▸ POS Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ POS Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ POS Status&apos;,&#10;                     &apos;Vertical ▸ POS Status&apos;)&#10;    AND [is_pos_vendor]&#10;    THEN [pos_valid_gmv_eur]&#10;&#10;ELSE [valid_gmv_eur] END' />
      </column>
      <column caption='# Partial Orders' datatype='integer' hidden='true' name='[# Valid Orders (copy)_1934014590295556096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2724396325245480961]&#10;    AND ([Calculation_1075445537741946881] = &apos;Not Integrated&apos; OR [Perspective #1 (copy)_1413496969084428289] = &apos;Not Integrated&apos; OR [Persp #2 (copy)_1075445539109261317] = &apos;Not Integrated&apos;) &#10;    THEN [num_of_partially_fulfilled_orders]&#10;&#10;ELSEIF [Calculation_2724396325245480961]&#10;THEN [num_of_partially_fulfilled_integrated_orders]&#10;&#10;ELSEIF [Perspective = Integration (copy)_2724396325245755394]&#10;    AND ([Calculation_1075445537741946881] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Perspective #1 (copy)_1413496969084428289] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Persp #2 (copy)_1075445539109261317] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;)) &#10;    THEN [num_of_partially_fulfilled_orders]&#10;&#10;ELSEIF [Perspective = Integration (copy)_2724396325245755394] THEN [num_of_partially_fulfilled_pelican_orders]&#10;&#10;ELSE [num_of_partially_fulfilled_orders] END' />
      </column>
