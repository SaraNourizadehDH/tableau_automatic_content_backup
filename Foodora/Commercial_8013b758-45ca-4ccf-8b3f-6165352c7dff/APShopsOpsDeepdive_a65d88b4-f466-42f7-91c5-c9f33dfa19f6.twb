      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APShopsOpsDeepdive/PartialOrderPNLImpact?rev=' id='PartialOrderPNLImpact' path='/t/Foodora/workbooks/APShopsOpsDeepdive_17452222274930' revision='' site='Foodora' />
      <style />
      <size maxheight='1000' maxwidth='1320' minheight='1000' minwidth='1320' sizing-mode='fixed' />
      <datasources>
        <datasource caption='regional_apac_shops__partial_order_impact_dashboard (pandata_report)' name='federated.1d4k2gv1mkvmtz1960xwb01jo29r' />
