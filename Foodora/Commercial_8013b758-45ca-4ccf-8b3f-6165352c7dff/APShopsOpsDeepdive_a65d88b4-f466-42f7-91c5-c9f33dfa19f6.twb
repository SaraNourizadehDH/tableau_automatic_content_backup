        <calculation class='tableau' formula='(&#10;(SUM(ZN(num_of_core_sku_valid_ordered_quantity)) + SUM(ZN(num_of_core_sku_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_core_sku_valid_sent_quantity)))&#10;)&#10;/&#10;(&#10;(SUM(ZN([num_of_valid_ordered_quantity])) + SUM(ZN([num_of_failed_vendor_product_unavailable_ordered_quantity])))&#10;-&#10;(SUM(ZN([num_of_valid_sent_quantity])))&#10;)' />
      </column>
      <column caption='% Items Not Delivered from New Items' datatype='real' default-format='p0.0%' name='[% Items Not Delivered from Zombie Items (copy)_1137651530959724546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(ZN([num_of_f30d_product_valid_ordered_quantity])) + SUM(ZN(num_of_f30d_product_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_f30d_product_valid_sent_quantity)))&#10;)&#10;/&#10;(&#10;(SUM(ZN([num_of_valid_ordered_quantity])) + SUM(ZN([num_of_failed_vendor_product_unavailable_ordered_quantity])))&#10;-&#10;(SUM(ZN([num_of_valid_sent_quantity])))&#10;)' />
      </column>
      <column caption='% Items Not Delivered from Core SKU (incl. Post Delivery)' datatype='real' default-format='p0.0%' name='[% OOS Quantity (copy)_4709780065210482688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(ZN(num_of_core_sku_valid_ordered_quantity)) + SUM(ZN(num_of_core_sku_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_core_sku_valid_delivered_quantity)))&#10;)&#10;/&#10;(&#10;(SUM(ZN([num_of_valid_ordered_quantity])) + SUM(ZN([num_of_failed_vendor_product_unavailable_ordered_quantity])))&#10;-&#10;(SUM(ZN([num_of_valid_delivered_quantity])))&#10;)' />
      </column>
      <column caption='Core SKU % Items Not Delivered (incl. Post Delivery)' datatype='real' default-format='p0.0%' name='[% OOS Quantity from Core SKU (copy)_8429260783339433984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(ZN(num_of_core_sku_valid_ordered_quantity)) + SUM(ZN(num_of_core_sku_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_core_sku_valid_delivered_quantity)))&#10;)&#10;/&#10;(SUM(ZN(num_of_core_sku_valid_ordered_quantity)) + SUM(ZN(num_of_core_sku_failed_vendor_product_unavailable_ordered_quantity)))' />
      </column>
      <column caption='% Partial Order' datatype='real' default-format='p0.0%' name='[% Partial Order (incl. Post Delivery) (copy)_2159405719835373577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_partially_fulfilled_excl_post_delivery_orders]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='% Found Rate (incl. Post Delivery)' datatype='real' name='[% Partial Order Rate (copy)_6777073038982397958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([num_of_valid_delivered_quantity]))&#10;&#10;/&#10;&#10;SUM(ZN([num_of_valid_ordered_quantity]))' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.16iqxpx1rgqgwo1c4plhq19z6kw5].[pcto:usr:Calculation_4899705331398172672:qk]&quot;' value='% of Total Items Not Delivered: Ordered Quantity' />
