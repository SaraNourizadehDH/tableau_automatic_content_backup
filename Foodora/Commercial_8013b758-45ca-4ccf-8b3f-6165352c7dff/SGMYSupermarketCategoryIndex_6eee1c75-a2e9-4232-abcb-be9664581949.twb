      <table>
        <view>
          <datasources>
            <datasource caption='tableau_test (sgmy_category_score)' name='federated.0z1953f0vxarx013i6mre00z36xn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='switch - chain vendor' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain&quot;'>
              <calculation class='tableau' formula='&quot;Chain&quot;' />
            </column>
            <column caption='switch - cat subcat' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category&quot;'>
              <calculation class='tableau' formula='&quot;Category&quot;' />
            </column>
            <column caption='Top N' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range granularity='5' max='30' min='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z1953f0vxarx013i6mre00z36xn'>
            <column caption='Cal - vendor filter disable' datatype='string' name='[Calculation_1031605790540541953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Vendor&apos; then [vendor_name] else &apos;NA&apos; end' />
            </column>
            <column caption='Cal - cat/subcat for graph' datatype='string' name='[Calculation_1830713316100427776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;Category&apos; THEN [mapped_category]&#13;&#10;    WHEN &apos;Subcategory&apos; THEN [mapped_subcategory]&#13;&#10;    WHEN &apos;Total&apos; THEN NULL  &#13;&#10;END' />
            </column>
            <column caption='Cal - gfv rank' datatype='integer' name='[Calculation_1830713316458491923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Chain&apos; THEN &#13;&#10;        CASE [Parameters].[Parameter 2]&#13;&#10;            WHEN &apos;Category&apos; THEN MAX([cat_gfv_ben_rank])&#13;&#10;            WHEN &apos;Subcategory&apos; THEN MAX([subcat_gfv_ben_rank])&#13;&#10;            WHEN &apos;Total&apos; THEN null&#13;&#10;        END&#13;&#10;    WHEN &apos;Vendor&apos; THEN &#13;&#10;        CASE [Parameters].[Parameter 2]&#13;&#10;            WHEN &apos;Category&apos; THEN MAX([cat_gfv_ben_rank])&#13;&#10;            WHEN &apos;Subcategory&apos; then MAX([subcat_gfv_ben_rank])&#13;&#10;            WHEN &apos;Total&apos; THEN null&#13;&#10;        END&#13;&#10;END' />
            </column>
            <column caption='Cal - top n filter' datatype='boolean' name='[Calculation_1830713316460593172]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1830713316458491923] &lt;= [Parameters].[Parameter 3] then true else false end' />
            </column>
            <column caption='Cal - CV switch FR' datatype='real' name='[Calculation_756041852442611715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Chain&apos; THEN &#13;&#10;        CASE [Parameters].[Parameter 2]&#13;&#10;            WHEN &apos;Category&apos; THEN [chain_cat_found_rate]&#13;&#10;            WHEN &apos;Subcategory&apos; THEN [chain_subcat_found_rate]&#13;&#10;            WHEN &apos;Total&apos; THEN [chain_found_rate]&#13;&#10;        END&#13;&#10;    WHEN &apos;Vendor&apos; THEN &#13;&#10;        CASE [Parameters].[Parameter 2]&#13;&#10;            WHEN &apos;Category&apos; THEN [vendor_cat_found_rate]&#13;&#10;            WHEN &apos;Subcategory&apos; THEN [vendor_subcat_found_rate]&#13;&#10;            WHEN &apos;Total&apos; THEN [vendor_found_rate]&#13;&#10;        END&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_756041852442611715]' derivation='Avg' name='[avg:Calculation_756041852442611715:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[cat_gfv_ben_rank]' role='measure' type='quantitative' />
