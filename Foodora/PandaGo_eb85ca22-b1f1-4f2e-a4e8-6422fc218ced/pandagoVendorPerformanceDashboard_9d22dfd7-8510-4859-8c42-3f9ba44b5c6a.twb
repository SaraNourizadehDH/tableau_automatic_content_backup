              <calculation class='tableau' formula='IF [Parameters].[Brand or Outlet (copy)] = &apos;&apos; &#10;  THEN TRUE&#10;  ELSE REGEXP_MATCH(LOWER([parent_vendor_name]+[parent_vendor_code]+[vendor_name]+[vendor_code]),LOWER(REGEXP_REPLACE([Parameters].[Brand or Outlet (copy)],&apos; |,|;&apos;,&apos;|&apos;)))&#10;END' />
            </column>
