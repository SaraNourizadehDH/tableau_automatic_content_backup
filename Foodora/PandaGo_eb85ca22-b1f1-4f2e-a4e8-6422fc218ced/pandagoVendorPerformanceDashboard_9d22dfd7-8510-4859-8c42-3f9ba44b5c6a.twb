      <column caption='initial_start_date' datatype='date' name='[Calculation_1759218668339896322]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-21' />
      </column>
      <column caption='is_in_range' datatype='boolean' name='[Calculation_1759218668342071302]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] &lt;= [created_date_local]&#13;&#10;AND&#13;&#10;[Parameters].[Parameter 6] &gt;= [created_date_local]' />
      </column>
      <column caption='Vendor Code' datatype='string' name='[Calculation_2165035168206819331]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Parent&apos; THEN ATTR([parent_vendor_code])&#10;WHEN &apos;Child&apos; THEN ATTR([vendor_code])&#10;END' />
      </column>
      <column caption='is_new_vendor' datatype='boolean' name='[Calculation_2617646966759079938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [pgo_vendor_created_date], [created_date_local]) &lt;= 30&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_2979131190585339906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] IN (&apos;CANCELLED&apos;, &apos;DELIVERED&apos;)&#10;THEN [orders]&#10;END' />
      </column>
      <column caption='vendor_search' datatype='boolean' name='[Calculation_406520248128335874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Brand or Outlet (copy)] = &apos;&apos; &#10;  THEN TRUE&#10;  ELSE REGEXP_MATCH(LOWER([parent_vendor_name]+[parent_vendor_code]+[vendor_name]+[vendor_code]),LOWER(REGEXP_REPLACE([Parameters].[Brand or Outlet (copy)],&apos; |,|;&apos;,&apos;|&apos;)))&#10;END' />
      </column>
      <column caption='orders 與上期差異%' datatype='real' name='[Calculation_521502821809205249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_913949295356227585])) - LOOKUP(ZN(SUM([Calculation_913949295356227585])), 1)) / ABS(LOOKUP(ZN(SUM([Calculation_913949295356227585])), 1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='orders  與上期差異#' datatype='integer' name='[Calculation_521502821809872898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_913949295356227585])) - LOOKUP(ZN(SUM([Calculation_913949295356227585])), 1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='daily orders' datatype='real' name='[Calculation_521502821810393091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_913949295356227585])/(Max(DAY([created_date_local])))' />
      </column>
      <column caption='DFO(avg delivery fee)' datatype='real' name='[Calculation_521502821810581508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[delivery_fee_local]/[Calculation_913949295356227585]' />
      </column>
      <column caption='GPO(profit per order, cost = $60)' datatype='real' name='[Calculation_521502821810847749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_521502821810581508]-60' />
      </column>
      <column caption='當月總天數' datatype='integer' name='[Calculation_521502821818187782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max(DAY(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[created_date_local]))- 1))' />
      </column>
      <column caption='FCST orders' datatype='real' name='[Calculation_521502821818441735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_521502821810393091]*[Calculation_521502821818187782]' />
      </column>
      <column caption='FCST_MoM %' datatype='real' name='[Calculation_521502821818703880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(SUM([orders]), 1) != 0 THEN&#10;    (&#10;        ([Calculation_521502821818441735]) - LOOKUP(SUM([orders]), 1)&#10;    ) / ABS(LOOKUP(SUM([orders]), 1))&#10;ELSE&#10;    NULL&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='當期數據' datatype='string' datatype-customized='true' name='[Calculation_601723132458840067]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[參數 2] = &apos;Quarterly&apos; THEN &#10;    IF DATETRUNC(&apos;quarter&apos;, [created_date_local]) = DATETRUNC(&apos;quarter&apos;, TODAY()) THEN [Parameters].[參數 1]&#10;    END&#10;ELSEIF [Parameters].[參數 2] = &apos;Monthly&apos; THEN &#10;    IF DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, TODAY()) THEN [Parameters].[參數 1]&#10;    END&#10;ELSEIF [Parameters].[參數 2] = &apos;Weekly&apos; THEN &#10;    IF DATETRUNC(&apos;week&apos;, [created_date_local]) = DATETRUNC(&apos;week&apos;, TODAY()) THEN [Parameters].[參數 1]&#10;    END&#10;END' />
      </column>
      <column caption='前期數據' datatype='string' datatype-customized='true' name='[Calculation_601723132459622404]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[參數 2] = &apos;Quarterly&apos; THEN &#10;    IF DATETRUNC(&apos;quarter&apos;, [created_date_local]) = DATETRUNC(&apos;quarter&apos;, DATEADD(&apos;quarter&apos;, -1, TODAY())) THEN [Parameters].[參數 1]&#10;    END&#10;ELSEIF [Parameters].[參數 2] = &apos;Monthly&apos; THEN &#10;    IF DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [Parameters].[參數 1]&#10;    END&#10;ELSEIF [Parameters].[參數 2] = &apos;Weekly&apos; THEN &#10;    IF DATETRUNC(&apos;week&apos;, [created_date_local]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, TODAY())) THEN [Parameters].[參數 1]&#10;    END&#10;END' />
      </column>
      <column caption='Delta %' datatype='real' name='[Calculation_601723132462501894]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(ZN(([Calculation_6602417859525074946])) - LOOKUP(ZN(([Calculation_6602417859525074946])), 1)) / ABS(LOOKUP(ZN(([Calculation_6602417859525074946])), 1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delta #' datatype='real' name='[Calculation_601723132462604295]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(ZN(([Calculation_6602417859525074946])) - LOOKUP(ZN(([Calculation_6602417859525074946])), 1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='選擇的週期' datatype='string' datatype-customized='true' name='[Calculation_601723132529131532]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE((IF [Parameters].[參數 2] = &apos;Weekly&apos; THEN&#10;    DATETRUNC(&apos;week&apos;, [created_date_local])&#10;ELSEIF [Parameters].[參數 2] = &apos;Monthly&apos; THEN&#10;    DATETRUNC(&apos;month&apos;, [created_date_local])&#10;ELSEIF [Parameters].[參數 2] = &apos;Quarterly&apos; THEN&#10;    DATETRUNC(&apos;quarter&apos;, [created_date_local])&#10;END)))' />
      </column>
      <column caption='Rank delta #' datatype='integer' name='[Calculation_601723132533194765]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ZN(PREVIOUS_VALUE(RANK_UNIQUE([Calculation_6602417859525074946]))) - RANK_UNIQUE([Calculation_6602417859525074946])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='target orders' datatype='real' name='[Calculation_601723133573943316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([daily_target]) * (Max(DAY([created_date_local])))' />
      </column>
      <column caption='achivement %' datatype='real' name='[Calculation_601723133578440726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_913949295356227585]) / [Calculation_601723133573943316]' />
      </column>
      <column caption='order gap' datatype='real' name='[Calculation_601723133579005975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_601723133573943316] - SUM([Calculation_913949295356227585])' />
      </column>
      <column caption='onboarded outlets' datatype='real' name='[Calculation_601723133587689496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([onboarded_outlets])' />
      </column>
      <column caption='activate coverage %' datatype='real' name='[Calculation_601723133587976217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6602417859511193600]) / [Calculation_601723133587689496]' />
      </column>
      <column caption='target orders by parent vd' datatype='real' name='[Calculation_601723133831630874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( { FIXED [daily_target] : MAX([daily_target]) } ) * MAX(DAY([created_date_local]))' />
      </column>
      <column caption='order gap by parent vd' datatype='real' name='[Calculation_601723133848993822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_601723133831630874] - SUM([Calculation_913949295356227585])' />
      </column>
      <column caption='achivement % by parent vd' datatype='real' name='[Calculation_601723133849628703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_913949295356227585]) / [Calculation_601723133831630874]' />
      </column>
      <column caption='Eff Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_629659562793222144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [status] = &apos;DELIVERED&apos;&#13;&#10;THEN [vendor_code]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='activated vendors' datatype='integer' name='[Calculation_6602417859511193600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [parent_vendor_name] : &#10; COUNTD(&#10;  IF [status] = &apos;DELIVERED&apos;&#10;  THEN [vendor_code]&#10;  END&#10; )&#10;}' />
      </column>
      <column caption='選擇的指標值' datatype='real' name='[Calculation_6602417859525074946]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;    WHEN &apos;Delivered Orders&apos; THEN SUM([Calculation_913949295356227585])&#10;    WHEN &apos;Cancelled Rate&apos; THEN [Calculation_913949295357620228]&#10;    WHEN &apos;daily orders&apos; THEN [Calculation_521502821810393091]&#10;    WHEN &apos;Eff Vendors&apos; THEN [Calculation_629659562793222144]&#10;    WHEN &apos;FCST orders&apos; THEN [Calculation_521502821818441735]&#10;    WHEN &apos;daily_delivered_orders_per_vx&apos; THEN [Calculation_913949295343915008]&#10;END' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_6602417859525558275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(([Calculation_6602417859525074946]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg. Daily Orders' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6992331031154991104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE DATE([created_date_local]):SUM([Calculation_913949295356227585])})' />
      </column>
      <column caption='avg orders per vendor ' datatype='real' name='[Calculation_88242468903026689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_521502821810393091]/[Calculation_629659562793222144]' />
      </column>
      <column caption='avg_delivered_delivery_fee_local' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_884675891001028612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_913949295357767685])/SUM([Calculation_913949295356227585])' />
      </column>
      <column caption='avg_delivered_amount_local' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_884675891001155589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_913949295358210054])/SUM([Calculation_913949295356227585])' />
      </column>
      <column caption='main_kpis' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_884675891001470982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Delivered Orders&apos; THEN SUM([Calculation_913949295356227585])&#13;&#10;WHEN &apos;Delivered Order Share&apos; THEN [Calculation_896779324602863617]&#13;&#10;WHEN &apos;Cancelled Orders&apos; THEN SUM([Calculation_913949295356485634])&#13;&#10;WHEN &apos;Cancelled Rate&apos; THEN [Calculation_913949295357620228]&#13;&#10;WHEN &apos;Delivery Fee&apos; THEN SUM([Calculation_913949295357767685])&#13;&#10;WHEN &apos;Avg. Delivery Fee&apos; THEN [Calculation_884675891001028612]&#13;&#10;WHEN &apos;Delivered Amount&apos; THEN SUM([Calculation_913949295358210054])&#13;&#10;WHEN &apos;Avg. Delivered Amount&apos; THEN [Calculation_884675891001155589]&#13;&#10;WHEN &apos;Rider Cost&apos; THEN SUM([rider_cost_local])&#13;&#10;WHEN &apos;Rider CPO&apos; THEN [Calculation_913949295359492103]&#13;&#10;WHEN &apos;Profit&apos; THEN [Calculation_1243837976227414017]&#13;&#10;WHEN &apos;Profit per Order&apos; THEN [Calculation_1243837976234455043]&#13;&#10;WHEN &apos;Daily Orders per Vendor&apos; THEN [Calculation_913949295343915008]&#10;WHEN &apos;Avg. Daily Orders&apos; THEN [Calculation_6992331031154991104]&#13;&#10;WHEN &apos;Eff Vendors&apos; THEN [Calculation_629659562793222144]&#13;&#10;WHEN &apos;Avg. Pickup Distance&apos; THEN [Calculation_1071575274051723264]&#13;&#10;WHEN &apos;Avg. Dropoff Distance&apos; THEN [Calculation_1071575274052005889]&#13;&#10;END' />
      </column>
      <column caption='updated to' datatype='date' name='[Calculation_884675891002089479]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([created_date_local])}' />
      </column>
      <column caption='updated from' datatype='date' name='[Calculation_884675891002179592]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN([created_date_local])}' />
      </column>
      <column caption='isoweek' datatype='string' name='[Calculation_884675891003326473]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;w&apos; + DATENAME(&apos;iso-week&apos;,DATETRUNC(&apos;iso-week&apos;,[created_date_local]))' />
      </column>
      <column caption='relative weeks' datatype='string' name='[Calculation_884675891007135757]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;DATETRUNC(&apos;iso-week&apos;, [created_date_local]) = &#13;&#10;{MAX(DATETRUNC(&apos;iso-week&apos;, [Calculation_884675891002089479]))}&#13;&#10;then &apos;this week&apos;&#13;&#10;elseif &#13;&#10;DATETRUNC(&apos;iso-week&apos;, [created_date_local]) = &#13;&#10;{MAX(DATETRUNC(&apos;iso-week&apos;, [Calculation_884675891002089479])-7)}&#13;&#10;then &apos;last week&apos;&#13;&#10;else &apos;other weeks&apos;&#13;&#10;end' />
      </column>
      <column caption='datetrunc created_date_local' datatype='date' name='[Calculation_884675891051331598]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(mtd)&apos;)&#13;&#10;THEN DATE(DATETRUNC(&apos;month&apos;, [created_date_local]))&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 3], &apos;(iso-week)|(wtd)&apos;)&#13;&#10;THEN DATE(DATETRUNC(&apos;iso-week&apos;, [created_date_local]))&#13;&#10;ELSE DATE(DATETRUNC(&apos;day&apos;, [created_date_local]))&#13;&#10;END' />
      </column>
      <column caption='datename(2) created_date_local' datatype='string' name='[Calculation_884675891052937231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;day&apos;&#13;&#10;THEN left(DATENAME(&apos;weekday&apos;, [created_date_local]),3)&#13;&#10;ELSE STR(YEAR([Calculation_884675891051331598]))&#13;&#10;END' />
      </column>
      <column caption='datename report_date' datatype='string' name='[Calculation_884675891053281296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(mtd)&apos;) then &#13;&#10;LEFT(DATENAME(&apos;month&apos;, [created_date_local]),3)&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 3], &apos;(iso-week)|(wtd)&apos;) then &#13;&#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [created_date_local])&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;day&apos; then&#13;&#10;STR([Calculation_884675891051331598])&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='wtd updated_to' datatype='integer' name='[Calculation_884675891054055441]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Calculation_884675891002089479]) = 1 then 7&#13;&#10;ELSE DATEPART(&apos;weekday&apos;,[Calculation_884675891002089479]) - 1&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='wtd created_date_local' datatype='integer' name='[Calculation_884675891054219282]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[created_date_local]) = 1 then 7&#13;&#10;ELSE DATEPART(&apos;weekday&apos;,[created_date_local]) - 1&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='mtd updated_to' datatype='integer' name='[Calculation_884675891054354451]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;,[Calculation_884675891002089479])' />
      </column>
      <column aggregation='Sum' caption='mtd created_date_local' datatype='integer' name='[Calculation_884675891054456852]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [created_date_local])' />
      </column>
      <column caption='datefilter created_date_local' datatype='boolean' name='[Calculation_884675891055181847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(iso-week)|(day)&apos;)&#13;&#10;THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;mtd&apos;&#13;&#10;THEN [Calculation_884675891054456852] &lt;= [Calculation_884675891054354451]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;wtd&apos;&#13;&#10;THEN [Calculation_884675891054219282] &lt;= [Calculation_884675891054055441]&#13;&#10;END' />
      </column>
      <column caption='vendor_parent_child' datatype='string' name='[Calculation_884675891057889304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Parent&apos; THEN [parent_vendor_name]&#13;&#10;WHEN &apos;Child&apos; THEN [vendor_name]&#13;&#10;END' />
      </column>
      <column caption='rk' datatype='integer' name='[Calculation_884675891058638873]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK_UNIQUE(ZN([Calculation_884675891001470982]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N vendor_brand_outlet' datatype='boolean' name='[Calculation_884675891061518363]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] &gt; 0 &#13;&#10;THEN RANK_UNIQUE(ZN([Calculation_884675891001470982])) &lt;= [Parameters].[Parameter 4]&#13;&#10;ELSE TRUE&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delivered Order Share' datatype='real' default-format='p0.00%' name='[Calculation_896779324602863617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_913949295356227585])/MAX({SUM([Calculation_913949295356227585])})' />
      </column>
      <column caption='%diff main_kpi' datatype='real' default-format='p0.00%' name='[Calculation_909445694714662912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([main_kpis (copy)_1400619520836476929]) - LOOKUP(ZN([main_kpis (copy)_1400619520836476929]), -1)) / ABS(LOOKUP(ZN([main_kpis (copy)_1400619520836476929]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='daily_delivered_orders_per_vx' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_913949295343915008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [vendor_code], DATE([created_date_local]):SUM([Calculation_913949295356227585])})' />
      </column>
      <column caption='Delivered Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_913949295356227585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &apos;DELIVERED&apos;&#13;&#10;THEN [orders]&#13;&#10;END' />
      </column>
      <column caption='Cancelled Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_913949295356485634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] != &apos;DELIVERED&apos;&#13;&#10;THEN [orders]&#13;&#10;END' />
      </column>
      <column caption='Cancelled Rate' datatype='real' default-format='p0.00%' name='[Calculation_913949295357620228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_913949295356485634])/SUM([orders])' />
      </column>
