              </calculation>
            </column>
            <column caption='daily_delivered_orders_per_vx' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_913949295343915008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [vendor_code], DATE([created_date_local]):SUM([Calculation_913949295356227585])})' />
            </column>
            <column caption='Delivered Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_913949295356227585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;DELIVERED&apos;&#13;&#10;THEN [orders]&#13;&#10;END' />
            </column>
            <column caption='Cancelled Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_913949295356485634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] != &apos;DELIVERED&apos;&#13;&#10;THEN [orders]&#13;&#10;END' />
            </column>
            <column caption='Cancelled Rate' datatype='real' default-format='p0.00%' name='[Calculation_913949295357620228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_913949295356485634])/SUM([orders])' />
            </column>
            <column caption='Delivered Delivery Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_913949295357767685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;DELIVERED&apos;&#13;&#10;THEN [delivery_fee_local]&#13;&#10;END' />
