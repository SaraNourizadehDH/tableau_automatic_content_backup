    <worksheet name='Total Monthly Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Monthly Summary</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='TotalMonthlySummary' path='/t/Foodora/workbooks/pandagoVendorPerformanceDashboard' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='daily_odr_vendor_orders' name='sqlproxy.1twniir1663o0d1g0cvip0itwia5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor Search' datatype='string' name='[Brand or Outlet (copy)]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Parent or Child' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Parent&quot;'>
              <calculation class='tableau' formula='&quot;Parent&quot;' />
            </column>
            <column alias='Daily' caption='Date Part' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;iso-week&quot;' value='Weekly' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;mtd&quot;' value='Mtd' />
                <alias key='&quot;wtd&quot;' value='Wtd' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.1twniir1663o0d1g0cvip0itwia5].[Calculation_1759218668339896322]' caption='Start Date' datatype='date' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-07#'>
              <calculation class='tableau' formula='#2025-05-07#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.1twniir1663o0d1g0cvip0itwia5].[Calculation_1759218668339765249]' caption='End Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-27#'>
              <calculation class='tableau' formula='#2025-05-27#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1twniir1663o0d1g0cvip0itwia5'>
            <column caption='initial_end_date' datatype='date' name='[Calculation_1759218668339765249]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-1' />
            </column>
            <column caption='initial_start_date' datatype='date' name='[Calculation_1759218668339896322]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-21' />
            </column>
            <column caption='is_in_range' datatype='boolean' name='[Calculation_1759218668342071302]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] &lt;= [created_date_local]&#13;&#10;AND&#13;&#10;[Parameters].[Parameter 6] &gt;= [created_date_local]' />
            </column>
            <column caption='is_new_vendor' datatype='boolean' name='[Calculation_2617646966759079938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [pgo_vendor_created_date], [created_date_local]) &lt;= 30&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='vendor_search' datatype='boolean' name='[Calculation_406520248128335874]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Brand or Outlet (copy)] = &apos;&apos; &#10;  THEN TRUE&#10;  ELSE REGEXP_MATCH(LOWER([parent_vendor_name]+[parent_vendor_code]+[vendor_name]+[vendor_code]),LOWER(REGEXP_REPLACE([Parameters].[Brand or Outlet (copy)],&apos; |,|;&apos;,&apos;|&apos;)))&#10;END' />
            </column>
            <column caption='orders 與上期差異%' datatype='real' name='[Calculation_521502821809205249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_913949295356227585])) - LOOKUP(ZN(SUM([Calculation_913949295356227585])), 1)) / ABS(LOOKUP(ZN(SUM([Calculation_913949295356227585])), 1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='orders  與上期差異#' datatype='integer' name='[Calculation_521502821809872898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_913949295356227585])) - LOOKUP(ZN(SUM([Calculation_913949295356227585])), 1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='daily orders' datatype='real' name='[Calculation_521502821810393091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_913949295356227585])/(Max(DAY([created_date_local])))' />
            </column>
            <column caption='DFO(avg delivery fee)' datatype='real' name='[Calculation_521502821810581508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[delivery_fee_local]/[Calculation_913949295356227585]' />
            </column>
            <column caption='GPO(profit per order, cost = $60)' datatype='real' name='[Calculation_521502821810847749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_521502821810581508]-60' />
            </column>
            <column caption='當月總天數' datatype='integer' name='[Calculation_521502821818187782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max(DAY(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[created_date_local]))- 1))' />
            </column>
            <column caption='FCST orders' datatype='real' name='[Calculation_521502821818441735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_521502821810393091]*[Calculation_521502821818187782]' />
            </column>
            <column caption='FCST_MoM %' datatype='real' name='[Calculation_521502821818703880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LOOKUP(SUM([orders]), 1) != 0 THEN&#10;    (&#10;        ([Calculation_521502821818441735]) - LOOKUP(SUM([orders]), 1)&#10;    ) / ABS(LOOKUP(SUM([orders]), 1))&#10;ELSE&#10;    NULL&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='target orders' datatype='real' name='[Calculation_601723133573943316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([daily_target]) * (Max(DAY([created_date_local])))' />
            </column>
            <column caption='order gap' datatype='real' name='[Calculation_601723133579005975]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_601723133573943316] - SUM([Calculation_913949295356227585])' />
            </column>
            <column caption='target orders by parent vd' datatype='real' name='[Calculation_601723133831630874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( { FIXED [daily_target] : MAX([daily_target]) } ) * MAX(DAY([created_date_local]))' />
            </column>
            <column caption='order gap by parent vd' datatype='real' name='[Calculation_601723133848993822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_601723133831630874] - SUM([Calculation_913949295356227585])' />
            </column>
            <column caption='achivement % by parent vd' datatype='real' name='[Calculation_601723133849628703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_913949295356227585]) / [Calculation_601723133831630874]' />
            </column>
            <column caption='updated to' datatype='date' name='[Calculation_884675891002089479]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_date_local])}' />
            </column>
            <column aggregation='Sum' caption='wtd updated_to' datatype='integer' name='[Calculation_884675891054055441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Calculation_884675891002089479]) = 1 then 7&#13;&#10;ELSE DATEPART(&apos;weekday&apos;,[Calculation_884675891002089479]) - 1&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='wtd created_date_local' datatype='integer' name='[Calculation_884675891054219282]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[created_date_local]) = 1 then 7&#13;&#10;ELSE DATEPART(&apos;weekday&apos;,[created_date_local]) - 1&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='mtd updated_to' datatype='integer' name='[Calculation_884675891054354451]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;,[Calculation_884675891002089479])' />
            </column>
            <column aggregation='Sum' caption='mtd created_date_local' datatype='integer' name='[Calculation_884675891054456852]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [created_date_local])' />
            </column>
            <column caption='datefilter created_date_local' datatype='boolean' name='[Calculation_884675891055181847]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(iso-week)|(day)&apos;)&#13;&#10;THEN TRUE&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;mtd&apos;&#13;&#10;THEN [Calculation_884675891054456852] &lt;= [Calculation_884675891054354451]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;wtd&apos;&#13;&#10;THEN [Calculation_884675891054219282] &lt;= [Calculation_884675891054055441]&#13;&#10;END' />
            </column>
            <column caption='vendor_parent_child' datatype='string' name='[Calculation_884675891057889304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Parent&apos; THEN [parent_vendor_name]&#13;&#10;WHEN &apos;Child&apos; THEN [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='Delivered Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_913949295356227585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;DELIVERED&apos;&#13;&#10;THEN [orders]&#13;&#10;END' />
            </column>
