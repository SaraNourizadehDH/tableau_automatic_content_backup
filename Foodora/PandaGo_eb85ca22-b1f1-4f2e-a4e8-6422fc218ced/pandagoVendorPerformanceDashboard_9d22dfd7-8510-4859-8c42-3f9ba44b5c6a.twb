            <column caption='is_new_vendor' datatype='boolean' name='[Calculation_2617646966759079938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [pgo_vendor_created_date], [created_date_local]) &lt;= 30&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
