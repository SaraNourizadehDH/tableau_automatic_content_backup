      <datasources>
        <datasource name='Parameters' />
        <datasource caption='daily_odr_vendor_orders' name='sqlproxy.1twniir1663o0d1g0cvip0itwia5' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Vendor Search' datatype='string' name='[Brand or Outlet (copy)]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
          <calculation class='tableau' formula='&quot;&quot;' />
        </column>
        <column caption='Parent or Child' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Parent&quot;'>
          <calculation class='tableau' formula='&quot;Parent&quot;' />
          <members>
            <member value='&quot;Parent&quot;' />
            <member value='&quot;Child&quot;' />
          </members>
        </column>
        <column caption='Main KPIs' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Delivered Orders&quot;'>
          <calculation class='tableau' formula='&quot;Delivered Orders&quot;' />
          <members>
            <member value='&quot;Delivered Orders&quot;' />
            <member value='&quot;Delivered Order Share&quot;' />
            <member value='&quot;Cancelled Orders&quot;' />
            <member value='&quot;Cancelled Rate&quot;' />
            <member value='&quot;Delivery Fee&quot;' />
            <member value='&quot;Avg. Delivery Fee&quot;' />
            <member value='&quot;Delivered Amount&quot;' />
            <member value='&quot;Avg. Delivered Amount&quot;' />
            <member value='&quot;Rider Cost&quot;' />
            <member value='&quot;Rider CPO&quot;' />
            <member value='&quot;Profit&quot;' />
            <member value='&quot;Profit per Order&quot;' />
            <member value='&quot;Daily Orders per Vendor&quot;' />
            <member value='&quot;Avg. Daily Orders&quot;' />
            <member value='&quot;Eff Vendors&quot;' />
            <member value='&quot;Avg. Pickup Distance&quot;' />
            <member value='&quot;Avg. Dropoff Distance&quot;' />
          </members>
        </column>
        <column alias='Daily' caption='Date Part' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
          <calculation class='tableau' formula='&quot;day&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;iso-week&quot;' value='Weekly' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;mtd&quot;' value='Mtd' />
            <alias key='&quot;wtd&quot;' value='Wtd' />
          </aliases>
          <members>
            <member alias='Monthly' value='&quot;month&quot;' />
            <member alias='Mtd' value='&quot;mtd&quot;' />
            <member alias='Weekly' value='&quot;iso-week&quot;' />
            <member alias='Wtd' value='&quot;wtd&quot;' />
            <member alias='Daily' value='&quot;day&quot;' />
          </members>
        </column>
        <column caption='List Limit' datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='50'>
          <calculation class='tableau' formula='50' />
