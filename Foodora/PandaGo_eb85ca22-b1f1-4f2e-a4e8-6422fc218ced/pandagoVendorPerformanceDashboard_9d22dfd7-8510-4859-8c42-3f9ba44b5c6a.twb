      <column caption='display_main_kpis (trend)' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[main_kpis (copy)_4076672508026535936]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Delivered Orders&apos; THEN STR(SUM([Calculation_913949295356227585]))&#13;&#10;WHEN &apos;Total Delivered Order Share&apos; THEN STR(ROUND([Total Delivered Order Share (copy)_1400619520832741376]*100,2)) + &apos;%&apos;&#13;&#10;WHEN &apos;Cancelled Orders&apos; THEN STR(SUM([Calculation_913949295356485634]))&#13;&#10;WHEN &apos;Cancelled Rate&apos; THEN  STR(ROUND([Calculation_913949295357620228]*100,2)) + &apos;%&apos;&#13;&#10;WHEN &apos;Total Delivery Fee&apos; THEN STR(ROUND(SUM([Calculation_913949295357767685]),1))&#13;&#10;WHEN &apos;Avg. Delivery Fee&apos; THEN STR(ROUND([Calculation_884675891001028612],2))&#13;&#10;WHEN &apos;Total Order Amount&apos; THEN STR(ROUND(SUM([Calculation_913949295358210054]),1))&#13;&#10;WHEN &apos;Avg. Order Amount&apos; THEN STR(ROUND([Calculation_884675891001155589],2))&#13;&#10;WHEN &apos;Rider Cost&apos; THEN STR(ROUND(SUM([rider_cost_local]),1))&#13;&#10;WHEN &apos;Rider CPO&apos; THEN STR(ROUND([Calculation_913949295359492103],2))&#13;&#10;WHEN &apos;GP&apos; THEN STR(ROUND([Calculation_1243837976227414017],1))&#13;&#10;WHEN &apos;GPO&apos; THEN STR(ROUND([Calculation_1243837976234455043],2))&#13;&#10;WHEN &apos;Daily Orders per Vendor&apos; THEN STR(ROUND([Calculation_913949295343915008],2))&#10;WHEN &apos;Avg. Daily Orders&apos; THEN STR(ROUND([Calculation_6992331031154991104],1))&#13;&#10;WHEN &apos;Eff Vendors&apos; THEN STR([Calculation_629659562793222144])&#13;&#10;WHEN &apos;Avg. Pickup Distance&apos; THEN STR(ROUND([Calculation_1071575274051723264],1))&#13;&#10;WHEN &apos;Avg. Dropoff Distance&apos; THEN STR(ROUND([Calculation_1071575274052005889],1))&#13;&#10;END' />
      </column>
