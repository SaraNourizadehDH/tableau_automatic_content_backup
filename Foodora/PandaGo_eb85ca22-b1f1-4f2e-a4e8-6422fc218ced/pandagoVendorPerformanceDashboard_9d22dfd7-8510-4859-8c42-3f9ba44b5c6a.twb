        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Delivered Orders&apos; THEN SUM([Calculation_913949295356227585])&#13;&#10;WHEN &apos;Delivered Order Share&apos; THEN [Total Delivered Order Share (copy)_1400619520832741376]&#13;&#10;WHEN &apos;Cancelled Orders&apos; THEN SUM([Calculation_913949295356485634])&#13;&#10;WHEN &apos;Cancelled Rate&apos; THEN [Calculation_913949295357620228]&#13;&#10;WHEN &apos;Delivery Fee&apos; THEN SUM([Calculation_913949295357767685])&#13;&#10;WHEN &apos;Avg. Delivery Fee&apos; THEN [Calculation_884675891001028612]&#13;&#10;WHEN &apos;Delivered Amount&apos; THEN SUM([Calculation_913949295358210054])&#13;&#10;WHEN &apos;Avg. Delivered Amount&apos; THEN [Calculation_884675891001155589]&#13;&#10;WHEN &apos;Rider Cost&apos; THEN SUM([rider_cost_local])&#13;&#10;WHEN &apos;Rider CPO&apos; THEN [Calculation_913949295359492103]&#13;&#10;WHEN &apos;Profit&apos; THEN [Calculation_1243837976227414017]&#13;&#10;WHEN &apos;Profit per Order&apos; THEN [Calculation_1243837976234455043]&#13;&#10;WHEN &apos;Daily Orders per Vendor&apos; THEN [Calculation_913949295343915008]&#10;WHEN &apos;Avg. Daily Orders&apos; THEN [Calculation_6992331031154991104]&#13;&#10;WHEN &apos;Eff Vendors&apos; THEN [Calculation_629659562793222144]&#13;&#10;WHEN &apos;Avg. Pickup Distance&apos; THEN [Calculation_1071575274051723264]&#13;&#10;WHEN &apos;Avg. Dropoff Distance&apos; THEN [Calculation_1071575274052005889]&#13;&#10;END' />
