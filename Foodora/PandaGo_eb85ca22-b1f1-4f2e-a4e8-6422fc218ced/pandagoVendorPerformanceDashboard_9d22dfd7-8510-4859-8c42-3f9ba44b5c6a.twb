              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Parent&apos; THEN [parent_vendor_name]&#13;&#10;WHEN &apos;Child&apos; THEN [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='%diff main_kpi' datatype='real' default-format='p0.00%' name='[Calculation_909445694714662912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([main_kpis (copy)_1400619520836476929]) - LOOKUP(ZN([main_kpis (copy)_1400619520836476929]), -1)) / ABS(LOOKUP(ZN([main_kpis (copy)_1400619520836476929]), -1))'>
