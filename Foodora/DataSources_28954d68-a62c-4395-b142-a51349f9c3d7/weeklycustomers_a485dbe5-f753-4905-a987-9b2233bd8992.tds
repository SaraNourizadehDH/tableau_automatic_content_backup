  <aliases enabled='yes' />
  <column caption='afv' datatype='real' name='[Calculation_988540158988005377]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([gfv_local])/SUM([orders])' />
  </column>
  <column caption='contrib' datatype='real' name='[Calculation_988540158988115971]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([gfv_local])/COUNTD([pd_customer_uuid])' />
  </column>
  <column caption='order_freq' datatype='real' name='[Calculation_988540158988173316]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([orders])/COUNTD([pd_customer_uuid])' />
  </column>
  <column caption='weekly orders (bin)' datatype='string' name='[Calculation_988540158988341253]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [orders] = 1 then &apos;1&apos;&#13;&#10;elseif [orders] &lt;= 4 then &apos;2-4&apos;&#13;&#10;elseif [orders] &lt;= 7 then &apos;5-7&apos;&#13;&#10;else &apos;&gt;7&apos;&#13;&#10;end' />
  </column>
  <column caption='updated_to_week' datatype='date' name='[Calculation_988540158988537863]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MAX([report_week])}' />
  </column>
  <column caption='updated_from_week' datatype='date' name='[Calculation_988540158988578824]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MIN([report_week])}' />
  </column>
  <column caption='datename report_week' datatype='string' name='[Calculation_988540158988664841]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='&apos;w&apos;+DATENAME(&apos;iso-week&apos;, DATE([report_week]))' />
  </column>
  <column caption='datename report_week (2)' datatype='string' name='[Calculation_988540158988705802]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='STR([report_week])' />
  </column>
  <column caption='exclude incomplete_week' datatype='boolean' name='[Calculation_988540158988759051]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='date([Calculation_988540158988537863]) != date([report_week])' />
  </column>
  <column caption='afv (bin)' datatype='string' name='[Calculation_988540158989099021]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [gfv_local]/[orders] &lt; 50 then &apos;&lt;50&apos;&#13;&#10;elseif [gfv_local]/[orders] &lt; 100 then &apos;50-99&apos;&#13;&#10;elseif [gfv_local]/[orders] &lt; 150 then &apos;100-149&apos;&#13;&#10;elseif [gfv_local]/[orders] &lt; 200 then &apos;150-199&apos;&#13;&#10;elseif [gfv_local]/[orders] &lt; 250 then &apos;200-249&apos;&#13;&#10;elseif [gfv_local]/[orders] &lt; 300 then &apos;250-299&apos;&#13;&#10;elseif [gfv_local]/[orders] &lt; 350 then &apos;300-349&apos;&#13;&#10;elseif [gfv_local]/[orders] &lt; 400 then &apos;350-399&apos;&#13;&#10;else &apos;&gt;400&apos;&#13;&#10;end' />
  </column>
  <column caption='first_order_week' datatype='date' name='[Calculation_988540158989172750]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{ FIXED [pd_customer_uuid]:MAX(&#13;&#10;if [first_orders] = 1 then [report_week] end&#13;&#10;)}' />
  </column>
  <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
    <calculation class='tableau' formula='1' />
  </column>
