  <aliases enabled='yes' />
  <column caption='datefilter report_date' datatype='boolean' name='[Calculation_1074671513489727489]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)|(hour)&apos;)&#13;&#10;then TRUE&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#13;&#10;then [Calculation_276408455384219657] &lt;= [Calculation_276408455384158216]&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#13;&#10;then [Calculation_276408455384076295] &lt;= [Calculation_276408455383965702]&#13;&#10;end' />
  </column>
  <column caption='report_datetime' datatype='datetime' name='[Calculation_1134062749862506496]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='MAKEDATETIME([report_date], MAKETIME([hour],0,0))' />
  </column>
  <column caption='updated_date' datatype='date' name='[Calculation_276408455382786050]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MAX([report_date])}' />
