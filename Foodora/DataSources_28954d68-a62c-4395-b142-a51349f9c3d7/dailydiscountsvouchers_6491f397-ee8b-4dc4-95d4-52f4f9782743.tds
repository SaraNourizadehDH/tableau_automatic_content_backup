  <aliases enabled='yes' />
  <column caption='discount_title_adj' datatype='string' name='[Calculation_1007891555165556737]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF ISNULL([discount_title]) THEN &apos;No discount orders&apos;&#10;ELSE [discount_title]&#10;END' />
  </column>
  <column caption='discount_end_date_adj' datatype='date' name='[Calculation_1007891555165822978]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='min(&#10;{max([report_date])},&#10;{ FIXED [Calculation_1007891555165556737]:max([discount_end_date])}&#10;)' />
  </column>
  <column caption='updated_date' datatype='date' name='[Calculation_1007891555166134277]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MAX([report_date])}' />
  </column>
  <column aggregation='Sum' caption='wtd report_date' datatype='integer' name='[Calculation_1007891555166437382]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;ELSE DATEPART(&apos;weekday&apos;,[report_date]) - 1&#10;END' />
  </column>
  <column caption='datetrunc report_date' datatype='date' name='[Calculation_1007891555181166602]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then date(DATETRUNC(&apos;week&apos;, [report_date]))&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#10;end' />
  </column>
  <column caption='datename report_date' datatype='string' name='[Calculation_1007891555181355019]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#10;&apos;Week &apos; + DATENAME(&apos;week&apos;, [report_date])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#10;str([Calculation_1007891555181166602])&#10;end' />
  </column>
  <column caption='datename(2) report_date' datatype='string' name='[Calculation_1007891555181559820]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;else str(year([Calculation_1007891555181166602]))&#10;end' />
  </column>
  <column caption='datefilter report_date' datatype='boolean' name='[Calculation_1007891555181637645]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [wtd_report_date (copy)_1007891555167100936] &lt;= [mtd_report_date (copy)_1007891555167256585]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [Calculation_1007891555166437382] &lt;= [wtd_report_date (copy)_1007891555166568455]&#13;&#10;else TRUE&#13;&#10;end' />
  </column>
  <column aggregation='Sum' caption='datediff report_date' datatype='integer' name='[Calculation_1007891555181707278]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_1007891555166134277])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;week&apos;,[report_date], [Calculation_1007891555166134277])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_1007891555166134277])&#10;end' />
  </column>
  <column caption='voucher_description_adj' datatype='string' name='[Calculation_1007891555196657681]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([adjust_voucher_description],&apos;([a-z]|\d){4}-([a-z]|\d){4}&apos;)&#10;THEN &apos;Specific orders&apos;&#10;ELSEIF  isnull([adjust_voucher_description])&#10;THEN &apos;No voucher orders&apos;&#10;ELSE [adjust_voucher_description]&#10;END' />
  </column>
  <column caption='voucher_end_date_adj' datatype='date' name='[Calculation_1007891555196825618]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='min(&#10;{max([report_date])},&#10;{ FIXED [Calculation_1007891555196657681]:max([voucher_end_date])}&#10;)' />
  </column>
  <column caption='dis_vou_end_date' datatype='date' name='[Calculation_1007891555197177876]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [Calculation_1007891555165822978]&#10;WHEN &apos;Voucher&apos; THEN [Calculation_1007891555196825618]&#10;END' />
  </column>
  <column caption='dis_vou_datediff' datatype='integer' name='[Calculation_1007891555198414873]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[dis_vou_end_date (copy)_1007891555197321237],[Calculation_1007891555197177876])' />
  </column>
  <column caption='dis_vou_own_cost' datatype='real' name='[Calculation_1007891555198631962]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; then [own_discount_local]&#10;WHEN &apos;Voucher&apos; then [own_voucher_local]&#10;END' />
  </column>
  <column caption='dis_vou_vendor_cost' datatype='real' name='[Calculation_1007891555198873627]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [vendor_discount_local]&#10;WHEN &apos;Voucher&apos; THEN [vendor_voucher_local]&#10;END' />
  </column>
  <column caption='first_orders' datatype='integer' name='[Calculation_1007891555199156252]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_1287748064437972992] then [orders] end' />
  </column>
  <column caption='gfv' datatype='real' name='[Calculation_1007891555199242269]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;TWD&apos;&#10;THEN [gfv_local]&#10;ELSE [gfv_eur]&#10;END' />
  </column>
  <column caption='own_discount' datatype='real' name='[Calculation_1007891555199545375]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;TWD&apos;&#10;THEN [own_discount_local]&#10;ELSE [own_discount_eur]&#10;END' />
  </column>
  <column caption='agg_is_first_order' datatype='boolean' name='[Calculation_1287748064437972992]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;WHEN &apos;Platform&apos; THEN [is_first_order]&#10;WHEN &apos;Restaurants&apos; THEN [is_first_order_restaurants]&#13;&#10;WHEN &apos;New Vertical&apos; THEN [is_first_order_new_vertical]&#13;&#10;WHEN &apos;Shops&apos; THEN [is_first_order_shops]&#13;&#10;WHEN &apos;Dmart&apos; THEN [is_first_order_dmart]&#10;WHEN &apos;Pickup&apos; THEN [is_first_order_pickup]&#13;&#10;END' />
  </column>
  <column caption='partition' datatype='string' name='[Calculation_1462825464137146368]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Voucher/Discount Type&apos; THEN [dis_vou_title (copy)_1007891555197726744]&#13;&#10;WHEN &apos;Voucher Purpose&apos; THEN [voucher_purpose]&#13;&#10;WHEN &apos;Voucher Channel&apos; THEN [voucher_channel]&#13;&#10;END' />
  </column>
  <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
