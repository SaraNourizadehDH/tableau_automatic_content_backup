  </column>
  <column caption='datediff report_date' datatype='integer' name='[Calculation_276408455383687172]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(month)|(mtd)&quot;)&#13;&#10;THEN DATEDIFF(&quot;month&quot;, [report_date], [Calculation_276408455382786050])&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(week)|(wtd)&quot;)&#13;&#10;THEN DATEDIFF(&quot;iso-week&quot;, [report_date], [Calculation_276408455382786050])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;day&quot;&#13;&#10;THEN DATEDIFF(&quot;day&quot;, [report_date], [Calculation_276408455382786050])&#13;&#10;END' />
  </column>
  <column caption='wtd updated_date' datatype='integer' name='[Calculation_276408455383965702]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF DATEPART(&quot;weekday&quot;, [Calculation_276408455382786050]) = 1&#10;THEN 7&#13;&#10;ELSE DATEPART(&quot;weekday&quot;, [Calculation_276408455382786050]) - 1&#13;&#10;END' />
  </column>
  <column caption='wtd report_date' datatype='integer' name='[Calculation_276408455384076295]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF DATEPART(&quot;weekday&quot;, [report_date]) = 1&#10;THEN 7&#13;&#10;ELSE DATEPART(&quot;weekday&quot;, [report_date]) - 1&#13;&#10;END' />
  </column>
  <column caption='mtd updated_date' datatype='integer' name='[Calculation_276408455384158216]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&quot;day&quot;, [Calculation_276408455382786050])' />
  </column>
  <column caption='mtd report_date' datatype='integer' name='[Calculation_276408455384219657]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&quot;day&quot;, [report_date])' />
  </column>
  <column caption='datetrunc report_date' datatype='date' name='[Calculation_276408455384391690]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(month)|(mtd)&quot;)&#13;&#10;THEN DATE(DATETRUNC(&quot;month&quot;, [report_date]))&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(week)|(wtd)&quot;)&#13;&#10;THEN DATE(DATETRUNC(&quot;iso-week&quot;, [report_date]))&#13;&#10;ELSE DATE(DATETRUNC(&quot;day&quot;, [report_date]))&#13;&#10;END' />
  </column>
  <column caption='datename(2) report_date' datatype='string' name='[Calculation_276408455384498187]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;day&quot;&#13;&#10;THEN left(DATENAME(&quot;weekday&quot;, [report_date], &quot;monday&quot;), 3)&#13;&#10;ELSE STR(YEAR([Calculation_276408455384391690]))&#13;&#10;END' />
  </column>
  <column caption='datename report_date' datatype='string' name='[Calculation_276408455384604684]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(month)|(mtd)&quot;)&#10;THEN LEFT(DATENAME(&quot;month&quot;, [report_date]), 3)&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(week)|(wtd)&quot;)&#10;THEN &quot;Week &quot; + DATENAME(&quot;iso-week&quot;, [report_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;day&quot;&#10;THEN STR([Calculation_276408455384391690])&#13;&#10;END' />
  </column>
