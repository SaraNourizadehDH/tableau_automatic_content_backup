  <aliases enabled='yes' />
  <column caption='wtd report_date' datatype='integer' name='[Calculation_1241586170674286593]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[report_date]) - 1&#13;&#10;end' />
  </column>
  <column caption='wtd updated_date' datatype='integer' name='[Calculation_1241586170674376706]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[Calculation_1241586170674466819]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[Calculation_1241586170674466819]) - 1&#13;&#10;end' />
  </column>
  <column caption='updated_to' datatype='date' name='[Calculation_1241586170674466819]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MAX([report_date])}' />
  </column>
  <column caption='mtd report_date' datatype='integer' name='[Calculation_1241586170674565124]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
  </column>
  <column caption='mtd updated_date' datatype='integer' name='[Calculation_1241586170674651141]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [Calculation_1241586170674466819])' />
  </column>
  <column caption='datetrunc report_date' datatype='date' name='[Calculation_1241586170674737158]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
  </column>
  <column caption='datename(2) report_date' datatype='string' name='[Calculation_1241586170674847751]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#13;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#13;&#10;else str(year([Calculation_1241586170674737158]))&#13;&#10;end' />
  </column>
  <column caption='datename report_date' datatype='string' name='[Calculation_1241586170674933768]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#13;&#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#13;&#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#13;&#10;str([Calculation_1241586170674737158])&#13;&#10;end' />
  </column>
  <column caption='datefilter report_date' datatype='boolean' name='[Calculation_1241586170675007497]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#13;&#10;then [Calculation_1241586170675048458] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_1241586170675048458] &gt;= [Parameters].[Parameter 2]&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#13;&#10;then [Calculation_1241586170674565124] &lt;= [Calculation_1241586170674651141] and [Calculation_1241586170675048458] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_1241586170675048458] &gt;= [Parameters].[Parameter 2]&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#13;&#10;then [Calculation_1241586170674286593] &lt;= [Calculation_1241586170674376706] and [Calculation_1241586170675048458] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_1241586170675048458] &gt;= [Parameters].[Parameter 2]&#13;&#10;end' />
  </column>
  <column caption='datediff report_date' datatype='integer' name='[Calculation_1241586170675048458]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#13;&#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_1241586170674466819])&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then DATEDIFF(&apos;iso-week&apos;,[report_date], [Calculation_1241586170674466819])&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#13;&#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_1241586170674466819])&#13;&#10;end' />
  </column>
  <column caption='updated_from' datatype='date' name='[Calculation_134826522761351169]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MIN([report_date])}' />
  </column>
  <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
    <calculation class='tableau' formula='1' />
  </column>
