  <aliases enabled='yes' />
  <column caption='main_kpi' datatype='real' name='[Calculation_4127971308843462663]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='zn(&#10;CASE [Parameters].[Parameter 1]&#10;WHEN &apos;orders&apos; THEN ROUND(SUM([num_of_valid_orders]),0)&#10;WHEN &apos;GFV&apos; THEN ROUND(SUM([gfv_local]),1)&#10;WHEN &apos;sku&apos; THEN ROUND(AVG([num_of_product]),0)&#10;WHEN &apos;active sku&apos; THEN ROUND(AVG([num_of_active_product]),0)&#10;WHEN &apos;AFV&apos; THEN ROUND(SUM([gfv_local])/SUM([num_of_valid_orders]),1)&#10;WHEN &apos;organic order %&apos; THEN ROUND((SUM([num_of_organic_orders])/SUM([num_of_valid_orders])),3)&#10;WHEN &apos;ABS&apos; THEN ROUND(SUM([num_of_valid_ordered_quantity])/SUM([num_of_valid_orders]),1)&#10;WHEN &apos;voucher cost&apos; THEN ROUND((SUM([own_voucher_local])+SUM([vendor_voucher_local])),1)&#10;WHEN &apos;incentive&apos; THEN ROUND(SUM([own_voucher_local]+[vendor_voucher_local]+[own_discount_local]+[vendor_discount_local]),1)&#10;WHEN &apos;icpGMV %&apos; THEN ROUND((SUM([incentive_cost_fp_marketing_local])/SUM([gmv_local])),3)&#10;WHEN &apos;offline hours %&apos; THEN ROUND(SUM([total_closed_mins])/SUM([total_scheduled_open_mins]),3)&#10;WHEN &apos;vendor failed rate %&apos; THEN ROUND(SUM([num_of_failed_vendor_orders])/SUM([num_of_orders]),3)&#10;WHEN &apos;partial order rate %&apos; THEN ROUND(SUM([num_of_partially_fulfilled_orders])/SUM(num_of_valid_orders),3)&#10;WHEN &apos;OOS rate %&apos; THEN ROUND((SUM([num_of_partially_fulfilled_orders]) + SUM([num_of_failed_vendor_product_unavailable_orders]))/(SUM([num_of_valid_orders]) + SUM([num_of_failed_vendor_product_unavailable_orders])),3)&#10;WHEN &apos;OOS Qty rate %&apos; THEN ROUND((SUM([num_of_valid_ordered_quantity]+[num_of_failed_vendor_product_unavailable_ordered_quantity])-SUM([num_of_valid_delivered_quantity]+[num_of_failed_vendor_product_unavailable_delivered_quantity]))/(SUM([num_of_valid_ordered_quantity]+[num_of_failed_vendor_product_unavailable_ordered_quantity])),3)&#10;END&#10;)' />
  </column>
  <column caption='datename report_date' datatype='string' name='[Calculation_4127971308886159371]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 2], &apos;(month)|(mtd)&apos;) THEN &#10;LEFT(DATENAME(&apos;month&apos;, [report_date]),3)&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 2], &apos;(week)|(wtd)&apos;) THEN &#10;&apos;Week&apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;day&apos; THEN&#10;STR([report_date])&#10;END' />
  </column>
  <column caption='datetrunc report_date' datatype='date' name='[Calculation_4127971309110255629]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 2], &apos;(month)|(mtd)&apos;)&#10;THEN DATE(DATETRUNC(&apos;month&apos;, [report_date]))&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 2], &apos;(week)|(wtd)&apos;)&#10;THEN DATE(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#10;ELSE DATE(DATETRUNC(&apos;day&apos;, [report_date]))&#10;END' />
  </column>
  <column caption='datename(2) report_date' datatype='string' name='[Calculation_4127971309112287247]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;day&apos;&#10;THEN LEFT(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;ELSE STR(year([Calculation_4127971309110255629]))&#10;END' />
  </column>
  <column caption='%diff main_kpi' datatype='real' name='[Calculation_4127971309121826835]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(ZN([Calculation_4127971308843462663]) - LOOKUP(ZN([Calculation_4127971308843462663]), [Parameters].[Parameter 3])) &#10;/ ABS(LOOKUP(ZN([Calculation_4127971308843462663]), [Parameters].[Parameter 3]))'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='color main_kpi' datatype='integer' name='[Calculation_4127971309122199572]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='RANK([Calculation_4127971309121826835], &apos;asc&apos;)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='updated_date' datatype='date' name='[Calculation_4127971309131603991]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MAX([report_date])}' />
  </column>
  <column caption='datediff report_date' datatype='integer' name='[Calculation_4127971309132038168]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 2], &apos;(month)|(mtd)&apos;) &#10;THEN DATEDIFF(&apos;month&apos;,[report_date], [Calculation_4127971309131603991])&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 2], &apos;(week)|(wtd)&apos;)&#10;THEN DATEDIFF(&apos;iso-week&apos;,[report_date], [Calculation_4127971309131603991])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;day&apos; &#10;THEN DATEDIFF(&apos;day&apos;,[report_date], [Calculation_4127971309131603991])&#10;END' />
  </column>
  <column caption='datefilter report_date' datatype='boolean' name='[Calculation_4127971309132472345]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[Calculation_4127971309132038168] &lt;= 12+[Parameters].[Parameter 4] and [Calculation_4127971309132038168] &gt;= [Parameters].[Parameter 4]' />
  </column>
  <column caption='display main_kpi' datatype='real' name='[Calculation_4127971309143580698]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;Rate|Share|%&apos;) THEN round([Calculation_4127971308843462663]*100,2)&#10;ELSE [Calculation_4127971308843462663]&#10;END' />
  </column>
  <column caption='display unit' datatype='string' name='[Calculation_4127971309144137755]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;Rate|Share|%&apos;) then &apos;%&apos;&#10;ELSE &apos;&apos;&#10;END' />
  </column>
  <column caption='Row' datatype='string' name='[Calculation_4127971309209067551]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &apos;brand&apos; THEN [parent_account_name]&#10;    WHEN &apos;vertical&apos; THEN [vertical_type]&#10;    WHEN &apos;vendor name&apos; THEN [vendor_name]&#10;END' />
  </column>
