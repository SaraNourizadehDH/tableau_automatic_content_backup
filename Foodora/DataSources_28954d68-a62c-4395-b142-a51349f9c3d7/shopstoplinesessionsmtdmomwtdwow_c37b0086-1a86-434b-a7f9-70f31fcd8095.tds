  <aliases enabled='yes' />
  <column caption='period rename' datatype='string' name='[Calculation_1322650975364890624]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [period] = &quot;okr&quot;&#10;THEN &quot;OKR&quot;&#10;ELSEIF [period] = &quot;last_okr&quot;&#10;THEN &quot;Last OKR&quot;&#10;ELSEIF [period] = &quot;diff&quot;&#10;THEN &quot;Diff.&quot;&#10;END' />
  </column>
  <column caption='vertical + brand' datatype='string' name='[Calculation_1322650975370661889]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[vertical_type] + [brand_name]' />
  </column>
  <column caption='datename' datatype='string' name='[Calculation_2750432792587415554]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [weekly_monthly] = &quot;Monthly&quot;&#10;THEN REPLACE(LEFT(STR(DATETRUNC(&quot;month&quot;, [report_week_month])), 7), &quot; &quot;, &quot;-&quot;)&#10;ELSEIF weekly_monthly = &quot;Weekly&quot;&#10;THEN STR(YEAR([report_week_month])) + &quot; W&quot; + DATENAME(&quot;week&quot;, [report_week_month])&#10;END' />
  </column>
  <column caption='Time Aggregation' datatype='string' name='[Calculation_2750432792589627395]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [time_filter]&#10;  WHEN &quot;WTD&quot; THEN &quot;Wtd / Mtd&quot;&#10;  WHEN &quot;WoW&quot; THEN &quot;WoW / MoM&quot;&#10;  WHEN &quot;MTD&quot; THEN &quot;Wtd / Mtd&quot;&#10;  WHEN &quot;MoM&quot; THEN &quot;WoW / MoM&quot;&#10;END' />
  </column>
  <column caption='metrics alias' datatype='string' name='[Calculation_3330130509530796033]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [metrics] = &quot;valid_orders&quot; THEN &quot;Orders&quot;&#10;ELSEIF [metrics] = &quot;gmv&quot; THEN &quot;GMV&quot;&#10;ELSEIF [metrics] = &quot;gfv&quot; THEN &quot;GFV&quot;&#10;ELSEIF [metrics] = &quot;&quot; THEN &quot;GFV&quot;&#10;ELSEIF [metrics] = &quot;avg_basket_value&quot; THEN &quot;AFV&quot;&#10;ELSEIF [metrics] = &quot;commission_revenue&quot; THEN &quot;Comm.&quot;&#10;ELSEIF [metrics] = &quot;avg_basket_size&quot; THEN &quot;ABS&quot;&#10;ELSEIF [metrics] = &quot;avg_basket_product&quot; THEN &quot;ABP&quot;&#10;ELSEIF [metrics] = &quot;total_customer&quot; THEN &quot;TC&quot;&#10;ELSEIF [metrics] = &quot;new_to_shops_customers&quot; THEN &quot;NC&quot;&#10;ELSEIF [metrics] = &quot;existing_customers&quot; THEN &quot;EC&quot;&#10;ELSEIF [metrics] = &quot;order_frequency&quot; THEN &quot;Order Freq.&quot;&#10;ELSEIF [metrics] = &quot;icpgmv&quot; THEN &quot;icpGMV&quot;&#10;ELSEIF [metrics] = &quot;icpo&quot; THEN &quot;icpO&quot;&#10;ELSEIF [metrics] = &quot;organic_order_share&quot; THEN &quot;Orgnic Order %&quot;&#10;ELSEIF [metrics] = &quot;organic_afv&quot; THEN &quot;Organic AFV&quot;&#10;ELSEIF [metrics] = &quot;incentivized_afv&quot; THEN &quot;Incentivized AFV&quot;&#10;ELSEIF [metrics] = &quot;pro_afv&quot; THEN &quot;Pro AFV&quot;&#10;ELSEIF [metrics] = &quot;non_pro_afv&quot; THEN &quot;Non-Pro AFV&quot;&#10;ELSEIF [metrics] = &quot;reorder_rate_30d&quot; THEN &quot;Reorder % - 30d&quot;&#10;ELSEIF [metrics] = &quot;partial_order_rate&quot; THEN &quot;POR&quot;&#10;ELSEIF [metrics] = &quot;vendor_failed_rate&quot; THEN &quot;VFR&quot;&#10;ELSEIF [metrics] = &quot;valid_orders_share&quot; THEN &quot;Platform Order Share&quot;&#10;ELSEIF [metrics] = &quot;gmv_share&quot; THEN &quot;Platform GMV Share&quot;&#10;ELSEIF [metrics] = &quot;pro_order_share&quot; THEN &quot;Pro Order %&quot;&#10;ELSEIF [metrics] = &quot;shops_valid_orders_share&quot; THEN &quot;Shops Order Share&quot;&#10;ELSEIF [metrics] = &quot;shops_gmv_share&quot; THEN &quot;Shops GMV Share&quot;&#10;END' />
  </column>
  <column caption='action column' datatype='string' name='[Calculation_6324883522905673728]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [vertical + brand Set]&#10;THEN [Calculation_1322650975364890624]&#10;ELSE &quot; &quot;&#10;END' />
  </column>
  <column caption='show only brand layer' datatype='boolean' name='[Calculation_6324883522909261826]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Calculation_6324883522905673728] = &quot; &quot;&#10;THEN [period] = &quot;okr&quot;&#10;ELSEIF [Calculation_6324883522905673728] != &quot; &quot;&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
  </column>
  <column caption='value_display' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6324883523866853380]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF &#10;  REGEXP_MATCH([period], &quot;diff&quot;) THEN value * 100&#10;ELSEIF &#10;  REGEXP_MATCH([period], &quot;okr&quot;) AND REGEXP_MATCH([metrics], &quot;rate|icpgmv|share|cvr|CVR&quot;) THEN value * 100&#10;ELSE [value]&#10;END' />
  </column>
  <column caption='display_unit' datatype='string' name='[Calculation_6324883523869376518]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF &#10;  REGEXP_MATCH([period], &quot;diff&quot;) THEN &quot;%&quot;&#10;ELSEIF &#10;  REGEXP_MATCH([period], &quot;okr&quot;) AND REGEXP_MATCH([metrics], &quot;rate|icpgmv|share|cvr|CVR&quot;) THEN &quot;%&quot;&#10;END' />
  </column>
