  <column caption='gantt_timeslot' datatype='string' name='[Calculation_2411255423127760896]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='str(DATEPART(&apos;hour&apos;, [start_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;minute&apos;, [start_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;second&apos;, [start_at_local]))+&apos; ~ &apos;+&#10;str(DATEPART(&apos;hour&apos;, [end_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;minute&apos;, [end_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;second&apos;, [end_at_local]))' />
  </column>
  <column caption='gantt_x_axis' datatype='datetime' datatype-customized='true' name='[Calculation_2411255423127965697]' role='dimension' type='quantitative'>
    <calculation class='tableau' formula='MAKETIME(&#10;DATEPART(&apos;hour&apos;, [start_at_local]),&#10;DATEPART(&apos;minute&apos;, [start_at_local]),&#10;DATEPART(&apos;second&apos;, [start_at_local])&#10;)' />
  </column>
  <column caption='toggled city_name' datatype='string' name='[Calculation_2411255423128301570]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF  [Parameters].[Parameter 4] THEN &quot;Total&quot;&#10;ELSE [city_name]&#10;END' />
  </column>
  <column caption='operating_mins_adj' datatype='real' name='[Calculation_5493687875095764995]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [city_name],[zone_name],[report_date],[hour]:&#10;MAX([operating_mins])&#10;}' />
  </column>
  <column caption='shrink_event_mins' datatype='real' name='[Calculation_5493687875095891972]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [event_action] = &apos;shrink&apos; then [event_duration]&#10;END' />
  </column>
  <column caption='close_rate' datatype='real' name='[Calculation_5493687875096592390]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(&#10;if [event_action] = &apos;close&apos; then [event_duration] end &#10;)/SUM([Calculation_5493687875095764995])' />
  </column>
  <column caption='shrink_1st_rate' datatype='real' name='[Calculation_5493687875099791371]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(if [event_action_adj] = &apos;shrink - 1st&apos; then [event_duration] &#10;end)&#10;/SUM([Calculation_5493687875095764995])' />
  </column>
  <column caption='shrink_rate' datatype='real' name='[Calculation_5493687875100282892]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([Calculation_5493687875095891972])/SUM([Calculation_5493687875095764995])' />
  </column>
  <column caption='mtd updated_date' datatype='integer' name='[Calculation_5493687875100741645]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date (copy)])' />
  </column>
  <column caption='datediff report_date' datatype='integer' name='[Calculation_5493687875101691919]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [updated from (copy)_1536290430262157312])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;iso-week&apos;,[report_date], [updated from (copy)_1536290430262157312])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [updated from (copy)_1536290430262157312])&#10;end' />
  </column>
  <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
    <calculation class='tableau' formula='1' />
  </column>
  <_.fcp.ObjectModelTableType.true...column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
  <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
  <column caption='close_affected_orders_lost' datatype='real' name='[close_affected_orders_rate (copy)_572238636449222661]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(&#10;if [event_action] = &apos;close&apos; then ([event_duration]/[operating_mins]*[orders_expected]) &#13;&#10;end)' />
  </column>
  <column caption='close_affected_orders_rate' datatype='real' name='[close_rate (copy)_572238636434128898]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(&#10;if [event_action] = &apos;close&apos; then ([event_duration]/[operating_mins]*[orders_expected]) &#13;&#10;end)&#13;&#10;/SUM([operating_mins_adj (copy)_1707145742522433536])' />
  </column>
  <column caption='datename report_date' datatype='string' name='[datediff report_date (copy 2)]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#10;str([datediff report_date (copy 3)])&#10;end' />
  </column>
  <column caption='datetrunc report_date' datatype='date' name='[datediff report_date (copy 3)]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#10;end' />
  </column>
  <column caption='datefilterreport_date' datatype='boolean' name='[datediff report_date (copy)]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#10;then [Calculation_5493687875101691919] &lt;= 12+ [Parameters].[Parameter 2] and [Calculation_5493687875101691919] &gt;= [Parameters].[Parameter 2]&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [mtd updated_date (copy)] &lt;= [Calculation_5493687875100741645] and [Calculation_5493687875101691919] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_5493687875101691919] &gt;= [Parameters].[Parameter 2]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [mtd report_date (copy)] &lt;= [wtd report_date (copy)] and [Calculation_5493687875101691919] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_5493687875101691919] &gt;= [Parameters].[Parameter 2]&#10;end' />
  </column>
  <column caption='datename(2) report_date' datatype='string' name='[datename report_date (copy)]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;else str(year([datediff report_date (copy 3)]))&#10;end' />
  </column>
  <column aggregation='Sum' datatype='integer' name='[lg_transaction_id]' role='dimension' type='ordinal' />
  <column caption='wtd report_date' datatype='integer' name='[mtd report_date (copy)]' role='dimension' type='ordinal'>
