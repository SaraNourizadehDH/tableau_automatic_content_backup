  <column caption='updated_date' datatype='date' name='[Calculation_3886113912828583936]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MAX([report_date])}' />
  </column>
  <column caption='wtd report_date' datatype='integer' name='[Calculation_3886113912828940289]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;else DATEPART(&apos;weekday&apos;,[report_date]) -1&#10;END' />
  </column>
  <column caption='mtd report_date' datatype='integer' name='[Calculation_3886113912830406658]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
  </column>
  <column caption='datetrunc report_date' datatype='date' name='[Calculation_3886113912831004675]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(mtd)&apos;)&#10;then date(datetrunc(&apos;month&apos;,[report_date]))&#10;elseif REGEXP_MATCH([Parameters].[Parameter 3],&apos;(week)|(wtd)&apos;)&#10;then date(DATETRUNC(&apos;iso-week&apos;,[report_date]))&#10;else date(DATETRUNC(&apos;day&apos;,[report_date]))&#10;end' />
  </column>
  <column caption='datename report_date' datatype='string' name='[Calculation_3886113912834519044]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(mtd)&apos;) then &#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;elseif REGEXP_MATCH([Parameters].[Parameter 3], &apos;(week)|(wtd)&apos;) then &#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;elseif [Parameters].[Parameter 3] = &apos;day&apos; then&#10;str([Calculation_3886113912831004675])&#10;end' />
  </column>
  <column caption='datename(2) report_date' datatype='string' name='[Calculation_3886113912835129349]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;day&apos;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;else str(year([Calculation_3886113912831004675]))&#10;end' />
  </column>
  <column caption='datediff report_date' datatype='integer' name='[Calculation_3886113912835342342]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_3886113912828583936])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 3], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;week&apos;,[report_date], [Calculation_3886113912828583936])&#10;elseif [Parameters].[Parameter 3] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_3886113912828583936])&#10;end' />
  </column>
  <column caption='datefilter report_date' datatype='boolean' name='[Calculation_3886113912835493895]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 3], &apos;(month)|(week)|(day)&apos;)&#10;then [Calculation_3886113912835342342] &lt;= 12+[Parameters].[Parameter 4] and [Calculation_3886113912835342342] &gt;= [Parameters].[Parameter 4]&#10;elseif [Parameters].[Parameter 3] = &apos;mtd&apos;&#10;then [Calculation_3886113912830406658] &lt;= [mtd report_date (copy)] and [Calculation_3886113912835342342] &lt;= 12+[Parameters].[Parameter 4] and [Calculation_3886113912835342342] &gt;= [Parameters].[Parameter 4]&#10;elseif [Parameters].[Parameter 3] = &apos;wtd&apos;&#10;then [Calculation_3886113912828940289] &lt;= [wtd report_date (copy)] and [Calculation_3886113912835342342] &lt;= 12+[Parameters].[Parameter 4] and [Calculation_3886113912835342342] &gt;= [Parameters].[Parameter 4]&#10;end' />
  </column>
  <column caption='orders' datatype='integer' name='[Calculation_6834282839042854913]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ZN(SUM([gross_order_count]))' />
  </column>
  <column caption='main_kpi' datatype='real' name='[Calculation_6834282839044456450]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ZN(&#10;CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN CASE [Parameters].[Parameter 2]&#10;                        WHEN &apos;Ticket Counts&apos; THEN [Calculation_6834282839045472259]&#10;                        WHEN &apos;Incident Rate&apos; THEN ([Calculation_6834282839045472259]/[Calculation_6834282839042854913])&#10;                        WHEN &apos;Riders with Ticket&apos; THEN SUM([total_riders_with_ticket])&#10;                    END&#10;    WHEN &apos;Delivery instructions not followed&apos; THEN CASE [Parameters].[Parameter 2]&#10;                        WHEN &apos;Ticket Counts&apos; THEN SUM([ticket_counts_delivery_instructions_not_followed])&#10;                        WHEN &apos;Incident Rate&apos; THEN (SUM([ticket_counts_delivery_instructions_not_followed])/[Calculation_6834282839042854913])&#10;                        WHEN &apos;Riders with Ticket&apos; THEN SUM([rider_counts_delivery_instructions_not_followed])&#10;                    END&#10;    WHEN &apos;Inappropriate behaviour&apos; THEN CASE [Parameters].[Parameter 2]&#10;                        WHEN &apos;Ticket Counts&apos; THEN SUM([ticket_counts_inappropriate_behaviour])&#10;                        WHEN &apos;Incident Rate&apos; THEN (SUM([ticket_counts_inappropriate_behaviour])/[Calculation_6834282839042854913])&#10;                        WHEN &apos;Riders with Ticket&apos; THEN SUM([rider_counts_inappropriate_behaviour])&#10;                    END&#10;    WHEN &apos;Money collection issue&apos; THEN CASE [Parameters].[Parameter 2]&#10;                        WHEN &apos;Ticket Counts&apos; THEN SUM([ticket_counts_money_collection_issue])&#10;                        WHEN &apos;Incident Rate&apos; THEN (SUM([ticket_counts_money_collection_issue])/[Calculation_6834282839042854913])&#10;                        WHEN &apos;Riders with Ticket&apos; THEN SUM([rider_counts_money_collection_issue])&#10;                    END&#10;    WHEN &apos;Order not delivered to doorstep&apos; THEN CASE [Parameters].[Parameter 2]&#10;                        WHEN &apos;Ticket Counts&apos; THEN SUM([ticket_counts_order_not_delivered_to_doorstep])&#10;                        WHEN &apos;Incident Rate&apos; THEN (SUM([ticket_counts_order_not_delivered_to_doorstep])/[Calculation_6834282839042854913])&#10;                        WHEN &apos;Riders with Ticket&apos; THEN SUM([rider_counts_order_not_delivered_to_doorstep])&#10;                    END&#10;    WHEN &apos;Missing equipment/uniform&apos; THEN CASE [Parameters].[Parameter 2]&#10;                        WHEN &apos;Ticket Counts&apos; THEN SUM([ticket_counts_missing_equipment_uniform])&#10;                        WHEN &apos;Incident Rate&apos; THEN (SUM([ticket_counts_missing_equipment_uniform])/[Calculation_6834282839042854913])&#10;                        WHEN &apos;Riders with Ticket&apos; THEN SUM([rider_counts_missing_equipment_uniform])&#10;                    END&#10;END&#10;)' />
  </column>
  <column caption='all_ticket_counts' datatype='integer' name='[Calculation_6834282839045472259]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ZN(&#10;SUM([ticket_counts_delivery_instructions_not_followed])+&#10;SUM([ticket_counts_inappropriate_behaviour])+&#10;SUM([ticket_counts_missing_equipment_uniform])+&#10;SUM([ticket_counts_money_collection_issue])+&#10;SUM([ticket_counts_order_not_delivered_to_doorstep])&#10;)' />
  </column>
  <column caption='display_main_kpi' datatype='string' datatype-customized='true' name='[Calculation_6834282839056596996]' role='measure' type='nominal'>
    <calculation class='tableau' formula='str(&#10;if REGEXP_MATCH([Parameters].[Parameter 2], &apos;Rate&apos;) then round([Calculation_6834282839044456450]*100,4)&#10;else round([Calculation_6834282839044456450],0)&#10;end&#10;)' />
  </column>
  <column caption='display_unit' datatype='string' name='[Calculation_6834282839058948101]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 2], &apos;Rate&apos;) THEN &apos;%&apos;&#10;ELSE &apos;&apos;&#10;END' />
  </column>
  <column caption='filter_report_date' datatype='boolean' name='[Calculation_6909014427767042049]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[report_date] &lt; TODAY()' />
  </column>
  <column caption='color main_kpi' datatype='integer' name='[Calculation_7145101589521358848]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='rank([Calculation_6834282839044456450], &apos;desc&apos;)'>
      <table-calc ordering-type='Rows' />
    </calculation>
