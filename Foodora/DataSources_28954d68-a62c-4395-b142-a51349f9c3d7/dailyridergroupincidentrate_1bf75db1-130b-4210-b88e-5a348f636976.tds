  <column caption='%diff main_kpi' datatype='real' name='[Calculation_2749236509494554624]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(ZN([Calculation_6834282839044456450]) - LOOKUP(ZN([Calculation_6834282839044456450]), [Parameters].[Parameter 3 1])) &#10;/ ABS(LOOKUP(ZN([Calculation_6834282839044456450]), [Parameters].[Parameter 3 1]))'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='-%diff main_kpi' datatype='real' name='[Calculation_2749236509494792193]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_2749236509494554624] &lt;= 0 then&#10;[Calculation_2749236509494554624]&#10;end'>
