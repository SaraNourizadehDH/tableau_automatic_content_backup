  <column caption='+%diff main_kpi' datatype='real' name='[Calculation_2749236509495132162]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if [Calculation_2749236509494554624] &gt; 0 then&#10;[Calculation_2749236509494554624]&#10;end'>
