  <column caption='updated_date' datatype='date' name='[Calculation_1261852366473232386]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{MAX([report_date])}' />
  </column>
  <column caption='datetrunc report_date' datatype='date' name='[Calculation_1261852366473306115]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
  </column>
  <column caption='wtd report_date' datatype='integer' name='[Calculation_1261852366473379844]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[report_date]) - 1&#13;&#10;end' />
  </column>
  <column caption='wtd updated_date' datatype='integer' name='[Calculation_1261852366473449477]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[Calculation_1261852366473232386]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[Calculation_1261852366473232386]) - 1&#13;&#10;end' />
  </column>
  <column caption='mtd report_date' datatype='integer' name='[Calculation_1261852366473547782]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
  </column>
  <column caption='mtd updated_date' datatype='integer' name='[Calculation_1261852366473588743]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [Calculation_1261852366473232386])' />
  </column>
  <column caption='datediff report_date' datatype='integer' name='[Calculation_1261852366473781257]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#13;&#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_1261852366473232386])&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then DATEDIFF(&apos;iso-week&apos;,[report_date], [Calculation_1261852366473232386])&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#13;&#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_1261852366473232386])&#13;&#10;end' />
  </column>
  <column caption='datefilter report_date' datatype='boolean' name='[Calculation_1261852366473842698]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#13;&#10;then TRUE&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#13;&#10;then [Calculation_1261852366473547782] &lt;= [Calculation_1261852366473588743]&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#13;&#10;then [Calculation_1261852366473379844] &lt;= [Calculation_1261852366473449477]&#13;&#10;end' />
  </column>
  <column caption='datename(2) report_date' datatype='string' name='[Calculation_1261852366473904139]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#13;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#13;&#10;else str(year([Calculation_1261852366473306115]))&#13;&#10;end' />
  </column>
  <column caption='datename report_date' datatype='string' name='[Calculation_1261852366474874893]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#13;&#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#13;&#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#13;&#10;str([Calculation_1261852366473306115])&#13;&#10;end' />
  </column>
