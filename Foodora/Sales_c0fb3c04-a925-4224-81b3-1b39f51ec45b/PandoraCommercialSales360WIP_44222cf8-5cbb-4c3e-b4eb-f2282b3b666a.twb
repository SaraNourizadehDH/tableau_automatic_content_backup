    lao.account_status,
    DATE_DIFF(report_date, lead_created_date_utc, DAY) AS lead_age
  FROM `fulfillment-dwh-production.pandata_report.sales_apac_golive_sales_leads_backlog` bg
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` c USING(global_entity_id)
  LEFT JOIN lao USING(sf_lead_id)
  WHERE report_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
  AND vendor_type = 'Restaurants'
)

SELECT 
    DATE_TRUNC(report_date, MONTH) AS report_month,
    global_entity_id,
    region,
    country,
    vendor_type,
    vendor_grade,
    user_type,
    city,
    zone_name,
    account_status,
    
    -- Total backlog metrics
    COUNT(DISTINCT sf_lead_id) AS backlog_lead,
    SUM(lead_age) AS lead_age_sum,
    AVG(lead_age) AS average_lead_age,

    COUNT(DISTINCT IF(lead_age << 10, sf_lead_id, NULL)) AS lead_count_under_10d,    -- Backlog leads by source
    COUNT(DISTINCT IF(lead_age << 10 AND lead_source = "Inbound_leads", sf_lead_id, NULL)) AS backlog_inbound_lead_under_10d,
    COUNT(DISTINCT IF(lead_age << 10 AND lead_source = "Import_leads", sf_lead_id, NULL)) AS backlog_import_lead_under_10d,
    COUNT(DISTINCT IF(lead_age << 10 AND lead_source = "Own_research_leads", sf_lead_id, NULL)) AS backlog_own_research_lead_under_10d,
    COUNT(DISTINCT IF(lead_age << 10 AND lead_source = "automated_leadgen_leads", sf_lead_id, NULL)) AS backlog_automated_leadgen_lead_under_10d,
    COUNT(DISTINCT IF(lead_age << 10 AND lead_source = "Self_Sign_Up_leads", sf_lead_id, NULL)) AS backlog_self_sign_up_lead_under_10d,
    COUNT(DISTINCT IF(lead_source = "Inbound_leads", sf_lead_id, NULL)) AS backlog_inbound_lead,
    COUNT(DISTINCT IF(lead_source = "Import_leads", sf_lead_id, NULL)) AS backlog_import_lead,
    COUNT(DISTINCT IF(lead_source = "Own_research_leads", sf_lead_id, NULL)) AS backlog_own_research_lead,
    COUNT(DISTINCT IF(lead_source = "automated_leadgen_leads", sf_lead_id, NULL)) AS backlog_automated_leadgen_lead,
    COUNT(DISTINCT IF(lead_source = "Self_Sign_Up_leads", sf_lead_id, NULL)) AS backlog_self_sign_up_lead
FROM base
GROUP BY ALL
ORDER BY report_month DESC, global_entity_id, region, country]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
