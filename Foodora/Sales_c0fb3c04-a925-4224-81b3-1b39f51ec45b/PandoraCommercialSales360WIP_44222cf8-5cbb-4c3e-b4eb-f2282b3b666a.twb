          <datasource-dependencies datasource='federated.09setzf0m7qe1518yahvf0revbw4'>
            <column caption='% Converted Lead To Account' datatype='real' name='[Calculation_6171198141507067905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_lead_by_converted_date])/SUM([total_new_leads])' />
            </column>
            <column caption='% Inbound Converted' datatype='real' name='[Calculation_6171198141509476354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_inbound_lead])/SUM([total_new_leads])' />
            </column>
            <column caption='% Import Converted' datatype='real' name='[Calculation_6171198141509652483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_import_lead])/SUM([total_new_leads])' />
            </column>
            <column caption='% Own Research Converted' datatype='real' name='[Calculation_6171198141509824516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_own_research_lead])/SUM([total_new_leads])' />
