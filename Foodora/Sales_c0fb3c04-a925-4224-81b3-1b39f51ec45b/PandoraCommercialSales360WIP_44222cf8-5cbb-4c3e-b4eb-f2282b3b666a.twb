    <worksheet name='total new leads (trend)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Total New Leads</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='12'><![CDATA[MTD <[federated.09setzf0m7qe1518yahvf0revbw4].[sum:Calculation_975170071878778884:qk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lead gen + conversion' name='federated.09setzf0m7qe1518yahvf0revbw4' />
          </datasources>
          <datasource-dependencies datasource='federated.09setzf0m7qe1518yahvf0revbw4'>
            <column caption='MTD Total new leads' datatype='integer' name='[Calculation_975170071878778884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;    YEAR([report_month]) = YEAR(TODAY()) &#10;    AND [report_month] &lt;= TODAY()&#10;    AND MONTH([report_month]) = MONTH(TODAY())&#10;THEN &#10;   [total_new_leads]&#10;END' />
            </column>
