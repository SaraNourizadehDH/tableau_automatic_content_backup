leadGen_metrics AS (
SELECT 
    DATE_TRUNC(lead_created_date_utc, MONTH) AS report_month,
    global_entity_id,
    region,
    country,
    user_type,
    vendor_grade,
    city,
    zone_name,
    COUNT(DISTINCT sf_lead_id) AS total_new_leads,
    COUNT(DISTINCT IF(lead_status IN (&quot;Lost&quot;), sf_lead_id, NULL)) AS lost_lead,
    COUNT(DISTINCT IF(lead_worked_on_date IS NOT NULL, sf_lead_id, NULL)) AS lead_worked_on,
    COUNT(DISTINCT IF(is_lead_converted, sf_lead_id, NULL)) AS converted_lead_by_creation_date,
    COUNT(DISTINCT IF(is_lead_converted, sf_account_id, NULL)) AS converted_account_by_creation_date,
    COUNT(DISTINCT IF( is_won AND is_closed, sf_opportunity_id , NULL)) AS opp_closed_won,
    -- Lead source metrics
    COUNT(DISTINCT IF(lead_source = &quot;Inbound_leads&quot;, sf_lead_id, NULL)) AS total_new_inbound_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Import_leads&quot;, sf_lead_id, NULL)) AS total_new_import_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Own_research_leads&quot;, sf_lead_id, NULL)) AS total_new_own_research_lead,
    COUNT(DISTINCT IF(lead_source = &quot;automated_leadgen_leads&quot;, sf_lead_id, NULL)) AS total_new_automated_leadgen_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Self_Sign_Up_leads&quot;, sf_lead_id, NULL)) AS total_new_self_sign_up_lead,
    -- Lost leads by source
    COUNT(DISTINCT IF(lead_source = &quot;Inbound_leads&quot; AND lead_status IN (&quot;Lost&quot;), sf_lead_id, NULL)) AS lost_inbound_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Import_leads&quot; AND lead_status IN (&quot;Lost&quot;), sf_lead_id, NULL)) AS lost_import_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Own_research_leads&quot; AND lead_status IN (&quot;Lost&quot;), sf_lead_id, NULL)) AS lost_own_research_lead,
    COUNT(DISTINCT IF(lead_source = &quot;automated_leadgen_leads&quot; AND lead_status IN (&quot;Lost&quot;), sf_lead_id, NULL)) AS lost_automated_leadgen_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Self_Sign_Up_leads&quot; AND lead_status IN (&quot;Lost&quot;), sf_lead_id, NULL)) AS lost_self_sign_up_lead,
    -- Worked on leads by source
    COUNT(DISTINCT IF(lead_source = &quot;Inbound_leads&quot; AND lead_worked_on_date IS NOT NULL, sf_lead_id, NULL)) AS worked_on_inbound_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Import_leads&quot; AND lead_worked_on_date IS NOT NULL, sf_lead_id, NULL)) AS worked_on_import_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Own_research_leads&quot; AND lead_worked_on_date IS NOT NULL, sf_lead_id, NULL)) AS worked_on_own_research_lead,
    COUNT(DISTINCT IF(lead_source = &quot;automated_leadgen_leads&quot; AND lead_worked_on_date IS NOT NULL, sf_lead_id, NULL)) AS worked_on_automated_leadgen_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Self_Sign_Up_leads&quot; AND lead_worked_on_date IS NOT NULL, sf_lead_id, NULL)) AS worked_on_self_sign_up_lead,
    -- Converted leads by source
    COUNT(DISTINCT IF(lead_source = &quot;Inbound_leads&quot; AND is_lead_converted, sf_lead_id, NULL)) AS converted_inbound_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Import_leads&quot; AND is_lead_converted, sf_lead_id, NULL)) AS converted_import_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Own_research_leads&quot; AND is_lead_converted, sf_lead_id, NULL)) AS converted_own_research_lead,
    COUNT(DISTINCT IF(lead_source = &quot;automated_leadgen_leads&quot; AND is_lead_converted, sf_lead_id, NULL)) AS converted_automated_leadgen_lead,
    COUNT(DISTINCT IF(lead_source = &quot;Self_Sign_Up_leads&quot; AND is_lead_converted, sf_lead_id, NULL)) AS converted_self_sign_up_lead,

    COUNT(DISTINCT IF(lead_source = &quot;Inbound_leads&quot; AND is_lead_converted, sf_account_id , NULL)) AS converted_inbound_lead_account,
    COUNT(DISTINCT IF(lead_source = &quot;Import_leads&quot; AND is_lead_converted, sf_account_id , NULL)) AS converted_import_lead_account,
    COUNT(DISTINCT IF(lead_source = &quot;Own_research_leads&quot; AND is_lead_converted, sf_account_id , NULL)) AS converted_own_research_lead_account,
    COUNT(DISTINCT IF(lead_source = &quot;automated_leadgen_leads&quot; AND is_lead_converted, sf_account_id , NULL)) AS converted_automated_leadgen_lead_account,
    COUNT(DISTINCT IF(lead_source = &quot;Self_Sign_Up_leads&quot; AND is_lead_converted,sf_account_id , NULL)) AS converted_self_sign_up_lead_account,

    COUNT(DISTINCT IF(lead_source = &quot;Inbound_leads&quot; AND is_won AND is_closed, sf_opportunity_id , NULL)) AS converted_inbound_lead_opp,
    COUNT(DISTINCT IF(lead_source = &quot;Import_leads&quot; AND is_won AND is_closed, sf_opportunity_id , NULL)) AS converted_import_lead_opp,
    COUNT(DISTINCT IF(lead_source = &quot;Own_research_leads&quot; AND is_won AND is_closed, sf_opportunity_id , NULL)) AS converted_own_research_lead_opp,
    COUNT(DISTINCT IF(lead_source = &quot;automated_leadgen_leads&quot; AND is_won AND is_closed, sf_opportunity_id , NULL)) AS converted_automated_leadgen_lead_opp,
    COUNT(DISTINCT IF(lead_source = &quot;Self_Sign_Up_leads&quot; AND is_won AND is_closed, sf_opportunity_id , NULL)) AS converted_self_sign_up_lead_opp

FROM base
 GROUP BY ALL
),

conversion_metrics AS (
  SELECT  
    DATE_TRUNC(lead_converted_date_local, MONTH) AS report_month,
    global_entity_id,
    region,
    country,
    user_type,
    vendor_grade,
    city,
    zone_name,
    COUNT(DISTINCT sf_lead_id) AS converted_lead_by_converted_date,
    COUNT(DISTINCT IF(lead_source = &quot;Inbound_leads&quot;, sf_lead_id, NULL)) AS converted_inbound_lead_by_converted_date,
    COUNT(DISTINCT IF(lead_source = &quot;Import_leads&quot;, sf_lead_id, NULL)) AS converted_import_lead_by_converted_date,
    COUNT(DISTINCT IF(lead_source = &quot;Own_research_leads&quot;, sf_lead_id, NULL)) AS converted_own_research_lead_by_converted_date,
    COUNT(DISTINCT IF(lead_source = &quot;automated_leadgen_leads&quot;, sf_lead_id, NULL)) AS converted_automated_leadgen_lead_by_converted_date,
    COUNT(DISTINCT IF(lead_source = &quot;Self_Sign_Up_leads&quot;, sf_lead_id, NULL)) AS converted_self_sign_up_lead_by_converted_date
  FROM base
  WHERE lead_converted_date_local IS NOT NULL
  GROUP BY ALL
)

SELECT
  COALESCE(lg.report_month, cm.report_month) AS report_month,
  COALESCE(lg.global_entity_id, cm.global_entity_id) AS global_entity_id,
  COALESCE(lg.region, cm.region) AS region,
  COALESCE(lg.country, cm.country) AS country,
  COALESCE(lg.user_type, cm.user_type, &quot;NA&quot;) AS user_type,
  COALESCE(lg.vendor_grade, cm.vendor_grade, &quot;NA&quot;) AS vendor_grade,
  COALESCE(lg.city, cm.city, &quot;NA&quot;) AS city,
  COALESCE(lg.zone_name, cm.zone_name, &quot;NA&quot;) AS zone_name,

  -- Lead generation metrics
  lg.total_new_leads,
  lg.lost_lead,
  lg.lead_worked_on,
  lg.converted_lead_by_creation_date,
  lg.converted_account_by_creation_date,
  lg.opp_closed_won,
  -- Lead source metrics
  lg.total_new_inbound_lead,
  lg.total_new_import_lead,
  lg.total_new_own_research_lead,
  lg.total_new_automated_leadgen_lead,
  lg.total_new_self_sign_up_lead,
  
  -- Lost leads by source
  lg.lost_inbound_lead,
  lg.lost_import_lead,
  lg.lost_own_research_lead,
  lg.lost_automated_leadgen_lead,
  lg.lost_self_sign_up_lead,
  
  -- Worked on leads by source
  lg.worked_on_inbound_lead,
  lg.worked_on_import_lead,
  lg.worked_on_own_research_lead,
  lg.worked_on_automated_leadgen_lead,
  lg.worked_on_self_sign_up_lead,
  
  -- Converted leads by source (creation date)
  lg.converted_inbound_lead,
  lg.converted_import_lead,
  lg.converted_own_research_lead,
  lg.converted_automated_leadgen_lead,
  lg.converted_self_sign_up_lead,


  --- acc &amp; opp

converted_inbound_lead_account,
converted_import_lead_account,
converted_own_research_lead_account,
converted_automated_leadgen_lead_account,
converted_self_sign_up_lead_account,
converted_inbound_lead_opp,
 converted_import_lead_opp,
converted_own_research_lead_opp,
converted_automated_leadgen_lead_opp,
converted_self_sign_up_lead_opp,
  
  -- Conversion metrics (conversion date)
  cm.converted_lead_by_converted_date,
  cm.converted_inbound_lead_by_converted_date,
  cm.converted_import_lead_by_converted_date,
  cm.converted_own_research_lead_by_converted_date,
  cm.converted_automated_leadgen_lead_by_converted_date,
  cm.converted_self_sign_up_lead_by_converted_date
  


FROM leadGen_metrics lg
FULL OUTER JOIN conversion_metrics cm
  ON lg.report_month = cm.report_month
  AND lg.global_entity_id = cm.global_entity_id
  AND lg.region = cm.region
  AND lg.country = cm.country
  AND lg.user_type = cm.user_type
  AND lg.vendor_grade = cm.vendor_grade
  AND lg.city = cm.city
  AND lg.zone_name = cm.zone_name</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>report_month</remote-name>
