        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[global_entity_id]' />
          <groupfilter function='union'>
            <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_KH&quot;' />
            <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_LA&quot;' />
            <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_MM&quot;' />
          </groupfilter>
