        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1nmvf3d1q520171a6j9tb0cvrtuo' name='Custom SQL Query' type='text'>#used for dashboard
WITH lead_table AS (
  SELECT  
    global_entity_id,
    grid__c,
    status,
    createdbyid, --NEED 
    createddate, --in UTC, NEED  
    converteddate AS lead_converted_date --NEED
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.lead` 
  WHERE 
    mark_for_testing_training__c = False
),

lead_acc_table AS (
  SELECT 
    lead_table.global_entity_id,
    lead_table.grid__c,
    acc_table.vertical__c, --NEED
    acc_table.id AS acc_id,
    lead_table.status,
    lead_table.createdbyid,
    lead_table.createddate, --in UTC, NEED  
    lead_table.lead_converted_date
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.account` AS acc_table
  INNER JOIN lead_table 
  ON lead_table.grid__c = acc_table.grid__c
  WHERE 
    acc_table.vertical__c IN (&apos;Restaurant&apos;)
    AND acc_table.mark_for_testing_training__c = False
    AND lead_table.createdbyid IN (&apos;0056900000AVz3YAAT&apos;, &apos;0056900000CRtp2AAD&apos;, &apos;0056900000BV0qnAAD&apos;, &apos;0056900000BUli5AAD&apos;, &apos;0056900000BSL0IAAX&apos;)
    AND lead_table.createddate &gt;&gt;= &apos;2023-01-01&apos;
    AND lead_table.status IN (&apos;Converted&apos;)
),

opp_lao AS (
  SELECT 
    lao.global_entity_id,
    lao.global_vendor_id, --grid__c
    opp_table.createddate AS opp_createddate,
    opp_table.leadsource, -- Getting leadsource directly from opp_table
    lao.vendor_grade, 
    lao.vertical_segment,
    lao.is_key_vip_account,
    lao.key_account_sub_category,
    lao.sf_lead_id,
    lao.lead_company_name,
    lao.is_lead_converted,
    lao.sf_account_id,
    lao.account_created_date_utc,
    opp_table.laststagechangedate AS opp_last_stage_change_date, 
    lao.account_history_sf_account_id,
    lao.account_history_sf_created_by_user_id,
    lao.sf_opportunity_id,
    lao.sf_opp_created_by_user_id,
    lao.central_job_role,
    lao.job_role_vertical,
    lao.user_type, 
    lao.sf_opportunity_owner_id,
    lao.opp_owner_title,
    lao.email_internal_non_pii,
    lao.is_user_active_snapshot,
    lao.opportunity_business_type,
    lao.opp_stage_name,
    lao.opp_created_date_utc,
    lao.is_successful_signup
  FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` AS lao 
  INNER JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` AS opp_table
  ON opp_table.id = lao.sf_opportunity_id
  WHERE lao.opp_stage_name NOT IN (&apos;Closed Won&apos;, &apos;Closed Lost&apos;)
    AND lao.opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)
), 

UniqueUserLayer AS (
  SELECT 
    full_name_internal_non_pii,
    sf_user_id,
    ROW_NUMBER() OVER (PARTITION BY full_name_internal_non_pii ORDER BY user_type) AS row_num
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer`
)

SELECT 
  opp_lao.*,
  lead_acc_table.acc_id,
  lead_acc_table.createddate AS lead_createddate,
  lead_acc_table.lead_converted_date,
  lead_acc_table.vertical__c,
  UniqueUserLayer.full_name_internal_non_pii
FROM opp_lao
INNER JOIN lead_acc_table
ON lead_acc_table.acc_id = opp_lao.sf_account_id
INNER JOIN UniqueUserLayer 
ON opp_lao.sf_opportunity_owner_id = UniqueUserLayer.sf_user_id
AND UniqueUserLayer.row_num = 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
