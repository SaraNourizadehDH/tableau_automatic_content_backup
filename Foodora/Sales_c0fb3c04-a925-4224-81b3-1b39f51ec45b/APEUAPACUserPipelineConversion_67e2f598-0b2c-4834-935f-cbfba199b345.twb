    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Discription/ Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APAPACUserPipelineConversion_17282939210300/DiscriptionMetricDefinitions?rev=' id='DiscriptionMetricDefinitions' path='/t/Foodora/workbooks/APAPACUserPipelineConversion_17282939210300' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_7' value='left' />
          <format attr='vertical-align' id='dash-text_7' value='center' />
        </style-rule>
      </style>
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='5' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='7161' id='4' type-v2='text' w='12006' x='586' y='1042'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='14'>Foodpanda</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f54a93' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='7161' id='3' type-v2='text' w='86822' x='12592' y='1042'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Description/ Metrics Definitions </run>
              <run fontalignment='1'>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone h='90755' id='6' param='vert' type-v2='layout-flow' w='98828' x='586' y='8203'>
            <zone fixed-size='657' forceUpdate='true' h='86589' id='7' is-fixed='true' type-v2='text' w='98828' x='586' y='8203'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='12'>Description: </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Dashboard - Average days of Ownership:  </run>
                <run fontcolor='#000000'>illustrates the average days of ownership of a opportunity that a  user has taken over in the pipeline </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Dashboard - Distinct Count of Ownership: </run>
                <run fontcolor='#000000'>illustrates the distinct count of opportunity that a user has processed in the pipeline </run>
                <run>Æ&#10;&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='12'>Metrics Definition: </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Days of ownerhsip: </run>
                <run fontcolor='#000000'>represents how many days the current owner holds the opportunity before passing it to another user or until the opportunity is closed </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Avg. days of ownership: </run>
                <run fontcolor='#000000'>the average of the sum of the time intervals between each ownership transfer, measured from the date of transfer from the previous owner to the current owner</run>
                <run>Æ&#10;&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' underline='true'>Data only show:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>lead created date on or after 2023-01-01; </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>leads created by id in &apos;0056900000AVz3YAAT&apos;, &apos;0056900000CRtp2AAD&apos;, &apos;0056900000BV0qnAAD&apos;, &apos;0056900000BUli5AAD&apos;, &apos;0056900000BSL0IAAX&apos;;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>lead status: converted ;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>business type in &apos;New Business&apos;, &apos;Win Back&apos;; </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>vertical: Restaurant</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>mark_for_testing_training__c: False </run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
