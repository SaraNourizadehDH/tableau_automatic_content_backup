      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2F638664F82B4AFEA826CE2637FDDD97'>
            <properties context=''>
              <relation connection='bigquery.0aw5zdy190hhms1ac5eik0oqlkjj' name='Custom SQL Query' type='text'>WITH lead_table AS (
  SELECT  
    lead.global_entity_id AS lead_global_entity_id,
    lead.grid__c,
    lead.status,
    lead.createdbyid, 
    lead.createddate,  
    lead.converteddate AS lead_converted_date 
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.lead` AS lead
  WHERE 
    lead.mark_for_testing_training__c = False
),

lead_acc_table AS (
  SELECT 
    lead_table.lead_global_entity_id,
    lead_table.grid__c,
    acc_table.vertical__c, 
    acc_table.id AS acc_id,
    lead_table.status,
    lead_table.createdbyid AS lead_createdbyid, 
    lead_table.createddate AS lead_createddate, 
    lead_table.lead_converted_date, 
    acc_table.self_setup__c
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.account` AS acc_table
  INNER JOIN lead_table 
  ON lead_table.grid__c = acc_table.grid__c
  WHERE 
    acc_table.vertical__c IN (&apos;Restaurant&apos;)
    AND acc_table.mark_for_testing_training__c = False
    AND lead_table.createdbyid IN (&apos;0056900000AVz3YAAT&apos;, &apos;0056900000CRtp2AAD&apos;, &apos;0056900000BV0qnAAD&apos;, &apos;0056900000BUli5AAD&apos;, &apos;0056900000BSL0IAAX&apos;)
    AND lead_table.createddate &gt;&gt;= &apos;2023-01-01&apos;
    AND lead_table.status IN (&apos;Converted&apos;)
),

-- Step 1: Remove duplicates and filter out rows with ID-like values
CleanedHistory AS (
  SELECT 
    opp_hist.*,
    lao.sf_lead_id,
    lao.sf_account_id,
    --lao.user_type,
    lao.opportunity_business_type,
    lao.opp_stage_name,
    lao.lead_source,
    ROW_NUMBER() OVER (PARTITION BY opp_hist.opportunityid, opp_hist.createdbyid, opp_hist.createddate ORDER BY opp_hist.id) AS row_num -- Remove duplicates here
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.opportunityfieldhistory` AS opp_hist
  INNER JOIN `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` AS lao
    ON opp_hist.opportunityid = lao.sf_opportunity_id
  WHERE lao.opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)
    AND opp_hist.field IN (&quot;Type&quot;, &quot;Owner&quot;)
)

, DeduplicatedHistory AS (
  -- Step 2: Select only rows without duplicates
  SELECT 
    CleanedHistory.*,
    opp_table.closedate AS opp_closedate 
  FROM CleanedHistory 
  INNER JOIN
   `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` AS opp_table
   ON CleanedHistory.opportunityid = opp_table.id
  WHERE row_num = 1 -- Retain only first instance for each combination
    AND REGEXP_CONTAINS(newvalue, r&apos;^[A-Za-z0-9]+$&apos;) = FALSE -- Filter ID-like values
)

-- Step 3: Rank the records and calculate the next change date within each opportunity
, RankedHistory AS (
  SELECT 
    *,
    ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY createddate ASC) AS rank_num,  -- Rank rows by date within each opportunity
    LEAD(createddate) OVER (PARTITION BY opportunityid ORDER BY createddate ASC) AS next_created_date  -- Next change date
  FROM DeduplicatedHistory
)

-- Step 4: Replace the newvalue of the first rank with the oldvalue from the next rank
, AdjustedValues AS (
  SELECT 
    *,
    CASE 
      WHEN rank_num = 1 THEN LEAD(oldvalue) OVER (PARTITION BY opportunityid ORDER BY createddate ASC)
      ELSE newvalue 
    END AS adjusted_newvalue,
  FROM RankedHistory
)

-- Step 5: Calculate the ownership duration based on adjusted values and the next created date
, OwnershipDuration AS (
  SELECT 
    opportunityid,
    createdbyid,
    createddate,
    field,
    oldvalue,
    adjusted_newvalue AS newvalue,
    next_created_date, 
    opp_closedate,
    sf_lead_id, 
    sf_account_id,
    opportunity_business_type, 
    opp_stage_name,
    lead_source,
    rank_num,
    CASE 
      WHEN next_created_date IS NOT NULL THEN DATE_DIFF(CAST(next_created_date AS DATE), CAST(createddate AS DATE), DAY)
      ELSE DATE_DIFF(CURRENT_DATE(), CAST(createddate AS DATE), DAY)
    END AS days_of_ownership
  FROM AdjustedValues
),


UniqueUserLayer AS (
  SELECT 
    full_name_internal_non_pii,
    user_type,
    ROW_NUMBER() OVER (PARTITION BY full_name_internal_non_pii ORDER BY user_type) AS row_num
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer`
)


-- Final result: Ownership information along with the days of ownership
SELECT
 lead_acc_table.*,
 OwnershipDuration.*,
 UniqueUserLayer.user_type AS lao_user_type
FROM OwnershipDuration
INNER JOIN lead_acc_table
   ON OwnershipDuration.sf_account_id = lead_acc_table.acc_id
LEFT JOIN UniqueUserLayer
 ON OwnershipDuration.newvalue = UniqueUserLayer.full_name_internal_non_pii
 AND UniqueUserLayer.row_num = 1  -- Only join the first occurrence
ORDER BY OwnershipDuration.sf_account_id</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
