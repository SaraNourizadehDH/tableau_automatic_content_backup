        <metadata-records>
          <metadata-record class='column'>
            <remote-name>report_date</remote-name>
            <remote-type>7</remote-type>
            <local-name>[report_date]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>report_date</remote-alias>
            <local-type>date</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_EFAD668DC20F4914B5F15ED2415F3DC2]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
