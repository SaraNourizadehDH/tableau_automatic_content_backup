      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_EDAED738775B4D3DA21B719FBFCF3D19'>
            <properties context=''>
              <relation connection='bigquery.17guwjg1sv2h2719p8r2b1w2jkd6' name='Custom SQL Query' type='text'>WITH sf_user AS (
  SELECT DISTINCT
    id AS sf_user_id,
    TRIM(COALESCE(firstname, &quot;&quot;) || &quot; &quot; || COALESCE(lastname, &quot;&quot;)) AS owner_name,
    isactive AS is_owner_active,
    email,
    central_job_role__c,
    title,
    job_role_vertical__c,
    isactive,
    COALESCE(ROW_NUMBER() OVER (PARTITION BY id ORDER BY DATETIME(lastmodifieddate) DESC) = 1) AS is_latest
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.user`
),

combined AS (
SELECT 
account.country_code, 
account,platform__c, 
account.global_entity_id, 
account.id AS account_id, 
account.grid__c, 
account.createddate, 
accountsource, 
account.mark_for_testing_training__c, 
account.type, 
account.vertical__c,
account.vendor_grade__c,
account.self_setup__c,
account.createdbyid,
account.revenue_model__c,
sf_user.owner_name AS opp_owner_full_name,
sf_user.email,
sf_user.central_job_role__c,
sf_user.job_role_vertical__c,
sf_user.title,
sf_user.isactive,
opp.ownerid,
opp.name,
opp.business_type__c,
opp.stagename,
opp.closedate,
opp.isclosed,
opp.id AS opportunity_id,
opp.createddate AS opportunity_created_date,
account.vertical_segment__c, 
account.key_vip_account__c, 
account.key_account_sub_category__c,
opp.iswon,
opp.assigned_to__c,
opp.probability,
opp.leadsource,
opp.createdbyid AS opp_created_by
FROM `fulfillment-dwh-production.curated_data_shared_salesforce.account`  AS account
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` AS opp
ON account.id = opp.accountid
LEFT JOIN sf_user
       ON sf_user.sf_user_id = opp.ownerid
      AND sf_user.is_latest
WHERE account.createddate &gt;&gt;= &apos;2022-01-01&apos;), 



final AS (SELECT 
combined.country_code,
combined.platform__c, 
combined.global_entity_id, 
combined.account_id, 
combined.grid__c, 
combined.createddate, 
combined.accountsource, 
combined.mark_for_testing_training__c, 
combined.type, 
combined.vertical__c,
combined.vendor_grade__c, 
combined.self_setup__c,
combined.createdbyid,
combined.email,
lao.user_type,
combined.central_job_role__c,
combined.title,
combined.job_role_vertical__c,
combined.isactive,
combined.opp_owner_full_name,
combined.ownerid,
combined.name,
combined.business_type__c,
combined.stagename,
combined.closedate,
combined.isclosed,
combined.opportunity_id,
combined.vertical_segment__c, 
combined.key_vip_account__c, 
combined.key_account_sub_category__c,
combined.revenue_model__c,
combined.opportunity_created_date,
combined.iswon,
combined.assigned_to__c,
combined.probability,
combined.leadsource,
combined.opp_created_by,
leads.id AS lead_id,
leads.createdbyid AS leads_created_by_id, 
leads.mark_for_testing_training__c AS leads_mark_fortesting_training, 
leads.vertical__c AS leads_vertical, 
leads.recordtypeid AS leads_recordtype_id,
leads.company AS company_name
FROM combined
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.lead` As leads
       ON combined.account_id = leads.convertedaccountid
      AND combined.grid__c = leads.grid__c
LEFT JOIN `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` AS lao
       ON combined.global_entity_id = lao.global_entity_id
      AND combined.opportunity_id = lao.sf_opportunity_id
      AND combined.email = lao.email_internal_non_pii
WHERE business_type__c = &quot;New Business&quot; 
AND NOT leads.mark_for_testing_training__c 
AND NOT combined.mark_for_testing_training__c
AND combined.stagename = &quot;Closed Won&quot;
AND leads.createdbyid IN (&quot;0056900000AVz3YAAT&quot;, &quot;0056900000BRoR1AAL&quot;, &quot;0056900000BSL0IAAX&quot;, 
                              &quot;0056900000BUli5AAD&quot;, &quot;0056900000BV0qnAAD&quot;, &quot;0056900000CRtp2AAD&quot;)
AND combined.closedate &gt;&gt;= &quot;2024-01-01&quot;
AND combined.vertical__c = &quot;Restaurant&quot;         
)

SELECT
&quot;&quot; AS assigned_opp_month,
global_entity_id,
lead_id,
leads_created_by_id,
leads_mark_fortesting_training,
grid__c,
opportunity_id,
opp_owner_full_name,
user_type,
closedate AS opp_closedate,
opportunity_created_date,
vertical__c,
isclosed,
&quot;&quot; AS cumulative_count
FROM final</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='OKR3' inline='true' name='federated.1kmkuzn1gh5zfo1h5dr4k0uaskse' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04hy7d518ua49s19tra3v172mys4'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='theeranop.wongtitirote@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04hy7d518ua49s19tra3v172mys4' name='Custom SQL Query' type='text'><![CDATA[WITH sf_user AS (
  SELECT DISTINCT
    id AS sf_user_id,
    TRIM(COALESCE(firstname, "") || " " || COALESCE(lastname, "")) AS owner_name,
    isactive AS is_owner_active,
    email,
    central_job_role__c,
    title,
    job_role_vertical__c,
    isactive,
    ROW_NUMBER() OVER (PARTITION BY id ORDER BY DATETIME(lastmodifieddate) DESC) = 1 AS is_latest
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.user`
),
base_data AS (
  SELECT 
    TIMESTAMP_TRUNC(TIMESTAMP(opp_history.createddate), MONTH) AS month,
    opp.global_entity_id,
    leads.id AS lead_id,
    leads.createdbyid AS leads_created_by_id,
    leads.mark_for_testing_training__c AS leads_mark_fortesting_training,
    acc.grid__c,
    opp.id AS opp_id,
    sf_user.owner_name AS opp_owner_full_name,
    opp.closedate,
    opp.createddate AS opp_createddate,
    opp.vertical__c,
    opp.isclosed,
    opp_history.newvalue,
    opp_history.oldvalue,
    opp_history.createddate AS opp_history_createddate
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` AS opp
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` AS acc
         ON opp.global_entity_id = acc.global_entity_id 
        AND opp.accountid = acc.id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.lead` AS leads
         ON acc.id = leads.convertedaccountid
        AND acc.grid__c = leads.grid__c      
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunityfieldhistory` AS opp_history
         ON opp.global_entity_id = opp_history.global_entity_id
        AND opp.id = opp_history.opportunityid
  LEFT JOIN sf_user
         ON sf_user.sf_user_id = opp.ownerid
        AND sf_user.is_latest     
  WHERE leads.createdbyid IN ("0056900000AVz3YAAT", "0056900000BRoR1AAL", "0056900000BSL0IAAX", 
                              "0056900000BUli5AAD", "0056900000BV0qnAAD", "0056900000CRtp2AAD")
    AND acc.vertical__c = "Restaurant"
    AND opp.createddate >>= "2024-01-01"
    AND opp_history.field = "Owner"
    AND opp_history.newvalue LIKE "0%"
),
expanded_months AS (
  SELECT 
    d1.month AS target_month,
    d2.newvalue,
    d2.global_entity_id,
    d2.lead_id,
    d2.leads_created_by_id,
    d2.leads_mark_fortesting_training,
    d2.grid__c,
    d2.opp_id,
    d2.opp_owner_full_name,
    d2.closedate,
    d2.opp_createddate,
    d2.vertical__c,
    d2.isclosed
  FROM base_data d1
  JOIN base_data d2
    ON d2.opp_history_createddate <<= TIMESTAMP(DATE_ADD(DATE(d1.month), INTERVAL 1 MONTH))
    AND d2.opp_history_createddate >> TIMESTAMP(DATE_SUB(DATE(d1.month), INTERVAL 1 MONTH))
),
cumulative_counts AS (
  SELECT 
    target_month AS month,
    global_entity_id,
    lead_id,
    leads_created_by_id,
    leads_mark_fortesting_training,
    grid__c,
    opp_id,
    opp_owner_full_name,
    closedate,
    opp_createddate,
    vertical__c,
    isclosed,
    COUNT(DISTINCT newvalue) AS cumulative_count
  FROM expanded_months
  GROUP BY 
    target_month, 
    global_entity_id, 
    lead_id, 
    leads_created_by_id, 
    leads_mark_fortesting_training, 
    grid__c, 
    opp_id, 
    opp_owner_full_name, 
    closedate, 
    opp_createddate, 
    vertical__c, 
    isclosed
)
SELECT 
  month AS assigned_opp_month,
  cumulative_counts.global_entity_id,
  lead_id,
  leads_created_by_id,
  leads_mark_fortesting_training,
  grid__c,
  opp_id AS opportunity_id,
  opp_owner_full_name,
  lao.user_type,
  closedate AS opp_closedate,
  opp_createddate AS opportunity_created_date,
  vertical__c,
  isclosed,
  cumulative_count
FROM cumulative_counts
LEFT JOIN `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` AS lao
       ON cumulative_counts.global_entity_id = lao.global_entity_id
      AND cumulative_counts.opp_id = lao.sf_opportunity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
