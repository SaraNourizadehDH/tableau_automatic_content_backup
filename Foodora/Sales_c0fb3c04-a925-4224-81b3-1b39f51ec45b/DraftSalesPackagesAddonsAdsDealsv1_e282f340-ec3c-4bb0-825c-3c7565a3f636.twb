      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4FA323C6ACFC40D7A8DE7BA85A91F7E0'>
            <properties context=''>
              <relation connection='bigquery.0qtarb40fqy6t614c0b2w05p9vs6' name='Custom SQL Query' type='text'>WITH cte1 AS (
SELECT 
sf_add_on_services.country_code,
sf_add_on_services.global_entity_id,
countries.name AS country,
sf_add_on_services.opportunity__c,
sf_list_add_on.id_country__c, 
sf_list_add_on.is_active__c, 
sf_list_add_on.recordtypeid, 
sf_list_add_on.name, 
sf_list_add_on.contract_addition__c, 
sf_list_add_on.type__c 
FROM `fulfillment-dwh-production.curated_data_shared_salesforce.add_on_service__c` AS sf_add_on_services
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.list_add_on__c` AS sf_list_add_on
         ON sf_add_on_services.id_list_add_on__c = sf_list_add_on.id
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
        ON sf_add_on_services.global_entity_id = countries.global_entity_id 
),

deals_final AS (
SELECT 
cte1.*, mapping.product, mapping.key_words
FROM cte1
INNER JOIN `fulfillment-dwh-production.pandata_report.commercial__sales_packages_add_on` AS mapping
ON cte1.country = mapping.country
AND cte1.name = mapping.add_on_package_name
AND cte1.type__c  = mapping.type
AND (
    (
      -- Condition for Czech Republic and Finland
      cte1.country IN (&apos;Czech Republic&apos;, &apos;Finland&apos;, &apos;Austria&apos;, &apos;Singapore&apos;)
      AND LOWER(cte1.name) LIKE CONCAT(&apos;%&apos;, LOWER(mapping.key_words), &apos;%&apos;)
    )
    OR
    (
      -- Condition for all other countries
      cte1.country NOT IN (&apos;Czech Republic&apos;, &apos;Finland&apos;, &apos;Singapore&apos;)
      AND LOWER(cte1.contract_addition__c) LIKE CONCAT(&apos;%&apos;, LOWER(mapping.key_words), &apos;%&apos;)
    )
  )
)

SELECT 
lao.global_entity_id,
lao.country,
lao.sf_opportunity_owner_id, 
lao.full_name_internal_non_pii, 
lao.user_type, 
lao.activation_date,
lao.sf_opportunity_id,
lao.vendor_grade,
lao.vendor_code,

deals_final.product
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` AS lao
LEFT JOIN deals_final
       ON  lao.global_entity_id = deals_final.global_entity_id 
      AND  lao.sf_opportunity_id = deals_final.opportunity__c

WHERE is_closed
  AND is_won
  AND    ((lao.country IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
    AND opportunity_business_type IN (&apos;Legal Form Change&apos;, &apos;New Business&apos;, &apos;Owner Change&apos;, &apos;Win Back&apos;))
    OR
    (lao.country NOT IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)))
  AND vendor_type = &apos;Restaurants&apos;
  AND vertical_segment != &apos;caterers&apos;
  AND DATE_TRUNC(activation_date, MONTH) &gt;&gt;= &quot;2024-01-01&quot;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
