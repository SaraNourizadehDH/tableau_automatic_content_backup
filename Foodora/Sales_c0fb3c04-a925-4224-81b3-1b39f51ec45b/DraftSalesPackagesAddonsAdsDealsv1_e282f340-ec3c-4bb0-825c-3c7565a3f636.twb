      <column caption='# activations' datatype='integer' name='[Calculation_233835384171323396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sf_opportunity_id])' />
      </column>
      <column caption='% ads' datatype='real' name='[Calculation_233835384171409413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[count deal (copy)_233835384170987521]/[Calculation_233835384171323396]' />
