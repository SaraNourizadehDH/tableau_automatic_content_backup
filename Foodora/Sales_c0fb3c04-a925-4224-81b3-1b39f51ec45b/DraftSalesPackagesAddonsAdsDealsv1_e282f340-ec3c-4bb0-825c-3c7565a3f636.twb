      <column caption='% deals' datatype='real' name='[% ads (copy)_233835384171593734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_233835384170827776]/[Calculation_233835384171323396]' />
      </column>
      <column caption='% deal &amp; ads' datatype='real' name='[% deals (copy)_233835384171634695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[count ads (copy)_233835384171053058]/[Calculation_233835384171323396]' />
      </column>
      <column caption='count deal' datatype='integer' name='[Calculation_233835384170827776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [product] = &quot;Deal&quot; THEN [sf_opportunity_id] ELSE NULL END)' />
