      <column caption='last month filter' datatype='boolean' name='[Calculation_1746622628366393344 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [report_date]) = DATEPART(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;AND DATEPART(&apos;year&apos;, [report_date]) = DATEPART(&apos;year&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
      </column>
      <column caption='mtd month filter' datatype='boolean' name='[Calculation_1746622628366393344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [report_date]) = DATEPART(&apos;month&apos;, TODAY())&#10;AND DATEPART(&apos;year&apos;, [report_date]) = DATEPART(&apos;year&apos;, TODAY())' />
      </column>
      <column caption='Last day of last week' datatype='date' name='[Calculation_220676408127479809]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [reps_name] :&#10;    MAX(&#10;        IF DATEDIFF(&apos;week&apos;, [report_date], TODAY()) = 1 THEN [report_date] END&#10;    )&#10;}' />
      </column>
      <column caption='Fixed weekly meeting target' datatype='integer' name='[Calculation_220676408130203650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [reps_name] : IF DAY(TODAY() - 1) &gt;= 1 AND DAY(TODAY() - 1) &lt;= 23 AND MAX([global_entity_id]) != &quot;FP_NO&quot; THEN 8&#10;    ELSEIF DAY(TODAY() - 1) &gt;= 24 AND DAY(TODAY() - 1) &lt;= 31 AND MAX([global_entity_id]) != &quot;FP_NO&quot; THEN 6&#10;    ELSE 0 &#10;END}' />
      </column>
      <column caption='Fixed weekly call target' datatype='integer' name='[Calculation_220676408131043331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [reps_name] : IF DAY(TODAY() - 1) &gt;= 1 AND DAY(TODAY() - 1) &lt;= 23 AND MAX([global_entity_id]) != &quot;FP_NO&quot; THEN 8&#10;    ELSEIF DAY(TODAY() - 1) &gt;= 24 AND DAY(TODAY() - 1) &lt;= 31 AND MAX([global_entity_id]) != &quot;FP_NO&quot; THEN 6&#10;    ELSEIF DAY(TODAY() - 1) &gt;= 1 AND DAY(TODAY() - 1) &lt;= 23 AND MAX([global_entity_id]) = &quot;FP_NO&quot; THEN 16&#10;    ELSEIF DAY(TODAY() - 1) &gt;= 24 AND DAY(TODAY() - 1) &lt;= 31 AND MAX([global_entity_id]) = &quot;FP_NO&quot; THEN 12&#10;    ELSE 0 &#10;END}' />
      </column>
      <column caption='Column name - Trend' datatype='string' name='[Calculation_2973572063509094403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Trend&apos;' />
      </column>
      <column caption='Meeting done last week' datatype='integer' name='[Calculation_4021292280044822528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;week&apos;, [report_date]) = DATEPART(&apos;week&apos;, TODAY() - 7)&#10;   AND DATEPART(&apos;year&apos;, [report_date]) = DATEPART(&apos;year&apos;, TODAY() - 7)&#10;THEN [meeting_done]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Call done last week' datatype='integer' name='[Calculation_4021292280045072385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;week&apos;, [report_date]) = DATEPART(&apos;week&apos;, TODAY() - 7)&#10;   AND DATEPART(&apos;year&apos;, [report_date]) = DATEPART(&apos;year&apos;, TODAY() - 7)&#10;THEN [call_done]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Meeting MTD' datatype='integer' name='[Calculation_4021292280045641730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;   AND [report_date] &lt;= TODAY()&#10;THEN [meeting_done]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Call MTD' datatype='integer' name='[Calculation_4021292280045727747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;   AND [report_date] &lt;= TODAY()&#10;THEN [call_done]&#10;ELSE 0&#10;END' />
      </column>
