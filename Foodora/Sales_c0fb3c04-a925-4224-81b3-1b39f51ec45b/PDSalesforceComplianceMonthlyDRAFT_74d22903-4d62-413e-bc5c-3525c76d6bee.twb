        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.02jl4et1j0wce91c39umq034glon'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Data Production' schema='sandbox_ssc' server-oauth='' username='theeranop.wongtitirote@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02jl4et1j0wce91c39umq034glon' name='Daily call and meeting' type='text'>WITH report_day AS (
SELECT report_date
FROM UNNEST(GENERATE_DATE_ARRAY(
  DATE_TRUNC(CURRENT_DATE(), YEAR),         -- Jan 1 of current year
  DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY), -- Yesterday
  INTERVAL 1 DAY
)) AS report_date
),

report_date_base AS(
SELECT report_date,
DATE_TRUNC(report_date, MONTH) AS report_month
FROM report_day
),

users_monthly AS (
  SELECT
  users.report_date AS report_month,
  users.country,
  countries.global_entity_id,
  users.full_name_internal_non_pii,
  users.email_internal_non_pii,
  users.sf_user_id,
  users.central_job_role,
  users.title,
  users.job_role_vertical,
  users.user_type,
  users.account_age_snapshot,
  users.is_active_snapshot,
  users.is_contractor,
  countries.region
FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
        ON users.country = countries.name
WHERE users.report_date BETWEEN DATE_TRUNC(CURRENT_DATE(), YEAR)
                     AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  AND user_type = &quot;field rep&quot;
QUALIFY ROW_NUMBER() OVER (PARTITION BY sf_user_id, report_date ORDER BY full_name_internal_non_pii) = 1
AND users.is_active_snapshot
),

user_base AS(
SELECT
report_date_base.report_date,
report_date_base.report_month,
country,
users_monthly.global_entity_id,
full_name_internal_non_pii,
email_internal_non_pii,
sf_user_id,
central_job_role,
title,
job_role_vertical,
user_type,
account_age_snapshot,
is_active_snapshot,
is_contractor,
region
FROM users_monthly
JOIN report_date_base
ON report_date_base.report_month = users_monthly.report_month
),

task AS (
  SELECT
  st.id AS task_id,
  st.accountid AS sf_account_id,
  st.type,
  st.global_entity_id,
  st.activity_subject__c AS activity_subject,
  DATETIME(st.createddate) AS created_at_utc,
  DATETIME(st.completeddatetime) AS completed_at_utc,
  DATE(DATETIME(st.createddate)) AS created_date,
  st.status,
  st.ownerid AS created_by_sf_id,
  st.topis_discussed__c AS topic_discussed,
  IF(activity_subject__c IN (&quot;Call - Decision maker reached&quot;, &quot;Call - Employee reached&quot;), TRUE, FALSE ) AS is_task_success
FROM  `fulfillment-dwh-production.curated_data_shared_salesforce.task` AS st
WHERE  DATE(st.partition_date)  &gt;&gt;= &quot;2025-01-01&quot;
  AND type IN (&quot;Call&quot;,&quot;Meeting&quot;)
),

sf_task_final AS (
SELECT 
DATE(completed_at_utc) AS report_date_sf_task,
global_entity_id,
created_by_sf_id,
IF( global_entity_id = &quot;FO_NO&quot;, 0, 30 ) AS meeting_target,
IF( global_entity_id = &quot;FO_NO&quot;, 60, 30 ) AS call_target,
CASE WHEN EXTRACT(DAY FROM completed_at_utc) BETWEEN 1 AND 23 AND global_entity_id != &quot;FP_NO&quot; THEN 8 
WHEN EXTRACT(DAY FROM completed_at_utc) BETWEEN 24 AND 31 AND global_entity_id != &quot;FP_NO&quot; THEN 6
ELSE 0 END AS week_meeting_target,
CASE WHEN EXTRACT(DAY FROM completed_at_utc) BETWEEN 1 AND 23 AND global_entity_id != &quot;FP_NO&quot; THEN 8 
WHEN EXTRACT(DAY FROM completed_at_utc) BETWEEN 24 AND 31 AND global_entity_id != &quot;FP_NO&quot; THEN 6
WHEN EXTRACT(DAY FROM completed_at_utc) BETWEEN 1 AND 23 AND global_entity_id = &quot;FP_NO&quot; THEN 16 
WHEN EXTRACT(DAY FROM completed_at_utc) BETWEEN 24 AND 31 AND global_entity_id = &quot;FP_NO&quot; THEN 12
ELSE 0 END AS week_call_target,
COUNT(DISTINCT IF(type IN (&quot;Meeting&quot;, &quot;Walk In&quot;) AND is_task_success AND status = &quot;Completed&quot;, task_id, NULL)) AS meeting_done,
COUNT(DISTINCT IF(type = &quot;Call&quot; AND is_task_success AND status = &quot;Completed&quot;, task_id, NULL)) AS call_done,
FROM task
WHERE completed_at_utc IS NOT NULL
GROUP BY ALL
)

SELECT
report_date,
report_month,
country,
user_base.global_entity_id,
full_name_internal_non_pii AS reps_name,
email_internal_non_pii,
sf_user_id,
central_job_role,
title,
job_role_vertical,
user_type,
account_age_snapshot,
is_active_snapshot,
is_contractor,
region,
meeting_target,
call_target,
week_meeting_target,
week_call_target,
meeting_done,
call_done
FROM user_base
LEFT JOIN sf_task_final
ON user_base.sf_user_id = sf_task_final.created_by_sf_id
AND user_base.global_entity_id = sf_task_final.global_entity_id
AND user_base.report_date = sf_task_final.report_date_sf_task</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
