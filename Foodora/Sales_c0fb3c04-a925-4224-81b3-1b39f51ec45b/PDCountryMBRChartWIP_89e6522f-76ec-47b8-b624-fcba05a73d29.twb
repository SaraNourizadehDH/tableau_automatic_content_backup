      <column caption='&gt;2 activations' datatype='boolean' name='[Calculation_4335559107523469313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [activations] &gt; 2 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='all sources activations' datatype='integer' name='[Calculation_4335559107525840898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([federated.0er81rg1ui9f8p12bnmfe14gxvu5].[Source])  = &quot;All Sources&quot; THEN SUM([federated.0er81rg1ui9f8p12bnmfe14gxvu5].[num_activations]) ELSE NULL END' />
      </column>
      <column caption='Field Sales Activation' datatype='integer' name='[Calculation_4335559107526377475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[central_job_role] = &quot;Field Sales Representative&quot;  AND [Calculation_4335559107522920448] = &quot;OLD&quot; AND [Calculation_4335559107523469313] = TRUE THEN [activations] ELSE NULL END' />
      </column>
      <column caption='Other Activations' datatype='integer' name='[Calculation_4335559107526881284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.0er81rg1ui9f8p12bnmfe14gxvu5].[num_activations]) - SUM([Calculation_4335559107526377475])' />
      </column>
      <column caption='Field Sales Headcount' datatype='integer' name='[Calculation_4335559107527618565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [central_job_role] = &quot;Field Sales Representative&quot; THEN 1 ELSE NULL END)' />
      </column>
      <column caption='activefield sales headcount' datatype='integer' name='[Calculation_4335559107531825158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[central_job_role] = &quot;Field Sales Representative&quot;  AND [Calculation_4335559107522920448] = &quot;OLD&quot; AND [Calculation_4335559107523469313] = TRUE THEN 1 ELSE NULL END' />
      </column>
      <column caption='Field Sales Productivity' datatype='real' name='[Calculation_4335559107532034055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4335559107526377475])/SUM([Calculation_4335559107531825158])' />
      </column>
      <column caption='%A/B' datatype='real' name='[Calculation_4335559108140371978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Field Sales Activation (copy)_4335559108139786249])/SUM([Calculation_4335559107526377475])' />
      </column>
      <column caption='Field Sales Activation A/B' datatype='integer' name='[Field Sales Activation (copy)_4335559108139786249]' role='measure' type='quantitative'>
