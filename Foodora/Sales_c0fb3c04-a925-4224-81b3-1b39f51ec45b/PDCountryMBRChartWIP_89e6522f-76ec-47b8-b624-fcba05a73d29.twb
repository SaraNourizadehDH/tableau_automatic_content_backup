      <aliases enabled='yes' />
      <column caption='latest month' datatype='datetime' name='[Calculation_2646849991110565888]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX(DATETRUNC(&apos;month&apos;, [activation_month])) }' />
      </column>
      <column caption='last 2 month' datatype='boolean' name='[Calculation_2646849991113764867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [activation_month]) &gt;= DATEADD(&#10;    &apos;month&apos;, -1, { FIXED : MAX(DATETRUNC(&apos;month&apos;, [activation_month])) }&#10;)' />
      </column>
      <column caption='GTC A/B Activations' datatype='integer' name='[Calculation_2646849991114690564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='all sources activations' datatype='integer' name='[Calculation_4335559107525840898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Source] = &quot;All Sources&quot; THEN [num_activations] ELSE NULL END)' />
      </column>
