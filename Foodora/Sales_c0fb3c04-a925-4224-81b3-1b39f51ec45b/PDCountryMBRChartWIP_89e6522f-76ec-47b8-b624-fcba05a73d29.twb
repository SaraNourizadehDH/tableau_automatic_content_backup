      <column caption='Field Sales Productivity a/b' datatype='real' name='[Field Sales Productivity (copy)_4335559108141510667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Field Sales Activation (copy)_4335559108139786249])/SUM([Calculation_4335559107531825158])' />
      </column>
      <column caption='Other Activations (mom)' datatype='integer' name='[Other Activations (copy)_2646849991112744961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;  SUM([federated.0er81rg1ui9f8p12bnmfe14gxvu5].[num_activations]) &#10;  - SUM([Calculation_4335559107526377475])&#10;)&#10;- LOOKUP(&#10;    (SUM([federated.0er81rg1ui9f8p12bnmfe14gxvu5].[num_activations]) - SUM([Calculation_4335559107526377475])),&#10;    -1&#10;)'>
