    <datasource caption='hc_level_data' inline='true' name='federated.1ugl7w212xcvqz1g37zxl0jps5g8' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1narpdl0gbpglm1dywxhe0m503fb'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='theeranop.wongtitirote@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1narpdl0gbpglm1dywxhe0m503fb' name='Custom SQL Query' type='text'><![CDATA[WITH users_monthly AS (
  SELECT distinct
    users.report_date AS report_month,
    case when users.email_internal_non_pii in ('eng.wai@foodpanda.com') then 'Malaysia' else users.country end as country,
    case when users.email_internal_non_pii in ('eng.wai@foodpanda.com') then 'FP_MY' else countries.global_entity_id end as global_entity_id,
    users.full_name_internal_non_pii,
    users.email_internal_non_pii,
    users.sf_user_id,
    case when users.central_job_role in ('SMB - Telesales') then 'Telesales Representative' else users.central_job_role end as central_job_role,
    users.title,
    users.job_role_vertical,
    users.user_type,
    users.account_age_snapshot,
    users.is_active_snapshot,
    users.is_contractor,
    targets.field_sales_headcount AS field_sales_headcount_target,
    targets.telesales_headcount AS telesales_headcount_target,
    targets.field_sales_productivity AS field_sales_productivity_target,
    targets.telesales_productivity AS telesales_productivity_target,
    targets.field_sales_acquisition AS field_sales_acquisition_target,
    targets.telesales_acquisition AS telesales_acquisition_target,
    new_targets.field_sales_headcount AS latest_field_sales_headcount_target , 
new_targets.field_sales_acquisition AS latest_field_sales_acquisition_target, 
new_targets.telesales_headcount AS latest_telesales_headcount_target,
new_targets.telesales_acquisition AS latest_telesales_acquisition_target, 
new_targets.ab_acquisition AS latest_ab_acquisition_target, 
    IF(underperformer.email_internal_non_pii IS NOT NULL, TRUE, FALSE) AS is_underperformer,
    underperformer.actions AS underperformer_action,
    underperformer.remarks AS underperformer_remarks,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
          ON users.country = countries.name
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_productivity_targets` targets
         ON users.report_date = targets.report_month
        AND countries.global_entity_id = targets.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.reional_apac_sales_pandora_productivity_targets` new_targets
         ON users.report_date = new_targets.report_month
        AND countries.global_entity_id = new_targets.global_entity_id       
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_underperformer_action` underperformer
         ON users.report_date = underperformer.report_month
        AND users.email_internal_non_pii = underperformer.email_internal_non_pii
  WHERE users.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
),

lao_base AS (
  SELECT
  lao.global_entity_id,
  lao.country,
  lao.city,
  lao.sf_opportunity_id,
  lao.first_qc_success_date_utc,
  lao.activation_date,
  lao.opportunity_business_type,
  lao.lead_source,
  lao.vertical_segment,
  lao.vendor_code,
  lao.vendor_type,
  lao.vendor_grade,
  lao.is_successful_signup,
  lao.is_won,
  lao.is_closed,
  lao.incubated_date_30_days,
  IF(lao.vendor_grade IN ("A","AA","AAA","B") AND lao.is_gtc_acquisition, TRUE, FALSE) AS is_prio_gtc_acquisition,
 --owner attributes
  lao.sf_opportunity_owner_id,
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` lao
WHERE vendor_type = "Restaurants"
  AND vertical_segment != "caterers"
  AND opportunity_business_type != 'Upgrade/Upsell'
  AND (activation_date  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
   OR first_qc_submission_date_utc  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR))

),

f30d_comms AS ( -- vendor level
  SELECT
    pd_orders.global_entity_id,
    pd_orders.vendor_code,
    -- comm revenue
    SUM(COALESCE(order_comms.invoiced_commission_eur, order_comms.estimated_commission_eur)) AS f30d_comms_rev_eur
  FROM lao_base
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
         ON lao_base.global_entity_id = pd_orders.global_entity_id
        AND lao_base.vendor_code = pd_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.order_commissions` AS order_comms
         ON pd_orders.uuid = order_comms.order_uuid
  WHERE pd_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
    AND NOT pd_orders.is_test_order
    AND pd_orders.is_valid_order
    AND pd_orders.created_date_utc << lao_base.incubated_date_30_days
  GROUP BY ALL
),

lao AS (
  SELECT
    lao_base.global_entity_id,
    lao_base.country,
    lao_base.city,
    lao_base.sf_opportunity_id,
    lao_base.first_qc_success_date_utc,
    lao_base.activation_date,
    lao_base.opportunity_business_type,
    lao_base.lead_source,
    lao_base.vertical_segment,
    lao_base.vendor_code,
    lao_base.vendor_type,
    lao_base.vendor_grade,
    lao_base.is_successful_signup,
    lao_base.is_won,
    lao_base.is_closed,
    lao_base.incubated_date_30_days,
    lao_base.is_prio_gtc_acquisition,

  --owner attributes
    lao_base.sf_opportunity_owner_id,
    
    -- comm revenue
    COALESCE(f30d_comms.f30d_comms_rev_eur, 0) AS f30d_comms_rev_eur
  FROM lao_base
  LEFT JOIN f30d_comms
         ON lao_base.global_entity_id = f30d_comms.global_entity_id
        AND lao_base.vendor_code = f30d_comms.vendor_code
  WHERE vendor_type = "Restaurants"
    AND vertical_segment != "caterers"
    AND opportunity_business_type != 'Upgrade/Upsell'
    AND (activation_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
    OR first_qc_success_date_utc  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR))
  GROUP BY ALL

),

activations AS (
  SELECT 
    DATE_TRUNC(activation_date, MONTH) AS activation_month,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_activations,
    COALESCE(SUM(f30d_comms_rev_eur), 0) AS f30d_comms_revenue_eur
  FROM lao
  WHERE is_won
  GROUP BY ALL
),

signings AS (
  SELECT 
    DATE_TRUNC(first_qc_success_date_utc, MONTH) AS signing_month,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_signings
  FROM lao
  WHERE is_successful_signup
  GROUP BY ALL
),

activations_and_signings AS (
  SELECT 
    COALESCE(signings.signing_month, activations.activation_month) AS report_month,
    COALESCE(signings.global_entity_id, activations.global_entity_id) AS global_entity_id,
    COALESCE(signings.country, activations.country) AS country,
    COALESCE(signings.city, activations.city) AS city,
    COALESCE(signings.opportunity_business_type, activations.opportunity_business_type) AS opportunity_business_type,
    COALESCE(signings.sf_opportunity_owner_id, activations.sf_opportunity_owner_id) AS sf_opportunity_owner_id,
    COALESCE(signings.lead_source,activations.lead_source) AS lead_source,
    COALESCE(signings.vendor_type, activations.vendor_type) AS vendor_type,
    COALESCE(signings.vendor_grade, activations.vendor_grade) AS vendor_grade,
    COALESCE(signings.is_prio_gtc_acquisition, activations.is_prio_gtc_acquisition) AS is_prio_gtc_acquisition,
    activations.f30d_comms_revenue_eur,
    COALESCE(signings.num_signings, 0) AS num_signings,
    COALESCE(activations.num_activations, 0) AS num_activations
  FROM signings
  FULL JOIN activations
         ON signings.signing_month = activations.activation_month
        AND signings.global_entity_id = activations.global_entity_id
        AND signings.city = activations.city
        AND signings.opportunity_business_type = activations.opportunity_business_type
        AND signings.sf_opportunity_owner_id = activations.sf_opportunity_owner_id
        AND signings.lead_source = activations.lead_source
        AND signings.vendor_grade = activations.vendor_grade
        AND signings.vendor_type = activations.vendor_type
        AND signings.is_prio_gtc_acquisition = activations.is_prio_gtc_acquisition
 ),
 filtered_activations_signups as(
  SELECT * FROM activations_and_signings WHERE 
  (country IN ('Hong Kong') AND opportunity_business_type IN ('Legal Form Change', 'New Business', 'Owner Change', 'Win Back'))
    OR
    (country NOT IN ('Hong Kong') AND opportunity_business_type IN ('New Business', 'Win Back'))
 )

SELECT distinct
  users_monthly.report_month AS month,
  users_monthly.country AS market,
  users_monthly.full_name_internal_non_pii AS full_name,
  users_monthly.email_internal_non_pii AS email,
  users_monthly.sf_user_id,
  users_monthly.job_role_vertical,
  users_monthly.title,
  users_monthly.central_job_role,
  users_monthly.account_age_snapshot AS account_age,
  users_monthly.is_active_snapshot AS is_active,
  SUM(num_signings) AS signings,
  SUM(num_activations) AS activations,
  SUM(CASE WHEN vendor_grade IN ('A', 'B') THEN num_activations ELSE 0 END) AS sum_ab,
  SUM(CASE WHEN vendor_grade = 'C' THEN num_activations ELSE 0 END) AS sum_c,
  SUM(CASE WHEN vendor_grade = 'D' THEN num_activations ELSE 0 END) AS sum_d,
  SUM(CASE WHEN vendor_grade IS NULL OR vendor_grade = 'Ungraded' THEN num_activations ELSE 0 END) AS sum_ungraded, 
  case when  SUM(num_activations) <<10 then TRUE else FALSE end as performance_below_10,
  case when  SUM(num_activations) <<15 then TRUE else FALSE end as performance_below_15,


FROM users_monthly
LEFT JOIN filtered_activations_signups
       ON users_monthly.report_month = filtered_activations_signups.report_month
      AND users_monthly.sf_user_id = filtered_activations_signups.sf_opportunity_owner_id
WHERE user_type IN ("field rep", "telesales")
-- AND COALESCE(activations_and_signings.num_activations, 0) >>=2
-- AND account_age_snapshot >>= 60
AND is_active_snapshot
GROUP BY ALL
ORDER BY users_monthly.report_month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1narpdl0gbpglm1dywxhe0m503fb' name='Custom SQL Query' type='text'><![CDATA[WITH users_monthly AS (
  SELECT distinct
    users.report_date AS report_month,
    case when users.email_internal_non_pii in ('eng.wai@foodpanda.com') then 'Malaysia' else users.country end as country,
    case when users.email_internal_non_pii in ('eng.wai@foodpanda.com') then 'FP_MY' else countries.global_entity_id end as global_entity_id,
    users.full_name_internal_non_pii,
    users.email_internal_non_pii,
    users.sf_user_id,
    case when users.central_job_role in ('SMB - Telesales') then 'Telesales Representative' else users.central_job_role end as central_job_role,
    users.title,
    users.job_role_vertical,
    users.user_type,
    users.account_age_snapshot,
    users.is_active_snapshot,
    users.is_contractor,
    targets.field_sales_headcount AS field_sales_headcount_target,
    targets.telesales_headcount AS telesales_headcount_target,
    targets.field_sales_productivity AS field_sales_productivity_target,
    targets.telesales_productivity AS telesales_productivity_target,
    targets.field_sales_acquisition AS field_sales_acquisition_target,
    targets.telesales_acquisition AS telesales_acquisition_target,
    new_targets.field_sales_headcount AS latest_field_sales_headcount_target , 
new_targets.field_sales_acquisition AS latest_field_sales_acquisition_target, 
new_targets.telesales_headcount AS latest_telesales_headcount_target,
new_targets.telesales_acquisition AS latest_telesales_acquisition_target, 
new_targets.ab_acquisition AS latest_ab_acquisition_target, 
    IF(underperformer.email_internal_non_pii IS NOT NULL, TRUE, FALSE) AS is_underperformer,
    underperformer.actions AS underperformer_action,
    underperformer.remarks AS underperformer_remarks,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lead_account_opp_aggregated_users_layer` users
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` countries
          ON users.country = countries.name
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_productivity_targets` targets
         ON users.report_date = targets.report_month
        AND countries.global_entity_id = targets.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.reional_apac_sales_pandora_productivity_targets` new_targets
         ON users.report_date = new_targets.report_month
        AND countries.global_entity_id = new_targets.global_entity_id       
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_underperformer_action` underperformer
         ON users.report_date = underperformer.report_month
        AND users.email_internal_non_pii = underperformer.email_internal_non_pii
  WHERE users.report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
),

lao_base AS (
  SELECT
  lao.global_entity_id,
  lao.country,
  lao.city,
  lao.sf_opportunity_id,
  lao.first_qc_success_date_utc,
  lao.activation_date,
  lao.opportunity_business_type,
  lao.lead_source,
  lao.vertical_segment,
  lao.vendor_code,
  lao.vendor_type,
  lao.vendor_grade,
  lao.is_successful_signup,
  lao.is_won,
  lao.is_closed,
  lao.incubated_date_30_days,
  IF(lao.vendor_grade IN ("A","AA","AAA","B") AND lao.is_gtc_acquisition, TRUE, FALSE) AS is_prio_gtc_acquisition,
 --owner attributes
  lao.sf_opportunity_owner_id,
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated` lao
WHERE vendor_type = "Restaurants"
  AND vertical_segment != "caterers"
  AND opportunity_business_type != 'Upgrade/Upsell'
  AND (activation_date  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
   OR first_qc_submission_date_utc  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR))

),

f30d_comms AS ( -- vendor level
  SELECT
    pd_orders.global_entity_id,
    pd_orders.vendor_code,
    -- comm revenue
    SUM(COALESCE(order_comms.invoiced_commission_eur, order_comms.estimated_commission_eur)) AS f30d_comms_rev_eur
  FROM lao_base
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
         ON lao_base.global_entity_id = pd_orders.global_entity_id
        AND lao_base.vendor_code = pd_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.order_commissions` AS order_comms
         ON pd_orders.uuid = order_comms.order_uuid
  WHERE pd_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
    AND NOT pd_orders.is_test_order
    AND pd_orders.is_valid_order
    AND pd_orders.created_date_utc << lao_base.incubated_date_30_days
  GROUP BY ALL
),

lao AS (
  SELECT
    lao_base.global_entity_id,
    lao_base.country,
    lao_base.city,
    lao_base.sf_opportunity_id,
    lao_base.first_qc_success_date_utc,
    lao_base.activation_date,
    lao_base.opportunity_business_type,
    lao_base.lead_source,
    lao_base.vertical_segment,
    lao_base.vendor_code,
    lao_base.vendor_type,
    lao_base.vendor_grade,
    lao_base.is_successful_signup,
    lao_base.is_won,
    lao_base.is_closed,
    lao_base.incubated_date_30_days,
    lao_base.is_prio_gtc_acquisition,

  --owner attributes
    lao_base.sf_opportunity_owner_id,
    
    -- comm revenue
    COALESCE(f30d_comms.f30d_comms_rev_eur, 0) AS f30d_comms_rev_eur
  FROM lao_base
  LEFT JOIN f30d_comms
         ON lao_base.global_entity_id = f30d_comms.global_entity_id
        AND lao_base.vendor_code = f30d_comms.vendor_code
  WHERE vendor_type = "Restaurants"
    AND vertical_segment != "caterers"
    AND opportunity_business_type != 'Upgrade/Upsell'
    AND (activation_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
    OR first_qc_success_date_utc  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR))
  GROUP BY ALL

),

activations AS (
  SELECT 
    DATE_TRUNC(activation_date, MONTH) AS activation_month,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_activations,
    COALESCE(SUM(f30d_comms_rev_eur), 0) AS f30d_comms_revenue_eur
  FROM lao
  WHERE is_won
  GROUP BY ALL
),

signings AS (
  SELECT 
    DATE_TRUNC(first_qc_success_date_utc, MONTH) AS signing_month,
    global_entity_id,
    country,
    city,
    opportunity_business_type,
    sf_opportunity_owner_id,
    lead_source,
    vendor_type,
    vendor_grade,
    is_prio_gtc_acquisition,
    COUNT(DISTINCT sf_opportunity_id) AS num_signings
  FROM lao
  WHERE is_successful_signup
  GROUP BY ALL
),

activations_and_signings AS (
  SELECT 
    COALESCE(signings.signing_month, activations.activation_month) AS report_month,
    COALESCE(signings.global_entity_id, activations.global_entity_id) AS global_entity_id,
    COALESCE(signings.country, activations.country) AS country,
    COALESCE(signings.city, activations.city) AS city,
    COALESCE(signings.opportunity_business_type, activations.opportunity_business_type) AS opportunity_business_type,
    COALESCE(signings.sf_opportunity_owner_id, activations.sf_opportunity_owner_id) AS sf_opportunity_owner_id,
    COALESCE(signings.lead_source,activations.lead_source) AS lead_source,
    COALESCE(signings.vendor_type, activations.vendor_type) AS vendor_type,
    COALESCE(signings.vendor_grade, activations.vendor_grade) AS vendor_grade,
    COALESCE(signings.is_prio_gtc_acquisition, activations.is_prio_gtc_acquisition) AS is_prio_gtc_acquisition,
    activations.f30d_comms_revenue_eur,
    COALESCE(signings.num_signings, 0) AS num_signings,
    COALESCE(activations.num_activations, 0) AS num_activations
  FROM signings
  FULL JOIN activations
         ON signings.signing_month = activations.activation_month
        AND signings.global_entity_id = activations.global_entity_id
        AND signings.city = activations.city
        AND signings.opportunity_business_type = activations.opportunity_business_type
        AND signings.sf_opportunity_owner_id = activations.sf_opportunity_owner_id
        AND signings.lead_source = activations.lead_source
        AND signings.vendor_grade = activations.vendor_grade
        AND signings.vendor_type = activations.vendor_type
        AND signings.is_prio_gtc_acquisition = activations.is_prio_gtc_acquisition
 ),
 filtered_activations_signups as(
  SELECT * FROM activations_and_signings WHERE 
  (country IN ('Hong Kong') AND opportunity_business_type IN ('Legal Form Change', 'New Business', 'Owner Change', 'Win Back'))
    OR
    (country NOT IN ('Hong Kong') AND opportunity_business_type IN ('New Business', 'Win Back'))
 )

SELECT distinct
  users_monthly.report_month AS month,
  users_monthly.country AS market,
  users_monthly.full_name_internal_non_pii AS full_name,
  users_monthly.email_internal_non_pii AS email,
  users_monthly.sf_user_id,
  users_monthly.job_role_vertical,
  users_monthly.title,
  users_monthly.central_job_role,
  users_monthly.account_age_snapshot AS account_age,
  users_monthly.is_active_snapshot AS is_active,
  SUM(num_signings) AS signings,
  SUM(num_activations) AS activations,
  SUM(CASE WHEN vendor_grade IN ('A', 'B') THEN num_activations ELSE 0 END) AS sum_ab,
  SUM(CASE WHEN vendor_grade = 'C' THEN num_activations ELSE 0 END) AS sum_c,
  SUM(CASE WHEN vendor_grade = 'D' THEN num_activations ELSE 0 END) AS sum_d,
  SUM(CASE WHEN vendor_grade IS NULL OR vendor_grade = 'Ungraded' THEN num_activations ELSE 0 END) AS sum_ungraded, 
  case when  SUM(num_activations) <<10 then TRUE else FALSE end as performance_below_10,
  case when  SUM(num_activations) <<15 then TRUE else FALSE end as performance_below_15,


FROM users_monthly
LEFT JOIN filtered_activations_signups
       ON users_monthly.report_month = filtered_activations_signups.report_month
      AND users_monthly.sf_user_id = filtered_activations_signups.sf_opportunity_owner_id
WHERE user_type IN ("field rep", "telesales")
-- AND COALESCE(activations_and_signings.num_activations, 0) >>=2
-- AND account_age_snapshot >>= 60
AND is_active_snapshot
GROUP BY ALL
ORDER BY users_monthly.report_month]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
