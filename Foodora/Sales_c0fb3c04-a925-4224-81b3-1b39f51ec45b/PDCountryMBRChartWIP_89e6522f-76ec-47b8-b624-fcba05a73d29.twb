        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ji5qkb0fi1wil19a07xw0s61ije' name='Custom SQL Query' type='text'>WITH lao AS (
  SELECT
    global_entity_id,
    country,
    city,
    sf_opportunity_id,
    first_qc_success_date_utc,
    activation_date,
    opportunity_business_type,
    lead_source,
    user_type,
    vertical_segment,
    vendor_code,
    vendor_type,
    vendor_grade,
    is_successful_signup,
    is_won,
    is_closed,
    incubated_date_30_days,
    is_prio_gtc_acquisition,

  --owner attributes
    sf_opportunity_owner_id,

  FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated`
  WHERE vendor_type = &quot;Restaurants&quot;
    AND vertical_segment != &quot;caterers&quot;
    AND opportunity_business_type != &apos;Upgrade/Upsell&apos;
    AND (activation_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR)
    OR first_qc_success_date_utc  &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 2 YEAR))
  GROUP BY ALL

),

raw_final AS (
  SELECT 
     DATE_TRUNC(activation_date, MONTH) AS activation_month,
    &quot;Activations&quot; AS KPI,
    &quot;All Sources&quot; as Source,
    country,
    right(global_entity_id,2) as Market,

    COUNT(DISTINCT sf_opportunity_id) AS num_activations
  FROM lao
  WHERE is_won
  AND ((country IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;Legal Form Change&apos;, &apos;New Business&apos;, &apos;Owner Change&apos;, &apos;Win Back&apos;))
    OR
    (country NOT IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)))
  GROUP BY ALL
)
,
ab_raw_final AS (
  SELECT 
     DATE_TRUNC(activation_date, MONTH) AS activation_month,
    &quot;AB Activations (FS + TS)&quot; AS KPI,
    &quot;Field Sales + Telesales&quot; as Source,
    country,
    right(global_entity_id,2) as Market,

    COUNT(DISTINCT sf_opportunity_id) AS num_activations
  FROM lao
  WHERE is_won
  AND ((country IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;Legal Form Change&apos;, &apos;New Business&apos;, &apos;Owner Change&apos;, &apos;Win Back&apos;))
    OR
    (country NOT IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)))
  AND vendor_grade in (&quot;A&quot;,&quot;B&quot;)
  AND user_type in (&quot;field rep&quot;,&quot;telesales&quot;)
  GROUP BY ALL
),
ab_FS_raw_final AS (
  SELECT 
     DATE_TRUNC(activation_date, MONTH) AS activation_month,
    &quot;AB Activations FS&quot; AS KPI,
    &quot;Field Sales&quot; as Source,
    country,
    right(global_entity_id,2) as Market,

    COUNT(DISTINCT sf_opportunity_id) AS num_activations
  FROM lao
  WHERE is_won
  AND ((country IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;Legal Form Change&apos;, &apos;New Business&apos;, &apos;Owner Change&apos;, &apos;Win Back&apos;))
    OR
    (country NOT IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)))
  AND vendor_grade in (&quot;A&quot;,&quot;B&quot;)
  AND user_type in (&quot;field rep&quot;)
  GROUP BY ALL
)
,
ab_raw_final_all_sources AS (
  SELECT 
    DATE_TRUNC(activation_date, MONTH) AS activation_month,
    &quot;AB Activations&quot; AS KPI,
    &quot;All sources&quot; as Source,
    country,
    right(global_entity_id,2) as Market,

    COUNT(DISTINCT sf_opportunity_id) AS num_activations
  FROM lao
  WHERE is_won
  AND ((country IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;Legal Form Change&apos;, &apos;New Business&apos;, &apos;Owner Change&apos;, &apos;Win Back&apos;))
    OR
    (country NOT IN (&apos;Hong Kong&apos;, &apos;Finland&apos;)
     AND opportunity_business_type IN (&apos;New Business&apos;, &apos;Win Back&apos;)))
  AND vendor_grade in (&quot;A&quot;,&quot;B&quot;)
    GROUP BY ALL
)
SELECT *
FROM raw_final
-- PIVOT (SUM(num_activations) FOR activation_month IN(&quot;June 2024&quot;,&quot;July 2024&quot;,&quot;August 2024&quot;,&quot;September 2024&quot;,&quot;October 2024&quot;,	&quot;November 2024&quot;,&quot;December 2024&quot;,&quot;January 2025&quot;,&quot;February 2025&quot;, &quot;March 2025&quot;, &quot;April 2025&quot;,&quot;May 2025&quot;,&quot;June 2025&quot;,&quot;July 2025&quot;,&quot;August 2025&quot;,&quot;September 2025&quot;,&quot;October 2025&quot;,&quot;November 2025&quot;,&quot;December 2025&quot;))

UNION ALL

SELECT *
FROM ab_raw_final
-- PIVOT (SUM(num_activations) FOR activation_month IN(&quot;June 2024&quot;,&quot;July 2024&quot;,&quot;August 2024&quot;,&quot;September 2024&quot;,&quot;October 2024&quot;,	&quot;November 2024&quot;,&quot;December 2024&quot;,&quot;January 2025&quot;,&quot;February 2025&quot;, &quot;March 2025&quot;, &quot;April 2025&quot;,&quot;May 2025&quot;,&quot;June 2025&quot;,&quot;July 2025&quot;,&quot;August 2025&quot;,&quot;September 2025&quot;,&quot;October 2025&quot;,&quot;November 2025&quot;,&quot;December 2025&quot;))

UNION ALL

SELECT *
FROM ab_FS_raw_final
-- PIVOT (SUM(num_activations) FOR activation_month IN(&quot;June 2024&quot;,&quot;July 2024&quot;,&quot;August 2024&quot;,&quot;September 2024&quot;,&quot;October 2024&quot;,	&quot;November 2024&quot;,&quot;December 2024&quot;,&quot;January 2025&quot;,&quot;February 2025&quot;, &quot;March 2025&quot;, &quot;April 2025&quot;,&quot;May 2025&quot;,&quot;June 2025&quot;,&quot;July 2025&quot;,&quot;August 2025&quot;,&quot;September 2025&quot;,&quot;October 2025&quot;,&quot;November 2025&quot;,&quot;December 2025&quot;))

UNION ALL
SELECT *
FROM ab_raw_final_all_sources
-- PIVOT (SUM(num_activations) FOR activation_month IN(&quot;June 2024&quot;,&quot;July 2024&quot;,&quot;August 2024&quot;,&quot;September 2024&quot;,&quot;October 2024&quot;,	&quot;November 2024&quot;,&quot;December 2024&quot;,&quot;January 2025&quot;,&quot;February 2025&quot;, &quot;March 2025&quot;, &quot;April 2025&quot;,&quot;May 2025&quot;,&quot;June 2025&quot;,&quot;July 2025&quot;,&quot;August 2025&quot;,&quot;September 2025&quot;,&quot;October 2025&quot;,&quot;November 2025&quot;,&quot;December 2025&quot;))


ORDER BY KPI,Source,Market ASC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
