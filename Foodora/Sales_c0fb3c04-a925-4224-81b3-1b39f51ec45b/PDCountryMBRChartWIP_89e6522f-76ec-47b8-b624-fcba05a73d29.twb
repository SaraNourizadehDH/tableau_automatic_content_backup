              <calculation class='tableau' formula='IF &#10;[central_job_role] = &quot;Field Sales Representative&quot;  AND [Calculation_4335559107522920448] = &quot;OLD&quot; AND [Calculation_4335559107523469313] = TRUE THEN [activations] ELSE NULL END' />
