          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ugl7w212xcvqz1g37zxl0jps5g8'>
            <column caption='AGE' datatype='string' name='[Calculation_4335559107522920448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [account_age] &gt; 60 THEN &quot;OLD&quot; ELSE &quot;NEW&quot; END' />
            </column>
