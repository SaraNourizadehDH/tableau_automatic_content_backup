      <column caption='Is Current Month' datatype='boolean' name='[Calculation_3372773926202925061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,DATE([report_month])) = DATETRUNC(&apos;month&apos;,TODAY()) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='User Count' datatype='integer' name='[Calculation_3372773926206877702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sf_user_id])' />
      </column>
      <column caption='Field sales HC %achievement' datatype='real' name='[Calculation_3638978910041169921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;    IF MIN([field_sales_headcount_target]) = MAX([field_sales_headcount_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: SUM([Calculation_3638978910045196293]) / [Calculation_3638978910042152962]}) &#10;    ELSE SUM([Calculation_3638978910045196293]) / [Calculation_3638978910042152962]&#10;    END&#10;ELSE &#10;    IF MIN([latest_field_sales_headcount_target]) = MAX([latest_field_sales_headcount_target]) &#10;    THEN SUM({FIXED [report_month], [user_country]: SUM([Calculation_3638978910045196293]) / [Field Sales HC Target (copy)_687784160969379840]}) &#10;    ELSE SUM([Calculation_3638978910045196293]) / [Field Sales HC Target (copy)_687784160969379840]&#10;    END&#10;END' />
      </column>
      <column caption='Field Sales HC Target (2024)' datatype='integer' name='[Calculation_3638978910042152962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([field_sales_headcount_target]) = MAX([field_sales_headcount_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_headcount_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_headcount_target])})&#10;END' />
      </column>
      <column caption='Telesales HC Target' datatype='real' name='[Calculation_3638978910043758596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 &#10;THEN SUM({INCLUDE [report_month], [user_country]: MIN([telesales_headcount_target])}) &#10;ELSE SUM({INCLUDE [report_month], [user_country]: MIN([latest_telesales_headcount_target])}) &#10;END' />
      </column>
      <column caption='Field Sales HC' datatype='integer' name='[Calculation_3638978910045196293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [user_country], [report_month] : COUNTD(IF [user_type] = &apos;field rep&apos; THEN [email_internal_non_pii] ELSE NULL END)}' />
      </column>
      <column caption='Telesales HC' datatype='integer' name='[Calculation_3638978910098743304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [user_country], [report_month] : COUNTD(IF [user_type] = &apos;telesales&apos; THEN [email_internal_non_pii] ELSE NULL END)}' />
      </column>
      <column caption='Telesales HC % achievement' datatype='real' name='[Calculation_3638978910098841609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN &#10;IF MIN([telesales_headcount_target]) = MAX([field_sales_headcount_target]) &#10;THEN SUM({FIXED [report_month],[user_country]: SUM([Calculation_3638978910098743304])/ [Calculation_3638978910043758596]})&#10;ELSE SUM([Calculation_3638978910098743304]) / [Calculation_3638978910043758596]&#10;END&#10;ELSE IF MIN([latest_telesales_headcount_target]) = MAX([latest_field_sales_headcount_target]) &#10;THEN SUM({FIXED [report_month],[user_country]: SUM([Calculation_3638978910098743304])/ [Calculation_3638978910043758596]})&#10;ELSE SUM([Calculation_3638978910098743304]) / [Calculation_3638978910043758596]&#10;END&#10;END' />
      </column>
      <column caption='Field Sales Average Productivity' datatype='real' name='[Calculation_3638978910108987402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [user_country], [report_month] : SUM(IF [user_type] = &apos;field rep&apos; THEN [num_activations] ELSE NULL END)} / [Calculation_3638978910045196293]' />
      </column>
      <column caption='Field Sales Avg Productivity Target' datatype='integer' name='[Calculation_3638978910109716491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [report_month],[user_country]: MIN([field_sales_productivity_target])}' />
      </column>
      <column caption='Field Sales Productivity %achievement' datatype='real' name='[Calculation_3638978910110093324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3638978910108987402]/ [Calculation_3638978910109716491]' />
