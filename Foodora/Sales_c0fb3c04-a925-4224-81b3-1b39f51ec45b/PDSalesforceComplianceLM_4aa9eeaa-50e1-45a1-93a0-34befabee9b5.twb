              <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [report_month]) = DATEPART(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) AND&#10;DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
