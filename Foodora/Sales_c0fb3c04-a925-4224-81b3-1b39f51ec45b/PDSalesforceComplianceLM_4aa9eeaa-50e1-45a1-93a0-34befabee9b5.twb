opportunity__c,
COUNT(DISTINCT(id)) AS count_qc_rejection_case
FROM sf_case
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
       ON sf_case.country__c = countries.name
WHERE
type = &quot;Quality Check&quot;
AND  DATE(sf_case.createddate) &gt;&gt;= &quot;2025-01-01&quot;
AND (
  (sf_case.global_entity_id IN (&quot;FP_PH&quot;, &quot;FP_KH&quot;, &quot;YS_TR&quot;, &quot;FP_BD&quot;, &quot;FP_MY&quot;, &quot;FP_MM&quot;, &quot;FP_HK&quot;, &quot;FP_SG&quot;, &quot;FP_TW&quot;, &quot;FP_LA&quot;, &quot;FP_PK&quot;, &quot;MJM_AT&quot;, &quot;FP_TH&quot;)
   AND sf_case.closed_reason__c IN (&quot;Rejected&quot;, &quot;Opportunity Lost&quot;))
  OR
  (sf_case.global_entity_id NOT IN (&quot;FP_PH&quot;, &quot;FP_KH&quot;, &quot;YS_TR&quot;, &quot;FP_BD&quot;, &quot;FP_MY&quot;, &quot;FP_MM&quot;, &quot;FP_HK&quot;, &quot;FP_SG&quot;, &quot;FP_TW&quot;, &quot;FP_LA&quot;, &quot;FP_PK&quot;, &quot;FP_TH&quot;)
   AND sf_case.closed_reason__c = &quot;Not Successful&quot;)
)
GROUP BY ALL),

lao AS (
SELECT 
opp_created_date_utc,
country,
lao.global_entity_id,
vendor_code,
vendor_grade,
vendor_type,
opportunity_business_type,
opp_stage_name,
sf_opportunity_owner_id, 
sf_account_id,
sf_opportunity_id, 
activation_date, 
is_closed, 
is_won,
full_name_internal_non_pii,
user_type,
account_created_date_utc,
count_qc_rejection_case
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated`  AS lao
LEFT JOIN qc_rejection_case
ON lao.global_entity_id = qc_rejection_case.global_entity_id
AND lao.sf_account_id = qc_rejection_case.accountid
AND lao.sf_opportunity_id = qc_rejection_case.opportunity__c
WHERE opp_created_date_utc &gt;&gt;= &quot;2025-01-01&quot;
AND vendor_type = &quot;Restaurants&quot;
AND vertical_segment != &quot;caterers&quot;
AND opportunity_business_type != &apos;Upgrade/Upsell&apos;
AND user_type = &quot;field rep&quot;
),

qc AS (
  SELECT 
   opp_created_date_utc,
   DATE_TRUNC(opp_created_date_utc, MONTH) AS opp_created_month,
   country,
   global_entity_id,
   --opportunity_business_type,
   --opp_stage_name,
   sf_opportunity_owner_id, 
   full_name_internal_non_pii,
   user_type,
   SUM(count_qc_rejection_case) AS count_quote_rejected
  FROM lao
  GROUP BY ALL
),


opp_stage AS (
  SELECT 
   opp_created_date_utc,
   DATE_TRUNC(opp_created_date_utc, MONTH) AS opp_created_month,
   country,
   global_entity_id,
   opportunity_business_type,
   opp_stage_name,
   sf_opportunity_owner_id, 
   full_name_internal_non_pii,
   user_type,
   sf_opportunity_id
  FROM lao
),

opp_stage_final AS (
  SELECT 
   opp_created_date_utc,
   opp_created_month,
   sf_opportunity_owner_id, 
   full_name_internal_non_pii,
   user_type,
   COUNT(DISTINCT(sf_opportunity_id)) AS count_oppty,
   COUNT(DISTINCT IF(opp_stage_name = &quot;Contact Established&quot;, sf_opportunity_id, NULL)) AS count_contact_established,
   COUNT(DISTINCT IF(opp_stage_name = &quot;Approval Pending&quot;, sf_opportunity_id, NULL)) AS count_aaproval_pending,
   COUNT(DISTINCT IF(opp_stage_name = &quot;Quote Approved&quot;, sf_opportunity_id, NULL)) AS count_quote_approved,
   --COUNT(DISTINCT IF(opp_stage_name = &quot;Quote Rejected&quot;, sf_opportunity_id, NULL)) AS count_quote_rejected,
   COUNT(DISTINCT IF(opp_stage_name = &quot;Quality Check Request&quot;, sf_opportunity_id, NULL)) AS count_qc_request,

  FROM opp_stage
  GROUP BY ALL
),

sf_acocunts AS (
  SELECT 
   account_created_date_utc,
   DATE_TRUNC(account_created_date_utc, MONTH) AS account_created_month,
   country,
   global_entity_id,
   --opportunity_business_type,
   --opp_stage_name,
   sf_opportunity_owner_id, 
   full_name_internal_non_pii,
   user_type,
   COUNT(DISTINCT(sf_account_id)) AS count_account
  FROM lao
  GROUP BY ALL
),


activations AS (
   SELECT 
   activation_date,
   DATE_TRUNC(activation_date, MONTH) AS activation_month,
   country,
   global_entity_id,
   sf_opportunity_owner_id, 
   full_name_internal_non_pii,
   user_type, 
   COUNT(DISTINCT(sf_opportunity_id)) AS activations
   
   FROM lao
   WHERE is_won
   GROUP BY ALL
)


SELECT 
DISTINCT
user_base.report_date,
user_base.report_month,
  CASE
    WHEN EXTRACT(DAY FROM user_base.report_date) BETWEEN 1 AND 7 THEN &apos;Week 1&apos;
    WHEN EXTRACT(DAY FROM user_base.report_date) BETWEEN 8 AND 14 THEN &apos;Week 2&apos;
    WHEN EXTRACT(DAY FROM user_base.report_date) BETWEEN 15 AND 21 THEN &apos;Week 3&apos;
    WHEN EXTRACT(DAY FROM user_base.report_date) BETWEEN 22 AND 28 THEN &apos;Week 4&apos;
    ELSE &apos;Week 5&apos;
  END AS report_week_bucket,
user_base.country,
user_base.global_entity_id,
user_base.full_name_internal_non_pii,
user_base.email_internal_non_pii,
user_base.sf_user_id,
user_base.central_job_role,
user_base.title,
user_base.job_role_vertical,
user_base.user_type,
user_base.is_active_snapshot,
user_base.is_contractor,
user_base.activation_target_per_rep,
    COALESCE(activations.activations, 0) AS num_activations_closed_won,
    COALESCE(count_account, 0) AS count_account,
    COALESCE(count_oppty, 0) AS count_oppty,
    COALESCE(count_contact_established, 0) AS count_contact_established,
    COALESCE(count_quote_approved, 0) AS count_quote_approved,
    COALESCE(count_qc_request, 0) AS count_qc_request,
    COALESCE(count_aaproval_pending, 0) AS count_approval_pending,
    COALESCE(count_quote_rejected, 0) AS count_quote_rejected
  FROM user_base
LEFT JOIN sf_acocunts
       ON user_base.report_date = sf_acocunts.account_created_date_utc
      AND user_base.report_month = sf_acocunts.account_created_month
      AND user_base.sf_user_id = sf_acocunts.sf_opportunity_owner_id  
LEFT JOIN activations
       ON user_base.report_date = activations.activation_date
      AND user_base.report_month = activations.activation_month
      AND user_base.sf_user_id = activations.sf_opportunity_owner_id
LEFT JOIN opp_stage_final
       ON user_base.report_date = opp_stage_final.opp_created_date_utc
      AND user_base.report_month = opp_stage_final.opp_created_month
      AND user_base.sf_user_id = opp_stage_final.sf_opportunity_owner_id
LEFT JOIN qc
       ON user_base.report_date = qc.opp_created_date_utc
      AND user_base.report_month = qc.opp_created_month
      AND user_base.sf_user_id = qc.sf_opportunity_owner_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
