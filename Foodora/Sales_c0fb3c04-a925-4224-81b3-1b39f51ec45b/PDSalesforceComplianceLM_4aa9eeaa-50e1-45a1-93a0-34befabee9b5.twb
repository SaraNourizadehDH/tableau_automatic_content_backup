      <column caption='Telesales Avg Productivity Target' datatype='integer' name='[Calculation_3638978910111510541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [report_month],[user_country]: MIN([telesales_productivity_target])}' />
      </column>
      <column caption='Telesales Average Productivity ' datatype='real' name='[Calculation_3638978910111780878]' role='measure' type='quantitative'>
