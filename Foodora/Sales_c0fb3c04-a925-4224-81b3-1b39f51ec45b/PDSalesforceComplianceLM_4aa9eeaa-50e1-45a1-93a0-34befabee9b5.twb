    <worksheet name='target activation of the month (AT) '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='11'>Monthly Activations Targets </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor level calculations [custom query]' name='federated.1h52z2m10oih9w1bj9bux0wn52hv' />
          </datasources>
          <datasource-dependencies datasource='federated.1h52z2m10oih9w1bj9bux0wn52hv'>
            <column caption='last month' datatype='boolean' name='[Calculation_3351381837564792832 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [report_month]) = DATEPART(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) AND&#10;DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='Field Sales Acqusition Target ' datatype='real' name='[Field Sales HC Target  (copy)_687784160994553861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN(YEAR([report_month])) = 2024 THEN [Field Sales HC Target (2024) (copy)_687784160993927171]&#10;ELSE [Field Sales acquisition Target (2024) (copy)_687784160994189316] END' />
            </column>
            <column caption='Field Sales acquisition Target (2024)' datatype='integer' name='[Field Sales HC Target (2024) (copy)_687784160993927171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([field_sales_acquisition_target]) = MAX([field_sales_acquisition_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_acquisition_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MIN([field_sales_acquisition_target])})&#10;END' />
            </column>
            <column caption='Field Sales acquisition Target (2025)' datatype='real' name='[Field Sales acquisition Target (2024) (copy)_687784160994189316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([latest_field_sales_acquisition_target]) = MAX([latest_field_sales_acquisition_target]) &#10;THEN SUM({INCLUDE [report_month],[user_country]: MAX([latest_field_sales_acquisition_target])})&#10;ELSE SUM({INCLUDE [report_month],[user_country]: MAX([latest_field_sales_acquisition_target])})&#10;END' />
            </column>
            <column datatype='integer' name='[field_sales_acquisition_target]' role='measure' type='quantitative' />
            <column caption='Is Active' datatype='boolean' name='[is_active_snapshot]' role='dimension' type='nominal' />
