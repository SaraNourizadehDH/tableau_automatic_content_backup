        <calculation class='tableau' formula='IF [Telesales Acquisitions % achievement (copy)_59461632727330826] &lt; .5 THEN -1&#10;ELSEIF [Telesales Acquisitions % achievement (copy)_59461632727330826] &gt;= .5 AND [Telesales Acquisitions % achievement (copy)_59461632727330826] &lt; .8 THEN 0&#10;ELSE 1&#10;END' />
