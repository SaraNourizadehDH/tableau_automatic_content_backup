    <worksheet name='sl pipline with activations (PK)'>
      <table>
        <view>
          <datasources>
            <datasource caption='combied oppty stage' name='federated.166d6lp1euadcc1chuljf0cm6do2' />
            <datasource caption='Reps call and meeting' name='federated.0ukehl10s4159q12y16vy0q9bqyn' />
          </datasources>
          <datasource-dependencies datasource='federated.0ukehl10s4159q12y16vy0q9bqyn'>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.166d6lp1euadcc1chuljf0cm6do2'>
            <column caption='MIN1' datatype='integer' name='[Calculation_12244192768688129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='last month filter' datatype='boolean' name='[Calculation_1746622628366643201 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [report_month]) = DATEPART(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;AND DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='% Of Target Achieved' datatype='real' name='[Calculation_3195866915073957888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([num_activations_closed_won])/MAX([activation_target_per_rep]))' />
            </column>
            <column caption='projection' datatype='real' name='[Calculation_4704924634702987266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([num_activations_closed_won]))/MAX([Calculation_4704924634704441347])*30' />
            </column>
            <column caption='Week Number' datatype='integer' name='[Calculation_4704924634704441347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [report_week_bucket]&#10;WHEN &quot;Week 1&quot; THEN 7&#10;WHEN &quot;Week 2&quot; THEN 14&#10;WHEN &quot;Week 3&quot; THEN 21&#10;WHEN &quot;Week 4&quot; THEN 28&#10;END' />
            </column>
            <column caption='final projection' datatype='real' name='[Calculation_4704924634710388743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DAY(MAX([report_date])) &lt;= 28 THEN&#10;    [Calculation_4704924634702987266]&#10;ELSE&#10;    SUM([num_activations_closed_won])&#10;END' />
            </column>
            <column caption='projected status' datatype='real' name='[Calculation_4704924634711154696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_4704924634710388743]/MAX([activation_target_per_rep]))' />
            </column>
            <column caption='Status (mtd)' datatype='string' name='[Status (copy)_4704924634712522761]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4704924634711154696] &gt;= 0.75 THEN &apos;On Track&apos;&#10;ELSEIF [Calculation_4704924634711154696]&gt;= 0.65 THEN &apos;At Risk (Low)&apos;&#10;ELSEIF [Calculation_4704924634711154696]&gt;= 0.55 THEN &apos;At Risk (High)&apos;&#10;ELSEIF [Calculation_4704924634711154696] &lt;0.55 THEN &apos;Critical&apos;&#10;END' />
            </column>
