            </column>
            <column caption='QC GMV share vs target' datatype='real' default-format='*0.0pp' name='[QC MAU share vs target (copy)_1654509965044359173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[qc_gmv_share])&#10;    - AVG([target_qc_gmv_share])&#10;) &#10;* 100' />
            </column>
            <column caption='items not delivered vs target' datatype='real' default-format='*0.0pp' name='[QC MAU share vs target (copy)_560909311159058452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_4501558987562876933]&#10;    - avg([target_shops_items_not_delivered_share])&#10;) &#10;* 100' />
            </column>
            <column caption='Shops AAA supermarket active products vs target' datatype='real' default-format='p0.0%' name='[QC Trials vs target (copy)_560909311189090328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[shops_aaa_supermarket_active_products])&#10;    - SUM([target_shops_aaa_supermarket_assortment])&#10;)&#10;/&#10;SUM([target_shops_aaa_supermarket_assortment])' />
