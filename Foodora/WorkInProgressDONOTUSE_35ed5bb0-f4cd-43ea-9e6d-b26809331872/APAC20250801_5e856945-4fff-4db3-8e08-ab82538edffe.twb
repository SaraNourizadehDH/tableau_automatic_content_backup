              <calculation class='tableau' formula='(&#13;&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[[agg]] shrinkage (copy)_1316458503494873088]&#13;&#10;- AVG([target_shrinking_2_plus])&#13;&#10;&#13;&#10;) &#13;&#10;* 100' />
