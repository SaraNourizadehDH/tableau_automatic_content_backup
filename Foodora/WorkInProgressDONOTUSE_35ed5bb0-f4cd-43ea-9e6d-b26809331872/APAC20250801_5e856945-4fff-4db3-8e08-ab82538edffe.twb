    <worksheet name='PH Choice vs target'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandora_targets (markets_analytics)' name='federated.1pm470n1sj8whb15sstbv1vy23rd' />
            <datasource caption='Productivity' name='federated.02t4lcw111mg1915l6z7v1f49nkq' />
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.02t4lcw111mg1915l6z7v1f49nkq'>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pm470n1sj8whb15sstbv1vy23rd'>
            <column caption='active inventory &gt; 1 order vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311130619910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ogv_vendors]) &#10;- sum([target_total_active_inventory]) &#10;)&#10;/&#10;sum([target_total_active_inventory])' />
            </column>
            <column caption='Sales rep vs target' datatype='real' default-format='p0.0%' name='[AB acquisitions vs target (copy)_560909311185084437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[productivity])&#13;&#10;    - sum([target_sales_rep_productivity])&#13;&#10;)&#13;&#10;/&#13;&#10;sum([target_sales_rep_productivity])' />
            </column>
            <column caption='%ab ads deals vs target' datatype='real' name='[Calculation_2149061485443416065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_1455788616522063878]&#13;&#10;- AVG([target_ab_ads_deals_live_d30] )&#13;&#10;)&#13;&#10;* 100' />
            </column>
            <column caption='Zombies Formed vs target' datatype='real' default-format='p0.0%' name='[Calculation_2347782818536820743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[zombies_formed])&#13;&#10;    / AVG([target_zombies_formed])&#13;&#10;) &#13;&#10;-1' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='AB acquisitions vs target' datatype='real' name='[Calculation_560909311127298053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ab_aquisitions]) &#10;    - sum([target_ab_acquisition])&#10;)&#10;/&#10;sum([target_ab_acquisition])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_560909311124627459]' derivation='None' name='[none:Calculation_560909311124627459:nk]' pivot='key' type='nominal' />
