              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6404963148150341640] &#10;    - avg([target_ab_75_orders_in_f60d])&#10;) &#10;* 100' />
