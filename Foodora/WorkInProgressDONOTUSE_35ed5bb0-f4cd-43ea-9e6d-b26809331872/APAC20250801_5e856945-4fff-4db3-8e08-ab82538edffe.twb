            <column caption='rider hours vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311136407561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[rider_hours]) &#10;- SUM([target_actual_rider_working_hours])&#10;)&#10;/&#10;SUM([target_actual_rider_working_hours])' />
            </column>
            <column caption='No Rider Fail rate vs target' datatype='real' default-format='*0.0pp' name='[Calculation_2347782818545799185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[[agg]] fail rate (copy)_1316458503496654852]&#13;&#10;    - AVG([target_no_rider_fail])&#13;&#10;) &#13;&#10;* 100' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
