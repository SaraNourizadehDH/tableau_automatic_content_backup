              <calculation class='tableau' formula='(&#13;&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_4501558987557949440]&#13;&#10;    - avg([target_dmart_weighted_availability_v2])&#13;&#10;) &#13;&#10;* 100' />
