          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pm470n1sj8whb15sstbv1vy23rd'>
            <column caption='active inventory &gt; 1 order vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311130619910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ogv_vendors]) &#10;- sum([target_total_active_inventory]) &#10;)&#10;/&#10;sum([target_total_active_inventory])' />
            </column>
            <column caption='gtc vs target' datatype='real' default-format='p0.0%' name='[AB acquisitions vs target (copy)_6495246247298727938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[total_gtc_ab_acq])&#10;    - sum([target_ab_gap])&#10;)&#10;/&#10;sum([target_ab_gap])' />
            </column>
            <column caption='Vendors f30d &gt; 1 vs target' datatype='real' default-format='*0.0pp' name='[Calculation_2347782818535833606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_2347782818534805506] - avg([target_vendors_f30d_orders_over_1])&#13;&#10;)&#13;&#10;* 100' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='AB acquisitions vs target' datatype='real' name='[Calculation_560909311127298053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ab_aquisitions]) &#10;    - sum([target_ab_acquisition])&#10;)&#10;/&#10;sum([target_ab_acquisition])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[date]' role='dimension' type='ordinal' />
