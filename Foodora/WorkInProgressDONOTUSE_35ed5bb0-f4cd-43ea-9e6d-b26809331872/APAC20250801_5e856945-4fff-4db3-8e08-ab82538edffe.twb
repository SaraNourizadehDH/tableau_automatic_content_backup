              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[[agg]] subscriber mau share (copy)_2179883011273740291]&#10;    - AVG([target_subscriber_gmv_share])&#10;) &#10;* 100' />
