            <column caption='[agg] cofunding ratio' datatype='real' name='[Calculation_6404963148150796297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([disco_vendor_eur])&#10;/&#10;sum([disco_eur])' />
            </column>
            <column caption='[agg] vfd vendor penetration' datatype='real' name='[Calculation_6404963148151947275]' role='measure' type='quantitative'>
