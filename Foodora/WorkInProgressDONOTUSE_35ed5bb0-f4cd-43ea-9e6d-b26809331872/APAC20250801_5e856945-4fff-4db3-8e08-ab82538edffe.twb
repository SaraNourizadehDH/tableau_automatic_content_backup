            <column caption='% pro user savings YOY' datatype='real' default-format='*0.0pp' name='[% pro user savings MoM (copy)_4021221951860174860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [user_savings_over_gfv_a] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_fd_pro_gfv_b] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [user_savings_over_gfv_a] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [pro_fd_pro_gfv_b] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
