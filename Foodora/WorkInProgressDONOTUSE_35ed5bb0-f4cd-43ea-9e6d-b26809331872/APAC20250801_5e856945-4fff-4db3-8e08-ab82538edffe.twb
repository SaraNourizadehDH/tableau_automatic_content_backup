            <column caption='on time delivery vs target' datatype='real' default-format='*0.0pp' name='[shrinkage vs target (copy)_560909311149842444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6636476317117718528]&#10;    - AVG([target_on_time_delivery])&#10;) &#10;* 100' />
