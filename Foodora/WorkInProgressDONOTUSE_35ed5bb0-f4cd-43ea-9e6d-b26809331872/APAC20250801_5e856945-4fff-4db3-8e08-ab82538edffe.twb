            <column caption='AB zombie % vs target' datatype='real' name='[offline % vs target (copy)_6495246247299764227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6404963148151656458]&#10;- AVG([target_zombies_ab])&#10;)&#10;* 100' />
            </column>
            <column caption='Target Ab Acquisition' datatype='real' name='[target_ab_acquisition]' role='measure' type='quantitative' />
