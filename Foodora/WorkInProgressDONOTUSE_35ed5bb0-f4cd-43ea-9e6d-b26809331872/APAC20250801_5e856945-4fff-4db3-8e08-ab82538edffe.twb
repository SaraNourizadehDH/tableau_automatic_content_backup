              <calculation class='tableau' formula='([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_2347782818539450381] - avg([target_pro_vfd_pro_gmv])&#13;&#10;)&#13;&#10;* 100' />
