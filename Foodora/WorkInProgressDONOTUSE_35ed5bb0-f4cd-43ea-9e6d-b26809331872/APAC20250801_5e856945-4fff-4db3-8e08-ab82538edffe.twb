      <column caption='GMV target calc' datatype='real' name='[Calculation_5216294321427087367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([country]) = &quot;Bangladesh&quot; THEN &#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Hong Kong&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Cambodia&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Laos&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Myanmar&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Malaysia&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Philippines&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.17&#10;ELSEIF ATTR([country]) = &quot;Pakistan&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.17&#10;ELSEIF ATTR([country]) = &quot;Singapore&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.22&#10;ELSEIF ATTR([country]) = &quot;Thailand&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Taiwan&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Austria&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Czech Republic&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Finland&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Hungary&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Norway&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Sweden&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.14&#10;ELSEIF ATTR([country]) = &quot;Turkey&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.23&#10;ELSE &#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END)&#10;END' />
      </column>
      <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
      </column>
      <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Thailand&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;END' />
      </column>
      <column caption='[agg] HVA Percentage' datatype='real' name='[Calculation_5829206083599650835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dh_hva_incentive])&#10;/&#10;sum([total_dh_incentive])' />
      </column>
      <column caption='[agg] healthy vendors' datatype='real' name='[Calculation_6404963148140711936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([healthy_vendor_availability_n])&#10;/&#10;sum([healthy_vendor_availability_d])' />
      </column>
      <column caption='[agg] VFD GMV AO' datatype='real' name='[Calculation_6404963148143558658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ao_vendor_eur])&#10;/&#10;sum([gmv_eur])' />
      </column>
      <column caption='[agg] Markup vendor penetration' datatype='real' name='[Calculation_6404963148144824323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_markup_vendors])&#10;/&#10;sum([total_vendors_markup_calc])' />
      </column>
      <column caption='[agg] offline %' datatype='real' default-format='p0.0%' name='[Calculation_6404963148145274884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([closed_hours])&#10;/&#10;sum([scheduled_hours])' />
      </column>
      <column caption='[agg} vfd self booking ratio' datatype='real' name='[Calculation_6404963148147814405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_vendors_with_vfd_sb_deals_self_booking])&#10;/&#10;sum([total_vendors_sb])' />
      </column>
      <column caption='[agg] ncr self booking' datatype='real' name='[Calculation_6404963148148375558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_ncr_sb_vendors])&#10;/&#10;sum([total_vendors_with_order])' />
      </column>
      <column caption='[agg] sb ratio' datatype='real' name='[Calculation_6404963148148895751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_vendors_with_vfd_sb_deals])&#10;/&#10;sum([total_vendors_with_vfd])' />
      </column>
      <column caption='[agg] successful AB vendor %' datatype='real' default-format='p0.0%' name='[Calculation_6404963148150341640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_vendors])&#10;/&#10;sum([total_vendors_sf])' />
      </column>
      <column caption='[agg] cofunding ratio' datatype='real' name='[Calculation_6404963148150796297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([disco_vendor_eur])&#10;/&#10;sum([disco_eur])' />
      </column>
      <column caption='[agg] AB zombie % ' datatype='real' name='[Calculation_6404963148151656458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ab_zombie_vendors])&#10;/&#10;sum([sa_ka_vendors])' />
      </column>
      <column caption='[agg] vfd vendor penetration' datatype='real' name='[Calculation_6404963148151947275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vf_vendors])&#10;/&#10;sum([vendors])' />
      </column>
      <column caption='[agg] QC MAU Share' datatype='real' name='[Calculation_6404963148162633740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([qc_mau])&#10;/&#10;sum([MAU])' />
      </column>
      <column caption='[agg] subscriber mau share' datatype='real' name='[Calculation_6404963148165742605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([mau_penetration_percent_a])&#10;/&#10;sum([mau_penetration_percent_b])' />
      </column>
      <column caption='[agg] retention %' datatype='real' name='[Calculation_6404963148166184974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reorders])&#10;/&#10;sum([prev_customers])' />
      </column>
      <column caption='[agg] qc rejection %' datatype='real' name='[Calculation_6404963148166717455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_rejected_case_id])&#10;/&#10;sum([count_qc_case_id])' />
      </column>
      <column caption='[agg] on time delivery' datatype='real' default-format='p0.0%' name='[Calculation_6636476317117718528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([on_time_okr_weighted_per_pdt_pct] * [gross_orders])&#10;/&#10;sum([gross_orders])' />
      </column>
      <column caption='Loyalty %' datatype='real' name='[Calculation_868068876645425152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_participants])&#10;/&#10;sum([MAU])' />
      </column>
      <column caption='Loyalty share MoM' datatype='real' name='[Calculation_868068876646047746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_participants] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [MAU] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_participants] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [MAU] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='D30 Deals and Ads YoY' datatype='real' default-format='p0.0%' name='[D30 Deals and Ads MoM (copy)_1455788616383070213]' role='measure' type='quantitative'>
