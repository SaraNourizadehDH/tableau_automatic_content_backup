              <calculation class='tableau' formula='(&#13;&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[productivity])&#13;&#10;    - sum([target_sales_rep_productivity])&#13;&#10;)&#13;&#10;/&#13;&#10;sum([target_sales_rep_productivity])' />
            </column>
            <column caption='%ab ads deals vs target' datatype='real' name='[Calculation_2149061485443416065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_1455788616522063878]&#13;&#10;- AVG([target_ab_ads_deals_live_d30] )&#13;&#10;)&#13;&#10;* 100' />
            </column>
            <column caption='Zombies Formed vs target' datatype='real' default-format='p0.0%' name='[Calculation_2347782818536820743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[zombies_formed])&#13;&#10;    / AVG([target_zombies_formed])&#13;&#10;) &#13;&#10;-1' />
            </column>
