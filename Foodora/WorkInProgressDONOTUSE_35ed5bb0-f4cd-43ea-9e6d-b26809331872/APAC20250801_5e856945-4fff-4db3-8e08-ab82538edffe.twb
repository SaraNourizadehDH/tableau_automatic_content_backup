          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% pro user savings YOY' datatype='real' default-format='*0.0pp' name='[% pro user savings MoM (copy)_4021221951860174860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [user_savings_over_gfv_a] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_fd_pro_gfv_b] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [user_savings_over_gfv_a] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [pro_fd_pro_gfv_b] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Acquisitions + Reacquisitions YoY' datatype='real' name='[Acquisitions + Reacquisitions MoM (copy)_1193172472303759373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [Calculation_139752371579179010] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [Calculation_139752371579179010] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [Calculation_139752371579179010] END)' />
            </column>
            <column caption='Acquisitions + reacquisitions' datatype='integer' name='[Calculation_139752371579179010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisitions] + [reacquisitions]' />
            </column>
            <column caption='MAU YoY' datatype='real' default-format='p0.0%' name='[GMV YoY (copy)_1193172472298786820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN MAU END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN MAU END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN MAU END)' />
