      <table>
        <view>
          <datasources>
            <datasource caption='pandora_targets (markets_analytics)' name='federated.1pm470n1sj8whb15sstbv1vy23rd' />
            <datasource caption='Productivity' name='federated.02t4lcw111mg1915l6z7v1f49nkq' />
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.02t4lcw111mg1915l6z7v1f49nkq'>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pm470n1sj8whb15sstbv1vy23rd'>
            <column caption='Vendor acquisitions vs target' datatype='real' name='[AB acquisitions vs target (copy)_1654509965068763145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[total_vendor_aquisitions])&#10;    - sum([target_vendor_acquisitions])&#10;)&#10;/&#10;sum([target_vendor_acquisitions])' />
            </column>
            <column caption='active inventory &gt; 1 order vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311130619910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ogv_vendors]) &#10;- sum([target_total_active_inventory]) &#10;)&#10;/&#10;sum([target_total_active_inventory])' />
            </column>
            <column caption='Sales rep vs target' datatype='real' default-format='p0.0%' name='[AB acquisitions vs target (copy)_560909311185084437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[productivity])&#13;&#10;    - sum([target_sales_rep_productivity])&#13;&#10;)&#13;&#10;/&#13;&#10;sum([target_sales_rep_productivity])' />
