      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='%AB w/both Ads &amp; Deals live on D30' datatype='real' default-format='p0.0%' name='[Calculation_1455788616522063878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([d30_deals_and_ads_pcnt])' />
            </column>
            <column caption='[agg] Productivity' datatype='real' name='[Calculation_2149061485753733123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_activations])&#13;&#10;/&#13;&#10;SUM([distinct_user_count])' />
            </column>
            <column caption='Zombies Revived' datatype='integer' name='[Calculation_2347782818533666816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([zombies_revived])' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
            </column>
            <column caption='Zombies Formed' datatype='integer' name='[Zombies Revived (copy)_2347782818533781505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([zombies_formed])' />
            </column>
