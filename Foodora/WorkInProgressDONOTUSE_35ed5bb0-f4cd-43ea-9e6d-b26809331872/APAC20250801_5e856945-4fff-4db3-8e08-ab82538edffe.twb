              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[rider_hours]) &#10;- SUM([target_actual_rider_working_hours])&#10;)&#10;/&#10;SUM([target_actual_rider_working_hours])' />
