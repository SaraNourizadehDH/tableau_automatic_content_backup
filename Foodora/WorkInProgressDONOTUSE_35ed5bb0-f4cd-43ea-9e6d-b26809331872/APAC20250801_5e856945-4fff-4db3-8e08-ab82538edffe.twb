            <column caption='Dmart Pct Fresh Penetration YOY' datatype='real' name='[Dmart Pct Fresh Penetration MoM (copy)_2092766498465710083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_fresh_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_fresh_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_orders] END)&#10;    )&#10;) * 100' />
            </column>
            <column datatype='integer' name='[MAU]' role='measure' type='quantitative' />
            <column caption='Pct Items not delivered YoY' datatype='real' name='[Pct Items not delivered MoM (copy)_1193172472309149722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_items_not_delivered_excl_post_delivery_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_items_not_delivered_den] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_items_not_delivered_excl_post_delivery_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_items_not_delivered_den] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='QC GMV Share YOY' datatype='real' name='[QC GMV Share MoM (copy)_1640225104335839235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_gmv_share] END)&#10;     )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [qc_gmv_share]  END)&#10;&#10;    )&#10;) * 100' />
