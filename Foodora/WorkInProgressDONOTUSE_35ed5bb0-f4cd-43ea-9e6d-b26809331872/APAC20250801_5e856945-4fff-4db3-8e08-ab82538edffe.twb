      <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
        <column caption='Acquisitions + reacquisitions' datatype='integer' name='[Calculation_139752371579179010]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[acquisitions] + [reacquisitions]' />
        </column>
        <column caption='[agg] PRO Deal GMV Coverage' datatype='real' default-format='p0.0%' name='[Calculation_1455788616179093504]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([vendor_gmv_with_pro_deal_eur])/SUM(vendor_gmv_eur)' />
        </column>
        <column caption='%AB w/both Ads &amp; Deals live on D30' datatype='real' default-format='p0.0%' name='[Calculation_1455788616522063878]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([d30_deals_and_ads_pcnt])' />
        </column>
        <column caption='[agg] shrinkage' datatype='real' name='[Calculation_1520246402929152002]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shrink_orders])&#10;/&#10;sum([forecasted_orders])' />
        </column>
        <column caption='[agg] fail rate' datatype='real' name='[Calculation_1520246402932019204]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([cancelled_orders])&#10;/&#10;sum([gross_orders])' />
        </column>
        <column caption='Zombies Revived' datatype='integer' name='[Calculation_2347782818533666816]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([zombies_revived])' />
        </column>
        <column caption='% Vendors F30D Orders &gt;1' datatype='real' default-format='p0.0%' name='[Calculation_2347782818534805506]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([d30_has_order])&#13;&#10;/&#13;&#10;SUM([vendor_count])' />
        </column>
        <column caption='Pro VFD / Pro GMV' datatype='real' default-format='p0.0%' name='[Calculation_2347782818539450381]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([pro_vendor_eur])&#13;&#10;/&#13;&#10;sum([gmv_contribtuion_percent_a])' />
        </column>
        <column caption='[agg] VFD GMV' datatype='real' name='[Calculation_3984137611677024256]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(total_incentive_cost_vendor_incl_manual_adjustment_eur)&#10;/&#10;sum([gmv_eur])' />
        </column>
        <column caption='[agg] Pro user savings (% of Pro GFV)' datatype='real' default-format='p0.0%' name='[Calculation_4021221951847432192]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([user_savings_over_gfv_a])&#10;/&#10;sum([pro_fd_pro_gfv_b])' />
        </column>
        <column caption='[agg] Dmart Pct Weighted Availability V2' datatype='real' default-format='p0.0%' name='[Calculation_4501558987557949440]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([dmart_wa_num])&#10;/&#10;sum([dmart_wa_den])' />
        </column>
        <column caption='[agg] shops key partners per MAU' datatype='real' name='[Calculation_4501558987558252545]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([key_partner_country_average])&#10;/&#10;sum([all_platform_mau_country_average])' />
        </column>
        <column caption='[agg] shops pct promo gpv contribution' datatype='real' name='[Calculation_4501558987559272450]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shops_promo_gpv_contribution_num])&#10;/&#10;sum([shops_promo_gpv_contribution_den])' />
        </column>
        <column caption='[agg] items not delivered' datatype='real' default-format='p0.0%' name='[Calculation_4501558987562876933]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shops_items_not_delivered_excl_post_delivery_num])&#10;/&#10;sum([shops_items_not_delivered_den])' />
        </column>
        <column caption='[agg] dmart fresh penetration' datatype='real' name='[Calculation_4501558987565342728]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([dmart_fresh_orders])&#10;/&#10;sum([dmart_orders])' />
        </column>
        <column caption='[agg] HVA Percentage' datatype='real' name='[Calculation_5829206083599650835]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([dh_hva_incentive])&#10;/&#10;sum([total_dh_incentive])' />
        </column>
        <column caption='[agg] VFD GMV AO' datatype='real' name='[Calculation_6404963148143558658]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([ao_vendor_eur])&#10;/&#10;sum([gmv_eur])' />
        </column>
        <column caption='[agg] offline %' datatype='real' default-format='p0.0%' name='[Calculation_6404963148145274884]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([closed_hours])&#10;/&#10;sum([scheduled_hours])' />
        </column>
        <column caption='[agg] sb ratio' datatype='real' name='[Calculation_6404963148148895751]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([total_vendors_with_vfd_sb_deals])&#10;/&#10;sum([total_vendors_with_vfd])' />
        </column>
        <column caption='[agg] successful AB vendor %' datatype='real' default-format='p0.0%' name='[Calculation_6404963148150341640]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([successful_vendors])&#10;/&#10;sum([total_vendors_sf])' />
        </column>
        <column caption='[agg] cofunding ratio' datatype='real' name='[Calculation_6404963148150796297]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([disco_vendor_eur])&#10;/&#10;sum([disco_eur])' />
        </column>
        <column caption='[agg] AB zombie % ' datatype='real' name='[Calculation_6404963148151656458]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([ab_zombie_vendors])&#10;/&#10;sum([sa_ka_vendors])' />
        </column>
        <column caption='[agg] vfd vendor penetration' datatype='real' name='[Calculation_6404963148151947275]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([vf_vendors])&#10;/&#10;sum([vendors])' />
        </column>
        <column caption='[agg] QC MAU Share' datatype='real' name='[Calculation_6404963148162633740]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([qc_mau])&#10;/&#10;sum([MAU])' />
        </column>
        <column caption='[agg] retention %' datatype='real' name='[Calculation_6404963148166184974]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([reorders])&#10;/&#10;sum([prev_customers])' />
        </column>
        <column caption='[agg] on time delivery' datatype='real' default-format='p0.0%' name='[Calculation_6636476317117718528]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([on_time_okr_weighted_per_pdt_pct] * [gross_orders])&#10;/&#10;sum([gross_orders])' />
        </column>
        <column datatype='integer' name='[MAU]' role='measure' type='quantitative' />
        <column caption='% No Rider Fail' datatype='real' default-format='p0.0%' name='[[agg]] fail rate (copy)_1316458503496654852]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([failed_no_rider_count])&#10;/&#10;sum([rider_fail_gross_order_count])' />
        </column>
        <column caption='% Shrinking L2+' datatype='real' default-format='p0.0%' name='[[agg]] shrinkage (copy)_1316458503494873088]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shrink_level_2_order_count])&#10;/&#10;sum([forecasted_orders])' />
        </column>
        <column caption='[agg] subscriber gmv share' datatype='real' name='[[agg]] subscriber mau share (copy)_2179883011273740291]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([gmv_contribtuion_percent_a])&#10;/&#10;sum([gmv_contribtuion_percent_b])' />
