        <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;(&#13;&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_vendor_eur] END) &#13;&#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_contribtuion_percent_a] END)) &#13;&#10;)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;(&#13;&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [pro_vendor_eur] END) &#13;&#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_contribtuion_percent_a] END)) &#13;&#10;)&#13;&#10;&#13;&#10;&#13;&#10;) * 100' />
