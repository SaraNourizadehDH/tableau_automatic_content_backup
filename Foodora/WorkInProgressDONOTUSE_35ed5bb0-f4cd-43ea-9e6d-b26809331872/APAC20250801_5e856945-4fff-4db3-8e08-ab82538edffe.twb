            <column caption='AB Acquisitions YoY' datatype='real' name='[AB Acquisitions MoM (copy)_1193172472302776330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ab_aquisitions] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ab_aquisitions] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ab_aquisitions] END)' />
            </column>
            <column caption='D30 Deals and Ads YoY' datatype='real' default-format='p0.0%' name='[D30 Deals and Ads MoM (copy)_1455788616383070213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d30_deals_and_ads_pcnt] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [d30_deals_and_ads_pcnt] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [d30_deals_and_ads_pcnt] END)' />
            </column>
            <column caption='Ogv vendors YoY' datatype='real' name='[Ogv vendors MoM (copy)_1193172472303656972]' role='measure' type='quantitative'>
