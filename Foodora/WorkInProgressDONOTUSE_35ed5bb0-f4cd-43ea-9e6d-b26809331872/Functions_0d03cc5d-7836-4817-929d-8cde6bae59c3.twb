          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='[agg] Dmart Pct Weighted Availability V2' datatype='real' name='[Calculation_4501558987557949440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_wa_num])&#10;/&#10;sum([dmart_wa_den])' />
            </column>
            <column caption='[agg] shops key partners per MAU' datatype='real' name='[Calculation_4501558987558252545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([key_partner_country_average])&#10;/&#10;sum([all_platform_mau_country_average])' />
            </column>
            <column caption='[agg] shops pct promo gpv contribution' datatype='real' name='[Calculation_4501558987559272450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_promo_gpv_contribution_num])&#10;/&#10;sum([shops_promo_gpv_contribution_den])' />
            </column>
            <column caption='[agg] items not delivered' datatype='real' name='[Calculation_4501558987562876933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_items_not_delivered_excl_post_delivery_num])&#10;/&#10;sum([shops_items_not_delivered_den])' />
            </column>
            <column caption='shops offline' datatype='real' name='[Calculation_4501558987563614214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_offline_num]) &#10;/ &#10;sum([shops_offline_den])' />
            </column>
            <column caption='[agg] dmart fresh penetration' datatype='real' name='[Calculation_4501558987565342728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_fresh_orders])&#10;/&#10;sum([dmart_orders])' />
            </column>
            <column caption='[agg] QC GMV share' datatype='real' name='[Calculation_5425570967403634688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_gmv])&#10;/&#10;SUM([gmv])' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;TR&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    When &quot;Pandora&quot; then &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='All Platform Mau Country Average' datatype='real' name='[all_platform_mau_country_average]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
