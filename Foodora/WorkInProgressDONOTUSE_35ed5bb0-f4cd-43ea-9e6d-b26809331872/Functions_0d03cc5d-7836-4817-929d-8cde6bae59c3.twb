      <column caption='Dmart Pct Weighted Availability V2 MOM' datatype='real' name='[Calculation_4501558987588059160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='GMV target calc' datatype='real' name='[Calculation_5216294321427087367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([country]) = &quot;Bangladesh&quot; THEN &#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Hong Kong&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Cambodia&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Laos&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Myanmar&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Malaysia&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.10&#10;ELSEIF ATTR([country]) = &quot;Philippines&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.17&#10;ELSEIF ATTR([country]) = &quot;Pakistan&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.17&#10;ELSEIF ATTR([country]) = &quot;Singapore&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.22&#10;ELSEIF ATTR([country]) = &quot;Thailand&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Taiwan&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Austria&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Czech Republic&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Finland&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Hungary&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.15&#10;ELSEIF ATTR([country]) = &quot;Norway&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.16&#10;ELSEIF ATTR([country]) = &quot;Sweden&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.14&#10;ELSEIF ATTR([country]) = &quot;Turkey&quot; THEN&#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END) * 1.23&#10;ELSE &#10;    SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END)&#10;END' />
      </column>
      <column caption='[agg] QC GMV share' datatype='real' name='[Calculation_5425570967403634688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qc_gmv])&#10;/&#10;SUM([gmv])' />
      </column>
      <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
      </column>
      <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;TR&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    When &quot;Pandora&quot; then &quot;Pandora&quot;&#10;END' />
      </column>
      <column caption='[agg] HVA Percentage' datatype='real' name='[Calculation_5829206083599650835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dh_hva_incentive])&#10;/&#10;sum([total_dh_incentive])' />
      </column>
      <column caption='qc rejection % 2' datatype='real' name='[Calculation_5967691721129730048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;  SUM([ssu_QC_rejection_rate] * [SSU_acquisition]) +&#10;  SUM([non_ssu_QC_rejection_rate] * ([Total_acquisition] - [SSU_acquisition]))&#10;) / &#10;SUM([Total_acquisition])' />
      </column>
      <column caption='[agg] healthy vendors' datatype='real' name='[Calculation_6404963148140711936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([healthy_vendor_availability_n])&#10;/&#10;sum([healthy_vendor_availability_d])' />
      </column>
