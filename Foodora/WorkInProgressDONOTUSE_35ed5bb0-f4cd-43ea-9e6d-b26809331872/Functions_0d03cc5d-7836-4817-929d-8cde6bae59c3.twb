          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='[agg] % Orders late more than 30 min - QC and Resto' datatype='real' name='[Calculation_1517361276978343936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1517361276979478529])&#10;/&#10;sum([Calculation_1517361276979666946])' />
            </column>
            <column caption='total late orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979478529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_late_darkstores] + [n_late_restaurants] + [n_late_shops]' />
            </column>
            <column caption='total orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979666946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_shop_orders] + [n_restaurant_orders] + [n_darkstore_orders]' />
            </column>
            <column caption='[agg] shrinkage' datatype='real' name='[Calculation_1520246402929152002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shrink_orders])&#10;/&#10;sum([forecasted_orders])' />
            </column>
            <column caption='[agg] incidents rate' datatype='real' name='[Calculation_1520246402931109891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_incidents_customer] + [total_incidents_vendor] + [total_incidents_rider])&#10;/&#10;SUM([gross_orders])' />
            </column>
            <column caption='[agg] fail rate' datatype='real' name='[Calculation_1520246402932019204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders])&#10;/&#10;sum([gross_orders])' />
            </column>
            <column caption='[agg] avg onboarding age days' datatype='real' name='[Calculation_1520246402933256197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([onboarding_age_days])&#10;/&#10;sum([onboarded_vendors])' />
            </column>
            <column caption='[agg] stacking %' datatype='real' name='[Calculation_426856855905968128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stacked_delivery_count])&#10;/&#10;sum([completed_delivery_count])' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;TR&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    When &quot;Pandora&quot; then &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='[agg] healthy vendors' datatype='real' name='[Calculation_6404963148140711936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([healthy_vendor_availability_n])&#10;/&#10;sum([healthy_vendor_availability_d])' />
            </column>
            <column caption='[agg] on time delivery' datatype='real' name='[Calculation_6636476317117718528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([on_time_okr_weighted_per_pdt_pct] * [gross_orders])&#10;/&#10;sum([gross_orders])' />
            </column>
            <column caption='Cancelled Orders' datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column caption='Completed Delivery Count' datatype='integer' name='[completed_delivery_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
