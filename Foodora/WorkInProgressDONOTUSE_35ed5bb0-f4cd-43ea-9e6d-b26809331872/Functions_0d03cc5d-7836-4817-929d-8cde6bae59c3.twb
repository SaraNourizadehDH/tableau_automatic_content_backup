      <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
        <column caption='Acquisitions + reacquisitions' datatype='integer' name='[Calculation_139752371579179010]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[acquisitions] + [reacquisitions]' />
        </column>
        <column caption='[agg] % Orders late more than 30 min - QC and Resto' datatype='real' name='[Calculation_1517361276978343936]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([Calculation_1517361276979478529])&#10;/&#10;sum([Calculation_1517361276979666946])' />
        </column>
        <column caption='[agg] shrinkage' datatype='real' name='[Calculation_1520246402929152002]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shrink_orders])&#10;/&#10;sum([forecasted_orders])' />
        </column>
        <column caption='[agg] incidents rate' datatype='real' name='[Calculation_1520246402931109891]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([total_incidents_customer] + [total_incidents_vendor] + [total_incidents_rider])&#10;/&#10;SUM([gross_orders])' />
        </column>
        <column caption='[agg] fail rate' datatype='real' name='[Calculation_1520246402932019204]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([cancelled_orders])&#10;/&#10;sum([gross_orders])' />
        </column>
        <column caption='[agg] avg onboarding age days' datatype='real' name='[Calculation_1520246402933256197]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([onboarding_age_days])&#10;/&#10;sum([onboarded_vendors])' />
        </column>
        <column caption='[agg] % SSU Self Onboarding' datatype='real' name='[Calculation_162059281434710016]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([E2E_ssu_Lead])&#10;/&#10;sum([valid_leads])' />
        </column>
        <column caption='[agg] VFD GMV' datatype='real' name='[Calculation_3984137611677024256]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(total_incentive_cost_vendor_incl_manual_adjustment_eur)&#10;/&#10;sum([gmv_eur])' />
        </column>
        <column caption='[agg] stacking %' datatype='real' name='[Calculation_426856855905968128]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([stacked_delivery_count])&#10;/&#10;sum([completed_delivery_count])' />
        </column>
        <column caption='[agg] Dmart Pct Weighted Availability V2' datatype='real' name='[Calculation_4501558987557949440]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([dmart_wa_num])&#10;/&#10;sum([dmart_wa_den])' />
        </column>
        <column caption='[agg] shops key partners per MAU' datatype='real' name='[Calculation_4501558987558252545]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([key_partner_country_average])&#10;/&#10;sum([all_platform_mau_country_average])' />
        </column>
        <column caption='[agg] shops pct promo gpv contribution' datatype='real' name='[Calculation_4501558987559272450]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shops_promo_gpv_contribution_num])&#10;/&#10;sum([shops_promo_gpv_contribution_den])' />
        </column>
        <column caption='[agg] items not delivered' datatype='real' name='[Calculation_4501558987562876933]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shops_items_not_delivered_excl_post_delivery_num])&#10;/&#10;sum([shops_items_not_delivered_den])' />
        </column>
        <column caption='shops offline' datatype='real' name='[Calculation_4501558987563614214]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([shops_offline_num]) &#10;/ &#10;sum([shops_offline_den])' />
        </column>
        <column caption='[agg] dmart fresh penetration' datatype='real' name='[Calculation_4501558987565342728]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([dmart_fresh_orders])&#10;/&#10;sum([dmart_orders])' />
        </column>
        <column caption='[agg] QC GMV share' datatype='real' name='[Calculation_5425570967403634688]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([qc_gmv])&#10;/&#10;SUM([gmv])' />
        </column>
        <column caption='[agg] HVA Percentage' datatype='real' name='[Calculation_5829206083599650835]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([dh_hva_incentive])&#10;/&#10;sum([total_dh_incentive])' />
        </column>
        <column caption='[agg] healthy vendors' datatype='real' name='[Calculation_6404963148140711936]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([healthy_vendor_availability_n])&#10;/&#10;sum([healthy_vendor_availability_d])' />
        </column>
        <column caption='[agg] VFD GMV AO' datatype='real' name='[Calculation_6404963148143558658]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([ao_vendor_eur])&#10;/&#10;sum([gmv_eur])' />
        </column>
        <column caption='[agg] Markup vendor penetration' datatype='real' name='[Calculation_6404963148144824323]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='sum([total_markup_vendors])&#10;/&#10;sum([total_vendors_markup_calc])' />
