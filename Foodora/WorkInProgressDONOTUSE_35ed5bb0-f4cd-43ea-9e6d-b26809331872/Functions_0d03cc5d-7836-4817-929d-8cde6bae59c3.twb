          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='[agg] % SSU Self Onboarding' datatype='real' name='[Calculation_162059281434710016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([E2E_ssu_Lead])&#10;/&#10;sum([valid_leads])' />
            </column>
            <column caption='[agg] VFD GMV' datatype='real' name='[Calculation_3984137611677024256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(total_incentive_cost_vendor_incl_manual_adjustment_eur)&#10;/&#10;sum([gmv_eur])' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;TR&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    When &quot;Pandora&quot; then &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='[agg] VFD GMV AO' datatype='real' name='[Calculation_6404963148143558658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ao_vendor_eur])&#10;/&#10;sum([gmv_eur])' />
            </column>
            <column caption='[agg] Markup vendor penetration' datatype='real' name='[Calculation_6404963148144824323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_markup_vendors])&#10;/&#10;sum([total_vendors_markup_calc])' />
            </column>
            <column caption='[agg] offline %' datatype='real' name='[Calculation_6404963148145274884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([closed_hours])&#10;/&#10;sum([scheduled_hours])' />
            </column>
            <column caption='[agg} vfd self booking ratio' datatype='real' name='[Calculation_6404963148147814405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_vendors_with_vfd_sb_deals_self_booking])&#10;/&#10;sum([total_vendors_sb])' />
            </column>
            <column caption='[agg] ncr self booking' datatype='real' name='[Calculation_6404963148148375558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_ncr_sb_vendors])&#10;/&#10;sum([total_vendors_with_order])' />
            </column>
            <column caption='[agg] sb ratio' datatype='real' name='[Calculation_6404963148148895751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_vendors_with_vfd_sb_deals])&#10;/&#10;sum([total_vendors_with_vfd])' />
            </column>
            <column caption='[agg] successful AB vendor %' datatype='real' name='[Calculation_6404963148150341640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_vendors])&#10;/&#10;sum([total_vendors_sf])' />
            </column>
            <column caption='[agg] disco cofunding ratio' datatype='real' name='[Calculation_6404963148150796297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([disco_vendor_eur])&#10;/&#10;sum([disco_eur])' />
            </column>
            <column caption='[agg] AB zombie % ' datatype='real' name='[Calculation_6404963148151656458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ab_zombie_vendors])&#10;/&#10;sum([sa_ka_vendors])' />
            </column>
            <column caption='[agg] vfd vendor penetration' datatype='real' name='[Calculation_6404963148151947275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vf_vendors])&#10;/&#10;sum([vendors])' />
            </column>
            <column caption='[agg] qc rejection %' datatype='real' name='[Calculation_6404963148166717455]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([QC_rejection_rate] * [Total_acquisition]) / SUM([Total_acquisition])' />
