    <worksheet name='marketing vs target by market'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandora_targets (markets_analytics)' name='federated.02x0gd30ok8vdn19paqtc0kdb343' />
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.02x0gd30ok8vdn19paqtc0kdb343'>
            <column caption='acquisitions + reacquisitions vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311154954257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_139752371579179010])&#10;    - sum([target_user_acq_reacq])&#10;)&#10;/&#10;sum([target_user_acq_reacq])' />
            </column>
            <column caption='QC Trials vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311158779923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[qc_trials]) &#10;    - sum([target_qc_trials])&#10;)&#10;/&#10;sum([target_qc_trials])' />
            </column>
            <column caption='is dh leading install vs target' datatype='real' name='[Calculation_1520246402918055937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[is_dh_leading_install])&#10;    - sum([target_markets_leading_downloads])&#10;)&#10;/&#10;sum([target_markets_leading_downloads])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_2118451067793895426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU (Excl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU (Incl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='NULL 1' datatype='integer' name='[Calculation_2118451067797504003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='mau vs target' datatype='real' name='[Calculation_2811161014219440132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[MAU])&#10;- &#10;sum([target_MAU])&#10;)&#10;/&#10;sum([target_MAU])' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='Subscriber % GMV vs target' datatype='real' name='[HVA % vs target (copy)_1654509965043863556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[[agg]] subscriber mau share (copy)_2179883011273740291]&#10;    - AVG([NULL Pro Deal vendor penetration (copy)_2271925341369888768])&#10;) &#10;* 100' />
            </column>
            <column caption='NULL 2' datatype='integer' name='[NULL 1 (copy)_2118451067797561348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='NULL Subscriber % of GMV' datatype='real' name='[NULL Pro Deal vendor penetration (copy)_2271925341369888768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_subscriber_gmv_share] = 0 THEN NULL ELSE [target_subscriber_gmv_share] END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='retention rate vs target' datatype='real' name='[fail rate vs target (copy)_560909311154389008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6404963148166184974]&#10;    - AVG([target_retention_rate])&#10;) &#10;* 100' />
            </column>
            <column-instance column='[Calculation_2118451067793895426]' derivation='None' name='[none:Calculation_2118451067793895426:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_560909311124627459]' derivation='None' name='[none:Calculation_560909311124627459:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='HVA % vs target' datatype='real' name='[retention rate vs target (copy)_1654509965043617795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_5829206083599650835]&#10;    - AVG([target_hva_dhd_share])&#10;) &#10;* 100' />
            </column>
            <column caption='QC MAU share vs target' datatype='real' name='[shrinkage vs target (copy)_560909311158398994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6404963148162633740] &#10;    - avg([target_qc_mau_platform_share])&#10;) &#10;* 100' />
            </column>
