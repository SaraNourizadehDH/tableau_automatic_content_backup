      <column caption='[agg] DLP' datatype='real' name='[Calculation_1520246402933694470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_products_with_images])&#10;/&#10;sum([active_products])' />
      </column>
