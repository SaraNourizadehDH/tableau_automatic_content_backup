            <column caption='% orders late 30mins MoM' datatype='real' name='[successful ab vendors MoM (copy)_1559723260984819714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [Calculation_1517361276979478529]  END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [Calculation_1517361276979666946]  END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [Calculation_1517361276979478529] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [Calculation_1517361276979666946]  END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='healthy vendors MoM' datatype='real' name='[successful ab vendors MoM (copy)_5829206083541450752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [healthy_vendor_availability_n] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [healthy_vendor_availability_d] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [healthy_vendor_availability_n] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [healthy_vendor_availability_d] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
