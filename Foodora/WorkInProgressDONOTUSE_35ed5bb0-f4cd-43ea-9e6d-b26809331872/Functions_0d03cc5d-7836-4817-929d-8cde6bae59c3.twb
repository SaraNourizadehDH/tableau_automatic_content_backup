      <table>
        <view>
          <datasources>
            <datasource caption='pandora_targets (markets_analytics)' name='federated.02x0gd30ok8vdn19paqtc0kdb343' />
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.02x0gd30ok8vdn19paqtc0kdb343'>
            <column caption='NULL (Shops Ops) % items not delivered' datatype='real' name='[(Shops Ops) % items not delivered (copy)_4984218167060668425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_shops_items_not_delivered_share] = 0 THEN NULL ELSE [target_shops_items_not_delivered_share] END' />
            </column>
            <column caption='shops key partners per mau vs target' datatype='real' name='[AB acquisitions vs target (copy)_4501558987575201801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_4501558987558252545]&#10;    - avg([target_shops_key_partners_per_mau])&#10;)&#10;/&#10;avg([target_shops_key_partners_per_mau])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_2118451067793895426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU (Excl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU (Incl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='QC GMV share vs target' datatype='real' name='[QC MAU share vs target (copy)_1654509965044359173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_5425570967403634688]&#10;    - AVG([target_qc_gmv_share])&#10;) &#10;* 100' />
            </column>
            <column caption='items not delivered vs target' datatype='real' name='[QC MAU share vs target (copy)_560909311159058452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_4501558987562876933]&#10;    - avg([(Shops Ops) % items not delivered (copy)_4984218167060668425])&#10;) &#10;* 100' />
            </column>
            <column caption='Shops AAA supermarket active products vs target' datatype='real' name='[QC Trials vs target (copy)_560909311189090328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[shops_aaa_supermarket_active_products])&#10;    - SUM([target_shops_aaa_supermarket_assortment])&#10;)&#10;/&#10;SUM([target_shops_aaa_supermarket_assortment])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='dmart promotion score vs target' datatype='real' name='[dmart aqs 6 vs target (copy)_4501558987580653583 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;MAX([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[dmart_promotion_quality_score])&#10;    - MAX([target_dmart_promotion_quality_score])&#10;)&#10;/&#10;MAX([target_dmart_promotion_quality_score])' />
