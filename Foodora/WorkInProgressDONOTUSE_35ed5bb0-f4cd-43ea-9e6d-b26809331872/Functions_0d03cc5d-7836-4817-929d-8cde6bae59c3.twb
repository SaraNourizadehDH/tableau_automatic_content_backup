            </column>
            <column caption='QC Rejection % MoM' datatype='real' name='[sb ratio MoM (copy)_5829206083550240782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(&#10;  SUM(&#10;    IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) &#10;    THEN [QC_rejection_rate] * [Total_acquisition] &#10;    END&#10;  ) &#10;  / &#10;  SUM(&#10;    IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) &#10;    THEN [Total_acquisition] &#10;    END&#10;  )&#10;)&#10;-&#10;(&#10;  SUM(&#10;    IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) &#10;    THEN [QC_rejection_rate] * [Total_acquisition] &#10;    END&#10;  ) &#10;  / &#10;  SUM(&#10;    IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) &#10;    THEN [Total_acquisition] &#10;    END&#10;  )&#10;)&#10;)&#10;* 100' />
            </column>
