            <column caption='Gmv Contribtuion Percent B' datatype='real' name='[gmv_contribtuion_percent_b]' role='measure' type='quantitative' />
            <column caption='is dh leading install YOY' datatype='real' name='[is dh leading install MoM (copy)_5829206083624095766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [is_dh_leading_install] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [is_dh_leading_install] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [is_dh_leading_install] END)' />
            </column>
            <column aggregation='CountD' caption='Is Dh Leading Install' datatype='real' datatype-customized='true' name='[is_dh_leading_install]' role='measure' type='quantitative' />
