    <worksheet name='commercial vs target'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandora_targets (markets_analytics)' name='federated.02x0gd30ok8vdn19paqtc0kdb343' />
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.02x0gd30ok8vdn19paqtc0kdb343'>
            <column caption='NULL % Zombies AB' datatype='real' name='[% Zombies AB (copy)_4984218167055355907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_zombies_ab] = 0 THEN NULL ELSE [target_zombies_ab] END' />
            </column>
            <column caption='NULL %NCR self booking' datatype='real' name='[%NCR self booking (copy)_4984218167055761412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_ncr_self_bookings] = 0 THEN NULL ELSE [target_ncr_self_bookings] END' />
            </column>
            <column caption='NULL %SSU self onboarding' datatype='real' name='[%SSU self onboarding (copy)_4984218167052034049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_ssu_self_onboardings] = 0 THEN NULL ELSE [target_ssu_self_onboardings] END' />
            </column>
            <column caption='SSU acquisitions vs target' datatype='real' name='[AB acquisitions vs target (copy)_162059281435873281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[SSU_acquisition])&#10;    - sum([target_ssu_acqs])&#10;)&#10;/&#10;sum([target_ssu_acqs])' />
            </column>
            <column caption='Vendor acquisitions vs target' datatype='real' name='[AB acquisitions vs target (copy)_1654509965068763145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[total_vendor_aquisitions])&#10;    - sum([target_vendor_acquisitions])&#10;)&#10;/&#10;sum([target_vendor_acquisitions])' />
            </column>
            <column caption='active inventory &gt; 1 order vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311130619910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ogv_vendors]) &#10;- sum([target_total_active_inventory]) &#10;)&#10;/&#10;sum([target_total_active_inventory])' />
            </column>
            <column caption='VFD GMV vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311132831751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_3984137611677024256] - avg([target_vfd_gmv_food]) )&#10;* 100' />
            </column>
            <column caption='Sales rep vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311185084437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;AVG([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[productivity])&#10;    - AVG([target_sales_rep_productivity])&#10;)&#10;/&#10;AVG([target_sales_rep_productivity])' />
            </column>
            <column caption='gtc vs target' datatype='real' name='[AB acquisitions vs target (copy)_6495246247298727938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[total_gtc_ab_acq])&#10;    - sum([target_ab_gap])&#10;)&#10;/&#10;sum([target_ab_gap])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_2118451067793895426]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU (Excl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU (Incl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='NULL % VFD with online markups' datatype='real' name='[Calculation_5107715350538956802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_vfd_online_markups] = 0 THEN NULL ELSE [target_vfd_online_markups] END' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='AB acquisitions vs target' datatype='real' name='[Calculation_560909311127298053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ab_aquisitions]) &#10;    - sum([target_ab_acquisition])&#10;)&#10;/&#10;sum([target_ab_acquisition])' />
            </column>
            <column caption='NULL Campaign - % Cofunding Ratio' datatype='real' name='[Campaign - % Cofunding Ratio (copy)_4984218167056105478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_cofund_ratio] = 0 THEN NULL ELSE [target_cofund_ratio] END' />
            </column>
            <column caption='VFD GMV AO vs target' datatype='real' name='[HVA % vs target (copy)_1654509965086756874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6404963148143558658]&#10;    - AVG([target_vfd_gmv_food_ao])&#10;) &#10;* 100' />
            </column>
            <column caption='cofunding ratio vs target' datatype='real' name='[Loyalty vs target (copy)_5216294321417515011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6404963148150796297] - AVG([Campaign - % Cofunding Ratio (copy)_4984218167056105478]) )&#10;* 100' />
