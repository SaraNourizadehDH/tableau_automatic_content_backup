            </column>
            <column caption='VFD GMV MOM' datatype='real' name='[Calculation_3984137611677843457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;TR&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    When &quot;Pandora&quot; then &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='E2E ssu Lead' datatype='integer' name='[E2E_ssu_Lead]' role='measure' type='quantitative' />
            <column caption='% ssu self onboarding MoM' datatype='real' name='[Fail rate MoM (copy)_162059281437519875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [E2E_ssu_Lead] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [valid_leads] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [E2E_ssu_Lead] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [valid_leads] END)&#10;    )&#10;) * 100' />
