            </column>
            <column caption='AB GTC MoM' datatype='real' name='[AB Acquisitions MoM (copy)_5829206083545616388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_gtc_ab_acq] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_gtc_ab_acq] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_gtc_ab_acq] END)' />
            </column>
            <column caption='VFD Vendor % MoM' datatype='real' name='[AB Zombies % MoM (copy)_1654509965038370816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vf_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vendors] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vf_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vendors] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD GMV AO MoM' datatype='real' name='[AB Zombies % MoM (copy)_1654509965049520135]' role='measure' type='quantitative'>
