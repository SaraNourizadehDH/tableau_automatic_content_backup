            <column caption='NULL % Zombies AB' datatype='real' name='[% Zombies AB (copy)_4984218167055355907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [target_zombies_ab] = 0 THEN NULL ELSE [target_zombies_ab] END' />
