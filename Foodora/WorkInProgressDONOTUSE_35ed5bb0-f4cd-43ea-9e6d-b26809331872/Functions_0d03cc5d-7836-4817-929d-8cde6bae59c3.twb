        <calculation class='tableau' formula='sum([E2E_ssu_Lead])&#10;/&#10;sum([valid_leads])' />
      </column>
      <column caption='productivity MOM' datatype='real' name='[Calculation_162059281440677895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [productivity] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [productivity]  END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [productivity]  END)' />
      </column>
      <column caption='Null' datatype='integer' name='[Calculation_2118451067745861632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Dashboard refresh' datatype='datetime' name='[Calculation_2179883011286724612]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='NOW()' />
      </column>
      <column caption='gmv vs target' datatype='real' name='[Calculation_2811161014204100609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv] END)&#10;-&#10;SUM([federated.0a87wdf0rz2sml15ot1g30uedy47].[GMV])&#10;)&#10;/&#10;SUM([federated.0a87wdf0rz2sml15ot1g30uedy47].[GMV])' />
      </column>
      <column caption='[agg] VFD GMV' datatype='real' name='[Calculation_3984137611677024256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_incentive_cost_vendor_incl_manual_adjustment_eur)&#10;/&#10;sum([gmv_eur])' />
      </column>
      <column caption='VFD GMV MOM' datatype='real' name='[Calculation_3984137611677843457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='GMV MoM' datatype='real' name='[Calculation_4174555420583063553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv] END)' />
      </column>
      <column caption='[agg] stacking %' datatype='real' name='[Calculation_426856855905968128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stacked_delivery_count])&#10;/&#10;sum([completed_delivery_count])' />
