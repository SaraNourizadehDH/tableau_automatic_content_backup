    <worksheet name='GFV: Daily Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__dfi_vendor_performance_report (pandata_report)' name='federated.0y8gqmz0xdnsns178wmlq1x99i1t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0y8gqmz0xdnsns178wmlq1x99i1t'>
            <column caption='% Online Rate' datatype='real' default-format='p0.0%' name='[% Partial Order Rate (copy)_3367074067779182622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([total_closed_mins]) / SUM([total_scheduled_open_mins])' />
            </column>
            <column caption='Is L7W' datatype='boolean' name='[Calculation_1206683261978087424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt; DATEADD(&apos;week&apos;, -8, NOW()) AND [report_date] &lt;= DATETRUNC(&apos;week&apos;,NOW()) - 1' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_3367074067731832834]' role='measure' type='quantitative'>
