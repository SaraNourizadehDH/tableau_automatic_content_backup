      <aliases enabled='yes' />
      <column caption='% Prepped Orders Delayed' datatype='real' default-format='p0.0%' name='[% Active SKU (copy)_3367074067793887271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([num_of_valid_orders_within_allocated_prep_time]) / SUM([num_of_valid_prepped_orders])' />
      </column>
      <column caption='% Active Vendor Product' datatype='real' default-format='p0.0%' name='[% Active SKU (copy)_6566951972868165633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_active_vendor_product]) / SUM([num_of_vendor_product])' />
      </column>
      <column caption='% Online Rate (Night)' datatype='real' default-format='p0.0%' name='[% Online Rate (Day) (copy)_1144477284696731649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_night_closed_mins]) / SUM([total_night_scheduled_open_mins])' />
      </column>
      <column caption='% Online Rate (Day)' datatype='real' default-format='p0.0%' name='[% Online Rate (copy)_1144477284694724608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_day_closed_mins]) / SUM([total_day_scheduled_open_mins])' />
      </column>
      <column caption='% Online Rate' datatype='real' default-format='p0.0%' name='[% Partial Order Rate (copy)_3367074067779182622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_closed_mins]) / SUM([total_scheduled_open_mins])' />
      </column>
      <column caption='% Found Rate' datatype='real' default-format='p0.0%' name='[% Partial Order Rate (copy)_4310859666876973056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_delivered_quantity]) / SUM([num_of_valid_ordered_quantity])' />
      </column>
      <column caption='% Partial Order Rate' datatype='real' default-format='p0.0%' name='[% Preorders (copy)_3367074067775995929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_partially_fulfilled_excl_post_delivery_orders]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='% Assigned Orders Delayed' datatype='real' default-format='p0.0%' name='[% Prepped Orders Delayed (copy)_3367074067796398121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([num_of_valid_orders_within_1min_acceptance_time]) / SUM([num_of_valid_assigned_orders])' />
      </column>
      <column caption='% On Time Delivery Orders' datatype='real' default-format='p0.0%' name='[% Prepped Orders Delayed (copy)_4429149525862068230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_orders_delivery_within_5min_15min_promised_time]) / SUM([num_of_deliveries_time_not_null])' />
      </column>
      <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[% Vendor Fail Rate (copy)_4429149525856038915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_failed_orders]) / SUM([num_of_orders])' />
      </column>
      <column caption='Prep Time Mins per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABS (copy)_3367074067787960355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prep_time_mins]) / SUM([num_of_valid_prepped_orders])' />
      </column>
      <column caption='ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABV (copy)_3367074067763359757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_delivered_quantity]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='iCPGMV' datatype='real' default-format='p0.0%' name='[ABV (copy)_4395724372366782467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([incentive_cost_local]) / SUM([gmv_local])' />
      </column>
      <column caption='Delivery Fee per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABV (copy)_4429149525866246153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4429149525866299403]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='Is L7W' datatype='boolean' name='[Calculation_1206683261978087424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt; DATEADD(&apos;week&apos;, -8, NOW()) AND [report_date] &lt;= DATETRUNC(&apos;week&apos;,NOW()) - 1' />
      </column>
      <column caption='OOS GMV Loss' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_1214916368482271232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([gfv_loss_excl_post_delivery_local]) + ZN([failed_vendor_product_unavailable_gfv_loss_excl_post_delivery_local])' />
      </column>
      <column caption='Drive Time Mins per Order' datatype='real' name='[Calculation_1913678034072330240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([drive_time_mins])/SUM([num_of_valid_drive_time_orders])' />
      </column>
      <column caption='% Orders Early' datatype='real' name='[Calculation_1913678034077069314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_orders_delivery_more_than_equal_15min_earlier_promised_time])/SUM([num_of_deliveries_time_not_null])' />
      </column>
      <column caption='% Orders Late' datatype='real' name='[Calculation_1913678034079854596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_orders_delivery_more_than_equal_5min_later_promised_time])/SUM([num_of_deliveries_time_not_null])' />
      </column>
      <column caption='GFV' datatype='real' name='[Calculation_3367074067731832834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(IF [Parameters].[Parameter 1] = &quot;Local&quot; THEN [gfv_local] ELSE [gfv_eur] END, 0)' />
      </column>
      <column caption='Currency Symbol' datatype='string' name='[Calculation_3367074067732029443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; THEN &quot;$&quot; ELSE &quot;€&quot; END' />
      </column>
      <column caption='L7D v P7D' datatype='string' name='[Calculation_3367074067735347206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D&apos;&#10;END' />
      </column>
      <column caption='ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3367074067760066571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3367074067731832834]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='Active Vendors' datatype='integer' name='[Calculation_3367074067777503259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_active] THEN [vendor_code] + &quot;_&quot; + [global_entity_id] END)' />
      </column>
      <column caption='Vendor CVR' datatype='real' default-format='p0.0%' name='[Calculation_4394246630074871808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_vendor_transaction_sessions])&#10;/&#10;SUM([num_of_vendor_sessions])' />
      </column>
      <column caption='Daily: Vendor CVR' datatype='real' default-format='p0.0%' name='[Calculation_4394246630075834370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_type], [Calculation_3367074067735347206], [report_date], [global_entity_id]: &#10;SUM(&#10;{FIXED [date_type], [Calculation_3367074067735347206], [Calculation_6566951972865306624], [report_date], [global_entity_id]: &#10;(IF [% Partial Order Rate (copy)_3367074067779182622] &gt;= 0 THEN SUM([num_of_vendor_transaction_sessions]) END)}&#10;)&#10;/&#10;SUM(&#10;{FIXED [date_type], [Calculation_3367074067735347206], [Calculation_6566951972865306624], [report_date], [global_entity_id]: &#10;(IF [% Partial Order Rate (copy)_3367074067779182622] &gt;= 0 THEN SUM([num_of_vendor_sessions]) END)}&#10;)&#10;&#10;}' />
      </column>
      <column caption='Number of Vendor EC' datatype='integer' name='[Calculation_4395724372364177408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_vendor_customer]) - SUM([num_of_vendor_nc])' />
      </column>
      <column caption='Delivery Time Mins' datatype='real' name='[Calculation_4429149525860397060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_non_preorder_mins]) / SUM([num_of_deliveries_time_not_null])' />
      </column>
      <column caption='Delivery Fee' datatype='real' name='[Calculation_4429149525866299403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; THEN [delivery_fee_local] ELSE [delivery_fee_eur] END' />
      </column>
      <column caption='Outlet ' datatype='string' name='[Calculation_6566951972865306624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_EXTRACT([vendor_name], &apos;\((.*?)\)&apos;)' />
      </column>
      <column caption='Daily Vendor Sessions' datatype='integer' default-format='n#,##0;-#,##0' name='[Daily Valid Orders (copy)_4394246630076899331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_type], [Calculation_3367074067735347206], [report_date], [global_entity_id]: &#10;SUM(&#10;{FIXED [date_type], [Calculation_3367074067735347206], [Calculation_6566951972865306624], [report_date], [global_entity_id]: &#10;(IF [% Partial Order Rate (copy)_3367074067779182622] &gt;= 0 THEN SUM([num_of_vendor_sessions]) END)}&#10;)&#10;}' />
      </column>
      <column caption='% Incident Rate' datatype='real' default-format='p0.0%' name='[Ext: % Non Nego Incident Rate (External) (copy)_4370743468177858563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([num_of_issues])) / SUM([num_of_orders])' />
      </column>
      <column caption='% Seamless Order Rate' datatype='real' default-format='p0.0%' name='[Ext: % Seamless Order Rate (copy)_4370743468178763781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_seamless_orders_internal]) / SUM([num_of_seamless_orders_denominator_internal])' />
      </column>
      <column caption='% Preorders' datatype='real' default-format='p0.0%' name='[Ext: % Vendor Fail Rate (copy)_3367074067774668823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_preorders]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Ext: % Vendor Fail Rate (copy)_4370743468176797696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_vendor_failed_orders]) / SUM([num_of_orders])' />
