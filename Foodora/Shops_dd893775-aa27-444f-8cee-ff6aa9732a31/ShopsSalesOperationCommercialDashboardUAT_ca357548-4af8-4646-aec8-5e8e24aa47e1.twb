    <worksheet name='time series - incubation 30d'>
      <table>
        <view>
          <datasources>
            <datasource caption='shops__operation_commercial_sales_incubation_30d_dashboard (pandata_report)' name='federated.06nk0oy025xiin0zsx4fn1hb80c7' />
            <datasource caption='shops__operation_commercial_sales_activation_dashboard (pandata_report)' name='federated.03ji5iq13rfw3j17cidv61uqynmw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Incubated 30d Metrics' datatype='string' name='[Activated Metrics （複製）_483362948535410699]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Incubation 30 Days Vendor Count&quot;'>
              <calculation class='tableau' formula='&quot;Total Incubation 30 Days Vendor Count&quot;' />
            </column>
            <column caption='day_type' datatype='string' name='[choose_dimension （複製）]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='choose_dimension' datatype='string' name='[參數 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global Entity&quot;'>
              <calculation class='tableau' formula='&quot;Global Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03ji5iq13rfw3j17cidv61uqynmw'>
            <column caption='aaa_shop' datatype='string' name='[Calculation_1120129714169438209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_aaa_shop_vendor] THEN &quot;KP&quot; ELSE &quot;Non-KP&quot; END' />
            </column>
            <column datatype='string' name='[delivery_service_types]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_cleaned_vertical_segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_aaa_shop_vendor]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_ssu_vendor]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1120129714169438209]' derivation='None' name='[none:Calculation_1120129714169438209:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_service_types]' derivation='None' name='[none:delivery_service_types:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_cleaned_vertical_segment]' derivation='None' name='[none:global_cleaned_vertical_segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_ssu_vendor]' derivation='None' name='[none:is_ssu_vendor:nk]' pivot='key' type='nominal' />
            <column-instance column='[sf_opportunity_owner_name]' derivation='None' name='[none:sf_opportunity_owner_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[sf_opportunity_owner_title]' derivation='None' name='[none:sf_opportunity_owner_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[sf_vertical_segment]' derivation='None' name='[none:sf_vertical_segment:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[sf_opportunity_owner_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[sf_opportunity_owner_title]' role='dimension' type='nominal' />
            <column datatype='string' name='[sf_vertical_segment]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06nk0oy025xiin0zsx4fn1hb80c7'>
            <column caption='1-5 Orders Vendor Count %' datatype='real' name='[1-5 Orders Vendor Count （複製）_1120129714283397144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([one_to_five_orders_vendor_count]) / SUM([total_incubation_30_days_vendor_count])' />
            </column>
            <column caption='11-15 Orders Vendor Count %' datatype='real' name='[11-16 Orders Vendor Count （複製）_1120129714283503641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eleven_to_fifteen_orders_vendor_count]) / SUM([total_incubation_30_days_vendor_count])' />
            </column>
            <column caption='16-30 Orders Vendor Count %' datatype='real' name='[16-30 Orders Vendor Count （複製）_1120129714283601946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sixteen_to_thirty_orders_vendor_count]) / SUM([total_incubation_30_days_vendor_count])' />
            </column>
            <column caption='6-10 Orders Vendor Count %' datatype='real' name='[6-10 Orders Vendor Count （複製）_1120129714283683867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([six_to_ten_orders_vendor_count]) / SUM([total_incubation_30_days_vendor_count])' />
            </column>
            <column caption='&gt; 30 Orders Vendor Count %' datatype='real' name='[&gt; 30 Orders Vendor Count （複製）_483362948514082816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([more_than_thirty_orders_vendor_count]) / SUM([total_incubation_30_days_vendor_count])' />
            </column>
            <column caption='aaa_shop' datatype='string' name='[Calculation_1120129714221580301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_aaa_shop_vendor] THEN &quot;KP&quot; ELSE &quot;Non-KP&quot; END' />
            </column>
            <column caption='dimensions' datatype='string' name='[Calculation_1120129714222317583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;  WHEN &quot;City&quot; THEN [city_name]&#10;  WHEN &quot;Global Entity&quot; THEN [global_entity_id]&#10;  WHEN &quot;Clean Vertical&quot; THEN [global_cleaned_vertical_segment]&#10;  WHEN &quot;SF Vertical Segment&quot; THEN [sf_vertical_segment]&#10;  WHEN &quot;AAA Shop&quot; THEN [Calculation_1120129714221580301]&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='Contacts per Vendor' datatype='real' name='[Calculation_1120129714225082384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_counts]) / SUM([total_incubation_30_days_vendor_count])' />
            </column>
            <column caption='All Shop GMV EUR' datatype='real' name='[Calculation_1120129714226712593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [incubated_30_days_date_local]: MAX([all_shop_gmv_eur]) }' />
            </column>
            <column caption='All Shop Orders' datatype='integer' name='[Calculation_1120129714226941970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [incubated_30_days_date_local]: MAX([all_shop_order_count]) }' />
            </column>
            <column caption='Valid Orders / All Shop Orders' datatype='real' name='[Calculation_1120129714227089427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_order_count]) / SUM([Calculation_1120129714226941970])' />
            </column>
            <column caption='Total Offline in Seconds' datatype='integer' name='[Calculation_1120129714287300637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_offline_in_seconds]) &#10;  + SUM([monitor_realtime_delays_rule_offline_in_seconds]) &#10;  + SUM([monitor_realtime_fails_rule_offline_in_seconds])&#10;  + SUM([monitor_unreachable_offline_in_seconds])&#10;  + SUM([other_offline_in_seconds])&#10;  + SUM([vendor_device_busy_mode_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_bad_weather_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_no_drivers_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_outside_schedule_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_renovation_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_technical_problem_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_updating_menu_offline_in_seconds])' />
            </column>
            <column caption='Incubation 30d Metrics Number' datatype='string' name='[Calculation_1785888403296571392]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Activated Metrics （複製）_483362948535410699] &#10;  WHEN &quot;Total Incubation 30 Days Vendor Count&quot; THEN STR(SUM([total_incubation_30_days_vendor_count]))&#10;  WHEN &quot;Zombie 30 Days Vendor Count&quot; THEN STR(SUM([zero_orders_vendor_count]))&#10;  WHEN &quot;Valid Order Count&quot; THEN STR(SUM([valid_order_count]))&#10;  WHEN &quot;Valid Order Count / All Shop Orders&quot; THEN STR(ROUND([Calculation_1120129714227089427] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Valid GMV EUR&quot; THEN STR(ROUND(SUM([valid_gmv_eur]), 0))&#10;  WHEN &quot;Valid GMV / All Shop GMV&quot; THEN STR(ROUND([Valid Orders / All Shop Orders （複製）_1120129714227417108] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Total Offline %&quot; THEN STR(ROUND([Total Offline in Seconds （複製）_218987576578068480] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Vendor Failed Order%&quot; THEN STR(ROUND([vendor_failed_order_count （複製）_1120129714286784540] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Contacts per Vendor&quot; THEN STR(ROUND([Calculation_1120129714225082384], 2))&#10;  &#10;  WHEN &quot;Zombie 30 Days Vendor Count %&quot; THEN STR(ROUND([Zombie 30 Days Vendor Count （複製）_1120129714261418005] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;1-5 Orders Vendor Count %&quot; THEN STR(ROUND([1-5 Orders Vendor Count （複製）_1120129714283397144] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;6-10 Orders Vendor Count %&quot; THEN STR(ROUND([6-10 Orders Vendor Count （複製）_1120129714283683867] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;11-15 Orders Vendor Count %&quot; THEN STR(ROUND([11-16 Orders Vendor Count （複製）_1120129714283503641] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;16-30 Orders Vendor Count %&quot; THEN STR(ROUND([16-30 Orders Vendor Count （複製）_1120129714283601946] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;&gt;30 Orders Vendor Count %&quot; THEN STR(ROUND([&gt; 30 Orders Vendor Count （複製）_483362948514082816] * 100, 2)) + &quot;%&quot;&#10;&#10;END' />
            </column>
            <column caption='dynamic_date' datatype='date' name='[Calculation_483362948556054540]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//IF [day_type] = &quot;Week&quot; &#10;//  THEN str(DATEPART(&apos;year&apos;,[activated_date_local])) + &quot;-&quot; + str(DATEPART(&quot;week&quot;, [activated_date_local]))&#10;//ELSEIF [day_type] = &quot;Day&quot; &#10;//  THEN str(DATEPART(&quot;day&quot;,[activated_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&quot;month&quot;,[activated_date_local])),3)&#10;//ELSEIF [day_type] = &quot;Month&quot;&#10;//  THEN LEFT(str(DATENAME(&quot;month&quot;,[activated_date_local])),3)+&apos; &apos;+RIGHT(str(DATEPART(&quot;year&quot;,[activated_date_local])),2) &#10;//END&#10;&#10;IF [Parameters].[choose_dimension （複製）] = &quot;Week&quot; THEN&#10;    DATE( DATETRUNC(&apos;week&apos;, [incubated_30_days_date_local]) ) &#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Day&quot; THEN&#10;    DATE( DATETRUNC(&apos;day&apos;, [incubated_30_days_date_local]) )&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Month&quot; THEN&#10;    DATE( DATETRUNC(&apos;month&apos;, [incubated_30_days_date_local]) )&#10;END' />
            </column>
            <column caption='dynamic_date_filter' datatype='boolean' name='[Calculation_483362948556525581]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[choose_dimension （複製）] = &apos;Month&apos; &#10;  THEN [incubated_30_days_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [incubated_30_days_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Week&apos; &#10;  THEN [incubated_30_days_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [incubated_30_days_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;week&apos;,TODAY()))&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Day&apos; &#10;  THEN [incubated_30_days_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [incubated_30_days_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
            </column>
