      <column caption='PP Activation Vendors' datatype='integer' name='[Activation Vendors （複製）_1120129714170937347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_preferred_partner] THEN [sf_opportunity_id] END)' />
      </column>
      <column caption='dimensions' datatype='string' name='[Calculation_1120129714168434688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;  WHEN &quot;City&quot; THEN [city_name]&#10;  WHEN &quot;Global Entity&quot; THEN [global_entity_id]&#10;  WHEN &quot;Clean Vertical&quot; THEN [global_cleaned_vertical_segment]&#10;  WHEN &quot;SF Vertical Segment&quot; THEN [sf_vertical_segment]&#10;  WHEN &quot;AAA Shop&quot; THEN [Calculation_1120129714169438209]&#10;  ELSE NULL&#10;END' />
      </column>
      <column caption='aaa_shop' datatype='string' name='[Calculation_1120129714169438209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_aaa_shop_vendor] THEN &quot;KP&quot; ELSE &quot;Non-KP&quot; END' />
      </column>
      <column caption='Activation Vendors' datatype='integer' name='[Calculation_1120129714170257410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sf_opportunity_id])' />
      </column>
      <column caption='Total skus' datatype='real' name='[Calculation_1120129714180206599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// SUM(&#10;//    { FIXED [sf_opportunity_id] : MAX([listed_skus_on_catalog]) }&#10;// )&#10;&#10;SUM(listed_skus_on_catalog)&#10;&#10;// { FIXED [sf_opportunity_id] : MAX([listed_skus_on_catalog]) }' />
      </column>
      <column caption='dynamic_date' datatype='date' name='[Calculation_483362948521279489]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//IF [day_type] = &quot;Week&quot; &#10;//  THEN str(DATEPART(&apos;year&apos;,[activated_date_local])) + &quot;-&quot; + str(DATEPART(&quot;week&quot;, [activated_date_local]))&#10;//ELSEIF [day_type] = &quot;Day&quot; &#10;//  THEN str(DATEPART(&quot;day&quot;,[activated_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&quot;month&quot;,[activated_date_local])),3)&#10;//ELSEIF [day_type] = &quot;Month&quot;&#10;//  THEN LEFT(str(DATENAME(&quot;month&quot;,[activated_date_local])),3)+&apos; &apos;+RIGHT(str(DATEPART(&quot;year&quot;,[activated_date_local])),2) &#10;//END&#10;&#10;IF [Parameters].[choose_dimension （複製）] = &quot;Week&quot; THEN&#10;    DATE( DATETRUNC(&apos;week&apos;, [activated_date_local]) ) &#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Day&quot; THEN&#10;    DATE( DATETRUNC(&apos;day&apos;, [activated_date_local]) )&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Month&quot; THEN&#10;    DATE( DATETRUNC(&apos;month&apos;, [activated_date_local]) )&#10;END' />
      </column>
      <column caption='dynamic_date_filter' datatype='boolean' name='[Calculation_483362948524105733]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[choose_dimension （複製）] = &apos;Month&apos; &#10;  THEN [activated_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [activated_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Week&apos; &#10;  THEN [activated_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [activated_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;week&apos;,TODAY()))&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Day&apos; &#10;  THEN [activated_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [activated_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
      </column>
      <column caption='Activated Metrics Number' datatype='string' name='[Calculation_483362948529868809]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[參數 2] &#10;  WHEN &quot;Activation Vendors&quot; THEN STR([Calculation_1120129714170257410])&#10;  WHEN &quot;Over sku min Activation Vendors&quot; THEN STR([PP Activation Vendors （複製）_1120129714172985349])&#10;  WHEN &quot;Over sku min Activation Vendors%&quot; THEN STR(ROUND([PP Activation Vendors% （複製）_1120129714173239302] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;PP Activation Vendors%&quot; THEN STR(ROUND([PP Activation Vendors （複製）_1120129714171072516] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;sku per vendor&quot; THEN STR(ROUND([Total skus （複製）_1120129714180362248], 0))&#10;END' />
      </column>
      <column caption='PP Activation Vendors%' datatype='real' name='[PP Activation Vendors （複製）_1120129714171072516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Activation Vendors （複製）_1120129714170937347] / [Calculation_1120129714170257410]' />
      </column>
      <column caption='Over sku min Activation Vendors' datatype='integer' name='[PP Activation Vendors （複製）_1120129714172985349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_over_sku_minimal_threshold] THEN [sf_opportunity_id] END)' />
      </column>
      <column caption='Over sku min Activation Vendors%' datatype='real' name='[PP Activation Vendors% （複製）_1120129714173239302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[PP Activation Vendors （複製）_1120129714172985349] / [Calculation_1120129714170257410]' />
      </column>
      <column caption='skus per vendor' datatype='real' name='[Total skus （複製）_1120129714180362248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1120129714180206599] / [Calculation_1120129714170257410]' />
      </column>
