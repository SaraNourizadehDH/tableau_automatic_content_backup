              <calculation class='tableau' formula='{FIXED [date_type], [Calculation_3367074067735347206], [report_date], [global_entity_id]: SUM([num_of_seamless_orders_external])/ SUM([num_of_seamless_orders_denominator_external])}' />
            </column>
