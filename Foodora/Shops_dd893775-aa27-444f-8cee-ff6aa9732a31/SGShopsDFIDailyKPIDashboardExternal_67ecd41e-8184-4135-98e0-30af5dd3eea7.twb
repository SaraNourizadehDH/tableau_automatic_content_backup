      <aliases enabled='yes' />
      <column caption='% Prepped Orders Delayed' datatype='real' default-format='p0.0%' name='[% Active SKU (copy)_3367074067793887271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([num_of_valid_orders_within_allocated_prep_time]) / SUM([num_of_valid_prepped_orders])' />
      </column>
      <column caption='% Active Vendor Product' datatype='real' default-format='p0.0%' name='[% Active SKU (copy)_6566951972868165633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_active_vendor_product]) / SUM([num_of_vendor_product])' />
      </column>
      <column caption='% Online Rate (Night)' datatype='real' default-format='p0.0%' name='[% Online Rate (Day) (copy)_410038700671762433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_night_closed_mins]) / SUM([total_night_scheduled_open_mins])' />
      </column>
      <column caption='% Online Rate (Day)' datatype='real' default-format='p0.0%' name='[% Online Rate (copy)_410038700671680512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_day_closed_mins]) / SUM([total_day_scheduled_open_mins])' />
      </column>
      <column caption='% Online Rate' datatype='real' default-format='p0.0%' name='[% Partial Order Rate (copy)_3367074067779182622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_closed_mins]) / SUM([total_scheduled_open_mins])' />
      </column>
      <column caption='% Found Rate' datatype='real' default-format='p0.0%' name='[% Partial Order Rate (copy)_4310859666876973056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_delivered_quantity]) / SUM([num_of_valid_ordered_quantity])' />
      </column>
      <column caption='% Partial Order Rate' datatype='real' default-format='p0.0%' name='[% Preorders (copy)_3367074067775995929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_partially_fulfilled_excl_post_delivery_orders]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='% Assigned Orders Delayed' datatype='real' default-format='p0.0%' name='[% Prepped Orders Delayed (copy)_3367074067796398121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([num_of_valid_orders_within_1min_acceptance_time]) / SUM([num_of_valid_assigned_orders])' />
      </column>
      <column caption='Prep Time Mins per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABS (copy)_3367074067787960355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prep_time_mins]) / SUM([num_of_valid_prepped_orders])' />
