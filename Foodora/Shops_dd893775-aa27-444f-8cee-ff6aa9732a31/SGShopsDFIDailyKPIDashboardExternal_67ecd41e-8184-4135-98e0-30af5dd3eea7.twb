    <worksheet name='% Assignment Time Delays: Daily Avg Comparison (C7D)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__dfi_vendor_performance_report (pandata_report)' name='federated.1rubucw0gd6urk13acoyb1ar27fp' />
          </datasources>
          <datasource-dependencies datasource='federated.1rubucw0gd6urk13acoyb1ar27fp'>
            <column caption='% Assigned Orders Delayed' datatype='real' default-format='p0.0%' name='[% Prepped Orders Delayed (copy)_3367074067796398121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([num_of_valid_orders_within_1min_acceptance_time]) / SUM([num_of_valid_assigned_orders])' />
            </column>
            <column caption='L7D v P7D' datatype='string' name='[Calculation_3367074067735347206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D&apos;&#10;END' />
            </column>
            <column caption='Daily % Assigned Orders Delay' datatype='real' default-format='p0.0%' name='[Daily % Prepped Orders Delay (copy)_3367074067796480042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [date_type], [Calculation_3367074067735347206], [report_date], [global_entity_id]: [% Prepped Orders Delayed (copy)_3367074067796398121]}' />
            </column>
            <column caption='L7D v P7D (Avg)' datatype='string' name='[L7D v P7D (copy)_3367074067740975113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D Avg&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D Avg&apos;&#10;END' />
            </column>
            <column-instance column='[Daily % Prepped Orders Delay (copy)_3367074067796480042]' derivation='Avg' name='[avg:Daily % Prepped Orders Delay (copy)_3367074067796480042:qk]' pivot='key' type='quantitative' />
            <column caption='Chain Code' datatype='string' name='[chain_code]' role='dimension' type='nominal' />
