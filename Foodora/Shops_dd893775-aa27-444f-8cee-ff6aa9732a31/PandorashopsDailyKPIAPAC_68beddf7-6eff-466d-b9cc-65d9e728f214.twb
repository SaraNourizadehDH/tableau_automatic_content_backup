              <calculation class='tableau' formula='if ([Calculation_6888396387914879031] - [fail rate - l7d avg (copy)_6888396387915034681]) / [fail rate - l7d avg (copy)_6888396387915034681] &gt;= 0.1 then 2&#10;elseif ([Calculation_6888396387914879031] - [fail rate - l7d avg (copy)_6888396387915034681]) / [fail rate - l7d avg (copy)_6888396387915034681] &lt;= -0.1 then -2&#10;elseif ([Calculation_6888396387914879031] - [fail rate - l7d avg (copy)_6888396387915034681]) / [fail rate - l7d avg (copy)_6888396387915034681] &lt;= -0.05 then -1&#10;elseif ([Calculation_6888396387914879031] - [fail rate - l7d avg (copy)_6888396387915034681]) / [fail rate - l7d avg (copy)_6888396387915034681] &gt;= 0.05 then 1&#10;else 0&#10;end'>
