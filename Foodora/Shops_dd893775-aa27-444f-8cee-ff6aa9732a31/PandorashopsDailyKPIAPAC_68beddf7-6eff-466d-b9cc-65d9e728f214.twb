    <worksheet name='on time - wow chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_report)' name='federated.056an7j0fl7nfz194mkw11wrkh5e' />
          </datasources>
          <datasource-dependencies datasource='federated.056an7j0fl7nfz194mkw11wrkh5e'>
            <column caption='L7D vs P7D - text' datatype='string' name='[Calculation_6888396387362873344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, TODAY())&#10;THEN &apos;L7D&apos;&#10;ELSE &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='L7D vs P7d - chart overlap date' datatype='datetime' name='[Calculation_6888396387364900865]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END' />
            </column>
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6888396387362873344]' derivation='None' name='[none:Calculation_6888396387362873344:nk]' pivot='key' type='nominal' />
