    <worksheet name='on time  - l7d avg'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_report)' name='federated.056an7j0fl7nfz194mkw11wrkh5e' />
          </datasources>
          <datasource-dependencies datasource='federated.056an7j0fl7nfz194mkw11wrkh5e'>
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column-instance column='[granularity]' derivation='None' name='[none:granularity:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[on_time_orders]' role='measure' type='quantitative' />
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[vfr - l7d avg (copy)_6888396387909099570]' derivation='User' name='[usr:vfr - l7d avg (copy)_6888396387909099570:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column datatype='integer' name='[valid_orders]' role='measure' type='quantitative' />
            <column caption='ontime - l7d avg' datatype='real' default-format='p0.00%' name='[vfr - l7d avg (copy)_6888396387909099570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([on_time_orders]) / SUM([valid_orders]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.056an7j0fl7nfz194mkw11wrkh5e].[none:granularity:nk]'>
            <groupfilter function='member' level='[none:granularity:nk]' member='&quot;country&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
