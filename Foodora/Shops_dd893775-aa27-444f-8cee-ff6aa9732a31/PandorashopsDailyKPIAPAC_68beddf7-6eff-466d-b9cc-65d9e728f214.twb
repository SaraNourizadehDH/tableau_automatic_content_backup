      <aliases enabled='yes' />
      <column caption='df per order' datatype='real' name='[Calculation_1807069381801746499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_df_eur]) / SUM([valid_orders])' />
      </column>
      <column caption='platform GMV contr - colour grade' datatype='integer' name='[Calculation_212372892021661711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ([Calculation_4621115451921813504] - [platform order contr - l7d avg (copy)_4621115451922837510]) / [platform order contr - l7d avg (copy)_4621115451922837510] &gt;= 0.2 then 2&#10;elseif ([Calculation_4621115451921813504] - [platform order contr - l7d avg (copy)_4621115451922837510]) / [platform order contr - l7d avg (copy)_4621115451922837510] &lt;= -0.2 then -2&#10;elseif ([Calculation_4621115451921813504] - [platform order contr - l7d avg (copy)_4621115451922837510]) / [platform order contr - l7d avg (copy)_4621115451922837510] &lt;= -0.1 then -1&#10;elseif ([Calculation_4621115451921813504] - [platform order contr - l7d avg (copy)_4621115451922837510]) / [platform order contr - l7d avg (copy)_4621115451922837510] &gt;= 0.1 then 1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
