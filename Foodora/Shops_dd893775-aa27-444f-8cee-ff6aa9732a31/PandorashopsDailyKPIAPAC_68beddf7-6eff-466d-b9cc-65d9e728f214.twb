              <calculation class='tableau' formula='round((&#10;    (SUM(IF [Calculation_6888396387513438211] = 1 THEN [item_replaced_gfv_saved_num] ELSE 0 END) /&#10;    SUM(IF [Calculation_6888396387513438211] = 1 THEN [item_replaced_gfv_saved_den] ELSE 0 END))&#10;    -&#10;    (SUM(IF [dates - d-1 (copy)_6888396387513667588] = 1 THEN [item_replaced_gfv_saved_num] ELSE 0 END) /&#10;    SUM(IF [dates - d-1 (copy)_6888396387513667588] = 1 THEN [item_replaced_gfv_saved_den] ELSE 0 END))&#10;) * 100,2)' />
