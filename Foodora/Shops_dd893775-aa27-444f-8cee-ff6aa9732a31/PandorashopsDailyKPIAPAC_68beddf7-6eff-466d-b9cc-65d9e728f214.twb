            <column caption='replaced - same day last week growth (display)' datatype='string' name='[ind - same day last week growth (display) (copy)_5269141217428963338]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[ind - same day last week growth (symbol) (copy)_5269141217428963339]&#10;+ &#10;&#10;&apos; &apos;&#10;&#10;+ &#10;&#10;str([ind - same day last week growth (value) (copy)_5269141217428963340])' />
            </column>
            <column caption='replaced - same day last week growth (symbol)' datatype='string' name='[ind - same day last week growth (symbol) (copy)_5269141217428963339]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [ind - same day last week growth (value) (copy)_5269141217428963340] &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
