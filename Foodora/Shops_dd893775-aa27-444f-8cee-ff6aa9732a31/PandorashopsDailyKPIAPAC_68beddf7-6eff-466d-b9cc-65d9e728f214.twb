              <calculation class='tableau' formula='if ([Calculation_1807069381801746499] - [pro orders - l7d avg (copy)_5275122566306758662]) / [pro orders - l7d avg (copy)_5275122566306758662] &gt;= 0.2 then 2&#10;elseif ([Calculation_1807069381801746499] - [pro orders - l7d avg (copy)_5275122566306758662]) / [pro orders - l7d avg (copy)_5275122566306758662] &lt;= -0.2 then -2&#10;elseif ([Calculation_1807069381801746499] - [pro orders - l7d avg (copy)_5275122566306758662]) / [pro orders - l7d avg (copy)_5275122566306758662] &lt;= -0.1 then -1&#10;elseif ([Calculation_1807069381801746499] - [pro orders - l7d avg (copy)_5275122566306758662]) / [pro orders - l7d avg (copy)_5275122566306758662] &gt;= 0.1 then 1&#10;else 0&#10;end'>
