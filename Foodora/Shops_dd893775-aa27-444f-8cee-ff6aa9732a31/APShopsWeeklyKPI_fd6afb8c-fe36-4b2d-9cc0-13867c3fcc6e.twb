        <calculation class='tableau' formula='if (([Item Replacement GFV Saved (copy 2)_1692157252286287909]) - [L7 Item Replacement GFV Saved (copy)_1692157252286394406]) / [L7 Item Replacement GFV Saved (copy)_1692157252286394406] &gt;= 0.2 then -2&#10;elseif (([Item Replacement GFV Saved (copy 2)_1692157252286287909]) - [L7 Item Replacement GFV Saved (copy)_1692157252286394406]) / [L7 Item Replacement GFV Saved (copy)_1692157252286394406]  &lt;= -0.2 then 2&#10;elseif (([Item Replacement GFV Saved (copy 2)_1692157252286287909]) - [L7 Item Replacement GFV Saved (copy)_1692157252286394406]) / [L7 Item Replacement GFV Saved (copy)_1692157252286394406]  &lt;= -0.1 then 1&#10;elseif (([Item Replacement GFV Saved (copy 2)_1692157252286287909]) - [L7 Item Replacement GFV Saved (copy)_1692157252286394406]) / [L7 Item Replacement GFV Saved (copy)_1692157252286394406]  &gt;= 0.1 then -1&#10;else 0&#10;end'>
