        <calculation class='tableau' formula='IF (&#13;&#10;(&#13;&#10;(SUM(IF [is_YTD] THEN [num_of_partially_fulfilled_orders] END) /&#13;&#10;SUM(IF [is_YTD] THEN [num_of_valid_orders] END))&#13;&#10;-&#13;&#10;(SUM(IF [is_2YTD] THEN [num_of_partially_fulfilled_orders] END) /&#13;&#10;SUM(IF [is_2YTD] THEN [num_of_valid_orders] END))&#13;&#10;)&#13;&#10;/&#13;&#10;(SUM(IF [is_2YTD] THEN [num_of_partially_fulfilled_orders] END) /&#13;&#10;SUM(IF [is_2YTD] THEN [num_of_valid_orders] END)))&#13;&#10; &gt;=0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
