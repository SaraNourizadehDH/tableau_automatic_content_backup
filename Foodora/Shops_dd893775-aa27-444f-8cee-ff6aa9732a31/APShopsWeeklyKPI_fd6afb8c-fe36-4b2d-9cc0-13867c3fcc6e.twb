  <dashboards>
    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APShopsWeeklyKPI/Definitions?rev=' id='Definitions' path='/t/Foodora/workbooks/APShopsWeeklyKPI' revision='' site='Foodora' />
      <style />
      <size maxheight='550' maxwidth='1250' minheight='550' minwidth='1250' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='70411' id='3' type-v2='text' w='98720' x='640' y='28134'>
            <formatted-text>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='14'>KPI Summary:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(1) GMV (€) - Total GMV in Eur</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(2) Average Basket Value - GFV (EUR) / Valid Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(3) Orders - Total Valid Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(4) Offline Hours - Percentage of vendors offline rate</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(5) SA Supermarket Active SKU - Total strategic account supermarket active SKU</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(6) % GMV Subsidized by Vendor - Percertage of GMV subsidized by vendor</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(7) Fail Rate - Percentage of orders that were not successful</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(8) Vendor Fail Rate - Percentage of orders that were not successful due to the vendor</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(9) % Items Not Delivered - Percetage of items not delivered in Valid and VENDOR_PRODUCT_UNAVAILABLE orders, excluding post delivery updates</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(10) % Item Replacement GFV Saved - Percentage of GFV saved from Item Replacement</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(11) % of Active SKU on Item Promotion - Percentage of active SKU on Item Promotion</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(12) Magical Orders % - Percentage of fully fulfilled non-preorder orders under estimated delivery time, no incident and not affected by shrinks or closure events over total gross orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(13) Order Contribution % - Percentage of Orders contributed by Shops</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(14) GMV Contribution % - Percentage of GMV contributed by Shops</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
