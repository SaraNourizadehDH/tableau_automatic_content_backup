              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [daily_active_vendors] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='LW_GMV_Per_Store' datatype='string' name='[LW_Orders_Per_Store (copy)_3506122716874338317]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [daily_active_vendors] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(&#10;(SUM(IF [Calculation_1993476221386768384] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [daily_active_vendors] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END) &#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END)) )&#10;* 100, 2)&#10;)' />
