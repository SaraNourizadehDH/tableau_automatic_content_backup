          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Subsidy Per Voucher color code' datatype='integer' name='[% Orders w Vouchers color code (copy)_1650991491455594529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([Calculation_935059924755525635]) - [L7 Magicals Order AVG (copy)_1650991491455410208]) / [L7 Magicals Order AVG (copy)_1650991491455410208] &gt;= 0.2 then -2&#10;elseif (([Calculation_935059924755525635]) - [L7 Magicals Order AVG (copy)_1650991491455410208]) / [L7 Magicals Order AVG (copy)_1650991491455410208] &lt;= -0.2 then 2&#10;elseif (([Calculation_935059924755525635]) - [L7 Magicals Order AVG (copy)_1650991491455410208]) / [L7 Magicals Order AVG (copy)_1650991491455410208] &lt;= -0.1 then 1&#10;elseif (([Calculation_935059924755525635]) - [L7 Magicals Order AVG (copy)_1650991491455410208]) / [L7 Magicals Order AVG (copy)_1650991491455410208] &gt;= 0.1 then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='Subsidy per Voucher' datatype='real' name='[Calculation_935059924755525635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fp_voucher_value_eur])/sum([num_of_valid_orders])' />
            </column>
            <column caption='L7 Avg Subsidy Per Order AVG' datatype='real' name='[L7 Magicals Order AVG (copy)_1650991491455410208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Calculation_935059924755525635]), first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Fp Voucher Value Eur' datatype='real' name='[fp_voucher_value_eur]' role='measure' type='quantitative' />
