            </column>
            <column caption='Incident Rate' datatype='real' name='[Vendor Fail Rate (copy)_6155365186657833020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_issues])/sum([num_of_orders])' />
            </column>
