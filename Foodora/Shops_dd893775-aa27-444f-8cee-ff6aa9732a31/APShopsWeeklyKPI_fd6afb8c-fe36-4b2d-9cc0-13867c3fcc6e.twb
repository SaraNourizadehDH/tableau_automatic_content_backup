            <column caption='Reorder Rate color code' datatype='integer' name='[% Orders w Vouchers color code (copy)_1650991491497328686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([Calculation_274719600049917956]) - [L7 Magicals Order AVG (copy)_1650991491497242669]) / [L7 Magicals Order AVG (copy)_1650991491497242669] &gt;= 0.2 then 2&#10;elseif (([Calculation_274719600049917956]) - [L7 Magicals Order AVG (copy)_1650991491497242669]) / [L7 Magicals Order AVG (copy)_1650991491497242669] &lt;= -0.2 then -2&#10;elseif (([Calculation_274719600049917956]) - [L7 Magicals Order AVG (copy)_1650991491497242669]) / [L7 Magicals Order AVG (copy)_1650991491497242669] &lt;= -0.1 then -1&#10;elseif (([Calculation_274719600049917956]) - [L7 Magicals Order AVG (copy)_1650991491497242669]) / [L7 Magicals Order AVG (copy)_1650991491497242669] &gt;= 0.1 then 1&#10;else 0&#10;end'>
