    <worksheet name='LW % - GMV Contribution - Shops'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d80b63' fontsize='18'>y</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d80b63' fontsize='9'>y</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='W/O Current Week' datatype='boolean' name='[Calculation_1582452322937978880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='is_last_week' datatype='boolean' name='[Calculation_1993476221386768384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -1, TODAY()), &apos;monday&apos;)' />
            </column>
            <column caption='is_last_2week' datatype='boolean' name='[Calculation_1993476221387321345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -2, TODAY()), &apos;monday&apos;)' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='rank gmv contribution' datatype='real' name='[Calculation_514817754620792841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_name], [vendor_type], [report_date] : SUM(&#13;&#10;    IF [Calculation_3491345310664937529] THEN [gmv_eur]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;  )}&#13;&#10;&#13;&#10;/&#13;&#10;({FIXED [country_name], [report_date] : SUM(&#13;&#10;IF [Calculation_3491345310664937529] THEN&#13;&#10;[gmv_eur] ELSE 0&#13;&#10;    END)})' />
            </column>
            <column caption='Indicator_LW_%_of_GMV' datatype='string' name='[Calculation_514817754626977806]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#13;&#10;(SUM(IF [Calculation_1993476221386768384] THEN [gmv_eur] END)&#13;&#10;/SUM(IF [Calculation_1993476221386768384] THEN {fixed[country_name],[week] : sum([gmv_eur])} END))&#13;&#10;-&#13;&#10;(SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END)&#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN {fixed[country_name],[week] : sum([gmv_eur])} END))&#13;&#10;)&#13;&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [gmv_eur] END)&#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN {fixed[country_name],[week] : sum([gmv_eur])} END)) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='LW_%_of_GMV' datatype='string' name='[Calculation_514817754627338255]' role='measure' type='nominal'>
