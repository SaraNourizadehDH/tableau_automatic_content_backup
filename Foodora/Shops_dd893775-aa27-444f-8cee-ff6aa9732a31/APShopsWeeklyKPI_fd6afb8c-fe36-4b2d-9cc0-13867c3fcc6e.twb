            <column caption='rank avg subsidy per voucher' datatype='real' name='[rank avg basket size (copy)_1943092178319745034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [fp_voucher_value_eur]&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_valid_orders] ELSE 0&#10;    END)' />
