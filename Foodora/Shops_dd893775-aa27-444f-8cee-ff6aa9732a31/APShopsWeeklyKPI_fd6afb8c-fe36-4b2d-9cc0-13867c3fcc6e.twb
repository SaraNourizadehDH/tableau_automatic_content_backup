    <worksheet name='Avg Subsidy Per Voucher Rate - Shops'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='16'>Avg Subsidy per Voucher Rate</run>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='9'>(voucher value/total orders)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
