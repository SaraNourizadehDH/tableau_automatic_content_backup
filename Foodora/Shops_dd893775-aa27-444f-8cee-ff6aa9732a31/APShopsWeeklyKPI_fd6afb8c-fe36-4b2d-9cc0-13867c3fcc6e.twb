            <column aggregation='Sum' caption='MTD' datatype='integer' name='[1 (copy)_557250104628985863]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date])}' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_557250104597061633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_557250104596926464]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_557250104597192706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
            </column>
            <column caption='% Orders w Vouchers (MTD) ' datatype='real' name='[Fail Rate (MTD)  (copy)_2103040309027688483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_valid_orders_w_vouchers] END)) &#10;/&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_valid_orders] END) )' />
            </column>
            <column caption='% of Orders w Vouchers (Prev MTD)' datatype='real' name='[Fail Rate (Prev MTD) (copy)_2103040309027835940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_valid_orders_w_vouchers] END)) &#10;/&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_valid_orders] END) )' />
            </column>
            <column caption='Indicator MoM Orders w Vouchers' datatype='string' name='[Indicator MoM Valid Orders   (copy)_2103040309028560934]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;([Fail Rate (MTD)  (copy)_2103040309027688483] - [Fail Rate (Prev MTD) (copy)_2103040309027835940])&#10;/ [Fail Rate (Prev MTD) (copy)_2103040309027835940]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='% Orders w Vouchers MoM%' datatype='string' name='[Magical Orders MoM% (copy)_2103040309027975205]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;([Fail Rate (MTD)  (copy)_2103040309027688483] - [Fail Rate (Prev MTD) (copy)_2103040309027835940])&#10;/ [Fail Rate (Prev MTD) (copy)_2103040309027835940]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;([Fail Rate (MTD)  (copy)_2103040309027688483] - [Fail Rate (Prev MTD) (copy)_2103040309027835940])&#10;/ [Fail Rate (Prev MTD) (copy)_2103040309027835940]&#10;)*100, 2)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
