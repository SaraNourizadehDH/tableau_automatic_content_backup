      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='W/O Current Week' datatype='boolean' name='[Calculation_1582452322937978880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='rank gmv contribution' datatype='real' name='[Calculation_514817754620792841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_name], [vendor_type], [report_date] : SUM(&#13;&#10;    IF [Calculation_3491345310664937529] THEN [gmv_eur]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;  )}&#13;&#10;&#13;&#10;/&#13;&#10;({FIXED [country_name], [report_date] : SUM(&#13;&#10;IF [Calculation_3491345310664937529] THEN&#13;&#10;[gmv_eur] ELSE 0&#13;&#10;    END)})' />
            </column>
            <column caption='% of Total GMV ' datatype='real' default-format='p0.00%' name='[Calculation_851180349640736791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur]) / SUM({fixed[country_name],[report_date] : sum([gmv_eur])})' />
            </column>
            <column caption='L7 % of Total GMV AVG' datatype='real' name='[Calculation_851180349642014744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_851180349640736791], first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% of Total GMV color code' datatype='integer' name='[Calculation_851180349642969113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Calculation_851180349640736791] - [Calculation_851180349642014744]) / [Calculation_851180349642014744] &gt;= 0.2 then 2&#13;&#10;elseif ([Calculation_851180349640736791] - [Calculation_851180349642014744]) / [Calculation_851180349642014744] &lt;= -0.2 then -2&#13;&#10;elseif ([Calculation_851180349640736791] - [Calculation_851180349642014744]) / [Calculation_851180349642014744] &lt;= -0.1 then -1&#13;&#10;elseif ([Calculation_851180349640736791] - [Calculation_851180349642014744]) / [Calculation_851180349642014744] &gt;= 0.1 then 1&#13;&#10;else 0&#13;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
