              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [new_customers_8_days_ago_who_reorder] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [new_customers_8_days_ago] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [new_customers_8_days_ago_who_reorder] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [new_customers_8_days_ago] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [new_customers_8_days_ago_who_reorder] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [new_customers_8_days_ago] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
