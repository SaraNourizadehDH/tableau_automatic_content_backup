    <worksheet name='Magical Orders % - Shops'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>Seamless Orders %</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'><![CDATA[(orders within <15min earlier and <5min later of PDT AND not partial/cancelled order AND no incidents AND non-preorder orders within the long-distance threshold are delivered < 40min )]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='W/O Current Week' datatype='boolean' name='[Calculation_1582452322937978880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='total_orders_without_issues' datatype='integer' name='[Calculation_6016457324308930560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_cx_gross_orders] - [total_orders_with_issues]' />
            </column>
            <column caption='Magical Orders' datatype='real' name='[Calculation_6016457324309209089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6016457324308930560]) / SUM([num_of_cx_gross_orders])' />
            </column>
            <column caption='L7 Magicals Order AVG' datatype='real' name='[L7 Orders Per Store AVG (copy)_1650991491449020431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Calculation_6016457324309209089]), first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Magical Orders color code' datatype='integer' name='[Orders color code (copy)_1650991491448938510]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if [Calculation_6016457324309209089] &gt;= 0.95 then 2 &#10;elseif ([Calculation_6016457324309209089] - [L7 Orders Per Store AVG (copy)_1650991491449020431]) / [L7 Orders Per Store AVG (copy)_1650991491449020431] &gt;= 0.2 then 2&#10;elseif ([Calculation_6016457324309209089] - [L7 Orders Per Store AVG (copy)_1650991491449020431]) / [L7 Orders Per Store AVG (copy)_1650991491449020431]  &lt;= -0.1 then -2&#10;elseif ([Calculation_6016457324309209089] - [L7 Orders Per Store AVG (copy)_1650991491449020431]) / [L7 Orders Per Store AVG (copy)_1650991491449020431] &lt;= -0.05 then -1&#10;elseif ([Calculation_6016457324309209089] - [L7 Orders Per Store AVG (copy)_1650991491449020431]) / [L7 Orders Per Store AVG (copy)_1650991491449020431]  &gt;= 0.1 then 1&#10;ELSEIF  [Calculation_6016457324309209089] &gt;= 0.80 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_2261440339125497858]' derivation='Min' name='[min:Calculation_2261440339125497858:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1582452322937978880]' derivation='None' name='[none:Calculation_1582452322937978880:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[num_of_cx_gross_orders]' role='measure' type='quantitative' />
            <column caption='rank magical orders' datatype='real' name='[rank avg basket size (copy)_1943092178317615110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [Calculation_6016457324308930560]&#10;    ELSE 0&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_cx_gross_orders] ELSE 0&#10;    END)' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Total Orders With Issues' datatype='integer' name='[total_orders_with_issues]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6016457324309209089]' derivation='User' name='[usr:Calculation_6016457324309209089:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Orders color code (copy)_1650991491448938510]' derivation='User' name='[usr:Orders color code (copy)_1650991491448938510:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[L7 Orders Per Store AVG (copy)_1650991491449020431]' ordering-type='Rows' />
            </column-instance>
