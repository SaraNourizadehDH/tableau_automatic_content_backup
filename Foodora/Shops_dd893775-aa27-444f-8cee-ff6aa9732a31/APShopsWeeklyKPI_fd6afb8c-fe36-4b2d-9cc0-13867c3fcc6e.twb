            <column caption='Num Of Valid Orders W Deals' datatype='integer' name='[num_of_valid_orders_w_deals]' role='measure' type='quantitative' />
            <column caption='rank subsidized orders' datatype='real' name='[rank partially fulfilled order (copy)_6155365186626342943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_3491345310664937529] THEN [num_of_valid_orders_w_deals]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;  )&#13;&#10;&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [Calculation_3491345310664937529] THEN&#13;&#10;[num_of_valid_orders] ELSE 0&#13;&#10;    END)' />
            </column>
