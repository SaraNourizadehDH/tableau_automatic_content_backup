                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(7) Fail Rate - Percentage of orders that were not successful</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(8) Vendor Fail Rate - Percentage of orders that were not successful due to the vendor</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(9) % Items Not Delivered - Percetage of items not delivered in Valid and VENDOR_PRODUCT_UNAVAILABLE orders, excluding post delivery updates</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(10) % Item Replacement GFV Saved - Percentage of GFV saved from Item Replacement</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(11) % of Active SKU on Item Promotion - Percentage of active SKU on Item Promotion</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(12) Magical Orders % - Percentage of fully fulfilled non-preorder orders under estimated delivery time, no incident and not affected by shrinks or closure events over total gross orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(13) Order Contribution % - Percentage of Orders contributed by Shops</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>(14) GMV Contribution % - Percentage of GMV contributed by Shops</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{E6000709-D397-401D-B92D-C579211ED1AC}' />
    </dashboard>
