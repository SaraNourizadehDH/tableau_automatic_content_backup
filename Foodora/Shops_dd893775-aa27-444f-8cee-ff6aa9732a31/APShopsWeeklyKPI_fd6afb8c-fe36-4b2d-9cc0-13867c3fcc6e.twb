        <calculation class='tableau' formula='(IF  DATETRUNC(&apos;year&apos;, [report_date]) = DATETRUNC(&apos;year&apos;, [Latest Month (copy)_3491345310383329305])&#13;&#10;AND DATETRUNC(&apos;month&apos;, [report_date]) &lt;= DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#13;&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN ([gmv_eur]) END)&#13;&#10;&#13;&#10;/ &#13;&#10;&#13;&#10;(IF DATETRUNC(&apos;year&apos;, [report_date]) = DATETRUNC(&apos;year&apos;, [Latest Month (copy)_3491345310383329305])&#13;&#10;AND DATETRUNC(&apos;month&apos;, [report_date]) &lt;= DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#13;&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN {fixed [country_name], YEAR([report_date]): SUM([Calculation_514817754684088342])} END)' />
