    <worksheet name='% Item Replacement GFV Saved - Shop'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>% Item Replacement GFV Saved</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#dd096e' fontsize='9'>y</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='W/O Current Week' datatype='boolean' name='[Calculation_1582452322937978880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='Item Replacement GFV Saved' datatype='real' name='[Calculation_1692157252282384407]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pct_replacement_gfv_saved_num])/sum([pct_replacement_gfv_saved_den])' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='Item Replacement GFV Saved color code' datatype='integer' name='[Fail Rate color code (copy)_1692157252283908129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([Calculation_1692157252282384407]) - [L7 % of OOS AVG (copy)_1692157252282617881]) / [L7 % of OOS AVG (copy)_1692157252282617881] &gt;= 0.2 then -2&#10;elseif (([Calculation_1692157252282384407]) - [L7 % of OOS AVG (copy)_1692157252282617881]) / [L7 % of OOS AVG (copy)_1692157252282617881]  &lt;= -0.2 then 2&#10;elseif (([Calculation_1692157252282384407]) - [L7 % of OOS AVG (copy)_1692157252282617881]) / [L7 % of OOS AVG (copy)_1692157252282617881]  &lt;= -0.1 then 1&#10;elseif (([Calculation_1692157252282384407]) - [L7 % of OOS AVG (copy)_1692157252282617881]) / [L7 % of OOS AVG (copy)_1692157252282617881]  &gt;= 0.1 then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='L7 Item Replacement GFV Saved' datatype='real' name='[L7 % of OOS AVG (copy)_1692157252282617881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Calculation_1692157252282384407]), first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_2261440339125497858]' derivation='Min' name='[min:Calculation_2261440339125497858:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1582452322937978880]' derivation='None' name='[none:Calculation_1582452322937978880:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[pct_replacement_gfv_saved_den]' role='measure' type='quantitative' />
            <column datatype='real' name='[pct_replacement_gfv_saved_num]' role='measure' type='quantitative' />
            <column caption='rank Item Replacement GFV Saved' datatype='real' name='[rank OOS (copy)_1692157252282478616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [pct_replacement_gfv_saved_num]&#10;    ELSE 0&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[pct_replacement_gfv_saved_den] ELSE 0&#10;    END)' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1692157252282384407]' derivation='User' name='[usr:Calculation_1692157252282384407:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Fail Rate color code (copy)_1692157252283908129]' derivation='User' name='[usr:Fail Rate color code (copy)_1692157252283908129:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[L7 % of OOS AVG (copy)_1692157252282617881]' ordering-type='Rows' />
