            <column-instance column='[rank OOS (copy)_1692157252282478616]' derivation='User' name='[usr:rank OOS (copy)_1692157252282478616:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
            <column caption='Week' datatype='string' name='[week]' role='dimension' type='nominal' />
