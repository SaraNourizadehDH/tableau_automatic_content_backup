        <calculation class='tableau' formula='IF (&#10;([Item Replacement GFV Saved (MTD) (copy)_1692157252286500903] - [Item Replacement GFV Saved (Prev MTD) (copy)_1692157252286722088])&#10;/ [Item Replacement GFV Saved (Prev MTD) (copy)_1692157252286722088]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;([Item Replacement GFV Saved (MTD) (copy)_1692157252286500903] - [Item Replacement GFV Saved (Prev MTD) (copy)_1692157252286722088])&#10;/ [Item Replacement GFV Saved (Prev MTD) (copy)_1692157252286722088]&#10;)*100, 2)&#10;)' />
