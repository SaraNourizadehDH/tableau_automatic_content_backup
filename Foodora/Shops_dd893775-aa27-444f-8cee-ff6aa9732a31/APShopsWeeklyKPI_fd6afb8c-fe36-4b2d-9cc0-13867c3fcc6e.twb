    <worksheet name='Voucher Spends % GMV - Shops'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>ICPGMV </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='9'>(FP Total Subsidies/ Total GMV)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='ICPGMV' datatype='real' name='[Calculation_851180349397733376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ZN([fp_voucher_value_eur])+ZN([fp_discount_value_eur]))/sum([gmv_eur])' />
            </column>
            <column caption='L7 ICPGMV AVG' datatype='real' name='[Calculation_851180349407899651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_851180349397733376], first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ICPGMV color code' datatype='integer' name='[Calculation_851180349408583686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([Calculation_851180349397733376]) - [Calculation_851180349407899651]) / [Calculation_851180349407899651] &gt;= 0.2 then -2&#13;&#10;elseif (([Calculation_851180349397733376]) - [Calculation_851180349407899651]) / [Calculation_851180349407899651] &lt;= -0.2 then 2&#13;&#10;elseif (([Calculation_851180349397733376]) - [Calculation_851180349407899651]) / [Calculation_851180349407899651] &lt;= -0.1 then 1&#13;&#10;elseif (([Calculation_851180349397733376]) - [Calculation_851180349407899651]) / [Calculation_851180349407899651] &gt;= 0.1 then -1&#13;&#10;else 0&#13;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='rank voucher share % gmv' datatype='real' name='[Calculation_851180349435187217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_3491345310664937529] THEN [fp_voucher_value_eur]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;  )&#13;&#10;&#13;&#10;/&#13;&#10; SUM(&#13;&#10;IF [Calculation_3491345310664937529] THEN&#13;&#10;[gmv_eur] ELSE 0&#13;&#10;    END)' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Fp Discount Value Eur' datatype='real' name='[fp_discount_value_eur]' role='measure' type='quantitative' />
            <column caption='Fp Voucher Value Eur' datatype='real' name='[fp_voucher_value_eur]' role='measure' type='quantitative' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2261440339125497858]' derivation='Min' name='[min:Calculation_2261440339125497858:qk]' pivot='key' type='quantitative' />
