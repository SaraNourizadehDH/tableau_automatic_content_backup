      <column caption='% EC SH Orders color code' datatype='integer' name='[% EC Orders color code (copy)_4761290003313082400]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if ([% Orders (EC) (copy)_4761290003313082401] - [L7 % of Orders (EC) AVG (copy)_4761290003313082407]) / [L7 % of Orders (EC) AVG (copy)_4761290003313082407] &gt;= 0.2 then 2&#10;elseif ([% Orders (EC) (copy)_4761290003313082401] - [L7 % of Orders (EC) AVG (copy)_4761290003313082407]) / [L7 % of Orders (EC) AVG (copy)_4761290003313082407]  &lt;= -0.2 then -2&#10;elseif ([% Orders (EC) (copy)_4761290003313082401] - [L7 % of Orders (EC) AVG (copy)_4761290003313082407]) / [L7 % of Orders (EC) AVG (copy)_4761290003313082407] &lt;= -0.1 then -1&#10;elseif ([% Orders (EC) (copy)_4761290003313082401] - [L7 % of Orders (EC) AVG (copy)_4761290003313082407]) / [L7 % of Orders (EC) AVG (copy)_4761290003313082407]  &gt;= 0.1 then 1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
