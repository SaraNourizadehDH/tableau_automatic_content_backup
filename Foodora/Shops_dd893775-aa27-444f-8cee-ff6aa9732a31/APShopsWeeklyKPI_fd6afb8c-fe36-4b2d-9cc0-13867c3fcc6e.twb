      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Offline Hours color code' datatype='integer' name='[% NC SH Orders color code (copy)_6979031370753417222]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if ([% Orders (NC SH) (copy)_6979031370752737285] - [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391]) / [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391] &gt;= 0.2 then 2&#10;elseif ([% Orders (NC SH) (copy)_6979031370752737285] - [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391]) / [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391] &lt;= -0.2 then -2&#10;elseif ([% Orders (NC SH) (copy)_6979031370752737285] - [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391]) / [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391] &lt;= -0.1 then -1&#10;elseif ([% Orders (NC SH) (copy)_6979031370752737285] - [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391]) / [L7 % of Orders (NC SH) AVG (copy)_6979031370753552391] &gt;= 0.1 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
