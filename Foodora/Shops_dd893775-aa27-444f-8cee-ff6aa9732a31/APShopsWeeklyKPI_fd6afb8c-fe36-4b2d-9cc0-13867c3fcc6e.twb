    <worksheet name='MTD % - Vendor Fail Rate - Shops'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d80b63' fontsize='18'>y</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d80b63' fontsize='8'>y</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d80b63' fontsize='8'>y</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column aggregation='Sum' caption='MTD' datatype='integer' name='[1 (copy)_557250104628985863]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date])}' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_557250104597061633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_557250104596926464]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_557250104597192706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
            </column>
            <column caption='Vendor Fail Rate (MTD)' datatype='real' name='[Fail Rate (MTD)  (copy)_6155365186620952594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_failed_vendor_orders] END)) &#10;/&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_orders] END) )' />
            </column>
            <column caption='Vendor Fail Rate (Prev MTD)' datatype='real' name='[Fail Rate (Prev MTD) (copy)_6155365186620952595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_failed_vendor_orders] END)) &#10;/&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_orders] END) )' />
            </column>
            <column caption='Vendor Fail Rate MoM%' datatype='string' name='[Fail Rate MoM% (copy)_6155365186620887057]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;([Fail Rate (MTD)  (copy)_6155365186620952594] - [Fail Rate (Prev MTD) (copy)_6155365186620952595])&#10;/ [Fail Rate (Prev MTD) (copy)_6155365186620952595]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;([Fail Rate (MTD)  (copy)_6155365186620952594] - [Fail Rate (Prev MTD) (copy)_6155365186620952595])&#10;/ [Fail Rate (Prev MTD) (copy)_6155365186620952595]&#10;)*100, 2)&#10;)' />
            </column>
            <column caption='Indicator MoM Vendor Fail Rate' datatype='string' name='[Indicator MoM Fail Rate (copy)_6155365186659967047]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;([Fail Rate (MTD)  (copy)_6155365186620952594] - [Fail Rate (Prev MTD) (copy)_6155365186620952595])&#10;/ [Fail Rate (Prev MTD) (copy)_6155365186620952595]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[1 (copy)_557250104628985863]' derivation='None' name='[none:1 (copy)_557250104628985863:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Failed Vendor Orders' datatype='integer' name='[num_of_failed_vendor_orders]' role='measure' type='quantitative' />
            <column caption='Num Of Orders' datatype='integer' name='[num_of_orders]' role='measure' type='quantitative' />
            <column caption='rank vendor fail rate' datatype='real' name='[rank fail rate (copy)_6155365186619576333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [num_of_failed_vendor_orders]&#10;    ELSE 0&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_orders] ELSE 0&#10;    END)' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Fail Rate MoM% (copy)_6155365186620887057]' derivation='User' name='[usr:Fail Rate MoM% (copy)_6155365186620887057:nk]' pivot='key' type='nominal' />
            <column-instance column='[Indicator MoM Fail Rate (copy)_6155365186659967047]' derivation='User' name='[usr:Indicator MoM Fail Rate (copy)_6155365186659967047:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank fail rate (copy)_6155365186619576333]' derivation='User' name='[usr:rank fail rate (copy)_6155365186619576333:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
