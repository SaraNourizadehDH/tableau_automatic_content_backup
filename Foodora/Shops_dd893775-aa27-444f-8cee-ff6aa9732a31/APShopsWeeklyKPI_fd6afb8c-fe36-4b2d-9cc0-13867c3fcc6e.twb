              <calculation class='tableau' formula='(IF  DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN ([num_of_valid_orders]) END)&#10;&#10;/ &#10;&#10;(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN {fixed [country_name], MONTH([report_date]): SUM([Valid Orders (Previous MTD) (copy)_557250104597786628])} END)' />
            </column>
            <column caption='% of Orders (Previous MTD)' datatype='real' name='[Valid Orders (Previous MTD) (copy)_2103040309002887179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_valid_orders] END)&#10;&#10;/ &#10;&#10;(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN {fixed [country_name]: SUM([Calculation_557250104597385219])}END)' />
            </column>
            <column caption='Valid Orders (MTD)' datatype='integer' name='[Valid Orders (Previous MTD) (copy)_557250104597786628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[num_of_valid_orders]&#10;END' />
            </column>
            <column caption='% Orders MoM%' datatype='string' name='[Valid Orders MoM% (copy)_2103040309003296780]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(sum([Valid Orders (MTD) (copy)_2103040309002211338]) - sum([Valid Orders (Previous MTD) (copy)_2103040309002887179]))&#10;/ sum([Valid Orders (Previous MTD) (copy)_2103040309002887179])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;&#10;ROUND(&#10;(&#10;(sum([Valid Orders (MTD) (copy)_2103040309002211338]) - sum([Valid Orders (Previous MTD) (copy)_2103040309002887179]))&#10;/ sum([Valid Orders (Previous MTD) (copy)_2103040309002887179])),2&#10;))' />
