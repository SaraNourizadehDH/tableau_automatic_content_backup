            </column>
            <column caption='Indicator_LW_Subsidized Orders' datatype='string' name='[Indicator_LW_Partially Fulfilled Orders (copy)_6155365186626342942]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='LW_Subsidized Orders' datatype='string' name='[LW_Partially Fulfilled Orders (copy)_6155365186626342941]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN  [num_of_orders] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders_w_deals] END) &#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders_w_deals] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END)) )&#10;* 100, 2)&#10;)' />
