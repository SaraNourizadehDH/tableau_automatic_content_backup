            <column caption='% Online Rate' datatype='real' default-format='p0.0%' name='[% Partial Order Rate (copy)_3367074067779182622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([total_closed_mins]) / SUM([total_scheduled_open_mins])' />
            </column>
            <column caption='L7D v P7D' datatype='string' name='[Calculation_3367074067735347206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D&apos;&#10;END' />
            </column>
            <column caption='Outlet ' datatype='string' name='[Calculation_6566951972865306624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_EXTRACT([vendor_name], &apos;\((.*?)\)&apos;)' />
