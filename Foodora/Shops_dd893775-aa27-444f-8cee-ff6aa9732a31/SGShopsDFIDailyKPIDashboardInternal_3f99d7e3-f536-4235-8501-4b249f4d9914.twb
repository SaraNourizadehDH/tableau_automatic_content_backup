              <calculation class='tableau' formula='{ FIXED [date_type], [Calculation_3367074067735347206], [report_date], [global_entity_id]: &#10;SUM(&#10;{FIXED [date_type], [Calculation_3367074067735347206], [Calculation_6566951972865306624], [report_date], [global_entity_id]: &#10;(IF [% Partial Order Rate (copy)_3367074067779182622] &gt;= 0 THEN SUM([num_of_vendor_sessions]) END)}&#10;)&#10;}' />
            </column>
            <column caption='L7D v P7D (Avg)' datatype='string' name='[L7D v P7D (copy)_3367074067740975113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D Avg&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D Avg&apos;&#10;END' />
            </column>
