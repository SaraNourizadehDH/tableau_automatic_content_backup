    <worksheet name='ABV: Daily Avg Comparison (C7D)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__dfi_vendor_performance_report (pandata_report)' name='federated.1cjnu580cn9zd8159alye0bfhzfa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cjnu580cn9zd8159alye0bfhzfa'>
            <column caption='GFV' datatype='real' name='[Calculation_3367074067731832834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(IF [Parameters].[Parameter 1] = &quot;Local&quot; THEN [gfv_local] ELSE [gfv_eur] END, 0)' />
            </column>
            <column caption='L7D v P7D' datatype='string' name='[Calculation_3367074067735347206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D&apos;&#10;END' />
            </column>
            <column caption='Daily ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Daily GFV (copy)_3367074067760644108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [date_type], [Calculation_3367074067735347206], [report_date], [global_entity_id]: SUM([Calculation_3367074067731832834])/ SUM([num_of_valid_orders])}' />
            </column>
            <column caption='L7D v P7D (Avg)' datatype='string' name='[L7D v P7D (copy)_3367074067740975113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D Avg&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D Avg&apos;&#10;END' />
            </column>
            <column-instance column='[Daily GFV (copy)_3367074067760644108]' derivation='Avg' name='[avg:Daily GFV (copy)_3367074067760644108:qk]' pivot='key' type='quantitative' />
            <column caption='Chain Code' datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='Gfv Eur' datatype='real' name='[gfv_eur]' role='measure' type='quantitative' />
            <column caption='Gfv Local' datatype='real' name='[gfv_local]' role='measure' type='quantitative' />
