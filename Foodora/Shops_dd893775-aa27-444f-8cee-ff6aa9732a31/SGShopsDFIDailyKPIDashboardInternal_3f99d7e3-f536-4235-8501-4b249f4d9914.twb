          <datasources>
            <datasource caption='regional_apac_shops__dfi_vendor_performance_report (pandata_report)' name='federated.1cjnu580cn9zd8159alye0bfhzfa' />
          </datasources>
          <datasource-dependencies datasource='federated.1cjnu580cn9zd8159alye0bfhzfa'>
            <column caption='Report Date: L7D Comparison' datatype='datetime' default-format='*mmm dd' name='[Calculation_3367074067735134213]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END' />
            </column>
            <column caption='L7D v P7D' datatype='string' name='[Calculation_3367074067735347206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D&apos;&#10;END' />
            </column>
            <column caption='% Preorders' datatype='real' default-format='p0.0%' name='[Ext: % Vendor Fail Rate (copy)_3367074067774668823]' role='measure' type='quantitative'>
