          </datasources>
          <datasource-dependencies datasource='federated.1cjnu580cn9zd8159alye0bfhzfa'>
            <column caption='Drive Time Mins per Order' datatype='real' name='[Calculation_1913678034072330240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([drive_time_mins])/SUM([num_of_valid_drive_time_orders])' />
            </column>
            <column caption='Daily Drive Time Mins per Order' datatype='real' name='[Calculation_1913678034072485889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [date_type], [Calculation_3367074067735347206], [report_date], [global_entity_id]: [Calculation_1913678034072330240]}' />
            </column>
            <column caption='L7D v P7D' datatype='string' name='[Calculation_3367074067735347206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D&apos;&#10;END' />
            </column>
            <column caption='L7D v P7D (Avg)' datatype='string' name='[L7D v P7D (copy)_3367074067740975113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Current 7D Avg&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D Avg&apos;&#10;END' />
            </column>
