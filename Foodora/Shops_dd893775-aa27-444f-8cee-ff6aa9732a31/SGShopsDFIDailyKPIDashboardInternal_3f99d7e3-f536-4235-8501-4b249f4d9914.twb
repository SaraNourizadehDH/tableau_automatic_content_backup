          <datasource-dependencies datasource='federated.1cjnu580cn9zd8159alye0bfhzfa'>
            <column caption='GFV' datatype='real' name='[Calculation_3367074067731832834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(IF [Parameters].[Parameter 1] = &quot;Local&quot; THEN [gfv_local] ELSE [gfv_eur] END, 0)' />
            </column>
            <column caption='Currency Symbol' datatype='string' name='[Calculation_3367074067732029443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Local&quot; THEN &quot;$&quot; ELSE &quot;€&quot; END' />
