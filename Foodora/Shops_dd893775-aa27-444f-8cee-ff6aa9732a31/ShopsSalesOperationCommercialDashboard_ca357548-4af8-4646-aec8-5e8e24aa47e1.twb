      <aliases enabled='yes' />
      <column caption='1-5 Orders Vendor Count' datatype='integer' name='[1-5 Orders Vendor Count （複製）_190840084271575048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [valid_order_count] &gt;= 1 AND [valid_order_count] &lt;= 5 THEN [sf_opportunity_id] END&#10;)' />
