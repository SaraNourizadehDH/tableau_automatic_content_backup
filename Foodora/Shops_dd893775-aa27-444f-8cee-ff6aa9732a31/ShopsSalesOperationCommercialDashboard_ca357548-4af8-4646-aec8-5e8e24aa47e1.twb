      <column caption='16-30 Orders Vendor Count%' datatype='real' name='[16-30 Orders Vendor Count （複製）_218987576590479370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[16-30 Orders Vendor Count （複製）_190840084272648204] / [Calculation_190840084270567430]' />
      </column>
      <column caption='6-10 Orders Vendor Count' datatype='integer' name='[6-10 Orders Vendor Count （複製）_190840084272099338]' role='measure' type='quantitative'>
