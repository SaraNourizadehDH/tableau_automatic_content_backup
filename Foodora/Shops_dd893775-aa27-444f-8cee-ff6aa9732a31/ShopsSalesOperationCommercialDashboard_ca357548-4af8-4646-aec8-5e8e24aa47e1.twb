      <column caption='1-5 Orders Vendor Count%' datatype='real' name='[1-5 Orders Vendor Count （複製）_218987576589635592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[1-5 Orders Vendor Count （複製）_190840084271575048]/ [Calculation_190840084270567430]' />
