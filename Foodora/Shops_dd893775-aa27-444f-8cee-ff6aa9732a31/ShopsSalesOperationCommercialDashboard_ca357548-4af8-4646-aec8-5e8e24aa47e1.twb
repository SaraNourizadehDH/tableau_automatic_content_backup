            <column datatype='boolean' name='[is_ssu_vendor]' role='dimension' type='nominal' />
            <column datatype='string' name='[key_vip_account_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1120129714169438209]' derivation='None' name='[none:Calculation_1120129714169438209:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_service_types]' derivation='None' name='[none:delivery_service_types:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_cleaned_vertical_segment]' derivation='None' name='[none:global_cleaned_vertical_segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_ssu_vendor]' derivation='None' name='[none:is_ssu_vendor:nk]' pivot='key' type='nominal' />
            <column-instance column='[key_vip_account_type]' derivation='None' name='[none:key_vip_account_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[sf_opportunity_owner_name]' derivation='None' name='[none:sf_opportunity_owner_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[sf_opportunity_owner_title]' derivation='None' name='[none:sf_opportunity_owner_title:nk]' pivot='key' type='nominal' />
            <column-instance column='[sf_vertical_segment]' derivation='None' name='[none:sf_vertical_segment:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[sf_opportunity_owner_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[sf_opportunity_owner_title]' role='dimension' type='nominal' />
            <column datatype='string' name='[sf_vertical_segment]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06nk0oy025xiin0zsx4fn1hb80c7'>
            <column caption='1-5 Orders Vendor Count %' datatype='real' name='[1-5 Orders Vendor Count （複製）_1120129714283397144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Zombie 30 Days Vendor Count （複製）_190840084237385729] / [Calculation_2048997142710583296]' />
            </column>
            <column caption='6-10 Orders Vendor Count' datatype='integer' name='[1-5 Orders Vendor Count （複製）_190840084237987842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [valid_order_count] &gt;= 6 AND [valid_order_count] &lt;= 10 THEN [sf_opportunity_id] END&#10;)' />
            </column>
            <column caption='&gt;30 Orders Vendor Count' datatype='integer' name='[1-5 Orders Vendor Count （複製）_190840084238577669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [valid_order_count] &gt;= 31 THEN [sf_opportunity_id] END&#10;)' />
            </column>
            <column caption='16-30 Orders Vendor Count' datatype='integer' name='[11-15 Orders Vendor Count （複製）_190840084238286852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [valid_order_count] &gt;= 16 AND [valid_order_count] &lt;= 30 THEN [sf_opportunity_id] END&#10;)' />
            </column>
            <column caption='11-15 Orders Vendor Count %' datatype='real' name='[11-16 Orders Vendor Count （複製）_1120129714283503641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[6-10 Orders Vendor Count （複製）_190840084238180355]/ [Calculation_2048997142710583296]' />
            </column>
            <column caption='16-30 Orders Vendor Count %' datatype='real' name='[16-30 Orders Vendor Count （複製）_1120129714283601946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[11-15 Orders Vendor Count （複製）_190840084238286852] / [Calculation_2048997142710583296]' />
            </column>
            <column caption='6-10 Orders Vendor Count %' datatype='real' name='[6-10 Orders Vendor Count （複製）_1120129714283683867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[1-5 Orders Vendor Count （複製）_190840084237987842] / [Calculation_2048997142710583296]' />
            </column>
            <column caption='11-15 Orders Vendor Count' datatype='integer' name='[6-10 Orders Vendor Count （複製）_190840084238180355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [valid_order_count] &gt;= 11 AND [valid_order_count] &lt;= 15 THEN [sf_opportunity_id] END&#10;)' />
            </column>
            <column caption='&gt; 30 Orders Vendor Count %' datatype='real' name='[&gt; 30 Orders Vendor Count （複製）_483362948514082816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[1-5 Orders Vendor Count （複製）_190840084238577669] / [Calculation_2048997142710583296]' />
            </column>
            <column caption='aaa_shop' datatype='string' name='[Calculation_1120129714221580301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_aaa_shop_vendor] THEN &quot;KP&quot; ELSE &quot;Non-KP&quot; END' />
            </column>
            <column caption='dimensions' datatype='string' name='[Calculation_1120129714222317583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;  WHEN &quot;City&quot; THEN [city_name]&#10;  WHEN &quot;Global Entity&quot; THEN [global_entity_id]&#10;  WHEN &quot;Clean Vertical&quot; THEN [global_cleaned_vertical_segment]&#10;  WHEN &quot;SF Vertical Segment&quot; THEN [sf_vertical_segment]&#10;  WHEN &quot;AAA Shop&quot; THEN [Calculation_1120129714221580301]&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='Contacts per Vendor' datatype='real' name='[Calculation_1120129714225082384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_counts]) / [Calculation_2048997142710583296]' />
            </column>
            <column caption='All Shop GMV EUR' datatype='real' name='[Calculation_1120129714226712593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [incubated_30_days_date_local]: MAX([all_shop_gmv_eur]) }' />
            </column>
            <column caption='All Shop Orders' datatype='integer' name='[Calculation_1120129714226941970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [incubated_30_days_date_local]: MAX([all_shop_order_count]) }' />
            </column>
            <column caption='Valid Orders / All Shop Orders' datatype='real' name='[Calculation_1120129714227089427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_order_count]) / SUM([Calculation_1120129714226941970])' />
            </column>
            <column caption='Total Offline in Seconds' datatype='integer' name='[Calculation_1120129714287300637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_offline_in_seconds]) &#10;  + SUM([monitor_realtime_delays_rule_offline_in_seconds]) &#10;  + SUM([monitor_realtime_fails_rule_offline_in_seconds])&#10;  + SUM([monitor_unreachable_offline_in_seconds])&#10;  + SUM([other_offline_in_seconds])&#10;  + SUM([vendor_device_busy_mode_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_bad_weather_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_no_drivers_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_outside_schedule_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_renovation_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_technical_problem_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_updating_menu_offline_in_seconds])' />
            </column>
            <column caption='Incubation 30d Metrics Number' datatype='string' name='[Calculation_1785888403296571392]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Activated Metrics （複製）_483362948535410699] &#10;  WHEN &quot;Total Incubation 30 Days Vendor Count&quot; THEN STR([Calculation_2048997142710583296])&#10;  WHEN &quot;Zombie 30 Days Vendor Count&quot; THEN STR([Total Incubated 30 Days Vendor Count （複製）_190840084236046336])&#10;  WHEN &quot;Valid Order Count&quot; THEN STR(SUM([valid_order_count]))&#10;  WHEN &quot;Valid Order Count / All Shop Orders&quot; THEN STR(ROUND([Calculation_1120129714227089427] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Valid GMV EUR&quot; THEN STR(ROUND(SUM([valid_gmv_eur]), 0))&#10;  WHEN &quot;Valid GMV / All Shop GMV&quot; THEN STR(ROUND([Valid Orders / All Shop Orders （複製）_1120129714227417108] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Total Offline %&quot; THEN STR(ROUND([Total Offline in Seconds （複製）_218987576578068480] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Vendor Failed Order%&quot; THEN STR(ROUND([vendor_failed_order_count （複製）_1120129714286784540] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Contacts per Vendor&quot; THEN STR(ROUND([Calculation_1120129714225082384], 2))&#10;  &#10;  WHEN &quot;Zombie 30 Days Vendor Count %&quot; THEN STR(ROUND([Zombie 30 Days Vendor Count （複製）_1120129714261418005] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;1-5 Orders Vendor Count %&quot; THEN STR(ROUND([1-5 Orders Vendor Count （複製）_1120129714283397144] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;6-10 Orders Vendor Count %&quot; THEN STR(ROUND([6-10 Orders Vendor Count （複製）_1120129714283683867] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;11-15 Orders Vendor Count %&quot; THEN STR(ROUND([11-16 Orders Vendor Count （複製）_1120129714283503641] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;16-30 Orders Vendor Count %&quot; THEN STR(ROUND([16-30 Orders Vendor Count （複製）_1120129714283601946] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;&gt;30 Orders Vendor Count %&quot; THEN STR(ROUND([&gt; 30 Orders Vendor Count （複製）_483362948514082816] * 100, 2)) + &quot;%&quot;&#10;&#10;END' />
            </column>
            <column caption='Total Incubated 30 Days Vendor Count' datatype='integer' name='[Calculation_2048997142710583296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([sf_opportunity_id])' />
            </column>
            <column caption='dynamic_date' datatype='date' name='[Calculation_483362948556054540]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//IF [day_type] = &quot;Week&quot; &#10;//  THEN str(DATEPART(&apos;year&apos;,[activated_date_local])) + &quot;-&quot; + str(DATEPART(&quot;week&quot;, [activated_date_local]))&#10;//ELSEIF [day_type] = &quot;Day&quot; &#10;//  THEN str(DATEPART(&quot;day&quot;,[activated_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&quot;month&quot;,[activated_date_local])),3)&#10;//ELSEIF [day_type] = &quot;Month&quot;&#10;//  THEN LEFT(str(DATENAME(&quot;month&quot;,[activated_date_local])),3)+&apos; &apos;+RIGHT(str(DATEPART(&quot;year&quot;,[activated_date_local])),2) &#10;//END&#10;&#10;IF [Parameters].[choose_dimension （複製）] = &quot;Week&quot; THEN&#10;    DATE( DATETRUNC(&apos;week&apos;, [incubated_30_days_date_local]) ) &#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Day&quot; THEN&#10;    DATE( DATETRUNC(&apos;day&apos;, [incubated_30_days_date_local]) )&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Month&quot; THEN&#10;    DATE( DATETRUNC(&apos;month&apos;, [incubated_30_days_date_local]) )&#10;END' />
            </column>
            <column caption='dynamic_date_filter' datatype='boolean' name='[Calculation_483362948556525581]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// if [day_type] = &apos;Month&apos; &#10;//   THEN [order_created_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))&#10;//ELSEIF [day_type] = &apos;Week&apos; &#10;//  THEN [order_created_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;week&apos;,TODAY()))&#10;//ELSEIF [day_type] = &apos;Day&apos; &#10;//  THEN [order_created_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;//END&#10;&#10;if [Parameters].[choose_dimension （複製）] = &apos;Month&apos; &#10;  THEN [incubated_30_days_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [incubated_30_days_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Week&apos; &#10;  THEN [incubated_30_days_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [incubated_30_days_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Day&apos; &#10;  THEN [incubated_30_days_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [incubated_30_days_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
            </column>
            <column caption='Zombie 30 Days Vendor Count' datatype='integer' name='[Total Incubated 30 Days Vendor Count （複製）_190840084236046336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [valid_order_count] WHEN 0 THEN [sf_opportunity_id] END)' />
            </column>
            <column caption='Total Offline %' datatype='real' name='[Total Offline in Seconds （複製）_218987576578068480]' role='measure' type='quantitative'>
