      <column caption='aaa_shop' datatype='string' name='[Calculation_332351625939755008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_aaa_shop_vendor] THEN &quot;KP&quot; ELSE &quot;Non-KP&quot; END' />
      </column>
      <column caption='dimensions' datatype='string' name='[Calculation_332351625940189185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;  WHEN &quot;City&quot; THEN [city_name]&#10;  WHEN &quot;Global Entity&quot; THEN [global_entity_id]&#10;  WHEN &quot;Clean Vertical&quot; THEN [global_cleaned_vertical_segment]&#10;  WHEN &quot;SF Vertical Segment&quot; THEN [sf_vertical_segment]&#10;  WHEN &quot;AAA Shop&quot; THEN [Calculation_332351625939755008]&#10;  ELSE NULL&#10;END' />
      </column>
      <column caption='AFV (EUR)' datatype='real' name='[Calculation_332351625945083906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_eur]) / SUM([valid_order_count])' />
      </column>
      <column caption='Activated Vendors' datatype='integer' name='[Calculation_332351625983762439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sf_opportunity_id])' />
      </column>
      <column caption='Orders per Vendor' datatype='real' name='[Calculation_332351625984352264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_order_count]) / [Calculation_332351625983762439]' />
      </column>
      <column caption='Order Metrics' datatype='real' name='[Calculation_332351625987710987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[參數 3]&#10;  WHEN &quot;Valid Orders&quot; THEN SUM([valid_order_count])&#10;  WHEN &quot;Orders per Vendor&quot; THEN [Calculation_332351625984352264]&#10;  WHEN &quot;GFV (EUR)&quot; THEN SUM([gfv_eur])&#10;  WHEN &quot;GFV per Vendor&quot; THEN [GMV per Vendor （複製）_332351625986072586]&#10;  WHEN &quot;GMV (EUR)&quot; THEN SUM([gmv_eur])&#10;  WHEN &quot;GMV per Vendor&quot; THEN [Orders per Vendor （複製）_332351625985998857]&#10;  WHEN &quot;AFV (EUR)&quot; THEN [Calculation_332351625945083906]&#10;  WHEN &quot;Activated Vendors&quot; THEN [Calculation_332351625983762439]&#10;END' />
      </column>
      <column caption='Dynamic Order Date' datatype='date' name='[Calculation_332351625992720397]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[choose_dimension （複製）] = &quot;Week&quot; THEN&#10;    DATE( DATETRUNC(&apos;week&apos;, [order_created_date_local]) ) &#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Day&quot; THEN&#10;    DATE( DATETRUNC(&apos;day&apos;, [order_created_date_local]) )&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Month&quot; THEN&#10;    DATE( DATETRUNC(&apos;month&apos;, [order_created_date_local]) )&#10;END' />
      </column>
      <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_332351625993039886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// if [day_type] = &apos;Month&apos; &#10;//   THEN [order_created_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))&#10;//ELSEIF [day_type] = &apos;Week&apos; &#10;//  THEN [order_created_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;week&apos;,TODAY()))&#10;//ELSEIF [day_type] = &apos;Day&apos; &#10;//  THEN [order_created_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;//END&#10;&#10;if [Parameters].[choose_dimension （複製）] = &apos;Month&apos; &#10;  THEN [order_created_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Week&apos; &#10;  THEN [order_created_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Day&apos; &#10;  THEN [order_created_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY()) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
      </column>
      <column caption='GFV per Vendor' datatype='real' name='[GMV per Vendor （複製）_332351625986072586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_eur]) / [Calculation_332351625983762439]' />
