              <calculation class='tableau' formula='SUM([checkin_offline_in_seconds]) &#10;  + SUM([monitor_realtime_delays_rule_offline_in_seconds]) &#10;  + SUM([monitor_realtime_fails_rule_offline_in_seconds])&#10;  + SUM([monitor_unreachable_offline_in_seconds])&#10;  + SUM([other_offline_in_seconds])&#10;  + SUM([vendor_device_busy_mode_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_bad_weather_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_no_drivers_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_outside_schedule_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_renovation_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_technical_problem_offline_in_seconds])&#10;  + SUM([vendor_device_self_closed_updating_menu_offline_in_seconds])' />
            </column>
            <column caption='Total Incubated 60 Days Vendor Count' datatype='integer' name='[Calculation_190840084270567430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([sf_opportunity_id])' />
            </column>
            <column caption='Incubation 60d Metrics Number' datatype='string' name='[Calculation_214765452273750017]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Incubated 30d Metrics （複製）_214765452271927296] &#10;  WHEN &quot;Total Incubation 60 Days Vendor Count&quot; THEN STR([Calculation_190840084270567430])&#10;  WHEN &quot;Zombie 60 Days Vendor Count&quot; THEN STR([Zombie 60 Days Vendor Count （複製）_190840084271046663])&#10;  WHEN &quot;Valid Order Count&quot; THEN STR(SUM([valid_order_count]))&#10;  WHEN &quot;Valid Order Count / All Shop Orders&quot; THEN STR(ROUND([Calculation_218987576585830404] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Valid GMV EUR&quot; THEN STR(ROUND(SUM([valid_gmv_eur]), 0))&#10;  WHEN &quot;Valid GMV / All Shop GMV&quot; THEN STR(ROUND([Calculation_218987576585977861] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Total Offline %&quot; THEN STR(ROUND([Total Offline in Seconds （複製）_218987576578068480] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Vendor Failed Order%&quot; THEN STR(ROUND([Calculation_218987576586194950] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;Contacts per Vendor&quot; THEN STR(ROUND([Calculation_218987576587706375], 2))&#10;  &#10;  WHEN &quot;Zombie 60 Days Vendor Count %&quot; THEN STR(ROUND([Zombie 60 Days Vendor Count （複製）_218987576585306113] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;1-5 Orders Vendor Count %&quot; THEN STR(ROUND([1-5 Orders Vendor Count （複製）_218987576589635592] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;6-10 Orders Vendor Count %&quot; THEN STR(ROUND([6-10 Orders Vendor Count （複製）_218987576590585867] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;11-15 Orders Vendor Count %&quot; THEN STR(ROUND([11-15 Orders Vendor Count （複製）_218987576590336009] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;16-30 Orders Vendor Count %&quot; THEN STR(ROUND([16-30 Orders Vendor Count （複製）_218987576590479370] * 100, 2)) + &quot;%&quot;&#10;  WHEN &quot;&gt;30 Orders Vendor Count %&quot; THEN STR(ROUND([&gt;30 Orders Vendor Count （複製）_218987576590704652] * 100, 2)) + &quot;%&quot;&#10;&#10;END' />
            </column>
            <column caption='dynamic_date' datatype='date' name='[Calculation_214765452274569218]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[choose_dimension （複製）] = &quot;Week&quot; THEN&#10;    DATE( DATETRUNC(&apos;week&apos;, [incubated_60_days_date_local]) ) &#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Day&quot; THEN&#10;    DATE( DATETRUNC(&apos;day&apos;, [incubated_60_days_date_local]) )&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &quot;Month&quot; THEN&#10;    DATE( DATETRUNC(&apos;month&apos;, [incubated_60_days_date_local]) )&#10;END' />
            </column>
            <column caption='dynamic_date_filter' datatype='boolean' name='[Calculation_214765452274696195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// if [day_type] = &apos;Month&apos; &#10;//   THEN [order_created_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;month&apos;,TODAY()))&#10;//ELSEIF [day_type] = &apos;Week&apos; &#10;//  THEN [order_created_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,0,DATETRUNC(&apos;week&apos;,TODAY()))&#10;//ELSEIF [day_type] = &apos;Day&apos; &#10;//  THEN [order_created_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [order_created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;//END&#10;&#10;if [Parameters].[choose_dimension （複製）] = &apos;Month&apos; &#10;  THEN [incubated_60_days_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [incubated_60_days_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Week&apos; &#10;  THEN [incubated_60_days_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;week&apos;,TODAY())) AND [incubated_60_days_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[choose_dimension （複製）] = &apos;Day&apos; &#10;  THEN [incubated_60_days_date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [incubated_60_days_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
            </column>
            <column caption='All Shop Orders' datatype='integer' name='[Calculation_218987576585555970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [incubated_60_days_date_local]: MAX([all_shop_order_count]) }' />
            </column>
            <column caption='All Shop GMV EUR' datatype='real' name='[Calculation_218987576585674755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [incubated_60_days_date_local]: MAX([all_shop_gmv_eur]) }' />
            </column>
            <column caption='Valid Orders / All Shop Orders' datatype='real' name='[Calculation_218987576585830404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_order_count]) / SUM([Calculation_218987576585555970])' />
            </column>
            <column caption='Valid GMV / All Shop GMV' datatype='real' name='[Calculation_218987576585977861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_gmv_eur]) / SUM([Calculation_218987576585674755])' />
            </column>
            <column caption='Vendor Failed Order%' datatype='real' name='[Calculation_218987576586194950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_order_count]) / SUM([gross_order_count])' />
            </column>
            <column caption='Contacts per Vendors' datatype='real' name='[Calculation_218987576587706375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contact_counts]) / [Calculation_190840084270567430]' />
            </column>
            <column caption='Total Offline %' datatype='real' name='[Total Offline in Seconds （複製）_218987576578068480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1120129714287300637] / SUM([total_open_in_seconds])' />
            </column>
            <column caption='Zombie 60 Days Vendor Count' datatype='integer' name='[Zombie 60 Days Vendor Count （複製）_190840084271046663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [valid_order_count] WHEN 0 THEN [sf_opportunity_id] END)' />
            </column>
            <column caption='Zombie 60 Days Vendor Count %' datatype='real' name='[Zombie 60 Days Vendor Count （複製）_218987576585306113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Zombie 60 Days Vendor Count （複製）_190840084271046663] / [Calculation_190840084270567430]' />
