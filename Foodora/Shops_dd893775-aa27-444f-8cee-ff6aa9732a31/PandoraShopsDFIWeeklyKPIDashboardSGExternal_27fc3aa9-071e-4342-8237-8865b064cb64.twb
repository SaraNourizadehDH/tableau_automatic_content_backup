    <worksheet name='VFR: Daily Crosstab'>
      <table>
        <view>
          <datasources>
            <datasource caption='shops__dfi_vendor_performance_dashboard' name='federated.05aoh2q1585k2u1at1tbc15n35ox' />
          </datasources>
          <datasource-dependencies datasource='federated.05aoh2q1585k2u1at1tbc15n35ox'>
            <column caption='% Online Rate' datatype='real' default-format='p0.0%' name='[% Partial Order Rate (copy)_3367074067779182622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([total_closed_mins]) / SUM([total_scheduled_open_mins])' />
            </column>
            <column caption='Is L7W' datatype='boolean' name='[Calculation_284923080281792512]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt; DATEADD(&apos;week&apos;, -8, NOW()) AND [report_date] &lt;= DATETRUNC(&apos;iso-week&apos;, NOW()) - 1' />
            </column>
            <column caption='Ext: % Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_3367074067765153807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_vendor_failed_orders]) / SUM(ZN([num_of_valid_orders]) + ZN([num_of_vendor_failed_orders]))' />
            </column>
            <column caption='Outlet ' datatype='string' name='[Calculation_6566951972865306624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_EXTRACT([vendor_name], &apos;\((.*?)\)&apos;)' />
