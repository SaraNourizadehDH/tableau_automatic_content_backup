          <datasource-dependencies datasource='federated.0b9pp051lkpk6m13ibzue1avgvof'>
            <column caption='Measure Filter' datatype='string' name='[Calculation_1296755242676133889]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 2]&#13;&#10;WHEN  &quot;Deflection Rate %&quot; THEN &quot;Deflection Rate %&quot;&#13;&#10;WHEN  &quot;Correct RCR %&quot; THEN &quot;Correct RCR %&quot;&#13;&#10;WHEN  &quot;% of misclassified rcrs&quot; THEN &quot;% of misclassified rcrs&quot;&#13;&#10;WHEN  &quot;No RCR %&quot; THEN &quot;No RCR %&quot;&#13;&#10;WHEN  &quot;HC RSAT %&quot; THEN &quot;HC RSAT %&quot;&#13;&#10;WHEN  &quot;AC RSAT %&quot; THEN &quot;AC RSAT %&quot;&#13;&#10;WHEN &quot;Desirability %&quot; THEN &quot;Desirability %&quot;&#13;&#10;WHEN &quot;Avg. Time to reach First Leaf (sec)&quot; THEN &quot;Avg. Time to reach First Leaf (sec)&quot;&#13;&#10;WHEN &quot;Avg. Time to reach Last Leaf (sec)&quot; THEN &quot;Avg. Time to reach Last Leaf (sec)&quot;&#10;WHEN &quot;HC Rating&quot; THEN &quot;HC Rating&quot;&#10;WHEN &quot;HC Rating Positive Responses&quot; THEN &quot;HC Rating Positive Responses&quot;&#10;WHEN &quot;HC Rating Negative Responses&quot; THEN &quot;HC Rating Negative Responses&quot;&#10;WHEN &quot;% of misclassified rcrs within same level&quot; THEN &quot;% of misclassified rcrs within same level&quot;&#10;WHEN &quot;% of misclassified rcrs not in same level&quot; THEN &quot;% of misclassified rcrs not in same level&quot;&#10;WHEN &quot;Chat Count&quot; THEN &quot;Chat Count&quot;&#13;&#10;END' />
            </column>
            <column caption='Date NULL Filter' datatype='boolean' name='[Calculation_1353613228580708352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= DATE(&quot;2021-03-09&quot;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='% of no rcr' datatype='real' default-format='p0.00%' name='[Calculation_258957029280591879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_rcr_data_from_leaf])/SUM([total_rcr_check])' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
            </column>
