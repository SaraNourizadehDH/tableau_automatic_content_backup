            </column>
            <column caption='Date NULL Filter (Rating)' datatype='boolean' name='[Date NULL Filter (AC VSAT) (copy)_106045762409996290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= DATE(&quot;2021-07-01&quot;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Deflection' datatype='string' name='[deflection]' role='dimension' type='nominal' />
