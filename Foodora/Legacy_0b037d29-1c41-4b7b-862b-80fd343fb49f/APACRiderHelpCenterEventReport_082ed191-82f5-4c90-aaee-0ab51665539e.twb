    <worksheet name='RCR Passive RSAT'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cx_rider_helpcenter_contact (pandata_report)' name='federated.07xogug1htcsso10ramlo0gwf522' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Detractor RSAT % (Chat)' caption='KPI' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Detractor RSAT \%&quot;'>
              <calculation class='tableau' formula='&quot;Detractor RSAT %&quot;' />
              <aliases>
                <alias key='&quot;Detractor RSAT \%&quot;' value='Detractor RSAT % (Chat)' />
                <alias key='&quot;Passive RSAT \%&quot;' value='Passive RSAT % (Chat)' />
                <alias key='&quot;Promotor RSAT \%&quot;' value='Promotor RSAT % (Chat)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07xogug1htcsso10ramlo0gwf522'>
            <column caption='Passive RSAT %' datatype='real' default-format='p0.0%' name='[Calculation_1616229384305102849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([passive_vsat]) / SUM([vsat_responses])' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
            </column>
            <column caption='KPI Filter' datatype='string' name='[Calculation_708472584400809985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Chat AHT min&apos; THEN &apos;Chat AHT min&apos;&#13;&#10;WHEN &apos;Chat AQT sec&apos; THEN &apos;Chat AQT sec&apos;&#13;&#10;WHEN &apos;Missed Chats %&apos; THEN &apos;Missed Chats %&apos;&#13;&#10;WHEN &apos;Chat SLA 30 sec %&apos; THEN &apos;Chat SLA 30 sec %&apos;&#13;&#10;WHEN &apos;Incoming Chats&apos; THEN &apos;Incoming Chats&apos;&#13;&#10;WHEN &apos;Incoming Cases&apos; THEN &apos;Incoming Cases&apos;&#13;&#10;WHEN &apos;Incoming Cases %&apos; THEN &apos;Incoming Cases %&apos;&#13;&#10;WHEN &apos;Promotor RSAT %&apos; THEN &apos;Promotor RSAT %&apos;&#13;&#10;WHEN &apos;Passive RSAT %&apos; THEN &apos;Passive RSAT %&apos;&#13;&#10;WHEN &apos;Detractor RSAT %&apos; THEN &apos;Detractor RSAT %&apos;&#13;&#10;END' />
            </column>
