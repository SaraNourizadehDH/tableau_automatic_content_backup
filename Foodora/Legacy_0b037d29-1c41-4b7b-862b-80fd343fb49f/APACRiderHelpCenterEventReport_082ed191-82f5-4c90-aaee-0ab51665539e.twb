    <worksheet name='leaf deep'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cx_rider_helpcenter_leaf(pandata_report)' name='federated.0b9pp051lkpk6m13ibzue1avgvof' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0b9pp051lkpk6m13ibzue1avgvof'>
            <column caption='% of misclassified rcrs not in same level' datatype='real' default-format='p0.00%' name='[% of missclassified pcrs within same level (copy)_3542714447320739841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([misclassified_not_in_samercr_level_rcr])/SUM([total_rcr_check])' />
            </column>
            <column caption='% of deflected' datatype='real' default-format='p0.00%' name='[Calculation_1072701187653758979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (COUNT(IF [chats_created_on_this_leaf] &gt; 0 THEN [leaf] END) / COUNT([leaf]))' />
            </column>
            <column caption='Total Leaf' datatype='integer' name='[Calculation_1296755242666278912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([leaf])' />
            </column>
            <column caption='AC RSAT %' datatype='real' default-format='p0.0%' name='[Calculation_1336443255041675264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ac_rsat_4_5]) / SUM([ac_rsat_responses])' />
            </column>
            <column caption='Desirability' datatype='real' default-format='p0.00%' name='[Calculation_258957029279830016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(final_leaf_count)/SUM(leaf_count)' />
            </column>
            <column caption='deflected feedback rating' datatype='real' default-format='p0.00%' name='[Calculation_258957029280014337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([positive_rating_count]) / SUM([rating_count])' />
            </column>
            <column caption='avg time to reach (as first leaf, sec)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_258957029280112642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([from_start_to_first_visited_sum])/SUM([first_visited_count])' />
            </column>
            <column caption='avg time to reach (as last leaf, sec)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_258957029280194563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(from_start_to_last_visited_sum)/SUM(last_visited_count)' />
            </column>
            <column caption='% of correct rcrs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280288772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([correct_rcr])/SUM([total_rcr_check])' />
            </column>
            <column caption='% of misclassified rcrs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280497670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([misclassified_rcr])/SUM([total_rcr_check])' />
            </column>
            <column caption='% of no rcr' datatype='real' default-format='p0.00%' name='[Calculation_258957029280591879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_rcr_data_from_leaf])/SUM([total_rcr_check])' />
            </column>
            <column caption='HC RSAT %' datatype='real' default-format='p0.00%' name='[Calculation_258957029281402895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hc_rsat_4_5])/SUM([hc_rsat_count])' />
            </column>
            <column caption='% of misclassified rcrs within same level' datatype='real' default-format='p0.00%' name='[Calculation_3542714447320506368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([misclassified_within_samercr_level_rcr])/SUM([total_rcr_check])' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
