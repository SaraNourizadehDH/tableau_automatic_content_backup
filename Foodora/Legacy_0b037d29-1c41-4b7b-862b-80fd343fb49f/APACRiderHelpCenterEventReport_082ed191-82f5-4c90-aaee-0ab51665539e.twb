      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_chats])) - LOOKUP(ZN(SUM([total_chats])), 1)) / ABS(LOOKUP(ZN(SUM([total_chats])), 1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_chats])) - LOOKUP(ZN(SUM([total_chats])), 1)) / ABS(LOOKUP(ZN(SUM([total_chats])), 1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cases %' datatype='real' default-format='p0.0%' name='[Calculation_1567534213750542336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF LOWER([channel]) &lt;&gt; &apos;chat&apos; THEN [total_chats] END) / SUM([total_chats])' />
      </column>
      <column caption='Incoming Cases' datatype='integer' name='[Calculation_1567534213750939649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOWER([channel]) &lt;&gt; &apos;chat&apos; THEN [total_chats] END' />
      </column>
      <column caption='Date NULL Filter' datatype='boolean' name='[Calculation_1567534213751902210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= DATE(&apos;2021-07-15&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Promotor RSAT %' datatype='real' default-format='p0.0%' name='[Calculation_1616229384304869376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promotor_vsat]) / SUM([vsat_responses])' />
      </column>
      <column caption='Passive RSAT %' datatype='real' default-format='p0.0%' name='[Calculation_1616229384305102849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([passive_vsat]) / SUM([vsat_responses])' />
      </column>
      <column caption='Detractor RSAT %' datatype='real' default-format='p0.0%' name='[Calculation_1616229384305254402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([detractor_vsat]) / SUM([vsat_responses])' />
      </column>
      <column caption='Chat SLA 30 sec %' datatype='real' default-format='p0.0%' name='[Calculation_401383384790028288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([chat_sla_30]) / SUM([total_chats])' />
      </column>
      <column caption='AHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_401383384790429697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sum_duration_served_sec]) / SUM([served_chats])) / 60' />
      </column>
      <column caption='AQT sec' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_401383384790589442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_queue_time_sec]) / SUM([total_chats])' />
      </column>
      <column caption='Missed Chats %' datatype='real' default-format='p0.0%' name='[Calculation_401383384790798339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([missed_chats]) / SUM([total_chats])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
      </column>
      <column caption='KPI Filter' datatype='string' name='[Calculation_708472584400809985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Chat AHT min&apos; THEN &apos;Chat AHT min&apos;&#13;&#10;WHEN &apos;Chat AQT sec&apos; THEN &apos;Chat AQT sec&apos;&#13;&#10;WHEN &apos;Missed Chats %&apos; THEN &apos;Missed Chats %&apos;&#13;&#10;WHEN &apos;Chat SLA 30 sec %&apos; THEN &apos;Chat SLA 30 sec %&apos;&#13;&#10;WHEN &apos;Incoming Chats&apos; THEN &apos;Incoming Chats&apos;&#13;&#10;WHEN &apos;Incoming Cases&apos; THEN &apos;Incoming Cases&apos;&#13;&#10;WHEN &apos;Incoming Cases %&apos; THEN &apos;Incoming Cases %&apos;&#13;&#10;WHEN &apos;Promotor RSAT %&apos; THEN &apos;Promotor RSAT %&apos;&#13;&#10;WHEN &apos;Passive RSAT %&apos; THEN &apos;Passive RSAT %&apos;&#13;&#10;WHEN &apos;Detractor RSAT %&apos; THEN &apos;Detractor RSAT %&apos;&#13;&#10;END' />
      </column>
