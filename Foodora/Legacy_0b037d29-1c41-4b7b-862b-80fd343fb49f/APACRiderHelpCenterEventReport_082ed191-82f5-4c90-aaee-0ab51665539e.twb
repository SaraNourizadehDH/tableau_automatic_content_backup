              <calculation class='tableau' formula='1 - (COUNT(IF [chats_created_on_this_leaf] &gt; 0 THEN [leaf] END) / COUNT([leaf]))' />
            </column>
            <column caption='Deflection Rate' datatype='boolean' name='[Calculation_358599134869270528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;% of deflected&quot;' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
