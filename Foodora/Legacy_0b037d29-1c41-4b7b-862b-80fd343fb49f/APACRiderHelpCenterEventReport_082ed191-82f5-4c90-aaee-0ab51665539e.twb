            </column>
            <column caption='Deflected Leaf count' datatype='integer' name='[Calculation_543528232515338240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [deflection] = &quot;DEFLECTED&quot; THEN 1 ELSE 0 END)' />
