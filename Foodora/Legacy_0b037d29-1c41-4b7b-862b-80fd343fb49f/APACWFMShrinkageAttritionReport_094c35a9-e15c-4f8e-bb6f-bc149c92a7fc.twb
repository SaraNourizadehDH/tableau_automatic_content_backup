      <aliases enabled='yes' />
      <column caption='Online' datatype='real' default-format='p0.00%' name='[Calculation_599401021432471552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(sum(total_online)/sum(total_scheduled)) &gt;1 THEN 1 &#10;ELSE sum(total_online)/sum(total_scheduled) END' />
      </column>
      <column caption='Busy' datatype='real' default-format='p0.00%' name='[Calculation_599401021434535937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_busy)/SUM(total_scheduled)' />
      </column>
      <column caption='Assigned Task' datatype='real' default-format='p0.00%' name='[Calculation_599401021435023362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_assigned_task)/SUM(total_scheduled)' />
      </column>
      <column caption='Training' datatype='real' default-format='p0.00%' name='[Calculation_599401021435551747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_training)/sum(total_scheduled)' />
      </column>
      <column caption='Short Break' datatype='real' default-format='p0.00%' name='[Calculation_599401021436784644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(total_short_break)/sum(total_scheduled)' />
      </column>
      <column caption='Total Status Duration' datatype='real' name='[Calculation_599401021437038597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(total_online)+sum(total_assigned_task)+sum(total_short_break)+sum(total_training))/3600' />
      </column>
      <column caption='Total Schedualed' datatype='real' name='[Calculation_599401021437267974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(total_scheduled))/3600' />
      </column>
      <column caption='Count of Evaluations' datatype='integer' name='[Calculation_599401021671895047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([evaluated_by])' />
      </column>
      <column caption='Count of Shifts' datatype='integer' name='[Calculation_599401021672112136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([shift_start_time])' />
      </column>
      <column caption='Skill Level' datatype='string' name='[Calculation_599401021673181193]' role='dimension' type='nominal'>
