            <column caption='Month (1)' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([month]) &lt; 10 then str(YEAR([month])) + &quot;-0&quot; + str(month([month]))&#13;&#10;ELSE str(YEAR([month])) + &quot;-&quot; + str(month([month]))&#13;&#10;END' />
            </column>
