    <worksheet name='attrition week'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cx_wfm_attrition (pandata_report)' name='federated.0zos5s91v24duh1cfuvew1iviy42' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zos5s91v24duh1cfuvew1iviy42'>
            <column caption='Resigned Week' datatype='integer' name='[Calculation_1026257776709820417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([resigned_agent_count_week]))' />
            </column>
            <column caption='Joined Week' datatype='integer' name='[Calculation_1026257776709984259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([hired_agent_count_week]))' />
            </column>
            <column caption='Active Week' datatype='integer' name='[Calculation_1026257776716886022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([active_agent_count_week]))' />
            </column>
            <column caption='Start Week' datatype='integer' name='[Calculation_1026257776717430792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_1026257776716886022]) + ZN([Calculation_1026257776709820417])) - ZN([Calculation_1026257776709984259])' />
            </column>
            <column caption='Avg. HC Week' datatype='real' name='[Calculation_1026257776717910026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1026257776717430792]) + ((ZN([Calculation_1026257776709820417]) + ZN([Calculation_1026257776709984259]))/2)' />
            </column>
            <column caption='Attrition Rate Week' datatype='real' default-format='p0.00%' name='[Calculation_1026257776718266380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1026257776709820417]) / ZN([Calculation_1026257776717910026])' />
            </column>
            <column caption='BPO' datatype='string' name='[Calculation_1026257776718778381]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[bpo]' />
            </column>
            <column caption='Granularity Filter' datatype='string' name='[Calculation_1026257776776851471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Weekly&apos; THEN &apos;Weekly&apos;&#13;&#10;WHEN &apos;Monthly&apos; THEN &apos;Monthly&apos;&#13;&#10;END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_1639239951729369088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Week (1)' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([week]) &lt; 10 then str(ISOYEAR([week])) + &quot;-W0&quot; + str(ISOWEEK([week]))&#13;&#10;ELSE str(ISOYEAR([week])) + &quot;-W&quot; + str(ISOWEEK([week]))&#13;&#10;END' />
            </column>
            <column caption='Color Attrition Rate Week' datatype='string' default-format='p0.00%' name='[Color Attrition Rate (copy)_3734539679390941186]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1026257776718266380] &gt; 0.05&#10;THEN &quot;Red&quot;&#10;ELSE &quot;Green&quot;&#10;END' />
            </column>
            <column caption='Active Agent Count Week' datatype='integer' name='[active_agent_count_week]' role='dimension' type='quantitative' />
