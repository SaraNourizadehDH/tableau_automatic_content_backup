          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zos5s91v24duh1cfuvew1iviy42'>
            <column caption='Resigned Month' datatype='integer' name='[Calculation_1026257776709746688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([resigned_agent_count_month]))' />
            </column>
            <column caption='Joined Month' datatype='integer' name='[Calculation_1026257776709926914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([hired_agent_count_month]))' />
            </column>
            <column caption='Active Month' datatype='integer' name='[Calculation_1026257776716824581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([active_agent_count_month]))' />
            </column>
            <column caption='Start Month' datatype='integer' name='[Calculation_1026257776717193223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_1026257776716824581]) + ZN([Calculation_1026257776709746688])) - ZN([Calculation_1026257776709926914])' />
            </column>
            <column caption='Avg. HC Month' datatype='real' name='[Calculation_1026257776717643785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1026257776717193223]) + ((ZN([Calculation_1026257776709746688]) + ZN([Calculation_1026257776709926914]))/2)' />
            </column>
            <column caption='Attrition Rate Month' datatype='real' default-format='p0.00%' name='[Calculation_1026257776718041099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1026257776709746688]) / ZN([Calculation_1026257776717643785])' />
