    <worksheet name='Early Logout'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d3b348' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cx_wfm_kpis (pandata_report)' name='federated.0x8eu9r0jw5m4l1gyoowg0rhpqih' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x8eu9r0jw5m4l1gyoowg0rhpqih'>
            <column caption='0' datatype='integer' name='[Calculation_1639239951729369088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='day' datatype='string' name='[Calculation_3964012145402257417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_846465664209522689]+&quot;-0&quot;+str(day([report_date]))&#10;else [Calculation_846465664209522689]+&quot;-&quot;+str(day([report_date]))&#10;end' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_846465664209297408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK([report_date]) &lt; 10 THEN str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_846465664209522689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_846465664210001922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#10; when &apos;Daily&apos; then [Calculation_3964012145402257417]&#10; when &apos;Weekly&apos; then [Calculation_846465664209297408]&#10; when &apos;Monthly&apos; then [Calculation_846465664209522689]&#10;end' />
            </column>
            <column caption='Early Logout' datatype='real' name='[Calculation_964614752657133572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([early_logout_min]) / 60' />
            </column>
            <column caption='Early Logout %' datatype='real' default-format='p0.00%' name='[Calculation_964614752658075658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_964614752657133572]) / SUM([total_evaluation])' />
            </column>
            <column caption='Date Range' datatype='date' name='[Created Date (copy)_206321198124322816]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Color Early Logout %' datatype='string' default-format='p0.00%' name='[Early Logout % (copy)_6821897948103471109 1]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_964614752657133572]) / SUM([total_evaluation]) &gt; 0.05&#10;THEN &quot;Red&quot;&#10;ELSE &quot;Green&quot;&#10;END' />
            </column>
            <column caption='Bpo' datatype='string' name='[bpo]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Early Logout Min' datatype='integer' name='[early_logout_min]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1639239951729369088]' derivation='Max' name='[max:Calculation_1639239951729369088:qk]' pivot='key' type='quantitative' />
