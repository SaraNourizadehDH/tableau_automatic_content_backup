      <aliases enabled='yes' />
      <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([shift_date]) = 1 and ISOYEAR([shift_date]) = 2019 then &quot;2020-W01&quot;&#13;&#10;ELSEIF ISOWEEK([shift_date]) &lt; 10 then str(ISOYEAR([shift_date])) + &quot;-W0&quot; + str(ISOWEEK([shift_date]))&#13;&#10;ELSE str(ISOYEAR([shift_date])) + &quot;-W&quot; + str(ISOWEEK([shift_date]))&#13;&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([shift_date]) &lt; 10 then str(YEAR([shift_date])) + &quot;-0&quot; + str(month([shift_date]))&#13;&#10;ELSE str(YEAR([shift_date])) + &quot;-&quot; + str(month([shift_date]))&#13;&#10;END' />
      </column>
      <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([shift_date]) &lt; 10  then [Calculation_1769351764309393410]+&quot;-0&quot;+str(day([shift_date]))&#13;&#10;else [Calculation_1769351764309393410]+&quot;-&quot;+str(day([shift_date]))&#13;&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
      </column>
      <column caption='Tenure' datatype='string' name='[Calculation_894246031297482756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (DATEDIFF(&apos;day&apos;,[hiring_date],TODAY()))/30&lt;1 &#13;&#10;THEN &quot;0 Year 0 Month &quot;+STR(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY()))+&quot; Days&quot;&#13;&#10;&#13;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[hiring_date],TODAY()))/30&lt;12 &#13;&#10;THEN  &quot;0 Year &quot;+STR( ((int(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())))-(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())%30))/30)+&quot; Months &quot;+STR(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())%30)+&quot; Days&quot;&#13;&#10;&#13;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[hiring_date],TODAY()))/30&gt;12 &#13;&#10;THEN  STR( INT((((int(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())))-(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())%30))/30)/12))+&quot; Year &quot;+STR( (((int(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())))-(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())%30))/30)%12)+&quot; Months &quot;+STR(DATEDIFF(&apos;day&apos;,[hiring_date],TODAY())%30)+&quot; Days&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Is Terminated' datatype='boolean' name='[Calculation_903534739007221760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([termination_date]) = TRUE THEN FALSE ELSE TRUE END' />
      </column>
