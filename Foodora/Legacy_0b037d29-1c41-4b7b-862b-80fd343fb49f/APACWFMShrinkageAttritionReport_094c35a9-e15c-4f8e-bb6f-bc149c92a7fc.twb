      <aliases enabled='yes' />
      <column caption='SRT AHT (Min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CMB AHT (Min) (copy)_2271432743715692549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aht_srt_handling_time_min]) / SUM([aht_srt_cases_count])' />
      </column>
      <column caption='CS Non Live Contact Rate %' datatype='real' default-format='p0.00%' name='[CS Chats Contact Rate % (copy)_3964012145388003329]' role='measure' type='quantitative'>
