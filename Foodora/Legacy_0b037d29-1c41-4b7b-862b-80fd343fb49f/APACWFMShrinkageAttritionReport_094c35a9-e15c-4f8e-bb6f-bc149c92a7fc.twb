    <worksheet name='schedule adherence'>
      <repository-location id='scheduleadherence' path='/t/Foodora/workbooks/APACWFMShrinkageAttritionTEST' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cx_wfm_schedule_adherence (pandata_report)' name='federated.185hnyv00zh71i15injk91bzengz' />
          </datasources>
          <datasource-dependencies datasource='federated.185hnyv00zh71i15injk91bzengz'>
            <column caption='Online' datatype='real' default-format='p0.00%' name='[Calculation_599401021432471552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF(sum(total_online)/sum(total_scheduled)) &gt;1 THEN 1 &#10;ELSE sum(total_online)/sum(total_scheduled) END' />
            </column>
            <column caption='Busy' datatype='real' default-format='p0.00%' name='[Calculation_599401021434535937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(total_busy)/SUM(total_scheduled)' />
            </column>
            <column caption='Assigned Task' datatype='real' default-format='p0.00%' name='[Calculation_599401021435023362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(total_assigned_task)/SUM(total_scheduled)' />
            </column>
            <column caption='Training' datatype='real' default-format='p0.00%' name='[Calculation_599401021435551747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(total_training)/sum(total_scheduled)' />
            </column>
            <column caption='Short Break' datatype='real' default-format='p0.00%' name='[Calculation_599401021436784644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(total_short_break)/sum(total_scheduled)' />
            </column>
            <column caption='Total Status Duration' datatype='real' name='[Calculation_599401021437038597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(total_online)+sum(total_assigned_task)+sum(total_short_break)+sum(total_training))/3600' />
            </column>
            <column caption='Total Schedualed' datatype='real' name='[Calculation_599401021437267974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum(total_scheduled))/3600' />
            </column>
            <column caption='Count of Evaluations' datatype='integer' name='[Calculation_599401021671895047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([evaluated_by])' />
            </column>
            <column caption='Count of Shifts' datatype='integer' name='[Calculation_599401021672112136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([shift_start_time])' />
            </column>
            <column caption='Skill Level' datatype='string' name='[Calculation_599401021673181193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([skill_name],&quot;Transactional&quot;) then &quot;CS L1&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats eng ibex&quot;) then &quot;CS VIP&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats English TH&quot;) then &quot;CS L1&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Expert&quot;) then &quot;CS L1&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Specialized&quot;) then &quot;CS L1&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;specialized&quot;) then &quot;CS L1&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;VIP&quot;) then &quot;CS VIP&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Email&quot;) then &quot;Email&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Pandago&quot;) then &quot;Pandago&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Refund&quot;) then &quot;Refund&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Social media&quot;) then &quot;SOME&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Risk Fraud&quot;) then &quot;RFM&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Srt&quot;) then &quot;SRT&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Price Mapping&quot;) then &quot;Price Mapping&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;PandaGo&quot;) then &quot;Pandago&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Corporate&quot;) then &quot;Corporate&quot;&#10;&#10;&#10;ELSEIF CONTAINS([skill_name],&quot;Comms&quot;) then &quot;Comms&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Dispatch&quot;) then &quot;Dispatch&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Rider Support&quot;) then &quot;Rider Support&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Task Management System&quot;) then &quot;TMS&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Dormant Rider&quot;) then &quot;Dormant Rider&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Adhoc&quot;) then &quot;Adhoc&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Rider Calling&quot;) then &quot;Rider Calling&quot;&#10;&#10;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats singapore&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats hong kong&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats malaysia&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats thailand&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats bangladesh&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Chats hong kong&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Alpha&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Pros&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;Specialist&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Call Back&quot;) then &quot;CMB&quot;&#10;ELSEIF CONTAINS([skill_name],&quot;Wastage&quot;) then &quot;Wastage&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;Calls&quot;) then &quot;Calls&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;Tabsquare&quot;) then &quot;Tabsquare&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;Chats pakistan&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;Chats philippines&quot;) then &quot;PS Chat&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;Tl&quot;) then &quot;Others&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;RTA&quot;) then &quot;Others&quot;&#10;ELSEIF CONTAINS([skill_name], &quot;L3&quot;) then &quot;L3&quot;&#10;&#10;Else &quot;Mapping-error&quot;&#10;END' />
            </column>
