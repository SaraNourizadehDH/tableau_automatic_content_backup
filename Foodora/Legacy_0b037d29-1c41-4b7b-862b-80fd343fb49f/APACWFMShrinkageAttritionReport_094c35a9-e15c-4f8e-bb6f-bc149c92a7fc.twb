            </column>
            <column caption='Color PS Chat AHT(min) ' datatype='string' name='[Color PS Call AHT(min) (copy)_2537285872051253251]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2537285872050581506] &gt; 8.5&#10;THEN &quot;Red&quot;&#10;ELSE &quot;Green&quot;&#10;END' />
