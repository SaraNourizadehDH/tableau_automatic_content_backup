      <aliases enabled='yes' />
      <column caption='AVG. Wrap Up Time sec' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_124834179822415872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([wrap_up_time_seconds])/SUM([handled_cases])' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;Weekly&apos; then [Calculation_846465664209297408]&#13;&#10; when &apos;Monthly&apos; then [Calculation_846465664209522689]&#13;&#10;end' />
      </column>
      <column caption='QA%' datatype='real' name='[Calculation_478085274231439360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qa_score])/SUM([evaluation_count])' />
      </column>
      <column caption='AHT mins' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_478085274231590913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(ZN([handling_time_seconds]) +  ZN([wrap_up_time_seconds]))/SUM([handled_cases]))/60' />
      </column>
      <column caption='CSAT' datatype='real' default-format='p0.00%' name='[Calculation_478085274233085954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([csat_promotor])/SUM([rating_count])' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_846465664209297408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISOWEEK([report_date]) &lt; 10 THEN str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_846465664209522689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END' />
      </column>
      <column caption='Tenure' datatype='string' name='[Calculation_894246031297482756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY()))/30&lt;1 &#13;&#10;THEN &quot;0 Year 0 Month &quot;+STR(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY()))+&quot; Days&quot;&#13;&#10;&#13;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY()))/30&lt;12 &#13;&#10;THEN  &quot;0 Year &quot;+STR( ((int(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())))-(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())%30))/30)+&quot; Months &quot;+STR(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())%30)+&quot; Days&quot;&#13;&#10;&#13;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY()))/30&gt;12 &#13;&#10;THEN  STR( INT((((int(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())))-(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())%30))/30)/12))+&quot; Year &quot;+STR( (((int(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())))-(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())%30))/30)%12)+&quot; Months &quot;+STR(DATEDIFF(&apos;day&apos;,[hired_at_utc],TODAY())%30)+&quot; Days&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Is Terminated' datatype='boolean' name='[Calculation_903534739007221760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([terminated_at_utc]) = TRUE THEN FALSE ELSE TRUE END' />
      </column>
