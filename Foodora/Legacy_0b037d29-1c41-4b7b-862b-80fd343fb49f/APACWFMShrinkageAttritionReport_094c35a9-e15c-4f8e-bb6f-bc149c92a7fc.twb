        <calculation class='tableau' formula='SUM([sla_ps_email_count])/ [Calculation_846465664214405124]' />
      </column>
      <column caption='Country.' datatype='string' datatype-customized='true' name='[Calculation_1594415015122653184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([country],&quot;Bangaladesh&quot;) then &quot;Bangaladesh&quot;&#10;ELSEIF CONTAINS([country],&quot;Cambodia&quot;) then &quot;Cambodia&quot;&#10;ELSEIF CONTAINS([country],&quot;Hong Kong&quot;) then &quot;Hong Kong&quot;&#10;ELSEIF CONTAINS([country],&quot;Laos&quot;) then &quot;Laos&quot;&#10;ELSEIF CONTAINS([country],&quot;Malaysia&quot;) then &quot;Malaysia&quot;&#10;ELSEIF CONTAINS([country],&quot;Myanmar&quot;) then &quot;Myanmar&quot;&#10;ELSEIF CONTAINS([country],&quot;Pakistan&quot;) then &quot;Pakistan&quot;&#10;ELSEIF CONTAINS([country],&quot;Philippines&quot;) then &quot;Philippines&quot;&#10;ELSEIF CONTAINS([country],&quot;Singapore&quot;) then &quot;Singapore&quot;&#10;ELSEIF CONTAINS([country],&quot;Taiwan&quot;) then &quot;Taiwan&quot;&#10;ELSEIF CONTAINS([country],&quot;Thailand&quot;) then &quot;Thailand&quot;&#10;ELSEIF CONTAINS([country],&quot;APAC&quot;) then &quot;APAC&quot;&#10;END' />
      </column>
      <column caption='0' datatype='integer' name='[Calculation_1639239951729369088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Overflow Rate' datatype='real' name='[Calculation_2042171329849499648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([overflow_count])/SUM([total_contacts]))*100' />
      </column>
      <column caption='Chat Overall AHT (Min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2271432743707488256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aht_cs_chats_handling_time_min]+[aht_cs_chats_wrap_up_time_min]) / SUM([aht_cs_chats_count])' />
      </column>
      <column caption='Cs Emails AHT (Min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2271432743713357827]' role='measure' type='quantitative'>
