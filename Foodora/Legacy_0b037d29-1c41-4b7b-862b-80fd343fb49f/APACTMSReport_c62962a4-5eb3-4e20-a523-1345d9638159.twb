      <aliases enabled='yes' />
      <column caption='Agent email' datatype='string' name='[Agent_email]' role='dimension' type='nominal' />
      <column caption='Rejected Rate ' datatype='real' name='[Approval Rate (copy)_208713721909506049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([rejected_count])/SUM([Calculation_636414949510975489]))*100' />
      </column>
      <column caption='Pending count' datatype='integer' name='[Approval Rate (copy)_636414949521498117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [status] = &quot;AWAITING_FOR_ACTION&quot; &#10;then [uuid] END)' />
      </column>
      <column caption='Rejected  Rate ' datatype='real' default-format='p0.0%' name='[Approval Rate (copy)_636414949522841607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_636414949511913474]/[Calculation_636414949510975489]' />
      </column>
      <column caption='TAT Mins' datatype='real' name='[Calculation_208713721909817347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TAT])/SUM([count_of_requests])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_456271002456420372 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1 1]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
      </column>
      <column caption='TMS Inflow' datatype='integer' name='[Calculation_636414949510975489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([uuid])' />
      </column>
      <column caption='Rejected count' datatype='integer' name='[Calculation_636414949511913474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [action_type] = &quot;REJECTED&quot; &#10;then [uuid] END)' />
      </column>
      <column caption='Approval Rate' datatype='real' default-format='*0.0%' name='[Calculation_636414949521846278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Rejected Rate (copy)_636414949521170436]/[Calculation_636414949510975489]' />
      </column>
      <column caption='TAT Min' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_636414949523931145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TAT])/COUNT([uuid])' />
      </column>
      <column caption='Pending Rate' datatype='real' default-format='p0.0%' name='[Rejected  Rate  (copy)_636414949523021832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Approval Rate (copy)_636414949521498117]/[Calculation_636414949510975489]' />
      </column>
      <column caption='Approval count' datatype='integer' name='[Rejected Rate (copy)_636414949521170436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [action_type] = &quot;APPROVED&quot; &#10;then [uuid] END)' />
