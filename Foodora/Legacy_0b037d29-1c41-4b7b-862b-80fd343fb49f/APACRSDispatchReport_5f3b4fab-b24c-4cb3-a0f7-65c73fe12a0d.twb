      <column caption='Count/Distribution Filter' datatype='string' name='[Calculation_1214846049360773121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Count&quot; THEN &quot;Count&quot;&#13;&#10;WHEN &quot;Distribution&quot; THEN &quot;Distribution&quot;&#13;&#10;END' />
      </column>
      <column caption='Large Order Filter' datatype='string' name='[Calculation_1214846049362415618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Large Orders with Issues (Actions)&quot; THEN &quot;Large Order with Issues (Actions)&quot;&#13;&#10;WHEN &quot;Large Orders&quot; THEN &quot;Large Orders&quot;&#13;&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([order_date]) &lt; 10 then str(YEAR([order_date])) + &quot;-0&quot; + str(month([order_date]))&#13;&#10;ELSE str(YEAR([order_date])) + &quot;-&quot; + str(month([order_date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([order_date]) &lt; 10 then str(ISOYEAR([order_date])) + &quot;-W0&quot; + str(ISOWEEK([order_date]))&#13;&#10;ELSE str(ISOYEAR([order_date])) + &quot;-W&quot; + str(ISOWEEK([order_date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([order_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([order_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([order_date]))&#13;&#10;end' />
      </column>
      <column caption='Date (1)' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
      </column>
      <column caption='KPI Filter' datatype='string' name='[Calculation_995295567541276672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;Avg. Time from Issue Creation to Issue Pickup min&quot; THEN &quot;Avg. Time from Issue Creation to Issue Pickup min&quot;&#13;&#10;WHEN &quot;Avg. Time from Issue Pickup to Issue Processed min&quot; THEN &quot;Avg. Time from Issue Pickup to Issue Processed min&quot;&#13;&#10;WHEN &quot;Avg. Time from Issue Processed to Issue Resolved min&quot; THEN &quot;Avg. Time from Issue Processed to Issue Resolved min&quot;&#13;&#10;WHEN &quot;Large Orders&quot; THEN &quot;Large Orders&quot;&#13;&#10;WHEN &quot;Large Orders with Issues (Actions)&quot; THEN &quot;Large Orders with Issues (Actions)&quot;&#13;&#10;WHEN &quot;Large Orders Value (EUR)&quot; THEN &quot;Large Orders Value (EUR)&quot;&#13;&#10;WHEN &quot;Large Orders with Issues (Actions) Value (EUR)&quot; THEN &quot;Large Orders with Issues (Actions) Value (EUR)&quot;&#13;&#10;END' />
      </column>
      <column caption='AVG. Time Creation to Pickup min' datatype='real' name='[Calculation_99923666423881728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_create_pickup_min]) / SUM([count_create_pickup])' />
      </column>
      <column caption='AVG. Pickup to Processed min' datatype='real' name='[Calculation_99923666424459265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_pickup_processed_min]) / SUM([count_pickup_processed])' />
      </column>
      <column caption='AVG. Time Processed to Resolved min' datatype='real' name='[Calculation_99923666424750082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_processed_resolved_min]) / SUM([count_processed_resolved])' />
      </column>
