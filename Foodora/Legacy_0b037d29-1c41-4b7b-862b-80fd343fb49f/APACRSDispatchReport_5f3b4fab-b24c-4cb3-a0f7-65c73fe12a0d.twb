            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([created_date]) &lt; 10 then str(YEAR([created_date])) + &quot;-0&quot; + str(month([created_date]))&#13;&#10;ELSE str(YEAR([created_date])) + &quot;-&quot; + str(month([created_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([created_date]) &lt; 10 then str(ISOYEAR([created_date])) + &quot;-W0&quot; + str(ISOWEEK([created_date]))&#13;&#10;ELSE str(ISOYEAR([created_date])) + &quot;-W&quot; + str(ISOWEEK([created_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([created_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([created_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([created_date]))&#13;&#10;end' />
            </column>
            <column caption='Date (1)' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
            </column>
            <column caption='SLA (5 min) %' datatype='real' default-format='p0.00%' name='[SLA (10 min) % (copy)_567594295749124096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([orders_within_5_min])) / SUM(ZN([total_order_count]))' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
