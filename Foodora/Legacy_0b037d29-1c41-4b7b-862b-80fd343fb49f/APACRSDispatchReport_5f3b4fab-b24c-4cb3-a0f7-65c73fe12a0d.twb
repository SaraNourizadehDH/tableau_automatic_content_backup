            <column caption='KPI Filter' datatype='string' name='[Calculation_995295567541276672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;Avg. Time from Issue Creation to Issue Pickup min&quot; THEN &quot;Avg. Time from Issue Creation to Issue Pickup min&quot;&#13;&#10;WHEN &quot;Avg. Time from Issue Pickup to Issue Processed min&quot; THEN &quot;Avg. Time from Issue Pickup to Issue Processed min&quot;&#13;&#10;WHEN &quot;Avg. Time from Issue Processed to Issue Resolved min&quot; THEN &quot;Avg. Time from Issue Processed to Issue Resolved min&quot;&#13;&#10;WHEN &quot;Large Orders&quot; THEN &quot;Large Orders&quot;&#13;&#10;WHEN &quot;Large Orders with Issues (Actions)&quot; THEN &quot;Large Orders with Issues (Actions)&quot;&#13;&#10;WHEN &quot;Large Orders Value (EUR)&quot; THEN &quot;Large Orders Value (EUR)&quot;&#13;&#10;WHEN &quot;Large Orders with Issues (Actions) Value (EUR)&quot; THEN &quot;Large Orders with Issues (Actions) Value (EUR)&quot;&#13;&#10;END' />
