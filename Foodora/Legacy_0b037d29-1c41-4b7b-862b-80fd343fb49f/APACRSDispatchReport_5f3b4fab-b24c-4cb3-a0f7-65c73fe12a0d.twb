          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. Time from Issue Creation to Issue Pickup min&quot;'>
              <calculation class='tableau' formula='&quot;Avg. Time from Issue Creation to Issue Pickup min&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nu7ek10vxht1f1e385e00d28ix7'>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([order_date]) &lt; 10 then str(YEAR([order_date])) + &quot;-0&quot; + str(month([order_date]))&#13;&#10;ELSE str(YEAR([order_date])) + &quot;-&quot; + str(month([order_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([order_date]) &lt; 10 then str(ISOYEAR([order_date])) + &quot;-W0&quot; + str(ISOWEEK([order_date]))&#13;&#10;ELSE str(ISOYEAR([order_date])) + &quot;-W&quot; + str(ISOWEEK([order_date]))&#13;&#10;END' />
            </column>
