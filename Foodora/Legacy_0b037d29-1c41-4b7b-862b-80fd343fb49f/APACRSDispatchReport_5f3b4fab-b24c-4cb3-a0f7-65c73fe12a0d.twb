      <column caption='SLA 10 min' datatype='real' default-format='p0.00%' name='[Calculation_1010213727238180864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([resolved_within_sla]) / SUM([total_pop_up_watchlist])' />
      </column>
      <column caption='bpo_split' datatype='string' name='[Calculation_1266637438318637117]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([bpo],&apos;-&apos;,2)' />
      </column>
      <column caption='BPO' datatype='string' name='[Calculation_1266637438318837823]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([agent_email],&apos;_mibs&apos;) THEN &apos; MIBs&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_sbtmy&apos;) THEN &apos; Sellbytel/Webhelp&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_ibexfppk&apos;) THEN &apos; Ibex FPPK&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_ibexpk&apos;) THEN &apos; Ibex PK&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_mbpk.&apos;) THEN &apos; MindBridge&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_mbpkmc&apos;) THEN &apos;Not BPO data&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_gnx&apos;) THEN &apos; Genex&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_amkh&apos;) THEN &apos; Asia Master&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_tct&apos;) THEN &apos; TCT&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_tcjp&apos;) THEN &apos; TCJP&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_tcmy&apos;) THEN &apos; TCMY&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_tnjp&apos;) THEN &apos; Webhelp Japan&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;.my&apos;) THEN &apos; SSC&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;_acc&apos;) THEN &apos; Asean CC&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;.com.bd&apos;) THEN &apos; Local_BD&apos;&#13;&#10;ELSEIF CONTAINS([agent_email],&apos;@foodpanda.my&apos;) THEN &apos;SSC&apos;&#13;&#10;ELSEIF [bpo] = &apos;Not BPO data&apos; THEN &apos;Not BPO data&apos;&#13;&#10;ELSEIF ISNULL([bpo]) = TRUE THEN &apos;Not BPO data&apos;&#13;&#10;ELSE [Calculation_1266637438318637117]&#13;&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([date]) &lt; 10 then str(YEAR([date])) + &quot;-0&quot; + str(month([date]))&#13;&#10;ELSE str(YEAR([date])) + &quot;-&quot; + str(month([date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([date]) &lt; 10 then str(ISOYEAR([date])) + &quot;-W0&quot; + str(ISOWEEK([date]))&#13;&#10;ELSE str(ISOYEAR([date])) + &quot;-W&quot; + str(ISOWEEK([date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([date]))&#13;&#10;end' />
      </column>
      <column caption='Date (1)' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
      </column>
