      <aliases enabled='yes' />
      <column caption='Self Serve CSAT' datatype='real' default-format='p0.00%' name='[Automation CSAT (copy)_1184728215448567809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promoter_self_service_csat_count]) / SUM([self_service_csat_survey_count])' />
      </column>
      <column caption='Automation CSAT' datatype='real' default-format='p0.00%' name='[Calculation_1184728215448420352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promoter_automation_csat_count]) / SUM([automation_csat_survey_count])' />
      </column>
      <column caption='Self serve CSAT responses - Automation self serve CSAT responses' datatype='integer' name='[Calculation_1184728215795142658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([self_service_csat_survey_count]) - SUM([automation_csat_survey_count])' />
      </column>
      <column caption='Automated self serve CSAT responses %' datatype='real' default-format='p0.00%' name='[Calculation_1184728215814451209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([automation_csat_survey_count])/SUM([self_service_csat_survey_count])' />
      </column>
      <column caption='Non-automated self serve CSAT responses %' datatype='real' default-format='p0.00%' name='[Calculation_1184728215814647818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1184728215795142658])/([Calculation_1184728215814869003])' />
      </column>
      <column caption='Self serve csat count (sum)' datatype='integer' name='[Calculation_1184728215814869003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([self_service_csat_survey_count])' />
      </column>
      <column caption='DAY' datatype='string' name='[Calculation_4992310589213134851]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_4992310589213274116]+&quot;-0&quot;+str(day([report_date]))&#10;else [Calculation_4992310589213274116]+&quot;-&quot;+str(day([report_date]))&#10;end' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_4992310589213274116]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_4992310589213704197]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(YEAR([report_date])) + &quot;-Q&quot; + str(QUARTER([report_date]))' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_4992310589213749254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_4992310589214285831]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;Daily&apos; THEN [Calculation_4992310589213134851]&#10;ELSEIF[granularity] = &apos;Weekly&apos; THEN [Calculation_4992310589213749254]&#10;ELSEIF [granularity] = &apos;Monthly&apos; THEN [Calculation_4992310589213274116]&#10;ELSEIF  [granularity] = &apos;Quarterly&apos; THEN [Calculation_4992310589213704197]&#10;END' />
      </column>
