      <column caption='Date' datatype='string' name='[Calculation_414823778831679495]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 2] = &quot;day&quot; THEN [Week (copy)_414823778831478790]&#10;ELSEIF [Parameters].[Parameter 1 2] = &quot;week&quot; THEN [Calculation_414823778794184704]&#10;ELSEIF  [Parameters].[Parameter 1 2] = &quot;month&quot; THEN [Week (copy)_414823778830843909]&#10;END' />
      </column>
      <column caption='Adherence' datatype='boolean' name='[Calculation_96264497206509570]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [handling_time_minutes] &lt; 12 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Adherence %' datatype='real' default-format='p0.00%' name='[Calculation_96264497206702083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_96264497206509570] = TRUE THEN [case_number] END) / COUNTD([case_number])' />
      </column>
      <column caption='Report Date' datatype='date' name='[Calculation_96264497210904580]' role='dimension' type='ordinal'>
