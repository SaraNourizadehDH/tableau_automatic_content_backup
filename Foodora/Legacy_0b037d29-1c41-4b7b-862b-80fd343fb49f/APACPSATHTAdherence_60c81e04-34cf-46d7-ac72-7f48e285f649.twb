      </column>
      <column caption='Adherence %' datatype='real' name='[Calculation_96264497198153728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [adherence] = TRUE THEN [contact_id] END) / COUNTD([contact_id])' />
