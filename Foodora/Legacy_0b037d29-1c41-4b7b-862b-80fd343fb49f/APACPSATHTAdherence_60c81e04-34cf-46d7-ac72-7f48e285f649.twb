      </column>
      <column caption='Week' datatype='string' name='[Calculation_414823778794184704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISOWEEK([report_date]) &lt; 10 THEN STR(ISOYEAR([report_date])) + &quot;W-0&quot;  + STR(ISOWEEK([report_date]))&#10;ELSE STR(ISOYEAR([report_date])) + &quot;W-&quot;  + STR(ISOWEEK([report_date]))&#10;END' />
