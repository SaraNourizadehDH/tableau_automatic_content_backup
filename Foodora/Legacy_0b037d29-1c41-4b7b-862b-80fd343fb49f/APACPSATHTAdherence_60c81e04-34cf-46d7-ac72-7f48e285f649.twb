          <datasource-dependencies datasource='federated.1mg14t015wjhdu10r05sx1dt722w'>
            <column caption='Total Handling Time' datatype='real' name='[Calculation_2131117472331776000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([handling_time_in_seconds] / 60) + ([wrap_up_time_in_seconds]/60)' />
            </column>
            <column caption='Average Handling Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2131117472331931649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_2131117472331776000])' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_414823778794184704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK([report_date]) &lt; 10 THEN STR(ISOYEAR([report_date])) + &quot;W-0&quot;  + STR(ISOWEEK([report_date]))&#10;ELSE STR(ISOYEAR([report_date])) + &quot;W-&quot;  + STR(ISOWEEK([report_date]))&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_414823778831679495]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1 2] = &quot;day&quot; THEN [Week (copy)_414823778831478790]&#10;ELSEIF [Parameters].[Parameter 1 2] = &quot;week&quot; THEN [Calculation_414823778794184704]&#10;ELSEIF  [Parameters].[Parameter 1 2] = &quot;month&quot; THEN [Week (copy)_414823778830843909]&#10;END' />
            </column>
            <column caption='Adherence %' datatype='real' name='[Calculation_96264497198153728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [adherence] = TRUE THEN [contact_id] END) / COUNTD([contact_id])' />
            </column>
            <column caption='Month' datatype='string' name='[Week (copy)_414823778830843909]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([report_date]) &lt; 10 THEN STR(ISOYEAR([report_date])) + &quot;-0&quot;  + STR(MONTH([report_date]))&#10;ELSE STR(ISOYEAR([report_date])) + &quot;-&quot;  + STR(MONTH([report_date]))&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Week (copy)_414823778831478790]' role='dimension' type='nominal'>
