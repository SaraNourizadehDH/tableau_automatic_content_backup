      <column caption='Week' datatype='string' name='[Calculation_414823778794184704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISOWEEK([created_at_local]) &lt; 10 THEN STR(ISOYEAR([created_at_local])) + &quot;W-0&quot;  + STR(ISOWEEK([created_at_local]))&#10;ELSE STR(ISOYEAR([created_at_local])) + &quot;W-&quot;  + STR(ISOWEEK([created_at_local]))&#10;END' />
      </column>
      <column caption='Case Count' datatype='integer' name='[Calculation_414823778805084161]' role='measure' type='quantitative'>
