      <column caption='Zombie Revived (out of Successfully Contacted Zombies)' datatype='integer' default-format='n#,##0;-#,##0' name='[Zombie Revived (copy)_198017712640434179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(IF [successfully_called] &gt;= 1 THEN [zombie_revived] END, 0)' />
      </column>
      <column caption='Revival Rate (out of Successfully Contacted Zombies)' datatype='real' default-format='p0.0%' name='[Zombie Revived (out of Successfully Contacted Zombies) (copy)_198017712640770052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM((IF [successfully_called] &gt;= 1 THEN [zombie_revived] END))/SUM([successfully_called]), 0)' />
      </column>
