      <column caption='Successful Contact Rate' datatype='real' default-format='p0.0%' name='[Calculation_198017712633679874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successfully_called])/SUM([zombie_exercise_vendors])' />
      </column>
      <column caption='Unsuccessfully Called' datatype='integer' name='[Calculation_4559191000717209600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([zombie_exercise_vendors])-SUM([successfully_called])' />
      </column>
      <column caption='Select Data Type' datatype='string' name='[Calculation_4559191000731512833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [competitor_rating_priority]&#10;WHEN 2 THEN [competitor_gap_indicator]&#10;WHEN 3 THEN [zombie_age_group]&#10;WHEN 4 THEN [zombie_grade]&#10;END' />
