      <aliases enabled='yes' />
      <column caption='[Holistic] - % of Outcome Session' datatype='real' default-format='p0.00%' name='[% of Resolution Session (copy)_2027605017798537220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([session_with_outcome])) / SUM(ZN([last_visited_count]))' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0f3rl571yjydy41dylfu20wbdq9s].[pcto:sum:Calculation_95208928970694666:qk]&quot;' value='[Deflection] - Contacts Created Distribution %.' />
          <alias key='&quot;[federated.0f3rl571yjydy41dylfu20wbdq9s].[pcto:sum:chats_created_on_this_leaf:qk]&quot;' value='[Deflection] - Chats Created Distribution %.' />
          <alias key='&quot;[federated.0f3rl571yjydy41dylfu20wbdq9s].[pcto:sum:feedback_count:qk:2]&quot;' value='% of Total Feedback Count' />
          <alias key='&quot;[federated.0f3rl571yjydy41dylfu20wbdq9s].[pcto:sum:leaf_count:qk]&quot;' value='[Holistic] - Visits Diistribution %.' />
          <alias key='&quot;[federated.0f3rl571yjydy41dylfu20wbdq9s].[pcto:sum:tickets_created_on_this_leaf:qk]&quot;' value='[Deflection] - Tickets Created Distribution %.' />
          <alias key='&quot;[federated.0f3rl571yjydy41dylfu20wbdq9s].[usr:Calculation_202450917936091137:qk:2]&quot;' value='Weighted KPI Loss' />
          <alias key='&quot;[federated.0f3rl571yjydy41dylfu20wbdq9s].[usr:KPI Weight (copy)_206673019816304668:qk:2]&quot;' value='Weight' />
          <alias key='&quot;[Parameters].[Parameter 7]&quot;' value='Target' />
