            <column caption='Dimension country/apac' datatype='string' name='[Calculation_1096908000932163584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#10;WHEN &apos;Language&apos; THEN [language]&#13;&#10;ELSE &apos;APAC&apos; END' />
            </column>
            <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
            </column>
            <column caption='Country Filter' datatype='string' name='[Calculation_63050411993907200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Language&apos; Then [country]&#10;ELSE &apos;APAC&apos;&#10;END' />
