      <aliases enabled='yes' />
      <column caption='% of Outcome Session' datatype='real' default-format='p0.00%' name='[% of Resolution Session (copy)_2027605017798537220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([session_with_outcome])) / SUM(ZN([session]))' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1sqj91210kq7ba1acy3ej1g5ljjf].[sum:leaf_but_no_feedback_sessions:qk]&quot;' value='Leaf But No Feedback Session' />
          <alias key='&quot;[federated.1sqj91210kq7ba1acy3ej1g5ljjf].[sum:negative_feedback_session:qk]&quot;' value='Negative Feedback Session' />
          <alias key='&quot;[federated.1sqj91210kq7ba1acy3ej1g5ljjf].[sum:positive_feedback_session:qk]&quot;' value='Positive Feedback Sessions' />
          <alias key='&quot;[federated.1sqj91210kq7ba1acy3ej1g5ljjf].[sum:zero_leaf_sessions:qk]&quot;' value='Zero Leaf Sessions' />
        </aliases>
      </column>
      <column caption='Avg. Node count per Session' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Leaf per Session (copy)_631066913068257281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([node_count])) / SUM(ZN([session]))' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1096908000932163584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#10;WHEN &apos;Language&apos; THEN [language]&#13;&#10;ELSE &apos;APAC&apos; END' />
      </column>
      <column caption='Deflection Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1593429899190550528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM(ZN([contacted_session]) + ZN([automated_session]))/SUM([total_sessions_resolution_page_reached]))' />
      </column>
      <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
      </column>
      <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
      </column>
      <column caption='KPI' datatype='real' default-format='p0.00%' name='[Calculation_206673019778748420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Contribution Leaf (copy)_303922625575661572]&#10;WHEN &quot;HC CSAT&quot; THEN [Calculation_213217312186359808]*100&#10;WHEN &quot;NPS Finding Resolution&quot; THEN [Calculation_440789830280749056]&#10;WHEN &quot;NPS Navigation&quot; THEN [NPS Finding Resolution (copy)_440789830281289729]&#10;WHEN &quot;NPS Reaching Agent&quot; THEN [NPS Navigation (copy)_440789830281506818]&#10;END' />
      </column>
      <column caption='HC CSAT %' datatype='real' default-format='p0.00%' name='[Calculation_213217312186359808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hc_csat_4_5]) / SUM([hc_csat_responses])' />
      </column>
      <column caption='Blank Page Rate' datatype='real' default-format='p0.00%' name='[Calculation_2604910224928813056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([sessions_with_blank_pages_count]))/SUM(ZN([session]))' />
      </column>
      <column caption='NPS DATE FILTER' datatype='boolean' name='[Calculation_312648347773247488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= DATE(&apos;2021-05-03&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Automation Rate %' datatype='real' default-format='p0.0%' name='[Calculation_3607453708730396675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(ZN([automated_session]))/SUM(ZN([total_sessions_resolution_page_reached])) )' />
      </column>
      <column caption='KPI Country' datatype='real' default-format='p0.00%' name='[Calculation_438186197003702273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;% of Outcome Session&apos; THEN [% of Resolution Session (copy)_2027605017798537220]&#10;WHEN &apos;% of Resolution Session&apos; THEN [Calculation_748441978224623622]&#10;WHEN &apos;% of Session with Loop&apos; THEN [Calculation_748441978221944837]&#10;WHEN &apos;Deflection Rate %&apos; THEN [Calculation_1593429899190550528]&#10;WHEN &apos;HC CSAT %&apos; THEN [Calculation_213217312186359808]&#10;END' />
      </column>
      <column caption='NPS Finding Resolution' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_440789830280749056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(ZN([nps_promotor_finding_resolution])) - SUM(ZN([nps_detractor_finding_resolution]))) / SUM(ZN([nps_responses_finding_resolution])))* 100' />
      </column>
      <column caption='% of Contacted From Resolution' datatype='real' default-format='p0.00%' name='[Calculation_4591771704383299584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([contacted_session])) / SUM(ZN([resolution_session_count]))' />
      </column>
      <column caption='% Positive Feedback From Resolution' datatype='real' default-format='p0.00%' name='[Calculation_4591771704402993154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([positive_feedback_session]))/ SUM(ZN([resolution_session_count]))' />
      </column>
      <column caption='% Negative Feedback From Outcome' datatype='real' default-format='p0.00%' name='[Calculation_4591771704403664899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([negative_feedback_session]))/ SUM(ZN([session_with_outcome]))' />
      </column>
      <column caption='% Leaf But No Feedback' datatype='real' default-format='p0.00%' name='[Calculation_4591771704404508676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([leaf_but_no_feedback_sessions]))/ SUM(ZN([session]))' />
      </column>
      <column caption='% Zero Leaf Sessions' datatype='real' default-format='p0.00%' name='[Calculation_4591771704406126597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([zero_leaf_sessions]))/ SUM(ZN([session]))' />
      </column>
      <column caption='Country Filter' datatype='string' name='[Calculation_63050411993907200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Language&apos; Then [country]&#10;ELSE &apos;APAC&apos;&#10;END' />
      </column>
      <column caption='Avg. Leaf count per Session' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_631066913068077056]' role='measure' type='quantitative'>
