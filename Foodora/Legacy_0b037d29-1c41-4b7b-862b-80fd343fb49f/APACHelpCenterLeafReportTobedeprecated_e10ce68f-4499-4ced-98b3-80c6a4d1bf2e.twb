    <worksheet name='Contribution delta weight (Leaf)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Tableau_HC_Leaf (pandata_my)' name='federated.0f3rl571yjydy41dylfu20wbdq9s' />
            <datasource caption='Tableau_HC_Leaf_deflection (pandata_my)' name='federated.1sqj91210kq7ba1acy3ej1g5ljjf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Dimension Contribution Leaf' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Dimension (country/apac)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='KPI Contribution Leaf' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;[Content] - Information amount feedback rating&quot;'>
              <calculation class='tableau' formula='&quot;[Content] - Information amount feedback rating&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f3rl571yjydy41dylfu20wbdq9s'>
            <column caption='[Holistic] - Feedback Rating %' datatype='real' default-format='p0.00%' name='[Calculation_1224697638974537728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN(positive_feedback_rating)) / (SUM(ZN(positive_feedback_rating)) + SUM(ZN(negative_feedback_rating)))' />
            </column>
            <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
            </column>
            <column caption='Dimension Contribution Filter' datatype='string' name='[Calculation_206673019769409537]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Type&quot; THEN [type]&#10;WHEN &quot;Flow&quot; THEN [flow]&#10;WHEN &quot;Leaf&quot; THEN [leaf_name]&#10;WHEN &quot;Language&quot; THEN [language]&#10;END' />
            </column>
            <column caption='[Content] - Information quality total feedback rating count' datatype='integer' name='[Calculation_206673019812466707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_information_quality]) + ZN([rating_negative_information_quality])' />
            </column>
            <column caption='[AC CSAT] - AC CSAT' datatype='real' default-format='p0.00%' name='[Calculation_258957029280784393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([ac_csat_good_count]))/SUM(ZN([ac_csat_total_count]))' />
            </column>
            <column caption='Country Filter' datatype='string' name='[Calculation_63050411993907200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Language&apos; Then [country]&#10;ELSE &apos;APAC&apos;&#10;END' />
            </column>
            <column caption='[Deflection] - Deflection feedback rating' datatype='real' default-format='p0.00%' name='[Calculation_748441978219737088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([rating_positive_deflection]))) / (SUM(ZN([rating_positive_deflection])) + SUM(ZN([rating_negative_deflection])))' />
            </column>
            <column caption='[Content] - Information amount feedback rating' datatype='real' default-format='p0.00%' name='[Calculation_748441978220261377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([rating_positive_information_amount]))) / (SUM(ZN([rating_positive_information_amount])) + SUM(ZN([rating_negative_information_amount])))' />
            </column>
            <column caption='[Content] - Information quality feedback rating' datatype='real' default-format='p0.00%' name='[Calculation_748441978220552194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([rating_positive_information_quality]))) / (SUM(ZN([rating_positive_information_quality])) + SUM(ZN([rating_negative_information_quality])))' />
            </column>
            <column caption='[Navigation] - Navigation Feedback Rating' datatype='real' default-format='p0.00%' name='[Calculation_748441978220879875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([rating_positive_navigation]))) / (SUM(ZN([rating_positive_navigation])) + SUM(ZN([rating_negative_navigation])))' />
            </column>
            <column caption='[Other] - Other feedback rating' datatype='real' default-format='p0.00%' name='[Calculation_748441978221350916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([rating_positive_other]))) / (SUM(ZN([rating_positive_other])) + SUM(ZN([rating_negative_other])))' />
            </column>
            <column caption='[Holistic] - Feedback Rating Total Count' datatype='integer' name='[Calculation_95208928963198983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([positive_feedback_rating]) + ZN([negative_feedback_rating])' />
            </column>
            <column caption='[Navigation] - Navigation total feedback rating count ' datatype='integer' name='[Calculation_95208928967581704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_navigation]) + ZN([rating_negative_navigation])' />
            </column>
            <column caption='[Deflection] - Deflection total feedback rating count' datatype='integer' name='[Calculation_95208928969269257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_deflection]) + ZN([rating_negative_deflection])' />
            </column>
            <column caption='[Content] - Information amount total feedback rating count' datatype='integer' name='[Calculation_95208928976158731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_information_amount]) + ZN([rating_negative_information_amount])' />
            </column>
            <column caption='[Other] - Other total feedback rating count' datatype='integer' name='[Calculation_95208928980639756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_other]) + ZN([rating_negative_other])' />
            </column>
            <column caption='KPI TS Delta' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[KPI (copy)_303922625569525760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;//WHEN &quot;[AC CSAT] - AC CSAT&quot; THEN (ZN([[AC CSAT]] - AC CSAT]) - LOOKUP(ZN([[AC CSAT]] - AC CSAT]), 1)) * [Weight (for delta)] * 100&#10;//WHEN &quot;[Content] - Information amount feedback rating&quot; THEN (ZN([[Content]] - Information amount feedback rating]) - LOOKUP(ZN([[Content]] - Information amount feedback rating]), 1))*[Weight (for delta)] * 100&#10;//WHEN &quot;[Content] - Information quality feedback rating&quot; THEN (ZN([[Content]] - Information quality feedback rating]) - LOOKUP(ZN([[Content]] - Information quality feedback rating]), 1))*[Weight (for delta)] * 100&#10;//WHEN &quot;[Deflection] - Deflection feedback rating&quot; THEN (ZN([[Deflection]] - Deflection feedback rating]) - LOOKUP(ZN([[Deflection]] - Deflection feedback rating]), 1))*[Weight (for delta)] * 100&#10;//WHEN &quot;[Holistic] - Feedback Rating %&quot; THEN (ZN([[Holistic]] - Feedback Rating %]) - LOOKUP(ZN([[Holistic]] - Feedback Rating %]), 1))*[Weight (for delta)] * 100&#10;//WHEN &quot;[Navigation] - Navigation Feedback Rating&quot; THEN (ZN([[Navigation]] - Navigation Feedback Rating]) - LOOKUP(ZN([[Navigation]] - Navigation Feedback Rating]), 1))*[Weight (for delta)] * 100&#10;//WHEN &quot;[Other] - Other feedback rating&quot; THEN (ZN([[Other]] - Other feedback rating]) - LOOKUP(ZN([[Other]] - Other feedback rating]), 1))*[Weight (for delta)] * 100&#10;&#10;WHEN &quot;[AC CSAT] - AC CSAT&quot; THEN (ZN([Calculation_258957029280784393])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_258957029280784393]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Content] - Information amount feedback rating&quot; THEN (ZN([Calculation_748441978220261377])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978220261377]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Content] - Information quality feedback rating&quot; THEN (ZN([Calculation_748441978220552194])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978220552194]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Deflection] - Deflection feedback rating&quot; THEN (ZN([Calculation_748441978219737088])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978219737088]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Holistic] - Feedback Rating %&quot; THEN (ZN([Calculation_1224697638974537728])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_1224697638974537728]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Navigation] - Navigation Feedback Rating&quot; THEN (ZN([Calculation_748441978220879875])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978220879875]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Other] - Other feedback rating&quot; THEN (ZN([Calculation_748441978221350916])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978221350916]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
