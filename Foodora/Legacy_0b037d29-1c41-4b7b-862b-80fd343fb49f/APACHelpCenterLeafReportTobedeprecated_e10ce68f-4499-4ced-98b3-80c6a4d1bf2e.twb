    <worksheet name='drill'>
      <table>
        <view>
          <datasources>
            <datasource caption='Tableau_HC_Leaf (pandata_my)' name='federated.0f3rl571yjydy41dylfu20wbdq9s' />
            <datasource caption='Tableau_HC_Leaf_deflection (pandata_my)' name='federated.1sqj91210kq7ba1acy3ej1g5ljjf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Country / APAC' caption='Dimension' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dimension 2&quot;'>
              <calculation class='tableau' formula='&quot;Dimension 2&quot;' />
              <aliases>
                <alias key='&quot;Dimension 2&quot;' value='Country / APAC' />
              </aliases>
            </column>
            <column caption='Dimension (country/apac)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f3rl571yjydy41dylfu20wbdq9s'>
            <column caption='Deflection.' datatype='string' name='[Calculation_1069886443150147584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [type] = &quot;Static&quot; AND [leaf_name] != &quot;voucher|voucherDoesNotWork&quot; THEN &quot;DEFLECTED&quot;&#13;&#10;ELSEIF [type] = &quot;Static&quot; AND [leaf_name] = &quot;voucher|voucherDoesNotWork&quot; THEN &quot;NOT DEFLECTED&quot;&#13;&#10;ELSE [deflection]&#13;&#10;END' />
            </column>
            <column caption='Dimension country/apac' datatype='string' name='[Calculation_1096908000932163584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#10;WHEN &apos;Language&apos; THEN [language]&#13;&#10;ELSE &apos;APAC&apos; END' />
            </column>
            <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
            </column>
            <column caption='Contacts Created Count' datatype='integer' name='[Calculation_268949362555387907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([chat_created_count]) + ZN([case_created_count])' />
            </column>
            <column caption='[Deflection] - Leaf deflection rate' datatype='real' default-format='p0.00%' name='[Calculation_3764235271044554752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([Calculation_268949362555387907]) / SUM([leaf_count]))' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_581245842366717954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Dimension 2&apos; THEN [Calculation_1096908000932163584]&#13;&#10;WHEN &apos;Type&apos; THEN [type]&#13;&#10;WHEN &apos;Flow&apos; THEN [flow]&#13;&#10;WHEN &apos;Leaf&apos; THEN [leaf_name]&#10;WHEN  &apos;Language&apos; THEN [language]&#13;&#10;END' />
            </column>
            <column caption='Country Filter' datatype='string' name='[Calculation_63050411993907200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Language&apos; Then [country]&#10;ELSE &apos;APAC&apos;&#10;END' />
            </column>
            <column caption='Case Created Count' datatype='integer' hidden='true' name='[case_created_count]' role='measure' type='quantitative' />
            <column caption='Chats Created Count' datatype='integer' hidden='true' name='[chat_created_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Deflection' datatype='string' name='[deflection]' role='dimension' type='nominal' />
