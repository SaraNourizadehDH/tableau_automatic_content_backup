          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Dimension Contribution Leaf' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Dimension (country/apac)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='KPI Contribution Leaf' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;[Content] - Information amount feedback rating&quot;'>
              <calculation class='tableau' formula='&quot;[Content] - Information amount feedback rating&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f3rl571yjydy41dylfu20wbdq9s'>
            <column caption='Information Amount Weight' datatype='real' hidden='true' name='[AC CSAT Weight (copy)_206673019811885073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_95208928976158731]) / TOTAL(SUM([Calculation_95208928976158731]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
            </column>
            <column caption='Dimension Contribution Filter' datatype='string' name='[Calculation_206673019769409537]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Type&quot; THEN [type]&#10;WHEN &quot;Flow&quot; THEN [flow]&#10;WHEN &quot;Leaf&quot; THEN [leaf_name]&#10;WHEN &quot;Language&quot; THEN [language]&#10;END' />
            </column>
            <column caption='AC CSAT Weight' datatype='real' hidden='true' name='[Calculation_206673019810828303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ac_csat_total_count]) / TOTAL(SUM([ac_csat_total_count]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='[Content] - Information quality total feedback rating count' datatype='integer' name='[Calculation_206673019812466707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_information_quality]) + ZN([rating_negative_information_quality])' />
            </column>
            <column caption='Country Filter' datatype='string' name='[Calculation_63050411993907200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Language&apos; Then [country]&#10;ELSE &apos;APAC&apos;&#10;END' />
            </column>
            <column caption='[Holistic] - Feedback Rating Total Count' datatype='integer' name='[Calculation_95208928963198983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([positive_feedback_rating]) + ZN([negative_feedback_rating])' />
            </column>
            <column caption='[Navigation] - Navigation total feedback rating count ' datatype='integer' name='[Calculation_95208928967581704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_navigation]) + ZN([rating_negative_navigation])' />
            </column>
            <column caption='[Deflection] - Deflection total feedback rating count' datatype='integer' name='[Calculation_95208928969269257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_deflection]) + ZN([rating_negative_deflection])' />
            </column>
            <column caption='[Content] - Information amount total feedback rating count' datatype='integer' name='[Calculation_95208928976158731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_information_amount]) + ZN([rating_negative_information_amount])' />
            </column>
            <column caption='[Other] - Other total feedback rating count' datatype='integer' name='[Calculation_95208928980639756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_other]) + ZN([rating_negative_other])' />
            </column>
            <column caption='Feedback Rating Weight' datatype='real' hidden='true' name='[Deflection Feedback Weight (copy)_206673019813232661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_95208928963198983]) / TOTAL(SUM([Calculation_95208928963198983]))'>
