    <worksheet name='T_F_L (trend)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Tableau_HC_Leaf (pandata_my)' name='federated.0f3rl571yjydy41dylfu20wbdq9s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Dimension (country/apac)' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f3rl571yjydy41dylfu20wbdq9s'>
            <column caption='[Holistic] - % of Outcome Session' datatype='real' default-format='p0.00%' name='[% of Resolution Session (copy)_2027605017798537220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([session_with_outcome])) / SUM(ZN([last_visited_count]))' />
            </column>
            <column caption='Deflection.' datatype='string' name='[Calculation_1069886443150147584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [type] = &quot;Static&quot; AND [leaf_name] != &quot;voucher|voucherDoesNotWork&quot; THEN &quot;DEFLECTED&quot;&#13;&#10;ELSEIF [type] = &quot;Static&quot; AND [leaf_name] = &quot;voucher|voucherDoesNotWork&quot; THEN &quot;NOT DEFLECTED&quot;&#13;&#10;ELSE [deflection]&#13;&#10;END' />
            </column>
            <column caption='[Holistic] - Feedback Rating %' datatype='real' default-format='p0.00%' name='[Calculation_1224697638974537728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN(positive_feedback_rating)) / (SUM(ZN(positive_feedback_rating)) + SUM(ZN(negative_feedback_rating)))' />
            </column>
            <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
            </column>
            <column caption='[Content] - Information quality total feedback rating count' datatype='integer' name='[Calculation_206673019812466707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([rating_positive_information_quality]) + ZN([rating_negative_information_quality])' />
            </column>
            <column caption='[Deflection] - Avg. FRT Chat min' datatype='real' name='[Calculation_212302522770763776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([chat_frt_sec])) / SUM(ZN([chat_created_count]))) / 60' />
            </column>
            <column caption='[Deflection] - Avg. FRT Agent min' datatype='real' name='[Calculation_212302522771345409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([agent_chat_frt_sec])) / SUM(ZN([chat_created_count]))) / 60' />
            </column>
            <column caption='[Deflection] - Avg. FRT Non-Live hr' datatype='real' name='[Calculation_212302522771660802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([case_frt_min])) / SUM(ZN([case_created_count]))) / 60' />
            </column>
            <column caption='[Navigation] - Navigation Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522793144323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Calculation_95208928967581704])) / ZN([Calculation_212302522795819013])' />
            </column>
            <column caption='Total Rating Responses (Attribute Rating)' datatype='integer' name='[Calculation_212302522795819013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([rating_positive_navigation])) + SUM(ZN([rating_negative_navigation])) + &#10;SUM(ZN([rating_negative_information_quality])) + SUM(ZN([rating_positive_information_quality])) +&#10;SUM(ZN([rating_negative_information_amount])) + SUM(ZN([rating_positive_information_amount])) +&#10;SUM(ZN([rating_negative_deflection])) + SUM(ZN([rating_positive_deflection])))' />
            </column>
            <column caption='[Deflection] - Deflection Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522800414728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Calculation_95208928969269257])) / ZN([Calculation_212302522795819013])' />
            </column>
            <column caption='[Content] - Information Amount Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522801635337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Calculation_95208928976158731])) / ZN([Calculation_212302522795819013])' />
            </column>
            <column caption='[Content] - Information Quality Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522802532362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Calculation_206673019812466707])) / ZN([Calculation_212302522795819013])' />
            </column>
            <column caption='[Holistic] - Desirability' datatype='real' default-format='p0.00%' name='[Calculation_258957029279830016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(final_leaf_count)/SUM(leaf_count)' />
            </column>
            <column caption='[Navigation] - Avg. time to reach this leaf (as first leaf, sec)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_258957029280112642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(from_start_to_first_visited_sum)/SUM(first_visited_count)' />
            </column>
            <column caption='[Navigation] - Avg. time to reach this leaf (as last leaf, sec)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_258957029280194563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(from_start_to_last_visited_sum)/SUM(last_visited_count)' />
            </column>
            <column caption='[Deflection] - % of correct CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280288772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(correct_ccr)/SUM(total_ccr_check)' />
            </column>
            <column caption='[Deflection] - % of partially classified CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280411653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(partialy_correct_ccr)/SUM(total_ccr_check)' />
            </column>
            <column caption='[Deflection] - % of misclassified CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280497670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(misclassified_ccr)/SUM(total_ccr_check)' />
            </column>
            <column caption='[Deflection] - % of no CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280591879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(no_ccr_data_from_leaf)/SUM(total_ccr_check)' />
            </column>
            <column caption='[AC CSAT] - AC CSAT' datatype='real' default-format='p0.00%' name='[Calculation_258957029280784393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([ac_csat_good_count]))/SUM(ZN([ac_csat_total_count]))' />
            </column>
            <column caption='[AC CSAT] - AC CSAT Outcome' datatype='real' default-format='p0.00%' name='[Calculation_258957029281193997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ac_csat_outcome_positive_count)/(SUM(ac_csat_outcome_positive_count)+SUM(ac_csat_outcome_negative_count))' />
            </column>
            <column caption='[Holistic] - HC CSAT' datatype='real' default-format='p0.00%' name='[Calculation_258957029281402895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([csat_4_5]))/SUM(ZN([csat_count]))' />
            </column>
            <column caption='[AC CSAT] - AC CSAT Explanation Quality' datatype='real' default-format='p0.00%' name='[Calculation_258957029285232656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ac_csat_explanation_quality_positive_count]) / (SUM(ZN([ac_csat_explanation_quality_positive_count])) + SUM(ZN([ac_csat_explanation_quality_negative_count])))' />
            </column>
            <column caption='[AC CSAT] - AC CSAT Question Understanding' datatype='real' default-format='p0.00%' name='[Calculation_258957029286027281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ac_csat_question_undestanding_positive_count]) / (SUM(ZN([ac_csat_question_undestanding_positive_count])) + SUM(ZN([ac_csat_question_undestanding_negative_count])))' />
            </column>
            <column caption='[AC CSAT] - AC CSAT Agent Knowledge' datatype='real' default-format='p0.00%' name='[Calculation_258957029286985746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ac_csat_agent_knowledge_positive_count]) / (SUM(ZN([ac_csat_agent_knowledge_positive_count])) + SUM(ZN([ac_csat_agent_knowledge_negative_count])))' />
            </column>
            <column caption='[Navigation] - Avg. Nodes # to reach this Leaf' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_402720349917450240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([total_node_to_reach_leaf])) / SUM(ZN([leaf_count]))' />
            </column>
            <column caption='[Navigation] - Avg. Time to reach Leaf (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_402720349917794305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([time_to_reach_leaf_session_start])) / SUM(ZN([leaf_count])))/60' />
            </column>
            <column caption='[Navigation] - Avg. Leaf # to reach this Leaf' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_402720349918466050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([leaf_to_reach])) / SUM(ZN([leaf_count]))' />
            </column>
