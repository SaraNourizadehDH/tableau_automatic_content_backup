      <column caption='KPI TS Delta' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[KPI (copy)_303922625569525760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Contribution Leaf (copy)_303922625575661572]&#10;//WHEN &quot;HC CSAT&quot; THEN (ZN([HC CSAT %]) - LOOKUP(ZN([HC CSAT %]), 1)) * [Weight (for delta)] * 100&#10;//WHEN &quot;NPS Finding Resolution&quot; THEN (ZN([NPS Finding Resolution]) - LOOKUP(ZN([NPS Finding Resolution]), 1)) * [Weight (for delta)]&#10;//WHEN &quot;NPS Navigation&quot; THEN (ZN([NPS Navigation]) - LOOKUP(ZN([NPS Navigation]), 1)) * [Weight (for delta)]&#10;//WHEN &quot;NPS Reaching Agent&quot; THEN (ZN([NPS Reaching Agent]) - LOOKUP(ZN([NPS Reaching Agent]), 1)) * [Weight (for delta)]&#10;&#10;WHEN &quot;HC CSAT&quot; THEN &#10;(ZN([Calculation_213217312186359808])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_213217312186359808]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;&#10;WHEN &quot;NPS Finding Resolution&quot; THEN &#10;(ZN([Calculation_440789830280749056])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_440789830280749056]), 1)*LOOKUP(ZN([Weight (copy)]), 1))&#10;WHEN &quot;NPS Navigation&quot; THEN &#10;(ZN([NPS Finding Resolution (copy)_440789830281289729])*ZN([Weight (copy)]) - LOOKUP(ZN([NPS Finding Resolution (copy)_440789830281289729]), 1)*LOOKUP(ZN([Weight (copy)]), 1))&#10;&#10;WHEN &quot;NPS Reaching Agent&quot; THEN &#10;(ZN([NPS Navigation (copy)_440789830281506818])*ZN([Weight (copy)]) - LOOKUP(ZN([NPS Navigation (copy)_440789830281506818]), 1)*LOOKUP(ZN([Weight (copy)]), 1))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Weight' datatype='real' default-format='p0.00%' name='[KPI (copy)_303922625579614216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Contribution Leaf (copy)_303922625575661572]&#10;WHEN &quot;HC CSAT&quot; THEN ([Calculation_213217312186359808]*100) * [KPI Weight (copy)_206673019816304668]&#10;WHEN &quot;NPS Finding Resolution&quot; THEN [Calculation_440789830280749056] * [KPI Weight (copy)_206673019816304668]&#10;WHEN &quot;NPS Navigation&quot; THEN [NPS Finding Resolution (copy)_440789830281289729] * [KPI Weight (copy)_206673019816304668]&#10;WHEN &quot;NPS Reaching Agent&quot; THEN [NPS Navigation (copy)_440789830281506818] * [KPI Weight (copy)_206673019816304668]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Response Weight' datatype='real' name='[KPI Weight (copy)_206673019816304668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Contribution Leaf (copy)_303922625575661572]&#10;WHEN &quot;HC CSAT&quot; THEN SUM(ZN([hc_csat_responses])) / TOTAL(SUM(ZN([hc_csat_responses])))&#10;WHEN &quot;NPS Finding Resolution&quot; THEN SUM(ZN([nps_responses_finding_resolution])) / TOTAL(SUM(ZN([nps_responses_finding_resolution])))&#10;WHEN &quot;NPS Navigation&quot; THEN SUM(ZN([nps_responses_navigation])) / TOTAL(SUM(ZN([nps_responses_navigation])))&#10;WHEN &quot;NPS Reaching Agent&quot; THEN SUM(ZN([nps_responses_reaching_agent])) / TOTAL(SUM(ZN([nps_responses_reaching_agent])))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NPS Navigation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[NPS Finding Resolution (copy)_440789830281289729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(ZN([nps_promotor_navigation])) - SUM(ZN([nps_detractor_navigation]))) / SUM(ZN([nps_responses_navigation])))*100' />
      </column>
      <column caption='NPS Reaching Agent' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[NPS Navigation (copy)_440789830281506818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(ZN([nps_promotor_reaching_agent])) - SUM(ZN([nps_detractor_reaching_agent]))) / SUM(ZN([nps_responses_reaching_agent])))*100' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Contribution Leaf (copy)_303922625575661572]&#10;WHEN &apos;HC CSAT&apos; THEN [hc_csat_responses]&#10;WHEN &apos;NPS Finding Resolution&apos; THEN [nps_responses_finding_resolution]&#10;WHEN &apos;NPS Navigation&apos; THEN [nps_responses_navigation]&#10;WHEN &apos;NPS Reaching Agent&apos; THEN [nps_responses_reaching_agent]&#10;END' />
