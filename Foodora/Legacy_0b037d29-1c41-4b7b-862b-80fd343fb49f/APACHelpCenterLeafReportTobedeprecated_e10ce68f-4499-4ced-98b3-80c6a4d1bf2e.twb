            <column caption='Nps Promotor Reaching Agent' datatype='integer' name='[nps_promotor_reaching_agent]' role='measure' type='quantitative' />
            <column caption='Nps Responses Finding Resolution' datatype='integer' name='[nps_responses_finding_resolution]' role='measure' type='quantitative' />
            <column caption='Nps Responses Navigation' datatype='integer' name='[nps_responses_navigation]' role='measure' type='quantitative' />
            <column caption='Nps Responses Reaching Agent' datatype='integer' name='[nps_responses_reaching_agent]' role='measure' type='quantitative' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[KPI (copy)_303922625569525760]' derivation='User' name='[usr:KPI (copy)_303922625569525760:ok]' pivot='key' type='ordinal'>
