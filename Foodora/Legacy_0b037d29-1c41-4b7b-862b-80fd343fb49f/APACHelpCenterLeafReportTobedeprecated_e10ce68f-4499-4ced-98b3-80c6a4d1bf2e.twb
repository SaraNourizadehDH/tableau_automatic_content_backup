            <column caption='Avg. Node count per Session' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Leaf per Session (copy)_631066913068257281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([node_count])) / SUM(ZN([session]))' />
