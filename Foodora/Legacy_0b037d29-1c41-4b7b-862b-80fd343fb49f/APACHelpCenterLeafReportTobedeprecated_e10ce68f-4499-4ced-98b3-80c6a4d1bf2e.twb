      <column caption='Information Amount Weight' datatype='real' hidden='true' name='[AC CSAT Weight (copy)_206673019811885073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_95208928976158731]) / TOTAL(SUM([Calculation_95208928976158731]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Deflection.' datatype='string' name='[Calculation_1069886443150147584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [type] = &quot;Static&quot; AND [leaf_name] != &quot;voucher|voucherDoesNotWork&quot; THEN &quot;DEFLECTED&quot;&#13;&#10;ELSEIF [type] = &quot;Static&quot; AND [leaf_name] = &quot;voucher|voucherDoesNotWork&quot; THEN &quot;NOT DEFLECTED&quot;&#13;&#10;ELSE [deflection]&#13;&#10;END' />
      </column>
      <column caption='% of deflected' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_1072701187653758979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [deflection] = &quot;DEFLECTED&quot; THEN 1 ELSE 0 END) / COUNT([leaf_raw])' />
      </column>
      <column caption='Type Filter' datatype='boolean' hidden='true' name='[Calculation_1072701187655774212]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;% of misclassified ccrs&quot; &#13;&#10;THEN [type] IN (&quot;Delivered&quot;, &quot;Live&quot;, &quot;Static&quot;)&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of no ccr&quot;&#13;&#10;THEN [type] IN (&quot;Live&quot;)&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of partially classified ccrs&quot;&#13;&#10;THEN [type] IN (&quot;Delivered&quot;, &quot;Live&quot;, &quot;Cancelled&quot;)&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of correct ccrs&quot;&#13;&#10;THEN [type] IN (&quot;Delivered&quot;, &quot;Live&quot;, &quot;Static&quot;)&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of deflected&quot;&#13;&#10;THEN [type] IN (&quot;Delivered&quot;, &quot;Live&quot;, &quot;Static&quot;, &quot;Cancelled&quot;)&#13;&#10;ELSE [type] IN (&quot;Delivered&quot;, &quot;Live&quot;, &quot;Static&quot;, &quot;Cancelled&quot;, &quot;Corporate&quot;)&#13;&#10;END' />
      </column>
      <column caption='Flow Filter' datatype='boolean' hidden='true' name='[Calculation_1072701187669970949]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;% of correct ccrs&quot;&#13;&#10;THEN [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;Vendor Delivery Delivered Late&quot;, &quot;Vendor Delivery Delivered&quot;, &quot;Shops Delivered&quot;, &quot;Pick Up Delivered&quot;)&#13;&#10;WHEN &quot;% of misclassified ccrs&quot;&#13;&#10;THEN [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;Vendor Delivery Delivered Late&quot;, &quot;Vendor Delivery Delivered&quot;, &quot;Shops Delivered&quot;, &quot;Pick Up Delivered&quot;)&#13;&#10;WHEN &quot;% of no ccr&quot;&#13;&#10;THEN [flow] IN (&quot;nonRestaurant&quot;, &quot;Pick Up&quot;)&#13;&#10;WHEN &quot;% of partially classified ccrs&quot;&#13;&#10;THEN [flow] IN (&quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;)&#13;&#10;WHEN &quot;% of deflected&quot;&#13;&#10;THEN [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;Vendor Delivery Delivered&quot;, &quot;Shops Delivered&quot;, &quot;PUDelivered&quot;)&#13;&#10;WHEN &quot;AC Csat Explanation Quality %&quot;&#13;&#10;THEN [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;corporate&quot;, &quot;Vendor Delivery Delivered Late&quot;, &quot;Shops Delivered&quot;, &quot;Pick Up Delivered&quot;)&#13;&#10;WHEN &quot;AC Csat Ease of Usage %&quot;&#13;&#10;THEN [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;corporate&quot;, &quot;Vendor Delivery Delivered Late&quot;, &quot;Shops Delivered&quot;, &quot;Pick Up Delivered&quot;)&#13;&#10;WHEN &quot;AC Csat Outcome %&quot;&#13;&#10;THEN [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;corporate&quot;, &quot;Shops Delivered&quot;, &quot;Pick Up Delivered&quot;)&#13;&#10;WHEN &quot;HC Csat %&quot;&#13;&#10;THEN [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;corporate&quot;, &quot;Shops Delivered&quot;, &quot;Pick Up Delivered&quot;)&#13;&#10;ELSE [flow] IN (&quot;Static&quot;, &quot;Own Delivery Delivered&quot;, &quot;Own Delivery&quot;, &quot;Vendor Delivery&quot;, &quot;cancelled&quot;, &quot;Shops&quot;, &quot;Own Delivery Delivered Late&quot;, &quot;Pick Up&quot;, &quot;corporate&quot;, &quot;Vendor Delivery Delivered Late&quot;, &quot;Vendor Delivery Delivered&quot;, &quot;Shops Delivered&quot;, &quot;Pick Up Delivered&quot;)&#13;&#10;END' />
      </column>
      <column caption='Dimension country/apac' datatype='string' name='[Calculation_1096908000932163584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#10;WHEN &apos;Language&apos; THEN [language]&#13;&#10;ELSE &apos;APAC&apos; END' />
      </column>
      <column caption='KPI Delta' datatype='real' name='[Calculation_118289881181175808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_206673019778748420] * 100' />
      </column>
      <column caption='[Holistic] - Feedback Rating %' datatype='real' default-format='p0.00%' name='[Calculation_1224697638974537728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN(positive_feedback_rating)) / (SUM(ZN(positive_feedback_rating)) + SUM(ZN(negative_feedback_rating)))' />
      </column>
      <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
      </column>
      <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
      </column>
      <column caption='Loss' datatype='real' name='[Calculation_202450917935648768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7] - [KPI (copy)_118289881181986819]' />
      </column>
      <column caption='Weight KPI Loss' datatype='real' name='[Calculation_202450917936091137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_202450917935648768]) * ZN([KPI Weight (copy)_206673019816304668])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dimension Contribution Filter' datatype='string' name='[Calculation_206673019769409537]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Type&quot; THEN [type]&#10;WHEN &quot;Flow&quot; THEN [flow]&#10;WHEN &quot;Leaf&quot; THEN [leaf_name]&#10;WHEN &quot;Language&quot; THEN [language]&#10;END' />
      </column>
      <column caption='Value / % / Δ Filter' datatype='string' name='[Calculation_206673019777466371]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
      </column>
      <column caption='KPI.' datatype='real' default-format='n#,##0.00000;-#,##0.00000' name='[Calculation_206673019778748420]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;[AC CSAT] - AC CSAT&quot; THEN [Calculation_258957029280784393]&#10;WHEN &quot;[Content] - Information amount feedback rating&quot; THEN [Calculation_748441978220261377]&#10;WHEN &quot;[Content] - Information quality feedback rating&quot; THEN [Calculation_748441978220552194]&#10;WHEN &quot;[Deflection] - Deflection feedback rating&quot; THEN [Calculation_748441978219737088]&#10;WHEN &quot;[Holistic] - Feedback Rating %&quot; THEN [Calculation_1224697638974537728]&#10;WHEN &quot;[Navigation] - Navigation Feedback Rating&quot; THEN [Calculation_748441978220879875]&#10;WHEN &quot;[Other] - Other feedback rating&quot; THEN [Calculation_748441978221350916]&#10;END' />
      </column>
      <column caption='AC CSAT Weight' datatype='real' hidden='true' name='[Calculation_206673019810828303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ac_csat_total_count]) / TOTAL(SUM([ac_csat_total_count]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Weight' datatype='real' name='[Calculation_206673019811586064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;[AC CSAT] - AC CSAT&quot; THEN ([Calculation_258957029280784393]*100) * [Calculation_206673019810828303]&#10;WHEN &quot;[Content] - Information amount feedback rating&quot; THEN ([Calculation_748441978220261377]*100) * [AC CSAT Weight (copy)_206673019811885073]&#10;WHEN &quot;[Content] - Information quality feedback rating&quot; THEN ([Calculation_748441978220552194]*100) * [Information Amount Weight (copy)_206673019812192274]&#10;WHEN &quot;[Deflection] - Deflection feedback rating&quot; THEN ([Calculation_748441978219737088]*100) * [Information Quality Weight (copy)_206673019812982804]&#10;WHEN &quot;[Holistic] - Feedback Rating %&quot; THEN ([Calculation_1224697638974537728] * [Deflection Feedback Weight (copy)_206673019813232661]*100)&#10;WHEN &quot;[Navigation] - Navigation Feedback Rating&quot; THEN ([Calculation_748441978220879875]*100) * [Deflection Feedback Weight (copy)_206673019813691414]&#10;WHEN &quot;[Other] - Other feedback rating&quot; THEN ([Calculation_748441978221350916]*100) * [Navigation Weight (copy)_206673019813928983]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='[Content] - Information quality total feedback rating count' datatype='integer' name='[Calculation_206673019812466707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([rating_positive_information_quality]) + ZN([rating_negative_information_quality])' />
      </column>
      <column caption='[Deflection] - Avg. FRT Chat min' datatype='real' name='[Calculation_212302522770763776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(ZN([chat_frt_sec])) / SUM(ZN([chat_created_count]))) / 60' />
      </column>
      <column caption='[Deflection] - Avg. FRT Agent min' datatype='real' name='[Calculation_212302522771345409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(ZN([agent_chat_frt_sec])) / SUM(ZN([chat_created_count]))) / 60' />
      </column>
      <column caption='[Deflection] - Avg. FRT Non-Live hr' datatype='real' name='[Calculation_212302522771660802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(ZN([case_frt_min])) / SUM(ZN([case_created_count]))) / 60' />
      </column>
      <column caption='[Navigation] - Navigation Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522793144323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Calculation_95208928967581704])) / ZN([Calculation_212302522795819013])' />
      </column>
      <column caption='Total Rating Responses (Attribute Rating)' datatype='integer' name='[Calculation_212302522795819013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(ZN([rating_positive_navigation])) + SUM(ZN([rating_negative_navigation])) + &#10;SUM(ZN([rating_negative_information_quality])) + SUM(ZN([rating_positive_information_quality])) +&#10;SUM(ZN([rating_negative_information_amount])) + SUM(ZN([rating_positive_information_amount])) +&#10;SUM(ZN([rating_negative_deflection])) + SUM(ZN([rating_positive_deflection])))' />
      </column>
      <column caption='[Deflection] - Deflection Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522800414728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Calculation_95208928969269257])) / ZN([Calculation_212302522795819013])' />
      </column>
      <column caption='[Content] - Information Amount Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522801635337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Calculation_95208928976158731])) / ZN([Calculation_212302522795819013])' />
      </column>
      <column caption='[Content] - Information Quality Feedback Rating Response %' datatype='real' default-format='p0.00%' name='[Calculation_212302522802532362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Calculation_206673019812466707])) / ZN([Calculation_212302522795819013])' />
      </column>
      <column caption='measure select' datatype='string' hidden='true' name='[Calculation_229120682047381505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;% of correct ccrs&quot; THEN &quot;% of correct ccrs&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of misclassified ccrs&quot; THEN &quot;% of misclassified ccrs&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of no ccr&quot; THEN &quot;% of no ccr&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of partially classified ccrs&quot; THEN &quot;% of partially classified ccrs&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;AC Csat %&quot; THEN &quot;AC Csat %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;AC Csat Agent Knowledge %&quot; THEN &quot;AC Csat Agent Knowledge %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;AC Csat Explanation Quality %&quot; THEN &quot;AC Csat Explanation Quality %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;AC Csat Question Understanding %&quot; THEN &quot;AC Csat Question Understanding %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;AC Csat Ease of Usage %&quot; THEN &quot;AC Csat Ease of Usage %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;AC Csat Outcome %&quot; THEN &quot;AC Csat Outcome %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Desirability %&quot; THEN &quot;Desirability %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;HC Csat %&quot; THEN &quot;HC Csat %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Avg Chain Length&quot; THEN &quot;Avg Chain Length&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Avg time to reach (first leaf) sec&quot; THEN &quot;Avg time to reach (first leaf) sec&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Avg time to reach (last leaf) sec&quot; THEN &quot;Avg time to reach (last leaf) sec&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;% of deflected&quot; THEN &quot;% of deflected&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Deflection Rate %&quot; THEN &quot;Deflection Rate %&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Rating Count&quot; THEN &quot;Rating Count&quot;&#13;&#10;END' />
      </column>
      <column caption='[Holistic] - Desirability' datatype='real' default-format='p0.00%' name='[Calculation_258957029279830016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(final_leaf_count)/SUM(leaf_count)' />
      </column>
      <column caption='deflected feedback rating' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_258957029280014337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(feedback_positive_count) / SUM(feedback_count)' />
      </column>
      <column caption='[Navigation] - Avg. time to reach this leaf (as first leaf, sec)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_258957029280112642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(from_start_to_first_visited_sum)/SUM(first_visited_count)' />
      </column>
      <column caption='[Navigation] - Avg. time to reach this leaf (as last leaf, sec)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_258957029280194563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(from_start_to_last_visited_sum)/SUM(last_visited_count)' />
      </column>
      <column caption='[Deflection] - % of correct CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280288772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(correct_ccr)/SUM(total_ccr_check)' />
      </column>
      <column caption='[Deflection] - % of partially classified CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280411653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(partialy_correct_ccr)/SUM(total_ccr_check)' />
      </column>
      <column caption='[Deflection] - % of misclassified CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280497670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(misclassified_ccr)/SUM(total_ccr_check)' />
      </column>
      <column caption='[Deflection] - % of no CCRs' datatype='real' default-format='p0.00%' name='[Calculation_258957029280591879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(no_ccr_data_from_leaf)/SUM(total_ccr_check)' />
      </column>
      <column caption='Average chain length' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_258957029280669704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([number_of_leaves_in_chain_sum]))/SUM(ZN([number_of_leaves_in_chain_count]))' />
      </column>
      <column caption='[AC CSAT] - AC CSAT' datatype='real' default-format='p0.00%' name='[Calculation_258957029280784393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([ac_csat_good_count]))/SUM(ZN([ac_csat_total_count]))' />
      </column>
      <column caption='[AC CSAT] - AC CSAT Outcome' datatype='real' default-format='p0.00%' name='[Calculation_258957029281193997]' role='measure' type='quantitative'>
