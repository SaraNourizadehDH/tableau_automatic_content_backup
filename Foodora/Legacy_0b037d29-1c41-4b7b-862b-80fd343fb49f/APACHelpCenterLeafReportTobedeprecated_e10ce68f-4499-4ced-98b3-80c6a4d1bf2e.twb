) - LOOKUP(ZN([Calculation_748441978220552194]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Deflection] - Deflection feedback rating&quot; THEN (ZN([Calculation_748441978219737088])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978219737088]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Holistic] - Feedback Rating %&quot; THEN (ZN([Calculation_1224697638974537728])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_1224697638974537728]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Navigation] - Navigation Feedback Rating&quot; THEN (ZN([Calculation_748441978220879875])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978220879875]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;WHEN &quot;[Other] - Other feedback rating&quot; THEN (ZN([Calculation_748441978221350916])*ZN([Weight (copy)]) - LOOKUP(ZN([Calculation_748441978221350916]), 1)*LOOKUP(ZN([Weight (copy)]), 1)) * 100&#10;END'>
