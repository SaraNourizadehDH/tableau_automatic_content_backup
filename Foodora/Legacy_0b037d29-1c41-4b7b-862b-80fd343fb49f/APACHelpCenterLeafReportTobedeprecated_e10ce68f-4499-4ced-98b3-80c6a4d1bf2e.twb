            <column caption='Navigation Weight' datatype='real' hidden='true' name='[Deflection Feedback Weight (copy)_206673019813691414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_95208928967581704]) / TOTAL(SUM([Calculation_95208928967581704]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
