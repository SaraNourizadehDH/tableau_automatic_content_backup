      <table>
        <view>
          <datasources>
            <datasource caption='Tableau_HC_Leaf_deflection (pandata_my)' name='federated.1sqj91210kq7ba1acy3ej1g5ljjf' />
            <datasource caption='Tableau_HC_Leaf (pandata_my)' name='federated.0f3rl571yjydy41dylfu20wbdq9s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='HC CSAT %' caption='KPI Contribution Country' datatype='string' name='[KPI Contribution Leaf (copy)_303922625575661572]' param-domain-type='list' role='measure' type='nominal' value='&quot;HC CSAT&quot;'>
              <calculation class='tableau' formula='&quot;HC CSAT&quot;' />
              <aliases>
                <alias key='&quot;HC CSAT&quot;' value='HC CSAT %' />
              </aliases>
            </column>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f3rl571yjydy41dylfu20wbdq9s'>
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sqj91210kq7ba1acy3ej1g5ljjf'>
            <column caption='Month ' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week ' datatype='string' name='[Calculation_1824802341321805835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_1824802341321883660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1824802341321637898]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_1824802341321637898]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_1824802341321949197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_1824802341321883660]&#13;&#10; when &apos;week&apos; then [Calculation_1824802341321805835]&#13;&#10; when &apos;month&apos; then [Calculation_1824802341321637898]&#13;&#10;end' />
            </column>
            <column caption='HC CSAT %' datatype='real' default-format='p0.00%' name='[Calculation_213217312186359808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hc_csat_4_5]) / SUM([hc_csat_responses])' />
            </column>
            <column caption='NPS Finding Resolution' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_440789830280749056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_promotor_finding_resolution])) - SUM(ZN([nps_detractor_finding_resolution]))) / SUM(ZN([nps_responses_finding_resolution])))* 100' />
            </column>
            <column caption='KPI Weight' datatype='real' default-format='p0.00%' name='[KPI (copy)_303922625579614216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Contribution Leaf (copy)_303922625575661572]&#10;WHEN &quot;HC CSAT&quot; THEN ([Calculation_213217312186359808]*100) * [KPI Weight (copy)_206673019816304668]&#10;WHEN &quot;NPS Finding Resolution&quot; THEN [Calculation_440789830280749056] * [KPI Weight (copy)_206673019816304668]&#10;WHEN &quot;NPS Navigation&quot; THEN [NPS Finding Resolution (copy)_440789830281289729] * [KPI Weight (copy)_206673019816304668]&#10;WHEN &quot;NPS Reaching Agent&quot; THEN [NPS Navigation (copy)_440789830281506818] * [KPI Weight (copy)_206673019816304668]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI Response Weight' datatype='real' name='[KPI Weight (copy)_206673019816304668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Contribution Leaf (copy)_303922625575661572]&#10;WHEN &quot;HC CSAT&quot; THEN SUM(ZN([hc_csat_responses])) / TOTAL(SUM(ZN([hc_csat_responses])))&#10;WHEN &quot;NPS Finding Resolution&quot; THEN SUM(ZN([nps_responses_finding_resolution])) / TOTAL(SUM(ZN([nps_responses_finding_resolution])))&#10;WHEN &quot;NPS Navigation&quot; THEN SUM(ZN([nps_responses_navigation])) / TOTAL(SUM(ZN([nps_responses_navigation])))&#10;WHEN &quot;NPS Reaching Agent&quot; THEN SUM(ZN([nps_responses_reaching_agent])) / TOTAL(SUM(ZN([nps_responses_reaching_agent])))&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NPS Navigation' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[NPS Finding Resolution (copy)_440789830281289729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_promotor_navigation])) - SUM(ZN([nps_detractor_navigation]))) / SUM(ZN([nps_responses_navigation])))*100' />
            </column>
            <column caption='NPS Reaching Agent' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[NPS Navigation (copy)_440789830281506818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(ZN([nps_promotor_reaching_agent])) - SUM(ZN([nps_detractor_reaching_agent]))) / SUM(ZN([nps_responses_reaching_agent])))*100' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
