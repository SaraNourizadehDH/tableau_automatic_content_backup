          <calculation class='tableau' formula='IF [department] = &apos;Customer service&apos;&#10;OR [department] = &apos;Customer service QTK and RTM&apos;&#10;OR [department] = &apos;Partner care&apos;&#10;OR [department] = &apos;Partner service&apos;&#10;OR [department] = &apos;Partner service QTK and RTM&apos;&#10;THEN &apos;COS (CS + PS)&apos;&#10;ELSEIF  [department] = &apos;Rider service&apos; OR [department] = &apos;Rider service QTK and RTM&apos;&#10;THEN &apos;Logistics (RS)&apos;&#10;END' />
        </column>
        <column caption='Department Cleaned' datatype='string' name='[Calculation_2734036838551031813]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [department] = &apos;Customer service&apos; OR&#10;[department] = &apos;Customer service QTK and RTM&apos;&#10;THEN &apos;Customer Service&apos;&#10;ELSEIF [department] = &apos;Partner care&apos; THEN &apos;Partner Care&apos;&#10;ELSEIF [department] = &apos;Partner service&apos; OR&#10;[department] = &apos;Partner service QTK and RTM&apos; &#10;THEN &apos;Partner Service&apos;&#10;ELSEIF  [department] = &apos;Rider service&apos; OR &#10;[department] =&apos;Rider service QTK and RTM&apos;&#10;THEN &apos;Rider Service&apos;&#10;END' />
