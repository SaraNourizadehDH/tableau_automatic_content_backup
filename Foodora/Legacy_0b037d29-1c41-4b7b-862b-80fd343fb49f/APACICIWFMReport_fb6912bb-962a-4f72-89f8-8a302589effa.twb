              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;APAC&apos; THEN &apos;APAC&apos;&#10;WHEN &apos;Country&apos; THEN [country]&#10;END' />
            </column>
            <column caption='Cost Center' datatype='string' name='[Calculation_2602799130360508417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department] = &apos;Customer service&apos;&#10;OR [department] = &apos;Customer service QTK and RTM&apos;&#10;OR [department] = &apos;Partner care&apos;&#10;OR [department] = &apos;Partner service&apos;&#10;OR [department] = &apos;Partner service QTK and RTM&apos;&#10;THEN &apos;COS (CS + PS)&apos;&#10;ELSEIF  [department] = &apos;Rider service&apos; OR [department] = &apos;Rider service QTK and RTM&apos;&#10;THEN &apos;Logistics (RS)&apos;&#10;END' />
            </column>
            <column caption='Department Cleaned' datatype='string' name='[Calculation_2734036838551031813]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [department] = &apos;Customer service&apos; OR&#10;[department] = &apos;Customer service QTK and RTM&apos;&#10;THEN &apos;Customer Service&apos;&#10;ELSEIF [department] = &apos;Partner care&apos; THEN &apos;Partner Care&apos;&#10;ELSEIF [department] = &apos;Partner service&apos; OR&#10;[department] = &apos;Partner service QTK and RTM&apos; &#10;THEN &apos;Partner Service&apos;&#10;ELSEIF  [department] = &apos;Rider service&apos; OR &#10;[department] =&apos;Rider service QTK and RTM&apos;&#10;THEN &apos;Rider Service&apos;&#10;END' />
            </column>
            <column caption='Month.' datatype='string' name='[Calculation_5570460172521676800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([month]) &lt; 10 then str(YEAR([month])) + &quot;-0&quot; + str(month([month]))&#10;ELSE str(YEAR([month])) + &quot;-&quot; + str(month([month]))&#10;END' />
            </column>
            <column caption='Valid orders' datatype='integer' name='[Calculation_5570460172521820161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [month], [country] : MAX([total_valid_orders])}' />
            </column>
            <column caption='CPO' datatype='real' default-format='c&quot;€&quot;#,##0.000;-&quot;€&quot;#,##0.000' name='[Calculation_5570460172521934850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([total_cost_per_bpo_eur])) / SUM([Calculation_5570460172521820161])' />
            </column>
            <column caption='CPI' datatype='real' default-format='c&quot;€&quot;#,##0.000;-&quot;€&quot;#,##0.000' name='[Calculation_5570460172521988099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([total_cost_per_bpo_eur])) / SUM(ZN([total_bpo_tickets]))' />
            </column>
            <column caption='Total Cost' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_5570460172524421124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_cost_per_bpo_eur]' />
            </column>
