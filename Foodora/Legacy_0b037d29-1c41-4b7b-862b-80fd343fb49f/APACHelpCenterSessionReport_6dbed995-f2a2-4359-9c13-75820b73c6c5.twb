      <aliases enabled='yes' />
      <column caption='% Sessions' datatype='real' default-format='p0.00%' name='[% Contacted (copy)_1568448996879937557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ([session_type] != &quot;SEAMLESS&quot; AND [session_type] != &quot;NON-SEAMLESS&quot;) THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)   THEN [session_count] END)' />
      </column>
      <column caption='% Content Issues.' datatype='real' default-format='p0.00%' name='[% Contacted (copy)_3477130821337346141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Content Issues.&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)   THEN [session_count] END)' />
      </column>
