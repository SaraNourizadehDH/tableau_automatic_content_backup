      <aliases enabled='yes' />
      <column caption='Resolution Issue %' datatype='real' default-format='p0.00%' name='[Calculation_112449268224909312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([total_resolution_issues_sessions])) / SUM(ZN([total_non_seamless_sessions]))' />
      </column>
      <column caption='Resolution Issues Invalid Chat Session %' datatype='real' default-format='p0.00%' name='[Calculation_112449268225380354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([resolution_issues_invalid_chat_sessions])) / SUM(ZN([total_resolution_issues_sessions]))' />
      </column>
      <column caption='Resolution Issues Unsuccessful Automation Session %' datatype='real' default-format='p0.00%' name='[Calculation_112449268225634307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([resolution_issues_unsuccessful_automation_sessions])) / SUM(ZN([total_resolution_issues_sessions]))' />
      </column>
      <column caption='Invalid Chat Only %' datatype='real' default-format='p0.00%' name='[Calculation_112449268226039812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([resolution_issues_invalid_chat_only_sessions])) /&#10;&#10;SUM(ZN([resolution_issues_automation_chat_sessions]) + ZN([resolution_issues_invalid_chat_only_sessions]) +&#10;ZN([resolution_issues_unsuccessful_automation_only_sessions]))' />
      </column>
      <column aggregation='Attribute' caption='All Resolution Sessions' datatype='integer' name='[Calculation_112449268238835727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [automation_type], [automation_resolution]: SUM([total_resolution_issues_sessions])}' />
      </column>
      <column caption='Dimension.' datatype='string' name='[Calculation_114208486513131522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#10;WHEN &quot;Language&quot; THEN [language]&#10;WHEN &quot;Is Guest Session&quot; THEN [is_guest_session]&#10;WHEN &quot;Is Returning Session&quot; THEN [is_returning_session]&#10;WHEN &quot;Is Subscription&quot; THEN [is_subscription]&#10;END' />
      </column>
      <column caption='Resolution Issues KPI' datatype='string' name='[Calculation_114208486539055122]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Navigation Issues KPI (copy)_112449268233138189]&#10;WHEN &quot;Resolution Issue Sessions&quot; THEN &quot;Resolution Issue Sessions&quot;&#10;WHEN &quot;Resolution Issue (Unsuccessful Automation) Sessions&quot; THEN &quot;Resolution Issue (Unsuccessful Automation) Sessions&quot;&#10;WHEN &quot;Resolution Issue (Invalid Chat) Sessions&quot; THEN &quot;Resolution Issue (Invalid Chat) Sessions&quot;&#10;WHEN &quot;Resolution Issues %&quot; THEN &quot;Resolution Issues %&quot;&#10;WHEN &quot;Resolution Issues (Unsuccessful Automation) %&quot; THEN &quot;Resolution Issues (Unsuccessful Automation) %&quot;&#10;WHEN &quot;Resolution Issues (Invalid Chat) %&quot; THEN &quot;Resolution Issues (Invalid Chat) %&quot;&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_5776218421900161025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_5776218421902659586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_5776218421903421443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_5776218421900161025]+&quot;-0&quot;+str(day([report_date]))&#10;else [Calculation_5776218421900161025]+&quot;-&quot;+str(day([report_date]))&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_5776218421904187396]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#10; when &apos;day&apos; then [Calculation_5776218421903421443]&#10; when &apos;week&apos; then [Calculation_5776218421902659586]&#10; when &apos;month&apos; then [Calculation_5776218421900161025]&#10;end' />
      </column>
      <column caption='Both %' datatype='real' default-format='p0.00%' name='[Invalid Chat Only % (copy)_112449268226441221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([resolution_issues_automation_chat_sessions])) /&#10;&#10;SUM(ZN([resolution_issues_automation_chat_sessions]) + ZN([resolution_issues_invalid_chat_only_sessions]) +&#10;ZN([resolution_issues_unsuccessful_automation_only_sessions]))' />
