  is_guest_session,
  &quot;Content Issues&quot; AS session_category,
  IF(leaf_rating_count = 1, first_leaf_0_ratng, &quot;NULL&quot;) AS first_leaf,
  IF(leaf_rating_count &gt;&gt; 1, last_leaf_0_ratng, &quot;NULL&quot;) AS last_leaf,
  COUNT(DISTINCT gcc_session_id) AS content_issue_session_count,
  CAST(NULL AS INT64) AS content_issue_blank_page_session_count,
  CAST(NULL AS INT64) AS navigation_issue_session_count,
  CAST(NULL AS INT64) AS navigation_issue_4_leaves_session_count,
  CAST(NULL AS INT64) AS navigation_issue_8_nodes_session_count,
  CAST(NULL AS INT64) AS technical_error_session_count
