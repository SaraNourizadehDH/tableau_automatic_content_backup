      </column>
      <column caption='&gt;= 8 Nodes Only %' datatype='real' default-format='p0.00%' name='[Navigation Issue 4 Leaves Only Sessions % (copy)_114208486519304199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([navigation_issue_8_nodes_only_sessions])) / &#10;&#10;SUM(ZN([navigation_issue_4_leaves_only_sessions]) + ZN([navigation_issue_8_nodes_only_sessions]) +&#10;ZN([navigation_issue_4_leaves_8_nodes_sessions]))' />
