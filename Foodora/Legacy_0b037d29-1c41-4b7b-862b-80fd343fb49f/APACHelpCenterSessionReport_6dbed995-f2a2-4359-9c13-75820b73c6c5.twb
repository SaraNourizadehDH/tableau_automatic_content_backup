    <worksheet name='Non Seamless Mutually Exclusive Reason Ratio '>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cx_customer_helpcenter_seamless_session_kpis QUERY (pandata_report)' name='federated.18jastj1552li41cu1scx1adwou1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Distribution Type' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Mutually Exclusive&quot;'>
              <calculation class='tableau' formula='&quot;Mutually Exclusive&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18jastj1552li41cu1scx1adwou1'>
            <column caption='% Content Issues.' datatype='real' default-format='p0.00%' name='[% Contacted (copy)_3477130821337346141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Content Issues.&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)   THEN [session_count] END)' />
            </column>
            <column caption='% Technical Issues.' datatype='real' default-format='p0.00%' name='[% Delayed &lt; -10Min (copy)_3477130821337346135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Technical Issues.&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)  THEN [session_count] END)' />
            </column>
            <column caption='% Navigation Issues.' datatype='real' default-format='p0.00%' name='[% Delayed &gt; +10Min (copy)_3477130821337346136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Navigation Issues.&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)  THEN [session_count] END)' />
            </column>
            <column caption='% Resolution Issues.' datatype='real' default-format='p0.00%' name='[% High DT - LDD (copy)_3477130821337346138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Resolution Issues.&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)   THEN [session_count] END)' />
