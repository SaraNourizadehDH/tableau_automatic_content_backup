            <column caption='Seamless Ratio (Country)' datatype='real' default-format='p0.00%' name='[Seamless Ratio (APAC) (copy)_1157495530810679313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [country] != &apos;APAC&apos; AND [session_type] = &quot;SEAMLESS&quot; THEN [session_count] END) /&#10;SUM(IF [country] != &apos;APAC&apos; AND ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)  THEN [session_count] END)' />
