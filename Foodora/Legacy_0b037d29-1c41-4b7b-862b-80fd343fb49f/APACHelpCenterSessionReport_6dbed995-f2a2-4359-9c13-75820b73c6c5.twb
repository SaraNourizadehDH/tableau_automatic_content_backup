        <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Navigation Issues.&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)  THEN [session_count] END)' />
      </column>
      <column caption='% Technical Issues' datatype='real' default-format='p0.00%' name='[% Delayed &gt; 10Min (copy)_3477130821336379478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Technical Issues&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)  THEN [session_count] END)' />
      </column>
      <column caption='% Resolution Issues.' datatype='real' default-format='p0.00%' name='[% High DT - LDD (copy)_3477130821337346138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [session_type] = &quot;Resolution Issues.&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)   THEN [session_count] END)' />
      </column>
      <column caption='% Non Mutually Exclusive' datatype='real' default-format='p0.00%' name='[% Partially Fulfilled. (copy)_3477130821338411102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [session_type] = &quot;NON-MUTUALLY EXCLUSIVE&quot; THEN [session_count] END) /&#10;SUM(IF ([session_type] = &quot;SEAMLESS&quot; OR [session_type] = &quot;NON-SEAMLESS&quot;)  THEN [session_count] END)' />
      </column>
      <column caption='Sizing' datatype='integer' name='[Calculation_1157495530814480403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='- [session_count]' />
      </column>
      <column caption='Min' datatype='integer' name='[Calculation_1157495530834239510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1157495530835959831]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [class]&#10;    when &apos;Daily&apos; then [Calculation_5776218421903421443]&#10;    when &apos;Monthly&apos; then [Calculation_1157495530836316185]&#10;      when &apos;Weekly&apos; then [Calculation_1157495530836078616]&#10;END' />
      </column>
      <column caption='Week (string)' datatype='string' name='[Calculation_1157495530836078616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) = 1 and ISOYEAR([report_date]) = 2021 then &quot;2022-W01&quot;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1157495530836316185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END' />
      </column>
      <column caption='Seamless %' datatype='string' name='[Calculation_1568448996858724355]' role='dimension' type='nominal'>
