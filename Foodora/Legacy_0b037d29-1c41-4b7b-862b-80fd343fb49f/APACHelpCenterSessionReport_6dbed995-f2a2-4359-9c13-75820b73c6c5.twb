      <column caption='Day' datatype='string' name='[Calculation_5776218421903421443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_1157495530836316185]+&quot;-0&quot;+str(day([report_date]))&#10;else [Calculation_1157495530836316185]+&quot;-&quot;+str(day([report_date]))&#10;end' />
      </column>
