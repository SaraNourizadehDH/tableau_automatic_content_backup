          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Navigation Issues KPI' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Navigation Issue Sessions&quot;'>
              <calculation class='tableau' formula='&quot;Navigation Issue Sessions&quot;' />
              <aliases>
                <alias key='&quot;Navigation Issue (More than 4 Leaves) Sessions&quot;' value='Navigation Issue (&gt;= 3 Leaves) Sessions' />
                <alias key='&quot;Navigation Issue (More than 8 Nodes) Sessions&quot;' value='Navigation Issue (&gt;= 8 Nodes) Sessions' />
                <alias key='&quot;Navigation Issues (More than 4 Leaves) \%&quot;' value='Navigation Issues (&gt;= 3 Leaves) %' />
                <alias key='&quot;Navigation Issues (More than 8 Nodes) \%&quot;' value='Navigation Issues (&gt;= 8 Nodes) %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14mwunh0a40h911fdg71c1o1n58b'>
            <column caption='Navigation Issue &gt;= 8 Nodes Sessions %' datatype='real' default-format='p0.00%' name='[Calculation_114208486521274378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([navigation_issue_8_nodes_sessions])) / SUM(ZN([total_navigation_issues_sessions]))' />
            </column>
            <column caption='Navigation Issues KPI' datatype='string' name='[Calculation_114208486539055122]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Navigation Issue Sessions&quot; THEN &quot;Navigation Issue Sessions&quot;&#10;WHEN &quot;Navigation Issue (More than 4 Leaves) Sessions&quot; THEN &quot;Navigation Issue (More than 4 Leaves) Sessions&quot;&#10;WHEN &quot;Navigation Issue (More than 8 Nodes) Sessions&quot; THEN &quot;Navigation Issue (More than 8 Nodes) Sessions&quot;&#10;WHEN &quot;Navigation Issues %&quot; THEN &quot;Navigation Issues %&quot;&#10;WHEN &quot;Navigation Issues (More than 4 Leaves) %&quot; THEN &quot;Navigation Issues (More than 4 Leaves) %&quot;&#10;WHEN &quot;Navigation Issues (More than 8 Nodes) %&quot; THEN &quot;Navigation Issues (More than 8 Nodes) %&quot;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_5776218421900161025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_5776218421902659586]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_5776218421903421443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_5776218421900161025]+&quot;-0&quot;+str(day([report_date]))&#10;else [Calculation_5776218421900161025]+&quot;-&quot;+str(day([report_date]))&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_5776218421904187396]' role='dimension' type='nominal'>
