              <calculation class='tableau' formula='CASE [Parameters].[Navigation Issues KPI (copy)_127297073134960656]&#10;WHEN &quot;Content Issue Sessions&quot; THEN &quot;Content Issue Sessions&quot;&#10;WHEN &quot;Content Issue (First Leaf Negative Rating) Sessions&quot; THEN &quot;Content Issue (First Leaf Negative Rating) Sessions&quot;&#10;WHEN &quot;Content Issue (Last Leaf Negative Rating) Sessions&quot; THEN &quot;Content Issue (Last Leaf Negative Rating) Sessions&quot;&#10;WHEN &quot;Content Issue (Blank Page) Sessions&quot; THEN &quot;Content Issue (Blank Page) Sessions&quot;&#10;WHEN &quot;Content Issues %&quot; THEN &quot;Content Issues %&quot;&#10;WHEN &quot;Content Issues (First Leaf Negative Rating) %&quot; THEN &quot;Content Issues (First Leaf Negative Rating) %&quot;&#10;WHEN &quot;Content Issues (Last Leaf Negative Rating) %&quot; THEN &quot;Content Issues (Last Leaf Negative Rating) %&quot;&#10;WHEN &quot;Content Issues (Blank Page) %&quot; THEN &quot;Content Issues (Blank Page) %&quot;&#10;END' />
