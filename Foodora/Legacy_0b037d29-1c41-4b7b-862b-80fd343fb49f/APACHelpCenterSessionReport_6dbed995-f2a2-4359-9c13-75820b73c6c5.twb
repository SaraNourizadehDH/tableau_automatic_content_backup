              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Navigation Issue Sessions&quot; THEN &quot;Navigation Issue Sessions&quot;&#10;WHEN &quot;Navigation Issue (More than 4 Leaves) Sessions&quot; THEN &quot;Navigation Issue (More than 4 Leaves) Sessions&quot;&#10;WHEN &quot;Navigation Issue (More than 8 Nodes) Sessions&quot; THEN &quot;Navigation Issue (More than 8 Nodes) Sessions&quot;&#10;WHEN &quot;Navigation Issues %&quot; THEN &quot;Navigation Issues %&quot;&#10;WHEN &quot;Navigation Issues (More than 4 Leaves) %&quot; THEN &quot;Navigation Issues (More than 4 Leaves) %&quot;&#10;WHEN &quot;Navigation Issues (More than 8 Nodes) %&quot; THEN &quot;Navigation Issues (More than 8 Nodes) %&quot;&#10;END' />
