SELECT
  report_date,
  country,
  vertical_type,
  language,
  version,
  is_subscription,
  is_returning_session,
  is_guest_session,
  &quot;Auto&quot; AS session_category,
  IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue, unsuccessful_automation_type, NULL) AS automation_type,
  IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue, unsuccessful_automation_resolution, NULL) AS automation_resolution,
  CAST(NULL AS INT64) AS total_non_seamless_sessions,
  COUNT(DISTINCT IF(is_resolution_issues, gcc_session_id, NULL)) AS total_resolution_issues_sessions,
  COUNT(DISTINCT IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue, gcc_session_id, NULL)) AS resolution_issues_unsuccessful_automation_sessions,
  CAST(NULL AS INT64) AS resolution_issues_invalid_chat_sessions,
  CAST(NULL AS INT64) AS resolution_issues_unsuccessful_automation_only_sessions,
  CAST(NULL AS INT64) AS resolution_issues_invalid_chat_only_sessions,
  CAST(NULL AS INT64) AS resolution_issues_automation_chat_sessions
FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_customer_helpcenter_seamless_sessions_raw`
