      <column caption='Unsuccessful Automation Only %' datatype='real' default-format='p0.00%' name='[Invalid Chat Only % (copy)_112449268226572294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([resolution_issues_unsuccessful_automation_only_sessions])) /&#10;&#10;SUM(ZN([resolution_issues_automation_chat_sessions]) + ZN([resolution_issues_invalid_chat_only_sessions]) +&#10;ZN([resolution_issues_unsuccessful_automation_only_sessions]))' />
