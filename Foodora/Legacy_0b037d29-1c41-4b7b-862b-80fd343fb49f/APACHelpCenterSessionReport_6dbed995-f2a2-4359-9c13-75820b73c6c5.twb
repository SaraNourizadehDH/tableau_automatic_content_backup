      </column>
      <column caption='Greater Than 4 Leaves Navigation Issue Rate' datatype='real' default-format='p0.00%' name='[Greater Than 4 Leaves Navigation Issue (copy)_5931240765660733453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([greater_than_4_leaves_navigation_issue])/SUM([sessions_resolution_page_reached])' />
