    <datasource caption='regional_apac_cx_customer_helpcenter_seamless_sessions_raw QUERY [Resolution] (pandata_report)' inline='true' name='federated.194qq5f1c57kt31gzlmar1x1gbcz' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.03rakio1yomzkk1bjyfr80tyh9pq'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='waleed.iftikhar@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03rakio1yomzkk1bjyfr80tyh9pq' name='Custom SQL Query' type='text'>SELECT
  report_date,
  country,
  vertical_type,
  language,
  version,
  is_subscription,
  is_returning_session,
  is_guest_session,
  &quot;All&quot; AS session_category,
  &quot;NULL&quot; AS automation_type,
  &quot;NULL&quot; AS automation_resolution,
  COUNT(DISTINCT IF(is_non_seamless_sessions, gcc_session_id, NULL)) AS total_non_seamless_sessions,
  COUNT(DISTINCT IF(is_resolution_issues, gcc_session_id, NULL)) AS total_resolution_issues_sessions,
  COUNT(DISTINCT IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue, gcc_session_id, NULL)) AS resolution_issues_unsuccessful_automation_sessions,
  COUNT(DISTINCT IF(is_resolution_issues AND is_has_invalid_chats_resolution_issue, gcc_session_id, NULL)) AS resolution_issues_invalid_chat_sessions,
  COUNT(DISTINCT IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue AND NOT is_has_invalid_chats_resolution_issue, gcc_session_id, NULL)) AS resolution_issues_unsuccessful_automation_only_sessions,
  COUNT(DISTINCT IF(is_resolution_issues AND is_has_invalid_chats_resolution_issue AND NOT is_has_unsuccessful_automatations_resolution_issue, gcc_session_id, NULL)) AS resolution_issues_invalid_chat_only_sessions,
  COUNT(DISTINCT IF(is_resolution_issues AND is_has_invalid_chats_resolution_issue AND is_has_unsuccessful_automatations_resolution_issue, gcc_session_id, NULL)) AS resolution_issues_automation_chat_sessions
FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_customer_helpcenter_seamless_sessions_raw`
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8

UNION ALL

SELECT
  report_date,
  country,
  vertical_type,
  language,
  version,
  is_subscription,
  is_returning_session,
  is_guest_session,
  &quot;Auto&quot; AS session_category,
  IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue, unsuccessful_automation_type, NULL) AS automation_type,
  IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue, unsuccessful_automation_resolution, NULL) AS automation_resolution,
  CAST(NULL AS INT64) AS total_non_seamless_sessions,
  COUNT(DISTINCT IF(is_resolution_issues, gcc_session_id, NULL)) AS total_resolution_issues_sessions,
  COUNT(DISTINCT IF(is_resolution_issues AND is_has_unsuccessful_automatations_resolution_issue, gcc_session_id, NULL)) AS resolution_issues_unsuccessful_automation_sessions,
  CAST(NULL AS INT64) AS resolution_issues_invalid_chat_sessions,
