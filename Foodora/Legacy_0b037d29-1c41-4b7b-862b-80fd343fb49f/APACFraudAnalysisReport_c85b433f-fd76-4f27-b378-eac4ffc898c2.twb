      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_087B05E7509441ED98266CE41215CC50'>
            <properties context=''>
              <relation connection='bigquery.0zahvg51y3luwc154qvou009ffql' name='Custom SQL Query' type='text'>SELECT
  *
FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_fraud_order` 
WHERE ordered_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), ISOWEEK), INTERVAL 3 WEEK)
  AND (voucher_count &gt;&gt; 0
   OR wallet_refund_local &gt;&gt; 0
   OR post_delivery_cancellation_local &gt;&gt; 0
   OR cash_loss_local &gt;&gt; 0
   OR charge_back_value_local &gt;&gt; 0
   OR nci_fraud_order_code IS NOT NULL)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
