        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0zahvg51y3luwc154qvou009ffql' name='Custom SQL Query' type='text'>SELECT
  *
FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_fraud_order` 
WHERE ordered_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), ISOWEEK), INTERVAL 3 WEEK)
  AND (voucher_count &gt;&gt; 0
   OR wallet_refund_local &gt;&gt; 0
   OR post_delivery_cancellation_local &gt;&gt; 0
   OR cash_loss_local &gt;&gt; 0
   OR charge_back_value_local &gt;&gt; 0
   OR nci_fraud_order_code IS NOT NULL)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0zahvg51y3luwc154qvou009ffql' name='Custom SQL Query' type='text'>SELECT
