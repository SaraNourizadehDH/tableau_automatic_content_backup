          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPI' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Suspected Fraud Value Eur&quot;'>
              <calculation class='tableau' formula='&quot;Suspected Fraud Value Eur&quot;' />
            </column>
            <column caption='APAC / Country' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;APAC&quot;'>
