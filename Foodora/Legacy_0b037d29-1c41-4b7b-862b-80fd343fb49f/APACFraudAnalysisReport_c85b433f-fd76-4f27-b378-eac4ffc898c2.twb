      <column caption='CPO (Suspected Fraud Value Eur per Gross Order) (L)' datatype='real' default-format='c&quot;€&quot;#,##0.0000;-&quot;€&quot;#,##0.0000' name='[CPO (Suspected Fraud Value Eur per Gross Order) (copy)_85075818189594624]' role='measure' type='quantitative'>
