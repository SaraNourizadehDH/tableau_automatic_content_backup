      <column caption='APAC / Country' datatype='string' name='[Calculation_50735870481543177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;WHEN &quot;Country&quot; THEN [country]&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_50735870487289866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Fraud Type&quot; THEN [fraud_type]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#10;WHEN &quot;Expedition Type&quot; THEN [expedition_type]&#10;WHEN &quot;Payment Type&quot; THEN [payment_type]&#10;WHEN &quot;Platform&quot; THEN [platform]&#10;WHEN &quot;Is Day Zero Customer&quot; THEN [is_day_zero_customer]&#10;END' />
      </column>
