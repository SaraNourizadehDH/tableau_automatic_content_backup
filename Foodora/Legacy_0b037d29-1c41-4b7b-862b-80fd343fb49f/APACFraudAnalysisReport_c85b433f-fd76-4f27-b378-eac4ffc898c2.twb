      <column caption='CPO (Total Value Eur per Gross Order)' datatype='real' default-format='c&quot;€&quot;#,##0.000;-&quot;€&quot;#,##0.000' name='[Calculation_50735870468833285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([total_value_eur])) / SUM(ZN([Calculation_50735870471532550]))' />
      </column>
      <column aggregation='Attribute' caption='Gross Order Count.' datatype='real' name='[Calculation_50735870471532550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [fraud_type]:&#10;SUM({ FIXED [report_date], [country], [city], &#10;    [delivery_type], [vertical_type], [expedition_type],&#10;    [is_day_zero_customer], [payment_type], [platform]: AVG([gross_order_count])})}' />
      </column>
      <column caption='Overall / Type wise' datatype='string' name='[Calculation_50735870476034055]' role='dimension' type='nominal'>
