          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Impact (copy)' datatype='string' name='[KPI Impact (copy)_107101247509864451]' param-domain-type='list' role='measure' type='nominal' value='&quot;Blocked Orders&quot;'>
              <calculation class='tableau' formula='&quot;Blocked Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03cmyka1980l6y17jdl6s1dscc5g'>
            <column caption='KPI Impact (cop)' datatype='string' name='[Calculation_107101247510179845]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Impact (copy)_107101247509864451]&#10;WHEN &quot;Blocked GMV (Local)&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;Blocked True Positive GMV (Local)&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;Blocked False Positive GMV (Local)&quot; THEN &quot;TRUE&quot;&#10;ELSE &quot;FALSE&quot;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [class]&#13;&#10; WHEN &apos;Daily&apos; THEN [Calculation_456271002456092691]&#13;&#10; WHEN &apos;Weekly&apos; THEN [Calculation_456271002456002578]&#10; WHEN &apos;Monthly&apos; THEN [Calculation_456271002455613457]&#13;&#10;END' />
            </column>
            <column caption='KPI Impact (copy) (copy)' datatype='string' name='[KPI Impact (copy) (copy)_107101247554056198]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Impact (copy)_107101247509864451]&#10;WHEN &quot;Blocked Orders&quot; THEN STR(SUM([blocked_orders]))&#10;WHEN &quot;Blocked GMV (Eur)&quot; THEN &quot;€&quot; + STR(ROUND(SUM([blocked_gmv_eur]), 2))&#10;WHEN &quot;Blocked GMV (Local)&quot; THEN STR(SUM([blocked_gmv_local]))&#10;WHEN &quot;Blocked True Positive Orders&quot; THEN STR(SUM([blocked_true_positive_orders]))&#10;WHEN &quot;Blocked True Positive GMV (Eur)&quot; THEN &quot;€&quot; + STR(ROUND(SUM([blocked_true_positive_gmv_eur]), 2))&#10;WHEN &quot;Blocked True Positive GMV (Local)&quot; THEN STR(SUM([blocked_true_positive_gmv_local]))&#10;WHEN &quot;Blocked False Positive Orders&quot; THEN STR(SUM([blocked_false_positive_orders]))&#10;WHEN &quot;Blocked False Positive GMV (Eur)&quot; THEN &quot;€&quot; + STR(ROUND(SUM([blocked_false_positive_gmv_eur]), 2))&#10;WHEN &quot;Blocked False Positive GMV (Local)&quot; THEN STR(SUM([blocked_false_positive_gmv_local]))&#10;END' />
            </column>
            <column caption='KPI Impact (copy)' datatype='real' name='[KPI Impact (copy)_107101247510007812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Impact (copy)_107101247509864451]&#10;WHEN &quot;Blocked Orders&quot; THEN [blocked_orders]&#10;WHEN &quot;Blocked GMV (Eur)&quot; THEN [blocked_gmv_eur]&#10;WHEN &quot;Blocked GMV (Local)&quot; THEN [blocked_gmv_local]&#10;WHEN &quot;Blocked True Positive Orders&quot; THEN [blocked_true_positive_orders]&#10;WHEN &quot;Blocked True Positive GMV (Eur)&quot; THEN [blocked_true_positive_gmv_eur]&#10;WHEN &quot;Blocked True Positive GMV (Local)&quot; THEN [blocked_true_positive_gmv_local]&#10;WHEN &quot;Blocked False Positive Orders&quot; THEN [blocked_false_positive_orders]&#10;WHEN &quot;Blocked False Positive GMV (Eur)&quot; THEN [blocked_false_positive_gmv_eur]&#10;WHEN &quot;Blocked False Positive GMV (Local)&quot; THEN [blocked_false_positive_gmv_local]&#10;END' />
