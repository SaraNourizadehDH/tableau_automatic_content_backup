          <calculation class='tableau' formula='IF [linked_accounts] = 1 THEN &quot;1&quot;&#10;ELSEIF [linked_accounts] = 2 THEN &quot;2&quot;&#10;ELSEIF [linked_accounts] = 3 THEN &quot;3&quot;&#10;ELSEIF [linked_accounts] = 4 THEN &quot;4&quot;&#10;ELSEIF [linked_accounts] = 5 THEN &quot;5&quot;&#10;ELSEIF [linked_accounts] = 6 THEN &quot;6&quot;&#10;ELSEIF [linked_accounts] = 7 THEN &quot;7&quot;&#10;ELSEIF [linked_accounts] = 8 THEN &quot;8&quot;&#10;ELSEIF [linked_accounts] = 9 THEN &quot;9&quot;&#10;ELSEIF [linked_accounts] = 10 THEN &quot;10&quot;&#10;ELSEIF [linked_accounts] &gt; 10 THEN &quot;10+&quot;&#10;END' />
        </column>
        <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if ISOWEEK([Calculation_233483499366969344]) &lt; 10 then str(ISOYEAR([Calculation_233483499366969344])) + &quot;-W0&quot; + str(ISOWEEK([Calculation_233483499366969344]))&#13;&#10;ELSE str(ISOYEAR([Calculation_233483499366969344])) + &quot;-W&quot; + str(ISOWEEK([Calculation_233483499366969344]))&#13;&#10;END' />
        </column>
