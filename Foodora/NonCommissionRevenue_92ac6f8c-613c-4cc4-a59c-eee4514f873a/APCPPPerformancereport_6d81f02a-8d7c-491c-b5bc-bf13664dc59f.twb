      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0kb5dbb1dn91wt14kncao1u7yb8s'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Production' schema='pandata_ap_commercial' server-oauth='' username='hanley.ng@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0kb5dbb1dn91wt14kncao1u7yb8s' name='Custom SQL Query' type='text'><![CDATA[SELECT
global_entity_id,
vendor_name,
vendor_code,
booking_id,
user,
(case when lower(user) not like '%foodpanda%' then 'self-booking' else user end) as user_booked, -- add CASE WHEN for self-booking
year_month,
booking_week_year AS booking_date, -- but this is week?
booking_week AS booking_yearweek, -- yyyyww format
type,
status,
sold_price_local,
suggested_price_local,
-- exchange_rate_value, -- do we have to have this? can I just backward calc it?
sold_price_eur,
suggested_price_eur,
common_name,
promo_areas_sold,
month_booked,
month,
-- central, -- what is this, COUNT(Alias?)
(case when lower(user) not like '%foodpanda%' then 'Automated' else 'Non-Automated' end) AS automated, -- automated,
channel,
format_date('W%V-%Y', current_date) as current_week,
report_weeks,
gmv_class,
is_sam,
final_source
FROM `fulfillment-dwh-production.pandata_report.revenue_ncr_cpp` bk
WHERE format_datetime("%Y%m", parse_datetime("%Y%m",cast(bk.year_month as string))) >>= format_datetime("%Y%m",datetime(date_add(date_trunc(current_date,month),interval -2 month)))
and format_datetime("%Y%m", parse_datetime("%Y%m",cast(bk.year_month as string))) <<= format_datetime("%Y%m",datetime(date_add(date_trunc(current_date,month),interval 2 month)))]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0kb5dbb1dn91wt14kncao1u7yb8s' name='Custom SQL Query' type='text'><![CDATA[SELECT
