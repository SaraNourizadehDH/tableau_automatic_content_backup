      </column>
      <column caption='repurchase rate' datatype='real' default-format='p0.0%' name='[Calculation_3801741837375930368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1864490268340408321])/COUNTD([Calculation_1864490268340748290])' />
      </column>
      <column caption='repurchase share' datatype='real' default-format='p0.0%' name='[Calculation_3801741837376602113]' role='measure' type='quantitative'>
