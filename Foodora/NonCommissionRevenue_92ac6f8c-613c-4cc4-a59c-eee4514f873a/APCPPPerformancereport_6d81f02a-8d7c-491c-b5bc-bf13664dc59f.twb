      <column caption='nextvendorcodecountry' datatype='string' name='[Calculation_1864490268340408321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[common_name]+&quot;-&quot;+[next_vendor_code]' />
      </column>
      <column caption='countryvendor' datatype='string' name='[Calculation_1864490268340748290]' role='dimension' type='nominal'>
