      </column>
      <column caption='last 2m' datatype='string' name='[Calculation_3801741837377273858]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([month_booked] &gt; DATEADD(&apos;month&apos;,-3,DATETRUNC(&apos;month&apos;,TODAY()))) THEN &quot;Yes&quot; ELSE &quot; No&quot; END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Repurchase rate / share' datatype='table' name='[__tableau_internal_object_id__].[_2A7854A958AB4E359AD3F03327DE1B4F]' role='measure' type='quantitative' />
      <column caption='Country' datatype='string' name='[common_name]' role='dimension' type='nominal' />
      <column caption='last 2m (copy)' datatype='string' name='[last 2m (copy)_3801741837440716803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([month_booked] &gt; DATEADD(&apos;month&apos;,-4,DATETRUNC(&apos;month&apos;,TODAY()))) AND ([month_booked] &lt;= DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,TODAY()))) THEN &quot;Yes&quot; ELSE &quot; No&quot; END' />
      </column>
