WHERE format_datetime("%Y%m", parse_datetime("%Y%m",cast(a.year_month as string))) >>= format_datetime("%Y%m",datetime(date_add(date_trunc(current_date,month),interval -3 month)))
and format_datetime("%Y%m", parse_datetime("%Y%m",cast(a.year_month as string))) <<= format_datetime("%Y%m",datetime(date_add(date_trunc(current_date,month),interval 2 month)))

ORDER BY a.global_entity_id,a.vendor_code,a.year_month,a.final_source asc]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
