      <aliases enabled='yes' />
      <column caption='Sold price' datatype='real' name='[Calculation_1095219137449017349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = true then [sold_price_local] else [sold_price_eur] end' />
      </column>
      <column caption='countryvendor' datatype='string' name='[Calculation_1864490268342218756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[common_name]+&quot;-&quot;+[vendor_code]' />
      </column>
      <column caption='OP Rev (excl shops)' datatype='real' name='[Calculation_2480427921896730631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if rdbms_id != 19 then [sold_price_eur] end' />
      </column>
      <column caption='OP Vendors (excl shops)' datatype='string' name='[Calculation_2480427921896923144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if rdbms_id != 19 then [vendor_code] end' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='ncr_report_order_booking' datatype='table' name='[__tableau_internal_object_id__].[ncr_report_order_booking_2821353C96654041BCEF7C23C4C46602]' role='measure' type='quantitative' />
      <column caption='Automated' datatype='string' name='[automated]' role='dimension' type='nominal' />
      <column caption='Booking Date' datatype='string' name='[booking_date]' role='dimension' type='nominal' />
      <column caption='Booking Id' datatype='integer' name='[booking_id]' role='dimension' type='ordinal' />
      <column caption='Booking Yearweek' datatype='string' name='[booking_yearweek]' role='dimension' type='nominal' />
