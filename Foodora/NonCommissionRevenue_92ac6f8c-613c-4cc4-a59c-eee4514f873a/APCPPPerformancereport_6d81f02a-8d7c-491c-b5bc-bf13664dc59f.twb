      <aliases enabled='yes' />
      <column caption='Total CPP Rev' datatype='real' name='[Calculation_1095219137442213888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = true then [sold_price_local] else [sold_price_eur] end' />
      </column>
      <column caption='AVG sold price' datatype='real' name='[Calculation_1095219137445842947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = true then [sold_price_local] else [sold_price_eur] end' />
      </column>
      <column caption='Sold Price' datatype='real' name='[Calculation_1095219137446932484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = true then [sold_price_local] else [sold_price_eur] end' />
      </column>
      <column caption='countryvendor' datatype='string' name='[Calculation_1864490268337106944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[common_name]+&quot;-&quot;+[vendor_code]' />
      </column>
      <column caption='PP Vendors sold' datatype='integer' name='[Calculation_2480427921892466688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [type] = &apos;premium_placements&apos; then [Calculation_1864490268337106944] END)' />
      </column>
      <column caption='OP Rev (excl shops)' datatype='real' name='[Calculation_2480427921894940675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [rdbms_id] != 19 then [sold_price_eur] END' />
      </column>
      <column caption='OP # vendors' datatype='string' name='[Calculation_2480427921895227396]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if rdbms_id != 19 then [vendor_code] END' />
      </column>
      <column caption='OP suggested price (excl shops)' datatype='real' name='[Calculation_2480427921895985158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if rdbms_id != 19 then [suggested_price_eur] end' />
      </column>
      <column caption='Discounts' datatype='real' default-format='p0%' name='[Calculation_3359685358136598532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggested_price_eur]-[sold_price_eur])/sum([suggested_price_eur])' />
      </column>
      <column caption='PP Vendor penetration' datatype='real' name='[Calculation_4105453286597947392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2480427921892466688] / SUM([federated.0xmtjod0z299x41ab6lvg0qsu942].[vendors_live])' />
      </column>
      <column caption='# promo areas sold per vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_7020197056863576064]' role='measure' type='quantitative'>
