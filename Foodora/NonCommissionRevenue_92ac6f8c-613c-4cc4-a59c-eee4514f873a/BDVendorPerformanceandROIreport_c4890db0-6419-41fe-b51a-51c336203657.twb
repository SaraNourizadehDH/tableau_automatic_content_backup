    <worksheet name='CPP (Vendor)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>CPP</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='CPPVendor' path='/t/Foodora/workbooks/NCRAMQBRDashboard' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='ncr_ROI_CPP_uplift DBT' name='federated.0r7s9a50e39194120rgm40izxszy (copy)' />
            <datasource caption='ncr_roi_order_metrics DBT' name='federated.0c9lfa91fkcpmm135fl8x1ayrnz9' />
          </datasources>
          <datasource-dependencies datasource='federated.0c9lfa91fkcpmm135fl8x1ayrnz9'>
            <column datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[chain_code]' derivation='None' name='[none:chain_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_code]' derivation='None' name='[none:vendor_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[vendor_code]' role='dimension' type='nominal' />
            <column datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0r7s9a50e39194120rgm40izxszy (copy)'>
            <column caption='shop loads uplift' datatype='integer' name='[Calculation_1078471422390296577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([shop_list_loads_during]),0) - ifnull(sum([shop_list_loads_before]),0)' />
            </column>
            <column caption='ROI (adjusted)' datatype='real' name='[Calculation_1078471422392131586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([rev_from_CPP] / [NCR_sold_local]) &lt; 0 then 0 ELSE [rev_from_CPP] / [NCR_sold_local] END' />
            </column>
            <column caption='ROI ' datatype='real' name='[Calculation_138626477104492554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gfv_change] &lt; 0 then 0 ELSE [gfv_change]/[NCR_sold_local] end' />
            </column>
            <column caption='NCR_suggested_price_local' datatype='real' name='[Calculation_670191963596091392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([OL_suggested_local],0) + ifnull([PL_suggested_local],0)' />
            </column>
            <column caption='% Discount' datatype='real' default-format='p0.0%' name='[Calculation_670191963596320769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_670191963596091392])-sum([NCR_sold_local])) / sum([Calculation_670191963596091392])' />
            </column>
            <column caption='menu loads uplift' datatype='integer' name='[Calculation_670191963597115395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([menu_loads_during]),0) - ifnull(sum([menu_loads_before]),0)' />
            </column>
            <column caption='orders uplift' datatype='integer' name='[Calculation_670191963597553669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([successful_orders_during]),0) - ifnull(sum([successful_orders_before]),0)' />
            </column>
            <column caption='new customer uplift' datatype='integer' name='[Calculation_670191963597635590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([new_to_rest_customer_during]),0) - ifnull(sum([new_to_rest_customer_before]),0)' />
            </column>
            <column caption='GFV Uplift' datatype='real' name='[Calculation_670191963635560456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([gfv_local_during]),0) - ifnull(sum([gfv_local_before]),0)' />
            </column>
            <column datatype='real' name='[NCR_sold_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[OL_suggested_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[PL_suggested_local]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1078471422392131586]' derivation='Attribute' name='[attr:Calculation_1078471422392131586:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_138626477104492554]' derivation='Attribute' name='[attr:Calculation_138626477104492554:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[end_date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[gfv_change]' role='measure' type='quantitative' />
            <column datatype='real' name='[gfv_local_before]' role='measure' type='quantitative' />
            <column datatype='real' name='[gfv_local_during]' role='measure' type='quantitative' />
