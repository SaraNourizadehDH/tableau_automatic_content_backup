      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0r7s9a50e39194120rgm40izxszy (copy 3)].[sum:voucher_orders:qk]&quot;' value='voucher orders' />
        </aliases>
      </column>
      <column caption='Deal utilization %' datatype='real' default-format='p0.0%' name='[Calculation_1078471423302803464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([voucher_orders])/sum([normal_orders])' />
      </column>
      <column caption='CPC Conversion rate' datatype='real' default-format='p0.0%' name='[Calculation_1357483499294744576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc_orders]) / sum([final_spent_clicks])' />
      </column>
      <column caption='CPC Utilization %' datatype='real' default-format='p0.0%' name='[Calculation_1357483499305078785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([final_spent_clicks]) / sum([final_budgeted_clicks])' />
      </column>
      <column caption='Color' datatype='string' name='[Calculation_1357483500589363204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [no_days_with_clicks] &lt; [Calculation_1357483502664044551] and [utilization] &lt; 1 then &quot;Red&quot; END' />
      </column>
      <column caption='Days running' datatype='integer' name='[Calculation_1357483502664044551]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[end_date (ncr_roi_cpc)] - [start_date (ncr_roi_cpc)] + 1' />
      </column>
      <column caption='# outlets' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_138626477101236229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='CPC ROI' datatype='real' name='[Calculation_780037594879787009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([avg_gfv_local]) * sum([cpc_orders])) / sum([cpc_rev_local])' />
      </column>
      <column caption='Chain level: Days running' datatype='integer' name='[Calculation_780037595067777028]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ATTR([end_date]) - ATTR([start_date]) + 1' />
      </column>
      <column caption='Vendor level: Days running' datatype='integer' name='[Calculation_780037595095404549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='attr([end_date]) - attr([start_date]) + 1' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_AA33092C911448B9B429ABEBF1639923]' role='measure' type='quantitative' />
      <column caption='chain code (NCR ROI vf vouchers data)' datatype='string' name='[chain_code (NCR_ROI_vf_vouchers_data)]' role='dimension' type='nominal' />
      <column caption='Chain name' datatype='string' name='[chain_name (NCR_ROI_vf_vouchers_data)]' role='dimension' type='nominal' />
