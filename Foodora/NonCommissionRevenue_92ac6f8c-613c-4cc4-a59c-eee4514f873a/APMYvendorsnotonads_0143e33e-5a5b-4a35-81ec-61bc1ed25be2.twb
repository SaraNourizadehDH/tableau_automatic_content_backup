      <column caption='# of Account Owners' datatype='integer' name='[Calculation_1068760494060273665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([account_owner])' />
      </column>
      <column caption='# AMs below Avg. Ads Rev over gmv' datatype='integer' name='[Calculation_1068760494071611396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [ads_rev_over_gmv] &lt; {FIXED [country_name], [month_name] :AVG([ads_rev_over_gmv])} THEN [account_owner] END)' />
      </column>
      <column caption='% AMs below Ads Rev over GMV' datatype='real' name='[Calculation_1068760494073806853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [ads_rev_over_gmv] &lt; {FIXED [country_name], [month_name] :AVG([ads_rev_over_gmv])} THEN [account_owner] END)/ COUNTD([account_owner])' />
      </column>
      <column caption='# AMs below Avg. Deal Value over GMV' datatype='integer' name='[Calculation_1068760494077353990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [deal_value_over_gmv] &lt; {FIXED [country_name], [month_name] :AVG([deal_value_over_gmv])} THEN [account_owner] END)' />
      </column>
      <column caption='% AMs below Deal Value over GMV' datatype='real' name='[Calculation_1068760494078722055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [deal_value_over_gmv] &lt; {FIXED [country_name], [month_name] :AVG([deal_value_over_gmv])} THEN [account_owner] END)/COUNTD([account_owner])' />
      </column>
      <column caption='Min Ads' datatype='real' name='[Calculation_846395268698034176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ads_rev_eur] = {FIXED [account_owner_title], [account_owner] : MIN([ads_rev_eur])}&#13;&#10;THEN [ads_rev_eur]&#13;&#10;END' />
      </column>
