      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[:Measure Names]' type='palette'>
            <map to='#5c6068'>
              <bucket>&quot;[federated.1360yab0ypt82i1czzpdw1iftysz].[sum:ads_rev_eur:qk]&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;[federated.1360yab0ypt82i1czzpdw1iftysz].[sum:min ads (copy)_846395268698710017:qk]&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;[federated.1360yab0ypt82i1czzpdw1iftysz].[sum:Calculation_846395268698034176:qk]&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;[federated.1360yab0ypt82i1czzpdw1iftysz].[avg:ads_rev_over_gmv:qk]&quot;</bucket>
