      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/MYVendorPerformanceandROIreport/VendorDetails?rev=' id='VendorDetails' path='/t/Foodora/workbooks/HKVendorPerformanceandROIreport' revision='' site='Foodora' />
      <style />
      <size maxheight='4500' maxwidth='1300' minheight='4500' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource caption='ncr_roi_order_metrics DBT' name='federated.0c9lfa91fkcpmm135fl8x1ayrnz9' />
