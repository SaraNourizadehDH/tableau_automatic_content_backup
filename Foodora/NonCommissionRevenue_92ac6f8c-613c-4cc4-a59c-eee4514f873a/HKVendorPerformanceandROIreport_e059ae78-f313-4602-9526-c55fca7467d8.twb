      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0r7s9a50e39194120rgm40izxszy (copy 4)'>
        <column datatype='date' name='[deal_end_date]' role='dimension' type='ordinal' />
        <column datatype='date' name='[deal_start_date]' role='dimension' type='ordinal' />
        <column-instance column='[deal_end_date]' derivation='None' name='[none:deal_end_date:qk]' pivot='key' type='quantitative' />
        <column-instance column='[deal_start_date]' derivation='None' name='[none:deal_start_date:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
