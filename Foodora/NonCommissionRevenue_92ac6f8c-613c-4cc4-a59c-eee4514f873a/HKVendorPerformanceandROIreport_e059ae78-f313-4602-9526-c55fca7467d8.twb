        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='12'>Pandabox Organic GFV (Local) - excludes Pandabox orders and re-orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ncr_roi_pandabox_bookings DBT' name='federated.0r7s9a50e39194120rgm40izxszy (copy 2)' />
            <datasource caption='ncr_roi_order_metrics DBT' name='federated.0c9lfa91fkcpmm135fl8x1ayrnz9' />
          </datasources>
          <datasource-dependencies datasource='federated.0c9lfa91fkcpmm135fl8x1ayrnz9'>
            <column datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[chain_code]' derivation='None' name='[none:chain_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_code]' derivation='None' name='[none:vendor_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[yearmonth]' derivation='None' name='[none:yearmonth:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[vendor_code]' role='dimension' type='nominal' />
            <column datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[yearmonth]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0r7s9a50e39194120rgm40izxszy (copy 2)'>
            <column caption='FINAL Organic GFV' datatype='real' name='[Calculation_2214222969779748864]' role='measure' type='quantitative'>
