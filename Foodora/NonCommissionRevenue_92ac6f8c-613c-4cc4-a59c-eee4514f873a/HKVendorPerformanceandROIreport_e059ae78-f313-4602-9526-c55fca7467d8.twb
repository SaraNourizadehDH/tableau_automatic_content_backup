    <worksheet name='Chain level: Frequency'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#f5f5f5' fontsize='12'>Frequency (Average # orders per customer)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ncr_roi_order_metrics DBT' name='federated.0c9lfa91fkcpmm135fl8x1ayrnz9' />
          </datasources>
          <datasource-dependencies datasource='federated.0c9lfa91fkcpmm135fl8x1ayrnz9'>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4061965451644915715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_order])/sum([unique_customer])' />
            </column>
            <column-instance column='[chain_name]' derivation='Attribute' name='[attr:chain_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[chain_code]' role='dimension' type='nominal' />
