      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Bangladesh&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
        </column>
        <column caption='Country/City Level' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cluster&quot;'>
          <calculation class='tableau' formula='&quot;Cluster&quot;' />
        </column>
        <column caption='NCR Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total NCR&quot;'>
          <calculation class='tableau' formula='&quot;Total NCR&quot;' />
        </column>
        <column caption='Account Type/Owner' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Account Owner&quot;'>
          <calculation class='tableau' formula='&quot;Account Owner&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='NCR Query' id='_0BE7C351E2634EE1BD3E3EABB841F662'>
            <properties context=''>
              <relation connection='bigquery.0l1mth10lkecsy13e9smi02osl37' name='Custom_SQL_Query' type='text'>WITH organic_placement AS(
SELECT 
yearmonth_live,
vendor_code,
city_name,
SUM(cpc_rev_local) organic_placement_local,
SUM(cpc_rev_eur) AS organic_placement_eur,

FROM `dhh---analytics-apac.pandata_ap_commercial.NCR_Tableau_CPC_updated` 
WHERE global_entity_id  = &apos;FP_BD&apos;
/*AND status != &apos;cancelled&apos; */
GROUP BY yearmonth_live,
vendor_code,
city_name 
),

premium_placements AS(
SELECT 
year_month,
vendor_code,
SUM(sold_price_local ) AS sold_price_local,
SUM(sold_price_eur ) AS sold_price_eur,

FROM `dhh---analytics-apac.pandata_ap_commercial.ncr_report_order_level` 
WHERe global_entity_id  = &apos;FP_BD&apos;
AND status IN (&apos;new&apos;,&apos;open&apos;)
GROUP BY year_month, vendor_code
),

pandabox_fee AS(
SELECT
vendor_code,
FORMAT_DATETIME(&quot;%Y%m&quot;, DATETIME( order_date )) AS year_month,
SUM( joker_fee_plus_vat_local/fx_rate_eur) AS joker_fee_amount_eur,
SUM(joker_fee_plus_vat_local) AS joker_fee_amount_local
FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
WHERE order_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH) AND DATE_ADD(CURRENT_DATE(), INTERVAL 3 MONTH) 
AND is_valid_order
GROUP BY
vendor_code,
FORMAT_DATETIME(&quot;%Y%m&quot;, DATETIME( order_date ))
),

month AS(
SELECT
DISTINCT
FORMAT_DATETIME(&quot;%Y%m&quot;, DATETIME(date)) AS month_year,
FORMAT_DATETIME(&quot;%b-%y&quot;, DATETIME(date)) AS month_name,
FROM `fulfillment-dwh-production.pandata_curated.shared_dates` 	
WHERE date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH) AND DATE_ADD(CURRENT_DATE(), INTERVAL 3 MONTH) 
),

month_ranking AS(
SELECT
DISTINCT
month.*,
ROW_NUMBER() OVER(ORDER BY month.month_year ASC) AS rank
FROM month
),

primary_zone AS (
  SELECT * 
  FROM(
    SELECT vendor_code, primary_zone_name, lg_primary_zone_id,
    RANK() OVER(PARTITION BY vendor_code order by  primary_zone_name) AS rank
    FROM  `fulfillment-dwh-production.pandata_report.country_BD_vendor_primary_zone` 
    WHERE capture_date = DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  ) 
  WHERE rank = 1
),

lg_city_zone AS(
SELECT
c.id AS city_id,
z.id AS zone_id,
z.name AS zone_name,
c.name AS city_name,
z.shape.geo
FROM `fulfillment-dwh-production.pandata_curated.lg_countries` , UNNEST(cities) AS c, UNNEST(zones) AS z
WHERE global_entity_id = &apos;FP_BD&apos;
AND c.is_active
AND z.is_active
),

vendor_with_month_city_info AS(
SELECT
v.vendor_code,
v.vendor_name,
v.chain_code,
v.chain_name,
v.city_name,
v.business_type_apac AS business_type,
v.Primary_Zone_name,
v.lg_city_name,
v.city_tag AS final_city_name,
month_ranking.month_year,
month_ranking.month_name,
month_ranking.rank
FROM `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS v
CROSS JOIN month_ranking
WHERE  month_ranking.rank BETWEEN 2 AND 6
)


SELECT
&apos;Bangladesh&apos; AS country,
vendor_with_month_city_info.*,
vendor_mapping.city_tag,
vendor_mapping.sf_account_owner_name,
vendor_mapping.account_type,
vendor_mapping.wxyz_class,
vendor_mapping.cluster_name,
organic_placement.organic_placement_eur,
organic_placement.organic_placement_local,
premium_placements.sold_price_eur,
premium_placements.sold_price_local,
pandabox_fee.joker_fee_amount_eur,
pandabox_fee.joker_fee_amount_local,
(IFNULL(organic_placement.organic_placement_eur,0)+IFNULL(premium_placements.sold_price_eur,0)+IFNULL(pandabox_fee.joker_fee_amount_eur,0)) AS total_ncr_eur,
(IFNULL(organic_placement.organic_placement_local,0)+IFNULL(premium_placements.sold_price_local,0)+IFNULL(pandabox_fee.joker_fee_amount_local,0)) AS total_ncr_local
FROM vendor_with_month_city_info
LEFT JOIN organic_placement ON vendor_with_month_city_info.vendor_code = organic_placement.vendor_code AND vendor_with_month_city_info.month_year = organic_placement.yearmonth_live
LEFT JOIN premium_placements ON vendor_with_month_city_info.vendor_code = premium_placements.vendor_code AND vendor_with_month_city_info.month_year = premium_placements.year_month
LEFT JOIN pandabox_fee ON vendor_with_month_city_info.vendor_code = pandabox_fee.vendor_code AND vendor_with_month_city_info.month_year = pandabox_fee.year_month
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use`  AS vendor_mapping
       ON vendor_mapping.Vendor_code = vendor_with_month_city_info.vendor_code
WHERE (IFNULL(organic_placement.organic_placement_eur,0)+IFNULL(premium_placements.sold_price_eur,0)+IFNULL(pandabox_fee.joker_fee_amount_eur,0)) &gt;&gt; 0</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
