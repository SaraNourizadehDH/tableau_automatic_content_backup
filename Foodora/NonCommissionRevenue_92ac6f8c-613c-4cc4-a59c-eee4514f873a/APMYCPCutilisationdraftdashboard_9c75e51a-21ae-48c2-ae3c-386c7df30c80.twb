      </column>
      <column caption='% promo area booked' datatype='real' name='[Calculation_1035264968213798912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([promo_areas_booked])/sum([promo_areas_available])' />
      </column>
      <column caption='utr%' datatype='real' name='[Calculation_1035264968228114434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='min(sum([spent_clicks])/sum([budgeted_clicks]),1)' />
      </column>
      <column caption='cpc_rev' datatype='real' name='[Calculation_6889944496014053376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='min(([click_price_local]*[spent_clicks]),[initial_budget_local])' />
      </column>
      <column caption='final cpc rev' datatype='real' name='[Calculation_6889944496017657857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='min (sum([Calculation_6889944496014053376]),sum([initial_budget_local]))' />
      </column>
      <column caption='initial_budget_eur' datatype='real' name='[Calculation_9194943080311042049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_9194943080312803332]/AVG([exchange_rate])' />
      </column>
      <column caption='sum budget local' datatype='real' name='[Calculation_9194943080312803332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([initial_budget_local])' />
      </column>
