        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0436m2e0pxvme91d2io3w0ucllon' name='Custom_SQL_Query' type='text'><![CDATA[with clicks as (
SELECT DISTINCT
bk.global_entity_id,
bk.uuid as booking_id,
bk.vendor_code,
--pps_item_uuid,
/*DATE_TRUNC('MONTH',cpc.created_at) AS click_month,*/
format_date ('%Y%m',date(cpc.click_date)) as click_month,
date(cpc.click_date) as click_date,
count (distinct cpc.pps_item_uuid) as active_areas_1,
IFNULL(SUM(orders),0) AS cpc_orders_1,
IFNULL(SUM(quantity),0) AS spent_clicks_1

FROM `fulfillment-dwh-production.pandata_curated.pps_bookings` bk, UNNEST(bk.cpc_billings) bil
JOIN `fulfillment-dwh-production.pandata_curated.pps_cpc_clicks` AS cpc 
ON bil.uuid = cpc.pps_item_uuid 
where bk.global_entity_id = 'FP_MY'
group by 1,2,3,4,5
),
    
exchangerate as(
select 
global_entity_id,
format_timestamp ('%Y%m',fx_rate_date) as yearmonth,
AVG (fx_rate_eur) as exchange_rate
from 
(SELECT c.global_entity_id,fx.* --except (global_entity_id)
FROM `fulfillment-dwh-production.pandata_curated.central_dwh_fx_rates` fx
left join `fulfillment-dwh-production.pandata_curated.shared_countries` c on fx.currency_code_iso = c.currency_code_iso
where fx.fx_rate_date >>= '2020-01-01')
group by 1,2
),

orders as (
SELECT
o.global_entity_id,
o.vendor_code,
format_date('%Y%m',created_date_local) as order_month,
COUNT(distinct o.uuid) as orders,
SUM(gfv_eur) as sum_gfv_eur,
SUM(gfv_local) as sum_gfv_local,
CASE WHEN SAFE_DIVIDE(SUM(gfv_eur),COUNT(distinct o.uuid)) IS NULL THEN 0 ELSE SAFE_DIVIDE(SUM(gfv_eur),COUNT(distinct o.uuid)) END  as afv_eur,
CASE WHEN SAFE_DIVIDE(SUM(gfv_local),COUNT(distinct o.uuid)) IS NULL THEN 0 ELSE SAFE_DIVIDE(SUM(gfv_local),COUNT(distinct o.uuid)) END as afv_local

FROM `fulfillment-dwh-production.pandata_report.pandora_pd_orders_agg_jkr_deals` o
left join `fulfillment-dwh-production.pandata_curated.pd_vendors` v on o.global_entity_id = v.global_entity_id and o.vendor_code = v.vendor_code 
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` bt ON bt.global_entity_id = o.global_entity_id AND o.vendor_code = bt.vendor_code
where created_date_local >>= DATE_SUB(DATE_TRUNC(current_date(),MONTH),INTERVAL 4 MONTH)
and is_test_order = FALSE
and is_corporate_order = FALSE
AND v.vertical_type = 'restaurants' 

GROUP BY 1,2,3),

open_hours as (SELECT
global_entity_id,
vendor_code,
format_date('%Y%m',report_date) as year_month,
days_in_month,
--SAFE_DIVIDE(SUM(actual_open_hours),days_in_month) as avg_open_hrs_per_day
case when SAFE_DIVIDE(SUM(actual_open_hours),days_in_month) is null or SAFE_DIVIDE(SUM(actual_open_hours),days_in_month) << 0 then 0 else SAFE_DIVIDE(SUM(actual_open_hours),days_in_month) end as avg_open_hrs_per_day

FROM (

SELECT 
*,
DATE_DIFF(last_day_of_month, first_day_of_month, DAY) + 1 as days_in_month,
total_scheduled_open_hours - total_closed_hours_special - total_closed_hours_unavailable as actual_open_hours,
--CASE WHEN IFNULL(total_scheduled_open_hours, 0) - (IFNULL(closed_hours, 0) + IFNULL(closed_hours_on_special_day, 0)) << 0 THEN 0 ELSE IFNULL(total_scheduled_open_hours, 0) - (IFNULL(closed_hours, 0) + IFNULL(closed_hours_on_special_day, 0)) END AS actual_open_hours

FROM(

SELECT 
global_entity_id,
vendor_code,
report_date,
safe_divide((case when sum(total_open_seconds) is null then 0 else sum(total_open_seconds)end), 3600) as total_scheduled_open_hours,
safe_divide((case when sum(total_special_day_closed_seconds) is null then 0 else sum(total_special_day_closed_seconds)end),3600) as total_closed_hours_special,
safe_divide((case when sum(total_unavailable_seconds) is null then 0 else sum(total_unavailable_seconds)end),3600) as total_closed_hours_unavailable,
--IFNULL(SAFE_DIVIDE(IFNULL(SUM(total_open_seconds),0), 3600), 0) AS total_scheduled_open_hours, /* if it's a special day closure (ie full day closure), we will record total_special_day_closed_minutes*/
--IFNULL(SAFE_DIVIDE(SUM(IF(total_special_day_closed_seconds IS NOT NULL, total_special_day_closed_seconds, total_unavailable_seconds)), 3600), 0) AS closed_hours, /*if it is a special delivery day, we will calculate the closed minutes by taking the difference between scheduled open minutes and special day delivery minutes*/
--IFNULL(SAFE_DIVIDE(SUM(IF(total_special_day_delivery_seconds IS NOT NULL AND (total_scheduled_open_seconds - total_special_day_delivery_seconds) >> 0, total_scheduled_open_seconds - total_special_day_delivery_seconds , NULL)), 3600),0) AS closed_hours_on_special_day,

DATE_TRUNC(report_date,MONTH) as first_day_of_month,

CASE WHEN CURRENT_DATE() <<= DATE_SUB(DATE_ADD(DATE_TRUNC(report_date,MONTH), INTERVAL 1 MONTH),INTERVAL 1 DAY)  THEN DATE_SUB(CURRENT_DATE(),INTERVAL 1 DAY) ELSE DATE_SUB(DATE_ADD(DATE_TRUNC(report_date,MONTH), INTERVAL 1 MONTH), INTERVAL 1 DAY) END AS last_day_of_month

FROM `fulfillment-dwh-production.pandata_report.vendor_offline`

WHERE report_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(),INTERVAL 2 MONTH),MONTH)

GROUP BY 1,2,3 
ORDER BY 2,3 ASC)
)

GROUP BY 1,2,3,4
ORDER BY 1,2,3 asc)

    
/*FINAL QUERY*/

    
select 
c.*,
exr.exchange_rate,
IFNULL(c.active_areas_1,0) as active_areas,
IFNULL(c.cpc_orders_1,0) as cpc_orders,
IFNULL(c.spent_clicks_1,0) as spent_clicks,
IFNULL(o.afv_eur,0) as afv_eur,
IFNULL(o.afv_local,0) as afv_local,
IFNULL(oh.avg_open_hrs_per_day,0) as avg_open_hrs_per_day,
--c.pps_item_uuid
from clicks c
left join exchangerate exr on exr.global_entity_id = c.global_entity_id and exr.yearmonth =c.click_month
left join orders o on c.global_entity_id = o.global_entity_id and c.click_month = o.order_month and c.vendor_code = o.vendor_code
left join open_hours oh on c.global_entity_id = oh.global_entity_id and oh.vendor_code = c.vendor_code and oh.year_month = c.click_month

where click_month >>= '202201' 
and c.global_entity_id = 'FP_MY'




ORDER BY global_entity_id,vendor_code,click_month]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0436m2e0pxvme91d2io3w0ucllon' name='Custom_SQL_Query' type='text'><![CDATA[with clicks as (
SELECT DISTINCT
bk.global_entity_id,
bk.uuid as booking_id,
bk.vendor_code,
--pps_item_uuid,
/*DATE_TRUNC('MONTH',cpc.created_at) AS click_month,*/
format_date ('%Y%m',date(cpc.click_date)) as click_month,
date(cpc.click_date) as click_date,
count (distinct cpc.pps_item_uuid) as active_areas_1,
