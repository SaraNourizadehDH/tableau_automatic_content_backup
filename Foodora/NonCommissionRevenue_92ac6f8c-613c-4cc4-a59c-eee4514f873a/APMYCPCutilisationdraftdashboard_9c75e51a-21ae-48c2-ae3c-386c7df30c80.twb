            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Production' schema='pandata' server-oauth='' username='junyi.ng@foodpanda.com' workgroup-auth-mode='prompt' />
