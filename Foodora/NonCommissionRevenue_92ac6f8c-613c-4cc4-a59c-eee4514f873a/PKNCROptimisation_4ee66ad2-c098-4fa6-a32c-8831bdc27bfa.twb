      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Pakistan&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_144BE0F8B39B446CBE9E3AB076806499'>
            <properties context=''>
              <relation connection='bigquery.03c7s8y1di51531enumu700j6hc3' name='Custom SQL Query' type='text'>WITH base_cpc AS (&#13;
SELECT &#13;
datelive, &#13;
yearmonth_live,&#13;
vendor_code,&#13;
vendor_name,&#13;
user,&#13;
avg_open_hrs_per_day,&#13;
cpc_rev_local,&#13;
final_budget_local&#13;
FROM `dhh---analytics-apac.pandata_ap_commercial.NCR_Tableau_CPC_updated` &#13;
WHERE global_entity_id = &quot;FP_PK&quot;&#13;
-- AND EXTRACT(YEAR FROM datelive) = EXTRACT(YEAR FROM CURRENT_DATE(&quot;Asia/Karachi&quot;))&#13;
-- AND EXTRACT(MONTH FROM datelive) = EXTRACT(MONTH FROM CURRENT_DATE(&quot;Asia/Karachi&quot;))&#13;
),&#13;
&#13;
acc_res AS (&#13;
SELECT &#13;
owner_name AS account_owner_name,&#13;
owner_email,&#13;
COUNT(DISTINCT(vendor_code)) AS active_res&#13;
FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` &#13;
WHERE NOT is_backend_test&#13;
AND is_backend_active&#13;
AND NOT is_private&#13;
AND NOT is_sf_test&#13;
AND vertical = &quot;restaurants&quot;&#13;
GROUP BY 1, 2),&#13;
&#13;
acc_cpc AS (&#13;
SELECT&#13;
yearmonth_live, &#13;
user,&#13;
COUNT(DISTINCT(CASE WHEN cpc_rev_local &gt;&gt; 0 THEN vendor_code END)) AS cpc_res,&#13;
SUM(cpc_rev_local) AS cpc_m &#13;
FROM base_cpc&#13;
GROUP BY 1, 2),&#13;
&#13;
base_cpp AS (&#13;
SELECT  &#13;
vendor_code,&#13;
vendor_name,&#13;
year_month,&#13;
sold_price_local,&#13;
user_booked&#13;
FROM `dhh---analytics-apac.pandata_ap_commercial.ncr_report_order_level` &#13;
WHERE global_entity_id = &quot;FP_PK&quot;&#13;
-- AND month = FORMAT_DATETIME(&quot;%b&quot;, CURRENT_DATE(&quot;Asia/Karachi&quot;))&#13;
-- AND LEFT(year_month, 4) = FORMAT_DATETIME(&quot;%Y&quot;, CURRENT_DATE(&quot;Asia/Karachi&quot;))&#13;
),&#13;
&#13;
acc_cpp AS (&#13;
SELECT &#13;
year_month,&#13;
user_booked,&#13;
COUNT(DISTINCT(CASE WHEN sold_price_local &gt;&gt; 0 THEN vendor_code END)) AS cpp_res,&#13;
SUM(sold_price_local) AS cpp_m&#13;
FROM base_cpp&#13;
GROUP BY 1, 2),&#13;
&#13;
acc_gfv AS (&#13;
SELECT &#13;
FORMAT_DATE(&quot;%Y%m&quot;, date_local) AS year_month,&#13;
owner_email,&#13;
SUM(gfv_local) AS total_gfv&#13;
FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_kpis` &#13;
WHERE date_local &gt;&gt;= &quot;2021-01-01&quot;&#13;
AND vertical = &quot;restaurants&quot;&#13;
GROUP BY 1, 2&#13;
)&#13;
&#13;
SELECT &#13;
IFNULL(yearmonth_live, acc_cpp.year_month) AS year_month,&#13;
IFNULL(user, user_booked) AS user,&#13;
cpc_res,&#13;
cpp_res,&#13;
active_res,&#13;
IFNULL(cpc_res, 0) + IFNULL(cpp_res, 0) AS cpp_cpc_res,&#13;
total_gfv,&#13;
cpc_m,&#13;
cpp_m,&#13;
IFNULL(cpc_m, 0) + IFNULL(cpp_m, 0) AS cpp_cpc_m&#13;
FROM acc_cpc&#13;
FULL OUTER JOIN acc_cpp&#13;
ON acc_cpc.yearmonth_live = acc_cpp.year_month&#13;
AND acc_cpc.user = acc_cpp.user_booked&#13;
LEFT JOIN acc_gfv&#13;
ON acc_cpc.yearmonth_live = acc_gfv.year_month&#13;
AND acc_cpc.user = acc_gfv.owner_email&#13;
LEFT JOIN acc_res&#13;
ON acc_cpc.user = acc_res.owner_email</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
