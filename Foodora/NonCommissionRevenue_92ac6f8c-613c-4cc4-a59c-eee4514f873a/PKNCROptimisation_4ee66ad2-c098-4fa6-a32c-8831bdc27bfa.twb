      <aliases enabled='yes' />
      <column caption='Restaurant Penetration (%age)' datatype='real' name='[Calculation_1184728224311865344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([cpp_cpc_res])/ZN([active_res])' />
      </column>
      <column caption='Revenue Weightage (%age)' datatype='real' name='[Calculation_1184728224314605569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([cpp_cpc_m])/ZN([total_gfv])' />
      </column>
