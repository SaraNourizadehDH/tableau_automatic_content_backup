              <zone fixed-size='33' forceUpdate='true' h='4823' id='5' is-fixed='true' type-v2='text' w='88267' x='533' y='941'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#e6e6e6' fontsize='15'>Deal Parity</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
