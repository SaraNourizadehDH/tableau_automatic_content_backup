      <aliases enabled='yes' />
      <column caption='incentive category' datatype='string' name='[Calculation_1253478446382940160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_joker_used] THEN &quot;joker&quot;&#10;ELSEIF [is_subscriber_order] THEN &quot;pro&quot;&#10;ELSEIF [is_discount_used] THEN &quot;platform discount&quot;&#10;ELSEIF [is_voucher_used] THEN &quot;platform voucher&quot;&#10;ELSE &quot;NA&quot;&#10;END' />
      </column>
      <column caption='fail_rate' datatype='real' name='[Calculation_2366289809852760064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-sum([valid_order])/sum([gross_order])' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_3572339714187415552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Orders&quot; THEN SUM([valid_order])&#10;WHEN &quot;GFV&quot; THEN SUM([gmv_eur])&#10;WHEN &quot;AFV&quot; THEN SUM([gmv_eur])/SUM([valid_order])&#10;END' />
      </column>
      <column caption='is_deal' datatype='integer' name='[Calculation_3572339714200064002]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [is_discount_used] or [is_voucher_used] then 1 else 0 end' />
      </column>
      <column caption='valid_order_pct' datatype='real' name='[Calculation_4614148935589634048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],MONTH([order_date]),[is_joker_used],[is_subscriber_order],[is_discount_used],[is_voucher_used]:SUM([valid_order])}&#10;/{FIXED [global_entity_id],MONTH([order_date]):SUM([valid_order])}' />
      </column>
      <column caption='Incentive Metric' datatype='real' name='[Calculation_4614148935595487234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;incentive %&quot; THEN [Calculation_5005258452301578240]&#10;WHEN &quot;incentive % pro_delivery&quot; THEN [incentive % (copy)_5900841418930765824]&#10;WHEN &quot;incentive $/order&quot; THEN [deal% (copy)_4614148935595085825]&#10;WHEN &quot;valid order&quot; THEN SUM([valid_order])&#10;END' />
      </column>
      <column caption='incentive %' datatype='real' name='[Calculation_5005258452301578240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_deal_value_eur])/sum([gmv_eur])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_E78F920BB7774BA7AFF91A00B5B7E447]' role='measure' type='quantitative' />
      <column caption='incentive $/order' datatype='real' name='[deal% (copy)_4614148935595085825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_deal_value_eur])/sum([valid_order])' />
      </column>
      <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column caption='incentive % incl pro delivery' datatype='real' name='[incentive % (copy)_5900841418930765824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_deal_value_eur_incl_pro_free_delivery])/sum([gmv_eur])' />
