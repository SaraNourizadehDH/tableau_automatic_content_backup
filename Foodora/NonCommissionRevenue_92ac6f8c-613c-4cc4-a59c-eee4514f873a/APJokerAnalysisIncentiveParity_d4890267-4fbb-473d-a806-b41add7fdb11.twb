            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server-oauth='server-custom' username='hanley.ng@foodpanda.co.th' workgroup-auth-mode='prompt' />
