      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E78F920BB7774BA7AFF91A00B5B7E447'>
            <properties context=''>
              <relation connection='bigquery.1jzp72v1xh7l7919dru2q1bpzdz2' name='Custom SQL Query' type='text'><![CDATA[WITH pandabox_booking AS (
WITH byday_actiontable AS (
SELECT 
    jpda.id as jpda_id,
    jpda.global_entity_id,
    jpda.vendor_code,
    jpda.day_of_week_before,
    jpda.day_of_week_after,
    jpda.sale_limit_before,
    jpda.sale_limit_after as units,
    jpda.user_name as user_booked,
    jpda.transaction_at_utc as booking_datetime_utc,
    DATE (jpda.transaction_at_utc) as booking_date,
    DATE (jpda.first_creation_at_utc) as first_time_booking_date_utc,
    CASE    WHEN sale_limit_before = 0 AND DATE(jpda.first_creation_at_utc) = DATE(jpda.transaction_at_utc) THEN "first_booking" 
            WHEN sale_limit_before = 0 AND DATE (jpda.first_creation_at_utc) <<>> DATE (jpda.transaction_at_utc) THEN "new_booking" 
            WHEN sale_limit_after = 0 THEN "cancelled_booking"
            WHEN (sale_limit_after <<>>0 AND sale_limit_before <<>>0) THEN "updated_booking"
            ELSE NULL 
    END AS action_type,
    ROW_NUMBER () OVER (PARTITION BY    jpda.global_entity_id,
                                        jpda.vendor_code,
                                        format_datetime ('%F',jpda.transaction_at_utc),
                                        jpda.sale_limit_after
                        ORDER BY        jpda.transaction_at_utc ASC) 
                        AS row_num
FROM `fulfillment-dwh-production.pandata_report.regional_apac_jkr_promotion_definition_daily_activity` AS jpda
WHERE jpda.global_entity_id IN ("FP_BD","FP_PK","FP_SG","FP_MY","FP_TH","FP_TW","FP_HK","FP_PH","FP_LA","FP_KH","FP_MM","FP_JP")
  AND created_date_utc >>= "2024-01-01"
),
---1 line per booking----
actions1 AS (
SELECT
    *,
    ROW_NUMBER () OVER (PARTITION BY global_entity_id,vendor_code ORDER BY booking_datetime_utc ASC) AS booking_seq
FROM byday_actiontable
WHERE row_num = 1
ORDER BY global_entity_id, vendor_code, booking_date
),
actions2 AS (
SELECT
    *,
    ROW_NUMBER () OVER (PARTITION BY global_entity_id,vendor_code ORDER BY booking_datetime_utc ASC)-1 AS booking_seq
FROM byday_actiontable
WHERE row_num = 1
ORDER BY global_entity_id, vendor_code, booking_date
),
actiontable AS (
SELECT  
    a1.*,
    CASE    WHEN a1.action_type = 'cancelled_booking' AND a1.units <<>> a2.sale_limit_before AND a1.user_booked = 'dh_tech_ncr_developers+joker@deliveryhero.com' THEN 'midas_cancelled_booking' 
            ELSE a1.action_type 
    END AS final_action_type,
    CASE    WHEN a2.global_entity_id IS NOT NULL THEN "cancelled" 
            WHEN a2.global_entity_id IS NULL AND a1.units = 0 THEN "cancelled" 
            WHEN a2.global_entity_id IS NULL AND a1.units <<>> 0 THEN "active" 
            ELSE "unknown" 
    END AS status,
FROM actions1 a1
LEFT JOIN actions2 a2 
    ON a1.global_entity_id = a2.global_entity_id 
    AND a1.vendor_code = a2.vendor_code 
    AND a1.booking_seq = a2.booking_seq
),
errortable1 as (
SELECT
    *,
    ROW_NUMBER () OVER (PARTITION BY global_entity_id,vendor_code ORDER BY booking_datetime_utc ASC) AS error_seq
FROM actiontable
WHERE final_action_type <<>> 'midas_cancelled_booking'
),
errortable2 as (
SELECT
    *,
    ROW_NUMBER () OVER (PARTITION BY global_entity_id,vendor_code ORDER BY booking_datetime_utc ASC)-1 AS error_seq
FROM actiontable
WHERE final_action_type <<>> 'midas_cancelled_booking'
),
clean_bookings as (
SELECT 
    et1.*,
    CASE    WHEN et1.action_type IN ('first_booking','updated_booking','new_booking') THEN DATETIME(et1.booking_datetime_utc)
            ELSE NULL 
    END AS start_datetime,
    CASE    WHEN et1.action_type IN ('first_booking','updated_booking','new_booking') AND et2.global_entity_id IS NOT NULL THEN DATETIME(et2.booking_datetime_utc)
            WHEN et1.action_type IN ('first_booking','updated_booking','new_booking') AND et2.global_entity_id IS NULL THEN CURRENT_DATETIME 
            ELSE NULL 
    END AS end_datetime,
    CASE    WHEN et1.status = 'cancelled' AND et1.final_action_type <<>> 'cancelled_booking' THEN et2.user_booked 
            ELSE NULL
    END AS user_cancelled,
    FORMAT_DATETIME('W%V-%Y',et1.booking_datetime_utc) as booking_week,
FROM errortable1 et1
LEFT JOIN errortable2 et2 
    ON et1.global_entity_id = et2.global_entity_id 
    AND et2.vendor_code = et1.vendor_code 
    AND et2.error_seq = et1.error_seq
WHERE et1.final_action_type in ('new_booking','first_booking','updated_booking')
),
pre_bookings as (
SELECT
*,
GENERATE_DATE_ARRAY(DATE(start_datetime),DATE(end_datetime), INTERVAL 1 DAY) AS datelive_nested,
FROM clean_bookings
)
SELECT 
    global_entity_id,
    vendor_code,
    units,
    final_action_type,
    status,
    user_booked,
    user_cancelled,
    DATE(datelive) AS datelive,
    CASE    WHEN start_datetime <<= DATETIME(datelive) THEN DATETIME(datelive) 
            ELSE start_datetime 
    END AS use_start_datetime,
    CASE    WHEN end_datetime <<= DATETIME_SUB(DATETIME_ADD(datelive,INTERVAL 1 MONTH),INTERVAL 1 SECOND) THEN end_datetime 
            ELSE DATETIME_SUB(DATETIME_ADD(datelive,INTERVAL 1 MONTH),INTERVAL 1 SECOND) 
    END AS use_end_datetime,
FROM pre_bookings,UNNEST(datelive_nested) as datelive
-- GROUP BY global_entity_id, vendor_code, datelive
)
-- SELECT *
-- FROM pandabox_booking 


SELECT 
    o.created_date_local AS order_date,
    CASE WHEN pb.vendor_code IS NULL THEN FALSE ELSE TRUE END AS is_on_pandabox,
    COALESCE(pb.units,0) AS units,
    EXTRACT(ISOWEEK FROM o.created_date_local) AS order_week,
    EXTRACT(hour FROM o.created_at_local) AS order_hour,
    o.global_entity_id,
    o.vendor_code,
    o.expedition_type,
    o.is_joker_used,
    o.is_discount_used,
    o.is_voucher_used,
    o.is_preorder,
    o.is_corporate_order,
    sb_subscriptions.is_subscriber_order,
    o.is_first_valid_order_platform,
    o.is_first_valid_order_with_this_vendor,
    COUNT (DISTINCT IF (o.is_valid_order, o.uuid, NULL)) AS valid_order,
    COUNT (DISTINCT IF (o.is_gross_order, o.uuid, NULL)) AS gross_order,
    SUM (IF (o.is_valid_order, o.gmv_eur, NULL)) as gmv_eur,
    COALESCE(SUM(IF(o.is_valid_order AND o.is_discount_used, o.discount.discount_amount_eur,NULL)),0) 
    + COALESCE(SUM(IF(o.is_valid_order AND o.is_voucher_used, o.voucher.value_eur,NULL)),0) AS total_deal_value_eur,
    COALESCE(SUM(IF(o.is_valid_order AND o.is_discount_used, o.discount.discount_amount_eur,NULL)),0) 
    + COALESCE(SUM(IF(o.is_valid_order AND o.is_voucher_used, o.voucher.value_eur,NULL)),0) + COALESCE(SUM(IF(o.is_valid_order AND sb_subscriptions.is_subscription_plan_platform_free_delivery_order, sb_savings.sb_delivery_fee_savings_eur,NULL)),0) AS total_deal_value_eur_incl_pro_free_delivery -- Add estimated delivery fee for platform wide free delivery
FROM `fulfillment-dwh-production.pandata_report.pandora_pd_orders_agg_jkr_deals` o
LEFT JOIN pandabox_booking pb 
    ON pb.global_entity_id = o.global_entity_id
    AND pb.vendor_code = o.vendor_code
    AND pb.datelive = o.created_date_local
LEFT JOIN fulfillment-dwh-production.pandata_report.regional_apac_mkt_pro_user_orders_savings AS sb_savings
       ON o.uuid = sb_savings.order_uid
LEFT JOIN fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions AS sb_subscriptions
       ON o.uuid = sb_subscriptions.order_uid
WHERE created_date_local BETWEEN "2024-09-01" AND CURRENT_DATE()-2
AND sb_subscriptions.created_date_utc BETWEEN "2024-09-01" AND CURRENT_DATE()-2
AND o.global_entity_id IN ('FP_BD','FP_PK','FP_SG','FP_MY','FP_TH','FP_TW','FP_HK','FP_PH','FP_LA','FP_KH','FP_MM','FP_JP')
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
