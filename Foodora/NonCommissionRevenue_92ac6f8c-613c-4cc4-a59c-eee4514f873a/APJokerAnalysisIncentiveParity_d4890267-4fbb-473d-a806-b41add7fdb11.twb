    <dashboard name='Deal Parity'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APJokerAnalysisSep-Nov21/DealParity?rev=' id='DealParity' path='/t/Foodora/workbooks/APJokerAnalysisSep-Nov21' revision='' site='Foodora' />
