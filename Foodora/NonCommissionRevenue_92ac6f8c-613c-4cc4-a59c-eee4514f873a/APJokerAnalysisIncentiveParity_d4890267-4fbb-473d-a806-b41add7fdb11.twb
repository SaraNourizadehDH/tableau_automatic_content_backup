              <calculation class='tableau' formula='IF [is_joker_used] THEN &quot;joker&quot;&#10;ELSEIF [is_subscriber_order] THEN &quot;pro&quot;&#10;ELSEIF [is_discount_used] THEN &quot;platform discount&quot;&#10;ELSEIF [is_voucher_used] THEN &quot;platform voucher&quot;&#10;ELSE &quot;NA&quot;&#10;END' />
            </column>
            <column caption='Incentive Metric' datatype='real' name='[Calculation_4614148935595487234]' role='measure' type='quantitative'>
