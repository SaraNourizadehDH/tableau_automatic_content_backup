            <datasource caption='ncr_roi_order_metrics DBT' name='federated.0c9lfa91fkcpmm135fl8x1ayrnz9' />
          </datasources>
          <datasource-dependencies datasource='federated.0c9lfa91fkcpmm135fl8x1ayrnz9'>
            <column datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
