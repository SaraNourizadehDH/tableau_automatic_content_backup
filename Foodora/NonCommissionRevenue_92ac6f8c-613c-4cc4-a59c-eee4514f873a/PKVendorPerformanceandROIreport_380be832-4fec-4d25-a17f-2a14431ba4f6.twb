          <datasource-dependencies datasource='federated.0r7s9a50e39194120rgm40izxszy'>
            <column caption='CPC Conversion rate' datatype='real' default-format='p0.0%' name='[Calculation_1357483499294744576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_orders]) / sum([final_spent_clicks])' />
            </column>
            <column caption='CPC Utilization %' datatype='real' default-format='p0.0%' name='[Calculation_1357483499305078785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([final_spent_clicks]) / sum([final_budgeted_clicks])' />
