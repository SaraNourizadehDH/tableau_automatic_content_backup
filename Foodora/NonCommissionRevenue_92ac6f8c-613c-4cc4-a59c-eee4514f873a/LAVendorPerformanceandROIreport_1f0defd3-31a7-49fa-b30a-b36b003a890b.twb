          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0r7s9a50e39194120rgm40izxszy (copy)'>
            <column caption='shop loads uplift' datatype='integer' name='[Calculation_1078471422390296577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([shop_list_loads_during]),0) - ifnull(sum([shop_list_loads_before]),0)' />
            </column>
            <column caption='ROI (adjusted)' datatype='real' name='[Calculation_1078471422392131586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([rev_from_CPP] / [NCR_sold_local]) &lt; 0 then 0 ELSE [rev_from_CPP] / [NCR_sold_local] END' />
            </column>
            <column caption='ROI ' datatype='real' name='[Calculation_138626477104492554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gfv_change] &lt; 0 then 0 ELSE [gfv_change]/[NCR_sold_local] end' />
            </column>
            <column caption='NCR_suggested_price_local' datatype='real' name='[Calculation_670191963596091392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([OL_suggested_local],0) + ifnull([PL_suggested_local],0)' />
            </column>
            <column caption='% Discount' datatype='real' default-format='p0.0%' name='[Calculation_670191963596320769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_670191963596091392])-sum([NCR_sold_local])) / sum([Calculation_670191963596091392])' />
            </column>
            <column caption='menu loads uplift' datatype='integer' name='[Calculation_670191963597115395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([menu_loads_during]),0) - ifnull(sum([menu_loads_before]),0)' />
            </column>
            <column caption='orders uplift' datatype='integer' name='[Calculation_670191963597553669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([successful_orders_during]),0) - ifnull(sum([successful_orders_before]),0)' />
            </column>
            <column caption='new customer uplift' datatype='integer' name='[Calculation_670191963597635590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([new_to_rest_customer_during]),0) - ifnull(sum([new_to_rest_customer_before]),0)' />
            </column>
            <column caption='GFV Uplift' datatype='real' name='[Calculation_670191963635560456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([gfv_local_during]),0) - ifnull(sum([gfv_local_before]),0)' />
            </column>
