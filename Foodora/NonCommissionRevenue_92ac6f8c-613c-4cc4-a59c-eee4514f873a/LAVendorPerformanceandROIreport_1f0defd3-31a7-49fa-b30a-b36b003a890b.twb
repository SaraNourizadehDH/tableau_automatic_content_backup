      <aliases enabled='yes' />
      <column caption='% PB customers' datatype='real' default-format='p0.0%' name='[Calculation_1078471423379091465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([joker_orders_customers]) / sum([normal_customers])' />
      </column>
      <column caption='% PB orders' datatype='real' default-format='p0.0%' name='[Calculation_1078471423379226634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([joker_orders]) / sum([normal_orders])' />
      </column>
      <column caption='CPC Conversion rate' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_1357483499294744576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc_orders]) / sum([final_spent_clicks])' />
      </column>
      <column caption='CPC Utilization %' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_1357483499305078785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([final_spent_clicks]) / sum([final_budgeted_clicks])' />
      </column>
      <column caption='Color' datatype='string' hidden='true' name='[Calculation_1357483500589363204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [no_days_with_clicks] &lt; [Calculation_1357483502664044551] and [utilization] &lt; 1 then &quot;Red&quot; END' />
      </column>
      <column caption='Days running' datatype='integer' hidden='true' name='[Calculation_1357483502664044551]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[end_date (ncr_roi_cpc)] - [start_date (ncr_roi_cpc)] + 1' />
      </column>
      <column caption='customer acquisition cost' datatype='real' name='[Calculation_138626479139815444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ifnull(sum([joker_cost_local]),0) + ifnull(sum([joker_voucher_local]),0)) / sum([joker_orders_customers])' />
      </column>
      <column caption='total joker cost' datatype='real' name='[Calculation_138626479140622357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull(sum([joker_cost_local]),0) + ifnull(sum([joker_voucher_local]),0)' />
      </column>
      <column caption='FINAL Organic GFV' datatype='real' name='[Calculation_2214222969779748864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([organic_gfv_local]),0) - ifnull(SUM([reorder_gfv_local]),0)' />
      </column>
      <column caption='CPC ROI' datatype='real' hidden='true' name='[Calculation_780037594879787009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([avg_gfv_local]) * sum([cpc_orders])) / sum([cpc_rev_local])' />
      </column>
      <column caption='Chain level: Days running' datatype='integer' hidden='true' name='[Calculation_780037595067777028]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ATTR([end_date]) - ATTR([start_date]) + 1' />
      </column>
      <column caption='Vendor level: Days running' datatype='integer' hidden='true' name='[Calculation_780037595095404549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='attr([end_date]) - attr([start_date]) + 1' />
      </column>
      <column caption='FINAL Organic orders' datatype='integer' name='[FINAL Organic GFV (copy)_2214222969826189313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([organic_successful_order]),0) - ifnull(SUM([reorders]),0)' />
      </column>
      <column caption='FINAL Organic customers' datatype='integer' name='[FINAL Organic orders (copy)_2214222969827414018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([organic_customers]),0) - ifnull(SUM([reorder_customers]),0)' />
      </column>
