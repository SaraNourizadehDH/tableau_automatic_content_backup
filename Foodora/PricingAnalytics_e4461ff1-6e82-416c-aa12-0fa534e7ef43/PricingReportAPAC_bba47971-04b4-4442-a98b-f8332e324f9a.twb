          <datasource-dependencies datasource='Parameters'>
            <column alias='Euro' caption='Currency' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Local Currency' />
                <alias key='true' value='Euro' />
              </aliases>
            </column>
            <column caption='Time Granularity' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hago5b1el73kk16g5gke14yiruo'>
            <column caption='Orders below MOV %' datatype='real' default-format='p0.0%' name='[% Prio Orders (copy)_4356317866760851457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_gfv_below_mov]) / sum([orders_total])' />
            </column>
            <column caption='GFV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPO (copy)_5041287214421598214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]&#10;then SUM([gfv_eur_n]) / SUM([gfv_eur_d])&#10;else SUM([gfv_eur_n]) / SUM([gfv_eur_d]/[fx_rate_eur])&#10;end' />
            </column>
            <column caption='Prio Orders %' datatype='real' default-format='p0.0%' name='[Calculation_4356317866760609792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_prio]) / sum([orders_total])' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214127419393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]&#10;then SUM([cpo_n]) / SUM([cpo_d])&#10;else SUM([cpo_n]) / SUM([cpo_d]/[fx_rate_eur])&#10;end' />
            </column>
            <column caption='Delivery Fee DPS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214421721095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]&#10;then SUM([delivery_fee_eur_n]) / SUM([delivery_fee_eur_d])&#10;else SUM([delivery_fee_eur_n]) / SUM([delivery_fee_eur_d]/[fx_rate_eur])&#10;end' />
            </column>
            <column caption='Priority Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214422024201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]&#10;then SUM([priority_fee_eur_n]) / SUM([priority_fee_eur_d])&#10;else SUM([priority_fee_eur_n]) / SUM([priority_fee_eur_d]/[fx_rate_eur])&#10;end' />
            </column>
            <column caption='MOV Customer Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214422138890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]&#10;then SUM([mov_customer_fee_eur_n]) / SUM([mov_customer_fee_eur_d])&#10;else SUM([mov_customer_fee_eur_n]) / SUM([mov_customer_fee_eur_d]/[fx_rate_eur])&#10;end' />
            </column>
            <column caption='Customer Fees' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214422257675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_5041287214421721095],0)+&#10;IFNULL([Delivery Fee (copy)_5041287214421929992],0)+&#10;IFNULL([Calculation_5041287214422024201],0)+&#10;IFNULL([Calculation_5041287214422138890],0)' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214422478860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([CPO (copy)_5041287214421598214],0)+IFNULL([Calculation_5041287214422257675],0)' />
            </column>
            <column caption='GPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214425780245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Delivery Fee (copy)_5041287214424883219],0)+&#10;IFNULL([Calculation_5041287214422257675],0)-&#10;IFNULL([Calculation_5041287214127419393],0)' />
            </column>
            <column caption='DF % AOV' datatype='real' default-format='p0.0%' name='[Calculation_5041287214426300439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5041287214421721095] / [Calculation_5041287214422478860]' />
            </column>
            <column caption='Customer Fees % CPO' datatype='real' default-format='p0.0%' name='[Calculation_5041287214426603545]' role='measure' type='quantitative'>
