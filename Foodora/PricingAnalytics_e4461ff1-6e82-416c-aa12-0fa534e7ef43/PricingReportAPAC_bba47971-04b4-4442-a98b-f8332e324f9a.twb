    <worksheet name='Scatter'>
      <table>
        <view>
          <datasources>
            <datasource caption='pricing_main_apac (log_report)' name='federated.0hago5b1el73kk16g5gke14yiruo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_4356317866769960964]' param-domain-type='list' role='measure' type='nominal' value='&quot;CPO&quot;'>
              <calculation class='tableau' formula='&quot;CPO&quot;' />
            </column>
            <column alias='Euro' caption='Currency' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Local Currency' />
                <alias key='true' value='Euro' />
              </aliases>
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;GPO&quot;'>
              <calculation class='tableau' formula='&quot;GPO&quot;' />
            </column>
            <column caption='Dimension 3' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
            <column alias='Actuals' caption='Graph Values' datatype='boolean' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Moving Average' />
                <alias key='true' value='Actuals' />
              </aliases>
            </column>
            <column caption='Timeframe Moving Avg' datatype='integer' name='[Parameter 8]' param-domain-type='range' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <desc>
                <formatted-text>
                  <run>e.g. if Time Granularity Week and 4 is selected, moving average is shown for last 4 weeks</run>
                </formatted-text>
              </desc>
              <range max='28' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hago5b1el73kk16g5gke14yiruo'>
            <column caption='Orders below MOV %' datatype='real' default-format='p0.0%' name='[% Prio Orders (copy)_4356317866760851457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_gfv_below_mov]) / sum([orders_total])' />
            </column>
            <column caption='GFV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPO (copy)_5041287214421598214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]&#10;then SUM([gfv_eur_n]) / SUM([gfv_eur_d])&#10;else SUM([gfv_eur_n]) / SUM([gfv_eur_d]/[fx_rate_eur])&#10;end' />
            </column>
            <column caption='Prio Orders %' datatype='real' default-format='p0.0%' name='[Calculation_4356317866760609792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_prio]) / sum([orders_total])' />
            </column>
            <column caption='Dimension 1 moving avg' datatype='real' name='[Calculation_4356317866763948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_6725352041932382209], -[Parameters].[Parameter 8], 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dimension 1' datatype='real' name='[Calculation_4356317866764328963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]&#10;then [Calculation_6725352041932382209]&#10;else [Calculation_4356317866763948034]&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5041287214127419393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]&#10;then SUM([cpo_n]) / SUM([cpo_d])&#10;else SUM([cpo_n]) / SUM([cpo_d]/[fx_rate_eur])&#10;end' />
            </column>
