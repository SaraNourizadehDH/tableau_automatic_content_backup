            <column caption='% Ctry Active Riders Change vs Yesterday' datatype='real' name='[% Active Riders Change vs last week (copy)_1064327295560830977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;(SUM([Today country daily active riders])-SUM([Yesterday country daily active riders]))&#10;/ &#10;SUM([Yesterday country daily active riders])&#10;*/&#10;(AVG([Calculation_3221903355427270658])-AVG([Today country daily active riders (copy)_1064327295560671232]))&#10;/ &#10;AVG([Today country daily active riders (copy)_1064327295560671232])' />
