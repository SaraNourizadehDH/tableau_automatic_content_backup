            </column>
            <column caption='% Same Day LW' datatype='real' name='[Calculation_3650097146416689154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Last week country daily active riders (copy)_3221903355430395911])' />
            </column>
            <column caption='Last week city daily active riders' datatype='integer' name='[Last week country daily active riders (copy)_3221903355430395911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [day_category] &#10;WHEN &apos;Same day last week&apos; THEN [city_daily_active_riders] END' />
