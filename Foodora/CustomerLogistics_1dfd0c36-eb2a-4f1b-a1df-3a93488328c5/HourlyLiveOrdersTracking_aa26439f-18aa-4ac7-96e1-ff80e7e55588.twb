    <worksheet name='Hourly Orders &amp; Fail Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datastream_orders' name='federated.0x2utov18re7qa1fw4r881fom6lz' />
            <datasource caption='Action Event' name='federated.0dfh7bg00u1yvx14t3mn11b08tls' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Bar Chart Breakdown' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dfh7bg00u1yvx14t3mn11b08tls'>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2utov18re7qa1fw4r881fom6lz'>
            <column caption='Bar Chart Breakdown ' datatype='string' name='[Calculation_3345400494058725378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Country&apos; THEN [global_entity_id]&#10;WHEN &apos;Business Type&apos; THEN [business_type_apac]&#10;END' />
            </column>
            <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[latest_order_timestamp_local])&#10;        OR &#10;        ([hour] = 23 AND DATEPART(&apos;hour&apos;,[latest_order_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_5354639245356118019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//ZN(SUM([Orders Cancelled]))&#10;///&#10;//ZN(SUM([gross_orders]))&#10;&#10;&#10;SUM([Calculation_5777696135442980864])&#10;/&#10;SUM([gross_orders])' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_5354639245358112772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_mins_sum])&#10;/&#10;SUM([delivery_time_mins_count])' />
            </column>
            <column caption='% Early &gt; 15mins' datatype='real' name='[Calculation_5354639245358194693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_early_15_mins_count])&#10;/&#10;SUM([order_delay_mins_count])' />
            </column>
            <column caption='% Late &gt; 5mins' datatype='real' name='[Calculation_5354639245358325766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_5_mins_count])&#10;/&#10;SUM([order_delay_mins_count])' />
            </column>
            <column caption='Total OD Orders' datatype='integer' name='[Calculation_5354639245364867083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([gross_orders], 0)' />
            </column>
            <column caption='Orders Delivered' datatype='integer' name='[Calculation_5354639245364977676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_delivered]&#10;WHEN TRUE THEN [gross_orders]&#10;END' />
            </column>
            <column caption='Orders Cancelled' datatype='integer' name='[Calculation_5777696135442980864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_cancelled]&#10;WHEN TRUE THEN [gross_orders]&#10;END' />
            </column>
            <column datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[business_type_apac]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[delivery_provider]' role='dimension' type='nominal' />
            <column datatype='integer' name='[delivery_time_mins_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_time_mins_sum]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_cancelled]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_delivered]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_today]' role='dimension' type='nominal' />
            <column datatype='datetime' datatype-customized='true' name='[latest_order_timestamp_local]' role='dimension' type='ordinal' />
            <column datatype='string' name='[lg_city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[lg_zone_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3345400494058725378]' derivation='None' name='[none:Calculation_3345400494058725378:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3345400494078595079]' derivation='None' name='[none:Calculation_3345400494078595079:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_type_apac]' derivation='None' name='[none:business_type_apac:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_provider]' derivation='None' name='[none:delivery_provider:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[hour]' derivation='None' name='[none:hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[is_today]' derivation='None' name='[none:is_today:nk]' pivot='key' type='nominal' />
            <column-instance column='[lg_city_name]' derivation='None' name='[none:lg_city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[lg_zone_name]' derivation='None' name='[none:lg_zone_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_placed_date_local]' derivation='None' name='[none:order_placed_date_local:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[order_delay_mins_count]' role='measure' type='quantitative' />
            <column datatype='date' default-format='L' name='[order_placed_date_local]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[orders_early_15_mins_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[orders_late_5_mins_count]' role='measure' type='quantitative' />
