      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_EB7A155F1F1D4472B56227072C1E0424'>
            <properties context=''>
              <relation connection='bigquery.0v92qvm1eq5ipn1csv0uy17xzwsx' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
  SELECT
    DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)) AS current_date_local,  --tableau extract refresh at 12am PK time
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 1 DAY) AS date_minus_1_local,
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 7 DAY) AS date_minus_7_local
),

order_stream AS (
  SELECT 
    content.global_entity_id,
    content.order_id,
    content.vendor.id AS vendor_code,
    content.delivery.location.city,
    content.preorder,
    content.corporate,
    content.test_order,
    content.place_timestamp,
    content.promised_customer_timestamp AS promised_delivery_timestamp,
    content.delivery.provider AS delivery_provider
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_stream` AS order_stream
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
          ON order_stream.global_entity_id = shared_countries.global_entity_id
  WHERE shared_countries.is_reporting_enabled
    AND created_date IN (
      (SELECT current_date_local FROM parameters), 
      DATE_SUB((SELECT current_date_local FROM parameters), INTERVAL 1 DAY),
      (SELECT current_date_local FROM parameters), 
      DATE_SUB((SELECT date_minus_1_local FROM parameters), INTERVAL 1 DAY),
      (SELECT date_minus_7_local FROM parameters),
      DATE_SUB((SELECT date_minus_7_local FROM parameters), INTERVAL 1 DAY)
      )
  GROUP BY ALL
),

order_status_stream AS (
  SELECT
    content.global_entity_id,
    content.order_id,
    MIN(CASE WHEN content.status = 'COURIER_NEAR_DROP_OFF' THEN content.timestamp END) AS near_dropoff_timestamp,
    MAX(CASE WHEN content.status = 'DELIVERED' THEN content.timestamp END) AS delivered_timestamp,
    MAX(CASE WHEN content.status = 'CANCELLED' THEN content.timestamp END) AS order_cancelled_timestamp,
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_status_stream` 
  WHERE created_date IN (
      (SELECT current_date_local FROM parameters), 
      DATE_SUB((SELECT current_date_local FROM parameters), INTERVAL 1 DAY),
      (SELECT date_minus_1_local FROM parameters), 
      DATE_SUB((SELECT current_date_local FROM parameters), INTERVAL 1 DAY),
      (SELECT date_minus_7_local FROM parameters),
      DATE_SUB((SELECT date_minus_7_local FROM parameters), INTERVAL 1 DAY)
  )
  GROUP BY
   1,2
),

regional_apac_pd_vendors_agg_lg_zones AS (
   SELECT 
    global_entity_id,
    vendor_code,
    lg_zones.lg_city_name,
    lg_zones.lg_zone_name
  FROM `fulfillment-dwh-production.pandata_datamart.preprocessing__vendor_lg_zones` 
  LEFT JOIN UNNEST(lg_zones) AS lg_zones
  WHERE lg_zones.is_closest_point
),

lg_countries AS (
  SELECT 
    global_entity_id,
    timezone
  FROM `fulfillment-dwh-production.pandata_curated.shared_countries`
  WHERE is_reporting_enabled
  ORDER BY 1, 2
),

order_combined AS (
  SELECT
    order_stream.global_entity_id,
    COALESCE(regional_apac_pd_vendors_agg_lg_zones.lg_city_name, order_stream.city) AS lg_city_name,
    regional_apac_pd_vendors_agg_lg_zones.lg_zone_name,
    order_stream.order_id,
    order_stream.vendor_code,
    IF(order_stream.vendor_code = 'pgo', 'pandago_c2c', regional_apac_pd_vendors_agg_business_types.business_type_apac) AS business_type_apac, ----- chech EU version 
    order_stream.preorder,
    order_stream.corporate,
    order_stream.test_order,
    order_stream.delivery_provider,
    DATE(order_stream.place_timestamp, lg_countries.timezone) AS order_placed_date_local,
    DATETIME(order_stream.place_timestamp, lg_countries.timezone) AS order_placed_at_local,
    DATETIME(order_status_stream.near_dropoff_timestamp, lg_countries.timezone) AS order_near_dropoff_at_local,
    DATETIME(order_stream.promised_delivery_timestamp, lg_countries.timezone) AS promised_delivery_at_local,
    DATETIME(order_status_stream.delivered_timestamp, lg_countries.timezone) AS delivered_at_local,
    DATETIME(order_status_stream.order_cancelled_timestamp, lg_countries.timezone) AS order_cancelled_at_local,
    TIMESTAMP_DIFF(order_status_stream.near_dropoff_timestamp, order_stream.place_timestamp, MINUTE) AS delivery_time_mins,
    TIMESTAMP_DIFF(order_status_stream.near_dropoff_timestamp, order_stream.promised_delivery_timestamp, MINUTE) AS order_delay_mins,
    MAX(DATETIME(order_stream.place_timestamp, lg_countries.timezone)) OVER (
      PARTITION BY
        order_stream.global_entity_id
    ) AS latest_order_timestamp_local,
    MAX(DATE_TRUNC(DATETIME(CURRENT_TIMESTAMP, lg_countries.timezone), SECOND)) OVER (
      PARTITION BY
        order_stream.global_entity_id
    ) AS current_timestamp_local
  FROM order_stream
  LEFT JOIN order_status_stream
         ON order_stream.global_entity_id = order_status_stream.global_entity_id
        AND order_stream.order_id = order_status_stream.order_id
  LEFT JOIN regional_apac_pd_vendors_agg_lg_zones
         ON order_stream.global_entity_id = regional_apac_pd_vendors_agg_lg_zones.global_entity_id
        AND order_stream.vendor_code = regional_apac_pd_vendors_agg_lg_zones.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS regional_apac_pd_vendors_agg_business_types
         ON order_stream.global_entity_id = regional_apac_pd_vendors_agg_business_types.global_entity_id
        AND order_stream.vendor_code = regional_apac_pd_vendors_agg_business_types.vendor_code
  LEFT JOIN lg_countries
         ON order_stream.global_entity_id = lg_countries.global_entity_id
  WHERE DATE(order_stream.place_timestamp, lg_countries.timezone) IN ((SELECT current_date_local FROM parameters), (SELECT date_minus_1_local FROM parameters), (SELECT date_minus_7_local FROM parameters))
),

agg AS (
  SELECT
    global_entity_id,
    lg_city_name,
    lg_zone_name,
    business_type_apac,
    order_placed_date_local,
    delivery_provider,
    EXTRACT(HOUR FROM order_placed_at_local) AS hour,
    CASE 
      WHEN order_placed_date_local = (SELECT current_date_local FROM parameters) THEN 'Today'
      WHEN order_placed_date_local = (SELECT date_minus_1_local FROM parameters) THEN 'Yesterday'
      WHEN order_placed_date_local = (SELECT date_minus_7_local FROM parameters) THEN 'Same day last week'
    END AS period,
    IF(order_placed_date_local = (SELECT current_date_local FROM parameters), TRUE, FALSE) is_today,
    IF(order_cancelled_at_local IS NOT NULL, TRUE, FALSE) AS is_cancelled,
    IF(delivered_at_local IS NOT NULL, TRUE, FALSE) AS is_delivered,
    latest_order_timestamp_local,
    current_timestamp_local,
    COUNT(order_id) AS gross_orders,
    COUNT(CASE WHEN DATE_SUB(order_placed_date_local, INTERVAL 1 DAY) = (SELECT date_minus_1_local FROM parameters) THEN order_id END) AS yesterday_gross_orders,
    SUM(order_delay_mins) AS order_delay_mins_sum,
    COUNT(order_delay_mins) AS order_delay_mins_count,
    COUNTIF(order_delay_mins BETWEEN -15 AND 5) AS orders_on_time_count,
    COUNTIF(order_delay_mins << -15) AS orders_early_15_mins_count,
    COUNTIF(order_delay_mins << -10) AS orders_early_10_mins_count,
    COUNTIF(order_delay_mins >> 10) AS orders_late_10_mins_count,
    COUNTIF(order_delay_mins >> 5) AS orders_late_5_mins_count,
    SUM(CASE
      WHEN NOT preorder 
       AND NOT test_order 
      THEN delivery_time_mins END
    ) AS delivery_time_mins_sum,
    COUNT(CASE
      WHEN NOT preorder 
       AND NOT test_order 
      THEN delivery_time_mins END
    ) AS delivery_time_mins_count
  FROM order_combined
  GROUP BY ALL
),

yesterday_orders AS (
  SELECT
    global_entity_id,
    DATE_ADD(order_placed_date_local, INTERVAL 1 DAY) AS date_local,
    delivery_provider,
    SUM(gross_orders) AS yesterday_country_full_day_orders
  FROM agg
  WHERE period = 'Yesterday'
  GROUP BY ALL
),

--Create rows for smaller zones/business types without orders during specific hours of the day (for windows function to calculate fields to get 3hr moving average in dashboard)
all_permutation AS (
  SELECT DISTINCT
    global_entity_id,
    lg_city_name,
    lg_zone_name,
    business_type_apac,
    delivery_provider,
    order_placed_date_local,
    period,
    is_today,
    is_cancelled,
    is_delivered,
    latest_order_timestamp_local,
    current_timestamp_local
  FROM agg
),

all_hours AS (
  SELECT DISTINCT
    hour
  FROM agg
),

all_dates AS (
  SELECT DISTINCT
    global_entity_id,
    order_placed_date_local
  FROM agg
),
  
dates_x_hours AS (
  SELECT
    all_dates.*,
    all_hours.*
  FROM
    all_dates,
    all_hours
),

base AS (
  SELECT
    all_permutation.*,
    dates_x_hours.hour
  FROM all_permutation
  LEFT JOIN dates_x_hours 
         ON all_permutation.global_entity_id = dates_x_hours.global_entity_id
        AND all_permutation.order_placed_date_local = dates_x_hours.order_placed_date_local
)

SELECT 
  shared_countries.company_name AS brand_name,
  shared_countries.name AS country_name,
  base.*,
  yesterday_orders.yesterday_country_full_day_orders,
  agg.gross_orders,
  agg.order_delay_mins_sum,
  agg.order_delay_mins_count,
  agg.orders_on_time_count,
  agg.orders_early_15_mins_count,
  agg.orders_early_10_mins_count,
  agg.orders_late_10_mins_count,
  agg.orders_late_5_mins_count,
  agg.delivery_time_mins_sum,
  agg.delivery_time_mins_count,
  SUM(IFNULL(agg.gross_orders, 0)) OVER (
    PARTITION BY base.global_entity_id, base.lg_city_name, base.lg_zone_name, base.business_type_apac, base.order_placed_date_local, base.period, base.is_cancelled, base.is_delivered 
    ORDER BY base.hour ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
  ) AS gross_orders_3h_moving_average_sum,
  SUM(IFNULL(agg.delivery_time_mins_sum, 0)) OVER (
    PARTITION BY base.global_entity_id, base.lg_city_name, base.lg_zone_name, base.business_type_apac, base.order_placed_date_local, base.period, base.is_cancelled, base.is_delivered 
    ORDER BY base.hour ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
  ) AS delivery_time_3h_moving_average_sum,
  SUM(IFNULL(agg.delivery_time_mins_count, 0)) OVER (
    PARTITION BY base.global_entity_id, base.lg_city_name, base.lg_zone_name, base.business_type_apac, base.order_placed_date_local, base.period, base.is_cancelled, base.is_delivered 
    ORDER BY base.hour ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
  ) AS delivery_time_3h_moving_average_count,
  SUM(IFNULL(agg.order_delay_mins_sum, 0)) OVER (
    PARTITION BY base.global_entity_id, base.lg_city_name, base.lg_zone_name, base.business_type_apac, base.order_placed_date_local, base.period, base.is_cancelled, base.is_delivered
    ORDER BY base.hour ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
  ) AS order_delay_mins_3h_moving_average_sum,
  SUM(IFNULL(agg.delivery_time_mins_count, 0)) OVER (
    PARTITION BY base.global_entity_id, base.lg_city_name, base.lg_zone_name, base.business_type_apac, base.order_placed_date_local, base.period, base.is_cancelled, base.is_delivered 
    ORDER BY base.hour ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
  ) AS order_delay_mins_3h_moving_average_count
FROM base
LEFT JOIN agg
       ON base.global_entity_id = agg.global_entity_id
      AND IFNULL(base.lg_city_name, 'placeholder') = IFNULL(agg.lg_city_name, 'placeholder')
      AND IFNULL(base.lg_zone_name, 'placeholder') = IFNULL(agg.lg_zone_name, 'placeholder')
      AND IFNULL(base.business_type_apac, 'placeholder') = IFNULL(agg.business_type_apac, 'placeholder')
      AND base.order_placed_date_local = agg.order_placed_date_local
      AND base.is_today = agg.is_today
      AND base.is_cancelled = agg.is_cancelled
      AND base.is_delivered = agg.is_delivered
      AND base.hour = agg.hour
      AND base.delivery_provider = agg.delivery_provider
LEFT JOIN yesterday_orders
       ON base.global_entity_id = yesterday_orders.global_entity_id
      AND base.order_placed_date_local = yesterday_orders.date_local
      AND base.delivery_provider = yesterday_orders.delivery_provider
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
       ON base.global_entity_id = shared_countries.global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Distinct Zone Riders' inline='true' name='federated.1rqfkfa0jcri6o1b6lob81wbfaig' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0uarf8e00xeqy01gnigd70b9h4h9'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared' server-oauth='' username='filbert.kang@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0uarf8e00xeqy01gnigd70b9h4h9' name='Custom SQL Query' type='text'><![CDATA[-- DISTINCT ZONE RIDERS


WITH parameters AS (
  SELECT
    DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)) AS current_date_local,  --tableau extract refresh at 12am PK time
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 1 DAY) AS date_minus_1_local,
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 7 DAY) AS date_minus_7_local
),

lg_countries AS (
    SELECT 
  global_entity_id,
  timezone
FROM `fulfillment-dwh-production.pandata_curated.shared_countries`
WHERE is_reporting_enabled
ORDER BY 1, 2
),

regional_apac_pd_vendors_agg_lg_zones AS (
  SELECT 
    global_entity_id,
    vendor_code,
    lg_zones.lg_city_name,
    lg_zones.lg_zone_name
  FROM `fulfillment-dwh-production.pandata_datamart.preprocessing__vendor_lg_zones` 
  LEFT JOIN UNNEST(lg_zones) AS lg_zones
  WHERE lg_zones.is_closest_point
),

active_riders AS (
  SELECT 
    content.global_entity_id,
    regional_apac_pd_vendors_agg_lg_zones.lg_city_name,
    regional_apac_pd_vendors_agg_lg_zones.lg_zone_name,
    DATE(order_status_stream.timestamp, lg_countries.timezone) AS delivered_date_local,
    DATETIME(order_status_stream.timestamp, lg_countries.timezone) AS delivered_at_local,
    EXTRACT(HOUR FROM DATETIME(order_status_stream.timestamp, lg_countries.timezone)) AS delivered_hour,

    MAX(
      DATETIME(order_status_stream.timestamp, lg_countries.timezone)) OVER (
      PARTITION BY
        content.global_entity_id
    ) AS latest_delivery_timestamp_local,
    
    DATE_TRUNC(DATETIME(CURRENT_TIMESTAMP, lg_countries.timezone), SECOND) AS current_timestamp_local,
    content.courier.courier_id
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_status_stream` AS order_status_stream
  LEFT JOIN lg_countries
         ON order_status_stream.content.global_entity_id = lg_countries.global_entity_id
  LEFT JOIN regional_apac_pd_vendors_agg_lg_zones
         ON order_status_stream.global_entity_id = regional_apac_pd_vendors_agg_lg_zones.global_entity_id
        AND order_status_stream.content.vendor.id = regional_apac_pd_vendors_agg_lg_zones.vendor_code
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
          ON order_status_stream.global_entity_id = shared_countries.global_entity_id
  WHERE shared_countries.is_reporting_enabled
    AND created_date >>= DATE_SUB((SELECT date_minus_7_local FROM parameters), INTERVAL 1 DAY)
    AND DATE(order_status_stream.timestamp, lg_countries.timezone) IN (
      (SELECT current_date_local FROM parameters),
      (SELECT date_minus_1_local FROM parameters),
      (SELECT date_minus_7_local FROM parameters)
    )
    AND content.courier.courier_id IS NOT NULL
    AND content.status = "DELIVERED"  
),

zones_daily_riders AS (
  SELECT
    global_entity_id,
    lg_city_name,
    lg_zone_name,
    delivered_date_local,
    COUNT(DISTINCT courier_id) AS zone_daily_active_riders
  FROM active_riders
  WHERE delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local)
    AND lg_city_name IS NOT NULL --pgo orders will not have city name, removing at this stage so as not to double count when aggregating to country active riders in the dashboard (rider who did pgo orders most likely have done platform order as well)  
  GROUP BY 1, 2, 3, 4
),

hourly_riders AS (
  SELECT
    global_entity_id,
    lg_city_name,
    lg_zone_name,
    delivered_date_local,
    delivered_hour,
    latest_delivery_timestamp_local,
    current_timestamp_local,
    COUNT(DISTINCT courier_id) AS hourly_active_riders
  FROM active_riders
  WHERE lg_city_name IS NOT NULL --pgo orders will not have city name, removing at this stage so as not to double count when aggregating to country active riders in the dashboard (rider who did pgo orders most likely have done platform order as well)
  GROUP BY 1, 2, 3, 4, 5, 6, 7
)

SELECT
  shared_countries.company_name AS brand_name,
  shared_countries.name AS country_name,
  hourly_riders.global_entity_id,
  hourly_riders.lg_city_name,
  hourly_riders.lg_zone_name,
  hourly_riders.delivered_date_local,
  IF(hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters), TRUE, FALSE) is_today,

  CASE 
    WHEN hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters) THEN 'Today'
    WHEN hourly_riders.delivered_date_local = (SELECT date_minus_1_local FROM parameters) THEN 'Yesterday'
    WHEN hourly_riders.delivered_date_local = (SELECT date_minus_7_local FROM parameters) THEN 'Same day last week'
  END AS day_category,

  IF(delivered_hour << EXTRACT(HOUR FROM current_timestamp_local), TRUE, FALSE) AS is_up_to_previous_hour,

  hourly_riders.delivered_hour,
  hourly_riders.latest_delivery_timestamp_local,
  hourly_riders.hourly_active_riders,
  IF(delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local), zones_daily_riders.zone_daily_active_riders, NULL) AS zone_daily_active_riders

FROM hourly_riders
LEFT JOIN zones_daily_riders
       ON hourly_riders.global_entity_id = zones_daily_riders.global_entity_id
      AND hourly_riders.lg_city_name = zones_daily_riders.lg_city_name
      AND hourly_riders.delivered_date_local = zones_daily_riders.delivered_date_local
      AND hourly_riders.lg_zone_name = zones_daily_riders.lg_zone_name
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
          ON hourly_riders.global_entity_id = shared_countries.global_entity_id
ORDER BY 1, 2, 3, 4, 5, 8 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0uarf8e00xeqy01gnigd70b9h4h9' name='Custom SQL Query' type='text'><![CDATA[-- DISTINCT ZONE RIDERS


WITH parameters AS (
  SELECT
    DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)) AS current_date_local,  --tableau extract refresh at 12am PK time
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 1 DAY) AS date_minus_1_local,
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 7 DAY) AS date_minus_7_local
),

lg_countries AS (
    SELECT 
  global_entity_id,
  timezone
FROM `fulfillment-dwh-production.pandata_curated.shared_countries`
WHERE is_reporting_enabled
ORDER BY 1, 2
),

regional_apac_pd_vendors_agg_lg_zones AS (
  SELECT 
    global_entity_id,
    vendor_code,
    lg_zones.lg_city_name,
    lg_zones.lg_zone_name
  FROM `fulfillment-dwh-production.pandata_datamart.preprocessing__vendor_lg_zones` 
  LEFT JOIN UNNEST(lg_zones) AS lg_zones
  WHERE lg_zones.is_closest_point
),

active_riders AS (
  SELECT 
    content.global_entity_id,
    regional_apac_pd_vendors_agg_lg_zones.lg_city_name,
    regional_apac_pd_vendors_agg_lg_zones.lg_zone_name,
    DATE(order_status_stream.timestamp, lg_countries.timezone) AS delivered_date_local,
    DATETIME(order_status_stream.timestamp, lg_countries.timezone) AS delivered_at_local,
    EXTRACT(HOUR FROM DATETIME(order_status_stream.timestamp, lg_countries.timezone)) AS delivered_hour,

    MAX(
      DATETIME(order_status_stream.timestamp, lg_countries.timezone)) OVER (
      PARTITION BY
        content.global_entity_id
    ) AS latest_delivery_timestamp_local,
    
    DATE_TRUNC(DATETIME(CURRENT_TIMESTAMP, lg_countries.timezone), SECOND) AS current_timestamp_local,
    content.courier.courier_id
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_status_stream` AS order_status_stream
  LEFT JOIN lg_countries
         ON order_status_stream.content.global_entity_id = lg_countries.global_entity_id
  LEFT JOIN regional_apac_pd_vendors_agg_lg_zones
         ON order_status_stream.global_entity_id = regional_apac_pd_vendors_agg_lg_zones.global_entity_id
        AND order_status_stream.content.vendor.id = regional_apac_pd_vendors_agg_lg_zones.vendor_code
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
          ON order_status_stream.global_entity_id = shared_countries.global_entity_id
  WHERE shared_countries.is_reporting_enabled
    AND created_date >>= DATE_SUB((SELECT date_minus_7_local FROM parameters), INTERVAL 1 DAY)
    AND DATE(order_status_stream.timestamp, lg_countries.timezone) IN (
      (SELECT current_date_local FROM parameters),
      (SELECT date_minus_1_local FROM parameters),
      (SELECT date_minus_7_local FROM parameters)
    )
    AND content.courier.courier_id IS NOT NULL
    AND content.status = "DELIVERED"  
),

zones_daily_riders AS (
  SELECT
    global_entity_id,
    lg_city_name,
    lg_zone_name,
    delivered_date_local,
    COUNT(DISTINCT courier_id) AS zone_daily_active_riders
  FROM active_riders
  WHERE delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local)
    AND lg_city_name IS NOT NULL --pgo orders will not have city name, removing at this stage so as not to double count when aggregating to country active riders in the dashboard (rider who did pgo orders most likely have done platform order as well)  
  GROUP BY 1, 2, 3, 4
),

hourly_riders AS (
  SELECT
    global_entity_id,
    lg_city_name,
    lg_zone_name,
    delivered_date_local,
    delivered_hour,
    latest_delivery_timestamp_local,
    current_timestamp_local,
    COUNT(DISTINCT courier_id) AS hourly_active_riders
  FROM active_riders
  WHERE lg_city_name IS NOT NULL --pgo orders will not have city name, removing at this stage so as not to double count when aggregating to country active riders in the dashboard (rider who did pgo orders most likely have done platform order as well)
  GROUP BY 1, 2, 3, 4, 5, 6, 7
)

SELECT
  shared_countries.company_name AS brand_name,
  shared_countries.name AS country_name,
  hourly_riders.global_entity_id,
  hourly_riders.lg_city_name,
  hourly_riders.lg_zone_name,
  hourly_riders.delivered_date_local,
  IF(hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters), TRUE, FALSE) is_today,

  CASE 
    WHEN hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters) THEN 'Today'
    WHEN hourly_riders.delivered_date_local = (SELECT date_minus_1_local FROM parameters) THEN 'Yesterday'
    WHEN hourly_riders.delivered_date_local = (SELECT date_minus_7_local FROM parameters) THEN 'Same day last week'
  END AS day_category,

  IF(delivered_hour << EXTRACT(HOUR FROM current_timestamp_local), TRUE, FALSE) AS is_up_to_previous_hour,

  hourly_riders.delivered_hour,
  hourly_riders.latest_delivery_timestamp_local,
  hourly_riders.hourly_active_riders,
  IF(delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local), zones_daily_riders.zone_daily_active_riders, NULL) AS zone_daily_active_riders

FROM hourly_riders
LEFT JOIN zones_daily_riders
       ON hourly_riders.global_entity_id = zones_daily_riders.global_entity_id
      AND hourly_riders.lg_city_name = zones_daily_riders.lg_city_name
      AND hourly_riders.delivered_date_local = zones_daily_riders.delivered_date_local
      AND hourly_riders.lg_zone_name = zones_daily_riders.lg_zone_name
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
          ON hourly_riders.global_entity_id = shared_countries.global_entity_id
ORDER BY 1, 2, 3, 4, 5, 8 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
