          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PDHourlyLiveOrdersTracking/LiveActionEvent?rev=' id='LiveActionEvent' path='/t/Foodora/workbooks/PDHourlyLiveOrdersTracking' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='wrap' id='dash-text_402' value='on' />
          <format attr='vertical-align' id='dash-text_531' value='auto' />
          <format attr='text-align' id='dash-text_531' value='auto' />
