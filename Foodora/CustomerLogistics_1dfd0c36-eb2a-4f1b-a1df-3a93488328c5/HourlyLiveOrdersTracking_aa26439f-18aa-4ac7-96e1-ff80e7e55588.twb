      <aliases enabled='yes' />
      <column caption='Event Duration %Diff VS LW' datatype='real' default-format='p0%' name='[Calculation_109141990418886668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM( IFNULL(IF period=&apos;Today&apos; THEN [duration_min] END, 0) )&#10;- SUM( IFNULL(IF period=&apos;Last Week&apos; THEN [duration_min] END, 0) ))&#10;/ &#10;(SUM( IFNULL(IF period=&apos;Today&apos; THEN [duration_min] END, 0) ))' />
      </column>
      <column caption='Event Duration %Diff Color' datatype='integer' name='[Calculation_109141990420443149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_109141990418886668]&gt;0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Up to Previous Hour Filter' datatype='boolean' name='[Calculation_109141990453051406]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[hour_local] &lt; DATEPART(&apos;hour&apos;, {MAX([updated_as_at_local])} )' />
      </column>
      <column caption='Level 1: Current Time' datatype='integer' name='[Calculation_1456773753863340032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 2: Current Time' datatype='integer' name='[Calculation_1456773753863454721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 3: Current Time' datatype='integer' name='[Calculation_1456773753863487490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 4: Current Time' datatype='integer' name='[Calculation_1456773753863532547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 1: Same Time LW' datatype='integer' name='[Calculation_1456773753863602180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 2: Same Time LW' datatype='integer' name='[Calculation_1456773753863655429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 3: Same Time LW' datatype='integer' name='[Calculation_1456773753863684102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 4: Same Time LW' datatype='integer' name='[Calculation_1456773753863729159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Level 1: Now (Agg)' datatype='boolean' name='[Calculation_1456773753863786504]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [today_level1] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Level 2: Now (Agg)' datatype='boolean' name='[Calculation_1456773753863954441]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [today_level2] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Level 3: Now (Agg)' datatype='boolean' name='[Calculation_1456773753864052746]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [today_level3] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Level 4: Now (Agg)' datatype='boolean' name='[Calculation_1456773753864105995]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [today_level4] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Level 1: LW (Agg)' datatype='boolean' name='[Calculation_1456773753864159244]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [last_week_level1] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Level 2: LW (Agg)' datatype='boolean' name='[Calculation_1456773753864249357]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [last_week_level2] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Level 3: LW (Agg)' datatype='boolean' name='[Calculation_1456773753864310798]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [last_week_level3] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Level 4: LW (Agg)' datatype='boolean' name='[Calculation_1456773753864368143]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    SUM(IF [today_level4] THEN 1 ELSE 0 END)&gt;=1 THEN TRUE&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Updated As At Local' datatype='string' name='[Calculation_1456773753864609808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MID(STR([updated_as_at_local]), 11, 9)' />
      </column>
      <column caption='Action Level' datatype='string' name='[Calculation_155796468084191232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    action=&apos;shrink&apos; THEN &apos;Shrink Level &apos; + STR([action_tier])&#10;ELSEIF&#10;    action=&apos;close&apos; THEN &apos;Close&apos;&#10;END' />
      </column>
      <column caption='Event Date' datatype='date' name='[Calculation_155796468092846082]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_CF64656235284540A40574182222F266]' role='measure' type='quantitative' />
      <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='real' default-format='N' name='[duration_min]' role='measure' type='quantitative' />
      <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='Hour Local' datatype='integer' name='[hour_local]' role='dimension' type='ordinal' />
      <column datatype='string' name='[period]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Last Week&quot;' value='Same Day Last Week' />
