                <zone forceUpdate='true' h='2000' id='49' type-v2='text' w='41407' x='58000' y='2400'>
                  <formatted-text>
                    <run fontalignment='2' fontcolor='#a31515' fontname='robo'>(Data Source: curated_data_shared_data_stream.delivery_area_event_stream)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3000' id='71' type-v2='text' w='48963' x='593' y='4800'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='8' italic='true'>Note: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>1. Only </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>Automatic</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'> triggered event is included in this dashboard. </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>Manual </run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>and </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>Scheduled</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'> events are excluded.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>2. Only </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>Active</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'> events are shown in </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>Current Live Event </run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>view. </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>Non-active</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'> events are excluded. If you don&apos;t see your country of interest, it means that there is no active event at the moment at that country.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3000' id='72' type-v2='text' w='49851' x='49556' y='4800'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='8' italic='true'>3. </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>Level 1: Current Time </run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>refers to action event that is happening at the moment at level 1 (for example : AUTO_AMK_SHRINK_1st) . Level 2 refers to an event at level 2 and so on.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>4. For </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>close</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'> action, there is only 1 level and thus level 2, 3 and 4 will always be </run>
                    <run bold='true' fontcolor='#000000' fontsize='8' italic='true'>False</run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>.</run>
                  </formatted-text>
