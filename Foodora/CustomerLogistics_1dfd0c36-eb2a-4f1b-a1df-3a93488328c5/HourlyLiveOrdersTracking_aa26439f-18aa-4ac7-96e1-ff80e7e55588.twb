    <worksheet name='Fail Rate (3 Hour Moving Average)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datastream_orders' name='federated.0x2utov18re7qa1fw4r881fom6lz' />
            <datasource caption='Distinct City Riders' name='federated.0dls45n02hmxpq185mtsl04rx1e8' />
            <datasource caption='Action Event' name='federated.0dfh7bg00u1yvx14t3mn11b08tls' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Fail Rate Threshold' datatype='real' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='0.2'>
              <calculation class='tableau' formula='0.2' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dfh7bg00u1yvx14t3mn11b08tls'>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dls45n02hmxpq185mtsl04rx1e8'>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2utov18re7qa1fw4r881fom6lz'>
            <column caption='2% of yesterday&apos;s order' datatype='real' name='[Calculation_1172343329695457280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([yesterday_country_full_day_orders])/50' />
            </column>
            <column caption='Gross Orders 3h MA' datatype='real' name='[Calculation_3234991946352541707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3234991946388582419] THEN [gross_orders_3h_moving_average_sum]/3 END' />
            </column>
            <column caption='is_above_2am' datatype='boolean' name='[Calculation_3234991946388582419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour] &gt;=2 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='3H MA Orders Cancelled' datatype='integer' name='[Calculation_3234991946724876309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_cancelled]&#10;WHEN TRUE THEN [gross_orders_3h_moving_average_sum]&#10;END' />
            </column>
            <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[latest_order_timestamp_local])&#10;        OR &#10;        ([hour] = 23 AND DATEPART(&apos;hour&apos;,[latest_order_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='3H MA Fail Rate Indicator' datatype='integer' name='[Calculation_4145141288098160640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[Fail Rate (copy)_3234991946836541462]&gt;[Parameters].[Parameter 6] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_5354639245356118019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//ZN(SUM([Orders Cancelled]))&#10;///&#10;//ZN(SUM([gross_orders]))&#10;&#10;&#10;SUM([Calculation_5777696135442980864])&#10;/&#10;SUM([gross_orders])' />
            </column>
            <column caption='Orders Cancelled' datatype='integer' name='[Calculation_5777696135442980864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_cancelled]&#10;WHEN TRUE THEN [gross_orders]&#10;END' />
            </column>
            <column caption='3H MA Fail Rate' datatype='real' name='[Fail Rate (copy)_3234991946836541462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([Calculation_3234991946352541707]) &gt; [Calculation_1172343329695457280]) &#10;  THEN&#10;    SUM([Calculation_3234991946724876309])/ SUM([gross_orders_3h_moving_average_sum])&#10;END' />
            </column>
            <column datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[business_type_apac]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[delivery_provider]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[gross_orders_3h_moving_average_sum]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_cancelled]' role='dimension' type='nominal' />
            <column datatype='datetime' datatype-customized='true' name='[latest_order_timestamp_local]' role='dimension' type='ordinal' />
