          <named-connection caption='BigQuery' name='bigquery.0l7dzj40frc7j913zthlx0wzxtme'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared' server-oauth='' username='filbert.kang@foodpanda.com' workgroup-auth-mode='prompt' />
