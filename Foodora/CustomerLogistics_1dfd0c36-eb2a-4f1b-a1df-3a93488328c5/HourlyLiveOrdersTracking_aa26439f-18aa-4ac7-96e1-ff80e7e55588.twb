            </zone>
            <zone fixed-size='50' h='2000' id='45' is-fixed='true' param='horz' type-v2='layout-flow' w='98814' x='593' y='2400'>
              <zone h='2000' id='47' type-v2='empty' w='39036' x='593' y='2400'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='2000' id='46' name='Event Date' show-title='false' w='18371' x='39629' y='2400'>
                <layout-cache fixed-size-h='34' fixed-size-w='240' type-h='fixed' type-w='fixed' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
