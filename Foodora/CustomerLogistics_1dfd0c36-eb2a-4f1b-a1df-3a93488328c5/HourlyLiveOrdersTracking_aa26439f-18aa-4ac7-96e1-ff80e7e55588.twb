        <calculation class='tableau' formula='IF [Orders % Diff vs Same day LW (copy)_3234991946327982085] &gt; 0 THEN 1 &#10;ELSEIF [Orders % Diff vs Same day LW (copy)_3234991946327982085] &lt; 0 THEN -1&#10;ELSEIF [Orders % Diff vs Same day LW (copy)_3234991946327982085] = 0 THEN 0&#10;END' />
