              <calculation class='tableau' formula='/*&#10;(SUM([Today country daily active riders])-SUM([Last week country daily active riders]))&#10;/ &#10;SUM([Last week country daily active riders])&#10;*/&#10;&#10;(AVG([Calculation_3221903355427270658])-AVG([Today country daily active riders (copy)_3221903355427946499]))&#10;/ &#10;AVG([Today country daily active riders (copy)_3221903355427946499])' />
