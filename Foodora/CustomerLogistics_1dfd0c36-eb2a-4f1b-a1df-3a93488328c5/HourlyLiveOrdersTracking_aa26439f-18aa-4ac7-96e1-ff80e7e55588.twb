          </dictionary>
        </manual-sort>
      </default-sorts>
      <datasource-dependencies datasource='Parameters'>
        <column caption='2. Breakdown by Hour?' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
          <calculation class='tableau' formula='&quot;No&quot;' />
        </column>
        <column caption='Breakdown by Zone/ Business Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
          <calculation class='tableau' formula='&quot;None&quot;' />
        </column>
        <column caption='Bar Chart Breakdown' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
        </column>
        <column caption='Metric Selection' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders \% Change vs LW&quot;'>
          <calculation class='tableau' formula='&quot;Orders % Change vs LW&quot;' />
        </column>
        <column caption='Fail Rate Threshold' datatype='real' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='0.2'>
          <calculation class='tableau' formula='0.2' />
        </column>
        <column caption='DT Threshold' datatype='real' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='45.'>
          <calculation class='tableau' formula='45.' />
        </column>
        <column caption='% Orders Dropped Threshold' datatype='real' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='-0.25'>
          <calculation class='tableau' formula='-0.25' />
