      </datasources>
      <datasource-dependencies datasource='federated.0dfh7bg00u1yvx14t3mn11b08tls'>
        <column caption='Action Level' datatype='string' name='[Calculation_155796468084191232]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF &#10;    action=&apos;shrink&apos; THEN &apos;Shrink Level &apos; + STR([action_tier])&#10;ELSEIF&#10;    action=&apos;close&apos; THEN &apos;Close&apos;&#10;END' />
        </column>
        <column datatype='string' name='[action]' role='dimension' type='nominal' />
