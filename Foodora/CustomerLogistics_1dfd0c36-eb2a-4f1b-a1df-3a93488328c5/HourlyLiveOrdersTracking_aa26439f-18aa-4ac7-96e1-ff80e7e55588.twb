          <datasource-dependencies datasource='federated.0dls45n02hmxpq185mtsl04rx1e8'>
            <column caption='% City Today vs Yesterday' datatype='real' name='[% City Today vs Last Week (copy)_3650097146456129545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Differences Today vs Last week (copy)_3650097146456293387]&#10;/ &#10;[% Same Day LW (copy)_3650097146456182794]' />
            </column>
            <column caption='% Differences Today vs Yesterday' datatype='real' name='[% Differences Today vs Last week (copy)_3650097146456293387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    AVG(&#10;        CASE [day_category] WHEN &apos;Today&apos; &#10;        THEN [city_daily_active_riders] END&#10;    ) &#10;    - &#10;    AVG(&#10;        CASE [day_category] WHEN &apos;Yesterday&apos; &#10;        THEN [city_daily_active_riders] END&#10;    )&#10;)' />
            </column>
            <column caption='% Yesterday' datatype='real' name='[% Same Day LW (copy)_3650097146456182794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Today city daily active riders (copy)_3221903355430916105])' />
            </column>
            <column caption='ShowCity&amp;GlobalGraph' datatype='integer' name='[Calculation_3098758023058817033]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 10] = &quot;City&quot; OR [Parameters].[Parameter 10] = &quot;Global&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='% City Today vs Last Week' datatype='real' name='[Calculation_3650097146407530496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3650097146408792065]&#10;/ &#10;[Calculation_3650097146416689154]' />
            </column>
            <column caption='% Differences Today vs Last week' datatype='real' name='[Calculation_3650097146408792065]' role='measure' type='quantitative'>
