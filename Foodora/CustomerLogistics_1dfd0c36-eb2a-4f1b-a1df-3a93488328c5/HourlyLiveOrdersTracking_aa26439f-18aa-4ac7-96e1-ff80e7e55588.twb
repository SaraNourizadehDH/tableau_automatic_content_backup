    DATE(DATETIME_SUB(CURRENT_DATETIME('Asia/Karachi'), INTERVAL 10 MINUTE)) AS current_date  --tableau extract refresh at 12am PK time
    , DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 7 DAY) AS date_minus_7_local
