        <column-instance column='[Calculation_155796468084191232]' derivation='None' name='[none:Calculation_155796468084191232:nk]' pivot='key' type='nominal' />
        <column-instance column='[action]' derivation='None' name='[none:action:nk]' pivot='key' type='nominal' />
        <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
