              </zone-style>
            </zone>
            <zone fixed-size='160' forceUpdate='true' h='12923' id='9' is-fixed='true' type-v2='text' w='98546' x='727' y='7537'>
              <formatted-text>
                <run fontcolor='#000000' fontname='Tableau Light'>This dashboard is owned by MY Data team. Kindly reach out to us @mydata_members in our respective Slack Channels, or email us at pandata_my@foodpanda.my for any questions or concerns. Thanks!</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light'>For access:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light'>Please request for Performance viewership role access in Tableau (tableau-pandora Performance Foodpanda Malaysia). Documentation here for access: </run>
                <run auto-url='true' fontcolor='#4996b2' fontname='Tableau Light' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/MYD/Other+Accesses&amp;quot;' underline='true'>https://confluence.deliveryhero.com/display/MYD/Other+Accesses</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light'>Data refresh: Daily at 11am. Latest data will only by t-2 due to late refresh of tables. For any refresh issues, please refer to #pandata or #pandata-my-support for updates on refresh.</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone fixed-size='24' h='2461' id='8' is-fixed='true' type-v2='empty' w='98546' x='727' y='20460'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#c2004f' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='74230' id='7' type-v2='text' w='98546' x='727' y='22921'>
              <formatted-text>
                <run bold='true' fontcolor='#333333' fontsize='12' underline='true'>Definitions</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true'>Valid Orders</run>
                <run> = Total successful orders (OD, VD &amp; Pickup)

</run>
                <run bold='true'>GMV Net</run>
                <run> = GFV + Service Fee + Delivery Fee + container charges + surcharge  - discounts &amp; vouchers. Actual payment made by customer

</run>
                <run bold='true'>GFV</run>
                <run> = total gross food value &#10;&#10;</run>
                <run bold='true'>Revenue</run>
                <run> = sum of all revenue generating metrics
  - </run>
                <run bold='true'>Net Commissions</run>
                <run> = revenue commission from vendors
  - </run>
                <run bold='true'>Net Delivery Fee</run>
                <run> = revenue from delivery fees
  - </run>
                <run bold='true'>Subscription revenue</run>
                <run> = revenue from pandapro subscription
  - </run>
                <run bold='true'>Ads Revenue (NCR)</run>
                <run> = revenue from ads/non-commission revenue
  - </run>
                <run bold='true'>Surcharge</run>
                <run> = total difference to mov (minimum order value)

</run>
                <run bold='true'>Cost</run>
                <run> = sum of all cost generating metrics
  - </run>
                <run bold='true'>Rider &amp; Delivery Cost</run>
                <run> = rider cost + other delivery cost
  - </run>
                <run bold='true'>COS (cost of sales)</run>
                <run> = transmission method + contract center + online payment cost + other cos

</run>
                <run bold='true'>Gross Profit (GP)</run>
                <run> = Revenue - Cost&#10;&#10;</run>
                <run bold='true'>Incentive Cost</run>
                <run> = cost for voucher and discount foodpanda fundings

</run>
                <run bold='true'>Fully Loaded Gross Profit (FLGP)</run>
                <run> = Revenue - Cost - Incentive&#10;&#10;</run>
                <run bold='true'>% Revenue</run>
                <run> = Revenue / Net GMV&#10;&#10;</run>
                <run bold='true'>% Cost </run>
                <run>= Cost / Net GMV&#10;&#10;</run>
                <run bold='true'>% Ads Revenue (NCR)</run>
                <run> = Ads Revenue / GFV&#10;&#10;</run>
                <run bold='true'>% ICPGMV</run>
                <run> = Incentive Cost / Net GMV&#10;&#10;</run>
                <run bold='true'>% GP</run>
                <run> = Gross Profit / Net GMV&#10;&#10;</run>
                <run bold='true'>% FLGP</run>
                <run> = Fully Loaded Gross Profit / Net GMV

------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

</run>
                <run bold='true'>AFV </run>
                <run>= Average food value &#10;&#10;</run>
                <run bold='true'>COMMPO</run>
                <run> = Commissions per order. Average commission we get from vendors per order

</run>
                <run bold='true'>ADF</run>
                <run> = Average delivery net fee. Average actual delivery fee paid by customer

</run>
                <run bold='true'>RPO </run>
                <run>= Revenue per order. Commission net + delivery fee net + subscription revenue + NCR revenue + difference to mov revenue + service fee revenue

</run>
                <run bold='true'>NCRPO</run>
                <run> = Non-Commission Revenue per order

</run>
                <run bold='true'>RCPO</run>
                <run> = Rider cost per order. rider cost + other delivery cost

</run>
                <run bold='true'>ICPO</run>
                <run> = Incentive per order&#10;&#10;</run>
                <run bold='true'>GPO </run>
                <run>= Gross profit per order&#10;&#10;</run>
                <run bold='true'>FLGPO </run>
                <run>= Fully loaded gross profit per order
</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
