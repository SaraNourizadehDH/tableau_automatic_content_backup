    <worksheet name='metric breakdown (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='country_MY_flgp_vendor_daily' name='federated.1163xt40wgatae12bi3dn00cfr6j' />
          </datasources>
          <datasource-dependencies datasource='federated.1163xt40wgatae12bi3dn00cfr6j'>
            <column caption='% VFD' datatype='real' default-format='p0.00%' name='[Calculation_1352839128687493120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_vendor_funded_incentives_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='GPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320346267648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gp_local])/SUM([valid_orders])' />
            </column>
            <column caption='FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320348004353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_local])/SUM([valid_orders])' />
            </column>
            <column caption='AFV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320348450818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local])/SUM([valid_orders])' />
            </column>
            <column caption='ADF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320348557315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_delivery_fee_net_local])/SUM([valid_orders])' />
            </column>
            <column caption='RPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320348647428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgp_commission_net_local])&#10;+ SUM([flgp_delivery_fee_net_local])&#10;+ SUM([flgp_subscription_revenue_local])&#10;+ SUM([flgp_ncr_revenue_local])&#10;+ SUM([flgp_other_ncr_revenue_local])&#10;+ SUM([flgp_difference_to_mov_local])&#10;+ SUM([flgp_service_fee_local]))&#10;/SUM([valid_orders])' />
            </column>
            <column caption='COMMPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320350289925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_commission_net_local])/SUM([valid_orders])' />
            </column>
            <column caption='NCRPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320352047110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgp_ncr_revenue_local])+SUM([flgp_other_ncr_revenue_local]))&#10;/&#10;SUM([valid_orders])' />
            </column>
            <column caption='DCPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320352210951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_rider_cpo_local] + [flgp_other_delivery_cpo_local])/SUM([valid_orders])' />
            </column>
            <column caption='IPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2382615320352358408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentive_cost_local])/SUM([valid_orders])' />
            </column>
            <column caption='Revenue' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_2382615320371654671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgp_commission_net_local])&#10;+ SUM([flgp_delivery_fee_net_local])&#10;+ SUM([flgp_subscription_revenue_local])&#10;+ SUM([flgp_ncr_revenue_local])&#10;+ SUM([flgp_other_ncr_revenue_local])&#10;+ SUM([flgp_difference_to_mov_local])&#10;+ SUM([flgp_service_fee_local]))' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_2382615320613699600]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX([order_date])' />
            </column>
            <column caption='Min Date' datatype='date' datatype-customized='true' name='[Calculation_2382615320613744657]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MIN([order_date])' />
            </column>
            <column caption='Delivery Cost' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_3481352892618866688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_rider_cpo_local] + [flgp_other_delivery_cpo_local])' />
            </column>
            <column caption='COS' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_3481352892637118465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_transmission_method_cpo_local])&#10;+ SUM([flgp_contact_center_cpo_local])&#10;+ SUM([flgp_online_payment_cost_local])&#10;+ SUM([flgp_other_cos_cpo_local])' />
            </column>
            <column caption='Cost' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_3481352892638281730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_rider_cpo_local])&#10;+ SUM([flgp_other_delivery_cpo_local])&#10;+ SUM([flgp_transmission_method_cpo_local])&#10;+ SUM([flgp_contact_center_cpo_local])&#10;+ SUM([flgp_online_payment_cost_local])&#10;+ SUM([flgp_other_cos_cpo_local])' />
            </column>
            <column caption='NCR' datatype='real' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_3481352892639162371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_ncr_revenue_local] + [flgp_other_ncr_revenue_local])' />
            </column>
            <column caption='ADF (with Vendor Cofund)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3557773373953060865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_delivery_fee_plus_vendor_cofund_local])/SUM([valid_orders])' />
            </column>
            <column caption='Avg New Customer per Day' datatype='real' name='[Calculation_3732710053178716160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_customer])/COUNTD([order_date])' />
            </column>
            <column caption='% Revenue' datatype='real' default-format='p0.00%' name='[Calculation_4536250736925896704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2382615320371654671]/SUM([gmv_net_local])' />
            </column>
            <column caption='% Cost' datatype='real' default-format='p0.00%' name='[Calculation_4536250736926466049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3481352892638281730]/SUM([gmv_net_local])' />
            </column>
            <column caption='% ICPGMV' datatype='real' default-format='p0.00%' name='[Calculation_4536250736928194562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentive_cost_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='% GP' datatype='real' default-format='p0.00%' name='[Calculation_4536250736928559107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gp_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='% FLGP' datatype='real' default-format='p0.00%' name='[Calculation_4536250736928628740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='% Ads Revenue (NCR)' datatype='real' default-format='p0.00%' name='[Calculation_4536250736929652741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3481352892639162371]/SUM([gmv_net_local])' />
            </column>
            <column caption='% Net Commissions' datatype='real' default-format='p0.00%' name='[Calculation_5330080541076582400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_commission_net_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='% Net Delivery Fee' datatype='real' default-format='p0.00%' name='[Calculation_5330080541076692993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_delivery_fee_net_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='% Subscription Revenue' datatype='real' default-format='p0.00%' name='[Calculation_5330080541076754434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_subscription_revenue_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='% Surcharge' datatype='real' default-format='p0.00%' name='[Calculation_5330080541076852739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgp_difference_to_mov_local])/SUM([gmv_net_local])' />
            </column>
            <column caption='FLGPO (with Vendor Cofund DF)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[FLGPO (copy)_3557773373954371586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([flgp_commission_net_local])&#10;+ SUM([flgp_delivery_fee_plus_vendor_cofund_local])&#10;+ SUM([flgp_subscription_revenue_local])&#10;+ SUM([flgp_ncr_revenue_local])&#10;+ SUM([flgp_other_ncr_revenue_local])&#10;+ SUM([flgp_difference_to_mov_local])&#10;+ SUM([flgp_service_fee_local]))&#10;-&#10;(SUM([flgp_rider_cpo_local])&#10;+ SUM([flgp_other_delivery_cpo_local])&#10;+ SUM([flgp_transmission_method_cpo_local])&#10;+ SUM([flgp_contact_center_cpo_local])&#10;+ SUM([flgp_online_payment_cost_local])&#10;+ SUM([flgp_other_cos_cpo_local]))&#10;-&#10;SUM([incentive_cost_local]))&#10;/SUM([valid_orders])' />
            </column>
            <column caption='GPO  (with Vendor Cofund DF)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[FLGPO (with Vendor Cofund DF) (copy)_3557773373955624963]' role='measure' type='quantitative'>
