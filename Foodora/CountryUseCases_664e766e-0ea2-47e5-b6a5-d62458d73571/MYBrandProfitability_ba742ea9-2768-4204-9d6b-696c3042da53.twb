      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7E638A09084041249D5ADCC277ED19EE'>
            <properties context=''>
              <relation connection='bigquery.0aucglx02lw13i1bjni8q139iaw9' name='Custom SQL Query' type='text'>SELECT
  global_entity_id,
  order_date,
  chain_name,
  chain_code,
  region,
  lg_city_name,
  lg_zone_name,
  vendor_lg_city_name,
  vendor_lg_zone_name,
  distance_type,
  business_type,
  delivery_method,
  is_flgpo_positive,
  is_gpo_positive,
  profit_grp,
  halal_status,
  is_billable,
  SUM(new_customer_for_chain) AS new_customer,
  SUM(valid_orders) AS valid_orders,
  SUM(gmv_local) AS gmv_local,
  SUM(gmv_net_local) As gmv_net_local,
  SUM(gfv_local) AS gfv_local,
  SUM(vd_subsidized_voucher_value_local + vd_subsidized_discount_value_local) AS vd_funded_deals_local,
  SUM(fp_subsidized_voucher_value_local + fp_subsidized_discount_value_local) AS fp_funded_deals_local,
  SUM(flgp_vendor_funded_incentives_local) AS flgp_vendor_funded_incentives_local,
  SUM(flgp_commission_net_local) AS flgp_commission_net_local,
  SUM(flgp_subscription_revenue_local) AS flgp_subscription_revenue_local,
  SUM(flgp_delivery_fee_net_local) AS flgp_delivery_fee_net_local,
  SUM(flgp_delivery_fee_plus_vendor_cofund_local) AS flgp_delivery_fee_plus_vendor_cofund_local,
  SUM(flgp_ncr_revenue_local) AS flgp_ncr_revenue_local,
  SUM(flgp_other_ncr_revenue_local) AS flgp_other_ncr_revenue_local,
  SUM(flgp_difference_to_mov_local) AS flgp_difference_to_mov_local,
  SUM(flgp_service_fee_local) AS flgp_service_fee_local,
  SUM(flgp_rider_cpo_local) AS flgp_rider_cpo_local,
  SUM(flgp_other_delivery_cpo_local) AS flgp_other_delivery_cpo_local,
  SUM(flgp_transmission_method_cpo_local) AS flgp_transmission_method_cpo_local,
  SUM(flgp_contact_center_cpo_local) AS flgp_contact_center_cpo_local,
  SUM(flgp_online_payment_cost_local) AS flgp_online_payment_cost_local,
  SUM(flgp_other_cos_cpo_local) AS flgp_other_cos_cpo_local,
  SUM(incentive_cost_local) AS incentive_cost_local,
  SUM(gp_local) AS gp_local,
  SUM(flgp_local) AS flgp_local

FROM `fulfillment-dwh-production.pandata_report.country_MY_flgp_vendor_daily` 
WHERE order_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 12 MONTH)
  AND NOT is_test_vendor
GROUP BY ALL</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
