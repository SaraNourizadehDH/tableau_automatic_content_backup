      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone fixed-size='242' forceUpdate='true' h='11250' id='3' is-fixed='true' type-v2='text' w='25000' x='1000' y='1250'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='18'>pandora</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='2' />
            <format attr='margin' value='4' />
            <format attr='padding' value='0' />
            <format attr='background-color' value='#a93099' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='11250' id='4' type-v2='text' w='73400' x='26100' y='1250'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='15'>    DESCRIPTION  / METRIC DEFINITION</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='dashed' />
            <format attr='border-width' value='2' />
            <format attr='margin' value='4' />
            <format attr='background-color' value='#e6e6e6' />
          </zone-style>
        </zone>
        <zone fixed-size='234' forceUpdate='true' h='38250' id='5' is-fixed='true' type-v2='text' w='98400' x='700' y='15000'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='26'>Definitions</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>-Vendor Mark:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Vendors marked monthly according to their status.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>1.New:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Vendor is newly acquired. (Flag from pandora vendors table.)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>2.Not Acquired:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Vendor is not acquired yet. (Implemented for previous month&apos;s vendor marks.)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>3.Terminated:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Vendor terminated at specified month.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>4.TOP10:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Vendor is within the top 10 vendors with the highest orders.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>5.NOT TOP10:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Other vendors with atleast one order for specified month.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>-LM Vendor Mark:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Vendor count belongs to last month before the specified month.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>-</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>LY Vendor Mark:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Vendor count belongs to last year same month.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>-</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>MoM GMV Change Effect:</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>Share of specified dimension&apos;s monthly gmv change on monhtly total gmv change. (Total of changes always 100% or -100% depens on the GMV change is negative or positive.)</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='2' />
            <format attr='margin' value='4' />
            <format attr='padding' value='4' />
            <format attr='background-color' value='#f3ebf3' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
