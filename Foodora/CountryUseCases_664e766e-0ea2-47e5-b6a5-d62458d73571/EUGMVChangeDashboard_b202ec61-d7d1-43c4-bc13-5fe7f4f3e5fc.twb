        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0nx8kkb03hdk6w10661ec14amuil' name='Custom SQL Query' type='text'><![CDATA[WITH months AS
(
  SELECT report_date
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE_TRUNC(DATE_ADD(CURRENT_DATE("Europe/Stockholm"),INTERVAL -25 MONTH),MONTH),CURRENT_DATE("Europe/Stockholm"), INTERVAL 1 MONTH)) AS report_date
)
,
terminated AS
(
SELECT  vendor_code,
        DATE_TRUNC(DATE(ach.createddate,"Europe/Stockholm"),MONTH) AS terminate_month,
FROM fulfillment-dwh-production.curated_data_shared_salesforce.account_history ach
LEFT JOIN fulfillment-dwh-production.curated_data_shared_salesforce.account ac
  ON ach.accountid=ac.id AND ach.global_entity_id=ac.global_entity_id
LEFT JOIN fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors av
  ON ac.grid__c=av.global_vendor_id AND ac.global_entity_id=av.global_entity_id
WHERE ach.global_entity_id="OP_SE"  AND DATE(ach.createddate,"Europe/Stockholm")>>=DATE_TRUNC(DATE_ADD(CURRENT_DATE("Europe/Stockholm"),INTERVAL -25 MONTH),MONTH)
AND vendor_flags.is_duplicated_pre_migration_vendor=FALSE
AND av.vertical_parent="Food"
AND newvalue="Terminated" AND oldvalue="Active"
GROUP BY ALL
)
,
vendors AS
(
  SELECT 
    vendors.global_entity_id,
    vendors.lg_city_name,
    vendors.lg_zone_name,
    vendors.vendor_flags.is_key_account,
    vendors.chain_code,
    vendors.chain_name,
    vendors.vendor_code,
    vendors.vendor_name,
    vendors.new_until_date_utc,
    vendors.created_date_local,
    looker_vendors.sf_owner_name,
    looker_vendors.manager_full_name__c,
  FROM fulfillment-dwh-production.pandata_datamart.pandora__agg_orders orders
  LEFT JOIN fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors vendors
    ON orders.vendor_code=vendors.vendor_code AND orders.global_entity_id=vendors.global_entity_id
  LEFT JOIN fulfillment-dwh-production.pandata_datamart.pandora__looker_vendors looker_vendors
    ON orders.vendor_code=looker_vendors.vendor_code AND orders.global_entity_id=looker_vendors.global_entity_id
  WHERE orders.created_date_local>>=DATE_TRUNC(DATE_ADD(CURRENT_DATE("Europe/Stockholm"),INTERVAL -25 MONTH),MONTH)
   AND orders.global_entity_id IN ("OP_SE","MJM_AT")
   AND vendors.vertical_parent="Food"
  GROUP BY ALL
)
,
vendors_months AS
(
  SELECT 
    months.report_date AS month,
    vendors.global_entity_id,
    vendors.lg_city_name,
    vendors.lg_zone_name,
    vendors.is_key_account,
    vendors.chain_code,
    vendors.chain_name,
    vendors.vendor_code,
    vendors.vendor_name,
    vendors.new_until_date_utc,
    vendors.created_date_local,
    CASE 
      WHEN vendors.new_until_date_utc>>=months.report_date AND vendors.created_date_local<<=months.report_date THEN "New" 
      WHEN vendors.created_date_local>>=months.report_date THEN "Not Created Yet"
    ELSE NULL END AS mark,
    vendors.sf_owner_name,
    vendors.manager_full_name__c,
  FROM months
  CROSS JOIN vendors
  WHERE vendors.created_date_local<<=months.report_date
)
,
main AS
(
  SELECT 
    DATE_TRUNC(orders.created_date_local,MONTH) As month,
    orders.global_entity_id,
    vendors.vendor_code,
    vendors.is_deleted,
    COUNT(DISTINCT order_code) AS order_count,
    SUM(user_paid_gmv_local) AS gmv_local,
    SUM(user_paid_gmv_eur) AS gmv_eur,
    -- SUM(gfv_local) AS gfv_local,
    -- SUM(gfv_eur) AS gfv_eur,
    SUM(total_vendor_funded_discount_value_local) AS vfd_local,
    SUM(total_vendor_funded_discount_value_eur) AS vfd_eur,
    COUNT(DISTINCT CASE WHEN orders.vf_breakdown.pro_eur >> 0 OR orders.dh_breakdown.pro_local >> 0 THEN order_code ELSE NULL END) AS pro_order_count,
    SUM(CASE WHEN orders.vf_breakdown.pro_eur >> 0 OR orders.dh_breakdown.pro_local >> 0 THEN user_paid_gmv_local ELSE NULL END) AS pro_gmv_local,
    SUM(CASE WHEN orders.vf_breakdown.pro_eur >> 0 OR orders.dh_breakdown.pro_local >> 0 THEN user_paid_gmv_eur ELSE NULL END) AS pro_gmv_eur,
  FROM fulfillment-dwh-production.pandata_datamart.pandora__agg_orders orders
  LEFT JOIN fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors vendors
    ON orders.vendor_code=vendors.vendor_code AND orders.global_entity_id=vendors.global_entity_id
  WHERE orders.created_date_local>>=DATE_TRUNC(DATE_ADD(CURRENT_DATE("Europe/Stockholm"),INTERVAL -25 MONTH),MONTH)
    AND orders.global_entity_id IN ("OP_SE","MJM_AT")
    AND orders.is_successful=TRUE
    AND vendors.vertical_parent="Food"
  GROUP BY ALL
)
,
main_mark AS
(
  SELECT
    main.month,
    main.global_entity_id,
    main.vendor_code,
    main.order_count,
    main.gmv_local,
    main.gmv_eur,
    -- main.gfv_local,
    -- main.gfv_eur,
    main.vfd_local,
    main.vfd_eur,
    main.pro_order_count,
    main.pro_gmv_local,
    main.pro_gmv_eur,
    LEAD(main.order_count) OVER (PARTITION BY main.global_entity_id,main.vendor_code ORDER BY main.month DESC) AS lm_order_count,
    LEAD(main.order_count,12) OVER (PARTITION BY main.global_entity_id,main.vendor_code ORDER BY main.month DESC) AS ly_order_count,
    LEAD(main.gmv_local) OVER (PARTITION BY main.global_entity_id,main.vendor_code ORDER BY main.month DESC) AS lm_gmv_local,
    LEAD(main.gmv_local,12) OVER (PARTITION BY main.global_entity_id,main.vendor_code ORDER BY main.month DESC) AS ly_gmv_local,
    CASE 
      WHEN ROW_NUMBER() OVER (PARTITION BY main.month,main.global_entity_id ORDER BY order_count DESC)<<=10 THEN "TOP10" 
    ELSE "NOT TOP10" END AS month_vendor_mark,
  FROM main
)
SELECT*FROM
(
SELECT  tb1.*,
        IFNULL(LEAD(tb1.wf_mark) OVER (PARTITION BY tb1.global_entity_id,tb1.vendor_code ORDER BY tb1.month DESC),"Not Acquired") AS lm_wf_mark,
        IFNULL(LEAD(tb1.wf_mark,12) OVER (PARTITION BY tb1.global_entity_id,tb1.vendor_code ORDER BY tb1.month DESC),"Not Acquired") AS ly_wf_mark,
        DENSE_RANK() OVER (PARTITION BY tb1.global_entity_id,tb1.month ORDER BY mom_gmv_change ASC) AS mom_gmv_lost_rank,
        CASE WHEN order_count IS NULL THEN TRUE ELSE FALSE END AS month_no_order_vendor,
        CASE WHEN order_count IS NULL AND lm_order_count IS NULL AND ly_order_count IS NULL THEN TRUE ELSE FALSE END AS month_no_info_vendor,
        SUM(mom_gmv_change) OVER (PARTITION BY tb1.global_entity_id,tb1.month) mom_total_gmv_change_local
FROM
(
SELECT 
  vendors_months.month,
  vendors_months.vendor_code,
  vendors_months.global_entity_id,
  vendors_months.sf_owner_name AS account_manager,
  vendors_months.manager_full_name__c AS manager_of_am,
  vendors_months.lg_city_name,
  vendors_months.lg_zone_name,
  vendors_months.is_key_account,
  vendors_months.chain_code,
  vendors_months.chain_name,
  vendors_months.vendor_name,
  main_mark.order_count,
  main_mark.gmv_local,
  main_mark.gmv_eur,
  -- main_mark.gfv_local,
  -- main_mark.gfv_eur,
  main_mark.vfd_local,
  main_mark.vfd_eur,
  main_mark.pro_order_count,
  main_mark.pro_gmv_local,
  main_mark.pro_gmv_eur,
  main_mark.lm_order_count,
  main_mark.ly_order_count,
  main_mark.lm_gmv_local,
  main_mark.ly_gmv_local,
  CASE 
      WHEN terminated.vendor_code IS NOT NULL THEN "Terminated"
      WHEN vendors_months.mark IS NOT NULL THEN vendors_months.mark 
      WHEN main_mark.month_vendor_mark IS NOT NULL THEN main_mark.month_vendor_mark
      WHEN main_mark.month_vendor_mark IS NULL AND vendors_months.month>>=MAX(terminated.terminate_month) OVER (PARTITION BY vendors_months.global_entity_id,vendors_months.vendor_code) THEN "Terminated"
      ELSE "Zombie" END  AS wf_mark,
  (IFNULL(gmv_local,0)-IFNULL(lm_gmv_local,0)) AS mom_gmv_change
FROM vendors_months
LEFT JOIN main_mark
  ON vendors_months.vendor_code=main_mark.vendor_code
    AND vendors_months.month=main_mark.month 
    AND vendors_months.global_entity_id=main_mark.global_entity_id
LEFT JOIN terminated 
  ON vendors_months.vendor_code=terminated.vendor_code AND vendors_months.month=terminated.terminate_month
)tb1
) 
WHERE month>>=DATE_TRUNC(DATE_ADD(CURRENT_DATE("Europe/Stockholm"),INTERVAL -12 MONTH),MONTH)
  AND month!=DATE_TRUNC(CURRENT_DATE("Europe/Stockholm"),MONTH)
ORDER BY 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
