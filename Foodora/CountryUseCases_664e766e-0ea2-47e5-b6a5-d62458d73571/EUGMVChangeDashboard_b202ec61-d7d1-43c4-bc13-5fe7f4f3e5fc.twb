      <aliases enabled='yes' />
      <column caption='Start Month' datatype='date' name='[Calculation_1706019870654001157]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='End Month' datatype='date' name='[Calculation_1706019870654181382]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='WF Month' datatype='boolean' name='[Calculation_1706019870654480391]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month]&gt;=[Calculation_1706019870654001157] AND [month]&lt;=[Calculation_1706019870654181382]' />
      </column>
      <column caption='Negative GMV Local' datatype='real' name='[Calculation_1706019870665134104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gmv_local] &lt; 0 THEN [gmv_local] ELSE 0 END' />
      </column>
      <column caption='Running Sum' datatype='real' name='[Calculation_1706019870665560089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([gmv_local]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV Local Change' datatype='real' name='[Calculation_1706019870686855194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([gmv_local])) - LOOKUP(ZN(SUM([gmv_local])), -1)) / ABS(LOOKUP(ZN(SUM([gmv_local])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Opening Amount' datatype='real' name='[Calculation_1706019871067942951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([gmv_local]))-SUM([gmv_local])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Colour' datatype='boolean' name='[Calculation_1706019871068827689]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM(gmv_local)&gt;0' />
      </column>
      <column caption='MoM GMV local %' datatype='real' name='[Calculation_1706019871180603437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gmv_local])-SUM([lm_gmv_local]))/SUM([lm_gmv_local])' />
      </column>
      <column caption='VFD / GMV %' datatype='real' name='[Calculation_1706019871612465202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vfd_local])/SUM([gmv_local])' />
      </column>
      <column caption='PRO / GMV %' datatype='real' name='[Calculation_1706019871614844979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_gmv_local])/SUM([gmv_local])' />
      </column>
      <column caption='MoM GMV Change Effect' datatype='real' name='[Calculation_1706019871636975668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mom_gmv_change])/ABS(MAX([mom_total_gmv_change_local]))' />
      </column>
      <column caption='MoM Order %' datatype='real' name='[MoM GMV local % (copy)_1706019871181905967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([order_count])-SUM([lm_order_count]))/SUM([lm_order_count])' />
      </column>
      <column caption='YoY Order %' datatype='real' name='[MoM Order % (copy)_1706019871181164590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([order_count])-SUM([ly_order_count]))/SUM([ly_order_count])' />
      </column>
      <column caption='YoY GMV local %' datatype='real' name='[YoY Order % (copy)_1706019871182442544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gmv_local])-SUM([ly_gmv_local]))/SUM([ly_gmv_local])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_361BBF7063A34B8BB74AF0590DB876C5]' role='measure' type='quantitative' />
