        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.072mn0b0912o9o12o81401fxk107' name='Custom_SQL_Query' type='text'>SELECT a.*,&#13;
FORMAT_DATETIME(&quot;%Y-%m&quot;, DATETIME(report_date)) AS month_number,&#13;
