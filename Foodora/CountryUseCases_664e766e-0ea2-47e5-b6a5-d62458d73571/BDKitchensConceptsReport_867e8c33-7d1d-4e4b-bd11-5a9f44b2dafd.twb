            <column caption='Dates' datatype='datetime' name='[Calculation_171699751508344833]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;WHEN &apos;Day&apos; THEN [date]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[date])&#13;&#10;WHEN  &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[date])&#13;&#10;WHEN  &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[date])&#13;&#10;END' />
            </column>
            <column caption='Incentivised Order %' datatype='real' name='[Calculation_171699751552245764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentivised_orders])/SUM([sucessful_orders])' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_171699751553228805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1]&#13;&#10;WHEN &quot;Orders&quot; THEN ROUND([Calculation_171699751555985415])&#13;&#10;WHEN &quot;Order Frequency&quot; THEN [Calculation_171699751553355782]&#13;&#10;WHEN &quot;GFV&quot; THEN [Calculation_171699751557095434]&#13;&#10;WHEN &quot;AFV&quot; THEN [Calculation_171699751557152779]&#13;&#10;WHEN &quot;GMV&quot; THEN [Calculation_171699751557038089]&#13;&#10;WHEN &quot;NC&quot; THEN [Calculation_171699751558463504]&#13;&#10;WHEN &quot;Active Customers&quot; THEN [Calculation_171699751558570001]&#13;&#10;WHEN &quot;Incentivised Order %&quot; THEN [Calculation_171699751552245764]*100 &#13;&#10;WHEN &quot;ICPO&quot; THEN [Calculation_171699751558033422]&#13;&#10;WHEN &quot;ICPGMV&quot; THEN [Calculation_171699751559442452]*100&#13;&#10;WHEN &quot;Estimated Prep Time&quot; THEN [Calculation_171699751557926925]&#13;&#10;WHEN &quot;At Vendor Clean Time&quot; THEN [Calculation_171699751558889490]&#13;&#10;WHEN &quot;DT&quot; THEN [Calculation_171699751557857292]&#13;&#10;WHEN &quot;Order Delay Time&quot; THEN [Calculation_171699751558389775]&#13;&#10;WHEN &quot;Food Rating&quot; THEN ROUND([Calculation_171699751559082003],2)&#13;&#10;WHEN &quot;Offline %&quot; THEN [Calculation_171699751563751445]*100&#13;&#10;END' />
            </column>
            <column caption='Order Frequency' datatype='real' name='[Calculation_171699751553355782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sucessful_orders])/SUM([Customers])' />
            </column>
            <column caption='Sucessful Orders' datatype='integer' name='[Calculation_171699751555985415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sucessful_orders])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_171699751557038089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV_sucessful_orders])' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_171699751557095434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GFV_sucessful_orders])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_171699751557152779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([AFV_sucessful_orders])' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_171699751557857292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([delivery_time])' />
            </column>
            <column caption='Estimated Prep Time' datatype='real' name='[Calculation_171699751557926925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([estimated_prep_time])' />
            </column>
            <column caption='ICPO' datatype='real' name='[Calculation_171699751558033422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([fp_burn_per_subsidy])' />
            </column>
            <column caption='Order Delay Time' datatype='real' name='[Calculation_171699751558389775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([order_delay_time])' />
            </column>
            <column caption='New Customer' datatype='integer' name='[Calculation_171699751558463504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([NC])' />
            </column>
            <column caption='Active Customer' datatype='integer' name='[Calculation_171699751558570001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Customers])' />
            </column>
            <column caption='AT Vendor Cleaned' datatype='real' name='[Calculation_171699751558889490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([at_vendor_cleaned])' />
            </column>
            <column caption='Food Rating' datatype='real' name='[Calculation_171699751559082003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([rating])' />
            </column>
            <column caption='ICPGMV %' datatype='real' name='[Calculation_171699751559442452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([foodpanda_funded_subsidy],0))&#13;&#10;/&#13;&#10;SUM(IFNULL([GMV_sucessful_orders],0))' />
            </column>
            <column caption='Offline %' datatype='real' name='[Calculation_171699751563751445]' role='measure' type='quantitative'>
