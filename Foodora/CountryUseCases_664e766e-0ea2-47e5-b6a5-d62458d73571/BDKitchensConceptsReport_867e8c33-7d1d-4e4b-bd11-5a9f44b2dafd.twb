    <datasource caption='Concept Sessions (pandata_bd_marketing)' inline='true' name='federated.08z3o1g0x8l7ap11j1rfh1k8gryh' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0t439ee0imfbqo13y5rtm15l5jon'>
            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Country - BD' schema='pandata_bd_marketing' server-oauth='server-custom' username='ateeq.ur@foodpanda.com.bd' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0t439ee0imfbqo13y5rtm15l5jon' name='Concept Sessions' type='text'>SELECT
  
  sessions.date_local AS date,
  kitchen_name as Kitchen_name,
  concept_brand_name as Concept_brand,
  business_types.business_type_apac as Vertical,
  CASE WHEN is_concepts AND is_kitchens THEN &quot;Concept (Inside Kitchen)&quot;
    WHEN is_concepts AND NOT is_kitchens THEN  &quot;Concept (Outside Kitchens)&quot;
    ELSE &quot;Kitchen (Excluding Concept)&quot;
  END as Sub_vertical,
  SAFE_DIVIDE ( SUM(count_of_transaction) , SUM(count_of_checkout_loaded) ) as MCVR4,
  SAFE_DIVIDE(SUM(count_of_checkout_loaded),SUM(count_of_shop_menu_loaded)) as MCVR3,
  SAFE_DIVIDE(SUM(count_of_shop_menu_loaded), SUM(count_of_shop_list_loaded)) as MCVR2,
  SUM(count_of_shop_list_loaded) as sessions,
  COUNT(DISTINCT vendors.vendor_code) as outlets,
  SUM(count_of_shop_list_loaded)/COUNT(DISTINCT vendors.vendor_code) as sessions_per_outlet,
  SAFE_DIVIDE(SUM(COALESCE(count_of_transaction, 0)), SUM(COALESCE(count_of_shop_menu_loaded, 0))) AS CVR,
  MAX(sessions.date_local) AS last_updated_date

  
FROM
  `fulfillment-dwh-production.pandata_report.product__vendor_session_metrics` AS sessions
LEFT JOIN
  `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` vendors
ON
  vendors.vendor_code=sessions.vendor_code
  AND vendors.global_entity_id = &quot;FP_BD&quot;
LEFT JOIN
`fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` business_types
  on vendors.uuid = business_types.uuid
WHERE
  sessions.global_entity_id = &apos;FP_BD&apos;
  # Last 2 weeks
  AND  sessions.date_local BETWEEN &quot;2022-09-01&quot; AND CURRENT_DATE(&quot;Asia/Dhaka&quot;)-1
  AND partition_date &gt;&gt; DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  AND business_types.business_type_apac IN (&quot;kitchens&quot;,&quot;concepts&quot;)
  AND vendors.is_active
  AND NOT vendors.is_private
  AND NOT vendors.is_test

GROUP BY
  1,2,3,4,5
ORDER BY
  date DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0t439ee0imfbqo13y5rtm15l5jon' name='Concept Sessions' type='text'>SELECT
  
