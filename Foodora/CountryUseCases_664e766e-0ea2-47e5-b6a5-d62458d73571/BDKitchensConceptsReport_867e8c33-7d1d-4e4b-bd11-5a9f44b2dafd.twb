            <column caption='Rider Rating' datatype='real' name='[Calculation_962644443487399954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([rider_rating])' />
            </column>
            <column caption='Punctuality Rating' datatype='real' name='[Calculation_962644443487490067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([punctuality_rating])' />
            </column>
            <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[concepts_type]' role='dimension' type='nominal' />
            <column caption='Date' datatype='string' datatype-customized='true' name='[created_date_local (copy)_3029233743626715136]' role='dimension' type='nominal'>
