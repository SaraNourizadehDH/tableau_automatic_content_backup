      <aliases enabled='yes' />
      <column caption='Selected Granularity' datatype='string' name='[Calculation_217861666491334657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Overall&quot; THEN [country_code]&#13;&#10;WHEN &quot;Concept Type&quot; THEN [concepts_type]&#13;&#10;WHEN &quot;Kitchen Name&quot; THEN [kitchen_name]&#13;&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#13;&#10;WHEN &quot;Concept Operator Name&quot; THEN [concept_operator_name]&#13;&#10;WHEN &quot;Primary_zone_Name&quot; THEN [primary_zone_name]&#13;&#10;END' />
      </column>
      <column caption='Dynamic Date Filter' datatype='string' name='[Calculation_962644443510423574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [month_number]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [weeks]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [Date (copy)_1009650787230986250]&#13;&#10;END' />
      </column>
      <column caption='Dynamic Date Range' datatype='string' name='[Calculation_962644443510534167]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[report_date]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_date]))&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[report_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[report_date])),3)&#13;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[report_date])),3)+&apos; &apos;+ RIGHT(str(DATEPART(&apos;year&apos;,[report_date])),2) end' />
      </column>
      <column caption='Offline Hour %' datatype='real' name='[Calculation_962644443511623704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_closed_Hours])/SUM([Total_open_Hours])' />
      </column>
      <column caption='List Loaded Count' datatype='integer' name='[Calculation_962644443513647129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_shop_list_loaded])' />
      </column>
      <column caption='Menu loaded' datatype='integer' name='[Calculation_962644443514126362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_shop_menu_loaded])' />
      </column>
      <column caption='mCVR2 (Menu/List)' datatype='real' name='[Calculation_962644443514806299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_shop_menu_loaded])/SUM([count_of_shop_list_loaded])' />
      </column>
      <column caption='mCVR3(Checkout/Menu)' datatype='real' name='[Calculation_962644443515080732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_checkout_loaded])/SUM([count_of_shop_menu_loaded])' />
      </column>
      <column caption='mCVR4(Transaction/Checkout)' datatype='real' name='[Calculation_962644443515519005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_transaction])/SUM([count_of_checkout_loaded])' />
      </column>
      <column caption='Date (copy)' datatype='string' datatype-customized='true' name='[Date (copy)_1009650787230986250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([report_date])' />
      </column>
