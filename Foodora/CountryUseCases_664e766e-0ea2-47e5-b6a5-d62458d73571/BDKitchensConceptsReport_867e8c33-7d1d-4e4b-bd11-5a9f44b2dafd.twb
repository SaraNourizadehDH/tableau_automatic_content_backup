        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0izgbi8078qdtb1da6bvt1gi8aer'>
            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='foodpanda-bd-bigquery' schema='pandata_bd_local' server-oauth='server-custom' username='ateeq.ur@foodpanda.com.bd' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0izgbi8078qdtb1da6bvt1gi8aer' name='Custom_SQL_Query' type='text'>SELECT a.*,
&apos;BD&apos; AS country_level,
b.fx_rate_eur,
b.fx_rate_usd,
FROM `fulfillment-dwh-production.pandata_report.country_BD_kitchen_concepts_1` AS a
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS b 
ON a.created_date_local = b.fx_rate_date 
AND b.currency_code = &apos;BDT&apos;
AND b.fx_rate_date &gt;&gt;= &apos;2000-01-01&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0izgbi8078qdtb1da6bvt1gi8aer' name='Custom_SQL_Query' type='text'>SELECT a.*,
&apos;BD&apos; AS country_level,
b.fx_rate_eur,
b.fx_rate_usd,
FROM `fulfillment-dwh-production.pandata_report.country_BD_kitchen_concepts_1` AS a
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS b 
ON a.created_date_local = b.fx_rate_date 
AND b.currency_code = &apos;BDT&apos;
AND b.fx_rate_date &gt;&gt;= &apos;2000-01-01&apos;</relation>
          <relation connection='bigquery.0izgbi8078qdtb1da6bvt1gi8aer' name='Custom_SQL_Query1' type='text'>WITH business_type AS (
  SELECT DISTINCT
    pd_vendors_agg_business_types.*,
    pd_vendors.vendor_name
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS pd_vendors_agg_business_types
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS pd_vendors
         ON pd_vendors_agg_business_types.uuid = pd_vendors.uuid
  WHERE pd_vendors_agg_business_types.global_entity_id = &quot;FP_BD&quot;
),

vendors AS (
  SELECT
    report_date,
    vendor_code,
    SUM(IFNULL(unavailable_seconds,0)) AS unavailable_seconds,
    SUM(IFNULL(scheduled_open_seconds,0)) AS scheduled_open_seconds,
    SAFE_DIVIDE(SUM(IFNULL(unavailable_seconds,0)),SUM(IFNULL(scheduled_open_seconds,0))) AS offline_percentage
  FROM `fulfillment-dwh-production.pandata_report.country_BD_vendor_hourly_offline` AS vm
  GROUP BY 1, 2
),

final AS (
  SELECT DISTINCT
    new_live_closed_vendor_list.*,
    business_type.* EXCEPT(vendor_code, global_entity_id),
    (CASE
      WHEN business_type.is_concepts AND NOT business_type.is_kitchens THEN &quot;concepts outside shared Kitchen&quot;
      WHEN business_type.is_concepts AND business_type.is_kitchens THEN &quot;concepts inside shared Kitchen&quot;
      ELSE &quot;kitchens vendors except concepts&quot;
    END) AS concepts_type,
    vmap.cluster_name,
    vmap.city_name,
    vmap.primary_zone_name,
    vmap.is_active,
    vmap.is_private,
  FROM vendors AS new_live_closed_vendor_list
  LEFT JOIN business_type AS business_type
        ON new_live_closed_vendor_list.vendor_code = business_type.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS vmap
        ON vmap.vendor_code=new_live_closed_vendor_list.vendor_code
  WHERE business_type.business_type_apac IN (&quot;kitchens&quot;, &quot;concepts&quot;)
  AND report_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH),MONTH) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
)

SELECT 
  a.*,
  FORMAT_DATETIME(&quot;%Y-%m&quot;, DATETIME(report_date)) AS month_number,
  FORMAT_DATETIME(&quot;%Y-%W&quot;, DATETIME(report_date)) AS weeks,
  &apos;BD&apos; AS country_code,
  b.chain_code,
  b.chain_name
FROM final AS a
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS b ON a.vendor_code = b.vendor_code AND b.global_entity_id = &apos;FP_BD&apos;</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
