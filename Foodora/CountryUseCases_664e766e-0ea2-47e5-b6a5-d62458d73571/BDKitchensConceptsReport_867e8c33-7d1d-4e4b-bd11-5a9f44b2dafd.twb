      <table>
        <view>
          <datasources>
            <datasource caption='Custom_SQL_Query (pandata_bd_local)' name='federated.0o3xm5u1s1exbo17iufw21lpni0t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
            <column caption='KPI Selector' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
              <calculation class='tableau' formula='&quot;GMV&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o3xm5u1s1exbo17iufw21lpni0t'>
            <column caption='GFV' datatype='real' name='[Calculation_1009650787216908291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GFV_successful_orders])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_1009650787217080324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1009650787216908291]/[Calculation_962644443461222401]' />
            </column>
            <column caption='Offline Hour %' datatype='real' name='[Calculation_1085086057257934851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unavailable_seconds])/SUM([scheduled_open_seconds])' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_217861666498306050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Orders&quot; THEN INT(ROUND([Calculation_962644443461222401]))&#13;&#10;WHEN &quot;GFV&quot; THEN [Calculation_1009650787216908291]&#13;&#10;WHEN &quot;AFV&quot; THEN [Calculation_1009650787217080324]&#13;&#10;WHEN &quot;GMV&quot; THEN [Calculation_962644443476983811]&#13;&#10;WHEN &quot;AOV&quot; THEN [Calculation_962644443477229572]&#13;&#10;WHEN &quot;ECR %&quot; THEN [Calculation_827254983128694786]*100&#13;&#10;WHEN &quot;NC Customers&quot; THEN INT(ROUND([Calculation_962644443493888021]))&#13;&#10;WHEN &quot;Active Customers&quot; THEN INT(ROUND([Calculation_962644443493589012]))&#13;&#10;WHEN &quot;VF Subsidy %&quot; THEN [Calculation_962644443478765573]*100&#13;&#10;WHEN &quot;FP Subsidy %&quot; THEN [Calculation_962644443479633926]*100&#13;&#10;WHEN &quot;ICRev %&quot; THEN [Calculation_827254981830930432]*100&#10;WHEN &quot;ICPGMV %&quot; THEN [ICRev % (copy)_5906611682202292224]*100&#13;&#10;WHEN &quot;Voucher Used Orders %&quot; THEN [Calculation_827254981833777153]*100&#13;&#10;WHEN &quot;Order Frequency&quot; THEN [Calculation_962644443481391111]&#13;&#10;WHEN &quot;Vendor Cancellation %&quot; THEN [Calculation_962644443483451402]*100&#13;&#10;WHEN &quot;Actual Prep Time&quot; THEN [Calculation_962644443485261835]&#13;&#10;WHEN &quot;Delivery Time&quot; THEN [Calculation_962644443486035982]&#13;&#10;WHEN &quot;Food Rating&quot; THEN [Calculation_962644443487023120]&#13;&#10;WHEN &quot;Packaging Rating&quot; THEN [Calculation_962644443487146001]&#13;&#10;WHEN &quot;AVC&quot; THEN [Calculation_5179843272491737088]&#10;WHEN &quot;EPT&quot; THEN [Calculation_962644443485577228]&#10;WHEN &quot;Offline Hour %&quot; THEN [Calculation_1085086057257934851]*100&#13;&#10;END' />
            </column>
            <column caption='AVC' datatype='real' name='[Calculation_5179843272491737088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([at_vendor_cleaned_time_in_minute])' />
            </column>
            <column caption='ICRev %' datatype='real' name='[Calculation_827254981830930432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#13;&#10;SUM(IFNULL([discount_value_foodpanda_funded],0)) &#13;&#10;+ SUM(IFNULL([voucher_value_foodpanda_funded],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IFNULL([commission_ammount],0))&#13;&#10;+SUM(IFNULL([Delivery_fee],0))&#13;&#10;),0)' />
            </column>
            <column caption='Voucher Used order %' datatype='real' name='[Calculation_827254981833777153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF  [voucher_value_local] &gt; 0 THEN [successful_orders]&#13;&#10;    ELSE NULL &#13;&#10;END&#13;&#10;)/COUNT([successful_orders])' />
            </column>
            <column caption='ECR %' datatype='real' name='[Calculation_827254983128694786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([commission_ammount],0))/SUM(IFNULL([gfv_for_ecr],0))' />
            </column>
            <column caption='Dynamic Date Filters' datatype='string' name='[Calculation_962644443455037440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Week&quot; THEN [week_year]&#13;&#10;WHEN &quot;Day&quot; then [created_date_local (copy)_3029233743626715136]&#13;&#10;WHEN &quot;Month&quot; THEN [month_number]&#13;&#10;END' />
            </column>
            <column caption='Successful Orders' datatype='real' name='[Calculation_962644443461222401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(COUNTD([successful_orders]))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_962644443476983811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV_successful_orders])' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_962644443477229572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV_successful_orders])/COUNTD([successful_orders])' />
            </column>
            <column caption='VF Subsidy %' datatype='real' name='[Calculation_962644443478765573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([discount_value_vendor_funded],0))+SUM(IFNULL([voucher_value_vendor_funded],0)))/SUM([GMV_successful_orders])' />
            </column>
            <column caption='FP Subsidy %' datatype='real' name='[Calculation_962644443479633926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([discount_value_foodpanda_funded],0))+SUM(IFNULL([voucher_value_foodpanda_funded],0)))/SUM([GMV_successful_orders])' />
            </column>
            <column caption='Order Frequency' datatype='real' name='[Calculation_962644443481391111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([successful_orders])/countd([active_customers])' />
            </column>
            <column caption='Vendor %' datatype='real' name='[Calculation_962644443483451402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([vendor_cancelled_orders])/countd([total_order])' />
            </column>
            <column caption='Assumed Actual' datatype='real' name='[Calculation_962644443485261835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([assumed_actual_prep_time])' />
            </column>
            <column caption='EPT' datatype='real' name='[Calculation_962644443485577228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([estimated_prep_time])' />
            </column>
            <column caption='Delivery Time' datatype='real' name='[Calculation_962644443486035982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([DT])' />
            </column>
            <column caption='Food Rating' datatype='real' name='[Calculation_962644443487023120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([restaurant_food_rating])' />
            </column>
            <column caption='Packaging Rating' datatype='real' name='[Calculation_962644443487146001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([packaging_rating])' />
