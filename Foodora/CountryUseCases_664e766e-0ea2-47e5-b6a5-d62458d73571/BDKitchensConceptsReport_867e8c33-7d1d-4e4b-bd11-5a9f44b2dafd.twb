    <worksheet name='mCVRs &amp; Offline Hour'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b32a88' fontname='Tableau Semibold'>mCVRs &amp; Offline Hour %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom_SQL_Query (pandata_bd_local)' name='federated.0o3xm5u1s1exbo17iufw21lpni0t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o3xm5u1s1exbo17iufw21lpni0t'>
            <column caption='mCVR2 (Menu/List)' datatype='real' name='[Calculation_1085086057257308160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_of_shop_menu_loaded])/SUM([count_of_shop_list_loaded])' />
            </column>
            <column caption='mCVR3 (Checkout/Menu)' datatype='real' name='[Calculation_1085086057257553921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_of_checkout_loaded])/SUM([count_of_shop_menu_loaded])' />
            </column>
            <column caption='mCVR4 (Transaction/Checkout)' datatype='real' name='[Calculation_1085086057257742338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_of_transaction])/SUM([count_of_checkout_loaded])' />
            </column>
            <column caption='Offline Hour %' datatype='real' name='[Calculation_1085086057257934851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unavailable_seconds])/SUM([scheduled_open_seconds])' />
            </column>
            <column caption='Dynamic Date Filters' datatype='string' name='[Calculation_962644443455037440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Week&quot; THEN [week_year]&#13;&#10;WHEN &quot;Day&quot; then [created_date_local (copy)_3029233743626715136]&#13;&#10;WHEN &quot;Month&quot; THEN [month_number]&#13;&#10;END' />
            </column>
            <column caption='Rider Rating' datatype='real' name='[Calculation_962644443487399954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([rider_rating])' />
            </column>
            <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[concepts_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[count_of_checkout_loaded]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_of_shop_list_loaded]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_of_shop_menu_loaded]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_of_transaction]' role='measure' type='quantitative' />
            <column caption='Date' datatype='string' datatype-customized='true' name='[created_date_local (copy)_3029233743626715136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date_local])' />
            </column>
            <column datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_kitchen_concept_vendor_active]' role='dimension' type='nominal' />
