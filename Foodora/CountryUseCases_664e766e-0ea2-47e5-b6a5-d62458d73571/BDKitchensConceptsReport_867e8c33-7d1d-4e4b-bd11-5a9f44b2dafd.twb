      <aliases enabled='yes' />
      <column caption='AFV (€)' datatype='real' name='[AFV (copy)_2036471519943368706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GFV (copy)_2036471519937359873]/[Calculation_962644443461222401]' />
      </column>
      <column caption='Actual Prep Time' datatype='real' name='[Assumed Actual (copy)_1009650787219046407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([assumed_actual_prep_time])' />
      </column>
      <column caption='Per Day Per Outlet Orders' datatype='real' name='[Calculation_1009650787213926400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([successful_orders])/COUNTD([vendor_code])/COUNTD([created_date_local])' />
      </column>
      <column caption='Per Day Per Brand Orders' datatype='real' name='[Calculation_1009650787214209025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([successful_orders])/COUNTD([chain_code])/COUNTD([created_date_local])' />
      </column>
      <column caption='GFV' datatype='real' name='[Calculation_1009650787216908291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GFV_successful_orders])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1009650787217080324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1009650787216908291]/[Calculation_962644443461222401]' />
      </column>
      <column caption='% Order with Vendor Late &gt; 10 mins' datatype='real' name='[Calculation_1009650787226685448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([vendor_lateness_10_min_or_more])/COUNT([successful_orders])' />
      </column>
      <column caption='Rider Waiting Time' datatype='real' name='[Calculation_1009650787227017225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([at_vendor_time_in_minute])' />
      </column>
      <column caption='mCVR2 (Menu/List)' datatype='real' name='[Calculation_1085086057257308160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_shop_menu_loaded])/SUM([count_of_shop_list_loaded])' />
      </column>
      <column caption='mCVR3 (Checkout/Menu)' datatype='real' name='[Calculation_1085086057257553921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_checkout_loaded])/SUM([count_of_shop_menu_loaded])' />
      </column>
      <column caption='mCVR4 (Transaction/Checkout)' datatype='real' name='[Calculation_1085086057257742338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_transaction])/SUM([count_of_checkout_loaded])' />
      </column>
      <column caption='Offline Hour %' datatype='real' name='[Calculation_1085086057257934851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unavailable_seconds])/SUM([scheduled_open_seconds])' />
      </column>
      <column caption='Latest Date' datatype='date' name='[Calculation_1408289713789448192]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([created_date_local])' />
      </column>
      <column caption='Same Weekday Last week' datatype='date' name='[Calculation_1408289713790689281]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;,-1,[Calculation_1408289713789448192]))' />
      </column>
      <column caption='Yesterday&apos;s Order' datatype='integer' name='[Calculation_1408289713792221186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [created_date_local] = TODAY() -1 THEN [successful_orders] END)' />
      </column>
      <column caption='Order Growth (Compare to Day-2)' datatype='real' name='[Calculation_1408289713794187269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1408289713792221186]-[Yesterday Order (copy)_1408289713793097732])/[Yesterday Order (copy)_1408289713793097732]' />
      </column>
      <column caption='Yesterday' datatype='date' name='[Calculation_1408289713797517321]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 1' />
      </column>
      <column caption='L7D Average Orders' datatype='real' name='[Calculation_1408289713800470538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [created_date_local] &gt;= TODAY() - 7 THEN [successful_orders] END)/COUNTD( IF [created_date_local] &gt;= TODAY() - 7 THEN [created_date_local] END)' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_217861666498306050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Orders&quot; THEN INT(ROUND([Calculation_962644443461222401]))&#13;&#10;WHEN &quot;GFV&quot; THEN [Calculation_1009650787216908291]&#13;&#10;WHEN &quot;AFV&quot; THEN [Calculation_1009650787217080324]&#13;&#10;WHEN &quot;GMV&quot; THEN [Calculation_962644443476983811]&#13;&#10;WHEN &quot;AOV&quot; THEN [Calculation_962644443477229572]&#13;&#10;WHEN &quot;ECR %&quot; THEN [Calculation_827254983128694786]*100&#13;&#10;WHEN &quot;NC Customers&quot; THEN INT(ROUND([Calculation_962644443493888021]))&#13;&#10;WHEN &quot;Active Customers&quot; THEN INT(ROUND([Calculation_962644443493589012]))&#13;&#10;WHEN &quot;VF Subsidy %&quot; THEN [Calculation_962644443478765573]*100&#13;&#10;WHEN &quot;FP Subsidy %&quot; THEN [Calculation_962644443479633926]*100&#13;&#10;WHEN &quot;ICRev %&quot; THEN [Calculation_827254981830930432]*100&#10;WHEN &quot;ICPGMV %&quot; THEN [ICRev % (copy)_5906611682202292224]*100&#13;&#10;WHEN &quot;Voucher Used Orders %&quot; THEN [Calculation_827254981833777153]*100&#13;&#10;WHEN &quot;Order Frequency&quot; THEN [Calculation_962644443481391111]&#13;&#10;WHEN &quot;Vendor Cancellation %&quot; THEN [Calculation_962644443483451402]*100&#13;&#10;WHEN &quot;Actual Prep Time&quot; THEN [Calculation_962644443485261835]&#13;&#10;WHEN &quot;Delivery Time&quot; THEN [Calculation_962644443486035982]&#13;&#10;WHEN &quot;Food Rating&quot; THEN [Calculation_962644443487023120]&#13;&#10;WHEN &quot;Packaging Rating&quot; THEN [Calculation_962644443487146001]&#13;&#10;WHEN &quot;AVC&quot; THEN [Calculation_5179843272491737088]&#10;WHEN &quot;EPT&quot; THEN [Calculation_962644443485577228]&#10;WHEN &quot;Offline Hour %&quot; THEN [Calculation_1085086057257934851]*100&#13;&#10;END' />
      </column>
      <column caption='AVC' datatype='real' name='[Calculation_5179843272491737088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([at_vendor_cleaned_time_in_minute])' />
      </column>
      <column caption='ICRev %' datatype='real' name='[Calculation_827254981830930432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((&#13;&#10;SUM(IFNULL([discount_value_foodpanda_funded],0)) &#13;&#10;+ SUM(IFNULL([voucher_value_foodpanda_funded],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IFNULL([commission_ammount],0))&#13;&#10;+SUM(IFNULL([Delivery_fee],0))&#13;&#10;),0)' />
      </column>
      <column caption='Voucher Used order %' datatype='real' name='[Calculation_827254981833777153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF  [voucher_value_local] &gt; 0 THEN [successful_orders]&#13;&#10;    ELSE NULL &#13;&#10;END&#13;&#10;)/COUNT([successful_orders])' />
      </column>
      <column caption='ECR %' datatype='real' name='[Calculation_827254983128694786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([commission_ammount],0))/SUM(IFNULL([gfv_for_ecr],0))' />
      </column>
      <column caption='OGV' datatype='integer' name='[Calculation_8406672403654877209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [successful_orders] &lt;&gt; &quot;Null&quot;&#10;    THEN [vendor_code]&#10;END )' />
      </column>
      <column caption='Dynamic Date Filters' datatype='string' name='[Calculation_962644443455037440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Week&quot; THEN [week_year]&#13;&#10;WHEN &quot;Day&quot; then [created_date_local (copy)_3029233743626715136]&#13;&#10;WHEN &quot;Month&quot; THEN [month_number]&#13;&#10;END' />
      </column>
      <column caption='Successful Orders' datatype='real' name='[Calculation_962644443461222401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(COUNTD([successful_orders]))' />
      </column>
      <column caption='Per Day Orders' datatype='real' name='[Calculation_962644443462479874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([successful_orders])/COUNTD([created_date_local])' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_962644443476983811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GMV_successful_orders])' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_962644443477229572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GMV_successful_orders])/COUNTD([successful_orders])' />
      </column>
      <column caption='VF Subsidy %' datatype='real' name='[Calculation_962644443478765573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([discount_value_vendor_funded],0))+SUM(IFNULL([voucher_value_vendor_funded],0)))/SUM([GMV_successful_orders])' />
      </column>
      <column caption='FP Subsidy %' datatype='real' name='[Calculation_962644443479633926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([discount_value_foodpanda_funded],0))+SUM(IFNULL([voucher_value_foodpanda_funded],0)))/SUM([GMV_successful_orders])' />
      </column>
      <column caption='Order Frequency' datatype='real' name='[Calculation_962644443481391111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([successful_orders])/countd([active_customers])' />
      </column>
      <column caption='Logistics %' datatype='real' name='[Calculation_962644443482537992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([logistics_cancelled_orders])/countd([total_order])' />
      </column>
      <column caption='Customer %' datatype='real' name='[Calculation_962644443482832905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([customer_cancelled_orders])/countd([total_order])' />
      </column>
      <column caption='Vendor %' datatype='real' name='[Calculation_962644443483451402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([vendor_cancelled_orders])/countd([total_order])' />
      </column>
      <column caption='Assumed Actual' datatype='real' name='[Calculation_962644443485261835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([assumed_actual_prep_time])' />
      </column>
      <column caption='EPT' datatype='real' name='[Calculation_962644443485577228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([estimated_prep_time])' />
      </column>
      <column caption='Updated' datatype='real' name='[Calculation_962644443485794317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([updated_prep_time])' />
      </column>
      <column caption='Delivery Time' datatype='real' name='[Calculation_962644443486035982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([DT])' />
      </column>
      <column caption='% Order with DT &gt; 45 mins' datatype='real' name='[Calculation_962644443486384143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF DT &gt;= 45 THEN [successful_orders] ELSE NULL END)/COUNTD([successful_orders])' />
      </column>
      <column caption='Food Rating' datatype='real' name='[Calculation_962644443487023120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([restaurant_food_rating])' />
      </column>
      <column caption='Packaging Rating' datatype='real' name='[Calculation_962644443487146001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([packaging_rating])' />
      </column>
      <column caption='Rider Rating' datatype='real' name='[Calculation_962644443487399954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([rider_rating])' />
      </column>
      <column caption='Punctuality Rating' datatype='real' name='[Calculation_962644443487490067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([punctuality_rating])' />
      </column>
      <column caption='Active Customer (EC+NC)' datatype='integer' name='[Calculation_962644443493589012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(ROUND(COUNTD([active_customers])))' />
      </column>
      <column caption='NC' datatype='integer' name='[Calculation_962644443493888021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(COUNTD([new_customers]))' />
      </column>
      <column caption='Selected Granularity' datatype='string' name='[Calculation_962644443528118302]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Concept Type&quot; THEN [concepts_type]&#13;&#10;WHEN &quot;Kitchen Name&quot; THEN [kitchen_name]&#13;&#10;WHEN &quot;Chain Name&quot; THEN [chain_name]&#13;&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#13;&#10;WHEN &quot;Chain Name&quot; THEN [chain_name]&#13;&#10;WHEN &quot;Concept Operator Name&quot; THEN [concept_operator_name]&#10;WHEN &quot;Primary Zone Name&quot; THEN [primary_zone_name]&#10;WHEN &quot;City&quot; THEN [lg_city_name]&#10;ELSE &quot;Overall&quot;&#13;&#10;END' />
      </column>
      <column datatype='real' name='[DT]' role='measure' type='quantitative' />
      <column caption='Last week same weekday' datatype='integer' name='[Day-2 Orders (copy)_1408289713795788807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [created_date_local] = TODAY() -8 THEN [successful_orders] END)' />
      </column>
      <column caption='GFV (€)' datatype='real' name='[GFV (copy)_2036471519937359873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GFV_successful_orders]/[fx_rate_eur])' />
      </column>
      <column caption='GMV (€)' datatype='real' name='[GMV (copy)_2036471519936983040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GMV_successful_orders]/[fx_rate_eur])' />
      </column>
      <column caption='iCGMV %' datatype='real' name='[ICRev % (copy)_5906611682202292224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((&#13;&#10;SUM(IFNULL([discount_value_foodpanda_funded],0)) &#13;&#10;+ SUM(IFNULL([voucher_value_foodpanda_funded],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IFNULL([GMV_successful_orders],0))&#13;&#10;),0)' />
      </column>
      <column caption='L4W Same weekdays Avg daily Orders' datatype='real' name='[L7D Average Orders (copy)_1408289713801441292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [created_date_local] = TODAY() - 8 THEN [successful_orders]&#10;      ELSEIF [created_date_local] = TODAY() - 15 THEN [successful_orders]&#10;      ELSEIF [created_date_local] = TODAY() - 22 THEN [successful_orders]&#10;      ELSEIF [created_date_local] = TODAY() - 29 THEN [successful_orders]&#10;        END)/&#10;COUNTD(IF [created_date_local] = TODAY() - 8 THEN [created_date_local]&#10;      ELSEIF [created_date_local] = TODAY() - 15 THEN [created_date_local]&#10;      ELSEIF [created_date_local] = TODAY() - 22 THEN [created_date_local]&#10;      ELSEIF [created_date_local] = TODAY() - 29 THEN [created_date_local]&#10;        END)' />
      </column>
      <column caption='Order Growth (Compare to LW same Weekday)' datatype='real' name='[Order Growth (Compare to Day-2) (copy)_1408289713796227080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1408289713792221186]-[Day-2 Orders (copy)_1408289713795788807])/[Day-2 Orders (copy)_1408289713795788807]' />
      </column>
      <column caption='Order Growth (Compare to L7D orders)' datatype='real' name='[Order Growth (Compare to LW same Weekday) (copy)_1408289713800957963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1408289713792221186]-[Calculation_1408289713800470538])/[Calculation_1408289713800470538]' />
      </column>
      <column caption='Order Growth (Compare to L4W same Weekdays)' datatype='real' name='[Order Growth (Compare to LW same Weekday) (copy)_1408289713803923469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1408289713792221186]-[L7D Average Orders (copy)_1408289713801441292])/[L7D Average Orders (copy)_1408289713801441292]' />
      </column>
      <column caption='Vendor Cancellation %' datatype='real' name='[Vendor % (copy)_2621657978874753028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([vendor_cancelled_orders])/countd([total_order])' />
      </column>
      <column caption='Day-2 Orders' datatype='integer' name='[Yesterday Order (copy)_1408289713793097732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [created_date_local] = TODAY() -2 THEN [successful_orders] END)' />
      </column>
