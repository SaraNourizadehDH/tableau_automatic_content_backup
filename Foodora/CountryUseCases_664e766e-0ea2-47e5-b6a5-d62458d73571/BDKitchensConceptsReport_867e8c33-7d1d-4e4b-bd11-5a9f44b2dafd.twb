            <column caption='KPI %' datatype='string' default-format='p0.00%' name='[negative KPI % (copy)_1427641098694832129]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((ZN([Calculation_171699751553228805]) - LOOKUP(ZN([Calculation_171699751553228805]), 1)) / ABS(LOOKUP(ZN([Calculation_171699751553228805]), 1)))&lt;0 &#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSEIF((ZN([Calculation_171699751553228805]) - LOOKUP(ZN([Calculation_171699751553228805]), 1)) / ABS(LOOKUP(ZN([Calculation_171699751553228805]), 1)))&gt;0 &#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;No Change&quot;&#13;&#10;END'>
