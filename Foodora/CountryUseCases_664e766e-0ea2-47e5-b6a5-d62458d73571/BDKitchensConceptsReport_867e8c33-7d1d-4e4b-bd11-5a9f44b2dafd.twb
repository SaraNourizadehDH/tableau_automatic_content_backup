            <column caption='iCGMV %' datatype='real' name='[ICRev % (copy)_5906611682202292224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#13;&#10;SUM(IFNULL([discount_value_foodpanda_funded],0)) &#13;&#10;+ SUM(IFNULL([voucher_value_foodpanda_funded],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IFNULL([GMV_successful_orders],0))&#13;&#10;),0)' />
