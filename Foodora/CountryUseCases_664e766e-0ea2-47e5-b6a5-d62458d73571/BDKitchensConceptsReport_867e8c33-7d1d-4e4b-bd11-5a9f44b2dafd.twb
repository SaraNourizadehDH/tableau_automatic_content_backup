              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o3xm5u1s1exbo17iufw21lpni0t'>
            <column caption='% Order with Vendor Late &gt; 10 mins' datatype='real' name='[Calculation_1009650787226685448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([vendor_lateness_10_min_or_more])/COUNT([successful_orders])' />
            </column>
            <column caption='Dynamic Date Filters' datatype='string' name='[Calculation_962644443455037440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Week&quot; THEN [week_year]&#13;&#10;WHEN &quot;Day&quot; then [created_date_local (copy)_3029233743626715136]&#13;&#10;WHEN &quot;Month&quot; THEN [month_number]&#13;&#10;END' />
            </column>
            <column caption='Food Rating' datatype='real' name='[Calculation_962644443487023120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([restaurant_food_rating])' />
            </column>
            <column caption='Packaging Rating' datatype='real' name='[Calculation_962644443487146001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([packaging_rating])' />
