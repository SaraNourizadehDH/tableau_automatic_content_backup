    <datasource caption='Disco Voucher Cohorts' inline='true' name='federated.1fiu0nq0pqdy9z1h13z6k0m9etqy' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1tzcfsp1kfw9e81h0rij91gesq3p'>
            <connection CATALOG='damejidlo-cz-bigquery' EXECCATALOG='damejidlo-cz-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='damejidlo-cz-bigquery' schema='analyses' server-oauth='' username='jakub.rajnis@foodora.cz' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1tzcfsp1kfw9e81h0rij91gesq3p' name='Custom SQL Query' type='text'>with prep AS &#13;
  (SELECT&#13;
  date_trunc(created_date_local, month) as month,&#13;
  analytical_customer_id,&#13;
  count(case when voucher_code = &quot;extrasleva&quot; then order_code end) as disco_orders,&#13;
  sum(case when voucher_code = &quot;extrasleva&quot; then gfv_local end) as disco_gfv,&#13;
  sum(case when voucher_code = &quot;extrasleva&quot; then user_paid_gmv_local end) as disco_gmv,&#13;
  count(order_code) as total_orders,&#13;
  sum(gfv_local) as total_gfv,&#13;
  sum(user_paid_gmv_local) as total_gmv,&#13;
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`&#13;
  WHERE global_entity_id = &quot;DJ_CZ&quot;&#13;
  AND created_date_local &gt;&gt;= &quot;2025-01-01&quot;&#13;
  AND is_successful&#13;
  GROUP BY ALL)&#13;
SELECT&#13;
month,&#13;
disco_orders,&#13;
count(distinct analytical_customer_id) as unique_customers,&#13;
sum(disco_gfv)/sum(disco_orders) as disco_afv,&#13;
sum(disco_gmv)/sum(disco_orders) as disco_aov,&#13;
sum(total_gfv)/sum(total_orders) as total_afv,&#13;
sum(total_gmv)/sum(total_orders) as total_aov&#13;
FROM prep&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1tzcfsp1kfw9e81h0rij91gesq3p' name='Custom SQL Query' type='text'>with prep AS &#13;
  (SELECT&#13;
  date_trunc(created_date_local, month) as month,&#13;
  analytical_customer_id,&#13;
  count(case when voucher_code = &quot;extrasleva&quot; then order_code end) as disco_orders,&#13;
  sum(case when voucher_code = &quot;extrasleva&quot; then gfv_local end) as disco_gfv,&#13;
  sum(case when voucher_code = &quot;extrasleva&quot; then user_paid_gmv_local end) as disco_gmv,&#13;
  count(order_code) as total_orders,&#13;
  sum(gfv_local) as total_gfv,&#13;
  sum(user_paid_gmv_local) as total_gmv,&#13;
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`&#13;
  WHERE global_entity_id = &quot;DJ_CZ&quot;&#13;
  AND created_date_local &gt;&gt;= &quot;2025-01-01&quot;&#13;
  AND is_successful&#13;
  GROUP BY ALL)&#13;
SELECT&#13;
month,&#13;
disco_orders,&#13;
count(distinct analytical_customer_id) as unique_customers,&#13;
sum(disco_gfv)/sum(disco_orders) as disco_afv,&#13;
sum(disco_gmv)/sum(disco_orders) as disco_aov,&#13;
sum(total_gfv)/sum(total_orders) as total_afv,&#13;
sum(total_gmv)/sum(total_orders) as total_aov&#13;
FROM prep&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
