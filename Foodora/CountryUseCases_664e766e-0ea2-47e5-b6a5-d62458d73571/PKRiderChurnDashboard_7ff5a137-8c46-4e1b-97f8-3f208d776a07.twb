              <calculation class='tableau' formula='(SUM([churned_riders (country_PK_rider_churn)])/ &#10;(&#10;SUM([churned_riders (country_PK_rider_churn)]) +&#10;SUM([active_riders_l4w (country_PK_rider_churn)])&#10;))' />
            </column>
            <column caption='Net Churn' datatype='integer' name='[Calculation_5660180307726618629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churned_riders (country_PK_rider_churn)])- SUM([reactivated_riders (country_PK_rider_churn)])' />
            </column>
            <column caption='Reactivation %' datatype='real' default-format='p0.00%' name='[Calculation_5660180307735326728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([reactivated_riders (country_PK_rider_churn)])/ &#10;(&#10;SUM([active_riders_l4w (country_PK_rider_churn)])&#10;))' />
