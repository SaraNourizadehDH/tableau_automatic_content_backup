      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_122B15E75A2742CC835418620861C915'>
            <properties context=''>
              <relation connection='bigquery.08at7q21iisklw1by25rc1k5bjlo' name='Custom SQL Query' type='text'>WITH base_weekly AS (
 SELECT
    rider_id,
    DATE_TRUNC(report_date_local, WEEK(MONDAY)) AS report_week,
    
    -- Latest city name in the week
    ARRAY_AGG(city_name ORDER BY report_date_local DESC)[OFFSET(0)] AS city_name,
    
    -- Use MAX for weekly active status (if active on any day, it&apos;s active)
    MAX(is_active) AS is_active_week,
    MAX(is_churned) AS is_churned_week,
    MAX(is_reactivated) AS is_reactivated_week,

    -- Sum totals across the week
    SUM(IFNULL(total_working_time_in_minutes, 0)) AS total_working_time_in_minutes,
    SUM(IFNULL(completed_delivery_count, 0)) AS completed_orders,
    SUM(IFNULL(total_rider_earnings_local, 0)) AS total_rider_earnings_local,
    
    -- Get latest days since last active
    ARRAY_AGG(days_since_last_active ORDER BY report_date_local DESC)[OFFSET(0)] AS days_since_last_active
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_rider_metrics`
  WHERE country_name = &quot;Pakistan&quot;
    AND report_date_local &gt;&gt;= &quot;2025-01-01&quot;
  GROUP BY rider_id, report_week
),

-- Deduplicate to the latest row per rider per week
-- weekly_deduped AS (
--   SELECT *,
--          ROW_NUMBER() OVER (PARTITION BY rider_id, report_week ORDER BY report_date_local DESC) AS row_num
--   FROM base_weekly
-- ),

-- Aggregate weekly status for all riders (including inactive ones)
weekly_activity_status AS (
  SELECT
    *
  FROM base_weekly
  -- LEFT JOIN weekly_deduped AS d
  -- ON base_weekly.rider_id = d.rider_id AND base_weekly.report_week = d.report_week
  -- AND d.row_num = 1
  GROUP BY ALL
),

-- Assign inactivity cohorts based on inactivity period for all riders
inactivity_cohorts AS (
  SELECT
    DISTINCT
    rider_id,
    report_week,
    CASE
      WHEN days_since_last_active BETWEEN 0 AND 7 THEN &apos;0-7 Days&apos;
      WHEN days_since_last_active BETWEEN 8 AND 14 THEN &apos;8-14 Days&apos;
      WHEN days_since_last_active BETWEEN 15 AND 21 THEN &apos;15-21 Days&apos;
      WHEN days_since_last_active BETWEEN 22 AND 28 THEN &apos;22-28 Days&apos;
      ELSE &apos;Inactive &gt;&gt; 28 Days&apos;
    END AS inactivity_cohort
   FROM (
    SELECT DISTINCT rider_id, report_week, days_since_last_active
    FROM weekly_activity_status
  )
),

-- Get next week&apos;s activity for these active riders
next_week_activity AS (
  SELECT
    a.rider_id,
    a.city_name,
    a.report_week AS current_week,
    a.is_active_week,
    DATE_ADD(a.report_week, INTERVAL 7 DAY) AS next_week,
    b.is_active_week AS is_active_next_week,
    b.total_working_time_in_minutes AS next_working_minutes,
    b.completed_orders AS next_orders,
    b.total_rider_earnings_local AS next_earnings,
    SAFE_DIVIDE(b.total_rider_earnings_local, b.total_working_time_in_minutes / 60) AS next_eph
  FROM weekly_activity_status a
  LEFT JOIN weekly_activity_status b
    ON a.rider_id = b.rider_id
    AND b.report_week = DATE_ADD(a.report_week, INTERVAL 7 DAY)
),

-- Calculate lost metrics for the next week, including total lost hours for inactive riders
lost_metrics_for_next_week AS (
  SELECT
    rider_id,
    city_name,
    current_week,
    next_week,
    is_active_week,
    is_active_next_week,
    next_working_minutes,
    next_orders,
    next_earnings,
    next_eph,
    -- Calculate lost working hours for the next week only if the rider becomes inactive
    CASE 
      WHEN is_active_next_week = FALSE THEN next_working_minutes 
      ELSE 0
    END AS lost_working_hours_next_week,
    CASE 
      WHEN is_active_next_week = FALSE THEN next_earnings 
      ELSE 0 
    END AS lost_earnings_next_week,
    CASE 
      WHEN is_active_next_week = FALSE THEN next_orders
      ELSE 0 
    END AS lost_orders_next_week
  FROM next_week_activity
),

-- Combine cohorts with current activity for a given week
inactive_percentage_for_current_week AS (
  SELECT
    current_week AS report_week,
    city_name,
    inactivity_cohort,
    
    -- Count of all riders in the current week (whether active or inactive)
    COUNT(DISTINCT CASE WHEN  a.is_active_week = FALSE THEN c.rider_id END) AS total_riders_current_week,
    
    -- Count of active riders for the current week
    COUNT(DISTINCT CASE WHEN a.is_active_week = TRUE THEN a.rider_id END) AS active_riders_current_week,
    
    -- Count of riders who became inactive in the next week
    COUNT(DISTINCT CASE WHEN a.is_active_next_week = FALSE AND a.is_active_week = TRUE THEN a.rider_id END) AS inactive_riders_next_week,
    
    -- Inactive percentage for the current week
    SAFE_DIVIDE(
      COUNT(DISTINCT CASE WHEN a.is_active_next_week = FALSE THEN a.rider_id END),
      COUNT(DISTINCT c.rider_id)
    ) AS inactive_pct_current_week,
    
    -- Lost working hours for the next week (for riders who became inactive)
    SUM(CASE WHEN a.is_active_next_week = FALSE THEN lost_working_hours_next_week END) / 60 AS lost_working_hours_next_week,
    SUM(CASE WHEN a.is_active_next_week = FALSE THEN lost_orders_next_week END) AS lost_orders_next_week,
    
    -- Lost earnings for the next week (for riders who became inactive)
    SUM(CASE WHEN a.is_active_next_week = FALSE THEN lost_earnings_next_week END) AS lost_earnings_next_week
  FROM lost_metrics_for_next_week a
  LEFT JOIN inactivity_cohorts c
    ON a.rider_id = c.rider_id
    AND a.current_week = c.report_week
  GROUP BY current_week, city_name, inactivity_cohort
)
SELECT
  report_week,
  city_name,
  inactivity_cohort,
  total_riders_current_week,
  active_riders_current_week,
  inactive_riders_next_week,
  inactive_pct_current_week,
  lost_working_hours_next_week,
  lost_orders_next_week
FROM inactive_percentage_for_current_week
ORDER BY city_name, report_week, inactivity_cohort</relation>
            </properties>
