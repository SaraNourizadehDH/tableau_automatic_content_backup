      <aliases enabled='yes' />
      <column caption='Inactive %' datatype='real' default-format='p0.00%' name='[Calculation_5660180308025339928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inactive_riders_next_week])/SUM([active_riders_current_week])' />
