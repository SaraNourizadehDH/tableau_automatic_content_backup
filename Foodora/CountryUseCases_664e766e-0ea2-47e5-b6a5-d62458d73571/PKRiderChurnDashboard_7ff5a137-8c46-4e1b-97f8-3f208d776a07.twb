      <column caption='Churn Rate %' datatype='real' default-format='p0.00%' name='[Calculation_5660180307724886017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([churned_riders (country_PK_rider_churn)])/ &#10;(&#10;SUM([churned_riders (country_PK_rider_churn)]) +&#10;SUM([active_riders_l4w (country_PK_rider_churn)])&#10;))' />
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_5660180307725889538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Net Churn' datatype='integer' name='[Calculation_5660180307726618629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([churned_riders (country_PK_rider_churn)])- SUM([reactivated_riders (country_PK_rider_churn)])' />
      </column>
      <column caption='Churn % Flag' datatype='integer' name='[Calculation_5660180307727880198]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Activated Week Select (copy 2)] = &apos;On&apos; THEN &#10;    IF ZN([Calculation_5660180307724886017]) - LOOKUP(ZN([Calculation_5660180307724886017]), -1) &gt; &#10;       0.1 * LOOKUP(ZN([Calculation_5660180307724886017]), -1) THEN 1&#10;    ELSE 0&#10;    END&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Churn Rate % Change' datatype='real' name='[Calculation_5660180307734474759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_5660180307724886017]) - LOOKUP(ZN([Calculation_5660180307724886017]), -1)) / LOOKUP(ZN([Calculation_5660180307724886017]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Reactivation %' datatype='real' default-format='p0.00%' name='[Calculation_5660180307735326728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([reactivated_riders (country_PK_rider_churn)])/ &#10;(&#10;SUM([active_riders_l4w (country_PK_rider_churn)])&#10;))' />
      </column>
      <column caption='View Date filter' datatype='boolean' name='[Calculation_5660180308037021722]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [view_type (country_PK_rider_churn)]&#10;  WHEN &apos;Monthly&apos; THEN&#10;    DATEDIFF(&apos;month&apos;, [date_local], TODAY()) &lt;= 3&#10;  WHEN &apos;Weekly&apos; THEN&#10;    DATEDIFF(&apos;week&apos;, [date_local], TODAY()) &lt;= 12&#10;  ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='City Name' datatype='string' name='[Calculation_5660180308816195611]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([active_riders_l4w (country_PK_rider_churn)]) &gt; 0 THEN ([city_name (country_PK_rider_churn)]) END' />
      </column>
      <column caption='Week' datatype='date' name='[Calculation_5660180308817031196]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Calculation_5660180307725889538]&#10;    WHEN &quot;Weekly&quot; THEN&#10;        MAKEDATE(&#10;            INT(LEFT([date (country_PK_rider_churn)], 4)),  // Extract Year (YYYY)&#10;            1,  // Start with January for Weekly granularity&#10;            (INT(RIGHT([date (country_PK_rider_churn)], 2)) - 1) * 7 + 1  // Calculate the first day of the week&#10;        ) &#10;        - DATEPART(&apos;weekday&apos;, MAKEDATE(INT(LEFT([date (country_PK_rider_churn)], 4)), 1, 1)) + 2&#10;        // Adjust to the desired weekday (Monday in this case, which is +2)&#10;    ELSE&#10;        NULL  // Default for other cases&#10;END' />
      </column>
      <column caption='Date ' datatype='date' default-format='*m/d/yyyy' name='[Calculation_6224819116961062917]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Calculation_5660180307725889538]&#10;    WHEN &quot;Monthly&quot; THEN ([date_local])&#10;    WHEN &quot;Weekly&quot; THEN ([date_local])&#10;    ELSE NULL&#10;END' />
      </column>
      <column caption='Net Churn %' datatype='real' default-format='p0.00%' name='[Churn Rate % (copy)_5660180307726401540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5660180307726618629]&#10;/ &#10;(&#10;SUM([churned_riders (country_PK_rider_churn)]) +&#10;SUM([active_riders_l4w (country_PK_rider_churn)])&#10;)' />
      </column>
      <column caption='Reactivated/ Churn %' datatype='real' default-format='p0.00%' name='[Churn Rate % (copy)_5660180307751079945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reactivated_riders (country_PK_rider_churn)])/&#10;SUM([churned_riders (country_PK_rider_churn)])' />
      </column>
      <column caption='Churn Rate % Change (copy)' datatype='real' name='[Churn Rate % Change (copy)_5660180307751337994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Churn Rate % (copy)_5660180307751079945]) - LOOKUP(ZN([Churn Rate % (copy)_5660180307751079945]), -1)) / LOOKUP(ZN([Churn Rate % (copy)_5660180307751079945]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Granularity (copy)' datatype='string' name='[Granularity (copy)_6224819116975923206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='View Date filter (copy)' datatype='boolean' name='[View Date filter (copy)_6224819119412375562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [view_type (country_PK_rider_churn)]&#10;  WHEN &apos;Monthly&apos; THEN&#10;    DATEDIFF(&apos;month&apos;, [date_local], TODAY()) &lt;= 3&#10;  WHEN &apos;Weekly&apos; THEN&#10;    DATEDIFF(&apos;week&apos;, [date_local], TODAY()) &lt;= 6&#10;  ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Week (copy)_5660180308820201503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5660180307725889538] = &quot;Monthly&quot; THEN&#10;   [date (country_PK_rider_churn)] END' />
      </column>
