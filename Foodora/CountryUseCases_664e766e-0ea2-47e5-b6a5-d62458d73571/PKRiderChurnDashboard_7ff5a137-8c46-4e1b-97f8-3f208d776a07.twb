        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Reactivation vs Churn %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='City Level' name='federated.0uu93cd1o7ojfu195ib0e18woscv' />
