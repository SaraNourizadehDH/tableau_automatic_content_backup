            <column datatype='real' name='[corporate_partnership_vouchers_askari]' role='measure' type='quantitative' />
            <column caption='Corporate Partnership Vouchers Hbl25' datatype='real' name='[corporate_partnership_vouchers_hbl25]' role='measure' type='quantitative' />
            <column datatype='real' name='[corporate_partnership_vouchers_master_card]' role='measure' type='quantitative' />
            <column caption='Cost Name' datatype='string' name='[cost_name]' role='dimension' type='nominal' />
            <column caption='Count Of Order' datatype='integer' name='[count_of_order]' role='measure' type='quantitative' />
            <column caption='Cpc Amt' datatype='integer' name='[cpc_amt]' role='measure' type='quantitative' />
            <column caption='Credit Card Fee' datatype='real' name='[credit_card_fee]' role='measure' type='quantitative' />
            <column caption='Customer Loyalty Vouchers' datatype='real' name='[customer_loyalty_vouchers]' role='measure' type='quantitative' />
