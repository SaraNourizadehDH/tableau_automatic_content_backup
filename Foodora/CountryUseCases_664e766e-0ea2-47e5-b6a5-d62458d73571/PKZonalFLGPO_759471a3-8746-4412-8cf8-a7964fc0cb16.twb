            <column caption='Lg Zone Name' datatype='string' name='[lg_zone_name]' role='dimension' type='nominal' />
            <column caption='Loss Delivery Fee Plus Vat Local' datatype='real' name='[loss_delivery_fee_plus_vat_local]' role='measure' type='quantitative' />
            <column-instance column='[Reporting_month]' derivation='MY' name='[my:Reporting_month:ok]' pivot='key' type='ordinal' />
