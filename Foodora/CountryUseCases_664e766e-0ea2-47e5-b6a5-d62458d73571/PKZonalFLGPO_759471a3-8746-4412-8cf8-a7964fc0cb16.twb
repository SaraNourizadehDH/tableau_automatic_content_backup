            <column-instance column='[credit_card_fee]' derivation='Sum' name='[sum:credit_card_fee:qk]' pivot='key' type='quantitative' />
            <column-instance column='[homechef_df_excl_tax]' derivation='Sum' name='[sum:homechef_df_excl_tax:qk]' pivot='key' type='quantitative' />
