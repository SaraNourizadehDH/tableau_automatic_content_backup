    <worksheet name='FLGPO Table Account type (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#e02174' fontsize='12'>Account Level Details</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='FLGPOTableAccounttype2' path='/t/Foodora/workbooks/PKZonalFLGPO' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='country_PK_zonal_pnl_info+ (pandata_report)' name='federated.0inkcos1u0z2oh178b09t0srzl2s' />
          </datasources>
          <datasource-dependencies datasource='federated.0inkcos1u0z2oh178b09t0srzl2s'>
            <column caption='Compensation OTD' datatype='real' name='[Calculation_1357553879175229440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] = &apos;darkstores&apos; THEN 0&#13;&#10;ELSE [compensation_sorry_vouchers]&#13;&#10;END' />
            </column>
            <column caption='Basket Size ' datatype='real' name='[Calculation_1357553879178670081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([commission_base])/sum([count_of_order])' />
            </column>
            <column caption='Orders %' datatype='real' name='[Calculation_1669991103706210306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([count_of_order])/SUM({ FIXED [Reporting_month]: SUM([count_of_order]) }))' />
            </column>
            <column caption='OD Orders' datatype='integer' name='[Calculation_1669991103706546179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(IF LOWER([is_own_delivery]) = &quot;od&quot; THEN [count_of_order] END),0)' />
            </column>
            <column caption='OD Orders %' datatype='real' name='[Calculation_1669991103706677252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF LOWER([is_own_delivery]) = &quot;od&quot; THEN [count_of_order] END)/SUM({ FIXED [Reporting_month]: SUM(IF LOWER([is_own_delivery]) = &quot;od&quot; THEN [count_of_order] END) }))' />
            </column>
            <column caption='GMV PO' datatype='real' name='[Calculation_1669991103706898437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([user_paid_amount])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Commission %' datatype='real' name='[Calculation_1669991103707205638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1934296041680408579])/sum([commission_base])' />
            </column>
            <column caption='Commission Revenue / Order' datatype='real' name='[Calculation_1669991103707365383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([Calculation_1934296041680408579])/SUM([count_of_order]),0)' />
            </column>
            <column caption='DF / Order' datatype='real' name='[Calculation_1669991103707521032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM(IFNULL([Df Excl Tax (copy)_136304281469120513], 0))/([Calculation_1669991103706546179]), 0)' />
            </column>
            <column caption='Joker Fee / Order' datatype='real' name='[Calculation_1669991103707688969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([total_joker_fee])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Service Fee / Order' datatype='real' name='[Calculation_1669991103707799562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([total_service_fee])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Onboarding / Order' datatype='real' name='[Calculation_1669991103708020747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([onboarding_fee_local])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Credit Card Fee / Order' datatype='real' name='[Calculation_1669991103708160012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([credit_card_fee])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Subscription / Order' datatype='real' name='[Calculation_1669991103708291085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([subscription_amount])/SUM([count_of_order]),0)' />
            </column>
            <column caption='CPC / Order' datatype='real' name='[Calculation_1669991103708524558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([cpc_amt])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Customer Loyallty Voucher / Order' datatype='real' name='[Calculation_1669991103708753935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL(SUM([customer_loyalty_vouchers])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Revenue Erossion /Order' datatype='real' name='[Calculation_1669991103709016080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL(SUM([revenue_erosion])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Loss Of Delivery / Order' datatype='real' name='[Calculation_1669991103709229073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL(SUM([loss_delivery_fee_plus_vat_local])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Rider&apos;s Salary / Order' datatype='real' name='[Calculation_1669991103709454354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL(SUM([total_pay])/[Calculation_1669991103706546179],0)' />
            </column>
            <column caption='Cash loss / Order' datatype='real' name='[Calculation_1669991103710171155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL(SUM([cash_loss_amount])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Refund Voucher / Order' datatype='real' name='[Calculation_1669991103734071316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL(SUM([refund_vouchers])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Compensation Voucher / Order' datatype='real' name='[Calculation_1669991103734427669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL(SUM([compensation_sorry_vouchers])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Other Delivery Cost ' datatype='real' name='[Calculation_1669991103735525399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF LOWER([cost_name]) IN (&apos;rider salary - other incentives&apos;,&#13;&#10;&apos;rider bad debt&apos;,&#13;&#10;&apos;delivery oh per order&apos;,&#13;&#10;&apos;sale of delivery bags&apos;,&#13;&#10;&apos;rider equipment&apos;,&#13;&#10;&apos;rider verification&apos;,&#13;&#10;&apos;cash loss pandamart&apos;,&#13;&#10;&apos;dispatch&apos;,&#13;&#10;&apos;fleet management&apos;,&#13;&#10;&apos;rider recruitment&apos;) THEN IFNULL([value_local], 0) END))*IFNULL([Calculation_1669991103706677252], 0)' />
            </column>
            <column caption='Other Delivery Cost/ order' datatype='real' name='[Calculation_1669991103737557018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_1669991103735525399]/sum([count_of_order]),0)' />
            </column>
            <column caption='Cost Of Sale' datatype='real' name='[Calculation_1669991103759355932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF lower([cost_name]) = &quot;cost of sale &quot; THEN [value_local] END)*SUM([count_of_order])' />
            </column>
            <column caption='-SUM(ifnull([Customer Loyalty Vouchers],0))' datatype='real' name='[Calculation_1669991103863951401]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='-SUM(ifnull([customer_loyalty_vouchers],0))' />
            </column>
            <column caption='-SUM(ifnull([Revenue Erosion],0))' datatype='real' name='[Calculation_1669991103864148010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM(ifnull([revenue_erosion],0))' />
            </column>
            <column caption='SUM(ifnull([Onboarding Fee Local],0))' datatype='real' name='[Calculation_1669991103864295467]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='SUM(ifnull([onboarding_fee_local],0))' />
            </column>
            <column caption='-SUM(ifnull([Loss Delivery Fee Plus Vat Local],0))' datatype='real' name='[Calculation_1669991103864877101]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='-SUM(ifnull([loss_delivery_fee_plus_vat_local],0))' />
            </column>
            <column caption='SUM(ifnull([Subscription Amount],0))' datatype='real' name='[Calculation_1669991103865782318]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='SUM(ifnull([subscription_amount],0))' />
            </column>
            <column caption='SUM(ifnull([Cpc Amt],0))' datatype='integer' name='[Calculation_1669991103865942063]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='SUM(ifnull([cpc_amt],0))' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_1669991103866183728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([Calculation_1934296041680408579]), 0) + &#10;IFNULL(SUM([Df Excl Tax (copy)_136304281469120513]), 0) +&#10;IFNULL(SUM([homechef_df_excl_tax]), 0) +&#10;IFNULL(SUM([total_joker_fee]), 0) +&#10;IFNULL(SUM([total_service_fee]), 0) +&#10;IFNULL(SUM([onboarding_fee_local]), 0) +&#10;IFNULL(SUM([credit_card_fee]), 0) +&#10;IFNULL(SUM([MOV_local]), 0) +&#10;IFNULL(SUM([subscription_amount]), 0) +&#10;IFNULL(([Cost Of Sale (copy)_136304281480032258]), 0) -&#10;IFNULL(SUM([customer_loyalty_vouchers]), 0) +&#10;IFNULL(SUM([cpc_amt]), 0) -&#10;IFNULL(SUM([loss_delivery_fee_plus_vat_local]), 0)' />
            </column>
            <column caption='RPO' datatype='real' name='[Calculation_1669991103867031601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([Calculation_1669991103866183728])/SUM([count_of_order]),0)' />
            </column>
            <column caption='-SUM(ifnull([Compensation Sorry Vouchers],0))' datatype='real' name='[Calculation_1669991103869091892]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='-SUM(ifnull([compensation_sorry_vouchers],0))' />
            </column>
            <column caption='Total Cost' datatype='real' name='[Calculation_1669991103869952053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-ifnull(IFNULL(SUM([Total Pay (copy)_918734391583600666]),0) +&#13;&#10;IFNULL(SUM([cash_loss_amount]),0)+&#13;&#10;ifnull(SUM([refund_vouchers]),0) +&#13;&#10;IFNULL(SUM([compensation_sorry_vouchers]),0) -&#13;&#10;IFNULL([Calculation_1669991103735525399],0) -&#13;&#10;IFNULL([Calculation_1669991103759355932],0),0)' />
            </column>
            <column caption='Total Cost / Order' datatype='real' name='[Calculation_1669991103870902326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-IFNULL([Calculation_1669991103869952053]/SUM([count_of_order]),0)' />
            </column>
            <column caption='Cost Of Sale / Order' datatype='real' name='[Calculation_1669991103874416695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_1669991103759355932]/sum([count_of_order]),0)' />
            </column>
            <column caption='-SUM(ifnull([Cash Loss Amount],0))' datatype='real' name='[Calculation_1669991103874928697]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='-SUM(ifnull([cash_loss_amount],0))' />
            </column>
            <column caption='-SUM(IFNULL([Refund Vouchers],0))' datatype='real' name='[Calculation_1669991103875612730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM(IFNULL([refund_vouchers],0))' />
            </column>
            <column caption='Incentive' datatype='real' name='[Calculation_1669991103878701115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-ifnull(sum([foodpanda_discount_excl_ncp] + [ncp_cashback] + [pickup_excl_burn] + [voucher_value] - [customer_loyalty_vouchers] - [corporate_b2b_vouchers] - [pandabox_vouchers] - [corporate_partnership_vouchers] - [corporate_partnership_vouchers_hbl25] - [refund_vouchers]-[corporate_partnership_vouchers_master_card]-[corporate_partnership_vouchers_askari] - [Calculation_1357553879175229440]),0)' />
            </column>
            <column caption='Incentive / Order' datatype='real' name='[Calculation_1669991103879745596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_1669991103878701115]/SUM([count_of_order]),0)' />
            </column>
            <column caption='Gross Profit' datatype='real' name='[Calculation_1669991103880048701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1669991103866183728] + [Calculation_1669991103869952053]' />
            </column>
            <column caption='Gross Profit / Order' datatype='real' name='[Calculation_1669991103880319038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1669991103880048701] / SUM([count_of_order])' />
            </column>
            <column caption='-IFNULL([Total Cost / Order],0)' datatype='real' name='[Calculation_1669991103880589375]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='-IFNULL([Calculation_1669991103870902326],0)' />
            </column>
            <column caption='FLGP' datatype='real' name='[Calculation_1669991103881162816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1669991103880048701] + ([Calculation_1669991103878701115])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_1669991103882788930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1669991103881162816]/SUM([count_of_order])' />
            </column>
            <column caption='ifnull([OD Orders %],0)' datatype='real' name='[Calculation_1669991103905820743]' role='measure' type='quantitative' user:unnamed='FLGPO Table'>
              <calculation class='tableau' formula='ifnull([Calculation_1669991103706677252],0)' />
            </column>
            <column caption='space_cross_charge' datatype='real' name='[Calculation_1934296041675825153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL( if [vertical] = &apos;Spaces&apos; then ([commission_base])*0.0674 END,0)' />
            </column>
            <column caption='CR' datatype='real' name='[Calculation_1934296041680408579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Commission Revenue (copy)_1934296041654734848] -IFNULL([revenue_erosion],0)' />
            </column>
            <column caption='-SUM(ifnull([Total Pay (copy)],0))' datatype='real' name='[Calculation_918734391584690203]' role='measure' type='quantitative' user:unnamed='FLGPO Table Vertical Level'>
              <calculation class='tableau' formula='-SUM(ifnull([Total Pay (copy)_918734391583600666],0))' />
            </column>
            <column caption='Commission Revenue - net cross charged' datatype='real' name='[Commission Revenue (copy)_1934296041654734848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2024-11-01# THEN &#10;    [count_of_order] * 112.69&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] &gt;= #2024-09-01# AND [Reporting_month] &lt;= #2024-10-01# THEN &#10;    [count_of_order] * 108&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] &gt;= #2024-04-01# AND [Reporting_month] &lt;= #2024-08-01# THEN &#10;    [count_of_order] * 102&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2024-01-01# THEN &#10;    [count_of_order] * 84.16&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2024-02-01# THEN &#10;    [count_of_order] * 94.16&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2024-03-01# THEN &#10;    [count_of_order] * 88.08&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2024-12-01# THEN &#10;    [count_of_order] * 108&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2025-01-01# THEN &#10;    [count_of_order] * 114.14&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2025-02-01# THEN &#10;    [count_of_order] * 115.18&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2025-03-01# THEN &#10;    [count_of_order] * 120.55&#10;ELSEIF [vertical] = &apos;darkstores&apos; AND [Reporting_month] = #2025-04-01# THEN &#10;    [count_of_order] * 45.00&#10;ELSE &#10;    [commission_revenue] - [Calculation_1934296041675825153]&#10;END' />
            </column>
            <column caption='Display Adds Revenue' datatype='real' name='[Cost Of Sale (copy)_136304281480032258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;    SUM(&#10;        IF ([cost_name]) = &quot;Display Ads (RLP)&quot; THEN [value_local] END&#10;    ) * SUM([count_of_order]),&#10;    0&#10;)' />
            </column>
            <column caption='MOV Fee / Order' datatype='real' name='[Credit Card Fee / Order (copy)_1357553879180222467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([MOV_local])/SUM([count_of_order]),0)' />
            </column>
            <column caption='Df Excl Tax (copy)' datatype='real' name='[Df Excl Tax (copy)_136304281469120513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] = &apos;darkstores&apos; THEN &#10;    IF [Reporting_month] = #2024-11-01# THEN &#10;        [count_of_order] * 124.55&#10;    ELSEIF [Reporting_month] &gt;= #2024-08-01# AND [Reporting_month] &lt;= #2024-10-01# THEN &#10;        [count_of_order] * 121.55&#10;    ELSEIF [Reporting_month] &gt;= #2024-01-01# AND [Reporting_month] &lt;= #2024-02-01# THEN &#10;        [count_of_order] * 111.55&#10;    ELSEIF [Reporting_month] = #2024-03-01# THEN &#10;        [count_of_order] * 114.55&#10;    ELSEIF [Reporting_month] = #2024-04-01# THEN &#10;        [count_of_order] * 124.55&#10;    ELSEIF [Reporting_month] = #2024-05-01# THEN &#10;        [count_of_order] * 116.06&#10;    ELSEIF [Reporting_month] = #2024-06-01# THEN &#10;        [count_of_order] * 118&#10;    ELSEIF [Reporting_month] = #2024-07-01# THEN &#10;        [count_of_order] * 125&#10;    ELSEIF [Reporting_month] = #2024-12-01# THEN &#10;        [count_of_order] * 125.12&#10;    ELSEIF [Reporting_month] = #2025-01-01# THEN &#10;        [count_of_order] * 127.37&#10;    ELSEIF [Reporting_month] = #2025-02-01# THEN &#10;        [count_of_order] * 130.53&#10;    ELSEIF [Reporting_month] = #2025-03-01# THEN &#10;        [count_of_order] * 114.60&#10;    ELSEIF [Reporting_month] = #2025-04-01# THEN &#10;        [count_of_order] * 130.00&#10;    ELSE &#10;        [df_excl_tax]&#10;    END&#10;ELSE &#10;    [df_excl_tax]&#10;END' />
            </column>
            <column datatype='real' name='[MOV_local]' role='measure' type='quantitative' />
            <column caption='Reporting month' datatype='date' name='[Reporting_month]' role='dimension' type='ordinal' />
            <column caption='Total Pay (copy)' datatype='real' name='[Total Pay (copy)_918734391583600666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] = &apos;Restaurant VD&apos; OR [vertical] = &apos;Restaurant PU&apos; OR [is_own_delivery] = &apos;PU&apos; or [is_own_delivery] = &apos;PU&apos; THEN 0 ELSE [total_pay] END' />
            </column>
