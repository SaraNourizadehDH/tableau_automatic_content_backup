            <column caption='Lg City' datatype='string' name='[lg_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[lg_region_name]' role='dimension' type='nominal' />
            <column caption='Lg Zone Name' datatype='string' name='[lg_zone_name]' role='dimension' type='nominal' />
            <column caption='Loss Delivery Fee Plus Vat Local' datatype='real' name='[loss_delivery_fee_plus_vat_local]' role='measure' type='quantitative' />
            <column-instance column='[Reporting_month]' derivation='MY' name='[my:Reporting_month:ok]' pivot='key' type='ordinal' />
            <column caption='Ncp Cashback' datatype='real' name='[ncp_cashback]' role='measure' type='quantitative' />
            <column-instance column='[Reporting_month]' derivation='None' name='[none:Reporting_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[account_type]' derivation='None' name='[none:account_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[cost_name]' derivation='None' name='[none:cost_name:nk]' pivot='key' type='nominal' />
