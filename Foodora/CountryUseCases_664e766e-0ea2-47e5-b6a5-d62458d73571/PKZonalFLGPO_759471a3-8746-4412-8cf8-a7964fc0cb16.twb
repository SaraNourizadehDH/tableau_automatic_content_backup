            <column-instance column='[lg_city]' derivation='None' name='[none:lg_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[lg_region_name]' derivation='None' name='[none:lg_region_name:nk]' pivot='key' type='nominal' />
