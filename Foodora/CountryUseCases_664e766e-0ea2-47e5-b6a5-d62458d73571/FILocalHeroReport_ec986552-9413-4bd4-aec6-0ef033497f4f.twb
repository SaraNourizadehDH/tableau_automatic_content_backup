      <table>
        <view>
          <datasources>
            <datasource caption='report_local_hero (bl_bi)' name='federated.18s6qic08ldxwl17v1y4x186eph3' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='date_para' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18s6qic08ldxwl17v1y4x186eph3'>
            <column caption='Report Month ' datatype='string' name='[Calculation_239887104369876993]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([report_month])' />
            </column>
            <column caption='Date Drill Down (+)' datatype='string' name='[Calculation_239887104371875842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Vendor Drill Down' datatype='string' name='[Calculation_239887104374255619]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='% NCR of GMV' datatype='real' name='[Calculation_239887104379805700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([joker_revenue]) + SUM([cpc_revenue]))&#10;/&#10;SUM([gmv_user_paid])' />
            </column>
            <column caption='% Commission' datatype='real' name='[Calculation_239887104380006405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue])/SUM([commission_base])' />
            </column>
            <column caption='Vendor Take Rate' datatype='real' name='[Calculation_239887104380096518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_239887104380006405] + [Calculation_6616350857063456778] + [Calculation_239887104379805700]' />
            </column>
            <column caption='% Pickup Orders' datatype='real' name='[Calculation_6616350857059733504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_pickup_orders])/SUM([successful_orders])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_6616350857060335617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])/SUM([successful_orders])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_6616350857060646914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='% Reorder Rate - 30d' datatype='real' name='[Calculation_6616350857060892675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([v_reorder30])/SUM([reorder30_den])' />
            </column>
            <column caption='% Offline' datatype='real' name='[Calculation_6616350857061040132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_hours])/SUM([hours_open])' />
            </column>
            <column caption='% Vendor Cancellations' datatype='real' name='[Calculation_6616350857061466117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cancelled_orders])/SUM([gross_orders])' />
            </column>
            <column caption='% Vendor Late &gt; 10min' datatype='real' name='[Calculation_6616350857061707782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_count10])/SUM([vendor_late_obs])' />
            </column>
            <column caption='% DLP' datatype='real' name='[Calculation_6616350857062027271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([products_with_dish_photo])/SUM([products])' />
            </column>
            <column caption='% DLD' datatype='real' name='[Calculation_6616350857062268936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([products_with_description])/SUM([products])' />
            </column>
            <column caption='Avg. Rating' datatype='real' name='[Calculation_6616350857062449161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_sum])/SUM([rating_cnt])' />
            </column>
            <column caption='% Deal Value' datatype='real' name='[Calculation_6616350857063456778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_value_mod])/SUM([gmv_user_paid])' />
            </column>
