      <aliases enabled='yes' />
      <column caption='AFV' datatype='real' name='[Calculation_1247215673296056320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv]) / SUM([successful_orders])' />
      </column>
      <column caption='% Offline' datatype='real' name='[Calculation_1247215673296187393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_mins]) / SUM([open_mins])' />
      </column>
      <column caption='% Vendor Late 10m' datatype='real' name='[Calculation_1247215673296330754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([late_10]) / SUM([late_obs])' />
      </column>
      <column caption='% Vendor Cancelled' datatype='real' name='[Calculation_1247215673296453635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_cancelled_orders]) / SUM([gross_orders])' />
      </column>
      <column caption=' +' datatype='string' name='[Calculation_1247215673306521605]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; &apos;' />
      </column>
      <column caption='Offline Time' datatype='real' default-format='*hh:nn' name='[Calculation_1247215673325027334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[offline_mins]/24/60' />
      </column>
      <column caption='Modded Active' datatype='boolean' name='[Calculation_1252282177460322304]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MAX([vendor_active]) = TRUE THEN TRUE&#13;&#10;ELSEIF [Calculation_1252282177463611393] = TRUE THEN TRUE&#13;&#10;ELSEIF [Calculation_1252282177463746562] = TRUE THEN TRUE &#13;&#10;ELSE FALSE END' />
      </column>
      <column caption='Order check' datatype='boolean' name='[Calculation_1252282177463611393]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([gross_orders]) &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Open check' datatype='boolean' name='[Calculation_1252282177463746562]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([open_mins]) &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='No sales check' datatype='boolean' name='[Calculation_1699827448965898240]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([successful_orders]) = NULL THEN TRUE END' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_886646228809715712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1] &#13;&#10;WHEN &apos;Orders&apos; THEN SUM([successful_orders])&#13;&#10;WHEN &apos;Gross Orders&apos; THEN SUM([gross_orders])&#13;&#10;WHEN &apos;Vendor Cancelled Orders&apos; THEN SUM([vendor_cancelled_orders])&#13;&#10;WHEN &apos;GFV&apos; THEN SUM([gfv])&#13;&#10;WHEN &apos;Offline Mins&apos; THEN SUM([offline_mins])&#13;&#10;WHEN &apos;Vendor Late 10&apos; THEN SUM([late_10])&#13;&#10;WHEN &apos;AFV&apos; THEN SUM([gfv]) / SUM([successful_orders])&#13;&#10;WHEN &apos;% Vendor Cancelled&apos; THEN (SUM([vendor_cancelled_orders]) / SUM([gross_orders])) * 100&#13;&#10;WHEN &apos;% Offline&apos; THEN (SUM([offline_mins]) / SUM([open_mins])) * 100&#13;&#10;WHEN &apos;% Vendor Late 10&apos; THEN (SUM([late_10]) / SUM([successful_orders])) * 100&#13;&#10;WHEN &apos;Lost Revenue&apos; THEN SUM([cancelled_gfv_local])&#13;&#10;WHEN &apos;Vendor Acquisition&apos; THEN SUM([vendor_acq]) &#13;&#10;WHEN &apos;Platform Acquisition&apos; THEN SUM([platform_acq])&#13;&#10;END' />
      </column>
      <column caption='Date Level' datatype='date' datatype-customized='true' name='[Calculation_953637231956135936]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Day&apos; THEN [report_date]&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[report_date])&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[report_date])&#13;&#10;END)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='report_SOK_performance' datatype='table' name='[__tableau_internal_object_id__].[report_SOK_performance_100AF2A5DD804910988FF18B94C17EF0]' role='measure' type='quantitative' />
      <column caption='GFV of Vendor Cancelled Orders' datatype='real' name='[cancelled_gfv_local]' role='measure' type='quantitative' />
      <column caption='Chain Code' datatype='string' name='[chain_code]' role='dimension' type='nominal' />
      <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
      <column caption='GFV' datatype='real' name='[gfv]' role='measure' type='quantitative' />
      <column caption='Gross Orders' datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
      <column caption='Vendor Late 10m' datatype='integer' name='[late_10]' role='measure' type='quantitative' />
      <column caption='Vendor Late 5m' datatype='integer' name='[late_5]' role='measure' type='quantitative' />
