              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0eqf0m616gpqnm15thhty1rawrab'>
            <column caption='SDD &gt;= 40 Mins' datatype='real' name='[Calculation_1443825938036080640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sdd_orders_forty])/SUM([sdd_orders])' />
            </column>
            <column caption='Date Metric' datatype='date' name='[Calculation_149252153513959424]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(Case [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN STR([date_metric])&#10;WHEN &apos;Weekly&apos; THEN STR(DATETRUNC(&apos;iso-week&apos;, [date_metric]))&#10;WHEN &apos;Monthly&apos; THEN STR(STR(DATETRUNC(&apos;month&apos;, [date_metric])))&#10;END)' />
            </column>
            <column caption='Incident Rate ' datatype='real' name='[Calculation_213006235772985344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_event_id])/SUM([gross_order_count])' />
            </column>
            <column caption='Cust. Fail Rate' datatype='real' name='[Calculation_2221963480739799041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cus_fail])/SUM([gross_orders])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_2221963480739954690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ven_fail])/SUM([gross_orders])' />
            </column>
            <column caption='Surge Orders %age' datatype='real' name='[Calculation_2221963480741031940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surged_order_experience])/SUM([actual_orders])' />
            </column>
            <column caption='Delivery Time - Mins' datatype='real' name='[Calculation_2221963480741806085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt])/SUM([dt_orders])' />
            </column>
            <column caption='Vendor Delay - Mins' datatype='real' name='[Calculation_2221963480742195206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ven_del])/60)/SUM([dt_orders])' />
            </column>
            <column caption='Rider Fail Rate' datatype='real' name='[Calculation_2221963480742727687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([log_fail])/SUM([gross_orders])' />
            </column>
            <column caption='Overall Fail Rate' datatype='real' name='[Calculation_343610608720601088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([overall_fail])/SUM([gross_orders])' />
            </column>
            <column caption='Marketing ICPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3917709522051706880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([marketing_burn])/SUM([icpo_orders])' />
