      <column caption='SDD &gt;= 40 Mins' datatype='real' name='[Calculation_1443825938036080640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sdd_orders_forty])/SUM([sdd_orders])' />
