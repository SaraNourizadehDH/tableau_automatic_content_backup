      <column caption='Incident Rate ' datatype='real' name='[Calculation_213006235772985344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_event_id])/SUM([gross_order_count])' />
      </column>
      <column caption='Cust. Fail Rate' datatype='real' name='[Calculation_2221963480739799041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cus_fail])/SUM([gross_orders])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_2221963480739954690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ven_fail])/SUM([gross_orders])' />
      </column>
      <column caption='Surge Orders %age' datatype='real' name='[Calculation_2221963480741031940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([surged_order_experience])/SUM([actual_orders])' />
      </column>
      <column caption='Delivery Time - Mins' datatype='real' name='[Calculation_2221963480741806085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt])/SUM([dt_orders])' />
      </column>
      <column caption='Vendor Delay - Mins' datatype='real' name='[Calculation_2221963480742195206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ven_del])/60)/SUM([dt_orders])' />
