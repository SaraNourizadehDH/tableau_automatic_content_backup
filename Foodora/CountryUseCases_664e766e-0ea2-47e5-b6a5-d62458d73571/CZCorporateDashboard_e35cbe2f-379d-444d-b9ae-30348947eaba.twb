      <column aggregation='Count' caption='Attribute' datatype='string' default-type='nominal' layered='true' name='[Calculation_4562427957446524931]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1001]&#13;&#10;WHEN &quot;Vertical&quot; Then [vertical]&#13;&#10;WHEN &quot;Delivery Type&quot; Then [delivery_type]&#13;&#10;WHEN &quot;Payment Type&quot; Then [payment_type]&#13;&#10;WHEN &quot;Source&quot; Then [source]&#13;&#10;WHEN &quot;Local Chain&quot; Then [local_chain]&#13;&#10;WHEN &quot;Is Subscriber Order&quot; Then STR([is_subscriber_order])&#13;&#10;WHEN &quot;Is Subscription Order&quot; Then STR([is_subscription_order])&#13;&#10;WHEN &quot;City&quot; then [vendor_city]&#13;&#10;WHEN &quot;Total&quot; Then &quot;Total&quot;&#13;&#10;END' />
      </column>
      <column caption='PRO fee per user' datatype='integer' name='[Calculation_5510294902871949313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cp_company_name] = &quot;Red Bull Česká Republika, s.r.o.&quot;&#10;then 25&#10;elseif [cp_company_name] = &quot;JSK Management s.r.o.&quot; then 49&#10;else 0&#10;end' />
      </column>
      <column caption='PRO fee Total' datatype='real' name='[Calculation_5510294902875029506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Calculation_5510294902871949313]) * [# vendors with order (copy)_1686879555369955341]' />
      </column>
      <column caption='# Registered Users' datatype='integer' name='[Calculation_5766085306695008256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [cp_company_name], [cp_department_name], [created_date_utc (customers)]: COUNTD([customer_uuid])}' />
