        <view>
          <datasources>
            <datasource caption='CZ_Data_Model' name='sqlproxy.1673ou414l7mo61aj680j0qgu7y5' />
            <datasource caption='customers (master)' name='federated.02zizbm1s5h26x19rtaiy16dmwp8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Daily / Weekly / Monthly' datatype='string' name='[Parameter 1000]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02zizbm1s5h26x19rtaiy16dmwp8'>
            <column caption='Cp Company Name' datatype='string' name='[cp_company_name]' role='dimension' type='nominal' />
            <column caption='Cp Department Name' datatype='string' name='[cp_department_name]' role='dimension' type='nominal' />
            <column caption='Is Employee' datatype='boolean' name='[is_employee]' role='dimension' type='nominal' />
            <column-instance column='[cp_company_name]' derivation='None' name='[none:cp_company_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[cp_department_name]' derivation='None' name='[none:cp_department_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_employee]' derivation='None' name='[none:is_employee:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1673ou414l7mo61aj680j0qgu7y5'>
            <column aggregation='User' caption='# Corporate Orders' datatype='integer' default-type='quantitative' layered='true' name='[# preorders (copy)_4562427957434273792]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='count(IF [is_valid_order] = true and [source (customers)] = &quot;b2b&quot; &#13;&#10;then [order_uuid] end)' />
            </column>
            <column aggregation='Year' caption='Order Date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_6854197211033382912]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1000]&#13;&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[created_at_local])&#13;&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[created_at_local],&apos;monday&apos;)&#13;&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[created_at_local])&#13;&#10;END)' />
            </column>
            <column caption='Time' datatype='datetime' name='[Calculation_7533677772857458689]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKETIME(DATEPARt(&apos;hour&apos;,[created_at_local]),&#10;&#10;DATEPARt(&apos;minute&apos;,[created_at_local]),&#10;&#10;DATEPARt(&apos;second&apos;,[created_at_local]))' />
            </column>
            <column caption='Period of Day' datatype='string' name='[Calculation_7533677772863520770]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_7533677772857458689] &gt;= maketime(6, 0, 0) and [Calculation_7533677772857458689] &lt; maketime(10,30,0)&#10;THEN &apos;0 Morning&apos;&#10;elseif [Calculation_7533677772857458689] &gt;= maketime(10, 30, 0) and [Calculation_7533677772857458689] &lt; maketime(14,0,0)&#10;THEN &apos;1 Lunch&apos;&#10;elseif [Calculation_7533677772857458689] &gt;= maketime(14, 0, 0) and [Calculation_7533677772857458689] &lt; maketime(17,0,0)&#10;THEN &apos;2 Afternoon&apos;&#10;elseif [Calculation_7533677772857458689] &gt;= maketime(17, 0, 0) and [Calculation_7533677772857458689] &lt; maketime(21,0,0)&#10;THEN &apos;3 Dinner&apos;&#10;else &apos;4 Night&apos;&#10;end' />
            </column>
            <column aggregation='Sum' caption='Hour of Order' datatype='integer' name='[Calculation_780037550436749315]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&quot;hour&quot;, [created_at_local])' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cp_company_name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cp_department_name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' datatype='datetime' default-type='ordinal' layered='true' name='[created_at_local]' pivot='key' role='dimension' type='ordinal' user-datatype='datetime' visual-totals='Default' />
            <column aggregation='Count' datatype='boolean' default-type='nominal' layered='true' name='[is_employee]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default' />
            <column aggregation='Count' datatype='boolean' default-type='nominal' layered='true' name='[is_valid_order]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default' />
