              <calculation class='tableau' formula='[Calculation_1686879555364573184] / [# active customers (copy)_1686879555370127374]' />
            </column>
            <column aggregation='User' caption='# days in month' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_385339268615516160]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='MIN(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[created_at_local])))))' />
