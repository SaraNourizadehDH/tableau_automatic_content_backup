            <column aggregation='User' caption='GMV (User Paid Amount)' datatype='real' default-format='c#,##0.00&quot; Kč&quot;;-#,##0.00&quot; Kč&quot;' default-type='quantitative' layered='true' name='[# successful orders (copy)_1686879555366772739]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
