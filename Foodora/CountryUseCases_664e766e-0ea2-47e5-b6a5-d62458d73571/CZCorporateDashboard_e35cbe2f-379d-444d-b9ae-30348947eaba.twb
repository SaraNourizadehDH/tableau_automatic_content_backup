            <column aggregation='User' caption='# days passed' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_385339268615630849]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='COUNTD(IF DATE([created_at_local]) &lt; TODAY() then DATE([created_at_local]) end)' />
