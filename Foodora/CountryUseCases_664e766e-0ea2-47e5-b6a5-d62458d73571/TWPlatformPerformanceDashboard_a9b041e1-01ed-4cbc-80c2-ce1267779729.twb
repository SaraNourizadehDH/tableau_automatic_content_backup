              <calculation class='tableau' formula='SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] AND NOT [is_incentivised_order] THEN [gfv_local] END)&#10;/&#10;SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] AND NOT [is_incentivised_order] THEN [orders] END)' />
