    <datasource caption='country_TW_platform_metrics_query' inline='true' name='federated.066ztjp1qgvmr614m9ajn00zsiiv' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0hhp7m609705jz16h6kid1s37tnh'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='vincent.tsai@foodpanda.tw' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0hhp7m609705jz16h6kid1s37tnh' name='Custom SQL Query' type='text'>WITH incentive_cost AS (
  SELECT
    mic.order_code,
    mic.is_incentivised_order,
    mic.incentive_cost_fp_marketing_local
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_incentive_cost` AS mic
  WHERE mic.global_entity_id = &quot;FP_TW&quot;
    AND mic.partition_month &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(&quot;Asia/Taipei&quot;), INTERVAL 4 MONTH), MONTH)
    AND mic.is_billable
)

SELECT
  pandora__agg_orders.created_date_local AS report_date,
  EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) AS report_hour,
  CASE
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (6, 7, 8, 9, 10) THEN &quot;[1] 早餐 6-10&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (11, 12, 13) THEN &quot;[2] 午餐 11-13&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (14, 15, 16) THEN &quot;[3] 下午茶 14-16&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (17, 18, 19) THEN &quot;[4] 晚餐 17-19&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (20, 21, 22) THEN &quot;[5] 宵夜 20-22&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (23, 0, 1, 2, 3, 4, 5) THEN &quot;[6] 凌晨 23-05&quot;
  END AS time_of_day,
  pandora__agg_orders.business_type AS business_type_apac,
  CASE WHEN pandora__agg_orders.delivery_type = &quot;pickup&quot; THEN &quot;pickup&quot; ELSE &quot;delivery&quot; END AS expedition_type,
  CASE
    WHEN vendors.vendor_city = &quot;yilan&quot; THEN &quot;Yilan county&quot;
    WHEN vendors.vendor_city = &quot;yilan county&quot; THEN &quot;Yilan county&quot;
    WHEN vendors.vendor_city = &quot;zhongli&quot; THEN &quot;Taoyuan city&quot;
    WHEN vendors.vendor_city = &quot;taichung city&quot; THEN &quot;Taichung City&quot;
    WHEN vendors.vendor_city = &quot;taipei city&quot; THEN &quot;Taipei City&quot;
    WHEN vendors.vendor_city = &quot;taoyuan city&quot; THEN &quot;Taoyuan City&quot;
    WHEN vendors.vendor_city = &quot;taipei city&quot; THEN &quot;Taipei City&quot;
    ELSE vendors.vendor_city
  END AS city_name,
  incentive_cost.is_incentivised_order,
  pandora__agg_orders.is_subscription_incentive_order AS is_subscription_benefit_order,
  COUNT(pandora__agg_orders.order_code) AS orders,
  SUM(pandora__agg_orders.gfv_local) AS gfv_local,
  SUM(pandora__order_accounting.gmv_local) AS gmv_local,
  SUM(pandora__agg_orders.df_user_paid_incl_vat_local) AS delivery_fee_local,
  SUM(incentive_cost.incentive_cost_fp_marketing_local) AS incentive_cost_local
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS pandora__agg_orders
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendors
       ON pandora__agg_orders.vendor_code = vendors.vendor_code
      AND vendors.global_entity_id = &quot;FP_TW&quot;
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_accounting` AS pandora__order_accounting
       ON pandora__agg_orders.order_code = pandora__order_accounting.order_code
      AND pandora__order_accounting.global_entity_id = &quot;FP_TW&quot;
      AND pandora__order_accounting.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE(&quot;Asia/Taipei&quot;), INTERVAL 4 MONTH) AND CURRENT_DATE(&quot;Asia/Taipei&quot;) - 1
LEFT JOIN incentive_cost
       ON incentive_cost.order_code = pandora__agg_orders.order_code
WHERE pandora__agg_orders.global_entity_id = &quot;FP_TW&quot;
  AND pandora__agg_orders.created_date_local BETWEEN DATE_SUB(CURRENT_DATE(&quot;Asia/Taipei&quot;), INTERVAL 4 MONTH) AND CURRENT_DATE(&quot;Asia/Taipei&quot;) - 1
  AND pandora__agg_orders.is_successful
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0hhp7m609705jz16h6kid1s37tnh' name='Custom SQL Query' type='text'>WITH incentive_cost AS (
  SELECT
    mic.order_code,
    mic.is_incentivised_order,
    mic.incentive_cost_fp_marketing_local
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_incentive_cost` AS mic
  WHERE mic.global_entity_id = &quot;FP_TW&quot;
    AND mic.partition_month &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(&quot;Asia/Taipei&quot;), INTERVAL 4 MONTH), MONTH)
    AND mic.is_billable
)

SELECT
  pandora__agg_orders.created_date_local AS report_date,
  EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) AS report_hour,
  CASE
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (6, 7, 8, 9, 10) THEN &quot;[1] 早餐 6-10&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (11, 12, 13) THEN &quot;[2] 午餐 11-13&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (14, 15, 16) THEN &quot;[3] 下午茶 14-16&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (17, 18, 19) THEN &quot;[4] 晚餐 17-19&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (20, 21, 22) THEN &quot;[5] 宵夜 20-22&quot;
    WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (23, 0, 1, 2, 3, 4, 5) THEN &quot;[6] 凌晨 23-05&quot;
  END AS time_of_day,
  pandora__agg_orders.business_type AS business_type_apac,
  CASE WHEN pandora__agg_orders.delivery_type = &quot;pickup&quot; THEN &quot;pickup&quot; ELSE &quot;delivery&quot; END AS expedition_type,
  CASE
    WHEN vendors.vendor_city = &quot;yilan&quot; THEN &quot;Yilan county&quot;
    WHEN vendors.vendor_city = &quot;yilan county&quot; THEN &quot;Yilan county&quot;
    WHEN vendors.vendor_city = &quot;zhongli&quot; THEN &quot;Taoyuan city&quot;
    WHEN vendors.vendor_city = &quot;taichung city&quot; THEN &quot;Taichung City&quot;
    WHEN vendors.vendor_city = &quot;taipei city&quot; THEN &quot;Taipei City&quot;
    WHEN vendors.vendor_city = &quot;taoyuan city&quot; THEN &quot;Taoyuan City&quot;
    WHEN vendors.vendor_city = &quot;taipei city&quot; THEN &quot;Taipei City&quot;
    ELSE vendors.vendor_city
  END AS city_name,
  incentive_cost.is_incentivised_order,
  pandora__agg_orders.is_subscription_incentive_order AS is_subscription_benefit_order,
  COUNT(pandora__agg_orders.order_code) AS orders,
  SUM(pandora__agg_orders.gfv_local) AS gfv_local,
  SUM(pandora__order_accounting.gmv_local) AS gmv_local,
  SUM(pandora__agg_orders.df_user_paid_incl_vat_local) AS delivery_fee_local,
  SUM(incentive_cost.incentive_cost_fp_marketing_local) AS incentive_cost_local
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS pandora__agg_orders
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendors
       ON pandora__agg_orders.vendor_code = vendors.vendor_code
      AND vendors.global_entity_id = &quot;FP_TW&quot;
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_accounting` AS pandora__order_accounting
       ON pandora__agg_orders.order_code = pandora__order_accounting.order_code
      AND pandora__order_accounting.global_entity_id = &quot;FP_TW&quot;
      AND pandora__order_accounting.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE(&quot;Asia/Taipei&quot;), INTERVAL 4 MONTH) AND CURRENT_DATE(&quot;Asia/Taipei&quot;) - 1
LEFT JOIN incentive_cost
       ON incentive_cost.order_code = pandora__agg_orders.order_code
WHERE pandora__agg_orders.global_entity_id = &quot;FP_TW&quot;
  AND pandora__agg_orders.created_date_local BETWEEN DATE_SUB(CURRENT_DATE(&quot;Asia/Taipei&quot;), INTERVAL 4 MONTH) AND CURRENT_DATE(&quot;Asia/Taipei&quot;) - 1
  AND pandora__agg_orders.is_successful
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
