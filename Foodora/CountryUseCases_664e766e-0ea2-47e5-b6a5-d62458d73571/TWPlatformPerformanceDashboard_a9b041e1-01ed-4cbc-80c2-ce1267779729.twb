              <calculation class='tableau' formula='SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [gfv_local] END) &#10;/ &#10;SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] END)' />
