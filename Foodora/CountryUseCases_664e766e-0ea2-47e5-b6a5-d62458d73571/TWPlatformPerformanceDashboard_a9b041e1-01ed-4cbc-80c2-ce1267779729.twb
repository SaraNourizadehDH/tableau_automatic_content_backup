            <column caption='weekly|#previous' datatype='real' default-format='N' name='[orders_pervious （複製）_1689905395918028828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; &#10;THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] END), 0)&#10;&#10;WHEN &quot;GFV&quot; &#10;THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [gfv_local] END), 0)&#10;&#10;WHEN &quot;GMV&quot; &#10;THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [gmv_local] END), 0)&#10;&#10;WHEN &quot;AFV&quot; &#10;THEN ROUND(&#10;     SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [gfv_local] END) &#10;     / &#10;     SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] END)&#10;     , 2)&#10;WHEN &quot;DFO&quot; &#10;THEN ROUND(&#10;     SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [delivery_fee_local] END) &#10;     / &#10;     SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] END)&#10;     , 2)&#10;     &#10;WHEN &quot;Incentive Cost&quot; &#10;THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [incentive_cost_local] END), 0)&#10;&#10;WHEN &quot;ICPGMV&quot; &#10;THEN ROUND(&#10;     SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [incentive_cost_local] END) &#10;     / &#10;     SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [gmv_local] END)&#10;     , 4) * 100&#10;END' />
