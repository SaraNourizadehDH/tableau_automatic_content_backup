              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.066ztjp1qgvmr614m9ajn00zsiiv].[Calculation_1457970017161793536]' caption='daily|tracking' datatype='date' default-format='*YYYY-MM-DD' name='[week_type 參數]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
              <range granularity='1' max='#2025-12-31#' min='#2024-01-01#' period-type-v2='day' />
            </column>
