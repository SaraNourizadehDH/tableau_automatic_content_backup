  <worksheets>
    <worksheet name='A|business'>
      <table>
        <view>
          <datasources>
            <datasource caption='country_TW_platform_metrics_query' name='federated.066ztjp1qgvmr614m9ajn00zsiiv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='daily|past_N' datatype='integer' name='[report_week 參數]' param-domain-type='range' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <range granularity='1' max='90' min='1' />
            </column>
            <column caption='metric_parameter' datatype='string' name='[tracking_date （複製）]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.066ztjp1qgvmr614m9ajn00zsiiv].[Calculation_1457970017161793536]' caption='daily|tracking' datatype='date' default-format='*YYYY-MM-DD' name='[week_type 參數]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
              <range granularity='1' max='#2025-12-31#' min='#2024-01-01#' period-type-v2='day' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.066ztjp1qgvmr614m9ajn00zsiiv'>
            <column caption='max_date' datatype='date' name='[Calculation_1457970017161793536]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED :MAX((IF YEAR([report_date])=YEAR(today()-1) THEN [report_date] END))}' />
            </column>
            <column caption='daily|#tracking' datatype='real' default-format='N' name='[Calculation_1689905395867242499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] END)&#10;WHEN &quot;GFV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [gfv_local] END),0)&#10;WHEN &quot;GMV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [gmv_local] END),0)&#10;WHEN &quot;AFV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [gfv_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] END),2)&#10;WHEN &quot;DFO&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [delivery_fee_local] END)/SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] END),2)&#10;WHEN &quot;Incentive Cost&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [incentive_cost_local] END),0)&#10;WHEN &quot;ICPGMV&quot; THEN ROUND( SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [incentive_cost_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [gmv_local] END),4) * 100&#10;END' />
            </column>
            <column caption='daily|#previous' datatype='real' default-format='N' name='[Calculation_1689905395867418628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END)&#10;WHEN &quot;GFV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gfv_local] END),0)&#10;WHEN &quot;GMV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gmv_local] END),0)&#10;WHEN &quot;AFV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gfv_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END),2)&#10;WHEN &quot;DFO&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [delivery_fee_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END),2)&#10;WHEN &quot;Incentive Cost&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [incentive_cost_local] END),0)&#10;WHEN &quot;ICPGMV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [incentive_cost_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gmv_local] END),4) * 100&#10;END' />
            </column>
            <column caption='daily|%growth_rate' datatype='real' default-format='p0.00%' name='[Calculation_1689905395867611141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1689905395867242499]/[Calculation_1689905395867418628]-1' />
            </column>
            <column caption='daily|#difference' datatype='real' default-format='N' name='[Calculation_1689905395867779079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628],0)&#10;WHEN &quot;GFV&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628],0)&#10;WHEN &quot;GMV&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628],0)&#10;WHEN &quot;AFV&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628],2)&#10;WHEN &quot;DFO&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628],2)&#10;WHEN &quot;Incentive Cost&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628],0)&#10;WHEN &quot;ICPGMV&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628],2)&#10;END' />
            </column>
            <column caption='business' datatype='string' name='[Calculation_1689905395902246925]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [business_type_apac]=&quot;shops&quot; THEN &quot;shops&quot;&#10;ELSE &quot;restaurants&quot;&#10;END' />
            </column>
            <column caption='daily|%growth_contribution' datatype='real' default-format='p0.00%' name='[Calculation_485966553228398592]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;WHEN &quot;GFV&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;WHEN &quot;GMV&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;WHEN &quot;Incentive Cost&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;ELSE NULL&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[daily|#tracking （複製）_3126061100028321792]' derivation='Attribute' name='[attr:daily|#tracking （複製）_3126061100028321792:nk]' pivot='key' type='nominal' />
            <column-instance column='[daily|%growth_contribution （複製）_3126061100077588483]' derivation='Attribute' name='[attr:daily|%growth_contribution （複製）_3126061100077588483:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[business_type_apac]' role='dimension' type='nominal' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='ICPGMV%' datatype='string' default-format='N' name='[daily|#tracking （複製）_3126061100028321792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;ICPGMV&quot; THEN &quot;%&quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='daily|%growth_contribution_tooltip' datatype='string' default-format='p0.00%' name='[daily|%growth_contribution （複製）_3126061100077588483]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN &quot;Growth Contribution: &quot;&#10;WHEN &quot;GFV&quot; THEN &quot;Growth Contribution: &quot;&#10;WHEN &quot;GMV&quot; THEN &quot;Growth Contribution: &quot;&#10;WHEN &quot;Incentive Cost&quot; THEN &quot;Growth Contribution: &quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column datatype='real' name='[delivery_fee_local]' role='measure' type='quantitative' />
            <column datatype='string' name='[expedition_type]' role='dimension' type='nominal' />
            <column datatype='real' name='[gfv_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[incentive_cost_local]' role='measure' type='quantitative' />
