            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.066ztjp1qgvmr614m9ajn00zsiiv].[max_date （複製）_1006976736181342245]' _.fcp.ParameterDefaultValues.true...source-field='[federated.066ztjp1qgvmr614m9ajn00zsiiv].[Calculation_3805330613110202368]' caption='weekly|tracking' datatype='date' datatype-customized='true' default-format='*YYYY-MM-DD' name='[tracking_date （複製）_1689905395915759636]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-18#'>
