              <calculation class='tableau' formula='LEFT(DATENAME(&apos;weekday&apos;,[report_date]),3)' />
            </column>
            <column caption='WoW|weekday' datatype='integer' name='[Calculation_2960694556260659200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[tracking_date （複製）_1689905395915759636]=[max_date （複製）_1006976736181342245] THEN ISOWEEKDAY(today()-1)&#10;ELSE 7&#10;END' />
