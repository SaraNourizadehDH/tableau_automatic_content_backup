      <column caption='metric' datatype='real' default-format='N' name='[Calculation_231372437067448324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN ROUND(SUM([orders]),0)&#10;WHEN &quot;GFV&quot; THEN ROUND(SUM([gfv_local]),0)&#10;WHEN &quot;GMV&quot; THEN ROUND(SUM([gmv_local]),0)&#10;WHEN &quot;AFV&quot; THEN ROUND(SUM([gfv_local]) / SUM([orders]),2)&#10;WHEN &quot;DFO&quot; THEN ROUND(SUM([delivery_fee_local])/SUM([orders]),2)&#10;WHEN &quot;Incentive Cost&quot; THEN ROUND(SUM([incentive_cost_local]),0)&#10;WHEN &quot;ICPGMV&quot; THEN ROUND(SUM([incentive_cost_local])/SUM([gmv_local]),4) * 100&#10;END' />
