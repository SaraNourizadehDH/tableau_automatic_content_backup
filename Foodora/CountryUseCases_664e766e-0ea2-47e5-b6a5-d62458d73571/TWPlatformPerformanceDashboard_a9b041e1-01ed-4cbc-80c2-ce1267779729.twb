            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column caption='previous_week' datatype='date' default-format='n#,##0;-#,##0' name='[pervious_date （複製）_2226467070319632384]' role='dimension' type='quantitative'>
