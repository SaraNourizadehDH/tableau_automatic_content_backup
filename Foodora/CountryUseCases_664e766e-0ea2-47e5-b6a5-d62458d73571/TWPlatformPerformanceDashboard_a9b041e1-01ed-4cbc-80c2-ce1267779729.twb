              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],0)&#10;WHEN &quot;GFV&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],0)&#10;WHEN &quot;AFV&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],2)&#10;WHEN &quot;GMV&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],0)&#10;WHEN &quot;DFO&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],2)&#10;WHEN &quot;Incentive Cost&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],0)&#10;WHEN &quot;ICPGMV&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],4)&#10;END' />
