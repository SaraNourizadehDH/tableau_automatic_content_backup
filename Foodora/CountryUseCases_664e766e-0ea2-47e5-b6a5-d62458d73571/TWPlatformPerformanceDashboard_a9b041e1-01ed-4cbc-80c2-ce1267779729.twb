        <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END)&#10;WHEN &quot;GFV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gfv_local] END),0)&#10;WHEN &quot;GMV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gmv_local] END),0)&#10;WHEN &quot;AFV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gfv_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END),2)&#10;WHEN &quot;DFO&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [delivery_fee_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END),2)&#10;WHEN &quot;Incentive Cost&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [incentive_cost_local] END),0)&#10;WHEN &quot;ICPGMV&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [incentive_cost_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gmv_local] END),4) * 100&#10;END' />
