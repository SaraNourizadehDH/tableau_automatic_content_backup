      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2C6EBC58470C41CF9679ADCC687407B6'>
            <properties context=''>
              <relation connection='bigquery.0hjg85a1i2ybpn1b5sr9h1nwq0z0' name='Custom SQL Query' type='text'><![CDATA[WITH postcode_table AS (
  SELECT DISTINCT
    CASE
      WHEN city_name_english = "lienchiang county" THEN "Others"
      WHEN city_name_english IS NULL THEN "Others"
      ELSE city_name_english
    END AS city_name_english,
    postcode
  FROM `fulfillment-dwh-production.pandata_report.country_TW_gsheet_polygons_postcodedistrict`
),

orders AS (
  SELECT
    pandora__agg_orders.created_date_local AS report_date,
    EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) AS report_hour,
    CASE
      WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (6, 7, 8, 9, 10) THEN "[1] 早餐 6-10"
      WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (11, 12, 13) THEN "[2] 午餐 11-13"
      WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (14, 15, 16) THEN "[3] 下午茶 14-16"
      WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (17, 18, 19) THEN "[4] 晚餐 17-19"
      WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (20, 21, 22) THEN "[5] 宵夜 20-22"
      WHEN EXTRACT(HOUR FROM pandora__agg_orders.created_at_local) IN (23, 0, 1, 2, 3, 4, 5) THEN "[6] 凌晨 23-05"
    END AS time_of_day,
    CASE
      WHEN vendors.vendor_city = "yilan" THEN "Yilan county"
      WHEN vendors.vendor_city = "yilan county" THEN "Yilan county"
      WHEN vendors.vendor_city = "zhongli" THEN "Taoyuan city"
      WHEN vendors.vendor_city = "taichung city" THEN "Taichung City"
      WHEN vendors.vendor_city = "taipei city" THEN "Taipei City"
      WHEN vendors.vendor_city = "taoyuan city" THEN "Taoyuan City"
      WHEN vendors.vendor_city = "taipei city" THEN "Taipei City"
      ELSE vendors.vendor_city
    END AS city_name,
    COUNTIF(pandora__agg_orders.is_successful) AS valid_orders,
    COUNT(pandora__agg_orders.order_code) AS gross_orders
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS pandora__agg_orders
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendors
         ON pandora__agg_orders.vendor_code = vendors.vendor_code
        AND vendors.global_entity_id = "FP_TW"
  WHERE pandora__agg_orders.global_entity_id = "FP_TW"
    AND DATE(pandora__agg_orders.created_date_local) BETWEEN DATE_SUB(CURRENT_DATE("Asia/Taipei"), INTERVAL 4 MONTH) AND CURRENT_DATE("Asia/Taipei") - 1
    AND pandora__agg_orders.is_gross_order
  GROUP BY ALL
),

perseus AS (
  SELECT
    DATE(perseus_sessions.session_start_timestamp_local) AS report_date,
    EXTRACT(HOUR FROM DATETIME(perseus_sessions.session_start_timestamp_local)) AS report_hour,
    CASE
      WHEN EXTRACT(HOUR FROM perseus_sessions.session_start_timestamp_local) IN (6, 7, 8, 9, 10) THEN "[1] 早餐 6-10"
      WHEN EXTRACT(HOUR FROM perseus_sessions.session_start_timestamp_local) IN (11, 12, 13) THEN "[2] 午餐 11-13"
      WHEN EXTRACT(HOUR FROM perseus_sessions.session_start_timestamp_local) IN (14, 15, 16) THEN "[3] 下午茶 14-16"
      WHEN EXTRACT(HOUR FROM perseus_sessions.session_start_timestamp_local) IN (17, 18, 19) THEN "[4] 晚餐 17-19"
      WHEN EXTRACT(HOUR FROM perseus_sessions.session_start_timestamp_local) IN (20, 21, 22) THEN "[5] 宵夜 20-22"
      WHEN EXTRACT(HOUR FROM perseus_sessions.session_start_timestamp_local) IN (23, 0, 1, 2, 3, 4, 5) THEN "[6] 凌晨 23-05"
    END AS time_of_day,
    COALESCE(postcode_table.city_name_english, "Others") AS city_name,
    COUNT(perseus_sessions.session_id) AS sessions,
    COUNT(DISTINCT CASE WHEN perseus_sessions.has_order THEN perseus_sessions.session_id END) AS transactions
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_sessions_pandora` AS perseus_sessions
  LEFT JOIN postcode_table
         ON SUBSTR(location.area, 1, 3) = CAST(postcode_table.postcode AS STRING)
  WHERE perseus_sessions.global_entity_id = "FP_TW"
    AND perseus_sessions.partition_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE("Asia/Taipei"), INTERVAL 4 MONTH), MONTH)
    AND DATE(perseus_sessions.session_start_timestamp_local) >>= DATE_SUB(CURRENT_DATE("Asia/Taipei"), INTERVAL 4 MONTH)
    AND DATE(perseus_sessions.session_start_timestamp_local) << CURRENT_DATE("Asia/Taipei")
    AND perseus_sessions.funnel != "000000"
  GROUP BY ALL
)

SELECT
  COALESCE(orders.report_date, perseus.report_date) AS report_date,
  COALESCE(orders.report_hour, perseus.report_hour) AS report_hour,
  COALESCE(orders.time_of_day, perseus.time_of_day) AS time_of_day,
  COALESCE(orders.city_name, perseus.city_name) AS city_name,
  orders.valid_orders,
  orders.gross_orders,
  perseus.sessions,
  perseus.transactions
FROM orders
FULL JOIN perseus
       ON orders.report_date = perseus.report_date
      AND orders.report_hour = perseus.report_hour
      AND orders.city_name = perseus.city_name]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
