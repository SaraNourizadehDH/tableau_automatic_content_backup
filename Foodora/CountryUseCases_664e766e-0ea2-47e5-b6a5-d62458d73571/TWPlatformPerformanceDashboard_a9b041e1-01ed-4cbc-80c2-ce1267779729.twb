          <datasource-dependencies datasource='Parameters'>
            <column caption='daily|past_N' datatype='integer' name='[report_week 參數]' param-domain-type='range' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <range granularity='1' max='90' min='1' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.066ztjp1qgvmr614m9ajn00zsiiv].[Calculation_1457970017161793536]' caption='daily|tracking' datatype='date' default-format='*YYYY-MM-DD' name='[week_type 參數]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
              <range granularity='1' max='#2025-12-31#' min='#2024-01-01#' period-type-v2='day' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.066ztjp1qgvmr614m9ajn00zsiiv'>
            <column caption='max_date' datatype='date' name='[Calculation_1457970017161793536]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED :MAX((IF YEAR([report_date])=YEAR(today()-1) THEN [report_date] END))}' />
            </column>
            <column caption='previous_date' datatype='string' name='[Calculation_1689905395903623182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([Parameters].[week_type 參數]-[Parameters].[report_week 參數]))+&quot;-&quot;+STR(MONTH([Parameters].[week_type 參數]-[Parameters].[report_week 參數]))+&quot;-&quot;+STR(DAY([Parameters].[week_type 參數]-[Parameters].[report_week 參數]))' />
            </column>
            <column-instance column='[Calculation_1689905395903623182]' derivation='Attribute' name='[attr:Calculation_1689905395903623182:nk]' pivot='key' type='nominal' />
            <column caption='business_type' datatype='string' name='[business （複製）_3126061100110282758]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [business_type_apac]= &quot;shops&quot; THEN &quot;shops&quot;&#10;ELSEIF [business_type_apac]= &quot;restaurants&quot; AND [expedition_type] = &quot;pickup&quot; THEN &quot;pickup&quot;&#10;ELSE &quot;restaurants&quot;&#10;END' />
            </column>
            <column datatype='string' name='[business_type_apac]' role='dimension' type='nominal' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='afv|#difference' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[daily|#difference （複製）_2049982262750777349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[daily|#tracking （複製）_2049982262750777346]-[daily|#pervious （複製）_2049982262750777347]' />
            </column>
            <column caption='afv|#previous' datatype='real' default-format='N' name='[daily|#pervious （複製）_2049982262750777347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [gfv_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END),2)' />
            </column>
            <column caption='afv|#tracking' datatype='real' default-format='N' name='[daily|#tracking （複製）_2049982262750777346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [gfv_local] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] END),2))' />
            </column>
            <column caption='afv|%growth_rate' datatype='real' default-format='p0.00%' name='[daily|%growth_rate （複製）_2049982262750777348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[daily|#tracking （複製）_2049982262750777346]/[daily|#pervious （複製）_2049982262750777347]-1' />
            </column>
            <column caption='afv|▲growth_rate' datatype='string' default-format='p0.00%' name='[daily|▲growth_rate （複製）_2049982262750777351]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [daily|%growth_rate （複製）_2049982262750777348]&gt;0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='afv|▼growth_rate' datatype='string' default-format='p0.00%' name='[daily|▼growth_rate （複製）_2049982262750777352]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [daily|%growth_rate （複製）_2049982262750777348] &lt;0 THEN &quot;▼&quot; END' />
