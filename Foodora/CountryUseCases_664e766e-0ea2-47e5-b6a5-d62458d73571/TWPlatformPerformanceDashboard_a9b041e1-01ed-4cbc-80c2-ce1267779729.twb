              <calculation class='tableau' formula='IF [Parameters].[tracking_date （複製）_1689905395915759636]=[max_date （複製）_1006976736181342245] THEN ISOWEEKDAY(today()-1)&#10;ELSE 7&#10;END' />
            </column>
            <column caption='week_date' datatype='date' name='[Calculation_3805330613110202368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;, [report_date]))' />
            </column>
            <column-instance column='[pervious_date （複製）_2226467070319632384]' derivation='Attribute' name='[attr:pervious_date （複製）_2226467070319632384:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[gfv_local]' role='measure' type='quantitative' />
