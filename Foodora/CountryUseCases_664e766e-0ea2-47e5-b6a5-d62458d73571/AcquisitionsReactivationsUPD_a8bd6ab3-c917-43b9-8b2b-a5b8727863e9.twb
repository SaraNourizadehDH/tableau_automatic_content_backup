  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` 
  WHERE partition_date_local &gt;&gt;= DATE_SUB(DATE(EXTRACT(YEAR FROM CURRENT_DATE()), 1, 1), INTERVAL 3 YEAR)
       AND global_entity_id IN (&apos;MJM_AT&apos;)
       AND is_successful
  GROUP BY ALL),

  granular AS (
