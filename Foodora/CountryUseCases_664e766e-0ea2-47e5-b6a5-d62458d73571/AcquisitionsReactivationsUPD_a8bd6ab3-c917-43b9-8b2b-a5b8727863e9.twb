      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / TOTAL(SUM([orders]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Voucher Orders' datatype='integer' name='[Calculation_2828753201213964288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if([is_voucher_used]) then ([orders])END' />
      </column>
      <column caption='Voucher Share%' datatype='real' name='[Calculation_2828753201214754818]' role='measure' type='quantitative'>
