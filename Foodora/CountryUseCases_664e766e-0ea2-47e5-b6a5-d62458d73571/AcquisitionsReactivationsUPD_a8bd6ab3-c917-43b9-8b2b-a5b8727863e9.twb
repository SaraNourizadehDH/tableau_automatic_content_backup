              <zone forceUpdate='true' h='8666' id='10' type-v2='text' w='73802' x='667' y='667'>
                <formatted-text>
                  <run fontcolor='#333333' fontsize='15'><![CDATA[<[Parameters].[Parameter 1]> Orders, Acquisitions & Reactivations]]></run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontsize='7'>Acquisition = An order placed by a first time customer.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontsize='7'>Reactivation = An order placed by a returning customer, who did not order in the previous </run>
                  <run fontcolor='#333333' fontsize='7' underline='true'>&lt;[Parameters].[Parameter 2]&gt;</run>
                  <run fontcolor='#333333' fontsize='7'>.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#fc0107' fontsize='7'>Customers data source has a 3 day delay that is why last 3 days of customer related KPIs are missing. We are investigating it.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#fc0107' fontsize='7'>Total GMV and Orders might deviate a tiny bit (~0.1%) from Master Report due to data source arrangements to capture reactivations</run>
                  <run>Æ&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
