    NULL AS code_generation_strategy_type,
    o1.voucher_code as voucher_code,
    o.value.incentives.voucher_total_local as value_local,
    o.value.incentives.voucher_dh_local AS dh_value,
    DATE(dwhlo.placed_at_local) last_placed_date_local,
    o1.source as source,
    o1.payment_method_type as payment_method_type,
    o1.payment_type as title,
    CASE WHEN payment.payment_type=&quot;online&quot; THEN TRUE ELSE FALSE END AS is_online_payment,
    o1.gmv_eur AS gmv_eur,
    o.value.order.gbv_eur AS gfv_eur,
    o.value.incentives.voucher_total_local AS vouchers_local,
    o.is_acquisition,
    CASE WHEN COALESCE(c.first_valid_order_dmart_uuid,first_valid_order_shops_uuid) IS NOT NULL THEN TRUE ELSE FALSE END AS is_new_customer_vertical ,
    v.vertical_type
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` o
  LEFT JOIN `dha---bi-485.prod_tables.vendor_info` AS v ON v.vendor_code = o.vendor_id 
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` o1 
    ON o.order_id=o1.order_code AND o.global_entity_id=o1.global_entity_id
  LEFT JOIN last_order dwhlo ON o.analytical_customer_id=dwhlo.analytical_customer_id
    AND dwhlo.analytical_customer_order_rank = o.analytical_customer_order_rank-1
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_eu__customers_agg_orders_dates` c 
  ON o1.global_entity_id=c.global_entity_id AND o1.order_uuid=COALESCE(first_valid_order_dmart_uuid,first_valid_order_shops_uuid)
  WHERE
    o.global_entity_id=&apos;MJM_AT&apos;
    AND o.partition_date_local&gt;&gt;=DATE_SUB(DATE_TRUNC(current_date(),MONTH), INTERVAL 6 month)
    AND o.is_successful
    AND o1.global_entity_id=&apos;MJM_AT&apos;
    and o1.created_date_utc&gt;&gt;=DATE_SUB(DATE_TRUNC(current_date(),MONTH), INTERVAL 6 month)-1
    AND o1.is_valid_order
  GROUP BY ALL
  )


SELECT
  partition_date_local as created_date_utc,
  is_voucher as is_voucher_used,
  type,
  city,
  channel,
  purpose,
  id,
  description,
  code_generation_strategy_type,
  is_acquisition,
  voucher_code,
  source,
  payment_method_type,
  title,
  is_online_payment,
  vertical_type,
  SUM(gmv_eur) gmv,
  SUM(gfv_eur) gfv,
  NULL as delivery_fee,
  COUNT(DISTINCT IF(is_acquisition, order_uid, NULL)) as acquisitions,
  COUNT(DISTINCT IF(is_new_customer_vertical,order_uid,NULL)) acquisitions_qcommerce,
  COUNT(DISTINCT order_uid) orders,
  SUM((value_local)) total_voucher_value, 
  SUM((dh_value)) dh_voucher_value, 
  COUNT(DISTINCT  acid) active_customers,
  COUNT(DISTINCT IF(DATE_DIFF(partition_date_local,last_placed_date_local, day) &gt;&gt; 90,order_uid,NULL)) AS reactivations_90d,
  COUNT(DISTINCT IF(DATE_DIFF(partition_date_local,last_placed_date_local, day) &gt;&gt; 180,order_uid,NULL)) AS reactivations_180d,
  COUNT(DISTINCT IF(DATE_DIFF(partition_date_local,last_placed_date_local, day) &gt;&gt; 270,order_uid,NULL)) AS reactivations_270d,
  COUNT(DISTINCT IF(DATE_DIFF(partition_date_local,last_placed_date_local, day) &gt;&gt; 365 OR (last_placed_date_local IS NULL AND analytical_customer_order_rank &gt;&gt; 1),order_uid,NULL)) AS reactivations_360d
FROM granular
GROUP BY ALL
HAVING is_voucher=TRUE</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
