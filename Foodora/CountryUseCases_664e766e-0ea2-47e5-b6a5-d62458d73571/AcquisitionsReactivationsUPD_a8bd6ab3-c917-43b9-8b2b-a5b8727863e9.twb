          <datasources>
            <datasource caption='Daily Orders, Acquisitions, Reactivations' name='federated.1wykevz06j6bl51a33q7l1hq0jqj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date Display' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;m&quot;'>
              <calculation class='tableau' formula='&quot;m&quot;' />
              <aliases>
                <alias key='&quot;d&quot;' value='Daily' />
                <alias key='&quot;m&quot;' value='Monthly' />
                <alias key='&quot;w&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='90 days' caption='Reactivation Definition' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='90'>
              <calculation class='tableau' formula='90' />
              <aliases>
                <alias key='90' value='90 days' />
                <alias key='180' value='180 days' />
                <alias key='270' value='270 days' />
                <alias key='365' value='365 days' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wykevz06j6bl51a33q7l1hq0jqj'>
            <column caption='% Reactivation Share' datatype='real' name='[# Reactivations (copy)_4466374615234060300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_4466374615220359177])/SUM([active_customers]))' />
            </column>
            <column caption='created_date_week' datatype='date' name='[Calculation_4466374615206019073]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[created_date_utc],&apos;Monday&apos;))' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4466374615206166531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 1]&#10;WHEN &apos;d&apos; THEN [created_date_utc]&#10;WHEN &apos;w&apos; THEN [Calculation_4466374615206019073]&#10;WHEN &apos;m&apos; THEN [created_date_week (copy)_4466374615206080514]&#10;END)' />
            </column>
            <column caption='# Reactivations' datatype='integer' name='[Calculation_4466374615220359177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN 90 THEN [reactivations_90d]&#10;WHEN 180 THEN [reactivations_180d]&#10;WHEN 270 THEN [reactivations_270d]&#10;WHEN 365 THEN [reactivations_360d]&#10;END' />
            </column>
            <column caption='% Acquisition Share ' datatype='real' name='[acquisitions (copy)_4466374615233474571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(Sum([acquisitions])/Sum([active_customers]))' />
