      <aliases enabled='yes' />
      <column caption='Report Date' datatype='string' name='[Calculation_1249467439034511360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([report_date])' />
      </column>
      <column caption='AOV (LC)' datatype='real' name='[Calculation_1863645880626798592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_local])/SUM([successful_orders])' />
      </column>
      <column caption='Report Month' datatype='string' name='[Calculation_243757378871926784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_2542282007283265537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Voucher Value (LC)&quot; THEN [voucher_value_local]&#13;&#10;WHEN &quot;Voucher Value (EUR)&quot; THEN [voucher_value_eur]&#13;&#10;WHEN &quot;# Vouchers&quot; THEN [successful_orders]&#13;&#10;END' />
      </column>
      <column caption='Voucher Dimension' datatype='string' name='[Calculation_2542282007283642373]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Voucher Purpose&quot; THEN [voucher_purpose]&#13;&#10;WHEN &quot;Voucher Type&quot; THEN [voucher_type]&#13;&#10;WHEN &quot;Voucher Channel&quot; THEN [voucher_channel]&#13;&#10;WHEN &quot;Voucher Code&quot; THEN [customer_code]&#13;&#10;WHEN &quot;Voucher Description&quot; THEN [description]&#13;&#10;WHEN &quot;Vendor Name&quot; THEN [Calculation_2542282007285530630]&#13;&#10;WHEN &quot;Chain Name&quot; THEN  [chain_name]&#13;&#10;END' />
      </column>
      <column caption='Vendor Name' datatype='string' name='[Calculation_2542282007285530630]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_name] + &quot; (&quot; + [vendor_code] + &quot;)&quot;' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
      <column aggregation='None' caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Voucher Code' datatype='string' name='[customer_code]' role='dimension' type='nominal' />
      <column caption='Voucher Description' datatype='string' name='[description]' role='dimension' type='nominal' />
      <column caption='New Customer (Platform)' datatype='boolean' name='[new_customer_platform]' role='dimension' type='nominal' />
      <column caption='Vertical' datatype='string' name='[vertical]' role='dimension' type='nominal' />
      <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
