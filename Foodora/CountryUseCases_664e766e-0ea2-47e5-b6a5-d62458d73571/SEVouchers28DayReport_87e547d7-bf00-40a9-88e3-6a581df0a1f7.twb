              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;Foodora Sweden&apos;)' function='filter'>
              <groupfilter function='member' level='[country]' member='&quot;Sweden&quot;' />
            </groupfilter>
