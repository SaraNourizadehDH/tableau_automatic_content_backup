    <worksheet name='Vouchers Last 28 Days'>
      <repository-location id='VouchersLast28Days' path='/t/Foodora/workbooks/SEVouchers28DayReport' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='report_voucher_28 (bl_nordics)' name='federated.0mpcqdz0wxux2q13yobdu0eldx30' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Voucher Dim Para' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Voucher Purpose&quot;'>
              <calculation class='tableau' formula='&quot;Voucher Purpose&quot;' />
            </column>
            <column caption='Metric Para' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Voucher Value (LC)&quot;'>
              <calculation class='tableau' formula='&quot;Voucher Value (LC)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mpcqdz0wxux2q13yobdu0eldx30'>
            <column caption='Report Month' datatype='string' name='[Calculation_243757378871926784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_2542282007283265537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Voucher Value (LC)&quot; THEN [voucher_value_local]&#13;&#10;WHEN &quot;Voucher Value (EUR)&quot; THEN [voucher_value_eur]&#13;&#10;WHEN &quot;# Vouchers&quot; THEN [successful_orders]&#13;&#10;END' />
