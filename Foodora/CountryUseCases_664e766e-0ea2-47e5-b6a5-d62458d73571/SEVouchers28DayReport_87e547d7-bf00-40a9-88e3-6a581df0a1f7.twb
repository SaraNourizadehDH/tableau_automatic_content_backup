              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_cio_OP_SE&apos;)' function='filter'>
              <groupfilter function='member' level='[country]' member='&quot;Sweden&quot;' />
