            </column>
            <column caption='Metric Calc' datatype='real' name='[Calculation_906630925247787009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Orders&quot; THEN round(SUM([valid_orders]),0)&#13;&#10;WHEN &quot;GFV&quot; THEN SUM([gfv])&#13;&#10;WHEN &quot;GMV&quot; THEN SUM([gmv])&#13;&#10;WHEN &quot;Total_Orders&quot; THEN SUM([gross_orders])&#13;&#10;WHEN &quot;New_Customers&quot; THEN SUM([new_customers])&#13;&#10;WHEN &quot;New_Customers_Vendor&quot; THEN SUM([new_customers_vendor])&#13;&#10;WHEN &quot;Failed_Orders&quot; THEN suM([failed_orders])/sum([gross_orders])&#13;&#10;WHEN &quot;Avg_Basket_Size&quot; THEN suM([gfv])/sum([valid_orders])&#13;&#10;WHEN &quot;OD_Orders&quot; THEN suM([valid_od_orders])/sum([valid_orders])&#13;&#10;WHEN &quot;Avg_Delivery_Time&quot; THEN sum([total_delivery_time])/sum([total_delivery_orders])&#13;&#10;WHEN &quot;Vendor_Delay5&quot; THEN sum([no_vendor_late_5min])/sum([no_vendor_delay_observations])&#13;&#10;WHEN &quot;Avg_Vendor_Delay&quot; THEN suM([vendor_late_mins])/sum([no_vendor_delay_observations])&#13;&#10;WHEN &quot;Avg_Cooking_Time&quot; THEN suM([sum_prep_time_mins])/sum([sum_prep_time_count])&#13;&#10;WHEN &quot;Vendor_Cancelled&quot; THEN suM([cancelled_orders])/sum([gross_orders])&#13;&#10;WHEN &quot;Complaints&quot; THEN suM([complaints])/sum([gross_orders])&#13;&#10;WHEN &quot;Vendor_Cancelled_No&quot; THEN suM([cancelled_orders])&#13;&#10;END' />
            </column>
            <column caption='(ZN([Metric Calc]) - LOOKUP(ZN([Metric Calc]), 7)) / ABS(LOOK...' datatype='real' name='[Calculation_906630925268086797]' role='measure' type='quantitative' user:unnamed='Vendor overview'>
              <calculation class='tableau' formula='(ZN([Calculation_906630925247787009]) - LOOKUP(ZN([Calculation_906630925247787009]), 7)) / ABS(LOOKUP(ZN([Calculation_906630925247787009]), 7))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metric Calc F' datatype='string' name='[Calculation_906630925269319694]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Orders&quot; THEN STR(round(SUM([valid_orders]),0)) &#13;&#10;WHEN &quot;GFV&quot; THEN STR(round(SUM([gfv]),0))&#13;&#10;WHEN &quot;GMV&quot; THEN STR(round(SUM([gmv]),0))&#13;&#10;WHEN &quot;Total_Orders&quot; THEN STR(SUM([gross_orders]))&#13;&#10;WHEN &quot;New_Customers&quot; THEN STR(SUM([new_customers]))&#13;&#10;WHEN &quot;New_Customers_Vendor&quot; THEN STR(SUM([new_customers_vendor]))&#13;&#10;WHEN &quot;Failed_Orders&quot; THEN STR(ROUND((sum([failed_orders])/sum([gross_orders]))*100,1))+&quot;%&quot;&#13;&#10;WHEN &quot;Avg_Basket_Size&quot; THEN STR(round(suM([gfv])/sum([valid_orders]),1))&#13;&#10;WHEN &quot;OD_Orders&quot; THEN STR(ROUND((suM([valid_od_orders])/sum([valid_orders]))*100,1))+&quot;%&quot;&#13;&#10;WHEN &quot;Avg_Delivery_Time&quot; THEN STR(round(sum([total_delivery_time])/sum([total_delivery_orders]),1))&#13;&#10;WHEN &quot;Vendor_Delay5&quot; THEN STR(ROUND((sum([no_vendor_late_5min])/sum([no_vendor_delay_observations]))*100,1))+&quot;%&quot;&#13;&#10;WHEN &quot;Avg_Vendor_Delay&quot; THEN STR(round(suM([vendor_late_mins])/sum([no_vendor_delay_observations]),1))&#13;&#10;WHEN &quot;Avg_Cooking_Time&quot; THEN STR(round(suM([sum_prep_time_mins])/sum([sum_prep_time_count]),1))&#13;&#10;WHEN &quot;Vendor_Cancelled&quot; THEN STR(round((suM([cancelled_orders])/sum([gross_orders]))*100,1))+&quot;%&quot;&#13;&#10;WHEN &quot;Complaints&quot; THEN STR(round((suM([complaints])/sum([gross_orders]))*100,1))+&quot;%&quot;&#13;&#10;WHEN &quot;Vendor_Cancelled_No&quot; THEN STR(SUM([cancelled_orders]))&#13;&#10;END' />
            </column>
            <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column caption='# Vendor Cancellations' datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
