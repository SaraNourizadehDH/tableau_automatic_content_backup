            <column caption='(ZN(SUM([# New Customers (to Vendor)])) - LOOKUP(ZN(SUM([# Ne...' datatype='real' name='[Calculation_1472395628212400147]' role='measure' type='quantitative' user:unnamed='Orders'>
              <calculation class='tableau' formula='(ZN(SUM([new_customers_vendor])) - LOOKUP(ZN(SUM([new_customers_vendor])), -7)) / ABS(LOOKUP(ZN(SUM([new_customers_vendor])), -7))'>
