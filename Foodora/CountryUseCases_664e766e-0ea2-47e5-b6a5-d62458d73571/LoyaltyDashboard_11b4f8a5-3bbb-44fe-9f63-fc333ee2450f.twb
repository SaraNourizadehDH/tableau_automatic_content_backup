    <worksheet name='Points'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ff2b85' fontsize='12'>YeClub Point Tracker</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#202124' fontsize='10'>To change the time view, click (+) or (-) buttons on the date columns (year, quarter, month, day) you want to see.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/LoyaltyDashboard/Points?rev=' id='Points' path='/t/Foodora/workbooks/LoyaltyDashboard' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='Point Data' name='federated.0vskzrt1n5a9z810mo3f10imxamc (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.0vskzrt1n5a9z810mo3f10imxamc (copy)'>
            <column caption='Burned Points' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1687442548180410380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([yclub_burned_points])' />
            </column>
            <column caption='Earned Points' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1687442548180471821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[yclub_earned_points]' />
            </column>
            <column caption='Conversion Rate' datatype='real' default-format='p0.00%' name='[Calculation_210543297019498496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1687442548180410380]) / SUM([Calculation_1687442548180471821])' />
            </column>
            <column caption='&apos; &apos;' datatype='string' name='[Calculation_210543297019904003]' role='dimension' type='nominal' user:unnamed='Sheet 44'>
              <calculation class='tableau' formula='&apos; &apos;' />
            </column>
            <column caption='Point Issue Date' datatype='date' name='[Calculation_210543297024737287]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[point_issue_date]' />
            </column>
            <column caption='Total Balance' datatype='integer' name='[Calculation_629941012299456514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1687442548180471821] - ([Calculation_1687442548180410380] + [Unused Points (copy)_629941012294238208])' />
            </column>
            <column caption='Expired Points' datatype='integer' default-format='n#,##0;-#,##0' name='[Unused Points (copy)_629941012294238208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(IFNULL([yclub_expired_points],0))' />
            </column>
            <column-instance column='[Calculation_629941012299456514]' derivation='Sum' name='[cum:sum:Calculation_629941012299456514:ok]' pivot='key' type='ordinal'>
              <table-calc aggregation='Sum' ordering-type='Columns' type='CumTotal' />
            </column-instance>
            <column-instance column='[Calculation_210543297024737287]' derivation='Day' name='[dy:Calculation_210543297024737287:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_210543297024737287]' derivation='Month' name='[mn:Calculation_210543297024737287:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_210543297019904003]' derivation='None' name='[none:Calculation_210543297019904003:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[point_issue_date]' role='dimension' type='ordinal' />
