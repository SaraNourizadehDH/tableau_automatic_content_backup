              <calculation class='tableau' formula='COUNTD([customer_incentive_id])' />
            </column>
            <column caption='Consumed Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1141099555680681985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ISNULL([order_id]) = FALSE and [coupon_usage_status] = &apos;consumed&apos;&#13;&#10;THEN [order_id] END)' />
            </column>
            <column caption='Total Cost' datatype='real' default-format='c&quot;₺&quot;#,##0.0;-&quot;₺&quot;#,##0.0' name='[Calculation_1141099555683651587]' role='measure' type='quantitative'>
