            </column>
            <column caption='Expired Count' datatype='real' datatype-customized='true' name='[Calculation_571675688592117763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(COUNTD(IF [Calculation_1363746262636781575] &gt;= DATE(&quot;2023-03-01&quot;) AND [Voucher Start Date (copy)_571675688592326660] &lt; TODAY() AND [coupon_usage_status] != &apos;consumed&apos; THEN [customer_incentive_id] END))' />
            </column>
            <column caption='Spendable Count' datatype='integer' datatype-customized='true' name='[Expired Count (copy)_571675688594944006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF TODAY() &gt; [Calculation_1363746262636781575] AND TODAY() &lt;= [Voucher Start Date (copy)_571675688592326660] and [coupon_usage_status] != &apos;consumed&apos; THEN [customer_incentive_id] END)' />
            </column>
            <column caption='Expired Amount' datatype='real' default-format='c&quot;₺&quot;#,##0.0;-&quot;₺&quot;#,##0.0' name='[Total Cost (copy)_571675688597934087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM(IF [Calculation_1363746262636781575] &gt;= DATE(&quot;2023-03-01&quot;) AND [Voucher Start Date (copy)_571675688592326660] - 1 &lt; TODAY() - 1 AND [coupon_usage_status] != &apos;consumed&apos; THEN [given_incentive_value] END),0)' />
            </column>
