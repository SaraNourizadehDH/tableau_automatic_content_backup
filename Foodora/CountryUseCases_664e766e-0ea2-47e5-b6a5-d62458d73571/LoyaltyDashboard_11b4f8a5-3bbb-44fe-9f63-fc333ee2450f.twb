            <column caption='Defined Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1141099555679760384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_incentive_id])' />
            </column>
            <column caption='Consumed Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1141099555680681985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ISNULL([order_id]) = FALSE and [coupon_usage_status] = &apos;consumed&apos;&#13;&#10;THEN [order_id] END)' />
            </column>
            <column caption='Total Cost' datatype='real' default-format='c&quot;₺&quot;#,##0.0;-&quot;₺&quot;#,##0.0' name='[Calculation_1141099555683651587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost]' />
            </column>
            <column aggregation='Sum' caption='Given Voucher Amount' datatype='real' default-format='c&quot;₺&quot;#,##0.0;-&quot;₺&quot;#,##0.0' name='[Calculation_1141099555683807236]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[given_incentive_value]' />
            </column>
            <column caption='Total Redeemer' datatype='integer' name='[Calculation_1206964708064206848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([pandora_customer_id])' />
            </column>
            <column caption='Spendable Voucher Risk' datatype='real' default-format='c&quot;₺&quot;#,##0.0;-&quot;₺&quot;#,##0.0' name='[Calculation_1235956627858595844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([spendable_voucher_value],0)' />
