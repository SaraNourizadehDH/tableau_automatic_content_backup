            <customized-tooltip show-buttons='false'>
              <formatted-text>
                <run fontcolor='#787878'>Info:&#9;</run>
                <run bold='true'><![CDATA[<[federated.0vskzrt1n5a9z810mo3f10imxamc].[none:Calculation_209698860001206272:nk]>]]></run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontname='Tableau Bold' fontsize='12'>DEFINITIONS</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontsize='10'>Exposed Users</run>
                <run fontalignment='0' fontsize='10'>:</run>
                <run bold='true' fontalignment='0' fontsize='10'>Æ </run>
                <run fontalignment='0' fontsize='10'>Users that while visiting the app have seen at least one the loyalty program entry points (Homepage Banner, FAB Icon, OTP Pop-up).</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontsize='10'>Loyalty P. Visitors</run>
                <run fontalignment='0' fontsize='10'>: Users who have entered the Yemeksepeti Club homepage.</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Acceptors</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>: # of users who have accepted at least one stamp card.</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Passive Users</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>: # of users who saw anything about Yemeksepeti Club (FAB icon, OTP popup etc.) or visited YS Club Homepage but did not accept any stamp card.</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Total Orders</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>:</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Æ </run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>Total number of Yemeksepeti Club orders. (If an order has completed more than one stamp for multiple stamp cards, it will only be counted once.)</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Stamp Card Count</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>:</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Æ </run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>Number of stamp cards in Yemeksepeti Club according to their status.</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'># of Users by Tier</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>: Number of users based on tiers.</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Points</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>: Total earned, spent and expired points.</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Vouchers</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>: Number of given and used coupons through Yemeksepeti Club and their total values.</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#202124' fontsize='10'>Spendable Voucher Value</run>
                <run fontalignment='0' fontcolor='#202124' fontsize='10'>: Total amount of unexpired vouchers that can be spent as of today.</run>
                <run fontalignment='0'>Æ&#10;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minheight' value='-1' />
                <format attr='maxheight' value='-1' />
              </style-rule>
