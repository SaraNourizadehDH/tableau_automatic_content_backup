    <worksheet name='voucher cost perc'>
      <table>
        <view>
          <datasources>
            <datasource caption='Voucher Data' name='federated.0vskzrt1n5a9z810mo3f10imxamc' />
          </datasources>
          <datasource-dependencies datasource='federated.0vskzrt1n5a9z810mo3f10imxamc'>
            <column caption='Voucher Start Date' datatype='date' name='[Calculation_1363746262636781575]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([voucher_start_date])' />
            </column>
            <column caption='Expired Amount % DT' datatype='real' default-format='p0.00%' name='[Expired Amount % (copy)_210543297577144339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Cost (copy)_571675688597934087]/sum([given_incentive_value])' />
            </column>
            <column caption='Spendable Voucher Value % DT' datatype='real' default-format='p0.00%' name='[Spendable Voucher Value % (copy)_210543297578438677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([spendable_voucher_value]) / sum([given_incentive_value])' />
            </column>
            <column caption='Total Cost % DT' datatype='real' default-format='p0.00%' name='[Total Cost % (copy)_210543297578176532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost]) / sum([given_incentive_value])' />
            </column>
            <column caption='Expired Amount' datatype='real' default-format='c&quot;₺&quot;#,##0.0;-&quot;₺&quot;#,##0.0' name='[Total Cost (copy)_571675688597934087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM(IF [Calculation_1363746262636781575] &gt;= DATE(&quot;2023-03-01&quot;) AND [Voucher Start Date (copy)_571675688592326660] - 1 &lt; TODAY() - 1 AND [coupon_usage_status] != &apos;consumed&apos; THEN [given_incentive_value] END),0)' />
            </column>
            <column caption='Voucher End Date' datatype='date' name='[Voucher Start Date (copy)_571675688592326660]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[voucher_end_date]' />
            </column>
            <column datatype='real' name='[cost]' role='measure' type='quantitative' />
            <column datatype='string' name='[coupon_usage_status]' role='dimension' type='nominal' />
            <column datatype='real' default-format='c&quot;₺&quot;#,##0;-&quot;₺&quot;#,##0' name='[given_incentive_value]' role='measure' type='quantitative' />
            <column caption='Voucher Internal Name' datatype='string' name='[internal_name]' role='dimension' type='nominal' />
            <column-instance column='[internal_name]' derivation='None' name='[none:internal_name:nk]' pivot='key' type='nominal' />
