            <properties context=''>
              <relation connection='bigquery.1p0m8mb0ujcrow19powb908ooc9l' name='Custom SQL Query' type='text'>select *, &#13;
    CASE&#13;
    WHEN coupon_usage_status = &apos;unused&apos; and &#13;
    (current_date(&apos;UTC+3&apos;) BETWEEN voucher_start_date and voucher_end_date) &#13;
    then given_incentive_value END as spendable_voucher_value&#13;
from `dhub-yemek.marketing_sandbox.loyalty_customer_voucher_info`</relation>
