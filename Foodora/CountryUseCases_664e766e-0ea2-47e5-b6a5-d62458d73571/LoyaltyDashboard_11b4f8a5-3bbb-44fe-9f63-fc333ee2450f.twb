      <column caption='SC Accepted User Count' datatype='integer' name='[Calculation_1036390930312511488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[accepted_user_count]' />
      </column>
      <column caption='Acceptance Ratio' datatype='real' name='[Calculation_106397607562985472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1036390930312511488] / [Calculation_283304571243704320]' />
      </column>
      <column caption='Stamp Card Id &amp; Name' datatype='string' name='[Calculation_188306827204861952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stamp_card_id] = 108 THEN &quot;3 Food Orders (Seg 0-1 AB-5%)&quot;&#10;ELSEIF [stamp_card_id] = 110 THEN &quot;5 Food Orders (Seg 0-1 AB 95%)&quot;&#10;ELSEIF [stamp_card_id] = 111 THEN &quot;4 Food Orders (Seg 2-3 AB 5%)&quot;&#10;ELSEIF [stamp_card_id] = 109 THEN &quot;5 Food Orders (Seg 2-3  AB 95%)&quot;&#10;&#10;ELSEIF [stamp_card_id] = 116 THEN &quot;3 Food Orders (Seg 0-2 AB 10%)&quot;&#10;ELSEIF [stamp_card_id] = 117 THEN &quot;5 Food Orders (Seg 0-2 AB 90%)&quot;&#10;ELSEIF [stamp_card_id] = 118 THEN &quot;4 Food Orders (Seg 3-5 AB 10%)&quot;&#10;ELSEIF [stamp_card_id] = 119 THEN &quot;5 Food Orders (Seg 3-5 AB 90%)&quot;&#10;ELSEIF [stamp_card_id] = 120 THEN &quot;5 Food Orders (Seg 6-8 AB 10%)&quot;&#10;ELSEIF [stamp_card_id] = 121 THEN &quot;5 Food Orders (Seg 6-8 AB 90%)&quot;&#10;ELSEIF [stamp_card_id] = 122 THEN &quot;5 Food Orders (Seg 9+)&quot;&#10;&#10;ELSEIF [stamp_card_id] = 125 THEN &quot;3 Food Orders (Seg 0-2 AB Missing 10%)&quot;&#10;ELSEIF [stamp_card_id] = 126 THEN &quot;4 Food Orders (Seg 3-5 AB Missing 10%)&quot;&#10;ELSEIF [stamp_card_id] = 127 THEN &quot;5 Food Orders (Seg 6-8 AB Missing 10%)&quot;&#10;&#10;ELSEIF [stamp_card_id] = 142 THEN &quot;5 Food Orders (&gt;=4 FO in L60D)&quot;&#10;ELSEIF [stamp_card_id] = 141 THEN &quot;5 Food Orders (&lt;4 FO in L60D)&quot;&#10;ELSEIF [stamp_card_id] = 145 THEN &quot;First Bite (Dynamic AT for NCs)&quot;&#10;&#10;ELSE&#10;[stamp_card_name] + &quot; (&quot; + STR([stamp_card_id]) + &quot;)&quot; END' />
      </column>
      <column caption='potential_users' datatype='integer' name='[Calculation_283304571243704320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([num_of_total_audience]) THEN [tier_all_running_sum] ELSE [num_of_total_audience] END' />
      </column>
      <column caption='SC Name Corrected' datatype='string' name='[Stamp Card Id &amp; Name (copy)_188306827257315332]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stamp_card_id] = 108 THEN &quot;3 Food Orders (Seg 0-1 AB 5%)&quot;&#10;ELSEIF [stamp_card_id] = 110 THEN &quot;5 Food Orders (Seg 0-1 AB 95%)&quot;&#10;ELSEIF [stamp_card_id] = 111 THEN &quot;4 Food Orders (Seg 2-3 AB 5%)&quot;&#10;ELSEIF [stamp_card_id] = 109 THEN &quot;5 Food Orders (Seg 2-3 AB 95%)&quot;&#10;&#10;ELSEIF [stamp_card_id] = 116 THEN &quot;3 Food Orders (Seg 0-2 AB 10%)&quot;&#10;ELSEIF [stamp_card_id] = 117 THEN &quot;5 Food Orders (Seg 0-2 AB 90%)&quot;&#10;ELSEIF [stamp_card_id] = 118 THEN &quot;4 Food Orders (Seg 3-5 AB 10%)&quot;&#10;ELSEIF [stamp_card_id] = 119 THEN &quot;5 Food Orders (Seg 3-5 AB 90%)&quot;&#10;ELSEIF [stamp_card_id] = 120 THEN &quot;5 Food Orders (Seg 6-8 AB 10%)&quot;&#10;ELSEIF [stamp_card_id] = 121 THEN &quot;5 Food Orders (Seg 6-8 AB 90%)&quot;&#10;ELSEIF [stamp_card_id] = 122 THEN &quot;5 Food Orders (Seg 9+)&quot;&#10;&#10;ELSEIF [stamp_card_id] = 125 THEN &quot;3 Food Orders (Seg 0-2 AB Missing 10%)&quot;&#10;ELSEIF [stamp_card_id] = 126 THEN &quot;4 Food Orders (Seg 3-5 AB Missing 10%)&quot;&#10;ELSEIF [stamp_card_id] = 127 THEN &quot;5 Food Orders (Seg 6-8 AB Missing 10%)&quot;&#10;&#10;ELSEIF [stamp_card_id] = 142 THEN &quot;5 Food Orders (&gt;=4 FO in L60D)&quot;&#10;ELSEIF [stamp_card_id] = 141 THEN &quot;5 Food Orders (&lt;4 FO in L60D)&quot;&#10;ELSEIF [stamp_card_id] = 145 THEN &quot;First Bite (Dynamic AT for NCs)&quot;&#10;&#10;&#10;ELSE&#10;[stamp_card_name]END' />
