            <column-instance column='[Total Cost % (copy)_210543297578176532]' derivation='User' name='[usr:Total Cost % (copy)_210543297578176532:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[voucher_end_date]' role='dimension' type='ordinal' />
