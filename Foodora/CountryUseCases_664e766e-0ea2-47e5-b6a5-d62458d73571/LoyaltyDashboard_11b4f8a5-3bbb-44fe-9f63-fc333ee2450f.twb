    <datasource caption='Points &amp; costs' inline='true' name='federated.0ii0ruh1nl4m21180y3tf1tsgs9f' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.09phhyd0nh17ky1cbogf21maf5ke'>
            <connection CATALOG='dhub-yemek' EXECCATALOG='dhub-yemek' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhub-yemek' schema='marketing_sandbox' server-oauth='' username='yasemen.alayoglu@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.09phhyd0nh17ky1cbogf21maf5ke' name='Custom SQL Query' type='text'><![CDATA[select 
point_issue_date as yclubDate,
yclub_earned_points as metric,
"Earned Points" as metricName
from `dhub-yemek.marketing_sandbox.loyalty_report_earned_burned_points_agg` 
where  point_issue_date >>= '2023-03-01' and point_issue_date << current_date('UTC+3')
union all

select 
point_issue_date as yclubDate,
abs(yclub_burned_points) as metric,
"Burned Points" as metricName
from `dhub-yemek.marketing_sandbox.loyalty_report_earned_burned_points_agg` 
where  point_issue_date >>= '2023-03-01' and point_issue_date << current_date('UTC+3')

union all

select 
order_date as yclubDate,
sum(cost) as  metric,
"Burned Vouchers" as metricName
from `dhub-yemek.marketing_sandbox.loyalty_customer_voucher_info`
where  order_date >>= '2023-03-01' and order_date << current_date('UTC+3')
group by 1,3

union all

select 
min_accept_date as yclubDate,
count(distinct pandora_customer_id) as  metric,
"Cum. Challenge Accepters" as metricName
from 
(
select 
pandora_customer_id,
FORMAT_DATE('%Y-%m', stamp_card_accept_date) as YearMonth,
min(stamp_card_accept_date) as min_accept_date
from `dhub-yemek.marketing_sandbox.loyalty_customer_stamp_info`
where  stamp_card_accept_date >>= '2023-03-01' and stamp_card_accept_date << current_date('UTC+3')
group by 1,2
)
group by 1,3

union all

select 
min_date as yclubDate,
count(distinct pandora_customer_id) as  metric,
"Cum. Active Participants" as metricName
from (
  SELECT
        sub1.pandora_customer_id,
        FORMAT_DATE('%Y-%m', sub1.date) as YearMonth,
        min(fo.created_date_local) as min_date
      FROM
        (
          select
          pandora_customer_id,
          stamp_card_accept_date as date
          from `dhub-yemek.marketing_sandbox.loyalty_customer_stamp_info` 
          
          UNION DISTINCT

          select
          pandora_customer_id,
          order_create_date as date
          from `dhub-yemek.marketing_sandbox.loyalty_customer_stamp_info`
          where order_status <<>> 'cancelled'

          UNION DISTINCT

          select
          upper(customer_code) as pandora_customer_id,
          DATE(DATETIME(TIMESTAMP(created_at_utc), "UTC+3")) as date
          from `fulfillment-dwh-production.pandata_curated.rewards_wallet_point_transactions`
          where global_entity_id = 'YS_TR' and DATE(DATETIME(TIMESTAMP(created_at_utc), "UTC+3")) >>= '2023-03-01' and status in (2,3) and ref_type = 2

          UNION DISTINCT

          select
          pandora_customer_id,
          date(order_date) as date
          from `dhub-yemek.marketing_sandbox.loyalty_customer_voucher_info`
          where coupon_usage_status = 'consumed'
        ) sub1
        inner join `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` fo
         on lower(sub1.pandora_customer_id) = fo.customer_code and FORMAT_DATE('%Y-%m', sub1.date) = FORMAT_DATE('%Y-%m', fo.created_date_local) and created_date_utc >>= '2023-03-01'
        and is_valid_order is true and global_entity_id = 'YS_TR' and created_date_local << current_date('UTC+3')
      group by 1,2
)
group by 1,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
