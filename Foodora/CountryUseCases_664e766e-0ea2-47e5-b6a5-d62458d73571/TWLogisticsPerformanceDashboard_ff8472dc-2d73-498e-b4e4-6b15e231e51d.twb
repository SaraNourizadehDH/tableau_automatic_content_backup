            <column caption='weekly|%growth_contribution' datatype='real' default-format='p0.00%' name='[Calculation_485966553231273985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN TOTAL([order_growth_rate （複製）_1689905395917967387])*([order_difference （複製）_1689905395917860888]/TOTAL([order_difference （複製）_1689905395917860888]))&#10;WHEN &quot;GFV&quot; THEN TOTAL([order_growth_rate （複製）_1689905395917967387])*([order_difference （複製）_1689905395917860888]/TOTAL([order_difference （複製）_1689905395917860888]))&#10;WHEN &quot;GMV&quot; THEN TOTAL([order_growth_rate （複製）_1689905395917967387])*([order_difference （複製）_1689905395917860888]/TOTAL([order_difference （複製）_1689905395917860888]))&#10;WHEN &quot;Incentive Cost&quot; THEN TOTAL([order_growth_rate （複製）_1689905395917967387])*([order_difference （複製）_1689905395917860888]/TOTAL([order_difference （複製）_1689905395917860888]))&#10;ELSE NULL&#10;END'>
                <table-calc ordering-type='Rows' />
