            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.13l97ie121shsj19zuqse1hfh9f0].[Calculation_1457970017161793536]' caption='daily|tracking' datatype='date' default-format='*YYYY-MM-DD' name='[week_type 參數]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-13#'>
