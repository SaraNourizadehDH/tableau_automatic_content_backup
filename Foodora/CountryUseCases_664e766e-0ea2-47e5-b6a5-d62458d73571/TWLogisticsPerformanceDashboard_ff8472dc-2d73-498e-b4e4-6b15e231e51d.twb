            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.13l97ie121shsj19zuqse1hfh9f0].[max_date （複製）_1006976736181342245]' _.fcp.ParameterDefaultValues.true...source-field='[sqlproxy.13l97ie121shsj19zuqse1hfh9f0].[Calculation_3805330613110202368]' caption='weekly|tracking' datatype='date' datatype-customized='true' default-format='*YYYY-MM-DD' name='[tracking_date （複製）_1689905395915759636]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-07#'>
