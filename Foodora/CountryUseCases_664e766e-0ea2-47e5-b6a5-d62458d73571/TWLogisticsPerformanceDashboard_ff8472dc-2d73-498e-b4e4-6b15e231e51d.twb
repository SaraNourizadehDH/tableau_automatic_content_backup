            <column caption='ICPGMV%' datatype='string' default-format='N' name='[daily|#tracking （複製）_3126061100028321792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;DT &gt; 45 %&quot; THEN &quot;%&quot;&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN &quot;%&quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='weekly|marked' datatype='string' name='[daily|marked （複製）_1689905395916369943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK([report_date]) = ISOWEEK([Parameters].[tracking_date （複製）_1689905395915759636]) THEN &quot;marked&quot; &#10;ELSEIF ISOWEEK([report_date]) = ISOWEEK(DATEADD(&quot;week&quot;, [Parameters].[past_N （複製）_360287976102625280]*(-1),[Parameters].[tracking_date （複製）_1689905395915759636])) THEN &quot;marked&quot; &#10;ELSE &quot;normal&quot; &#10;END' />
