              <calculation class='tableau' formula='7' />
              <range granularity='1' max='90' min='1' />
            </column>
            <column caption='metric_parameter' datatype='string' name='[tracking_date （複製）]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. DT&quot;'>
              <calculation class='tableau' formula='&quot;Avg. DT&quot;' />
