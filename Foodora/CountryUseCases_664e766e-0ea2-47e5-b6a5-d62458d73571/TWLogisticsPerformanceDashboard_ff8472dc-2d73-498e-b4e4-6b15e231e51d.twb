            <column caption='ICPGMV%' datatype='string' default-format='N' name='[daily|#tracking （複製）_3126061100028321792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;DT &gt; 45 %&quot; THEN &quot;%&quot;&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN &quot;%&quot;&#10;ELSE &quot;&quot;&#10;END' />
