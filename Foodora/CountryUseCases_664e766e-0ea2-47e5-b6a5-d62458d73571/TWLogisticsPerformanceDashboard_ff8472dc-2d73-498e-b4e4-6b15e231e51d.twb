            <column caption='ICPGMV%' datatype='string' default-format='N' name='[daily|#tracking （複製）_3126061100028321792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;DT &gt; 45 %&quot; THEN &quot;%&quot;&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN &quot;%&quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='daily|%growth_contribution_tooltip' datatype='string' default-format='p0.00%' name='[daily|%growth_contribution （複製）_3126061100077588483]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN &quot;Growth Contribution: &quot;&#10;WHEN &quot;GFV&quot; THEN &quot;Growth Contribution: &quot;&#10;WHEN &quot;GMV&quot; THEN &quot;Growth Contribution: &quot;&#10;WHEN &quot;Incentive Cost&quot; THEN &quot;Growth Contribution: &quot;&#10;ELSE &quot;&quot;&#10;END' />
