            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.13l97ie121shsj19zuqse1hfh9f0].[Calculation_1457970017161793536]' caption='daily|tracking' datatype='date' default-format='*YYYY-MM-DD' name='[week_type 參數]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-13#'>
              <calculation class='tableau' formula='#2025-07-13#' />
              <range granularity='1' max='#2025-12-31#' min='#2024-01-01#' period-type-v2='day' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.13l97ie121shsj19zuqse1hfh9f0'>
            <column caption='max_date' datatype='date' name='[Calculation_1457970017161793536]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED :MAX((IF YEAR([report_date])=YEAR(today()-1) THEN [report_date] END))}' />
            </column>
            <column caption='daily|#tracking' datatype='real' default-format='N' name='[Calculation_1689905395867242499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Avg. DT&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [actual_dt] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] - [preorders] END), 2)&#10;WHEN &quot;DT &gt; 45 %&quot; THEN ROUND( SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [dt_45_orders] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] END), 4) * 100&#10;WHEN &quot;Planned Rider Hour&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [planned_rh] END), 0)&#10;WHEN &quot;Actual Rider Hour&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [actual_rh] END), 0)&#10;WHEN &quot;Actual Working Rider Hour&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [actual_rh] - [break_rh] END), 0)&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN ROUND( SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [shrinkage_2_duration]+[shrinkage_3_duration]+[shrinkage_4_duration] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [operating_mins] END), 4) * 100&#10;WHEN &quot;UTR&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [actual_rh] END),2)&#10;WHEN &quot;UTR w/o Break&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [orders] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [actual_rh] - [break_rh] END), 2)&#10;WHEN &quot;Fleet Bonus CPO&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [fleet_bonus] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [cpo_deliveries] END), 2)&#10;WHEN &quot;Rainfall&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] THEN [total_precp] END), 0)&#10;WHEN &quot;Temperature&quot; THEN ROUND(AVG(IF [report_date] = [Parameters].[week_type 參數] THEN [avg_temperature] END), 2)&#10;END' />
            </column>
            <column caption='daily|#previous' datatype='real' default-format='N' name='[Calculation_1689905395867418628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Avg. DT&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [actual_dt] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] - [preorders] END), 2)&#10;WHEN &quot;DT &gt; 45 %&quot; THEN ROUND( SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [dt_45_orders] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END),4 ) * 100&#10;WHEN &quot;Planned Rider Hour&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [planned_rh] END), 0)&#10;WHEN &quot;Actual Rider Hour&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [actual_rh] END), 0)&#10;WHEN &quot;Actual Working Rider Hour&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [actual_rh] - [break_rh] END), 0)&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN ROUND( SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [shrinkage_2_duration]+[shrinkage_3_duration]+[shrinkage_4_duration] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [operating_mins] END), 4) * 100&#10;WHEN &quot;UTR&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [actual_rh] END), 2)&#10;WHEN &quot;UTR w/o Break&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [orders] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [actual_rh] - [break_rh] END), 2)&#10;WHEN &quot;Fleet Bonus CPO&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [fleet_bonus] END) / SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [cpo_deliveries] END), 2)&#10;WHEN &quot;Rainfall&quot; THEN ROUND(SUM(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [total_precp] END), 0)&#10;WHEN &quot;Temperature&quot; THEN ROUND(AVG(IF [report_date] = [Parameters].[week_type 參數] - [Parameters].[report_week 參數] THEN [avg_temperature] END), 2)&#10;END' />
            </column>
