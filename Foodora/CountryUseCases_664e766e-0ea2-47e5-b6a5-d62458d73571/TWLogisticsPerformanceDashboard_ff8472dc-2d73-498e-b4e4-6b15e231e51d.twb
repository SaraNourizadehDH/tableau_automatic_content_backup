            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[actual_rh]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column-instance column='[daily|#tracking （複製）_3126061100028321792]' derivation='Attribute' name='[attr:daily|#tracking （複製）_3126061100028321792:nk]' pivot='key' type='nominal' />
            <column-instance column='[daily|%growth_contribution （複製）_3126061100077588483]' derivation='Attribute' name='[attr:daily|%growth_contribution （複製）_3126061100077588483:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[avg_temperature]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[break_rh]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[city_name]' pivot='key' role='dimension' semantic-role='[City].[Name]' type='nominal' user-datatype='string' visual-totals='Default' />
