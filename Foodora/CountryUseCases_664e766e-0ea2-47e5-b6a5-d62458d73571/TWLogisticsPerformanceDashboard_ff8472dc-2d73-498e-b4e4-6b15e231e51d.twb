            <column caption='daily|#difference' datatype='real' default-format='N' name='[Calculation_1689905395867779079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Avg. DT&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;WHEN &quot;DT &gt; 45 %&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;WHEN &quot;Planned Rider Hour&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 0)&#10;WHEN &quot;Actual Rider Hour&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 0)&#10;WHEN &quot;Actual Working Rider Hour&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 0)&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;WHEN &quot;UTR&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;WHEN &quot;DFO&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;WHEN &quot;UTR w/o Break&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;WHEN &quot;Fleet Bonus CPO&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;WHEN &quot;Rainfall&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 0)&#10;WHEN &quot;Temperature&quot; THEN ROUND([Calculation_1689905395867242499]-[Calculation_1689905395867418628], 2)&#10;END' />
            </column>
            <column caption='daily|%growth_contribution' datatype='real' default-format='p0.00%' name='[Calculation_485966553228398592]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Orders&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;WHEN &quot;GFV&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;WHEN &quot;GMV&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;WHEN &quot;Incentive Cost&quot; THEN&#10;TOTAL([Calculation_1689905395867611141])*([Calculation_1689905395867779079]/TOTAL([Calculation_1689905395867779079]))&#10;ELSE NULL&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
