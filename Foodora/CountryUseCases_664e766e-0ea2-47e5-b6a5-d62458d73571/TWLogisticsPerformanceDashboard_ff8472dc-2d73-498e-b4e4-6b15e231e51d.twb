            <column caption='max_date' datatype='date' name='[Calculation_1457970017161793536]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED :MAX((IF YEAR([report_date])=YEAR(today()-1) THEN [report_date] END))}' />
            </column>
            <column caption='date' datatype='string' name='[Calculation_1689905395868254216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date]))+&quot;-&quot;+STR(MONTH([report_date]))+&quot;-&quot;+STR(DAY([report_date]))' />
            </column>
            <column caption='daily|marked' datatype='string' name='[Calculation_1689905395869061130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] IN ([Parameters].[week_type 參數],[Parameters].[week_type 參數]-[Parameters].[report_week 參數]) THEN &quot;marked&quot; ELSE &quot;normal&quot; END' />
            </column>
            <column caption='weekday' datatype='string' name='[Calculation_1689905395870511115]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;weekday&apos;,[report_date]),3)' />
            </column>
            <column caption='month' datatype='string' name='[Calculation_1689905395914342418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&quot;month&quot;,[report_date]),3)' />
            </column>
            <column caption='week' datatype='integer' name='[Calculation_2049982262750007296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ISOWEEK([report_date])' />
            </column>
            <column caption='metric' datatype='real' default-format='N' name='[Calculation_231372437067448324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Avg. DT&quot; THEN ROUND(SUM([actual_dt]) / SUM([orders]-[preorders]), 2)&#10;WHEN &quot;DT &gt; 45 %&quot; THEN ROUND(SUM([dt_45_orders]) / SUM([orders]), 4) * 100&#10;WHEN &quot;Planned Rider Hour&quot; THEN ROUND(SUM([planned_rh]), 0)&#10;WHEN &quot;Actual Rider Hour&quot; THEN ROUND(SUM([actual_rh]), 0)&#10;WHEN &quot;Actual Working Rider Hour&quot; THEN ROUND(SUM([actual_rh]-[break_rh]), 0)&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN ROUND(SUM([shrinkage_2_duration]+[shrinkage_3_duration]+[shrinkage_4_duration]) / SUM([operating_mins]), 4) * 100&#10;WHEN &quot;UTR&quot; THEN ROUND(SUM([orders]) / SUM([actual_rh]), 2)&#10;WHEN &quot;UTR w/o Break&quot; THEN ROUND(SUM([orders]) / SUM([actual_rh]-[break_rh]), 2)&#10;WHEN &quot;Fleet Bonus CPO&quot; THEN ROUND(SUM([fleet_bonus]) / SUM([cpo_deliveries]), 2)&#10;WHEN &quot;Rainfall&quot; THEN ROUND(SUM([total_precp]), 0)&#10;WHEN &quot;Temperature&quot; THEN ROUND(AVG([avg_temperature]), 2)&#10;END' />
            </column>
            <column caption='dynamic_date_period' datatype='string' name='[Calculation_360287976120664070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[week_type 參數] - 14&#10;AND [report_date] &lt;= [Parameters].[week_type 參數]&#10;THEN &quot;In Range&quot; &#10;ELSE &quot;Out of Range&quot; &#10;END' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[actual_dt]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[actual_rh]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column-instance column='[daily|#tracking （複製）_3126061100028321792]' derivation='Attribute' name='[attr:daily|#tracking （複製）_3126061100028321792:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[avg_temperature]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
