            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[actual_rh]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column-instance column='[daily|#tracking （複製）_3126061100028321792]' derivation='Attribute' name='[attr:daily|#tracking （複製）_3126061100028321792:nk]' pivot='key' type='nominal' />
            <column-instance column='[pervious_date （複製）_2226467070319632384]' derivation='Attribute' name='[attr:pervious_date （複製）_2226467070319632384:qk]' pivot='key' type='quantitative' />
