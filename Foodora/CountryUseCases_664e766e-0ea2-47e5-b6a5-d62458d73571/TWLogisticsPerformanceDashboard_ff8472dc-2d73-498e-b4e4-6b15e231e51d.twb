            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[operating_mins]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column caption='weekly|#difference' datatype='real' default-format='N' name='[order_difference （複製）_1689905395917860888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Avg. DT&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 2)&#10;WHEN &quot;DT &gt; 45 %&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 2)&#10;WHEN &quot;Planned Rider Hour&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 0)&#10;WHEN &quot;Actual Rider Hour&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 0)&#10;WHEN &quot;Actual Working Rider Hour&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 0)&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828],2)&#10;WHEN &quot;UTR&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 2)&#10;WHEN &quot;DFO&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 2)&#10;WHEN &quot;UTR w/o Break&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 2)&#10;WHEN &quot;Fleet Bonus CPO&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 2)&#10;WHEN &quot;Rainfall&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 0)&#10;WHEN &quot;Temperature&quot; THEN ROUND([orders_tracking （複製）_1689905395918037021]-[orders_pervious （複製）_1689905395918028828], 2)&#10;END' />
            </column>
            <column caption='weekly|%growth_rate ' datatype='real' default-format='p0.00%' name='[order_growth_rate （複製）_1689905395917967387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_tracking （複製）_1689905395918037021]/[orders_pervious （複製）_1689905395918028828]-1' />
            </column>
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[orders]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column caption='weekly|#previous' datatype='real' default-format='N' name='[orders_pervious （複製）_1689905395918028828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[tracking_date （複製）]&#10;WHEN &quot;Avg. DT&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [actual_dt] END) /&#10;                          SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] - [preorders] END),2)&#10;&#10;WHEN &quot;DT &gt; 45 %&quot; THEN ROUND( SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [dt_45_orders] END) /&#10;                             SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] END),4) * 100&#10;&#10;WHEN &quot;Planned Rider Hour&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [planned_rh] END),0)&#10;&#10;WHEN &quot;Actual Rider Hour&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [actual_rh] END),0)&#10;&#10;WHEN &quot;Actual Working Rider Hour&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [actual_rh] - [break_rh] END), 0)&#10;&#10;WHEN &quot;Shrinkage 2+3+4&quot; THEN ROUND( SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [shrinkage_2_duration]+[shrinkage_3_duration]+[shrinkage_4_duration] END) /&#10;                                   SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [operating_mins] END), 4) * 100&#10;&#10;WHEN &quot;UTR&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] END) /&#10;                      SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [actual_rh] END), 2)&#10;&#10;WHEN &quot;UTR w/o Break&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [orders] END) /&#10;                                SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [actual_rh] - [break_rh] END), 2)&#10;&#10;WHEN &quot;Fleet Bonus CPO&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [fleet_bonus] END) /&#10;                          SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [cpo_deliveries] END), 2)&#10;WHEN &quot;Rainfall&quot; THEN ROUND(SUM(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [total_precp] END), 0)&#10;&#10;WHEN &quot;Temperature&quot; THEN ROUND(AVG(IF ISOWEEK([report_date]) = ISOWEEK([pervious_date （複製）_2226467070319632384]) AND ISOWEEKDAY([report_date])&lt;= [Calculation_2960694556260659200] THEN [avg_temperature] END), 2)&#10;END' />
