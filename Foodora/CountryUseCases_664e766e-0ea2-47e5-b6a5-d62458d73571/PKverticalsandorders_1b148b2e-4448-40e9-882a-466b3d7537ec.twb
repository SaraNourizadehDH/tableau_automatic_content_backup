    <worksheet name='Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata)' name='federated.1cmu7gg12sfwsw17ba1011wem350' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cmu7gg12sfwsw17ba1011wem350'>
            <column caption='Region' datatype='string' name='[Calculation_1622984716866797568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if LOWER([city]) in (&apos;bahawalpur&apos;, &apos;burewala&apos;, &apos;daska&apos;, &apos;dera ghazi khan&apos;, &apos;gujranwala&apos;, &apos;hafizabad&apos;, &apos;kasur&apos;, &apos;khanpur&apos;, &apos;kot addu&apos;, &apos;lahore&apos;, &apos;multan&apos;, &apos;muridke&apos;, &apos;okara&apos;, &apos;rahim yar khan&apos;, &apos;sadiqabad&apos;, &apos;sahiwal&apos;, &apos;sheikhupura&apos;, &apos;sialkot&apos;, &apos;khanewal&apos;) then &quot;Central&quot;&#13;&#10;elseif LOWER([city]) in (&apos;abbottabad&apos;, &apos;attock&apos;, &apos;chakwal&apos;, &apos;chiniot&apos;, &apos;faisalabad&apos;, &apos;gujrat&apos;, &apos;haripur&apos;, &apos;islamabad&apos;, &apos;jaranwala&apos;, &apos;jhang&apos;, &apos;jhelum&apos;, &apos;mandi bahauddin&apos;, &apos;mardan&apos;, &apos;mirpur&apos;, &apos;murree&apos;, &apos;muzaffarabad&apos;, &apos;peshawar&apos;, &apos;sargodha&apos;, &apos;toba tek singh&apos;, &apos;wah&apos;, &apos;wah cantt&apos;, &apos;wazirabad&apos;) then &quot;North&quot;&#13;&#10;elseif LOWER([city]) in (&apos;hyderabad&apos;, &apos;karachi&apos;, &apos;larkana&apos;, &apos;mirpur khas&apos;, &apos;nawabshah&apos;, &apos;quetta&apos;, &apos;sukkur&apos;) then &quot;South&quot;&#13;&#10;else &quot;Expansion&quot; end' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_471189135462453248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10;when &apos;Day&apos; then STR([date])&#13;&#10;when &apos;Week&apos; then STR(DATETRUNC(&apos;iso-week&apos;, [date]))&#13;&#10;when &apos;Month&apos; then STR(STR(DATETRUNC(&apos;month&apos;, [date])))&#13;&#10;END' />
            </column>
            <column caption='Day name' datatype='string' name='[Calculation_4901816365775556609]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[date])' />
            </column>
