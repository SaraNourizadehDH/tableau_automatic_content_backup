      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_D847E41B59D543B882A9C01E0E47BACF'>
            <properties context=''>
              <relation connection='bigquery.108ewpw09kjlyu15ltat11xrth3l' name='Custom SQL Query' type='text'>WITH platform_orders AS (
SELECT
  vendor_info.vertical,
  pd_orders.expedition_type,
  CASE
    WHEN cp_orders.is_corporate_order THEN &apos;corporate&apos;
    ELSE &apos;not corporate&apos;
  END AS is_corporate,
  CASE
    WHEN pd_orders.expedition_type = &apos;delivery&apos; AND pd_orders.is_own_delivery THEN &apos;Own Delivery&apos;
    WHEN pd_orders.expedition_type = &apos;delivery&apos; AND NOT pd_orders.is_own_delivery THEN &apos;Vendor Delivery&apos;
    ELSE &apos;Not Applicable&apos;
  END AS delivery_type,
  CASE
    WHEN pd_orders.is_valid_order THEN &apos;completed&apos;
    ELSE &apos;cancelled&apos;
  END AS status,
  vendor_info.account_type AS classification, 
  pd_orders.created_date_local AS date_local,
  LOWER(vendor_info.lg_city) AS city,
  LOWER(vendor_info.lg_zone_name) AS zone_name,
  COUNT(DISTINCT pd_orders.code) AS orders,
FROM `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` AS vdr_svc_vendors
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS sf_accounts
        ON sf_accounts.global_vendor_id = vdr_svc_vendors.vdr_svc_salesforce_id
      AND sf_accounts.global_entity_id = vdr_svc_vendors.global_entity_id
LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
        ON pd_orders.vendor_code = vdr_svc_vendors.vendor_code
      AND pd_orders.global_entity_id = vdr_svc_vendors.global_entity_id
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_cp_orders` AS cp_orders
        ON cp_orders.order_code = pd_orders.code
      AND cp_orders.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH),INTERVAL 8 MONTH)
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
        ON vendor_info.vendor_code = vdr_svc_vendors.vendor_code
WHERE vdr_svc_vendors.global_entity_id = &apos;FP_PK&apos;
  AND pd_orders.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH),INTERVAL 8 MONTH)
  AND pd_orders.created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH),INTERVAL 8 MONTH)
  AND pd_orders.is_gross_order
  AND NOT pd_orders.is_test_order
  AND vendor_info.vertical = &apos;restaurants&apos;
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9)

SELECT 
  date_local AS date, 
  &apos;FP_PK&apos; AS global_entity_id,
  case when expedition_type = &apos;pickup&apos; then &apos;pickup&apos; else vertical end as vertical,
  status,
  is_corporate,
  expedition_type,
  delivery_type, 
  city, 
  zone_name, 
  classification,
  orders
FROM platform_orders
WHERE date_local != CURRENT_DATE()</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
