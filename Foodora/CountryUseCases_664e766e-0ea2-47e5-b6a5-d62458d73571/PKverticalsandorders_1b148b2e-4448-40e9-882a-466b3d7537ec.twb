      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Migrated Data' id='Migrated Data'>
            <properties context=''>
              <relation connection='bigquery.0znc4ud0c6f6k61empppi1cgoc8y' name='Custom SQL Query' type='text'><![CDATA[WITH pandago_B2B AS(
  WITH one AS (
  SELECT 
    platform_order_code AS order_code,
    order_value,
    transitions.state,
    transitions.rider_id || "_" || lg.country_code AS lg_rider_uuid,
    DATETIME(transitions.created_at, lg.timezone) AS created_date_local,
    ARRAY_LENGTH(deliveries.transitions) AS size,
    ROW_NUMBER() OVER(PARTITION BY platform_order_code ORDER BY DATETIME(transitions.created_at, lg.timezone) DESC) AS position
  FROM `fulfillment-dwh-production.curated_data_shared.orders` AS lg
  LEFT JOIN UNNEST(deliveries) AS deliveries
         ON deliveries.is_primary
  LEFT JOIN UNNEST(deliveries.transitions) AS transitions
         ON transitions.latest
  WHERE lg.created_date BETWEEN CURRENT_DATE("Asia/Karachi") - 180 AND CURRENT_DATE("Asia/Karachi") + 2
    AND lg.country_code = "pk"
    AND lg.platform = "ODR_PK"
),

trans AS (
SELECT 
  *
FROM one
WHERE position = 2 
  OR (size = 1 AND position = 1)
),

sf_accounts_tax AS (
  SELECT DISTINCT
    sf_accounts.vendor_code,
    sf_accounts.global_vendor_id,
    sf_accounts.name AS account_name,
    sf_accounts.owner_name,
    sf_accounts.restaurant_city AS sf_city,
    addresses.administrative_area_name AS province,
    CASE
      WHEN addresses.administrative_area_name IN ("Punjab", "Islamabad", "AJK") THEN 0.16
      WHEN addresses.administrative_area_name = "Sindh" THEN 0.15
      WHEN addresses.administrative_area_name = "Balochistan" THEN 0.15
      WHEN addresses.administrative_area_name = "KPK" THEN 0.02
    END AS tax
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_sf_accounts` AS sf_accounts
  INNER JOIN UNNEST(sf_accounts.addresses) AS addresses
          -- ON addresses.is_type_restaurant_address
          ON NOT addresses.is_deleted
  INNER JOIN `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` AS vdr_svc_vendors
          ON LOWER(sf_accounts.global_vendor_id) = LOWER(vdr_svc_vendors.vdr_svc_salesforce_id)
         AND sf_accounts.record_country_name = "Pakistan"
  WHERE vdr_svc_vendors.global_entity_id = "FP_PK"
),

exceptions_list AS (
  SELECT
    vendor_name,
    vendor_code,
    lg_order_status,
    delivery_status
  FROM `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pandago_exception_list`
),

returned_orders_sheet AS (
  SELECT
    order_code,
    CASE
      WHEN rider_returned = "Yes" THEN TRUE
      WHEN rider_returned = "No" THEN FALSE
    END AS is_order_returned_to_vendor
  FROM `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pandago_returned_orders`
),

city_list AS (
  SELECT
    countries.country_iso,
    countries.country_name,
    cities.id AS city_id,
    cities.name AS city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS countries
  LEFT JOIN UNNEST(cities) AS cities
  WHERE LOWER(countries.country_iso) LIKE "%pk%"
),

return_deliveries AS (
  SELECT 
    order_code,
    global_entity_id,
    deliveries.delivery_status,
    deliveries.is_returning_delivery,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_logistics`
  LEFT JOIN UNNEST(deliveries) AS deliveries
  WHERE global_entity_id = 'ODR_PK'
    AND created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
    AND created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
    AND DATE(placed_at_local) >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
    AND vendor_code != "pgo"
    AND deliveries.is_returning_delivery
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_code ORDER BY placed_at_local DESC) = 1
),

pg AS (
  SELECT
    "PandaGo" AS vertical,
    "not corporate" AS corporate,
    "delivery" AS expedition_type,
    "Own Delivery" AS delivery_type,
    lg_orders.order_code,
    DATE(lg_orders.placed_at_local) AS order_placed_date_local,
    sf_accounts_tax.sf_city AS city_name,
    CASE
      WHEN ((DATE(lg_orders.placed_at_local) << "2024-10-14" AND deliveries.delivery_status = "completed")
      OR (DATE(lg_orders.placed_at_local) >>= "2024-10-14" AND return_deliveries.delivery_status = "completed"))
      AND lg_orders.hurrier_order_status = "cancelled"
      AND exceptions_list.vendor_code IS NULL
      AND return_rules.vendor_code IS NOT NULL
      AND returned_orders_sheet.is_order_returned_to_vendor
      THEN "Return"
      WHEN deliveries.delivery_status IN ("left_pickup", "near_dropoff", "near_pickup", "picked_up") THEN "in_progress"
      WHEN lg_orders.hurrier_order_status IN ("pending", "in_progress") THEN "in_progress"
      ELSE lg_orders.hurrier_order_status
    END AS status,
    CASE
      WHEN ((DATE(lg_orders.placed_at_local) << "2024-10-14" AND deliveries.delivery_status = "completed")
      OR (DATE(lg_orders.placed_at_local) >>= "2024-10-14" AND return_deliveries.delivery_status = "completed"))
      AND lg_orders.hurrier_order_status = "cancelled"
      AND return_rules.vendor_code IS NOT NULL
      AND returned_orders_sheet.is_order_returned_to_vendor THEN "Return"
      WHEN deliveries.delivery_status IN ("left_pickup", "near_dropoff", "near_pickup", "picked_up") THEN "in_progress"
      WHEN lg_orders.hurrier_order_status IN ("pending", "in_progress") THEN "in_progress"
      ELSE lg_orders.hurrier_order_status
    END AS status_without_exc,
    -- ST_Y(rider.customer_location_geo) AS latitude,
    -- ST_X(rider.customer_location_geo) AS longitude,
    vdr_svc_vendors.chains.chain_code,
    vdr_svc_vendors.chains.title AS chain_name,
    lg_orders.vendor_code,
    COALESCE(api_vendors_gsheet.modified_vendor_code, lg_orders.vendor_code) AS modified_vendor_code,
    vendor_info.vendor_name,
    vendor_info.lg_zone_name as sf_zone_name,
    -- vendor_mapping.account_manager,
    -- lg_orders.rider.vendor_order_number,
    lg_orders.placed_at_local AS order_placed_at_local,
    deliveries.rider_dropped_off_at_local,
    deliveries.rider_picked_up_at_local,
    deliveries.rider_accepted_at_local,
    -- lg_orders.rider.rider_accepting_time_in_seconds / 60 AS rider_accepting_time,
    DATETIME_DIFF(deliveries.rider_accepted_at_local, lg_orders.placed_at_local, MINUTE) AS rider_assign_time,
    odr_orders.order.amount_local AS amount_local_odr,
    -- COALESCE(odr_orders.order.amount_local, lg_orders.rider.order_value_local / 100) AS amount_local,    
    -- odr_orders.order.description,
    -- odr_orders.customer.location.notes,
    -- odr_orders.customer.phone_number,
    deliveries.rider_near_restaurant_at_local,
    -- lg_orders.rider.vendor_late_in_seconds / 60 AS vendor_lateness,
    -- lg_orders.rider.rider_late_in_seconds / 60 AS rider_lateness,
    TIMESTAMP_DIFF(deliveries.rider_near_restaurant_at_local, lg_orders.placed_at_local, SECOND) / 60 AS rider_arrival_time_interval,
    TIMESTAMP_DIFF(deliveries.rider_picked_up_at_local, deliveries.rider_near_restaurant_at_local, SECOND) / 60 AS rider_pickup_time_interval,
    TIMESTAMP_DIFF(deliveries.rider_dropped_off_at_local, deliveries.rider_picked_up_at_local, SECOND) / 60 AS delivery_time_calc,
    lg_orders.actual_delivery_time_in_minutes  AS delivery_time,
    -- lg_orders.rider.cancellation.reason AS cancellation_reason,
    -- lg_orders.rider.cancellation.source AS cancellation_source,
    -- COALESCE(lg_orders.stacked_delivery_count >> 0, FALSE) AS is_stacked,
    odr_orders.delivery_fee_local AS delivery_fee,
    CASE
      WHEN
        sf_accounts_tax.tax IS NULL AND province_city.admin_name IN (
          "Punjab", "Islamabad", "AJK"
        ) THEN odr_orders.delivery_fee_local / 1.16
      WHEN sf_accounts_tax.tax IS NULL AND province_city.admin_name IN ("Sindh") THEN odr_orders.delivery_fee_local / 1.15
      WHEN
        sf_accounts_tax.tax IS NULL AND province_city.admin_name IN ("Balochistan") THEN odr_orders.delivery_fee_local / 1.15
      WHEN
        sf_accounts_tax.tax IS NULL AND province_city.admin_name IN ("Balochistan") THEN odr_orders.delivery_fee_local / 1.02
      ELSE odr_orders.delivery_fee_local / (1 + sf_accounts_tax.tax)
    END AS delivery_fee_exc_tax,
    -- lg_orders.stacked_delivery_count,
    CASE
      WHEN lg_orders.vendor_code IN ("a-l98m", "a-xmrj") THEN 220
      WHEN ((DATE(lg_orders.placed_at_local) << "2024-10-14" AND deliveries.delivery_status = "completed")
      OR (DATE(lg_orders.placed_at_local) >>= "2024-10-14" AND return_deliveries.delivery_status = "completed"))
      AND lg_orders.hurrier_order_status = "cancelled"
      AND exceptions_list.vendor_code IS NULL
      AND return_rules.vendor_code IS NOT NULL
      AND returned_orders_sheet.is_order_returned_to_vendor THEN (
          odr_orders.delivery_fee_local * return_rules.multiplier
        )
      ELSE odr_orders.delivery_fee_local
    END AS delivery_fee_adj,
    CASE
      WHEN lg_orders.vendor_code IN ("a-l98m", "a-xmrj") THEN 220
      WHEN ((DATE(lg_orders.placed_at_local) << "2024-10-14" AND deliveries.delivery_status = "completed")
      OR (DATE(lg_orders.placed_at_local) >>= "2024-10-14" AND return_deliveries.delivery_status = "completed"))
      AND lg_orders.hurrier_order_status = "cancelled"
      AND exceptions_list.vendor_code IS NULL
      AND return_rules.vendor_code IS NOT NULL
      AND returned_orders_sheet.is_order_returned_to_vendor THEN (
          odr_orders.delivery_fee_local * return_rules.multiplier
        )
      ELSE odr_orders.delivery_fee_local
    END
    /
    CASE
      WHEN sf_accounts_tax.tax IS NULL AND province_city.admin_name IN ("Punjab", "Islamabad", "AJK") THEN 1.16
      WHEN sf_accounts_tax.tax IS NULL AND province_city.admin_name IN ("Sindh") THEN 1.15
      WHEN sf_accounts_tax.tax IS NULL AND province_city.admin_name IN ("Balochistan") THEN 1.15
      WHEN sf_accounts_tax.tax IS NULL AND province_city.admin_name IN ("Balochistan") THEN 1.02
      WHEN sf_accounts_tax.tax IS NULL AND province_city.admin_name IS NULL THEN 1.16
      ELSE (1 + sf_accounts_tax.tax)
    END AS delivery_fee_adj_exc_tax,
    deliveries.delivery_distance_in_meters / 1000 AS delivery_distance,
    -- COALESCE(odr_orders.order.amount_local, lg_orders.rider.order_value_local / 100) AS order_value,
    lg_orders.is_customer_cash_payment,
    odr_orders.reason,
    sf_accounts_tax.tax AS sf_accounts_tax,
    IF(return_rules.vendor_code IS NULL, FALSE, TRUE) AS is_grocery_vendor,
    returned_orders_sheet.is_order_returned_to_vendor,
    IF(pickup_compliant_vendors.vendor_code IS NULL, FALSE, TRUE) AS is_pickup_compliant_vendor
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_logistics` AS lg_orders
  LEFT JOIN UNNEST(deliveries) AS deliveries
        ON deliveries.is_primary_delivery
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` AS vdr_svc_vendors
        ON vdr_svc_vendors.global_entity_id = 'FP_PK'
        AND LOWER(lg_orders.vendor_code) = LOWER(vdr_svc_vendors.vendor_code)
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.odr_orders` AS odr_orders
        ON lg_orders.order_code = odr_orders.id
        AND odr_orders.global_entity_id = 'FP_PK'
        AND date(odr_orders.created_at_local) >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
  -- LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS odr_orders
  --        ON lg_orders.order_code = odr_orders.order_code
  --       AND lg_orders.global_entity_id = odr_orders.global_entity_id
  --       AND odr_orders.created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
  LEFT JOIN sf_accounts_tax
        ON sf_accounts_tax.vendor_code = lg_orders.vendor_code
  LEFT JOIN exceptions_list
        ON exceptions_list.vendor_code = lg_orders.vendor_code
        AND exceptions_list.lg_order_status = lg_orders.hurrier_order_status
        AND exceptions_list.delivery_status = deliveries.delivery_status
        AND deliveries.is_primary_delivery
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pandago_grocery_vendors` AS return_rules
        ON return_rules.vendor_code = lg_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendor_info
  		ON vendor_info.vendor_code = lg_orders.vendor_code
  LEFT JOIN city_list
        ON deliveries.city_id = city_list.city_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pakistan_province_city_list` AS province_city
        ON LOWER(province_city.city) = LOWER(city_list.city_name)
  LEFT JOIN returned_orders_sheet
        ON returned_orders_sheet.order_code = lg_orders.order_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pandago_pickup_compliant_vendors` AS pickup_compliant_vendors
        ON pickup_compliant_vendors.vendor_code = lg_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pandago_api_vendor_mapping` AS api_vendors_gsheet
        ON api_vendors_gsheet.vendor_code = lg_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pandago_data` AS vendor_mapping
        ON lg_orders.vendor_code = vendor_mapping.vendor_code
  LEFT JOIN return_deliveries
        ON lg_orders.order_code = return_deliveries.order_code
        -- AND return_deliveries.global_entity_id = 'FP_PK'
  WHERE lg_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
    AND DATE(lg_orders.placed_at_local) >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
    AND lg_orders.global_entity_id = "ODR_PK"
    -- AND lg_orders.rider.platform = "ODR_PK"
    AND lg_orders.created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), YEAR), INTERVAL 1 YEAR)
    AND lg_orders.vendor_code != "pgo"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY lg_orders.order_code ORDER BY lg_orders.placed_at_local DESC) = 1
),

md AS (
  SELECT DISTINCT
    pg.*,
    trans.order_code AS trans_order_code,
    trans.state AS second_last_delivery_state,
    CASE 
      WHEN trans.state in ('picked_up', 'left_pickup','near_dropoff') THEN 'post_pickup'
      WHEN trans.state in ('queued','courier_notified','accepted', 'near_pickup', 'dispatched') OR trans.state IS NULL THEN 'pre-pickup' 
    END category,
    COALESCE(amount_local_odr, order_value / 100) AS amount_local,
  FROM pg
  LEFT JOIN trans
         ON pg.order_code = trans.order_code
  WHERE pg.order_placed_date_local BETWEEN CURRENT_DATE("Asia/Karachi") - 180 AND CURRENT_DATE("Asia/Karachi") - 1
),

cs AS (
  SELECT *,
    CASE
      WHEN reason IN ("FOOD_QUALITY_SPILLAGE") 
       AND category IN ("post_pickup") 
       AND status <<>> "Return" 
       AND status <<>> "completed" 
       AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("LATE_DELIVERY") 
       AND category IN ("post_pickup") 
       AND status <<>> "Return" 
       AND status <<>> "completed" 
       AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("COURIER_UNREACHABLE") 
       AND category IN ("post_pickup") 
       AND status <<>> "Return" 
       AND status <<>> "completed" 
       AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("COURIER_ACCIDENT") 
       AND category IN ("post_pickup") 
       AND status <<>> "Return" 
       AND status <<>> "completed" 
       AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("WRONG_ORDER_ITEMS_DELIVERED") 
       AND category IN ("post_pickup") 
       AND status <<>> "Return" 
       AND status <<>> "completed" 
       AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("WRONG_ORDER_ITEMS_DELIVERED") 
       AND category IN ("pre-pickup") 
       AND NOT is_pickup_compliant_vendor 
       AND status <<>> "Return" 
       AND status <<>> "completed" 
       AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("BAD_WEATHER") 
       AND category IN ("post_pickup") 
       AND status <<>> "Return" 
       AND status <<>> "completed" 
       AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      ELSE FALSE
    END AS is_cashloss,
    CASE
      WHEN reason IN ("FOOD_QUALITY_SPILLAGE") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("LATE_DELIVERY") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("COURIER_UNREACHABLE") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("COURIER_ACCIDENT") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("BAD_WEATHER") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      ELSE FALSE
    END AS is_delivery_fee_refund,
    CASE
      WHEN reason IN ("FOOD_QUALITY_SPILLAGE") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("LATE_DELIVERY") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("COURIER_UNREACHABLE") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("COURIER_ACCIDENT") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("WRONG_ORDER_ITEMS_DELIVERED") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      WHEN reason IN ("BAD_WEATHER") 
      AND category IN ("post_pickup") 
      AND status <<>> "Return" 
      AND status <<>> "completed" 
      AND LEFT(order_code, 2) <<>> "b-" 
      THEN TRUE
      ELSE FALSE
    END AS is_order_value_refund
  FROM md
)

SELECT DISTINCT 
     "pandago B2B" AS vertical,
    "not corporate" AS is_corporate,
    "delivery" AS expedition_type,
    "Own Delivery" AS delivery_type,
    "Accounts" AS account_type,
    order_placed_date_local AS date_local,
    cs.status AS status_new,
    LOWER(city_name) AS city,
    LOWER(sf_zone_name) AS zone_name,
    COUNT(DISTINCT order_code) AS orders,
    0 AS user_paid_amount
FROM cs
where order_placed_date_local >>= DATE_SUB(date_trunc(current_date(), month), INTERVAL 8 MONTH)
Group by all
Order by 6 desc
),

pandago_c2c AS(
  SELECT
    "pandago C2C" AS vertical,
    "not corporate" AS is_corporate,
    "delivery" AS expedition_type,
    "Own Delivery" AS delivery_type,
    "Accounts" AS account_type,
    order_placed_date_local AS date_local,
    order_status AS status,
    LOWER(city) AS city,
    LOWER(lg_zone_name) AS zone_name,
    COUNT(DISTINCT order_code) AS orders,
    0 AS user_paid_amount

  FROM `fulfillment-dwh-production.pandata_report.country_PK_pandago_c2c` AS pandago_c2c

  WHERE order_placed_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), MONTH), INTERVAL 8 MONTH)

  GROUP BY
    vertical,
    is_corporate,
    expedition_type,
    delivery_type,
    account_type,
    date_local,
    status,
    vendor_code,
    city,
    zone_name
),

subscription_payments AS (
SELECT
  sb_subscriptions.global_entity_id,
  payments.internal_reference,
  payments.total_amount_local
FROM `fulfillment-dwh-production.pandata_report.regional_apac_sb_subscriptions` AS sb_subscriptions 
LEFT JOIN UNNEST(payments) AS payments
WHERE 
  sb_subscriptions.global_entity_id = "FP_PK"
  AND sb_subscriptions.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), MONTH), INTERVAL 8 MONTH)
  AND payments.is_status_success
),

vendor_info AS (
  SELECT
    vendor_code,
    vertical,
    lg_city,
    lg_zone_name,
    is_backend_test,
    is_sf_test,
    account_type
  FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_info`
),

platform_orders AS (
  SELECT
    vendor_info.vertical,
    pd_orders.expedition_type,
    CASE
      WHEN cp_orders.is_corporate_order THEN 'corporate'
      ELSE 'not corporate'
    END AS corporate,
    CASE
      WHEN pd_orders.expedition_type = 'delivery' AND pd_orders.is_own_delivery THEN 'Own Delivery'
      WHEN pd_orders.expedition_type = 'delivery' AND NOT pd_orders.is_own_delivery THEN 'Vendor Delivery'
      ELSE 'Not Applicable'
    END AS delivery_type,
    CASE
      WHEN pd_orders.is_valid_order THEN 'completed'
      ELSE 'cancelled'
    END AS status,
    vendor_info.account_type,
    pd_orders.created_date_local AS date_local,
    LOWER(vendor_info.lg_city) AS city,
    LOWER(vendor_info.lg_zone_name) AS zone_name,
    COUNT(DISTINCT pd_orders.code) AS orders,
    SUM(IFNULL(pd_orders.total_value_local, 0) - IFNULL(pd_orders.rider_tip_local, 0) - IFNULL(subscription_payments.total_amount_local, 0)) AS user_paid_amount
  FROM `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` AS vdr_svc_vendors
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS sf_accounts
         ON sf_accounts.global_vendor_id = vdr_svc_vendors.vdr_svc_salesforce_id
        AND sf_accounts.global_entity_id = vdr_svc_vendors.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
         ON pd_orders.vendor_code = vdr_svc_vendors.vendor_code
        AND pd_orders.global_entity_id = vdr_svc_vendors.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_cp_orders` AS cp_orders
         ON cp_orders.order_uid = CONCAT("FP_PK_", pd_orders.code)
        AND cp_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), MONTH),INTERVAL 8 MONTH)
  LEFT JOIN vendor_info
         ON vendor_info.vendor_code = vdr_svc_vendors.vendor_code
  LEFT JOIN subscription_payments
         ON pd_orders.code = subscription_payments.internal_reference
        AND pd_orders.global_entity_id = subscription_payments.global_entity_id
  WHERE vdr_svc_vendors.global_entity_id = 'FP_PK'
    AND pd_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), MONTH),INTERVAL 8 MONTH)
    AND pd_orders.created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), MONTH),INTERVAL 8 MONTH)
    AND pd_orders.is_gross_order
    AND NOT pd_orders.is_test_order
    AND vendor_info.vertical != 'pandago'
  GROUP BY vendor_info.vertical, pd_orders.expedition_type, corporate, delivery_type, status, vendor_info.account_type, date_local, city, zone_name
),

md AS (
  SELECT
    date_local,
    vertical,
    status,
    account_type,
    corporate AS is_corporate,
    expedition_type,
    delivery_type,
    city,
    zone_name,
    orders,
    user_paid_amount
  FROM platform_orders
  UNION ALL
  SELECT
    date_local,
    vertical,
    status_new AS status,
    account_type,
    is_corporate,
    expedition_type,
    delivery_type,
    city,
    zone_name,
    orders,
    user_paid_amount
  FROM pandago_B2B
  UNION ALL
  SELECT
    date_local,
    vertical,
    status,
    account_type,
    is_corporate,
    expedition_type,
    delivery_type,
    city,
    zone_name,
    orders,
    user_paid_amount
  FROM pandago_C2c
)

SELECT 
  date_local AS date, 
  'FP_PK' AS global_entity_id,
  case when expedition_type = 'pickup' and vertical <<>> "home chefs" then 'pickup' else vertical end as vertical,
  status,
  account_type,
  is_corporate,
  expedition_type,
  delivery_type, 
  city, 
  zone_name, 
  orders,
  user_paid_amount
FROM md
WHERE date_local >>=  DATE_SUB(date_trunc(current_date(), month), INTERVAL 8 MONTH)]]></relation>
