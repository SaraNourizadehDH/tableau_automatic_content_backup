          <named-connection caption='BigQuery' name='bigquery.108ewpw09kjlyu15ltat11xrth3l'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='foodpanda-pk-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhh---analytics-apac' schema='pandata_pk' server-oauth='' username='neha.jafri@foodpanda.pk' workgroup-auth-mode='prompt' />
