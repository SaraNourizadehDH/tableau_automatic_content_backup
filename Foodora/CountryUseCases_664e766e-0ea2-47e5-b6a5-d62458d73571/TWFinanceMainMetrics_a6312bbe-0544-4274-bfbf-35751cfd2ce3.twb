  <actions>
    <action caption='city to timeline' name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='City Finance Main Metrics' type='sheet' worksheet='city_main_kpi' />
      <link caption='city to timeline' delimiter=',' escape='\' expression='tsl:City%20Finance%20Main%20Metrics?%5Bsqlproxy.0fmqws019tilcm1dvedgu12m7vln%5D.%5Bcity%5D~s0=&lt;[city]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='city_main_kpi,city_title' />
        <param name='target' value='City Finance Main Metrics' />
      </command>
    </action>
    <action caption='highlight cities' name='[Action2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='City Finance Main Metrics' type='sheet' worksheet='city_timeline' />
      <command command='tsc:brush'>
        <param name='exclude' value='city_main_kpi,city_title' />
        <param name='special-fields' value='all' />
        <param name='target' value='City Finance Main Metrics' />
      </command>
    </action>
    <action caption='highlight dates' name='[Action3]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='City Finance Main Metrics' type='sheet'>
        <exclude-sheet name='city_title' />
      </source>
      <command command='tsc:brush'>
        <param name='exclude' value='city_title' />
        <param name='field-captions' value='datetrunc report_date,city' />
        <param name='target' value='City Finance Main Metrics' />
      </command>
    </action>
    <action caption='drill down districts of &lt;[city]&gt;' name='[Action4]'>
      <activation auto-clear='true' />
      <source dashboard='City Finance Main Metrics' type='sheet' worksheet='city_main_kpi' />
      <link caption='drill down districts of &lt;[city]&gt;' delimiter=',' escape='\' expression='tsl:District%20Finance%20Main%20Metrics?%5Bsqlproxy.0fmqws019tilcm1dvedgu12m7vln%5D.%5Bcity%5D~s0=&lt;[city]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='district_title' />
        <param name='target' value='District Finance Main Metrics' />
      </command>
    </action>
    <action caption='district to timeline' name='[Action5]'>
