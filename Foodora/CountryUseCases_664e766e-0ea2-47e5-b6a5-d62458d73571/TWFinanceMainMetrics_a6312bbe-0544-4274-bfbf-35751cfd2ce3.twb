              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;day&quot;&#13;&#10;THEN left(DATENAME(&quot;weekday&quot;, [report_date], &quot;monday&quot;), 3)&#13;&#10;ELSE STR(YEAR([Calculation_276408455384391690]))&#13;&#10;END' />
