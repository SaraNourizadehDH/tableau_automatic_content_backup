    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/TWFinanceMainMetrics/Definitions?rev=' id='244021' path='/t/Foodora/workbooks/TWFinanceMainMetrics' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
          <format attr='vertical-align' id='dash-text_88' value='top' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1400' minheight='800' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='83' param='horz' type-v2='layout-flow' w='98858' x='571' y='1000'>
            <zone h='98000' id='81' type-v2='layout-basic' w='98858' x='571' y='1000'>
              <zone forceUpdate='true' h='4375' id='5' type-v2='text' w='98858' x='571' y='1000'>
                <formatted-text>
                  <run bold='true' fontcolor='#1b1b1b' fontsize='20'>Definitions</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='93625' id='89' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='98858' x='571' y='5375'>
                <zone forceUpdate='true' h='93625' id='3' type-v2='text' w='33000' x='571' y='5375'>
                  <formatted-text>
                    <run bold='true' fontcolor='#e15759'>Report Date bases on &quot;Expected Dropoff Date&quot; not &quot;Order Date&quot;.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Figures in this dashboard account for only valid orders, which include order statuses below:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>621 - Order delivered</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>622 - Customer confirmed delivery</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>612 - Order assembled</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>62 - order accepted, customer informed</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>614 - Order picked up</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>---------------------------------------------------------------</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Valid Orders] </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'># of orders fulfill order statuses above, which could be considered as success orders.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Gmv]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Stands for Gross Merchandise Value. The amount before any subsidy.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Gfv]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Stands for Gross Food Value. The amount of food before any subsidy.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Gov]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Stands for Gross Order Value. The customer&apos;s payable amount, which should equal to the gross total (bottom line) in Backend order page.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Subscription Order Share]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Summation of subscription orders / Summation of all valid orders.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>* Subscription orders: the orders from pandapro users and with additional incentive. (free delivery, pandapro discount, pandapro voucher etc.)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[pandapro User Order Share]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Summation of pandapro orders / Summation of all valid orders.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>* pandapro orders: the orders from pandapro users.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Comm]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Foodpanda&apos;s commission (dividend) base on [Gfv].</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Comm Rate]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Foodpanda&apos;s commission rate (dividend rate) base on [Gfv].</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Pickup Order Share]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Summation of pickup orders / Summation of all valid orders.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='93625' id='88' type-v2='text' w='32929' x='33571' y='5375'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b'>[Net Df]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>The delivery fee after discounts and vouchers.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Original Df]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>The original delivery fee before any subsidy.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Container]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>The container price charge to customer.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Aov]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>The [Gov] per order.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Amv]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>The [Gmv] per order.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>[Afv]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>The [Gfv] per order.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Other &quot;Avg&quot; prefixed main kpis are per order basis.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='93625' id='90' type-v2='text' w='32929' x='66500' y='5375'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{3C817D53-0E9B-46CB-9EC9-262460AA3E15}' />
    </dashboard>
