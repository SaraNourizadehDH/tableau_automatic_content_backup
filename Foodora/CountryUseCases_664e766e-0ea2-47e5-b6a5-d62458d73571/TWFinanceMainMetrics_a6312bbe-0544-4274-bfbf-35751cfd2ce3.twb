            <column aggregation='Count' caption='datename(2) report_date' datatype='string' default-type='nominal' layered='true' name='[Calculation_276408455384498187]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;day&quot;&#13;&#10;THEN left(DATENAME(&quot;weekday&quot;, [report_date], &quot;monday&quot;), 3)&#13;&#10;ELSE STR(YEAR([Calculation_276408455384391690]))&#13;&#10;END' />
            </column>
            <column aggregation='Count' caption='datename report_date' datatype='string' default-type='nominal' layered='true' name='[Calculation_276408455384604684]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(month)|(mtd)&quot;)&#10;THEN LEFT(DATENAME(&quot;month&quot;, [report_date]), 3)&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(week)|(wtd)&quot;)&#10;THEN &quot;Week &quot; + DATENAME(&quot;iso-week&quot;, [report_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;day&quot;&#10;THEN STR([Calculation_276408455384391690])&#13;&#10;END' />
