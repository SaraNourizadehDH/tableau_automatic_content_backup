              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(month)|(mtd)&quot;)&#13;&#10;THEN DATEDIFF(&quot;month&quot;, [report_date], [Calculation_276408455382786050])&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(week)|(wtd)&quot;)&#13;&#10;THEN DATEDIFF(&quot;iso-week&quot;, [report_date], [Calculation_276408455382786050])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;day&quot;&#13;&#10;THEN DATEDIFF(&quot;day&quot;, [report_date], [Calculation_276408455382786050])&#13;&#10;END' />
