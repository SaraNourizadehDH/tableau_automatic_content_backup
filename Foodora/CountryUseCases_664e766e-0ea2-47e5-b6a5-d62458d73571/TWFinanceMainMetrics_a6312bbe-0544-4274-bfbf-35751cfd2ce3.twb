              <calculation class='tableau' formula='IF DATEPART(&quot;weekday&quot;, [Calculation_276408455382786050]) = 1&#10;THEN 7&#13;&#10;ELSE DATEPART(&quot;weekday&quot;, [Calculation_276408455382786050]) - 1&#13;&#10;END' />
