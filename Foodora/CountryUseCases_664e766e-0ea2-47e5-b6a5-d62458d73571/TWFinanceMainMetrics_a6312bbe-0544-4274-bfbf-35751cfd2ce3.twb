              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(month)|(mtd)&quot;)&#10;THEN LEFT(DATENAME(&quot;month&quot;, [report_date]), 3)&#13;&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(week)|(wtd)&quot;)&#10;THEN &quot;Week &quot; + DATENAME(&quot;iso-week&quot;, [report_date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;day&quot;&#10;THEN STR([Calculation_276408455384391690])&#13;&#10;END' />
