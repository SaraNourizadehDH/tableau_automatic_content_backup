        WHEN inventory_location LIKE &apos;LHR_Gulberg_Hub&apos; OR inventory_location LIKE &apos;LHR_&apos; THEN &apos;Lahore&apos;&#13;
        WHEN inventory_location LIKE &apos;LHR_Iqbal_Town_PS&apos; OR inventory_location LIKE &apos;LHR_&apos; THEN &apos;Lahore&apos;&#13;
        WHEN inventory_location LIKE &apos;LHR_JT_Hub&apos; OR inventory_location LIKE &apos;LHR_&apos; THEN &apos;Lahore&apos;&#13;
        WHEN inventory_location LIKE &apos;LHR_PECO_PS&apos; OR inventory_location LIKE &apos;LHR_&apos; THEN &apos;Lahore&apos;&#13;
        WHEN inventory_location LIKE &apos;LHR_PIA_PS&apos; OR inventory_location LIKE &apos;LHR_&apos; THEN &apos;Lahore&apos;&#13;
        WHEN inventory_location LIKE &apos;LHR_Shalamar_PS&apos; OR inventory_location LIKE &apos;LHR_&apos; THEN &apos;Lahore&apos;&#13;
        WHEN inventory_location LIKE &apos;LHR_Urdu_Bazar_PS&apos; OR inventory_location LIKE &apos;LHR_&apos; THEN &apos;Lahore&apos;&#13;
