      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0un2uvv0kkxisd1f2pb9o0qxdoqr].[sum:acquisition (Custom SQL Query3):qk]&quot;' value='Riders Hired' />
        </aliases>
      </column>
      <column caption='Reorder Quantity - Bags' datatype='real' name='[Calculation_1042864800609755136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1340665325728198661] = &apos;Reorder Required&apos; THEN (SUM([acquisition])/3)*1.5 END' />
      </column>
      <column caption='Average Hiring' datatype='real' name='[Calculation_1340665325722755072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisition])/90' />
      </column>
      <column caption='DOS Bags (days)' datatype='real' name='[Calculation_1340665325723013121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_title] = &quot;Delivery Bag&quot; THEN [on_hand] END)/([Calculation_1340665325722755072]*1.5)' />
      </column>
      <column caption='IOH - Bags' datatype='integer' name='[Calculation_1340665325724610562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_title] = &quot;Delivery Bag&quot; THEN [on_hand] END)' />
      </column>
      <column caption='Reorder Flag - B' datatype='string' name='[Calculation_1340665325728198661]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1340665325723013121] &lt; 35 THEN &apos;Reorder Required&apos; ELSE &quot; &quot; END' />
      </column>
      <column caption='Select Date' datatype='boolean' name='[Calculation_365917504436744192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[record_timestamp] &gt;= TODAY() - 90 AND [record_timestamp] &lt;= TODAY()' />
      </column>
      <column caption='Hub Status' datatype='string' name='[Calculation_4508314354726527038]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [city] IN (&#10;    &quot;Mandi Bahauddin&quot;, &#10;    &quot;Sheikhupura&quot;, &#10;    &quot;Attock&quot;, &#10;    &quot;Dera ghazi khan&quot;, &#10;    &quot;Jhang&quot;, &#10;    &quot;Khanewal&quot;, &#10;    &quot;Sadiqabad&quot;, &#10;    &quot;Larkana&quot;, &#10;    &quot;Mardan&quot;, &#10;    &quot;Nawabshah&quot;, &#10;    &quot;Haripur&quot;, &#10;    &quot;Okara&quot;, &#10;    &quot;Mirpur&quot;&#10;) THEN &quot;Closed&quot;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Record Date' datatype='date' name='[Calculation_5680939134263222285]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([record_timestamp])' />
      </column>
      <column caption='DOS Shirts (days)' datatype='real' name='[DOH Bags (copy)_1340665325726973955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_title] = &quot;Shirt Full Sleeves&quot; THEN [on_hand] END)/([Calculation_1340665325722755072]* 3)' />
      </column>
      <column caption='IOH - Shirts' datatype='integer' name='[IOH - Bags (copy)_1340665325727277060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_title] = &quot;Shirt Full Sleeves&quot; THEN [on_hand] END)' />
      </column>
      <column caption='Reorder Flag - S' datatype='string' name='[Reorder Flag - B (copy)_1340665325729259526]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [DOH Bags (copy)_1340665325726973955] &lt; 50 THEN &apos;Reorder Required&apos; ELSE &quot; &quot; END' />
      </column>
      <column caption='Reorder Quantity - Shirts' datatype='real' name='[Reorder Quantity - Bags (copy)_1042864800610533377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Reorder Flag - B (copy)_1340665325729259526] = &apos;Reorder Required&apos; THEN (SUM([acquisition])/3)*3 END' />
      </column>
