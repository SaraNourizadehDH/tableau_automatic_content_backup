            <connection CATALOG='publicdata' EXECCATALOG='dhub-data-commune' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='server-custom' username='mubashir@foodpanda.pk' workgroup-auth-mode='prompt' />
