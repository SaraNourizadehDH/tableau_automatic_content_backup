      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <field-sort-info field-sort-order-type='custom-order'>
        <field-sort-custom-order field='product_title' />
        <field-sort-custom-order field='variant_title' />
        <field-sort-custom-order field='hub_location' />
        <field-sort-custom-order field='city' />
        <field-sort-custom-order field='Calculation_4508314354726527038' />
        <field-sort-custom-order field='var_update_date' />
        <field-sort-custom-order field='Calculation_365917504436744192' />
        <field-sort-custom-order field='on_hand' />
        <field-sort-custom-order field='Calculation_1340665325723013121' />
        <field-sort-custom-order field='Calculation_1340665325728198661' />
        <field-sort-custom-order field='Reorder Flag - B (copy)_1340665325729259526' />
