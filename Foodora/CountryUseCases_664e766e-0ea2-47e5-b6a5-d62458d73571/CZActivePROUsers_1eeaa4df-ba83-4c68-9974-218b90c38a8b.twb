      <column caption='Month Filter' datatype='boolean' name='[Calculation_1714182640797532161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] = [Parameters].[Parameter 1] OR [report_month] = [Parameters].[Report Month (copy)_1172343328662958090]' />
