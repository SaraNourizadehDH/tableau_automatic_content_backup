    <worksheet name='TOP 30 Chains City Penetration'>
      <table>
        <view>
          <datasources>
            <datasource caption='active_pro_users_ds' name='federated.0zgvy5514lratg17u9wvd0hocuyr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric to sort by' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Subscriber Users&quot;'>
              <calculation class='tableau' formula='&quot;Subscriber Users&quot;' />
            </column>
            <column caption='Sort Desc/Asc' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Desc&quot;'>
              <calculation class='tableau' formula='&quot;Desc&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zgvy5514lratg17u9wvd0hocuyr'>
            <column caption='# Vendors with PRO Deal Top 30 Chains' datatype='integer' name='[# Vendors with PRO Deal (copy)_504966159550844933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if not isnull([pd_discount_uuid]) and [top30_chain] then [vendor_code] end)' />
            </column>
            <column caption='% Discount of GMV Top 30 Chains' datatype='real' default-format='p0.0%' name='[% Discount of GMV (copy)_504966159552466950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [top30_chain] then [all_deal_total_local] end)/sum(if [top30_chain] then [gmv_local] end)' />
            </column>
            <column caption='% GMV Coverage Top 30 Chains' datatype='real' default-format='p0.0%' name='[% GMV Coverage (copy)_504966159554318343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [top30_chain] then [gmv_local] end)/SUM([gmv_top_30_chains])' />
            </column>
            <column caption='% PRO Deal Utilization Top 30 Chains' datatype='real' default-format='p0.00%' name='[% PRO Deal Utilization (copy)_504966159558049800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [pd_discount_uuid] &lt;&gt; &apos;None&apos; and [top30_chain] THEN [orders (active_pro_deals)] END)/SUM([subscription_orders_top_30_chains])' />
            </column>
            <column caption='% Penetration PRO Users Top 30 Chains' datatype='real' default-format='p0.0%' name='[% Penetration PRO Users (copy)_504966159509680128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscriber_users_top_30_chains]) / sum([unique_users_top_30_chains])' />
            </column>
            <column caption='% Subscriber Orders Top 30 Chains' datatype='real' default-format='p0.0%' name='[% Subscriber Orders (copy)_504966159523422209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscription_orders_top_30_chains])/sum([orders_top_30_chains])' />
            </column>
            <column caption='% Subscriber Orders with PRO deal Top 30 Chains' datatype='real' default-format='p0.0%' name='[% Subscriber Orders with PRO deal (copy)_504966159524794370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_deal_orders_top_30_chains])/SUM([subscriber_orders_top_30_chains])' />
            </column>
            <column caption='% Vendors with PRO Deal Top 30 Chains' datatype='real' default-format='p0.0%' name='[% Vendors with PRO Deal  (copy)_504966159550156804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Vendors with PRO Deal (copy)_504966159550844933] / sum([vendors_with_order_top_30_chains])' />
            </column>
            <column caption='Placeholder' datatype='integer' name='[Calculation_382805998446829568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(0)' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_683421276071206921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [city] in (&apos;praha&apos;, &apos;brno&apos;, &apos;ostrava&apos;, &apos;liberec&apos;, &apos;plzen&apos;, &apos;ceske budejovice&apos;,&#13;&#10;&apos;pardubice&apos;, &apos;olomouc&apos;, &apos;hradec kralove&apos;, &apos;usti nad labem&apos;, &apos;teplice&apos;,&#13;&#10;&apos;havirov&apos;, &apos;mlada boleslav&apos;) then [city]&#13;&#10;else &apos;others&apos;&#13;&#10;END' />
            </column>
            <column caption='Metric for Rank Top Chains' datatype='real' name='[Metric for Rank (copy)_1436085333214261249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([Calculation_683421276071206921]) = &apos;others&apos; THEN NULL&#13;&#10;ELSE IFNULL(&#13;&#10;IF [Parameters].[Parameter 2] = &apos;Subscriber Users&apos; THEN SUM([subscriber_users_top_30_chains]) &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Unique Users&apos; THEN SUM([unique_users_top_30_chains]) &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Penetration PRO Users&apos; THEN [% Penetration PRO Users (copy)_504966159509680128] &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Subscriber Orders&apos; THEN [% Subscriber Orders (copy)_504966159523422209] &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Subscriber Orders with PRO deal&apos; THEN [% Subscriber Orders with PRO deal (copy)_504966159524794370]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;# Active Vendors with Order&apos; THEN SUM([vendors_with_order_top_30_chains])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;# Vendors with PRO Deal&apos; THEN [# Vendors with PRO Deal (copy)_504966159550844933]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Vendors with PRO Deal&apos; THEN [% Vendors with PRO Deal  (copy)_504966159550156804]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Discount of GMV&apos; THEN [% Discount of GMV (copy)_504966159552466950]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% GMV Coverage&apos; THEN [% GMV Coverage (copy)_504966159554318343]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% PRO Deal Utilization&apos; THEN [% PRO Deal Utilization (copy)_504966159558049800]&#13;&#10;END,0)&#13;&#10;END&#13;&#10;*&#13;&#10;IF [Parameters].[Parameter 3] = &apos;Asc&apos; THEN -1 ELSE 1 END' />
            </column>
            <column datatype='real' name='[all_deal_total_local]' role='measure' type='quantitative' />
            <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column aggregation='Sum' datatype='real' name='[foodpanda_ratio]' role='dimension' type='ordinal' />
            <column datatype='real' name='[gmv_local]' role='measure' type='quantitative' />
            <column caption='Gmv Top 30 Chains' datatype='real' name='[gmv_top_30_chains]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_683421276071206921]' derivation='None' name='[none:Calculation_683421276071206921:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[foodpanda_ratio]' derivation='None' name='[none:foodpanda_ratio:ok]' pivot='key' type='ordinal' />
            <column-instance column='[report_month]' derivation='None' name='[none:report_month:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' datatype-customized='true' default-format='n#,##0;-#,##0' name='[orders (active_pro_deals)]' role='measure' type='quantitative' />
            <column caption='Orders Top 30 Chains' datatype='integer' name='[orders_top_30_chains]' role='measure' type='quantitative' />
            <column datatype='string' name='[pd_discount_uuid]' role='dimension' type='nominal' />
            <column caption='Pro Deal Orders Top 30 Chains' datatype='integer' name='[pro_deal_orders_top_30_chains]' role='measure' type='quantitative' />
            <column datatype='date' name='[report_month]' role='dimension' type='ordinal' />
            <column caption='Subscriber Orders Top 30 Chains' datatype='integer' name='[subscriber_orders_top_30_chains]' role='measure' type='quantitative' />
            <column caption='Subscriber Users Top 30 Chains' datatype='integer' name='[subscriber_users_top_30_chains]' role='measure' type='quantitative' />
            <column caption='Subscription Orders Top 30 Chains' datatype='integer' name='[subscription_orders_top_30_chains]' role='measure' type='quantitative' />
            <column-instance column='[subscriber_users_top_30_chains]' derivation='Sum' name='[sum:subscriber_users_top_30_chains:qk]' pivot='key' type='quantitative' />
            <column-instance column='[unique_users_top_30_chains]' derivation='Sum' name='[sum:unique_users_top_30_chains:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendors_with_order_top_30_chains]' derivation='Sum' name='[sum:vendors_with_order_top_30_chains:qk]' pivot='key' type='quantitative' />
            <column datatype='boolean' name='[top30_chain]' role='dimension' type='nominal' />
