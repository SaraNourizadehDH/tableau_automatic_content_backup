              <calculation class='tableau' formula='sum([subscriber_orders])/sum([orders])' />
            </column>
            <column caption='% Vendors with PRO Deal ' datatype='real' default-format='p0.0%' name='[% Vendors with PRO Deal / Active vendors (copy)_391250247676522497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_391250247674654720] / sum([active_restos_with_order])' />
            </column>
            <column caption='GMV of PRO deal vendors' datatype='real' name='[All Vendors (copy)_1172343328636121089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])' />
            </column>
            <column caption='Total City GMV' datatype='real' name='[Calculation_1172343328647237634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([resto_gmv],0)&#13;&#10;+ IFNULL([dmart_gmv],0)&#13;&#10;+ IFNULL([shops_gmv],0))' />
            </column>
            <column caption='% PRO Deal Utilization' datatype='real' default-format='p0.00%' name='[Calculation_1172343328658329605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [pd_discount_uuid] &lt;&gt; &apos;None&apos; THEN [orders (active_pro_deals)] END)/SUM([subscription_orders])' />
            </column>
            <column caption='% Subscriber Orders with PRO deal' datatype='real' default-format='p0.0%' name='[Calculation_1172343328669749259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_deal_orders])/SUM([subscriber_orders])' />
            </column>
            <column caption='% Discount of GMV' datatype='real' default-format='p0.0%' name='[Calculation_1430455874476032000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([all_deal_total_local])/sum([gmv_local])' />
            </column>
            <column caption='Metric for Rank' datatype='real' name='[Calculation_1436085333208846336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([Calculation_683421276071206921]) = &apos;others&apos; THEN NULL&#13;&#10;ELSE IFNULL(&#13;&#10;IF [Parameters].[Parameter 2] = &apos;Subscriber Users&apos; THEN SUM([subscriber_users]) &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Unique Users&apos; THEN SUM([unique_users]) &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Penetration PRO Users&apos; THEN [Calculation_466967015363473417] &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Subscriber Orders&apos; THEN [% Subscription Orders (copy)_1511520659946921984] &#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Subscriber Orders with PRO deal&apos; THEN [Calculation_1172343328669749259]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;# Active Vendors with Order&apos; THEN SUM([active_restos_with_order])&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;# Vendors with PRO Deal&apos; THEN [Calculation_391250247674654720]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Vendors with PRO Deal&apos; THEN [% Vendors with PRO Deal / Active vendors (copy)_391250247676522497]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% Discount of GMV&apos; THEN [Calculation_1430455874476032000]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% GMV Coverage&apos; THEN [% Discount of GMV (copy)_1172343328653668355]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% PRO Deal Utilization&apos; THEN [Calculation_1172343328658329605]&#13;&#10;END,0)&#13;&#10;END&#13;&#10;*&#13;&#10;IF [Parameters].[Parameter 3] = &apos;Asc&apos; THEN -1 ELSE 1 END' />
            </column>
            <column caption='Placeholder' datatype='integer' name='[Calculation_382805998446829568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(0)' />
            </column>
            <column caption='# Vendors with PRO Deal' datatype='integer' name='[Calculation_391250247674654720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if not isnull([pd_discount_uuid]) then [vendor_code] end)' />
            </column>
            <column caption='% Penetration PRO Users' datatype='real' default-format='p0.0%' name='[Calculation_466967015363473417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscriber_users]) / sum([unique_users])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_683421276071206921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [city] in (&apos;praha&apos;, &apos;brno&apos;, &apos;ostrava&apos;, &apos;liberec&apos;, &apos;plzen&apos;, &apos;ceske budejovice&apos;,&#13;&#10;&apos;pardubice&apos;, &apos;olomouc&apos;, &apos;hradec kralove&apos;, &apos;usti nad labem&apos;, &apos;teplice&apos;,&#13;&#10;&apos;havirov&apos;, &apos;mlada boleslav&apos;) then [city]&#13;&#10;else &apos;others&apos;&#13;&#10;END' />
            </column>
