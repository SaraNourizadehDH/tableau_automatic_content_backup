        <calculation class='tableau' formula='//for makin&apos; it sortable&#13;&#10;&#13;&#10;if [pd_discount_uuid] != &apos;None&apos;&#13;&#10;then [vendor_code] + &apos;-&apos; +  LEFT([pd_discount_uuid],LEN([pd_discount_uuid])-6)&#13;&#10;end' />
