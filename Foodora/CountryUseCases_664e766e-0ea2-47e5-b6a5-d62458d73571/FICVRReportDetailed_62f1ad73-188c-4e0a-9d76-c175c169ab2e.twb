      <aliases enabled='yes' />
      <column caption='% CVR iOS' datatype='real' name='[% CVR Android (copy)_1645784218679885826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ios_transactions]) / SUM([ios_sessions])' />
      </column>
      <column caption='% CVR Joker' datatype='real' name='[% CVR CPC (copy)_1645784218680254469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_orders]) / SUM([joker_views])' />
      </column>
      <column caption='% CVR CPC' datatype='real' name='[% CVR Web (copy)_1645784218680131588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_orders]) / SUM([cpc_clicks])' />
      </column>
      <column caption='% CVR Web' datatype='real' name='[% CVR iOS (copy)_1645784218680016899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([web_transactions]) / SUM([web_sessions])' />
      </column>
      <column caption='Report Month' datatype='string' name='[Calculation_1564156502814441485]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
      </column>
      <column caption='Report Date' datatype='string' name='[Calculation_1564156502837833742]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([report_date])' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1564156502850523152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; then left(STR(report_month), 7)&#13;&#10;WHEN &quot;Daily&quot; then STR(report_date)&#13;&#10;END' />
      </column>
      <column caption='Current Month' datatype='boolean' name='[Calculation_1564156503097393169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[report_date],TODAY())=0' />
      </column>
      <column caption='% CVR' datatype='real' name='[Calculation_1645784218676580352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions]) / SUM([sessions])' />
      </column>
      <column caption='% CVR Android' datatype='real' name='[Calculation_1645784218679787521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([android_transactions]) / SUM([android_sessions])' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_1645784218706968582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;% CVR&apos; THEN  [Calculation_1645784218676580352]&#13;&#10;WHEN &apos;% CVR - Android&apos; THEN  [Calculation_1645784218679787521]&#13;&#10;WHEN &apos;% CVR - iOS&apos; THEN  [% CVR Android (copy)_1645784218679885826]&#13;&#10;WHEN &apos;% CVR - Web&apos; THEN  [% CVR iOS (copy)_1645784218680016899]&#13;&#10;WHEN &apos;% CVR - CPC&apos; THEN  [% CVR Web (copy)_1645784218680131588]&#13;&#10;WHEN &apos;% CVR - Joker&apos; THEN  [% CVR CPC (copy)_1645784218680254469]&#13;&#10;END' />
      </column>
