    <worksheet name='Vendor Type (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_cvr_detailed (bl_bi)' name='federated.1ya2c510q3ko2p1bxboiu06ct5ir' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Para' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% CVR&quot;'>
              <calculation class='tableau' formula='&quot;% CVR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ya2c510q3ko2p1bxboiu06ct5ir'>
            <column caption='% CVR' datatype='real' name='[Calculation_1564156502070288384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='% CVR - CPC' datatype='real' name='[Calculation_1564156502103392260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_orders])/SUM([cpc_clicks])' />
            </column>
            <column caption='% CVR - Joker' datatype='real' name='[Calculation_1564156502103568389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_orders])/SUM([joker_views])' />
            </column>
            <column caption='% CVR - Android' datatype='real' name='[Calculation_1564156502103896070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([android_transactions])/SUM([android_sessions])' />
            </column>
            <column caption='% CVR - iOS' datatype='real' name='[Calculation_1564156502104248327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ios_transactions])/SUM([ios_sessions])' />
            </column>
            <column caption='% CVR - Mobile Web' datatype='real' name='[Calculation_1564156502104354824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mweb_transactions])/SUM([mweb_sessions])' />
            </column>
            <column caption='% CVR - Web' datatype='real' name='[Calculation_1564156502104457225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([web_transactions])/SUM([web_sessions])' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_1564156502808219658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;% CVR&apos; THEN  [Calculation_1564156502070288384]&#13;&#10;WHEN &apos;% CVR - Android&apos; THEN  [Calculation_1564156502103896070]&#13;&#10;WHEN &apos;% CVR - iOS&apos; THEN  [Calculation_1564156502104248327]&#13;&#10;WHEN &apos;% CVR - Mobile Web&apos; THEN  [Calculation_1564156502104354824]&#13;&#10;WHEN &apos;% CVR - Web&apos; THEN  [Calculation_1564156502104457225]&#13;&#10;WHEN &apos;% CVR - CPC&apos; THEN  [Calculation_1564156502103392260]&#13;&#10;WHEN &apos;% CVR - Joker&apos; THEN  [Calculation_1564156502103568389]&#13;&#10;END' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_1564156502814441485]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
            </column>
            <column datatype='integer' name='[android_sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[android_transactions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cpc_clicks]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cpc_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[ios_sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[ios_transactions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[joker_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[joker_views]' role='measure' type='quantitative' />
            <column datatype='integer' name='[mweb_sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[mweb_transactions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1564156502814441485]' derivation='None' name='[none:Calculation_1564156502814441485:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[report_month]' role='dimension' type='ordinal' />
            <column caption='# Sessions' datatype='integer' name='[sessions]' role='measure' type='quantitative' />
            <column caption='# Transactions' datatype='integer' name='[transactions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1564156502808219658]' derivation='User' name='[usr:Calculation_1564156502808219658:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[web_sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[web_transactions]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ya2c510q3ko2p1bxboiu06ct5ir].[none:vendor_type:nk]'>
            <groupfilter function='level-members' level='[none:vendor_type:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
