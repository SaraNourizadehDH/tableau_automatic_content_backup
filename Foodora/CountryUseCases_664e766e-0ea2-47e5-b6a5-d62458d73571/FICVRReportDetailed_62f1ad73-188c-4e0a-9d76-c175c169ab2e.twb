    <worksheet name='Primary Cuisine (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_cvr_detailed (bl_bi)' name='federated.1ya2c510q3ko2p1bxboiu06ct5ir' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Para' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% CVR&quot;'>
              <calculation class='tableau' formula='&quot;% CVR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ya2c510q3ko2p1bxboiu06ct5ir'>
            <column caption='% CVR' datatype='real' name='[Calculation_1564156502070288384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='% CVR - CPC' datatype='real' name='[Calculation_1564156502103392260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_orders])/SUM([cpc_clicks])' />
            </column>
            <column caption='% CVR - Joker' datatype='real' name='[Calculation_1564156502103568389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_orders])/SUM([joker_views])' />
            </column>
            <column caption='% CVR - Android' datatype='real' name='[Calculation_1564156502103896070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([android_transactions])/SUM([android_sessions])' />
            </column>
            <column caption='% CVR - iOS' datatype='real' name='[Calculation_1564156502104248327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ios_transactions])/SUM([ios_sessions])' />
            </column>
            <column caption='% CVR - Mobile Web' datatype='real' name='[Calculation_1564156502104354824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mweb_transactions])/SUM([mweb_sessions])' />
            </column>
            <column caption='% CVR - Web' datatype='real' name='[Calculation_1564156502104457225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([web_transactions])/SUM([web_sessions])' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_1564156502808219658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;% CVR&apos; THEN  [Calculation_1564156502070288384]&#13;&#10;WHEN &apos;% CVR - Android&apos; THEN  [Calculation_1564156502103896070]&#13;&#10;WHEN &apos;% CVR - iOS&apos; THEN  [Calculation_1564156502104248327]&#13;&#10;WHEN &apos;% CVR - Mobile Web&apos; THEN  [Calculation_1564156502104354824]&#13;&#10;WHEN &apos;% CVR - Web&apos; THEN  [Calculation_1564156502104457225]&#13;&#10;WHEN &apos;% CVR - CPC&apos; THEN  [Calculation_1564156502103392260]&#13;&#10;WHEN &apos;% CVR - Joker&apos; THEN  [Calculation_1564156502103568389]&#13;&#10;END' />
            </column>
