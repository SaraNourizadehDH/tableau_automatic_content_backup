      <aliases enabled='yes' />
      <column caption='Total Revenue - Current' datatype='real' name='[Calculation_1324058292045570048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_curr]) + SUM([joker_revenue_curr])' />
      </column>
      <column caption='Total Revenue - Previous' datatype='real' name='[Calculation_1324058292045774849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_prev]) + SUM([joker_revenue_prev])' />
      </column>
      <column caption='Total Revenue Diff (€)' datatype='real' name='[Calculation_1324058292045938690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_1324058292045570048],0)-IFNULL([Calculation_1324058292045774849],0)' />
      </column>
      <column caption='Booked Budget Diff (€)' datatype='real' name='[Calculation_1413848861001527298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([cpc_booked_budget_curr],0)-IFNULL([cpc_booked_budget_prev],0)' />
      </column>
      <column caption='CPC Revenue Diff (€)' datatype='real' name='[Calculation_1413848861002051587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([cpc_revenue_curr],0)-IFNULL([cpc_revenue_prev],0)' />
      </column>
      <column caption='Joker Revenue Diff (€)' datatype='real' name='[Calculation_1413848861002203140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([joker_revenue_curr],0)-IFNULL([joker_revenue_prev],0)' />
      </column>
