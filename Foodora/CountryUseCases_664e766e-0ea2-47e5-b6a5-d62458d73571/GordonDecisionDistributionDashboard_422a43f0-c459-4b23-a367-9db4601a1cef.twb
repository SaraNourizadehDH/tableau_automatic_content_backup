              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [order_date])))&#10;    WHEN &apos;Weekly&apos; THEN STR(YEAR(DATE(DATETRUNC(&apos;week&apos;, [order_date], &apos;Monday&apos;))))+&quot; Week&quot;+STR(DATEPART(&quot;week&quot;,DATE(DATETRUNC(&apos;week&apos;,[order_date], &apos;Monday&apos;))))&#10;    WHEN &apos;Monthly&apos; THEN STR(YEAR(DATE(DATETRUNC(&apos;month&apos;, [order_date])))) +&quot; &quot;+STR(DATEPART(&quot;month&quot;,DATE(DATETRUNC(&apos;month&apos;,[order_date]))))&#10;    WHEN &apos;Yearly&apos; THEN STR(YEAR(DATE(DATETRUNC(&apos;year&apos;, [order_date]))))&#10;END' />
