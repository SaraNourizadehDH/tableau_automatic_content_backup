        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0436t6p1ppyduh13cg05703enqrs' name='Custom SQL Query' type='text'>-- 1: GRID ID
-- 2: Vendor Code
-- 3: Vendor Name
-- 4: Vendor City
-- 5: Delivery Fees to be charged
-- 6: Order Code
-- 7: Order Date
-- 8: Order Status
-- 9: Start date/deduction Date
-- 10: GFV/Food Value
-- 11: GMV/Customer Paid Amount

WITH vendor_config AS (
  SELECT
    *,
    TRUE AS is_vfdf_vendor,
  FROM `fulfillment-dwh-production.pandata_report.country_PK_gsheet_homechefs_free_df_config`
  WHERE vendor_code IS NOT NULL
),


final_out AS (
  SELECT
    vi.global_vendor_id,
    vc.vendor_code,
    vc.vendor_name,
    fin.lg_city,
    fin.lg_zone_name,
    vc.delivery_fee AS deduction_delivery_fee_local,
    vc.live_date_local AS deduction_agreement_date_local,
    vc.deduction_start_date_local,
    vc.deduction_end_date_local,
    vc.deduction_minimum_order_value AS deduction_minimum_order_value_local,
    fin.date_local AS order_date_local,
    fin.order_code,
    fin.status_code,
    fin.billable,
    fin.subtotal_tax_inc AS subtotal_local,
    fin.user_paid_amount AS user_paid_gmv,
    (fin.date_local BETWEEN deduction_start_date_local AND COALESCE(deduction_end_date_local, CURRENT_DATE(&quot;Asia/Karachi&quot;))) AS is_order_date_in_deduction,
    (fin.subtotal_tax_inc &gt;&gt;= deduction_minimum_order_value) AS is_order_value_in_deduction,
  FROM vendor_config AS vc
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
          ON vi.vendor_code = vc.vendor_code
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` AS fin
          ON fin.vendor_code = vc.vendor_code
  WHERE fin.date_local &gt;&gt;= current_date() - 180
    AND LOWER(fin.billable) = &quot;billable&quot;
    AND fin.expedition_type = &quot;delivery&quot;
)

SELECT
  *
FROM final_out
WHERE is_order_date_in_deduction
  AND is_order_value_in_deduction
ORDER BY order_date_local DESC, order_code ASC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
