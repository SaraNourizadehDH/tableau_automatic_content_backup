              <calculation class='tableau' formula='IF (    SUM(IF [Calculation_378794978108076033] THEN [delayed_20] ELSE 0 END)  / SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)  &#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [delayed_20] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;/ (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [delayed_20] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
