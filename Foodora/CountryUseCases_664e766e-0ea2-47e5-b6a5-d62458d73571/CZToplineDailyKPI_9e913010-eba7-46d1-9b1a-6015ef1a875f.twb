          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.16jkyeo16xkior118ozgz06x9ywh].[Calculation_127719338234654730]' _.fcp.ParameterDefaultValues.true...source-field='[federated.16jkyeo16xkior118ozgz06x9ywh].[reference_date_local]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
