            </column>
            <column caption='Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_840484293613961269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor])/SUM([Calculation_840484293605593130])' />
            </column>
