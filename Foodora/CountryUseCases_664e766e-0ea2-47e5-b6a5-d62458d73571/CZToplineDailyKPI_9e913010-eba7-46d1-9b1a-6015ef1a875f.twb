    <worksheet name='WTD % Vendor Late'>
      <table>
        <view>
          <datasources>
            <datasource caption='topline_daily_kpi (prep)' name='federated.16jkyeo16xkior118ozgz06x9ywh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.16jkyeo16xkior118ozgz06x9ywh].[Calculation_127719338234654730]' _.fcp.ParameterDefaultValues.true...source-field='[federated.16jkyeo16xkior118ozgz06x9ywh].[reference_date_local]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16jkyeo16xkior118ozgz06x9ywh'>
            <column caption='Data Date' datatype='date' name='[Calculation_127719338234654730]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([reference_date_local])}' />
            </column>
            <column caption='WeekDay Ref Date (from Monday)' datatype='integer' name='[Calculation_1443966653162872835]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IIF(datepart(&apos;weekday&apos;,[reference_date_local], &quot;Sunday&quot;)-1 = 0, 7, datepart(&apos;weekday&apos;,[reference_date_local], &quot;Sunday&quot;)-1)&#13;&#10;// u datepart nefunguje správně začátek týdne (třetí parametr), proto řeším oklikou). A dávám tam Sunday, protože Monday nic nedělá, ale kdyby to začlo fungovat, tak ať se to nerozbije' />
            </column>
            <column caption='WTD' datatype='boolean' name='[MTD (copy 2)_382172716287561733]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;,[reference_date_local]) = DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])&#13;&#10;AND [Calculation_1443966653162872835] &lt;= [WeekDay Ref Date (from Monday) (copy)_1443966653166215172]' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='PWTD' datatype='boolean' name='[PMTD (copy)_382172716287787014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;,[reference_date_local]) = DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;, -1, [Parameters].[Parameter 1]))&#13;&#10;AND [Calculation_1443966653162872835] &lt;= [WeekDay Ref Date (from Monday) (copy)_1443966653166215172]' />
            </column>
            <column aggregation='Sum' caption='Title WTD WoW' datatype='integer' name='[Title LastD WoW (copy)_1445374028382150656]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WTD WoW' />
              </aliases>
            </column>
            <column caption='WTD vs PWTD (Indicator) Vendor Late' datatype='string' name='[WTD vs PWTD (Indicator) Vendor Fail Rate (copy)_1065101379510927378]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#13;&#10;(&#13;&#10;    SUM(iif([MTD (copy 2)_382172716287561733], [vendor_late_over_10_count], 0))/SUM(iif([MTD (copy 2)_382172716287561733], [completed_orders], 0))&#13;&#10;    -&#13;&#10;    SUM(iif([PMTD (copy)_382172716287787014], [vendor_late_over_10_count], 0))/SUM(iif([PMTD (copy)_382172716287787014], [completed_orders], 0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(iif([PMTD (copy)_382172716287787014], [vendor_late_over_10_count], 0))/SUM(iif([PMTD (copy)_382172716287787014], [completed_orders], 0))&#13;&#10;)&#13;&#10;&lt;= 0&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end' />
            </column>
            <column caption='WTD vs PWTD Vendor Late' datatype='string' name='[WTD vs PWTD Vendor Fail Rate (copy)_1065101379510935571]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#13;&#10;(&#13;&#10;    SUM(iif([MTD (copy 2)_382172716287561733], [vendor_late_over_10_count], 0))/SUM(iif([MTD (copy 2)_382172716287561733], [completed_orders], 0))&#13;&#10;    -&#13;&#10;    SUM(iif([PMTD (copy)_382172716287787014], [vendor_late_over_10_count], 0))/SUM(iif([PMTD (copy)_382172716287787014], [completed_orders], 0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(iif([PMTD (copy)_382172716287787014], [vendor_late_over_10_count], 0))/SUM(iif([PMTD (copy)_382172716287787014], [completed_orders], 0))&#13;&#10;)&#13;&#10;&lt;= 0&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end&#13;&#10;+&#13;&#10;str(round(&#13;&#10;(&#13;&#10;    SUM(iif([MTD (copy 2)_382172716287561733], [vendor_late_over_10_count], 0))/SUM(iif([MTD (copy 2)_382172716287561733], [completed_orders], 0))&#13;&#10;    -&#13;&#10;    SUM(iif([PMTD (copy)_382172716287787014], [vendor_late_over_10_count], 0))/SUM(iif([PMTD (copy)_382172716287787014], [completed_orders], 0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(iif([PMTD (copy)_382172716287787014], [vendor_late_over_10_count], 0))/ SUM(iif([PMTD (copy)_382172716287787014], [completed_orders], 0))&#13;&#10;)&#13;&#10;* 100&#13;&#10;,1)&#13;&#10;)' />
            </column>
            <column caption='WeekDay Report Date (from Monday)' datatype='integer' name='[WeekDay Ref Date (from Monday) (copy)_1443966653166215172]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IIF(datepart(&apos;weekday&apos;,[Parameters].[Parameter 1], &quot;Sunday&quot;)-1 = 0, 7, datepart(&apos;weekday&apos;,[Parameters].[Parameter 1], &quot;Sunday&quot;)-1)&#13;&#10;// u datepart nefunguje správně začátek týdne (třetí parametr), proto řeším oklikou). A dávám tam Sunday, protože Monday nic nedělá, ale kdyby to začlo fungovat, tak ať se to nerozbije' />
            </column>
            <column datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Geo' datatype='string' name='[geo]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Title LastD WoW (copy)_1445374028382150656]' derivation='None' name='[none:Title LastD WoW (copy)_1445374028382150656:ok]' pivot='key' type='ordinal' />
            <column-instance column='[geo]' derivation='None' name='[none:geo:nk]' pivot='key' type='nominal' />
            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[WTD vs PWTD (Indicator) Vendor Fail Rate (copy)_1065101379510927378]' derivation='User' name='[usr:WTD vs PWTD (Indicator) Vendor Fail Rate (copy)_1065101379510927378:nk]' pivot='key' type='nominal' />
            <column-instance column='[WTD vs PWTD Vendor Fail Rate (copy)_1065101379510935571]' derivation='User' name='[usr:WTD vs PWTD Vendor Fail Rate (copy)_1065101379510935571:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[vendor_late_over_10_count]' role='measure' type='quantitative' />
