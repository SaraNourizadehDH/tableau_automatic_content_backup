      <aliases enabled='yes' />
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[CVR (copy)_840484293605449769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])/SUM([Calculation_840484293605593130])' />
      </column>
      <column caption='Leads' datatype='integer' name='[Calculation_1065101379495960576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([applicants])' />
      </column>
      <column caption='Mille' datatype='real' name='[Calculation_1065101379514277913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([population])/1000' />
      </column>
      <column caption='City' datatype='string' name='[Calculation_1130403520333008898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [geo]&#13;&#10;WHEN &quot;Prague center&quot; THEN &quot;Prague&quot;&#13;&#10;WHEN &quot;Prague other&quot; THEN &quot;Prague&quot;&#13;&#10;ELSE [geo] END' />
      </column>
      <column caption='Data Date' datatype='date' name='[Calculation_127719338234654730]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([reference_date_local])}' />
      </column>
      <column caption='MTD vs PMTD Orders' datatype='string' name='[Calculation_128141502929027179]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;* 100&#10;,1)&#10;)' />
      </column>
      <column caption='Date 1 Week Before Reporting Date' datatype='date' name='[Calculation_1443966653154869248]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]-7' />
      </column>
      <column caption='WeekDay Ref Date (from Monday)' datatype='integer' name='[Calculation_1443966653162872835]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF(datepart(&apos;weekday&apos;,[reference_date_local], &quot;Sunday&quot;)-1 = 0, 7, datepart(&apos;weekday&apos;,[reference_date_local], &quot;Sunday&quot;)-1)&#13;&#10;// u datepart nefunguje správně začátek týdne (třetí parametr), proto řeším oklikou). A dávám tam Sunday, protože Monday nic nedělá, ale kdyby to začlo fungovat, tak ať se to nerozbije' />
      </column>
      <column caption='RR' datatype='real' name='[Calculation_1462543990704369666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#13;&#10;{FIXED: MAX(DATEADD(&quot;month&quot;,1,DATETRUNC(&quot;month&quot;,[Calculation_378794978106404864]))-DATETRUNC(&quot;month&quot;,[Calculation_378794978106404864]))}&#13;&#10;/&#13;&#10;{FIXED: COUNTD(IF [PMTD (copy)_128141502928715882] THEN [reference_date_local] END)}&#13;&#10;)' />
      </column>
      <column caption='orders monthly share' datatype='real' name='[Calculation_1483373146335076352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;{FIXED [geo], DATETRUNC(&quot;month&quot;,[reference_date_local]):SUM([total_number_of_successful_orders])}&#13;&#10;/&#13;&#10;{FIXED DATETRUNC(&quot;month&quot;,[reference_date_local]):SUM([total_number_of_successful_orders])}&#13;&#10;)' />
      </column>
      <column caption='Orders RR' datatype='real' name='[Calculation_1483373146336329729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX({FIXED: SUM(if datetrunc(&quot;month&quot;,[Parameters].[Parameter 1])= datetrunc(&quot;month&quot;,[date_rr]) then [orders_rr] end)})&#13;&#10;*&#13;&#10;SUM(&#13;&#10;{FIXED [geo], DATETRUNC(&quot;month&quot;,[reference_date_local]):SUM(if datetrunc(&quot;month&quot;,[Parameters].[Parameter 1])= datetrunc(&quot;month&quot;,[reference_date_local]) then [total_number_of_successful_orders] end)}&#13;&#10;/&#13;&#10;{FIXED DATETRUNC(&quot;month&quot;,[reference_date_local]):SUM(if datetrunc(&quot;month&quot;,[Parameters].[Parameter 1])= datetrunc(&quot;month&quot;,[reference_date_local]) then [total_number_of_successful_orders] end)}&#13;&#10;)' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1483373146337292291]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([reference_date_local],date_rr)' />
      </column>
      <column caption='RR or LY all month' datatype='boolean' name='[Calculation_1483373146343550982]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[LY MTD (copy)_1483373146341691396] OR [MTD (copy)_1483373146336653314]' />
      </column>
      <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DayOfWeek' datatype='string' name='[Calculation_2636153901957091335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [reference_date_local])' />
      </column>
      <column caption='Date of Reporting Date' datatype='date' name='[Calculation_378794978106404864]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Date Filter Is Reporting Date' datatype='boolean' name='[Calculation_378794978108076033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_date_local] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='yesterday/x day' datatype='string' name='[Calculation_378794978173800456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [reference_date_local] WHEN DATE(TODAY()-1) THEN &apos;yesterday&apos;&#10;ELSE &apos;on last data day&apos; END' />
      </column>
      <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='2' />
        <aliases>
          <alias key='2' value=' ' />
        </aliases>
      </column>
      <column caption='Date Filter Interval 8D to Reporting Date' datatype='boolean' name='[Calculation_418201474534387717]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_date_local] &gt;= [Parameters].[Parameter 1]-7 AND [reference_date_local] &lt;=  [Parameters].[Parameter 1]' />
      </column>
      <column caption='% of total Orders' datatype='real' name='[Calculation_6109836638281674769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6109836638287081491]&#10;/&#10;( &#10;sum(&#10;{fixed [geo]: sum(iif([Calculation_378794978108076033], [total_number_of_successful_orders], 0))}&#10;)&#10;)' />
      </column>
      <column caption='Yesterday&apos;s Orders Main' datatype='integer' name='[Calculation_6109836638287081491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_378794978108076033], [total_number_of_successful_orders], null))' />
      </column>
      <column caption='Day (Similar Scale)' datatype='date' name='[Calculation_6149806036921335808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [reference_date_local] &lt;= [Calculation_1443966653154869248]&#10;THEN DATE(DATEADD(&apos;day&apos;, 7, [reference_date_local]))&#10;ELSE DATE([reference_date_local])&#10;END' />
      </column>
      <column aggregation='Sum' caption='Title LastD WoW' datatype='integer' name='[Calculation_6180416436319469570]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='LastD WoW' />
        </aliases>
      </column>
      <column caption='DH Subsidy per Order' datatype='real' name='[Calculation_809803538149203968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_deal_value])/SUM([dh_deal_orders])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_840484293593604125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
      </column>
      <column caption='gross orders' datatype='integer' name='[Calculation_840484293605593130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([total_number_of_successful_orders],0) + IFNULL([failed_orders],0)' />
      </column>
      <column caption='MtD or LY MtD' datatype='boolean' name='[Calculation_958140834872332300]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[PMTD (copy)_128141502928715882] OR [PMTD (copy)_383861552113147904]' />
      </column>
      <column caption='RR Orders' datatype='real' name='[Commission RR (copy)_399694534581735424]' role='measure' type='quantitative'>
