          <datasource-dependencies datasource='federated.16jkyeo16xkior118ozgz06x9ywh'>
            <column caption='Data Date' datatype='date' name='[Calculation_127719338234654730]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([reference_date_local])}' />
            </column>
            <column caption='LY MTD (delayed)' datatype='boolean' name='[LY MTD (copy)_1450722053016858645]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]-1))&#10;    AND day([reference_date_local]) &lt;= day([Parameters].[Parameter 1]-1)' />
            </column>
            <column caption='MTD (delayed)' datatype='boolean' name='[MTD (copy)_1450722053016760339]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]-1)&#13;&#10;AND &#13;&#10;DAY([reference_date_local]) &lt;= DAY([Parameters].[Parameter 1]-1)' />
            </column>
            <column caption='MTD vs LY (Indicator) DH Subsidy' datatype='string' name='[MTD vs LY (Indicator) Acquisitions (copy)_1195142753233625111]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if SUM(iif([MTD (copy)_1450722053016760339], [dh_deal_value], 0)) &lt; SUM(iif([LY MTD (copy)_1450722053016858645], [dh_deal_value], 0))&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD vs LY DH Subsidy' datatype='string' name='[MTD vs LY Acquisitions (copy)_1195142753233633304]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(SUM(iif([MTD (copy)_1450722053016760339], [dh_deal_value], 0))/SUM(iif([LY MTD (copy)_1450722053016858645], [dh_deal_value], 0)))-1 &gt; 5&#13;&#10;THEN NULL&#13;&#10;ELSE&#13;&#10;if    &#13;&#10;SUM(iif([MTD (copy)_1450722053016760339], [dh_deal_value], 0)) &lt; SUM(iif([LY MTD (copy)_1450722053016858645], [dh_deal_value], 0))&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end&#13;&#10;+&#13;&#10;str(round(&#13;&#10;(SUM(iif([MTD (copy)_1450722053016760339], [dh_deal_value], 0))/SUM(iif([LY MTD (copy)_1450722053016858645], [dh_deal_value], 0))-1)&#13;&#10;* 100&#13;&#10;,1)&#13;&#10;)&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column aggregation='Sum' caption='Title MTD YoY' datatype='integer' name='[Title Current Month RR (copy)_1445374028383875075]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD YoY' />
              </aliases>
            </column>
            <column caption='DH Subsidy' datatype='real' name='[dh_deal_value]' role='measure' type='quantitative' />
            <column caption='Geo' datatype='string' name='[geo]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Title Current Month RR (copy)_1445374028383875075]' derivation='None' name='[none:Title Current Month RR (copy)_1445374028383875075:ok]' pivot='key' type='ordinal' />
            <column-instance column='[geo]' derivation='None' name='[none:geo:nk]' pivot='key' type='nominal' />
