              <calculation class='tableau' formula='(       SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_value] ELSE 0 END) / SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10;- SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;/ ( SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END))' />
            </column>
            <column caption='W1 % DH Subsidy per Order' datatype='string' name='[W1 % aCVR  (copy)_809803538151460868]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;/ (SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END) / SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END)) &#13;&#10;&gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(&#13;&#10;IF SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10;- SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/ SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10; &gt;= 0&#13;&#10;THEN &#13;&#10;   (    SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END) )&#13;&#10;ELSE&#13;&#10;   (SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter Is Reporting Date (copy)_1450722053008424962] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_value] ELSE 0 END)/SUM(IF [Date Filter 1 Week Before Reporting Date (copy)_1450722053011496970] THEN [dh_deal_orders] ELSE 0 END))&#13;&#10;END * 100, 1))' />
            </column>
