              <calculation class='tableau' formula='IF (    SUM(IF [Calculation_378794978108076033] THEN [failed_orders] ELSE 0 END)  / SUM(IF [Calculation_378794978108076033] THEN [Calculation_840484293605593130] ELSE 0 END)  &#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10;)&#13;&#10;/ (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 % Fail Rate' datatype='string' name='[W1 % CVR (copy)_840484293607108653]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_378794978108076033] THEN [failed_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10;)&#13;&#10;/ (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END) / SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)) &#13;&#10;&gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(&#13;&#10;IF SUM(IF [Calculation_378794978108076033] THEN [failed_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10;- SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/ SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10; &gt;= 0&#13;&#10;THEN &#13;&#10;   (    SUM(IF [Calculation_378794978108076033] THEN [failed_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END) )&#13;&#10;ELSE&#13;&#10;   (SUM(IF [Calculation_378794978108076033] THEN [failed_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END))&#13;&#10;END * 100, 1))' />
            </column>
            <column caption='W1 % Ranking Fail Rate' datatype='real' name='[W1 % Ranking CVR (copy)_840484293607116846]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(       SUM(IF [Calculation_378794978108076033] THEN [failed_orders] ELSE 0 END) / SUM(IF [Calculation_378794978108076033] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10;- SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END)&#13;&#10;)&#13;&#10;/ ( SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [failed_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [Calculation_840484293605593130] ELSE 0 END))' />
            </column>
