              <calculation class='tableau' formula='if&#13;&#10;SUM(iif([MTD (copy)_1450722053016760339], [dh_deal_value], 0))/SUM(iif([MTD (copy)_1450722053016760339], [dh_deal_orders], 0))&#13;&#10;&lt;&#13;&#10;SUM(iif([LY MTD (copy)_1450722053016858645], [dh_deal_value], 0))/SUM(iif([LY MTD (copy)_1450722053016858645], [dh_deal_orders], 0))&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end' />
