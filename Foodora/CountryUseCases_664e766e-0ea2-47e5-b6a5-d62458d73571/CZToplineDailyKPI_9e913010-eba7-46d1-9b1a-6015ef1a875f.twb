              <calculation class='tableau' formula='IF (SUM(IF [Calculation_378794978108076033] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;/ (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [vendor_late_over_10_count] ELSE 0 END) / SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)) &#13;&#10;&gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(&#13;&#10;IF SUM(IF [Calculation_378794978108076033] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10;- SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [vendor_late_over_10_count] ELSE 0 END)/ SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10; &gt;= 0&#13;&#10;THEN &#13;&#10;   (    SUM(IF [Calculation_378794978108076033] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END) )&#13;&#10;ELSE&#13;&#10;   (SUM(IF [Calculation_378794978108076033] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [vendor_late_over_10_count] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END))&#13;&#10;END * 100, 1))' />
