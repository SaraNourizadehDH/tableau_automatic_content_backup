            <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Current MTD (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 1]) AND [reference_date_local] &lt;= [Parameters].[Parameter 1]&#10;THEN &apos;L7D&apos;&#10;ELSEIF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -14, [Parameters].[Parameter 1]) AND [reference_date_local] &lt;= DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 1])&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='Date Filter Interval 14D to Reporting Date' datatype='boolean' name='[Date range (graph) (copy)_378794978155827207]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_date_local] &gt;= [Parameters].[Parameter 1] -13 AND [reference_date_local] &lt;= [Parameters].[Parameter 1]' />
