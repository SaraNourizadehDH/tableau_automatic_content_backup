            <column caption='MTD vs LY (Indicator) Fail Rate' datatype='string' name='[MTD vs LY (Indicator) Delay &gt; 20 (copy)_1195142753228443660]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#13;&#10;SUM(iif([PMTD (copy)_128141502928715882], [failed_orders], 0))/SUM(iif([PMTD (copy)_128141502928715882], [Calculation_840484293605593130], 0))&#13;&#10;&lt;&#13;&#10;SUM(iif([PMTD (copy)_383861552113147904], [failed_orders], 0))/SUM(iif([PMTD (copy)_383861552113147904], [Calculation_840484293605593130], 0))&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end' />
            </column>
            <column caption='MTD vs LY Fail Rate' datatype='string' name='[MTD vs LY Delay &gt; 20 (copy)_1195142753228619789]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(SUM(iif([PMTD (copy)_128141502928715882], [failed_orders], 0))/SUM(iif([PMTD (copy)_128141502928715882], [Calculation_840484293605593130], 0))&#13;&#10;/&#13;&#10;(SUM(iif([PMTD (copy)_383861552113147904], [failed_orders], 0))/SUM(iif([PMTD (copy)_383861552113147904], [Calculation_840484293605593130], 0))  ))-1 &gt; 5&#13;&#10;&#13;&#10;THEN NULL&#13;&#10;ELSE&#13;&#10;if&#13;&#10;SUM(iif([PMTD (copy)_128141502928715882], [failed_orders], 0))/SUM(iif([PMTD (copy)_128141502928715882], [Calculation_840484293605593130], 0)) &#13;&#10;&lt; &#13;&#10;SUM(iif([PMTD (copy)_383861552113147904], [failed_orders], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [Calculation_840484293605593130], 0))&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end&#13;&#10;+&#13;&#10;str(round(&#13;&#10;((SUM(iif([PMTD (copy)_128141502928715882], [failed_orders], 0))/SUM(iif([PMTD (copy)_128141502928715882], [Calculation_840484293605593130], 0))&#13;&#10;/(SUM(iif([PMTD (copy)_383861552113147904], [failed_orders], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [Calculation_840484293605593130], 0)))-1)&#13;&#10;* 100)&#13;&#10;,1)&#13;&#10;)&#13;&#10;END' />
            </column>
