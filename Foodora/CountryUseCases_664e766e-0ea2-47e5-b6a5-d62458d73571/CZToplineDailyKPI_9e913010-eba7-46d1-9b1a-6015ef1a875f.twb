            <column caption='W1 % (Indicator) On Time' datatype='string' name='[W1 % (Indicator) Seamless (copy)_656962602994274307]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (    SUM(IF [Calculation_378794978108076033] THEN [on_time_orders] ELSE 0 END)  / SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)  &#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;/ (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 % Ranking On Time' datatype='real' name='[W1 % Ranking Seamless (copy)_656962602994438148]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(       SUM(IF [Calculation_378794978108076033] THEN [on_time_orders] ELSE 0 END) / SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10;- SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;/ ( SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END))' />
            </column>
            <column caption='W1 % On Time' datatype='string' name='[W1 % Seamless (copy)_656962602994552837]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_378794978108076033] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;/ (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END) / SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)) &#13;&#10;&gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(&#13;&#10;IF SUM(IF [Calculation_378794978108076033] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10;- SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/ SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10; &gt;= 0&#13;&#10;THEN &#13;&#10;   (    SUM(IF [Calculation_378794978108076033] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END) )&#13;&#10;ELSE&#13;&#10;   (SUM(IF [Calculation_378794978108076033] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Calculation_378794978108076033] THEN [completed_orders] ELSE 0 END)&#13;&#10; - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END)&#13;&#10;)&#13;&#10;   / (SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [on_time_orders] ELSE 0 END)/SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [completed_orders] ELSE 0 END))&#13;&#10;END * 100, 1))' />
            </column>
            <column datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Geo' datatype='string' name='[geo]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_418201474534387717]' derivation='None' name='[none:Calculation_418201474534387717:nk]' pivot='key' type='nominal' />
            <column-instance column='[geo]' derivation='None' name='[none:geo:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[on_time_orders]' role='measure' type='quantitative' />
            <column caption='Reference Date Local' datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
