              <calculation class='tableau' formula='{ FIXED : MAX([reference_date_local])}' />
            </column>
            <column caption='Date of Reporting Date' datatype='date' name='[Calculation_378794978106404864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='MTD (delayed)' datatype='boolean' name='[MTD (copy)_1450722053016760339]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]-1)&#13;&#10;AND &#13;&#10;DAY([reference_date_local]) &lt;= DAY([Parameters].[Parameter 1]-1)' />
            </column>
            <column caption='RR (delayed)' datatype='real' name='[RR (copy)_1450722053028507685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#13;&#10;{FIXED: MAX(DATEADD(&quot;month&quot;,1,DATETRUNC(&quot;month&quot;,[Calculation_378794978106404864]-1))-DATETRUNC(&quot;month&quot;,[Calculation_378794978106404864]-1))}&#13;&#10;/&#13;&#10;{FIXED: COUNTD(IF [MTD (copy)_1450722053016760339] THEN [reference_date_local] END)}&#13;&#10;)' />
            </column>
            <column caption='RR Acquisitions' datatype='real' name='[RR Sessions (copy)_840484293592309784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([same month last year (copy)_5566167665149526016],[acquisitions], 0))* [RR (copy)_1450722053028507685]&#10;&#10;//IIF (DATEPART(&apos;day&apos;, TODAY()) =1&#10;//,[Orders MTD],&#10;//MAX(MAX({FIXED [Country],[reference_date_local]:MAX([orders_rr])}), [Orders MTD])&#10;//)' />
            </column>
            <column aggregation='Sum' caption='Title Current Month RR' datatype='integer' name='[Title WTD WoW (copy)_1445374028382990338]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Current Month RR' />
