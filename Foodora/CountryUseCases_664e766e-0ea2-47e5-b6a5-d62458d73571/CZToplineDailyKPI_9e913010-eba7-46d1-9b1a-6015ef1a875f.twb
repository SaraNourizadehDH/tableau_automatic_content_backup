            <column caption='MTD vs LY (Indicator) Sessions' datatype='string' name='[Orders RR vs LY (Indicator) (copy)_840484293584625675]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if SUM(iif([PMTD (copy)_128141502928715882], [sessions], 0)) &lt; SUM(iif([PMTD (copy)_383861552113147904], [sessions], 0))&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end' />
            </column>
            <column caption='MTD vs LY Sessions' datatype='string' name='[Orders RR vs LY (copy)_840484293584617482]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(SUM(iif([PMTD (copy)_128141502928715882], [sessions], 0))/SUM(iif([PMTD (copy)_383861552113147904], [sessions], 0)))-1 &gt; 5&#13;&#10;THEN NULL&#13;&#10;ELSE&#13;&#10;if    &#13;&#10;SUM(iif([PMTD (copy)_128141502928715882], [sessions], 0)) &lt; SUM(iif([PMTD (copy)_383861552113147904], [sessions], 0))&#13;&#10;then &apos;▼ &apos; &#13;&#10;ELSE &apos;▲ &apos; &#13;&#10;end&#13;&#10;+&#13;&#10;str(round(&#13;&#10;(SUM(iif([PMTD (copy)_128141502928715882], [sessions], 0))/SUM(iif([PMTD (copy)_383861552113147904], [sessions], 0))-1)&#13;&#10;* 100&#13;&#10;,1)&#13;&#10;)&#13;&#10;END' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])&#13;&#10;AND &#13;&#10;DAY([reference_date_local]) &lt;= DAY([Parameters].[Parameter 1])' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[PMTD (copy)_383861552113147904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]))&#10;    AND day([reference_date_local]) &lt;= day([Parameters].[Parameter 1])' />
            </column>
            <column aggregation='Sum' caption='Title MTD YoY' datatype='integer' name='[Title Current Month RR (copy)_1445374028383875075]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD YoY' />
