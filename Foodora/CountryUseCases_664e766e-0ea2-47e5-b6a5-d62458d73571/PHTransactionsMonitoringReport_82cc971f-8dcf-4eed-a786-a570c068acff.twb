        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1syy1710ogkux61fj3y7903yyfyy' name='Custom SQL Query' type='text'>WITH orders_base AS (
  SELECT
    created_date_local,
    customer_code,
    is_corporate,
    vendor_code,
    vendor_name,
    order_code,
    user_paid_gmv_local,
    payment_method,
    delivery_type,

    SUM(IF(is_corporate=FALSE, user_paid_gmv_local, 0)) OVER(PARTITION BY DATE_TRUNC(created_date_local, MONTH), customer_code) AS total_monthly_gmv,
    SUM(IF(is_corporate=FALSE AND payment_method=&quot;cash&quot;, user_paid_gmv_local, 0)) OVER(PARTITION BY DATE_TRUNC(created_date_local, MONTH), customer_code) AS total_monthly_cash_gmv,
    COUNT(DISTINCT order_code) OVER(PARTITION BY DATE_TRUNC(created_date_local, MONTH), customer_code) AS total_monthly_orders,
    COUNT(DISTINCT order_code) OVER(PARTITION BY created_date_local, customer_code) AS total_daily_orders,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`

  WHERE global_entity_id = &quot;FP_PH&quot;
    AND created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 15 MONTH)
                               AND CURRENT_DATE
    AND NOT is_test_order
    AND is_successful
    -- AND customer_code = &quot;ph0twr8g&quot;
)

SELECT
  &quot;High Value Single Transaction&quot; AS transaction_flag,
  orders_base.*
FROM orders_base
WHERE is_corporate = FALSE
  AND user_paid_gmv_local &gt;&gt;= 15500

UNION ALL

SELECT
  &quot;High Value Cumulative Transactions&quot; AS transaction_flag,
  orders_base.*
FROM orders_base 
WHERE is_corporate = FALSE
  AND total_monthly_gmv &gt;&gt;= 124000

UNION ALL

SELECT
  &quot;High Frequency Monthly Transactions&quot; AS transaction_flag,
  orders_base.*
FROM orders_base
WHERE total_monthly_orders &gt;&gt;= 200
  -- AND is_corporate = FALSE

UNION ALL

SELECT
  &quot;High Frequency Daily Transactions&quot; AS transaction_flag,
  orders_base.*
FROM orders_base
WHERE total_daily_orders &gt;&gt;= 30
  -- AND is_corporate = FALSE

UNION ALL

SELECT
  &quot;High Value COD Transactions&quot; AS transaction_flag,
  orders_base.*
FROM orders_base 
WHERE is_corporate = FALSE
  AND payment_method = &quot;cash&quot;
  AND total_monthly_cash_gmv &gt;&gt;= 62000</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
