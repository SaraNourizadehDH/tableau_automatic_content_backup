          <named-connection caption='BigQuery' name='bigquery.0hs7dmv08my5a61a8slsl1qylgrn'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='marquee.enriquez@foodpanda.ph' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0hs7dmv08my5a61a8slsl1qylgrn' name='Custom SQL Query' type='text'>WITH date_array_l3m AS (
  SELECT
    DATE_SUB(date_array, INTERVAL 3 MONTH) AS start_date,
    date_array - 1 AS end_date,
    date_array AS date_key
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE_SUB(DATE_TRUNC(CURRENT_DATE + 1, MONTH), INTERVAL 15 MONTH), LAST_DAY(CURRENT_DATE), INTERVAL 1 MONTH)) AS date_array
),

vendor_l3m_avg AS (
  SELECT
    date_key,
    vendor_code,
    ROUND(COUNT(DISTINCT order_code) / COUNT(DISTINCT DATE_TRUNC(orders.created_date_local, MONTH))) AS avg_l3m_orders,
    ROUND(SUM(COALESCE(user_paid_gmv_local,0)) / COUNT(DISTINCT DATE_TRUNC(orders.created_date_local, MONTH))) AS avg_l3m_sales
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders
  LEFT JOIN date_array_l3m
         ON orders.created_date_local BETWEEN start_date AND end_date
  WHERE orders.created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE + 1, MONTH), INTERVAL 18 MONTH) AND DATE_TRUNC(CURRENT_DATE, MONTH) - 1
    AND orders.global_entity_id = &quot;FP_PH&quot;
    AND orders.is_successful
    AND NOT orders.is_test_order
    AND date_key IS NOT NULL
  GROUP BY 1,2
),

orders_base AS (
  SELECT
    orders.created_date_local AS order_date,
    orders.vendor_code,
    orders.vendor_name,
    vendors.chain_code,
    vendors.chain_name,
    orders.order_code,
    orders.gfv_local,
    orders.user_paid_gmv_local,
    orders.payment_method,
    orders.delivery_type,
    IFNULL(vendor_l3m_avg.avg_l3m_sales, 0) AS avg_l3m_sales,
    SUM(COALESCE(orders.user_paid_gmv_local,0)) OVER(PARTITION BY DATE_TRUNC(orders.created_date_local, MONTH), orders.vendor_code) AS total_monthly_sales,
    SUM(COALESCE(orders.user_paid_gmv_local,0)) OVER(PARTITION BY DATE_TRUNC(orders.created_date_local, MONTH), orders.vendor_code) AS total_monthly_gmv,
    COUNT(DISTINCT orders.order_code) OVER(PARTITION BY DATE_TRUNC(orders.created_date_local, MONTH), orders.vendor_code) AS total_monthly_orders,
    COUNT(DISTINCT IF(orders.payment_method=&quot;cash&quot; AND orders.delivery_type=&quot;pickup&quot;, orders.order_code, NULL))
          OVER(PARTITION BY DATE_TRUNC(orders.created_date_local, MONTH), orders.vendor_code) AS total_monthly_cash_pu_orders,
    SUM(IF(orders.payment_method=&quot;cash&quot; AND orders.delivery_type=&quot;pickup&quot;, orders.user_paid_gmv_local, 0))
          OVER(PARTITION BY DATE_TRUNC(orders.created_date_local, MONTH), orders.vendor_code) AS total_monthly_cash_pu_gmv,
    COUNT(DISTINCT IF(orders.payment_method=&quot;cash&quot; AND orders.delivery_type=&quot;Vendor Delivery&quot;, orders.order_code, NULL)) OVER(PARTITION BY DATE_TRUNC(orders.created_date_local, MONTH), orders.vendor_code) AS total_monthly_cash_vd_orders,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders

  LEFT JOIN vendor_l3m_avg
    ON vendor_l3m_avg.vendor_code = orders.vendor_code
    AND vendor_l3m_avg.date_key = DATE_TRUNC(orders.created_date_local, MONTH)
  
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS vendors
         ON vendors.global_entity_id = orders.global_entity_id
        AND vendors.vendor_code = orders.vendor_code

  WHERE orders.global_entity_id = &quot;FP_PH&quot;
    AND orders.created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE + 1, MONTH), INTERVAL 15 MONTH) AND CURRENT_DATE
    AND is_successful
    AND NOT orders.is_test_order
    AND NOT vendors.vendor_flags.is_test_vendor
    AND vendors.vendor_flags.is_active
    -- AND business_type NOT IN (&apos;dmart&apos;)
)

  SELECT
    orders_base.*,
    &quot;500% Increase vs L3M Average Sales&quot; AS vendor_flag,
    ROUND(SAFE_DIVIDE(total_monthly_sales - avg_l3m_sales, avg_l3m_sales)) AS percent_difference
  FROM orders_base
  WHERE ROUND(SAFE_DIVIDE(total_monthly_sales - avg_l3m_sales, avg_l3m_sales)) &gt;&gt;= 5
    AND avg_l3m_sales &gt;&gt;= 62000
  
  UNION ALL

  SELECT
    orders_base.*,
    &quot;200% Increase vs L3M Average Sales&quot; AS vendor_flag,
    ROUND(SAFE_DIVIDE(total_monthly_sales - avg_l3m_sales, avg_l3m_sales)) AS percent_difference
  FROM orders_base
  WHERE ROUND(SAFE_DIVIDE(total_monthly_sales - avg_l3m_sales, avg_l3m_sales)) &gt;&gt;= 2
    AND avg_l3m_sales &gt;&gt;= 310000
  
  UNION ALL

  SELECT
    orders_base.*,
    &quot;3+ Monthly Pickup Orders paid via Cash &gt;&gt; 620PHP&quot; AS vendor_flag,
    NULL AS percent_difference,
  FROM orders_base
  WHERE payment_method = &quot;cash&quot;
    AND delivery_type = &quot;pickup&quot;
    AND total_monthly_cash_pu_orders &gt;&gt; 3
    AND total_monthly_cash_pu_gmv &gt;&gt;= 620

  UNION ALL

  SELECT
    orders_base.*,
    &quot;75% Order Share paid via Cash and had Vendor Delivery (Vendor GMV &gt;&gt;= 62000)&quot; AS vendor_flag,
    SAFE_DIVIDE(total_monthly_cash_vd_orders, total_monthly_orders) AS percent_difference
  FROM orders_base
  WHERE SAFE_DIVIDE(total_monthly_cash_vd_orders, total_monthly_orders) &gt;&gt;= .75 
    AND total_monthly_gmv &gt;&gt;= 62000
    AND payment_method = &quot;cash&quot;
    AND delivery_type = &quot;Vendor Delivery&quot;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
