    <worksheet name='Pickup Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>Pickup Metrics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='report_vendor_dashboard (bl_nordics)' name='federated.181pmcu05r5rno180yb5m0zgpb83' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.181pmcu05r5rno180yb5m0zgpb83'>
            <column caption='% Pickup Orders' datatype='real' name='[% Vendor Delivery Orders (copy)_2659657106436399107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_pickup])/SUM([successful_orders])' />
            </column>
            <column caption='# of Pickup Orders' datatype='integer' name='[Calculation_2060396881257496580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders_pickup]' />
            </column>
            <column caption='% Pickup Vendor Cancellation' datatype='real' name='[Calculation_2060396881257697285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor_pickup])/SUM([gross_orders_pickup])' />
            </column>
            <column caption='Date2' datatype='string' name='[Calculation_2060396881405546513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;END' />
            </column>
            <column caption='Pickup AFV (local)' datatype='real' name='[Calculation_2659657106440806428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local_pickup])/SUM([successful_orders_pickup])' />
            </column>
            <column caption='Pickup GFV (local)' datatype='real' name='[Calculation_2659657106440941597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_local_pickup]' />
