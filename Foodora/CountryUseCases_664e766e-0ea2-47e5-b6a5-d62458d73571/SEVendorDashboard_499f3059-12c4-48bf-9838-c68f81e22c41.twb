        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>Ops Metrics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='report_vendor_dashboard (bl_nordics)' name='federated.181pmcu05r5rno180yb5m0zgpb83' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.181pmcu05r5rno180yb5m0zgpb83'>
            <column caption='Date2' datatype='string' name='[Calculation_2060396881405546513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;END' />
            </column>
            <column caption='AVG Cooking Time' datatype='real' name='[Calculation_2659657106437570569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prep_time_mins])/SUM([prep_time_count])' />
            </column>
            <column caption='AVG Vendor Delay' datatype='real' name='[Calculation_2659657106438447117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_mins])/SUM([vendor_late_obs])' />
            </column>
            <column caption='% Vendor Delay (&gt; 5 min)' datatype='real' name='[Calculation_2659657106438615054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_count5])/SUM([vendor_late_obs])' />
            </column>
            <column caption='Vendor CVR' datatype='real' name='[Calculation_2659657106439524372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_transactions])/SUM([vendor_sessions_new])' />
            </column>
            <column caption='% Closed Hours' datatype='real' name='[Calculation_2659657106440069143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_hours])/SUM([open_hours])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2659657106442768423]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;END' />
            </column>
            <column caption='% Discount Orders' datatype='real' name='[Calculation_2659657106463383595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounts])/SUM([successful_orders])' />
            </column>
            <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column caption='AM Region' datatype='string' name='[am_region]' role='dimension' type='nominal' />
            <column caption='AM Team Lead' datatype='string' name='[am_team_lead]' role='dimension' type='nominal' />
            <column caption='Chain Code' datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[closed_hours]' role='measure' type='quantitative' />
            <column aggregation='None' caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[discounts]' role='measure' type='quantitative' />
            <column aggregation='None' caption='City (Logistics)' datatype='string' name='[lg_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Zone (Logistics)' datatype='string' name='[lg_zone]' role='dimension' type='nominal' />
