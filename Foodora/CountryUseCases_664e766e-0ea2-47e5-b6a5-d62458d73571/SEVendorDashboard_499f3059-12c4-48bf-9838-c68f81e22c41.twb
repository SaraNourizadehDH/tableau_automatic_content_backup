      <column caption='Pickup GFV (local)' datatype='real' name='[Calculation_2659657106440941597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gfv_local_pickup]' />
      </column>
      <column caption='# Orders with Deals DH-paid' datatype='integer' name='[Calculation_2659657106441334814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[deals_dh]' />
      </column>
      <column caption='% Deal Value DH-paid / Total GFV' datatype='real' name='[Calculation_2659657106441883682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discounts_value_dh])/SUM([gfv_local])' />
      </column>
      <column caption='# Vouchers DH-paid' datatype='integer' name='[Calculation_2659657106442240036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vouchers_dh]' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_2659657106442768423]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;END' />
      </column>
      <column caption='% Voucher Value DH-paid / Total GFV' datatype='real' name='[Calculation_2659657106442981416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vouchers_value_dh])/SUM([gfv_local])' />
      </column>
      <column caption='% Discount Orders' datatype='real' name='[Calculation_2659657106463383595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discounts])/SUM([successful_orders])' />
      </column>
