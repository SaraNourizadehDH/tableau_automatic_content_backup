        <view>
          <datasources>
            <datasource caption='report_vendor_dashboard (bl_nordics)' name='federated.181pmcu05r5rno180yb5m0zgpb83' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.181pmcu05r5rno180yb5m0zgpb83'>
            <column caption='# Orders with Deals Vendor-paid' datatype='integer' name='[# Orders with Deals DH-paid (copy)_2659657106441449503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[deals_vendor]' />
            </column>
            <column caption='# Orders with Deals Mixed-paid' datatype='integer' name='[# Orders with Deals Vendor-paid (copy)_2659657106441625633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[deals_mixed]' />
            </column>
            <column caption='# Vouchers Vendor-paid' datatype='integer' name='[# Vouchers DH-paid (copy)_2659657106442346533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vouchers_vendor]' />
            </column>
            <column caption='# Vouchers Mixed-paid' datatype='integer' name='[# Vouchers Vendor-paid (copy)_2659657106442481702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vouchers_mixed]' />
            </column>
            <column caption='# of Chains' datatype='integer' name='[# of Vendors (copy)_2659657106439888918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [gross_orders] &gt; 0 THEN [chain_code_geid] END)' />
            </column>
            <column caption='% Deal Value Vendor-paid / Total GFV' datatype='real' name='[% Deal Value DH-paid / Total GFV (copy)_2659657106442039331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounts_value_vendor])/SUM([gfv_local])' />
            </column>
            <column caption='% Vendor Delivery Orders' datatype='real' name='[% Own Delivery Orders (copy)_2659657106436325378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_vd])/SUM([successful_orders])' />
            </column>
            <column caption='% Delivery Orders' datatype='real' name='[% Pickup Orders (copy)_2659657106438176780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_delivery])/SUM([successful_orders])' />
            </column>
            <column caption='% Pickup Orders' datatype='real' name='[% Vendor Delivery Orders (copy)_2659657106436399107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_pickup])/SUM([successful_orders])' />
            </column>
            <column caption='% Voucher Value Vendor-paid / Total GFV' datatype='real' name='[% Voucher Value DH-paid / Total GFV (copy)_2659657106443169833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers_value_vendor])/SUM([gfv_local])' />
            </column>
            <column caption='Date2' datatype='string' name='[Calculation_2060396881405546513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;END' />
            </column>
            <column caption='# of Successful Orders' datatype='integer' name='[Calculation_2659657106436050944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders]' />
            </column>
            <column caption='% Own Delivery Orders' datatype='real' name='[Calculation_2659657106436161537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_od])/SUM([successful_orders])' />
            </column>
            <column caption='GFV (local)' datatype='real' name='[Calculation_2659657106436653060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_local]' />
            </column>
            <column caption='% Discount Value' datatype='real' name='[Calculation_2659657106436866053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounts_value])/SUM([gmv_local])' />
            </column>
            <column caption='AVG Daily Orders per Vendor' datatype='real' name='[Calculation_2659657106437029894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#13;&#10;SUM([successful_orders])&#13;&#10;/(SUM(IF [gross_orders] &gt; 0 THEN [days_in_month] END))&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#13;&#10;SUM([successful_orders])&#13;&#10;/(COUNTD(IF [gross_orders] &gt; 0 THEN [Calculation_2659657106442768423]+[vendor_code_geid] END)*7)&#13;&#10;END' />
            </column>
            <column caption='AVG Basket Size' datatype='real' name='[Calculation_2659657106437193735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local])/SUM([successful_orders])' />
            </column>
            <column caption='AVG Delivery Time' datatype='real' name='[Calculation_2659657106437341192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_mins])/SUM([delivery_time_cnt])' />
            </column>
            <column caption='AVG Cooking Time' datatype='real' name='[Calculation_2659657106437570569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([prep_time_mins])/SUM([prep_time_count])' />
            </column>
            <column caption='AVG Vendor Delay' datatype='real' name='[Calculation_2659657106438447117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_mins])/SUM([vendor_late_obs])' />
            </column>
            <column caption='% Vendor Delay (&gt; 5 min)' datatype='real' name='[Calculation_2659657106438615054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_count5])/SUM([vendor_late_obs])' />
            </column>
            <column caption='AVG Rating Food' datatype='real' name='[Calculation_2659657106438946831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_food_sum])/SUM([rating_food_cnt])' />
            </column>
            <column caption='AVG Rating Packaging' datatype='real' name='[Calculation_2659657106439065616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_packaging_sum])/SUM([rating_packaging_cnt])' />
