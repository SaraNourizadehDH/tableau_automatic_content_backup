      <column caption='Date Range' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1414411778958352385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([Calculation_1414411778958569474]),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_1414411778958569474]),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_1414411778958569474]),4)&#13;&#10;&#13;&#10;      +&quot; to &quot;+&#13;&#10;&#13;&#10;RIGHT(STR([Calculation_1414411778958569474]+6),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_1414411778958569474]+6),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_1414411778958569474]+6),4)' />
      </column>
      <column caption='Date (Week)' datatype='date' name='[Calculation_1414411778958569474]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_1414411778958675971]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10;when &apos;Day&apos; then str(DATENAME(&apos;month&apos;,[created_date_local])) +str(&apos; &apos;) +str(day([created_date_local])) +str(&apos;, &apos;) +str(DATENAME(&apos;weekday&apos;,[created_date_local]))&#13;&#10;when &apos;Week&apos; then [Calculation_1414411778958352385]&#13;&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;,[created_date_local])) + &apos;, &apos; + str(DATENAME(&apos;month&apos;,[created_date_local]))&#13;&#10;END' />
      </column>
      <column caption='Overall ICPO' datatype='real' name='[Calculation_274297391810035712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0)))+ (SUM(IFNULL([voucher_val], 0))))/SUM([ICPO_orders])' />
      </column>
      <column caption='Subsidy ICPO' datatype='real' name='[Calculation_274297391810195457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0))))/SUM([ICPO_orders])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_274297391810400258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ven_failed_orders])/SUM([gross_orders])' />
