    END AS lg_city,
    CASE
    WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
    ELSE vi.lg_zone_name
    END AS lg_zone_name,
    &apos;concepts&apos; AS vertical,
    vi.account_type,
    COUNT(DISTINCT(pd.pd_customer_uuid)) AS active_customers,
    COUNT(DISTINCT(CASE WHEN mc.first_valid_order_all_uuid IS NOT NULL THEN pd.pd_customer_uuid END)) AS new_customers

  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_orders_dates` AS mc
        ON pd.uuid = mc.first_valid_order_all_uuid
        AND pd.global_entity_id = mc.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
        ON pd.vendor_code = vi.vendor_code
        AND pd.global_entity_id = &quot;FP_PK&quot;

  WHERE pd.created_date_utc &gt;&gt;= &quot;2022-10-01&quot; -30
    AND pd.created_date_local &gt;&gt;= &quot;2022-10-01&quot;
    AND pd.global_entity_id = &quot;FP_PK&quot;
    AND pd.is_gross_order
    AND NOT pd.is_test_order
    AND pd.is_valid_order
    AND pd.expedition_type = &quot;pickup&quot;
    AND vi.vertical IN (&apos;concepts&apos;)
  GROUP BY 1, 2, 3, 4, 5
),

shops_pu AS (
  SELECT 
    pd.created_date_local,
    CASE
    WHEN vi.lg_city IS NULL THEN &quot;N/A&quot;
    ELSE vi.lg_city
    END AS lg_city,
    CASE
    WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
    ELSE vi.lg_zone_name
    END AS lg_zone_name,
    &apos;shops&apos; AS vertical,
    vi.account_type,
    COUNT(DISTINCT(pd.pd_customer_uuid)) AS active_customers,
    COUNT(DISTINCT(CASE WHEN mc.first_valid_order_all_uuid IS NOT NULL THEN pd.pd_customer_uuid END)) AS new_customers

  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_orders_dates` AS mc
        ON pd.uuid = mc.first_valid_order_all_uuid
        AND pd.global_entity_id = mc.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
        ON pd.vendor_code = vi.vendor_code
        AND pd.global_entity_id = &quot;FP_PK&quot;

  WHERE pd.created_date_utc &gt;&gt;= &quot;2022-10-01&quot; -30
    AND pd.created_date_local &gt;&gt;= &quot;2022-10-01&quot;
    AND pd.global_entity_id = &quot;FP_PK&quot;
    AND pd.is_gross_order
    AND NOT pd.is_test_order
    AND pd.is_valid_order
    AND pd.expedition_type = &quot;pickup&quot;
    AND vi.vertical IN (&apos;shops&apos;)
  GROUP BY 1, 2, 3, 4, 5
),

darkstores_pu AS (
  SELECT 
    pd.created_date_local,
    CASE
    WHEN vi.lg_city IS NULL THEN &quot;N/A&quot;
    ELSE vi.lg_city
    END AS lg_city,
    CASE
    WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
    ELSE vi.lg_zone_name
    END AS lg_zone_name,
    &apos;darkstores&apos; AS vertical,
    vi.account_type,
    COUNT(DISTINCT(pd.pd_customer_uuid)) AS active_customers,
    COUNT(DISTINCT(CASE WHEN mc.first_valid_order_all_uuid IS NOT NULL THEN pd.pd_customer_uuid END)) AS new_customers

  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_orders_dates` AS mc
        ON pd.uuid = mc.first_valid_order_all_uuid
        AND pd.global_entity_id = mc.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
        ON pd.vendor_code = vi.vendor_code
        AND pd.global_entity_id = &quot;FP_PK&quot;

  WHERE pd.created_date_utc &gt;&gt;= &quot;2022-10-01&quot; -30
    AND pd.created_date_local &gt;&gt;= &quot;2022-10-01&quot;
    AND pd.global_entity_id = &quot;FP_PK&quot;
    AND pd.is_gross_order
    AND NOT pd.is_test_order
    AND pd.is_valid_order
    AND pd.expedition_type = &quot;pickup&quot;
    AND vi.vertical IN (&apos;darkstores&apos;)
  GROUP BY 1, 2, 3, 4, 5
)

SELECT *, &quot;OD&quot; AS exp_type FROM resto_od
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM homechefs
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM kitchens
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM concepts
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM shops
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM darkstores
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM resto_od_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM homechefs_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM kitchens_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM concepts_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM shops_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM darkstores_pu</relation>
            </properties>
            <properties context='extract'>
              <relation name='_BA6536FA91D24210B2B79697B08772DC' table='[Extract].[_BA6536FA91D24210B2B79697B08772DC]' type='table' />
            </properties>
          </object>
          <object caption='Finance' id='_FF9D9D619F6E45D5BF6A9ED1CC8C8203'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query1' type='text'>SELECT 
cb.date_local,
cb.vertical,
CASE
  WHEN cb.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE cb.lg_city
END AS lg_city,
CASE
  WHEN cb.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE cb.lg_zone_name
END AS lg_zone_name,
CASE
  WHEN cb.expedition_type = &quot;pickup&quot; THEN &quot;Pickup&quot;
  WHEN cb.expedition_type = &quot;delivery&quot; AND LOWER(cb.exp_type) LIKE &quot;%%od%&quot; THEN &quot;OD&quot;
  WHEN cb.expedition_type = &quot;delivery&quot; AND LOWER(cb.exp_type) LIKE &quot;%vd%&quot; THEN &quot;VD&quot;
END AS exp_type,
vi.account_type,
COUNT(DISTINCT(cb.order_code)) AS billable_orders,
COUNT(DISTINCT(cb.joker_orders)) AS joker_orders,
SUM(IFNULL(cb.commission_revenue, 0)) AS commission_revenue,
SUM(IFNULL(cb.df_adj_exc_tax, 0)) AS df,
SUM(IFNULL(cb.commission_base, 0)) AS commission_base,
SUM(IFNULL(cb.service_fee_exc_tax, 0)) AS service_fee,
SUM(IFNULL(cb.joker_fee, 0)) AS joker_fee,
COUNT(DISTINCT CASE WHEN cb.priority_df_adj_exc_tax &gt;&gt; 0 THEN cb.order_code END) AS prio_orders,
SUM(IFNULL(cb.priority_df_adj_exc_tax, 0)) AS prio_fee

FROM `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` AS cb
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON cb.vendor_code = vi.vendor_code

WHERE cb.date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
AND cb.billable = &quot;Billable&quot;
AND LOWER(cb.vertical) IN (&quot;shared kitchens&quot;, &quot;restaurants&quot;, &quot;concepts&quot;, &quot;home chefs&quot;, &quot;darkstores&quot;, &quot;shops&quot;)

GROUP BY 1, 2, 3, 4, 5, 6</relation>
            </properties>
