    <worksheet name='KPIs (Consolidated) (Account Type)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#e02174' fontname='Tableau Bold' fontsize='10'>Account Type Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[PK] Zone Data' name='federated.1r7trsq0fs8hp615bzzmb0ufqwoz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r7trsq0fs8hp615bzzmb0ufqwoz'>
            <column datatype='integer' hidden='true' name='[Billable_orders_ICPO_denominator]' role='measure' type='quantitative' />
            <column caption='Day Name' datatype='string' name='[Calculation_1571474834058539008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [created_date_local])' />
            </column>
            <column caption='Delivery Time/Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1571474834086604807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([delivery_time]))/ZN(SUM([valid_orders]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1915718723554295808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10;when &apos;Day&apos; then str(DATENAME(&apos;month&apos;,[created_date_local])) +str(&apos; &apos;) +str(day([created_date_local])) +str(&apos;, &apos;) +str(DATENAME(&apos;weekday&apos;,[created_date_local]))&#13;&#10;when &apos;Week&apos; then [Calculation_381117178111410178]&#13;&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;,[created_date_local])) + &apos;, &apos; + str(DATENAME(&apos;month&apos;,[created_date_local]))&#13;&#10;END' />
            </column>
            <column caption='Reorder Rate (Weekly)' datatype='real' default-format='p0.00%' name='[Calculation_330451685123485696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reorder_customers])/SUM([unique_customers])' />
            </column>
            <column caption='calc' datatype='boolean' name='[Calculation_376050605873283072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, TODAY())&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -2, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -3, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -3, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -4, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -4, TODAY()))&#13;&#10;&#13;&#10;)' />
            </column>
            <column caption='Date (Week)' datatype='date' name='[Calculation_381117178111156225]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_381117178111410178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([Calculation_381117178111156225]),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_381117178111156225]),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_381117178111156225]),4)&#13;&#10;&#13;&#10;      +&quot; to &quot;+&#13;&#10;&#13;&#10;RIGHT(STR([Calculation_381117178111156225]+6),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_381117178111156225]+6),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_381117178111156225]+6),4)' />
            </column>
            <column caption='Overall IC' datatype='real' name='[Calculation_6097733226520322048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0)))+ (SUM(IFNULL([voucher_val], 0))))' />
            </column>
            <column caption='Customer Facing Discount Per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6097733226520788993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_discount])/SUM([valid_orders])' />
            </column>
            <column caption='Customer Fail Rate' datatype='real' name='[Calculation_705376329997545472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cus_failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Logistics Fail Rate' datatype='real' name='[Calculation_705376329997774849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([log_failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Shrink Orders %age (inc. Shrink 0)' datatype='real' default-format='p0.0%' name='[Calculation_834291865810587649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([shrink_0_orders]) + SUM([shrink_1st_orders]) + SUM([shrink_2nd_orders]) + SUM([shrink_3rd_orders]) + SUM([shrink_4th_orders]) + SUM([shrink_5th_orders]) + SUM([shrink_6th_orders]))/SUM([forecasted_orders])' />
            </column>
            <column caption='Shrink 0 Orders %age' datatype='real' default-format='p0.0%' name='[Calculation_834291865810788354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_0_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_931963679236571136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='RPO (Inc. DF)' datatype='real' name='[Calculation_931963679237328897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([commission_revenue]) + SUM([df]))/SUM([billable_orders])' />
            </column>
            <column caption='DF/Order' datatype='real' name='[Calculation_931963679237992450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df])/SUM(IF [exp_type] = &quot;OD&quot; THEN [billable_orders] END)' />
            </column>
            <column caption='Basket Size' datatype='real' name='[Calculation_931963679238463491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_base])/SUM([billable_orders])' />
            </column>
            <column caption='Service Fee/Order' datatype='real' name='[Calculation_931963679238717444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee])/SUM([billable_orders])' />
            </column>
            <column caption='Pandabox Revenue/Order' datatype='real' name='[Calculation_931963679242358789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_fee])/SUM([joker_orders])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_931963679271030790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ven_failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Offline Hours %age' datatype='real' name='[Calculation_931963679271428103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_close_hours])/SUM([total_open_hours])' />
            </column>
            <column caption='DLD' datatype='real' name='[Calculation_931963679271845896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([products_with_description])/SUM([total_product])' />
            </column>
            <column caption='DLP' datatype='real' name='[Calculation_931963679272071177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([products_with_images])/SUM([total_product])' />
            </column>
            <column caption='Overall ICPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_931963679272411146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0)))+ (SUM(IFNULL([voucher_val], 0))))/SUM([ICPO_orders])' />
            </column>
            <column caption='Subsidy ICPO' datatype='real' name='[Calculation_931963679272673291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0))))/SUM([ICPO_orders])' />
            </column>
            <column caption='Voucher ICPO' datatype='real' name='[Calculation_931963679274340364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([voucher_val], 0))/SUM([ICPO_orders])' />
            </column>
            <column caption='Conversion' datatype='real' name='[Calculation_931963679274983437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([resto_transactions])/SUM([resto_sessions])' />
            </column>
            <column caption='Existing Customers' datatype='integer' name='[Calculation_931963679275425806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_customers]) - SUM([new_customers])' />
            </column>
            <column caption='Order Frequency' datatype='real' name='[Calculation_931963679275675663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders])/SUM([valid_customers])' />
            </column>
            <column caption='Surge %age' datatype='real' name='[Calculation_931963679276642320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([duration_delay])/SUM([opening_duration])' />
            </column>
            <column caption='Surge Orders %age' datatype='real' default-format='p0.0%' name='[Calculation_931963679277297681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([surged_1st_order_experience]) + SUM([surged_2nd_order_experience]) + SUM([surged_3rd_order_experience]) + SUM([surged_4th_order_experience]) + SUM([surged_above_4_order_experience]))/SUM([actual_orders])' />
            </column>
            <column caption='Shrink %age' datatype='real' name='[Calculation_931963679278014482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([duration_shrink])/SUM([opening_duration])' />
            </column>
            <column caption='Shrink Orders %age (exc. Shrink 0)' datatype='real' default-format='p0.0%' name='[Calculation_931963679279616019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([shrink_1st_orders]) + SUM([shrink_2nd_orders]) + SUM([shrink_3rd_orders]) + SUM([shrink_4th_orders]) + SUM([shrink_5th_orders]) + SUM([shrink_6th_orders]))/SUM([forecasted_orders])' />
            </column>
            <column datatype='integer' hidden='true' name='[ICPO_orders]' role='measure' type='quantitative' />
            <column caption='Overall ICPO - Vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Overall ICPO (copy)_1571474834112856074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashbackk_vendor], 0)) + SUM(IFNULL([non_ncp_cashback_vendor], 0)) + (SUM(IFNULL([commercial_subsidy_voucher_burn_vendor], 0)))+ (SUM(IFNULL([voucher_num_vendor], 0))))/SUM([Billable_orders_ICPO_denominator])' />
            </column>
            <column caption='Subsidy ICPO - Vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Subsidy ICPO (copy)_1571474834113585165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashbackk_vendor], 0)) + SUM(IFNULL([non_ncp_cashback_vendor], 0)) + (SUM(IFNULL([commercial_subsidy_voucher_burn_vendor], 0))))/SUM([Billable_orders_ICPO_denominator])' />
            </column>
            <column caption='Surge %age (7PM - 5AM)' datatype='real' default-format='p0.00%' name='[Surge %age (copy)_1568448948979896321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([duration_7pm_delay])/SUM([opening_duration])' />
            </column>
            <column caption='Surge Orders %age (7PM - 5AM)' datatype='real' default-format='p0.00%' name='[Surge Orders %age (copy)_1568448948986040322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([surged_1st_order_experience_7pm]) + SUM([surged_2nd_order_experience_7pm]) + SUM([surged_3rd_order_experience_7pm]) + SUM([surged_4th_order_experience_7pm]) + SUM([surged_above_4_order_experience_7pm]))/SUM([actual_orders_7pm])' />
            </column>
            <column caption='Voucher ICPO - Vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Voucher ICPO (copy)_1571474834114015248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([voucher_num_vendor], 0))/SUM([Billable_orders_ICPO_denominator])' />
            </column>
            <column caption='Account Type' datatype='string' name='[account_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_order_inventory]' role='measure' type='quantitative' />
            <column datatype='real' name='[actual_open_hours]' role='measure' type='quantitative' visual-totals='Sum' />
            <column datatype='integer' name='[actual_open_vendors]' role='measure' type='quantitative' visual-totals='Sum' />
            <column datatype='integer' hidden='true' name='[actual_orders]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[actual_orders_7pm]' role='measure' type='quantitative' />
