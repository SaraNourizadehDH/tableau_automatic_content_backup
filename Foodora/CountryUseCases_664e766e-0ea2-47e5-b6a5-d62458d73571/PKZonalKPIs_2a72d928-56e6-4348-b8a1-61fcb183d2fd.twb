    <worksheet name='Meal Time'>
      <table>
        <view>
          <datasources>
            <datasource caption='Meal Time Breakdown' name='federated.13rqgt50wz9im317tw9ej1dwsrbi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Date Granularity Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13rqgt50wz9im317tw9ej1dwsrbi'>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1915718723554295808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Date Granularity Parameter]&#13;&#10;when &apos;Day&apos; then str(DATENAME(&apos;month&apos;,[created_date_local])) +str(&apos; &apos;) +str(DAY([created_date_local])) +str(&apos;, &apos;) +str(DATENAME(&apos;weekday&apos;,[created_date_local]))&#13;&#10;when &apos;Week&apos; then [Calculation_381117178111410178]&#13;&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;,[created_date_local])) + &apos;, &apos; + str(DATENAME(&apos;month&apos;,[created_date_local]))&#13;&#10;END' />
            </column>
            <column caption='Surge%' datatype='integer' default-format='p0.00%' name='[Calculation_1925570380979482624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DIV((&#13;&#10;SUM([surged_1st_order_experience])&#13;&#10;+&#13;&#10;SUM([surged_2nd_order_experience])&#13;&#10;+&#13;&#10;SUM([surged_3rd_order_experience])&#13;&#10;+&#13;&#10;SUM([surged_4th_order_experience])&#13;&#10;+&#13;&#10;SUM([surged_above_4_order_experience])&#13;&#10;),&#13;&#10;SUM([actual_orders]))' />
            </column>
            <column caption='Shrink%' datatype='real' default-format='p0.00%' name='[Calculation_1925570380980469761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(&#13;&#10;SUM([shrink_1st_orders])&#13;&#10;+&#13;&#10;SUM([shrink_2nd_orders])&#13;&#10;+&#13;&#10;SUM([shrink_3rd_orders])&#13;&#10;+&#13;&#10;SUM([shrink_4th_orders])&#13;&#10;+&#13;&#10;SUM([shrink_5th_orders])&#13;&#10;+&#13;&#10;SUM([shrink_6th_orders])&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([forecasted_orders]))' />
            </column>
            <column caption='Conversions%' datatype='real' default-format='p0.00%' name='[Calculation_210824823478317056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_with_order])/SUM([sessions])' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_381117178111410178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR(DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR(DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR(DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))),4)&#13;&#10;&#13;&#10;      +&quot; to &quot;+&#13;&#10;&#13;&#10;RIGHT(STR(DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local])) +6),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR(DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))+6),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR(DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))+6),4)' />
            </column>
            <column caption='P-D Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_40602825616314368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUm([delivery_distance_in_meters])/1000 /SUm([actual_orders (Custom SQL Query2)])' />
            </column>
            <column caption='Delivery Time / Order' datatype='real' name='[Calculation_4344425538954350592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time])/SUM([valid_orders])' />
            </column>
            <column caption='Day Name' datatype='string' name='[Calculation_6378856329518231553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[created_date_local])' />
            </column>
            <column datatype='string' name='[account_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[active_order_inventory]' role='measure' type='quantitative' />
            <column datatype='integer' name='[actual_orders (Custom SQL Query2)]' role='measure' type='quantitative' />
            <column datatype='integer' hidden='true' name='[actual_orders]' role='measure' type='quantitative' />
            <column-instance column='[ops_hours]' derivation='Avg' name='[avg:ops_hours:qk]' pivot='key' type='quantitative' />
            <column caption='Time Bucket' datatype='string' name='[bucket]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;A - Breakfast (8AM - 12PM)&quot;' value='C - Breakfast (8AM - 12PM)' />
                <alias key='&quot;B - Lunch (12PM - 3PM)&quot;' value='D - Lunch (12PM - 4PM)' />
                <alias key='&quot;C - Snack (4PM - 7PM)&quot;' value='E - Snack (4PM - 7PM)' />
                <alias key='&quot;D - Dinner (7PM - 12AM)&quot;' value='F - Dinner (7PM - 12AM)' />
                <alias key='&quot;E - Midnight (12AM - 5AM)&quot;' value='A - Midnight (12AM - 5AM)' />
                <alias key='&quot;F - Other&quot;' value='B - Early Morning (5AM - 8AM)' />
              </aliases>
            </column>
