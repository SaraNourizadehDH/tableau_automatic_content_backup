      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query2' id='_3EE0A7A63BEE44CCA9908A28B090B2CF'>
            <properties context=''>
              <relation connection='bigquery.1fu7tg31jklrgb13cj5wm0pic1uy' name='Custom SQL Query2' type='text'>WITH
countries AS (
  SELECT
    countries.country_code AS country_code, 
    countries.country_name AS country_name, 
    cities.name AS city_name, 
    zones.name AS zone_name,
    cities.id AS lg_city_id, 
    zones.id AS lg_zone_id  
  FROM 
    `fulfillment-dwh-production.curated_data_shared.countries` AS countries, UNNEST(cities) AS cities, UNNEST(zones) AS zones
  WHERE 
   country_code = &apos;pk&apos;
),

  actual_orders AS (
    SELECT
      DISTINCT 
      &quot;FP_PK&quot; AS global_entity_id,
      orders.platform_order_code AS order_code,
      DATETIME(orders.order_placed_at, orders.timezone) AS order_placed_at_local,
      DATE(DATETIME(orders.created_at, orders.timezone)) AS created_date_local,
      orders.country_code AS lg_country_code,
        orders.city_id AS lg_city_id,
      orders.zone_id AS lg_zone_id,
      orders.vendor.vendor_code AS vendor_code,
      
      orders.order_status AS rider_order_status,
      d.delivery_status AS delivery_status,    
      d.delivery_distance AS delivery_distance_in_meters

    FROM 
      `fulfillment-dwh-production.curated_data_shared.orders` orders, 
      UNNEST(deliveries) d,
      UNNEST(d.transitions) dt  
    WHERE  
      DATE(orders.created_date) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
      AND d.is_primary = TRUE
      AND orders.country_code = &apos;pk&apos;
  ),

  completed_orders AS (
    SELECT
      DATE(o.order_placed_at_local) AS order_date,
      vi.vertical,
      c.city_name AS city_name,
      c.zone_name AS zone_name,
      SUM(o.delivery_distance_in_meters) AS delivery_distance_in_meters,
      COUNT(o.order_code) AS actual_orders,
    FROM actual_orders o
    LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
    ON 
      vi.vendor_code  = o.vendor_code
     LEFT JOIN countries c 
    ON
      c.country_code = o.lg_country_code
      AND c.lg_city_id = o.lg_city_id
      AND c.lg_zone_id = o.lg_zone_id
    WHERE 
      o.lg_country_code = &apos;pk&apos;
      AND DATE(o.created_date_local) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
      AND o.delivery_status = &apos;completed&apos;
      AND c.zone_name IS NOT NULL
    GROUP BY 1,2,3,4
  ),
total AS (
  SELECT 
  order_date,
  city_name,
  zone_name,
  vertical,
  &quot;OD&quot; AS expedition_type,
  &quot;Accounts&quot; AS account_type,
  &quot;Total&quot; AS bucket,
  comp_orders.delivery_distance_in_meters,
  comp_orders.actual_orders 
 
  FROM completed_orders comp_orders
),

hourly AS (
    SELECT
      DATE(o.order_placed_at_local) AS order_date,
      vi.vertical,
      c.city_name AS city_name,
      c.zone_name AS zone_name,
      &quot;OD&quot; AS expedition_type,
      &quot;Accounts&quot; AS account_type,
 CASE 
        WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
        WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
        WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
        WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
        WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
        ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
      END AS bucket,

      SUM(o.delivery_distance_in_meters) AS delivery_distance_in_meters,
      COUNT(o.order_code) AS actual_orders,
    FROM actual_orders o
    LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
    ON 
      vi.vendor_code  = o.vendor_code
     LEFT JOIN countries c 
    ON
      c.country_code = o.lg_country_code
      AND c.lg_city_id = o.lg_city_id
      AND c.lg_zone_id = o.lg_zone_id
    WHERE 
      o.lg_country_code = &apos;pk&apos;
      AND DATE(o.created_date_local) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
      AND o.delivery_status = &apos;completed&apos;
      AND c.zone_name IS NOT NULL
    GROUP BY 1,2,3,4,5,6,7
  )

  SELECT * 
  FROM hourly
  UNION ALL
  SELECT * 
  FROM total</relation>
            </properties>
            <properties context='extract'>
              <relation name='_3EE0A7A63BEE44CCA9908A28B090B2CF' table='[Extract].[_3EE0A7A63BEE44CCA9908A28B090B2CF]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query1' id='_48B04E656045472F9DEF955DA8213083'>
            <properties context=''>
              <relation connection='bigquery.1fu7tg31jklrgb13cj5wm0pic1uy' name='Custom SQL Query1' type='text'>WITH 
  countries AS (
  SELECT
    countries.country_code AS country_code, 
    countries.country_name AS country_name, 
    cities.name AS city_name, 
    zones.name AS zone_name,
    cities.id AS lg_city_id, 
    zones.id AS lg_zone_id  
  FROM 
    `fulfillment-dwh-production.curated_data_shared.countries` AS countries, UNNEST(cities) AS cities, UNNEST(zones) AS zones
  WHERE 
  country_code = &apos;pk&apos;
),

  orders AS (
    SELECT
      DISTINCT 
      orders.order_code AS order_code,
      orders.global_entity_id,
      orders.rider.order_placed_at_local AS order_placed_at_local,
      orders.created_date_local AS created_date_local,
      orders.rider.lg_city_id AS lg_city_id,
      orders.rider.lg_zone_id AS lg_zone_id,  
      orders.rider.order_status AS rider_order_status,
      d.status AS delivery_status,
      d.lg_rider_id,
    FROM 
      `fulfillment-dwh-production.pandata_report.country_PK_lg_orders` orders, 
      UNNEST(rider.deliveries) d,
      UNNEST(d.transitions) dt  
    WHERE  
      DATE(orders.created_date_utc) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
      AND d.is_primary = TRUE
      AND orders.global_entity_id = &apos;FP_PK&apos;
      AND orders.rider.lg_country_code = &apos;pk&apos;
    GROUP BY 
      1,2,3,4,5,6,7,8,9
  ),

  hourly_riders AS (
    SELECT
      DATE(o.order_placed_at_local) AS order_date,
      CASE
        WHEN c.city_name IS NULL THEN &quot;Other&quot;
        ELSE c.city_name
      END AS city_name,
      CASE
        WHEN c.zone_name IS NULL THEN &quot;Other&quot;
        ELSE c.zone_name
      END AS zone_name,
      &quot;restaurants&quot; AS vertical,
      &quot;OD&quot; AS expedition_type,
      &quot;Accounts&quot; AS account_type,
               CASE 
        WHEN EXTRACT(HOUR from o.order_placed_at_local) IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
        WHEN EXTRACT(HOUR from o.order_placed_at_local) IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
        WHEN EXTRACT(HOUR from o.order_placed_at_local) IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
        WHEN EXTRACT(HOUR from o.order_placed_at_local) IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
        WHEN EXTRACT(HOUR from o.order_placed_at_local) IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
        ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
      END AS bucket,
      COUNT(o.order_code) AS actual_orders,
      COUNT(DISTINCT o.lg_rider_id) AS total_riders,
      
    FROM orders o
    LEFT JOIN countries AS c  
    ON
      c.lg_city_id = o.lg_city_id
      AND c.lg_zone_id = o.lg_zone_id
      AND c.country_code = &apos;pk&apos;
      -- AND c.country_code = o.country_code
    WHERE 
      o.global_entity_id = &apos;FP_PK&apos;
      AND DATE(o.created_date_local) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
      AND o.delivery_status = &apos;completed&apos;
      AND c.zone_name IS NOT NULL
    GROUP BY 1,2,3,4,5,6,7
    ORDER BY 1,2,3,4,5,6,7
  ),

total_riders AS (
    SELECT
      DATE(o.order_placed_at_local) AS order_date,
      CASE
        WHEN c.city_name IS NULL THEN &quot;Other&quot;
        ELSE c.city_name
      END AS city_name,
      CASE
        WHEN c.zone_name IS NULL THEN &quot;Other&quot;
        ELSE c.zone_name
      END AS zone_name, 
      &quot;restaurants&quot; AS vertical,
      &quot;OD&quot; AS expedition_type,
      &quot;Total&quot; AS bucket,
      &quot;Accounts&quot; AS account_type,
      COUNT(o.order_code) AS actual_orders,
      COUNT(DISTINCT o.lg_rider_id) AS total_riders,
      
    FROM orders o
    LEFT JOIN countries AS c  
    ON
      c.lg_city_id = o.lg_city_id
      AND c.lg_zone_id = o.lg_zone_id
      AND c.country_code = &apos;pk&apos;
      -- AND c.global_entity_id = o.global_entity_id
    WHERE 
      o.global_entity_id = &apos;FP_PK&apos;
      AND DATE(o.created_date_local) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
      AND o.delivery_status = &apos;completed&apos;
      AND c.zone_name IS NOT NULL
    GROUP BY 1,2,3,4,5,6,7
    ORDER BY 1,2,3,4,5,6,7
  )
  
  SELECT *
  FROM hourly_riders
  UNION ALL
  SELECT * 
  FROM total_riders</relation>
            </properties>
            <properties context='extract'>
              <relation name='_48B04E656045472F9DEF955DA8213083' table='[Extract].[_48B04E656045472F9DEF955DA8213083]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query3' id='_49CB6F28B1224CDC9C9F89E5FC08D8FF'>
            <properties context=''>
              <relation connection='bigquery.1fu7tg31jklrgb13cj5wm0pic1uy' name='Custom SQL Query3' type='text'><![CDATA[WITH av_time as (
    SELECT 
      DATE(ev.start_at_local) as report_date,
      rider_id AS lg_rider_id,
      zone_id AS lg_zone_id,
      TIMESTAMP(ev.start_at_local) as start_time,
      TIMESTAMP(ev.end_at_local) as end_time
    FROM `fulfillment-dwh-production.curated_data_shared.shifts` as shifts, 
    UNNEST (evaluations) as ev
    WHERE 
      created_date  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), MONTH), INTERVAL 3 MONTH)
      and country_code = 'pk'  
      and ev.duration >> 0 
      and shift_state='EVALUATED' 
  ),

  gen as (
    Select 
      av_time.*,
      h
    from 
      av_time, 
      UNNEST (GENERATE_TIMESTAMP_ARRAY(TIMESTAMP_TRUNC(start_time,hour), end_time,INTERVAL 1 HOUR)) AS h
    where 
      report_date  >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE("Asia/Karachi"), MONTH), INTERVAL 3 MONTH)
    -- and lg_rider_id=29942
  ),

  breakup as (
    Select gen.*,
      CASE 
        when Extract(hour from h)>>Extract(hour from start_time) and Extract(hour from h)<< Extract (hour from end_time) then 60
        when Extract(hour from h)=Extract(hour from start_time) and Extract(hour from h)=Extract (hour from end_time) then timestamp_diff (end_time,start_time,second)/60
        when Extract (date from start_time)= Extract (date from end_time) and Extract(hour from h)>>Extract(hour from start_time) and Extract(hour from h)=Extract (hour from end_time) then ((extract(minute from end_time)*60)+extract(second from end_time))/60
        when Extract (date from start_time)= Extract (date from end_time) and Extract(hour from h)=Extract(hour from start_time) and Extract(hour from h)<<Extract (hour from end_time) and timestamp_diff (start_time,h,minute)=0 then 60
        when Extract (date from start_time)= Extract (date from end_time) and Extract(hour from h)=Extract(hour from start_time) and Extract(hour from h)<<Extract (hour from end_time) then 60 - (((Extract(minute from start_time)*60)+Extract(second from start_time))/60)
        when Extract (date from start_time)= Extract (date from end_time) and Extract(hour from h)>>Extract(hour from start_time) and Extract(hour from h)>>Extract (hour from end_time) then 0 
        when Extract(hour from h)=Extract(hour from start_time) and h << end_time then 60 - (((Extract(minute from start_time)*60)+Extract(second from start_time))/60)
        when h>>start_time and h <<end_time then 60
        when h>>start_time and Extract(hour from h) << Extract(hour from end_time) then 60
        when h>>start_time and Extract(hour from h) = Extract(hour from end_time) then ((extract(minute from end_time)*60)+extract(second from end_time))/60
      END as duration
    from gen
  ),

  countries AS (
    SELECT
      country_code, 
      cities.id as lg_city_id, 
      zones.id as lg_zone_id, 
      cities.name as city_name, 
      zones.name as zone_name
    FROM `fulfillment-dwh-production.curated_data_shared.countries`, 
    UNNEST(cities) as cities, UNNEST(zones) as zones
    WHERE 
      country_code = 'pk'
  ),

  filter_1 as (
    Select 
      report_date,
      lg_rider_id,
      lg_zone_id,
      Extract(hour from h) as hours, 
      sum(duration) as minutes
    from breakup
    where 
      duration >>0
    Group by 
      1,2,3,4
  ),

 hourly AS ( Select 
    report_date,
                     CASE 
        WHEN f2.hours IN (8,9,10,11) THEN "C - Breakfast (8AM - 12PM)"
        WHEN f2.hours IN (12,13,14,15) THEN "D - Lunch (12PM - 4PM)"
        WHEN f2.hours IN (16,17,18) THEN "E - Snack (4PM - 7PM)"
        WHEN f2.hours IN (19,20,21,22,23) THEN "F - Dinner (7PM - 12AM)"
        WHEN f2.hours IN (0,1,2,3,4) THEN "A - Midnight (12AM - 5AM)"
        ELSE "B - Early Morning (5AM - 8AM)" 
      END AS bucket,
      

    c.city_name,
    c.zone_name,
    "restaurants" AS vertical,
    "OD" AS expedition_type,
    "Accounts" AS account_type,
    -- hours,
    SUM(minutes)/60 as working_hours
    
  from filter_1 as f2
  left join (
    Select 
      lg_zone_id,
      zone_name,
      lg_city_id,
      city_name
    from countries
  ) as c 
  on 
    c.lg_zone_id = f2.lg_zone_id
  Group by 
    1,2,3,4,5
    -- ,4,5,6,7,8,9,10,11
  ORDER BY 
    1,2),

  total AS (
Select 
    report_date,
    "Total" AS bucket,
    c.city_name,
    c.zone_name,
    "restaurants" AS vertical,
    "OD" AS expedition_type,
    "Accounts" AS account_type,
    -- hours,
    SUM(minutes)/60 as working_hours
    
  from filter_1 as f2
  left join (
    Select 
      lg_zone_id,
      zone_name,
      lg_city_id,
      city_name
    from countries
  ) as c 
  on 
    c.lg_zone_id = f2.lg_zone_id
  Group by 
    1,2,3,4,5
    -- ,4,5,6,7,8,9,10,11
  ORDER BY 
    1,2
  )
  SELECT * EXCEPT(city_name, zone_name),
  CASE
    WHEN city_name IS NULL THEN "Other"
    ELSE city_name
  END AS city_name,
  CASE
    WHEN zone_name IS NULL THEN "Other"
    ELSE zone_name
  END AS zone_name  
  FROM hourly
  UNION ALL
  SELECT * EXCEPT(city_name, zone_name),
  CASE
    WHEN city_name IS NULL THEN "Other"
    ELSE city_name
  END AS city_name,
  CASE
    WHEN zone_name IS NULL THEN "Other"
    ELSE zone_name
  END AS zone_name
  FROM total]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_49CB6F28B1224CDC9C9F89E5FC08D8FF' table='[Extract].[_49CB6F28B1224CDC9C9F89E5FC08D8FF]' type='table' />
            </properties>
          </object>
          <object caption='Meal_Time' id='_6E5518E178654E6499B855DDB809998E'>
            <properties context=''>
              <relation connection='bigquery.1fu7tg31jklrgb13cj5wm0pic1uy' name='Custom SQL Query' type='text'>--orders
-- surge
-- shrink
--- sessions
---conversions
---order active inv
--- rider working hours
----- active riders,
----- vendor operational hours
----- utr
--- fail rate
---- vendor fr
-- cust fr
---- log fr
--- discounted orders %
---- icpo 

--hourly and vertical, expedition type, city, zone, kpi

WITH 
  hourly_orders AS(
    SELECT 
      pd.global_entity_id,
      pd.created_date_local,
      vi.vertical,
      vi.account_type,
      CASE
        WHEN vi.lg_city IS NULL THEN &quot;Other&quot;
        ELSE vi.lg_city
      END AS city_name,
      CASE
        WHEN vi.lg_zone_name IS NULL THEN &quot;Other&quot;
        ELSE vi.lg_zone_name
      END AS zone_name,
      CASE
        WHEN pd.expedition_type = &quot;pickup&quot; THEN &quot;Pickup&quot;
        WHEN pd.expedition_type = &quot;delivery&quot; AND pd.is_own_delivery THEN &quot;OD&quot;
        WHEN pd.expedition_type = &quot;delivery&quot; AND NOT pd.is_own_delivery THEN &quot;VD&quot;
      END AS expedition_type,
      CASE 
        WHEN EXTRACT(HOUR from pd.created_at_local) IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
        WHEN EXTRACT(HOUR from pd.created_at_local) IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
        WHEN EXTRACT(HOUR from pd.created_at_local) IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
        WHEN EXTRACT(HOUR from pd.created_at_local) IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
        WHEN EXTRACT(HOUR from pd.created_at_local) IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
        ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
      END AS bucket,
      COUNT(DISTINCT(pd.code)) AS gross_orders,
      COUNT(DISTINCT(CASE WHEN pd.is_valid_order THEN pd.code END)) AS valid_orders,
      COUNT(DISTINCT(CASE WHEN pd.is_valid_order THEN pd.vendor_code END)) AS active_order_inventory,
      COUNT(DISTINCT(CASE WHEN pd.is_failed_order_vendor THEN pd.code END)) AS ven_failed_orders,
      COUNT(DISTINCT(CASE WHEN pd.is_failed_order_customer THEN pd.code END)) AS cus_failed_orders,
      COUNT(DISTINCT(CASE WHEN pd.is_failed_order_foodpanda THEN pd.code END)) AS log_failed_orders,
      COUNt(DISTINCT(CASE WHEN pd.is_valid_order AND dis.is_discount_used THEN pd.code END)) AS discounted_orders,
      SUM(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN pd.delivery_time_in_minutes END) AS delivery_time,
      SUM(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN deliveries.delivery_distance_in_meters END) AS distance,
      COUNT(DISTINCT(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN pd.code END)) AS od_valid_orders

    FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
    LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
    ON vi.vendor_code = pd.vendor_code
    AND pd.global_entity_id = &quot;FP_PK&quot;
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` AS dis
    ON pd.code = dis.order_code
    AND pd.global_entity_id = dis.global_entity_id
    AND dis.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) - 10
    LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_lg_orders` AS lg 
    ON pd.code = lg.order_code 
    AND lg.global_entity_id = &quot;FP_PK&quot;
    AND lg.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) - 10
    LEFT JOIN UNNEST(lg.rider.deliveries) AS deliveries
       ON deliveries.is_primary

    WHERE pd.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) - 10
    AND pd.created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
    AND pd.global_entity_id = &quot;FP_PK&quot;
    AND pd.is_gross_order
    AND NOT pd.is_test_order
    AND LOWER(vi.vertical) IN ( &quot;restaurants&quot;,&quot;home chefs&quot;,&quot;shared kitchens&quot;,&quot;concepts&quot;,&quot;shops&quot;,&quot;darkstores&quot;)
    --AND pd.expedition_type = &quot;delivery&quot;
    GROUP BY 1, 2, 3, 4, 5, 6, 7, 8
),

total AS (
  SELECT 
    pd.global_entity_id,
    pd.created_date_local,
    vi.vertical,
    vi.account_type,
    CASE
      WHEN vi.lg_city IS NULL THEN &quot;Other&quot;
      ELSE vi.lg_city
    END AS city_name,
    CASE
      WHEN vi.lg_zone_name IS NULL THEN &quot;Other&quot;
      ELSE vi.lg_zone_name
    END AS zone_name,
    CASE
      WHEN pd.expedition_type = &quot;pickup&quot; THEN &quot;Pickup&quot;
      WHEN pd.expedition_type = &quot;delivery&quot; AND pd.is_own_delivery THEN &quot;OD&quot;
      WHEN pd.expedition_type = &quot;delivery&quot; AND NOT pd.is_own_delivery THEN &quot;VD&quot;
    END AS expedition_type,
    &quot;Total&quot; AS bucket,
    COUNT(DISTINCT(pd.code)) AS gross_orders,
    COUNT(DISTINCT(CASE WHEN pd.is_valid_order THEN pd.code END)) AS valid_orders,
    COUNT(DISTINCT(CASE WHEN pd.is_valid_order THEN pd.vendor_code END)) AS active_order_inventory,
    COUNT(DISTINCT(CASE WHEN pd.is_failed_order_vendor THEN pd.code END)) AS ven_failed_orders,
    COUNT(DISTINCT(CASE WHEN pd.is_failed_order_customer THEN pd.code END)) AS cus_failed_orders,
    COUNT(DISTINCT(CASE WHEN pd.is_failed_order_foodpanda THEN pd.code END)) AS log_failed_orders,
    COUNt(DISTINCT(CASE WHEN pd.is_valid_order AND dis.is_discount_used THEN pd.code END)) AS discounted_orders,
    SUM(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN pd.delivery_time_in_minutes END) AS delivery_time,
      SUM(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN deliveries.delivery_distance_in_meters END) AS distance,
      COUNT(DISTINCT(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN pd.code END)) AS od_valid_orders

  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
  ON vi.vendor_code = pd.vendor_code
  AND pd.global_entity_id = &quot;FP_PK&quot;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` AS dis
  ON pd.code = dis.order_code
  AND pd.global_entity_id = dis.global_entity_id
  AND dis.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) - 10
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_lg_orders` AS lg 
    ON pd.code = lg.order_code 
    AND lg.global_entity_id = &quot;FP_PK&quot;
    AND lg.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) - 10
    LEFT JOIN UNNEST(lg.rider.deliveries) AS deliveries
       ON deliveries.is_primary

  WHERE pd.created_date_utc &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) - 10
  AND pd.created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
  AND pd.global_entity_id = &quot;FP_PK&quot;
  AND pd.is_gross_order
  AND NOT pd.is_test_order
  AND LOWER(vi.vertical) IN ( &quot;restaurants&quot;,&quot;home chefs&quot;,&quot;shared kitchens&quot;,&quot;concepts&quot;,&quot;shops&quot;,&quot;darkstores&quot;)
  --AND pd.expedition_type = &quot;delivery&quot;
  GROUP BY 1, 2, 3, 4, 5, 6, 7, 8
),

orders AS (
SELECT *
FROM hourly_orders
UNION ALL
SELECT *
FROM total

),

hourly_offline AS (
SELECT 
      off.report_date,
      off.vertical,
      vi.account_type,
      CASE
        WHEN vi.lg_city IS NULL THEN &quot;Other&quot;
        ELSE vi.lg_city
      END AS city_name,
      CASE
        WHEN vi.lg_zone_name IS NULL THEN &quot;Other&quot;
        ELSE vi.lg_zone_name
      END AS zone_name,
      &quot;OD&quot; AS expedition_type,
        CASE 
        WHEN hour_of IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
        WHEN hour_of IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
        WHEN hour_of IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
        WHEN hour_of  IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
        WHEN hour_of  IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
        ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
      END AS bucket,
  SUM(off.total_open_time)/60 AS total_open_hours,
  SUM(off.total_close_time)/60 AS total_close_hours
FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_hourly_offline_hours` AS off
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON off.vendor_code = vi.vendor_code

WHERE off.report_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)

GROUP BY 1,2,3,4,5,6,7
),

total_offline AS (
SELECT 
 off.report_date,
      off.vertical,
      vi.account_type,
      CASE
        WHEN vi.lg_city IS NULL THEN &quot;Other&quot;
        ELSE vi.lg_city
      END AS city_name,
      CASE
        WHEN vi.lg_zone_name IS NULL THEN &quot;Other&quot;
        ELSE vi.lg_zone_name
      END AS zone_name,
      &quot;OD&quot; AS expedition_type,
      &quot;Total&quot; AS bucket,
  SUM(off.total_open_hours) AS total_open_hours,
  SUM(off.total_close_hours) AS total_close_hours
FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_offline_hours` AS off
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON off.vendor_code = vi.vendor_code

WHERE off.report_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)

GROUP BY 1,2,3,4,5,6,7
),

offline AS (

  SELECT *
  FROM hourly_offline
  UNION ALL
  SELECT *
  FROM total_offline
),

hourly_shrink AS (
  SELECT 
    date_local,
    &quot;restaurants&quot; AS vertical,
    &quot;Accounts&quot; AS account_type,
      CASE
        WHEN city_name IS NULL THEN &quot;Other&quot;
        ELSE city_name
      END AS city_name,
      CASE
        WHEN zone_name IS NULL THEN &quot;Other&quot;
        ELSE zone_name
      END AS zone_name,
    &quot;OD&quot; AS expedition_type,
            CASE 
        WHEN hourly_bucket IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
        WHEN hourly_bucket IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
        WHEN hourly_bucket IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
        WHEN hourly_bucket IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
        WHEN hourly_bucket IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
        ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
      END AS bucket,
      SUM(forecasted_orders) AS forecasted_orders,
      SUM(shrink_orders) AS shrink_orders,
      SUM(shrink_0_orders) AS shrink_0_orders,
      SUM(shrink_1st_orders) AS shrink_1st_orders,
      SUM(shrink_2nd_orders) AS shrink_2nd_orders,
      SUM(shrink_3rd_orders) AS shrink_3rd_orders,
      SUM(shrink_4th_orders) AS shrink_4th_orders,
      SUM(shrink_5th_orders) AS shrink_5th_orders,
      SUM(shrink_6th_orders) AS shrink_6th_orders,
      SUM(close_orders) AS close_orders
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_weighted_das_events_hourly` 
    WHERE date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
    AND global_entity_id = &quot;FP_PK&quot;
    GROUP BY 1, 2, 3, 4, 5, 6, 7 
  ),

total_shrink AS (
  SELECT 
    date_local,
    &quot;restaurants&quot; AS vertical,
    &quot;Accounts&quot; AS account_type,
    CASE
      WHEN city_name IS NULL THEN &quot;Other&quot;
      ELSE city_name
    END AS city_name,
    CASE
      WHEN zone_name IS NULL THEN &quot;Other&quot;
      ELSE zone_name
    END AS zone_name,
    &quot;OD&quot; AS expedition_type,
    &quot;Total&quot; AS bucket,
    SUM(forecasted_orders) AS forecasted_orders,
    SUM(shrink_orders) AS shrink_orders,
    SUM(shrink_0_orders) AS shrink_0_orders,
    SUM(shrink_1st_orders) AS shrink_1st_orders,
    SUM(shrink_2nd_orders) AS shrink_2nd_orders,
    SUM(shrink_3rd_orders) AS shrink_3rd_orders,
    SUM(shrink_4th_orders) AS shrink_4th_orders,
    SUM(shrink_5th_orders) AS shrink_5th_orders,
    SUM(shrink_6th_orders) AS shrink_6th_orders,
    SUM(close_orders) AS close_orders
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_weighted_das_events_hourly` 
    WHERE date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
    AND global_entity_id = &quot;FP_PK&quot;
    GROUP BY 1, 2, 3, 4, 5, 6, 7
  ),

shrink AS (
  SELECT *
  FROM hourly_shrink 
  UNION ALL
  SELECT * 
  FROM total_shrink
),

hourly_surge AS (
  SELECT
    created_date_local AS date_local,
    &quot;restaurants&quot; AS vertical,
    &quot;Accounts&quot; AS account_type,
    CASE
      WHEN city_name IS NULL THEN &quot;Other&quot;
      ELSE city_name
    END AS city_name,
    CASE
      WHEN zone_name IS NULL THEN &quot;Other&quot;
      ELSE zone_name
    END AS zone_name,
    &quot;OD&quot; AS expedition_type,
          CASE 
        WHEN EXTRACT(HOUR from order_placed_at_local) IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
        WHEN EXTRACT(HOUR from order_placed_at_local) IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
        WHEN EXTRACT(HOUR from order_placed_at_local) IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
        WHEN EXTRACT(HOUR from order_placed_at_local) IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
        WHEN EXTRACT(HOUR from order_placed_at_local) IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
        ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
      END AS bucket,
    COUNT(DISTINCT(CASE WHEN is_surged THEN order_code END)) AS surged_order_experience,
    COUNT(DISTINCT(CASE WHEN is_surged_1 THEN order_code END)) AS surged_1st_order_experience,
    COUNT(DISTINCT(CASE WHEN is_surged_2 THEN order_code END)) AS surged_2nd_order_experience,
    COUNT(CASE WHEN is_surged_3 THEN order_code END) AS surged_3rd_order_experience,
    COUNT(CASE WHEN is_surged_4 THEN order_code END) AS surged_4th_order_experience,
    COUNT(CASE WHEN is_surged_above_4 THEN order_code END) AS surged_above_4_order_experience,
    COUNT(order_code) AS actual_orders,

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_surged_orders_experienced` 
  WHERE created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
    AND lg_zone_id IS NOT NULL
    AND global_entity_id = &quot;FP_PK&quot;
  GROUP BY 1,2,3,4,5,6,7
),

total_surge AS (
  SELECT
    created_date_local AS date_local,
    &quot;restaurants&quot; AS vertical,
    &quot;Accounts&quot; AS account_type,
    CASE
      WHEN city_name IS NULL THEN &quot;Other&quot;
      ELSE city_name
    END AS city_name,
    CASE
      WHEN zone_name IS NULL THEN &quot;Other&quot;
      ELSE zone_name
    END AS zone_name,
    &quot;OD&quot; AS expedition_type,
    &quot;Total&quot; bucket,
    COUNT(CASE WHEN is_surged THEN order_code END) AS surged_order_experience,
    COUNT(CASE WHEN is_surged_1 THEN order_code END) AS surged_1st_order_experience,
    COUNT(CASE WHEN is_surged_2 THEN order_code END) AS surged_2nd_order_experience,
    COUNT(CASE WHEN is_surged_3 THEN order_code END) AS surged_3rd_order_experience,
    COUNT(CASE WHEN is_surged_4 THEN order_code END) AS surged_4th_order_experience,
    COUNT(CASE WHEN is_surged_above_4 THEN order_code END) AS surged_above_4_order_experience,
    COUNT(order_code) AS actual_orders,

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_surged_orders_experienced` 
  WHERE created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH)
    AND lg_zone_id IS NOT NULL
    AND global_entity_id = &quot;FP_PK&quot;
  GROUP BY 1,2,3,4,5,6,7
),

surge AS (
  SELECT *
  FROM hourly_surge
  UNION ALL
  SELECT * 
  FROM total_surge 
),

hourly AS 
(SELECT
EXTRACT(DATE FROM perseus.session_start_timestamp_local) AS date_local,
CASE
WHEN LOWER(location.city) LIKE &quot;%lahore%&quot; OR location.city LIKE &quot;%لاہور%&quot; THEN &quot;Lahore&quot;
WHEN LOWER(location.city) LIKE &quot;%karachi%&quot; OR location.city LIKE &quot;%ڪراچي%&quot; THEN &quot;Karachi&quot;
WHEN LOWER(location.city) LIKE &quot;%islamabad%&quot; OR location.city LIKE &quot;%اسلام آباد%&quot; OR LOWER(location.city) LIKE &quot;%rawalpindi%&quot; OR location.city LIKE &quot;%راولپنڈی%&quot; THEN &quot;Islamabad&quot;
WHEN LOWER(location.city) LIKE &quot;%faisalabad%&quot; OR location.city LIKE &quot;%فیصل آباد%&quot; THEN &quot;Faisalabad&quot;
WHEN LOWER(location.city) LIKE &quot;%multan%&quot; OR location.city LIKE &quot;%مُلتان%&quot; THEN &quot;Multan&quot;
WHEN LOWER(location.city) LIKE &quot;%sialkot%&quot; THEN &quot;Sialkot&quot;
WHEN LOWER(location.city) LIKE &quot;%gujranwala%&quot; THEN &quot;Gujranwala&quot;
WHEN LOWER(location.city) LIKE &quot;%peshawar%&quot; THEN &quot;Peshawar&quot;
WHEN LOWER(location.city) LIKE &quot;%hyderabad%&quot; OR location.city LIKE &quot;%حیدرآباد%&quot; THEN &quot;Hyderabad&quot;
ELSE &quot;Other&quot;
END AS city,
CASE
WHEN LOWER(location.city) LIKE &quot;%lahore%&quot; OR location.city LIKE &quot;%لاہور%&quot; THEN &quot;Johar town south&quot;
WHEN LOWER(location.city) LIKE &quot;%karachi%&quot; OR location.city LIKE &quot;%ڪراچي%&quot; THEN &quot;Dha karachi&quot;
WHEN LOWER(location.city) LIKE &quot;%islamabad%&quot; OR location.city LIKE &quot;%اسلام آباد%&quot; OR LOWER(location.city) LIKE &quot;%rawalpindi%&quot; OR location.city LIKE &quot;%راولپنڈی%&quot; THEN &quot;F7&quot;
WHEN LOWER(location.city) LIKE &quot;%faisalabad%&quot; OR location.city LIKE &quot;%فیصل آباد%&quot; THEN &quot;Faisalabad&quot;
WHEN LOWER(location.city) LIKE &quot;%multan%&quot; OR location.city LIKE &quot;%مُلتان%&quot; THEN &quot;Multan&quot;
WHEN LOWER(location.city) LIKE &quot;%sialkot%&quot; THEN &quot;Sialkot&quot;
WHEN LOWER(location.city) LIKE &quot;%gujranwala%&quot; THEN &quot;Gujranwala&quot;
WHEN LOWER(location.city) LIKE &quot;%peshawar%&quot; THEN &quot;University town&quot;
WHEN LOWER(location.city) LIKE &quot;%hyderabad%&quot; OR location.city LIKE &quot;%حیدرآباد%&quot; THEN &quot;Hyd&quot;
ELSE &quot;Other&quot;
END AS zone,
&quot;restaurants&quot; AS vertical,
&quot;Accounts&quot; AS account_type,
&quot;OD&quot; AS expedition_type,
CASE 
WHEN EXTRACT(HOUR FROM perseus.session_start_timestamp_local) IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
WHEN EXTRACT(HOUR FROM perseus.session_start_timestamp_local) IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
WHEN EXTRACT(HOUR FROM perseus.session_start_timestamp_local) IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
WHEN EXTRACT(HOUR FROM perseus.session_start_timestamp_local) IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
WHEN EXTRACT(HOUR FROM perseus.session_start_timestamp_local) IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
END AS time_of_day,
COUNT(DISTINCT perseus.session_key) AS sessions,
COUNT(DISTINCT IF(perseus.has_order IS TRUE, perseus.session_key, NULL)) AS sessions_with_order

FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_sessions_pandora` AS perseus

WHERE perseus.partition_date &gt;&gt;= &quot;2022-01-01&quot;
AND global_entity_id = &quot;FP_PK&quot;
AND platform NOT IN (&quot;Web&quot;)
AND (EXTRACT(DATE FROM perseus.session_start_timestamp_local)) BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) AND CURRENT_DATE(&quot;Asia/Karachi&quot;) - 1
--AND perseus.funnel != &quot;000000&quot; --removes the spikes of unusual sessions
GROUP BY ALL),

totals AS (

SELECT
EXTRACT(DATE FROM perseus.session_start_timestamp_local) AS date_local,
CASE
WHEN LOWER(location.city) LIKE &quot;%lahore%&quot; OR location.city LIKE &quot;%لاہور%&quot; THEN &quot;Lahore&quot;
WHEN LOWER(location.city) LIKE &quot;%karachi%&quot; OR location.city LIKE &quot;%ڪراچي%&quot; THEN &quot;Karachi&quot;
WHEN LOWER(location.city) LIKE &quot;%islamabad%&quot; OR location.city LIKE &quot;%اسلام آباد%&quot; OR LOWER(location.city) LIKE &quot;%rawalpindi%&quot; OR location.city LIKE &quot;%راولپنڈی%&quot; THEN &quot;Islamabad&quot;
WHEN LOWER(location.city) LIKE &quot;%faisalabad%&quot; OR location.city LIKE &quot;%فیصل آباد%&quot; THEN &quot;Faisalabad&quot;
WHEN LOWER(location.city) LIKE &quot;%multan%&quot; OR location.city LIKE &quot;%مُلتان%&quot; THEN &quot;Multan&quot;
WHEN LOWER(location.city) LIKE &quot;%sialkot%&quot; THEN &quot;Sialkot&quot;
WHEN LOWER(location.city) LIKE &quot;%gujranwala%&quot; THEN &quot;Gujranwala&quot;
WHEN LOWER(location.city) LIKE &quot;%peshawar%&quot; THEN &quot;Peshawar&quot;
WHEN LOWER(location.city) LIKE &quot;%hyderabad%&quot; OR location.city LIKE &quot;%حیدرآباد%&quot; THEN &quot;Hyderabad&quot;
ELSE &quot;Other&quot;
END AS city,
CASE
WHEN LOWER(location.city) LIKE &quot;%lahore%&quot; OR location.city LIKE &quot;%لاہور%&quot; THEN &quot;Johar town south&quot;
WHEN LOWER(location.city) LIKE &quot;%karachi%&quot; OR location.city LIKE &quot;%ڪراچي%&quot; THEN &quot;Dha karachi&quot;
WHEN LOWER(location.city) LIKE &quot;%islamabad%&quot; OR location.city LIKE &quot;%اسلام آباد%&quot; OR LOWER(location.city) LIKE &quot;%rawalpindi%&quot; OR location.city LIKE &quot;%راولپنڈی%&quot; THEN &quot;F7&quot;
WHEN LOWER(location.city) LIKE &quot;%faisalabad%&quot; OR location.city LIKE &quot;%فیصل آباد%&quot; THEN &quot;Faisalabad&quot;
WHEN LOWER(location.city) LIKE &quot;%multan%&quot; OR location.city LIKE &quot;%مُلتان%&quot; THEN &quot;Multan&quot;
WHEN LOWER(location.city) LIKE &quot;%sialkot%&quot; THEN &quot;Sialkot&quot;
WHEN LOWER(location.city) LIKE &quot;%gujranwala%&quot; THEN &quot;Gujranwala&quot;
WHEN LOWER(location.city) LIKE &quot;%peshawar%&quot; THEN &quot;University town&quot;
WHEN LOWER(location.city) LIKE &quot;%hyderabad%&quot; OR location.city LIKE &quot;%حیدرآباد%&quot; THEN &quot;Hyd&quot;
ELSE &quot;Other&quot;
END AS zone,
&quot;restaurants&quot; AS vertical,
&quot;Accounts&quot; AS account_type,
&quot;OD&quot; AS expedition_type,
&quot;Total&quot; AS time_of_day,  
COUNT(DISTINCT perseus.session_key) AS sessions,
COUNT(DISTINCT IF(perseus.has_order IS TRUE, perseus.session_key, NULL)) AS sessions_with_order

FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_sessions_pandora` AS perseus

WHERE perseus.partition_date &gt;&gt;= &quot;2022-01-01&quot;
AND global_entity_id = &quot;FP_PK&quot;
AND platform NOT IN (&quot;Web&quot;)
AND (EXTRACT(DATE FROM perseus.session_start_timestamp_local)) BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) AND CURRENT_DATE(&quot;Asia/Karachi&quot;) - 1
--AND perseus.funnel != &quot;000000&quot; --removes the spikes of unusual sessions
GROUP BY ALL
),

sess AS (
SELECT *
FROM hourly
UNION ALL
SELECT *
FROM totals)

SELECT 
orders.global_entity_id,
orders.created_date_local,
orders.vertical,
orders.account_type,
orders.city_name,
orders.zone_name,
orders.expedition_type,
orders.bucket,
orders.gross_orders,
orders.valid_orders,
orders.active_order_inventory,
orders.ven_failed_orders,
orders.cus_failed_orders,
orders.log_failed_orders,
orders.discounted_orders,
orders.delivery_time,
orders.distance,
orders.od_valid_orders,
shrink.forecasted_orders,
shrink.shrink_0_orders,
shrink.shrink_1st_orders,
shrink.shrink_2nd_orders,
shrink.shrink_3rd_orders,
shrink.shrink_4th_orders,
shrink.shrink_5th_orders,
shrink.shrink_6th_orders,
surge.surged_order_experience,
surge.surged_1st_order_experience,
surge.surged_2nd_order_experience,
surge.surged_3rd_order_experience,
surge.surged_4th_order_experience,
surge.surged_above_4_order_experience,
surge.actual_orders,

offline.total_open_hours,
offline.total_close_hours,

NULL AS sessions,
NULL sessions_with_order

FROM orders
LEFT JOIN shrink 
ON orders.created_date_local = shrink.date_local
AND orders.vertical = shrink.vertical
AND orders.city_name = shrink.city_name
AND orders.zone_name = shrink.zone_name
AND orders.expedition_type = shrink.expedition_type
AND orders.bucket = shrink.bucket
AND orders.account_type = shrink.account_type
LEFT JOIN surge
ON orders.created_date_local = surge.date_local
AND orders.vertical = surge.vertical
AND orders.city_name = surge.city_name
AND orders.zone_name = surge.zone_name
AND orders.expedition_type = surge.expedition_type
AND orders.bucket = surge.bucket
AND orders.account_type = surge.account_type
LEFT JOIN offline 
ON orders.created_date_local = offline.report_date
AND orders.vertical = offline.vertical
AND orders.city_name = offline.city_name
AND orders.zone_name = offline.zone_name
AND orders.expedition_type = offline.expedition_type
AND orders.bucket = offline.bucket
AND orders.account_type = offline.account_type

UNION DISTINCT

SELECT 
&quot;FP_PK&quot; AS global_entity_id,
date_local AS created_date_local,
vertical,
account_type,
city AS city_name,
zone AS zone_name,
expedition_type,
time_of_day AS bucket,
NULL AS gross_orders,
NULL AS valid_orders,
NULL AS active_order_inventory,
NULL AS ven_failed_orders,
NULL AS cus_failed_orders,
NULL AS log_failed_orders,
NULL AS discounted_orders,
NULL AS delivery_time,
NULL AS distance,
NULL AS od_valid_orders,
NULL AS forecasted_orders,
NULL AS shrink_0_orders,
NULL AS shrink_1st_orders,
NULL AS shrink_2nd_orders,
NULL AS shrink_3rd_orders,
NULL AS shrink_4th_orders,
NULL AS shrink_5th_orders,
NULL AS shrink_6th_orders,
NULL AS surged_order_experience,
NULL AS surged_1st_order_experience,
NULL AS surged_2nd_order_experience,
NULL AS surged_3rd_order_experience,
NULL AS surged_4th_order_experience,
NULL AS surged_above_4_order_experience,
NULL AS actual_orders,

NULL AS total_open_hours,
NULL AS total_close_hours,

sessions,
sessions_with_order

FROM sess</relation>
            </properties>
            <properties context='extract'>
              <relation name='_6E5518E178654E6499B855DDB809998E' table='[Extract].[_6E5518E178654E6499B855DDB809998E]' type='table' />
            </properties>
          </object>
          <object caption='Custom SQL Query4' id='_F602D383A1FB471A9A1108D5422D249E'>
            <properties context=''>
              <relation connection='bigquery.1fu7tg31jklrgb13cj5wm0pic1uy' name='Custom SQL Query4' type='text'>WITH hourly AS (SELECT 
  DATE_TRUNC(vendor_offline.report_date, MONTH) AS MONTH,
  vendor_offline.report_date,
    CASE
      WHEN vendor_info.lg_city IS NULL THEN &quot;Other&quot;
      ELSE vendor_info.lg_city
    END AS lg_city,
    CASE
      WHEN vendor_info.lg_zone_name IS NULL THEN &quot;Other&quot;
      ELSE vendor_info.lg_zone_name
    END AS lg_zone_name,
    vendor_info.vertical,
    vendor_info.account_type,
   &quot;OD&quot; AS expedition_type,
                       CASE 
        WHEN hour_of IN (8,9,10,11) THEN &quot;C - Breakfast (8AM - 12PM)&quot;
        WHEN hour_of IN (12,13,14,15) THEN &quot;D - Lunch (12PM - 4PM)&quot;
        WHEN hour_of IN (16,17,18) THEN &quot;E - Snack (4PM - 7PM)&quot;
        WHEN hour_of IN (19,20,21,22,23) THEN &quot;F - Dinner (7PM - 12AM)&quot;
        WHEN hour_of IN (0,1,2,3,4) THEN &quot;A - Midnight (12AM - 5AM)&quot;
        ELSE &quot;B - Early Morning (5AM - 8AM)&quot; 
      END AS bucket,

  SUM(COALESCE(vendor_offline.total_open_time, 0)) / 60 AS open_hours,
  SUM(COALESCE(vendor_offline.total_close_time, 0)) / 60 AS close_hours,
  COUNT(DISTINCT CASE WHEN vendor_offline.total_open_time &gt;&gt; 0 THEN vendor_offline.vendor_code END) AS operating_vendors,
  ((SUM(COALESCE(vendor_offline.total_open_time, 0)) - SUM(COALESCE(vendor_offline.total_close_time, 0))) / 60)/
  COUNT(DISTINCT vendor_offline.vendor_code) AS ops_hours

FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_hourly_offline_hours` AS vendor_offline
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
      ON vendor_offline.vendor_code = vendor_info.vendor_code 
LEFT JOIN `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS vendor_status
      ON vendor_offline.report_date = vendor_status.report_date 
      AND vendor_offline.vendor_code = vendor_status.vendor_code 
WHERE 
  vendor_offline.report_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) 
  AND vendor_status.is_active
  AND NOT vendor_status.is_private
  AND NOT vendor_status.is_test
  AND vendor_status.global_entity_id = &quot;FP_PK&quot;

GROUP BY 
  1,2,3,4,5,6,7,8
),

total AS (

SELECT
  DATE_TRUNC(vendor_offline.report_date, MONTH) AS MONTH,
  vendor_offline.report_date,
    CASE
      WHEN vendor_info.lg_city IS NULL THEN &quot;Other&quot;
      ELSE vendor_info.lg_city
    END AS lg_city,
    CASE
      WHEN vendor_info.lg_zone_name IS NULL THEN &quot;Other&quot;
      ELSE vendor_info.lg_zone_name
    END AS lg_zone_name,
vendor_info.vertical,
 vendor_info.account_type,
   &quot;OD&quot; AS expedition_type,
  &quot;Total&quot; AS bucket,
  SUM(COALESCE(vendor_offline.total_open_time, 0)) / 60 AS open_hours,
  SUM(COALESCE(vendor_offline.total_close_time, 0)) / 60 AS close_hours,
  COUNT(DISTINCT vendor_offline.vendor_code) AS operating_vendors,
  ((SUM(COALESCE(vendor_offline.total_open_time, 0)) - SUM(COALESCE(vendor_offline.total_close_time, 0))) / 60)/
  COUNT(DISTINCT vendor_offline.vendor_code) AS ops_hours

FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_hourly_offline_hours` AS vendor_offline
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
      ON vendor_offline.vendor_code = vendor_info.vendor_code 
LEFT JOIN `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS vendor_status
      ON vendor_offline.report_date = vendor_status.report_date 
      AND vendor_offline.vendor_code = vendor_status.vendor_code 
WHERE 
  vendor_offline.report_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 3 MONTH) 
  AND vendor_status.is_active
  AND NOT vendor_status.is_private
  AND NOT vendor_status.is_test
  AND vendor_status.global_entity_id = &quot;FP_PK&quot;

GROUP BY 
  1,2,3,4,5,6,7,8
)
SELECT *
FROM hourly
UNION ALL
SELECT * 
FROM total</relation>
