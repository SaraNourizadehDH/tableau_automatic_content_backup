            <member value='#2024-01-01#' />
          </members>
        </column>
        <column caption='KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
          <calculation class='tableau' formula='&quot;Orders&quot;' />
          <members>
            <member value='&quot;Orders&quot;' />
            <member value='&quot;GMV (user paid)&quot;' />
            <member value='&quot;Vendors&quot;' />
          </members>
        </column>
        <column caption='Visual Parameter' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Type&quot;'>
          <calculation class='tableau' formula='&quot;Vendor Type&quot;' />
          <members>
            <member value='&quot;New Vendors&quot;' />
            <member value='&quot;GMV Class&quot;' />
            <member value='&quot;Target Partner&quot;' />
            <member value='&quot;Vendor Type&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.16hd64v1lc7bh215qcfar19w3isq'>
        <column caption='New Vendor' datatype='string' name='[Calculation_874261320516534272]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [report_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [sign_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [t3_gap] = TRUE&#13;&#10;     THEN &quot;New Vendor Gap&quot;&#13;&#10;ELSEIF [report_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [sign_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [t3_gap] = FALSE&#13;&#10;     THEN &quot;New Vendor Non-Gap&quot;&#13;&#10;ELSE &quot;Incumbent Vendor&quot;&#13;&#10;END' />
        </column>
