      <table>
        <view>
          <datasources>
            <datasource caption='sales_signs (report_tables)' name='federated.04bolre01ar6ol1e35smh08rnf46' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Slice Parameter' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Opportunity Outcome&quot;'>
              <calculation class='tableau' formula='&quot;Opportunity Outcome&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04bolre01ar6ol1e35smh08rnf46'>
            <column caption='Number of Signs' datatype='integer' name='[Calculation_1399775098227765249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_vendor_id])' />
            </column>
            <column caption='Parameter' datatype='string' name='[Calculation_1399775098229854210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;City Tier&quot; THEN [city_tier]&#13;&#10;    WHEN &quot;Delivery Type&quot; THEN [delivery_type]&#13;&#10;    WHEN &quot;Target Partner&quot; THEN [target_partner]&#13;&#10;    WHEN &quot;Vendor Grade&quot; THEN [vendor_grade]&#13;&#10;    WHEN &quot;Opportunity Outcome&quot; THEN [opportunity_resolution]&#13;&#10;    WHEN &quot;Stage Before Lost&quot; THEN [stage_name_before_lost]&#13;&#10;    WHEN &quot;Lost Reason&quot; THEN [lost_reason]&#13;&#10;END' />
            </column>
