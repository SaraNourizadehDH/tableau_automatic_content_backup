      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/Sales/OrderDevelopment?rev=' id='OrderDevelopment' path='/t/Foodora/workbooks/Sales' revision='' site='Foodora' />
      <style />
      <size maxheight='3300' maxwidth='2000' minheight='3300' minwidth='2000' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='vendor_monthly_kpis (report_tables)' name='federated.16hd64v1lc7bh215qcfar19w3isq' />
