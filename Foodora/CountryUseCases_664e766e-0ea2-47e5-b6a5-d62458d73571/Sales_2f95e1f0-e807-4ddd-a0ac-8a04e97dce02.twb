      <aliases enabled='yes' />
      <column caption='% ZOR Vendor - New' datatype='real' name='[% ZOR Vendor (copy)_837388098969550850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ZOR Vendor (copy)_837388098945765377]/[Active Vendor (copy)_837388098945323008]' />
      </column>
      <column caption='Active Vendor - New' datatype='integer' name='[Active Vendor (copy)_837388098945323008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_874261320516534272] != &quot;Incumbent Vendor&quot; THEN [vendor_code] END)' />
      </column>
      <column caption='Order Buckets' datatype='string' name='[Calculation_1333909964668071937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [successful_orders]=0 THEN &quot;0&quot;&#13;&#10;ELSEIF  [successful_orders]&gt;0 AND [successful_orders] &lt;=30 THEN &quot;0-30&quot;&#13;&#10;ELSEIF  [successful_orders]&gt;30 AND [successful_orders] &lt;=100 THEN &quot;30-100&quot;&#13;&#10;ELSEIF  [successful_orders]&gt;100 AND [successful_orders] &lt;=200 THEN &quot;100-200&quot;&#13;&#10;ELSE &quot;&gt;200&quot;&#13;&#10;END' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_551409524462133248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &quot;Orders&quot; THEN [successful_orders]&#13;&#10;    WHEN &quot;GMV (user paid)&quot; THEN [gmv_user_paid]&#13;&#10;END' />
      </column>
      <column caption='% Offline Time' datatype='real' name='[Calculation_719168612291100673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unavailable_hours])/SUM([scheduled_hours])' />
      </column>
      <column caption='Visual Parameter' datatype='string' name='[Calculation_719168612305133571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;    WHEN &quot;New Vendors&quot; THEN [Calculation_874261320516534272]&#13;&#10;    WHEN &quot;GMV Class&quot; THEN [gmv_class]&#13;&#10;    WHEN &quot;Target Partner&quot; THEN [target_partner]&#13;&#10;    WHEN &quot;Vendor Type&quot; THEN [vendor_type]&#13;&#10;END' />
      </column>
      <column caption='New Vendor' datatype='string' name='[Calculation_874261320516534272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [sign_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [t3_gap] = TRUE&#13;&#10;     THEN &quot;New Vendor Gap&quot;&#13;&#10;ELSEIF [report_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [sign_month]&gt;=[Parameters].[Parameter 3] &#13;&#10;    AND [t3_gap] = FALSE&#13;&#10;     THEN &quot;New Vendor Non-Gap&quot;&#13;&#10;ELSE &quot;Incumbent Vendor&quot;&#13;&#10;END' />
      </column>
      <column caption='Active Vendor' datatype='integer' name='[Calculation_874261320518365185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='is_zor' datatype='boolean' name='[Calculation_874261320543731715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [successful_orders] = 0 THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='ZOR Vendor' datatype='integer' name='[Calculation_874261320545366021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_874261320543731715] THEN [vendor_code] END)' />
      </column>
      <column caption='% ZOR Vendor' datatype='real' name='[Calculation_874261320546258950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_874261320545366021]/[Calculation_874261320518365185]' />
      </column>
      <column caption='ZOR Vendor - New' datatype='integer' name='[ZOR Vendor (copy)_837388098945765377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_874261320543731715] AND [Calculation_874261320516534272] != &quot;Incumbent Vendor&quot; THEN [vendor_code] END)' />
      </column>
