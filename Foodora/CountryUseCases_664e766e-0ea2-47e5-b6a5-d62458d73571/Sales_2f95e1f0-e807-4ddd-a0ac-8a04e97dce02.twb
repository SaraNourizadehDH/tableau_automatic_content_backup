        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0tdflrd1xn9avd16fwmje05ess8d' name='Custom SQL Query' type='text'>SELECT&#13;
  t3_cluster,&#13;
  DATE_TRUNC(created_date_local, MONTH) AS report_month,&#13;
  COUNT(DISTINCT central_analytical_customer_id) AS customer,&#13;
  COUNT(DISTINCT order_code) AS orders&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` o&#13;
LEFT JOIN&#13;
  `dha---bi-485.prod_tables.vendor_info` v&#13;
ON&#13;
  v.vendor_code=o.vendor_code&#13;
WHERE&#13;
  created_date_utc &gt;&gt;= &quot;2022-01-01&quot;&#13;
  AND o.global_entity_id = &quot;MJM_AT&quot;&#13;
  AND is_valid_order&#13;
  AND t3_cluster IS NOT NULL&#13;
GROUP BY ALL&#13;
ORDER BY &#13;
  1,2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
