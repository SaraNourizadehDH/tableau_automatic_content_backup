      <datasource-dependencies datasource='Parameters'>
        <column caption='Sign Month' datatype='date' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2023-08-01#'>
          <calculation class='tableau' formula='#2023-08-01#' />
          <members>
            <member value='#2023-01-01#' />
            <member value='#2023-02-01#' />
            <member value='#2023-03-01#' />
            <member value='#2023-04-01#' />
            <member value='#2023-05-01#' />
