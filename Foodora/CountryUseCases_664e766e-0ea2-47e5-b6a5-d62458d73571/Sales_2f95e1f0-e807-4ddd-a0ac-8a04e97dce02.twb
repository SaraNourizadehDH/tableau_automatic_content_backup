      <aliases enabled='yes' />
      <column caption='Total NCR Revenue' datatype='real' name='[Calculation_1232016012828082176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hardware_fee])+SUM([setup_fee])+SUM([software_fee])' />
      </column>
      <column caption='Number of Signs' datatype='integer' name='[Calculation_1399775098227765249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([global_vendor_id])' />
      </column>
      <column caption='Parameter' datatype='string' name='[Calculation_1399775098229854210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;City Tier&quot; THEN [city_tier]&#13;&#10;    WHEN &quot;Delivery Type&quot; THEN [delivery_type]&#13;&#10;    WHEN &quot;Target Partner&quot; THEN [target_partner]&#13;&#10;    WHEN &quot;Vendor Grade&quot; THEN [vendor_grade]&#13;&#10;    WHEN &quot;Opportunity Outcome&quot; THEN [opportunity_resolution]&#13;&#10;    WHEN &quot;Stage Before Lost&quot; THEN [stage_name_before_lost]&#13;&#10;    WHEN &quot;Lost Reason&quot; THEN [lost_reason]&#13;&#10;END' />
      </column>
      <column caption='Time Frame' datatype='date' name='[Calculation_1538260787781918720]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Weekly&quot; THEN [sign_week]&#13;&#10;    WHEN &quot;Monthly&quot; THEN [sign_month]&#13;&#10;END' />
      </column>
      <column caption='is_onboarded' datatype='boolean' name='[Calculation_351843729391157248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stage_name] = &quot;Closed Won&quot; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='hardware_fee_after_onboarding' datatype='real' name='[Calculation_475129799298813955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([onboarding_date]) THEN [hardware_fee] END' />
      </column>
      <column caption='Total NCR after onboarding' datatype='real' name='[Calculation_475129799299067908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_475129799298813955])+SUM([hardware_fee_after_onboarding (copy)_475129799299334150])+SUM([hardware_fee_after_onboarding (copy)_475129799299170309])' />
      </column>
