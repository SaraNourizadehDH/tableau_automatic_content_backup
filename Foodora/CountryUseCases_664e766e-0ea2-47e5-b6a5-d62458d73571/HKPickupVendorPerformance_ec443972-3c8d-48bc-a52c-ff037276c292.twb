              <calculation class='tableau' formula='IF LEN([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912]) - LEN(REPLACE([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&apos;,&apos;,&apos;&apos;)) = 2&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&quot;,&quot;,3)),TRUE,FALSE)&#10;&#10;ELSEIF  LEN([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912]) - LEN(REPLACE([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&apos;,&apos;,&apos;&apos;)) = 0&#10; THEN IIF(CONTAINS([incentive_agg],[Parameters].[Para_campaigns_benmark (copy)_3139149709026426912]),TRUE,FALSE)&#10;&#10;ELSEIF LEN([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912]) - LEN(REPLACE([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&apos;,&apos;,&apos;&apos;)) = 1&#10; THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&quot;,&quot;,2)),TRUE,FALSE)&#10;&#10;&#10;ELSEIF LEN([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912]) - LEN(REPLACE([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&apos;,&apos;,&apos;&apos;)) = 4&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_3139149709026426912],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Para_campaigns_benmark (copy)_31391497090