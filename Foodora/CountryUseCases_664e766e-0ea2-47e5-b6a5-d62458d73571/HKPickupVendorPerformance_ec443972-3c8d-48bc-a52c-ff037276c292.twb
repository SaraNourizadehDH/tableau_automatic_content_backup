    <worksheet name='1.campaigns_comparison_v2 (OD+pickuponly)'>
      <table>
        <view>
          <datasources>
            <datasource caption='pickup_das_first_pickup_cus_2t' name='federated.0oqfjom0weffnk10fli7w0lum4nh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Para_campaigns_comparison (max. 8 ID)' datatype='string' name='[Para_campaigns_benmark (copy)_3139149709026426912]' param-domain-type='any' role='measure' type='nominal' value='&quot;_486186_,_486982_&quot;'>
              <calculation class='tableau' formula='&quot;_486186_,_486982_&quot;' />
            </column>
            <column caption='Para_metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customers&quot;'>
              <calculation class='tableau' formula='&quot;Customers&quot;' />
            </column>
            <column caption='Para_campaigns_benmark (max. 8 ID)' datatype='string' name='[Parameter 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;_486981_,自取禮劵包&quot;'>
              <calculation class='tableau' formula='&quot;_486981_,自取禮劵包&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0oqfjom0weffnk10fli7w0lum4nh'>
            <column caption='ZF_metric_value_diff' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3139149709230907435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Orders&apos; THEN sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [orders_p], NULL)) - sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [orders_p], NULL))&#10;    WHEN &apos;FLGP&apos; THEN sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [flgp_p], NULL)) - sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [flgp_p], NULL))&#10;    WHEN &apos;GMV&apos; THEN sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [gmv_p], NULL)) - sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [gmv_p], NULL))&#10;    WHEN &apos;AFV&apos; THEN &#10; (sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [gfv_p], NULL))/sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [orders_p], NULL)))&#10; - (sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [gfv_p], NULL))/sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [orders_p], NULL)))&#10;    WHEN &apos;Customers&apos; THEN sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos; AND cus_num_phases = 1, [customers_p], NULL)) - sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos; AND cus_num_phases = 1, [customers_p], NULL))&#10;    &#10;WHEN &apos;FLGPU&apos; THEN sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [flgp_p], NULL))/sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos; AND cus_num_phases = 1, [customers_p], NULL))&#10;                      - sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [flgp_p], NULL))/sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos; AND cus_num_phases = 1, [customers_p], NULL))&#10;&#10;WHEN &apos;FLGPO&apos; THEN sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [flgp_p], NULL))/sum (IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170] AND [table] = &apos;t2&apos;, [orders_p], NULL))&#10;                      - sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [flgp_p], NULL))/sum (IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897] AND [table] = &apos;t1&apos;, [orders_p], NULL))&#10;&#10;&#10;END' />
            </column>
            <column caption='ZF_is_campaign_total' datatype='boolean' name='[Calculation_3139149709231898668]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([ZF_is_campaign_benchmark (copy)_3139149709038329897],TRUE,IIF([ZF_is_campaign_benchmark_v2 (copy)_3139149709229744170],TRUE,FALSE))' />
            </column>
            <column caption='ZF_is_campaign_benchmark_v2' datatype='boolean' name='[ZF_is_campaign_benchmark (copy)_3139149709038329897]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 2&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,3)),TRUE,FALSE)&#10;&#10;ELSEIF  LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 0&#10; THEN IIF(CONTAINS([incentive_agg],[Parameters].[Parameter 3]),TRUE,FALSE)&#10;&#10;ELSEIF LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 1&#10; THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,2)),TRUE,FALSE)&#10;&#10;&#10;ELSEIF LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 4&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,4))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,5))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,3)),TRUE,FALSE)&#10;&#10;&#10;ELSEIF LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 3&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,3))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,4)),TRUE,FALSE)&#10;&#10;&#10;ELSEIF LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 5&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,3))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,4))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,6))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,5)),TRUE,FALSE)&#10;&#10;&#10;ELSEIF LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 6&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,3))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,4))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,6))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,7))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,5)),TRUE,FALSE)&#10;&#10;ELSEIF LEN([Parameters].[Parameter 3]) - LEN(REPLACE([Parameters].[Parameter 3],&apos;,&apos;,&apos;&apos;)) = 7&#10;THEN IIF(CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,1)) &#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,2))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,3))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,4))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,6))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,7))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,8))&#10;            OR CONTAINS([incentive_agg],SPLIT([Parameters].[Parameter 3],&quot;,&quot;,5)),TRUE,FALSE)&#10;&#10;END' />
            </column>
