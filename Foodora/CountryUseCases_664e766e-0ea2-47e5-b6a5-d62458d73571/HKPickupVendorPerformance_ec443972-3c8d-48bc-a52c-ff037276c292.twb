      <column caption='ZCF_vendor_cnt_pickup' datatype='integer' name='[Calculation_52635874055864320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([is_pickup_accepted],[backend_vendor_code],NULL))' />
      </column>
      <column caption='ZCF_avg_orders_per_vendor_30d' datatype='real' name='[ZCF_orders_cnt_pickup (copy)_52635874063376391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IIF([is_pickup_accepted],[vendor_orders_pickup],NULL))/COUNTD(IIF([is_pickup_accepted],[backend_vendor_code],NULL)))/3' />
      </column>
      <column caption='ZCF_vendor_cnt_pickup_percent' datatype='real' default-format='p0%' name='[ZCF_vendor_cnt_pickup (copy)_52635874056560642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([is_pickup_accepted],[backend_vendor_code],NULL))/COUNTD([backend_vendor_code])' />
      </column>
      <column caption='ZCF_orders_cnt_pickup' datatype='integer' name='[ZCF_vendor_cnt_pickup (copy)_52635874058043395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_pickup_accepted],[vendor_orders_pickup],NULL))' />
      </column>
      <column caption='ZCF_orders_cnt_pickup_percent' datatype='real' default-format='p0%' name='[ZCF_vendor_cnt_pickup_percent (copy)_52635874058231812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_pickup_accepted],[vendor_orders_pickup],NULL))/SUM([vendor_orders])' />
      </column>
      <column caption='ZCF_vendor_cnt_activel90d_pickup_percent' datatype='real' default-format='p0%' name='[ZCF_vendor_cnt_pickup_percent (copy)_52635874059403270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([vendor_orders_pickup] &gt;=1 ,[backend_vendor_code],NULL))/COUNTD(IIF([is_pickup_accepted],[backend_vendor_code],NULL))' />
      </column>
