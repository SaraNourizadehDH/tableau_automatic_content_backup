      <column caption='ZCF_vendor_num' datatype='integer' name='[Calculation_2386415257263173632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='ZCF_pickup_vendor_percent' datatype='real' name='[Calculation_2386415257427050502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([is_pickup_accepted],[vendor_code],NULL))/MAX([month_total_vendor])' />
      </column>
      <column caption='ZCF_second_last_month_true' datatype='boolean' name='[Calculation_5612892520564690950]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(DATETRUNC(&apos;month&apos;, [month]) = DATEADD(&apos;month&apos;, -1,{MAX([month])}),true,false)' />
      </column>
      <column caption='ZCF_pickup_vendor_penetration' datatype='real' default-format='p0%' name='[Calculation_6722889122431234049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])/max([month_total_vendor_owner_department])' />
      </column>
      <column caption='ZCF_vendor_num_pickup' datatype='integer' name='[Calculation_6722889122663342084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([is_pickup_accepted],[vendor_code],NULL))' />
      </column>
      <column caption='ZCF_pickup_vendor_penetration_total' datatype='real' default-format='p0%' name='[Calculation_6722889122664808454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max([month_pickup_vendor])/max([month_total_vendor])' />
      </column>
      <column caption='ZCF_exclude_max_month_true' datatype='boolean' name='[ZCF_second_last_month_true (copy)_5612892520577691656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(DATETRUNC(&apos;month&apos;, [month]) &lt;= DATEADD(&apos;month&apos;, -1,{MAX([month])}),true,false)' />
      </column>
      <column caption='ZCF_vendor_num_delivery_only' datatype='integer' name='[ZCF_vendor_num_pickup (copy)_2750291997832478720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_delivery_accepted] AND NOT [is_pickup_accepted] THEN [vendor_code] ELSE NULL END)&#10;+&#10;COUNTD(IF [is_delivery_accepted] AND ISNULL([is_pickup_accepted]) THEN [vendor_code] ELSE NULL END)' />
