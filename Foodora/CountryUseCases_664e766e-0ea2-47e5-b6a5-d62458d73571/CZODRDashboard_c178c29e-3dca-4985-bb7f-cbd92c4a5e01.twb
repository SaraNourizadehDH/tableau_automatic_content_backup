            <column caption='Total Rider Payment' datatype='real' default-format='C1029%' name='[Calculation_1395271485130723337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-sum([total_rider_payment])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_2277977051695304707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([# delivered orders (copy)_2277977051694403586] - [Calculation_1395271485122396162]) / [# delivered orders (copy)_2277977051694403586]' />
            </column>
            <column caption='% Delayed' datatype='real' default-format='p0.00%' name='[Calculation_2277977051696144390]' role='measure' type='quantitative'>
