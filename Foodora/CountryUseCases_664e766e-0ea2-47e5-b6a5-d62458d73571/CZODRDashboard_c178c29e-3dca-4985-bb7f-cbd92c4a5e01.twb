      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='odr_orders+ (tableau_outputs)' name='federated.1wqqzdv0dtuhoh11mge9q1g9t524' />
          </datasources>
          <datasource-dependencies datasource='federated.1wqqzdv0dtuhoh11mge9q1g9t524'>
            <column caption='AVG Distance Payment' datatype='real' default-format='C1029%' name='[AVG Rider Payment (copy)_1395271485142511629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-AVG([distance_payment])' />
            </column>
            <column caption='Total Rider Payment' datatype='real' default-format='C1029%' name='[Calculation_1395271485130723337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-sum([total_rider_payment])' />
            </column>
            <column caption='AVG Rider Payment' datatype='real' default-format='C1029%' name='[Total Rider Payment (copy)_1395271485130891274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-AVG([total_rider_payment])' />
            </column>
