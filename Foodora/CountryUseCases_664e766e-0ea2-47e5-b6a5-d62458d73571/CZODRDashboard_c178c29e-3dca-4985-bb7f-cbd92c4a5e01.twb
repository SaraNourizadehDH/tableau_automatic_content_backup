            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_eu' server-oauth='server-custom' username='jakub.rajnis@foodora.cz' workgroup-auth-mode='prompt' />
