        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.06g8xhe0tfy38h1c67yve03lpjrv' name='Custom SQL Query' type='text'>select &#13;
  o.order_id,&#13;
  o.platform_order_code,&#13;
  de.id as delivery_id,&#13;
  datetime(de.created_at, &quot;Europe/Prague&quot;) as created_at,&#13;
  de.is_primary,&#13;
  de.is_returning,&#13;
  de.is_redelivery,&#13;
  de.rider_id,&#13;
  de.delivery_reason,&#13;
  de.delivery_status&#13;
from `fulfillment-dwh-production.curated_data_shared.orders` o &#13;
join unnest(deliveries) de&#13;
where o.created_date &gt;&gt;= &apos;2024-01-01&apos;&#13;
and o.country_code = &apos;cz&apos;&#13;
and o.entity.id = &apos;ODR_CZ&apos;&#13;
and de.rider_id is not null&#13;
order by 4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.06g8xhe0tfy38h1c67yve03lpjrv' name='Custom SQL Query1' type='text'>select&#13;
  odr.uuid,&#13;
  odr.id,&#13;
  odr.global_entity_id,&#13;
  odr.created_at_local,&#13;
  odr.odr_vendor_id,&#13;
  odr.delivery_fee_local,&#13;
  odr.order.amount_local,&#13;
  odr.order.description,&#13;
  odr.order.payment_method,&#13;
  odr.order_origin,&#13;
  odr.status,&#13;
  odr.reason,&#13;
  odr.cancellation_source,&#13;
  odr.customer.location.latitude,&#13;
  odr.customer.location.longitude,&#13;
  datetime(timestamp(odr.logistics.estimated_delivery_time), &quot;Europe/Prague&quot;) as estimated_delivery_time,&#13;
  datetime(timestamp(odr.logistics.estimated_pickup_time), &quot;Europe/Prague&quot;) as estimated_pickup_time,&#13;
  odr.is_test_vendor,&#13;
  lo.is_preorder,&#13;
  lo.rider_dispatched_at_local as rider_dispatched_at,&#13;
  lo.rider_near_restaurant_at_local as rider_near_restaurant_at,&#13;
  lo.rider_picked_up_at_local as rider_picked_up_at,&#13;
  lo.rider_near_customer_at_local as rider_near_customer_at,&#13;
  lo.rider_dropped_off_at_local as rider_dropped_off_at,&#13;
  lo.hold_back_time_in_minutes as dispatch_time,&#13;
  lo.to_vendor_time_in_minutes as to_restaurant,&#13;
  lo.at_vendor_time_in_minutes as at_restaurant,&#13;
  lo.to_customer_time_in_minutes as to_customer,&#13;
  lo.at_customer_time_in_minutes as to_dropoff,&#13;
  lo.vendor_late_in_minutes as vendor_late,&#13;
  lo.rider_late_in_minutes  as rider_late,&#13;
  lo.delivery_distance_in_meters as delivery_distance,&#13;
  lo.order_delay_in_minutes as delay_customer,&#13;
  lo.actual_delivery_time_in_minutes as total_time,&#13;
  lo.promised_delivery_time_in_minutes as estimated_delivery_time_minutes,&#13;
  lo.city_id,&#13;
  lo.city_name,&#13;
  lo.zone_name,&#13;
  de.rdds.pickup_distance_google_in_meters as pickup_distance_google,&#13;
  de.rdds.dropoff_distance_google_in_meters as dropoff_distance_google&#13;
from `fulfillment-dwh-production.pandata_curated.odr_orders` odr &#13;
join `fulfillment-dwh-production.pandata_datamart.pandora__order_logistics` lo &#13;
  ON odr.id = lo.order_code&#13;
  --AND odr.global_entity_id&#13;
  AND lo.lg_country_code in (&apos;cz&apos;, &apos;hu&apos;, &apos;at&apos;, &apos;se&apos;, &apos;fi&apos;, &apos;no&apos;)&#13;
  AND lo.created_date_local &gt;&gt;= date_sub(date_trunc(current_date, month), interval 13 month)&#13;
LEFT JOIN UNNEST(lo.deliveries) de ON de.is_primary_delivery&#13;
where odr.created_date_utc &gt;&gt;= date_sub(date_trunc(current_date, month), interval 13 month)&#13;
AND odr.global_entity_id in (&apos;DJ_CZ&apos;, &apos;NP_HU&apos;, &apos;MJM_AT&apos;, &apos;OP_SE&apos;, &apos;PO_FI&apos;, &apos;FO_NO&apos;)</relation>
          <relation connection='bigquery.06g8xhe0tfy38h1c67yve03lpjrv' name='Custom SQL Query' type='text'>select &#13;
  o.order_id,&#13;
  o.platform_order_code,&#13;
  de.id as delivery_id,&#13;
  datetime(de.created_at, &quot;Europe/Prague&quot;) as created_at,&#13;
  de.is_primary,&#13;
  de.is_returning,&#13;
  de.is_redelivery,&#13;
  de.rider_id,&#13;
  de.delivery_reason,&#13;
  de.delivery_status&#13;
from `fulfillment-dwh-production.curated_data_shared.orders` o &#13;
join unnest(deliveries) de&#13;
where o.created_date &gt;&gt;= &apos;2024-01-01&apos;&#13;
and o.country_code = &apos;cz&apos;&#13;
and o.entity.id = &apos;ODR_CZ&apos;&#13;
and de.rider_id is not null&#13;
order by 4</relation>
          <relation connection='bigquery.06g8xhe0tfy38h1c67yve03lpjrv' name='Custom SQL Query2' type='text'><![CDATA[SELECT DISTINCT
  uuid 
  ,id 
  ,global_entity_id 
  ,vendor_information.is_test 
  ,vendor_information.vertical_type 
  ,vendor_information.business_type 
  ,vendor_information.name 
  ,vendor_information.location.city 
  ,vendor_information.location.street 
  ,vendor_information.location.address_text 
  ,vendor_information.location.latitude 
  ,vendor_information.location.longitude 
  ,vendor_fee_local 
  ,created_at_local 
  ,is_registered 
  ,is_active 
FROM `fulfillment-dwh-production.pandata_curated.odr_vendors`
WHERE translate(id , '1234567890', '') <<>> ''
AND global_entity_id in ('DJ_CZ', 'NP_HU', 'MJM_AT', 'OP_SE', 'OP_FI', 'FO_NO')]]></relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
