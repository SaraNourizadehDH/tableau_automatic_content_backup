          <datasource-dependencies datasource='federated.1wqqzdv0dtuhoh11mge9q1g9t524'>
            <column caption='# delayed orders &gt; 10' datatype='integer' name='[# delayed orders (copy)_2277977051695976453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [status] = &quot;DELIVERED&quot; and [delay_customer] &gt; 10 then [id] END)' />
            </column>
            <column caption='AVG DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# delayed orders (copy)_2277977051696496648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; and [total_time] &gt; 0 then [total_time] END)' />
            </column>
            <column caption='# submitted orders' datatype='integer' name='[# delivered orders (copy)_2277977051694403586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([id])' />
            </column>
            <column caption='# delayed orders' datatype='integer' name='[# delivered orders (copy)_2277977051695636484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [status] = &quot;DELIVERED&quot; and [delay_customer] &gt; 0 then [id] END)' />
            </column>
            <column caption='% Delayed &gt; 10' datatype='real' default-format='p0.00%' name='[% Delayed (copy)_2277977051696283655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# delayed orders (copy)_2277977051695976453]/ [Calculation_1395271485122396162]' />
            </column>
            <column caption='AVG Delay' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG DT (copy)_2277977051697577993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; and [delay_customer] &gt; 0 then [delay_customer] END)' />
            </column>
            <column caption='AVG PDT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG DT (copy)_2277977051699466256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; then [estimated_delivery_time_minutes] END)' />
            </column>
            <column caption='AVG Diff to PDT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Delay (copy)_2277977051698483210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; then [delay_customer] END)' />
            </column>
            <column caption='AVG Amount' datatype='real' default-format='C1029%' name='[AVG Delivery Fee (copy)_2277977051691692032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Delivery Fee (copy)_2277977051691794433] / [Calculation_1395271485122396162]' />
            </column>
            <column caption='AVG Delivery Fee' datatype='real' default-format='C1029%' name='[AVG Delivery Revenue (copy)_1395271485126119430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Delivery Revenue (copy)_1395271485126320135] / [Calculation_1395271485122396162]' />
            </column>
            <column caption='AVG Dispatch' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Diff to PDT (copy)_2277977051698659339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; then [dispatch_time] END)' />
            </column>
            <column caption='AVG Time to Vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Dispatch (copy)_2277977051698741260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; then [to_restaurant] END)' />
            </column>
            <column caption='AVG Time to Dropoff' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Time to Customer (copy)_2277977051699142671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; then [to_dropoff] END)' />
            </column>
            <column caption='AVG Time at Vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Time to Vendor (copy)_2277977051698982925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; then [at_restaurant] END)' />
            </column>
            <column caption='AVG Time to Customer' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Time to Vendor (copy)_2277977051699064846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(if [status] = &quot;DELIVERED&quot; then [to_customer] END)' />
