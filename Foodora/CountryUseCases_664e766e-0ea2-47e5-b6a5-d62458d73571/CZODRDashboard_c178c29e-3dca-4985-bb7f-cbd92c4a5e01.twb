            <column caption='Delivery Revenue' datatype='real' default-format='C1029%' name='[Calculation_1395271485121490944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Delivery Revenue (copy)_1395271485126320135] / 1.21' />
            </column>
            <column caption='# delivered orders' datatype='integer' name='[Calculation_1395271485122396162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [status] = &quot;DELIVERED&quot; then [id]END)' />
            </column>
            <column caption='Gross Profit' datatype='real' default-format='C1029%' name='[Calculation_1395271485122887683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1395271485121490944] + [Calculation_1395271485130723337]' />
