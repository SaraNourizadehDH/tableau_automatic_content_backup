            </column>
            <column caption='# delivered orders' datatype='integer' name='[Calculation_1395271485122396162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [status] = &quot;DELIVERED&quot; then [id]END)' />
