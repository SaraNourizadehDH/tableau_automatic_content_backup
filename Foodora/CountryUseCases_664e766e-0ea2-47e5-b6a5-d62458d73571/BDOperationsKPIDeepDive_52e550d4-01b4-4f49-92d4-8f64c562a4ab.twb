    <worksheet name='OKR Values'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold'>Ops Metrics : &lt;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold'>[Parameters].[Parameter 1]</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Logistics Deep Dive' name='federated.1fip5p10369aj2145yxzs0wcxteu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fip5p10369aj2145yxzs0wcxteu'>
            <column caption='DT &gt; 45 mins Order %' datatype='real' name='[Calculation_-6257188721560895482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_time_45_more_orders])/SUM(orders)' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_-6257188721561178107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_time])/SUM([actual_delivery_time_orders])' />
            </column>
            <column caption='Selected Granularity' datatype='string' name='[Calculation_-6257188721562177532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN [date (copy)_-6257188721566167040]&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Estimated Prep Time' datatype='real' name='[Calculation_-6294343418473127935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time])/SUM([estimated_prep_time_orders])' />
            </column>
            <column caption='AO NPS (New)' datatype='real' name='[Calculation_1239615802708779008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_positive_ratings (Custom SQL Query9)])-SUM([nps_negative_ratings (Custom SQL Query9)]))* 100.0/SUM([total_ratings (Custom SQL Query9)])' />
            </column>
            <column caption='Vendor Offline %' datatype='real' name='[Calculation_2159476036115709953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_closed_seconds])/SUM([total_scheduled_open_seconds])' />
            </column>
            <column caption='Gross Orders' datatype='integer' name='[Calculation_2405203690244161539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gross_orders])' />
            </column>
            <column caption='Vendor Cancellation %' datatype='real' name='[Calculation_2405203690245406728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cancelle_orders])/[Calculation_2405203690244161539]' />
            </column>
            <column caption='Logistics Cancellation %' datatype='real' name='[Calculation_2405203690245660681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([logsitics_cancelled_orders])/[Calculation_2405203690244161539]' />
            </column>
            <column caption='Delayed Orders' datatype='integer' name='[Calculation_263179144967929857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delayed_orders])' />
            </column>
            <column caption='Delayed Order %' datatype='real' name='[Calculation_263179144968126467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_263179144967929857] / [Calculation_91197905153269768]' />
            </column>
            <column caption='CSAT % (Genuine/Green)' datatype='real' name='[Calculation_4448430544681160704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_green_score_4_5])/SUM([total_green_response])' />
            </column>
            <column caption='Incidents' datatype='integer' name='[Calculation_765893463629197313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ccr_count])' />
            </column>
            <column caption='Seamless Order % (New)' datatype='real' name='[Calculation_857513522140393474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_order_count])/SUM([seamless_order_gross])' />
            </column>
            <column caption='Weighted Shrinkage Time %' datatype='real' name='[Calculation_91197905118101505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(([percent_shrink_event_time])*[forecast_orders])/SUM([forecast_orders])' />
            </column>
            <column caption='Hurrier Orders' datatype='integer' name='[Calculation_91197905153269768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])' />
            </column>
            <column caption='Weighted Surge Time %' datatype='real' name='[Calculation_91197905222836235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([percent_surge_time]*[forecast_orders])/SUM([forecast_orders])' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='DT &lt; 30 mins Order %' datatype='real' name='[DT &lt; 20 mins Order % (copy)_91197906016292894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_time_30_less_orders])/SUM([orders])' />
            </column>
            <column caption='DT &gt; 60 mins Order %' datatype='real' name='[DT &gt; 45 mins Order % (copy)_91197906016047133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_time_60_more_orders])/SUM([orders])' />
            </column>
            <column caption='Delayed &gt; 10 mins Order %' datatype='real' name='[Delayed Orders % (copy)_263179144968216580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Delayed Orders (copy)_263179144968019970] / [Calculation_91197905153269768]' />
            </column>
            <column caption='Delayed &gt; 10 mins Orders' datatype='integer' name='[Delayed Orders (copy)_263179144968019970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delayed_10_more_orders])' />
            </column>
            <column datatype='real' name='[Delivery_time]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Delivery_time_30_less_orders]' role='measure' type='quantitative' />
