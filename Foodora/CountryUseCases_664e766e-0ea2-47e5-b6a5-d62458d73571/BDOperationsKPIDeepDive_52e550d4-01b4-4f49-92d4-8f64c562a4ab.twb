            <column caption='SDD DT &gt; 40 mins Order %' datatype='real' name='[Calculation_2167216642333528064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sdd_high_dt])/SUM([seamless_order_gross])' />
