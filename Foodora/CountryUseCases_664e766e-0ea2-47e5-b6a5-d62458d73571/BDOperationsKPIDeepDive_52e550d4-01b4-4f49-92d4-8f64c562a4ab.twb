    <worksheet name='Cancellation'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold'>Orders and Cancellation : &lt;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold'>[Parameters].[Parameter 1]</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Logistics Deep Dive' name='federated.1fip5p10369aj2145yxzs0wcxteu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Level Granularity' datatype='string' name='[Date Granularity (copy)_747808658947801133]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fip5p10369aj2145yxzs0wcxteu'>
            <column caption='Selected Granularity' datatype='string' name='[Calculation_-6257188721562177532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN [date (copy)_-6257188721566167040]&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Gross Orders' datatype='integer' name='[Calculation_2405203690244161539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gross_orders])' />
            </column>
            <column caption='Valid Orders' datatype='integer' name='[Calculation_2405203690244358148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([orders (Custom_SQL_Query9)],0))' />
            </column>
            <column caption='Failed Order %' datatype='real' name='[Calculation_2405203690244567045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2405203690244161539] - [Calculation_2405203690244358148])/[Calculation_2405203690244161539]' />
            </column>
            <column caption='OPD' datatype='real' name='[Calculation_2405203690244907014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2405203690244358148]/COUNTD([order_date (Custom_SQL_Query9)])' />
            </column>
            <column caption='Customer Cancellation %' datatype='real' name='[Calculation_2405203690245136391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_cancelled_orders])/[Calculation_2405203690244161539]' />
            </column>
            <column caption='Vendor Cancellation %' datatype='real' name='[Calculation_2405203690245406728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_cancelle_orders])/[Calculation_2405203690244161539]' />
