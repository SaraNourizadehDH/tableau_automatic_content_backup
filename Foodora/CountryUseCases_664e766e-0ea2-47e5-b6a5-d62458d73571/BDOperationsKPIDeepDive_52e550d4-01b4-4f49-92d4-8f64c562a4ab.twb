            <column caption='Total Scheduled Zone Minutes' datatype='integer' name='[Calculation_3191644806631354369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_scheduled_minutes])' />
            </column>
            <column caption='Shrink 1 %' datatype='real' name='[Calculation_3191644806631682050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_minutes_in_shrink_1])/SUM([total_scheduled_minutes])' />
            </column>
            <column caption='Shrink 2 %' datatype='real' name='[Calculation_3191644806631817219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_minutes_in_shrink_2])/SUM([total_scheduled_minutes])' />
            </column>
            <column caption='Shrink 3 %' datatype='real' name='[Calculation_3191644806632034308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_minutes_in_shrink_3])/SUM([total_scheduled_minutes])' />
            </column>
            <column caption='Total Shrink %' datatype='real' name='[Calculation_3191644806633308165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_minutes_in_shrink])/SUM([total_scheduled_minutes])' />
            </column>
            <column caption='CSAT % (Genuine/Green)' datatype='real' name='[Calculation_4448430544681160704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_green_score_4_5])/SUM([total_green_response])' />
            </column>
            <column caption='CSAT % (Fraud/Red)' datatype='real' name='[Calculation_4448430544681345025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_red_score_4_5])/SUM([total_red_response])' />
            </column>
            <column caption='CSAT % (Orange)' datatype='real' name='[Calculation_4448430544681467906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_orange_score_4_5])/SUM([total_orange_response])' />
            </column>
            <column caption='Delayed &gt; 5 mins Order %' datatype='real' name='[Calculation_4596838259096477696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delayed_by_5_minutes])/SUM([seamless_order_gross])' />
            </column>
            <column caption='Early &gt; 15 mins Order %' datatype='real' name='[Calculation_4596838259098640385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_by_15_minutes])/SUM([seamless_order_gross])' />
            </column>
            <column caption='DF/Order (BDT)' datatype='real' name='[Calculation_4603241785340469248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DF])/SUM([orders_DF])' />
            </column>
            <column caption='Restaurant DF/Order (BDT)' datatype='real' name='[Calculation_4603241785396310017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DF_restaurants])/SUM([orders_DF_resto])' />
            </column>
            <column caption='Shops DF/Order (BDT)' datatype='real' name='[Calculation_4603241785397100546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DF_shops])/SUM([orders_DF_shops])' />
            </column>
            <column caption='Dmart DF/Order (BDT)' datatype='real' name='[Calculation_4603241785397489667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DF_dmart])/SUM([orders_DF_dmart])' />
