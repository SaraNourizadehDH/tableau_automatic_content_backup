            <column caption='Rider Late &gt; 0 mins % ' datatype='real' name='[Calculation_6191745827253510144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_orders_grt_0_orders])/SUM([orders])' />
