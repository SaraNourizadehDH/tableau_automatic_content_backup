        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.05dlw8o11ntnza1gdeomv0ljzhwq'>
            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='foodpanda-bd-bigquery' schema='pandata_bd_ops' server-oauth='server-custom' username='ateeq.ur@foodpanda.com.bd' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.05dlw8o11ntnza1gdeomv0ljzhwq' name='Custom SQL Query5' type='text'>SELECT * FROM `fulfillment-dwh-production.pandata_report.country_BD_ops_deep_dive_monthly_delivered_riders`</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.05dlw8o11ntnza1gdeomv0ljzhwq' name='Custom_SQL_Query' type='text'>WITH dates AS(
  SELECT
  DISTINCT
  date,
  FORMAT_DATETIME(&quot;%Y-%m&quot;, DATETIME(date)) AS month,
  FORMAT_DATETIME(&quot;%Y-%W&quot;, DATETIME(date)) AS week
  FROM `fulfillment-dwh-production.pandata_curated.shared_dates` 
  WHERE date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
),

month_ranking AS(
  SELECT
  month,
  ROW_NUMBER() OVER(ORDER BY month DESC) AS month_rank
  FROM(
    SELECT
    DISTINCT
    month
    FROM dates
    )  
),

week_ranking AS(
  SELECT
  week,
  ROW_NUMBER() OVER(ORDER BY week DESC) AS week_rank
  FROM(
    SELECT
    DISTINCT
    week
    FROM dates
    )  
),

final_dates AS(
  SELECT
  dates.*,
  month_ranking.month_rank,
  week_ranking.week_rank
  FROM dates
  LEFT JOIN month_ranking
         ON month_ranking.month = dates.month
  LEFT JOIN week_ranking
         ON week_ranking.week = dates.week
),

zone_city_info AS(
  SELECT
  &quot;FP_BD&quot; AS global_entity_id,
  c.id AS city_id,
  z.id AS zone_id,
  z.name AS zone_name,
  c.name AS city_name,
  FROM `fulfillment-dwh-production.curated_data_shared.countries`,UNNEST(cities) AS c, UNNEST(zones) AS z
  WHERE country_code = &quot;bd&quot;
  AND c.is_active
  AND z.is_active
  UNION ALL
  SELECT
  &apos;FP_BD&apos; AS global_entity_id,
  0 AS city_id,
  0 AS zone_id,
  &apos;No Zone Name&apos; AS zone_name,
  &apos;No City Name&apos; AS city_name
),

business_types AS(
  SELECT
  DISTINCT
  business_type_apac
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types`
  WHERE global_entity_id = &quot;FP_BD&quot;
  UNION ALL
  SELECT
  &quot;NULL&quot; AS business_type_apac
)

SELECT
&quot;Bangladesh&quot; AS Country,
*
FROM zone_city_info
CROSS JOIN final_dates
CROSS JOIN business_types</relation>
