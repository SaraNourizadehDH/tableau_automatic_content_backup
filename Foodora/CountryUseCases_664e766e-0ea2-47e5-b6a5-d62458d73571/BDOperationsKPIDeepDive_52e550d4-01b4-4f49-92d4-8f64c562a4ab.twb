      </layout-options>
      <repository-location id='OpsMetrics' path='/t/Foodora/workbooks/BDOperationsDeepDive' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='Logistics Deep Dive' name='federated.1fip5p10369aj2145yxzs0wcxteu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Level Granularity' datatype='string' name='[Date Granularity (copy)_747808658947801133]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fip5p10369aj2145yxzs0wcxteu'>
            <column caption='% of Walker Rider' datatype='real' name='[% of Ebike Rider (copy)_332421982830682116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unique Active Ebike Rider (copy)_332421982830182401]/[Calculation_889460942678503424]' />
            </column>
            <column caption='% of Bicycle Rider' datatype='real' name='[% of Ebike Rider (copy)_332421982831947782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_889460942679592961]/[Calculation_889460942678503424]' />
            </column>
            <column caption='% of E-Bike Rider' datatype='real' name='[% of Motorbike Rider (copy)_332421982830469123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Unique Active Motorbike Rider (copy)_332421982829973504]/[Calculation_889460942678503424]' />
            </column>
            <column caption='Motorbike Orders %' datatype='real' name='[Bicycle Orders % (copy)_960955606945038337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([motorbike_deliveries]) / SUM([deliveries])' />
            </column>
            <column caption='E-Bike Orders %' datatype='real' name='[Bicycle Orders % (copy)_960955606945169410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ebikes_deliveries]) / SUM([deliveries])' />
            </column>
            <column caption='Motorbike Stacked Order %' datatype='real' name='[Bicycle Stacked Order % (copy)_960955606947495942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders_motorbike]) / SUM([motorbike_deliveries])' />
            </column>
            <column caption='E-Bike Stacked Order %' datatype='real' name='[Bicycle Stacked Order % (copy)_960955606947713031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders_ebike]) / SUM([ebikes_deliveries])' />
            </column>
            <column caption='Walker Stacked Order %' datatype='real' name='[Bicycle Stacked Order % (copy)_960955606947856392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders_walker]) / SUM([walker_deliveries])' />
            </column>
            <column caption='Dispatching Time' datatype='real' name='[Calculation_-6257188721557454840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dispatching_time])/SUM([dispatching_time_orders])' />
            </column>
            <column caption='DT &gt; 45 mins Order %' datatype='real' name='[Calculation_-6257188721560895482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_time_45_more_orders])/SUM(orders)' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_-6257188721561178107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_time])/SUM([actual_delivery_time_orders])' />
            </column>
            <column caption='Selected Granularity' datatype='string' name='[Calculation_-6257188721562177532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN [date (copy)_-6257188721566167040]&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_-6294343418217095152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_-6257188721561178107]/[Calculation_-6294343418453643251]' />
            </column>
            <column caption='Daily Working Hours' datatype='real' name='[Calculation_-6294343418451841009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_working_time])/COUNTD([shift_date (Custom_SQL_Query4)])' />
            </column>
            <column caption='UTR (Overall)' datatype='real' name='[Calculation_-6294343418453643251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deliveries])/SUM([actual_working_time])' />
            </column>
            <column caption='UTR (Motorbike)' datatype='real' name='[Calculation_-6294343418456465396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([motorbike_deliveries])/SUM([motorbike_actual_working_time])' />
            </column>
            <column caption='UTR (Bicycle)' datatype='real' name='[Calculation_-6294343418457284597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bicycle_deliveries])/SUM([bicycle_actual_working_time])' />
            </column>
            <column caption='Rider Acceptance Rate' datatype='real' name='[Calculation_-6294343418466533368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([accepted_vol])/SUM([notification_vol])' />
            </column>
            <column caption='Rider Fill Rate %' datatype='real' name='[Calculation_-6294343418467766265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum(planned_rh)/sum(ifnull([unassign_hour],1)+planned_rh),0)' />
            </column>
            <column caption='Vendor Late' datatype='real' name='[Calculation_-6294343418468417530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late])/SUM([vendor_late_orders])' />
            </column>
            <column caption='Rider Late' datatype='real' name='[Calculation_-6294343418468802555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late])/SUM([rider_late_orders])' />
            </column>
            <column caption='Rider Reaction Time' datatype='real' name='[Calculation_-6294343418469244924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_reaction_time])/SUM([rider_reaction_time_orders])' />
            </column>
            <column caption='To Vendor Time' datatype='real' name='[Calculation_-6294343418470150141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_vendor_time])/SUM([to_vendor_time_orders])' />
            </column>
            <column caption='To Customer Time' datatype='real' name='[Calculation_-6294343418470432766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_customer_time])/SUM([to_customer_time_orders])' />
            </column>
            <column caption='Estimated Prep Time' datatype='real' name='[Calculation_-6294343418473127935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time])/SUM([estimated_prep_time_orders])' />
            </column>
            <column caption='Actual Prep Time' datatype='real' name='[Calculation_-6294343418473631744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([assumed_actual_prep_time])/SUM([assumed_actual_prep_time_orders])' />
            </column>
            <column caption='Single Stacked Deliveries %' datatype='real' name='[Calculation_-6499820149701881851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([single_stacked_orders])/SUM([total_deliveries])' />
            </column>
            <column caption='Stacked Deliveries %' datatype='real' name='[Calculation_-6499820149703176190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([total_deliveries])' />
            </column>
            <column caption='Priority Delivery %' datatype='real' name='[Calculation_1142225483807322112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([priority_orders])/SUM([orders_DF])' />
            </column>
            <column caption='Priority Delivery Count' datatype='integer' name='[Calculation_1142225483807989761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([priority_orders])' />
            </column>
            <column caption='Surge Fee/Order (BDT)' datatype='real' name='[Calculation_1228990129026289664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surge_fee])/SUM([orders])' />
            </column>
            <column caption='Priority Delayed Order %' datatype='real' name='[Calculation_1228990129041948673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delayed_orders (Custom SQL Query11)])/SUM([orders (Custom SQL Query11)])' />
            </column>
            <column caption='Priority Early &gt; 10 mins Order %' datatype='real' name='[Calculation_1228990129049182212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_10_more_orders (Custom SQL Query11)])/SUM([orders (Custom SQL Query11)])' />
            </column>
            <column caption='Priority Vendor Late &gt; 5 mins Order %' datatype='real' name='[Calculation_1228990129049784325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_5_more_orders (Custom SQL Query11)])/SUM([orders (Custom SQL Query11)])' />
            </column>
            <column caption='Priority DT' datatype='real' name='[Calculation_1228990129051250695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_time (Custom SQL Query11)])/SUM([orders (Custom SQL Query11)])' />
            </column>
            <column caption='Unique Delivered Riders' datatype='integer' name='[Calculation_1232016012529635328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN SUM([delivered_rider_daily])&#10;WHEN &quot;Week&quot; THEN SUM([delivered_rider_weekly])&#10;WHEN &quot;Month&quot; THEN SUM([delivered_rider_monthly])&#10;END' />
            </column>
            <column caption='% of Delivered Riders' datatype='real' name='[Calculation_1232016012530987009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1232016012529635328]/[Calculation_889460942678503424]' />
            </column>
            <column caption='AO NPS (New)' datatype='real' name='[Calculation_1239615802708779008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nps_positive_ratings (Custom SQL Query9)])-SUM([nps_negative_ratings (Custom SQL Query9)]))* 100.0/SUM([total_ratings (Custom SQL Query9)])' />
            </column>
            <column caption='Weighted Closure Time %' datatype='real' name='[Calculation_1381831047670992896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([percent_close_event_time]*[forecast_orders])/SUM([forecast_orders])' />
            </column>
            <column caption='P-D Distance (km)' datatype='real' name='[Calculation_215609884440162306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_distance_manhattan_in_meters])/SUM([deliveries])/1000' />
            </column>
            <column caption='Order Per Rider Per Day' datatype='real' name='[Calculation_2159476036144578585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count])/COUNTD([lg_rider_id])/COUNTD([created_date_local (Custom_SQL_Query12)])' />
