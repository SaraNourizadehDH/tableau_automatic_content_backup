    <worksheet name='Service'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='12'>Service Ops : &lt;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='12'>[Parameters].[Parameter 1]</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Logistics Deep Dive' name='federated.1fip5p10369aj2145yxzs0wcxteu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fip5p10369aj2145yxzs0wcxteu'>
            <column caption='Selected Granularity' datatype='string' name='[Calculation_-6257188721562177532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN [date (copy)_-6257188721566167040]&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='AO NPS' datatype='real' name='[Calculation_2405203690103361537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(nps_positive_ratings)-SUM(nps_negative_ratings))* 100.0/SUM(total_ratings)' />
            </column>
            <column caption='Gross Orders' datatype='integer' name='[Calculation_2405203690244161539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gross_orders])' />
            </column>
            <column caption='Valid Orders' datatype='integer' name='[Calculation_2405203690244358148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([orders (Custom_SQL_Query9)],0))' />
            </column>
            <column caption='CSAT Score 4 &amp; 5 Response Count' datatype='integer' name='[Calculation_2405203690434396181]' role='measure' type='quantitative'>
