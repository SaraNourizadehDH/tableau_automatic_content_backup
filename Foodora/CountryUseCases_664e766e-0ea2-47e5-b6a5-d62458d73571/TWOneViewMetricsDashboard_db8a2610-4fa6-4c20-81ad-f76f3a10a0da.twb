            <column caption='datetrunc_report_date' datatype='date' name='[Calculation_5073797568527220741]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 3], &quot;(month)|(mtd)&quot;)&#10;THEN DATE(DATETRUNC(&quot;month&quot;, [report_date]))&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 3], &quot;(week)|(wtd)&quot;)&#10;THEN DATE(DATETRUNC(&quot;iso-week&quot;, [report_date]))&#10;ELSE DATE(DATETRUNC(&quot;day&quot;, [report_date]))&#10;END' />
