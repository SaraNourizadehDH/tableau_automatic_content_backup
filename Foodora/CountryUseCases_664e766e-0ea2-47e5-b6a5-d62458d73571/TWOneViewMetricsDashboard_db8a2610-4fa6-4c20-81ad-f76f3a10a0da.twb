              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 3], &quot;(year)|(ytd)&quot;)&#10;THEN DATENAME(&quot;year&quot;, [report_date])&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 3], &quot;(quarter)|(qtd)&quot;)&#10;THEN &quot;Q&quot; + DATENAME(&quot;quarter&quot;, [report_date])&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 3], &quot;(month)|(mtd)&quot;)&#10;THEN LEFT(DATENAME(&quot;month&quot;, [report_date]), 3)&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 3], &quot;(week)|(wtd)&quot;)&#10;THEN &quot;Week &quot; + DATENAME(&quot;iso-week&quot;, [report_date])&#10;ELSEIF [Parameters].[Parameter 3] = &quot;day&quot;&#10;THEN STR([Calculation_5073797568527220741])&#10;END' />
            </column>
