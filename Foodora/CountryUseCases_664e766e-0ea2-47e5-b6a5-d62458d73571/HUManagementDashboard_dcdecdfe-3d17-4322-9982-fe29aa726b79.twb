            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_8673088464385294358]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_1073264146391670795]' caption='Reporting Month' datatype='date' default-format='*yyyy mmmm' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hlk9c108s4zcd11akq9117bbz54'>
            <column caption='Period Monthly' datatype='datetime' name='[Calculation_1073264146386268167]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date])' />
            </column>
            <column caption='report_month' datatype='date' datatype-customized='true' name='[Calculation_1073264146391670795]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='MoM LP' datatype='boolean' name='[Calculation_1073264146419081231]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([Parameters].[report_month Parameter]) = MONTH(TODAY()) &#13;&#10;AND YEAR([Parameters].[report_month Parameter]) = YEAR(TODAY()) THEN&#13;&#10;[date] &gt;= DATEADD(&quot;month&quot;,-1,[Parameters].[report_month Parameter]) &#13;&#10;AND [date] &lt;= DATEADD(&quot;month&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSE&#13;&#10;[date] &gt;= DATEADD(&quot;month&quot;,-1,[Parameters].[report_month Parameter]) &#13;&#10;AND [date] &lt;= DATEADD(&apos;day&apos;, -1, [Parameters].[report_month Parameter])&#13;&#10;END' />
            </column>
            <column caption='MoM - YoY Current Period' datatype='boolean' name='[Calculation_1073264146420236304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([Parameters].[report_month Parameter]) = MONTH(TODAY()) &#13;&#10;AND YEAR([Parameters].[report_month Parameter]) = YEAR(TODAY()) &#13;&#10;THEN&#13;&#10;    [date] &gt;= [Parameters].[report_month Parameter] AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;ELSE&#13;&#10;    [date] &gt;= [Parameters].[report_month Parameter] &#13;&#10;AND [date] &lt;= DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, [Parameters].[report_month Parameter]))&#13;&#10;END' />
            </column>
            <column caption='MoTD or MoM' datatype='boolean' name='[Calculation_1073264146420404241]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1073264146420236304] OR [Calculation_1073264146419081231]' />
            </column>
            <column caption='&quot;MoM&quot;' datatype='string' name='[Calculation_1282118579398250496]' role='dimension' type='nominal' user:unnamed='monthly_city_motd_orders'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='% VFD / GMV LP' datatype='real' name='[Calculation_1282118579465469997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] THEN [vf_deal_total_incl_voucher_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN [gmv_local] END), -1)'>
                <table-calc ordering-type='Rows' />
