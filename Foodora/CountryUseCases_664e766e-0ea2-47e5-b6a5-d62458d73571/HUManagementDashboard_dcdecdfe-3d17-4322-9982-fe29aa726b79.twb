            <column datatype='boolean' name='[is_valid_order]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1224416154036039680]' derivation='None' name='[none:Calculation_1224416154036039680:nk]' pivot='key' type='nominal' />
            <column-instance column='[YtD LY Title (copy)_1212875715427082245]' derivation='None' name='[none:YtD LY Title (copy)_1212875715427082245:nk]' pivot='key' type='nominal' />
            <column-instance column='[YtD Last Year (weekly)  (copy)_1212875715427209222]' derivation='None' name='[none:YtD Last Year (weekly)  (copy)_1212875715427209222:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
