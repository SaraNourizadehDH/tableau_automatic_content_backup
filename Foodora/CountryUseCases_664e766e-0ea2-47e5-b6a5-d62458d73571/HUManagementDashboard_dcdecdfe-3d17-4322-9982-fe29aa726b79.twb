      <column caption='GMV Target' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[GMV (copy)_1649724888191070214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1188668875951497240] * &#13;&#10;AVG(IF [city_name] = &apos;Total CZ&apos; THEN&#13;&#10;        CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;        WHEN &apos;2024-01&apos; THEN 24.8 * 19111434&#13;&#10;        WHEN &apos;2024-02&apos; THEN 24.8 * 17522334&#13;&#10;        WHEN &apos;2024-03&apos; THEN 24.8 * 19529372&#13;&#10;        WHEN &apos;2024-04&apos; THEN 24.8 * 19415700&#13;&#10;        WHEN &apos;2024-05&apos; THEN 24.8 * 20584856&#13;&#10;        WHEN &apos;2024-06&apos; THEN 24.8 * 18291957&#13;&#10;        END&#13;&#10;    END)' />
      </column>
      <column caption='Target Title' datatype='string' name='[MoM Title (copy)_52072871777832978]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; Target&quot;' />
      </column>
      <column caption='YoY Filter for Monthly' datatype='boolean' name='[Month Filter (copy)_1179380202030243880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Month Filter LY (copy)_1179380202031349802]&#13;&#10;OR &#13;&#10;[Month Filter (copy)_1179380202030845993]' />
      </column>
      <column caption='Month Filter LY' datatype='boolean' name='[Month Filter (copy)_1179380202030845993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1073264146391670795] = DATEADD(&apos;year&apos;,-1,DATE([Parameters].[report_month Parameter]))' />
      </column>
      <column caption='Month Filter CY' datatype='boolean' name='[Month Filter LY (copy)_1179380202031349802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1073264146391670795] = [Parameters].[report_month Parameter]' />
      </column>
      <column caption='PtD or PtD LY' datatype='boolean' name='[MtD  (copy)_1231734538926047234]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_236720498005434378] OR [YtD Last Year (weekly)  (copy)_1212875715427209222]' />
      </column>
      <column caption='Orders per A GMV Class Vendors' datatype='real' name='[Orders per A Grade Vendors (copy)_678917692299509761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [is_valid_order] = TRUE AND [gmv_class] = &quot;A&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [order_code] END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;IF [gmv_class] = &quot;A&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [vendor_code] END&#13;&#10;)' />
      </column>
      <column caption='Orders per B Grade Vendors' datatype='real' name='[Orders per A Vendors (copy)_900438471490265095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [is_valid_order] = TRUE AND [sf_vendor_grade] = &quot;B&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [order_code] END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;IF [sf_vendor_grade] = &quot;B&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [vendor_code] END&#13;&#10;)' />
      </column>
      <column caption='Orders per B GMV Class Vendors' datatype='real' name='[Orders per B Grade Vendors (copy)_678917692299509762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [is_valid_order] = TRUE AND [gmv_class] = &quot;B&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [order_code] END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;IF [gmv_class] = &quot;B&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [vendor_code] END&#13;&#10;)' />
      </column>
      <column caption='Period' datatype='integer' datatype-customized='true' name='[Period Date (copy)_236720497993867266]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN WEEK([date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([date])&#13;&#10;END' />
      </column>
      <column caption='PtD LP' datatype='boolean' name='[PtD LY (copy)_1649724888175493121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN ([date] &gt;= DATEADD(&quot;month&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;month&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Weekly&quot; THEN  ([date] &gt;= DATEADD(&quot;week&quot;,-1,[Calculation_236720498005807115]) AND  [date] &lt;= DATEADD(&quot;week&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;END' />
      </column>
      <column caption='Target PtD Title ' datatype='string' name='[PtD LY Title (copy)_1188668875943636999]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN &quot;Target MtD&quot;&#13;&#10;    WHEN &quot;Weekly&quot; THEN &quot;Target WtD&quot;&#13;&#10;END' />
      </column>
      <column caption='PtD LP Title' datatype='string' name='[PtD LY Title (copy)_1649724888174682112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &quot;MtD LM&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WtD LW&quot;&#13;&#10;END' />
      </column>
      <column caption='PtD or PtD LP' datatype='boolean' name='[PtD or PtD LY (copy)_1649724888176001026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_236720498005434378] OR [PtD LY (copy)_1649724888175493121]' />
      </column>
      <column aggregation='Avg' caption='Target Orders Per Capita' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Target Orders (copy)_1188668875944505352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//0.01 * [PtD for targets]&#13;&#10;FLOAT(NULL)' />
      </column>
      <column caption='Diff vs. Target Title' datatype='string' name='[Target PtD Title  (copy)_1188668875955519515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;vs Target&quot;' />
      </column>
      <column caption='Target Diff Title' datatype='string' name='[Target Title (copy)_52072871795056672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Diff Target&quot;' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Week Filter (copy)_236720497993707521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN&#13;&#10; [date] &gt;= DATEADD(&apos;week&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)) AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN&#13;&#10; [date] &gt;= DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])) AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END' />
      </column>
      <column caption='PtD LY Title' datatype='string' name='[YtD LY Title (copy)_1212875715427082245]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &quot;MtD LY&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WtD LY&quot;&#13;&#10;END' />
      </column>
      <column caption='PtD LY' datatype='boolean' name='[YtD Last Year (weekly)  (copy)_1212875715427209222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([date]) = YEAR([Parameters].[Reporting Month (copy)_52072871788789788])-1&#13;&#10;AND&#13;&#10;[Period Date (copy)_236720497993867266] = [Calculation_236720497996382212]&#13;&#10;AND&#13;&#10;IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DAY([date]) &lt;= DAY([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[date],&apos;monday&apos;),[date]) &lt;= DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;),[Parameters].[Reporting Month (copy)_52072871788789788]) &#13;&#10;END' />
      </column>
