            </column>
            <column caption='County' datatype='string' name='[Calculation_1429611471510126592]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
              <calculation class='tableau' formula='CASE [city_name]&#13;&#10;    WHEN &quot;baja&quot; THEN &quot;Bács-Kiskun&quot;&#13;&#10;    WHEN &quot;balatonfured&quot; THEN &quot;Veszprém&quot;&#13;&#10;    WHEN &quot;bekescsaba&quot; THEN &quot;Békés&quot;&#13;&#10;    WHEN &quot;budapest&quot; THEN &quot;Budapest&quot;&#13;&#10;    WHEN &quot;debrecen&quot; THEN &quot;Hajdú-Bihar&quot;&#13;&#10;    WHEN &quot;dunaujvaros&quot; THEN &quot;Fejér&quot;&#13;&#10;    WHEN &quot;eger&quot; THEN &quot;Heves&quot;&#13;&#10;    WHEN &quot;esztergom&quot; THEN &quot;Komárom-Esztergom&quot;&#13;&#10;    WHEN &quot;gyongyos&quot; THEN &quot;Heves&quot;&#13;&#10;    WHEN &quot;gyor&quot; THEN &quot;Győr-Moson-Sopron&quot;&#13;&#10;    WHEN &quot;kaposvar&quot; THEN &quot;Somogy&quot;&#13;&#10;    WHEN &quot;kazincbarcika&quot; THEN &quot;Borsod-Abaúj-Zemplén&quot;&#13;&#10;    WHEN &quot;kecskemet&quot; THEN &quot;Bács-Kiskun&quot;&#13;&#10;    WHEN &quot;keszthely&quot; THEN &quot;Zala&quot;&#13;&#10;    WHEN &quot;kisvarda&quot; THEN &quot;Szabolcs-Szatmár-Bereg&quot;&#13;&#10;    WHEN &quot;mako&quot; THEN &quot;Csongrád&quot;&#13;&#10;    WHEN &quot;miskolc&quot; THEN &quot;Borsod-Abaúj-Zemplén&quot;&#13;&#10;    WHEN &quot;mosonmagyarovar&quot; THEN &quot;Győr-Moson-Sopron&quot;&#13;&#10;    WHEN &quot;nagykanizsa&quot; THEN &quot;Zala&quot;&#13;&#10;    WHEN &quot;nyiregyhaza&quot; THEN &quot;Szabolcs-Szatmár-Bereg&quot;&#13;&#10;    WHEN &quot;ozd&quot; THEN &quot;Borsod-Abaúj-Zemplén&quot;&#13;&#10;    WHEN &quot;papa&quot; THEN &quot;Veszprém&quot;&#13;&#10;    WHEN &quot;pecs&quot; THEN &quot;Baranya&quot;&#13;&#10;    WHEN &quot;salgotarjan&quot; THEN &quot;Nógrád&quot;&#13;&#10;    WHEN &quot;siofok&quot; THEN &quot;Somogy&quot;&#13;&#10;    WHEN &quot;sopron&quot; THEN &quot;Győr-Moson-Sopron&quot;&#13;&#10;    WHEN &quot;szeged&quot; THEN &quot;Csongrád&quot;&#13;&#10;    WHEN &quot;szekesfehervar&quot; THEN &quot;Fejér&quot;&#13;&#10;    WHEN &quot;szekszard&quot; THEN &quot;Tolna&quot;&#13;&#10;    WHEN &quot;szolnok&quot; THEN &quot;Jász-Nagykun-Szolnok&quot;&#13;&#10;    WHEN &quot;szombathely&quot; THEN &quot;Vas&quot;&#13;&#10;    WHEN &quot;tatabanya&quot; THEN &quot;Komárom-Esztergom&quot;&#13;&#10;    WHEN &quot;veszprem&quot; THEN &quot;Veszprém&quot;&#13;&#10;    WHEN &quot;zalaegerszeg&quot; THEN &quot;Zala&quot;&#13;&#10;    ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Metric Value' datatype='real' name='[Calculation_1429611471520337922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN [Calculation_1000362122761048064]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN [Calculation_1000362122761297921]&#13;&#10;    WHEN &quot;MAU&quot; THEN [Calculation_1348265199284862976]&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_638385247264137220]&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN [Calculation_678917692299829251]&#13;&#10;    WHEN &quot;OD Share&quot; THEN [Calculation_1226386527727788032] * 100&#13;&#10;    WHEN &quot;Seamless %&quot; THEN [Calculation_886646182733557768] * 100&#13;&#10;    WHEN &quot;Avg DT&quot; THEN [Calculation_886646182736216076]&#13;&#10;    WHEN &quot;Order Late 10m %&quot; THEN [Calculation_886646182731751424] * 100&#13;&#10;    WHEN &quot;Fail Rate %&quot; THEN [Calculation_900438471487643652] * 100&#13;&#10;    WHEN &quot;AFV (HUF)&quot; THEN [Calculation_1282118579461185578]&#13;&#10;    WHEN &quot;VFD / GMV %&quot; THEN [Calculation_790381762694070273] * 100&#13;&#10;    WHEN &quot;% Valid Orders By Pro Users&quot; THEN [Calculation_638385247291756550] * 100&#13;&#10;    WHEN &quot;Consumer Fees %&quot; THEN AVG([Calculation_1279022355005009924]) * 100&#13;&#10;    WHEN &quot;QC GMV %&quot; THEN [Calculation_1179380202026074148] * 100&#13;&#10;END' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_638385247264137220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_valid_order] THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] THEN [customer_code] END)' />
            </column>
            <column caption='PRO Orders %' datatype='real' default-format='p0.0%' name='[Calculation_638385247291756550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_valid_order] AND [is_subscription_order] THEN [order_code] END) / &#13;&#10;COUNTD(IF [is_valid_order] THEN [order_code] END)' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Calculation_678917692299829251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [was_active] THEN [vendor_code] END)' />
            </column>
            <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] THEN [vf_deal_total_incl_voucher_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN [gmv_local] END)' />
            </column>
            <column caption='% Delay &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_886646182731751424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [delivery_status] = &quot;Late&quot;&#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% Seamless' datatype='real' default-format='p0.0%' name='[Calculation_886646182733557768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_seamless_order] &#13;&#10;AND [hurrier_order_status] = &quot;completed&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] END)' />
            </column>
            <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_886646182736216076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF NOT [is_preorder] AND [is_own_delivery] THEN &#13;&#10;[actual_delivery_time_min] END) / COUNTD(IF NOT [is_preorder] AND [is_own_delivery] THEN [order_code] END)' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_failed_order] = TRUE THEN [order_code] END)&#13;&#10;/ COUNTD([order_code])' />
            </column>
            <column caption='Regions' datatype='string' name='[County &amp; Country (group)]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
              <calculation class='categorical-bin' column='[County &amp; Country]' default='&quot;Budapest + Other&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Central Transdanubia&quot;'>
                  <value>(&quot;Fejér&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Komárom-Esztergom&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Veszprém&quot;,&quot;Hungary&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Northern Great Plain&quot;'>
                  <value>(&quot;Hajdú-Bihar&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Jász-Nagykun-Szolnok&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Szabolcs-Szatmár-Bereg&quot;,&quot;Hungary&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Northern Hungary&quot;'>
                  <value>(&quot;Borsod-Abaúj-Zemplén&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Heves&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Nógrád&quot;,&quot;Hungary&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Southern Great Plain&quot;'>
                  <value>(&quot;Bács-Kiskun&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Békés&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Csongrád&quot;,&quot;Hungary&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Southern Transdanubia&quot;'>
                  <value>(&quot;Baranya&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Somogy&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Tolna&quot;,&quot;Hungary&quot;)</value>
                </bin>
                <bin default-name='false' value='&quot;Western Transdanubia&quot;'>
                  <value>(&quot;Győr-Moson-Sopron&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Vas&quot;,&quot;Hungary&quot;)</value>
                  <value>(&quot;Zala&quot;,&quot;Hungary&quot;)</value>
                </bin>
              </calculation>
            </column>
            <column datatype='real' name='[actual_delivery_time_min]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;borota (teszt)&quot;' value='&quot;Jánoshalma&quot;' />
                <semantic-value key='&quot;Other&quot;' value='&quot;Budapest III. kerület&quot;' />
              </semantic-values>
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
