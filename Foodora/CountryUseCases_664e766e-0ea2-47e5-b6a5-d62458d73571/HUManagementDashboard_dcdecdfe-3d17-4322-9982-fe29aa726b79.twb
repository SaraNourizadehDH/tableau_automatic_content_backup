            <column-instance column='[Calculation_1179380202026074148]' derivation='User' name='[usr:Calculation_1179380202026074148:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1348265199319326737]' derivation='User' name='[usr:Calculation_1348265199319326737:ok]' pivot='key' type='ordinal' />
