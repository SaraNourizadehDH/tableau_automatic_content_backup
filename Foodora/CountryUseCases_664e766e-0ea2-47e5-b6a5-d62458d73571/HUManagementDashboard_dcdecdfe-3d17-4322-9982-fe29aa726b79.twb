            <formatted-text>
              <run fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'>*</run>
              <run bold='true' fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'> For country view, choose</run>
              <run bold='true' fontcolor='#df1067' fontname='Tableau Light' fontsize='10'> &apos;Total Hungary&apos;</run>
              <run bold='true' fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'> from Breakdown parameter and set</run>
              <run bold='true' fontcolor='#df1067' fontname='Tableau Light' fontsize='10'> All</run>
              <run bold='true' fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'> region.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>* Laas orders and </run>
              <run fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'>orders from VD cities are not included</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'>* </run>
              <run bold='true' fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'>Session</run>
              <run fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'> data is currently not available for this aggregation. (</run>
              <run fontcolor='#df1067' fontname='Tableau Light' fontsize='10'>Work in progress</run>
              <run fontcolor='#1d1c1d' fontname='Tableau Light' fontsize='10'>)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>* Refreshes on daily basis at 9:00 AM</run>
              <run>Æ&#10;</run>
            </formatted-text>
