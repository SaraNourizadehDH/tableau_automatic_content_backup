      <layout-options>
        <title>
          <formatted-text>
            <run>Metrics Small Chart</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance_tableau_order_level (fp_hun_internal)' name='federated.0hlk9c108s4zcd11akq9117bbz54' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='City Name - Only Asc.' caption='Sort By' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;City Name&quot;'>
              <calculation class='tableau' formula='&quot;City Name&quot;' />
              <aliases>
                <alias key='&quot;City Name&quot;' value='City Name - Only Asc.' />
              </aliases>
            </column>
