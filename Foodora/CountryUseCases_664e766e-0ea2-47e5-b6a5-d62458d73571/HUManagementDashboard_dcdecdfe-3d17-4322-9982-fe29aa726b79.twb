    <worksheet name='comm_line'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Commercial   </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance_tableau_order_level (fp_hun_internal)' name='federated.0hlk9c108s4zcd11akq9117bbz54' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown parameter' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Hungary&quot;'>
              <calculation class='tableau' formula='&quot;Total Hungary&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hlk9c108s4zcd11akq9117bbz54'>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_900438471487909893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_failed_order_vendor] THEN [order_code] END)&#13;&#10;/ COUNTD(IF NOT [is_laas_order] THEN [order_code] END)' />
            </column>
            <column caption='% VFD Penetration' datatype='real' default-format='p0.0%' name='[% VFD AB Penetration (copy)_1510676233041424384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [vf_deal_total_local] &gt; 0 AND [is_valid_order] &#13;&#10;AND [vertical_type] = &quot;Restaurant&quot; THEN [vendor_code] END)/&#13;&#10;COUNTD(IF NOT ISNULL([order_code]) AND [is_valid_order]&#13;&#10;AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;THEN [vendor_code] END)' />
            </column>
            <column caption='% VFD Pro AB Penetration' datatype='real' default-format='p0.0%' name='[% VFD AB Penetration (copy)_900438471497928715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [vf_deal_total_local] &gt; 0&#13;&#10;    AND [is_valid_order]&#13;&#10;    AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;    AND ([sf_vendor_grade] = &quot;A&quot; OR [sf_vendor_grade] = &quot;B&quot;)&#13;&#10;    AND [is_subscription_discount]&#13;&#10;    THEN [vendor_code]&#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [is_valid_order]&#13;&#10;    AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;    AND ([sf_vendor_grade] = &quot;A&quot; OR [sf_vendor_grade] = &quot;B&quot;)&#13;&#10;    AND [is_subscription_discount]&#13;&#10;    THEN [vendor_code]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% VFD Joker / GMV' datatype='real' default-format='p0.00%' name='[% VFD Percentage / GMV (copy)_790381762695495684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] &#13;&#10;THEN [vf_deal_joker_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN gmv_local END)' />
            </column>
            <column caption='A/B GMV Class DLD &gt; 90%' datatype='real' default-format='p0.0%' name='[A/B SF Grade Vendors DLD &gt; 90% (copy)_763923143089061888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([num_of_descriptions] / [num_of_products]) &gt; 0.9&#13;&#10;AND ([gmv_class] = &quot;A&quot; OR [gmv_class] = &quot;B&quot;)&#13;&#10;AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;THEN [vendor_code]&#13;&#10;END) /&#13;&#10;COUNTD(IF ([gmv_class] = &quot;A&quot; OR [gmv_class] = &quot;B&quot;)&#13;&#10;AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;THEN [vendor_code]&#13;&#10;END)' />
            </column>
            <column caption='A/B GMV Class DLP &gt; 90%' datatype='real' default-format='p0.0%' name='[A/B SF Grade Vendors DLP &gt; 90% (copy)_763923143089270785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([num_of_images] / [num_of_products]) &gt; 0.9&#13;&#10;AND ([gmv_class] = &quot;A&quot; OR [gmv_class] = &quot;B&quot;)&#13;&#10;AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;THEN [vendor_code]&#13;&#10;END) /&#13;&#10;COUNTD(IF ([gmv_class] = &quot;A&quot; OR [gmv_class] = &quot;B&quot;)&#13;&#10;AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;THEN [vendor_code]&#13;&#10;END)' />
            </column>
            <column caption='breakdown_field' datatype='string' name='[Calculation_1224416154036039680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == &quot;Total Hungary&quot;&#13;&#10;THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities&quot;&#13;&#10;THEN [city_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Zones&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Cities&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [city_name]&#13;&#10;END' />
            </column>
            <column caption='% OD Orders Share' datatype='real' name='[Calculation_1226386527727788032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [hurrier_order_status] WHEN &quot;completed&quot;&#13;&#10;THEN [order_code] END) / (&#13;&#10;COUNTD(CASE [is_valid_order] WHEN TRUE THEN [order_code] END)&#13;&#10;+ COUNTD(IF [hurrier_order_status] = &quot;completed&quot; AND [is_laas_order]&#13;&#10;THEN [order_code] END))' />
            </column>
            <column caption='% Pickup Share' datatype='real' name='[Calculation_1226386527741440021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [is_valid_order] = TRUE AND [is_pickup] = TRUE THEN [order_code] END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [is_valid_order] = TRUE THEN [order_code] END&#13;&#10;)' />
            </column>
            <column caption='% PP GMV' datatype='real' default-format='p0.0%' name='[Calculation_138204246623809536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_pp] AND [is_valid_order] THEN [gmv_local] END)&#13;&#10;/&#13;&#10;SUM(IF [is_valid_order] THEN [gmv_local] END)' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1451566489713233920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([scheduled_open_seconds] - [total_closed_seconds])&#13;&#10;/&#13;&#10;SUM([scheduled_open_seconds])' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Calculation_678917692299829251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [was_active] THEN [vendor_code] END)' />
            </column>
            <column caption='New Restaurant Vendors' datatype='integer' name='[Calculation_678917692300189700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_new_online_restaurant] WHEN TRUE THEN [vendor_code] END)' />
            </column>
            <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] THEN [vf_deal_total_incl_voucher_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN [gmv_local] END)' />
            </column>
            <column caption='% CPC Vendor Penetration' datatype='real' default-format='p0.0%' name='[Calculation_790381762708983813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_cpc_vendor] THEN [vendor_code] END)&#13;&#10;/ COUNTD(IF [was_active] THEN [vendor_code] END)' />
            </column>
            <column caption='% OD Vendors Share' datatype='real' default-format='p0.0%' name='[Calculation_900438471484215296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [delivery_type] = &quot;OD&quot; AND [was_online]&#13;&#10;THEN [vendor_code] END) / COUNTD(IF [was_online] THEN [vendor_code] END)' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_failed_order] = TRUE THEN [order_code] END)&#13;&#10;/ COUNTD([order_code])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.00%' name='[Calculation_900438471492648968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_vendor_late_min]&gt; 10&#10;AND [hurrier_order_status] = &quot;completed&quot;&#13;&#10;AND [is_own_delivery] THEN [order_code] END)&#13;&#10;/ COUNTD(IF [hurrier_order_status] = &quot;completed&quot;&#13;&#10;AND [is_own_delivery] THEN [order_code] END)' />
            </column>
            <column caption='% VFD AB Penetration' datatype='real' default-format='p0.0%' name='[Calculation_900438471497416714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [vf_deal_total_local] &gt; 0&#13;&#10;    AND [is_valid_order]&#13;&#10;    AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;    AND ([gmv_class] = &quot;A&quot; OR [gmv_class] = &quot;B&quot;)&#13;&#10;    THEN [vendor_code]&#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(IF [vf_deal_total_local] &gt; 0&#13;&#10;    AND [is_valid_order]&#13;&#10;    AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;    THEN [vendor_code]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
