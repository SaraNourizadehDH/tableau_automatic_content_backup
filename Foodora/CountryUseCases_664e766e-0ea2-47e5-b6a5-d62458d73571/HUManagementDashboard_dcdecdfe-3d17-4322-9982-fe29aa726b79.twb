    <worksheet name='mkt_ptd_lp'>
      <layout-options>
        <title>
          <formatted-text>
            <run>YtD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance_tableau_order_level (fp_hun_internal)' name='federated.0hlk9c108s4zcd11akq9117bbz54' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Breakdown parameter' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Hungary&quot;'>
              <calculation class='tableau' formula='&quot;Total Hungary&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_2852326719360741382]' caption='Reporting Date' datatype='date' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hlk9c108s4zcd11akq9117bbz54'>
            <column caption='Valid Orders' datatype='integer' name='[Calculation_1000362122761048064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [is_valid_order] WHEN TRUE THEN [order_code] END)' />
            </column>
            <column caption='Acquisition' datatype='integer' name='[Calculation_1000362122761297921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_acquisition_order]&#13;&#10;AND [is_valid_order] THEN [order_code] END)' />
            </column>
            <column caption='breakdown_field' datatype='string' name='[Calculation_1224416154036039680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == &quot;Total Hungary&quot;&#13;&#10;THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities&quot;&#13;&#10;THEN [city_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Zones&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Cities&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [city_name]&#13;&#10;END' />
            </column>
            <column caption='GMV User Paid' datatype='real' name='[Calculation_1479995450891890688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [hurrier_order_status] = &quot;completed&quot;&#13;&#10;OR [is_valid_order] THEN [gmv_user_paid_local] END)' />
            </column>
            <column caption='Start of Reporting Period' datatype='datetime' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;END' />
            </column>
            <column caption='Last Data Date' datatype='datetime' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='PRO Orders %' datatype='real' default-format='p0.0%' name='[Calculation_638385247291756550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_valid_order] AND [is_subscription_order] THEN [order_code] END) / &#13;&#10;COUNTD(IF [is_valid_order] THEN [order_code] END)' />
            </column>
            <column caption='GMV Local Valid Orders' datatype='real' name='[Calculation_763923143099445251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [hurrier_order_status] = &quot;completed&quot;&#13;&#10;OR [is_valid_order] THEN [gmv_local] END)' />
            </column>
            <column caption='Dummy (copy)' datatype='real' datatype-customized='true' name='[Dummy (copy)_1188668875946811404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='PtD LP' datatype='boolean' name='[PtD LY (copy)_1649724888175493121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN ([date] &gt;= DATEADD(&quot;month&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;month&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Weekly&quot; THEN  ([date] &gt;= DATEADD(&quot;week&quot;,-1,[Calculation_236720498005807115]) AND  [date] &lt;= DATEADD(&quot;week&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;END' />
            </column>
            <column caption='PtD LP Title' datatype='string' name='[PtD LY Title (copy)_1649724888174682112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &quot;MtD LM&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WtD LW&quot;&#13;&#10;END' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;borota (teszt)&quot;' value='&quot;Jánoshalma&quot;' />
                <semantic-value key='&quot;Other&quot;' value='&quot;Budapest III. kerület&quot;' />
              </semantic-values>
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='datetime' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='GMV User Paid Estimates' datatype='integer' name='[gmv_estimates]' role='measure' type='quantitative' />
            <column caption='GMV Local' datatype='real' name='[gmv_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_user_paid_local]' role='measure' type='quantitative' />
            <column datatype='string' name='[hurrier_order_status]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_acquisition_order]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_subscription_order]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_valid_order]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1224416154036039680]' derivation='None' name='[none:Calculation_1224416154036039680:nk]' pivot='key' type='nominal' />
            <column-instance column='[PtD LY (copy)_1649724888175493121]' derivation='None' name='[none:PtD LY (copy)_1649724888175493121:nk]' pivot='key' type='nominal' />
