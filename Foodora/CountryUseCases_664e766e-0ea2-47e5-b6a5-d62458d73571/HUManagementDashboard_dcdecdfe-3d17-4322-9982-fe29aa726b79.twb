            <column caption='Sorting Fields' datatype='real' name='[Calculation_1348265199319326737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Combined Sort Field&#13;&#10;IF [Parameters].[Parameter 7] = &quot;Ascending&quot; THEN&#13;&#10;  CASE [Parameters].[Parameter 6]&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN [Calculation_1000362122761048064]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN [Calculation_1000362122761297921]&#13;&#10;    WHEN &quot;MAU&quot; THEN [Calculation_1348265199284862976]&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_638385247264137220]&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN [Calculation_678917692299829251]&#13;&#10;    WHEN &quot;OD Share&quot; THEN  [Calculation_1226386527727788032]&#13;&#10;    WHEN &quot;Seamless %&quot; THEN [Calculation_886646182733557768]&#13;&#10;    WHEN &quot;Avg DT&quot; THEN [Calculation_886646182736216076]&#13;&#10;    WHEN &quot;Order Late 10min %&quot; THEN [Calculation_886646182731751424]&#13;&#10;    WHEN &quot;Fail Rate %&quot; THEN [Calculation_900438471487643652]&#13;&#10;    WHEN &quot;AFV (HUF)&quot; THEN [Calculation_1282118579461185578]&#13;&#10;    WHEN &quot;VFD / GMV %&quot; THEN [Calculation_790381762694070273]&#13;&#10;    WHEN &quot;% Valid Orders by Pro Users&quot; THEN [Calculation_1279022355001327616]&#13;&#10;    WHEN &quot;Consumer Fees %&quot; THEN AVG([Calculation_1279022355005009924])&#13;&#10;    WHEN &quot;QC GMV %&quot; THEN [Calculation_1179380202026074148]&#13;&#10;  END&#13;&#10;ELSE&#13;&#10;  CASE [Parameters].[Parameter 6]&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN -[Calculation_1000362122761048064]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN -[Calculation_1000362122761297921]&#13;&#10;    WHEN &quot;MAU&quot; THEN -[Calculation_1348265199284862976]&#13;&#10;    WHEN &quot;Frequency&quot; THEN -[Calculation_638385247264137220]&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN -[Calculation_678917692299829251]&#13;&#10;    WHEN &quot;OD Share&quot; THEN -[Calculation_1226386527727788032]&#13;&#10;    WHEN &quot;Seamless %&quot; THEN -[Calculation_886646182733557768]&#13;&#10;    WHEN &quot;Avg DT&quot; THEN -[Calculation_886646182736216076]&#13;&#10;    WHEN &quot;Order Late 10min %&quot; THEN -[Calculation_886646182731751424]&#13;&#10;    WHEN &quot;Fail Rate %&quot; THEN -[Calculation_900438471487643652]&#13;&#10;    WHEN &quot;AFV (HUF)&quot; THEN -[Calculation_1282118579461185578]&#13;&#10;    WHEN &quot;VFD / GMV %&quot; THEN -[Calculation_790381762694070273]&#13;&#10;    WHEN &quot;% Valid Orders by Pro Users&quot; THEN -[Calculation_1279022355001327616]&#13;&#10;    WHEN &quot;Consumer Fees %&quot; THEN -AVG([Calculation_1279022355005009924])&#13;&#10;    WHEN &quot;QC GMV %&quot; THEN -[Calculation_1179380202026074148]&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='= Report month' datatype='boolean' name='[Calculation_52072871511171077]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1073264146391670795] = [Parameters].[report_month Parameter]' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_638385247264137220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_valid_order] THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] THEN [customer_code] END)' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Calculation_678917692299829251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [was_active] THEN [vendor_code] END)' />
            </column>
            <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] THEN [vf_deal_total_incl_voucher_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN [gmv_local] END)' />
            </column>
            <column caption='current_month' datatype='date' name='[Calculation_8673088464385294358]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&quot;month&quot;, TODAY() - 1 ))' />
            </column>
            <column caption='% Delay &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_886646182731751424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [delivery_status] = &quot;Late&quot;&#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% Seamless' datatype='real' default-format='p0.0%' name='[Calculation_886646182733557768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_seamless_order] &#13;&#10;AND [hurrier_order_status] = &quot;completed&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] END)' />
            </column>
            <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_886646182736216076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF NOT [is_preorder] AND [is_own_delivery] THEN &#13;&#10;[actual_delivery_time_min] END) / COUNTD(IF NOT [is_preorder] AND [is_own_delivery] THEN [order_code] END)' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_failed_order] = TRUE THEN [order_code] END)&#13;&#10;/ COUNTD([order_code])' />
            </column>
            <column datatype='real' name='[actual_delivery_time_min]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1279022355005009924]' derivation='Avg' name='[avg:Calculation_1279022355005009924:qk]' pivot='key' type='quantitative' />
