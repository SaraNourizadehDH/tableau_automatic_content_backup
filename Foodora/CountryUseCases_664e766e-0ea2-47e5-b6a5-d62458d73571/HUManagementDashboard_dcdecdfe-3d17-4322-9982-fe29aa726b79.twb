    <worksheet name='mkt_targets'>
      <layout-options>
        <title>
          <formatted-text>
            <run>YtD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance_tableau_order_level (fp_hun_internal)' name='federated.0hlk9c108s4zcd11akq9117bbz54' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Breakdown parameter' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Hungary&quot;'>
              <calculation class='tableau' formula='&quot;Total Hungary&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_2852326719360741382]' caption='Reporting Date' datatype='date' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hlk9c108s4zcd11akq9117bbz54'>
            <column caption='Days in Reporting Period to Date' datatype='real' name='[Calculation_1188668875949379604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Reporting Month (copy)_52072871788789788] - [Calculation_236720498005807115] +1' />
            </column>
            <column caption='End of Reporting Period' datatype='datetime' name='[Calculation_1188668875950088213]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788]))-1&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)+6&#13;&#10;END' />
            </column>
            <column caption='PtD for targets' datatype='real' name='[Calculation_1188668875951497240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1188668875949379604]/[Days in Reporting Period to Date (copy)_1188668875950419990]) * CASE [Parameters].[Parameter 1] WHEN &apos;Monthly&apos; THEN 1 WHEN &apos;Weekly&apos; THEN 7/[Days in Reporting Period Total (copy)_1188668875951071255] END' />
            </column>
            <column caption='breakdown_field' datatype='string' name='[Calculation_1224416154036039680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == &quot;Total Hungary&quot;&#13;&#10;THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities&quot;&#13;&#10;THEN [city_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Zones&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Cities&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [city_name]&#13;&#10;END' />
            </column>
            <column caption='Only Monthly' datatype='boolean' name='[Calculation_1266355938977746945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN TRUE&#13;&#10;ELSE FALSE END' />
            </column>
            <column caption='Acquisition Target' datatype='real' name='[Calculation_1266355939005812745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-01&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-02&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-03&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-04&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-05&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-06&apos; AND [city_name] = &quot;Total HU&quot;, 33000, NULL))))))&#13;&#10;)' />
            </column>
            <column caption='PtD' datatype='boolean' name='[Calculation_236720498005434378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([date] &gt;= [Calculation_236720498005807115] AND [date]&lt;= [Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Start of Reporting Period' datatype='datetime' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;END' />
            </column>
            <column caption='Last Data Date' datatype='datetime' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Days in Reporting Month' datatype='real' name='[Days in Reporting Period Total (copy)_1188668875951071255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])) - DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Days in Reporting Period Total' datatype='real' name='[Days in Reporting Period to Date (copy)_1188668875950419990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1188668875950088213] - [Calculation_236720498005807115] + 1' />
            </column>
            <column caption='Dummy (copy) (copy) (copy) (copy) (copy) (copy 2)' datatype='real' datatype-customized='true' name='[Dummy (copy) (copy) (copy) (copy) (copy) (copy 2)_1179380202003066887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Dummy (copy) (copy) (copy) (copy) (copy) (copy)' datatype='real' datatype-customized='true' name='[Dummy (copy) (copy) (copy) (copy) (copy) (copy)_1188668875948085267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Dummy (copy) (copy) (copy) (copy)' datatype='real' datatype-customized='true' name='[Dummy (copy) (copy) (copy) (copy)_1188668875947716624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='GMV Target' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[GMV (copy)_1649724888191070214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1188668875951497240] * &#13;&#10;AVG(IF [city_name] = &apos;Total CZ&apos; THEN&#13;&#10;        CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;        WHEN &apos;2024-01&apos; THEN 24.8 * 19111434&#13;&#10;        WHEN &apos;2024-02&apos; THEN 24.8 * 17522334&#13;&#10;        WHEN &apos;2024-03&apos; THEN 24.8 * 19529372&#13;&#10;        WHEN &apos;2024-04&apos; THEN 24.8 * 19415700&#13;&#10;        WHEN &apos;2024-05&apos; THEN 24.8 * 20584856&#13;&#10;        WHEN &apos;2024-06&apos; THEN 24.8 * 18291957&#13;&#10;        END&#13;&#10;    END)' />
            </column>
            <column caption='Target PtD Title ' datatype='string' name='[PtD LY Title (copy)_1188668875943636999]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN &quot;Target MtD&quot;&#13;&#10;    WHEN &quot;Weekly&quot; THEN &quot;Target WtD&quot;&#13;&#10;END' />
            </column>
            <column aggregation='Avg' caption='Target Orders Per Capita' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Target Orders (copy)_1188668875944505352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//0.01 * [PtD for targets]&#13;&#10;FLOAT(NULL)' />
            </column>
            <column-instance column='[Calculation_1188668875949379604]' derivation='Attribute' name='[attr:Calculation_1188668875949379604:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Days in Reporting Period Total (copy)_1188668875951071255]' derivation='Attribute' name='[attr:Days in Reporting Period Total (copy)_1188668875951071255:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Days in Reporting Period to Date (copy)_1188668875950419990]' derivation='Attribute' name='[attr:Days in Reporting Period to Date (copy)_1188668875950419990:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Target Orders (copy)_1188668875944505352]' derivation='Avg' name='[avg:Target Orders (copy)_1188668875944505352:qk]' pivot='key' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;borota (teszt)&quot;' value='&quot;Jánoshalma&quot;' />
                <semantic-value key='&quot;Other&quot;' value='&quot;Budapest III. kerület&quot;' />
              </semantic-values>
            </column>
