    </worksheet>
    <worksheet name='qc_period'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Metrics Small Chart</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance_tableau_order_level (fp_hun_internal)' name='federated.0hlk9c108s4zcd11akq9117bbz54' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Periods' datatype='integer' name='[Monthly / Weekly (copy)]' param-domain-type='list' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column caption='Monthly / Weekly' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Breakdown parameter' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Hungary&quot;'>
              <calculation class='tableau' formula='&quot;Total Hungary&quot;' />
            </column>
            <column caption='Par - Meas Name' datatype='string' name='[Parameter 5]' param-domain-type='any' role='measure' type='nominal' value='&quot;\% VFD AB Penetration&quot;'>
              <calculation class='tableau' formula='&quot;% VFD AB Penetration&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_2852326719360741382]' caption='Reporting Date' datatype='date' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hlk9c108s4zcd11akq9117bbz54'>
            <column caption='% Shrinkage (on GMV net)' datatype='real' default-format='p0.00%' name='[Calculation_1008243384065015808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [shrink_value_local] END)&#13;&#10;/ &#13;&#10;sum(IF [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [dmart_turnover_net_local] END)' />
            </column>
            <column caption='% QComm GMV Share' datatype='real' default-format='p0.00%' name='[Calculation_1179380202026074148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical_type] != &quot;Restaurant&quot; AND [is_sent_order]&#13;&#10;THEN [gmv_local] END) /&#13;&#10;SUM(IF [is_valid_order] THEN [gmv_local] END)' />
            </column>
            <column caption='breakdown_field' datatype='string' name='[Calculation_1224416154036039680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == &quot;Total Hungary&quot;&#13;&#10;THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities&quot;&#13;&#10;THEN [city_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Zones&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Cities&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [city_name]&#13;&#10;END' />
            </column>
            <column caption='% Dmart Products Availability' datatype='real' default-format='p0.0%' name='[Calculation_1241586139373264896 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_products_available_records])&#13;&#10;/ &#13;&#10;SUM([dmart_products_records])' />
            </column>
            <column caption='Dmart Front Margin' datatype='real' default-format='p0.0%' name='[Calculation_1285496234311487491 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN ([dmart_turnover_net_local] - [dmart_cogs_local]) END)&#13;&#10;/ SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [dmart_turnover_net_local] END)' />
            </column>
            <column caption='Dmart ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1285496234311737348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [dmart_turnover_local] END)&#13;&#10;/&#13;&#10;COUNTD(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [order_code] END)' />
            </column>
            <column caption='Shop ABV' datatype='real' name='[Calculation_1286059199085756416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [shop_turnover_local] END)&#13;&#10;/&#13;&#10;COUNTD(IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)' />
            </column>
            <column caption='% Shops Partial Orders' datatype='real' name='[Calculation_1362057464707608576 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_sent_order] AND qty_ordered &gt; qty_delivered&#13;&#10;AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/&#13;&#10;COUNTD(IF [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)' />
            </column>
            <column caption='Meas - Descriptions' datatype='string' name='[Calculation_1386545782726303748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;    WHEN &quot;% OD Orders Share&quot; THEN &quot;Percentage of Completed OD (incl. Laas) Orders out of Total Valid Orders&quot;&#13;&#10;    WHEN &quot;% OD Vendors Share&quot; THEN &quot;Percentage of OD Online Vendors (incl. Laas) out of Total Online Vendors&quot;&#13;&#10;    WHEN &quot;Orders per A Grade Vendors&quot; THEN &quot;Number of valid orders per A Grade Vendor&quot;&#13;&#10;    WHEN &quot;Orders per B Grade Vendors&quot; THEN &quot;Number of valid orders per B Grade Vendor&quot;&#13;&#10;    WHEN &quot;Orders per A GMV Class Vendors&quot; THEN &quot;Number of valid orders per A GMV Class Vendor&quot;&#13;&#10;    WHEN &quot;Orders per B GMV Class Vendors&quot; THEN &quot;Number of valid orders per B GMV CLass Vendor&quot;&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN &quot;Number of vendors with at least 1 valid order&quot;&#13;&#10;    WHEN &quot;New Restaurant Vendors&quot; THEN &quot;Number of new restaurants (activation date)&quot;&#13;&#10;    WHEN &quot;% Pickup Share&quot; THEN &quot;Valid pickup orders share across valid orders&quot;&#13;&#10;    WHEN &quot;% Fail Rate&quot; THEN &quot;Failed OD + VD (incl. Laas) orders share of Total Gross orders&quot;&#13;&#10;    WHEN &quot;% Vendor Fail Rate&quot; THEN &quot;Failed (by vendor) OD + VD (excl. Laas) orders share of Total Gross orders&quot;&#13;&#10;    WHEN &quot;% Vendor Late &gt; 10&quot; THEN &quot;Vendor late (&gt; 10 min) OD (incl. Laas) orders of Total Completed OD orders&quot;&#13;&#10;    WHEN &quot;% VFD / GMV&quot; THEN &quot;Total VFD Value per Restaurant&apos;s GMV (at valid orders)&quot;&#13;&#10;    WHEN &quot;% VFD Free Gift/GMV&quot; THEN &quot;VFD Free Gift / Restaurant&apos;s GMV&quot;&#13;&#10;    WHEN &quot;% VFD Joker/GMV&quot; THEN &quot;VFD Joker Deal / Restaurant&apos;s GMV (at valid orders)&quot;&#13;&#10;    WHEN &quot;% VFD Penetration&quot; THEN &quot;Percent of VFD Vendors of Active vendors&quot;&#13;&#10;    WHEN &quot;% VFD AB Penetration&quot; THEN &quot;Percent of VFD A-B vendors of Total VFD vendors (based on GMV Class)&quot;&#13;&#10;    WHEN &quot;% VFD Pro AB Penetration&quot; THEN &quot;Percent of Pro VFD A-B vendors of Total A-B vendors&quot;&#13;&#10;    WHEN &quot;A/B Vendors SF Grade DLP&gt;90%&quot; THEN &quot;Percent of DLP &gt; 90% A-B (based on sf_grade) vendors of Total A-B vendors&quot;&#13;&#10;    WHEN &quot;A/B Vendors SF Grade DLD&gt;90%&quot; THEN &quot;Percent of DLD &gt; 90% A-B (based on sf_grade) vendors of Total A-B vendors&quot;&#13;&#10;    WHEN &quot;GAP Signed&quot; THEN &quot;Number of signed Wolt GAP vendors&quot;&#13;&#10;    WHEN &quot;Dreambrand Signed&quot; THEN &quot;Number of signed Dreambrand vendors&quot;&#13;&#10;    WHEN &quot;% CPC Vendor Penetration&quot; THEN &quot;Percent of CPC vendors of Total Active vendors&quot;&#13;&#10;    WHEN &quot;% PP GMV&quot; THEN &quot;Percent of PP vendor&apos;s GMV (Valid orders) of Total GMV&quot;&#13;&#10;    WHEN &quot;% Uptime&quot; THEN &quot;Percent of all active vendor&apos;s uptime&quot;&#13;&#10;    WHEN &quot;Completed OD Orders&quot; THEN &quot;Completed OD (incl. Laas) orders&quot;&#13;&#10;    WHEN &quot;UTR&quot; THEN &quot;Completed OD (incl. Laas) orders / Total Evaluated Hours&quot;&#13;&#10;    WHEN &quot;Avg DT&quot; THEN &quot;Avg DT per non-preorder Completed OD orders&quot;&#13;&#10;    WHEN &quot;% Seamless&quot; THEN &quot;The percentage of Completed OD Orders where the order was seamless&quot;&#13;&#10;    WHEN &quot;% Delay &gt; 10&quot; THEN &quot;The percentage of Completed OD orders with 10 min late&quot;&#13;&#10;    WHEN &quot;% Delay &gt; 20&quot; THEN &quot;The percentage of Completed OD orders with 20 min late&quot;&#13;&#10;    WHEN &quot;% Delay &gt; 60&quot; THEN &quot;The percentage of Completed OD orders with 60 min late&quot;&#13;&#10;    WHEN &quot;% Early orders &gt; 10&quot; THEN &quot;The percentage of Completed OD orders with 10 min early&quot;&#13;&#10;    WHEN &quot;% Fill Rate&quot; THEN &quot;Fill rate of slots&quot;&#13;&#10;    WHEN &quot;Rider Rating&quot; THEN &quot;Avg rider rating per order&quot;&#13;&#10;    WHEN &quot;% Car Share&quot; THEN &quot;The percentage of completed Car deliveries (OD)&quot;&#13;&#10;    WHEN &quot;% Bike Share&quot; THEN &quot;The percentage of completed Bike deliveries (OD)&quot;&#13;&#10;    WHEN &quot;% Scooter Share&quot; THEN &quot;The percentage of completed Scooter deliveries (OD)&quot;&#13;&#10;    WHEN &quot;% Cancellation&quot; THEN &quot;Percentage of Cancelled OD orders&quot;&#13;&#10;    WHEN &quot;CPO Local&quot; THEN &quot;Cost per OD order (HUF) (Order with rooster payment)&quot;&#13;&#10;    WHEN &quot;Avg DF (OD)&quot; THEN &quot;Avg DF (HUF) per Completed OD order&quot;&#13;&#10;    WHEN &quot;% Priority Orders&quot; THEN &quot;Percentage of Priority OD orders&quot;&#13;&#10;    WHEN &quot;% Close Weighted&quot; THEN &quot;Percentage of Close&quot;&#13;&#10;    WHEN &quot;% Shrinkage Weighted&quot; THEN &quot;Percentage of Shrinkage&quot;&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN &quot;Valid OD + VD (excl. Laas) Orders&quot;&#13;&#10;    WHEN &quot;GMV Local Valid Orders&quot; THEN &quot;Sum of Completed or Valid OD + VD (incl. Laas) Order&apos;s GMV (HUF)&quot;&#13;&#10;    WHEN &quot;Acquisition&quot; THEN &quot;Number of Valid Acquisition OD + VD (excl. Laas) Order&quot;&#13;&#10;    WHEN &quot;PRO Orders %&quot; THEN &quot;Percentage of PRO Valid OD + VD (excl. Laas) Orders&quot;&#13;&#10;    WHEN &quot;% QComm GMV Share&quot; THEN &quot;Percentage of sent QComm Orders from All Valid Orders GMV&quot;&#13;&#10;    WHEN &quot;% Qcomm Vendor Late &gt; 10m&quot; THEN &quot;Percentage of vendor late &gt; 10m sent orders&quot;&#13;&#10;    WHEN &quot;Dmart Orders&quot; THEN &quot;Sent Dmart Orders&quot;&#13;&#10;    WHEN &quot;% Subscription Orders for Dmart&quot; THEN &quot;Percentage of Valid Dmart Subscription Orders (from All Valid Subscription Orders)&quot;&#13;&#10;    WHEN &quot;Dmart GMV Local&quot; THEN &quot;Sent Dmart Orders GMV Local (huf)&quot;&#13;&#10;    WHEN &quot;Dmart ABV&quot; THEN &quot;Sent Dmart Order&apos;s Turnover Local per Sent Dmart Orders&quot;&#13;&#10;    WHEN &quot;Dmart Acquisition&quot; THEN &quot;Sent Acquisition Dmart Orders&quot;&#13;&#10;    WHEN &quot;Dmart Front Margin&quot; THEN &quot;Sum of Sent Dmart Orders (Turnover Net - Cogs) per Sum of Sent Dmart Turnover Net&quot;&#13;&#10;    WHEN &quot;% Shrinkage (on GMV net)&quot; THEN &quot;Sum of Dmart Shrinkage Value / Sum Dmart Turnover Net&quot;&#13;&#10;    WHEN &quot;% Dmart Vendor Late &gt; 10&quot; THEN &quot;Percentage of Sent Dmart Vendor Late (&gt;10min) orders&quot;&#13;&#10;    WHEN &quot;% Dmart Products Availability&quot; THEN &quot;Dmart Products Availability&quot;&#13;&#10;    WHEN &quot;Shop Orders&quot; THEN &quot;Sent Shop Orders&quot;&#13;&#10;    WHEN &quot;% Subscription Orders for Shop&quot; THEN &quot;Percentage of Valid Shop Subscription Orders (from All Valid Subscription Orders)&quot;&#13;&#10;    WHEN &quot;Shop GMV Local&quot; THEN &quot;Sent Shop Orders GMV (huf)&quot;&#13;&#10;    WHEN &quot;Shop ABV&quot; THEN &quot;Sent Shop Order&apos;s Turnover Local per Sent Shop Orders&quot;&#13;&#10;    WHEN &quot;Shop Acquisition&quot; THEN &quot;Sent Shop Acquisition Orders&quot;&#13;&#10;    WHEN &quot;% Shops Partial Orders&quot; THEN &quot;Percentage of Shop Orders with qty_delivered &lt; qty_ordered&quot;&#13;&#10;    WHEN &quot;% Shop Vendor Late &gt; 10&quot; THEN  &quot;Percentage of Sent Shop Vendor Late (&gt;10min) orders&quot;&#13;&#10;    WHEN &quot;% Shops Fail Rate&quot; THEN &quot;Percentage of Not Sent Shop Orders&quot;&#13;&#10;    WHEN &quot;% Shops Commission&quot; THEN &quot;Sum of Sent Shop Orders Commission / SUM (If OD then Shop Turnover, IF VD Then GMV Local)&quot;&#13;&#10;    WHEN &quot;Valid Order Estimates&quot; THEN &quot;Monthly Estimates for Total Hungary Valid Orders by Finance Team&quot;&#13;&#10;    WHEN &quot;GMV User Paid Estimates&quot; THEN &quot;Monthly Estimates for Total Hungary GMV User Paid by Finance Team&quot;&#13;&#10;    WHEN &quot;GMV User Paid&quot; THEN &quot;GMV User Paid at Valid Orders&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Is Last Period' datatype='boolean' name='[Calculation_1649724888182579203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_236720497991634944] = [Calculation_236720498005807115]' />
            </column>
            <column caption='Period Date' datatype='date' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_236720497991634944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;END)' />
            </column>
            <column caption='Start of Reporting Period' datatype='datetime' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;END' />
            </column>
            <column caption='Last Data Date' datatype='datetime' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='% Qcomm Vendor Late &gt; 10m' datatype='real' name='[Calculation_497929264936513547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_vendor_late_min]&gt; 10&#13;&#10;AND [is_sent_order]&#13;&#10;AND [vertical_type] != &quot;Restaurant&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;&#13;&#10;/ COUNTD(IF [is_sent_order]&#13;&#10;AND [vertical_type] != &quot;Restaurant&quot;&#13;&#10;THEN [order_code] END)' />
            </column>
            <column caption='% Subscription Orders for Dmart' datatype='real' name='[Calculation_497929264937807887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;AND [vertical_segment] = &quot;Dmart&quot; THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;THEN [order_code] END)' />
            </column>
            <column caption='% Subscription Orders for Shop' datatype='real' name='[Calculation_497929264947638295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;AND [vertical_segment] = &quot;Shop&quot; THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;THEN [order_code] END)' />
            </column>
            <column caption='% Shops Fail Rate' datatype='real' name='[Calculation_497929264949420064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF NOT [is_sent_order] AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [vertical_segment] = &quot;Shop&quot; THEN order_code END)' />
            </column>
            <column caption='% Shops Commission' datatype='real' name='[Calculation_497929264952426532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;  IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot; &#13;&#10;THEN [shop_commission_local] END&#13;&#10;) / &#13;&#10;SUM(&#13;&#10;  IF [vertical_segment] = &quot;Shop&quot; THEN&#13;&#10;    IF [delivery_type] = &quot;OD&quot; THEN [shop_turnover_local]&#13;&#10;    ELSE [gmv_local] END&#13;&#10;  END&#13;&#10;)' />
            </column>
            <column caption='Dmart Orders' datatype='integer' name='[Calculation_894809008283504641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot; THEN [order_code] END)' />
            </column>
            <column caption='Dmart GMV Local' datatype='real' name='[Calculation_894809008283971586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot; THEN [gmv_local] END)' />
            </column>
            <column caption='Dmart Acquisition' datatype='integer' name='[Calculation_894809008284393475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_acquisition_darkstore] AND [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Dmart&quot; THEN [order_code] END)' />
            </column>
            <column caption='Shop Orders' datatype='integer' name='[Calculation_894809008284897284]' role='measure' type='quantitative'>
