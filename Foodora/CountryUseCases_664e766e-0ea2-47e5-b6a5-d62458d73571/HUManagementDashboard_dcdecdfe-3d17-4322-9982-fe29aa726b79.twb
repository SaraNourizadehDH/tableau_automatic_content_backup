      <column caption='Days in Reporting Period to Date' datatype='real' name='[Calculation_1188668875949379604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Reporting Month (copy)_52072871788789788] - [Calculation_236720498005807115] +1' />
      </column>
      <column caption='End of Reporting Period' datatype='datetime' name='[Calculation_1188668875950088213]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788]))-1&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)+6&#13;&#10;END' />
      </column>
      <column caption='PtD for targets' datatype='real' name='[Calculation_1188668875951497240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1188668875949379604]/[Days in Reporting Period to Date (copy)_1188668875950419990]) * CASE [Parameters].[Parameter 1] WHEN &apos;Monthly&apos; THEN 1 WHEN &apos;Weekly&apos; THEN 7/[Days in Reporting Period Total (copy)_1188668875951071255] END' />
      </column>
      <column caption='TEST FILTER APAFEJ' datatype='boolean' name='[Calculation_1214564585507864578]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() != 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show Hide MoM YoY' datatype='string' name='[Calculation_1214564585514401797]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF LAST() &gt; 2 then &quot;Hide&quot; ELSE &quot;Show&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='breakdown_field' datatype='string' name='[Calculation_1224416154036039680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == &quot;Total Hungary&quot;&#13;&#10;THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities&quot;&#13;&#10;THEN [city_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Zones&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Cities&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [city_name]&#13;&#10;END' />
      </column>
      <column caption='% OD Orders Share' datatype='real' name='[Calculation_1226386527727788032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [hurrier_order_status] WHEN &quot;completed&quot;&#13;&#10;THEN [order_code] END) / (&#13;&#10;COUNTD(CASE [is_valid_order] WHEN TRUE THEN [order_code] END)&#13;&#10;+ COUNTD(IF [hurrier_order_status] = &quot;completed&quot; AND [is_laas_order]&#13;&#10;THEN [order_code] END))' />
      </column>
      <column caption='% Pickup Share' datatype='real' name='[Calculation_1226386527741440021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [is_valid_order] = TRUE AND [is_pickup] = TRUE THEN [order_code] END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [is_valid_order] = TRUE THEN [order_code] END&#13;&#10;)' />
      </column>
      <column caption='PtD YoY Title' datatype='string' name='[Calculation_1231734538927296515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &apos;MtD YoY&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &apos;WtD YoY&apos;&#13;&#10;END' />
      </column>
      <column caption='% Dmart Products Availability' datatype='real' default-format='p0.0%' name='[Calculation_1241586139373264896 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_products_available_records])&#13;&#10;/ &#13;&#10;SUM([dmart_products_records])' />
      </column>
      <column caption='Period Date All' datatype='date' name='[Calculation_1265230039457140736]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;ELSE [date]&#13;&#10;END)' />
      </column>
      <column caption='Only Monthly' datatype='boolean' name='[Calculation_1266355938977746945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN TRUE&#13;&#10;ELSE FALSE END' />
      </column>
      <column caption='% OD Share vs. Target' datatype='real' name='[Calculation_1266355938987802626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1226386527727788032]/[% OD Order Share (copy)_1179380202000723968] -1' />
      </column>
      <column caption='% Seamless Target' datatype='real' name='[Calculation_1266355938998386692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.71&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.71&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.72&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.77&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.78&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.79&#13;&#10;END)' />
      </column>
      <column caption='% Pick Up Share Target' datatype='real' name='[Calculation_1266355938999656453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.004&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.005&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.006&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.007&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.008&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.001&#13;&#10;END)' />
      </column>
      <column caption='% Pick Up Share vs. Target' datatype='real' name='[Calculation_1266355938999967750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1226386527741440021]/[Calculation_1266355938999656453]-1' />
      </column>
      <column caption='% Seamless vs. Target' datatype='real' name='[Calculation_1266355939001438215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_886646182733557768]/[Calculation_1266355938998386692]-1' />
      </column>
      <column caption='Acquisition Target' datatype='real' name='[Calculation_1266355939005812745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-01&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-02&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-03&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-04&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-05&apos; AND [city_name] = &quot;Total HU&quot;, 33000,&#13;&#10;    IIF(LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]), 7) = &apos;2024-06&apos; AND [city_name] = &quot;Total HU&quot;, 33000, NULL))))))&#13;&#10;)' />
      </column>
      <column caption='% Shrinkage Target' datatype='real' name='[Calculation_1266355939029630989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.033&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.033&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.032&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.032&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.031&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.032&#13;&#10;END)' />
      </column>
      <column caption='% Shrinkage vs. Target' datatype='real' name='[Calculation_1266355939030302734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008243384065015808]/[Calculation_1266355939029630989]-1' />
      </column>
      <column caption='% Orders By Pro Users' datatype='real' name='[Calculation_1279022355001327616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_valid_order] &#13;&#10;AND [is_subscriber_customer] THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] THEN [order_code] END)' />
      </column>
      <column caption='% Orders By Pro Users LP' datatype='real' name='[Calculation_1279022355003133954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [is_valid_order] &#13;&#10;AND [is_subscriber_customer] THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] THEN [order_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Consumer Fees' datatype='real' name='[Calculation_1279022355004809219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [is_valid_order]&#13;&#10;THEN [delivery_fee_local] + [delivery_fee_local] END)&#13;&#10;/ [Calculation_1282118579461185578]' />
      </column>
      <column caption='% CF / AFV' datatype='real' name='[Calculation_1279022355005009924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([delivery_fee_local] + [service_fee_plus_vat_local]) / { FIXED [city_name], [Calculation_1073264146391670795] : SUM(IF [is_valid_order] THEN [gfv_local] END) / COUNTD(IF [is_valid_order] THEN [order_code] END) }' />
      </column>
      <column caption='% QComm GMV Share LP' datatype='real' name='[Calculation_1279022355007434758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM(IF [vertical_type] != &quot;Restaurant&quot; AND [is_sent_order]&#13;&#10;THEN [gmv_local] END) /&#13;&#10;SUM(IF [is_valid_order] THEN [gmv_local] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY LP' datatype='boolean' name='[Calculation_1282118579399614465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([Parameters].[report_month Parameter]) = MONTH(TODAY()) &#13;&#10;AND YEAR([Parameters].[report_month Parameter]) = YEAR(TODAY()) THEN&#13;&#10;    [date] &gt;= DATEADD(&quot;year&quot;, -1, [Parameters].[report_month Parameter])&#13;&#10;    AND [date] &lt;= DATEADD(&quot;year&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSE&#13;&#10;    [date] &gt;= DATEADD(&quot;year&quot;, -1, [Parameters].[report_month Parameter])&#13;&#10;    AND [date] &lt;= DATEADD(&quot;year&quot;, -1, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, [Parameters].[report_month Parameter])))&#13;&#10;END' />
      </column>
      <column caption='YoYTD Or YoY' datatype='boolean' name='[Calculation_1282118579400351746]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1073264146420236304] OR [Calculation_1282118579399614465]' />
      </column>
      <column caption='Seamless LP' datatype='real' name='[Calculation_1282118579437961244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [is_seamless_order] &#13;&#10;AND [hurrier_order_status] = &quot;completed&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Valid Orders LP' datatype='integer' name='[Calculation_1282118579438223389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [is_valid_order] THEN [order_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Acquisition LP' datatype='integer' name='[Calculation_1282118579438432286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [is_valid_order] AND [is_acquisition_order] THEN &#13;&#10;[order_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Active Vendors LP' datatype='integer' name='[Calculation_1282118579438624799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [was_active] THEN vendor_code END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='OD Share LP' datatype='real' name='[Calculation_1282118579438817312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(&#13;&#10;COUNTD(CASE [hurrier_order_status] WHEN &quot;completed&quot;&#13;&#10;THEN [order_code] END) / (&#13;&#10;COUNTD(CASE [is_valid_order] WHEN TRUE THEN [order_code] END)&#13;&#10;+ COUNTD(IF [hurrier_order_status] = &quot;completed&quot; AND [is_laas_order]&#13;&#10;THEN [order_code] END)), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg DT LP' datatype='real' name='[Calculation_1282118579447861285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(sum(IF NOT [is_preorder] AND [is_own_delivery] THEN &#13;&#10;[actual_delivery_time_min] END) / COUNTD(IF NOT [is_preorder] AND [is_own_delivery] THEN [order_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Delay &gt; 10 LP' datatype='real' name='[Calculation_1282118579450085415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(&#13;&#10;    IF [delivery_status] = &quot;Late&quot;&#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Fail Rate LP' datatype='real' name='[Calculation_1282118579460259881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [is_failed_order] = TRUE THEN [order_code] END)&#13;&#10;/ COUNTD([order_code]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1282118579461185578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_valid_order] THEN [gfv_local] END)&#13;&#10;/ COUNTD(IF [is_valid_order] THEN [order_code] END)' />
      </column>
      <column caption='AFV LP' datatype='real' name='[Calculation_1282118579461947436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM(IF [is_valid_order] THEN [gfv_local] END)&#13;&#10;/ COUNTD(IF [is_valid_order] THEN [order_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% VFD / GMV LP' datatype='real' name='[Calculation_1282118579465469997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] THEN [vf_deal_total_incl_voucher_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN [gmv_local] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dmart Front Margin' datatype='real' default-format='p0.0%' name='[Calculation_1285496234311487491 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN ([dmart_turnover_net_local] - [dmart_cogs_local]) END)&#13;&#10;/ SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [dmart_turnover_net_local] END)' />
      </column>
      <column caption='Dmart ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1285496234311737348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [dmart_turnover_local] END)&#13;&#10;/&#13;&#10;COUNTD(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='Shop ABV' datatype='real' name='[Calculation_1286059199085756416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [shop_turnover_local] END)&#13;&#10;/&#13;&#10;COUNTD(IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='MAU' datatype='integer' name='[Calculation_1348265199284862976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_valid_order] THEN [customer_code] END)' />
      </column>
      <column caption='MAU LP' datatype='integer' name='[Calculation_1348265199285293058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [is_valid_order] THEN [customer_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency LP' datatype='real' name='[Calculation_1348265199287836677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(COUNTD(IF [is_valid_order] THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] THEN [customer_code] END), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% CF / AFV LP' datatype='real' name='[Calculation_1348265199294238731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(AVG(([delivery_fee_local] + [service_fee_plus_vat_local]) / { FIXED [city_name], [Calculation_1073264146391670795] : SUM(IF [is_valid_order] THEN [gfv_local] END) / COUNTD(IF [is_valid_order] THEN [order_code] END) }), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sorting Fields' datatype='real' name='[Calculation_1348265199319326737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Combined Sort Field&#13;&#10;IF [Parameters].[Parameter 7] = &quot;Ascending&quot; THEN&#13;&#10;  CASE [Parameters].[Parameter 6]&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN [Calculation_1000362122761048064]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN [Calculation_1000362122761297921]&#13;&#10;    WHEN &quot;MAU&quot; THEN [Calculation_1348265199284862976]&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_638385247264137220]&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN [Calculation_678917692299829251]&#13;&#10;    WHEN &quot;OD Share&quot; THEN  [Calculation_1226386527727788032]&#13;&#10;    WHEN &quot;Seamless %&quot; THEN [Calculation_886646182733557768]&#13;&#10;    WHEN &quot;Avg DT&quot; THEN [Calculation_886646182736216076]&#13;&#10;    WHEN &quot;Order Late 10min %&quot; THEN [Calculation_886646182731751424]&#13;&#10;    WHEN &quot;Fail Rate %&quot; THEN [Calculation_900438471487643652]&#13;&#10;    WHEN &quot;AFV (HUF)&quot; THEN [Calculation_1282118579461185578]&#13;&#10;    WHEN &quot;VFD / GMV %&quot; THEN [Calculation_790381762694070273]&#13;&#10;    WHEN &quot;% Valid Orders by Pro Users&quot; THEN [Calculation_1279022355001327616]&#13;&#10;    WHEN &quot;Consumer Fees %&quot; THEN AVG([Calculation_1279022355005009924])&#13;&#10;    WHEN &quot;QC GMV %&quot; THEN [Calculation_1179380202026074148]&#13;&#10;  END&#13;&#10;ELSE&#13;&#10;  CASE [Parameters].[Parameter 6]&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN -[Calculation_1000362122761048064]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN -[Calculation_1000362122761297921]&#13;&#10;    WHEN &quot;MAU&quot; THEN -[Calculation_1348265199284862976]&#13;&#10;    WHEN &quot;Frequency&quot; THEN -[Calculation_638385247264137220]&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN -[Calculation_678917692299829251]&#13;&#10;    WHEN &quot;OD Share&quot; THEN -[Calculation_1226386527727788032]&#13;&#10;    WHEN &quot;Seamless %&quot; THEN -[Calculation_886646182733557768]&#13;&#10;    WHEN &quot;Avg DT&quot; THEN -[Calculation_886646182736216076]&#13;&#10;    WHEN &quot;Order Late 10min %&quot; THEN -[Calculation_886646182731751424]&#13;&#10;    WHEN &quot;Fail Rate %&quot; THEN -[Calculation_900438471487643652]&#13;&#10;    WHEN &quot;AFV (HUF)&quot; THEN -[Calculation_1282118579461185578]&#13;&#10;    WHEN &quot;VFD / GMV %&quot; THEN -[Calculation_790381762694070273]&#13;&#10;    WHEN &quot;% Valid Orders by Pro Users&quot; THEN -[Calculation_1279022355001327616]&#13;&#10;    WHEN &quot;Consumer Fees %&quot; THEN -AVG([Calculation_1279022355005009924])&#13;&#10;    WHEN &quot;QC GMV %&quot; THEN -[Calculation_1179380202026074148]&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_1348265199319552019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// City Name Sort Field&#13;&#10;IF [Parameters].[Parameter 7] = &quot;Ascending&quot; THEN&#13;&#10;  INDEX()&#13;&#10;ELSE&#13;&#10;  -INDEX()&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Exclude First Column - Valid Orders' datatype='boolean' name='[Calculation_1348265199347716122]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() != 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Shops Partial Orders' datatype='real' name='[Calculation_1362057464707608576 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_sent_order] AND qty_ordered &gt; qty_delivered&#13;&#10;AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/&#13;&#10;COUNTD(IF [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='% PP GMV' datatype='real' default-format='p0.0%' name='[Calculation_138204246623809536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_pp] AND [is_valid_order] THEN [gmv_local] END)&#13;&#10;/&#13;&#10;SUM(IF [is_valid_order] THEN [gmv_local] END)' />
      </column>
      <column caption='Meas - Descriptions' datatype='string' name='[Calculation_1386545782726303748]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;    WHEN &quot;% OD Orders Share&quot; THEN &quot;Percentage of Completed OD (incl. Laas) Orders out of Total Valid Orders&quot;&#13;&#10;    WHEN &quot;% OD Vendors Share&quot; THEN &quot;Percentage of OD Online Vendors (incl. Laas) out of Total Online Vendors&quot;&#13;&#10;    WHEN &quot;Orders per A Grade Vendors&quot; THEN &quot;Number of valid orders per A Grade Vendor&quot;&#13;&#10;    WHEN &quot;Orders per B Grade Vendors&quot; THEN &quot;Number of valid orders per B Grade Vendor&quot;&#13;&#10;    WHEN &quot;Orders per A GMV Class Vendors&quot; THEN &quot;Number of valid orders per A GMV Class Vendor&quot;&#13;&#10;    WHEN &quot;Orders per B GMV Class Vendors&quot; THEN &quot;Number of valid orders per B GMV CLass Vendor&quot;&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN &quot;Number of vendors with at least 1 valid order&quot;&#13;&#10;    WHEN &quot;New Restaurant Vendors&quot; THEN &quot;Number of new restaurants (activation date)&quot;&#13;&#10;    WHEN &quot;% Pickup Share&quot; THEN &quot;Valid pickup orders share across valid orders&quot;&#13;&#10;    WHEN &quot;% Fail Rate&quot; THEN &quot;Failed OD + VD (incl. Laas) orders share of Total Gross orders&quot;&#13;&#10;    WHEN &quot;% Vendor Fail Rate&quot; THEN &quot;Failed (by vendor) OD + VD (excl. Laas) orders share of Total Gross orders&quot;&#13;&#10;    WHEN &quot;% Vendor Late &gt; 10&quot; THEN &quot;Vendor late (&gt; 10 min) OD (incl. Laas) orders of Total Completed OD orders&quot;&#13;&#10;    WHEN &quot;% VFD / GMV&quot; THEN &quot;Total VFD Value per Restaurant&apos;s GMV (at valid orders)&quot;&#13;&#10;    WHEN &quot;% VFD Free Gift/GMV&quot; THEN &quot;VFD Free Gift / Restaurant&apos;s GMV&quot;&#13;&#10;    WHEN &quot;% VFD Joker/GMV&quot; THEN &quot;VFD Joker Deal / Restaurant&apos;s GMV (at valid orders)&quot;&#13;&#10;    WHEN &quot;% VFD Penetration&quot; THEN &quot;Percent of VFD Vendors of Active vendors&quot;&#13;&#10;    WHEN &quot;% VFD AB Penetration&quot; THEN &quot;Percent of VFD A-B vendors of Total VFD vendors (based on GMV Class)&quot;&#13;&#10;    WHEN &quot;% VFD Pro AB Penetration&quot; THEN &quot;Percent of Pro VFD A-B vendors of Total A-B vendors&quot;&#13;&#10;    WHEN &quot;A/B Vendors SF Grade DLP&gt;90%&quot; THEN &quot;Percent of DLP &gt; 90% A-B (based on sf_grade) vendors of Total A-B vendors&quot;&#13;&#10;    WHEN &quot;A/B Vendors SF Grade DLD&gt;90%&quot; THEN &quot;Percent of DLD &gt; 90% A-B (based on sf_grade) vendors of Total A-B vendors&quot;&#13;&#10;    WHEN &quot;GAP Signed&quot; THEN &quot;Number of signed Wolt GAP vendors&quot;&#13;&#10;    WHEN &quot;Dreambrand Signed&quot; THEN &quot;Number of signed Dreambrand vendors&quot;&#13;&#10;    WHEN &quot;% CPC Vendor Penetration&quot; THEN &quot;Percent of CPC vendors of Total Active vendors&quot;&#13;&#10;    WHEN &quot;% PP GMV&quot; THEN &quot;Percent of PP vendor&apos;s GMV (Valid orders) of Total GMV&quot;&#13;&#10;    WHEN &quot;% Uptime&quot; THEN &quot;Percent of all active vendor&apos;s uptime&quot;&#13;&#10;    WHEN &quot;Completed OD Orders&quot; THEN &quot;Completed OD (incl. Laas) orders&quot;&#13;&#10;    WHEN &quot;UTR&quot; THEN &quot;Completed OD (incl. Laas) orders / Total Evaluated Hours&quot;&#13;&#10;    WHEN &quot;Avg DT&quot; THEN &quot;Avg DT per non-preorder Completed OD orders&quot;&#13;&#10;    WHEN &quot;% Seamless&quot; THEN &quot;The percentage of Completed OD Orders where the order was seamless&quot;&#13;&#10;    WHEN &quot;% Delay &gt; 10&quot; THEN &quot;The percentage of Completed OD orders with 10 min late&quot;&#13;&#10;    WHEN &quot;% Delay &gt; 20&quot; THEN &quot;The percentage of Completed OD orders with 20 min late&quot;&#13;&#10;    WHEN &quot;% Delay &gt; 60&quot; THEN &quot;The percentage of Completed OD orders with 60 min late&quot;&#13;&#10;    WHEN &quot;% Early orders &gt; 10&quot; THEN &quot;The percentage of Completed OD orders with 10 min early&quot;&#13;&#10;    WHEN &quot;% Fill Rate&quot; THEN &quot;Fill rate of slots&quot;&#13;&#10;    WHEN &quot;Rider Rating&quot; THEN &quot;Avg rider rating per order&quot;&#13;&#10;    WHEN &quot;% Car Share&quot; THEN &quot;The percentage of completed Car deliveries (OD)&quot;&#13;&#10;    WHEN &quot;% Bike Share&quot; THEN &quot;The percentage of completed Bike deliveries (OD)&quot;&#13;&#10;    WHEN &quot;% Scooter Share&quot; THEN &quot;The percentage of completed Scooter deliveries (OD)&quot;&#13;&#10;    WHEN &quot;% Cancellation&quot; THEN &quot;Percentage of Cancelled OD orders&quot;&#13;&#10;    WHEN &quot;CPO Local&quot; THEN &quot;Cost per OD order (HUF) (Order with rooster payment)&quot;&#13;&#10;    WHEN &quot;Avg DF (OD)&quot; THEN &quot;Avg DF (HUF) per Completed OD order&quot;&#13;&#10;    WHEN &quot;% Priority Orders&quot; THEN &quot;Percentage of Priority OD orders&quot;&#13;&#10;    WHEN &quot;% Close Weighted&quot; THEN &quot;Percentage of Close&quot;&#13;&#10;    WHEN &quot;% Shrinkage Weighted&quot; THEN &quot;Percentage of Shrinkage&quot;&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN &quot;Valid OD + VD (excl. Laas) Orders&quot;&#13;&#10;    WHEN &quot;GMV Local Valid Orders&quot; THEN &quot;Sum of Completed or Valid OD + VD (incl. Laas) Order&apos;s GMV (HUF)&quot;&#13;&#10;    WHEN &quot;Acquisition&quot; THEN &quot;Number of Valid Acquisition OD + VD (excl. Laas) Order&quot;&#13;&#10;    WHEN &quot;PRO Orders %&quot; THEN &quot;Percentage of PRO Valid OD + VD (excl. Laas) Orders&quot;&#13;&#10;    WHEN &quot;% QComm GMV Share&quot; THEN &quot;Percentage of sent QComm Orders from All Valid Orders GMV&quot;&#13;&#10;    WHEN &quot;% Qcomm Vendor Late &gt; 10m&quot; THEN &quot;Percentage of vendor late &gt; 10m sent orders&quot;&#13;&#10;    WHEN &quot;Dmart Orders&quot; THEN &quot;Sent Dmart Orders&quot;&#13;&#10;    WHEN &quot;% Subscription Orders for Dmart&quot; THEN &quot;Percentage of Valid Dmart Subscription Orders (from All Valid Subscription Orders)&quot;&#13;&#10;    WHEN &quot;Dmart GMV Local&quot; THEN &quot;Sent Dmart Orders GMV Local (huf)&quot;&#13;&#10;    WHEN &quot;Dmart ABV&quot; THEN &quot;Sent Dmart Order&apos;s Turnover Local per Sent Dmart Orders&quot;&#13;&#10;    WHEN &quot;Dmart Acquisition&quot; THEN &quot;Sent Acquisition Dmart Orders&quot;&#13;&#10;    WHEN &quot;Dmart Front Margin&quot; THEN &quot;Sum of Sent Dmart Orders (Turnover Net - Cogs) per Sum of Sent Dmart Turnover Net&quot;&#13;&#10;    WHEN &quot;% Shrinkage (on GMV net)&quot; THEN &quot;Sum of Dmart Shrinkage Value / Sum Dmart Turnover Net&quot;&#13;&#10;    WHEN &quot;% Dmart Vendor Late &gt; 10&quot; THEN &quot;Percentage of Sent Dmart Vendor Late (&gt;10min) orders&quot;&#13;&#10;    WHEN &quot;% Dmart Products Availability&quot; THEN &quot;Dmart Products Availability&quot;&#13;&#10;    WHEN &quot;Shop Orders&quot; THEN &quot;Sent Shop Orders&quot;&#13;&#10;    WHEN &quot;% Subscription Orders for Shop&quot; THEN &quot;Percentage of Valid Shop Subscription Orders (from All Valid Subscription Orders)&quot;&#13;&#10;    WHEN &quot;Shop GMV Local&quot; THEN &quot;Sent Shop Orders GMV (huf)&quot;&#13;&#10;    WHEN &quot;Shop ABV&quot; THEN &quot;Sent Shop Order&apos;s Turnover Local per Sent Shop Orders&quot;&#13;&#10;    WHEN &quot;Shop Acquisition&quot; THEN &quot;Sent Shop Acquisition Orders&quot;&#13;&#10;    WHEN &quot;% Shops Partial Orders&quot; THEN &quot;Percentage of Shop Orders with qty_delivered &lt; qty_ordered&quot;&#13;&#10;    WHEN &quot;% Shop Vendor Late &gt; 10&quot; THEN  &quot;Percentage of Sent Shop Vendor Late (&gt;10min) orders&quot;&#13;&#10;    WHEN &quot;% Shops Fail Rate&quot; THEN &quot;Percentage of Not Sent Shop Orders&quot;&#13;&#10;    WHEN &quot;% Shops Commission&quot; THEN &quot;Sum of Sent Shop Orders Commission / SUM (If OD then Shop Turnover, IF VD Then GMV Local)&quot;&#13;&#10;    WHEN &quot;Valid Order Estimates&quot; THEN &quot;Monthly Estimates for Total Hungary Valid Orders by Finance Team&quot;&#13;&#10;    WHEN &quot;GMV User Paid Estimates&quot; THEN &quot;Monthly Estimates for Total Hungary GMV User Paid by Finance Team&quot;&#13;&#10;    WHEN &quot;GMV User Paid&quot; THEN &quot;GMV User Paid at Valid Orders&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='County' datatype='string' name='[Calculation_1429611471510126592]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='CASE [city_name]&#13;&#10;    WHEN &quot;baja&quot; THEN &quot;Bács-Kiskun&quot;&#13;&#10;    WHEN &quot;balatonfured&quot; THEN &quot;Veszprém&quot;&#13;&#10;    WHEN &quot;bekescsaba&quot; THEN &quot;Békés&quot;&#13;&#10;    WHEN &quot;budapest&quot; THEN &quot;Budapest&quot;&#13;&#10;    WHEN &quot;debrecen&quot; THEN &quot;Hajdú-Bihar&quot;&#13;&#10;    WHEN &quot;dunaujvaros&quot; THEN &quot;Fejér&quot;&#13;&#10;    WHEN &quot;eger&quot; THEN &quot;Heves&quot;&#13;&#10;    WHEN &quot;esztergom&quot; THEN &quot;Komárom-Esztergom&quot;&#13;&#10;    WHEN &quot;gyongyos&quot; THEN &quot;Heves&quot;&#13;&#10;    WHEN &quot;gyor&quot; THEN &quot;Győr-Moson-Sopron&quot;&#13;&#10;    WHEN &quot;kaposvar&quot; THEN &quot;Somogy&quot;&#13;&#10;    WHEN &quot;kazincbarcika&quot; THEN &quot;Borsod-Abaúj-Zemplén&quot;&#13;&#10;    WHEN &quot;kecskemet&quot; THEN &quot;Bács-Kiskun&quot;&#13;&#10;    WHEN &quot;keszthely&quot; THEN &quot;Zala&quot;&#13;&#10;    WHEN &quot;kisvarda&quot; THEN &quot;Szabolcs-Szatmár-Bereg&quot;&#13;&#10;    WHEN &quot;mako&quot; THEN &quot;Csongrád&quot;&#13;&#10;    WHEN &quot;miskolc&quot; THEN &quot;Borsod-Abaúj-Zemplén&quot;&#13;&#10;    WHEN &quot;mosonmagyarovar&quot; THEN &quot;Győr-Moson-Sopron&quot;&#13;&#10;    WHEN &quot;nagykanizsa&quot; THEN &quot;Zala&quot;&#13;&#10;    WHEN &quot;nyiregyhaza&quot; THEN &quot;Szabolcs-Szatmár-Bereg&quot;&#13;&#10;    WHEN &quot;ozd&quot; THEN &quot;Borsod-Abaúj-Zemplén&quot;&#13;&#10;    WHEN &quot;papa&quot; THEN &quot;Veszprém&quot;&#13;&#10;    WHEN &quot;pecs&quot; THEN &quot;Baranya&quot;&#13;&#10;    WHEN &quot;salgotarjan&quot; THEN &quot;Nógrád&quot;&#13;&#10;    WHEN &quot;siofok&quot; THEN &quot;Somogy&quot;&#13;&#10;    WHEN &quot;sopron&quot; THEN &quot;Győr-Moson-Sopron&quot;&#13;&#10;    WHEN &quot;szeged&quot; THEN &quot;Csongrád&quot;&#13;&#10;    WHEN &quot;szekesfehervar&quot; THEN &quot;Fejér&quot;&#13;&#10;    WHEN &quot;szekszard&quot; THEN &quot;Tolna&quot;&#13;&#10;    WHEN &quot;szolnok&quot; THEN &quot;Jász-Nagykun-Szolnok&quot;&#13;&#10;    WHEN &quot;szombathely&quot; THEN &quot;Vas&quot;&#13;&#10;    WHEN &quot;tatabanya&quot; THEN &quot;Komárom-Esztergom&quot;&#13;&#10;    WHEN &quot;veszprem&quot; THEN &quot;Veszprém&quot;&#13;&#10;    WHEN &quot;zalaegerszeg&quot; THEN &quot;Zala&quot;&#13;&#10;    ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Metric Value' datatype='real' name='[Calculation_1429611471520337922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Valid Orders&quot; THEN [Calculation_1000362122761048064]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN [Calculation_1000362122761297921]&#13;&#10;    WHEN &quot;MAU&quot; THEN [Calculation_1348265199284862976]&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_638385247264137220]&#13;&#10;    WHEN &quot;Active Vendors&quot; THEN [Calculation_678917692299829251]&#13;&#10;    WHEN &quot;OD Share&quot; THEN [Calculation_1226386527727788032] * 100&#13;&#10;    WHEN &quot;Seamless %&quot; THEN [Calculation_886646182733557768] * 100&#13;&#10;    WHEN &quot;Avg DT&quot; THEN [Calculation_886646182736216076]&#13;&#10;    WHEN &quot;Order Late 10m %&quot; THEN [Calculation_886646182731751424] * 100&#13;&#10;    WHEN &quot;Fail Rate %&quot; THEN [Calculation_900438471487643652] * 100&#13;&#10;    WHEN &quot;AFV (HUF)&quot; THEN [Calculation_1282118579461185578]&#13;&#10;    WHEN &quot;VFD / GMV %&quot; THEN [Calculation_790381762694070273] * 100&#13;&#10;    WHEN &quot;% Valid Orders By Pro Users&quot; THEN [Calculation_638385247291756550] * 100&#13;&#10;    WHEN &quot;Consumer Fees %&quot; THEN AVG([Calculation_1279022355005009924]) * 100&#13;&#10;    WHEN &quot;QC GMV %&quot; THEN [Calculation_1179380202026074148] * 100&#13;&#10;END' />
      </column>
      <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1451566489713233920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([scheduled_open_seconds] - [total_closed_seconds])&#13;&#10;/&#13;&#10;SUM([scheduled_open_seconds])' />
      </column>
      <column caption='GMV User Paid' datatype='real' name='[Calculation_1479995450891890688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [hurrier_order_status] = &quot;completed&quot;&#13;&#10;OR [is_valid_order] THEN [gmv_user_paid_local] END)' />
      </column>
      <column caption='Is Last Period' datatype='boolean' name='[Calculation_1649724888182579203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_236720497991634944] = [Calculation_236720498005807115]' />
      </column>
      <column caption='Avg DF (OD)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1794965948549857280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [hurrier_order_status] = &quot;completed&quot; THEN [delivery_fee_local] END) / COUNTD(IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] END)' />
      </column>
      <column caption='Period Date' datatype='date' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_236720497991634944]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;END)' />
      </column>
      <column caption='Reporting Period' datatype='integer' name='[Calculation_236720497996382212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN WEEK([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;END' />
      </column>
      <column caption='PtD' datatype='boolean' name='[Calculation_236720498005434378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([date] &gt;= [Calculation_236720498005807115] AND [date]&lt;= [Parameters].[Reporting Month (copy)_52072871788789788])' />
      </column>
      <column caption='Start of Reporting Period' datatype='datetime' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;END' />
      </column>
      <column caption='Last Data Date' datatype='datetime' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{Max([date])}' />
      </column>
      <column caption='CPC Vendors' datatype='integer' name='[Calculation_398005673001701381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_cpc_vendor] THEN [vendor_code] END)' />
      </column>
      <column caption='Online Vendors' datatype='integer' name='[Calculation_398005673048924168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [was_online] THEN [vendor_code] END)' />
      </column>
      <column caption='% Qcomm Vendor Late &gt; 10m' datatype='real' name='[Calculation_497929264936513547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_vendor_late_min]&gt; 10&#13;&#10;AND [is_sent_order]&#13;&#10;AND [vertical_type] != &quot;Restaurant&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;&#13;&#10;/ COUNTD(IF [is_sent_order]&#13;&#10;AND [vertical_type] != &quot;Restaurant&quot;&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='% Subscription Orders for Dmart' datatype='real' name='[Calculation_497929264937807887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;AND [vertical_segment] = &quot;Dmart&quot; THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='% Subscription Orders for Shop' datatype='real' name='[Calculation_497929264947638295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;AND [vertical_segment] = &quot;Shop&quot; THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] AND [is_subscription_order]&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='% Shops Fail Rate' datatype='real' name='[Calculation_497929264949420064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT [is_sent_order] AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [vertical_segment] = &quot;Shop&quot; THEN order_code END)' />
      </column>
      <column caption='% Shops Commission' datatype='real' name='[Calculation_497929264952426532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;  IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot; &#13;&#10;THEN [shop_commission_local] END&#13;&#10;) / &#13;&#10;SUM(&#13;&#10;  IF [vertical_segment] = &quot;Shop&quot; THEN&#13;&#10;    IF [delivery_type] = &quot;OD&quot; THEN [shop_turnover_local]&#13;&#10;    ELSE [gmv_local] END&#13;&#10;  END&#13;&#10;)' />
      </column>
      <column caption='Month Filter' datatype='boolean' name='[Calculation_52072871510233092]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1073264146391670795] &gt;= DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),[Parameters].[report_month Parameter])&#13;&#10;AND&#13;&#10;[Calculation_1073264146391670795] &lt;= [Parameters].[report_month Parameter]' />
      </column>
      <column caption='= Report month' datatype='boolean' name='[Calculation_52072871511171077]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1073264146391670795] = [Parameters].[report_month Parameter]' />
      </column>
      <column caption='MoM Title' datatype='string' name='[Calculation_52072871513169927]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; MoM&quot;' />
      </column>
      <column caption='YoY Title' datatype='string' name='[Calculation_52072871514304520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; YoY&quot;' />
      </column>
      <column caption='Frequency Target' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_52072871778373651]' role='measure' type='quantitative' visual-totals='Avg'>
        <calculation class='tableau' formula='avg([target_orders]) / avg([target_active_users])' />
      </column>
      <column caption='Index Period' datatype='integer' name='[Calculation_52072871791292446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIZE() -INDEX() +1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='PoP PtD Title' datatype='string' name='[Calculation_52072871791542303]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WoW WtD&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; then &quot;MoM MtD&quot;&#13;&#10;END' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_638385247264137220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_valid_order] THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [is_valid_order] THEN [customer_code] END)' />
      </column>
      <column caption='PRO Orders %' datatype='real' default-format='p0.0%' name='[Calculation_638385247291756550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_valid_order] AND [is_subscription_order] THEN [order_code] END) / &#13;&#10;COUNTD(IF [is_valid_order] THEN [order_code] END)' />
      </column>
      <column caption='Active Vendors' datatype='integer' name='[Calculation_678917692299829251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [was_active] THEN [vendor_code] END)' />
      </column>
      <column caption='New Restaurant Vendors' datatype='integer' name='[Calculation_678917692300189700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [is_new_online_restaurant] WHEN TRUE THEN [vendor_code] END)' />
      </column>
      <column caption='Gap Signed' datatype='integer' name='[Calculation_678917692307398664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_wolt_gap_vendor] THEN [vendor_code] END)' />
      </column>
      <column caption='# LaaS Orders Successful' datatype='integer' name='[Calculation_6816057346453442560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([laas_orders_delivered])' />
      </column>
      <column caption='% LaaS Orders Fail Rate' datatype='real' name='[Calculation_6816057346453602305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([laas_orders_cancelled])/(sum([laas_orders_delivered])+sum([laas_orders_cancelled]))' />
      </column>
      <column caption='GMV Local Valid Orders' datatype='real' name='[Calculation_763923143099445251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [hurrier_order_status] = &quot;completed&quot;&#13;&#10;OR [is_valid_order] THEN [gmv_local] END)' />
      </column>
      <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] THEN [vf_deal_total_incl_voucher_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN [gmv_local] END)' />
      </column>
      <column caption='% VFD Percentage / GMV' datatype='real' default-format='p0.00%' name='[Calculation_790381762695061506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order] &#13;&#10;THEN [vf_deal_percentage_local] END) /&#13;&#10;SUM(IF [vertical_type] = &quot;Restaurant&quot; AND [is_valid_order]&#13;&#10;THEN gmv_local END)' />
      </column>
      <column caption='% CPC Vendor Penetration' datatype='real' default-format='p0.0%' name='[Calculation_790381762708983813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_cpc_vendor] THEN [vendor_code] END)&#13;&#10;/ COUNTD(IF [was_active] THEN [vendor_code] END)' />
      </column>
      <column caption='Completed OD Orders' datatype='integer' name='[Calculation_828380911711256579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [hurrier_order_status] WHEN &quot;completed&quot; THEN [order_code] END)' />
      </column>
      <column caption='% Priority Orders' datatype='real' default-format='p0.0%' name='[Calculation_859906086178246656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [is_priority_order] = TRUE AND [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='current_month' datatype='date' name='[Calculation_8673088464385294358]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&quot;month&quot;, TODAY() - 1 ))' />
      </column>
      <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_883549986632835072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF[hurrier_order_status] = &quot;completed&quot; THEN [order_code] END) /SUM([evaluated_hours])' />
      </column>
      <column caption='% Pro MAU' datatype='real' name='[Calculation_885520334726066176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_subscription_order] AND [is_valid_order] THEN [customer_code] END)&#13;&#10;/&#13;&#10;COUNTD(IF [is_valid_order] THEN [customer_code] END)' />
      </column>
      <column caption='Pickup Orders' datatype='integer' name='[Calculation_885520334756515841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [is_pickup] = TRUE THEN [order_code] END&#13;&#10;)' />
      </column>
      <column caption='% Delay &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_886646182731751424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [delivery_status] = &quot;Late&quot;&#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='% Bike Share' datatype='real' default-format='p0.0%' name='[Calculation_886646182732382211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([deliveries_bike]) / sum([completed_deliveries])' />
      </column>
      <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_886646182733041670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([slots_assigned]) / sum([open_slots_hours])' />
      </column>
      <column caption='CPO local' datatype='real' name='[Calculation_886646182733328391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_rider_payment_local]) / COUNTD(CASE [is_od_order_with_rooster_payment] WHEN TRUE THEN [order_code] END)' />
      </column>
      <column caption='% Seamless' datatype='real' default-format='p0.0%' name='[Calculation_886646182733557768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_seamless_order] &#13;&#10;AND [hurrier_order_status] = &quot;completed&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] END)' />
      </column>
      <column caption='Rider Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_886646182734934025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_score]) / SUM(IF NOT ISNULL([rider_score]) THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_886646182736216076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF NOT [is_preorder] AND [is_own_delivery] THEN &#13;&#10;[actual_delivery_time_min] END) / COUNTD(IF NOT [is_preorder] AND [is_own_delivery] THEN [order_code] END)' />
      </column>
      <column caption='% Cancellation' datatype='real' default-format='p0.0%' name='[Calculation_886646182736834573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [hurrier_order_status] != &quot;completed&quot; AND [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Dmart Orders' datatype='integer' name='[Calculation_894809008283504641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot; THEN [order_code] END)' />
      </column>
      <column caption='Dmart GMV Local' datatype='real' name='[Calculation_894809008283971586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Dmart&quot; THEN [gmv_local] END)' />
      </column>
      <column caption='Dmart Acquisition' datatype='integer' name='[Calculation_894809008284393475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_acquisition_darkstore] AND [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Dmart&quot; THEN [order_code] END)' />
      </column>
      <column caption='Shop Orders' datatype='integer' name='[Calculation_894809008284897284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='Shop GMV Local' datatype='real' name='[Calculation_894809008285249541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_sent_order] AND [vertical_segment] = &quot;Shop&quot; THEN [gmv_local] END)' />
      </column>
      <column caption='Shop Acquisition' datatype='integer' name='[Calculation_894809008285450246]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_acquisition_localshop] AND [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Shop&quot; THEN [order_code] END)' />
      </column>
      <column caption='last_date' datatype='date' name='[Calculation_894809008320020487]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, -1, MAX([date])))' />
      </column>
      <column caption='% Dmart Vendor Late &gt; 10' datatype='real' name='[Calculation_900157005605937154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_vendor_late_min]&gt; 10&#13;&#10;AND [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;&#13;&#10;/ COUNTD(IF [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Dmart&quot;&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='% Shop Vendor Late &gt; 10' datatype='real' name='[Calculation_900157005608476677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_vendor_late_min]&gt; 10&#13;&#10;AND [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;&#13;&#10;/ COUNTD(IF [is_sent_order]&#13;&#10;AND [vertical_segment] = &quot;Shop&quot;&#13;&#10;THEN [order_code] END)' />
      </column>
      <column caption='% OD Vendors Share' datatype='real' default-format='p0.0%' name='[Calculation_900438471484215296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [delivery_type] = &quot;OD&quot; AND [was_online]&#13;&#10;THEN [vendor_code] END) / COUNTD(IF [was_online] THEN [vendor_code] END)' />
      </column>
      <column caption='A/B SF Grade Vendors DLP &gt; 90%' datatype='real' default-format='p0.0%' name='[Calculation_900438471486914562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([num_of_images] / [num_of_products]) &gt; 0.9&#13;&#10;AND ([sf_vendor_grade] = &quot;A&quot; OR [sf_vendor_grade] = &quot;B&quot;)&#13;&#10;AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;THEN [vendor_code]&#13;&#10;END) /&#13;&#10;COUNTD(IF ([sf_vendor_grade] = &quot;A&quot; OR [sf_vendor_grade] = &quot;B&quot;)&#13;&#10;AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;THEN [vendor_code]&#13;&#10;END)' />
      </column>
      <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_failed_order] = TRUE THEN [order_code] END)&#13;&#10;/ COUNTD([order_code])' />
      </column>
      <column caption='Orders per A Grade Vendors' datatype='real' name='[Calculation_900438471488229382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [is_valid_order] = TRUE AND [sf_vendor_grade] = &quot;A&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [order_code] END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;IF [sf_vendor_grade] = &quot;A&quot; &#13;&#10;AND [date] &gt;= DATE([activated_at_local]) AND [date] &lt;= DATEADD(&apos;month&apos;, 3, DATE([activated_at_local]))&#13;&#10;THEN [vendor_code] END&#13;&#10;)' />
      </column>
      <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.00%' name='[Calculation_900438471492648968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_vendor_late_min]&gt; 10&#10;AND [hurrier_order_status] = &quot;completed&quot;&#13;&#10;AND [is_own_delivery] THEN [order_code] END)&#13;&#10;/ COUNTD(IF [hurrier_order_status] = &quot;completed&quot;&#13;&#10;AND [is_own_delivery] THEN [order_code] END)' />
      </column>
      <column caption='% VFD AB Penetration' datatype='real' default-format='p0.0%' name='[Calculation_900438471497416714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [vf_deal_total_local] &gt; 0&#13;&#10;    AND [is_valid_order]&#13;&#10;    AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;    AND ([gmv_class] = &quot;A&quot; OR [gmv_class] = &quot;B&quot;)&#13;&#10;    THEN [vendor_code]&#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(IF [vf_deal_total_local] &gt; 0&#13;&#10;    AND [is_valid_order]&#13;&#10;    AND [vertical_type] = &quot;Restaurant&quot;&#13;&#10;    THEN [vendor_code]&#13;&#10;    END&#13;&#10;)' />
      </column>
