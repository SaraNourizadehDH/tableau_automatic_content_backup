              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;borota (teszt)&quot;' value='&quot;Jánoshalma&quot;' />
                <semantic-value key='&quot;Other&quot;' value='&quot;Budapest III. kerület&quot;' />
