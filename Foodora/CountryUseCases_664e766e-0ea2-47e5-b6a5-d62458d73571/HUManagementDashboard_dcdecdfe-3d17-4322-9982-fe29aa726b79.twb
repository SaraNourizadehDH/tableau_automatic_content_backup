    <worksheet name='log_ptd_lp'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance_tableau_order_level (fp_hun_internal)' name='federated.0hlk9c108s4zcd11akq9117bbz54' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Breakdown parameter' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Hungary&quot;'>
              <calculation class='tableau' formula='&quot;Total Hungary&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_2852326719360741382]' caption='Reporting Date' datatype='date' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hlk9c108s4zcd11akq9117bbz54'>
            <column caption='% Close Weighted' datatype='real' default-format='p0.00%' name='[% Close Weighted old (copy)_1122522250003243009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([events_orders_affected_by_close])/SUM([events_orders_forecast])' />
            </column>
            <column caption='% Shrinkage Weighted' datatype='real' default-format='p0.00%' name='[% Shrinkage Weighted (copy)_1122522250003394562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([events_orders_affected_by_shrink])/SUM([events_orders_forecast])' />
            </column>
            <column caption='% Scooter Share' datatype='real' default-format='p0.0%' name='[% bike share (copy)_886646182732558340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_motorbike]) / sum([completed_deliveries])' />
            </column>
            <column caption='% Delay &gt; 60' datatype='real' default-format='p0.0%' name='[% delay &gt; 10 (copy) (copy)_886646182732091394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [delay_min] &gt; 60 AND [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% Early orders &gt; 10' datatype='real' default-format='p0.0%' name='[% delay &gt; 10 (copy)_883549986636288001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [delivery_status] = &quot;Early&quot; &#13;&#10;    THEN [order_code]&#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% Delay &gt; 20' datatype='real' default-format='p0.0%' name='[% delay &gt; 10 (copy)_886646182732075009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [delay_min] &gt; 20 AND [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% Car Share' datatype='real' name='[Calculation_1047368402135384064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_car]) / sum([completed_deliveries])' />
            </column>
            <column caption='breakdown_field' datatype='string' name='[Calculation_1224416154036039680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] == &quot;Total Hungary&quot;&#13;&#10;THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities&quot;&#13;&#10;THEN [city_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Zones&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [zone_name]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Cities &amp; Zones &amp; Verticals&quot;&#13;&#10;THEN [city_name] + &quot; - &quot; + [zone_name] + &quot; - &quot; + [vertical_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] == &quot;Regions &amp; Cities&quot;&#13;&#10;THEN [region_name] + &quot; - &quot; + [city_name]&#13;&#10;END' />
            </column>
            <column caption='Avg DF (OD)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1794965948549857280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [hurrier_order_status] = &quot;completed&quot; THEN [delivery_fee_local] END) / COUNTD(IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] END)' />
            </column>
            <column caption='Start of Reporting Period' datatype='datetime' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;END' />
            </column>
            <column caption='Last Data Date' datatype='datetime' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Completed OD Orders' datatype='integer' name='[Calculation_828380911711256579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [hurrier_order_status] WHEN &quot;completed&quot; THEN [order_code] END)' />
            </column>
            <column caption='% Priority Orders' datatype='real' default-format='p0.0%' name='[Calculation_859906086178246656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [is_priority_order] = TRUE AND [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_883549986632835072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF[hurrier_order_status] = &quot;completed&quot; THEN [order_code] END) /SUM([evaluated_hours])' />
            </column>
            <column caption='% Delay &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_886646182731751424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [delivery_status] = &quot;Late&quot;&#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [hurrier_order_status] = &quot;completed&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='% Bike Share' datatype='real' default-format='p0.0%' name='[Calculation_886646182732382211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_bike]) / sum([completed_deliveries])' />
            </column>
            <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_886646182733041670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([slots_assigned]) / sum([open_slots_hours])' />
            </column>
            <column caption='CPO local' datatype='real' name='[Calculation_886646182733328391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_rider_payment_local]) / COUNTD(CASE [is_od_order_with_rooster_payment] WHEN TRUE THEN [order_code] END)' />
            </column>
            <column caption='% Seamless' datatype='real' default-format='p0.0%' name='[Calculation_886646182733557768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_seamless_order] &#13;&#10;AND [hurrier_order_status] = &quot;completed&quot;&#13;&#10;THEN [order_code] END)&#13;&#10;/ &#13;&#10;COUNTD(IF [hurrier_order_status] = &quot;completed&quot; THEN [order_code] END)' />
            </column>
            <column caption='Rider Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_886646182734934025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_score]) / SUM(IF NOT ISNULL([rider_score]) THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_886646182736216076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF NOT [is_preorder] AND [is_own_delivery] THEN &#13;&#10;[actual_delivery_time_min] END) / COUNTD(IF NOT [is_preorder] AND [is_own_delivery] THEN [order_code] END)' />
            </column>
            <column caption='% Cancellation' datatype='real' default-format='p0.0%' name='[Calculation_886646182736834573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [hurrier_order_status] != &quot;completed&quot; AND [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;) / &#13;&#10;COUNTD(&#13;&#10;    IF [delivery_type] = &quot;OD&quot; &#13;&#10;    THEN [order_code] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='PtD LP' datatype='boolean' name='[PtD LY (copy)_1649724888175493121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN ([date] &gt;= DATEADD(&quot;month&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;month&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Weekly&quot; THEN  ([date] &gt;= DATEADD(&quot;week&quot;,-1,[Calculation_236720498005807115]) AND  [date] &lt;= DATEADD(&quot;week&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;END' />
