        <rows>(([federated.0hlk9c108s4zcd11akq9117bbz54].[none:Calculation_1224416154036039680:nk] / [federated.0hlk9c108s4zcd11akq9117bbz54].[:Measure Names]) * [federated.0hlk9c108s4zcd11akq9117bbz54].[Multiple Values])</rows>
