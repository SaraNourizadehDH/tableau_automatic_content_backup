      <column caption='Acquisitions Target PtD' datatype='real' name='[Calculation_1188668875947163662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1188668875951497240] * &#13;&#10;CASE [city_name] &#13;&#10;    WHEN &apos;Total CZ&apos; THEN 31350&#13;&#10;    END' />
