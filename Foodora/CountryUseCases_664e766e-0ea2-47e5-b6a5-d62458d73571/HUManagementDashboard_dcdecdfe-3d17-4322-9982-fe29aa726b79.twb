            <column datatype='real' name='[service_fee_plus_vat_local]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1348265199319326737]' derivation='User' name='[usr:Calculation_1348265199319326737:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_678917692299829251]' derivation='User' name='[usr:Calculation_678917692299829251:qk]' pivot='key' type='quantitative' />
