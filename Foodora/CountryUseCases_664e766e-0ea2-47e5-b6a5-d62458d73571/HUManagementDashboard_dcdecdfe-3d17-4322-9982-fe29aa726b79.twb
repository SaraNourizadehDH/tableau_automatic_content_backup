        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.154&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.186&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.155&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.137&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.139&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.143&#13;&#10;END)' />
