    <worksheet name='monthly_mom'>
      <layout-options>
        <title>
          <formatted-text>
            <run>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='country_HU_monthly_city_performance' name='federated.1h3qwk01iwx3h819kn77207qc4i9' />
            <datasource caption='daily_performance_tableau_order_level (fp_hun_internal)' name='federated.0hlk9c108s4zcd11akq9117bbz54' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Periods' datatype='integer' name='[Monthly / Weekly (copy)]' param-domain-type='list' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_8673088464385294358]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0hlk9c108s4zcd11akq9117bbz54].[Calculation_1073264146391670795]' caption='Reporting Month' datatype='date' default-format='*yyyy mmmm' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-03#'>
              <calculation class='tableau' formula='#2025-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hlk9c108s4zcd11akq9117bbz54'>
            <column caption='report_month' datatype='date' datatype-customized='true' name='[Calculation_1073264146391670795]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column caption='current_month' datatype='date' name='[Calculation_8673088464385294358]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&quot;month&quot;, TODAY() - 1 ))' />
            </column>
            <column datatype='datetime' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h3qwk01iwx3h819kn77207qc4i9'>
            <column caption='% PRO Users' datatype='real' default-format='p0.00%' name='[% Subscription Orders (copy)_939563473374679040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscriber_users]) /  sum([unique_users])' />
            </column>
            <column caption='% Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_1172061848810430467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisitions])/SUM([unique_users])' />
            </column>
            <column caption='% Retained' datatype='real' default-format='p0.0%' name='[Calculation_1172061848810659844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_customers])/SUM([unique_users])' />
            </column>
            <column caption='% Reactivated' datatype='real' default-format='p0.0%' name='[Calculation_1172061848810795013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_customers])/SUM([unique_users])' />
            </column>
            <column caption='% Multivertical Users' datatype='real' default-format='p0.00%' name='[Calculation_1172061848810901510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([multivertical_customers])/SUM([unique_users])' />
            </column>
            <column caption='Active Users' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202071203884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([unique_users])' />
            </column>
            <column caption='Gap to Wolt' datatype='integer' name='[Calculation_1179380202071867437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gap_to_wolt])' />
            </column>
            <column caption='% CPC Vendor Penetration' datatype='real' default-format='p0.0%' name='[Calculation_1681250085836156928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_vendors]) / sum([active_vendors_with_order])' />
            </column>
            <column caption='% VFD AB Penetration' datatype='real' default-format='p0.0%' name='[Calculation_1681250085836468225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_ab_vendors]) / sum([ab_vendors_with_order])' />
            </column>
            <column caption='Month Filter' datatype='boolean' name='[Calculation_52072871510233092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &gt;= DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),[Parameters].[report_month Parameter])&#13;&#10;AND&#13;&#10;[report_month] &lt;= [Parameters].[report_month Parameter]' />
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_52072871512281094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM Title' datatype='string' name='[Calculation_52072871513169927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; MoM&quot;' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_638385247264137220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(orders) / sum(unique_users)' />
            </column>
            <column caption='# LaaS Orders Successful' datatype='integer' name='[Calculation_6816057346453442560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([laas_orders_delivered])' />
            </column>
            <column caption='% LaaS Orders Fail Rate' datatype='real' name='[Calculation_6816057346453602305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([laas_orders_cancelled])/(sum([laas_orders_delivered])+sum([laas_orders_cancelled]))' />
            </column>
            <column datatype='integer' name='[ab_vendors_with_order]' role='measure' type='quantitative' />
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_vendors_with_order]' role='measure' type='quantitative' />
