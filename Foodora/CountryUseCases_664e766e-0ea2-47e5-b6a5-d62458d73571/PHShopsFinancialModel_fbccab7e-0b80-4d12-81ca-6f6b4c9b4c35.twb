          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lip69a1v3iwsz1cngtlr007y7b2'>
            <column caption='gmv' datatype='real' name='[Calculation_1329687851010191361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_gfv])&#13;&#10;+SUM([total_successful_delivery_fee_excl_vat])&#13;&#10;+SUM([total_successful_service_fee_excl_vat])' />
