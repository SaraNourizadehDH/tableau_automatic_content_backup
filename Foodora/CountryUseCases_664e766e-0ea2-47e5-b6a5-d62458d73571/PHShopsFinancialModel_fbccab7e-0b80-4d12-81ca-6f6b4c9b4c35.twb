    <worksheet name='P&amp;L Waterfall'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Profit &amp; Loss Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='shops daily vendor pnl values' name='federated.0lip69a1v3iwsz1cngtlr007y7b2' />
          </datasources>
          <datasource-dependencies datasource='federated.0lip69a1v3iwsz1cngtlr007y7b2'>
            <column caption='P&amp;L Waterfall - Total Delivery Cost' datatype='real' name='[Calculation_1045116651993595908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- ABS([Calculation_1779203389065015297])' />
            </column>
            <column caption='P&amp;L Waterfall - EBITDA' datatype='real' hidden='true' name='[Calculation_1045116651994320903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([Calculation_1779203389068652548])' />
            </column>
            <column caption='P&amp;L Waterfall - Incentives' datatype='real' name='[Calculation_1045116651996004360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- ABS([Calculation_191121563159650313])' />
            </column>
            <column caption='P&amp;L Waterfall - SG&amp;A' datatype='real' name='[Calculation_1045116651996286985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- ABS(MIN([c6]))' />
            </column>
            <column caption='Total NCR 2' datatype='real' name='[Calculation_1050746098311479296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_789537319631179780],0)' />
            </column>
            <column caption='Small Order Fee' datatype='real' name='[Calculation_1050746098320723970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([total_successful_difference_to_mov_excl_vat],0))' />
            </column>
            <column caption='cost of sale' datatype='real' name='[Calculation_1329687851013406723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([c5])*SUM([successful_orders])' />
            </column>
            <column caption='total delivery cost' datatype='real' name='[Calculation_1779203389065015297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([c10])*SUM([successful_orders])' />
            </column>
            <column caption='gross profit' datatype='real' name='[Calculation_1779203389065883650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_191121563163029517]+[Calculation_1779203389065015297]+[Calculation_1329687851013406723]+SUM(IFNULL([c4],0))' />
            </column>
            <column caption='fully loaded gross profit' datatype='real' name='[Calculation_1779203389068378115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1779203389065883650]+[Calculation_191121563159650313]' />
            </column>
            <column caption='ebitda' datatype='real' name='[Calculation_1779203389068652548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1779203389068378115] + SUM([c6])' />
            </column>
            <column caption='incentives' datatype='real' name='[Calculation_191121563159650313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM([total_successful_foodpanda_discount])+SUM([total_successful_foodpanda_voucher])-SUM([coop_cs_corp_voucher_total]))' />
            </column>
            <column caption='total revenue' datatype='real' name='[Calculation_191121563163029517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_commission_excl_vat])+SUM([total_successful_delivery_fee_excl_vat])+SUM([total_successful_pro_fd_discount_value_from_foodpanda])+SUM([total_successful_service_fee_excl_vat])+[Calculation_1050746098311479296]+[Calculation_1050746098320723970]' />
            </column>
