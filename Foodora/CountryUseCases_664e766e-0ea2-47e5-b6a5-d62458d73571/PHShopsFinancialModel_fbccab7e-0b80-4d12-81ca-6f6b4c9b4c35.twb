              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[report_date],&apos;monday&apos;)&#13;&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;iso-week&apos;,[report_date])&#13;&#10;WHEN &quot;Daily&quot; THEN [report_date]&#13;&#10;END' />
            </column>
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1406811999571304449]' derivation='Month-Trunc' name='[tmn:Calculation_1406811999571304449:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[total_successful_delivery_fee_excl_vat]' role='measure' type='quantitative' />
