      <table>
        <view>
          <datasources>
            <datasource caption='shops daily vendor pnl values' name='federated.0lip69a1v3iwsz1cngtlr007y7b2' />
            <datasource caption='phda_accesses' name='federated.0nyoysa1c8eru61c3ik1b0oqelfk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Category Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All Categories&quot;'>
              <calculation class='tableau' formula='&quot;All Categories&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lip69a1v3iwsz1cngtlr007y7b2'>
            <column caption='Total NCR 2' datatype='real' name='[Calculation_1050746098311479296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_789537319631179780],0)' />
            </column>
            <column caption='Delivery Cost Supp.' datatype='real' name='[Calculation_1050746098316681217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1329687851012624386]) + [Calculation_1779203389063061504] + [Calculation_1329687851015962630]' />
            </column>
            <column caption='Small Order Fee' datatype='real' name='[Calculation_1050746098320723970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([total_successful_difference_to_mov_excl_vat],0))' />
            </column>
            <column caption='Small Order Fee/o' datatype='real' name='[Calculation_1050746098321371139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1050746098320723970]/SUM([successful_orders])' />
            </column>
            <column caption='category granularity' datatype='string' name='[Calculation_118782504325472260]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;All Categories&quot; THEN &quot;All Categories&quot;&#13;&#10;WHEN &quot;Child Category&quot; THEN [child_category]&#13;&#10;WHEN &quot;Parent Category&quot; THEN [parent_category]&#13;&#10;WHEN &quot;Main Categories&quot; THEN &#13;&#10;  IF [parent_category] IN(&quot;convenience&quot;,&quot;supermarket&quot;,&quot;Bakery&quot;) THEN [parent_category]&#13;&#10;  ELSE &quot;Others&quot;&#13;&#10;  END&#13;&#10;WHEN &quot;Chain&quot; THEN [chain_name]&#13;&#10;END' />
              <aliases>
                <alias key='&quot;alcoholic_drinks&quot;' value='Alcoholic Drinks' />
                <alias key='&quot;butchery&quot;' value='Butchery' />
                <alias key='&quot;convenience&quot;' value='Convenience' />
                <alias key='&quot;fashion&quot;' value='Fashion' />
                <alias key='&quot;fishery&quot;' value='Fishery' />
                <alias key='&quot;flowers_and_plants&quot;' value='Flowers and Plants' />
                <alias key='&quot;fruits_and_vegetables&quot;' value='Fruits and Vegetables' />
                <alias key='&quot;games&quot;' value='Games' />
                <alias key='&quot;health_and_wellness&quot;' value='Health and Wellness' />
                <alias key='&quot;just_for_adults&quot;' value='Just for Adults' />
                <alias key='&quot;mini_market&quot;' value='Mini Market' />
                <alias key='&quot;mother_and_baby&quot;' value='Mother and Baby' />
                <alias key='&quot;snacks_and_sweets&quot;' value='Snacks and Sweets' />
                <alias key='&quot;specialty_and_ethnic&quot;' value='Specialty and Ethnic' />
                <alias key='&quot;sports_and_lifestyle&quot;' value='Sports and Lifestyle' />
                <alias key='&quot;stationery_and_books&quot;' value='Stationery and Books' />
                <alias key='&quot;supermarket&quot;' value='Supermarket' />
                <alias key='&quot;tobacco&quot;' value='Tobacco' />
                <alias key='&quot;vehicles&quot;' value='Vehicles' />
                <alias key='&quot;wet_market&quot;' value='Wet Market' />
              </aliases>
            </column>
            <column caption='shopper cost/o' datatype='real' name='[Calculation_1329687850974642176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([c4],0))/SUM([successful_orders])' />
            </column>
            <column caption='gmv' datatype='real' name='[Calculation_1329687851010191361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_gfv])&#13;&#10;+SUM([total_successful_delivery_fee_excl_vat])&#13;&#10;+SUM([total_successful_service_fee_excl_vat])' />
            </column>
            <column caption='rider salary' datatype='real' name='[Calculation_1329687851012624386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[total_rider_payment]' />
            </column>
            <column caption='cost of sale' datatype='real' name='[Calculation_1329687851013406723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([c5])*SUM([successful_orders])' />
            </column>
            <column caption='other del cost/o' datatype='real' name='[Calculation_1329687851015417861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([c1])+MIN([c2])+MIN([c3])' />
            </column>
            <column caption='other delivery cost' datatype='real' name='[Calculation_1329687851015962630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1329687851015417861]*SUM([successful_orders])' />
            </column>
            <column caption='date granularity' datatype='datetime' name='[Calculation_1406811999571304449]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;,[report_date],&apos;monday&apos;)&#13;&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;iso-week&apos;,[report_date])&#13;&#10;WHEN &quot;Daily&quot; THEN [report_date]&#13;&#10;END' />
            </column>
            <column caption='lofo' datatype='real' name='[Calculation_1779203389063061504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-MAX(wastage_per_order)*SUM([successful_OD_orders])' />
            </column>
            <column caption='total delivery cost' datatype='real' name='[Calculation_1779203389065015297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([c10])*SUM([successful_orders])' />
            </column>
            <column caption='gross profit' datatype='real' name='[Calculation_1779203389065883650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_191121563163029517]+[Calculation_1779203389065015297]+[Calculation_1329687851013406723]+SUM(IFNULL([c4],0))' />
            </column>
            <column caption='fully loaded gross profit' datatype='real' name='[Calculation_1779203389068378115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1779203389065883650]+[Calculation_191121563159650313]' />
            </column>
            <column caption='ebitda' datatype='real' name='[Calculation_1779203389068652548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1779203389068378115] + SUM([c6])' />
            </column>
            <column caption='del cost/o' datatype='real' name='[Calculation_1779203389069504517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([c10])*SUM([successful_orders]))/SUM([successful_orders])' />
            </column>
            <column caption='total del cost/o' datatype='real' name='[Calculation_1779203389069832198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1779203389069504517]+[Calculation_1329687850974642176]' />
            </column>
            <column caption='net rev/o' datatype='real' name='[Calculation_1779203389070127111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_191121563159224328]+[Calculation_1779203389069832198]' />
            </column>
            <column caption='gp/o' datatype='real' name='[Calculation_1779203389070389256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1779203389070127111]+MIN([c5])' />
            </column>
            <column caption='flgp/o' datatype='real' name='[Calculation_1779203389070729225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1779203389070389256]+[Calculation_191121563159797770]' />
            </column>
            <column caption='daily_orders' datatype='real' name='[Calculation_191121563150516224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])/MAX([Calculation_956170551840862208])' />
            </column>
            <column caption='afv' datatype='real' name='[Calculation_191121563154755585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_gfv])/SUM([successful_orders])' />
            </column>
            <column caption='commission %' datatype='real' name='[Calculation_191121563155009538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_commission_excl_vat])/SUM([total_successful_gfv])' />
            </column>
            <column caption='com rev/o' datatype='real' name='[Calculation_191121563156791299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_commission_excl_vat])/SUM([successful_orders])' />
            </column>
            <column caption='df/o' datatype='real' name='[Calculation_191121563157463044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_delivery_fee_excl_vat])/SUM([successful_orders])' />
            </column>
            <column caption='pandapro fd/o' datatype='real' name='[Calculation_191121563158188037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_pro_fd_discount_value_from_foodpanda])/SUM([successful_orders])' />
            </column>
            <column caption='sf/o' datatype='real' name='[Calculation_191121563158736902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_service_fee_excl_vat])/SUM([successful_orders])' />
            </column>
            <column caption='total rev/o' datatype='real' name='[Calculation_191121563159224328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_191121563156791299]+[Calculation_191121563157463044]+[Calculation_191121563158188037]+[Calculation_191121563158736902]+[Calculation_956170551847763975]+ [Calculation_1050746098321371139]' />
            </column>
            <column caption='incentives' datatype='real' name='[Calculation_191121563159650313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM([total_successful_foodpanda_discount])+SUM([total_successful_foodpanda_voucher])-SUM([coop_cs_corp_voucher_total]))' />
            </column>
            <column caption='icpo' datatype='real' name='[Calculation_191121563159797770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_191121563159650313]/SUM([successful_orders])' />
            </column>
            <column caption='icpgmv' datatype='real' name='[Calculation_191121563160399883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_191121563159650313]/[Calculation_1329687851010191361]' />
            </column>
            <column caption='total revenue' datatype='real' name='[Calculation_191121563163029517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_successful_commission_excl_vat])+SUM([total_successful_delivery_fee_excl_vat])+SUM([total_successful_pro_fd_discount_value_from_foodpanda])+SUM([total_successful_service_fee_excl_vat])+[Calculation_1050746098311479296]+[Calculation_1050746098320723970]' />
            </column>
            <column caption='                                         FLGPO' datatype='integer' name='[Calculation_254453441982599170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
