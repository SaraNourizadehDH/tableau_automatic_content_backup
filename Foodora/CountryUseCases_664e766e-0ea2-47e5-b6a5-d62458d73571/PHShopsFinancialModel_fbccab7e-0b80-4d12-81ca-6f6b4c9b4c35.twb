            <column caption='Vendor Count' datatype='integer' name='[Calculation_789537319578189824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_name])' />
            </column>
            <column caption='Orders/Vendor' datatype='real' name='[Calculation_789537319578894337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])/[Calculation_789537319578189824]' />
            </column>
            <column caption='Orders/Vendor/Day' datatype='real' name='[Calculation_789537319579111426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_789537319578894337]/COUNTD([report_date])' />
