            <column caption='Total NCR' datatype='real' name='[Calculation_789537319631179780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([ncr_platform_fee_revenue_excl_vat], 0)) + SUM(IFNULL([total_onboarding_fees],0)) + SUM(IFNULL([excess_data_amount],0)) +SUM(IFNULL([cpc_revenue],0)) + SUM(IFNULL([cpp_revenue],0)) + SUM(IFNULL([total_db_amount],0)) + SUM(IFNULL([c11],0)) + SUM([c12])' />
            </column>
