              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [shrinkages_dur_min_adj]/60 END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [shrinkages_dur_min_adj]/60 END)-1' />
            </column>
