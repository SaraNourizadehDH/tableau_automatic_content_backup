              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [successful_orders] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [successful_orders] END)-1' />
            </column>
            <column caption='# Zombie Vendors - WoW' datatype='real' name='[# Zombie Vendors (copy)_1884193560466055194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [zombie] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [zombie] END)-1' />
            </column>
            <column caption='% Commission - OD - WoW' datatype='real' name='[% Commission - OD (copy)_1884193560466182171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;OD&quot; THEN [commission_percentage_local] end)&#13;&#10;/suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;OD&quot; THEN [commissionable_value] end))&#13;&#10;/&#13;&#10;(suM(if week_type = &quot;LW&quot; AND [delivery_type]=&quot;OD&quot; THEN [commission_percentage_local] end)&#13;&#10;/suM(if week_type = &quot;LW&quot; AND [delivery_type]=&quot;OD&quot; THEN [commissionable_value] end))&#13;&#10;-1' />
            </column>
            <column caption='% Commission - Pickup - WoW' datatype='real' name='[% Commission - Pickup (copy)_1884193560466313244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;PICKUP&quot; THEN [commission_percentage_local] end)&#13;&#10;/suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;PICKUP&quot; THEN [commissionable_value] end))&#13;&#10;/&#13;&#10;(suM(if week_type = &quot;LW&quot; AND [delivery_type]=&quot;PICKUP&quot; THEN [commission_percentage_local] end)&#13;&#10;/suM(if week_type = &quot;LW&quot; AND [delivery_type]=&quot;PICKUP&quot; THEN [commissionable_value] end))&#13;&#10;-1' />
            </column>
            <column caption='% Commission - VD - WoW' datatype='real' name='[% Commission - VD (copy)_1884193560466505757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;VD&quot; THEN [commission_percentage_local] end)&#13;&#10;/suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;VD&quot; THEN [commissionable_value] end))&#13;&#10;/&#13;&#10;(suM(if week_type = &quot;LW&quot; AND [delivery_type]=&quot;VD&quot; THEN [commission_percentage_local] end)&#13;&#10;/suM(if week_type = &quot;LW&quot; AND [delivery_type]=&quot;VD&quot; THEN [commissionable_value] end))&#13;&#10;-1' />
