      </column>
      <column caption='test' datatype='integer' name='[Calculation_1884193560442859524]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF MAX([week_commencing])=WINDOW_MAX(MAX([week_commencing])) THEN 1&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
