      </column>
      <column caption='% Commission - OD (Est)' datatype='real' name='[Calculation_930837778198581258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;OD&quot; THEN [commission_percentage_local] end)&#13;&#10;/suM(if week_type = &quot;CW&quot; AND [delivery_type]=&quot;OD&quot; THEN [commissionable_value] end)' />
      </column>
      <column caption='Take In (LC)' datatype='real' name='[Calculation_930837778206253074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([df_take_in],0)&#13;&#10;+IFNULL([commission_percentage_local],0)&#13;&#10;+IFNULL([additional_charges],0)&#13;&#10;-IFNULL([discount_food_foodora_paid],0)&#13;&#10;-IFNULL([vouchers_food_foodora_paid],0)' />
      </column>
      <column caption='Avg. Take In - OD (Est)' datatype='real' name='[Calculation_930837778206572563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF week_type = &quot;CW&quot; AND  [delivery_type]=&quot;OD&quot; then [Calculation_930837778206253074] end)/&#13;&#10;sum(IF week_type = &quot;CW&quot; AND  [delivery_type]=&quot;OD&quot; then [invoiced_billable] end)' />
      </column>
      <column caption='# Cancelled After Sent' datatype='integer' name='[Cancelled Before Sent (copy)_1554867794214854682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or ((([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_after_sent] END' />
      </column>
      <column caption='NPS (After Order) - WoW' datatype='real' name='[NPS (After Order) (copy)_1884193560471351357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((sum(IF week_type = &quot;CW&quot; THEN [promoter] END)-sum(IF week_type = &quot;CW&quot; THEN [detractor] END))&#13;&#10;/sum(IF week_type = &quot;CW&quot; THEN [nps_responses] END))*100)&#13;&#10;/&#13;&#10;(((sum(IF week_type = &quot;LW&quot; THEN [promoter] END)-sum(IF week_type = &quot;LW&quot; THEN [detractor] END))&#13;&#10;/sum(IF week_type = &quot;LW&quot; THEN [nps_responses] END))*100)&#13;&#10;-1' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Order Frequency - WoW' datatype='real' name='[Order Frequency (copy)_1884193560471527486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF week_type = &quot;CW&quot; THEN [successful_orders] END)&#13;&#10;/sum(IF week_type = &quot;CW&quot; AND  [report_dim]=[Parameters].[Parameter 1] THEN [active_customers] END))&#13;&#10;/&#13;&#10;(sum(IF week_type = &quot;LW&quot; THEN [successful_orders] END)&#13;&#10;/sum(IF week_type = &quot;LW&quot; AND  [report_dim]=[Parameters].[Parameter 1] THEN [active_customers] END))&#13;&#10;-1' />
      </column>
      <column caption='UTR - WoW' datatype='real' name='[UTR (copy)_1884193560471814207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(IF week_type = &quot;CW&quot; AND (  report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_completed_order] END)&#13;&#10;/sum(IF week_type = &quot;CW&quot; AND (  report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [actual_working_time]/60/60 END))&#13;&#10;/&#13;&#10;(sum(IF week_type = &quot;LW&quot; AND (  report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_completed_order] END)&#13;&#10;/sum(IF week_type = &quot;LW&quot; AND (  report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [actual_working_time]/60/60 END))&#13;&#10;-1' />
      </column>
