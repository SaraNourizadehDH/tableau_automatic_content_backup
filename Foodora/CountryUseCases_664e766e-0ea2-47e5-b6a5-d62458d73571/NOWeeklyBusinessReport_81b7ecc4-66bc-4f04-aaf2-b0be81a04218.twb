    <worksheet name='p_Overview_WoW'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_weekly_business_report (bl_nordics)' name='federated.0ed17a9171l8rs0zq1lzs00w77qa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='View' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ed17a9171l8rs0zq1lzs00w77qa'>
            <column caption='# Acquisitions - WoW' datatype='real' name='[# Acquisitions (copy)_1884193560462647304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [new_customers] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [new_customers] END)-1' />
            </column>
            <column caption='# Active Customers - WoW' datatype='real' name='[# Active Customers (copy)_1884193560462893065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; AND  [report_dim]=[Parameters].[Parameter 1] THEN [active_customers] END)/&#13;&#10;SUM(IF week_type = &quot;LW&quot; AND  [report_dim]=[Parameters].[Parameter 1] THEN [active_customers] END)-1' />
            </column>
            <column caption='# Active Vendors - WoW' datatype='real' name='[# Active Vendors (copy)_1884193560463028234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [active] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [active] END)-1' />
            </column>
            <column caption='# Active Vendors - OD - WoW' datatype='real' name='[# Active Vendors - OD (copy)_1884193560463163403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [active_od] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [active_od] END)-1' />
            </column>
            <column caption='# Active Vendors - VD - WoW' datatype='real' name='[# Active Vendors - VD (copy)_1884193560463306764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [active_vd] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [active_vd] END)-1' />
            </column>
            <column caption='# Cancelled After Sent - WoW' datatype='real' name='[# Cancelled After Sent (copy)_1884193560463482893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or ((([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_after_sent] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; AND ( report_dim=&quot;Total&quot; or ((([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_after_sent] END)-1' />
            </column>
            <column caption='# Cancelled Before Sent - WoW' datatype='real' name='[# Cancelled Before Sent (copy)_1884193560463622158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_before_sent] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_before_sent] END)-1' />
            </column>
            <column caption='# Cancelled Orders - WoW' datatype='real' name='[# Cancelled Orders (copy)_1884193560463749135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_order] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_order] END)-1' />
            </column>
            <column caption='# Concept Orders - WoW' datatype='real' name='[# Concept Orders (copy)_1884193560463867920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [concept_orders] END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [concept_orders] END)-1' />
            </column>
            <column caption='# Hours Closed - WoW' datatype='real' name='[# Hours Closed (copy)_1884193560464113682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF week_type = &quot;CW&quot; THEN [closures_dur_min_adj]/60 END)&#13;&#10;/SUM(IF week_type = &quot;LW&quot; THEN [closures_dur_min_adj]/60 END)-1' />
            </column>
