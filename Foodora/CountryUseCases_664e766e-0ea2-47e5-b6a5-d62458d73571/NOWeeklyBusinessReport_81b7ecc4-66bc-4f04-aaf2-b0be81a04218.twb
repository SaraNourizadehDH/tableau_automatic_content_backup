        <calculation class='tableau' formula='IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_order] END' />
