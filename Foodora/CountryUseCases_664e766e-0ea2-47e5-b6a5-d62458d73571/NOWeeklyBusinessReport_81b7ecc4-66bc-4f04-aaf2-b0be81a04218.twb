              <calculation class='tableau' formula='(sum(IF week_type = &quot;CW&quot; THEN [fd_orders] END)&#13;&#10;/sum(IF week_type = &quot;CW&quot; THEN [delivery_order] END))&#13;&#10;/&#13;&#10;(sum(IF week_type = &quot;LW&quot; THEN [fd_orders] END)&#13;&#10;/sum(IF week_type = &quot;LW&quot; THEN [delivery_order] END))&#13;&#10;-1' />
