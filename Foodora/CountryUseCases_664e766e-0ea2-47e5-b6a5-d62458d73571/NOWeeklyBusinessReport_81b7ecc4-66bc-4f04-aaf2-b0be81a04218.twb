      </column>
      <column caption='% Order Delay &gt; 10 min' datatype='real' name='[Calculation_1554867794213015571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [delay_cnt10] END)&#13;&#10;/sum(IF week_type = &quot;CW&quot; AND (  report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [delay_obs] END)' />
