              <calculation class='tableau' formula='(sum(IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_order] END)&#13;&#10;/sum(IF week_type = &quot;CW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_gross_ord] END))&#13;&#10;/&#13;&#10;(sum(IF week_type = &quot;LW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_cancelled_order] END)&#13;&#10;/sum(IF week_type = &quot;LW&quot; AND ( report_dim=&quot;Total&quot; or (([report_dim] =&quot;City&quot; or [report_dim] =&quot;Zone&quot;) and [Calculation_1554867794209746960]&lt;&gt;&quot;Non-Logistics Area&quot;) ) THEN [log_gross_ord] END))&#13;&#10;-1' />
            </column>
