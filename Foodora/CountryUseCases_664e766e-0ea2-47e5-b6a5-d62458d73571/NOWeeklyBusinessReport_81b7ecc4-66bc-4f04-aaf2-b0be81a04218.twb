      <column caption='CSAT Score' datatype='real' name='[Calculation_820781054995324930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF week_type = &quot;CW&quot; THEN [csat_denom] END)&#13;&#10;/suM(IF week_type = &quot;CW&quot; THEN [cs_csat_responses] END)' />
