              <calculation class='tableau' formula='(sum(IF week_type = &quot;CW&quot; THEN [issues] END)&#13;&#10;/sum(IF week_type = &quot;CW&quot; THEN [gross_orders] END))&#13;&#10;/&#13;&#10;(sum(IF week_type = &quot;LW&quot; THEN [issues] END)&#13;&#10;/sum(IF week_type = &quot;LW&quot; THEN [gross_orders] END))&#13;&#10;-1' />
