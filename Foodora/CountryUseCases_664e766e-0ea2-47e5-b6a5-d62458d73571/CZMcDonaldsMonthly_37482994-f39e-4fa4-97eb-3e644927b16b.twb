            <column caption='Avg At Vendor Time' datatype='real' name='[Avg Delivery Time (copy)_490892402262003718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_min])/SUM([at_vendor_time_count])' />
            </column>
            <column caption='Transactions Per Engaged Customer' datatype='real' name='[Avg Delivery Time (copy)_490892402262564871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])/SUM([users])' />
            </column>
            <column caption='Overall Customer Retention Rate (2M)' datatype='real' default-format='p0.00%' name='[CSAT Promoters % (copy)_490892402268442637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_60d_customers])/SUM([retention_60d_base])' />
            </column>
            <column caption='Change in Platform Acquisitions (1M)' datatype='real' default-format='p0.00%' name='[Calculation_490892402266456073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_acquisitions])/SUM([last_m_platform_acquisitions])-1' />
            </column>
            <column caption='Change in Platform Acquisitions (3M)' datatype='real' default-format='p0.00%' name='[Change in Platform Acquisitions (1M) (copy)_490892402266681354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_acquisitions])/SUM([last_q_platform_acquisitions])-1' />
            </column>
            <column caption='Change in Transactions per Customer (1M)' datatype='real' default-format='p0.00%' name='[Change in Platform Acquisitions (1M) (copy)_490892402268176396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg Delivery Time (copy)_490892402262564871]/[Transactions Per Engaged Customer (copy)_490892402267992075]-1' />
            </column>
            <column caption='Existing Customer Retention Rate (2M)' datatype='real' default-format='p0.00%' name='[New Customer Retention Rate (copy)_490892402269794319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_60d_customers] - [retained_60d_customers_new])/SUM([retention_60d_base] - [retention_60d_base_new])' />
            </column>
            <column caption='New Customer Retention Rate (2M)' datatype='real' default-format='p0.00%' name='[Overall Customer Retention Rate (copy)_490892402269642766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_60d_customers_new])/SUM([retention_60d_base_new])' />
            </column>
            <column caption='Last M Transactions Per Customer' datatype='real' name='[Transactions Per Engaged Customer (copy)_490892402267992075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([last_m_successful_orders])/SUM([last_m_users])' />
            </column>
