              <calculation class='tableau' formula='SUM([at_customer_time_min])/SUM([at_customer_time_count])' />
            </column>
            <column caption='Avg Fullfillment Time ' datatype='real' name='[Avg At Vendor Time (copy)_1318710309046738945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(bag_time_min)/SUM([bag_time_count]) - [Avg At Vendor Time (copy)_1318710309046632448]' />
            </column>
            <column caption='Avg CSAT Rating' datatype='real' name='[Avg Delivery Time (copy)_490892402256277506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_score_total])/SUM([csat_responses])' />
            </column>
            <column caption='Avg At Vendor Time' datatype='real' name='[Avg Delivery Time (copy)_490892402262003718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_min])/SUM([at_vendor_time_count])' />
            </column>
            <column caption='Hit Rate % (20 min)' datatype='real' default-format='p0.00%' name='[CSAT Promoters % (copy)_490892402257178628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_in_hitrate_mcd])/SUM([hitrate_mcd_base])' />
            </column>
            <column caption='Refund Rate %' datatype='real' default-format='p0.00%' name='[CSAT Promoters % (copy)_490892402271084560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensations_resto_amount])/SUM([gmv])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_490892402254319616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([act_delivery_time])/SUM([successful_orders_not_preorder])' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_490892402254790657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/(SUM([failed_orders]) + SUM([successful_orders]))' />
            </column>
            <column caption='CSAT Promoters %' datatype='real' default-format='p0.00%' name='[Fail Rate (copy)_490892402256470019]' role='measure' type='quantitative'>
