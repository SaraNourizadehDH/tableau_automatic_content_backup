      <column caption='Avg CSAT Rating' datatype='real' name='[Avg Delivery Time (copy)_490892402256277506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([csat_score_total])/SUM([csat_responses])' />
      </column>
      <column caption='Avg At Vendor Time' datatype='real' name='[Avg Delivery Time (copy)_490892402262003718]' role='measure' type='quantitative'>
