      <column caption='Avg At Customer Time' datatype='real' name='[Avg At Vendor Time (copy)_1318710309046632448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([at_customer_time_min])/SUM([at_customer_time_count])' />
      </column>
      <column caption='Avg Fullfillment Time ' datatype='real' name='[Avg At Vendor Time (copy)_1318710309046738945]' role='measure' type='quantitative'>
