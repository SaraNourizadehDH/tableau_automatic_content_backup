      </column>
      <column caption='Transactions Per Engaged Customer' datatype='real' name='[Avg Delivery Time (copy)_490892402262564871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])/SUM([users])' />
      </column>
      <column caption='Hit Rate % (20 min)' datatype='real' default-format='p0.00%' name='[CSAT Promoters % (copy)_490892402257178628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_in_hitrate_mcd])/SUM([hitrate_mcd_base])' />
      </column>
      <column caption='Overall Customer Retention Rate (2M)' datatype='real' default-format='p0.00%' name='[CSAT Promoters % (copy)_490892402268442637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_60d_customers])/SUM([retention_60d_base])' />
      </column>
      <column caption='Refund Rate %' datatype='real' default-format='p0.00%' name='[CSAT Promoters % (copy)_490892402271084560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([compensations_resto_amount])/SUM([gmv])' />
      </column>
      <column caption='PP Violation' datatype='string' name='[Calculation_1541919983087665178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Yes&quot;' />
