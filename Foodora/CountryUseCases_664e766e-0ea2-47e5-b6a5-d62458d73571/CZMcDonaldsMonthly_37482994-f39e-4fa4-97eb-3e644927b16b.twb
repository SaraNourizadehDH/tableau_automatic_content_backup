      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_490892402254319616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([act_delivery_time])/SUM([successful_orders_not_preorder])' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_490892402254790657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])/(SUM([failed_orders]) + SUM([successful_orders]))' />
