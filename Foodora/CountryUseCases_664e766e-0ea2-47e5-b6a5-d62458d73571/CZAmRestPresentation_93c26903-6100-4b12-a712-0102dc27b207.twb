      <column caption='% CVR' datatype='real' default-format='p0.0%' name='[Calculation_1157143688506572801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688514347027]/[Calculation_1157143688506400768]' />
      </column>
      <column caption='Users t-1' datatype='integer' name='[Calculation_1157143688509292551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ZN([Calculation_1157143688513679376]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Vendor Reorder Rate' datatype='real' default-format='p0%' name='[Calculation_1157143688509468680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorder_users_vendor])/SUM([active_users_previous_period])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1157143688510693385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv])/ [Calculation_1157143688514347027]' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1157143688511037450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([act_delivery_time])/SUM([orders_not_preorder])' />
      </column>
      <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1157143688511565835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([completed_orders])' />
      </column>
      <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1157143688511807500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_scheduled_open_seconds])-SUM(IFNULL([total_closed_seconds],0)))/SUM([total_scheduled_open_seconds])' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1157143688512045069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([failed_orders_vendor],0))/ SUM(IFNULL([successful_orders],0)+IFNULL([failed_orders],0))' />
      </column>
      <column caption='# New Users Platform' datatype='integer' name='[Calculation_1157143688513216526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_users_platform])' />
      </column>
      <column caption='# New Users Vendor' datatype='integer' name='[Calculation_1157143688513413135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_users_vendor])' />
      </column>
      <column caption='# Users Vendor' datatype='integer' name='[Calculation_1157143688513679376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_users])' />
      </column>
      <column caption='GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1157143688514240530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv])' />
      </column>
      <column caption='# Orders' datatype='integer' name='[Calculation_1157143688514347027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])' />
      </column>
      <column caption='Total CR (Commission Revenue)' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1157143688516239380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_revenue])' />
      </column>
      <column caption='% VFD / GMV' datatype='real' default-format='p0.00%' name='[Calculation_1157143688516964373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vf_deal_value])/[Calculation_1157143688514240530]' />
      </column>
      <column caption='% Deal Orders' datatype='real' default-format='p0.0%' name='[Calculation_1157143688518098967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_orders])/[Calculation_1157143688514347027]' />
      </column>
      <column caption='Avg Resto Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1157143688518340632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_rating_vendor_food_score_sum])/SUM([customer_rating_vendor_food_score_cnt])' />
      </column>
      <column caption='# Customer Ratings' datatype='integer' name='[Calculation_1157143688518467609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_rating_vendor_food_score_cnt])' />
      </column>
      <column caption='Total VFD (Vendor Funded Deal)' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1157143688518881306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vf_deal_value])' />
      </column>
      <column caption='Month Filter Year on Year' datatype='boolean' name='[Calculation_1157143688773427229]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Month Filter (copy)_1157143688765493275] OR [Month Filter LY (copy)_1157143688773287964]' />
      </column>
      <column caption='% CVR vs Target' datatype='real' name='[Calculation_1157143688785575986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688506572801]/[% CVR (copy)_1157143688779743262]-1' />
      </column>
      <column caption='% Vendor Fail Rate vs Target' datatype='real' name='[Calculation_1157143688785862707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688512045069] / [% Vendor Fail Rate (copy)_1157143688780468255] - 1' />
      </column>
      <column caption='% VFD / GMV vs Target' datatype='real' name='[Calculation_1157143688785948724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688516964373] / [% VFD / GMV (copy)_1157143688780718112] - 1' />
      </column>
      <column caption='Vendor City Tier' datatype='string' name='[Calculation_1157143688787722293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF lower([vendor_city]) = &apos;praha&apos; then &apos;Tier 1 - Praha&apos;&#13;&#10;ELSEIF lower([vendor_city]) IN (&apos;brno&apos;,&apos;ostrava&apos;,&apos;plzeň&apos;,&apos;liberec&apos;,&apos;olomouc&apos;) then &apos;Tier 2 - 100k+&apos;&#13;&#10;ELSEIF lower([vendor_city]) IN (&#13;&#10;&apos;české budějovice&apos;,&#13;&#10;&apos;pardubice&apos;,&#13;&#10;&apos;ústí nad labem&apos;,&#13;&#10;&apos;hradec králové&apos;,&#13;&#10;&apos;zlín&apos;,&#13;&#10;&apos;havířov&apos;,&#13;&#10;&apos;kladno&apos;,&#13;&#10;&apos;most&apos;,&#13;&#10;&apos;opava&apos;,&#13;&#10;&apos;frýdek-místek&apos;,&#13;&#10;&apos;karviná&apos;,&#13;&#10;&apos;jihlava&apos;) THEN &apos;Tier 3 - 50k+&apos;&#13;&#10;ELSE &apos;Tier 4&apos; END' />
      </column>
      <column caption='Incubation Filter' datatype='string' name='[Calculation_1180224592332562432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if dateadd(&apos;month&apos;, 1, [last_activation_date]) &gt;= today()-1 then &apos;Incubation 1st month&apos;&#13;&#10;elseif dateadd(&apos;month&apos;, 2, [last_activation_date]) &gt;= today()-1 then &apos;Incubation 2nd month&apos;&#13;&#10;else &apos;Not in Incubation&apos;&#13;&#10;end' />
      </column>
      <column caption='% Vendor Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_1180506056302272512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688513413135]/[Calculation_1157143688513679376]' />
      </column>
      <column caption='Security Filter' datatype='boolean' name='[Calculation_1213720110138232832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() in (&#13;&#10;//BI&#13;&#10;&apos;katerina.pankova@foodora.cz&apos;,&#13;&#10;&apos;matyas.kapusta@foodora.cz&apos;,&#13;&#10;&apos;jakub.rajnis@foodora.cz&apos;,&#13;&#10;//Commercial&#13;&#10;&apos;milos.dlouhy@damejidlo.cz&apos;,&#13;&#10;&apos;josef.omcirk@damejidlo.cz&apos;,&#13;&#10;&apos;alexej.cestnoj@damejidlo.cz&apos;,&#13;&#10;&apos;milan.menda@damejidlo.cz&apos;,&#13;&#10;&apos;david.bakalar@damejidlo.cz&apos;,&#13;&#10;&apos;tomas.kodenko@damejidlo.cz&apos;,&#13;&#10;&apos;tomas.majer@foodora.cz&apos;,&#13;&#10;&apos;michal.karizek@foodora.cz&apos;,&#13;&#10;&apos;vaclav.mokry@foodora.cz&apos;)&#13;&#10;&#13;&#10;OR REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;)  = REPLACE([account_manager_email], &apos;damejidlo&apos;, &apos;foodora&apos;)&#13;&#10;&#13;&#10;OR REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;)  = REPLACE([hunter_email], &apos;damejidlo&apos;, &apos;foodora&apos;)&#13;&#10;&#13;&#10;//Long Tail Team&#13;&#10;/////Nováčci smí vidět Davidovo portfolio.&#13;&#10;&#13;&#10;OR (REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;)  IN (&apos;daniel.cerny@foodora.cz&apos;, &apos;tereza.krejcova@foodora.cz&apos;)&#13;&#10;AND&#13;&#10;REPLACE([account_manager_email], &apos;damejidlo&apos;, &apos;foodora&apos;) = &apos;david.bakalar@foodora.cz&apos;)&#13;&#10;&#13;&#10;////Dominik Malý smí vidět portfolia celého Long Tail Teamu, protože funguje jako buddy pro nováčky.&#13;&#10;&#13;&#10;OR (REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;)  = &apos;dominik.maly@foodora.cz&apos;&#13;&#10;AND&#13;&#10;REPLACE([account_manager_email], &apos;damejidlo&apos;, &apos;foodora&apos;) IN (&apos;david.bakalar@foodora.cz&apos;, &apos;tomas.majer@foodora.cz&apos;, &apos;daniel.cerny@foodora.cz&apos;, &apos;tereza.krejcova@foodora.cz&apos;)&#13;&#10;)' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_129759970317877250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='label orders' datatype='string' name='[Calculation_129759970327588867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Orders Current Month&apos;' />
      </column>
      <column caption='mCVR2 % (Shop List -&gt; Shop Menu)' datatype='real' default-format='p0.0%' name='[Calculation_1315332633848184832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_shop_menu_loaded])/SUM([count_of_shop_list_loaded])' />
      </column>
      <column caption='Current Month' datatype='boolean' name='[Calculation_1315332633863475204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH([date]) = MONTH([Parameters].[report_month Parameter])' />
      </column>
      <column caption='RR' datatype='real' name='[Calculation_1315332633877635078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(MAX([date]) &lt; DATETRUNC(&quot;month&quot;,MAX([Calculation_933089613377191946]))) THEN 1 ELSE &#13;&#10;&#13;&#10;(DATEADD(&quot;month&quot;, 1, DATETRUNC(&quot;month&quot;,MAX([Parameters].[report_month Parameter]))) - DATETRUNC(&quot;month&quot;,MAX([Parameters].[report_month Parameter])))&#13;&#10;/&#13;&#10;(1+MAX([Parameters].[report_month Parameter]) - DATETRUNC(&quot;month&quot;,MAX([Parameters].[report_month Parameter])))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Year Month' datatype='string' default-format='*mmm-yyyy' name='[Calculation_1315332633882804231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(Year([date])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(Month([date])),2)' />
      </column>
      <column caption='Day Date' datatype='boolean' name='[Calculation_1315332633884389384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DAY([date]) &lt;= DAY([Parameters].[report_month Parameter])' />
      </column>
      <column caption='Turnover' datatype='real' name='[Calculation_1315332633910190089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_base])' />
      </column>
      <column caption='% CR / GMV' datatype='real' default-format='p0.0%' name='[Calculation_1315332633910767626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688516239380]/[Calculation_1157143688514240530]' />
      </column>
      <column caption='Top 30' datatype='boolean' name='[Calculation_1315332633917300747]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[local_chain] IN&#13;&#10;    (&quot;McDonald&apos;s&quot;,&#13;&#10;    &quot;KFC Rozvoz&quot;,&#13;&#10;    &quot;BB Domu&quot;,&#13;&#10;    &quot;Burger King&quot;,&#13;&#10;    &quot;Chachar&quot;,&#13;&#10;    &quot;Globus&quot;,&#13;&#10;    &quot;YamYam&quot;,&#13;&#10;    &quot;Turbo Pizza&quot;,&#13;&#10;    &quot;UGO&quot;,&#13;&#10;    &quot;Los Capolitos&quot;,&#13;&#10;    &quot;Amici&quot;,&#13;&#10;    &quot;Kolkovna&quot;,&#13;&#10;    &quot;Cartel&quot;,&#13;&#10;    &quot;My Food Place&quot;,&#13;&#10;    &quot;MỘC - Pravá Vietnamská kuchyně&quot;,&#13;&#10;    &quot;Grosseto&quot;,&#13;&#10;    &quot;Papa Cipolla&quot;,&#13;&#10;    &quot;Pizza Comeback&quot;,&#13;&#10;    &quot;Pizza Hut&quot;,&#13;&#10;    &quot;Banyan Bistro&quot;,&#13;&#10;    &quot;Firovka&quot;,&#13;&#10;    &quot;Cafe Buddha&quot;,&#13;&#10;    &quot;123 Pizza&quot;,&#13;&#10;    &quot;Bouda Burgers&quot;,&#13;&#10;    &quot;Vosíme&quot;,&#13;&#10;    &quot;Starbucks&quot;)&#13;&#10;OR vendor_code IN&#13;&#10;    (&quot;s0wj&quot;, &quot;i6vo&quot;, &quot;a2dt&quot;, &quot;a6hb&quot;, &quot;h7df&quot;, &quot;x1lv&quot;, &quot;md12&quot;, &quot;oogm&quot;, &quot;o8ld&quot;, &quot;g0fv&quot;, &quot;z404&quot;, &quot;r7cz&quot;, &quot;l09h&quot;, &quot;w7ts&quot;, &quot;sp3q&quot;, &quot;sznh&quot;, &quot;ckc4&quot;, &quot;rki4&quot;, &quot;hbsb&quot;, &quot;o06y&quot;, &quot;fzsh&quot;)' />
      </column>
      <column caption='Take Rate' datatype='real' name='[Calculation_1315332633925283852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_431501199555026944],0)&#13;&#10;+ IFNULL([Calculation_1157143688516239380],0)&#13;&#10;+ IFNULL([Calculation_1157143688518881306],0)' />
      </column>
      <column caption='Grade' datatype='string' name='[Calculation_1315332633927614478]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;All&quot;' />
      </column>
      <column caption='% Contact Rate' datatype='real' name='[Calculation_1382323619161903104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_contacts])&#13;&#10;/&#13;&#10;SUM(IFNULL([successful_orders],0) + IFNULL([failed_orders],0))' />
      </column>
      <column caption='# New Users Platform RR' datatype='real' name='[Calculation_1592022536287764487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688513216526]* [Calculation_1315332633877635078]' />
      </column>
      <column caption='Date to show' datatype='date' name='[Calculation_1592022536314318858]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Monthly&quot; THEN DATE(DATETRUNC(&quot;month&quot;, [date]))&#13;&#10;WHEN &quot;Daily&quot; THEN DATE([date])&#13;&#10;END' />
      </column>
      <column caption='Total NCR (Non Commission Revenue)' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_431501199555026944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(    IFNULL([eshop_revenue_local],0)&#13;&#10;    +   IFNULL([joker_fee_revenue_local],0)&#13;&#10;    +   IFNULL([cpc_revenue_local],0)&#13;&#10;    +   IFNULL([cpp_revenue_local],0)&#13;&#10;    +   IFNULL([display_ads_revenue_local],0)&#13;&#10;)' />
      </column>
      <column caption='Month Filter Selected Periods' datatype='boolean' name='[Calculation_52072871510233092]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &gt;= DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),DATETRUNC(&quot;month&quot;,[Parameters].[report_month Parameter]))&#13;&#10;AND&#13;&#10;[date] &lt;= [Parameters].[report_month Parameter]' />
      </column>
      <column caption='INDEX MONTH' datatype='integer' name='[Calculation_52072871512281094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIZE() -INDEX() +1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Title' datatype='string' name='[Calculation_52072871513169927]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; MoM&quot;' />
      </column>
      <column caption='YoY Title' datatype='string' name='[Calculation_52072871514304520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; YoY&quot;' />
      </column>
      <column caption='Dummy 01' datatype='real' name='[Calculation_52072871778660372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(NULL)' />
      </column>
      <column caption='AVG Orders per Vendor' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_542965230494855168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688514347027]/[Calculation_808114725066461186]' />
      </column>
      <column caption='Avg Visits' datatype='real' name='[Calculation_542965230503030785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688506400768]/COUNTD(IF  [count_of_shop_menu_loaded] &gt; 0 THEN [vendor_code] END )' />
      </column>
      <column caption='GMV forecast' datatype='real' name='[Calculation_542965230513577986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688514240530] * [Calculation_1315332633877635078]' />
      </column>
      <column caption='% Margin' datatype='real' default-format='p0.00%' name='[Calculation_542965230515429380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688516239380]/[Calculation_1315332633910190089]' />
      </column>
      <column caption='Planned Opened Hours' datatype='real' name='[Calculation_542965230523518984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_scheduled_open_seconds])/3600' />
      </column>
      <column caption='Total Closed Hours' datatype='real' name='[Calculation_542965230523629577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_closed_seconds])/3600' />
      </column>
      <column caption='Actual Opened Hours' datatype='real' name='[Calculation_542965230523699210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_542965230523518984]-[Calculation_542965230523629577]' />
      </column>
      <column caption='% Uptime Peak Hours' datatype='real' default-format='p0.0%' name='[Calculation_681169469533683712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([peak_unavailable_minutes])/(240*SUM([days_online]))' />
      </column>
      <column caption='Deal Value Total' datatype='real' name='[Calculation_72620549625577473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([vf_deal_value],0) + IFNULL([dh_deal_value],0)' />
      </column>
      <column caption='Turnover Cash' datatype='real' name='[Calculation_72620549640241154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_base_cash])' />
      </column>
      <column caption='Turnover Card' datatype='real' name='[Calculation_72620549640765443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1315332633910190089] - [Calculation_72620549640241154]' />
      </column>
      <column caption='Packing Fee' datatype='real' name='[Calculation_72620549640916996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([container_charges_local])' />
      </column>
      <column caption='Minimum Order Value Fee' datatype='real' name='[Calculation_72620549641699333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([difference_to_minimum_order_value_plus_vat_local])' />
      </column>
      <column caption='Courier Tip' datatype='real' name='[Calculation_72620549641936902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_tip_plus_vat_local])' />
      </column>
      <column caption='Delivery Fee' datatype='real' name='[Calculation_72620549643911175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([df_user_paid_incl_vat_local])' />
      </column>
      <column caption='AVG DF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_72620549644476424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_72620549643911175]/[Calculation_1157143688514347027]' />
      </column>
      <column caption='Service Fee' datatype='real' name='[Calculation_72620549653725193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([service_fee_plus_vat_local])' />
      </column>
      <column caption='Compensations Count' datatype='integer' name='[Calculation_731272042865430528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([compensations_resto_cnt])' />
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_731272042866188289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688514240530]/[Calculation_1157143688514347027]' />
      </column>
      <column caption='Time Period' datatype='boolean' name='[Calculation_731272042868957186]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Current Year MtD&apos; THEN YEAR([date]) = YEAR(TODAY())&#13;&#10;WHEN &apos;Previous Month&apos; THEN DATEDIFF(&apos;month&apos;, [date], TODAY()) = 1&#13;&#10;WHEN &apos;Previous Year&apos; THEN YEAR([date]) = YEAR(TODAY())-1&#13;&#10;END' />
      </column>
      <column caption='Failed Orders not on the Vendor&apos;s Side' datatype='integer' name='[Calculation_731272042893955076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[failed_orders] - [failed_orders_vendor]' />
      </column>
      <column caption='Chain' datatype='string' name='[Calculation_731272042899005448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS ([vendor_name] , &apos;KFC &apos;) THEN &apos;KFC Rozvoz&apos;&#13;&#10;ELSE [chain_name]&#13;&#10;END' />
      </column>
      <column caption='Exclude current month' datatype='boolean' name='[Calculation_731272042904133642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datediff(&apos;month&apos;, [date], today()) &gt; 0' />
      </column>
      <column caption='% Compensations (% GMV)' datatype='real' default-format='p0.0%' name='[Calculation_731272042906488843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_838232519584579584] / [Calculation_1157143688514240530]' />
      </column>
      <column caption='Rank Uptime Filter' datatype='boolean' name='[Calculation_731272042910711821]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE([Calculation_1157143688511807500],&apos;asc&apos;) &lt;= 5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Subscription Orders' datatype='real' default-format='p0.0%' name='[Calculation_788974376323457024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([subscription_orders])/SUM([successful_orders])' />
      </column>
      <column caption='Date (year month)' datatype='string' name='[Calculation_790663222342889472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(DATEpart(&apos;year&apos;, [date])) + &apos;-&apos; + right(&apos;0&apos;+ str(DATEpart(&apos;month&apos;, [date])), 2)' />
      </column>
      <column caption='Period' datatype='string' name='[Calculation_790663222625263619]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Monthly / Daily (copy)_790663222625157122] = &apos;Weekly&apos; THEN str(date(DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)))&#13;&#10;ELSEIF [Parameters].[Monthly / Daily (copy)_790663222625157122] = &apos;Monthly&apos; THEN str(year([date])) + &apos;-&apos; + right(&apos;0&apos;+str(month([date])), 2)&#13;&#10;ELSEIF [Parameters].[Monthly / Daily (copy)_790663222625157122] = &apos;Daily&apos; THEN str(date(DATETRUNC(&apos;day&apos;,[date])))&#13;&#10;END' />
      </column>
      <column caption='Index Filter' datatype='boolean' name='[Calculation_790663222625517572]' role='measure' type='nominal'>
        <calculation class='tableau' formula='size() - index() + 1 &lt;= [Parameters].[# Months (copy)_790663222624370689]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='size' datatype='integer' name='[Calculation_790663222647721991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='size()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% PRO Orders' datatype='real' default-format='p0.0%' name='[Calculation_798263100636401664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([subscription_orders])/SUM([successful_orders])' />
      </column>
      <column caption='Days In Month' datatype='integer' name='[Calculation_808114725065764864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [date]: MAX(DATEDIFF(&quot;day&quot;, [date], DATEADD(&quot;month&quot;,1, [date])))}' />
      </column>
      <column caption='# Vendors with Order' datatype='integer' name='[Calculation_808114725066461186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [successful_orders] &gt; 0 THEN [vendor_code (vendors)] END)' />
      </column>
      <column caption='ODS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_808114725066575875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1315332633877635078] * [Calculation_1157143688514347027]/([Calculation_808114725066461186] * MAX([Calculation_808114725065764864]))' />
      </column>
      <column caption='Subsidy Spend' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_808114725068214277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_deal_value])' />
      </column>
      <column caption='Compensations Amount' datatype='real' name='[Calculation_838232519584579584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([compensations_resto_amount])' />
      </column>
      <column caption='% Successful Orders in or before PDT' datatype='real' default-format='p0.0%' name='[Calculation_868068884066086912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([successful_orders_before_pdt])+SUM([successful_orders_in_pdt]))/SUM([successful_orders (Custom SQL Query)])' />
      </column>
      <column caption='% Delayed &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_894808954563629056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_late_over_10_count]) / SUM([completed_orders])' />
      </column>
      <column caption='AVG Acceptance Time (s)' datatype='real' name='[Calculation_894808954564505602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_first_response_time_actual]) / [Calculation_1157143688514347027]' />
      </column>
      <column caption='AVG Prep Time Act' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_894808954565156867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_preparation_time_actual]) / [Calculation_1157143688514347027]' />
      </column>
      <column caption='PP (Priority Partnership) Vendors' datatype='integer' name='[Calculation_933089613372846082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_pp] = 1 THEN [vendor_code] END)' />
      </column>
      <column caption='% Joker Penetration' datatype='real' default-format='p0.0%' name='[Calculation_933089613373423619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [joker_fee_revenue_local] &gt; 0 THEN [vendor_code] END)/COUNTD(IF [successful_orders] &gt; 0 THEN [vendor_code] END)' />
      </column>
      <column caption='% NCR / GMV' datatype='real' default-format='p0.00%' name='[Calculation_933089613373935621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_431501199555026944]/[Calculation_1157143688514240530]' />
      </column>
      <column caption='Churned Restaurant in Reporting Month' datatype='boolean' name='[Calculation_933089613375741960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[successful_orders] &gt; 0 AND&#13;&#10;{ FIXED [vendor_code]: MAX(IF [date] = DATEADD(&quot;month&quot;,-1, [Parameters].[report_month Parameter]) THEN [successful_orders] END) &gt; 0}&#13;&#10;AND date = [Parameters].[report_month Parameter]' />
      </column>
      <column caption='# Newly Churned AB restos' datatype='integer' name='[Calculation_933089613376663561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [churned] AND [local_grade] IN (&apos;A&apos;,&apos;B&apos;) THEN [vendor_code] END)' />
