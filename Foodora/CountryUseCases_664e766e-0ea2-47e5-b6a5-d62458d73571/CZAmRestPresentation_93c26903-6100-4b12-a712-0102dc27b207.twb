          <datasource-dependencies datasource='federated.1jgfr8t1rsk4dt1180gph1m8v78h'>
            <column caption='GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1157143688514240530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv])' />
            </column>
            <column caption='Time Period' datatype='boolean' name='[Calculation_731272042868957186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Current Year MtD&apos; THEN YEAR([date]) = YEAR(TODAY())&#13;&#10;WHEN &apos;Previous Month&apos; THEN DATEDIFF(&apos;month&apos;, [date], TODAY()) = 1&#13;&#10;WHEN &apos;Previous Year&apos; THEN YEAR([date]) = YEAR(TODAY())-1&#13;&#10;END' />
            </column>
            <column caption='Chain' datatype='string' name='[Calculation_731272042899005448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS ([vendor_name] , &apos;KFC &apos;) THEN &apos;KFC Rozvoz&apos;&#13;&#10;ELSE [chain_name]&#13;&#10;END' />
            </column>
            <column caption='% Compensations (% GMV)' datatype='real' default-format='p0.0%' name='[Calculation_731272042906488843]' role='measure' type='quantitative'>
