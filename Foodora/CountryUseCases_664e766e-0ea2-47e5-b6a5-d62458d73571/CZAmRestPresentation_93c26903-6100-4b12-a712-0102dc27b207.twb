            <column caption='Choose Period' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Previous Year&quot;'>
              <calculation class='tableau' formula='&quot;Previous Year&quot;' />
            </column>
