                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 15
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 5
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 10
                END
            ELSE
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 5
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 10
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 15
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes
                END
        END THEN o.order_uid
    END) AS successful_orders_in_pdt,

COUNT(CASE
        WHEN CASE
            WHEN o.promised_delivery_time_in_minutes <<= 40 THEN
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 15
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 10
                END
            ELSE
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 10
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes
                END
        END THEN o.order_uid
    END) AS successful_orders_before_pdt,

FROM `damejidlo-cz-bigquery.master.orders` co
JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o ON co.order_code = o.order_code AND co.global_entity_id = o.global_entity_id
JOIN `damejidlo-cz-bigquery.master.vendors` v ON o.vendor_code = v.vendor_code
WHERE o.country_code_iso = 'cz'
  AND co.is_valid_order
  AND co.created_at_local >>= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  AND o.created_date_local >>=  DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  AND v.chain_name IN (
    'Burger King',
    'Burger King - Plant Based',
    'Pizza Hut',
    'KFC Rozvoz',
    'Starbucks',
    'Těstoviny z pece by Pizza Hut'
  )
  AND v.group_name IN (
    'AmRest Coffee s.r.o.',
    'AmRest s.r.o.'
  )
  AND o.delivery_type = 'Own Delivery'
GROUP BY ALL]]></relation>
