            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jgfr8t1rsk4dt1180gph1m8v78h'>
            <column caption='Avg Resto Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1157143688518340632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_rating_vendor_food_score_sum])/SUM([customer_rating_vendor_food_score_cnt])' />
