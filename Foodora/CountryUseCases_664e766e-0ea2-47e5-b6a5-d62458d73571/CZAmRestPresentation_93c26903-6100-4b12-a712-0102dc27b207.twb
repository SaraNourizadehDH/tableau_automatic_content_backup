            <column caption='% CVR' datatype='real' default-format='p0.0%' name='[Calculation_1157143688506572801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1157143688514347027]/[Calculation_1157143688506400768]' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1157143688511037450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([act_delivery_time])/SUM([orders_not_preorder])' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1157143688511807500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_scheduled_open_seconds])-SUM(IFNULL([total_closed_seconds],0)))/SUM([total_scheduled_open_seconds])' />
            </column>
            <column caption='# New Users Vendor' datatype='integer' name='[Calculation_1157143688513413135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_users_vendor])' />
            </column>
            <column caption='# Users Vendor' datatype='integer' name='[Calculation_1157143688513679376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_users])' />
            </column>
            <column caption='GMV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1157143688514240530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv])' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_1157143688514347027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])' />
            </column>
            <column caption='Avg Resto Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1157143688518340632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_rating_vendor_food_score_sum])/SUM([customer_rating_vendor_food_score_cnt])' />
            </column>
            <column caption='% Vendor Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_1180506056302272512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1157143688513413135]/[Calculation_1157143688513679376]' />
            </column>
            <column caption='% Contact Rate' datatype='real' name='[Calculation_1382323619161903104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_contacts])&#13;&#10;/&#13;&#10;SUM(IFNULL([successful_orders],0) + IFNULL([failed_orders],0))' />
            </column>
            <column caption='Compensations Count' datatype='integer' name='[Calculation_731272042865430528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensations_resto_cnt])' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_731272042866188289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1157143688514240530]/[Calculation_1157143688514347027]' />
            </column>
            <column caption='Failed Orders not on the Vendor&apos;s Side' datatype='integer' name='[Calculation_731272042893955076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[failed_orders] - [failed_orders_vendor]' />
            </column>
            <column caption='Chain' datatype='string' name='[Calculation_731272042899005448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS ([vendor_name] , &apos;KFC &apos;) THEN &apos;KFC Rozvoz&apos;&#13;&#10;ELSE [chain_name]&#13;&#10;END' />
            </column>
            <column caption='Compensations Amount' datatype='real' name='[Calculation_838232519584579584]' role='measure' type='quantitative'>
