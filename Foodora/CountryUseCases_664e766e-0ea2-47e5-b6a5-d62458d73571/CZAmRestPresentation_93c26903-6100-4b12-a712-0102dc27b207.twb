            </column>
            <column caption='Compensations Amount' datatype='real' name='[Calculation_838232519584579584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensations_resto_amount])' />
            </column>
            <column caption='Rank Compensations' datatype='boolean' name='[Rank Vendor Fail (copy)_1940770017840128001]' role='measure' type='nominal'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_731272042906488843],&apos;desc&apos;) &lt;= 5'>
