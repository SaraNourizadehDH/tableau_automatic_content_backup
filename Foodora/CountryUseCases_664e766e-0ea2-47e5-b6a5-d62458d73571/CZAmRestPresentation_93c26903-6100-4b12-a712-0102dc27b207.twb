            <column caption='% Successful Orders in or before PDT' datatype='real' default-format='p0.0%' name='[Calculation_868068884066086912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_orders_before_pdt])+SUM([successful_orders_in_pdt]))/SUM([successful_orders (Custom SQL Query)])' />
