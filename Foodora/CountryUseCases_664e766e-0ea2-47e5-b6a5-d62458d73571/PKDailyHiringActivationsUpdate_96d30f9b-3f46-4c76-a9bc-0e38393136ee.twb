  <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/DailyHrirngActivationsUpdate?rev=1.2' id='DailyHrirngActivationsUpdate' path='/t/Foodora/workbooks' revision='1.3' site='Foodora' />
