    <worksheet name='Hourly by Metric'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_vendor_hourly (bl_bi)' name='federated.16ezjv90klpnhh1gtswwu0s7t9mf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Para' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Successful Orders&quot;'>
              <calculation class='tableau' formula='&quot;Successful Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16ezjv90klpnhh1gtswwu0s7t9mf'>
            <column caption='Avg. Dispatching Time' datatype='real' name='[Calculation_1122240783105990657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dispatching_time_sum])&#13;&#10;/(SUM([dispatching_time_den])*60)' />
            </column>
            <column caption='Avg. Rider Accepting Time' datatype='real' name='[Calculation_1122240783106236418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepting_time_sum])&#13;&#10;/(SUM([rider_accepting_time_den])*60)' />
            </column>
            <column caption='Avg. Vendor Late' datatype='real' name='[Calculation_1122240783107039235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_sum])/&#13;&#10;(SUM([vendor_late_den])*60)' />
            </column>
            <column caption='Avg. Rider Late' datatype='real' name='[Calculation_1122240783107272708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_sum])/&#13;&#10;(SUM([rider_late_den])*60)' />
            </column>
            <column caption='% Vendor Late &gt; 5 min' datatype='real' name='[Calculation_1122240783107362821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_5min_cnt])/&#13;&#10;SUM([vendor_late_den])' />
            </column>
            <column caption='% Vendor Late &gt; 10 min' datatype='real' name='[Calculation_1122240783107559430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_10min_cnt])/&#13;&#10;SUM([vendor_late_den])' />
            </column>
            <column caption='% Rider Late &gt; 5 min' datatype='real' name='[Calculation_1122240783107694599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_5min_cnt])/&#13;&#10;SUM([rider_late_den])' />
            </column>
            <column caption='% Rider Late &gt; 10 min' datatype='real' name='[Calculation_1122240783107805192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_10min_cnt])/&#13;&#10;SUM([rider_late_den])' />
            </column>
            <column caption='metric_f' datatype='string' name='[Calculation_1413848859045281793]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Gross Orders&quot; THEN STR(round(SUM([gross_orders]),0))&#13;&#10;WHEN &quot;Successful Orders&quot; THEN STR(round(SUM([successful_orders]),0)) &#13;&#10;WHEN &quot;% Failed Orders&quot; THEN STR(ROUND([Calculation_1421448683701891072]*100,2))+&quot;%&quot;&#13;&#10;WHEN &quot;% Vendor Cancelled&quot; THEN STR(ROUND([Calculation_1421448683701891072]*100,2))+&quot;%&quot;&#13;&#10;WHEN &quot;Avg. Promised Delivery Time&quot; THEN STR(round([Calculation_96264492027338752],2))&#13;&#10;WHEN &quot;Avg. Delivery Time&quot; THEN STR(round([Calculation_96264492028289026],2))&#13;&#10;WHEN &quot;Avg. Prep Time (Estimated)&quot; THEN STR(round([Calculation_96264492028706820],2))&#13;&#10;WHEN &quot;Avg. Prep Time (Assumed Actual)&quot; THEN STR(round([Calculation_96264492028432387],2))&#13;&#10;WHEN &quot;Avg. Dispatching Time&quot; THEN STR(round([Calculation_1122240783105990657],2))&#13;&#10;WHEN &quot;Avg. Rider Accepting Time&quot; THEN STR(round([Calculation_1122240783106236418],2))&#13;&#10;WHEN &quot;Avg. Vendor Late&quot; THEN STR(round([Calculation_1122240783107039235],2))&#13;&#10;WHEN &quot;% Vendor Late &gt; 5 min&quot; THEN STR(ROUND([Calculation_1122240783107362821]*100,2))+&quot;%&quot;&#13;&#10;WHEN &quot;% Vendor Late &gt; 10 min&quot; THEN STR(ROUND([Calculation_1122240783107559430]*100,2))+&quot;%&quot;&#13;&#10;WHEN &quot;Avg. Rider Late&quot; THEN STR(round([Calculation_1122240783107272708],2))&#13;&#10;WHEN &quot;% Rider Late &gt; 5 min&quot; THEN STR(ROUND([Calculation_1122240783107694599]*100,2))+&quot;%&quot;&#13;&#10;WHEN &quot;% Rider Late &gt; 10 min&quot; THEN STR(ROUND([Calculation_1122240783107805192]*100,2))+&quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_1421448683701891072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='% Vendor Cancelled' datatype='real' name='[Calculation_1421448683708207106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor])/SUM([gross_orders])' />
            </column>
            <column caption='Avg. Promised Delivery Time' datatype='real' name='[Calculation_96264492027338752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_delivery_time_from_timing_sum])&#13;&#10;/(SUM([promised_delivery_time_from_timing_den])*60)' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_96264492028289026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_sum])&#13;&#10;/(SUM([actual_delivery_time_den])*60)' />
            </column>
            <column caption='Avg. Prep Time (Assumed Actual)' datatype='real' name='[Calculation_96264492028432387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([assumed_actual_preparation_time])&#13;&#10;/(SUM([assumed_actual_preparation_time_den])*60)' />
            </column>
            <column caption='Avg. Prep Time (Estimated)' datatype='real' name='[Calculation_96264492028706820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time_sum])&#13;&#10;/(SUM([estimated_prep_time_den])*60)' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_96264492031594501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Gross Orders&quot; THEN SUM([gross_orders])&#13;&#10;WHEN &quot;Successful Orders&quot; THEN SUM([successful_orders])&#13;&#10;WHEN &quot;% Failed Orders&quot; THEN [Calculation_1421448683701891072]&#13;&#10;WHEN &quot;% Vendor Cancelled&quot; THEN [Calculation_1421448683708207106]&#13;&#10;WHEN &quot;Avg. Promised Delivery Time&quot; THEN [Calculation_96264492027338752]&#13;&#10;WHEN &quot;Avg. Delivery Time&quot; THEN [Calculation_96264492028289026]&#13;&#10;WHEN &quot;Avg. Prep Time (Estimated)&quot; THEN [Calculation_96264492028706820]&#13;&#10;WHEN &quot;Avg. Prep Time (Assumed Actual)&quot; THEN [Calculation_96264492028432387]&#13;&#10;WHEN &quot;Avg. Dispatching Time&quot; THEN [Calculation_1122240783105990657]&#13;&#10;WHEN &quot;Avg. Rider Accepting Time&quot; THEN [Calculation_1122240783106236418]&#13;&#10;WHEN &quot;Avg. Vendor Late&quot; THEN [Calculation_1122240783107039235]&#13;&#10;WHEN &quot;% Vendor Late &gt; 5 min&quot; THEN [Calculation_1122240783107362821]&#13;&#10;WHEN &quot;% Vendor Late &gt; 10 min&quot; THEN [Calculation_1122240783107559430]&#13;&#10;WHEN &quot;Avg. Rider Late&quot; THEN [Calculation_1122240783107272708]&#13;&#10;WHEN &quot;% Rider Late &gt; 5 min&quot; THEN [Calculation_1122240783107694599]&#13;&#10;WHEN &quot;% Rider Late &gt; 10 min&quot; THEN [Calculation_1122240783107805192]&#13;&#10;END' />
            </column>
            <column caption='Actual Delivery Time Den' datatype='integer' name='[actual_delivery_time_den]' role='measure' type='quantitative' />
