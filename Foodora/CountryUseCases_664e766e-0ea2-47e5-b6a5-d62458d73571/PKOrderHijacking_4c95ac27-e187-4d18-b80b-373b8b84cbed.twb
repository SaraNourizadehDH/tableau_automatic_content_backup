        <calculation class='tableau' formula='TRIM( SPLIT( [riders_prob], &quot;,&quot;, 9 ) )' />
      </column>
      <column caption='Rider with highest probability' datatype='string' name='[riders_prob - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.06hnae50eekdi9115rt8c1kbn27g].[riders_prob]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [riders_prob], &quot;,&quot;, 1 ) )' />
      </column>
      <column caption='riders_prob - Split 20' datatype='string' name='[riders_prob - Split 20]' role='dimension' type='nominal' user:SplitFieldIndex='20' user:SplitFieldOrigin='[federated.06hnae50eekdi9115rt8c1kbn27g].[riders_prob]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [riders_prob], &quot;,&quot;, 10 ) )' />
      </column>
      <column caption='riders_prob - Split 2' datatype='string' name='[riders_prob - Split 2]' role='dimension' type='nominal' user:SplitFieldIndex='2' user:SplitFieldOrigin='[federated.06hnae50eekdi9115rt8c1kbn27g].[riders_prob]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [riders_prob], &quot;,&quot;, 2 ) )' />
      </column>
      <column caption='riders_prob - Split 3' datatype='string' name='[riders_prob - Split 3]' role='dimension' type='nominal' user:SplitFieldIndex='3' user:SplitFieldOrigin='[federated.06hnae50eekdi9115rt8c1kbn27g].[riders_prob]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [riders_prob], &quot;,&quot;, 3 ) )' />
      </column>
      <column caption='riders_prob - Split 4' datatype='string' name='[riders_prob - Split 4]' role='dimension' type='nominal' user:SplitFieldIndex='4' user:SplitFieldOrigin='[federated.06hnae50eekdi9115rt8c1kbn27g].[riders_prob]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [riders_prob], &quot;,&quot;, 4 ) )' />
      </column>
      <column caption='riders_prob - Split 5' datatype='string' name='[riders_prob - Split 5]' role='dimension' type='nominal' user:SplitFieldIndex='5' user:SplitFieldOrigin='[federated.06hnae50eekdi9115rt8c1kbn27g].[riders_prob]'>
