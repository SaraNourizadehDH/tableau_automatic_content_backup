            <column caption='Zombie last x days' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uo8wg105am5uk1c2ut4o03dubma'>
            <column caption='Is Zombie in last x days' datatype='boolean' name='[Calculation_1274800184033849346]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ZN({ FIXED [vendor_code]: sum(&#13;&#10;if DATEDIFF(&apos;day&apos;, [date], today()-1) &lt;= [Parameters].[Parameter 3] then [successful_orders] end)}) = 0' />
            </column>
            <column caption='Last Activation Date' datatype='date' name='[Calculation_1360650054689771520]' role='dimension' type='ordinal'>
