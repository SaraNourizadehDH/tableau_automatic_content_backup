    <worksheet name='F60D'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='16'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontsize='10'>% of restaurants with more than 75 orders in 60 days since last activation date</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='incubation' name='federated.1uo8wg105am5uk1c2ut4o03dubma' />
          </datasources>
          <datasource-dependencies datasource='federated.1uo8wg105am5uk1c2ut4o03dubma'>
            <column caption='Last Activation Date' datatype='date' name='[Calculation_1360650054689771520]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [global_vendor_id] = &apos;HRB0JO&apos; then date(&apos;2024-10-23&apos;) &#13;&#10;else [last_activation_date]&#13;&#10;end' />
            </column>
            <column caption='first 60 days filter' datatype='boolean' name='[Calculation_1630021646741553152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 60' />
            </column>
            <column caption='Date before Last Activation Date Filter' datatype='boolean' name='[Calculation_487233241219678219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;= [Calculation_1360650054689771520]' />
            </column>
            <column caption='Vendors with 75 orders and more in 60 days' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_487233241280663568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if { FIXED [vendor_code], [Calculation_1630021646741553152]: [Calculation_668784567361150990]} &gt;= 75 then [vendor_code] end)' />
            </column>
            <column caption='F60D' datatype='real' default-format='p0.0%' name='[Calculation_487233241281318929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_487233241280663568]/[Calculation_668784567640444961]' />
            </column>
            <column caption='# Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567361150990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders])' />
            </column>
            <column caption='# Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567640444961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([vendor_code])' />
            </column>
            <column-instance column='[sf_vendor_grade]' derivation='Attribute' name='[attr:sf_vendor_grade:nk]' pivot='key' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
