          <datasource-dependencies datasource='federated.1uo8wg105am5uk1c2ut4o03dubma'>
            <column caption='Last Activation Date' datatype='date' name='[Calculation_1360650054689771520]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [global_vendor_id] = &apos;HRB0JO&apos; then date(&apos;2024-10-23&apos;) &#13;&#10;else [last_activation_date]&#13;&#10;end' />
            </column>
            <column caption='Date before Last Activation Date Filter' datatype='boolean' name='[Calculation_487233241219678219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;= [Calculation_1360650054689771520]' />
            </column>
            <column caption='VF Deal Vendors' datatype='integer' name='[Calculation_5772418512719228930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [has_vf_deal] then [vendor_code] end)' />
            </column>
            <column caption='% Vendors with VFD' datatype='real' name='[Calculation_5772418512719888387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5772418512719228930] / countd([vendor_code])' />
            </column>
            <column-instance column='[vendor_code]' derivation='CountD' name='[ctd:vendor_code:qk]' pivot='key' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Global Vendor ID' datatype='string' name='[global_vendor_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[has_vf_deal]' role='dimension' type='nominal' />
            <column datatype='date' name='[last_activation_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1360650054689771520]' derivation='None' name='[none:Calculation_1360650054689771520:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_487233241219678219]' derivation='None' name='[none:Calculation_487233241219678219:nk]' pivot='key' type='nominal' />
