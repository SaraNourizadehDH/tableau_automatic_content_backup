      </connection>
      <aliases enabled='yes' />
      <column caption='# Vendors with successful call' datatype='integer' default-format='n#,##0;-#,##0' name='[# Vendors with call (copy)_503277268891541507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vendor_code]: MAX(IF (IF DATEDIFF(&apos;month&apos;, [Calculation_1360650054689771520], [date]) &lt;= 3 THEN [count_succesful_calls (incubation)] END) &gt; 0 then 1 else 0 END) }' />
      </column>
      <column caption='# Vendor Failed Orders' datatype='integer' default-format='p0.0%' name='[% Vendor Fail Rate (copy)_7852237082424012800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [decline_type] = &apos;VENDOR&apos; then [failed_orders] end)' />
      </column>
      <column caption='% Vendor Late &gt; 30' datatype='real' default-format='p0.0%' name='[% Vendor Late &gt; 10 (copy)_668784567695786025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_over_30_count])/sum([orders_not_preorder])' />
      </column>
      <column caption='% Vendors with both NCR and VFD' datatype='real' default-format='p0.0%' name='[% Vendors with NCR (copy)_503277268894494725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[VF Deal Vendors (copy)_503277268894052356] / countd([vendor_code])' />
      </column>
      <column caption='% Vendors with NCR' datatype='real' default-format='p0.0%' name='[% Vendors with VFD (copy)_946037456201318401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[VF Deal Vendors (copy)_946037456201224192] / countd([vendor_code])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1uo8wg105am5uk1c2ut4o03dubma].[avg:ab_push_discount:qk]&quot;' value='AB Push ' />
          <alias key='&quot;[federated.1uo8wg105am5uk1c2ut4o03dubma].[avg:ab_push_discount:vtavg:qk]&quot;' value='AB Push' />
          <alias key='&quot;[federated.1uo8wg105am5uk1c2ut4o03dubma].[avg:Calculation_1044553687337951232:qk]&quot;' value='Average Orders' />
          <alias key='&quot;[federated.1uo8wg105am5uk1c2ut4o03dubma].[cum:usr:Calculation_668784567640444961:qk]&quot;' value='Index' />
          <alias key='&quot;[federated.1uo8wg105am5uk1c2ut4o03dubma].[usr:Calculation_818247761429225476:qk]&quot;' value='# vendors (zero orders)' />
        </aliases>
      </column>
      <column caption='Average Orders' datatype='real' name='[Calculation_1044553687337951232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vendor_code], [global_vendor_id], [Calculation_668784567341092869]: [Calculation_668784567361150990] }/DATEDIFF(&apos;day&apos;, [Calculation_1360650054689771520], today())' />
      </column>
      <column caption='Activated x weeks ago' datatype='string' name='[Calculation_1052716436223447040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if dateadd(&apos;day&apos;, 15, [Calculation_1360650054689771520]) &gt;= today()-1 then &apos;Activated 1 or 2 weeks ago&apos;&#13;&#10;elseif dateadd(&apos;day&apos;, 31, [Calculation_1360650054689771520]) &gt;= today()-1 then &apos;Activated 3 or 4 weeks ago&apos;&#13;&#10;end' />
      </column>
      <column caption='Vendor Portal Usage' datatype='date' name='[Calculation_1052716436241440769]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='if ([vendor_sessions]) &gt; 0 then ([date]) end' />
      </column>
      <column caption='% Vendor Portal Usage' datatype='real' default-format='p0.0%' name='[Calculation_1052716436242087938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Calculation_1052716436241440769])/30' />
      </column>
      <column caption='Null Values' datatype='boolean' name='[Calculation_1157706606788747265]' role='measure' type='nominal'>
        <calculation class='tableau' formula='isnull([Calculation_668784567361150990]) and isnull([Calculation_668784567343652872])' />
      </column>
      <column caption='Vendor Portal Visits' datatype='integer' hidden='true' name='[Calculation_1157706606893617164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([vendor_sessions]))' />
      </column>
      <column caption='Show Data Filter' datatype='boolean' name='[Calculation_1157706607132925965]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='% Rider Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_1178535760741449728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_over_10_count])/SUM([completed_orders])' />
      </column>
      <column caption='Is Zombie in last x days' datatype='boolean' name='[Calculation_1274800184033849346]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ZN({ FIXED [vendor_code]: sum(&#13;&#10;if DATEDIFF(&apos;day&apos;, [date], today()-1) &lt;= [Parameters].[Parameter 3] then [successful_orders] end)}) = 0' />
      </column>
      <column caption='Last Activation Date' datatype='date' name='[Calculation_1360650054689771520]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [global_vendor_id] = &apos;HRB0JO&apos; then date(&apos;2024-10-23&apos;) &#13;&#10;else [last_activation_date]&#13;&#10;end' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_1461699590188724224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='size() - INDEX() + 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index Filter' datatype='boolean' name='[Calculation_1461699590189215745]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1461699590188724224] &lt;= [Parameters].[Parameter 2]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Null filter' datatype='boolean' name='[Calculation_1461699590194372610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='not isnull([vendor_code]) or not isnull([vendor_name])' />
      </column>
      <column caption='first 60 days filter' datatype='boolean' name='[Calculation_1630021646741553152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 60' />
      </column>
      <column caption='# Vendors in Incubation' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_322570327825313792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if datediff(&apos;month&apos;, [Calculation_1360650054689771520], [date]) = 0 then [vendor_code] end)' />
      </column>
      <column caption='AVG Orders per month' datatype='real' name='[Calculation_487233240963829760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ FIXED [vendor_code], MONTH([date]), YEAR([date]): SUM([successful_orders])})/[Calculation_487233240965251074]' />
      </column>
      <column caption='# active days' datatype='integer' name='[Calculation_487233240965251074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max(&#13;&#10;&#13;&#10;//datum je v měsíci otevření a současně tento měsíc&#13;&#10;IF datediff(&apos;month&apos;, [Calculation_1360650054689771520], [date]) = 0 AND datediff(&apos;month&apos;, [date], today()-1) = 0&#13;&#10;THEN day(today()-1) - day([Calculation_1360650054689771520]) + 1&#13;&#10;&#13;&#10;//datum je v měsíci otevření -&gt; počítáme jen dny, kdy už byl otevřený&#13;&#10;ELSEIF datediff(&apos;month&apos;, [Calculation_1360650054689771520], [date]) = 0 &#13;&#10;THEN [Calculation_487233240966037507]-day([Calculation_1360650054689771520]) + 1 &#13;&#10;&#13;&#10;//datum je v tomto měsíci, počítáme jen dny, které uběhly&#13;&#10;ELSEIF datediff(&apos;month&apos;, [date], today()-1) = 0&#13;&#10;THEN day(today()-1)&#13;&#10;&#13;&#10;ELSE [Calculation_487233240966037507]&#13;&#10;END)' />
      </column>
      <column caption='# days in month' datatype='integer' name='[Calculation_487233240966037507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED month(date), year(date): max(DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [date])))))}' />
      </column>
      <column caption='Date before Last Activation Date Filter' datatype='boolean' name='[Calculation_487233241219678219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &gt;= [Calculation_1360650054689771520]' />
      </column>
      <column caption='Order Month Label' datatype='string' name='[Calculation_487233241228054541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Order Month&apos;' />
      </column>
      <column caption='Activation Month' datatype='string' name='[Calculation_487233241228759054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATETRUNC(&apos;month&apos;, [Calculation_1360650054689771520])), 7)' />
      </column>
      <column caption='2 month activated filter' datatype='boolean' name='[Calculation_487233241280069647]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_1360650054689771520], today()-1) &lt;= 60' />
      </column>
      <column caption='Vendors with 75 orders and more in 60 days' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_487233241280663568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if { FIXED [vendor_code], [Calculation_1630021646741553152]: [Calculation_668784567361150990]} &gt;= 75 then [vendor_code] end)' />
      </column>
      <column caption='F60D' datatype='real' default-format='p0.0%' name='[Calculation_487233241281318929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_487233241280663568]/[Calculation_668784567640444961]' />
      </column>
      <column caption='Hunter' datatype='string' name='[Calculation_494833054108110849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_self_signup] &#13;&#10;then &apos;self signup&apos;&#13;&#10;else [hunter_email]&#13;&#10;end' />
      </column>
      <column caption='# Vendors with call' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_503277268889235458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vendor_code]: MAX(IF (IF DATEDIFF(&apos;month&apos;, [Calculation_1360650054689771520], [date]) &lt;= 3 THEN [count_calls (incubation)] END) &gt; 0 then 1 else 0 END) }' />
      </column>
      <column caption='VF Deal Vendors' datatype='integer' name='[Calculation_5772418512719228930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [has_vf_deal] then [vendor_code] end)' />
      </column>
      <column caption='% Vendors with VFD' datatype='real' name='[Calculation_5772418512719888387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5772418512719228930] / countd([vendor_code])' />
      </column>
      <column caption='Has Self Activation NCR' datatype='boolean' name='[Calculation_624874471997378561]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if SUM([self_activation_ncr]) &gt; 0 then true else false end' />
      </column>
      <column caption='Activated x months ago' datatype='string' name='[Calculation_668784567339732992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 0&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 30&#13;&#10;then &apos;Activated 1 month ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 60 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 31 then &apos;Activated 2 months ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 90 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 61 then &apos;Activated 3 months ago&apos;&#13;&#10;else &apos;Not in Incubation&apos;&#13;&#10;end' />
      </column>
      <column caption='Months since Activation' datatype='string' name='[Calculation_668784567339974657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt;= 0&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 30&#13;&#10;then &apos;0-30 days since activation&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt; 30&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 60&#13;&#10;then &apos;31-60 days since activation&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt; 60&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 90&#13;&#10;then &apos;61-90 days since activation&apos;&#13;&#10;end' />
      </column>
      <column aggregation='Sum' caption='Days since Activation' datatype='integer' name='[Calculation_668784567340728323]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date])' />
      </column>
      <column caption='Days since Activation Filter' datatype='boolean' name='[Calculation_668784567341092869]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_668784567340728323] &gt;= 0' />
      </column>
      <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_668784567343255559]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_over_10_count])/sum([orders_not_preorder])' />
      </column>
      <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_668784567343652872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_scheduled_open_seconds])-SUM(IFNULL([total_closed_seconds], 0)))/SUM([total_scheduled_open_seconds])&#13;&#10;&#13;&#10;//(SUM([Total Scheduled Open Seconds])-SUM(IFNULL([Total Closed Seconds],0)))/SUM([Total Scheduled Open Seconds])' />
      </column>
      <column caption='# Orders total' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567343984649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([successful_orders]))+zn(sum([failed_orders]))' />
      </column>
      <column caption='DLD' datatype='real' default-format='p0.0%' name='[Calculation_668784567344394250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([products_desc])/sum([active_products])' />
      </column>
      <column caption='DLP' datatype='real' default-format='p0.0%' name='[Calculation_668784567344619531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([products_image])/sum([active_products])' />
      </column>
      <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_668784567354081293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([failed_orders]))/[Calculation_668784567343984649]' />
      </column>
      <column caption='# Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567361150990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_orders])' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_668784567378780176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(if [decline_type] = &apos;VENDOR&apos; then [failed_orders] end))/[Calculation_668784567343984649]' />
      </column>
      <column caption='Activation Date From (Default) ' datatype='date' name='[Calculation_668784567629180950]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN(if datediff(&apos;month&apos;, [Calculation_1360650054689771520], today()-1) = 0 then [Calculation_1360650054689771520] end)}' />
      </column>
      <column caption='Current Month Filter' datatype='boolean' name='[Calculation_668784567630012439]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datediff(&apos;month&apos;, [date], [Parameters].[Parameter 4]) = 0' />
      </column>
      <column caption='Max Data Date' datatype='date' name='[Calculation_668784567633567769]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([date])}' />
      </column>
      <column caption='Max Activation Date' datatype='date' name='[Calculation_668784567634362395]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([Calculation_1360650054689771520])}' />
      </column>
      <column caption='Activation Date Filter' datatype='boolean' name='[Calculation_668784567635636252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1360650054689771520] &gt;= [Parameters].[Parameter 5] and [Calculation_1360650054689771520] &lt;= [Parameters].[Parameter 6]' />
      </column>
      <column caption='min activation date' datatype='date' name='[Calculation_668784567638773790]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{fixed [Calculation_668784567639744543]: min([Calculation_1360650054689771520])}' />
      </column>
      <column caption='Activated x months ago (reporting date)' datatype='string' name='[Calculation_668784567639744543]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Parameters].[Parameter 4]) &gt;= 0&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Parameters].[Parameter 4]) &lt;= 30&#13;&#10;then &apos;Activated 1 month ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Parameters].[Parameter 4]) &lt;= 60 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Parameters].[Parameter 4]) &gt;= 31 then &apos;Activated 2 months ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Parameters].[Parameter 4]) &lt;= 90 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Parameters].[Parameter 4]) &gt;= 61 then &apos;Activated 3 months ago&apos;&#13;&#10;else &apos;Not in Incubation&apos;&#13;&#10;end' />
      </column>
      <column caption='# Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567640444961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([vendor_code])' />
      </column>
      <column caption='AVG # Orders' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_668784567641018402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ FIXED [vendor_code], month([date]): [Calculation_668784567361150990]})' />
      </column>
      <column caption='Is the month finished?' datatype='string' name='[Calculation_668784567687847974]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if dateadd(&apos;day&apos;, 30, [Calculation_965177718200557568]) &gt; [Calculation_668784567633567769] and contains([Calculation_668784567339974657],  &apos;30&apos;) then &apos;Unfinished&apos;&#13;&#10;ELSEIF  dateadd(&apos;day&apos;, 60, [Calculation_965177718200557568]) &gt; [Calculation_668784567633567769] and contains([Calculation_668784567339974657],  &apos;60&apos;) then &apos;Unfinished&apos;&#13;&#10;ELSEIF  dateadd(&apos;day&apos;, 90, [Calculation_965177718200557568]) &gt; [Calculation_668784567633567769] and contains([Calculation_668784567339974657],  &apos;90&apos;) then &apos;Unfinished&apos;&#13;&#10;else &apos;Finished&apos;&#13;&#10;end' />
      </column>
      <column caption='% Pro Orders' datatype='real' default-format='p0.0%' name='[Calculation_668784567699116074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_orders])/[Calculation_668784567361150990]' />
      </column>
      <column caption='ID' datatype='string' name='[Calculation_6707056173311840256]' role='dimension' type='nominal'>
