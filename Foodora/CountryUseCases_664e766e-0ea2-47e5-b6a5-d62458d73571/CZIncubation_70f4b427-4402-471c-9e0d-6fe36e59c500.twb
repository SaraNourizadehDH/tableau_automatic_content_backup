        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1m3uqdj0oww1hv11sy1x01ofx33p' name='last_contact' type='text'>select&#13;
  a.grid__c,&#13;
  /*t.type,&#13;
  t.tasksubtype,&#13;
  t.activity_subject__c,*/&#13;
  max(date(t.completeddatetime)) as last_contact_date&#13;
from `fulfillment-dwh-production.curated_data_shared_salesforce.task` t&#13;
join `fulfillment-dwh-production.curated_data_shared_salesforce.account` a on t.accountid = a.id&#13;
where true&#13;
--and t.type = &apos;Meeting&apos;&#13;
and t.tasksubtype in (&apos;Task&apos;, &apos;Call&apos;)&#13;
and t.status = &apos;Completed&apos;&#13;
and t.activity_subject__c = &apos;Call - Decision maker reached&apos;&#13;
and t.partition_date &gt;&gt;= &apos;2020-05-01&apos;&#13;
group by all&#13;
order by 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
