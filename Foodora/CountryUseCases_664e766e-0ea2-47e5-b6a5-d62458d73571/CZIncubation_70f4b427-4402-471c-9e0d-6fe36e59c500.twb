    <worksheet name='# Vendors with Contact (call or task)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1b1b1b' fontname='Tableau Medium'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#df1067' fontname='Tableau Medium' fontsize='10'>Only Vendors in Incubation (Both vendors and calls max 3 months since Activation)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='incubation' name='federated.1uo8wg105am5uk1c2ut4o03dubma' />
          </datasources>
          <datasource-dependencies datasource='federated.1uo8wg105am5uk1c2ut4o03dubma'>
            <column caption='# Vendors with successful call' datatype='integer' default-format='n#,##0;-#,##0' name='[# Vendors with call (copy)_503277268891541507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_code]: MAX(IF (IF DATEDIFF(&apos;month&apos;, [Calculation_1360650054689771520], [date]) &lt;= 3 THEN [count_succesful_calls (incubation)] END) &gt; 0 then 1 else 0 END) }' />
            </column>
            <column caption='Last Activation Date' datatype='date' name='[Calculation_1360650054689771520]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [global_vendor_id] = &apos;HRB0JO&apos; then date(&apos;2024-10-23&apos;) &#13;&#10;else [last_activation_date]&#13;&#10;end' />
            </column>
            <column caption='Hunter' datatype='string' name='[Calculation_494833054108110849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_self_signup] &#13;&#10;then &apos;self signup&apos;&#13;&#10;else [hunter_email]&#13;&#10;end' />
            </column>
            <column caption='# Vendors with call' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_503277268889235458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_code]: MAX(IF (IF DATEDIFF(&apos;month&apos;, [Calculation_1360650054689771520], [date]) &lt;= 3 THEN [count_calls (incubation)] END) &gt; 0 then 1 else 0 END) }' />
            </column>
            <column caption='Months since Activation' datatype='string' name='[Calculation_668784567339974657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt;= 0&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 30&#13;&#10;then &apos;0-30 days since activation&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt; 30&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 60&#13;&#10;then &apos;31-60 days since activation&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt; 60&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 90&#13;&#10;then &apos;61-90 days since activation&apos;&#13;&#10;end' />
            </column>
            <column caption='# Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567640444961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([vendor_code])' />
            </column>
            <column caption='Activation Dates diff' datatype='integer' name='[Calculation_965177718244442120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='datediff(&apos;day&apos;, date([activated_at_local]), [Calculation_1360650054689771520])' />
            </column>
            <column caption='Is WinBack' datatype='boolean' name='[Calculation_965177718245154825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_965177718244442120] &gt; 0' />
            </column>
            <column datatype='datetime' name='[activated_at_local]' role='dimension' type='ordinal' />
            <column caption='# Calls' datatype='integer' default-format='n#,##0;-#,##0' name='[count_calls (incubation)]' role='measure' type='quantitative' />
            <column caption='# Succesful Calls' datatype='integer' default-format='n#,##0;-#,##0' name='[count_succesful_calls (incubation)]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Global Vendor ID' datatype='string' name='[global_vendor_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[hunter_email]' role='dimension' type='nominal' />
            <column caption='Is Active' datatype='boolean' name='[is_active]' role='dimension' type='nominal' />
            <column caption='Is Private' datatype='boolean' name='[is_private]' role='dimension' type='nominal' />
            <column caption='Is SelfSignup' datatype='boolean' name='[is_self_signup]' role='dimension' type='nominal' />
            <column datatype='date' name='[last_activation_date]' role='dimension' type='ordinal' />
