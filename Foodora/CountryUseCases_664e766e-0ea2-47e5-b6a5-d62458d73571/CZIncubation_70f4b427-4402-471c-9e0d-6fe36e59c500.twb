            <column alias='Ne' caption='Ukaž data' datatype='boolean' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Ne' />
                <alias key='true' value='Ano' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uo8wg105am5uk1c2ut4o03dubma'>
            <column caption='# Vendor Failed Orders' datatype='integer' default-format='p0.0%' name='[% Vendor Fail Rate (copy)_7852237082424012800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [decline_type] = &apos;VENDOR&apos; then [failed_orders] end)' />
            </column>
            <column caption='Show Data Filter' datatype='boolean' name='[Calculation_1157706607132925965]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Last Activation Date' datatype='date' name='[Calculation_1360650054689771520]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [global_vendor_id] = &apos;HRB0JO&apos; then date(&apos;2024-10-23&apos;) &#13;&#10;else [last_activation_date]&#13;&#10;end' />
            </column>
            <column caption='Hunter' datatype='string' name='[Calculation_494833054108110849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_self_signup] &#13;&#10;then &apos;self signup&apos;&#13;&#10;else [hunter_email]&#13;&#10;end' />
            </column>
            <column caption='Has Self Activation NCR' datatype='boolean' name='[Calculation_624874471997378561]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if SUM([self_activation_ncr]) &gt; 0 then true else false end' />
            </column>
            <column caption='Activated x months ago' datatype='string' name='[Calculation_668784567339732992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 0&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 30&#13;&#10;then &apos;Activated 1 month ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 60 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 31 then &apos;Activated 2 months ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 90 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 61 then &apos;Activated 3 months ago&apos;&#13;&#10;else &apos;Not in Incubation&apos;&#13;&#10;end' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_668784567343652872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_scheduled_open_seconds])-SUM(IFNULL([total_closed_seconds], 0)))/SUM([total_scheduled_open_seconds])&#13;&#10;&#13;&#10;//(SUM([Total Scheduled Open Seconds])-SUM(IFNULL([Total Closed Seconds],0)))/SUM([Total Scheduled Open Seconds])' />
            </column>
            <column caption='# Orders total' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567343984649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([successful_orders]))+zn(sum([failed_orders]))' />
            </column>
            <column caption='# Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567361150990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_668784567378780176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(if [decline_type] = &apos;VENDOR&apos; then [failed_orders] end))/[Calculation_668784567343984649]' />
            </column>
            <column caption='Max Data Date' datatype='date' name='[Calculation_668784567633567769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([date])}' />
            </column>
