    <worksheet name='Incubation'>
      <table>
        <view>
          <datasources>
            <datasource caption='incubation' name='federated.1uo8wg105am5uk1c2ut4o03dubma' />
          </datasources>
          <datasource-dependencies datasource='federated.1uo8wg105am5uk1c2ut4o03dubma'>
            <column caption='Average Orders' datatype='real' name='[Calculation_1044553687337951232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_code], [global_vendor_id], [Calculation_668784567341092869]: [Calculation_668784567361150990] }/DATEDIFF(&apos;day&apos;, [Calculation_1360650054689771520], today())' />
            </column>
            <column caption='Activated x weeks ago' datatype='string' name='[Calculation_1052716436223447040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if dateadd(&apos;day&apos;, 15, [Calculation_1360650054689771520]) &gt;= today()-1 then &apos;Activated 1 or 2 weeks ago&apos;&#13;&#10;elseif dateadd(&apos;day&apos;, 31, [Calculation_1360650054689771520]) &gt;= today()-1 then &apos;Activated 3 or 4 weeks ago&apos;&#13;&#10;end' />
            </column>
            <column caption='Last Activation Date' datatype='date' name='[Calculation_1360650054689771520]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [global_vendor_id] = &apos;HRB0JO&apos; then date(&apos;2024-10-23&apos;) &#13;&#10;else [last_activation_date]&#13;&#10;end' />
            </column>
            <column caption='Hunter' datatype='string' name='[Calculation_494833054108110849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_self_signup] &#13;&#10;then &apos;self signup&apos;&#13;&#10;else [hunter_email]&#13;&#10;end' />
            </column>
            <column caption='Activated x months ago' datatype='string' name='[Calculation_668784567339732992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 0&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 30&#13;&#10;then &apos;Activated 1 month ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 60 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 31 then &apos;Activated 2 months ago&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &lt;= 90 &#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [Calculation_668784567633567769]) &gt;= 61 then &apos;Activated 3 months ago&apos;&#13;&#10;else &apos;Not in Incubation&apos;&#13;&#10;end' />
            </column>
            <column caption='Months since Activation' datatype='string' name='[Calculation_668784567339974657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt;= 0&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 30&#13;&#10;then &apos;0-30 days since activation&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt; 30&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 60&#13;&#10;then &apos;31-60 days since activation&apos;&#13;&#10;elseif datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &gt; 60&#13;&#10;and datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date]) &lt;= 90&#13;&#10;then &apos;61-90 days since activation&apos;&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='Days since Activation' datatype='integer' name='[Calculation_668784567340728323]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='datediff(&apos;day&apos;, [Calculation_1360650054689771520], [date])' />
            </column>
            <column caption='Days since Activation Filter' datatype='boolean' name='[Calculation_668784567341092869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_668784567340728323] &gt;= 0' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_668784567343255559]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_over_10_count])/sum([orders_not_preorder])' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_668784567343652872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_scheduled_open_seconds])-SUM(IFNULL([total_closed_seconds], 0)))/SUM([total_scheduled_open_seconds])&#13;&#10;&#13;&#10;//(SUM([Total Scheduled Open Seconds])-SUM(IFNULL([Total Closed Seconds],0)))/SUM([Total Scheduled Open Seconds])' />
            </column>
            <column caption='# Orders total' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567343984649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(sum([successful_orders]))+zn(sum([failed_orders]))' />
            </column>
            <column caption='DLD' datatype='real' default-format='p0.0%' name='[Calculation_668784567344394250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([products_desc])/sum([active_products])' />
            </column>
            <column caption='DLP' datatype='real' default-format='p0.0%' name='[Calculation_668784567344619531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([products_image])/sum([active_products])' />
            </column>
            <column caption='# Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_668784567361150990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_668784567378780176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(if [decline_type] = &apos;VENDOR&apos; then [failed_orders] end))/[Calculation_668784567343984649]' />
            </column>
            <column caption='Max Data Date' datatype='date' name='[Calculation_668784567633567769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([date])}' />
            </column>
            <column caption='# Sessions' datatype='integer' name='[Calculation_692428457157115904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])' />
            </column>
            <column caption='% CVR' datatype='real' default-format='p0.0%' name='[Calculation_692428457157337089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_668784567361150990]/[Calculation_692428457157115904]' />
            </column>
            <column aggregation='Sum' caption='Days opened' datatype='integer' name='[Days since Activation (copy)_1422574546041548800]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='datediff(&apos;day&apos;, [Calculation_1360650054689771520], today()-1)' />
            </column>
