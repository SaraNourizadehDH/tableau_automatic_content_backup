            <column caption='Time Filter - L6P' datatype='boolean' name='[Time Filter - Dynamic (copy)_5528801897640345603]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[time_value]&gt;=&#10;IF [time_aggregation] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;,-[Parameters].[Parameter 1]-5, DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [time_aggregation] = &apos;Weekly&apos; THEN DATEADD(&apos;iso-week&apos;,-[Parameters].[Parameter 1]-5, DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [time_aggregation] = &apos;Daily&apos; THEN DATEADD(&apos;day&apos;,-[Parameters].[Parameter 1]-5, TODAY())&#10;END&#10;&#10;AND &#10;&#10;[time_value]&lt;&#10;IF [time_aggregation] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;,-[Parameters].[Parameter 1]+1, DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [time_aggregation] = &apos;Weekly&apos; THEN DATEADD(&apos;iso-week&apos;,-[Parameters].[Parameter 1]+1, DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [time_aggregation] = &apos;Daily&apos; THEN DATEADD(&apos;day&apos;,-[Parameters].[Parameter 1]+1, TODAY())&#10;END' />
