              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Net GMV&apos; THEN [net_gmv_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Orders&apos; THEN [orders_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Conversion Rate&apos; THEN [cvr_delta_a]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Sessions&apos; THEN [sessions_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Avg User Spend&apos; THEN [avg_user_spend_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Order Frequency&apos; THEN [order_freq_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active Users&apos; THEN [active_users_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Avg User Spend&apos; THEN [avg_user_spend_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Avg Order Value&apos; THEN [net_amv_delta_p]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;On Time&apos; THEN [on_time_delta_a]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Order Lost&apos; THEN [od_order_lost]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;VFD over nGMV&apos; THEN [vfi_over_ngmv (Custom SQL Query)]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;MFO nGMV Share&apos; THEN [mfo_gmv_share_delta_a]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Walker/ Bicycle Share&apos; THEN [walker_bicycle_order_share_delta_a]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;PU Active User Share&apos; THEN [pu_active_user_share_delta_a]&#10;END' />
