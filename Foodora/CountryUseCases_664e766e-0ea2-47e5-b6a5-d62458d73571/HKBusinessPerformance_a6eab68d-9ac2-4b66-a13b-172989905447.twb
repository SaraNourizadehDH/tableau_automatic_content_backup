      <aliases enabled='yes' />
      <column caption='Custom Metrics - Actual' datatype='real' name='[Calculation_2576410869789290498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Net GMV&apos; THEN [net_gmv]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Orders&apos; THEN [orders]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Conversion Rate&apos; THEN ROUND([cvr]*100,1)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Sessions&apos; THEN [sessions]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Avg User Spend&apos; THEN ROUND([avg_user_spend],1)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Order Frequency&apos; THEN ROUND([order_freq],3)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Active Users&apos; THEN [active_users]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Avg User Spend&apos; THEN ROUND([avg_user_spend],0)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Avg Order Value&apos; THEN ROUND([net_amv],0)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;On Time&apos; THEN ROUND([on_time]*100,1)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Order Lost&apos; THEN ROUND([od_order_lost]*100,1)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;VFD over nGMV&apos; THEN ROUND([vfi_over_ngmv (Custom SQL Query)]*100,1)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;MFO nGMV Share&apos; THEN ROUND([mfo_gmv_share]*100,1)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Walker/ Bicycle Share&apos; THEN ROUND([walker_bicycle_order_share]*100,1)&#10;ELSEIF [Parameters].[Parameter 5] = &apos;PU Active User Share&apos; THEN ROUND([pu_active_user_share]*100,1)&#10;END' />
      </column>
      <column caption='Input Metrics 1' datatype='real' name='[Calculation_519673214286663685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LEFT([Parameters].[Parameter 2],1) = &apos;a&apos; THEN [shrinkage_order_lost]&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;b&apos; THEN ROUND([mfo_order_share]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;c&apos; THEN [sales_rep_productivity]&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;d&apos; THEN  ROUND([incentives_vf_ratio (Custom SQL Query)]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;e&apos; THEN [num_pu_beloved_brand]&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;f&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;g&apos; THEN ROUND([cyclable_order_share]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;h&apos; THEN ROUND([no_courier_fail]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;i&apos; THEN ROUND([hva_carc_spending_share]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;j&apos; THEN [pro_order_freq] &#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;k&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;l&apos; THEN ROUND([qc_gmv_share]*100,2)&#10;END' />
      </column>
      <column caption='Period Description' datatype='string' name='[Calculation_5528801898025500724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[time_name (Custom SQL Query)]+&apos;  (&apos;+&#10;&#10;IF [time_aggregation] = &apos;Daily&apos; THEN &apos;-&apos;&#10;&#10;ELSE &#10;STR(DAY([time_value]))+&apos;/&apos;+STR(MONTH([time_value])) + &apos; - &apos; + STR(DAY([Calculation_5528801898028568629]))+&apos;/&apos;+STR(MONTH([Calculation_5528801898028568629])) &#10;END&#10;&#10;+&apos;)&apos;' />
      </column>
      <column caption='Period End' datatype='datetime' name='[Calculation_5528801898028568629]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='MIN(&#10;{FIXED: MAX([time_value])},&#10;IF [time_aggregation] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;,1, [time_value])-1&#10;ELSEIF [time_aggregation] = &apos;Weekly&apos; THEN DATEADD(&apos;iso-week&apos;,1, [time_value])-1&#10;ELSEIF [time_aggregation] = &apos;Daily&apos; THEN DATEADD(&apos;day&apos;,1, [time_value])-1&#10;END&#10;)' />
      </column>
      <column caption='Test' datatype='date' name='[Calculation_5528801898094493750]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED: MAX([time_value])}' />
      </column>
      <column caption='Custom Metrics - Delta' datatype='real' name='[Custom Metrics - Actual (copy)_2576410869792501763]' role='measure' type='quantitative'>
