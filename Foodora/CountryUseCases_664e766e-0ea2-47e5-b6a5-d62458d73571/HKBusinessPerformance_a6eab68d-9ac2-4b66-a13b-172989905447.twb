              <calculation class='tableau' formula='IF LEFT([Parameters].[Parameter 2],1) = &apos;a&apos; THEN ROUND([available_vendors]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;b&apos; THEN ROUND([mfo_active_user_share]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;c&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;d&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;e&apos; THEN ROUND([vendor_price_parity_share]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;f&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;g&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;h&apos; THEN ROUND([rider_fill_rate]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;i&apos; THEN [pu_ntv]&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;j&apos; THEN ROUND([pro_active_user_share]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;k&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;l&apos; THEN [qc_order_freq]&#10;END' />
            </column>
            <column caption='Input Metrics 6' datatype='real' name='[Input Metrics 5 (copy)_519673214291656721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LEFT([Parameters].[Parameter 2],1) = &apos;a&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;b&apos; THEN ROUND([mfo_order_coverage]*100,2)&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;c&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;d&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;e&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;f&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;g&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;h&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;i&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;j&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;k&apos; THEN NULL&#10;ELSEIF LEFT([Parameters].[Parameter 2],1) = &apos;l&apos; THEN NULL&#10;END' />
