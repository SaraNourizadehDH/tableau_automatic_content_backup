  <column aggregation='Sum' caption='Is Refund Success' datatype='integer' name='[Calculation_5524931606290300928]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='{ FIXED [payment_owner_id] : max (IF [payment_type]=&apos;Refund&apos; and [status]=&apos;success&apos; THEN 1 ELSE 0 END) }' />
