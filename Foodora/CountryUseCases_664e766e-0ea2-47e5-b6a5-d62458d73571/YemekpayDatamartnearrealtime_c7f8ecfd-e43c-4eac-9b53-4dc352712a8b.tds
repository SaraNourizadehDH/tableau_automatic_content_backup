      <object caption='Custom SQL Query' id='_93CFE408168748AA82D62500A2C16AFF'>
        <properties context=''>
          <relation connection='bigquery.06kkrlk19uj3na157yn3j0jmu10q' name='Custom SQL Query' type='text'>select TIMESTAMP_ADD(content.timestamp, INTERVAL 3 HOUR) as timestamp ,&#10;       content.payment_id as payment_id,&#10;       content.payment_type as payment_type,&#10;       content.payment_owner.type as payment_owner_type,&#10;       content.payment_owner.id as payment_owner_id,&#10;       content.payment_owner.public_id as payment_owner_public_id,&#10;       content.payment_owner.status as payment_owner_status,&#10;       content.payment_owner.vendor_id as vendor_id,&#10;       content.payment_owner.platform_customer_id as platform_customer_id,&#10;       content.amount.amount as amount,&#10;       content.amount.currency as currency,&#10;       content.status as status,&#10;       content.payment_method as payment_method, &#10;       content.payment_service_provider as payment_service_provider,&#10;       content.event_type as event_type ,&#10;       content.payment_context as channel,&#10;       content.is_async_payment as is_async_payment,&#10;       content.operation_status as operation_status,&#10;       content.psp_response_code as psp_response_code,&#10;       content.psp_response_message as psp_response_message,&#10;       content.platform_error_code as platform_error_code,&#10;       content.platform_error_message as platform_error_message,&#10;       content.processor_response_code as processor_response_code,&#10;       content.processor_response_message as processor_response_message,&#10;       content.processor_reference_id as processor_reference_id,&#10;       content.is_online_payment_method as is_online_payment_method,&#10;       content.gateway_name as gateway_name,&#10;       content.gateway_version as gateway_version,&#10;       content.payment_method_name as payment_method_name,&#10;       content.psp_reference_id as psp_reference_id,&#10;       content.used_emoney_amount as used_emoney_amount,&#10;       content.requested_amount as requested_amount,&#10;       content.processed_amount as processed_amount,&#10;       content.is_requesting_tokenization as is_requesting_tokenization,&#10;       content.is_threeds_offered as is_threeds_offered,&#10;       content.threeds_status as threeds_status,&#10;       content.is_timed_out as is_timed_out,&#10;       content.duration_ms as duration_ms,&#10;       content.gateway_specific_response as gateway_specific_response,&#10;       content.business_contract as business_contract,&#10;       content.payment_instrument.payment_instrument_id as payment_instrument_id,&#10;       content.payment_instrument.card_scheme as card_scheme,&#10;       content.payment_instrument.card_bin as card_bin,&#10;       content.payment_instrument.card_last_digits as card_last_digits,&#10;       content.payment_instrument.is_tokenized as is_tokenized,&#10;       content.bank_code as bank_code,&#10;       content.bank_auth_code as bank_auth_code,&#10;       version,&#10;       t1.purchase_intent_id&#10;from `fulfillment-dwh-production.curated_data_shared_data_stream.payment_transaction_stream` t&#10;left join (select purchase_intent_id,order_code &#10;           from `fulfillment-dwh-production.curated_data_shared_fintech.alfred_purchase` t1 &#10;           where t1.purchase_date&gt;&gt; CURRENT_DATE(&apos;UTC+3&apos;) - 20 and global_entity_id=&apos;YS_TR&apos;&#10;           ) t1 on t.content.payment_owner.id=t1.order_code&#10;where content.global_entity_id=&apos;YS_TR&apos;  and date(content.timestamp) &gt;&gt;CURRENT_DATE(&apos;UTC+3&apos;) - 20</relation>
        </properties>
      </object>
