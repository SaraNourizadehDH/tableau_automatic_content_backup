  <column aggregation='Year' caption='Customer First Mix Payment Order Date' datatype='date' default-type='ordinal' name='[Customer First Wallet Order Dtae (copy)_1120833411666833408]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
