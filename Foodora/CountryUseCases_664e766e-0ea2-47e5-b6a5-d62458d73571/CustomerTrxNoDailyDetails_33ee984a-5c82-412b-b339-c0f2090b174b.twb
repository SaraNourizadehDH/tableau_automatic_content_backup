            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <collation flag='0' name='LROOT' />
            <attributes>
              <attribute datatype='integer' name='field-type'>2</attribute>
              <attribute datatype='string' name='formula'>&quot;IF [Calculation_3390506850267107343 1]=1 and not [Is having wallet amount (copy)_1525805515182379013] then &apos;Passive Wallet User&apos;
ELSEIF [Is having wallet amount (copy)_1525805515182379013]  and not [At least 1 wallet order in the last 3 months (copy)_6949406127365066753] then &apos;Inactive Wallet User&apos;
ELSEIF [Is having wallet amount (copy)_1525805515182379013] and [At least 1 wallet order in the last 3 months (copy)_6949406127365066753] then &apos;Active Wallet User&apos;
ELSEIF [Calculation_3390506850267107343 1]=0 and not [Is having wallet amount (copy)_1525805515182379013] then &apos;Non-Wallet User&apos;
ELSE NULL
END

// Pasif Cüzdan Kullanıcısı --&gt; ever da en az bir wallet siparişi var wallet bakiyesi yok
// İnaktif Cüzdan Kullanıcısı --&gt; wallet bakiyesi var ama son 1 yıldır hiç wallet siparişi yok 
// Aktif Cüzdan Kullanıcısı --&gt; wallet bakiyesi var son 1 yıldır en az bir tane wallet siparişi var 
// Cüzdan Kullancısı Olmayan --&gt; everda hiç wallet siparişi yok ve wallet bakiyesi de yok

// Passive Wallet User --&gt; no wallet balance, all orders have at least one wallet order
// Inactive Wallet User --&gt; there is a wallet balance but no wallet order for the last 1 year
// Active Wallet User --&gt; there is a wallet balance, there is at least one wallet order in the last 1 year
// Non-Wallet User --&gt; all orders have no wallet orders and no wallet balances&quot;</attribute>
              <attribute datatype='integer' name='role'>0</attribute>
              <attribute datatype='boolean' name='transient-data'>true</attribute>
            </attributes>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[yemekpay_datamart_9CE6119E3D204A51A43FF2C4FCF37610]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
