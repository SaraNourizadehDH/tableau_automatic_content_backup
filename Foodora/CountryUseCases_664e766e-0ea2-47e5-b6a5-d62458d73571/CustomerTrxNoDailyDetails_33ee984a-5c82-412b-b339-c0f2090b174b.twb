endor_city], [delivery_address_city])))=&apos;isparta&apos; Then &apos;Akdeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;mersin&apos; Then &apos;Akdeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;i̇stanbul&apos; Then &apos;İstanbul&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;i̇zmir&apos; Then &apos;İzmir&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kars&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kastamonu&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kayseri&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kırklareli&apos; Then &apos;Marmara Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kırşehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kocaeli&apos; Then &apos;Marmara Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;konya&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kütahya&apos; Then &apos;Ege Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;malatya&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;manisa&apos; Then &apos;Ege Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kahramanmaraş&apos; Then &apos;Akdeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;mardin&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;muğla&apos; Then &apos;Ege Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;muş&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;nevşehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;niğde&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;ordu&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;rize&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;sakarya&apos; Then &apos;Marmara Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;samsun&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;siirt&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;sinop&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;sivas&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;tekirdağ&apos; Then &apos;Marmara Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;tokat&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;trabzon&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;tunceli&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;şanlıurfa&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;uşak&apos; Then &apos;Ege Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;van&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;yozgat&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;zonguldak&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;aksaray&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bayburt&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;karaman&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kırıkkale&apos; Then &apos;İç Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;batman&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;şırnak&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bartın&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;ardahan&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;iğdır&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;yalova&apos; Then &apos;Marmara Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;karabük&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos