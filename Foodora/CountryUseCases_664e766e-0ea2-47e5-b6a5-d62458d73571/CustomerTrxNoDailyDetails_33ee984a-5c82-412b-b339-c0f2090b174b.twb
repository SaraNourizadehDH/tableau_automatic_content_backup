          <metadata-record class='column'>
            <remote-name>error_group (SE) (group)</remote-name>
            <remote-type>-1</remote-type>
            <local-name>[error_group (SE) (group)]</local-name>
            <parent-name>[sqlproxy]</parent-name>
            <remote-alias>error_group (SE) (group)</remote-alias>
            <ordinal>538</ordinal>
            <layered>true</layered>
            <caption>Error Group (Fraud Team)</caption>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <collation flag='0' name='LROOT' />
            <attributes>
              <attribute datatype='integer' name='field-type'>2</attribute>
              <attribute datatype='string' name='formula'>&quot;<![CDATA[CASE [alfred_transaction_error_message]
  WHEN \"API'den gelen 3D alanlar uyumsuz.\" THEN \"3D Inconsistency\"
  WHEN \"API'den gelen 3D alanlar uyumsuz. / 99\" THEN \"3D Inconsistency\"
  WHEN \"Bank Server : Genel Banka Hatası..[API'den gelen 3D alanlar uyumsuz.]\" THEN \"3D Inconsistency\"
  WHEN \"Hatali 3D Secure islem tutari / 99\" THEN \"3D Inconsistency\"
  WHEN \"Şifre Doğrulanamıyor./İletişim hatası..[PIN dogrulanamiyor.]\" THEN \"3D Inconsistency\"
  WHEN \"(-1): Başarısız. <br />Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Başarısız. <br />Sinirli Card.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Başarısız. 0058 POSa Izin Verilmeyen Islem\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Başarısız. 0063 G?venlik Ihlali\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Başarısız. 0078 G?venli Olmayan PIN\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Başarısız. Karta izin verilmeyen işlem\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Başarısız. Karta izin verilmeyen işlem<br />Kart sahibine acik olmayan islem.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Başarısız. Kisitli Kart\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Failed, Karta Izin Verilmeyen Islem\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Failed, Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Failed, Onaylanmadi\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Failed, Sinirli Kart\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Kart kaydi yok.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Sinirli Card.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(-1): Sinirli Kart (0062)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(0305): Kart Non Secure İşleme Kapalıdır.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(04): Kart bankası tarafından kullanıma kapatılmıştır, kart sahibi kredi kartı bankasından bilgi alabilir\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Kart geçici olarak kapatılmıştır.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Kart Statusunden Red.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Kart Takip Statüsünden red)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Kart, geçici olarak provizyona kapatılmış.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Korumaya alınan kart provizyona kapatılmıştır. Güvenlik ekibi müşteriyi arayacaktır.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Kuryeden teslim edilemeyen kartların belirli banka kuralları süresi sonunda aldığı statü.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Müşteri isteği ile kart kapatılmıştır)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Müşteri isteğiyle kullanılmak istenmeyen kartların aldığı statü.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Müşteri veya sistem tarafından iptal edilmiş.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Son basılan kart aktif değildir.Şifre belirlenmeli ya da şifreli işlem yapılmalıdır.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Şüpheli işlem nedeni ile kart kapatılmıştır.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(05): Onaylanmadi(Yutulmus Kart)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(07): Kart bankası tarafından kullanıma kapatılmıştır, kart sahibi kredi kartı bankasından bilgi alabilir\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(09): Islem izni yok.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(1403): Account is blocked.\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(41): Kayip Kart, Karti Alin(Müşteri isteği ile kart kapatılmıştır.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(43): Çalinti Kart, Karti Alin(Müşteri isteği ile kart kapatılmıştır.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(57): Karta Izin Verilmeyen Islem\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(57): Karta Izin Verilmeyen Islem(Asgari ödememe sayısı 3 den fazla.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(57): Karta Izin Verilmeyen Islem(İşlem Kısıtı Sebebiyle Red - Kart)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(57): Karta Izin Verilmeyen Islem(Kart status Gecikmede.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(57): Karta Izin Verilmeyen Islem(Müşteri statusu Gecikmede.)\" THEN \"Blocked/Restricted/Invalid Card\"
  WHEN \"(58): Terminale acik olmayan islem.\" THEN \"Blocked/Restricted/Invalid Card\"
