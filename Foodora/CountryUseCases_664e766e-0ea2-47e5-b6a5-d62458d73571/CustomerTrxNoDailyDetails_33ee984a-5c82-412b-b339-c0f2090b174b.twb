          <alias key='&quot;[sqlproxy.1lp88r90ako9cf1ggime50t5cmis].[usr:Wallet to Wallet (copy)_1525805515184341003:qk]&quot;' value='Amount Refunds (wallet to wallet)' />
        </aliases>
      </column>
      <column aggregation='User' caption='&lt; AOV Customer Count ' datatype='integer' default-type='quantitative' layered='true' name='[&lt; AOV Customer Count (copy)_1525805515147948034]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(IF [balance_amount]&lt;= [AOV (copy)_2891522111799799821] then [customer_code] END)' />
      </column>
      <column aggregation='Sum' caption='&lt; Wallet AOV ' datatype='real' default-type='quantitative' layered='true' name='[&lt; Wallet AOV (copy)_1525805515106660352]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='{ INCLUDE [customer_code]: AVG(IF [balance_amount]&lt;= [AOV (copy)_2891522111799799821] then [balance_amount] END)}' />
      </column>
      <column aggregation='User' caption='&gt; AOV Customer Count ' datatype='integer' default-type='quantitative' layered='true' name='[&gt; AOV Customer Count (copy)_1525805515148013571]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
