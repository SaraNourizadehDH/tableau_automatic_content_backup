          <calculation column='[Order Count for Filter (copy)_3487686120961142792]' formula='{ FIXED [Calculation_1993898383475601408], YEAR([created_at_local]),&#10;MONTH([created_at_local]),[channel]: &#10;COUNTD(IF [alfred_purchase_status]=&apos;Completed&apos; and &#10;[payment_method_type]=&apos;yemekpay_creditcard&apos;&#10;then [order_code] ELSE NULL END)}' />
          <calculation column='[Order Count with Monthly Amount Limit and PerTrx Limit  (copy)_3487686120991559692]' formula='COUNTD(&#10; IF  [Calculation_3487686120941703171]&gt;= [Parameters].[Parameter 1 2] &#10;and [Alfred Purchase Amount Lc Calc with Filter (copy)_3487686120957247495]&gt;=[Parameters].[Parameter 4]&#10;then [customer_code]&#10;ELSE NULL end)' />
          <calculation column='[Order Is Own Delivery (parameter) (copy)_590886364724187137]' formula='CASE [Parameters].[Order Is Own Delivery (parameter) (copy)_590886365055098882]&#10;WHEN &quot;Order Payment Method Group&quot; THEN [Calculation_4675440112588468224]&#10;WHEN &quot;Nothing&quot; THEN &apos;Nothing&apos;&#10;END' />
          <calculation column='[Order Total Value Local  (copy)_1177128360220180482]' formula='{ INCLUDE [order_code]: AVG([total_value_local])}' />
          <calculation column='[Payment to Wallet %  (copy)_2034290055277867009]' formula='COUNTD(&#10;IF not ISNULL([outcome]) and [rn_order]=1&#10;then [order_code] ELSE null&#10;END)&#10;/&#10;[Calculation_2892577609416015879]' />
          <calculation column='[Platform Attempts Count (copy)_5551812455448043522]' formula='AVG([attempts_count])' />
          <calculation column='[Pointer 1  (copy)_277182491948490764]' formula='IF [Online Card Rate (copy)_5948129222680457218]&gt;0.5 THEN .005 END' />
          <calculation column='[Refund % (copy)_2034290055359688707]' formula='COUNTD(&#10;IF not ISNULL([outcome]) and [rn_order]=1&#10;then [order_code] ELSE null&#10;END)' />
          <calculation column='[Refund GMV (OC to Wallet) (copy)_483151798304337920]' formula='sum({ INCLUDE [order_code],[event_timestamp]:  AVG(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; and [outcome]=&apos;payment_to_wallet&apos;&#10;THEN [refund_value_local]&#10;ELSE 0 end)})' />
          <calculation column='[SoftPOS (copy)_2982579280660049927]' formula='IF [Calculation_4675440112588468224]=&apos;Wallet&apos; then [Calculation_1873990040576630784]&#10;ELSE 0 END' />
          <calculation column='[Stolen Card Customer Code (copy)_3390506850249052164]' formula='CONTAINS(lower([alfred_transaction_error_message]),&apos;güvenlik ihlali&apos;) &#10;or CONTAINS(LOWER([alfred_transaction_error_message]),&apos;guvenlik ihlali&apos;)' />
          <calculation column='[Stolen Card Customer Code (copy)_3390506850249465861]' formula='CONTAINS(lower([alfred_transaction_error_message]),&apos;karta el koyunuz&apos;)&#10;Or&#10;CONTAINS(LOWER([alfred_transaction_error_message]),&apos;bloke&apos;)' />
          <calculation column='[Succesful Online Card Rate (Delivered) (copy)_3581135781974876160]' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and &#10;[parent_order_acceptance_status]=&apos;success&apos;&#10;then [order_code] ELSE NULL END)&#10;/ &#10;COUNTD([order_code])' />
          <calculation column='[Success Rate (copy)_3746009729838915586]' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and&#10;[parent_order_acceptance_status]=&apos;fail&apos; then [parent_order_id] END) / COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [parent_order_id] END)' />
          <calculation column='[Success Rate (copy)_5782270080129851397]' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos;&#10; and ([parent_order_acceptance_status]=&apos;recovery&apos; or&#10;[parent_order_acceptance_status]=&apos;success&apos;) then [parent_order_id] END) &#10;/ COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [parent_order_id] END)' />
          <calculation column='[Transfer Orders of OC to Wallet (copy)_1525805515184177162]' formula='COUNTD(&#10;IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and [outcome]=&apos;payment_to_wallet&apos;&#10;THEN [order_code]&#10;ELSE NULL end)' />
          <calculation column='[Wallet AOV (copy)_1272337269199675392]' formula='sum([Mix Payment GMV (copy)_557390827779395586])/ [Mix Payment Order Count (copy)_557390827779211265]' />
          <calculation column='[Wallet AOV (copy)_1272337269200580611]' formula='[Mix Payment Order Count (copy)_986006895991234562]/ [Mix Payment GMV (copy)_197525133058031620]' />
          <calculation column='[Wallet AOV (copy)_5519935465342578692 1]' formula='[Distinct Users (copy)_5519935465341874177]/ [Calculation_5519935465341493248 1]' />
          <calculation column='[Wallet AOV (copy)_5519935465342578692]' formula='COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; THEN [order_code]&#10;ELSE NULL end)/ COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; THEN [customer_code]&#10;ELSE NULL end)' />
          <calculation column='[Wallet Customer Profiles (copy)_1525805515182305284]' formula='IF [Calculation_3390506850267107343 1]=1 and not [Is having wallet amount (copy)_1525805515182379013] then &apos;Passive Wallet User&apos;&#10;ELSEIF [Is having wallet amount (copy)_1525805515182379013]  and not [At least 1 wallet order in the last 3 months (copy)_6949406127365066753] then &apos;Inactive Wallet User&apos;&#10;ELSEIF [Is having wallet amount (copy)_1525805515182379013] and [At least 1 wallet order in the last 3 months (copy)_6949406127365066753] then &apos;Active Wallet User&apos;&#10;ELSEIF [Calculation_3390506850267107343 1]=0 and not [Is having wallet amount (copy)_1525805515182379013] then &apos;Non-Wallet User&apos;&#10;ELSE NULL&#10;END&#10;&#10;// Pasif Cüzdan Kullanıcısı --&gt; ever da en az bir wallet siparişi var wallet bakiyesi yok&#10;// İnaktif Cüzdan Kullanıcısı --&gt; wallet bakiyesi var ama son 1 yıldır hiç wallet siparişi yok &#10;// Aktif Cüzdan Kullanıcısı --&gt; wallet bakiyesi var son 1 yıldır en az bir tane wallet siparişi var &#10;// Cüzdan Kullancısı Olmayan --&gt; everda hiç wallet siparişi yok ve wallet bakiyesi de yok&#10;&#10;// Passive Wallet User --&gt; no wallet balance, all orders have at least one wallet order&#10;// Inactive Wallet User --&gt; there is a wallet balance but no wallet order for the last 1 year&#10;// Active Wallet User --&gt; there is a wallet balance, there is at least one wallet order in the last 1 year&#10;// Non-Wallet User --&gt; all orders have no wallet orders and no wallet balances' />
          <calculation column='[Wallet GMV Share in Overall GMV (copy)_986006895989276672]' formula='[Calculation_1253900715025940482] /([Wallet Order (copy)_5519935465342033922]+[Calculation_1253900715025940482] )' />
          <calculation column='[Wallet Order (copy)_4588816221015044103]' formula='COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; and [is_own_delivery] THEN [order_code]&#10;ELSE NULL end)&#10;/ &#10;COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; THEN [order_code]&#10;ELSE NULL end)' />
          <calculation column='[Wallet Order (copy)_5519935465342033922]' formula='SUM(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; and [rn_order]=1 THEN [alfred_purchase_amount_lc]&#10;ELSE 0 END)' />
          <calculation column='[Wallet Order Share in Overall Orders (copy)_5519935465360650255]' formula='[Wallet Order (copy)_5519935465342033922]/ sum([Calculation_2892577609328549888])' />
          <calculation column='[Wallet to Wallet (copy)_1525805515184341003]' formula='SUM({ INCLUDE [order_code], [event_timestamp]: AVG(&#10;IF [outcome]=&apos;payment_to_wallet&apos; and [Calculation_4675440112588468224]=&apos;Wallet&apos; &#10;then [refund_value_local] ELSE 0 END)})' />
          <calculation column='[Wallet to Wallet Order Count (copy)_1525805515184427020]' formula='COUNTD(&#10;IF [outcome]=&apos;payment_to_wallet&apos; and [Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;then [order_code] ELSE NULL END)' />
          <calculation column='[customer last cashback balance amount (copy)_6130736126067552259]' formula='{ INCLUDE [customer_code]: AVG([refund_balance_amount])}' />
          <calculation column='[customer last refund balance amount (copy)_6130736126067625988]' formula='{ INCLUDE [customer_code]: AVG([topup_balance_amount])}' />
          <calculation column='[error_group (SE) (group)]' formula='CASE [alfred_transaction_error_message]&#10;  WHEN &quot;API&apos;den gelen 3D alanlar uyumsuz.&quot; THEN &quot;3D Inconsistency&quot;&#10;  WHEN &quot;API&apos;den gelen 3D alanlar uyumsuz. / 99&quot; THEN &quot;3D Inconsistency&quot;&#10;  WHEN &quot;Bank Server : Genel Banka Hatası..[API&apos;den gelen 3D alanlar uyumsuz.]&quot; THEN &quot;3D Inconsistency&quot;&#10;  WHEN &quot;Hatali 3D Secure islem tutari / 99&quot; THEN &quot;3D Inconsistency&quot;&#10;  WHEN &quot;Şifre Doğrulanamıyor./İletişim hatası..[PIN dogrulanamiyor.]&quot; THEN &quot;3D Inconsistency&quot;&#10;  WHEN &quot;(-1): Başarısız. &lt;br /&gt;Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Başarısız. &lt;br /&gt;Sinirli Card.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Başarısız. 0058 POSa Izin Verilmeyen Islem&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Başarısız. 0063 G?venlik Ihlali&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Başarısız. 0078 G?venli Olmayan PIN&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Başarısız. Karta izin verilmeyen işlem&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Başarısız. Karta izin verilmeyen işlem&lt;br /&gt;Kart sahibine acik olmayan islem.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Başarısız. Kisitli Kart&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Failed, Karta Izin Verilmeyen Islem&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Failed, Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Failed, Onaylanmadi&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Failed, Sinirli Kart&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Kart kaydi yok.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Sinirli Card.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(-1): Sinirli Kart (0062)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(0305): Kart Non Secure İşleme Kapalıdır.&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(04): Kart bankası tarafından kullanıma kapatılmıştır, kart sahibi kredi kartı bankasından bilgi alabilir&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Kart geçici olarak kapatılmıştır.)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Kart Statusunden Red.)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Kart Takip Statüsünden red)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Kart, geçici olarak provizyona kapatılmış.)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Korumaya alınan kart provizyona kapatılmıştır. Güvenlik ekibi müşteriyi arayacaktır.)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Kuryeden teslim edilemeyen kartların belirli banka kuralları süresi sonunda aldığı statü.)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Müşteri isteği ile kart kapatılmıştır)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Müşteri isteğiyle kullanılmak istenmeyen kartların aldığı statü.)&quot; THEN &quot;Blocked/Restricted/Invalid Card&quot;&#10;  WHEN &quot;(05): Onaylanmadi(Müşteri