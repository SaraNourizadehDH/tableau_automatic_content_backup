      <column aggregation='User' caption='Mix Payment Frequency' datatype='real' default-type='quantitative' layered='true' name='[Frequency (copy)_986006896054919173 1]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Calculation_1527775849187307520]/ [Mix Payment GMV (copy)_197525133058031620]' />
      </column>
      <column aggregation='User' caption='Mix Payment AOF' datatype='real' default-type='quantitative' layered='true' name='[Frequency (copy)_986006896054919173]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [alfred_payment_mix] =&apos;Balance + Card&apos; THEN [order_code]&#10;ELSE NULL end)&#10;/ COUNTD(&#10;IF [alfred_payment_mix] =&apos;Balance + Card&apos; THEN [customer_code]&#10;ELSE NULL end)' />
