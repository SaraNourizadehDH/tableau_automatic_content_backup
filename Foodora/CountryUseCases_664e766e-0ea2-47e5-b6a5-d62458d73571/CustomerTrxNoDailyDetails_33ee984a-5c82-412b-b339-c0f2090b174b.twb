  <column aggregation='User' caption='Measure Filter' datatype='real' default-type='quantitative' name='[Calculation_4510003209457766401]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='CASE [Parameters].[TimeFrame (copy)_4510003209457405952 1]&\#10;WHEN &quot;Order Count&quot; THEN [Calculation_2892577609416015879]&\#10;WHEN &quot;Customer Count&quot; THEN [Calculation_405675824185192449]&\#10;WHEN &quot;Purchase Amount&quot; THEN SUM([Calculation_1873990040576630784])&\#10;WHEN &quot;Vendor Count&quot; THEN [Calculation_405675824185401346]&\#10;END' />
  </column>
  <column aggregation='Count' caption='Order Payment Method Type Group' datatype='string' default-type='nominal' name='[Calculation_4675440112588468224]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IF TRIM([payment_method_type]) =&apos;balance&apos; THEN&\#9;&apos;Wallet&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;cash&apos; THEN &apos;Cash&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;cio_card&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;metropol_card&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;multinet&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;paye_card&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;set_card&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass_mobile&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_food_voucher&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_meal_card&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;winwin_mobile&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;yemekmatik_meal_card&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF  (TRIM([payment_method_type]) =&apos;yemekpay_cardpayment&apos; or TRIM([payment_method_type])=&apos;payment_on_delivery&apos;) THEN &apos;Card on Delivery&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;yemekpay_creditcard&apos; THEN &apos;Online Card&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;no_payment&apos; THEN &apos;No Payment&apos;&\#10;ELSEIF  TRIM([payment_method_type]) =&apos;voucher_tokenflex&apos; THEN &apos;Food Check&apos;&\#10;ELSEIF TRIM([payment_method_type]) =&apos;yemekpay_cardondelivery&apos;  THEN &apos;SoftPOS&apos; &\#10;ELSEIF TRIM([payment_method_type]) =&apos;craftgate_edenred&apos;  THEN &apos;Online Food Check&apos;&\#10;ELSEIF TRIM([payment_method_type]) = &apos;iyzico_yemeksepetipay&apos; THEN &apos;Iyzico&apos;&\#10;else [payment_method_type] END' />
  </column>
