  <column aggregation='Count' caption='Wallet Customer Profiles ' datatype='string' default-type='nominal' name='[Wallet Customer Profiles (copy)_1525805515182305284]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Calculation_3390506850267107343 1]=1 and not [Is having wallet amount (copy)_1525805515182379013] then &apos;Passive Wallet User&apos;&\#10;ELSEIF [Is having wallet amount (copy)_1525805515182379013]  and not [At least 1 wallet order in the last 3 months (copy)_6949406127365066753] then &apos;Inactive Wallet User&apos;&\#10;ELSEIF [Is having wallet amount (copy)_1525805515182379013] and [At least 1 wallet order in the last 3 months (copy)_6949406127365066753] then &apos;Active Wallet User&apos;&\#10;ELSEIF [Calculation_3390506850267107343 1]=0 and not [Is having wallet amount (copy)_1525805515182379013] then &apos;Non-Wallet User&apos;&\#10;ELSE NULL&\#10;END&\#10;&\#10;// Pasif Cüzdan Kullanıcısı --&gt; ever da en az bir wallet siparişi var wallet bakiyesi yok&\#10;// İnaktif Cüzdan Kullanıcısı --&gt; wallet bakiyesi var ama son 1 yıldır hiç wallet siparişi yok &\#10;// Aktif Cüzdan Kullanıcısı --&gt; wallet bakiyesi var son 1 yıldır en az bir tane wallet siparişi var &\#10;// Cüzdan Kullancısı Olmayan --&gt; everda hiç wallet siparişi yok ve wallet bakiyesi de yok&\#10;&\#10;// Passive Wallet User --&gt; no wallet balance, all orders have at least one wallet order&\#10;// Inactive Wallet User --&gt; there is a wallet balance but no wallet order for the last 1 year&\#10;// Active Wallet User --&gt; there is a wallet balance, there is at least one wallet order in the last 1 year&\#10;// Non-Wallet User --&gt; all orders have no wallet orders and no wallet balances' />
  </column>
