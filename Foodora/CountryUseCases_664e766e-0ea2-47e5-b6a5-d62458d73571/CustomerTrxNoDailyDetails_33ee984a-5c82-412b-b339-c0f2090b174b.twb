      <column aggregation='User' caption='Wallet Order' datatype='integer' default-type='quantitative' layered='true' name='[Distinct Users (copy)_5519935465341874177]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; THEN [order_code]&#10;ELSE NULL end)' />
      </column>
      <column aggregation='User' caption='Recovery Rate' datatype='real' default-type='quantitative' layered='true' name='[Fail Rate (copy)_3746009729840168963]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and &#10;[parent_order_acceptance_status]=&apos;recovery&apos; then [parent_order_id] END) /COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [parent_order_id] END)' />
      </column>
      <column aggregation='User' caption='First Mix Payment Customer Count' datatype='integer' default-type='quantitative' layered='true' name='[First Wallet Customer Count (copy)_223983739713257475]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD( IF YEAR([Customer First Wallet Order Dtae (copy)_1120833411666833408]) = YEAR([created_date_local])&#10;and MONTH([Customer First Wallet Order Dtae (copy)_1120833411666833408]) = MONTH([created_date_local])&#10;and [alfred_payment_mix]=&apos;Balance + Card&apos;&#10;THEN [customer_code]&#10;ELSE NULL&#10;END)' />
      </column>
      <column aggregation='Count' caption='Last Month Orders' datatype='string' default-type='nominal' layered='true' name='[First Wallet Order Count (copy)_223983739698642944]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [created_date_local]) = DATEPART(&apos;month&apos;, TODAY()) - 1 AND&#10;   DATEPART(&apos;year&apos;, [created_date_local]) = DATEPART(&apos;year&apos;, TODAY()) THEN&#10;  [dh_customer_code]&#10;END' />
      </column>
      <column aggregation='User' caption='First Wallet Customer Count' datatype='integer' default-type='quantitative' layered='true' name='[First Wallet Order Count (copy)_574068235239231491]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD( IF YEAR([customer_first_wallet_order_date]) = YEAR([created_at_local])&#10;and MONTH([customer_first_wallet_order_date]) = MONTH([created_at_local])&#10;and [Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;THEN [customer_code]&#10;ELSE NULL&#10;END)' />
      </column>
      <column aggregation='Year' caption='First nonsaved debit card usage date' datatype='date' default-type='ordinal' layered='true' name='[First saved debit card date (copy)_5636395685731659777]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED [customer_code]: MIN(IF [Calculation_3328230557660295168]=&apos;debit&apos; and [Calculation_3328230559168811013]=0 then [Calculation_720435259646189568]&#10;ELSE NULL End) }' />
      </column>
      <column aggregation='Count' caption='First nonsaved debit card date in campaign orders' datatype='boolean' default-type='nominal' layered='true' name='[First saved debit card date in campaign orders (copy)_5636395685739507715]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='DATE([First saved debit card date (copy)_5636395685731659777])= date([created_date_local])' />
      </column>
      <column aggregation='User' caption='AOF' datatype='real' default-type='quantitative' layered='true' name='[Frequency (copy)_585679062769635328]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Calculation_2892577609416015879]/ [Calculation_405675824185192449]' />
