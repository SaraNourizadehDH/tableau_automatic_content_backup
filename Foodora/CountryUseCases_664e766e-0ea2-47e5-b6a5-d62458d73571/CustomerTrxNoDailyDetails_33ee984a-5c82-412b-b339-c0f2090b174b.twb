    <calculation class='tableau' formula='IF (CONTAINS([payment_service_provider],&apos;garanti&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;GARANTİ&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;garanti&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;GARANTI&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;isbank&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;İŞ BANKASI&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;isbank&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;IS BANK&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;ziraat&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;ZİRAAT&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;ziraat&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;ZIRAAT&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;akbank&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;AKBANK&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;yapikredi&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;YAPI VE KREDİ&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;yapikredi&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;YAPI VE KREDI&apos;))&\#10;or (CONTAINS([payment_service_provider],&apos;yapikredi&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;YAPI KREDI&apos;))&\#10;then &apos;same bank&apos;&\#10;ELSEIF not ISNULL([on_us_card_bin]) &\#10;then &apos;on-us&apos;&\#10;ELSE &apos;not on-us&apos; END' />
  </column>
  <column aggregation='Count' caption='This Month' datatype='boolean' default-type='nominal' name='[Calculation_405675824146935808]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='YEAR([created_at_local]) = YEAR(TODAY())&\#10;and &\#10;MONTH([created_at_local]) = MONTH(TODAY())' />
  </column>
  <column aggregation='User' caption='Customer Count' datatype='integer' default-type='quantitative' name='[Calculation_405675824185192449]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='COUNTD([customer_code])' />
  </column>
  <column aggregation='User' caption='Vendor Count' datatype='integer' default-type='quantitative' name='[Calculation_405675824185401346]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='COUNTD([vendor_code])' />
  </column>
  <column aggregation='Count' caption='Is Active (last month order)' datatype='string' default-type='nominal' name='[Calculation_405675824193454084]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IF TODAY()-30&lt;=[created_at_local] then &apos;active&apos;&\#10;ELSEIF  TODAY()-30&gt;=[created_at_local]  then &apos;passive&apos;&\#10;END' />
  </column>
  <column aggregation='User' caption='Banabi Active Customer Count' datatype='integer' default-type='quantitative' name='[Calculation_405675824208797701]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='COUNTD(IF [channel]=&apos;Banabi&apos; and [Calculation_405675824193454084]=&apos;active&apos; then [customer_code] END)' />
  </column>
  <column aggregation='User' caption='Only Yemeksepeti Customer Count' datatype='integer' default-type='quantitative' name='[Calculation_405675824209588231]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='COUNTD(IF {FIXED [customer_code] :&\#10;           COUNTD(IF [alfred_purchase_status]=&apos;Completed&apos; or [alfred_purchase_status]=&apos;Cancelled&apos; &\#10;                  then [Calculation_183803176270573569] ELSE NULL END&\#10;                  )}=1 and [Calculation_183803176270573569]=&apos;Yemeksepeti&apos; then [customer_code] END)' />
  </column>
  <column aggregation='User' caption='Estimated Mass Campaign Cost for Banks' datatype='integer' default-type='quantitative' name='[Calculation_4110660613289758720]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='[Order Count with Monthly Amount Limit and PerTrx Limit  (copy)_3487686120991559692] * [Parameters].[Amount Limit per Transaction (copy)_2520749162934272001]' />
  </column>
  <column aggregation='User' caption='Motnly Order Frequency' datatype='real' default-type='quantitative' name='[Calculation_4110660613297582081]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='[Calculation_2892577609416015879]/ [Calculation_405675824185192449]' />
  </column>
  <column aggregation='Sum' caption='Is Received Alfred' datatype='integer' default-type='ordinal' name='[Calculation_412431276415684609]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
