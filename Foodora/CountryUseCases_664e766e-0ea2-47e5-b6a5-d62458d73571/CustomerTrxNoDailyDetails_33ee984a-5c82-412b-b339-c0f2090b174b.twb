          <calculation column='[Mix Payment Order Count (copy)_1527775849188282369]' formula='SUM(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1 then [alfred_balance_card_balance_part_amnt] ELSE 0 END)' />
          <calculation column='[Mix Payment Order Count (copy)_4588816221009924096]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; then [order_code] ELSE NULL END) / [Order Count (copy)_6714937462720217090]' />
          <calculation column='[Mix Payment Order Count (copy)_4588816221015654408]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [is_own_delivery] then [order_code] ELSE NULL END)&#10;/ &#10;COUNTD(&#10; IF  [alfred_payment_mix]=&apos;Balance + Card&apos; Then [order_code] ELSE NULL END)' />
          <calculation column='[Mix Payment Order Count (copy)_557390827779211265]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;then [order_code] ELSE NULL END)' />
          <calculation column='[Mix Payment Order Count (copy)_986006895991234562]' formula='SUM(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1  then [alfred_purchase_amount_lc] ELSE 0 END)' />
          <calculation column='[Mix Payment Wallet + Wallet AOV (copy)_4588816221030277129]' formula='[Mix Payment Order Count (copy)_986006895991234562] +[Wallet Order (copy)_5519935465342033922]' />
