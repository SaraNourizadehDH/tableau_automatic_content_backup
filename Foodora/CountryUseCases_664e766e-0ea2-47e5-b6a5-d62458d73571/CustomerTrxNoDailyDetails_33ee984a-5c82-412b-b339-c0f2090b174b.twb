      <column aggregation='Count' caption='at least 1 order in the last 3 months' datatype='boolean' default-type='nominal' layered='true' name='[Is Active (last month order) (copy)_4270256890294628353]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='TODAY()-90&lt;=[created_at_local]' />
      </column>
      <column aggregation='Count' caption='Is Balance Amount &lt; AOV' datatype='boolean' default-type='nominal' layered='true' name='[Is Balance Amount &gt; AOV (copy)_6839912340069924864]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='[balance_amount]&lt; [AOV (copy)_2891522111799799821] and [balance_amount]&gt;0' />
      </column>
      <column aggregation='Count' caption='Is Lost Card ' datatype='boolean' default-type='nominal' layered='true' name='[Is Stolen Card (copy)_3390506850249859078]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='CONTAINS([alfred_transaction_error_message],&apos;Kayıp Kart&apos;)' />
