    <calculation class='tableau' formula='IF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;adana&apos; Then &apos;Akdeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;adıyaman&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;afyonkarahisar&apos; Then &apos;Ege Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;ağrı&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;amasya&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;ankara&apos; Then &apos;Ankara&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;antalya&apos; Then &apos;Akdeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;artvin&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;aydın&apos; Then &apos;Ege Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;balıkesir&apos; Then &apos;Marmara Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bilecik&apos; Then &apos;Marmara Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bingöl&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bitlis&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bolu&apos; Then &apos;Karadeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;burdur&apos; Then &apos;Akdeniz Bölgesi&apos;&\#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bursa&