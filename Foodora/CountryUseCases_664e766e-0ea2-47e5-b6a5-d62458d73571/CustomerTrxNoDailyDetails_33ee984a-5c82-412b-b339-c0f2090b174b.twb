      <column aggregation='User' caption='Mix Payment + Wallet Frequency' datatype='real' default-type='quantitative' layered='true' name='[Frequency Mix Payment (copy)_1272337269200228354]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Mix Payment Order Count (copy)_557390827779211265]/ [Mix Payment Distinct User (copy)_557390827778707456]' />
      </column>
      <column aggregation='User' caption='Grey &gt;50%' datatype='real' default-type='quantitative' layered='true' name='[Grey &lt;50% (copy)_277182491947905034]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Online Card Rate (copy)_5948129222680457218]&gt;0.5 THEN 1-[Online Card Rate (copy)_5948129222680457218]&#10; ELSE 0.5 END' />
