            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <collation flag='0' name='LROOT' />
            <attributes>
              <attribute datatype='integer' name='field-type'>2</attribute>
              <attribute datatype='string' name='formula'>&quot;IF TRIM([payment_method_type]) =&apos;balance&apos; THEN	&apos;Wallet&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;cash&apos; THEN &apos;Cash&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;cio_card&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;metropol_card&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;multinet&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;paye_card&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;set_card&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass_mobile&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_food_voucher&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_meal_card&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;winwin_mobile&apos; THEN &apos;Food Check&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;yemekmatik_meal_card&apos; THEN &apos;Food Check&apos;
ELSEIF  (TRIM([payment_method_type]) =&apos;yemekpay_cardpayment&apos; or TRIM([payment_method_type])=&apos;payment_on_delivery&apos;) THEN &apos;Card on Delivery&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;yemekpay_creditcard&apos; THEN &apos;Online Card&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;no_payment&apos; THEN &apos;No Payment&apos;
ELSEIF  TRIM([payment_method_type]) =&apos;voucher_tokenflex&apos; THEN &apos;Food Check&apos;
ELSEIF TRIM([payment_method_type]) =&apos;yemekpay_cardondelivery&apos;  THEN &apos;SoftPOS&apos; 
ELSEIF TRIM([payment_method_type]) =&apos;craftgate_edenred&apos;  THEN &apos;Online Food Check&apos;
ELSEIF TRIM([payment_method_type]) = &apos;iyzico_yemeksepetipay&apos; THEN &apos;Iyzico&apos;
else [payment_method_type] END&quot;</attribute>
              <attribute datatype='integer' name='role'>0</attribute>
