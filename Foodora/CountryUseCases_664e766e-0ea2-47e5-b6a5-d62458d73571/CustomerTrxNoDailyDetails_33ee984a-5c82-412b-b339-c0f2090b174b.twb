      </column>
      <column aggregation='Sum' caption='&gt; Wallet AOV ' datatype='real' default-type='quantitative' layered='true' name='[&gt; Wallet AOV (copy)_1525805515106922497]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='{ INCLUDE [customer_code]: AVG(IF [balance_amount]&gt; [AOV (copy)_2891522111799799821] then [balance_amount] END)}' />
      </column>
      <column aggregation='Sum' caption='AOV (fixed)' datatype='real' default-type='ordinal' layered='true' name='[AOV (copy)_2891522111799799821]' pivot='key' role='dimension' type='ordinal' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED 1: SUM(&#10;IF [status_name]&lt;&gt;&apos;67 - Incomplete order&apos; &#10;and [Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;and DATEDIFF(&apos;day&apos;,[created_at_local],TODAY())&lt;=31&#10;then&#10;[Calculation_1873990040576630784] ELSE NULL END)/&#10;COUNTD(&#10;IF [status_name]&lt;&gt;&apos;67 - Incomplete order&apos; &#10;and [Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;and DATEDIFF(&apos;day&apos;,[created_at_local],TODAY())&lt;=31&#10;then&#10;[order_code] ELSE NULL END)&#10;}' />
      </column>
      <column aggregation='Sum' caption='Wallet AOV (fixed) ' datatype='real' default-type='ordinal' layered='true' name='[AOV (fixed) (copy)_1177128360214573056]' pivot='key' role='measure' type='ordinal' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED 1: SUM(&#10;IF [status_name]&lt;&gt;&apos;67 - Incomplete order&apos; &#10;and [Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;and DATEDIFF(&apos;day&apos;,[created_at_local],TODAY())&lt;=31&#10;and [rn_order]=1 THEN [Calculation_1873990040576630784] ELSE NULL END)/&#10;COUNTD(&#10;IF [status_name]&lt;&gt;&apos;67 - Incomplete order&apos; &#10;and [Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;and DATEDIFF(&apos;day&apos;,[created_at_local],TODAY())&lt;=31&#10;then&#10;[order_code] ELSE NULL END)&#10;}' />
