      <column aggregation='Count' caption='Region' datatype='string' default-type='nominal' layered='true' name='[Calculation_6770810227971653632]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;adana&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;adıyaman&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;afyonkarahisar&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;ağrı&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;amasya&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;ankara&apos; Then &apos;Ankara&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;antalya&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;artvin&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;aydın&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;balıkesir&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bilecik&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bingöl&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bitlis&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bolu&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;burdur&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;bursa&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;çanakkale&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;çankırı&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;çorum&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;denizli&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;diyarbakır&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;edirne&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;elazığ&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;erzincan&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;erzurum&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;eskişehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;gaziantep&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;giresun&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;gümüşhane&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;hakkari&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;hatay&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;isparta&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;mersin&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;i̇stanbul&apos; Then &apos;İstanbul&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;i̇zmir&apos; Then &apos;İzmir&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kars&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kastamonu&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kayseri&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kırklareli&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kırşehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kocaeli&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;konya&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kütahya&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;malatya&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;manisa&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;kahramanmaraş&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_city])))=&apos;mardin&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([vendor_city], [delivery_address_c