      </column>
      <column aggregation='Count' caption='Order Payment Method Type Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_4675440112588468224]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF TRIM([payment_method_type]) =&apos;balance&apos; THEN&#9;&apos;Wallet&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;cash&apos; THEN &apos;Cash&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;cio_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;metropol_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;multinet&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;paye_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;set_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass_mobile&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_food_voucher&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_meal_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;winwin_mobile&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;yemekmatik_meal_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  (TRIM([payment_method_type]) =&apos;yemekpay_cardpayment&apos; or TRIM([payment_method_type])=&apos;payment_on_delivery&apos;) THEN &apos;Card on Delivery&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;yemekpay_creditcard&apos; THEN &apos;Online Card&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;no_payment&apos; THEN &apos;No Payment&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;voucher_tokenflex&apos; THEN &apos;Food Check&apos;&#10;ELSEIF TRIM([payment_method_type]) =&apos;yemekpay_cardondelivery&apos;  THEN &apos;SoftPOS&apos; &#10;ELSEIF TRIM([payment_method_type]) =&apos;craftgate_edenred&apos;  THEN &apos;Online Food Check&apos;&#10;ELSEIF TRIM([payment_method_type]) = &apos;iyzico_yemeksepetipay&apos; THEN &apos;Iyzico&apos;&#10;else [payment_method_type] END' />
      </column>
      <column aggregation='Count' caption='Error Group' datatype='string' default-type='nominal' layered='true' name='[Calculation_5277304038223355908]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF ISNULL([alfred_transaction_error_message]) then  [decline_reason_title]&#10;ELSE [alfred_transaction_error_message]&#10;END' />
      </column>
      <column aggregation='User' caption='Coupon %' datatype='real' default-format='p0.00%' default-type='quantitative' layered='true' name='[Calculation_5321073347137495040]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='([Calculation_1993898384629563401]/[Calculation_2892577609416015879])' />
      </column>
      <column aggregation='User' caption='Order Customer Count' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_5456040587065135104]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD([ys_pandora_customer_id])' />
      </column>
      <column aggregation='Count' caption='BIN Number' datatype='string' default-type='nominal' layered='true' name='[Calculation_5486369523128643584]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IFNULL(IFNULL([gordon_card_bin],[instrument_bin]), [bin 1])' />
      </column>
      <column aggregation='Count' caption='Ödeme Tip Grup' datatype='string' default-type='nominal' layered='true' name='[Calculation_5507691299234193408]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='IF [payment_group]=&apos;Online Credit Card&apos; then &apos;Online Card&apos;&#10;ELSEIF   [payment_group]=&apos;Credit Card&apos; then &apos;Card on Delivery&apos; &#10;ELSEIF   [payment_group]=&apos;Cash&apos; then &apos;Cash on Delivery&apos; &#10;ELSE [payment_group]&#10;END' />
      </column>
      <column aggregation='Sum' caption='Toplam Sipariş Tutarı' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5507691299265187842]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[total_order_value]+ [wallet_balance]' />
      </column>
      <column aggregation='User' caption='Wallet Distinct Users' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_5519935465341493248 1]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; THEN [customer_code]&#10;ELSE NULL end)' />
      </column>
      <column aggregation='User' caption='Distinct Users' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_5519935465341493248]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; THEN [customer_code]&#10;ELSE NULL end)' />
      </column>
      <column aggregation='User' caption='Wallet AOV' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5519935465342418947]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Wallet Order (copy)_5519935465342033922]/ [Distinct Users (copy)_5519935465341874177]' />
      </column>
      <column aggregation='User' caption='Refund (wallet to wallet)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_5519935465350897670]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_4675440112588468224]=&apos;Wallet&apos; and [outcome]=&apos;payment_to_wallet&apos;&#10;THEN [order_code]&#10;ELSE NULL end)' />
      </column>
      <column aggregation='User' caption='Wallet Order Share in Overall Orders' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5519935465360527374]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Distinct Users (copy)_5519935465341874177]/ [Calculation_2892577609416015879]' />
      </column>
      <column aggregation='Count' caption='prefix campign filter' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_5534783209320677376]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='LEFT(LOWER([incentive_code]),3)=[Parameters].[Parameter 4 2]' />
      </column>
      <column aggregation='Year' caption='last order date before campaign' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5534783209761116168]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED [ys_pandora_customer_id]:&#10; MAX(IF [status_name]=&apos;621 - Order delivered&apos;  &#10;and [created_date_local]&lt; {FIXED [ys_pandora_customer_id]: MIN(IF LEFT([incentive_code],3)=[Parameters].[Parameter 4 2] &#10;then [created_date_local] ELSE NULL END)}&#10;THEN [created_date_local] ELSE NULL END)}' />
      </column>
      <column aggregation='User' caption='Parent Order Count' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_5551812455445962753]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD([parent_order_id])' />
      </column>
      <column aggregation='Year' caption='First saved debit card date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_5636395685730193408]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='{ FIXED [customer_code]: MIN(IF [Calculation_3328230557660295168]=&apos;debit&apos; and [Calculation_3328230559168811013]=1 then [first_card_saved_date]&#10;ELSE NULL End) }' />
      </column>
      <column aggregation='Count' caption='First saved debit card date in campaign orders' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_5636395685737918466]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='DATE([Calculation_5636395685730193408])= date([created_date_local])' />
      </column>
      <column aggregation='User' caption='First Wallet Order Count' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_574068235238813698]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD( IF YEAR([customer_first_wallet_order_date]) = YEAR([created_at_local])&#10;and MONTH([customer_first_wallet_order_date]) = MONTH([created_at_local])&#10;and [Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;THEN [order_code]&#10;ELSE NULL&#10;END)' />
      </column>
      <column aggregation='User' caption='3DS / CVV Rate' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5782270080129282051]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='COUNTD(IF not ISNULL([challenge_type]) then [order_code] ELSE NULL END)/ &#10;COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [order_code] ELSE NULL END)' />
