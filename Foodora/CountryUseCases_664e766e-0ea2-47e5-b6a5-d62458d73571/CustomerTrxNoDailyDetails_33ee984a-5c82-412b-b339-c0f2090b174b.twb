          <calculation column='[Measure Filter (copy)_1090785937600770049]' formula='CASE [Parameters].[Measure Name (copy)_1090785937600860162]&#10;WHEN &quot;PSP Group&quot; THEN [payment_service_provider (group)]&#10;WHEN &quot;Card Type&quot; THEN [Calculation_3328230557660295168]&#10;WHEN &quot;Card Brand&quot; THEN [card_brand]&#10;WHEN &quot;Onus Status&quot; THEN [Calculation_4042895470749589504]&#10;WHEN &quot;Challenge Type&quot; THEN [challenge_type]&#10;WHEN &quot;Is Saved Card&quot; THEN STR([Calculation_3328230559168811013])&#10;WHEN &quot;SoftPos Acquirer Bank&quot; THEN [Calculation_2943383854156795904]&#10;WHEN &quot;Nothing&quot; THEN NULL&#10;END' />
          <calculation column='[Mix Payment + Wallet GMV % in All orders (copy)_6714937462727270408]' formula='sum([Mix Payment GMV (copy)_557390827779395586])/ &#10;[Alfred Purchase Amount Lc Calc (copy)_1177128360219758593]' />
          <calculation column='[Mix Payment + Wallet GMV (copy)_4588816221013954565]' formula='SUM([Mix Payment GMV (copy)_557390827779395586])/ (SUM([Calculation_1949706809645998080])+ [Wallet Order (copy)_5519935465342033922])' />
          <calculation column='[Mix Payment + Wallet OD % (copy)_1525805515183443974]' formula='COUNTD(&#10; IF ([alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;) and [is_own_delivery]&#10;then [order_code] ELSE NULL END)&#10;/COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;then [order_code] ELSE NULL END)' />
          <calculation column='[Mix Payment + Wallet Order Count % in All orders (copy)_6714937462726152199]' formula='[Mix Payment Wallet + Wallet AOV (copy)_4588816221030277129] / &#10;[Alfred Purchase Amount Lc Calc (copy)_1177128360219758593]' />
          <calculation column='[Mix Payment + Wallet Order Count % in OC + wallet orders (copy)_6714937462725050374]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;then [order_code] ELSE NULL END) / &#10;[Calculation_2892577609416015879]' />
          <calculation column='[Mix Payment + Wallet Order Count (copy)_4588816221013614596]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;then [order_code] ELSE NULL END) / &#10;COUNTD(&#10;IF [payment_method_type]=&apos;yemekpay_creditcard&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;and [rn_order]=1&#10;then [order_code] END)' />
          <calculation column='[Mix Payment + Wallet Order Count (copy)_574068234650701824]' formula='COUNTD(&#10; IF ([alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;) and [is_own_delivery]&#10;then [order_code] ELSE NULL END)&#10;/COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;then [order_code] ELSE NULL END)' />
          <calculation column='[Mix Payment + Wallet Order Count (copy)_574068235206139905]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos;&#10;then [order_code] ELSE NULL END) / &#10;COUNTD(&#10; IF ([alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos; or [Calculation_4675440112588468224]=&apos;Online Card&apos;)&#10;then [order_code] ELSE NULL END)' />
          <calculation column='[Mix Payment AOF (copy)_1213790475911254016]' formula='COUNTD(&#10;IF ([alfred_payment_mix] =&apos;Balance + Card&apos; or [Calculation_4675440112588468224]=&apos;Wallet&apos;)  THEN [order_code]&#10;ELSE NULL end)&#10;/ COUNTD(&#10;IF ([alfred_payment_mix] =&apos;Balance + Card&apos; or [Calculation_4675440112588468224]=&apos;Wallet&apos;) THEN [customer_code]&#10;ELSE NULL end)' />
          <calculation column='[Mix Payment Distinct User (copy)_557390827778707456]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; or&#10;[Calculation_4675440112588468224]=&apos;Wallet&apos;&#10;then [customer_code] ELSE NULL END)' />
          <calculation column='[Mix Payment GMV % in All GMV (copy)_6714937462723141637]' formula='SUM(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1 &#10;then [alfred_balance_card_balance_part_amnt] ELSE 0 END)/ SUM([Order Total Value Local  (copy)_1177128360220180482])' />
          <calculation column='[Mix Payment GMV % in OC GMV (copy)_6714937462722691076]' formula='SUM(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1 &#10;then [Calculation_2892577609328549888] ELSE 0 END)/ SUM([Order Total Value Local  (copy)_1177128360220180482])' />
          <calculation column='[Mix Payment GMV (copy)_197525133058031620]' formula='COUNTD(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; then [customer_code] ELSE NULL END)' />
          <calculation column='[Mix Payment GMV (copy)_4588816221010456577]' formula='SUM(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1&#10;then [alfred_balance_card_balance_part_amnt] ELSE NULL END)/ SUM([Calculation_1949706809645998080])' />
          <calculation column='[Mix Payment GMV (copy)_557390827779395586]' formula='IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1 THEN [alfred_balance_card_balance_part_amnt] &#10;ELSEIF [Calculation_4675440112588468224]=&apos;Wallet&apos; and [rn_order]=1 THEN [alfred_purchase_amount_lc]&#10;END' />
