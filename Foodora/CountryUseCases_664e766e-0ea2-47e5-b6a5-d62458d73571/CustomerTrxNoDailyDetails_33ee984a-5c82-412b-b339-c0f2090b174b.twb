          <calculation column='[Mix Payment Wallet GMV (copy)_223983739716489221]' formula='[Mix Payment Order Count (copy)_986006895991234562]&#10;- &#10;SUM(IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1 &#10;      then [alfred_balance_card_balance_part_amnt] ELSE 0 END&#10;      )' />
          <calculation column='[Mix Payment Wallet GMV (copy)_4588816221011951619]' formula='SUM(&#10; IF [alfred_payment_mix]=&apos;Balance + Card&apos; and [rn_order]=1 &#10;then [Calculation_2892577609328549888] ELSE 0 END)/ SUM(&#10;IF [Calculation_4675440112588468224]=&apos;Online Card&apos; then&#10;[Calculation_2892577609328549888]  ELSE 0 END )' />
          <calculation column='[Mix Payment Wallet GMV Share in All Mix Payment GMV (copy)_986006895992881156]' formula='([Mix Payment Order Count (copy)_986006895991234562]-[Mix Payment Order Count (copy)_1527775849188282369])/[Mix Payment Order Count (copy)_986006895991234562]' />
