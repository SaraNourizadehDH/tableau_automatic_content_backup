      <column aggregation='User' caption='% Diff MoM Number of Refunds' datatype='real' default-format='p0.00%' default-type='quantitative' layered='true' name='[% Diff MoM Total Refund Value (copy)_2891522111781031941]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='(ZN([Calculation_2892577609416015879]) - LOOKUP(ZN([Calculation_2892577609416015879]), -1)) / ABS(LOOKUP(ZN([Calculation_2892577609416015879]), -1))'>
