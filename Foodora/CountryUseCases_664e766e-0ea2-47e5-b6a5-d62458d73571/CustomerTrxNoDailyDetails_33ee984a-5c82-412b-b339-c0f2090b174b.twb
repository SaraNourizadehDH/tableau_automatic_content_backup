          <calculation column='[OC to Wallet Order Count (copy)_1525805515184119817]' formula='COUNTD(&#10;IF [outcome]=&apos;payment_to_wallet&apos; and [Calculation_4675440112588468224]=&apos;Online Card&apos;&#10;then [order_code] ELSE NULL END)' />
          <calculation column='[Online Card Rate (copy)_5782270080125214722]' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and &#10;[status_name]=&apos;621 - Order delivered&apos;&#10;then [order_code] ELSE NULL END)&#10;/ &#10;COUNTD(IF [status_name]=&apos;621 - Order delivered&apos; then [order_code] ELSE NULL END)' />
          <calculation column='[Online Card Rate (copy)_5948129222680457218]' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and [Calculation_3328230559168811013]=1 and [status_name]&lt;&gt;&apos;67 - Incomplete order&apos;&#10;then [order_code] ELSE NULL END)&#10;/ &#10;COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and [status_name]&lt;&gt;&apos;67 - Incomplete order&apos;&#10;then [order_code] ELSE NULL END)' />
          <calculation column='[Order Count (copy)_5913578169104797696]' formula='COUNTD(IF [Calculation_5534783209320677376] THEN [order_code] ELSE NULL END)' />
