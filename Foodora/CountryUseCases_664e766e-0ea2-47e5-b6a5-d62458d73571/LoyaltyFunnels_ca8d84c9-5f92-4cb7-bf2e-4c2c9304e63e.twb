    <worksheet name='Category Definitions'>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Category Funnel' name='federated.1fl06x21cyzbfx125robg1hje6p6' />
          </datasources>
          <datasource-dependencies datasource='federated.1fl06x21cyzbfx125robg1hje6p6'>
            <column caption='Definitions' datatype='string' name='[Calculation_227994751461134336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column-instance column='[Calculation_227994751461134336]' derivation='Attribute' name='[attr:Calculation_227994751461134336:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <tooltip column='[federated.1fl06x21cyzbfx125robg1hje6p6].[attr:Calculation_227994751461134336:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontname='Tableau Bold' fontsize='12'>DEFINITIONS</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Active Participants</run>
                <run fontcolor='#000000'>: Users that achieve at least one of the criteria below; </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Æ&#9;</run>
                <run fontcolor='#000000'>-accepted a challenge</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Æ&#9;</run>
                <run fontcolor='#000000'>-have qualified loyalty order</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Æ&#9;</run>
                <run fontcolor='#000000'>-redeemed a voucher</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Æ&#9;</run>
                <run fontcolor='#000000'>-used a loyalty voucher </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>with at least one successful </run>
                <run bold='true' fontcolor='#000000'>platform order</run>
                <run fontcolor='#000000'> in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Acceptors:</run>
                <run fontcolor='#000000'> Users that accepted at least one stamp card in the selected period</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Completers:</run>
                <run fontcolor='#000000'> Users that completed at least one challenge in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Redeemers:</run>
                <run fontcolor='#000000'> Users that used their points to get vouchers from the reward shop in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Voucher Users:</run>
                <run fontcolor='#000000'> Users that used redeemed vouchers in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Bold' fontsize='12'>SUB-CATEGORY DEFINITIONS</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>New: </run>
                <run fontcolor='#202124'>Users who entered the relevant category for the first time. ( Ex.: If the user accepted any challenge for the first time in April 2023, will be counted as New Participant in that month.)</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Existing: </run>
                <run>Users that entered the category in a selected month but also the previous month. </run>
                <run fontcolor='#202124'>( Ex.: If the user completed any challenge in April 2023 and also in May 2023, will be counted as Existing Completer in May.)</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Reactivated: </run>
                <run fontcolor='#202124'>Users who last engaged in the relevant category more than 1 month ago. ( Ex.: If the user redeemed the last voucher in March 2023 but the next one is in Jul 2023, will be counted as Reactivated Redeemer in Jul.)</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Ratings/FAQ.png' />
                <format attr='size' value='1.5492265224456787' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
