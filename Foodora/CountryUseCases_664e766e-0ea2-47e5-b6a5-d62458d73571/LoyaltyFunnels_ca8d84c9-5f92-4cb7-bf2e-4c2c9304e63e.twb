    <worksheet name='total users cumulative trendline'>
      <table>
        <view>
          <datasources>
            <datasource caption='Total Users Cumulative Metrics' name='federated.0ccmslw1eint330zx6rze05j1165' />
          </datasources>
          <datasource-dependencies datasource='federated.0ccmslw1eint330zx6rze05j1165'>
            <column caption='Completers %' datatype='real' default-format='p0.0%' name='[Calculation_911134515024031747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([completers]))/RUNNING_SUM(SUM([total_users]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Users %' datatype='real' default-format='p0.0%' name='[Calculation_911134515024850953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg(1)' />
            </column>
            <column caption='Exposed %' datatype='real' default-format='p0.0%' name='[Completers % (copy)_911134515024175108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([exposed]))/RUNNING_SUM(SUM([total_users]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acceptors %' datatype='real' default-format='p0.0%' name='[Exposed % (copy)_911134515024265221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([participants]))/RUNNING_SUM(SUM([total_users]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Voucher Users %' datatype='real' default-format='p0.0%' name='[Interactors % (copy)_911134515024609288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(sum([voucher_users]))/RUNNING_SUM(SUM([total_users]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
