    <worksheet name='Overall Definitions'>
      <table>
        <view>
          <datasources>
            <datasource caption='Total Users Cumulative Metrics' name='federated.0ccmslw1eint330zx6rze05j1165' />
          </datasources>
          <datasource-dependencies datasource='federated.0ccmslw1eint330zx6rze05j1165'>
            <column caption='Definitions' datatype='string' name='[Calculation_883549972190048257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column-instance column='[Calculation_883549972190048257]' derivation='Attribute' name='[attr:Calculation_883549972190048257:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <tooltip column='[federated.0ccmslw1eint330zx6rze05j1165].[attr:Calculation_883549972190048257:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontname='Tableau Bold' fontsize='12'>DEFINITIONS</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Total Users: </run>
                <run fontcolor='#000000'>Total users that visit the platform in a given period (includes both mobile and web users). Includes Active Users (users that visit the app and place at least 1 order) and users that visit the app but do not place an order.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Exposed: </run>
                <run fontcolor='#000000'>Users who while visiting the app have seen at least one of the loyalty program entry points (Homepage Banner, FAB Icon, OTP Pop-up, etc.).</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Platform Orderers: </run>
                <run fontcolor='#000000'>Users that gave at least 1 successful order in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Visitors: </run>
                <run fontcolor='#000000'>Users that via one of the loyalty program entry points, enter the program’s home page and saw the current challenges.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Acceptors</run>
                <run fontcolor='#000000'>: Users that accepted at least one challenge in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Completers:</run>
                <run fontcolor='#000000'> Users that completed at least one challenge in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Redeemers:</run>
                <run fontcolor='#000000'> Users that used their points to get vouchers from the reward shop in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000'>Voucher Users:</run>
                <run fontcolor='#000000'> Users that used redeemed vouchers in the selected period.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='Ratings/FAQ.png' />
                <format attr='size' value='1.5492265224456787' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
