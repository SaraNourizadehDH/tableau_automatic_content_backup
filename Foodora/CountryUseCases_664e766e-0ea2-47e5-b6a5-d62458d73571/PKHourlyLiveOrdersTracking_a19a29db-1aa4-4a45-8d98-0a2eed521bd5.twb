    DATE_TRUNC(DATETIME(CURRENT_TIMESTAMP, lg_countries.timezone), SECOND) AS current_timestamp_local,
    content.courier.courier_id
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_status_stream` AS order_status_stream
  LEFT JOIN lg_countries
         ON order_status_stream.content.global_entity_id = lg_countries.global_entity_id
  LEFT JOIN regional_apac_pd_vendors_agg_lg_zones
         ON order_status_stream.global_entity_id = regional_apac_pd_vendors_agg_lg_zones.global_entity_id
        AND order_status_stream.content.vendor.id = regional_apac_pd_vendors_agg_lg_zones.vendor_code
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
