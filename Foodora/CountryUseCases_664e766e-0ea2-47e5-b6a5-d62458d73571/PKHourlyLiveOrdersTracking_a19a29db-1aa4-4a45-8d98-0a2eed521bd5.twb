          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2utov18re7qa1fw4r881fom6lz'>
            <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[current_timestamp_local])&#10;        OR &#10;        (DATEDIFF(&apos;hour&apos;, [current_timestamp_local], DATEADD(&apos;hour&apos;, 8, NOW()))&gt;=1 /*tableau server is utc time so need to +8*/&#10;        AND DATEPART(&apos;hour&apos;,[current_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Gross Orders Last Week (until previous hour)' datatype='integer' name='[Calculation_553802043050434560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Same day last week&apos; THEN [gross_orders] END' />
            </column>
            <column caption='Orders % Diff vs Same day LW' datatype='real' name='[Calculation_553802043052085250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([Last Week Delivered Orders (copy)_553802043050848257],0))-SUM([Calculation_553802043050434560]))&#10;/ &#10;SUM([Calculation_553802043050434560])' />
            </column>
            <column caption='WoW Orders Differences indicator' datatype='integer' name='[Calculation_553802043055484934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_553802043052085250] &gt; 0 THEN 1 &#10;ELSEIF [Calculation_553802043052085250] &lt; 0 THEN -1&#10;ELSEIF [Calculation_553802043052085250] = 0 THEN 0&#10;END' />
            </column>
            <column caption='Gross Orders Yesterday (until previous hour)' datatype='integer' name='[Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Yesterday&apos; THEN [gross_orders] END' />
            </column>
            <column caption='Gross Orders Today (until previous hour)' datatype='integer' name='[Last Week Delivered Orders (copy)_553802043050848257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Today&apos;&#10;&#10;THEN IFNULL([gross_orders],0)&#10;END' />
            </column>
            <column caption='Orders % Diff vs Yesterday' datatype='real' name='[Orders % Diff vs Same day LW (copy)_3234991946383167506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([Last Week Delivered Orders (copy)_553802043050848257],0))-SUM([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508]))&#10;/ &#10;SUM([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508])' />
