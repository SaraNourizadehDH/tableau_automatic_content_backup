  FROM active_riders
  WHERE lg_city_name IS NOT NULL --pgo orders will not have city name, removing at this stage so as not to double count when aggregating to country active riders in the dashboard (rider who did pgo orders most likely have done platform order as well)
  GROUP BY 1,2,3,4,5,6
