      <column caption='3H MA Fail Rate' datatype='real' name='[Fail Rate (copy)_3234991946836541462]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (SUM([Calculation_3234991946352541707]) &gt; [Calculation_1172343329695457280]) &#10;  THEN&#10;    SUM([Calculation_3234991946724876309])/ SUM([gross_orders_3h_moving_average_sum])&#10;END' />
