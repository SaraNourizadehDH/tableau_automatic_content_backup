    <worksheet name='Hourly Orders &amp; Fail Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datastream_orders' name='federated.0x2utov18re7qa1fw4r881fom6lz' />
            <datasource caption='Distinct Riders' name='federated.0dls45n02hmxpq185mtsl04rx1e8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Bar Chart Breakdown' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dls45n02hmxpq185mtsl04rx1e8'>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2utov18re7qa1fw4r881fom6lz'>
            <column caption='Orders' datatype='integer' name='[Calculation_1023583820284235776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Gross Orders Today (until previous hour) (copy)_3345400494063001603])' />
            </column>
            <column caption='Bar Chart Breakdown ' datatype='string' name='[Calculation_3345400494058725378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Country&apos; THEN [global_entity_id]&#10;WHEN &apos;Business Type&apos; THEN [business_type_apac]&#10;END' />
            </column>
            <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[current_timestamp_local])&#10;        OR &#10;        (DATEDIFF(&apos;hour&apos;, [current_timestamp_local], DATEADD(&apos;hour&apos;, 8, NOW()))&gt;=1 /*tableau server is utc time so need to +8*/&#10;        AND DATEPART(&apos;hour&apos;,[current_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_5354639245356118019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5777696135442980864])&#10;/&#10;SUM([gross_orders])' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_5354639245358112772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_mins_sum])&#10;/&#10;SUM([delivery_time_mins_count])' />
            </column>
            <column caption='% Early &gt; 15mins' datatype='real' name='[Calculation_5354639245358194693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_early_15_mins_count])&#10;/&#10;SUM([order_delay_mins_count])' />
            </column>
            <column caption='% Late &gt; 5mins' datatype='real' name='[Calculation_5354639245358325766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_5_mins_count])&#10;/&#10;SUM([order_delay_mins_count])' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_5354639245364867083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([gross_orders], 0)' />
            </column>
            <column caption='Orders Delivered' datatype='integer' name='[Calculation_5354639245364977676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_delivered]&#10;WHEN TRUE THEN [gross_orders]&#10;END' />
            </column>
            <column caption='Orders Cancelled' datatype='integer' name='[Calculation_5777696135442980864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_cancelled]&#10;WHEN TRUE THEN [gross_orders]&#10;END' />
            </column>
            <column caption='Gross Orders Today' datatype='integer' name='[Gross Orders Today (until previous hour) (copy)_3345400494063001603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;period = &apos;Today&apos;&#10;THEN [gross_orders] &#10;END' />
            </column>
            <column datatype='string' name='[account_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[business_type_apac]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[current_timestamp_local]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[delivery_time_mins_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_time_mins_sum]' role='measure' type='quantitative' />
            <column datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_cancelled]' role='dimension' type='nominal' />
