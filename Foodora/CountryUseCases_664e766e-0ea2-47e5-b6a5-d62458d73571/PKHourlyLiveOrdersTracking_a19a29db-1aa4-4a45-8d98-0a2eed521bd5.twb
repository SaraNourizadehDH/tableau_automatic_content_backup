      <aliases enabled='yes' />
      <column caption='% Early &gt; 15mins (Today)' datatype='real' name='[% Early &gt; 15mins (copy)_3234991946989305881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [orders_early_15_mins_count] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [order_delay_mins_count] END)' />
      </column>
      <column caption='% Late &gt; 5mins (Today)' datatype='real' name='[% Late &gt; 5mins (copy)_3234991946989596698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [orders_late_5_mins_count] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [order_delay_mins_count] END)' />
      </column>
      <column caption='% Orders on time (Today)' datatype='real' name='[% Orders on time (copy)_3234991946989723675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [orders_on_time_count] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [order_delay_mins_count] END)' />
      </column>
      <column caption='3H MA Avg DT Indicator' datatype='integer' name='[3H MA Fail Rate Indicator (copy)_4145141288098877441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[Avg DT (copy)_3234991946838888471]&gt;[Parameters].[Parameter 7] THEN 1 ELSE 0 END' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
