    <worksheet name='Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='28'>&lt;</run>
            <run fontalignment='1' fontsize='28'>[federated.0x2utov18re7qa1fw4r881fom6lz].[attr:order_placed_date_local:ok]</run>
            <run fontalignment='1' fontsize='28'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datastream_orders' name='federated.0x2utov18re7qa1fw4r881fom6lz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Fail Rate Threshold' datatype='real' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='0.2'>
              <calculation class='tableau' formula='0.2' />
            </column>
            <column caption='DT Threshold' datatype='real' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='45.'>
              <calculation class='tableau' formula='45.' />
            </column>
            <column caption='% Orders Dropped Threshold' datatype='real' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='-0.25'>
              <calculation class='tableau' formula='-0.25' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2utov18re7qa1fw4r881fom6lz'>
            <column caption='% Early &gt; 15mins (Today)' datatype='real' name='[% Early &gt; 15mins (copy)_3234991946989305881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [orders_early_15_mins_count] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [order_delay_mins_count] END)' />
            </column>
            <column caption='% Late &gt; 5mins (Today)' datatype='real' name='[% Late &gt; 5mins (copy)_3234991946989596698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [orders_late_5_mins_count] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [order_delay_mins_count] END)' />
            </column>
            <column caption='Avg Delay - Today' datatype='real' name='[Avg DT - Today (copy)_4447234290628927493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [order_delay_mins_sum] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [order_delay_mins_count] END)' />
            </column>
            <column caption='Redflag' datatype='integer' name='[Calculation_1098315385750503432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF(&#10;  (&#10;    [Calculation_553802043052085250] &lt; ([Parameters].[Parameter 8])&#10;    AND [Orders % Diff vs Same day LW (copy)_3234991946383167506] &lt; ([Parameters].[Parameter 8])&#10;  )&#10;  OR [Fail Rate (copy)_1098315385692958721] &gt; [Parameters].[Parameter 6]&#10;  OR [Calculation_4447234290617937921] &gt; [Parameters].[Parameter 7]&#10;) THEN 2&#10;ELSEIF(&#10;  [Calculation_553802043052085250] &lt; ([Parameters].[Parameter 8])&#10;  OR [Fail Rate (copy)_1098315385692958721] &gt; [Parameters].[Parameter 6]&#10;  OR [Calculation_4447234290617937921] &gt; [Parameters].[Parameter 7]&#10;) THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Placeholder' datatype='string' name='[Calculation_3345400494070026245]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Avg Delay&apos;' />
            </column>
            <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[current_timestamp_local])&#10;        OR &#10;        (DATEDIFF(&apos;hour&apos;, [current_timestamp_local], DATEADD(&apos;hour&apos;, 8, NOW()))&gt;=1 /*tableau server is utc time so need to +8*/&#10;        AND DATEPART(&apos;hour&apos;,[current_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Avg DT - Today' datatype='real' name='[Calculation_4447234290617937921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [delivery_time_mins_sum] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [delivery_time_mins_count] END)' />
            </column>
            <column caption='Orders Delivered - Today' datatype='integer' name='[Calculation_4447234290622337028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;is_today = TRUE &#10;AND [is_delivered]&#10;AND [Calculation_3345400494078595079]&#10;THEN [gross_orders] &#10;END' />
            </column>
            <column caption='Gross Orders Last Week (until previous hour)' datatype='integer' name='[Calculation_553802043050434560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Same day last week&apos; THEN [gross_orders] END' />
            </column>
            <column caption='Orders % Diff vs Same day LW' datatype='real' name='[Calculation_553802043052085250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([Last Week Delivered Orders (copy)_553802043050848257],0))-SUM([Calculation_553802043050434560]))&#10;/ &#10;SUM([Calculation_553802043050434560])' />
            </column>
            <column caption='Updated as at (Local Timestamp) ' datatype='string' name='[Calculation_5673128204151676930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([current_timestamp_local]),8)' />
            </column>
            <column caption='Orders Cancelled' datatype='integer' name='[Calculation_5777696135442980864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_cancelled]&#10;WHEN TRUE THEN [gross_orders]&#10;END' />
            </column>
            <column caption='Fail Rate - Today' datatype='real' name='[Fail Rate (copy)_1098315385692958721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [Calculation_5777696135442980864] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [gross_orders] END)' />
            </column>
            <column caption='Gross Orders Yesterday (until previous hour)' datatype='integer' name='[Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Yesterday&apos; THEN [gross_orders] END' />
            </column>
            <column caption='Gross Orders Today (until previous hour)' datatype='integer' name='[Last Week Delivered Orders (copy)_553802043050848257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Today&apos;&#10;&#10;THEN IFNULL([gross_orders],0)&#10;END' />
            </column>
            <column caption='Orders % Diff vs Yesterday' datatype='real' name='[Orders % Diff vs Same day LW (copy)_3234991946383167506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([Last Week Delivered Orders (copy)_553802043050848257],0))-SUM([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508]))&#10;/ &#10;SUM([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508])' />
            </column>
            <column datatype='string' name='[account_type]' role='dimension' type='nominal' />
            <column-instance column='[order_placed_date_local]' derivation='Attribute' name='[attr:order_placed_date_local:ok]' pivot='key' type='ordinal' />
