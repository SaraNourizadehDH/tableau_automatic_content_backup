      <column caption='3H MA Avg DT' datatype='real' name='[Avg DT (copy)_3234991946838888471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (SUM([Calculation_3234991946352541707]) &gt; [Calculation_1172343329695457280]) &#10;  THEN&#10;    SUM([delivery_time_3h_moving_average_sum])/ SUM([delivery_time_3h_moving_average_count])&#10;END' />
      </column>
      <column caption='Avg Delay - Today' datatype='real' name='[Avg DT - Today (copy)_4447234290628927493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [order_delay_mins_sum] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [order_delay_mins_count] END)' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_1023583820284235776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross Orders Today (until previous hour) (copy)_3345400494063001603])' />
      </column>
      <column caption='OD Orders Today' datatype='integer' name='[Calculation_1098315385699311622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_today] AND [Calculation_3345400494078595079] THEN [Calculation_5354639245364867083] END' />
      </column>
      <column caption='Redflag' datatype='integer' name='[Calculation_1098315385750503432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(&#10;  (&#10;    [Calculation_553802043052085250] &lt; ([Parameters].[Parameter 8])&#10;    AND [Orders % Diff vs Same day LW (copy)_3234991946383167506] &lt; ([Parameters].[Parameter 8])&#10;  )&#10;  OR [Fail Rate (copy)_1098315385692958721] &gt; [Parameters].[Parameter 6]&#10;  OR [Calculation_4447234290617937921] &gt; [Parameters].[Parameter 7]&#10;) THEN 2&#10;ELSEIF(&#10;  [Calculation_553802043052085250] &lt; ([Parameters].[Parameter 8])&#10;  OR [Fail Rate (copy)_1098315385692958721] &gt; [Parameters].[Parameter 6]&#10;  OR [Calculation_4447234290617937921] &gt; [Parameters].[Parameter 7]&#10;) THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='2% of yesterday&apos;s order' datatype='real' name='[Calculation_1172343329695457280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([yesterday_country_full_day_orders])/50' />
      </column>
      <column caption='region' datatype='string' name='[Calculation_1233493720295522304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if LOWER([lg_city_name]) in (&apos;bahawalpur&apos;, &apos;burewala&apos;, &apos;daska&apos;, &apos;dera ghazi khan&apos;, &apos;gujranwala&apos;, &apos;hafizabad&apos;, &apos;kasur&apos;, &apos;khanpur&apos;, &apos;kot addu&apos;, &apos;lahore&apos;, &apos;multan&apos;, &apos;muridke&apos;, &apos;okara&apos;, &apos;rahim yar khan&apos;, &apos;sadiqabad&apos;, &apos;sahiwal&apos;, &apos;sheikhupura&apos;, &apos;sialkot&apos;, &apos;khanewal&apos;) then &quot;Central&quot;&#10;elseif LOWER([lg_city_name]) in (&apos;abbottabad&apos;, &apos;attock&apos;, &apos;chakwal&apos;, &apos;chiniot&apos;, &apos;faisalabad&apos;, &apos;gujrat&apos;, &apos;haripur&apos;, &apos;islamabad&apos;, &apos;jaranwala&apos;, &apos;jhang&apos;, &apos;jhelum&apos;, &apos;mandi bahauddin&apos;, &apos;mardan&apos;, &apos;mirpur&apos;, &apos;murree&apos;, &apos;muzaffarabad&apos;, &apos;peshawar&apos;, &apos;sargodha&apos;, &apos;toba tek singh&apos;, &apos;wah&apos;, &apos;wah cantt&apos;, &apos;wazirabad&apos;) then &quot;North&quot;&#10;elseif LOWER([lg_city_name]) in (&apos;hyderabad&apos;, &apos;karachi&apos;, &apos;larkana&apos;, &apos;mirpur khas&apos;, &apos;nawabshah&apos;, &apos;quetta&apos;, &apos;sukkur&apos;) then &quot;South&quot;&#10;else &quot;Expansion&quot; end' />
      </column>
      <column caption='test' datatype='datetime' name='[Calculation_2314498391521595394]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEADD(&apos;hour&apos;, 8, NOW())' />
      </column>
      <column caption='All Orders' datatype='string' name='[Calculation_2646357430154063872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;All orders&quot;' />
      </column>
      <column caption='Hour Slots' datatype='string' name='[Calculation_2646357430196613121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [hour] &#10;    WHEN 0 THEN &quot;00:00 - 00:59&quot;&#10;    WHEN 1 THEN &quot;01:00 - 01:59&quot;&#10;    WHEN 2 THEN &quot;02:00 - 02:59&quot;&#10;    WHEN 3 THEN &quot;03:00 - 03:59&quot;&#10;    WHEN 4 THEN &quot;04:00 - 04:59&quot;&#10;    WHEN 5 THEN &quot;05:00 - 05:59&quot;&#10;    WHEN 6 THEN &quot;06:00 - 06:59&quot;&#10;    WHEN 7 THEN &quot;07:00 - 07:59&quot;&#10;    WHEN 8 THEN &quot;08:00 - 08:59&quot;&#10;    WHEN 9 THEN &quot;09:00 - 09:59&quot;&#10;    WHEN 10 THEN &quot;10:00 - 10:59&quot;&#10;    WHEN 11 THEN &quot;11:00 - 11:59&quot;&#10;    WHEN 12 THEN &quot;12:00 - 12:59&quot;&#10;    WHEN 13 THEN &quot;13:00 - 13:59&quot;&#10;    WHEN 14 THEN &quot;14:00 - 14:59&quot;&#10;    WHEN 15 THEN &quot;15:00 - 15:59&quot;&#10;    WHEN 16 THEN &quot;16:00 - 16:59&quot;&#10;    WHEN 17 THEN &quot;17:00 - 17:59&quot;&#10;    WHEN 18 THEN &quot;18:00 - 18:59&quot;&#10;    WHEN 19 THEN &quot;19:00 - 19:59&quot;&#10;    WHEN 20 THEN &quot;20:00 - 20:59&quot;&#10;    WHEN 21 THEN &quot;21:00 - 21:59&quot;&#10;    WHEN 22 THEN &quot;22:00 - 22:59&quot;&#10;    WHEN 23 THEN &quot;23:00 - 23:59&quot;&#10;END' />
      </column>
      <column caption='Moving Average Label' datatype='string' name='[Calculation_3234991946325344260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF is_today = TRUE &#10;THEN &apos;3H MA&apos;&#10;END' />
      </column>
      <column caption='Orders 3H Moving Average' datatype='real' name='[Calculation_3234991946340216841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_orders_3h_moving_average_sum])&#10;/&#10;3' />
      </column>
      <column caption='Gross Orders 3h MA' datatype='real' name='[Calculation_3234991946352541707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3234991946388582419] THEN [gross_orders_3h_moving_average_sum]/3 END' />
      </column>
      <column caption='Orders 3hr MA % Diff vs LW and Yesterday' datatype='integer' name='[Calculation_3234991946368946193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[Orders % Diff vs Same day LW (copy)_3234991946327982085] &lt; ([Parameters].[Parameter 8]) &#10;AND [Orders 3hr MA % Diff vs Same day LW (copy)_3234991946366889999] &lt; ([Parameters].[Parameter 8])&#10;AND [Calculation_3234991946340216841] &gt; [Calculation_1172343329695457280]&#10;THEN 1&#10;END&#10;&#10;/*&#10;([Orders 3hr MA % Diff vs Same day LW] + [Orders 3hr MA % Diff vs Yesterday])/2&#10;*/' />
      </column>
      <column caption='is_above_2am' datatype='boolean' name='[Calculation_3234991946388582419]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hour] &gt;=2 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='3H MA Orders Cancelled' datatype='integer' name='[Calculation_3234991946724876309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_cancelled]&#10;WHEN TRUE THEN [gross_orders_3h_moving_average_sum]&#10;END' />
      </column>
      <column caption='Updated as at  (Local Timestamp) Max' datatype='datetime' name='[Calculation_3234991946998763551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Calculation_6110681032948973569])' />
      </column>
      <column caption='Bar Chart Breakdown ' datatype='string' name='[Calculation_3345400494058725378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Country&apos; THEN [global_entity_id]&#10;WHEN &apos;Business Type&apos; THEN [business_type_apac]&#10;END' />
      </column>
      <column caption='Placeholder' datatype='string' name='[Calculation_3345400494070026245]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Avg Delay&apos;' />
      </column>
      <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[current_timestamp_local])&#10;        OR &#10;        (DATEDIFF(&apos;hour&apos;, [current_timestamp_local], DATEADD(&apos;hour&apos;, 8, NOW()))&gt;=1 /*tableau server is utc time so need to +8*/&#10;        AND DATEPART(&apos;hour&apos;,[current_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='3H MA Fail Rate Indicator' datatype='integer' name='[Calculation_4145141288098160640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[Fail Rate (copy)_3234991946836541462]&gt;[Parameters].[Parameter 6] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Avg DT - Today' datatype='real' name='[Calculation_4447234290617937921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_today] = TRUE THEN [delivery_time_mins_sum] END)&#10;/&#10;SUM(IF [is_today] = TRUE THEN [delivery_time_mins_count] END)' />
      </column>
      <column caption='Avg DT - Today Indicator' datatype='string' name='[Calculation_4447234290619834370]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4447234290617937921] &gt; 45 THEN &apos;&gt;45&apos; &#10;ELSEIF [Calculation_4447234290617937921] &gt; 35 THEN &apos;35-45&apos;&#10;ELSE &apos;&lt;35&apos;&#10;END' />
      </column>
      <column caption='Orders Delivered - Today' datatype='integer' name='[Calculation_4447234290622337028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;is_today = TRUE &#10;AND [is_delivered]&#10;AND [Calculation_3345400494078595079]&#10;THEN [gross_orders] &#10;END' />
      </column>
      <column caption='Selected Period' datatype='string' name='[Calculation_4447234290635542534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Yes&apos; THEN STR([hour])&#10;ELSE &apos;Today&apos;&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_4447234290637701128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;Orders % Change vs LW&apos; THEN [Calculation_553802043052085250]&#10;WHEN &apos;Fail Rate&apos; THEN [Fail Rate (copy)_1098315385692958721]&#10;WHEN &apos;Avg DT&apos; THEN [Calculation_4447234290617937921]&#10;WHEN &apos;Avg Delay&apos; THEN [Avg DT - Today (copy)_4447234290628927493]&#10;END' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_5354639245356118019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5777696135442980864])&#10;/&#10;SUM([gross_orders])' />
      </column>
      <column caption='Avg DT' datatype='real' name='[Calculation_5354639245358112772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_mins_sum])&#10;/&#10;SUM([delivery_time_mins_count])' />
      </column>
      <column caption='% Early &gt; 15mins' datatype='real' name='[Calculation_5354639245358194693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_early_15_mins_count])&#10;/&#10;SUM([order_delay_mins_count])' />
      </column>
      <column caption='% Late &gt; 5mins' datatype='real' name='[Calculation_5354639245358325766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_late_5_mins_count])&#10;/&#10;SUM([order_delay_mins_count])' />
      </column>
      <column caption='% Orders on time' datatype='real' name='[Calculation_5354639245358415879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_on_time_count])&#10;/&#10;SUM([order_delay_mins_count])' />
      </column>
      <column caption='Avg Delay Mins' datatype='real' name='[Calculation_5354639245359755272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_delay_mins_sum])&#10;/&#10;SUM([order_delay_mins_count])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_5354639245364867083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([gross_orders], 0)' />
      </column>
      <column caption='Orders Delivered' datatype='integer' name='[Calculation_5354639245364977676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_delivered]&#10;WHEN TRUE THEN [gross_orders]&#10;END' />
      </column>
      <column caption='Last order as at (Local Timestamp)' datatype='string' name='[Calculation_5354639245369118733]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([current_timestamp_local]),8)' />
      </column>
      <column caption='Period (Local)' datatype='string' name='[Calculation_5354639245382676495]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Yes&apos; THEN STR([hour])&#10;WHEN &apos;No&apos; THEN &apos;As of &apos; + [Calculation_5673128204151676930]&#10;END' />
      </column>
      <column caption='Parameter' datatype='string' name='[Calculation_5354639245385130000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;None&apos; THEN NULL&#10;WHEN &apos;Zone&apos; THEN [lg_zone_name]&#10;WHEN &apos;Business Type&apos; THEN [business_type_apac]&#10;END' />
      </column>
      <column caption='Gross Orders Last Week (until previous hour)' datatype='integer' name='[Calculation_553802043050434560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Same day last week&apos; THEN [gross_orders] END' />
      </column>
      <column caption='Orders % Diff vs Same day LW' datatype='real' name='[Calculation_553802043052085250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([Last Week Delivered Orders (copy)_553802043050848257],0))-SUM([Calculation_553802043050434560]))&#10;/ &#10;SUM([Calculation_553802043050434560])' />
      </column>
      <column caption='WoW Orders Differences indicator' datatype='integer' name='[Calculation_553802043055484934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_553802043052085250] &gt; 0 THEN 1 &#10;ELSEIF [Calculation_553802043052085250] &lt; 0 THEN -1&#10;ELSEIF [Calculation_553802043052085250] = 0 THEN 0&#10;END' />
      </column>
      <column caption='Today vs last week' datatype='string' name='[Calculation_553802043059306503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_today]&#10;WHEN TRUE THEN &apos;Today&apos;&#10;WHEN FALSE THEN &apos;Same day last week&apos;&#10;END' />
