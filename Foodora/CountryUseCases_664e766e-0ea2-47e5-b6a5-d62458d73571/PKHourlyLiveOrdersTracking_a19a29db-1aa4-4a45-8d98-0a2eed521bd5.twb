    <worksheet name='Orders % Change (3 Hours Moving Average)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datastream_orders' name='federated.0x2utov18re7qa1fw4r881fom6lz' />
            <datasource caption='Distinct Riders' name='federated.0dls45n02hmxpq185mtsl04rx1e8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='% Orders Dropped Threshold' datatype='real' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='-0.25'>
              <calculation class='tableau' formula='-0.25' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dls45n02hmxpq185mtsl04rx1e8'>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2utov18re7qa1fw4r881fom6lz'>
            <column caption='2% of yesterday&apos;s order' datatype='real' name='[Calculation_1172343329695457280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([yesterday_country_full_day_orders])/50' />
            </column>
            <column caption='Orders 3H Moving Average' datatype='real' name='[Calculation_3234991946340216841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gross_orders_3h_moving_average_sum])&#10;/&#10;3' />
            </column>
            <column caption='Gross Orders 3h MA' datatype='real' name='[Calculation_3234991946352541707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3234991946388582419] THEN [gross_orders_3h_moving_average_sum]/3 END' />
            </column>
            <column caption='Orders 3hr MA % Diff vs LW and Yesterday' datatype='integer' name='[Calculation_3234991946368946193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Orders % Diff vs Same day LW (copy)_3234991946327982085] &lt; ([Parameters].[Parameter 8]) &#10;AND [Orders 3hr MA % Diff vs Same day LW (copy)_3234991946366889999] &lt; ([Parameters].[Parameter 8])&#10;AND [Calculation_3234991946340216841] &gt; [Calculation_1172343329695457280]&#10;THEN 1&#10;END&#10;&#10;/*&#10;([Orders 3hr MA % Diff vs Same day LW] + [Orders 3hr MA % Diff vs Yesterday])/2&#10;*/' />
            </column>
            <column caption='is_above_2am' datatype='boolean' name='[Calculation_3234991946388582419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour] &gt;=2 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[current_timestamp_local])&#10;        OR &#10;        (DATEDIFF(&apos;hour&apos;, [current_timestamp_local], DATEADD(&apos;hour&apos;, 8, NOW()))&gt;=1 /*tableau server is utc time so need to +8*/&#10;        AND DATEPART(&apos;hour&apos;,[current_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Gross Orders Last Week (until previous hour)' datatype='integer' name='[Calculation_553802043050434560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Same day last week&apos; THEN [gross_orders] END' />
            </column>
            <column caption='Orders % Diff vs Same day LW' datatype='real' name='[Calculation_553802043052085250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([Last Week Delivered Orders (copy)_553802043050848257],0))-SUM([Calculation_553802043050434560]))&#10;/ &#10;SUM([Calculation_553802043050434560])' />
            </column>
            <column caption='Gross Orders Yesterday (until previous hour)' datatype='integer' name='[Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Yesterday&apos; THEN [gross_orders] END' />
            </column>
            <column caption='Gross Orders 3h MA Yesterday (until previous hour)' datatype='real' name='[Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946367086608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Yesterday&apos; THEN [Calculation_3234991946352541707] END' />
            </column>
            <column caption='Gross Orders 3h MA Last Week (until previous hour)' datatype='real' name='[Gross Orders Last Week (until previous hour) (copy)_3234991946328174599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Same day last week&apos; THEN [Calculation_3234991946352541707] END' />
            </column>
            <column caption='Gross Orders 3h MA Today (until previous hour)' datatype='real' name='[Gross Orders Today (until previous hour) (copy)_3234991946282512384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Today&apos;&#10;&#10;THEN [Calculation_3234991946352541707] &#10;END' />
            </column>
            <column caption='Gross Orders Today (until previous hour)' datatype='integer' name='[Last Week Delivered Orders (copy)_553802043050848257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Today&apos;&#10;&#10;THEN IFNULL([gross_orders],0)&#10;END' />
            </column>
            <column caption='Orders 3hr MA % Diff vs Same day LW' datatype='real' name='[Orders % Diff vs Same day LW (copy)_3234991946327982085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([Gross Orders Today (until previous hour) (copy)_3234991946282512384]))-SUM(ZN([Gross Orders Last Week (until previous hour) (copy)_3234991946328174599])))&#10;/ &#10;SUM(ZN([Gross Orders Last Week (until previous hour) (copy)_3234991946328174599]))' />
            </column>
            <column caption='Orders % Diff vs Yesterday' datatype='real' name='[Orders % Diff vs Same day LW (copy)_3234991946383167506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([Last Week Delivered Orders (copy)_553802043050848257],0))-SUM([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508]))&#10;/ &#10;SUM([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946358890508])' />
            </column>
            <column caption='Orders 3hr MA % Diff vs Yesterday' datatype='real' name='[Orders 3hr MA % Diff vs Same day LW (copy)_3234991946366889999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([Gross Orders Today (until previous hour) (copy)_3234991946282512384]))-SUM(ZN([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946367086608])))&#10;/ &#10;SUM(ZN([Gross Orders 3h MA Last Week (until previous hour) (copy)_3234991946367086608]))' />
