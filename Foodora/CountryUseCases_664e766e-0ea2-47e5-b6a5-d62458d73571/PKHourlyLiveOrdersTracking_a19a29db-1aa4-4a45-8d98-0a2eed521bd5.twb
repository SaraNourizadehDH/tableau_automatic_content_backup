      </column>
      <column caption='Order status' datatype='string' name='[Calculation_5777696135447105538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_cancelled] = TRUE THEN &apos;Cancelled&apos;&#10;ELSEIF [is_delivered] = TRUE THEN &apos;Delivered&apos;&#10;ELSE &apos;In progress&apos;&#10;END&#10;&#10;/*more detailed breakdown*/&#10;/*&#10;IF [is_cancelled] = TRUE AND [is_delivered] = TRUE THEN &apos;Cancelled after delivery&apos;&#10;ELSEIF [is_cancelled] = TRUE AND [is_delivered] = FALSE THEN &apos;Cancelled before delivery&apos;&#10;ELSEIF  [is_cancelled] = FALSE AND [is_delivered] = FALSE THEN &apos;In progress&apos;&#10;ELSE &apos;Delivered&apos;&#10;END&#10;*/' />
      </column>
      <column caption='Dummy Axis' datatype='integer' name='[Calculation_5777696135456727043]' role='measure' type='quantitative'>
