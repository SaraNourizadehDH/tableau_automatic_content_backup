    <worksheet name='Delivery Time (3 Hour Moving Average)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datastream_orders' name='federated.0x2utov18re7qa1fw4r881fom6lz' />
            <datasource caption='Distinct Riders' name='federated.0dls45n02hmxpq185mtsl04rx1e8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='DT Threshold' datatype='real' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='45.'>
              <calculation class='tableau' formula='45.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dls45n02hmxpq185mtsl04rx1e8'>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0x2utov18re7qa1fw4r881fom6lz'>
            <column caption='3H MA Avg DT Indicator' datatype='integer' name='[3H MA Fail Rate Indicator (copy)_4145141288098877441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[Avg DT (copy)_3234991946838888471]&gt;[Parameters].[Parameter 7] THEN 1 ELSE 0 END' />
            </column>
            <column caption='3H MA Avg DT' datatype='real' name='[Avg DT (copy)_3234991946838888471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([Calculation_3234991946352541707]) &gt; [Calculation_1172343329695457280]) &#10;  THEN&#10;    SUM([delivery_time_3h_moving_average_sum])/ SUM([delivery_time_3h_moving_average_count])&#10;END' />
            </column>
            <column caption='2% of yesterday&apos;s order' datatype='real' name='[Calculation_1172343329695457280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([yesterday_country_full_day_orders])/50' />
            </column>
            <column caption='Gross Orders 3h MA' datatype='real' name='[Calculation_3234991946352541707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3234991946388582419] THEN [gross_orders_3h_moving_average_sum]/3 END' />
            </column>
            <column caption='is_above_2am' datatype='boolean' name='[Calculation_3234991946388582419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour] &gt;=2 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='is_up_to_previous_hour' datatype='boolean' name='[Calculation_3345400494078595079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;        [hour] &lt; DATEPART(&apos;hour&apos;,[current_timestamp_local])&#10;        OR &#10;        (DATEDIFF(&apos;hour&apos;, [current_timestamp_local], DATEADD(&apos;hour&apos;, 8, NOW()))&gt;=1 /*tableau server is utc time so need to +8*/&#10;        AND DATEPART(&apos;hour&apos;,[current_timestamp_local]) = 23)&#10;    ) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_5354639245358112772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_mins_sum])&#10;/&#10;SUM([delivery_time_mins_count])' />
            </column>
            <column caption='Gross Orders Last Week (until previous hour)' datatype='integer' name='[Calculation_553802043050434560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#10;IF [hour] &lt; DATEPART(&apos;hour&apos;,latest_order_timestamp_local) AND &#10;is_today = FALSE THEN [gross_orders] END&#10;*/&#10;&#10;IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Same day last week&apos; THEN [gross_orders] END' />
            </column>
            <column caption='Gross Orders Today (until previous hour)' datatype='integer' name='[Last Week Delivered Orders (copy)_553802043050848257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3345400494078595079] = TRUE AND period = &apos;Today&apos;&#10;&#10;THEN IFNULL([gross_orders],0)&#10;END' />
            </column>
            <column datatype='string' name='[business_type_apac]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[current_timestamp_local]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[delivery_time_3h_moving_average_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_time_3h_moving_average_sum]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_time_mins_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_time_mins_sum]' role='measure' type='quantitative' />
            <column datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[gross_orders_3h_moving_average_sum]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column datatype='string' name='[lg_city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[lg_zone_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3345400494078595079]' derivation='None' name='[none:Calculation_3345400494078595079:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_type_apac]' derivation='None' name='[none:business_type_apac:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[hour]' derivation='None' name='[none:hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[lg_city_name]' derivation='None' name='[none:lg_city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[lg_zone_name]' derivation='None' name='[none:lg_zone_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_placed_date_local]' derivation='None' name='[none:order_placed_date_local:ok]' pivot='key' type='ordinal' />
            <column datatype='date' default-format='L' name='[order_placed_date_local]' role='dimension' type='ordinal' />
            <column caption='Time Period' datatype='string' name='[period]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Same day last week&quot;' value='Last Week' />
              </aliases>
            </column>
            <column-instance column='[Calculation_553802043050434560]' derivation='Sum' name='[sum:Calculation_553802043050434560:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Last Week Delivered Orders (copy)_553802043050848257]' derivation='Sum' name='[sum:Last Week Delivered Orders (copy)_553802043050848257:qk]' pivot='key' type='quantitative' />
            <column-instance column='[3H MA Fail Rate Indicator (copy)_4145141288098877441]' derivation='User' name='[usr:3H MA Fail Rate Indicator (copy)_4145141288098877441:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Avg DT (copy)_3234991946838888471]' derivation='User' name='[usr:Avg DT (copy)_3234991946838888471:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5354639245358112772]' derivation='User' name='[usr:Calculation_5354639245358112772:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[yesterday_country_full_day_orders]' role='measure' type='quantitative' />
          </datasource-dependencies>
