SELECT
  hourly_riders.global_entity_id,
  hourly_riders.lg_city_name,
  hourly_riders.delivered_date_local,
  IF(hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters), TRUE, FALSE) is_today,
  CASE 
    WHEN hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters) THEN 'Today'
