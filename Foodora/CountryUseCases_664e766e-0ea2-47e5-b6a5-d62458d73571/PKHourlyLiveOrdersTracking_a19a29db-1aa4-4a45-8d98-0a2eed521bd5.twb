        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1mozhyi0wcbl6j15kk2gk1jz2non' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
  SELECT
    DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)) AS current_date_local,  --tableau extract refresh at 12am PK time
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 1 DAY) AS date_minus_1_local,
    DATE_SUB(DATE(DATETIME_SUB(CURRENT_DATETIME("Asia/Karachi"), INTERVAL 10 MINUTE)), INTERVAL 7 DAY) AS date_minus_7_local
),

lg_countries AS (
  SELECT
    "FP_PK" AS global_entity_id,
    (SELECT timezone FROM UNNEST(cities) LIMIT 1) AS timezone
  FROM `fulfillment-dwh-production.curated_data_shared.countries`
  WHERE country_iso = "PK"
  GROUP BY global_entity_id, timezone --remove duplicates for countries with more than 1 logistics country code
),

regional_apac_pd_vendors_agg_lg_zones AS (
  SELECT 
    global_entity_id,
    vendor_code,
    lg_zones.lg_city_name,
    lg_zones.lg_zone_name
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_lg_zones`
  LEFT JOIN UNNEST(lg_zones) AS lg_zones
  WHERE lg_zones.is_closest_point
),

active_riders AS (
  SELECT 
    content.global_entity_id,
    regional_apac_pd_vendors_agg_lg_zones.lg_city_name,
    DATE(order_status_stream.timestamp, lg_countries.timezone) AS delivered_date_local,
    DATETIME(order_status_stream.timestamp, lg_countries.timezone) AS delivered_at_local,
    EXTRACT(HOUR FROM DATETIME(order_status_stream.timestamp, lg_countries.timezone)) AS delivered_hour,
    MAX(DATETIME(order_status_stream.timestamp, lg_countries.timezone)) OVER (
      PARTITION BY
        content.global_entity_id
    ) AS latest_delivery_timestamp_local,
    DATE_TRUNC(DATETIME(CURRENT_TIMESTAMP, lg_countries.timezone), SECOND) AS current_timestamp_local,
    content.courier.courier_id
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.order_status_stream` AS order_status_stream
  LEFT JOIN lg_countries
         ON order_status_stream.content.global_entity_id = lg_countries.global_entity_id
  LEFT JOIN regional_apac_pd_vendors_agg_lg_zones
         ON order_status_stream.global_entity_id = regional_apac_pd_vendors_agg_lg_zones.global_entity_id
        AND order_status_stream.content.vendor.id = regional_apac_pd_vendors_agg_lg_zones.vendor_code
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
          ON order_status_stream.global_entity_id = shared_countries.global_entity_id
  WHERE shared_countries.region = "Asia"
    AND shared_countries.company_name = "Foodpanda"
    AND created_date >>= DATE_SUB((SELECT date_minus_7_local FROM parameters), INTERVAL 1 DAY)
    AND DATE(order_status_stream.timestamp, lg_countries.timezone) IN (
      (SELECT current_date_local FROM parameters),
      (SELECT date_minus_1_local FROM parameters),
      (SELECT date_minus_7_local FROM parameters)
    )
    AND content.courier.courier_id IS NOT NULL
    AND content.status = "DELIVERED"  
),

city_daily_riders AS (
  SELECT
    global_entity_id,
    lg_city_name,
    delivered_date_local,
    COUNT(DISTINCT courier_id) AS city_daily_active_riders
  FROM active_riders
  WHERE delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local)
    AND lg_city_name IS NOT NULL --pgo orders will not have city name, removing at this stage so as not to double count when aggregating to country active riders in the dashboard (rider who did pgo orders most likely have done platform order as well)  
GROUP BY 1,2,3
),

country_daily_riders AS (
  /* --use city_daily_riders instead to align on numbers in tableau dashboards
  SELECT
    global_entity_id,
    delivered_date_local,
    COUNT(DISTINCT courier_id) AS country_daily_active_riders
  FROM active_riders
  WHERE delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local)
    AND lg_city_name IS NOT NULL  
  GROUP BY 1,2
  */
  SELECT
    global_entity_id,
    delivered_date_local,
    SUM(city_daily_active_riders) AS country_daily_active_riders
  FROM city_daily_riders
  GROUP BY 1,2
),

hourly_riders AS (
  SELECT
    global_entity_id,
    lg_city_name,
    delivered_date_local,
    delivered_hour,
    latest_delivery_timestamp_local,
    current_timestamp_local,
    COUNT(DISTINCT courier_id) AS hourly_active_riders
  FROM active_riders
  WHERE lg_city_name IS NOT NULL --pgo orders will not have city name, removing at this stage so as not to double count when aggregating to country active riders in the dashboard (rider who did pgo orders most likely have done platform order as well)
  GROUP BY 1,2,3,4,5,6
)

SELECT
  hourly_riders.global_entity_id,
  hourly_riders.lg_city_name,
  hourly_riders.delivered_date_local,
  IF(hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters), TRUE, FALSE) is_today,
  CASE 
    WHEN hourly_riders.delivered_date_local = (SELECT current_date_local FROM parameters) THEN 'Today'
    WHEN hourly_riders.delivered_date_local = (SELECT date_minus_1_local FROM parameters) THEN 'Yesterday'
    WHEN hourly_riders.delivered_date_local = (SELECT date_minus_7_local FROM parameters) THEN 'Same day last week'
  END AS day_category,
  IF(delivered_hour << EXTRACT(HOUR FROM current_timestamp_local), TRUE, FALSE) AS is_up_to_previous_hour,
  hourly_riders.delivered_hour,
  hourly_riders.latest_delivery_timestamp_local,
  hourly_riders.hourly_active_riders,
  IF(delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local), city_daily_riders.city_daily_active_riders, NULL) AS city_daily_active_riders,
  IF(delivered_hour << EXTRACT(HOUR FROM latest_delivery_timestamp_local), country_daily_riders.country_daily_active_riders, NULL) AS country_daily_active_riders
FROM hourly_riders
LEFT JOIN city_daily_riders
       ON hourly_riders.global_entity_id = city_daily_riders.global_entity_id
      AND hourly_riders.lg_city_name = city_daily_riders.lg_city_name
      AND hourly_riders.delivered_date_local = city_daily_riders.delivered_date_local
LEFT JOIN country_daily_riders
       ON hourly_riders.global_entity_id = country_daily_riders.global_entity_id
      AND hourly_riders.delivered_date_local = country_daily_riders.delivered_date_local
--WHERE hourly_riders.global_entity_id = 'FP_LA'
ORDER BY 1,2,3,4 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1mozhyi0wcbl6j15kk2gk1jz2non' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
