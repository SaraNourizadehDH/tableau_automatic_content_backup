          <named-connection caption='BigQuery' name='bigquery.1mozhyi0wcbl6j15kk2gk1jz2non'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='foodpanda-pk-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_commercial' server-oauth='' username='ali.asgher@foodpanda.pk' workgroup-auth-mode='prompt' />
          </named-connection>
