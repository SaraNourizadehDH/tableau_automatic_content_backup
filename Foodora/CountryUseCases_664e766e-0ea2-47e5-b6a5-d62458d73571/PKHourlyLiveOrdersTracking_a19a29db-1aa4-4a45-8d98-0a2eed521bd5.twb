            <run>Æ&#10;</run>
            <run fontcolor='#e02978' fontsize='8'>* the latest hour for Today might not be fully updated</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='datastream_orders' name='federated.0x2utov18re7qa1fw4r881fom6lz' />
