    <worksheet name='VFD/GMV total'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_funded_deals (report_tables)' name='federated.0tnblfh00z7f5410w4iqv0tmh22d' />
          </datasources>
          <datasource-dependencies datasource='federated.0tnblfh00z7f5410w4iqv0tmh22d'>
            <column caption=' - Always On (Non-Eligible)' datatype='real' name='[ - Always On (Eligible) (copy)_1250874847720587271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_non_eligible_alwayson])/SUM([gmv_user_paid])' />
            </column>
            <column caption=' - MP Free Delivery' datatype='real' name='[ - DPS Free Delivery (copy)_1047649924126531586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mp_free_delivery])/SUM([gmv_user_paid])' />
            </column>
            <column caption=' - Other Vouchers' datatype='real' name='[ - Disco (copy) (copy)_1250874847721148427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_other_voucher])/SUM([gmv_user_paid])' />
            </column>
            <column caption=' - Pro' datatype='real' name='[ - Disco (copy)_1250874847720280069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_pro])/SUM([gmv_user_paid])' />
            </column>
            <column caption=' - Other Deals' datatype='real' name='[ - Disco (copy)_1250874847721136138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_other_deals])/SUM([gmv_user_paid])' />
            </column>
            <column caption=' - DPS Free Delivery' datatype='real' name='[ - Joker (copy)_1047649924126314496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_free_delivery])/SUM([gmv_user_paid])' />
