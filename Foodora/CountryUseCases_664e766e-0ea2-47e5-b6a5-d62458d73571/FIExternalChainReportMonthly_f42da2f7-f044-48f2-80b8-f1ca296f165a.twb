                <zone forceUpdate='true' h='44875' id='368' type-v2='text' w='59800' x='23600' y='54250'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' underline='true'>Instructions:</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>1. Select Country</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='8'>2. Write chain name</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='8'>3. Select month. Last two months are applicable.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='8'>4. Download as PDF</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#7f7f7f' fontsize='8'>     a. Include: specific SHEETS from this WORKBOOK</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#7f7f7f' fontsize='8'>     b. &quot;Select All&quot; and EXCLUDE &quot;Control Panel&quot;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#7f7f7f' fontsize='8'>     c. Set scaling to &quot;At most 1 page wide&quot;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#7f7f7f' fontsize='8'>     d. Keep Paper Size as &quot;Letter&quot; and Orientation &quot;Portrait&quot;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
