            <column caption='Metric F' datatype='string' name='[Metric (copy)_3454542417463324672]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;# Successful Orders&quot; THEN STR(ROUND(SUM([succcessful_orders]),0)) &#13;&#10;WHEN &quot;GMV (LC)&quot; THEN STR(ROUND(SUM([Calculation_1758655669804445710]),0)) &#13;&#10;WHEN &quot;AOV (LC)&quot; THEN STR(ROUND([Calculation_1758655669806825501],2)) &#13;&#10;WHEN &quot;Service Fee (LC)&quot; THEN STR(ROUND(SUM([Calculation_1758655669806452763]),0)) &#13;&#10;WHEN &quot;% Order Late &gt; 10 Mins&quot; THEN STR(ROUND([Calculation_1758655669807689763]*100,1))+&quot;%&quot;&#13;&#10;WHEN &quot;% Order Late &gt; 15 Mins&quot; THEN STR(ROUND([% Order Late &gt; 10 Mins (copy)_1758655669807816740]*100,1))+&quot;%&quot;&#13;&#10;END' />
