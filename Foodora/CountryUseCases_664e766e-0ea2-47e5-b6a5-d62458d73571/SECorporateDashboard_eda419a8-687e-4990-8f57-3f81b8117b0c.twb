    <dashboard name='Dashboard - Detailed'>
      <repository-location id='Dashboard-Detailed' path='/t/Foodora/workbooks/SECorporateDashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='1000' maxwidth='1440' minheight='1000' minwidth='1440' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='report_corporate_dashboard (bl_nordics)' name='federated.0i1a2wk1ggkxm615p0i3m0uh9hnu' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Para' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
          </members>
        </column>
        <column caption='Select Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Company Name&quot;'>
          <calculation class='tableau' formula='&quot;Company Name&quot;' />
          <members>
            <member value='&quot;Company Name&quot;' />
            <member value='&quot;Account Owner&quot;' />
          </members>
        </column>
        <column caption='Metric Para' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV (LC)&quot;'>
          <calculation class='tableau' formula='&quot;GMV (LC)&quot;' />
          <members>
            <member value='&quot;\# Successful Orders&quot;' />
            <member value='&quot;GMV (LC)&quot;' />
            <member value='&quot;AOV (LC)&quot;' />
            <member value='&quot;Service Fee (LC)&quot;' />
            <member value='&quot;\% Order Late &gt; 10 Mins&quot;' />
            <member value='&quot;\% Order Late &gt; 15 Mins&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0i1a2wk1ggkxm615p0i3m0uh9hnu'>
        <column caption='Date' datatype='string' name='[Calculation_1758655669800689665]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Daily&quot; THEN STR([report_date_dash])&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week_dash]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month_dash]),7)&#13;&#10;END' />
        </column>
