    <worksheet name='Dashboard Prep'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_corporate_dashboard (bl_nordics)' name='federated.0i1a2wk1ggkxm615p0i3m0uh9hnu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Para' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0i1a2wk1ggkxm615p0i3m0uh9hnu'>
            <column caption='% Delivery &gt; 60 Mins' datatype='real' name='[% Delivery &gt; 45 Mins (copy)_1758655669807517730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_60])/SUM([delivery_time_den])' />
            </column>
            <column caption='% Order Late &gt; 15 Mins' datatype='real' name='[% Order Late &gt; 10 Mins (copy)_1758655669807816740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delay_15])/SUM([delay_den])' />
            </column>
            <column caption='% Preorders (Non-same Day)' datatype='real' name='[% Preorders (Same Day) (copy)_1758655669803859980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_preorder_nsd])/SUM([succcessful_orders])' />
            </column>
            <column caption='% ASAP Orders' datatype='real' name='[% Preorders (Same Day) (copy)_1758655669804097549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_asap])/SUM([succcessful_orders])' />
            </column>
            <column caption='AFV (LC)' datatype='real' name='[AOV (copy)_1758655669806923806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_product_amount_local])/SUM([succcessful_orders])' />
            </column>
            <column caption='Avg. Promised Delivery Time' datatype='real' name='[Avg. Delivery Time (copy)_1758655669807194144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_delivery_time]/60)/SUM([promised_delivery_time_den])' />
            </column>
            <column caption='# Successful Orders' datatype='integer' name='[Calculation_1758655669800603648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[succcessful_orders]' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1758655669800689665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Daily&quot; THEN STR([report_date_dash])&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week_dash]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month_dash]),7)&#13;&#10;END' />
            </column>
            <column caption='# Users Ordered' datatype='integer' name='[Calculation_1758655669801594884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_entity_id]+STR([cp_user_id]))' />
            </column>
            <column caption='# Companies Ordered' datatype='integer' name='[Calculation_1758655669801930757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_entity_id]+STR([cp_company_id]))' />
            </column>
            <column caption='Avg. User Count' datatype='real' name='[Calculation_1758655669802229766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_users])/SUM([succcessful_orders])' />
            </column>
            <column caption='% Group Orders' datatype='real' name='[Calculation_1758655669802483719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_group])/SUM([succcessful_orders])' />
            </column>
            <column caption='% Non-Allowance Orders' datatype='real' name='[Calculation_1758655669803036680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_non_allowance])/SUM([succcessful_orders])' />
            </column>
            <column caption='% Preorders' datatype='real' name='[Calculation_1758655669803323402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_preorder])/SUM([succcessful_orders])' />
            </column>
            <column caption='% Preorders (Same Day)' datatype='real' name='[Calculation_1758655669803569163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_preorder_sd])/SUM([succcessful_orders])' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_1758655669804445710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_local]' />
            </column>
            <column caption='Group Orders GMV (LC)' datatype='real' name='[Calculation_1758655669804572687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_local_group]' />
            </column>
            <column caption='Non-Allowance GMV (LC)' datatype='real' name='[Calculation_1758655669804670992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_local_non_allowance]' />
            </column>
            <column caption='GFV (LC)' datatype='real' name='[Calculation_1758655669805293587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_product_amount_local]' />
            </column>
            <column caption='Vendor Commission (LC)' datatype='real' name='[Calculation_1758655669805916183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vendor_commission]' />
            </column>
            <column caption='Delivery Fee (LC)' datatype='real' name='[Calculation_1758655669806006296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[delivery_fee_local]' />
            </column>
            <column caption='Delivery Fee Net (LC)' datatype='real' name='[Calculation_1758655669806145561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[delivery_fee_net_local]' />
            </column>
            <column caption='Surchage Net (LC)' datatype='real' name='[Calculation_1758655669806211098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[surcharge_net_local]' />
            </column>
            <column caption='Corporate Service Fee (LC)' datatype='real' name='[Calculation_1758655669806452763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[corporate_service_fee]' />
            </column>
            <column caption='Revenue (LC)' datatype='real' name='[Calculation_1758655669806555164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_1758655669805916183],0)&#13;&#10;+IFNULL([Calculation_1758655669806145561],0)&#13;&#10;+IFNULL([Calculation_1758655669806211098],0)&#13;&#10;+IFNULL([Calculation_1758655669806452763],0)' />
            </column>
            <column caption='AOV (LC)' datatype='real' name='[Calculation_1758655669806825501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])/SUM([succcessful_orders])' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_1758655669807112223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time])/SUM([delivery_time_den])' />
            </column>
            <column caption='% Delivery &gt; 45 Mins' datatype='real' name='[Calculation_1758655669807435809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_45])/SUM([delivery_time_den])' />
            </column>
            <column caption='% Order Late &gt; 10 Mins' datatype='real' name='[Calculation_1758655669807689763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delay_10])/SUM([delay_den])' />
            </column>
            <column caption='% of Orders w Service Fee %' datatype='real' name='[Calculation_2775061810911285248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([succcessful_orders_w_service_fee])/SUM([succcessful_orders])' />
            </column>
            <column caption='Date_filter' datatype='string' name='[Calculation_2775061810993688577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1758655669800689665]' />
            </column>
            <column caption='1-sum([succcessful_orders])/sum([gross_orders])' datatype='real' name='[Calculation_419397741124624391]' role='measure' type='quantitative' user:unnamed='Dashboard Prep'>
              <calculation class='tableau' formula='1-sum([succcessful_orders])/sum([gross_orders])' />
