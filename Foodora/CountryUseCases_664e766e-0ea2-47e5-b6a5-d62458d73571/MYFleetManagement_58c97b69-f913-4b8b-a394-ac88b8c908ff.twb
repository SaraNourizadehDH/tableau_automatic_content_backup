        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1wmdhk41m968ps1g7sq9a09eow0v' name='Custom SQL Query' type='text'>Select&#13;
created_date_local,&#13;
&quot;FP_MY&quot; AS global_entity_id,&#13;
city_name,&#13;
zone_name,&#13;
ROUND(SUM(riders_needed) / 2, 2) AS rider_demand_hours&#13;
  , ROUND(SUM(open_slots_size) / 4, 2) AS open_slots_hours&#13;
  , ROUND(SUM(planned_shift_duration) / 3600, 2) AS shift_hours&#13;
  , ROUND(SUM(evaluations_working_time) / 3600, 2) AS evaluated_hours&#13;
  , ROUND(SAFE_DIVIDE(SUM(open_slots_assigned), SUM(open_slots_size)), 4) AS fill_rate&#13;
&#13;
from `fulfillment-dwh-production.curated_data_shared.staffing_kpi` lgs&#13;
&#13;
where&#13;
&#13;
created_date_local &gt;&gt;= CURRENT_DATE() - 30&#13;
and country_code = &quot;my&quot;&#13;
and zone_name not LIKE &apos;%Dmart%&apos;&#13;
and city_name not LIKE &apos;%Kuala%&apos;&#13;
and zone_name not LIKE &apos;%dmart%&apos;&#13;
and zone_name not LIKE &apos;%DC%&apos;&#13;
group by 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
