      <column caption='fill rate' datatype='real' name='[Calculation_2320761244576108544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([planned_rh])/(sum([planned_rh])+sum({fixed date([shift_date]),[city_name_shift],[zone_name_shift],[starting_points_name]: avg([unassign_hour])}))' />
      </column>
      <column caption='unassgin hour' datatype='real' name='[Calculation_2320761244582834177]' role='measure' type='quantitative'>
