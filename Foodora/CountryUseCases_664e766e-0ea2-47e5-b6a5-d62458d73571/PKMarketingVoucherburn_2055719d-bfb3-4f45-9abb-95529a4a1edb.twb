          <metadata-record class='column'>
            <remote-name>Reporting_Month</remote-name>
            <remote-type>7</remote-type>
            <local-name>[Reporting_Month]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>Reporting_Month</remote-alias>
            <local-type>date</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_3C7F2369D32C4AF1AC9183F80FEF0564]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
