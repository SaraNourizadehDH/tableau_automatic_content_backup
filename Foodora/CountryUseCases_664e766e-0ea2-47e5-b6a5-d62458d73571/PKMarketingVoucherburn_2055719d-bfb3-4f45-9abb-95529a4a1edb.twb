  <datasources>
    <datasource caption='Voucher And Discount Finance Logic' inline='true' name='federated.0yq9q571gbbb2y19nu20a1itddrl' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0v7vbhe0spora617qx8xi021eq0k'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='foodpanda-pk-bigquery' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='syed.naqvi.2@foodpanda.pk' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0v7vbhe0spora617qx8xi021eq0k' name='Custom SQL Query' type='text'>With 
finance_voucher_cost as (
  SELECT order_code,global_entity_id,created_date_local,  finance_voucher_cost.vertical_per_redemption,
  finance_voucher_cost.vertical_per_budget,
  finance_voucher_cost.voucher_vertical_per_origin,RANK() over(partition by order_code order by voucher_vertical_per_origin desc) as ranking,sum(fp_vouchers_plus_vat_local) as fp_vouchers_plus_vat_local,sum(voucher_costs_fp_mkt_plus_vat_local) as voucher_costs_fp_mkt_plus_vat_local from `fulfillment-dwh-production.pandata_report.regional_apac_finance_voucher_cost_report` AS finance_voucher_cost
  WHERE finance_voucher_cost.global_entity_id = &apos;FP_PK&apos;
      AND finance_voucher_cost.created_date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    GROUP BY ALL
)
,
-- pick_up_excl as (
--   SELECT
--   created_date_local,
--   vendor_code,
--   ROUND(SUM(discount_costs_fp_mkt_local),2) discount_carc_local,
--   ROUND(SUM(discount_fp_revenue_reduction_local),2) discount_revenue_reduction_local,

-- FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_discount_cost_report` AS discount_cost_report

-- WHERE discount_cost_report.global_entity_id = &quot;FP_PK&quot;
--   AND created_date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
--   -- AND vertical_per_redemption = &quot;Pickup&quot;
--   GROUP BY ALL
-- )
-- ,
platform_comm_table as (
  SELECT
  DISTINCT
  a.date_local as Reporting_date,
  a.week_number reporting_week,
  finance_voucher_cost.vertical_per_redemption,
  finance_voucher_cost.vertical_per_budget,
  finance_voucher_cost.voucher_vertical_per_origin,
  av.channel,
  av.voucher_code,
  av.purpose,
  a.order_code,
  a.vendor_code,
  a.vendor_name,
  a.chain_name,
  CASE
        WHEN av.description = &quot;Reactivation Voucher&quot; THEN &quot;Reactivation Voucher&quot;
        WHEN av.purpose = &quot;loyalty&quot; THEN &quot;Loyalty&quot;
        WHEN LOWER(av.voucher_code) IN (&quot;nashtakaro&quot;, &quot;after11&quot;, &quot;cashless&quot;) THEN av.voucher_code
        WHEN av.channel IN (&quot;channel_email&quot;, &quot;channel_online&quot;)
            OR av.purpose = &quot;reactivation&quot;
            OR av.purpose = &quot;platform_acquisition&quot; THEN &quot;CRM&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND LOWER(av.voucher_code) = &quot;pehlaorder&quot; THEN &quot;Acquisition (pehla order)&quot;
        WHEN av.channel = &quot;channel_campaign&quot;
             AND LOWER(av.voucher_code) IN (&quot;faisalabad250&quot;, &quot;multan250&quot;, &quot;peshawar250&quot;, &quot;gujranwala250&quot;, &quot;sialkot250&quot;) THEN &quot;Acquisition (Cities)&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND av.description = &quot;Rs.300 Off Your Food Order&quot; THEN &quot;Acquisition (CRM In-wallet)&quot;
        WHEN av.channel = &quot;channel_customer_service&quot;
             OR LOWER(av.purpose) LIKE &quot;%compensation%&quot; OR av.purpose = &quot;sorry_panda&quot; THEN &quot;CXP&quot;
        WHEN (av.channel IN (&quot;channel_subsidies&quot;) AND av.purpose IN (&quot;experimentation&quot;, &quot;activation&quot;, &quot;acquisition&quot;, &quot;engagement&quot;)
            OR av.channel IN (&quot;channel_campaign&quot;) AND av.purpose IN (&quot;revenue&quot;, &quot;activation&quot;)
            OR av.channel IN (&quot;channel_campaign&quot;) AND av.purpose IN (&quot;engagement&quot;) AND av.description LIKE &quot;% Off On&quot;
            OR av.channel IN (&quot;channel_others&quot;))
          THEN &quot;Subsidies&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND av.description LIKE &quot;Rs%&quot; THEN &quot;CRM In Wallet&quot;
        WHEN (av.channel = &quot;channel_campaign&quot; AND av.purpose = &quot;engagement&quot;) OR av.description LIKE &quot;%Pau-Pau Wheel!%&quot;
          THEN &quot;Adhoc Engagement&quot;
        WHEN av.channel = &quot;channel_subsidies&quot; AND av.purpose = &quot;user_targeted&quot; THEN &quot;Audience Targetting&quot;
        WHEN av.channel = &quot;channel_internal&quot; THEN &quot;Channel internal&quot;
        WHEN av.channel = &quot;channel_corporate&quot; THEN &quot;Corporate/B2B&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND av.description IN (&quot;abhifpkaro@@@@@&quot;, &quot;abhifpkaro@@@@&quot;) THEN &quot;Affiliate PO&quot;
        WHEN av.channel = &quot;channel_h2h&quot; THEN &quot;Pandabox&quot;
        WHEN av.channel = &quot;channel_pandapro&quot; THEN &quot;Pandapro&quot;
        WHEN av.channel IN (&quot;channel_partnership&quot;, &quot;channel_pr&quot;) THEN &quot;Partnership&quot;
        WHEN LOWER(av.channel) LIKE &quot;%channel_refer%&quot; THEN &quot;RAF&quot;
        WHEN LOWER(av.channel) LIKE &quot;%channel_crm%&quot; THEN &quot;CRM&quot;
        ELSE &quot;Others&quot;
    END AS channel_updated,
  customer_agg_dates.customer_code,
  CAST(COALESCE(o.ordered_at_utc = customer_agg_dates.first_valid_order_all_at_utc, FALSE) AS BOOL) AS is_first_valid_order_platform,
     CASE
      WHEN
        av.channel IN (
          &quot;channel_competition&quot;, &quot;channel_internal&quot;, &quot;channel_corporate&quot;, &quot;channel_h2h&quot;, &quot;channel_employee_benefits&quot;, &quot;channel_corporate&quot;, &quot;channel_trade&quot;
        )
        OR av.purpose IN (&quot;autocompensation_realtime&quot;, &quot;compensation&quot;, &quot;sorry_panda&quot;, &quot;refund&quot;) THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%EFU%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%FAYSAL%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%IGI%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%TAKAFUL%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%MASTERCARD%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%MPHP%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%SCHOLAR%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%SONERI%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%PEARLS%&quot; THEN &quot;Dont Count&quot;
      WHEN av.channel != &quot;channel_campaign&quot;
        AND (UPPER(av.description) LIKE &quot;%@%&quot; AND UPPER(av.description) NOT LIKE &quot;%BAHL%&quot;) THEN &quot;Dont Count&quot;
      ELSE &quot;Count&quot;
    END AS mkt_status,
  -- a.vendor_code,

  CASE 
  WHEN o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = TRUE THEN &apos;OD&apos;
  WHEN o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = FALSE THEN &apos;VD&apos;
  ELSE &apos;PU&apos; END AS is_own_delivery,
  CASE
  WHEN a.vertical = &apos;restaurants&apos; and o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = TRUE THEN &quot;Restaurant OD&quot;
  WHEN a.vertical = &apos;restaurants&apos; and o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = FALSE THEN &quot;Restaurant VD&quot;
  WHEN a.vertical = &apos;home chefs&apos; and o.expedition_type = &apos;delivery&apos; THEN &apos;Homechef&apos;
  WHEN a.vertical = &apos;home chefs&apos; and o.expedition_type = &apos;pickup&apos; THEN &apos;Homechef PU&apos; 
  WHEN a.vertical = &apos;concepts&apos; THEN &apos;Concepts&apos;
  WHEN a.vertical = &apos;shops&apos; THEN &apos;Groceries&apos; 
  WHEN a.vertical = &apos;shared kitchens&apos; THEN &apos;Spaces&apos;
  WHEN a.vertical = &apos;darkstores&apos; THEN &apos;darkstores&apos;
  WHEN a.vertical = &apos;restaurants&apos; and o.expedition_type = &apos;pickup&apos; THEN &quot;Restaurant PU&quot; ELSE &apos;Restaurant OD&apos; END vertical,

  IFNULL(COUNT (a.order_code),0) Count_of_Orders,
  ROUND (SUM (IFNULL(a.total_cashback_excluding_ncp,0)), 2) foodpanda_discount_excl_ncp,
  -- ROUND (SUM (IFNULL(a.marketing_burn,0)), 2) marketing_burn,
  -- ROUND (SUM (IFNULL(a.ncp_cashback,0)), 2) ncp_cashback,
  ROUND( SUM (IFNULL(av.value_local,0)), 2) voucher_dmart,
 ROUND(
  SUM(
    IFNULL((
      CASE 
        WHEN a.vertical = &apos;darkstores&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%pehla%&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%grocerykaro%&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%starterpack%&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%welcomeback%&apos;
        THEN 0 
        ELSE av.value_local 
      END
    ), 0)
  ), 2
) AS voucher_value,
-- SUM(discount_carc_local) as discount_carc_local,
ROUND (SUM (IFNULL(a.marketing_burn,0)), 2) marketing_burn,
  ROUND (SUM (IFNULL(a.ncp_cashback,0)), 2) ncp_cashback,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
--AND av.channel = &apos;channel_online&apos;
AND av.purpose = &apos;loyalty&apos;
THEN av.value_local END,0)),2) customer_loyalty_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.purpose IN (&apos;refund&apos;)
THEN av.value_local END,0)),2) refund_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_corporate&apos;
AND av.purpose = &apos;revenue&apos;
THEN av.value_local END,0)),2) corporate_b2b_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_h2h&apos;
AND av.purpose = &apos;activation&apos;
THEN av.value_local end,0)),2) pandabox_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_partnership&apos;
AND av.purpose = &apos;revenue&apos;
AND av.voucher_code != &apos;hbl25&apos;
THEN av.value_local end,0)),2) corporate_partnership_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_partnership&apos;
AND av.purpose = &apos;revenue&apos;
AND av.voucher_code = &apos;hbl25&apos;
THEN av.value_local * 0.5 end,0)),2) corporate_partnership_vouchers_hbl25,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_others&apos;
AND av.purpose = &apos;psp_promo&apos;
AND av.voucher_code in (&apos;mc20&apos;,&apos;mc30&apos;)
THEN av.value_local end,0 )),2) corporate_partnership_vouchers_mc,
 ROUND (SUM (IFNULL(CASE
                      -- WHEN    a.vertical = &apos;darkstores&apos; THEN 0
                      WHEN    o.is_valid_order 
                        AND   o.decline_reason.title IS NULL
                        AND   av.channel = &apos;channel_others&apos;
                        -- AND   av.purpose = &apos;psp_promo&apos;
                        AND   av.voucher_code in (&apos;askari30&apos;)
                        THEN  av.value_local end,0 )),2) corporate_partnership_vouchers_askari,
        ROUND (SUM (IFNULL(CASE
                      -- WHEN    a.vertical = &apos;darkstores&apos; THEN 0
                      WHEN    o.is_valid_order 
                        AND   o.decline_reason.title IS NULL
                        AND   av.channel = &apos;channel_partnership&apos;
                        -- AND   av.purpose = &apos;psp_promo&apos;
                        AND   av.voucher_code in (&apos;ep150&apos;)
                        THEN  av.value_local end,0 )),2) corporate_partnership_vouchers_ep150,
ROUND (SUM (IFNULL(CASE
                      -- WHEN    a.vertical = &apos;darkstores&apos; THEN 0
                      WHEN    o.is_valid_order 
                        AND   o.decline_reason.title IS NULL
                        AND   av.purpose IN (&apos;sorry_panda&apos;, &apos;autocompensation_realtime&apos;,&apos;compensation&apos;)
                        THEN  av.value_local END,0)),2) compensation_sorry_vouchers,

  FROM `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` a
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` o
      ON o.code = a.order_code
      AND o.global_entity_id = &quot;FP_PK&quot;
      AND o.created_date_utc &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` av
      ON av.order_code = o.code
      AND av.global_entity_id = &apos;FP_PK&apos;
      AND av.created_date_utc &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` AS agg_accounting
    -- LEFT JOIN UNNEST(agg_accounting.accounting) AS accounting
     ON agg_accounting.order_code = o.code
     and agg_accounting.global_entity_id = &apos;FP_PK&apos;
     and agg_accounting.created_date_utc &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    LEFT JOIN UNNEST(agg_accounting.accounting) AS accounting
    LEFT JOIN finance_voucher_cost
      on finance_voucher_cost.order_code = a.order_code
      AND finance_voucher_cost.global_entity_id = &apos;FP_PK&apos;
      AND finance_voucher_cost.created_date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
      AND ranking = 1
    -- LEFT JOIN pick_up_excl
    --   ON lower(pick_up_excl.vendor_code) = lower(a.vendor_code)
    --   AND pick_up_excl.created_date_local = a.date_local
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_orders_dates` AS customer_agg_dates
        ON o.pd_customer_uuid = customer_agg_dates.uuid
        AND customer_agg_dates.global_entity_id = &quot;FP_PK&quot;
  WHERE a.date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month)
  AND a.billable = &quot;Billable&quot;
  -- AND a.vertical =&apos;shared kitchens&apos;
  and accounting.is_order_last_entry
  AND a.vendor_code != &apos;lnwf&apos;
  AND (lower(a.vendor_name) not like (&apos;%pandamart - business%&apos;) or lower(a.vendor_name) not like (&apos;%pandamart for business%&apos;))
  GROUP BY all
)
select vertical,
  vertical_per_redemption,
  vertical_per_budget,
   is_own_delivery,
  voucher_vertical_per_origin,
  date_trunc(Reporting_date,month) as Reporting_Month,
  Reporting_date,
  chain_name,
  vendor_name,
  vendor_code,
  reporting_week,
  sum(voucher_value) AS voucher_value,  
  SUM(voucher_dmart) as voucher_dmart,
  channel,
  channel_updated,
  mkt_status,
  voucher_code,
  purpose,
  count(distinct order_code) as order_count,
  -- SUM(discount_carc_local) as discount_carc_local,
SUM(marketing_burn) as  marketing_burn,
 SUM(ncp_cashback) ncp_cashback,
  -- customer_agg_dates.customer_code,
  is_first_valid_order_platform AS customer_class,
SUM(customer_loyalty_vouchers) AS customer_loyalty_vouchers,sum(refund_vouchers) as refund_vouchers,
SUM(corporate_b2b_vouchers) AS corporate_b2b_vouchers,
SUM(pandabox_vouchers) AS pandabox_vouchers,
SUM(corporate_partnership_vouchers) AS corporate_partnership_vouchers,
SUM(corporate_partnership_vouchers_hbl25) AS corporate_partnership_vouchers_hbl25,
SUM(corporate_partnership_vouchers_mc) AS corporate_partnership_vouchers_mc,
SUM(corporate_partnership_vouchers_askari) AS corporate_partnership_vouchers_askari,
SUM(corporate_partnership_vouchers_ep150) AS corporate_partnership_vouchers_ep150,
SUM(compensation_sorry_vouchers) AS compensation_sorry_vouchers,
SUM(voucher_dmart-customer_loyalty_vouchers-refund_vouchers-corporate_b2b_vouchers-pandabox_vouchers-corporate_partnership_vouchers-corporate_partnership_vouchers_hbl25-corporate_partnership_vouchers_mc-compensation_sorry_vouchers-corporate_partnership_vouchers_askari-corporate_partnership_vouchers_ep150) AS voucher_incentive_part
   from platform_comm_table
group by all</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0v7vbhe0spora617qx8xi021eq0k' name='Custom SQL Query' type='text'>With 
finance_voucher_cost as (
  SELECT order_code,global_entity_id,created_date_local,  finance_voucher_cost.vertical_per_redemption,
  finance_voucher_cost.vertical_per_budget,
  finance_voucher_cost.voucher_vertical_per_origin,RANK() over(partition by order_code order by voucher_vertical_per_origin desc) as ranking,sum(fp_vouchers_plus_vat_local) as fp_vouchers_plus_vat_local,sum(voucher_costs_fp_mkt_plus_vat_local) as voucher_costs_fp_mkt_plus_vat_local from `fulfillment-dwh-production.pandata_report.regional_apac_finance_voucher_cost_report` AS finance_voucher_cost
  WHERE finance_voucher_cost.global_entity_id = &apos;FP_PK&apos;
      AND finance_voucher_cost.created_date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    GROUP BY ALL
)
,
-- pick_up_excl as (
--   SELECT
--   created_date_local,
--   vendor_code,
--   ROUND(SUM(discount_costs_fp_mkt_local),2) discount_carc_local,
--   ROUND(SUM(discount_fp_revenue_reduction_local),2) discount_revenue_reduction_local,

-- FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_discount_cost_report` AS discount_cost_report

-- WHERE discount_cost_report.global_entity_id = &quot;FP_PK&quot;
--   AND created_date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
--   -- AND vertical_per_redemption = &quot;Pickup&quot;
--   GROUP BY ALL
-- )
-- ,
platform_comm_table as (
  SELECT
  DISTINCT
  a.date_local as Reporting_date,
  a.week_number reporting_week,
  finance_voucher_cost.vertical_per_redemption,
  finance_voucher_cost.vertical_per_budget,
  finance_voucher_cost.voucher_vertical_per_origin,
  av.channel,
  av.voucher_code,
  av.purpose,
  a.order_code,
  a.vendor_code,
  a.vendor_name,
  a.chain_name,
  CASE
        WHEN av.description = &quot;Reactivation Voucher&quot; THEN &quot;Reactivation Voucher&quot;
        WHEN av.purpose = &quot;loyalty&quot; THEN &quot;Loyalty&quot;
        WHEN LOWER(av.voucher_code) IN (&quot;nashtakaro&quot;, &quot;after11&quot;, &quot;cashless&quot;) THEN av.voucher_code
        WHEN av.channel IN (&quot;channel_email&quot;, &quot;channel_online&quot;)
            OR av.purpose = &quot;reactivation&quot;
            OR av.purpose = &quot;platform_acquisition&quot; THEN &quot;CRM&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND LOWER(av.voucher_code) = &quot;pehlaorder&quot; THEN &quot;Acquisition (pehla order)&quot;
        WHEN av.channel = &quot;channel_campaign&quot;
             AND LOWER(av.voucher_code) IN (&quot;faisalabad250&quot;, &quot;multan250&quot;, &quot;peshawar250&quot;, &quot;gujranwala250&quot;, &quot;sialkot250&quot;) THEN &quot;Acquisition (Cities)&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND av.description = &quot;Rs.300 Off Your Food Order&quot; THEN &quot;Acquisition (CRM In-wallet)&quot;
        WHEN av.channel = &quot;channel_customer_service&quot;
             OR LOWER(av.purpose) LIKE &quot;%compensation%&quot; OR av.purpose = &quot;sorry_panda&quot; THEN &quot;CXP&quot;
        WHEN (av.channel IN (&quot;channel_subsidies&quot;) AND av.purpose IN (&quot;experimentation&quot;, &quot;activation&quot;, &quot;acquisition&quot;, &quot;engagement&quot;)
            OR av.channel IN (&quot;channel_campaign&quot;) AND av.purpose IN (&quot;revenue&quot;, &quot;activation&quot;)
            OR av.channel IN (&quot;channel_campaign&quot;) AND av.purpose IN (&quot;engagement&quot;) AND av.description LIKE &quot;% Off On&quot;
            OR av.channel IN (&quot;channel_others&quot;))
          THEN &quot;Subsidies&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND av.description LIKE &quot;Rs%&quot; THEN &quot;CRM In Wallet&quot;
        WHEN (av.channel = &quot;channel_campaign&quot; AND av.purpose = &quot;engagement&quot;) OR av.description LIKE &quot;%Pau-Pau Wheel!%&quot;
          THEN &quot;Adhoc Engagement&quot;
        WHEN av.channel = &quot;channel_subsidies&quot; AND av.purpose = &quot;user_targeted&quot; THEN &quot;Audience Targetting&quot;
        WHEN av.channel = &quot;channel_internal&quot; THEN &quot;Channel internal&quot;
        WHEN av.channel = &quot;channel_corporate&quot; THEN &quot;Corporate/B2B&quot;
        WHEN av.channel = &quot;channel_campaign&quot; AND av.description IN (&quot;abhifpkaro@@@@@&quot;, &quot;abhifpkaro@@@@&quot;) THEN &quot;Affiliate PO&quot;
        WHEN av.channel = &quot;channel_h2h&quot; THEN &quot;Pandabox&quot;
        WHEN av.channel = &quot;channel_pandapro&quot; THEN &quot;Pandapro&quot;
        WHEN av.channel IN (&quot;channel_partnership&quot;, &quot;channel_pr&quot;) THEN &quot;Partnership&quot;
        WHEN LOWER(av.channel) LIKE &quot;%channel_refer%&quot; THEN &quot;RAF&quot;
        WHEN LOWER(av.channel) LIKE &quot;%channel_crm%&quot; THEN &quot;CRM&quot;
        ELSE &quot;Others&quot;
    END AS channel_updated,
  customer_agg_dates.customer_code,
  CAST(COALESCE(o.ordered_at_utc = customer_agg_dates.first_valid_order_all_at_utc, FALSE) AS BOOL) AS is_first_valid_order_platform,
     CASE
      WHEN
        av.channel IN (
          &quot;channel_competition&quot;, &quot;channel_internal&quot;, &quot;channel_corporate&quot;, &quot;channel_h2h&quot;, &quot;channel_employee_benefits&quot;, &quot;channel_corporate&quot;, &quot;channel_trade&quot;
        )
        OR av.purpose IN (&quot;autocompensation_realtime&quot;, &quot;compensation&quot;, &quot;sorry_panda&quot;, &quot;refund&quot;) THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%EFU%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%FAYSAL%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%IGI%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%TAKAFUL%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%MASTERCARD%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%MPHP%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%SCHOLAR%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%SONERI%&quot; THEN &quot;Dont Count&quot;
      WHEN UPPER(av.description) LIKE &quot;%PEARLS%&quot; THEN &quot;Dont Count&quot;
      WHEN av.channel != &quot;channel_campaign&quot;
        AND (UPPER(av.description) LIKE &quot;%@%&quot; AND UPPER(av.description) NOT LIKE &quot;%BAHL%&quot;) THEN &quot;Dont Count&quot;
      ELSE &quot;Count&quot;
    END AS mkt_status,
  -- a.vendor_code,

  CASE 
  WHEN o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = TRUE THEN &apos;OD&apos;
  WHEN o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = FALSE THEN &apos;VD&apos;
  ELSE &apos;PU&apos; END AS is_own_delivery,
  CASE
  WHEN a.vertical = &apos;restaurants&apos; and o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = TRUE THEN &quot;Restaurant OD&quot;
  WHEN a.vertical = &apos;restaurants&apos; and o.expedition_type = &apos;delivery&apos; AND o.is_own_delivery = FALSE THEN &quot;Restaurant VD&quot;
  WHEN a.vertical = &apos;home chefs&apos; and o.expedition_type = &apos;delivery&apos; THEN &apos;Homechef&apos;
  WHEN a.vertical = &apos;home chefs&apos; and o.expedition_type = &apos;pickup&apos; THEN &apos;Homechef PU&apos; 
  WHEN a.vertical = &apos;concepts&apos; THEN &apos;Concepts&apos;
  WHEN a.vertical = &apos;shops&apos; THEN &apos;Groceries&apos; 
  WHEN a.vertical = &apos;shared kitchens&apos; THEN &apos;Spaces&apos;
  WHEN a.vertical = &apos;darkstores&apos; THEN &apos;darkstores&apos;
  WHEN a.vertical = &apos;restaurants&apos; and o.expedition_type = &apos;pickup&apos; THEN &quot;Restaurant PU&quot; ELSE &apos;Restaurant OD&apos; END vertical,

  IFNULL(COUNT (a.order_code),0) Count_of_Orders,
  ROUND (SUM (IFNULL(a.total_cashback_excluding_ncp,0)), 2) foodpanda_discount_excl_ncp,
  -- ROUND (SUM (IFNULL(a.marketing_burn,0)), 2) marketing_burn,
  -- ROUND (SUM (IFNULL(a.ncp_cashback,0)), 2) ncp_cashback,
  ROUND( SUM (IFNULL(av.value_local,0)), 2) voucher_dmart,
 ROUND(
  SUM(
    IFNULL((
      CASE 
        WHEN a.vertical = &apos;darkstores&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%pehla%&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%grocerykaro%&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%starterpack%&apos; 
          AND LOWER(av.voucher_code) NOT LIKE &apos;%welcomeback%&apos;
        THEN 0 
        ELSE av.value_local 
      END
    ), 0)
  ), 2
) AS voucher_value,
-- SUM(discount_carc_local) as discount_carc_local,
ROUND (SUM (IFNULL(a.marketing_burn,0)), 2) marketing_burn,
  ROUND (SUM (IFNULL(a.ncp_cashback,0)), 2) ncp_cashback,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
--AND av.channel = &apos;channel_online&apos;
AND av.purpose = &apos;loyalty&apos;
THEN av.value_local END,0)),2) customer_loyalty_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.purpose IN (&apos;refund&apos;)
THEN av.value_local END,0)),2) refund_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_corporate&apos;
AND av.purpose = &apos;revenue&apos;
THEN av.value_local END,0)),2) corporate_b2b_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_h2h&apos;
AND av.purpose = &apos;activation&apos;
THEN av.value_local end,0)),2) pandabox_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_partnership&apos;
AND av.purpose = &apos;revenue&apos;
AND av.voucher_code != &apos;hbl25&apos;
THEN av.value_local end,0)),2) corporate_partnership_vouchers,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_partnership&apos;
AND av.purpose = &apos;revenue&apos;
AND av.voucher_code = &apos;hbl25&apos;
THEN av.value_local * 0.5 end,0)),2) corporate_partnership_vouchers_hbl25,
ROUND (SUM (IFNULL(CASE
-- WHEN a.vertical = &apos;darkstores&apos; THEN 0
WHEN o.is_valid_order
AND o.decline_reason.title IS NULL
AND av.channel = &apos;channel_others&apos;
AND av.purpose = &apos;psp_promo&apos;
AND av.voucher_code in (&apos;mc20&apos;,&apos;mc30&apos;)
THEN av.value_local end,0 )),2) corporate_partnership_vouchers_mc,
 ROUND (SUM (IFNULL(CASE
                      -- WHEN    a.vertical = &apos;darkstores&apos; THEN 0
                      WHEN    o.is_valid_order 
                        AND   o.decline_reason.title IS NULL
                        AND   av.channel = &apos;channel_others&apos;
                        -- AND   av.purpose = &apos;psp_promo&apos;
                        AND   av.voucher_code in (&apos;askari30&apos;)
                        THEN  av.value_local end,0 )),2) corporate_partnership_vouchers_askari,
        ROUND (SUM (IFNULL(CASE
                      -- WHEN    a.vertical = &apos;darkstores&apos; THEN 0
                      WHEN    o.is_valid_order 
                        AND   o.decline_reason.title IS NULL
                        AND   av.channel = &apos;channel_partnership&apos;
                        -- AND   av.purpose = &apos;psp_promo&apos;
                        AND   av.voucher_code in (&apos;ep150&apos;)
                        THEN  av.value_local end,0 )),2) corporate_partnership_vouchers_ep150,
ROUND (SUM (IFNULL(CASE
                      -- WHEN    a.vertical = &apos;darkstores&apos; THEN 0
                      WHEN    o.is_valid_order 
                        AND   o.decline_reason.title IS NULL
                        AND   av.purpose IN (&apos;sorry_panda&apos;, &apos;autocompensation_realtime&apos;,&apos;compensation&apos;)
                        THEN  av.value_local END,0)),2) compensation_sorry_vouchers,

  FROM `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` a
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` o
      ON o.code = a.order_code
      AND o.global_entity_id = &quot;FP_PK&quot;
      AND o.created_date_utc &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` av
      ON av.order_code = o.code
      AND av.global_entity_id = &apos;FP_PK&apos;
      AND av.created_date_utc &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` AS agg_accounting
    -- LEFT JOIN UNNEST(agg_accounting.accounting) AS accounting
     ON agg_accounting.order_code = o.code
     and agg_accounting.global_entity_id = &apos;FP_PK&apos;
     and agg_accounting.created_date_utc &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
    LEFT JOIN UNNEST(agg_accounting.accounting) AS accounting
    LEFT JOIN finance_voucher_cost
      on finance_voucher_cost.order_code = a.order_code
      AND finance_voucher_cost.global_entity_id = &apos;FP_PK&apos;
      AND finance_voucher_cost.created_date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
      AND ranking = 1
    -- LEFT JOIN pick_up_excl
    --   ON lower(pick_up_excl.vendor_code) = lower(a.vendor_code)
    --   AND pick_up_excl.created_date_local = a.date_local
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_orders_dates` AS customer_agg_dates
        ON o.pd_customer_uuid = customer_agg_dates.uuid
        AND customer_agg_dates.global_entity_id = &quot;FP_PK&quot;
  WHERE a.date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month)
  AND a.billable = &quot;Billable&quot;
  -- AND a.vertical =&apos;shared kitchens&apos;
  and accounting.is_order_last_entry
  AND a.vendor_code != &apos;lnwf&apos;
  AND (lower(a.vendor_name) not like (&apos;%pandamart - business%&apos;) or lower(a.vendor_name) not like (&apos;%pandamart for business%&apos;))
  GROUP BY all
)
select vertical,
  vertical_per_redemption,
  vertical_per_budget,
   is_own_delivery,
  voucher_vertical_per_origin,
  date_trunc(Reporting_date,month) as Reporting_Month,
  Reporting_date,
  chain_name,
  vendor_name,
  vendor_code,
  reporting_week,
  sum(voucher_value) AS voucher_value,  
  SUM(voucher_dmart) as voucher_dmart,
  channel,
  channel_updated,
  mkt_status,
  voucher_code,
  purpose,
  count(distinct order_code) as order_count,
  -- SUM(discount_carc_local) as discount_carc_local,
SUM(marketing_burn) as  marketing_burn,
 SUM(ncp_cashback) ncp_cashback,
  -- customer_agg_dates.customer_code,
  is_first_valid_order_platform AS customer_class,
SUM(customer_loyalty_vouchers) AS customer_loyalty_vouchers,sum(refund_vouchers) as refund_vouchers,
SUM(corporate_b2b_vouchers) AS corporate_b2b_vouchers,
SUM(pandabox_vouchers) AS pandabox_vouchers,
SUM(corporate_partnership_vouchers) AS corporate_partnership_vouchers,
SUM(corporate_partnership_vouchers_hbl25) AS corporate_partnership_vouchers_hbl25,
SUM(corporate_partnership_vouchers_mc) AS corporate_partnership_vouchers_mc,
SUM(corporate_partnership_vouchers_askari) AS corporate_partnership_vouchers_askari,
SUM(corporate_partnership_vouchers_ep150) AS corporate_partnership_vouchers_ep150,
SUM(compensation_sorry_vouchers) AS compensation_sorry_vouchers,
SUM(voucher_dmart-customer_loyalty_vouchers-refund_vouchers-corporate_b2b_vouchers-pandabox_vouchers-corporate_partnership_vouchers-corporate_partnership_vouchers_hbl25-corporate_partnership_vouchers_mc-compensation_sorry_vouchers-corporate_partnership_vouchers_askari-corporate_partnership_vouchers_ep150) AS voucher_incentive_part
   from platform_comm_table
group by all</relation>
          <relation connection='bigquery.0v7vbhe0spora617qx8xi021eq0k' name='Custom SQL Query1' type='text'>SELECT
  created_date_local,
  vendor_code,
  &apos;PU&apos; as exp_type,
  ROUND(SUM(discount_costs_fp_mkt_local),2) discount_carc_local,
  ROUND(SUM(discount_fp_revenue_reduction_local),2) discount_revenue_reduction_local,

FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_discount_cost_report` AS discount_cost_report

WHERE discount_cost_report.global_entity_id = &quot;FP_PK&quot;
  AND created_date_local &gt;&gt;= date_trunc(date_sub(current_date(), interval 2 month), month) - 10
  AND vertical_per_redemption = &quot;Pickup&quot;
  GROUP BY ALL</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
