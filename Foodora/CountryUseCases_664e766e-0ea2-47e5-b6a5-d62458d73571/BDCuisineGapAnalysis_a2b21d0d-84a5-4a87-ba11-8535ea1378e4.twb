        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02i0t1h1lletwd1gje79h1h3hoq7' name='Custom SQL Query' type='text'><![CDATA[WITH vmap AS(
  SELECT DISTINCT
  format_datetime("%Y%m", b.report_date) as month,
   b.vendor_code,
   vm.global_entity_id, 
   vm.cluster_name,
   vm.city_name,
   vm.primary_zone_name, 
   vm.primary_cuisine_title, 
  FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS b
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS vm 
          ON b.vendor_code = vm.vendor_code
  WHERE b.global_entity_id = 'FP_BD'
  AND b.is_active
  AND b.is_private IS FALSE
  AND b.is_test IS FALSE
  AND b.report_date between date_trunc(date_sub(current_date(), INTERVAL 60 day), month) and DATE_SUB(current_date(), INTERVAL 1 day)
  AND vm.business_type_apac IN ('restaurants')
  AND vm.cluster_name is not null
  and vm.primary_cuisine_title is not null
  ),
  
  
cuisine_wise_zone_vendor as(  
  select distinct 
    month,
    vmap.cluster_name,
    vmap.city_name, 
    vmap.primary_zone_name,
    vmap.primary_cuisine_title,
    count(distinct vmap.Vendor_code) as vendor_count
  from vmap
  WHERE vmap.cluster_name is not null
  GROUP BY 1,2,3,4,5
  ORDER BY 1,2,3,4,5
  ),
cuisine_wise_country_vendor as(  
  select distinct 
    month,
    vmap.primary_cuisine_title,
    count(distinct vmap.Vendor_code) as vendor_count
  from vmap
  WHERE vmap.cluster_name is not null
  GROUP BY 1,2
  ),
overall_zone_vendor as(  
  select distinct 
    month,
    vmap.cluster_name,
    vmap.city_name, 
    vmap.primary_zone_name,
    count(distinct vmap.Vendor_code) as vendor_count
  from vmap
  WHERE vmap.cluster_name is not null
  GROUP BY 1,2,3,4
--   ORDER BY 1,2,3
  ),
  
overall_country_vendor as(
  select
    global_entity_id,
    month,
    count(distinct vendor_code) as vendor_count,
  from vmap
  group by 1,2
)  
  
,order_data as(
select distinct
  bdf.global_entity_id,   
  format_datetime("%Y%m", bdf.order_date) as order_month,
  vmap.primary_cuisine_title,
  vmap.primary_zone_name,  
  vmap.Vendor_code,
  bdf.order_date,  
  bdf.order_code,
  bdf.gfv_combined_local, 
from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` as bdf
inner join vmap
       ON vmap.Vendor_code =bdf.vendor_code 
where bdf.is_valid_order =true
and bdf.business_type_apac ="restaurants"
and bdf.order_date between date_trunc(date_sub(current_date(), INTERVAL 60 day), month) and DATE_SUB(current_date(), INTERVAL 1 day)
),

country_total_order as(
select
  order_month,
  global_entity_id,
  count(distinct order_code) as order_count,
from order_data
group by 1,2
),

cuisine_wise_zone_order as(
Select distinct
  order_month,
  primary_cuisine_title,
  primary_zone_name,
  count(distinct order_code) as order_count,
  sum(gfv_combined_local)/count(distinct order_code) as cuisine_wise_AFV
from order_data
group by 1,2,3
),

cuisine_wise_country_order as(
Select distinct
  order_month,
  primary_cuisine_title,
  count(distinct order_code) as order_count,
  sum(gfv_combined_local)/count(order_code) as cuisine_wise_AFV
from order_data
group by 1,2
),

overall_zone_order as(
Select distinct
  order_month,
  primary_zone_name,  
  count(distinct order_code) as order_count,
  sum(gfv_combined_local)/count(order_code) as cuisine_wise_AFV
from order_data
group by 1,2
)

Select distinct
  vmap.month,
  vmap.cluster_name,
  vmap.city_name,
  vmap.primary_zone_name,
  vmap.primary_cuisine_title,
  IFNULL(cuisine_wise_zone_vendor.vendor_count,0) as cuisine_wise_zonal_vendor_count,
  IFNULL(cuisine_wise_zone_order.order_count,0) as cuisine_wise_zonal_order_count,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,cuisine_wise_zone_vendor.vendor_count),0),2) as cuisine_wise_zonal_order_per_vendor,
  ROUND(IFNULL(cuisine_wise_zone_order.cuisine_wise_AFV,0),2) as cuisine_wise_zonal_AFV,
  IFNULL(cuisine_wise_country_vendor.vendor_count,0) as cuisine_wise_country_vendor_count,
  IFNULL(cuisine_wise_country_order.order_count,0) as cuisine_wise_country_order_count,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_order.order_count,cuisine_wise_country_vendor.vendor_count),0),2) as cuisine_wise_country_order_per_vendor,
  ROUND(IFNULL(cuisine_wise_country_order.cuisine_wise_AFV,0),2) as cuisine_wise_country_AFV,
  IFNULL(overall_zone_order.order_count,0) as overall_zone_order,
  IFNULL(overall_zone_vendor.vendor_count,0) as overall_vendor_count,
  ROUND(IFNULL(overall_zone_order.cuisine_wise_AFV,0),2) as overall_zone_AFV,
  ROUND(IFNULL(SAFE_DIVIDE(overall_zone_order.order_count,overall_zone_vendor.vendor_count),0),2) as overall_zone_order_per_vendor,
  
  IFNULL(overall_country_vendor.vendor_count,0) as overall_country_vendor,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count),0),2) as country_vendor_share,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_order.order_count,country_total_order.order_count),0),2) as country_order_share,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count,overall_zone_vendor.vendor_count),0),2) as Zone_Vendor_Share,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,overall_zone_order.order_count),0),2) as Zone_Order_Share,
  
  (CASE WHEN IFNULL(SAFE_DIVIDE(IFNULL(cuisine_wise_zone_vendor.vendor_count,0),overall_zone_vendor.vendor_count),0)>> IFNULL(SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count),0) then "High"
       WHEN IFNULL(SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count,overall_zone_vendor.vendor_count),0)<< IFNULL((SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count)*0.8),0) then "Low" 
       ELSE "Moderate" end
  ) as Vendor_Share,
  
    (CASE WHEN IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,overall_zone_order.order_count),0)>> IFNULL(SAFE_DIVIDE(cuisine_wise_country_order.order_count,country_total_order.order_count),0) then "High"
       WHEN IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,overall_zone_order.order_count),0)<< IFNULL((SAFE_DIVIDE(cuisine_wise_country_order.order_count,country_total_order.order_count)*0.8),0) then "Low" 
       ELSE "Moderate" end
  ) as Order_Share,
  
  CAST((((SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count, ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count,overall_zone_vendor.vendor_count),0),2)))*ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count),0),2)-IFNULL(cuisine_wise_zone_vendor.vendor_count,0))+1)as INT64) as count_of_vendor_required,
  
from vmap
left join cuisine_wise_zone_vendor
        ON cuisine_wise_zone_vendor.month=vmap.month
       AND cuisine_wise_zone_vendor.primary_zone_name=vmap.primary_zone_name
      and cuisine_wise_zone_vendor.primary_cuisine_title=vmap.primary_cuisine_title
left join cuisine_wise_zone_order
       ON cuisine_wise_zone_order.primary_zone_name=vmap.primary_zone_name
      and cuisine_wise_zone_order.primary_cuisine_title=vmap.primary_cuisine_title
      and cuisine_wise_zone_order.order_month=vmap.month
left join cuisine_wise_country_vendor
       ON cuisine_wise_country_vendor.primary_cuisine_title=vmap.primary_cuisine_title  
      and cuisine_wise_country_vendor.month=vmap.month  
left join cuisine_wise_country_order
       ON cuisine_wise_country_order.primary_cuisine_title=vmap.primary_cuisine_title 
      and cuisine_wise_country_order.order_month=vmap.month 
left join overall_zone_order
       ON overall_zone_order.primary_zone_name=vmap.primary_zone_name
      and overall_zone_order.order_month=vmap.month
left join overall_zone_vendor
       ON overall_zone_vendor.primary_zone_name= vmap.primary_zone_name
      and overall_zone_vendor.month= vmap.month
left join overall_country_vendor
       on overall_country_vendor.global_entity_id= vmap.global_entity_id  
      and overall_country_vendor.month= vmap.month  
left join country_total_order 
       ON country_total_order.global_entity_id =vmap.global_entity_id 
      and country_total_order.order_month =vmap.month 
order by 1,2,3,4,5]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.02i0t1h1lletwd1gje79h1h3hoq7' name='Custom SQL Query' type='text'><![CDATA[WITH vmap AS(
  SELECT DISTINCT
  format_datetime("%Y%m", b.report_date) as month,
   b.vendor_code,
   vm.global_entity_id, 
   vm.cluster_name,
   vm.city_name,
   vm.primary_zone_name, 
   vm.primary_cuisine_title, 
  FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS b
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS vm 
          ON b.vendor_code = vm.vendor_code
  WHERE b.global_entity_id = 'FP_BD'
  AND b.is_active
  AND b.is_private IS FALSE
  AND b.is_test IS FALSE
  AND b.report_date between date_trunc(date_sub(current_date(), INTERVAL 60 day), month) and DATE_SUB(current_date(), INTERVAL 1 day)
  AND vm.business_type_apac IN ('restaurants')
  AND vm.cluster_name is not null
  and vm.primary_cuisine_title is not null
  ),
  
  
cuisine_wise_zone_vendor as(  
  select distinct 
    month,
    vmap.cluster_name,
    vmap.city_name, 
    vmap.primary_zone_name,
    vmap.primary_cuisine_title,
    count(distinct vmap.Vendor_code) as vendor_count
  from vmap
  WHERE vmap.cluster_name is not null
  GROUP BY 1,2,3,4,5
  ORDER BY 1,2,3,4,5
  ),
cuisine_wise_country_vendor as(  
  select distinct 
    month,
    vmap.primary_cuisine_title,
    count(distinct vmap.Vendor_code) as vendor_count
  from vmap
  WHERE vmap.cluster_name is not null
  GROUP BY 1,2
  ),
overall_zone_vendor as(  
  select distinct 
    month,
    vmap.cluster_name,
    vmap.city_name, 
    vmap.primary_zone_name,
    count(distinct vmap.Vendor_code) as vendor_count
  from vmap
  WHERE vmap.cluster_name is not null
  GROUP BY 1,2,3,4
--   ORDER BY 1,2,3
  ),
  
overall_country_vendor as(
  select
    global_entity_id,
    month,
    count(distinct vendor_code) as vendor_count,
  from vmap
  group by 1,2
)  
  
,order_data as(
select distinct
  bdf.global_entity_id,   
  format_datetime("%Y%m", bdf.order_date) as order_month,
  vmap.primary_cuisine_title,
  vmap.primary_zone_name,  
  vmap.Vendor_code,
  bdf.order_date,  
  bdf.order_code,
  bdf.gfv_combined_local, 
from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` as bdf
inner join vmap
       ON vmap.Vendor_code =bdf.vendor_code 
where bdf.is_valid_order =true
and bdf.business_type_apac ="restaurants"
and bdf.order_date between date_trunc(date_sub(current_date(), INTERVAL 60 day), month) and DATE_SUB(current_date(), INTERVAL 1 day)
),

country_total_order as(
select
  order_month,
  global_entity_id,
  count(distinct order_code) as order_count,
from order_data
group by 1,2
),

cuisine_wise_zone_order as(
Select distinct
  order_month,
  primary_cuisine_title,
  primary_zone_name,
  count(distinct order_code) as order_count,
  sum(gfv_combined_local)/count(distinct order_code) as cuisine_wise_AFV
from order_data
group by 1,2,3
),

cuisine_wise_country_order as(
Select distinct
  order_month,
  primary_cuisine_title,
  count(distinct order_code) as order_count,
  sum(gfv_combined_local)/count(order_code) as cuisine_wise_AFV
from order_data
group by 1,2
),

overall_zone_order as(
Select distinct
  order_month,
  primary_zone_name,  
  count(distinct order_code) as order_count,
  sum(gfv_combined_local)/count(order_code) as cuisine_wise_AFV
from order_data
group by 1,2
)

Select distinct
  vmap.month,
  vmap.cluster_name,
  vmap.city_name,
  vmap.primary_zone_name,
  vmap.primary_cuisine_title,
  IFNULL(cuisine_wise_zone_vendor.vendor_count,0) as cuisine_wise_zonal_vendor_count,
  IFNULL(cuisine_wise_zone_order.order_count,0) as cuisine_wise_zonal_order_count,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,cuisine_wise_zone_vendor.vendor_count),0),2) as cuisine_wise_zonal_order_per_vendor,
  ROUND(IFNULL(cuisine_wise_zone_order.cuisine_wise_AFV,0),2) as cuisine_wise_zonal_AFV,
  IFNULL(cuisine_wise_country_vendor.vendor_count,0) as cuisine_wise_country_vendor_count,
  IFNULL(cuisine_wise_country_order.order_count,0) as cuisine_wise_country_order_count,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_order.order_count,cuisine_wise_country_vendor.vendor_count),0),2) as cuisine_wise_country_order_per_vendor,
  ROUND(IFNULL(cuisine_wise_country_order.cuisine_wise_AFV,0),2) as cuisine_wise_country_AFV,
  IFNULL(overall_zone_order.order_count,0) as overall_zone_order,
  IFNULL(overall_zone_vendor.vendor_count,0) as overall_vendor_count,
  ROUND(IFNULL(overall_zone_order.cuisine_wise_AFV,0),2) as overall_zone_AFV,
  ROUND(IFNULL(SAFE_DIVIDE(overall_zone_order.order_count,overall_zone_vendor.vendor_count),0),2) as overall_zone_order_per_vendor,
  
  IFNULL(overall_country_vendor.vendor_count,0) as overall_country_vendor,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count),0),2) as country_vendor_share,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_order.order_count,country_total_order.order_count),0),2) as country_order_share,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count,overall_zone_vendor.vendor_count),0),2) as Zone_Vendor_Share,
  ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,overall_zone_order.order_count),0),2) as Zone_Order_Share,
  
  (CASE WHEN IFNULL(SAFE_DIVIDE(IFNULL(cuisine_wise_zone_vendor.vendor_count,0),overall_zone_vendor.vendor_count),0)>> IFNULL(SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count),0) then "High"
       WHEN IFNULL(SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count,overall_zone_vendor.vendor_count),0)<< IFNULL((SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count)*0.8),0) then "Low" 
       ELSE "Moderate" end
  ) as Vendor_Share,
  
    (CASE WHEN IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,overall_zone_order.order_count),0)>> IFNULL(SAFE_DIVIDE(cuisine_wise_country_order.order_count,country_total_order.order_count),0) then "High"
       WHEN IFNULL(SAFE_DIVIDE(cuisine_wise_zone_order.order_count,overall_zone_order.order_count),0)<< IFNULL((SAFE_DIVIDE(cuisine_wise_country_order.order_count,country_total_order.order_count)*0.8),0) then "Low" 
       ELSE "Moderate" end
  ) as Order_Share,
  
  CAST((((SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count, ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_zone_vendor.vendor_count,overall_zone_vendor.vendor_count),0),2)))*ROUND(IFNULL(SAFE_DIVIDE(cuisine_wise_country_vendor.vendor_count,overall_country_vendor.vendor_count),0),2)-IFNULL(cuisine_wise_zone_vendor.vendor_count,0))+1)as INT64) as count_of_vendor_required,
  
from vmap
left join cuisine_wise_zone_vendor
        ON cuisine_wise_zone_vendor.month=vmap.month
       AND cuisine_wise_zone_vendor.primary_zone_name=vmap.primary_zone_name
      and cuisine_wise_zone_vendor.primary_cuisine_title=vmap.primary_cuisine_title
left join cuisine_wise_zone_order
       ON cuisine_wise_zone_order.primary_zone_name=vmap.primary_zone_name
      and cuisine_wise_zone_order.primary_cuisine_title=vmap.primary_cuisine_title
      and cuisine_wise_zone_order.order_month=vmap.month
left join cuisine_wise_country_vendor
       ON cuisine_wise_country_vendor.primary_cuisine_title=vmap.primary_cuisine_title  
      and cuisine_wise_country_vendor.month=vmap.month  
left join cuisine_wise_country_order
       ON cuisine_wise_country_order.primary_cuisine_title=vmap.primary_cuisine_title 
      and cuisine_wise_country_order.order_month=vmap.month 
left join overall_zone_order
       ON overall_zone_order.primary_zone_name=vmap.primary_zone_name
      and overall_zone_order.order_month=vmap.month
left join overall_zone_vendor
       ON overall_zone_vendor.primary_zone_name= vmap.primary_zone_name
      and overall_zone_vendor.month= vmap.month
left join overall_country_vendor
       on overall_country_vendor.global_entity_id= vmap.global_entity_id  
      and overall_country_vendor.month= vmap.month  
left join country_total_order 
       ON country_total_order.global_entity_id =vmap.global_entity_id 
      and country_total_order.order_month =vmap.month 
order by 1,2,3,4,5]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
