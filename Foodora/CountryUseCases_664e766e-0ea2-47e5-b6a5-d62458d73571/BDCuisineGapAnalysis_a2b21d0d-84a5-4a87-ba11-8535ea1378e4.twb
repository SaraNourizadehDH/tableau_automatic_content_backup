      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='cuisine_gap_analysis_BD_product_level' id='cuisine_gap_analysis_BD_product_level_947F5A0D60AF4810967F8ECA7F694843'>
            <properties context=''>
              <relation connection='bigquery.1gur8fh0hbhju212grrqp0effky2' name='Custom SQL Query' type='text'><![CDATA[WITH vmap AS(
  SELECT DISTINCT
  format_datetime("%Y%m", b.report_date) as month,
   b.vendor_code,
   vm.global_entity_id, 
   vm.cluster_name,
   vm.city_name,
   vm.primary_zone_name, 
   vm.primary_cuisine_title, 
  FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS b
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS vm 
          ON b.vendor_code = vm.vendor_code
  WHERE b.global_entity_id = 'FP_BD'
  AND b.is_active
  AND b.is_private IS FALSE
  AND b.is_test IS FALSE
  AND b.report_date between date_trunc(date_sub(current_date(), INTERVAL 60 day), month) and DATE_SUB(current_date(), INTERVAL 1 day)
  AND vm.business_type_apac IN ('restaurants')
  AND vm.cluster_name is not null
  and vm.primary_cuisine_title is not null
  ),

order_data as(
select distinct
  bdf.global_entity_id,   
  format_datetime("%Y%m", bdf.order_date) as order_month,
  vmap.cluster_name,
  vmap.city_name,
  vmap.primary_cuisine_title,
  vmap.primary_zone_name,  
  vmap.Vendor_code,
  bdf.order_date,  
  bdf.order_code,
  bdf.gfv_gross_local, 
  products.pd_product_id as product_id,
  products.title as order_product_title,
  products.quantity as quantity,
  
from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` as bdf
inner join vmap
       ON vmap.Vendor_code =bdf.vendor_code  
left join `fulfillment-dwh-production.pandata_curated.pd_orders` as po
        on po.code= bdf.order_code
       and po.global_entity_id ="FP_BD", unnest(products) as products       
where bdf.is_valid_order =true
and bdf.business_type_apac ="restaurants"
and bdf.order_date between date_trunc(date_sub(current_date(), INTERVAL 60 day), month) and DATE_SUB(current_date(), INTERVAL 1 day)
and po.created_date_utc between date_trunc(date_sub(current_date(), INTERVAL 60 day), month)-2 and DATE_SUB(current_date(), INTERVAL 1 day)
-- and po.code = "vyi8-wu5d"
),

top_product as (
  with a as(select
    order_month,
    cluster_name,
    city_name,
    Primary_Zone_name,
    primary_cuisine_title,
    product_id,
    order_product_title,
    SAFE_DIVIDE(sum(gfv_gross_local),count (distinct order_code)) as AFV_with_top_product,
    sum(quantity) as quantity,
    count (distinct order_code) as product_title_order_count,
    row_number() over (partition by Primary_Zone_name,order_month,primary_cuisine_title order by count(distinct order_code) desc) as rank
  from order_data 
  group by 1,2,3,4,5,6,7
  )
select * from a where rank <<11
),

cuisine_order_count as(
  select
    order_month,
    cluster_name,
    city_name,
    Primary_Zone_name,
    primary_cuisine_title,
    count (distinct order_code) as cuisine_order_count,
    SAFE_DIVIDE(sum(gfv_gross_local),count (distinct order_code)) as AFV_of_cuisine,
  from order_data 
  group by 1,2,3,4,5
),

zone_order_count as(
  select
    order_month,
    cluster_name,
    city_name,
    Primary_Zone_name,
    count (distinct order_code) as zone_order_count
  from order_data 
  group by 1,2,3,4
)


SELECT distinct
  top_product.order_month,
  vmap.cluster_name,
  vmap.city_name,
  vmap.primary_zone_name, 
  vmap.primary_cuisine_title,
  top_product.product_id,
  top_product.order_product_title,
  top_product.quantity,
  product_title_order_count,
  ROUND(AFV_with_top_product,2) as AFV_with_top_product,
  top_product.rank,
  cuisine_order_count.cuisine_order_count,
  ROUND(AFV_of_cuisine,2) as AFV_of_cuisine,
  zone_order_count.zone_order_count,
  -- pp.product_variation_price_local, 
from top_product
inner join vmap
        on top_product.primary_zone_name=vmap.primary_zone_name 
       and top_product.primary_cuisine_title=vmap.primary_cuisine_title 
       and top_product.order_month =vmap.month 
left join cuisine_order_count
       on cuisine_order_count.order_month =vmap.month
      and cuisine_order_count.primary_zone_name=vmap.primary_zone_name 
      and cuisine_order_count.primary_cuisine_title=vmap.primary_cuisine_title 
left join zone_order_count
       on zone_order_count.order_month =vmap.month
      and zone_order_count.primary_zone_name=vmap.primary_zone_name 
-- left join `foodpanda-bd-bigquery.datastudio_tableau_background_queries.product_and_price_info` as pp
--        on pp.product_id =top_product.product_id 
--       and pp.capture_date =current_date()-1
  order by primary_zone_name,primary_cuisine_title, rank]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Box Plot Sheet'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>City wise Cuisine Box Plot</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
