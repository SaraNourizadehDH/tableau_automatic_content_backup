            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Country - BD' schema='datastudio_tableau_background_queries' server-oauth='' username='ateeq.ur@foodpanda.com.bd' workgroup-auth-mode='prompt' />
