  <column caption='Dimension' datatype='string' name='[Measure Filter (copy)_1090785937600770049]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Measure Name (copy)_1090785937600860162]&#10;WHEN &quot;PSP Group&quot; THEN [payment_service_provider (group)]&#10;WHEN &quot;Card Type&quot; THEN [Calculation_3328230557660295168]&#10;WHEN &quot;Card Brand&quot; THEN [card_brand]&#10;WHEN &quot;Onus Status&quot; THEN [Calculation_4042895470749589504]&#10;WHEN &quot;Challenge Type&quot; THEN [challenge_type]&#10;WHEN &quot;Is Saved Card&quot; THEN STR([Calculation_3328230559168811013])&#10;WHEN &quot;SoftPos Acquirer Bank&quot; THEN [Calculation_2943383854156795904]&#10;WHEN &quot;Vertical&quot; THEN [Calculation_3834322549566615554]&#10;WHEN &quot;Nothing&quot; THEN NULL&#10;END' />
  </column>
  <column caption='Saved Card Rate ' datatype='real' default-format='p0.00%' name='[Online Card Rate (copy)_5948129222680457218]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and [Calculation_3328230559168811013]=1 and [status_name]&lt;&gt;&apos;67 - Incomplete order&apos;&#10;then [order_code] ELSE NULL END)&#10;/ &#10;COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and [status_name]&lt;&gt;&apos;67 - Incomplete order&apos;&#10;then [order_code] ELSE NULL END)' />
  </column>
  <column caption='Order Payment Method (parameter)' datatype='string' name='[Order Is Own Delivery (parameter) (copy)_590886364724187137]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Order Is Own Delivery (parameter) (copy)_590886365055098882]&#10;WHEN &quot;Order Payment Method Group&quot; THEN [Calculation_4675440112588468224]&#10;WHEN &quot;Nothing&quot; THEN &apos;Nothing&apos;&#10;END' />
  </column>
  <column caption='Order Total Value Local Calc' datatype='real' name='[Order Total Value Local  (copy)_1177128360220180482]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]: AVG([total_value_local])}' />
  </column>
  <column datatype='string' name='[Payment Vertical Parent (group)]' role='dimension' type='nominal'>
    <calculation class='categorical-bin' column='[Calculation_3121768602432532482]' new-bin='true'>
      <bin default-name='true' value='&quot;Food &amp; Local Shops&quot;'>
        <value>&quot;Food&quot;</value>
        <value>&quot;Local Shops&quot;</value>
      </bin>
    </calculation>
  </column>
  <column caption='AVG Platform Attempts Count' datatype='real' name='[Platform Attempts Count (copy)_5551812455448043522]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG([attempts_count])' />
  </column>
  <column caption='Is Security Violation' datatype='boolean' name='[Stolen Card Customer Code (copy)_3390506850249052164]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS(lower([alfred_transaction_error_message]),&apos;güvenlik ihlali&apos;) &#10;or CONTAINS(LOWER([alfred_transaction_error_message]),&apos;guvenlik ihlali&apos;)' />
  </column>
  <column caption='Is Locked Card' datatype='boolean' name='[Stolen Card Customer Code (copy)_3390506850249465861]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS(lower([alfred_transaction_error_message]),&apos;karta el koyunuz&apos;)&#10;Or&#10;CONTAINS(LOWER([alfred_transaction_error_message]),&apos;bloke&apos;)' />
  </column>
  <column caption='Fail Rate' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Success Rate (copy)_3746009729838915586]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and&#10;[parent_order_acceptance_status]=&apos;fail&apos; then [parent_order_id] END) / COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [parent_order_id] END)' />
  </column>
  <column caption='Acceptance Rate' datatype='real' name='[Success Rate (copy)_5782270080129851397]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos;&#10; and ([parent_order_acceptance_status]=&apos;recovery&apos; or&#10;[parent_order_acceptance_status]=&apos;success&apos;) then [parent_order_id] END) &#10;/ COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [parent_order_id] END)' />
  </column>
  <column caption='Vertical Type' datatype='string' name='[Vertical Parent (copy)_3834322549566767107]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IFNULL([alfred_vertical_type],[vertical_type])' />
  </column>
