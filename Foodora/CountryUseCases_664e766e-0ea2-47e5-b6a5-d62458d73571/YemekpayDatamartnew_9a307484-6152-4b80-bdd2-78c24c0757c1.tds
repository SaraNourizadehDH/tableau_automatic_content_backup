  <column caption='Error Group (Fraud Team)' datatype='string' name='[error_group (SE) (group)]' role='dimension' type='nominal'>
    <calculation class='categorical-bin' column='[alfred_transaction_error_message]' new-bin='true'>
      <bin default-name='false' value='&quot;3D Inconsistency&quot;'>
        <value>&quot;API&apos;den gelen 3D alanlar uyumsuz.&quot;</value>
        <value>&quot;API&apos;den gelen 3D alanlar uyumsuz. / 99&quot;</value>
        <value>&quot;Bank Server : Genel Banka Hatası..[API&apos;den gelen 3D alanlar uyumsuz.]&quot;</value>
        <value>&quot;Hatali 3D Secure islem tutari / 99&quot;</value>
        <value>&quot;Şifre Doğrulanamıyor./İletişim hatası..[PIN dogrulanamiyor.]&quot;</value>
      </bin>
      <bin default-name='false' value='&quot;Blocked/Restricted/Invalid Card&quot;'>
        <value>&quot;(-1): Başarısız. &lt;br /&gt;Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.&quot;</value>
        <value>&quot;(-1): Başarısız. &lt;br /&gt;Sinirli Card.&quot;</value>
        <value>&quot;(-1): Başarısız. 0058 POSa Izin Verilmeyen Islem&quot;</value>
        <value>&quot;(-1): Başarısız. 0063 G?venlik Ihlali&quot;</value>
        <value>&quot;(-1): Başarısız. 0078 G?venli Olmayan PIN&quot;</value>
        <value>&quot;(-1): Başarısız. Karta izin verilmeyen işlem&quot;</value>
        <value>&quot;(-1): Başarısız. Karta izin verilmeyen işlem&lt;br /&gt;Kart sahibine acik olmayan islem.&quot;</value>
        <value>&quot;(-1): Başarısız. Kisitli Kart&quot;</value>
        <value>&quot;(-1): Failed, Karta Izin Verilmeyen Islem&quot;</value>
        <value>&quot;(-1): Failed, Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.&quot;</value>
        <value>&quot;(-1): Failed, Onaylanmadi&quot;</value>
        <value>&quot;(-1): Failed, Sinirli Kart&quot;</value>
        <value>&quot;(-1): Kart kaydi yok.&quot;</value>
        <value>&quot;(-1): Kartınız e-ticaret işlemlerine kapalıdır. Bankanızı arayınız.&quot;</value>
        <value>&quot;(-1): Sinirli Card.&quot;</value>
        <value>&quot;(-1): Sinirli Kart (0062)&quot;</value>
        <value>&quot;(0305): Kart Non Secure İşleme Kapalıdır.&quot;</value>
