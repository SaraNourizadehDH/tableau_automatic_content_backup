  <aliases enabled='yes' />
  <column caption='AVG Purchase Amount' datatype='real' name='[AVG Order Count (copy)_293789518402924545]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([Order Total Value Local  (copy)_1177128360220180482])/ [Calculation_2892577609416015879]' />
  </column>
  <column caption='Alfred Balance Only Purch Amnt Calc' datatype='real' name='[Alfred Balance Card Balance Part Amnt Calc (copy)_3948882865094406145]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]:AVG([alfred_balance_only_purch_amnt])}' />
  </column>
  <column caption='Alfred Purchase Amount Eur Calc' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Alfred Purchase Amount Lc Calc (copy)_3834322549559394304]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [alfred_order_code]: AVG([alfred_purchase_amount_eur])}' />
  </column>
  <column caption='Refund Event Order Count' datatype='integer' name='[Calculation_1216464497571512321]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([refund_order_code])' />
  </column>
  <column caption='Refund Amount %' datatype='real' default-format='p0.00%' name='[Calculation_1216464497592700931]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum([Calculation_1754222463487328259])/sum([Calculation_2892577609328549888])' />
  </column>
  <column caption='Refund Source Type' datatype='string' name='[Calculation_1253900715022454784]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF CONTAINS([event_id],&apos;TopUp&apos;) then &apos;Refund to Wallet Top-Up&apos;&#10;ELSEIF  CONTAINS([event_id],&apos;Refund&apos;) then &apos;Refund to Source&apos;&#10;ELSE [event_id]&#10;END' />
  </column>
  <column caption='Alfred Balance Card Balance Part Amnt Calc' datatype='real' name='[Calculation_1253900715025940482]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]:AVG([alfred_balance_card_balance_part_amnt])}' />
  </column>
  <column caption='Order Date' datatype='date' name='[Calculation_1418070941763776513]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATE([created_date_local])' />
  </column>
  <column caption='Payment Type Group' datatype='string' name='[Calculation_142778190213009408]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [alfred_payment_mix]=&apos;Balance + Card&apos; Then &apos;Mix Payment&apos;&#10;ELSEIF [Calculation_4675440112588468224]=&apos;SoftPOS&apos; then &apos;Card on Delivery&apos;&#10;ELSE [Calculation_4675440112588468224]&#10;END' />
  </column>
  <column caption='Refund Event Count Refund Items' datatype='real' name='[Calculation_1513139144245899265]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [refund_order_code]: AVG([count_refund_items])}' />
  </column>
  <column caption='Refund Value Local Calc' datatype='real' name='[Calculation_1754222463487328259]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code], [event_timestamp]: AVG([refund_value_local])}' />
  </column>
  <column caption='Total Discounts Lc Calc' datatype='real' name='[Calculation_1786873571484827648]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]:AVG([total_discounts_lc])}' />
  </column>
  <column caption='Coupon Amount' datatype='real' name='[Calculation_1925851829031821312]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]: AVG([coupon_amount])}' />
  </column>
  <column caption='Discount Amount Calc' datatype='real' name='[Calculation_1993898384600354820]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Order Total Value Local  (copy)_1177128360220180482]-[products_total_local]- [delivery_fee_original_local]' />
  </column>
  <column caption='Is discount Used Order' datatype='boolean' name='[Calculation_1993898384615063557]' role='measure' type='nominal'>
    <calculation class='tableau' formula='[Calculation_1993898384600354820]&lt;0' />
  </column>
  <column caption='Discount Usage Rate' datatype='real' default-format='p0.00%' name='[Calculation_1993898384616624134]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IIF([Calculation_1993898384615063557],[order_code],NULL))/COUNTD([order_code])' />
  </column>
  <column caption='Discount Used Order Count' datatype='integer' name='[Calculation_1993898384629563401]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD( IF [Calculation_1993898384615063557] then [order_code] ELSE NULL END )' />
  </column>
  <column caption='Channel Group Filter' datatype='boolean' name='[Calculation_1998120543953825795]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[Calculation_3834322549566615554]=[Parameters].[Parameter 2]' />
  </column>
  <column caption='Order Payment Method Type (Edited for SoftPOS error)' datatype='string' name='[Calculation_2004031516041076736]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF TRIM([payment_method_type]) =&apos;balance&apos; THEN&#9;&apos;Wallet&apos;&#10;&#10;ELSEIF      TRIM([payment_method_type]) =&apos;cash&apos;&#10;        or (TRIM([payment_method_type]) =&apos;yemekpay_cardondelivery&apos;  and [is_own_delivery] and ISNULL([Calculation_2943383854156795904]))  THEN &apos;Cash&apos;&#10;&#10;ELSEIF     TRIM([payment_method_type]) =&apos;cio_card&apos; &#10;        or TRIM([payment_method_type]) =&apos;metropol_card&apos; &#10;        or TRIM([payment_method_type]) =&apos;multinet&apos; &#10;        or TRIM([payment_method_type]) =&apos;paye_card&apos; &#10;        or TRIM([payment_method_type]) =&apos;set_card&apos;&#10;        or TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass&apos;&#10;        or TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass_mobile&apos; &#10;        or TRIM([payment_method_type]) =&apos;ticket_restaurant_food_voucher&apos;&#10;        or TRIM([payment_method_type]) =&apos;ticket_restaurant_meal_card&apos; &#10;        or TRIM([payment_method_type]) =&apos;winwin_mobile&apos; &#10;        or TRIM([payment_method_type]) =&apos;yemekmatik_meal_card&apos; &#10;        or TRIM([payment_method_type]) =&apos;voucher_tokenflex&apos; THEN &apos;Food Check&apos;&#10;&#10;ELSEIF  (TRIM([payment_method_type]) =&apos;yemekpay_cardondelivery&apos; and [is_own_delivery] and not ISNULL([Calculation_2943383854156795904]))&#10;         or ([payment_service_provider]=&apos;YemekPay-PF-Card-On-Delivery&apos; and [is_own_delivery]) THEN &apos;SoftPOS&apos; &#10;&#10;ELSEIF      TRIM([payment_method_type]) =&apos;yemekpay_cardpayment&apos; &#10;         or TRIM([payment_method_type])=&apos;payment_on_delivery&apos; &#10;         or (TRIM([payment_method_type]) =&apos;yemekpay_cardondelivery&apos;  and not [is_own_delivery])&#10;         or (TRIM([payment_service_provider])=&apos;YemekPay-PF-Card-On-Delivery&apos;  and not [is_own_delivery])  THEN &apos;Card on Delivery&apos;&#10;&#10;ELSEIF  (TRIM([payment_method_type]) =&apos;yemekpay_creditcard&apos; or TRIM([payment_method_type]) =&apos;iyzico_yemeksepetipay&apos;) THEN &apos;Online Card&apos;&#10;&#10;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;no_payment&apos; THEN &apos;No Payment&apos;&#10;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;craftgate_edenred&apos;  &#10;     or TRIM([payment_method_type]) =&apos;multinet_mealcard&apos;&#10;     or TRIM([payment_method_type]) =&apos;pluxee_mealcard&apos;&#10; THEN &apos;Online Food Check&apos;&#10;ELSEIF TRIM([payment_method_type]) = &apos;iyzico_yemeksepetipay&apos; THEN &apos;Iyzico&apos;&#10;else [payment_method_type] END' />
  </column>
  <column caption='Basket Count' datatype='integer' name='[Calculation_2182275562385620999]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([parent_order_id])' />
  </column>
  <column caption='Is not yesterday' datatype='boolean' name='[Calculation_277182491872665600]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='DATE([created_date_local])&lt;&gt; TODAY()-1' />
  </column>
  <column caption='AOV' datatype='real' name='[Calculation_2891522111795605513]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([Order Total Value Local  (copy)_1177128360220180482])/ [Calculation_2892577609416015879]' />
  </column>
  <column caption='Alfred Purchase Amount Lc Calc' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2892577609328549888]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [alfred_order_code]: AVG([alfred_purchase_amount_lc])}' />
  </column>
  <column caption='Alfred Refunded Amount Lc Calc' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2892577609328709633]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [alfred_order_code]: AVG([alfred_refunded_amount_lc])}' />
  </column>
  <column caption='Refund Ratio' datatype='real' default-format='p0.00%' name='[Calculation_2892577609415331846]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([refund_order_code]) /COUNTD([order_code])' />
  </column>
  <column caption='Order Count' datatype='integer' name='[Calculation_2892577609416015879]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([order_code])' />
  </column>
  <column caption='Refund Type' datatype='string' default-type='ordinal' name='[Calculation_2892577609418657801]' role='measure' type='nominal'>
    <calculation class='tableau' formula='IF INT([Calculation_1754222463487328259])&lt;&gt; INT([Order Total Value Local  (copy)_1177128360220180482]) then &apos;Partial&apos;&#10;ELSEIF INT([Calculation_1754222463487328259])=INT([Order Total Value Local  (copy)_1177128360220180482]) then &apos;Full&apos;&#10;End' />
  </column>
  <column caption='Last Update Date' datatype='date' name='[Calculation_2907847674307923968]' role='measure' type='ordinal'>
    <calculation class='tableau' formula='MAX(DATE([created_date_local]))' />
  </column>
  <column caption='AVG Order Count' datatype='real' name='[Calculation_293789518402867200]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_2892577609416015879]/[Calculation_405675824185192449]' />
  </column>
  <column caption='SoftPos Acquirer Bank' datatype='string' name='[Calculation_2943383854156795904]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF  trim([acquirer_id_by_bank])=&apos;000046&apos; then &apos;Akbank&apos;&#10;ELSEIF trim([acquirer_id_by_bank])=&apos;000064&apos; then &apos;IsBank&apos;&#10;ELSEIF trim([acquirer_id_by_bank])=&apos;000062&apos; then &apos;Garanti&apos;&#10;ELSEIF trim([acquirer_id_by_bank])=&apos;000777&apos; then &apos;Yemekpay&apos;&#10;END' />
  </column>
  <column caption='Payment Vertical Parent' datatype='string' name='[Calculation_3121768602432532482]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF TRIM(IFNULL([payment_vertical],[Vertical Parent (copy)_3834322549566767107]))=&apos;darkstores&apos; then &apos;Dmarts&apos;&#10;ELSEIF  TRIM(IFNULL([payment_vertical],[Vertical Parent (copy)_3834322549566767107]))=&apos;restaurants&apos; then &apos;Food&apos;&#10;ELSEIF  TRIM(IFNULL([payment_vertical],[Vertical Parent (copy)_3834322549566767107]))&lt;&gt;&apos;restaurants&apos; or&#10;        TRIM(IFNULL([payment_vertical],[Vertical Parent (copy)_3834322549566767107]))&lt;&gt;&apos;darkstores&apos;&#10;then &apos;Local Shops&apos;&#10;END' />
  </column>
  <column caption='TimeFrame Selector' datatype='string' name='[Calculation_3289316603179847683]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;Daily&apos; THEN STR(DATE([created_at_local]))&#10;    WHEN &apos;Weekly&apos; THEN STR(YEAR([created_at_local])) + &quot; &quot; + STR(WEEK([created_at_local]))&#10;    WHEN &apos;Monthly&apos; THEN STR(YEAR([created_at_local])) + &quot; &quot; + STR(MONTH([created_at_local]))&#10;    WHEN &apos;Yearly&apos; THEN STR(YEAR([created_at_local]))&#10;    WHEN &apos;Weekday&apos; THEN DATENAME(&apos;weekday&apos;, [created_at_local])&#10;    WHEN &apos;Quarterly&apos; THEN STR(YEAR([created_at_local])) + &quot; Q&quot; + STR(DATEPART(&apos;quarter&apos;, [created_at_local]))&#10;END' />
  </column>
  <column caption='Card Type' datatype='string' name='[Calculation_3328230557660295168]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [card_category]=&apos;PREPAID&apos; then &apos;prepaid&apos;&#10;ELSE LOWER([card_type]) &#10;END' />
  </column>
  <column caption='Is Saved Card' datatype='integer' name='[Calculation_3328230559168811013]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF [payment_method_type]=&apos;yemekpay_creditcard&apos; Then&#10;   IF &#10;    CONTAINS([payment_service_provider],&apos;mastercard&apos;)  &#10;    or ([payment_service_provider]=&apos;masterpass_garanti&apos; and [business_contract_id]=24140210001) &#10;    or ([payment_service_provider]=&apos;masterpass_isbank&apos; and [business_contract_id]=24100210001) &#10;    or ([payment_service_provider]=&apos;masterpass_ziraat&apos; and [business_contract_id]=24180210001) &#10;    or ([payment_service_provider]=&apos;masterpass_akbank&apos; and [business_contract_id]=24220210001) &#10;    or ([payment_service_provider]=&apos;masterpass_yapikredi&apos; and [business_contract_id]=24260210001)&#10;    or ([payment_service_provider]=&apos;masterpass_param&apos; and [business_contract_id]=26080210001)&#10;    or ([payment_service_provider]=&apos;masterpass_sipay&apos; and [business_contract_id]=27400210001)&#10;    or ([payment_service_provider]=&apos;masterpass_yemekpay&apos; and [business_contract_id]=28430210001)&#10;    then 1 &#10;    ELSE 0&#10;    END&#10;ELSE NULL&#10;END' />
  </column>
  <column caption='Is Stolen Card' datatype='boolean' name='[Calculation_3390506850248736771]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS(LOWER([alfred_transaction_error_message]),&apos;çalıntı kart&apos;) &#10;or CONTAINS(LOWER([alfred_transaction_error_message]),&apos;calinti kart&apos;)' />
  </column>
  <column caption='Is Customer Related any Fraud Case' datatype='boolean' name='[Calculation_3390506850256982028]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[Is Suspected Fraud (copy)_3390506850251771914] &#10;or [Stolen Card Customer Code (copy)_3390506850249465861] &#10;or [Is Stolen Card (copy)_3390506850249859078] &#10;or [Is Suspected Fraud (copy)_3390506850251354121] &#10;or [Is Stolen Card (copy)_3390506850250362887] &#10;or [Stolen Card Customer Code (copy)_3390506850249052164]&#10;or [Calculation_3390506850248736771] &#10;or [Is Stolen Card (copy)_3390506850250969096]' />
  </column>
  <column caption='Success Rate' datatype='real' name='[Calculation_3746009729837420545]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and&#10;[parent_order_acceptance_status]=&apos;success&apos; then [parent_order_id] END) / COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [parent_order_id] END)' />
  </column>
  <column caption='Vertical Parent' datatype='string' name='[Calculation_3834322549566615554]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IFNULL([alfred_vertical_parent],[vertical_parent])' />
  </column>
  <column caption='Products Total Local Calc' datatype='real' name='[Calculation_3948882865095585794]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]:AVG([products_total_local])}' />
  </column>
  <column caption='Delivery Fee Original Local Calc' datatype='real' name='[Calculation_3948882865095757827]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]: AVG([delivery_fee_original_local])}' />
  </column>
  <column caption='Calculated Total Local Calc' datatype='real' name='[Calculation_3948882865144049670]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]:AVG([calculated_total_local])}' />
  </column>
  <column caption='Coupon Amount Calc' datatype='real' name='[Calculation_3948882865145716744]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]: AVG([coupon_amount])}' />
  </column>
  <column caption='On-us Status' datatype='string' name='[Calculation_4042895470749589504]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF (CONTAINS([payment_service_provider],&apos;garanti&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;GARANTİ&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;garanti&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;GARANTI&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;isbank&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;İŞ BANKASI&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;isbank&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;IS BANK&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;ziraat&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;ZİRAAT&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;ziraat&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;ZIRAAT&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;akbank&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;AKBANK&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;yapikredi&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;YAPI VE KREDİ&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;yapikredi&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;YAPI VE KREDI&apos;))&#10;or (CONTAINS([payment_service_provider],&apos;yapikredi&apos;) and CONTAINS(TRIM([Calculation_6895714736591736832]),&apos;YAPI KREDI&apos;))&#10;then &apos;same bank&apos;&#10;ELSEIF not ISNULL([on_us_card_bin]) &#10;then &apos;on-us&apos;&#10;ELSE &apos;not on-us&apos; END' />
  </column>
  <column caption='This Month' datatype='boolean' name='[Calculation_405675824146935808]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='YEAR([created_at_local]) = YEAR(TODAY())&#10;and &#10;MONTH([created_at_local]) = MONTH(TODAY())' />
  </column>
  <column caption='Customer Count' datatype='integer' name='[Calculation_405675824185192449]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([customer_code])' />
  </column>
  <column caption='Vendor Count' datatype='integer' name='[Calculation_405675824185401346]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([vendor_code])' />
  </column>
  <column caption='Measure Filter' datatype='real' name='[Calculation_4510003209457766401]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Parameters].[TimeFrame (copy)_4510003209457405952 1]&#10;WHEN &quot;Order Count&quot; THEN [Calculation_2892577609416015879]&#10;WHEN &quot;Customer Count&quot; THEN [Calculation_405675824185192449]&#10;WHEN &quot;Purchase Amount&quot; THEN SUM([Order Total Value Local  (copy)_1177128360220180482])&#10;WHEN &quot;Vendor Count&quot; THEN [Calculation_405675824185401346]&#10;END' />
  </column>
  <column caption='Order Payment Method Type Group' datatype='string' name='[Calculation_4675440112588468224]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF TRIM([payment_method_type]) =&apos;balance&apos; THEN&#9;&apos;Wallet&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;cash&apos; THEN &apos;Cash&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;cio_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;metropol_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;multinet&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;paye_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;set_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;sodexo_restaurant_pass_mobile&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_food_voucher&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;ticket_restaurant_meal_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;winwin_mobile&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;yemekmatik_meal_card&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  (TRIM([payment_method_type]) =&apos;yemekpay_cardpayment&apos; or TRIM([payment_method_type])=&apos;payment_on_delivery&apos;) THEN &apos;Card on Delivery&apos;&#10;ELSEIF  (TRIM([payment_method_type]) =&apos;yemekpay_creditcard&apos; or TRIM([payment_method_type]) =&apos;iyzico_yemeksepetipay&apos;) THEN &apos;Online Card&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;no_payment&apos; THEN &apos;No Payment&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;voucher_tokenflex&apos; THEN &apos;Food Check&apos;&#10;ELSEIF  TRIM([payment_method_type]) =&apos;yemekpay_cardondelivery&apos;  THEN &apos;SoftPOS&apos; &#10;ELSEIF  TRIM([payment_method_type]) =&apos;craftgate_edenred&apos;  or  TRIM([payment_method_type]) =&apos;multinet_mealcard&apos;&#10;       or  TRIM([payment_method_type]) =&apos;pluxee_mealcard&apos;&#10; THEN &apos;Online Food Check&apos;&#10;ELSEIF TRIM([payment_method_type]) = &apos;iyzico_yemeksepetipay&apos; THEN &apos;Iyzico&apos;&#10;else [payment_method_type] END' />
  </column>
  <column caption='Error Group' datatype='string' name='[Calculation_5277304038223355908]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF ISNULL([alfred_transaction_error_message]) then  [decline_reason_title]&#10;ELSE [alfred_transaction_error_message]&#10;END' />
  </column>
  <column caption='Coupon %' datatype='real' default-format='p0.00%' name='[Calculation_5321073347137495040]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([Calculation_1993898384629563401]/[Calculation_2892577609416015879])' />
  </column>
  <column caption='Parent Order Count' datatype='integer' name='[Calculation_5551812455445962753]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([parent_order_id])' />
  </column>
  <column caption='3DS / CVV Rate' datatype='real' name='[Calculation_5782270080129282051]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF not ISNULL([challenge_type]) then [order_code] ELSE NULL END)/ &#10;COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [order_code] ELSE NULL END)' />
  </column>
  <column caption='Delivery Fee Local Calc' datatype='real' name='[Calculation_6091611091918290945]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]: AVG([delivery_fee_local])}' />
  </column>
  <column caption='Region' datatype='string' name='[Calculation_6770810227971653632]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;adana&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;adıyaman&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;afyonkarahisar&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;ağrı&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;amasya&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;ankara&apos; Then &apos;Ankara&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;antalya&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;artvin&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;aydın&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;balıkesir&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;bilecik&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;bingöl&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;bitlis&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;bolu&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;burdur&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;bursa&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;çanakkale&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;çankırı&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;çorum&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;denizli&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;diyarbakır&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;edirne&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;elazığ&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;erzincan&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;erzurum&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;eskişehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;gaziantep&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;giresun&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;gümüşhane&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;hakkari&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;hatay&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;isparta&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;mersin&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;i̇stanbul&apos; Then &apos;İstanbul&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;i̇zmir&apos; Then &apos;İzmir&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kars&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kastamonu&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kayseri&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kırklareli&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kırşehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kocaeli&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;konya&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kütahya&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;malatya&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;manisa&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kahramanmaraş&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;mardin&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;muğla&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;muş&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;nevşehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;niğde&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;ordu&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;rize&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;sakarya&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;samsun&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;siirt&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;sinop&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;sivas&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;tekirdağ&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;tokat&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;trabzon&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;tunceli&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;şanlıurfa&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;uşak&apos; Then &apos;Ege Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;van&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;yozgat&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;zonguldak&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;aksaray&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;bayburt&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;karaman&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kırıkkale&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;batman&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;şırnak&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;bartın&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;ardahan&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;iğdır&apos; Then &apos;Doğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;yalova&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;karabük&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kilis&apos; Then &apos;Güneydoğu Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;osmaniye&apos; Then &apos;Akdeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;düzce&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;tekirdag&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kktc&apos; Then &apos;KKTC&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kirsehir&apos; Then &apos;İç Anadolu Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;kirklareli&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;izmir&apos; Then &apos;İzmir&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;istanbul&apos; Then &apos;İstanbul&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;corum&apos; Then &apos;Karadeniz Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;balikesir&apos; Then &apos;Marmara Bölgesi&apos;&#10;ELSEIF TRIM(LOWER(IFNULL([city], [delivery_address_city])))=&apos;aydin&apos; Then &apos;Ege Bölgesi&apos;&#10;END' />
  </column>
  <column caption='Count Customer IP Address' datatype='integer' default-format='N' name='[Calculation_6840616011725230080]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([customer_ip_address])' />
  </column>
  <column caption='Issuer Bank Name ' datatype='string' name='[Calculation_6895714736591736832]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[issuing_organization]' />
  </column>
  <column caption='Order Created Date' datatype='date' name='[Calculation_720435259646189568]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='DATE([created_at_local])' />
  </column>
  <column caption='Issuer Bank Name / YD' datatype='string' name='[Calculation_982206968567238656]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF IFNULL([card_bin],[alfred_bin]) =&apos;526911&apos; or IFNULL([card_bin],[alfred_bin])=&apos;535177&apos; then &apos;ENPARA&apos;&#10;ELSEIF [issuing_country]=&apos;TURKEY&apos; then [Calculation_6895714736591736832]&#10;ELSEIF [issuing_country]&lt;&gt;&apos;TURKEY&apos; then &apos;Yurtdışı Kartları&apos;&#10;ELSE [Calculation_6895714736591736832] END' />
  </column>
  <column caption='Dimension 3' datatype='string' name='[Dimension 2 (copy)_1088674889689821184]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Dimension 2 (copy)_1088674889689886721]&#10;WHEN &quot;PSP Group&quot; THEN [payment_service_provider (group)]&#10;WHEN &quot;Card Type&quot; THEN [Calculation_3328230557660295168]&#10;WHEN &quot;Card Brand&quot; THEN [card_brand]&#10;WHEN &quot;Onus Status&quot; THEN [Calculation_4042895470749589504]&#10;WHEN &quot;Challenge Type&quot; THEN [challenge_type]&#10;WHEN &quot;Is Saved Card&quot; THEN STR([Calculation_3328230559168811013])&#10;WHEN &quot;Issuer Bank&quot; THEN [Issuer Bank Name / YD (group)]&#10;WHEN &quot;Card BinNumber&quot; THEN STR(IFNULL([card_bin],[alfred_bin]))&#10;WHEN &quot;SoftPos Acquirer Bank&quot; THEN [Calculation_2943383854156795904]&#10;WHEN &quot;Vertical&quot; THEN [Calculation_3834322549566615554]&#10;WHEN &quot;Nothing&quot; THEN NULL&#10;END' />
  </column>
  <column caption='Dimension 2' datatype='string' name='[Dimension Filter (copy)_1379086650932850691]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy)_1379086650938589189]&#10;WHEN &quot;PSP Group&quot; THEN [payment_service_provider (group)]&#10;WHEN &quot;Card Type&quot; THEN [Calculation_3328230557660295168]&#10;WHEN &quot;Card Brand&quot; THEN [card_brand]&#10;WHEN &quot;Onus Status&quot; THEN [Calculation_4042895470749589504]&#10;WHEN &quot;Challenge Type&quot; THEN [challenge_type]&#10;WHEN &quot;Is Saved Card&quot; THEN STR([Calculation_3328230559168811013])&#10;WHEN &quot;Issuer Bank&quot; THEN [Issuer Bank Name / YD (group)]&#10;WHEN &quot;Card BinNumber&quot; THEN STR(IFNULL([card_bin],[alfred_bin]))&#10;WHEN &quot;SoftPos Acquirer Bank&quot; THEN [Calculation_2943383854156795904]&#10;WHEN &quot;Vertical&quot; THEN [Calculation_3834322549566615554]&#10;WHEN &quot;Nothing&quot; THEN NULL&#10;END' />
  </column>
  <column caption='Recovery Rate' datatype='real' name='[Fail Rate (copy)_3746009729840168963]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; and &#10;[parent_order_acceptance_status]=&apos;recovery&apos; then [parent_order_id] END) /COUNTD(IF [payment_method_type]=&apos;yemekpay_creditcard&apos; then [parent_order_id] END)' />
  </column>
  <column caption='AOF' datatype='real' name='[Frequency (copy)_585679062769635328]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_2892577609416015879]/ [Calculation_405675824185192449]' />
  </column>
  <column caption='Is Lost Card ' datatype='boolean' name='[Is Stolen Card (copy)_3390506850249859078]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS([alfred_transaction_error_message],&apos;Kayıp Kart&apos;)' />
  </column>
  <column caption='Is Restricted Card' datatype='boolean' name='[Is Stolen Card (copy)_3390506850250362887]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS(lower([alfred_transaction_error_message]),&apos;kısıtlı kart&apos;)&#10;OR &#10;CONTAINS(lower([alfred_transaction_error_message]),&apos;engellenmistir&apos;)&#10;OR &#10;CONTAINS(lower([alfred_transaction_error_message]),&apos;sinirli&apos;)' />
  </column>
  <column caption='Is Suspected Fraud' datatype='boolean' name='[Is Stolen Card (copy)_3390506850250969096]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS(LOWER([alfred_transaction_error_message]),&apos;dolandırıcılık şüphesi&apos;)&#10;OR &#10;CONTAINS(LOWER([alfred_transaction_error_message]),&apos;fraud&apos;)' />
  </column>
  <column caption='Is Over the Limit' datatype='boolean' name='[Is Suspected Fraud (copy)_3390506850251354121]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS(LOWER([alfred_transaction_error_message]),&apos;limiti aşıldı&apos;)' />
  </column>
  <column caption='Is Insufficient Limit' datatype='boolean' name='[Is Suspected Fraud (copy)_3390506850251771914]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS(LOWER([alfred_transaction_error_message]),&apos;limit yetersiz&apos;)' />
  </column>
