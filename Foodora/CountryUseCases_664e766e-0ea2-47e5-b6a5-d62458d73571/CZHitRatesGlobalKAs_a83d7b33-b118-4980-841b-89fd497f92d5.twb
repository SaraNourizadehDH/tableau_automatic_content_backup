          <calculation column='[AFV (basket) (copy)_1686879555394957349]' formula='AVG(CASE [is_valid_order] WHEN TRUE&#13;&#10;THEN [total_value_local]+ [voucher_value_local] - [df_user_paid_incl_vat_local]- [difference_to_minimum_order_value_plus_vat_local] - [service_fee_plus_vat_local] - [rider_tip_plus_vat_local] &#13;&#10;end )' />
