        <calculations>
          <calculation column='[# OD orders (copy)_1686879555376111635]' formula='count(IF [is_valid_order] = TRUE&#13;&#10;AND [delivery_type] = &quot;Own Delivery&quot;&#13;&#10;AND [order_delay_mins] &gt; 0&#13;&#10;THEN [order_uuid] END)' />
