          <calculation column='[# orders with voucher (copy)_997547339552108546]' formula='count(IF [is_valid_order] = TRUE&#13;&#10;AND [is_subscriber_order] = TRUE&#13;&#10;THEN [order_uuid] END)' />
          <calculation column='[# preorders (copy)_4562427957434273792]' formula='count(IF [is_valid_order] = true and [source (customers)] = &quot;b2b&quot; &#13;&#10;then [order_uuid] end)' />
          <calculation column='[# rated orders (copy)_997547339634987025]' formula='COUNT([rider_score])' />
