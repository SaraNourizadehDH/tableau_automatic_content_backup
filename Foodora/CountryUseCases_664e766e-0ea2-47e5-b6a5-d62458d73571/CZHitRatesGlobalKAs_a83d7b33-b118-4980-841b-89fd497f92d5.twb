          <calculation column='[Calculation_4562427957434957825]' formula='IF [source (customers)]= &quot;b2b&quot; then true else false end' />
          <calculation column='[Calculation_4562427957446524931]' formula='CASE [Parameters].[Parameter 1001]&#13;&#10;WHEN &quot;Vertical&quot; Then [vertical]&#13;&#10;WHEN &quot;Delivery Type&quot; Then [delivery_type]&#13;&#10;WHEN &quot;Payment Type&quot; Then [payment_type]&#13;&#10;WHEN &quot;Source&quot; Then [source]&#13;&#10;WHEN &quot;Local Chain&quot; Then [local_chain]&#13;&#10;WHEN &quot;Is Subscriber Order&quot; Then STR([is_subscriber_order])&#13;&#10;WHEN &quot;Is Subscription Order&quot; Then STR([is_subscription_order])&#13;&#10;WHEN &quot;City&quot; then [vendor_city]&#13;&#10;WHEN &quot;Total&quot; Then &quot;Total&quot;&#13;&#10;END' />
          <calculation column='[Calculation_6854197211033382912]' formula='DATE(CASE [Parameters].[Parameter 1000]&#13;&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[created_at_local])&#13;&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[created_at_local],&apos;monday&apos;)&#13;&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[created_at_local])&#13;&#10;END)' />
          <calculation column='[Calculation_779404253388582912]' formula='sum(&#13;&#10;IF [is_billable] = TRUE&#13;&#10;then IFNULL([commission_revenue_local], [estimated_commission_revenue_local]) end )' />
