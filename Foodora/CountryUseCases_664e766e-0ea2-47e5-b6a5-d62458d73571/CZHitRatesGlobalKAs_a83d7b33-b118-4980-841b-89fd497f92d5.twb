          <calculation column='[# vendors with order (copy)_997547339560173575]' formula='COUNTD(IF [is_valid_order] = TRUE&#13;&#10;AND  [is_discount_used]&#13;&#10;and  [is_evergreen] = FALSE&#13;&#10;THEN [pd_vendor_uuid] END)' />
          <calculation column='[% Commission Rate (Comissionable Value Based) (copy)_779404253389611011]' formula='[Calculation_779404253388582912]&#13;&#10;/&#13;&#10;[GMV (User Paid Amount) (copy)_1686879555388239900]' />
          <calculation column='[% Commission Rate (GFV Based) (copy)_779404253389803524]' formula='[Calculation_779404253388582912]&#13;&#10;/&#13;&#10;[# successful orders (copy)_1686879555366772739]' />
          <calculation column='[% add to cart (copy)_997547339808448533]' formula='SUM([count_of_shop_menu_loaded]) / SUM([count_of_shop_list_loaded])' />
          <calculation column='[% delay &gt; 10 min (copy)_1686879555376893974]' formula='[# OD orders (copy)_1686879555376111635] / [# successful orders (copy)_1686879555368538122]' />
