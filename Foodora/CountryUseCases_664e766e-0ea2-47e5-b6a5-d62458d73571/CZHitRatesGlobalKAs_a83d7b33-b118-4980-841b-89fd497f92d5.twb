          <calculation column='[Calculation_385339268615516160]' formula='MIN(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[created_at_local])))))' />
          <calculation column='[Calculation_385339268615630849]' formula='COUNTD(IF DATE([created_at_local]) &lt; TODAY() then DATE([created_at_local]) end)' />
