          <calculation column='[# acquisitions (platform) (copy)_1686879555368255497]' formula='count(IF [is_valid_order] = TRUE &#13;&#10;AND [is_preorder] = true&#13;&#10;THEN [order_uuid] END)' />
          <calculation column='[# active customers (copy)_1686879555370127374]' formula='COUNTD(IF [is_valid_order] = TRUE&#13;&#10;THEN [central_analytical_customer_id] END)' />
