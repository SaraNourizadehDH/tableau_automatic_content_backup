            <column caption='Non RAF Leads' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1280711191774027779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [utm_source] &lt;&gt; &apos;raf&apos; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Applicants' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1378101544396234753]' role='measure' type='quantitative' visual-totals='Sum'>
