&#13;
SELECT&#13;
  DATETIME(applicants.created_at, applicants.timezone) AS created_at_local,&#13;
  DATE(DATETIME(applicants.created_at, applicants.timezone)) AS created_date_local,&#13;
  EXTRACT(ISOWEEK FROM DATETIME(applicants.created_at, applicants.timezone)) AS week,&#13;
  applicants.country_code,&#13;
  applicants.location_id AS applicant_location_id,&#13;
  SPLIT(applicants.location_id, &apos;:&apos;)[SAFE_OFFSET(1)] AS city_name,&#13;
  applicants.applicant_id AS applicant_id,&#13;
  CASE&#13;
  WHEN utm_source IN (&apos;raf&apos;) THEN &apos;raf&apos;&#13;
  ELSE &apos;non_raf&apos;&#13;
  END AS raf_flag,&#13;
  applicants.applicant_name AS name,&#13;
  applicant_gender.gender,&#13;
  applicants.applicant_email AS email,&#13;
&#13;
&#13;
  SUBSTR(REPLACE(applicants.applicant_phone_number, &apos;+&apos;, &apos;&apos;), -10) AS phone_number,&#13;
&#13;
&#13;
  applicants.location_id AS applicant_location_id2,&#13;
  applicants.rejected_by,&#13;
  DATETIME(applicants.rejected_at, applicants.timezone) AS rejected_at_local,&#13;
  DATETIME(applicants.approved_at, applicants.timezone) AS approved_at_local,&#13;
  applicants.rider_id AS rooster_id,&#13;
workflow_stage.workflow_name,&#13;
  workflow_stage.workflow_stage_name,&#13;
  applicant_onboarded_by.onboarded_by,&#13;
  applicant_vehicle_type.vehicle_type,&#13;
  applicant_utm_source.utm_source,&#13;
  applicant_utm_content.utm_content,&#13;
  applicant_workwear_size.workwear_size,&#13;
  applicant_data_consent.data_consent,&#13;
  applicant_id_upload.id_upload,&#13;
  applicant_license_upload.license_upload,&#13;
  applicant_id_number.id_number,&#13;
  utm_campaign.utm_campaign&#13;
 &#13;
FROM `fulfillment-dwh-production.curated_data_shared.applicants` AS applicants&#13;
LEFT JOIN workflow_stage&#13;
  ON applicants.applicant_id = workflow_stage.applicant_id&#13;
LEFT JOIN applicant_onboarded_by&#13;
  ON applicants.applicant_id = applicant_onboarded_by.applicant_id&#13;
LEFT JOIN applicant_workwear_size&#13;
  ON applicants.applicant_id = applicant_workwear_size.applicant_id&#13;
LEFT JOIN applicant_data_consent&#13;
  ON applicants.applicant_id = applicant_data_consent.applicant_id&#13;
LEFT JOIN applicant_vehicle_type&#13;
  ON applicants.applicant_id = applicant_vehicle_type.applicant_id&#13;
LEFT JOIN applicant_utm_source&#13;
  ON applicants.applicant_id = applicant_utm_source.applicant_id&#13;
LEFT JOIN applicant_utm_content&#13;
  ON applicants.applicant_id = applicant_utm_content.applicant_id&#13;
LEFT JOIN applicant_id_upload&#13;
  ON applicants.applicant_id = applicant_id_upload.applicant_id&#13;
LEFT JOIN applicant_license_upload&#13;
  ON applicants.applicant_id = applicant_license_upload.applicant_id&#13;
LEFT JOIN applicant_id_number &#13;
  ON applicants.applicant_id = applicant_id_number.applicant_id&#13;
LEFT JOIN applicant_gender &#13;
  ON applicants.applicant_id = applicant_gender.applicant_id&#13;
LEFT JOIN utm_campaign &#13;
  ON applicants.applicant_id = utm_campaign.applicant_id&#13;
WHERE applicants.region = &apos;ap&apos;&#13;
  AND applicants.country_code = &apos;pk&apos;&#13;
  AND DATE(applicants.created_at) &gt;&gt; &apos;2024-08-11&apos;&#13;
  AND applicants.location_id IN (&apos;pk:karachi:karachi&apos;,&apos;pk:islamabad:islamabad&apos;,&apos;pk:lahore:lahore&apos;,&apos;pk:islamabad:rawalpindi&apos;)&#13;
&#13;
-- ORDER BY 1, 2, 3, 4 DESC</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
