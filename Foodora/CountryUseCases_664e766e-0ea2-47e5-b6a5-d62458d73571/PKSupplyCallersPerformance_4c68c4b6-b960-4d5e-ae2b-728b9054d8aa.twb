        <calculation class='tableau' formula='CASE [Email Address (Form Responses 11)]&#13;&#10;WHEN &apos;anam.pirzada.ext@foodpanda.pk&apos; THEN &apos;Anam Pirzada&apos;&#13;&#10;WHEN &apos;rubab.mirza.ext@foodpanda.pk&apos; THEN &apos;Rubab Mirza&apos;&#13;&#10;WHEN &apos;faraz.iqbal@foodpanda.pk&apos; THEN &apos;Faraz Iqbal&apos;&#13;&#10;WHEN &apos;muhammad.balaj.ext@foodpanda.pk&apos; THEN &apos;Muhammad Balaj&apos;&#13;&#10;WHEN &apos;nayab.bashir.ext@foodpanda.pk&apos; THEN &apos;Nayab Bashir&apos;&#13;&#10;WHEN &apos;sana.rafaqat.ext@foodpanda.pk&apos; THEN &apos;Sana Rafaqat&apos;&#13;&#10;WHEN &apos;mohsin.shahid_ibexfppkrs.ext@foodpanda.com&apos; THEN &apos;Mohsin Shahid - IBEX&apos;&#13;&#10;WHEN &apos;aun.hussain_ibexfppk.ext@foodpanda.com&apos; THEN &apos;Aun Hussain - IBEX&apos;&#13;&#10;WHEN &apos;nouman.sadiq_ibexfppkrs.ext@foodpanda.com&apos; THEN &apos;Nouman Sadiq - IBEX&apos;&#13;&#10;ELSE [Email Address (Form Responses 11)]&#13;&#10;END' />
      </column>
      <column caption='Arara Leads Calls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1280711191752708097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Purpose of Call made? (Form Responses 11)] = &apos;Arara Leads Conversion&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1280711191752998914]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([Timestamp (Form Responses 11)])' />
      </column>
      <column caption='Non RAF Leads' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1280711191774027779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [utm_source] &lt;&gt; &apos;raf&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Applicants' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1378101544396234753]' role='measure' type='quantitative' visual-totals='Sum'>
        <calculation class='tableau' formula='COUNT([applicant_id (Custom SQL Query1)])' />
      </column>
      <column caption='Applicants Contacted' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1378101544396603394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Purpose of Call made? (Form Responses 11)] = &apos;Arara Leads Conversion&apos; &#13;&#10;    AND [Calling Attempt? (Form Responses 11)] = 1 &#13;&#10;    THEN [Phone number (tableau) (Form Responses 11)] ELSE NULL END&#13;&#10;)' />
      </column>
      <column caption='Contact Rate' datatype='real' default-format='p0.0%' name='[Calculation_1378101544397176835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1378101544396603394]/[Calculation_1378101544396234753]' />
      </column>
      <column caption='Response Time (minutes)' datatype='integer' name='[Calculation_231935428602290176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Purpose of Call made? (Form Responses 11)] = &apos;Arara Leads Conversion&apos; &#13;&#10;AND [Calling Attempt? (Form Responses 11)] = 1 &#13;&#10;AND [Phone number (tableau) (Form Responses 11)] = [phone_number] THEN&#13;&#10;    DATEDIFF(&apos;minute&apos;, [created_at_local], [Timestamp (Form Responses 11)])&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='Response Time (hrs)' datatype='real' name='[Calculation_231935428602441729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_231935428602290176] / 60 &lt; 0 THEN 2 &#13;&#10;ELSE [Calculation_231935428602290176] / 60 &#13;&#10;END' />
      </column>
      <column caption='Activation Calls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_231935428603281410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Purpose of Call made? (Form Responses 11)] = &apos;Activation Call&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='100T Calls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_231935428603424771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Purpose of Call made? (Form Responses 11)] = &apos;100T Improvement Call&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Total Calls' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_231935428603588612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Email Address (Form Responses 11)])' />
      </column>
      <column caption='Caller City' datatype='string' name='[Calculation_231935428613120005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Email Address (Form Responses 11)]&#13;&#10;WHEN &apos;anam.pirzada.ext@foodpanda.pk&apos; THEN &apos;karachi&apos;&#13;&#10;WHEN &apos;rubab.mirza.ext@foodpanda.pk&apos; THEN &apos;karachi&apos;&#13;&#10;WHEN &apos;faraz.iqbal@foodpanda.pk&apos; THEN &apos;karachi&apos;&#13;&#10;WHEN &apos;muhammad.balaj.ext@foodpanda.pk&apos; THEN &apos;karachi&apos;&#13;&#10;WHEN &apos;nayab.bashir.ext@foodpanda.pk&apos; THEN &apos;lahore&apos;&#13;&#10;WHEN &apos;sana.rafaqat.ext@foodpanda.pk&apos; THEN &apos;lahore&apos;&#13;&#10;WHEN &apos;muhammad.annas_ibexfppkcs.ext@foodpanda.com&apos; THEN &apos;lahore&apos;&#13;&#10;WHEN &apos;raana.sehar_ibexfppkrs.ext@foodpanda.com&apos; THEN &apos;lahore&apos;&#13;&#10;WHEN &apos;mohsin.shahid_ibexfppkrs.ext@foodpanda.com&apos; THEN &apos;lahore&apos;&#13;&#10;WHEN &apos;aun.hussain_ibexfppk.ext@foodpanda.com&apos; THEN &apos;islamabad&apos;&#13;&#10;WHEN &apos;nouman.sadiq_ibexfppkrs.ext@foodpanda.com&apos; THEN &apos;islamabad&apos;&#13;&#10;WHEN &apos;kinza.francis_ibexfppkrs.ext@foodpanda.com&apos; THEN &apos;lahore&apos;&#13;&#10;&#13;&#10;ELSE [Email Address (Form Responses 11)]&#13;&#10;END' />
      </column>
      <column caption='Conversion Rate' datatype='real' default-format='p0.0%' name='[Calculation_711287276044394496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rooster_id])/[Calculation_1378101544396234753]' />
      </column>
      <column caption='Leads CVR %' datatype='real' default-format='p0.0%' name='[Calculation_711287276045217793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [raf_flag] = &apos;non_raf&apos; THEN [rooster_id] END)/COUNTD(IF [raf_flag] = &apos;non_raf&apos; THEN [applicant_id] END)' />
      </column>
      <column caption='Leads' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_711287276048130050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([applicant_id])' />
      </column>
      <column caption='Hired' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_711287276049960963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rooster_id])' />
      </column>
      <column caption='Share of Contacted' datatype='real' default-format='p0.0%' name='[Calculation_711287276054278148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1378101544396603394])/([Calculation_1378101544396234753]/COUNTD([Calculation_1280711191752380416]))' />
      </column>
      <column caption='Utilization %' datatype='real' default-format='p0.0%' name='[Calculation_711287276055326725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_231935428603588612]/700 &gt; 1 THEN 1 ELSE [Calculation_231935428603588612]/700 END' />
      </column>
      <column caption='Conversion Rate (copy)' datatype='real' default-format='p0.0%' name='[Conversion Rate (copy)_1767099906501427201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rooster_id])/[Calculation_1378101544396234753]' />
      </column>
      <column caption='Non RAF Hired' datatype='integer' default-format='n#,##0;-#,##0' name='[Hired (copy)_1767099906514763779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF utm_source &lt;&gt; &apos;raf&apos; THEN [rooster_id] ELSE Null END)' />
      </column>
      <column datatype='integer' name='[Month Number (Form Responses 11)]' role='dimension' type='quantitative' />
      <column caption='Non RAF Leads (copy)' datatype='real' default-format='p0.0%' name='[Non RAF Leads (copy)_1767099906505981954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [raf_flag] = &apos;non_raf&apos; THEN 1 ELSE 0 END)/SUM(IF [utm_source] &lt;&gt; &apos;raf&apos; THEN 1 ELSE 0 END)' />
