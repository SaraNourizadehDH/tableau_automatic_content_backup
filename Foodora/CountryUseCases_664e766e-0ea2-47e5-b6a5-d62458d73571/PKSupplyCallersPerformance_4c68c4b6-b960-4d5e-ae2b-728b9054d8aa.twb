            </column>
            <column caption='Applicants Contacted' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1378101544396603394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Purpose of Call made? (Form Responses 11)] = &apos;Arara Leads Conversion&apos; &#13;&#10;    AND [Calling Attempt? (Form Responses 11)] = 1 &#13;&#10;    THEN [Phone number (tableau) (Form Responses 11)] ELSE NULL END&#13;&#10;)' />
            </column>
            <column caption='Response Time (minutes)' datatype='integer' name='[Calculation_231935428602290176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Purpose of Call made? (Form Responses 11)] = &apos;Arara Leads Conversion&apos; &#13;&#10;AND [Calling Attempt? (Form Responses 11)] = 1 &#13;&#10;AND [Phone number (tableau) (Form Responses 11)] = [phone_number] THEN&#13;&#10;    DATEDIFF(&apos;minute&apos;, [created_at_local], [Timestamp (Form Responses 11)])&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
