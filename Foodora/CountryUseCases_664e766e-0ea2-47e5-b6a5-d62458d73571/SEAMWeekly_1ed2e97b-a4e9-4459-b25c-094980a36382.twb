      <aliases enabled='yes' />
      <column caption='% Same Week Last Month Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Last Week Vendor Fail Rate (copy)_219831979744075792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [week] = [Last Week (copy)_219831979735023616] THEN [total_vendor_failed_orders] END)&#13;&#10;/SUM(IF [week] = [Last Week (copy)_219831979735023616] THEN IFNULL([number_of_successful_orders],0)+IFNULL([total_failed_orders],0) END)' />
