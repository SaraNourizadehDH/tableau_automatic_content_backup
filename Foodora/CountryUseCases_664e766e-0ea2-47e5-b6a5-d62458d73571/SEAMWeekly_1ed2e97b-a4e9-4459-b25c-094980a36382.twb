      <column datatype='real' default-format='p0.00%' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_1541919983033942019]) - LOOKUP(ZN([Calculation_1541919983033942019]), -1)) / ABS(LOOKUP(ZN([Calculation_1541919983033942019]), -1))'>
