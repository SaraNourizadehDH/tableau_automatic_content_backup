      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0cz4gb11rwqf4u1by8csb1g2g3dp].[sum:active_product_count:qk]&quot;' value='# Active Products' />
          <alias key='&quot;[federated.0cz4gb11rwqf4u1by8csb1g2g3dp].[sum:products_w_description_count:qk]&quot;' value='# Description Products' />
          <alias key='&quot;[federated.0cz4gb11rwqf4u1by8csb1g2g3dp].[sum:products_w_image_count:qk]&quot;' value='# Photo Products' />
        </aliases>
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1503357860848410625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;  WHEN &quot;City&quot; THEN [city]&#13;&#10;  WHEN &quot;Business Type&quot; THEN [business_type]&#13;&#10;  WHEN &quot;Vendor Type&quot; THEN [vendor_type]&#13;&#10;  WHEN &quot;Total&quot; THEN &quot;Total&quot;&#13;&#10;END' />
      </column>
      <column caption='Measure' datatype='integer' name='[Calculation_1503357860849147907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &quot;# Active Products&quot; THEN [active_product_count]&#13;&#10;  WHEN &quot;# Photo Products&quot; THEN [products_w_image_count]&#13;&#10;  WHEN &quot;# Description Products&quot; THEN [products_w_description_count]&#13;&#10;END' />
      </column>
      <column caption='% CVR' datatype='real' name='[Calculation_1503357860849528836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cnt_checkout_visits])/SUM([cnt_menu_visits])' />
      </column>
      <column caption='Share Measure' datatype='real' name='[Calculation_1503357860852326405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;  WHEN &quot;% Photo Products&quot; THEN [Calculation_1503357860852629510]&#13;&#10;  WHEN &quot;% Description Products&quot; THEN [Calculation_1503357860853018631]&#13;&#10;END' />
      </column>
      <column caption='% Photo Products' datatype='real' name='[Calculation_1503357860852629510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([products_w_image_count])/SUM([active_product_count])' />
      </column>
      <column caption='% Description Products' datatype='real' name='[Calculation_1503357860853018631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([products_w_description_count])/SUM([active_product_count])' />
      </column>
      <column caption='% Photo Products bin' datatype='string' name='[Calculation_1503357860866207755]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;         [products_w_image_count] = 0 &#13;&#10;      OR [products_w_image_count] = NULL THEN &quot;0%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 20 THEN &quot;&lt;20%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 30 THEN &quot;&lt;30%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 40 THEN &quot;&lt;40%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 50 THEN &quot;&lt;50%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 60 THEN &quot;&lt;60%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 70 THEN &quot;&lt;70%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 80 THEN &quot;&lt;80%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 90 THEN &quot;&lt;90%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 100 THEN &quot;&lt;100%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 = 100 THEN &quot;100%&quot;&#13;&#10;  ELSE &quot;&lt;10%&quot;&#13;&#10;END' />
      </column>
      <column caption='# Vendors' datatype='integer' name='[Calculation_1503357860868108300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='% Description Products bin' datatype='string' name='[Calculation_97108877464875008]' role='dimension' type='nominal'>
