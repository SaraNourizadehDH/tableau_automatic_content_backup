          <calculation class='tableau' formula='IF &#13;&#10;         [products_w_image_count] = 0 &#13;&#10;      OR [products_w_image_count] = NULL THEN &quot;0%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 20 THEN &quot;&lt;20%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 30 THEN &quot;&lt;30%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 40 THEN &quot;&lt;40%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 50 THEN &quot;&lt;50%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 60 THEN &quot;&lt;60%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 70 THEN &quot;&lt;70%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 80 THEN &quot;&lt;80%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 90 THEN &quot;&lt;90%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 &lt; 100 THEN &quot;&lt;100%&quot;&#13;&#10;  ELSEIF [products_w_image_count]/[active_product_count] * 100 = 100 THEN &quot;100%&quot;&#13;&#10;  ELSE &quot;&lt;10%&quot;&#13;&#10;END' />
        </column>
