      <column caption='Next 1M Last 10M' datatype='string' name='[Calculation_1113515046155431936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [payment_date] &lt;= dateadd(&apos;month&apos;, 1, [Parameters].[Parameter 2]) &#13;&#10;and&#13;&#10;[payment_date] &gt;= dateadd(&apos;month&apos;, -10, [Parameters].[Parameter 2])&#13;&#10;then &apos;Show&apos;&#13;&#10;else &apos;Hide&apos;&#13;&#10;end' />
      </column>
      <column caption='Turnover 0M (Sum)' datatype='real' name='[Calculation_1806365710572363776]' role='measure' type='quantitative'>
