      <column caption='Security Filter' datatype='boolean' name='[Calculation_7866944166942142464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() IN (&#13;&#10;&apos;katerina.pankova@foodora.cz&apos;, &apos;matyas.kapusta@foodora.cz&apos;, &apos;jakub.rajnis@foodora.cz&apos;, &apos;eddy.trang@foodpanda.com&apos;,&#13;&#10;&apos;peter.zelinka@foodora.cz&apos;, &apos;adam.kolesa@damejidlo.cz&apos; , &apos;tomas.kycek@damejidlo.cz&apos;, &#13;&#10;&apos;vaclav.vytras@damejidlo.cz&apos; , &apos;milos.dlouhy@damejidlo.cz&apos;, &apos;denisa.navratova@foodora.cz&apos;&#13;&#10;)&#13;&#10;//OR (USERNAME() = &apos;richard.chotvac@damejidlo.cz&apos; AND [username] = &apos;lukas.bobek@foodora.cz&apos;)    //test&#13;&#10;//OR (USERNAME() = &apos;katerina.pankova@foodora.cz&apos; AND [username] = &apos;lukas.bobek@foodora.cz&apos;)&#9;&#9;//test&#13;&#10;&#13;&#10;OR (REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;)  = &apos;katerina.hanzalova.ext@foodora.cz&apos;&#13;&#10;AND&#13;&#10;REPLACE([username],&apos;damejidlo&apos;, &apos;foodora&apos;) = &apos;marketa.hanzalova.ext@foodora.cz&apos;)&#13;&#10;&#13;&#10;OR (REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;)  = &apos;barbora.muchova@foodora.cz&apos;&#13;&#10;AND&#13;&#10;REPLACE([username],&apos;damejidlo&apos;, &apos;foodora&apos;) = &apos;barbora.barta@foodora.cz&apos;)&#13;&#10;&#13;&#10;OR REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;)  = REPLACE([username], &apos;damejidlo&apos;, &apos;foodora&apos;)&#13;&#10;&#13;&#10;//výjimka - Denisa a Vláďa mají podřízené a smí vidět jejich odměny&#13;&#10;&#13;&#10;OR (REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;) = &apos;vladislav.mejstrik@foodora.cz&apos; AND REPLACE([username],&apos;damejidlo&apos;, &apos;foodora&apos;) IN (&#13;&#10;&apos;tereza.vlkova.ext@foodora.cz&apos;, &#13;&#10;&apos;lukas.martinek.ext@foodora.cz&apos;, &#13;&#10;&apos;katerina.hanzalova.ext@foodora.cz&apos;,&#13;&#10;&apos;marketa.hanzalova.ext@foodora.cz&apos;,&#13;&#10;&apos;karolina.soukupova@foodora.cz&apos;,&#13;&#10;&apos;sarka.topinkova.ext@foodora.cz&apos;,&#13;&#10;&apos;daniel.cerny@foodora.cz&apos;,&#13;&#10;&apos;jan.marz@foodora.cz&apos;)&#13;&#10;)&#13;&#10;&#13;&#10;OR (REPLACE(USERNAME(),&apos;damejidlo&apos;, &apos;foodora&apos;) = &apos;denisa.birnbaumova@foodora.cz&apos; AND REPLACE([username],&apos;damejidlo&apos;, &apos;foodora&apos;) IN (&#13;&#10;&apos;daniel.dvorak@foodora.cz&apos;, &#13;&#10;&apos;katerina.hofmanova@foodora.cz&apos;, &#13;&#10;&apos;karel.plasek@foodora.cz&apos;,&#13;&#10;&apos;martin.urbanik@foodora.cz&apos;,&#13;&#10;&apos;pavla.vrazelova@foodora.cz&apos;)&#13;&#10;)' />
