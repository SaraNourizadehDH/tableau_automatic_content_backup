      <column caption='Activation or Signing Month' datatype='string' datatype-customized='true' name='[Calculation_289637789025083392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='left(STR(DATETRUNC(&apos;month&apos;, [date])),7)' />
      </column>
      <column caption='Next Month' datatype='datetime' name='[Calculation_377176506805755907]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEtrunc(&apos;month&apos;, dateadd(&apos;month&apos;,1, today()))' />
