      <column caption='Reward Type' datatype='string' name='[Calculation_5013632320444645376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [reward_type]&#13;&#10;when &apos;opening&apos; then &apos;activation&apos;&#13;&#10;else [reward_type]&#13;&#10;end' />
