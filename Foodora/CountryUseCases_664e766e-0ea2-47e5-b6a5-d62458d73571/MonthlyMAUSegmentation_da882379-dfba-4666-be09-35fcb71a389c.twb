    <worksheet name='Ist Retention Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='Istanbul Frequency Shift' name='federated.0tfk76l0jmppl71azlr5u1v5hg1t' />
          </datasources>
          <datasource-dependencies datasource='federated.0tfk76l0jmppl71azlr5u1v5hg1t'>
            <column caption='Month -1 Frequency' datatype='string' name='[Calculation_1096063575936647172]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[pre_frequency]' />
              <aliases>
                <alias key='&quot;high&quot;' value='High' />
                <alias key='&quot;low&quot;' value='Low' />
                <alias key='&quot;mid&quot;' value='Mid' />
                <alias key='&quot;new customer&quot;' value='New Customer' />
              </aliases>
            </column>
            <column caption='YearMonth' datatype='date' name='[Calculation_1096063575936892935]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATEADD(&apos;month&apos;, 1, [pre_yearmonth]))' />
            </column>
            <column aggregation='Sum' caption='PostFreq No' datatype='integer' name='[Calculation_1096063575958872081]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [post_frequency]&#13;&#10;when &apos;churn&apos; then 0&#13;&#10;when &apos;1-er&apos; then 1&#13;&#10;when &apos;low&apos; then 2&#13;&#10;when &apos;mid&apos; then 3&#13;&#10;when &apos;high&apos; then 4&#13;&#10;end' />
            </column>
            <column caption='User Count' datatype='integer' name='[Calculation_1096063575959171092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[user_count]' />
            </column>
            <column caption='Retention Users' datatype='integer' name='[Calculation_1096063575987118107]' role='measure' type='quantitative'>
