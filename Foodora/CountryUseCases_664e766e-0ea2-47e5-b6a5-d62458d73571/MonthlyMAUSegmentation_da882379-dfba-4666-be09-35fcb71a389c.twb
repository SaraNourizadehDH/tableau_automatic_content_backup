    <worksheet name='TR Retention Users Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='TR Frequency Shift' name='federated.09g73h60ezwrhw12leweg14rb45c' />
            <datasource name='Parameters' />
            <datasource caption='ACID Frequency w NC' name='federated.1eqel2a14d6btl0zlfcsr1aojouo' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Value Selection' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of Total&quot;'>
              <calculation class='tableau' formula='&quot;% of Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09g73h60ezwrhw12leweg14rb45c'>
            <column caption='YearMonth' datatype='date' default-format='*mmm yy' name='[Calculation_1096063575934382080]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATEADD(&apos;month&apos;, 1, [pre_yearmonth]))' />
            </column>
            <column caption='Month -1 Frequency' datatype='string' name='[Calculation_1096063575934779393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[pre_frequency]' />
              <aliases>
                <alias key='&quot;high&quot;' value='High' />
                <alias key='&quot;low&quot;' value='Low' />
                <alias key='&quot;mid&quot;' value='Mid' />
                <alias key='&quot;new customer&quot;' value='New Customer' />
                <alias key='&quot;reacquisition&quot;' value='Reacquisition' />
              </aliases>
            </column>
            <column caption='User Count' datatype='integer' name='[Calculation_1096063575936598019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[user_count]' />
            </column>
            <column caption='Retention Users' datatype='integer' name='[Calculation_1096063575985451031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;IF [PreFreq No (copy)_1096063575951298570] &gt; 0&#13;&#10;then [Calculation_1096063575936598019]&#13;&#10;end&#13;&#10;)' />
            </column>
            <column caption='Month 0' datatype='date' default-format='*mmm yy' name='[Calculation_1313362259413897221]' role='dimension' type='ordinal'>
