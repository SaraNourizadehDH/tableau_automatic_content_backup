          <datasource-dependencies datasource='federated.0ekdr8k18i5bvx18my0hb0iycbm6'>
            <column caption='Total Campaigns' datatype='integer' name='[Calculation_1429611440208740352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_amount])+&#13;&#10;SUM([campaign_fg])+&#13;&#10;SUM([campaign_free_delivery])+&#13;&#10;SUM([campaign_percentage])' />
            </column>
            <column caption='Amount %' datatype='real' name='[Calculation_1429611440209076225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_amount]) / [Calculation_1429611440208740352]' />
            </column>
            <column caption='Percentage %' datatype='real' name='[Calculation_1429611440209276930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_percentage]) / [Calculation_1429611440208740352]' />
            </column>
            <column caption='Free Gift %' datatype='real' name='[Calculation_1429611440209379331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_fg]) / [Calculation_1429611440208740352]' />
            </column>
            <column caption='Free Delivery %' datatype='real' name='[Calculation_1429611440209514500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_free_delivery]) / [Calculation_1429611440208740352]' />
            </column>
            <column caption='Free Delivery 150 %' datatype='real' name='[Calculation_1429611440209625093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_free_delivery150]) / SUM([campaign_free_delivery])' />
            </column>
            <column caption='Free Delivery 200 %' datatype='real' name='[Calculation_1429611440209735686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_free_delivery200]) / SUM([campaign_free_delivery])' />
            </column>
            <column caption='Free Delivery 250 %' datatype='real' name='[Calculation_1429611440209829895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_free_delivery250]) / SUM([campaign_free_delivery])' />
            </column>
            <column caption='Free Delivery 300 %' datatype='real' name='[Calculation_1429611440209928200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_free_delivery300]) / SUM([campaign_free_delivery])' />
            </column>
            <column caption='Free Delivery 120 %' datatype='real' name='[Calculation_1429611440212234250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([campaign_free_delivery120]) / SUM([campaign_free_delivery])' />
            </column>
