          <datasource-dependencies datasource='federated.0ekdr8k18i5bvx18my0hb0iycbm6'>
            <column caption='% Campaigns Planned (MMT)' datatype='real' name='[% Campaigns Active (MMT) (copy)_174514503204118528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_planned_cnt])/COUNTD([vendor_code])' />
            </column>
            <column caption='% Joker Active' datatype='real' name='[Calculation_1672242900716199936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_active_cnt]) / COUNTD([vendor_code])' />
            </column>
            <column caption='% CPC Active' datatype='real' name='[Calculation_1672242900716916737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_active_cnt])/COUNTD([vendor_code])' />
            </column>
            <column caption='% CPP Active' datatype='real' name='[Calculation_1672242900719669251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpp_active_cnt])/COUNTD([vendor_code])' />
            </column>
            <column caption='% Campaigns Active (MMT)' datatype='real' name='[Calculation_1672242900719931396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_active_cnt])/COUNTD([vendor_code])' />
            </column>
            <column caption='% Campaigns (MMT &amp; MP)' datatype='real' name='[Calculation_521573135335268353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([combined_discount_cnt])/COUNTD(vendor_code)' />
            </column>
            <column caption='% Joker Sold Inventory CM' datatype='real' name='[Calculation_521573135336312834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_sold_cm]) / SUM([joker_inventory_cm])' />
            </column>
            <column caption='% CPC Budget Sold CM' datatype='real' name='[Calculation_521573135339610115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_rev])/SUM([cpc_budget])' />
