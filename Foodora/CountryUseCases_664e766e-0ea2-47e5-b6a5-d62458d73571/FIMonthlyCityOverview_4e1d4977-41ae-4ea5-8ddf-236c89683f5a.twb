      <aliases enabled='yes' />
      <column caption='# Active Customers' datatype='integer' name='[# Active (copy)_1519683424907272193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [active_customers] end' />
      </column>
      <column caption='# Non-Food Orders' datatype='integer' name='[# Active (copy)_92042317480206336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [non_food_orders] end' />
      </column>
      <column caption='# Non-Food Vendors Active' datatype='integer' name='[# Active (copy)_92042317480644610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [active_non_food] end' />
      </column>
      <column caption='# New Customers' datatype='integer' name='[# Active Customers (copy)_1519683424908439555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [new_customers] end' />
      </column>
      <column caption='# Non-Food Vendors Online' datatype='integer' name='[# Online (copy)_92042317484777475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [online_non_food] end' />
      </column>
      <column caption='# Successful Orders ' datatype='integer' name='[# Zombie (copy)_1519683424906817536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [successful_orders] END' />
      </column>
      <column caption='% Delay &gt; 30 Min (OD)' datatype='real' name='[% Delay &gt; 15 Min (OD) (copy)_531987731392122905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [delay_cnt30] END)&#13;&#10;/sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [delay_obs] END)' />
      </column>
      <column caption='% MoM' datatype='real' name='[% YoY (copy)_531987731382308873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; THEN [successful_orders] end)&#13;&#10;/sum(IF [year_ind]=&quot;CY&quot; THEN [pm_successful_orders] END)-1' />
      </column>
      <column caption='Order Freq.' datatype='real' name='[Calculation_1519683424907726850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([# Zombie (copy)_1519683424906817536])/sum([# Active (copy)_1519683424907272193])' />
      </column>
      <column caption='Orders Per Active Vendor' datatype='real' name='[Calculation_1519683424916660228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([# Zombie (copy)_1519683424906817536])/sum([Calculation_531987731389427725])' />
      </column>
      <column caption='Current Month' datatype='string' name='[Calculation_363102721773289472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STR([report_month]) = STR(DATE(DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))) &#13;&#10;    THEN &apos;Last Month&apos;&#13;&#10;ELSE LEFT(STR([report_month]),7) END' />
      </column>
      <column caption='City' datatype='string' name='[Calculation_531987731378999296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[city]' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_531987731379089409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country]' />
      </column>
      <column caption='# Successful Orders' datatype='integer' name='[Calculation_531987731379269634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[successful_orders]' />
      </column>
      <column caption='Select Month' datatype='string' name='[Calculation_531987731380215813]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='left(STR([report_month]),7)' />
      </column>
      <column caption='#' datatype='integer' name='[Calculation_531987731380461574]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[city_rank]' />
      </column>
      <column caption='Vendor' datatype='string' name='[Calculation_531987731380703239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_name]' />
      </column>
      <column caption='% YoY' datatype='real' name='[Calculation_531987731382206472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; THEN [successful_orders] end)&#13;&#10;/sum(IF [year_ind]=&quot;CY&quot; THEN [py_successful_orders] END)-1' />
      </column>
      <column caption='% Vendor Cancelled' datatype='real' name='[Calculation_531987731387404299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_cancelled])/sum([gross_orders])' />
      </column>
      <column caption='# Online' datatype='integer' name='[Calculation_531987731389382668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [online] end' />
      </column>
      <column caption='# Active' datatype='integer' name='[Calculation_531987731389427725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [active] end' />
      </column>
      <column caption='# Zombie' datatype='integer' name='[Calculation_531987731389456398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [zombie] END' />
      </column>
      <column caption='# Active - OD' datatype='integer' name='[Calculation_531987731389505551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [active_od] end' />
      </column>
      <column caption='# Active - VD' datatype='integer' name='[Calculation_531987731389542416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [year_ind]=&quot;CY&quot; then [active_vd] end' />
      </column>
      <column caption='UTR' datatype='real' name='[Calculation_531987731390873617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [log_completed_order] END)&#13;&#10;/sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [actual_working_time]/60/60 END)' />
      </column>
      <column caption='% Failed Orders' datatype='real' name='[Calculation_531987731391287315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [year_ind]=&quot;CY&quot; then [failed_orders] end)/&#13;&#10;sum(if [year_ind]=&quot;CY&quot; then [gross_orders] end)' />
      </column>
      <column caption='% Fail Rate' datatype='real' name='[Calculation_531987731391361044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [log_cancelled_order] END)&#13;&#10;/sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [log_gross_ord] END)' />
      </column>
      <column caption='% OD' datatype='real' name='[Calculation_531987731391627286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; THEN [successful_orders_od] end)/&#13;&#10;sum(if [year_ind]=&quot;CY&quot; then [successful_orders] end)' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_531987731391803415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [year_ind]=&quot;CY&quot; then [gmv_local] end)/&#13;&#10;sum(if [year_ind]=&quot;CY&quot; then [successful_orders] end)' />
      </column>
      <column caption='% Delay &gt; 15 Min (OD)' datatype='real' name='[Calculation_531987731391950872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [delay_cnt15] END)&#13;&#10;/sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [delay_obs] END)' />
      </column>
      <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_531987731392245786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [delivery_time_mins] END)&#13;&#10;/sum(IF [year_ind]=&quot;CY&quot; and (report_dim=&quot;Total&quot; or ([report_dim]=&quot;City&quot; and [Calculation_531987731378999296]&lt;&gt;&quot;Non-Logistics Area&quot;)) THEN [delivery_time_cnt] END)' />
      </column>
      <column caption='% Vendor Delay &gt; 10 Min (OD)' datatype='real' name='[Calculation_531987731392479259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_count10])/sum([vendor_late_obs])' />
      </column>
      <column caption='% of Total Orders' datatype='real' name='[Calculation_531987731392823324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_orders])/SUM([city_successful_orders])' />
      </column>
