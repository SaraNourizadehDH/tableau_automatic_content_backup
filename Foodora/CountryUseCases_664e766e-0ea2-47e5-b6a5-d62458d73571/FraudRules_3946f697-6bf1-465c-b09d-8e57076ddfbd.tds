  <aliases enabled='yes' />
  <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
    <aliases>
      <alias key='&quot;[Fraud Rules (local copy)].[pcto:usr:Calculation_3289316603146612736:qk:5]&quot;' value='% of Total Order Count' />
    </aliases>
  </column>
  <column caption='Order Total Value' datatype='real' name='[Calculation_1633821518312706048]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ INCLUDE [order_code]: AVG([amount_lc])}' />
  </column>
  <column caption='Is Block' datatype='boolean' name='[Calculation_178807012325949440]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CONTAINS([active_rules_unnest],&apos;block&apos;)' />
  </column>
  <column caption='Order Count' datatype='integer' name='[Calculation_3289316603146612736]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([order_code])' />
  </column>
  <column caption='Customer Count' datatype='integer' name='[Calculation_3289316603153805314]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='COUNTD([customer_id])' />
  </column>
  <column caption='TimeFrame Selector' datatype='string' name='[Calculation_3289316603179847683]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [order_date])))&#10;    WHEN &apos;Weekly&apos; THEN STR(YEAR(DATE(DATETRUNC(&apos;week&apos;, [order_date], &apos;Monday&apos;))))+&quot; Week&quot;+STR(DATEPART(&quot;week&quot;,DATE(DATETRUNC(&apos;week&apos;,[order_date], &apos;Monday&apos;))))&#10;    WHEN &apos;Monthly&apos; THEN STR(YEAR(DATE(DATETRUNC(&apos;month&apos;, [order_date])))) +&quot; &quot;+STR(DATEPART(&quot;month&quot;,DATE(DATETRUNC(&apos;month&apos;,[order_date]))))&#10;    WHEN &apos;Yearly&apos; THEN STR(YEAR(DATE(DATETRUNC(&apos;year&apos;, [order_date]))))&#10;END' />
  </column>
  <column caption='Email Domain' datatype='string' name='[Calculation_6893322204492337152]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='RIGHT([order_email],LEN([order_email])-FIND([order_email],&quot;@&quot;))' />
  </column>
