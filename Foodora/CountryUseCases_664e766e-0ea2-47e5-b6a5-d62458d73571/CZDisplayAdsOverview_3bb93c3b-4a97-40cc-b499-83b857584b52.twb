          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local Currency&quot;'>
              <calculation class='tableau' formula='&quot;Local Currency&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0daahyu154izmn13h8xd402osz5c'>
            <column caption='# Vendor Advertisers' datatype='integer' default-format='N' name='[# Advertisers (copy)_806707343101947905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if not [got_cancelled] then [vendor_code] end)' />
            </column>
            <column caption='# Advertisers' datatype='integer' default-format='N' name='[# Campaigns (copy)_790100280191737865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if not [got_cancelled] then [advertiser_id] end)' />
            </column>
            <column caption='% Budget Achieved' datatype='real' default-format='p0.00%' name='[% Revenue of GMV (copy)_790100280180953093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_790100280173350912] / [Calculation_790100280181178374]' />
            </column>
            <column caption='Report after Started' datatype='boolean' name='[Calculation_1643250940247375872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='date([iso_date]) &gt;= date([started_at_local])' />
            </column>
            <column caption='Revenue' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_790100280173350912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Parameters].[Parameter 1] = &quot;Local Currency&quot; &#13;&#10;then [revenue_lc] else [revenue_eur] end)' />
            </column>
            <column caption='ROAS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_790100280174772227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Revenue (copy)_790100280174673922] / [Calculation_790100280173350912]' />
            </column>
            <column caption='Campaign Budget' datatype='real' name='[Calculation_790100280176541700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [campaign_id], [first_day_of_month]: &#13;&#10;avg(if [Parameters].[Parameter 1] = &quot;Local Currency&quot; then [budget_excl_cancelled_lc] else [budget_excl_cancelled_eur] end)}' />
            </column>
            <column caption='Budget' datatype='real' name='[Calculation_790100280181178374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_790100280176541700])' />
            </column>
            <column caption='CPM' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_790100280182771720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_790100280173350912] / ([GMV (copy)_790100280182648839]/1000)' />
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_806707343101460480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [uuid],[vendor_code], [account_manager], [vendor_city]: COUNTD(IF [is_active] and not [is_private] then [vendor_code] end)}' />
            </column>
            <column caption='% Vendor Advertisers' datatype='real' default-format='p0.0%' name='[Calculation_806707343102533635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Advertisers (copy)_806707343101947905] / SUM([Calculation_806707343101460480])' />
            </column>
            <column caption='# Impressions' datatype='integer' default-format='n#,##0;-#,##0' name='[GMV (copy)_790100280182648839]' role='measure' type='quantitative'>
