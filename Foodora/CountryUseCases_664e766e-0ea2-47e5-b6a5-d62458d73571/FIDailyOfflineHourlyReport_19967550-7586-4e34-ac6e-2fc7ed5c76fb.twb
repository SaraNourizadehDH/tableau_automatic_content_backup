      <column caption='# Orders Last 30d' datatype='integer' name='[Calculation_1385982795639590912]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[orders_last_30d]' />
      </column>
      <column caption='Sort Metric' datatype='real' name='[Calculation_1445374015546073090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([orders_last_30d])*[Calculation_1496039510475018242]' />
      </column>
      <column caption='% Offline Hours' datatype='real' name='[Calculation_1496039510475018242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([offline_mins],0))/SUM([open_mins])' />
      </column>
      <column caption='# Vendors Scheduled' datatype='integer' name='[Calculation_1496039510481592325]' role='measure' type='quantitative'>
