      <aliases enabled='yes' />
      <column caption='Avg. Product Price' datatype='real' name='[# Product Items (copy)_1190357731876265984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if metric = &quot;Product&quot; THEN [gfv] end)/  sum(if metric = &quot;Product&quot; THEN [quantity] end)' />
      </column>
      <column caption='# Topping Items' datatype='integer' name='[# Product Items (copy)_1194579841627078659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if metric = &quot;Topping&quot; THEN [quantity] end)' />
      </column>
      <column caption='# Product Items' datatype='integer' name='[# Successful Orders (copy)_1194579841626730498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if metric = &quot;Product&quot; THEN [quantity] end)' />
      </column>
      <column caption='Avg. Topping Price' datatype='real' name='[# Topping Items (copy)_1190357731876741121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if metric = &quot;Topping&quot; THEN [gfv] end) / sum(if metric = &quot;Topping&quot; THEN [quantity] end)' />
      </column>
      <column caption='# Successful Orders' datatype='integer' name='[Calculation_1194579841618042880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if metric = &quot;Orders&quot; THEN [quantity] end)' />
      </column>
      <column caption='Metric Field Products' datatype='string' name='[Calculation_1444248161299255296]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Total Product Quantity&quot; THEN STR(round([# Successful Orders (copy)_1194579841626730498],0))&#13;&#10;WHEN &quot;Avg. Product Price&quot; THEN STR(round([# Product Items (copy)_1190357731876265984],2))&#13;&#10;WHEN &quot;Total Product Price&quot; THEN STR(round([Calculation_1444248161306857474],1))&#13;&#10;END' />
      </column>
      <column caption='Product Price' datatype='real' name='[Calculation_1444248161306857474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if metric = &quot;Product&quot; THEN [gfv] end)' />
      </column>
      <column caption='Chain' datatype='string' name='[Calculation_1471269750939291648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[chain_name]' />
      </column>
      <column caption='Vendor' datatype='string' name='[Calculation_1471269750939332609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_name]' />
      </column>
      <column caption='Product' datatype='string' name='[Calculation_1471269750943363075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[title]' />
      </column>
      <column caption='Across_Value' datatype='integer' name='[Calculation_1471269750946402308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(IIF([Calculation_1471269750946664453]=0,(sum([quantity])),0))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LookupValue' datatype='integer' name='[Calculation_1471269750946664453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FIRST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_1471269750946951174]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='rank([Calculation_1471269750946402308])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date' datatype='string' name='[Calculation_241505546817167360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &quot;Monthly&quot; then [report_month]&#13;&#10;when &quot;Weekly&quot; then [report_week]&#13;&#10;END' />
      </column>
      <column caption='Metric Field Toppings' datatype='string' name='[Metric Field Product (copy)_1444248161307746307]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Products Metric Para (copy)_1444248161307963396]&#13;&#10;WHEN &quot;Total Toppings Quantity&quot; THEN STR(round([# Product Items (copy)_1194579841627078659],0))&#13;&#10;WHEN &quot;Avg. Toppings Price&quot; THEN STR(round([# Topping Items (copy)_1190357731876741121],2))&#13;&#10;WHEN &quot;Total Toppings Price&quot; THEN STR(round([Product Price (copy)_1444248161308438533],1))&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Toppings Price' datatype='real' name='[Product Price (copy)_1444248161308438533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if metric = &quot;Topping&quot; THEN [gfv] end)' />
      </column>
