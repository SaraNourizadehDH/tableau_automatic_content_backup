            </column>
            <column caption='count_vfd_vb' datatype='integer' name='[count_pu_vb (copy)_165999875495768095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [signing_type] = &apos;virtual_brand&apos; &#10;    AND [has_vfd]&#10;    AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;    THEN [grid] &#10;    ELSE NULL &#10;    END&#10;)' />
