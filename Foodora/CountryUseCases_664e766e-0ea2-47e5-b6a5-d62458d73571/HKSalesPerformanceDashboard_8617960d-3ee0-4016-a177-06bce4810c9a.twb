      </connection>
      <aliases enabled='yes' />
      <column caption='is_eligible_activation' datatype='boolean' name='[Calculation_1620169970031829002]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;    [count_reg_restro (copy)_1620169970023215113] &gt;= CEILING([Parameters].[Outlet Count Min Target (copy)_165999875472441364]*[Parameters].[Parameter 2])&#10;)&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='pct_pickup_opt_in' datatype='real' name='[Calculation_1620169970037551116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#10;    MIN([count_vb (copy)_165999875487719450],5) + [count_ed (copy)_1620169970018902019],&#10;    0        &#10;) / &#10;[count_reg_restro (copy)_1620169970023215113]' />
      </column>
      <column caption='multiplier' datatype='real' name='[Calculation_1620169970038751245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1620169970031829002]&#10;THEN (&#10;    IF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 0.75 &#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 0.8 &#10;    )&#10;    THEN 0.5&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 0.8 &#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 0.9 &#10;    )&#10;    THEN 0.7&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 0.9&#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt;= 1 &#10;    )&#10;    THEN 1&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt; 1&#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 1.2&#10;    )&#10;    THEN 1.3&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 1.2&#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 1.5&#10;    )&#10;    THEN 1.5&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt; 1.5&#10;    )&#10;    THEN 2&#10;    END&#10;)&#10;ELSE 0&#10;END' />
      </column>
      <column caption='pct_activation_target_achieved' datatype='real' name='[Calculation_1620169970040868878]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[count_reg_restro (copy)_1620169970023215113]/25' />
      </column>
      <column caption='pct_activation_excellence' datatype='real' name='[Calculation_1620169970041528335]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IFNULL(&#10;    [count_pu_reg_restro  (copy)_165999875495772192] + MIN([count_pu_vb (copy)_165999875495768095], 5),&#10;    0        &#10;) / &#10;[count_reg_restro (copy)_1620169970023215113]' />
      </column>
      <column caption='payment_reg_outlet_lvl' datatype='real' name='[Calculation_1620169970053869586]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_1620169970055938067] = &apos;gtc&apos; AND [signing_type] = &quot;regular_restaurant&quot;&#10;THEN (&#10;    (&#10;        IF [cur_vendor_grade] = &apos;A&apos; THEN [Parameters].[Parameter 1] &#10;        ELSEIF  [cur_vendor_grade] = &apos;B&apos; THEN [Parameters].[GTC A Payout (copy)_1620169970057117716]&#10;        ELSEIF  [cur_vendor_grade] = &apos;C&apos; THEN [Parameters].[GTC B Payout (copy)_1620169970058919957]&#10;        ELSE 0 &#10;        END&#10;    )&#10;)&#10;ELSEIF [Calculation_1620169970055938067] = &apos;gtm&apos; AND [signing_type] = &quot;regular_restaurant&quot;&#10;THEN (&#10;    (&#10;        IF [cur_vendor_grade] = &apos;A&apos; THEN [Parameters].[GTC C Payout (copy) (copy)_1620169970060890136] &#10;        ELSEIF  [cur_vendor_grade] = &apos;B&apos; THEN [Parameters].[GTC C Payout (copy) (copy) (copy)_1620169970060894233]&#10;        ELSEIF  [cur_vendor_grade] = &apos;C&apos; THEN [Parameters].[GTC C Payout (copy)_1620169970060881943]&#10;        ELSE 0 &#10;        END&#10;    ) &#10;) END' />
      </column>
      <column caption='competition_type' datatype='string' name='[Calculation_1620169970055938067]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF(&#10;    [is_on_keeta] = TRUE&#10;)&#10;THEN &quot;gtc&quot;&#10;ELSE &apos;gtm&apos;&#10;END' />
      </column>
      <column caption='sum_payout' datatype='real' name='[Calculation_1620169970059083798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_165999875470323730]&#10;+ [Calculation_165999872322437122]&#10;+ [Total VFD Payout (copy)_165999872323379203]&#10;+ [Total VFD Payout (copy)_165999874453446668]' />
      </column>
      <column caption='avg_total_signing' datatype='real' name='[Calculation_1620169970359697436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[count_reg_restro (copy)_1620169970023215113]/COUNTD([owner_name])' />
      </column>
      <column caption='Total VFD Payout' datatype='real' name='[Calculation_165999872322437122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (&#10;    [is_eligible_for_incentive (copy)_1620169970050498576] = TRUE&#10;)&#10;THEN (&#10;    // Regular restro&#10;    SUM(&#10;        IF  &#10;            [has_vfd] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;            AND NOT ISNULL([cur_vendor_grade]) &#10;            AND [signing_type] = &apos;regular_restaurant&apos;&#10;        THEN [Parameters].[GTM C Payout (copy)_165999872320962560]&#10;        ELSE 0&#10;        END&#10;    )&#10;) + &#10;(&#10;    // Virtual Restaurant&#10;    SUM(&#10;        IF  &#10;            [has_vfd] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;            AND NOT ISNULL([cur_vendor_grade]) &#10;            AND [signing_type] = &apos;virtual_brand&apos;&#10;            AND [rn_vendor_grade_by_type] &lt;=5&#10;        THEN [Parameters].[GTM C Payout (copy)_165999872320962560]&#10;        ELSE 0&#10;        END&#10;    )&#10;)&#10;ELSE 0&#10;END' />
      </column>
      <column caption='kpi_score' datatype='real' name='[Calculation_165999874404782084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// outlet count&#10;&#10;[Calculation_165999874463948814]&#10;&#10;//dlp&#10;+ [kpi_score_outlet (copy)_165999874464288783]&#10;//cold start&#10;+ [kpi_score_dlp (copy)_165999874464403472]&#10;//pick up&#10;+ [Calculation_165999874464563217]' />
      </column>
      <column caption='Vendor Lvl DLP Coverage' datatype='real' name='[Calculation_165999874449780741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [grid]:&#10;sum([num_pre_act_menu_images]) / sum([num_pre_act_menu_items])}' />
      </column>
      <column caption='Grid meeting DLP threshold' datatype='string' name='[Calculation_165999874450145286]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_165999874449780741] &gt;= [Parameters].[Parameter 3]&#10;THEN [grid]&#10;END' />
      </column>
      <column caption='% activation &gt;= DLP threshold' datatype='real' name='[Calculation_165999874452074505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([count_pu_reg_restro  (copy)_165999875494391837] + MIN([count_pu_vb (copy)_165999875494748190],5))&#10;/&#10;[count_reg_restro (copy)_1620169970023215113]' />
      </column>
      <column caption='is_vendor_meeting_dlp_threshold' datatype='boolean' name='[Calculation_165999874452647946]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_165999874449780741] &gt;= [Parameters].[Parameter 3]&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='kpi_score_outlet' datatype='real' name='[Calculation_165999874463948814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(&#10;    IF [Calculation_1620169970031829002] = TRUE&#10;    AND [count_total_signing (copy)_1620169970032566283]&gt;=([Parameters].[Outlet Count Min Target (copy)_165999875472441364] *[Parameters].[Parameter 2]*[Parameters].[% to reach eligible activation payout (copy)_165999875482509335])&#10;    THEN ([count_reg_restro (copy)_1620169970023215113]/[Parameters].[Outlet Count Min Target (copy)_165999875472441364]) * 50&#10;    ELSE 0&#10;    END,&#10;    50&#10;)' />
      </column>
      <column caption='kpi_score_pu' datatype='real' name='[Calculation_165999874464563217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    IF [is_eligible_for_incentive (copy)_1620169970050498576]&#10;    THEN [Calculation_1620169970037551116] * 10&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Total Activation Payout' datatype='real' name='[Calculation_165999875470323730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (&#10;    [Calculation_1620169970031829002] = TRUE&#10;)&#10;THEN &#10;([Calculation_1620169970038751245] * &#10;(&#10;    (&#10;        // Regular restro&#10;        SUM(&#10;            IF  &#10;                [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;                AND NOT ISNULL([cur_vendor_grade]) &#10;                AND [signing_type] = &apos;regular_restaurant&apos;&#10;            THEN [Calculation_1620169970053869586]&#10;            ELSE 0&#10;            END&#10;        )   &#10;    )&#10;     + &#10;    (&#10;        // Virtual Restaurant&#10;        SUM(&#10;            IF  &#10;                [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;                AND NOT ISNULL([cur_vendor_grade]) &#10;                AND [signing_type] = &apos;virtual_brand&apos;&#10;                AND [rn_vendor_grade_by_type] &lt;=5&#10;            THEN [payment_reg_outlet_lvl (copy)_165999875481313301]&#10;            ELSE 0&#10;            END&#10;        )&#10;    )&#10;))&#10;&#10;ELSE 0&#10;END' />
      </column>
      <column caption='payment_outlet_lvl' datatype='real' name='[Calculation_165999875509133345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_1620169970053869586],[payment_reg_outlet_lvl (copy)_165999875481313301])' />
      </column>
      <column caption='non_activation_payout' datatype='real' name='[Calculation_2330542450265583616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total VFD Payout (copy)_165999874453446668]+[Total VFD Payout (copy)_165999872323379203]+[Calculation_165999872322437122]' />
      </column>
      <column caption='Total Pu Payout ' datatype='real' name='[Total VFD Payout (copy)_165999872323379203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (&#10;    [is_eligible_for_incentive (copy)_1620169970050498576] = TRUE&#10;)&#10;THEN (&#10;    // Regular restro&#10;    SUM(&#10;        IF  &#10;            [has_pu] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;            AND NOT ISNULL([cur_vendor_grade])      &#10;            AND [signing_type] = &apos;regular_restaurant&apos;&#10;        THEN [Parameters].[vendor_excellence_payout (copy)_165999872321970177]&#10;        ELSE 0&#10;        END&#10;    )&#10;) + &#10;(&#10;    // Virtual Restaurant&#10;    SUM(&#10;        IF  &#10;            [has_pu] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;            AND NOT ISNULL([cur_vendor_grade]) &#10;            AND [signing_type] = &apos;virtual_brand&apos;&#10;            AND [rn_vendor_grade_by_type] &lt;=5&#10;        THEN [Parameters].[vendor_excellence_payout (copy)_165999872321970177]&#10;        ELSE 0&#10;        END&#10;    )&#10;)&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Total DLP Payout' datatype='real' name='[Total VFD Payout (copy)_165999874453446668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (&#10;    [is_eligible_for_pu_bonus (copy)_165999874453123083] = TRUE&#10;)&#10;THEN (&#10;    [Parameters].[Vendor Excellence Payout (copy)_165999874453667853]&#10;)&#10;ELSE 0&#10;END' />
      </column>
