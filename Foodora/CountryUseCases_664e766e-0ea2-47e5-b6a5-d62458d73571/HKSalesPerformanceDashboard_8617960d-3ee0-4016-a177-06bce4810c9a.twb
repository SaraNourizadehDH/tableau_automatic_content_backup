            <column caption='count_reg_restro_ab' datatype='integer' name='[count_reg_restro (copy)_1620169970020376581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF &#10;        [signing_type] = &apos;regular_restaurant&apos; &#10;        AND (&#10;            [cur_vendor_grade] = &apos;A&apos;&#10;            OR [cur_vendor_grade] = &apos;B&apos;&#10;        ) &#10;    THEN [grid] &#10;    ELSE NULL &#10;    END&#10;)' />
