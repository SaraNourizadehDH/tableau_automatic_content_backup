            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[kpi_inventory_signing_list_E1DF6D5365CE47F4AD210289893106F2]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
