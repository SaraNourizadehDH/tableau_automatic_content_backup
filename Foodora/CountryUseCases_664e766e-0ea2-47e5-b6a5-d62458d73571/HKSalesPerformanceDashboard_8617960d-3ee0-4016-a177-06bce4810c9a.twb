    <worksheet name='Non-activation vs activation payout'>
      <table>
        <view>
          <datasources>
            <datasource caption='kpi_inventory_signing_list (sandbox_kelvin_ng_sales_perf)' name='federated.1v9gx3l0hc5eti10bb46s0fji1xk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='GTC B Payout' datatype='real' name='[GTC A Payout (copy)_1620169970057117716]' param-domain-type='any' role='measure' type='quantitative' value='1750.'>
              <calculation class='tableau' formula='1750.' />
            </column>
            <column caption='GTC C Payout' datatype='real' name='[GTC B Payout (copy)_1620169970058919957]' param-domain-type='any' role='measure' type='quantitative' value='1400.'>
              <calculation class='tableau' formula='1400.' />
            </column>
            <column caption='GTM B Payout' datatype='real' name='[GTC C Payout (copy) (copy) (copy)_1620169970060894233]' param-domain-type='any' role='measure' type='quantitative' value='1400.'>
              <calculation class='tableau' formula='1400.' />
            </column>
            <column caption='GTM A Payout' datatype='real' name='[GTC C Payout (copy) (copy)_1620169970060890136]' param-domain-type='any' role='measure' type='quantitative' value='2100.'>
              <calculation class='tableau' formula='2100.' />
            </column>
            <column caption='GTM C Payout' datatype='real' name='[GTC C Payout (copy)_1620169970060881943]' param-domain-type='any' role='measure' type='quantitative' value='1120.'>
              <calculation class='tableau' formula='1120.' />
            </column>
            <column caption='Vendor Excellence Payout' datatype='real' name='[GTM C Payout (copy)_165999872320962560]' param-domain-type='any' role='measure' type='quantitative' value='600.'>
              <calculation class='tableau' formula='600.' />
            </column>
            <column caption='Outlet Count Target' datatype='real' name='[Outlet Count Min Target (copy)_165999875472441364]' param-domain-type='any' role='measure' type='quantitative' value='25.'>
              <calculation class='tableau' formula='25.' />
            </column>
            <column caption='GTC A Payout' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='2625.'>
              <calculation class='tableau' formula='2625.' />
            </column>
            <column caption='% to reach eligible activation payout' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='0.75'>
              <calculation class='tableau' formula='0.75' />
            </column>
            <column caption='DLP threshold' datatype='real' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.7'>
              <calculation class='tableau' formula='0.7' />
            </column>
            <column caption='DLP Payout' datatype='real' name='[Vendor Excellence Payout (copy)_165999874453667853]' param-domain-type='any' role='measure' type='quantitative' value='5000.'>
              <calculation class='tableau' formula='5000.' />
            </column>
            <column caption='PU Payout' datatype='real' name='[vendor_excellence_payout (copy)_165999872321970177]' param-domain-type='any' role='measure' type='quantitative' value='600.'>
              <calculation class='tableau' formula='600.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1v9gx3l0hc5eti10bb46s0fji1xk'>
            <column caption='is_eligible_activation' datatype='boolean' name='[Calculation_1620169970031829002]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    [count_reg_restro (copy)_1620169970023215113] &gt;= CEILING([Parameters].[Outlet Count Min Target (copy)_165999875472441364]*[Parameters].[Parameter 2])&#10;)&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='pct_pickup_opt_in' datatype='real' name='[Calculation_1620169970037551116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;    MIN([count_vb (copy)_165999875487719450],5) + [count_ed (copy)_1620169970018902019],&#10;    0        &#10;) / &#10;[count_reg_restro (copy)_1620169970023215113]' />
            </column>
            <column caption='multiplier' datatype='real' name='[Calculation_1620169970038751245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1620169970031829002]&#10;THEN (&#10;    IF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 0.75 &#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 0.8 &#10;    )&#10;    THEN 0.5&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 0.8 &#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 0.9 &#10;    )&#10;    THEN 0.7&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 0.9&#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt;= 1 &#10;    )&#10;    THEN 1&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt; 1&#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 1.2&#10;    )&#10;    THEN 1.3&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt;= 1.2&#10;        AND [count_reg_restro (copy)_1620169970023215113]/25 &lt; 1.5&#10;    )&#10;    THEN 1.5&#10;    ELSEIF (&#10;        [count_reg_restro (copy)_1620169970023215113]/25 &gt; 1.5&#10;    )&#10;    THEN 2&#10;    END&#10;)&#10;ELSE 0&#10;END' />
            </column>
            <column caption='payment_reg_outlet_lvl' datatype='real' name='[Calculation_1620169970053869586]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_1620169970055938067] = &apos;gtc&apos; AND [signing_type] = &quot;regular_restaurant&quot;&#10;THEN (&#10;    (&#10;        IF [cur_vendor_grade] = &apos;A&apos; THEN [Parameters].[Parameter 1] &#10;        ELSEIF  [cur_vendor_grade] = &apos;B&apos; THEN [Parameters].[GTC A Payout (copy)_1620169970057117716]&#10;        ELSEIF  [cur_vendor_grade] = &apos;C&apos; THEN [Parameters].[GTC B Payout (copy)_1620169970058919957]&#10;        ELSE 0 &#10;        END&#10;    )&#10;)&#10;ELSEIF [Calculation_1620169970055938067] = &apos;gtm&apos; AND [signing_type] = &quot;regular_restaurant&quot;&#10;THEN (&#10;    (&#10;        IF [cur_vendor_grade] = &apos;A&apos; THEN [Parameters].[GTC C Payout (copy) (copy)_1620169970060890136] &#10;        ELSEIF  [cur_vendor_grade] = &apos;B&apos; THEN [Parameters].[GTC C Payout (copy) (copy) (copy)_1620169970060894233]&#10;        ELSEIF  [cur_vendor_grade] = &apos;C&apos; THEN [Parameters].[GTC C Payout (copy)_1620169970060881943]&#10;        ELSE 0 &#10;        END&#10;    ) &#10;) END' />
            </column>
            <column caption='competition_type' datatype='string' name='[Calculation_1620169970055938067]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF(&#10;    [is_on_keeta] = TRUE&#10;)&#10;THEN &quot;gtc&quot;&#10;ELSE &apos;gtm&apos;&#10;END' />
            </column>
            <column caption='Total VFD Payout' datatype='real' name='[Calculation_165999872322437122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#10;    [is_eligible_for_incentive (copy)_1620169970050498576] = TRUE&#10;)&#10;THEN (&#10;    // Regular restro&#10;    SUM(&#10;        IF  &#10;            [has_vfd] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;            AND NOT ISNULL([cur_vendor_grade]) &#10;            AND [signing_type] = &apos;regular_restaurant&apos;&#10;        THEN [Parameters].[GTM C Payout (copy)_165999872320962560]&#10;        ELSE 0&#10;        END&#10;    )&#10;) + &#10;(&#10;    // Virtual Restaurant&#10;    SUM(&#10;        IF  &#10;            [has_vfd] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;            AND NOT ISNULL([cur_vendor_grade]) &#10;            AND [signing_type] = &apos;virtual_brand&apos;&#10;            AND [rn_vendor_grade_by_type] &lt;=5&#10;        THEN [Parameters].[GTM C Payout (copy)_165999872320962560]&#10;        ELSE 0&#10;        END&#10;    )&#10;)&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Vendor Lvl DLP Coverage' datatype='real' name='[Calculation_165999874449780741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [grid]:&#10;sum([num_pre_act_menu_images]) / sum([num_pre_act_menu_items])}' />
            </column>
            <column caption='% activation &gt;= DLP threshold' datatype='real' name='[Calculation_165999874452074505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([count_pu_reg_restro  (copy)_165999875494391837] + MIN([count_pu_vb (copy)_165999875494748190],5))&#10;/&#10;[count_reg_restro (copy)_1620169970023215113]' />
            </column>
            <column caption='Total Activation Payout' datatype='real' name='[Calculation_165999875470323730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#10;    [Calculation_1620169970031829002] = TRUE&#10;)&#10;THEN &#10;([Calculation_1620169970038751245] * &#10;(&#10;    (&#10;        // Regular restro&#10;        SUM(&#10;            IF  &#10;                [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;                AND NOT ISNULL([cur_vendor_grade]) &#10;                AND [signing_type] = &apos;regular_restaurant&apos;&#10;            THEN [Calculation_1620169970053869586]&#10;            ELSE 0&#10;            END&#10;        )   &#10;    )&#10;     + &#10;    (&#10;        // Virtual Restaurant&#10;        SUM(&#10;            IF  &#10;                [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;                AND NOT ISNULL([cur_vendor_grade]) &#10;                AND [signing_type] = &apos;virtual_brand&apos;&#10;                AND [rn_vendor_grade_by_type] &lt;=5&#10;            THEN [payment_reg_outlet_lvl (copy)_165999875481313301]&#10;            ELSE 0&#10;            END&#10;        )&#10;    )&#10;))&#10;&#10;ELSE 0&#10;END' />
            </column>
            <column caption='non_activation_payout' datatype='real' name='[Calculation_2330542450265583616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total VFD Payout (copy)_165999874453446668]+[Total VFD Payout (copy)_165999872323379203]+[Calculation_165999872322437122]' />
            </column>
            <column caption='Total Pu Payout ' datatype='real' name='[Total VFD Payout (copy)_165999872323379203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#10;    [is_eligible_for_incentive (copy)_1620169970050498576] = TRUE&#10;)&#10;THEN (&#10;    // Regular restro&#10;    SUM(&#10;        IF  &#10;            [has_pu] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;            AND NOT ISNULL([cur_vendor_grade])      &#10;            AND [signing_type] = &apos;regular_restaurant&apos;&#10;        THEN [Parameters].[vendor_excellence_payout (copy)_165999872321970177]&#10;        ELSE 0&#10;        END&#10;    )&#10;) + &#10;(&#10;    // Virtual Restaurant&#10;    SUM(&#10;        IF  &#10;            [has_pu] = TRUE &#10;            AND [cur_vendor_grade] &lt;&gt; &apos;D&apos; &#10;            AND NOT ISNULL([cur_vendor_grade]) &#10;            AND [signing_type] = &apos;virtual_brand&apos;&#10;            AND [rn_vendor_grade_by_type] &lt;=5&#10;        THEN [Parameters].[vendor_excellence_payout (copy)_165999872321970177]&#10;        ELSE 0&#10;        END&#10;    )&#10;)&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Total DLP Payout' datatype='real' name='[Total VFD Payout (copy)_165999874453446668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (&#10;    [is_eligible_for_pu_bonus (copy)_165999874453123083] = TRUE&#10;)&#10;THEN (&#10;    [Parameters].[Vendor Excellence Payout (copy)_165999874453667853]&#10;)&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Close Month' datatype='date' name='[close_month]' role='dimension' type='ordinal' />
            <column caption='count_vb' datatype='integer' name='[count_ed (copy) (copy)_1620169970018910212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [signing_type] = &apos;virtual_brand&apos; &#10;    AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;    THEN [grid] &#10;    ELSE NULL &#10;    END&#10;)' />
            </column>
            <column caption='count_reg_restro' datatype='integer' name='[count_ed (copy)_1620169970018902019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [signing_type] = &apos;regular_restaurant&apos; &#10;    AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;    THEN [grid] &#10;    ELSE NULL &#10;    END&#10;)' />
            </column>
            <column caption='count_dlp_reg_restro' datatype='integer' name='[count_pu_reg_restro  (copy)_165999875494391837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [signing_type] = &apos;regular_restaurant&apos; &#10;    AND [Calculation_165999874449780741] &gt;= [Parameters].[Parameter 3]&#10;    AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;    THEN [grid] &#10;    ELSE NULL &#10;    END&#10;)' />
            </column>
            <column caption='count_dlp_vb' datatype='integer' name='[count_pu_vb (copy)_165999875494748190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [signing_type] = &apos;virtual_brand&apos; &#10;    AND [Calculation_165999874449780741] &gt;= [Parameters].[Parameter 3]&#10;    AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;    THEN [grid] &#10;    ELSE NULL &#10;    END&#10;)' />
            </column>
            <column caption='count_total_signing' datatype='integer' name='[count_reg_restro (copy)_1620169970023215113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[count_ed (copy)_1620169970018902019] +&#10;IFNULL(&#10;    MIN([count_ed (copy) (copy)_1620169970018910212], 5),&#10;    0&#10;)' />
            </column>
            <column caption='count_pu_vb' datatype='integer' name='[count_vb (copy)_165999875487719450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [signing_type] = &apos;virtual_brand&apos; &#10;    AND [has_pu] &#10;    AND [cur_vendor_grade] &lt;&gt; &apos;D&apos;&#10;    THEN [grid] &#10;    ELSE NULL &#10;    END&#10;)' />
            </column>
            <column caption='Cur Vendor Grade' datatype='string' name='[cur_vendor_grade]' role='dimension' type='nominal' />
            <column caption='Grid' datatype='string' name='[grid]' role='dimension' type='nominal' />
            <column caption='Has Pu' datatype='boolean' name='[has_pu]' role='dimension' type='nominal' />
            <column caption='Has Vfd' datatype='boolean' name='[has_vfd]' role='dimension' type='nominal' />
            <column caption='is_eligible_pu' datatype='boolean' name='[is_eligible_for_incentive (copy)_1620169970050498576]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    [Calculation_1620169970037551116] &gt;= 0.8&#10;    AND [count_reg_restro (copy)_1620169970023215113] &gt;= 10&#10;)&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='is_eligible_dlp' datatype='boolean' name='[is_eligible_for_pu_bonus (copy)_165999874453123083]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    [Calculation_165999874452074505] &gt;= 0.7&#10;)&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Is On Keeta' datatype='boolean' name='[is_on_keeta]' role='dimension' type='nominal' />
            <column-instance column='[close_month]' derivation='None' name='[none:close_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[owner_name]' derivation='None' name='[none:owner_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[num_pre_act_menu_images]' role='measure' type='quantitative' />
            <column datatype='integer' name='[num_pre_act_menu_items]' role='measure' type='quantitative' />
            <column caption='Owner Name' datatype='string' name='[owner_name]' role='dimension' type='nominal' />
            <column caption='payment_vb_outlet_lvl' datatype='real' name='[payment_reg_outlet_lvl (copy)_165999875481313301]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_1620169970055938067] = &apos;gtc&apos; AND [signing_type] = &quot;virtual_brand&quot; AND [rn_vendor_grade_by_type] &lt;=5&#10;THEN (&#10;    (&#10;        IF [cur_vendor_grade] = &apos;A&apos; THEN [Parameters].[Parameter 1] &#10;        ELSEIF  [cur_vendor_grade] = &apos;B&apos; THEN [Parameters].[GTC A Payout (copy)_1620169970057117716]&#10;        ELSEIF  [cur_vendor_grade] = &apos;C&apos; THEN [Parameters].[GTC B Payout (copy)_1620169970058919957]&#10;        ELSE 0 &#10;        END&#10;    )&#10;)&#10;ELSEIF [Calculation_1620169970055938067] = &apos;gtm&apos; AND [signing_type] = &quot;virtual_brand&quot; AND [rn_vendor_grade_by_type] &lt;=5&#10;THEN (&#10;    (&#10;        IF [cur_vendor_grade] = &apos;A&apos; THEN [Parameters].[GTC C Payout (copy) (copy)_1620169970060890136] &#10;        ELSEIF  [cur_vendor_grade] = &apos;B&apos; THEN [Parameters].[GTC C Payout (copy) (copy) (copy)_1620169970060894233]&#10;        ELSEIF  [cur_vendor_grade] = &apos;C&apos; THEN [Parameters].[GTC C Payout (copy)_1620169970060881943]&#10;        ELSE 0 &#10;        END&#10;    ) &#10;) END' />
            </column>
            <column datatype='integer' name='[rn_vendor_grade_by_type]' role='measure' type='quantitative' />
            <column caption='Signing Type' datatype='string' name='[signing_type]' role='dimension' type='nominal' />
            <column caption='Team' datatype='string' name='[team]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_165999875470323730]' derivation='User' name='[usr:Calculation_165999875470323730:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2330542450265583616]' derivation='User' name='[usr:Calculation_2330542450265583616:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
