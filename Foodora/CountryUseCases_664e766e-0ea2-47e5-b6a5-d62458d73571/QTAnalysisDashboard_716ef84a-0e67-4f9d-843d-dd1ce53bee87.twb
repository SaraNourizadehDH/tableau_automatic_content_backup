      <column caption='icpgmv ' datatype='real' default-format='p0.00%' name='[Calculation_240661116018298881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([incentive_cost])/sum([gmv_incl_subsidies])' />
      </column>
      <column caption='Local SG&amp;A/GMV' datatype='real' default-format='p0.00%' name='[Calculation_240661116020088834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-sum([local_sga])/sum([gmv_incl_subsidies])' />
      </column>
      <column caption='FLGP' datatype='real' name='[Calculation_240661116020813827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gross_profit])+sum([incentive_cost])' />
      </column>
