    <worksheet name='icpGMV - perf'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>iCPGMV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Extract 1 (Lucanet CT vs Actuals - CIO team)' name='federated.1405muc0171rz318n3crv0sqby0f' />
          </datasources>
          <datasource-dependencies datasource='federated.1405muc0171rz318n3crv0sqby0f'>
            <column caption='icpgmv ' datatype='real' default-format='p0.00%' name='[Calculation_240661116018298881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([incentive_cost])/sum([gmv_incl_subsidies])' />
            </column>
            <column caption='Market' datatype='string' name='[Country (copy) (group)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[Country (copy)_240661116015980544]' new-bin='true'>
                <bin default-name='false' value='&quot;APAC Hub Costs&quot;'>
                  <value>&quot;DH APAC&quot;</value>
                  <value>&quot;SSC Malaysia&quot;</value>
                  <value>&quot;Woowa DH Asia&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Markets&quot;'>
                  <value>&quot;Bangladesh&quot;</value>
                  <value>&quot;Cambodia&quot;</value>
                  <value>&quot;Hong Kong&quot;</value>
                  <value>&quot;Japan&quot;</value>
                  <value>&quot;Laos&quot;</value>
                  <value>&quot;Malaysia&quot;</value>
                  <value>&quot;Myanmar&quot;</value>
                  <value>&quot;Pakistan&quot;</value>
                  <value>&quot;Philippines&quot;</value>
                  <value>&quot;Singapore&quot;</value>
                  <value>&quot;Taiwan&quot;</value>
                  <value>&quot;Thailand&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Country (copy)' datatype='string' name='[Country (copy)_240661116015980544]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country]' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Currency' datatype='string' name='[currency]' role='dimension' type='nominal' />
            <column caption='Net GMV' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[gmv_incl_subsidies]' role='measure' type='quantitative' />
            <column caption='Incentive Cost' datatype='real' name='[incentive_cost]' role='measure' type='quantitative' />
            <column caption='Months' datatype='date' name='[months]' role='dimension' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
