      <column caption='Targets' datatype='string' name='[Calculation_1317021451916238851]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATE([Month Year])&lt;Date(&apos;2022-07-01&apos;) AND [Calculation_1132092371777302529]=&apos;2022, CT 03&apos; then &apos;Targets&apos;&#13;&#10;&#13;&#10;ELSEIF DATE([Month Year])&lt;Date(&apos;2022-10-01&apos;) &#13;&#10;        AND DATE([Month Year])&gt;=Date(&apos;2022-07-01&apos;)  &#13;&#10;        AND [Calculation_1132092371777302529]=&apos;2022, CT 06 Final V1&apos;&#13;&#10;    then &apos;Targets&apos;&#13;&#10;&#13;&#10;ELSEIF DATE([Month Year])&lt;Date(&apos;2023-01-01&apos;) &#13;&#10;        AND DATE([Month Year])&gt;=Date(&apos;2022-10-01&apos;)  &#13;&#10;        AND [Calculation_1132092371777302529]=&apos;2022, CT 09 Final&apos;&#13;&#10;    then &apos;Targets&apos;&#13;&#10;&#13;&#10;ELSEIF DATE([Month Year])&lt;Date(&apos;2022-10-01&apos;) &#13;&#10;        AND DATE([Month Year])&gt;=Date(&apos;2022-01-01&apos;)  &#13;&#10;        AND [Calculation_1132092371777302529]=&apos;2022, CT 09 Final&apos;&#13;&#10;    then &apos;Actuals&apos;&#13;&#10;&#13;&#10;Else &apos;Others&apos; END' />
      </column>
      <column caption='Type - Actual' datatype='string' name='[Calculation_1766818443389870080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1132092371777302529] + &apos;-&apos; + [Actual]' />
      </column>
      <column caption='Del Fee Platform/Order' datatype='real' name='[Calculation_597008441755676672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Delivery Fee Platform (excl. PandaGo)])/SUM([Total Orders])' />
      </column>
      <column caption='OD GFV %' datatype='real' default-format='p0.00%' name='[Calculation_644296231601504256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([OD GFV])/sum([Total GFV])' />
      </column>
      <column caption='GFV Trend Line' datatype='integer' name='[Calculation_644296231608061958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;OD&apos; then [OD GFV]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Kitchens&apos; then [Kitchens GFV]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Pickup&apos; then [PU GFV]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Other MP&apos; then [Other MP GFV]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Dmart&apos; then [Dmart GFV]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Groceries&apos; then [Groceries OD GFV]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Total&apos; then [Total GFV]&#13;&#10;END' />
      </column>
      <column caption='OD Orders %' datatype='real' default-format='p0.00%' name='[Calculation_644296231614074887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([- OD Food Orders])/sum([Total Orders])' />
