WHEN ops.sessions >>= 747 AND ops.sessions <<= 1289 THEN "Level 3: 40th-60th Percentile"
WHEN ops.sessions >>= 1290 AND ops.sessions <<= 2557 THEN "Level 2: 60th-80th Percentile"
WHEN ops.sessions >>= 2558 THEN "Level 1: >>80th Percentile"
END
