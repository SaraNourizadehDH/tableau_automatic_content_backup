IF(ROUND(IFNULL(ihs.overall_ihs, 0), 2) >>= 4, "Healthy Vendor", "Unhealthy Vendor") AS healthy_ihs_vendor,
FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_monthly` AS ops
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vkam_monthly` AS ihs
ON ihs.report_month = ops.report_month
AND ihs.pd_vendor_uuid = ops.pd_vendor_uuid
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_zombie_monthly_grade` AS zombie
ON zombie.report_month = ops.report_month
AND zombie.pd_vendor_uuid = ops.pd_vendor_uuid
)
,
final as (
SELECT report_month,is_order_generating_vendor,count(distinct vendor_code) as vc,FROM vendor_perf
WHERE global_entity_id = 'FP_PK'
AND is_order_generating_vendor is true
AND report_month >>= '2025-01-01'
GROUP BY pd_vendor_uuid,report_month,vendor_type_breakdown,is_order_generating_vendor,vendor_code
QUALIFY ROW_NUMBER() OVER (PARTITION BY report_month, pd_vendor_uuid) = 1
)
SELECT report_month,sum(vc) as order_generating_vendors from final
group by all]]></relation>
