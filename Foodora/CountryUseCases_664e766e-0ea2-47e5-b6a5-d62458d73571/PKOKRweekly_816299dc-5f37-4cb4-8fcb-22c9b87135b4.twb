          <map key='[ABS_WOW_qc_mau_share]' value='[Custom SQL Query].[ABS_WOW_qc_mau_share]' />
          <map key='[ABS_WOW_retention_rate]' value='[Custom SQL Query].[ABS_WOW_retention_rate]' />
          <map key='[ABS_WOW_shrinkage (Custom SQL Query)]' value='[Custom SQL Query].[ABS_WOW_shrinkage]' />
          <map key='[ABS_WOW_stacking (Custom SQL Query)]' value='[Custom SQL Query].[ABS_WOW_stacking]' />
          <map key='[ABS_WOW_sum_acq_rea]' value='[Custom SQL Query].[ABS_WOW_sum_acq_rea]' />
          <map key='[ABS_WOW_total_active_ab_vendors]' value='[Custom SQL Query].[ABS_WOW_total_active_ab_vendors]' />
          <map key='[ABS_WOW_total_active_cd_vendors]' value='[Custom SQL Query].[ABS_WOW_total_active_cd_vendors]' />
          <map key='[ABS_WOW_total_active_vendors]' value='[Custom SQL Query].[ABS_WOW_total_active_vendors]' />
          <map key='[ABS_WOW_total_vendor_aquisitions]' value='[Custom SQL Query].[ABS_WOW_total_vendor_aquisitions]' />
          <map key='[ABS_WOW_total_vendors_zombies_calc]' value='[Custom SQL Query].[ABS_WOW_total_vendors_zombies_calc]' />
          <map key='[ABS_WOW_vfd_incentive_cost]' value='[Custom SQL Query].[ABS_WOW_vfd_incentive_cost]' />
          <map key='[ABS_WOW_zombie_perc]' value='[Custom SQL Query].[ABS_WOW_zombie_perc]' />
          <map key='[ABS_WOW_zombie_vendors]' value='[Custom SQL Query].[ABS_WOW_zombie_vendors]' />
          <map key='[ABS_order_generating_vendors]' value='[Custom SQL Query].[ABS_order_generating_vendors]' />
          <map key='[ABS_sum_acq_rea]' value='[Custom SQL Query].[ABS_sum_acq_rea]' />
          <map key='[ABS_vfd_gmv_percentage]' value='[Custom SQL Query].[ABS_vfd_gmv_percentage]' />
          <map key='[AB_zombie_percentage]' value='[Custom SQL Query].[AB_zombie_percentage]' />
          <map key='[MAU]' value='[Custom SQL Query].[MAU]' />
