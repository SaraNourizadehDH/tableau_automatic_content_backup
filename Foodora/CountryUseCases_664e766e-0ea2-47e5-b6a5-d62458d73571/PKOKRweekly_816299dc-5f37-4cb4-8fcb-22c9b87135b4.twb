  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Parameter 1' datatype='real' default-format='*' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='1.0'>
