THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 10.9, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_HK"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 10.7, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_LA"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 12.2, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_MY"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 8.6, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_MM"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 7.8, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_PK"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 7.1, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_PH"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 7.7, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_SG"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 11.2, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_TW"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 12.9, "Low CVR Generating Vendor", "High CVR Generating Vendor")
WHEN ops.global_entity_id = "FP_TH"
THEN IF(IFNULL(ROUND((SAFE_DIVIDE(ops.conversions, ops.sessions))*100,2), 0) <<= 13, "Low CVR Generating Vendor", "High CVR Generating Vendor")
END AS cvr_generating_vendors_50_percentile,
ihs.overall_ihs,
ops.vendor_type,
ops.country_iso_code,
ops.city_id,
ops.primary_cuisine,
ops.vendor_performance_type,
ops.is_long_tail_vendor,
zombie.zombie_age_group,
zombie.zombie_grade,
IF(ROUND(IFNULL(ihs.overall_ihs, 0), 2) >>= 4, "Healthy Vendor", "Unhealthy Vendor") AS healthy_ihs_vendor,
FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_monthly` AS ops
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vkam_monthly` AS ihs
ON ihs.report_month = ops.report_month
AND ihs.pd_vendor_uuid = ops.pd_vendor_uuid
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_zombie_monthly_grade` AS zombie
ON zombie.report_month = ops.report_month
AND zombie.pd_vendor_uuid = ops.pd_vendor_uuid
)
,
final as (
SELECT report_month,is_order_generating_vendor,count(distinct vendor_code) as vc,FROM vendor_perf
WHERE global_entity_id = 'FP_PK'
AND is_order_generating_vendor is true
AND report_month >>= '2025-01-01'
GROUP BY pd_vendor_uuid,report_month,vendor_type_breakdown,is_order_generating_vendor,vendor_code
QUALIFY ROW_NUMBER() OVER (PARTITION BY report_month, pd_vendor_uuid) = 1
)
SELECT report_month,sum(vc) as order_generating_vendors from final
group by all]]></relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
