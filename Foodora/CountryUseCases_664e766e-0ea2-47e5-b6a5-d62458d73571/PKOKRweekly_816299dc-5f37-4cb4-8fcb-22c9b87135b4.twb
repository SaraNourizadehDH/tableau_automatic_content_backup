      <column caption='cus %' datatype='real' name='[Calculation_190558573576708101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cus_fail]/[Gross_orders]' />
      </column>
      <column caption='VFD vendor %' datatype='real' name='[Calculation_2808346219028070400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vf_vendors])&#10;/&#10;SUM([vendors])' />
      </column>
      <column caption='Acq + Reqacq' datatype='integer' name='[Calculation_2808346219029352449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull([acquisitions],0) + ifnull([reacquisitions],0)' />
      </column>
      <column caption='AB Zombie %' datatype='real' name='[Calculation_2808346219039674370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ab_zombie_vendors])&#10;/&#10;sum([total_vendors_zombies_calc])' />
      </column>
      <column caption='Previous Week Filter' datatype='boolean' name='[Calculation_2808346219042344963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[Week]) = DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -1, TODAY()))' />
      </column>
      <column caption='MAU WoW' datatype='real' name='[Calculation_2808346219042824196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Week]= DATETRUNC(&apos;week&apos;,  DATEADD(&apos;week&apos;, -1, TODAY())) THEN [MAU] END) &#10;- SUM(IF [Week]= DATETRUNC(&apos;week&apos;,  DATEADD(&apos;week&apos;, -2, TODAY())) THEN [MAU] END)) &#10;/ &#10;SUM(IF [Week]= DATETRUNC(&apos;week&apos;,  DATEADD(&apos;week&apos;, -2, TODAY())) THEN [MAU] END)' />
      </column>
      <column caption='Previous Week' datatype='datetime' name='[Calculation_2808346219054923782]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, TODAY()) - 7' />
      </column>
      <column caption='MAU previous Week' datatype='integer' name='[Calculation_2808346219055857671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([MAU]), -1)'>
          <table-calc ordering-type='Rows' />
