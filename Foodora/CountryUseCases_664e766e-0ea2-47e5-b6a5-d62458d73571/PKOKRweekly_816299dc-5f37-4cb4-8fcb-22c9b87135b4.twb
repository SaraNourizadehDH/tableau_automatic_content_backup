      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-aliased-fields='true' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='OKRs' id='_4304A8A86A2341A7A585C8F9ABF6139F'>
            <properties context=''>
              <relation connection='bigquery.0rmhls11jnrigs1dhzpjb0wqzi82' name='Custom SQL Query' type='text'><![CDATA[With ambitition as (  ---first metric OKR Dashboard
  SELECT
  -- o.created_date_local,
  DATE_TRUNC(o.created_date_local, isoweek) Week,
  o.global_entity_id,
    COUNT(DISTINCT IF(o.is_successful AND o.is_acquisition, o.analytical_customer_id,null)) acquisitions,
    COUNT(DISTINCT CASE WHEN o.is_successful THEN o.analytical_customer_id END) MAU,
    SUM(CASE WHEN o.is_successful IS TRUE THEN o.user_paid_gmv_eur END) AS gmv,
    SUM(CASE WHEN o.is_successful IS TRUE THEN o.user_paid_gmv_local END) AS gmv_local,
    COUNT(DISTINCT CASE WHEN o.is_successful IS TRUE AND o.business_type IN ('dmart', 'shops') THEN o.analytical_customer_id END) AS qc_mau,
    SUM(CASE WHEN o.is_successful IS TRUE AND o.business_type IN ('dmart', 'shops')  THEN o.user_paid_gmv_eur END) as qc_gmv,
      SUM(CASE WHEN o.is_successful IS TRUE AND o.business_type IN ('dmart', 'shops')  THEN  o.user_paid_gmv_local END) as qc_gmv_local,
    SAFE_DIVIDE(
    COUNT(DISTINCT CASE WHEN o.is_successful IS TRUE AND o.business_type IN ('dmart', 'shops')  THEN o.analytical_customer_id END),
    COUNT(DISTINCT CASE WHEN o.is_successful IS TRUE THEN o.analytical_customer_id END)
    ) AS qc_mau_share,
    SAFE_DIVIDE(
    SUM(CASE WHEN o.is_successful IS TRUE AND o.business_type IN ('dmart', 'shops')  THEN o.user_paid_gmv_eur END),
    SUM(CASE WHEN o.is_successful IS TRUE THEN o.user_paid_gmv_eur END)
    ) AS qc_gmv_share,
    COUNT(DISTINCT CASE WHEN o.is_successful THEN o.order_code END) AS orders
        
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o

WHERE o.created_date_local >>= '2025-01-01'
AND o.global_entity_id = 'FP_PK'
GROUP BY
1, 2
order by 1 desc
 )
 ,
 affordability as ( ---Second metric OKR Dashboard
  select 
  Date_trunc(created_date_local,isoweek) as vfd_week,
  SUM(gmv_eur) AS VFD_gmv,
  SUM(total_incentive_cost_vendor_eur) vfd_incentive_cost,
  sum(vf_vendors) AS vf_vendors,
  SUM(vendors) AS vendors,
  SUM(vf_vendors)/sum(vendors) as Vendor_pentration_percentage,
  SAFE_DIVIDE(SUM(total_incentive_cost_vendor_eur),SUM(gmv_eur)) vfd_gmv_percentage,
  (sum(targeted_orders)/sum(orders)) as targeted_orders
from
`fulfillment-dwh-production.pandata_report.commercial__vfd_dash_report` v

WHERE global_entity_id = 'FP_PK' 
AND granularity = 'weekly'
-- AND geo_granularity = 'country'
AND created_date_local >>= '2025-01-01'
GROUP BY 1
ORDER BY 1
 )
 ,
 seemless_del as ( ---third metric OKR Dashboard
  WITh weekly_fails as (
SELECT report_week_local, 
-- SUM(gross_order_count) gross_order_count, 
-- SUM(successful_order_count) successful_order_count, 
SAFE_DIVIDE(SUM(failed_order_count),SUM(gross_order_count)) fail_rate FROM 
`fulfillment-dwh-production.pandata_datamart.pandora__agg_order_metrics_daily`
WHERE global_entity_id = 'FP_PK'
AND report_week_local >>= '2025-01-01'
GROUP BY 1
ORDER BY 1
)
,
weekly_on_time as (
  SELECT report_week_local,
IFNULL(
      SAFE_DIVIDE(
          SUM(pdt_bucket_10_is_order_on_time_within_10_minutes_n), 
          SUM(pdt_bucket_10_is_order_on_time_within_10_minutes_d)
      ) * MAX(pdt_bucket_10_is_order_on_time_weight),
      0
    )
    + 
    IFNULL(
      SAFE_DIVIDE(
          SUM(pdt_bucket_20_is_order_on_time_within_10_minutes_n), 
          SUM(pdt_bucket_20_is_order_on_time_within_10_minutes_d)
      ) * MAX(pdt_bucket_20_is_order_on_time_weight),
      0
    )
    +
    IFNULL(
      SAFE_DIVIDE(
          SUM(pdt_bucket_30_is_order_on_time_within_10_minutes_n), 
          SUM(pdt_bucket_30_is_order_on_time_within_10_minutes_d)
      ) * MAX(pdt_bucket_30_is_order_on_time_weight),
      0
    )
    +
    IFNULL(
      SAFE_DIVIDE(
          SUM(pdt_bucket_40_is_order_on_time_within_10_minutes_n), 
          SUM(pdt_bucket_40_is_order_on_time_within_10_minutes_d)
      ) * MAX(pdt_bucket_40_is_order_on_time_weight),
      0
    )
    +
    IFNULL(
      SAFE_DIVIDE(
          SUM(pdt_bucket_50_is_order_on_time_within_10_minutes_n), 
          SUM(pdt_bucket_50_is_order_on_time_within_10_minutes_d)
      ) * MAX(pdt_bucket_50_is_order_on_time_weight),
      0
    )
    +
    IFNULL(
      SAFE_DIVIDE(
          SUM(pdt_bucket_60_is_order_on_time_within_10_minutes_n), 
          SUM(pdt_bucket_60_is_order_on_time_within_10_minutes_d)
      ) * MAX(pdt_bucket_60_is_order_on_time_weight),
      0
    ) on_time_pct 
    FROM 
`fulfillment-dwh-production.pandata_datamart.pandora__agg_logistics_order_metrics_daily`
WHERE global_entity_id = 'FP_PK'
and report_week_local >>= '2025-01-01'
GROUP BY 1
ORDER BY 1
)
SELECT weekly_fails.report_week_local,fail_rate,on_time_pct FROM weekly_fails
LEFT JOIN weekly_on_time
ON weekly_on_time.report_week_local = weekly_fails.report_week_local)
,
best_expienence as (  ---fourth metric OKR Dashboard
  with bs as (
  With retention as (WITH customers AS (
  SELECT DISTINCT
    ord.global_entity_id,
    DATE_TRUNC(ord.created_date_local, isoweek) report_week,
    ord.analytical_customer_id
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` ord
  -- WHERE DATE_TRUNC(ord.created_date_local, MONTH) BETWEEN "2023-11-01" AND "2025-12-01"
  WHERE ord.created_date_local >>= '2025-01-01'
    AND ord.is_successful

)
  SELECT
    DATE_ADD(a.report_week, INTERVAL 1 week) as week, -- need to check this neha 
    a.global_entity_id,
    a.report_week,
    -- a.report_month AS current_month, -- represents the actual current month
    COUNT(DISTINCT a.analytical_customer_id) AS prev_customers,
    COUNT(DISTINCT b.analytical_customer_id) AS reorders,
    SAFE_DIVIDE(COUNT(DISTINCT b.analytical_customer_id),COUNT(DISTINCT a.analytical_customer_id)) AS retention_rate
FROM customers a
LEFT JOIN customers b
    ON b.analytical_customer_id = a.analytical_customer_id
    AND b.report_week = DATE_SUB(a.report_week, INTERVAL -1 week)
WHERE a.global_entity_id = "FP_PK"
GROUP BY ALL
ORDER BY 2,1 desc
)
,
acquisition as (SELECT
    global_entity_id,
    DATE_TRUNC(op_closed_date, isoweek) AS week,
    COUNT(DISTINCT IF(lead_source IN ('SSU lead', 'Web to Lead'), lead_id, NULL)) AS SSU_acquisition,
    COUNT(DISTINCT lead_id) AS Total_acquisition,
    SAFE_DIVIDE(
      COUNT(DISTINCT IF(lead_source IN ('SSU lead', 'Web to Lead'), lead_id, NULL)),
      COUNT(DISTINCT lead_id)
    ) AS SSU_acquisition_share
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_gen_detail`
  WHERE op_closed_date >>= '2025-01-01'
    AND op_closed_won = 'Closed Won'
    AND global_entity_id = 'FP_PK'
  GROUP BY global_entity_id, week)
,
reacquisition as (
WITH reacquisition_prep as (
   SELECT
global_entity_id,
date_trunc(created_date_local, isoweek) as week,
IFNULL(DATE_DIFF(o.created_date_local, o.previous_order_date, day) >> 365, FALSE) as is_reacquisition
, analytical_customer_id
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
WHERE created_date_local >>= "2025-01-01"
and is_successful
AND global_entity_id = 'FP_PK'

)
-- , reacquisitions as
--  ( 
  SELECT
 global_entity_id 
 , week 
 , count(distinct analytical_customer_id) AS reacquisitions
 from  reacquisition_prep

 where  is_reacquisition

 group by 1,2)

SELECT * from retention
LEFT JOIN acquisition
on acquisition.week = retention.report_week
LEFT JOIN reacquisition
on reacquisition.week = retention.report_week
)
SELECT report_week,prev_customers,reorders,retention_rate,SSU_acquisition,Total_acquisition,SSU_acquisition_share,reacquisitions FROM 
bs
)
,
choices as (
  with choice as (
  with ab_acq as (
    WITH lao_base AS (SELECT
  DATE_TRUNC(activation_date, isoweek) AS activation_week,
  DATE_TRUNC(incubated_date_60_days, MONTH) AS incubated_60d_month,
  vendor_grade,
  global_entity_id,
  country,
  vertical_segment,
  sf_opportunity_id,
  user_type,
  sf_opportunity_owner_id,
  num_f60d_valid_orders
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated`
WHERE is_closed
  AND is_won
  AND opportunity_business_type IN ("New Business", "Win Back")
  AND vendor_type = 'Restaurants'
  AND vertical_segment != 'caterers'
  AND DATE_TRUNC(activation_date, MONTH) >>= "2025-01-01"
)


-- ), vendor_acquisitions AS ( 
  SELECT 
    activation_week AS week,
    global_entity_id,
    COUNT(DISTINCT CASE WHEN vendor_grade IN ('A','B', 'AA', 'AAA') AND user_type in ('field rep','telesales') THEN sf_opportunity_id END) AS ab_aquisitions,
    COUNT(DISTINCT CASE WHEN vendor_grade IN ('C','D') THEN sf_opportunity_id END) AS cd_acquisitions,
    COUNT(DISTINCT sf_opportunity_id) AS total_vendor_aquisitions
  FROM lao_base
  WHERE global_entity_id = "FP_PK"
  -- WHERE vendor_grade IN ('A','B', 'AA', 'AAA') -- AA/AAA are legacy grades
  GROUP BY ALL
  )
,
act_inv as (
  WITH opt as (
 WITH ops as (
 SELECT
    date_trunc(report_date,isoweek) as report_week,
    global_entity_id,
    sf_vendor_grade,
    valid_orders,
    pd_vendor_uuid,
    -- COUNT(DISTINCT CASE WHEN sf_vendor_grade IN ('A','B', 'AA', 'AAA') and monthly_valid_orders >>= 1 THEN pd_vendor_uuid END) AS total_active_ab_vendors,
    --  COUNT(DISTINCT CASE WHEN sf_vendor_grade IN ('C','D') and monthly_valid_orders >>= 1 THEN pd_vendor_uuid END) AS total_active_cd_vendors,
    -- COUNT(DISTINCT IF(monthly_valid_orders >>= 1, pd_vendor_uuid, NULL)) AS ogv_1_order,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_daily`
  where report_date >>= "2025-01-01"
  AND global_entity_id = 'FP_PK'
  GROUP BY ALL
 )
 ,
 final as (
 SELECT 
 report_week,
 global_entity_id,
 sf_vendor_grade,
 pd_vendor_uuid,
 SUM(valid_orders) as weekly_valid_orders,
 from ops
 GROUP BY ALL
 )

 SELECT
    report_week,
    global_entity_id,
    sf_vendor_grade,
    -- valid_orders,
    pd_vendor_uuid,
    COUNT(DISTINCT CASE WHEN sf_vendor_grade IN ('A','B', 'AA', 'AAA') and weekly_valid_orders >>= 1 THEN pd_vendor_uuid END) AS total_active_ab_vendors,
     COUNT(DISTINCT CASE WHEN sf_vendor_grade IN ('C','D') and weekly_valid_orders >>= 1 THEN pd_vendor_uuid END) AS total_active_cd_vendors,
    COUNT(DISTINCT IF(weekly_valid_orders >>= 1, pd_vendor_uuid, NULL)) AS ogv_1_order,
  FROM final 
  GROUP BY ALL
)
SELECT  --apac active vendors
    opt.report_week AS act_week,
    opt.global_entity_id,
    -- ops.country,
    SUM(opt.ogv_1_order) AS total_active_vendors,
    Sum(total_active_ab_vendors) as total_active_ab_vendors,
    SUM(total_active_cd_vendors) AS total_active_cd_vendors

  FROM opt
  WHERE global_entity_id IN ("FP_PK")
  Group BY ALL
)
,
ab_zombie as (
SELECT
      date_trunc(report_date,isoweek) as zomb_WEEK,
      global_entity_id,
      COUNT(DISTINCT pd_vendor_uuid) AS total_vendors_zombies_calc,
      COUNT(DISTINCT IF (last_30days_valid_orders = 0, pd_vendor_uuid, NULL)) AS zombie_vendors,
      SAFE_DIVIDE(COUNT(DISTINCT IF (last_30days_valid_orders = 0, pd_vendor_uuid, NULL))
        , COUNT(DISTINCT pd_vendor_uuid)) AS zombie_perc,
      COUNT(DISTINCT IF (last_30days_valid_orders = 0 AND vendor_type_classification IN ("Strategic Accounts", "Key Accounts") , pd_vendor_uuid, NULL)) AS ab_zombie_vendors, -- usually GMV Class AB Vendors 
      COUNT(DISTINCT IF (last_30days_valid_orders = 0 AND vendor_type_classification IN ("Long Tail Vendor") , pd_vendor_uuid, NULL)) AS cd_zombie_vendors, -- usually GMV Class CD Vendors 
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_daily`
    WHERE report_date >>= "2025-01-01"
      AND vendor_type_breakdown != "Home Based Kitchen"
      AND global_entity_id = 'FP_PK'
    GROUP BY ALL
)
SELECT * FROM ab_acq
LEFT JOIN ab_zombie
ON ab_zombie.zomb_WEEK = ab_acq.week
LEFT JOIN act_inv
ON act_inv.act_week = ab_acq.week
)
SELECT week as choices_week,ab_aquisitions,total_vendor_aquisitions,total_vendors_zombies_calc,zombie_vendors,zombie_perc,ab_zombie_vendors,cd_zombie_vendors,total_active_vendors,total_active_ab_vendors,total_active_cd_vendors,(ab_zombie_vendors/total_vendors_zombies_calc) as AB_zombie_percentage FROM choice
)
,
ab_60 as(SELECT	
DATE_TRUNC(incubated_date_60_days, isoweek) AS ab_60_week,	
b.global_entity_id,	
a.country,	
COUNT(DISTINCT sf_opportunity_id) AS total_vendors_sf,	
COUNT(DISTINCT IF(num_f60d_valid_orders >> 75, sf_opportunity_id, NULL)) AS successful_vendors,	
SAFE_DIVIDE(COUNT(DISTINCT IF(num_f60d_valid_orders >> 75, sf_opportunity_id, NULL)), COUNT(DISTINCT sf_opportunity_id)) AS successful_ab_vendor_pcnt	
FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_incubation_cut`	as a

  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_daily` as b
      ON a.country = b.country_name 
      and DATE_TRUNC(a.incubated_date_60_days, isoweek) = Date_trunc(b.report_date,isoweek)

WHERE opportunity_business_type IN ("New Business", "Win Back")	
AND COALESCE(key_account_sub_category, "") NOT IN ("Global KA", "National KA")	
AND a.vendor_type IN ("Restaurants")	
AND has_completed_60d_incubation	
AND NOT is_terminated_within_60_days	
AND incubated_date_60_days >>= "2025-01-01"	
AND vendor_grade in ("A","AA","AAA","B") 
AND global_entity_id = 'FP_PK'
GROUP BY 1,2,3
order by 1 desc),
order_generating_vendor as (
  SELECT
    DISTINCT
    "Weekly" AS granularity, 
    ops_weekly.report_week AS report_date,
    ops_weekly.country_name,
    COUNT(DISTINCT IF(ops_weekly.weekly_valid_orders << 1, ops_weekly.pd_vendor_uuid, NULL)) AS non_order_generating_vendors,
    COUNT(DISTINCT IF(ops_weekly.weekly_valid_orders >>= 1, ops_weekly.pd_vendor_uuid, NULL)) AS order_generating_vendors,
    COUNT(DISTINCT IF(ops_weekly.weekly_valid_orders >> 10, ops_weekly.pd_vendor_uuid, NULL)) AS more_than_10order_generating_vendors,
    SUM(ops_weekly.weekly_valid_orders) AS valid_orders,
    SUM(ops_weekly.sessions) AS sessions,
    SUM(ops_weekly.conversions) AS conversions
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_info_weekly` AS ops_weekly
  WHERE ops_weekly.report_week >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 WEEK), ISOWEEK)
  AND country_name = 'Pakistan'
  GROUP BY
    granularity, 
    ops_weekly.report_week,
    ops_weekly.country_name
  ORDER BY 2
)
,
Shrinkage_surge as (
  with shrinkage as (
SELECT global_entity_id
, date_trunc(report_date_local,isoweek) as report_date_week
, sum(shrink_order_count) as shrink_orders
, sum(forecasted_adjusted_order_count) as forecasted_orders
, Safe_Divide (
    sum(shrink_order_count)
    , sum(forecasted_adjusted_order_count)
) as shrinkage

 FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_logistics_zone_metrics_daily` 
WHERE global_entity_id = 'FP_PK'
AND report_date_local >>= '2025-01-01'

GROUP BY ALL
order by 2 desc


--- Stacking -----
),  stacking as (
SELECT  global_entity_id
, date_trunc(created_date_local, isoweek) AS stacking_week 
, SUM(stacked_delivery_count) AS stacked_delivery_count
, SUM(completed_delivery_count) completed_delivery_count
, SAFE_DIVIDE (SUM(stacked_delivery_count)
  , SUM(completed_delivery_count)
) AS stacking

FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_logistics` 
WHERE created_date_local >>= "2025-01-01"
AND global_entity_id = 'FP_PK'
Group by 1,2
ORDER BY 2 desc
)
SELECT report_date_week,shrink_orders,forecasted_orders,shrinkage.shrinkage,  
  ((shrinkage.shrinkage-lag(shrinkage.shrinkage) OVER (ORDER BY report_date_week))) as WOW_shrinkage,
  ((shrinkage.shrinkage-lag(shrinkage.shrinkage) OVER (ORDER BY report_date_week)))/lag(shrinkage.shrinkage) OVER (ORDER BY report_date_week) as ABS_WOW_shrinkage,
  stacking.stacked_delivery_count,stacking.stacking,
  ((stacking.stacking-lag(stacking.stacking) OVER (ORDER BY report_date_week))) as WOW_stacking,
   ((stacking.stacking-lag(stacking.stacking) OVER (ORDER BY report_date_week)))/lag(stacking.stacking) OVER (ORDER BY report_date_week) as ABS_WOW_stacking,
   FROM shrinkage
LEFT JOIN stacking
ON stacking.global_entity_id = shrinkage.global_entity_id
and stacking.stacking_week = report_date_week
ORDER by 1 asc
)
SELECT 
  ambition.Week,
  ambition.global_entity_id,
  ambition.orders,
  (ambition.acquisitions)+(best_expienence.reacquisitions) as sum_acq_rea,
  ((ambition.acquisitions)+(best_expienence.reacquisitions)-lag((ambition.acquisitions)+(best_expienence.reacquisitions)) OVER (ORDER BY week)) AS ABS_sum_acq_rea,
  ((ambition.acquisitions)+(best_expienence.reacquisitions)-lag((ambition.acquisitions)+(best_expienence.reacquisitions)) OVER (ORDER BY week))/lag((ambition.acquisitions)+(best_expienence.reacquisitions)) OVER (ORDER BY week) AS ABS_WOW_sum_acq_rea,
  -- ((orders-lag(orders) OVER (ORDER BY week))/lag(orders) OVER (ORDER BY week)) as WOW_orders,
  (orders-lag(orders) OVER (ORDER BY week)) AS ABS_WOW_orders,
  ((orders-lag(orders) OVER (ORDER BY week))/lag(orders) OVER (ORDER BY week)) as WOW_orders,
  ambition.acquisitions,
  (acquisitions-lag(acquisitions) OVER (ORDER BY week)) AS ABS_WOW_acquisitions,
  ((acquisitions-lag(acquisitions) OVER (ORDER BY week))/lag(acquisitions) OVER (ORDER BY week)) as WOW_acquisitions,
  ambition.MAU,
  (MAU-lag(MAU) OVER (ORDER BY week)) AS ABS_WOW_MAU,
  ((MAU-lag(MAU) OVER (ORDER BY week))/lag(MAU) OVER (ORDER BY week)) as WOW_MAU,
  ambition.gmv,
  (gmv-lag(gmv) OVER (ORDER BY week)) AS ABS_WOW_GMV,
  ((gmv-lag(gmv) OVER (ORDER BY week))/lag(gmv) OVER (ORDER BY week)) as WOW_GMV,
  ambition.gmv_local,
  (gmv_local-lag(gmv_local) OVER (ORDER BY week)) AS ABS_WOW_GMV_local,
  ((gmv_local-lag(gmv_local) OVER (ORDER BY week))/lag(gmv_local) OVER (ORDER BY week)) as WOW_GMV_local,
  ambition.qc_mau,
  (qc_mau-lag(qc_mau) OVER (ORDER BY week)) AS ABS_WOW_qc_mau,
  ((qc_mau-lag(qc_mau) OVER (ORDER BY week))/lag(qc_mau) OVER (ORDER BY week)) as WOW_qc_mau,
  ambition.qc_gmv,
  (qc_gmv-lag(qc_gmv) OVER (ORDER BY week)) AS ABS_WOW_qc_gmv,
  ((qc_gmv-lag(qc_gmv) OVER (ORDER BY week))/lag(qc_gmv) OVER (ORDER BY week)) as WOW_qc_gmv,
  ambition.qc_gmv_local,
  (qc_gmv_local-lag(qc_gmv_local) OVER (ORDER BY week)) AS ABS_WOW_qc_gmv_local,
  ((qc_gmv_local-lag(qc_gmv_local) OVER (ORDER BY week))/lag(qc_gmv_local) OVER (ORDER BY week)) as WOW_qc_gmv_local,
  ambition.qc_mau_share,
  (qc_mau_share-lag(qc_mau_share) OVER (ORDER BY week)) AS WOW_qc_mau_share,
  (qc_mau_share-lag(qc_mau_share) OVER (ORDER BY week))/lag(qc_mau_share) OVER (ORDER BY week) AS ABS_WOW_qc_mau_share,
  ambition.qc_gmv_share,
  (qc_gmv_share-lag(qc_gmv_share) OVER (ORDER BY week)) AS WOW_qc_gmv_share,
  (qc_gmv_share-lag(qc_gmv_share) OVER (ORDER BY week))/lag(qc_gmv_share) OVER (ORDER BY week) AS ABS_WOW_qc_gmv_share,
  ab_60.successful_ab_vendor_pcnt,
  (ab_60.successful_ab_vendor_pcnt-lag(ab_60.successful_ab_vendor_pcnt) OVER (ORDER BY week)) AS WOW_ab_60_successful_ab_vendor_pcnt,
  (ab_60.successful_ab_vendor_pcnt-lag(ab_60.successful_ab_vendor_pcnt) OVER (ORDER BY week))/lag(ab_60.successful_ab_vendor_pcnt) OVER (ORDER BY week) AS ABS_WOW_ab_60_successful_ab_vendor_pcnt,
  af.vfd_week,
  af.VFD_gmv,
  (VFD_gmv-lag(VFD_gmv) OVER (ORDER BY week)) AS ABS_WOW_VFD_gmv,
  ((VFD_gmv-lag(VFD_gmv) OVER (ORDER BY week))/lag(VFD_gmv) OVER (ORDER BY week)) as WOW_VFD_gmv,
  af.targeted_orders,
  (targeted_orders-lag(targeted_orders) OVER (ORDER BY week)) AS ABS_WOW_Deals_target,
  ((targeted_orders-lag(targeted_orders) OVER (ORDER BY week))/lag(targeted_orders) OVER (ORDER BY week)) AS WOW_Deals_target,
  af.vfd_incentive_cost,
  (vfd_incentive_cost-lag(vfd_incentive_cost) OVER (ORDER BY week)) AS ABS_WOW_vfd_incentive_cost,
  ((vfd_incentive_cost-lag(vfd_incentive_cost) OVER (ORDER BY week))/lag(vfd_incentive_cost) OVER (ORDER BY week)) as WOW_vfd_incentive_cost,
  af.vf_vendors,
  af.vendors,
  af.Vendor_pentration_percentage,
  (Vendor_pentration_percentage-lag(Vendor_pentration_percentage) OVER (ORDER BY week)) AS WOW_Vendor_pentration_percentage,
  ((Vendor_pentration_percentage-lag(Vendor_pentration_percentage) OVER (ORDER BY week))/lag(Vendor_pentration_percentage) OVER (ORDER BY week)) AS ABS_WOW_Vendor_pentration_percentage,
  af.vfd_gmv_percentage,
   (vfd_gmv_percentage-lag(vfd_gmv_percentage) OVER (ORDER BY week)) AS WOW_vfd_gmv_percentage,
   ((vfd_gmv_percentage-lag(vfd_gmv_percentage) OVER (ORDER BY week))/lag(vfd_gmv_percentage) OVER (ORDER BY week)) AS ABS_vfd_gmv_percentage,
  seemless_del.report_week_local,
  seemless_del.fail_rate,
  (fail_rate-lag(fail_rate) OVER (ORDER BY week)) AS WOW_fail_rate,
  ((fail_rate-lag(fail_rate) OVER (ORDER BY week))/lag(fail_rate) OVER (ORDER BY week)) AS ABS_WOW_fail_rate,
  seemless_del.on_time_pct,
  (on_time_pct-lag(on_time_pct) OVER (ORDER BY week)) AS WOW_on_time_pct,
  ((on_time_pct-lag(on_time_pct) OVER (ORDER BY week))/lag(on_time_pct) OVER (ORDER BY week)) AS ABS_WOW_on_time_pct,
  best_expienence.report_week,
  best_expienence.prev_customers,
  best_expienence.reorders,
  best_expienence.retention_rate,
  (retention_rate-lag(retention_rate) OVER (ORDER BY week)) AS WOW_retention_rate,
  ((retention_rate-lag(retention_rate) OVER (ORDER BY week))/lag(retention_rate) OVER (ORDER BY week)) AS ABS_WOW_retention_rate,
  best_expienence.SSU_acquisition,
  best_expienence.reacquisitions,
--choices OKRs starts here 
  order_generating_vendor.order_generating_vendors,
  (order_generating_vendors-lag(order_generating_vendors) OVER (ORDER BY report_date)) AS     ABS_order_generating_vendors,
  ((order_generating_vendors-lag(order_generating_vendors) OVER (ORDER BY report_date))/lag(order_generating_vendors) OVER (ORDER BY report_date)) as WOW_ABS_order_generating_vendors,
  choices.choices_week,
  choices.ab_aquisitions,
  (ab_aquisitions-lag(ab_aquisitions) OVER (ORDER BY week)) AS ABS_WOW_ab_aquisitions,
  ((ab_aquisitions-lag(ab_aquisitions) OVER (ORDER BY week))/lag(ab_aquisitions) OVER (ORDER BY week)) as WOW_ab_aquisitions,
  choices.total_vendor_aquisitions,
  (total_vendor_aquisitions-lag(total_vendor_aquisitions) OVER (ORDER BY week)) AS ABS_WOW_total_vendor_aquisitions,
  ((total_vendor_aquisitions-lag(total_vendor_aquisitions) OVER (ORDER BY week))/lag(total_vendor_aquisitions) OVER (ORDER BY week)) as WOW_total_vendor_aquisitions,
  choices.total_vendors_zombies_calc,
  (total_vendors_zombies_calc-lag(total_vendors_zombies_calc) OVER (ORDER BY week)) AS ABS_WOW_total_vendors_zombies_calc,
  ((total_vendors_zombies_calc-lag(total_vendors_zombies_calc) OVER (ORDER BY week))/lag(total_vendors_zombies_calc) OVER (ORDER BY week)) as WOW_total_vendors_zombies_calc,
  choices.zombie_vendors,
  (zombie_vendors-lag(zombie_vendors) OVER (ORDER BY week)) AS ABS_WOW_zombie_vendors,
  ((zombie_vendors-lag(zombie_vendors) OVER (ORDER BY week))/lag(zombie_vendors) OVER (ORDER BY week)) as WOW_zombie_vendors,
  choices.zombie_perc,
  (zombie_perc-lag(zombie_perc) OVER (ORDER BY week)) AS WOW_zombie_perc,
  SAFE_DIVIDE(zombie_perc - LAG(zombie_perc) OVER (ORDER BY week), LAG(zombie_perc) OVER (ORDER BY week)) AS ABS_WOW_zombie_perc,
  choices.ab_zombie_vendors,
  (ab_zombie_vendors-lag(ab_zombie_vendors) OVER (ORDER BY week)) AS ABS_WOW_ab_zombie_vendors,
  SAFE_DIVIDE(ab_zombie_vendors-lag(ab_zombie_vendors) OVER (ORDER BY week),lag(ab_zombie_vendors) OVER (ORDER BY week)) as WOW_ab_zombie_vendors,
  choices.cd_zombie_vendors,
  (cd_zombie_vendors-lag(cd_zombie_vendors) OVER (ORDER BY week)) AS ABS_WOW_cd_zombie_vendors,
  SAFE_DIVIDE(cd_zombie_vendors-lag(cd_zombie_vendors) OVER (ORDER BY week),lag(cd_zombie_vendors) OVER (ORDER BY week)) as WOW_cd_zombie_vendors,
 choices.total_active_vendors,
  (total_active_vendors-lag(total_active_vendors) OVER (ORDER BY week)) AS ABS_WOW_total_active_vendors,
  SAFE_DIVIDE(total_active_vendors-lag(total_active_vendors) OVER (ORDER BY week),lag(total_active_vendors) OVER (ORDER BY week)) as WOW_total_active_vendors,
   choices.total_active_ab_vendors,
  (total_active_ab_vendors-lag(total_active_ab_vendors) OVER (ORDER BY week)) AS ABS_WOW_total_active_ab_vendors,
  SAFE_DIVIDE(total_active_ab_vendors-lag(total_active_ab_vendors) OVER (ORDER BY week),lag(total_active_ab_vendors) OVER (ORDER BY week)) as WOW_total_active_ab_vendors,
  choices.total_active_cd_vendors,
  (total_active_cd_vendors-lag(total_active_cd_vendors) OVER (ORDER BY week)) AS ABS_WOW_total_active_cd_vendors,
  SAFE_DIVIDE(total_active_cd_vendors-lag(total_active_cd_vendors) OVER (ORDER BY week),lag(total_active_cd_vendors) OVER (ORDER BY week)) as WOW_total_active_cd_vendors,
  choices.AB_zombie_percentage,
  (AB_zombie_percentage-lag(AB_zombie_percentage) OVER (ORDER BY week)) AS ABS_WOW_AB_zombie_percentage,
  (AB_zombie_percentage-lag(AB_zombie_percentage) OVER (ORDER BY week))/lag(AB_zombie_percentage) OVER (ORDER BY week) AS WOW_AB_zombie_percentage,
--Shrinkage_surge data starts here 
Shrinkage_surge.shrinkage,  
  ((Shrinkage_surge.shrinkage-lag(Shrinkage_surge.shrinkage) OVER (ORDER BY Shrinkage_surge.report_date_week))) as WOW_shrinkage,
  ((Shrinkage_surge.shrinkage-lag(Shrinkage_surge.shrinkage) OVER (ORDER BY report_date_week)))/lag(Shrinkage_surge.shrinkage) OVER (ORDER BY report_date_week) as ABS_WOW_shrinkage,
  Shrinkage_surge.stacked_delivery_count,Shrinkage_surge.stacking,
  ((Shrinkage_surge.stacking-lag(Shrinkage_surge.stacking) OVER (ORDER BY report_date_week))) as WOW_stacking,
   ((Shrinkage_surge.stacking-lag(Shrinkage_surge.stacking) OVER (ORDER BY report_date_week)))/lag(Shrinkage_surge.stacking) OVER (ORDER BY report_date_week) as ABS_WOW_stacking,
FROM ambitition as ambition
LEFT JOIN affordability af
ON af.vfd_week = ambition.Week
LEFT JOIN seemless_del
ON seemless_del.report_week_local =ambition.Week
LEFT JOIN best_expienence
ON best_expienence.report_week = ambition.Week
LEFT JOIN choices
ON choices.choices_week = ambition.Week
LEFT JOIN ab_60
ON ab_60.ab_60_week = ambition.Week
LEFT JOIN order_generating_vendor
ON order_generating_vendor.report_date = ambition.Week
LEFT JOIN Shrinkage_surge
ON Shrinkage_surge.report_date_week = ambition.Week
ORDER BY 1 asc]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_4304A8A86A2341A7A585C8F9ABF6139F' table='[Extract].[_4304A8A86A2341A7A585C8F9ABF6139F]' type='table' />
            </properties>
          </object>
          <object caption='Shrinkage_city_level' id='_7E4524C5261D4F5F92879E0B7009BA4A'>
            <properties context=''>
              <relation connection='bigquery.0rmhls11jnrigs1dhzpjb0wqzi82' name='Custom SQL Query3' type='text'>SELECT
    EXTRACT(YEAR FROM date_local) AS year,
    DATE_TRUNC(date_local,isoweek) as iso_week,
    -- EXTRACT(MONTH FROM date_local) AS m_or_w,
    city_name,
    format_date(&apos;%A&apos;,date_local) as day_name,
    date_local AS date_metric,
    SUM(forecasted_orders) AS forecasted_orders,
    SUM(shrink_orders) AS shrink_orders,
    SAFE_DIVIDE(SUM(shrink_0_orders) + SUM(shrink_1st_orders) + SUM(shrink_2nd_orders) +
    SUM(shrink_3rd_orders) + SUM(shrink_4th_orders) + SUM(shrink_5th_orders) +
    SUM(shrink_6th_orders),SUM(forecasted_orders)) AS shrinkage_percentage,
    SAFE_DIVIDE(SUM(shrink_1st_orders) + SUM(shrink_2nd_orders) +
    SUM(shrink_3rd_orders) + SUM(shrink_4th_orders) + SUM(shrink_5th_orders) +
    SUM(shrink_6th_orders),SUM(forecasted_orders)) AS shrinkage_percentage_exclude_shrink_0,
    -- SAFE_DIVIDE(SUM(shrink_0_orders),SUM(forecasted_orders)) AS shrink_0_percentage,
    SAFE_DIVIDE(SUM(close_orders), SUM(forecasted_orders)) AS closure_percentage,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_weighted_das_events_hourly`
  WHERE date_local &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(&quot;Asia/Karachi&quot;), INTERVAL 3 MONTH), MONTH)
    AND global_entity_id = &quot;FP_PK&quot;
    AND lg_country_code = &apos;pk&apos;
    AND city_name in (&apos;Islamabad&apos;,&apos;Karachi&apos;,&apos;Lahore&apos;)
  GROUP BY ALL
    -- year,
    -- m_or_w,
    -- date_metric</relation>
            </properties>
            <properties context='extract'>
              <relation name='_7E4524C5261D4F5F92879E0B7009BA4A' table='[Extract].[_7E4524C5261D4F5F92879E0B7009BA4A]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='='>
              <expression op='[Week]' />
              <expression op='[iso_week]' />
            </expression>
            <first-end-point object-id='_4304A8A86A2341A7A585C8F9ABF6139F' />
            <second-end-point object-id='_7E4524C5261D4F5F92879E0B7009BA4A' />
          </relationship>
        </relationships>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Monthly OKRs' inline='true' name='federated.0w5ph7715jgz45186o3680m4swx2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0bkb97r05b4gd7126ijef1ib5n72'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='foodpanda-pk-bigquery' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='neha.jafri@foodpanda.pk' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Regional targets' name='cloudfile:googledrive-excel-direct.1nt8k5e0uvn87a1b0ensp1oms3t2'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1FCfSgkUeP6iRb3hRwVYop-jJ8HiE7embtdupUusGty8' cloudFileMetadata_-_folder='root' cloudFileName='Regional targets .xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1FCfSgkUeP6iRb3hRwVYop-jJ8HiE7embtdupUusGty8/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Regional targets .xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='neha.jafri@foodpanda.pk' validate='no' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.1nt8k5e0uvn87a1b0ensp1oms3t2' name='Sheet1' table='[Sheet1$]' type='table'>
          <columns gridOrigin='A1:T5:no:A1:T5:0' header='yes' outcome='2'>
            <column datatype='date' name='Month' ordinal='0' />
            <column datatype='integer' name='MAU' ordinal='1' />
            <column datatype='string' name='GMV In Euro' ordinal='2' />
            <column datatype='string' name='GMV PKR' ordinal='3' />
            <column datatype='string' name='Orders' ordinal='4' />
            <column datatype='real' name='%AB &gt;75 orders in F60D' ordinal='5' />
            <column datatype='integer' name='Active Vendors' ordinal='6' />
            <column datatype='integer' name='Vendor Aquisitions' ordinal='7' />
            <column datatype='integer' name='AB Acquisitions' ordinal='8' />
            <column datatype='string' name='Zombie %' ordinal='9' />
            <column datatype='real' name='AB Zombie %' ordinal='10' />
            <column datatype='real' name='VFD/GMV' ordinal='11' />
            <column datatype='real' name='VFD Penetration %' ordinal='12' />
            <column datatype='real' name='Fail Rate %' ordinal='13' />
            <column datatype='real' name='On Time Pct' ordinal='14' />
            <column datatype='real' name='Shrinkage' ordinal='15' />
            <column datatype='integer' name='Acq + Reacq' ordinal='16' />
            <column datatype='string' name='Stacking %' ordinal='17' />
            <column datatype='real' name='QC GMV Share' ordinal='18' />
            <column datatype='real' name='QC MAU Share' ordinal='19' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0bkb97r05b4gd7126ijef1ib5n72' name='Custom SQL Query' type='text'>WITH OKR AS (SELECT *
 FROM `dhh---analytics-eu.bl_europe.sp_okr_automation_2025`
 WHERE global_entity_id = &quot;FP_PK&quot;
)
,
acqu as (
  with lao_base AS (
  SELECT
  DATE_TRUNC(activation_date, MONTH) AS activation_month,
  DATE_TRUNC(incubated_date_60_days, MONTH) AS incubated_60d_month,
  vendor_grade,
  global_entity_id,
  country,
  vertical_segment,
  sf_opportunity_id,
  user_type,
  sf_opportunity_owner_id,
  num_f60d_valid_orders
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated`
WHERE is_closed
  AND is_won
  AND opportunity_business_type IN (&quot;New Business&quot;, &quot;Win Back&quot;)
  AND vendor_type = &apos;Restaurants&apos;
  AND vertical_segment != &apos;caterers&apos;
  AND global_entity_id = &apos;FP_PK&apos;
  AND DATE_TRUNC(activation_date, MONTH) &gt;&gt;= &quot;2024-01-01&quot;
   

)
-- , vendor_acquisitions AS ( 
  SELECT 
    activation_month AS month_acq_dash,
    global_entity_id as gd_dash,
    COUNT(DISTINCT CASE WHEN vendor_grade IN (&apos;A&apos;,&apos;B&apos;, &apos;AA&apos;, &apos;AAA&apos;) AND user_type in (&apos;field rep&apos;,&apos;telesales&apos;)  THEN sf_opportunity_id END) AS ab_aquisitions_dashboard,
    COUNT(DISTINCT CASE WHEN vendor_grade IN (&apos;C&apos;,&apos;D&apos;) THEN sf_opportunity_id END) AS cd_acquisitions_dash,
    COUNT(DISTINCT sf_opportunity_id) AS total_vendor_aquisitions_dashboard
  FROM lao_base
  WHERE global_entity_id = &apos;FP_PK&apos;
  -- WHERE vendor_grade IN (&apos;A&apos;,&apos;B&apos;, &apos;AA&apos;, &apos;AAA&apos;) -- AA/AAA are legacy grades
  GROUP BY ALL

)
,
vendor_acq as (
  SELECT date_trunc(activation_date,month) as month,country,count(distinct sf_opportunity_id) AS MTD_vendor_acquisiton FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_aggregated_metrics_mart_mgmt_cut` 
where lower(country) = &apos;pakistan&apos;
And date_trunc(activation_date,month) &gt;&gt;= &apos;2025-01-01&apos;
AND vendor_type = &apos;Restaurants&apos;
AND lower(vertical_segment) != &apos;caterers&apos;
and opportunity_business_type in (&apos;Win Back&apos;,&apos;New Business&apos;)
Group by all
order by 1 desc
-- LIMIT 1000
)
,
VFD_GMV as (
  select
  created_date_local,
  SUM(gmv_eur) gmv_dashboard,
  SUM(total_incentive_cost_vendor_eur) total_incentive_cost_vendor_eur_dashboard,
  SAFE_DIVIDE(SUM(total_incentive_cost_vendor_incl_manual_adjustment_eur),SUM(gmv_eur)) vfd_gmv_dasboard,

from
`fulfillment-dwh-production.pandata_report.commercial__vfd_dash_report` v
WHERE global_entity_id = &apos;FP_PK&apos;
AND granularity = &apos;monthly&apos;
AND created_date_local &gt;&gt;= &apos;2024-01-01&apos;
GROUP BY 1
ORDER BY 1
)
SELECT OKR.*,VFD_GMV.*,acqu.*,vendor_acq.MTD_vendor_acquisiton from OKR
LEFT JOIN VFD_GMV 
ON VFD_GMV.created_date_local = OKR.month
LEFT JOIN acqu
on OKR.month = acqu.month_acq_dash
LEFT JOIN vendor_acq
on vendor_acq.month = OKR.month
ORDER by 1 desc</relation>
          <relation connection='cloudfile:googledrive-excel-direct.1nt8k5e0uvn87a1b0ensp1oms3t2' name='Sheet1' table='[Sheet1$]' type='table'>
            <columns gridOrigin='A1:T5:no:A1:T5:0' header='yes' outcome='2'>
              <column datatype='date' name='Month' ordinal='0' />
              <column datatype='integer' name='MAU' ordinal='1' />
              <column datatype='string' name='GMV In Euro' ordinal='2' />
              <column datatype='string' name='GMV PKR' ordinal='3' />
              <column datatype='string' name='Orders' ordinal='4' />
              <column datatype='real' name='%AB &gt;75 orders in F60D' ordinal='5' />
              <column datatype='integer' name='Active Vendors' ordinal='6' />
              <column datatype='integer' name='Vendor Aquisitions' ordinal='7' />
              <column datatype='integer' name='AB Acquisitions' ordinal='8' />
              <column datatype='string' name='Zombie %' ordinal='9' />
              <column datatype='real' name='AB Zombie %' ordinal='10' />
              <column datatype='real' name='VFD/GMV' ordinal='11' />
              <column datatype='real' name='VFD Penetration %' ordinal='12' />
              <column datatype='real' name='Fail Rate %' ordinal='13' />
              <column datatype='real' name='On Time Pct' ordinal='14' />
              <column datatype='real' name='Shrinkage' ordinal='15' />
              <column datatype='integer' name='Acq + Reacq' ordinal='16' />
              <column datatype='string' name='Stacking %' ordinal='17' />
