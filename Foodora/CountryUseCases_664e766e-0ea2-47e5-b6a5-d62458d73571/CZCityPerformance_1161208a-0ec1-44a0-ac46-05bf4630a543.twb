          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% Fail Rate Target' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_1179380202001506305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.019&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.018&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.017&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.016&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.016&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.015&#13;&#10;    WHEN &apos;2024-07&apos; THEN 0.0147&#13;&#10;    WHEN &apos;2024-08&apos; THEN 0.0142&#13;&#10;    WHEN &apos;2024-09&apos; THEN 0.0147&#13;&#10;    WHEN &apos;2024-10&apos; THEN 0.0145&#13;&#10;    WHEN &apos;2024-11&apos; THEN 0.0145&#13;&#10;    WHEN &apos;2024-12&apos; THEN 0.0183&#13;&#10;    WHEN &apos;2025-01&apos; THEN 0.0170&#13;&#10;    WHEN &apos;2025-02&apos; THEN 0.0170&#13;&#10;    WHEN &apos;2025-03&apos; THEN 0.0170&#13;&#10;    WHEN &apos;2025-04&apos; THEN 0.0170&#13;&#10;    WHEN &apos;2025-05&apos; THEN 0.0170&#13;&#10;    WHEN &apos;2025-06&apos; THEN 0.0170&#13;&#10;END)' />
            </column>
            <column caption='% Shrinkage Target' datatype='real' default-format='p0.00%' name='[% Fail Rate Target (copy)_2093610924942835721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2025-01&apos; THEN 0.0950&#13;&#10;    WHEN &apos;2025-02&apos; THEN 0.0150&#13;&#10;    WHEN &apos;2025-03&apos; THEN 0.0150&#13;&#10;    WHEN &apos;2025-04&apos; THEN 0.0170&#13;&#10;    WHEN &apos;2025-05&apos; THEN 0.0320&#13;&#10;    WHEN &apos;2025-06&apos; THEN 0.0320&#13;&#10;END)' />
            </column>
            <column caption='% Shrinkage vs. Target' datatype='real' default-format='p0%' name='[% Fail Rate vs. Target (copy)_2093610924943200266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Shrinkage Weighted (copy)_1122522250003394562]/[% Fail Rate Target (copy)_2093610924942835721]-1' />
            </column>
            <column caption='% Fill Rate Target' datatype='real' default-format='p0.0%' name='[% Fill Rate (copy)_1179380202018693150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.940&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.960&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.970&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.980&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.990&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.990&#13;&#10;END)' />
            </column>
            <column caption='% Fill Rate vs Target' datatype='real' default-format='p0.0%' name='[% Fill Rate Target (copy)_1179380202019508256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_886646182733041670] / [% Fill Rate (copy)_1179380202018693150] - 1' />
            </column>
            <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% Seamless (EU) (copy)_1382042142357307395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_on_time_pdt_10])/sum([pdt_10]) * 0.07&#13;&#10;+ sum([order_on_time_pdt_20])/sum([pdt_20]) * 0.35&#13;&#10;+ sum([order_on_time_pdt_30])/sum([pdt_30]) * 0.35&#13;&#10;+ sum([order_on_time_pdt_40])/sum([pdt_40]) * 0.16&#13;&#10;+ sum([order_on_time_pdt_50])/sum([pdt_50]) * 0.05&#13;&#10;+ sum([order_on_time_pdt_60])/sum([pdt_60]) * 0.02' />
            </column>
            <column caption='% Seamless (EU)' datatype='real' default-format='p0.0%' name='[% Seamless (copy)_1279303812040802304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_orders_eu]) / sum([seam_total_orders_eu])' />
            </column>
            <column caption='% Seamless Target (EU)' datatype='real' default-format='p0.0%' name='[% Seamless Target (copy)_1279303812041895937]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.710&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.720&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.730&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.780&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.790&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.800&#13;&#10;    WHEN &apos;2024-07&apos; THEN 0.750&#13;&#10;    WHEN &apos;2024-08&apos; THEN 0.755&#13;&#10;    WHEN &apos;2024-09&apos; THEN 0.760&#13;&#10;    WHEN &apos;2024-10&apos; THEN 0.750&#13;&#10;    WHEN &apos;2024-11&apos; THEN 0.730&#13;&#10;    WHEN &apos;2024-12&apos; THEN 0.700&#13;&#10;END)' />
            </column>
            <column caption='% On Time Target' datatype='real' default-format='p0%' name='[% Seamless Target (copy)_2093610924943630347]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2025-01&apos; THEN 0.816&#13;&#10;    WHEN &apos;2025-02&apos; THEN 0.820&#13;&#10;    WHEN &apos;2025-03&apos; THEN 0.820&#13;&#10;    WHEN &apos;2025-04&apos; THEN 0.820&#13;&#10;    WHEN &apos;2025-05&apos; THEN 0.820&#13;&#10;    WHEN &apos;2025-06&apos; THEN 0.820&#13;&#10;END)' />
            </column>
            <column caption='% Seamless vs Target (EU)' datatype='real' default-format='p0.0%' name='[% Seamless vs Target (copy)_1279303812041973762]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='[% Seamless (copy)_1279303812040802304] / [% Seamless Target (copy)_1279303812041895937] - 1' />
            </column>
            <column caption='% On Time vs Target ' datatype='real' default-format='p0%' name='[% Seamless vs Target (copy)_2093610924943949836]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='[% Seamless (EU) (copy)_1382042142357307395] / [% Seamless Target (copy)_2093610924943630347] - 1' />
            </column>
            <column caption='% Shrinkage Weighted' datatype='real' default-format='p0.00%' name='[% Shrinkage Weighted (copy)_1122522250003394562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([events_orders_affected_by_shrink])/SUM([events_orders_forecast])' />
            </column>
            <column caption='% Fail Rate vs. Target' datatype='real' default-format='p0%' name='[Calculation_1179380202005078036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_900438471487643652]/[% Fail Rate (copy)_1179380202001506305]-1' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_1410471158974701568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_464715208252108800]&#13;&#10;&#13;&#10;WHEN IN (&apos;praha&apos;, &apos; praha&apos;) THEN &quot;Region 1 - Praha&quot;&#13;&#10;WHEN IN (&apos;plzen&apos;, &apos;liberec&apos;, &apos;mlada boleslav&apos;,&apos;usti nad labem&apos;, &apos;teplice&apos;, &apos;decin&apos;, &apos;most&apos;, &apos;chomutov&apos;, &apos;jablonec nad nisou&apos;, &apos;litvinov&apos; ) &#13;&#10;THEN &quot;Region 2 - Plzeň, Liberec, Mladá Boleslav, ...&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;brno&apos;, &apos;ostrava&apos;, &apos;pardubice&apos;, &apos;olomouc&apos;, &apos;hradec kralove&apos;, &apos;havirov&apos;, &apos;zlin&apos;, &apos;frydek mistek&apos;) &#13;&#10;THEN &quot;Region 3 - Brno, Ostrava, Pardubice ...&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;ceske budejovice&apos;, &apos;kladno&apos;, &apos;jihlava&apos; , &apos;tabor&apos;, &apos;karlovy vary&apos;, &apos;kolin&apos;, &apos;pisek&apos;, &apos;jindrichuv hradec&apos;, &apos;znojmo&apos;) &#13;&#10;THEN &quot;Region 4 - České Budějovice, Jihlava, Kladno, ...&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;opava&apos;, &apos;trebic&apos;, &apos;prostejov&apos;, &apos;pribram&apos;, &apos;cheb&apos;, &apos;chrudim&apos;, &apos;ceska lipa&apos;, &apos;beroun&apos;, &apos;karvina&apos;, &apos;uherske hradiste&apos;, &#13;&#10;&apos;kralupy nad vltavou&apos;, &apos;brandys nad labem&apos;, &apos;trutnov&apos;, &apos;litomerice&apos;, &apos;klatovy&apos;, &apos;strakonice&apos;, &apos;podebrady&apos;, &apos;valasske mezirici&apos;, &#13;&#10;&apos;kutna hora&apos;, &apos;novy jicin&apos;, &apos;bohumin&apos;, &apos;trinec&apos;, &apos;celakovice&apos;, &apos;prerov&apos;, &apos;kromeriz&apos;, &apos;bilina&apos;, &apos;kadan&apos;) THEN &quot;Region 5 - 3PL&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;CZ Total&apos;, &apos;Total CZ&apos;, &apos; CZ Total&apos;) THEN &quot;CZ Total&quot;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
            </column>
            <column caption='Geo Dimension' datatype='string' name='[Calculation_1410471158977933313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;Total CZ&quot; then &quot;Total CZ&quot;&#13;&#10;WHEN &quot;Region&quot; then [Calculation_1410471158974701568]&#13;&#10;WHEN &quot;City&quot; then [Calculation_464715208252108800]&#13;&#10;WHEN &quot;Zone&quot; then [zone]&#13;&#10;END' />
            </column>
