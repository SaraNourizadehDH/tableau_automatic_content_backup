      <column caption='Gross Orders' datatype='integer' name='[Calculation_1367405462843052038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#13;&#10;IF [Calculation_464715208252108800] = &quot;Total CZ&quot; &#13;&#10;then [gross_orders] else 0&#13;&#10;end)' />
      </column>
      <column caption='GAP Signed AB Share' datatype='real' default-format='p0%' name='[Calculation_1382042142363201540]' role='measure' type='quantitative'>
