    <worksheet name='comm_ptd_yoy'>
      <layout-options>
        <title>
          <formatted-text>
            <run>YtD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% DH PRO Cofund / PRO Deal Value' datatype='real' default-format='p0.0%' name='[% DH Cofund / Deal Value (copy)_1377538539985371137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[VFD PRO Value (copy)_1377538539983867904] / ([VFD PRO Value (copy)_1377538539983867904]+[VFD Value (copy)_1061160665777655808])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_900438471487909893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_vendor_orders]) / sum([failed_orders] + [orders])' />
            </column>
            <column caption='% DH Cofund / Deal Value' datatype='real' default-format='p0.0%' name='[% VFD / GMV (copy)_1006273107287236609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1006273107287150592] / ([Calculation_1006273107287150592]+[Calculation_790381762693140480])' />
            </column>
            <column caption='% VFD PRO / GMV' datatype='real' default-format='p0.0%' name='[% VFD / GMV (copy)_1061160665777733633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[VFD Value (copy)_1061160665777655808] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='% VFD Always On / GMV' datatype='real' default-format='p0.00%' name='[% VFD / GMV (copy)_1904459732054626306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[VFD Value (copy)_1904459732054446081] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='DH Cofund Subsidy' datatype='real' name='[Calculation_1006273107287150592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_deal_value])' />
            </column>
            <column caption='% Campaign Orders' datatype='real' default-format='p0.0%' name='[Calculation_1006554531980337152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date] &lt;&gt; [Calculation_2852326719360741382] THEN [resto_campaign_orders] END)/SUM(IF [date] &lt;&gt; [Calculation_2852326719360741382] THEN [orders] END)' />
            </column>
            <column caption='GMV Resto' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202025685027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local_restaurants])' />
            </column>
            <column caption='PtD YoY Title' datatype='string' name='[Calculation_1231734538927296515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &apos;MtD YoY&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &apos;WtD YoY&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &apos;Same Day YoY&apos;&#13;&#10;END' />
            </column>
            <column caption='GAP Signed AB Share' datatype='real' default-format='p0%' name='[Calculation_1382042142363201540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gap_ab_signed])/[Calculation_1557964038557499396]' />
            </column>
            <column caption='Targeted Deals Revenue' datatype='real' name='[Calculation_1443403712413802496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([targeted_deals_revenue_local])' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1451566489713233920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_scheduled_open_seconds] - [total_closed_seconds])&#13;&#10;/&#13;&#10;sum([total_scheduled_open_seconds])' />
            </column>
            <column caption='# Orders Resto' datatype='integer' name='[Calculation_1458040444875382784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders_restos])' />
            </column>
            <column caption='GAP Signed' datatype='integer' name='[Calculation_1557964038557499396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([gap_ab_signed]),0) + IFNULL(SUM([gap_cd_signed]),0)' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_1644376876707385344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_local])' />
            </column>
            <column caption='Display Ads Revenue' datatype='real' name='[Calculation_1644376876707438593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([display_ads_revenue_local])' />
            </column>
            <column caption='Joker Revenue' datatype='real' name='[Calculation_1644376876707504130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_fee_revenue_local])' />
            </column>
            <column caption='Eshop Profit' datatype='real' name='[Calculation_1644376876707594243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eshop_profit_local])' />
            </column>
            <column caption='Eshop Revenue (Turnover)' datatype='real' name='[Calculation_1644376876707651588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eshop_turnover_local])' />
            </column>
            <column caption='NCR Revenue (Eshop Turnover)' datatype='real' name='[Calculation_1644376876707745797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ncr_revenue_local])' />
            </column>
            <column caption='NCR Reve (Eshop T/O) / GMV Resto' datatype='real' default-format='p0.00%' name='[Calculation_1644376876707926022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1644376876707745797] /  [Calculation_1179380202025685027]' />
            </column>
            <column caption='Eshop Reve (Turnover) / GMV Resto' datatype='real' default-format='p0.00%' name='[Calculation_1644376876708610055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1644376876707651588]/ [Calculation_1179380202025685027]' />
            </column>
            <column caption='Display Ads Revenue / GMV Resto' datatype='real' default-format='p0.00%' name='[Calculation_1644376876708741128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1644376876707438593] / [Calculation_1179380202025685027]' />
            </column>
            <column caption='CPC Revenue / GMV Resto' datatype='real' default-format='p0.00%' name='[Calculation_1644376876708864009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1644376876707385344] / [Calculation_1179380202025685027]' />
            </column>
            <column caption='Joker Revenue / GMV Resto' datatype='real' default-format='p0.00%' name='[Calculation_1644376876709040138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1644376876707504130] / [Calculation_1179380202025685027]' />
            </column>
            <column caption='Vendors Added' datatype='integer' name='[Calculation_2029434599030751232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restos_added])' />
            </column>
            <column caption='Vendors Signed AB Share' datatype='real' default-format='p0%' name='[Calculation_223772645045186560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ab_restos_signed])/[Calculation_63613409556004866]' />
            </column>
            <column caption='Reporting Period' datatype='integer' name='[Calculation_236720497996382212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN ISOWEEK([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;END' />
            </column>
            <column caption='PtD' datatype='boolean' name='[Calculation_236720498005434378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([date] &gt;= [Calculation_236720498005807115] AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Avg Waiting in Resto (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_523261992953470976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_min])/SUM([at_vendor_time_count])' />
            </column>
            <column caption='VFD GMV Penetration' datatype='real' default-format='p0.0%' name='[Calculation_63613409555275776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_restos_with_vf_deals])/[Calculation_1179380202025685027]' />
            </column>
            <column caption='Vendors Signed' datatype='integer' name='[Calculation_63613409556004866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restos_signed])' />
            </column>
            <column caption='Deal Utilisation' datatype='real' default-format='p0.0%' name='[Calculation_63613409561718788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([resto_orders_with_deals])/[Calculation_1458040444875382784]' />
            </column>
            <column caption='VFD Value' datatype='real' name='[Calculation_790381762693140480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([vf_deal_value],0))&#13;&#10;+&#13;&#10;sum(IFNULL([manual_adjustment_value_czk],0))' />
            </column>
            <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_790381762693140480] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / sum([failed_orders] + [orders])' />
