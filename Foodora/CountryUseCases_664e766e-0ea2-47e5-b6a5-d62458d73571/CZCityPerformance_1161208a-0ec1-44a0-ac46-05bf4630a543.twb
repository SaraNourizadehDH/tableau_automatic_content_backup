            <column caption='PRO Orders %' datatype='real' default-format='p0.0%' name='[Calculation_638385247291756550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscription_orders]) /  sum([orders])' />
            </column>
            <column caption='VFD Value' datatype='real' name='[Calculation_790381762693140480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([vf_deal_value],0))&#13;&#10;+&#13;&#10;sum(IFNULL([manual_adjustment_value_czk],0))' />
            </column>
            <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_790381762693140480] / sum([gmv_local_restaurants])' />
