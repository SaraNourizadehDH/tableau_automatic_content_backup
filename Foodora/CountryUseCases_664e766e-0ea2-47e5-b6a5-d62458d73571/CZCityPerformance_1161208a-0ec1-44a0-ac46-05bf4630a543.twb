            <column caption='GMV Target' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[GMV (copy)_1649724888191070214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1188668875951497240] * &#13;&#10;AVG(IF [Calculation_464715208252108800] = &apos; CZ Total&apos; THEN&#13;&#10;        CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;        WHEN &apos;2024-01&apos; THEN 24.8 * 19111434&#13;&#10;        WHEN &apos;2024-02&apos; THEN 24.8 * 17522334&#13;&#10;        WHEN &apos;2024-03&apos; THEN 24.8 * 19529372&#13;&#10;        WHEN &apos;2024-04&apos; THEN 24.8 * 19415700&#13;&#10;        WHEN &apos;2024-05&apos; THEN 24.8 * 20584856&#13;&#10;        WHEN &apos;2024-06&apos; THEN 24.8 * 18291957&#13;&#10;&#13;&#10;        WHEN &apos;2024-07&apos; THEN 25.41 * 17572131&#13;&#10;        WHEN &apos;2024-08&apos; THEN 25.41 * 17482325&#13;&#10;        WHEN &apos;2024-09&apos; THEN 25.41 * 18188782&#13;&#10;        WHEN &apos;2024-10&apos; THEN 25.41 * 18478791&#13;&#10;        WHEN &apos;2024-11&apos; THEN 25.41 * 18360006&#13;&#10;        WHEN &apos;2024-12&apos; THEN 25.41 * 18504535&#13;&#10;        END&#13;&#10;    END)' />
