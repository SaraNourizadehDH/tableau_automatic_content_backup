      <column caption='Partner % Calls Accepted &lt; 30s' datatype='real' default-format='p0.00%' name='[Rider % Chats Accepted &lt; 30s (copy)_771804445291298818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ps_calls_sla_30_count]) / &#13;&#10;SUM([ps_total_inbound_calls_count])' />
      </column>
      <column caption='Partner AVG 1st Response Calls' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Rider AVG First Response Chats (copy)_771804445294338052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ps_sum_queue_time_calls])&#13;&#10;/&#13;&#10;SUM([ps_answered_calls_inbound_total])' />
      </column>
      <column caption='Customer NPS' datatype='real' name='[Rider NPS (copy)_1392175243436638208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters]) - sum([nps_detractors])) / sum([nps_responses])' />
      </column>
      <column caption='Rider Payment Cost per OD Order' datatype='real' name='[Rider Payment Cost Total (copy)_2643472299422990354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_rider_payment_local])/sum([successful_orders_od_with_rooster_payment])' />
      </column>
      <column caption='Restos AB Signed Target' datatype='real' default-format='n#,##0;-#,##0' name='[Sales Productivity Target (copy)_1473521543084793862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1188668875951497240] * &#13;&#10;AVG(IF [Calculation_464715208252108800] = &apos; CZ Total&apos; THEN&#13;&#10;        CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;       &#13;&#10;        WHEN &apos;2024-07&apos; THEN 76&#13;&#10;        WHEN &apos;2024-08&apos; THEN 76&#13;&#10;        WHEN &apos;2024-09&apos; THEN 77&#13;&#10;        WHEN &apos;2024-10&apos; THEN 80&#13;&#10;        WHEN &apos;2024-11&apos; THEN 80&#13;&#10;        WHEN &apos;2024-12&apos; THEN 75&#13;&#10;        END&#13;&#10;    END)' />
      </column>
      <column caption='Restos AB Signed vs Target' datatype='real' default-format='p0.0%' name='[Sales Productivity vs Target (copy)_1473521543085314055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_223772645045186560] / [Sales Productivity Target (copy)_1473521543084793862] - 1' />
      </column>
      <column caption='CC Productivity Customer vs Target' datatype='real' default-format='p0.0%' name='[Sales Productivity vs Target (copy)_729583182785257474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CC Productivity (copy)_1557964038543552512] / [Calculation_729583182784651264] - 1' />
      </column>
      <column caption='Service Fee Revenue per Order' datatype='real' name='[Service Fee Revenue Total (copy)_2643472299422728207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([service_fee_excl_vat_local])/SUM([orders])' />
      </column>
      <column aggregation='Avg' caption='target orders per capita' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Target Orders (copy)_1188668875944505352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//0.01 * [PtD for targets]&#13;&#10;FLOAT(NULL)' />
      </column>
      <column caption='Diff vs. Target Title' datatype='string' name='[Target PtD Title  (copy)_1188668875955519515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;vs Target&quot;' />
      </column>
      <column caption='DH PRO Subsidy Cofund' datatype='real' name='[VFD PRO Value (copy)_1377538539983867904]' role='measure' type='quantitative'>
