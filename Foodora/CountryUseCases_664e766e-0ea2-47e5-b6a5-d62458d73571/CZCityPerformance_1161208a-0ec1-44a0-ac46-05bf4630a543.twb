            <column caption='Orders per B Restos' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders per A Vendors (copy)_900438471490265095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([b_valid_orders]) / sum([b_grade_vendors])' />
