      <aliases enabled='yes' />
      <column caption='LS AAA Partners per MAU Target' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# AB Restos Target (copy)_2093610924924633088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1330813712526405632] = &apos; CZ Total&apos; THEN&#13;&#10;CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;        WHEN &apos;2025-01&apos; THEN 1.29&#13;&#10;        WHEN &apos;2025-02&apos; THEN 1.31&#13;&#10;        WHEN &apos;2025-03&apos; THEN 1.32&#13;&#10;        WHEN &apos;2025-04&apos; THEN 1.33&#13;&#10;        WHEN &apos;2025-05&apos; THEN 1.35&#13;&#10;        WHEN &apos;2025-06&apos; THEN 1.36&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='Sales Productivity Target' datatype='integer' default-format='n#,##0;-#,##0' name='[# AB Restos Target (copy)_507217924283658241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1330813712526405632] = &apos; CZ Total&apos; THEN&#13;&#10;CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;        WHEN &apos;2024-07&apos; THEN 16&#13;&#10;        WHEN &apos;2024-08&apos; THEN 19&#13;&#10;        WHEN &apos;2024-09&apos; THEN 22&#13;&#10;        WHEN &apos;2024-10&apos; THEN 23&#13;&#10;        WHEN &apos;2024-11&apos; THEN 23&#13;&#10;        WHEN &apos;2024-12&apos; THEN 16&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='LS AAA Partners per MAU vs Target' datatype='real' default-format='p0.0%' name='[# AB Restos vs Target (copy)_2093610924925063169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1160521372255297536]/AVG([# AB Restos Target (copy)_2093610924924633088]) - 1' />
      </column>
      <column caption='Sales Productivity vs Target' datatype='real' default-format='p0.0%' name='[# AB Restos vs Target (copy)_507217924283867138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_507217924280799232]/AVG([# AB Restos Target (copy)_507217924283658241]) - 1' />
      </column>
      <column caption='% Display Ads Reve / Resto GMV' datatype='real' default-format='p0.00%' name='[% CPC Revenue / Resto GMV (copy)_86412850435674127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([display_ads_revenue_local])/SUM([resto_gmv])' />
      </column>
      <column caption='% Joker Revenue / Resto GMV' datatype='real' default-format='p0.00%' name='[% CPC Revenue / Resto GMV (copy)_86412850435854352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_fee_revenue_local])/SUM([resto_gmv])' />
      </column>
      <column caption='% Eshop Turnover / Resto GMV' datatype='real' default-format='p0.00%' name='[% Joker Revenue / Resto GMV (copy)_86412850436100113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eshop_turnover_local])/SUM([resto_gmv])' />
      </column>
      <column caption='% AB &gt; 75 orders in F60D Target' datatype='real' default-format='p0.0%' name='[% Multivertical Users Target (copy)_1439744554269777920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;    WHEN &apos;2025-01&apos; THEN 0.70&#13;&#10;    WHEN &apos;2025-02&apos; THEN 0.71&#13;&#10;    WHEN &apos;2025-03&apos; THEN 0.72&#13;&#10;    WHEN &apos;2025-04&apos; THEN 0.74&#13;&#10;    WHEN &apos;2025-05&apos; THEN 0.75&#13;&#10;    WHEN &apos;2025-06&apos; THEN 0.77&#13;&#10;END' />
      </column>
      <column caption='% AB &gt; 75 orders in F60D vs Target' datatype='real' default-format='p0%' name='[% Multivertical Users vs Target (copy)_1439744554270232577]' role='measure' type='quantitative' visual-totals='Avg'>
