    <worksheet name='comm_ptd_lp'>
      <layout-options>
        <title>
          <formatted-text>
            <run>YtD LY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% DH PRO Cofund / PRO Deal Value' datatype='real' default-format='p0.0%' name='[% DH Cofund / Deal Value (copy)_1377538539985371137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[VFD PRO Value (copy)_1377538539983867904] / ([VFD PRO Value (copy)_1377538539983867904]+[VFD Value (copy)_1061160665777655808])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_900438471487909893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_vendor_orders]) / sum([failed_orders] + [orders])' />
            </column>
            <column caption='% DH Cofund / Deal Value' datatype='real' default-format='p0.0%' name='[% VFD / GMV (copy)_1006273107287236609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1006273107287150592] / ([Calculation_1006273107287150592]+[Calculation_790381762693140480])' />
            </column>
            <column caption='% VFD PRO / GMV' datatype='real' default-format='p0.0%' name='[% VFD / GMV (copy)_1061160665777733633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[VFD Value (copy)_1061160665777655808] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='% VFD Always On / GMV' datatype='real' default-format='p0.00%' name='[% VFD / GMV (copy)_1904459732054626306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[VFD Value (copy)_1904459732054446081] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='DH Cofund Subsidy' datatype='real' name='[Calculation_1006273107287150592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_deal_value])' />
            </column>
            <column caption='% Campaign Orders' datatype='real' default-format='p0.0%' name='[Calculation_1006554531980337152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date] &lt;&gt; [Calculation_2852326719360741382] THEN [resto_campaign_orders] END)/SUM(IF [date] &lt;&gt; [Calculation_2852326719360741382] THEN [orders] END)' />
            </column>
            <column caption='GMV Resto' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202025685027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local_restaurants])' />
            </column>
            <column caption='GAP Signed AB Share' datatype='real' default-format='p0%' name='[Calculation_1382042142363201540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gap_ab_signed])/[Calculation_1557964038557499396]' />
            </column>
            <column caption='Targeted Deals Revenue' datatype='real' name='[Calculation_1443403712413802496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([targeted_deals_revenue_local])' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1451566489713233920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_scheduled_open_seconds] - [total_closed_seconds])&#13;&#10;/&#13;&#10;sum([total_scheduled_open_seconds])' />
            </column>
            <column caption='# Orders Resto' datatype='integer' name='[Calculation_1458040444875382784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders_restos])' />
            </column>
            <column caption='GAP Signed' datatype='integer' name='[Calculation_1557964038557499396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([gap_ab_signed]),0) + IFNULL(SUM([gap_cd_signed]),0)' />
            </column>
            <column caption='CPC Revenue' datatype='real' name='[Calculation_1644376876707385344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_local])' />
            </column>
            <column caption='Display Ads Revenue' datatype='real' name='[Calculation_1644376876707438593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([display_ads_revenue_local])' />
            </column>
            <column caption='Joker Revenue' datatype='real' name='[Calculation_1644376876707504130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_fee_revenue_local])' />
            </column>
            <column caption='Eshop Profit' datatype='real' name='[Calculation_1644376876707594243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eshop_profit_local])' />
            </column>
