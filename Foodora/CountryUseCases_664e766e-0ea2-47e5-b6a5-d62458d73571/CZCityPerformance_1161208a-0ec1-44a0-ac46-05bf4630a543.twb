    <worksheet name='mkt_monthly_yoy'>
      <layout-options>
        <title>
          <formatted-text>
            <run>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_performance (tableau_outputs)' name='federated.1h3qwk01iwx3h819kn77207qc4i9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[Calculation_984599483468599296]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[report_month]' caption='Reporting Month' datatype='date' default-format='*mmm yyyy' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h3qwk01iwx3h819kn77207qc4i9'>
            <column caption='PRO MAUs %' datatype='real' default-format='p0.00%' name='[% Subscription Orders (copy)_939563473374679040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[subscriber_users] /  [unique_users]' />
            </column>
            <column caption='Acq Retention 3M' datatype='real' default-format='p0.0%' name='[Acq Retention 1M (copy)_1671961403109113858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_retention_3m])/SUM([base_acq_3m_ago])' />
            </column>
            <column caption='% Reactivations (from last m)' datatype='real' default-format='p0.0%' name='[Calculation_1172061848810795013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_customers])/SUM([unique_users_lm])' />
            </column>
            <column caption='MAU (Monthly Active Users)' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202071203884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_users])' />
            </column>
            <column caption='PRO MAU' datatype='integer' name='[Calculation_1200490814597378053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_users])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_1330813712526405632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city] when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Reacquisitions' datatype='integer' name='[Calculation_1473521543068844032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reacquisitions])' />
            </column>
            <column caption='Acq Retention 1M' datatype='real' default-format='p0.0%' name='[Calculation_1671961403108950017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_retention_1m])/SUM([base_acq_1m_ago])' />
            </column>
            <column caption='PRO GMV' datatype='real' name='[Calculation_1904459732062601220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_gmv])' />
            </column>
            <column caption='PRO % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_1904459732063129606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1904459732062601220]/(SUM(IFNULL([resto_gmv],0))+SUM(IFNULL(shops_gmv,0))+SUM(IFNULL(dmart_gmv,0)))' />
            </column>
            <column caption='# Corporate Orders' datatype='integer' name='[Calculation_320037073650155520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([corporate_orders])' />
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_52072871512281094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='YoY Title' datatype='string' name='[Calculation_52072871514304520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; YoY&quot;' />
            </column>
            <column caption='Frequency Monthly' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_638385247264137220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders] / [unique_users]' />
            </column>
            <column caption='# LaaS Orders Successful' datatype='integer' name='[Calculation_6816057346453442560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([laas_orders_delivered])' />
            </column>
            <column caption='% LaaS Orders Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_6816057346453602305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([laas_orders_cancelled])/(sum([laas_orders_delivered])+sum([laas_orders_cancelled]))' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[Calculation_802766671163662341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisitions])' />
            </column>
            <column caption='Last Data Date (Report Month)' datatype='date' name='[Calculation_984599483468599296]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Fixed: max(DATE([report_month]))}' />
            </column>
            <column caption='YoY Filter for Monthly' datatype='boolean' name='[Month Filter (copy)_1179380202030243880]' role='dimension' type='nominal'>
