            </column>
            <column caption='% CSAT EU Promoters' datatype='real' default-format='p0.00%' name='[% CSAT Promoters (copy) (copy)_141018970338549763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_promoters_eu])&#13;&#10;/&#13;&#10;SUM([csat_responses_eu])' />
            </column>
            <column caption='% CSAT CZ Promoters' datatype='real' default-format='p0.00%' name='[% CSAT Promoters (copy)_141018970338537474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_promoters_cz])&#13;&#10;/&#13;&#10;SUM([csat_responses_cz])' />
            </column>
            <column caption='% RSAT Promoters' datatype='real' default-format='p0.00%' name='[% CSAT Promoters (copy)_5557441992597512192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rsat_promoters])&#13;&#10;/&#13;&#10;SUM([rsat_responses])' />
            </column>
            <column caption='% Chats EU Accepted &lt; 30s' datatype='real' default-format='p0.00%' name='[% Chats Accepted &lt; 30s (copy) (copy)_141018970337955841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chat_sla_30_count_eu]) / &#13;&#10;SUM([total_chats_count_eu])' />
            </column>
            <column caption='% Chats CZ Accepted &lt; 30s ' datatype='real' default-format='p0.00%' name='[% Chats Accepted &lt; 30s (copy)_141018970337943552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chat_sla_30_count_cz])/ &#13;&#10;SUM([total_chats_count_cz])' />
            </column>
            <column caption='Rider % Chats Accepted &lt; 30s' datatype='real' default-format='p0.00%' name='[% Chats Accepted &lt; 30s (copy)_771804445290881025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rs_chat_sla_30_count]) / &#13;&#10;SUM([rs_total_chats_count])' />
            </column>
            <column caption='% Chats EU' datatype='real' default-format='p0.00%' name='[% Chats Accepted &lt; 30s (copy)_948852155310739457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_chats_count_eu])/&#13;&#10;SUM([total_chats_count])' />
            </column>
            <column caption='Partner % Contact Rate' datatype='real' default-format='p0.00%' name='[% Contact Rate (copy)_771804445294669829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ps_total_contacts])&#13;&#10;/&#13;&#10;SUM([gross_order_count])' />
            </column>
            <column caption='AHT Customer Chat EU (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AHT Customer Chat CZ (min) (copy)_2143994914571931649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([handling_time_secs_customer_chat_eu])/60&#13;&#10;/&#13;&#10;SUM([contacts_customer_chat_eu])' />
            </column>
            <column caption='AHT Customer Chat (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AHT Customer Chat CZ (min) (copy)_2143994914572075010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([handling_time_secs_customer_chat_cz],0) + IFNULL([handling_time_secs_customer_chat_eu],0))/60&#13;&#10;/&#13;&#10;SUM(IFNULL([contacts_customer_chat_cz],0) + IFNULL([contacts_customer_chat_eu],0))' />
            </column>
            <column caption='AHT Partner Call (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AHT Customer Chat CZ (min) (copy)_2143994914572361731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([handling_time_secs_vendor_call])/60&#13;&#10;/&#13;&#10;SUM([contacts_vendor_call])' />
            </column>
            <column caption='AHT Rider Chat (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AHT Vendor Call (min) (copy)_2143994914572492804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([handling_time_secs_rider_chat])/60&#13;&#10;/&#13;&#10;SUM([contacts_rider_chat])' />
            </column>
            <column caption='Rider AVG 1st Response Chats' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG First Response Chats (copy)_771804445291646979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rs_sum_queue_time_chats])&#13;&#10;/&#13;&#10;SUM([rs_valid_chats_count])' />
            </column>
            <column caption='CC Productivity Customer' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CC Productivity (copy)_1557964038543552512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cc_productivity_numerator_customer])/SUM([cc_herocare_hours_customer])' />
            </column>
            <column caption='CC Productivity Rider' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CC Productivity Customer (copy)_1557964038555480065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cc_productivity_numerator_rider])/SUM([cc_herocare_hours_rider])' />
            </column>
            <column caption='PtD YoY Title' datatype='string' name='[Calculation_1231734538927296515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &apos;MtD YoY&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &apos;WtD YoY&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &apos;Same Day YoY&apos;&#13;&#10;END' />
            </column>
            <column caption='% Abandoned Chats (Missed)' datatype='real' default-format='p0.00%' name='[Calculation_1367405462836215808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([missed_chats_count]) / SUM([total_chats_count])' />
            </column>
            <column caption='% Chats Accepted &lt; 30s' datatype='real' default-format='p0.00%' name='[Calculation_1367405462836801537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chat_sla_30_count]) / &#13;&#10;SUM([total_chats_count])' />
            </column>
            <column caption='AVG 1st Response Chats' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1367405462837534722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_queue_time_chats])&#13;&#10;/&#13;&#10;SUM([valid_chats_count])' />
            </column>
            <column caption='AVG Resolution Time Email' datatype='real' name='[Calculation_1367405462840565763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([email_resolution_time_min])&#13;&#10;/&#13;&#10;SUM([email_resolved_case_count])' />
            </column>
            <column caption='AVG 1st Response Emails' datatype='real' name='[Calculation_1367405462841417732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([email_first_repsonse_ht_min])&#13;&#10;/&#13;&#10;SUM([email_cases])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.00%' name='[Calculation_1367405462841815045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_contacts])&#13;&#10;/&#13;&#10;SUM([gross_order_count])' />
            </column>
            <column caption='AHT Customer Chat CZ (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2143994914571497472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([handling_time_secs_customer_chat_cz])/60&#13;&#10;/&#13;&#10;SUM([contacts_customer_chat_cz])' />
            </column>
            <column caption='Reporting Period' datatype='integer' name='[Calculation_236720497996382212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN ISOWEEK([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;END' />
            </column>
            <column caption='PtD' datatype='boolean' name='[Calculation_236720498005434378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([date] &gt;= [Calculation_236720498005807115] AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='% 1st Contact Resolution' datatype='real' default-format='p0.00%' name='[Calculation_389561394733658112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_fcr])&#13;&#10;/&#13;&#10;SUM([tiket_count])' />
            </column>
            <column caption='% CSAT Promoters' datatype='real' default-format='p0.00%' name='[Calculation_389561394734481409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_promotors])&#13;&#10;/&#13;&#10;SUM([csat_responses])' />
            </column>
            <column caption='Compensation CPO' datatype='real' default-format='C1029%' name='[Calculation_389561394735468546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensation_cost_local])&#13;&#10;/&#13;&#10;SUM(IF [compensation_cost_local] &gt; 0 THEN [orders] END)' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Index Period' datatype='integer' name='[Calculation_52072871791292446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Chats' datatype='integer' name='[Calculation_948852155310661632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_chats_count])' />
