              <calculation class='tableau' formula='SUM([subscriber_gmv])' />
            </column>
            <column caption='PRO % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_1904459732063129606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1904459732062601220]/(SUM(IFNULL([resto_gmv],0))+SUM(IFNULL(shops_gmv,0))+SUM(IFNULL(dmart_gmv,0)))' />
            </column>
            <column caption='Acquisitions Target' datatype='real' name='[Calculation_207447114553372672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Calculation_1330813712526405632] = &apos; CZ Total&apos; THEN &#13;&#10;CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;    WHEN &apos;2024-07&apos; THEN 23320&#13;&#10;    WHEN &apos;2024-08&apos; THEN 23582&#13;&#10;    WHEN &apos;2024-09&apos; THEN 27883&#13;&#10;    WHEN &apos;2024-10&apos; THEN 26600&#13;&#10;    WHEN &apos;2024-11&apos; THEN 26200&#13;&#10;    WHEN &apos;2024-12&apos; THEN 27800&#13;&#10;    WHEN &apos;2025-01&apos; THEN 31000&#13;&#10;    WHEN &apos;2025-02&apos; THEN 29000&#13;&#10;    WHEN &apos;2025-03&apos; THEN 31000&#13;&#10;    WHEN &apos;2025-04&apos; THEN 31000&#13;&#10;    WHEN &apos;2025-05&apos; THEN 32000&#13;&#10;    WHEN &apos;2025-06&apos; THEN 30000&#13;&#10;END&#13;&#10;END)&#13;&#10;* MAX([federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_1188668875951497240])' />
            </column>
            <column caption='= Report month' datatype='boolean' name='[Calculation_52072871511171077]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] = [Parameters].[report_month Parameter]' />
