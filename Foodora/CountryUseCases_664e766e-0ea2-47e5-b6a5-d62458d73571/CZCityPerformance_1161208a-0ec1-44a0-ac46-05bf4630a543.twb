      </column>
      <column caption='Dmart GPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Dmart Front Margin (copy)_392094658811793410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//GP = Revenue - Cost&#13;&#10;&#13;&#10;//Revenue: -- All revenues exclude VAT&#13;&#10;(&#13;&#10;    (0&#13;&#10;    +   IFNULL((sum([dmart_total_turnover_net]) - sum([dmart_total_cogs])),0) // Front Margin &#13;&#10;    +   IFNULL(sum([dmart_total_turnover_net]),0) * 0.005 // Back Margin    &#13;&#10;    +   IFNULL(sum([dmart_total_turnover_net]),0) * 0.012 // Retail Media&#13;&#10;    +   IFNULL(sum([dmart_df_and_prio_fee_revenue]),0) // Delivery Fee and Priority Delivery Fee Revenue. &#13;&#10;    +   IFNULL(sum([dmart_service_fee_revenue]),0) // Service Fee Revenue &#13;&#10;    +   IFNULL(sum([dmart_surcharge_revenue]),0) // Surcharge (minimum order value) Revenue &#13;&#10;    -   IFNULL(sum([dmart_pro_df_adjustment_plus_vat_local] * 0.5),0) //Intercompany Subscription DF Adjustment Revenue - only one with including VAT&#13;&#10;    )&#13;&#10;-&#13;&#10;// Cost&#13;&#10;    (0 &#13;&#10;    + IFNULL(sum([dmart_voucher_value]),0) // Voucher spend &#13;&#10;    + IFNULL(sum([dmart_orders] * 7),0) // Packaging Costs&#13;&#10;    + IFNULL(sum([dmart_orders] * 100),0) // Delivery Cost&#13;&#10;    + IFNULL(sum([dmart_orders] * 50),0) // Labor Cost&#13;&#10;    + IFNULL(sum([dmart_orders] * 20),0) // Other Costs &#13;&#10;    - IFNULL(sum([shrink_value]),0) // Shrinkage &#13;&#10;    )&#13;&#10;)&#13;&#10;/ SUM([dmart_orders])' />
      </column>
      <column caption='Local Shops Seamless (EU)' datatype='real' default-format='p0.0%' name='[Dmart Seamless (EU) (copy)_1382042142345342978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([seamless_orders_eu_ls]) / sum([seam_total_orders_eu_ls])' />
      </column>
