    <worksheet name='Mkt Weekly WoW'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Marketing Weekly</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_kpis_weekly (tableau_outputs)' name='federated.0scthm61jxr2gf191vsna1d6i0xb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Periods' datatype='integer' name='[Monthly / Weekly (copy)]' param-domain-type='list' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0scthm61jxr2gf191vsna1d6i0xb].[Calculation_916482586475061248]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0scthm61jxr2gf191vsna1d6i0xb].[week]' caption='Reporting Week (Marketing)' datatype='date' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-11#'>
              <calculation class='tableau' formula='#2025-08-11#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0scthm61jxr2gf191vsna1d6i0xb'>
            <column caption='Dmart MAU' datatype='integer' name='[Calculation_1200490814567612416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MAU_Dmart])' />
            </column>
            <column caption='LS MAU' datatype='integer' name='[Calculation_1200490814568136705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MAU_LS])' />
            </column>
            <column caption='QC MAU' datatype='integer' name='[Calculation_1200490814568312834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MAU_QC])' />
            </column>
            <column caption='PRO Orders' datatype='integer' name='[Calculation_1200490814581399555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_orders])' />
            </column>
            <column caption='Max Week' datatype='date' name='[Calculation_916482586475061248]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([week])}' />
            </column>
            <column caption='Week Filter' datatype='boolean' name='[Calculation_916482586475442177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week] &gt;= DATEADD(&apos;week&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),[Parameters].[Parameter 7])&#13;&#10;AND&#13;&#10;week &lt;= [Parameters].[Parameter 7]' />
            </column>
            <column caption='Frequency Monthly' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_916482586502594562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_30d])/SUM([MAU])' />
            </column>
            <column caption='PRO Orders %' datatype='real' default-format='p0.00%' name='[Calculation_916482586503036931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_orders])/SUM(orders)' />
            </column>
            <column caption='PRO Frequency Monthly' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_916482586503159812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_orders_30d])/SUM([MAU_PRO])' />
            </column>
            <column caption='PRO MAU %' datatype='real' default-format='p0.00%' name='[Calculation_916482586503397381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MAU_PRO])/SUM([MAU])' />
            </column>
            <column caption='WoW' datatype='string' name='[Calculation_916482586509553679]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;WoW&quot;' />
            </column>
            <column caption='index w' datatype='integer' name='[Calculation_916482586509864976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dmart MAU %' datatype='real' default-format='p0.00%' name='[LS MAU % (copy)_916482586507657229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([MAU_Dmart])/SUM([MAU])' />
            </column>
            <column datatype='integer' name='[MAU]' role='measure' type='quantitative' />
            <column datatype='integer' name='[MAU_Dmart]' role='measure' type='quantitative' />
