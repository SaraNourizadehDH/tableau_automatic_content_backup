              <calculation class='tableau' formula='CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;        WHEN &apos;2024-01&apos; THEN 0.3169&#13;&#10;        WHEN &apos;2024-02&apos; THEN 0.3169&#13;&#10;        WHEN &apos;2024-03&apos; THEN 0.3169&#13;&#10;        WHEN &apos;2024-04&apos; THEN 0.3169&#13;&#10;        WHEN &apos;2024-05&apos; THEN 0.3169&#13;&#10;        WHEN &apos;2024-06&apos; THEN 0.3169&#13;&#10;&#13;&#10;        WHEN &apos;2024-07&apos; THEN 0.3169&#13;&#10;        WHEN &apos;2024-08&apos; THEN 0.3236&#13;&#10;        WHEN &apos;2024-09&apos; THEN 0.3273&#13;&#10;        WHEN &apos;2024-10&apos; THEN 0.3319&#13;&#10;        WHEN &apos;2024-11&apos; THEN 0.3356&#13;&#10;        WHEN &apos;2024-12&apos; THEN 0.3383&#13;&#10;END' />
