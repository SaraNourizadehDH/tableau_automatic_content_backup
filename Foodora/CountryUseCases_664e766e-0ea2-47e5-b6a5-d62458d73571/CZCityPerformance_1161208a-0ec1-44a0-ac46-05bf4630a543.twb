      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% CSAT Target (copy)' datatype='real' default-format='p0.00%' name='[% CSAT Target (copy)_1438055670183702529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10; &#13;&#10;    WHEN &apos;2024-07&apos; THEN 0.70&#13;&#10;    WHEN &apos;2024-08&apos; THEN 0.71&#13;&#10;    WHEN &apos;2024-09&apos; THEN 0.72&#13;&#10;    WHEN &apos;2024-10&apos; THEN 0.73&#13;&#10;    WHEN &apos;2024-11&apos; THEN 0.74&#13;&#10;    WHEN &apos;2024-12&apos; THEN 0.75&#13;&#10;END)' />
            </column>
            <column caption='% CSAT Target' datatype='real' default-format='p0.00%' name='[% Fail Rate Target (copy)_1473521543083282436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10; &#13;&#10;    WHEN &apos;2024-07&apos; THEN 0.70&#13;&#10;    WHEN &apos;2024-08&apos; THEN 0.71&#13;&#10;    WHEN &apos;2024-09&apos; THEN 0.72&#13;&#10;    WHEN &apos;2024-10&apos; THEN 0.73&#13;&#10;    WHEN &apos;2024-11&apos; THEN 0.74&#13;&#10;    WHEN &apos;2024-12&apos; THEN 0.75&#13;&#10;END)' />
            </column>
            <column caption='PtD' datatype='boolean' name='[Calculation_236720498005434378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([date] &gt;= [Calculation_236720498005807115] AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Customer NPS Target' datatype='real' name='[Customer NPS (copy)_1179380202013036568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 45&#13;&#10;    WHEN &apos;2024-02&apos; THEN 45&#13;&#10;    WHEN &apos;2024-03&apos; THEN 45.5&#13;&#10;    WHEN &apos;2024-04&apos; THEN 46&#13;&#10;    WHEN &apos;2024-05&apos; THEN 46.5&#13;&#10;    WHEN &apos;2024-06&apos; THEN 47&#13;&#10;    WHEN &apos;2024-07&apos; THEN 31 //change of calculation method&#13;&#10;    WHEN &apos;2024-08&apos; THEN 32&#13;&#10;    WHEN &apos;2024-09&apos; THEN 33&#13;&#10;    WHEN &apos;2024-10&apos; THEN 34&#13;&#10;    WHEN &apos;2024-11&apos; THEN 35&#13;&#10;    WHEN &apos;2024-12&apos; THEN 35&#13;&#10;END)' />
            </column>
