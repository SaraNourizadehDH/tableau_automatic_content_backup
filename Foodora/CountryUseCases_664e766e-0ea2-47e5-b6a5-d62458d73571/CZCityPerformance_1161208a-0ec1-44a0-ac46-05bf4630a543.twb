    <worksheet name='qc_ptd_yoy'>
      <layout-options>
        <title>
          <formatted-text>
            <run>YtD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='Local Shops GMV Share' datatype='real' default-format='p0.00%' name='[% Dmart GMV Share (copy)_1410471159048118287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Dmart (copy)_1410471159047938062]/[Calculation_1179380202025639970]' />
            </column>
            <column caption='Local Shops Sessions Share' datatype='real' default-format='p0.0%' name='[% Dmart Sessions (copy)_1356709420443643905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_sessions])&#13;&#10;/&#13;&#10;sum([sessions])' />
            </column>
            <column caption='Local Shops On Time Share' datatype='real' default-format='p0.0%' name='[% On Time Orders (copy)_674132582670684164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([on_time_orders_ls]) / sum([seam_total_orders_eu_ls])' />
            </column>
            <column caption='Local Shops Partial Orders Share' datatype='real' default-format='p0.0%' name='[% Partial Orders (copy)_5557441992599711746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_partial_orders]) / sum([shops_orders])' />
            </column>
            <column caption='Dmart GMV Share' datatype='real' default-format='p0.00%' name='[% QComm GMV Share (copy)_1410471159047639053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Resto (copy)_1410471159047413772]/[Calculation_1179380202025639970]' />
            </column>
            <column caption='Local Shops CVR ' datatype='real' default-format='p0.0%' name='[% Qcomm CVR (copy)_6131369465532440576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([shops_orders],0))&#13;&#10;/&#13;&#10;sum([shops_sessions])' />
            </column>
            <column caption='QComm Seamless (EU)' datatype='real' default-format='p0.0%' name='[% Seamless (EU) (copy)_1382042142344687616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([seamless_orders_eu_dmart],0)+ifnull([seamless_orders_eu_ls],0)) / sum(ifnull([seam_total_orders_eu_dmart],0)+ifnull([seam_total_orders_eu_ls],0))' />
            </column>
            <column caption='Dmart Voucher Spend (on GMV net) ' datatype='real' default-format='p0.00%' name='[% Shrinkage (on GMV net) (copy)_392094658807599104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([dmart_voucher_value])/ sum([dmart_total_turnover_net]))' />
            </column>
            <column caption='&lt;-- Dmart / Local Shops  --&gt;' datatype='real' name='[&lt;-- health  / business  --&gt; (copy)_2139983896909430786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Dmart Cooldown Minutes' datatype='real' name='[Calculation_-8304074707923161088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unavailable_duration_s]) / 60' />
            </column>
            <column caption='Dmart Shrinkage (on GMV net)' datatype='real' default-format='p0.00%' name='[Calculation_1008243384065015808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(sum([shrink_value])/ sum([dmart_total_turnover_net]))' />
            </column>
            <column caption='Dmart PDT' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1090997023448104960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_dt_dmart])/SUM([completed_dmart_orders])' />
            </column>
            <column caption='QComm GMV' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1179380202025496609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1179380202025639970] - [Calculation_1179380202025685027]' />
            </column>
            <column caption='GMV (Gross Merchandise Value)' datatype='real' name='[Calculation_1179380202025639970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])' />
            </column>
            <column caption='GMV Resto' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202025685027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local_restaurants])' />
            </column>
            <column caption='QComm GMV Share' datatype='real' default-format='p0.00%' name='[Calculation_1179380202026074148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1179380202025496609]/[Calculation_1179380202025639970]' />
            </column>
            <column caption='PtD YoY Title' datatype='string' name='[Calculation_1231734538927296515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &apos;MtD YoY&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &apos;WtD YoY&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &apos;Same Day YoY&apos;&#13;&#10;END' />
            </column>
            <column caption='Dmart TOP 100 Availability' datatype='real' default-format='p0.0%' name='[Calculation_1241586139373264896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_records]) / SUM([records])' />
            </column>
            <column caption='Dmart Orders per Store' datatype='real' name='[Calculation_1285496234303537152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([dmart_orders]) / sum([week_days_passed])) / max([dmart_vendors])' />
            </column>
            <column caption='Dmart Partial Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_1285496234311311362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_partial_orders]) / sum([dmart_orders])' />
            </column>
            <column caption='Dmart Front Margin' datatype='real' default-format='p0.0%' name='[Calculation_1285496234311487491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([dmart_total_turnover_net]) - sum([dmart_total_cogs])) / sum([dmart_total_turnover_net])' />
            </column>
            <column caption='Dmart ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1285496234311737348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_total_turnover]) / sum([dmart_orders])' />
            </column>
            <column caption='% delay &gt; 20 (Dmart)' datatype='real' default-format='p0.0%' name='[Calculation_1285496234311868421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_delay_20]) / sum([dmart_orders])' />
            </column>
            <column caption='Dmart Sessions Share' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_1356709420443377664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_sessions])/sum([sessions])' />
            </column>
            <column caption='Local Shops Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1356709420446339079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_shops_orders])&#13;&#10;/&#13;&#10;sum([failed_shops_orders] + [shops_orders])' />
            </column>
            <column caption='Dmart DT' datatype='real' name='[Calculation_1410471159047081995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_delivery_time_minutes]) / sum([dmart_orders])' />
            </column>
            <column caption='Reporting Period' datatype='integer' name='[Calculation_236720497996382212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN ISOWEEK([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;END' />
            </column>
            <column caption='PtD' datatype='boolean' name='[Calculation_236720498005434378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([date] &gt;= [Calculation_236720498005807115] AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Local Shops Trials' datatype='integer' name='[Calculation_313844657133318144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shops_acquisitions])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Index Period' datatype='integer' name='[Calculation_52072871791292446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Local Shops AAA Orders' datatype='integer' name='[Calculation_899594063856230401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([aaa_shops_orders])' />
            </column>
            <column caption='Customer NPS Dmart' datatype='real' default-format='n#,##0;-#,##0' name='[Customer NPS OD (copy)_1285496234305052673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_dmart]) - sum([nps_detractors_dmart])) / sum([nps_responses_dmart])' />
            </column>
            <column caption='QComm Trials' datatype='integer' name='[Dmart Acquisitions (copy)_857935750570303488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_acquisitions])' />
            </column>
            <column caption='Dmart GPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Dmart Front Margin (copy)_392094658811793410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//GP = Revenue - Cost&#13;&#10;&#13;&#10;//Revenue: -- All revenues exclude VAT&#13;&#10;(&#13;&#10;    (0&#13;&#10;    +   IFNULL((sum([dmart_total_turnover_net]) - sum([dmart_total_cogs])),0) // Front Margin &#13;&#10;    +   IFNULL(sum([dmart_total_turnover_net]),0) * 0.005 // Back Margin    &#13;&#10;    +   IFNULL(sum([dmart_total_turnover_net]),0) * 0.012 // Retail Media&#13;&#10;    +   IFNULL(sum([dmart_df_and_prio_fee_revenue]),0) // Delivery Fee and Priority Delivery Fee Revenue. &#13;&#10;    +   IFNULL(sum([dmart_service_fee_revenue]),0) // Service Fee Revenue &#13;&#10;    +   IFNULL(sum([dmart_surcharge_revenue]),0) // Surcharge (minimum order value) Revenue &#13;&#10;    -   IFNULL(sum([dmart_pro_df_adjustment_plus_vat_local] * 0.5),0) //Intercompany Subscription DF Adjustment Revenue - only one with including VAT&#13;&#10;    )&#13;&#10;-&#13;&#10;// Cost&#13;&#10;    (0 &#13;&#10;    + IFNULL(sum([dmart_voucher_value]),0) // Voucher spend &#13;&#10;    + IFNULL(sum([dmart_orders] * 7),0) // Packaging Costs&#13;&#10;    + IFNULL(sum([dmart_orders] * 100),0) // Delivery Cost&#13;&#10;    + IFNULL(sum([dmart_orders] * 50),0) // Labor Cost&#13;&#10;    + IFNULL(sum([dmart_orders] * 20),0) // Other Costs &#13;&#10;    - IFNULL(sum([shrink_value]),0) // Shrinkage &#13;&#10;    )&#13;&#10;)&#13;&#10;/ SUM([dmart_orders])' />
            </column>
            <column caption='Local Shops Seamless (EU)' datatype='real' default-format='p0.0%' name='[Dmart Seamless (EU) (copy)_1382042142345342978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_orders_eu_ls]) / sum([seam_total_orders_eu_ls])' />
            </column>
            <column caption='GMV Local Shops' datatype='real' name='[GMV Dmart (copy)_1410471159047938062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local_shops])' />
            </column>
            <column caption='Dmart GMV' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[GMV Resto (copy)_1410471159047413772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local_darsktores])' />
            </column>
            <column caption='Dmart CVR' datatype='real' default-format='p0.0%' name='[Local Shops % Shops CVR  (copy)_1410471159026556936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([dmart_orders],0))&#13;&#10;/&#13;&#10;sum([dmart_sessions])' />
            </column>
            <column caption='PtD or PtD LY' datatype='boolean' name='[MtD  (copy)_1231734538926047234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_236720498005434378] OR [YtD Last Year (weekly)  (copy)_1212875715427209222]' />
            </column>
            <column caption='Period' datatype='integer' datatype-customized='true' name='[Period Date (copy)_236720497993867266]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN ISOWEEK([date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN DAY([date])&#13;&#10;END' />
            </column>
            <column caption='Dmart Seamless (EU)' datatype='real' default-format='p0.0%' name='[QComm Seamless (EU) (copy)_1382042142345289729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_orders_eu_dmart]) / sum([seam_total_orders_eu_dmart])' />
