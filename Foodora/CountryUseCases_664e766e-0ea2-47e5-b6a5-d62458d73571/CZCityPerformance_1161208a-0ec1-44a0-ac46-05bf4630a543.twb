      <column caption='End of Reporting Period' datatype='datetime' name='[Calculation_1188668875950088213]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788]))-1&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)+6&#13;&#10;END' />
      </column>
      <column caption='PtD for targets' datatype='real' name='[Calculation_1188668875951497240]' role='measure' type='quantitative'>
