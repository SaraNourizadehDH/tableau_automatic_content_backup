    <worksheet name='Population Rank'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='9'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Dream City' datatype='string' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot; praha&quot;'>
              <calculation class='tableau' formula='&quot; praha&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='Period Date' datatype='date' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_236720497991634944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [date]&#13;&#10;END)' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Choose City' datatype='string' name='[Calculation_622622656996839475]' role='measure' type='nominal'>
              <calculation class='tableau' formula='window_min(attr([Calculation_464715208252108800]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='last period rank label' datatype='string' name='[Calculation_622622657003634746]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Last Period Rank (1 is the best)&apos;' />
              <aliases>
