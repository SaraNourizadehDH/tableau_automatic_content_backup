              </calculation>
            </column>
            <column caption='Shops Users per mille' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Dmart Users per Mille (copy)_1524468483092426754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000 * MAX([shops_customers])/[Calculation_1524468483091767296]' />
            </column>
            <column caption='Max Rank % Dmart Users per mille' datatype='integer' default-format='N' name='[Rank % Dmart Users per mille (copy)_737745927161622561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [report_month]: sum(if { FIXED [report_month], [Calculation_1330813712526405632]: ([Calculation_1524468483092123649])} &gt; 0 then 1 end)}' />
            </column>
            <column caption='Max Rank % Multivertical Users' datatype='integer' default-format='N' name='[Rank % Multivertical Users (copy)_737745927160578078]' role='measure' type='quantitative'>
