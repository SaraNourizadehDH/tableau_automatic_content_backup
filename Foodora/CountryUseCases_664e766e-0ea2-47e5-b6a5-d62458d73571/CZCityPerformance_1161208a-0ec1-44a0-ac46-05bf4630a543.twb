            <column caption='Geo' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% Work Now Hours' datatype='real' default-format='p0.00%' name='[% No Shows (copy)_518476945729122305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([work_now_hours])/SUM([total_worked_hours])' />
            </column>
            <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% Seamless (EU) (copy)_1382042142357307395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_on_time_pdt_10])/sum([pdt_10]) * 0.07&#13;&#10;+ sum([order_on_time_pdt_20])/sum([pdt_20]) * 0.35&#13;&#10;+ sum([order_on_time_pdt_30])/sum([pdt_30]) * 0.35&#13;&#10;+ sum([order_on_time_pdt_40])/sum([pdt_40]) * 0.16&#13;&#10;+ sum([order_on_time_pdt_50])/sum([pdt_50]) * 0.05&#13;&#10;+ sum([order_on_time_pdt_60])/sum([pdt_60]) * 0.02' />
            </column>
            <column caption='% Seamless (EU)' datatype='real' default-format='p0.0%' name='[% Seamless (copy)_1279303812040802304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_orders_eu]) / sum([seam_total_orders_eu])' />
            </column>
            <column caption='% Shrinkage Weighted' datatype='real' default-format='p0.00%' name='[% Shrinkage Weighted (copy)_1122522250003394562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([events_orders_affected_by_shrink])/SUM([events_orders_forecast])' />
            </column>
            <column caption='% Surge Weighted' datatype='real' default-format='p0.00%' name='[% Surge Weighted (copy)_1122522250003529731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([events_orders_affected_by_surge])/SUM([events_orders_forecast])' />
            </column>
            <column caption='% scooter share' datatype='real' default-format='p0.0%' name='[% bike share (copy)_886646182732558340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_motorbike]) / sum([completed_deliveries])' />
            </column>
            <column caption='% freelancer share' datatype='real' default-format='p0.0%' name='[% bike share (copy)_886646182732734469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([freelancer_deliveries]) / sum([completed_deliveries])' />
            </column>
            <column caption='% delay &gt; 60' datatype='real' default-format='p0.0%' name='[% delay &gt; 10 (copy) (copy)_886646182732091394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delayed_60]) / sum([completed_orders])' />
            </column>
            <column caption='% early orders &gt; 10' datatype='real' default-format='p0.0%' name='[% delay &gt; 10 (copy)_883549986636288001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_early_10]) / sum([completed_orders])' />
            </column>
            <column caption='% delay &gt; 20' datatype='real' default-format='p0.0%' name='[% delay &gt; 10 (copy)_886646182732075009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delayed_20]) / sum([completed_orders])' />
            </column>
            <column caption='% Rider Late &gt; 10' datatype='real' default-format='p0.00%' name='[% delay &gt; 10 (copy)_948852155336810499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_late_over_10_count]) / sum([completed_orders])' />
            </column>
            <column caption='Lead to Hire CVR' datatype='real' default-format='p0.0%' name='[Calculation_1010776677138796544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hired_applicants])&#13;&#10;/&#13;&#10;SUM([applicants])' />
            </column>
            <column caption='Leads' datatype='integer' name='[Calculation_1383449575662239744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([applicants])' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_1410471158974701568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_464715208252108800]&#13;&#10;&#13;&#10;WHEN IN (&apos;praha&apos;, &apos; praha&apos;) THEN &quot;Region 1 - Praha&quot;&#13;&#10;WHEN IN (&apos;plzen&apos;, &apos;liberec&apos;, &apos;mlada boleslav&apos;,&apos;usti nad labem&apos;, &apos;teplice&apos;, &apos;decin&apos;, &apos;most&apos;, &apos;chomutov&apos;, &apos;jablonec nad nisou&apos;, &apos;litvinov&apos; ) &#13;&#10;THEN &quot;Region 2 - Plzeň, Liberec, Mladá Boleslav, ...&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;brno&apos;, &apos;ostrava&apos;, &apos;pardubice&apos;, &apos;olomouc&apos;, &apos;hradec kralove&apos;, &apos;havirov&apos;, &apos;zlin&apos;, &apos;frydek mistek&apos;) &#13;&#10;THEN &quot;Region 3 - Brno, Ostrava, Pardubice ...&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;ceske budejovice&apos;, &apos;kladno&apos;, &apos;jihlava&apos; , &apos;tabor&apos;, &apos;karlovy vary&apos;, &apos;kolin&apos;, &apos;pisek&apos;, &apos;jindrichuv hradec&apos;, &apos;znojmo&apos;) &#13;&#10;THEN &quot;Region 4 - České Budějovice, Jihlava, Kladno, ...&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;opava&apos;, &apos;trebic&apos;, &apos;prostejov&apos;, &apos;pribram&apos;, &apos;cheb&apos;, &apos;chrudim&apos;, &apos;ceska lipa&apos;, &apos;beroun&apos;, &apos;karvina&apos;, &apos;uherske hradiste&apos;, &#13;&#10;&apos;kralupy nad vltavou&apos;, &apos;brandys nad labem&apos;, &apos;trutnov&apos;, &apos;litomerice&apos;, &apos;klatovy&apos;, &apos;strakonice&apos;, &apos;podebrady&apos;, &apos;valasske mezirici&apos;, &#13;&#10;&apos;kutna hora&apos;, &apos;novy jicin&apos;, &apos;bohumin&apos;, &apos;trinec&apos;, &apos;celakovice&apos;, &apos;prerov&apos;, &apos;kromeriz&apos;, &apos;bilina&apos;, &apos;kadan&apos;) THEN &quot;Region 5 - 3PL&quot;&#13;&#10;&#13;&#10;WHEN IN (&apos;CZ Total&apos;, &apos;Total CZ&apos;, &apos; CZ Total&apos;) THEN &quot;CZ Total&quot;&#13;&#10;ELSE &apos;Unknown&apos;&#13;&#10;END' />
            </column>
            <column caption='Geo Dimension' datatype='string' name='[Calculation_1410471158977933313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;Total CZ&quot; then &quot;Total CZ&quot;&#13;&#10;WHEN &quot;Region&quot; then [Calculation_1410471158974701568]&#13;&#10;WHEN &quot;City&quot; then [Calculation_464715208252108800]&#13;&#10;WHEN &quot;Zone&quot; then [zone]&#13;&#10;END' />
            </column>
            <column caption='Worked Hours' datatype='real' name='[Calculation_1676183524539195392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_worked_hours])' />
            </column>
            <column caption='Avg DF (OD)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1794965948549857280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee_paid_od]) / sum([od_orders])' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='% No Shows' datatype='real' default-format='p0.00%' name='[Calculation_518476945727926272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_shows])/SUM([shifts_total])' />
            </column>
            <column caption='Hire to Active CVR' datatype='real' default-format='p0.0%' name='[Calculation_691021133653929984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([activated_applicants]) /&#13;&#10;SUM([hired_applicants])' />
            </column>
            <column caption='Churned Riders' datatype='integer' name='[Calculation_691021133654102017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churned_riders])' />
            </column>
            <column caption='Active Riders Monthly' datatype='integer' name='[Calculation_730427605526245376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([active_riders])' />
