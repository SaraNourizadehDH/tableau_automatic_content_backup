            <column caption='# Restos per mille' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV per capita (copy)_622622657015353408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000 * [Calculation_455708045045452802]/MAX([population])' />
            </column>
            <column caption='Acq per mille' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV per capita (copy)_807833191706603523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000 * SUM([acquistions])/MAX([population])' />
