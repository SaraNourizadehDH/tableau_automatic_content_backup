    <worksheet name='Monthly City CEO'>
      <layout-options>
        <title>
          <formatted-text>
            <run>User Metrics (monthly only)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_performance (tableau_outputs)' name='federated.1h3qwk01iwx3h819kn77207qc4i9' />
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Periods' datatype='integer' name='[Monthly / Weekly (copy)]' param-domain-type='list' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column caption='Dream City' datatype='string' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot; praha&quot;'>
              <calculation class='tableau' formula='&quot; praha&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[Calculation_984599483468599296]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[report_month]' caption='Reporting Month' datatype='date' default-format='*mmm yyyy' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h3qwk01iwx3h819kn77207qc4i9'>
            <column caption='PRO MAUs %' datatype='real' default-format='p0.00%' name='[% Subscription Orders (copy)_939563473374679040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[subscriber_users] /  [unique_users]' />
            </column>
            <column caption='% Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_1172061848810430467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisitions]/[unique_users]' />
            </column>
            <column caption='% Retained' datatype='real' default-format='p0.0%' name='[Calculation_1172061848810659844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retained_customers])/SUM([unique_users])' />
            </column>
            <column caption='% Reactivations (from last m)' datatype='real' default-format='p0.0%' name='[Calculation_1172061848810795013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_customers])/SUM([unique_users_lm])' />
            </column>
            <column caption='% Multivertical Users' datatype='real' default-format='p0.00%' name='[Calculation_1172061848810901510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[multivertical_customers]/[unique_users]' />
            </column>
            <column caption='MAU (Monthly Active Users)' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202071203884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_users])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_1330813712526405632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city] when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Population' datatype='real' name='[Calculation_1524468483091767296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([population])' />
            </column>
            <column caption='Dmart Users per mille' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1524468483092123649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000 * MAX([dmart_customers])/[Calculation_1524468483091767296]' />
            </column>
            <column caption='% CPC Vendor Penetration' datatype='real' default-format='p0.0%' name='[Calculation_1681250085836156928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_vendors]) / sum([active_restos])' />
            </column>
            <column caption='% VFD AB Penetration' datatype='real' default-format='p0.0%' name='[Calculation_1681250085836468225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_ab_restos]) / sum([ab_restos_with_order])' />
            </column>
            <column caption='= Report month' datatype='boolean' name='[Calculation_52072871511171077]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] = [Parameters].[report_month Parameter]' />
            </column>
            <column caption='Frequency Monthly' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_638385247264137220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders] / [unique_users]' />
            </column>
            <column caption='# LaaS Orders Successful' datatype='integer' name='[Calculation_6816057346453442560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([laas_orders_delivered])' />
            </column>
            <column caption='% LaaS Orders Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_6816057346453602305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([laas_orders_cancelled])/(sum([laas_orders_delivered])+sum([laas_orders_cancelled]))' />
            </column>
            <column caption='Choose City' datatype='string' name='[Calculation_811210892086812672]' role='measure' type='nominal'>
              <calculation class='tableau' formula='window_min(attr([Calculation_1330813712526405632]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Last Data Date (Report Month)' datatype='date' name='[Calculation_984599483468599296]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Fixed: max(DATE([report_month]))}' />
            </column>
            <column caption='Dream City Filter' datatype='boolean' name='[City Filter (copy)_21392107416301568]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_811210892086812672] = [Parameters].[Parameter 6]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Shops Users per mille' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Dmart Users per Mille (copy)_1524468483092426754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000 * MAX([shops_customers])/[Calculation_1524468483091767296]' />
            </column>
            <column caption='Month Filter City CEO' datatype='boolean' name='[Month Filter (copy)_523824942623186944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &gt;= DATE(DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),DATETRUNC(&quot;month&quot;,[Parameters].[Reporting Month (copy)_52072871788789788])))&#13;&#10;AND&#13;&#10;[report_month] &lt;= DATE(DATETRUNC(&quot;month&quot;,[Parameters].[Reporting Month (copy)_52072871788789788]))' />
            </column>
