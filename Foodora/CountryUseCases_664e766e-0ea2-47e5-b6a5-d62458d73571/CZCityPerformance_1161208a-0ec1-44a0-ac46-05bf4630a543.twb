              <calculation class='tableau' formula='[Calculation_1904459732043444224]/AVG([% Multivertical Users Target (copy)_1439744554269777920]) -1' />
            </column>
            <column caption='# AB Restos vs Target' datatype='real' default-format='p0.0%' name='[% PRO Users vs Target (copy)_1473521543089618955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_86412850430017540]/AVG([NCR/GMV Target (copy)_1473521543088648202]) - 1' />
            </column>
            <column caption='NCR/GMV Target' datatype='real' default-format='p0.0%' name='[Active Users Target (copy)_86412850458112033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;        WHEN &apos;2024-01&apos; THEN 0.036&#13;&#10;        WHEN &apos;2024-02&apos; THEN 0.036&#13;&#10;        WHEN &apos;2024-03&apos; THEN 0.036&#13;&#10;        WHEN &apos;2024-04&apos; THEN 0.036&#13;&#10;        WHEN &apos;2024-05&apos; THEN 0.036&#13;&#10;        WHEN &apos;2024-06&apos; THEN 0.036&#13;&#10;&#13;&#10;        WHEN &apos;2024-07&apos; THEN 0.036&#13;&#10;        WHEN &apos;2024-08&apos; THEN 0.037&#13;&#10;        WHEN &apos;2024-09&apos; THEN 0.038&#13;&#10;        WHEN &apos;2024-10&apos; THEN 0.039&#13;&#10;        WHEN &apos;2024-11&apos; THEN 0.040&#13;&#10;        WHEN &apos;2024-12&apos; THEN 0.040&#13;&#10;&#13;&#10;        WHEN &apos;2025-01&apos; THEN 0.043&#13;&#10;        WHEN &apos;2025-02&apos; THEN 0.049&#13;&#10;        WHEN &apos;2025-03&apos; THEN 0.043&#13;&#10;        WHEN &apos;2025-04&apos; THEN 0.045&#13;&#10;END' />
