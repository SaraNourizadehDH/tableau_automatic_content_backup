      <column caption='% mCVR1' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1392175243439284233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([mcvr1_sum]) / sum([mcvr1_count])' />
