            <column caption='Wastage CPO' datatype='real' default-format='C1029%' name='[Compensation CPO (copy) (copy)_316096421545652225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([wastage_cost_local])&#13;&#10;/&#13;&#10;SUM([orders])' />
            </column>
            <column caption='Refund CPO' datatype='real' default-format='C1029%' name='[Compensation CPO (copy)_316096421545635840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([refund_cost_local])&#13;&#10;/&#13;&#10;SUM([orders])' />
            </column>
            <column caption='PtD or PtD LY' datatype='boolean' name='[MtD  (copy)_1231734538926047234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_236720498005434378] OR [YtD Last Year (weekly)  (copy)_1212875715427209222]' />
            </column>
            <column caption='Rider % Contact Rate' datatype='real' default-format='p0.00%' name='[Partner % Contact Rate (copy)_771804445294927878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rs_total_contacts])&#13;&#10;/&#13;&#10;sum([od_order_count])' />
            </column>
            <column caption='Period' datatype='integer' datatype-customized='true' name='[Period Date (copy)_236720497993867266]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN ISOWEEK([date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN DAY([date])&#13;&#10;END' />
            </column>
            <column caption='Partner % Calls Accepted &lt; 30s' datatype='real' default-format='p0.00%' name='[Rider % Chats Accepted &lt; 30s (copy)_771804445291298818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ps_calls_sla_30_count]) / &#13;&#10;SUM([ps_total_inbound_calls_count])' />
            </column>
            <column caption='Partner AVG 1st Response Calls' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Rider AVG First Response Chats (copy)_771804445294338052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ps_sum_queue_time_calls])&#13;&#10;/&#13;&#10;SUM([ps_answered_calls_inbound_total])' />
            </column>
            <column caption='PtD LY' datatype='boolean' name='[YtD Last Year (weekly)  (copy)_1212875715427209222]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([date]) = YEAR([Parameters].[Reporting Month (copy)_52072871788789788])-1&#13;&#10;AND &#13;&#10;IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN MONTH([date]) = MONTH([Parameters].[Reporting Month (copy)_52072871788789788]) AND DAY([date]) = DAY([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSE&#13;&#10;[Period Date (copy)_236720497993867266] = [Calculation_236720497996382212]&#13;&#10;AND&#13;&#10;IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DAY([date]) &lt;= DAY([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[date],&apos;monday&apos;),[date]) &lt;= DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;),[Parameters].[Reporting Month (copy)_52072871788789788]) &#13;&#10;END&#13;&#10;END' />
            </column>
