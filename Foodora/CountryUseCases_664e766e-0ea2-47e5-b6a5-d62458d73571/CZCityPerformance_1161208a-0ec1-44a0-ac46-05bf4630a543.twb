      <column caption='Active Riders Monthly' datatype='integer' name='[Calculation_730427605526245376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([active_riders])' />
      </column>
      <column caption='New Riders Hired' datatype='integer' name='[Calculation_730427605526798337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired_applicants])' />
      </column>
      <column caption='Reactivated Riders %' datatype='real' default-format='p0.0%' name='[Calculation_730427605528244226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_691021133654175746]/[Calculation_730427605526245376]' />
      </column>
      <column caption='3 months ago filter' datatype='boolean' name='[Calculation_737745927162916898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datediff(&apos;month&apos;, [date], [Parameters].[Reporting Month (copy)_52072871788789788]) = 3' />
      </column>
      <column caption='VFD Value' datatype='real' name='[Calculation_790381762693140480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([vf_deal_value],0))&#13;&#10;+&#13;&#10;sum(IFNULL([manual_adjustment_value_czk],0))' />
      </column>
      <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_790381762693140480] / sum([gmv_local_restaurants])' />
      </column>
      <column caption='% CPC Restos Penetration' datatype='real' default-format='p0.0%' name='[Calculation_790381762708983813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc_vendors]) / sum([active_vendors])' />
      </column>
      <column caption='% multivertical' datatype='real' default-format='p0.0%' name='[Calculation_807833191709143044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[multivertical_customers]/[unique_users]' />
      </column>
      <column caption='Dream City' datatype='string' name='[Calculation_807833191721205775]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if not [Calculation_464715208252108800] in (&apos;Total CZ&apos;, &apos;other&apos;) then [Calculation_464715208252108800] end' />
      </column>
      <column caption='% Priority Orders' datatype='real' default-format='p0.0%' name='[Calculation_859906086178246656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([priority_orders]) / SUM([completed_orders])' />
      </column>
      <column caption='NPS # of Responses' datatype='integer' name='[Calculation_879609308598050816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nps_responses])' />
      </column>
      <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_883549986632835072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([completed_orders]) / SUM([total_worked_hours])' />
      </column>
      <column caption='% delay &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_886646182731751424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delayed_10]) / sum([completed_orders])' />
      </column>
      <column caption='% bike share' datatype='real' default-format='p0.0%' name='[Calculation_886646182732382211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([deliveries_bike]) / sum([completed_deliveries])' />
      </column>
      <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_886646182733041670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([slots_assigned]) / sum([open_slots_hours])' />
      </column>
      <column caption='CPO local' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_886646182733328391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_rider_payment_local]) / sum([successful_orders_od_with_rooster_payment])' />
      </column>
      <column caption='% Seamless' datatype='real' default-format='p0.0%' name='[Calculation_886646182733557768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([seamless_orders]) / sum([seam_total_orders])' />
      </column>
      <column caption='Rider Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_886646182734934025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_rating]) / sum([rider_ratings])' />
      </column>
      <column caption='Rider NPS' datatype='real' name='[Calculation_886646182735355914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([promoters]) - sum([detractors])) / sum([responses])' />
      </column>
      <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_886646182736216076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([act_delivery_time]) / sum([orders_not_preorder])' />
      </column>
      <column caption='% Cancellation Logistics' datatype='real' default-format='p0.00%' name='[Calculation_886646182736834573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cancelled_orders]) / sum([all_orders])' />
      </column>
      <column caption='Penalty Amount per mille GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_899594063839510528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1000*SUM([penalty_amount])/[Calculation_1179380202025685027]' />
      </column>
      <column caption='Local Shops AAA Orders' datatype='integer' name='[Calculation_899594063856230401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aaa_shops_orders])' />
      </column>
      <column caption='% OD Restos Share' datatype='real' default-format='p0.0%' name='[Calculation_900438471484215296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([od_active_vendors]) / [Calculation_455708045045452802]' />
      </column>
      <column caption='% OD Order Share' datatype='real' default-format='p0.0%' name='[Calculation_900438471486484481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([od_orders]) / SUM([orders])' />
      </column>
      <column caption='A/B Restos DLP &gt; 90%' datatype='real' default-format='p0.0%' name='[Calculation_900438471486914562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([ab_dlp_90_vendors]) / [Calculation_1410471159001042951]' />
      </column>
      <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders]) / sum([failed_orders] + [orders])' />
      </column>
      <column caption='Orders per A Restos' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_900438471488229382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([a_valid_orders]) / sum([a_grade_vendors])' />
      </column>
      <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.00%' name='[Calculation_900438471492648968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_late_over_10_count]) / sum([completed_orders])' />
      </column>
      <column caption='% VFD AB Penetration' datatype='real' default-format='p0.0%' name='[Calculation_900438471497416714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vfd_ab_vendors]) / sum([a_grade_vendors] + [b_grade_vendors])' />
      </column>
      <column caption='Total Chats' datatype='integer' name='[Calculation_948852155310661632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_chats_count])' />
      </column>
      <column caption='Wastage CPO' datatype='real' default-format='C1029%' name='[Compensation CPO (copy) (copy)_316096421545652225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([wastage_cost_local])&#13;&#10;/&#13;&#10;SUM([orders])' />
      </column>
      <column caption='Refund CPO' datatype='real' default-format='C1029%' name='[Compensation CPO (copy)_316096421545635840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([refund_cost_local])&#13;&#10;/&#13;&#10;SUM([orders])' />
      </column>
      <column caption='Customer NPS Target' datatype='real' name='[Customer NPS (copy)_1179380202013036568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 45&#13;&#10;    WHEN &apos;2024-02&apos; THEN 45&#13;&#10;    WHEN &apos;2024-03&apos; THEN 45.5&#13;&#10;    WHEN &apos;2024-04&apos; THEN 46&#13;&#10;    WHEN &apos;2024-05&apos; THEN 46.5&#13;&#10;    WHEN &apos;2024-06&apos; THEN 47&#13;&#10;    WHEN &apos;2024-07&apos; THEN 31 //change of calculation method&#13;&#10;    WHEN &apos;2024-08&apos; THEN 32&#13;&#10;    WHEN &apos;2024-09&apos; THEN 33&#13;&#10;    WHEN &apos;2024-10&apos; THEN 34&#13;&#10;    WHEN &apos;2024-11&apos; THEN 35&#13;&#10;    WHEN &apos;2024-12&apos; THEN 35&#13;&#10;END)' />
      </column>
      <column caption='Customer NPS vs Target' datatype='real' default-format='p0.0%' name='[Customer NPS (copy)_1179380202013618201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Rider NPS (copy)_1392175243436638208]/[Customer NPS (copy)_1179380202013036568] - 1' />
      </column>
      <column caption='Customer NPS Application' datatype='real' name='[Customer NPS (copy)_1392175243437035521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_app]) - sum([nps_detractors_app])) / sum([nps_responses_app])' />
      </column>
      <column caption='Customer NPS Delivery' datatype='real' name='[Customer NPS Application (copy)_1392175243437285378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_delivery]) - sum([nps_detractors_delivery])) / sum([nps_responses_delivery])' />
      </column>
      <column caption='Customer NPS Service' datatype='real' name='[Customer NPS Application (copy)_879609308598673410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_customer_service]) - sum([nps_detractors_customer_service])) / sum([nps_responses_customer_service])' />
      </column>
      <column caption='Customer NPS Pricing' datatype='real' name='[Customer NPS Delivery (copy) (copy)_1392175243437662212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_pricing]) - sum([nps_detractors_pricing])) / sum([nps_responses_pricing])' />
      </column>
      <column caption='Customer NPS Variety' datatype='real' name='[Customer NPS Delivery (copy)_1392175243437645827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_choice]) - sum([nps_detractors_choice])) / sum([nps_responses_choice])' />
      </column>
      <column caption='Customer NPS Deals' datatype='real' name='[Customer NPS Delivery (copy)_879609308598296577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_deals_and_discounts]) - sum([nps_detractors_deals_and_discounts])) / sum([nps_responses_deals_and_discounts])' />
      </column>
      <column caption='Customer NPS LS' datatype='real' default-format='n#,##0;-#,##0' name='[Customer NPS Dmart (copy)_674132582667419649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_ls]) - sum([nps_detractors_ls])) / sum([nps_responses_ls])' />
      </column>
      <column caption='Customer NPS Dmart' datatype='real' default-format='n#,##0;-#,##0' name='[Customer NPS OD (copy)_1285496234305052673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_dmart]) - sum([nps_detractors_dmart])) / sum([nps_responses_dmart])' />
      </column>
      <column caption='Customer NPS MP' datatype='real' name='[Customer NPS OD (copy)_1392175243438604295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_mp]) - sum([nps_detractors_mp])) / sum([nps_responses_mp])' />
      </column>
      <column caption='Customer NPS Quality' datatype='real' name='[Customer NPS Pricing (copy)_1392175243438350341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_quality]) - sum([nps_detractors_quality])) / sum([nps_responses_quality])' />
      </column>
      <column caption='Customer NPS OD' datatype='real' name='[Customer NPS Quality (copy)_1392175243438493702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(sum([nps_promoters_od]) - sum([nps_detractors_od])) / sum([nps_responses_od])' />
      </column>
      <column caption='Days in Reporting Month' datatype='real' name='[Days in Reporting Period Total (copy)_1188668875951071255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])) - DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])' />
      </column>
      <column caption='Days in Reporting Period Total' datatype='real' name='[Days in Reporting Period to Date (copy)_1188668875950419990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1188668875950088213] - [Calculation_236720498005807115] + 1' />
      </column>
      <column caption='Targeted Deals Reve / GMV Resto' datatype='real' default-format='p0.00%' name='[Display Ads Revenue / GMV Resto (copy)_1443403712414015489]' role='measure' type='quantitative'>
