            <column caption='Mcvr4 Sum' datatype='integer' name='[mcvr4_sum]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_236720497991634944]' derivation='None' name='[none:Calculation_236720497991634944:ok]' pivot='key' type='ordinal' />
