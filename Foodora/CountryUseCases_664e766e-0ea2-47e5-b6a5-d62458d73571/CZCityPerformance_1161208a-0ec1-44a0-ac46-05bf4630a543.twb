            <column caption='% Priority Orders' datatype='real' default-format='p0.0%' name='[Calculation_859906086178246656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([priority_orders]) / SUM([completed_orders])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_883549986632835072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_orders]) / SUM([total_worked_hours])' />
            </column>
            <column caption='% delay &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_886646182731751424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delayed_10]) / sum([completed_orders])' />
            </column>
            <column caption='% bike share' datatype='real' default-format='p0.0%' name='[Calculation_886646182732382211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_bike]) / sum([completed_deliveries])' />
            </column>
            <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_886646182733041670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([slots_assigned]) / sum([open_slots_hours])' />
            </column>
            <column caption='CPO local' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_886646182733328391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_rider_payment_local]) / sum([successful_orders_od_with_rooster_payment])' />
            </column>
            <column caption='Rider Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_886646182734934025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_rating]) / sum([rider_ratings])' />
            </column>
            <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_886646182736216076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([act_delivery_time]) / sum([orders_not_preorder])' />
            </column>
            <column caption='% Cancellation Logistics' datatype='real' default-format='p0.00%' name='[Calculation_886646182736834573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cancelled_orders]) / sum([all_orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / sum([failed_orders] + [orders])' />
            </column>
            <column caption='Dummy 02' datatype='real' datatype-customized='true' name='[Dummy (copy)_1188668875946811404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Geo Filter' datatype='boolean' name='[Geo Dimension (copy)_1410471158979092483]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;Total CZ&quot; THEN [Calculation_464715208252108800] = &quot;Total CZ&quot;&#13;&#10;WHEN &quot;Region&quot; THEN NOT [Calculation_464715208252108800] IN (&quot;Total CZ&quot;, &quot;other&quot;)&#13;&#10;WHEN &quot;City&quot; THEN TRUE&#13;&#10;WHEN &quot;Zone&quot; THEN [Calculation_464715208252108800] != &quot;Total CZ&quot;&#13;&#10;END' />
            </column>
            <column caption='Churned Riders %' datatype='real' default-format='p0.0%' name='[New Riders Hired % (copy)_730427605529350148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[Calculation_691021133654102017]/[Calculation_730427605526245376]' />
            </column>
            <column caption='PtD LP' datatype='boolean' name='[PtD LY (copy)_1649724888175493121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN ([date] &gt;= DATEADD(&quot;month&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;month&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Weekly&quot; THEN  ([date] &gt;= DATEADD(&quot;week&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;week&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Daily&quot; THEN [date] = [Parameters].[Reporting Month (copy)_52072871788789788] - 1&#13;&#10;END' />
            </column>
            <column caption='PtD LP Title' datatype='string' name='[PtD LY Title (copy)_1649724888174682112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &quot;MtD LM&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WtD LW&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &quot;Previous Day&quot;&#13;&#10;END' />
