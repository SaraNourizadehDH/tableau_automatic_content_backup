            <column caption='PtD LY' datatype='boolean' name='[YtD Last Year (weekly)  (copy)_1212875715427209222]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([date]) = YEAR([Parameters].[Reporting Month (copy)_52072871788789788])-1&#13;&#10;AND &#13;&#10;IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN MONTH([date]) = MONTH([Parameters].[Reporting Month (copy)_52072871788789788]) AND DAY([date]) = DAY([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSE&#13;&#10;[Period Date (copy)_236720497993867266] = [Calculation_236720497996382212]&#13;&#10;AND&#13;&#10;IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DAY([date]) &lt;= DAY([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[date],&apos;monday&apos;),[date]) &lt;= DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;),[Parameters].[Reporting Month (copy)_52072871788789788]) &#13;&#10;END&#13;&#10;END' />
