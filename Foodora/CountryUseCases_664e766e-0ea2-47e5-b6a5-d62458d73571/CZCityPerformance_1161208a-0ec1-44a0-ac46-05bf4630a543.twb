    <worksheet name='fin_pop'>
      <layout-options>
        <title>
          <formatted-text>
            <run>WoW</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='fin_pop' path='/t/Foodora/workbooks/DailyPerformance-CityCEO' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% CR Revenue / GFV (OD Restaurants)' datatype='real' default-format='p0.00%' name='[% CR Revenue / GFV (copy)_977281164060012544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_restos_commission_revenue_local])&#13;&#10; / SUM([od_restos_gfv_local])' />
            </column>
            <column caption='% CR Revenue / GFV' datatype='real' default-format='p0.00%' name='[% CR Revenue / GMV  (copy)_1678153841279803393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2643472299412230144] /  [Calculation_2643472299412332545]' />
            </column>
            <column caption='% CR Revenue / GMV ' datatype='real' default-format='p0.00%' name='[% NCR Revenue / GMV (copy)_772367358762070016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2643472299412230144] /  [Calculation_1179380202025639970]' />
            </column>
            <column caption='GMV (Gross Merchandise Value)' datatype='real' name='[Calculation_1179380202025639970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])' />
            </column>
            <column caption='AFV (Avg Food Value)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1179380212340621312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2643472299412332545]/SUM(IF NOT ISNULL([gfv_local]) THEN [orders] END)' />
            </column>
            <column caption='AOV (Average Order Value)' datatype='real' name='[Calculation_1179380212340822017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1179380202025639970]/SUM([orders])' />
            </column>
            <column caption='Period Date' datatype='date' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_236720497991634944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [date]&#13;&#10;END)' />
            </column>
            <column caption='PtD' datatype='boolean' name='[Calculation_236720498005434378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([date] &gt;= [Calculation_236720498005807115] AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Commission Revenue' datatype='real' name='[Calculation_2643472299412230144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue_local])' />
            </column>
            <column caption='GFV (Gross Food Value)' datatype='real' name='[Calculation_2643472299412332545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local])' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_2643472299413483528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0&#10;+ sum([commission_revenue_local])&#10;+ sum([df_user_paid_excl_vat_local]) &#10;+ sum([service_fee_excl_vat_local])&#10;+ sum([difference_to_minimum_order_value_excl_vat_local])&#10;+ sum([delivery_priority_fee_excl_vat_local])' />
            </column>
            <column caption='Cost' datatype='real' name='[Calculation_2643472299413848073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0&#10;+ sum([payment_fee])&#10;+ sum([order_rider_payment])' />
            </column>
            <column caption='Gross Profit per Order' datatype='real' name='[Calculation_2643472299414081546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2643472299413483528] - [Calculation_2643472299413848073])/SUM([orders])' />
            </column>
            <column caption='Commission Revenue per Order' datatype='real' name='[Calculation_2643472299421982731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue_local])/SUM([orders])' />
            </column>
            <column caption='Delivery Fee Revenue per OD Order' datatype='real' name='[Calculation_2643472299422158860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee_paid_od]) /SUM([od_orders])' />
            </column>
            <column caption='Diff to MOV Revenue per Order' datatype='real' name='[Calculation_2643472299422228493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([difference_to_minimum_order_value_excl_vat_local])/SUM([orders])' />
            </column>
            <column caption='Priority Fee Revenue per OD Order' datatype='real' name='[Calculation_2643472299422310414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_priority_fee_excl_vat_local])/SUM([od_orders])' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='DH Subsidy per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_398568634248683520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_subsidy]) / SUM([orders])' />
            </column>
            <column caption='FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_398568634249211905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2643472299414081546]-[Calculation_398568634248683520]' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Index Period' datatype='integer' name='[Calculation_52072871791292446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='PoP PtD Title' datatype='string' name='[Calculation_52072871791542303]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WoW WtD&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; then &quot;MoM MtD&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; then &quot;DoD&quot;&#13;&#10;END' />
            </column>
            <column caption='Payment Fee Cost per Order' datatype='real' name='[Payment Fee Cost Total (copy)_2643472299422978065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([payment_fee])/SUM([orders])' />
            </column>
            <column caption='PtD LP' datatype='boolean' name='[PtD LY (copy)_1649724888175493121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN ([date] &gt;= DATEADD(&quot;month&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;month&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Weekly&quot; THEN  ([date] &gt;= DATEADD(&quot;week&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;week&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Daily&quot; THEN [date] = [Parameters].[Reporting Month (copy)_52072871788789788] - 1&#13;&#10;END' />
            </column>
            <column caption='PtD or PtD LP' datatype='boolean' name='[PtD or PtD LY (copy)_1649724888176001026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_236720498005434378] OR [PtD LY (copy)_1649724888175493121]' />
            </column>
            <column caption='Rider Payment Cost per OD Order' datatype='real' name='[Rider Payment Cost Total (copy)_2643472299422990354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_rider_payment_local])/sum([successful_orders_od_with_rooster_payment])' />
            </column>
            <column caption='Service Fee Revenue per Order' datatype='real' name='[Service Fee Revenue Total (copy)_2643472299422728207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_excl_vat_local])/SUM([orders])' />
            </column>
            <column caption='City Original' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='commission_rev_local' datatype='real' name='[commission_revenue_local]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
            <column caption='Delivery Fee Paid Od' datatype='real' name='[delivery_fee_paid_od]' role='measure' type='quantitative' />
            <column datatype='real' name='[delivery_priority_fee_excl_vat_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[df_user_paid_excl_vat_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[dh_subsidy]' role='measure' type='quantitative' />
