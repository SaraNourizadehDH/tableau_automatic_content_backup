        <calculation class='tableau' formula='SUM([rsat_promoters_cz])&#13;&#10;/&#13;&#10;SUM([rsat_responses_cz])' />
      </column>
      <column caption='% RSAT EU Promoters' datatype='real' default-format='p0.00%' name='[% CSAT EU Promoters (copy)_629941030017036290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rsat_promoters_eu])&#13;&#10;/&#13;&#10;SUM([rsat_responses_eu])' />
      </column>
      <column caption='% CSAT EU Promoters' datatype='real' default-format='p0.00%' name='[% CSAT Promoters (copy) (copy)_141018970338549763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([csat_promoters_eu])&#13;&#10;/&#13;&#10;SUM([csat_responses_eu])' />
      </column>
      <column caption='% CSAT CZ Promoters' datatype='real' default-format='p0.00%' name='[% CSAT Promoters (copy)_141018970338537474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([csat_promoters_cz])&#13;&#10;/&#13;&#10;SUM([csat_responses_cz])' />
      </column>
      <column caption='% RSAT Promoters' datatype='real' default-format='p0.00%' name='[% CSAT Promoters (copy)_5557441992597512192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rsat_promoters])&#13;&#10;/&#13;&#10;SUM([rsat_responses])' />
      </column>
      <column caption='% CSAT Target (copy)' datatype='real' default-format='p0.00%' name='[% CSAT Target (copy)_1438055670183702529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10; &#13;&#10;    WHEN &apos;2024-07&apos; THEN 0.70&#13;&#10;    WHEN &apos;2024-08&apos; THEN 0.71&#13;&#10;    WHEN &apos;2024-09&apos; THEN 0.72&#13;&#10;    WHEN &apos;2024-10&apos; THEN 0.73&#13;&#10;    WHEN &apos;2024-11&apos; THEN 0.74&#13;&#10;    WHEN &apos;2024-12&apos; THEN 0.75&#13;&#10;END)' />
      </column>
      <column caption='% CSAT (orders) vs Target' datatype='real' default-format='p0%' name='[% CSAT vs Target  (copy)_1438055670183907330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% CSAT CZ Promoters (copy)_1365153646972735488] /[% Fail Rate Target (copy)_1473521543083282436] -1' />
      </column>
      <column caption='% CVR Target' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1179380202012463127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[Reporting Month (copy)_52072871788789788]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.230&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.230&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.231&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.232&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.233&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.235&#13;&#10;&#13;&#10;    WHEN &apos;2024-07&apos; THEN 0.270&#13;&#10;    WHEN &apos;2024-08&apos; THEN 0.272&#13;&#10;    WHEN &apos;2024-09&apos; THEN 0.274&#13;&#10;    WHEN &apos;2024-10&apos; THEN 0.276&#13;&#10;    WHEN &apos;2024-11&apos; THEN 0.278&#13;&#10;    WHEN &apos;2024-12&apos; THEN 0.280&#13;&#10;END)' />
      </column>
      <column caption='% CVR vs Target' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1179380202013892634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1392175243438944264] / [% CVR (copy)_1179380202012463127] - 1' />
