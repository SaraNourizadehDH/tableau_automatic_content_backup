      <column caption='Period Filter (YoY) ' datatype='boolean' name='[Week Filter (YoY) (copy)_236720497996136451]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Period Date (copy)_236720497993867266] = [Calculation_236720497996382212]&#13;&#10;AND&#13;&#10;ISOYEAR([date]) &gt;= ISOYEAR([Parameters].[Reporting Month (copy)_52072871788789788])-1 &#13;&#10;AND&#13;&#10;ISOYEAR([date]) &lt;= ISOYEAR([Parameters].[Reporting Month (copy)_52072871788789788])' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Week Filter (copy)_236720497993707521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN&#13;&#10; [date] &gt;= DATEADD(&apos;week&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)) AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN&#13;&#10; [date] &gt;= DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])) AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN&#13;&#10; [date] &gt;= [Parameters].[Reporting Month (copy)_52072871788789788] - ([Parameters].[Monthly / Weekly (copy)]-1) AND [date] &lt;= [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END' />
      </column>
      <column caption='Bolt Users (NPS)' datatype='real' default-format='p0.0%' name='[Wolt Users (NPS) (copy)_344243951704592387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nps_competitor_bolt])/SUM([nps_competitor_denominator])' />
      </column>
      <column caption='Jidlo pod nos Users (NPS)' datatype='real' default-format='p0.0%' name='[Wolt Users (NPS) (copy)_344243951704924165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nps_competitor_jidlo_pod_nos])/SUM([nps_competitor_denominator])' />
      </column>
      <column caption='PtD LY Title' datatype='string' name='[YtD LY Title (copy)_1212875715427082245]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &quot;MtD LY&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WtD LY&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &quot;Same Day LY&quot;&#13;&#10;END' />
      </column>
      <column caption='PtD LY' datatype='boolean' name='[YtD Last Year (weekly)  (copy)_1212875715427209222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([date]) = YEAR([Parameters].[Reporting Month (copy)_52072871788789788])-1&#13;&#10;AND &#13;&#10;IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN MONTH([date]) = MONTH([Parameters].[Reporting Month (copy)_52072871788789788]) AND DAY([date]) = DAY([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSE&#13;&#10;[Period Date (copy)_236720497993867266] = [Calculation_236720497996382212]&#13;&#10;AND&#13;&#10;IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DAY([date]) &lt;= DAY([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[date],&apos;monday&apos;),[date]) &lt;= DATEDIFF(&apos;day&apos;, datetrunc(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;),[Parameters].[Reporting Month (copy)_52072871788789788]) &#13;&#10;END&#13;&#10;END' />
      </column>
