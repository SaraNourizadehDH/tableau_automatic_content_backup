            <column caption='Display Ads Revenue / GMV Resto' datatype='real' default-format='p0.00%' name='[Calculation_1644376876708741128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1644376876707438593] / [Calculation_1179380202025685027]' />
