          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% RSAT CZ Promoters' datatype='real' default-format='p0.00%' name='[% CSAT CZ Promoters (copy)_629941030017019905]' role='measure' type='quantitative'>
