    <worksheet name='comm_monthly_mom'>
      <layout-options>
        <title>
          <formatted-text>
            <run>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_performance (tableau_outputs)' name='federated.1h3qwk01iwx3h819kn77207qc4i9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Periods' datatype='integer' name='[Monthly / Weekly (copy)]' param-domain-type='list' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[Calculation_984599483468599296]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[report_month]' caption='Reporting Month' datatype='date' default-format='*mmm yyyy' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h3qwk01iwx3h819kn77207qc4i9'>
            <column caption='% Display Ads Reve / Resto GMV' datatype='real' default-format='p0.00%' name='[% CPC Revenue / Resto GMV (copy)_86412850435674127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([display_ads_revenue_local])/SUM([resto_gmv])' />
            </column>
            <column caption='% Joker Revenue / Resto GMV' datatype='real' default-format='p0.00%' name='[% CPC Revenue / Resto GMV (copy)_86412850435854352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_fee_revenue_local])/SUM([resto_gmv])' />
            </column>
            <column caption='% Eshop Turnover / Resto GMV' datatype='real' default-format='p0.00%' name='[% Joker Revenue / Resto GMV (copy)_86412850436100113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eshop_turnover_local])/SUM([resto_gmv])' />
            </column>
            <column caption='% VFD PRO AB Penetration' datatype='real' default-format='p0.0%' name='[% VFD AB Penetration (copy)_86412850430898184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pro_vfd_ab_restos]) / [Calculation_86412850430017540]' />
            </column>
            <column caption='A/B Restos DLD &gt; 90 %' datatype='real' default-format='p0.0%' name='[A/B Restos DLP &gt; 90 % (copy)_86412850434617355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ab_dld_90_restos])/ sum([a_grade_restos] + [b_grade_restos])' />
            </column>
            <column caption='Active Restos' datatype='integer' name='[Calculation_1200490814606589960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_restos_with_order])' />
            </column>
            <column caption='PP Violations' datatype='integer' name='[Calculation_1203305560097230848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pp_violations])' />
            </column>
            <column caption='Churn AB Resto' datatype='integer' name='[Calculation_1203305560111222785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_ab_resto])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_1330813712526405632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city] when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='% VFD AB Penetration' datatype='real' default-format='p0.0%' name='[Calculation_1681250085836468225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_ab_restos]) / sum([ab_restos_with_order])' />
            </column>
            <column caption='% AB &gt; 75 orders in F60D' datatype='real' default-format='p0.00%' name='[Calculation_1904459732043444224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(successful_ab_vendor_pcnt)' />
            </column>
            <column caption='Deal Utilization Long Tail' datatype='real' default-format='p0.00%' name='[Calculation_2279384417339260928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([longtail_utilisation_numerator])/SUM([longtail_utilisation_denominator])' />
            </column>
            <column caption='Sales Productivity' datatype='real' name='[Calculation_507217924280799232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([total_field_rep_prod])' />
            </column>
            <column caption='Month Filter' datatype='boolean' name='[Calculation_52072871510233092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &gt;= DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),[Parameters].[report_month Parameter])&#13;&#10;AND&#13;&#10;[report_month] &lt;= [Parameters].[report_month Parameter]' />
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_52072871512281094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM Title' datatype='string' name='[Calculation_52072871513169927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; MoM&quot;' />
            </column>
            <column caption='IHS AB Restos' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_595038134772359170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([ihs_ab_resto])' />
            </column>
            <column caption='% OD Order Share' datatype='real' default-format='p0.0%' name='[Calculation_86412850426155008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_orders])/SUM([orders])' />
            </column>
            <column caption='# AB Restos' datatype='integer' name='[Calculation_86412850430017540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ab_restos_with_order])' />
            </column>
            <column caption='% AB Restos' datatype='real' default-format='p0.0%' name='[Calculation_86412850430386182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_86412850430017540]/SUM([active_restos_with_order])' />
            </column>
            <column caption='A/B Restos DLP &gt; 90 %' datatype='real' default-format='p0.0%' name='[Calculation_86412850434297866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ab_dlp_90_restos])/ sum([a_grade_restos] + [b_grade_restos])' />
            </column>
            <column caption='% PP GMV' datatype='real' default-format='p0.0%' name='[Calculation_86412850434920460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pp_gmv])/SUM([od_gmv])' />
            </column>
            <column caption='% CPC Revenue / Resto GMV' datatype='real' name='[Calculation_86412850435493902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_local])/SUM([resto_gmv])' />
            </column>
            <column caption='% NCR Revenue / Resto GMV' datatype='real' default-format='p0.00%' name='[Calculation_86412850436345874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Joker Revenue / Resto GMV (copy)_86412850436100113]&#13;&#10;+ [Calculation_86412850435493902]&#13;&#10;+ [% CPC Revenue / Resto GMV (copy)_86412850435674127]&#13;&#10;+ [% CPC Revenue / Resto GMV (copy)_86412850435854352]' />
            </column>
            <column caption='% CR Revenue / Resto Turnover' datatype='real' default-format='p0.00%' name='[Calculation_86412850460356644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([resto_commission_revenue_local]) / SUM([resto_commission_base_local])' />
            </column>
            <column caption='% VFD / Resto GMV' datatype='real' default-format='p0.00%' name='[Calculation_86412850476388391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deal_value_vf_local])/SUM([resto_gmv])' />
            </column>
            <column caption='Take Rate' datatype='real' default-format='p0.00%' name='[Calculation_86412850479538218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_86412850460356644] + [Calculation_86412850436345874] + [Calculation_86412850476388391]' />
            </column>
            <column caption='Onboarding Turnaround Days' datatype='real' name='[Calculation_902690283289214976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([days_to_activation])' />
            </column>
            <column caption='Last Data Date (Report Month)' datatype='date' name='[Calculation_984599483468599296]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Fixed: max(DATE([report_month]))}' />
            </column>
            <column caption='Sales Productivity AB' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sales Productivity (copy)_1472395638909038592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([total_ab_field_rep_prod])' />
