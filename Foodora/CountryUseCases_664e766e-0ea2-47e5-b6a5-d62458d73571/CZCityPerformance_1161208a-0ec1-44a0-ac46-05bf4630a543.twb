      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% CSAT Top 20%' datatype='real' default-format='p0.0%' name='[% CSAT (from orders) (copy)_1365153646973104129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_csat_promoters_top_customers])&#13;&#10;/&#13;&#10;SUM([order_csat_responses_top_customers])' />
            </column>
            <column caption='% CSAT (from orders)' datatype='real' default-format='p0.0%' name='[% CSAT CZ Promoters (copy)_1365153646972735488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_csat_promoters])&#13;&#10;/&#13;&#10;SUM([order_csat_responses])' />
            </column>
            <column caption='Customer Cancel Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_1438055670177628160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_customer_orders]) / sum([failed_orders] + [orders])' />
            </column>
            <column caption='Wolt &amp; Bolt Users (NPS)' datatype='real' default-format='p0.0%' name='[Bolt Users (NPS) (copy)_344243951704739844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nps_competitor_wolt_and_bolt])/SUM([nps_competitor_denominator])' />
            </column>
            <column caption='Reporting Period' datatype='integer' name='[Calculation_236720497996382212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN ISOWEEK([Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;END' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Wolt Users (NPS)' datatype='real' default-format='p0.0%' name='[Calculation_344243951704195073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nps_competitor_wolt])/SUM([nps_competitor_denominator])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='NPS # of Responses' datatype='integer' name='[Calculation_879609308598050816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nps_responses])' />
            </column>
            <column caption='Customer NPS Delivery' datatype='real' name='[Customer NPS Application (copy)_1392175243437285378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_delivery]) - sum([nps_detractors_delivery])) / sum([nps_responses_delivery])' />
            </column>
            <column caption='Customer NPS Service' datatype='real' name='[Customer NPS Application (copy)_879609308598673410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_customer_service]) - sum([nps_detractors_customer_service])) / sum([nps_responses_customer_service])' />
            </column>
            <column caption='Customer NPS Pricing' datatype='real' name='[Customer NPS Delivery (copy) (copy)_1392175243437662212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_pricing]) - sum([nps_detractors_pricing])) / sum([nps_responses_pricing])' />
            </column>
            <column caption='Customer NPS Variety' datatype='real' name='[Customer NPS Delivery (copy)_1392175243437645827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_choice]) - sum([nps_detractors_choice])) / sum([nps_responses_choice])' />
            </column>
            <column caption='Customer NPS Deals' datatype='real' name='[Customer NPS Delivery (copy)_879609308598296577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_deals_and_discounts]) - sum([nps_detractors_deals_and_discounts])) / sum([nps_responses_deals_and_discounts])' />
            </column>
            <column caption='Customer NPS LS' datatype='real' default-format='n#,##0;-#,##0' name='[Customer NPS Dmart (copy)_674132582667419649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_ls]) - sum([nps_detractors_ls])) / sum([nps_responses_ls])' />
            </column>
            <column caption='Customer NPS Dmart' datatype='real' default-format='n#,##0;-#,##0' name='[Customer NPS OD (copy)_1285496234305052673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_dmart]) - sum([nps_detractors_dmart])) / sum([nps_responses_dmart])' />
            </column>
            <column caption='Customer NPS MP' datatype='real' name='[Customer NPS OD (copy)_1392175243438604295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_mp]) - sum([nps_detractors_mp])) / sum([nps_responses_mp])' />
            </column>
            <column caption='Customer NPS Quality' datatype='real' name='[Customer NPS Pricing (copy)_1392175243438350341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_quality]) - sum([nps_detractors_quality])) / sum([nps_responses_quality])' />
            </column>
            <column caption='Customer NPS OD' datatype='real' name='[Customer NPS Quality (copy)_1392175243438493702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters_od]) - sum([nps_detractors_od])) / sum([nps_responses_od])' />
            </column>
            <column caption='Period' datatype='integer' datatype-customized='true' name='[Period Date (copy)_236720497993867266]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN ISOWEEK([date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN MONTH([date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN DAY([date])&#13;&#10;END' />
            </column>
            <column caption='Customer NPS' datatype='real' name='[Rider NPS (copy)_1392175243436638208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum([nps_promoters]) - sum([nps_detractors])) / sum([nps_responses])' />
            </column>
            <column caption='Bolt Users (NPS)' datatype='real' default-format='p0.0%' name='[Wolt Users (NPS) (copy)_344243951704592387]' role='measure' type='quantitative'>
