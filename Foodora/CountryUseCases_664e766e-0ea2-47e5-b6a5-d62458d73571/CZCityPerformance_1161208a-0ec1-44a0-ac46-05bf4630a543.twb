      <table>
        <view>
          <datasources>
            <datasource caption='monthly_performance (tableau_outputs)' name='federated.1h3qwk01iwx3h819kn77207qc4i9' />
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[Calculation_984599483468599296]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[report_month]' caption='Reporting Month' datatype='date' default-format='*mmm yyyy' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='Days in Reporting Period to Date' datatype='integer' name='[Calculation_1188668875949379604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Reporting Month (copy)_52072871788789788] - [Calculation_236720498005807115] +1' />
            </column>
            <column caption='End of Reporting Period' datatype='datetime' name='[Calculation_1188668875950088213]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788]))-1&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)+6&#13;&#10;END' />
            </column>
            <column caption='PtD for targets' datatype='real' name='[Calculation_1188668875951497240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1188668875949379604]/[Days in Reporting Period to Date (copy)_1188668875950419990]) * CASE [Parameters].[Parameter 1] WHEN &apos;Monthly&apos; THEN 1 WHEN &apos;Weekly&apos; THEN 7/[Days in Reporting Period Total (copy)_1188668875951071255] END' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Days in Reporting Month' datatype='real' name='[Days in Reporting Period Total (copy)_1188668875951071255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])) - DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])' />
            </column>
            <column caption='Days in Reporting Period Total' datatype='real' name='[Days in Reporting Period to Date (copy)_1188668875950419990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1188668875950088213] - [Calculation_236720498005807115] + 1' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h3qwk01iwx3h819kn77207qc4i9'>
            <column caption='LS AAA Partners per MAU Target' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# AB Restos Target (copy)_2093610924924633088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1330813712526405632] = &apos; CZ Total&apos; THEN&#13;&#10;CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;        WHEN &apos;2025-01&apos; THEN 1.29&#13;&#10;        WHEN &apos;2025-02&apos; THEN 1.31&#13;&#10;        WHEN &apos;2025-03&apos; THEN 1.32&#13;&#10;        WHEN &apos;2025-04&apos; THEN 1.33&#13;&#10;        WHEN &apos;2025-05&apos; THEN 1.35&#13;&#10;        WHEN &apos;2025-06&apos; THEN 1.36&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='QC Trials Target' datatype='real' name='[Acquisitions Target (copy)_2093610924938403844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Calculation_1330813712526405632] = &apos; CZ Total&apos; THEN &#13;&#10;CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;    WHEN &apos;2025-01&apos; THEN 7859&#13;&#10;    WHEN &apos;2025-02&apos; THEN 7963&#13;&#10;    WHEN &apos;2025-03&apos; THEN 8113&#13;&#10;    WHEN &apos;2025-04&apos; THEN 8249&#13;&#10;    WHEN &apos;2025-05&apos; THEN 8332&#13;&#10;    WHEN &apos;2025-06&apos; THEN 8462&#13;&#10;END&#13;&#10;END)&#13;&#10;* MAX([federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_1188668875951497240])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_1330813712526405632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city] when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='= Report month' datatype='boolean' name='[Calculation_52072871511171077]' role='dimension' type='nominal'>
