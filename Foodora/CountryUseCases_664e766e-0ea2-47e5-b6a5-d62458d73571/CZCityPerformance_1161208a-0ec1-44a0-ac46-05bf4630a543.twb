    <worksheet name='Dream City last period rank'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Monthly / Weekly / Daily' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Dream City' datatype='string' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot; praha&quot;'>
              <calculation class='tableau' formula='&quot; praha&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='% CSAT (from orders)' datatype='real' default-format='p0.0%' name='[% CSAT CZ Promoters (copy)_1365153646972735488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_csat_promoters])&#13;&#10;/&#13;&#10;SUM([order_csat_responses])' />
            </column>
            <column caption='Local Shops Sessions Share' datatype='real' default-format='p0.0%' name='[% Dmart Sessions (copy)_1356709420443643905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_sessions])&#13;&#10;/&#13;&#10;sum([sessions])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_900438471487909893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_vendor_orders]) / sum([failed_orders] + [orders])' />
            </column>
            <column caption='% VFD PRO / GMV' datatype='real' default-format='p0.0%' name='[% VFD / GMV (copy)_1061160665777733633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[VFD Value (copy)_1061160665777655808] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='% scooter share' datatype='real' default-format='p0.0%' name='[% bike share (copy)_886646182732558340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_motorbike]) / sum([completed_deliveries])' />
            </column>
            <column caption='% delay &gt; 20' datatype='real' default-format='p0.0%' name='[% delay &gt; 10 (copy)_886646182732075009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delayed_20]) / sum([completed_orders])' />
            </column>
            <column caption='% Campaign Orders' datatype='real' default-format='p0.0%' name='[Calculation_1006554531980337152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date] &lt;&gt; [Calculation_2852326719360741382] THEN [resto_campaign_orders] END)/SUM(IF [date] &lt;&gt; [Calculation_2852326719360741382] THEN [orders] END)' />
            </column>
            <column caption='Orders per mille' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1172061848792117248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000 * SUM([orders])/MAX([population])' />
            </column>
            <column caption='GMV Resto' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202025685027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local_restaurants])' />
            </column>
            <column caption='Dmart Sessions Share' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_1356709420443377664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_sessions])/sum([sessions])' />
            </column>
            <column caption='% PP GMV' datatype='real' default-format='p0.0%' name='[Calculation_138204246623809536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pp_gmv])&#13;&#10;/&#13;&#10;sum([pp_total_gmv_resto])' />
            </column>
            <column caption='% CVR' datatype='real' default-format='p0.0%' name='[Calculation_1392175243438944264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transactions]) / sum([sessions])' />
            </column>
            <column caption='# AB Restos' datatype='integer' name='[Calculation_1410471159001042951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(MAX([a_grade_vendors]),0) + IFNULL(MAX([b_grade_vendors]),0)' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1451566489713233920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_scheduled_open_seconds] - [total_closed_seconds])&#13;&#10;/&#13;&#10;sum([total_scheduled_open_seconds])' />
            </column>
            <column caption='Is Last Period' datatype='boolean' name='[Calculation_1649724888182579203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_236720497991634944] = [Calculation_236720498005807115]' />
            </column>
            <column caption='Period Date' datatype='date' datatype-customized='true' default-format='*dd-mmm-yy' name='[Calculation_236720497991634944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[date],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [date]&#13;&#10;END)' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Active Restos' datatype='integer' name='[Calculation_455708045045452802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([active_vendors])' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Rank % OD Order Share' datatype='integer' default-format='N' name='[Calculation_622622656960331806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK( SUM({ FIXED [Calculation_464715208252108800],[Calculation_236720497991634944] : ([Calculation_900438471486484481])}),&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Choose City' datatype='string' name='[Calculation_622622656996839475]' role='measure' type='nominal'>
              <calculation class='tableau' formula='window_min(attr([Calculation_464715208252108800]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='last period rank label' datatype='string' name='[Calculation_622622657003634746]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Last Period Rank (1 is the best)&apos;' />
              <aliases>
                <alias key='&quot;Last Period Rank (1 is the best)&quot;' value='Last Period Rank (1=best)' />
              </aliases>
            </column>
            <column caption='City filter' datatype='boolean' name='[Calculation_622622657005183035]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_622622656996839475] = [Parameters].[Parameter 6]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='PRO Orders %' datatype='real' default-format='p0.0%' name='[Calculation_638385247291756550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([subscription_orders]) /  sum([orders])' />
            </column>
            <column caption='VFD Value' datatype='real' name='[Calculation_790381762693140480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([vf_deal_value],0))&#13;&#10;+&#13;&#10;sum(IFNULL([manual_adjustment_value_czk],0))' />
            </column>
            <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_790381762693140480] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='% delay &gt; 10' datatype='real' default-format='p0.0%' name='[Calculation_886646182731751424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delayed_10]) / sum([completed_orders])' />
