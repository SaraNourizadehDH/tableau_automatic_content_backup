            <column caption='Vendors Signed AB Share' datatype='real' default-format='p0%' name='[Calculation_223772645045186560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ab_restos_signed])/[Calculation_63613409556004866]' />
            </column>
            <column caption='Start of Reporting Period' datatype='date' name='[Calculation_236720498005807115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(If [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[Reporting Month (copy)_52072871788789788])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Parameters].[Reporting Month (copy)_52072871788789788],&apos;monday&apos;)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [Parameters].[Reporting Month (copy)_52072871788789788]&#13;&#10;END)' />
            </column>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_464715208252108800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city]&#13;&#10;when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Avg Waiting in Resto (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_523261992953470976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([at_vendor_time_min])/SUM([at_vendor_time_count])' />
            </column>
            <column caption='VFD GMV Penetration' datatype='real' default-format='p0.0%' name='[Calculation_63613409555275776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_restos_with_vf_deals])/[Calculation_1179380202025685027]' />
            </column>
            <column caption='Vendors Signed' datatype='integer' name='[Calculation_63613409556004866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restos_signed])' />
            </column>
            <column caption='Deal Utilisation' datatype='real' default-format='p0.0%' name='[Calculation_63613409561718788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([resto_orders_with_deals])/[Calculation_1458040444875382784]' />
            </column>
            <column caption='VFD Value' datatype='real' name='[Calculation_790381762693140480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IFNULL([vf_deal_value],0))&#13;&#10;+&#13;&#10;sum(IFNULL([manual_adjustment_value_czk],0))' />
            </column>
            <column caption='% VFD / GMV' datatype='real' default-format='p0.0%' name='[Calculation_790381762694070273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_790381762693140480] / sum([gmv_local_restaurants])' />
            </column>
            <column caption='Penalty Amount per mille GMV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_899594063839510528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000*SUM([penalty_amount])/[Calculation_1179380202025685027]' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_900438471487643652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / sum([failed_orders] + [orders])' />
            </column>
            <column caption='% Vendor Late &gt; 10' datatype='real' default-format='p0.00%' name='[Calculation_900438471492648968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_over_10_count]) / sum([completed_orders])' />
            </column>
            <column caption='Targeted Deals Reve / GMV Resto' datatype='real' default-format='p0.00%' name='[Display Ads Revenue / GMV Resto (copy)_1443403712414015489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1443403712413802496] / [Calculation_1179380202025685027]' />
            </column>
            <column caption='PRO Orders with PRO Deal %' datatype='real' default-format='p0.0%' name='[Orders with Deal % (copy)_1006554531980521473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([resto_orders_with_pro_deals])/SUM([subscription_orders])' />
            </column>
            <column caption='PtD LP' datatype='boolean' name='[PtD LY (copy)_1649724888175493121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Monthly&quot; THEN ([date] &gt;= DATEADD(&quot;month&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;month&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Weekly&quot; THEN  ([date] &gt;= DATEADD(&quot;week&quot;,-1,[Calculation_236720498005807115]) AND [date] &lt;= DATEADD(&quot;week&quot;, -1, [Parameters].[Reporting Month (copy)_52072871788789788]))&#13;&#10;    WHEN &quot;Daily&quot; THEN [date] = [Parameters].[Reporting Month (copy)_52072871788789788] - 1&#13;&#10;END' />
            </column>
            <column caption='PtD LP Title' datatype='string' name='[PtD LY Title (copy)_1649724888174682112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &quot;MtD LM&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &quot;WtD LW&quot;&#13;&#10;ELSEIF&#13;&#10;    [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &quot;Previous Day&quot;&#13;&#10;END' />
