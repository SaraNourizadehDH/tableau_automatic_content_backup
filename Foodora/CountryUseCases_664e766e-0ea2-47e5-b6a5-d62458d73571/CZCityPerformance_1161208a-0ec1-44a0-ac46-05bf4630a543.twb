              <calculation class='tableau' formula='IF [Calculation_1330813712526405632] = &apos; CZ Total&apos; THEN&#13;&#10;CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;        WHEN &apos;2024-07&apos; THEN 16&#13;&#10;        WHEN &apos;2024-08&apos; THEN 19&#13;&#10;        WHEN &apos;2024-09&apos; THEN 22&#13;&#10;        WHEN &apos;2024-10&apos; THEN 23&#13;&#10;        WHEN &apos;2024-11&apos; THEN 23&#13;&#10;        WHEN &apos;2024-12&apos; THEN 16&#13;&#10;END&#13;&#10;END' />
