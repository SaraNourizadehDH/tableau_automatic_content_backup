    <worksheet name='qcomm_monthly_mom'>
      <layout-options>
        <title>
          <formatted-text>
            <run>MoM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_performance (tableau_outputs)' name='federated.1h3qwk01iwx3h819kn77207qc4i9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Periods' datatype='integer' name='[Monthly / Weekly (copy)]' param-domain-type='list' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[Calculation_984599483468599296]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1h3qwk01iwx3h819kn77207qc4i9].[report_month]' caption='Reporting Month' datatype='date' default-format='*mmm yyyy' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h3qwk01iwx3h819kn77207qc4i9'>
            <column caption='QC Trial Retention 1M' datatype='real' default-format='p0.0%' name='[Acq Retention 1M (copy) (copy)_1671961403109122051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trial_retention_1m])/SUM([base_qc_trial_1m_ago])' />
            </column>
            <column caption='LS AAA Partners per MAU' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1160521372255297536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([key_partners_per_mau])' />
            </column>
            <column caption='MAU (Monthly Active Users)' datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[Calculation_1179380202071203884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_users])' />
            </column>
            <column caption='QC MAU' datatype='integer' name='[Calculation_1200490814605418502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qcomm_customers])' />
            </column>
            <column caption='QC MAU %' datatype='real' default-format='p0.00%' name='[Calculation_1200490814605537287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1200490814605418502]/[Calculation_1179380202071203884]' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_1330813712526405632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city] when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Dmart Items Per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1439744554370715650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_sold_items_total])/SUM([dmart_orders])' />
            </column>
            <column caption='QC Trials' datatype='integer' name='[Calculation_1671961403119190022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trials])' />
            </column>
            <column caption='Dmart Trials' datatype='integer' name='[Calculation_1671961403146964999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_trials])' />
            </column>
            <column caption='LS Trials' datatype='integer' name='[Calculation_1671961403147087880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_trials])' />
            </column>
            <column caption='Month Filter' datatype='boolean' name='[Calculation_52072871510233092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &gt;= DATEADD(&apos;month&apos;,-([Parameters].[Monthly / Weekly (copy)]-1),[Parameters].[report_month Parameter])&#13;&#10;AND&#13;&#10;[report_month] &lt;= [Parameters].[report_month Parameter]' />
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_52072871512281094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM Title' datatype='string' name='[Calculation_52072871513169927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[report_month Parameter]),3) + &quot; MoM&quot;' />
            </column>
            <column caption='Last Data Date (Report Month)' datatype='date' name='[Calculation_984599483468599296]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Fixed: max(DATE([report_month]))}' />
            </column>
            <column caption='Dmart Products Per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Dmart Items Per Order (copy)_1439744554373525507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_sold_products_total])/SUM([dmart_orders])' />
            </column>
            <column caption='LS Trial Retention 1M' datatype='real' default-format='p0.0%' name='[QC Trial Retention 1M (copy) (copy)_1671961403147362314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_trial_retention_1m])/SUM([base_ls_trial_1m_ago])' />
