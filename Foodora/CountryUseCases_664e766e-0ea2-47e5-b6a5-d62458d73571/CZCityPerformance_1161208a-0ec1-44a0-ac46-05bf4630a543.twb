      <column caption='% aCVR (Acq / DL)' datatype='real' default-format='p0.0%' name='[% CVR (copy)_239816700292403200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF NOT ISNULL([downloads]) THEN [acquistions] END) / sum([downloads])' />
