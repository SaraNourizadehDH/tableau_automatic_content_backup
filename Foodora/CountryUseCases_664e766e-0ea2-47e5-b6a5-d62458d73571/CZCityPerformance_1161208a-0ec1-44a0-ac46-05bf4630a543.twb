            <datasource caption='daily_performance (tableau_outputs)' name='federated.1eh9y440bpokxq148mq340kmlt9d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dream City' datatype='string' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot; praha&quot;'>
              <calculation class='tableau' formula='&quot; praha&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[Calculation_2852326719360741382]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1eh9y440bpokxq148mq340kmlt9d].[date]' caption='Reporting Date' datatype='date' default-format='*dd-mmm-yy' name='[Reporting Month (copy)_52072871788789788]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eh9y440bpokxq148mq340kmlt9d'>
            <column caption='Last Data Date' datatype='date' name='[Calculation_2852326719360741382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{Max([date])}' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h3qwk01iwx3h819kn77207qc4i9'>
            <column caption='PRO MAUs %' datatype='real' default-format='p0.00%' name='[% Subscription Orders (copy)_939563473374679040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[subscriber_users] /  [unique_users]' />
            </column>
            <column caption='= Report month City CEO' datatype='boolean' name='[= Report month (copy)_523824942623879169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] = DATE(DATETRUNC(&quot;month&quot;,[Parameters].[Reporting Month (copy)_52072871788789788]))' />
            </column>
            <column caption='% Multivertical Users' datatype='real' default-format='p0.00%' name='[Calculation_1172061848810901510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[multivertical_customers]/[unique_users]' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_1330813712526405632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [city] when &apos;Total CZ&apos; then &apos; CZ Total&apos;&#13;&#10;when &apos;praha&apos; then &apos; praha&apos;&#13;&#10;else [city]&#13;&#10;end' />
            </column>
            <column caption='Population' datatype='real' name='[Calculation_1524468483091767296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([population])' />
            </column>
            <column caption='Dmart Users per mille' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1524468483092123649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000 * MAX([dmart_customers])/[Calculation_1524468483091767296]' />
            </column>
            <column caption='Choose City' datatype='string' name='[Calculation_811210892086812672]' role='measure' type='nominal'>
              <calculation class='tableau' formula='window_min(attr([Calculation_1330813712526405632]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dream City Filter' datatype='boolean' name='[City Filter (copy)_21392107416301568]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_811210892086812672] = [Parameters].[Parameter 6]'>
