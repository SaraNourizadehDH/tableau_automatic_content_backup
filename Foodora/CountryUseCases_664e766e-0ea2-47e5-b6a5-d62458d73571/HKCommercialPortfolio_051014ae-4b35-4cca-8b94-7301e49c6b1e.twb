            <column caption='AOV' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1801158438967074841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv])/sum([order])' />
            </column>
            <column caption='AOV (Fixed)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_2368330508839546882]' role='measure' type='quantitative'>
