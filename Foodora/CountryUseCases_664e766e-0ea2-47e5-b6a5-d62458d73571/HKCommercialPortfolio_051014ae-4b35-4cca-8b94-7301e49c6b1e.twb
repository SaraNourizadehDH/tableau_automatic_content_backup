    <worksheet name='Monthly Order Growth Vendor List'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>Monthly &lt;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>[Parameters].[Level (copy)]</run>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt; Growth &lt;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>[Parameters].[gfv Parameter]</run>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt; (+ / -)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-68:8348/t/Foodora/workbooks/TopList/MonthlyOrderGrowthVendorList?rev=' id='MonthlyOrderGrowthVendorList' path='/t/Foodora/workbooks/TopList' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Metrics' name='federated.0nxhv291dwaw0p10s112g170l83h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Growth Metrics' datatype='string' name='[Level (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;NC FP&quot;'>
              <calculation class='tableau' formula='&quot;NC FP&quot;' />
            </column>
            <column caption='Level' datatype='string' name='[gfv Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain&quot;'>
              <calculation class='tableau' formula='&quot;Chain&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nxhv291dwaw0p10s112g170l83h'>
            <column caption='Agg. Concat.' datatype='string' name='[Calculation_1297881181669613574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[agg_name] +  &apos; - &apos; +  [agg_code]' />
            </column>
            <column caption='Vendor Concat.' datatype='string' name='[Calculation_1297881181669834759]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &apos; - &apos; + [vendor_code]' />
            </column>
            <column caption='% Order Growth' datatype='real' default-format='p0.00%' name='[Calculation_1790462352262553601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order]) - sum([order_lookup])) / sum([order_lookup])' />
            </column>
            <column caption='# Order Growth' datatype='integer' name='[Calculation_1790462352263991298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order]) - sum([order_lookup])' />
            </column>
            <column caption='Para. Name' datatype='string' name='[Calculation_1801158438921039882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[gfv Parameter]&#13;&#10;When &quot;Chain&quot; then [Calculation_1297881181669613574] &#13;&#10;when &quot;Outlet&quot; then [Calculation_1297881181669834759]&#13;&#10;when &quot;Cuisine&quot; then [primary_cuisine]&#13;&#10;when &quot;Account Owner&quot; then [account_owner]&#13;&#10;when &quot;Delivery Hub&quot; then [delivery_hub]&#13;&#10;when &quot;Brand&quot; then [brand_name]&#13;&#10;when &quot;HQ&quot; then [hq_name]&#13;&#10;when &quot;Company Signed By&quot; then [contract_owner]&#13;&#10;when &quot;BD Zone&quot; then [zone_name]&#13;&#10;when &quot;Vertical&quot; then [vertical]&#13;&#10;when &quot;Vendor Grade&quot; then [vendor_grade]&#13;&#10;when &quot;GMV Class&quot; THEN [gmv_class]&#13;&#10;end' />
            </column>
            <column caption='% GFV Growth' datatype='real' name='[Calculation_927741548899041280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gfv]) - sum([gfv_lookup])) / sum([gfv])' />
            </column>
            <column caption='% B2B Order Growth' datatype='real' name='[Calculation_927741548899160065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([b2b_order]) - sum([b2b_order_lookup])) / sum([b2b_order_lookup])' />
            </column>
            <column caption='% B2B GFV Growth' datatype='real' name='[Calculation_927741548899352578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([b2b_gfv]) - sum([b2b_gfv_lookup])) / sum([b2b_gfv_lookup])' />
            </column>
            <column caption='% CX Growth' datatype='real' name='[Calculation_927741548899487747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cx]) - sum([cx_lookup])) / sum([cx_lookup])' />
            </column>
            <column caption='% NC FP Growth' datatype='real' name='[Calculation_927741548899622916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nc_fp]) - sum([nc_fp_lookup])) / sum([nc_fp_lookup])' />
            </column>
            <column caption='% NC Vendor Growth' datatype='real' name='[Calculation_927741548899733509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nc_vendor]) - sum([nc_vendor_lookup])) / sum([nc_vendor_lookup])' />
            </column>
            <column caption='% Sessions Growth' datatype='real' name='[Calculation_927741548899864582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sessions]) - sum([sessions_lookup])) / sum([sessions_lookup])' />
            </column>
            <column caption='% CR3 Growth' datatype='real' name='[Calculation_927741548899979271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([cr3_b])/sum([cr3_a])) - (sum([cr3_b_lookup])/sum([cr3_a_lookup]))) / (sum([cr3_b_lookup])/sum([cr3_a_lookup]))' />
            </column>
            <column caption='% Decline Growth' datatype='real' name='[Calculation_927741548900438024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM([decline_b])/sum([decline_a])) - (sum([decline_b_lookup])/sum([decline_a_lookup]))) / (sum([decline_b_lookup])/sum([decline_a_lookup]))) * -1' />
            </column>
            <column caption='% Late Growth' datatype='real' name='[Calculation_927741548901658633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM([late_b])/sum([late_a])) - (sum([late_b_lookup])/sum([late_a_lookup]))) / (sum([late_b_lookup])/sum([late_a_lookup]))) * -1' />
            </column>
            <column caption='% PT Growth' datatype='real' name='[Calculation_927741548901859338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM([prep_time_min])/sum([pt_valid])) - (sum([prep_time_min_lookup])/sum([pt_valid_lookup]))) / (sum([prep_time_min_lookup])/sum([pt_valid_lookup]))) * -1' />
            </column>
            <column caption='# GFV Growth' datatype='real' name='[Calculation_927741548902260747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv]) - sum([gfv_lookup])' />
            </column>
            <column caption='# B2B Order Growth' datatype='integer' name='[Calculation_927741548902330380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([b2b_order]) - sum([b2b_order_lookup])' />
            </column>
            <column caption='# B2B GFV Growth' datatype='real' name='[Calculation_927741548902404109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([b2b_gfv]) - sum([b2b_gfv_lookup])' />
            </column>
            <column caption='# Sessions Growth' datatype='integer' name='[Calculation_927741548902486030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions]) - sum([sessions_lookup])' />
            </column>
            <column caption='# CR3 Growth' datatype='real' name='[Calculation_927741548902567951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cr3_b])/SUM([cr3_a])) - (sum([cr3_b_lookup])/sum([cr3_a_lookup]))' />
            </column>
            <column caption='# Decline Growth' datatype='real' name='[Calculation_927741548902969360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([decline_b])/SUM([decline_a])) - (sum([decline_b_lookup])/sum([decline_a_lookup]))) * -1' />
            </column>
            <column caption='# Late Growth' datatype='real' name='[Calculation_927741548903194641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([late_b])/SUM([late_a])) - (sum([late_b_lookup])/sum([late_a_lookup]))) * -1' />
            </column>
            <column caption='# PT Growth' datatype='real' name='[Calculation_927741548903288850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([prep_time_min])/SUM([pt_valid])) - (sum([prep_time_min_lookup])/sum([pt_valid_lookup]))) * -1' />
            </column>
            <column caption='# CX Growth' datatype='integer' name='[Calculation_927741548904456211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cx]) - sum([cx_lookup])' />
            </column>
            <column caption='# NC FP Growth' datatype='integer' name='[Calculation_927741548904574996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nc_fp]) - sum([nc_fp_lookup])' />
            </column>
            <column caption='# NC Vendor Growth' datatype='integer' name='[Calculation_927741548904652821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nc_vendor]) - sum([nc_vendor_lookup])' />
            </column>
            <column caption='Para. % Growth' datatype='real' default-format='p0.00%' name='[Calculation_927741548905152535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Level (copy)]&#13;&#10;WHEN &apos;Order&apos; THEN [Calculation_1790462352262553601]&#13;&#10;WHEN &apos;GFV&apos; THEN [Calculation_927741548899041280]&#13;&#10;WHEN &apos;B2B Order&apos; THEN [Calculation_927741548899160065]&#13;&#10;WHEN &apos;B2B GFV&apos; THEN [Calculation_927741548899352578]&#13;&#10;WHEN &apos;CX&apos; THEN [Calculation_927741548899487747]&#13;&#10;WHEN &apos;NC FP&apos; THEN [Calculation_927741548899622916]&#13;&#10;WHEN &apos;NC Vendor&apos; THEN [Calculation_927741548899733509]&#13;&#10;WHEN &apos;Sessions&apos; THEN [Calculation_927741548899864582]&#13;&#10;WHEN &apos;CR3&apos; THEN [Calculation_927741548899979271]&#13;&#10;WHEN &apos;Decline&apos; THEN [Calculation_927741548900438024]&#13;&#10;WHEN &apos;Late&apos; THEN [Calculation_927741548901658633]&#13;&#10;WHEN &apos;Prep Time&apos; THEN [Calculation_927741548901859338]&#13;&#10;END' />
