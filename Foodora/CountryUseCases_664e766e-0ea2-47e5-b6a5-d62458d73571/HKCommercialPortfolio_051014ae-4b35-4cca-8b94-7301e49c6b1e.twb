      <column caption='Ranking Category' datatype='string' name='[Calculation_1103100446161838080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[markup_bin] + &apos; - &apos; + [commission_bin] + &apos; - &apos; + [fail_rate_bin]' />
      </column>
      <column caption='current_week' datatype='boolean' name='[Calculation_1201335206537474048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date]=dateadd(&apos;day&apos;,1,DATETRUNC(&apos;week&apos;,today()))' />
      </column>
      <column caption='para_metrics' datatype='real' name='[Calculation_1201335206537957377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[account_owner Parameter]&#13;&#10;when &quot;Order&quot; then sum([order])&#13;&#10;when &quot;GFV&quot; then sum([gfv])&#13;&#10;when &quot;AOV&quot; then [Calculation_1428485512708919302]&#13;&#10;when &quot;Sessions&quot; then sum([sessions])&#13;&#10;when &quot;CR3&quot; then [Calculation_1428485512710418443]&#13;&#10;when &quot;Reorder&quot; then [Calculation_1428485512712224780]&#13;&#10;when &quot;Prep Time&quot; then [Calculation_1428485512712626191]&#13;&#10;when &quot;Decline Rate&quot; then [Calculation_1428485512712347661]&#13;&#10;when &quot;Late (5 Mins)&quot; then [Calculation_1428485512712486926]&#13;&#10;when &quot;New Customer (Foodpanda)&quot; then sum([nc_fp])&#13;&#10;when &quot;New Customer (Vendor)&quot; then sum([nc_vendor])&#13;&#10;when &quot;Per Outlet Order&quot; then [Calculation_1428485512709140487]&#13;&#10;when &apos;B2B GFV&apos; then sum([b2b_gfv])&#13;&#10;END' />
      </column>
      <column caption='Agg. Concat.' datatype='string' name='[Calculation_1428485512699437057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[agg_name] +  &apos; - &apos; +  [agg_code]' />
      </column>
      <column caption='Vendor Concat.' datatype='string' name='[Calculation_1428485512699600898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_name] + &apos; - &apos; + [vendor_code]' />
      </column>
      <column caption='Para. Name' datatype='string' name='[Calculation_1428485512699699203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[gfv Parameter]&#13;&#10;When &quot;Chain&quot; then [Calculation_1428485512699437057] &#13;&#10;when &quot;Outlet&quot; then [Calculation_1428485512699600898]&#13;&#10;when &quot;Cuisine&quot; then [primary_cuisine]&#13;&#10;when &quot;Account Owner&quot; then [account_owner]&#13;&#10;when &quot;Delivery Hub&quot; then [delivery_hub]&#13;&#10;when &quot;Brand&quot; then [brand_name]&#13;&#10;when &quot;HQ&quot; then [hq_name]&#13;&#10;when &quot;Company Signed By&quot; then [contract_owner]&#13;&#10;when &quot;BD Zone&quot; then [zone_name]&#13;&#10;when &quot;Vertical&quot; then [vertical]&#13;&#10;when &quot;Vendor Grade&quot; then [vendor_grade]&#13;&#10;when &quot;GMV Class&quot; THEN [gmv_class]&#13;&#10;end' />
      </column>
      <column caption='Commission' datatype='real' name='[Calculation_1428485512703291396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([gfv] - [vendor_discount_value]) * [commission_percentage]' />
      </column>
      <column caption='RPO' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1428485512703512581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_b2c_commission])/sum([order])' />
      </column>
      <column caption='AOV' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1428485512708919302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv])/sum([order])' />
      </column>
      <column caption='Per Outlet Order' datatype='real' name='[Calculation_1428485512709140487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order])/countd([weekly_active])' />
      </column>
      <column caption='% Inventory' datatype='real' name='[Calculation_1428485512709996552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([weekly_active])/total(COUNTD([weekly_active]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Order' datatype='real' name='[Calculation_1428485512710189065]' role='measure' type='quantitative'>
