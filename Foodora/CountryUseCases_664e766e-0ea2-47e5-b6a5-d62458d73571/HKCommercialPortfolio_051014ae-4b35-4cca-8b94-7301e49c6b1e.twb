      <default-sorts>
        <manual-sort column='[none:commission_bin:nk]' direction='ASC'>
          <dictionary>
            <bucket>&quot;High Commission&quot;</bucket>
            <bucket>&quot;Medium Commission&quot;</bucket>
            <bucket>&quot;Low Commission&quot;</bucket>
            <bucket>%null%</bucket>
          </dictionary>
        </manual-sort>
        <manual-sort column='[none:fail_rate_bin:nk]' direction='ASC'>
          <dictionary>
            <bucket>&quot;Low Fail Rate&quot;</bucket>
            <bucket>&quot;Medium Fail Rate&quot;</bucket>
            <bucket>&quot;High Fail Rate&quot;</bucket>
            <bucket>%null%</bucket>
          </dictionary>
        </manual-sort>
        <manual-sort column='[none:markup_bin:nk]' direction='ASC'>
          <dictionary>
            <bucket>&quot;No Markup&quot;</bucket>
            <bucket>&quot;Has Markup&quot;</bucket>
          </dictionary>
        </manual-sort>
      </default-sorts>
