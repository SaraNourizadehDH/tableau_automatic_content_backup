            <column caption='# PT Growth' datatype='real' name='[# Order Growth (copy)_2894688718924132364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([prep_time_min])/SUM([pt_valid])) - (sum([prep_time_min_lookup])/sum([pt_valid_lookup]))) * -1' />
            </column>
            <column caption='% Decline Growth' datatype='real' name='[% CR3 Growth (copy)_2894688718926549016]' role='measure' type='quantitative'>
