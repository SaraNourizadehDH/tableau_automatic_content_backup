            <column datatype='real' name='[commission]' role='measure' type='quantitative' />
            <column caption='Contract Owner' datatype='string' name='[contract_owner]' role='dimension' type='nominal' />
            <column caption='Delivery Hub' datatype='string' name='[delivery_hub]' role='dimension' type='nominal' />
            <column datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='GFV' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[gfv]' role='measure' type='quantitative' />
            <column caption='GMV Class' datatype='string' name='[gmv_class]' role='dimension' type='nominal' />
            <column caption='HQ Name' datatype='string' name='[hq_name]' role='dimension' type='nominal' />
