    <worksheet name='Portfolio GFV AOV Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Metrics' name='federated.0nxhv291dwaw0p10s112g170l83h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Order Source' datatype='string' name='[Growth Metrics (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nxhv291dwaw0p10s112g170l83h'>
            <column caption='AOV' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1801158438967074841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv])/sum([order])' />
            </column>
            <column caption='current_month' datatype='boolean' name='[Calculation_1801158439269965861]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month]=DATETRUNC(&apos;month&apos;,today())' />
            </column>
            <column caption='$ GFV Runrate' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_2005790715406618631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1801158439269965861] = TRUE&#13;&#10;THEN &#13;&#10;CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_gfv] / [days]&#13;&#10; * (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [total_valid_gfv]&#13;&#10;WHEN &apos;B2C Only&apos; THEN [gfv] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)-  [gfv]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_gfv] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10; * (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [b2b_gfv]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_gfv] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [pickup_gfv]&#13;&#10;END&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='GFV (Para.)' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_2368330509085474822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_gfv]&#13;&#10;WHEN &apos;B2C Only&apos; THEN [gfv]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_gfv]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_gfv]&#13;&#10;END' />
            </column>
            <column caption='% GFV Growth' datatype='real' name='[Calculation_927741548899041280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gfv]) - sum([gfv_lookup])) / sum([gfv])' />
            </column>
            <column caption='% Decline Growth' datatype='real' name='[Calculation_927741548900438024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM([decline_b])/sum([decline_a])) - (sum([decline_b_lookup])/sum([decline_a_lookup]))) / (sum([decline_b_lookup])/sum([decline_a_lookup]))) * -1' />
            </column>
            <column caption='Account Owner' datatype='string' name='[account_owner]' role='dimension' type='nominal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[b2b_gfv]' role='measure' type='quantitative' />
            <column caption='Chain Code' datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
