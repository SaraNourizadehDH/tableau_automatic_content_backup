        <calculation class='tableau' formula='CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_gfv]&#13;&#10;WHEN &apos;B2C Only&apos; THEN [gfv]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_gfv]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_gfv]&#13;&#10;END' />
      </column>
      <column caption='AOV (Para.)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_2368330509086838791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN SUM([total_valid_gfv]) / SUM([total_valid_order])&#13;&#10;WHEN &apos;B2C Only&apos; THEN SUM([gfv]) / SUM([order])&#13;&#10;WHEN &apos;B2B Only&apos; THEN SUM([b2b_gfv]) / SUM([b2b_order])&#13;&#10;WHEN &apos;Pickup Only&apos; THEN SUM([pickup_gfv]) / SUM([pickup_order])&#13;&#10;END' />
      </column>
