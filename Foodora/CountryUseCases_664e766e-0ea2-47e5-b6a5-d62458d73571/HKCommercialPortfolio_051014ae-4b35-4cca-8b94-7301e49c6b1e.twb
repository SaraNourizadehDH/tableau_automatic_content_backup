      <aliases enabled='yes' />
      <column caption='# CX Growth' datatype='integer' name='[# B2B GFV Growth (copy)_2894688718923403269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cx])-SUM([cx_lookup])' />
      </column>
      <column caption='# B2B GFV Growth' datatype='real' name='[# B2B Order Growth (copy)_2894688718923288580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([b2b_gfv]) - sum([b2b_gfv_lookup])' />
      </column>
      <column caption='# NC FP Growth' datatype='integer' name='[# B2B Order Growth (copy)_2894688718923403270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nc_fp]) - sum([nc_fp_lookup])' />
      </column>
      <column caption='# Sessions Growth' datatype='integer' name='[# CX Growth (copy)_2894688718923669512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions])-SUM([sessions_lookup])' />
      </column>
      <column caption='# CR3 Growth' datatype='real' name='[# CX Growth (copy)_2894688718923784201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([cr3_b])/SUM([cr3_a])) - (sum([cr3_b_lookup])/sum([cr3_a_lookup]))' />
      </column>
      <column caption='# Late Growth' datatype='real' name='[# Decline Growth (copy)_2894688718924038155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([late_b])/SUM([late_a])) - (sum([late_b_lookup])/sum([late_a_lookup]))) * -1' />
      </column>
      <column caption='% Late Growth' datatype='real' name='[# Late Growth (copy)_2894688718926663705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([late_b])/sum([late_a])) - (sum([late_b_lookup])/sum([late_a_lookup]))) / (sum([late_b_lookup])/sum([late_a_lookup]))) * -1' />
      </column>
      <column caption='# NC Vendor Growth' datatype='integer' name='[# NC FP Growth (copy)_2894688718923583495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nc_vendor]) - sum([nc_vendor_lookup])' />
      </column>
      <column caption='# Decline Growth' datatype='real' name='[# NC FP Growth (copy)_2894688718923939850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([decline_b])/SUM([decline_a])) - (sum([decline_b_lookup])/sum([decline_a_lookup]))) * -1' />
      </column>
      <column caption='# GFV Growth' datatype='real' name='[# Order Growth (copy)_2894688718923038722]' role='measure' type='quantitative'>
