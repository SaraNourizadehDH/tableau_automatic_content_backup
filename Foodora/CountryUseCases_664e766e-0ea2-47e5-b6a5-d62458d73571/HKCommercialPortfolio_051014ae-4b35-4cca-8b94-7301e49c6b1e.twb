    <worksheet name='Month Time Series Performance (Line)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>MoM # Performance - &lt;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>[Parameters].[account_owner Parameter]</run>
            <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Monthly Metrics' name='federated.0nxhv291dwaw0p10s112g170l83h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metrics' datatype='string' datatype-customized='true' name='[account_owner Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Outlets&quot;'>
              <calculation class='tableau' formula='&quot;# Outlets&quot;' />
            </column>
            <column caption='Level' datatype='string' name='[gfv Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain&quot;'>
              <calculation class='tableau' formula='&quot;Chain&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nxhv291dwaw0p10s112g170l83h'>
            <column caption='Prep Time' datatype='real' default-format='*0.00 mins' name='[Calculation_1297881181560922114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([prep_time_min])/sum([pt_valid])' />
            </column>
            <column caption='Decline' datatype='real' default-format='p0.00%' name='[Calculation_1297881181594566659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([decline_b])/sum([decline_a])' />
            </column>
            <column caption='Late' datatype='real' default-format='p0.00%' name='[Calculation_1297881181594689540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([late_b])/sum([late_a])' />
            </column>
            <column caption='Agg. Concat.' datatype='string' name='[Calculation_1297881181669613574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[agg_name] +  &apos; - &apos; +  [agg_code]' />
            </column>
            <column caption='Vendor Concat.' datatype='string' name='[Calculation_1297881181669834759]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &apos; - &apos; + [vendor_code]' />
            </column>
            <column caption='RPO' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1773010884175437825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([commission])/sum([total_valid_order])' />
            </column>
            <column caption='Per Outlet Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1801158438919245832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order])/countd([monthly_active])' />
            </column>
            <column caption='Para. Name' datatype='string' name='[Calculation_1801158438921039882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[gfv Parameter]&#13;&#10;When &quot;Chain&quot; then [Calculation_1297881181669613574] &#13;&#10;when &quot;Outlet&quot; then [Calculation_1297881181669834759]&#13;&#10;when &quot;Cuisine&quot; then [primary_cuisine]&#13;&#10;when &quot;Account Owner&quot; then [account_owner]&#13;&#10;when &quot;Delivery Hub&quot; then [delivery_hub]&#13;&#10;when &quot;Brand&quot; then [brand_name]&#13;&#10;when &quot;HQ&quot; then [hq_name]&#13;&#10;when &quot;Company Signed By&quot; then [contract_owner]&#13;&#10;when &quot;BD Zone&quot; then [zone_name]&#13;&#10;when &quot;Vertical&quot; then [vertical]&#13;&#10;when &quot;Vendor Grade&quot; then [vendor_grade]&#13;&#10;when &quot;GMV Class&quot; THEN [gmv_class]&#13;&#10;end' />
            </column>
            <column caption='% CR3' datatype='real' default-format='p0.00%' name='[Calculation_1801158438951682067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cr3_b])/sum([cr3_a])' />
            </column>
            <column caption='AOV' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1801158438967074841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv])/sum([order])' />
            </column>
            <column caption='28D Reorder' datatype='real' default-format='p0.00%' name='[Calculation_1801158439226470432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reorder_b])/sum([reorder_a])' />
            </column>
            <column caption='para_metric' datatype='real' name='[Calculation_1801158439260815394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[account_owner Parameter]&#13;&#10;when &quot;Order&quot; then sum([order])&#13;&#10;when &quot;GFV&quot; then sum([gfv])&#13;&#10;when &quot;AOV&quot; then [Calculation_1801158438967074841]&#13;&#10;when &quot;Sessions&quot; then sum([sessions])&#13;&#10;when &quot;CR2&quot; then [Calculation_1887008280159281152]&#13;&#10;when &quot;CR3&quot; then [Calculation_1801158438951682067]&#13;&#10;when &quot;Reorder&quot; then [Calculation_1801158439226470432]&#13;&#10;when &quot;Prep Time&quot; then [Calculation_1297881181560922114]&#13;&#10;when &quot;Decline Rate&quot; then [Calculation_1297881181594566659]&#13;&#10;when &quot;Late (5 Mins)&quot; then [Calculation_1297881181594689540]&#13;&#10;when &quot;New Customer (Foodpanda)&quot; then sum([nc_fp])&#13;&#10;when &quot;New Customer (Vendor)&quot; then sum([nc_vendor])&#13;&#10;when &quot;Per Outlet Order&quot; then [Calculation_1801158438919245832]&#13;&#10;when &apos;B2B GFV&apos; then sum([b2b_gfv])&#13;&#10;when &apos;RPO&apos; then [Calculation_1773010884175437825]&#13;&#10;when &apos;Commission&apos; then SUM([commission])&#13;&#10;when &apos;Weighted Commission Rate&apos; THEN [Calculation_2005790715377778692]&#13;&#10;when &apos;# Outlets&apos; then COUNTD([vendor_code])&#13;&#10;END' />
            </column>
            <column caption='current_month' datatype='boolean' name='[Calculation_1801158439269965861]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month]=DATETRUNC(&apos;month&apos;,today())' />
            </column>
            <column caption='% CR2' datatype='real' default-format='p0.00%' name='[Calculation_1887008280159281152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cr3_a]) / SUM([cr2_a])' />
            </column>
            <column caption='% Weighted Commission' datatype='real' default-format='p0.00%' name='[Calculation_2005790715377778692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission]) / (SUM([total_valid_gfv]))' />
            </column>
            <column caption='ADF' datatype='real' name='[Calculation_2881177927601438720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([b2c_delivery_delivery_fee]) / SUM([b2c_delivery_order])' />
            </column>
            <column caption='Profit (RPO + ADF)' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_2881177927601537025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1773010884175437825] + [Calculation_2881177927601438720]' />
            </column>
            <column caption='Is Live' datatype='boolean' name='[Calculation_2881177927620530178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_status] = NULL &#13;&#10;THEN FALSE&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
