            </column>
            <column caption='Para. Name' datatype='string' name='[Calculation_1801158438921039882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[gfv Parameter]&#13;&#10;When &quot;Chain&quot; then [Calculation_1297881181669613574] &#13;&#10;when &quot;Outlet&quot; then [Calculation_1297881181669834759]&#13;&#10;when &quot;Cuisine&quot; then [primary_cuisine]&#13;&#10;when &quot;Account Owner&quot; then [account_owner]&#13;&#10;when &quot;Delivery Hub&quot; then [delivery_hub]&#13;&#10;when &quot;Brand&quot; then [brand_name]&#13;&#10;when &quot;HQ&quot; then [hq_name]&#13;&#10;when &quot;Company Signed By&quot; then [contract_owner]&#13;&#10;when &quot;BD Zone&quot; then [zone_name]&#13;&#10;when &quot;Vertical&quot; then [vertical]&#13;&#10;when &quot;Vendor Grade&quot; then [vendor_grade]&#13;&#10;when &quot;GMV Class&quot; THEN [gmv_class]&#13;&#10;end' />
            </column>
            <column caption='% CR3' datatype='real' default-format='p0.00%' name='[Calculation_1801158438951682067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cr3_b])/sum([cr3_a])' />
            </column>
            <column caption='% CR3 (Fixed)' datatype='real' default-format='p0.00%' name='[Calculation_2368330509156945930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [month], [vertical], [gmv_class]:sum([cr3_b])/sum([cr3_a])}' />
