          <datasource-dependencies datasource='Parameters'>
            <column caption='Growth Metrics' datatype='string' name='[Level (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;NC FP&quot;'>
              <calculation class='tableau' formula='&quot;NC FP&quot;' />
            </column>
            <column caption='Level' datatype='string' name='[gfv Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain&quot;'>
              <calculation class='tableau' formula='&quot;Chain&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nxhv291dwaw0p10s112g170l83h'>
            <column caption='Agg. Concat.' datatype='string' name='[Calculation_1297881181669613574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[agg_name] +  &apos; - &apos; +  [agg_code]' />
            </column>
            <column caption='Vendor Concat.' datatype='string' name='[Calculation_1297881181669834759]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &apos; - &apos; + [vendor_code]' />
            </column>
            <column caption='% Order Growth' datatype='real' default-format='p0.00%' name='[Calculation_1790462352262553601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order]) - sum([order_lookup])) / sum([order_lookup])' />
            </column>
            <column caption='# Order Growth' datatype='integer' name='[Calculation_1790462352263991298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order]) - sum([order_lookup])' />
            </column>
            <column caption='Para. Name' datatype='string' name='[Calculation_1801158438921039882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[gfv Parameter]&#13;&#10;When &quot;Chain&quot; then [Calculation_1297881181669613574] &#13;&#10;when &quot;Outlet&quot; then [Calculation_1297881181669834759]&#13;&#10;when &quot;Cuisine&quot; then [primary_cuisine]&#13;&#10;when &quot;Account Owner&quot; then [account_owner]&#13;&#10;when &quot;Delivery Hub&quot; then [delivery_hub]&#13;&#10;when &quot;Brand&quot; then [brand_name]&#13;&#10;when &quot;HQ&quot; then [hq_name]&#13;&#10;when &quot;Company Signed By&quot; then [contract_owner]&#13;&#10;when &quot;BD Zone&quot; then [zone_name]&#13;&#10;when &quot;Vertical&quot; then [vertical]&#13;&#10;when &quot;Vendor Grade&quot; then [vendor_grade]&#13;&#10;when &quot;GMV Class&quot; THEN [gmv_class]&#13;&#10;end' />
            </column>
            <column caption='% GFV Growth' datatype='real' name='[Calculation_927741548899041280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gfv]) - sum([gfv_lookup])) / sum([gfv])' />
            </column>
            <column caption='% B2B Order Growth' datatype='real' name='[Calculation_927741548899160065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([b2b_order]) - sum([b2b_order_lookup])) / sum([b2b_order_lookup])' />
            </column>
            <column caption='% B2B GFV Growth' datatype='real' name='[Calculation_927741548899352578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([b2b_gfv]) - sum([b2b_gfv_lookup])) / sum([b2b_gfv_lookup])' />
            </column>
            <column caption='% CX Growth' datatype='real' name='[Calculation_927741548899487747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cx]) - sum([cx_lookup])) / sum([cx_lookup])' />
            </column>
            <column caption='% NC FP Growth' datatype='real' name='[Calculation_927741548899622916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nc_fp]) - sum([nc_fp_lookup])) / sum([nc_fp_lookup])' />
            </column>
            <column caption='% NC Vendor Growth' datatype='real' name='[Calculation_927741548899733509]' role='measure' type='quantitative'>
