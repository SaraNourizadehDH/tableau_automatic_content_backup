            <column caption='Level' datatype='string' name='[gfv Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chain&quot;'>
              <calculation class='tableau' formula='&quot;Chain&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nxhv291dwaw0p10s112g170l83h'>
