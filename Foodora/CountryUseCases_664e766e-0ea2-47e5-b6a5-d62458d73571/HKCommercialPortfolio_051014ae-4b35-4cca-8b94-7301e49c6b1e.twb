      </column>
      <column caption='% Discount Order' datatype='real' name='[Calculation_105271679479709696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([b2c_delivery_discount_order]) / SUM([b2c_delivery_order])' />
      </column>
      <column caption='# Live Vendor' datatype='integer' name='[Calculation_1247215626443624448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_status])' />
      </column>
      <column caption='% Exclusive' datatype='real' default-format='p0.00%' name='[Calculation_1247215626443702273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_exclusivity] = TRUE AND ISNULL([vendor_status]) = FALSE THEN 1 ELSE 0 END)&#13;&#10;/ &#13;&#10;[Calculation_1247215626443624448]' />
      </column>
      <column caption='Prep Time' datatype='real' default-format='*0.00 mins' name='[Calculation_1297881181560922114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([prep_time_min])/sum([pt_valid])' />
      </column>
      <column caption='Decline' datatype='real' default-format='p0.00%' name='[Calculation_1297881181594566659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([decline_b])/sum([decline_a])' />
      </column>
      <column caption='Late' datatype='real' default-format='p0.00%' name='[Calculation_1297881181594689540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([late_b])/sum([late_a])' />
      </column>
      <column caption='Agg. Concat.' datatype='string' name='[Calculation_1297881181669613574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[agg_name] +  &apos; - &apos; +  [agg_code]' />
      </column>
      <column caption='Vendor Concat.' datatype='string' name='[Calculation_1297881181669834759]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_name] + &apos; - &apos; + [vendor_code]' />
      </column>
      <column aggregation='CountD' caption='Brand CT' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1516024258362339330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([vendor_status])&#13;&#10;THEN Null&#13;&#10;ELSE [brand_name]&#13;&#10;END' />
      </column>
      <column aggregation='CountD' caption='HQ CT' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1516024259413835780]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([vendor_status])&#13;&#10;THEN Null&#13;&#10;ELSE [hq_name]&#13;&#10;END' />
      </column>
      <column caption='RPO' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1773010884175437825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([commission])/sum([total_valid_order])' />
      </column>
      <column caption='% Order Growth' datatype='real' default-format='p0.00%' name='[Calculation_1790462352262553601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([order]) - sum([order_lookup])) / sum([order_lookup])' />
      </column>
      <column caption='# Order Growth' datatype='integer' name='[Calculation_1790462352263991298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order]) - sum([order_lookup])' />
      </column>
      <column caption='Per Outlet Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1801158438919245832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order])/countd([monthly_active])' />
      </column>
      <column caption='Para. Name' datatype='string' name='[Calculation_1801158438921039882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[gfv Parameter]&#13;&#10;When &quot;Chain&quot; then [Calculation_1297881181669613574] &#13;&#10;when &quot;Outlet&quot; then [Calculation_1297881181669834759]&#13;&#10;when &quot;Cuisine&quot; then [primary_cuisine]&#13;&#10;when &quot;Account Owner&quot; then [account_owner]&#13;&#10;when &quot;Delivery Hub&quot; then [delivery_hub]&#13;&#10;when &quot;Brand&quot; then [brand_name]&#13;&#10;when &quot;HQ&quot; then [hq_name]&#13;&#10;when &quot;Company Signed By&quot; then [contract_owner]&#13;&#10;when &quot;BD Zone&quot; then [zone_name]&#13;&#10;when &quot;Vertical&quot; then [vertical]&#13;&#10;when &quot;Vendor Grade&quot; then [vendor_grade]&#13;&#10;when &quot;GMV Class&quot; THEN [gmv_class]&#13;&#10;end' />
      </column>
      <column caption='% CR3' datatype='real' default-format='p0.00%' name='[Calculation_1801158438951682067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cr3_b])/sum([cr3_a])' />
      </column>
      <column caption='AOV' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1801158438967074841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv])/sum([order])' />
      </column>
      <column caption='28D Reorder' datatype='real' default-format='p0.00%' name='[Calculation_1801158439226470432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reorder_b])/sum([reorder_a])' />
      </column>
      <column caption='para_metric' datatype='real' name='[Calculation_1801158439260815394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[account_owner Parameter]&#13;&#10;when &quot;Order&quot; then sum([order])&#13;&#10;when &quot;GFV&quot; then sum([gfv])&#13;&#10;when &quot;AOV&quot; then [Calculation_1801158438967074841]&#13;&#10;when &quot;Sessions&quot; then sum([sessions])&#13;&#10;when &quot;CR2&quot; then [Calculation_1887008280159281152]&#13;&#10;when &quot;CR3&quot; then [Calculation_1801158438951682067]&#13;&#10;when &quot;Reorder&quot; then [Calculation_1801158439226470432]&#13;&#10;when &quot;Prep Time&quot; then [Calculation_1297881181560922114]&#13;&#10;when &quot;Decline Rate&quot; then [Calculation_1297881181594566659]&#13;&#10;when &quot;Late (5 Mins)&quot; then [Calculation_1297881181594689540]&#13;&#10;when &quot;New Customer (Foodpanda)&quot; then sum([nc_fp])&#13;&#10;when &quot;New Customer (Vendor)&quot; then sum([nc_vendor])&#13;&#10;when &quot;Per Outlet Order&quot; then [Calculation_1801158438919245832]&#13;&#10;when &apos;B2B GFV&apos; then sum([b2b_gfv])&#13;&#10;when &apos;RPO&apos; then [Calculation_1773010884175437825]&#13;&#10;when &apos;Commission&apos; then SUM([commission])&#13;&#10;when &apos;Weighted Commission Rate&apos; THEN [Calculation_2005790715377778692]&#13;&#10;when &apos;# Outlets&apos; then COUNTD([vendor_code])&#13;&#10;END' />
      </column>
      <column caption='current_month' datatype='boolean' name='[Calculation_1801158439269965861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[month]=DATETRUNC(&apos;month&apos;,today())' />
      </column>
      <column caption='% CR2' datatype='real' default-format='p0.00%' name='[Calculation_1887008280159281152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cr3_a]) / SUM([cr2_a])' />
      </column>
      <column caption='% CR4' datatype='real' default-format='p0.00%' name='[Calculation_1887008280159383553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cr4_b]) / SUM([cr3_b])' />
      </column>
      <column caption='% Weighted Commission' datatype='real' default-format='p0.00%' name='[Calculation_2005790715377778692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission]) / (SUM([total_valid_gfv]))' />
      </column>
      <column caption='# Order Runrate' datatype='real' name='[Calculation_2005790715380355078]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1801158439269965861] = TRUE&#13;&#10;THEN &#13;&#10;CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_order] / [days]&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [total_valid_order] &#13;&#10;WHEN &apos;B2C Only&apos; THEN [order]/ DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10; * (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [order]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_order] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [b2b_order]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_order]/ DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [pickup_order]&#13;&#10;END&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='$ GFV Runrate' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_2005790715406618631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1801158439269965861] = TRUE&#13;&#10;THEN &#13;&#10;CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_gfv] / [days]&#13;&#10; * (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [total_valid_gfv]&#13;&#10;WHEN &apos;B2C Only&apos; THEN [gfv] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)-  [gfv]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_gfv] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10; * (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [b2b_gfv]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_gfv] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [pickup_gfv]&#13;&#10;END&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Impression' datatype='integer' name='[Calculation_2129217502361329664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cr2_a]' />
      </column>
      <column caption='% 40 Min Delivery Time' datatype='real' default-format='p0.00%' name='[Calculation_215328380200271872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt_40_ct]) / SUM([dt_valid])' />
      </column>
      <column caption='# Order Delay' datatype='real' default-format='n#,##0.00&quot; mins&quot;;-#,##0.00&quot; mins&quot;' name='[Calculation_215328380200484865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_delay_min]) / SUM([order_delay_valid])' />
      </column>
      <column caption='% 10 Mins Order Delay' datatype='real' default-format='p0.00%' name='[Calculation_215328380200562690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_delay_10_ct]) / SUM([order_delay_valid])' />
      </column>
      <column caption='% 30 Mins Order Delay' datatype='real' default-format='p0.00%' name='[Calculation_215328380200665091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_delay_30_ct]) / SUM([order_delay_valid])' />
      </column>
      <column caption='# Order Density' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_215328380200726532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([order]) / AVG([delivery_area])) * 1000' />
      </column>
      <column caption='# Delivery Time' datatype='real' default-format='n#,##0.00&quot; mins&quot;;-#,##0.00&quot; mins&quot;' name='[Calculation_215328380201095173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_min]) / SUM([dt_valid])' />
      </column>
      <column caption='Commission' datatype='real' default-format='C1033%' name='[Calculation_2164542576746098688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([gfv] - [vendor_discount_value]) * [commission_percentage]' />
