        <calculation class='tableau' formula='CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_order]&#13;&#10;WHEN &apos;B2C Only&apos; THEN [order]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_order]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_order]&#13;&#10;END' />
