          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Order Source' datatype='string' name='[Growth Metrics (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nxhv291dwaw0p10s112g170l83h'>
            <column caption='current_month' datatype='boolean' name='[Calculation_1801158439269965861]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month]=DATETRUNC(&apos;month&apos;,today())' />
            </column>
            <column caption='# Order Runrate' datatype='real' name='[Calculation_2005790715380355078]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1801158439269965861] = TRUE&#13;&#10;THEN &#13;&#10;CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_order] / [days]&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [total_valid_order] &#13;&#10;WHEN &apos;B2C Only&apos; THEN [order]/ DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10; * (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [order]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_order] / DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [b2b_order]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_order]/ DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()),  TODAY())&#13;&#10;* (DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, TODAY()), DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY()))))+1)- [pickup_order]&#13;&#10;END&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='# Order Delay' datatype='real' default-format='n#,##0.00&quot; mins&quot;;-#,##0.00&quot; mins&quot;' name='[Calculation_215328380200484865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_delay_min]) / SUM([order_delay_valid])' />
            </column>
            <column caption='Order (Para.)' datatype='integer' name='[Calculation_2368330509085188101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Growth Metrics (copy)]&#13;&#10;WHEN &apos;All&apos; THEN [total_valid_order]&#13;&#10;WHEN &apos;B2C Only&apos; THEN [order]&#13;&#10;WHEN &apos;B2B Only&apos; THEN [b2b_order]&#13;&#10;WHEN &apos;Pickup Only&apos; THEN [pickup_order]&#13;&#10;END' />
            </column>
