    <worksheet name='Targeted Deals/GMV'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_outputs.commercial_dashboard' name='federated.1g0496b1llvnrp122mxmg1q1ujox' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='AM Aggregation' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;AM Region&quot;'>
              <calculation class='tableau' formula='&quot;AM Region&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1g0496b1llvnrp122mxmg1q1ujox'>
            <column caption='# New Vendors' datatype='integer' name='[Calculation_2433632700976283648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([successful_orders (commercial_dashboard)] &gt; 0 OR [hours_open (commercial_dashboard)] &gt; 0 )&#13;&#10;       AND [successful_orders_pm (commercial_dashboard)] = 0&#13;&#10;       AND [hours_open_pm] = 0 THEN [vendor_code] END)' />
            </column>
            <column caption='# Vendors Online' datatype='integer' name='[Calculation_34339949156904961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [successful_orders (commercial_dashboard)] &gt; 0 OR [hours_open (commercial_dashboard)] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_4137963670642606082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month (commercial_dashboard)]),7)' />
            </column>
            <column caption='AM' datatype='string' name='[Calculation_430093798403215378]' role='dimension' type='nominal'>
