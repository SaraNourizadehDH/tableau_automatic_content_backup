    <worksheet name='Performance vs Target by Region'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='12'>RM Dashboard (Region)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_outputs.commercial_dashboard' name='federated.1g0496b1llvnrp122mxmg1q1ujox' />
          </datasources>
          <datasource-dependencies datasource='federated.1g0496b1llvnrp122mxmg1q1ujox'>
            <column caption='CPC / GMV vs Target Region' datatype='real' default-format='p0%' name='[CPC / GMV vs Target (copy)_1186698542492086277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NCR / GMV (copy)_229402139347800065] / [Target CPC / GMV (copy)_1186698542491922436] - 1' />
            </column>
            <column datatype='real' name='[CPC/GMV (AM!targets!bi!output1)]' role='measure' type='quantitative' />
            <column caption='# Vendors Online' datatype='integer' name='[Calculation_34339949156904961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [successful_orders (commercial_dashboard)] &gt; 0 OR [hours_open (commercial_dashboard)] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='Report Month Filter' datatype='string' name='[Calculation_4137963670630465536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([Calculation_4137963670642606082]) = LEFT(STR(DATE(DATEADD(&apos;month&apos;,-0,DATETRUNC(&apos;month&apos;,TODAY())))),7) &#13;&#10;    THEN &apos;Current Month&apos;&#13;&#10;ELSE STR([Calculation_4137963670642606082]) END' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_4137963670642606082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month (commercial_dashboard)]),7)' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_4347944000015032327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_local (commercial_dashboard)]' />
            </column>
            <column caption='VFD / GMV' datatype='real' name='[Calculation_865817083148361732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vf_deal_total_local])&#13;&#10;/&#13;&#10;SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='DA / GMV vs Target Region' datatype='real' default-format='p0%' name='[DA / GMV vs Target (copy)_1186698542492377095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NCR / GMV (copy) (copy)_229402139347808258] / [Target DA / GMV (copy)_1186698542492282886] - 1' />
            </column>
            <column datatype='real' name='[Display Ads/GMV (AM!targets!bi!output1)]' role='measure' type='quantitative' />
            <column caption='Joker / GMV vs Target Region' datatype='real' default-format='p0%' name='[Joker / GMV vs Target (copy)_1186698542492880907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NCR / GMV (copy) (copy) (copy) (copy)_229402139347824644] / [Target Joker / GMV (copy)_1186698542492762122] - 1' />
            </column>
            <column datatype='real' name='[Joker/GMV (AM!targets!bi!output1)]' role='measure' type='quantitative' />
            <column datatype='real' name='[NCR (AM!targets!bi!output1)]' role='measure' type='quantitative' />
            <column caption='NCR Joker / GMV' datatype='real' default-format='p0.00%' name='[NCR / GMV (copy) (copy) (copy) (copy)_229402139347824644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_fee_revenue_local])/SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='NCR DA / GMV' datatype='real' default-format='p0.00%' name='[NCR / GMV (copy) (copy)_229402139347808258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([display_ads_revenue_local])/SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='NCR CPC / GMV' datatype='real' default-format='p0.00%' name='[NCR / GMV (copy)_229402139347800065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_local])/SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='NCR / GMV (no eshop)' datatype='real' default-format='p0.00%' name='[NCR / GMV (copy)_656962631038287872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ncr_revenue_local])-SUM([eshop_revenue_local]))&#13;&#10;/SUM([Calculation_4347944000015032327])&#13;&#10;//hot fix' />
            </column>
            <column caption='NCR / GMV vs Target Region' datatype='real' default-format='p0%' name='[NCR / GMV vs Target (no eshop) (copy)_1186698542491693059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NCR / GMV (copy)_656962631038287872] / [Target NCR / GMV (copy)_1186698542491578370] - 1' />
            </column>
            <column caption='NCR Targeted Deals / GMV' datatype='real' default-format='p0.00%' name='[NCR Joker / GMV (copy)_1331939601105014787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([targeted_deals_revenue_local])/SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='Target CPC / GMV Region' datatype='real' default-format='p0.00%' name='[Target CPC / GMV (copy)_1186698542491922436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([CPC/GMV (AM!targets!bi!output1)])' />
            </column>
            <column caption='Target DA / GMV Region' datatype='real' default-format='p0.00%' name='[Target DA / GMV (copy)_1186698542492282886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Display Ads/GMV (AM!targets!bi!output1)])' />
            </column>
            <column caption='Target Joker / GMV Region' datatype='real' default-format='p0.00%' name='[Target Joker / GMV (copy)_1186698542492762122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Joker/GMV (AM!targets!bi!output1)])' />
            </column>
            <column caption='Target NCR / GMV Region' datatype='real' default-format='p0.00%' name='[Target NCR / GMV (copy)_1186698542491578370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([NCR (AM!targets!bi!output1)])' />
            </column>
            <column caption='Target VFD / GMV Region' datatype='real' default-format='p0.00%' name='[Target VFD / GMV (copy)_1186698542490775552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([VFD/GMV (AM!targets!bi!output1)])' />
            </column>
            <column caption='VFD / GMV vs Target Region' datatype='real' default-format='p0%' name='[VFD / GMV vs Target (copy)_1186698542491148289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_865817083148361732] / [Target VFD / GMV (copy)_1186698542490775552] - 1' />
            </column>
            <column datatype='real' name='[VFD/GMV (AM!targets!bi!output1)]' role='measure' type='quantitative' />
            <column caption='Account Manager' datatype='string' name='[account_manager (commercial_dashboard)]' role='dimension' type='nominal' />
            <column caption='AM Region' datatype='string' name='[am_region]' role='dimension' type='nominal' />
            <column datatype='real' name='[cpc_revenue_local]' role='measure' type='quantitative' />
            <column datatype='real' name='[display_ads_revenue_local]' role='measure' type='quantitative' />
