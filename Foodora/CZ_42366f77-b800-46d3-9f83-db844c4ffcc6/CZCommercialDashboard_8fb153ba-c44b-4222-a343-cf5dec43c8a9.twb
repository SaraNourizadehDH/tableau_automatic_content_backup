      <table>
        <view>
          <datasources>
            <datasource caption='tableau_outputs.commercial_dashboard' name='federated.1g0496b1llvnrp122mxmg1q1ujox' />
          </datasources>
          <datasource-dependencies datasource='federated.1g0496b1llvnrp122mxmg1q1ujox'>
            <column caption='# Vendors w Deal' datatype='integer' name='[# New Vendors (copy)_1260726484891066373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [deal_orders] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='AFV (LC)' datatype='real' name='[AOV (LC) (copy)_2043226917838807045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local (commercial_dashboard)])/SUM([successful_orders (commercial_dashboard)])' />
            </column>
            <column caption='AFV (LC) vs LM' datatype='real' name='[AOV (LC) vs LM (copy)_2043226917838819334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gfv_local (commercial_dashboard)])/SUM([successful_orders (commercial_dashboard)]))&#13;&#10;/(SUM([gfv_local_pm (commercial_dashboard)])/SUM([successful_orders_pm (commercial_dashboard)]))&#13;&#10;-1' />
            </column>
            <column caption='% Orders w Deal' datatype='real' default-format='p0.00%' name='[Calculation_1260726484886503427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deal_orders]) / [Calculation_4347944000014827525]' />
            </column>
            <column caption='% Vendors w Deal' datatype='real' default-format='p0.00%' name='[Calculation_1260726484891348998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# New Vendors (copy)_1260726484891066373]/[Calculation_34339949156904961]' />
            </column>
            <column caption='VFD Value vs LM' datatype='real' default-format='p0.00%' name='[Calculation_1260726484894052360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vf_deal_total_local])/SUM([vf_deal_total_local_pm])-1' />
            </column>
            <column caption='Vendors w NCR' datatype='integer' name='[Calculation_1260726484894842889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [ncr_revenue_local] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='% Vendors w NCR' datatype='real' default-format='p0.00%' name='[Calculation_1260726484895133706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1260726484894842889]/[Calculation_34339949156904961]' />
            </column>
            <column caption='NCR Value (LC)' datatype='real' name='[Calculation_1260726484895404043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ncr_revenue_local])' />
            </column>
            <column caption='NCR vs LM' datatype='real' default-format='p0.00%' name='[Calculation_1260726484895617036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1260726484895404043]/SUM([ncr_revenue_local_pm])-1' />
            </column>
            <column caption='% Uptime' datatype='real' default-format='p0.00%' name='[Calculation_1260726484896096269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hours_open (commercial_dashboard)])/(SUM([hours_open (commercial_dashboard)])+SUM([closed_hours (commercial_dashboard)]))' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1260726484897259539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor (commercial_dashboard)])/(SUM([successful_orders (commercial_dashboard)])+SUM([failed_orders (commercial_dashboard)]))' />
            </column>
            <column caption='NCR / GMV' datatype='real' name='[Calculation_2066730032827428865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ncr_revenue_local])/SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='# New Vendors' datatype='integer' name='[Calculation_2433632700976283648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([successful_orders (commercial_dashboard)] &gt; 0 OR [hours_open (commercial_dashboard)] &gt; 0 )&#13;&#10;       AND [successful_orders_pm (commercial_dashboard)] = 0&#13;&#10;       AND [hours_open_pm] = 0 THEN [vendor_code] END)' />
            </column>
            <column caption='# Vendors Online' datatype='integer' name='[Calculation_34339949156904961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [successful_orders (commercial_dashboard)] &gt; 0 OR [hours_open (commercial_dashboard)] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='Report Month Filter' datatype='string' name='[Calculation_4137963670630465536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([Calculation_4137963670642606082]) = LEFT(STR(DATE(DATEADD(&apos;month&apos;,-0,DATETRUNC(&apos;month&apos;,TODAY())))),7) &#13;&#10;    THEN &apos;Current Month&apos;&#13;&#10;ELSE STR([Calculation_4137963670642606082]) END' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_4137963670642606082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month (commercial_dashboard)]),7)' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_4347944000014827525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders (commercial_dashboard)])' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_4347944000015032327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_local (commercial_dashboard)]' />
            </column>
            <column caption='GMV vs LM' datatype='real' name='[Calculation_4347944000015114248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local (commercial_dashboard)])/SUM([gmv_local_pm (commercial_dashboard)])-1' />
            </column>
            <column caption='VFD / GMV' datatype='real' name='[Calculation_865817083148361732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vf_deal_total_local])&#13;&#10;/&#13;&#10;SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='# Orders vs LM' datatype='real' name='[GMV vs LM (copy)_2040693630684069891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders (commercial_dashboard)])/SUM([successful_orders_pm (commercial_dashboard)])-1' />
            </column>
            <column caption='Account Manager' datatype='string' name='[account_manager (commercial_dashboard)]' role='dimension' type='nominal' />
            <column caption='AM Region' datatype='string' name='[am_region]' role='dimension' type='nominal' />
            <column caption='Closed Hours' datatype='real' name='[closed_hours (commercial_dashboard)]' role='measure' type='quantitative' />
            <column caption='Deal Orders' datatype='integer' name='[deal_orders]' role='measure' type='quantitative' />
