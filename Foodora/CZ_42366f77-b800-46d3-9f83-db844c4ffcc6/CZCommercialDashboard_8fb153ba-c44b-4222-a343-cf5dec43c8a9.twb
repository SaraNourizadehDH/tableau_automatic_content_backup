            </column>
            <column caption='AM' datatype='string' name='[Calculation_430093798403215378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;All&quot; THEN &quot;All&quot;&#13;&#10;WHEN &quot;AM Region&quot; THEN [am_region]&#13;&#10;WHEN &quot;Account Manager&quot; THEN [account_manager (commercial_dashboard)]&#13;&#10;END' />
