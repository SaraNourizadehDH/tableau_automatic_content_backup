            <column caption='NCR DA / GMV' datatype='real' default-format='p0.00%' name='[NCR / GMV (copy) (copy)_229402139347808258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([display_ads_revenue_local])/SUM([Calculation_4347944000015032327])' />
