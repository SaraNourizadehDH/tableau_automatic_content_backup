          <datasource-dependencies datasource='federated.1g0496b1llvnrp122mxmg1q1ujox'>
            <column caption='Eshop / GMV vs Target' datatype='real' default-format='p0%' hidden='true' name='[CPC / GMV vs Target (copy)_430093798399131664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NCR / GMV (copy) (copy) (copy)_229402139347816451] / [Target CPC / GMV (copy)_430093798397317131] - 1' />
            </column>
            <column caption='Joker / GMV vs Target' datatype='real' default-format='p0%' name='[CPC / GMV vs Target (copy)_430093798399250449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NCR / GMV (copy) (copy) (copy) (copy)_229402139347824644] / [Target CPC / GMV (copy)_430093798397542412] - 1' />
