      <column caption='% Uptime PW' datatype='real' default-format='p0.0%' name='[% Uptime LW (copy)_386183733476642831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Previous Week&apos; then ([total_scheduled_open_seconds]-IFNULL([total_closed_seconds],0)) end) }&#13;&#10;/&#13;&#10;{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Previous Week&apos; then [total_scheduled_open_seconds] end)}' />
      </column>
      <column caption='CVR LW' datatype='real' default-format='p0%' name='[% Uptime LW (copy)_386183733488300051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN({ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then [orders_successful] end) }&#13;&#10;/&#13;&#10;{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then [visits] end)})' />
      </column>
      <column caption='% Vendor Late &gt; 10 min' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_665969799104282624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([completed_orders])' />
      </column>
