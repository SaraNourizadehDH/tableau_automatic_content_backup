      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='employees' id='_AEBA9E02ED1C45188DB617C504125CF8'>
            <properties context=''>
              <relation connection='bigquery.1hrdxxj0w23iq413ec6830qd6joa' name='Employees' type='text'>SELECT `employees`.`am_region` AS `am_region`,&#13;
  `employees`.`email` AS `email`,&#13;
  first_name || &apos; &apos; || last_name as account_manager,&#13;
  `employees`.`id` AS `id`,&#13;
  `employees`.`is_active` AS `is_active_employee`,&#13;
  `employees`.`job_role` AS `job_role`,&#13;
  `employees`.`manager_name` AS `manager_name`,&#13;
  case when job_role in (&apos;Account Manager (AM)&apos;, &#13;
        &apos;Strategic Account Manager&apos;, &#13;
        &apos;Field Sales Representative&apos;,&#13;
        &apos;Key Account Manager (KAM)&apos;) &#13;
  then true else false end as am_permissions&#13;
FROM `damejidlo-cz-bigquery.master`.`employees` `employees`&#13;
WHERE is_active&#13;
AND job_role in (&apos;Account Manager (AM)&apos;, &#13;
&apos;Strategic Account Manager&apos;, &#13;
&apos;Field Sales Representative&apos;,&#13;
&apos;Key Account Manager (KAM)&apos;)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_AEBA9E02ED1C45188DB617C504125CF8' table='[Extract].[_AEBA9E02ED1C45188DB617C504125CF8]' type='table' />
            </properties>
