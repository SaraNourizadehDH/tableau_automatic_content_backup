    <worksheet name='Vendor Late'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='am_daily+ (master)' name='federated.00i21ue15avwkz17rnlkm1smtxde' />
          </datasources>
          <datasource-dependencies datasource='Parameters' />
          <datasource-dependencies datasource='federated.00i21ue15avwkz17rnlkm1smtxde'>
            <column caption='% Vendor Late &gt; 10 min' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_665969799104282624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([completed_orders])' />
            </column>
            <column caption='Filter 2 weeks' datatype='string' name='[Calculation_1381479250779688960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datetrunc(&apos;week&apos;, [date], &apos;monday&apos;) = datetrunc(&apos;week&apos;, dateadd(&apos;day&apos;, -1, datetrunc(&apos;week&apos;, today(), &apos;monday&apos;)), &apos;monday&apos;)&#13;&#10;then &apos;Last Week&apos;&#13;&#10;elseif datetrunc(&apos;week&apos;, [date], &apos;monday&apos;) = datetrunc(&apos;week&apos;, dateadd(&apos;day&apos;, -8, datetrunc(&apos;week&apos;, today(), &apos;monday&apos;)), &apos;monday&apos;)&#13;&#10;then &apos;Previous Week&apos;&#13;&#10;end' />
            </column>
            <column caption='Rank VL Filter' datatype='boolean' name='[Calculation_1419478309965590542]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Rank VFR (copy)_1419478309965406221] &lt;= 10'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Rank VL' datatype='integer' name='[Rank VFR (copy)_1419478309965406221]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='RANK_UNIQUE(&#13;&#10;1000000*100*[% Vendor Fail Rate (copy)_665969799104282624]&#13;&#10;+ SUM([vendor_late_over_10_count])&#13;&#10;,&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Company Number' datatype='string' name='[company_number]' role='dimension' type='nominal' />
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' default-format='*dd mmm' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1381479250779688960]' derivation='None' name='[none:Calculation_1381479250779688960:nk]' pivot='key' type='nominal' />
            <column-instance column='[company_number]' derivation='None' name='[none:company_number:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_city]' derivation='None' name='[none:vendor_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_code]' derivation='None' name='[none:vendor_code:nk]' pivot='key' type='nominal' />
