            <column caption='% Uptime PW' datatype='real' default-format='p0.0%' name='[% Uptime LW (copy)_386183733476642831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Previous Week&apos; then ([total_scheduled_open_seconds]-IFNULL([total_closed_seconds],0)) end) }&#13;&#10;/&#13;&#10;{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Previous Week&apos; then [total_scheduled_open_seconds] end)}' />
            </column>
            <column caption='CVR LW' datatype='real' default-format='p0%' name='[% Uptime LW (copy)_386183733488300051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN({ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then [orders_successful] end) }&#13;&#10;/&#13;&#10;{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then [visits] end)})' />
            </column>
            <column caption='% Vendor Late &gt; 10 min' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_665969799104282624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([completed_orders])' />
            </column>
            <column caption='CVR PW' datatype='real' default-format='p0%' name='[CVR LW (copy)_386183733488783380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Previous Week&apos; then [orders_successful] end) }&#13;&#10;/&#13;&#10;{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Previous Week&apos; then [visits] end)}' />
            </column>
            <column caption='Orders LW ' datatype='integer' default-format='n#,##0;-#,##0' name='[CVR LW (copy)_386183733490262039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN({ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then [orders_successful] end) })' />
            </column>
            <column caption='Filter 2 weeks' datatype='string' name='[Calculation_1381479250779688960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if datetrunc(&apos;week&apos;, [date], &apos;monday&apos;) = datetrunc(&apos;week&apos;, dateadd(&apos;day&apos;, -1, datetrunc(&apos;week&apos;, today(), &apos;monday&apos;)), &apos;monday&apos;)&#13;&#10;then &apos;Last Week&apos;&#13;&#10;elseif datetrunc(&apos;week&apos;, [date], &apos;monday&apos;) = datetrunc(&apos;week&apos;, dateadd(&apos;day&apos;, -8, datetrunc(&apos;week&apos;, today(), &apos;monday&apos;)), &apos;monday&apos;)&#13;&#10;then &apos;Previous Week&apos;&#13;&#10;end' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_1541919983042002951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_vendor])/SUM(IFNULL([orders_successful],0)+IFNULL([failed_orders_total],0))' />
            </column>
            <column caption='GMV LW' datatype='real' name='[Calculation_386183733463195654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then ZN([gmv_local]) end) }' />
            </column>
            <column caption='Rank Activation Filter' datatype='boolean' name='[Calculation_541557861507821570]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Rank VL (copy)_541557861507588097] &lt;= 10'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Uptime % Diff' datatype='real' default-format='p0.0%' name='[GMV % Diff  (copy)_386183733478920209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([GMV LW (copy)_386183733476032525] / [% Uptime LW (copy)_386183733476642831] - 1)' />
            </column>
            <column caption='% Uptime LW' datatype='real' default-format='p0.0%' name='[GMV LW (copy)_386183733476032525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then ([total_scheduled_open_seconds]-IFNULL([total_closed_seconds],0)) end) }&#13;&#10;/&#13;&#10;{ FIXED [account_manager], [vendor_code]: SUM(if [Calculation_1381479250779688960] = &apos;Last Week&apos; then [total_scheduled_open_seconds] end)}' />
            </column>
            <column caption='Rank Activation' datatype='integer' name='[Rank VL (copy)_541557861507588097]' role='measure' type='ordinal'>
