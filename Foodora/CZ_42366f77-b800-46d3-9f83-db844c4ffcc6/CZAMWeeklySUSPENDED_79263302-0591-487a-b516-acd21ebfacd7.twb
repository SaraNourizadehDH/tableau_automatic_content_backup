                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Uptime % Diff' datatype='real' default-format='p0.0%' name='[GMV % Diff  (copy)_386183733478920209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([GMV LW (copy)_386183733476032525] / [% Uptime LW (copy)_386183733476642831] - 1)' />
            </column>
            <column caption='Uptime Abs Diff' datatype='real' default-format='p0.0%' name='[GMV Abs Diff (copy)_386183733478379536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV LW (copy)_386183733476032525] - [% Uptime LW (copy)_386183733476642831]' />
