            <column caption='Turnover (incl storno)' datatype='real' default-format='C1029%' name='[Turnover (excl storno) (copy)_1148417961703374858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unit_price_without_vat] * [quantity])' />
