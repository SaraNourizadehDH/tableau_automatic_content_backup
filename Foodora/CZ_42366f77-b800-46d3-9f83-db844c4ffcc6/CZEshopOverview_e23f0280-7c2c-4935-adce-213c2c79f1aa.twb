        <calculation class='tableau' formula='//hot fix - nejde mi připojit tab z BQ ani blending&#13;&#10;{FIXED [order_id]: MIN(IF [Calculation_156781588582535168] AND &#13;&#10;(CONTAINS(lower([name]), &apos;hufj01&apos; )) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hufj10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hufj05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubl01&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubl10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubl05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;huhk01&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;huhk10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;huhk05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubd01&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubd10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubd05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;humv01&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;humv10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;humv05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hudd01&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hudd10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hudd05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;huot01&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;huot10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;huot05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hukf01&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hukf10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hukf05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubj10&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;hubj05&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;ondrejs1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;michalk1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;vaclavs1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;vaclavm1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;tom1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;erik1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;zdenek1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;matej1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;monika1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;mikulas1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;marie1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;katerina1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;david1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;jolana1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;jakubm1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;mt1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;cd1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;md1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;dd1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;kk1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;martink1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;naty1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;terka1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;naty1d&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;terka1d&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;terka5&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;naty5&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;klara1&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;klara1d&apos;)) OR&#13;&#10;(CONTAINS(lower([name]), &apos;klara5&apos;)) OR&#13;&#10;&#13;&#10;//universal codes! (we can delete those above in the future)&#13;&#10;&#13;&#10;(CONTAINS(lower([name]), &apos;am_&apos;)) OR &#13;&#10;(CONTAINS(lower([name]), &apos;eshop_&apos;))&#13;&#10;THEN lower([name]) END)}' />
      </column>
      <column caption='# Orders Eshop' datatype='integer' name='[Calculation_1148417961693323264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='# Vendors Eshop' datatype='integer' name='[Calculation_1148417961694003201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([restaurant_id (eshop_orders)])' />
      </column>
      <column caption='AVG Orders per Vendor' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1148417961694683138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1148417961693323264] / [Calculation_1148417961694003201]' />
      </column>
      <column caption='Turnover (excl storno)' datatype='real' default-format='C1029%' name='[Calculation_1148417961695154179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [status]&#13;&#10;WHEN in (&quot;Stornována&quot;, &quot;Stornovaná&quot;) then 0&#13;&#10;else [unit_price_without_vat] * [quantity]&#13;&#10;end)' />
      </column>
      <column caption='DF paid by Platform' datatype='real' default-format='C1029%' name='[Calculation_1148417961697198085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_paid_by_dj (eshop_deliveries)])' />
      </column>
      <column caption='Total Costs' datatype='real' default-format='C1029%' name='[Calculation_1148417961698258950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Turnover (excl storno) (copy)_1148417961696641028] + [Calculation_1148417961697198085]' />
      </column>
      <column caption='# Sold Items (Eshop)' datatype='real' name='[Calculation_1148417961702842376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity])' />
      </column>
      <column caption='% Margin (Eshop)' datatype='real' default-format='p0.00%' name='[Calculation_1148417961703546891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Costs (copy)_1148417961703186441] / [Turnover (excl storno) (copy)_1148417961703374858]' />
      </column>
      <column caption='Data Date' datatype='date' name='[Calculation_1476336268037595136]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : DATE(MAX([created_at]))}' />
      </column>
      <column caption='Data Date start of Month' datatype='date' name='[Calculation_1476336268037869569]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED: MAX(DATE(DATETRUNC(&quot;month&quot;,[Calculation_1476336268037595136])))}' />
      </column>
      <column caption='Order Date' datatype='date' name='[Calculation_1476336268038168578]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([created_at])' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_1476336268038877188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1476336268038168578] &gt;= [Parameters].[Parameter 1] AND [Calculation_1476336268038168578] &lt;= [Parameters].[Date From (copy)_1476336268038742019]' />
      </column>
      <column caption='has_voucher' datatype='boolean' name='[Calculation_156781588582535168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [has_voucher (copy)_156781588587409410] &gt; 0 then TRUE else FALSE end' />
      </column>
      <column caption='Attribution' datatype='integer' name='[Calculation_156781588584173569]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [order_id]: MIN(IF [Calculation_156781588582535168] AND (&#13;&#10;CONTAINS(lower([name]), &apos;naty&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;denisa&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;jarda&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;kotyza&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;mila&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;banny&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;polina&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;gift&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;johny&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;david1d&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;filip&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;naty1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;terka5&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;naty5&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;terka1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;klara1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;eliska1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;eliska1d&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;dejmislevu10&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;lf10&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;vanoce10&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;vanoce6&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;special5&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;eshop_&apos;)&#13;&#10;)&#13;&#10;THEN 1&#13;&#10;ELSEIF [Calculation_156781588582535168] then 2&#13;&#10;ELSE 3&#13;&#10;END)}' />
      </column>
      <column caption='Channel Attribution' datatype='string' name='[Calculation_156781588593332227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_156781588584173569] = 1 then &quot;Eshop&quot;&#13;&#10;ELSEIF [Calculation_156781588584173569] = 2 Then &quot;AM&quot;&#13;&#10;ELSE &quot;Organic&quot;&#13;&#10;END' />
      </column>
      <column caption='Coupon Filter' datatype='boolean' name='[Calculation_3356589118762160130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [order_id]: MIN(IF [Calculation_156781588582535168] AND &#13;&#10;(CONTAINS(lower([name]), lower([Parameters].[Parameter 2])))&#13;&#10;THEN true END)}' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_3356589118773993476]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year([created_at])) + &apos;-&apos; + right(&apos;0&apos; + str(month([created_at])), 2)' />
      </column>
      <column caption='Month Filter' datatype='boolean' name='[Calculation_3356589118774951942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3356589118773993476] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='info label' datatype='string' name='[Calculation_3356589118776811529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;?&apos;' />
      </column>
      <column caption='is_new_or_wakeup_order' datatype='boolean' name='[Calculation_678636231889813504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [days_since_last_order] &gt; 150&#13;&#10;    OR [is_new] = 1&#13;&#10;then true else false end' />
      </column>
      <column caption='last_eshop_order_date' datatype='date' name='[Calculation_678636231897387009]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_code]: MAX([Calculation_1476336268038168578])}' />
      </column>
      <column caption='vendor_without_order' datatype='boolean' name='[Calculation_678636231898320899]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF IFNULL([Calculation_1148417961693323264],0) = 0&#13;&#10; OR DATEDIFF(&apos;day&apos;, max([Calculation_678636231897387009]), today()) &gt; 150&#13;&#10;then true else false&#13;&#10;end' />
      </column>
      <column caption='Max Month' datatype='string' name='[Date (copy)_3356589118775332872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year(today()-1)) + &apos;-&apos; + right(&apos;0&apos; + str(month(today()-1)), 2)' />
      </column>
      <column caption='AVG Purchase Price' datatype='real' default-format='C1029%' name='[Item Costs (purchase) (copy)_1148417961732476944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([unit_purchase_price_without_vat])' />
