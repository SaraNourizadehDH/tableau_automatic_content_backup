      <column caption='NCR clean (Eshop)' datatype='real' default-format='C1029%' name='[NCR (Eshop) (copy)_1148417961730482189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Costs (copy)_1148417961703186441] - [Calculation_1148417961697198085]' />
      </column>
      <column caption='AVG NCR (Eshop)' datatype='real' default-format='C1029%' name='[NCR (Eshop) (copy)_1148417961733476369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Costs (copy)_1148417961703186441] / [Calculation_1148417961702842376]' />
