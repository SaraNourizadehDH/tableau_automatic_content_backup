            <column caption='voucher_count' datatype='integer' name='[has_voucher (copy)_156781588587409410]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [order_id]: CountD(IF CONTAINS([name], &apos;kupon&apos;) then [order_id] end)}' />
