    <worksheet name='New Sales by Order'>
      <table>
        <view>
          <datasources>
            <datasource caption='shoptet_orders' name='federated.11w512k1ptqmjk1651ddw13grxdw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.11w512k1ptqmjk1651ddw13grxdw].[Calculation_1476336268037595136]' caption='Date To' datatype='date' name='[Date From (copy)_1476336268038742019]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.11w512k1ptqmjk1651ddw13grxdw].[Calculation_1476336268037869569]' caption='Date From' datatype='date' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11w512k1ptqmjk1651ddw13grxdw'>
            <column caption='# Vendors Eshop (new)' datatype='integer' name='[# Vendors Eshop (copy)_1148417961731432462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_new] = 1 then [restaurant_id (eshop_orders)] end)' />
            </column>
            <column caption='# Orders Eshop' datatype='integer' name='[Calculation_1148417961693323264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([id])' />
            </column>
            <column caption='# Vendors Eshop' datatype='integer' name='[Calculation_1148417961694003201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([restaurant_id (eshop_orders)])' />
            </column>
            <column caption='Turnover (excl storno)' datatype='real' default-format='C1029%' name='[Calculation_1148417961695154179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [status]&#13;&#10;WHEN in (&quot;Stornována&quot;, &quot;Stornovaná&quot;) then 0&#13;&#10;else [unit_price_without_vat] * [quantity]&#13;&#10;end)' />
            </column>
            <column caption='DF paid by Platform' datatype='real' default-format='C1029%' name='[Calculation_1148417961697198085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_paid_by_dj (eshop_deliveries)])' />
            </column>
            <column caption='Total Costs' datatype='real' default-format='C1029%' name='[Calculation_1148417961698258950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Turnover (excl storno) (copy)_1148417961696641028] + [Calculation_1148417961697198085]' />
            </column>
            <column caption='# Sold Items (Eshop)' datatype='real' name='[Calculation_1148417961702842376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([quantity])' />
            </column>
            <column caption='% Margin (Eshop)' datatype='real' default-format='p0.00%' name='[Calculation_1148417961703546891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Costs (copy)_1148417961703186441] / [Turnover (excl storno) (copy)_1148417961703374858]' />
            </column>
            <column caption='Data Date' datatype='date' name='[Calculation_1476336268037595136]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : DATE(MAX([created_at]))}' />
            </column>
            <column caption='Data Date start of Month' datatype='date' name='[Calculation_1476336268037869569]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED: MAX(DATE(DATETRUNC(&quot;month&quot;,[Calculation_1476336268037595136])))}' />
            </column>
            <column caption='Order Date' datatype='date' name='[Calculation_1476336268038168578]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([created_at])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1476336268038877188]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1476336268038168578] &gt;= [Parameters].[Parameter 1] AND [Calculation_1476336268038168578] &lt;= [Parameters].[Date From (copy)_1476336268038742019]' />
            </column>
            <column caption='has_voucher' datatype='boolean' name='[Calculation_156781588582535168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [has_voucher (copy)_156781588587409410] &gt; 0 then TRUE else FALSE end' />
            </column>
            <column caption='Attribution' datatype='integer' name='[Calculation_156781588584173569]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [order_id]: MIN(IF [Calculation_156781588582535168] AND (&#13;&#10;CONTAINS(lower([name]), &apos;naty&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;denisa&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;jarda&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;kotyza&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;mila&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;banny&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;polina&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;gift&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;johny&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;david1d&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;filip&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;naty1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;terka5&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;naty5&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;terka1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;klara1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;eliska1&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;eliska1d&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;dejmislevu10&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;lf10&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;vanoce10&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;vanoce6&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;special5&apos;)&#13;&#10;OR CONTAINS(lower([name]), &apos;eshop_&apos;)&#13;&#10;)&#13;&#10;THEN 1&#13;&#10;ELSEIF [Calculation_156781588582535168] then 2&#13;&#10;ELSE 3&#13;&#10;END)}' />
            </column>
            <column caption='Channel Attribution' datatype='string' name='[Calculation_156781588593332227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_156781588584173569] = 1 then &quot;Eshop&quot;&#13;&#10;ELSEIF [Calculation_156781588584173569] = 2 Then &quot;AM&quot;&#13;&#10;ELSE &quot;Organic&quot;&#13;&#10;END' />
            </column>
            <column caption='is_new_or_wakeup_order' datatype='boolean' name='[Calculation_678636231889813504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [days_since_last_order] &gt; 150&#13;&#10;    OR [is_new] = 1&#13;&#10;then true else false end' />
            </column>
            <column caption='NCR clean (Eshop)' datatype='real' default-format='C1029%' name='[NCR (Eshop) (copy)_1148417961730482189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Costs (copy)_1148417961703186441] - [Calculation_1148417961697198085]' />
            </column>
            <column caption='NCR (Eshop)' datatype='real' default-format='C1029%' name='[Total Costs (copy)_1148417961703186441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unit_ncr] * [quantity])' />
            </column>
            <column caption='Item Costs (purchase)' datatype='real' default-format='C1029%' name='[Turnover (excl storno) (copy)_1148417961696641028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unit_purchase_price_without_vat] * [quantity])' />
            </column>
            <column caption='Turnover (incl storno)' datatype='real' default-format='C1029%' name='[Turnover (excl storno) (copy)_1148417961703374858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unit_price_without_vat] * [quantity])' />
            </column>
            <column caption='Turnover (new)' datatype='real' default-format='C1029%' name='[Turnover (excl storno) (copy)_1148417961728454668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT [status] in (&quot;Stornována&quot;, &quot;Stornovaná&quot;) &#13;&#10;and [is_new] = 1 &#13;&#10;then [unit_price_without_vat] * [quantity]&#13;&#10;else 0 end)' />
            </column>
