            <column caption='Avg. QA Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_109353072252293124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([total_qa_score]))/ ZN(SUM([total_evaluations]))' />
            </column>
            <column caption='Onboarding Days' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_109353072253235205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([total_onboarding_age_days])) / ZN(SUM([total_onboarded_vendors]))' />
            </column>
            <column caption='CS Chat SLA' datatype='real' default-format='p0.00%' name='[Calculation_472948373058396160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([cs_sla_30s_chat]))/ZN(SUM([cs_inbound_chats]))' />
            </column>
            <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_472948373060816903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([cancelled_orders]))/ZN(SUM([gross_orders]))' />
            </column>
            <column caption='CSAT' datatype='real' default-format='p0.00%' name='[Calculation_513762243608764416]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='SUM([csat_promotor])/SUM([total_csat_reponses])' />
            </column>
            <column caption='Customer I/O' datatype='real' default-format='p0.00%' name='[Calculation_513762244309843997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([total_incidents_customer]))/ ZN(SUM([gross_orders]))' />
            </column>
            <column caption='Latest 4 months' datatype='boolean' name='[Calculation_513762244311117856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 3' />
            </column>
            <column caption='Automation Rate' datatype='real' default-format='p0.00%' name='[Calculation_749708644286586880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([automation_rate_numerator])) / ZN(SUM([automation_rate_denominator]))' />
            </column>
            <column caption='Vendor  I/O' datatype='real' default-format='p0.00%' name='[Customer I/O (copy)_513762244310130718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([total_incidents_vendor]))/ ZN(SUM([gross_orders]))' />
            </column>
            <column caption='Total CRV I/O' datatype='real' default-format='p0.00%' name='[Customer I/O (copy)_513762244340678693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([total_incidents_customer])) + ZN(SUM([total_incidents_rider])) + ZN(SUM([total_incidents_vendor]))) &#10;/ ZN(SUM([gross_orders]))' />
            </column>
            <column caption='DLD %' datatype='real' default-format='p0.00%' name='[DLP % (copy)_109353072167006209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([products_w_description_count])) / ZN(SUM([active_product_count]))' />
            </column>
            <column caption='VSAT' datatype='real' default-format='p0.00%' name='[RSAT (copy)_513762243608981506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([vsat_promotor]))/ZN(SUM([total_vsat_reponses]))' />
            </column>
            <column caption='Rider  I/O' datatype='real' default-format='p0.00%' name='[Vendor  I/O (copy)_513762244310257695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([total_incidents_rider]))/ ZN(SUM([od_gross_orders]))' />
            </column>
