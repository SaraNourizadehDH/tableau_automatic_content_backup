      <aliases enabled='yes' />
      <column caption='productivity YOY' datatype='real' default-format='p0.0%' name='[AB productivity MOM (copy)_1367616598920806402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [num_activations] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [distinct_user_count] END)&#10;    )&#10;    /&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [num_activations] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [distinct_user_count] END)&#10;    )&#10;) - 1' />
      </column>
      <column caption='[agg] Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1384786545973460994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_activations])&#10;/&#10;SUM([distinct_user_count])' />
      </column>
      <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
