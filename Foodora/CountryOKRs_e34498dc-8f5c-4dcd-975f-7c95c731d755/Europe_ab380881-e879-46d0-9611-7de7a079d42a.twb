            <column caption='[agg] % Orders late more than 30 min - QC and Resto' datatype='real' default-format='p0.0%' name='[Calculation_1517361276978343936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1517361276979478529])&#10;/&#10;sum([Calculation_1517361276979666946])' />
            </column>
            <column caption='total late orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979478529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_late_darkstores] + [n_late_restaurants] + [n_late_shops]' />
            </column>
            <column caption='total orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979666946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_shop_orders] + [n_restaurant_orders] + [n_darkstore_orders]' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
            </column>
            <column caption='% No Rider Fail' datatype='real' default-format='p0.0%' name='[[agg]] fail rate (copy)_1316458503496654852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_no_rider_count])&#10;/&#10;sum([rider_fail_gross_order_count])' />
            </column>
            <column caption='% Shrinking L2+' datatype='real' default-format='p0.0%' name='[[agg]] shrinkage (copy)_1316458503494873088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shrink_level_2_order_count])&#10;/&#10;sum([forecasted_orders])' />
