        <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) and [vendor_grade] = &quot;AB&quot; THEN [d30_deals_and_ads] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) and [vendor_grade] = &quot;AB&quot; THEN [vendor_count] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) and [vendor_grade] = &quot;AB&quot; THEN [d30_deals_and_ads] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) and [vendor_grade] = &quot;AB&quot; THEN [vendor_count] END)) &#10;)&#10;&#10;&#10;) * 100' />
