            <datasource caption='Productivity' name='federated.1gg5elc0sh2crs16h0shz068fkyb' />
          </datasources>
          <datasource-dependencies datasource='federated.0qjqbag1sv3wly1gplki61nkwmaw'>
            <column caption='%ab ads deals vs target' datatype='real' default-format='*0.0pp' name='[%ab &gt;75 orders vs target (copy)_1316458503817138197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_1455788616522063878]&#10;- AVG([target_ab_ads_deals_live_d30] )&#10;)&#10;* 100' />
            </column>
            <column caption='active inventory &gt; 1 order vs target' datatype='real' default-format='p0.0%' name='[AB acquisitions vs target (copy)_560909311130619910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ogv_vendors]) &#10;- sum([target_total_active_inventory]) &#10;)&#10;/&#10;sum([target_total_active_inventory])' />
            </column>
            <column caption='Sales  field rep productivity vs target' datatype='real' default-format='p0.0%' name='[AB acquisitions vs target (copy)_560909311185084437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_1384786545973460994]&#10;    - sum([target_sales_rep_productivity])&#10;)&#10;/&#10;sum([target_sales_rep_productivity])' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='AB acquisitions vs target' datatype='real' name='[Calculation_560909311127298053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[ab_aquisitions]) &#10;    - sum([target_ab_acquisition])&#10;)&#10;/&#10;sum([target_ab_acquisition])' />
            </column>
            <column caption='Zombies Revived vs target' datatype='real' default-format='p0.0%' name='[Zombies Formed vs target (copy)_1316458503815512084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_1455788616522248199]&#10;    / AVG([target_zombies_revived])&#10;)-1' />
            </column>
