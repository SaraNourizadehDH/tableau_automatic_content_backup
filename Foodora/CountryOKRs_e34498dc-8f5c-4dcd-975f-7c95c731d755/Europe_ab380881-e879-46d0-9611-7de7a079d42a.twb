            <column-instance column='[fail rate vs target (copy)_1316458503498129415]' derivation='User' name='[usr:fail rate vs target (copy)_1316458503498129415:qk]' pivot='key' type='quantitative' />
            <column-instance column='[shrinkage vs target (copy)_1316458503496175619]' derivation='User' name='[usr:shrinkage vs target (copy)_1316458503496175619:qk]' pivot='key' type='quantitative' />
            <column-instance column='[shrinkage vs target (copy)_560909311149842444]' derivation='User' name='[usr:shrinkage vs target (copy)_560909311149842444:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='[agg] % Orders late more than 30 min - QC and Resto' datatype='real' default-format='p0.0%' name='[Calculation_1517361276978343936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1517361276979478529])&#10;/&#10;sum([Calculation_1517361276979666946])' />
            </column>
            <column caption='total late orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979478529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_late_darkstores] + [n_late_restaurants] + [n_late_shops]' />
            </column>
            <column caption='total orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979666946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_shop_orders] + [n_restaurant_orders] + [n_darkstore_orders]' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='[agg] on time delivery' datatype='real' name='[Calculation_6636476317117718528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([on_time_okr_weighted_per_pdt_pct] * [gross_orders])&#10;/&#10;sum([gross_orders])' />
            </column>
            <column caption='% No Rider Fail' datatype='real' default-format='p0.0%' name='[[agg]] fail rate (copy)_1316458503496654852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_no_rider_count])&#10;/&#10;sum([rider_fail_gross_order_count])' />
            </column>
            <column caption='% Shrinking L2+' datatype='real' default-format='p0.0%' name='[[agg]] shrinkage (copy)_1316458503494873088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shrink_level_2_order_count])&#10;/&#10;sum([forecasted_orders])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[failed_no_rider_count]' role='measure' type='quantitative' />
            <column caption='Forecasted Orders' datatype='real' name='[forecasted_orders]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gross Orders' datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column caption='N Darkstore Orders' datatype='integer' name='[n_darkstore_orders]' role='measure' type='quantitative' />
