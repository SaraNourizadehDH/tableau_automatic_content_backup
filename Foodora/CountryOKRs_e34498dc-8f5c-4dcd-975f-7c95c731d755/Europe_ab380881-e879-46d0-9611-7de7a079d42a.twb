        <calculation class='tableau' formula='(&#10;    ((&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#13;&#10;&#10;    -&#13;&#10;&#10;    ((&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#10;) * 100' />
      </column>
      <column caption='% dCPO/AFV MoM' datatype='real' default-format='*0.0pp' name='[% Deal Utilization MoM (copy)_3087499060838256642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    ((&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#13;&#10;&#10;    -&#13;&#10;&#10;    ((&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#10;) * 100' />
      </column>
      <column caption='% Offline YOY' datatype='real' name='[% Offline MoM (copy)_5829206083545305091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [closed_hours] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [scheduled_hours] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [closed_hours] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [scheduled_hours] END)) &#10;)&#10;&#10;&#10;) * 100' />
      </column>
