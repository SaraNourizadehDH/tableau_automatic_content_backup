      <aliases enabled='yes' />
      <column caption='CP YoY' datatype='real' name='[CP MoM (copy)_1193172472298930181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [CP] END) &#10;- &#10;SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [CP] END)) * 100' />
      </column>
      <column datatype='real' default-format='p0.0%' name='[CP]' role='measure' type='quantitative' />
      <column caption='CP MoM' datatype='real' name='[Calculation_1193172472296452098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [CP] END) &#10;- &#10;SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [CP] END)) * 100' />
      </column>
      <column caption='CP target calc' datatype='real' name='[Calculation_2811161014204903426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([country]) = &quot;Bangladesh&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) &#10;ELSEIF ATTR([country]) = &quot;Hong Kong&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.02&#10;ELSEIF ATTR([country]) = &quot;Cambodia&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.05&#10;ELSEIF ATTR([country]) = &quot;Laos&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.03&#10;ELSEIF ATTR([country]) = &quot;Myanmar&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END)&#10;ELSEIF ATTR([country]) = &quot;Malaysia&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.02&#10;ELSEIF ATTR([country]) = &quot;Philippines&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.02&#10;ELSEIF ATTR([country]) = &quot;Pakistan&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END)&#10;ELSEIF ATTR([country]) = &quot;Singapore&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.04&#10;ELSEIF ATTR([country]) = &quot;Thailand&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) &#10;ELSEIF ATTR([country]) = &quot;Taiwan&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.03&#10;ELSEIF ATTR([country]) = &quot;Austria&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.03&#10;ELSEIF ATTR([country]) = &quot;Czech Republic&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.02&#10;ELSEIF ATTR([country]) = &quot;Finland&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.03&#10;ELSEIF ATTR([country]) = &quot;Hungary&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.05&#10;ELSEIF ATTR([country]) = &quot;Norway&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.03&#10;ELSEIF ATTR([country]) = &quot;Sweden&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.04&#10;ELSEIF ATTR([country]) = &quot;Turkey&quot; THEN&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END) * 1.03&#10;ELSE&#10;    SUM(IF YEAR([Month]) = 2024 AND MONTH([Month]) = 12 THEN [CP] END)&#10;END' />
      </column>
      <column caption='CP vs target' datatype='real' name='[Calculation_2811161014205345795]' role='measure' type='quantitative'>
