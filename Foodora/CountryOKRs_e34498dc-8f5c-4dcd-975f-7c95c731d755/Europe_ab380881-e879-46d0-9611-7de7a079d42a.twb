              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_gmv_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [pro_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [pro_gmv_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
