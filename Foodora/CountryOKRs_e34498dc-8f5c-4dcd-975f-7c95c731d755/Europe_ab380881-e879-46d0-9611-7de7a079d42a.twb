    <worksheet name='CZ - BE'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='Acquisitions + reacquisitions' datatype='integer' name='[Calculation_139752371579179010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisitions] + [reacquisitions]' />
            </column>
            <column caption='[agg] Pro user savings (% of Pro GFV)' datatype='real' default-format='p0.0%' name='[Calculation_4021221951847432192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([user_savings_over_gfv_a])&#10;/&#10;sum([pro_fd_pro_gfv_b])' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
            </column>
            <column caption='[agg] HVA Percentage' datatype='real' default-format='p0.0%' name='[Calculation_5829206083599650835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dh_hva_incentive])&#10;/&#10;sum([total_dh_incentive])' />
            </column>
            <column datatype='integer' name='[MAU]' role='measure' type='quantitative' />
            <column caption='[agg] subscriber gmv share' datatype='real' name='[[agg]] subscriber mau share (copy)_2179883011273740291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_contribtuion_percent_a])&#10;/&#10;sum([gmv_contribtuion_percent_b])' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dh Hva Incentive' datatype='real' name='[dh_hva_incentive]' role='measure' type='quantitative' />
