    <worksheet name='CZ seamless vs target'>
      <table>
        <view>
          <datasources>
            <datasource caption='Targets' name='federated.0qjqbag1sv3wly1gplki61nkwmaw' />
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.0qjqbag1sv3wly1gplki61nkwmaw'>
            <column caption='rider hours vs target' datatype='real' name='[AB acquisitions vs target (copy)_560909311136407561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[rider_hours]) &#10;- SUM([target_actual_rider_working_hours])&#10;)&#10;/&#10;SUM([target_actual_rider_working_hours])' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='Orders Delayed 30+ vs target' datatype='real' default-format='*0.0pp' name='[No Rider Fail rate vs target (copy)_1316458503500464136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_1517361276978343936]&#10;    - AVG([target_order_late_30_min])&#10;) &#10;* 100' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='No Rider Fail rate vs target' datatype='real' default-format='*0.0pp' name='[fail rate vs target (copy)_1316458503498129415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[[agg]] fail rate (copy)_1316458503496654852]&#10;    - AVG([target_no_rider_fail])&#10;) &#10;* 100' />
            </column>
            <column-instance column='[Calculation_560909311124627459]' derivation='None' name='[none:Calculation_560909311124627459:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='shrinkage l2+ vs target' datatype='real' default-format='*0.0pp' name='[shrinkage vs target (copy)_1316458503496175619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[[agg]] shrinkage (copy)_1316458503494873088]&#10;- AVG([target_shrinking_2_plus])&#10;&#10;) &#10;* 100' />
            </column>
            <column caption='on time delivery vs target' datatype='real' name='[shrinkage vs target (copy)_560909311149842444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[Calculation_6636476317117718528]&#10;    - AVG([target_on_time_delivery])&#10;&#10;) &#10;* 100' />
            </column>
            <column caption='Target Actual Rider Working Hours' datatype='real' name='[target_actual_rider_working_hours]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.0%' name='[target_no_rider_fail]' role='measure' type='quantitative' />
