            <groupfilter function='member' level='[none:country:nk]' member='&quot;Turkey&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
            <target field='[federated.1u33d850g9lkdp1dfuxpn1sdmmx7].[none:country:nk]' />
