    <worksheet name='TR - Seamless MOM'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
            <datasource caption='Category Position' name='federated.09b50cw1yoirn117dip140l4nbig' />
          </datasources>
          <datasource-dependencies datasource='federated.09b50cw1yoirn117dip140l4nbig'>
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% dCPO/AFV MoM' datatype='real' default-format='*0.0pp' name='[% Deal Utilization MoM (copy)_3087499060838256642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    ((&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#13;&#10;&#10;    -&#13;&#10;&#10;    ((&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#10;) * 100' />
            </column>
            <column caption='% No Rider Fail MoM' datatype='real' default-format='*0.0pp' name='[Fail rate MoM (copy)_1316458503496667141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [rider_fail_gross_order_count] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [rider_fail_gross_order_count] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Rider hours MoM' datatype='real' default-format='p0.0%' name='[Rider hours actual planned MoM (copy)_560909311152668686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [rider_hours] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [rider_hours] END)&#10;) &#10;&#10;/&#10;&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [rider_hours] END)' />
            </column>
            <column caption='Shrinkage L2+ MoM' datatype='real' default-format='*0.0pp' name='[Shrinkage MoM (copy)_1316458503494885377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shrink_level_2_order_count] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [forecasted_orders] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [shrink_level_2_order_count] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [forecasted_orders] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[failed_no_rider_count]' role='measure' type='quantitative' />
            <column caption='Forecasted Orders' datatype='real' name='[forecasted_orders]' role='measure' type='quantitative' />
            <column caption='Healthy Vendor Availability D' datatype='integer' name='[healthy_vendor_availability_d]' role='measure' type='quantitative' />
            <column caption='Healthy Vendor Availability N' datatype='integer' name='[healthy_vendor_availability_n]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[own_delivery_gfv_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[own_delivery_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[rider_fail_gross_order_count]' role='measure' type='quantitative' />
            <column caption='Rider Hours' datatype='real' name='[rider_hours]' role='measure' type='quantitative' />
            <column datatype='real' name='[shrink_level_2_order_count]' role='measure' type='quantitative' />
            <column caption='healthy vendors MoM' datatype='real' default-format='*0.0pp' name='[successful ab vendors MoM (copy)_5829206083541450752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [healthy_vendor_availability_n] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [healthy_vendor_availability_d] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [healthy_vendor_availability_n] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [healthy_vendor_availability_d] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column datatype='real' name='[total_delivery_rider_costs_eur]' role='measure' type='quantitative' />
            <column-instance column='[% Deal Utilization MoM (copy)_3087499060838256642]' derivation='User' name='[usr:% Deal Utilization MoM (copy)_3087499060838256642:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Fail rate MoM (copy)_1316458503496667141]' derivation='User' name='[usr:Fail rate MoM (copy)_1316458503496667141:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Rider hours actual planned MoM (copy)_560909311152668686]' derivation='User' name='[usr:Rider hours actual planned MoM (copy)_560909311152668686:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Shrinkage MoM (copy)_1316458503494885377]' derivation='User' name='[usr:Shrinkage MoM (copy)_1316458503494885377:qk]' pivot='key' type='quantitative' />
            <column-instance column='[successful ab vendors MoM (copy)_5829206083541450752]' derivation='User' name='[usr:successful ab vendors MoM (copy)_5829206083541450752:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
