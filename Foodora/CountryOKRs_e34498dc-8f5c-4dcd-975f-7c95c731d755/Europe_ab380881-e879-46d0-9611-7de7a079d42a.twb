            <column-instance column='[Pro vendor GMV coverage MoM  (copy)_1316458503796465681]' derivation='User' name='[usr:Pro vendor GMV coverage MoM  (copy)_1316458503796465681:qk]' pivot='key' type='quantitative' />
            <column-instance column='[VFD GMV MOM (copy)_3984137611678072834]' derivation='User' name='[usr:VFD GMV MOM (copy)_3984137611678072834:qk]' pivot='key' type='quantitative' />
