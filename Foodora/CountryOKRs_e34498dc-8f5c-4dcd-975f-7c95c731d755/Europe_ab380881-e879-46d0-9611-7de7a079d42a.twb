    <worksheet name='TR - Choice MOM'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
            <datasource caption='Productivity' name='federated.1gg5elc0sh2crs16h0shz068fkyb' />
            <datasource caption='Category Position' name='federated.09b50cw1yoirn117dip140l4nbig' />
          </datasources>
          <datasource-dependencies datasource='federated.09b50cw1yoirn117dip140l4nbig'>
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gg5elc0sh2crs16h0shz068fkyb'>
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='Ogv vendors MoM' datatype='real' name='[AB Acquisitions MoM (copy)_1193172472303448075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ogv_vendors] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ogv_vendors] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ogv_vendors] END)' />
            </column>
            <column caption='Vendor Acquisitions MoM' datatype='real' name='[AB Acquisitions MoM (copy)_1765411100273885184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_vendor_aquisitions] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_vendor_aquisitions]  END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_vendor_aquisitions]  END)' />
            </column>
            <column caption='% Vendors F30D Orders &gt;1 MoM' datatype='real' default-format='*0.0pp' name='[D30 Deals and Ads MoM (copy)_1316458503506300937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d30_has_order] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vendor_count] END)&#13;&#10;    )&#13;&#10;    -&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [d30_has_order] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vendor_count] END)&#13;&#10;    )&#13;&#10;) * 100' />
            </column>
            <column caption='successful ab vendors MoM' datatype='real' default-format='*0.0pp' name='[Shrinkage MoM (copy)_1559723260982231040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [successful_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_vendors_sf] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [successful_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_vendors_sf] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[d30_has_order]' role='measure' type='quantitative' />
            <column datatype='integer' name='[field_rep_activations_num]' role='measure' type='quantitative' />
            <column datatype='integer' name='[field_rep_users]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Ogv Vendors' datatype='integer' name='[ogv_vendors]' role='measure' type='quantitative' />
            <column caption='Field Rep Productivity MOM' datatype='real' default-format='p0.0%' name='[sales rep prod MOM (copy)_4229231948254277650]' role='measure' type='quantitative'>
