    <worksheet name='CZ - Seamless YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe)' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
            <datasource caption='Category Position' name='federated.09b50cw1yoirn117dip140l4nbig' />
          </datasources>
          <datasource-dependencies datasource='federated.09b50cw1yoirn117dip140l4nbig'>
            <column aggregation='Count' datatype='date' datatype-customized='true' name='[Month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% orders late 30mins YoY' datatype='real' default-format='*0.0pp' name='[% orders late 30mins MoM (copy)_1559723260986138627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [Calculation_1517361276979478529]  END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [Calculation_1517361276979666946]  END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [Calculation_1517361276979478529] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [Calculation_1517361276979666946]  END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='total late orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979478529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_late_darkstores] + [n_late_restaurants] + [n_late_shops]' />
            </column>
            <column caption='total orders (restos, qc)' datatype='integer' name='[Calculation_1517361276979666946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[n_shop_orders] + [n_restaurant_orders] + [n_darkstore_orders]' />
            </column>
            <column caption='% No Rider Fail YoY' datatype='real' default-format='*0.0pp' name='[Fail rate YoY (copy)_1316458503496679430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [rider_fail_gross_order_count] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [rider_fail_gross_order_count] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='On time delivery YOY' datatype='real' name='[On time delivery MOM (copy)_1193172472312139807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [on_time_okr_weighted_per_pdt_pct] * [gross_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gross_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [on_time_okr_weighted_per_pdt_pct] * [gross_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gross_orders] END)&#10;    )&#10;&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Rider hours YOY' datatype='real' default-format='p0.0%' name='[Rider hours MoM (copy)_560909311152951311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [rider_hours] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [rider_hours] END)&#10;) &#10;&#10;/&#10;&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [rider_hours] END)' />
            </column>
            <column caption='Shrinkage L2+ YoY' datatype='real' default-format='*0.0pp' name='[Shrinkage YoY (copy)_1316458503494897666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shrink_level_2_order_count] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [forecasted_orders] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shrink_level_2_order_count] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [forecasted_orders] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
