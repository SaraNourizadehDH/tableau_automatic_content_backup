      <column caption='[agg] shrinkage' datatype='real' name='[Calculation_1520246402929152002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([shrink_orders])&#10;/&#10;sum([forecasted_orders])' />
      </column>
      <column caption='[agg] incidents rate' datatype='real' name='[Calculation_1520246402931109891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_incidents_customer] + [total_incidents_vendor] + [total_incidents_rider])&#10;/&#10;SUM([gross_orders])' />
      </column>
      <column caption='[agg] fail rate' datatype='real' name='[Calculation_1520246402932019204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cancelled_orders])&#10;/&#10;sum([gross_orders])' />
      </column>
      <column caption='[agg] avg onboarding age days' datatype='real' name='[Calculation_1520246402933256197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([onboarding_age_days])&#10;/&#10;sum([onboarded_vendors])' />
      </column>
      <column caption='[agg] DLP' datatype='real' name='[Calculation_1520246402933694470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_products_with_images])&#10;/&#10;sum([active_products])' />
      </column>
      <column caption='[agg] % paying subscribers' datatype='real' name='[Calculation_164381440896249856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([paying_subscribers_percent_a])&#10;/&#10;sum([paying_subscribers_percent_b])' />
      </column>
      <column caption='Dashboard refresh' datatype='datetime' name='[Calculation_2179883011286724612]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='NOW()' />
      </column>
      <column caption='Pro VFD / Pro GMV' datatype='real' default-format='p0.0%' name='[Calculation_2347782818539450381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_vendor_eur])&#13;&#10;/&#13;&#10;sum([pro_gmv_eur])' />
      </column>
      <column caption='gmv vs target' datatype='real' name='[Calculation_2811161014204100609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv] END)&#10;-&#10;SUM([federated.0a87wdf0rz2sml15ot1g30uedy47].[GMV])&#10;)&#10;/&#10;SUM([federated.0a87wdf0rz2sml15ot1g30uedy47].[GMV])' />
      </column>
      <column caption='% dCPO/AFV' datatype='real' default-format='p0.0%' name='[Calculation_3087499060837339136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(total_delivery_rider_costs_eur) / SUM([own_delivery_orders]))&#13;&#10;/&#13;&#10;(SUM([own_delivery_gfv_eur]) / SUM([own_delivery_orders]))' />
      </column>
      <column caption='[agg] VFD GMV' datatype='real' name='[Calculation_3984137611677024256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(total_incentive_cost_vendor_incl_manual_adjustment_eur)&#10;/&#10;sum([gmv_eur])' />
      </column>
      <column caption='VFD GMV MOM' datatype='real' name='[Calculation_3984137611677843457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='[agg] Pro user savings (% of Pro GFV)' datatype='real' default-format='p0.0%' name='[Calculation_4021221951847432192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([user_savings_over_gfv_a])&#10;/&#10;sum([pro_fd_pro_gfv_b])' />
      </column>
      <column caption='GMV MoM' datatype='real' default-format='p0.0%' name='[Calculation_4174555420583063553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv] END)' />
      </column>
      <column caption='[agg] stacking %' datatype='real' name='[Calculation_426856855905968128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stacked_deliveries_sum])&#10;/&#10;sum([stacked_deliveries_cnt])' />
      </column>
      <column caption='Incident rate MOM' datatype='real' name='[Calculation_426856855937146886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN ([total_incidents_customer] + [total_incidents_vendor] + [total_incidents_rider]) END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gross_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN ([total_incidents_customer] + [total_incidents_vendor] + [total_incidents_rider]) END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gross_orders] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='stacking % MOM' datatype='real' name='[Calculation_426856855937912840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [stacked_deliveries_sum] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [stacked_deliveries_cnt] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [stacked_deliveries_sum] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [stacked_deliveries_cnt] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='avg onboarding age day MOM' datatype='real' name='[Calculation_426856855938236426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [onboarding_age_days] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [onboarded_vendors] END)&#10;    )&#10;    /&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [onboarding_age_days] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [onboarded_vendors] END)&#10;    )&#10;) - 1' />
      </column>
      <column caption='DLP MOM' datatype='real' name='[Calculation_426856855939088396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;  (&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [active_products_with_images] END)&#10;    /&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [active_products] END)&#10;  )&#10;  -&#10;  (&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [active_products_with_images] END)&#10;    /&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [active_products] END)&#10;  )&#10;) * 100' />
      </column>
      <column caption='[agg] Dmart Pct Weighted Availability V2' datatype='real' default-format='p0.0%' name='[Calculation_4501558987557949440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dmart_wa_num])&#10;/&#10;sum([dmart_wa_den])' />
