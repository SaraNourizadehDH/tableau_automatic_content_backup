              <calculation class='tableau' formula='&apos;TG Participant - TG Non-Participant&apos;' />
            </column>
            <column caption='1-((ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN...' datatype='real' name='[Calculation_5632173581516472360]' role='measure' type='quantitative' user:unnamed='Sheet 41'>
