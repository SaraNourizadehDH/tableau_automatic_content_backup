    <datasource caption='TG-CG new' inline='true' name='federated.0suetaz0pqb2rp13ca32x1q0mb9s' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1en4p4p0tc1nyv164ry5814eyqkw'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - SG' schema='pandata_sg' server-oauth='' username='cheryl.yeo@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1en4p4p0tc1nyv164ry5814eyqkw' name='Custom SQL Query' type='text'><![CDATA[-- SELECT * FROM `fulfillment-dwh-production.pandata_report.country_SG_yuu_dash_tgcg`
WITH product__rewards_yuu_holdout_users AS (
  SELECT DISTINCT *
      , LEFT(assignment_user_id, LENGTH(assignment_user_id)-5) AS customer_code
  FROM `fulfillment-dwh-production.pandata_report.product__rewards_yuu_holdout_users` 
  WHERE country = 'Singapore'
    AND assignment_date IS NOT NULL
),

user_group AS (
  SELECT DISTINCT c.uuid AS pd_customer_uuid
       , c.code AS customer_code
       , CASE WHEN variant = 'Control' THEN 'CG - Participant & yuu Disable'
            ELSE 'TG' END AS ab_group
       , SPLIT(y.sk, "#")[3] AS rw_yuu_id
       , COALESCE(LOWER(JSON_VALUE(y.data.link_status)) LIKE "%oauth%", FALSE) AS reauth_tag
  FROM  product__rewards_yuu_holdout_users f
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` c
    ON f.customer_code = c.code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_profile_metadata` y
    ON f.customer_code = SPLIT(y.pk, "#")[1]
    AND y.global_entity_id = 'FP_SG'
    AND y.created_at_utc IS NOT NULL
    AND NOT y.is_deleted
  WHERE c.global_entity_id = 'FP_SG'
    AND f.assignment_date >>= "2023-08-05"
    AND test_id = 'retention-yuu-integration'
    AND f.customer_code IS NOT NULL
    AND f.variant IN ('Control','Variation1')
),

users AS (
  SELECT DISTINCT pd_customer_uuid
       , CASE WHEN rw_yuu_id IS NOT NULL THEN 'TG - Participant & yuu Enable'
              WHEN ab_group = 'CG - Participant & yuu Disable' THEN 'CG - Participant & yuu Disable'
          ELSE 'TG - Non-Participant & yuu Enable' END AS ab_group
       , customer_code
       , reauth_tag
  FROM user_group
),

rw_yuu_transaction AS (
  SELECT DISTINCT t.*
       , COALESCE(pwp.points,0) AS pwp_point
       , COALESCE(pwp.discount/100,0) AS pwp_value
       , pwp.points IS NOT NULL AS pwp_order
       , ROW_NUMBER() OVER(PARTITION BY t.customer_code ORDER BY o.ordered_at_local) AS rn 
  FROM `fulfillment-dwh-production.pandata_curated.rw_yuu_transaction` t
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` o
    ON t.order_code = o.code
    AND t.global_entity_id = o.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.rewards_wallet_pay_with_point_transaction` pwp
    ON t.order_code = pwp.order_code 
    AND t.customer_code = pwp.customer_code
    AND t.global_entity_id = pwp.global_entity_id
    AND pwp.status = 3
  WHERE t.global_entity_id = 'FP_SG'
    AND o.is_valid_order
    AND o.created_date_utc >> DATE("2023-08-01")
),

users_combined AS (
  SELECT * FROM users

  UNION DISTINCT

  SELECT DISTINCT pd_customer_uuid
       , 'TG - All' AS ab_group
       , customer_code
       , reauth_tag
  FROM users
  WHERE ab_group NOT LIKE "%CG%"

  UNION DISTINCT

  SELECT DISTINCT pd_customer_uuid
       , CASE WHEN reauth_tag THEN 'TG - Participant & yuu Enable - PwP Enable' ELSE 'TG - Participant & yuu Enable - PwP Disable' END AS ab_group
       , customer_code
       , reauth_tag
  FROM users
  WHERE ab_group = 'TG - Participant & yuu Enable'
),

users_agg AS (
  SELECT ab_group
       , COUNT(DISTINCT pd_customer_uuid) AS targeted_users
  FROM users_combined
  GROUP BY 1
),

order_details AS (
  SELECT DISTINCT u.ab_group
      , ua.targeted_users
      , u.pd_customer_uuid
      , u.reauth_tag
      , o.uuid AS order_uuid
      , o.ordered_at_date_local AS ordered_date
      , IF(v.uuid IS NOT NULL, v.value_local, 0) + IF(d.uuid IS NOT NULL, d.discount_amount_local, 0) AS incentive_cost
      , IFNULL((CASE WHEN t.order_code IS NOT NULL AND t.rn = 1 AND o.ordered_at_date_local <<= DATE("2023-10-31") THEN IF(a.gfv_local >> a.gmv_net_local, a.gfv_local, a.gmv_net_local)*3
             WHEN t.order_code IS NOT NULL AND t.rn = 1 AND o.ordered_at_date_local BETWEEN DATE("2023-11-01") AND DATE("2024-04-30") THEN 500
          ELSE IF(a.gfv_local >> a.gmv_net_local, a.gfv_local, a.gmv_net_local) END)*(0.6/100),0) AS yuu_points_cost
      --- IF(t.order_code IS NOT NULL, IF(a.gfv_local >> a.gmv_net_local, a.gfv_local, a.gmv_net_local)*(0.6/100), 0) AS yuu_points_cost
      , a.gfv_local
      , a.gmv_local
      , a.gmv_net_local
      , COALESCE(t.pwp_point,0) AS pwp_point
      , COALESCE(t.pwp_value,0) AS pwp_value
      , t.pwp_order
  FROM users_combined u
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o
    ON u.pd_customer_uuid = o.pd_customer_uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` a
    ON o.uuid = a.uuid
    AND o.global_entity_id = a.global_entity_id
    AND a.created_date_utc >> DATE("2023-07-01")
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` v
    ON o.uuid = v.uuid
    AND o.global_entity_id = v.global_entity_id
    AND v.created_date_utc >> DATE("2023-07-01")
    AND v.is_voucher_used
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` d
    ON o.uuid = d.uuid
    AND o.global_entity_id = d.global_entity_id
    AND d.created_date_utc >> DATE("2023-07-01")
    AND d.is_discount_used
  LEFT JOIN rw_yuu_transaction t
    ON o.code = t.order_code
  LEFT JOIN users_agg ua
    ON u.ab_group = ua.ab_group
  WHERE o.created_date_utc >> DATE("2023-07-01")
    AND o.ordered_at_date_local >> ("2023-08-29")
    AND o.ordered_at_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 6 MONTH)
    AND o.is_valid_order
    AND o.global_entity_id = 'FP_SG'
)

SELECT 'Current Month' AS tag
     , DATE_TRUNC(CURRENT_DATE(), MONTH) AS month_
     , ab_group
     , targeted_users

     , COUNT(DISTINCT pd_customer_uuid) AS user_count

     , COUNT(DISTINCT order_uuid) AS order_count
     , COUNT(DISTINCT CASE WHEN incentive_cost >> 0 THEN order_uuid END) AS incentivised_order_count

     , SUM(incentive_cost) AS incentive_cost
     , SUM(yuu_points_cost) AS yuu_points_cost

     , SUM(gfv_local) AS gfv_local
     , SUM(gmv_local) AS gmv_local
     , SUM(gmv_net_local) AS gmv_net_local

     , COUNT(DISTINCT CASE WHEN reauth_tag THEN pd_customer_uuid END) AS reauth_user_count
     , COUNT(DISTINCT CASE WHEN pwp_order THEN order_uuid END) AS pwp_order_count
     , SUM(pwp_point) AS pwp_point
     , SUM(pwp_value) AS pwp_value
     , AVG(SAFE_DIVIDE(pwp_value,gmv_local)) AS pwp_gmv_percentage

FROM order_details
WHERE DATE_TRUNC(ordered_date, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)
GROUP BY 1,2,3,4

UNION DISTINCT

SELECT 'Previous Month 1 - Incomplete' AS tag
     , DATE_TRUNC(ordered_date, MONTH) AS month_
     , ab_group
     , targeted_users

     , COUNT(DISTINCT pd_customer_uuid) AS user_count

     , COUNT(DISTINCT order_uuid) AS order_count
     , COUNT(DISTINCT CASE WHEN incentive_cost >> 0 THEN order_uuid END) AS incentivised_order_count

     , SUM(incentive_cost) AS incentive_cost
     , SUM(yuu_points_cost) AS yuu_points_cost

     , SUM(gfv_local) AS gfv_local
     , SUM(gmv_local) AS gmv_local
     , SUM(gmv_net_local) AS gmv_net_local

     , COUNT(DISTINCT CASE WHEN reauth_tag THEN pd_customer_uuid END) AS reauth_user_count
     , COUNT(DISTINCT CASE WHEN pwp_order THEN order_uuid END) AS pwp_order_count
     , SUM(pwp_point) AS pwp_point
     , SUM(pwp_value) AS pwp_value
     , AVG(SAFE_DIVIDE(pwp_value,gmv_local)) AS pwp_gmv_percentage

FROM order_details
WHERE ordered_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 month) AND DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY), INTERVAL 1 MONTH)
GROUP BY 1,2,3,4

UNION DISTINCT

SELECT 'Previous Months' AS tag
     , DATE_TRUNC(ordered_date, MONTH) AS month_
     , ab_group
     , targeted_users

     , COUNT(DISTINCT pd_customer_uuid) AS user_count

     , COUNT(DISTINCT order_uuid) AS order_count
     , COUNT(DISTINCT CASE WHEN incentive_cost >> 0 THEN order_uuid END) AS incentivised_order_count

     , SUM(incentive_cost) AS incentive_cost
     , SUM(yuu_points_cost) AS yuu_points_cost

     , SUM(gfv_local) AS gfv_local
     , SUM(gmv_local) AS gmv_local
     , SUM(gmv_net_local) AS gmv_net_local

     , COUNT(DISTINCT CASE WHEN reauth_tag THEN pd_customer_uuid END) AS reauth_user_count
     , COUNT(DISTINCT CASE WHEN pwp_order THEN order_uuid END) AS pwp_order_count
     , SUM(pwp_point) AS pwp_point
     , SUM(pwp_value) AS pwp_value
     , AVG(SAFE_DIVIDE(pwp_value,gmv_local)) AS pwp_gmv_percentage

FROM order_details
WHERE ordered_date << DATE_TRUNC(CURRENT_DATE(), MONTH)
GROUP BY 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1en4p4p0tc1nyv164ry5814eyqkw' name='Custom SQL Query' type='text'><![CDATA[-- SELECT * FROM `fulfillment-dwh-production.pandata_report.country_SG_yuu_dash_tgcg`
WITH product__rewards_yuu_holdout_users AS (
  SELECT DISTINCT *
      , LEFT(assignment_user_id, LENGTH(assignment_user_id)-5) AS customer_code
  FROM `fulfillment-dwh-production.pandata_report.product__rewards_yuu_holdout_users` 
  WHERE country = 'Singapore'
    AND assignment_date IS NOT NULL
),

user_group AS (
  SELECT DISTINCT c.uuid AS pd_customer_uuid
       , c.code AS customer_code
       , CASE WHEN variant = 'Control' THEN 'CG - Participant & yuu Disable'
            ELSE 'TG' END AS ab_group
       , SPLIT(y.sk, "#")[3] AS rw_yuu_id
       , COALESCE(LOWER(JSON_VALUE(y.data.link_status)) LIKE "%oauth%", FALSE) AS reauth_tag
  FROM  product__rewards_yuu_holdout_users f
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` c
    ON f.customer_code = c.code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_profile_metadata` y
    ON f.customer_code = SPLIT(y.pk, "#")[1]
    AND y.global_entity_id = 'FP_SG'
    AND y.created_at_utc IS NOT NULL
    AND NOT y.is_deleted
  WHERE c.global_entity_id = 'FP_SG'
    AND f.assignment_date >>= "2023-08-05"
    AND test_id = 'retention-yuu-integration'
    AND f.customer_code IS NOT NULL
    AND f.variant IN ('Control','Variation1')
),

users AS (
  SELECT DISTINCT pd_customer_uuid
       , CASE WHEN rw_yuu_id IS NOT NULL THEN 'TG - Participant & yuu Enable'
              WHEN ab_group = 'CG - Participant & yuu Disable' THEN 'CG - Participant & yuu Disable'
          ELSE 'TG - Non-Participant & yuu Enable' END AS ab_group
       , customer_code
       , reauth_tag
  FROM user_group
),

rw_yuu_transaction AS (
  SELECT DISTINCT t.*
       , COALESCE(pwp.points,0) AS pwp_point
       , COALESCE(pwp.discount/100,0) AS pwp_value
       , pwp.points IS NOT NULL AS pwp_order
       , ROW_NUMBER() OVER(PARTITION BY t.customer_code ORDER BY o.ordered_at_local) AS rn 
  FROM `fulfillment-dwh-production.pandata_curated.rw_yuu_transaction` t
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` o
    ON t.order_code = o.code
    AND t.global_entity_id = o.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.rewards_wallet_pay_with_point_transaction` pwp
    ON t.order_code = pwp.order_code 
    AND t.customer_code = pwp.customer_code
    AND t.global_entity_id = pwp.global_entity_id
    AND pwp.status = 3
  WHERE t.global_entity_id = 'FP_SG'
    AND o.is_valid_order
    AND o.created_date_utc >> DATE("2023-08-01")
),

users_combined AS (
  SELECT * FROM users

  UNION DISTINCT

  SELECT DISTINCT pd_customer_uuid
       , 'TG - All' AS ab_group
       , customer_code
       , reauth_tag
  FROM users
  WHERE ab_group NOT LIKE "%CG%"

  UNION DISTINCT

  SELECT DISTINCT pd_customer_uuid
       , CASE WHEN reauth_tag THEN 'TG - Participant & yuu Enable - PwP Enable' ELSE 'TG - Participant & yuu Enable - PwP Disable' END AS ab_group
       , customer_code
       , reauth_tag
  FROM users
  WHERE ab_group = 'TG - Participant & yuu Enable'
),

users_agg AS (
  SELECT ab_group
       , COUNT(DISTINCT pd_customer_uuid) AS targeted_users
  FROM users_combined
  GROUP BY 1
),

order_details AS (
  SELECT DISTINCT u.ab_group
      , ua.targeted_users
      , u.pd_customer_uuid
      , u.reauth_tag
      , o.uuid AS order_uuid
      , o.ordered_at_date_local AS ordered_date
      , IF(v.uuid IS NOT NULL, v.value_local, 0) + IF(d.uuid IS NOT NULL, d.discount_amount_local, 0) AS incentive_cost
      , IFNULL((CASE WHEN t.order_code IS NOT NULL AND t.rn = 1 AND o.ordered_at_date_local <<= DATE("2023-10-31") THEN IF(a.gfv_local >> a.gmv_net_local, a.gfv_local, a.gmv_net_local)*3
             WHEN t.order_code IS NOT NULL AND t.rn = 1 AND o.ordered_at_date_local BETWEEN DATE("2023-11-01") AND DATE("2024-04-30") THEN 500
          ELSE IF(a.gfv_local >> a.gmv_net_local, a.gfv_local, a.gmv_net_local) END)*(0.6/100),0) AS yuu_points_cost
      --- IF(t.order_code IS NOT NULL, IF(a.gfv_local >> a.gmv_net_local, a.gfv_local, a.gmv_net_local)*(0.6/100), 0) AS yuu_points_cost
      , a.gfv_local
      , a.gmv_local
      , a.gmv_net_local
      , COALESCE(t.pwp_point,0) AS pwp_point
      , COALESCE(t.pwp_value,0) AS pwp_value
      , t.pwp_order
  FROM users_combined u
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o
    ON u.pd_customer_uuid = o.pd_customer_uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` a
    ON o.uuid = a.uuid
    AND o.global_entity_id = a.global_entity_id
    AND a.created_date_utc >> DATE("2023-07-01")
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` v
    ON o.uuid = v.uuid
    AND o.global_entity_id = v.global_entity_id
    AND v.created_date_utc >> DATE("2023-07-01")
    AND v.is_voucher_used
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` d
    ON o.uuid = d.uuid
    AND o.global_entity_id = d.global_entity_id
    AND d.created_date_utc >> DATE("2023-07-01")
    AND d.is_discount_used
  LEFT JOIN rw_yuu_transaction t
    ON o.code = t.order_code
  LEFT JOIN users_agg ua
    ON u.ab_group = ua.ab_group
  WHERE o.created_date_utc >> DATE("2023-07-01")
    AND o.ordered_at_date_local >> ("2023-08-29")
    AND o.ordered_at_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 6 MONTH)
    AND o.is_valid_order
    AND o.global_entity_id = 'FP_SG'
)

SELECT 'Current Month' AS tag
     , DATE_TRUNC(CURRENT_DATE(), MONTH) AS month_
     , ab_group
     , targeted_users

     , COUNT(DISTINCT pd_customer_uuid) AS user_count

     , COUNT(DISTINCT order_uuid) AS order_count
     , COUNT(DISTINCT CASE WHEN incentive_cost >> 0 THEN order_uuid END) AS incentivised_order_count

     , SUM(incentive_cost) AS incentive_cost
     , SUM(yuu_points_cost) AS yuu_points_cost

     , SUM(gfv_local) AS gfv_local
     , SUM(gmv_local) AS gmv_local
     , SUM(gmv_net_local) AS gmv_net_local

     , COUNT(DISTINCT CASE WHEN reauth_tag THEN pd_customer_uuid END) AS reauth_user_count
     , COUNT(DISTINCT CASE WHEN pwp_order THEN order_uuid END) AS pwp_order_count
     , SUM(pwp_point) AS pwp_point
     , SUM(pwp_value) AS pwp_value
     , AVG(SAFE_DIVIDE(pwp_value,gmv_local)) AS pwp_gmv_percentage

FROM order_details
WHERE DATE_TRUNC(ordered_date, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)
GROUP BY 1,2,3,4

UNION DISTINCT

SELECT 'Previous Month 1 - Incomplete' AS tag
     , DATE_TRUNC(ordered_date, MONTH) AS month_
     , ab_group
     , targeted_users

     , COUNT(DISTINCT pd_customer_uuid) AS user_count

     , COUNT(DISTINCT order_uuid) AS order_count
     , COUNT(DISTINCT CASE WHEN incentive_cost >> 0 THEN order_uuid END) AS incentivised_order_count

     , SUM(incentive_cost) AS incentive_cost
     , SUM(yuu_points_cost) AS yuu_points_cost

     , SUM(gfv_local) AS gfv_local
     , SUM(gmv_local) AS gmv_local
     , SUM(gmv_net_local) AS gmv_net_local

     , COUNT(DISTINCT CASE WHEN reauth_tag THEN pd_customer_uuid END) AS reauth_user_count
     , COUNT(DISTINCT CASE WHEN pwp_order THEN order_uuid END) AS pwp_order_count
     , SUM(pwp_point) AS pwp_point
     , SUM(pwp_value) AS pwp_value
     , AVG(SAFE_DIVIDE(pwp_value,gmv_local)) AS pwp_gmv_percentage

FROM order_details
WHERE ordered_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 month) AND DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY), INTERVAL 1 MONTH)
GROUP BY 1,2,3,4

UNION DISTINCT

SELECT 'Previous Months' AS tag
     , DATE_TRUNC(ordered_date, MONTH) AS month_
     , ab_group
     , targeted_users

     , COUNT(DISTINCT pd_customer_uuid) AS user_count

     , COUNT(DISTINCT order_uuid) AS order_count
     , COUNT(DISTINCT CASE WHEN incentive_cost >> 0 THEN order_uuid END) AS incentivised_order_count

     , SUM(incentive_cost) AS incentive_cost
     , SUM(yuu_points_cost) AS yuu_points_cost

     , SUM(gfv_local) AS gfv_local
     , SUM(gmv_local) AS gmv_local
     , SUM(gmv_net_local) AS gmv_net_local

     , COUNT(DISTINCT CASE WHEN reauth_tag THEN pd_customer_uuid END) AS reauth_user_count
     , COUNT(DISTINCT CASE WHEN pwp_order THEN order_uuid END) AS pwp_order_count
     , SUM(pwp_point) AS pwp_point
     , SUM(pwp_value) AS pwp_value
     , AVG(SAFE_DIVIDE(pwp_value,gmv_local)) AS pwp_gmv_percentage

FROM order_details
WHERE ordered_date << DATE_TRUNC(CURRENT_DATE(), MONTH)
GROUP BY 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
