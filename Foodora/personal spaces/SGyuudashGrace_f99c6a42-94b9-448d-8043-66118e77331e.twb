            <column caption='1-((ATTR(IF [ab_group] = &apos;TG - All&apos; THEN [targeted_users] END...' datatype='real' name='[Calculation_5632173581515841560]' role='measure' type='quantitative' user:unnamed='Sheet 41'>
              <calculation class='tableau' formula='1-((ATTR(IF [ab_group] = &apos;TG - All&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [user_count] END))/(ATTR(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;TG - All&apos; THEN [user_count] END)))' />
