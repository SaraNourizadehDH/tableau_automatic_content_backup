      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TG-CG new' name='federated.0suetaz0pqb2rp13ca32x1q0mb9s' />
          </datasources>
          <datasource-dependencies datasource='federated.0suetaz0pqb2rp13ca32x1q0mb9s'>
            <column caption='&apos;CG - TG All&apos;' datatype='string' name='[Calculation_5632173581515653141]' role='dimension' type='nominal' user:unnamed='Sheet 41'>
              <calculation class='tableau' formula='&apos;CG - TG All&apos;' />
            </column>
            <column caption='&apos;&apos;' datatype='string' name='[Calculation_5632173581515911194]' role='dimension' type='nominal' user:unnamed='Sheet 41'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='&apos;CG - TG Participant&apos;' datatype='string' name='[Calculation_5632173581515939868]' role='dimension' type='nominal' user:unnamed='Sheet 41'>
              <calculation class='tableau' formula='&apos;CG - TG Participant&apos;' />
            </column>
            <column caption='&apos;&apos;' datatype='string' name='[Calculation_5632173581516251169]' role='dimension' type='nominal' user:unnamed='Sheet 41'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='&apos;TG Participant - TG Non-Participant&apos;' datatype='string' name='[Calculation_5632173581516259363]' role='dimension' type='nominal' user:unnamed='Sheet 41'>
              <calculation class='tableau' formula='&apos;TG Participant - TG Non-Participant&apos;' />
            </column>
            <column caption='1-((ATTR(IF [ab_group] = &apos;TG - All&apos; THEN [targeted_users] END...' datatype='real' name='[Calculation_5632173581517123626]' role='measure' type='quantitative' user:unnamed='CT Order Uplift New'>
              <calculation class='tableau' formula='1-((ATTR(IF [ab_group] = &apos;TG - All&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [order_count] END))/(ATTR(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;TG - All&apos; THEN [order_count] END)))' />
            </column>
            <column caption='1-((ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN...' datatype='real' name='[Calculation_5632173581517266989]' role='measure' type='quantitative' user:unnamed='CT Order Uplift New'>
              <calculation class='tableau' formula='1-((ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [order_count] END))/(ATTR(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [order_count] END)))' />
            </column>
            <column caption='1-((ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN...' datatype='real' name='[Calculation_5632173581517377583]' role='measure' type='quantitative' user:unnamed='CT Order Uplift New'>
              <calculation class='tableau' formula='1-((ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [order_count] END))/(ATTR(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [order_count] END)))' />
            </column>
            <column datatype='string' name='[ab_group]' role='dimension' type='nominal' />
