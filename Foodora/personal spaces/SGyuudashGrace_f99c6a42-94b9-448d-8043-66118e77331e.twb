    <worksheet name='before-after linking'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontsize='11'>only for users who have before and after orders</run>
            <run>Æ&#10;</run>
            <run fontsize='11'>exclude NC, Reactivated users and users who just linked but have no order yet</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='yuu user behaviour' name='federated.17xt0z70mh241n191sz9o1nwq2io' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month(s) after linking yuu' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;3 Months&quot;'>
              <calculation class='tableau' formula='&quot;3 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17xt0z70mh241n191sz9o1nwq2io'>
            <column caption='window_filter' datatype='boolean' name='[Calculation_6226578351219769347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;1 Month&apos; THEN [N1M_window] &#10;ELSEIF [Parameters].[Parameter 3] = &apos;2 Months&apos; THEN [N2M_window]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;3 Months&apos; THEN [N3M_window] END' />
            </column>
            <column caption='monthly order freq' datatype='real' name='[Calculation_6226578351220727813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_order]/[lifetime_months]' />
            </column>
            <column caption='monthly net gmv / user' datatype='real' name='[Calculation_6226578351222272016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_net]/[lifetime_months]' />
            </column>
            <column caption='monthly cost / user' datatype='real' name='[Calculation_6226578351225487378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost] / [lifetime_months]' />
            </column>
            <column caption='COUNTD(IF [retention_1m] THEN [pd_customer_uuid] END)/COUNTD(...' datatype='real' name='[Calculation_6226578351227543579]' role='measure' type='quantitative' user:unnamed='Sheet 38'>
              <calculation class='tableau' formula='COUNTD(IF [retention_1m] THEN [pd_customer_uuid] END)/COUNTD([pd_customer_uuid])' />
            </column>
            <column caption='perc incentivised order' datatype='real' name='[Calculation_6226578351228141598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[incentivised_order]/[total_order]' />
            </column>
            <column caption='iCPGMV' datatype='real' name='[Calculation_6226578351228727332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost]/[gmv]' />
            </column>
            <column caption='SUM([gfv])/SUM([total_order])' datatype='real' name='[Calculation_6226578351256547367]' role='measure' type='quantitative' user:unnamed='Sheet 38'>
              <calculation class='tableau' formula='SUM([gfv])/SUM([total_order])' />
            </column>
            <column datatype='boolean' name='[N1M_window]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[N2M_window]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[N3M_window]' role='dimension' type='nominal' />
            <column datatype='real' name='[cost]' role='measure' type='quantitative' />
            <column datatype='real' name='[gfv]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_net]' role='measure' type='quantitative' />
            <column datatype='integer' name='[incentivised_order]' role='measure' type='quantitative' />
            <column datatype='integer' name='[lifetime_months]' role='measure' type='quantitative' />
