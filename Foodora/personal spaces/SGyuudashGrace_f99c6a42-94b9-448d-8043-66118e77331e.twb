            <column caption='IFNULL(SUM(IF [yuu voucher redemption].[voucher_type] = &apos;All ...' datatype='real' name='[Calculation_4051480504627015743]' role='measure' type='quantitative' user:unnamed='Cash in &amp; out'>
              <calculation class='tableau' formula='IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_cost] END),0)' />
            </column>
            <column caption='SUM([for_points])*0.6/100 + (SUM([yuu su].[1000_pts_users_tot...' datatype='real' name='[Calculation_4051480504630595654]' role='measure' type='quantitative' user:unnamed='Cash in &amp; out'>
              <calculation class='tableau' formula='SUM([for_points])*0.6/100 + (SUM([federated.19gicqc1i2vhgi11eqc1x0qwlclg].[Calculation_1568448957257338906])*0.1*1000)*0.6/100' />
