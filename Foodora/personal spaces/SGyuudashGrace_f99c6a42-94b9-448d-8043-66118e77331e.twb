                <run bold='true'><![CDATA[<[federated.0nsk4nn0my84fv116zx2k121x1pv].[usr:Calculation_1568448957262868523:qk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#787878'>Base Point (based on Net GMV)	: </run>
