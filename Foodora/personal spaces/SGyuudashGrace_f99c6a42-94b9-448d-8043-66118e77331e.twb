            </column>
            <column caption='COUNTD(IF [retention_1m] THEN [pd_customer_uuid] END)/COUNTD(...' datatype='real' name='[Calculation_6226578351227543579]' role='measure' type='quantitative' user:unnamed='Sheet 38'>
              <calculation class='tableau' formula='COUNTD(IF [retention_1m] THEN [pd_customer_uuid] END)/COUNTD([pd_customer_uuid])' />
            </column>
