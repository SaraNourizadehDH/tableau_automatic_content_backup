            <column caption='IFNULL(SUM(IF [yuu voucher redemption].[voucher_type] = &apos;All ...' datatype='real' name='[Calculation_39054717663797262]' role='measure' type='quantitative' user:unnamed='Cash in &amp; out'>
              <calculation class='tableau' formula='IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[yuu_payment] END),0)' />
            </column>
            <column caption='((SUM([for_points]) + SUM([yuu su].[1000_pts_users_total])*0....' datatype='real' name='[Calculation_4051480504626184246]' role='measure' type='quantitative' user:unnamed='Cash in &amp; out'>
              <calculation class='tableau' formula='((SUM([for_points]) + SUM([federated.19gicqc1i2vhgi11eqc1x0qwlclg].[Calculation_1568448957257338906])*0.1*1000)*0.6/100) + &#10;IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_cost] END),0)' />
            </column>
            <column caption='((SUM([for_points]) + SUM([yuu su].[1000_pts_users_total])*0....' datatype='real' name='[Calculation_4051480504626274359]' role='measure' type='quantitative' user:unnamed='Cash in &amp; out'>
              <calculation class='tableau' formula='((SUM([for_points]) + SUM([federated.19gicqc1i2vhgi11eqc1x0qwlclg].[Calculation_1568448957257338906])*0.1*1000)*0.6/100) + &#10;IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_cost] END),0)' />
            </column>
            <column caption='(SUM([yuu su].[1000_pts_users_total])*0.1*1000)*0.6/100' datatype='real' name='[Calculation_4051480504626810941]' role='measure' type='quantitative' user:unnamed='Cash in &amp; out'>
              <calculation class='tableau' formula='(SUM([federated.19gicqc1i2vhgi11eqc1x0qwlclg].[Calculation_1568448957257338906])*0.1*1000)*0.6/100' />
