      <column caption='Calculation1' datatype='real' name='[Calculation_2262425502448140329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// uplift = tg metric - (cg metric * tg/cg)&#10;// gmv uplfit / cost uplift = &#10;// if a = tg gmv, b = cg gmv, x = tg cost, y = cg cost, t = tg, c = cg&#10;// (a*c - b*t) / (c*x - t*y)&#10;// (tg gmv*cg - cg gmv*tg) / (tg cost*cg - cg cost * tg)&#10;&#10;//1-((ATTR(IF [ab_group] = &apos;TG - All&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [gmv_local] END))/(ATTR(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;TG - All&apos; THEN [gmv_local] END)))&#10;&#10;// CG to TG - Non-Participant &amp; yuu Enable&#10;IF &#10;((SUM(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [gmv_local] END)*ATTR(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [targeted_users] END)) - &#10;(SUM(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [gmv_local] END)*ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [targeted_users] END))) &lt; 0 THEN 0&#10;ELSE&#10;((SUM(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [gmv_local] END)*ATTR(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [targeted_users] END)) - &#10;(SUM(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [gmv_local] END)*ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [targeted_users] END))) / &#10;((SUM(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [incentive_cost]+[yuu_points_cost] END) *ATTR(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [targeted_users] END)) - &#10;(SUM(IF [ab_group] = &apos;TG - Non-Participant &amp; yuu Enable&apos; THEN [incentive_cost]+[yuu_points_cost] END)*ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [targeted_users] END)))&#10;END' />
      </column>
      <column caption='date_filter' datatype='boolean' name='[Calculation_5632173581501399042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = DATETRUNC(&apos;month&apos;,TODAY()) AND ([tag] = &apos;Current Month&apos; OR [tag] = &apos;Previous Month 1 - Incomplete&apos;) THEN TRUE &#10;ELSEIF [Parameters].[Parameter 4] &lt; DATETRUNC(&apos;month&apos;,TODAY()) AND [tag] = &apos;Previous Months&apos; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='CM &amp; PM Filter' datatype='boolean' name='[Calculation_5632173581502173188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [month_] = [Month] OR [month_] = DATEADD(&apos;month&apos;, -1,[month_]) THEN TRUE ELSE FALSE END&#10;&#10;//([ordered_date] &gt;= [Current Month - Start] AND [ordered_date] &lt;= [Current Month - End]) OR &#10;//([ordered_date] &gt;= DATEADD(&apos;month&apos;,-1,[Current Month - Start]) AND&#10;// [ordered_date] &lt;= DATEADD(&apos;month&apos;,-1,[Current Month - End]))&#10;&#10;([month_] = [Parameters].[Parameter 4]) OR &#10;([month_] = DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 4]))' />
      </column>
      <column caption='Comparison Tag' datatype='string' name='[Calculation_5632173581522096202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([month_] = [Parameters].[Parameter 4]) THEN &apos;Current Month&apos;&#10;ELSEIF ([month_] = DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 4])) THEN &apos;Previous Month&apos; &#10;ELSE &apos;Exclude&apos; END' />
      </column>
