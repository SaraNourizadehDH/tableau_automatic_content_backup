    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='README'>
      <repository-location derived-from='http://ip-172-31-0-158:8054/t/Foodora/workbooks/SGyuudash-Grace/README?rev=' id='README' path='/t/Foodora/workbooks/SGyuudash-Grace' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_43' value='left' />
          <format attr='vertical-align' id='dash-text_43' value='top' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='44' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='92000' id='43' type-v2='text' w='98400' x='800' y='7000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>BURN (fp pays)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>FIRST TRANSACTION CAMPAIGN</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>- </run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>September 2023 - October 2023</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: 3x yuu points, subsequent orders at 1x</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>-</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'> November 2023 - April 2024</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: 500 yuu points</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>- </run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>May 2024 - September 2024</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: 1 point per dollar spent</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>- </run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>October 2024 - March 2025</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: 1000 bonus yuu points for users who clicked booster on yuu app </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>SUBSEQUENT TRANSACTION (fp-funded)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>1 point per dollar spent</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>- </run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>12 - 18 August 2024</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: 3x yuu points on OD on Guzman Y Gomez</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>- </run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>16 September - 13 October 2024</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: 3x yuu points on OD/PU on selected vendors</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>- </run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>6 January - 5 February 2025</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: Bonus 188 yuu points on each of the first 3 orders when paid with DBS yuu card</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>COST CALCULATION</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>0.6% of gfv_local OR gmv_net_local, whichever is lower</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>- foodpanda pays for every order (</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>including</run>
              <run fontcolor='#1d1c1d' fontsize='10'> DFI vendors)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>EARN</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1d1c1d' fontsize='10'>When a user redeems a voucher on yuu app and uses it on our app, we get 0.5% per point</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Metric Glossary</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Reorder User</run>
              <run fontcolor='#000000' fontsize='10'>: User who make another order after their first yuu point earned transaction</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Reactivated Users</run>
              <run fontcolor='#000000' fontsize='10'>: Users with no transactions in L90D but have placed an order within the campaign period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='10'>Nett Spend</run>
              <run fontcolor='#1d1c1d' fontsize='10'>: yuu payment of redeemed vouchers - voucher cost - total cost/point</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>CG Users</run>
              <run fontcolor='#ffffff' fontsize='10'>: Holdout group set by product (i.e. users will not be able to link their yuu IDs)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>TG - All</run>
              <run fontcolor='#ffffff' fontsize='10'>: Non-holdout group users visiting the app/website with yuu app version after yuu program was released (5th September onwards)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>TG Participant</run>
              <run fontcolor='#ffffff' fontsize='10'>: Users part of TG-All who have linked their yuu IDs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>TG Non-participant</run>
              <run fontcolor='#ffffff' fontsize='10'>: Users part of TG-All who have NOT linked their yuu IDs</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='6000' id='45' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='15'>README</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#e6e6e6' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
