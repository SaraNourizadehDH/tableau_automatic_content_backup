    <datasource caption='yuu su' inline='true' name='federated.19gicqc1i2vhgi11eqc1x0qwlclg' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.01x9cvm11qedjh12oghyt0qvyn9d'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - SG' schema='pandata_sg' server-oauth='' username='cheryl.yeo@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.01x9cvm11qedjh12oghyt0qvyn9d' name='Custom SQL Query' type='text'><![CDATA[-- SELECT * FROM `fulfillment-dwh-production.pandata_report.country_SG_yuu_dash_signup`

WITH unlinked_yuu_users AS (
  SELECT DISTINCT CONCAT(ARRAY_REVERSE(SPLIT(string_field_0, "_"))[OFFSET(0)], "_", "FP_SG") as rw_yuu_customer_uuid
       , string_field_0 as external_id
       , c.code as customer_code
  FROM `foodpanda-sg-bigquery.pandata_report.SG_multiple_yuu_accounts` y
  LEFT JOIN fulfillment-dwh-production.pandata_curated.cus_customers c
    ON CONCAT(ARRAY_REVERSE(SPLIT(y.string_field_0, "_"))[OFFSET(0)], "_", "FP_SG") = c.uuid
),

yuu_users AS (
  SELECT DISTINCT CASE WHEN u.customer_code IS NOT NULL THEN DATE(DATETIME_ADD(c.created_at_utc, INTERVAL 8 HOUR)) 
                    ELSE COALESCE(DATE(DATETIME_ADD(y.created_at_utc, INTERVAL 8 HOUR)), DATE(DATETIME_ADD(c.created_at_utc, INTERVAL 8 HOUR))) END AS ordered_date
       , SPLIT(c.pk, "#")[1] AS customer_code
       , COALESCE(LOWER(JSON_VALUE(c.data.link_status)) LIKE "%oauth%", FALSE) AS reauth_tag
       , u.customer_code IS NOT NULL AS multiple_yuu_id
  FROM `fulfillment-dwh-production.pandata_curated.cus_profile_metadata` c
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.rw_yuu_customer` y 
    ON SPLIT(c.pk, "#")[1] = y.customer_code
    AND SPLIT(c.sk, "#")[3] = y.rw_yuu_id 
    AND c.global_entity_id = y.global_entity_id
    AND y.created_date_utc >>= DATE("2023-08-01")
  LEFT JOIN unlinked_yuu_users u
    ON SPLIT(c.pk, "#")[1] = u.customer_code
  WHERE c.global_entity_id = 'FP_SG'
    AND c.created_at_utc IS NOT NULL
    AND NOT c.is_deleted
)

SELECT 'Daily' AS granularity
     , ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3

UNION DISTINCT

SELECT 'Weekly' AS granularity
     , DATE_TRUNC(ordered_date, WEEK(MONDAY)) AS ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3

UNION DISTINCT

SELECT 'Monthly' AS granularity
     , DATE_TRUNC(ordered_date, MONTH) AS ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3

UNION DISTINCT

SELECT 'To Date' AS granularity
     , CURRENT_DATE() AS ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.01x9cvm11qedjh12oghyt0qvyn9d' name='Custom SQL Query' type='text'><![CDATA[-- SELECT * FROM `fulfillment-dwh-production.pandata_report.country_SG_yuu_dash_signup`

WITH unlinked_yuu_users AS (
  SELECT DISTINCT CONCAT(ARRAY_REVERSE(SPLIT(string_field_0, "_"))[OFFSET(0)], "_", "FP_SG") as rw_yuu_customer_uuid
       , string_field_0 as external_id
       , c.code as customer_code
  FROM `foodpanda-sg-bigquery.pandata_report.SG_multiple_yuu_accounts` y
  LEFT JOIN fulfillment-dwh-production.pandata_curated.cus_customers c
    ON CONCAT(ARRAY_REVERSE(SPLIT(y.string_field_0, "_"))[OFFSET(0)], "_", "FP_SG") = c.uuid
),

yuu_users AS (
  SELECT DISTINCT CASE WHEN u.customer_code IS NOT NULL THEN DATE(DATETIME_ADD(c.created_at_utc, INTERVAL 8 HOUR)) 
                    ELSE COALESCE(DATE(DATETIME_ADD(y.created_at_utc, INTERVAL 8 HOUR)), DATE(DATETIME_ADD(c.created_at_utc, INTERVAL 8 HOUR))) END AS ordered_date
       , SPLIT(c.pk, "#")[1] AS customer_code
       , COALESCE(LOWER(JSON_VALUE(c.data.link_status)) LIKE "%oauth%", FALSE) AS reauth_tag
       , u.customer_code IS NOT NULL AS multiple_yuu_id
  FROM `fulfillment-dwh-production.pandata_curated.cus_profile_metadata` c
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.rw_yuu_customer` y 
    ON SPLIT(c.pk, "#")[1] = y.customer_code
    AND SPLIT(c.sk, "#")[3] = y.rw_yuu_id 
    AND c.global_entity_id = y.global_entity_id
    AND y.created_date_utc >>= DATE("2023-08-01")
  LEFT JOIN unlinked_yuu_users u
    ON SPLIT(c.pk, "#")[1] = u.customer_code
  WHERE c.global_entity_id = 'FP_SG'
    AND c.created_at_utc IS NOT NULL
    AND NOT c.is_deleted
)

SELECT 'Daily' AS granularity
     , ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3

UNION DISTINCT

SELECT 'Weekly' AS granularity
     , DATE_TRUNC(ordered_date, WEEK(MONDAY)) AS ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3

UNION DISTINCT

SELECT 'Monthly' AS granularity
     , DATE_TRUNC(ordered_date, MONTH) AS ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3

UNION DISTINCT

SELECT 'To Date' AS granularity
     , CURRENT_DATE() AS ordered_date
     , CASE WHEN ordered_date << DATE("2024-08-06") THEN 'Legacy Linked' ELSE 'New customers' END AS phase_tag
     , COUNT(DISTINCT customer_code) AS su_users
     , COUNT(DISTINCT CASE WHEN reauth_tag THEN customer_code END) AS reauth_users
     , COUNT(DISTINCT CASE WHEN multiple_yuu_id THEN customer_code END) AS relink_users
FROM yuu_users
GROUP BY 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
