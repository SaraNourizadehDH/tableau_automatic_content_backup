          <datasource-dependencies datasource='federated.17xt0z70mh241n191sz9o1nwq2io'>
            <column caption='window_filter' datatype='boolean' name='[Calculation_6226578351219769347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;1 Month&apos; THEN [N1M_window] &#10;ELSEIF [Parameters].[Parameter 3] = &apos;2 Months&apos; THEN [N2M_window]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;3 Months&apos; THEN [N3M_window] END' />
            </column>
            <column caption='monthly order freq' datatype='real' name='[Calculation_6226578351220727813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_order]/[lifetime_months]' />
            </column>
            <column caption='monthly net gmv / user' datatype='real' name='[Calculation_6226578351222272016]' role='measure' type='quantitative'>
