              <calculation class='tableau' formula='1-((ATTR(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [user_count] END))/(ATTR(IF [ab_group] = &apos;CG - Participant &amp; yuu Disable&apos; THEN [targeted_users] END)*SUM(IF [ab_group] = &apos;TG - Participant &amp; yuu Enable&apos; THEN [user_count] END)))' />
