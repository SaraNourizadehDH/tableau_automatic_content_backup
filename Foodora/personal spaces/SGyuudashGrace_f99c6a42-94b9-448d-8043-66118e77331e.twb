            <column-instance column='[Calculation_2802927876674924550]' derivation='User' name='[usr:Calculation_2802927876674924550:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19gicqc1i2vhgi11eqc1x0qwlclg'>
            <column caption='1000_pts_users_total' datatype='integer' name='[Calculation_1568448957257338906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2024-10-01&quot;)) OR &#10;   ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2024-10-01&quot;)) OR &#10;   ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2024-09-30&quot;)) THEN 28620&#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2024-11-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2024-11-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2024-10-28&quot;)) THEN 17420&#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2024-12-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2024-12-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2024-11-25&quot;)) THEN 23990&#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2025-01-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2025-01-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2024-12-30&quot;)) THEN 19780&#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2025-02-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2025-02-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2025-01-27&quot;)) THEN 22710&#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2025-03-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2025-03-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2025-02-24&quot;)) THEN 41680&#10;       &#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2025-04-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2025-04-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2025-03-31&quot;)) THEN 46590&#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2025-05-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2025-05-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2025-04-28&quot;)) THEN 42290&#10;ELSEIF ([granularity] = &apos;Monthly&apos; AND [ordered_date] = DATE(&quot;2025-06-01&quot;)) OR &#10;       ([granularity] = &apos;Daily&apos; AND [ordered_date] = DATE(&quot;2025-06-01&quot;)) OR &#10;       ([granularity] = &apos;Weekly&apos; AND [ordered_date] = DATE(&quot;2025-05-26&quot;)) THEN 41800           &#10;ELSEIF [ordered_date] &gt;= DATE(&quot;2025-07-01&quot;) AND [ordered_date] &lt;= DATE(&quot;2025-09-30&quot;) THEN [su_users]&#10;ELSE 0 END' />
            </column>
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column datatype='date' name='[ordered_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[su_users]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0nsk4nn0my84fv116zx2k121x1pv].[none:granularity:nk]'>
            <groupfilter function='member' level='[none:granularity:nk]' member='&quot;Daily&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.0nsk4nn0my84fv116zx2k121x1pv].[none:ordered_date:qk]' included-values='in-range'>
            <min>#2023-09-01#</min>
          </filter>
          <filter class='categorical' column='[federated.0nsk4nn0my84fv116zx2k121x1pv].[none:user_tag:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:user_tag:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:user_tag:nk]' member='&quot;No Order&quot;' />
