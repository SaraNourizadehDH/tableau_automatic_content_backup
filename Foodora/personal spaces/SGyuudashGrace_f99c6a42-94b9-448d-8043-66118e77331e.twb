            <column-instance column='[Calculation_5632173581517266989]' derivation='User' name='[usr:Calculation_5632173581517266989:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5632173581517377583]' derivation='User' name='[usr:Calculation_5632173581517377583:qk]' pivot='key' type='quantitative' />
