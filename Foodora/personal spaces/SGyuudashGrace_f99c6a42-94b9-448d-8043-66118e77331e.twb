              <calculation class='tableau' formula='IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_cost]*-1 END),0)' />
