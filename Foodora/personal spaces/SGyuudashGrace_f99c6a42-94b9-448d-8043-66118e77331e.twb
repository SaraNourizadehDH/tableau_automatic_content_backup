            <column caption='IFNULL(SUM(IF [yuu voucher redemption].[voucher_type] = &apos;All ...' datatype='real' name='[Calculation_6016457297291612184]' role='measure' type='quantitative' user:unnamed='Cash in &amp; out'>
              <calculation class='tableau' formula='IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[yuu_payment] END),0)' />
            </column>
            <column caption='SUM([yuu voucher redemption].[voucher_cost])*-1' datatype='real' name='[Calculation_6226507962622509229]' role='measure' type='quantitative' user:unnamed='Cost Table'>
