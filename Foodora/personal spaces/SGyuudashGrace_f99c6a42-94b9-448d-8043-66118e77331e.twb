      <column caption='Calculation3' datatype='real' name='[Calculation_1568448957263568945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// (SUM([for_points]) + SUM([yuu su].[1000_pts_users_total])*0.1*1000)&#10;// (SUM([for_points]) + SUM([yuu su].[1000_pts_users_total])*0.1*1000)*0.6/100*-1' />
      </column>
      <column caption='comparison_df' datatype='boolean' name='[Calculation_326018459121209458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;,DATE(TODAY())), DATEADD(&apos;day&apos;,-1,DATE(TODAY())))&#10;//DATEADD(&apos;day&apos;,-1,DATE(TODAY()))&#10;// so we get the first day of the month of ordered date + whatever is above as end date&#10;// if the ordered date falls between first day of the ordered date and first day + whatever is above, then true&#10;&#10;[ordered_date] &gt;= DATETRUNC(&apos;month&apos;,[ordered_date]) AND &#10;[ordered_date] &lt;= DATEADD(&apos;day&apos;,DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;,DATE(TODAY())), DATEADD(&apos;day&apos;,-1,DATE(TODAY()))),DATETRUNC(&apos;month&apos;,[ordered_date]))' />
      </column>
      <column caption='Blank Row - PWP' datatype='integer' name='[Calculation_39054717659521031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Calculation4' datatype='real' name='[Calculation_4051480504629350468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([for_points]) + SUM([federated.19gicqc1i2vhgi11eqc1x0qwlclg].[Calculation_1568448957257338906])*0.1*1000)*0.6/100 + IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_cost] END),0)' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_4229794854392610837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([for_points]*0.6/100*-1) + &#10;IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_cost]*-1 END),0) + &#10;IFNULL(SUM(IF [federated.09pssx0161dnuj114ea0f05luyk2].[voucher_type] = &apos;All Voucher&apos; THEN [federated.09pssx0161dnuj114ea0f05luyk2].[yuu_payment] END),0)' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_4229794854427422813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 2] = &apos;All Time&apos; THEN [reorder_user]&#10;    ELSEIF [Parameters].[Parameter 2] = &apos;14D&apos; THEN [reorder_14D_user]&#10;    ELSEIF [Parameters].[Parameter 2] = &apos;30D&apos; THEN [reorder_30D_user] END)' />
      </column>
