              <zone forceUpdate='true' h='3334' id='173' type-v2='text' w='98858' x='571' y='69217'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='14' italic='true'>yuu</run>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='14'> USER BEHAVIOUR BEFORE VS AFTER LINKING </run>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='14' italic='true'>yuu</run>
                  <run fontalignment='1'>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#e6e6e6' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='3164' id='177' name='before-after linking' param='[federated.17xt0z70mh241n191sz9o1nwq2io].[none:linking_date:qk]' show-domain='false' show-null-ctrls='false' type-v2='filter' w='43714' x='10138' y='79778'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='3164' id='178' mode='compact' param='[Parameters].[Parameter 3]' type-v2='paramctrl' w='45577' x='53852' y='79778'>
                <formatted-text>
                  <run>Month(s) after linking yuu</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='7227' id='180' type-v2='text' w='98858' x='571' y='72551'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#333333' underline='true'>only</run>
                  <run fontalignment='1' fontcolor='#333333'> taking users who </run>
                  <run bold='true' fontalignment='1' fontcolor='#333333' underline='true'>have before and after orders</run>
                  <run fontalignment='1' fontcolor='#333333'>;</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#333333'>excluding NCs, Reactivated users and users who just linked but have not placed order yet</run>
                  <run fontalignment='1'>Æ&#10;&#10;</run>
                  <run fontalignment='1' fontcolor='#333333'>past behaviour is the average of 3M window period</run>
                  <run fontalignment='1'>Æ&#10;&#10;</run>
                  <run fontalignment='1' fontcolor='#1d1c1d'>Analysing user behavior over a </run>
                  <run fontalignment='1' fontcolor='#1d1c1d' underline='true'>longer period</run>
                  <run fontalignment='1' fontcolor='#1d1c1d'> provides a </run>
                  <run fontalignment='1' fontcolor='#1d1c1d' underline='true'>broader view</run>
                  <run fontalignment='1' fontcolor='#1d1c1d'> and reveals changes not evident in shorter timeframes.</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#1d1c1d'>Comparing 3 months before to 1 month after and 3 months before to over 1 month after shows these differences.</run>
                  <run fontalignment='1'>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='3164' id='182' type-v2='text' w='9567' x='571' y='79778'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>   PARAMETERS</run>
                </formatted-text>
                <zone-style>
