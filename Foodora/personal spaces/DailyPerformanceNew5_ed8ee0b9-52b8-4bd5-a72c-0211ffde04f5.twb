            <column caption='AFV MTD vs LYMTD (Indicator)' datatype='string' name='[AFV MTD vs PMTD (Indicator) (copy)_3688870375761883163]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([PMTD (copy)_128141502928715882], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0))) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='AFV MTD vs LYMTD' datatype='string' name='[AFV MTD vs PMTD (copy)_3688870375759888409]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([PMTD (copy)_128141502928715882], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0))) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    (SUM(iif([PMTD (copy)_128141502928715882], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0)))&#10;* 100&#10;,1)&#10;)' />
