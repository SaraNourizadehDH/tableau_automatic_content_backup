    <worksheet name='WTD AFV Growth'>
      <repository-location id='WTDAFVGrowth' path='/t/Foodora/workbooks/DailyPerformancetimecomparisons' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='1 WTD Growth' datatype='integer' name='[1 MTD Growth (copy)_382172716289941513]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WTD WoW' />
              </aliases>
            </column>
            <column caption='AFV WTD vs PWTD' datatype='string' name='[AFV MTD vs LYMTD (copy)_3688870375764226076]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([MTD (copy 2)_382172716287561733], [total_gfv_eur], 0)) / SUM(iif([MTD (copy 2)_382172716287561733], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0))) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    (SUM(iif([MTD (copy 2)_382172716287561733], [total_gfv_eur], 0)) / SUM(iif([MTD (copy 2)_382172716287561733], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;* 100&#10;,1)&#10;)' />
            </column>
            <column caption='AFV WTD vs PWTD (Indicator)' datatype='string' name='[AFV MTD vs PMTD (Indicator) (copy)_3688870375765762077]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([MTD (copy 2)_382172716287561733], [total_gfv_eur], 0)) / SUM(iif([MTD (copy 2)_382172716287561733], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0))) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='WTD' datatype='boolean' name='[MTD (copy 2)_382172716287561733]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;,[reference_date_local]) = DATETRUNC(&apos;iso-week&apos;,{ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='PWTD' datatype='boolean' name='[PMTD (copy)_382172716287787014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF ISOWEEK([reference_date_local]) = ISOWEEK(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;//AND [reference_date_local] &lt;= DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])})&#10;//AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;//THEN TRUE&#10;//END&#10;&#10;IF ISOWEEK([reference_date_local]) = ISOWEEK(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])})&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &gt;= DATEADD(&apos;week&apos;, -1, DATE(DATETRUNC(&apos;week&apos;, {MAX([reference_date_local])})))&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column-instance column='[1 MTD Growth (copy)_382172716289941513]' derivation='None' name='[none:1 MTD Growth (copy)_382172716289941513:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[reference_date_local]' role='dimension' type='ordinal' />
            <column datatype='real' name='[total_gfv_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_number_of_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[AFV MTD vs LYMTD (copy)_3688870375764226076]' derivation='User' name='[usr:AFV MTD vs LYMTD (copy)_3688870375764226076:nk]' pivot='key' type='nominal' />
            <column-instance column='[AFV MTD vs PMTD (Indicator) (copy)_3688870375765762077]' derivation='User' name='[usr:AFV MTD vs PMTD (Indicator) (copy)_3688870375765762077:nk]' pivot='key' type='nominal' />
