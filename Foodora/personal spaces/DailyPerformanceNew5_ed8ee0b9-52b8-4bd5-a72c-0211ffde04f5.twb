              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='avg DF MTD' datatype='real' name='[DF MTD (copy)_1606025851078340611]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(iif([PMTD (copy)_128141502928715882], [od_df_user_paid_incl_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_delivery_priority_fee_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_service_fee_plus_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_minimum_delivery_value_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[PMTD (copy)_383861552113147904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})) &#10;    AND day([reference_date_local]) &lt;= day({ FIXED : [Calculation_127719338234654730]})&#10;    AND month([reference_date_local]) &lt;= month({ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='avg DF LY MTD' datatype='real' name='[avg DF MTD (copy 2)_3688870375749935118]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(iif([PMTD (copy)_383861552113147904], [od_df_user_paid_incl_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_383861552113147904], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_383861552113147904], [od_delivery_priority_fee_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_383861552113147904], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_383861552113147904], [od_service_fee_plus_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_383861552113147904], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_383861552113147904], [od_minimum_delivery_value_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_383861552113147904], od_successful_orders, 0)))' />
            </column>
