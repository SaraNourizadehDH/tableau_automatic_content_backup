          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='%LO Per Day Close' datatype='real' name='[%LO Per Day Shrink (copy)_1635580774562861063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [reference_date_local], [country_name]:&#10;SUM([lost_order_close_sum]) / (SUM([lost_order_total_sum]) + SUM([od_successful_orders]))}' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
