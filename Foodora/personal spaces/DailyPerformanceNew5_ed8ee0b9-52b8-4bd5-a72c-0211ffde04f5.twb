            </column>
            <column caption='W1 Order Late 20 Rate %' datatype='string' name='[W1 Order Late Rate % (copy)_5463781141783150605]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;((SUM(IF [L1W (copy 2)] THEN [order_delay_over_20_min_count] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [order_delay_cnt] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [order_delay_over_20_min_count] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [order_delay_cnt] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [order_delay_over_20_min_count] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [order_delay_cnt] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ &#10;STR(&#10;ROUND(&#10;&#10;((SUM(IF [L1W (copy 2)] THEN [order_delay_over_20_min_count] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [order_delay_cnt] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [order_delay_over_20_min_count] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [order_delay_cnt] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [order_delay_over_20_min_count] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [order_delay_cnt] ELSE 0 END)) &#10;&#10;* 100&#10;, 1)&#10;)' />
