    <worksheet name='od_Fail Rate LW Growth Bottom Country (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>Lowest Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='W1 Failed Rate %' datatype='string' name='[W1 DT % (copy 2)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;((SUM(IF [L1W (copy 2)] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_orders] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_orders] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_orders] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ &#10;STR(&#10;ROUND(&#10;&#10;((SUM(IF [L1W (copy 2)] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_orders] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_orders] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_orders] ELSE 0 END)) &#10;&#10;* 100&#10;, 1)&#10;)' />
            </column>
            <column caption='W1 Failed Rate % (Ranking) ' datatype='real' name='[W1 Failed Rate % (Indicator) (copy 2)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='((SUM(IF [L1W (copy 2)] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_orders] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_orders] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_failed_orders] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_orders] ELSE 0 END))' />
