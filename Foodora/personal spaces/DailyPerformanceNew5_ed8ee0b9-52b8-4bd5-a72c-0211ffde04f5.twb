        <style>
          <style-rule element='cell'>
            <format attr='width' value='260' />
            <format attr='height' value='75' />
            <format attr='text-align' value='left' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='color' value='#d80b63' />
            <format attr='font-size' value='28' />
