                <alias key='1' value='Current Month RR' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='1 Revenue' datatype='integer' name='[1 Runrate (copy)_334673814919262213]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Current Month RR' />
              </aliases>
            </column>
            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission_revenue_eur]+ [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]' />
            </column>
            <column caption='Days in Month' datatype='integer' name='[Calculation_2662964453198508033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,today()))))' />
            </column>
            <column caption='Within Last 21 days' datatype='boolean' name='[Calculation_2662964453460332558]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF DAY(TODAY()) = 1 AND MONTH([placed_date]) = MONTH(TODAY()-1) THEN null&#10;//ELSE&#10;[reference_date_local] &lt;= TODAY()-1&#10;AND&#10;[reference_date_local] &gt;= TODAY()-21&#10;//END' />
            </column>
            <column caption='Revenue RR' datatype='real' name='[GMV RR (copy)_334673814897410048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0))&#10;+ SUM(iif([Calculation_2662964453460332558], [Calculation_128141504822948034], 0))&#10;/ 21&#10;* ([Calculation_2662964453198508033] - DAY(TODAY()-2))' />
            </column>
            <column caption='MTD (-1)' datatype='boolean' name='[MTD (copy)_128141504139079806]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], { FIXED : [Calculation_127719338234654730]} - 1) = 0&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY({ FIXED : [Calculation_127719338234654730]}-1)' />
            </column>
