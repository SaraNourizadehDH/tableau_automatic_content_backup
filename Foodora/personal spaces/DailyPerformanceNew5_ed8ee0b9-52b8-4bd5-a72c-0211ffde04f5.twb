            <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_6149806036921335808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [reference_date_local] &lt; DATEADD(&apos;day&apos;, -6, {fixed:MIN([Calculation_378794978106404864])})&#10;THEN DATEADD(&apos;day&apos;, 7, [reference_date_local])&#10;ELSE [reference_date_local]&#10;END' />
