              <calculation class='tableau' formula='IF (SUM(IF [L1W (copy 2)] THEN [od_delivery_fee_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [od_delivery_fee_eur_cnt] ELSE 0 END)&#10;- SUM(IF [Calculation_6180416436320313347] THEN [od_delivery_fee_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [od_delivery_fee_eur_cnt] ELSE 0 END))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [od_delivery_fee_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [od_delivery_fee_eur_cnt] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
