            </column>
            <column caption='PWTD (-1)' datatype='boolean' name='[PWTD (copy)_3688870375743332359]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK([reference_date_local]) = ISOWEEK(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])} - 1))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])} - 1)&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])} - 1))&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Revenue WTD vs PWTD (Indicator)' datatype='string' name='[Revenue MTD vs PMTD (Indicator) (copy)_3688870375743991817]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([WTD (copy)_3688870375743221766], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PWTD (copy)_3688870375743332359], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PWTD (copy)_3688870375743332359], [Calculation_128141504822948034], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Revenue WTD vs PWTD' datatype='string' name='[Revenue MTD vs PMTD (copy)_3688870375743602696]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([WTD (copy)_3688870375743221766], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PWTD (copy)_3688870375743332359], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PWTD (copy)_3688870375743332359], [Calculation_128141504822948034], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([WTD (copy)_3688870375743221766], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PWTD (copy)_3688870375743332359], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PWTD (copy)_3688870375743332359], [Calculation_128141504822948034], 0)&#10;) * 100&#10;,1)&#10;)' />
            </column>
            <column caption='WTD (-1)' datatype='boolean' name='[WTD (copy)_3688870375743221766]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;,[reference_date_local]) = DATETRUNC(&apos;iso-week&apos;,{ FIXED : [Calculation_127719338234654730]} - 1)' />
            </column>
