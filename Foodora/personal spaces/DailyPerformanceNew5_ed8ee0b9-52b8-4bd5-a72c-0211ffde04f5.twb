    <worksheet name='Yesterday&apos;s UTR'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='22'>UTR</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'>(successful orders per worked hours)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='UTR' datatype='real' name='[avg DF (copy)_4261038569719820292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_completed_sum]) / sum([worked_hours])' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[L1W (copy 2)]' derivation='None' name='[none:L1W (copy 2):nk]' pivot='key' type='nominal' />
