    <worksheet name='AFV LW Growth Top Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>Top Growth        LastD WoW %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='W1 AFV % (Indicator)' datatype='string' name='[W1 AFV % (copy)_5401364105256488968]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;- ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;/ &#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 AFV % (Ranking)' datatype='real' name='[W1 AFV % (copy)_5401364105257324553]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;- ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;/ &#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2)' />
            </column>
            <column caption='W1 AFV %' datatype='string' name='[W1 GMV % (copy 3)_5401364105255792647]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF&#10;(&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;- ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;/ &#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;//IF SUM(IF [Yesterday] THEN [total_gfv_eur] ELSE 0 END) - SUM(IF [L1W] THEN [total_gfv_eur] ELSE 0 END) &gt;= 0&#10;//THEN &#10;(&#10;    ROUND(SUM(IF [L1W (copy 2)] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;    - ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;    / &#10;    ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;//ELSE&#10;//    SUM(IF [L1W] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_gfv_eur] ELSE 0 END)&#10;//END &#10;* 100, 1))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
              </aliases>
            </column>
