              <calculation class='tableau' formula='if &#10;&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([MTD last year (copy)_2210845258111135747], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([MTD last year (copy)_2210845258111135747], [Calculation_128141504822948034], 0)&#10;) &gt;= 5 THEN null ELSE&#10;&#10;(if&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([MTD last year (copy)_2210845258111135747], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([MTD last year (copy)_2210845258111135747], [Calculation_128141504822948034], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([MTD last year (copy)_2210845258111135747], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([MTD last year (copy)_2210845258111135747], [Calculation_128141504822948034], 0)&#10;) * 100&#10;,1)&#10;)) end' />
