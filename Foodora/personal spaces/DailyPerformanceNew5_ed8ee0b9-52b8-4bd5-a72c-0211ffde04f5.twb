              <calculation class='tableau' formula='SUM(iif([Previous L30D (copy)_128141502928400489], [orders_completed_sum], 0))&#10;/&#10;SUM(IF [Previous L30D (copy)_128141502928400489]&#10;THEN ([worked_hours])&#10;ELSE 0&#10;END)' />
