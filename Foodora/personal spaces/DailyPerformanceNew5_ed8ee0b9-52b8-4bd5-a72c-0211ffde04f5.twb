      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Hours worked yesterday' datatype='real' name='[Calculation_2718626066435383301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [L1W (copy 2)]&#10;THEN ([worked_hours])&#10;ELSE 0&#10;END)' />
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Hours worked L1W' datatype='real' name='[Hours worked yesterday (copy)_2718626066438901767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Calculation_6180416436320313347]&#10;THEN ([worked_hours])&#10;ELSE 0&#10;END)' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='W1 UTR % (Indicator)' datatype='string' name='[W1 avg DF % (Indicator) (copy)_4261038569719820304]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [L1W (copy 2)] THEN [successful_orders_od] ELSE 0 END) / SUM([Calculation_2718626066435383301])&#10;- SUM(IF [Calculation_6180416436320313347] THEN [successful_orders_od] ELSE 0 END) / SUM([Hours worked yesterday (copy)_2718626066438901767]))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [successful_orders_od] ELSE 0 END) / SUM([Hours worked yesterday (copy)_2718626066438901767])) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 UTR % (Ranking)' datatype='real' name='[W1 avg DF % (Ranking) (copy)_4261038569719820305]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(IF [L1W (copy 2)] THEN [successful_orders_od] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [hours_worked] ELSE 0 END)&#10;- SUM(IF [Calculation_6180416436320313347] THEN [successful_orders_od] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [hours_worked] ELSE 0 END))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [successful_orders_od] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [hours_worked] ELSE 0 END))' />
            </column>
            <column caption='W1 UTR %' datatype='string' name='[W1 avg DF % (copy)_4261038569719820306]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [L1W (copy 2)] THEN [orders_completed_sum] ELSE 0 END) / SUM([Calculation_2718626066435383301])&#10;- SUM(IF [Calculation_6180416436320313347] THEN [orders_completed_sum] ELSE 0 END) / SUM([Hours worked yesterday (copy)_2718626066438901767]))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [orders_completed_sum] ELSE 0 END) / SUM([Hours worked yesterday (copy)_2718626066438901767])) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND( &#10;   (SUM(IF [L1W (copy 2)] THEN [orders_completed_sum] ELSE 0 END) / SUM([Calculation_2718626066435383301])&#10;- SUM(IF [Calculation_6180416436320313347] THEN [orders_completed_sum] ELSE 0 END) / SUM([Hours worked yesterday (copy)_2718626066438901767]))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [orders_completed_sum] ELSE 0 END) / SUM([Hours worked yesterday (copy)_2718626066438901767]))&#10;* 100, 1))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Hours Worked' datatype='real' name='[hours_worked]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
