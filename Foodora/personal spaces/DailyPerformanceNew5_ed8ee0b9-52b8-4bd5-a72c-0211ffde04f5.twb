      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='AFV WoW Main (Negative)' datatype='string' name='[GMV WoW Main (Negative) (copy)_45739685146566668]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / [L7D GMV Main (copy)_45739685137666059] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / [L7D GMV Main (copy)_45739685137666059] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / [L7D GMV Main (copy)_45739685137666059] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='AFV WoW Main (Positive)' datatype='string' name='[GMV WoW Main (Positive) (copy)_45739685146812429]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / iif([L7D GMV Main (copy)_45739685137666059] = 0, 1, [L7D GMV Main (copy)_45739685137666059]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / iif([L7D GMV Main (copy)_45739685137666059] = 0, 1, [L7D GMV Main (copy)_45739685137666059]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / iif([L7D GMV Main (copy)_45739685137666059] = 0, 1, [L7D GMV Main (copy)_45739685137666059]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='L7D AFV Main' datatype='real' name='[L7D GMV Main (copy)_45739685137666059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_same_day_last_week], [total_gfv_eur], null)) / sum(iif([is_same_day_last_week], [total_number_of_successful_orders],null))' />
            </column>
            <column caption='Yesterday&apos;s AFV Main' datatype='real' name='[Yesterday&apos;s GMV Main (copy)_45739685137494026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_yesterday], [total_gfv_eur], null)) / sum(iif([is_yesterday], [total_number_of_successful_orders],null))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4056406276413648901]' derivation='None' name='[none:Calculation_4056406276413648901:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[total_gfv_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_number_of_successful_orders]' role='measure' type='quantitative' />
