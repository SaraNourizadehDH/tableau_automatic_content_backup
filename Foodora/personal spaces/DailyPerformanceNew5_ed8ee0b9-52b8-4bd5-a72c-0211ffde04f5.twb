            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'>(Average Food Value of successful orders)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='AFV Eur' datatype='real' name='[Calculation_5401364105257897994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='round(sum([total_gfv_eur]) / sum([total_number_of_successful_orders]),2)' />
