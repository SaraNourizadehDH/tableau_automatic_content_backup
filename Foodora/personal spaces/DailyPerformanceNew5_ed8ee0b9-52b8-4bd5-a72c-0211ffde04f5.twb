      <column caption='GMV WoW Main (Positive) (copy)' datatype='real' default-format='p0.0%' name='[GMV WoW Main (Positive) (copy)_1558526989812256771]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='([Yesterday&apos;s Orders Main (copy)_45739685114138626] - [L7D Orders Main (copy)_45739685114609668]) / iif([L7D Orders Main (copy)_45739685114609668] = 0, 1, [L7D Orders Main (copy)_45739685114609668])' />
      </column>
      <column caption='AFV WoW Main (Positive)' datatype='string' name='[GMV WoW Main (Positive) (copy)_45739685146812429]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / iif([L7D GMV Main (copy)_45739685137666059] = 0, 1, [L7D GMV Main (copy)_45739685137666059]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / iif([L7D GMV Main (copy)_45739685137666059] = 0, 1, [L7D GMV Main (copy)_45739685137666059]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s GMV Main (copy)_45739685137494026] - [L7D GMV Main (copy)_45739685137666059]) / iif([L7D GMV Main (copy)_45739685137666059] = 0, 1, [L7D GMV Main (copy)_45739685137666059]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='Hours worked L1W' datatype='real' name='[Hours worked yesterday (copy)_2718626066438901767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF [Calculation_6180416436320313347]&#10;THEN ([worked_hours])&#10;ELSE 0&#10;END)' />
      </column>
      <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
      </column>
      <column caption='L7D OD Shares WoW Main (Negative) (copy)' datatype='string' name='[L7D %LO WoW Main (Negative) (copy) (copy)_3660159913700102144]' role='measure' type='nominal'>
