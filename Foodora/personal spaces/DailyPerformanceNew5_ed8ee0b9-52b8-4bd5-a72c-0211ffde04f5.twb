        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.12t27jq1cuj74s1e3u8gk1t9ci2z' name='daily_report_main' table='[dhh---analytics-eu.bl_europe].[daily_report_main]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.12t27jq1cuj74s1e3u8gk1t9ci2z' name='daily_report_main' table='[dhh---analytics-eu.bl_europe].[daily_report_main]' type='table' />
          <relation connection='bigquery.12t27jq1cuj74s1e3u8gk1t9ci2z' name='Custom SQL Query' type='text'><![CDATA[with
prep as
(SELECT 
CASE 
   WHEN country = 'Austria' THEN 'MJM_AT'
   WHEN country = 'Czech Republic' THEN 'DJ_CZ'
   WHEN country = 'Finland' THEN 'PO_FI'
   WHEN country = 'Sweden' THEN 'OP_SE'
   WHEN country = 'Norway' THEN 'FO_NO'
   WHEN country = 'Hungary' THEN 'NP_HU' 
      WHEN country = 'Turkey' THEN "YS_TR"
END as global_entity_id,
month as target_month, 
record_type as be_version,
total_orders as successful_orders, 
total_net_gmv  as amt_gmv_eur
FROM `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_ln_os_key_kpis` 
where
currency = 'EUR' 
and record_type <<>> 'Actual'
and record_type LIKE '%Best Estimate%'
and country in ('Austria', 'Czech Republic', 'Finland', 'Sweden', 'Norway', 'Hungary', 'Turkey')
),

total_with_TR AS (SELECT
  'DH_Europe+YS_TR' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_gmv_eur), 
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU",
"YS_TR")
GROUP BY 1, 2
),

total_without_TR AS (SELECT
  'DH_Europe' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_gmv_eur), 
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU")
GROUP BY 1, 2)

SELECT *
FROM prep
UNION ALL
SELECT *
FROM total_with_TR
UNION ALL
SELECT *
FROM total_without_TR]]></relation>
          <relation connection='bigquery.12t27jq1cuj74s1e3u8gk1t9ci2z' name='Custom SQL Query2' type='text'>select * from `dhh---analytics-eu.bl_europe.daily_report_online_vendors`</relation>
