      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='L7D avg DF up Main' datatype='real' name='[L7D avg DF Main (copy)_130674766535278595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_same_day_last_week], [od_df_user_paid_incl_vat_eur], null))&#10;/&#10;SUM(IIF([is_same_day_last_week], [od_delivery_fee_eur_cnt], null))' />
            </column>
            <column caption='Yesterday&apos;s avg DF UP Main' datatype='real' name='[Yesterday&apos;s avg DF Main (copy)_130674766535118850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [is_yesterday]&#10;THEN [od_df_user_paid_incl_vat_eur]&#10;ELSE null&#10;END&#10;)&#10;&#10;/  &#10;&#10;SUM(&#10;IF [is_yesterday]&#10;THEN [od_delivery_fee_eur_cnt]&#10;ELSE null&#10;END&#10;)' />
