      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='L7D Fail Rate Main' datatype='real' name='[L7D AFV Main (copy)_45739686624632862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_same_day_last_week], [total_number_of_failed_orders], null)) / sum(iif([is_same_day_last_week], [total_number_of_orders],null))' />
            </column>
            <column caption='MP Fail Rate WoW Main (Negative)' datatype='string' name='[OD Fail Rate WoW Main (Negative) (copy)_442337931515838467]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703] - [OD L7D Fail Rate Main (copy)_442337931521351702]) / [OD L7D Fail Rate Main (copy)_442337931521351702] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703] - [OD L7D Fail Rate Main (copy)_442337931521351702]) / [OD L7D Fail Rate Main (copy)_442337931521351702] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703] - [OD L7D Fail Rate Main (copy)_442337931521351702]) / [OD L7D Fail Rate Main (copy)_442337931521351702] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MP Fail Rate WoW Main (Positive)' datatype='string' name='[OD Fail Rate WoW Main (Positive) (copy)_442337931515838468]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703] - [OD L7D Fail Rate Main (copy)_442337931521351702]) / iif([OD L7D Fail Rate Main (copy)_442337931521351702] = 0 or isnull([OD L7D Fail Rate Main (copy)_442337931521351702]), 1, [OD L7D Fail Rate Main (copy)_442337931521351702]) &gt; 0&#10;or isnull([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703]) or isnull([OD L7D Fail Rate Main (copy)_442337931521351702]) or [OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703] = 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703] - [OD L7D Fail Rate Main (copy)_442337931521351702]) / iif([OD L7D Fail Rate Main (copy)_442337931521351702] = 0 or isnull([OD L7D Fail Rate Main (copy)_442337931521351702]), 1, [OD L7D Fail Rate Main (copy)_442337931521351702]) &gt; 0&#10;or isnull([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703]) or isnull([OD L7D Fail Rate Main (copy)_442337931521351702]) or [OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703] = 0&#10;then&#10;str(&#10;round(&#10;    (iif(isnull([OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703]),0,[OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703]) - iif(isnull([OD L7D Fail Rate Main (copy)_442337931521351702]),0,[OD L7D Fail Rate Main (copy)_442337931521351702])) / iif([OD L7D Fail Rate Main (copy)_442337931521351702] = 0 or isnull([L7D AFV Main (copy)_45739686624632862]), 1, [L7D AFV Main (copy)_45739686624632862]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MP L7D Fail Rate Main' datatype='real' name='[OD L7D Fail Rate Main (copy)_442337931521351702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_same_day_last_week], [mp_total_number_of_failed_orders], null)) / sum(iif([is_same_day_last_week], [mp_total_number_of_orders],null))' />
            </column>
            <column caption='MP Yesterday&apos;s Fail Rate Main' datatype='real' default-format='p0.0%' name='[OD Yesterday&apos;s Fail Rate Main (copy)_442337931521351703]' role='measure' type='quantitative'>
