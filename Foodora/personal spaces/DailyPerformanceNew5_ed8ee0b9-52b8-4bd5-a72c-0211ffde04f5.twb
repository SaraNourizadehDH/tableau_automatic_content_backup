            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='W1 OV % (Ranking)' datatype='real' name='[W1 OV % (copy)_341077362733113344]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [L1W (copy 2)] THEN [ov_daily] ELSE 0 END)) })&#10;- SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) })) / &#10;SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) })' />
            </column>
            <column caption='W1 OV % (Indicator)' datatype='string' name='[W1 Order % (Indicator) (copy 2)_308566949534347266]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [L1W (copy 2)] THEN [ov_daily] ELSE 0 END)) })&#10;- SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) }) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 OV %' datatype='string' name='[W1 Order % (copy 4)_308566949534347267]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [L1W (copy 2)] THEN [ov_daily] ELSE 0 END)) })&#10;- SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) }) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [L1W (copy 2)] THEN [ov_daily] ELSE 0 END)) }) - SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) }) &gt;= 0&#10;THEN &#10;   (SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [L1W (copy 2)] THEN [ov_daily] ELSE 0 END)) }) - SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) }))&#10;   / SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) })&#10;ELSE&#10;   (SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [L1W (copy 2)] THEN [ov_daily] ELSE 0 END)) }) - SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) }))&#10;   / SUM({ FIXED [country_name], [reference_date_local]:(MAX(IF [Calculation_6180416436320313347] THEN [ov_daily] ELSE 0 END)) })&#10;//    SUM(IF [L1W] THEN [ov_daily] ELSE 0 END) / SUM(IF [Yesterday] THEN [ov_daily] ELSE 0 END)&#10;END * 100, 1))' />
            </column>
            <column caption='Yesterday -7 date new' datatype='date' name='[Yesterday -7 date (copy)_5264496889549049862]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE([Calculation_127719338234654730]-7)}' />
