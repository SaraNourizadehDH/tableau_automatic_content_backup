            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='GMV MTD vs LYMTD (Indicator)' datatype='string' name='[Orders MTD vs LYMTD (Indicator) (copy)_3688870375730655233]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;    -&#10;    SUM(iif([PMTD (copy)_383861552113147904], [total_gmv_eur], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([PMTD (copy)_383861552113147904], [total_gmv_eur], 0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='GMV MTD vs LYMTD' datatype='string' name='[Orders MTD vs LYMTD (copy)_3688870375730147328]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))/&#10;SUM(iif([PMTD (copy)_383861552113147904], [total_gmv_eur], 0)))-1 &gt; 5&#10;THEN NULL&#10;ELSE&#10;if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;    -&#10;    SUM(iif([PMTD (copy)_383861552113147904], [total_gmv_eur], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([PMTD (copy)_383861552113147904], [total_gmv_eur], 0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_gmv_eur], 0))&#10;    -&#10;    SUM(iif([PMTD (copy)_383861552113147904], [total_gmv_eur], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([PMTD (copy)_383861552113147904], [total_gmv_eur], 0))&#10;)&#10;* 100&#10;,1)&#10;)&#10;END' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[PMTD (copy)_383861552113147904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})) &#10;    AND day([reference_date_local]) &lt;= day({ FIXED : [Calculation_127719338234654730]})&#10;    AND month([reference_date_local]) &lt;= month({ FIXED : [Calculation_127719338234654730]})' />
            </column>
