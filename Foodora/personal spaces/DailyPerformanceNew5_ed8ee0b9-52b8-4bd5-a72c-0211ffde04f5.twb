            <column caption='%TS W1 %' datatype='string' name='[%LO W1 % (copy)_2164753730826276870]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (MAX(IF [Calculation_378794978108076033] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END) - MAX(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END))&#10;/ MAX(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF MAX(IF [Calculation_378794978108076033] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END) - MAX(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (MAX(IF [Calculation_378794978108076033] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END) - MAX(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END))&#10;   / MAX(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END)&#10;ELSE&#10;   (MAX(IF [Calculation_378794978108076033] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END) - MAX(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END))&#10;   / MAX(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [%TS Per Day (copy)_2164753730824192004] ELSE 0 END)&#10;//    SUM(IF [Start date Boolean] THEN [od_successful_orders] ELSE 0 END) / SUM(IF [Start date + 7 Boolean] THEN [od_successful_orders] ELSE 0 END)&#10;END * 100, 1))' />
