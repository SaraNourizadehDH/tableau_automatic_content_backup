              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [reference_date_local], { FIXED : [Calculation_127719338234654730]} - 1) = 0&#10;AND&#10;DAY([reference_date_local]) &lt;= DAY({ FIXED : [Calculation_127719338234654730]}-1)' />
            </column>
            <column caption='LY MTD (-1)' datatype='boolean' name='[MTD last year (copy)_2210845258111135747]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]} - 1)) &#10;    AND day([reference_date_local]) &lt;= day({ FIXED : [Calculation_127719338234654730]} -1)&#10;    AND month([reference_date_local]) &lt;= month({ FIXED : [Calculation_127719338234654730]} -1)' />
