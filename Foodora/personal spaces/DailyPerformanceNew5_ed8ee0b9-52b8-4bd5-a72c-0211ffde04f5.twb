            <column caption='NPS WoW Main (Negative)' datatype='string' name='[AFV WoW Main (Negative) (copy)_45739685293797397]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100]=0,1,[L7D AFV Main (copy)_45739685293486100]) &lt;= 0&#10;or isnull(([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100]=0,1,[L7D AFV Main (copy)_45739685293486100]))&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100]=0,1,[L7D AFV Main (copy)_45739685293486100]) &lt;= 0&#10;or isnull(([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100]=0,1,[L7D AFV Main (copy)_45739685293486100]))&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100]=0,1,[L7D AFV Main (copy)_45739685293486100]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='NPS WoW Main (Positive)' datatype='string' name='[AFV WoW Main (Positive) (copy)_45739685294186518]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100] = 0, 1, [L7D AFV Main (copy)_45739685293486100]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100] = 0, 1, [L7D AFV Main (copy)_45739685293486100]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s AFV Main (copy)_45739685293207571] - [L7D AFV Main (copy)_45739685293486100]) / iif([L7D AFV Main (copy)_45739685293486100] = 0, 1, [L7D AFV Main (copy)_45739685293486100]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
