    <worksheet name='Yesterday&apos;s Shops avg DF'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Semibold' fontsize='11'>Shops</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='avg DF WoW Main (Negative)' datatype='string' name='[DF WoW Main (Negative) (copy)_1606025851078340614]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s DF Main (copy)_1606025851078340627] - [L7D DF Main (copy)_1606025851078340618]) / [L7D DF Main (copy)_1606025851078340618] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s DF Main (copy)_1606025851078340627] - [L7D DF Main (copy)_1606025851078340618]) / [L7D DF Main (copy)_1606025851078340618] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s DF Main (copy)_1606025851078340627] - [L7D DF Main (copy)_1606025851078340618]) / [L7D DF Main (copy)_1606025851078340618] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='avg DF WoW Main (Positive)' datatype='string' name='[DF WoW Main (Positive) (copy)_1606025851078340615]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s DF Main (copy)_1606025851078340627] - [L7D DF Main (copy)_1606025851078340618]) / iif([L7D DF Main (copy)_1606025851078340618] = 0, 1, [L7D DF Main (copy)_1606025851078340618]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s DF Main (copy)_1606025851078340627] - [L7D DF Main (copy)_1606025851078340618]) / iif([L7D DF Main (copy)_1606025851078340618] = 0, 1, [L7D DF Main (copy)_1606025851078340618]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s DF Main (copy)_1606025851078340627] - [L7D DF Main (copy)_1606025851078340618]) / iif([L7D DF Main (copy)_1606025851078340618] = 0, 1, [L7D DF Main (copy)_1606025851078340618]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='L7D avg DF Main' datatype='real' name='[L7D DF Main (copy)_1606025851078340618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_same_day_last_week] THEN [od_df_user_paid_incl_vat_eur] ELSE null END)&#10;/  &#10;SUM(IF [is_same_day_last_week] THEN od_successful_orders ELSE null END))&#10;&#10;+&#10;&#10;(SUM(IF [is_same_day_last_week] THEN [od_delivery_priority_fee_eur] ELSE null END)&#10;/  &#10;SUM(IF [is_same_day_last_week] THEN od_successful_orders ELSE null END)) &#10;&#10;+&#10;&#10;(SUM(IF [is_same_day_last_week] THEN [od_service_fee_plus_vat_eur] ELSE null END)&#10;/  &#10;SUM(IF [is_same_day_last_week] THEN od_successful_orders ELSE null END))&#10;&#10;+&#10;&#10;(SUM(IF [is_same_day_last_week] THEN [od_minimum_delivery_value_eur] ELSE null END)&#10;/  &#10;SUM(IF [is_same_day_last_week] THEN od_successful_orders ELSE null END))' />
            </column>
