              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s avg DF Main (copy)_130674766535118850] - [L7D avg DF Main (copy)_130674766535278595]) / [L7D avg DF Main (copy)_130674766535278595] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s avg DF Main (copy)_130674766535118850] - [L7D avg DF Main (copy)_130674766535278595]) / [L7D avg DF Main (copy)_130674766535278595] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s avg DF Main (copy)_130674766535118850] - [L7D avg DF Main (copy)_130674766535278595]) / [L7D avg DF Main (copy)_130674766535278595] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='avg DF up WoW Main (Positive)' datatype='string' name='[avg DF WoW Main (Positive) (copy)_130674766535716869]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s avg DF Main (copy)_130674766535118850] - [L7D avg DF Main (copy)_130674766535278595]) / iif([L7D avg DF Main (copy)_130674766535278595] = 0, 1, [L7D avg DF Main (copy)_130674766535278595]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s avg DF Main (copy)_130674766535118850] - [L7D avg DF Main (copy)_130674766535278595]) / iif([L7D avg DF Main (copy)_130674766535278595] = 0, 1, [L7D avg DF Main (copy)_130674766535278595]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s avg DF Main (copy)_130674766535118850] - [L7D avg DF Main (copy)_130674766535278595]) / iif([L7D avg DF Main (copy)_130674766535278595] = 0, 1, [L7D avg DF Main (copy)_130674766535278595]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
