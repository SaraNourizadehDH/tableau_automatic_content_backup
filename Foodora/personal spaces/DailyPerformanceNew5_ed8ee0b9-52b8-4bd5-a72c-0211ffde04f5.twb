          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)].[Yesterday -7 date (copy)_5264496889549049862]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)].[Yesterday -7 date (copy)_5264496889549049862]' caption='Start Date' datatype='date' datatype-customized='true' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-08-10#'>
