            <column caption='Seamless Orders WoW Main (Negative)' datatype='string' name='[Fail Rate WoW Main (Negative) (copy)_169025734742384676]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / [L7D Fail Rate Main (copy)_169025734743109670] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / [L7D Fail Rate Main (copy)_169025734743109670] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / [L7D Fail Rate Main (copy)_169025734743109670] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
