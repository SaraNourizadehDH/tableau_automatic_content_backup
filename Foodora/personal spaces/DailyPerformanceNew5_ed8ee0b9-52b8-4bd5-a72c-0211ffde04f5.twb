            </column>
            <column caption='LY MTD' datatype='boolean' name='[PMTD (copy)_383861552113147904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})) &#10;    AND day([reference_date_local]) &lt;= day({ FIXED : [Calculation_127719338234654730]})&#10;    AND month([reference_date_local]) &lt;= month({ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([reference_date_local]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='W1 AFV % (Indicator)' datatype='string' name='[W1 AFV % (copy)_5401364105256488968]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;- ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2)&#10;)&#10;/ &#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_successful_orders] ELSE 0 END),2) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Yesterday&apos;s AFV Main' datatype='real' name='[Yesterday&apos;s GMV Main (copy)_45739685137494026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_yesterday], [total_gfv_eur], null)) / sum(iif([is_yesterday], [total_number_of_successful_orders],null))' />
