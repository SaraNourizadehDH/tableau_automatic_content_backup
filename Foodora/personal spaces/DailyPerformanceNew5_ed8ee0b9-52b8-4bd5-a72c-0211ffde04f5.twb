      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='Fail Rate WoW Main (Positive)' datatype='string' name='[AFV WoW Main (Positive) (copy)_45739686625210400]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / iif([L7D AFV Main (copy)_45739686624632862] = 0 or isnull([L7D AFV Main (copy)_45739686624632862]), 1, [L7D AFV Main (copy)_45739686624632862]) &gt; 0&#10;or isnull([Yesterday&apos;s AFV Main (copy)_45739686624358429]) or isnull([L7D AFV Main (copy)_45739686624632862]) or [Yesterday&apos;s AFV Main (copy)_45739686624358429] = 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / iif([L7D AFV Main (copy)_45739686624632862] = 0 or isnull([L7D AFV Main (copy)_45739686624632862]), 1, [L7D AFV Main (copy)_45739686624632862]) &gt; 0&#10;or isnull([Yesterday&apos;s AFV Main (copy)_45739686624358429]) or isnull([L7D AFV Main (copy)_45739686624632862]) or [Yesterday&apos;s AFV Main (copy)_45739686624358429] = 0&#10;then&#10;str(&#10;round(&#10;    (iif(isnull([Yesterday&apos;s AFV Main (copy)_45739686624358429]),0,[Yesterday&apos;s AFV Main (copy)_45739686624358429]) - iif(isnull([L7D AFV Main (copy)_45739686624632862]),0,[L7D AFV Main (copy)_45739686624632862])) / iif([L7D AFV Main (copy)_45739686624632862] = 0 or isnull([L7D AFV Main (copy)_45739686624632862]), 1, [L7D AFV Main (copy)_45739686624632862]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='Fail Rate WoW Main (Negative)' datatype='string' name='[GMV WoW Main (Negative) (copy)_45739686624931871]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / [L7D AFV Main (copy)_45739686624632862] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / [L7D AFV Main (copy)_45739686624632862] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / [L7D AFV Main (copy)_45739686624632862] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='L7D Fail Rate Main' datatype='real' name='[L7D AFV Main (copy)_45739686624632862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_same_day_last_week], [total_number_of_failed_orders], null)) / sum(iif([is_same_day_last_week], [total_number_of_orders],null))' />
            </column>
            <column caption='Yesterday&apos;s Fail Rate Main' datatype='real' name='[Yesterday&apos;s AFV Main (copy)_45739686624358429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_yesterday], [total_number_of_failed_orders], null)) / sum(iif([is_yesterday], [total_number_of_orders],null))' />
            </column>
            <column caption='OD Yesterday&apos;s Fail Rate Main' datatype='real' default-format='p0.0%' name='[Yesterday&apos;s Fail Rate Main (copy)_416442233300529162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_yesterday], [od_total_number_of_failed_orders], null)) / sum(iif([is_yesterday], [od_total_number_of_orders],null))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
