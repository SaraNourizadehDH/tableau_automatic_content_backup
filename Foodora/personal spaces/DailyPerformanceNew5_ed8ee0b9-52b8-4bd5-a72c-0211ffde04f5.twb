    <worksheet name='avg DF  MTD Growth (4)'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD' />
              </aliases>
            </column>
            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='avg DF MTD' datatype='real' name='[DF MTD (copy)_1606025851078340611]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(iif([PMTD (copy)_128141502928715882], [od_df_user_paid_incl_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_delivery_priority_fee_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_service_fee_plus_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_minimum_delivery_value_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))' />
            </column>
            <column caption='avg DF MTD vs PMTD (Indicator)' datatype='string' name='[DF MTD vs PMTD (Indicator) (copy)_1606025851078340612]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [DF MTD (copy)_1606025851078340611]&#10;    -&#10;    [avg DF MTD (copy)_1606025851102916629]&#10;)&#10;&#10;/&#10;&#10;[avg DF MTD (copy)_1606025851102916629] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='avg DF MTD vs PMTD' datatype='string' name='[DF MTD vs PMTD (copy)_1606025851078340613]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [DF MTD (copy)_1606025851078340611]&#10;    -&#10;    [avg DF MTD (copy)_1606025851102916629]&#10;)&#10;&#10;/&#10;&#10;[avg DF MTD (copy)_1606025851102916629] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    [DF MTD (copy)_1606025851078340611]&#10;    -&#10;    [avg DF MTD (copy)_1606025851102916629]&#10;)&#10;&#10;/&#10;&#10;[avg DF MTD (copy)_1606025851102916629] * 100&#10;,1)&#10;)' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([reference_date_local]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='avg DF PMTD' datatype='real' name='[avg DF MTD (copy)_1606025851102916629]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(iif([Previous L30D (copy)_128141502928400489], [od_df_user_paid_incl_vat_eur], 0))&#10;/&#10;SUM(iif([Previous L30D (copy)_128141502928400489], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([Previous L30D (copy)_128141502928400489], [od_delivery_priority_fee_eur], 0))&#10;/&#10;SUM(iif([Previous L30D (copy)_128141502928400489], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([Previous L30D (copy)_128141502928400489], [od_service_fee_plus_vat_eur], 0))&#10;/&#10;SUM(iif([Previous L30D (copy)_128141502928400489], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([Previous L30D (copy)_128141502928400489], [od_minimum_delivery_value_eur], 0))&#10;/&#10;SUM(iif([Previous L30D (copy)_128141502928400489], od_successful_orders, 0)))' />
