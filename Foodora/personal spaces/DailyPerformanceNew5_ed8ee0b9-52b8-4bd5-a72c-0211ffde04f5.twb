            </column>
            <column caption='avg DF' datatype='real' default-format='c&quot; €&quot;#,##0.00&quot; &quot;;-&quot; €&quot;#,##0.00&quot; &quot;' name='[DF (copy)_1606025851078340610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[od_customer_delivery_fee] / sum([od_successful_orders])&#10;(sum([od_df_user_paid_incl_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_delivery_priority_fee_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_service_fee_plus_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_minimum_delivery_value_eur]) / SUM(od_successful_orders))' />
