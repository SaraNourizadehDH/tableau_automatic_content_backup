            <column caption='LY MTD' datatype='boolean' name='[PMTD (copy)_383861552113147904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})) &#10;    AND day([reference_date_local]) &lt;= day({ FIXED : [Calculation_127719338234654730]})&#10;    AND month([reference_date_local]) &lt;= month({ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([reference_date_local]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])})&#10;THEN TRUE&#10;END' />
