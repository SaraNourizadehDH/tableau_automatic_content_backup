              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / iif([L7D Fail Rate Main (copy)_169025734743109670] = 0 or isnull([L7D Fail Rate Main (copy)_169025734743109670]), 1, [L7D Fail Rate Main (copy)_169025734743109670]) &gt; 0&#10;or isnull([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]) or isnull([L7D Fail Rate Main (copy)_169025734743109670]) or [Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] = 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / iif([L7D Fail Rate Main (copy)_169025734743109670] = 0 or isnull([L7D Fail Rate Main (copy)_169025734743109670]), 1, [L7D Fail Rate Main (copy)_169025734743109670]) &gt; 0&#10;or isnull([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]) or isnull([L7D Fail Rate Main (copy)_169025734743109670]) or [Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] = 0&#10;then&#10;str(&#10;round(&#10;    (iif(isnull([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]),0,[Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]) - iif(isnull([L7D Fail Rate Main (copy)_169025734743109670]),0,[L7D Fail Rate Main (copy)_169025734743109670])) / iif([L7D Fail Rate Main (copy)_169025734743109670] = 0 or isnull([L7D Fail Rate Main (copy)_169025734743109670]), 1, [L7D Fail Rate Main (copy)_169025734743109670]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
