                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>UTR: </run>
                    <run fontcolor='#000000' fontsize='11'># Own Delivery Orders / # Hours Worked by Riders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>Orders Late: </run>
                    <run fontcolor='#000000' fontsize='11'># OD deliveries &gt;10 mins later than the promised delivery time / # OD deliveries</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>Successful Orders: </run>
