            <column caption='W1 avg DF %' datatype='string' name='[W1 DF % (copy)_1606025851078340625]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(&#10;(&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [od_df_user_paid_incl_vat_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [od_delivery_priority_fee_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [od_service_fee_plus_vat_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [L1W (copy 2)] THEN [od_minimum_delivery_value_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END),2)&#10;)&#10;&#10;- (&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_df_user_paid_incl_vat_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_delivery_priority_fee_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_service_fee_plus_vat_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_minimum_delivery_value_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;)&#10;&#10;)&#10;/ &#10;(&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_df_user_paid_incl_vat_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_delivery_priority_fee_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_service_fee_plus_vat_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;+&#10;ROUND(SUM(IF [Calculation_6180416436320313347] THEN [od_minimum_delivery_value_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END),2)&#10;)&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(&#10;((round(&#10;(&#10;SUM(IF [L1W (copy 2)] THEN [od_df_user_paid_incl_vat_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END)&#10;+&#10;SUM(IF [L1W (copy 2)] THEN [od_delivery_priority_fee_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END)&#10;+&#10;SUM(IF [L1W (copy 2)] THEN [od_service_fee_plus_vat_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END)&#10;+&#10;SUM(IF [L1W (copy 2)] THEN [od_minimum_delivery_value_eur] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN od_successful_orders ELSE 0 END)&#10;),2))&#10;&#10;/&#10;&#10;(&#10;round(&#10;(&#10;SUM(IF [Calculation_6180416436320313347] THEN [od_df_user_paid_incl_vat_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END)&#10;+&#10;SUM(IF [Calculation_6180416436320313347] THEN [od_delivery_priority_fee_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END)&#10;+&#10;SUM(IF [Calculation_6180416436320313347] THEN [od_service_fee_plus_vat_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END)&#10;+&#10;SUM(IF [Calculation_6180416436320313347] THEN [od_minimum_delivery_value_eur] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN od_successful_orders ELSE 0 END)&#10;),2))&#10;- 1 )* 100,1))' />
