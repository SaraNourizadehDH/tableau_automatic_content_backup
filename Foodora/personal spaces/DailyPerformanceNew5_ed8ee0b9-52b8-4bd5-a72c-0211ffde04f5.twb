          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='start date + 7' datatype='date' name='[Calculation_378794978106404864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] + 7' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Current MTD (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -7, {fixed:MIN([Calculation_378794978106404864])}) AND [reference_date_local] &lt;= {fixed:MIN([Calculation_378794978106404864])}&#10;THEN &apos;L7D&apos;&#10;ELSEIF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -14, {fixed:MIN([Calculation_378794978106404864])}) AND [reference_date_local] &lt;= DATEADD(&apos;day&apos;, -7, {fixed:MIN([Calculation_378794978106404864])})&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='Total PU shares Per Day' datatype='real' name='[Total MP shares Per Day (copy)_1282470386820313089]' role='measure' type='quantitative'>
