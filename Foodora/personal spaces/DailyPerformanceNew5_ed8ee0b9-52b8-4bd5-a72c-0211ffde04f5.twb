    <worksheet name='fr_Yesterday&apos;s Failed Rate (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='22'>Fill Rate</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'>(the # of hours planned for the riders divided by the total # of demanded hours)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_173670068668284928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hours_planned])/SUM((IFNULL([hours_unassigned], 0))+[hours_planned])' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Hours Planned' datatype='real' name='[hours_planned]' role='measure' type='quantitative' />
            <column caption='Hours Unassigned' datatype='real' name='[hours_unassigned]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[L1W (copy 2)]' derivation='None' name='[none:L1W (copy 2):nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_173670068668284928]' derivation='User' name='[usr:Calculation_173670068668284928:qk]' pivot='key' type='quantitative' />
