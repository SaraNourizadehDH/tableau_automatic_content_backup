            <column caption='Previous L7D' datatype='boolean' name='[L7D &amp; Previous L7D  (copy 2)_195554791588667407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -14, {fixed:MIN([Calculation_378794978106404864])}) AND [reference_date_local] &lt;= DATEADD(&apos;day&apos;, -7, {fixed:MIN([Calculation_378794978106404864])})&#10;THEN True&#10;END' />
            </column>
            <column caption='L7D' datatype='boolean' name='[L7D &amp; Previous L7D  (copy 2)_6576733250817609742]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -7, {fixed:MIN([Calculation_378794978106404864])}) AND [reference_date_local] &lt;= {fixed:MIN([Calculation_378794978106404864])}&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='L7D PU Shares' datatype='real' name='[L7D MP Shares (copy)_1282470386853814281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([L7D &amp; Previous L7D  (copy 2)_6576733250817609742],[successful_orders_pickup],0)) / SUM(iif([L7D &amp; Previous L7D  (copy 2)_6576733250817609742],[total_number_of_successful_orders],0))' />
            </column>
            <column caption='L7D PU Shares WoW Main (Positive)' datatype='string' name='[L7D MP Shares WoW Main (Positive) (copy)_1282470386857582607]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([L7D MP Shares (copy)_1282470386853814281]-[Previous L7D MP Shares (copy)_1282470386853965834])/[Previous L7D MP Shares (copy)_1282470386853965834] &gt;= 0&#10;then &apos;▲ &apos; &#10;ELSE null &#10;end&#10;+&#10;str(&#10;round(([L7D MP Shares (copy)_1282470386853814281]-[Previous L7D MP Shares (copy)_1282470386853965834])/[Previous L7D MP Shares (copy)_1282470386853965834]*100,1)&#10;)&#10;+&apos;%&apos;' />
