    <worksheet name='Seamless Orders graph value'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='Seamless Orders MTD vs PMTD Main (Negative)' datatype='string' name='[%LO MTD vs PMTD Main (Negative) (copy)_2051530412366118912]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;/&#10;(&#10;[Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;&lt; 0&#10;then &apos;▼ &apos; &#10;+&#10;str(round(&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;/&#10;(&#10;[Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;* 100&#10;,1)&#10;) + &apos;%&apos;&#10;ELSE null&#10;end' />
            </column>
            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_6180416436319469570]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='LastD WoW' />
              </aliases>
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Seamless Orders WoW Main (Negative)' datatype='string' name='[Fail Rate WoW Main (Negative) (copy)_169025734742384676]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / [L7D Fail Rate Main (copy)_169025734743109670] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / [L7D Fail Rate Main (copy)_169025734743109670] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / [L7D Fail Rate Main (copy)_169025734743109670] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Seamless Orders WoW Main (Positive)' datatype='string' name='[Fail Rate WoW Main (Positive) (copy)_169025734742384675]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / iif([L7D Fail Rate Main (copy)_169025734743109670] = 0 or isnull([L7D Fail Rate Main (copy)_169025734743109670]), 1, [L7D Fail Rate Main (copy)_169025734743109670]) &gt; 0&#10;or isnull([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]) or isnull([L7D Fail Rate Main (copy)_169025734743109670]) or [Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] = 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] - [L7D Fail Rate Main (copy)_169025734743109670]) / iif([L7D Fail Rate Main (copy)_169025734743109670] = 0 or isnull([L7D Fail Rate Main (copy)_169025734743109670]), 1, [L7D Fail Rate Main (copy)_169025734743109670]) &gt; 0&#10;or isnull([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]) or isnull([L7D Fail Rate Main (copy)_169025734743109670]) or [Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661] = 0&#10;then&#10;str(&#10;round(&#10;    (iif(isnull([Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]),0,[Yesterday&apos;s Fail Rate Main (copy 2)_169025734742810661]) - iif(isnull([L7D Fail Rate Main (copy)_169025734743109670]),0,[L7D Fail Rate Main (copy)_169025734743109670])) / iif([L7D Fail Rate Main (copy)_169025734743109670] = 0 or isnull([L7D Fail Rate Main (copy)_169025734743109670]), 1, [L7D Fail Rate Main (copy)_169025734743109670]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Seamless Orders Per Day By Country (PMTD)' datatype='real' name='[Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max(iif([Previous L30D (copy)_128141502928400489],[seamless_orders_od],0))&#10;/&#10;max(iif([Previous L30D (copy)_128141502928400489],[successful_orders_od],0))' />
            </column>
            <column caption='Seamless Orders Per Day By Country (MTD)' datatype='real' name='[Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max(iif([PMTD (copy)_128141502928715882],[seamless_orders],0))&#10;/&#10;max(iif([PMTD (copy)_128141502928715882],[successful_orders_od_seamless],0))' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='L7D Seamless Orders Main' datatype='real' name='[L7D Fail Rate Main (copy)_169025734743109670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max(iif([is_same_day_last_week], [seamless_orders], null)) / max(iif([is_same_day_last_week], [successful_orders_od_seamless],null))' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[PMTD (copy)_383861552113147904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[reference_date_local]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{ FIXED : [Calculation_127719338234654730]})) &#10;    AND day([reference_date_local]) &lt;= day({ FIXED : [Calculation_127719338234654730]})&#10;    AND month([reference_date_local]) &lt;= month({ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([reference_date_local]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([reference_date_local])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Seamless Orders MTD vs LYMTD Main (Negative)' datatype='string' name='[Seamless Orders MTD vs LYMTD Main (Positive) (copy)_2051530412367925251]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;/&#10;(&#10;[Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;&lt; 0&#10;then &apos;▼ &apos;&#10;+&#10;str(round(&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;/&#10;(&#10;[Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;* 100&#10;,1)&#10;) + &apos;%&apos;&#10;ELSE null&#10;end' />
            </column>
            <column caption='Seamless Orders MTD vs PMTD Main (Positive)' datatype='string' name='[Seamless Orders MTD vs PMTD Main (Negative) (copy)_2051530412367302657]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;/&#10;(&#10;[Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;&gt; 0&#10;then &apos;▲ &apos; &#10;+&#10;str(round(&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;/&#10;(&#10;[Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]&#10;)&#10;* 100&#10;,1)&#10;) + &apos;%&apos;&#10;ELSE null&#10;end' />
            </column>
            <column caption='Seamless Orders MTD vs LYMTD Main (Positive)' datatype='string' name='[Seamless Orders MTD vs PMTD Main (Positive) (copy)_2051530412367429634]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;/&#10;(&#10;[Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;&gt; 0&#10;then &apos;▲ &apos; &#10;+&#10;str(round(&#10;(&#10;    [Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]&#10;    -&#10;    [Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;/&#10;(&#10;[Seamless Orders Per Day By Country (MTD) (copy)_4748131018810327073]&#10;)&#10;* 100&#10;,1)&#10;) + &apos;%&apos;&#10;ELSE null&#10;end' />
            </column>
