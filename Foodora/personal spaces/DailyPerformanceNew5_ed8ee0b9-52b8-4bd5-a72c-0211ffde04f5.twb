              <calculation class='tableau' formula='max(iif([PMTD (copy)_383861552113147904],[seamless_orders],0))&#10;/&#10;max(iif([PMTD (copy)_383861552113147904],[successful_orders_od_seamless],0))' />
            </column>
            <column caption='W1 Seamless Orders % (Indicator)' datatype='string' name='[W1 Order % (Indicator) (copy 2)_169025734726676501]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;((SUM(IF [L1W (copy 2)] THEN [seamless_orders_od] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [successful_orders_od] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [seamless_orders_od] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [successful_orders_od] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [seamless_orders_od] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [successful_orders_od] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
