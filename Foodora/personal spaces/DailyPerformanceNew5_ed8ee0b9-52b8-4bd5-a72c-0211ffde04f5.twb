              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;+ SUM(iif([Calculation_2662964453460332558], [total_number_of_successful_orders], 0))&#10;/ 21&#10;* ([Calculation_2662964453198508033] - DAY(TODAY()-1))' />
