            </column>
            <column caption='yesterday/x day' datatype='string' name='[Calculation_378794978173800456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [reference_date_local] WHEN DATE(TODAY()-1) THEN &apos;yesterday&apos;&#10;ELSE &apos;on the&apos; END' />
            </column>
            <column caption='Date range' datatype='boolean' name='[Calculation_418201474534387717]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_date_local] &gt;= [Parameters].[Parameter 1] AND [reference_date_local] &lt;= [Parameters].[Parameter 1] + 7' />
