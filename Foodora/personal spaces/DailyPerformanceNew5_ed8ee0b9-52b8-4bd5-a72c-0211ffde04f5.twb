              <calculation class='tableau' formula='//IF ISOWEEK([reference_date_local]) = ISOWEEK(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;//AND [reference_date_local] &lt;= DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])})&#10;//AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;//THEN TRUE&#10;//END&#10;&#10;IF ISOWEEK([reference_date_local]) = ISOWEEK(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])})&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &gt;= DATEADD(&apos;week&apos;, -1, DATE(DATETRUNC(&apos;week&apos;, {MAX([reference_date_local])})))&#10;THEN TRUE&#10;END' />
