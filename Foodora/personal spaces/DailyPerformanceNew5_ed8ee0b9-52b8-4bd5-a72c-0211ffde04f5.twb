              <calculation class='tableau' formula='if&#10;(&#10;    [MP Failed Rate Per Day By Country (MTD) (copy)_4748131018823532606] - [MP Failed Rate Per Day By Country (PMTD) (copy)_4748131018823651391]&#10;)&#10;&#10;/&#10;&#10;[MP Failed Rate Per Day By Country (PMTD) (copy)_4748131018823651391] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    [MP Failed Rate Per Day By Country (MTD) (copy)_4748131018823532606] - [MP Failed Rate Per Day By Country (PMTD) (copy)_4748131018823651391]&#10;)&#10;&#10;/&#10;&#10;[MP Failed Rate Per Day By Country (PMTD) (copy)_4748131018823651391] * 100&#10;,1)&#10;)' />
