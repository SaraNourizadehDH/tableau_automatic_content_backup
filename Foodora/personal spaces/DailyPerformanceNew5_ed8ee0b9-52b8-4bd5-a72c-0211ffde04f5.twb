              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
