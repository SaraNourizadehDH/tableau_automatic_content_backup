            </column>
            <column caption='MP Shares W1 Order % (Indicator)' datatype='string' name='[OD Shares W1 Order % (Indicator) (copy)_1037868668641710088]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (AVG(IF [Calculation_378794978108076033] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END) - AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END))&#10;/ AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='MP Shares W1 Order %' datatype='string' name='[OD Shares W1 Order % (copy)_1037868668641693703]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (AVG(IF [Calculation_378794978108076033] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END) - AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END))&#10;/ AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF AVG(IF [Calculation_378794978108076033] THEN [OD shares Per Day By Country (copy)_1037868668641845258] ELSE 0 END) - AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END) &gt;= 0&#10;THEN &#10;   (AVG(IF [Calculation_378794978108076033] THEN [OD shares Per Day By Country (copy)_1037868668641845258] ELSE 0 END) - AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END))&#10;   / AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END)&#10;ELSE&#10;   (AVG(IF [Calculation_378794978108076033] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END) - AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END))&#10;   / AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END)&#10;//    SUM(IF [Start date Boolean] THEN [od_successful_orders] ELSE 0 END) / SUM(IF [Start date + 7 Boolean] THEN [od_successful_orders] ELSE 0 END)&#10;END * 100, 1))' />
            </column>
