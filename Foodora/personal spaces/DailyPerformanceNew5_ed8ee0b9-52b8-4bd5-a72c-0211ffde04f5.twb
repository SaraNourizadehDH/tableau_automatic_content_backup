    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/DailyPerformance/Glossary?rev=' id='Glossary' path='/t/Foodora/workbooks/DailyPerformanceNew5' revision='' site='Foodora' />
      <style />
      <size maxheight='1400' maxwidth='1350' minheight='1400' minwidth='1350' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='6000' id='3' type-v2='text' w='98814' x='593' y='571'>
            <formatted-text>
              <run fontcolor='#ca0052' fontname='Tableau Medium' fontsize='26'>Glossary</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='92858' id='8' type-v2='text' w='98814' x='593' y='6571'>
            <formatted-text>
              <run fontcolor='#000000' fontsize='14' underline='true'>KPIs</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>GMV: </run>
              <run fontcolor='#000000' fontsize='11'>Gross Merchandise Value [</run>
              <run fontcolor='#4d5156' fontsize='11'>€]</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Revenue: </run>
              <run fontcolor='#000000' fontsize='11'>The sum of commission plus Delivery Fee [</run>
              <run fontcolor='#4d5156' fontsize='11'>€].</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Commission: </run>
              <run fontcolor='#000000' fontsize='11'>The contracted fee [</run>
              <run fontcolor='#4d5156' fontsize='11'>€], </run>
              <run fontcolor='#000000' fontsize='11'>exluding VAT, paid by the restaurants per order for a specific service (e.g. placement on the portal, domain hosting, delivery etc), among successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Delivery Fee: </run>
              <run fontcolor='#000000' fontsize='11'>Delivery fee [</run>
              <run fontcolor='#4d5156' fontsize='11'>€] </run>
              <run fontcolor='#000000' fontsize='11'>paid by customer for [# Successful Orders] and for own delivery.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Gross Orders</run>
              <run fontcolor='#000000' fontsize='11'>: # of orders that got into a final order state - no matter if successful or failed. The cart must have been submitted by the customer and SMS verfication and online payment must have completed successfully.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Acquisitions: </run>
              <run fontcolor='#000000' fontsize='11'># of customers placing their very first order on the platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Active Customers: </run>
              <run fontcolor='#000000' fontsize='11'># of customers placing an order on the platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Existing Customers: </run>
              <run fontcolor='#000000' fontsize='11'># of customers placing an order on the platform; not for the first time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Sessions: </run>
              <run fontcolor='#000000' fontsize='11'># of visits to our platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>UTR: </run>
              <run fontcolor='#000000' fontsize='11'># Own Delivery Orders / # Hours Worked by Riders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Orders Late: </run>
              <run fontcolor='#000000' fontsize='11'># OD deliveries &gt;10 mins later than the promised delivery time / # OD deliveries</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Successful Orders: </run>
              <run fontcolor='#000000' fontsize='11'># of orders which ended up in a successful state.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>OD Restaurant Orders: </run>
              <run fontcolor='#000000' fontsize='11'># of restaurant own delivery orders which ended up in a successful state.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Successful Orders for Dmarts: </run>
              <run fontcolor='#000000' fontsize='11'>same as above, for the dmarts vertical.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Seamless Orders:</run>
              <run fontcolor='#000000' fontsize='11'>  An order is seamless if the following conditions are met:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>- The order was own delivery</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>- The order was successful</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>- There were no logistics related cancellations i.e. failures</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>- Its delivery was within +/- 10 minutes of promised delivery time</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>- There were no Service interactions i.e. no Help Center sessions and no contacts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>% Time Shrinkage</run>
              <run fontcolor='#000000' fontsize='11'>: share of time when the delivery area was reduced</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>% Lost Orders</run>
              <run fontcolor='#000000' fontsize='11'>: estimated share of lost OD orders due to reduction or closure of the delivery area</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Failed Orders</run>
              <run fontcolor='#000000' fontsize='11'>: # of gross orders which ended up in a failed order state.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Fail Rate</run>
              <run fontcolor='#000000' fontsize='11'>: # Failed Orders / # Gross Orders.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Fail Rate OD</run>
              <run fontcolor='#000000' fontsize='11'>: # Failed Orders (own delivery) / # Gross Orders (own delivery).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Fail Rate MP</run>
              <run fontcolor='#000000' fontsize='11'>: # Failed Orders (marketplace) / # Gross Orders (marketplace).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>AFV</run>
              <run fontcolor='#000000' fontsize='11'>: Average Food Value [</run>
              <run fontcolor='#4d5156' fontsize='11'>€] </run>
              <run fontcolor='#000000' fontsize='11'>[GFV] / [# Successful Orders].</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='11'>GFV</run>
              <run fontcolor='#1d1c1d' fontsize='11'>: Gross food value </run>
              <run fontcolor='#000000' fontsize='11'>[</run>
              <run fontcolor='#4d5156' fontsize='11'>€]</run>
              <run fontcolor='#1d1c1d' fontsize='11'> for [# Successful Orders].</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Customer NPS</run>
              <run fontcolor='#000000' fontsize='11'>: Net promoter score. ((Promoters - Detractors) / [# NPS Responses]) * 100</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Vendors Online:</run>
              <run fontcolor='#000000' fontsize='11'> The # of vendors which appear online in the platform in a given period of time. Note, that we do not take into account whether or not they made &gt; 0 orders during that period of time.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='14' underline='true'>Calculations</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Run Rate:</run>
              <run fontcolor='#000000' fontsize='11'> Calculated as the actual amount of the current month, plus the average of the last 21 days. For example, if we have data until the 3rd of the current month, we take the actual gmv amount for those 3 days, plus the average amount of gmv from the last 21 days and extrapolate it for the whole month. The only exception to this is active / existing customers KPIs which use 3 months&apos; daily average and extrapolate it to the remaining days in the month.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontsize='11'>MTD</run>
              <run fontcolor='#1b1b1b' fontsize='11'>: The month to date amount of a given metric. For example, if today is the 15th March, for successful orders, MTD will be the sum of orders from the 1st March until the 14th. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontsize='11'>MTD Growth</run>
              <run fontcolor='#1b1b1b' fontsize='11'>: The MTD growth compared to the previous MTD. In the example above, it would be the sum of successful orders from 1st until the 14th of March, minus the sum of successful orders from the 1st until the 14th of February, divided by suc. orders 1-14th Feb. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Current Month RR vs Target</run>
              <run fontcolor='#1b1b1b' fontsize='11'>: Defined as the Run Rate for the current month - the target for the current month, divided by the Run Rate for the current month. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Current Month RR vs YoY %</run>
              <run fontcolor='#1b1b1b' fontsize='11'>: Defined as the Run Rate for the current month - the actual value for the same month the previous year, divided by the Run Rate for the current month.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontsize='11'>Current Month MTD vs YoY %</run>
              <run fontcolor='#1b1b1b' fontsize='11'>: Defined as the MTD value for the current month - the actual value for the same month the previous year, divided by the MTD value for the current month.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontsize='11'>ACID: </run>
              <run fontcolor='#1b1b1b' fontsize='11'>All customer KPIs are based on analytical_customer_id which combines multiple accounts of the same person using a fuzzy matching logic, therefore more accurate when calculating those KPIs.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='14' underline='true'>Known Issues</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Commissions: </run>
              <run fontcolor='#000000' fontsize='11'>Commission data has a lag of 1 day and therefore yesterday&apos;s commission revenue appears as 0 in the data for all countries.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Customer KPIs: </run>
              <run fontcolor='#000000' fontsize='11'>The analytical_customer_id logic is owned by Central DWH team therefore we have an upstream dependency to them when calculating customer KPIs. Currently, their pipeline to expose the data to DataHub finishes between 8-10 in the morning therefore the customer KPIs for the last day might appear as 0 until that data is in.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>NPS: </run>
              <run fontcolor='#000000' fontsize='11'>There is no data for NPS from yesterday because of the fact that the survey is sent out the day after the order and the data is ingested the day after the survey is sent out.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='14' underline='true'>Additional information</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>The targets are extracted from LUCANET 2022. You can see them in the following gsheet, under the Targets tab:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11'>Æ </run>
              <run auto-url='true' fontcolor='#000000' fontsize='11' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1pEG3ThsJrNUUEA_hUSh14h3KXmb7k5iI0VI6jz_2L80/edit#gid=1485601104&amp;quot;'>https://docs.google.com/spreadsheets/d/1pEG3ThsJrNUUEA_hUSh14h3KXmb7k5iI0VI6jz_2L80/edit#gid=1485601104</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='6222' id='71' is-centered='0' is-scaled='1' param='Image/checkmark.png' type-v2='bitmap' w='6200' x='4000' y='43333' />
        <zone h='6222' id='72' is-centered='0' is-scaled='1' param='Image/cross.png' type-v2='bitmap' w='4700' x='4000' y='50889' />
        <zone h='4889' id='74' is-centered='0' is-scaled='1' param='Image/orange.png' type-v2='bitmap' w='4300' x='3100' y='90000' />
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='4493' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98858' id='4492' param='vert' type-v2='layout-flow' w='98814' x='593' y='571'>
                <zone forceUpdate='true' h='6000' id='3' type-v2='text' w='98814' x='593' y='571'>
                  <formatted-text>
