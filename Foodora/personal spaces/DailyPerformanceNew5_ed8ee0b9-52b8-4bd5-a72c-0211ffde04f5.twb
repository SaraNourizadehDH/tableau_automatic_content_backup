    <worksheet name='e_shops_Order LYMTD %'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='1 LY MTD Growth' datatype='integer' name='[1 MTD Growth (copy)_382172716284264451]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD / LY MTD' />
              </aliases>
            </column>
            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='Country (copy)' datatype='string' name='[Country (copy)_216383910481940480]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Orders MTD vs LYMTD (Indicator)' datatype='string' name='[Orders MTD vs PMTD (Indicator) (copy)_382172716283981826]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;    -&#10;    SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
