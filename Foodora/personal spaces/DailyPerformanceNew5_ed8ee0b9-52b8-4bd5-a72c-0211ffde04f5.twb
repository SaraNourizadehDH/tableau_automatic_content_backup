            <column caption='AFV Per Day By Country (MTD)' datatype='real' name='[AFV Per Day By Country (copy)_128141503736733810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([PMTD (copy)_128141502928715882],[total_gfv_eur],0))&#10;/ &#10;sum(iif([PMTD (copy)_128141502928715882],[total_number_of_successful_orders],0))' />
