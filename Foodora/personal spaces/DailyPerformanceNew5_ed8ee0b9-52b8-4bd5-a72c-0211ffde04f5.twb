    <worksheet name='fill_rate_L7D_avg_vs_previous_day (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Semibold' fontsize='11'>Last 7 Days vs. Previous Day</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value=' ' />
              </aliases>
            </column>
            <column caption='Fill Rate WoW Main (Negative)' datatype='string' name='[Fail Rate WoW Main (Negative) (copy)_163185126143500298]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308] - [L7D Fail Rate Main (copy)_163185126143500299]) / [L7D Fail Rate Main (copy)_163185126143500299] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308] - [L7D Fail Rate Main (copy)_163185126143500299]) / [L7D Fail Rate Main (copy)_163185126143500299] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308] - [L7D Fail Rate Main (copy)_163185126143500299]) / [L7D Fail Rate Main (copy)_163185126143500299] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Fill Rate WoW Main (Positive)' datatype='string' name='[Fail Rate WoW Main (Positive) (copy)_163185126143500293]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308] - [L7D Fail Rate Main (copy)_163185126143500299]) / iif([L7D Fail Rate Main (copy)_163185126143500299] = 0 or isnull([L7D Fail Rate Main (copy)_163185126143500299]), 1, [L7D Fail Rate Main (copy)_163185126143500299]) &gt; 0&#10;or isnull([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308]) or isnull([L7D Fail Rate Main (copy)_163185126143500299]) or [Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308] = 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308] - [L7D Fail Rate Main (copy)_163185126143500299]) / iif([L7D Fail Rate Main (copy)_163185126143500299] = 0 or isnull([L7D Fail Rate Main (copy)_163185126143500299]), 1, [L7D Fail Rate Main (copy)_163185126143500299]) &gt; 0&#10;or isnull([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308]) or isnull([L7D Fail Rate Main (copy)_163185126143500299]) or [Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308] = 0&#10;then&#10;str(&#10;round(&#10;    (iif(isnull([Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308]),0,[Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308]) - iif(isnull([L7D Fail Rate Main (copy)_163185126143500299]),0,[L7D Fail Rate Main (copy)_163185126143500299])) / iif([L7D Fail Rate Main (copy)_163185126143500299] = 0 or isnull([L7D Fail Rate Main (copy)_163185126143500299]), 1, [L7D Fail Rate Main (copy)_163185126143500299]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='L7D Fill Rate Main' datatype='real' name='[L7D Fail Rate Main (copy)_163185126143500299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_same_day_last_week], [hours_planned], null)) / (sum(iif([is_same_day_last_week], [hours_planned],null)) + sum(iif([is_same_day_last_week], [hours_unassigned],null)))' />
            </column>
            <column caption='T7D Fill Rate (Previous L7D)' datatype='real' name='[T7D Fail Rate (Previous L7D) (copy)_163185126143500302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([reference_date_local]&gt;= now() - 15, [hours_planned], 0))&#10;&#10; / &#10;&#10;(SUM(iif([reference_date_local]&gt;= now() - 15, [hours_planned], 0))&#10;&#9;+&#10;&#9;SUM(iif([reference_date_local]&gt;= now() - 15, [hours_unassigned], 0)))' />
            </column>
            <column caption='T7D Fill Rate' datatype='real' default-format='p0.0%' name='[T7D Fail Rate (copy)_163185126143500300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([reference_date_local]&gt;= now() - 8, [hours_planned], 0))&#10;&#10; / &#10;&#10;(SUM(iif([reference_date_local]&gt;= now() - 8, [hours_planned], 0))&#10;&#9;+&#10;&#9;SUM(iif([reference_date_local]&gt;= now() - 8, [hours_unassigned], 0)))' />
            </column>
            <column caption='T7D Fill Rate Growth %' datatype='string' name='[T7D Fail Rate Growth % (copy)_163185126143500294]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([T7D Fail Rate (copy)_163185126143500300] - [T7D Fail Rate (Previous L7D) (copy)_163185126143500302])&#10;/&#10;[T7D Fail Rate (Previous L7D) (copy)_163185126143500302] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;&#10;([T7D Fail Rate (copy)_163185126143500300] - [T7D Fail Rate (Previous L7D) (copy)_163185126143500302])&#10;/&#10;[T7D Fail Rate (Previous L7D) (copy)_163185126143500302]&#10;*100,&#10;1&#10;)&#10;)' />
            </column>
            <column caption='Yesterday&apos;s Fill Rate Main' datatype='real' default-format='p0.0%' name='[Yesterday&apos;s Fail Rate Main (copy 2)_163185126143500308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([is_yesterday], [hours_planned], null)) / (sum(iif([is_yesterday], [hours_planned],null)) + sum(iif([is_yesterday], [hours_unassigned],null)))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
