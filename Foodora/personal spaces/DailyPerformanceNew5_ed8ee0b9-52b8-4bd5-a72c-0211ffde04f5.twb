              <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([MTD (copy 2)_382172716287561733], [successful_orders_pickup], 0))&#10;    -&#10;    SUM(iif([PMTD (copy)_382172716287787014], [successful_orders_pickup], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([PMTD (copy)_382172716287787014], [successful_orders_pickup], 0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM(iif([MTD (copy 2)_382172716287561733], [successful_orders_pickup], 0))&#10;    -&#10;    SUM(iif([PMTD (copy)_382172716287787014], [successful_orders_pickup], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([PMTD (copy)_382172716287787014], [successful_orders_pickup], 0))&#10;)&#10;* 100&#10;,1)&#10;)' />
