          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='%LO WTD' datatype='real' name='[%LO MTD (copy)_4748131018815115308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([MTD (copy 2)_382172716287561733],[lost_order_total_sum],0)) / &#10;&#10;(&#10;SUM(IIF([MTD (copy 2)_382172716287561733], [lost_order_total_sum], 0)) + &#10;SUM(IIF([MTD (copy 2)_382172716287561733], [od_successful_orders],0))&#10;)' />
            </column>
            <column caption='%LO WTD vs PWTD (Indicator)' datatype='string' name='[%LO MTD vs PMTD (Indicator) (copy)_4748131018817179698]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(LEFT([%LO MTD vs PMTD (copy)_4748131018816786480],1&#10;)&#10;=&apos;▼&apos;)&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='%LO WTD vs PWTD' datatype='string' name='[%LO MTD vs PMTD (copy)_4748131018816786480]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [%LO MTD (copy)_4748131018815115308]&#10;    -&#10;    [%LO WTD (copy)_4748131018816094253]&#10;)&#10;/&#10;(&#10;[%LO WTD (copy)_4748131018816094253]&#10;)&#10;&lt; 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [%LO MTD (copy)_4748131018815115308]&#10;    -&#10;    [%LO WTD (copy)_4748131018816094253]&#10;)&#10;/&#10;(&#10;[%LO WTD (copy)_4748131018816094253]&#10;)&#10;* 100&#10;,1)&#10;)' />
            </column>
            <column caption='%LO PWTD' datatype='real' name='[%LO WTD (copy)_4748131018816094253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([PMTD (copy)_382172716287787014],[lost_order_total_sum],0)) / &#10;&#10;(&#10;SUM(IIF([PMTD (copy)_382172716287787014], [lost_order_total_sum], 0)) + &#10;SUM(IIF([PMTD (copy)_382172716287787014], [od_successful_orders],0))&#10;)' />
