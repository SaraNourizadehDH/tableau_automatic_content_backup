              <calculation class='tableau' formula='if&#10;(&#10;    [Fill Rate Per Day By Country (MTD) (copy)_4748131018820628532] - [Fill Rate Per Day By Country (PMTD) (copy)_4748131018820763701]&#10;)&#10;&#10;/&#10;&#10;[Fill Rate Per Day By Country (PMTD) (copy)_4748131018820763701] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Fill Rate WTD vs PWTD' datatype='string' name='[Fill Rate MTD vs PMTD (copy)_4748131018821103671]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Fill Rate Per Day By Country (MTD) (copy)_4748131018820628532] - [Fill Rate Per Day By Country (PMTD) (copy)_4748131018820763701]&#10;)&#10;&#10;/&#10;&#10;[Fill Rate Per Day By Country (PMTD) (copy)_4748131018820763701] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    [Fill Rate Per Day By Country (MTD) (copy)_4748131018820628532] - [Fill Rate Per Day By Country (PMTD) (copy)_4748131018820763701]&#10;)&#10;&#10;/&#10;&#10;[Fill Rate Per Day By Country (PMTD) (copy)_4748131018820763701] * 100&#10;,1)&#10;)' />
            </column>
            <column caption='Fill Rate Per Day By Country (WTD) ' datatype='real' default-format='p0.0%' name='[Fill Rate Per Day By Country (MTD) (copy)_4748131018820628532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy 2)_382172716287561733],[hours_planned],0))&#10;/&#10;(SUM(iif([MTD (copy 2)_382172716287561733],[hours_unassigned],0)) +&#10;SUM(iif([MTD (copy 2)_382172716287561733],[hours_planned],0)))' />
            </column>
            <column caption='Fill Rate Per Day By Country (PWTD)' datatype='real' name='[Fill Rate Per Day By Country (PMTD) (copy)_4748131018820763701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_382172716287787014],[hours_planned],0))&#10;/&#10;(SUM(iif([PMTD (copy)_382172716287787014],[hours_unassigned],0)) +&#10;SUM(iif([PMTD (copy)_382172716287787014],[hours_planned],0)))' />
            </column>
            <column caption='WTD' datatype='boolean' name='[MTD (copy 2)_382172716287561733]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;,[reference_date_local]) = DATETRUNC(&apos;iso-week&apos;,{ FIXED : [Calculation_127719338234654730]})' />
            </column>
            <column caption='PWTD' datatype='boolean' name='[PMTD (copy)_382172716287787014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF ISOWEEK([reference_date_local]) = ISOWEEK(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;//AND [reference_date_local] &lt;= DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])})&#10;//AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;//THEN TRUE&#10;//END&#10;&#10;IF ISOWEEK([reference_date_local]) = ISOWEEK(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &lt;= DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])})&#10;AND YEAR([reference_date_local]) = YEAR(DATEADD(&apos;week&apos;, -1, {MAX([reference_date_local])}))&#10;AND [reference_date_local] &gt;= DATEADD(&apos;week&apos;, -1, DATE(DATETRUNC(&apos;week&apos;, {MAX([reference_date_local])})))&#10;THEN TRUE&#10;END' />
