            <column caption='Seamless Orders Per Day By Country (PMTD)' datatype='real' name='[Failed Rate Per Day By Country (MTD) (copy)_128141504189677704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max(iif([Previous L30D (copy)_128141502928400489],[seamless_orders_od],0))&#10;/&#10;max(iif([Previous L30D (copy)_128141502928400489],[successful_orders_od],0))' />
            </column>
            <column caption='Seamless Orders Per Day By Country (MTD)' datatype='real' name='[Failed Rate Per Day By Country (MTD) (copy)_169025734733328413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max(iif([PMTD (copy)_128141502928715882],[seamless_orders],0))&#10;/&#10;max(iif([PMTD (copy)_128141502928715882],[successful_orders_od_seamless],0))' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='L7D Seamless Orders Main' datatype='real' name='[L7D Fail Rate Main (copy)_169025734743109670]' role='measure' type='quantitative'>
