              <calculation class='tableau' formula='IF &#10;((SUM(IF [L1W (copy 2)] THEN [hours_planned] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [hours_planned] + [hours_unassigned] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] + [hours_unassigned] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] + [hours_unassigned] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ &#10;STR(&#10;ROUND(&#10;&#10;((SUM(IF [L1W (copy 2)] THEN [hours_planned] ELSE 0 END) / SUM(IF [L1W (copy 2)] THEN [hours_planned] + [hours_unassigned] ELSE 0 END))&#10;- (SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] + [hours_unassigned] ELSE 0 END)))&#10;/ (SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] ELSE 0 END) / SUM(IF [Calculation_6180416436320313347] THEN [hours_planned] + [hours_unassigned] ELSE 0 END))&#10;&#10;* 100&#10;, 1)&#10;)' />
