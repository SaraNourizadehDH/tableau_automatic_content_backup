            <column caption='UTR MTD' datatype='real' name='[avg DF MTD (copy)_4261038569719820293]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_128141502928715882], [orders_completed_sum], 0))&#10;/&#10;SUM(IF [PMTD (copy)_128141502928715882]&#10;THEN ([worked_hours])&#10;ELSE 0&#10;END)' />
