            <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([reference_date_local])' />
            </column>
            <column caption='start date + 7' datatype='date' name='[Calculation_378794978106404864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] + 7' />
            </column>
            <column caption='Start date + 7 Boolean' datatype='boolean' name='[Calculation_378794978108076033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_date_local] = [Calculation_378794978106404864]' />
            </column>
            <column caption='Date range' datatype='boolean' name='[Calculation_418201474534387717]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_date_local] &gt;= [Parameters].[Parameter 1] AND [reference_date_local] &lt;= [Parameters].[Parameter 1] + 7' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_6180416436319469570]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='LastD WoW' />
              </aliases>
            </column>
            <column caption='Start date Boolean' datatype='boolean' name='[Start date + 7 Boolean (copy)_378794978137718789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_date_local] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='W1 Pickup Order % (Indicator)' datatype='string' name='[W1 Order % (Indicator) (copy 2)_5566660265283784706]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_378794978108076033] THEN [successful_orders_pickup] ELSE 0 END) - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END))&#10;/ SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END) &gt; 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 Pickup Order %' datatype='string' name='[W1 Order % (copy 4)_5566660265283518465]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_378794978108076033] THEN [successful_orders_pickup] ELSE 0 END) - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [Calculation_378794978108076033] THEN [successful_orders_pickup] ELSE 0 END) - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [Calculation_378794978108076033] THEN [successful_orders_pickup] ELSE 0 END) - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END))&#10;   / SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [Calculation_378794978108076033] THEN [successful_orders_pickup] ELSE 0 END) - SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END))&#10;   / SUM(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [successful_orders_pickup] ELSE 0 END)&#10;//    SUM(IF [Start date Boolean] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Start date + 7 Boolean] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;END * 100, 1))' />
