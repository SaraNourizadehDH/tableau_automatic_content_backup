              <calculation class='tableau' formula='(AVG(IF [Calculation_378794978108076033] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END) - AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END))&#10;/ AVG(IF [Start date + 7 Boolean (copy)_378794978137718789] THEN [OD shares Per Day By Country (copy)_1037868668641845258] END)' />
