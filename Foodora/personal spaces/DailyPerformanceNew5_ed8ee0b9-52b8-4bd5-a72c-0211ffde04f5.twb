            <column caption='L7D NPS Main' datatype='real' name='[L7D AFV Main (copy)_45739685293486100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([is_3same_day_last_week],[nps_positive_ratings],0)) &#10;- SUM(iif([is_3same_day_last_week],[nps_negative_ratings],0))) * 100 &#10;/ SUM(iif([is_3same_day_last_week],[total_ratings],0))' />
