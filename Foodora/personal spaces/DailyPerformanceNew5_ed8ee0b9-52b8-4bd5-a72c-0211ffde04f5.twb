        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s AFV Main (copy)_45739686631297062] - [L7D AFV Main (copy)_45739686631391271]) / iif([L7D AFV Main (copy)_45739686631391271] = 0, 1, [L7D AFV Main (copy)_45739686631391271]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s AFV Main (copy)_45739686631297062] - [L7D AFV Main (copy)_45739686631391271]) / iif([L7D AFV Main (copy)_45739686631391271] = 0, 1, [L7D AFV Main (copy)_45739686631391271]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s AFV Main (copy)_45739686631297062] - [L7D AFV Main (copy)_45739686631391271]) / iif([L7D AFV Main (copy)_45739686631391271] = 0, 1, [L7D AFV Main (copy)_45739686631391271]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='Customer Contact Rate' datatype='real' name='[Calculation_1002191702441824256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max([total_incidents]) / max([gross_orders_non_vertical_count_incident])' />
      </column>
      <column caption='Last updated at' datatype='date' name='[Calculation_127719338234654730]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([reference_date_local])' />
      </column>
      <column caption='Orders MTD vs PMTD' datatype='string' name='[Calculation_128141502929027179]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0))&#10;    -&#10;    SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;/&#10;(&#10;SUM(iif([Previous L30D (copy)_128141502928400489], [total_number_of_successful_orders], 0))&#10;)&#10;* 100&#10;,1)&#10;)' />
      </column>
      <column caption='Revenue' datatype='real' name='[Calculation_128141504822948034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[commission_revenue_eur]+ [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]' />
      </column>
      <column caption='First and Last' datatype='boolean' name='[Calculation_1558526989775192066]' role='measure' type='nominal'>
        <calculation class='tableau' formula='FIRST()=0 OR LAST()=0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_1558526989819908101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [GMV WoW Main (Positive) (copy)_1558526989812256771] &gt; 0 THEN 1&#13;&#10;ELSEIF [GMV WoW Main (Positive) (copy)_1558526989812256771] &lt; 0 THEN -1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Seamless Orders' datatype='real' default-format='p0.0%' name='[Calculation_169025734724042753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max([seamless_orders])/max([successful_orders_od_seamless])' />
      </column>
      <column caption='Fill Rate' datatype='real' default-format='p0.0%' name='[Calculation_173670068668284928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hours_planned])/SUM((IFNULL([hours_unassigned], 0))+[hours_planned])' />
      </column>
      <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DayOfWeek' datatype='string' name='[Calculation_2636153901957091335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [reference_date_local])' />
      </column>
      <column caption='GMV RR' datatype='real' default-format='c#,##0,K&quot; €&quot;;-#,##0,K&quot; €&quot;' name='[Calculation_2662964453197135872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IIF (DATEPART(&apos;day&apos;, TODAY()) =1&#10;//,[GMV MTD],&#10;//MAX(max({FIXED [Country],[reference_date_local]:MAX([gmv_eur_rr])}), [GMV MTD])&#10;//)&#10;&#10;MAX(iif([same month last year (copy)_5566167665149526016],[gmv_eur_rr], 0))' />
      </column>
      <column caption='Days in Month' datatype='integer' name='[Calculation_2662964453198508033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,today()))))' />
      </column>
      <column caption='Within Last 21 days' datatype='boolean' name='[Calculation_2662964453460332558]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF DAY(TODAY()) = 1 AND MONTH([placed_date]) = MONTH(TODAY()-1) THEN null&#10;//ELSE&#10;[reference_date_local] &lt;= TODAY()-1&#10;AND&#10;[reference_date_local] &gt;= TODAY()-21&#10;//END' />
      </column>
      <column caption='Hours worked yesterday' datatype='real' name='[Calculation_2718626066435383301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF [L1W (copy 2)]&#10;THEN ([worked_hours])&#10;ELSE 0&#10;END)' />
      </column>
      <column caption='l7d vs previous day shops' datatype='real' name='[Calculation_310115084253265985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([L7D Orders (copy) (copy)_310115084210036770]- SUM(IF [reference_date_local] = [Parameters].[Start Date (copy) (copy)_310115084204445709] THEN [total_number_of_successful_orders] END))&#10;/&#10;SUM(IF [reference_date_local] = [Parameters].[Start Date (copy) (copy)_310115084204445709] THEN [total_number_of_successful_orders] END)' />
      </column>
      <column caption='Exec: GMV (Average line)' datatype='real' name='[Calculation_3498874746735554562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ FIXED [Calculation_418201474534387717], [country_name] : AVG([Total GFV Eur Per Day (copy 2)]) })' />
      </column>
      <column caption='customer_delivery_fee_eur_new' datatype='real' name='[Calculation_3657204422667014144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([od_df_user_paid_incl_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_delivery_priority_fee_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_service_fee_plus_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_minimum_delivery_value_eur]) / SUM(od_successful_orders))' />
      </column>
      <column caption='start date + 7' datatype='date' name='[Calculation_378794978106404864]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] + 7' />
      </column>
      <column caption='Start date + 7 Boolean' datatype='boolean' name='[Calculation_378794978108076033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_date_local] = [Calculation_378794978106404864]' />
      </column>
      <column caption='yesterday/x day' datatype='string' name='[Calculation_378794978173800456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [reference_date_local] WHEN DATE(TODAY()-1) THEN &apos;yesterday&apos;&#10;ELSE &apos;on the&apos; END' />
      </column>
      <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='2' />
        <aliases>
          <alias key='2' value=' ' />
        </aliases>
      </column>
      <column caption='Date range' datatype='boolean' name='[Calculation_418201474534387717]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_date_local] &gt;= [Parameters].[Parameter 1] AND [reference_date_local] &lt;= [Parameters].[Parameter 1] + 7' />
      </column>
      <column caption='Date range condition' datatype='boolean' name='[Calculation_418201474535948294]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], DATE(TODAY()-1)) &gt;= 7 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='figure' datatype='integer' name='[Calculation_418201474554556426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Within 8 days of last refresh' datatype='boolean' name='[Calculation_4261038569710981121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='reference_date_local &lt;= {fixed:[Calculation_127719338234654730]}&#10;AND&#10;reference_date_local &gt;= {fixed:[Calculation_127719338234654730]} -7' />
      </column>
      <column aggregation='Sum' caption='Highlight Deselector' datatype='integer' name='[Calculation_5029183781827887104]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Date Range for Start Date' datatype='date' name='[Calculation_5264496889549340679]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;    DATEDIFF(&quot;day&quot;,     [reference_date_local], { FIXED : MAX([reference_date_local])}) &gt;= 7&#10;THEN [reference_date_local]&#10;END' />
      </column>
      <column caption='AFV Eur' datatype='real' name='[Calculation_5401364105257897994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round(sum([total_gfv_eur]) / sum([total_number_of_successful_orders]),2)' />
      </column>
      <column caption='NPS Score' datatype='real' name='[Calculation_5401364116094865456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nps_positive_ratings]) &#10;- SUM([nps_negative_ratings])) * 100&#10;/ SUM([total_ratings])' />
      </column>
      <column caption='% of total Orders' datatype='real' name='[Calculation_6109836638281674769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6109836638287081491]&#10;/&#10;( &#10;sum(&#10;{fixed [country_name]: sum(iif([Calculation_378794978108076033], [total_number_of_successful_orders], 0))}&#10;)&#10;)' />
      </column>
      <column caption='Yesterday&apos;s Orders Main' datatype='integer' name='[Calculation_6109836638287081491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_378794978108076033], [total_number_of_successful_orders], null))' />
      </column>
      <column caption='Orders WoW Main (Positive)' datatype='string' name='[Calculation_6109836638295011353]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_6149806036921335808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [reference_date_local] &lt; DATEADD(&apos;day&apos;, -6, {fixed:MIN([Calculation_378794978106404864])})&#10;THEN DATEADD(&apos;day&apos;, 7, [reference_date_local])&#10;ELSE [reference_date_local]&#10;END' />
      </column>
      <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_6180416436319469570]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='LastD WoW' />
        </aliases>
      </column>
      <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[is_same_day_last_week]' />
      </column>
      <column caption='f. Exclude Today' datatype='boolean' name='[Calculation_6180416436359450629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;IIF(DATEPART(&apos;hour&apos;, NOW()) &lt;= 2, [reference_date_local] &lt;= NOW() - 2, [reference_date_local] != TODAY())' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_6180416437197033481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_delivery_time_in_minutes]) / SUM([total_number_of_successful_nonpreorder_orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_6180416437370576907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_number_of_failed_orders]) / SUM([total_number_of_orders])' />
      </column>
      <column caption='Revenue MTD vs PMTD' datatype='string' name='[Comm Rev MTD vs PMTD (copy)_128141504829669583]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;) * 100&#10;,1)&#10;)' />
      </column>
      <column caption='Revenue WoW Main (Negative)' datatype='string' name='[Comm Rev WoW Main (Negative) (copy)_128141504857403604]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / [L7D Comm Rev Main (copy)_128141504856514771] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / [L7D Comm Rev Main (copy)_128141504856514771] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / [L7D Comm Rev Main (copy)_128141504856514771] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='Revenue WoW Main (Positive)' datatype='string' name='[Comm Rev WoW Main (Positive) (copy)_128141504855920849]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / iif([L7D Comm Rev Main (copy)_128141504856514771] = 0, 1, [L7D Comm Rev Main (copy)_128141504856514771]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / iif([L7D Comm Rev Main (copy)_128141504856514771] = 0, 1, [L7D Comm Rev Main (copy)_128141504856514771]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / iif([L7D Comm Rev Main (copy)_128141504856514771] = 0, 1, [L7D Comm Rev Main (copy)_128141504856514771]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='Orders RR' datatype='real' name='[Commission RR (copy)_399694534581735424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(iif([same month last year (copy)_5566167665149526016],[orders_rr], 0))&#10;&#10;//IIF (DATEPART(&apos;day&apos;, TODAY()) =1&#10;//,[Orders MTD],&#10;//MAX(MAX({FIXED [Country],[reference_date_local]:MAX([orders_rr])}), [Orders MTD])&#10;//)' />
      </column>
      <column caption='Orders RR vs Target (Indicator)' datatype='string' name='[Commission RR vs Target (Indicator) (copy)_399694534581796866]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    [Commission RR (copy)_399694534581735424]&#10;    -&#10;    SUM(iif(MONTH([target_month]) = MONTH(today()-1) AND YEAR([target_month]) = YEAR(today()-1),[successful_orders],0))&#10;)&#10;/&#10;(&#10;SUM(iif(MONTH([target_month]) = MONTH(today()-1) AND YEAR([target_month]) = YEAR(today()-1),[successful_orders],0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Orders RR vs Target' datatype='string' name='[Commission RR vs Target (copy)_399694534581780481]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    [Commission RR (copy)_399694534581735424]&#10;    -&#10;    SUM(iif(MONTH([target_month]) = MONTH(today()-1) AND YEAR([target_month]) = YEAR(today()-1),[successful_orders],0))&#10;)&#10;/&#10;(&#10;SUM(iif(MONTH([target_month]) = MONTH(today()-1) AND YEAR([target_month]) = YEAR(today()-1),[successful_orders],0))&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Commission RR (copy)_399694534581735424]&#10;    -&#10;    SUM(iif(MONTH([target_month]) = MONTH(today()-1) AND YEAR([target_month]) = YEAR(today()-1),[successful_orders],0))&#10;)&#10;/&#10;(&#10;SUM(iif(MONTH([target_month]) = MONTH(today()-1) AND YEAR([target_month]) = YEAR(today()-1),[successful_orders],0))&#10;)&#10;* 100&#10;,1)&#10;)' />
      </column>
      <column caption='Country (copy)' datatype='string' name='[Country (copy)_216383910481940480]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Current MTD (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -7, {fixed:MIN([Calculation_378794978106404864])}) AND [reference_date_local] &lt;= {fixed:MIN([Calculation_378794978106404864])}&#10;THEN &apos;L7D&apos;&#10;ELSEIF [reference_date_local] &gt; DATEADD(&apos;day&apos;, -14, {fixed:MIN([Calculation_378794978106404864])}) AND [reference_date_local] &lt;= DATEADD(&apos;day&apos;, -7, {fixed:MIN([Calculation_378794978106404864])})&#10;THEN &apos;Previous L7D&apos;&#10;END' />
      </column>
      <column caption='Customer Contact Rate (PWTD)' datatype='real' name='[Customer Contact Rate Per Day By Country (WTD) (copy)_1002191702457262084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max(iif([MTD (copy 2)_382172716287561733],[total_incidents],0))&#10;/&#10;max(iif([PMTD (copy)_382172716287787014],[gross_orders_non_vertical_count_incident],0))' />
      </column>
      <column caption='avg DF' datatype='real' default-format='c&quot; €&quot;#,##0.00&quot; &quot;;-&quot; €&quot;#,##0.00&quot; &quot;' name='[DF (copy)_1606025851078340610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[od_customer_delivery_fee] / sum([od_successful_orders])&#10;(sum([od_df_user_paid_incl_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_delivery_priority_fee_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_service_fee_plus_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_minimum_delivery_value_eur]) / SUM(od_successful_orders))' />
      </column>
      <column caption='avg DF MTD' datatype='real' name='[DF MTD (copy)_1606025851078340611]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(SUM(iif([PMTD (copy)_128141502928715882], [od_df_user_paid_incl_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_delivery_priority_fee_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_service_fee_plus_vat_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))&#10;+&#10;(SUM(iif([PMTD (copy)_128141502928715882], [od_minimum_delivery_value_eur], 0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882], od_successful_orders, 0)))' />
