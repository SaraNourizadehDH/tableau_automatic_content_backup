    <worksheet name='Yesterday&apos; avg DF'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='18'>Average Customer Fee</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'>(Delivery Fee + MOV Fee + Service Fee + Priority Delivery Fee</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'> for successful OD orders)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main' name='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)'>
            <column caption='avg DF' datatype='real' default-format='c&quot; €&quot;#,##0.00&quot; &quot;;-&quot; €&quot;#,##0.00&quot; &quot;' name='[DF (copy)_1606025851078340610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[od_customer_delivery_fee] / sum([od_successful_orders])&#10;(sum([od_df_user_paid_incl_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_delivery_priority_fee_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_service_fee_plus_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_minimum_delivery_value_eur]) / SUM(od_successful_orders))' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH EU + Turkey&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[L1W (copy 2)]' derivation='None' name='[none:L1W (copy 2):nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[od_delivery_priority_fee_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[od_df_user_paid_incl_vat_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[od_minimum_delivery_value_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[od_service_fee_plus_vat_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[od_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[DF (copy)_1606025851078340610]' derivation='User' name='[usr:DF (copy)_1606025851078340610:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)].[none:L1W (copy 2):nk]'>
            <groupfilter function='member' level='[none:L1W (copy 2):nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)].[none:country_name:nk]'>
            <groupfilter function='member' level='[none:country_name:nk]' member='&quot;DH EU + Turkey&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)].[none:L1W (copy 2):nk]</column>
            <column>[federated.0esr49h041to0d1eolrdb0zzwgcd (copy 2)].[none:country_name:nk]</column>
          </slices>
          <aggregation value='true' />
