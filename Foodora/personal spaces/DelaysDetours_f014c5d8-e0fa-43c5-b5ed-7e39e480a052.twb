      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8BF5E4C3504040A298865B8837E34B13'>
            <properties context=''>
              <relation connection='bigquery.1tdc4iu0e3soh217iv1b41p7vmay' name='Custom SQL Query' type='text'>SELECT
  o.country_code AS o_country_code,
  o.region AS o_region,
  o.order_id AS o_order_id,
  o.platform_order_id AS o_platform_order_id,
  o.platform_order_code AS o_platform_order_code,
  o.global_order_id AS o_global_order_id,
  o.created_date AS o_created_date,
  o.created_at AS o_created_at,
  o.order_placed_at AS o_order_placed_at,
  o.city_id AS o_city_id,
  o.zone_id AS o_zone_id,
  o.fleet_id AS o_fleet_id,
  o.timezone AS o_timezone,
  o.is_preorder AS o_is_preorder,
  o.estimated_prep_time AS o_estimated_prep_time,
  o.estimated_prep_buffer AS o_estimated_prep_buffer,
  o.cod_change_for AS o_cod_change_for,
  o.cod_collect_at_dropoff AS o_cod_collect_at_dropoff,
  o.cod_pay_at_pickup AS o_cod_pay_at_pickup,
  o.delivery_fee AS o_delivery_fee,
  o.dropoff_address_id AS o_dropoff_address_id,
  o.online_tip AS o_online_tip,
  o.vendor_accepted_at AS o_vendor_accepted_at,
  o.food_is_ready_at AS o_food_is_ready_at,
  o.sent_to_vendor_at AS o_sent_to_vendor_at,
  o.sent_to_vendor_source AS o_sent_to_vendor_source,
  o.original_scheduled_pickup_at AS o_original_scheduled_pickup_at,
  o.requested_pickup_at AS o_requested_pickup_at,
  o.pickup_address_id AS o_pickup_address_id,
  o.platform AS o_platform,
  o.promised_delivery_time AS o_promised_delivery_time,
  o.updated_scheduled_pickup_at AS o_updated_scheduled_pickup_at,
  o.stacking_group AS o_stacking_group,
  d.stacked_deliveries,
  r.stack_id,
  o.order_status AS o_order_status,
  o.order_value AS o_order_value,
  o.subtotal AS o_subtotal,
  o.capacity AS o_capacity,
  o.utilization_type AS o_utilization_type,
  o.total_volume AS o_total_volume,
  o.total_weight AS o_total_weight,
  o.items_count AS o_items_count,
  o.vendor_order_number AS o_vendor_order_number,
  o.is_auto_split AS o_is_auto_split,
  o.is_auto_split_by_ice AS o_is_auto_split_by_ice,
  o.awt_id AS o_awt_id,
  o.is_crossborder AS o_is_crossborder,
  o.promised_delivery_time_upper_bound AS o_promised_delivery_time_upper_bound,
  o.promised_delivery_time_lower_bound AS o_promised_delivery_time_lower_bound,
  
  -- Extract estimated_pickup_arrival_at when state=&apos;accepted&apos; and rider matches
  (SELECT t.estimated_pickup_arrival_at 
   FROM UNNEST(d.transitions) AS t 
   WHERE t.state = &apos;accepted&apos; 
   AND t.rider_id = d.rider_id 
   ORDER BY t.created_at DESC 
   LIMIT 1) AS estimated_pickup_arrival_at_accepted,
   
  -- Extract estimated_dropoff_arrival_at when state=&apos;picked_up&apos; and rider matches  
  (SELECT t.estimated_dropoff_arrival_at 
   FROM UNNEST(d.transitions) AS t 
   WHERE t.state = &apos;picked_up&apos; 
   AND t.rider_id = d.rider_id 
   ORDER BY t.created_at DESC 
   LIMIT 1) AS estimated_dropoff_arrival_at_picked_up,

  d.id AS d_id,
  d.city_id AS d_city_id,
  d.rider_id AS d_rider_id,
  d.created_at AS d_created_at,
  d.delivery_status AS d_delivery_status,
  d.delivery_reason AS d_delivery_reason,
  d.delivery_distance AS d_delivery_distance,
  d.rider_dispatched_at AS d_rider_dispatched_at,
  d.rider_notified_at AS d_rider_notified_at,
  d.rider_accepted_at AS d_rider_accepted_at,
  d.rider_near_restaurant_at AS d_rider_near_restaurant_at,
  d.rider_picked_up_at AS d_rider_picked_up_at,
  d.rider_near_customer_at AS d_rider_near_customer_at,
  d.rider_dropped_off_at AS d_rider_dropped_off_at,

  o.cancellation.*,
  ps.pickup_distance_payment,
  ps.dropoff_distance_payment

FROM
  `fulfillment-dwh-production.curated_data_shared.orders` AS o
LEFT JOIN UNNEST(o.deliveries) AS d
LEFT JOIN UNNEST(d.routes) AS r
LEFT JOIN `fulfillment-dwh-production.curated_data_shared.rider_payment_delivery_distance_service` AS ps
  ON o.country_code = ps.country_code 
  AND o.order_id = ps.order_id 
  AND d.id = ps.delivery_id 
WHERE
  o.created_date BETWEEN &apos;2025-05-01&apos; AND &apos;2025-05-31&apos;
  AND ps.created_date BETWEEN &apos;2025-05-01&apos; AND &apos;2025-05-31&apos;
  AND o.country_code IN (&apos;at&apos;)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
