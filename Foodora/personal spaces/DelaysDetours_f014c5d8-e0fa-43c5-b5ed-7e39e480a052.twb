   FROM UNNEST(d.transitions) AS t 
   WHERE t.state = &apos;accepted&apos; 
   AND t.rider_id = d.rider_id 
   ORDER BY t.created_at DESC 
   LIMIT 1) AS estimated_pickup_arrival_at_accepted,
   
  -- Extract estimated_dropoff_arrival_at when state=&apos;picked_up&apos; and rider matches  
  (SELECT t.estimated_dropoff_arrival_at 
   FROM UNNEST(d.transitions) AS t 
   WHERE t.state = &apos;picked_up&apos; 
   AND t.rider_id = d.rider_id 
   ORDER BY t.created_at DESC 
   LIMIT 1) AS estimated_dropoff_arrival_at_picked_up,

  d.id AS d_id,
  d.city_id AS d_city_id,
  d.rider_id AS d_rider_id,
  d.created_at AS d_created_at,
  d.delivery_status AS d_delivery_status,
  d.delivery_reason AS d_delivery_reason,
  d.delivery_distance AS d_delivery_distance,
  d.rider_dispatched_at AS d_rider_dispatched_at,
  d.rider_notified_at AS d_rider_notified_at,
  d.rider_accepted_at AS d_rider_accepted_at,
