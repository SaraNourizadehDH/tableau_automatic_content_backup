      </connection>
      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([o_order_id]) / TOTAL(COUNTD([o_order_id]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='effective_delivery_time_min' datatype='integer' name='[Calculation_1591178065212817427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [d_rider_accepted_at], [d_rider_near_restaurant_at]) +&#10;DATEDIFF(&apos;minute&apos;, [d_rider_picked_up_at], [d_rider_near_customer_at])' />
      </column>
      <column caption='Created_at_oslo_time' datatype='datetime' name='[Calculation_1591178065213857812]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF MONTH([d_created_at]) &gt;= 4 AND MONTH([d_created_at]) &lt;= 10 THEN&#10;    DATEADD(&apos;hour&apos;, 2, [d_created_at])  // DST (April to October)&#10;ELSE&#10;    DATEADD(&apos;hour&apos;, 1, [d_created_at])  // Standard Time&#10;END' />
      </column>
      <column caption='is_delay' datatype='boolean' name='[Calculation_1591178065920753687]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5380816414855278623] &gt; 0 then TRUE ELSE FALSE END' />
      </column>
      <column caption='is_stacked' datatype='boolean' name='[Calculation_1591178065921474584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stacked_deliveries] &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Delay 90th percentile' datatype='real' name='[Calculation_1591178065925845018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='PERCENTILE([Calculation_5380816414855278623],0.9)' />
      </column>
      <column caption='90th_delay' datatype='boolean' name='[Calculation_1591178065926516763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5380816414855278623] &gt;= { FIXED : PERCENTILE([Calculation_5380816414855278623], 0.9) }&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='filtered_delay_orders' datatype='integer' name='[Calculation_1591178065927766044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//filter order between -30 and 30&#10;COUNTD(&#10;  IF [Calculation_5380816414855278623] &gt;= -30 &#10;     AND [Calculation_5380816414855278623] &lt;= 30&#10;  THEN [o_platform_order_code]&#10;  END&#10;)' />
      </column>
      <column caption='filtered_delay_90th_percentile' datatype='real' name='[Calculation_1591178065928654877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This will compute the 90th‐percentile of only those delays between -30 and +30&#10;PERCENTILE(&#10;  IF [Calculation_5380816414855278623] &gt;= -30&#10;     AND [Calculation_5380816414855278623] &lt;= 30&#10;  THEN [Calculation_5380816414855278623]&#10;  END,&#10;  0.9&#10;)' />
      </column>
      <column caption='pickup_to_dropoff_min' datatype='integer' name='[Calculation_2693997024623394848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;,[d_rider_picked_up_at],[d_rider_near_customer_at])' />
      </column>
      <column caption='pu_do_delay_min' datatype='integer' name='[Calculation_5380816414855278623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [d_rider_picked_up_at], [estimated_dropoff_arrival_at_picked_up])&#10;-&#10;DATEDIFF(&apos;minute&apos;, [d_rider_picked_up_at], [d_rider_near_customer_at])' />
      </column>
      <column caption='Delivery Time' datatype='integer' name='[Calculation_8774067627765530639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;,[d_rider_accepted_at],[d_rider_dropped_off_at])' />
      </column>
