    <worksheet name='Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='12'>RM Dashboard</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/SEAccountManagementDashboard/Details?rev=' id='Details' path='/t/Foodora/workbooks/SEAccountManagementDashboard' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='report_rm (bl_bi)' name='federated.1g0496b1llvnrp122mxmg1q1ujox' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Team' caption='Parameter 1' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Team Lead&quot;'>
              <calculation class='tableau' formula='&quot;Team Lead&quot;' />
              <aliases>
                <alias key='&quot;Team Lead&quot;' value='Team' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1g0496b1llvnrp122mxmg1q1ujox'>
            <column caption='AdTech vs BU (Pace)' datatype='real' name='[% MoM (AdTech vs Pace) (copy)_4347944000017322003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1557964024358113280])/SUM([Calculation_4347944000017276946])' />
            </column>
            <column caption='% Vendors w Deal' datatype='real' name='[% Orders w Deal (copy)_2043226917848866825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_discounts])/SUM([vendor_discounts_den])' />
            </column>
            <column caption='% Self Bookings (Joker) ' datatype='real' default-format='p0.0%' name='[% Self Bookings (CPC) (copy)_133700649028288512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_vendor_external])&#13;&#10;/&#13;&#10;SUM([joker_vendor_all])' />
            </column>
            <column caption='% Image Coverage (Mains)' datatype='real' name='[% VP adoption (copy)_2043226917853339661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([products_image])/SUM([products])' />
            </column>
            <column caption='% Vendors w CPC' datatype='real' default-format='p0%' name='[% Vendors w AdTech (copy)_2072500258018422784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_w_cpc_budget])&#13;&#10;/&#13;&#10;SUM([active_vendors])' />
            </column>
            <column caption='% VP adoption' datatype='real' name='[% Vendors w Deal (copy)_2043226917853261836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([has_portal_session])/SUM([vendors_online])' />
            </column>
            <column caption='% Vendors w Joker' datatype='real' default-format='p0%' name='[% Vendors w Deal (copy)_2072500258030784513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_vendor_active])/SUM([active_vendors])' />
            </column>
            <column caption='% Vendors w Display Ad' datatype='real' default-format='p0%' name='[% Vendors w Targeted Deals (copy)_2072500258031296514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([display_ad_vendor_all])/SUM([active_vendors])' />
            </column>
            <column caption='AFV (LC)' datatype='real' name='[AOV (LC) (copy)_2043226917838807045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local])/SUM([successful_orders])' />
            </column>
            <column caption='AFV (LC) vs LM' datatype='real' name='[AOV (LC) vs LM (copy)_2043226917838819334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gfv_local])/SUM([successful_orders]))&#13;&#10;/(SUM([gfv_local_pm])/SUM([successful_orders_pm]))&#13;&#10;-1' />
            </column>
            <column caption='AdTech Total PM' datatype='real' name='[AdTech Total (copy)_4347944000016474126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([cpc_revenue_pm],0)&#13;&#10;+IFNULL([joker_revenue_pm],0)&#13;&#10;+IFNULL([display_ad_revenue_pm],0)' />
            </column>
            <column caption='AdTech Pace' datatype='integer' name='[AdTech Total (copy)_4347944000016605200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([cpc_revenue_pace],0)&#13;&#10;+IFNULL([joker_revenue_pace],0)&#13;&#10;+IFNULL([display_ad_revenue_pace],0)&#13;&#10;+IFNULL([targeted_deal_revenue_pace],0)' />
            </column>
            <column caption='RR vs LM (Pace)' datatype='real' name='[AdTech vs BU (Pace) (copy)_2433632700978589701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_revenue_pace])/SUM([joker_revenue_pm])-1' />
            </column>
            <column caption='CPC vs LM (Pace)' datatype='real' name='[AdTech vs LM (Pace) (copy)_1422011635719233537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue_pace])/SUM([cpc_revenue_pm])-1' />
            </column>
            <column caption='AdTech - CPC' datatype='real' name='[Calculation_1422011635719684098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_revenue])' />
            </column>
            <column caption='IFNULL( (IFNULL(SUM([cpc_revenue_external]), 0) + IFNULL(SUM(...' datatype='real' name='[Calculation_1426515230474100737]' role='measure' type='quantitative' user:unnamed='Details'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;  (IFNULL(SUM([cpc_revenue_external]), 0) + &#13;&#10;   IFNULL(SUM([joker_revenue_external]), 0) + &#13;&#10;   IFNULL(SUM([display_ad_revenue_external]), 0)) / &#13;&#10;  (IFNULL(SUM([display_ad_revenue]), 0) + &#13;&#10;   IFNULL(SUM([joker_revenue]), 0) + &#13;&#10;   IFNULL(SUM([cpc_revenue]), 0)),&#13;&#10;  0&#13;&#10;)' />
            </column>
            <column caption='IFNULL( (IFNULL(SUM([cpc_revenue_external]), 0) + IFNULL(SUM(...' datatype='real' name='[Calculation_1426515230474215427]' role='measure' type='quantitative' user:unnamed='Details'>
              <calculation class='tableau' formula='IFNULL(&#13;&#10;  (IFNULL(SUM([cpc_revenue_external]), 0) + &#13;&#10;   IFNULL(SUM([joker_revenue_external]), 0) + &#13;&#10;   IFNULL(SUM([display_ad_revenue_external]), 0)) / &#13;&#10;  IFNULL(SUM([adtech_budget]), 1),&#13;&#10;  0&#13;&#10;)' />
            </column>
            <column caption='Total AdTech Pace' datatype='integer' name='[Calculation_1557964024358113280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([cpc_revenue_pace],0)) + SUM(IFNULL([joker_revenue_pace],0)) + SUM(IFNULL([display_ad_revenue_pace],0)) + SUM(IFNULL([targeted_deal_revenue_pace], 0))' />
            </column>
            <column caption='% VFD Total' datatype='real' default-format='p0.0%' name='[Calculation_1557964024445640705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(([vfd_value]))/SUM([gmv_local])' />
            </column>
            <column caption='% VFD Performance' datatype='real' default-format='p0.0%' name='[Calculation_1557964024449282050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1557964024445640705] / AVG([Calculation_1557964024450105347]))' />
            </column>
            <column caption='VFD Target' datatype='real' default-format='p0.0%' name='[Calculation_1557964024450105347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vfd_target] &gt; 0 THEN [vfd_target] END' />
            </column>
            <column caption='AdTech - % of GMV' datatype='real' name='[Calculation_2043226917837217796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4347944000015929357])/SUM([gmv_local])' />
            </column>
            <column caption='% Vendors w Targeted Deals' datatype='real' default-format='p0%' name='[Calculation_214202523541508096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([targeted_deal_vendor_all])/SUM([total_vendors])' />
            </column>
            <column caption='# New Vendors' datatype='integer' name='[Calculation_2433632700976283648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([activated_vendors])' />
            </column>
            <column caption='% VFD' datatype='real' name='[Calculation_2433632700976467969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_funded_discounts])&#13;&#10;/&#13;&#10;SUM([vendor_discounts_den])' />
            </column>
            <column caption='CPP vs LM (%)' datatype='real' name='[Calculation_2433632700977717251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpp_revenue])&#13;&#10;/&#13;&#10;SUM([cpp_revenue_pm])&#13;&#10;-1' />
            </column>
            <column caption='AdTech - CPP' datatype='real' name='[Calculation_2433632700978388996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpp_revenue])' />
            </column>
            <column caption='# Vendors Online' datatype='integer' name='[Calculation_34339949156904961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_online])' />
            </column>
            <column caption='Report Month Filter' datatype='string' name='[Calculation_4137963670630465536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([Calculation_4137963670642606082]) = LEFT(STR(DATE(DATEADD(&apos;month&apos;,-0,DATETRUNC(&apos;month&apos;,TODAY())))),7) &#13;&#10;    THEN &apos;Current Month&apos;&#13;&#10;ELSE STR([Calculation_4137963670642606082]) END' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_4137963670642606082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_4347944000014827525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders]' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_4347944000015032327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_local]' />
            </column>
            <column caption='GMV vs LM' datatype='real' name='[Calculation_4347944000015114248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])/SUM([gmv_local_pm])-1' />
            </column>
            <column caption='% Orders w Deal' datatype='real' name='[Calculation_4347944000015368201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_discount])/SUM([successful_orders])' />
            </column>
            <column caption='AdTech - RR' datatype='real' name='[Calculation_4347944000015802380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[joker_revenue]' />
            </column>
            <column caption='AdTech Total' datatype='real' name='[Calculation_4347944000015929357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([cpc_revenue],0)&#13;&#10;+IFNULL([joker_revenue],0)&#13;&#10;+IFNULL([display_ad_revenue],0)&#13;&#10;+IFNULL([targeted_deal_revenue],0)' />
            </column>
            <column caption='AdTech vs LM (Pace)' datatype='real' name='[Calculation_4347944000016760849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AdTech Total (copy)_4347944000016605200])/SUM([AdTech Total (copy)_4347944000016474126])-1' />
            </column>
            <column caption='AdTech BU' datatype='real' name='[Calculation_4347944000017276946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[adtech_budget]' />
            </column>
            <column caption='(SUM([deal_value_percentage_vendor_od]) + SUM([deal_value_fd_...' datatype='real' name='[Calculation_496803391972458500]' role='measure' type='quantitative' user:unnamed='Overview'>
              <calculation class='tableau' formula='(SUM([deal_value_percentage_vendor_od]) + SUM([deal_value_fd_vendor_od]) + SUM([deal_value_other_od])) / SUM([gmv_local_od])' />
            </column>
            <column caption='(SUM([deal_value_percentage_vendor_vd]) + SUM([deal_value_fd_...' datatype='real' name='[Calculation_496803391972843525]' role='measure' type='quantitative' user:unnamed='Overview'>
              <calculation class='tableau' formula='(SUM([deal_value_percentage_vendor_vd]) + SUM([deal_value_fd_vendor_vd]) + SUM([deal_value_other_vd])) / SUM([gmv_local_vd])' />
            </column>
            <column caption='SUM([vendors_w_cpc_budget])/SUM([vendor_discounts_den])' datatype='real' name='[Calculation_768989639619899397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_w_cpc_budget])/SUM([vendor_discounts_den])' />
            </column>
            <column caption='SUM(joker_vendor_all)/SUM([vendor_discounts_den])' datatype='real' name='[Calculation_768989639620214791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(joker_vendor_all)/SUM([vendor_discounts_den])' />
            </column>
            <column caption='CPC BU vs LM (SEK)' datatype='real' name='[Calculation_865817083141390336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cpc_booking_budget])&#13;&#10;-&#13;&#10;SUM([cpc_booking_budget_pm])' />
            </column>
            <column caption='% Self Bookings (CPC)' datatype='real' name='[Calculation_865817083142873089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adtech_cpc_external])&#13;&#10;/&#13;&#10;SUM([cpc_bookings])' />
            </column>
            <column caption='# Deals vs LM' datatype='integer' name='[Calculation_865817083144990722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_discounts])&#13;&#10;-&#13;&#10;SUM([vendor_discounts_pm])' />
            </column>
            <column caption='% Vendors w AdTech' datatype='real' name='[Calculation_865817083146686467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adtech_vendors])&#13;&#10;/&#13;&#10;SUM([active_vendors])' />
