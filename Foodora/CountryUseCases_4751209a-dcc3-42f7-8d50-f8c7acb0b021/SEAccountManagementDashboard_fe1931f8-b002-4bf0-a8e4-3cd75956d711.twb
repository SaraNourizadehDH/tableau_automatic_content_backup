            <column caption='% Self Bookings (Joker) ' datatype='real' default-format='p0.0%' name='[% Self Bookings (CPC) (copy)_133700649028288512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_vendor_external])&#13;&#10;/&#13;&#10;SUM([joker_vendor_all])' />
            </column>
            <column caption='AFV (LC)' datatype='real' name='[AOV (LC) (copy)_2043226917838807045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local])/SUM([successful_orders])' />
            </column>
            <column caption='AFV (LC) vs LM' datatype='real' name='[AOV (LC) vs LM (copy)_2043226917838819334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gfv_local])/SUM([successful_orders]))&#13;&#10;/(SUM([gfv_local_pm])/SUM([successful_orders_pm]))&#13;&#10;-1' />
