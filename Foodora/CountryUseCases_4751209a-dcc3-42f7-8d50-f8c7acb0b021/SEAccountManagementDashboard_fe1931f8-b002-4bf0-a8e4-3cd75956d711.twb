            </column>
            <column caption='RR vs LM (Pace)' datatype='real' name='[AdTech vs BU (Pace) (copy)_2433632700978589701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_revenue_pace])/SUM([joker_revenue_pm])-1' />
