            <column caption='GMV (VFD) vs GMV' datatype='real' name='[Calculation_865817083148361732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_discounts_vendor])&#13;&#10;/&#13;&#10;SUM([Calculation_4347944000015032327])' />
            </column>
            <column caption='View(+)' datatype='string' name='[Calculation_875105759356858368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Region&quot; THEN [am_region]&#13;&#10;WHEN &quot;Team Lead&quot; THEN [am_team_lead]&#13;&#10;END' />
            </column>
            <column caption='(SUM([vendors_gmv_class_a_w_discount]) + SUM([vendors_gmv_cla...' datatype='real' name='[Calculation_92886794472398858]' role='measure' type='quantitative' user:unnamed='Overview'>
              <calculation class='tableau' formula='(SUM([vendors_gmv_class_a_w_discount]) + SUM([vendors_gmv_class_b_w_discount])) / (SUM([active_vendors_gmv_class_a]) + SUM([active_vendors_gmv_class_b]))&#13;&#10;' />
            </column>
            <column caption='(SUM([vendors_gmv_class_a_w_discount]) + SUM([vendors_gmv_cla...' datatype='real' name='[Calculation_92886794473689103]' role='measure' type='quantitative' user:unnamed='Overview'>
              <calculation class='tableau' formula='(SUM([vendors_gmv_class_a_w_discount]) + SUM([vendors_gmv_class_b_w_discount])) / (SUM([active_vendors_gmv_class_a]) + SUM([active_vendors_gmv_class_b]) + SUM([active_vendors_gmv_class_c]) + SUM([active_vendors_gmv_class_d]))&#13;&#10;' />
            </column>
            <column caption='% VFD From Discounts' datatype='real' name='[Calculation_980940343419162630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deal_value_percentage_vendor])/SUM([gmv_local])' />
            </column>
            <column caption='% VFD From FD' datatype='real' name='[Calculation_980940343419191303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deal_value_fd_vendor])/SUM([gmv_local])' />
            </column>
            <column caption='% VFD From Other' datatype='real' name='[Calculation_980940343419219977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deal_value_other])/SUM([gmv_local])' />
