            <column caption='AdTech Total PM' datatype='real' name='[AdTech Total (copy)_4347944000016474126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([cpc_revenue_pm],0)&#13;&#10;+IFNULL([joker_revenue_pm],0)&#13;&#10;+IFNULL([display_ad_revenue_pm],0)' />
