            <column caption='(SUM([deal_value_percentage_vendor]) + SUM([deal_value_fd_ven...' datatype='real' name='[Calculation_92886794092339203]' role='measure' type='quantitative' user:unnamed='Overview'>
              <calculation class='tableau' formula='(SUM([deal_value_percentage_vendor]) + SUM([deal_value_fd_vendor]) + SUM([deal_value_other])) / SUM([Calculation_4347944000015032327])' />
