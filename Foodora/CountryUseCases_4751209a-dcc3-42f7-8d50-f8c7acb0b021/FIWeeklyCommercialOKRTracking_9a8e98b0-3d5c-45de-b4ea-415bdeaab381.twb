              <calculation class='tableau' formula='SUM(&#10;    IF [gmv_class] IN (&quot;A&quot;, &quot;B&quot;) THEN [discounts] ELSE 0 END&#10;    )&#10;&#10;/&#10;&#10;&#10;SUM(&#10;    IF [gmv_class] IN (&quot;A&quot;, &quot;B&quot;) THEN [non_zombie_vendors] ELSE 0 END&#10;    )' />
