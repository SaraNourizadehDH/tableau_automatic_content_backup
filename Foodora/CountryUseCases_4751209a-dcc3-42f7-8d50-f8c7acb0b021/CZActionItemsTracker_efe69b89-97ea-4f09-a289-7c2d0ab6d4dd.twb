  <worksheets>
    <worksheet name='Action Items Picture Coverage and Top N Coverage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='action items' name='federated.00i21ue15avwkz17rnlkm1smtxde' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N Items' datatype='integer' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00i21ue15avwkz17rnlkm1smtxde'>
            <column caption='Action Products with Picture' datatype='integer' name='[Action Products Total (copy)_1001206492164526082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [has_dish_image] THEN [product_id (action_items_dish_images)] END)' />
            </column>
            <column caption='Action Products w/o Picture' datatype='integer' name='[Action Products with Picture (copy)_1001206492164603907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF NOT [has_dish_image] THEN [product_id (action_items_dish_images)] END)' />
            </column>
            <column caption='Action Products Total' datatype='integer' name='[Calculation_1001206492164333569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([product_id (action_items_dish_images)])' />
            </column>
            <column caption='% of missing Pictures' datatype='real' name='[Calculation_1001206492164788228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Action Products with Picture (copy)_1001206492164603907]/[Calculation_1001206492164333569]' />
            </column>
            <column caption='Deal Items in Top N' datatype='integer' name='[Calculation_1221601455900749826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [product_rank_gmv] &lt;= [Parameters].[Parameter 3] THEN [product_id (action_items_dish_images)] END)' />
            </column>
            <column caption='Vendor Code Total Price' datatype='real' name='[Calculation_1221601455910436867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [vendor_code]: SUM([total_price_local (action_items_top_products)])}' />
            </column>
            <column caption='Top N Product GMV Share' datatype='real' default-format='p0%' name='[Calculation_1221601455910985734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendor Code Total Price (copy)_1221601455910805509]/[Calculation_1221601455910436867]' />
            </column>
            <column caption='Camp Name is not Null' datatype='boolean' name='[Calculation_1684909268594728960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([campaign_name_vendor (action_items_dish_images)])' />
            </column>
            <column caption='Top N Share in Action Products' datatype='real' default-format='p0%' name='[Calculation_2040975119407620096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1221601455900749826]/[Calculation_1001206492164333569]' />
            </column>
            <column caption='Vendor Code Total Price Top N' datatype='real' name='[Vendor Code Total Price (copy)_1221601455910805509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [vendor_code]: SUM(IF [product_rank_gmv (action_items_top_products)] &lt;= [Parameters].[Parameter 3] THEN [total_price_local (action_items_top_products)] ELSE 0 END)}' />
            </column>
            <column caption='Campaign Name' datatype='string' name='[campaign_name_vendor (action_items_dish_images)]' role='dimension' type='nominal' />
