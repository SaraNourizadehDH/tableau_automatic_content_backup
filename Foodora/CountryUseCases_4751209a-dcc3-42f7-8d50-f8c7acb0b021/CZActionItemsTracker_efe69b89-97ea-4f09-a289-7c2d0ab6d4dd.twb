      <column caption='Action Products with Picture' datatype='integer' name='[Action Products Total (copy)_1001206492164526082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_dish_image] THEN [product_id (action_items_dish_images)] END)' />
      </column>
      <column caption='Action Products w/o Picture' datatype='integer' name='[Action Products with Picture (copy)_1001206492164603907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT [has_dish_image] THEN [product_id (action_items_dish_images)] END)' />
      </column>
      <column caption='Relative Price Increase' datatype='real' name='[Calculation_1001206492163063808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_810366513495953408]/MAX(1,MAX([previous_price]))' />
      </column>
      <column caption='Action Products Total' datatype='integer' name='[Calculation_1001206492164333569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([product_id (action_items_dish_images)])' />
      </column>
      <column caption='% of missing Pictures' datatype='real' name='[Calculation_1001206492164788228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Action Products with Picture (copy)_1001206492164603907]/[Calculation_1001206492164333569]' />
      </column>
      <column caption='Items in Deal' datatype='integer' name='[Calculation_1221601455900401665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([product_id (action_items_dish_images)])' />
      </column>
      <column caption='Deal Items in Top N' datatype='integer' name='[Calculation_1221601455900749826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [product_rank_gmv] &lt;= [Parameters].[Parameter 3] THEN [product_id (action_items_dish_images)] END)' />
      </column>
      <column caption='Vendor Code Total Price' datatype='real' name='[Calculation_1221601455910436867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_code]: SUM([total_price_local (action_items_top_products)])}' />
      </column>
      <column caption='Top N Product GMV Share' datatype='real' default-format='p0%' name='[Calculation_1221601455910985734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendor Code Total Price (copy)_1221601455910805509]/[Calculation_1221601455910436867]' />
      </column>
      <column caption='Days without VFD' datatype='integer' name='[Calculation_1260726486213357568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[data_date]-[last_vfd_date]' />
      </column>
      <column caption='Days since last vfd' datatype='string' name='[Calculation_1260726486213840897]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Days since last VFD&quot;' />
      </column>
      <column caption='Last Order Date' datatype='date' name='[Calculation_1260726486217232386]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([last_order_valid_at_local])' />
      </column>
      <column caption='Camp Util Rel Decrease' datatype='real' name='[Calculation_1407937891266080768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[camp_util_decrease]/[camp_util_previous]' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1407937891266945025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_local])' />
      </column>
      <column caption='Min Date in Data' datatype='date' name='[Calculation_1407937891510861827]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED: MIN(MIN(MIN([date_change]),MIN([last_vfd_date])), MIN([period_from]))}' />
      </column>
      <column caption='Date Change Filter' datatype='boolean' name='[Calculation_1407937891511660549]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date_change] &gt;= [Parameters].[Parameter 2]&#13;&#10;AND&#13;&#10;[date_change] &lt;= [Parameters].[Date From (copy)_1407937891510284290]' />
      </column>
      <column caption='Util Date Filter' datatype='boolean' name='[Calculation_1407937891511869446]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[period_from] &lt;= [Parameters].[Date From (copy)_1407937891510284290]&#13;&#10;AND&#13;&#10;[period_to] &gt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='Hours Offline text' datatype='string' name='[Calculation_1407937891515654152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Hours Offline&quot;' />
      </column>
      <column aggregation='Max' caption='Camp Util Decrease' datatype='real' default-format='n#,##0&quot;pb&quot;;-#,##0&quot;pb&quot;' name='[Calculation_1407937891523805196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*[camp_util_decrease]' />
