      <table>
        <view>
          <datasources>
            <datasource caption='action items' name='federated.00i21ue15avwkz17rnlkm1smtxde' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.00i21ue15avwkz17rnlkm1smtxde].[Min Date in Data (copy)_1407937891511197700]' caption='Date To' datatype='date' default-format='*dd-mmm-yyyy' name='[Date From (copy)_1407937891510284290]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-29#'>
              <calculation class='tableau' formula='#2025-07-29#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.00i21ue15avwkz17rnlkm1smtxde].[Calculation_1407937891510861827]' caption='Date From' datatype='date' default-format='*dd-mmm-yyyy' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2024-08-01#'>
              <calculation class='tableau' formula='#2024-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00i21ue15avwkz17rnlkm1smtxde'>
            <column caption='Camp Util Rel Decrease' datatype='real' name='[Calculation_1407937891266080768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[camp_util_decrease]/[camp_util_previous]' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1407937891266945025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])' />
            </column>
            <column caption='Min Date in Data' datatype='date' name='[Calculation_1407937891510861827]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED: MIN(MIN(MIN([date_change]),MIN([last_vfd_date])), MIN([period_from]))}' />
            </column>
            <column caption='Util Date Filter' datatype='boolean' name='[Calculation_1407937891511869446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[period_from] &lt;= [Parameters].[Date From (copy)_1407937891510284290]&#13;&#10;AND&#13;&#10;[period_to] &gt;= [Parameters].[Parameter 2]' />
            </column>
            <column aggregation='Max' caption='Camp Util Decrease' datatype='real' default-format='n#,##0&quot;pb&quot;;-#,##0&quot;pb&quot;' name='[Calculation_1407937891523805196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*[camp_util_decrease]' />
            </column>
            <column caption='price_id' datatype='string' name='[Calculation_810366513496862721]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_code (action_items_price_changes)] + &quot;_&quot; + [product_name] + &quot;_&quot; + STR([date_change])' />
            </column>
            <column caption='Combined Decrease' datatype='real' name='[Calculation_810366513522835459]' role='measure' type='quantitative'>
