      <column caption='Refunds/GFV MoM%' datatype='real' default-format='p0.00%' name='[Beräkning1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Total Refund Cost (kopiera)_1037516826553368577])) - LOOKUP(ZN(SUM([Total Refund Cost (kopiera)_1037516826553368577])), -1)) / ABS(LOOKUP(ZN(SUM([Total Refund Cost (kopiera)_1037516826553368577])), -1))'>
          <table-calc ordering-field='[federated.1qufohi096nhx8176dmfj07a0r02].[tmn:Calculation_574208985672069142:qk]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Refunds/GFV' datatype='real' name='[Calculation_1037516826542313472]' role='measure' type='quantitative'>
