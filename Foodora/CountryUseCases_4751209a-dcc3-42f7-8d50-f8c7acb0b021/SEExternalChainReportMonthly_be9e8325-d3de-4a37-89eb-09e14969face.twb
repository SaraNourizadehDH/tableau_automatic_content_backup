              <calculation class='tableau' formula='IF NOT ISNULL(&#10;    IF [Parameters].[Parameter 3] = [chain_name] THEN [chain_name] END&#10;) THEN &quot;Show&quot; ELSE &quot;Hide&quot; END' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_843299087684050945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [report_month]=[Parameters].[Parameter 1] then [valid_orders] END)' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_843299087684358146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [report_month]=[Parameters].[Parameter 1] then [gfv_local] END)' />
            </column>
            <column caption='Avg Basket size' datatype='real' name='[Calculation_843299087686795268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [report_month]=[Parameters].[Parameter 1] then [gfv_local] END)/sum(if [report_month]=[Parameters].[Parameter 1] then [valid_orders] END)' />
            </column>
            <column caption='Delivery Share of Orders' datatype='real' name='[Calculation_843299087688974344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum([valid_orders_pickup (kopiera)_843299087688728582])/sum([valid_orders_delivery (kopiera)_843299087688855559]))' />
            </column>
            <column caption='% Closed Hours' datatype='real' name='[Calculation_843299087690575881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [report_month]=[Parameters].[Parameter 1] then [closed_hours] end)/sum(if [report_month]=[Parameters].[Parameter 1] then [hours_open] end)' />
            </column>
            <column caption='% Vendor Late &gt; 10 Mins' datatype='real' name='[Calculation_843299087691739147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [report_month]=[Parameters].[Parameter 1] then [vendor_late_count10] END)/sum(if [report_month]=[Parameters].[Parameter 1] then [vendor_late_obs] END)' />
            </column>
            <column caption='Avg Food Rating' datatype='real' name='[Calculation_843299087692414988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [report_month]=[Parameters].[Parameter 1] then [oi_food_rating_sum] END) / SUM(if [report_month]=[Parameters].[Parameter 1] then [food_rating_cnt] END)' />
            </column>
            <column caption='% Reorder Rate' datatype='real' name='[Calculation_843299087692812301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [report_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) then [v_reorder30] END)/SUM(if [report_month]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) then [reorder30_den] END)' />
            </column>
            <column caption='Frequency' datatype='real' name='[Successful Orders (kopiera)_843299087702720528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [report_month]=[Parameters].[Parameter 1] then [valid_orders] END)/SUM(if [report_month]=[Parameters].[Parameter 1] then[monthly_customers] END)' />
