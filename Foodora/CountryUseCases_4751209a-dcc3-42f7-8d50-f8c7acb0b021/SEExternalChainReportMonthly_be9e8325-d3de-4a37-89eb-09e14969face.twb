      <column caption='Avg Food Ratings' datatype='real' name='[Avg Food Rating (kopiera)_1037516826566840331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([oi_food_rating_sum]) / SUM([food_rating_cnt])' />
