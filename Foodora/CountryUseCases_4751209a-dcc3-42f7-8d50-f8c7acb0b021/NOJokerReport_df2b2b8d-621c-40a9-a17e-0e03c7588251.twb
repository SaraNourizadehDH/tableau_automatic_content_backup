      </column>
      <column caption='AVG Views Per Joker Sold' datatype='real' name='[Calculation_1241867615160115207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_views])&#13;&#10;/&#13;&#10;SUM([joker_orders])' />
      </column>
      <column caption='% Inventory Sold New' datatype='real' name='[Calculation_1241867615236075528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_vendor_month_sold])&#13;&#10;/&#13;&#10;SUM([new_vendor_month_inventory])' />
      </column>
      <column caption='% Daily Sold Inventory - Blanded' datatype='real' name='[Calculation_139611608602636288]' role='measure' type='quantitative'>
