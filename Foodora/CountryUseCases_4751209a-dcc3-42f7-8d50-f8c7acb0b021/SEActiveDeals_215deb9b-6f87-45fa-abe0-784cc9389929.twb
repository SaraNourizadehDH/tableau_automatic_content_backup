    <worksheet name='Active Deals'>
      <table>
        <view>
          <datasources>
            <datasource caption='bl_bi' name='federated.0hvorvi0mf58cm16ndo3e1mb5ooi' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0hvorvi0mf58cm16ndo3e1mb5ooi'>
            <column caption='Logistics City ' datatype='string' name='[Calculation_2616239600969142272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([lg_city], &quot;Non-Logistics Area&quot;)' />
            </column>
            <column caption='Discount Type ' datatype='string' name='[Calculation_2616239600969920513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE LOWER([discount_type])&#10;    WHEN &quot;percentage&quot; THEN &quot;Percentage&quot;&#10;    WHEN &quot;free_delivery&quot; THEN &quot;Free Delivery&quot;   &#10;    WHEN &quot;composite&quot; THEN &quot;Composite&quot;&#10;    ELSE [discount_type]&#10;END' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_2616239600976089090]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [vendor_type]&#10;    WHEN &quot;darkstores&quot; THEN &quot;DMART&quot;&#10;    WHEN &quot;restaurants&quot; THEN &quot;Restaurants&quot;&#10;    ELSE &quot;Shops&quot;&#10;END' />
            </column>
            <column caption='# Active Deals' datatype='integer' name='[Calculation_2616239600983306245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([discount_uuid])' />
            </column>
            <column caption='Deal Period' datatype='string' name='[Calculation_2616239601008553991]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE ISNULL(STR([end_date]))&#10;WHEN TRUE THEN STR([start_date])+ &quot; onward&quot;&#10;ELSE STR([start_date])+ &quot; to &quot;+ IFNULL(STR([end_date]),&apos;&apos;)&#10;END' />
            </column>
            <column caption='Funding' datatype='string' name='[Calculation_2616239602438635528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE ISNULL([funding_type]) AND ([is_subscription_discount] OR [vendor_delivery_type] = &quot;VD&quot;)&#10;    WHEN TRUE THEN &quot;Unavailable&quot;&#10;    WHEN FALSE THEN [funding_type]&#10;END' />
            </column>
            <column caption='Has PRO Discount' datatype='boolean' name='[Calculation_5432255980774912003]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [has_deal] THEN [is_subscription_discount] ELSE FALSE END' />
            </column>
            <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Discount Amount' datatype='real' default-format='p0%' name='[amount_local]' role='dimension' type='ordinal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[Calculation_2616239600983306245]' derivation='User' name='[cum:usr:Calculation_2616239600983306245:qk:6]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='CellInPane' type='CumTotal' />
            </column-instance>
            <column caption='Discount Type' datatype='string' hidden='true' name='[discount_type]' role='dimension' type='nominal' />
            <column caption='Discount Uuid' datatype='string' name='[discount_uuid]' role='dimension' type='nominal' />
