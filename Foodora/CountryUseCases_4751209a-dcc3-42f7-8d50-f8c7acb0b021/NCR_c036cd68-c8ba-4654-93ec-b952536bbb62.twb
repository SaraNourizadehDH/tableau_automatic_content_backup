              <calculation class='tableau' formula='CASE [ncr_type]&#13;&#10;    WHEN &quot;CPP&quot; THEN [cpp_revenue]&#13;&#10;    WHEN &quot;CPC&quot; THEN [cpc_revenue]&#13;&#10;    WHEN &quot;Joker&quot; THEN [joker_revenue]&#13;&#10;    WHEN &quot;Display Ads&quot; THEN [displayads_revenue]&#13;&#10;    WHEN &quot;Targeted Deals&quot; THEN [targeted_deal_revenue]&#13;&#10;    ELSE NULL&#13;&#10;END' />
