    <worksheet name='Vendor table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial'>Vendor Summary</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='report_cpc (bl_commercial)' name='federated.1nnn2rm1fb810g19x6olf1gt5gii' />
          </datasources>
          <datasource-dependencies datasource='federated.1nnn2rm1fb810g19x6olf1gt5gii'>
            <column caption='Avg. Click Price (NOK)' datatype='real' name='[Calculation_2597521462609399808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monthly_total_revenue])/SUM([monthly_total_clicks])' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_320037061643210753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([year_month]),7)' />
            </column>
            <column caption='Current Month' datatype='string' name='[Calculation_320037061647437827]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([Calculation_320037061643210753]) = LEFT(STR(DATE(DATEADD(&apos;month&apos;,-0,DATETRUNC(&apos;month&apos;,TODAY())))),7) &#13;&#10;    THEN &apos;Current Month&apos;&#13;&#10;ELSE STR([Calculation_320037061643210753]) END' />
            </column>
            <column caption='Date Drill Down (+)' datatype='string' name='[Calculation_320037061650735108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='# Bookings' datatype='integer' name='[Calculation_502432844912254976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([cpc_booking_id])' />
            </column>
            <column caption='% CVR' datatype='real' name='[Calculation_502432844914733061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monthly_cpc_orders])/SUM([monthly_billed_clicks])' />
            </column>
            <column caption='% Budget Achieved' datatype='real' name='[Calculation_502432844915261446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([monthly_total_revenue]) / SUM([initial_budget])' />
            </column>
            <column caption='% Sold Out' datatype='real' name='[Calculation_502432844915703815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [monthly_billed_revenue] &gt;= [initial_budget] THEN 1 ELSE 0 END)/COUNTD([cpc_booking_id])' />
            </column>
            <column caption='ROAS' datatype='real' name='[Calculation_502432844916899848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monthly_cpc_gmv])&#13;&#10;/&#13;&#10;SUM([monthly_billed_revenue])' />
            </column>
            <column-instance column='[monthly_avg_rating]' derivation='Avg' name='[avg:monthly_avg_rating:qk]' pivot='key' type='quantitative' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Cpc Booking Id' datatype='string' name='[cpc_booking_id]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Booked Budget' datatype='real' name='[initial_budget]' role='measure' type='quantitative' />
            <column caption='Lg City' datatype='string' name='[lg_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Avg. Rating' datatype='real' name='[monthly_avg_rating]' role='measure' type='quantitative' />
            <column caption='# Billed Clicks' datatype='real' name='[monthly_billed_clicks]' role='measure' type='quantitative' />
            <column caption='Billed Revenue' datatype='real' name='[monthly_billed_revenue]' role='measure' type='quantitative' />
            <column caption='CPC GMV' datatype='real' name='[monthly_cpc_gmv]' role='measure' type='quantitative' />
            <column caption='# CPC Orders' datatype='real' name='[monthly_cpc_orders]' role='measure' type='quantitative' />
