      <aliases enabled='yes' />
      <column caption='# Vendors' datatype='integer' name='[# Bookings (copy)_825566119912304640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(vendor_id)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1nnn2rm1fb810g19x6olf1gt5gii].[avg:monthly_avg_click_price:qk]&quot;' value='Avg. Click Price' />
          <alias key='&quot;[federated.1nnn2rm1fb810g19x6olf1gt5gii].[avg:monthly_avg_rating:qk]&quot;' value='Avg. Rating' />
          <alias key='&quot;[federated.1nnn2rm1fb810g19x6olf1gt5gii].[avg:monthly_cpc_aov:qk]&quot;' value='AOV' />
          <alias key='&quot;[federated.1nnn2rm1fb810g19x6olf1gt5gii].[usr:Calculation_502432844912758785:qk]&quot;' value='Budget per Booking' />
        </aliases>
      </column>
      <column caption='Avg. Click Price (NOK)' datatype='real' name='[Calculation_2597521462609399808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_total_revenue])/SUM([monthly_total_clicks])' />
      </column>
      <column caption='Report Month' datatype='string' name='[Calculation_320037061643210753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR([year_month]),7)' />
      </column>
      <column caption='Current Month' datatype='string' name='[Calculation_320037061647437827]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STR([Calculation_320037061643210753]) = LEFT(STR(DATE(DATEADD(&apos;month&apos;,-0,DATETRUNC(&apos;month&apos;,TODAY())))),7) &#13;&#10;    THEN &apos;Current Month&apos;&#13;&#10;ELSE STR([Calculation_320037061643210753]) END' />
      </column>
      <column caption='Date Drill Down (+)' datatype='string' name='[Calculation_320037061650735108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='# Bookings' datatype='integer' name='[Calculation_502432844912254976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([cpc_booking_id])' />
      </column>
      <column caption='Avg Budget per Booking' datatype='real' name='[Calculation_502432844912758785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([initial_budget]) / COUNTD([cpc_booking_id])' />
      </column>
      <column caption='Revenue per Booking' datatype='real' name='[Calculation_502432844913434626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_billed_revenue]) / COUNTD([cpc_booking_id])' />
      </column>
      <column caption='# Clicks per Booking' datatype='real' name='[Calculation_502432844914139140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_billed_clicks]) / COUNTD([cpc_booking_id])' />
      </column>
      <column caption='% CVR' datatype='real' name='[Calculation_502432844914733061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_cpc_orders])/SUM([monthly_billed_clicks])' />
      </column>
      <column caption='% Budget Achieved' datatype='real' name='[Calculation_502432844915261446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([monthly_total_revenue]) / SUM([initial_budget])' />
      </column>
      <column caption='% Sold Out' datatype='real' name='[Calculation_502432844915703815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [monthly_billed_revenue] &gt;= [initial_budget] THEN 1 ELSE 0 END)/COUNTD([cpc_booking_id])' />
      </column>
      <column caption='ROAS' datatype='real' name='[Calculation_502432844916899848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_cpc_gmv])&#13;&#10;/&#13;&#10;SUM([monthly_billed_revenue])' />
      </column>
      <column caption='Click Price Bucket' datatype='string' name='[Calculation_502432844920446985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;         [daily_click_price] = 0 &#13;&#10;      OR [daily_click_price] = NULL THEN &quot;0&quot;&#13;&#10;  ELSEIF [daily_click_price] &lt;= 6 THEN &quot;6&quot;&#13;&#10;  ELSEIF [daily_click_price] &lt;= 7 THEN &quot;7&quot;&#13;&#10;  ELSEIF [daily_click_price] &lt;= 8 THEN &quot;8&quot;&#13;&#10;  ELSEIF [daily_click_price] &lt;= 9 THEN &quot;9&quot;&#13;&#10;  ELSEIF [daily_click_price] &lt;= 10 THEN &quot;10&quot;&#13;&#10;  ELSEIF [daily_click_price] &lt;= 11 THEN &quot;11&quot;&#13;&#10;  ELSEIF [daily_click_price] &lt;= 12 THEN &quot;12&quot;&#13;&#10;  ELSE &quot;+13&quot;&#13;&#10;END' />
      </column>
      <column caption='% Recurring' datatype='real' name='[Calculation_502432844928720906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [active_prev_month] = TRUE THEN [vendor_id] END)&#13;&#10;/&#13;&#10;COUNTD([vendor_id])' />
      </column>
      <column caption='% Utilization Pace' datatype='real' name='[Calculation_502432844929163275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cumulative_clicks_blended_rev])&#13;&#10;/SUM([initial_budget])' />
      </column>
      <column caption='ROAS (copy)' datatype='real' name='[ROAS (copy)_320037061641867264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_cpc_gmv])&#13;&#10;/&#13;&#10;SUM([monthly_billed_revenue])-1' />
      </column>
