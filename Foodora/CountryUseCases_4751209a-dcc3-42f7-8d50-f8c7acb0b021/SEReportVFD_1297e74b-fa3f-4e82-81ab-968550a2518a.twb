      <column caption='% Change From Yesterday' datatype='real' name='[Calculation_1870682714930298881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([%VFD (copy)_1870682714930167808] - [Calculation_50665505350037504]) /[%VFD (copy)_1870682714930167808]' />
      </column>
      <column caption='Vendor GMV Rank' datatype='integer' name='[Calculation_1870682714931179522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([gmv_value]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Share of AM GMV' datatype='real' name='[Calculation_1870682714934091779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_value])/MAX([am_total_gmv_value])' />
      </column>
      <column caption='Has VFD?' datatype='boolean' name='[Calculation_1870682714935201796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vendor_total_vfd_value] &gt; 0' />
        <aliases>
          <alias key='false' value='Does not have VFD' />
          <alias key='true' value='Has VFD' />
        </aliases>
      </column>
      <column caption='VFD Buckets' datatype='string' name='[Calculation_1870682714938593285]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) = 0 THEN &apos;0%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.03 THEN &apos;1% - 3%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.05 THEN &apos;3% - 5%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.08 THEN &apos;5% - 8%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.12 THEN &apos;8% - 12%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.15 THEN &apos;12% - 15%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &gt; 0.15 THEN &apos;+ 15%&apos;&#13;&#10;END' />
      </column>
      <column caption='End of Month' datatype='boolean' name='[Calculation_1870682714944368646]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_month] = DATETRUNC(&apos;month&apos;,TODAY()) AND [report_date] = DATEADD(&apos;day&apos;,-1,TODAY()) &#13;&#10;    THEN TRUE&#13;&#10;ELSEIF [report_date] = DATEADD(&apos;month&apos;,1,DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,[report_date]))) &#13;&#10;    THEN TRUE &#13;&#10;    ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='%VFD' datatype='real' name='[Calculation_50665505350037504]' role='measure' type='quantitative'>
