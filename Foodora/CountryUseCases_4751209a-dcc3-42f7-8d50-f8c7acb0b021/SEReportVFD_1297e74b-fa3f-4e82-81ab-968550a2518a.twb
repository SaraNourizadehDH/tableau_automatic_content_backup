            <column caption='VFD Buckets' datatype='string' name='[Calculation_1870682714938593285]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) = 0 THEN &apos;0%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.03 THEN &apos;1% - 3%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.05 THEN &apos;3% - 5%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.08 THEN &apos;5% - 8%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.12 THEN &apos;8% - 12%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &lt;= 0.15 THEN &apos;12% - 15%&apos;&#13;&#10;ELSEIF ([vendor_total_vfd_value]/[vendor_total_gmv_value]) &gt; 0.15 THEN &apos;+ 15%&apos;&#13;&#10;END' />
            </column>
