  <worksheets>
    <worksheet name='AM View'>
      <repository-location id='AMView' path='/t/Foodora/workbooks/FIJokerReport-Version2' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='report_joker_v2 (bl_bi)' name='federated.0edgjv20kawktr1bh3vc51x82k5n' />
          </datasources>
          <datasource-dependencies datasource='federated.0edgjv20kawktr1bh3vc51x82k5n'>
            <column caption='Report Month - Adj' datatype='string' name='[Calculation_1026257783801884674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STR([report_month]) = STR(DATE(DATEADD(&apos;month&apos;,-0,DATETRUNC(&apos;month&apos;,TODAY())))) &#13;&#10;    THEN &apos;Current Month&apos;&#13;&#10;ELSE STR([report_month]) END' />
            </column>
            <column caption='% Self Service Rev' datatype='real' name='[Calculation_1241867615148929028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([self_service_joker_fee])&#13;&#10;/&#13;&#10;SUM([joker_fee])' />
            </column>
            <column caption='% Inventory Sold' datatype='real' name='[Calculation_1241867615150362629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_orders])&#13;&#10;/&#13;&#10;SUM([joker_budget_orders_actual])' />
            </column>
            <column caption='Joker Fee - Net' datatype='real' name='[Calculation_1420322794309808128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[joker_fee_excl_vat]' />
            </column>
            <column caption='% CVR' datatype='real' name='[Calculation_1763722236904042496]' role='measure' type='quantitative'>
