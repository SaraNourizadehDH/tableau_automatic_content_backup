      <column caption='AVG Joker Fee - Net' datatype='real' name='[AVG Joker Fee (copy)_1420322794313461761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1420322794309808128])&#13;&#10;/&#13;&#10;SUM([joker_orders])' />
      </column>
      <column caption='Daily Revenue - AC' datatype='real' name='[Calculation_1026257783718789120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[daily_jokers_ac_rev]' />
      </column>
      <column caption='# Vendors Scheduled (D)' datatype='integer' name='[Calculation_1026257783762452481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Report Month - Adj' datatype='string' name='[Calculation_1026257783801884674]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STR([report_month]) = STR(DATE(DATEADD(&apos;month&apos;,-0,DATETRUNC(&apos;month&apos;,TODAY())))) &#13;&#10;    THEN &apos;Current Month&apos;&#13;&#10;ELSE STR([report_month]) END' />
      </column>
      <column caption='Daily Revenue Blended - FC' datatype='real' name='[Calculation_1026257783806803972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[daily_jokers_blended_daily_rev]' />
      </column>
      <column caption='% Self Service Rev' datatype='real' name='[Calculation_1241867615148929028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([self_service_joker_fee])&#13;&#10;/&#13;&#10;SUM([joker_fee])' />
      </column>
      <column caption='% Inventory Sold' datatype='real' name='[Calculation_1241867615150362629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_orders])&#13;&#10;/&#13;&#10;SUM([joker_budget_orders_actual])' />
      </column>
      <column caption='AVG Joker Fee - Gross' datatype='real' name='[Calculation_1241867615157047302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_fee])&#13;&#10;/&#13;&#10;SUM([joker_orders])' />
      </column>
      <column caption='AVG Views Per Joker Sold' datatype='real' name='[Calculation_1241867615160115207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_views])&#13;&#10;/&#13;&#10;SUM([joker_orders])' />
      </column>
      <column caption='% Inventory Sold New' datatype='real' name='[Calculation_1241867615236075528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_vendor_month_sold])&#13;&#10;/&#13;&#10;SUM([new_vendor_month_inventory])' />
      </column>
      <column caption='% Daily Sold Inventory - Blanded' datatype='real' name='[Calculation_139611608602636288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([daily_jokers_blended_daily])&#13;&#10;/&#13;&#10;SUM([daily_joker_inventory])' />
      </column>
      <column caption='Joker Fee - Net' datatype='real' name='[Calculation_1420322794309808128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[joker_fee_excl_vat]' />
      </column>
      <column caption='% CVR' datatype='real' name='[Calculation_1763722236904042496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_orders])/SUM([joker_views])' />
      </column>
      <column caption='Diff - AC vs. FC' datatype='real' name='[Calculation_1888415646698848257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1026257783718789120])-&#13;&#10;SUM([daily_jokers_fc_daily_rev])' />
      </column>
      <column caption='% Change - AC vs. FC' datatype='real' name='[Calculation_1888415646699556866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1026257783806803972] / [daily_jokers_blended_daily_rev (copy)_1241867615146713090]' />
      </column>
      <column caption='Report Date' datatype='string' name='[Calculation_679199134270136320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([report_date])' />
      </column>
      <column caption='Report Month ' datatype='string' name='[Calculation_852024767827824640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR([report_month]), 7)' />
      </column>
      <column caption='# Vendors JAAS' datatype='integer' name='[Calculation_852024767828328449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(vendor_code)' />
      </column>
      <column caption='# Recurring Vendors' datatype='integer' name='[Calculation_852024767828549634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [recurring_vendor] = 1 THEN [vendor_code] END)' />
      </column>
      <column caption='% Recurring Vendors' datatype='real' name='[Calculation_852024767829184515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_852024767828549634] / [Calculation_852024767828328449]' />
      </column>
      <column caption='% Inventory Sold Recurring' datatype='real' name='[Calculation_852024767832838148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([recurring_vendor_sold])/SUM([recurring_vendor_inventory])' />
      </column>
      <column caption='# Joker Sold' datatype='integer' name='[Calculation_852024767835258885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_orders])' />
