      <table>
        <view>
          <datasources>
            <datasource caption='report_order_deals (bl_bi)' name='federated.0n95tlq0pp4zb415e0aur1d3l05k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Dimension' datatype='string' name='[Both Years Total Dh Funded Deal Value Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
              <aliases>
                <alias key='&quot;Chain Name&quot;' value='Chain' />
                <alias key='&quot;Vendor Name&quot;' value='Vendor' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n95tlq0pp4zb415e0aur1d3l05k'>
            <column caption='# Pro Deal-on-Top Orders' datatype='integer' name='[% Pro Deal-on-Top Share (copy)_552113176027148320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_free_delivery] = TRUE &#10;    AND [is_pro_order] = TRUE &#10;    AND [is_previous_year] = FALSE &#10;    AND [is_pro_deal_on_top] = TRUE&#10;THEN [order_count] END)' />
            </column>
            <column caption='# Pro Free Delivery Cap Orders' datatype='integer' name='[% Pro Free Delivery Cap (copy)_552113176026693663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_552113175934697480]-[Calculation_552113176026546206]' />
            </column>
            <column caption='% Pro Deal-on-Top Share' datatype='real' name='[% Pro Free Delivery Orders (copy)_552113176023158813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_free_delivery] = TRUE &#10;    AND [is_pro_order] = TRUE &#10;    AND [is_previous_year] = FALSE &#10;    AND [is_pro_deal_on_top] = TRUE&#10;THEN [order_count] END)/[Calculation_552113175934697480]' />
            </column>
            <column caption='Order Count' datatype='integer' name='[Calculation_552113175292948481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [order_count] END)' />
            </column>
            <column caption='# Pro Orders' datatype='integer' name='[Calculation_552113175934697480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_pro_order] AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='Dynamic Dimension' datatype='string' name='[Calculation_552113176004423704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Both Years Total Dh Funded Deal Value Parameter]&#10;    WHEN &quot;City&quot; THEN [city]&#10;    WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;    WHEN &quot;Chain Name&quot; THEN [chain_name]&#10;    WHEN &quot;Zone&quot; THEN [zone]&#10;END' />
            </column>
            <column caption='% Pro Order Share' datatype='real' name='[Calculation_552113176012967961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_552113175934697480]/[Calculation_552113175292948481]' />
            </column>
            <column caption='% Pro Free Delivery Orders' datatype='real' name='[Calculation_552113176013266970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_free_delivery] = TRUE &#10;    AND [is_pro_order] = TRUE &#10;    AND [is_previous_year] = FALSE &#10;THEN [order_count] END)/[Calculation_552113175934697480]' />
            </column>
            <column caption='% Pro Free Delivery Cap' datatype='real' name='[Calculation_552113176016896028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Calculation_552113176013266970]' />
            </column>
            <column caption='# Pro Free Delivery Orders' datatype='integer' name='[Calculation_552113176026546206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_free_delivery] = TRUE &#10;    AND [is_pro_order] = TRUE &#10;    AND [is_previous_year] = FALSE &#10;THEN [order_count] END)' />
            </column>
