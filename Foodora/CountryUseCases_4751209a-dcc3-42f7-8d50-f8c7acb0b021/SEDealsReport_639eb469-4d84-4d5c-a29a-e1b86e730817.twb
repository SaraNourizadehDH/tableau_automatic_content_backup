            <column caption='% Always On Vendor Funded Regional Definition / GMV' datatype='real' name='[% Always On Vendor Funded Local Definition/ GMV (copy)_2585629196944404485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendor Funded Always On Discount (copy)_1327717469252546560]/[Calculation_552113175940993039]' />
            </column>
            <column caption='% VFD Value / GMV' datatype='real' name='[% VFD Value / GMV (copy)_2585629196943495171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_552113175941656596]/[Calculation_552113175940993039]' />
            </column>
            <column caption='    Always On Amount Local Definition' datatype='real' name='[Always On Amount (copy)_5654480497099071493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE &#10;    THEN [always_on_discount_local] ELSE 0 END)' />
            </column>
            <column caption='Always On Vendor Funded Amount Local Definition' datatype='real' name='[Always On Amount Local Definition (copy)_2585629196943650820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE &#10;    THEN [always_on_vendor_funded_amount_local] ELSE 0 END)' />
            </column>
            <column caption='Vendors with Pro' datatype='boolean' name='[Calculation_1050605366426963969]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [vendor_code], [report_month] : MAX([is_pro_order]) }' />
            </column>
            <column caption='% Pro GMV Coverage' datatype='real' name='[Calculation_1050605366427086850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1050605366426963969] AND [is_previous_year] = FALSE THEN [gmv] ELSE 0 END)&#10;/&#10;SUM(IF [is_previous_year] = FALSE THEN [gmv] ELSE 0 END)' />
            </column>
            <column caption='Disco Amount' datatype='real' name='[Calculation_4742360832260251649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [disco_discount_amount] ELSE 0 END)' />
            </column>
            <column caption='Vendor Funded Disco Amount' datatype='real' name='[Calculation_4742360832261353474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [disco_discount_vendor_funded_amount] ELSE 0 END)' />
            </column>
            <column caption='DH Funded Disco Amount' datatype='real' name='[Calculation_4742360832269336579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [disco_discount_dh_funded_amount] ELSE 0 END)' />
            </column>
            <column caption='Order Count' datatype='integer' name='[Calculation_552113175292948481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [order_count] END)' />
            </column>
            <column caption='% YoY Order growth' datatype='real' name='[Calculation_552113175918125059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [order_count] END)&#10;/SUM(IF [is_previous_year] = TRUE THEN [order_count] END)-1' />
            </column>
            <column caption='# Vendors w Deal' datatype='integer' name='[Calculation_552113175922524165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [is_successful_deal]&#10;THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Orders w Deal' datatype='integer' name='[Calculation_552113175924957190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_successful_deal] AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='% Orders w Deal' datatype='real' name='[Calculation_552113175925870599]' role='measure' type='quantitative'>
