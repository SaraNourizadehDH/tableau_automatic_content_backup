    <worksheet name='Deals Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Deals Details</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='report_order_deals (bl_bi)' name='federated.0n95tlq0pp4zb415e0aur1d3l05k' />
          </datasources>
          <datasource-dependencies datasource='federated.0n95tlq0pp4zb415e0aur1d3l05k'>
            <column caption='# Composite Discount Orders' datatype='integer' name='[# Amount Discount Orders (copy)_2119084371689439237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [discount_type] = &quot;composite&quot; AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Joker Orders' datatype='integer' name='[# Amount Discount Orders (copy)_2119084371698626566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_joker] AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Percentage Discount Orders' datatype='integer' name='[# Amount Discount Orders (copy)_2119084371698991111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [discount_type] = &quot;percentage&quot; AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Always-on Orders Local Definition' datatype='integer' name='[# Disco Orders (copy)_6649916751561543680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_always_on_local] AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='% FD MOV Threshold of Total FD ' datatype='real' name='[# Free Delivery Orders (copy)_1169035960836493325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [is_previous_year] = FALSE&#10;    AND [is_free_delivery] = TRUE &#10;    AND NOT ISNULL([free_delivery_mov_threshold])&#10;    THEN [order_count] &#10;    ELSE 0 &#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF [is_previous_year] = FALSE &#10;    AND [is_free_delivery] = TRUE &#10;    THEN [order_count] &#10;    ELSE 0 &#10;    END&#10;)' />
            </column>
            <column caption='# Reduced Delivery Fee Orders' datatype='integer' name='[# Free Delivery Orders (copy)_2119084371683688449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE AND [is_reduced_delivery_fee] = TRUE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Amount Discount Orders' datatype='integer' name='[# Free Gift Discount Orders (copy)_2119084371687288836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [discount_type] = &quot;amount&quot; AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Orders w Deal - Vendor B' datatype='integer' name='[# Orders with Deal - Vendor A (copy)_1169035960792629249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_gmv_class] = &quot;Class B&quot; &#10;        AND [is_previous_year] = FALSE &#10;        AND [is_successful_deal] &#10;        THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Orders w Deal - Vendor C' datatype='integer' name='[# Orders with Deal - Vendor B (copy)_1169035960792715266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_gmv_class] = &quot;Class C&quot; &#10;        AND [is_previous_year] = FALSE &#10;        AND [is_successful_deal] &#10;        THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Orders w Deal - Vendor D' datatype='integer' name='[# Orders with Deal - Vendor C (copy)_1169035960792805379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_gmv_class] = &quot;Class D&quot; &#10;        AND [is_previous_year] = FALSE &#10;        AND [is_successful_deal] &#10;        THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Orders w Deal - Vendor A' datatype='integer' name='[# Pro Orders (copy)_1169035960791736320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_gmv_class] = &quot;Class A&quot; &#10;        AND [is_previous_year] = FALSE &#10;        AND [is_successful_deal] &#10;        THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Free Gift Discount Orders' datatype='integer' name='[# Pro Orders (copy)_2119084371686801411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [discount_type] = &quot;free_gift&quot; AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='# Vendors w Disco' datatype='integer' name='[# Vendors With Composite (copy)_2119084371998146575 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [is_disco] = TRUE&#10;    THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Joker' datatype='integer' name='[# Vendors With Composite (copy)_2119084371998146575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [is_joker] = TRUE&#10;    THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Deal - Class A' datatype='integer' name='[# Vendors With Deal (excl. pro) (copy)_1169035960802910213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [vendor_gmv_class] = &quot;Class A&quot;&#10;    AND [is_successful_deal]&#10;THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Active Vendors' datatype='integer' name='[# Vendors With Deal (excl. pro) (copy)_2119084371701186568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_previous_year] =  FALSE THEN [vendor_code] ELSE NULL END)' />
            </column>
            <column caption='# Vendors w Free Delivery' datatype='integer' name='[# Vendors With Deal (excl. pro) (copy)_2119084371993821194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [is_free_delivery] &#10;    THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Percentage' datatype='integer' name='[# Vendors With Free Delivery (copy)_2119084371997511691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [discount_type] = &quot;percentage&quot;&#10;    THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Free Gift' datatype='integer' name='[# Vendors With Percentage (copy)_2119084371997802508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [discount_type] = &quot;free_gift&quot;&#10;    THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Amount' datatype='integer' name='[# Vendors With Percentage (copy)_2119084371997913101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [discount_type] = &quot;amount&quot;&#10;    THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Composite' datatype='integer' name='[# Vendors With Percentage (copy)_2119084371998019598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [discount_type] = &quot;composite&quot;&#10;    THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Deal - Class B' datatype='integer' name='[# Vendors w Deal - Class A (copy)_1169035960806666246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND [vendor_gmv_class] = &quot;Class B&quot;&#10;    AND [is_successful_deal]&#10;THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='% A/B Vendors w Deal (of all vendors)' datatype='real' name='[# Vendors w Deal - Class A (copy)_1169035960811405322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND ([vendor_gmv_class] = &quot;Class A&quot; OR [vendor_gmv_class] = &quot;Class B&quot;)&#10;    AND [is_successful_deal]&#10;THEN [vendor_code] END&#10;)/&#10;COUNTD(&#10;    IF [is_previous_year] = FALSE &#10;    AND ([vendor_gmv_class] = &quot;Class A&quot; OR [vendor_gmv_class] = &quot;Class B&quot; OR [vendor_gmv_class] = &quot;Class C&quot; OR [vendor_gmv_class] = &quot;Class D&quot;)&#10;THEN [vendor_code] END&#10;)' />
            </column>
            <column caption='# Vendors w Deal - Class C' datatype='integer' name='[# Vendors w Deal - Class B (copy)_1169035960806834183]' role='measure' type='quantitative'>
