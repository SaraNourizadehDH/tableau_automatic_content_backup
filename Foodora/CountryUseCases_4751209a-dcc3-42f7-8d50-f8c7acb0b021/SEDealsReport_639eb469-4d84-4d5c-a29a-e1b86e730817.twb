    <worksheet name='City / Zone - Deals &amp; VFD / GMV  '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>City / Zone - Orders with Deal &amp; VFD Value / GMV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='report_order_deals (bl_bi)' name='federated.0n95tlq0pp4zb415e0aur1d3l05k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Dimension' datatype='string' name='[Both Years Total Dh Funded Deal Value Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
              <aliases>
                <alias key='&quot;Chain Name&quot;' value='Chain' />
                <alias key='&quot;Vendor Name&quot;' value='Vendor' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Select Dimension (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;VFD/GMV&quot;'>
              <calculation class='tableau' formula='&quot;VFD/GMV&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n95tlq0pp4zb415e0aur1d3l05k'>
            <column caption='Always On Vendor Funded Amount Local Definition' datatype='real' name='[Always On Amount Local Definition (copy)_2585629196943650820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE &#10;    THEN [always_on_vendor_funded_amount_local] ELSE 0 END)' />
            </column>
            <column caption='Order Count' datatype='integer' name='[Calculation_552113175292948481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [order_count] END)' />
            </column>
            <column caption='# Orders w Deal' datatype='integer' name='[Calculation_552113175924957190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_successful_deal] AND [is_previous_year] = FALSE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='% Orders w Deal' datatype='real' name='[Calculation_552113175925870599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_552113175924957190]/[Calculation_552113175292948481]' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_552113175940993039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_previous_year] = FALSE THEN [gmv] ELSE 0 END)' />
            </column>
            <column caption='% Always On Vendor Funded Local Definition/ GMV' datatype='real' name='[Calculation_552113175947690007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Always On Amount Local Definition (copy)_2585629196943650820]/[Calculation_552113175940993039]' />
            </column>
            <column caption='Dynamic Dimension' datatype='string' name='[Calculation_552113176004423704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Both Years Total Dh Funded Deal Value Parameter]&#10;    WHEN &quot;City&quot; THEN [city]&#10;    WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;    WHEN &quot;Chain Name&quot; THEN [chain_name]&#10;    WHEN &quot;Zone&quot; THEN [zone]&#10;END' />
            </column>
            <column caption='Dynamic Metric' datatype='real' name='[Dynamic Dimension (copy)_128704447183818752]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Dimension (copy)]&#10;    WHEN &quot;Orders with Deal&quot; THEN [Calculation_552113175925870599]&#10;    WHEN &quot;VFD/GMV&quot; THEN [Calculation_552113175947690007]&#10;END' />
            </column>
            <column caption='Both Years Always On Vendor Funded Local Definition' datatype='real' name='[always_on_vendor_funded_amount_local]' role='measure' type='quantitative' />
