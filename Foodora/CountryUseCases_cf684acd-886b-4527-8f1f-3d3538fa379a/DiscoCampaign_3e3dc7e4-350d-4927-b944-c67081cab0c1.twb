      <column caption='% Campaign Share' datatype='real' name='[Calculation_199002859138326529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Orders&quot; THEN SUM([disco_orders])/SUM([orders])&#13;&#10;WHEN &quot;Acquisitions&quot; THEN SUM([disco_acquisitions])/SUM([acquisitions])&#13;&#10;ELSE NULL&#13;&#10;END' />
