      <column caption='% VFD/GMV' datatype='real' name='[Calculation_1152077132015628288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_funded_value])/SUM([gmv])' />
      </column>
      <column caption='% GMV Share' datatype='real' name='[Calculation_1387390213008543745]' role='measure' type='quantitative'>
