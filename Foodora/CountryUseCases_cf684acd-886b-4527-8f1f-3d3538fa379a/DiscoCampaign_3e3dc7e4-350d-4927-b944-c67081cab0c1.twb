        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0ihh5w0060lnud1eg8oy20twueyr'>
            <connection CATALOG='dha---bi-485' EXECCATALOG='dha---bi-485' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DHA - BI' schema='report_tables' server-oauth='' username='tilo.mohaupt@foodora.at' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ihh5w0060lnud1eg8oy20twueyr' name='Custom SQL Query' type='text'>WITH&#13;
&#13;
prep AS(&#13;
SELECT&#13;
  DISTINCT&#13;
  central_analytical_customer_id&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders`&#13;
WHERE&#13;
  created_date_utc &gt;&gt;= &quot;2024-08-14&quot;&#13;
  AND global_entity_id = &quot;MJM_AT&quot;&#13;
  AND is_valid_order&#13;
  AND is_voucher_used&#13;
  AND voucher_code = &quot;immerpink&quot;&#13;
GROUP BY ALL)&#13;
&#13;
SELECT&#13;
  DATE_TRUNC(created_date_local, MONTH) AS report_month,&#13;
  IF(o.central_analytical_customer_id IN (prep.central_analytical_customer_id), TRUE, FALSE) AS is_disco_customer,&#13;
  COUNT(DISTINCT o.central_analytical_customer_id) AS customers,&#13;
  COUNT(DISTINCT order_code) AS orders&#13;
&#13;
&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` o&#13;
LEFT JOIN&#13;
  prep &#13;
ON&#13;
  prep.central_analytical_customer_id=o.central_analytical_customer_id&#13;
WHERE&#13;
  created_date_utc &gt;&gt;= &quot;2024-01-01&quot;&#13;
  AND global_entity_id = &quot;MJM_AT&quot;&#13;
  AND is_valid_order&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ihh5w0060lnud1eg8oy20twueyr' name='Custom SQL Query' type='text'>WITH&#13;
