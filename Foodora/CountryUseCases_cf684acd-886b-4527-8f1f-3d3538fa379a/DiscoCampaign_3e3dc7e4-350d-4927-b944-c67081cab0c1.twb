      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_58F359B9FCF4463EA8F6734D659BB091'>
            <properties context=''>
              <relation connection='bigquery.06edwld0eycka71aeu6za0glvi7e' name='Custom SQL Query' type='text'>WITH&#13;
&#13;
order_prep AS(&#13;
SELECT&#13;
  CASE&#13;
    WHEN created_date_local BETWEEN &quot;2024-08-14&quot; AND &quot;2024-08-25&quot; THEN &quot;Pre-Launch&quot;&#13;
    WHEN created_date_local BETWEEN &quot;2024-08-26&quot; AND &quot;2024-09-23&quot; THEN &quot;Wave 1&quot;&#13;
    WHEN created_date_local BETWEEN &quot;2024-09-24&quot; AND &quot;2024-10-21&quot; THEN &quot;Wave 2&quot;&#13;
    WHEN created_date_local BETWEEN &quot;2024-10-22&quot; AND &quot;2024-11-30&quot; THEN &quot;Wave 3&quot;&#13;
    WHEN DATE_TRUNC(created_date_local, MONTH) = &quot;2024-12-01&quot; THEN &quot;Wave 4 December&quot;&#13;
    WHEN DATE_TRUNC(created_date_local, MONTH) = &quot;2025-01-01&quot; THEN &quot;Wave 5 January&quot;&#13;
    WHEN DATE_TRUNC(created_date_local, MONTH) = &quot;2025-02-01&quot; THEN &quot;Wave 6 February&quot;&#13;
    WHEN DATE_TRUNC(created_date_local, MONTH) = &quot;2025-03-01&quot; THEN &quot;Wave 7 March&quot;&#13;
    WHEN DATE_TRUNC(created_date_local, MONTH) = &quot;2025-04-01&quot; THEN &quot;Wave 8 April&quot;&#13;
    WHEN DATE_TRUNC(created_date_local, MONTH) = &quot;2025-05-01&quot; THEN &quot;Wave 9 May&quot;&#13;
    WHEN DATE_TRUNC(created_date_local, MONTH) = &quot;2025-06-01&quot; THEN &quot;Wave 10 June&quot;&#13;
    ELSE NULL&#13;
  END AS wave,&#13;
  created_at_local,&#13;
  pd_customer_uuid,&#13;
  IF(is_subscriber_order IS NULL, FALSE, is_subscriber_order) AS is_pro_customer,&#13;
  IF(voucher_value_local = 14, TRUE, FALSE) AS is_new_customer,&#13;
  order_code&#13;
FROM&#13;
  `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders`&#13;
WHERE&#13;
  created_date_utc &gt;&gt;= &quot;2024-08-14&quot;&#13;
  AND global_entity_id = &quot;MJM_AT&quot;&#13;
  AND is_valid_order&#13;
  AND is_voucher_used&#13;
  AND voucher_code = &quot;immerpink&quot;&#13;
),&#13;
&#13;
prep AS(&#13;
&#13;
  SELECT&#13;
    wave,&#13;
    pd_customer_uuid,&#13;
    is_pro_customer,&#13;
    MAX(is_new_customer) AS is_new_customer,&#13;
    COUNT(DISTINCT order_code) AS orders&#13;
  FROM&#13;
    order_prep&#13;
  GROUP BY ALL&#13;
)&#13;
&#13;
SELECT&#13;
  wave,&#13;
  orders,&#13;
  is_pro_customer,&#13;
  is_new_customer,&#13;
  COUNT(DISTINCT pd_customer_uuid) AS customers&#13;
FROM&#13;
  prep&#13;
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
