      <group caption='Norway User Filter' name='[User Filter 1]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[country]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[country]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;DHH Global&apos;)' function='filter'>
              <groupfilter function='except'>
                <groupfilter function='level-members' level='[country]' />
                <groupfilter function='member' level='[country]' member='%null%' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;Foodora AM (FI/NO)&apos;)' function='filter'>
              <groupfilter function='except'>
                <groupfilter function='level-members' level='[country]' />
                <groupfilter function='union'>
                  <groupfilter function='member' level='[country]' member='&quot;Sweden&quot;' />
                  <groupfilter function='member' level='[country]' member='%null%' />
                </groupfilter>
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;Foodora Corp (NO)&apos;)' function='filter'>
              <groupfilter function='member' level='[country]' member='&quot;Norway&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;Foodora Nordics BI&apos;)' function='filter'>
