      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([order_count])) - LOOKUP(ZN(SUM([order_count])), -1)) / ABS(LOOKUP(ZN(SUM([order_count])), -1))'>
