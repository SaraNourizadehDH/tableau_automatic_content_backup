        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.09x6onz0qcbazu1250h6h06322dt' name='Custom SQL Query' type='text'>select o.*,&#13;
ra.* except(year_month),&#13;
rf.* except(year_month),&#13;
rea.* except(year_month),&#13;
nret.* except(year_month),&#13;
qc.* except(year_month),&#13;
lp.* except(year_month),&#13;
dis.* except(year_month),&#13;
tok.* except(year_month),&#13;
reg.* except(year_month),&#13;
from`dhub-yemek.marketing_sandbox.stg_marketing_metrics_agg_order` o&#13;
left join `dhub-yemek.marketing_sandbox.stg_marketing_metrics_retention_all_vertical` ra&#13;
on o.year_month = ra.year_month&#13;
left join  `dhub-yemek.marketing_sandbox.stg_marketing_metrics_retention_food` rf&#13;
on o.year_month = rf.year_month&#13;
left join `dhub-yemek.marketing_sandbox.stg_marketing_metrics_reacquisition_all_verts` rea&#13;
on o.year_month = rea.year_month&#13;
left join `dhub-yemek.marketing_sandbox.stg_marketing_metrics_retention_all_verts_new_customer` nret&#13;
on o.year_month = nret.year_month&#13;
left join `dhub-yemek.marketing_sandbox.stg_marketing_metrics_qcom_trials` qc&#13;
on o.year_month = qc.year_month&#13;
left join `dhub-yemek.marketing_sandbox.marketing_metrics_loyalty_active_participants` lp&#13;
on o.year_month = lp.year_month&#13;
left join `dhub-yemek.marketing_sandbox.marketing_metrics_growth_okr_tier1_orders` dis&#13;
on o.year_month = dis.year_month&#13;
left join  `dhub-yemek.marketing_sandbox.stg_marketing_monthly_metrics_target_okrs` tok&#13;
on o.year_month = tok.year_month&#13;
left join &#13;
(&#13;
select &#13;
format_date(&apos;%Y-%m&apos;, date) year_month,&#13;
sum(num_of_total_sessions) num_of_total_sessions,&#13;
sum(num_of_installs) num_of_installs,&#13;
sum(reg_ios) reg_ios,&#13;
sum(reg_android) reg_android,&#13;
sum(reg_web) reg_web&#13;
from `dhub-yemek.marketing_sandbox.ysmkt_app_performance_metrics_daily`&#13;
group by 1&#13;
) reg on o.year_month = reg.year_month</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
