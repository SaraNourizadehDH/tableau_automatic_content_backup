        <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1srp5yw0jxljed1fafyl80463q69].[Calculation_52072920980299776]' caption='Date Parameter' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-08-01#'>
          <calculation class='tableau' formula='#2024-08-01#' />
