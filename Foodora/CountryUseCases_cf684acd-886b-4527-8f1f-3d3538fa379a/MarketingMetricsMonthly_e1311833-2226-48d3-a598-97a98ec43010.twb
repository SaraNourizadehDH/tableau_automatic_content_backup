            <connection CATALOG='dhub-yemek' EXECCATALOG='dhub-yemek' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhub-yemek' schema='marketing_sandbox' server-oauth='' username='martechtableau@yemeksepeti.com' workgroup-auth-mode='prompt' />
