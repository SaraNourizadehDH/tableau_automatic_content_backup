    <datasource caption='Custom SQL Query (pandata_report)' inline='true' name='federated.03zgg390buu0vz1aydgua10ln630' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.15gg2k30fcign210d80fk1vixl6h'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='foodpanda-bd-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='mohammad.shabab@foodpanda.com.bd' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.15gg2k30fcign210d80fk1vixl6h' name='Custom SQL Query' type='text'><![CDATA[with 

sessions_by_channel as
(
  SELECT
  cast(session_start_timestamp_local as date) AS date
  , "All" as business_type_apac
  , "Sessions by channel" as segment
  , CASE
  WHEN perseus.adjust.campaign LIKE "%aff_aff%" THEN "Affliate (PM)"
  WHEN perseus.adjust.campaign LIKE "%mob_reach%" OR perseus.adjust.campaign LIKE "%mob_rma%" OR perseus.adjust.campaign LIKE "%mob_rmo%" OR perseus.adjust.campaign LIKE "%mob_bra%" THEN "App networks (PM)"
  WHEN perseus.adjust.campaign LIKE "%crm_rma%" OR perseus.adjust.campaign LIKE "%crm_rmo%" OR perseus.adjust.campaign LIKE "%crm_bra%" THEN "CRM"
  WHEN perseus.adjust.campaign LIKE "%dis_reach%" OR perseus.adjust.campaign LIKE "%dis_rma%" THEN "Display (PM)"
  WHEN perseus.adjust.campaign LIKE "%dis_rmo%" THEN "Display (RMO)"
  WHEN perseus.adjust.campaign LIKE "%dis_bra%" THEN "Display Brand (Online Branding)"
  WHEN perseus.adjust.campaign LIKE "%some_promo%" OR perseus.adjust.campaign LIKE "%some_notpromo%" OR perseus.adjust.campaign LIKE "%some_inf%" THEN "Social Engagement"
  WHEN perseus.adjust.campaign LIKE "%rider_rider" THEN "Rider"
  WHEN perseus.adjust.campaign LIKE "%fly_flyers%" THEN "Flyers"
  WHEN perseus.adjust.campaign LIKE "%bra_ooh%" THEN "OOH "
  WHEN perseus.adjust.campaign LIKE "%sem_cat%" OR perseus.adjust.campaign LIKE "%sem_shp%" OR perseus.adjust.campaign LIKE "%sem_ven%" OR perseus.adjust.campaign LIKE "%sem_gen%" OR perseus.adjust.campaign LIKE "%sem_com%" OR perseus.adjust.campaign LIKE "%sem_bra%" OR perseus.adjust.campaign LIKE "%sem_shp%" THEN "SEM (PM)"
  WHEN perseus.adjust.campaign LIKE "%seo_seo%" THEN "SEO (PM)"
  WHEN perseus.adjust.campaign LIKE "%coop_coop%" OR perseus.adjust.campaign LIKE "%coop_vend%" OR perseus.adjust.campaign LIKE "%coop_sell%" THEN "Partnerships and cooperations - Campaign with 3rd party"
  WHEN perseus.adjust.campaign LIKE "%rm_rm%" THEN "Restaurant marketing"
  WHEN perseus.adjust.campaign LIKE "%wom_raf%" THEN "Word of mouth"
  WHEN perseus.adjust.campaign LIKE "%bra_pr%" THEN "PR"
  WHEN perseus.adjust.campaign LIKE "%bra_tv%" OR perseus.adjust.campaign LIKE "%bra_radio%" THEN "ATL (TV or Radio)"
  WHEN perseus.adjust.campaign LIKE "%ps_reach%" OR perseus.adjust.campaign LIKE "%ps_rma%" OR perseus.adjust.campaign LIKE "%smartly_reach%" OR perseus.adjust.campaign LIKE "%smartly_rma%" THEN "Paid Social (PM)"
  WHEN perseus.adjust.campaign LIKE "%ps_rmo%" OR perseus.adjust.campaign LIKE "%smartly_rmo%" THEN "Paid Social (RMO)"
  WHEN perseus.adjust.campaign LIKE "%ps_bra%" OR perseus.adjust.campaign LIKE "%smartly_bra%" OR perseus.adjust.campaign LIKE "%ps_bra%" OR perseus.adjust.campaign LIKE "%smartly_bra%" THEN "Paid Social Online Branding"
  ELSE "Other"
  END AS kpi,
  COUNT(DISTINCT session_key) as value 
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_sessions_pandora` perseus
  WHERE perseus.partition_date >>= CURRENT_DATE("Asia/Dhaka")-151
  AND cast(session_start_timestamp_local as date) BETWEEN CURRENT_DATE("Asia/Dhaka")-151 AND CURRENT_DATE("Asia/Dhaka")-1
  AND perseus.global_entity_id = "FP_BD"
  GROUP BY 1,2,3,4
),

-- customers_segmentation as
-- (
--   with customer_segments as 
--   (
--     SELECT 
--     DATE_ADD(LAST_DAY(partition_date_utc, MONTH), INTERVAL 1 DAY) for_month
--     , user_pfm_segments_descriptive
--     , pd_customer_uuid
--     FROM `fulfillment-dwh-production.curated_data_shared_conseg.customer_segmentation__snapshot` AS customer_segmentation
--     WHERE customer_segmentation.global_entity_id = "FP_BD"
--     AND partition_date_utc in ("2024-01-31", "2024-02-29", "2024-03-29", "2024-04-28", "2024-05-29", "2024-06-30", "2024-07-31", "2024-08-31", "2024-09-30")
--   )
--   , orders as 
--   (
--     select 
--     date_trunc(order_date, MONTH) order_month 
--     , pd_customer_id||'_FP_BD' pd_customer_uuid
--     , order_date
--     , order_code
--     , business_type_apac
--     from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
--     where is_valid_order
--   )
--   select 
--   order_date as date
--   , business_type_apac
--   , 'Customer Cohort (PFM)' as segment
--   , user_pfm_segments_descriptive as kpi
--   , count(order_code) as value
--   from customer_segments
--   left join orders on (customer_segments.for_month=orders.order_month and customer_segments.pd_customer_uuid=orders.pd_customer_uuid)
--   where order_date is not null
--   group by 1,2,3,4
--   order by 1 desc,4 asc
-- )

vouchers as 
(
  SELECT order_date as date, business_type_apac, "Voucher" as segment
  , case
    when ifnull(voucher_amount_local,0)=0 then "No voucher used"
    when ifnull(voucher_value_vendor_subsidized,0)>>0 then "Co-funding"
    WHEN A.voucher_channel = "channel_subsidies" AND A.voucher_purpose in ("engagement", "activation") THEN "Subs Activation"
    WHEN A.voucher_channel = "channel_subsidies" AND A.voucher_purpose = "reactivation" THEN "Subs Reactivation"
    WHEN A.voucher_channel = "channel_subsidies" AND A.voucher_purpose = "acquisition" THEN "Subs Acquisition"
    WHEN A.voucher_channel = "channel_partnership" AND A.voucher_purpose != "revenue" THEN "Partnership"
    WHEN A.voucher_channel = "channel_h2h" AND A.voucher_description NOT LIKE "pandabox%" THEN "H2H"
    WHEN A.voucher_channel = "channel_h2h" AND A.voucher_description LIKE "pandabox%" THEN "Pandabox"
    WHEN A.voucher_purpose = "loyalty" THEN "Loyalty"
    WHEN A.voucher_purpose = "experimentation" THEN "Experimentation"
    WHEN A.voucher_channel in ("channel_referral_reward", "channel_referral_welcome", "channel_referee", "channel_referrer") THEN "RAF"
    WHEN A.voucher_purpose IN ('sorry_panda','autocompensation_realtime','refund', 'compensation') THEN "CX"
    WHEN A.voucher_purpose = "revenue" THEN "Corporate Partnership"
    WHEN A.voucher_channel IN ("channel_online","channel_email") AND A.voucher_purpose IN ('activation','reactivation','engagement','acquisition') THEN "CRM"
    when A.voucher_channel = "channel_crm" then "CRM"
    WHEN A.voucher_channel IN ("channel_campaign","channel_pr") THEN "Campaign PR"
    WHEN A.voucher_channel IN ("channel_subsidies") AND A.voucher_purpose = "user_targeted" AND A.voucher_description IN ('Enjoy Pandamart!','Enjoy Shops!', '12% off shops', '12% off pandamart') THEN "AT DG"
    WHEN A.voucher_channel IN ("channel_subsidies") AND A.voucher_purpose = "user_targeted" THEN "AT"
    WHEN A.voucher_channel IN ("channel_pandapro") AND A.voucher_purpose in ("activation", "benefits") THEN "Pandapro benefits"
    WHEN A.voucher_channel IN ("channel_subsidies") AND A.voucher_purpose = "cofunding" THEN "Co-funding"
  else "Other vouchers"
end as voucher_category
  , count(A.uuid) as orders
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A
  -- LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` B ON A.uuid=B.uuid
  WHERE A.global_entity_id = "FP_BD"
  -- and B.global_entity_id="FP_BD"
  AND A.is_valid_order
  -- AND B.created_date_utc >>= DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH)
  group by 1,2,3,4
),

ordersv2 as 
(
  SELECT
  order_date,
  business_type_apac,
  COUNT(DISTINCT CASE WHEN A.is_discount_used OR A.is_voucher_used THEN A.order_code END) AS incentivised_orders,
  COUNT(DISTINCT CASE WHEN (A.voucher_value_foodpanda_subsidized>>0 OR A.discount_value_foodpanda_subsidized >>0) THEN A.order_code END) AS incentivised_fp_orders,
  COUNT(DISTINCT CASE WHEN voucher_value_foodpanda_subsidized>>0 AND NOT (
  (A.voucher_channel = "channel_partnership" AND A.voucher_purpose = "activation")
  OR (A.voucher_channel = "channel_employee_benefits" AND A.voucher_purpose = "benefits")
  OR (A.voucher_channel = "channel_online" AND A.voucher_purpose IN ("autocompensation_realtime","loyalty"))
  OR (A.voucher_channel = "channel_others" AND A.voucher_purpose = "loyalty")
  OR (A.voucher_channel = "channel_wallet" AND A.voucher_purpose = "loyalty")
  OR (A.voucher_channel = "channel_customer_service" AND A.voucher_purpose = "refund")
  OR (A.voucher_channel = "channel_partnership" AND A.voucher_purpose = "revenue")
  OR (A.voucher_channel = "channel_corporate" AND A.voucher_purpose = "revenue")
  OR (A.voucher_channel = "channel_customer_service" AND A.voucher_purpose = "sorry_panda")
  ) OR  discount_value_foodpanda_subsidized>>0 THEN A.order_code END) AS marketing_incentivized_orders,
  COUNT(DISTINCT CASE WHEN NOT A.is_discount_used AND A.is_voucher_used THEN A.order_code END) AS voucher_only_orders,
  COUNT(DISTINCT CASE WHEN A.is_discount_used AND NOT A.is_voucher_used THEN A.order_code END) AS discount_only_orders,
  COUNT(DISTINCT CASE WHEN A.is_discount_used AND A.is_voucher_used THEN A.order_code END) AS stacked_orders,
  COUNT(DISTINCT CASE WHEN B.is_subscription_benefit_order THEN A.order_code END) AS subscription_orders,
  COUNT(DISTINCT CASE WHEN B.is_subscriber_order THEN A.order_code END) AS subscriber_orders,
  COUNT(DISTINCT CASE WHEN B.is_subscription_voucher_order THEN A.order_code END) AS subscription_voucher_orders,
  COUNT(DISTINCT CASE WHEN B.is_free_delivery_subscription_order THEN A.order_code END) AS subscription_free_del_orders,
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` B ON concat(A.uuid,"_FP_BD")=B.uuid
  WHERE A.global_entity_id = "FP_BD"
  and B.global_entity_id="FP_BD"
  AND A.is_valid_order
  AND B.created_date_utc >>= DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH)
  group by 1,2
),
orders_v2 as 
(
  SELECT * FROM ordersv2
  UNPIVOT(value FOR kpi IN (incentivised_orders, incentivised_fp_orders, 
  marketing_incentivized_orders, voucher_only_orders, discount_only_orders, stacked_orders, subscription_orders, subscriber_orders, subscription_voucher_orders, subscription_free_del_orders))
)

select * from 
(
  select order_date date, business_type_apac, 'Business type' as segment, 
  business_type_apac as kpi, count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1, 2, 3, 4

  union distinct
  select order_date date, business_type_apac, 'Expedition type' as segment, 
  expedition_type as kpi, count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1, 2, 3, 4

  union distinct
  SELECT order_date as date, business_type_apac, 'Location' as segment
  , case 
    when logistics_city_name='Dhaka' and lg_zone_name in ("Gulshan","Dhanmondi","Basundhara","Uttara","Mirpur","Baily road","Mohammadpur","60 feet","Gulshan 2","Khilgaon","Wari","Rampura","Lalbagh") then "a. "||lg_zone_name
    when logistics_city_name='Dhaka' and lg_zone_name not in ("Gulshan","Dhanmondi","Basundhara","Uttara","Mirpur","Baily road","Mohammadpur","60 feet","Gulshan 2","Khilgaon","Wari","Rampura","Lalbagh") then "b. Tier 1 Others"
    when logistics_city_name in ('Chittagong', 'Khulna', 'Rajshahi', 'Sylhet') then "c. "||logistics_city_name
    else "d. Tier 3"
  end as kpi
  , count(uuid) as value 
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Payment type' as segment, 
  case 
    when payment_type_title='Cash On Delivery' then 'Cash On Delivery'
    when payment_type_title='bKash' then 'bKash'
    when payment_type_title in ('No Payment', 'Balance') then 'Balance'
    else 'Online Payment'
  end as kpi, 
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  and payment_type_title is not null
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Timing' as segment, 
  CASE 
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 7 AND 11 THEN "Shokal"
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 12 AND 17 THEN "Dupur"
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 18 AND 23 THEN "Raat"
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 0 AND 6 THEN "Midnight"
    ELSE "others"
  END AS kpi,
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Hours' as segment, 
  cast(EXTRACT(HOUR FROM ordered_at_local) as string) kpi,
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Day of week' as segment, 
  FORMAT_DATE('%A', order_date) kpi,
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct 
  SELECT order_date as date, business_type_apac, 'GFV Bucket' as segment,
  case
    when gfv_gross_local<<101 then 'a. gfv_0_to_100'
    when gfv_gross_local<<201 then 'b. gfv_101_to_200'
    when gfv_gross_local<<301 then 'c. gfv_201_to_300'
    when gfv_gross_local<<401 then 'd. gfv_301_to_400'
    when gfv_gross_local<<501 then 'e. gfv_401_to_500'
    when gfv_gross_local<<601 then 'f. gfv_501_to_600'
    when gfv_gross_local<<701 then 'g. gfv_601_to_700'
    when gfv_gross_local<<801 then 'h. gfv_701_to_800'
    when gfv_gross_local<<901 then 'i. gfv_801_to_900'
    when gfv_gross_local<<1001 then 'j. gfv_901_to_1000'
    else 'k. gfv_1000_plus'
  end as kpi, count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1, 2, 3, 4
 
  union distinct
  SELECT date_local, business_type_apac, "Customers" as segment, "New customers" kpi
  , count(distinct case when is_first_valid_order then customer_id else null end) value
  FROM `fulfillment-dwh-production.pandata_report.country_BD_deep_dive_customers`
  group by 1,2

  union distinct
  SELECT date_local, business_type_apac, "Customers" as segment, "Existing customers" kpi
  , count(distinct case when is_first_valid_order=false then customer_id else null end) value
  FROM `fulfillment-dwh-production.pandata_report.country_BD_deep_dive_customers`
  group by 1,2

  union distinct
  select * from sessions_by_channel

  -- union distinct
  -- select * from customers_segmentation

  union distinct
  select * from vouchers

  union distinct
  select order_date as date, business_type_apac, "Orders" as segment
  , case
  when kpi='incentivised_orders' then 'a. Incentivised'
  when kpi='incentivised_fp_orders' then 'b. FP Incentivised'
  when kpi='marketing_incentivized_orders' then 'c. Mkt Incentivised'
  when kpi='voucher_only_orders' then 'd. Voucher only'
  when kpi='discount_only_orders' then 'e. Discount only'
  when kpi='stacked_orders' then 'f. Stacked'
  when kpi='subscription_orders' then 'g. Subscription'
  when kpi='subscriber_orders' then 'h. Subscriber'
  when kpi='subscription_voucher_orders' then 'i. Pro voucher'
  when kpi='subscription_free_del_orders' then 'j. Pro free delivery'
  end, value 
  from orders_v2

  union distinct
  SELECT date_local, business_type_apac, 'Order cancellation' as segment
  , decline_reason_type||' : '||status_name as kpi, sum(orders) value
  FROM `fulfillment-dwh-production.pandata_report.country_BD_deep_dive_cancelled_orders`
  where decline_reason_type is not null
  group by 1,2,3,4

  union distinct
  select order_date as date, A.business_type_apac, "Vendor class" as segment
  , ifnull(abcd_class, 'ABCD class unknown') as kpi, count(A.uuid) as value
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A,
  `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` B
  where A.vendor_code=B.vendor_code
  and is_valid_order
  group by 1,2,3,4
 
  union distinct
  select order_date as date, A.business_type_apac, "Vendor class" as segment
  , ifnull(wxyz_class, 'WXYZ class Unknown') as kpi, count(A.uuid) as value
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A,
  `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` B
  where A.vendor_code=B.vendor_code
  and is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date as date, business_type_apac, 'L30D Top 50 Vendors' as segment
  , ifnull(chain_name, vendor_name) as kpi, count(uuid) as value
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A,
  (
    select 
    ifnull(chain_name, vendor_name) brand_name
    , ifnull(chain_code, vendor_code) brand_code
    , count(uuid) as orders
    from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
    where is_valid_order
    and order_date>>=current_date()-30
    and business_type_apac="restaurants"
    group by 1,2
    order by 3 desc
    limit 50
  ) B
  where is_valid_order
  and ifnull(A.chain_code, A.vendor_code)=B.brand_code
  and business_type_apac='restaurants'
  group by 1,2,3,4

)
where date >>= date_sub(current_date(), INTERVAL 151 DAY)
and date <<= date_sub(current_date(), INTERVAL 1 DAY)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.15gg2k30fcign210d80fk1vixl6h' name='Custom SQL Query' type='text'><![CDATA[with 

sessions_by_channel as
(
  SELECT
  cast(session_start_timestamp_local as date) AS date
  , "All" as business_type_apac
  , "Sessions by channel" as segment
  , CASE
  WHEN perseus.adjust.campaign LIKE "%aff_aff%" THEN "Affliate (PM)"
  WHEN perseus.adjust.campaign LIKE "%mob_reach%" OR perseus.adjust.campaign LIKE "%mob_rma%" OR perseus.adjust.campaign LIKE "%mob_rmo%" OR perseus.adjust.campaign LIKE "%mob_bra%" THEN "App networks (PM)"
  WHEN perseus.adjust.campaign LIKE "%crm_rma%" OR perseus.adjust.campaign LIKE "%crm_rmo%" OR perseus.adjust.campaign LIKE "%crm_bra%" THEN "CRM"
  WHEN perseus.adjust.campaign LIKE "%dis_reach%" OR perseus.adjust.campaign LIKE "%dis_rma%" THEN "Display (PM)"
  WHEN perseus.adjust.campaign LIKE "%dis_rmo%" THEN "Display (RMO)"
  WHEN perseus.adjust.campaign LIKE "%dis_bra%" THEN "Display Brand (Online Branding)"
  WHEN perseus.adjust.campaign LIKE "%some_promo%" OR perseus.adjust.campaign LIKE "%some_notpromo%" OR perseus.adjust.campaign LIKE "%some_inf%" THEN "Social Engagement"
  WHEN perseus.adjust.campaign LIKE "%rider_rider" THEN "Rider"
  WHEN perseus.adjust.campaign LIKE "%fly_flyers%" THEN "Flyers"
  WHEN perseus.adjust.campaign LIKE "%bra_ooh%" THEN "OOH "
  WHEN perseus.adjust.campaign LIKE "%sem_cat%" OR perseus.adjust.campaign LIKE "%sem_shp%" OR perseus.adjust.campaign LIKE "%sem_ven%" OR perseus.adjust.campaign LIKE "%sem_gen%" OR perseus.adjust.campaign LIKE "%sem_com%" OR perseus.adjust.campaign LIKE "%sem_bra%" OR perseus.adjust.campaign LIKE "%sem_shp%" THEN "SEM (PM)"
  WHEN perseus.adjust.campaign LIKE "%seo_seo%" THEN "SEO (PM)"
  WHEN perseus.adjust.campaign LIKE "%coop_coop%" OR perseus.adjust.campaign LIKE "%coop_vend%" OR perseus.adjust.campaign LIKE "%coop_sell%" THEN "Partnerships and cooperations - Campaign with 3rd party"
  WHEN perseus.adjust.campaign LIKE "%rm_rm%" THEN "Restaurant marketing"
  WHEN perseus.adjust.campaign LIKE "%wom_raf%" THEN "Word of mouth"
  WHEN perseus.adjust.campaign LIKE "%bra_pr%" THEN "PR"
  WHEN perseus.adjust.campaign LIKE "%bra_tv%" OR perseus.adjust.campaign LIKE "%bra_radio%" THEN "ATL (TV or Radio)"
  WHEN perseus.adjust.campaign LIKE "%ps_reach%" OR perseus.adjust.campaign LIKE "%ps_rma%" OR perseus.adjust.campaign LIKE "%smartly_reach%" OR perseus.adjust.campaign LIKE "%smartly_rma%" THEN "Paid Social (PM)"
  WHEN perseus.adjust.campaign LIKE "%ps_rmo%" OR perseus.adjust.campaign LIKE "%smartly_rmo%" THEN "Paid Social (RMO)"
  WHEN perseus.adjust.campaign LIKE "%ps_bra%" OR perseus.adjust.campaign LIKE "%smartly_bra%" OR perseus.adjust.campaign LIKE "%ps_bra%" OR perseus.adjust.campaign LIKE "%smartly_bra%" THEN "Paid Social Online Branding"
  ELSE "Other"
  END AS kpi,
  COUNT(DISTINCT session_key) as value 
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_sessions_pandora` perseus
  WHERE perseus.partition_date >>= CURRENT_DATE("Asia/Dhaka")-151
  AND cast(session_start_timestamp_local as date) BETWEEN CURRENT_DATE("Asia/Dhaka")-151 AND CURRENT_DATE("Asia/Dhaka")-1
  AND perseus.global_entity_id = "FP_BD"
  GROUP BY 1,2,3,4
),

-- customers_segmentation as
-- (
--   with customer_segments as 
--   (
--     SELECT 
--     DATE_ADD(LAST_DAY(partition_date_utc, MONTH), INTERVAL 1 DAY) for_month
--     , user_pfm_segments_descriptive
--     , pd_customer_uuid
--     FROM `fulfillment-dwh-production.curated_data_shared_conseg.customer_segmentation__snapshot` AS customer_segmentation
--     WHERE customer_segmentation.global_entity_id = "FP_BD"
--     AND partition_date_utc in ("2024-01-31", "2024-02-29", "2024-03-29", "2024-04-28", "2024-05-29", "2024-06-30", "2024-07-31", "2024-08-31", "2024-09-30")
--   )
--   , orders as 
--   (
--     select 
--     date_trunc(order_date, MONTH) order_month 
--     , pd_customer_id||'_FP_BD' pd_customer_uuid
--     , order_date
--     , order_code
--     , business_type_apac
--     from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
--     where is_valid_order
--   )
--   select 
--   order_date as date
--   , business_type_apac
--   , 'Customer Cohort (PFM)' as segment
--   , user_pfm_segments_descriptive as kpi
--   , count(order_code) as value
--   from customer_segments
--   left join orders on (customer_segments.for_month=orders.order_month and customer_segments.pd_customer_uuid=orders.pd_customer_uuid)
--   where order_date is not null
--   group by 1,2,3,4
--   order by 1 desc,4 asc
-- )

vouchers as 
(
  SELECT order_date as date, business_type_apac, "Voucher" as segment
  , case
    when ifnull(voucher_amount_local,0)=0 then "No voucher used"
    when ifnull(voucher_value_vendor_subsidized,0)>>0 then "Co-funding"
    WHEN A.voucher_channel = "channel_subsidies" AND A.voucher_purpose in ("engagement", "activation") THEN "Subs Activation"
    WHEN A.voucher_channel = "channel_subsidies" AND A.voucher_purpose = "reactivation" THEN "Subs Reactivation"
    WHEN A.voucher_channel = "channel_subsidies" AND A.voucher_purpose = "acquisition" THEN "Subs Acquisition"
    WHEN A.voucher_channel = "channel_partnership" AND A.voucher_purpose != "revenue" THEN "Partnership"
    WHEN A.voucher_channel = "channel_h2h" AND A.voucher_description NOT LIKE "pandabox%" THEN "H2H"
    WHEN A.voucher_channel = "channel_h2h" AND A.voucher_description LIKE "pandabox%" THEN "Pandabox"
    WHEN A.voucher_purpose = "loyalty" THEN "Loyalty"
    WHEN A.voucher_purpose = "experimentation" THEN "Experimentation"
    WHEN A.voucher_channel in ("channel_referral_reward", "channel_referral_welcome", "channel_referee", "channel_referrer") THEN "RAF"
    WHEN A.voucher_purpose IN ('sorry_panda','autocompensation_realtime','refund', 'compensation') THEN "CX"
    WHEN A.voucher_purpose = "revenue" THEN "Corporate Partnership"
    WHEN A.voucher_channel IN ("channel_online","channel_email") AND A.voucher_purpose IN ('activation','reactivation','engagement','acquisition') THEN "CRM"
    when A.voucher_channel = "channel_crm" then "CRM"
    WHEN A.voucher_channel IN ("channel_campaign","channel_pr") THEN "Campaign PR"
    WHEN A.voucher_channel IN ("channel_subsidies") AND A.voucher_purpose = "user_targeted" AND A.voucher_description IN ('Enjoy Pandamart!','Enjoy Shops!', '12% off shops', '12% off pandamart') THEN "AT DG"
    WHEN A.voucher_channel IN ("channel_subsidies") AND A.voucher_purpose = "user_targeted" THEN "AT"
    WHEN A.voucher_channel IN ("channel_pandapro") AND A.voucher_purpose in ("activation", "benefits") THEN "Pandapro benefits"
    WHEN A.voucher_channel IN ("channel_subsidies") AND A.voucher_purpose = "cofunding" THEN "Co-funding"
  else "Other vouchers"
end as voucher_category
  , count(A.uuid) as orders
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A
  -- LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` B ON A.uuid=B.uuid
  WHERE A.global_entity_id = "FP_BD"
  -- and B.global_entity_id="FP_BD"
  AND A.is_valid_order
  -- AND B.created_date_utc >>= DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH)
  group by 1,2,3,4
),

ordersv2 as 
(
  SELECT
  order_date,
  business_type_apac,
  COUNT(DISTINCT CASE WHEN A.is_discount_used OR A.is_voucher_used THEN A.order_code END) AS incentivised_orders,
  COUNT(DISTINCT CASE WHEN (A.voucher_value_foodpanda_subsidized>>0 OR A.discount_value_foodpanda_subsidized >>0) THEN A.order_code END) AS incentivised_fp_orders,
  COUNT(DISTINCT CASE WHEN voucher_value_foodpanda_subsidized>>0 AND NOT (
  (A.voucher_channel = "channel_partnership" AND A.voucher_purpose = "activation")
  OR (A.voucher_channel = "channel_employee_benefits" AND A.voucher_purpose = "benefits")
  OR (A.voucher_channel = "channel_online" AND A.voucher_purpose IN ("autocompensation_realtime","loyalty"))
  OR (A.voucher_channel = "channel_others" AND A.voucher_purpose = "loyalty")
  OR (A.voucher_channel = "channel_wallet" AND A.voucher_purpose = "loyalty")
  OR (A.voucher_channel = "channel_customer_service" AND A.voucher_purpose = "refund")
  OR (A.voucher_channel = "channel_partnership" AND A.voucher_purpose = "revenue")
  OR (A.voucher_channel = "channel_corporate" AND A.voucher_purpose = "revenue")
  OR (A.voucher_channel = "channel_customer_service" AND A.voucher_purpose = "sorry_panda")
  ) OR  discount_value_foodpanda_subsidized>>0 THEN A.order_code END) AS marketing_incentivized_orders,
  COUNT(DISTINCT CASE WHEN NOT A.is_discount_used AND A.is_voucher_used THEN A.order_code END) AS voucher_only_orders,
  COUNT(DISTINCT CASE WHEN A.is_discount_used AND NOT A.is_voucher_used THEN A.order_code END) AS discount_only_orders,
  COUNT(DISTINCT CASE WHEN A.is_discount_used AND A.is_voucher_used THEN A.order_code END) AS stacked_orders,
  COUNT(DISTINCT CASE WHEN B.is_subscription_benefit_order THEN A.order_code END) AS subscription_orders,
  COUNT(DISTINCT CASE WHEN B.is_subscriber_order THEN A.order_code END) AS subscriber_orders,
  COUNT(DISTINCT CASE WHEN B.is_subscription_voucher_order THEN A.order_code END) AS subscription_voucher_orders,
  COUNT(DISTINCT CASE WHEN B.is_free_delivery_subscription_order THEN A.order_code END) AS subscription_free_del_orders,
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` B ON concat(A.uuid,"_FP_BD")=B.uuid
  WHERE A.global_entity_id = "FP_BD"
  and B.global_entity_id="FP_BD"
  AND A.is_valid_order
  AND B.created_date_utc >>= DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH)
  group by 1,2
),
orders_v2 as 
(
  SELECT * FROM ordersv2
  UNPIVOT(value FOR kpi IN (incentivised_orders, incentivised_fp_orders, 
  marketing_incentivized_orders, voucher_only_orders, discount_only_orders, stacked_orders, subscription_orders, subscriber_orders, subscription_voucher_orders, subscription_free_del_orders))
)

select * from 
(
  select order_date date, business_type_apac, 'Business type' as segment, 
  business_type_apac as kpi, count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1, 2, 3, 4

  union distinct
  select order_date date, business_type_apac, 'Expedition type' as segment, 
  expedition_type as kpi, count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1, 2, 3, 4

  union distinct
  SELECT order_date as date, business_type_apac, 'Location' as segment
  , case 
    when logistics_city_name='Dhaka' and lg_zone_name in ("Gulshan","Dhanmondi","Basundhara","Uttara","Mirpur","Baily road","Mohammadpur","60 feet","Gulshan 2","Khilgaon","Wari","Rampura","Lalbagh") then "a. "||lg_zone_name
    when logistics_city_name='Dhaka' and lg_zone_name not in ("Gulshan","Dhanmondi","Basundhara","Uttara","Mirpur","Baily road","Mohammadpur","60 feet","Gulshan 2","Khilgaon","Wari","Rampura","Lalbagh") then "b. Tier 1 Others"
    when logistics_city_name in ('Chittagong', 'Khulna', 'Rajshahi', 'Sylhet') then "c. "||logistics_city_name
    else "d. Tier 3"
  end as kpi
  , count(uuid) as value 
  FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Payment type' as segment, 
  case 
    when payment_type_title='Cash On Delivery' then 'Cash On Delivery'
    when payment_type_title='bKash' then 'bKash'
    when payment_type_title in ('No Payment', 'Balance') then 'Balance'
    else 'Online Payment'
  end as kpi, 
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  and payment_type_title is not null
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Timing' as segment, 
  CASE 
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 7 AND 11 THEN "Shokal"
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 12 AND 17 THEN "Dupur"
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 18 AND 23 THEN "Raat"
    WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 0 AND 6 THEN "Midnight"
    ELSE "others"
  END AS kpi,
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Hours' as segment, 
  cast(EXTRACT(HOUR FROM ordered_at_local) as string) kpi,
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date date, business_type_apac, 'Day of week' as segment, 
  FORMAT_DATE('%A', order_date) kpi,
  count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1,2,3,4

  union distinct 
  SELECT order_date as date, business_type_apac, 'GFV Bucket' as segment,
  case
    when gfv_gross_local<<101 then 'a. gfv_0_to_100'
    when gfv_gross_local<<201 then 'b. gfv_101_to_200'
    when gfv_gross_local<<301 then 'c. gfv_201_to_300'
    when gfv_gross_local<<401 then 'd. gfv_301_to_400'
    when gfv_gross_local<<501 then 'e. gfv_401_to_500'
    when gfv_gross_local<<601 then 'f. gfv_501_to_600'
    when gfv_gross_local<<701 then 'g. gfv_601_to_700'
    when gfv_gross_local<<801 then 'h. gfv_701_to_800'
    when gfv_gross_local<<901 then 'i. gfv_801_to_900'
    when gfv_gross_local<<1001 then 'j. gfv_901_to_1000'
    else 'k. gfv_1000_plus'
  end as kpi, count(uuid) as value 
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
  where is_valid_order
  group by 1, 2, 3, 4
 
  union distinct
  SELECT date_local, business_type_apac, "Customers" as segment, "New customers" kpi
  , count(distinct case when is_first_valid_order then customer_id else null end) value
  FROM `fulfillment-dwh-production.pandata_report.country_BD_deep_dive_customers`
  group by 1,2

  union distinct
  SELECT date_local, business_type_apac, "Customers" as segment, "Existing customers" kpi
  , count(distinct case when is_first_valid_order=false then customer_id else null end) value
  FROM `fulfillment-dwh-production.pandata_report.country_BD_deep_dive_customers`
  group by 1,2

  union distinct
  select * from sessions_by_channel

  -- union distinct
  -- select * from customers_segmentation

  union distinct
  select * from vouchers

  union distinct
  select order_date as date, business_type_apac, "Orders" as segment
  , case
  when kpi='incentivised_orders' then 'a. Incentivised'
  when kpi='incentivised_fp_orders' then 'b. FP Incentivised'
  when kpi='marketing_incentivized_orders' then 'c. Mkt Incentivised'
  when kpi='voucher_only_orders' then 'd. Voucher only'
  when kpi='discount_only_orders' then 'e. Discount only'
  when kpi='stacked_orders' then 'f. Stacked'
  when kpi='subscription_orders' then 'g. Subscription'
  when kpi='subscriber_orders' then 'h. Subscriber'
  when kpi='subscription_voucher_orders' then 'i. Pro voucher'
  when kpi='subscription_free_del_orders' then 'j. Pro free delivery'
  end, value 
  from orders_v2

  union distinct
  SELECT date_local, business_type_apac, 'Order cancellation' as segment
  , decline_reason_type||' : '||status_name as kpi, sum(orders) value
  FROM `fulfillment-dwh-production.pandata_report.country_BD_deep_dive_cancelled_orders`
  where decline_reason_type is not null
  group by 1,2,3,4

  union distinct
  select order_date as date, A.business_type_apac, "Vendor class" as segment
  , ifnull(abcd_class, 'ABCD class unknown') as kpi, count(A.uuid) as value
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A,
  `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` B
  where A.vendor_code=B.vendor_code
  and is_valid_order
  group by 1,2,3,4
 
  union distinct
  select order_date as date, A.business_type_apac, "Vendor class" as segment
  , ifnull(wxyz_class, 'WXYZ class Unknown') as kpi, count(A.uuid) as value
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A,
  `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` B
  where A.vendor_code=B.vendor_code
  and is_valid_order
  group by 1,2,3,4

  union distinct
  select order_date as date, business_type_apac, 'L30D Top 50 Vendors' as segment
  , ifnull(chain_name, vendor_name) as kpi, count(uuid) as value
  from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` A,
  (
    select 
    ifnull(chain_name, vendor_name) brand_name
    , ifnull(chain_code, vendor_code) brand_code
    , count(uuid) as orders
    from `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics`
    where is_valid_order
    and order_date>>=current_date()-30
    and business_type_apac="restaurants"
    group by 1,2
    order by 3 desc
    limit 50
  ) B
  where is_valid_order
  and ifnull(A.chain_code, A.vendor_code)=B.brand_code
  and business_type_apac='restaurants'
  group by 1,2,3,4

)
where date >>= date_sub(current_date(), INTERVAL 151 DAY)
and date <<= date_sub(current_date(), INTERVAL 1 DAY)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
