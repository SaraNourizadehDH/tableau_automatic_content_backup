      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.03zgg390buu0vz1aydgua10ln630].[sum:Calculation_142144926635364352:qk]&quot;' value='Sum of Benchmark' />
