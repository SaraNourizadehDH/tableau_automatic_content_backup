      <column caption='Sub-segments' datatype='string' name='[Calculation_1209497998012874752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Segment Set] then [kpi]&#13;&#10;else &apos;&apos;&#13;&#10;end' />
      </column>
      <column caption='value_benchmark' datatype='integer' name='[Calculation_142144926635364352]' role='measure' type='quantitative'>
