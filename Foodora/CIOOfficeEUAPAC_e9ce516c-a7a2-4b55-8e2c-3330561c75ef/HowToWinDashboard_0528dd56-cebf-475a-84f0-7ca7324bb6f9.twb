      <repository-location derived-from='http://ip-172-31-0-77:8504/t/Foodora/workbooks/HowToWinDashboard/ReadMe?rev=' id='ReadMe' path='/t/Foodora/workbooks/HowToWinDashboard' revision='' site='Foodora' />
