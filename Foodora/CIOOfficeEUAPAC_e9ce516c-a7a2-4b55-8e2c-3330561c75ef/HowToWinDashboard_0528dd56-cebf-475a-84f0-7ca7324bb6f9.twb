      <aliases enabled='yes' />
      <column caption='Last Completed Month' datatype='datetime' name='[Calculation_1975391437754945536]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&quot;month&quot;, -1, DATETRUNC(&quot;month&quot;, TODAY()))' />
      </column>
      <column caption='Is report month' datatype='boolean' name='[Calculation_1975391437755981825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = [report_date]' />
      </column>
      <column caption='Measure Value coloring' datatype='real' name='[Calculation_1975391437779656707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is absolute metric (copy)_1975391437778997250] then -1*[measure_value]&#13;&#10;ELSE [measure_value]&#13;&#10;end' />
      </column>
      <column caption='display_value' datatype='real' name='[Calculation_2284873172053766144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([metric_name], &quot;%|/|Rate|availability|Coverage|Availability|Penetration|adoption&quot;) THEN&#10;    ifnull([measure_value], 0) * 100&#10;ELSE&#10;    ifnull([measure_value], 0)&#10;END' />
      </column>
      <column caption='display_unit' datatype='string' name='[Calculation_2284873172056440833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([metric_name], &quot;%|/|Rate|availability|Coverage|Availability|Penetration|adoption&quot;)&#10;THEN &quot;%&quot;&#10;END' />
      </column>
      <column caption='Header Actuals' datatype='string' name='[Calculation_344806895594131456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [measure_name] = &apos;actual current&apos; THEN str([report_date])&#13;&#10;ELSEIF [measure_name] = &apos;L1&apos; then str(DATEADD(&apos;month&apos;, -1, report_date))&#13;&#10;ELSEIF [measure_name] = &apos;L2&apos; then str(DATEADD(&apos;month&apos;, -2, report_date))&#13;&#10;ELSEIF [measure_name] = &apos;L3&apos; then str(DATEADD(&apos;month&apos;, -3, report_date))&#13;&#10;ELSEIF [measure_name] = &apos;L12&apos; then str(DATEADD(&apos;month&apos;, -12, report_date))&#13;&#10;ELSE [measure_name]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;target&quot;' value='Target' />
        </aliases>
      </column>
      <column caption='is absolute metric' datatype='boolean' name='[Calculation_344806895598960642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Absolute Metrics Set] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='is comparison measure' datatype='boolean' name='[Calculation_344806895603777539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[measure_name] = &apos;MoM&apos; OR [measure_name] = &apos;YoY&apos; OR [measure_name] = &apos;actual vs target&apos;' />
      </column>
      <column caption='topic' datatype='string' name='[Calculation_5268085713412136961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(&#10;CASE [metric_name]&#10;&#10;// Active Inventory //&#10;WHEN &quot;Total active Inventory (at least with 1 order)&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;SSU Acquisitions (absolute)&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;Zombies Formed&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;Zombies Revived&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;%AB w/ both Ads &amp; Deals live on D0&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;%AB w/ both Ads &amp; Deals live on D30&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;%AB &gt;75 orders in F60D&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;AMC adoption&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;Sales rep productivity&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;Telesales productivity&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;# Sales rep FTEs&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;Field Sales productivity by tenure (New)&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;Field Sales productivity by tenure (Old)&quot; THEN &quot;Active Inventory&quot;&#10;WHEN &quot;DLP % Day 0 coverage&quot; THEN &quot;Active Inventory&quot;&#10;&#10;// VFD/GMV //&#10;WHEN &quot;VFD/GMV (food)&quot; THEN &quot;VFD/GMV&quot;&#10;WHEN &quot;AO VFD/GMV&quot; THEN &quot;VFD/GMV&quot;&#10;WHEN &quot;Pro VFD / Pro GMV&quot; THEN &quot;VFD/GMV&quot;&#10;WHEN &quot;Deal Utilization Pro%&quot; THEN &quot;VFD/GMV&quot;&#10;WHEN &quot;Disco VFD / GMV&quot; THEN &quot;VFD/GMV&quot;&#10;WHEN &quot;Deal Utilization Pro%&quot; THEN &quot;VFD/GMV&quot;&#10;WHEN &quot;Deal utilization%&quot; THEN &quot;VFD/GMV&quot;&#10;&#10;// Subscription //&#10;WHEN &quot;Subscriber % of GMV&quot; THEN &quot;Subscription&quot;&#10;WHEN &quot;Pro Vendor Weighted GMV Coverage&quot; THEN &quot;Subscription&quot;&#10;&#10;// Qcommerce //&#10;WHEN &quot;QC GMV % platform&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Shops Commercial] # key partners per MAU (Grocery &amp; H&amp;B)&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Shops] Vendor Fail Rate&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Shops Ops] % items not delivered&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Dmarts SC] Dmart weighted availability v2&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Shops] Offline Rate (Weighted)&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Shops Commercial] Grocery Assortment Quality Score (AAA supermarkets)&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Dmart Commercial] Dmart Assortment quality score v6&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Dmart] Fresh and Ultra Fresh Basket Penetration&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;[Shops Commercial] Promo GPV % (Grocery &amp; H&amp;B key partners)&quot; THEN &quot;Qcommerce&quot;&#10;WHEN &quot;QC New to Vertical (QC Trials)&quot; THEN &quot;Qcommerce&quot;&#10;&#10;//WHEN &quot;QC MAU as % of Platform&quot; THEN &quot;Qcommerce&quot;&#10;//WHEN &quot;[Dmart Commercial] Fresh and Ultra Fresh Availability&quot; THEN &quot;Qcommerce&quot;&#10;//WHEN &quot;[Shops] AAA Supermarket Assortment&quot; THEN &quot;Qcommerce&quot;&#10;&#10;ELSE &quot;Other&quot;&#10;END&#10;, &quot;Other&quot;)' />
      </column>
      <column caption='dummy' datatype='integer' name='[Calculation_5268085713444614147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
