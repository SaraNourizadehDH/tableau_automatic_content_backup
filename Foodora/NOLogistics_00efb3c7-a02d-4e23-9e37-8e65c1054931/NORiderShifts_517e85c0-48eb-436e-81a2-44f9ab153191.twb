    <datasource caption='Custom SQL Query (bl_lg_mgmt)' inline='true' name='federated.16na3m60cwrc9e13cqtr10q8zuxk' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gq97t40tpgvb61fnmlan0lu1h6b'>
            <connection CATALOG='foodora-bi-no' EXECCATALOG='foodora-bi-no' authentication='yes' class='bigquery' connection-dialect='google-sql' project='Foodora BI NO' schema='bl_lg_mgmt' server='' server-oauth='server-custom' username='alvaro.marcano@foodora.no' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gq97t40tpgvb61fnmlan0lu1h6b' name='Custom SQL Query' type='text'>SELECT  
s.rider_id,
r.rider_name,
r.email,
s.shift_start_at,
MAX(rv.name) AS rider_vehicle,
EXTRACT(ISOWEEK FROM s.shift_start_at) AS shift_week,
COUNT(s.shift_id) AS worked_shifts,
SUM(TIMESTAMP_DIFF(s.shift_end_at, s.shift_start_at, MINUTE) / 60) AS worked_hours
FROM `fulfillment-dwh-production.curated_data_shared.shifts` AS s
LEFT JOIN `fulfillment-dwh-production.curated_data_shared.riders` AS r ON s.rider_id = r.rider_id
LEFT JOIN UNNEST(rider_vehicles) AS rv
WHERE
s.country_code = &apos;no&apos;
AND
EXTRACT(YEAR FROM s.created_date) = 2024
AND
s.shift_state LIKE &apos;EVALUATED&apos;
GROUP BY
s.rider_id,
r.rider_name,
r.email,
s.shift_start_at,
shift_week
ORDER BY
shift_week DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0gq97t40tpgvb61fnmlan0lu1h6b' name='Custom SQL Query' type='text'>SELECT  
