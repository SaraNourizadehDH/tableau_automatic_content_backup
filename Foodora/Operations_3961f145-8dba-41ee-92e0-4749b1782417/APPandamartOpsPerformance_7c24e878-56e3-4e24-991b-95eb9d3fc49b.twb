      <column caption='know_req_equip_valid' datatype='real' name='[Calculation_1021824543175364608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([total_gross_order_utr]) &gt;0 THEN [know_req_equip] ELSE 0 END' />
      </column>
      <column caption='Random CC - Defect Rate' datatype='real' name='[Calculation_1242712030433579008]' role='measure' type='quantitative'>
