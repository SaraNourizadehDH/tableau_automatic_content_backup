      <column caption='UTR - Units' datatype='real' name='[Calculation_1242712030722236418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_picked_quantity_valid_order]) / SUM([total_shift_hrs])' />
      </column>
      <column caption='O/D/S' datatype='real' name='[Calculation_1242712030734647300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gross_order_utr])/COUNTD([Calculation_1242712030734954502])/COUNTD([date_local])' />
      </column>
      <column caption='Valid Dmart' datatype='string' name='[Calculation_1242712030734954502]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([total_gross_order_utr]) &gt;0 THEN [warehouse_id] END' />
      </column>
      <column caption='Daily Pickers' datatype='real' name='[Calculation_1242712030735147015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_pickers]) / COUNTD([date_local]),1)' />
      </column>
      <column caption='ABS - Units' datatype='real' name='[Calculation_1242712030736179208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_picked_quantity_gross_order]) / SUM([total_gross_order_utr])' />
      </column>
      <column caption='Is Valid Dmart?' datatype='boolean' name='[Calculation_1242712030739763210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1242712030734954502]) THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='PH - PF Score' datatype='integer' name='[Calculation_1242712030744219659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_695032091314868224]  &lt;= 0.004 THEN 1 ELSE 0 END' />
      </column>
      <column caption='PH - Performance Score' datatype='real' name='[Calculation_1242712030754795543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_1242712030744219659],0)&#10;+ IFNULL([PH - CC Defect Rate  Score (copy)_1242712030753779731],0)&#10;+ IFNULL([PH - PF Score (copy)_1242712030744866828],0)&#10;+ IFNULL([PH - PF Score (copy)_1242712030749646862],0)&#10;+ IFNULL([PH - IR  Score (copy)_2128865627182686209],0)&#10;+ IFNULL([PH - UTR  Score  (copy)_1242712030753300497],0)&#10;+ IFNULL([PH - KNOW Temp Score (copy)_1773081285530574849], 0)&#10;//+ IFNULL([PH - KNOW Temp Score],0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='PH - Store Tier' datatype='integer' name='[Calculation_1242712030758481948]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [MY - Performance Rank (copy)_5522327998880059404] &lt;= 7 THEN 1&#10;ELSEIF [MY - Performance Rank (copy)_5522327998880059404] &lt;= 14 THEN 2&#10;ELSEIF [MY - Performance Rank (copy)_5522327998880059404] &lt;= 21 THEN 3&#10;ELSE 4&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Closed Hour' datatype='real' name='[Calculation_2992501240406716416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_unavailable_hour]) / sum([total_open_hour])' />
      </column>
      <column caption='Graph Metric 1' datatype='real' name='[Calculation_5522327998892527641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;UTR&quot; THEN [Calculation_1242712030722236418]&#10;    WHEN &quot;Pick Time / Unit&quot; THEN [Pick + Pack Time / Unit (sec) (copy)_2321183405040726016]&#10;    WHEN &quot;PF&quot; THEN [Calculation_695032091314868224]&#10;    WHEN &quot;Defect Rate Random Count&quot; THEN [Calculation_1242712030433579008]&#10;    WHEN &quot;IR Order&quot; THEN [% IR (copy)_2128865627181764608]&#10;    WHEN &quot;Task Management Completion Rate&quot; THEN [Task Management Completion Rate (copy)_1773081285527805952]&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN [Calculation_740068090729005058]&#10;END' />
      </column>
      <column caption='know_compliant_days' datatype='string' name='[Calculation_6709237547325808640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_temp_compliance] = 1 AND NOT ISNULL([Calculation_1242712030734954502]) AND NOT ISNULL([know_req_equip])&#10;THEN (STR([date_local])+[Calculation_1242712030734954502]) &#10;ELSE NULL &#10;END' />
      </column>
      <column caption='know_temp_compliant_days' datatype='integer' name='[Calculation_6709237547331530753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_6709237547325808640])' />
      </column>
      <column caption='% PF' datatype='real' name='[Calculation_695032091314868224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pf_num]) / SUM([pf_den])' />
      </column>
      <column caption='Date Granularity' datatype='datetime' name='[Calculation_695032091315171329]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [date_local]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[date_local],&apos;monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[date_local])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[date_local])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[date_local])&#10;END' />
      </column>
      <column caption='% IR' datatype='real' name='[Calculation_740068090714390528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_incidents]) / SUM([total_gross_order])' />
      </column>
      <column caption='Pick + Pack Time / Unit (sec)' datatype='real' name='[Calculation_740068090721284097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pick_pack_time_in_sec]) / sum([pelican_picked_units])' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' name='[Calculation_740068090729005058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_fail_vendor_orders]) / SUM([total_vendor_orders])' />
