      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__ops_okr_dashboard' name='federated.0zdlxqn0p4c92m17r1wz016smhnk' />
          </datasources>
          <datasource-dependencies datasource='federated.0zdlxqn0p4c92m17r1wz016smhnk'>
            <column caption='% IR (order)' datatype='real' name='[% IR (copy)_2128865627181764608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_order_incident_count]) / SUM([total_gross_order])' />
            </column>
            <column caption='UTR - Units' datatype='real' name='[Calculation_1242712030722236418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_picked_quantity_valid_order]) / SUM([total_shift_hrs])' />
            </column>
            <column caption='O/D/S' datatype='real' name='[Calculation_1242712030734647300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gross_order_utr])/COUNTD([Calculation_1242712030734954502])/COUNTD([date_local])' />
            </column>
            <column caption='Valid Dmart' datatype='string' name='[Calculation_1242712030734954502]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([total_gross_order_utr]) &gt;0 THEN [warehouse_id] END' />
            </column>
            <column caption='ABS - Units' datatype='real' name='[Calculation_1242712030736179208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_picked_quantity_gross_order]) / SUM([total_gross_order_utr])' />
            </column>
            <column caption='% Closed Hour' datatype='real' name='[Calculation_2992501240406716416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_unavailable_hour]) / sum([total_open_hour])' />
            </column>
            <column caption='% PF' datatype='real' name='[Calculation_695032091314868224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pf_num]) / SUM([pf_den])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' name='[Calculation_740068090729005058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_fail_vendor_orders]) / SUM([total_vendor_orders])' />
            </column>
            <column caption='Pick Time / Unit (sec)' datatype='real' name='[Pick + Pack Time / Unit (sec) (copy)_2321183405040726016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pick_time_in_sec]) / sum([pelican_picked_units])' />
            </column>
            <column caption='CC - Defect Rate' datatype='real' name='[Random CC - Defect Rate (copy)_5522327998873030667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cc_stock_movement_all]) / SUM([cc_skus_all])' />
            </column>
            <column caption='CC SKUs All' datatype='integer' name='[cc_skus_all]' role='measure' type='quantitative' />
            <column caption='CC Stock Movement All' datatype='integer' name='[cc_stock_movement_all]' role='measure' type='quantitative' />
