            <column caption='MY - Store Tier' datatype='integer' name='[PH - Store Tier (copy)_1235182581143519283]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [PH Performance Rank (copy)_1235182581130465292] &lt;= 11 THEN 1&#10;ELSEIF [PH Performance Rank (copy)_1235182581130465292] &lt;= 22 THEN 2&#10;ELSEIF [PH Performance Rank (copy)_1235182581130465292] &lt;= 33 THEN 3&#10;ELSE 4&#10;END'>
