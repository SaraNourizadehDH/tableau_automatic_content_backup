    <worksheet name='MY Scorecard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12' underline='true'>MY Scorecard</run>
            <run>Æ&#10;</run>
            <run fontsize='10' italic='true'>4 Store Tier based on Performance Rank ( Ranking of Performance Score)</run>
            <run>Æ&#10;</run>
            <run fontsize='10' italic='true'>Each Store Tier has 16 Dmarts </run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10' italic='true'>Performance Score = Sum of </run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[UTR Score ] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[[PF Score] : PF <= 0.5% THEN 1 ELSE 0 ]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[CC Defect Rate Score] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[Pick + Pack Time Score] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[IR (order) Score] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[[Vendor FR Score] : FR <= 0.25% THEN 1 ELSE 0 ]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[Task Management Completion Score] : Compliance &gt;= 95% THEN 1 ELSE 0 </run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APPandamartOpsPerformance/MYScorecard?rev=' id='MYScorecard' path='/t/Foodora/workbooks/APPandamartOpsPerformance' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__ops_okr_dashboard' name='federated.0zdlxqn0p4c92m17r1wz016smhnk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zdlxqn0p4c92m17r1wz016smhnk'>
            <column caption='% IR (order)' datatype='real' name='[% IR (copy)_2128865627181764608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_order_incident_count]) / SUM([total_gross_order])' />
            </column>
            <column caption='ABS - Sku' datatype='real' name='[ABS - Units (copy)_1242712030736269321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_sku]) / SUM([total_gross_order_utr])' />
            </column>
            <column caption='Random CC - Defect Rate' datatype='real' name='[Calculation_1242712030433579008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cc_stock_movement]) / SUM([cc_skus])' />
            </column>
            <column caption='UTR - Units' datatype='real' name='[Calculation_1242712030722236418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_picked_quantity_valid_order]) / SUM([total_shift_hrs])' />
            </column>
            <column caption='O/D/S' datatype='real' name='[Calculation_1242712030734647300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gross_order_utr])/COUNTD([Calculation_1242712030734954502])/COUNTD([date_local])' />
            </column>
            <column caption='Valid Dmart' datatype='string' name='[Calculation_1242712030734954502]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([total_gross_order_utr]) &gt;0 THEN [warehouse_id] END' />
            </column>
            <column caption='Daily Pickers' datatype='real' name='[Calculation_1242712030735147015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM([total_pickers]) / COUNTD([date_local]),1)' />
            </column>
            <column caption='ABS - Units' datatype='real' name='[Calculation_1242712030736179208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_picked_quantity_gross_order]) / SUM([total_gross_order_utr])' />
            </column>
            <column caption='Is Valid Dmart?' datatype='boolean' name='[Calculation_1242712030739763210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1242712030734954502]) THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='% PF' datatype='real' name='[Calculation_695032091314868224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pf_num]) / SUM([pf_den])' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_695032091315171329]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [date_local]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[date_local],&apos;monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[date_local])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[date_local])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[date_local])&#10;END' />
            </column>
            <column caption='Pick + Pack Time / Unit (sec)' datatype='real' name='[Calculation_740068090721284097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pick_pack_time_in_sec]) / sum([pelican_picked_units])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' name='[Calculation_740068090729005058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_fail_vendor_orders]) / SUM([total_vendor_orders])' />
            </column>
            <column caption='MY - Task Management Completion Score' datatype='integer' name='[MY - KNOW Temp Score (copy)_1773081285531947010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Task Management Completion Rate (copy)_1773081285527805952]  &gt;= 0.95 THEN 1 ELSE 0 END' />
            </column>
            <column caption='MY - CC Defect Rate  Score' datatype='real' name='[PH - CC Defect Rate  Score (copy)_1235182581127712771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(RANK_PERCENTILE([Calculation_1242712030433579008],&apos;desc&apos;),3)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MY - IR (order)  Score' datatype='real' name='[PH - IR (order)  Score (copy)_1235182581129105415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(RANK_PERCENTILE([% IR (copy)_2128865627181764608],&apos;desc&apos;),3)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MY - PF Score' datatype='integer' name='[PH - PF Score (copy)_1235182581124792322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_695032091314868224]  &lt;= 0.005 THEN 1 ELSE 0 END' />
            </column>
            <column caption='MY - Performance Score' datatype='real' name='[PH - Performance Score (copy)_1235182581129977867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([PH - PF Score (copy)_1235182581124792322],0)&#10;+ IFNULL([PH - Pick + Pack Time  Score (copy)_1235182581128015877],0)&#10;+ IFNULL([PH - Vendor FR  Score (copy)_1235182581129474057],0)&#10;+ IFNULL([PH - UTR  Score  (copy)_1235182581123825664],0)&#10;+ IFNULL([PH - IR (order)  Score (copy)_1235182581129105415],0)&#10;+ IFNULL([PH - CC Defect Rate  Score (copy)_1235182581127712771],0)&#10;+ IFNULL([MY - KNOW Temp Score (copy)_1773081285531947010],0)&#10;//+ IFNULL([MY - KNOW Temp Score],0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MY - Pick + Pack Time  Score' datatype='real' name='[PH - Pick + Pack Time  Score (copy)_1235182581128015877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(RANK_PERCENTILE([Calculation_740068090721284097],&apos;desc&apos;),3)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MY - Store Tier' datatype='integer' name='[PH - Store Tier (copy)_1235182581143519283]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [PH Performance Rank (copy)_1235182581130465292] &lt;= 11 THEN 1&#10;ELSEIF [PH Performance Rank (copy)_1235182581130465292] &lt;= 22 THEN 2&#10;ELSEIF [PH Performance Rank (copy)_1235182581130465292] &lt;= 33 THEN 3&#10;ELSE 4&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MY - UTR  Score' datatype='real' name='[PH - UTR  Score  (copy)_1235182581123825664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(RANK_PERCENTILE([Calculation_1242712030722236418],&apos;asc&apos;),3)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MY - Vendor FR  Score' datatype='integer' name='[PH - Vendor FR  Score (copy)_1235182581129474057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_740068090729005058]  &lt;= 0.0025 THEN 1 ELSE 0 END' />
            </column>
            <column caption='MY - Performance Rank' datatype='integer' name='[PH Performance Rank (copy)_1235182581130465292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK([PH - Performance Score (copy)_1235182581129977867],&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Task Management Completion Rate' datatype='real' default-format='p0.00%' name='[Task Management Completion Rate (copy)_1773081285527805952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_assigned_completed_tasks])/SUM([num_of_assigned_tasks])' />
            </column>
            <column caption='CC SKUs' datatype='integer' name='[cc_skus]' role='measure' type='quantitative' />
            <column caption='CC Stock Movement' datatype='integer' name='[cc_stock_movement]' role='measure' type='quantitative' />
            <column caption='Date Local' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column caption='Global Entity ID' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1242712030739763210]' derivation='None' name='[none:Calculation_1242712030739763210:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_695032091315171329]' derivation='None' name='[none:Calculation_695032091315171329:qk]' pivot='key' type='quantitative' />
