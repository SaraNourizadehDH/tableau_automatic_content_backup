            <column caption='MY - IR (order)  Score' datatype='real' name='[PH - IR (order)  Score (copy)_1235182581129105415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(RANK_PERCENTILE([% IR (copy)_2128865627181764608],&apos;desc&apos;),3)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MY - PF Score' datatype='integer' name='[PH - PF Score (copy)_1235182581124792322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_695032091314868224]  &lt;= 0.005 THEN 1 ELSE 0 END' />
