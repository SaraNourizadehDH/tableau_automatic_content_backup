            </column>
            <column caption='PH - CC Defect Rate  Score' datatype='real' name='[PH - UTR  Score  (copy)_1242712030753300497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(RANK_PERCENTILE([Random CC - Defect Rate (copy)_5522327998873030667],&apos;desc&apos;),3)'>
