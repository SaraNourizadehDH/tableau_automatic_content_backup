            <column caption='MY - Performance Score' datatype='real' name='[PH - Performance Score (copy)_1235182581129977867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([PH - PF Score (copy)_1235182581124792322],0)&#10;+ IFNULL([PH - Pick + Pack Time  Score (copy)_1235182581128015877],0)&#10;+ IFNULL([PH - Vendor FR  Score (copy)_1235182581129474057],0)&#10;+ IFNULL([PH - UTR  Score  (copy)_1235182581123825664],0)&#10;+ IFNULL([PH - IR (order)  Score (copy)_1235182581129105415],0)&#10;+ IFNULL([PH - CC Defect Rate  Score (copy)_1235182581127712771],0)&#10;+ IFNULL([MY - KNOW Temp Score (copy)_1773081285531947010],0)&#10;//+ IFNULL([MY - KNOW Temp Score],0)'>
