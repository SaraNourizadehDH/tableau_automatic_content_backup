            <column caption='PK - Store Tier' datatype='integer' name='[HK - Store Tier (copy)_5522327998882865172]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='If [HK - Performance Rank (copy)_5522327998882865169] &lt;= 12 THEN 1&#10;ELSEIf [HK - Performance Rank (copy)_5522327998882865169] &lt;= 24 THEN 2&#10;ELSEIf [HK - Performance Rank (copy)_5522327998882865169] &lt;= 36 THEN 3&#10;ELSE 4&#10;END'>
