    <worksheet name='PK Scorecard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14' underline='true'>PK Scorecard</run>
            <run>Æ&#10;</run>
            <run fontsize='10' italic='true'>4 Store Tier based on Performance Rank ( Ranking of Performance Score)</run>
            <run>Æ&#10;</run>
            <run fontsize='10' italic='true'>Each Store Tier has 12 Dmarts </run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10' italic='true'>Performance Score = Sum of </run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[UTR Score ] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[[PF Score] : PF <= 0.4% THEN 1 ELSE 0 ]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[CC Defect Rate Score] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[Pick + Pack Time Score] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[IR (order) Score] : Relative 0 to 1</run>
            <run>Æ&#10;</run>
            <run fontsize='10'><![CDATA[[Vendor FR Score] : FR <= 0.25% THEN 1 ELSE 0 ]]></run>
            <run>Æ&#10;</run>
            <run fontsize='10'>[Task Management Completion Score] : Compliance &gt;= 95% THEN 1 ELSE 0 </run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APPandamartOpsPerformance/PKScorecard?rev=' id='PKScorecard' path='/t/Foodora/workbooks/APPandamartOpsPerformance' revision='' site='Foodora' />
