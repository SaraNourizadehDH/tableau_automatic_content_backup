            <column caption='PH - UTR  Score' datatype='real' name='[PH - PF Score (copy)_1242712030749646862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(RANK_PERCENTILE([Calculation_1242712030722236418],&apos;asc&apos;),3)'>
