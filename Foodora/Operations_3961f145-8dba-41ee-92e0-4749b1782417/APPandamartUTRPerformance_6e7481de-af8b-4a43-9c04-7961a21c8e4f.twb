    <worksheet name='UTR - Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Light,Tableau,Arial,sans-serif' fontsize='12' underline='true'>Store UTR Overview</run>
            <run>Æ&#10;&#10;</run>
            <run fontname='Tableau Light,Tableau,Arial,sans-serif' fontsize='10' italic='true'>* UTR = Picked units / Total Picker hrs</run>
            <run>Æ&#10;&#10;</run>
            <run fontname='Tableau Light,Tableau,Arial,sans-serif' fontsize='10' italic='true'>* </run>
            <run fontsize='10'>Only include Picker / Senior Picker / Floaters Job title and &quot;Evaluated&quot; shifts</run>
            <run>Æ&#10;&#10;</run>
            <run fontname='Tableau Light,Tableau,Arial,sans-serif' fontsize='10' italic='true' underline='true'>Click on global entity  &apos;+&apos; to expand dmarts</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='utr_dmarts' name='federated.1kfvgmn0z0dvqx13di2h51ybakj9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='UTR Type' datatype='string' name='[Date Granularity (copy)_1752111407994892288]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Order Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Valid Order&quot;'>
              <calculation class='tableau' formula='&quot;Valid Order&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kfvgmn0z0dvqx13di2h51ybakj9'>
            <column caption='ABS- Sku' datatype='real' name='[ABS- Units (copy)_977914446810595328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_sku]) / SUM([total_valid_order])' />
            </column>
            <column caption='Shopper Manhours' datatype='real' name='[Calculation_1752111407995187201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)_1752111407994892288]&#10;WHEN &quot;All&quot; THEN [total_shift_hrs]&#10;WHEN &quot;Pickers only&quot; THEN [total_shift_hrs] - [total_floater_shift_hrs]&#10;END' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_2689774943757635584]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [date_local]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[date_local],&apos;monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[date_local])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[date_local])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[date_local])&#10;END' />
            </column>
            <column caption='valid_dmarts' datatype='string' name='[Calculation_2689774943758348289]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([total_gross_order]) &gt;0 THEN [warehouse_id] END' />
            </column>
            <column caption='Total Dmart' datatype='integer' name='[Calculation_2689774943759036418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_2689774943758348289])' />
            </column>
            <column caption='UTR - Units' datatype='real' name='[Calculation_2689774943768207365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([Calculation_1752111407995187201]) THEN [Orders (copy)_2689774943776722956] ELSE NULL END)&#10;/&#10;SUM(IF NOT ISNULL([Calculation_1752111407995187201]) THEN [Calculation_1752111407995187201] ELSE NULL END)&#10;&#10;// Updated to the above formula on 2 Dec 2024, as part of APACQC-430&#10;// SUM([Picked Units]) / SUM([Shopper Manhours])' />
            </column>
            <column caption='ABS- Units' datatype='real' name='[Calculation_2689774943768543238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Orders (copy)_2689774943776722956]) / SUM([Calculation_2689774943773564936])' />
