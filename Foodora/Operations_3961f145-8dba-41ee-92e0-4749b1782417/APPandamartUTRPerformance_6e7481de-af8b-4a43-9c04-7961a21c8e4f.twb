      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1kfvgmn0z0dvqx13di2h51ybakj9].[sum:total_shift_hrs:qk]&quot;' value='Picker Hrs' />
        </aliases>
      </column>
      <column caption='ABS- Sku' datatype='real' name='[ABS- Units (copy)_977914446810595328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_sku]) / SUM([total_valid_order])' />
      </column>
      <column caption='Shopper Manhours' datatype='real' name='[Calculation_1752111407995187201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)_1752111407994892288]&#10;WHEN &quot;All&quot; THEN [total_shift_hrs]&#10;WHEN &quot;Pickers only&quot; THEN [total_shift_hrs] - [total_floater_shift_hrs]&#10;END' />
      </column>
      <column caption='Date Granularity' datatype='datetime' name='[Calculation_2689774943757635584]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [date_local]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[date_local],&apos;monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[date_local])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[date_local])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[date_local])&#10;END' />
      </column>
      <column caption='valid_dmarts' datatype='string' name='[Calculation_2689774943758348289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([total_gross_order]) &gt;0 THEN [warehouse_id] END' />
      </column>
      <column caption='Total Dmart' datatype='integer' name='[Calculation_2689774943759036418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_2689774943758348289])' />
      </column>
      <column caption='UTR - Units' datatype='real' name='[Calculation_2689774943768207365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([Calculation_1752111407995187201]) THEN [Orders (copy)_2689774943776722956] ELSE NULL END)&#10;/&#10;SUM(IF NOT ISNULL([Calculation_1752111407995187201]) THEN [Calculation_1752111407995187201] ELSE NULL END)&#10;&#10;// Updated to the above formula on 2 Dec 2024, as part of APACQC-430&#10;// SUM([Picked Units]) / SUM([Shopper Manhours])' />
      </column>
      <column caption='ABS- Units' datatype='real' name='[Calculation_2689774943768543238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Orders (copy)_2689774943776722956]) / SUM([Calculation_2689774943773564936])' />
      </column>
      <column caption='% Valid / Gross Order' datatype='real' name='[Calculation_2689774943768997895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_valid_order]) / SUM([total_gross_order])' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_2689774943773564936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Gross Order&quot; THEN [total_gross_order]&#10;WHEN &quot;Valid Order&quot; THEN [total_valid_order]&#10;END' />
      </column>
      <column caption='O/D/S' datatype='real' name='[Calculation_2689774943774343177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2689774943773564936])/([Calculation_2689774943759036418])/[Calculation_2689774943774674954]' />
      </column>
      <column caption='Days' datatype='integer' name='[Calculation_2689774943774674954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([date_local])' />
      </column>
      <column caption='Daily Pickers' datatype='real' name='[Calculation_2689774943775404043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([total_pickers]) / [Calculation_2689774943774674954],1)' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_3862329288559394817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Euro&quot; THEN [total_revenue_eur]&#10;WHEN &quot;LCY&quot; THEN [total_revenue_local]&#10;END' />
      </column>
      <column caption='APV - Order (total Revenue)' datatype='real' name='[Calculation_3862329288559800322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3862329288559394817]) / SUM([Calculation_2689774943773564936])' />
      </column>
      <column caption='Shopper Hours / Day' datatype='real' name='[Daily Pickers (copy)_3862329288563433475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([Calculation_1752111407995187201]) / [Calculation_2689774943759036418]/[Calculation_2689774943774674954],1)' />
      </column>
      <column caption='Shifts Per Day ' datatype='real' name='[O/D/S (copy)_2689774943777439757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_shifts])/([Calculation_2689774943759036418])/[Calculation_2689774943774674954]' />
      </column>
      <column caption='Operating Hrs' datatype='real' name='[O/D/S (copy)_2689774943790698510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pickup_hours])/([Calculation_2689774943759036418])/[Calculation_2689774943774674954]' />
      </column>
      <column caption='Picked Units' datatype='integer' name='[Orders (copy)_2689774943776722956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Gross Order&quot; THEN [total_picked_quantity_gross_order]&#10;WHEN &quot;Valid Order&quot; THEN [total_picked_quantity_valid_order]&#10;END' />
      </column>
