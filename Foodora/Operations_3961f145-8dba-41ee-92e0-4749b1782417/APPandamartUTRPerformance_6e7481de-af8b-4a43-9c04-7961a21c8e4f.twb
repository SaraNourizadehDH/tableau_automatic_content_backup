    <worksheet name='Run Rate - Graph'>
      <table>
        <view>
          <datasources>
            <datasource caption='sc_rev_run_rate' name='federated.1hgyv920l1v5i310dgj4p0ut65u0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='UTR Type' datatype='string' name='[Date Granularity (copy)_1752111407994892288]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Order Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Valid Order&quot;'>
              <calculation class='tableau' formula='&quot;Valid Order&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hgyv920l1v5i310dgj4p0ut65u0'>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_534802479949533184]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [date_local]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[date_local],&apos;monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[date_local])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[date_local])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[date_local])&#10;END' />
            </column>
            <column caption='valid_dmarts' datatype='string' name='[Calculation_534802479950184449]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([total_gross_order]) &gt;0 THEN [warehouse_id] END' />
            </column>
            <column caption='O/D/S' datatype='real' name='[Calculation_534802479950299138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_534802479950643204])/([Calculation_534802479950766085])/[Calculation_534802479950487555]' />
            </column>
            <column caption='days' datatype='integer' name='[Calculation_534802479950487555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([date_local])' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_534802479950643204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Gross Order&quot; THEN [total_gross_order]&#10;WHEN &quot;Valid Order&quot; THEN [total_valid_order]&#10;END' />
            </column>
            <column caption='total_dmarts' datatype='integer' name='[Calculation_534802479950766085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_534802479950184449])' />
            </column>
            <column caption='UTR - Units' datatype='real' name='[Calculation_534802479950946310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_534802479951245320]) / SUM([Calculation_534802479951065095])' />
            </column>
            <column caption='Shopper Manhours' datatype='real' name='[Calculation_534802479951065095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)_1752111407994892288]&#10;WHEN &quot;All&quot; THEN [total_shift_hrs]&#10;WHEN &quot;Pickers only&quot; THEN [total_shift_hrs] - [total_floater_shift_hrs]&#10;END' />
            </column>
            <column caption='Picked Units' datatype='integer' name='[Calculation_534802479951245320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Gross Order&quot; THEN [total_picked_quantity_gross_order]&#10;WHEN &quot;Valid Order&quot; THEN [total_picked_quantity_valid_order]&#10;END' />
            </column>
            <column caption='ABS - Units' datatype='real' name='[Calculation_534802479951540233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_picked_quantity_gross_order]) / SUM([total_gross_order])' />
            </column>
            <column caption='CPH - Euro' datatype='real' name='[Calculation_534802479952990219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [global_entity_id]&#10;WHEN &quot;FP_BD&quot; THEN -0.53&#10;WHEN &quot;FP_HK&quot; THEN -10.16&#10;WHEN &quot;FP_MY&quot; THEN -2.39&#10;WHEN &quot;FP_PH&quot; THEN -1.70&#10;WHEN &quot;FP_PK&quot; THEN -0.69&#10;WHEN &quot;FP_SG&quot; THEN -12.22&#10;WHEN &quot;FP_TH&quot; THEN -1.86&#10;WHEN &quot;FP_TW&quot; THEN -9.01&#10;END' />
            </column>
            <column caption='Shopper Cost - Euro' datatype='real' name='[Calculation_534802479953874956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_534802479951065095] * [Calculation_534802479952990219]' />
            </column>
            <column caption='APV - Euro' datatype='real' name='[Calculation_534802479956414477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_revenue_eur]) / SUM([total_valid_order])' />
            </column>
            <column caption='% SC / Revenue' datatype='real' name='[Calculation_534802479956766734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_534802479953874956]) / sum([total_revenue_eur])' />
            </column>
