        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1jkt9b51gfu8vo13gr72v07dchxe' name='Custom SQL Query' type='text'>SELECT * FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__vendor_closed_hours_summary`


-- WITH vendor_offline AS (
--   SELECT
--     vendor_time.global_entity_id,
--     wh.warehouse_id,
--     wh.im_warehouse_name AS warehouse_name,
--     vendor_time.vendor_code,
--     wh.warehouse_name AS vendor_name,
--     vendor_time.report_date AS date_local,
--     avail.reason,
--     SUM(avail.unavailable_seconds) AS total_unavailable_seconds,
--     0 AS total_open_sec,
--     0 AS total_valid_order,
--     0 AS total_picked_quantity,
--     0 AS total_revenue_eur
--   FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_offline` AS vendor_time,
--   UNNEST(vendor_time.availabilities) AS avail
--   LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` AS wh
--          ON wh.global_entity_id = vendor_time.global_entity_id
--         AND wh.warehouse_id_backend = vendor_time.vendor_code
--   LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS vendors
--          ON vendors.global_entity_id = vendor_time.global_entity_id
--         AND vendors.uuid = vendor_time.pd_vendor_uuid
--   INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
--           ON vendor_time.global_entity_id = shared_countries.global_entity_id
--          AND shared_countries.region = &quot;Asia&quot;
--          AND shared_countries.company_name = &quot;Foodpanda&quot;
--   WHERE vendor_time.report_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
--     AND wh.warehouse_id IS NOT NULL
--     AND wh.is_dmart
--     AND NOT wh.is_dc
--     AND vendors.vertical_type = &quot;darkstores&quot;
--   GROUP BY
--   vendor_time.global_entity_id,
--   wh.warehouse_id,
--   wh.im_warehouse_name,
--   vendor_time.vendor_code,
--   wh.warehouse_name,
--   vendor_time.report_date,
--   avail.reason
-- ),


