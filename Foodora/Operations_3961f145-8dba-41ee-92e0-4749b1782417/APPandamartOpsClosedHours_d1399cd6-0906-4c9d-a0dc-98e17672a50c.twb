      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_527DBCCCF2A04A198555EFC186BC95DF'>
            <properties context=''>
              <relation connection='bigquery.1jkt9b51gfu8vo13gr72v07dchxe' name='Custom SQL Query' type='text'>SELECT * FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__vendor_closed_hours_summary`


-- WITH vendor_offline AS (
--   SELECT
--     vendor_time.global_entity_id,
--     wh.warehouse_id,
--     wh.im_warehouse_name AS warehouse_name,
--     vendor_time.vendor_code,
--     wh.warehouse_name AS vendor_name,
--     vendor_time.report_date AS date_local,
--     avail.reason,
--     SUM(avail.unavailable_seconds) AS total_unavailable_seconds,
--     0 AS total_open_sec,
--     0 AS total_valid_order,
--     0 AS total_picked_quantity,
--     0 AS total_revenue_eur
--   FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_offline` AS vendor_time,
--   UNNEST(vendor_time.availabilities) AS avail
--   LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` AS wh
--          ON wh.global_entity_id = vendor_time.global_entity_id
--         AND wh.warehouse_id_backend = vendor_time.vendor_code
--   LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS vendors
--          ON vendors.global_entity_id = vendor_time.global_entity_id
--         AND vendors.uuid = vendor_time.pd_vendor_uuid
--   INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
--           ON vendor_time.global_entity_id = shared_countries.global_entity_id
--          AND shared_countries.region = &quot;Asia&quot;
--          AND shared_countries.company_name = &quot;Foodpanda&quot;
--   WHERE vendor_time.report_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
--     AND wh.warehouse_id IS NOT NULL
--     AND wh.is_dmart
--     AND NOT wh.is_dc
--     AND vendors.vertical_type = &quot;darkstores&quot;
--   GROUP BY
--   vendor_time.global_entity_id,
--   wh.warehouse_id,
--   wh.im_warehouse_name,
--   vendor_time.vendor_code,
--   wh.warehouse_name,
--   vendor_time.report_date,
--   avail.reason
-- ),


-- vendor_open AS (
--   SELECT
--     vendor_time.global_entity_id,
--     wh.warehouse_id,
--     wh.im_warehouse_name AS warehouse_name,
--     vendor_time.vendor_code,
--     wh.warehouse_name AS vendor_name,
--     vendor_time.report_date AS date_local,
--     CAST(NULL AS STRING) AS reason,
--     0 AS total_unavailable_seconds,
--     SUM(vendor_time.total_open_seconds) AS total_open_sec,
--     0 AS total_valid_order,
--     0 AS total_picked_quantity,
--     0 AS total_revenue_eur
--   FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_offline` AS vendor_time
--   LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` AS wh
--          ON wh.global_entity_id = vendor_time.global_entity_id
--         AND wh.warehouse_id_backend = vendor_time.vendor_code
--   LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS vendors
--          ON vendors.global_entity_id = vendor_time.global_entity_id
--         AND vendors.uuid = vendor_time.pd_vendor_uuid
--   INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
--           ON vendor_time.global_entity_id = shared_countries.global_entity_id
--          AND shared_countries.region = &quot;Asia&quot;
--          AND shared_countries.company_name = &quot;Foodpanda&quot;
--   WHERE vendor_time.report_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
--     AND wh.warehouse_id IS NOT NULL
--     AND wh.is_dmart
--     AND NOT wh.is_dc
--     AND vendors.vertical_type = &quot;darkstores&quot;
--   GROUP BY
--   vendor_time.global_entity_id,
--   wh.warehouse_id,
--   wh.im_warehouse_name,
--   vendor_time.vendor_code,
--   wh.warehouse_name,
--   vendor_time.report_date
-- ),

-- pd_order AS (
--   SELECT
--     pd_order.global_entity_id,
--     pd_order.code,
--     pd_order.is_gross_order,
--     pd_order.is_valid_order,
--     COUNT(*) AS records
--   FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_order
--   WHERE pd_order.created_date_utc &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
--   GROUP BY
--   pd_order.global_entity_id,
--   pd_order.code,
--   pd_order.is_gross_order,
--   pd_order.is_valid_order
-- ),

-- orders AS (
--   SELECT
--     customer_order.global_entity_id,
--     wh.warehouse_id,
--     wh.im_warehouse_name AS warehouse_name,
--     customer_order.vendor_code,
--     wh.warehouse_name AS vendor_name,
--     customer_order.ordered_date_local,
--     customer_order.pd_order_code,
--     COUNT(DISTINCT customer_order.sku) AS total_sku,
--     SUM(customer_order.ordered_quantity) AS ordered_quantity,
--     SUM(IFNULL((customer_order.delivered_quantity), 0)) AS picked_quantity,
--     SAFE_CAST(
--       SUM(SAFE_MULTIPLY(customer_order.delivered_quantity, customer_order.listed_unit_price_eur_after_discount))
--       AS FLOAT64
--     ) AS gfv_eur
--   FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report` AS customer_order
--   LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` AS wh
--          ON wh.global_entity_id = customer_order.global_entity_id
--         AND wh.warehouse_id_backend = customer_order.vendor_code
--   WHERE customer_order.ordered_date_local &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)
--     AND customer_order.sku NOT IN (&quot;1X09I1&quot;, &quot;VVT20D&quot;, &quot;27Q25S&quot;) -- exclude HK packaging skus
--     AND customer_order.is_dmart
--   GROUP BY
--   customer_order.global_entity_id,
--   wh.warehouse_id,
--   wh.im_warehouse_name,
--   customer_order.vendor_code,
--   wh.warehouse_name,
--   customer_order.ordered_date_local,
--   customer_order.pd_order_code
-- ),

-- orders_summary AS (
--   SELECT
--     orders.*,
--     pd_order.is_gross_order,
--     pd_order.is_valid_order,
--     CASE WHEN pd_order.is_gross_order THEN 1 ELSE 0 END AS total_gross_order,
--     CASE WHEN pd_order.is_valid_order THEN 1 ELSE 0 END AS total_valid_order,
--     CASE WHEN pd_order.is_gross_order THEN orders.picked_quantity ELSE 0 END AS picked_quantity_gross_order,
--     CASE WHEN pd_order.is_valid_order THEN orders.picked_quantity ELSE 0 END AS picked_quantity_valid_order
--   FROM orders
--   LEFT JOIN pd_order
--          ON pd_order.global_entity_id = orders.global_entity_id
--         AND pd_order.code = orders.pd_order_code
--   WHERE pd_order.is_valid_order
-- ),

-- order_final AS (
--   SELECT
--     global_entity_id,
--     warehouse_id,
--     warehouse_name,
--     vendor_code,
--     vendor_name,
--     ordered_date_local AS date_local,
--     CAST(NULL AS STRING) AS reason,
--     0 AS total_unavailable_seconds,
--     0 AS total_open_sec,
--     SUM(total_valid_order) AS total_valid_order,
--     SUM(picked_quantity_valid_order) AS total_picked_quantity,
--     SUM(gfv_eur) AS total_revenue_eur
--   FROM orders_summary
--   GROUP BY
--   global_entity_id,
--   warehouse_id,
--   warehouse_name,
--   vendor_code,
--   vendor_name,
--   ordered_date_local
-- )


-- SELECT
-- *
-- FROM order_final
-- WHERE warehouse_id NOT IN (&quot;675c2ee9-4fe5-4083-832b-b474b78ade77&quot;, &quot;181ed9ae-4ae1-4e9f-a1ee-470ba7dbce71&quot;)-- remove pandago Biz, virtual stores

-- UNION ALL

-- SELECT
-- *
-- FROM vendor_open
-- WHERE warehouse_id NOT IN (&quot;675c2ee9-4fe5-4083-832b-b474b78ade77&quot;, &quot;181ed9ae-4ae1-4e9f-a1ee-470ba7dbce71&quot;)-- remove pandago Biz, virtual stores

-- UNION ALL

-- SELECT
-- *
-- FROM vendor_offline
-- WHERE warehouse_id NOT IN (&quot;675c2ee9-4fe5-4083-832b-b474b78ade77&quot;, &quot;181ed9ae-4ae1-4e9f-a1ee-470ba7dbce71&quot;)-- remove pandago Biz, virtual stores</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
