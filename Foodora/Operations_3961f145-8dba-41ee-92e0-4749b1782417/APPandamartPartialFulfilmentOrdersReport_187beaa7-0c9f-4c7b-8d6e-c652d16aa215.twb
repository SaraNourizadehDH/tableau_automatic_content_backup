          <datasource-dependencies datasource='federated.01avyon07y0jqh19f64ao19xzepc'>
            <column caption='% DMG' datatype='real' name='[% Cycle Count (copy)_4502614489744916485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_dmg_adjusted_quantity_3days]) / SUM([total_adjusted_quantity_3days])' />
            </column>
            <column caption='% Expiry' datatype='real' name='[% DMG (copy)_4502614489744969734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_exp_adjusted_quantity_3days]) / SUM([total_adjusted_quantity_3days])' />
            </column>
            <column caption='% Other' datatype='real' name='[% Expiry (copy)_2295076620791660544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_other_adjusted_quantity_3days]) / SUM([total_adjusted_quantity_3days])' />
            </column>
            <column caption='% Stock Subtract' datatype='real' name='[% Expiry (copy)_4502614489745031175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_ss_adjusted_quantity_3days]) / SUM([total_adjusted_quantity_3days])' />
            </column>
            <column caption='% Supplier Return' datatype='real' name='[% Other (copy)_2295076620793098241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_sr_adjusted_quantity_3days]) / SUM([total_adjusted_quantity_3days])' />
            </column>
