      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0l1s8je0pu1xcl19yme180liruzj]&quot;' value='Potential Bucket' />
        </aliases>
      </column>
      <column caption='Columns_cohort' datatype='string' name='[Calculation_1221882914712244225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Granularity rows (copy)_888898004475199488]&#13;&#10;when &apos;Daily&apos; then [[days_cohort]] (copy)_1221882914712346626]&#13;&#10;when &apos;Weekly&apos; then [[days_cohort]] (copy) (copy 2)_1221882914712670213]&#13;&#10;when &apos;Monthly&apos; then [[days_cohort]] (copy) (copy)_1221882914712354819]&#13;&#10;end' />
      </column>
      <column caption='Cohort Status' datatype='string' name='[Calculation_1221882914716487687]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN({ FIXED [Calculation_237283452574384130] : MIN(IF DATEDIFF(&apos;day&apos;, [install_date], { FIXED : MAX([install_date]) }) &lt; [Parameters].[Parameter 2] * 30 THEN FALSE ELSE TRUE END) }) THEN &apos;Closed&apos;&#13;&#10;ELSE &apos;Open&apos;&#13;&#10;END' />
      </column>
      <column caption='Dates (install)' datatype='date' datatype-customized='true' default-format='S' name='[Calculation_237283452574384130]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(case [Parameters].[Parameter 1]&#13;&#10;when &apos;Daily&apos; then [install_date]&#13;&#10;when &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[install_date],&apos;monday&apos;)&#13;&#10;when &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[install_date])&#13;&#10;when &apos;Quarter&apos; then DATETRUNC(&apos;quarter&apos;,[install_date])&#13;&#10;end)' />
      </column>
      <column caption='Share, installs' datatype='real' default-format='p0.0%' name='[Calculation_359725055596265472]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='If&#13;&#10;SUM([installs]) / TOTAL(SUM([installs])) = 1 then null&#13;&#10;else SUM([installs]) / TOTAL(SUM([installs]))&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='running CVR' datatype='real' default-format='p0.0%' name='[Calculation_636414957374427137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([orders]) &gt; 0 THEN &#13;&#10;   RUNNING_SUM(sum([orders]))/[Calculation_636414957413179397]&#13;&#10;ELSE &#13;&#10;   NULL &#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='window max' datatype='integer' name='[Calculation_636414957413179397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;sum({ &#13;&#10;fixed [install_date],[global_entity_id],[cohort_mode],[os_name],[marketing_channel]&#13;&#10;:&#13;&#10;sum([installs])&#13;&#10;&#13;&#10;})&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dates (reinstall)' datatype='date' datatype-customized='true' default-format='S' name='[Dates (install) (copy)_636414957378899972]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(case [Parameters].[Parameter 1]&#13;&#10;when &apos;Daily&apos; then [install_date]&#13;&#10;when &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[install_date],&apos;monday&apos;)&#13;&#10;when &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[install_date])&#13;&#10;when &apos;Quarter&apos; then DATETRUNC(&apos;quarter&apos;,[install_date])&#13;&#10;end)' />
      </column>
      <column caption='weeks_cohort' datatype='string' name='[[days_cohort]] (copy) (copy 2)_1221882914712670213]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 6 THEN &apos;0&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; [Parameters].[Parameter 2] * 7 THEN &apos;Outside Cohort window&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 6 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 13 THEN &apos;1&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 13 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 20 THEN &apos;2&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 20 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 27 THEN &apos;3&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 27 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 34 THEN &apos;4&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 34 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 41 THEN &apos;5&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 41 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 48 THEN &apos;6&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 48 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= [Parameters].[Parameter 2] * 7 THEN &apos;7+ weeks&apos;&#13;&#10;ELSE &apos;Installs&apos;&#13;&#10;END' />
      </column>
      <column caption='months_cohort' datatype='string' name='[[days_cohort]] (copy) (copy)_1221882914712354819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 30 THEN &apos;0&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; [Parameters].[Parameter 2] * 30 THEN &apos;Outside Cohort window&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 30 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 60 THEN &apos;1&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 60 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 90 THEN &apos;2&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 90 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 120 THEN &apos;3&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 120 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 150 THEN &apos;4&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 150 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 180 THEN &apos;5&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 180 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= 210 THEN &apos;6&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 210 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= [Parameters].[Parameter 2] * 30 THEN &apos;7+ months&apos;&#13;&#10;ELSE &apos;Installs&apos;&#13;&#10;END' />
      </column>
      <column caption='days_cohort' datatype='string' name='[[days_cohort]] (copy)_1221882914712346626]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) = 0 THEN &apos;0&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; [Parameters].[Parameter 2] * 30 THEN &apos;Outside Cohort window&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) = 1 THEN &apos;1&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) = 2 THEN &apos;2&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) = 3 THEN &apos;3&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) = 4 THEN &apos;4&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) = 5 THEN &apos;5&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) = 6 THEN &apos;6&apos;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &gt; 6 AND DATEDIFF(&apos;day&apos;, [install_date], [order_date]) &lt;= [Parameters].[Parameter 2] * 30 THEN &apos;7+ days&apos;&#13;&#10;ELSE &apos;Installs&apos;&#13;&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='install to cohort' datatype='table' name='[__tableau_internal_object_id__].[_8F736FE023E24DDEB9F2B76875DA5AAB]' role='measure' type='quantitative' />
