      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='install to cohort' id='_8F736FE023E24DDEB9F2B76875DA5AAB'>
            <properties context=''>
              <relation connection='bigquery.0q6rlqz1esymaj1b1czx806dsfcb' name='install to cohort query' type='text'>WITH &#13;
&#13;
adj_acq as (SELECT&#13;
global_entity_id,&#13;
device.reftag,&#13;
case when lower(event_name) = &apos;real_acquisition&apos; then event_date_utc else null end as order_date&#13;
FROM&#13;
    `fulfillment-dwh-production.pandata_report.regional_eu_adj_events`&#13;
  WHERE&#13;
    event_date_utc &gt;&gt;= &apos;2023-01-01&apos;&#13;
    AND lower(event_name) = &apos;real_acquisition&apos;&#13;
    AND global_entity_id IN (&apos;FO_NO&apos;,&apos;OP_SE&apos;,&apos;NP_HU&apos;,&apos;PO_FI&apos;,&apos;MJM_AT&apos;,&apos;DJ_CZ&apos;)&#13;
qualify ROW_NUMBER() OVER (PARTITION BY device.reftag ORDER BY event_date_utc) = 1&#13;
),&#13;
&#13;
&#13;
adj_inst as (SELECT&#13;
global_entity_id,&#13;
device.reftag,&#13;
    CASE&#13;
      WHEN source.campaign_name LIKE &apos;mob_%&apos; THEN &apos;App marketing&apos;&#13;
      WHEN source.campaign_name LIKE &apos;dis_r%&apos; THEN &apos;Display&apos;&#13;
      WHEN (source.campaign_name LIKE &apos;ps_reach%&apos; OR source.campaign_name LIKE &apos;smartly_reach%&apos; OR source.campaign_name LIKE &apos;ps_rma%&apos; OR source.campaign_name LIKE &apos;smartly_rma%&apos; or source.network_name = &apos;Unattributed&apos;) THEN &apos;Paid Social - Reach / RMA&apos;&#13;
      WHEN (source.campaign_name LIKE &apos;%sem%&apos;&#13;
      AND source.campaign_name NOT LIKE &apos;%sem_bra%&apos;) THEN &apos;SEM non-brand&apos;&#13;
      WHEN source.campaign_name LIKE &apos;%sem_bra%&apos; THEN &apos;SEM Brand&apos;&#13;
      WHEN source.campaign_name IS NULL&#13;
    AND source.is_organic =1 THEN &apos;Organic&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
  END&#13;
    AS marketing_channel,&#13;
        source.is_organic,&#13;
            device.os_name,&#13;
case when activity_kind in (&apos;install&apos;,&apos;reinstall&apos;) then 1 else 0 end as install,&#13;
DATE(installed_at_utc) AS install_date,&#13;
date(reinstalled_at_utc) as reinstall_date&#13;
FROM&#13;
    `fulfillment-dwh-production.pandata_report.regional_eu_adj_events`&#13;
  WHERE&#13;
    event_date_utc &gt;&gt;= &apos;2023-01-01&apos;&#13;
    AND lower(activity_kind) in (&apos;install&apos;,&apos;reinstall&apos;)&#13;
    AND global_entity_id IN (&apos;FO_NO&apos;,&apos;OP_SE&apos;,&apos;NP_HU&apos;,&apos;PO_FI&apos;,&apos;MJM_AT&apos;,&apos;DJ_CZ&apos;)&#13;
qualify ROW_NUMBER() OVER (PARTITION BY device.reftag ORDER BY reinstalled_at_utc desc) = 1&#13;
),&#13;
&#13;
install_data as &#13;
(&#13;
select&#13;
global_entity_id,&#13;
os_name,&#13;
marketing_channel,&#13;
install_date,&#13;
order_date,&#13;
case&#13;
when reinstall_date &gt;&gt; order_date then &apos;acq. cohort (install) / reinstall_after_acq&apos;&#13;
when order_date is null and reinstall_date is null then &apos;acq. pending (install)&apos;&#13;
when order_date is null and reinstall_date is not null then &apos;acq. pending (reinstall)&apos;&#13;
when order_date is not null and reinstall_date is null then &apos;acq. cohort (install)&apos;&#13;
when order_date is not null and reinstall_date is not null then &apos;acq. cohort (reinstall)&apos;&#13;
else &apos;other&apos;&#13;
end as cohort_type,&#13;
sum(install) installs,&#13;
count(order_date) orders,&#13;
&apos;install&apos; as cohort_mode,&#13;
from adj_inst&#13;
left join adj_acq using (reftag,global_entity_id)&#13;
group by all &#13;
),&#13;
&#13;
reinstall_data as (&#13;
select&#13;
global_entity_id,&#13;
os_name,&#13;
marketing_channel,&#13;
reinstall_date,&#13;
order_date,&#13;
case&#13;
when reinstall_date &gt;&gt; order_date then &apos;acq. cohort (install) / reinstall_after_acq&apos;&#13;
when order_date is null and reinstall_date is null then &apos;acq. pending (install)&apos;&#13;
when order_date is null and reinstall_date is not null then &apos;acq. pending (reinstall)&apos;&#13;
when order_date is not null and reinstall_date is null then &apos;acq. cohort (install)&apos;&#13;
when order_date is not null and reinstall_date is not null then &apos;acq. cohort (reinstall)&apos;&#13;
else &apos;other&apos;&#13;
end as cohort_type,&#13;
sum(install) installs,&#13;
count(order_date) orders,&#13;
&apos;reinstall&apos; as cohort_mode,&#13;
from adj_inst&#13;
left join adj_acq using (reftag,global_entity_id)&#13;
group by all &#13;
),&#13;
&#13;
unioned as (&#13;
select * from install_data&#13;
union all&#13;
select * from reinstall_data&#13;
)&#13;
&#13;
select * from unioned&#13;
where install_date &gt;&gt;= &apos;2023-01-01&apos;&#13;
and os_name != &apos;android-tv&apos;&#13;
&#13;
union all&#13;
&#13;
SELECT * FROM `dhh---analytics-eu.bi_marketing.install_to_1st_order_TR`</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.0l1s8je0pu1xcl19yme180liruzj'>
      <datasources>
