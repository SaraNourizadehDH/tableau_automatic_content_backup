voucher_code_grouped&#13;
from voucher_grouping_daily&#13;
group by all&#13;
)&#13;
&#13;
select &#13;
global_entity_id,&#13;
is_acquisition,&#13;
ifnull(voucher_code_grouped,&apos;No Voucher&apos;) voucher_code_grouped, &#13;
date_trunc(event_date_utc,week(monday)) week,&#13;
date_trunc(event_date_utc,month) month,&#13;
objective_dh,&#13;
channel_grouping_dh,&#13;
sub_channel_dh,&#13;
os_name,&#13;
count(distinct transaction_order_code) orders&#13;
from raw&#13;
left join vouchers_grouped using (global_entity_id, voucher_code)&#13;
group by all</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
