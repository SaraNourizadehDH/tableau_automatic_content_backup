        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1q9g6mj12adl5612awtzu0lhb7lg' name='Custom SQL Query' type='text'>with&#13;
&#13;
raw as (&#13;
  select * from `dhh---analytics-eu.bi_marketing.regional_pandora_adj_orders_events`&#13;
),&#13;
&#13;
voucher_grouping_daily as (&#13;
select  &#13;
global_entity_id, &#13;
voucher_code, &#13;
event_date_utc date,&#13;
if(&#13;
  count(1) / sum( count(1) ) over(partition by global_entity_id, event_date_utc) &gt;&gt; 0.001,&#13;
  true,&#13;
  null&#13;
) not_other_voucher&#13;
from raw&#13;
where voucher_code is not null&#13;
group by all order by 4 desc&#13;
),&#13;
&#13;
vouchers_grouped as (&#13;
select &#13;
global_entity_id,&#13;
voucher_code, &#13;
if(&#13;
  count(not_other_voucher) &gt;&gt; 0,&#13;
  voucher_code,&#13;
  &apos;Other&apos;)&#13;
voucher_code_grouped&#13;
from voucher_grouping_daily&#13;
group by all&#13;
)&#13;
&#13;
select &#13;
global_entity_id,&#13;
is_acquisition,&#13;
ifnull(voucher_code_grouped,&apos;No Voucher&apos;) voucher_code_grouped, &#13;
date_trunc(event_date_utc,week(monday)) week,&#13;
date_trunc(event_date_utc,month) month,&#13;
objective_dh,&#13;
channel_grouping_dh,&#13;
sub_channel_dh,&#13;
os_name,&#13;
count(distinct transaction_order_code) orders&#13;
from raw&#13;
left join vouchers_grouped using (global_entity_id, voucher_code)&#13;
group by all</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
