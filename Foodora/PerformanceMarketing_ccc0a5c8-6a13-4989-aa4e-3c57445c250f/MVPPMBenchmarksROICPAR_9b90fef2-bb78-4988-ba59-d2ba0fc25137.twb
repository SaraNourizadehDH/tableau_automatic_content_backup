        <view>
          <datasources>
            <datasource caption='MCR + Topline (flexible calc)' name='federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)' />
            <datasource caption='MCR + Topline' name='federated.122wwyu1q9gpom145dyhi1wq7r35' />
          </datasources>
          <datasource-dependencies datasource='federated.122wwyu1q9gpom145dyhi1wq7r35'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)'>
            <column caption='60D GMV (Acqs+Recqs) / CPAR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[60D GMV (Acqs) / CPA (copy)_1039487091800928260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum([GMV_60d_acqs]+[GMV_60d_reacqs])/(sum([acqs])+sum([reacqs]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([actual_eur]) / (sum([acqs]) + sum([reacqs]) )&#13;&#10;)' />
            </column>
            <column caption='pGMV_6M (Acqs) / CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[60D GMV (Acqs) / CPA (copy)_761389824369856512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum([p_gmv_6M_acquisitions])/sum([acqs])&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([actual_eur]) / sum([acqs])&#13;&#10;)' />
            </column>
            <column caption='CPAR' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[CPA (copy)_1039487091798605825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_eur]) / (sum([acqs])+sum([reacqs]))' />
            </column>
            <column caption='CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_1039487091798175744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_eur]) / sum([acqs])' />
            </column>
            <column caption='60D GMV (Acqs) / CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1039487091800223747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum([GMV_60d_acqs])/sum([acqs])&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([actual_eur]) / sum([acqs])&#13;&#10;)' />
            </column>
            <column caption='acqs share' datatype='real' default-format='p0%' name='[Calculation_1039487091802427397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acqs]) / sum([acqs]+[reacqs])' />
            </column>
            <column datatype='real' name='[GMV_60d_acqs]' role='measure' type='quantitative' />
            <column datatype='real' name='[GMV_60d_reacqs]' role='measure' type='quantitative' />
            <column datatype='string' name='[account_group]' role='dimension' type='nominal' />
            <column datatype='string' name='[account_name]' role='dimension' type='nominal' />
            <column caption='reacqs share' datatype='real' default-format='p0%' name='[acqs share (copy)_1039487091802570758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Calculation_1039487091802427397]' />
            </column>
            <column datatype='real' name='[acqs]' role='measure' type='quantitative' />
            <column caption='marketing_costs' datatype='real' name='[actual_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
