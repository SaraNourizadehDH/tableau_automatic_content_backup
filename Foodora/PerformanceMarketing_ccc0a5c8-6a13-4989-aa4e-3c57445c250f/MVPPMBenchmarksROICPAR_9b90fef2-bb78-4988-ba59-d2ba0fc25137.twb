  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
cohort_month month,
sum(gmv)/sum(New_customers) reacqs_avgGMV_per_NC
from  `dhh---analytics-eu.bi_marketing.regional_eu_orders_cohort_M0_M11_new_reacquisitions`
where aggregation_level = 'monthly'
and month_diff_daily between 0 and 2
group by all
),

pm_media as (
select 
'pm_media' as category,
a.country,
a.month,
acqs,
reacqs,
acqs*b.acqs_avgGMV_per_NC GMV_60d_acqs,
reacqs*d.reacqs_avgGMV_per_nc GMV_60d_reacqs,
IF(DATE_DIFF(CURRENT_DATE(), LAST_DAY(a.month), DAY) >> 15, acqs * e.p_gmv_6M_user_acquisitions, NULL) AS p_gmv_6M_acquisitions,
c.actual_eur marketing_costs
from acqs_reacqs a
left join acqs_avgGMV b on a.country = b.country and a.month = b.month and b.pm_nonpm = 'PM'
left join PM_media_costs c on a.country = c.country and a.month = c.month
left join reacqs_avgGMV d on a.country = d.country and a.month = d.month and d.pm_nonpm = 'PM'
left join pgmv_cohort_pm e on a.country = e.country and a.month = e.month

where 1=1
and a.month in (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 1 MONTH), MONTH), INTERVAL 1 MONTH)) AS month)
and (acqs >> 0 or reacqs >> 0)
and a.pm_nonpm = 'PM'
),

pm_total as (
  select 
'pm_total' as category,
a.country,
a.month,
acqs,
reacqs,
acqs*b.acqs_avgGMV_per_NC GMV_60d_acqs,
reacqs*d.reacqs_avgGMV_per_nc GMV_60d_reacqs,
IF(DATE_DIFF(CURRENT_DATE(), LAST_DAY(a.month), DAY) >> 15, acqs * e.p_gmv_6M_user_acquisitions, NULL) AS p_gmv_6M_acquisitions,
c.actual_eur
from acqs_reacqs a
left join acqs_avgGMV b on a.country = b.country and a.month = b.month and b.pm_nonpm = 'PM'
left join PM_total_costs c on a.country = c.country and a.month = c.month
left join reacqs_avgGMV d on a.country = d.country and a.month = d.month and d.pm_nonpm = 'PM'
left join pgmv_cohort_pm e on a.country = e.country and a.month = e.month
where 1=1
and a.month in (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 1 MONTH), MONTH), INTERVAL 1 MONTH)) AS month)
and (acqs >> 0 or reacqs >> 0)
and a.pm_nonpm = 'PM'
),

marketing_total as (
  select 
'marketing_topline' as category,
a.country,
a.month,
acqs,
reacqs,
acqs*b.acqs_avgGMV_per_NC GMV_60d_acqs,
reacqs*d.reacqs_avgGMV_per_nc GMV_60d_reacqs,
IF(DATE_DIFF(CURRENT_DATE(), LAST_DAY(a.month), DAY) >> 15, acqs * e.p_gmv_6M_user_acquisitions, NULL) AS p_gmv_6M_acquisitions,
c.actual_eur
from acqs_reacqs_total a
left join acqs_avgGMV_total b on a.country = b.country and a.month = b.month
left join total_marketing_costs c on a.country = c.country and a.month = c.month
left join reacqs_avgGMV_total d on a.country = d.country and a.month = d.month
left join pgmv_cohort_total e on a.country = e.country and a.month = e.month
where 1=1
and a.month in (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 1 MONTH), MONTH), INTERVAL 1 MONTH)) AS month)
and (acqs >> 0 or reacqs >> 0)
)



select * from pm_media
union all
select * from pm_total
union all
select * from marketing_total]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='MCR + Topline (flexible calc)' inline='true' name='federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0rak0kb1saclah1es9ajd0km0wz1 (copy 2)'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='EU Data Production' schema='bi_marketing' server-oauth='' username='tamerlan.saidov@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rak0kb1saclah1es9ajd0km0wz1 (copy 2)' name='Custom SQL Query' type='text'><![CDATA[with 

p_gmv AS (
select
      global_entity_id,
      analytical_customer_id,created_date,
      predicted_gmv_eur AS p_gmv_6M
from `fulfillment-dwh-production.curated_data_shared_coda_datamart.predicted_gmv_recent_acquisitions`
where forecast_horizon = 26 and predicted_gmv_eur >> 0
QUALIFY ROW_NUMBER() OVER (PARTITION BY global_entity_id, analytical_customer_id ORDER BY created_date DESC) = 1
),

channel_orders_stg AS (
SELECT
 created_date_local AS cost_date,
 shared_countries.global_entity_id,
 `dhh---analytics-eu.bi_marketing.pandora_get_objective_pm`(campaign) objective_dh,
 `dhh---analytics-eu.bi_marketing.pandora_get_channel_grouping_pm`(campaign, coalesce (mapped_column,source)) channel_grouping_dh,
 `dhh---analytics-eu.bi_marketing.pandora_get_sub_channel_pm`(campaign, coalesce (mapped_column,source)) sub_channel_dh,
campaign,
coalesce (mapped_column,source) network,
  orders.analytical_customer_id,
  orders.is_acquisition,
  orders.is_reacquisition
FROM `fulfillment-dwh-production.pandata_report.marketing__performance_channel_orders` AS orders
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON orders.campaign_country = shared_countries.country_code_iso
       AND shared_countries.platform = "Pandora"
       AND shared_countries.is_reporting_enabled
LEFT JOIN (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on source = source_column
WHERE orders.created_date_utc >>= '2024-01-01'
),

channel_orders AS (
SELECT
*,
case
when objective_dh in ('Brand','Reach','RMA','RMO') then 'PM' else 'nonPM'
end as pm_nonPM
FROM channel_orders_stg
where 1=1
and global_entity_id not in ('FP_SK','HN_DK')
and network not in ('dv360-with-youtube','dv360-non-youtube')
and NOT REGEXP_CONTAINS(LOWER(campaign), r"corporate|mweb|_rid_|_rider_|xrea_")
),

pgmv_cohort_total AS (
SELECT 
   date_trunc(channel_orders.cost_date, month) month,
   channel_orders.global_entity_id,
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
   COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end) AS acquisitions,
   SAFE_DIVIDE(SUM(case when is_acquisition then p_gmv.p_gmv_6M end), COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end)) AS p_gmv_6M_user_acquisitions,
FROM channel_orders
LEFT JOIN p_gmv using (global_entity_id,analytical_customer_id)
GROUP BY ALL
 HAVING p_gmv_6M_user_acquisitions >> 0
),

pgmv_cohort_pm AS (
SELECT 
   date_trunc(channel_orders.cost_date, month) month,
   channel_orders.global_entity_id,
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
   COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end) AS acquisitions,
   SAFE_DIVIDE(SUM(case when is_acquisition then p_gmv.p_gmv_6M end), COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end)) AS p_gmv_6M_user_acquisitions,
FROM channel_orders
LEFT JOIN p_gmv using (global_entity_id,analytical_customer_id)
where pm_nonpm = 'PM'
GROUP BY ALL
 HAVING p_gmv_6M_user_acquisitions >> 0
),

re_acq_orders as (SELECT
  global_entity_id,
  created_date_local,
  order_code,
  TRUE AS is_reacquisition
  -- analytical_customer_id,
  -- DATE_DIFF(created_date_local, previous_order_date, DAY) AS days_since_previous_order,  

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`
WHERE created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 24 MONTH), MONTH)
  AND DATE_DIFF(created_date_local, previous_order_date, DAY) >>= 365  ----- matches Looker logic to use  >>=
  AND is_successful IS TRUE 
  AND country_name NOT IN ("Germany", "Denmark")
  -- and global_entity_id = 'DJ_CZ'
  AND global_entity_id NOT LIKE "ODR_%"
  ---- added following to resolve issue with customer have NULL previous orders
  AND analytical_customer_id IS NOT NULL
  AND business_type not in ("laas",'dmart')),

vouchers as (
    select *, 

case when account_name = 'Voucher Generic Retention' THEN 'CRC'
when account_name = 'Subscriptions' THEN 'CRC'
when account_name = 'CRM Activities' THEN 'CAC'
when account_name = 'CRM Rebates And Discounts' THEN 'CRC'
when account_name = 'Vouchers Generic Acquisition'  THEN 'CAC'
when account_name = 'Refer A Friend' THEN 'CAC' END AS account_group
 from (select 
o.country_name,
DATE_TRUNC(o.created_date_local,month) as report_month,
 CASE WHEN re_acq.is_reacquisition THEN TRUE ELSE FALSE END AS is_reacquisition,
case 
WHEN  (year = '2024' and region = 'Europe' and loyalty.coupon_usage_status = 'consumed') OR (year = '2024' and region = 'Europe'
  and voucher_purpose = 'loyalty') or (year = '2024' and region = 'Europe'
  and voucher_channel = 'channel_loyalty') THEN 'Voucher Generic Retention'
WHEN year = '2024' and region = 'Europe' and COALESCE(is_subscription_voucher,FALSE) THEN 'Subscriptions'

  WHEN  (year = '2024' and region = 'Europe' AND voucher_channel = 'channel_online' AND voucher_purpose = 'acquisition') OR
  (year = '2024' and region = 'Europe' AND voucher_channel in ("channel_crm_prospect","channel_crm_ad_hoc") AND voucher_purpose IN ("platform_ec",'local_shops_only','platform_nc','qc_general','dmart_only','platform_nc')) THEN 'CRM Activities'


  WHEN (year = '2024' and region = 'Europe' AND voucher_channel = "channel_online" AND voucher_purpose IN ("activation", "engagement", "reactivation")) OR 
  (year = '2024' and region = 'Europe' AND voucher_channel IN ("channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation",'channel_crm_ad_hoc') AND voucher_purpose IN ("platform_ec",'local_shops_only','qc_general','dmart_only')) THEN 'CRM Rebates And Discounts'

  WHEN year = '2024' and region = 'Europe' AND  voucher_channel IN ('channel_referral_welcome','channel_referral_reward','channel_refer_a_friend') THEN 'Refer A Friend'


  WHEN year = '2024' and region = 'Europe' AND is_acquisition AND voucher_channel NOT IN ('channel_referral_welcome','channel_referral_reward','channel_online','channel_refer_a_friend','channel_crm_prospect','channel_crm_ad_hoc') and voucher_purpose NOT IN ('sorry_panda','loyalty','refund','benefits','revenue','corporate','customer_support')
  THEN 'Vouchers Generic Acquisition'

  WHEN (year = '2024' and region = 'Europe' AND NOT is_acquisition AND voucher_channel NOT IN ('channel_referral_welcome','channel_referral_reward','channel_online','channel_refer_a_friend',"channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation",'channel_crm_prospect','channel_loyalty') and voucher_purpose NOT IN ('sorry_panda','loyalty','refund','benefits','revenue','corporate','customer_support'))
    THEN 'Voucher Generic Retention'

when year = '2025' and   Reporting_Lines_MCR_2025 = 'Affiliate & Coop - EC' THEN 'Voucher Generic Retention'
when year = '2025' and   Reporting_Lines_MCR_2025 = 'Autocompensation Realtime' THEN 'Autocompensation Realtime'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CF Vouchers' THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CRM RMA' THEN 'CRM Activities'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CRM RMO' THEN 'CRM Rebates And Discounts'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CX Vouchers' THEN 'CX Vouchers'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Compensation' THEN 'Compensation'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Corporate Vouchers' THEN 'Corporate Vouchers'
when year = '2025' and Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new not in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new  in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Subscriptions'
when year = '2025' and Reporting_Lines_MCR_2025 ='Affiliate & Coop - NC' THEN 'Vouchers Generic Acquisition' 
when year = '2025' and Reporting_Lines_MCR_2025 = 'Employee Benefits' THEN 'Employee Benefits'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'

when year = '2025' and Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'Refer A Friend'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'Vouchers Generic Acquisition'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Rider Rewards'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Refund') THEN 'Refund'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Test Vouchers'
WHEN year = '2025' and Reporting_Lines_MCR_2025 = 'HVA - NC' THEN 'Vouchers Generic Acquisition'
WHEN year = '2025' and Reporting_Lines_MCR_2025 = 'DHF Vouchers - HVAs' THEN 'CRM Rebates And Discounts'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Affiliate & Coop - EC' THEN 'Voucher Generic Retention'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Autocompensation Realtime' THEN 'Autocompensation Realtime'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CF Vouchers' THEN 'Voucher Generic Retention'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CRM RMA' THEN 'CRM Activities'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CRM RMO' THEN 'CRM Rebates And Discounts'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CX Vouchers' THEN 'CX Vouchers'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Compensation' THEN 'Compensation'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Corporate Vouchers' THEN 'Corporate Vouchers'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new not in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Voucher Generic Retention'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new  in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Subscriptions'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 ='Affiliate & Coop - NC' THEN 'Vouchers Generic Acquisition' 
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Employee Benefits' THEN 'Employee Benefits'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'
WHEN year = '2024' and region = 'APAC' and Reporting_Lines_MCR_2025 = 'HVA - NC' THEN 'Vouchers Generic Acquisition'


when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'Refer A Friend'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'Vouchers Generic Acquisition'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'Voucher Generic Retention'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Rider Rewards'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refund') THEN 'Refund'
when year = '2024' and region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Test Vouchers'
ELSE 'Other Vouchers'


 end as account_name,
SUM(voucher_cost_dh_eur) as voucher_cost_dh_marketing_eur,
-- SUM(voucher_cost_dh_local) as voucher_cost_dh_marketing_local


 from `dhh---analytics-eu.bi_marketing.pandora_agg_mcr_orders` o
   LEFT JOIN
  `dhh---analytics-eu.bi_marketing.regional_eu_loyalty_vouchers` AS loyalty
ON
  loyalty.global_entity_id = o.global_entity_id
  AND loyalty.order_id = o.order_code
 left join re_acq_orders as re_acq on re_acq.global_entity_id = o.global_entity_id and o.order_code = re_acq.order_code
 where o.created_date_local>>= '2024-01-01'

and o.business_type <<>> 'dmart'
group by all)
  ),

deals_raw as (
SELECT 
  o.global_entity_id,
  o.order_code,
  o.created_date_local,
  o.is_acquisition as is_acquisition_order,
  o.business_type,
  o.discount_type,
  o.is_discount_used,
  o.df_user_paid_incl_vat_eur,
  o.df_original_incl_vat_eur,
  o.df_original_incl_vat_local,
  o.df_original_excl_vat_eur,
  o.df_original_excl_vat_local,
  o.is_meal_for_one,
  o.discount_budget_channel,
  COALESCE(marketing_discounts.is_pickup_evergreen_discount,FALSE) as is_pickup_evergreen_discount,
  CASE WHEN o.dps_details.dps_type = 'dps_bvdf' THEN TRUE ELSE FALSE end as is_bvdf,

COALESCE(o.is_subscription_incentive_order,FALSE) as is_subscription_incentive_order,
  case when o.delivery_type = 'Own Delivery' then TRUE else FALSE end as is_own_delivery,
  COALESCE(discounts.is_evergreen,FALSE) as is_evergreen,
  COALESCE(o.is_subscription_incentive_order,FALSE) as still_is_subscription_incentive_order,
  COALESCE(subscription.is_subscription_voucher_order,FALSE) as is_subscription_voucher_order,
  
---
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = 'pickup' THEN  o.discount_cost_dh_eur END,0) AS dh_deal_pickup_pro_eur,
COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = 'pickup' THEN  o.discount_cost_dh_net_eur END,0) AS dh_deal_pickup_pro_exc_vat_eur,
---
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = 'pickup' THEN o.discount_cost_dh_local END,0) AS dh_deal_pickup_pro_local,
 COALESCE(CASE WHEN is_evergreen AND ARRAY_TO_STRING(expedition_types,",") = 'pickup' THEN o.voucher_cost_dh_net_local END,0) AS dh_deal_pickup_pro_exc_vat_local,
---
  ARRAY_TO_STRING(discounts.expedition_types,",") as expedition_types,
  COALESCE(subscription.is_subscription_discount_order,FALSE) as is_subscription_discount_order,
---
  CASE WHEN  subscription.is_free_delivery_dh_fully_funded_subscription_order or is_free_delivery_vendor_fully_funded_subscription_order or o.dps_details.dps_type = 'dps_subscription' THEN TRUE
  WHEN  is_discounted_delivery_subscription_order THEN TRUE
   ELSE FALSE END AS is_free_delivery_subscription_order,
--
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_eur END,0) AS dh_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_vendor_eur END,0) AS vendor_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_value_eur END,0) AS all_deal_free_delivery_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_net_eur END,0) AS dh_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_net_eur END,0) AS all_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_net_eur END,0)-COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_net_eur END,0) as vendor_deal_free_delivery_exc_vat_eur,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_local END,0) AS dh_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_vendor_local END,0) AS vendor_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_value_local END,0) AS all_deal_free_delivery_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_net_local END,0) AS dh_deal_free_delivery_exc_vat_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_net_local END,0) AS all_deal_free_delivery_exc_vat_local,
COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_net_local END,0)-COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_net_local END,0) AS vendor_deal_free_delivery_exc_vat_local,

COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_dh_eur END,0) AS fd_voucher_dh_eur,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_vendor_eur END,0) AS fd_voucher_vendor_eur,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_value_eur END,0) AS fd_voucher_eur,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_dh_net_eur END,0) AS fd_voucher_dh_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_net_eur END,0) AS fd_voucher_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_net_eur END,0)-COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_dh_net_eur END,0) as fd_voucher_vendor_exc_vat_eur,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_dh_local END,0) AS fd_voucher_dh_local,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_vendor_local END,0) AS fd_voucher_vendor_local,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_value_local END,0) AS fd_voucher_local, 
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_dh_net_local END,0) AS fd_voucher_dh_exc_vat_local,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_net_local END,0)-COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_dh_net_local END,0) as fd_voucher_vendor_exc_vat_local,
COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_cost_net_local END,0) AS fd_voucher_exc_vat_local,



COALESCE(o.dps_total_dh_cost_eur,0) AS dps_fd_dh_eur,
COALESCE(o.dps_total_vendor_cost_eur,0) as dps_fd_vendor_eur,
COALESCE(o.dps_total_vendor_cost_local,0) as dps_total_vendor_cost_local,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_dh_cost_eur,0),COALESCE(o.dps_total_cost_eur,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_eur,0),0) AS dps_fd_dh_exc_vat_eur,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_vendor_cost_eur,0),COALESCE(o.dps_total_cost_eur,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_eur,0),0) AS dps_fd_vendor_exc_vat_eur,
COALESCE(SAFE_DIVIDE(COALESCE(o.dps_total_vendor_cost_local,0),COALESCE(o.dps_total_cost_local,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_local,0),0) AS dps_fd_vendor_exc_vat_local,


COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_value_eur END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_value_eur END),0) = 0 THEN o.dps_total_cost_eur END,0) AS dps_fd_eur, 
  
COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_value_eur END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_value_eur END),0) = 0 THEN dps_costs.dps_total_cost_excl_vat_eur END,0) AS dps_fd_exc_vat_eur, 

 COALESCE(o.dps_total_dh_cost_local,0) AS dps_fd_dh_local,
 SAFE_DIVIDE(COALESCE(o.dps_total_dh_cost_local,0),COALESCE(o.dps_total_cost_local,0))*COALESCE(dps_costs.dps_total_cost_excl_vat_local,0) AS dps_fd_dh_exc_vat_local,

COALESCE(CASE WHEN  IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_value_local END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_value_local END),0) = 0 THEN o.dps_total_cost_local END,0) AS dps_fd_local, 

COALESCE(CASE WHEN IFNULL((CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_value_local END),0) = 0
     AND
     IFNULL((CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_value_local END),0)  = 0 THEN dps_costs.dps_total_cost_excl_vat_local END,0) AS dps_fd_exc_vat_local,

 COALESCE(o.discount_cost_dh_local,0) + COALESCE(o.mp_fd_cost_dh_local,0) + COALESCE(o.dps_total_dh_cost_local,0) as dh_deal_total_local,
 COALESCE(o.discount_cost_dh_eur,0) + COALESCE(o.mp_fd_cost_dh_eur,0) + COALESCE(o.dps_total_dh_cost_eur,0) as dh_deal_total_eur,
  COALESCE(o.discount_cost_dh_net_eur,0)- COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_net_eur END,0) as dh_deal_total_net_eur,
  COALESCE(o.discount_cost_dh_net_local,0)- COALESCE(CASE WHEN COALESCE(o.discount_type,marketing_discounts.discount_type) = 'free_delivery' THEN o.discount_cost_dh_net_local END,0) as dh_deal_total_net_local,
 0 as disco_vouchers,
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_value_local-o.discount_cost_dh_local END,0) as pro_discount_vf_local, 
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_value_eur-o.discount_cost_dh_eur END,0) as pro_discount_vf_eur, 
COALESCE(case when o.is_subscription_voucher_order  THEN  o.voucher_value_local-o.voucher_cost_dh_local END,0) as pro_voucher_vf_local, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_value_eur-o.voucher_cost_dh_eur END,0)  as pro_voucher_vf_eur,

COALESCE(case when o.is_subscription_discount_order  THEN o.discount_cost_net_local-o.discount_cost_dh_net_local END,0) as pro_discount_vf_net_local, 
COALESCE(case when o.is_subscription_discount_order  THEN o.discount_cost_net_eur-o.discount_cost_dh_net_eur END,0) as pro_discount_vf_net_eur, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_cost_net_local-o.voucher_cost_dh_net_local END,0) as pro_voucher_vf_net_local, 
COALESCE(case when o.is_subscription_voucher_order  THEN o.voucher_cost_net_eur-o.voucher_cost_dh_net_eur END,0)  as pro_voucher_vf_net_eur

FROM
 `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
 LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_discount_costs` as marketing_discounts
ON
  marketing_discounts.order_code = o.order_code
  AND marketing_discounts.global_entity_id = o.global_entity_id 
  AND marketing_discounts.created_date_local>>='2024-01-01'
LEFT JOIN
  `fulfillment-dwh-production.pandata_datamart.pandora__order_subscriptions` AS subscription
ON
  subscription.global_entity_id = o.global_entity_id
  AND subscription.order_code = o.order_code

LEFT JOIN    `fulfillment-dwh-production.pandata_curated.offers_discounts` as discounts on discounts.uuid = o.pd_discount_uuid and discounts.global_entity_id = o.global_entity_id

LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_dps_costs` as dps_costs
ON
  dps_costs.order_code = o.order_code
  AND dps_costs.global_entity_id = o.global_entity_id and dps_costs.created_date_local>>= '2024-01-01'

      WHERE 1=1
        AND o.created_date_local >>= '2024-01-01'
        AND o.is_billable
        and o.business_type <<>> 'dmart'
        and o.global_entity_id not like '%ODR_%'
        
      GROUP BY all
),


deals_agg as (  # OK
SELECT 

  countries.name as country_name,
  
  DATE_TRUNC(deals.created_date_local, month) AS month,
  COALESCE(is_reacquisition,FALSE) as is_reacquisition,
  CASE 
  -- Subscription Discounts
  WHEN   COALESCE(deals.is_subscription_discount_order,FALSE) AND NOT COALESCE(is_pickup_evergreen_discount,FALSE) THEN 'Subscriptions'
  --  Deals NC
  WHEN  COALESCE(deals.is_acquisition_order,FALSE) and NOT COALESCE(deals.is_subscription_discount_order,FALSE) AND NOT COALESCE(is_pickup_evergreen_discount,FALSE) THEN 'DH Funded Discounts Acquisition'
  -- Deals EC
  WHEN  NOT COALESCE(deals.is_acquisition_order,FALSE)  and  NOT COALESCE(deals.is_subscription_discount_order,FALSE) AND NOT COALESCE(is_pickup_evergreen_discount,FALSE)  THEN 'DH Funded Discounts Retention'

  ELSE 'Other Deals'

  END AS account_name,
  SUM(COALESCE((ROUND(COALESCE(dh_deal_total_eur,0),2) - ROUND(COALESCE(dh_deal_free_delivery_eur,0),2) - ROUND(COALESCE(dps_fd_dh_eur,0),2) - 
  ROUND(COALESCE(dh_deal_pickup_pro_eur,0),2)), 0))  AS incentive_cost_dh_eur,
FROM deals_raw as deals
LEFT JOIN re_acq_orders as re_acq_orders
on deals.global_entity_id = re_acq_orders.global_entity_id
and deals.order_code =  re_acq_orders.order_code
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` as countries
on countries.global_entity_id = deals.global_entity_id
WHERE 1=1
     -- AND deals.discount_type != "free_delivery"
     
      GROUP BY all
),

discounts as (
select *, CASE WHEN account_name = 'DH Funded Discounts Acquisition' THEN 'CAC'
ELSE 'CRC' end as account_group  from deals_agg
where incentive_cost_dh_eur>>0
),

free_df as (
  SELECT country_name, month, is_reacquisition, account_name, sum(incentive_cost_dh_eur) incentive_cost_dh_eur, account_group 
   FROM `dhh---analytics-eu.bi_marketing.mcr_free_df_components` 
group by all
),

mcr_stg as (
select * from vouchers
union all
select * from discounts
union all
select * from free_df
),

mcr as (
select country_name country,report_month month, account_group, is_reacquisition, CASE
    WHEN is_reacquisition = TRUE THEN
      CASE
        WHEN LOWER(account_name) LIKE '%acquisition%' THEN
          REGEXP_REPLACE(account_name, '(?i)acquisition', 'Reacquisition')
        ELSE
          CONCAT(account_name, ' Reacquisition')
      END
    ELSE account_name
  END AS account_name
, sum(voucher_cost_dh_marketing_eur) marketing_costs from mcr_stg
group by all
),

acqs_reacqs as (
  SELECT 
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
date_trunc(order_date,month) month,
case 
  when (goal_dh = 'ACQUISITION' or goal_dh = 'BRAND PROTECTION' or channel_subchannel = 'AFFILIATE' ) 
  or channel_Subchannel IN ('DISPLAY_REACH','SEM_GENERIC','BRAND_SEM','APP_REACH','PAIDSOCIAL_REACH','DISPLAY_RMA','PAIDSOCIAL_RMA','AFFILIATE','APP_RMA','SEM_VENDOR','SEM_COMPETITOR','SEM_CATEGORY') then 'PM'
else 'nonPM'
end as PM_nonPM,
sum(acquisitions_calibration_ios14fix) acqs,
sum(reacquisitions_calibration_ios14fix) reacqs
 FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders`
 where order_date >>= '2024-01-01'
group by all
),

acqs_reacqs_total as (
  SELECT 
country,
month,
sum(acqs) acqs,
sum(reacqs) reacqs
 FROM acqs_reacqs
group by all
),

total_marketing_costs as (
  SELECT 
country,
month,
account_name,
account_group,
sum(marketing_costs) as actual_eur
FROM mcr
where 1=1
and account_group not in ('Acquisitions','CPA','Orders')
group by all
),

acqs_avgGMV as (select
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
cohort_month month,
case
when channel_subchannel in (
  'ÁFFILIATE',
  'APP_REACH',
  'APP_RMA',
'DISPLAY_REACH','DISPLAY_RMA',
'PAIDSOCIAL_REACH','PAIDSOCIAL_RMA',
'SEM_BRA','SEM_CATEGORY','SEM_COMPETITOR','SEM_GENERIC'
) then 'PM'
else 'nonPM'
end as PM_nonPM,
sum(gmv)/sum(New_customers) acqs_avgGMV_per_NC
from  `dhh---analytics-eu.bi_marketing.regional_eu_orders_cohort_M0_M11_new`
where aggregation_level = 'monthly'
and month_diff_daily between 0 and 2
and cohort_month in (SELECT cohort_month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 3 MONTH), MONTH), INTERVAL 1 MONTH)) AS cohort_month)
group by all
),

acqs_avgGMV_total as (select
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
cohort_month month,
sum(gmv)/sum(New_customers) acqs_avgGMV_per_NC
from  `dhh---analytics-eu.bi_marketing.regional_eu_orders_cohort_M0_M11_new`
where aggregation_level = 'monthly'
and month_diff_daily between 0 and 2
and cohort_month in (SELECT cohort_month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 3 MONTH), MONTH), INTERVAL 1 MONTH)) AS cohort_month)
group by all
),

reacqs_avgGMV as (select
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
