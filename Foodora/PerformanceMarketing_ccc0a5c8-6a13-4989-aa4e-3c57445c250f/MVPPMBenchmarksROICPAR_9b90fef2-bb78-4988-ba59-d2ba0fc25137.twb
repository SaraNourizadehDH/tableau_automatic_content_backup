  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
