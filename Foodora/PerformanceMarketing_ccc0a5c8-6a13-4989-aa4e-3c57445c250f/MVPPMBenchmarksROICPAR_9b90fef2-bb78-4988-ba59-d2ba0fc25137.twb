          <datasource-dependencies datasource='federated.122wwyu1q9gpom145dyhi1wq7r35'>
            <column caption='60D GMV (Acqs+Recqs) / CPAR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[60D GMV (Acqs) / CPA (copy)_1039487091800928260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum([GMV_60d_acqs]+[GMV_60d_reacqs])/(sum([acqs])+sum([reacqs]))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([marketing_costs]) / (sum([acqs]) + sum([reacqs]) )&#13;&#10;)' />
            </column>
            <column caption='pGMV_6M (Acqs) / CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[60D GMV (Acqs) / CPA (copy)_761389824369856512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum([p_gmv_6M_acquisitions])/sum([acqs])&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([marketing_costs]) / sum([acqs])&#13;&#10;)' />
            </column>
            <column caption='CPAR' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[CPA (copy)_1039487091798605825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marketing_costs]) / (sum([acqs])+sum([reacqs]))' />
            </column>
            <column caption='CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_1039487091798175744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marketing_costs]) / sum([acqs])' />
            </column>
            <column caption='60D GMV (Acqs) / CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1039487091800223747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum([GMV_60d_acqs])/sum([acqs])&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([marketing_costs]) / sum([acqs])&#13;&#10;)' />
            </column>
            <column caption='acqs share' datatype='real' default-format='p0%' name='[Calculation_1039487091802427397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acqs]) / sum([acqs]+[reacqs])' />
