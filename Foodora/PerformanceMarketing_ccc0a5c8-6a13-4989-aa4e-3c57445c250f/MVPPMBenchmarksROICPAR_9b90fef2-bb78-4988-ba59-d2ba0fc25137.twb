              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)].[usr:60D GMV (Acqs) / CPA (copy)_1039487091800928260:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)].[usr:60D GMV (Acqs) / CPA (copy)_761389824369856512:qk]&quot;' />
