              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)].[usr:CPA (copy)_1039487091798605825:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)].[sum:GMV_60d_acqs:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.122wwyu1q9gpom145dyhi1wq7r35 (copy 2)].[sum:GMV_60d_reacqs:qk]&quot;' />
