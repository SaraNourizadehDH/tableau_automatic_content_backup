              <approx-count>1051</approx-count>
              <contains-null>true</contains-null>
              <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_1BDE02F5A624432D9225554B8567CBD3]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
            </metadata-record>
          </metadata-records>
        </connection>
      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Germany&quot;' />
      </semantic-values>
      <filter class='categorical' column='[country]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[country]' />
          <groupfilter function='union'>
            <groupfilter function='member' level='[country]' member='&quot;FP_DE&quot;' />
            <groupfilter function='member' level='[country]' member='&quot;FP_SK&quot;' />
            <groupfilter function='member' level='[country]' member='&quot;HN_DK&quot;' />
          </groupfilter>
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_1BDE02F5A624432D9225554B8567CBD3'>
            <properties context=''>
              <relation connection='bigquery.0rak0kb1saclah1es9ajd0km0wz1' name='Custom SQL Query' type='text'><![CDATA[with 

p_gmv AS (
select
      global_entity_id,
      analytical_customer_id,created_date,
      predicted_gmv_eur AS p_gmv_6M
from `fulfillment-dwh-production.curated_data_shared_coda_datamart.predicted_gmv_recent_acquisitions`
where forecast_horizon = 26 and predicted_gmv_eur >> 0
QUALIFY ROW_NUMBER() OVER (PARTITION BY global_entity_id, analytical_customer_id ORDER BY created_date DESC) = 1
),

channel_orders_stg AS (
SELECT
 created_date_local AS cost_date,
 shared_countries.global_entity_id,
 `dhh---analytics-eu.bi_marketing.pandora_get_objective_pm`(campaign) objective_dh,
 `dhh---analytics-eu.bi_marketing.pandora_get_channel_grouping_pm`(campaign, coalesce (mapped_column,source)) channel_grouping_dh,
 `dhh---analytics-eu.bi_marketing.pandora_get_sub_channel_pm`(campaign, coalesce (mapped_column,source)) sub_channel_dh,
campaign,
coalesce (mapped_column,source) network,
  orders.analytical_customer_id,
  orders.is_acquisition,
  orders.is_reacquisition
FROM `fulfillment-dwh-production.pandata_report.marketing__performance_channel_orders` AS orders
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON orders.campaign_country = shared_countries.country_code_iso
       AND shared_countries.platform = "Pandora"
       AND shared_countries.is_reporting_enabled
LEFT JOIN (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on source = source_column
WHERE orders.created_date_utc >>= '2024-01-01'
),

channel_orders AS (
SELECT
*,
case
when objective_dh in ('Brand','Reach','RMA','RMO') then 'PM' else 'nonPM'
end as pm_nonPM
FROM channel_orders_stg
where 1=1
and global_entity_id not in ('FP_SK','HN_DK')
and network not in ('dv360-with-youtube','dv360-non-youtube')
and NOT REGEXP_CONTAINS(LOWER(campaign), r"corporate|mweb|_rid_|_rider_|xrea_")
),

pgmv_cohort_total AS (
SELECT 
   date_trunc(channel_orders.cost_date, month) month,
   channel_orders.global_entity_id,
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
   COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end) AS acquisitions,
   SAFE_DIVIDE(SUM(case when is_acquisition then p_gmv.p_gmv_6M end), COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end)) AS p_gmv_6M_user_acquisitions,
FROM channel_orders
LEFT JOIN p_gmv using (global_entity_id,analytical_customer_id)
GROUP BY ALL
 HAVING p_gmv_6M_user_acquisitions >> 0
),

pgmv_cohort_pm AS (
SELECT 
   date_trunc(channel_orders.cost_date, month) month,
   channel_orders.global_entity_id,
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
   COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end) AS acquisitions,
   SAFE_DIVIDE(SUM(case when is_acquisition then p_gmv.p_gmv_6M end), COUNT(DISTINCT case when is_acquisition then channel_orders.analytical_customer_id end)) AS p_gmv_6M_user_acquisitions,
FROM channel_orders
LEFT JOIN p_gmv using (global_entity_id,analytical_customer_id)
where pm_nonpm = 'PM'
GROUP BY ALL
 HAVING p_gmv_6M_user_acquisitions >> 0
),

base as ( 
SELECT 
country,
account_group,
account_name,
report_month,
sum(case when actual_eur <<0 then actual_eur*(-1) else actual_eur end) actual_eur
FROM `dhh---analytics-eu.bi_marketing.pandora__marketing_mcr_report`
where 1=1
and account_group not in ('Acquisitions','CPA','Orders')
and report_month in (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 1 MONTH), MONTH), INTERVAL 1 MONTH)) AS month)
and concat(account_group," ",account_name) not in ( 'CRC Voucher Generic Retention','CAC Vouchers Generic Acquisition','CRC CRM Rebates And Discounts')
AND country IN ('Philippines', 'Hungary', 'Myanmar', 'Sweden', 'Bangladesh', 'Laos', 'Hong Kong', 'Turkey', 'Finland', 'Cambodia', 'Taiwan', 'Norway', 'Malaysia', 'Austria', 'Pakistan', 'Singapore', 'Czech Republic', 'Thailand')
group by all
),

re_acq_orders as (SELECT
  global_entity_id,
  created_date_local,
  order_code,
  TRUE AS is_reacquisition
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`
WHERE created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 25 MONTH), MONTH)
  AND DATE_DIFF(created_date_local, previous_order_date, DAY) >>= 365  ----- matches Looker logic to use  >>=
  AND is_successful IS TRUE 
  AND country_name NOT IN ("Germany", "Denmark")
  AND global_entity_id NOT LIKE "ODR_%"
  ---- added following to resolve issue with customer have NULL previous orders
  AND analytical_customer_id IS NOT NULL
  AND business_type not in ("laas",'dmart')),

re_acq_orders_mapped as (
select *, 
case when account_name = 'Voucher Generic Retention' THEN 'CRC'
when account_name = 'Subscriptions' THEN 'CRC'
when account_name = 'CRM Activities' THEN 'CAC'
when account_name = 'CRM Rebates And Discounts' THEN 'CRC'
when account_name = 'Vouchers Generic Acquisition'  THEN 'CAC'
when account_name = 'Refer A Friend' THEN 'CAC' END AS account_group
 from (select 
o.region,
o.country_name country,
o.global_entity_id,
o.year,
o.business_type,
DATE_TRUNC(o.created_date_local,month) as report_month,
o.budget_channel_2025,
case 
when Reporting_Lines_MCR_2025 = 'Affiliate & Coop - EC' THEN 'Voucher Generic Retention'
when Reporting_Lines_MCR_2025 = 'Autocompensation Realtime' THEN 'Autocompensation Realtime'
when Reporting_Lines_MCR_2025 = 'CF Vouchers' THEN 'Voucher Generic Retention'
when Reporting_Lines_MCR_2025 = 'CRM RMA' THEN 'CRM Activities'
when Reporting_Lines_MCR_2025 = 'CRM RMO' THEN 'CRM Rebates And Discounts'
when Reporting_Lines_MCR_2025 = 'CX Vouchers' THEN 'CX Vouchers'
when Reporting_Lines_MCR_2025 = 'Compensation' THEN 'Compensation'
when Reporting_Lines_MCR_2025 = 'Corporate Vouchers' THEN 'Corporate Vouchers'
when Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new not in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Voucher Generic Retention'
when Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new  in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Subscriptions'
WHEN Reporting_Lines_MCR_2025 ='Affiliate & Coop - NC' THEN 'Vouchers Generic Acquisition' 
WHEN Reporting_Lines_MCR_2025 ='DHF Vouchers - HVAs' THEN 'Voucher Generic Retention'
WHEN Reporting_Lines_MCR_2025 = 'Employee Benefits' THEN 'Employee Benefits'
WHEN Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'
WHEN Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'

WHEN Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'Refer A Friend'
WHEN Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'Vouchers Generic Acquisition'
when Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'Voucher Generic Retention'
WHEN Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Rider Rewards'
WHEN Reporting_Lines_MCR_2025 in ('Refund') THEN 'Refund'
WHEN Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Test Vouchers'

 end as account_name,
 Reporting_Lines_MCR_2025,
 voucher_channel,
 voucher_purpose,
 CASE WHEN re_acq.is_reacquisition THEN TRUE ELSE FALSE END AS is_reacquisition,
 count(distinct o.order_code) as order_count,
SUM(voucher_cost_dh_eur) as voucher_cost_dh_marketing_eur,
 from `dhh---analytics-eu.bi_marketing.pandora_agg_mcr_orders` o
 left join re_acq_orders as re_acq on re_acq.global_entity_id = o.global_entity_id and o.order_code = re_acq.order_code
 where o.created_date_local>>= '2024-01-01'
and o.business_type <<>> 'dmart'
group by all)
  ),

breakdown_for_base as (
  select 
  country,
  account_group,
  case
  when is_reacquisition then 
    case 
    when account_name = 'Vouchers Generic Acquisition' then 'Vouchers Generic Reacquisition' 
    when account_name = 'Voucher Generic Retention' then 'Vouchers Generic Retention Reacquisition' 
    when account_name = 'CRM Rebates And Discounts' then 'CRM Rebates And Discounts Reacquisition' 
    end
  else account_name
  end as account_name,
  report_month month,
  sum(voucher_cost_dh_marketing_eur) voucher_cost_dh_marketing_eur
  from re_acq_orders_mapped
where 1=1
and concat(account_group," ",account_name) in 
('CRC Voucher Generic Retention','CAC Vouchers Generic Acquisition','CRC CRM Rebates And Discounts')
and global_entity_id in ('DJ_CZ','FO_NO','FP_BD','FP_HK','FP_KH','FP_LA','FP_MM','FP_MY','FP_PH','FP_PK','FP_SG','FP_TH','FP_TW','MJM_AT','NP_HU','OP_SE','PO_FI','YS_TR')
and report_month in (SELECT month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 1 MONTH), MONTH), INTERVAL 1 MONTH)) AS month)
group by all
),

base_with_breakdown as (
select * from base
union all
select * from breakdown_for_base
),

acqs_reacqs as (
  SELECT 
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
date_trunc(order_date,month) month,
case 
  when (goal_dh = 'ACQUISITION' or goal_dh = 'BRAND PROTECTION' or channel_subchannel = 'AFFILIATE' ) 
  or channel_Subchannel IN ('DISPLAY_REACH','SEM_GENERIC','BRAND_SEM','APP_REACH','PAIDSOCIAL_REACH','DISPLAY_RMA','PAIDSOCIAL_RMA','AFFILIATE','APP_RMA','SEM_VENDOR','SEM_COMPETITOR','SEM_CATEGORY') then 'PM'
else 'nonPM'
end as PM_nonPM,
sum(acquisitions_calibration_ios14fix) acqs,
sum(reacquisitions_calibration_ios14fix) reacqs
 FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders`
 where order_date >>= '2024-01-01'
group by all
),

acqs_reacqs_total as (
  SELECT 
country,
month,
sum(acqs) acqs,
sum(reacqs) reacqs
 FROM acqs_reacqs
group by all
),

total_marketing_costs as (
  SELECT 
country,
report_month month,
sum(case when actual_eur <<0 then actual_eur*(-1) else actual_eur end) actual_eur
FROM base_with_breakdown
where 1=1
and account_group not in ('Acquisitions','CPA','Orders')
group by all
),

PM_media_costs as (
  SELECT 
country,
report_month month,
sum(case when actual_eur <<0 then actual_eur*(-1) else actual_eur end) actual_eur
FROM base_with_breakdown
where 1=1
and account_group not in ('Acquisitions','CPA','Orders')
and account_name in ('Online PM for Acquisition','SEM Brand')
group by all
),

PM_total_costs as (
  SELECT 
country,
report_month month,
sum(case when actual_eur <<0 then actual_eur*(-1) else actual_eur end) actual_eur
FROM base_with_breakdown
where 1=1
and account_group not in ('Acquisitions','CPA','Orders')
and account_name in ('Online PM for Acquisition','Vouchers Generic Acquisition','Vouchers Generic Reacquisition','SEM Brand','Revenue Reduction From Delivery Fee Acquisition','DH Funded Discounts Acquisition','Vouchers Generic Retention Reacquisition')
group by all
),

acqs_avgGMV as (select
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
cohort_month month,
case
when channel_subchannel in (
  'ÁFFILIATE',
  'APP_REACH',
  'APP_RMA',
'DISPLAY_REACH','DISPLAY_RMA',
'PAIDSOCIAL_REACH','PAIDSOCIAL_RMA',
'SEM_BRA','SEM_CATEGORY','SEM_COMPETITOR','SEM_GENERIC'
) then 'PM'
else 'nonPM'
end as PM_nonPM,
sum(gmv)/sum(New_customers) acqs_avgGMV_per_NC
from  `dhh---analytics-eu.bi_marketing.regional_eu_orders_cohort_M0_M11_new`
where aggregation_level = 'monthly'
and month_diff_daily between 0 and 2
and cohort_month in (SELECT cohort_month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 3 MONTH), MONTH), INTERVAL 1 MONTH)) AS cohort_month)
group by all
),

acqs_avgGMV_total as (select
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
  WHEN global_entity_id = 'FP_LA' THEN 'Laos'
  WHEN global_entity_id = 'FP_MM' THEN 'Myanmar'
  WHEN global_entity_id = 'FP_MY' THEN 'Malaysia'
  WHEN global_entity_id = 'FP_PH' THEN 'Philippines'
  WHEN global_entity_id = 'FP_PK' THEN 'Pakistan'
  WHEN global_entity_id = 'FP_SG' THEN 'Singapore'
  WHEN global_entity_id = 'FP_TH' THEN 'Thailand'
  WHEN global_entity_id = 'FP_TW' THEN 'Taiwan'
  WHEN global_entity_id = 'MJM_AT' THEN 'Austria'
  WHEN global_entity_id = 'NP_HU' THEN 'Hungary'
  WHEN global_entity_id = 'OP_SE' THEN 'Sweden'
  WHEN global_entity_id = 'PO_FI' THEN 'Finland'
  WHEN global_entity_id = 'YS_TR' THEN 'Turkey'
  ELSE global_entity_id
END
as country,
cohort_month month,
sum(gmv)/sum(New_customers) acqs_avgGMV_per_NC
from  `dhh---analytics-eu.bi_marketing.regional_eu_orders_cohort_M0_M11_new`
where aggregation_level = 'monthly'
and month_diff_daily between 0 and 2
and cohort_month in (SELECT cohort_month FROM UNNEST(GENERATE_DATE_ARRAY(DATE '2024-01-01', DATE_TRUNC(DATE_SUB(CURRENT_DATE()-1, INTERVAL 3 MONTH), MONTH), INTERVAL 1 MONTH)) AS cohort_month)
group by all
),

reacqs_avgGMV as (select
CASE
  WHEN global_entity_id = 'DJ_CZ' THEN 'Czech Republic'
  WHEN global_entity_id = 'FO_NO' THEN 'Norway'
  WHEN global_entity_id = 'FP_BD' THEN 'Bangladesh'
  WHEN global_entity_id = 'FP_HK' THEN 'Hong Kong'
  WHEN global_entity_id = 'FP_KH' THEN 'Cambodia'
