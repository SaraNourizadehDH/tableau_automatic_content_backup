    <datasource caption='Custom SQL Query (bi_marketing)' inline='true' name='federated.05l4f1l11uoucb192oqs20u5pu4f' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0yachk20aaq48v18iklmd1cydd85'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='EU Data Production' schema='bi_marketing' server-oauth='' username='tamerlan.saidov@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0yachk20aaq48v18iklmd1cydd85' name='Custom SQL Query' type='text'>WITH &#13;
&#13;
  cs_cost AS (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    campaign,&#13;
    CASE &#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_and_&quot;) THEN &quot;android&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_ios_&quot;) THEN &quot;ios&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_web_&quot;) THEN &quot;web&quot;&#13;
      when REGEXP_CONTAINS(LOWER(campaign), r&quot;_mix_&quot;) THEN &quot;mix&quot;&#13;
      ELSE LOWER(platform)&#13;
  END AS os_name,&#13;
    date,&#13;
CASE&#13;
    	WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Online branding - App&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Online branding - Display&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach - Display&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Online branding - PS&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach - PS&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;Display - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;App marketing - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_%&apos; THEN &apos;App marketing - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;dis_r%&apos; THEN &apos;Display - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;SEM non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;SEM Brand&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;Paid Social - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos; OR campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;Paid Social - Reach/RMA&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
  END&#13;
    AS marketing_channel,&#13;
    CASE&#13;
    	WHEN STARTS_WITH(LOWER(campaign), r&quot;aff_aff&quot;) THEN &quot;Other/Organic&quot;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Brand&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;dis_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;Non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;Brand&apos;&#13;
      WHEN campaign LIKE &apos;mob_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;mob_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos;) THEN &apos;Reach&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;RMA&apos;&#13;
    ELSE&#13;
    &apos;Other/Organic&apos;&#13;
    end as sub_channel,&#13;
   `dhh---analytics-eu.bi_marketing.pandora_get_objective_pm`(campaign) as objective_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_channel_grouping_pm`(campaign, coalesce(mapped_column,lower(cost_source))) channel_grouping_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_sub_channel_pm`(campaign, coalesce(mapped_column,lower(cost_source))) sub_channel_dh,&#13;
    cost_source AS network,&#13;
    SUM(cost_eur) cost,&#13;
    0 acquisitions,&#13;
    0 reacquisitions&#13;
  FROM&#13;
    `fulfillment-dwh-production.curated_data_shared_coda_datamart.clarisights_camp_costs`&#13;
left join (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on cost_source = source_column  &#13;
  WHERE&#13;
    1=1&#13;
    AND date BETWEEN &apos;2024-01-01&apos; AND DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)&#13;
    AND (&#13;
      (marketing_channel NOT IN (&apos;Social Engagement&apos;,&apos;SEM - Restaurant Recruiting (SSU)&apos;, &apos;Paid Social - Restaurant Recruiting&apos;,&apos;Cooperations&apos;,&apos;Paid Social - Riders&apos;,&apos;Partner ads&apos;)&#13;
      or marketing_channel is null)&#13;
    AND lower(campaign) NOT LIKE &quot;%_rid_%&quot; AND lower(campaign) NOT LIKE &quot;%_rider_%&quot; and lower(campaign) not like &apos;%some_promo%&apos;)&#13;
  GROUP BY all&#13;
  having marketing_channel != &apos;Other&apos;),&#13;
&#13;
  cs_acq_stg AS (&#13;
  SELECT&#13;
    global_entity_id,   &#13;
 IF(channel_subchannel = &quot;AFFILIATE&quot;, &apos;Affiliate&apos;, campaign) AS campaign,&#13;
 CASE &#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_and_&quot;) THEN &quot;android&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_ios_&quot;) THEN &quot;ios&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_web_&quot;) THEN &quot;web&quot;&#13;
      ELSE LOWER(platform)&#13;
  END AS platform,&#13;
    order_date,&#13;
CASE&#13;
    	WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Online branding - App&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Online branding - Display&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach - Display&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Online branding - PS&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach - PS&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;Display - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;App marketing - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_%&apos; THEN &apos;App marketing - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;dis_r%&apos; THEN &apos;Display - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;SEM non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;SEM Brand&apos;&#13;
      WHEN campaign LIKE &apos;aff_aff%&apos; THEN &apos;Affiliate&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;Paid Social - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos; OR campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;Paid Social - Reach/RMA&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
  END&#13;
    AS marketing_channel,&#13;
    CASE&#13;
    	WHEN STARTS_WITH(LOWER(campaign), r&quot;aff_aff&quot;) THEN &quot;Other/Organic&quot;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Brand&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;dis_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;Non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;Brand&apos;&#13;
      WHEN campaign LIKE &apos;mob_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;mob_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos;) THEN &apos;Reach&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;RMA&apos;&#13;
    ELSE&#13;
    &apos;Other/Organic&apos;&#13;
    end as sub_channel,&#13;
   `dhh---analytics-eu.bi_marketing.pandora_get_objective_pm`(campaign) as objective_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_channel_grouping_pm`(campaign, coalesce(mapped_column,lower(source))) channel_grouping_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_sub_channel_pm`(campaign, coalesce(mapped_column,lower(source))) subchannel_dh,&#13;
    coalesce(mapped_column,lower(source),&apos;other&apos;) as cost_source,&#13;
    0 cost,&#13;
    SUM(acquisitions_calibration_ios14fix) Acquisitions,&#13;
    sum(reacquisitions_calibration_ios14fix) reacquisitions_calibration_ios14fix&#13;
  FROM&#13;
    `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders`&#13;
left join (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on source = source_column  &#13;
WHERE&#13;
    1=1&#13;
    AND order_date between &apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)&#13;
  GROUP BY all),&#13;
&#13;
cs_acq as (&#13;
select * except (Acquisitions, reacquisitions_calibration_ios14fix),&#13;
case when marketing_channel != &apos;Other&apos; then Acquisitions end as Acquisitions,&#13;
reacquisitions_calibration_ios14fix&#13;
from cs_acq_stg&#13;
),&#13;
&#13;
  cs AS (&#13;
  SELECT * FROM cs_cost&#13;
  UNION ALL&#13;
  SELECT * FROM cs_acq&#13;
),&#13;
&#13;
agg AS (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    DATE_TRUNC(date, WEEK(MONDAY))     AS week,&#13;
    DATE_TRUNC(date, MONTH)            AS month,&#13;
    objective_dh,&#13;
    channel_grouping_dh,&#13;
    sub_channel_dh,&#13;
    os_name,&#13;
    SUM(cost)  AS cost,&#13;
    SUM(Acquisitions)  AS acqs&#13;
  FROM cs&#13;
  where os_name in (&apos;web&apos;,&apos;mix&apos;,&apos;android&apos;,&apos;ios&apos;)&#13;
  GROUP BY all&#13;
)&#13;
&#13;
  select * from agg</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0yachk20aaq48v18iklmd1cydd85' name='Custom SQL Query' type='text'>WITH &#13;
&#13;
  cs_cost AS (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    campaign,&#13;
    CASE &#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_and_&quot;) THEN &quot;android&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_ios_&quot;) THEN &quot;ios&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_web_&quot;) THEN &quot;web&quot;&#13;
      when REGEXP_CONTAINS(LOWER(campaign), r&quot;_mix_&quot;) THEN &quot;mix&quot;&#13;
      ELSE LOWER(platform)&#13;
  END AS os_name,&#13;
    date,&#13;
CASE&#13;
    	WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Online branding - App&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Online branding - Display&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach - Display&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Online branding - PS&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach - PS&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;Display - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;App marketing - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_%&apos; THEN &apos;App marketing - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;dis_r%&apos; THEN &apos;Display - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;SEM non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;SEM Brand&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;Paid Social - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos; OR campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;Paid Social - Reach/RMA&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
  END&#13;
    AS marketing_channel,&#13;
    CASE&#13;
    	WHEN STARTS_WITH(LOWER(campaign), r&quot;aff_aff&quot;) THEN &quot;Other/Organic&quot;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Brand&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;dis_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;Non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;Brand&apos;&#13;
      WHEN campaign LIKE &apos;mob_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;mob_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos;) THEN &apos;Reach&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;RMA&apos;&#13;
    ELSE&#13;
    &apos;Other/Organic&apos;&#13;
    end as sub_channel,&#13;
   `dhh---analytics-eu.bi_marketing.pandora_get_objective_pm`(campaign) as objective_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_channel_grouping_pm`(campaign, coalesce(mapped_column,lower(cost_source))) channel_grouping_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_sub_channel_pm`(campaign, coalesce(mapped_column,lower(cost_source))) sub_channel_dh,&#13;
    cost_source AS network,&#13;
    SUM(cost_eur) cost,&#13;
    0 acquisitions,&#13;
    0 reacquisitions&#13;
  FROM&#13;
    `fulfillment-dwh-production.curated_data_shared_coda_datamart.clarisights_camp_costs`&#13;
left join (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on cost_source = source_column  &#13;
  WHERE&#13;
    1=1&#13;
    AND date BETWEEN &apos;2024-01-01&apos; AND DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)&#13;
    AND (&#13;
      (marketing_channel NOT IN (&apos;Social Engagement&apos;,&apos;SEM - Restaurant Recruiting (SSU)&apos;, &apos;Paid Social - Restaurant Recruiting&apos;,&apos;Cooperations&apos;,&apos;Paid Social - Riders&apos;,&apos;Partner ads&apos;)&#13;
      or marketing_channel is null)&#13;
    AND lower(campaign) NOT LIKE &quot;%_rid_%&quot; AND lower(campaign) NOT LIKE &quot;%_rider_%&quot; and lower(campaign) not like &apos;%some_promo%&apos;)&#13;
  GROUP BY all&#13;
  having marketing_channel != &apos;Other&apos;),&#13;
&#13;
  cs_acq_stg AS (&#13;
  SELECT&#13;
    global_entity_id,   &#13;
 IF(channel_subchannel = &quot;AFFILIATE&quot;, &apos;Affiliate&apos;, campaign) AS campaign,&#13;
 CASE &#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_and_&quot;) THEN &quot;android&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_ios_&quot;) THEN &quot;ios&quot;&#13;
      WHEN REGEXP_CONTAINS(LOWER(campaign), r&quot;_web_&quot;) THEN &quot;web&quot;&#13;
      ELSE LOWER(platform)&#13;
  END AS platform,&#13;
    order_date,&#13;
CASE&#13;
    	WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Online branding - App&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Online branding - Display&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach - Display&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Online branding - PS&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach - PS&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;Display - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;App marketing - RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_%&apos; THEN &apos;App marketing - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;dis_r%&apos; THEN &apos;Display - Reach/RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;SEM non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;SEM Brand&apos;&#13;
      WHEN campaign LIKE &apos;aff_aff%&apos; THEN &apos;Affiliate&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;Paid Social - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos; OR campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;Paid Social - Reach/RMA&apos;&#13;
    ELSE&#13;
    &apos;Other&apos;&#13;
  END&#13;
    AS marketing_channel,&#13;
    CASE&#13;
    	WHEN STARTS_WITH(LOWER(campaign), r&quot;aff_aff&quot;) THEN &quot;Other/Organic&quot;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%dv360%&apos; or LOWER(campaign) LIKE &apos;%mob_bra%&apos;) and not (LOWER(campaign) LIKE &apos;%_rma_%&apos; or LOWER(campaign) LIKE &apos;%_reach_%&apos;) THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_bra%&apos; THEN &apos;Brand&apos;&#13;
	    WHEN LOWER(campaign) LIKE &apos;%dis_xrea%&apos; THEN &apos;Extended reach&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%ps_bra%&apos; OR LOWER(campaign) LIKE &apos;%smartly_bra%&apos; OR LOWER(campaign) LIKE &apos;%tiktok_bra%&apos;) THEN &apos;Brand&apos;&#13;
      WHEN (LOWER(campaign) LIKE &apos;%smartly_xrea%&apos; OR LOWER(campaign) LIKE &apos;%ps_xrea%&apos;) THEN &apos;Extended reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;mob_rmo%&apos; THEN &apos;RMO&apos;&#13;
      WHEN campaign LIKE &apos;dis_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;dis_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN campaign LIKE &apos;sem_rmo%&apos; THEN &apos;SEM - RMO&apos;&#13;
      WHEN (campaign LIKE &apos;%sem%&apos; AND campaign NOT LIKE &apos;sem_bra%&apos;) THEN &apos;Non-brand&apos;&#13;
      WHEN campaign LIKE &apos;sem_bra%&apos; THEN &apos;Brand&apos;&#13;
      WHEN campaign LIKE &apos;mob_reach%&apos; THEN &apos;Reach&apos;&#13;
      WHEN campaign LIKE &apos;mob_rma%&apos; THEN &apos;RMA&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rmo%&apos; OR campaign LIKE &apos;smartly_rmo%&apos;) THEN &apos;RMO&apos;&#13;
      WHEN (campaign LIKE &apos;ps_reach%&apos; OR campaign LIKE &apos;smartly_reach%&apos;) THEN &apos;Reach&apos;&#13;
      WHEN (campaign LIKE &apos;ps_rma%&apos; OR campaign LIKE &apos;smartly_rma%&apos;) THEN &apos;RMA&apos;&#13;
    ELSE&#13;
    &apos;Other/Organic&apos;&#13;
    end as sub_channel,&#13;
   `dhh---analytics-eu.bi_marketing.pandora_get_objective_pm`(campaign) as objective_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_channel_grouping_pm`(campaign, coalesce(mapped_column,lower(source))) channel_grouping_dh,&#13;
  `dhh---analytics-eu.bi_marketing.pandora_get_sub_channel_pm`(campaign, coalesce(mapped_column,lower(source))) subchannel_dh,&#13;
    coalesce(mapped_column,lower(source),&apos;other&apos;) as cost_source,&#13;
    0 cost,&#13;
    SUM(acquisitions_calibration_ios14fix) Acquisitions,&#13;
    sum(reacquisitions_calibration_ios14fix) reacquisitions_calibration_ios14fix&#13;
  FROM&#13;
    `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders`&#13;
left join (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on source = source_column  &#13;
WHERE&#13;
    1=1&#13;
    AND order_date between &apos;2024-01-01&apos; and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)&#13;
  GROUP BY all),&#13;
&#13;
cs_acq as (&#13;
select * except (Acquisitions, reacquisitions_calibration_ios14fix),&#13;
case when marketing_channel != &apos;Other&apos; then Acquisitions end as Acquisitions,&#13;
reacquisitions_calibration_ios14fix&#13;
from cs_acq_stg&#13;
),&#13;
&#13;
  cs AS (&#13;
  SELECT * FROM cs_cost&#13;
  UNION ALL&#13;
  SELECT * FROM cs_acq&#13;
),&#13;
&#13;
agg AS (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    DATE_TRUNC(date, WEEK(MONDAY))     AS week,&#13;
    DATE_TRUNC(date, MONTH)            AS month,&#13;
    objective_dh,&#13;
    channel_grouping_dh,&#13;
    sub_channel_dh,&#13;
    os_name,&#13;
    SUM(cost)  AS cost,&#13;
    SUM(Acquisitions)  AS acqs&#13;
  FROM cs&#13;
  where os_name in (&apos;web&apos;,&apos;mix&apos;,&apos;android&apos;,&apos;ios&apos;)&#13;
  GROUP BY all&#13;
)&#13;
&#13;
  select * from agg</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
