        <calculation class='tableau' formula='IF [valid_mCPA (copy)_453174732918771714] &lt; 0 AND [cost_delta (copy)_453174732918943747] &lt; 0 THEN ABS([valid_mCPA (copy)_453174732918771714]) / ABS([cost_delta (copy)_453174732918943747]) ELSE NULL END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Period type' datatype='string' default-format='*&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[mCPA || dCPA (copy)_453174732972404756]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if ([cost_delta (copy)_453174732918943747] &lt;0 and [valid_mCPA (copy)_453174732918771714] &lt;0) &#13;&#10;then &apos;Decremental (dCPA)&apos; &#13;&#10;ELSEIF [cost_delta (copy)_453174732918943747] &gt;0 and [valid_mCPA (copy)_453174732918771714] &gt;0 then &apos;Incremental (mCPA)&apos;&#13;&#10;else &apos;Not applicable (N/A)&apos; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Objective' datatype='string' name='[objective_dh]' role='dimension' type='nominal' />
