      <column caption='CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_453174732917780480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost]) / SUM([acqs])' />
      </column>
      <column caption='mCPA' datatype='real' default-format='*&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_453174732917837825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;  ([valid_mCPA (copy)_453174732918771714] &gt; 0 AND [cost_delta (copy)_453174732918943747] &gt; 0)&#13;&#10;THEN [valid_mCPA (copy)_453174732918771714] / [cost_delta (copy)_453174732918943747]&#13;&#10;ELSE NULL&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='filter_cost' datatype='string' name='[Calculation_453174732944433156]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM([cost]))&lt;1 or (SUM([acqs]))&lt;1 THEN &quot;Hide&quot; ELSE &quot;Show&quot; END' />
      </column>
      <column caption='dates' datatype='date' name='[Calculation_453174732969603090]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &apos;Weekly&apos; then [week] else [month] end' />
      </column>
      <column caption='mCPA || dCPA' datatype='real' default-format='*&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_453174732971753491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [cost_delta (copy)_453174732918943747] &lt;0 then [mCPA (copy)_453174732946993158] else [Calculation_453174732917837825] end'>
          <table-calc ordering-type='Rows' />
