      <column caption='Sub channel' datatype='string' name='[sub_channel_dh]' role='dimension' type='nominal' />
      <column caption='cost_delta' datatype='real' default-format='*+&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[valid_mCPA (copy)_453174732918771714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum(cost) &gt; 0 then&#13;&#10;ZN(SUM([cost])) - LOOKUP(ZN(SUM([cost])), -1)&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
