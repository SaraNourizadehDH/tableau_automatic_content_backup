      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_FD258EEF8D9A424C89CA8AA7ABF7094B]' role='measure' type='quantitative' />
      <column datatype='real' default-format='n0;-0' name='[acqs]' role='measure' type='quantitative' />
      <column caption='Channel' datatype='string' name='[channel_grouping_dh]' role='dimension' type='nominal' />
      <column datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[cost]' role='measure' type='quantitative' />
      <column caption='acq_delta' datatype='real' default-format='*+#,##0;-#,##0' name='[cost_delta (copy)_453174732918943747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum([acqs]) &gt;0 then&#13;&#10;ZN(SUM([acqs])) - LOOKUP(ZN(SUM([acqs])), -1)&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
