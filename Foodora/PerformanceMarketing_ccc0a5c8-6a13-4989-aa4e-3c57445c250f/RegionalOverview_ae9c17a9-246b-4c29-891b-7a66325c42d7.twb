            <column caption='Acq_last_7d' datatype='real' name='[Calculation_1220757033221685250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_7d] when true then [acquisitions] else 0 end&#13;&#10;)' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_1401182501372633088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case&#13;&#10;[global_entity_id]&#13;&#10;when &apos;DJ_CZ&apos;  then &apos;EU&apos;&#13;&#10;when &apos;FO_NO&apos;  then &apos;EU&apos;&#13;&#10;when &apos;MJM_AT&apos; then &apos;EU&apos;&#13;&#10;when &apos;NP_HU&apos;  then &apos;EU&apos;&#13;&#10;when &apos;OP_SE&apos;  then &apos;EU&apos;&#13;&#10;when &apos;PO_FI&apos;  then &apos;EU&apos;&#13;&#10;&#13;&#10;when &apos;FP_BD&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_HK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_KH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_LA&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MM&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MY&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_SG&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TW&apos; then &apos;APAC&apos;&#13;&#10;&#13;&#10;when &apos;YS_TR&apos; then &apos;TR&apos;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Budget utilized TD' datatype='real' default-format='p0%' name='[Calculation_272186325506519040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost])/SUM([federated.1emzea40hkqeoi16v38a50e71obl].[budget])' />
            </column>
            <column caption='Budget delta (pacing - td)' datatype='real' default-format='p0%' name='[Calculation_272186325508313089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_801077841541046273]-[Calculation_272186325506519040]' />
            </column>
            <column caption='7d_rolling_week' datatype='date' name='[Calculation_667377187457916928]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(&#13;&#10;    DATEADD(&#13;&#10;        &apos;day&apos;,&#13;&#10;        DATEPART(&apos;weekday&apos;, [Calculation_667377187458117633]) - 2,&#13;&#10;        DATETRUNC(&apos;week&apos;, DATEADD(&apos;day&apos;, -DATEPART(&apos;weekday&apos;, [Calculation_667377187458117633]) + 1, [Calculation_675539951979085824]))&#13;&#10;    )&#13;&#10;) - 7' />
            </column>
            <column caption='max_date' datatype='date' name='[Calculation_667377187458117633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF [cost] &gt; 0 THEN [date] END&#13;&#10;)}' />
            </column>
            <column caption='date_with_spend' datatype='date' name='[Calculation_675539951979085824]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date] : &#13;&#10;    MAX(&#13;&#10;        IF [cost] &gt; 0 THEN [date] END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Budget Pacing' datatype='real' default-format='p0.0%' name='[Calculation_801077841541046273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([projected_cost])/SUM([federated.1emzea40hkqeoi16v38a50e71obl].[budget])' />
            </column>
            <column caption='Acq. Pacing' datatype='real' default-format='p0.0%' name='[Calculation_801077841546878980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([projected_acq])/SUM([federated.1emzea40hkqeoi16v38a50e71obl].[acquisition])' />
