              <calculation class='tableau' formula='[CPA_last_7d (copy)_1220757033243349017]/&#13;&#10;(sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [cost] end&#13;&#10;)&#13;&#10;/&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [acquisitions] end&#13;&#10;))&#13;&#10;-1' />
            </column>
