        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17trp3m0o7hkwt1f9sa8d122wnh2' name='regional budgets query' type='text'><![CDATA[SELECT 
global_entity_id,
  date as month,
  cost as budget,
  acquisition,
  case 
  when channel_targets like 'App - Branding' then 'OB'
  when channel_targets like 'Display - Branding' then 'OB'
  when channel_targets like 'Paid Social - Branding' then 'OB'
  when goal_dh in ('Brand Protection','Acquisition') then 'PM'
  else 'ATL'
  end as type,

  case 
  when channel_targets like 'App - Branding' then 'nonPM'
  when channel_targets like 'Display - Branding' then 'nonPM'
  when channel_targets like 'Paid Social - Branding' then 'nonPM'
  when goal_dh in ('Brand Protection','Acquisition') then 'PM'
  else 'nonPM'
  end as PM_nonPM,
  goal_dh,
  channel_grouping_dh

   FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_cs_targets_and_budgets_enriched`
  where date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH)
  AND date <<= DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH)
  and (cost >> 1 or acquisition >>1)
  and 
    (channel_targets in ('App - Branding','Display - Branding',
  'Paid Social - Branding','TV media','Radio','OOH (Out of Home)','Sponsorships')
    or
    goal_dh in ('Acquisition','Brand Protection')
    )]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.17trp3m0o7hkwt1f9sa8d122wnh2' name='regional budgets query' type='text'><![CDATA[SELECT 
global_entity_id,
