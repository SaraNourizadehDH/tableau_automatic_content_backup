              <calculation class='tableau' formula='CASE [PM_nonPM]&#13;&#10;when &apos;PM&apos; then [cost]&#13;&#10;end' />
            </column>
            <column datatype='string' name='[PM_nonPM]' role='dimension' type='nominal' />
