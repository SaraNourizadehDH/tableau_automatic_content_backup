              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[start_date_base (copy)_955889044658282504] AND [date] &lt;= [Parameters].[start_date_base (copy) (copy)_955889044658290697] THEN [cost] ELSE 0 END' />
