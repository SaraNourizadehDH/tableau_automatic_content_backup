            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='EU Data Production' schema='pandata_shared' server-oauth='' username='tamerlan.saidov@deliveryhero.com' workgroup-auth-mode='prompt' />
