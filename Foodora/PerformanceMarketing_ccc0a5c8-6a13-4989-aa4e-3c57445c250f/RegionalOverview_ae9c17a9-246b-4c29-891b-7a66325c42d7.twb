              <calculation class='tableau' formula='[acq_last_7d (copy 2)_1220757033229783047] / &#13;&#10;&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [acquisitions] else 0 end&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='Arrow_spend_mom' datatype='string' name='[Arrow_spend_wow (copy 2)_277252855317811201]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Spend_WoW (copy)_1220757033237626892] &lt;= 0.03 and [Spend_WoW (copy)_1220757033237626892] &gt;= 0 then &quot;↗&quot;&#13;&#10;elseIF [Spend_WoW (copy)_1220757033237626892] &lt; 0 and [Spend_WoW (copy)_1220757033237626892] &gt;= -0.03 then &quot;↘&quot;&#13;&#10;elseif [Spend_WoW (copy)_1220757033237626892] &gt;0 then  &quot;↑&quot;&#13;&#10;ELSEIF [Spend_WoW (copy)_1220757033237626892] &lt; 0 then &quot;↓&quot;&#13;&#10;else &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='CPA_MoM' datatype='real' default-format='*+0.0%;-0.0%' name='[CPA_WoW (copy)_1220757033243414554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CPA_last_7d (copy)_1220757033243349017]/&#13;&#10;(sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [cost] end&#13;&#10;)&#13;&#10;/&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [acquisitions] end&#13;&#10;))&#13;&#10;-1' />
            </column>
            <column caption='CPA_WoW' datatype='real' default-format='*+0.0%;-0.0%' name='[CPA_last_7d (copy) (copy)_1220757033242206232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1220757033241214998]/&#13;&#10;(&#13;&#10;[Calculation_667377187459932163]/[Spend_benchmark_week (copy)_667377187465740293]&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='CPA_last_4w' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[CPA_last_7d (copy)_1220757033243349017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Spend_last_7d (copy 2)_1220757033229402117]/[acq_last_7d (copy 2)_1220757033229783047]' />
            </column>
            <column caption='Spend_last_7d' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Calculation_1220757033220493312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_7d] when true then [cost] ELSE 0 end&#13;&#10;)' />
