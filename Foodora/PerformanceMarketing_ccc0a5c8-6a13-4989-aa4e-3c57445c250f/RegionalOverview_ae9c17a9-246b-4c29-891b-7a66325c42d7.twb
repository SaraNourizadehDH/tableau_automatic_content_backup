          <datasource-dependencies datasource='federated.1ya1its1ly66pt14pw8yx0n7z98o'>
            <column caption='rr_daily_day_left_until_eom' datatype='integer' name='[Calculation1 (copy)_2218585806341713926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(DAY(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [date])))))- min(DAY([date]))' />
            </column>
            <column caption='rr_daily_avg_PMspend_l7d' datatype='real' name='[Calculation_2218585806328168449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG((SUM([federated.1vv0wqm14enmn51gzkkhj1s8fgwm].[Actual Spend  (copy)_783626366420758533])), -6, 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cumulative spend' datatype='real' name='[Calculation_783626366417698820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF min([date]) &lt; TODAY()-1 THEN RUNNING_SUM(SUM([federated.1vv0wqm14enmn51gzkkhj1s8fgwm].[Actual Spend  (copy)_783626366420758533])) END'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[global_entity_id]' />
                  <order field='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[date]' />
                  <sort direction='ASC' using='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[min:date:ok]' />
                </table-calc>
              </calculation>
            </column>
            <column datatype='real' name='[adjusted_budget]' role='measure' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='Day' name='[dy:date:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Min' name='[min:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='Month' name='[mn:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='MY' name='[my:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='None' name='[none:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='rr_daily_RUNRATE' datatype='real' default-format='p0.0%' name='[rr_daily_avg_PMspend_l7d (copy)_2218585806343589898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF min([date]) &lt; TODAY() - 1 THEN&#13;&#10;[rr_daily_cumulative_pm_spend_monthly (copy)_2218585806342529033]&#13;&#10;/&#13;&#10;sum([adjusted_budget])&#13;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='rr_daily_projected_spend_monthly' datatype='real' name='[rr_daily_cumulative_pm_spend_monthly (copy)_2218585806342529033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(([federated.1vv0wqm14enmn51gzkkhj1s8fgwm].[Actual Spend  (copy)_783626366420758533])))&#13;&#10;+&#13;&#10;(&#13;&#10;[Calculation1 (copy)_2218585806341713926] * [Calculation_2218585806328168449]&#13;&#10;)'>
                <table-calc level-break='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[dy:date:ok]' ordering-field='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[date]' ordering-type='Field' />
