            <column caption='Arrow_inst_comparison' datatype='string' name='[Arrow_acqs_comparison (copy)_671036368526286851]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Acqs comparison delta (%) (copy)_671036368526286850] &lt;= 0.03 and [Acqs comparison delta (%) (copy)_671036368526286850] &gt;= 0 then &quot;↗&quot;&#13;&#10;elseIF [Acqs comparison delta (%) (copy)_671036368526286850] &lt; 0 and [Acqs comparison delta (%) (copy)_671036368526286850] &gt;= -0.03 then &quot;↘&quot;&#13;&#10;elseif [Acqs comparison delta (%) (copy)_671036368526286850] &gt;0 then  &quot;↑&quot;&#13;&#10;ELSEIF [Acqs comparison delta (%) (copy)_671036368526286850] &lt; 0 then &quot;↓&quot;&#13;&#10;else &quot;&quot;&#13;&#10;END' />
            </column>
