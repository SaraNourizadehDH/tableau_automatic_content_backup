              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[rr_daily_cumulative_pm_spend_monthly (copy)_2218585806342529033]' level-break='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[dy:date:ok]' ordering-field='[federated.1ya1its1ly66pt14pw8yx0n7z98o].[date]' ordering-type='Field' />
