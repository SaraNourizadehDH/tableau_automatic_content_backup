            <column caption='Budget delta (pacing - td) (ABS)' datatype='real' default-format='c&quot;€&quot;#,##0,K;(&quot;€&quot;#,##0,K)' name='[Budget delta (pacing - td) (copy)_173107136604127232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[projected_cost]-[cost]' />
