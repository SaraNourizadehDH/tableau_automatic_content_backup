              <calculation class='tableau' formula='IF [Installs_WoW (copy)_1220757033240645652] &lt;= 0.03 and [Installs_WoW (copy)_1220757033240645652] &gt;= 0 then &quot;↗&quot;&#13;&#10;elseIF [Installs_WoW (copy)_1220757033240645652] &lt; 0 and [Installs_WoW (copy)_1220757033240645652] &gt;= -0.03 then &quot;↘&quot;&#13;&#10;elseif [Installs_WoW (copy)_1220757033240645652] &gt;0 then  &quot;↑&quot;&#13;&#10;ELSEIF [Installs_WoW (copy)_1220757033240645652] &lt; 0 then &quot;↓&quot;&#13;&#10;else &quot;&quot;&#13;&#10;END' />
