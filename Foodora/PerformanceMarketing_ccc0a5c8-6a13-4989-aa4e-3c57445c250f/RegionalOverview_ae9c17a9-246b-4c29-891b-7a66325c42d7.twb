      <column caption='Target CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_801077841546457091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.1emzea40hkqeoi16v38a50e71obl].[budget])/SUM([federated.1emzea40hkqeoi16v38a50e71obl].[acquisition])' />
      </column>
      <column caption='Acq. Pacing' datatype='real' default-format='p0.0%' name='[Calculation_801077841546878980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([projected_acq])/SUM([federated.1emzea40hkqeoi16v38a50e71obl].[acquisition])' />
      </column>
      <column caption='Projected CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_923800925735284736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([projected_cost])/sum([projected_acq])' />
      </column>
      <column caption='Dim_2' datatype='string' name='[Dim_1 (copy)_1018376522199273474]' role='dimension' type='nominal'>
