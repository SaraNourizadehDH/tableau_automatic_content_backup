] &lt; 0.03 and [CPA_last_7d (copy) (copy)_1220757033242206232] &lt; 0.03 and &#13;&#10;    [CPA_last_7d (copy) (copy)_1220757033242206232]/[Installs_WoW (copy)_1220757033240645652] &gt; 2 then &quot;🟢&quot;&#13;&#10;&#13;&#10;ELSEIF [Installs_WoW (copy)_1220757033240645652] &gt; 0.03 and [CPA_last_7d (copy) (copy)_1220757033242206232] &gt; 0.03 and&#13;&#10;    [CPA_last_7d (copy) (copy)_1220757033242206232]/[Installs_WoW (copy)_1220757033240645652] &gt; 2 then &quot;🔴&quot;&#13;&#10;&#13;&#10;ELSEIF  [Installs_WoW (copy)_1220757033240645652] &lt; 0.03 and [CPA_last_7d (copy) (copy)_1220757033242206232] &lt; 0.03 and &#13;&#10;    [Installs_WoW (copy)_1220757033240645652]/[CPA_last_7d (copy) (copy)_1220757033242206232] &gt; 2 then &quot;🔴&quot;&#13;&#10;&#13;&#10;ELSE &quot;⚪&quot;&#13;&#10;&#13;&#10;END' />
