    <worksheet name='Inst_G'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Installs (incl. SKAN)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_cs' name='federated.1vv0wqm14enmn51gzkkhj1s8fgwm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Stack Dimension' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Market&quot;'>
              <calculation class='tableau' formula='&quot;Market&quot;' />
              <aliases>
                <alias key='&quot;channel_grouping_dh&quot;' value='Channel' />
                <alias key='&quot;objective_dh&quot;' value='Objective' />
                <alias key='&quot;sub_channel_dh&quot;' value='Sub Channel' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vv0wqm14enmn51gzkkhj1s8fgwm'>
            <column caption='Stacked_dimension' datatype='string' name='[Calculation_1252563665207750656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#13;&#10;when &apos;OS&apos; then [os_name]&#13;&#10;when &apos;Market&apos; then [global_entity_id]&#13;&#10;when &apos;PM_nonPM&apos; then [PM_nonPM]&#13;&#10;when &apos;channel_grouping_dh&apos; then [channel_grouping_dh]&#13;&#10;when &apos;sub_channel_dh&apos; then [sub_channel_dh]&#13;&#10;when &apos;objective_dh&apos; then [objective_dh]&#13;&#10;end' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_1401182501372633088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case&#13;&#10;[global_entity_id]&#13;&#10;when &apos;DJ_CZ&apos;  then &apos;EU&apos;&#13;&#10;when &apos;FO_NO&apos;  then &apos;EU&apos;&#13;&#10;when &apos;MJM_AT&apos; then &apos;EU&apos;&#13;&#10;when &apos;NP_HU&apos;  then &apos;EU&apos;&#13;&#10;when &apos;OP_SE&apos;  then &apos;EU&apos;&#13;&#10;when &apos;PO_FI&apos;  then &apos;EU&apos;&#13;&#10;&#13;&#10;when &apos;FP_BD&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_HK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_KH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_LA&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MM&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MY&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_SG&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TW&apos; then &apos;APAC&apos;&#13;&#10;&#13;&#10;when &apos;YS_TR&apos; then &apos;TR&apos;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Dates' datatype='date' datatype-customized='true' name='[Calculation_237283452574384130]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(case [Parameters].[Parameter 1]&#13;&#10;when &apos;Daily&apos; then [Calculation_675539951979085824]&#13;&#10;when &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[Calculation_675539951979085824],&apos;monday&apos;)&#13;&#10;when &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[Calculation_675539951979085824])&#13;&#10;when &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[Calculation_675539951979085824])&#13;&#10;end)' />
            </column>
            <column caption='date_with_spend' datatype='date' name='[Calculation_675539951979085824]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date] : &#13;&#10;    MAX(&#13;&#10;        IF [cost] &gt; 0 THEN [date] END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column datatype='string' name='[PM_nonPM]' role='dimension' type='nominal' />
            <column caption='inst_wow_graph' datatype='real' default-format='*+0%;-0%' name='[acq_wow_graph (copy)_675539951983185924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([installs]) / LOOKUP(SUM([installs]), -1)&#13;&#10;-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[channel_grouping_dh]' role='dimension' type='nominal' />
            <column caption='Actual Spend' datatype='real' default-format='c&quot;€&quot;#,##0,.0K;(&quot;€&quot;#,##0,.0K)' name='[cost]' role='measure' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[installs]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1252563665207750656]' derivation='None' name='[none:Calculation_1252563665207750656:nk]' pivot='key' type='nominal' />
