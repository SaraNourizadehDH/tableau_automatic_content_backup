        <calculation class='tableau' formula='case&#13;&#10;[global_entity_id]&#13;&#10;when &apos;DJ_CZ&apos;  then &apos;EU&apos;&#13;&#10;when &apos;FO_NO&apos;  then &apos;EU&apos;&#13;&#10;when &apos;MJM_AT&apos; then &apos;EU&apos;&#13;&#10;when &apos;NP_HU&apos;  then &apos;EU&apos;&#13;&#10;when &apos;OP_SE&apos;  then &apos;EU&apos;&#13;&#10;when &apos;PO_FI&apos;  then &apos;EU&apos;&#13;&#10;&#13;&#10;when &apos;FP_BD&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_HK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_KH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_LA&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MM&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MY&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_SG&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TW&apos; then &apos;APAC&apos;&#13;&#10;&#13;&#10;when &apos;YS_TR&apos; then &apos;TR&apos;&#13;&#10;&#13;&#10;end' />
      </column>
      <column caption='PM_Org_Else' datatype='string' name='[Calculation_1439181569756831744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case &#13;&#10;[objective_dh] &#13;&#10;when &apos;Reach&apos; then &apos;PM&apos;&#13;&#10;when &apos;Brand&apos; then &apos;PM&apos;&#13;&#10;else &apos;nonPM&apos; end' />
      </column>
      <column caption='Acqs_share' datatype='real' default-format='p0%' name='[Calculation_152278026459680779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([acquisitions])/[acquisitions (copy)_1076078859681255424]' />
      </column>
      <column caption='Reliability' datatype='string' name='[Calculation_1529816509086666753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Calculation_237283452574384130] : min( if [Calculation_675539951979085824] &lt;= DATEADD(&apos;day&apos;, -3, TODAY()) then &apos;reliable&apos;&#13;&#10;else &apos;non-reliable&apos;&#13;&#10;end)}' />
      </column>
      <column caption='TF1_Acqs+Reacqs' datatype='real' name='[Calculation_1537979291514241025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Acqs compare (copy)_1439181569760473095]) + SUM([reacquisition (copy)_1439181569760583688])' />
      </column>
      <column caption='TF2_Acqs+Reacqs' datatype='real' name='[Calculation_1537979291514454018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TF1_Acqs (copy)_1439181569765576719])+SUM([TF1_reacquisition_calibrated (copy)_1439181569765752851])' />
      </column>
      <column caption='TF3_Acqs+Reacqs' datatype='real' name='[Calculation_1537979291514548227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([TF2_Acqs (copy)_1439181569767489559])+SUM([TF2_reacquisition_calibrated (copy)_1439181569767649307])' />
      </column>
      <column caption='TF3_vs_TF2_Actual Spend_CC' datatype='string' name='[Calculation_1537979291520077829]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [TF3_Actual Spend (copy)_1439181569773289504] &gt;= 0.01 THEN &quot;Green&quot;&#13;&#10;ELSEIF [TF3_Actual Spend (copy)_1439181569773289504] &lt; 0.01 THEN &quot;Red&quot;&#13;&#10;ELSE &quot;Default&quot;&#13;&#10;END' />
      </column>
      <column caption='Filter Out Zero Rows (Hans view)' datatype='boolean' name='[Calculation_170855320013971456]' role='measure' type='nominal'>
        <calculation class='tableau' formula='sum([cost]) != 0&#13;&#10;or&#13;&#10;sum([acquisitions]) != 0' />
      </column>
      <column caption='Dates' datatype='date' datatype-customized='true' name='[Calculation_237283452574384130]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(case [Parameters].[Parameter 1]&#13;&#10;when &apos;Daily&apos; then [Calculation_675539951979085824]&#13;&#10;when &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[Calculation_675539951979085824],&apos;monday&apos;)&#13;&#10;when &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[Calculation_675539951979085824])&#13;&#10;when &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[Calculation_675539951979085824])&#13;&#10;end)' />
      </column>
      <column caption='Budget utilized TD' datatype='real' default-format='p0%' name='[Calculation_272186325506519040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cost])/SUM([federated.1emzea40hkqeoi16v38a50e71obl].[budget])' />
      </column>
      <column caption='Budget delta (pacing - td)' datatype='real' default-format='p0%' name='[Calculation_272186325508313089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_801077841541046273]-[Calculation_272186325506519040]' />
      </column>
      <column caption='CTR_PM' datatype='real' default-format='p0.00%' name='[Calculation_325103648209666048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([clicks])/ sum(&#13;&#10;if [PM_nonPM]= &apos;PM&apos; then [impressions] else 0 end )' />
      </column>
      <column caption='CPC_PM' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Calculation_325103648209723393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(cost)/ sum(&#13;&#10;if [PM_nonPM]= &apos;PM&apos; then [clicks] else 0 end )' />
      </column>
      <column caption='CPI' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_325103648209801218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [cost] ELSE 0 END&#13;&#10;) / SUM([installs])' />
      </column>
      <column caption='CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_325103648209874947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(cost)/sum([acquisitions])' />
      </column>
      <column caption='CVRi (click to inst)' datatype='real' default-format='p0.00%' name='[Calculation_325103648209932292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([installs])/sum(IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [clicks] else 0 end)' />
      </column>
      <column caption='CVRa (inst to acq)' datatype='real' default-format='p0.00%' name='[Calculation_325103648210067461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [acquisitions] else 0 end)/sum([installs])' />
      </column>
      <column caption='CVRs (click to signup)' datatype='real' default-format='p0.00%' name='[Calculation_325103648210132998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([signups])/sum([clicks])' />
      </column>
      <column caption='7d_rolling_week' datatype='date' name='[Calculation_667377187457916928]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(&#13;&#10;    DATEADD(&#13;&#10;        &apos;day&apos;,&#13;&#10;        DATEPART(&apos;weekday&apos;, [Calculation_667377187458117633]) - 2,&#13;&#10;        DATETRUNC(&apos;week&apos;, DATEADD(&apos;day&apos;, -DATEPART(&apos;weekday&apos;, [Calculation_667377187458117633]) + 1, [Calculation_675539951979085824]))&#13;&#10;    )&#13;&#10;) - 7' />
      </column>
      <column caption='max_date' datatype='date' name='[Calculation_667377187458117633]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF [cost] &gt; 0 THEN [date] END&#13;&#10;)}' />
      </column>
      <column caption='Spend_benchmark_week' datatype='real' name='[Calculation_667377187459932163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#13;&#10;if [date] &gt;= [Parameters].[Parameter 3] and [date] &lt;= ([Parameters].[Parameter 3]+6) then [cost] ELSE 0 end&#13;&#10;)' />
      </column>
      <column caption='date_with_spend' datatype='date' name='[Calculation_675539951979085824]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [date] : &#13;&#10;    MAX(&#13;&#10;        IF [cost] &gt; 0 THEN [date] END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='acq_wow_graph' datatype='real' default-format='*+0%;-0%' name='[Calculation_675539951980195841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions]) / LOOKUP(SUM([acquisitions]), -1)-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Arrow_spend_wow' datatype='string' name='[Calculation_744219839835570176]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1220757033237139467] &lt;= 0.03 and [Calculation_1220757033237139467] &gt;= 0 then &quot;↗&quot;&#13;&#10;elseIF [Calculation_1220757033237139467] &lt; 0 and [Calculation_1220757033237139467] &gt;= -0.03 then &quot;↘&quot;&#13;&#10;elseif [Calculation_1220757033237139467] &gt;0 then  &quot;↑&quot;&#13;&#10;ELSEIF [Calculation_1220757033237139467] &lt; 0 then &quot;↓&quot;&#13;&#10;else &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Budget Pacing' datatype='real' default-format='p0.0%' name='[Calculation_801077841541046273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([projected_cost])/SUM([federated.1emzea40hkqeoi16v38a50e71obl].[budget])' />
