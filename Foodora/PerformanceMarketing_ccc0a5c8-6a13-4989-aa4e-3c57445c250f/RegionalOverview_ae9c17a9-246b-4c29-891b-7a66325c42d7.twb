      <column caption='Projected EOM Δ' datatype='real' default-format='*&quot;€&quot;+#,##0,K;&quot;€&quot;-#,##0,K' name='[Calculation_801077841542246402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([projected_cost])-SUM([federated.1emzea40hkqeoi16v38a50e71obl].[budget])' />
