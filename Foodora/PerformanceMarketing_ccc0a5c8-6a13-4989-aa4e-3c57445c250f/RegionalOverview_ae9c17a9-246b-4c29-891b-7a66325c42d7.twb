            <column caption='Actual Spend base' datatype='real' default-format='c&quot;€&quot;#,##0,.0K;(&quot;€&quot;#,##0,.0K)' name='[Actual Spend (copy)_955889044651380736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 5] AND [date] &lt;= [Parameters].[start_date_base (copy)_955889044658130951] THEN [cost] ELSE 0 END' />
