      </column>
      <column caption='MoM Signal (copy)' datatype='string' name='[MoM Signal (copy)_1076078859806199829]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if ([Acq_MoM (copy)_1076078859806199821] &gt;= -0.03 and [Acq_MoM (copy)_1076078859806199821] &lt;= 0.03) and &#13;&#10;    ([CPA_MoM (copy)_1076078859806199826] &gt;= -0.03 and [CPA_MoM (copy)_1076078859806199826] &lt;= 0.03) then &quot;⚪&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF  ([Acq_MoM (copy)_1076078859806199821] &gt;= -0.03 and [Acq_MoM (copy)_1076078859806199821] &lt;= 0.03) and&#13;&#10;    [CPA_MoM (copy)_1076078859806199826] &gt; 0.03 then &quot;🔴&quot;&#13;&#10;&#13;&#10;ELSEIF  ([Acq_MoM (copy)_1076078859806199821] &gt;= -0.03 and [Acq_MoM (copy)_1076078859806199821] &lt;= 0.03) and &#13;&#10;    [CPA_MoM (copy)_1076078859806199826] &lt; 0.03 then &quot;🟢&quot;&#13;&#10;&#13;&#10;ELSEIF ([CPA_MoM (copy)_1076078859806199826] &gt;= -0.03 and [CPA_MoM (copy)_1076078859806199826] &lt;= 0.03) and&#13;&#10;    [Acq_MoM (copy)_1076078859806199821] &gt; 0.03 then &quot;🟢&quot;&#13;&#10;&#13;&#10;ELSEIF ([CPA_MoM (copy)_1076078859806199826] &gt;= -0.03 and [CPA_MoM (copy)_1076078859806199826] &lt;= 0.03) and&#13;&#10;    [Acq_MoM (copy)_1076078859806199821] &lt; 0.03 then &quot;🔴&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Acq_MoM (copy)_1076078859806199821] &gt; 0.03 and [CPA_MoM (copy)_1076078859806199826] &lt;0.03 then &quot;🟢&quot;&#13;&#10;&#13;&#10;ELSEIF [Acq_MoM (copy)_1076078859806199821] &lt;0.03 and [CPA_MoM (copy)_1076078859806199826] &gt;0.03 then &quot;🔴&quot;&#13;&#10;        &#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Acq_MoM (copy)_1076078859806199821] &gt; 0.03 and [CPA_MoM (copy)_1076078859806199826] &gt; 0.03 and&#13;&#10;    [Acq_MoM (copy)_1076078859806199821]/[CPA_MoM (copy)_1076078859806199826] &gt; 2 then &quot;🟢&quot;&#13;&#10;&#13;&#10;ELSEIF  [Acq_MoM (copy)_1076078859806199821] &lt; 0.03 and [CPA_MoM (copy)_1076078859806199826] &lt; 0.03 and &#13;&#10;    [CPA_MoM (copy)_1076078859806199826]/[Acq_MoM (copy)_1076078859806199821] &gt; 2 then &quot;🟢&quot;&#13;&#10;&#13;&#10;ELSEIF [Acq_MoM (copy)_1076078859806199821] &gt; 0.03 and [CPA_MoM (copy)_1076078859806199826] &gt; 0.03 and&#13;&#10;    [CPA_MoM (copy)_1076078859806199826]/[Acq_MoM (copy)_1076078859806199821] &gt; 2 then &quot;🔴&quot;&#13;&#10;&#13;&#10;ELSEIF  [Acq_MoM (copy)_1076078859806199821] &lt; 0.03 and [CPA_MoM (copy)_1076078859806199826] &lt; 0.03 and &#13;&#10;    [Acq_MoM (copy)_1076078859806199821]/[CPA_MoM (copy)_1076078859806199826] &gt; 2 then &quot;🔴&quot;&#13;&#10;&#13;&#10;ELSE &quot;⚪&quot;&#13;&#10;&#13;&#10;END' />
      </column>
