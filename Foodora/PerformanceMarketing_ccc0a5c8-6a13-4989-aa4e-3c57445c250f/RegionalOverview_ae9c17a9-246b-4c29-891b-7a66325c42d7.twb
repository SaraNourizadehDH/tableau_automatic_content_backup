            <column caption='p7d_rolling_7d_start_date' datatype='date' name='[7d_rolling_week (copy)_667377187458191362]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF [cost] &gt; 0 THEN [date]-14 END&#13;&#10;)}' />
