            <column caption='Actual Spend compare' datatype='real' default-format='c&quot;€&quot;#,##0,.0K;(&quot;€&quot;#,##0,.0K)' name='[Actual Spend (copy 2)_955889044652310530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[start_date_base (copy)_955889044658282504] AND [date] &lt;= [Parameters].[start_date_base (copy) (copy)_955889044658290697] THEN [cost] ELSE 0 END' />
            </column>
            <column caption='Actual Spend ' datatype='real' default-format='c&quot;€&quot;#,##0,K;(&quot;€&quot;#,##0,K)' name='[Actual Spend (copy)_1194016909397553152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost]' />
            </column>
            <column caption='Actual Spend (graphs delta)' datatype='real' default-format='*+0%;-0%' name='[Actual Spend (copy)_248542427551690752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LOOKUP(attr([global_entity_id]), -1) = attr([global_entity_id]) THEN&#13;&#10;    SUM([cost]) / LOOKUP(SUM([cost]), -1) - 1&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Actual Spend base' datatype='real' default-format='c&quot;€&quot;#,##0,.0K;(&quot;€&quot;#,##0,.0K)' name='[Actual Spend (copy)_955889044651380736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 5] AND [date] &lt;= [Parameters].[start_date_base (copy)_955889044658130951] THEN [cost] ELSE 0 END' />
