          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1vv0wqm14enmn51gzkkhj1s8fgwm].[7d_rolling_week (copy)_667377187458191362]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1vv0wqm14enmn51gzkkhj1s8fgwm].[Calculation_667377187457916928]' caption='Benchmark Week' datatype='date' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-06#'>
              <calculation class='tableau' formula='#2025-08-06#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vv0wqm14enmn51gzkkhj1s8fgwm'>
            <column caption='p7d_rolling_7d_start_date' datatype='date' name='[7d_rolling_week (copy)_667377187458191362]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF [cost] &gt; 0 THEN [date]-14 END&#13;&#10;)}' />
            </column>
            <column caption='Acq_MoM (copy)' datatype='real' default-format='*+0.0%;-0.0%' name='[Acq_MoM (copy)_1076078859806199821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Acq_last_4w (copy)_1076078859805425676] / &#13;&#10;(&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [acquisitions] else 0 end&#13;&#10;)&#13;&#10;+&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [reacquisition_calibrated] else 0 end&#13;&#10;)&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='Acq_MoM' datatype='real' default-format='*+0.0%;-0.0%' name='[Acq_WoW (copy)_1220757033240940565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acq_last_7d (copy 2)_1220757033229783047] / &#13;&#10;&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [acquisitions] else 0 end&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='Acq_last_4w (copy)' datatype='real' name='[Acq_last_4w (copy)_1076078859805425676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_30d] when true then [acquisitions] else 0 end&#13;&#10;)&#13;&#10;+&#13;&#10;sum(&#13;&#10;case [last_30d] when true then [reacquisition_calibrated] else 0 end&#13;&#10;)' />
            </column>
            <column caption='Arrow_acq_mom (copy)' datatype='string' name='[Arrow_acq_mom (copy)_1076078859806199824]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Acq_MoM (copy)_1076078859806199821] &lt;= 0.03 and [Acq_MoM (copy)_1076078859806199821] &gt;= 0 then &quot;↗&quot;&#13;&#10;elseIF [Acq_MoM (copy)_1076078859806199821] &lt; 0 and [Acq_MoM (copy)_1076078859806199821] &gt;= -0.03 then &quot;↘&quot;&#13;&#10;elseif [Acq_MoM (copy)_1076078859806199821] &gt;0 then  &quot;↑&quot;&#13;&#10;ELSEIF [Acq_MoM (copy)_1076078859806199821] &lt; 0 then &quot;↓&quot;&#13;&#10;else &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='CPA_MoM' datatype='real' default-format='*+0.0%;-0.0%' name='[CPA_WoW (copy)_1220757033243414554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CPA_last_7d (copy)_1220757033243349017]/&#13;&#10;(sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [cost] end&#13;&#10;)&#13;&#10;/&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [acquisitions] end&#13;&#10;))&#13;&#10;-1' />
            </column>
            <column caption='CPA_WoW' datatype='real' default-format='*+0.0%;-0.0%' name='[CPA_last_7d (copy) (copy)_1220757033242206232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1220757033241214998]/&#13;&#10;(&#13;&#10;[Calculation_667377187459932163]/[Spend_benchmark_week (copy)_667377187465740293]&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='CPA_last_4w' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[CPA_last_7d (copy)_1220757033243349017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Spend_last_7d (copy 2)_1220757033229402117]/[acq_last_7d (copy 2)_1220757033229783047]' />
            </column>
            <column caption='Spend_last_7d' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Calculation_1220757033220493312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_7d] when true then [cost] ELSE 0 end&#13;&#10;)' />
            </column>
            <column caption='Acq_last_7d' datatype='real' name='[Calculation_1220757033221685250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_7d] when true then [acquisitions] else 0 end&#13;&#10;)' />
            </column>
            <column caption='Installs_7d' datatype='integer' name='[Calculation_1220757033236574216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_7d] when true then [installs] else 0 end&#13;&#10;)' />
            </column>
            <column caption='Spend_WoW' datatype='real' default-format='*+0.0%;-0.0%' name='[Calculation_1220757033237139467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1220757033220493312])/&#13;&#10;(&#13;&#10;[Calculation_667377187459932163]&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='Installs_WoW' datatype='real' default-format='*+0.0%;-0.0%' name='[Calculation_1220757033240031250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1220757033236574216] / &#13;&#10;[Spend_benchmark_week (copy) (copy)_667377187465744390]-1' />
            </column>
            <column caption='CPA_last_7d' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_1220757033241214998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1220757033220493312]/[Calculation_1220757033221685250]' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_1401182501372633088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case&#13;&#10;[global_entity_id]&#13;&#10;when &apos;DJ_CZ&apos;  then &apos;EU&apos;&#13;&#10;when &apos;FO_NO&apos;  then &apos;EU&apos;&#13;&#10;when &apos;MJM_AT&apos; then &apos;EU&apos;&#13;&#10;when &apos;NP_HU&apos;  then &apos;EU&apos;&#13;&#10;when &apos;OP_SE&apos;  then &apos;EU&apos;&#13;&#10;when &apos;PO_FI&apos;  then &apos;EU&apos;&#13;&#10;&#13;&#10;when &apos;FP_BD&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_HK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_KH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_LA&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MM&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MY&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_SG&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TW&apos; then &apos;APAC&apos;&#13;&#10;&#13;&#10;when &apos;YS_TR&apos; then &apos;TR&apos;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='7d_rolling_week' datatype='date' name='[Calculation_667377187457916928]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(&#13;&#10;    DATEADD(&#13;&#10;        &apos;day&apos;,&#13;&#10;        DATEPART(&apos;weekday&apos;, [Calculation_667377187458117633]) - 2,&#13;&#10;        DATETRUNC(&apos;week&apos;, DATEADD(&apos;day&apos;, -DATEPART(&apos;weekday&apos;, [Calculation_667377187458117633]) + 1, [Calculation_675539951979085824]))&#13;&#10;    )&#13;&#10;) - 7' />
            </column>
            <column caption='max_date' datatype='date' name='[Calculation_667377187458117633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF [cost] &gt; 0 THEN [date] END&#13;&#10;)}' />
            </column>
            <column caption='Spend_benchmark_week' datatype='real' name='[Calculation_667377187459932163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;if [date] &gt;= [Parameters].[Parameter 3] and [date] &lt;= ([Parameters].[Parameter 3]+6) then [cost] ELSE 0 end&#13;&#10;)' />
            </column>
            <column caption='date_with_spend' datatype='date' name='[Calculation_675539951979085824]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date] : &#13;&#10;    MAX(&#13;&#10;        IF [cost] &gt; 0 THEN [date] END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Installs_4w' datatype='integer' name='[Installs_7d (copy)_1220757033236709385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_30d] when true then [installs] else 0 end&#13;&#10;)' />
            </column>
            <column caption='Installs_MoM' datatype='real' default-format='*+0.0%;-0.0%' name='[Installs_WoW (copy)_1220757033240358931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Installs_7d (copy)_1220757033236709385] / &#13;&#10;&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [installs] else 0 end&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='Acq_WoW' datatype='real' default-format='*+0.0%;-0.0%' name='[Installs_WoW (copy)_1220757033240645652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1220757033221685250] / &#13;&#10;[Spend_benchmark_week (copy)_667377187465740293]-1' />
            </column>
            <column caption='Market Tier' datatype='string' name='[Region (copy)_765893418635550721]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case&#13;&#10;[global_entity_id]&#13;&#10;when &apos;DJ_CZ&apos;  then &apos;Tier-2&apos;&#13;&#10;when &apos;FO_NO&apos;  then &apos;Tier-2&apos;&#13;&#10;when &apos;MJM_AT&apos; then &apos;Tier-2&apos;&#13;&#10;when &apos;NP_HU&apos;  then &apos;Tier-1&apos;&#13;&#10;when &apos;OP_SE&apos;  then &apos;Tier-1&apos;&#13;&#10;when &apos;PO_FI&apos;  then &apos;Tier-3&apos;&#13;&#10;&#13;&#10;when &apos;FP_BD&apos; then &apos;Tier-2&apos;&#13;&#10;when &apos;FP_HK&apos; then &apos;Tier-1&apos;&#13;&#10;when &apos;FP_KH&apos; then &apos;Tier-3&apos;&#13;&#10;when &apos;FP_LA&apos; then &apos;Tier-3&apos;&#13;&#10;when &apos;FP_MM&apos; then &apos;Tier-3&apos;&#13;&#10;when &apos;FP_MY&apos; then &apos;Tier-1&apos;&#13;&#10;when &apos;FP_PH&apos; then &apos;Tier-1&apos;&#13;&#10;when &apos;FP_PK&apos; then &apos;Tier-2&apos;&#13;&#10;when &apos;FP_SG&apos; then &apos;Tier-2&apos;&#13;&#10;when &apos;FP_TH&apos; then &apos;Tier-2&apos;&#13;&#10;when &apos;FP_TW&apos; then &apos;Tier-1&apos;&#13;&#10;&#13;&#10;when &apos;YS_TR&apos; then &apos;Tier-1&apos;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='Spend_MoM' datatype='real' default-format='*+0.0%;-0.0%' name='[Spend_WoW (copy)_1220757033237626892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Spend_last_7d (copy 2)_1220757033229402117])/&#13;&#10;(sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [cost] ELSE 0 end&#13;&#10;))&#13;&#10;-1' />
