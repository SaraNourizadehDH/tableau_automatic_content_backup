              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[Parameter 5] AND [date] &lt;= [Parameters].[start_date_base (copy)_955889044658130951] THEN [acquisitions] ELSE 0 END' />
            </column>
            <column caption='Acqs compare' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Actual Spend compare (copy)_955889044668461069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[start_date_base (copy)_955889044658282504] AND [date] &lt;= [Parameters].[start_date_base (copy) (copy)_955889044658290697] THEN [acquisitions] ELSE 0 END' />
            </column>
            <column caption='Acqs comparison delta (%)' datatype='real' default-format='*&quot;+&quot; #,##0.0%;&quot;-&quot; #,##0.0%;' name='[Actual Spend comparison delta (%) (copy)_955889044668461071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Actual Spend base (copy)_955889044668461070])/sum([Actual Spend compare (copy)_955889044668461069]) -1' />
            </column>
            <column caption='CPA_WoW' datatype='real' default-format='*+0.0%;-0.0%' name='[CPA_last_7d (copy) (copy)_1220757033242206232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1220757033241214998]/&#13;&#10;(&#13;&#10;[Calculation_667377187459932163]/[Spend_benchmark_week (copy)_667377187465740293]&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='Spend_last_7d' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Calculation_1220757033220493312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;case [last_7d] when true then [cost] ELSE 0 end&#13;&#10;)' />
            </column>
