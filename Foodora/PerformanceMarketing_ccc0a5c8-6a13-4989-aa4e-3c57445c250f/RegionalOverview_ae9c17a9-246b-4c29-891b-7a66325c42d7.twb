    <worksheet name='Flexible region (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_cs' name='federated.1vv0wqm14enmn51gzkkhj1s8fgwm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dim1' datatype='string' name='[Dim2 (copy)_1018376522198290432]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vv0wqm14enmn51gzkkhj1s8fgwm'>
            <column caption='CPAR' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[CPA (copy)_1439181569758289921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost])/(sum([reacquisition_calibrated])+sum([acquisitions]))' />
            </column>
            <column caption='CPAR ' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[CPAR (copy)_248542427556425729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF attr([Calculation_1439181569756831744]) = &apos;PM&apos; THEN [CPA (copy)_1439181569758289921] END' />
            </column>
            <column caption='Dim_1' datatype='string' name='[Calculation_1018376522198396929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Dim2 (copy)_1018376522198290432]&#13;&#10;when &apos;Country&apos; then [global_entity_id]&#13;&#10;when &apos;OS&apos; then [os_name]&#13;&#10;when &apos;Date&apos; then str([Calculation_237283452574384130])&#13;&#10;when &apos;PM_nonPM&apos; then [PM_nonPM]&#13;&#10;when &apos;objective_dh&apos; then [objective_dh]&#13;&#10;when &apos;channel_grouping_dh&apos; then [channel_grouping_dh]&#13;&#10;when &apos;sub_channel_dh&apos; then [sub_channel_dh]&#13;&#10;end' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_1401182501372633088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case&#13;&#10;[global_entity_id]&#13;&#10;when &apos;DJ_CZ&apos;  then &apos;EU&apos;&#13;&#10;when &apos;FO_NO&apos;  then &apos;EU&apos;&#13;&#10;when &apos;MJM_AT&apos; then &apos;EU&apos;&#13;&#10;when &apos;NP_HU&apos;  then &apos;EU&apos;&#13;&#10;when &apos;OP_SE&apos;  then &apos;EU&apos;&#13;&#10;when &apos;PO_FI&apos;  then &apos;EU&apos;&#13;&#10;&#13;&#10;when &apos;FP_BD&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_HK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_KH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_LA&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MM&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_MY&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_PK&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_SG&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TH&apos; then &apos;APAC&apos;&#13;&#10;when &apos;FP_TW&apos; then &apos;APAC&apos;&#13;&#10;&#13;&#10;when &apos;YS_TR&apos; then &apos;TR&apos;&#13;&#10;&#13;&#10;end' />
            </column>
            <column caption='PM_Org_Else' datatype='string' name='[Calculation_1439181569756831744]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case &#13;&#10;[objective_dh] &#13;&#10;when &apos;Reach&apos; then &apos;PM&apos;&#13;&#10;when &apos;Brand&apos; then &apos;PM&apos;&#13;&#10;else &apos;nonPM&apos; end' />
            </column>
            <column caption='Filter Out Zero Rows (Hans view)' datatype='boolean' name='[Calculation_170855320013971456]' role='measure' type='nominal'>
              <calculation class='tableau' formula='sum([cost]) != 0&#13;&#10;or&#13;&#10;sum([acquisitions]) != 0' />
            </column>
            <column caption='Dates' datatype='date' datatype-customized='true' name='[Calculation_237283452574384130]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(case [Parameters].[Parameter 1]&#13;&#10;when &apos;Daily&apos; then [Calculation_675539951979085824]&#13;&#10;when &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[Calculation_675539951979085824],&apos;monday&apos;)&#13;&#10;when &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[Calculation_675539951979085824])&#13;&#10;when &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[Calculation_675539951979085824])&#13;&#10;end)' />
            </column>
            <column caption='CPI' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_325103648209801218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [cost] ELSE 0 END&#13;&#10;) / SUM([installs])' />
            </column>
            <column caption='CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_325103648209874947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(cost)/sum([acquisitions])' />
            </column>
            <column caption='CVRa (inst to acq)' datatype='real' default-format='p0.00%' name='[Calculation_325103648210067461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [acquisitions] else 0 end)/sum([installs])' />
            </column>
            <column caption='date_with_spend' datatype='date' name='[Calculation_675539951979085824]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date] : &#13;&#10;    MAX(&#13;&#10;        IF [cost] &gt; 0 THEN [date] END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column datatype='string' name='[PM_nonPM]' role='dimension' type='nominal' />
            <column datatype='real' name='[acquisitions]' role='measure' type='quantitative' />
            <column datatype='string' name='[channel_grouping_dh]' role='dimension' type='nominal' />
            <column datatype='integer' default-format='n#,##0,K;-#,##0,K' name='[clicks]' role='measure' type='quantitative' />
            <column caption='Actual Spend' datatype='real' default-format='c&quot;€&quot;#,##0,.0K;(&quot;€&quot;#,##0,.0K)' name='[cost]' role='measure' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='date_with_spend (T/F)' datatype='boolean' name='[date_with_spend (copy)_675539951985053703]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [date] : &#13;&#10;    MAX(&#13;&#10;        IF [cost] &gt; 0 THEN true END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='impressions_PM' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[impressions]' role='measure' type='quantitative' />
