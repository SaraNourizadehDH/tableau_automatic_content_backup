            <column caption='Actual Spend comparison delta (%)' datatype='real' default-format='*&quot;+&quot; #,##0.0%;&quot;-&quot; #,##0.0%;' name='[Actual Spend compare (copy)_955889044661874700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Actual Spend (copy)_955889044651380736])/sum([Actual Spend (copy 2)_955889044652310530]) -1' />
            </column>
            <column caption='Acqs compare' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Actual Spend compare (copy)_955889044668461069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[start_date_base (copy)_955889044658282504] AND [date] &lt;= [Parameters].[start_date_base (copy) (copy)_955889044658290697] THEN [acquisitions] ELSE 0 END' />
            </column>
            <column caption='Acqs comparison delta (%)' datatype='real' default-format='*&quot;+&quot; #,##0.0%;&quot;-&quot; #,##0.0%;' name='[Actual Spend comparison delta (%) (copy)_955889044668461071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Actual Spend base (copy)_955889044668461070])/sum([Actual Spend compare (copy)_955889044668461069]) -1' />
