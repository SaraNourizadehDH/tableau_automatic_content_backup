            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_F491A1CF62EA4512899011593C63A28A]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
