            <column caption='Acq_MoM' datatype='real' default-format='*+0.0%;-0.0%' name='[Acq_WoW (copy)_1220757033240940565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acq_last_7d (copy 2)_1220757033229783047] / &#13;&#10;&#13;&#10;sum(&#13;&#10;case [previous_30d_before_last_30d] when true then [acquisitions] else 0 end&#13;&#10;)&#13;&#10;-1' />
