  when channel_targets like 'Paid Social - Branding' then 'OB'
  when goal_dh in ('Brand Protection','Acquisition') then 'PM'
  else 'ATL'
  end as type,

  case 
  when channel_targets like 'App - Branding' then 'nonPM'
  when channel_targets like 'Display - Branding' then 'nonPM'
  when channel_targets like 'Paid Social - Branding' then 'nonPM'
  when goal_dh in ('Brand Protection','Acquisition') then 'PM'
  else 'nonPM'
  end as PM_nonPM,
  goal_dh,
  channel_grouping_dh

   FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_cs_targets_and_budgets_enriched`
