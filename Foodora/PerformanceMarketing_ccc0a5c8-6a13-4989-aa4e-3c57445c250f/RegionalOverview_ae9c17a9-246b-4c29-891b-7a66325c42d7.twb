            <column caption='Installs comparison delta (%)' datatype='real' default-format='*&quot;+&quot; #,##0.0%;&quot;-&quot; #,##0.0%;' name='[Acqs comparison delta (%) (copy)_671036368526286850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Acqs base (copy)_671036368526286848])/sum([Acqs compare (copy)_671036368526286849]) -1' />
            </column>
            <column caption='Actual Spend compare' datatype='real' default-format='c&quot;€&quot;#,##0,.0K;(&quot;€&quot;#,##0,.0K)' name='[Actual Spend (copy 2)_955889044652310530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] &gt;= [Parameters].[start_date_base (copy)_955889044658282504] AND [date] &lt;= [Parameters].[start_date_base (copy) (copy)_955889044658290697] THEN [cost] ELSE 0 END' />
