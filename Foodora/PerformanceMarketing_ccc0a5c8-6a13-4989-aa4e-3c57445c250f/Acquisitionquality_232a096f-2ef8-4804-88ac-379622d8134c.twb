  month_diff_daily,
  SUM(New_customers) AS New_customers,
  SUM(Orders) AS Orders,
  SUM(GMV) AS GMV,
    SUM(GPO) AS GPO,
  SUM(FLGPO) AS FLGPO,
  0 CAC_Spend
FROM `dhh---analytics-eu.bi_marketing.regional_eu_orders_cohort_M0_M11_new`
where aggregation_level = 'monthly'
and cohort_month << DATE_TRUNC(CURRENT_DATE(), MONTH)
GROUP BY all
),

CAC_cost as (
SELECT
 CASE country
    WHEN 'Taiwan' THEN 'FP_TW'
    WHEN 'Pakistan' THEN 'FP_PK'
    WHEN 'Turkey' THEN 'YS_TR'
    WHEN 'Malaysia' THEN 'FP_MY'
    WHEN 'Thailand' THEN 'FP_TH'
    WHEN 'Bangladesh' THEN 'FP_BD'
    WHEN 'Norway' THEN 'FO_NO'
    WHEN 'Hong Kong' THEN 'FP_HK'
    WHEN 'Laos' THEN 'FP_LA'
    WHEN 'Philippines' THEN 'FP_PH'
    WHEN 'Hungary' THEN 'NP_HU'
    WHEN 'Myanmar' THEN 'FP_MM'
    WHEN 'Czech Republic' THEN 'DJ_CZ'
    WHEN 'Austria' THEN 'MJM_AT'
    WHEN 'Finland' THEN 'PO_FI'
    WHEN 'Cambodia' THEN 'FP_KH'
    WHEN 'Sweden' THEN 'OP_SE'
    WHEN 'Singapore' THEN 'FP_SG'
    ELSE 'Unknown'
END as global_entity_id,
report_month AS cohort_month,
0 month_diff_daily, 0 nc, 0 orders, 0 gmv, 0 gpo, 0 flgpo,
 SUM(actual_value_eur) as CAC_Spend

FROM
  `dhh---analytics-eu.bi_marketing.pandora__marketing_mcr_report`
WHERE
  report_month >>= '2023-01-01'
  and report_month << DATE_TRUNC(CURRENT_DATE(), MONTH)
  AND account_group IN ('CAC')
  AND country IN (
    'Taiwan', 'Pakistan', 'Turkey', 'Malaysia', 'Thailand', 'Bangladesh', 
    'Norway', 'Hong Kong', 'Laos', 'Philippines', 'Hungary', 'Myanmar', 
    'Czech Republic', 'Austria', 'Finland', 'Cambodia', 'Sweden', 'Singapore'
)

  group by all
  having CAC_Spend >> 0

),

unioned as (
select * from base
union all
select * from cac_cost
)

 SELECT
  global_entity_id,
  cohort_month,
  month_diff_daily,
  SUM(New_customers) AS New_customers,
  SUM(Orders) AS Orders,
  SUM(GMV) AS GMV,
    SUM(GPO) AS GPO,
  SUM(FLGPO) AS FLGPO,
  sum(CAC_Spend) CAC_Spend from unioned

  group by all]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
