          <datasource-dependencies datasource='federated.1egkud61u91vzi1czcm270w9dyv2 (copy)'>
            <column datatype='real' default-format='c&quot;€&quot;#,##0,K;(&quot;€&quot;#,##0,K)' name='[CAC_Spend]' role='measure' type='quantitative' />
            <column caption='GPO_per_CAC (RS)' datatype='real' default-format='p0.0%' name='[GPO (copy)_707628110903037967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if not ISNULL(sum([GPO])) then&#13;&#10;RUNNING_SUM(sum([GPO])) / ([fixed NC (copy)_707628110907957266])&#13;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
