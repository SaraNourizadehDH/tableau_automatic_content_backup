              <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;sum(&#13;&#10;{ FIXED &#13;&#10;[cohort_month], [global_entity_id]:&#13;&#10;SUM([CAC_Spend])&#13;&#10;}&#13;&#10;)&#13;&#10;)'>
