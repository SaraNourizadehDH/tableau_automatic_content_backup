        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0irymi71mcambr13dga460mf42ao' name='Custom SQL Query' type='text'><![CDATA[SELECT
global_entity_id
,cohort_year
,cohort_month
,month_diff_daily month_diff
,incentive_type
,incentive_type_grouped
,os_name
,sum(New_customers) New_customers
,sum(retained_NC) retained_NC
,sum(Orders) Orders
,sum(GMV) GMV
,sum(GPO) GPO
,sum(FLGPO) FLGPO,
  IF(
    DATE_ADD(cohort_month, INTERVAL cast(month_diff_daily as int64) MONTH) << DATE_TRUNC(CURRENT_DATE(), MONTH), 
    TRUE, 
    FALSE
  ) AS cohort_closed
FROM 
`dhh---analytics-eu.bi_marketing.regional_eu_orders_cohort_M0_M11_new`
where aggregation_level = 'monthly'
and cohort_month << DATE_TRUNC(CURRENT_DATE(), MONTH)
group by all]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0irymi71mcambr13dga460mf42ao' name='Custom SQL Query' type='text'><![CDATA[SELECT
