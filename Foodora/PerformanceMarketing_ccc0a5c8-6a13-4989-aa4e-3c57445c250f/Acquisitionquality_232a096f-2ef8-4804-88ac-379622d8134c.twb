            </column>
            <column caption='GMV_3M (copy)' datatype='real' name='[GMV_3M (copy)_1025976329325326338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;sum(&#13;&#10;{ FIXED &#13;&#10;[cohort_month], [global_entity_id], [incentive_type], [incentive_type_grouped], [os_name]:&#13;&#10;IF DATEDIFF(&apos;month&apos;, MAX([cohort_month]), TODAY()) &gt;= 3 THEN&#13;&#10;    SUM(&#13;&#10;        IF [month_diff] &lt;= 2 THEN [GMV]&#13;&#10;        END&#13;&#10;    )&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END&#13;&#10;}&#13;&#10;)&#13;&#10;&#13;&#10;)'>
                <table-calc ordering-type='Rows' />
