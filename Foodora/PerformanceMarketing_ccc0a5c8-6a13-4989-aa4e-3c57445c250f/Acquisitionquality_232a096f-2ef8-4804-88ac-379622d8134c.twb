            <column caption='fixed NC' datatype='integer' name='[Calculation_707628110905339920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;sum(&#13;&#10;{ FIXED &#13;&#10;[cohort_month], [global_entity_id]:&#13;&#10;SUM([New_customers])&#13;&#10;}&#13;&#10;)&#13;&#10;)'>
