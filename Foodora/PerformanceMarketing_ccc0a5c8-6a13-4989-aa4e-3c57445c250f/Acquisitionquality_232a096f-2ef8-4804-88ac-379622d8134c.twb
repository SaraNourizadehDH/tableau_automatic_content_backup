      <column caption='fixed NC' datatype='integer' name='[Calculation_1819454268667342867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;sum(&#13;&#10;{ FIXED &#13;&#10;[cohort_month], [global_entity_id], [incentive_type], [incentive_type_grouped], [os_name]:&#13;&#10;SUM([New_customers])&#13;&#10;}&#13;&#10;)&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders_per_NC' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1819454268668182548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;sum([Orders]) &gt; 0&#13;&#10;then sum([Orders]) / ([Calculation_1819454268667342867])&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV_per_NC' datatype='real' name='[Calculation_1819454268668915733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;sum([GMV]) &gt; 0&#13;&#10;then sum([GMV]) / ([fixed NC (copy)_707628110848995330])&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NC_evol' datatype='real' default-format='p0.0%' name='[Calculation_1819454268684775469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([retained_NC])/[Calculation_1819454268667342867]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cohort Month (Hans)' datatype='string' datatype-customized='true' name='[Cohort Month (copy)_863846742457626625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([cohort_month])' />
      </column>
      <column caption='GMV_12M (copy)' datatype='real' name='[GMV_12M (copy)_1025976329325326337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(&#13;&#10;sum(&#13;&#10;{ FIXED &#13;&#10;[cohort_month], [global_entity_id], [incentive_type], [incentive_type_grouped], [os_name]:&#13;&#10;IF DATEDIFF(&apos;month&apos;, MAX([cohort_month]), TODAY()) &gt;= 12 THEN&#13;&#10;    SUM(&#13;&#10;        IF [month_diff] &lt;= 11 THEN [GMV]&#13;&#10;        END&#13;&#10;    )&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END&#13;&#10;}&#13;&#10;)&#13;&#10;&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
