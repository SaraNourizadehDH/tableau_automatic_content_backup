        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, MAX([cohort_month]), TODAY()) &gt;= 13 THEN&#13;&#10;    SUM(&#13;&#10;        IF [month_diff] &lt;= 11 THEN [GPO]&#13;&#10;        END&#13;&#10;    )&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
