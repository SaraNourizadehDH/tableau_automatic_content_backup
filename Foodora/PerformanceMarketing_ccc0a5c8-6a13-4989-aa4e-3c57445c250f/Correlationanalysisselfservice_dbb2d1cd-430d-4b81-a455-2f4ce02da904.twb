          <alias key='&quot;[federated.1vv0wqm14enmn51gzkkhj1s8fgwm].[usr:Calculation_325103648210067461:qk]&quot;' value='CVRa (app) (inst to acq)' />
          <alias key='&quot;[federated.1vv0wqm14enmn51gzkkhj1s8fgwm].[usr:Calculation_325103648210132998:qk]&quot;' value='CVRs (app) (click to signup)' />
        </aliases>
      </column>
      <column caption='CPM_PM' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[CPC_PM (copy)_970807215225597957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([cost])/ sum(&#13;&#10;if [PM_nonPM]= &apos;PM&apos; then [impressions] else 0 end )&#13;&#10;)*1000' />
      </column>
      <column caption='Dim_1' datatype='string' name='[Calculation_1018376522198396929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Dim2 (copy)_1018376522198290432 1]&#13;&#10;when &apos;Country&apos; then [global_entity_id]&#13;&#10;when &apos;OS&apos; then [os_name]&#13;&#10;when &apos;Date&apos; then str([Calculation_237283452574384130])&#13;&#10;when &apos;PM_nonPM&apos; then [PM_nonPM]&#13;&#10;when &apos;objective_dh&apos; then [objective_dh]&#13;&#10;when &apos;channel_grouping_dh&apos; then [channel_grouping_dh]&#13;&#10;when &apos;sub_channel_dh&apos; then [sub_channel_dh]&#13;&#10;end' />
      </column>
      <column caption='Dates' datatype='date' datatype-customized='true' name='[Calculation_237283452574384130]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(case [Parameters].[Parameter 1]&#13;&#10;when &apos;Daily&apos; then [Calculation_675539951979085824]&#13;&#10;when &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[Calculation_675539951979085824],&apos;monday&apos;)&#13;&#10;when &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[Calculation_675539951979085824])&#13;&#10;when &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[Calculation_675539951979085824])&#13;&#10;end)' />
      </column>
      <column caption='CTR_PM' datatype='real' default-format='p0.00%' name='[Calculation_325103648209666048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([clicks])/ sum(&#13;&#10;if [PM_nonPM]= &apos;PM&apos; then [impressions] else 0 end )' />
      </column>
      <column caption='CPC_PM' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Calculation_325103648209723393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(cost)/ sum(&#13;&#10;if [PM_nonPM]= &apos;PM&apos; then [clicks] else 0 end )' />
      </column>
      <column caption='CPI' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_325103648209801218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [cost] ELSE 0 END&#13;&#10;) / SUM([installs])' />
      </column>
      <column caption='CPA' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_325103648209874947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(cost)/sum([acquisitions])' />
      </column>
      <column caption='CVRi (click to inst)' datatype='real' default-format='p0.00%' name='[Calculation_325103648209932292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([installs])/sum(IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [clicks] else 0 end)' />
      </column>
      <column caption='CVRa (inst to acq)' datatype='real' default-format='p0.00%' name='[Calculation_325103648210067461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos; THEN [acquisitions] else 0 end)/sum([installs])' />
