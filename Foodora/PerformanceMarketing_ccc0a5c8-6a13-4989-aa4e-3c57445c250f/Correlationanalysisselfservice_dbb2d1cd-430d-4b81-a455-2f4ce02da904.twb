      <datasource-dependencies datasource='Parameters'>
        <column caption='Dim2' datatype='string' name='[Dim1 (copy)_2013390550732832768]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
