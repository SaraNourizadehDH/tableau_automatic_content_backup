              <calculation class='tableau' formula='CASE [Parameters].[sessions_dashboard_v2 Parameter]&#10;WHEN &quot;MTD&quot; THEN&#10;    DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART(&apos;day&apos;, [Calculation_5565463992169439233])&#10;WHEN &quot;WTD&quot; THEN&#10;    [Calculation_5565463992171180034] &lt;= DATEPART(&apos;weekday&apos;, [Calculation_5565463992169439233], &apos;monday&apos;)&#10;&#10;WHEN &quot;None&quot; THEN TRUE&#10;ELSE FALSE&#10;END' />
