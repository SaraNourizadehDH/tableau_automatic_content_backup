            </zone>
            <zone h='89500' id='14' type-v2='layout-basic' w='98666' x='667' y='9700'>
              <zone h='89500' id='3' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='98666' x='667' y='9700'>
                <zone fixed-size='45' forceUpdate='true' h='89500' id='19' is-fixed='true' type-v2='text' w='98666' x='667' y='9700'>
                  <formatted-text>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#b239a4' fontsize='12'>Session Metrics:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Total Sessions:</run>
                    <run fontcolor='#000000' fontsize='10'> The total count of unique sessions to the platform.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>NC - New Sessions:</run>
                    <run fontcolor='#000000' fontsize='10'> The number of unique sessions from users who are visiting the platform for the very first time.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>NC - Returning Sessions:</run>
                    <run fontcolor='#000000' fontsize='10'> The number of unique sessions from users who are new customers but have visited the platform more than once.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>EC - Returning Sessions:</run>
                    <run fontcolor='#000000' fontsize='10'> The number of unique sessions from users who are already existing customers and are returning to the platform.</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#b239a4' fontsize='12'>Conversion Metrics:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Total Conversions:</run>
                    <run fontcolor='#000000' fontsize='10'> The total number of unique sessions that resulted in a completed order.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>NC - Conversions:</run>
                    <run fontcolor='#000000' fontsize='10'> The number of unique sessions from new customers that resulted in a completed order.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>EC - Conversions:</run>
                    <run fontcolor='#000000' fontsize='10'> The number of unique sessions from existing customers that resulted in a completed order or desired action.</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#b239a4' fontsize='12'>CVR Metrics:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Total CVR:</run>
                    <run fontcolor='#000000' fontsize='10'> Total Conversions / Total Sessions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>NC - New Sessions - CVR:</run>
                    <run fontcolor='#000000' fontsize='10'> Conversions from NC New Sessions / NC - New Sessions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>NC - Returning Sessions - CVR:</run>
                    <run fontcolor='#000000' fontsize='10'> Conversions from NC Returning Sessions / NC - Returning Sessions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>EC - Returning Sessions - CVR:</run>
                    <run fontcolor='#000000' fontsize='10'> Conversions from EC Returning Sessions / EC - Returning Sessions </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
