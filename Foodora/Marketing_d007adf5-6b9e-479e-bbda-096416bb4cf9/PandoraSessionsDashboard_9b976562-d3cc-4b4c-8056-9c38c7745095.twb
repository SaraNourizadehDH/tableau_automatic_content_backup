      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b8209d' fontsize='14'>Pandora Marketing Analytics</run>
            <run bold='true' fontsize='14'>  Sessions </run>
            <run fontsize='14' italic='true'><![CDATA[- <Sheet Name>                                                                                                                                                   ]]></run>
            <run fontcolor='#b8209d' fontsize='10' italic='true'>#pd-data-marketing</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/SessionsDashboardWIP/Weekly?rev=' id='Weekly' path='/t/Foodora/workbooks/SessionsDashboardWIP' revision='' site='Foodora' />
      <style />
      <size maxheight='1000' maxwidth='1200' minheight='1000' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='marketing__sessions_dashboard_table' name='federated.0eosalg040ovx112b4p4h0uw97ew' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Platform / Channel Parameter' datatype='string' name='[Channel Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Platform&quot;'>
          <calculation class='tableau' formula='&quot;Platform&quot;' />
          <members>
            <member value='&quot;Platform&quot;' />
            <member value='&quot;Channel&quot;' />
          </members>
        </column>
        <column caption='MTD/WTD' datatype='string' name='[sessions_dashboard_v2 Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
          <calculation class='tableau' formula='&quot;None&quot;' />
          <members>
            <member value='&quot;None&quot;' />
            <member value='&quot;MTD&quot;' />
            <member value='&quot;WTD&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0eosalg040ovx112b4p4h0uw97ew'>
        <column caption='Report Week (Monday)' datatype='datetime' default-format='*&quot;Wk start &quot;d-mmm-yy' name='[Calculation_5565463992162189312]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATEADD(&apos;day&apos;, - (DATEPART(&apos;weekday&apos;, [report_date]) + 5) % 7, [report_date])' />
