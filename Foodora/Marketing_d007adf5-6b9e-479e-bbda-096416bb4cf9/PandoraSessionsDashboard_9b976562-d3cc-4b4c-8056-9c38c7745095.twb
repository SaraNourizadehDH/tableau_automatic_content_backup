      <column caption='MTD/WTD Filter' datatype='boolean' name='[Calculation_1084311986337849344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[sessions_dashboard_v2 Parameter]&#10;WHEN &quot;MTD&quot; THEN&#10;    DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART(&apos;day&apos;, [Calculation_5565463992169439233])&#10;WHEN &quot;WTD&quot; THEN&#10;    [Calculation_5565463992171180034] &lt;= DATEPART(&apos;weekday&apos;, [Calculation_5565463992169439233], &apos;monday&apos;)&#10;&#10;WHEN &quot;None&quot; THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Calculation_1084311986349604867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] = [Parameters].[MTD/WTD (copy)] OR&#10;[report_month] = [Parameters].[Comparison Month-Year 1 (copy)_1084311986349346817] //OR&#10;&#10;//[Report Month (Sessions Dashboard V2)] = [Comparison Week-Year 1] OR&#10;//[Report Month (Sessions Dashboard V2)] = [Comparison Week-Year 2]' />
      </column>
      <column caption='NC - New Sessions - CVR' datatype='real' default-format='p0.00%' name='[Calculation_2259962650897334272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nc_new_sessions_conversions])/SUM([nc_new_sessions])' />
      </column>
      <column caption='Total CVR' datatype='real' default-format='p0.00%' name='[Calculation_2259962650898616323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_conversions])/SUM([total_sessions])' />
      </column>
      <column caption='Pandora' datatype='string' name='[Calculation_2259962650898882565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Pandora&quot;' />
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_2259962650912530444]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;All &quot; + [Parameters].[Channel Parameter]+&quot;s&quot;' />
      </column>
      <column caption='Comparison Header' datatype='string' name='[Calculation_4425279222789619714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;, [Parameters].[MTD/WTD (copy)]), 3) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [Parameters].[MTD/WTD (copy)])) &#10;+ &quot; vs &quot; +&#10;LEFT(DATENAME(&apos;month&apos;, [Parameters].[Comparison Month-Year 1 (copy)_1084311986349346817]), 3) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, [Parameters].[Comparison Month-Year 1 (copy)_1084311986349346817]))' />
      </column>
      <column caption='Platform /  Channel' datatype='string' name='[Calculation_4425279224521625611]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Channel Parameter]&#10;    WHEN &quot;Platform&quot; THEN [platform]&#10;    WHEN &quot;Channel&quot; THEN [channel]&#10;END' />
      </column>
      <column caption='Report Week (Monday)' datatype='datetime' default-format='*&quot;Wk start &quot;d-mmm-yy' name='[Calculation_5565463992162189312]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, - (DATEPART(&apos;weekday&apos;, [report_date]) + 5) % 7, [report_date])' />
