            <column caption='Period' datatype='date' name='[period]' role='dimension' type='ordinal' />
            <column caption='Sent' datatype='integer' name='[sent]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4965711232329523202]' derivation='User' name='[usr:Calculation_4965711232329523202:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
