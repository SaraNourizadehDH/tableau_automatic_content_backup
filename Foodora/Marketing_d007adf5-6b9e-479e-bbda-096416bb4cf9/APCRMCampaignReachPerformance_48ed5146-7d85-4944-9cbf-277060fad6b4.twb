    <worksheet name='Channel Click'>
      <table>
        <view>
          <datasources>
            <datasource caption='Comms Performance' name='federated.0g8efd205rmlga116714f0sb5h7x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Global Entity ID' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Channel' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;ALL&quot;'>
              <calculation class='tableau' formula='&quot;ALL&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ry0qng00y6x9n17qbami0zy6kjd].[partition_date_local]' caption='Start Date' datatype='date' name='[Parameter 8]' param-domain-type='range' role='measure' type='quantitative' value='#2023-11-01#'>
              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
            <column caption='Comms Type' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Manual Ad-hoc&quot;'>
              <calculation class='tableau' formula='&quot;Manual Ad-hoc&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.1ry0qng00y6x9n17qbami0zy6kjd].[partition_date_local]' caption='End Date' datatype='date' name='[Start Date (copy)_4181451572938870784]' param-domain-type='range' role='measure' type='quantitative' value='#2024-02-29#'>
              <calculation class='tableau' formula='#2024-02-29#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g8efd205rmlga116714f0sb5h7x'>
            <column caption='Received Month' datatype='datetime' default-format='*mmm yy' name='[Calculation_3380303377565540352]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [period])' />
            </column>
            <column caption='Channel Type Filter' datatype='boolean' name='[Calculation_3380303378502160386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 3]=&quot;ALL&quot;, TRUE, UPPER([Parameters].[Parameter 3]) = UPPER([channel_type]))' />
            </column>
            <column caption='Data Source Filter' datatype='boolean' name='[Calculation_3380303378503647236]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;    WHEN &quot;Manual Ad-hoc&quot; THEN [data_source] = &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;Automation&quot; THEN [data_source] != &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;All&quot; THEN TRUE&#10;END' />
            </column>
            <column caption='Channel Date Filter' datatype='boolean' name='[Calculation_495677501994967042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[period] &gt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, [Parameters].[Start Date (copy)_4181451572938870784], [Parameters].[Parameter 8]), [Parameters].[Parameter 8]-1) AND [period] &lt;= [Parameters].[Start Date (copy)_4181451572938870784]' />
            </column>
            <column caption='Sends / Impressions' datatype='integer' name='[Calculation_495677501995806724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784],&#10;IF [channel_type] != &quot;IAM&quot; THEN [sent]&#10;ELSE [impression]&#10;END,&#10;0&#10;)' />
            </column>
            <column aggregation='Sum' caption='Period diff' datatype='integer' name='[Calculation_495677501996670983]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Start Date (copy)_4181451572938870784], [Parameters].[Parameter 8])' />
            </column>
            <column caption='Delivered Count' datatype='integer' name='[Calculation_495677502000402443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784],&#10;IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;SMS&quot;) AND [delivered] &gt; 0 THEN [delivered]&#10;ELSEIF [channel_type] = &quot;PUSH&quot; THEN [sent] - [bounce]&#10;ELSEIF [channel_type] != &quot;IAM&quot; THEN [delivered]&#10;END,&#10;0)' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_5263300615922900992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='Clicked Count Last Period' datatype='integer' name='[Delivered Count Last Period (copy)_495677502052556833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= DATEADD(&apos;day&apos;, [Calculation_495677501996670983], [Parameters].[Parameter 8]-1) AND [Calculation_3380303377565540352] &lt;= [Parameters].[Parameter 8]-1,&#10;IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;IAM&quot;) THEN [clicked]&#10;END,&#10;0)' />
            </column>
            <column caption='Clicked Count diff %' datatype='real' name='[Delivered Count diff % (copy)_495677502052921379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Opened Count (copy)_495677502051938335])-SUM([Delivered Count Last Period (copy)_495677502052556833]))/SUM([Delivered Count Last Period (copy)_495677502052556833])' />
            </column>
            <column caption='Negative clicked count diff' datatype='string' name='[Negative opened count diff (copy)_495677502052778018]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Delivered Count diff % (copy)_495677502052921379] &lt; 0 THEN &quot;▼&quot; + &quot; &quot; + STR(IIF(ABS([Delivered Count diff % (copy)_495677502052921379]) &lt; 0.01, ROUND([Delivered Count diff % (copy)_495677502052921379]*-100,1), ROUND([Delivered Count diff % (copy)_495677502052921379]*-100))) + &quot;%&quot; END' />
            </column>
            <column caption='Click Rate' datatype='real' name='[Open Rate (copy)_495677502052036640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Opened Count (copy)_495677502051938335])/SUM(IIF([channel_type]!=&quot;IAM&quot;, [Calculation_495677502000402443], [Calculation_495677501995806724]))' />
            </column>
            <column caption='Clicked Count' datatype='integer' name='[Opened Count (copy)_495677502051938335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784],&#10;IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;IAM&quot;) THEN [clicked]&#10;END,&#10;0)' />
            </column>
            <column caption='Positive clicked count diff' datatype='string' name='[Positive opened count diff (copy)_495677502053077028]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Delivered Count diff % (copy)_495677502052921379] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(IIF(ABS([Delivered Count diff % (copy)_495677502052921379]) &lt; 0.01, ROUND([Delivered Count diff % (copy)_495677502052921379]*100,1), ROUND([Delivered Count diff % (copy)_495677502052921379]*100))) + &quot;%&quot; END' />
            </column>
            <column caption='Bounce' datatype='integer' name='[bounce]' role='measure' type='quantitative' />
            <column caption='Channel' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
            <column caption='Clicked' datatype='integer' name='[clicked]' role='measure' type='quantitative' />
            <column caption='Comms Sub-category' datatype='string' name='[comms_sub_category]' role='dimension' type='nominal' />
            <column caption='Data Source' datatype='string' name='[data_source]' role='dimension' type='nominal' />
            <column caption='Delivered' datatype='integer' name='[delivered]' role='measure' type='quantitative' />
