    <worksheet name='Overall Subscription (3)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Push and Email</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='crm_reachability (pandata_ap_mktg)' name='federated.1o46not047zl3118dsy9c0d5id3o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Global Entity ID' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Exclude Prospect NA' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Relative Period' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 6 months&quot;'>
              <calculation class='tableau' formula='&quot;Last 6 months&quot;' />
            </column>
            <column alias='ACID' caption='Customer Granularity' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;analytical_customer_id&quot;'>
              <calculation class='tableau' formula='&quot;analytical_customer_id&quot;' />
              <aliases>
                <alias key='&quot;analytical_customer_id&quot;' value='ACID' />
                <alias key='&quot;customer_uuid&quot;' value='Customer ID' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o46not047zl3118dsy9c0d5id3o'>
            <column caption='% of user base' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF [Global Entity ID] = &quot;All&quot; THEN { FIXED [Report Date], [Subscription Group],  [Granularity]: SUM([Unique Customers]) } / { FIXED [Report Date],  [Granularity]: SUM([Unique Customers]) } &#10;//ELSE { FIXED [Report Date], [Subscription Group], [Global Entity Id], [Granularity]: SUM([Unique Customers]) } / { FIXED [Report Date], [Global Entity Id], [Granularity]: SUM([Unique Customers]) } &#10;//END&#10;SUM([unique_customers])/MAX([Calculation_6356690190105772038])' />
            </column>
            <column caption='Exclude Prospect NA' datatype='boolean' name='[Calculation_2509419837326163968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 2], [is_prospect_na], FALSE)' />
            </column>
            <column caption='Customer Level Filter' datatype='boolean' name='[Calculation_3252161920661180416]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity] = [Parameters].[Parameter 6]' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_4144226485591867392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC CRM User Filter]&#10;END' />
            </column>
            <column caption='Period' datatype='boolean' name='[Calculation_4239365021503381504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;This month to date&quot; THEN DATETRUNC(&apos;month&apos;,[partition_date]) == DATETRUNC(&apos;month&apos;,TODAY())&#10;    WHEN &quot;Last month&quot; THEN (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[partition_date]), DATETRUNC(&apos;month&apos;,TODAY())) == 1)&#10;    WHEN &quot;Last 3 months&quot; THEN (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[partition_date]), DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 3) // AND (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[Report Date]), DATETRUNC(&apos;month&apos;,TODAY())) &gt; 0)&#10;    WHEN &quot;Last 6 months&quot; THEN (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[partition_date]), DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 6) // AND (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[Report Date]), DATETRUNC(&apos;month&apos;,TODAY())) &gt; 0)&#10;ELSE TRUE&#10;END' />
            </column>
            <column caption='Country' datatype='boolean' name='[Calculation_4239365021575057410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='Total User' datatype='integer' name='[Calculation_6356690190105772038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;All&quot; THEN { FIXED [partition_date],  [granularity]: SUM(IIF([Parameters].[Parameter 2], IIF([is_prospect_na], 0, [unique_customers]), [unique_customers])) }&#10;ELSE { FIXED [partition_date], [global_entity_id], [granularity]: SUM(IIF([Parameters].[Parameter 2], IIF([is_prospect_na], 0, [unique_customers]), [unique_customers])) }&#10;END' />
            </column>
            <column caption='Unique Customers (copy)' datatype='integer' name='[Unique Customers (copy)_1791377156062404615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[unique_customers]' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column caption='Is Prospect Na' datatype='boolean' name='[is_prospect_na]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2509419837326163968]' derivation='None' name='[none:Calculation_2509419837326163968:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3252161920661180416]' derivation='None' name='[none:Calculation_3252161920661180416:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4144226485591867392]' derivation='None' name='[none:Calculation_4144226485591867392:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4239365021503381504]' derivation='None' name='[none:Calculation_4239365021503381504:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4239365021575057410]' derivation='None' name='[none:Calculation_4239365021575057410:nk]' pivot='key' type='nominal' />
            <column-instance column='[subscription_group]' derivation='None' name='[none:subscription_group:nk]' pivot='key' type='nominal' />
            <column caption='Report Date' datatype='date' name='[partition_date]' role='dimension' type='ordinal' />
