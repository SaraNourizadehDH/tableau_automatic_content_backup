      <column caption='Positive CTO diff' datatype='string' name='[Calculation_495677502054125608]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_495677502054051879] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation_495677502054051879]*100,2)) + &quot;%&quot; END' />
      </column>
      <column caption='Negative CTO diff' datatype='string' name='[Calculation_495677502054187049]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_495677502054051879] &lt; 0 THEN &quot;▼&quot; + &quot; &quot; + STR(ROUND([Calculation_495677502054051879]*-100,2)) + &quot;%&quot; END' />
      </column>
      <column caption='Email Unsub Count' datatype='integer' name='[Calculation_495677502054981675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784] AND [channel_type] = &quot;EMAIL&quot;,&#10;[unsubscribed],&#10;0)' />
      </column>
      <column caption='Email Unsub Last Period' datatype='integer' name='[Calculation_495677502055886892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= DATEADD(&apos;day&apos;, [Calculation_495677501996670983], [Parameters].[Parameter 8]-1) AND [Calculation_3380303377565540352] &lt;= [Parameters].[Parameter 8]-1,&#10;[unsubscribed],&#10;0)' />
      </column>
      <column caption='Email Unsub Rate' datatype='real' name='[Calculation_495677502058663984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_495677502054981675])/SUM([Calculation_495677502000402443])' />
      </column>
      <column caption='Channel Trend Date Filter' datatype='boolean' name='[Calculation_495677502059028529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784]' />
      </column>
      <column caption='Metric (Number)' datatype='integer' name='[Calculation_495677502059368498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Sends / Impressions&quot; THEN [Calculation_495677501995806724]&#10;    WHEN &quot;Deliveries&quot; THEN [Calculation_495677502000402443]&#10;    WHEN &quot;Bounces&quot; THEN [Calculation_495677502029975574]&#10;    WHEN &quot;Unique Opens&quot; THEN [Calculation_495677502032556057]&#10;    WHEN &quot;Unique Clicks&quot; THEN [Opened Count (copy)_495677502051938335]&#10;    WHEN &quot;Email Unsubscribes&quot; THEN [Calculation_495677502054981675]&#10;END' />
      </column>
      <column caption='Metric (Rate)' datatype='real' name='[Calculation_495677502060609588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &quot;Sends / Impressions&quot; THEN [Calculation_495677501996261381]&#10;    WHEN &quot;Deliveries&quot; THEN [Calculation_495677502000578572]&#10;    WHEN &quot;Bounces&quot; THEN [Calculation_495677502028214290]&#10;    WHEN &quot;Unique Opens&quot; THEN [Calculation_495677502032760859]&#10;    WHEN &quot;Unique Clicks&quot; THEN [Open Rate (copy)_495677502052036640]&#10;    WHEN &quot;Email Unsubscribes&quot; THEN [Calculation_495677502058663984]&#10;END' />
      </column>
      <column caption='Campaign Name ' datatype='string' name='[Calculation_4965711232326057984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(REGEXP_REPLACE(REGEXP_REPLACE([campaign_name], &quot;(?i)_iOS&quot;, &quot;_PUSH&quot;), &quot;(?i)_Android&quot;, &quot;_PUSH&quot;), [canvas_name])' />
      </column>
      <column caption='Exclude Campaign' datatype='boolean' name='[Calculation_4965711232327303169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(UPPER([campaign_name]), &quot;HISTORISE&quot;)&#10;OR CONTAINS(UPPER([campaign_name]), &quot;CORPORATE&quot;)&#10;OR (ISNULL([campaign_name]) AND ISNULL([canvas_name]))&#10;OR [Calculation_1926977716542296112] &lt; 10' />
      </column>
      <column caption='Top X' datatype='boolean' name='[Calculation_4965711232329523202]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= INT([Parameters].[Parameter 12])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country Filter' datatype='boolean' name='[Calculation_5263300615922900992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
      </column>
      <column caption='% Open' datatype='real' name='[Calculation_5354287402161917957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Bounce (Email, Push) (copy)_5354287402161713155])/SUM([Calculation_1926977716542296112])' />
      </column>
      <column caption='% Delivered' datatype='real' name='[Calculation_5354287402162126854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1926977716542296112])/SUM([Calculation_1926977716542115887])' />
      </column>
      <column caption='% CTO' datatype='real' name='[Calculation_5354287402162589704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Open (copy)_5354287402161836036])/SUM([Bounce (Email, Push) (copy)_5354287402161713155])' />
      </column>
      <column caption='TG AFV Eur' datatype='real' name='[Calculation_5354287402163691529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_eur])/SUM([orders])' />
      </column>
      <column caption='Email Unsub %' datatype='real' name='[Calculation_5354287402170220557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Unsubscribed (copy)_5354287402169880588])/SUM(IIF([channel_type] == &quot;EMAIL&quot;, [delivered], NULL))' />
      </column>
      <column caption='Variation' datatype='string' name='[Calculation_5354287402170654734]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(REGEXP_MATCH([variation_name], &quot;(?i)control|CG&quot;), &quot;CG&quot;, IIF([Parameters].[Parameter 10], IIF([canvas_name] == &quot;EAT_AUT_2304XX_AP_FP_EG_AbandonCartRestaurant_Behave-Vendor_MSG&quot;, REPLACE([variation_name], &quot;Variant 2&quot;, &quot;Old&quot;), [variation_name]), &quot;TG&quot;))' />
      </column>
      <column caption='pro Sub Uplift %' datatype='real' name='[Calculation_5664965417103036418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro Sub Uplift (copy)_6700863678807085081]) / SUM([pro_converted])' />
      </column>
      <column caption='Metric 1 is NOT NULL' datatype='boolean' name='[Calculation_5890637978057838593]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Calculation_4103201485711745028])' />
      </column>
      <column caption='Budget Vertical' datatype='string' name='[Calculation_6488420479235371009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IIF(REGEXP_MATCH(SPLIT([Canvas Name], &quot;_&quot;, 1), &quot;^MIX|^EAT|^DMA|^LOC$&quot;), SPLIT([Canvas Name], &quot;_&quot;, 1), &quot;Others&quot;)&#10;&#10;IF CONTAINS(UPPER([canvas_name]), &quot;PANDAPAY&quot;) THEN &quot;Pandapay&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;PANDAGO&quot;) THEN &quot;Pandago&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;DINEIN&quot;) OR CONTAINS(UPPER([canvas_name]), &quot;DINE-IN&quot;) THEN &quot;Dine In&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;PANDAPRO&quot;) THEN &quot;Pandapro (PRO)&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;CORPORATE&quot;) THEN &quot;Corporate&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;KITCHEN&quot;) OR CONTAINS(UPPER([canvas_name]), &quot;CONCEPTS&quot;) OR CONTAINS(UPPER([canvas_name]), &quot;SKC&quot;) THEN &quot;Kitchens and Concepts (SKC)&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;LOYALTY&quot;) OR CONTAINS(UPPER([canvas_name]), &quot;GAMES&quot;) OR CONTAINS(UPPER([canvas_name]), &quot;CHALLENGE&quot;) THEN &quot;Loyalty/Games/Challenge&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;AAA&quot;) THEN &quot;AAA&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;PICKUP&quot;) THEN &quot;Restaurant / Food (PICKUP)&quot;&#10;ELSEIF REGEXP_MATCH(SPLIT([canvas_name], &quot;_&quot;, 1), &quot;^EAT&quot;) THEN &quot;Restaurant / Food (EAT)&quot;&#10;ELSEIF REGEXP_MATCH(SPLIT([canvas_name], &quot;_&quot;, 1), &quot;^DMA&quot;) THEN &quot;Darkstores / Dmarts (DMA)&quot;&#10;ELSEIF REGEXP_MATCH(SPLIT([canvas_name], &quot;_&quot;, 1), &quot;^LOC&quot;) THEN &quot;Local Shops (LOC)&quot;&#10;ELSEIF REGEXP_MATCH(SPLIT([canvas_name], &quot;_&quot;, 1), &quot;^QUI&quot;) THEN &quot;Quick Commerce (QUI)&quot;&#10;ELSEIF REGEXP_MATCH(SPLIT([canvas_name], &quot;_&quot;, 1), &quot;^MIX&quot;) THEN &quot;All Verticals (MIX)&quot;&#10;ELSEIF CONTAINS(UPPER([canvas_name]), &quot;COPY&quot;) THEN &quot;COPY&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='Breakdown by' datatype='string' name='[Calculation_6700863678768091137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &quot;Country&quot; THEN [global_entity_id]&#10;    WHEN &quot;Vertical&quot; THEN [vertical_type]&#10;    WHEN &quot;Channel Type&quot; THEN [channel_type]&#10;    WHEN &quot;Campaign Type&quot; THEN [campaign_type]&#10;END' />
      </column>
      <column caption='Comparison Filter' datatype='boolean' name='[Calculation_6700863678799720466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([is_adhoc_replacement], TRUE, [data_source] = &quot;CAMPAIGN PERFORMANCE&quot;)&#10;AND &#10;&#10;{ FIXED [global_entity_id], [vertical_type], [Calculation_3380303377565540352]: SUM(IIF([is_adhoc_replacement], [Calculation_1926977716542115887], 0))} &gt; 0' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_6700863678803517459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [vertical_type], [Calculation_3380303377565540352]: SUM(IIF([is_adhoc_replacement], [Calculation_1926977716542115887], 0))}' />
      </column>
      <column caption='Activation Uplift/&apos;000 comms' datatype='real' name='[Calculation_6700863678805942292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1000*SUM([conversion_uplift])/SUM([Calculation_1926977716542115887])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_6700863678809518106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([global_entity_id], &quot;_&quot;, 2)' />
      </column>
      <column caption='APAC or Local' datatype='string' name='[Calculation_6701919222209650690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(CONTAINS([canvas_name], &quot;AP_FP&quot;) OR CONTAINS([canvas_name], &quot;APAC_FP&quot;), &quot;APAC&quot;, &quot;Local&quot;)' />
      </column>
      <column caption='Engaged Orders % of Sent' datatype='real' default-format='p0.0%' name='[Calculation_7263813679672270866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IIF([channel_type] != &quot;IAM&quot;, [open_orders],&#10;[click_orders])&#10;)/&#10;SUM(IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;SMS&quot;) AND [delivered] &gt; 0 THEN [delivered]&#10;ELSEIF [channel_type] = &quot;PUSH&quot; THEN [sent] - [bounce]&#10;ELSEIF [channel_type] = &quot;IAM&quot; THEN [impression]&#10;END)' />
      </column>
      <column caption='Exclude Rows' datatype='boolean' name='[Calculation_727190636294778880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//NOT REGEXP_MATCH([Canvas Name], &quot;(?i)EMAIL|PUSH|IOS|ANDROID|IAM&quot;) AND [Channel Type] = &quot;EMAIL&quot; AND &#10;[Canvas Step Name (copy)_149744695816216576] = &quot;CG&quot;&#10;&#10;OR IIF(&#10;[canvas_name] = &quot;MIX_AUT_2303XX_APAC_FP_EG_NonPro_MissedSavings_NoVoucher_MSG&quot;,&#10;[Calculation_6700863678809518106] != LEFT([canvas_step_name], 2),&#10;FALSE&#10;)' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_737253357848559616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 11]&#10;&#9;WHEN &quot;Orders Uplift / &apos;000 sends&quot; THEN [Net GMV Uplift/&apos;000 comms (copy)_6700863678806855704]&#10;    WHEN &quot;Sends&quot; THEN SUM([Calculation_1926977716542115887])&#10;    WHEN &quot;Orders Uplift&quot; THEN SUM([orders_uplift])&#10;    WHEN &quot;GMV Uplift&quot; THEN SUM([gmv_eur_uplift])&#10;END' />
      </column>
      <column caption='Act. Stats Sig (1 = Sig, 0 = Not)' datatype='integer' name='[Calculation_7588495006860320768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(ABS(([Calculation_3078210381256548385]-[Calculation_7588495006860677121])/&#10;SQRT(&#10;// TG SE^2  + CG SE^2&#10;([Calculation_3078210381256548385]*(1-[Calculation_3078210381256548385])/SUM([Calculation_4615767440638775296]))&#10;+&#10;([Calculation_7588495006860677121]*(1-[Calculation_7588495006860677121])/SUM([size_of_control_group]))&#10;)) &gt; 1.96, 1, 0)' />
      </column>
      <column caption='CG Activation Rate' datatype='real' name='[Calculation_7588495006860677121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted_cg]) / SUM([size_of_control_group])' />
      </column>
      <column caption='Country Breakdown' datatype='string' name='[Calculation_7723743738543067136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1 2]==&quot;APAC&quot;, &quot;APAC&quot;, SPLIT([global_entity_id], &quot;_&quot;, 2))' />
      </column>
      <column caption='Sessions Uplift %' datatype='real' name='[Calculation_7802134519957790720]' role='measure' type='quantitative'>
