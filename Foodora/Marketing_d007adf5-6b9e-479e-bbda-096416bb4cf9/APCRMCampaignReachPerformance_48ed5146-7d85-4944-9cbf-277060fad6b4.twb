      <column caption='User Filter' datatype='boolean' name='[Calculation_4144226485592309762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC CRM Filter]&#10;END' />
      </column>
      <column caption='Country Filter' datatype='boolean' name='[Calculation_4655244334582235136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
      </column>
      <column caption='Period Filter' datatype='boolean' name='[Calculation_4655244334582366209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;This month to date&quot; THEN DATETRUNC(&apos;month&apos;,[activity_month]) == DATETRUNC(&apos;month&apos;,TODAY())&#10;    WHEN &quot;Last month&quot; THEN (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[activity_month]), DATETRUNC(&apos;month&apos;,TODAY())) == 1)&#10;    WHEN &quot;Last 3 months&quot; THEN (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[activity_month]), DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 3) //AND (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[Activity Month]), DATETRUNC(&apos;month&apos;,TODAY())) &gt; 0)&#10;    WHEN &quot;Last 6 months&quot; THEN (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[activity_month]), DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 6) //AND (DATEDIFF(&quot;month&quot;, DATETRUNC(&apos;month&apos;,[Activity Month]), DATETRUNC(&apos;month&apos;,TODAY())) &gt; 0)&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='- Uninstalls' datatype='integer' name='[Uninstalls (copy)_4655244334583156738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[uninstalls]' />
      </column>
