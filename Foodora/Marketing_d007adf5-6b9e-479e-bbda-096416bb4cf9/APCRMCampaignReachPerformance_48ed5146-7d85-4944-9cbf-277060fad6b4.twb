    <worksheet name='IAM Handbook Performance'>
      <table>
        <view>
          <datasources>
            <datasource caption='IAM Handbook' name='federated.1t4kv7714nqx7f112zgq60src3ii' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Global Entity ID' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1t4kv7714nqx7f112zgq60src3ii'>
            <column caption='TG Activation Rate' datatype='real' default-format='p0.0%' name='[CTR % (copy)_3656359992777605122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted])/SUM([impression])' />
            </column>
            <column caption='Orders Uplift %' datatype='real' default-format='p0.0%' name='[CTR % (copy)_3656359992778199044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_uplift])/SUM([total_orders_treatment])' />
            </column>
            <column caption='GEID Filter' datatype='boolean' name='[Calculation_3656359992776396800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='CTR %' datatype='real' default-format='p0.0%' name='[Calculation_3656359992777170945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked])/SUM([impression])' />
            </column>
            <column caption='TG AFV Eur' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3656359993050447880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gfv_eur_treatment])/SUM([total_orders_treatment])' />
            </column>
            <column caption='Act. Stats Sig (1 = Sig, 0 = Not)' datatype='integer' name='[Calculation_3656359993050910729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ABS(([CTR % (copy)_3656359992777605122]-[TG Activation Rate (copy)_3656359992777793539])/&#10;SQRT(&#10;// TG SE^2  + CG SE^2&#10;([CTR % (copy)_3656359992777605122]*(1-[CTR % (copy)_3656359992777605122])/SUM([impression]))&#10;+&#10;([TG Activation Rate (copy)_3656359992777793539]*(1-[TG Activation Rate (copy)_3656359992777793539])/SUM([size_of_control_group]))&#10;)) &gt; 1.96, 1, 0)' />
            </column>
            <column caption='Orders Stats Sig' datatype='integer' name='[Calculation_3656359993052692490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// (\bar{x1} - \bar{x2}) / sqrt (s^2 (1/n1 + 1/n2))&#10;IIF(ABS(([total_orders_treatment]/[impression] - [total_orders_control]/[size_of_control_group])/&#10;SQRT([variance_total_orders_treatment]/[impression] + [variance_total_orders_control]/[size_of_control_group])) &gt; 1.96,&#10;1, 0)' />
            </column>
            <column caption='Pro CVR Uplift' datatype='real' name='[Calculation_3656359993058537483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ATTR([vertical_type]) = &quot;Pandapro (PRO)&quot;,&#10;SUM([pro_converted]) - SUM([pro_converted_cg]) * SUM([impression]) / SUM([size_of_control_group]),&#10;NULL)' />
            </column>
            <column caption='Net GMV Uplift %' datatype='real' default-format='p0.0%' name='[GMV Uplift % (copy)_3656359993049063430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_net_eur_uplift])/SUM([total_gmv_eur_treatment])' />
            </column>
            <column caption='GMV Uplift %' datatype='real' default-format='p0.0%' name='[Orders Uplift % (copy)_3656359993048993797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_uplift])/SUM([total_gross_gmv_eur_treatment])' />
            </column>
            <column caption='Activation  Uplift %' datatype='real' default-format='p0.0%' name='[Orders Uplift % (copy)_3656359993049464839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversion_uplift])/SUM([converted])' />
            </column>
            <column caption='Pro CVR Uplift %' datatype='real' default-format='p0.0%' name='[Orders Uplift % (copy)_3656359993059733516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3656359993058537483]/SUM([pro_converted])' />
            </column>
            <column caption='CG Activation Rate' datatype='real' default-format='p0.0%' name='[TG Activation Rate (copy)_3656359992777793539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_cg])/SUM([size_of_control_group])' />
            </column>
