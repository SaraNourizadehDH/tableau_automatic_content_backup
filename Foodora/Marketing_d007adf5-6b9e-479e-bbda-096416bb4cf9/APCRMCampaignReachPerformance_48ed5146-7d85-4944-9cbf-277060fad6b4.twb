            </column>
            <column caption='Channel Type Filter' datatype='boolean' name='[Calculation_3380303378502160386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 3]=&quot;ALL&quot;, TRUE, UPPER([Parameters].[Parameter 3]) = UPPER([channel_type]))' />
            </column>
            <column caption='Data Source Filter' datatype='boolean' name='[Calculation_3380303378503647236]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;    WHEN &quot;Manual Ad-hoc&quot; THEN [data_source] = &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;Automation&quot; THEN [data_source] != &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;All&quot; THEN TRUE&#10;END' />
            </column>
            <column caption='Channel Date Filter' datatype='boolean' name='[Calculation_495677501994967042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[period] &gt;= DATEADD(&apos;day&apos;, DATEDIFF(&apos;day&apos;, [Parameters].[Start Date (copy)_4181451572938870784], [Parameters].[Parameter 8]), [Parameters].[Parameter 8]-1) AND [period] &lt;= [Parameters].[Start Date (copy)_4181451572938870784]' />
            </column>
            <column caption='Sends / Impressions' datatype='integer' name='[Calculation_495677501995806724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784],&#10;IF [channel_type] != &quot;IAM&quot; THEN [sent]&#10;ELSE [impression]&#10;END,&#10;0&#10;)' />
            </column>
            <column caption='Average per Day' datatype='real' name='[Calculation_495677501996261381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_495677501995806724])/COUNTD(IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784],&#10;[Calculation_3380303377565540352],NULL))' />
            </column>
            <column caption='Sends/Impression Last Period' datatype='integer' name='[Calculation_495677501996486662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= DATEADD(&apos;day&apos;, [Calculation_495677501996670983], [Parameters].[Parameter 8]-1) AND [Calculation_3380303377565540352] &lt;= [Parameters].[Parameter 8]-1,&#10;IF [channel_type] != &quot;IAM&quot; THEN [sent]&#10;ELSE [impression]&#10;END,&#10;0)' />
            </column>
            <column aggregation='Sum' caption='Period diff' datatype='integer' name='[Calculation_495677501996670983]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Start Date (copy)_4181451572938870784], [Parameters].[Parameter 8])' />
            </column>
            <column caption='Sends/Impression diff %' datatype='real' name='[Calculation_495677501997010952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_495677501995806724])-SUM([Calculation_495677501996486662]))/SUM([Calculation_495677501996486662])' />
            </column>
            <column caption='Positive sends/impression diff' datatype='string' name='[Calculation_495677501997694985]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_495677501997010952] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(IIF(ABS([Calculation_495677501997010952]) &lt; 0.01, ROUND([Calculation_495677501997010952]*100,1), ROUND([Calculation_495677501997010952]*100))) + &quot;%&quot; END' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_5263300615922900992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
