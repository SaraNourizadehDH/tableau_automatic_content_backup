        <calculation class='tableau' formula='SUM({ FIXED [canvas_name], [country], [Calculation_3380303377565540352], [channel_type]:&#10;MAX(&#10;IIF(&#10;NOT REGEXP_MATCH([canvas_name], &quot;(?i)EMAIL|PUSH|IOS|ANDROID|IAM&quot;) AND [channel_type] = &quot;EMAIL&quot;,&#10;{ FIXED [canvas_name], [country], [Calculation_3380303377565540352]: &#10;&#10;SUM(IIF(&#10;(CONTAINS(LOWER([variation_name]), &quot;control&quot;) OR CONTAINS(LOWER([canvas_step_name]), &quot;control&quot;)) AND [channel_type] = &quot;EMAIL&quot; AND [Canvas Step Name (copy)_149744695816216576] = &quot;CG&quot;, &#10;[total_gross_gmv_eur_control], 0)&#10;) },&#10;&#10;{ FIXED [canvas_name], [country], [Calculation_3380303377565540352]: &#10;&#10;SUM(IIF(&#10;(CONTAINS(LOWER([variation_name]), &quot;control&quot;) OR CONTAINS(LOWER([canvas_step_name]), &quot;control&quot;)) AND NOT (NOT REGEXP_MATCH([canvas_name], &quot;(?i)EMAIL|PUSH|IOS|ANDROID|IAM&quot;) AND [channel_type] = &quot;EMAIL&quot;), &#10;[total_gross_gmv_eur_control], 0)&#10;) }&#10;))})' />
      </column>
