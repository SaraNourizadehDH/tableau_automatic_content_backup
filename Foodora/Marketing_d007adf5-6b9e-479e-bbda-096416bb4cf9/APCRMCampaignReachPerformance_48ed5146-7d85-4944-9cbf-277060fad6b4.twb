              <calculation class='tableau' formula='false' />
            </column>
            <column alias='Sends' caption='Metric 1' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;Send&quot;'>
              <calculation class='tableau' formula='&quot;Send&quot;' />
              <aliases>
                <alias key='&quot;\# campaign&quot;' value='Campaign Count' />
                <alias key='&quot;Click Orders&quot;' value='Click To Orders' />
                <alias key='&quot;Open Orders&quot;' value='Open To Orders' />
                <alias key='&quot;Send&quot;' value='Sends' />
              </aliases>
            </column>
            <column alias='% Activation Uplift' caption='Metric 2' datatype='string' name='[Parameter 15]' param-domain-type='list' role='measure' type='nominal' value='&quot;Activation Uplift \%&quot;'>
              <calculation class='tableau' formula='&quot;Activation Uplift %&quot;' />
              <aliases>
                <alias key='&quot;Activation Uplift \%&quot;' value='% Activation Uplift' />
                <alias key='&quot;Engaged Orders \% of Sent&quot;' value='% Engaged Orders' />
                <alias key='&quot;GMV Uplift \%&quot;' value='% GMV Uplift' />
                <alias key='&quot;Orders Uplift \%&quot;' value='% Order Uplift' />
              </aliases>
            </column>
            <column caption='Global Entity ID' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g8efd205rmlga116714f0sb5h7x'>
            <column caption='Activation Uplift %' datatype='real' name='[Calculation_149744695820120077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversion_uplift])/SUM([converted])' />
            </column>
            <column caption='Orders Uplift %' datatype='real' name='[Calculation_149744695820804110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_uplift]) / SUM([orders])' />
            </column>
            <column caption='GMV Uplift %' datatype='real' name='[Calculation_149744695821029391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_uplift]) / SUM([gmv_eur])' />
            </column>
            <column caption='Is CRM Automation' datatype='boolean' name='[Calculation_149744695937740818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(REGEXP_MATCH([canvas_name], &quot;(?i)_Auto|Abandon|-AUTO|Recurring|ARO|Probot&quot;) OR [is_adhoc_replacement] OR not [comms_sub_category] IN (&quot;&quot;, &quot;Others&quot;), TRUE, FALSE)' />
            </column>
            <column caption='Send' datatype='integer' name='[Calculation_1926977716542115887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] != &quot;IAM&quot;, [sent], [impression])' />
            </column>
            <column caption='Delivery' datatype='integer' name='[Calculation_1926977716542296112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel_type] &#10;    WHEN &quot;EMAIL&quot; THEN [delivered]&#10;    WHEN &quot;PUSH&quot; THEN [sent] - [bounce]&#10;END' />
            </column>
            <column caption='TG Activation Rate' datatype='real' name='[Calculation_3078210381256548385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted])/SUM(&#10;&#9;CASE [channel_type] &#10;    &#9;WHEN &quot;IAM&quot; THEN [Impression (copy)_5354287402161250305]&#10;        WHEN &quot;VIBER&quot; THEN [Calculation_1926977716542115887]&#10;        ELSE [Calculation_1926977716542296112]&#10;    END&#10;    //IIF([Channel] != &quot;IAM&quot;, [Delivery], [Impression (IAM)])&#10;)' />
            </column>
            <column caption='Received Month' datatype='datetime' default-format='*mmm yy' name='[Calculation_3380303377565540352]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [period])' />
            </column>
            <column caption='# campaign' datatype='integer' name='[Calculation_3380303378507132933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(REGEXP_REPLACE(IFNULL([campaign_name], [canvas_name]), &quot;(?i)_ios|_android&quot;, &quot;_PUSH&quot;))' />
            </column>
            <column caption='Engaged / &apos;000 comms' datatype='real' name='[Calculation_4103201485708734464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000*SUM([Calculation_4103201485709094913])/SUM([Calculation_1926977716542115887])' />
            </column>
            <column caption='Engaged' datatype='integer' name='[Calculation_4103201485709094913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] != &quot;IAM&quot;, [open_orders],&#10;[click_orders])' />
            </column>
            <column caption='Metric 1' datatype='real' name='[Calculation_4103201485711745028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 14] &#10;WHEN &quot;Click Orders&quot; THEN SUM([click_orders])&#10;WHEN &quot;Open Orders&quot; THEN SUM([open_orders])&#10;WHEN &quot;Send&quot; THEN SUM([Calculation_1926977716542115887])&#10;WHEN &quot;# campaign&quot; THEN [Calculation_3380303378507132933]&#10;WHEN &quot;Engaged / &apos;000 comms&quot; THEN [Calculation_4103201485708734464]&#10;END' />
            </column>
            <column caption='Metric 2' datatype='real' name='[Calculation_4103201485711945733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 15]&#10;WHEN &quot;Engaged Orders % of Sent&quot; THEN [Calculation_7263813679672270866]&#10;WHEN &quot;Activation Uplift %&quot; THEN [Calculation_149744695820120077]&#10;WHEN &quot;Orders Uplift %&quot; THEN [Calculation_149744695820804110]&#10;WHEN &quot;GMV Uplift %&quot; THEN [Calculation_149744695821029391]&#10;END' />
            </column>
            <column caption='TG Size' datatype='integer' name='[Calculation_4615767440638775296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel_type]&#10;&#9;WHEN &quot;IAM&quot; THEN [Impression (copy)_5354287402161250305]&#10;    ELSE [Calculation_1926977716542296112]&#10;END' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_5263300615922900992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='Variation' datatype='string' name='[Calculation_5354287402170654734]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(REGEXP_MATCH([variation_name], &quot;(?i)control|CG&quot;), &quot;CG&quot;, IIF([Parameters].[Parameter 10], IIF([canvas_name] == &quot;EAT_AUT_2304XX_AP_FP_EG_AbandonCartRestaurant_Behave-Vendor_MSG&quot;, REPLACE([variation_name], &quot;Variant 2&quot;, &quot;Old&quot;), [variation_name]), &quot;TG&quot;))' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_6700863678809518106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([global_entity_id], &quot;_&quot;, 2)' />
            </column>
            <column caption='Engaged Orders % of Sent' datatype='real' default-format='p0.0%' name='[Calculation_7263813679672270866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IIF([channel_type] != &quot;IAM&quot;, [open_orders],&#10;[click_orders])&#10;)/&#10;SUM(IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;SMS&quot;) AND [delivered] &gt; 0 THEN [delivered]&#10;ELSEIF [channel_type] = &quot;PUSH&quot; THEN [sent] - [bounce]&#10;ELSEIF [channel_type] = &quot;IAM&quot; THEN [impression]&#10;END)' />
            </column>
            <column caption='Exclude Rows' datatype='boolean' name='[Calculation_727190636294778880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//NOT REGEXP_MATCH([Canvas Name], &quot;(?i)EMAIL|PUSH|IOS|ANDROID|IAM&quot;) AND [Channel Type] = &quot;EMAIL&quot; AND &#10;[Canvas Step Name (copy)_149744695816216576] = &quot;CG&quot;&#10;&#10;OR IIF(&#10;[canvas_name] = &quot;MIX_AUT_2303XX_APAC_FP_EG_NonPro_MissedSavings_NoVoucher_MSG&quot;,&#10;[Calculation_6700863678809518106] != LEFT([canvas_step_name], 2),&#10;FALSE&#10;)' />
            </column>
            <column caption='Act. Stats Sig (1 = Sig, 0 = Not)' datatype='integer' name='[Calculation_7588495006860320768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ABS(([Calculation_3078210381256548385]-[Calculation_7588495006860677121])/&#10;SQRT(&#10;// TG SE^2  + CG SE^2&#10;([Calculation_3078210381256548385]*(1-[Calculation_3078210381256548385])/SUM([Calculation_4615767440638775296]))&#10;+&#10;([Calculation_7588495006860677121]*(1-[Calculation_7588495006860677121])/SUM([size_of_control_group]))&#10;)) &gt; 1.96, 1, 0)' />
            </column>
            <column caption='CG Activation Rate' datatype='real' name='[Calculation_7588495006860677121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_cg]) / SUM([size_of_control_group])' />
            </column>
            <column caption='Country Breakdown' datatype='string' name='[Calculation_7723743738543067136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1 2]==&quot;APAC&quot;, &quot;APAC&quot;, SPLIT([global_entity_id], &quot;_&quot;, 2))' />
            </column>
            <column caption='Volume Filter' datatype='boolean' name='[Calculation_8507440443189452800]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([Calculation_1926977716542115887]) &gt; 10 OR SUM([Impression (copy)_5354287402161250305]) &gt; 10' />
            </column>
            <column caption='Canvas Step Name ' datatype='string' name='[Canvas Step Name (copy)_149744695816216576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(CONTAINS(LOWER([variation_name]), &quot;Control&quot;) OR CONTAINS(LOWER([canvas_step_name]), &quot;control&quot;), &quot;CG&quot;, &#10;IIF([Parameters].[Parameter 13], &#10;REGEXP_REPLACE([canvas_step_name], &quot; 1$&quot;,&quot;&quot;),&#10;&quot;TG&quot;&#10;))' />
            </column>
            <column caption='Impression (IAM)' datatype='integer' name='[Impression (copy)_5354287402161250305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] == &quot;IAM&quot;, [impression], NULL)' />
            </column>
