            <column-instance column='[partition_date]' derivation='Month-Trunc' name='[tmn:partition_date:ok]' pivot='key' type='ordinal' />
            <column caption='Unique Customers' datatype='integer' name='[unique_customers]' role='measure' type='quantitative' />
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1o46not047zl3118dsy9c0d5id3o].[Action (Subscription Group)]'>
            <groupfilter function='level-members' level='[subscription_group]' user:ui-action-filter='[Action4_73E3415F5CB847D69141780627BE11FA]' user:ui-enumeration='all' user:ui-marker='enumerate' />
