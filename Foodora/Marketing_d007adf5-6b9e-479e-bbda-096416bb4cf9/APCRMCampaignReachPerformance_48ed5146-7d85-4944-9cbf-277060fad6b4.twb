      </column>
      <column caption='Delivery' datatype='integer' name='[Calculation_1926977716542296112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [channel_type] &#10;    WHEN &quot;EMAIL&quot; THEN [delivered]&#10;    WHEN &quot;PUSH&quot; THEN [sent] - [bounce]&#10;END' />
      </column>
      <column caption='TG Activation Rate' datatype='real' name='[Calculation_3078210381256548385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted])/SUM(&#10;&#9;CASE [channel_type] &#10;    &#9;WHEN &quot;IAM&quot; THEN [Impression (copy)_5354287402161250305]&#10;        WHEN &quot;VIBER&quot; THEN [Calculation_1926977716542115887]&#10;        ELSE [Calculation_1926977716542296112]&#10;    END&#10;    //IIF([Channel] != &quot;IAM&quot;, [Delivery], [Impression (IAM)])&#10;)' />
      </column>
      <column caption='Received Month' datatype='datetime' default-format='*mmm yy' name='[Calculation_3380303377565540352]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [period])' />
      </column>
      <column caption='Period Granularity' datatype='date' name='[Calculation_3380303378490638337]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Period Granularity (copy)_6643513193804341248]&#10;    WHEN &quot;Day&quot; THEN [period]&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;, [period])&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [period])&#10;    WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;, [period])&#10;    WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;, [period])&#10;END)' />
      </column>
      <column caption='Channel Type Filter' datatype='boolean' name='[Calculation_3380303378502160386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 3]=&quot;ALL&quot;, TRUE, UPPER([Parameters].[Parameter 3]) = UPPER([channel_type]))' />
      </column>
      <column caption='Data Source Filter' datatype='boolean' name='[Calculation_3380303378503647236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;    WHEN &quot;Manual Ad-hoc&quot; THEN [data_source] = &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;Automation&quot; THEN [data_source] != &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;All&quot; THEN TRUE&#10;END' />
      </column>
