  <worksheets>
    <worksheet name='Ad-hoc Performance'>
      <table>
        <view>
          <datasources>
            <datasource caption='Comms Performance' name='federated.0g8efd205rmlga116714f0sb5h7x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country Breakdown' datatype='string' name='[Parameter 1 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;APAC&quot;'>
              <calculation class='tableau' formula='&quot;APAC&quot;' />
            </column>
            <column caption='Global Entity ID' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g8efd205rmlga116714f0sb5h7x'>
            <column caption='% Click' datatype='real' name='[% Open (copy)_5354287402162278407]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Open (copy)_5354287402161836036])/SUM(IIF([channel_type] = &quot;IAM&quot;, [Impression (copy)_5354287402161250305], [Calculation_1926977716542296112]))' />
            </column>
            <column caption='Open' datatype='integer' name='[Bounce (Email, Push) (copy)_5354287402161713155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] == &quot;EMAIL&quot; OR [channel_type] == &quot;PUSH&quot;, [opened], NULL)' />
            </column>
            <column caption='Bounce (Email, Push)' datatype='integer' name='[Bounce (copy)_5354287402161504258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] == &quot;EMAIL&quot; OR [channel_type] == &quot;PUSH&quot;, [bounce], NULL)' />
            </column>
            <column caption='TG GPO' datatype='real' name='[Calculation_1394075222521225216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gp_eur_treatment])/SUM([orders])' />
            </column>
            <column caption='Activation Uplift %' datatype='real' name='[Calculation_149744695820120077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversion_uplift])/SUM([converted])' />
            </column>
            <column caption='Orders Uplift %' datatype='real' name='[Calculation_149744695820804110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_uplift]) / SUM([orders])' />
            </column>
            <column caption='GMV Uplift %' datatype='real' name='[Calculation_149744695821029391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_uplift]) / SUM([gmv_eur])' />
            </column>
            <column caption='Net GMV Uplift %' datatype='real' name='[Calculation_149744695821955088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_net_eur_uplift])/SUM([gmv_net_eur])' />
            </column>
            <column caption='Send' datatype='integer' name='[Calculation_1926977716542115887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] != &quot;IAM&quot;, [sent], [impression])' />
            </column>
            <column caption='Delivery' datatype='integer' name='[Calculation_1926977716542296112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel_type] &#10;    WHEN &quot;EMAIL&quot; THEN [delivered]&#10;    WHEN &quot;PUSH&quot; THEN [sent] - [bounce]&#10;END' />
            </column>
            <column caption='TG Activation Rate' datatype='real' name='[Calculation_3078210381256548385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted])/SUM(&#10;&#9;CASE [channel_type] &#10;    &#9;WHEN &quot;IAM&quot; THEN [Impression (copy)_5354287402161250305]&#10;        WHEN &quot;VIBER&quot; THEN [Calculation_1926977716542115887]&#10;        ELSE [Calculation_1926977716542296112]&#10;    END&#10;    //IIF([Channel] != &quot;IAM&quot;, [Delivery], [Impression (IAM)])&#10;)' />
            </column>
            <column caption='User Filter' datatype='boolean' name='[Calculation_4144226485592051713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC CRM User Filter]&#10;END' />
            </column>
            <column caption='TG Size' datatype='integer' name='[Calculation_4615767440638775296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel_type]&#10;&#9;WHEN &quot;IAM&quot; THEN [Impression (copy)_5354287402161250305]&#10;    ELSE [Calculation_1926977716542296112]&#10;END' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_5263300615922900992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='% Open' datatype='real' name='[Calculation_5354287402161917957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Bounce (Email, Push) (copy)_5354287402161713155])/SUM([Calculation_1926977716542296112])' />
            </column>
            <column caption='% Delivered' datatype='real' name='[Calculation_5354287402162126854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1926977716542296112])/SUM([Calculation_1926977716542115887])' />
            </column>
            <column caption='% CTO' datatype='real' name='[Calculation_5354287402162589704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Open (copy)_5354287402161836036])/SUM([Bounce (Email, Push) (copy)_5354287402161713155])' />
            </column>
            <column caption='TG AFV Eur' datatype='real' name='[Calculation_5354287402163691529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_eur])/SUM([orders])' />
            </column>
            <column caption='Email Unsub %' datatype='real' name='[Calculation_5354287402170220557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Unsubscribed (copy)_5354287402169880588])/SUM(IIF([channel_type] == &quot;EMAIL&quot;, [delivered], NULL))' />
            </column>
            <column caption='pro Sub Uplift %' datatype='real' name='[Calculation_5664965417103036418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro Sub Uplift (copy)_6700863678807085081]) / SUM([pro_converted])' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_6700863678809518106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([global_entity_id], &quot;_&quot;, 2)' />
            </column>
            <column caption='Act. Stats Sig (1 = Sig, 0 = Not)' datatype='integer' name='[Calculation_7588495006860320768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ABS(([Calculation_3078210381256548385]-[Calculation_7588495006860677121])/&#10;SQRT(&#10;// TG SE^2  + CG SE^2&#10;([Calculation_3078210381256548385]*(1-[Calculation_3078210381256548385])/SUM([Calculation_4615767440638775296]))&#10;+&#10;([Calculation_7588495006860677121]*(1-[Calculation_7588495006860677121])/SUM([size_of_control_group]))&#10;)) &gt; 1.96, 1, 0)' />
            </column>
            <column caption='CG Activation Rate' datatype='real' name='[Calculation_7588495006860677121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_cg]) / SUM([size_of_control_group])' />
            </column>
            <column caption='Sessions Uplift %' datatype='real' name='[Calculation_7802134519957790720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_uplift])/SUM([sessions])' />
            </column>
            <column caption='Impression (IAM)' datatype='integer' name='[Impression (copy)_5354287402161250305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] == &quot;IAM&quot;, [impression], NULL)' />
