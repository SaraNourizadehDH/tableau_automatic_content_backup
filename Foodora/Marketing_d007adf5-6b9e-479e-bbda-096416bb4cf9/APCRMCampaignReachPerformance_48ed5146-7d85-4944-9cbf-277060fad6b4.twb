      <column caption='Bounce Count Last Period' datatype='integer' name='[Calculation_495677502028607507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= DATEADD(&apos;day&apos;, [Calculation_495677501996670983], [Parameters].[Parameter 8]-1) AND [Calculation_3380303377565540352] &lt;= [Parameters].[Parameter 8]-1,&#10;IF [channel_type] != &quot;IAM&quot; THEN [bounce]&#10;END,&#10;0)' />
      </column>
      <column caption='Bounce Count' datatype='integer' name='[Calculation_495677502029975574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784],&#10;IF [channel_type] != &quot;IAM&quot; THEN [bounce]&#10;END,&#10;0&#10;)' />
      </column>
      <column caption='Opened Count' datatype='integer' name='[Calculation_495677502032556057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= [Parameters].[Parameter 8] AND [Calculation_3380303377565540352] &lt;= [Parameters].[Start Date (copy)_4181451572938870784],&#10;IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;PUSH&quot;) THEN [opened]&#10;END,&#10;0)' />
      </column>
      <column caption='Opened Count Last Period' datatype='integer' name='[Calculation_495677502032654362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_3380303377565540352] &gt;= DATEADD(&apos;day&apos;, [Calculation_495677501996670983], [Parameters].[Parameter 8]-1) AND [Calculation_3380303377565540352] &lt;= [Parameters].[Parameter 8]-1,&#10;IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;PUSH&quot;) THEN [opened]&#10;END,&#10;0)' />
      </column>
