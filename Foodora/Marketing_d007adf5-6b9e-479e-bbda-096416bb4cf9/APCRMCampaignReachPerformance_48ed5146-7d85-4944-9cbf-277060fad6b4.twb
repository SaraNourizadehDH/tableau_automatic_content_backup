            <column caption='Period' datatype='date' name='[period]' role='dimension' type='ordinal' />
            <column caption='Sent' datatype='integer' name='[sent]' role='measure' type='quantitative' />
            <column-instance column='[Delivered Count Last Period (copy)_495677502052556833]' derivation='Sum' name='[sum:Delivered Count Last Period (copy)_495677502052556833:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Opened Count (copy)_495677502051938335]' derivation='Sum' name='[sum:Opened Count (copy)_495677502051938335:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Negative opened count diff (copy)_495677502052778018]' derivation='User' name='[usr:Negative opened count diff (copy)_495677502052778018:nk]' pivot='key' type='nominal' />
            <column-instance column='[Open Rate (copy)_495677502052036640]' derivation='User' name='[usr:Open Rate (copy)_495677502052036640:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Positive opened count diff (copy)_495677502053077028]' derivation='User' name='[usr:Positive opened count diff (copy)_495677502053077028:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
