    <worksheet name='Top 10 Ad-hoc Email'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Ad-hoc Email</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Comms Performance' name='federated.0g8efd205rmlga116714f0sb5h7x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top X' datatype='string' name='[Parameter 12]' param-domain-type='any' role='measure' type='nominal' value='&quot;10&quot;'>
              <calculation class='tableau' formula='&quot;10&quot;' />
            </column>
            <column caption='Global Entity ID' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g8efd205rmlga116714f0sb5h7x'>
            <column caption='Delivery' datatype='integer' name='[Calculation_1926977716542296112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel_type] &#10;    WHEN &quot;EMAIL&quot; THEN [delivered]&#10;    WHEN &quot;PUSH&quot; THEN [sent] - [bounce]&#10;END' />
            </column>
            <column caption='Campaign Name ' datatype='string' name='[Calculation_4965711232326057984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(REGEXP_REPLACE(REGEXP_REPLACE([campaign_name], &quot;(?i)_iOS&quot;, &quot;_PUSH&quot;), &quot;(?i)_Android&quot;, &quot;_PUSH&quot;), [canvas_name])' />
            </column>
            <column caption='Exclude Campaign' datatype='boolean' name='[Calculation_4965711232327303169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS(UPPER([campaign_name]), &quot;HISTORISE&quot;)&#10;OR CONTAINS(UPPER([campaign_name]), &quot;CORPORATE&quot;)&#10;OR (ISNULL([campaign_name]) AND ISNULL([canvas_name]))&#10;OR [Calculation_1926977716542296112] &lt; 10' />
            </column>
            <column caption='Top X' datatype='boolean' name='[Calculation_4965711232329523202]' role='measure' type='nominal'>
              <calculation class='tableau' formula='INDEX() &lt;= INT([Parameters].[Parameter 12])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_5263300615922900992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='Engaged Orders % of Sent' datatype='real' default-format='p0.0%' name='[Calculation_7263813679672270866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IIF([channel_type] != &quot;IAM&quot;, [open_orders],&#10;[click_orders])&#10;)/&#10;SUM(IF ([channel_type] = &quot;EMAIL&quot; OR [channel_type] = &quot;SMS&quot;) AND [delivered] &gt; 0 THEN [delivered]&#10;ELSEIF [channel_type] = &quot;PUSH&quot; THEN [sent] - [bounce]&#10;ELSEIF [channel_type] = &quot;IAM&quot; THEN [impression]&#10;END)' />
            </column>
            <column caption='Bounce' datatype='integer' name='[bounce]' role='measure' type='quantitative' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Canvas Name' datatype='string' name='[canvas_name]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
            <column caption='Click Orders' datatype='integer' name='[click_orders]' role='measure' type='quantitative' />
            <column caption='Comms Category' datatype='string' name='[comms_category]' role='dimension' type='nominal' />
            <column caption='Comms Sub-category' datatype='string' name='[comms_sub_category]' role='dimension' type='nominal' />
            <column caption='Delivered' datatype='integer' name='[delivered]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Impression' datatype='integer' name='[impression]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4965711232326057984]' derivation='None' name='[none:Calculation_4965711232326057984:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4965711232327303169]' derivation='None' name='[none:Calculation_4965711232327303169:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5263300615922900992]' derivation='None' name='[none:Calculation_5263300615922900992:nk]' pivot='key' type='nominal' />
            <column-instance column='[channel_type]' derivation='None' name='[none:channel_type:nk]' pivot='key' type='nominal' />
