    <worksheet name='Country CVR (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Comms Performance' name='federated.0g8efd205rmlga116714f0sb5h7x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown by' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Global Entity ID' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Comms Type' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Manual Ad-hoc&quot;'>
              <calculation class='tableau' formula='&quot;Manual Ad-hoc&quot;' />
            </column>
            <column caption='Period Granularity ' datatype='string' name='[Period Granularity (copy)_6643513193804341248]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g8efd205rmlga116714f0sb5h7x'>
            <column caption='% TG CVR diff' datatype='real' name='[% open rate diff (copy)_6700863678778265616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_3078210381256548385]) - LOOKUP(ZN([Calculation_3078210381256548385]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Send' datatype='integer' name='[Calculation_1926977716542115887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] != &quot;IAM&quot;, [sent], [impression])' />
            </column>
            <column caption='Delivery' datatype='integer' name='[Calculation_1926977716542296112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [channel_type] &#10;    WHEN &quot;EMAIL&quot; THEN [delivered]&#10;    WHEN &quot;PUSH&quot; THEN [sent] - [bounce]&#10;END' />
            </column>
            <column caption='TG Activation Rate' datatype='real' name='[Calculation_3078210381256548385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted])/SUM(&#10;&#9;CASE [channel_type] &#10;    &#9;WHEN &quot;IAM&quot; THEN [Impression (copy)_5354287402161250305]&#10;        WHEN &quot;VIBER&quot; THEN [Calculation_1926977716542115887]&#10;        ELSE [Calculation_1926977716542296112]&#10;    END&#10;    //IIF([Channel] != &quot;IAM&quot;, [Delivery], [Impression (IAM)])&#10;)' />
            </column>
            <column caption='Received Month' datatype='datetime' default-format='*mmm yy' name='[Calculation_3380303377565540352]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [period])' />
            </column>
            <column caption='Period Granularity' datatype='date' name='[Calculation_3380303378490638337]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Period Granularity (copy)_6643513193804341248]&#10;    WHEN &quot;Day&quot; THEN [period]&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&apos;week&apos;, [period])&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [period])&#10;    WHEN &quot;Quarter&quot; THEN DATETRUNC(&apos;quarter&apos;, [period])&#10;    WHEN &quot;Year&quot; THEN DATETRUNC(&apos;year&apos;, [period])&#10;END)' />
            </column>
            <column caption='Data Source Filter' datatype='boolean' name='[Calculation_3380303378503647236]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;    WHEN &quot;Manual Ad-hoc&quot; THEN [data_source] = &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;Automation&quot; THEN [data_source] != &quot;CAMPAIGN PERFORMANCE&quot;&#10;    WHEN &quot;All&quot; THEN TRUE&#10;END' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_5263300615922900992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;All&apos; THEN TRUE&#10;    ELSE [global_entity_id] == [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='Breakdown by' datatype='string' name='[Calculation_6700863678768091137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &quot;Country&quot; THEN [global_entity_id]&#10;    WHEN &quot;Vertical&quot; THEN [vertical_type]&#10;    WHEN &quot;Channel Type&quot; THEN [channel_type]&#10;    WHEN &quot;Campaign Type&quot; THEN [campaign_type]&#10;END' />
            </column>
            <column caption='Impression (IAM)' datatype='integer' name='[Impression (copy)_5354287402161250305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([channel_type] == &quot;IAM&quot;, [impression], NULL)' />
            </column>
            <column caption='Negative % TG CVR diff' datatype='string' name='[Negative % open rate diff (copy)_6700863678778191887]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% open rate diff (copy)_6700863678778265616] &lt; 0 THEN &quot;▼&quot; + &quot; &quot; + STR(IIF(ABS([% open rate diff (copy)_6700863678778265616]) &lt; 0.01, ROUND([% open rate diff (copy)_6700863678778265616]*-100,1), ROUND([% open rate diff (copy)_6700863678778265616]*-100))) + &quot;%&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Positive % TG CVR diff' datatype='string' name='[Positive % open rate diff (copy)_6700863678778470417]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% open rate diff (copy)_6700863678778265616] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(IIF(ABS([% open rate diff (copy)_6700863678778265616]) &lt; 0.01, ROUND([% open rate diff (copy)_6700863678778265616]*100,1), ROUND([% open rate diff (copy)_6700863678778265616]*100))) + &quot;%&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
