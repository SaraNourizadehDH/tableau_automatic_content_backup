              <zone forceUpdate='true' h='9838' id='26' type-v2='text' w='99032' x='484' y='89478'>
                <formatted-text>
                  <run fontcolor='#000000'>Data based on </run>
                  <run bold='true' fontcolor='#59a14f'>Braze</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>- Installs: downloaded an app (Braze profile is created)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#1f1f1f'>- Uninstalls: uninstalled the app (Braze sent silent push to check whether the user still have the app installed or not)</run>
                  <run>Æ&#10;</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#e15759'>Note that in Nov 22, there was uninstalls tracking issue which caused accumulation of uninstalls in Dec 22.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{170B8F42-8C39-46B1-8DA0-6A6CE878093D}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='README'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/WIPCRMCampaignPerformanceDashboard/README?rev=' id='README' path='/t/Foodora/workbooks/WIPCRMCampaignPerformanceDashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='14' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='13' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone fixed-size='47' h='7162' id='5' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='0'>
              <zone fixed-size='217' forceUpdate='true' h='6120' id='3' is-fixed='true' type-v2='text' w='16472' x='293' y='521'>
                <formatted-text>
                  <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='16'>foodpanda</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#d70f64' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='6120' id='4' type-v2='text' w='82942' x='16765' y='521'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='15'>README</run>
                  <run bold='true' fontcolor='#333333' fontsize='10'> - Note that this dashboard is better viewed on desktop :)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone fixed-size='628' h='82813' id='12' is-fixed='true' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='100000' x='0' y='7162'>
              <zone h='81771' id='8' param='vert' type-v2='layout-flow' w='49707' x='293' y='7682'>
                <zone fixed-size='22' forceUpdate='true' h='3907' id='6' is-fixed='true' type-v2='text' w='49707' x='293' y='7682'>
                  <formatted-text>
                    <run fontname='Tableau Bold' fontsize='12'>Campaign Performance</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='77864' id='7' type-v2='text' w='49707' x='293' y='11589'>
                  <formatted-text>
                    <run bold='true' underline='true'>Metrics</run>
                    <run>Æ&#10;</run>
                    <run bold='true'># of unique campaign           </run>
                    <run># of unique campaigns that were sent out during the period (for PUSH, XXX_IOS and XXX_PUSH is counted as 1 campaign in the aggregated country and vertical overview)
</run>
                    <run bold='true'># of delivered campaign     </run>
                    <run># of campaigns that were delivered to customers (including prospect for PUSH). 
                                                         For email / push campaigns, this is the number of campaigns sent out deducted by bounce. For IAM, this is the number of impressions.
</run>
                    <run bold='true'>Open Rate (Direct)                Numerator</run>
                    <run>: # of campaign opened (only applies for campaigns via email or push channel). Assumption made is that if an email campaign is clicked, then it is considered as opened.
</run>
                    <run bold='true'>                                                          Denominator</run>
                    <run>: # of delivered campaign&#10;</run>
                    <run bold='true'>Click Through Rate                 Numerator</run>
                    <run>: # of campaign clicked (only applies for campaigns via email or IAM channel)
</run>
                    <run bold='true'>                                                          Denominator</run>
                    <run>: # of delivered campaign&#10;</run>
                    <run bold='true'>Conversion Rate                      Numerator</run>
                    <run>: # of conversion (indirectly) which is defined as # of users receiving the campaign who within the </run>
                    <run bold='true' fontcolor='#d70a64'>conversion window</run>
                    <run> (</run>
                    <run bold='true'>Email</run>
                    <run> = </run>
                    <run bold='true'>48 hours,</run>
                    <run> other channels = </run>
                    <run bold='true'>12 hours</run>
                    <run> after campaign received time) </run>
                    <run bold='true' fontcolor='#d70f64'>made at least an order / redemption that matches the vertical type of the campaign</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>                                                          Denominator</run>
                    <run>: # of users who received/viewed (impression for IAM) the campaign 
</run>
                    <run bold='true'>Conversion Orders                 </run>
                    <run>Based on orders matching the vertical type of the campaign and made within the conversion window. 
</run>
                    <run bold='true'>Conversion GMV                      </run>
                    <run fontcolor='#59a14f'>Net</run>
                    <run> GMV (which exclude incentives) for orders matching the vertical type of the campaign and made within the conversion window. For dine-in, there&apos;s no GMV value as we are not able to identify the value of dine-in redemptions.
</run>
                    <run bold='true'>Order/AFV/GMV Uplift         </run>
                    <run>Orders/AFV/GMV for TG - (Orders/AFV/GMV for CG * ( TG Size / CG Size )) 
</run>
                    <run bold='true'>Order/AFV/GMV Uplift %    Numerator</run>
                    <run>: </run>
                    <run bold='true'>Order/AFV/GMV Uplift </run>
                    <run>Æ&#10;</run>
                    <run bold='true'>                                                          Denominator</run>
                    <run>: Orders/AFV/GMV for TG&#10;</run>
                    <run bold='true'>Conversion by Sessions</run>
                    <run>       Users who within the </run>
                    <run bold='true' fontcolor='#d70a64'>conversion window</run>
                    <run> (</run>
                    <run bold='true'>Email</run>
                    <run> = </run>
                    <run bold='true'>48 hours,</run>
                    <run> other channels = </run>
                    <run bold='true'>12 hours</run>
                    <run> after campaign received time) </run>
                    <run bold='true' fontcolor='#d70a64'>open/use the app at least once</run>
                    <run>.&#10;</run>
                    <run bold='true'>Sessions</run>
                    <run>                                      Total number of app sessions as defined by Braze (open the app = 1 session count)
</run>
                    <run bold='true'>Unique Customers</run>
                    <run>                  Unique number of external_id or customer ID as part of the campaign
</run>
                    <run bold='true'>Email Unsub                               </run>
                    <run>Users who clicked &quot;unsubscribed&quot; from the email

</run>
                    <run bold='true' underline='true'>Campaign Details</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>Vertical Type                             </run>
                    <run>Each campaign will be categorised to </run>
                    <run bold='true'>one</run>
                    <run> of below verticals according to the priority based on its naming. 
                                                          Priority: Pandapay -&gt; Pandago -&gt; Dine In -&gt; Pandapro -&gt; Corporate -&gt; SKC -&gt; Loyalty/Games/Challenges -&gt; Pickup -&gt; EAT -&gt; DMA -&gt; LOC -&gt; QUI -&gt; MIX -&gt; COPY -&gt; Others
</run>
                    <run bold='true'>Campaign Type                         </run>
                    <run>Priority: Voucher -&gt;  Vendor Deal -&gt; Promo -&gt; Brand -&gt; Free Delivery -&gt; Others
</run>
                    <run bold='true'>Channel Type                             </run>
                    <run>Priority: Push -&gt; Email -&gt; On-site -&gt; IAM -&gt; SMS -&gt; Others</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone h='81771' id='11' param='vert' type-v2='layout-flow' w='49707' x='50000' y='7682'>
                <zone fixed-size='22' forceUpdate='true' h='3907' id='9' is-fixed='true' type-v2='text' w='49707' x='50000' y='7682'>
                  <formatted-text>
                    <run fontname='Tableau Bold' fontsize='12'>Reachability</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='36459' id='10' type-v2='text' w='49707' x='50000' y='11589'>
                  <formatted-text>
                    <run bold='true'>Total User                                   </run>
                    <run>Based on Braze User data, which includes prospect with no account (created in the past 30 days), excludes customers whose last purchase is more than 2 years ago, and excludes customers who requested their profiles to be deleted. </run>
                    <run fontcolor='#000000'>Please note that </run>
                    <run bold='true' fontcolor='#000000'>1% of the users belong to Global Control Group</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>App Installation                       </run>
                    <run>Data (from May 21 onwards) based on Adjust SDK recorded based on user&apos;s device (Reference: </run>
                    <run auto-url='true' fontcolor='#1f1f1f' hyperlink='tabdoc:load-url url=&amp;quot;https://www.adjust.com/glossary/install/&amp;quot;'>https://www.adjust.com/glossary/install/</run>
                    <run fontcolor='#1f1f1f'>)</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>Æ                                                          </run>
                    <run>- Installs: downloaded an app and successfully opens it for the first time (Organic: any install of an app that’s not attributed to a specific install source)
</run>
                    <run bold='true'>Æ                                                          </run>
                    <run>- Reinstalls: uninstalled the app and reinstalled it
</run>
                    <run bold='true'>Æ                                                          </run>
                    <run>- Uninstalls: uninstalled the app forever (uninstall date based on last active session)
</run>
                    <run bold='true'>User Subscription                   </run>
                    <run>Data based on Braze user data on global subscription states, including prospect with no account. (Reference: </run>
                    <run auto-url='true' fontcolor='#000000' hyperlink='tabdoc:load-url url=&amp;quot;https://www.braze.com/docs/user_guide/message_building_by_channel/email/managing_user_subscriptions/&amp;quot;'>https://www.braze.com/docs/user_guide/message_building_by_channel/email/managing_user_subscriptions/</run>
                    <run fontcolor='#000000'>)</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>Æ                                                          </run>
                    <run>- Subscriber: user opted-in (explicitly confirmed they want to receive email) / subscribed (neither unsubscribed nor explicitly opted-in to receive emails; default subscription state when a user profile is created) to email or push
</run>
                    <run bold='true'>Æ                                                          </run>
                    <run>- Non-subscriber: user has explicitly unsubscribed from your emails.
</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone fixed-size='22' forceUpdate='true' h='3907' id='17' is-fixed='true' type-v2='text' w='49707' x='50000' y='48048'>
                  <formatted-text>
                    <run fontname='Tableau Bold' fontsize='12'>Top 10 Views</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3256' id='18' type-v2='text' w='49707' x='50000' y='51955'>
                  <formatted-text>
                    <run>Note that the </run>
                    <run bold='true'>size of treatment group</run>
                    <run> for the campaign to be included in the top 10 view is</run>
                    <run bold='true' fontcolor='#d70f64'> at least 10,000</run>
                    <run>. </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='27605' id='15' type-v2='text' w='49707' x='50000' y='55211'>
                  <formatted-text>
                    <run bold='true' underline='true'>Remarks</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#d70a64'>Orders</run>
                    <run> tab contains overall </run>
                    <run bold='true'>unique</run>
                    <run> number of orders (and their total GMV) generated by the treatment group of the campaigns within the conversion window and is </run>
                    <run bold='true'>deduplicated</run>
                    <run> on country level. The </run>
                    <run bold='true'>breakdown by vertical</run>
                    <run> contains unique number of orders (and their total GMV) generated by the treatment group of the campaigns within the conversion window and is </run>
                    <run bold='true'>deduplicated</run>
                    <run> on vertical level and country level. Hence, the </run>
                    <run bold='true' fontcolor='#4e79a7'>sum of each vertical&apos;s order (or GMV) will not be equal to the overall number</run>
                    <run bold='true'>Æ </run>
                    <run>shown on the top row.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#d70a64'>Campaign Details</run>
                    <run> tab shows the summary of the campaigns selected / shown in the view on the </run>
                    <run bold='true'>grand total </run>
                    <run>tab. </run>
                    <run>Æ&#10;</run>
                    <run>- For customer-related numbers, the grand total is the maximum of the rows below. </run>
                    <run>Æ&#10;</run>
                    <run>- For sends, deliveries, impressions, opens, clicks, the grand total is the actual total (sum) of these metrics for the campaigns. For engagement metrics %, it is the average  for the rows below. For </run>
                    <run>Æ&#10;</run>
                    <run>- For Order, AFV, and GMV Uplift (absolute number) and Uplift (%), the grand total numbers are hidden as there are orders which are attributed to multiple campaigns below.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='9245' id='19' param='horz' type-v2='layout-flow' w='100000' x='0' y='89975'>
              <zone forceUpdate='true' h='9245' id='16' type-v2='text' w='49414' x='0' y='89975'>
                <formatted-text>
                  <run bold='true' fontsize='11'>How to apply for access? </run>
                  <run fontsize='11'>Go to Sailpoint, search for Tableau, apply for</run>
                  <run>Æ&#10;</run>
                  <run fontsize='11'>APAC : </run>
                  <run bold='true' fontcolor='#d70a64' fontsize='11'>Tableau - Pandora - Foodpanda Marketing XX</run>
                  <run fontsize='11'> (your country)</run>
                  <run>Æ&#10;</run>
                  <run fontsize='11'>Global : </run>
                  <run bold='true' fontcolor='#d70a64' fontsize='11'>Tableau - Pandora - Marketing - Global - All</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='9245' id='20' type-v2='text' w='50585' x='49414' y='89975'>
                <formatted-text>
                  <run bold='true' fontsize='10'>For queries regarding dashboard, please check Confluence page first. Link to Confluence: </run>
                  <run auto-url='true' bold='true' fontcolor='#4996b2' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/ADM/BI+-+CRM+Adhoc+Campaign+Dashboard&amp;quot;'>https://confluence.deliveryhero.com/display/ADM/BI+-+CRM+Adhoc+Campaign+Dashboard</run>
                  <run bold='true' fontsize='10'>Æ </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
        </zone>
      </zones>
      <simple-id uuid='{00AA7C69-1E38-4913-A84D-5FFA52DCA5BC}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Template Overview'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/WIPCRMCampaignPerformanceDashboard/TemplateOverview?rev=' id='TemplateOverview' path='/t/Foodora/workbooks/WIPCRMCampaignPerformanceDashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='1169' maxwidth='1654' minheight='1169' minwidth='1654' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Comms Performance' name='federated.0g8efd205rmlga116714f0sb5h7x' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Country Breakdown' datatype='string' name='[Parameter 1 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;APAC&quot;'>
          <calculation class='tableau' formula='&quot;APAC&quot;' />
          <members>
            <member value='&quot;APAC&quot;' />
            <member value='&quot;Country&quot;' />
          </members>
        </column>
        <column alias='Sends' caption='Metric 1' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;Send&quot;'>
          <calculation class='tableau' formula='&quot;Send&quot;' />
          <aliases>
            <alias key='&quot;\# campaign&quot;' value='Campaign Count' />
            <alias key='&quot;Click Orders&quot;' value='Click To Orders' />
            <alias key='&quot;Open Orders&quot;' value='Open To Orders' />
            <alias key='&quot;Send&quot;' value='Sends' />
          </aliases>
          <members>
            <member alias='Click To Orders' value='&quot;Click Orders&quot;' />
            <member alias='Open To Orders' value='&quot;Open Orders&quot;' />
            <member alias='Sends' value='&quot;Send&quot;' />
            <member alias='Campaign Count' value='&quot;\# campaign&quot;' />
            <member value='&quot;Engaged / &apos;000 comms &quot;' />
          </members>
        </column>
        <column alias='% Activation Uplift' caption='Metric 2' datatype='string' name='[Parameter 15]' param-domain-type='list' role='measure' type='nominal' value='&quot;Activation Uplift \%&quot;'>
          <calculation class='tableau' formula='&quot;Activation Uplift %&quot;' />
          <aliases>
            <alias key='&quot;Activation Uplift \%&quot;' value='% Activation Uplift' />
            <alias key='&quot;Engaged Orders \% of Sent&quot;' value='% Engaged Orders' />
            <alias key='&quot;GMV Uplift \%&quot;' value='% GMV Uplift' />
            <alias key='&quot;Orders Uplift \%&quot;' value='% Order Uplift' />
          </aliases>
          <members>
            <member alias='% Engaged Orders' value='&quot;Engaged Orders \% of Sent&quot;' />
            <member alias='% Activation Uplift' value='&quot;Activation Uplift \%&quot;' />
            <member alias='% Order Uplift' value='&quot;Orders Uplift \%&quot;' />
            <member alias='% GMV Uplift' value='&quot;GMV Uplift \%&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0g8efd205rmlga116714f0sb5h7x'>
        <column caption='Received Month' datatype='datetime' default-format='*mmm yy' name='[Calculation_3380303377565540352]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [period])' />
        </column>
        <column caption='Channel' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
        <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_3380303377565540352]' derivation='None' name='[none:Calculation_3380303377565540352:ok]' pivot='key' type='ordinal' />
        <column-instance column='[channel_type]' derivation='None' name='[none:channel_type:nk]' pivot='key' type='nominal' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
        <column-instance column='[template]' derivation='None' name='[none:template:nk]' pivot='key' type='nominal' />
        <column caption='Template' datatype='string' name='[template]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='39322' id='7' param='horz' type-v2='layout-flow' w='99032' x='484' y='16339'>
            <zone h='39322' id='5' type-v2='layout-basic' w='99032' x='484' y='16339'>
              <zone h='39322' id='3' name='Canvas Comms Performance (chart)' show-title='false' w='99032' x='484' y='16339'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
