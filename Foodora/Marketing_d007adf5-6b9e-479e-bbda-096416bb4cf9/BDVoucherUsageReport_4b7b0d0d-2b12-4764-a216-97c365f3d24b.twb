      <column caption='Dates' datatype='datetime' name='[Calculation_4788100465145438208]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [order_date]&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [order_date], &apos;monday&apos;)&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;month&apos;, [order_date])&#10;END' />
      </column>
