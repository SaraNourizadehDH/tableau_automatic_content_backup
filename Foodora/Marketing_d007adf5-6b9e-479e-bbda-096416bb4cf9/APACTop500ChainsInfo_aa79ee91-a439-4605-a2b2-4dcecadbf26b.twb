          <named-connection caption='BigQuery' name='bigquery.0rlt4to000wqdw1920r1g18vfs03'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Data Production' schema='pandata_ap_mktg' server-oauth='' username='rajshree.nolkha@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rlt4to000wqdw1920r1g18vfs03' name='Custom SQL Query' type='text'><![CDATA[WITH base AS (
  SELECT
    base.global_entity_id,
    base.partition_month,
    base.vertical_per_redemption AS order_vertical,
    CASE WHEN top_500_chains_info.chain_rank IS NOT NULL AND top_500_chains_info.chain_rank <<= 500
         THEN CAST(top_500_chains_info.chain_rank AS STRING) ELSE "500++" END AS chain_rank,
    CASE WHEN  top_500_chains_info.chain_rank IS NOT NULL AND top_500_chains_info.chain_rank <<= 500
         THEN CONCAT(top_500_chains_info.chain_rank, " ", base.chain_name) ELSE "501 chain_others" END AS chain_name_ranked,
    CASE WHEN  top_500_chains_info.chain_rank IS NOT NULL AND top_500_chains_info.chain_rank <<= 500
         THEN base.chain_name ELSE "Others" END AS chain_name,
    COUNT(DISTINCT CASE WHEN base.is_acquisition THEN base.acid_uuid END) AS num_acquisitions,
    COUNT(DISTINCT CASE WHEN base.is_acid_reacq_flag THEN base.acid_uuid END) AS num_reacquisitions,
    COUNT(DISTINCT base.acid_uuid) AS num_mau,
    SUM(base.num_orders) AS num_orders,
    SUM(base.gmv_eur) AS gmv_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_vendor_chain_base_metrics_info` AS base
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_top_500_vendor_chains_by_orders_info` AS top_500_chains_info
         ON base.global_entity_id = top_500_chains_info.global_entity_id
        AND base.vertical_per_redemption = top_500_chains_info.order_vertical
        AND base.chain_name = top_500_chains_info.chain_name
  GROUP BY ALL
)

SELECT *
FROM base
WHERE order_vertical IN ("food", "pickup", "shops", "dmart")]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0rlt4to000wqdw1920r1g18vfs03' name='Custom SQL Query' type='text'><![CDATA[WITH base AS (
