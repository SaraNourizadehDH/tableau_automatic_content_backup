      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='base_city_level_metrics' id='_842FDDA4CFB84341B20997796C131A2B'>
            <properties context=''>
              <relation connection='bigquery.0q11jhj1g7g8w317dtiqc1ahtgv6' name='Custom SQL Query' type='text'><![CDATA[WITH all_cities_base AS (
  SELECT
    global_entity_id,
    vertical_per_redemption AS order_vertical,
    lg_city_name,
    SUM(num_orders) AS total_orders,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_vendor_chain_base_metrics_info`
  WHERE lg_city_name IS NOT NULL
  GROUP BY ALL
),

all_cities_info AS (
  SELECT *,
    ROW_NUMBER() OVER (PARTITION BY global_entity_id, order_vertical ORDER BY total_orders DESC) AS city_rank  
  FROM all_cities_base
),

combined AS (
  SELECT
    base.global_entity_id,
    base.partition_month,
    base.vertical_per_redemption AS order_vertical,
    CASE WHEN top_500_chains_info.chain_rank IS NOT NULL AND top_500_chains_info.chain_rank <<= 500
         THEN CAST(top_500_chains_info.chain_rank AS STRING) ELSE "500++" END AS chain_rank,
    CASE WHEN  top_500_chains_info.chain_rank IS NOT NULL AND top_500_chains_info.chain_rank <<= 500
         THEN CONCAT(top_500_chains_info.chain_rank, " ", base.chain_name) ELSE "501 chain_others" END AS chain_name_ranked,
    CASE WHEN  top_500_chains_info.chain_rank IS NOT NULL AND top_500_chains_info.chain_rank <<= 500
         THEN base.chain_name ELSE "Others" END AS chain_name,
    CASE WHEN all_cities_info.city_rank IS NOT NULL AND all_cities_info.city_rank <<= 15
         THEN CAST(all_cities_info.city_rank AS STRING) ELSE "15++" END AS city_rank,
    CASE WHEN all_cities_info.city_rank IS NOT NULL AND all_cities_info.city_rank <<= 15
         THEN CONCAT(all_cities_info.city_rank, " ", base.lg_city_name) ELSE "Others" END AS city_name_ranked,
    CASE WHEN all_cities_info.city_rank IS NOT NULL AND all_cities_info.city_rank <<= 15
         THEN base.lg_city_name ELSE "Others" END AS city_name,
    CASE WHEN base.global_entity_id = "FP_BD" AND base.lg_city_name = "Dhaka" THEN "capital_city"
         WHEN base.global_entity_id = "FP_HK" THEN "capital_city"
         WHEN base.global_entity_id = "FP_KH" AND base.lg_city_name = "Phnom penh" THEN "capital_city"
         WHEN base.global_entity_id = "FP_LA" AND base.lg_city_name = "Vientiane capital" THEN "capital_city"
         WHEN base.global_entity_id = "FP_MM" AND base.lg_city_name = "Yangon" THEN "capital_city"
         WHEN base.global_entity_id = "FP_MY" AND base.lg_city_name = "Klang valley" THEN "capital_city"
         WHEN base.global_entity_id = "FP_PH" AND base.lg_city_name IN ("Manila", "South mm") THEN "capital_city"
         WHEN base.global_entity_id = "FP_PK" AND base.lg_city_name = "Islamabad" THEN "capital_city"
         WHEN base.global_entity_id = "FP_SG" THEN "capital_city"
         WHEN base.global_entity_id = "FP_TH" AND base.lg_city_name = "Bangkok" THEN "capital_city"
         WHEN base.global_entity_id = "FP_TW" AND base.lg_city_name = "Taipei" THEN "capital_city"
         ELSE "ex_capital_city" END AS capital_city_flag,
    SUM(base.num_orders) AS num_orders
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_vendor_chain_base_metrics_info` AS base
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_top_500_vendor_chains_by_orders_info` AS top_500_chains_info
         ON base.global_entity_id = top_500_chains_info.global_entity_id
        AND base.vertical_per_redemption = top_500_chains_info.order_vertical
        AND base.chain_name = top_500_chains_info.chain_name
  LEFT JOIN all_cities_info
         ON base.global_entity_id = all_cities_info.global_entity_id
        AND base.vertical_per_redemption = all_cities_info.order_vertical
        AND base.lg_city_name = all_cities_info.lg_city_name
  GROUP BY ALL
),

total_orders AS (
  SELECT
    global_entity_id,
    partition_month,
    order_vertical,
    chain_rank,
    chain_name_ranked,
    chain_name,
    SUM(num_orders) AS num_total_orders
  FROM combined
  GROUP BY ALL
),

latest_partition_month AS (
  SELECT
    MAX(partition_month) AS latest_completed_partition_month
  FROM combined
  WHERE partition_month != DATE_TRUNC(CURRENT_DATE(), MONTH)
)

SELECT combined.*,
  total_orders.num_total_orders,
  CASE WHEN latest_partition_month.latest_completed_partition_month IS NOT NULL THEN TRUE ELSE FALSE END AS is_latest_completed_partition_month
FROM combined
LEFT JOIN total_orders
       ON combined.global_entity_id = total_orders.global_entity_id
      AND combined.partition_month = total_orders.partition_month
      AND combined.order_vertical = total_orders.order_vertical
      AND combined.chain_rank = total_orders.chain_rank
      AND combined.chain_name = total_orders.chain_name
LEFT JOIN latest_partition_month
       ON combined.partition_month = latest_partition_month.latest_completed_partition_month
WHERE combined.order_vertical IN ("food", "pickup", "dmart", "shops")]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
