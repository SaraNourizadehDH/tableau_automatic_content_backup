              <calculation class='tableau' formula='[GMV Non Incentivised (copy)_6405596463705243663] / [total_incentivised_orders_with_pro (copy)_1569363757520003086]' />
            </column>
            <column caption='Non Incentivised ABV RR Δ %' datatype='string' name='[Incentivised ABV RR Δ % (copy)_1569363757521981458]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[Incentivised ABV (copy)_1569363757520175119], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Incentivised ABV (copy)_1569363757520175119], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[Incentivised ABV (copy)_1569363757520175119],0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[Incentivised ABV (copy)_1569363757520175119], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Incentivised ABV (copy)_1569363757520175119], 0)))&#10;     / &#10;     SUM(IIF([W-1 (copy)_6156913286732079109],[Incentivised ABV (copy)_1569363757520175119], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[Incentivised ABV (copy)_1569363757520175119], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Incentivised ABV (copy)_1569363757520175119], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[Incentivised ABV (copy)_1569363757520175119], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[Incentivised ABV (copy)_1569363757520175119], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Incentivised ABV (copy)_1569363757520175119], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[Incentivised ABV (copy)_1569363757520175119], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Non Incentivised ABV Δ Colour' datatype='string' name='[Incentivised ABV Δ Colour (copy)_1569363757522280467]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[Incentivised ABV (copy)_1569363757520175119], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Incentivised ABV (copy)_1569363757520175119], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[Incentivised ABV (copy)_1569363757520175119], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[Incentivised ABV (copy)_1569363757520175119], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Incentivised ABV (copy)_1569363757520175119], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[Incentivised ABV (copy)_1569363757520175119], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;END' />
