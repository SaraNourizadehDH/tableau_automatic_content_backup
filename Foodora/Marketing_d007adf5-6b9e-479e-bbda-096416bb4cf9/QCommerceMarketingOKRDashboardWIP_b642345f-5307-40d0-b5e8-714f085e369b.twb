      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Display Dates' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Date Trends&quot;'>
              <calculation class='tableau' formula='&quot;Date Trends&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Incentivised ABV &amp; vs MoM' datatype='string' name='[ABV &amp; vs MoM (copy)_4599019710351499276]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([ABV (copy)_1569363757513420807]), 2))&#10;    WHEN &quot;Targets&quot; THEN NULL&#10;        //STR(ROUND([ABV Target], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [ABV Date Trends (copy)_4599019710348759050]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Incentivised ABV' datatype='real' name='[ABV (copy)_1569363757513420807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Incentivised (copy)_6405596463705165838] / [total_incentivised_orders]' />
            </column>
            <column caption='Incentivised ABV Date Trends' datatype='string' name='[ABV Date Trends (copy)_4599019710348759050]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([ABV (copy)_1569363757513420807])) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([ABV (copy)_1569363757513420807]) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([ABV (copy)_1569363757513420807])) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([ABV (copy)_1569363757513420807]) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Incentivised ABV Date Trends Colour' datatype='string' name='[ABV Date Trends Colour (copy)_4599019710351265803]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([ABV (copy)_1569363757513420807])) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([ABV (copy)_1569363757513420807])) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='GFV Incentivised' datatype='real' name='[GMV Incentivised (copy)_6405596463705165838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        [total_incentivised_gfv_eur]&#10;    WHEN &quot;LC&quot; THEN&#10;        [total_incentivised_gfv_local]&#10;END' />
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -6, TODAY()))' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
