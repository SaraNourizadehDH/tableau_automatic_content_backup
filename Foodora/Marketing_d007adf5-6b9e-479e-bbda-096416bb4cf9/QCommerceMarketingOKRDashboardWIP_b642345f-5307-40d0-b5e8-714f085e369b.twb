          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='% Non-Incentivised Orders' datatype='real' name='[% Incentivised Orders (copy)_619526469809111052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders RR (copy)_619526469808250889] / SUM([total_valid_orders])' />
            </column>
            <column caption='ABV (Organic)' datatype='real' name='[ABV (Incentivised) (copy)_619526469808373770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Organic (copy)_6405596463706169360] / [Orders RR (copy)_619526469808250889]' />
            </column>
            <column caption='% Incentivised Orders' datatype='real' name='[ABV (Incentivised) (copy)_619526469808947211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_incentivised_orders]) / SUM([total_valid_orders])' />
            </column>
            <column caption='Incentivised ABV' datatype='real' name='[ABV (copy)_1569363757513420807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Incentivised (copy)_6405596463705165838] / [total_incentivised_orders]' />
            </column>
            <column caption='ABV (Incentivised)' datatype='real' name='[ABV (copy)_619526469806972935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Incentivised (copy)_6405596463705165838] / [total_incentivised_orders]' />
            </column>
            <column caption='Fresh ABV' datatype='real' name='[ABV (copy)_619526469830389781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GFV RR (copy)_619526469830074388] / [total_fresh_orders]' />
            </column>
            <column caption='ABV RR vs Target' datatype='real' name='[ABV Target Δ (copy)_4804777897127182398]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[GMV Target (copy)_1273885407426375682]) - 1), 3)&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[GMV Target (copy)_1273885408076664838]) - 1), 3)&#10;        //ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN 0&#10;            //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[GMV Target (copy)_1273885407426375682]) - 1), 3)&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[GMV Target (copy)_1273885408076664838]) - 1), 3)&#10;        //ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN 0&#10;            //SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    //ELSE 0&#10;END' />
            </column>
            <column caption='GMV Net RR' datatype='real' name='[Calculation_6156913286683598851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6156913286805508114]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Date Filter' datatype='date' name='[Date Range (copy)_4804777897118273592]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Fresh Basket Penetration' datatype='real' name='[Fresh ABV (copy)_619526469833134103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_fresh_orders] / [total_valid_orders]' />
            </column>
            <column caption='Private Label ABV' datatype='real' name='[Fresh ABV (copy)_619526469839167515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GFV RR (copy)_619526469838561305] / [total_private_label_orders]' />
            </column>
            <column caption='Private Label Basket Penetration' datatype='real' name='[Fresh Basket Penetration (%) (copy)_619526469840408604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_private_label_orders] / [total_valid_orders]' />
            </column>
            <column caption='Fresh Order Frequency' datatype='real' name='[Fresh Customers (copy)_619526469834530840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_fresh_orders] / [total_fresh_customers]' />
            </column>
            <column caption='Private Label Order Frequency' datatype='real' name='[Fresh Order Frequency (copy)_619526469841264669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_private_label_orders] / [total_private_label_customers]' />
            </column>
            <column caption='Private Label GFV Share RR' datatype='real' name='[Fresh PP RR (copy)_6156913287118286941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] IN (&quot;Pandamart&quot;) THEN [GMV RR (copy)_6156913287114444889] / [GFV RR (EUR) (copy)_3285938884140371968] END' />
