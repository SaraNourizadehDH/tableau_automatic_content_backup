            </column>
            <column caption='Sessions Share % RR Colour' datatype='integer' name='[GMV NTV % RR Colour (copy)_4058517378472374274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([GMV NTV % RR (copy)_4058517378472161280]) - [GMV NTP % RR AVG (copy)_4058517378472828931]) / [GMV NTP % RR AVG (copy)_4058517378472828931] &gt;= 0.2 THEN 2&#10;ELSEIF (SUM([GMV NTV % RR (copy)_4058517378472161280]) - [GMV NTP % RR AVG (copy)_4058517378472828931]) / [GMV NTP % RR AVG (copy)_4058517378472828931] &lt;= -0.2 THEN -2&#10;ELSEIF (SUM([GMV NTV % RR (copy)_4058517378472161280]) - [GMV NTP % RR AVG (copy)_4058517378472828931]) / [GMV NTP % RR AVG (copy)_4058517378472828931] &lt;= -0.1 THEN -1&#10;ELSEIF (SUM([GMV NTV % RR (copy)_4058517378472161280]) - [GMV NTP % RR AVG (copy)_4058517378472828931]) / [GMV NTP % RR AVG (copy)_4058517378472828931] &gt;= 0.1 THEN 1&#10;ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
