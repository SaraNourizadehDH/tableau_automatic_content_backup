    <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' inline='true' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1lvv5360xpitjj1ch548l17vdzps'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='adam.arent@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1lvv5360xpitjj1ch548l17vdzps' name='Custom SQL Query' type='text'><![CDATA[WITH weekly_shoppers AS (
  SELECT
    report_date_local,
    "Month" AS date_type,
    global_entity_id,
    vertical,
    SUM(cust) AS weekly_shoppers_cust
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_report`
  WHERE subsegment = "Weekly Shoppers"
  GROUP BY 1,2,3,4
),

data AS (
  SELECT
    "APAC" AS region,
    okr.*,
    weekly_shoppers.weekly_shoppers_cust
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qcommerce_okr_dashboard` AS okr
  LEFT JOIN weekly_shoppers
         ON okr.report_date_local = weekly_shoppers.report_date_local
        AND okr.global_entity_id = weekly_shoppers.global_entity_id
        AND okr.date_type = weekly_shoppers.date_type
        AND okr.vertical = weekly_shoppers.vertical
  WHERE (okr.date_type = "Week" AND okr.report_date_local << DATE_TRUNC(CURRENT_DATE, ISOWEEK))
     OR (okr.date_type = "Month" AND okr.report_date_local <<= CURRENT_DATE)

  UNION ALL
  
SELECT
  "EU + TR" AS region,
   *,
  0 AS weekly_shoppers_cust
FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_eu_okr_dashboard` AS okr
WHERE (okr.date_type = "Week" AND okr.report_date_local << DATE_TRUNC(CURRENT_DATE, ISOWEEK))
     OR (okr.date_type = "Month" AND okr.report_date_local <<= CURRENT_DATE)
),

final AS (
SELECT
  data.*
FROM data
UNION ALL
SELECT
  "APAC" AS region,
  report_date_local,
  "Month" AS date_type,
  "Thailand" AS country,
  "FP_TH" AS global_entity_id,
  "Pandamart" AS vertical,
  0 AS menu_sessions,
  0 AS platform_sessions,
  0 AS total_gmv_eur,
  0 AS total_gmv_net_eur,
  0 AS total_gmv_local,
  0 AS total_gmv_net_local,
  0 AS total_gmv_eur_billable,
  0 AS total_gmv_local_billable,
  0 AS total_gfv_eur_billable,
  0 AS total_gfv_local_billable,
  0 AS total_gfv_eur,
  0 AS total_gfv_net_eur,
  0 AS total_gfv_local,
  0 AS total_gfv_net_local,
  0 AS total_incentivised_gmv_eur,
  0 AS total_incentivised_gmv_local,
  0 AS total_incentivised_gfv_eur,
  0 AS total_incentivised_gfv_local,
  0 AS total_incentivised_gmv_eur_with_pro,
  0 AS total_incentivised_gmv_local_with_pro,
  0 AS total_subscriber_order_gmv_eur,
  0 AS total_subscriber_order_gmv_local,
  0 AS total_subscription_benefit_order_gmv_eur,
  0 AS total_subscription_benefit_order_gmv_local,
  0 AS users_new_to_vertical,
  0 AS incentive_cost_fp_marketing_eur,
  0 AS incentive_cost_fp_marketing_local,
  0 AS incentive_cost_subscriber_order_eur,
  0 AS incentive_cost_subscriber_order_local,
  0 AS incentive_cost_subscription_benefit_order_eur,
  0 AS incentive_cost_subscription_benefit_order_local,
  0 AS ac_30d_ago,
  0 AS ac_30d_ago_reorder,
  0 AS ac_30d_ago_organic_with_pro_reorder,
  0 AS ac_30d_ago_subsidized_with_pro_reorder,
  0 AS nc_30d_ago,
  0 AS nc_30d_ago_reorder,
  0 AS nc_30d_ago_organic_with_pro_reorder,
  0 AS nc_30d_ago_subsidized_with_pro_reorder,
  0 AS num_of_sh_customers_in_delivery_area_cnty,
  0 AS num_of_customers_in_delivery_area_cnty,
  0 AS sh_pct_of_delivery_area_cnty,
  0 AS total_billable_orders,
  0 AS total_valid_orders,
  0 AS total_incentivised_orders,
  0 AS total_incentivised_orders_with_pro,
  0 AS total_subscriber_orders,
  0 AS total_subscription_benefit_orders,
  0 AS total_ncs,
  0 AS total_customers,
  0 AS total_fresh_orders,
  0 AS total_fresh_customers,
  0 AS total_overall_customers,
  0 AS total_fresh_gfv_eur,
  0 AS total_fresh_gfv_local,
  0 AS private_label_ob_gfv_eur,
  0 AS total_private_label_gfv_eur,
  0 AS total_private_label_orders,
  0 AS total_private_label_customers,
  0 AS total_gmv_eur_ntp,
  0 AS total_gmv_net_eur_ntp,
  0 AS total_gmv_local_ntp,
  0 AS total_gmv_net_local_ntp,
  0 AS total_gmv_eur_billable_ntp,
  0 AS total_gmv_local_billable_ntp,
  0 AS total_billable_orders_ntp,
  0 AS total_valid_orders_ntp,
  0 AS total_gmv_eur_ntv,
  0 AS total_gmv_net_eur_ntv,
  0 AS total_gmv_local_ntv,
  0 AS total_gmv_net_local_ntv,
  0 AS total_gmv_eur_billable_ntv,
  0 AS total_gmv_local_billable_ntv,
  0 AS total_billable_orders_ntv,
  0 AS total_valid_orders_ntv,
  0 AS segment_acquired_count,
