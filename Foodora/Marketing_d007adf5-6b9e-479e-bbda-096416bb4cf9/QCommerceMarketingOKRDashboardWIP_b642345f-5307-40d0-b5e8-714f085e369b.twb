            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_2022890300484079616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Week&quot; THEN &quot;WoW Δ&quot;&#10;ELSEIF [date_type] = &quot;Month&quot; then &quot;MoM Δ&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='W-1' datatype='boolean' name='[Calculation_6156913286731837444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY()))' />
            </column>
            <column caption='M-1' datatype='boolean' name='[M-0 (copy)_6156913286740725769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -1, TODAY()))' />
            </column>
            <column caption='NTV RR' datatype='real' name='[Sessions RR (copy)_6156913287042859041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [users_new_to_vertical] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [users_new_to_vertical]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [users_new_to_vertical]&#10;END' />
            </column>
            <column caption='NTV RR Δ %' datatype='string' name='[Sessions RR Δ % (copy)_6156913287044722724]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[Sessions RR (copy)_6156913287042859041], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions RR (copy)_6156913287042859041], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions RR (copy)_6156913287042859041], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[Sessions RR (copy)_6156913287042859041], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions RR (copy)_6156913287042859041], 0)))&#10;     / &#10;     SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions RR (copy)_6156913287042859041], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[Sessions RR (copy)_6156913287042859041], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions RR (copy)_6156913287042859041], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions RR (copy)_6156913287042859041], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[Sessions RR (copy)_6156913287042859041], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions RR (copy)_6156913287042859041], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions RR (copy)_6156913287042859041], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
            <column caption='NTV RR Δ Colour' datatype='string' name='[Sessions RR Δ Colour (copy)_6156913287045025829]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[Sessions RR (copy)_6156913287042859041], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions RR (copy)_6156913287042859041], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions RR (copy)_6156913287042859041], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[Sessions RR (copy)_6156913287042859041], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions RR (copy)_6156913287042859041], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions RR (copy)_6156913287042859041], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;END' />
