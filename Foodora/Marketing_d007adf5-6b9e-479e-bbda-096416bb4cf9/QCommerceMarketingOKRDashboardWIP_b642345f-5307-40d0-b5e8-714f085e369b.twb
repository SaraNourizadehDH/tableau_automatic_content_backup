          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Run Rate' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;RR On&quot;'>
              <calculation class='tableau' formula='&quot;RR On&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_2022890300484079616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Week&quot; THEN &quot;WoW Δ&quot;&#10;ELSEIF [date_type] = &quot;Month&quot; then &quot;MoM Δ&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='W-1' datatype='boolean' name='[Calculation_6156913286731837444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY()))' />
            </column>
            <column caption='Orders RR' datatype='real' name='[GMV RR (copy)_1569363757871665182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [total_valid_orders] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [total_valid_orders]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [total_valid_orders]&#10;END' />
            </column>
            <column caption='Orders RR Δ %' datatype='string' name='[GMV RR Δ % (copy)_1569363757874823201]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[GMV RR (copy)_1569363757871665182], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[GMV RR (copy)_1569363757871665182], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[GMV RR (copy)_1569363757871665182],0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[GMV RR (copy)_1569363757871665182], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[GMV RR (copy)_1569363757871665182], 0)))&#10;     / &#10;     SUM(IIF([W-1 (copy)_6156913286732079109],[GMV RR (copy)_1569363757871665182], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[GMV RR (copy)_1569363757871665182], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[GMV RR (copy)_1569363757871665182], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[GMV RR (copy)_1569363757871665182], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[GMV RR (copy)_1569363757871665182], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[GMV RR (copy)_1569363757871665182], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[GMV RR (copy)_1569363757871665182], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Orders RR Δ Colour' datatype='string' name='[GMV RR Δ Colour (copy)_1569363757875200034]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[GMV RR (copy)_1569363757871665182], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[GMV RR (copy)_1569363757871665182], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[GMV RR (copy)_1569363757871665182], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[GMV RR (copy)_1569363757871665182], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[GMV RR (copy)_1569363757871665182], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[GMV RR (copy)_1569363757871665182], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;END' />
            </column>
