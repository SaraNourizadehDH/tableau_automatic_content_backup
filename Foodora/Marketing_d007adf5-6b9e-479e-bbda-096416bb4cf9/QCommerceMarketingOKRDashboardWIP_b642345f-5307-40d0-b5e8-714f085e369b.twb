            <column caption='Weekly Shoppers RR &amp; vs MoM' datatype='string' name='[MAU RR &amp; vs MoM (copy)_5191594901437202432]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*CASE [Display Dates]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([MAU RR]))&#10;        IF LEN(STR(ROUND(ATTR([MAU RR]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([MAU RR]),0)),(LEN(STR(ROUND(ATTR([MAU RR]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([MAU RR]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([MAU RR]),0)),LEN(STR(ROUND(ATTR([MAU RR]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([MAU RR]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([MAU RR]),0)),LEN(STR(ROUND(ATTR([MAU RR]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([MAU RR]),0)),3)&#10;        ELSE STR(ROUND(ATTR([MAU RR]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN &quot;NA&quot;&#10;        //STR(ROUND([MAU Target] * 100, 2)) + &quot;%&quot;&#10;    //WHEN &quot;Vs Target&quot; THEN &quot;NA&quot;&#10;       //[MAU Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [MAU RR Date Trends]&#10;END*/&#10;CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([MAU RR]))&#10;        IF LEN(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)),(LEN(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)),LEN(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)),LEN(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0)),3)&#10;        ELSE STR(ROUND(ATTR([MAU RR (copy)_5191594901438930946]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND(ATTR([Dmart Targets].[Weekly Shoppers Target]),0))&#10;        IF LEN(STR(ROUND([MAU Target (copy)_5191594901438767105],0)))&gt;3 THEN LEFT(STR(ROUND([MAU Target (copy)_5191594901438767105],0)),(LEN(STR(ROUND([MAU Target (copy)_5191594901438767105],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([MAU Target (copy)_5191594901438767105],0)))&gt;9 THEN MID(STR(ROUND([MAU Target (copy)_5191594901438767105],0)),LEN(STR(ROUND([MAU Target (copy)_5191594901438767105],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([MAU Target (copy)_5191594901438767105],0)))&gt;6 THEN MID(STR(ROUND([MAU Target (copy)_5191594901438767105],0)),LEN(STR(ROUND([MAU Target (copy)_5191594901438767105],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([MAU Target (copy)_5191594901438767105],0)),3)&#10;        ELSE STR(ROUND([MAU Target (copy)_5191594901438767105],0))&#10;    END&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[MAU Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [MAU RR Date Trends (copy)_5191594901439512580]&#10;END'>
                <table-calc ordering-type='Rows' />
