          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='GMV Net RR' datatype='real' name='[Calculation_6156913286683598851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='GMV Net Target' datatype='real' name='[GMV Gross Target (copy)_1439744506102632448]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[GMV Gross Target (copy)_5191594907095273506])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[GMV Gross Target (copy)_1068690118048407552])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='GMV Net RR &amp; vs MoM' datatype='string' name='[GMV RR &amp; vs Target (copy)_3405284332711874561]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([GMV RR]))&#10;        IF LEN(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)),(LEN(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)),LEN(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)),LEN(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([Calculation_6156913286683598851]),0)),3)&#10;        ELSE STR(ROUND(ATTR([Calculation_6156913286683598851]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR([GMV Target])&#10;        IF LEN(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)))&gt;3 THEN LEFT(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)),(LEN(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)))&gt;9 THEN MID(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)),LEN(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)))&gt;6 THEN MID(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)),LEN(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0)),3)&#10;        ELSE STR(ROUND([GMV Gross Target (copy)_1439744506102632448],0))&#10;    END&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[GMV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       STR([GMV RR Δ % (copy)_4791900436335083527])&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV Net RR Date Trends Colour' datatype='string' name='[GMV RR Date Trends (copy)_4791900436392034313]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Calculation_6156913286683598851])) - LOOKUP(ZN(SUM([Calculation_6156913286683598851])),1)) / LOOKUP(ZN(SUM([Calculation_6156913286683598851])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Calculation_6156913286683598851])) - LOOKUP(ZN(SUM([Calculation_6156913286683598851])),1)) / LOOKUP(ZN(SUM([Calculation_6156913286683598851])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
