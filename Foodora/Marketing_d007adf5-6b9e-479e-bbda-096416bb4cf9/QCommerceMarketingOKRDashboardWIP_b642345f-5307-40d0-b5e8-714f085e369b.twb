            </column>
            <column caption='ac_30d_ago_organic_with_pro_reorder RR' datatype='real' name='[GMV RR (copy)_6156913287067394104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN [ac_30d_ago_organic_with_pro_reorder] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE [ac_30d_ago_organic_with_pro_reorder]&#10;END' />
