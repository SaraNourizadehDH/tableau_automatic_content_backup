      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
            <datasource caption='Dmart Targets' name='federated.12dqj351omgupp1c9d8rc1ur97m9' />
            <datasource caption='Shops Targets' name='federated.0l2wv2s19fwbqt1bu8w0b08brspu' />
            <datasource caption='QC Targets' name='federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Run Rate' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;RR On&quot;'>
              <calculation class='tableau' formula='&quot;RR On&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0l2wv2s19fwbqt1bu8w0b08brspu'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)'>
            <column caption='Platform GMV Net Target' datatype='integer' name='[Calculation_5191594907094937633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        [Platform Net GMV EUR]&#10;    WHEN &quot;LC&quot; THEN&#10;        [Platform Net GMV EUR]&#10;END' />
            </column>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Platform Net GMV EUR]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12dqj351omgupp1c9d8rc1ur97m9'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6156913286805508114]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Platform GMV Net Target Δ' datatype='string' name='[GMV Gross Target Δ (copy)_5191594907144286243]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;            IF (SUM([GMV RR (copy)_3405284332771225615]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Calculation_5191594907094937633]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;    WHEN &quot;LC&quot; THEN&#10;            IF (SUM([GMV RR (copy)_3405284332771225615]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Calculation_5191594907094937633]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;            STR(ROUND(((SUM([GMV RR (copy)_3405284332771225615]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Calculation_5191594907094937633]) - 1) * 100),1)) + &apos;%&apos;&#10;    WHEN &quot;LC&quot; THEN&#10;            STR(ROUND(((SUM([GMV RR (copy)_3405284332771225615]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Calculation_5191594907094937633]) - 1) * 100),1)) + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Platform GMV Net Target Δ Colour' datatype='string' name='[GMV Gross Target Δ Colour (copy)_5191594907162935332]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;            IF (SUM([GMV RR (copy)_3405284332771225615]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Calculation_5191594907094937633]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos;&#10;            END&#10;END' />
            </column>
            <column caption='Platform GMV Net RR' datatype='real' name='[GMV RR (copy)_3405284332771225615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [platform_total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [platform_total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [platform_total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [platform_total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [platform_total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [platform_total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='Target Header' datatype='string' name='[W-1 (copy)_6156913286815711253]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;vs Target&quot;' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
