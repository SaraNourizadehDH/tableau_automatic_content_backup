            </column>
            <column caption='Weekly Shoppers Target' datatype='integer' name='[MAU Target (copy)_5191594901438767105]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='//IF ATTR([Vertical]) = &quot;Pandamart&quot; THEN&#10;    //0&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //0&#10;IF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Weekly Shoppers]) &#10;END' />
            </column>
