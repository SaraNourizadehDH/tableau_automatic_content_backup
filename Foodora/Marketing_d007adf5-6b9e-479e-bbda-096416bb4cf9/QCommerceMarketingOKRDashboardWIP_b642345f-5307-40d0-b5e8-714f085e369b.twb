            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column caption='Fresh PP Target' datatype='real' name='[Fresh User Penetration]' role='measure' type='quantitative' />
            <column caption='GMV Net Target' datatype='real' name='[GMV Gross Target (copy)_5191594907095273506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        [Net GMV EUR]&#10;    WHEN &quot;LC&quot; THEN&#10;        [Net GMV LCY]&#10;END' />
            </column>
            <column caption='ABV Target' datatype='real' name='[GMV Target (copy)_1273885407426375682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        [ABV (EUR)]&#10;    WHEN &quot;LC&quot; THEN&#10;        [ABV (LCY)]&#10;END' />
            </column>
            <column caption='MAU % Target' datatype='real' name='[MAU Platform Penetration (PENDING Budget)]' role='measure' type='quantitative' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Net GMV EUR]' role='measure' type='quantitative' />
            <column datatype='real' name='[Net GMV LCY]' role='measure' type='quantitative' />
            <column caption='iCPGMV Net Target' datatype='real' name='[Net fp mktg iCPGMV]' role='measure' type='quantitative' />
            <column caption='Sessions Target' datatype='real' name='[Sessions]' role='measure' type='quantitative' />
            <column caption='Orders Target' datatype='integer' name='[Total Orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Incentivised ABV' datatype='real' name='[ABV (copy)_1569363757513420807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Incentivised (copy)_6405596463705165838] / [total_incentivised_orders]' />
            </column>
            <column caption='ABV RR vs Target' datatype='real' name='[ABV Target Δ (copy)_4804777897127182398]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[GMV Target (copy)_1273885407426375682]) - 1), 3)&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[GMV Target (copy)_1273885408076664838]) - 1), 3)&#10;        //ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN 0&#10;            //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[GMV Target (copy)_1273885407426375682]) - 1), 3)&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            ROUND((SUM([GMV (copy)_1569363757468827649]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[GMV Target (copy)_1273885408076664838]) - 1), 3)&#10;        //ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN 0&#10;            //SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    //ELSE 0&#10;END' />
            </column>
            <column caption='GMV Net RR' datatype='real' name='[Calculation_6156913286683598851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6156913286805508114]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Date Filter' datatype='date' name='[Date Range (copy)_4804777897118273592]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Private Label GFV Share RR' datatype='real' name='[Fresh PP RR (copy)_6156913287118286941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] IN (&quot;Pandamart&quot;) THEN [GMV RR (copy)_6156913287114444889] / [GFV RR (EUR) (copy)_3285938884140371968] END' />
            </column>
            <column caption='Private Label GFV Share Target' datatype='real' name='[Fresh PP Target (copy)_4804777896743157813]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Private Label GPV Share])&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //ATTR([Shops Targets].[PL Share Target])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Fresh Customer Penetration RR vs Target' datatype='real' name='[Fresh PP Target Δ (copy)_4804777897130315840]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ROUND((SUM([iCPGMV RR (copy)_6156913287106781265]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration])), 3)&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //STR(ROUND(((SUM([MAU RR]) - SUM([Shops Targets].[MAU Target])) * 100), 3))&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;//ELSE 0&#10;END' />
            </column>
            <column caption='Private Label Total GFV RR' datatype='real' name='[GFV RR (EUR) (copy)_3285938884140371968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [total_private_label_gfv_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [total_private_label_gfv_eur]&#10;    END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [total_private_label_gfv_eur] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [total_private_label_gfv_eur]&#10;    END&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[GMV (copy)_1569363757468827649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV (copy)_6405596463705010189] / [total_valid_orders]' />
            </column>
            <column caption='GFV' datatype='real' name='[GMV (copy)_6405596463705010189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        [total_gfv_eur]&#10;    WHEN &quot;LC&quot; THEN&#10;        [total_gfv_local]&#10;END' />
            </column>
            <column caption='GMV Net RR vs Target %' datatype='real' name='[GMV Gross RR vs Target % (copy)_1439744506140553217]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            ROUND((SUM([Calculation_6156913286683598851]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Net GMV EUR]) - 1), 3)&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            ROUND((SUM([Calculation_6156913286683598851]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Net GMV EUR]) - 1), 3)&#10;        //ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN 0&#10;            //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            ROUND((SUM([Calculation_6156913286683598851]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Net GMV LCY]) - 1), 3)&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            ROUND((SUM([Calculation_6156913286683598851]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Net GMV LCY]) - 1), 3)&#10;        //ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN 0&#10;            //SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    //ELSE 0&#10;END' />
