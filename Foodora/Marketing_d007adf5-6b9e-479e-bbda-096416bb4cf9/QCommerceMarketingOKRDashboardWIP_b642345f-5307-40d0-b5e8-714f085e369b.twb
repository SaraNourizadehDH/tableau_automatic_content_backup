      <column caption='EC Net GMV RR' datatype='real' name='[NTV GMV RR (copy)_3285938885909118979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([total_gmv_net_eur] - [total_gmv_net_eur_ntp] - [total_gmv_net_eur_ntv]) / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur] - [total_gmv_net_eur_ntp] - [total_gmv_net_eur_ntv]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([total_gmv_net_local] - [total_gmv_net_local_ntp] - [total_gmv_net_local_ntv]) / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local] - [total_gmv_net_local_ntp] - [total_gmv_net_local_ntv]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur] - [total_gmv_net_eur_ntp] - [total_gmv_net_eur_ntv]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local] - [total_gmv_net_local_ntp] - [total_gmv_net_local_ntv]&#10;    END&#10;END' />
      </column>
      <column caption='EC Incentive Cost RR' datatype='real' name='[NTV Incentive Cost RR (copy)_3285938885908586498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([incentive_cost_fp_marketing_eur] - [incentive_cost_fp_marketing_eur_ntp] - incentive_cost_fp_marketing_eur_ntv) / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_eur] - [incentive_cost_fp_marketing_eur_ntp] - incentive_cost_fp_marketing_eur_ntv&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([incentive_cost_fp_marketing_local] - [incentive_cost_fp_marketing_local_ntp] - incentive_cost_fp_marketing_local_ntv) / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_local] - [incentive_cost_fp_marketing_local_ntp] - incentive_cost_fp_marketing_local_ntv&#10;            END&#10;        END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [incentive_cost_fp_marketing_eur] - [incentive_cost_fp_marketing_eur_ntp] - incentive_cost_fp_marketing_eur_ntv&#10;            WHEN &quot;LC&quot; THEN&#10;                [incentive_cost_fp_marketing_local] - [incentive_cost_fp_marketing_local_ntp] - incentive_cost_fp_marketing_local_ntv&#10;    END&#10;END' />
      </column>
