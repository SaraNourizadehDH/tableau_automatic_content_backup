              <calculation class='tableau' formula='&quot;Date Trends&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='GFV Non Incentivised' datatype='real' name='[GMV Non Incentivised (copy)_6405596463705243663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        [total_gfv_eur] - [total_incentivised_gfv_eur]&#10;    WHEN &quot;LC&quot; THEN&#10;        [total_gfv_local] - [total_incentivised_gfv_local]&#10;END' />
            </column>
            <column caption='Non Incentivised ABV &amp; vs MoM' datatype='string' name='[Incentivised ABV &amp; vs MoM (copy)_4599019710353358863]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([Incentivised ABV (copy)_1569363757520175119]), 2))&#10;    WHEN &quot;Targets&quot; THEN NULL&#10;        //STR(ROUND([ABV Target], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [Incentivised ABV Date Trends (copy)_4599019710352674829]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Non Incentivised ABV' datatype='real' name='[Incentivised ABV (copy)_1569363757520175119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Non Incentivised (copy)_6405596463705243663] / [total_incentivised_orders_with_pro (copy)_1569363757520003086]' />
            </column>
            <column caption='Non Incentivised ABV Date Trends' datatype='string' name='[Incentivised ABV Date Trends (copy)_4599019710352674829]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Incentivised ABV (copy)_1569363757520175119])) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Incentivised ABV (copy)_1569363757520175119]) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Incentivised ABV (copy)_1569363757520175119])) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Incentivised ABV (copy)_1569363757520175119]) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Non Incentivised ABV Date Trends Colour' datatype='string' name='[Incentivised ABV Date Trends Colour (copy)_4599019710353002510]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Incentivised ABV (copy)_1569363757520175119])) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Incentivised ABV (copy)_1569363757520175119])) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
