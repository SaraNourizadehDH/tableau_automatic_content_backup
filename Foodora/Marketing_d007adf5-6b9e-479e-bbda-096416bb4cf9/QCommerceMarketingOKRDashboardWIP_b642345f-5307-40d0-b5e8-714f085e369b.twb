              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart New To Vertical])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[New To Vertical])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='NTV Target Δ' datatype='string' name='[Sessions Target Δ (copy)_6156913287046373414]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([Sessions RR (copy)_6156913287042859041]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart New To Vertical]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([Sessions RR (copy)_6156913287042859041]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[New To Vertical]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot;&#10;    THEN STR(ROUND(((SUM([Sessions RR (copy)_6156913287042859041]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart New To Vertical]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot;&#10;    THEN STR(ROUND(((SUM([Sessions RR (copy)_6156913287042859041]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[New To Vertical]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;END' />
