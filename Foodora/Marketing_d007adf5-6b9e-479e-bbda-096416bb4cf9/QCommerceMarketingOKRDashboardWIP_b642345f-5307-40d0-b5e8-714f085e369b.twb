              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -2, TODAY()))' />
            </column>
            <column caption='M-0' datatype='boolean' name='[W-1 (copy)_6156913286740422664]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 0, TODAY()))' />
            </column>
            <column caption='GMV Net RR Δ %' datatype='string' name='[WoW Δ (%) GMV EUR (copy)_6156913286732328966]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[Calculation_6156913286683598851], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Calculation_6156913286683598851], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[Calculation_6156913286683598851],0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[Calculation_6156913286683598851], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Calculation_6156913286683598851], 0)))&#10;     / &#10;     SUM(IIF([W-1 (copy)_6156913286732079109],[Calculation_6156913286683598851], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[Calculation_6156913286683598851], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Calculation_6156913286683598851], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[Calculation_6156913286683598851], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[Calculation_6156913286683598851], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Calculation_6156913286683598851], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[Calculation_6156913286683598851], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
