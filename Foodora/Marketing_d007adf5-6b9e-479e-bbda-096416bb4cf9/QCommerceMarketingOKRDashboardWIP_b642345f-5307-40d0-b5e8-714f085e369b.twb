          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='GMV Net RR' datatype='real' name='[Calculation_6156913286683598851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='GMV Net Target Δ' datatype='string' name='[Calculation_6156913286760349708]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            IF (SUM([Calculation_6156913286683598851]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Net GMV EUR]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            IF (SUM([Calculation_6156913286683598851]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Net GMV EUR]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            IF (SUM([Calculation_6156913286683598851]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Net GMV LCY]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            IF (SUM([Calculation_6156913286683598851]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Net GMV LCY]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        END&#10;    //ELSE 0&#10;END&#10;+ &apos; &apos; +&#10;CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            STR(ROUND(((SUM([Calculation_6156913286683598851]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Net GMV EUR]) - 1) * 100),1)) + &apos;%&apos;&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            STR(ROUND(((SUM([Calculation_6156913286683598851]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Net GMV EUR]) - 1) * 100),1)) + &apos;%&apos;&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            STR(ROUND(((SUM([Calculation_6156913286683598851]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Net GMV LCY]) - 1) * 100),1)) + &apos;%&apos;&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            STR(ROUND(((SUM([Calculation_6156913286683598851]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Net GMV LCY]) - 1) * 100),1)) + &apos;%&apos;&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    //ELSE 0&#10;END' />
            </column>
