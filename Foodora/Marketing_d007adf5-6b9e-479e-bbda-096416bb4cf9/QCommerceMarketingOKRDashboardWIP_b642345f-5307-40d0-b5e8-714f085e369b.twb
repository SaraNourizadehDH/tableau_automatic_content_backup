            <column caption='Platform GMV Net RR &amp; vs Target' datatype='string' name='[GMV RR &amp; vs Target (copy)_3405284332771061774]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([GMV RR]))&#10;        IF LEN(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)),(LEN(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)),LEN(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)),LEN(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0)),3)&#10;        ELSE STR(ROUND(ATTR([GMV RR (copy)_3405284332771225615]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        NULL&#10;    WHEN &quot;Vs Target&quot; THEN&#10;        NULL&#10;       //[Platform GMV Net Target Δ]&#10;    //WHEN &quot;Date Trends&quot; THEN&#10;       //[GMV RR Date Trends]&#10;END' />
            </column>
            <column caption='Platform GMV Net RR' datatype='real' name='[GMV RR (copy)_3405284332771225615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [platform_total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [platform_total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [platform_total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [platform_total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [platform_total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [platform_total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='Platform GMV Net RR AVG' datatype='real' name='[Platform Sessions RR AVG (copy)_3405284332772569105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([GMV RR (copy)_3405284332771225615]), FIRST(), FIRST()+6)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Platform GMV Net RR Colour' datatype='integer' name='[Platform Sessions RR Colour (copy)_3405284332772978706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([GMV RR (copy)_3405284332771225615]) - [Platform Sessions RR AVG (copy)_3405284332772569105]) / [Platform Sessions RR AVG (copy)_3405284332772569105] &gt;= 0.2 THEN 2&#10;ELSEIF (SUM([GMV RR (copy)_3405284332771225615]) - [Platform Sessions RR AVG (copy)_3405284332772569105]) / [Platform Sessions RR AVG (copy)_3405284332772569105] &lt;= -0.2 THEN -2&#10;ELSEIF (SUM([GMV RR (copy)_3405284332771225615]) - [Platform Sessions RR AVG (copy)_3405284332772569105]) / [Platform Sessions RR AVG (copy)_3405284332772569105] &lt;= -0.1 THEN -1&#10;ELSEIF (SUM([GMV RR (copy)_3405284332771225615]) - [Platform Sessions RR AVG (copy)_3405284332772569105]) / [Platform Sessions RR AVG (copy)_3405284332772569105] &gt;= 0.1 THEN 1&#10;ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
