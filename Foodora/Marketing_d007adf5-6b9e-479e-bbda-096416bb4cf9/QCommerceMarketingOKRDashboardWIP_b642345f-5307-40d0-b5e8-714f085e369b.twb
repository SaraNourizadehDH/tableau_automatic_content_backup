              <calculation class='tableau' formula='[GMV RR (copy)_6156913287067394104] / IFNULL([ac_30d_ago_organic_with_pro_reorder RR (copy)_6156913287067619385], [cohort_user_count])' />
            </column>
            <column caption='Organic Retention RR Δ %' datatype='string' name='[iCPGMV RR Δ % (copy)_6156913287088586817]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF SUM(IIF([Calculation_6156913286731837444],[iCPGMV RR (copy)_6156913287067779130], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[iCPGMV RR (copy)_6156913287067779130], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[iCPGMV RR (copy)_6156913287067779130], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[iCPGMV RR (copy)_6156913287067779130], 0))) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF SUM(IIF([W-1 (copy)_6156913286740422664],[iCPGMV RR (copy)_6156913287067779130], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[iCPGMV RR (copy)_6156913287067779130], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[iCPGMV RR (copy)_6156913287067779130], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[iCPGMV RR (copy)_6156913287067779130], 0))) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Organic Retention RR Δ Colour' datatype='string' name='[iCPGMV RR Δ Colour (copy)_6156913287086481470]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF SUM(IIF([Calculation_6156913286731837444],[iCPGMV RR (copy)_6156913287067779130], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[iCPGMV RR (copy)_6156913287067779130], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF SUM(IIF([W-1 (copy)_6156913286740422664],[iCPGMV RR (copy)_6156913287067779130], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[iCPGMV RR (copy)_6156913287067779130], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;END' />
