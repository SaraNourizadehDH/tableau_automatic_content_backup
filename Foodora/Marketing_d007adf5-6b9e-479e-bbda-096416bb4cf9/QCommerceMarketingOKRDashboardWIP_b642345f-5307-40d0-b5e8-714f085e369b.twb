    <worksheet name='6b N GMV Share Δ'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Run Rate' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;RR On&quot;'>
              <calculation class='tableau' formula='&quot;RR On&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_2022890300484079616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Week&quot; THEN &quot;WoW Δ&quot;&#10;ELSEIF [date_type] = &quot;Month&quot; then &quot;MoM Δ&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='GMV Net RR' datatype='real' name='[Calculation_6156913286683598851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='W-1' datatype='boolean' name='[Calculation_6156913286731837444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY()))' />
            </column>
            <column caption='Platform GMV Net RR' datatype='real' name='[GMV RR (copy)_3405284332771225615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [platform_total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [platform_total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [platform_total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [platform_total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [platform_total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [platform_total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='M-1' datatype='boolean' name='[M-0 (copy)_6156913286740725769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -1, TODAY()))' />
            </column>
            <column caption='GMV Net Share % RR' datatype='real' name='[Sessions Share % RR (copy)_4058517378487955466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6156913286683598851] / [GMV RR (copy)_3405284332771225615]' />
            </column>
            <column caption='GMV Net Share % RR Δ %' datatype='string' name='[Sessions Share % RR Δ % (copy)_4058517378501267476]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF SUM(IIF([Calculation_6156913286731837444],[Sessions Share % RR (copy)_4058517378487955466], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions Share % RR (copy)_4058517378487955466], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[Sessions Share % RR (copy)_4058517378487955466], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Sessions Share % RR (copy)_4058517378487955466], 0))) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF SUM(IIF([W-1 (copy)_6156913286740422664],[Sessions Share % RR (copy)_4058517378487955466], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions Share % RR (copy)_4058517378487955466], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[Sessions Share % RR (copy)_4058517378487955466], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Sessions Share % RR (copy)_4058517378487955466], 0))) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
