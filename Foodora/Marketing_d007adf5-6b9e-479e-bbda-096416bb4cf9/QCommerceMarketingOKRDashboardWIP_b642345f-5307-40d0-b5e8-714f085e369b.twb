            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Orders Target' datatype='real' name='[Total Orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12dqj351omgupp1c9d8rc1ur97m9'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Orders Target' datatype='integer' name='[Total Orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6156913286805508114]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Orders RR' datatype='real' name='[GMV RR (copy)_1569363757871665182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [total_valid_orders] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [total_valid_orders]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [total_valid_orders]&#10;END' />
            </column>
            <column caption='Orders Target Δ' datatype='string' name='[NTV Target Δ (copy)_1273885404958052352]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Total Orders]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Total Orders]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Total Orders]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Total Orders]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;END' />
            </column>
            <column caption='Orders Target Δ Colour' datatype='string' name='[NTV Target Δ Colour (copy)_1273885404959264769]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Total Orders]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Total Orders]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END' />
            </column>
            <column caption='Target Header' datatype='string' name='[W-1 (copy)_6156913286815711253]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;vs Target&quot;' />
