              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            IF (SUM([Calculation_6156913286683598851]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[GMV Gross Target (copy)_5191594907095273506]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;            IF (SUM([Calculation_6156913286683598851]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[GMV Gross Target (copy)_1068690118048407552]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR]) / SUM([QC Targets].[GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        END&#10;END' />
