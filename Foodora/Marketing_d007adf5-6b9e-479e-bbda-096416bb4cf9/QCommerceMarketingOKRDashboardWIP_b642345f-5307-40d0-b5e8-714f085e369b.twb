        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[report_date_local]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[report_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[report_date_local])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[report_date_local])),3)+&apos; &apos;+ right(str(DATEPART(&apos;year&apos;,[report_date_local])),2) end' />
