              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
