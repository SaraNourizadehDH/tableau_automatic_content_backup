      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Run Rate' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;RR On&quot;'>
              <calculation class='tableau' formula='&quot;RR On&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_2022890300484079616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Week&quot; THEN &quot;WoW Δ&quot;&#10;ELSEIF [date_type] = &quot;Month&quot; then &quot;MoM Δ&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='M-1' datatype='boolean' name='[M-0 (copy)_6156913286740725769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -1, TODAY()))' />
            </column>
            <column caption='M1 Retention RR Δ % ' datatype='string' name='[Organic Retention RR Δ % (copy)_6142839542323015688]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF SUM(IIF([W-1 (copy)_6156913286740422664],[Platform Sessions RR (copy)_6142839542264987648], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Platform Sessions RR (copy)_6142839542264987648], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[Platform Sessions RR (copy)_6142839542264987648], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Platform Sessions RR (copy)_6142839542264987648], 0)))&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF SUM(IIF([W-1 (copy)_6156913286740422664],[Platform Sessions RR (copy)_6142839542264987648], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Platform Sessions RR (copy)_6142839542264987648], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[Platform Sessions RR (copy)_6142839542264987648], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Platform Sessions RR (copy)_6142839542264987648], 0)))&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
