          <datasource-dependencies datasource='federated.12dqj351omgupp1c9d8rc1ur97m9'>
            <column caption='ABV Target (EUR Raw)' datatype='real' name='[ABV (EUR)]' role='measure' type='quantitative' />
            <column caption='ABV Target (LCY Raw)' datatype='integer' name='[ABV (LCY)]' role='measure' type='quantitative' />
