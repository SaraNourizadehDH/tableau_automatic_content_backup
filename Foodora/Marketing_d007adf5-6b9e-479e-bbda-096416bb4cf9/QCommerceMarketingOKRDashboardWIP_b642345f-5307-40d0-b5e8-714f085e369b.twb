            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -6, TODAY()))' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='Fresh Customer Penetration RR &amp; vs MoM' datatype='string' name='[iCPGMV RR &amp; vs MoM (copy)_4599019710367596576]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([iCPGMV RR (copy)_6156913287106781265]) * 100, 2)) + &quot;%&quot;&#10;    //WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND([iCPGMV Target] * 100, 2)) + &quot;%&quot;&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[iCPGMV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [iCPGMV RR Date Trends (copy)_4599019710367014942]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Fresh Customer Penetration RR' datatype='real' name='[iCPGMV RR (copy)_6156913287106781265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] IN (&quot;Pandamart&quot;) THEN [total_fresh_customers_mth (copy)_6156913287103414351] / [total_overall_customers_mth (copy)_6156913287103610960] END' />
            </column>
            <column caption='Fresh Customer Penetration RR Date Trends' datatype='string' name='[iCPGMV RR Date Trends (copy)_4599019710367014942]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([iCPGMV RR (copy)_6156913287106781265])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287106781265])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([iCPGMV RR (copy)_6156913287106781265]) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287106781265])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([iCPGMV RR (copy)_6156913287106781265])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287106781265])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([iCPGMV RR (copy)_6156913287106781265]) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287106781265])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Fresh Customer Penetration RR Date Trends Colour' datatype='string' name='[iCPGMV RR Date Trends Colour (copy)_4599019710367293471]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([iCPGMV RR (copy)_6156913287106781265])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287106781265])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([iCPGMV RR (copy)_6156913287106781265])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287106781265])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
