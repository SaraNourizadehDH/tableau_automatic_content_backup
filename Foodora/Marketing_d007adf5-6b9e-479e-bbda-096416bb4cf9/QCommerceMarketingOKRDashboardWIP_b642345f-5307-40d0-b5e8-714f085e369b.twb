              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [total_valid_orders] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [total_valid_orders]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [total_valid_orders]&#10;END' />
            </column>
            <column caption='Orders Target' datatype='real' name='[GMV Target (copy)_4804777896741064755]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[Total Orders])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Total Orders])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Orders Target Δ' datatype='string' name='[NTV Target Δ (copy)_1273885404958052352]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Total Orders]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Total Orders]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Total Orders]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_1569363757871665182]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Total Orders]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;END' />
            </column>
            <column caption='Orders RR &amp; vs Target' datatype='string' name='[Orders RR (copy)_4804777888980422667]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([Orders RR]))&#10;        IF LEN(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)),(LEN(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)),LEN(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)),LEN(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0)),3)&#10;        ELSE STR(ROUND(ATTR([GMV RR (copy)_1569363757871665182]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ATTR([Orders Target]))&#10;        IF LEN(STR(ROUND([GMV Target (copy)_4804777896741064755],0)))&gt;3 THEN LEFT(STR(ROUND([GMV Target (copy)_4804777896741064755],0)),(LEN(STR(ROUND([GMV Target (copy)_4804777896741064755],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([GMV Target (copy)_4804777896741064755],0)))&gt;9 THEN MID(STR(ROUND([GMV Target (copy)_4804777896741064755],0)),LEN(STR(ROUND([GMV Target (copy)_4804777896741064755],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([GMV Target (copy)_4804777896741064755],0)))&gt;6 THEN MID(STR(ROUND([GMV Target (copy)_4804777896741064755],0)),LEN(STR(ROUND([GMV Target (copy)_4804777896741064755],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([GMV Target (copy)_4804777896741064755],0)),3)&#10;        ELSE STR(ROUND([GMV Target (copy)_4804777896741064755