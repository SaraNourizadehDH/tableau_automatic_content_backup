      </column>
      <column caption='Incentive Cost Pro Subscription RR' datatype='real' name='[Incentive Cost Pro Subscribers RR (copy)_619526469799518213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [incentive_cost_subscription_benefit_order_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_subscription_benefit_order_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [incentive_cost_subscription_benefit_order_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_subscription_benefit_order_local]&#10;            END&#10;        END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [incentive_cost_subscription_benefit_order_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [incentive_cost_subscription_benefit_order_local]&#10;    END&#10;END' />
      </column>
      <column caption='NTV Incentive Cost RR' datatype='real' name='[Incentive Cost RR (copy)_1107111503821705218]' role='measure' type='quantitative'>
