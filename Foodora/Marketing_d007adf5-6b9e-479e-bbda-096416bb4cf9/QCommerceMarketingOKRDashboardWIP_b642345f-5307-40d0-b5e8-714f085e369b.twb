            <column caption='Private Label GFV Share RR Δ %' datatype='string' name='[iCPGMV RR Δ % (copy)_6156913287122501728]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN (&#10;    IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;        IF SUM(IIF([Calculation_6156913286731837444],[Fresh PP RR (copy)_6156913287118286941], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Fresh PP RR (copy)_6156913287118286941], 0)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos; &#10;        END)&#10;&#10;        + STR(&#10;        ROUND(&#10;        (SUM(IIF([Calculation_6156913286731837444],[Fresh PP RR (copy)_6156913287118286941], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Fresh PP RR (copy)_6156913287118286941], 0))) * 100&#10;        ,1)&#10;        )&#10;&#10;        + &apos;%&apos;&#10;&#10;    ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;        IF SUM(IIF([W-1 (copy)_6156913286740422664],[Fresh PP RR (copy)_6156913287118286941], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Fresh PP RR (copy)_6156913287118286941], 0)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos; &#10;        END)&#10;    &#10;        + STR(&#10;        ROUND(&#10;        (SUM(IIF([W-1 (copy)_6156913286740422664],[Fresh PP RR (copy)_6156913287118286941], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Fresh PP RR (copy)_6156913287118286941], 0))) * 100&#10;        ,1)&#10;        )&#10;&#10;        + &apos;%&apos;&#10;    END)&#10;ELSE &quot;NA&quot;&#10;END' />
