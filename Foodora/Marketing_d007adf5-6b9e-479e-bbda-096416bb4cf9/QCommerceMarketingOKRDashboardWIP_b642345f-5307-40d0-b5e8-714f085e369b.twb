          <filter class='categorical' column='[federated.1wxo0ob0e60sow1680kli1iiuy4l].[none:vertical:nk]' filter-group='7'>
            <groupfilter function='member' level='[none:vertical:nk]' member='&quot;Q-Commerce&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
