              <calculation class='tableau' formula='/*CASE [Display Dates]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([MAU RR]))&#10;        IF LEN(STR(ROUND(ATTR([MAU RR]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([MAU RR]),0)),(LEN(STR(ROUND(ATTR([MAU RR]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([MAU RR]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([MAU RR]),0)),LEN(STR(ROUND(ATTR([MAU RR]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([MAU RR]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([MAU RR]),0)),LEN(STR(ROUND(ATTR([MAU RR]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([MAU RR]),0)),3)&#10;        ELSE STR(ROUND(ATTR([MAU RR]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN &quot;NA&quot;&#10;        //STR(ROUND([MAU Target] * 100, 2)) + &quot;%&quot;&#10;    //WHEN &quot;Vs Target&quot; THEN &quot;NA&quot;&#10;       //[MAU Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [MAU RR Date Trends]&#10;END*/&#10;CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([MAU RR]))&#10;        IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),(LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),3)&#10;        ELSE STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND(ATTR([Dmart Targets].[MAU Target]),0))&#10;        IF LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))&gt;3 THEN LEFT(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),(LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))&gt;9 THEN MID(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))&gt;6 THEN MID(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),3)&#10;        ELSE STR(ROUND([NTV Target (copy)_3507248622843781124],0))&#10;    END&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[MAU Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [GMV RR Date Trends (copy)_3405284332813000735]&#10;END'>
