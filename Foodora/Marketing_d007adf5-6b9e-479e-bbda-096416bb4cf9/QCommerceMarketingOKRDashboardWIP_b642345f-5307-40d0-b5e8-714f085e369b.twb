            <column caption='Healthy NTV RR &amp; vs MoM' datatype='string' name='[NTV RR &amp; vs MoM (copy)_5191594901497516049]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([NTV RR]))&#10;        IF LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),(LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),3)&#10;        ELSE STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND(ATTR([Dmart Targets].[NTV Target]),0))&#10;        IF LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))&gt;3 THEN LEFT(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),(LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))&gt;9 THEN MID(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))&gt;6 THEN MID(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),3)&#10;        ELSE STR(ROUND([Sessions Target (copy)_4804777896420888619],0))&#10;    END&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[NTV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [NTV RR Date Trends (copy)_5191594901495631888]&#10;END'>
                <table-calc ordering-type='Rows' />
