              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [total_ncs] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [total_ncs]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [total_ncs]&#10;END' />
            </column>
            <column caption='NC RR Δ %' datatype='string' name='[NTV RR Δ % (copy)_1288029528040275969]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[NTV RR (copy)_4951215257781706753], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[NTV RR (copy)_4951215257781706753], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[NTV RR (copy)_4951215257781706753], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[NTV RR (copy)_4951215257781706753], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[NTV RR (copy)_4951215257781706753], 0)))&#10;     / &#10;     SUM(IIF([W-1 (copy)_6156913286732079109],[NTV RR (copy)_4951215257781706753], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[NTV RR (copy)_4951215257781706753], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_4951215257781706753], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_4951215257781706753], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[NTV RR (copy)_4951215257781706753], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_4951215257781706753], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_4951215257781706753], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
            <column caption='NC RR Δ Colour' datatype='string' name='[NTV RR Δ Colour (copy)_1288029528040083456]' role='measure' type='nominal'>
