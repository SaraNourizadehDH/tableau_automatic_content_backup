            <column caption='GMV Net Share % RR &amp; vs MoM' datatype='string' name='[Sessions Share % RR &amp; vs MoM (copy)_4058517378499694605]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([Sessions Share % RR (copy)_4058517378487955466]) * 100, 1)) + &quot;%&quot;&#10;    //WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND([ABV Target], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [Sessions Share % RR Date Trends (copy)_4058517378500554768]&#10;END'>
