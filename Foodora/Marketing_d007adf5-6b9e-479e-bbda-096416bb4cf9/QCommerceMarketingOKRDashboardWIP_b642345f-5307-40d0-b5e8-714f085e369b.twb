            <column caption='Fresh Customer Penetration RR' datatype='real' name='[iCPGMV RR (copy)_6156913287106781265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] IN (&quot;Pandamart&quot;) THEN [total_fresh_customers_mth (copy)_6156913287103414351] / [total_overall_customers_mth (copy)_6156913287103610960] END' />
            </column>
