      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
          </datasources>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_2022890300484079616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Week&quot; THEN &quot;WoW Δ&quot;&#10;ELSEIF [date_type] = &quot;Month&quot; then &quot;MoM Δ&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='M-1' datatype='boolean' name='[M-0 (copy)_6156913286740725769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -1, TODAY()))' />
            </column>
            <column caption='Weekly Shoppers RR' datatype='integer' name='[MAU RR (copy)_5191594901438930946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[weekly_shoppers_cust]' />
            </column>
            <column caption='Weekly Shoppers RR Δ %' datatype='string' name='[MAU RR Δ % (copy)_5191594901473247243]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[MAU RR (copy)_5191594901438930946], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[MAU RR (copy)_5191594901438930946], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[MAU RR (copy)_5191594901438930946], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[MAU RR (copy)_5191594901438930946], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[MAU RR (copy)_5191594901438930946], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[MAU RR (copy)_5191594901438930946], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
