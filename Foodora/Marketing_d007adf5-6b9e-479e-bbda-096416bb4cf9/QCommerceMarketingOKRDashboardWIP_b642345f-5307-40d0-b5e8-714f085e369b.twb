          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='MAU % RR &amp; vs MoM' datatype='string' name='[MAU % RR &amp; vs Target (copy)_4599019710335139845]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([Organic Retention RR (copy)_6156913287094050887]) * 100, 2)) + &quot;%&quot;&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([Organic Retention Target (copy)_4804777896732852272] * 100, 2)) + &quot;%&quot;&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[MAU % Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [Organic Retention RR Date Trends (copy)_4599019710333374467]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MAU % RR' datatype='real' name='[Organic Retention RR (copy)_6156913287094050887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[num_of_sh_customers_in_delivery_area_cnty RR] / [num_of_customers_in_delivery_area_cnty RR]&#10;[num_of_sh_customers_in_delivery_area_cnty] / [num_of_customers_in_delivery_area_cnty]' />
            </column>
            <column caption='MAU % RR Date Trends' datatype='string' name='[Organic Retention RR Date Trends (copy)_4599019710333374467]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Organic Retention RR (copy)_6156913287094050887])) - LOOKUP(ZN(SUM([Organic Retention RR (copy)_6156913287094050887])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Organic Retention RR (copy)_6156913287094050887]) - LOOKUP(ZN(SUM([Organic Retention RR (copy)_6156913287094050887])),1)) * 100&#10;    ,2)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Organic Retention RR (copy)_6156913287094050887])) - LOOKUP(ZN(SUM([Organic Retention RR (copy)_6156913287094050887])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Organic Retention RR (copy)_6156913287094050887]) - LOOKUP(ZN(SUM([Organic Retention RR (copy)_6156913287094050887])),1)) * 100&#10;    ,2)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MAU % RR Date Trends Colour' datatype='string' name='[Organic Retention RR Date Trends Colour (copy)_4599019710334795780]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Organic Retention RR (copy)_6156913287094050887])) - LOOKUP(ZN(SUM([Organic Retention RR (copy)_6156913287094050887])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Organic Retention RR (copy)_6156913287094050887])) - LOOKUP(ZN(SUM([Organic Retention RR (copy)_6156913287094050887])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MAU % Target' datatype='real' name='[Organic Retention Target (copy)_4804777896732852272]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU Platform Penetration (PENDING Budget)])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Penetration % Platform MAUs])&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC % of MAU])&#10;END' />
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -6, TODAY()))' />
            </column>
