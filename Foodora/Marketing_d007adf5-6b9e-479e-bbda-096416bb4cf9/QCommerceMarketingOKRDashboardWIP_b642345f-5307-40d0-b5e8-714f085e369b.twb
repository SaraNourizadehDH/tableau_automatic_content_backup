        <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Incentivised ABV (copy)_1569363757520175119])) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Incentivised ABV (copy)_1569363757520175119]) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Incentivised ABV (copy)_1569363757520175119])) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Incentivised ABV (copy)_1569363757520175119]) - LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1)) / LOOKUP(ZN(SUM([Incentivised ABV (copy)_1569363757520175119])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
