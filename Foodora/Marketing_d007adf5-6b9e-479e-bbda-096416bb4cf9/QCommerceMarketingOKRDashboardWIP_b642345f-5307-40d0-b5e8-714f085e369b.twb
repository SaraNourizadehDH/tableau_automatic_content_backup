          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
            <datasource caption='Dmart Targets' name='federated.12dqj351omgupp1c9d8rc1ur97m9' />
            <datasource caption='Shops Targets' name='federated.0l2wv2s19fwbqt1bu8w0b08brspu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Display Targets' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Numbers&quot;'>
              <calculation class='tableau' formula='&quot;Numbers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0l2wv2s19fwbqt1bu8w0b08brspu'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12dqj351omgupp1c9d8rc1ur97m9'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column caption='Fresh PP Target' datatype='real' name='[Fresh User Penetration]' role='measure' type='quantitative' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Fresh Customer Penetration RR &amp; vs Target' datatype='string' name='[Fresh PP RR &amp; vs Target (copy)_619526468813680640]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([iCPGMV RR (copy)_6156913287106781265]) * 100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([NTV Target (copy)_4804777896742268980] * 100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [MAU Target Δ (copy)_6156913287111794774]&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;       //[Fresh PP Target Δ]&#10;END' />
            </column>
            <column caption='Fresh Customer Penetration Target Δ Colours' datatype='string' name='[Fresh Target Δ Colour (copy)_3643482502426034184]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([iCPGMV RR (copy)_6156913287106781265]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //IF (SUM([MAU RR]) / SUM([Shops Targets].[MAU Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;END' />
            </column>
            <column caption='Fresh Customer Penetration Target Δ' datatype='string' name='[MAU Target Δ (copy)_6156913287111794774]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([iCPGMV RR (copy)_6156913287106781265]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot;&#10;    //IF (SUM([MAU RR]) - SUM([Shops Targets].[MAU Target])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSE &apos;&apos;&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    STR(ROUND(((SUM([iCPGMV RR (copy)_6156913287106781265]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration])) * 100), 1)) + &apos;%&apos;&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //STR(ROUND(((SUM([MAU RR]) - SUM([Shops Targets].[MAU Target])) * 100), 1))&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Fresh Customer Penetration Target' datatype='real' name='[NTV Target (copy)_4804777896742268980]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration])&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //ATTR([Shops Targets].[Fresh PP Target])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='Fresh Customer Penetration RR' datatype='real' name='[iCPGMV RR (copy)_6156913287106781265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] IN (&quot;Pandamart&quot;) THEN [total_fresh_customers_mth (copy)_6156913287103414351] / [total_overall_customers_mth (copy)_6156913287103610960] END' />
            </column>
            <column-instance column='[report_date_local]' derivation='Max' name='[max:report_date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2288180497498427399]' derivation='Min' name='[min:Calculation_2288180497498427399:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2022890300484169729]' derivation='None' name='[none:Calculation_2022890300484169729:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_type]' derivation='None' name='[none:date_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date_local]' derivation='None' name='[none:report_date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column caption='Fresh Customers' datatype='integer' name='[total_fresh_customers]' role='measure' type='quantitative' />
            <column caption='total_fresh_customers RR' datatype='real' name='[total_fresh_customers_mth (copy)_6156913287103414351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN [total_fresh_customers] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE [total_fresh_customers]&#10;END' />
            </column>
            <column datatype='integer' name='[total_overall_customers]' role='measure' type='quantitative' />
            <column caption='total_overall_customers RR' datatype='real' name='[total_overall_customers_mth (copy)_6156913287103610960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN [total_overall_customers] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE [total_overall_customers]&#10;END' />
            </column>
            <column-instance column='[Fresh PP RR &amp; vs Target (copy)_619526468813680640]' derivation='User' name='[usr:Fresh PP RR &amp; vs Target (copy)_619526468813680640:nk]' pivot='key' type='nominal' />
            <column-instance column='[Fresh Target Δ Colour (copy)_3643482502426034184]' derivation='User' name='[usr:Fresh Target Δ Colour (copy)_3643482502426034184:nk]' pivot='key' type='nominal' />
            <column caption='Vertical' datatype='string' name='[vertical]' role='dimension' type='nominal' />
          </datasource-dependencies>
