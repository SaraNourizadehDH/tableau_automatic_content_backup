          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6156913286805508114]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='ac_30d_ago_organic_with_pro_reorder RR' datatype='real' name='[GMV RR (copy)_6156913287067394104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN [ac_30d_ago_organic_with_pro_reorder] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE [ac_30d_ago_organic_with_pro_reorder]&#10;END' />
            </column>
            <column caption='Target Header' datatype='string' name='[W-1 (copy)_6156913286815711253]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;vs Target&quot;' />
            </column>
            <column datatype='integer' name='[ac_30d_ago]' role='measure' type='quantitative' />
            <column caption='ac_30d_ago RR' datatype='real' name='[ac_30d_ago_organic_with_pro_reorder RR (copy)_6156913287067619385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN IIF([ac_30d_ago] = 0, [cohort_user_count], [ac_30d_ago]) / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE IIF([ac_30d_ago] = 0, [cohort_user_count], [ac_30d_ago])&#10;END' />
            </column>
            <column datatype='integer' name='[ac_30d_ago_organic_with_pro_reorder]' role='measure' type='quantitative' />
