            <column caption='Private Label GFV Share RR Date Trends' datatype='string' name='[Fresh Customer Penetration RR Date Trends (copy)_4599019710369783841]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Fresh PP RR (copy)_6156913287118286941])) - LOOKUP(ZN(SUM([Fresh PP RR (copy)_6156913287118286941])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Fresh PP RR (copy)_6156913287118286941]) - LOOKUP(ZN(SUM([Fresh PP RR (copy)_6156913287118286941])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Fresh PP RR (copy)_6156913287118286941])) - LOOKUP(ZN(SUM([Fresh PP RR (copy)_6156913287118286941])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Fresh PP RR (copy)_6156913287118286941]) - LOOKUP(ZN(SUM([Fresh PP RR (copy)_6156913287118286941])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Private Label GFV Share RR Date Trends Colour' datatype='string' name='[Fresh Customer Penetration RR Date Trends Colour (copy)_4599019710370218018]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Fresh PP RR (copy)_6156913287118286941])) - LOOKUP(ZN(SUM([Fresh PP RR (copy)_6156913287118286941])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Fresh PP RR (copy)_6156913287118286941])) - LOOKUP(ZN(SUM([Fresh PP RR (copy)_6156913287118286941])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
