            </column>
            <column caption='M-1' datatype='boolean' name='[M-0 (copy)_6156913286740725769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -1, TODAY()))' />
            </column>
            <column caption='Fresh Customer Penetration RR Δ %' datatype='string' name='[MAU RR Δ % (copy)_6156913287109791828]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN (&#10;    IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;        IF SUM(IIF([Calculation_6156913286731837444],[iCPGMV RR (copy)_6156913287106781265], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[iCPGMV RR (copy)_6156913287106781265], 0)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos; &#10;        END)&#10;&#10;        + STR(&#10;        ROUND(&#10;        (SUM(IIF([Calculation_6156913286731837444],[iCPGMV RR (copy)_6156913287106781265], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[iCPGMV RR (copy)_6156913287106781265], 0))) * 100&#10;        ,1)&#10;        )&#10;&#10;        + &apos;%&apos;&#10;&#10;    ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;        IF SUM(IIF([W-1 (copy)_6156913286740422664],[iCPGMV RR (copy)_6156913287106781265], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[iCPGMV RR (copy)_6156913287106781265], 0)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos; &#10;        END)&#10;&#10;        + STR(&#10;        ROUND(&#10;        (SUM(IIF([W-1 (copy)_6156913286740422664],[iCPGMV RR (copy)_6156913287106781265], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[iCPGMV RR (copy)_6156913287106781265], 0))) * 100&#10;        ,1)&#10;        )&#10;&#10;        + &apos;%&apos;&#10;    END)&#10;ELSE &quot;NA&quot;&#10;END' />
            </column>
            <column caption='Fresh Customer Penetration RR Δ Colour' datatype='string' name='[MAU RR Δ Colour (copy)_6156913287109984341]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF SUM(IIF([Calculation_6156913286731837444],[iCPGMV RR (copy)_6156913287106781265], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[iCPGMV RR (copy)_6156913287106781265], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF SUM(IIF([W-1 (copy)_6156913286740422664],[iCPGMV RR (copy)_6156913287106781265], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[iCPGMV RR (copy)_6156913287106781265], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;END' />
            </column>
