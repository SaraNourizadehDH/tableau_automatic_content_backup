          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0l2wv2s19fwbqt1bu8w0b08brspu'>
            <column caption='Organic Retention Target' datatype='real' name='[AC Organic Re-order]' role='measure' type='quantitative' />
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12dqj351omgupp1c9d8rc1ur97m9'>
            <column caption='Organic Retention Target' datatype='integer' name='[DMart Organic Orders (PENDING updated definition)]' role='measure' type='quantitative' />
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='ac_30d_ago_organic_with_pro_reorder RR' datatype='real' name='[GMV RR (copy)_6156913287067394104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN [ac_30d_ago_organic_with_pro_reorder] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE [ac_30d_ago_organic_with_pro_reorder]&#10;END' />
            </column>
            <column caption='Organic Retention RR &amp; vs Target' datatype='string' name='[Organic Retention RR (copy)_4804777888977170440]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([iCPGMV RR (copy)_6156913287067779130]) * 100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([iCPGMV Target (copy)_4804777896731832367] * 100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [iCPGMV Target Δ (copy)_6156913287089872963]&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;       //[Organic Retention Target Δ]&#10;END' />
            </column>
            <column caption='Organic Retention Target Δ Colours' datatype='string' name='[Organic Retention Target Δ Colour (copy)_3643482502418235396]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN &apos;&apos;&#10;    //IF (SUM([Organic Retention RR]) / SUM([Dmart Targets].[Organic Retention Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([iCPGMV RR (copy)_6156913287067779130]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[AC Organic Re-order]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;END' />
            </column>
            <column datatype='integer' name='[ac_30d_ago]' role='measure' type='quantitative' />
            <column caption='ac_30d_ago RR' datatype='real' name='[ac_30d_ago_organic_with_pro_reorder RR (copy)_6156913287067619385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN IIF([ac_30d_ago] = 0, [cohort_user_count], [ac_30d_ago]) / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE IIF([ac_30d_ago] = 0, [cohort_user_count], [ac_30d_ago])&#10;END' />
            </column>
            <column datatype='integer' name='[ac_30d_ago_organic_with_pro_reorder]' role='measure' type='quantitative' />
            <column-instance column='[date_type]' derivation='Attribute' name='[attr:date_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='Attribute' name='[attr:vertical:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[cohort_user_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='Organic Retention RR' datatype='real' name='[iCPGMV RR (copy)_6156913287067779130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV RR (copy)_6156913287067394104] / IFNULL([ac_30d_ago_organic_with_pro_reorder RR (copy)_6156913287067619385], [cohort_user_count])' />
            </column>
            <column caption='Organic Retention Target' datatype='real' name='[iCPGMV Target (copy)_4804777896731832367]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Organic Orders (PENDING updated definition)])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[AC Organic Re-order])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Organic Retention Target Δ' datatype='string' name='[iCPGMV Target Δ (copy)_6156913287089872963]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([iCPGMV RR (copy)_6156913287067779130]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Organic Orders (PENDING updated definition)])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([iCPGMV RR (copy)_6156913287067779130]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[AC Organic Re-order])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    STR(ROUND(((SUM([iCPGMV RR (copy)_6156913287067779130]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Organic Orders (PENDING updated definition)])) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    STR(ROUND(((SUM([iCPGMV RR (copy)_6156913287067779130]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[AC Organic Re-order])) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;END' />
            </column>
