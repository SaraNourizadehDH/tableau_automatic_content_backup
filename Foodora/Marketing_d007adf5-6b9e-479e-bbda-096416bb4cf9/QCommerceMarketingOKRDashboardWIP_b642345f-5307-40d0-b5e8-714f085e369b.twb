            </column>
            <column caption='NTV iCPGMV Net RR Colour' datatype='integer' name='[iCPGMV RR Colour (copy)_1107111503823118341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([iCPGMV RR (copy)_1107111503821582337]) - [iCPGMV RR AVG (copy)_1107111503823032324]) / [iCPGMV RR AVG (copy)_1107111503823032324] &gt;= 0.2 THEN 2&#10;ELSEIF (SUM([iCPGMV RR (copy)_1107111503821582337]) - [iCPGMV RR AVG (copy)_1107111503823032324]) / [iCPGMV RR AVG (copy)_1107111503823032324] &lt;= -0.2 THEN -2&#10;ELSEIF (SUM([iCPGMV RR (copy)_1107111503821582337]) - [iCPGMV RR AVG (copy)_1107111503823032324]) / [iCPGMV RR AVG (copy)_1107111503823032324] &lt;= -0.1 THEN -1&#10;ELSEIF (SUM([iCPGMV RR (copy)_1107111503821582337]) - [iCPGMV RR AVG (copy)_1107111503823032324]) / [iCPGMV RR AVG (copy)_1107111503823032324] &gt;= 0.1 THEN 1&#10;ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
