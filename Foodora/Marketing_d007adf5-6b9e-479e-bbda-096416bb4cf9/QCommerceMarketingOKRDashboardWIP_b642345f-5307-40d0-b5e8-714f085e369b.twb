      <aliases enabled='yes' />
      <column caption='% Non-Incentivised Orders' datatype='real' name='[% Incentivised Orders (copy)_619526469809111052]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders RR (copy)_619526469808250889] / SUM([total_valid_orders])' />
      </column>
      <column caption='% NTV Orders' datatype='real' name='[% Private Label Orders (copy)_4951215257781387264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_valid_orders_ntv] / ([total_valid_orders] - [total_valid_orders_ntp])' />
      </column>
      <column caption='Incentivised ABV &amp; vs MoM' datatype='string' name='[ABV &amp; vs MoM (copy)_4599019710351499276]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([ABV (copy)_1569363757513420807]), 2))&#10;    WHEN &quot;Targets&quot; THEN NULL&#10;        //STR(ROUND([ABV Target], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [ABV Date Trends (copy)_4599019710348759050]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency &amp; vs MoM' datatype='string' name='[ABV &amp; vs MoM (copy)_4599019710355271699]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([Non Incentivised ABV (copy)_1569363757531410452]), 2))&#10;    //WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND([ABV Target], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [ABV Date Trends (copy)_4599019710354632721]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV Net NTV % RR &amp; vs MoM' datatype='string' name='[ABV &amp; vs MoM (copy)_4599019710362472474]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([iCPGMV RR (copy)_4804777889310523418]) * 100, 1)) + &quot;%&quot;&#10;    //WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND([ABV Target], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [ABV Date Trends (copy)_4599019710359117848]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ABV &amp; vs MoM' datatype='string' name='[ABV &amp; vs Target (copy)_4599019710346027017]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([GMV (copy)_1569363757468827649]), 2))&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([GMV Target (copy)_4804777896738955314], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [MAU % RR Date Trends (copy)_4599019710345322502]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ABV (Organic)' datatype='real' name='[ABV (Incentivised) (copy)_619526469808373770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV Organic (copy)_6405596463706169360] / [Orders RR (copy)_619526469808250889]' />
      </column>
      <column caption='% Incentivised Orders' datatype='real' name='[ABV (Incentivised) (copy)_619526469808947211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_incentivised_orders]) / SUM([total_valid_orders])' />
      </column>
      <column caption='Incentivised ABV' datatype='real' name='[ABV (copy)_1569363757513420807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV Incentivised (copy)_6405596463705165838] / [total_incentivised_orders]' />
      </column>
      <column caption='ABV &amp; vs Target' datatype='string' name='[ABV (copy)_4804777888978673674]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([GMV (copy)_1569363757468827649]), 2))&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([GMV Target (copy)_4804777896738955314], 2))&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [iCPGMV Target Δ (copy)_1273885407426916355]&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;       //[ABV Target Δ]&#10;END' />
      </column>
      <column caption='AFV (RR)' datatype='real' name='[ABV (copy)_5999287332759437314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV RR (copy)_6156913287117942875] / [GMV RR (copy)_1569363757871665182]' />
      </column>
      <column caption='ABV (Incentivised)' datatype='real' name='[ABV (copy)_619526469806972935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV Incentivised (copy)_6405596463705165838] / [total_incentivised_orders]' />
      </column>
      <column caption='Fresh ABV' datatype='real' name='[ABV (copy)_619526469830389781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GFV RR (copy)_619526469830074388] / [total_fresh_orders]' />
      </column>
      <column caption='Incentivised ABV AVG' datatype='real' name='[ABV AVG (copy)_1569363757515149323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([ABV (copy)_1569363757513420807]), FIRST(), FIRST()+6)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Incentivised ABV Colour' datatype='integer' name='[ABV Colour (copy)_1569363757514829834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (SUM([ABV (copy)_1569363757513420807]) - [ABV AVG (copy)_1569363757515149323]) / [ABV AVG (copy)_1569363757515149323] &gt;= 0.1 THEN 2&#10;ELSEIF (SUM([ABV (copy)_1569363757513420807]) - [ABV AVG (copy)_1569363757515149323]) / [ABV AVG (copy)_1569363757515149323] &lt;= -0.1 THEN -2&#10;ELSEIF (SUM([ABV (copy)_1569363757513420807]) - [ABV AVG (copy)_1569363757515149323]) / [ABV AVG (copy)_1569363757515149323] &lt;= -0.05 THEN -1&#10;ELSEIF (SUM([ABV (copy)_1569363757513420807]) - [ABV AVG (copy)_1569363757515149323]) / [ABV AVG (copy)_1569363757515149323] &gt;= 0.05 THEN 1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Incentivised ABV Date Trends' datatype='string' name='[ABV Date Trends (copy)_4599019710348759050]' role='measure' type='nominal'>
        <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([ABV (copy)_1569363757513420807])) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([ABV (copy)_1569363757513420807]) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([ABV (copy)_1569363757513420807])) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([ABV (copy)_1569363757513420807]) - LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1)) / LOOKUP(ZN(SUM([ABV (copy)_1569363757513420807])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency Date Trends' datatype='string' name='[ABV Date Trends (copy)_4599019710354632721]' role='measure' type='nominal'>
