            <column-instance column='[Calculation_2288180497498427399]' derivation='Min' name='[min:Calculation_2288180497498427399:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2022890300484169729]' derivation='None' name='[none:Calculation_2022890300484169729:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
