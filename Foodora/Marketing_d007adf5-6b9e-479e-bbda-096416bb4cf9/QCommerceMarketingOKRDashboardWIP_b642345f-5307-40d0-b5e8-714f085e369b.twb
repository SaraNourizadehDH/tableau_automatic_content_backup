        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1lvv5360xpitjj1ch548l17vdzps' name='Custom SQL Query' type='text'><![CDATA[WITH weekly_shoppers AS (
  SELECT
    report_date_local,
    "Month" AS date_type,
    global_entity_id,
    vertical,
    SUM(cust) AS weekly_shoppers_cust
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_report`
  WHERE subsegment = "Weekly Shoppers"
  GROUP BY 1,2,3,4
),

data AS (
  SELECT
    "APAC" AS region,
    okr.*,
    weekly_shoppers.weekly_shoppers_cust
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qcommerce_okr_dashboard` AS okr
  LEFT JOIN weekly_shoppers
         ON okr.report_date_local = weekly_shoppers.report_date_local
        AND okr.global_entity_id = weekly_shoppers.global_entity_id
        AND okr.date_type = weekly_shoppers.date_type
        AND okr.vertical = weekly_shoppers.vertical
  WHERE (okr.date_type = "Week" AND okr.report_date_local << DATE_TRUNC(CURRENT_DATE, ISOWEEK))
     OR (okr.date_type = "Month" AND okr.report_date_local <<= CURRENT_DATE)

  UNION ALL
  
SELECT
  "EU + TR" AS region,
   *,
  0 AS weekly_shoppers_cust
FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_eu_okr_dashboard` AS okr
WHERE (okr.date_type = "Week" AND okr.report_date_local << DATE_TRUNC(CURRENT_DATE, ISOWEEK))
     OR (okr.date_type = "Month" AND okr.report_date_local <<= CURRENT_DATE)
),

final AS (
SELECT
  data.*
FROM data
