              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [incentive_cost_fp_marketing_eur_ntv] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_eur_ntv]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [incentive_cost_fp_marketing_local_ntv] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_local_ntv]&#10;            END&#10;        END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [incentive_cost_fp_marketing_eur_ntv]&#10;            WHEN &quot;LC&quot; THEN&#10;                [incentive_cost_fp_marketing_local_ntv]&#10;    END&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='NTV iCPGMV Net RR' datatype='real' name='[iCPGMV RR (copy)_1107111503821582337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Incentive Cost RR (copy)_1107111503821705218] / [GMV RR (copy)_1107111503821959171]' />
            </column>
            <column caption='NTV iCPGMV Net RR AVG' datatype='real' name='[iCPGMV RR AVG (copy)_1107111503823032324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([iCPGMV RR (copy)_1107111503821582337]), FIRST(), FIRST()+6)'>
