        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Run Rate' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;RR On&quot;'>
              <calculation class='tableau' formula='&quot;RR On&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_2022890300484079616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Week&quot; THEN &quot;WoW Δ&quot;&#10;ELSEIF [date_type] = &quot;Month&quot; then &quot;MoM Δ&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='M-1' datatype='boolean' name='[M-0 (copy)_6156913286740725769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -1, TODAY()))' />
            </column>
            <column caption='Healthy NTV RR' datatype='real' name='[NTV RR (copy)_5191594901493325838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [healthy_ntv_cust] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [healthy_ntv_cust]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [healthy_ntv_cust]&#10;END' />
            </column>
            <column caption='Healthy NTV RR Δ %' datatype='string' name='[NTV RR Δ % (copy)_5191594901504405528]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[NTV RR (copy)_5191594901493325838], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_5191594901493325838], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_5191594901493325838], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[NTV RR (copy)_5191594901493325838], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_5191594901493325838], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_5191594901493325838], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Healthy NTV RR Δ Colour' datatype='string' name='[NTV RR Δ Colour (copy)_5191594901504606233]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[NTV RR (copy)_5191594901493325838], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_5191594901493325838], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[NTV RR (copy)_5191594901493325838], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;END' />
            </column>
            <column caption='M-0' datatype='boolean' name='[W-1 (copy)_6156913286740422664]' role='dimension' type='nominal'>
