            <column caption='Date' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column caption='Fresh Customers' datatype='integer' name='[total_fresh_customers]' role='measure' type='quantitative' />
            <column caption='total_fresh_customers RR' datatype='real' name='[total_fresh_customers_mth (copy)_6156913287103414351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN [total_fresh_customers] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE [total_fresh_customers]&#10;END' />
