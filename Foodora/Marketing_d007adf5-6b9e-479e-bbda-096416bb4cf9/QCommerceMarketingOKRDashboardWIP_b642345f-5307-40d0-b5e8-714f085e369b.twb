              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Fresh Customer Penetration Target Δ' datatype='string' name='[MAU Target Δ (copy)_6156913287111794774]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([iCPGMV RR (copy)_6156913287106781265]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot;&#10;    //IF (SUM([MAU RR]) - SUM([Shops Targets].[MAU Target])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSE &apos;&apos;&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    STR(ROUND(((SUM([iCPGMV RR (copy)_6156913287106781265]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration])) * 100), 1)) + &apos;%&apos;&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //STR(ROUND(((SUM([MAU RR]) - SUM([Shops Targets].[MAU Target])) * 100), 1))&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Fresh Customer Penetration Target Δ Colour' datatype='string' name='[MAU Target Δ Colour (copy)_6156913287112048727]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([iCPGMV RR (copy)_6156913287106781265]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Fresh User Penetration]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //IF (SUM([MAU RR]) / SUM([Shops Targets].[MAU Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END' />
