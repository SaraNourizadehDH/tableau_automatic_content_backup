          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Healthy NTV RR &amp; vs Target' datatype='string' name='[NTV RR &amp; vs Target (copy)_5191594901502013461]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([NTV RR]))&#10;        IF LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),(LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),LEN(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0)),3)&#10;        ELSE STR(ROUND(ATTR([NTV RR (copy)_5191594901493325838]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND(ATTR([Dmart Targets].[NTV Target]),0))&#10;        IF LEN(STR(ROUND([NTV Target (copy)_5191594901499936786],0)))&gt;3 THEN LEFT(STR(ROUND([NTV Target (copy)_5191594901499936786],0)),(LEN(STR(ROUND([NTV Target (copy)_5191594901499936786],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([NTV Target (copy)_5191594901499936786],0)))&gt;9 THEN MID(STR(ROUND([NTV Target (copy)_5191594901499936786],0)),LEN(STR(ROUND([NTV Target (copy)_5191594901499936786],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([NTV Target (copy)_5191594901499936786],0)))&gt;6 THEN MID(STR(ROUND([NTV Target (copy)_5191594901499936786],0)),LEN(STR(ROUND([NTV Target (copy)_5191594901499936786],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([NTV Target (copy)_5191594901499936786],0)),3)&#10;        ELSE STR(ROUND([NTV Target (copy)_5191594901499936786],0))&#10;    END&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [Sessions Target Δ (copy)_6156913287046373414]&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;       //[NTV Target Δ]&#10;END' />
            </column>
            <column caption='Healthy NTV RR' datatype='real' name='[NTV RR (copy)_5191594901493325838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [healthy_ntv_cust] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [healthy_ntv_cust]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [healthy_ntv_cust]&#10;END' />
            </column>
            <column caption='Healthy NTV Target' datatype='integer' name='[NTV Target (copy)_5191594901499936786]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Healthy NTV])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Shops Healthy NTV])&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC Healthy NTV])&#10;END' />
            </column>
            <column caption='Healthy Target Δ Colours' datatype='string' name='[NTV Target Δ Colours (copy)_5191594901503156247]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([NTV RR (copy)_5191594901493325838]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Healthy NTV]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([NTV RR (copy)_5191594901493325838]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Shops Healthy NTV]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    IF (SUM([NTV RR (copy)_5191594901493325838]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC Healthy NTV]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;END' />
