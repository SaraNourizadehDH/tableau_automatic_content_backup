            <column caption='ABV &amp; vs MoM' datatype='string' name='[ABV &amp; vs Target (copy)_4599019710346027017]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([GMV (copy)_1569363757468827649]), 2))&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([GMV Target (copy)_4804777896738955314], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [MAU % RR Date Trends (copy)_4599019710345322502]&#10;END'>
