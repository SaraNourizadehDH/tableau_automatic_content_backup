            <column caption='MAU RR &amp; vs Target' datatype='string' name='[MAU % RR &amp; vs Target (copy)_4951215257952006147]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*CASE [Display Targets]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ATTR([MAU RR]))&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([MAU Target] * 100, 2)) + &quot;%&quot;&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [MAU Target Δ]&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;       //[MAU Target Δ]&#10;END*/&#10;CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([MAU RR]))&#10;        IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),(LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),LEN(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0)),3)&#10;        ELSE STR(ROUND(ATTR([MAU % RR (copy)_4951215257952444421]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND(ATTR([Dmart Targets].[MAU Target]),0))&#10;        IF LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))&gt;3 THEN LEFT(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),(LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))&gt;9 THEN MID(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))&gt;6 THEN MID(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),LEN(STR(ROUND([NTV Target (copy)_3507248622843781124],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([NTV Target (copy)_3507248622843781124],0)),3)&#10;        ELSE STR(ROUND([NTV Target (copy)_3507248622843781124],0))&#10;    END&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [NTV Target Δ (copy)_3507248622837846016]&#10;    //WHEN &quot;Date Trends&quot; THEN&#10;       //[MAU RR Date Trends]&#10;END' />
            </column>
            <column caption='MAU RR' datatype='integer' name='[MAU % RR (copy)_4951215257952444421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_sh_customers_in_delivery_area_cnty]' />
            </column>
            <column caption='MAU Target' datatype='integer' name='[NTV Target (copy)_3507248622843781124]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[MAU])&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC MAU]) &#10;END' />
            </column>
            <column caption='MAU Target Δ' datatype='string' name='[NTV Target Δ (copy)_3507248622837846016]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[MAU]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    IF (SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC MAU]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot;&#10;    THEN STR(ROUND(((SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot;&#10;    THEN STR(ROUND(((SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[MAU]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot;&#10;    THEN STR(ROUND(((SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC MAU]) - 1) * 100), 1)) + &apos;%&apos;&#10;END' />
            </column>
            <column caption='MAU Target Δ Colours' datatype='string' name='[NTV Target Δ Colours (copy)_3507248622840897538]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[MAU]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    IF (SUM([MAU % RR (copy)_4951215257952444421]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC MAU]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;END' />
            </column>
