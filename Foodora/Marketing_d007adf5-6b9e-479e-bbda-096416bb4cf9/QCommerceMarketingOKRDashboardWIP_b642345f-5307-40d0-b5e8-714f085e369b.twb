              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[Non Incentivised ABV (copy)_1569363757531410452], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Non Incentivised ABV (copy)_1569363757531410452], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[Non Incentivised ABV (copy)_1569363757531410452],0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[Non Incentivised ABV (copy)_1569363757531410452], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[Non Incentivised ABV (copy)_1569363757531410452], 0)))&#10;     / &#10;     SUM(IIF([W-1 (copy)_6156913286732079109],[Non Incentivised ABV (copy)_1569363757531410452], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[Non Incentivised ABV (copy)_1569363757531410452], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Non Incentivised ABV (copy)_1569363757531410452], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[Non Incentivised ABV (copy)_1569363757531410452], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[Non Incentivised ABV (copy)_1569363757531410452], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[Non Incentivised ABV (copy)_1569363757531410452], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[Non Incentivised ABV (copy)_1569363757531410452], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
