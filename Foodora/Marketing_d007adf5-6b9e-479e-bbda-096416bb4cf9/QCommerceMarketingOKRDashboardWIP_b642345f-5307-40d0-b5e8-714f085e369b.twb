            <column caption='Weekly Shoppers RR Date Trends' datatype='string' name='[MAU RR Date Trends (copy)_5191594901439512580]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([MAU RR (copy)_5191594901438930946])) - LOOKUP(ZN(SUM([MAU RR (copy)_5191594901438930946])),1)) / LOOKUP(ZN(SUM([MAU RR (copy)_5191594901438930946])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([MAU RR (copy)_5191594901438930946]) - LOOKUP(ZN(SUM([MAU RR (copy)_5191594901438930946])),1)) / LOOKUP(ZN(SUM([MAU RR (copy)_5191594901438930946])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
