            </column>
            <column caption='Healthy NTV RR' datatype='real' name='[NTV RR (copy)_5191594901493325838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [healthy_ntv_cust] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [healthy_ntv_cust]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [healthy_ntv_cust]&#10;END' />
            </column>
            <column caption='Healthy NTV RR Date Trends' datatype='string' name='[NTV RR Date Trends (copy)_5191594901495631888]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([NTV RR (copy)_5191594901493325838])) - LOOKUP(ZN(SUM([NTV RR (copy)_5191594901493325838])),1)) / LOOKUP(ZN(SUM([NTV RR (copy)_5191594901493325838])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([NTV RR (copy)_5191594901493325838]) - LOOKUP(ZN(SUM([NTV RR (copy)_5191594901493325838])),1)) / LOOKUP(ZN(SUM([NTV RR (copy)_5191594901493325838])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Healthy NTV RR Date Trends Colour' datatype='string' name='[NTV RR Date Trends Colour (copy)_5191594901500678164]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([NTV RR (copy)_5191594901493325838])) - LOOKUP(ZN(SUM([NTV RR (copy)_5191594901493325838])),1)) / LOOKUP(ZN(SUM([NTV RR (copy)_5191594901493325838])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
