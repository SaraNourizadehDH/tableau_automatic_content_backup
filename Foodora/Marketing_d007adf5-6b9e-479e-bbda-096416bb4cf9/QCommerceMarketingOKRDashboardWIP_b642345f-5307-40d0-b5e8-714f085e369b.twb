      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_qcommerce_okr_dashboard' name='federated.1wxo0ob0e60sow1680kli1iiuy4l' />
            <datasource caption='Dmart Targets' name='federated.12dqj351omgupp1c9d8rc1ur97m9' />
            <datasource caption='Shops Targets' name='federated.0l2wv2s19fwbqt1bu8w0b08brspu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Run Rate' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;RR On&quot;'>
              <calculation class='tableau' formula='&quot;RR On&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0l2wv2s19fwbqt1bu8w0b08brspu'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Sessions Target' datatype='integer' name='[Sessions]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12dqj351omgupp1c9d8rc1ur97m9'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column caption='Sessions Target' datatype='real' name='[Sessions]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6156913286805508114]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date_local]' />
            </column>
            <column caption='Sessions RR' datatype='real' name='[GMV RR (copy)_6156913287032786970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [menu_sessions] / DAY(TODAY() - 3) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [menu_sessions]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [menu_sessions]&#10;END' />
            </column>
            <column caption='Sessions Target Δ' datatype='string' name='[GMV Target Δ (copy 2)_6156913287036379167]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Sessions]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Sessions]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;END' />
            </column>
            <column caption='Sessions Target Δ Colour' datatype='string' name='[GMV Target Δ Colour (copy)_6156913287038296096]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;    IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;        IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;        IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;        //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt;= 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;    END&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Target Header' datatype='string' name='[W-1 (copy)_6156913286815711253]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;vs Target&quot;' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[menu_sessions]' role='measure' type='quantitative' />
            <column-instance column='[Date (copy)_6156913286805508114]' derivation='None' name='[none:Date (copy)_6156913286805508114:qk]' pivot='key' type='quantitative' />
