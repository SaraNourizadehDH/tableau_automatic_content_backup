              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            IF SUM([Fresh PP RR (copy)_6156913287118286941]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Private Label GPV Share]) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([Shops Targets].[GMV Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            IF SUM([Fresh PP RR (copy)_6156913287118286941]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Private Label GPV Share]) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([Shops Targets].[GMV Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        END&#10;    //ELSE 0&#10;END&#10;+ &apos; &apos; +&#10;CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            STR(ROUND(((SUM([Fresh PP RR (copy)_6156913287118286941]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Private Label GPV Share])) * 100), 1)) + &apos;%&apos;&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN &apos;&apos;&#10;            //STR(ROUND(((SUM([GMV RR (EUR)]) / SUM([Shops Targets].[GMV Target]) - 1) * 100), 1))&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    WHEN &quot;LC&quot; THEN&#10;        IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;            STR(ROUND(((SUM([Fresh PP RR (copy)_6156913287118286941]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Private Label GPV Share])) * 100), 1)) + &apos;%&apos;&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN &apos;&apos;&#10;            //STR(ROUND(((SUM([GMV RR (EUR)]) / SUM([Shops Targets].[GMV Target]) - 1) * 100), 1))&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;        END&#10;    //ELSE 0&#10;END' />
