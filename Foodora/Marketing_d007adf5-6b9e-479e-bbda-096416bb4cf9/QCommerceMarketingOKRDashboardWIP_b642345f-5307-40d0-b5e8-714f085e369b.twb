          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='NTV RR Date Trends' datatype='string' name='[GMV RR Date Trends (copy)_3405284332767105034]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Sessions RR (copy)_6156913287042859041])) - LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Sessions RR (copy)_6156913287042859041]) - LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Sessions RR (copy)_6156913287042859041])) - LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Sessions RR (copy)_6156913287042859041]) - LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NTV RR Date Trends Colour' datatype='string' name='[GMV RR Date Trends Colour (copy)_3405284332768104459]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Sessions RR (copy)_6156913287042859041])) - LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Sessions RR (copy)_6156913287042859041])) - LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_6156913287042859041])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='NTV RR &amp; vs MoM' datatype='string' name='[NTV RR &amp; vs Target (copy)_3405284332768927756]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([NTV RR]))&#10;        IF LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)),(LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)),LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)),LEN(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0)),3)&#10;        ELSE STR(ROUND(ATTR([Sessions RR (copy)_6156913287042859041]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND(ATTR([Dmart Targets].[NTV Target]),0))&#10;        IF LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))&gt;3 THEN LEFT(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),(LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))&gt;9 THEN MID(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))&gt;6 THEN MID(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),LEN(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([Sessions Target (copy)_4804777896420888619],0)),3)&#10;        ELSE STR(ROUND([Sessions Target (copy)_4804777896420888619],0))&#10;    END&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[NTV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [GMV RR Date Trends (copy)_3405284332767105034]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='NTV RR' datatype='real' name='[Sessions RR (copy)_6156913287042859041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [users_new_to_vertical] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [users_new_to_vertical]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [users_new_to_vertical]&#10;END' />
            </column>
            <column caption='NTV Target' datatype='integer' name='[Sessions Target (copy)_4804777896420888619]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart New To Vertical])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[New To Vertical])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -6, TODAY()))' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column-instance column='[report_date_local]' derivation='Max' name='[max:report_date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2288180497498427399]' derivation='Min' name='[min:Calculation_2288180497498427399:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2022890300484169729]' derivation='None' name='[none:Calculation_2022890300484169729:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_type]' derivation='None' name='[none:date_type:nk]' pivot='key' type='nominal' />
