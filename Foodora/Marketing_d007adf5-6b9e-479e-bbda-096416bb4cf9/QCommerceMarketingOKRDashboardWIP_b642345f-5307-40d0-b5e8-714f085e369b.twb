            <column caption='Organic Retention RR &amp; vs MoM' datatype='string' name='[Organic Retention RR &amp; vs Target (copy)_3405284332811677726]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([iCPGMV RR (copy)_6156913287067779130]) * 100, 1)) + &quot;%&quot;&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([iCPGMV Target (copy)_4804777896731832367] * 100, 1)) + &quot;%&quot;&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[Organic Retention Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [iCPGMV RR Date Trends (copy)_3405284332810698780]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -6, TODAY()))' />
            </column>
            <column datatype='integer' name='[ac_30d_ago]' role='measure' type='quantitative' />
            <column caption='ac_30d_ago RR' datatype='real' name='[ac_30d_ago_organic_with_pro_reorder RR (copy)_6156913287067619385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;THEN IIF([ac_30d_ago] = 0, [cohort_user_count], [ac_30d_ago]) / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;ELSE IIF([ac_30d_ago] = 0, [cohort_user_count], [ac_30d_ago])&#10;END' />
            </column>
            <column datatype='integer' name='[ac_30d_ago_organic_with_pro_reorder]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cohort_user_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='Organic Retention RR' datatype='real' name='[iCPGMV RR (copy)_6156913287067779130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV RR (copy)_6156913287067394104] / IFNULL([ac_30d_ago_organic_with_pro_reorder RR (copy)_6156913287067619385], [cohort_user_count])' />
            </column>
            <column caption='Organic Retention RR Date Trends' datatype='string' name='[iCPGMV RR Date Trends (copy)_3405284332810698780]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([iCPGMV RR (copy)_6156913287067779130])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287067779130])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([iCPGMV RR (copy)_6156913287067779130]) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287067779130])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([iCPGMV RR (copy)_6156913287067779130])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287067779130])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([iCPGMV RR (copy)_6156913287067779130]) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287067779130])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Organic Retention RR Date Trends Colour' datatype='string' name='[iCPGMV RR Date Trends Colour (copy)_3405284332811001885]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([iCPGMV RR (copy)_6156913287067779130])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287067779130])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([iCPGMV RR (copy)_6156913287067779130])) - LOOKUP(ZN(SUM([iCPGMV RR (copy)_6156913287067779130])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Organic Retention Target' datatype='real' name='[iCPGMV Target (copy)_4804777896731832367]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart Organic Orders (PENDING updated definition)])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[AC Organic Re-order])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
