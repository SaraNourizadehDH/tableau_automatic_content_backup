          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='Platform Sessions RR &amp; vs MoM' datatype='string' name='[Sessions RR &amp; vs MoM (copy)_3405284332764684297]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([Sessions RR]))&#10;        IF LEN(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)),(LEN(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)),LEN(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)),LEN(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0)),3)&#10;        ELSE STR(ROUND(ATTR([Sessions RR (copy)_4791900434648104961]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        NULL&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[Platform Sessions Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [Sessions RR Date Trends (copy)_3405284332748713991]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Platform Sessions RR' datatype='real' name='[Sessions RR (copy)_4791900434648104961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [platform_sessions] / DAY(TODAY() - 3) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [platform_sessions]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [platform_sessions]&#10;END' />
            </column>
            <column caption='Platform Sessions RR Date Trends' datatype='string' name='[Sessions RR Date Trends (copy)_3405284332748713991]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Sessions RR (copy)_4791900434648104961])) - LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Sessions RR (copy)_4791900434648104961]) - LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Sessions RR (copy)_4791900434648104961])) - LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Sessions RR (copy)_4791900434648104961]) - LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Platform Sessions RR Date Trends Colour' datatype='string' name='[Sessions RR Date Trends Colour (copy)_3405284332749070344]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Sessions RR (copy)_4791900434648104961])) - LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Sessions RR (copy)_4791900434648104961])) - LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1)) / LOOKUP(ZN(SUM([Sessions RR (copy)_4791900434648104961])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
