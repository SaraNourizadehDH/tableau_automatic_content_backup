          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Sessions RR' datatype='real' name='[GMV RR (copy)_6156913287032786970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [menu_sessions] / DAY(TODAY() - 3) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [menu_sessions]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [menu_sessions]&#10;END' />
            </column>
            <column caption='Sessions Target Δ' datatype='string' name='[GMV Target Δ (copy 2)_6156913287036379167]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Sessions]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot;&#10;    THEN STR(ROUND(((SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Sessions]) - 1) * 100), 1)) + &apos;%&apos;&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //THEN SUM([GMV RR (EUR)]) / [GMV Target QC] - 1&#10;END' />
            </column>
            <column caption='Sessions RR &amp; vs Target' datatype='string' name='[Sessions RR (copy)_4804777888945266688]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([Sessions RR]))&#10;        IF LEN(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)),(LEN(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)),LEN(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)),LEN(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0)),3)&#10;        ELSE STR(ROUND(ATTR([GMV RR (copy)_6156913287032786970]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        //STR(ATTR([Sessions Target]))&#10;        IF LEN(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)))&gt;3 THEN LEFT(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)),(LEN(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)))&gt;9 THEN MID(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)),LEN(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)))&gt;6 THEN MID(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)),LEN(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0)),3)&#10;        ELSE STR(ROUND([Sessions Target Δ (copy)_1273885408130289671],0))&#10;    END&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [GMV Target Δ (copy 2)_6156913287036379167]&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;       //[Sessions Target Δ]&#10;END' />
            </column>
            <column caption='Sessions Target' datatype='real' name='[Sessions Target Δ (copy)_1273885408130289671]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[Sessions])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Sessions])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='Sessions Target Δ Colours' datatype='string' name='[Sessions Target Δ Colour (copy)_3643482502404927488]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*CASE [Display]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        IF ATTR([Vertical]) = &quot;Pandamart&quot; THEN&#10;            IF (SUM([Sessions RR]) / SUM([Dmart Targets].[Sessions Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;            IF (SUM([Sessions RR]) / SUM([Shops Targets].[Sessions Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt;= 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;    END&#10;    WHEN &quot;Vs Target&quot; THEN&#10;        IF ATTR([Vertical]) = &quot;Pandamart&quot; THEN&#10;            IF (SUM([Sessions RR]) / SUM([Dmart Targets].[Sessions Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;            IF (SUM([Sessions RR]) / SUM([Shops Targets].[Sessions Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;            //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt;= 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;    END&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;        //IF ROUND((SUM([Sessions RR]) - LOOKUP(ZN(SUM([Sessions RR])), 1)) / LOOKUP(ZN(SUM([Sessions RR])), 1) * 100, 1) &lt;= 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END*/&#10;&#10;IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;    IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;        IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;        IF (SUM([GMV RR (copy)_6156913287032786970]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Sessions]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;        ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;        //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt;= 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;    END&#10;ELSE &apos;&apos;&#10;END' />
            </column>
