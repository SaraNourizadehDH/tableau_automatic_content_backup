  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description/Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/QCommerceMarketingOKRDashboard/DescriptionMetricDefinitions?rev=' id='DescriptionMetricDefinitions' path='/t/Foodora/workbooks/QCommerceMarketingOKRDashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='3000' maxwidth='1600' minheight='3000' minwidth='1600' preset-index='17' sizing-mode='fixed' />
      <zones>
        <zone h='99238' id='459' param='vert' type-v2='layout-flow' w='99058' x='471' y='381'>
          <zone fixed-size='115' h='3833' id='447' is-fixed='true' param='horz' type-v2='layout-flow' w='99058' x='471' y='381'>
            <zone fixed-size='215' forceUpdate='true' h='3833' id='3' is-fixed='true' type-v2='text' w='13938' x='471' y='381'>
              <formatted-text>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='24'>    foodpanda</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#d70f64' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='3833' id='5' type-v2='text' w='85120' x='14409' y='381'>
              <formatted-text>
                <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='22'>   Q-Commerce Marketing OKRs</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#e6e6e6' />
              </zone-style>
            </zone>
          </zone>
          <zone h='31800' id='1418' param='horz' type-v2='layout-flow' w='99058' x='471' y='4214'>
            <zone fixed-size='3000' h='31800' id='1648' is-fixed='true' param='vert' type-v2='layout-flow' w='99058' x='471' y='4214'>
              <zone forceUpdate='true' h='31800' id='1989' type-v2='text' w='99058' x='471' y='4214'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Purpose: Report QC OKR metrics, including target trends and date trends.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>POC: aetius.tan@foodpanda.com</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10' underline='true'>OKR Definitions:</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Weekly Shoppers:  3+ grocery orders / month, min 5 of last 6 months for existing customers</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Platform Sessions: Sessions that visited the app</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Platform Net GMV: Net GMV at platform level</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Sessions: Sessions that visited the shop details (menu) page</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Net GMV: Net GMV for Pandamart/Shops/Q-Commerce verticals</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Sessions % Contribution: Vertical Sessions / Platform Sessions</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Net GMV % Contribution: Vertical Net GMV / Platform Net GMV</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>New To Vertical: New to vertical customers (first order on Pandamart/Shops/Q-Commerce vertical AND NOT first order on foodpanda platform)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Net ICpGMV: foodpanda marketing incentive cost / Net GMV</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Healthy New To Vertical: New to vertical customers (first order on Pandamart/Shops/Q-Commerce vertical INCLUDING first order on foodpanda platform) with 3+ orders within 60 days of first order</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Platform MAU: Monthly Active Users on platform (i.e. all verticals)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Organic Retention: All customers who purchased 30 days ago and made an organic reorder / All customers who purchased 30 days ago (INCLUDING pandapro benefit orders)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>MAU: Customers using Pandamart/Shops/Q-Commerce in delivery area / Customers in Pandamart/Shops/Q-Commerce vendor delivery area </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Note for MAU: As Monthly Coverage is calculated based on 1st run of the next month (e.g. Oct coverage = 1 Nov data), RR is calculated using latest day&apos;s coverage</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>MAU % (Penetration): MAU / Platform MAU</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>ABV: GFV / Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>ABV (Incentivised): Incentivised GFV / Incentivised Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>ABV (Organic): Organic GFV / Organic Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Frequency: Orders / Unique Customers</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Orders: Orders on Pandamart/Shops/Q-Commerce verticals</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>NTV Net GMV % Contribution: NTV Net GMV / Total Net GMV</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>NTV Net ICpGMV: NTV foodpanda marketing incentive cost / NTV Net GMV</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>EC Net ICpGMV: Existing Customers foodpanda marketing incentive cost / Existing Customers Net GMV</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Fresh Customer Penetration: Unique fresh customers / Unique pandamart customers</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Private Label GFV Share: Total private label GFV / Total pandamart GFV</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='63605' id='1990' type-v2='empty' w='99058' x='471' y='36014'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
      </zones>
