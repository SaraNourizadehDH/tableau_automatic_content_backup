            </column>
            <column caption='MAU % RR &amp; vs Target' datatype='string' name='[MAU RR (copy)_4804777888978133001]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([Organic Retention RR (copy)_6156913287094050887]) * 100, 2)) + &quot;%&quot;&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([Organic Retention Target (copy)_4804777896732852272] * 100, 2)) + &quot;%&quot;&#10;    WHEN &quot;Vs Target&quot; THEN&#10;       [Organic Retention Target Δ (copy)_6156913287096578124]&#10;    //WHEN &quot;WoW/MoM&quot; THEN&#10;       //[MAU Target Δ]&#10;END' />
            </column>
            <column caption='MAU % Target Δ Colours' datatype='string' name='[MAU Target Δ Colour (copy)_3643482502421336069]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([MAU % RR (copy)_4951215257952444421]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Penetration % Platform MAUs])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    IF (SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC % of MAU])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;END' />
            </column>
            <column caption='MAU % RR' datatype='real' name='[Organic Retention RR (copy)_6156913287094050887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//[num_of_sh_customers_in_delivery_area_cnty RR] / [num_of_customers_in_delivery_area_cnty RR]&#10;[num_of_sh_customers_in_delivery_area_cnty] / [num_of_customers_in_delivery_area_cnty]' />
            </column>
            <column caption='MAU % Target' datatype='real' name='[Organic Retention Target (copy)_4804777896732852272]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU Platform Penetration (PENDING Budget)])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Penetration % Platform MAUs])&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC % of MAU])&#10;END' />
            </column>
            <column caption='MAU % Target Δ' datatype='string' name='[Organic Retention Target Δ (copy)_6156913287096578124]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU Platform Penetration (PENDING Budget)])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Penetration % Platform MAUs])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    IF (SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC % of MAU])) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    STR(ROUND(((SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[MAU Platform Penetration (PENDING Budget)])) * 100), 1))&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    STR(ROUND(((SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Penetration % Platform MAUs])) * 100), 1))&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    STR(ROUND(((SUM([Organic Retention RR (copy)_6156913287094050887]) - SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[QC % of MAU])) * 100), 1))&#10;END&#10;+ &apos;%&apos;' />
