              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Incentivised ABV' datatype='real' name='[ABV (copy)_1569363757513420807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV Incentivised (copy)_6405596463705165838] / [total_incentivised_orders]' />
            </column>
            <column caption='Incentivised ABV RR Δ %' datatype='string' name='[ABV RR Δ % (copy)_1569363757516374028]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[ABV (copy)_1569363757513420807], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[ABV (copy)_1569363757513420807], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[ABV (copy)_1569363757513420807],0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([Calculation_6156913286731837444],[ABV (copy)_1569363757513420807], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[ABV (copy)_1569363757513420807], 0)))&#10;     / &#10;     SUM(IIF([W-1 (copy)_6156913286732079109],[ABV (copy)_1569363757513420807], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[ABV (copy)_1569363757513420807], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[ABV (copy)_1569363757513420807], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[ABV (copy)_1569363757513420807], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM(IIF([W-1 (copy)_6156913286740422664],[ABV (copy)_1569363757513420807], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[ABV (copy)_1569363757513420807], 0)))&#10;     / &#10;     SUM(IIF([M-0 (copy)_6156913286740725769],[ABV (copy)_1569363757513420807], 0)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END' />
            </column>
            <column caption='Incentivised ABV Δ Colour' datatype='string' name='[ABV Δ Colour (copy)_1569363757517504525]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (SUM(IIF([Calculation_6156913286731837444],[ABV (copy)_1569363757513420807], 0)) - SUM(IIF([W-1 (copy)_6156913286732079109],[ABV (copy)_1569363757513420807], 0)))&#10;    / &#10;    SUM(IIF([W-1 (copy)_6156913286732079109],[ABV (copy)_1569363757513420807], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (SUM(IIF([W-1 (copy)_6156913286740422664],[ABV (copy)_1569363757513420807], 0)) - SUM(IIF([M-0 (copy)_6156913286740725769],[ABV (copy)_1569363757513420807], 0)))&#10;    / &#10;    SUM(IIF([M-0 (copy)_6156913286740725769],[ABV (copy)_1569363757513420807], 0)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;END' />
            </column>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_2022890300484079616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Week&quot; THEN &quot;WoW Δ&quot;&#10;ELSEIF [date_type] = &quot;Month&quot; then &quot;MoM Δ&quot;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='W-1' datatype='boolean' name='[Calculation_6156913286731837444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY()))' />
            </column>
            <column caption='GFV Incentivised' datatype='real' name='[GMV Incentivised (copy)_6405596463705165838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        [total_incentivised_gfv_eur]&#10;    WHEN &quot;LC&quot; THEN&#10;        [total_incentivised_gfv_local]&#10;END' />
