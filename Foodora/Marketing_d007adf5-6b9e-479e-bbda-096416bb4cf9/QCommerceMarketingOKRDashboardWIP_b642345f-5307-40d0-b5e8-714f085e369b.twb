            <column caption='GMV Net Share % RR' datatype='real' name='[Sessions Share % RR (copy)_4058517378487955466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6156913286683598851] / [GMV RR (copy)_3405284332771225615]' />
            </column>
            <column caption='GMV Net Share % RR Date Trends' datatype='string' name='[Sessions Share % RR Date Trends (copy)_4058517378500554768]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])) - LOOKUP(ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Sessions Share % RR (copy)_4058517378487955466]) - LOOKUP(ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])) - LOOKUP(ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Sessions Share % RR (copy)_4058517378487955466]) - LOOKUP(ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])),1)) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV Net Share % RR Date Trends Colour' datatype='string' name='[Sessions Share % RR Date Trends Colour (copy)_4058517378501095443]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])) - LOOKUP(ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])) - LOOKUP(ZN(SUM([Sessions Share % RR (copy)_4058517378487955466])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
