              <calculation class='tableau' formula='IF ATTR([date_type]) = &quot;Month&quot; THEN&#10;IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    IF (SUM([Sessions RR (copy)_6156913287042859041]) / SUM([federated.12dqj351omgupp1c9d8rc1ur97m9].[DMart New To Vertical]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    IF (SUM([Sessions RR (copy)_6156913287042859041]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[New To Vertical]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;ELSEIF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;    //IF (SUM([GMV RR (EUR)]) / SUM([GMV Target QC]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;END' />
            </column>
            <column caption='NTV RR' datatype='real' name='[Sessions RR (copy)_6156913287042859041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [users_new_to_vertical] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [users_new_to_vertical]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [users_new_to_vertical]&#10;END' />
