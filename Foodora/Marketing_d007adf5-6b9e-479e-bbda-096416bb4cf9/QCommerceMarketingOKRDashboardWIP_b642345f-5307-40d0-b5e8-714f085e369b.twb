            <column caption='GMV Net RR' datatype='real' name='[Calculation_6156913286683598851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [total_gmv_net_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local]&#10;    END&#10;END' />
            </column>
            <column caption='Incentive Cost RR' datatype='real' name='[GMV RR (copy)_6156913287050301480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [incentive_cost_fp_marketing_eur] / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_eur]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN [incentive_cost_fp_marketing_local] / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_local]&#10;            END&#10;        END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [incentive_cost_fp_marketing_eur]&#10;            WHEN &quot;LC&quot; THEN&#10;                [incentive_cost_fp_marketing_local]&#10;    END&#10;END' />
            </column>
            <column caption='iCPGMV Net RR Date Trends' datatype='string' name='[GMV RR Date Trends (copy)_3405284332807483416]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])) - LOOKUP(ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Incentive Cost RR (copy)_6156913287050793003]) - LOOKUP(ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])),1)) * 100&#10;    ,2)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])) - LOOKUP(ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([Incentive Cost RR (copy)_6156913287050793003]) - LOOKUP(ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])),1)) * 100&#10;    ,2)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='iCPGMV Net RR Date Trends Colour' datatype='string' name='[GMV RR Date Trends Colour (copy)_3405284332807880729]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])) - LOOKUP(ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])) - LOOKUP(ZN(SUM([Incentive Cost RR (copy)_6156913287050793003])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='iCPGMV Net RR' datatype='real' name='[Incentive Cost RR (copy)_6156913287050793003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV RR (copy)_6156913287050301480] / [Calculation_6156913286683598851]' />
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='iCPGMV Net Target' datatype='real' name='[Sessions Target (copy)_4804777896730751022]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([vertical]) = &quot;Pandamart&quot; THEN&#10;    ATTR([federated.12dqj351omgupp1c9d8rc1ur97m9].[Net fp mktg iCPGMV])&#10;ELSEIF ATTR([vertical]) = &quot;Shops&quot; THEN&#10;    ATTR([federated.0l2wv2s19fwbqt1bu8w0b08brspu].[Net fp mktg iCPGMV])&#10;//ELSEIF ATTR([Vertical]) = &quot;Q-Commerce&quot; THEN &apos;&apos;&#10;END' />
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -6, TODAY()))' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='iCPGMV Net RR &amp; vs MoM' datatype='string' name='[iCPGMV RR &amp; vs Target (copy)_3405284332808048666]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([Incentive Cost RR (copy)_6156913287050793003]) * 100, 2)) + &quot;%&quot;&#10;    WHEN &quot;Targets&quot; THEN&#10;        STR(ROUND([Sessions Target (copy)_4804777896730751022] * 100, 2)) + &quot;%&quot;&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[iCPGMV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [GMV RR Date Trends (copy)_3405284332807483416]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' name='[incentive_cost_fp_marketing_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[incentive_cost_fp_marketing_local]' role='measure' type='quantitative' />
