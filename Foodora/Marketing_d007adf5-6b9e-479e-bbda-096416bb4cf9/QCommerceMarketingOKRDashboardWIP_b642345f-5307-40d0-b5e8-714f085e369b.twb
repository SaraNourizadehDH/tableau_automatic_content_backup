          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='Platform MAU' datatype='integer' name='[MAU % RR (copy)_6405596461869862913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_customers_in_delivery_area_cnty]&#10;//[num_of_customers_in_delivery_area_cnty RR]' />
            </column>
            <column caption='Platform MAU &amp; vs MoM' datatype='string' name='[MAU RR &amp; vs MoM (copy)_6405596461874982920]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        //STR(ATTR([Platform MAU RR]))&#10;        IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)))&gt;3 THEN LEFT(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)),(LEN(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)))-1)%3+1) + &quot;,&quot;&#10;        + IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)))&gt;9 THEN MID(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)),LEN(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)))-8,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + IF LEN(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)))&gt;6 THEN MID(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)),LEN(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)))-5,3) + &quot;,&quot; ELSE &quot;&quot; END&#10;        + RIGHT(STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0)),3)&#10;        ELSE STR(ROUND(ATTR([MAU % RR (copy)_6405596461869862913]),0))&#10;    END&#10;    WHEN &quot;Targets&quot; THEN&#10;        NULL&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[Platform MAU Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [Platform Sessions RR Date Trends (copy)_6405596461871034371]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Platform MAU Date Trends' datatype='string' name='[Platform Sessions RR Date Trends (copy)_6405596461871034371]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([MAU % RR (copy)_6405596461869862913])) - LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1)) / LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([MAU % RR (copy)_6405596461869862913]) - LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1)) / LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([MAU % RR (copy)_6405596461869862913])) - LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1)) / LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([MAU % RR (copy)_6405596461869862913]) - LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1)) / LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Platform MAU Date Trends Colour' datatype='string' name='[Platform Sessions RR Date Trends Colour (copy)_6405596461876494346]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([MAU % RR (copy)_6405596461869862913])) - LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1)) / LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([MAU % RR (copy)_6405596461869862913])) - LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1)) / LOOKUP(ZN(SUM([MAU % RR (copy)_6405596461869862913])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
