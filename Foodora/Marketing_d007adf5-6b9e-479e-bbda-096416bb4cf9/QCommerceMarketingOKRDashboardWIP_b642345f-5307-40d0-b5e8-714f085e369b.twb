      <column caption='WoW Δ (%) GMV EUR' datatype='string' name='[Calculation_2022890300486336535]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;EUR&quot; THEN&#10;        IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;            IF (&#10;                ((IF ATTR([report_date_local]) = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY())) THEN SUM([total_gmv_eur]) END) - (IF ATTR([report_date_local]) = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -2, TODAY())) THEN SUM([total_gmv_eur]) END))&#10;                 / (IF ATTR([report_date_local]) = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -2, TODAY())) THEN SUM([total_gmv_eur]) END)&#10;               )&#10;               &gt;= 0&#10;               THEN &apos;▲&apos; ELSE &apos;▼&apos;&#10;               + &quot; &quot; +&#10;                STR((IF ATTR([report_date_local]) = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY())) THEN SUM([total_gmv_eur]) END))&#10;               /*STR(ROUND(&#10;                ((IF [Date] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY())) THEN [total_gmv_eur_billable] END) - (IF [Date] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -2, TODAY())) THEN [total_gmv_eur_billable] END))&#10;                 / (IF [Date] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -2, TODAY())) THEN [total_gmv_eur_billable] END)&#10;                ,1))&#10;                + &quot;%&quot;*/&#10;            END)&#10;        END&#10;END&#10;&#10;/*IF [Date Type] = &quot;Week&quot; THEN (&#10;    IF (&#10;((IF [Date] = DATEPART(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -1, TODAY())) THEN [GMV RR] END)&#10;- (IF [Date] = DATEPART(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -2, TODAY())) THEN [GMV RR] END))&#10;/ (IF [Date] = DATEPART(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -2, TODAY())) THEN [GMV RR] END))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END)*/&#10;/*+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if str(REGEXP_EXTRACT([Dynamic Date Range],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_gmv_eur] end) &#10;- SUM(if str(REGEXP_EXTRACT([Dynamic Date Range],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_gmv_eur] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Dynamic Date Range],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_gmv_eur] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF [Date Type] = &apos;Month&apos; THEN (&#10;IF ( &#10;(SUM(if LEFT([Dynamic Date Range],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gmv_eur_billable] end)&#10;- SUM(if LEFT([Dynamic Date Range],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gmv_eur_billable] end))&#10;/ SUM(if LEFT([Dynamic Date Range],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gmv_eur] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if LEFT([Dynamic Date Range],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gmv_eur] end)&#10;- SUM(if LEFT([Dynamic Date Range],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gmv_eur] end))&#10;/ SUM(if LEFT([Dynamic Date Range],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gmv_eur] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)*/' />
      </column>
