          <datasource-dependencies datasource='federated.12dqj351omgupp1c9d8rc1ur97m9'>
            <column datatype='string' name='[Date Type]' role='dimension' type='nominal' />
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Vertical]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wxo0ob0e60sow1680kli1iiuy4l'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2022890300484169729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;Month&quot; AND [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; TODAY() THEN TRUE&#10;ELSEIF [date_type] = &quot;Week&quot; AND [report_date_local] &gt;= DATEADD(&quot;week&quot;, -6, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) AND [report_date_local] &lt;= DATEADD(&quot;day&quot;, -1, DATETRUNC(&quot;week&quot;, TODAY(), &quot;monday&quot;)) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column aggregation='Sum' caption='WoW Col' datatype='integer' name='[Calculation_2288180497498427399]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='M-5' datatype='boolean' name='[M-4 (copy)_4791900436404002835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, -5, TODAY()))' />
            </column>
            <column caption='EC Net GMV RR' datatype='real' name='[NTV GMV RR (copy)_3285938885909118979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([total_gmv_net_eur] - [total_gmv_net_eur_ntp] - [total_gmv_net_eur_ntv]) / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_eur] - [total_gmv_net_eur_ntp] - [total_gmv_net_eur_ntv]&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([total_gmv_net_local] - [total_gmv_net_local_ntp] - [total_gmv_net_local_ntv]) / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [total_gmv_net_local] - [total_gmv_net_local_ntp] - [total_gmv_net_local_ntv]&#10;            END&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [total_gmv_net_eur] - [total_gmv_net_eur_ntp] - [total_gmv_net_eur_ntv]&#10;            WHEN &quot;LC&quot; THEN&#10;                [total_gmv_net_local] - [total_gmv_net_local_ntp] - [total_gmv_net_local_ntv]&#10;    END&#10;END' />
            </column>
            <column caption='EC Incentive Cost RR' datatype='real' name='[NTV Incentive Cost RR (copy)_3285938885908586498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([incentive_cost_fp_marketing_eur] - [incentive_cost_fp_marketing_eur_ntp] - incentive_cost_fp_marketing_eur_ntv) / DAY(TODAY() - 1) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_eur] - [incentive_cost_fp_marketing_eur_ntp] - incentive_cost_fp_marketing_eur_ntv&#10;            END&#10;            WHEN &quot;LC&quot; THEN&#10;                IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;                THEN ([incentive_cost_fp_marketing_local] - [incentive_cost_fp_marketing_local_ntp] - incentive_cost_fp_marketing_local_ntv) / (DAY(TODAY() - 1)) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;                ELSE [incentive_cost_fp_marketing_local] - [incentive_cost_fp_marketing_local_ntp] - incentive_cost_fp_marketing_local_ntv&#10;            END&#10;        END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        CASE [Parameters].[Parameter 2]&#10;            WHEN &quot;EUR&quot; THEN&#10;                [incentive_cost_fp_marketing_eur] - [incentive_cost_fp_marketing_eur_ntp] - incentive_cost_fp_marketing_eur_ntv&#10;            WHEN &quot;LC&quot; THEN&#10;                [incentive_cost_fp_marketing_local] - [incentive_cost_fp_marketing_local_ntp] - incentive_cost_fp_marketing_local_ntv&#10;    END&#10;END' />
            </column>
            <column caption='EC iCPGMV Net RR &amp; vs MoM' datatype='string' name='[NTV iCPGMV RR &amp; vs MoM (copy)_3285938885964746762]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Numbers&quot; THEN&#10;        STR(ROUND(ATTR([NTV iCPGMV RR (copy)_3285938885960974340] * 100), 2)) + &quot;%&quot;&#10;    //WHEN &quot;Targets&quot; THEN&#10;        //STR(ROUND([ABV Target], 2))&#10;    //WHEN &quot;Vs Target&quot; THEN&#10;       //[ABV Target Δ]&#10;    WHEN &quot;Date Trends&quot; THEN&#10;       [NTV iCPGMV RR Date Trends (copy)_3285938885964238856]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='EC iCPGMV Net RR' datatype='real' name='[NTV iCPGMV RR (copy)_3285938885960974340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NTV Incentive Cost RR (copy)_3285938885908586498] / [NTV GMV RR (copy)_3285938885909118979]' />
            </column>
            <column caption='EC iCPGMV Net RR Date Trends' datatype='string' name='[NTV iCPGMV RR Date Trends (copy)_3285938885964238856]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])) - LOOKUP(ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([NTV iCPGMV RR (copy)_3285938885960974340]) - LOOKUP(ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])),1)) * 100&#10;    ,2)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])) - LOOKUP(ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])),1)) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([NTV iCPGMV RR (copy)_3285938885960974340]) - LOOKUP(ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])),1)) * 100&#10;    ,2)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='EC iCPGMV Net RR Date Trends Colour' datatype='string' name='[NTV iCPGMV RR Date Trends Colour (copy)_3285938885964566537]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])) - LOOKUP(ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])) - LOOKUP(ZN(SUM([NTV iCPGMV RR (copy)_3285938885960974340])),1)) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='W-6' datatype='boolean' name='[W-5 (copy)_4791900436400861199]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] = DATETRUNC(&quot;iso-week&quot;, DATEADD(&quot;week&quot;, -6, TODAY()))' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column datatype='real' name='[incentive_cost_fp_marketing_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[incentive_cost_fp_marketing_eur_ntp]' role='measure' type='quantitative' />
            <column datatype='real' name='[incentive_cost_fp_marketing_eur_ntv]' role='measure' type='quantitative' />
            <column datatype='real' name='[incentive_cost_fp_marketing_local]' role='measure' type='quantitative' />
