            </column>
            <column caption='Sessions RR' datatype='real' name='[GMV RR (copy)_6156913287032786970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;RR On&quot; THEN&#10;        IF [report_date_local] = DATETRUNC(&quot;month&quot;, TODAY() - 1) AND [date_type] = &quot;Month&quot;&#10;        THEN [menu_sessions] / DAY(TODAY() - 3) * DAY(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;, 1, TODAY())) - 1)&#10;        ELSE [menu_sessions]&#10;    END&#10;    WHEN &quot;RR Off&quot; THEN&#10;        [menu_sessions]&#10;END' />
            </column>
            <column caption='Sessions RR Date Trends' datatype='string' name='[GMV RR Date Trends (copy)_3405284332743671812]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF (ZN(SUM([GMV RR (copy)_6156913287032786970])) - LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1)) / LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([GMV RR (copy)_6156913287032786970]) - LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1)) / LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF (ZN(SUM([GMV RR (copy)_6156913287032786970])) - LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1)) / LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1) &lt;= 0&#10;    THEN &apos;▼ &apos; &#10;    ELSE &apos;▲ &apos; &#10;    END)&#10;&#10;    + STR(&#10;    ROUND(&#10;    (SUM([GMV RR (copy)_6156913287032786970]) - LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1)) / LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1) * 100&#10;    ,1)&#10;    )&#10;&#10;    + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions RR Date Trends Colour' datatype='string' name='[GMV RR Date Trends Colour (copy)_3405284332744581126]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//ROUND((ZN(SUM([GMV RR])) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])), 1), 3) * 100&#10;//(SUM([GMV RR]) - LOOKUP(ZN(SUM([GMV RR])), 1)) / LOOKUP(ZN(SUM([GMV RR])),1)&#10;&#10;IF ATTR([date_type]) = &quot;Week&quot; THEN (&#10;    IF NOT ATTR([W-5 (copy)_4791900436400861199]) THEN (&#10;        IF (ZN(SUM([GMV RR (copy)_6156913287032786970])) - LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1)) / LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;&#10;ELSEIF ATTR([date_type]) = &quot;Month&quot; THEN (&#10;    IF NOT ATTR([M-4 (copy)_4791900436404002835]) THEN (&#10;        IF (ZN(SUM([GMV RR (copy)_6156913287032786970])) - LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1)) / LOOKUP(ZN(SUM([GMV RR (copy)_6156913287032786970])),1) &lt;= 0&#10;        THEN &apos;▼ &apos; &#10;        ELSE &apos;▲ &apos;&#10;        END)&#10;    ELSE NULL&#10;    END)&#10;END'>
                <table-calc ordering-type='Rows' />
