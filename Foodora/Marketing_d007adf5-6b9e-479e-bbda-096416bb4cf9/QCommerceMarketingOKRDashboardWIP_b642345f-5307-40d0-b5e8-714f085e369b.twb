              <calculation class='tableau' formula='//IF ATTR([Vertical]) = &quot;Pandamart&quot; THEN&#10;    //IF (SUM([Weekly Shoppers RR]) / SUM([Dmart Targets].[MAU Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot; THEN&#10;    //IF (SUM([MAU RR]) / SUM([Shops Targets].[MAU Target]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;IF ATTR([vertical]) = &quot;Q-Commerce&quot; THEN&#10;    IF (SUM([MAU RR (copy)_5191594901438930946]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Weekly Shoppers]) - 1) &lt; 0 THEN &apos;▼ &apos; ELSE &apos;▲ &apos; END&#10;END&#10;+ &apos; &apos; +&#10;//IF ATTR([Vertical]) = &quot;Pandamart&quot;&#10;    //THEN STR(ROUND(((SUM([MAU RR]) / SUM([Dmart Targets].[MAU Target]) - 1) * 100), 1)) + &apos;%&apos;&#10;//ELSEIF ATTR([Vertical]) = &quot;Shops&quot;&#10;    //THEN STR(ROUND(((SUM([MAU RR]) / SUM([Shops Targets].[MAU Target]) - 1) * 100), 1)) + &apos;%&apos;&#10;IF ATTR([vertical]) = &quot;Q-Commerce&quot;&#10;    THEN STR(ROUND(((SUM([MAU RR (copy)_5191594901438930946]) / SUM([federated.0l2wv2s19fwbqt1bu8w0b08brspu (copy)].[Weekly Shoppers]) - 1) * 100), 1)) + &apos;%&apos;&#10;END' />
