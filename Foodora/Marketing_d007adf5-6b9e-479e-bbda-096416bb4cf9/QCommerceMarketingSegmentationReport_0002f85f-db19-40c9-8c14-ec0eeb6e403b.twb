      <aliases enabled='yes' />
      <column caption='% Lost Revived Cust Using Incentives' datatype='real' name='[% Lapsing Revived Cust Using Incentives (copy)_4097923852872073270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lost_revived_inc_cust]) / SUM([lost_revived_cust])' />
      </column>
      <column caption='% Inactive QC Revived Cust Using Incentives' datatype='real' name='[% Lost Revived Cust Using Incentives (copy)_4097923874818748489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inactive_revived_inc_cust]) / SUM([inactive_revived_cust])' />
      </column>
      <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_4097923852232118272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date_local] &gt;= DATEADD(&quot;month&quot;, -5, DATETRUNC(&quot;month&quot;, TODAY())) AND [report_date_local] &lt; DATETRUNC(&quot;month&quot;, TODAY()) THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='NTV Cust' datatype='integer' name='[Calculation_4097923852270780419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;New To Vertical&quot;, [cust], 0))' />
      </column>
      <column caption='First Calc' datatype='boolean' name='[Calculation_4097923854375940155]' role='measure' type='nominal'>
        <calculation class='tableau' formula='FIRST()==0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Filter' datatype='date' name='[Date (copy)_4097923852600860690]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[report_date_local]' />
      </column>
      <column caption='Date Range' datatype='date' name='[Date Filter (copy)_4097923852600905747]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[report_date_local]' />
      </column>
      <column caption='Lapsing Grooming % FLGP Positive Cust' datatype='real' name='[Grooming 31-60 % FLGP Positive Cust (copy)_4097923852603785240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [flgpu_positive_cust], 0)) / SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [cust], 0))' />
      </column>
      <column caption='Lapsing Grooming ABV' datatype='real' name='[Grooming 31-60 ABV (copy)_4097923852603314198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [l30d_gmv_net_eur], 0)) / SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [l30d_orders], 0))' />
      </column>
      <column caption='Lapsing Grooming Cust' datatype='integer' name='[Grooming 31-60 Cust (copy)_4097923852600569873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [cust], 0))' />
      </column>
      <column caption='NTV Cust MoM Δ' datatype='real' name='[Grooming 31-60 Cust (copy)_4097923852614701088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//([NTV Cust] - LOOKUP(ZN([NTV Cust]), 1)) / LOOKUP(ZN([NTV Cust]),1)&#10;(ZN([Calculation_4097923852270780419]) / LOOKUP(ZN([Calculation_4097923852270780419]), -1)) - 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Lapsing Grooming GMV Share' datatype='real' name='[Grooming 31-60 GMV Share (copy)_4097923852603027477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [l30d_gmv_net_eur], 0)) / SUM(IIF([segment] = &quot;New Customers&quot; OR [segment] = &quot;Existing Customers&quot;, [l30d_gmv_net_eur], 0))' />
      </column>
      <column caption='% M-1 NTV -&gt; Grooming Cust' datatype='real' name='[Grooming 31-60 ICpGMV (copy)_4097923852598112271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Grooming&quot;, [cust], 0)) / SUM(IIF([subsegment] = &quot;Grooming&quot;, [ntv_m1_cust], 0))' />
      </column>
      <column caption='Lapsing Grooming ICpGMV' datatype='real' name='[Grooming 31-60 ICpGMV (copy)_4097923852603555863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [l30d_incentive_eur], 0)) / SUM(IIF([subsegment] = &quot;Lapsing Grooming&quot;, [l30d_gmv_net_eur], 0))' />
      </column>
      <column caption='Lapsing Cust' datatype='integer' name='[Irregular Shoppers Cust (copy)_4097923852869685295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Lapsing&quot;, [cust], 0))' />
      </column>
      <column caption='Lost Cust' datatype='integer' name='[Lapsing Cust (copy)_4097923852869918768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subsegment] = &quot;Lost&quot;, [cust], 0))' />
      </column>
      <column caption='Lapsing Revived Cust' datatype='integer' name='[Lapsing Cust (copy)_4097923852870414387]' role='measure' type='quantitative'>
