      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_554BC383C5544A4F825C78D6B17F5290'>
            <properties context=''>
              <relation connection='bigquery.0qeawew021oeib1govv4v17beoqz' name='Custom SQL Query' type='text'><![CDATA[WITH pandora_markets AS (
  SELECT
    IF(region = "Asia", "APAC", "EU + TR") AS region,
    global_entity_id,
    name AS country
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_countries`
  WHERE region IN ("Asia", "Europe", "MENA")
    AND name NOT IN ("Germany", "Denmark")
    AND global_entity_id NOT LIKE "ODR_%"
)

SELECT
  perf.report_date_local,
  perf.region,
  perf.global_entity_id,
  CASE WHEN perf.global_entity_id = "EU + TR" THEN "EU + TR"
       WHEN perf.global_entity_id = "APAC" THEN "APAC"
       ELSE pandora_markets.country
  END AS country,
  perf.vertical,
  perf.qc_segment AS segment,
  perf.profit_segment_order AS profit_segment,
  perf.pfm_segment,
  SUM(perf.gmv_net_eur) AS gmv_net_eur
FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_segmentation_acid_monthly_performance` AS perf
---FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_gmv`
LEFT JOIN pandora_markets
       ON perf.global_entity_id = pandora_markets.global_entity_id
WHERE perf.report_date_local >>= "2024-01-01" 
  AND perf.report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='regional_apac_mkt_qc_crm_dashboard' inline='true' name='federated.1eujeek0oonn8917zwqjy0k0izbp' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0w54x7c012heph14o84wd14lz14d'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='yueze.zou@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0w54x7c012heph14o84wd14lz14d' name='Custom SQL Query' type='text'><![CDATA[WITH adhoc_data AS (
  SELECT
    DATE_TRUNC(period, MONTH) AS report_date_local,
    global_entity_id,
    channel_type,
    "ADHOC" AS data_source,
    IF(UPPER(campaign_name) LIKE "%DMA%" OR UPPER(campaign_name) LIKE "%QUI%" OR UPPER(campaign_name) LIKE "%LOC%"
       OR UPPER(canvas_name) LIKE "%DMA%" OR UPPER(canvas_name) LIKE "%QUI%" OR UPPER(canvas_name) LIKE "%LOC%", TRUE, FALSE) AS is_qc,
    canvas_name,
    campaign_name,
    CASE
      WHEN channel_type = "EMAIL" THEN delivered
      WHEN channel_type = "PUSH" THEN sent - bounce
      ELSE NULL
    END AS delivery,
    IF(channel_type IN ("EMAIL", "IAM"), clicked, NULL) AS clicks,
    click_orders AS clicks_orders,
    IF(channel_type IN ("EMAIL", "PUSH"), opened, NULL) AS open,
    open_orders,
    IF(channel_type = "IAM", impression, NULL) AS impressions_iam
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_all_comms_performance`
  WHERE period >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE - 1, YEAR), INTERVAL 1 YEAR) 
    AND period << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
    AND channel_type IN ("EMAIL", "IAM", "PUSH")
    AND data_source IN ("AUTO CAMPAIGN PERFORMANCE", "CAMPAIGN PERFORMANCE")
    AND global_entity_id != "Prospect NA"
),

auto_data AS (
  SELECT
    DATE_TRUNC(period, MONTH) AS report_date_local,
    global_entity_id,
    channel_type,
    "AUTO" AS data_source,
    IF(UPPER(campaign_name) LIKE "%DMA%" OR UPPER(campaign_name) LIKE "%QUI%" OR UPPER(campaign_name) LIKE "%LOC%"
       OR UPPER(canvas_name) LIKE "%DMA%" OR UPPER(canvas_name) LIKE "%QUI%" OR UPPER(canvas_name) LIKE "%LOC%", TRUE, FALSE) AS is_qc,
    canvas_name,
    campaign_name,
    CASE
