        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1d304y80zpo2y51g6e5sq1rxzxa4' name='Custom SQL Query' type='text'><![CDATA[SELECT
  seg.report_date_local,
  seg.region,
  seg.country,
  seg.global_entity_id,
  seg.vertical,
  CASE
    WHEN seg.qc_segment = "NC" THEN seg.qc_segment
    WHEN seg.qc_segment != "NC" AND seg.is_subscriber_order = "Pro"  THEN "EC Pro"
    WHEN seg.qc_segment != "NC" AND seg.is_subscriber_order = "Non Pro"  THEN "EC Non Pro"
  END AS cust_type,
  CASE
    WHEN seg.qc_segment = "NC" AND seg.pfm_segment NOT IN ("G Unprofitable Subscribers", "H Deal Hunters") THEN "Target Segment"
    WHEN seg.qc_segment = "NC" AND seg.pfm_segment IN ("G Unprofitable Subscribers", "H Deal Hunters") THEN "Non Target Segment"
    WHEN seg.qc_segment != "NC" AND seg.profit_segment NOT IN ("Developing") THEN "Target Segment"
    WHEN seg.qc_segment != "NC" AND seg.profit_segment IN ("Developing") THEN "Non Target Segment"
  END AS mau_segment,
  CASE
    WHEN seg.qc_segment = "NC" THEN seg.qc_segment
    WHEN seg.qc_segment != "NC" AND seg.profit_segment NOT IN ("Developing") THEN "Target Segment"
    WHEN seg.qc_segment != "NC" AND seg.profit_segment IN ("Developing") THEN "Non Target Segment"    
  END AS gmv_segment,
  SUM(seg.gmv_net_eur) AS gmv_net_eur,
  SUM(seg.orders) AS orders,
  SUM(seg.incentive_cost_fp_marketing_eur) AS incentive_cost_fp_marketing_eur,
  SUM(seg.cust) AS cust
FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_segmentation_acid_monthly_performance` AS seg
----FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_gmv` AS seg
WHERE seg.report_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE - 1, YEAR), INTERVAL 1 YEAR)
  AND seg.report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
