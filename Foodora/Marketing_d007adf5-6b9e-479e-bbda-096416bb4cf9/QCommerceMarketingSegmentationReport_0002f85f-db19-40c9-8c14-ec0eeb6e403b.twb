      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_147F3674903E4E379148152160C7F98E'>
            <properties context=''>
              <relation connection='bigquery.1d304y80zpo2y51g6e5sq1rxzxa4' name='Custom SQL Query' type='text'><![CDATA[SELECT
  seg.report_date_local,
  seg.region,
  seg.country,
  seg.global_entity_id,
  seg.vertical,
  CASE
    WHEN seg.qc_segment = "NC" THEN seg.qc_segment
    WHEN seg.qc_segment != "NC" AND seg.is_subscriber_order = "Pro"  THEN "EC Pro"
    WHEN seg.qc_segment != "NC" AND seg.is_subscriber_order = "Non Pro"  THEN "EC Non Pro"
  END AS cust_type,
  CASE
    WHEN seg.qc_segment = "NC" AND seg.pfm_segment NOT IN ("G Unprofitable Subscribers", "H Deal Hunters") THEN "Target Segment"
    WHEN seg.qc_segment = "NC" AND seg.pfm_segment IN ("G Unprofitable Subscribers", "H Deal Hunters") THEN "Non Target Segment"
    WHEN seg.qc_segment != "NC" AND seg.profit_segment NOT IN ("Developing") THEN "Target Segment"
    WHEN seg.qc_segment != "NC" AND seg.profit_segment IN ("Developing") THEN "Non Target Segment"
  END AS mau_segment,
  CASE
    WHEN seg.qc_segment = "NC" THEN seg.qc_segment
    WHEN seg.qc_segment != "NC" AND seg.profit_segment NOT IN ("Developing") THEN "Target Segment"
    WHEN seg.qc_segment != "NC" AND seg.profit_segment IN ("Developing") THEN "Non Target Segment"    
  END AS gmv_segment,
  SUM(seg.gmv_net_eur) AS gmv_net_eur,
  SUM(seg.orders) AS orders,
  SUM(seg.incentive_cost_fp_marketing_eur) AS incentive_cost_fp_marketing_eur,
  SUM(seg.cust) AS cust
FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_segmentation_acid_monthly_performance` AS seg
----FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_gmv` AS seg
WHERE seg.report_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE - 1, YEAR), INTERVAL 1 YEAR)
  AND seg.report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='marketing__qcommerce_segmentation_acid_monthly_performance' inline='true' name='federated.152ccfe0c0zxxm1djc9sx05h5ip4' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0qeawew021oeib1govv4v17beoqz'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='yueze.zou@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0qeawew021oeib1govv4v17beoqz' name='Custom SQL Query' type='text'><![CDATA[WITH pandora_markets AS (
  SELECT
    IF(region = "Asia", "APAC", "EU + TR") AS region,
    global_entity_id,
    name AS country
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_countries`
  WHERE region IN ("Asia", "Europe", "MENA")
    AND name NOT IN ("Germany", "Denmark")
    AND global_entity_id NOT LIKE "ODR_%"
)

SELECT
  perf.report_date_local,
  perf.region,
  perf.global_entity_id,
  CASE WHEN perf.global_entity_id = "EU + TR" THEN "EU + TR"
       WHEN perf.global_entity_id = "APAC" THEN "APAC"
       ELSE pandora_markets.country
  END AS country,
  perf.vertical,
  perf.qc_segment AS segment,
  perf.profit_segment_order AS profit_segment,
  perf.pfm_segment,
  SUM(perf.gmv_net_eur) AS gmv_net_eur
FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_segmentation_acid_monthly_performance` AS perf
---FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_gmv`
LEFT JOIN pandora_markets
       ON perf.global_entity_id = pandora_markets.global_entity_id
WHERE perf.report_date_local >>= "2024-01-01" 
  AND perf.report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0qeawew021oeib1govv4v17beoqz' name='Custom SQL Query' type='text'><![CDATA[WITH pandora_markets AS (
  SELECT
    IF(region = "Asia", "APAC", "EU + TR") AS region,
    global_entity_id,
    name AS country
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_countries`
  WHERE region IN ("Asia", "Europe", "MENA")
    AND name NOT IN ("Germany", "Denmark")
    AND global_entity_id NOT LIKE "ODR_%"
)

SELECT
  perf.report_date_local,
  perf.region,
  perf.global_entity_id,
  CASE WHEN perf.global_entity_id = "EU + TR" THEN "EU + TR"
       WHEN perf.global_entity_id = "APAC" THEN "APAC"
       ELSE pandora_markets.country
  END AS country,
  perf.vertical,
  perf.qc_segment AS segment,
  perf.profit_segment_order AS profit_segment,
  perf.pfm_segment,
  SUM(perf.gmv_net_eur) AS gmv_net_eur
FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_segmentation_acid_monthly_performance` AS perf
---FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_gmv`
LEFT JOIN pandora_markets
       ON perf.global_entity_id = pandora_markets.global_entity_id
WHERE perf.report_date_local >>= "2024-01-01" 
  AND perf.report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
