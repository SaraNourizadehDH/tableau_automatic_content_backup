         ON shops_seg_sum.global_entity_id = shops_ntv_hist.global_entity_id
        AND shops_seg_sum.report_date_local = DATE_ADD(shops_ntv_hist.report_date_local, INTERVAL 1 MONTH)
),

eu_final AS (
SELECT
  qc_sum.report_date_local,
  qc_sum.global_entity_id,
  IF(qc_sum.vertical = "Dmart", "Pandamart", qc_sum.vertical) AS vertical,
