  WHERE partition_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE - 1, YEAR), INTERVAL 1 YEAR)
    AND partition_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
)

SELECT
  adhoc_data.report_date_local,
