ubsegment] = &quot;Irregular Shoppers&quot; AND [subsegment_f1] IN (&quot;Lost&quot;, &quot;Inactive QC&quot;, NULL) THEN &quot;Lapsing&quot;&#10;&#10;ELSEIF [subsegment] = &quot;Lapsing&quot; AND [subsegment_f1] IN (&quot;New To Vertical&quot;, &quot;Grooming&quot;, &quot;Lapsing Grooming&quot;) THEN &quot;Irregular Shoppers&quot;&#10;ELSEIF [subsegment] = &quot;Lapsing&quot; AND [subsegment_f1] IN (&quot;Inactive QC&quot;) THEN &quot;Lost&quot;&#10;ELSEIF [subsegment] = &quot;Lapsing&quot; AND [subsegment_f1] IN (NULL) THEN &quot;Lost&quot;&#10;&#10;ELSEIF [subsegment] = &quot;Lost&quot; AND [subsegment_f1] IN (&quot;New To Vertical&quot;, &quot;Grooming&quot;, &quot;Lapsing Grooming&quot;) THEN &quot;Irregular Shoppers&quot;&#10;ELSEIF [subsegment] = &quot;Lost&quot; AND [subsegment_f1] IN (&quot;Lapsing&quot;) THEN &quot;Lost&quot;&#10;ELSEIF [subsegment] = &quot;Lost&quot; AND [subsegment_f1] IN (NULL) THEN &quot;Inactive QC&quot;&#10;&#10;ELSEIF [subsegment] = &quot;Inactive QC&quot; AND [subsegment_f1] IN (&quot;New To Vertical&quot;, &quot;Grooming&quot;, &quot;Lapsing Grooming&quot;) THEN &quot;Irregular Shoppers&quot;&#10;ELSEIF [subsegment] = &quot;Inactive QC&quot; AND [subsegment_f1] IN (&quot;Lapsing&quot;, &quot;Lost&quot;) THEN &quot;Inactive QC&quot;&#10;ELSEIF [subsegment] = &quot;Inactive QC&quot; AND [subsegment_f1] IN (NULL) THEN &quot;Others&quot;&#10;ELSE [subsegment_f1]&#10;END' />
