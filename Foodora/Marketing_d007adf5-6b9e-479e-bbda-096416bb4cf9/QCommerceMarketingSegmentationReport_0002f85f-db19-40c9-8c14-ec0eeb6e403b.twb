        </manual-sort>
        <manual-sort column='[none:subsegment:nk]' direction='ASC'>
          <dictionary>
            <bucket>&quot;New To Vertical&quot;</bucket>
            <bucket>&quot;Grooming&quot;</bucket>
            <bucket>&quot;Lapsing Grooming&quot;</bucket>
            <bucket>&quot;Weekly Shoppers&quot;</bucket>
            <bucket>&quot;Monthly Shoppers&quot;</bucket>
            <bucket>&quot;Irregular Shoppers&quot;</bucket>
            <bucket>&quot;Lapsing&quot;</bucket>
            <bucket>&quot;Lost&quot;</bucket>
            <bucket>&quot;Inactive QC&quot;</bucket>
          </dictionary>
        </manual-sort>
      </default-sorts>
      <datasource-dependencies datasource='federated.0bk14sd0nknux61ecx1mx1rf2n72'>
        <column caption='NTP + NTV' datatype='integer' name='[Calculation_2089318432460644358]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([ntp_qc]) + SUM([ntv_qc])' />
        </column>
        <column caption='QC Sessions Share' datatype='real' default-format='p0.0%' name='[Calculation_2089318432817565703]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([sessions])/SUM([platform_sessions])' />
        </column>
        <column datatype='real' name='[hva_spend_qc]' role='measure' type='quantitative' />
        <column datatype='real' name='[non_hva_spend_qc]' role='measure' type='quantitative' />
        <column datatype='integer' name='[ntp_qc]' role='measure' type='quantitative' />
        <column datatype='integer' name='[ntv_qc]' role='measure' type='quantitative' />
        <column datatype='integer' name='[num_of_sh_customers_in_delivery_area_cnty]' role='measure' type='quantitative' />
        <column datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[platform_sessions]' role='measure' type='quantitative' />
        <column datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[sessions]' role='measure' type='quantitative' />
        <column-instance column='[hva_spend_qc]' derivation='Sum' name='[sum:hva_spend_qc:qk]' pivot='key' type='quantitative' />
        <column-instance column='[non_hva_spend_qc]' derivation='Sum' name='[sum:non_hva_spend_qc:qk]' pivot='key' type='quantitative' />
        <column-instance column='[ntp_qc]' derivation='Sum' name='[sum:ntp_qc:qk]' pivot='key' type='quantitative' />
        <column-instance column='[ntv_qc]' derivation='Sum' name='[sum:ntv_qc:qk]' pivot='key' type='quantitative' />
        <column-instance column='[num_of_sh_customers_in_delivery_area_cnty]' derivation='Sum' name='[sum:num_of_sh_customers_in_delivery_area_cnty:qk]' pivot='key' type='quantitative' />
        <column-instance column='[platform_sessions]' derivation='Sum' name='[sum:platform_sessions:qk]' pivot='key' type='quantitative' />
        <column-instance column='[sessions]' derivation='Sum' name='[sum:sessions:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Calculation_2089318432460644358]' derivation='User' name='[usr:Calculation_2089318432460644358:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Calculation_2089318432817565703]' derivation='User' name='[usr:Calculation_2089318432817565703:qk]' pivot='key' type='quantitative' />
