            </column>
            <column caption='Prev Segment' datatype='string' name='[Prev Mth Subsegment (copy)_3931994346969972738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [subsegment] = &quot;New To Vertical&quot; THEN &quot;New To Vertical&quot;&#10;ELSEIF [subsegment] = &quot;Grooming&quot; THEN &quot;New To Vertical&quot;&#10;ELSEIF [subsegment] = &quot;Lapsing Grooming&quot; THEN &quot;New To Vertical&quot;&#10;ELSEIF [subsegment] = &quot;Weekly Shoppers&quot; AND [subsegment_m1] IN (&quot;Inactive QC&quot;, &quot;Lost&quot;, NULL) THEN &quot;Lapsing&quot;&#10;ELSEIF [subsegment] = &quot;Weekly Shoppers&quot; AND [subsegment_m1] IN (&quot;New To Vertical&quot;) THEN &quot;Lapsing Grooming&quot;&#10;ELSEIF [subsegment] = &quot;Monthly Shoppers&quot; AND [subsegment_m1] IN (&quot;Inactive QC&quot;, &quot;Lost&quot;, NULL) THEN &quot;Lapsing&quot;&#10;ELSEIF [subsegment] = &quot;Monthly Shoppers&quot; AND [subsegment_m1] IN (&quot;New To Vertical&quot;) THEN &quot;Lapsing Grooming&quot;&#10;ELSEIF [subsegment] = &quot;Irregular Shoppers&quot; AND [subsegment_m1] IN (NULL) THEN &quot;Lapsing&quot;&#10;ELSEIF [subsegment] = &quot;Irregular Shoppers&quot; AND [subsegment_m1] IN (&quot;New To Vertical&quot;) THEN &quot;Lapsing Grooming&quot;&#10;ELSEIF [subsegment] = &quot;Lapsing&quot; AND [subsegment_m1] IN (NULL) THEN &quot;Irregular Shoppers&quot;&#10;ELSEIF [subsegment] = &quot;Lapsing&quot; AND [subsegment_m1] IN (&quot;Inactive QC&quot;, &quot;Lost&quot;) THEN &quot;Lapsing&quot;&#10;ELSEIF [subsegment] = &quot;Lapsing&quot; AND [subsegment_m1] IN (&quot;New To Vertical&quot;) THEN &quot;Lapsing Grooming&quot;&#10;ELSEIF [subsegment] = &quot;Lost&quot; AND [subsegment_m1] IN (NULL) THEN &quot;Lapsing&quot;&#10;ELSEIF [subsegment] = &quot;Lost&quot; AND NOT([subsegment_m1] IN (&quot;Lapsing&quot;, &quot;Lost&quot;)) THEN &quot;Lapsing&quot;&#10;ELSEIF [subsegment] = &quot;Inactive QC&quot; AND [subsegment_m1] IN (NULL) THEN &quot;Lost&quot;&#10;ELSEIF [subsegment] = &quot;Inactive QC&quot; AND NOT([subsegment_m1] IN (&quot;Lost&quot;, &quot;Inactive QC&quot;)) THEN &quot;Lost&quot;&#10;ELSE [subsegment_m1]&#10;END' />
            </column>
