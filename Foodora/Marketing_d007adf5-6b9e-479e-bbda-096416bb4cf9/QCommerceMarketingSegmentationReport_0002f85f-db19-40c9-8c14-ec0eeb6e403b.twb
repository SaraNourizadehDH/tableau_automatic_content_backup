  SUM(handbook_data.open) AS open,
  SUM(handbook_data.open_orders) AS open_orders,
  SUM(handbook_data.impressions_iam) AS impressions_iam
FROM handbook_data
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
        ON handbook_data.global_entity_id = countries.global_entity_id
WHERE handbook_data.is_qc
GROUP BY
  handbook_data.report_date_local,
  country,
  handbook_data.global_entity_id,
  vertical,
  handbook_data.channel_type,
  handbook_data.data_source
UNION ALL
SELECT
  report_date_local,
  "APAC" AS country,
  "APAC" AS global_entity_id,
  "Q-Commerce" AS vertical,
  channel_type,
  data_source,
  SUM(delivery) AS delivery,
  SUM(clicks) AS clicks,
  SUM(IF(channel_type = "IAM", impressions_iam, delivery)) AS clicks_denom,
  SUM(clicks_orders) AS clicks_orders,
  SUM(open) AS open,
  SUM(open_orders) AS open_orders,
  SUM(impressions_iam) AS impressions_iam
FROM handbook_data
WHERE is_qc
GROUP BY
  report_date_local,
  country,
  global_entity_id,
  vertical,
  channel_type,
  data_source
UNION ALL
SELECT
  handbook_data.report_date_local,
