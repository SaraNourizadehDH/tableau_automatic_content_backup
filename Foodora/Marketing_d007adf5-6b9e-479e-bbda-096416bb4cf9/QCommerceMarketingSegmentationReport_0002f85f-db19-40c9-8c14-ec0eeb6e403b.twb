    seg.l30d_incentivised_orders,
    seg.l30d_lost_gmv_net_eur,
    COALESCE(flgpu_data.is_flgpu_positive, FALSE) AS is_flgpu_positive,
    ROW_NUMBER() OVER (PARTITION BY seg.analytical_customer_id, seg.report_date_local) AS rank
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_dmart_segmentation_acid` AS seg
  LEFT JOIN dmart_seg_hist
         ON seg.analytical_customer_id = dmart_seg_hist.analytical_customer_id
        AND seg.report_date_local = DATE_ADD(dmart_seg_hist.report_date_local, INTERVAL 1 MONTH)
  LEFT JOIN flgpu_data
         ON seg.analytical_customer_id = flgpu_data.analytical_customer_id
        AND seg.report_date_local = flgpu_data.report_date_local
  WHERE seg.report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND seg.report_date_local >>= "2023-01-01"
  QUALIFY rank = 1
),

dmart_seg_sum AS (
  SELECT
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS cust,
    SUM(l30d_gmv_net_eur) AS l30d_gmv_net_eur,
    SUM(l30d_incentive_cost_fp_marketing_eur) AS l30d_incentive_eur,
    SUM(l30d_orders) AS l30d_orders,
    SUM(l30d_lost_gmv_net_eur) AS l30d_lost_gmv_net_eur,
    COUNT(DISTINCT IF(subsegment = "Grooming", analytical_customer_id, NULL)) AS grooming_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing", analytical_customer_id, NULL)) AS lapsing_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lapsing_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lapsing_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost", analytical_customer_id, NULL)) AS lost_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lost_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lost_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC", analytical_customer_id, NULL)) AS inactive_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS inactive_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS inactive_revived_incentive_eur,
    COUNT(DISTINCT IF(is_flgpu_positive, analytical_customer_id, NULL)) AS flgpu_positive_cust
  FROM dmart_seg
  GROUP BY
    report_date_local,
    global_entity_id,
    vertical,
