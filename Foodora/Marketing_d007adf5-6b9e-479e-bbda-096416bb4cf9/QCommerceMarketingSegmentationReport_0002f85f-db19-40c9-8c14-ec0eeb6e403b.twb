),

shops_seg AS (
  SELECT
    seg.report_date_local,
    seg.global_entity_id,
    seg.vertical,
    FALSE AS is_b2b,
    seg.analytical_customer_id,
    seg.segment,
    shops_seg_hist.segment AS segment_m1,
    seg.subsegment,
    shops_seg_hist.subsegment AS subsegment_m1,
    seg.l30d_gmv_net_eur,
    seg.l30d_incentive_cost_fp_marketing_eur,
