          <named-connection caption='BigQuery' name='bigquery.1d304y80zpo2y51g6e5sq1rxzxa4'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='yueze.zou@foodpanda.sg' workgroup-auth-mode='prompt' />
