    seg.l30d_incentivised_orders,
    seg.l30d_lost_gmv_net_eur,
    COALESCE(flgpu_data.is_flgpu_positive, FALSE) AS is_flgpu_positive,
    ROW_NUMBER() OVER (PARTITION BY seg.analytical_customer_id, seg.report_date_local) AS rank
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_shops_segmentation_acid` AS seg
  LEFT JOIN shops_seg_hist
         ON seg.analytical_customer_id = shops_seg_hist.analytical_customer_id
        AND seg.report_date_local = DATE_ADD(shops_seg_hist.report_date_local, INTERVAL 1 MONTH)
  LEFT JOIN flgpu_data
         ON seg.analytical_customer_id = flgpu_data.analytical_customer_id
        AND seg.report_date_local = flgpu_data.report_date_local
  WHERE seg.report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND seg.report_date_local >>= "2023-01-01"
  QUALIFY rank = 1
),

shops_seg_sum AS (
  SELECT
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS cust,
    SUM(l30d_gmv_net_eur) AS l30d_gmv_net_eur,
    SUM(l30d_incentive_cost_fp_marketing_eur) AS l30d_incentive_eur,
    SUM(l30d_orders) AS l30d_orders,
    SUM(l30d_lost_gmv_net_eur) AS l30d_lost_gmv_net_eur,
    COUNT(DISTINCT IF(subsegment = "Grooming", analytical_customer_id, NULL)) AS grooming_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing", analytical_customer_id, NULL)) AS lapsing_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lapsing_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lapsing_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost", analytical_customer_id, NULL)) AS lost_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lost_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lost_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC", analytical_customer_id, NULL)) AS inactive_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS inactive_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS inactive_revived_incentive_eur,
    COUNT(DISTINCT IF(is_flgpu_positive, analytical_customer_id, NULL)) AS flgpu_positive_cust
  FROM shops_seg
  GROUP BY
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment
),

qc_sum AS (
  SELECT
    qc_seg_sum.report_date_local,
    qc_seg_sum.global_entity_id,
    qc_seg_sum.vertical,
    qc_seg_sum.is_b2b,
    qc_seg_sum.segment,
    qc_seg_sum.subsegment,
    qc_seg_sum.cust,
    qc_ntv_hist.ntv_m1_cust,
    qc_seg_sum.l30d_gmv_net_eur,
    qc_seg_sum.l30d_incentive_eur,
    qc_seg_sum.l30d_orders,
    qc_seg_sum.grooming_cust,
    qc_seg_sum.lapsing_revived_cust,
    qc_seg_sum.lapsing_revived_inc_cust,
    qc_seg_sum.lapsing_revived_incentive_eur,
    qc_seg_sum.lost_revived_cust,
    qc_seg_sum.lost_revived_inc_cust,
    qc_seg_sum.lost_revived_incentive_eur,
    qc_seg_sum.l30d_lost_gmv_net_eur,
    qc_seg_sum.inactive_revived_cust,
    qc_seg_sum.inactive_revived_inc_cust,
    qc_seg_sum.inactive_revived_incentive_eur,
    qc_seg_sum.flgpu_positive_cust
  FROM qc_seg_sum
  LEFT JOIN qc_ntv_hist
         ON qc_seg_sum.global_entity_id = qc_ntv_hist.global_entity_id
        AND qc_seg_sum.report_date_local = DATE_ADD(qc_ntv_hist.report_date_local, INTERVAL 1 MONTH)
),

dmart_sum AS (
  SELECT
    dmart_seg_sum.report_date_local,
    dmart_seg_sum.global_entity_id,
    dmart_seg_sum.vertical,
    dmart_seg_sum.is_b2b,
    dmart_seg_sum.segment,
    dmart_seg_sum.subsegment,
    dmart_seg_sum.cust,
    dmart_ntv_hist.ntv_m1_cust,
    dmart_seg_sum.l30d_gmv_net_eur,
    dmart_seg_sum.l30d_incentive_eur,
    dmart_seg_sum.l30d_orders,
    dmart_seg_sum.grooming_cust,
    dmart_seg_sum.lapsing_revived_cust,
    dmart_seg_sum.lapsing_revived_inc_cust,
    dmart_seg_sum.lapsing_revived_incentive_eur,
    dmart_seg_sum.lost_revived_cust,
    dmart_seg_sum.lost_revived_inc_cust,
    dmart_seg_sum.lost_revived_incentive_eur,
    dmart_seg_sum.l30d_lost_gmv_net_eur,
    dmart_seg_sum.inactive_revived_cust,
    dmart_seg_sum.inactive_revived_inc_cust,
    dmart_seg_sum.inactive_revived_incentive_eur,
    dmart_seg_sum.flgpu_positive_cust
  FROM dmart_seg_sum
  LEFT JOIN dmart_ntv_hist
         ON dmart_seg_sum.global_entity_id = dmart_ntv_hist.global_entity_id
        AND dmart_seg_sum.report_date_local = DATE_ADD(dmart_ntv_hist.report_date_local, INTERVAL 1 MONTH)
),

shops_sum AS (
  SELECT
    shops_seg_sum.report_date_local,
    shops_seg_sum.global_entity_id,
    shops_seg_sum.vertical,
    shops_seg_sum.is_b2b,
    shops_seg_sum.segment,
    shops_seg_sum.subsegment,
    shops_seg_sum.cust,
    shops_ntv_hist.ntv_m1_cust,
    shops_seg_sum.l30d_gmv_net_eur,
    shops_seg_sum.l30d_incentive_eur,
    shops_seg_sum.l30d_orders,
    shops_seg_sum.grooming_cust,
    shops_seg_sum.lapsing_revived_cust,
    shops_seg_sum.lapsing_revived_inc_cust,
    shops_seg_sum.lapsing_revived_incentive_eur,
    shops_seg_sum.lost_revived_cust,
    shops_seg_sum.lost_revived_inc_cust,
    shops_seg_sum.lost_revived_incentive_eur,
    shops_seg_sum.l30d_lost_gmv_net_eur,
    shops_seg_sum.inactive_revived_cust,
    shops_seg_sum.inactive_revived_inc_cust,
    shops_seg_sum.inactive_revived_incentive_eur,
    shops_seg_sum.flgpu_positive_cust
  FROM shops_seg_sum
  LEFT JOIN shops_ntv_hist
         ON shops_seg_sum.global_entity_id = shops_ntv_hist.global_entity_id
        AND shops_seg_sum.report_date_local = DATE_ADD(shops_ntv_hist.report_date_local, INTERVAL 1 MONTH)
),

eu_final AS (
SELECT
  qc_sum.report_date_local,
  qc_sum.global_entity_id,
  IF(qc_sum.vertical = "Dmart", "Pandamart", qc_sum.vertical) AS vertical,
  qc_sum.is_b2b,
  qc_sum.segment,
  qc_sum.subsegment,
  qc_sum.cust,
  qc_sum.ntv_m1_cust,
  qc_sum.l30d_gmv_net_eur,
  qc_sum.l30d_incentive_eur,
  qc_sum.l30d_orders,
  qc_sum.grooming_cust,
  qc_sum.lapsing_revived_cust,
  qc_sum.lapsing_revived_inc_cust,
  qc_sum.lapsing_revived_incentive_eur,
  qc_sum.lost_revived_cust,
  qc_sum.lost_revived_inc_cust,
  qc_sum.lost_revived_incentive_eur,
  qc_sum.l30d_lost_gmv_net_eur,
  qc_sum.inactive_revived_cust,
  qc_sum.inactive_revived_inc_cust,
  qc_sum.inactive_revived_incentive_eur,
  qc_sum.flgpu_positive_cust
FROM qc_sum
UNION ALL
SELECT
  qc_sum.report_date_local,
  "EU + TR" AS global_entity_id,
  IF(qc_sum.vertical = "Dmart", "Pandamart", qc_sum.vertical) AS vertical,
  qc_sum.is_b2b,
  qc_sum.segment,
  qc_sum.subsegment,
  SUM(qc_sum.cust) AS cust,
  SUM(qc_sum.ntv_m1_cust) AS ntv_m1_cust,
  SUM(qc_sum.l30d_gmv_net_eur) AS l30d_gmv_net_eur,
  SUM(qc_sum.l30d_incentive_eur) AS l30d_incentive_eur,
  SUM(qc_sum.l30d_orders) AS l30d_orders,
  SUM(qc_sum.grooming_cust) AS grooming_cust,
  SUM(qc_sum.lapsing_revived_cust) AS lapsing_revived_cust,
  SUM(qc_sum.lapsing_revived_inc_cust) AS lapsing_revived_inc_cust,
  SUM(qc_sum.lapsing_revived_incentive_eur) AS lapsing_revived_incentive_eur,
  SUM(qc_sum.lost_revived_cust) AS lost_revived_cust,
  SUM(qc_sum.lost_revived_inc_cust) AS lost_revived_inc_cust,
  SUM(qc_sum.lost_revived_incentive_eur) AS lost_revived_incentive_eur,
  SUM(qc_sum.l30d_lost_gmv_net_eur) AS l30d_lost_gmv_net_eur,
  SUM(qc_sum.inactive_revived_cust) AS inactive_revived_cust,
  SUM(qc_sum.inactive_revived_inc_cust) AS inactive_revived_inc_cust,
  SUM(qc_sum.inactive_revived_incentive_eur) AS inactive_revived_incentive_eur,
  SUM(qc_sum.flgpu_positive_cust) AS flgpu_positive_cust
FROM qc_sum
GROUP BY
  qc_sum.report_date_local,
  global_entity_id,
  qc_sum.vertical,
  qc_sum.is_b2b,
  qc_sum.segment,
  qc_sum.subsegment
UNION ALL
SELECT
  dmart_sum.report_date_local,
  dmart_sum.global_entity_id,
  IF(dmart_sum.vertical = "Dmart", "Pandamart", dmart_sum.vertical) AS vertical,
  dmart_sum.is_b2b,
  dmart_sum.segment,
  dmart_sum.subsegment,
  dmart_sum.cust,
  dmart_sum.ntv_m1_cust,
  dmart_sum.l30d_gmv_net_eur,
  dmart_sum.l30d_incentive_eur,
  dmart_sum.l30d_orders,
  dmart_sum.grooming_cust,
  dmart_sum.lapsing_revived_cust,
  dmart_sum.lapsing_revived_inc_cust,
  dmart_sum.lapsing_revived_incentive_eur,
  dmart_sum.lost_revived_cust,
  dmart_sum.lost_revived_inc_cust,
  dmart_sum.lost_revived_incentive_eur,
  dmart_sum.l30d_lost_gmv_net_eur,
  dmart_sum.inactive_revived_cust,
  dmart_sum.inactive_revived_inc_cust,
  dmart_sum.inactive_revived_incentive_eur,
  dmart_sum.flgpu_positive_cust
FROM dmart_sum
UNION ALL
SELECT
  dmart_sum.report_date_local,
  "EU + TR" AS global_entity_id,
  IF(dmart_sum.vertical = "Dmart", "Pandamart", dmart_sum.vertical) AS vertical,
  dmart_sum.is_b2b,
  dmart_sum.segment,
  dmart_sum.subsegment,
  SUM(dmart_sum.cust) AS cust,
  SUM(dmart_sum.ntv_m1_cust) AS ntv_m1_cust,
  SUM(dmart_sum.l30d_gmv_net_eur) AS l30d_gmv_net_eur,
  SUM(dmart_sum.l30d_incentive_eur) AS l30d_incentive_eur,
  SUM(dmart_sum.l30d_orders) AS l30d_orders,
  SUM(dmart_sum.grooming_cust) AS grooming_cust,
  SUM(dmart_sum.lapsing_revived_cust) AS lapsing_revived_cust,
  SUM(dmart_sum.lapsing_revived_inc_cust) AS lapsing_revived_inc_cust,
  SUM(dmart_sum.lapsing_revived_incentive_eur) AS lapsing_revived_incentive_eur,
  SUM(dmart_sum.lost_revived_cust) AS lost_revived_cust,
  SUM(dmart_sum.lost_revived_inc_cust) AS lost_revived_inc_cust,
  SUM(dmart_sum.lost_revived_incentive_eur) AS lost_revived_incentive_eur,
  SUM(dmart_sum.l30d_lost_gmv_net_eur) AS l30d_lost_gmv_net_eur,
  SUM(dmart_sum.inactive_revived_cust) AS inactive_revived_cust,
  SUM(dmart_sum.inactive_revived_inc_cust) AS inactive_revived_inc_cust,
  SUM(dmart_sum.inactive_revived_incentive_eur) AS inactive_revived_incentive_eur,
  SUM(dmart_sum.flgpu_positive_cust) AS flgpu_positive_cust
FROM dmart_sum
GROUP BY
  dmart_sum.report_date_local,
  global_entity_id,
  dmart_sum.vertical,
  dmart_sum.is_b2b,
  dmart_sum.segment,
  dmart_sum.subsegment
UNION ALL
SELECT
  shops_sum.report_date_local,
  shops_sum.global_entity_id,
  shops_sum.vertical,
  shops_sum.is_b2b,
  shops_sum.segment,
  shops_sum.subsegment,
  shops_sum.cust,
  shops_sum.ntv_m1_cust,
  shops_sum.l30d_gmv_net_eur,
  shops_sum.l30d_incentive_eur,
  shops_sum.l30d_orders,
  shops_sum.grooming_cust,
  shops_sum.lapsing_revived_cust,
  shops_sum.lapsing_revived_inc_cust,
  shops_sum.lapsing_revived_incentive_eur,
  shops_sum.lost_revived_cust,
  shops_sum.lost_revived_inc_cust,
  shops_sum.lost_revived_incentive_eur,
  shops_sum.l30d_lost_gmv_net_eur,
  shops_sum.inactive_revived_cust,
  shops_sum.inactive_revived_inc_cust,
  shops_sum.inactive_revived_incentive_eur,
  shops_sum.flgpu_positive_cust
FROM shops_sum
UNION ALL
SELECT
  shops_sum.report_date_local,
  "EU + TR" AS global_entity_id,
  shops_sum.vertical,
  shops_sum.is_b2b,
  shops_sum.segment,
  shops_sum.subsegment,
  SUM(shops_sum.cust) AS cust,
  SUM(shops_sum.ntv_m1_cust) AS ntv_m1_cust,
  SUM(shops_sum.l30d_gmv_net_eur) AS l30d_gmv_net_eur,
  SUM(shops_sum.l30d_incentive_eur) AS l30d_incentive_eur,
  SUM(shops_sum.l30d_orders) AS l30d_orders,
  SUM(shops_sum.grooming_cust) AS grooming_cust,
  SUM(shops_sum.lapsing_revived_cust) AS lapsing_revived_cust,
  SUM(shops_sum.lapsing_revived_inc_cust) AS lapsing_revived_inc_cust,
  SUM(shops_sum.lapsing_revived_incentive_eur) AS lapsing_revived_incentive_eur,
  SUM(shops_sum.lost_revived_cust) AS lost_revived_cust,
  SUM(shops_sum.lost_revived_inc_cust) AS lost_revived_inc_cust,
  SUM(shops_sum.lost_revived_incentive_eur) AS lost_revived_incentive_eur,
  SUM(shops_sum.l30d_lost_gmv_net_eur) AS l30d_lost_gmv_net_eur,
  SUM(shops_sum.inactive_revived_cust) AS inactive_revived_cust,
  SUM(shops_sum.inactive_revived_inc_cust) AS inactive_revived_inc_cust,
  SUM(shops_sum.inactive_revived_incentive_eur) AS inactive_revived_incentive_eur,
  SUM(shops_sum.flgpu_positive_cust) AS flgpu_positive_cust
FROM shops_sum
GROUP BY
  shops_sum.report_date_local,
  global_entity_id,
  shops_sum.vertical,
  shops_sum.is_b2b,
  shops_sum.segment,
  shops_sum.subsegment
)

SELECT 
  "APAC" AS region,
  IF(apac.global_entity_id = "APAC", "APAC", pandora_markets.country) AS country,
  apac.*
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qc_segmentation_acid_report` AS apac
LEFT JOIN pandora_markets
        ON apac.global_entity_id = pandora_markets.global_entity_id
WHERE report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)

UNION ALL

SELECT
  "EU + TR" AS region,
   IF(eu_final.global_entity_id = "EU + TR", "EU + TR", pandora_markets.country) AS country,
  eu_final.*
FROM eu_final
LEFT JOIN pandora_markets
        ON eu_final.global_entity_id = pandora_markets.global_entity_id
WHERE report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0h8gjka0h0adkm1bgg5co1ppnux8' name='Custom SQL Query' type='text'><![CDATA[WITH pandora_markets AS (
  SELECT
    region,
    global_entity_id,
    name AS country,
    timezone
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_countries`
  WHERE region IN ("Asia", "Europe", "MENA")
    AND name NOT IN ("Germany", "Denmark")
    AND global_entity_id NOT LIKE "ODR_%"
), 

flgpu_data AS (
  SELECT
    orders.global_entity_id,
    DATE_TRUNC(orders.created_date_local, MONTH) AS report_date_local,
    COALESCE(orders.central_analytical_customer_id, orders.customer_code) AS analytical_customer_id,
    SUM(flgp.fully_loaded_gross_profit_local) >> 0 AS is_flgpu_positive
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` AS orders
  LEFT JOIN `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_order_level_rev_cost` AS flgp
         ON orders.global_entity_id = flgp.global_entity_id
        AND orders.order_code = flgp.order_code
  WHERE DATE_TRUNC(orders.created_date_utc, MONTH) <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND DATE_TRUNC(orders.created_date_utc, MONTH) >>= "2023-01-01"
    AND orders.is_valid_order
  GROUP BY ALL
),

qc_seg_hist AS (
  SELECT
    report_date_local,
    global_entity_id,
    analytical_customer_id,
    segment,
    subsegment
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_qc_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2023-12-01"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, report_date_local) = 1

  UNION ALL

  SELECT
    report_date_local,
    global_entity_id,
    analytical_customer_id,
    segment,
    subsegment
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_qc_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2032-12-01"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, report_date_local) = 1
),

qc_ntv_hist AS (
  SELECT
    report_date_local,
    global_entity_id,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS ntv_m1_cust
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_qc_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2023-12-01"
    AND subsegment = "New To Vertical"
  GROUP BY ALL

  UNION ALL

  SELECT
    report_date_local,
    global_entity_id,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS ntv_m1_cust
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_qc_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2023-12-01"
    AND subsegment = "New To Vertical"
  GROUP BY ALL
),

qc_seg AS (
  SELECT
    seg.report_date_local,
    seg.global_entity_id,
    seg.vertical,
    FALSE AS is_b2b, ---* not present in EU datasource
    seg.analytical_customer_id,
    seg.segment,
    qc_seg_hist.segment AS segment_m1,
    seg.subsegment,
    qc_seg_hist.subsegment AS subsegment_m1,
    seg.l30d_gmv_net_eur,
    seg.l30d_incentive_cost_fp_marketing_eur,
    seg.l30d_orders,
    seg.l30d_incentivised_orders,
    seg.l30d_lost_gmv_net_eur,
    COALESCE(flgpu_data.is_flgpu_positive, FALSE) AS is_flgpu_positive
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_qc_segmentation_acid` AS seg
  LEFT JOIN qc_seg_hist
         ON seg.analytical_customer_id = qc_seg_hist.analytical_customer_id
        AND seg.report_date_local = DATE_ADD(qc_seg_hist.report_date_local, INTERVAL 1 MONTH)
  LEFT JOIN flgpu_data
         ON seg.analytical_customer_id = flgpu_data.analytical_customer_id
        AND seg.report_date_local = flgpu_data.report_date_local
  WHERE seg.report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND seg.report_date_local >>= "2023-01-01"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY seg.analytical_customer_id, seg.report_date_local) = 1

  UNION ALL

  SELECT
    seg.report_date_local,
    seg.global_entity_id,
    "Q-Commerce" AS vertical,
    FALSE AS is_b2b, ---* not present in EU datasource
    seg.analytical_customer_id,
    seg.segment,
    qc_seg_hist.segment AS segment_m1,
    seg.subsegment,
    qc_seg_hist.subsegment AS subsegment_m1,
    seg.l30d_gmv_net_eur,
    seg.l30d_incentive_cost_fp_marketing_eur,
    seg.l30d_orders,
    seg.l30d_incentivised_orders,
    seg.l30d_lost_gmv_net_eur,
    COALESCE(flgpu_data.is_flgpu_positive, FALSE) AS is_flgpu_positive
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_shops_segmentation_acid` AS seg
  LEFT JOIN qc_seg_hist
         ON seg.analytical_customer_id = qc_seg_hist.analytical_customer_id
        AND seg.report_date_local = DATE_ADD(qc_seg_hist.report_date_local, INTERVAL 1 MONTH)
  LEFT JOIN flgpu_data
         ON seg.analytical_customer_id = flgpu_data.analytical_customer_id
        AND seg.report_date_local = flgpu_data.report_date_local
  WHERE seg.report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND seg.report_date_local >>= "2023-01-01"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY seg.analytical_customer_id, seg.report_date_local) = 1
),

qc_seg_sum AS (
  SELECT
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS cust,
    SUM(l30d_gmv_net_eur) AS l30d_gmv_net_eur,
    SUM(l30d_incentive_cost_fp_marketing_eur) AS l30d_incentive_eur,
    SUM(l30d_orders) AS l30d_orders,
    SUM(l30d_lost_gmv_net_eur) AS l30d_lost_gmv_net_eur,
    COUNT(DISTINCT IF(subsegment = "Grooming", analytical_customer_id, NULL)) AS grooming_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing", analytical_customer_id, NULL)) AS lapsing_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lapsing_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lapsing_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost", analytical_customer_id, NULL)) AS lost_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lost_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lost_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC", analytical_customer_id, NULL)) AS inactive_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS inactive_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS inactive_revived_incentive_eur,
    COUNT(DISTINCT IF(is_flgpu_positive, analytical_customer_id, NULL)) AS flgpu_positive_cust
  FROM qc_seg
  GROUP BY
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment
),

dmart_seg_hist AS (
  SELECT
    report_date_local,
    global_entity_id,
    analytical_customer_id,
    segment,
    subsegment,
    ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, report_date_local) AS rank
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_dmart_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2022-12-01"
  QUALIFY rank = 1
),

dmart_ntv_hist AS (
  SELECT
    report_date_local,
    global_entity_id,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS ntv_m1_cust
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_dmart_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2022-12-01"
    AND subsegment = "New To Vertical"
  GROUP BY
    report_date_local,
    global_entity_id,
    subsegment
),

dmart_seg AS (
  SELECT
    seg.report_date_local,
    seg.global_entity_id,
    seg.vertical,
    FALSE AS is_b2b,
    seg.analytical_customer_id,
    seg.segment,
    dmart_seg_hist.segment AS segment_m1,
    seg.subsegment,
    dmart_seg_hist.subsegment AS subsegment_m1,
    seg.l30d_gmv_net_eur,
    seg.l30d_incentive_cost_fp_marketing_eur,
    seg.l30d_orders,
    seg.l30d_incentivised_orders,
    seg.l30d_lost_gmv_net_eur,
    COALESCE(flgpu_data.is_flgpu_positive, FALSE) AS is_flgpu_positive,
    ROW_NUMBER() OVER (PARTITION BY seg.analytical_customer_id, seg.report_date_local) AS rank
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_dmart_segmentation_acid` AS seg
  LEFT JOIN dmart_seg_hist
         ON seg.analytical_customer_id = dmart_seg_hist.analytical_customer_id
        AND seg.report_date_local = DATE_ADD(dmart_seg_hist.report_date_local, INTERVAL 1 MONTH)
  LEFT JOIN flgpu_data
         ON seg.analytical_customer_id = flgpu_data.analytical_customer_id
        AND seg.report_date_local = flgpu_data.report_date_local
  WHERE seg.report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND seg.report_date_local >>= "2023-01-01"
  QUALIFY rank = 1
),

dmart_seg_sum AS (
  SELECT
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS cust,
    SUM(l30d_gmv_net_eur) AS l30d_gmv_net_eur,
    SUM(l30d_incentive_cost_fp_marketing_eur) AS l30d_incentive_eur,
    SUM(l30d_orders) AS l30d_orders,
    SUM(l30d_lost_gmv_net_eur) AS l30d_lost_gmv_net_eur,
    COUNT(DISTINCT IF(subsegment = "Grooming", analytical_customer_id, NULL)) AS grooming_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing", analytical_customer_id, NULL)) AS lapsing_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lapsing_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lapsing_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost", analytical_customer_id, NULL)) AS lost_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lost_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lost_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC", analytical_customer_id, NULL)) AS inactive_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS inactive_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS inactive_revived_incentive_eur,
    COUNT(DISTINCT IF(is_flgpu_positive, analytical_customer_id, NULL)) AS flgpu_positive_cust
  FROM dmart_seg
  GROUP BY
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment
),

shops_seg_hist AS (
  SELECT
    report_date_local,
    global_entity_id,
    analytical_customer_id,
    segment,
    subsegment,
    ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, report_date_local) AS rank
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_shops_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2022-12-01"
  QUALIFY rank = 1
),

shops_ntv_hist AS (
  SELECT
    report_date_local,
    global_entity_id,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS ntv_m1_cust
