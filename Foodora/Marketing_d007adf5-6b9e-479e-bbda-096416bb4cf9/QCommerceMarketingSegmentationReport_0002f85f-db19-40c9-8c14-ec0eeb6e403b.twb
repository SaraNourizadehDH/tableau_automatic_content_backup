    AND channel_type IN ("EMAIL", "IAM", "PUSH")
    AND data_source = "CANVAS COMMS"
    AND is_adhoc_replacement
    AND global_entity_id != "Prospect NA"
),

handbook_data AS (
  SELECT
    DATE_TRUNC(partition_date_local, MONTH) AS report_date_local,
    global_entity_id,
    "IAM" AS channel_type,
    "HANDBOOK" AS data_source,
    IF(UPPER(campaign_name) LIKE "%DMA%" OR UPPER(campaign_name) LIKE "%QUI%" OR UPPER(campaign_name) LIKE "%LOC%", TRUE, FALSE) AS is_qc,
    handbook_name AS canvas_name,
    campaign_name,
