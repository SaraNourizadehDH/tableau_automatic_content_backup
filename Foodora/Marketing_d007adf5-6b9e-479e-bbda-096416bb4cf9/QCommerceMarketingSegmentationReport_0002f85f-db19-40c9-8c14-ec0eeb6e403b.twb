    ROW_NUMBER() OVER (PARTITION BY seg.analytical_customer_id, seg.report_date_local) AS rank
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_mkt_shops_segmentation_acid` AS seg
  LEFT JOIN shops_seg_hist
         ON seg.analytical_customer_id = shops_seg_hist.analytical_customer_id
        AND seg.report_date_local = DATE_ADD(shops_seg_hist.report_date_local, INTERVAL 1 MONTH)
  LEFT JOIN flgpu_data
         ON seg.analytical_customer_id = flgpu_data.analytical_customer_id
        AND seg.report_date_local = flgpu_data.report_date_local
  WHERE seg.report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 0 MONTH), MONTH)
    AND seg.report_date_local >>= "2023-01-01"
  QUALIFY rank = 1
),

shops_seg_sum AS (
  SELECT
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment,
    COUNT(DISTINCT analytical_customer_id) AS cust,
    SUM(l30d_gmv_net_eur) AS l30d_gmv_net_eur,
