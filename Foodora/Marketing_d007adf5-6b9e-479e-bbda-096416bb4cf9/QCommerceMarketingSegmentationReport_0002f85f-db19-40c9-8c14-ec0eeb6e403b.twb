      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0D1017CE1AD94C5BB54A428465199D80'>
            <properties context=''>
              <relation connection='bigquery.031ew9i12yrh4y13nerqv0ka0bn4' name='Custom SQL Query' type='text'><![CDATA[WITH pandora_markets AS (
  SELECT
    region,
    global_entity_id,
    name AS country
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_countries`
  WHERE region IN ("Asia", "Europe", "MENA")
  AND name NOT IN ("Germany", "Denmark")
  AND global_entity_id NOT LIKE "ODR_%"
),

---- # NTP / NTV AT uuid level
orders_raw AS (
  SELECT
    pandora_markets.region,
    orders.global_entity_id,
    pandora_markets.country,
    orders.pd_customer_uuid,
    orders.order_uid,
    DATETIME(orders.created_at_utc) AS placed_at_utc,
    orders.created_date_local,
    orders.business_type
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders
  INNER JOIN pandora_markets
          ON orders.global_entity_id = pandora_markets.global_entity_id
  WHERE orders.is_successful
    AND orders.created_date_local BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE - 1, INTERVAL 1 YEAR), YEAR) AND DATE_TRUNC(CURRENT_DATE - 1, MONTH)
),

orders_daily AS (
  SELECT
    orders.region,
    orders.global_entity_id,
    orders.country,
    orders.pd_customer_uuid,
    orders.placed_at_utc,
    orders.created_date_local,
    COUNT(DISTINCT orders.order_uid) AS qc_orders
  FROM orders_raw AS orders
  WHERE orders.business_type IN ("dmart", "shops")
  GROUP BY ALL
),

user_tag_daily AS (
  SELECT
    IF(pandora_markets.region = "Asia", "APAC", "EU + TR") AS region,
    tag.global_entity_id,
    tag.country,
    tag.pd_customer_uuid,
    tag.customer_code,
    tag.date_local,
    tag.is_acquisition,
    tag.is_ntp_qc,
    tag.is_ntv_qc
  FROM `fulfillment-dwh-production.pandata_report.marketing__qcommerce_uuid_user_status_daily` AS tag
  INNER JOIN pandora_markets
          ON tag.global_entity_id = pandora_markets.global_entity_id
),

user_tag_monthly AS (
  SELECT
    DATE_TRUNC(date_local, MONTH) AS month,
    region,
    global_entity_id,
    country,
    customer_code,
    MAX(is_ntp_qc) AS is_ntp_qc,
    IF((MAX(is_ntv_qc) AND MAX(is_acquisition)), FALSE, MAX(is_ntv_qc)) AS is_ntv_qc
  FROM user_tag_daily
  GROUP BY ALL
),

ntp_ntv_monthly AS (
  SELECT
    month,
    region,
    global_entity_id,
    COUNT(DISTINCT IF(is_ntp_qc, customer_code, NULL)) AS ntp_qc,
    COUNT(DISTINCT IF(is_ntv_qc, customer_code, NULL)) AS ntv_qc,
    COUNT(DISTINCT customer_code) AS all_users
  FROM user_tag_monthly
  GROUP BY ALL

  UNION ALL
  
  SELECT
    month,
    region,
    region AS global_entity_id,
    COUNT(DISTINCT IF(is_ntp_qc, customer_code, NULL)) AS ntp_qc,
    COUNT(DISTINCT IF(is_ntv_qc, customer_code, NULL)) AS ntv_qc,
    COUNT(DISTINCT customer_code) AS all_users
  FROM user_tag_monthly
  GROUP BY ALL
),

hva_spend_monthly AS (
  SELECT
    PARSE_DATE('%Y-%m', year_month) AS month,
    global_entity_id,
    SUM(IF(hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva"), 
        (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS hva_spend_qc,
    SUM(IF(hva_subcategory = "Non HVA", (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS non_hva_spend_qc,
    SUM(COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)) AS marketing_spend_qc,
    SUM(IF(hva_subcategory = "QC Trial", acid, 0)) AS qc_trials_acid
  FROM `dhh---analytics-eu.bl_europe.bima_hva_orders_combined_costbreakdown_fd`
  WHERE vertical_per_redemption IN ("Dmart", "Shops")
    -- AND hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva")
    AND cost_category = "Incentive CARC"
  GROUP BY ALL

  UNION ALL

  SELECT
    PARSE_DATE('%Y-%m', year_month) AS month,
    "EU + TR" AS global_entity_id,
    SUM(IF(hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva"), 
        (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS hva_spend_qc,
    SUM(IF(hva_subcategory = "Non HVA", (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS non_hva_spend_qc,
    SUM(COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)) AS marketing_spend_qc,
    SUM(IF(hva_subcategory = "QC Trial", acid, 0)) AS qc_trials_acid
  FROM `dhh---analytics-eu.bl_europe.bima_hva_orders_combined_costbreakdown_fd`
  WHERE vertical_per_redemption IN ("Dmart", "Shops")
    -- AND hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva")
    AND cost_category = "Incentive CARC"
  GROUP BY ALL

  UNION ALL

  SELECT
    PARSE_DATE('%Y-%m', year_month) AS month,
    global_entity_id,
    SUM(IF(hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva"), 
        (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS hva_spend_qc,
    SUM(IF(hva_subcategory = "Non HVA", (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS non_hva_spend_qc,
    SUM(COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)) AS marketing_spend_qc,
    SUM(IF(hva_subcategory = "QC Trial", acid, 0)) AS qc_trials_acid
  FROM `dhh---analytics-apac.pandata_ap_mktg.bima_hva_orders_combined_costbreakdown_v2`
  WHERE vertical_per_redemption IN ("Dmart", "Shops")
    -- AND hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva")
    AND cost_category = "Incentive CARC"
  GROUP BY ALL

  UNION ALL

  SELECT
    PARSE_DATE('%Y-%m', year_month) AS month,
    "APAC" AS global_entity_id,
    SUM(IF(hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva"), 
        (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS hva_spend_qc,
    SUM(IF(hva_subcategory = "Non HVA", (COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)), 0)) AS non_hva_spend_qc,
    SUM(COALESCE(total_fdnc_cost_eur, 0) + COALESCE(total_fd_cost_eur, 0) + COALESCE(marketing_cost_eur, 0)) AS marketing_spend_qc,
    SUM(IF(hva_subcategory = "QC Trial", acid, 0)) AS qc_trials_acid
  FROM `dhh---analytics-apac.pandata_ap_mktg.bima_hva_orders_combined_costbreakdown_v2`
  WHERE vertical_per_redemption IN ("Dmart", "Shops")
    -- AND hva_subcategory IN ("QC Early", "QC Trial", "qc_reac_30d_hva", "dmart_hva", "local_store_hva")
    AND cost_category = "Incentive CARC"
  GROUP BY ALL
),

mau AS (
  SELECT
    report_date_local,
    "APAC" AS region,
    global_entity_id,
    country,
    num_of_sh_customers_in_delivery_area_cnty AS num_of_sh_customers_in_delivery_area_cnty,
    num_of_customers_in_delivery_area_cnty AS num_of_customers_in_delivery_area_cnty
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qcommerce_okr_dashboard`
  WHERE report_date_local BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE - 1, INTERVAL 1 YEAR), YEAR) AND DATE_TRUNC(CURRENT_DATE - 1, MONTH)
    AND date_type = "Month"
    AND vertical = "Q-Commerce"
  GROUP BY ALL

  UNION ALL

 SELECT
  DATE_TRUNC(orders.created_date_local, MONTH) AS report_date_local,
  "EU + TR" AS region,
  orders.global_entity_id,
  orders.country,
  COUNT(DISTINCT IF(orders.business_type IN ("dmart", "shops"), orders.pd_customer_uuid, NULL)) AS num_of_sh_customers_in_delivery_area_cnty,
  COUNT(DISTINCT orders.pd_customer_uuid) AS num_of_customers_in_delivery_area_cnty
 FROM orders_raw AS orders
 WHERE DATE_TRUNC(orders.created_date_local, MONTH) BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE - 1, INTERVAL 1 YEAR), YEAR) AND DATE_TRUNC(CURRENT_DATE - 1, MONTH)
   AND orders.region IN ("Europe", "MENA")
 GROUP BY ALL

 UNION ALL

 SELECT
  DATE_TRUNC(orders.created_date_local, MONTH) AS report_date_local,
  "EU + TR" AS region,
  "EU + TR" AS global_entity_id,
  "EU + TR" AS country,
  COUNT(DISTINCT IF(orders.business_type IN ("dmart", "shops"), orders.pd_customer_uuid, NULL)) AS num_of_sh_customers_in_delivery_area_cnty,
  COUNT(DISTINCT orders.pd_customer_uuid) AS num_of_customers_in_delivery_area_cnty
 FROM orders_raw AS orders
 WHERE DATE_TRUNC(orders.created_date_local, MONTH) BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE - 1, INTERVAL 1 YEAR), YEAR) AND DATE_TRUNC(CURRENT_DATE - 1, MONTH)
   AND orders.region IN ("Europe", "MENA")
 GROUP BY ALL
),

sessions AS (
    SELECT
    IF(pandora_markets.region = "Asia", "APAC", "EU + TR") AS region,
    DATE_TRUNC(sessions_daily.date_utc, MONTH) AS month,
    pandora_markets.global_entity_id,
    SUM(sessions_daily.sessions) AS platform_sessions,
    SUM(sessions_daily.gc_seen_hybrid) AS sessions
   FROM `fulfillment-dwh-production.pandata_report.product__groceries_daily_agg_unified` AS sessions_daily 
   INNER JOIN pandora_markets
           ON sessions_daily.country = pandora_markets.country
   WHERE sessions_daily.date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 8 MONTH), MONTH)
   GROUP BY ALL

   UNION ALL
   
   SELECT
    IF(pandora_markets.region = "Asia", "APAC", "EU + TR") AS region,
    DATE_TRUNC(sessions_daily.date_utc, MONTH) AS month,
    IF(pandora_markets.region = "Asia", "APAC", "EU + TR") AS global_entity_id,
    SUM(sessions_daily.sessions) AS platform_sessions,
    SUM(sessions_daily.gc_seen_hybrid) AS sessions
   FROM `fulfillment-dwh-production.pandata_report.product__groceries_daily_agg_unified` AS sessions_daily 
   INNER JOIN pandora_markets
            ON sessions_daily.country = pandora_markets.country
   WHERE sessions_daily.date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 8 MONTH), MONTH)
   GROUP BY ALL
)

SELECT
  mau.report_date_local,
  mau.region,
  mau.global_entity_id,
  mau.country,
  mau.num_of_sh_customers_in_delivery_area_cnty,
  mau.num_of_customers_in_delivery_area_cnty,
  sessions.sessions,
  sessions.platform_sessions,
  ntp_ntv_monthly.ntp_qc,
  ntp_ntv_monthly.ntv_qc,
  hva_spend_monthly.qc_trials_acid,
  hva_spend_monthly.hva_spend_qc,
  hva_spend_monthly.non_hva_spend_qc,
  hva_spend_monthly.marketing_spend_qc
FROM mau
LEFT JOIN ntp_ntv_monthly
       ON mau.global_entity_id = ntp_ntv_monthly.global_entity_id
      AND mau.report_date_local = ntp_ntv_monthly.month
LEFT JOIN hva_spend_monthly
       ON mau.global_entity_id = hva_spend_monthly.global_entity_id
      AND mau.report_date_local = hva_spend_monthly.month
LEFT JOIN sessions
       ON mau.global_entity_id = sessions.global_entity_id
      AND mau.report_date_local = sessions.month
WHERE mau.report_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
