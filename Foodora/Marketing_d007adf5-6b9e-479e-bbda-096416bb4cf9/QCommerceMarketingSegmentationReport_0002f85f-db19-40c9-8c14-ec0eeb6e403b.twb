              <calculation class='tableau' formula='IF SUM([cust]) / TOTAL(SUM([cust])) &lt; .1 THEN&#10;&#10;(SUM([cust]) / TOTAL(SUM([cust]))) + .06 ELSE&#10;&#10;SUM([cust]) / TOTAL(SUM([cust]))&#10;&#10;END'>
