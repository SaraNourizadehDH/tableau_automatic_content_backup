              <calculation class='tableau' formula='//([NTV Cust] - LOOKUP(ZN([NTV Cust]), 1)) / LOOKUP(ZN([NTV Cust]),1)&#10;(ZN([Calculation_4097923852270780419]) / LOOKUP(ZN([Calculation_4097923852270780419]), -1)) - 1'>
