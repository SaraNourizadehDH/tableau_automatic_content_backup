      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cust]) / TOTAL(SUM([cust]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='QC Segment' datatype='string' name='[Calculation_2629046707071152128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [subsegment] IN (&quot;New To Vertical&quot;, &quot;Grooming&quot;, &quot;Lapsing Grooming&quot;) THEN &quot;NC&quot;&#10;ELSEIF [subsegment] = &quot;Weekly Shoppers&quot; THEN &quot;Weekly Shoppers&quot;&#10;ELSEIF [subsegment] = &quot;Monthly Shoppers&quot; THEN &quot;Monthly Shoppers&quot;&#10;ELSEIF [subsegment] = &quot;Irregular Shoppers&quot; THEN &quot;Irregular Shoppers&quot;&#10;END' />
      </column>
      <column caption='Customers' datatype='string' name='[Calculation_2629046707091492871]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([cust]) &gt;= 1000000000 THEN STR(ROUND(SUM([cust]) / 1000000000, 1)) + &quot;B&quot;&#10;ELSEIF SUM([cust]) &gt;= 1000000 THEN STR(ROUND(SUM([cust]) / 1000000, 1)) + &quot;M&quot;&#10;ELSEIF SUM([cust]) &gt;= 1000 THEN STR(ROUND(SUM([cust]) / 1000, 1)) + &quot;K&quot;&#10;ELSE STR(ROUND(SUM([cust]), 0))&#10;END' />
      </column>
      <column caption='% of Platform Sessions' datatype='real' name='[Calculation_385128197722411012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [report_date_local], [global_entity_id], [vertical] : MIN([sessions]) } / { FIXED [report_date_local], [global_entity_id], [vertical] : MIN([platform_sessions]) }' />
      </column>
      <column caption='MAU Title' datatype='string' name='[Calculation_3931994339898220545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;MAU&quot;' />
      </column>
      <column caption='Set Bar Height' datatype='real' name='[Calculation_4754112368301637638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([cust]) / TOTAL(SUM([cust])) &lt; .1 THEN&#10;&#10;(SUM([cust]) / TOTAL(SUM([cust]))) + .06 ELSE&#10;&#10;SUM([cust]) / TOTAL(SUM([cust]))&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Filter' datatype='date' name='[Date (copy)_4754112368283922433]' role='dimension' type='ordinal'>
