            <column-instance column='[Date (copy)_4754112368283922433]' derivation='None' name='[none:Date (copy)_4754112368283922433:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Prev Mth Subsegment (copy)_3931994346969972738]' derivation='None' name='[none:Prev Mth Subsegment (copy)_3931994346969972738:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date_local]' derivation='None' name='[none:report_date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[subsegment]' derivation='None' name='[none:subsegment:nk]' pivot='key' type='nominal' />
            <column-instance column='[subsegment_m1]' derivation='None' name='[none:subsegment_m1:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column-instance column='[cust]' derivation='Sum' name='[pcto:sum:cust:qk:9]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Date' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column caption='Segment' datatype='string' name='[subsegment]' role='dimension' type='nominal' />
            <column datatype='string' name='[subsegment_m1]' role='dimension' type='nominal' />
            <column-instance column='[cust]' derivation='Sum' name='[sum:cust:qk]' pivot='key' type='quantitative' />
