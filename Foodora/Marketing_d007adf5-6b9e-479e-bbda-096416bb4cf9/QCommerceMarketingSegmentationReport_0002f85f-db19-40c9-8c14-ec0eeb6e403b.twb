      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_558B8B639A634FE7914850AC6AF2918F'>
            <properties context=''>
              <relation connection='bigquery.0w54x7c012heph14o84wd14lz14d' name='Custom SQL Query' type='text'><![CDATA[WITH adhoc_data AS (
  SELECT
    DATE_TRUNC(period, MONTH) AS report_date_local,
    global_entity_id,
    channel_type,
    "ADHOC" AS data_source,
    IF(UPPER(campaign_name) LIKE "%DMA%" OR UPPER(campaign_name) LIKE "%QUI%" OR UPPER(campaign_name) LIKE "%LOC%"
       OR UPPER(canvas_name) LIKE "%DMA%" OR UPPER(canvas_name) LIKE "%QUI%" OR UPPER(canvas_name) LIKE "%LOC%", TRUE, FALSE) AS is_qc,
    canvas_name,
    campaign_name,
    CASE
      WHEN channel_type = "EMAIL" THEN delivered
      WHEN channel_type = "PUSH" THEN sent - bounce
      ELSE NULL
    END AS delivery,
    IF(channel_type IN ("EMAIL", "IAM"), clicked, NULL) AS clicks,
    click_orders AS clicks_orders,
    IF(channel_type IN ("EMAIL", "PUSH"), opened, NULL) AS open,
    open_orders,
    IF(channel_type = "IAM", impression, NULL) AS impressions_iam
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_all_comms_performance`
  WHERE period >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE - 1, YEAR), INTERVAL 1 YEAR) 
    AND period << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
    AND channel_type IN ("EMAIL", "IAM", "PUSH")
    AND data_source IN ("AUTO CAMPAIGN PERFORMANCE", "CAMPAIGN PERFORMANCE")
    AND global_entity_id != "Prospect NA"
),

auto_data AS (
  SELECT
    DATE_TRUNC(period, MONTH) AS report_date_local,
    global_entity_id,
    channel_type,
    "AUTO" AS data_source,
    IF(UPPER(campaign_name) LIKE "%DMA%" OR UPPER(campaign_name) LIKE "%QUI%" OR UPPER(campaign_name) LIKE "%LOC%"
       OR UPPER(canvas_name) LIKE "%DMA%" OR UPPER(canvas_name) LIKE "%QUI%" OR UPPER(canvas_name) LIKE "%LOC%", TRUE, FALSE) AS is_qc,
    canvas_name,
    campaign_name,
    CASE
      WHEN channel_type = "EMAIL" THEN delivered
      WHEN channel_type = "PUSH" THEN sent - bounce
      ELSE NULL
    END AS delivery,
    IF(channel_type IN ("EMAIL", "IAM"), clicked, NULL) AS clicks,
    click_orders AS clicks_orders,
    IF(channel_type IN ("EMAIL", "PUSH"), opened, NULL) AS open,
    open_orders,
    IF(channel_type = "IAM", impression, NULL) AS impressions_iam
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_all_comms_performance`
  WHERE period >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE - 1, YEAR), INTERVAL 1 YEAR) 
    AND period << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
    AND channel_type IN ("EMAIL", "IAM", "PUSH")
    AND data_source = "CANVAS COMMS"
    AND is_adhoc_replacement
    AND global_entity_id != "Prospect NA"
),

handbook_data AS (
  SELECT
    DATE_TRUNC(partition_date_local, MONTH) AS report_date_local,
    global_entity_id,
    "IAM" AS channel_type,
    "HANDBOOK" AS data_source,
    IF(UPPER(campaign_name) LIKE "%DMA%" OR UPPER(campaign_name) LIKE "%QUI%" OR UPPER(campaign_name) LIKE "%LOC%", TRUE, FALSE) AS is_qc,
    handbook_name AS canvas_name,
    campaign_name,
    NULL AS delivery,
    clicked AS clicks,
    total_click_orders_treatment AS clicks_orders,
    NULL AS open,
    NULL AS open_orders,
    impression AS impressions_iam
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_iam_handbook_performance`
  WHERE partition_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE - 1, YEAR), INTERVAL 1 YEAR)
    AND partition_date_local << DATE_TRUNC(CURRENT_DATE - 1, MONTH)
)

SELECT
  adhoc_data.report_date_local,
  countries.name AS country,
  adhoc_data.global_entity_id,
  "Q-Commerce" AS vertical,
  adhoc_data.channel_type,
  adhoc_data.data_source,
  SUM(adhoc_data.delivery) AS delivery,
  SUM(adhoc_data.clicks) AS clicks,
  SUM(IF(adhoc_data.channel_type = "IAM", adhoc_data.impressions_iam, adhoc_data.delivery)) AS clicks_denom,
  SUM(adhoc_data.clicks_orders) AS clicks_orders,
  SUM(adhoc_data.open) AS open,
  SUM(adhoc_data.open_orders) AS open_orders,
  SUM(adhoc_data.impressions_iam) AS impressions_iam
FROM adhoc_data
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
        ON adhoc_data.global_entity_id = countries.global_entity_id
WHERE adhoc_data.is_qc
GROUP BY
  adhoc_data.report_date_local,
  country,
  adhoc_data.global_entity_id,
  vertical,
  adhoc_data.channel_type,
  adhoc_data.data_source
UNION ALL
SELECT
  report_date_local,
  "APAC" AS country,
  "APAC" AS global_entity_id,
  "Q-Commerce" AS vertical,
  channel_type,
  data_source,
  SUM(delivery) AS delivery,
  SUM(clicks) AS clicks,
  SUM(IF(channel_type = "IAM", impressions_iam, delivery)) AS clicks_denom,
  SUM(clicks_orders) AS clicks_orders,
  SUM(open) AS open,
  SUM(open_orders) AS open_orders,
  SUM(impressions_iam) AS impressions_iam
FROM adhoc_data
WHERE is_qc
GROUP BY
  report_date_local,
  country,
  global_entity_id,
  vertical,
  channel_type,
  data_source
UNION ALL
SELECT
  adhoc_data.report_date_local,
  countries.name AS country,
  adhoc_data.global_entity_id,
  "Platform" AS vertical,
  adhoc_data.channel_type,
  adhoc_data.data_source,
  SUM(adhoc_data.delivery) AS delivery,
  SUM(adhoc_data.clicks) AS clicks,
  SUM(IF(adhoc_data.channel_type = "IAM", adhoc_data.impressions_iam, adhoc_data.delivery)) AS clicks_denom,
  SUM(adhoc_data.clicks_orders) AS clicks_orders,
  SUM(adhoc_data.open) AS open,
  SUM(adhoc_data.open_orders) AS open_orders,
  SUM(adhoc_data.impressions_iam) AS impressions_iam
FROM adhoc_data
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
        ON adhoc_data.global_entity_id = countries.global_entity_id
GROUP BY
  adhoc_data.report_date_local,
  country,
  adhoc_data.global_entity_id,
  vertical,
  adhoc_data.channel_type,
  adhoc_data.data_source
UNION ALL
SELECT
