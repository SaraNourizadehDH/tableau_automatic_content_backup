    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lapsing_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lapsing" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lapsing_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost", analytical_customer_id, NULL)) AS lost_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS lost_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Lost" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS lost_revived_incentive_eur,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC", analytical_customer_id, NULL)) AS inactive_revived_cust,
    COUNT(DISTINCT IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, analytical_customer_id, NULL)) AS inactive_revived_inc_cust,
    SUM(IF(segment = "Existing Customers" AND subsegment_m1 = "Inactive QC" AND l30d_incentivised_orders >> 0, l30d_incentive_cost_fp_marketing_eur, 0)) AS inactive_revived_incentive_eur,
    COUNT(DISTINCT IF(is_flgpu_positive, analytical_customer_id, NULL)) AS flgpu_positive_cust
  FROM shops_seg
  GROUP BY
    report_date_local,
    global_entity_id,
    vertical,
    is_b2b,
    segment,
    subsegment
),

qc_sum AS (
  SELECT
    qc_seg_sum.report_date_local,
    qc_seg_sum.global_entity_id,
    qc_seg_sum.vertical,
    qc_seg_sum.is_b2b,
    qc_seg_sum.segment,
    qc_seg_sum.subsegment,
