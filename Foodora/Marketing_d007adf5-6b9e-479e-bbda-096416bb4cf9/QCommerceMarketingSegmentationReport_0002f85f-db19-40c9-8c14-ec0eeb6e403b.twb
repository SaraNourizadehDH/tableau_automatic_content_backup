        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.16cg2sd0axton71d2zjiq1dmvtq9' name='Custom SQL Query' type='text'><![CDATA[WITH pandora_markets AS (
  SELECT
    region,
    global_entity_id,
    name AS country
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_countries`
