            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:active_users:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:fp_deal_cost:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:fp_df_cost:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:fp_funded_voucher:qk]&quot;' />
