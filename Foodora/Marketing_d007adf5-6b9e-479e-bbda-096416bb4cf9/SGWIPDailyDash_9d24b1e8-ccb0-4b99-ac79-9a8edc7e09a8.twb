  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_zonal_resto_traffic`
  GROUP BY 1,2,3,4,5
),

vertical_session AS (
  -- by vertical, time, ALL ZONE
  SELECT DISTINCT 'Food OD' AS vertical
      , report_date
      , CASE WHEN hour_ BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
            WHEN hour_ BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
            WHEN hour_ BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
            WHEN hour_ BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
            WHEN hour_ BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , FALSE AS is_dfi
      , 'All Zone' AS zone_name
      , SUM(delivery_sessions) AS session_
      , SUM(delivery_transactions) AS trx
  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_restaurant_daily_traffic_dashboard` 
  WHERE report_date >>= DATE("2023-12-01")
    AND EXTRACT(YEAR FROM report_date) >>= 2024
    AND NOT is_ghost_session
  GROUP BY 1,2,3,4,5

  UNION DISTINCT 
  
  -- by vertical, time, ALL zone
  SELECT DISTINCT 'PU' AS vertical
      , report_date
      , CASE WHEN hour_ BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
            WHEN hour_ BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
            WHEN hour_ BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
            WHEN hour_ BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
            WHEN hour_ BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , FALSE AS is_dfi
      , 'All Zone' AS zone_name
      , SUM(pu_sessions) AS session_
      , SUM(pu_transactions) AS trx
  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_restaurant_daily_traffic_dashboard` 
  WHERE report_date >>= DATE("2023-12-01")
    AND EXTRACT(YEAR FROM report_date) >>= 2024
    AND NOT is_ghost_session
  GROUP BY 1,2,3,4,5

  UNION DISTINCT 

  -- by ALL vertical, time, ALL zone
  SELECT DISTINCT 'Platform' AS vertical
      , report_date
      , CASE WHEN hour_ BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN hour_ BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN hour_ BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN hour_ BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
            WHEN hour_ BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , TRUE AS is_dfi
      , 'All Zone' AS zone_name
      , SUM(sessions) AS session_
      , SUM(transactions) AS trx
  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_restaurant_daily_traffic_dashboard` 
  WHERE report_date >>= DATE("2023-12-01")
    AND EXTRACT(YEAR FROM report_date) >>= 2024
    AND NOT is_ghost_session
  GROUP BY 1,2,3,4,5

  UNION DISTINCT 

  SELECT DISTINCT 'QC' AS vertical
      , report_date
      , CASE WHEN report_hour BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN report_hour BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN report_hour BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN report_hour BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN report_hour BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , TRUE AS is_dfi
      , 'All Zone' AS zone_name
      , SUM(gc_sessions) AS session_
      , SUM(gc_transactions) AS trx
  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_qcommerce_daily_traffic_dashboard` 
  WHERE report_date >>= DATE("2023-12-01")
    AND EXTRACT(YEAR FROM report_date) >>= 2024
    AND NOT is_ghost_session
  GROUP BY 1,2,3,4,5

  UNION DISTINCT 

  SELECT DISTINCT 'QC Mart' AS vertical
      , report_date
      , CASE WHEN report_hour BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN report_hour BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN report_hour BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN report_hour BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN report_hour BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , FALSE AS is_dfi
      , 'All Zone' AS zone_name
      , SUM(ds_sessions) AS session_
      , SUM(sum_ds_intent_cvr) AS trx
  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_qcommerce_daily_traffic_dashboard` 
  WHERE report_date >>= DATE("2023-12-01")
    AND EXTRACT(YEAR FROM report_date) >>= 2024
    AND NOT is_ghost_session
  GROUP BY 1,2,3,4,5

  UNION DISTINCT 

  SELECT DISTINCT 'Shops' AS vertical
      , report_date
      , CASE WHEN report_hour BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN report_hour BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN report_hour BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN report_hour BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN report_hour BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , FALSE AS is_dfi
      , 'All Zone' AS zone_name
      , SUM(sh_wo_dfi_sessions) AS session_
      , SUM(sum_shops_wo_dfi_intent_cvr) AS trx
  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_qcommerce_daily_traffic_dashboard` 
  WHERE report_date >>= DATE("2023-12-01")
    AND EXTRACT(YEAR FROM report_date) >>= 2024
  AND NOT is_ghost_session
  GROUP BY 1,2,3,4,5

  UNION DISTINCT 

  SELECT DISTINCT 'Shops' AS vertical
      , report_date
      , CASE WHEN report_hour BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN report_hour BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN report_hour BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN report_hour BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN report_hour BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , TRUE AS is_dfi
      , 'All Zone' AS zone_name
      , SUM(sh_sessions) AS session_
      , SUM(sum_shops_intent_cvr) AS trx
  FROM `fulfillment-dwh-production.pandata_report.country_SG_perseus_qcommerce_daily_traffic_dashboard` 
  WHERE report_date >>= DATE("2023-12-01")
    AND EXTRACT(YEAR FROM report_date) >>= 2024
    AND NOT is_ghost_session
  GROUP BY 1,2,3,4,5

  UNION DISTINCT 

  SELECT * 
  FROM resto_zone_time
),

traffic_data_agg AS (
  SELECT *
  FROM vertical_session 

  UNION DISTINCT 

  SELECT vertical
      , report_date
      , 'All Time' AS time_of_day
      , is_dfi 
      , zone_name 
      , SUM(session_) AS session_
      , SUM(trx) AS trx
  FROM vertical_session
  GROUP BY 1,2,3,4,5
),

traffic_agg AS (
  SELECT d.vertical
      , d.report_date AS ordered_at_date_local
      , d.time_of_day 
      , d.zone_name
      , d.is_dfi
      , d.session_ 
      , d.trx
      , u.user_w_session
  FROM traffic_data_agg d
  LEFT JOIN user_with_session_agg u 
    ON d.vertical = u.vertical
    AND d.report_date = u.ordered_at_date_local
    AND d.time_of_day = u.time_of_day
    AND d.is_dfi = u.is_dfi
    AND d.zone_name = u.zone_name
),
*/
--- FAILED, SHRINK, SURGE, DT ---
shrink_data AS (
  SELECT DISTINCT order_code
       , action 
       , event_title
  FROM `fulfillment-dwh-production.curated_data_shared.orders_and_das_events` das, UNNEST(orders) AS o
  WHERE created_date >>= DATE('2024-01-01')
    AND das.action <<>> 'delay'
    AND das.country_code = 'sg'
    AND action IS NOT NULL
),

failed_order_details AS (
  SELECT DISTINCT o.ordered_at_date_local
      , CASE WHEN o.is_pickup AND o.business_type_apac <<>> 'darkstores' THEN 'PU'
              WHEN o.business_type_apac = 'darkstores' THEN 'QC Mart'
              WHEN o.business_type_apac IN ('restaurant', 'restaurants', 'street_food') AND o.is_own_delivery THEN 'Food OD'
              WHEN o.business_type_apac IN ('restaurant', 'restaurants', 'street_food') AND NOT o.is_own_delivery THEN 'Food VD'
          ELSE 'Shops' END AS vertical
      , COALESCE(v.chain_code IN ('ce2ua', 'cx9nw'), FALSE) AS is_dfi -- just make this as separate filter
      , CASE WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , COALESCE(z.zone_name, "Unavailable") AS zone_name
      , o.uuid
      , CASE WHEN o.is_failed_order THEN 1 ELSE 0 END AS is_failed
      , l.actual_delivery_time_in_minutes
      , o.is_valid_order
      , l.is_preorder

      , CASE WHEN surge.is_surged AND COALESCE(mapped_dps_df_component.dps_surge_fee_local,0) >> 0 THEN TRUE ELSE FALSE END AS is_surged
      , CASE WHEN shrink.action = 'shrink' THEN TRUE ELSE FALSE END AS is_shrink
      , CASE WHEN o.delivery_fee_local = 0 THEN TRUE ELSE FALSE END AS is_fd 

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` v
    ON o.vendor_code = v.vendor_code
    AND o.global_entity_id = v.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` z
    ON o.code = z.platform_order_code
    AND o.global_entity_id = z.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_logistics` l
    ON o.code = l.order_code
    AND o.global_entity_id = l.global_entity_id
    AND l.created_date_local >> DATE("2023-12-01")
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_dps` surge
    ON o.code = surge.order_code 
    AND o.global_entity_id = surge.global_entity_id
    AND surge.order_date_local >>= DATE("2023-12-01")
  LEFT JOIN shrink_data shrink
    ON o.code = shrink.order_code 
  WHERE o.ordered_at_date_local >>= DATE("2024-01-01")
    AND EXTRACT(YEAR FROM o.ordered_at_date_local) >>= 2024
    AND o.global_entity_id = 'FP_SG'
),

failed_order_agg AS (
  SELECT
    ordered_at_date_local,
    vertical,
    is_dfi,
    time_of_day,
    zone_name,
    COUNT(DISTINCT CASE WHEN is_failed = 1 THEN uuid END) AS failed_orders,
    COUNT(DISTINCT uuid) AS total_orders,
    COUNT(DISTINCT CASE WHEN is_valid_order AND NOT is_preorder THEN uuid END) AS total_valid_non_po_orders,
    SUM(CASE WHEN is_valid_order AND NOT is_preorder THEN actual_delivery_time_in_minutes END) AS total_dt,
    COUNT(DISTINCT CASE WHEN is_valid_order AND is_surged AND NOT is_fd THEN uuid END) AS surged_order_non_fd,
    COUNT(DISTINCT CASE WHEN is_valid_order AND is_surged THEN uuid END) AS surged_order,
    COUNT(DISTINCT CASE WHEN is_valid_order AND is_shrink THEN uuid END) AS shrink_order
  FROM failed_order_details
  GROUP BY GROUPING SETS (
    -- All 4 dimensions
    (ordered_at_date_local, vertical, is_dfi, time_of_day, zone_name),

    -- 3 dimensions
    (ordered_at_date_local, vertical, is_dfi, time_of_day),
    (ordered_at_date_local, vertical, is_dfi, zone_name),
    (ordered_at_date_local, vertical, time_of_day, zone_name),
    (ordered_at_date_local, is_dfi, time_of_day, zone_name),

    -- 2 dimensions
    (ordered_at_date_local, vertical, is_dfi),
    (ordered_at_date_local, vertical, time_of_day),
    (ordered_at_date_local, vertical, zone_name),
    (ordered_at_date_local, is_dfi, time_of_day),
    (ordered_at_date_local, is_dfi, zone_name),
    (ordered_at_date_local, time_of_day, zone_name),

    -- 1 dimension
    (ordered_at_date_local, vertical),
    (ordered_at_date_local, is_dfi),
    (ordered_at_date_local, time_of_day),
    (ordered_at_date_local, zone_name),

    -- All rolled up (daily total)
    (ordered_at_date_local)
  )

  UNION DISTINCT 

  SELECT
    ordered_at_date_local,
    'QC' AS vertical,
    TRUE AS is_dfi,
    time_of_day,
    zone_name,
    COUNT(DISTINCT CASE WHEN is_failed = 1 THEN uuid END) AS failed_orders,
    COUNT(DISTINCT uuid) AS total_orders,
    COUNT(DISTINCT CASE WHEN is_valid_order AND NOT is_preorder THEN uuid END) AS total_valid_non_po_orders,
    SUM(CASE WHEN is_valid_order AND NOT is_preorder THEN actual_delivery_time_in_minutes END) AS total_dt,
    COUNT(DISTINCT CASE WHEN is_valid_order AND is_surged AND NOT is_fd THEN uuid END) AS surged_order_non_fd,
    COUNT(DISTINCT CASE WHEN is_valid_order AND is_surged THEN uuid END) AS surged_order,
    COUNT(DISTINCT CASE WHEN is_valid_order AND is_shrink THEN uuid END) AS shrink_order
  FROM failed_order_details
  WHERE vertical IN ('QC Mart', 'Shops')
  GROUP BY GROUPING SETS (
    (ordered_at_date_local, time_of_day, zone_name),
    (ordered_at_date_local, time_of_day),
    (ordered_at_date_local, zone_name),
    (ordered_at_date_local)
  )
),

failed_shrink_surge_dt_agg AS (
  SELECT ordered_at_date_local
      , vertical
      , is_dfi 
      , COALESCE(time_of_day, "All Time") AS time_of_day
      , COALESCE(zone_name, "All Zone") AS zone_name
      , total_orders
      , failed_orders
      , total_valid_non_po_orders
      , total_dt 
      , surged_order_non_fd
      , surged_order
      , shrink_order
  FROM failed_order_agg
  WHERE vertical IS NOT NULL -- basically all vertical
    AND is_dfi IS NOT NULL 

  UNION DISTINCT 

  SELECT ordered_at_date_local
      , 'Platform' AS vertical
      , TRUE AS is_dfi 
      , COALESCE(time_of_day, "All Time") AS time_of_day
      , COALESCE(zone_name, "All Zone") AS zone_name
      , total_orders
      , failed_orders
      , total_valid_non_po_orders
      , total_dt 
      , surged_order_non_fd
      , surged_order
      , shrink_order
  FROM failed_order_agg
  WHERE vertical IS NULL
    AND is_dfi IS NULL 
),

--- RIDER DATA ---
rider_base_data AS (
  SELECT DISTINCT report_date_local
      , 'All Vertical'AS vertical
      , TRUE AS is_dfi
      , CASE WHEN EXTRACT(HOUR FROM start_datetime_local) BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN EXTRACT(HOUR FROM start_datetime_local) BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN EXTRACT(HOUR FROM start_datetime_local) BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN EXTRACT(HOUR FROM start_datetime_local) BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN EXTRACT(HOUR FROM start_datetime_local) BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , COALESCE(zone_name, "Unavailable") AS zone_name
      , worked_shift_count
      , shift_count
      , total_evaluation_working_time_in_minutes 
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_zone_metrics`
  WHERE global_entity_id = 'FP_SG'
    AND report_date_local >>= DATE("2024-01-01")
    AND EXTRACT(YEAR FROM report_date_local) >>= 2024
  -- GROUP BY 1,2,3,4,5
), 

rider_data_agg AS (
  SELECT report_date_local AS ordered_at_date_local
      , 'Platform' AS vertical    
      , TRUE AS is_dfi               
      , time_of_day
      , zone_name
      , SUM(worked_shift_count) AS filled_shift
      , SUM(shift_count) AS total_shift
      , SUM(total_evaluation_working_time_in_minutes)/60 AS rider_actual_hours
  FROM rider_base_data
  GROUP BY GROUPING SETS (
    (ordered_at_date_local, time_of_day, zone_name),
    (ordered_at_date_local, time_of_day),
    (ordered_at_date_local, zone_name),
    (ordered_at_date_local)
  )
),

rider_agg AS (
  SELECT ordered_at_date_local 
      , vertical 
      , is_dfi 
      , COALESCE(time_of_day, 'All Time') AS time_of_day
      , COALESCE(zone_name, 'All Zone') AS zone_name
      , filled_shift
      , total_shift 
      , rider_actual_hours
  FROM rider_data_agg 
),

special_occasion_date AS (
  SELECT *
  FROM `fulfillment-dwh-production.pandata_report.country_SG_special_occasions`, UNNEST(GENERATE_DATE_ARRAY(start_date, end_date)) AS generated_date
  WHERE occasion_type = 'Public Holiday'
  ORDER BY 1,2,3,4
)

SELECT o.*
     , t.session_
     , t.trx
     , t.user_w_session
     , fs.total_orders
     , fs.failed_orders
     , fs.total_valid_non_po_orders
     , fs.total_dt
     , fs.surged_order_non_fd
     , surged_order
     , shrink_order
     , r.filled_shift
     , r.total_shift 
     , r.rider_actual_hours
     , COALESCE(sd.occasion_type, "Regular Day") AS day_type
FROM order_agg o
LEFT JOIN traffic_agg t
  ON o.ordered_at_date_local = t.report_date
  AND o.time_of_day = t.time_of_day 
  AND o.vertical = t.vertical
  AND o.is_dfi = t.is_dfi
  AND o.zone_name = t.zone_name
LEFT JOIN failed_shrink_surge_dt_agg fs
  ON o.ordered_at_date_local = fs.ordered_at_date_local
  AND o.time_of_day = fs.time_of_day 
  AND o.vertical = fs.vertical
  AND o.is_dfi = fs.is_dfi
  AND o.zone_name = fs.zone_name
LEFT JOIN rider_agg r
  ON o.ordered_at_date_local = r.ordered_at_date_local
  AND o.time_of_day = r.time_of_day 
  AND o.vertical = r.vertical
  AND o.is_dfi = r.is_dfi
  AND o.zone_name = r.zone_name
LEFT JOIN special_occasion_date sd
  ON o.ordered_at_date_local = sd.generated_date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1umhyuc022au2e14cq3c41t9gwx9' name='Custom SQL Query' type='text'><![CDATA[/* DFI */

WITH dfi_voucher_details AS (
  SELECT DISTINCT CASE WHEN LOWER(voucher_code) LIKE "%newgrocer%" OR LOWER(voucher_code) LIKE "%trygrocer%" OR uuid = 'OFRV_7981403755168891_FP_SG' THEN 'Blanket - NEWGROCER'
                       WHEN LOWER(voucher_code) LIKE "%groceries%" THEN 'Blanket - GROCERIES'
                       WHEN LOWER(voucher_code) LIKE "%ndp59%" THEN 'Blanket - NDP59'
                       WHEN LOWER(voucher_code) LIKE "%savemore%" THEN 'Blanket - SAVEMORE'
                       WHEN LOWER(voucher_code) LIKE "%progrocer%" THEN 'Blanket - PROGROCER'
                       WHEN LOWER(voucher_code) LIKE "%kidsrun10%" THEN 'Blanket - KIDSRUN10'
                       WHEN LOWER(voucher_code) LIKE "%pro4offdfi%" OR uuid IN ('OFRV_8107357492748123_FP_SG', 'OFRV_8092871228027097_FP_SG') THEN 'Blanket - PRO4OFFDFI'
  
                       WHEN (crm_campaign_id LIKE '%LOC_AUT_24%' OR crm_campaign_id LIKE '%LOC_AUT_25%') AND 
                            (crm_campaign_id LIKE '%_Voucher_CAN%') AND 
                            (crm_campaign_id LIKE '%_SG_FP_EG_DFI%') AND 
                            (crm_campaign_id LIKE '%-Orderfreq%') THEN 'Wallet - Return'

                       WHEN (crm_campaign_id LIKE '%LOC_MA_24%' OR crm_campaign_id LIKE '%LOC_MA_25%') AND 
                            (crm_campaign_id LIKE '%_Voucher_CAN%') AND	
                            ((crm_campaign_id LIKE '%_SG_FP_EG_shops-CS-NC%') OR 
                             (crm_campaign_id LIKE '%_SG_FP_EG_shops-DFI-NC%') OR 
                             (crm_campaign_id LIKE '%_SG_FP_EG_shops-Pro-CS-NC%')) THEN 'Wallet - NC'

                       WHEN (crm_campaign_id LIKE '%LOC_MA_24%' OR crm_campaign_id LIKE '%LOC_MA_25%') AND
                            (crm_campaign_id LIKE '%_Voucher_CAN%') AND	
                            ((crm_campaign_id LIKE '%_SG_FP_EG_shops-CS-EC%') OR 
                             (crm_campaign_id LIKE '%_SG_FP_EG_shops-DFI-EC%') OR 
                             (crm_campaign_id LIKE '%_SG_FP_EG_shops-Pro-CS-EC%')) THEN 'Wallet - EC'

                       WHEN (crm_campaign_id LIKE '%LOC_MA_24%' OR crm_campaign_id LIKE '%LOC_MA_25%') AND
                            (crm_campaign_id LIKE '%_Voucher_CAN%') AND	
                            ((crm_campaign_id LIKE '%_SG_FP_EG_shops-CS-Churn%') OR 
                             (crm_campaign_id LIKE '%_SG_FP_EG_shops-DFI-Churn%') OR  
                             (crm_campaign_id LIKE '%_SG_FP_EG_Shops-Inactive%')) THEN 'Wallet - Churn'

                       WHEN LOWER(crm_campaign_id) LIKE "%churn%" OR LOWER(crm_campaign_id) LIKE "%reaotp%" THEN 'CRM Flow - Churn'

                       WHEN LOWER(crm_campaign_id) LIKE "%trial%" OR LOWER(crm_campaign_id) LIKE "%adoption%" OR LOWER(crm_campaign_id) LIKE "%newtovertical%" THEN 'CRM Flow - NC'

                       WHEN LOWER(crm_campaign_id) LIKE "%activemonthly%" OR LOWER(crm_campaign_id) LIKE "%activeweekly%" OR 
                            LOWER(crm_campaign_id) LIKE "%grooming%" OR LOWER(crm_campaign_id) LIKE "%repurchase%" THEN 'CRM Flow - EC'

                       WHEN (crm_campaign_id LIKE '%QUI_MA_%' OR crm_campaign_id LIKE "%QUI_AUT_%") AND
                            (crm_campaign_id LIKE '%XX_SG_FP_EG_pro-AFV_Voucher_CAN%' OR crm_campaign_id LIKE '%XX_SG_FP_EG_pro-AFV-renew_Voucher_CAN%') AND 
                             description IN ('$4 off on Giant & Cold Storage') AND DATE_TRUNC(start_date_local, MONTH) >>= DATE("2024-11-01") THEN 'PRO - $ off'

                       WHEN (crm_campaign_id LIKE '%QUI_MA_%' OR crm_campaign_id LIKE "%QUI_AUT_%") AND 
                            (crm_campaign_id LIKE '%XX_SG_FP_EG_pro-AFV_Voucher_CAN%' OR crm_campaign_id LIKE '%XX_SG_FP_EG_pro-AFV-renew_Voucher_CAN%') AND 
                             description IN ('Free delivery on Giant & Cold Storage') AND DATE_TRUNC(start_date_local, MONTH) >>= DATE("2024-11-01") THEN 'PRO - Free Delivery'

          ELSE 'CRM Flows' END AS voucher_tag 

      , crm_campaign_id
      , CASE WHEN LOWER(voucher_code) LIKE "%newgrocer%" OR LOWER(voucher_code) LIKE "%trygrocer%" THEN '0.2|40|10'
             WHEN LOWER(voucher_code) LIKE "%groceries%" THEN '0.1|80|10'
             WHEN LOWER(voucher_code) LIKE "%ndp59%" THEN '0.59|15|5'
             WHEN LOWER(voucher_code) LIKE "%kidsrun10%" THEN '$10 off varying MOV'
             WHEN LOWER(voucher_code) LIKE "%pro4offdfi%" OR uuid IN ('OFRV_8107357492748123_FP_SG', 'OFRV_8092871228027097_FP_SG') THEN '4|50|0'
          ELSE CONCAT(CAST(value AS STRING), '|', CAST(minimum_order_value_local AS STRING), '|', CAST(maximum_discount_amount_local AS STRING)) END AS construct

      , DATE_TRUNC(start_date_local, MONTH) AS month_
      , uuid AS pd_voucher_uuid
      , customer_code
      
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers`
  WHERE global_entity_id = 'FP_SG'
    AND created_date_utc >> DATE("2023-12-01")
    AND ((is_deleted AND uuid = 'OFRV_7981403755168891_FP_SG')
        OR (is_deleted AND uuid = 'OFRV_8092871228027097_FP_SG')
        OR ( NOT is_deleted AND ( -- BLANKET
                                  (LOWER(voucher_code) LIKE "%newgrocer%" OR LOWER(voucher_code) LIKE "%groceries%" OR LOWER(voucher_code) LIKE "%trygrocer%" OR 
                                   LOWER(voucher_code) LIKE "%ndp59%" OR LOWER(voucher_code) LIKE "%savemore%" OR LOWER(voucher_code) LIKE "%progrocer%" OR 
                                   LOWER(voucher_code) LIKE "%pro4offdfi%" OR LOWER(voucher_code) LIKE "%kidsrun10%")
                                  
                                  OR
                                  -- AGREED CONSTRUCT
                                  (((minimum_order_value_local = 35 and value = 6) OR
                                    (minimum_order_value_local = 80 and value = 0.1 and maximum_discount_amount_local = 10) OR
                                    (minimum_order_value_local = 40 and value = 0.2 and maximum_discount_amount_local = 10)))

                                  OR
                                  -- WALLET VOUCHER 
                                  ((crm_campaign_id LIKE '%LOC_MA_24%' OR crm_campaign_id LIKE '%LOC_AUT_24%' OR crm_campaign_id LIKE '%LOC_MA_25%' OR crm_campaign_id LIKE '%LOC_AUT_25%')	
                                                                                                                AND	(crm_campaign_id LIKE '%_Voucher_CAN%')
                                                                                                                AND	((crm_campaign_id LIKE '%_SG_FP_EG_shops-CS-NC%') OR
                                                                                                                     (crm_campaign_id LIKE '%_SG_FP_EG_shops-DFI-NC%') OR
                                                                                                                     (crm_campaign_id LIKE '%_SG_FP_EG_shops-CS-EC%') OR
                                                                                                                     (crm_campaign_id LIKE '%_SG_FP_EG_shops-DFI-EC%') OR
                                                                                                                     (crm_campaign_id LIKE '%_SG_FP_EG_shops-Pro%') OR
                                                                                                                     (crm_campaign_id LIKE '%_SG_FP_EG_shops-DFI-Churn%') OR
                                                                                                                     ((crm_campaign_id LIKE '%_SG_FP_EG_DFI%') AND (crm_campaign_id LIKE '%-Orderfreq%')) OR
                                                                                                                     (crm_campaign_id LIKE '%_SG_FP_EG_shops-CS-Churn%') OR  
                                                                                                                     (crm_campaign_id LIKE '%_SG_FP_EG_Shops-Inactive%')))
                                  OR

                                  (DATE_TRUNC(start_date_local, MONTH) = DATE("2024-09-01") AND 
                                    -- Shop Cross Trial - $8 off $20
                                    (crm_campaign_id = 'LOC_AUT_2402XX_AP_FP_PT_Shops|CrossTrialDailySegmentation_Voucher_SEG' AND minimum_order_value_local = 20 AND value = 8))
                                  
                                  OR
                                  
                                  ((crm_campaign_id LIKE '%QUI_MA_%' OR crm_campaign_id LIKE "%QUI_AUT_%") AND 
                                   (crm_campaign_id LIKE '%XX_SG_FP_EG_pro-AFV_Voucher_CAN%' OR crm_campaign_id LIKE '%XX_SG_FP_EG_pro-AFV-renew_Voucher_CAN%') AND 
                                  description IN ('$4 off on Giant & Cold Storage','Free delivery on Giant & Cold Storage') AND
                                  DATE_TRUNC(start_date_local, MONTH) >>= DATE("2024-11-01"))

                                  --OR crm_campaign_id IN ('LOC_AUT_2506XX_SG_FP_EG_DFI-Orderfreq_Voucher_CAN')

                                  )
                                )
        
      )

    AND crm_campaign_id NOT IN ('MIX_MA_240710_AP_FP_PT_EURO24-SF2-Ned-Eng_Promo_CAN',
                                'MIX_MA_240714_AP_FP_EG_EURO24-Finals-Sp-Eng_Promo_CAN',
                                'DMA_MA_240715_SG_FP_EG_Nonpro-Dmart-NTV_Voucher_CAN')
), 

fdntv_order AS (
  SELECT DISTINCT platform_order_code

  FROM `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` df

  WHERE df.country_code = 'sg'
    AND df.created_date >>= '2024-11-01'
    AND df.campaign_id IN (1230)

),

cs_vendors AS (
  SELECT DISTINCT pd_vendor_uuid
       , vendor_code
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` 
  WHERE global_entity_id = 'FP_SG'
    AND chain_code IN ('ce2ua', 'cx9nw')
),

dps_df AS (
  SELECT DISTINCT dps.platform_order_code 
      , o.uuid AS order_uuid
      , CASE WHEN (ROUND(o.delivery_fee_original_local + IFNULL(ABS(pd_order_fees_delivery_fee_adjustment_plus_vat_local), 0), 2) = 1.99) OR
                  (v.vendor_name LIKE ("%Burger King%") AND DATE_TRUNC(o.ordered_at_date_local, MONTH) = DATE("2024-11-01")) THEN 2 + ROUND(o.delivery_fee_original_local + IFNULL(ABS(pd_order_fees_delivery_fee_adjustment_plus_vat_local), 0), 2)
          ELSE ROUND(o.delivery_fee_original_local + IFNULL(ABS(pd_order_fees_delivery_fee_adjustment_plus_vat_local), 0), 2) END AS original_df 
  FROM `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o 
    ON dps.platform_order_code = o.code
    AND dps.entity_id = o.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` v 
    ON o.vendor_code = v.vendor_code
    AND o.global_entity_id = v.global_entity_id 
  LEFT JOIN (`fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` acc
  JOIN UNNEST(accounting) AS accounting)
    ON o.code = acc.order_code
    AND o.global_entity_id = acc.global_entity_id
    AND acc.global_entity_id = 'FP_SG'
    AND  acc.created_date_utc >>= '2024-11-01'
    AND accounting.is_order_last_entry = TRUE
  WHERE o.is_valid_order 
    AND dps.entity_id = 'FP_SG'
    AND o.global_entity_id = 'FP_SG'
    AND DATE_TRUNC(ordered_at_date_local, MONTH) >>= DATE("2024-01-01")
),

order_details AS (
  SELECT DISTINCT o.ordered_at_date_local
      , o.uuid AS order_uuid
      , o.code AS order_code

      -- voucher_funding_type
      , CASE WHEN o.voucher_channel = 'channel_corporate' THEN 'company-funded'
             WHEN dv.pd_voucher_uuid IS NOT NULL AND dv.voucher_tag = 'PRO - Free Delivery' THEN 'fp-funded'
             WHEN dv.pd_voucher_uuid IS NOT NULL AND DATE_TRUNC(o.ordered_at_date_local, MONTH) <<>> DATE("2024-10-01") THEN 'Co-funded'
             WHEN dv.pd_voucher_uuid IS NOT NULL AND DATE_TRUNC(o.ordered_at_date_local, MONTH) = DATE("2024-10-01") THEN 'fp-funded'
             WHEN dv.pd_voucher_uuid IS NULL AND o.pd_voucher_uuid IS NOT NULL THEN 'fp-funded'
             WHEN dv.pd_voucher_uuid IS NULL AND o.pd_voucher_uuid IS NULL THEN 'No voucher' END AS funding_type

      --, o.pd_voucher_uuid
      --, o.voucher_description

        -- voucher_tag
      , CASE WHEN dv.pd_voucher_uuid IS NOT NULL THEN voucher_tag
              WHEN o.pd_voucher_uuid IS NOT NULL AND o.voucher_type = 'free_delivery' AND o.voucher_description LIKE "%pandapro bonus: Free delivery%" THEN 'PRO DF voucher'
            END AS voucher_tag
        -- voucher_construct
      , CASE WHEN dv.pd_voucher_uuid IS NOT NULL THEN construct ELSE "" END AS voucher_construct
      , COALESCE(o.voucher_amount_local,0) AS voucher_amount_local
      , dv.crm_campaign_id
      
      -- df part as deals
      , a.is_first_valid_order_with_this_chain
      , o.delivery_fee_local = 0 AS is_free_df
      , s.platform_order_code IS NOT NULL OR fdntv.platform_order_code IS NOT NULL AS is_fdntv
      
      -- 50% off -- OFRD_450937_FP_SG
      , COALESCE(o.pd_discount_uuid IN ('OFRD_450937_FP_SG', 'OFRD_450938_FP_SG'), FALSE) AS is_50perc_deal
      , COALESCE(CASE WHEN o.pd_discount_uuid IN ('OFRD_450937_FP_SG', 'OFRD_450938_FP_SG') THEN o.discount_amount_local END,0) AS discount_50perc_amount_local
      
      , ac.initial_gfv_local
      , o.gfv_local
      , o.gmv_local
      
      , o.is_subscriber_order
      , o.pd_customer_uuid

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` ac
    ON o.code = ac.order_code
    AND o.global_entity_id = ac.global_entity_id
    AND ac.created_date_utc >> DATE("2024-05-01")
  LEFT JOIN dfi_voucher_details dv
    ON o.pd_voucher_uuid = dv.pd_voucher_uuid
  LEFT JOIN cs_vendors cv
    ON o.vendor_code = cv.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_acquisition` a 
    ON o.uuid = a.uuid 
  -- FDNTV data
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_test_orders` s
    ON o.code = s.platform_order_code 
    AND s.country_name IN ('Singapore')
    AND s.created_date_local >>= '2024-09-02'
    AND s.test_id in (134,145)
    AND s.is_in_treatment
    AND s.is_match_test_vertical
    AND s.test_variant <<>> 'Control'
  LEFT JOIN fdntv_order fdntv
    ON o.code = fdntv.platform_order_code
  WHERE o.is_valid_order 
    AND cv.pd_vendor_uuid IS NOT NULL
    AND DATE_TRUNC(o.ordered_at_date_local, MONTH) >>= DATE("2024-01-01")
),

pro_df_voucher_order_uuid AS (
  SELECT DISTINCT order_uuid 
  FROM order_details
  WHERE is_free_df AND voucher_tag = 'PRO DF voucher'
  GROUP BY 1
),

fdntv_order_agg AS (
  SELECT o.order_uuid
      , ddf.original_df*0.5 AS fp_fdntv_cost
      , ddf.original_df*0.5 AS dfi_fdntv_cost
  FROM order_details o 
  LEFT JOIN dps_df ddf
    ON o.order_code = ddf.platform_order_code
  WHERE o.is_fdntv
    AND ordered_at_date_local >>= DATE("2024-01-01")
),

bvdf_order AS (
  -- BVDF
  SELECT o.order_uuid
      , 'Non Co-funded' AS funding_type
      , 'BVDF' AS voucher_tag
      , '' AS voucher_construct
      , COUNT(DISTINCT o.order_uuid) AS order_count
      , SUM(ddf.original_df) AS total_incentive_cost
      , SUM(ddf.original_df) AS fp_bvdf_cost
      , SUM(0) AS dfi_bvdf_cost
  FROM order_details o 
  LEFT JOIN dps_df ddf
    ON o.order_code = ddf.platform_order_code
  LEFT JOIN pro_df_voucher_order_uuid pd
    ON o.order_uuid = pd.order_uuid
  WHERE o.is_free_df
    AND NOT o.is_fdntv
    AND pd.order_uuid IS NULL
    AND o.ordered_at_date_local << DATE("2025-01-01")
    AND (
      -- sept onwards, pro >>= 60, non-pro >>= 80
      (o.ordered_at_date_local >>= DATE("2024-09-01") AND is_subscriber_order AND initial_gfv_local >>= 60) OR
      (o.initial_gfv_local >>= 80)
    )
    --AND o.gfv_local >>= 80
  GROUP BY 1,2,3,4

  UNION DISTINCT

  SELECT o.order_uuid
      , 'Co-funded' AS funding_type
      , 'BVDF' AS voucher_tag
      , '' AS voucher_construct
      , COUNT(DISTINCT o.order_uuid) AS order_count
      , SUM(CASE WHEN o.initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 5,ddf.original_df) ELSE IF(ddf.original_df >>= 2, 2,ddf.original_df) END) AS total_incentive_cost
      , SUM(CASE WHEN o.initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 2.5,ddf.original_df/2) ELSE IF(ddf.original_df >>= 2, 1,ddf.original_df/2) END) AS fp_bvdf_cost
      , SUM(CASE WHEN o.initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 2.5,ddf.original_df/2) ELSE IF(ddf.original_df >>= 2, 1,ddf.original_df/2) END) AS dfi_bvdf_cost

  FROM order_details o
  LEFT JOIN dps_df ddf
    ON o.order_code = ddf.platform_order_code
  WHERE o.ordered_at_date_local >>= DATE("2025-01-01")
    AND o.ordered_at_date_local << DATE("2025-06-01")
    AND initial_gfv_local >>= 60
  GROUP BY 1,2,3,4
  
  UNION DISTINCT 

  SELECT o.order_uuid
     , CASE WHEN (is_subscriber_order AND initial_gfv_local >>= 50) THEN 'Non Co-funded' ELSE 'Co-funded' END AS funding_type
     , 'BVDF'voucher_tag
     , CASE WHEN is_subscriber_order AND initial_gfv_local >>= 50 THEN 'MOV 40'
         ELSE 'MOV 60/80' END AS voucher_construct
     , COUNT(DISTINCT o.order_uuid) AS order_count
     , SUM(CASE WHEN is_subscriber_order AND initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 5, ddf.original_df)
                WHEN is_subscriber_order AND initial_gfv_local >>= 50 THEN IF(ddf.original_df >>= 4, 4, ddf.original_df)
                WHEN NOT is_subscriber_order AND initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 5,ddf.original_df) 
              ELSE IF(ddf.original_df >>= 2, 2,ddf.original_df) END) AS total_incentive_cost

     , SUM(CASE WHEN is_subscriber_order AND initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 5, ddf.original_df)
                WHEN is_subscriber_order AND initial_gfv_local >>= 50 THEN IF(ddf.original_df >>= 4, 4, ddf.original_df)
                
                WHEN NOT is_subscriber_order AND initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 2.5,ddf.original_df/2) 
              ELSE IF(ddf.original_df >>= 2, 1,ddf.original_df/2) END) AS fp_cost

     , SUM(CASE WHEN is_subscriber_order AND initial_gfv_local >>= 50 THEN 0
                 WHEN NOT is_subscriber_order AND initial_gfv_local >>= 80 THEN IF(ddf.original_df >>= 5, 2.5,ddf.original_df/2) 
              ELSE IF(ddf.original_df >>= 2, 1,ddf.original_df/2) END) AS dfi_cost
  FROM order_details o 
  LEFT JOIN dps_df ddf
    ON o.order_code = ddf.platform_order_code
  LEFT JOIN pro_df_voucher_order_uuid pd
    ON o.order_uuid = pd.order_uuid
  WHERE NOT o.is_fdntv
    --AND pd.order_uuid IS NULL
    AND o.ordered_at_date_local >>= DATE("2025-06-01")
    AND (
      -- sept onwards, pro >>= 60, non-pro >>= 80
      (is_subscriber_order AND initial_gfv_local >>= 50) OR
      (o.initial_gfv_local >>= 60)
    )
    --AND o.gfv_local >>= 80
  GROUP BY 1,2,3,4
),

dfi_order_tag AS (
  SELECT DISTINCT o.order_code 
      , CASE WHEN o.funding_type = 'Co-funded' THEN 0.5 * voucher_amount_local ELSE 0 END AS dfi_voucher_cost
      , COALESCE(fd.dfi_fdntv_cost,0) + COALESCE(bv.dfi_bvdf_cost,0) AS dfi_df_cost
      , COALESCE(o.discount_50perc_amount_local*0.5,0) AS dfi_deal_cost
  FROM order_details o
  LEFT JOIN fdntv_order_agg fd
    ON o.order_uuid = fd.order_uuid
  LEFT JOIN bvdf_order bv
    ON o.order_uuid = bv.order_uuid
  WHERE ordered_at_date_local >>= DATE("2024-01-01")
),

/* Dmart Voucher Tag*/

voucher_vert_count AS (
  SELECT DISTINCT crm_campaign_id
       , COUNT(DISTINCT vt) AS vertical_count
       , STRING_AGG(DISTINCT vt) AS vertical_list
       , CASE WHEN COUNT(DISTINCT vt) = 1 AND STRING_AGG(DISTINCT vt) = 'darkstores' THEN TRUE ELSE FALSE END AS dmart_tag
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` v, UNNEST(vertical_types) vt
  WHERE v.created_date_utc >> "2023-12-31"
    AND v.global_entity_id = 'FP_SG'
    AND v.channel NOT IN ("channel_customer_service","channel_rider_rewards","channel_influencers")
    AND v.purpose <<>> 'sorry_panda'
  GROUP BY 1
),

dmart_voucher_only AS (
  SELECT DISTINCT o.code
  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o 
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_vouchers` v
    ON o.pd_voucher_uuid = v.uuid
    AND v.created_date_utc >> "2023-12-31"
  LEFT JOIN voucher_vert_count vc 
    ON v.crm_campaign_id = vc.crm_campaign_id
  WHERE vc.dmart_tag
  -- i need to know juga which order that's dont use dmart voucher only?
),

voucher_to_exclude AS (
  SELECT DISTINCT uuid
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers`
  WHERE global_entity_id = 'FP_SG'
    AND created_Date_utc << CURRENT_DATE()
    AND (UPPER(voucher_code) LIKE "%SORRY%" OR 
         channel IN ("channel_partnership", "channel_customer_service", "channel_rider_rewards","channel_influencers") OR 
         purpose = 'sorry_panda' OR 
         (LOWER(voucher_code) LIKE "%yuu%" AND LOWER(voucher_code) LIKE "%fp%" AND LOWER(voucher_code) LIKE "%@@@@%"))
),

order_w_excluded_voucher AS (
  SELECT DISTINCT o.code 
  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o 
  LEFT JOIN voucher_to_exclude v
    ON o.pd_voucher_uuid = v.uuid 
  WHERE o.is_valid_order 
    AND o.ordered_at_date_local >>= DATE("2024-01-01")
    AND v.uuid IS NOT NULL
),

pu_eg_rr_qr AS (
  SELECT DISTINCT SPLIT(order_uid, "_")[2] AS order_code
      , COALESCE(discount_cost_fp_local,0) AS pu_rr
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_incentive_cost` mic 
  WHERE global_entity_id = 'FP_SG'
    AND expedition_type = 'pickup'
    AND business_type_apac = 'restaurants'
    AND is_valid_order
    AND created_date_local >>= '2024-01-01'
),

corp_rr_qr AS (
  SELECT DISTINCT SPLIT(order_uid, "_")[2] AS order_code
      , CASE WHEN is_corporate_evergreen_discount THEN discount_cost_fp_local ELSE 0 END + 
        CASE WHEN is_corporate_evergreen_voucher THEN voucher_cost_fp_local  ELSE 0 END AS corp_rr

  FROM fulfillment-dwh-production.pandata_report.regional_apac_mkt_incentive_cost

  WHERE global_entity_id = 'FP_SG'
    AND is_corporate_order
    AND is_valid_order
    AND created_date_local >>= '2024-01-01'
),

daily_order_details AS (
  SELECT o.*
      , CASE WHEN ev.code IS NULL THEN fp_funded_voucher ELSE 0 END fp_funded_voucher_excluded 
      , COALESCE(pu.pu_rr,0) AS pu_rr
      , COALESCE(corp.corp_rr,0) AS corp_rr
      , COALESCE(dfi_voucher_cost,0) AS dfi_voucher_cost
      , COALESCE(dfi_deal_cost,0) AS dfi_deal_cost
      , COALESCE(dfi_df_cost,0) AS dfi_df_cost
      , COALESCE(CASE WHEN dmart.code IS NULL THEN 0 ELSE fp_funded_voucher END,0) AS fp_funded_voucher_dmart_only
  FROM `fulfillment-dwh-production.pandata_report.country_SG_daily_dash_order_details` o 
  LEFT JOIN order_w_excluded_voucher ev
    ON o.order_code = ev.code 
  LEFT JOIN pu_eg_rr_qr pu
    ON o.order_code = pu.order_code
  LEFT JOIN corp_rr_qr corp
    ON o.order_code = corp.order_code
  LEFT JOIN dfi_order_tag dfi
    ON o.order_code = dfi.order_code
  LEFT JOIN dmart_voucher_only dmart
    ON o.order_code = dmart.code 
),

base_data AS (
  SELECT ordered_at_date_local
        , vertical 
        , CASE WHEN zone_name = 'No Zone' THEN 'Unavailable' ELSE COALESCE(zone_name, "Unavailable") END AS zone_name
        , time_of_day
        , is_dfi
        , COUNT(DISTINCT order_uuid) AS orders
        , SUM(gmv_local) AS gmv
        , SUM(gfv_local) AS gfv

        , SUM(fp_funded_voucher) AS fp_funded_voucher
        , SUM(fp_funded_deal) AS fp_deal_cost
        , SUM(fp_funded_voucher_df + fp_funded_deal_df + fp_funded_deal_df_pro + IF(vertical NOT IN ('QC Mart', 'Shops'), fp_funded_food_df,0) + IF(vertical IN ('QC Mart'), fp_funded_dmart_df,0) + IF(vertical IN ('Shops'), fp_funded_shop_df,0)) AS fp_df_cost

        , SUM(vf_funded_voucher) AS vf_funded_voucher
        , SUM(vf_funded_deal) AS vf_deal_cost
        , SUM(vf_funded_voucher_df + vf_funded_deal_df) AS vf_df_cost

        , SUM(delivery_fee_local) AS delivery_fee
        , COUNT(DISTINCT pd_customer_uuid) AS active_users

        , SUM(fp_funded_voucher_excluded) AS fp_funded_voucher_excluded 
        , SUM(pu_rr) AS pickup_revenue_reduction
        , SUM(corp_rr) AS corporate_revenue_reduction

        , SUM(COALESCE(dfi_voucher_cost,0) + COALESCE(dfi_deal_cost,0) + COALESCE(dfi_df_cost,0)) AS dfi_funded_cost
        , SUM(fp_funded_voucher_dmart_only) AS fp_funded_voucher_dmart_only

  FROM daily_order_details --`fulfillment-dwh-production.pandata_report.country_SG_daily_dash_order_details`
  GROUP BY GROUPING SETS (
    -- All 4 dimensions
    (ordered_at_date_local, vertical, is_dfi, time_of_day, zone_name),

    -- 3 dimensions
    (ordered_at_date_local, vertical, is_dfi, time_of_day),
    (ordered_at_date_local, vertical, is_dfi, zone_name),
    (ordered_at_date_local, vertical, time_of_day, zone_name),
    (ordered_at_date_local, is_dfi, time_of_day, zone_name),

    -- 2 dimensions
    (ordered_at_date_local, vertical, is_dfi),
    (ordered_at_date_local, vertical, time_of_day),
    (ordered_at_date_local, vertical, zone_name),
    (ordered_at_date_local, is_dfi, time_of_day),
    (ordered_at_date_local, is_dfi, zone_name),
    (ordered_at_date_local, time_of_day, zone_name),

    -- 1 dimension
    (ordered_at_date_local, vertical),
    (ordered_at_date_local, is_dfi),
    (ordered_at_date_local, time_of_day),
    (ordered_at_date_local, zone_name),

    -- All rolled up (daily total)
    (ordered_at_date_local)
  )

  UNION DISTINCT 

  SELECT ordered_at_date_local
        , 'QC' AS vertical 
        , CASE WHEN zone_name = 'No Zone' THEN 'Unavailable' ELSE COALESCE(zone_name, "Unavailable") END AS zone_name
        , time_of_day
        , TRUE AS is_dfi
        , COUNT(DISTINCT order_uuid) AS orders
        , SUM(gmv_local) AS gmv
        , SUM(gfv_local) AS gfv

        , SUM(fp_funded_voucher) AS fp_funded_voucher
        , SUM(fp_funded_deal) AS fp_deal_cost
        , SUM(fp_funded_voucher_df + fp_funded_deal_df + fp_funded_deal_df_pro + IF(vertical NOT IN ('QC Mart', 'Shops'), fp_funded_food_df,0) + IF(vertical IN ('QC Mart'), fp_funded_dmart_df,0) + IF(vertical IN ('Shops'), fp_funded_shop_df,0)) AS fp_df_cost

        , SUM(vf_funded_voucher) AS vf_funded_voucher
        , SUM(vf_funded_deal) AS vf_deal_cost
        , SUM(vf_funded_voucher_df + vf_funded_deal_df) AS vf_df_cost

        , SUM(delivery_fee_local) AS delivery_fee
        , COUNT(DISTINCT pd_customer_uuid) AS active_users
        
        , SUM(fp_funded_voucher_excluded) AS fp_funded_voucher_excluded 
        , SUM(pu_rr) AS pickup_revenue_reduction
        , SUM(corp_rr) AS corporate_revenue_reduction

        , SUM(COALESCE(dfi_voucher_cost,0) + COALESCE(dfi_deal_cost,0) + COALESCE(dfi_df_cost,0)) AS dfi_funded_cost

        , SUM(fp_funded_voucher_dmart_only) AS fp_funded_voucher_dmart_only

  FROM daily_order_details -- `fulfillment-dwh-production.pandata_report.country_SG_daily_dash_order_details`
  WHERE vertical IN ('QC Mart', 'Shops')
  GROUP BY GROUPING SETS (
    (ordered_at_date_local, time_of_day, zone_name),
    (ordered_at_date_local, time_of_day),
    (ordered_at_date_local, zone_name),
    (ordered_at_date_local)
  )
),

order_agg AS (
  SELECT ordered_at_date_local
      , vertical
      , is_dfi 
      , COALESCE(time_of_day, "All Time") AS time_of_day
      , COALESCE(zone_name, "All Zone") AS zone_name
      , orders
      , gmv 
      , gfv
      , fp_funded_voucher 
      , fp_deal_cost 
      , fp_df_cost 
      , vf_funded_voucher 
      , vf_deal_cost 
      , vf_df_cost
      , delivery_fee 
      , active_users
      , fp_funded_voucher_excluded 
      , pickup_revenue_reduction
      , corporate_revenue_reduction
      , dfi_funded_cost
      , fp_funded_voucher_dmart_only
  FROM base_data
  WHERE vertical IS NOT NULL -- basically all vertical
    AND is_dfi IS NOT NULL 

  UNION DISTINCT 

  SELECT ordered_at_date_local
      , 'Platform' AS vertical
      , TRUE AS is_dfi 
      , COALESCE(time_of_day, "All Time") AS time_of_day
      , COALESCE(zone_name, "All Zone") AS zone_name
      , orders
      , gmv 
      , gfv
      , fp_funded_voucher 
      , fp_deal_cost 
      , fp_df_cost 
      , vf_funded_voucher 
      , vf_deal_cost 
      , vf_df_cost
      , delivery_fee 
      , active_users
      , fp_funded_voucher_excluded 
      , pickup_revenue_reduction
      , corporate_revenue_reduction
      , dfi_funded_cost
      , fp_funded_voucher_dmart_only
  FROM base_data
  WHERE vertical IS NULL -- basically all vertical
    AND is_dfi IS NULL 
),

lg_zones AS (
  SELECT zones.name AS zone_name,
        zones.shape AS shape

  FROM `fulfillment-dwh-production.curated_data_shared.countries` c,
  UNNEST(c.cities) city,
  UNNEST(city.zones) zones

  WHERE country_name = 'Singapore'
    AND zones.is_active = True
    AND lower(zones.name) NOT LIKE '%dmart%'
),
/*
user_with_session_details AS (
  SELECT DISTINCT s.created_date_local
      , s.created_at_local 
      , CASE WHEN EXTRACT(HOUR FROM created_at_local) BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
            WHEN EXTRACT(HOUR FROM created_at_local) BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
            WHEN EXTRACT(HOUR FROM created_at_local) BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
            WHEN EXTRACT(HOUR FROM created_at_local) BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
            WHEN EXTRACT(HOUR FROM created_at_local) BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , s.session_id 
      , s.customer_id
      , "All Zone" AS zone_name --, COALESCE(z.zone_name, "Unavailable") AS zone_name -- hmmmmmm
  FROM `fulfillment-dwh-production.curated_data_shared.dps_perseus_sessions` s, UNNEST(dps) d
  LEFT JOIN lg_zones z
    ON ST_WITHIN(ST_GEOGFROMTEXT(d.customer_location), z.shape)
  WHERE entity_id = 'FP_SG'
    AND session_id IS NOT NULL
    AND created_date_local >>= DATE("2024-12-02") 
        --( (created_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
        --  (created_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND EXTRACT(YEAR FROM created_at_local) >>= 2024
  /*
  QUALIFY ROW_NUMBER() OVER(PARTITION BY s.customer_id ORDER BY CASE
    WHEN zone_name = 'Bukit timah' THEN 1
    WHEN zone_name = 'Bedok' THEN 2
    WHEN zone_name = 'Amk' THEN 3
    WHEN zone_name = 'Sg_south' THEN 4
    WHEN zone_name = 'Serangoon' THEN 5
    WHEN zone_name = 'Yishun' THEN 6
    WHEN zone_name = 'Woodlands' THEN 7
    WHEN zone_name = 'Jurong east' THEN 8
    WHEN zone_name = 'Bukitpanjang' THEN 9
    WHEN zone_name = 'Geylang' THEN 10
    WHEN zone_name = 'Far_east' THEN 11
    WHEN zone_name = 'Sengkang' THEN 12
    WHEN zone_name = 'Jurongwest' THEN 13 END) = 1
  
),

user_with_session_agg AS (
  SELECT DISTINCT 'Platform' AS vertical
      , created_date_local AS ordered_at_date_local
      , time_of_day
      , zone_name
      , TRUE AS is_dfi
      , COUNT(DISTINCT customer_id) AS user_w_session
  FROM user_with_session_details
  GROUP BY 1,2,3,4,5
  /*
  GROUP BY GROUPING SETS (
    (ordered_at_date_local, time_of_day, zone_name),
    (ordered_at_date_local, time_of_day),
    (ordered_at_date_local, zone_name),
    (ordered_at_date_local)
  )

  UNION DISTINCT 

  SELECT DISTINCT "Platform" AS vertical
      , created_date_local AS ordered_at_date_local
      , "All Time" AS time_of_day
      , zone_name
      , TRUE AS is_dfi
      , COUNT(DISTINCT customer_id) AS user_w_session
  FROM user_with_session_details
  GROUP BY 1,2,3,4,5
),

user_with_session AS (
  SELECT vertical 
      , ordered_at_date_local 
      , COALESCE(time_of_day,"All Time") AS time_of_day
      , COALESCE(zone_name, "All Zone") AS zone_name
      , is_dfi 
      , user_w_session
  FROM user_with_session_agg 
),
*/

-- TRAFFIC ---
traffic_data AS (
  SELECT DISTINCT DATE(session_start_timestamp_local) AS report_date
      , session_start_timestamp_local
      , CASE WHEN EXTRACT(HOUR FROM session_start_timestamp_local) BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN EXTRACT(HOUR FROM session_start_timestamp_local) BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN EXTRACT(HOUR FROM session_start_timestamp_local) BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN EXTRACT(HOUR FROM session_start_timestamp_local) BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN EXTRACT(HOUR FROM session_start_timestamp_local) BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , customer_code
      , session_key
      , COALESCE(lg_zone_name, "Unavailable") AS zone_name
      , COALESCE(is_transaction, 0) AS is_transaction
      , has_order
      , total_orders
      , COALESCE(is_pickup_session, FALSE) AS is_pickup_session
      , COALESCE(is_restaurant_session, FALSE) AS is_restaurant_session
      , COALESCE(is_dmart_session, FALSE) AS is_dmart_session
      , COALESCE(is_shop_session, FALSE) AS is_shop_session
      , COALESCE(is_qcommerce_session, FALSE) AS is_qcommerce_session
      , COALESCE(has_restaurant_order, FALSE) AS has_restaurant_order
      , COALESCE(has_dmart_order, FALSE) AS has_dmart_order
      , COALESCE(has_shop_order, FALSE) AS has_shop_order
      , COALESCE(has_qcommerce_order, FALSE) AS has_qcommerce_order
      , LOGICAL_OR(COALESCE(delivery_type = 'pickup',FALSE)) AS has_pickup_order
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_sessions` s
  LEFT JOIN UNNEST(s.orders) so
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
    ON so.order_id = o.order_code
    AND s.global_entity_id = o.global_entity_id
    AND o.created_date_local >>= DATE("2024-01-01")
  WHERE s.global_entity_id = 'FP_SG'
    AND s.partition_date >>= DATE("2023-12-01")
    AND DATE(session_start_timestamp_utc) >>= DATE("2024-01-01")
  GROUP BY ALL
),

traffic_agg_vertical_zone AS (
  SELECT 'Platform' AS vertical
      , report_date
      , time_of_day
      , TRUE AS is_dfi
      , zone_name
      , COUNT(DISTINCT session_key) AS session_
      , COUNT(DISTINCT CASE WHEN is_transaction = 1 THEN session_key END) AS trx
      , COUNT(DISTINCT customer_code) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  SELECT 'Platform' AS vertical
      , report_date
      , 'All Time' AS time_of_day
      , TRUE AS is_dfi
      , zone_name
      , COUNT(DISTINCT session_key) AS session_
      , COUNT(DISTINCT CASE WHEN is_transaction = 1 THEN session_key END) AS trx
      , COUNT(DISTINCT customer_code) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  -- RESTAURANT 
  SELECT 'Food OD' AS vertical
      , report_date
      , time_of_day
      , FALSE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_restaurant_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_restaurant_session AND has_restaurant_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_restaurant_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  SELECT 'Food OD' AS vertical
      , report_date
      , 'All Time' AS time_of_day
      , FALSE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_restaurant_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_restaurant_session AND has_restaurant_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_restaurant_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  -- PICKUP
  SELECT 'PU' AS vertical
      , report_date
      , time_of_day
      , FALSE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_pickup_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_pickup_session AND has_pickup_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_pickup_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  SELECT 'PU' AS vertical
      , report_date
      , 'All Time' AS time_of_day
      , FALSE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_pickup_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_pickup_session AND has_pickup_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_pickup_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  -- QCOMMERCE
  SELECT 'QC' AS vertical
      , report_date
      , time_of_day
      , TRUE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_qcommerce_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_qcommerce_session AND has_qcommerce_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_qcommerce_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  SELECT 'QC' AS vertical
      , report_date
      , 'All Time' AS time_of_day
      , TRUE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_pickup_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_pickup_session AND has_pickup_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_qcommerce_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  -- DMART
  SELECT 'QC Mart' AS vertical
      , report_date
      , time_of_day
      , FALSE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_dmart_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_dmart_session AND has_dmart_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_dmart_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  SELECT 'QC Mart' AS vertical
      , report_date
      , 'All Time' AS time_of_day
      , FALSE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_dmart_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_dmart_session AND has_dmart_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_dmart_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  -- SHOPS
  SELECT 'Shops' AS vertical
      , report_date
      , time_of_day
      , TRUE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_shop_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_shop_session AND has_shop_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_shop_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL

  UNION DISTINCT 

  SELECT 'Shops' AS vertical
      , report_date
      , 'All Time' AS time_of_day
      , TRUE AS is_dfi
      , zone_name
      , COUNT(DISTINCT CASE WHEN is_shop_session THEN session_key END) AS session_
      , COUNT(DISTINCT CASE WHEN is_shop_session AND has_shop_order THEN session_key END) AS trx
      , COUNT(DISTINCT CASE WHEN is_shop_session THEN customer_code END) AS user_w_session
  FROM traffic_data
  GROUP BY ALL
),

traffic_agg AS (
  SELECT * 
  FROM traffic_agg_vertical_zone

  UNION DISTINCT 

  SELECT vertical
       , report_date
       , time_of_day 
       , is_dfi 
       , 'All Zone' AS zone_name
       , SUM(session_) AS session_ 
       , SUM(trx) AS trx 
       , SUM(user_w_session) AS user_w_session 
  FROM traffic_agg_vertical_zone 
  GROUP BY ALL
),

/*
resto_zone_time AS (
  -- by vertical, time, zone
  SELECT 'Food OD' AS vertical
      , session_start_date_local AS report_date
      , CASE WHEN hour_ BETWEEN 7 AND 10 THEN 'Breakfast (07:00 - 10:59)'
              WHEN hour_ BETWEEN 11 AND 13 THEN 'Lunch (11:00 - 13:59)'
              WHEN hour_ BETWEEN 14 AND 16 THEN 'Teabreak (14:00 - 16:59)'
              WHEN hour_ BETWEEN 17 AND 19 THEN 'Dinner (17:00 - 19:59)'
              WHEN hour_ BETWEEN 20 AND 23 THEN 'Supper (20:00 - 23:59)'
          ELSE 'Wee Hours (00:00 - 06:59)' END AS time_of_day
      , FALSE AS is_dfi
      , COALESCE(das_zone,"Unavailable") AS zone_name
