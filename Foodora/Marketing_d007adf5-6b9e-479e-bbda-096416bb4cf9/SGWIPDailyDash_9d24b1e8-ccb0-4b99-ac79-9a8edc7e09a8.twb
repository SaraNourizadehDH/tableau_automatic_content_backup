            <map to='#59a14f'>
              <bucket>&quot;QC&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;PU&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Shops&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Platform&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;QC Mart&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Food VD&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Calculation_540783813727703042:nk]&#10;[:Measure Names]' type='palette'>
            <map to='#4e79a7'>
              <multibucket>
                <bucket>&quot;Hide&quot;</bucket>
                <bucket>&quot;[federated.0brnlvg1imf9di121haje1ya76mq]&quot;</bucket>
              </multibucket>
            </map>
            <map to='#d5d5d5'>
              <multibucket>
                <bucket>&quot;Hide&quot;</bucket>
                <bucket>&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:m1 (copy)_540783813729320966:qk]&quot;</bucket>
              </multibucket>
            </map>
            <map to='#d5d5d5'>
              <multibucket>
                <bucket>&quot;Hide&quot;</bucket>
                <bucket>&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:m1 (copy)_540783813729320966:vtnone:qk]&quot;</bucket>
              </multibucket>
            </map>
            <map to='#e15759'>
              <multibucket>
                <bucket>&quot;Show&quot;</bucket>
                <bucket>&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:m1 (copy)_540783813729320966:qk]&quot;</bucket>
              </multibucket>
            </map>
            <map to='#e15759'>
              <multibucket>
                <bucket>&quot;Show&quot;</bucket>
                <bucket>&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:m1 (copy)_540783813729320966:vtnone:qk]&quot;</bucket>
              </multibucket>
            </map>
            <map to='#f28e2b'>
              <multibucket>
                <bucket>&quot;Show&quot;</bucket>
                <bucket>&quot;[federated.0brnlvg1imf9di121haje1ya76mq]&quot;</bucket>
