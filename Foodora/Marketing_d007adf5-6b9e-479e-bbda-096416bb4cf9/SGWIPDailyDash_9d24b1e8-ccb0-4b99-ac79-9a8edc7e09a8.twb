    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metrics Formula'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/SGWIPDailyDash/MetricsFormula?rev=' id='MetricsFormula' path='/t/Foodora/workbooks/SGWIPDailyDash' revision='' site='Foodora' />
      <style />
      <size maxheight='750' maxwidth='1600' minheight='750' minwidth='1600' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='92127' id='3' type-v2='text' w='61959' x='500' y='6806'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' underline='true'>FORMULA</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>GMV</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>GFV + DF + Service Fees + Container Charges + Difference to MOV; includes priority DF &amp; add-pro-to-cart values, after basket updates</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Daily valid orders</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>AFV</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>GFV/Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='7'>GFV: Gross Food / Shops or Dmarts SKUs, value of the order after basket updates</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>iCPGMV %</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Deal/Voucher funded by foodpanda over GMV</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Active Users</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Distinct count of users with valid order</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>DF Discount/Order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Delivery Fee discount funded by foodpanda over total valid orders</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>DF Paid by Customer/Order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Delivery fee paid by user per order, including delivery fee discount/voucher</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Sessions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>When users visit the app</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>CVR%</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Session with transaction over total sessions (1 session can have more than 1 order thus mapping CVR% * sessions vs orders will be different)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>User with Sessions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Number of user with sessions</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Shrink Orders %</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Number of valid orders affected by shrink over valid orders (an order can experience both surge &amp; shrink at the same time)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Surge Orders %</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Number of valid orders affected by surge over valid orders (an order can experience both surge &amp; shrink at the same time)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Surge Orders % exc. FD</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Number of valid orders affected by surge that don&apos;t have free delivery over valid orders (an order can experience both surge &amp; shrink at the same time)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>DT/Order (mins)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Total delivery time in minutes over valid orders (excluding pre-order)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Fail Rate %</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Number of failed orders over ALL orders (valid/invalid)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Fill Rate %</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Total shift filled vs opened </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Rider Hours</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Total hours worked by Riders</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
