      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0brnlvg1imf9di121haje1ya76mq].[sum:session_:qk]&quot;' value='Session' />
