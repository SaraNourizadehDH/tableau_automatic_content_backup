    <worksheet name='Daily View - Sheet'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Parameter 1]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Order' name='federated.0brnlvg1imf9di121haje1ya76mq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Measure Value' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sessions&quot;'>
              <calculation class='tableau' formula='&quot;Sessions&quot;' />
              <aliases>
                <alias key='&quot;fpf per GMV&quot;' value='fpf (voucher + disc + df) per GMV' />
                <alias key='&quot;iCPGMV \%&quot;' value='iCPGMV % (voucher + disc)' />
                <alias key='&quot;vf per GMV&quot;' value='vf (voucher + disc + df) per GMV' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0brnlvg1imf9di121haje1ya76mq'>
            <column caption='WTD?' datatype='boolean' name='[Calculation_395401983616577536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[ordered_at_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_395401983616790529]) AND &#10;DATE([ordered_at_date_local]) &lt;= DATE([Calculation_395401983616790529])' />
            </column>
            <column caption='latest_report_date' datatype='date' name='[Calculation_395401983616790529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED  : MAX([ordered_at_date_local])}' />
            </column>
            <column caption='dow' datatype='string' name='[Calculation_395401983617286149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;iso-weekday&apos;,[ordered_at_date_local])&#10;WHEN 1 THEN &apos;Monday&apos;&#10;WHEN 2 THEN &apos;Tuesday&apos;&#10;WHEN 3 THEN &apos;Wednesday&apos;&#10;WHEN 4 THEN &apos;Thursday&apos;&#10;WHEN 5 THEN &apos;Friday&apos;&#10;WHEN 6 THEN &apos;Saturday&apos;&#10;WHEN 7 THEN &apos;Sunday&apos;&#10;END' />
            </column>
            <column caption='measure_value_formatted' datatype='string' name='[Calculation_540783813725548545]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ABS([measure_value_zone (copy)_252412695894999068]) &gt;= 1000000 THEN&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068]/1000000, 1)) + &quot;M&quot;&#10;&#10;ELSEIF ABS([measure_value_zone (copy)_252412695894999068]) &gt;= 1000 THEN&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068]/1000, 1)) + &quot;K&quot;&#10;&#10;ELSEIF [measure_value_zone (copy)_252412695894999068] &lt; 1 AND [measure_value_zone (copy)_252412695894999068] &gt;= 0 THEN&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068] * 100, 1)) + &quot;%&quot;&#10;&#10;ELSE&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068], 2))&#10;END' />
            </column>
            <column caption='ph_tag' datatype='string' name='[Calculation_540783813727703042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [day_type] = &apos;Public Holiday&apos; THEN &apos;Show&apos; ELSE &apos;Hide&apos; END' />
            </column>
            <column caption='IF ISNULL([measure_value]) THEN NULL ELSE (ZN([measure_value]...' datatype='real' name='[Calculation_540783813737291813]' role='measure' type='quantitative' user:unnamed='Daily View (3)'>
              <calculation class='tableau' formula='IF ISNULL([measure_value_zone (copy)_252412695894999068]) THEN NULL ELSE (ZN([measure_value_zone (copy)_252412695894999068]) - LOOKUP(ZN([measure_value_zone (copy)_252412695894999068]), -1)) / ABS(LOOKUP(ZN([measure_value_zone (copy)_252412695894999068]), -1)) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='avg(-0.5)' datatype='real' name='[Calculation_540783813737615400]' role='measure' type='quantitative' user:unnamed='Daily View (3)'>
              <calculation class='tableau' formula='avg(-0.5)' />
            </column>
            <column caption='fp_incentive_cost' datatype='real' name='[Calculation_5583759864768630784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fp_deal_cost] + [fp_funded_voucher]&#10;- [fp_funded_voucher_excluded] &#10;- [pickup_revenue_reduction] &#10;- [corporate_revenue_reduction]&#10;//- IFNULL([dfi_funded_cost]/2,0)' />
            </column>
            <column caption='Year-Week' datatype='string' name='[Calculation_5583759864768995329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;iso-year&apos;, [ordered_at_date_local])) + &apos; - W&apos; + STR(DATEPART(&apos;iso-week&apos;, [ordered_at_date_local]))' />
            </column>
            <column aggregation='Sum' caption='Year' datatype='integer' name='[Calculation_5583759864769077250]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [ordered_at_date_local])' />
            </column>
            <column caption='Week' datatype='integer' name='[Calculation_5583759864769179651]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-week&apos;, [ordered_at_date_local])' />
            </column>
            <column caption='Start Date' datatype='date' name='[Calculation_5583759864769437700]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;, [ordered_at_date_local]))' />
            </column>
            <column caption='fpf' datatype='real' name='[Calculation_5583759864769929221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fp_deal_cost] + [fp_df_cost] + [fp_funded_voucher] + [pickup_revenue_reduction] + [corporate_revenue_reduction]' />
            </column>
            <column caption='vf' datatype='real' name='[Calculation_5583759864769990662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vf_deal_cost] + [vf_df_cost] + [vf_funded_voucher]' />
            </column>
            <column caption='fpf + vf' datatype='real' name='[Calculation_5583759864770043911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5583759864769929221] + [Calculation_5583759864769990662]' />
            </column>
            <column datatype='integer' name='[active_users]' role='measure' type='quantitative' />
            <column datatype='real' name='[corporate_revenue_reduction]' role='measure' type='quantitative' />
            <column datatype='string' name='[day_type]' role='dimension' type='nominal' />
            <column datatype='real' name='[delivery_fee]' role='measure' type='quantitative' />
            <column datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[filled_shift]' role='measure' type='quantitative' />
            <column datatype='real' name='[fp_deal_cost]' role='measure' type='quantitative' />
            <column datatype='real' name='[fp_df_cost]' role='measure' type='quantitative' />
            <column datatype='real' name='[fp_funded_voucher]' role='measure' type='quantitative' />
            <column datatype='real' name='[fp_funded_voucher_excluded]' role='measure' type='quantitative' />
            <column datatype='real' name='[gfv]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_dfi]' role='dimension' type='nominal' />
            <column-instance column='[ordered_at_date_local]' derivation='ISO-Week' name='[iwk:ordered_at_date_local:ok]' pivot='key' type='ordinal' />
            <column caption='ph_tag_circle' datatype='real' name='[m1 (copy)_540783813729320966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-0.1' />
            </column>
            <column caption='measure_value' datatype='real' name='[measure_value_zone (copy)_252412695894999068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;GMV&apos; THEN SUM([gmv]) &#10;WHEN &apos;Orders&apos; THEN SUM([orders])&#10;WHEN &apos;AFV&apos; THEN SUM([gfv])/SUM([orders])&#10;WHEN &apos;iCPGMV %&apos; THEN SUM([Calculation_5583759864768630784])/SUM([gmv]) //*100 // SUM([fp_deal_cost] + [fp_funded_voucher] + [fp_df_cost])/SUM([gmv])*100&#10;WHEN &apos;Active Users&apos; THEN SUM([active_users])&#10;WHEN &apos;fpf per GMV&apos; THEN SUM([Calculation_5583759864769929221])/SUM([gmv])&#10;WHEN &apos;vf per GMV&apos; THEN SUM([Calculation_5583759864769990662])/SUM([gmv])&#10;WHEN &apos;fpf + vf per GMV&apos; THEN SUM([Calculation_5583759864770043911])/SUM([gmv])&#10;&#10;&#10;WHEN &apos;DF Discount/Order&apos; THEN SUM([fp_df_cost])/SUM([orders])&#10;WHEN &apos;DF Paid by Customer/Order&apos; THEN SUM([delivery_fee])/SUM(orders)&#10;&#10;WHEN &apos;Sessions&apos; THEN SUM([session_])&#10;WHEN &apos;CVR %&apos; THEN SUM([trx])/SUM([session_]) //*100&#10;WHEN &apos;User with Sessions&apos; THEN SUM([user_w_session])&#10;&#10;WHEN &apos;Shrink Orders %&apos; THEN SUM([shrink_order])/SUM([orders]) //*100&#10;WHEN &apos;Surge Orders %&apos; THEN SUM([surged_order])/SUM([orders]) //*100&#10;WHEN &apos;Surge Orders % exc. FD&apos; THEN SUM([surged_order_non_fd])/SUM([orders])&#10;WHEN &apos;DT/Order (mins)&apos; THEN SUM([total_dt])/SUM([total_valid_non_po_orders])&#10;WHEN &apos;Fail Rate %&apos; THEN SUM([failed_orders])/SUM([total_orders]) //*100&#10;WHEN &apos;Fill Rate %&apos; THEN SUM([filled_shift])/SUM([total_shift]) //*100&#10;WHEN &apos;Rider Hours&apos; THEN SUM([rider_actual_hours])&#10;&#10;&#10;END' />
            </column>
            <column-instance column='[Calculation_395401983616577536]' derivation='None' name='[none:Calculation_395401983616577536:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_395401983617286149]' derivation='None' name='[none:Calculation_395401983617286149:nk]' pivot='key' type='nominal' />
