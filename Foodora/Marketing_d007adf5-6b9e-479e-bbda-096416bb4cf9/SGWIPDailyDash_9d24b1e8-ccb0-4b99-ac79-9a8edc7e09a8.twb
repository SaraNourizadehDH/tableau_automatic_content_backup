              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;GMV&apos; THEN SUM([gmv]) &#10;WHEN &apos;Orders&apos; THEN SUM([orders])&#10;WHEN &apos;AFV&apos; THEN SUM([gfv])/SUM([orders])&#10;WHEN &apos;iCPGMV %&apos; THEN SUM([Calculation_5583759864768630784])/SUM([gmv]) //*100 // SUM([fp_deal_cost] + [fp_funded_voucher] + [fp_df_cost])/SUM([gmv])*100&#10;WHEN &apos;Active Users&apos; THEN SUM([active_users])&#10;WHEN &apos;fpf per GMV&apos; THEN SUM([Calculation_5583759864769929221])/SUM([gmv])&#10;WHEN &apos;vf per GMV&apos; THEN SUM([Calculation_5583759864769990662])/SUM([gmv])&#10;WHEN &apos;fpf + vf per GMV&apos; THEN SUM([Calculation_5583759864770043911])/SUM([gmv])&#10;&#10;&#10;WHEN &apos;DF Discount/Order&apos; THEN SUM([fp_df_cost])/SUM([orders])&#10;WHEN &apos;DF Paid by Customer/Order&apos; THEN SUM([delivery_fee])/SUM(orders)&#10;&#10;WHEN &apos;Sessions&apos; THEN SUM([session_])&#10;WHEN &apos;CVR %&apos; THEN SUM([trx])/SUM([session_]) //*100&#10;WHEN &apos;User with Sessions&apos; THEN SUM([user_w_session])&#10;&#10;WHEN &apos;Shrink Orders %&apos; THEN SUM([shrink_order])/SUM([orders]) //*100&#10;WHEN &apos;Surge Orders %&apos; THEN SUM([surged_order])/SUM([orders]) //*100&#10;WHEN &apos;Surge Orders % exc. FD&apos; THEN SUM([surged_order_non_fd])/SUM([orders])&#10;WHEN &apos;DT/Order (mins)&apos; THEN SUM([total_dt])/SUM([total_valid_non_po_orders])&#10;WHEN &apos;Fail Rate %&apos; THEN SUM([failed_orders])/SUM([total_orders]) //*100&#10;WHEN &apos;Fill Rate %&apos; THEN SUM([filled_shift])/SUM([total_shift]) //*100&#10;WHEN &apos;Rider Hours&apos; THEN SUM([rider_actual_hours])&#10;&#10;&#10;END' />
            </column>
