    <worksheet name='Traffic - WoW 5'>
      <table>
        <view>
          <datasources>
            <datasource caption='Order' name='federated.0brnlvg1imf9di121haje1ya76mq' />
          </datasources>
          <datasource-dependencies datasource='federated.0brnlvg1imf9di121haje1ya76mq'>
            <column caption='Weekly Tag' datatype='string' name='[Calculation_117656550674993153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,0,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L3W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-3,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L4W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L5W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L6W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='WTD?' datatype='boolean' name='[Calculation_395401983616577536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[ordered_at_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_395401983616790529]) AND &#10;DATE([ordered_at_date_local]) &lt;= DATE([Calculation_395401983616790529])' />
            </column>
            <column caption='latest_report_date' datatype='date' name='[Calculation_395401983616790529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED  : MAX([ordered_at_date_local])}' />
            </column>
            <column caption='dow' datatype='string' name='[Calculation_395401983617286149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;iso-weekday&apos;,[ordered_at_date_local])&#10;WHEN 1 THEN &apos;Monday&apos;&#10;WHEN 2 THEN &apos;Tuesday&apos;&#10;WHEN 3 THEN &apos;Wednesday&apos;&#10;WHEN 4 THEN &apos;Thursday&apos;&#10;WHEN 5 THEN &apos;Friday&apos;&#10;WHEN 6 THEN &apos;Saturday&apos;&#10;WHEN 7 THEN &apos;Sunday&apos;&#10;END' />
            </column>
            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [trx] END)/SUM(IF [Weekly Ta...' datatype='real' name='[Calculation_5093008250000236570]' role='measure' type='quantitative' user:unnamed='Traffic - WoW 2'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [trx] END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [session_] END) - &#10;SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [trx] END)/SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [session_] END))*100' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [session_] END)/SUM(IF [Weekl...' datatype='real' name='[Calculation_5093008250000367645]' role='measure' type='quantitative' user:unnamed='Traffic - WoW 5'>
              <calculation class='tableau' formula='SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [session_] END)/SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [session_] END)-1' />
            </column>
            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [trx] END)/SUM(IF [Weekly Ta...' datatype='real' name='[Calculation_5093008250000408606]' role='measure' type='quantitative' user:unnamed='Traffic - WoW 5'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [trx] END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [session_] END) - &#10;SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [trx] END)/SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [session_] END))*100' />
            </column>
            <column caption='&apos;LW vs L5W&apos;' datatype='string' name='[Calculation_5093008250001080351]' role='dimension' type='nominal' user:unnamed='Traffic - WoW 5'>
