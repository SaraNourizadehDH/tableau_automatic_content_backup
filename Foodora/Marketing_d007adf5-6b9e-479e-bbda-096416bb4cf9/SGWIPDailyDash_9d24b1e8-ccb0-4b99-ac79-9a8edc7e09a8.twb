      <column caption='Weekly Tag' datatype='string' name='[Calculation_117656550674993153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,0,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L3W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-3,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L4W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L5W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Calculation_395401983616790529])) THEN &apos;L6W&apos;&#10;ELSE &apos;Exclude&apos; END' />
      </column>
      <column caption='measure_value_zone' datatype='real' name='[Calculation_117656550676766723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Measure Value (copy)_252412695894679579]&#10;WHEN &apos;GMV&apos; THEN SUM([gmv]) &#10;WHEN &apos;Orders&apos; THEN SUM([orders])&#10;WHEN &apos;AFV&apos; THEN SUM([gfv])/SUM([orders])&#10;WHEN &apos;iCPGMV %&apos; THEN SUM([fp_deal_cost] + [fp_funded_voucher] + [fp_df_cost])/SUM([gmv])*100&#10;WHEN &apos;DF Discount/Order&apos; THEN SUM([fp_df_cost])/SUM([orders])&#10;WHEN &apos;DF Paid by Customer/Order&apos; THEN SUM([delivery_fee])/SUM(orders)&#10;WHEN &apos;Sessions&apos; THEN SUM([session_])&#10;WHEN &apos;CVR %&apos; THEN SUM([trx])/SUM([session_])*100&#10;WHEN &apos;Active Users&apos; THEN SUM([active_users])&#10;END' />
      </column>
      <column caption='lw_value' datatype='real' name='[Calculation_252412695804747786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Current Week&apos;s Dynamic Measure Value&#10;CASE [Parameters].[Measure Value (copy)_252412695894679579]&#10;WHEN &apos;GMV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [gmv] END)&#10;WHEN &apos;Orders&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [orders] END)&#10;WHEN &apos;AFV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [gfv] END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [orders] END)&#10;WHEN &apos;Active Users&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [active_users] END)&#10;WHEN &apos;iCPGMV %&apos; THEN&#10;    SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN ([fp_deal_cost] + [fp_funded_voucher] + [fp_df_cost]) END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [gmv] END)*100&#10;WHEN &apos;DF Discount/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [fp_df_cost] END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [orders] END)&#10;WHEN &apos;DF Paid by Customer/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;LW&apos;  THEN [delivery_fee] END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [orders] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='WTD?' datatype='boolean' name='[Calculation_395401983616577536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[ordered_at_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_395401983616790529]) AND &#10;DATE([ordered_at_date_local]) &lt;= DATE([Calculation_395401983616790529])' />
      </column>
      <column caption='latest_report_date' datatype='date' name='[Calculation_395401983616790529]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED  : MAX([ordered_at_date_local])}' />
      </column>
      <column caption='dow' datatype='string' name='[Calculation_395401983617286149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATEPART(&apos;iso-weekday&apos;,[ordered_at_date_local])&#10;WHEN 1 THEN &apos;Monday&apos;&#10;WHEN 2 THEN &apos;Tuesday&apos;&#10;WHEN 3 THEN &apos;Wednesday&apos;&#10;WHEN 4 THEN &apos;Thursday&apos;&#10;WHEN 5 THEN &apos;Friday&apos;&#10;WHEN 6 THEN &apos;Saturday&apos;&#10;WHEN 7 THEN &apos;Sunday&apos;&#10;END' />
      </column>
      <column caption='MTD Tag' datatype='string' name='[Calculation_5093008249997254669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([ordered_at_date_local]) = YEAR(TODAY()) AND [WTD? (copy)_5093008249996742668] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
      </column>
      <column caption='LM Tag' datatype='boolean' name='[Calculation_5093008249999183892]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[ordered_at_date_local]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Calculation_395401983616790529])) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='measure_value_formatted' datatype='string' name='[Calculation_540783813725548545]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS([measure_value_zone (copy)_252412695894999068]) &gt;= 1000000 THEN&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068]/1000000, 1)) + &quot;M&quot;&#10;&#10;ELSEIF ABS([measure_value_zone (copy)_252412695894999068]) &gt;= 1000 THEN&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068]/1000, 1)) + &quot;K&quot;&#10;&#10;ELSEIF [measure_value_zone (copy)_252412695894999068] &lt; 1 AND [measure_value_zone (copy)_252412695894999068] &gt;= 0 THEN&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068] * 100, 1)) + &quot;%&quot;&#10;&#10;ELSE&#10;    STR(ROUND([measure_value_zone (copy)_252412695894999068], 2))&#10;END' />
      </column>
      <column caption='ph_tag' datatype='string' name='[Calculation_540783813727703042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [day_type] = &apos;Public Holiday&apos; THEN &apos;Show&apos; ELSE &apos;Hide&apos; END' />
      </column>
      <column caption='fp_incentive_cost' datatype='real' name='[Calculation_5583759864768630784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fp_deal_cost] + [fp_funded_voucher]&#10;- [fp_funded_voucher_excluded] &#10;- [pickup_revenue_reduction] &#10;- [corporate_revenue_reduction]&#10;//- IFNULL([dfi_funded_cost]/2,0)' />
      </column>
      <column caption='Year-Week' datatype='string' name='[Calculation_5583759864768995329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;iso-year&apos;, [ordered_at_date_local])) + &apos; - W&apos; + STR(DATEPART(&apos;iso-week&apos;, [ordered_at_date_local]))' />
      </column>
      <column aggregation='Sum' caption='Year' datatype='integer' name='[Calculation_5583759864769077250]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;year&apos;, [ordered_at_date_local])' />
      </column>
      <column caption='Week' datatype='integer' name='[Calculation_5583759864769179651]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-week&apos;, [ordered_at_date_local])' />
      </column>
      <column caption='Start Date' datatype='date' name='[Calculation_5583759864769437700]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;, [ordered_at_date_local]))' />
      </column>
      <column caption='fpf' datatype='real' name='[Calculation_5583759864769929221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fp_deal_cost] + [fp_df_cost] + [fp_funded_voucher] + [pickup_revenue_reduction] + [corporate_revenue_reduction]' />
      </column>
      <column caption='vf' datatype='real' name='[Calculation_5583759864769990662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vf_deal_cost] + [vf_df_cost] + [vf_funded_voucher]' />
      </column>
      <column caption='fpf + vf' datatype='real' name='[Calculation_5583759864770043911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5583759864769929221] + [Calculation_5583759864769990662]' />
      </column>
      <column caption='MTD?' datatype='boolean' name='[WTD? (copy)_5093008249996742668]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='( YEAR([ordered_at_date_local]) = YEAR([Calculation_395401983616790529]) - 1 AND &#10;  DAY([ordered_at_date_local]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Calculation_395401983616790529])) AND // ini yg first date&#10;  DAY([ordered_at_date_local]) &lt; DAY([Calculation_395401983616790529]) AND // ini yg end date&#10;  MONTH([ordered_at_date_local]) = MONTH([Calculation_395401983616790529]) ) OR &#10;( [ordered_at_date_local] &gt;= DATETRUNC(&apos;month&apos;,[Calculation_395401983616790529]) AND // ini yg first date&#10;  [ordered_at_date_local] &lt; [Calculation_395401983616790529])' />
      </column>
      <column caption='Monthly Tag' datatype='string' name='[Weekly Tag (copy)_5093008249995980810]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[ordered_at_date_local]) = DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,[Calculation_395401983616790529])) THEN &apos;CM&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[ordered_at_date_local]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Calculation_395401983616790529])) THEN &apos;LM&apos;&#10;ELSE &apos;Exclude&apos; END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_13AA57281D804C75805A76F6F62AC65B]' role='measure' type='quantitative' />
      <column datatype='integer' name='[active_users]' role='measure' type='quantitative' />
      <column datatype='string' name='[day_type]' role='dimension' type='nominal' />
      <column caption='l5w_value' datatype='real' name='[lw_value (copy)_252412695828176908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Current Week&apos;s Dynamic Measure Value&#10;CASE [Parameters].[Measure Value (copy)_252412695894679579]&#10;WHEN &apos;GMV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [gmv] END)&#10;WHEN &apos;Orders&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [orders] END)&#10;WHEN &apos;AFV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [gfv] END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [orders] END)&#10;WHEN &apos;Active Users&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [active_users] END)&#10;WHEN &apos;iCPGMV %&apos; THEN&#10;    SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN ([fp_deal_cost] + [fp_funded_voucher] + [fp_df_cost]) END)/SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [gmv] END)*100&#10;WHEN &apos;DF Discount/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [fp_df_cost] END)/SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [orders] END)&#10;WHEN &apos;DF Paid by Customer/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos;  THEN [delivery_fee] END)/SUM(IF [Calculation_117656550674993153] = &apos;L5W&apos; THEN [orders] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='cw_value' datatype='real' name='[lw_value (copy)_252412696871616563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Current Week&apos;s Dynamic Measure Value&#10;CASE [Parameters].[Measure Value (copy)_252412695894679579]&#10;WHEN &apos;GMV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [gmv] END)&#10;WHEN &apos;Orders&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [orders] END)&#10;WHEN &apos;AFV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [gfv] END)/SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [orders] END)&#10;WHEN &apos;Active Users&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [active_users] END)&#10;WHEN &apos;iCPGMV %&apos; THEN&#10;    SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN ([fp_deal_cost] + [fp_funded_voucher] + [fp_df_cost]) END)/SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [gmv] END)*100&#10;WHEN &apos;DF Discount/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [fp_df_cost] END)/SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [orders] END)&#10;WHEN &apos;DF Paid by Customer/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [delivery_fee] END)/SUM(IF [Calculation_117656550674993153] = &apos;CW&apos; THEN [orders] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='l2w_value' datatype='real' name='[lw_value (copy)_252412696901001302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Current Week&apos;s Dynamic Measure Value&#10;CASE [Parameters].[Measure Value (copy)_252412695894679579]&#10;WHEN &apos;GMV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [gmv] END)&#10;WHEN &apos;Orders&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [orders] END)&#10;WHEN &apos;AFV&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [gfv] END)/SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [orders] END)&#10;WHEN &apos;Active Users&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [active_users] END)&#10;WHEN &apos;iCPGMV %&apos; THEN&#10;    SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN ([fp_deal_cost] + [fp_funded_voucher] + [fp_df_cost]) END)/SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [gmv] END)*100&#10;WHEN &apos;DF Discount/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [fp_df_cost] END)/SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos; THEN [orders] END)&#10;WHEN &apos;DF Paid by Customer/Order&apos; THEN SUM(IF [Calculation_117656550674993153] = &apos;L2W&apos;  THEN [delivery_fee] END)/SUM(IF [Calculation_117656550674993153] = &apos;LW&apos; THEN [orders] END)&#10;ELSE NULL&#10;END' />
