              <relation connection='bigquery.0z5v2321a5f0o114xiq6w1rg4apm' name='Custom SQL Query' type='text'><![CDATA[WITH online_cost AS (
SELECT  
  cost_date_utc AS date_utc,
  global_entity_id,
  country_name AS country,
  channel,
  channel_subchannel, 
  UPPER(channel_grouping_dh) AS channel_grouping_dh,
  UPPER(sub_channel_dh) AS subchannel_dh,
  UPPER(objective_dh) AS objective_dh,
  CASE
    WHEN REGEXP_CONTAINS(cost_source, "applovin") THEN "applovin"
    WHEN REGEXP_CONTAINS(cost_source, "liftoff") THEN "liftoff"
    WHEN REGEXP_CONTAINS(cost_source, "huawei") THEN "huawei ads"
    WHEN REGEXP_CONTAINS(cost_source, "xiaomi") THEN "xiaomi ads"
    WHEN REGEXP_CONTAINS(cost_source, "line") THEN "line ads"
    WHEN REGEXP_CONTAINS(LOWER(cost_source),  "rtb") THEN "rtb house"
    ELSE cost_source 
  END AS cost_source, 
  CASE 
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_and_") THEN "android"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_ios_") THEN "ios"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_web_") THEN "web"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_mix_") THEN "mix"
      ELSE LOWER(platform)
  END AS platform,
  campaign,
  SUM(cost_eur) AS cost_eur,
  SUM(impressions) AS impressions, 
  SUM(clicks) AS clicks
FROM `fulfillment-dwh-production.pandata_report.marketing__channel_online_cost` 
WHERE cost_date_utc BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR) AND  DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY) 
  AND channel IN ("APP", "DISPLAY", "PAIDSOCIAL", "SEM")
  AND channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "DISPLAY_BRA", "DISPLAY_RMO", "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "SEM_RMO")
  AND cost_source NOT IN ("dv360-non-youtube", "dv360-with-youtube")
GROUP BY ALL

UNION ALL
SELECT
  conversion_date,
  global_entity_id,
  country_name AS country,
  "AFFILIATE" AS channel,
  "AFFILIATE" AS channel_subchannel,
  "AFFILIATE" AS channel_grouping_dh,
  "AFFILIATE" AS subchannel_dh,
  "REACH" AS objective_dh,
  IF(publisher_name = "shopbackapac", publisher_name, "affiliate") AS cost_source,
  platform,
  IF(publisher_name = "shopbackapac", "aff_aff_mix_eat_ma_displayshopbackapac",  "aff_aff_mix_eat_ma_displayothers") AS campaign,
  SUM(cost_eur) AS cost_eur,
  0 AS impressions,
  0 AS clicks
FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_clarisights_affiliate_cost` 
WHERE conversion_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR) AND  DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY) 
  AND global_entity_id NOT IN ("FP_TH")
GROUP BY ALL
),

bima_installs AS (
SELECT 
  cs.order_date AS date_utc,
  cs.global_entity_id,
  shared_countries.name AS country,
  dti.channel,
  dti.channel_subchannel,
  IF(dti.channel_subchannel = "AFFILIATE", dti.channel_subchannel, dti.channel_grouping_dh) AS channel_grouping_dh,
  IF(dti.channel_subchannel = "AFFILIATE", dti.channel_subchannel, dti.subchannel_dh) AS subchannel_dh,
  IF(dti.channel_subchannel = "AFFILIATE", "REACH", dti.objective_dh) AS objective_dh,
  CASE
    WHEN REGEXP_CONTAINS(LOWER(dti.source), r"apple") THEN "apple"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), r"adwords|google") THEN "adwords"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), r"applovin") THEN "applovin"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "shareit") THEN "shareit"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "liftoff") THEN "liftoff"
    WHEN REGEXP_CONTAINS(LOWER(dti.source),  "rtb") THEN "rtb house"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "huawei") THEN "huawei ads"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "xiaomi") THEN "xiaomi ads"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "line") THEN "line ads"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), r"facebook|instagram") THEN "facebook"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "tiktok") THEN "tiktok"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "twitter") THEN "twitter"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "snapchat") THEN "snapchat"
    WHEN REGEXP_CONTAINS(LOWER(dti.source), "clicksmob") THEN "mobisummer"
    WHEN REGEXP_CONTAINS(LOWER(dti.campaign), "shopback") THEN "shopbackapac"
    WHEN dti.channel_subchannel = "AFFILIATE" THEN "affiliate"
    ELSE LOWER(dti.source) END AS cost_source, 
    CASE 
        WHEN dti.channel_subchannel = "AFFILIATE" AND  REGEXP_CONTAINS(LOWER(dti.campaign), "shopback") THEN "aff_aff_mix_eat_ma_displayshopbackapac"
        WHEN dti.channel_subchannel = "AFFILIATE" AND  NOT REGEXP_CONTAINS(LOWER(dti.campaign), "shopback") THEN "aff_aff_mix_eat_ma_displayothers"
        WHEN dti.channel_subchannel  IN ("APP_REACH", "APP_RMA") AND REGEXP_CONTAINS(LOWER(dti.source),  "rtb") 
        THEN TRIM(REGEXP_REPLACE(dti.campaign, '_[^_]*$', ''))
        ELSE TRIM(REGEXP_REPLACE(dti.campaign, r'\([^)]+\)', ''))
    END AS campaign,
  CASE 
      WHEN dti.channel_subchannel = "AFFILIATE" THEN cs.platform
      WHEN REGEXP_CONTAINS(LOWER(dti.campaign), r"_and_") THEN "android"
      WHEN REGEXP_CONTAINS(LOWER(dti.campaign), r"_ios_") THEN "ios"
      WHEN REGEXP_CONTAINS(LOWER(dti.campaign), r"_web_") THEN "web"
      WHEN REGEXP_CONTAINS(LOWER(dti.campaign), r"_mix_") THEN "mix"
      ELSE cs.platform
  END AS platform,
  SUM(cs.installs) AS installs
FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_attribution_l3_adjust_raw` AS cs
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__bima_dim_tracking_information` AS dti
       ON cs.tracking_information_id = dti.mkt_tech_tracking_information_id
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON shared_countries.global_entity_id = cs.global_entity_id
       AND shared_countries.platform = "Pandora"
       AND shared_countries.is_reporting_enabled
WHERE cs.order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR) AND  DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
AND dti.channel IN ("AFFILIATE", "APP", "DISPLAY", "PAIDSOCIAL", "SEM")
AND dti.channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "DISPLAY_BRA", "DISPLAY_RMO", "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "SEM_RMO")
AND cs.platform NOT IN ("others")
GROUP BY ALL
),

bima_marketing_orders AS (
SELECT
  order_date,
  CASE
    WHEN REGEXP_CONTAINS(channel_subchannel, "SEM") THEN global_entity_id 
   WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_bd\\_|\\[bd\\_|\\(bd\\_|bd\\_smallsmartbanner|\\[bd\\_smallsmartbanner|\\(bd\\_smallsmartbanner|bd\\_email|\\(bd\\_email|\\[bd\\_email")
      THEN "FP_BD"
      WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_hk\\_|\\[hk\\_|\\(hk\\_|hk\\_smallsmartbanner|\\[hk\\_smallsmartbanner|\\(hk\\_smallsmartbanner|hk\\_email|\\(hk\\_email|\\[hk\\_email")
      THEN "FP_HK"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_kh\\_|\\[kh\\_|\\(kh\\_|kh\\_email|\\(kh\\_email|\\[kh\\_email") THEN "FP_KH"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_la\\_|\\[la\\_|\\(la\\_|la\\_email|\\(la\\_email|\\[la\\_email") THEN "FP_LA"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_mm\\_|\\[mm\\_|\\(mm\\_|mm\\_email|\\(mm\\_email|\\[mm\\_email") THEN "FP_MM"
      WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_my\\_|\\[my\\_|\\(my\\_|my\\_smallsmartbanner|\\[my\\_smallsmartbanner|\\(my\\_smallsmartbanner|my\\_email|\\(my\\_email|\\[my\\_email")
      THEN "FP_MY"
      WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_ph\\_|\\[ph\\_|\\(ph\\_|ph\\_smallsmartbanner|\\[ph\\_smallsmartbanner|\\(ph\\_smallsmartbanner|ph\\_email|\\(ph\\_email|\\[ph\\_email")
      THEN "FP_PH"
      WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_pk\\_|\\[pk\\_|\\(pk\\_|pk\\_smallsmartbanner|\\[pk\\_smallsmartbanner|\\(pk\\_smallsmartbanner|pk\\_email|\\(pk\\_email|\\[pk\\_email")
      THEN "FP_PK"
      WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_sg\\_|\\[sg\\_|\\(sg\\_|sg\\_smallsmartbanner|\\[sg\\_smallsmartbanner|\\(sg\\_smallsmartbanner|sg\\_email|\\(sg\\_email|\\[pk\\_email")
      THEN "FP_SG"
      WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_th\\_|\\[th\\_|\\(th\\_|th\\_smallsmartbanner|\\[th\\_smallsmartbanner|\\(th\\_smallsmartbanner|th\\_email|\\(th\\_email|\\[th\\_email")
      THEN "FP_TH"
      WHEN REGEXP_CONTAINS(LOWER(campaign),
      "\\_tw\\_|\\[tw\\_|\\(tw\\_|tw\\_smallsmartbanner|\\[tw\\_smallsmartbanner|\\(tw\\_smallsmartbanner|tw\\_email|\\(tw\\_email|\\[tw\\_email")
      THEN "FP_TW"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_at\\_|\\[at\\_|\\(at\\_|\\-at|\\_at$") THEN "MJM_AT"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_cz\\_|\\[cz\\_|\\(cz\\_|\\-cz|\\_cz$") THEN "DJ_CZ"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_fi\\_|\\[fi\\_|\\(fi\\_|\\-fi|\\_fi$") THEN "PO_FI"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_hu\\_|\\[hu\\_|\\(hu\\_|\\-hu|\\_hu$") THEN "NP_HU"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_no\\_|\\[no\\_|\\(no\\_|\\-no|\\_no$") THEN "FO_NO"
      WHEN REGEXP_CONTAINS(LOWER(campaign), "\\_se\\_|\\[se\\_|\\(se\\_|\\-se|\\_se$") THEN "OP_SE"
      ELSE global_entity_id
  END AS global_entity_id,
  channel_subchannel,
  IF(channel_subchannel = "AFFILIATE",channel_subchannel, channel_grouping_dh) AS channel_grouping_dh,
  IF(channel_subchannel = "AFFILIATE",channel_subchannel, subchannel_dh) AS subchannel_dh,
  IF(channel_subchannel = "AFFILIATE", "REACH", objective_dh) AS objective_dh,
  source,
  campaign,
  platform_type,
  platform,
   ROUND(SUM(reacquisitions_calibration_ios14fix)) AS reacquisitions,
   ROUND(SUM(acquisitions_calibration_ios14fix)) AS acquisitions_calibration_ios14fix
FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders` 
GROUP BY ALL
),

bima_orders AS (
SELECT           
   marketing_orders.order_date AS date_utc,
    marketing_orders.global_entity_id,
    shared_countries.name AS country,
    CASE
      WHEN SAFE_CAST(REGEXP_EXTRACT(marketing_orders.campaign, r"\((\d{8,})\)$" ) AS STRING) IN ("11816056074", "18582254328", "19470876647") 
      AND marketing_orders.order_date <<= "2024-02-04" THEN "SEM"
      WHEN marketing_orders.channel_subchannel = "BRAND_SEM" THEN "SEM"
      WHEN marketing_orders.channel_subchannel = "BRAND_SEO" THEN "SEO"
      WHEN marketing_orders.source IN ("Huawei Preinstalls", "Samsung Preinstall", "Vivo Preinstall", "Xiaomi Preinstall Campaign") THEN "PREINSTALL_PARTNERSHIPS"
      WHEN marketing_orders.channel_subchannel = "COOP" THEN "FLYERS"
      WHEN REGEXP_CONTAINS(marketing_orders.channel_subchannel, r"SOCIALMEDIA") THEN "INFLUENCERMARKETING"
      WHEN marketing_orders.channel_subchannel = "WOM_RAF" THEN "BRAND"
      WHEN marketing_orders.channel_subchannel = "UNTRACKED" THEN "OTHER"
      ELSE UPPER(SPLIT(marketing_orders.channel_subchannel, "_")[SAFE_OFFSET(0)])
    END AS channel,
  CASE
    WHEN SAFE_CAST(REGEXP_EXTRACT(marketing_orders.campaign, r"\((\d{8,})\)$" ) AS STRING) IN ("11816056074", "18582254328", "19470876647") 
    AND marketing_orders.order_date <<= "2024-02-04" THEN "SEM_GENERIC"
    WHEN marketing_orders.channel_subchannel = "BRAND_SEM" THEN "SEM_BRA"
    ELSE UPPER(marketing_orders.channel_subchannel)
  END AS channel_subchannel,
  marketing_orders.channel_grouping_dh,
  marketing_orders.subchannel_dh,
  marketing_orders.objective_dh,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), r"apple") THEN "apple"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source),r"adwords|google") THEN "adwords"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source),r"applovin") THEN "applovin"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "shareit") THEN "shareit"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source),"liftoff") THEN "liftoff"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "rtb") THEN "rtb house"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "huawei") THEN "huawei ads"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "xiaomi") THEN "xiaomi ads"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "line") THEN "line ads"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), r"facebook|instagram") THEN "facebook"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "tiktok") THEN "tiktok"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "twitter") THEN "twitter"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "snapchat") THEN "snapchat"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.source), "clicksmob") THEN "mobisummer"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.campaign), "shopback") THEN "shopbackapac"
      WHEN marketing_orders.channel_subchannel = "AFFILIATE" THEN "affiliate"
      ELSE LOWER(marketing_orders.source) 
    END AS cost_source,
    platform_type,
    CASE 
      WHEN channel_subchannel = "AFFILIATE" AND LOWER(marketing_orders.platform) IN ("android", "ios") THEN LOWER(marketing_orders.platform)
      WHEN channel_subchannel = "AFFILIATE" AND LOWER(marketing_orders.platform) NOT IN ("android", "ios") THEN "web"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.campaign), r"_and_") THEN "android"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.campaign), r"_ios_") THEN "ios"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.campaign), r"_web_") THEN "web"
      WHEN LOWER(marketing_orders.platform) = "mobile web" THEN "web"
      WHEN REGEXP_CONTAINS(LOWER(marketing_orders.campaign), r"_mix_") THEN "mix"
      ELSE LOWER(marketing_orders.platform)
  END AS platform,
  CASE 
    WHEN channel_subchannel = "AFFILIATE" AND REGEXP_CONTAINS(LOWER(marketing_orders.campaign), "shopback") THEN "aff_aff_mix_eat_ma_displayshopbackapac"
    WHEN channel_subchannel = "AFFILIATE" AND  NOT REGEXP_CONTAINS(LOWER(marketing_orders.campaign), "shopback") THEN "aff_aff_mix_eat_ma_displayothers"
    WHEN channel_subchannel  IN ("APP_REACH", "APP_RMA") AND REGEXP_CONTAINS(LOWER(marketing_orders.source),  "rtb") 
    THEN TRIM(REGEXP_REPLACE(marketing_orders.campaign, '_[^_]*$', ''))
    ELSE TRIM(REGEXP_REPLACE(marketing_orders.campaign, r'\([^)]+\)', ''))
    END AS campaign,
   ROUND(SUM(reacquisitions)) as reacquisitions,
   ROUND(SUM(acquisitions_calibration_ios14fix)) as acquisitions_calibration_ios14fix
FROM bima_marketing_orders AS marketing_orders
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON shared_countries.global_entity_id = marketing_orders.global_entity_id
       AND shared_countries.platform = "Pandora"
       AND shared_countries.is_reporting_enabled
WHERE marketing_orders.order_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR) AND DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND NOT REGEXP_CONTAINS(marketing_orders.channel_subchannel, r"APPDIRECT|EXTENDEDREACH")
  AND NOT REGEXP_CONTAINS(LOWER(marketing_orders.campaign), r"corporate|ssu|_rider_|_rid_")
GROUP BY ALL
HAVING (reacquisitions >> 0 OR acquisitions_calibration_ios14fix >> 0) 
),


all_data AS (
SELECT  
 date_utc,
 global_entity_id,
 country,
 channel,
 channel_subchannel,
 channel_grouping_dh,
 subchannel_dh,
 objective_dh,
 cost_source,
 platform,
 campaign,
 cost_eur,
 impressions,
 clicks,
 NULL AS installs,  
 NULL AS reacquisitions,
 NULL AS acquisitions_calibration_ios14fix 
FROM online_cost

UNION ALL
SELECT  
 date_utc,
 global_entity_id,
 country,
 channel,
 channel_subchannel,
 channel_grouping_dh,
 subchannel_dh,
 objective_dh,
 cost_source, 
 platform,
 campaign, 
 NULL AS cost_eur,
 NULL AS impressions,
 NULL AS clicks,
 installs,  
 NULL AS reacquisitions,
 NULL AS acquisitions_calibration_ios14fix 
FROM bima_installs

UNION ALL
SELECT  
 date_utc,
 global_entity_id,
 country,
 channel,
 channel_subchannel, 
 channel_grouping_dh,
 subchannel_dh,
 objective_dh,
 cost_source,
 platform,
 campaign,
 NULL AS cost_eur,
 NULL AS impressions,
 NULL AS clicks,
 NULL AS installs,  
 reacquisitions,
 acquisitions_calibration_ios14fix 
FROM bima_orders
),

pandora_pm_cost AS (
SELECT
  date_utc,
  country,
  channel,
  cost_source,
  SUM(cost_eur) AS cost_eur
FROM all_data
GROUP BY ALL
HAVING cost_eur >> 0 
)

SELECT 
  all_data.date_utc,
  IF(all_data.global_entity_id NOT IN ("DJ_CZ", "FO_NO", "MJM_AT", "NP_HU", "OP_SE", "PO_FI", "YS_TR"), "APAC", "EU") AS region,
  all_data.country,
  CASE
    WHEN all_data.channel_subchannel = "AFFILIATE" THEN "Affiliate"
    WHEN all_data.channel_subchannel = "SEM_BRA" THEN "SEM (Brand)"
    WHEN all_data.channel = "SEM" AND all_data.channel_subchannel NOT IN ("SEM_BRA") THEN "SEM non-brand"
    WHEN all_data.channel = "APP" THEN "App Marketing"
    WHEN all_data.channel = "DISPLAY" THEN "Display"
    WHEN all_data.channel = "PAIDSOCIAL" THEN "Paid Social"
    ELSE all_data.channel
  END AS marketing_channel,
  CASE
    WHEN all_data.channel_subchannel = "SEM_BRA" THEN "Brand"
    WHEN all_data.channel_subchannel = "AFFILIATE" THEN "Affiliate"
    WHEN UPPER(SPLIT(all_data.channel_subchannel, "_")[SAFE_OFFSET(1)]) = "RMA" THEN "RMA"
    ELSE INITCAP(SPLIT(all_data.channel_subchannel, "_")[SAFE_OFFSET(1)])
  END AS subchannel,
  all_data.cost_source AS channel,
  all_data.channel_grouping_dh,
  all_data.subchannel_dh,
  all_data.objective_dh,
  platform,
  campaign,
  SUM(all_data.impressions) AS impressions,
  SUM(all_data.clicks) AS clicks,
  SUM(all_data.cost_eur) AS cost_eur,
  SUM(all_data.installs) AS installs,
  SUM(all_data.acquisitions_calibration_ios14fix) AS acquisitions_l2,
  SUM(all_data.reacquisitions) AS reacquisitions
  FROM all_data
  INNER JOIN pandora_pm_cost
          ON all_data.date_utc = pandora_pm_cost.date_utc
         AND all_data.country = pandora_pm_cost.country
         AND all_data.channel = pandora_pm_cost.channel
         AND all_data.cost_source = pandora_pm_cost.cost_source
 WHERE all_data.date_utc BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR) AND DATE_SUB(CURRENT_DATE, INTERVAL 2 DAY)
  AND all_data.channel IN ("AFFILIATE", "APP", "DISPLAY", "PAIDSOCIAL", "SEM")
  AND all_data.channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "DISPLAY_BRA", "DISPLAY_RMO", "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "SEM_RMO")
  AND (all_data.cost_eur >> 0 OR all_data.installs >> 0 OR all_data.acquisitions_calibration_ios14fix >> 0 OR all_data.reacquisitions >> 0)
  AND all_data.cost_source IS NOT NULL
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.18wit191j7yllp1h8c9zh1nfhb0v'>
      <datasources>
        <datasource caption='Topline Performance' name='federated.18wit191j7yllp1h8c9zh1nfhb0v' />
      </datasources>
      <datasource-dependencies datasource='federated.18wit191j7yllp1h8c9zh1nfhb0v' />
      <filter class='categorical' column='[federated.18wit191j7yllp1h8c9zh1nfhb0v].[Pandora User Filter1]' context='true' />
    </shared-view>
    <shared-view name='federated.1xqi9pk1e54d8x11e4vxi0frm5tk'>
      <datasources>
        <datasource caption='Reach/RMA Campaign' name='federated.1xqi9pk1e54d8x11e4vxi0frm5tk' />
      </datasources>
      <datasource-dependencies datasource='federated.1xqi9pk1e54d8x11e4vxi0frm5tk' />
      <filter class='categorical' column='[federated.1xqi9pk1e54d8x11e4vxi0frm5tk].[Pandora User Filter 1]' context='true' />
    </shared-view>
  </shared-views>
  <actions>
    <action caption='Highlight 1 (generated)' name='[Action1_D1A78DED93B943AB997326B1537C8194]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Detailed Campaign (Reach/RMA)' type='sheet' />
      <command command='tsc:brush'>
        <param name='field-captions' value='Dimension4' />
        <param name='target' value='Detailed Campaign (Reach/RMA)' />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name='Detailed Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Topline Performance' name='federated.18wit191j7yllp1h8c9zh1nfhb0v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18wit191j7yllp1h8c9zh1nfhb0v'>
            <column caption='BLANK1' datatype='integer' name='[BLANK (copy)_1310477184221478914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='BLANK' datatype='integer' name='[Calculation_1310477184221007873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='-&gt; existing customer' datatype='real' name='[Calculation_1310477184221822979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentives_cost]) - SUM([nc_incentives]) - SUM([reacquisitions_incentives])' />
            </column>
            <column caption='flgpo' datatype='real' name='[Calculation_1310477184223342596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([flgp_eur])/sum([orders])' />
            </column>
            <column caption='-&gt; non-pm installs' datatype='integer' name='[Calculation_1310477184223899653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([installs]) - SUM([pm_installs])' />
            </column>
            <column caption='-&gt; non-pm acquisitions' datatype='real' name='[Calculation_1310477184224239622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) - sum([pm_acquisitions])' />
            </column>
            <column caption='DH iCPGMV' datatype='real' name='[Calculation_1310477184224796679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentive_cost_dh])/SUM([gmv_eur])' />
            </column>
            <column caption='-&gt; non-pm reacquisitions' datatype='real' name='[Calculation_1310477184225251336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reacquisitions]) - SUM([pm_reacquisitions])' />
            </column>
            <column caption='Period' datatype='string' name='[Calculation_2306405972509880320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN STR([order_date_utc])&#10;When &apos;Weekly&apos; then STR(DATE(DATETRUNC(&apos;iso-week&apos;, [order_date_utc])))&#10;When &apos;Monthly&apos; then STR(YEAR([order_date_utc])) + &apos;-&apos; +  RIGHT(&apos;0&apos; + STR(MONTH([order_date_utc])), 2)&#10;When &apos;Quarterly&apos; then  STR(DATEPART(&apos;year&apos;, [order_date_utc])) + &apos;-Q&apos; + STR(DATEPART(&apos;quarter&apos;, [order_date_utc]))&#10;When &apos;Yearly&apos; then STR(DATEPART(&apos;year&apos;, [order_date_utc])) &#10;&#10;&#10;end' />
            </column>
            <column caption='-&gt; pm installs share' datatype='real' name='[Calculation_6684045596196171776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pm_installs])/sum([installs])' />
            </column>
            <column caption='-&gt;pm acq share' datatype='real' name='[Calculation_6684045596196384769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pm_acquisitions])/sum([acquisitions])' />
            </column>
            <column caption='-&gt; pm reacq share' datatype='real' name='[Calculation_6684045596196782082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pm_reacquisitions])/SUM([reacquisitions])' />
            </column>
