          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xqi9pk1e54d8x11e4vxi0frm5tk'>
            <column caption='CPAR' datatype='real' name='[CPA (copy)_213358065447018496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/(SUM([acquisitions_l2]) + SUM([reacquisitions]))' />
            </column>
            <column caption='Period' datatype='string' name='[Calculation_5736037835035627520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;&#10;&#10;WHEN &apos;Daily&apos; THEN STR([date_utc])&#10;When &apos;Weekly&apos; then STR(DATE(DATETRUNC(&apos;iso-week&apos;, [date_utc])))&#10;When &apos;Monthly&apos; then STR(YEAR([date_utc])) + &apos;-&apos; +  RIGHT(&apos;0&apos; + STR(MONTH([date_utc])), 2)&#10;When &apos;Quarterly&apos; then  STR(DATEPART(&apos;year&apos;, [date_utc])) + &apos;-Q&apos; + STR(DATEPART(&apos;quarter&apos;, [date_utc]))&#10;&#10;end' />
            </column>
            <column caption='Dimension1' datatype='string' name='[Calculation_5736037835037503490]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#10;&#10;When &apos;Country&apos; then [country]&#10;&#10;When &apos;Marketing Channel&apos; then [marketing_channel]&#10;&#10;When &apos;Channel&apos; then [channel]&#10;&#10;When &apos;Subchannel&apos; then [subchannel]&#10;&#10;When &apos;Channel Grouping DH&apos; then [channel_grouping_dh]&#10;&#10;When &apos;Subchannel DH&apos; then [subchannel_dh]&#10;&#10;When &apos;Objective DH&apos; then [objective_dh]&#10;&#10;When &apos;Platform&apos; then [platform]&#10;&#10;When &apos;Campaign&apos; then [campaign]&#10;&#10;end' />
            </column>
            <column caption='CPA' datatype='real' name='[Calculation_5736037835039535111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/SUM([acquisitions_l2])' />
            </column>
            <column caption='Dimension2' datatype='string' name='[Dimension1 (copy)_5736037835038658564]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Dimension1 (copy)_5736037835038613507]&#10;&#10;When &apos;Country&apos; then [country]&#10;&#10;When &apos;Marketing Channel&apos; then [marketing_channel]&#10;&#10;When &apos;Channel&apos; then [channel]&#10;&#10;When &apos;Subchannel&apos; then [subchannel]&#10;&#10;When &apos;Channel Grouping DH&apos; then [channel_grouping_dh]&#10;&#10;When &apos;Subchannel DH&apos; then [subchannel_dh]&#10;&#10;When &apos;Objective DH&apos; then [objective_dh]&#10;&#10;When &apos;Platform&apos; then [platform]&#10;&#10;When &apos;Campaign&apos; then [campaign]&#10;&#10;end' />
