    <worksheet name='PA order table'>
      <table>
        <view>
          <datasources>
            <datasource caption='DBS yuu MOM' name='federated.0om9ro80co93kn13a9ffx1xrgt9o' />
          </datasources>
          <datasource-dependencies datasource='federated.0om9ro80co93kn13a9ffx1xrgt9o'>
            <column caption='SUM(IF [data_tag] = &apos;All&apos; THEN [orders] END)' datatype='integer' name='[Calculation_1171569287747608644]' role='measure' type='quantitative' user:unnamed='order table'>
              <calculation class='tableau' formula='SUM(IF [data_tag] = &apos;All&apos; THEN [orders] END)' />
            </column>
            <column caption='SUM(IF [data_tag] = &apos;Yuu&apos; THEN [orders] END)/SUM(IF [data_tag...' datatype='real' name='[Calculation_1171569287747653701]' role='measure' type='quantitative' user:unnamed='order table'>
              <calculation class='tableau' formula='SUM(IF [data_tag] = &apos;Yuu&apos; THEN [orders] END)/SUM(IF [data_tag] = &apos;All&apos; THEN [orders] END)' />
            </column>
            <column caption='SUM(IF [data_tag] = &apos;PAssion&apos; THEN [orders] END)' datatype='integer' name='[Calculation_3968656467331788825]' role='measure' type='quantitative' user:unnamed='PA order table'>
              <calculation class='tableau' formula='SUM(IF [data_tag] = &apos;PAssion&apos; THEN [orders] END)' />
            </column>
            <column caption='SUM(IF [data_tag] = &apos;PAssion&apos; THEN [orders] END)/SUM(IF [data...' datatype='real' name='[Calculation_3968656467331829786]' role='measure' type='quantitative' user:unnamed='PA order table'>
