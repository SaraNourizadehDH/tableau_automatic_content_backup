              <calculation class='tableau' formula='//{ FIXED [Customer Name], [Order Date] : MIN(&#10;//IF [Order Date] = { EXCLUDE [Order Date] : MIN([Order Date])}&#10;//THEN 1 ELSE 0 END) }&#10;&#10;{ FIXED [pd_customer_uuid], [month_], [card_type] : MIN( IF [month_] = { EXCLUDE [month_] : MIN([month_])} THEN 1 ELSE 0 END )}' />
            </column>
            <column caption='Card Holders Cumulative' datatype='integer' name='[Calculation_1521794491261071393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1521794491260657696]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='linked yuu cumulative' datatype='integer' name='[Calculation_2095510862552203265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//RUNNING_SUM(SUM([dbs linked first month]))&#10;RUNNING_SUM(SUM(IF [su_yuu] THEN [Calculation_1521794491260657696] END))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='[linked yuu cumulative]/[Card Holders Cumulative]' datatype='real' name='[Calculation_2095510862552391682]' role='measure' type='quantitative' user:unnamed='Sheet 12 (2)'>
