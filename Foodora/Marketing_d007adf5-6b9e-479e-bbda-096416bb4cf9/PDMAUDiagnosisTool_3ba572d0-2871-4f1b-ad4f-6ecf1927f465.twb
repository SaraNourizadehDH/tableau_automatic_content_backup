        <datasource caption='retention_segment_view (bi_marketing)' name='federated.0mtod9u0uf3opb1clawsj0czabja' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='No of Months' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='13'>
          <calculation class='tableau' formula='13' />
          <range min='1' />
        </column>
        <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0mtod9u0uf3opb1clawsj0czabja].[Calculation_3504082047655137282]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0mtod9u0uf3opb1clawsj0czabja].[current_month]' caption='Current Month' datatype='date' default-format='*mmm YY' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
          <calculation class='tableau' formula='#2025-07-01#' />
        </column>
        <column caption='PRO Granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Aggregated&quot;'>
          <calculation class='tableau' formula='&quot;Aggregated&quot;' />
          <members>
            <member value='&quot;Aggregated&quot;' />
            <member value='&quot;Detailed&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0mtod9u0uf3opb1clawsj0czabja'>
        <column caption='Lifecycle Segment ' datatype='string' name='[Calculation_212513670706089984]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([lifecycle_segment], &quot;prospect&quot;) THEN &quot;Prospect&quot;&#10;ELSE [lifecycle_segment]&#10;END' />
          <aliases>
            <alias key='%null%' value='No Segment' />
          </aliases>
        </column>
        <column caption='Pro Segment ' datatype='string' name='[Calculation_3504082047747584004]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Aggregated&quot; THEN [pro_segment]&#10;WHEN &quot;Detailed&quot; THEN [pro_segment_detailed]&#10;END' />
        </column>
        <column datatype='string' name='[business_type]' role='dimension' type='nominal' />
        <column caption='Ds Value Segment' datatype='string' name='[ds_value_segment]' role='dimension' type='nominal'>
          <aliases>
            <alias key='%null%' value='No Segment' />
          </aliases>
        </column>
