      <aliases enabled='yes' />
      <column caption='Lifecycle Segment ' datatype='string' name='[Calculation_212513670706089984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([lifecycle_segment], &quot;prospect&quot;) THEN &quot;Prospect&quot;&#10;ELSE [lifecycle_segment]&#10;END' />
        <aliases>
          <alias key='%null%' value='No Segment' />
        </aliases>
      </column>
      <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_3504082047459164160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mau_reorders]) / SUM([mau_base])' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_3504082047644606465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[current_month] &lt;= TODAY() - 1' />
      </column>
      <column caption='Max Month' datatype='datetime' datatype-customized='true' name='[Calculation_3504082047655137282]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(&#10;    IF [current_month] &lt; DATETRUNC(&quot;month&quot;, TODAY()) THEN [current_month]&#10;    ELSE  DATETRUNC(&quot;month&quot;, TODAY())&#10;    END&#10;)}' />
      </column>
      <column caption='Date Filter 2' datatype='boolean' name='[Calculation_3504082047655440387]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[current_month] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1 - [Parameters].[Parameter 1], [Parameters].[Parameter 2]))&#10;AND&#10;[current_month] &lt;= [Parameters].[Parameter 2]' />
      </column>
      <column caption='Pro Segment ' datatype='string' name='[Calculation_3504082047747584004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Aggregated&quot; THEN [pro_segment]&#10;WHEN &quot;Detailed&quot; THEN [pro_segment_detailed]&#10;END' />
      </column>
