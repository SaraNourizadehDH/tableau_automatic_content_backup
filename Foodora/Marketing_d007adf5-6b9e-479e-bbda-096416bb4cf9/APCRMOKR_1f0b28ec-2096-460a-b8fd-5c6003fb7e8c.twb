                        <zone h='20283' id='1282' is-scaled='1' param='Image/Screenshot 2022-09-19 at 3.00.52 PM.png' type-v2='bitmap' w='26224' x='73332' y='61975'>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
                        </zone>
                        <zone fixed-size='259' forceUpdate='true' h='17226' id='639' is-fixed='true' type-v2='text' w='26224' x='73332' y='82258'>
                          <formatted-text>
                            <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='10' underline='true'>CRM Lifecycle Segment Definitions</run>
                            <run>Æ&#10;</run>
                            <run bold='true'>Welcome</run>
                            <run> - Users who made their first order within 30 days

</run>
                            <run bold='true'>Active</run>
                            <run> - Users who have made an order within 30 days

</run>
                            <run bold='true'>Churn</run>
                            <run> - Users who have not made an order 30 to 180 days

</run>
                            <run bold='true'>Inactive</run>
                            <run> - Users who have not made and order in &gt; 180 days</run>
                          </formatted-text>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
                            <format attr='border-width' value='0' />
                            <format attr='margin' value='4' />
                          </zone-style>
