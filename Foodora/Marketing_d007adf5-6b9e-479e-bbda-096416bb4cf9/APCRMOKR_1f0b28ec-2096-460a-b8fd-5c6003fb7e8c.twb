            <column caption='Unit' datatype='string' name='[Calculation_3754102193565216777]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[mac CRM contribution % Parameter] &#10;WHEN &quot;MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Dmart MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Shops MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pickup MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;QCommerce MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pro % MAU Penetration&quot; THEN &quot;%&quot;&#10;WHEN &quot;% registrations make 1st order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;% users make 2nd order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;# Reactivated Churn&quot; THEN &quot;#&quot;&#10;WHEN &quot;# Reactivated Inactive&quot; THEN &quot;#&quot;&#10;WHEN &quot;# Reactivated&quot; THEN &quot;#&quot;&#10;WHEN &quot;Order Frequency (Valid orders)&quot; THEN &quot;#&quot;&#10;WHEN &quot;% 1-year active users contactable&quot; THEN &quot;%&quot;&#10;WHEN &quot;% MAU tried ≥2 verticals&quot; THEN &quot;%&quot;&#10;WHEN &quot;Automation %&quot; THEN &quot;%&quot;&#10;WHEN &quot;MAUs attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Reactivations attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;1st Order in 30 days attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;2nd Order in 30 days attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;QC trials attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Net GMV attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Orders attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;FLGP Positive MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Users make 2nd order in 30 days&quot; THEN &quot;#&quot;&#10;END' />
            </column>
            <column caption='OKR (%)' datatype='real' name='[OKR (Num) (copy)_3754102193566359565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_3754102193565216777] WHEN &quot;%&quot;&#10;THEN CASE [Parameters].[mac CRM contribution % Parameter] &#10;  WHEN &quot;% registrations make 1st order in 30 days&quot; THEN [first_order_rate]&#10;  WHEN &quot;% users make 2nd order in 30 days&quot; THEN [second_order_rate]&#10;  WHEN &quot;% 1-year active users contactable&quot; THEN [contactable_rate] &#10;  WHEN &quot;% MAU tried ≥2 verticals&quot; THEN [tried_more_than_2_verticals_rate]&#10;  WHEN &quot;Pro % MAU Penetration&quot; THEN [pro_subs] / [mau]&#10;  WHEN &quot;Automation %&quot; THEN [comms_percent]&#10;END END' />
