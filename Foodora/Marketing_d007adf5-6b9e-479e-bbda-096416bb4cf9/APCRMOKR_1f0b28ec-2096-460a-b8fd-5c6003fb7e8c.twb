    <worksheet name='Overview Graph (#)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_crm_monthly_okr_overview (pandata_report)' name='federated.1sxxvul1hapc7f1b98x2g05ifuk9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='OKR' datatype='string' name='[mac CRM contribution % Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;MAU&quot;'>
              <calculation class='tableau' formula='&quot;MAU&quot;' />
              <aliases>
                <alias key='&quot;2nd Order in 30 days attributable to CRM&quot;' value='2nd Order in 30 days attributable to CRM [Not Stat. Sig]' />
                <alias key='&quot;FLGP Positive MAU&quot;' value='FLGP Positive MAU' />
                <alias key='&quot;MAUs attributable to CRM&quot;' value='MAUs attributable to CRM' />
                <alias key='&quot;Net GMV attributable to CRM&quot;' value='Net GMV attributable to CRM' />
                <alias key='&quot;QC trials attributable to CRM&quot;' value='QC trials attributable to CRM' />
                <alias key='&quot;Reactivations attributable to CRM&quot;' value='Reactivations attributable to CRM' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sxxvul1hapc7f1b98x2g05ifuk9'>
            <column caption='Unit' datatype='string' name='[Calculation_3754102193565216777]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[mac CRM contribution % Parameter] &#10;WHEN &quot;MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Dmart MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Shops MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pickup MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;QCommerce MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pro % MAU Penetration&quot; THEN &quot;%&quot;&#10;WHEN &quot;% registrations make 1st order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;% users make 2nd order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;# Reactivated Churn&quot; THEN &quot;#&quot;&#10;WHEN &quot;# Reactivated Inactive&quot; THEN &quot;#&quot;&#10;WHEN &quot;# Reactivated&quot; THEN &quot;#&quot;&#10;WHEN &quot;Order Frequency (Valid orders)&quot; THEN &quot;#&quot;&#10;WHEN &quot;% 1-year active users contactable&quot; THEN &quot;%&quot;&#10;WHEN &quot;% MAU tried ≥2 verticals&quot; THEN &quot;%&quot;&#10;WHEN &quot;Automation %&quot; THEN &quot;%&quot;&#10;WHEN &quot;MAUs attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Reactivations attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;1st Order in 30 days attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;2nd Order in 30 days attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;QC trials attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Net GMV attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Orders attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;FLGP Positive MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Users make 2nd order in 30 days&quot; THEN &quot;#&quot;&#10;END' />
            </column>
            <column caption='OKR (#)' datatype='real' name='[OKR (Num) (copy)_3754102193565958156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_3754102193565216777] WHEN &quot;#&quot;&#10; THEN CASE [Parameters].[mac CRM contribution % Parameter] &#10;   WHEN &quot;MAU&quot; THEN [mau]&#10;   WHEN &quot;Dmart MAU&quot; THEN [dmart_mau]&#10;   WHEN &quot;Shops MAU&quot; THEN [shops_mau]&#10;   WHEN &quot;Pickup MAU&quot; THEN [pickup_mau]&#10;   WHEN &quot;QCommerce MAU&quot; THEN [qcomm_mau]&#10;   WHEN &quot;# Reactivated Churn&quot; THEN [reactivated_churn]&#10;   WHEN &quot;# Reactivated Inactive&quot; THEN [reactivated_inactive]&#10;   WHEN &quot;# Reactivated&quot; THEN [reactivated_churn] + [reactivated_inactive]&#10;   WHEN &quot;MAUs attributable to CRM&quot; THEN [converted_mau_uplift]&#10;   WHEN &quot;Reactivations attributable to CRM&quot; THEN [converted_reactivation_uplift]&#10;   WHEN &quot;1st Order in 30 days attributable to CRM&quot; THEN [converted_1st_order_uplift]&#10;   WHEN &quot;2nd Order in 30 days attributable to CRM&quot; THEN [converted_2nd_order_uplift]&#10;   WHEN &quot;QC trials attributable to CRM&quot; THEN [converted_qc_trial_uplift]&#10;   WHEN &quot;Net GMV attributable to CRM&quot; THEN [net_gmv_uplift]&#10;   WHEN &quot;Orders attributable to CRM&quot; THEN [orders_uplift]&#10;   WHEN &quot;FLGP Positive MAU&quot; THEN [flgp_positive_mau]&#10;   WHEN &quot;Users make 2nd order in 30 days&quot; THEN [second_order_in_30d]&#10;END&#10;END' />
