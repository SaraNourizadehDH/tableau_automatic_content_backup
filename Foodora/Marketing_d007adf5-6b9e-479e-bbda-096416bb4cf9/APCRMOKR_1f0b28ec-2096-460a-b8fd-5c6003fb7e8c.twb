      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0i2k03b1ud873r1fa0b2n0cxvmjr].[sum:Calculation_2009309189511069708:qk]&quot;' value='Projected MAU vs Target Variation' />
