            </column>
            <column caption='Customers' datatype='real' name='[Calculation_3649815719592349753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_local] &lt; DATETRUNC(&apos;month&apos;, TODAY()) THEN [num_cust] ELSE[projected_cust]&#10;END' />
            </column>
            <column caption='No. of customers (K)' datatype='integer' name='[No. of customers (copy)_1559934360362651652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_cust]' />
            </column>
            <column-instance column='[segment]' derivation='Attribute' name='[attr:segment:nk]' pivot='key' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
