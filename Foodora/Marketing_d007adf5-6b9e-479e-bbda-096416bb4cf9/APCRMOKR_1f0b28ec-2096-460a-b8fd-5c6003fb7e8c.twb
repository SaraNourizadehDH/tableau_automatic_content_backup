      <aliases enabled='yes' />
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899684315145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
      </column>
      <column caption='Country Breakdown' datatype='string' name='[Calculation_4237746538824998914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Global Entity Id Parameter] = &quot;APAC&quot; THEN &quot;APAC&quot; ELSE [global_entity_id] END' />
      </column>
      <column caption='EC Retention Rate' datatype='real' name='[Calculation_4482277925088677888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_ec])/sum([ec_prev])' />
      </column>
      <column caption='MAU Retention Rate' datatype='real' name='[Calculation_4482277925088788481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_mau]) / SUM([mau_prev])' />
      </column>
      <column caption='NC Retention Rate' datatype='real' name='[Calculation_4482277925088858114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_nc]) / SUM([nc_prev])' />
      </column>
      <column caption='Reactivated Retention Rate' datatype='real' name='[Calculation_4482277925088927747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retained_rea]) / SUM([rea_prev])' />
      </column>
      <column caption='GEID Filter' datatype='boolean' name='[Calculation_6189845908904448017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 4] = &quot;All&quot;, TRUE, &quot;FP_&quot; + [Parameters].[Parameter 4]== [global_entity_id])' />
      </column>
      <column caption='MAU Churn Rate' datatype='real' name='[MAU Retention Rate (copy)_2288180519235473408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([retained_mau]) / SUM([mau_prev])' />
      </column>
