    <worksheet name='Sessions Overview'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_crm_perseus_sessions_daily_monthly (pandata_report)' name='federated.1pvap8u1i4o2st1c6k6xg1f7tk5h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column alias='Unique device (Registered and no account)' caption='Metric' datatype='string' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Unique Device&quot;'>
              <calculation class='tableau' formula='&quot;Unique Device&quot;' />
              <aliases>
                <alias key='&quot;Unique Device&quot;' value='Unique device (Registered and no account)' />
                <alias key='&quot;Unique Device NA&quot;' value='Unique device (No account only)' />
                <alias key='&quot;Unique User&quot;' value='Unique user (Registered only)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pvap8u1i4o2st1c6k6xg1f7tk5h'>
            <column caption='% diff in Sessions' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([sessions])) - LOOKUP(ZN(SUM([sessions])), -1)) / ABS(LOOKUP(ZN(SUM([sessions])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Period Granularity' datatype='date' default-format='*dd mmm yy' name='[Calculation_1773996052019486721]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Daily&quot; THEN [partition_date_utc]&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;, [partition_date_utc]) + 1&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, [partition_date_utc])&#10;    ELSE [partition_date_utc]&#10;END)' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_1773996052362936322]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IIF([Parameters].[Period Granularity] == &quot;Weekly&quot;, [Granularity] = &quot;daily&quot;,&#10;LOWER([Parameters].[Parameter 2]) == [granularity]&#10;//)' />
            </column>
            <column caption='Positive diff in Sessions' datatype='string' name='[Calculation_6687212140545908736]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation1] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation1]*100,1)) + &quot;%&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metric' datatype='integer' name='[Calculation_6687212140567871495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#10;    WHEN &quot;Unique Device&quot; &#10;    THEN [unique_device]&#10;    WHEN &quot;Unique User&quot; &#10;    THEN [unique_user]&#10;    WHEN &quot;Unique Device NA&quot; &#10;    THEN [unique_unregistered_device]&#10;    //WHEN &quot;Session per user&quot; THEN SUM([Overall Count])/SUM([Unique User])&#10;END' />
            </column>
            <column caption='Negative diff in Sessions' datatype='string' name='[Positive diff in Sessions (copy)_6687212140546228225]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation1] &lt; 0 THEN &quot;▼&quot; + &quot; &quot; + STR(ROUND([Calculation1]*-100,1)) + &quot;%&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions (copy)' datatype='integer' name='[Sessions (copy)_8193244003494379524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sessions]' />
            </column>
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1773996052019486721]' derivation='None' name='[none:Calculation_1773996052019486721:ok]' pivot='key' type='ordinal' />
