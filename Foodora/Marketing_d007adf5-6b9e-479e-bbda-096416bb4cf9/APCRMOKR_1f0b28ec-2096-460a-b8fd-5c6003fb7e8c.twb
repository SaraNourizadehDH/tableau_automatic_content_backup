          <alias key='&quot;[federated.0i2k03b1ud873r1fa0b2n0cxvmjr].[usr:Calculation_2009309189508304904:qk:17]&quot;' value='MTD Difference (%)' />
          <alias key='&quot;[federated.0i2k03b1ud873r1fa0b2n0cxvmjr].[usr:Calculation_3741506128539901953:qk:2]&quot;' value='MTD % Target Reached' />
          <alias key='&quot;[federated.0i2k03b1ud873r1fa0b2n0cxvmjr].[usr:Calculation_3741506128539901953:qk:8]&quot;' value='% Target Reached' />
          <alias key='&quot;[federated.0i2k03b1ud873r1fa0b2n0cxvmjr].[usr:Current Month Cumulative MAC (copy)_2009309189508673547:qk:2]&quot;' value='Current MTD MAU' />
          <alias key='&quot;[federated.0i2k03b1ud873r1fa0b2n0cxvmjr].[usr:Previous Month Cumulative MAC  (copy)_2009309189508550665:qk:2]&quot;' value='Previous MTD MAU' />
        </aliases>
      </column>
      <column caption='Row Index' datatype='integer' name='[Calculation_2009309189507784705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-field='[federated.0i2k03b1ud873r1fa0b2n0cxvmjr].[day_of_month]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='MTD Difference (in #)' datatype='real' name='[Calculation_2009309189508145158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Current Month Cumulative MAC (copy)_2009309189508673547] - [Previous Month Cumulative MAC  (copy)_2009309189508550665]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MTD Difference (in %)' datatype='real' name='[Calculation_2009309189508304904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2009309189508145158]/[Previous Month Cumulative MAC  (copy)_2009309189508550665]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Projected MAU vs Target # Variation' datatype='real' name='[Calculation_2009309189511069708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4995406845404160011]-[mau_target]' />
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899681738753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
      </column>
      <column caption='Previous Year MAU' datatype='integer' name='[Calculation_2703778268836421636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id] : SUM(IIF([month_local] = DATETRUNC(&quot;month&quot;,DATEADD(&quot;year&quot;,-1,TODAY())),[current_month_dac_by_acid],0))}' />
      </column>
      <column caption='% Target Reached' datatype='real' name='[Calculation_3741506128539901953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Current Month Cumulative MAC (copy)_2009309189508673547]/MAX([mau_target])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Current Month Projected MAU' datatype='real' name='[Calculation_4995406845404160011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/* TOTAL(SUM([Arbitrary Aug DAC])) */&#10;{FIXED [country_name], [month_local]: SUM([current_month_dac_projection_by_acid])}' />
      </column>
      <column caption='Projected MAU vs Target % Variation' datatype='real' name='[Calculation_4995406845404696588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4995406845404160011]/[mau_target]) - 1' />
      </column>
      <column caption='is_this_month' datatype='string' name='[Calculation_4995406845407584272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [month_local] = DATETRUNC(&apos;month&apos;, TODAY()-2) THEN &apos;true&apos;&#10;ELSE &apos;false&apos;&#10;END&#10;&#10;/* &#10;IF DATETRUNC(&apos;month&apos;, [month_local]) = DATETRUNC(&apos;month&apos;, TODAY()) AND &#10;DATETRUNC(&apos;year&apos;, [month_local]) = DATETRUNC(&apos;year&apos;, TODAY()) THEN&#10;&apos;true&apos;&#10;ELSE &apos;false&apos;&#10;END */' />
      </column>
      <column caption='Current MTD MAU' datatype='real' name='[Current Month Cumulative MAC (copy)_2009309189508673547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL(MAX([current_month_dac_projection_by_acid])) THEN&#10;/* (MAX([Day of Month])) &lt; DAY(TODAY())-1 THEN */&#10;RUNNING_SUM(SUM([current_month_dac_projection_by_acid]))&#10;ELSE NULL&#10;END&#10;/* { FIXED [Country]: SUM([Previous Month DAC])} */'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Previous MTD MAU' datatype='integer' name='[Previous Month Cumulative MAC  (copy)_2009309189508550665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([previous_month_dac_by_acid]))&#10;/* { FIXED [Country]: SUM([Previous Month DAC])} */'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Current MTD MAU 2' datatype='integer' name='[Previous Month Cumulative MAC  (copy)_4995406845415227420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL(MAX([current_month_dac])) THEN&#10;/* (MAX([Day of Month])) &lt; DAY(TODAY())-1 THEN */&#10;RUNNING_SUM(SUM([current_month_dac]))&#10;ELSE NULL&#10;END&#10;/* { FIXED [Country]: SUM([Previous Month DAC])} */'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Projected MAU vs Prev Year MAU # Variation' datatype='real' name='[Projected MAU vs Target # Variation (copy)_2703778268837425157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4995406845404160011]-[Calculation_2703778268836421636]' />
      </column>
      <column caption='Projected MAU vs Prev Year MAU % Variation' datatype='real' name='[Projected MAU vs Target % Variation (copy)_2703778268838154246]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4995406845404160011]/[Calculation_2703778268836421636]) - 1' />
      </column>
      <column caption='Row Level Hide/ Show MTD' datatype='string' name='[Row Level Hide/ Show (copy)_3741506128537952256]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF DAY(TODAY()) = 1 AND [Calculation_2009309189507784705] = MAX(DAY(DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [date_local])))) THEN &quot;Show&quot;&#10;ELSEIF [Calculation_2009309189507784705] = DAY(TODAY())-2 THEN &quot;Show&quot; &#10;ELSE &quot;Hide&quot;&#10;END&#10;&#10;/* &#10;IF [MTD Display Check] = &quot;Show previous day&quot; THEN &quot;Hide&quot;&#10;ELSEIF [MTD Display Check] = &quot;Show current day&quot; &#10; AND MAX(DAY([date_local])) = DAY(TODAY()) - 2 THEN &quot;Show&quot;&#10;ELSE &quot;Hide&quot;&#10;END */&#10;&#10;/* IF [Row Index] = 31 THEN &quot;Show&quot;&#10;ELSE &quot;Hide&quot;&#10;END */&#10;&#10;/* IF [MTD Display Check] = DAY(TODAY())-1 THEN &quot;Show&quot; */&#10;/* ELSEIF [MTD Display Check] = DAY(TODAY())-2 THEN &quot;Show&quot; */&#10;/* ELSE &quot;Hide&quot; */&#10;/* END */&#10;&#10;/* IF NOT ISNULL([Current Month Cumulative MAC]) AND [Row Index] = DAY(TODAY())- 1 THEN &quot;Show&quot; */&#10;/* &lt;= (DAY(TODAY()) -1) * 12 AND [Row Index] &gt;= (DAY(TODAY())-1) * 12 - 11 THEN &quot;Show&quot; */&#10;/*  ELSEIF [Row Index] &lt;= 20 * 12 AND [Row Index] &gt;= 20 * 12 - 11 THEN &quot;Show&quot; /* for checking */&#10;/* ELSEIF [Row Index] = LAST() + 1 THEN &quot;Show&quot; */&#10;/* ELSE &quot;Hide&quot; END */'>
          <table-calc ordering-type='Rows' />
