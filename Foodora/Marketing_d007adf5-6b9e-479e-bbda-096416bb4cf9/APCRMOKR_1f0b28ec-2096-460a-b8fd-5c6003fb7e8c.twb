            <column caption='Segment Breakdown' datatype='string' name='[Country Breakdown (copy)_4088001868568436736]' param-domain-type='list' role='measure' type='nominal' value='&quot;Segment&quot;'>
              <calculation class='tableau' formula='&quot;Segment&quot;' />
            </column>
            <column caption='Country Breakdown' datatype='string' name='[Global Entity Id Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;APAC&quot;'>
              <calculation class='tableau' formula='&quot;APAC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zed5570ryx4mo119sf3r1flisqe'>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
