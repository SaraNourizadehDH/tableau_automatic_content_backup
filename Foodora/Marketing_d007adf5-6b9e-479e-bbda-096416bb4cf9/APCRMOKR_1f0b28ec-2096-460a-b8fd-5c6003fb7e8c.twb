      <column caption='CRM Impact (Uplift % of Total)' datatype='real' name='[Calculation_1512928024635080705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2522367697623642112])/ SUM([topline])' />
