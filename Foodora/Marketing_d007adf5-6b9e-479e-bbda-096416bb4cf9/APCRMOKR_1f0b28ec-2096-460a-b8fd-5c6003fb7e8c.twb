          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='OKR Dropdown' datatype='string' name='[OKR (copy)_3856418302007152643]' param-domain-type='list' role='measure' type='nominal' value='&quot;Automation \%&quot;'>
              <calculation class='tableau' formula='&quot;Automation %&quot;' />
              <aliases>
                <alias key='&quot;\% users make 2nd order in 30 days&quot;' value='% users make 2nd order in 30 days' />
                <alias key='&quot;FLGP Positive MAU&quot;' value='FLGP Positive MAU' />
                <alias key='&quot;GMV attributable to CRM&quot;' value='GMV attributable to CRM' />
                <alias key='&quot;Reactivations&quot;' value='Reactivations' />
              </aliases>
            </column>
            <column caption='OKR' datatype='string' name='[mac CRM contribution % Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;MAU&quot;'>
              <calculation class='tableau' formula='&quot;MAU&quot;' />
              <aliases>
                <alias key='&quot;2nd Order in 30 days attributable to CRM&quot;' value='2nd Order in 30 days attributable to CRM [Not Stat. Sig]' />
                <alias key='&quot;FLGP Positive MAU&quot;' value='FLGP Positive MAU' />
                <alias key='&quot;MAUs attributable to CRM&quot;' value='MAUs attributable to CRM' />
                <alias key='&quot;Net GMV attributable to CRM&quot;' value='Net GMV attributable to CRM' />
                <alias key='&quot;QC trials attributable to CRM&quot;' value='QC trials attributable to CRM' />
                <alias key='&quot;Reactivations attributable to CRM&quot;' value='Reactivations attributable to CRM' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0paikkr0jit70o10mmetq066ee0x'>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899685986317]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
            </column>
            <column caption='OKR Unit' datatype='string' name='[Calculation_5244793625362477057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[OKR (copy)_3856418302007152643] &#10;WHEN &quot;MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Dmart MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Shops MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pickup MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pro % MAU Penetration&quot; THEN &quot;%&quot;&#10;WHEN &quot;% registrations make 1st order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;% users make 2nd order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;Reactivations&quot; THEN &quot;#&quot;&#10;WHEN &quot;Order Frequency (Valid orders)&quot; THEN &quot;#&quot;&#10;WHEN &quot;% MAU tried ≥2 verticals&quot; THEN &quot;%&quot;&#10;WHEN &quot;Automation %&quot; THEN &quot;%&quot;&#10;WHEN &quot;1st order&quot; THEN &quot;#&quot;&#10;WHEN &quot;2nd order&quot; THEN &quot;#&quot;&#10;WHEN &quot;QC Trial&quot; THEN &quot;#&quot;&#10;WHEN &quot;GMV attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Orders&quot; THEN &quot;#&quot;&#10;WHEN &quot;FLGP Positive MAU&quot; THEN &quot;#&quot;&#10;END' />
            </column>
            <column caption='OKR (%) MoM' datatype='real' name='[Calculation_5244793625370333196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_5244793625362477057] WHEN &quot;%&quot;&#10;THEN CASE [Parameters].[mac CRM contribution % Parameter] &#10;  WHEN &quot;% registrations make 1st order in 30 days&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;% users make 2nd order in 30 days&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;% MAU tried ≥2 verticals&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;Pro % MAU Penetration&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;Automation %&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;END END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Negative OKR (%) MoM' datatype='string' name='[Calculation_5244793625370636301]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5244793625370333196]&lt; 0 &#10;THEN &quot;▼&quot; + &quot; &quot; + STR(ROUND([Calculation_5244793625370333196],0)) + &quot;p.p&quot; &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Positive OKR (%) MoM' datatype='string' name='[Calculation_5244793625370800142]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5244793625370333196] &gt; 0 &#10;THEN &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation_5244793625370333196],0)) + &quot;p.p&quot; &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='OKR (%)' datatype='boolean' name='[OKR (#) (copy)_5244793625363111938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_5244793625362477057] WHEN &quot;%&quot; THEN&#10;IF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Automation %&quot; AND [metric] = &quot;% Automation&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;% registrations make 1st order in 30 days&quot; AND [metric] = &quot;First Order Rate&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;% users make 2nd order in 30 days&quot; AND [metric] = &quot;Second Order Rate&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;% MAU tried ≥2 verticals&quot; AND [metric] = &quot;% MAU tried more than 2 verticals&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Pro % MAU Penetration&quot; AND [metric] = &quot;Pandapro MAU Penetration&quot; THEN TRUE&#10;END&#10;END' />
            </column>
