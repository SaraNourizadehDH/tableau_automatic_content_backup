                <zone forceUpdate='true' h='92018' id='5' type-v2='text' w='99000' x='500' y='7315'>
                  <formatted-text>
                    <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='11' underline='true'>CRM OKR Definitions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='10'>1. Monthly Active Users (MAU)</run>
                    <run fontsize='10'>- users with </run>
                    <run bold='true' fontsize='10' underline='true'>at least 1</run>
                    <run fontsize='10'> successful order in any vertical in the reporting month</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='10'>2.</run>
                    <run fontname='Tableau Bold' fontsize='10'>Æ </run>
                    <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='10'>Pandapro Penetration Rate</run>
                    <run fontsize='10'> - users with active pandapro subscription in the reporting month over total MAU in the same month</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='10'>3. Pandamart MAU</run>
                    <run fontcolor='#fc0280' fontsize='10'>Æ </run>
                    <run fontsize='10'>- Foodpanda users who made at least 1 successful pandamart order in the reporting month</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='10'>4. Shops MAU</run>
                    <run bold='true' fontname='Tableau Bold' fontsize='10'>Æ </run>
                    <run fontsize='10'>- Foodpanda users who made at least 1 successful shops order in the reporting month</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#fc0280' fontname='Tableau Bold' fontsize='10'>5. Pick-up MAU</run>
                    <run fontsize='10'> - Foodpanda users who made at least 1 successful pick-up order in the reporting month</run>
                    <run>&#10;&#10;&#10;2022 Targets source: </run>
                    <run fontsize='10'>Æ </run>
                    <run auto-url='true' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1KUgl6vi_jQHV24sVS_d4nuSDB_eK03TDHBijX9uMzc0/edit?usp=sharing&amp;quot;'>https://docs.google.com/spreadsheets/d/1KUgl6vi_jQHV24sVS_d4nuSDB_eK03TDHBijX9uMzc0/edit?usp=sharing</run>
                    <run>&#10;&#10;2023 Targets source:</run>
                    <run fontsize='10'>Æ </run>
                    <run auto-url='true' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1B0l4vr-DYGZadL0Nu-lpFrqq9VJohbnTk-3NO1aNTss/edit#gid=1172907291&amp;quot;'>https://docs.google.com/spreadsheets/d/1B0l4vr-DYGZadL0Nu-lpFrqq9VJohbnTk-3NO1aNTss/edit#gid=1172907291</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='10'>Note: The metrics reported in this dashboard are at ACID (analytical_customer_id) level</run>
                    <run>Æ&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
