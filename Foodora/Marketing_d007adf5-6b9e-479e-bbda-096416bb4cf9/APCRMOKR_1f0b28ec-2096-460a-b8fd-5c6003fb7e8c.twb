          <datasources>
            <datasource caption='regional_apac_mkt_crm_churn_inactive_breakdown_agg (pandata_report)' name='federated.13bavqm04z7zbe16lou6v1x0dpwi' />
          </datasources>
          <datasource-dependencies datasource='federated.13bavqm04z7zbe16lou6v1x0dpwi'>
            <column caption='% of total' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acid_count]) / TOTAL(SUM([acid_count]))'>
                <table-calc ordering-field='[federated.13bavqm04z7zbe16lou6v1x0dpwi].[sub_segment]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='MoM Difference (in #)' datatype='integer' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([acid_count])) - LOOKUP(ZN(SUM([acid_count])), -1)'>
                <table-calc ordering-field='[federated.13bavqm04z7zbe16lou6v1x0dpwi].[tmn:month_local:ok]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='MoM Difference (in %)' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([acid_count])) - LOOKUP(ZN(SUM([acid_count])), -1)) / ABS(LOOKUP(ZN(SUM([acid_count])), -1))'>
                <table-calc ordering-field='[federated.13bavqm04z7zbe16lou6v1x0dpwi].[tmn:month_local:ok]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899682275331]' role='dimension' type='nominal'>
