      <aliases enabled='yes' />
      <column caption='% diff in QC Metric' datatype='real' default-format='p0.00%' name='[% diff in QC Sessions (copy)_6560759549194539010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_6372241682749222912])) - LOOKUP(ZN(SUM([Calculation_6372241682749222912])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_6372241682749222912])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% diff in QC Sessions' datatype='real' default-format='p0.00%' name='[% diff in Sessions (copy)_6372241682750537729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([qcommerce_sessions])) - LOOKUP(ZN(SUM([qcommerce_sessions])), -1)) / ABS(LOOKUP(ZN(SUM([qcommerce_sessions])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% diff in Sessions' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([sessions])) - LOOKUP(ZN(SUM([sessions])), -1)) / ABS(LOOKUP(ZN(SUM([sessions])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Session Share %' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions]) / TOTAL(SUM([sessions]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Breakdown by' datatype='string' name='[Calculation_1773996052019195904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] == &quot;Channel&quot;&#10;THEN [channel]&#10;ELSEIF  [Parameters].[Parameter 1 1] == &quot;Subchannel&quot;&#10;THEN [channel_subchannel]&#10;ELSEIF [Parameters].[Parameter 1 1] == &quot;Country&quot;&#10;THEN [country]&#10;ELSEIF [Parameters].[Parameter 1 1] == &quot;Channel Group&quot;&#10;THEN [Channel Subchannel (group)]&#10;ELSEIF [Parameters].[Parameter 1 1] == &quot;None&quot;&#10;THEN &quot;&quot;&#10;END' />
      </column>
      <column caption='Period Granularity' datatype='date' default-format='*dd mmm yy' name='[Calculation_1773996052019486721]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Daily&quot; THEN [partition_date_utc]&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;, [partition_date_utc]) + 1&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, [partition_date_utc])&#10;    ELSE [partition_date_utc]&#10;END)' />
      </column>
      <column caption='Granularity Filter' datatype='boolean' name='[Calculation_1773996052362936322]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IIF([Parameters].[Period Granularity] == &quot;Weekly&quot;, [Granularity] = &quot;daily&quot;,&#10;LOWER([Parameters].[Parameter 2]) == [granularity]&#10;//)' />
      </column>
      <column caption='Conversion Rate' datatype='real' default-format='p0%' name='[Calculation_5886838047894212608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_users])/SUM([unique_device])' />
      </column>
      <column caption='Session per User' datatype='real' name='[Calculation_5886838047905992705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_from_user])/SUM([unique_user])' />
      </column>
      <column caption='NC Sessions %' datatype='real' default-format='p0.0%' name='[Calculation_5886838047907409922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_sessions])/SUM([sessions])' />
      </column>
      <column caption='QC Metric' datatype='integer' name='[Calculation_6372241682749222912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Qcommerce Menu Sessions&quot; &#10;    THEN [qcommerce_menu_sessions]&#10;    WHEN &quot;Dmart Menu Sessions&quot; &#10;    THEN [dmart_menu_sessions]&#10;    WHEN &quot;Shops Menu Sessions&quot; &#10;    THEN [shops_menu_sessions]&#10;END' />
      </column>
      <column caption='Positive diff in Sessions' datatype='string' name='[Calculation_6687212140545908736]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation1] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation1]*100,1)) + &quot;%&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Session CVR' datatype='real' default-format='p0.0%' name='[Calculation_6687212140546936835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_with_order])/SUM([sessions])' />
      </column>
      <column caption='Channel Filter' datatype='boolean' name='[Calculation_6687212140560527364]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1 1] IN (&quot;Channel&quot;, &quot;Subchannel&quot;, &quot;Channel Group&quot;), [channel] != &quot;All Channels&quot;, [channel] = &quot;All Channels&quot;)' />
      </column>
      <column caption='Session Share / CVR' datatype='real' default-format='p0.0%' name='[Calculation_6687212140563529733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = &quot;Session Share&quot;, [Calculation2], [Calculation_6687212140546936835])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Exclude All Channel' datatype='boolean' name='[Calculation_6687212140564721670]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel] != &quot;All Channels&quot;' />
      </column>
      <column caption='Metric' datatype='integer' name='[Calculation_6687212140567871495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#10;    WHEN &quot;Unique Device&quot; &#10;    THEN [unique_device]&#10;    WHEN &quot;Unique User&quot; &#10;    THEN [unique_user]&#10;    WHEN &quot;Unique Device NA&quot; &#10;    THEN [unique_unregistered_device]&#10;    //WHEN &quot;Session per user&quot; THEN SUM([Overall Count])/SUM([Unique User])&#10;END' />
      </column>
