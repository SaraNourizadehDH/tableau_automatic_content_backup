      <column caption='MoM OKR (#) % Diff' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)) / ABS(LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM OKR (#)' datatype='real' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_3754102193565216777] WHEN &quot;#&quot;&#10; THEN CASE [Parameters].[mac CRM contribution % Parameter] &#10;   WHEN &quot;MAU&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;Dmart MAU&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;Shops MAU&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;Pickup MAU&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1) &#10;   WHEN &quot;# Reactivated Churn&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;# Reactivated Inactive&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;MAUs attributable to CRM&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;Reactivations attributable to CRM&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;1st Order in 30 days attributable to CRM&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;2nd Order in 30 days attributable to CRM&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;QC trials attributable to CRM&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;Net GMV attributable to CRM&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;   WHEN &quot;FLGP Positive MAU&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193565958156])) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193565958156])), -1)&#10;END&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM OKR (%)' datatype='real' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_3754102193565216777] WHEN &quot;%&quot;&#10;THEN CASE [Parameters].[mac CRM contribution % Parameter] &#10;  WHEN &quot;% registrations make 1st order in 30 days&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100), -1)&#10;  WHEN &quot;% users make 2nd order in 30 days&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100), -1)&#10;  WHEN &quot;% 1-year active users contactable&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100), -1) &#10;  WHEN &quot;% MAU tried ≥2 verticals&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100), -1)&#10;  WHEN &quot;Pro % MAU Penetration&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100), -1)&#10;  WHEN &quot;Stamp Card Engagement MAU Penetration&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100), -1)&#10;  WHEN &quot;Automation %&quot; THEN ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100) - LOOKUP(ZN(SUM([OKR (Num) (copy)_3754102193566359565])*100), -1)&#10;END END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899683287046]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
      </column>
      <column caption='Show/ Hide' datatype='string' name='[Calculation_2964424092357185539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[mac CRM contribution % Parameter]&#10;WHEN &quot;MAU&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;Dmart MAU&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;Shops MAU&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;Pickup MAU&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;Pro % MAU Penetration&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;% registrations make 1st order in 30 days&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;% users make 2nd order in 30 days&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;# Reactivated Churn&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;# Reactivated Inactive&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;Order Frequency (MAU)&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;% 1-year active users contactable&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;% MAU tried ≥2 verticals&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;Stamp Card Engagement MAU Penetration&quot; THEN &quot;Hide&quot;&#10;WHEN &quot;MAUs attributable to CRM&quot; THEN &quot;Show&quot;&#10;WHEN &quot;Reactivations attributable to CRM&quot; THEN &quot;Show&quot;&#10;WHEN &quot;2nd Order in 30 days attributable to CRM&quot; THEN &quot;Show&quot;&#10;WHEN &quot;QC trials attributable to CRM&quot; THEN &quot;Show&quot;&#10;END' />
      </column>
      <column caption='Unit' datatype='string' name='[Calculation_3754102193565216777]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[mac CRM contribution % Parameter] &#10;WHEN &quot;MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Dmart MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Shops MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pickup MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;QCommerce MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pro % MAU Penetration&quot; THEN &quot;%&quot;&#10;WHEN &quot;% registrations make 1st order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;% users make 2nd order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;# Reactivated Churn&quot; THEN &quot;#&quot;&#10;WHEN &quot;# Reactivated Inactive&quot; THEN &quot;#&quot;&#10;WHEN &quot;# Reactivated&quot; THEN &quot;#&quot;&#10;WHEN &quot;Order Frequency (Valid orders)&quot; THEN &quot;#&quot;&#10;WHEN &quot;% 1-year active users contactable&quot; THEN &quot;%&quot;&#10;WHEN &quot;% MAU tried ≥2 verticals&quot; THEN &quot;%&quot;&#10;WHEN &quot;Automation %&quot; THEN &quot;%&quot;&#10;WHEN &quot;MAUs attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Reactivations attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;1st Order in 30 days attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;2nd Order in 30 days attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;QC trials attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Net GMV attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Orders attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;FLGP Positive MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Users make 2nd order in 30 days&quot; THEN &quot;#&quot;&#10;END' />
      </column>
      <column caption='Orders Uplift 2 (CRM Channel)' datatype='real' name='[Calculation_5555612421156265984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([reporting_month]) &gt;= 2023 &#10;THEN [orders_uplift]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='is_not_current_month' datatype='boolean' name='[Calculation_6860389673350828036]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [reporting_month] != DATETRUNC(&apos;month&apos;, TODAY()-1) THEN TRUE ELSE FALSE END' />
