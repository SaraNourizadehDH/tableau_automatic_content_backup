    <worksheet name='Session Breakdown'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_crm_perseus_sessions_daily_monthly (pandata_report)' name='federated.1pvap8u1i4o2st1c6k6xg1f7tk5h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown by' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Channel&quot;'>
              <calculation class='tableau' formula='&quot;Channel&quot;' />
            </column>
            <column caption='Period Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Show : Share / CVR' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Conversion Rate&quot;'>
              <calculation class='tableau' formula='&quot;Conversion Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pvap8u1i4o2st1c6k6xg1f7tk5h'>
            <column caption='% diff in Sessions' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([sessions])) - LOOKUP(ZN(SUM([sessions])), -1)) / ABS(LOOKUP(ZN(SUM([sessions])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Session Share %' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions]) / TOTAL(SUM([sessions]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Breakdown by' datatype='string' name='[Calculation_1773996052019195904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] == &quot;Channel&quot;&#10;THEN [channel]&#10;ELSEIF  [Parameters].[Parameter 1 1] == &quot;Subchannel&quot;&#10;THEN [channel_subchannel]&#10;ELSEIF [Parameters].[Parameter 1 1] == &quot;Country&quot;&#10;THEN [country]&#10;ELSEIF [Parameters].[Parameter 1 1] == &quot;Channel Group&quot;&#10;THEN [Channel Subchannel (group)]&#10;ELSEIF [Parameters].[Parameter 1 1] == &quot;None&quot;&#10;THEN &quot;&quot;&#10;END' />
            </column>
            <column caption='Period Granularity' datatype='date' default-format='*dd mmm yy' name='[Calculation_1773996052019486721]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Daily&quot; THEN [partition_date_utc]&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;, [partition_date_utc]) + 1&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, [partition_date_utc])&#10;    ELSE [partition_date_utc]&#10;END)' />
            </column>
            <column caption='Granularity Filter' datatype='boolean' name='[Calculation_1773996052362936322]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IIF([Parameters].[Period Granularity] == &quot;Weekly&quot;, [Granularity] = &quot;daily&quot;,&#10;LOWER([Parameters].[Parameter 2]) == [granularity]&#10;//)' />
            </column>
            <column caption='Session CVR' datatype='real' default-format='p0.0%' name='[Calculation_6687212140546936835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_with_order])/SUM([sessions])' />
            </column>
            <column caption='Channel Filter' datatype='boolean' name='[Calculation_6687212140560527364]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1 1] IN (&quot;Channel&quot;, &quot;Subchannel&quot;, &quot;Channel Group&quot;), [channel] != &quot;All Channels&quot;, [channel] = &quot;All Channels&quot;)' />
            </column>
            <column caption='Session Share / CVR' datatype='real' default-format='p0.0%' name='[Calculation_6687212140563529733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = &quot;Session Share&quot;, [Calculation2], [Calculation_6687212140546936835])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Channel Group' datatype='string' name='[Channel Subchannel (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[channel_subchannel]' new-bin='true'>
                <bin default-name='false' value='&quot;CRM&quot;'>
                  <value>&quot;CRM_BRA&quot;</value>
                  <value>&quot;CRM_RMA&quot;</value>
                  <value>&quot;CRM_RMO&quot;</value>
                  <value>&quot;CRM_UNKNOWN&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Online Branding&quot;'>
                  <value>&quot;APP_BRA&quot;</value>
                  <value>&quot;DISPLAY_BRA&quot;</value>
                  <value>&quot;PAIDSOCIAL_BRA&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Organic&quot;'>
                  <value>&quot;BRAND_APPDIRECT&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Others&quot;'>
                  <value>&quot;FLYERS&quot;</value>
                  <value>&quot;OTHER_CAMPAIGNS&quot;</value>
                  <value>&quot;OTHER_CUSTOMERCOMPENSATION&quot;</value>
                  <value>&quot;OTHER_OTHER&quot;</value>
                  <value>&quot;OTHER_UNTRACKED&quot;</value>
                  <value>&quot;SOCIALMEDIA_ENGAGEMENTNOTPROMOTED&quot;</value>
                  <value>&quot;SOCIALMEDIA_ENGAGEMENTPROMOTED&quot;</value>
                  <value>&quot;SOCIALMEDIA_INFLUENCER&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;PM RMA&quot;'>
                  <value>&quot;APP_REACH&quot;</value>
                  <value>&quot;APP_RMA&quot;</value>
                  <value>&quot;DISPLAY_REACH&quot;</value>
                  <value>&quot;DISPLAY_RMA&quot;</value>
                  <value>&quot;PAIDSOCIAL_REACH&quot;</value>
                  <value>&quot;PAIDSOCIAL_RMA&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;PM RMO&quot;'>
                  <value>&quot;APP_RMO&quot;</value>
                  <value>&quot;DISPLAY_RMO&quot;</value>
                  <value>&quot;PAIDSOCIAL_RMO&quot;</value>
                  <value>&quot;PAIDSOCIAL_UNKNOWN&quot;</value>
                  <value>&quot;SEO_NONBRAND&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Preinstall&quot;'>
                  <value>&quot;HUAWEI_PREINSTALL&quot;</value>
                  <value>&quot;SAMSUNG_PREINSTALL&quot;</value>
                  <value>&quot;TRANSSION_PREINSTALL&quot;</value>
                  <value>&quot;VIVO_PREINSTALL&quot;</value>
                  <value>&quot;XIAOMI_PREINSTALL&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;RAF&quot;'>
                  <value>&quot;WOM_RAF&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;SEM&quot;'>
                  <value>&quot;SEM_BRA&quot;</value>
                  <value>&quot;SEM_CATEGORY&quot;</value>
                  <value>&quot;SEM_COMPETITOR&quot;</value>
                  <value>&quot;SEM_GENERIC&quot;</value>
                  <value>&quot;SEM_VENDOR&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Channel Subchannel' datatype='string' name='[channel_subchannel]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1773996052019195904]' derivation='None' name='[none:Calculation_1773996052019195904:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1773996052019486721]' derivation='None' name='[none:Calculation_1773996052019486721:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1773996052362936322]' derivation='None' name='[none:Calculation_1773996052362936322:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6687212140560527364]' derivation='None' name='[none:Calculation_6687212140560527364:nk]' pivot='key' type='nominal' />
            <column-instance column='[channel]' derivation='None' name='[none:channel:nk]' pivot='key' type='nominal' />
            <column-instance column='[channel_subchannel]' derivation='None' name='[none:channel_subchannel:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[partition_date_utc]' derivation='None' name='[none:partition_date_utc:qk]' pivot='key' type='quantitative' />
            <column-instance column='[platform]' derivation='None' name='[none:platform:nk]' pivot='key' type='nominal' />
