              <calculation class='tableau' formula='CASE [segment]&#10;WHEN &apos;Retained Existing Customer&apos; THEN &apos;Retained EC&apos;&#10;WHEN &apos;Retained New Customer&apos; THEN &apos;Retained NC&apos;&#10;WHEN &apos;New Customer&apos; THEN &apos;NC&apos;&#10;ELSE [segment]&#10;END' />
