      <aliases enabled='yes' />
      <column caption='CM MAU' datatype='integer' name='[CM Churn (copy)_3974778541769875456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([flow_direction] = &apos;Inflow&apos;, [users], 0)' />
      </column>
      <column caption='CM Ex-Reactivated (copy)' datatype='integer' name='[CM Ex-Reactivated (copy)_3974778541770461186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([flow_direction] = &apos;Outflow&apos; AND [segment] IN (&apos;Reactivated Churn&apos;, &apos;Reactivated Inactive&apos;), [users], 0)' />
      </column>
      <column caption='MoM Users Diff' datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([users])) - LOOKUP(ZN(SUM([users])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Users Diff %' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([users])) - LOOKUP(ZN(SUM([users])), -1)) / ABS(LOOKUP(ZN(SUM([users])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899683737607]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
      </column>
      <column caption='Previous Reporting Month' datatype='date' name='[Calculation_3974778541770723331]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='PREVIOUS_VALUE(ATTR([reporting_month]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MAU Start Period' datatype='integer' name='[Calculation_5687624133829763072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reporting_month] = [Parameters].[Breakdown by (copy 2)] AND [flow_direction] = &apos;Inflow&apos; THEN [users] ELSE 0 END' />
      </column>
      <column caption='MAU End Period' datatype='integer' name='[Calculation_5687624133830447105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reporting_month] = [Parameters].[Start Month (copy)] AND [flow_direction] = &apos;Inflow&apos; THEN [users] ELSE 0 END' />
      </column>
      <column caption='MoM MAU Diff Overview' datatype='integer' name='[Calculation_5687624133830676483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5687624133830447105]) - SUM([Calculation_5687624133829763072])' />
      </column>
      <column caption='MoM MAU Diff % Overview' datatype='real' name='[Calculation_5687624133830819844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5687624133830447105])-SUM([Calculation_5687624133829763072])) / SUM([Calculation_5687624133829763072])' />
      </column>
      <column caption='Negative MAU Diff %' datatype='string' name='[Calculation_5687624133831213061]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5687624133830819844] &lt; 0 &#10;THEN &quot;▼&quot; + &quot; &quot; + STR(ROUND([Calculation_5687624133830819844]*-100)) + &quot;%&quot; END' />
      </column>
      <column caption='Positive MAU Diff %' datatype='string' name='[Calculation_5687624133831376902]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5687624133830819844] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation_5687624133830819844]*100)) + &quot;%&quot; END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_5687624133834453000]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM MAU Diff Overview Direction' datatype='string' name='[Calculation_5687624133834670089]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5687624133830676483] &gt; 0 THEN &quot;+ve&quot; &#10;ELSEIF [Calculation_5687624133830676483] &lt;0 THEN &quot;-ve&quot;&#10;ELSE &quot;No Change&quot;&#10;END' />
      </column>
      <column caption='In-Out Users' datatype='integer' name='[Calculation_6015331375567527936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [flow_direction] = &quot;Outflow&quot; THEN [users] * -1 ELSE [users] END' />
      </column>
      <column caption='CM Ex-Reactivated' datatype='integer' name='[Calculation_6015331375568953345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([flow_direction] = &apos;Outflow&apos; AND [segment] IN (&apos;Reactivated Churn&apos;, &apos;Reactivated Inactive&apos;), [users], 0)' />
      </column>
      <column caption='CM Churn' datatype='integer' name='[Calculation_6015331375569104898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([flow_direction] = &apos;Outflow&apos;, [users], 0)' />
      </column>
      <column caption='Reactivated Retention Rate' datatype='real' name='[Calculation_6015331375569195011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1- SUM([Calculation_6015331375568953345])/SUM([Calculation_6015331375569104898])' />
      </column>
      <column caption='Country Breakdown' datatype='string' name='[Calculation_6205819566305714176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Global Entity Id Parameter] = &quot;APAC&quot; THEN &quot;APAC&quot; ELSE [global_entity_id] END' />
      </column>
      <column caption='Segment Breakdown' datatype='string' name='[Calculation_6205819566306193409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Country Breakdown (copy)_4088001868568436736] = &quot;All&quot; THEN &quot;All&quot; ELSE [segment] END' />
      </column>
      <column caption='Reactivated Retention Rate 2' datatype='real' name='[Reactivated Retention Rate (copy)_3974778541769940993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6015331375568953345])/SUM([CM Churn (copy)_3974778541769875456])' />
      </column>
      <column datatype='string' name='[Segment (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[segment]' new-bin='true'>
          <bin default-name='false' value='&quot;NC&quot;'>
            <value>&quot;New Customer&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Reactivated&quot;'>
            <value>&quot;Reactivated Churn&quot;</value>
            <value>&quot;Reactivated Inactive&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Retained&quot;'>
            <value>&quot;Retained Existing Customer&quot;</value>
            <value>&quot;Retained New Customer&quot;</value>
          </bin>
        </calculation>
      </column>
