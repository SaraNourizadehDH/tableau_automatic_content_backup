                <zone fixed-size='280' h='19900' id='314' is-fixed='true' name='Retention Rate' w='51835' x='47721' y='16350'>
                  <layout-cache minheight='167' minwidth='170' type-h='scalable' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
