    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Lifecycle OKR'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCRMOKR/LifecycleOKR?rev=' id='LifecycleOKR' path='/t/Foodora/workbooks/APCRMOKR' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_5' value='top' />
          <format attr='text-align' id='dash-text_5' value='left' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1800' minheight='2000' minwidth='1800' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Lifecycle OKR Tracking' name='federated.1ccvqz81ez35ej171el2u0wuldaj' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='APAC' caption='GEID' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <aliases>
            <alias key='&quot;All&quot;' value='APAC' />
          </aliases>
          <members>
            <member alias='APAC' value='&quot;All&quot;' />
            <member value='&quot;BD&quot;' />
            <member value='&quot;HK&quot;' />
            <member value='&quot;KH&quot;' />
            <member value='&quot;LA&quot;' />
            <member value='&quot;MM&quot;' />
            <member value='&quot;MY&quot;' />
            <member value='&quot;PH&quot;' />
            <member value='&quot;PK&quot;' />
            <member value='&quot;SG&quot;' />
            <member value='&quot;TH&quot;' />
            <member value='&quot;TW&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1ccvqz81ez35ej171el2u0wuldaj'>
        <column-instance column='[partition_month]' derivation='None' name='[none:partition_month:qk]' pivot='key' type='quantitative' />
        <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
        <column caption='Partition Month' datatype='date' name='[partition_month]' role='dimension' type='ordinal' />
        <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;AHA&quot;' value='NC reached AHA (5th order)' />
            <alias key='&quot;Grooming&quot;' value='EC Net GMV (in Eur)' />
            <alias key='&quot;pandapro&quot;' value='pandapro Subscribers' />
            <alias key='&quot;QC NTV&quot;' value='QC NTV Trials' />
            <alias key='&quot;Reactivation&quot;' value='Reactivations' />
          </aliases>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='91350' id='197' param='horz' type-v2='layout-flow' w='99112' x='444' y='8250'>
            <zone h='91350' id='195' type-v2='layout-basic' w='99112' x='444' y='8250'>
              <zone h='91350' id='7' param='horz' type-v2='layout-flow' w='99112' x='444' y='8250'>
                <zone h='91350' id='5' type-v2='layout-basic' w='99112' x='444' y='8250'>
                  <zone h='11702' id='16' name='LC Perf Tracking Graph' show-title='false' w='99112' x='444' y='66598'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='13428' id='194' name='LC Perf Tracking Table (Seg)' show-title='false' w='99112' x='444' y='8250'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='7615' id='203' name='LC Perf Tracking Table (QC NTV)' show-title='false' w='99112' x='444' y='37550'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='5909' id='204' name='LC Perf Tracking Table (pdp)' show-title='false' w='99112' x='444' y='45165'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='6900' id='304' name='LC Perf Tracking Table (Grooming)' show-title='false' w='99112' x='444' y='29050'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='10517' id='306' param='horz' type-v2='layout-flow' w='99112' x='444' y='51074'>
                    <zone forceUpdate='true' h='10517' id='13' type-v2='text' w='49778' x='444' y='51074'>
                      <formatted-text>
                        <run bold='true' fontname='Tableau Bold' underline='true'>REMARKS</run>
                        <run>Æ&#10;</run>
                        <run fontcolor='#555555' fontname='Tableau Semibold'>Attribution Window : </run>
                        <run bold='true' fontcolor='#59a14f' fontname='Tableau Semibold'>30 days </run>
                        <run>Converted / activated users refer to users in either TG or CG who were activated within 3O days attribution window.</run>
                        <run>Æ&#10;</run>
                        <run>- Cost per incr. Activation = fp-funded redemption voucher cost / activation uplift from voucher canvases</run>
                        <run>Æ&#10;</run>
                        <run>- ROI = Net GMV uplift from voucher canvases / fp-funded redemption voucher cost</run>
                        <run>Æ&#10;</run>
                        <run>Æ&#10;</run>
                        <run>For </run>
                        <run bold='true' fontcolor='#fc0280' fontname='Tableau Semibold'>NCs, Prospect Registered</run>
                        <run> with 1st lifetime order conversion are used for uplift calculations. </run>
                        <run>Æ&#10;</run>
                        <run>For </run>
                        <run fontcolor='#59a14f' fontname='Tableau Semibold'>NC reached AHA (5th order in the month), Welcome</run>
                        <run> canvases are used </run>
                        <run>Æ&#10;</run>
                        <run>For </run>
                        <run bold='true' fontcolor='#f28e2b' fontname='Tableau Semibold'>Reactivated, Churn, Spark, Dormant, Reacquisition</run>
                        <run> canvases are used.</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                      </zone-style>
                    </zone>
                    <zone forceUpdate='true' h='10517' id='307' type-v2='text' w='49333' x='50222' y='51074'>
                      <formatted-text>
                        <run>For the </run>
                        <run bold='true' fontcolor='#4e79a7' fontname='Tableau Semibold'>Grooming,</run>
                        <run fontname='Tableau Semibold'>Æ </run>
                        <run bold='true' fontcolor='#4e79a7' fontname='Tableau Semibold'>Active / Pre-churn / Pick-up / Demand Gen and Mature HVA</run>
                        <run bold='true' fontcolor='#fc0280'>Æ </run>
                        <run>canvases are used.
- LC Uplift is calculated using Net GMV uplift.
- Net GMV Eur (Food) = Net GMV excluding acquisition and reactivation orders

For </run>
                        <run bold='true' fontcolor='#d37295' fontname='Tableau Semibold'>QC Trials</run>
                        <run fontname='Tableau Semibold'>, </run>
                        <run bold='true' fontcolor='#d37295' fontname='Tableau Semibold'>QC Trial, QC Trial Homescreen, QC Trial Homescreen Voucher Pack, Dmart Trial, Dmart Trial OTP, Shops Trial, Shops Trial OTP </run>
                        <run>canvases are used.&#10;For </run>
                        <run bold='true' fontcolor='#76b7b2' fontname='Tableau Semibold'>pandapro, pandapro Trial, pandapro Churn and pandapro Missed Savings</run>
                        <run> canvases are included.
- Users refer to the</run>
                        <run fontcolor='#76b7b2'>Æ </run>
                        <run bold='true' fontcolor='#76b7b2'>monthly new subscriber signups</run>
                        <run fontcolor='#76b7b2'>Æ </run>
                        <run fontcolor='#555555'>(new to platform + existing user but new to pro + resubscribers excluding renewals)</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                      </zone-style>
                    </zone>
                  </zone>
                  <zone h='13450' id='368' name='LC Perf Tracking Graph (3)' show-title='false' w='99112' x='444' y='81650'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
