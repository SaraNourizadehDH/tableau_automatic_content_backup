    <worksheet name='MAU PFM trend (HK)'>
      <table>
        <view>
          <datasources>
            <datasource caption='crm_mau_dashboard (pandata_ap_mktg)' name='federated.1abyksr0uzs4d0160pczb11lxpd8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Month' datatype='date' default-format='*mmm yy' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-05-01#'>
              <calculation class='tableau' formula='#2024-05-01#' />
            </column>
            <column caption='PFM/HML segment breakdown' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;PFM&quot;'>
              <calculation class='tableau' formula='&quot;PFM&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1abyksr0uzs4d0160pczb11lxpd8'>
            <column caption='MAU breakdown' datatype='string' name='[Calculation_5849331492357521408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [MAU/Churn] = &quot;MAU&quot; AND [new_mau_segment] = &quot;New Customer&quot; THEN &quot;Aquisitions&quot;&#10;ELSEIF [MAU/Churn] = &quot;MAU&quot; AND [new_mau_segment] = &quot;Reactivated&quot; THEN &quot;Re-activations&quot;&#10;ELSEIF [MAU/Churn] = &quot;MAU&quot; AND ([new_mau_segment] = &quot;Retained Existing Customer&quot; OR [new_mau_segment] = &quot;Retained New Customer&quot;) THEN &quot;Active Retained&quot;&#10;ELSEIF [MAU/Churn] = &quot;Churn&quot; AND [new_mau_segment] = &quot;Churn&quot; THEN &quot;&quot;&#10;ELSE &quot;Total&quot;&#10;END' />
            </column>
            <column caption='PM/Seamless Breakdown' datatype='string' name='[Calculation_5849331492359225345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [MAU/Churn] = &quot;MAU&quot; AND [new_mau_segment] = &quot;New Customer&quot; THEN IIF([is_pm], &quot;PM&quot;, &quot;Non-PM (Organic + CRM)&quot;)&#10;ELSEIF [MAU/Churn] = &quot;Churn&quot; THEN IIF([is_seamless], &quot;Seamless&quot;, &quot;Non-seamless&quot;)&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='PFM/HML segment indicator' datatype='string' name='[Calculation_5849331492374355970]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &quot;PFM&quot; THEN [pfm_group]&#10;// ELSEIF [PFM/HML segment breakdown] = &quot;FLGP X GMV&quot; THEN [value_segment]&#10;// ELSEIF [PFM/HML segment breakdown] = &quot;GMV&quot; THEN [monetary_segment]&#10;END' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5849331492375543811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [new_mau_segment] = &quot;New Customer&quot; THEN &quot;&quot;&#10;ELSEIF [MAU/Churn] = &quot;Churn&quot; THEN [Calculation_5849331492374355970]&#10;ELSE [Calculation_5849331492374355970]&#10;END' />
            </column>
            <column caption='Customers ' datatype='integer' name='[Calculation_5849331492383649798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM(IF [Month] = [Reporting Month] AND [MAU breakdown] &lt;&gt; &apos;Aquisitions&apos; THEN [Customers]&#10;//ELSEIF [Month] = [Reporting Month] AND [MAU breakdown] = &apos;Aquisitions&apos; AND [Is Pm] = TRUE THEN [pm_acquisition]&#10;//ELSEIF [Month] = [Reporting Month] AND [MAU breakdown] = &apos;Aquisitions&apos; AND [Is Pm] = FALSE THEN { FIXED [Global Entity Id], [Reporting Month], [Mau Segment],[New Mau Segment], [Pfm Segment], [Pfm Group],[Is Seamless]: SUM([Customers])} &#10;//// {FIXED [Global Entity Id], [Reporting Month], [Segment]: SUM([Customers])} - [pm_acquisition]&#10;//ELSE NULL END)&#10;&#10;SUM(IIF([Parameters].[Parameter 2 1] = [reporting_month], [customers], NULL))' />
            </column>
            <column caption='Month filter (trend)' datatype='boolean' name='[Calculation_5849331493737754634]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reporting_month]&gt;= DATEADD(&quot;month&quot;, - 3, [Parameters].[Parameter 2 1]) and [reporting_month] &lt;=[Parameters].[Parameter 2 1]' />
            </column>
            <column datatype='string' name='[MAU/Churn]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[new_mau_segment]' new-bin='true'>
                <bin default-name='false' value='&quot;MAU&quot;'>
                  <value>&quot;New Customer&quot;</value>
                  <value>&quot;Reactivated&quot;</value>
                  <value>&quot;Retained Existing Customer&quot;</value>
                  <value>&quot;Retained New Customer&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Pm' datatype='boolean' name='[is_pm]' role='dimension' type='nominal' />
            <column caption='Is Seamless' datatype='boolean' name='[is_seamless]' role='dimension' type='nominal' />
            <column caption='New Mau Segment' datatype='string' name='[new_mau_segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5849331492357521408]' derivation='None' name='[none:Calculation_5849331492357521408:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5849331492359225345]' derivation='None' name='[none:Calculation_5849331492359225345:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5849331492375543811]' derivation='None' name='[none:Calculation_5849331492375543811:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5849331493737754634]' derivation='None' name='[none:Calculation_5849331493737754634:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Pfm Group' datatype='string' name='[pfm_group]' role='dimension' type='nominal' />
            <column caption='Reporting Month' datatype='date' name='[reporting_month]' role='dimension' type='ordinal' />
            <column-instance column='[customers]' derivation='Sum' name='[sum:customers:qk]' pivot='key' type='quantitative' />
            <column-instance column='[reporting_month]' derivation='Month-Trunc' name='[tmn:reporting_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_5849331492383649798]' derivation='User' name='[usr:Calculation_5849331492383649798:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1abyksr0uzs4d0160pczb11lxpd8].[none:Calculation_5849331492357521408:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_5849331492357521408:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Calculation_5849331492357521408:nk]' member='&quot;Total&quot;' />
                <groupfilter function='member' level='[none:Calculation_5849331492357521408:nk]' member='%null%' />
              </groupfilter>
            </groupfilter>
