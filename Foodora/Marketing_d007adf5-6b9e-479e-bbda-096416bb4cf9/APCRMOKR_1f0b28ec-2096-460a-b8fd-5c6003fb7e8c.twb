      <aliases enabled='yes' />
      <column caption='MAU' datatype='real' name='[Calculation_1559934360348069888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name],  [vertical], [month_local]: SUM([Calculation_3649815719592349753])}' />
      </column>
      <column caption='% of MAU' datatype='real' name='[Calculation_1559934360354127873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3649815719592349753])/SUM([Calculation_1559934360348069888])' />
      </column>
      <column caption='MoM Diff (#)' datatype='real' name='[Calculation_1559934360354623490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_3649815719592349753])) - LOOKUP(ZN(SUM([Calculation_3649815719592349753])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Segment Short Form' datatype='string' name='[Calculation_1559934360363003909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [segment]&#10;WHEN &apos;Retained Existing Customer&apos; THEN &apos;Retained EC&apos;&#10;WHEN &apos;Retained New Customer&apos; THEN &apos;Retained NC&apos;&#10;WHEN &apos;New Customer&apos; THEN &apos;NC&apos;&#10;ELSE [segment]&#10;END' />
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899685527564]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
      </column>
      <column caption='Customers' datatype='real' name='[Calculation_3649815719592349753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [month_local] &lt; DATETRUNC(&apos;month&apos;, TODAY()) THEN [num_cust] ELSE[projected_cust]&#10;END' />
      </column>
      <column caption='Row Index' datatype='integer' name='[Calculation_4686558417172758528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show/ Hide' datatype='string' name='[Calculation_4686558417172832257]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4686558417172758528] = 2 THEN &quot;Show&quot; ELSE &quot;Hide&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='is_current_month' datatype='boolean' name='[Calculation_5395805000410382336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [month_local] = DATETRUNC(&apos;month&apos;, TODAY()-1) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='is_last_3_months ' datatype='boolean' name='[Calculation_5607474159627026432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, ([month_local]), DATETRUNC(&apos;month&apos;, TODAY()-2)) &gt;= 1 AND &#10;DATEDIFF(&apos;month&apos;, ([month_local]), DATETRUNC(&apos;month&apos;, TODAY()-2)) &lt;= 3&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Column Index' datatype='integer' name='[Calculation_6860389673323638786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Diff (%)' datatype='real' name='[MoM Diff (#) (copy)_1559934360354910211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_3649815719592349753])) - LOOKUP(ZN(SUM([Calculation_3649815719592349753])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_3649815719592349753])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='No. of customers (K)' datatype='integer' name='[No. of customers (copy)_1559934360362651652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_cust]' />
      </column>
