                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Medium'>Current Month Projected MAU -</run>
                    <run>Æ&#10;</run>
                    <run>Projected MAU for the current month based on runrates</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Medium'>Projected MAU vs Prev Year MAU Variation -</run>
                    <run>Æ&#10;</run>
                    <run>Variation between Projected MAU and Previous Year MAU for the month</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
