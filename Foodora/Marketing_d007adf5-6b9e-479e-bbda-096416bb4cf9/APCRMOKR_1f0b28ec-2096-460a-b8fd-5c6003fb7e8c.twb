      <column caption='PM_acquisition' datatype='real' name='[Calculation_2818197843701186560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [reporting_month]: MAX([pm_acquisition])}' />
