            <column-instance column='[Calculation_5849331493793153036]' derivation='None' name='[none:Calculation_5849331493793153036:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Pfm Group' datatype='string' name='[pfm_group]' role='dimension' type='nominal' />
            <column caption='Reporting Month' datatype='date' name='[reporting_month]' role='dimension' type='ordinal' />
            <column-instance column='[customers]' derivation='Sum' name='[sum:customers:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_52776561230024709]' derivation='User' name='[usr:Calculation_52776561230024709:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5849331492380233732]' derivation='User' name='[usr:Calculation_5849331492380233732:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5849331492383649798]' derivation='User' name='[usr:Calculation_5849331492383649798:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Negative MoM(MAU) (copy)_638948202724470785]' derivation='User' name='[usr:Negative MoM(MAU) (copy)_638948202724470785:nk]' pivot='key' type='nominal' />
