      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCRMOKR/Definition?rev=' id='Definition' path='/t/Foodora/workbooks/APCRMOKR' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_5' value='top' />
          <format attr='text-align' id='dash-text_5' value='left' />
