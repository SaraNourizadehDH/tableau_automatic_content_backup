          <datasource-dependencies datasource='federated.13b23tf0148mk119rvux21yg7pbx'>
            <column caption='Users %' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users]) / TOTAL(SUM([users]))'>
                <table-calc ordering-field='[federated.13b23tf0148mk119rvux21yg7pbx].[dropoff_point]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899684569098]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
            </column>
            <column caption='Country Breakdown' datatype='string' name='[Calculation_3558828888164773888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Global Entity Id Parameter] = &quot;APAC&quot; THEN &quot;APAC&quot; ELSE [global_entity_id] END' />
            </column>
            <column caption='Segment Breakdown' datatype='string' name='[Calculation_3558828888166383620]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Country Breakdown (copy)_4088001868568436736] = &quot;All&quot; THEN &quot;All&quot; ELSE [ex_mau_segment] END' />
            </column>
            <column caption='Segment (group)' datatype='string' name='[Segment (group) ]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[ex_mau_segment]' new-bin='true'>
                <bin default-name='false' value='&quot;NC&quot;'>
                  <value>&quot;New Customer&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Others&quot;'>
                  <value>&quot;Others&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Reactivated&quot;'>
                  <value>&quot;Reactivated Churn&quot;</value>
                  <value>&quot;Reactivated Inactive&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Retained&quot;'>
                  <value>&quot;Retained Existing Customer&quot;</value>
                  <value>&quot;Retained New Customer&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Dropoff Point' datatype='string' name='[dropoff_point]' role='dimension' type='nominal' />
            <column caption='Segment' datatype='string' name='[ex_mau_segment]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Month Local' datatype='date' name='[month_local]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2400277899684569098]' derivation='None' name='[none:Calculation_2400277899684569098:nk]' pivot='key' type='nominal' />
