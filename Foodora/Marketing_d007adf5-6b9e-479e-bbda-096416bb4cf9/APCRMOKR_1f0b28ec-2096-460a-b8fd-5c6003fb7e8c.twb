    <datasource caption='regional_apac_mkt_crm_okr_agg_segments' inline='true' name='federated.1tow11b05jjw0911bqipz11vlrap' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0zqzs480gkohxw1chu7ij0tojzwb'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='chinwee.chok@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0zqzs480gkohxw1chu7ij0tojzwb' name='Custom SQL Query' type='text'><![CDATA[WITH segments AS (
  SELECT
    global_entity_id,
    reporting_month AS month_local,
    vertical,
    segment,
    SAFE_DIVIDE(num_cust, SUM(num_cust) OVER (PARTITION BY global_entity_id, reporting_month, vertical)) AS percent_of_mau
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_okr_agg_segments`
  WHERE reporting_month BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 3 MONTH) AND DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) 
   AND segment IS NOT NULL
),

avgp AS (
  SELECT
    global_entity_id,
    vertical,
    segment,
    SAFE_DIVIDE(SUM(percent_of_mau), 3) AS avg_percent_of_mau
  FROM segments
  GROUP BY 1,2,3
),

maus AS (
  SELECT
    mac.global_entity_id,
    mac.month_local,
    SUM(current_month_dac_projection_by_acid) AS mau,
    SUM(cm_food_mau_projection_by_acid) AS food_mau,
    SUM(cm_dmart_mau_projection_by_acid) AS dmart_mau,
    SUM(cm_shops_mau_projection_by_acid) AS shops_mau,
    SUM(cm_pickup_mau_projection_by_acid) AS pickup_mau,
    SUM(cm_qcomm_mau_projection_by_acid) AS qcomm_mau
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_mac_projections` AS mac
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_vertical_mau_projections` AS vertical_mau
         ON mac.global_entity_id = vertical_mau.global_entity_id
        AND mac.date_local = vertical_mau.date_local
  WHERE mac.month_local = DATE_TRUNC(CURRENT_DATE, MONTH)
  AND vertical_mau.month_local = DATE_TRUNC(CURRENT_DATE, MONTH)
  GROUP BY 1,2
),

projection AS (
  SELECT
    avgp.global_entity_id,
    DATE_TRUNC(CURRENT_DATE, MONTH) AS month_local,
    vertical,
    segment,
    CASE
      WHEN vertical = "Dmart" THEN avg_percent_of_mau * dmart_mau
      WHEN vertical = "Shops" THEN avg_percent_of_mau * shops_mau
      WHEN vertical = "Pickup" THEN avg_percent_of_mau * pickup_mau
      WHEN vertical = "Food" THEN avg_percent_of_mau * food_mau
      WHEN vertical = "Dmart & Shops" THEN avg_percent_of_mau * qcomm_mau
      WHEN vertical = "All" THEN avg_percent_of_mau * mau
    END AS projected_cust
  FROM avgp
  LEFT JOIN maus
         ON avgp.global_entity_id = maus.global_entity_id
)

SELECT
  agg.country_name,
  agg.global_entity_id,
  agg.reporting_month AS month_local,
  agg.vertical,
  agg.segment,
  agg.num_cust,
  projection.projected_cust
  -- CASE
  --   WHEN agg.month_local << DATE_TRUNC(CURRENT_DATE, MONTH) THEN ROUND(agg.num_cust, 0)
  -- ELSE projection.projected_cust
  -- END AS num_cust
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_okr_agg_segments` AS agg
LEFT JOIN projection
       ON agg.global_entity_id = projection.global_entity_id
      AND agg.reporting_month = projection.month_local
      AND agg.vertical = projection.vertical
      AND agg.segment = projection.segment
WHERE agg.segment IS NOT NULL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
