                <zone fixed-size='280' h='32000' id='193' is-fixed='true' name='Overview Table' show-title='false' w='99112' x='444' y='31682'>
                  <layout-cache type-h='fixed' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='19091' id='294' type-v2='text' w='45890' x='444' y='63682'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ee0074' fontname='Tableau Bold' fontsize='11' underline='true'>OKRs attributed to CRM</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>MAUs Attributable to CRM</run>
                    <run> - TG vs CG conversion uplift between users who made at least 1 valid platform order in reporting month
</run>
                    <run bold='true'>Reactivations Attributable to CRM</run>
                    <run> - TG vs CG conversion uplift between users who are in churn/ inactive lifecycle stage in the previous month and made at least 1 valid platform order in the reporting month
</run>
                    <run bold='true'>2nd Order in 30 days Attributable to CRM</run>
                    <run> - TG vs CG conversion uplift between users who made their 1st order in the reporting month and made their 2nd valid order within 30 days from date of 1st order
</run>
                    <run bold='true'>QC Trials Attributable to CRM</run>
                    <run> - TG vs CG conversion uplift between users who are existing Restaurants customers and made at least 1 valid Dmart/ Shops order in the reporting month
</run>
                    <run bold='true'>GMV Attributable to CRM </run>
                    <run>- TG vs CG GMV uplift of all valid orders in the reporting month

</run>
                    <run bold='true' fontcolor='#ee0074' fontname='Tableau Bold' fontsize='10' underline='true'>TG vs CG definition</run>
                    <run>
CG - contactable (via push or email) users in the Global Control Group (GCG) and in respective lifecycle stage depending on OKR
TG - contactable (via push or email) users who are not in GCG and are in respective lifecycle stage depending on OKR

</run>
                    <run bold='true' fontcolor='#ee0074' fontname='Tableau Bold' fontsize='10' underline='true'>Other Metrics</run>
                    <run>
TG Activations - No. of TG Users who converted where they made at least 1 valid order
% Share of MAU - Percentage share of metric uplift over total MAU (this metric is only applicable to OKRs attributed to CRM)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='950' forceUpdate='true' h='19091' id='164' type-v2='text' w='53222' x='46334' y='63682'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ee0074' fontname='Tableau Bold' fontsize='11' underline='true'>Other OKR Definitions:</run>
                    <run>Æ&#10;</run>
                    <run bold='true'>FLGP Positive MAU</run>
                    <run> - No. of MAUs each month whose orders in the month sum to FLGPO &gt;= 0
</run>
                    <run bold='true'>MAU</run>
                    <run> - No. of users who made at least 1 valid platform order
</run>
                    <run bold='true'>Dmart MAU</run>
                    <run> - No. of users who made at least 1 valid Dmart order 
</run>
                    <run bold='true'>Shops MAU</run>
                    <run> - No. of users who made at least 1 valid Shops order
</run>
                    <run bold='true'>Pickup MAU</run>
                    <run> - No. of users who made at least 1 valid Pickup order
</run>
                    <run bold='true'>% registrations make 1st order in 30 days </run>
                    <run>- % of users who make their 1st valid platform order within 30 days of registration
</run>
                    <run bold='true'>% users make 2nd order in 30 days</run>
                    <run> - % of users who make their 2nd valid platform order within 30 days of 1st order
</run>
                    <run bold='true'>Reactivated Churn </run>
                    <run>- No. of users who churned prior and made at least 1 valid platform order in the reporting month
</run>
                    <run bold='true'>Reactivated Inactive</run>
                    <run> - No. of users who were inactive prior and made at least 1 valid platform order in the reporting month
</run>
                    <run bold='true'>Order Frequency</run>
                    <run> - No. of </run>
                    <run underline='true'>valid</run>
                    <run> orders per active user&#10;</run>
                    <run bold='true'>% 1-year active users contactable</run>
                    <run> - % of 1-year active users who are contactable via at least 1 CRM channel (Email/Push)
</run>
                    <run bold='true'>% MAU tried ≥2 verticals </run>
                    <run>- % of MAU who tried at least 2 verticals
</run>
                    <run bold='true'>Pro % MAU Penetration</run>
                    <run> - % of MAU who are Pandapro Subscribers
</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{34AF3328-E9D2-4CAA-8422-107CE1766B9F}' />
    </dashboard>
